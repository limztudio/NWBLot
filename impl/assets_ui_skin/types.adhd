UiSkinRequiredRegion ResolveUiSkinRequiredRegion(in usize index){
    switch(index){
    case 0u:
        return UiSkinRequiredRegion(Name("panel.normal"), "panel.normal");
    case 1u:
        return UiSkinRequiredRegion(Name("window.normal"), "window.normal");
    case 2u:
        return UiSkinRequiredRegion(Name("window.title"), "window.title");
    case 3u:
        return UiSkinRequiredRegion(Name("window.collapse"), "window.collapse");
    case 4u:
        return UiSkinRequiredRegion(Name("separator"), "separator");
    case 5u:
        return UiSkinRequiredRegion(Name("button.normal"), "button.normal");
    case 6u:
        return UiSkinRequiredRegion(Name("checkbox.normal"), "checkbox.normal");
    case 7u:
        return UiSkinRequiredRegion(Name("checkbox.mark"), "checkbox.mark");
    case 8u:
        return UiSkinRequiredRegion(Name("edit.normal"), "edit.normal");
    case 9u:
        return UiSkinRequiredRegion(Name("list.background"), "list.background");
    case 10u:
        return UiSkinRequiredRegion(Name("list.row.normal"), "list.row.normal");
    case 11u:
        return UiSkinRequiredRegion(Name("list.row.hover"), "list.row.hover");
    case 12u:
        return UiSkinRequiredRegion(Name("list.row.selected"), "list.row.selected");
    case 13u:
        return UiSkinRequiredRegion(Name("list.row.disabled"), "list.row.disabled");
    case 14u:
        return UiSkinRequiredRegion(Name("scroll.track"), "scroll.track");
    case 15u:
        return UiSkinRequiredRegion(Name("scroll.thumb"), "scroll.thumb");
    case 16u:
        return UiSkinRequiredRegion(Name("scrollbar.track"), "scrollbar.track");
    case 17u:
        return UiSkinRequiredRegion(Name("scrollbar.thumb.normal"), "scrollbar.thumb.normal");
    case 18u:
        return UiSkinRequiredRegion(Name("popup.normal"), "popup.normal");
    case 19u:
        return UiSkinRequiredRegion(Name("tooltip.normal"), "tooltip.normal");
    case 20u:
        return UiSkinRequiredRegion(Name("combo.normal"), "combo.normal");
    case 21u:
        return UiSkinRequiredRegion(Name("combo.arrow"), "combo.arrow");
    case 22u:
        return UiSkinRequiredRegion(Name("radio.normal"), "radio.normal");
    case 23u:
        return UiSkinRequiredRegion(Name("radio.checked"), "radio.checked");
    case 24u:
        return UiSkinRequiredRegion(Name("radio.mark"), "radio.mark");
    case 25u:
        return UiSkinRequiredRegion(Name("slider.track"), "slider.track");
    case 26u:
        return UiSkinRequiredRegion(Name("slider.thumb.normal"), "slider.thumb.normal");
    case 27u:
        return UiSkinRequiredRegion(Name("progress.track"), "progress.track");
    case 28u:
        return UiSkinRequiredRegion(Name("progress.fill"), "progress.fill");
    case 29u:
        return UiSkinRequiredRegion(Name("focus.overlay"), "focus.overlay");
    default:
        return UiSkinRequiredRegion();
    }
}

u64 ResolveUiSkinColorRole(in StringView name){
    if(name == "text.normal")
        return cast<u64>(UiSkinColorRole::TextNormal);
    if(name == "text.disabled")
        return cast<u64>(UiSkinColorRole::TextDisabled);
    if(name == "text.tooltip")
        return cast<u64>(UiSkinColorRole::TextTooltip);
    if(name == "edit.background")
        return cast<u64>(UiSkinColorRole::EditBackground);
    if(name == "edit.selection")
        return cast<u64>(UiSkinColorRole::EditSelection);
    if(name == "edit.inactive_selection")
        return cast<u64>(UiSkinColorRole::EditInactiveSelection);
    if(name == "edit.caret")
        return cast<u64>(UiSkinColorRole::EditCaret);
    if(name == "edit.preedit")
        return cast<u64>(UiSkinColorRole::EditPreedit);
    if(name == "scrollbar.track")
        return cast<u64>(UiSkinColorRole::ScrollbarTrack);
    if(name == "scrollbar.thumb")
        return cast<u64>(UiSkinColorRole::ScrollbarThumb);
    if(name == "scrollbar.disabled")
        return cast<u64>(UiSkinColorRole::ScrollbarDisabled);
    if(name == "popup.backdrop")
        return cast<u64>(UiSkinColorRole::PopupBackdrop);
    if(name == "control.hover_tint")
        return cast<u64>(UiSkinColorRole::ControlHoverTint);
    if(name == "control.pressed_tint")
        return cast<u64>(UiSkinColorRole::ControlPressedTint);
    if(name == "control.disabled_tint")
        return cast<u64>(UiSkinColorRole::ControlDisabledTint);
    if(name == "progress.track_tint")
        return cast<u64>(UiSkinColorRole::ProgressTrackTint);
    if(name == "progress.fill_tint")
        return cast<u64>(UiSkinColorRole::ProgressFillTint);
    return cast<u64>(UiSkinColorRole::kCount);
}

Expected<usize> TryFindUiSkinRegionIndex(
    in Span<UiSkinRegion> regions,
    in Span<u32> regionIndex,
    in Name name
){
    if(regions.size() <= s_UiSkinLinearLookupRegionLimit || regions.size() > s_UiSkinMaxRegionCount){
        for(usize i = 0u; i < regions.size(); ++i){
            if(regions[i].name == name)
                return i;
        }
        return makeUnexpected(Failure());
    }
    usize first = 0u;
    usize count = regionIndex.size();
    while(count > 0u){
        const usize step = count / 2u;
        const usize middle = first + step;
        const usize regionPosition = cast<usize>(regionIndex[middle]);
        if(regions[regionPosition].name < name){
            first = middle + 1u;
            count -= step + 1u;
        }
        else
            count = step;
    }
    if(first == regionIndex.size())
        return makeUnexpected(Failure());
    const usize matchedPosition = cast<usize>(regionIndex[first]);
    if(regions[matchedPosition].name != name)
        return makeUnexpected(Failure());
    return matchedPosition;
}

UiSkinHeaderBinary MakeUiSkinHeaderBinary(
    in NameHash textureNameHash,
    in u32 atlasWidth,
    in u32 atlasHeight,
    in f32 referenceDensity,
    in u32 regionCount
){
    UiSkinHeaderBinary header;
    header.textureNameHash = textureNameHash;
    header.atlasWidth = atlasWidth;
    header.atlasHeight = atlasHeight;
    header.referenceDensity = referenceDensity;
    header.regionCount = regionCount;
    return header;
}

UiSkinRegionBinary PackUiSkinRegionBinary(in UiSkinRegion region){
    UiSkinRegionBinary packed;
    packed.nameHash = region.name.hash();
    packed.x = region.rectangle.x;
    packed.y = region.rectangle.y;
    packed.width = region.rectangle.width;
    packed.height = region.rectangle.height;
    packed.sliceLeft = region.sliceInsets.left;
    packed.sliceTop = region.sliceInsets.top;
    packed.sliceRight = region.sliceInsets.right;
    packed.sliceBottom = region.sliceInsets.bottom;
    packed.paddingLeft = region.padding.left;
    packed.paddingTop = region.padding.top;
    packed.paddingRight = region.padding.right;
    packed.paddingBottom = region.padding.bottom;
    packed.minimumWidth = region.minimumWidth;
    packed.minimumHeight = region.minimumHeight;
    packed.drawMode = cast<u32>(region.drawMode);
    return packed;
}

UiSkinRegion UnpackUiSkinRegionBinary(in UiSkinRegionBinary packed){
    UiSkinRegion region;
    region.name = Name(packed.nameHash);
    region.rectangle.x = packed.x;
    region.rectangle.y = packed.y;
    region.rectangle.width = packed.width;
    region.rectangle.height = packed.height;
    region.sliceInsets.left = packed.sliceLeft;
    region.sliceInsets.top = packed.sliceTop;
    region.sliceInsets.right = packed.sliceRight;
    region.sliceInsets.bottom = packed.sliceBottom;
    region.padding.left = packed.paddingLeft;
    region.padding.top = packed.paddingTop;
    region.padding.right = packed.paddingRight;
    region.padding.bottom = packed.paddingBottom;
    region.minimumWidth = packed.minimumWidth;
    region.minimumHeight = packed.minimumHeight;
    if(packed.drawMode == cast<u32>(UiSkinDrawMode::NineSlice))
        region.drawMode = UiSkinDrawMode::NineSlice;
    else
        region.drawMode = UiSkinDrawMode::Sprite;
    return region;
}

f32 ResolveUiSkinSquareExtent(in f32 minimumExtent, in UiSkinRegion region){
    return max(minimumExtent, max(region.minimumWidth, region.minimumHeight));
}

f32 ResolveUiSkinSquareExtent(in f32 minimumExtent, in UiSkinRegion region, in f32 density){
    const f32 sourceExtent = cast<f32>(max(region.rectangle.width, region.rectangle.height)) / density;
    return max(ResolveUiSkinSquareExtent(minimumExtent, region), sourceExtent);
}

void RebuildUiSkinRegionIndex(in Span<UiSkinRegion> regions, mut Vector<u32> outIndex){
    outIndex.clear();
    if(regions.size() <= cast<usize>(s_UiSkinMaxRegionCount)){
        outIndex.reserve(regions.size());
        for(u32 position = 0u; position < cast<u32>(regions.size()); ++position)
            outIndex.push_back(position);
        native(in regions, mut outIndex){
            ::Sort(outIndex.begin(), outIndex.end(), [&regions](const u32 left, const u32 right)noexcept{
                const Name& a = regions[left].name;
                const Name& b = regions[right].name;
                return a == b ? left < right : a < b;
            });
        }
    }
}


