[[nodiscard]] FOUNDATION_INLINE GlobalArena& BenchmarkFallbackArena()noexcept{
    static GlobalArena s_Arena{ Name("tests/performance/ui_input") };
    return s_Arena;
}

inline thread_local GlobalArena* s_ActiveBenchmarkArena = nullptr;

[[nodiscard]] FOUNDATION_INLINE GlobalArena& ActiveBenchmarkArena()noexcept{
    return s_ActiveBenchmarkArena != nullptr ? *s_ActiveBenchmarkArena : BenchmarkFallbackArena();
}

struct BenchmarkScope final : NoCopy{
    GlobalArena arena;
    GlobalArena* previous = nullptr;

    explicit BenchmarkScope(const Name& scopeName)noexcept
        : arena(scopeName)
        , previous(s_ActiveBenchmarkArena)
    {
        s_ActiveBenchmarkArena = &arena;
    }

    ~BenchmarkScope()noexcept{
        s_ActiveBenchmarkArena = previous;
    }
};

class BenchmarkTextInput final : public QueuedTextInputService{
public:
    BenchmarkTextInput() : QueuedTextInputService(ActiveBenchmarkArena()){}
    explicit BenchmarkTextInput(GlobalArena& arena) : QueuedTextInputService(arena){}

public:
    [[nodiscard]] virtual TextInputCapabilities capabilities()const noexcept override{ return { true, true, true, true }; }
};

class BenchmarkClipboard final : public QueuedClipboardService{
public:
    BenchmarkClipboard() : QueuedClipboardService(ActiveBenchmarkArena()){}
    explicit BenchmarkClipboard(GlobalArena& arena) : QueuedClipboardService(arena){}

public:
    [[nodiscard]] virtual ClipboardCapabilities capabilities(ClipboardChannel::Enum)const noexcept override{ return {}; }

protected:
    virtual void startNativeRequest(const ClipboardRequestToken token, ClipboardOperation::Enum, ClipboardChannel::Enum, AStringView)noexcept override{
        const b8 completed = completeNativeRequest(token, ClipboardStatus::Unsupported);
        FOUNDATION_FATAL_ASSERT(completed);
    }
};

class BenchmarkContext final : NoCopy{
public:
    BenchmarkContext() : m_value(ActiveBenchmarkArena()){}

public:
    operator Context&()noexcept{ return m_value; }
    operator const Context&()const noexcept{ return m_value; }

    template<typename... Args>
    decltype(auto) beginFrame(Args&&... args){ return m_value.beginFrame(Forward<Args>(args)...); }
    template<typename... Args>
    decltype(auto) beginRoot(Args&&... args){ return m_value.beginRoot(Forward<Args>(args)...); }
    template<typename... Args>
    decltype(auto) addTarget(Args&&... args){ return m_value.addTarget(Forward<Args>(args)...); }
    template<typename... Args>
    decltype(auto) endRoot(Args&&... args){ return m_value.endRoot(Forward<Args>(args)...); }
    template<typename... Args>
    decltype(auto) finishFrame(Args&&... args){ return m_value.finishFrame(Forward<Args>(args)...); }
    template<typename... Args>
    decltype(auto) commitFrame(Args&&... args){ return m_value.commitFrame(Forward<Args>(args)...); }
    [[nodiscard]] const InputRouter& input()const noexcept{ return m_value.input(); }

private:
    Context m_value;
};

