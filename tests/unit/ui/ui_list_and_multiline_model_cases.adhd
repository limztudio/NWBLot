    EXPECT_EQ(state.cursorKey(), 6u);
}

void VerifyUiListReconciliationTests_ReplacingAnEstablishedSourceClearsSelectionCursorAndOffset(){
    UiListReconcileRangeSource source = UiListReconcileRangeSource();
    ListState state = ListState();
    state.select(5u);
    ASSERT_TRUE(state.scrollTo(90.0));
    ASSERT_TRUE(UiListReconcile(state, source));
    const u64 inputGeneration = state.inputGeneration();
    ++source.generation;
    ASSERT_TRUE(UiListReconcile(state, source));
    EXPECT_EQ(state.selectedKey(), 0u);
    EXPECT_EQ(state.cursorKey(), 0u);
    EXPECT_DOUBLE_EQ(state.scrollOffset(), 0.0);
    EXPECT_EQ(state.inputGeneration(), inputGeneration);
}

void VerifyUiListReconciliationTests_InvalidSourceIdentitiesAndMalformedLookupFailWithoutPartialMutation(){
    UiListReconcileRangeSource source = UiListReconcileRangeSource();
    ListState state = ListState();
    state.select(5u);
    ASSERT_TRUE(state.scrollTo(90.0));
    source.generation = 0u;
    EXPECT_FALSE(UiListReconcile(state, source));
    source.generation = 41u;
    source.revisionValue = 0u;
    EXPECT_FALSE(UiListReconcile(state, source));
    source.revisionValue = 1u;
    source.badLookup = true;
    EXPECT_FALSE(UiListReconcile(state, source));
    source.badLookup = false;
    source.wrongLookup = true;
    EXPECT_FALSE(UiListReconcile(state, source));
    EXPECT_EQ(state.selectedKey(), 5u);
    EXPECT_EQ(state.cursorKey(), 5u);
    EXPECT_DOUBLE_EQ(state.scrollOffset(), 90.0);
    source.wrongLookup = false;
    ASSERT_TRUE(UiListReconcile(state, source));
}

void VerifyUiListReconciliationTests_SourceRevisionChangingDuringLookupFailsAtomically(){
    UiListReconcileRangeSource source = UiListReconcileRangeSource();
    ListState state = ListState();
    state.select(5u);
    source.changeRevisionOnLookup = true;
    EXPECT_FALSE(UiListReconcile(state, source));
    EXPECT_EQ(state.selectedKey(), 5u);
    EXPECT_EQ(state.cursorKey(), 5u);
    ListResult result = ListResult();
    EXPECT_FALSE(UiListReconcileApply(source, ListOptions(), MakeUiListReconcileAction(state, source, ControlActionKind::Down), state, result));
    EXPECT_FALSE(result.valid);
    ASSERT_TRUE(UiListReconcile(state, source));
}

void VerifyUiListReconciliationTests_InputSourceAndRevisionTokensRejectStaleActions(){
    UiListReconcileRangeSource source = UiListReconcileRangeSource();
    ListState state = ListState();
    state.select(2u);
    ASSERT_TRUE(UiListReconcile(state, source));
    ListResult result = ListResult();
    const ControlAction valid = MakeUiListReconcileAction(state, source, ControlActionKind::Down);
    ControlAction action = valid;
    ++action.control.instanceGeneration;
    EXPECT_FALSE(UiListReconcileApply(source, ListOptions(), action, state, result));
    action = valid;
    ++action.control.contentGeneration;
    EXPECT_FALSE(UiListReconcileApply(source, ListOptions(), action, state, result));
    action = valid;
    ++action.control.contentRevision;
    EXPECT_FALSE(UiListReconcileApply(source, ListOptions(), action, state, result));
    ++source.revisionValue;
    EXPECT_FALSE(UiListReconcileApply(source, ListOptions(), MakeUiListReconcileAction(state, source, ControlActionKind::Down), state, result));
    ASSERT_TRUE(UiListReconcile(state, source));
    EXPECT_FALSE(UiListReconcileApply(source, ListOptions(), valid, state, result));
    ASSERT_TRUE(UiListReconcileApply(source, ListOptions(), MakeUiListReconcileAction(state, source, ControlActionKind::Down), state, result));
    EXPECT_EQ(state.selectedKey(), 3u);
}

void VerifyUiListReconciliationTests_ApplicationChangesFenceEvenAnUnchangedSelectionValue(){
    UiListReconcileRangeSource source = UiListReconcileRangeSource();
    ListState state = ListState();
    state.select(2u);
    ASSERT_TRUE(UiListReconcile(state, source));
    const ControlAction action = MakeUiListReconcileAction(state, source, ControlActionKind::Down);
    state.select(2u);
    ListResult result = ListResult();
    EXPECT_FALSE(UiListReconcileApply(source, ListOptions(), action, state, result));
    EXPECT_EQ(state.cursorKey(), 2u);
    ASSERT_TRUE(UiListReconcile(state, source));
    ASSERT_TRUE(UiListReconcileApply(source, ListOptions(), MakeUiListReconcileAction(state, source, ControlActionKind::Down), state, result));
    EXPECT_EQ(state.cursorKey(), 3u);
}


