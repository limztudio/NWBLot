class TestArena{
    public HeapStorage arena;
    public TestArena(){ this.arena = HeapStorage(); }
    public TestArena(in Name name){ this.arena = HeapStorage(name); }
    public GpuTaskTimingHistoryStore makeTimingHistory(in u32 capacity){ return this.arena.makeValue<GpuTaskTimingHistoryStore>(capacity); }
    public GpuTaskTimingHistoryStore makeTimingHistory(){ return this.makeTimingHistory(s_DefaultGpuTaskTimingHistorySampleCount); }
    public GpuTaskTimingHistorySnapshot makeTimingSnapshot(){ return this.arena.makeValue<GpuTaskTimingHistorySnapshot>(); }
}

class TestScratchArena{
    public ScratchStorage scratchArena;
    public TestScratchArena(){ this.scratchArena = ScratchStorage(s_TaskGraphScratchArena); }
    public TestScratchArena(in Name scopeName){ this.scratchArena = ScratchStorage(scopeName); }
}

class GpuTaskGraphReadViews{
    public GpuTaskGraphDeclarationReadView declarations;
    public GpuCompiledGraphReadView compiled;
    public GpuTaskGraphReadViews(in GpuTaskGraph graph, in GpuCompiledGraph compiledGraph){
        this.declarations = GpuTaskGraphDeclarationReadView(graph);
        this.compiled = GpuCompiledGraphReadView(compiledGraph);
    }
    public b8 valid()const{ return this.declarations.valid() && this.compiled.valid() && this.compiled.validFor(this.declarations); }
}

class SingleQueueCompile{
    public ScratchStorage scratchArena;
    public GpuPhysicalQueueInfo singleQueue;
    public GpuPhysicalQueueTopology topology;
    public GpuTaskGraphAnalysis analysis;
    public GpuTaskGraphQueueAssignments assignments;
    public GpuCompiledGraph compiledGraph;

    public SingleQueueCompile(mut TestArena testArena){
        this.scratchArena = ScratchStorage(s_TaskGraphScratchArena);
        this.singleQueue = GraphicsQueue();
        this.topology = MakeTopology(SpanOf<GpuPhysicalQueueInfo>(this.singleQueue));
        this.analysis = GpuTaskGraphAnalysis(testArena.arena);
        this.assignments = GpuTaskGraphQueueAssignments(testArena.arena);
        this.compiledGraph = GpuCompiledGraph(testArena.arena);
    }
    public b8 compile(in GpuTaskGraph graph, in GpuTaskGraphCompileOptions options){
        const GpuTaskGraphCompiler compiler = GpuTaskGraphCompiler();
        GpuTaskGraphCompileOptions metadataOptions = options;
        metadataOptions.allowMetadataOnlyTasks = true;
        const GpuTaskGraphDeclarationReadView declarations(graph);
        return compiler.compile(declarations, this.topology, metadataOptions, this.scratchArena, this.analysis, this.assignments, this.compiledGraph);
    }
    public b8 compile(in GpuTaskGraph graph){ return this.compile(graph, GpuTaskGraphCompileOptions()); }
}

class TwoQueueCompile{
    public ScratchStorage scratchArena;
    public GpuPhysicalQueueInfo graphicsQueue;
    public GpuPhysicalQueueInfo computeQueue;
    public Array<GpuPhysicalQueueInfo, 2> queueStorage;
    public GpuPhysicalQueueTopology topology;
    public GpuTaskGraphAnalysis analysis;
    public GpuTaskGraphQueueAssignments assignments;
    public GpuCompiledGraph compiledGraph;

    public TwoQueueCompile(mut TestArena testArena){
        this.scratchArena = ScratchStorage(s_TaskGraphScratchArena);
        this.graphicsQueue = GraphicsQueue();
        this.computeQueue = DedicatedComputeQueue();
        this.queueStorage = Array<GpuPhysicalQueueInfo, 2>(this.graphicsQueue, this.computeQueue);
        this.topology = MakeTopology(Span<GpuPhysicalQueueInfo>(this.queueStorage));
        this.analysis = GpuTaskGraphAnalysis(testArena.arena);
        this.assignments = GpuTaskGraphQueueAssignments(testArena.arena);
        this.compiledGraph = GpuCompiledGraph(testArena.arena);
    }
    public b8 compile(in GpuTaskGraph graph, in GpuTaskGraphCompileOptions options){
        Array<GpuPhysicalQueueInfo, 2> separated = this.queueStorage;
        separated[0u].capabilities = MaskOutQueueCapability(separated[0u].capabilities, GpuQueueCapability::Compute);
        const GpuPhysicalQueueTopology topology = MakeTopology(Span<GpuPhysicalQueueInfo>(separated));
        const GpuTaskGraphCompiler compiler = GpuTaskGraphCompiler();
        GpuTaskGraphCompileOptions metadataOptions = options;
        metadataOptions.allowMetadataOnlyTasks = true;
        const GpuTaskGraphDeclarationReadView declarations(graph);
        return compiler.compile(declarations, topology, metadataOptions, this.scratchArena, this.analysis, this.assignments, this.compiledGraph);
    }
    public b8 compile(in GpuTaskGraph graph){ return this.compile(graph, GpuTaskGraphCompileOptions()); }
}

class ThreeQueueCompile{
    public ScratchStorage scratchArena;
    public GpuPhysicalQueueInfo graphicsQueue;
    public GpuPhysicalQueueInfo computeQueue;
    public GpuPhysicalQueueInfo transferQueue;
    public Array<GpuPhysicalQueueInfo, 3> queueStorage;
    public GpuPhysicalQueueTopology topology;
    public GpuTaskGraphAnalysis analysis;
    public GpuTaskGraphQueueAssignments assignments;
    public GpuCompiledGraph compiledGraph;

    public ThreeQueueCompile(mut TestArena testArena){
        this.scratchArena = ScratchStorage(s_TaskGraphScratchArena);
        this.graphicsQueue = GraphicsQueue();
        this.computeQueue = DedicatedComputeQueue();
        this.transferQueue = DedicatedTransferQueue();
        this.queueStorage = Array<GpuPhysicalQueueInfo, 3>(this.graphicsQueue, this.computeQueue, this.transferQueue);
        this.topology = MakeTopology(Span<GpuPhysicalQueueInfo>(this.queueStorage));
        this.analysis = GpuTaskGraphAnalysis(testArena.arena);
        this.assignments = GpuTaskGraphQueueAssignments(testArena.arena);
        this.compiledGraph = GpuCompiledGraph(testArena.arena);
    }
    public b8 compile(in GpuTaskGraph graph, in GpuTaskGraphCompileOptions options){
        Array<GpuPhysicalQueueInfo, 3> separated = this.queueStorage;
        separated[0u].capabilities = MaskOutQueueCapability(separated[0u].capabilities, GpuQueueCapability::Compute);
        separated[0u].capabilities = MaskOutQueueCapability(separated[0u].capabilities, GpuQueueCapability::Transfer);
        separated[1u].capabilities = MaskOutQueueCapability(separated[1u].capabilities, GpuQueueCapability::Transfer);
        const GpuPhysicalQueueTopology topology = MakeTopology(Span<GpuPhysicalQueueInfo>(separated));
        const GpuTaskGraphCompiler compiler = GpuTaskGraphCompiler();
        GpuTaskGraphCompileOptions metadataOptions = options;
        metadataOptions.allowMetadataOnlyTasks = true;
        const GpuTaskGraphDeclarationReadView declarations(graph);
        return compiler.compile(declarations, topology, metadataOptions, this.scratchArena, this.analysis, this.assignments, this.compiledGraph);
    }
    public b8 compile(in GpuTaskGraph graph){ return this.compile(graph, GpuTaskGraphCompileOptions()); }
}


