[cpp_header("<core/graphics/rhi/coopvec.h>"), cpp_name("::NWB::Core::GetCooperativeVectorDataTypeSize")]
extern usize GetCooperativeVectorDataTypeSize(in auto a0);

[cpp_header("<core/graphics/rhi/coopvec.h>"), cpp_name("::NWB::Core::GetCooperativeVectorOptimalMatrixStride")]
extern Expected<usize> GetCooperativeVectorOptimalMatrixStride(in auto a0, in auto a1, in isize a2, in isize a3);


