    return CookSingleAssetRoot(testArena, cookCase.root, cookCase.outputDirectory, assetRoot);
}

b8 CanEmitDuplicateMaterialBindIncludePath(mut TestArena testArena, in CookCase cookCase){
    Vector<MaterialBindEntry> entries;
    const Array<StringView, 2u> directories("first", "second");
    for(in StringView directory : directories){
        const GraphicsTestPath root = cookCase.root / directory / s_AssetsDirectory;
        const GraphicsTestPath path = root / s_MaterialInterfacesDirectory / s_SurfaceBindFilename;
        if(!WriteTextFile(path, s_MinimalMaterialBindSource))
            return false;
        auto entry = ParseMaterialBindSource(path);
        if(!entry.has_value())
            return false;
        const auto name = DeriveAssetVirtualPathText(Path(root), s_ProjectVirtualRoot, Path(path));
        if(!name.has_value())
            return false;
        entry.value().virtualPath = name.value();
        entries.push_back(entry.value());
    }
    return EmitMaterialBindIncludes(cookCase.root / s_CacheDirectory, s_TestsConfiguration, entries).has_value();
}

