#include <impl/ecs_render/csg/task_graph_opaque_compute_tasks.adhd.h>
#include <impl/ecs_render/deferred/task_graph_gbuffer_task.adhd.h>
#include <impl/ecs_render/material/task_graph_opaque_compute_tasks.adhd.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class OpaqueComputeEmulationPlanner final : NoCopy{
public:
    OpaqueComputeEmulationPlanner(
        Core::Alloc::GlobalArena& arena,
        RendererMaterialSystem& materialSystem,
        DeferredFrameTargets& targets,
        Core::GpuTimingSubmissionTicket*& timingTicket,
        const b8& meshViewSetupReady,
        const b8& sceneShadingSetupReady
    )noexcept;


public:
    void capture(
        Core::GpuTaskGraph& graph,
        Core::Alloc::ScratchArena& scratchArena,
        const MaterialPassDrawItemPartitions& opaqueDrawItems,
        const CsgFrameGpuData& csgFrameData,
        const ECSRenderDetail::MeshFrameBindingSnapshot& frameBindings,
        b8 hasOpaqueCsgFrameWork,
        b8 hasCsgFrameGpuWork,
        b8 gbufferMaterialSampledTexturesCollected,
        ECSRenderDetail::GbufferGraphTask::Payload& gbufferPayload,
        Optional<Core::GpuTimingMeasure>& opaqueRegularSharedComputeEmulationTiming
    );
    [[nodiscard]] ECSRenderDetail::OpaqueRegularComputeEmulationGraphTask::Payload& regularPayload()noexcept{ return m_regularPayload; }
    [[nodiscard]] ECSRenderDetail::OpaqueCsgReceiverComputeEmulationGraphTask::Payload& csgPayload()noexcept{ return m_csgPayload; }
    [[nodiscard]] const ECSRenderDetail::RegularSharedComputeEmulationGraphPlan& sharedPlan()const noexcept{ return m_sharedPlan; }
    [[nodiscard]] Core::GpuGraphResourceSetId regularOutputSet()const noexcept{ return m_regularOutputSet; }
    [[nodiscard]] Core::GpuGraphResourceSetId csgOutputSet()const noexcept{ return m_csgOutputSet; }
    [[nodiscard]] Core::GpuGraphResourceId sharedOutput()const noexcept{ return m_sharedOutput; }
    [[nodiscard]] b8 regularOutputOwned()const noexcept{ return m_regularOutputOwned; }
    [[nodiscard]] b8 sharedOutputOwned()const noexcept{ return m_sharedOutputOwned; }
    [[nodiscard]] b8 csgOutputOwned()const noexcept{ return m_csgOutputOwned; }


private:
    ECSRenderDetail::OpaqueRegularComputeEmulationGraphTask::Payload m_regularPayload;
    ECSRenderDetail::OpaqueCsgReceiverComputeEmulationGraphTask::Payload m_csgPayload;
    ECSRenderDetail::RegularSharedComputeEmulationGraphPlan m_sharedPlan;
    Core::GpuGraphResourceSetId m_regularOutputSet;
    Core::GpuGraphResourceSetId m_csgOutputSet;
    Core::GpuGraphResourceId m_sharedOutput;
    b8 m_regularOutputOwned = false;
    b8 m_sharedOutputOwned = false;
    b8 m_csgOutputOwned = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


