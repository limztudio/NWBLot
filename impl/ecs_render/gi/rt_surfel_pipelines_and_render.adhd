// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_graphics/gi_subsystem.adhd>
#include <impl/ecs_render/gi/quality_settings.adhd>
#include <impl/ecs_render/gi/rt_surfel_internal.adhd>
#include <impl/ecs_render/kernel/compute_pipeline_utils.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Name s_SurfelSpawnShaderDebugName = "ECSRender_SurfelSpawn";
const Name s_SurfelAgeFreeShaderDebugName = "ECSRender_SurfelAgeFree";
const Name s_SurfelHashBuildShaderDebugName = "ECSRender_SurfelHashBuild";
const Name s_SurfelTraceShaderDebugName = "ECSRender_SurfelTrace";
const Name s_SurfelTraceHwShaderDebugName = "ECSRender_SurfelTraceHw";
const Name s_SurfelResolveShaderDebugName = "ECSRender_SurfelResolve";
const Name s_SurfelUpsampleShaderDebugName = "ECSRender_SurfelUpsample";
const Name s_SurfelTraceBuildArgsShaderDebugName = "ECSRender_SurfelTraceBuildArgs";

const StringView s_SurfelSpawnPassLabel = "spawn";
const StringView s_SurfelAgeFreePassLabel = "age-free";
const StringView s_SurfelHashBuildPassLabel = "hash-build";
const StringView s_SurfelTracePassLabel = "trace";
const StringView s_SurfelTraceHwPassLabel = "HW trace";
const StringView s_SurfelResolvePassLabel = "resolve";
const StringView s_SurfelUpsamplePassLabel = "upsample";
const StringView s_SurfelTraceBuildArgsPassLabel = "trace build-args";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateSurfelPipelineDescriptorHeap(in b8 heapInitialized, in b8 includeAccelStruct, in b8 hasAccelStructLayout, in StringView passLabel){
    if(heapInitialized && (!includeAccelStruct || hasAccelStructLayout))
        return true;

    error("RendererSystem: surfel {} requires the initialized global descriptor heap", passLabel);
    return false;
}

void LogSurfelBindingLayoutCreateFailed(in StringView passLabel){
    error("RendererSystem: failed to create surfel {} binding layout", passLabel);
}

void LogSurfelPipelineCreateFailed(in StringView passLabel){
    error("RendererSystem: failed to create surfel {} compute pipeline", passLabel);
}

void LogSurfelPipelineCreated(in StringView passLabel){
    [essential]
    info("RendererSystem: created surfel {} compute pipeline", passLabel);
}

b8 AreAllSurfelGiPhasePipelinesReady(
    in b8 hasSpawn,
    in b8 hasAgeFree,
    in b8 hasHashBuild,
    in b8 hasTrace,
    in b8 hasResolve,
    in b8 hasUpsample,
    in b8 hasTraceBuildArgs
){
    return hasSpawn
        && hasAgeFree
        && hasHashBuild
        && hasTrace
        && hasResolve
        && hasUpsample
        && hasTraceBuildArgs
    ;
}

u32 ComputeSurfelLinearDispatchGroups(in u32 poolCapacity, in u32 linearGroupSize){
    return DivideUp(poolCapacity, linearGroupSize);
}

void ApplySurfelSpawnPushConstantSlots(mut SurfelHeapPushConstants inOutPush, in u32 worldPositionSlot, in u32 normalSlot){
    inOutPush.worldPositionSlot = worldPositionSlot;
    inOutPush.normalSlot = normalSlot;
}

void ApplySurfelResolvePushConstantSlots(
    mut SurfelHeapPushConstants inOutPush,
    in u32 worldPositionSlot,
    in u32 normalSlot,
    in u32 outputStorageHeapSlot
){
    inOutPush.worldPositionSlot = worldPositionSlot;
    inOutPush.normalSlot = normalSlot;
    inOutPush.outputStorageHeapSlot = outputStorageHeapSlot;
}

void ApplySurfelUpsamplePushConstantSlots(
    mut SurfelHeapPushConstants inOutPush,
    in u32 halfIrradianceSlot,
    in u32 normalSlot,
    in u32 worldPositionSlot,
    in u32 outputStorageHeapSlot
){
    inOutPush.halfIrradianceSlot = halfIrradianceSlot;
    inOutPush.normalSlot = normalSlot;
    inOutPush.worldPositionSlot = worldPositionSlot;
    inOutPush.outputStorageHeapSlot = outputStorageHeapSlot;
}

b8 HasSurfelPhaseAfterAgeFree(
    in b8 dispatchHashBuild,
    in b8 dispatchSpawn,
    in b8 dispatchTraceBuildArgs,
    in b8 dispatchTrace,
    in b8 dispatchResolve,
    in b8 dispatchRemaining
){
    return dispatchHashBuild || dispatchSpawn || dispatchTraceBuildArgs || dispatchTrace || dispatchResolve || dispatchRemaining;
}

b8 HasSurfelPhaseAfterHashBuild(
    in b8 dispatchSpawn,
    in b8 dispatchTraceBuildArgs,
    in b8 dispatchTrace,
    in b8 dispatchResolve,
    in b8 dispatchRemaining
){
    return dispatchSpawn || dispatchTraceBuildArgs || dispatchTrace || dispatchResolve || dispatchRemaining;
}

b8 HasSurfelPhaseAfterSpawn(
    in b8 dispatchTraceBuildArgs,
    in b8 dispatchTrace,
    in b8 dispatchResolve,
    in b8 dispatchRemaining
){
    return dispatchTraceBuildArgs || dispatchTrace || dispatchResolve || dispatchRemaining;
}

b8 HasSurfelPhaseAfterTraceBuildArgs(in b8 dispatchTrace, in b8 dispatchResolve, in b8 dispatchRemaining){
    return dispatchTrace || dispatchResolve || dispatchRemaining;
}

b8 HasSurfelPhaseAfterTrace(in b8 dispatchResolve, in b8 dispatchRemaining){
    return dispatchResolve || dispatchRemaining;
}

b8 HasCompletedSurfelCountReadbackValue(in u64 completedValue, in u64 tokenValue){
    return completedValue >= tokenValue;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 EnsureSurfelComputePipeline(
    in Func<64u, AssetRef<ComputeShader>(in GiSubsystem)> selector,
    in StringView variantName,
    in Name debugName,
    in b8 includeAccelStruct,
    in StringView passLabel,
    mut Device device,
    mut RendererShaderSystem shaderSystem,
    mut BindingLayoutHandle inOutLayout,
    mut ShaderHandle inOutShader,
    mut ComputePipelineHandle inOutPipeline,
    mut b8 inOutFailed
){
    if(inOutPipeline.valid())
        return true;
    if(inOutFailed)
        return false;

    in GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!ValidateSurfelPipelineDescriptorHeap(heap.isInitialized(), includeAccelStruct, heap.hasAccelStructLayout(), passLabel)){
        inOutFailed = true;
        return false;
    }
    if(!EnsurePushConstantBindingLayout(device, sizeof(SurfelHeapPushConstants), ShaderTypeMask::Compute, inOutLayout)){
        LogSurfelBindingLayoutCreateFailed(passLabel);
        inOutFailed = true;
        return false;
    }
    if(!shaderSystem.loadShader<ComputeShader, GiSubsystem>(selector, variantName, debugName, inOutShader)){
        inOutFailed = true;
        return false;
    }
    if(!CreateHeapComputePipeline(device, inOutShader, inOutLayout, includeAccelStruct, inOutPipeline)){
        LogSurfelPipelineCreateFailed(passLabel);
        inOutFailed = true;
        return false;
    }
    LogSurfelPipelineCreated(passLabel);
    return true;
}

b8 EnsureSurfelHwTracePipelineVariant(
    in b8 csg,
    mut GraphicsRuntime graphics,
    mut RendererShaderSystem shaderSystem,
    mut BindingLayoutHandle inOutLayout,
    mut ShaderHandle shader,
    mut ComputePipelineHandle pipeline,
    mut b8 failed
){
    if(pipeline.valid())
        return true;
    if(failed)
        return false;
    if(!graphics.queryFeatureSupport(Feature::RayTracingAccelStruct) || !graphics.queryFeatureSupport(Feature::RayQuery)){
        failed = true;
        return false;
    }

    return EnsureSurfelComputePipeline(
        lambda[](in GiSubsystem s) -> AssetRef<ComputeShader>{ return s.surfelTraceHwCs; },
        ResolveGiCsgVariant(csg),
        s_SurfelTraceHwShaderDebugName,
        true,
        s_SurfelTraceHwPassLabel,
        graphics.getDevice(),
        shaderSystem,
        inOutLayout,
        shader,
        pipeline,
        failed
    );
}

b8 SurfelGiPipelineSet::ensureSurfelSpawnPipeline(){
    return EnsureSurfelComputePipeline(
        lambda[](in GiSubsystem s) -> AssetRef<ComputeShader>{ return s.surfelSpawnCs; },
        s_ShaderArchiveDefaultVariant,
        s_SurfelSpawnShaderDebugName,
        false,
        s_SurfelSpawnPassLabel,
        this.m_graphics.getDevice(),
        this.m_shaderSystem,
        this.m_rayTracingState.m_surfelHeapBindingLayout,
        this.m_rayTracingState.m_surfelSpawnShader,
        this.m_rayTracingState.m_surfelSpawnPipeline,
        this.m_rayTracingState.m_surfelSpawnPipelineFailed
    );
}

b8 SurfelGiPipelineSet::ensureSurfelAgeFreePipeline(){
    return EnsureSurfelComputePipeline(
        lambda[](in GiSubsystem s) -> AssetRef<ComputeShader>{ return s.surfelAgeFreeCs; },
        s_ShaderArchiveDefaultVariant,
        s_SurfelAgeFreeShaderDebugName,
        false,
        s_SurfelAgeFreePassLabel,
        this.m_graphics.getDevice(),
        this.m_shaderSystem,
        this.m_rayTracingState.m_surfelHeapBindingLayout,
        this.m_rayTracingState.m_surfelAgeFreeShader,
        this.m_rayTracingState.m_surfelAgeFreePipeline,
        this.m_rayTracingState.m_surfelAgeFreePipelineFailed
    );
}

b8 SurfelGiPipelineSet::ensureSurfelHashBuildPipeline(){
    return EnsureSurfelComputePipeline(
        lambda[](in GiSubsystem s) -> AssetRef<ComputeShader>{ return s.surfelHashBuildCs; },
        s_ShaderArchiveDefaultVariant,
        s_SurfelHashBuildShaderDebugName,
        false,
        s_SurfelHashBuildPassLabel,
        this.m_graphics.getDevice(),
        this.m_shaderSystem,
        this.m_rayTracingState.m_surfelHeapBindingLayout,
        this.m_rayTracingState.m_surfelHashBuildShader,
        this.m_rayTracingState.m_surfelHashBuildPipeline,
        this.m_rayTracingState.m_surfelHashBuildPipelineFailed
    );
}

b8 SurfelGiPipelineSet::ensureSurfelTracePipeline(){
    if(this.m_rayTracingState.m_surfelUseCsgTrace){
        return EnsureSurfelComputePipeline(
            lambda[](in GiSubsystem s) -> AssetRef<ComputeShader>{ return s.surfelTraceCs; },
            ResolveGiCsgVariant(true),
            s_SurfelTraceShaderDebugName,
            false,
            s_SurfelTracePassLabel,
            this.m_graphics.getDevice(),
            this.m_shaderSystem,
            this.m_rayTracingState.m_surfelHeapBindingLayout,
            this.m_rayTracingState.m_surfelTraceCsgShader,
            this.m_rayTracingState.m_surfelTraceCsgPipeline,
            this.m_rayTracingState.m_surfelTraceCsgPipelineFailed
        );
    }
    return EnsureSurfelComputePipeline(
        lambda[](in GiSubsystem s) -> AssetRef<ComputeShader>{ return s.surfelTraceCs; },
        ResolveGiCsgVariant(false),
        s_SurfelTraceShaderDebugName,
        false,
        s_SurfelTracePassLabel,
        this.m_graphics.getDevice(),
        this.m_shaderSystem,
        this.m_rayTracingState.m_surfelHeapBindingLayout,
        this.m_rayTracingState.m_surfelTraceShader,
        this.m_rayTracingState.m_surfelTracePipeline,
        this.m_rayTracingState.m_surfelTracePipelineFailed
    );
}

// Hardware trace twin; other surfel passes are shared.
b8 SurfelGiPipelineSet::ensureSurfelTraceHwPipeline(){
    if(this.m_rayTracingState.m_surfelUseCsgTrace)
        return EnsureSurfelHwTracePipelineVariant(true, this.m_graphics, this.m_shaderSystem, this.m_rayTracingState.m_surfelHeapBindingLayout, this.m_rayTracingState.m_surfelTraceCsgHwShader, this.m_rayTracingState.m_surfelTraceCsgHwPipeline, this.m_rayTracingState.m_surfelTraceCsgHwPipelineFailed);
    return EnsureSurfelHwTracePipelineVariant(false, this.m_graphics, this.m_shaderSystem, this.m_rayTracingState.m_surfelHeapBindingLayout, this.m_rayTracingState.m_surfelTraceHwShader, this.m_rayTracingState.m_surfelTraceHwPipeline, this.m_rayTracingState.m_surfelTraceHwPipelineFailed);
}

b8 SurfelGiPipelineSet::ensureSurfelResolvePipeline(){
    return EnsureSurfelComputePipeline(
        lambda[](in GiSubsystem s) -> AssetRef<ComputeShader>{ return s.surfelResolveCs; },
        s_ShaderArchiveDefaultVariant,
        s_SurfelResolveShaderDebugName,
        false,
        s_SurfelResolvePassLabel,
        this.m_graphics.getDevice(),
        this.m_shaderSystem,
        this.m_rayTracingState.m_surfelHeapBindingLayout,
        this.m_rayTracingState.m_surfelResolveShader,
        this.m_rayTracingState.m_surfelResolvePipeline,
        this.m_rayTracingState.m_surfelResolvePipelineFailed
    );
}

b8 SurfelGiPipelineSet::ensureSurfelUpsamplePipeline(){
    return EnsureSurfelComputePipeline(
        lambda[](in GiSubsystem s) -> AssetRef<ComputeShader>{ return s.surfelUpsampleCs; },
        s_ShaderArchiveDefaultVariant,
        s_SurfelUpsampleShaderDebugName,
        false,
        s_SurfelUpsamplePassLabel,
        this.m_graphics.getDevice(),
        this.m_shaderSystem,
        this.m_rayTracingState.m_surfelHeapBindingLayout,
        this.m_rayTracingState.m_surfelUpsampleShader,
        this.m_rayTracingState.m_surfelUpsamplePipeline,
        this.m_rayTracingState.m_surfelUpsamplePipelineFailed
    );
}

b8 SurfelGiPipelineSet::ensureSurfelTraceBuildArgsPipeline(){
    return EnsureSurfelComputePipeline(
        lambda[](in GiSubsystem s) -> AssetRef<ComputeShader>{ return s.surfelTraceBuildArgsCs; },
        s_ShaderArchiveDefaultVariant,
        s_SurfelTraceBuildArgsShaderDebugName,
        false,
        s_SurfelTraceBuildArgsPassLabel,
        this.m_graphics.getDevice(),
        this.m_shaderSystem,
        this.m_rayTracingState.m_surfelHeapBindingLayout,
        this.m_rayTracingState.m_surfelTraceBuildArgsShader,
        this.m_rayTracingState.m_surfelTraceBuildArgsPipeline,
        this.m_rayTracingState.m_surfelTraceBuildArgsPipelineFailed
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/global.adhd.h>
#include <impl/assets/graphics/gi/surfel/surfel_binding_slots.h>
#include <impl/assets_graphics/gi_subsystem.adhd.h>
#include <impl/ecs_render/deferred/deferred_frame_targets.adhd.h>
#include <impl/ecs_render/gi/quality_settings.adhd.h>
#include <impl/ecs_render/gi/rt_surfel_gi_state.adhd.h>
#include <impl/ecs_render/gi/rt_surfel_internal.adhd.h>
#include <impl/ecs_render/kernel/compute_pipeline_utils.adhd.h>
#include <impl/ecs_render/kernel/timing_names.adhd.h>
#include <impl/ecs_render/raytrace/raytracing_system.adhd.h>
#include <impl/ecs_render/raytrace/renderer_raytracing_state.adhd.h>
#include <impl/ecs_render/raytrace/rt_private.adhd.h>
#include <impl/ecs_render/raytrace/task_graph_scene_resources.adhd.h>
#include <impl/ecs_render/shader/shader_system.adhd.h>

#include <core/common/log.h>
#include <core/graphics/backend_selection/backend.h>
#include <core/graphics/gpu_timing.h>
#include <core/graphics/runtime/runtime.h>
#include <core/graphics/shader_archive.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RendererRayTracingSystem::renderSurfelGiPhases(
    Core::CommandList& commandList,
    DeferredFrameTargets& targets,
    const DeferredLightingGraphResources& deferredLightingResources,
    const b8 dispatchAgeFree,
    const b8 dispatchHashBuild,
    const b8 dispatchSpawn,
    const b8 dispatchTraceBuildArgs,
    const b8 dispatchTrace,
    const b8 dispatchResolve,
    const b8 dispatchRemaining
){
    if(!hasSurfelWork())
        return true;

    FOUNDATION_ASSERT(targets.bindless.valid());
    Core::GpuDescriptorHeap& heap = m_graphics.getDevice().getDescriptorHeap();
    if(!heap.isInitialized())
        return false;

    // Only the trace pass is backend-specific.
    const b8 useHwTrace = m_rayTracingState.m_surfelUseHwTrace;
    const b8 useCsgTrace = m_rayTracingState.m_surfelUseCsgTrace;
    Core::ComputePipeline* const tracePipeline = useHwTrace
        ? (useCsgTrace ? m_rayTracingState.m_surfelTraceCsgHwPipeline.get() : m_rayTracingState.m_surfelTraceHwPipeline.get())
        : (useCsgTrace ? m_rayTracingState.m_surfelTraceCsgPipeline.get() : m_rayTracingState.m_surfelTracePipeline.get())
    ;

    if(!AreAllSurfelGiPhasePipelinesReady(
        static_cast<b8>(m_rayTracingState.m_surfelSpawnPipeline),
        static_cast<b8>(m_rayTracingState.m_surfelAgeFreePipeline),
        static_cast<b8>(m_rayTracingState.m_surfelHashBuildPipeline),
        tracePipeline != nullptr,
        static_cast<b8>(m_rayTracingState.m_surfelResolvePipeline),
        static_cast<b8>(m_rayTracingState.m_surfelUpsamplePipeline),
        static_cast<b8>(m_rayTracingState.m_surfelTraceBuildArgsPipeline)
    )){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: active surfel GI phase pipeline is missing"));
        return false;
    }

    if(
        !targets.bindless.valid()
        || !IsValidSurfelGiResolveFactor(targets.surfelResolveFactor)
        || !deferredLightingResources.valid()
        || !IsDescriptorClass(m_rayTracingState.m_surfelConstantsHeapHandle, Core::GpuDescriptorClass::UniformBuffer)
        || !IsDescriptorClass(m_rayTracingState.m_surfelPoolHeapHandle, Core::GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(m_rayTracingState.m_surfelGuidePoolHeapHandle, Core::GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(m_rayTracingState.m_surfelCellHeadHeapHandle, Core::GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(m_rayTracingState.m_surfelCounterHeapHandle, Core::GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(m_rayTracingState.m_surfelTraceIndirectArgsHeapHandle, Core::GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(m_rayTracingState.m_surfelFreeListHeapHandle, Core::GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(m_rayTracingState.m_surfelPoolSnapshotHeapHandle, Core::GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(m_rayTracingState.m_surfelCellHeadSnapshotHeapHandle, Core::GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(m_rayTracingState.m_rayTraceMaterialContextSlotsHeapHandle, Core::GpuDescriptorClass::UniformBuffer)
        || !IsDescriptorClass(targets.bindless.slotsBufferDescriptor, Core::GpuDescriptorClass::UniformBuffer)
        || !IsDescriptorClass(targets.bindless.gbufferWorldPosition, Core::GpuDescriptorClass::SampledImage)
        || !IsDescriptorClass(targets.bindless.gbufferNormal, Core::GpuDescriptorClass::SampledImage)
        || !IsDescriptorClass(targets.bindless.surfelIrradianceHalf, Core::GpuDescriptorClass::SampledImage)
        || !IsDescriptorClass(targets.bindless.surfelIrradianceHalfStorage, Core::GpuDescriptorClass::StorageImage)
        || !IsDescriptorClass(targets.bindless.surfelIrradianceStorage, Core::GpuDescriptorClass::StorageImage)
        || (useHwTrace && (!m_rayTracingState.m_tlas || !IsDescriptorClass(m_rayTracingState.m_tlasHeapHandle, Core::GpuDescriptorClass::AccelStruct)))
    ){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: surfel GI heap registration is incomplete"));
        return false;
    }

    const u32 poolCapacity = m_rayTracingState.m_surfelPoolCapacity;

    SurfelHeapPushConstants surfelPush = MakeSurfelHeapPushConstants(
        m_rayTracingState.m_surfelConstantsHeapHandle.slot(),
        m_rayTracingState.m_surfelPoolHeapHandle.slot(),
        m_rayTracingState.m_surfelGuidePoolHeapHandle.slot(),
        m_rayTracingState.m_surfelCellHeadHeapHandle.slot(),
        m_rayTracingState.m_surfelCounterHeapHandle.slot(),
        m_rayTracingState.m_surfelFreeListHeapHandle.slot(),
        m_rayTracingState.m_surfelPoolSnapshotHeapHandle.slot(),
        m_rayTracingState.m_surfelCellHeadSnapshotHeapHandle.slot(),
        m_rayTracingState.m_surfelTraceIndirectArgsHeapHandle.slot(),
        targets.bindless.slotsBufferDescriptor.slot(),
        m_rayTracingState.m_rayTraceMaterialContextSlotsHeapHandle.slot()
    );

    // Order every in-place field update, including prior-frame spawn writes.
    commandList.setEnableUavBarriersForBuffer(m_rayTracingState.m_surfelPoolBuffer.get(), true);
    commandList.setEnableUavBarriersForBuffer(m_rayTracingState.m_surfelGuidePoolBuffer.get(), true);
    commandList.setEnableUavBarriersForBuffer(m_rayTracingState.m_surfelCellHeadBuffer.get(), true);
    commandList.setEnableUavBarriersForBuffer(m_rayTracingState.m_surfelCounterBuffer.get(), true);
    commandList.setEnableUavBarriersForBuffer(m_rayTracingState.m_surfelFreeListBuffer.get(), true);
    commandList.setEnableUavBarriersForBuffer(m_rayTracingState.m_surfelTraceIndirectArgsBuffer.get(), true);

    // Age-free recycles unseen surfels before the graph-owned cell-head reset and hash rebuild.
    if(dispatchAgeFree){
        Core::GpuTimingMeasure timing(m_graphics.gpuTiming(), s_TimingScopeSurfelAgeFree, m_graphics.getDevice(), commandList);

        commandList.commitBarriers();
        Core::ComputeState state;
        state.setPipeline(m_rayTracingState.m_surfelAgeFreePipeline.get());
        commandList.setComputeState(state);
        heap.bindCompute(commandList, *m_rayTracingState.m_surfelAgeFreePipeline.get());
        commandList.setPushConstants(&surfelPush, sizeof(surfelPush));
        commandList.dispatch(ComputeSurfelLinearDispatchGroups(poolCapacity, static_cast<u32>(NWB_SURFEL_LINEAR_GROUP_SIZE)), 1u, 1u);
    }

    if(!HasSurfelPhaseAfterAgeFree(dispatchHashBuild, dispatchSpawn, dispatchTraceBuildArgs, dispatchTrace, dispatchResolve, dispatchRemaining))
        return true;

    // Rebuild bucket lists before spawning uncovered surface representatives.
    if(dispatchHashBuild){
        Core::GpuTimingMeasure timing(m_graphics.gpuTiming(), s_TimingScopeSurfelHashBuild, m_graphics.getDevice(), commandList);

        commandList.commitBarriers();
        Core::ComputeState state;
        state.setPipeline(m_rayTracingState.m_surfelHashBuildPipeline.get());
        commandList.setComputeState(state);
        heap.bindCompute(commandList, *m_rayTracingState.m_surfelHashBuildPipeline.get());
        commandList.setPushConstants(&surfelPush, sizeof(surfelPush));
        commandList.dispatch(ComputeSurfelLinearDispatchGroups(poolCapacity, static_cast<u32>(NWB_SURFEL_LINEAR_GROUP_SIZE)), 1u, 1u);
    }

    if(!HasSurfelPhaseAfterHashBuild(dispatchSpawn, dispatchTraceBuildArgs, dispatchTrace, dispatchResolve, dispatchRemaining))
        return true;

    // Spawn retains compatible surfaces and inserts uncovered candidates into bounded bucket lists.
    if(dispatchSpawn){
        Core::GpuTimingMeasure timing(m_graphics.gpuTiming(), s_TimingScopeSurfelSpawn, m_graphics.getDevice(), commandList);

        commandList.commitBarriers();

        ApplySurfelSpawnPushConstantSlots(surfelPush, targets.bindless.gbufferWorldPosition.slot(), targets.bindless.gbufferNormal.slot());

        Core::ComputeState state;
        state.setPipeline(m_rayTracingState.m_surfelSpawnPipeline.get());
        commandList.setComputeState(state);
        heap.bindCompute(commandList, *m_rayTracingState.m_surfelSpawnPipeline.get());
        commandList.setPushConstants(&surfelPush, sizeof(surfelPush));
        commandList.dispatch(ResolveSurfelSpawnDispatchGroup(targets.width, static_cast<u32>(NWB_SURFEL_GROUP_SIZE)), ResolveSurfelSpawnDispatchGroup(targets.height, static_cast<u32>(NWB_SURFEL_GROUP_SIZE)), 1u);
    }

    if(!HasSurfelPhaseAfterSpawn(dispatchTraceBuildArgs, dispatchTrace, dispatchResolve, dispatchRemaining))
        return true;

    // Build an indirect dispatch sized for live surfels.
    if(dispatchTraceBuildArgs){
        commandList.commitBarriers();
        Core::ComputeState state;
        state.setPipeline(m_rayTracingState.m_surfelTraceBuildArgsPipeline.get());
        commandList.setComputeState(state);
        heap.bindCompute(commandList, *m_rayTracingState.m_surfelTraceBuildArgsPipeline.get());
        commandList.setPushConstants(&surfelPush, sizeof(surfelPush));
        commandList.dispatch(NWB_SURFEL_TRACE_BUILD_ARGS_DISPATCH_GROUP_COUNT_X, NWB_SURFEL_TRACE_BUILD_ARGS_DISPATCH_GROUP_COUNT_Y, NWB_SURFEL_TRACE_BUILD_ARGS_DISPATCH_GROUP_COUNT_Z);
    }

    if(!HasSurfelPhaseAfterTraceBuildArgs(dispatchTrace, dispatchResolve, dispatchRemaining))
        return true;

    if(dispatchTrace){
        Core::GpuTimingMeasure timing(m_graphics.gpuTiming(), s_TimingScopeSurfelTrace, m_graphics.getDevice(), commandList);

        commandList.commitBarriers();
        Core::ComputeState state;
        state.setPipeline(tracePipeline);
        state.setIndirectParams(m_rayTracingState.m_surfelTraceIndirectArgsBuffer.get());
        commandList.setComputeState(state);
        // Hardware trace additionally selects the TLAS generation at set 2.
        if(m_rayTracingState.m_surfelUseHwTrace && !m_rayTracingState.m_tlasHeapHandle.valid()){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: cannot dispatch surfel HW GI without the descriptor-heap TLAS handle"));
            return false;
        }
        const Core::GpuDescriptorHandle tlasHeapHandle = m_rayTracingState.m_surfelUseHwTrace ? m_rayTracingState.m_tlasHeapHandle : Core::GpuDescriptorHandle::Invalid();
        heap.bindCompute(commandList, *tracePipeline, tlasHeapHandle);
        commandList.setPushConstants(&surfelPush, sizeof(surfelPush));
        commandList.dispatchIndirect(0u);
    }

    if(!HasSurfelPhaseAfterTrace(dispatchResolve, dispatchRemaining))
        return true;

    // Resolve at the target generation's selected scale so deferred lighting never touches the writable pool.
    if(dispatchResolve){
        const SurfelGiResolveSize resolveSize = MakeSurfelGiResolveSize(targets.width, targets.height, targets.surfelResolveFactor);
        {
            Core::GpuTimingMeasure timing(m_graphics.gpuTiming(), s_TimingScopeSurfelResolve, m_graphics.getDevice(), commandList);

            commandList.commitBarriers();

            ApplySurfelResolvePushConstantSlots(surfelPush, targets.bindless.gbufferWorldPosition.slot(), targets.bindless.gbufferNormal.slot(), targets.bindless.surfelIrradianceHalfStorage.slot());

            Core::ComputeState state;
            state.setPipeline(m_rayTracingState.m_surfelResolvePipeline.get());
            commandList.setComputeState(state);
            heap.bindCompute(commandList, *m_rayTracingState.m_surfelResolvePipeline.get());
            commandList.setPushConstants(&surfelPush, sizeof(surfelPush));
            const u32 groupSize = static_cast<u32>(NWB_SURFEL_RESOLVE_GROUP_SIZE);
            commandList.dispatch(DivideUp(resolveSize.width, groupSize), DivideUp(resolveSize.height, groupSize), 1u);
            if(commandList.commandRecordingFailed())
                return false;
            LogSurfelGiResolveDispatchIfNeeded(targets.surfelResolveFactor, targets.width, targets.height, resolveSize, m_rayTracingState.m_surfelResolveDispatchLogged);
        }
    }

    if(!dispatchRemaining)
        return true;

    // Surface-aware upsample preserves coverage across edges.
    {
        Core::GpuTimingMeasure timing(m_graphics.gpuTiming(), s_TimingScopeSurfelUpsample, m_graphics.getDevice(), commandList);

        commandList.commitBarriers();

        ApplySurfelUpsamplePushConstantSlots(
            surfelPush,
            targets.bindless.surfelIrradianceHalf.slot(),
            targets.bindless.gbufferNormal.slot(),
            targets.bindless.gbufferWorldPosition.slot(),
            targets.bindless.surfelIrradianceStorage.slot()
        );

        Core::ComputeState state;
        state.setPipeline(m_rayTracingState.m_surfelUpsamplePipeline.get());
        commandList.setComputeState(state);
        heap.bindCompute(commandList, *m_rayTracingState.m_surfelUpsamplePipeline.get());
        commandList.setPushConstants(&surfelPush, sizeof(surfelPush));
        const u32 groupSize = static_cast<u32>(NWB_SURFEL_UPSAMPLE_GROUP_SIZE);
        commandList.dispatch(DivideUp(targets.width, groupSize), DivideUp(targets.height, groupSize), 1u);
    }

    // The graph-owned late copy publishes its token only after Transfer/Compute/Graphics accepts. This pass only consumes completed diagnostics.
    {
        const u32 frameIndex = m_rayTracingState.m_surfelFrameIndex;
        const Core::QueueSubmissionToken submissionToken = m_rayTracingState.m_surfelCountReadbackSubmissionToken;
        b8 submissionComplete = false;
        if(submissionToken.valid() && submissionToken.hasPhysicalQueueIdentity()){
            const Expected<u64> completedValue = m_graphics.getDevice().queueGetCompletedInstance(Core::GpuPhysicalQueueId{ .index = submissionToken.physicalQueueIndex, .deviceGeneration = submissionToken.deviceGeneration, });
            submissionComplete = completedValue && HasCompletedSurfelCountReadbackValue(*completedValue, submissionToken.value);
        }
        if(submissionComplete && IsSurfelCountReadbackDelayElapsed(frameIndex, m_rayTracingState.m_surfelCountReadbackFrame)){
            Core::Buffer& readback = *m_rayTracingState.m_surfelCounterReadback;
            const Expected<void*> mappedCounts = m_graphics.getDevice().mapBuffer(readback, Core::CpuAccessMode::Read);
            if(mappedCounts){
                const NotNull<const u32*> counts = MakeNotNull(static_cast<const u32*>(*mappedCounts));
                const u32 bumpTop = counts.get()[NWB_SURFEL_COUNTER_BUMP_TOP];
                const u32 freeTop = counts.get()[NWB_SURFEL_COUNTER_FREE_TOP];
                const u32 geometryFailures = counts.get()[NWB_SURFEL_COUNTER_TRACE_GEOMETRY_FAILURE];
                m_graphics.getDevice().unmapBuffer(readback);
                LogSurfelCountReadbackCounts(
                    bumpTop,
                    freeTop,
                    geometryFailures,
                    m_rayTracingState.m_surfelPoolCapacity,
                    m_rayTracingState.m_surfelTraceGeometryFailureFlags
                );
            }
            m_rayTracingState.m_surfelCountReadbackSubmissionToken = {};
        }
    }

    // Subsequent frames use steady-state round-robin updates.
    AdvanceSurfelGiFrameState(m_rayTracingState.m_surfelSeeded, m_rayTracingState.m_surfelFrameIndex);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


