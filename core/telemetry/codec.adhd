extern const usize s_CodecPackedAlignBytes;
[cpp_header("<core/telemetry/codec.h>"), cpp_name("::NWB::Core::Telemetry::s_EncodedEventHeaderByteSize")]
extern const usize s_EncodedEventHeaderByteSize;
[cpp_header("<core/telemetry/codec.h>"), cpp_name("::NWB::Core::Telemetry::s_EncodedStreamHeaderByteSize")]
extern const usize s_EncodedStreamHeaderByteSize;
[cpp_header("<core/telemetry/codec.h>"), cpp_name("::NWB::Core::Telemetry::s_StreamMagic")]
extern const u32 s_StreamMagic;


