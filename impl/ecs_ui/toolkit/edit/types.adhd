#include <impl/ecs_ui/toolkit/edit/navigation_types.adhd>
#include <impl/ecs_ui/toolkit/edit/numeric_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The caret is visible for the first half of its one-second cycle.
const f64 s_CaretVisiblePhaseEnd = 0.5;
const usize s_EditDefaultMaxBytes = 4096u;
const usize s_EditDefaultMaxHistoryRecords = 64u;
const usize s_EditDefaultMaxHistoryBytes = 131072u;
const usize s_EditMaxBytes = 1048576u;
const usize s_EditMaxHistoryRecords = 256u;
const usize s_EditMaxHistoryBytes = 16777216u;
const StringView s_EditNewlineText = "\n";
const u32 s_EditUnicodeTab = 0x09u;
const u32 s_EditUnicodeLineFeed = 0x0Au;
const u32 s_EditUnicodeCarriageReturn = 0x0Du;
const u32 s_EditUnicodeNextLine = 0x85u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> EditAction{
    Submit,
    Cancel,
    Blur,
    Abandon,
}

enum<u8> EditCommand{
    None,
    Left,
    Right,
    Home,
    End,
    WordLeft,
    WordRight,
    Backspace,
    Delete,
    WordBackspace,
    WordDelete,
    SelectAll,
    Copy,
    Cut,
    Paste,
    Undo,
    Redo,
    Submit,
    Cancel,
    DocumentHome,
    DocumentEnd,
    Newline,
}

enum<u8> EditClipboardAction{
    None,
    Copy,
    Cut,
    Paste,
    PublishSelection,
}

enum<u8> EditTextStatus{
    InvalidText = 0u,
    TooLarge,
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TextAreaModelStamp{
    public TextAreaModelStamp(){
        this.instanceGeneration = 0u;
        this.revision = 0u;
        this.externalRevision = 0u;
        this.selectionGeneration = 0u;
        this.compositionGeneration = 0u;
        this.anchor = 0u;
        this.caret = 0u;
        this.textMode = EditTextMode::SingleLine;
    }

    public TextAreaModelStamp(
        in u64 inInstanceGeneration,
        in u64 inRevision,
        in u64 inExternalRevision,
        in u64 inSelectionGeneration,
        in u64 inCompositionGeneration,
        in usize inAnchor,
        in usize inCaret,
        in EditTextMode inTextMode
    ){
        this.instanceGeneration = inInstanceGeneration;
        this.revision = inRevision;
        this.externalRevision = inExternalRevision;
        this.selectionGeneration = inSelectionGeneration;
        this.compositionGeneration = inCompositionGeneration;
        this.anchor = inAnchor;
        this.caret = inCaret;
        this.textMode = inTextMode;
    }

    public b8 operator==(in TextAreaModelStamp rhs)const{
        return this.instanceGeneration == rhs.instanceGeneration
            && this.revision == rhs.revision
            && this.externalRevision == rhs.externalRevision
            && this.selectionGeneration == rhs.selectionGeneration
            && this.compositionGeneration == rhs.compositionGeneration
            && this.anchor == rhs.anchor
            && this.caret == rhs.caret
            && this.textMode == rhs.textMode;
    }

    public b8 operator!=(in TextAreaModelStamp rhs)const{
        return this.instanceGeneration != rhs.instanceGeneration
            || this.revision != rhs.revision
            || this.externalRevision != rhs.externalRevision
            || this.selectionGeneration != rhs.selectionGeneration
            || this.compositionGeneration != rhs.compositionGeneration
            || this.anchor != rhs.anchor
            || this.caret != rhs.caret
            || this.textMode != rhs.textMode;
    }

    public u64 instanceGeneration;
    public u64 revision;
    public u64 externalRevision;
    public u64 selectionGeneration;
    public u64 compositionGeneration;
    public usize anchor;
    public usize caret;
    public EditTextMode textMode;
}

class EditLimits{
    public usize maxBytes = s_EditDefaultMaxBytes;
    public usize maxHistoryRecords = s_EditDefaultMaxHistoryRecords;
    public usize maxHistoryBytes = s_EditDefaultMaxHistoryBytes;
}

class EditCompositionView{
    public StringView text = "";
    public usize anchor = 0u;
    public usize caret = 0u;
    public usize replacementStart = 0u;
    public usize replacementEnd = 0u;
    public b8 active = false;
}

class EditCommandRequest{
    public EditCommand command = EditCommand::None;
    public b8 extend = false;
    public b8 repeat = false;
}

class EditCommandResult{
    public EditClipboardAction clipboard = EditClipboardAction::None;
    public b8 handled = false;
    public b8 textChanged = false;
    public b8 selectionChanged = false;
    public b8 compositionChanged = false;
    public b8 submitted = false;
    public b8 cancelled = false;
}

class MultilineTextStep{
    public usize sourceBytes = 0u;
    public usize outputBytes = 0u;
    public u8 replacement = 0u;
}

class SingleLineTextStep{
    public usize sourceBytes = 0u;
    public usize outputBytes = 0u;
    public b8 space = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Bindings or device adapters supply admitted editing intent; native-consumed input is filtered before translation.
// Accept inserts LF in multiline mode and submits in single-line mode; Submit always submits.
EditCommandRequest TranslateEditCommand(in InputCommandIntent intent, in b8 repeat, in EditTextMode mode){
    EditCommandRequest request;
    request.command = EditCommand::None;
    request.extend = intent.extend;
    request.repeat = repeat;
    if(!intent.edit || cast<u8>(mode) > cast<u8>(EditTextMode::Multiline))
        return request;
    switch(intent.command){
        case InputCommand::Left: request.command = EditCommand::Left; break;
        case InputCommand::Right: request.command = EditCommand::Right; break;
        case InputCommand::Home: request.command = EditCommand::Home; break;
        case InputCommand::End: request.command = EditCommand::End; break;
        case InputCommand::WordLeft: request.command = EditCommand::WordLeft; break;
        case InputCommand::WordRight: request.command = EditCommand::WordRight; break;
        case InputCommand::DocumentHome:
            if(mode == EditTextMode::Multiline)
                request.command = EditCommand::DocumentHome;
            else
                request.command = EditCommand::Home;
            break;
        case InputCommand::DocumentEnd:
            if(mode == EditTextMode::Multiline)
                request.command = EditCommand::DocumentEnd;
            else
                request.command = EditCommand::End;
            break;
        case InputCommand::Backspace: request.command = EditCommand::Backspace; break;
        case InputCommand::Delete: request.command = EditCommand::Delete; break;
        case InputCommand::WordBackspace: request.command = EditCommand::WordBackspace; break;
        case InputCommand::WordDelete: request.command = EditCommand::WordDelete; break;
        case InputCommand::SelectAll: request.command = EditCommand::SelectAll; break;
        case InputCommand::Copy: request.command = EditCommand::Copy; break;
        case InputCommand::Cut: request.command = EditCommand::Cut; break;
        case InputCommand::Paste: request.command = EditCommand::Paste; break;
        case InputCommand::Undo: request.command = EditCommand::Undo; break;
        case InputCommand::Redo: request.command = EditCommand::Redo; break;
        case InputCommand::Accept:
            if(mode == EditTextMode::Multiline)
                request.command = EditCommand::Newline;
            else
                request.command = EditCommand::Submit;
            break;
        case InputCommand::Submit: request.command = EditCommand::Submit; break;
        case InputCommand::Cancel: request.command = EditCommand::Cancel; break;
        case InputCommand::Newline: request.command = EditCommand::Newline; break;
        default: break;
    }
    return request;
}

b8 IsMutatingEditCommand(in EditCommand command){
    return
        command == EditCommand::Backspace || command == EditCommand::Delete || command == EditCommand::WordBackspace
        || command == EditCommand::WordDelete || command == EditCommand::Cut || command == EditCommand::Paste
        || command == EditCommand::Undo || command == EditCommand::Redo || command == EditCommand::Newline
    ;
}

b8 ShouldSuppressEditCommandRepeat(in EditCommand command){
    return command == EditCommand::SelectAll || command == EditCommand::Copy || command == EditCommand::Cut || command == EditCommand::Paste || command == EditCommand::Submit || command == EditCommand::Cancel;
}

EditLimits ClampEditLimits(in EditLimits limits){
    EditLimits bounded;
    bounded.maxBytes = min(limits.maxBytes, s_EditMaxBytes);
    bounded.maxHistoryRecords = min(limits.maxHistoryRecords, s_EditMaxHistoryRecords);
    bounded.maxHistoryBytes = min(limits.maxHistoryBytes, s_EditMaxHistoryBytes);
    return bounded;
}

b8 IsSingleLineScalar(in u32 scalar){
    return scalar != 0u && scalar != s_EditUnicodeLineFeed && scalar != s_EditUnicodeCarriageReturn && scalar != s_TextUnicodeLineSeparator && scalar != s_TextUnicodeParagraphSeparator;
}

b8 IsSingleLineSpaceScalar(in u32 scalar){
    return (scalar >= s_EditUnicodeTab && scalar <= s_EditUnicodeCarriageReturn) || scalar == s_EditUnicodeNextLine || scalar == s_TextUnicodeLineSeparator || scalar == s_TextUnicodeParagraphSeparator;
}

b8 IsSingleLineRejectedScalar(in u32 scalar){
    return !IsSingleLineSpaceScalar(scalar) && (scalar < s_TextUnicodeSpace || scalar == s_TextUnicodeDelete);
}

b8 IsMultilineLineBreakScalar(in u32 scalar){
    return scalar == s_EditUnicodeCarriageReturn || scalar == s_EditUnicodeNextLine || scalar == s_TextUnicodeLineSeparator || scalar == s_TextUnicodeParagraphSeparator;
}

b8 IsCanonicalMultilineScalar(in u32 scalar){
    return scalar == s_EditUnicodeLineFeed || (scalar >= s_TextUnicodeSpace && (scalar < s_TextUnicodeDelete || scalar > s_TextUnicodeC1Last) && scalar != s_TextUnicodeLineSeparator && scalar != s_TextUnicodeParagraphSeparator);
}

// The caret has a one-second cycle. Invalid or nonpositive deltas leave its phase unchanged.
f64 AdvanceCaretPhase(in f64 phase, in f64 deltaSeconds){
    const b8 validPhase = isFinite(phase) && phase > 0.0;
    const b8 validDelta = isFinite(deltaSeconds) && deltaSeconds > 0.0;
    f64 phaseIn = 0.0;
    if(validPhase)
        phaseIn = phase;
    f64 deltaIn = 0.0;
    if(validDelta)
        deltaIn = deltaSeconds;
    const f64 wrappedPhase = phaseIn - floor(phaseIn);
    if(!validDelta)
        return wrappedPhase;
    const f64 wrappedDelta = deltaIn - floor(deltaIn);
    const f64 next = wrappedPhase + wrappedDelta;
    if(next >= 1.0)
        return next - 1.0;
    return next;
}

Expected<MultilineTextStep> TryBuildMultilineTextStep(in StringView source, in usize offset, in u32 scalar, in usize decodedBytes){
    MultilineTextStep outStep;
    outStep.sourceBytes = decodedBytes;
    const b8 lineBreak = IsMultilineLineBreakScalar(scalar);
    if(lineBreak || scalar == s_EditUnicodeTab){
        if(lineBreak)
            outStep.replacement = cast<u8>(s_EditUnicodeLineFeed);
        else
            outStep.replacement = cast<u8>(s_TextUnicodeSpace);
        outStep.outputBytes = 1u;
        if(scalar == s_EditUnicodeCarriageReturn && offset + outStep.sourceBytes < source.size() && cast<u32>(cast<u8>(source[offset + outStep.sourceBytes])) == s_EditUnicodeLineFeed)
            ++outStep.sourceBytes;
        return outStep;
    }
    if(!IsCanonicalMultilineScalar(scalar))
        return makeUnexpected(Failure());
    outStep.outputBytes = outStep.sourceBytes;
    return outStep;
}

Expected<SingleLineTextStep> TryBuildSingleLineTextStep(in StringView source, in usize offset, in u32 scalar, in usize decodedBytes){
    SingleLineTextStep outStep;
    if(IsSingleLineRejectedScalar(scalar))
        return makeUnexpected(Failure());
    const b8 space = IsSingleLineSpaceScalar(scalar);
    outStep.sourceBytes = decodedBytes;
    if(space)
        outStep.outputBytes = 1u;
    else
        outStep.outputBytes = outStep.sourceBytes;
    outStep.space = space;
    if(scalar == s_EditUnicodeCarriageReturn && offset + outStep.sourceBytes < source.size() && cast<u32>(cast<u8>(source[offset + outStep.sourceBytes])) == s_EditUnicodeLineFeed)
        ++outStep.sourceBytes;
    return outStep;
}

b8 ValidateGraphemeText(in StringView text, in b8 singleLine){
    if(text.size() > cast<usize>(i32.max))
        return false;
    usize offset = 0u;
    while(offset < text.size()){
        u32 scalar = 0u;
        usize byteCount = 0u;
        if(!tryDecodeUtf8Scalar(text.substr(offset, s_EditUtf8MaxSequenceBytes), scalar, byteCount))
            return false;
        if(singleLine && !IsSingleLineScalar(scalar))
            return false;
        offset += byteCount;
    }
    return true;
}

// Canonical multiline text contains LF and ordinary UTF8 scalars; all other ASCII/C1 controls and line separators fail.
b8 ValidateMultilineText(in StringView text){
    if(text.size() > cast<usize>(i32.max))
        return false;
    usize offset = 0u;
    while(offset < text.size()){
        u32 scalar = 0u;
        usize byteCount = 0u;
        if(!tryDecodeUtf8Scalar(text.substr(offset, s_EditUtf8MaxSequenceBytes), scalar, byteCount) || !IsCanonicalMultilineScalar(scalar))
            return false;
        offset += byteCount;
    }
    return true;
}

Expected<SingleLineTextStep> ReadSingleLineTextStep(in StringView source, in usize offset){
    u32 scalar = 0u;
    usize byteCount = 0u;
    if(!tryDecodeUtf8Scalar(source.substr(offset, s_EditUtf8MaxSequenceBytes), scalar, byteCount))
        return makeUnexpected(Failure());
    return TryBuildSingleLineTextStep(source, offset, scalar, byteCount);
}

Expected<MultilineTextStep> ReadMultilineTextStep(in StringView source, in usize offset){
    u32 scalar = 0u;
    usize byteCount = 0u;
    if(!tryDecodeUtf8Scalar(source.substr(offset, s_EditUtf8MaxSequenceBytes), scalar, byteCount))
        return makeUnexpected(Failure());
    return TryBuildMultilineTextStep(source, offset, scalar, byteCount);
}

b8 ValidateEditTextForMode(in StringView text, in EditTextMode textMode){
    if(textMode == EditTextMode::Multiline)
        return ValidateMultilineText(text);
    return ValidateGraphemeText(text, true);
}

Expected<usize, EditTextStatus> NormalizeSingleLineTextInto(in StringView source, in usize maxBytes, mut String outCandidate){
    if(!ValidateGraphemeText(source, false))
        return makeUnexpected(EditTextStatus::InvalidText);
    usize normalizedBytes = 0u;
    usize offset = 0u;
    while(offset < source.size()){
        const Expected<SingleLineTextStep> step = ReadSingleLineTextStep(source, offset);
        if(!step.has_value())
            return makeUnexpected(EditTextStatus::InvalidText);
        if(step.value().outputBytes > maxBytes - normalizedBytes)
            return makeUnexpected(EditTextStatus::TooLarge);
        normalizedBytes += step.value().outputBytes;
        offset += step.value().sourceBytes;
    }
    outCandidate.clear();
    outCandidate.reserve(normalizedBytes);
    offset = 0u;
    while(offset < source.size()){
        const Expected<SingleLineTextStep> step = ReadSingleLineTextStep(source, offset);
        assert(step.has_value());
        if(step.value().space)
            outCandidate += " ";
        else
            outCandidate.append(source.substr(offset, step.value().sourceBytes));
        offset += step.value().sourceBytes;
    }
    return normalizedBytes;
}

Expected<usize, EditTextStatus> NormalizeMultilineTextInto(in StringView source, in usize maxBytes, mut String outCandidate){
    if(!ValidateGraphemeText(source, false))
        return makeUnexpected(EditTextStatus::InvalidText);
    usize normalizedBytes = 0u;
    usize offset = 0u;
    while(offset < source.size()){
        const Expected<MultilineTextStep> step = ReadMultilineTextStep(source, offset);
        if(!step.has_value())
            return makeUnexpected(EditTextStatus::InvalidText);
        if(step.value().outputBytes > maxBytes - normalizedBytes)
            return makeUnexpected(EditTextStatus::TooLarge);
        normalizedBytes += step.value().outputBytes;
        offset += step.value().sourceBytes;
    }
    outCandidate.clear();
    outCandidate.reserve(normalizedBytes);
    offset = 0u;
    while(offset < source.size()){
        const Expected<MultilineTextStep> step = ReadMultilineTextStep(source, offset);
        assert(step.has_value());
        if(step.value().replacement != 0u){
            if(cast<u32>(step.value().replacement) == s_EditUnicodeLineFeed)
                outCandidate += "\n";
            else
                outCandidate += " ";
        }
        else{
            outCandidate.append(source.substr(offset, step.value().sourceBytes));
        }
        offset += step.value().sourceBytes;
    }
    return normalizedBytes;
}

void BuildReplacedEditString(in StringView currentText, in usize begin, in usize end, in StringView replacement, mut String outCandidate){
    const usize retainedBytes = currentText.size() - (end - begin);
    outCandidate.clear();
    outCandidate.reserve(retainedBytes + replacement.size());
    outCandidate.append(currentText.substr(0u, begin));
    if(!replacement.empty())
        outCandidate.append(replacement);
    outCandidate.append(currentText.substr(end, currentText.size() - end));
}

void BuildErasedAroundSelectionEditString(in StringView currentText, in usize beforeBytes, in usize afterBytes, in usize start, in usize end, mut String outCandidate){
    const usize prefixEnd = start - beforeBytes;
    const usize suffixStart = end + afterBytes;
    outCandidate.clear();
    outCandidate.reserve(currentText.size() - beforeBytes - afterBytes);
    outCandidate.append(currentText.substr(0u, prefixEnd));
    outCandidate.append(currentText.substr(start, end - start));
    outCandidate.append(currentText.substr(suffixStart, currentText.size() - suffixStart));
}

b8 MatchesEditModelSurrounding(
    in TextAreaModelStamp currentStamp,
    in StringView currentText,
    in TextAreaModelStamp expectedStamp,
    in StringView expectedText
){
    return currentStamp.revision == expectedStamp.revision
        && currentStamp.externalRevision == expectedStamp.externalRevision
        && currentStamp.selectionGeneration == expectedStamp.selectionGeneration
        && currentText == expectedText
        && currentStamp.anchor == expectedStamp.anchor
        && currentStamp.caret == expectedStamp.caret;
}

b8 MatchesEditModelSnapshot(
    in TextAreaModelStamp currentStamp,
    in StringView currentText,
    in EditCompositionView currentComposition,
    in TextAreaModelStamp expectedStamp,
    in StringView expectedText,
    in EditCompositionView expectedComposition,
    in StringView expectedPreedit
){
    return currentStamp == expectedStamp
        && currentText == expectedText
        && currentComposition.active == expectedComposition.active
        && currentComposition.text == expectedPreedit
        && currentComposition.anchor == expectedComposition.anchor
        && currentComposition.caret == expectedComposition.caret
        && currentComposition.replacementStart == expectedComposition.replacementStart
        && currentComposition.replacementEnd == expectedComposition.replacementEnd;
}

Expected<EditMove> TryMapEditCommandToMove(in EditCommand command){
    switch(command){
    case EditCommand::Left: return EditMove::Left;
    case EditCommand::Right: return EditMove::Right;
    case EditCommand::Home: return EditMove::Home;
    case EditCommand::End: return EditMove::End;
    case EditCommand::WordLeft: return EditMove::WordLeft;
    case EditCommand::WordRight: return EditMove::WordRight;
    case EditCommand::DocumentHome: return EditMove::DocumentHome;
    case EditCommand::DocumentEnd: return EditMove::DocumentEnd;
    default: return makeUnexpected(Failure());
    }
}

Expected<EditCommandResult> TryMapEditCommandToPassiveResult(in EditCommand command){
    EditCommandResult outResult;
    outResult.handled = true;
    switch(command){
    case EditCommand::Copy: outResult.clipboard = EditClipboardAction::Copy; return outResult;
    case EditCommand::Cut: outResult.clipboard = EditClipboardAction::Cut; return outResult;
    case EditCommand::Paste: outResult.clipboard = EditClipboardAction::Paste; return outResult;
    case EditCommand::Submit: outResult.submitted = true; return outResult;
    case EditCommand::Cancel: outResult.cancelled = true; return outResult;
    default: return makeUnexpected(Failure());
    }
}

b8 CanEraseAroundEditSelection(
    in usize beforeBytes,
    in usize afterBytes,
    in usize start,
    in usize end,
    in usize textSize,
    in Span<usize> boundaries
){
    if(beforeBytes > start || afterBytes > textSize - end)
        return false;
    return IsEditBoundary(boundaries, start - beforeBytes) && IsEditBoundary(boundaries, end + afterBytes);
}

b8 CanUpdateEditComposition(
    in b8 compositionActive,
    in StringView value,
    in usize anchor,
    in usize caret,
    in usize textSize,
    in usize compositionAnchor,
    in usize compositionCaret,
    in usize maxBytes
){
    if(!compositionActive || value.size() > maxBytes)
        return false;
    if(!isUtf8ScalarBoundary(value, anchor) || !isUtf8ScalarBoundary(value, caret))
        return false;
    const usize replacedBytes = max(compositionAnchor, compositionCaret) - min(compositionAnchor, compositionCaret);
    const usize retainedBytes = textSize - replacedBytes;
    return retainedBytes <= maxBytes - value.size();
}

b8 CanReplaceEditRange(
    in usize begin,
    in usize end,
    in usize replacementSize,
    in usize textSize,
    in usize maxBytes,
    in Span<usize> boundaries
){
    if(begin > end || !IsEditBoundary(boundaries, begin) || !IsEditBoundary(boundaries, end) || replacementSize > maxBytes)
        return false;
    const usize retainedBytes = textSize - (end - begin);
    return retainedBytes <= maxBytes - replacementSize;
}

usize ResolveReplacedEditCaret(in Span<usize> boundaries, in usize begin, in usize replacementSize){
    usize caret = begin + replacementSize;
    for(usize index = 0u; index < boundaries.size(); ++index){
        if(boundaries[index] >= caret){
            caret = boundaries[index];
            break;
        }
    }
    return caret;
}

b8 CanRecordEditHistory(in usize maxHistoryRecords, in usize maxHistoryBytes, in usize cost){
    return maxHistoryRecords != 0u && cost <= maxHistoryBytes;
}


