    public b8 setBodyEnabled(in EntityID entity, in b8 enabled){
        const auto found = this.m_entityRecords.find(entity);
        if(found == this.m_entityRecords.end() || found.value().attachedToParentBody || !found.value().bodyId.valid())
            return false;
        const BodyId bodyId = found.value().bodyId;
        if(!this.m_physicsWorld.setBodyEnabled(bodyId, enabled))
            return false;
        ClearStaticBodyPoseCacheIfMatches(bodyId, this.m_syncScratch.staticBodyPoseCache);
        if(this.m_world.alive(entity)){
            const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
            if(rbOpt.has_value()){
                rbOpt.value().isEnabled = enabled;
                SyncRigidBodyVelocityAndAwakeDirect(this.m_physicsWorld, bodyId.index, rbOpt.value());
            }
        }
        return true;
    }

    public b8 setBodyType(in EntityID entity, in BodyType newType){
        const auto found = this.m_entityRecords.find(entity);
        if(found == this.m_entityRecords.end() || found.value().attachedToParentBody || !found.value().bodyId.valid())
            return false;
        const BodyId bodyId = found.value().bodyId;
        if(!this.m_physicsWorld.setBodyType(bodyId, newType))
            return false;
        ClearStaticBodyPoseCacheIfMatches(bodyId, this.m_syncScratch.staticBodyPoseCache);
        if(newType != BodyType::Static){
            const Expected<Transform3D> curXf = this.m_physicsWorld.tryGetBodyTransform(bodyId);
            if(curXf.has_value())
                SetBodyTransformSnapshotBoth(bodyId, curXf.value(), this.m_bodyTransformSnapshots, this.m_bodyTransformSnapshotMeta);
        }
        if(this.m_world.alive(entity)){
            const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
            if(rbOpt.has_value()){
                rbOpt.value().type = newType;
                SyncRigidBodyVelocityAndAwakeDirect(this.m_physicsWorld, bodyId.index, rbOpt.value());
            }
        }
        return true;
    }

    public b8 setBodyTransform(in EntityID entity, in VectorSingle position, in VectorSingle rotation){
        const auto found = this.m_entityRecords.find(entity);
        if(found == this.m_entityRecords.end() || found.value().attachedToParentBody || !found.value().bodyId.valid())
            return false;
        const BodyId bodyId = found.value().bodyId;
        if(!this.m_physicsWorld.setBodyTransform(bodyId, position, rotation))
            return false;
        const Transform3D normXf(position, SafeNormalizeQuat(rotation));
        SetBodySyncedPose(bodyId, normXf, this.m_syncScratch.bodySyncedPoses);
        SetBodyTransformSnapshotBoth(bodyId, normXf, this.m_bodyTransformSnapshots, this.m_bodyTransformSnapshotMeta);
        ClearStaticBodyPoseCacheIfMatches(bodyId, this.m_syncScratch.staticBodyPoseCache);
        if(this.m_world.alive(entity)){
            WriteWorldPoseBackToEntityTransform(entity, normXf, this.m_world);
            this.syncEcsRigidBodyRuntimeState(entity, bodyId);
        }
        return true;
    }

    public b8 setBodyTransform(in EntityID entity, in Transform3D xf){
        return this.setBodyTransform(entity, VectorSingle(xf.position), VectorSingle(xf.rotation));
    }

    public Expected<Transform3D> tryGetBodyTransform(in EntityID entity)const{
        const auto found = this.m_entityRecords.find(entity);
        if(found == this.m_entityRecords.end() || !found.value().bodyId.valid())
            return MakeUnexpected(Failure());
        return this.m_physicsWorld.tryGetBodyTransform(found.value().bodyId);
    }

    public b8 setGravityScale(in EntityID entity, in f32 gravityScale){
        const auto found = this.m_entityRecords.find(entity);
        if(found == this.m_entityRecords.end() || found.value().attachedToParentBody || !found.value().bodyId.valid())
            return false;
        const BodyId bodyId = found.value().bodyId;
        if(!this.m_physicsWorld.setGravityScale(bodyId, gravityScale))
            return false;
        if(this.m_world.alive(entity)){
            const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
            if(rbOpt.has_value())
                rbOpt.value().gravityScale = gravityScale;
        }
        return true;
    }

    public b8 setBodyBullet(in EntityID entity, in b8 isBullet){
        const auto found = this.m_entityRecords.find(entity);
        if(found == this.m_entityRecords.end() || found.value().attachedToParentBody || !found.value().bodyId.valid())
            return false;
        const BodyId bodyId = found.value().bodyId;
        if(!this.m_physicsWorld.setBodyBullet(bodyId, isBullet))
            return false;
        if(this.m_world.alive(entity)){
            const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
            if(rbOpt.has_value())
                rbOpt.value().isBullet = isBullet;
        }
        return true;
    }

    public b8 setBodyMaxAngularVelocity(in EntityID entity, in f32 maxAngularVelocity){
        const auto found = this.m_entityRecords.find(entity);
        if(found == this.m_entityRecords.end() || found.value().attachedToParentBody || !found.value().bodyId.valid())
            return false;
        const BodyId bodyId = found.value().bodyId;
        if(!this.m_physicsWorld.setBodyMaxAngularVelocity(bodyId, maxAngularVelocity))
            return false;
        if(this.m_world.alive(entity)){
            const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
            if(rbOpt.has_value()){
                rbOpt.value().maxAngularVelocity = maxAngularVelocity;
                rbOpt.value().hasCustomMaxAngularVelocity = (maxAngularVelocity > 0.0f);
            }
        }
        return true;
    }

    public b8 captureWorldSnapshot(mut Vector<u8> outBytes)const{
        return SerializePhysicsWorldSnapshot(this.m_physicsWorld, outBytes);
    }

    public b8 restoreWorldSnapshot(in Span<u8> bytes){
        if(!RestorePhysicsWorldSnapshot(bytes, this.m_physicsWorld))
            return false;

        const usize bodyCount = this.m_physicsWorld.m_bodies.size();
        const usize shapeCount = this.m_physicsWorld.m_shapes.size();
        const usize jointCount = this.m_physicsWorld.m_joints.size();
        this.m_bodyIndexToEntity.clear();
        this.m_bodyIndexToEntity.resize(bodyCount);
        this.m_shapeIndexToEntity.clear();
        this.m_shapeIndexToEntity.resize(shapeCount);
        this.m_jointIndexToEntity.clear();
        this.m_jointIndexToEntity.resize(jointCount);

        Vector<EntityID> removeRecs;
        for(in auto kv : this.m_entityRecords){
            const EntityID entity = kv.first;
            mut EcsEntityPhysicsRecord rec = this.m_entityRecords.at(entity);
            const b8 validBody = rec.bodyId.valid() && this.m_physicsWorld.isValidBody(rec.bodyId);
            const b8 validPrimary = rec.primaryShapeId.valid() && this.m_physicsWorld.isValidShape(rec.primaryShapeId);
            Vector<ShapeId> validExtras;
            for(usize si = 0u; si < rec.extraShapeIds.size(); ++si){
                const ShapeId sId = rec.extraShapeIds[si];
                if(sId.valid() && this.m_physicsWorld.isValidShape(sId))
                    validExtras.push_back(sId);
            }
            const b8 droppedExtra = (validExtras.size() != rec.extraShapeIds.size());
            const b8 entityAlive = this.m_world.alive(entity);

            if(!validBody && !validPrimary && validExtras.empty()){
                removeRecs.push_back(entity);
                if(entityAlive){
                    const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
                    if(rbOpt.has_value()){
                        rbOpt.value().runtimeBodyId = BodyId();
                        rbOpt.value().dirty = true;
                    }
                    const Optional<mut ColliderComponent> colOpt = this.m_world.borrowComponent<ColliderComponent>(entity);
                    if(colOpt.has_value()){
                        colOpt.value().runtimeShapeId = ShapeId();
                        colOpt.value().runtimeExtraShapeIds.clear();
                        colOpt.value().boundBodyId = BodyId();
                        colOpt.value().dirty = true;
                    }
                }
                continue;
            }

            if(!validBody){
                rec.bodyId = BodyId();
                rec.attachedToParentBody = false;
                rec.parentBodyEntity = s_InvalidEntityId;
                if(entityAlive){
                    const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
                    if(rbOpt.has_value()){
                        rbOpt.value().runtimeBodyId = BodyId();
                        rbOpt.value().dirty = true;
                    }
                }
            }
            else if(!rec.attachedToParentBody && rec.bodyId.index < cast<u32>(bodyCount)){
                in Body b = this.m_physicsWorld.m_bodies[rec.bodyId.index];
                mut EcsSlotOwner bOwner = this.m_bodyIndexToEntity[rec.bodyId.index];
                bOwner.entity = entity;
                bOwner.generation = b.generation;
                bOwner.hasPhysicsParent = rec.hadPhysicsParent;
                if(entityAlive){
                    const Expected<Transform3D> xf = this.m_physicsWorld.tryGetBodyTransform(rec.bodyId);
                    if(xf.has_value())
                        WriteWorldPoseBackToEntityTransform(entity, xf.value(), this.m_world);
                    const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
                    if(rbOpt.has_value()){
                        mut RigidBodyComponent rb = rbOpt.value();
                        rb.runtimeBodyId = rec.bodyId;
                        rb.type = b.type;
                        rb.isEnabled = this.m_physicsWorld.isBodyEnabled(rec.bodyId);
                        rb.isBullet = (b.flags & cast<u32>(BodyFlags::IsBullet)) != 0u;
                        rb.hasCustomMaxAngularVelocity = (b.flags & cast<u32>(BodyFlags::HasCustomMaxAngularVelocity)) != 0u;
                        if(rb.hasCustomMaxAngularVelocity)
                            rb.maxAngularVelocity = b.maxAngularVelocity;
                        else
                            rb.maxAngularVelocity = 0.0f;
                        if(b.setIndex < this.m_physicsWorld.m_solverSets.size() && b.localIndex < this.m_physicsWorld.m_solverSets[b.setIndex].sims.size())
                            rb.gravityScale = this.m_physicsWorld.m_solverSets[b.setIndex].sims[b.localIndex].gravityScale;
                        SyncRigidBodyVelocityAndAwakeDirect(this.m_physicsWorld, rec.bodyId.index, rb);
                        rb.dirty = false;
                    }
                }
            }

            if(validPrimary && rec.primaryShapeId.index < cast<u32>(shapeCount)){
                mut EcsSlotOwner sOwner = this.m_shapeIndexToEntity[rec.primaryShapeId.index];
                sOwner.entity = entity;
                sOwner.generation = rec.primaryShapeId.generation;
                sOwner.hasPhysicsParent = rec.hadPhysicsParent;
            }
            else if(!validPrimary){
                rec.primaryShapeId = ShapeId();
            }

            if(droppedExtra){
                rec.extraShapeIds.clear();
                for(usize si = 0u; si < validExtras.size(); ++si)
                    rec.extraShapeIds.push_back(validExtras[si]);
            }
            for(usize si = 0u; si < validExtras.size(); ++si){
                const ShapeId sId = validExtras[si];
                if(sId.index < cast<u32>(shapeCount)){
                    mut EcsSlotOwner sOwner = this.m_shapeIndexToEntity[sId.index];
                    sOwner.entity = entity;
                    sOwner.generation = sId.generation;
                    sOwner.hasPhysicsParent = rec.hadPhysicsParent;
                }
            }

            if(entityAlive){
                const Optional<mut ColliderComponent> colOpt = this.m_world.borrowComponent<ColliderComponent>(entity);
                if(colOpt.has_value()){
                    mut ColliderComponent col = colOpt.value();
                    col.runtimeShapeId = rec.primaryShapeId;
                    col.runtimeExtraShapeIds.clear();
                    for(usize si = 0u; si < validExtras.size(); ++si)
                        col.runtimeExtraShapeIds.push_back(validExtras[si]);
                    col.boundBodyId = rec.bodyId;
                    if(!validPrimary || droppedExtra || !validBody)
                        col.dirty = true;
                }
            }
        }
        for(usize ri = 0u; ri < removeRecs.size(); ++ri)
            this.m_entityRecords.erase(removeRecs[ri]);

        Vector<EntityID> removeJoints;
        for(in auto kv : this.m_entityJoints){
            const EntityID entity = kv.first;
            mut EcsJointSyncRecord jRec = this.m_entityJoints.at(entity);
            jRec.hasStructure = false;
            const b8 validPrimaryJoint = jRec.jointId.valid() && this.m_physicsWorld.isValidJoint(jRec.jointId);
            if(validPrimaryJoint && jRec.jointId.index < cast<u32>(jointCount)){
                mut EcsSlotOwner jOwner = this.m_jointIndexToEntity[jRec.jointId.index];
                jOwner.entity = entity;
                jOwner.generation = jRec.jointId.generation;
                jRec.primaryBroken = false;
            }
            else{
                jRec.jointId = JointId();
            }

            b8 anyValidExtra = false;
            for(usize ei = 0u; ei < jRec.extraJointIds.size(); ++ei){
                const JointId eId = jRec.extraJointIds[ei];
                if(eId.valid() && this.m_physicsWorld.isValidJoint(eId) && eId.index < cast<u32>(jointCount)){
                    mut EcsSlotOwner eOwner = this.m_jointIndexToEntity[eId.index];
                    eOwner.entity = entity;
                    eOwner.generation = eId.generation;
                    anyValidExtra = true;
                    if(ei < jRec.extraBroken.size())
                        jRec.extraBroken[ei] = false;
                }
                else{
                    jRec.extraJointIds[ei] = JointId();
                }
            }

            const b8 entityAlive = this.m_world.alive(entity);
            if(!validPrimaryJoint && !anyValidExtra){
                removeJoints.push_back(entity);
                if(entityAlive){
                    const Optional<mut JointComponent> jcOpt = this.m_world.borrowComponent<JointComponent>(entity);
                    if(jcOpt.has_value()){
                        mut JointComponent jc = jcOpt.value();
                        jc.runtimeJointId = JointId();
                        jc.runtimeExtraJointIds.clear();
                        jc.boundBodyIdA = BodyId();
                        jc.boundBodyIdB = BodyId();
                        jc.boundExtraBodyIdAs.clear();
                        jc.boundExtraBodyIdBs.clear();
                        jc.dirty = true;
                    }
                }
                continue;
            }

            if(entityAlive){
                const Optional<mut JointComponent> jcOpt = this.m_world.borrowComponent<JointComponent>(entity);
                if(jcOpt.has_value()){
                    mut JointComponent jc = jcOpt.value();
                    jc.runtimeJointId = jRec.jointId;
                    jc.runtimeExtraJointIds.clear();
                    for(usize ei = 0u; ei < jRec.extraJointIds.size(); ++ei)
                        jc.runtimeExtraJointIds.push_back(jRec.extraJointIds[ei]);
                }
            }
        }
        for(usize ri = 0u; ri < removeJoints.size(); ++ri)
            this.m_entityJoints.erase(removeJoints[ri]);

        Vector<EntityID> removeRagdolls;
        for(in auto kv : this.m_activeRagdolls){
            const EntityID entity = kv.first;
            in EcsTrackedRagdoll tracked = kv.second;
            b8 ragdollValid = this.m_world.alive(entity) && !tracked.boneBodies.empty();
            if(ragdollValid){
                for(usize bi = 0u; bi < tracked.boneBodies.size(); ++bi){
                    if(!this.m_physicsWorld.isValidBody(tracked.boneBodies[bi])){
                        ragdollValid = false;
                        break;
                    }
                }
            }
            if(!ragdollValid){
                removeRagdolls.push_back(entity);
                if(this.m_world.alive(entity)){
                    const Optional<mut RagdollComponent> rcOpt = this.m_world.borrowComponent<RagdollComponent>(entity);
                    if(rcOpt.has_value()){
                        rcOpt.value().initialized = false;
                        rcOpt.value().dirty = true;
                        rcOpt.value().instance = RagdollInstance();
                    }
                }
                continue;
            }
            for(usize bi = 0u; bi < tracked.boneBodies.size(); ++bi){
                const BodyId bId = tracked.boneBodies[bi];
                if(bId.index < cast<u32>(bodyCount)){
                    mut EcsSlotOwner bOwner = this.m_bodyIndexToEntity[bId.index];
                    bOwner.entity = entity;
                    bOwner.generation = bId.generation;
                }
            }
            for(usize si = 0u; si < tracked.boneShapes.size(); ++si){
                const ShapeId sId = tracked.boneShapes[si];
                if(sId.valid() && this.m_physicsWorld.isValidShape(sId) && sId.index < cast<u32>(shapeCount)){
                    mut EcsSlotOwner sOwner = this.m_shapeIndexToEntity[sId.index];
                    sOwner.entity = entity;
                    sOwner.generation = sId.generation;
                }
            }
            for(usize ji = 0u; ji < tracked.joints.size(); ++ji){
                const JointId jId = tracked.joints[ji];
                if(jId.valid() && this.m_physicsWorld.isValidJoint(jId) && jId.index < cast<u32>(jointCount)){
                    mut EcsSlotOwner jOwner = this.m_jointIndexToEntity[jId.index];
                    jOwner.entity = entity;
                    jOwner.generation = jId.generation;
                }
            }
        }
        for(usize ri = 0u; ri < removeRagdolls.size(); ++ri)
            this.m_activeRagdolls.erase(removeRagdolls[ri]);
        WriteBackEcsRagdollRootPoses(this.m_world, this.m_physicsWorld);

        this.m_bodyTransformSnapshots.resize(bodyCount);
        this.m_bodyTransformSnapshotMeta.resize(bodyCount, 0u);
        for(usize bi = 0u; bi < bodyCount; ++bi){
            in Body b = this.m_physicsWorld.m_bodies[bi];
            const BodyId id = this.m_physicsWorld.makeBodyId(cast<u32>(bi));
            if(b.alive && id.valid()){
                const Expected<Transform3D> xf = this.m_physicsWorld.tryGetBodyTransform(id);
                if(xf.has_value())
                    SetBodyTransformSnapshotBoth(id, xf.value(), this.m_bodyTransformSnapshots, this.m_bodyTransformSnapshotMeta);
                else
                    this.m_bodyTransformSnapshotMeta[bi] = 0u;
            }
            else{
                this.m_bodyTransformSnapshotMeta[bi] = 0u;
            }
        }
        Vector<ContactEndTouchEvent> discardCE;
        Vector<SensorEndTouchEvent> discardSE;
        Vector<BodyWakeEvent> discardBW;
        this.m_physicsWorld.consumePendingEndEvents(discardCE, discardSE);
        this.m_physicsWorld.consumePendingWakeEvents(discardBW);
        this.clearFrameEvents();
        ClearDestroyedSlotOwners(this.m_syncScratch);
        this.m_syncScratch.bodySyncedPoses.clear();
        this.m_syncScratch.staticBodyPoseCache.clear();
        this.m_syncScratch.pendingWriteBackBodyIndices.clear();
        this.m_syncScratch.prevAwakeWriteBackBodyIndices.clear();
        this.m_syncScratch.nextAwakeWriteBackBodyIndices.clear();
        this.m_syncScratch.dirtyPrevSnapshotBodyIndices.clear();
        this.m_syncScratch.drivenKinematicEntries.clear();
        this.m_syncScratch.kinematicTargets.clear();
        this.m_syncScratch.hasSyncedTopologyVersion = false;
        this.m_syncScratch.hasRagdollTopology = false;
        this.m_syncScratch.mutationVersionsValid = false;
        this.m_accumulator = 0.0f;
        this.m_interpolationAlpha = 1.0f;
        return true;
    }

    public void setCollisionLayerMatrix(in CollisionLayerMatrix matrix){
        this.m_collisionLayerMatrix = matrix;
    }

    public in CollisionLayerMatrix collisionLayerMatrix()const{
        return this.m_collisionLayerMatrix;
    }

    public b8 loadCollisionLayerMatrixAsset(in AssetRef<CollisionLayerMatrixAsset> assetRef){
        if(!assetRef.valid() || !this.m_assetManager.has_value())
            return false;
        const auto loaded = LoadTypedAssetSync<CollisionLayerMatrixAsset>(this.m_assetManager.value(), assetRef.name(), "PhysicsSystem");
        if(!loaded.has_value())
            return false;
        this.m_collisionLayerMatrix = loaded.value().deref().matrix;
        return true;
    }

    public Filter makeLayerFilter(in u32 layerIdx, in i32 groupIndex)const{
        return this.m_collisionLayerMatrix.makeFilter(layerIdx, groupIndex);
    }

    public Filter makeLayerFilterByName(in Name layerName, in i32 groupIndex)const{
        return this.m_collisionLayerMatrix.makeFilterByName(layerName, groupIndex);
    }

    public b8 dispatchGpuBatchSpatialQueries(
        in Span<GpuPhysicsSpatialQuery> queries,
        mut Vector<GpuPhysicsSpatialQueryResult> outResults
    ){
        return this.m_gpuDispatcher.dispatchBatchSpatialQueries(this.m_physicsWorld, queries, outResults);
    }

    public b8 stepGpuResidentBodies(in f32 dt, in u32 subStepCount, in b8 readbackToWorld){
        const b8 ok = this.m_gpuDispatcher.stepGpuResidentBodies(this.m_physicsWorld, dt, subStepCount, readbackToWorld);
        if(ok){
            this.m_lastStepStats = this.m_physicsWorld.lastStepStats();
            this.m_lastStepTopologyVersion = this.m_physicsWorld.m_topologyVersion;
        }
        return ok;
    }

    public void reset(){
        this.m_physicsWorld.clear();
        this.m_collisionLayerMatrix = CollisionLayerMatrix();
        this.m_entityRecords.clear();
        this.m_entityJoints.clear();
        this.m_activeRagdolls.clear();
        this.m_environmentScratch = PhysicsEnvironment();
        this.m_bodyTransformSnapshots.clear();
        this.m_bodyTransformSnapshotMeta.clear();
        this.m_bodyIndexToEntity.clear();
        this.m_shapeIndexToEntity.clear();
        this.m_jointIndexToEntity.clear();
        this.m_namedEntities.clear();
        this.m_syncedRigidBodyTags.clear();
        this.m_syncedColliderTags.clear();
        this.m_syncScratch = EcsPhysicsSyncScratch();
        ReleaseEcsPhysicsAssetCache(this.m_assetCache, this.m_physicsWorld, false);
        this.m_exportBindingsScratch.clear();
        this.clearFrameEvents();
        this.m_accumulator = 0.0f;
        this.m_interpolationAlpha = 1.0f;
        this.m_lastStepStats = WorldStepStats();
        this.m_lastStepMs = 0.0;
        this.m_lastStepTopologyVersion = 0u;
    }

    public b8 exportRenderTransforms(mut Vector<GpuPhysicsRenderTransformOut> outTransforms){
        const b8 hasAnyPhysicsParents = this.m_world.view<PhysicsParentComponent>().candidateCount() > 0u;
        const b8 bodyHandlesTrusted = this.m_syncScratch.hasSyncedTopologyVersion && (this.m_physicsWorld.m_topologyVersion == this.m_syncScratch.lastSyncedTopologyVersion);
        CollectEcsGpuRenderTransformBindings(this.m_world, this.m_entityRecords, this.m_bodyIndexToEntity, hasAnyPhysicsParents, bodyHandlesTrusted, this.m_syncScratch.writeBackPoseCache, this.m_physicsWorld, this.m_exportBindingsScratch);
        return this.m_gpuDispatcher.exportRenderTransforms(
            this.m_physicsWorld,
            Span<GpuPhysicsRenderTransformBinding>(this.m_exportBindingsScratch.data(), this.m_exportBindingsScratch.size()),
            outTransforms
        );
    }

    public b8 exportRenderTransformsToBuffer(
        mut BufferHandle targetBuffer,
        in u32 targetUavSlot,
        in u32 instanceStrideFloat4
    ){
        const b8 hasAnyPhysicsParents = this.m_world.view<PhysicsParentComponent>().candidateCount() > 0u;
        const b8 bodyHandlesTrusted = this.m_syncScratch.hasSyncedTopologyVersion && (this.m_physicsWorld.m_topologyVersion == this.m_syncScratch.lastSyncedTopologyVersion);
        CollectEcsGpuRenderTransformBindings(this.m_world, this.m_entityRecords, this.m_bodyIndexToEntity, hasAnyPhysicsParents, bodyHandlesTrusted, this.m_syncScratch.writeBackPoseCache, this.m_physicsWorld, this.m_exportBindingsScratch);
        return this.m_gpuDispatcher.exportRenderTransformsToBuffer(
            this.m_physicsWorld,
            Span<GpuPhysicsRenderTransformBinding>(this.m_exportBindingsScratch.data(), this.m_exportBindingsScratch.size()),
            targetBuffer,
            targetUavSlot,
            instanceStrideFloat4
        );
    }

    public void setActiveSceneSubsystems(in ActiveSceneSubsystemsRef subsystems){
        this.m_gpuDispatcher.setActiveSceneSubsystems(subsystems);
    }

    public b8 validateResources(){
        const b8 ok = this.m_gpuDispatcher.validateResources();
        if(!ok)
            warning("PhysicsSystem: GPU physics pipelines unavailable; falling back to CPU solver");
        return ok;
    }

    public void invalidateResources(){
        this.m_gpuDispatcher.invalidateResources();
    }

    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta)override{
        ClearDestroyedSlotOwners(this.m_syncScratch);
        this.clearFrameEvents();

        f32 fixedDt = 1.0f / 60.0f;
        u32 subStepCount = 4u;
        u32 maxSubStepsPerFrame = 4u;
        b8 paused = false;
        b8 interpolateTransforms = false;
        ResolvePhysicsConfigSettings(
            world,
            this.m_physicsWorld,
            this.m_assetManager,
            this.m_collisionLayerMatrix,
            this.m_syncScratch,
            fixedDt,
            subStepCount,
            maxSubStepsPerFrame,
            paused,
            interpolateTransforms
        );

        b8 hasAnyPhysicsParents = false;
        b8 hasDrivenKinematic = false;
        SyncEcsEntitiesToPhysicsWorld(
            this.m_assetManager,
            this.m_assetCache,
            world,
            this.m_physicsWorld,
            this.m_entityRecords,
            this.m_entityJoints,
            this.m_bodyIndexToEntity,
            this.m_shapeIndexToEntity,
            this.m_jointIndexToEntity,
            this.m_namedEntities,
            this.m_syncedRigidBodyTags,
            this.m_syncedColliderTags,
            this.m_bodyTransformSnapshots,
            this.m_bodyTransformSnapshotMeta,
            this.m_syncScratch,
            hasAnyPhysicsParents,
            hasDrivenKinematic
        );
        PruneRemovedEcsRagdolls(
            world,
            this.m_physicsWorld,
            this.m_activeRagdolls,
            this.m_bodyIndexToEntity,
            this.m_shapeIndexToEntity,
            this.m_jointIndexToEntity,
            this.m_syncScratch.deadRagdolls
        );

        if(paused || !IsFinite(VectorSingle(delta)) || delta <= 0.0f){
            if(this.m_physicsWorld.m_topologyVersion != this.m_lastStepTopologyVersion){
                this.m_lastStepStats = WorldStepStats();
                this.m_lastStepMs = 0.0;
                this.m_lastStepTopologyVersion = this.m_physicsWorld.m_topologyVersion;
            }
            this.m_lastStepStats.bodyCount = this.m_physicsWorld.activeBodyCount();
            this.m_lastStepStats.awakeBodyCount = this.m_physicsWorld.awakeBodyCount();
            this.m_lastStepStats.shapeCount = this.m_physicsWorld.activeShapeCount();
            this.m_lastStepStats.contactCount = cast<u32>(this.m_physicsWorld.m_pairContactMap.size());
            this.m_lastStepStats.jointCount = this.m_physicsWorld.activeJointCount();
            u32 aliveIslands = 0u;
            for(usize ii = 0u; ii < this.m_physicsWorld.m_islands.size(); ++ii){
                if(this.m_physicsWorld.m_islands[ii].alive)
                    ++aliveIslands;
            }
            this.m_lastStepStats.islandCount = aliveIslands;
            this.m_physicsWorld.consumePendingEndEvents(this.m_frameContactEndEvents, this.m_frameSensorEndEvents);
            this.m_physicsWorld.consumePendingWakeEvents(this.m_frameBodyWakeEvents);
            return Expected<void, CpuTaskAdmissionError>();
        }

        const f32 clampedDelta = SimdMin(delta, fixedDt * cast<f32>(maxSubStepsPerFrame));
        this.m_accumulator += clampedDelta;

        u32 plannedSteps = 0u;
        f32 simAccum = this.m_accumulator;
        while(simAccum + 1.0e-6f >= fixedDt && plannedSteps < maxSubStepsPerFrame){
            if(simAccum >= fixedDt)
                simAccum -= fixedDt;
            else
                simAccum = 0.0f;
            ++plannedSteps;
        }

        const b8 useCollectedEnv = plannedSteps > 1u;
        if(useCollectedEnv){
            if(hasDrivenKinematic)
                SnapshotDrivenKinematicTargets(this.m_physicsWorld, this.m_syncScratch.drivenKinematicEntries, hasAnyPhysicsParents, world, this.m_syncScratch.writeBackPoseCache, this.m_syncScratch.kinematicTargets);
            CollectEcsPhysicsEnvironment(world, this.m_environmentScratch);
        }

        mut CpuTaskScheduler scheduler = world.taskScheduler();
        u32 stepsExecuted = 0u;
        while(this.m_accumulator + 1.0e-6f >= fixedDt && stepsExecuted < maxSubStepsPerFrame){
            if(this.m_accumulator >= fixedDt)
                this.m_accumulator -= fixedDt;
            else
                this.m_accumulator = 0.0f;

            if(stepsExecuted + 1u == plannedSteps)
                PreparePrevEcsBodyTransformSnapshots(this.m_physicsWorld, this.bodyMoveEvents(), this.m_syncScratch.dirtyPrevSnapshotBodyIndices, this.m_syncScratch.snapshotBodyStamps, this.m_syncScratch.snapshotStamp, this.m_bodyTransformSnapshots, this.m_bodyTransformSnapshotMeta);
            if(hasDrivenKinematic){
                if(plannedSteps <= 1u)
                    ApplyKinematicTargetsFromEcs(this.m_syncScratch.drivenKinematicEntries, fixedDt, hasAnyPhysicsParents, world, this.m_syncScratch.writeBackPoseCache, this.m_physicsWorld);
                else
                    ApplyInterpolatedKinematicTargets(this.m_syncScratch.kinematicTargets, stepsExecuted, plannedSteps, fixedDt, this.m_physicsWorld);
            }

            const b8 writeBackCharacters = ((stepsExecuted + 1u) == plannedSteps) && !interpolateTransforms;
            StepEcsPhysicsSubsystemBridges(
                world,
                this.m_physicsWorld,
                this.m_entityRecords,
                this.m_namedEntities,
                this.m_bodyIndexToEntity,
                this.m_shapeIndexToEntity,
                this.m_jointIndexToEntity,
                fixedDt,
                useCollectedEnv,
                writeBackCharacters,
                this.m_environmentScratch,
                this.m_activeRagdolls,
                this.m_syncScratch,
                scheduler
            );

            const Timer stepStart = TimerNow();
            StepWorldWithGpu(this.m_physicsWorld, this.m_gpuDispatcher, fixedDt, subStepCount, scheduler);
            this.m_lastStepMs = DurationInMS<f64>(TimerNow(), stepStart);

            if(plannedSteps == 1u)
                this.m_useDirectWorldEvents = true;
            else
                this.appendLastStepEvents();
            this.m_lastStepStats = this.m_physicsWorld.lastStepStats();
            this.m_lastStepTopologyVersion = this.m_physicsWorld.m_topologyVersion;
            ++stepsExecuted;
        }

        this.m_interpolationAlpha = SimdClamp(this.m_accumulator / fixedDt, 0.0f, 1.0f);

        if(stepsExecuted > 0u){
            if(stepsExecuted == 1u){
                WriteBackPhysicsTransformsToEcs(
                    this.m_physicsWorld,
                    this.bodyMoveEvents(),
                    this.m_bodyIndexToEntity,
                    hasAnyPhysicsParents,
                    true,
                    interpolateTransforms,
                    this.m_interpolationAlpha,
                    world,
                    this.m_syncScratch,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta
                );
            }
            else{
                CommitCurrEcsBodyTransformSnapshots(this.m_physicsWorld, this.m_syncScratch.dirtyPrevSnapshotBodyIndices, this.m_bodyTransformSnapshots, this.m_bodyTransformSnapshotMeta);
                WriteBackPhysicsTransformsToEcs(
                    this.m_physicsWorld,
                    this.bodyMoveEvents(),
                    this.m_bodyIndexToEntity,
                    hasAnyPhysicsParents,
                    false,
                    interpolateTransforms,
                    this.m_interpolationAlpha,
                    world,
                    this.m_syncScratch,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta
                );
            }
            WriteBackEcsRagdollRootPoses(world, this.m_physicsWorld);
            if(interpolateTransforms)
                ApplyInterpolatedCharacterTransformsToEcs(world, this.m_interpolationAlpha);
        }
        else{
            this.m_physicsWorld.consumePendingEndEvents(this.m_frameContactEndEvents, this.m_frameSensorEndEvents);
            this.m_physicsWorld.consumePendingWakeEvents(this.m_frameBodyWakeEvents);
            if(interpolateTransforms){
                ApplyInterpolatedRenderTransformsToEcs(
                    this.m_physicsWorld,
                    this.m_bodyIndexToEntity,
                    hasAnyPhysicsParents,
                    this.m_interpolationAlpha,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta,
                    world,
                    this.m_syncScratch
                );
                ApplyInterpolatedCharacterTransformsToEcs(world, this.m_interpolationAlpha);
            }
        }

        return Expected<void, CpuTaskAdmissionError>();
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

