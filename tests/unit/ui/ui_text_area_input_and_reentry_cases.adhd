    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    EXPECT_GT(self.m_model.selectionGeneration(), selection);
    EXPECT_EQ(self.m_model.revision(), revision);
    EXPECT_TRUE(self.m_model.canUndo());
}

void VerifyUiTextAreaInputScrollTests_UnfocusedThumbPressPreservesGrabOffsetAndTheBaselineAcrossRepaints(mut UiTextAreaInputScrollTests self){
    ASSERT_TRUE(self.prepareScroll(UiTextAreaScrollOptions(), Point(30.0f, 50.0f)));
    const UiTextAreaScrollModelRecord model = UiTextAreaScrollModelRecord(self.m_model);
    const auto foundThumb = self.tryTarget(self.part("scroll.y.thumb"));
    ASSERT_TRUE(foundThumb.has_value());
    const HitTarget thumb = foundThumb.value();
    const f32 travelValue = thumb.gestureReference.height - thumb.rectangle.height;
    ASSERT_GT(travelValue, 0.0f);
    const VectorSingle travel = VectorSingle(travelValue, travelValue, travelValue, travelValue);
    const VectorSingle originValue = VectorSingle(thumb.rectangle.width, thumb.rectangle.height, 0.0f, 0.0f) * VectorSingle(0.5f, 0.25f, 0.0f, 0.0f) + VectorSingle(thumb.rectangle.x, thumb.rectangle.y, 0.0f, 0.0f);
    const Point origin = Point(originValue.x, originValue.y);
    EXPECT_FALSE(self.m_context.input().focus().valid());
    ASSERT_TRUE(self.send(MakeUiTextAreaPointerEvent(origin, InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_EQ(self.m_context.input().capture(), thumb.id);
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiTextAreaWidgetKey, s_UiTextAreaPanelKey));
    ASSERT_TRUE(self.frameArea(2u, UiTextAreaScrollOptions()));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), 50.0, 0.001);
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().x), 30.0, 0.001);
    const auto foundAfterPress = self.tryTarget(self.part("scroll.y.thumb"));
    ASSERT_TRUE(foundAfterPress.has_value());
    const HitTarget afterPress = foundAfterPress.value();
    EXPECT_EQ(afterPress.control, thumb.control);
    // Lanes are the quarter and half drag steps.
    const VectorSingle dragY = travel * VectorSingle(0.25f, 0.5f, 0.0f, 0.0f) + VectorSingle(originValue.y, originValue.y, originValue.y, originValue.y);
    const VectorDouble expectedScroll = VectorDouble(thumb.gestureMaximum, thumb.gestureMaximum, thumb.gestureMaximum, thumb.gestureMaximum) * VectorDouble(0.25, 0.5, 0.0, 0.0) + VectorDouble(50.0, 50.0, 50.0, 50.0);
    const Point quarter = Point(origin.x, dragY.x);
    ASSERT_TRUE(self.send(MakeUiTextAreaPointerEvent(quarter, InputEventType::PointerMove)).pointerConsumed);
    ASSERT_TRUE(self.frameArea(3u, UiTextAreaScrollOptions()));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), expectedScroll.x, 0.001);
    const auto foundAfterMove = self.tryTarget(self.part("scroll.y.thumb"));
    ASSERT_TRUE(foundAfterMove.has_value());
    const HitTarget afterMove = foundAfterMove.value();
    EXPECT_EQ(afterMove.control, thumb.control);
    EXPECT_GT(afterMove.rectangle.y, thumb.rectangle.y);
    const Point half = Point(origin.x, dragY.y);
    ASSERT_TRUE(self.send(MakeUiTextAreaPointerEvent(half, InputEventType::PointerMove)).pointerConsumed);
    ASSERT_TRUE(self.send(MakeUiTextAreaPointerEvent(half, InputEventType::PrimaryUp)).pointerConsumed);
    ASSERT_TRUE(self.frameArea(4u, UiTextAreaScrollOptions()));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), expectedScroll.y, 0.001);
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 30.0f);
    EXPECT_FALSE(self.m_context.input().capture().valid());
    model.expect(self.m_model);
}

void VerifyUiTextAreaInputScrollTests_CompletedHorizontalThumbDragKeepsOutsideReleaseAndClampsItsEndpoint(mut UiTextAreaInputScrollTests self){
    ASSERT_TRUE(self.prepareScroll());
    const UiTextAreaScrollModelRecord model = UiTextAreaScrollModelRecord(self.m_model);
    const auto foundThumb = self.tryTarget(self.part("scroll.x.thumb"));
    ASSERT_TRUE(foundThumb.has_value());
    const HitTarget thumb = foundThumb.value();
    const VectorSingle originValue = VectorSingle(thumb.rectangle.width, thumb.rectangle.height, 0.0f, 0.0f) * VectorSingle(0.25f, 0.5f, 0.0f, 0.0f) + VectorSingle(thumb.rectangle.x, thumb.rectangle.y, 0.0f, 0.0f);
    const Point origin = Point(originValue.x, originValue.y);
    const Point outside = Point(900.0f, origin.y);
    ASSERT_TRUE(self.send(MakeUiTextAreaPointerEvent(origin, InputEventType::PrimaryDown)).pointerConsumed);
    ASSERT_TRUE(self.send(MakeUiTextAreaPointerEvent(outside, InputEventType::PointerMove)).pointerConsumed);
    ASSERT_TRUE(self.send(MakeUiTextAreaPointerEvent(Point(), InputEventType::PointerLeave)).pointerConsumed);
    ASSERT_TRUE(self.send(MakeUiTextAreaPointerEvent(outside, InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_FALSE(self.m_context.input().capture().valid());
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 0.0f);
    ASSERT_TRUE(self.frameArea(2u, UiTextAreaScrollOptions()));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().x), thumb.gestureMaximum, 0.001);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    model.expect(self.m_model);
}

void VerifyUiTextAreaInputScrollTests_TrackPagesOnlyOnReleaseByTheAcceptedViewport(mut UiTextAreaInputScrollTests self){
    ASSERT_TRUE(self.prepareScroll(UiTextAreaScrollOptions(), Point(0.0f, 100.0f)));
    const UiTextAreaScrollModelRecord model = UiTextAreaScrollModelRecord(self.m_model);
    const f64 page = self.m_state.scrollbars().vertical.viewportExtent;
    const auto foundAfter = self.tryTarget(self.part("scroll.y.after"));
    ASSERT_TRUE(foundAfter.has_value());
    const HitTarget after = foundAfter.value();
    const Point point = CenterUiRect(after.rectangle);
    ASSERT_TRUE(self.send(MakeUiTextAreaPointerEvent(point, InputEventType::PrimaryDown)).pointerConsumed);
    ASSERT_TRUE(self.frameArea(2u, UiTextAreaScrollOptions()));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), 100.0, 0.001);
    ASSERT_TRUE(self.send(MakeUiTextAreaPointerEvent(point, InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), 100.0, 0.001);
    ASSERT_TRUE(self.frameArea(3u, UiTextAreaScrollOptions()));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), 100.0 + page, 0.001);
    model.expect(self.m_model);
}

void VerifyUiTextAreaInputScrollTests_LaterCoalescedThumbUpdateRunsAfterAnInterveningWheelAction(mut UiTextAreaInputScrollTests self){
    ASSERT_TRUE(self.prepareScroll());
    const UiTextAreaScrollModelRecord model = UiTextAreaScrollModelRecord(self.m_model);
    const auto foundThumb = self.tryTarget(self.part("scroll.y.thumb"));
    ASSERT_TRUE(foundThumb.has_value());
    const HitTarget thumb = foundThumb.value();
    const Point origin = CenterUiRect(thumb.rectangle);
    const f32 travel = thumb.gestureReference.height - thumb.rectangle.height;
    ASSERT_GT(travel, 0.0f);
    ASSERT_TRUE(self.send(MakeUiTextAreaPointerEvent(origin, InputEventType::PrimaryDown)).pointerConsumed);
    ASSERT_TRUE(self.wheel(0.0, -1.0, origin));
    ASSERT_EQ(self.m_context.input().controlActions().size(), 1u);
    const Point quarter = Point(origin.x, travel * 0.25f + origin.y);
    ASSERT_TRUE(self.send(MakeUiTextAreaPointerEvent(quarter, InputEventType::PointerMove)).pointerConsumed);
    ASSERT_TRUE(self.send(MakeUiTextAreaPointerEvent(quarter, InputEventType::PrimaryUp)).pointerConsumed);
    ASSERT_TRUE(self.frameArea(2u, UiTextAreaScrollOptions()));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), thumb.gestureMaximum * 0.25, 0.001);
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 0.0f);
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
    model.expect(self.m_model);
}

void VerifyUiTextAreaInputScrollTests_PopupWheelUsesTheAcceptedPopupScopeAndDefersUntilItsEnd(mut UiTextAreaInputScrollTests self){
    ASSERT_TRUE(self.prepareDocument());
    PopupState popup = PopupState();
    popup.open();
    ASSERT_TRUE(self.framePopup(1u, popup));
    const WidgetId popupArea = self.id(s_UiTextAreaWidgetKey, s_UiTextAreaPopupKey);
    const auto foundHost = self.tryTarget(popupArea);
    ASSERT_TRUE(foundHost.has_value());
    const HitTarget host = foundHost.value();
    const PopupToken token = host.popup;
    ASSERT_TRUE(token.valid());
    const f64 step = host.scrollStep;
    const UiTextAreaScrollModelRecord model = UiTextAreaScrollModelRecord(self.m_model);
    ASSERT_TRUE(self.wheel(0.0, -1.0));
    ASSERT_EQ(self.m_context.input().controlActions().size(), 1u);
    EXPECT_EQ(self.m_context.input().controlActions()[0u].popup, token);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    ASSERT_TRUE(self.framePopup(2u, popup));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), step, 0.001);
    model.expect(self.m_model);
}


