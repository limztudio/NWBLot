[arena, asset("character_controller_component")]
class CharacterControllerComponentAsset : IComponent{
    public CharacterControllerComponent component;

    public b8 loadBinary(in Span<u8> binary)override;
    public b8 loadComponentPayload(in Span<u8> payload)override;
    public b8 validatePayload()const override;
    public void applyToEntity(mut Entity entity)const override{
        mut CharacterControllerComponent dst = entity.addComponent<CharacterControllerComponent>();
        dst = this.component;
        dst.dirty = true;
        dst.initialized = false;
        dst.def.ignoreBodyId = BodyId();
        dst.def.ignoreShapeId = ShapeId();
    }
    public b8 serializeComponentPayload(mut Vector<u8> outPayload)const override;
    public b8 appendValidatedComponentPayload(mut Vector<u8> outBinary)const override;
}

[arena, asset("vehicle_component")]
class VehicleComponentAsset : IComponent{
    public VehicleComponent component;

    public b8 loadBinary(in Span<u8> binary)override;
    public b8 loadComponentPayload(in Span<u8> payload)override;
    public b8 validatePayload()const override;
    public void applyToEntity(mut Entity entity)const override{
        mut VehicleComponent dst = entity.addComponent<VehicleComponent>();
        dst = this.component;
        dst.wheelEntities.clear();
        dst.skeletonEntity = s_InvalidEntityId;
        dst.dirty = true;
        dst.initialized = false;
    }
    public b8 serializeComponentPayload(mut Vector<u8> outPayload)const override;
    public b8 appendValidatedComponentPayload(mut Vector<u8> outBinary)const override;
}

[arena, asset("ragdoll_component")]
class RagdollComponentAsset : IComponent{
    public RagdollComponent component;

    public b8 loadBinary(in Span<u8> binary)override;
    public b8 loadComponentPayload(in Span<u8> payload)override;
    public b8 validatePayload()const override;
    public void applyToEntity(mut Entity entity)const override{
        mut RagdollComponent dst = entity.addComponent<RagdollComponent>();
        dst = this.component;
        dst.boneEntities.clear();
        dst.skeletonEntity = s_InvalidEntityId;
        dst.dirty = true;
        dst.initialized = false;
        dst.instance.reset();
    }
    public b8 serializeComponentPayload(mut Vector<u8> outPayload)const override;
    public b8 appendValidatedComponentPayload(mut Vector<u8> outBinary)const override;
}

