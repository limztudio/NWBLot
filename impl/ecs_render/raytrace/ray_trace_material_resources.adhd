#include <impl/ecs_render/raytrace/renderer_raytracing_state.adhd>
#include <impl/ecs_render/shadow/rt_shadow_state.adhd>
#include <impl/global.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[modular]
class RayTraceMaterialResources : NoCopy{
    private mut GraphicsRuntime m_graphics;
    private mut RtSceneBvhState m_scene;
    private mut RtShadowState m_shadow;

    public RayTraceMaterialResources(mut GraphicsRuntime graphics, mut RtSceneBvhState scene, mut RtShadowState shadow){
        this.m_graphics = graphics;
        this.m_scene = scene;
        this.m_shadow = shadow;
    }

    public void releaseRayTraceMaterialContextHeapHandles();
    public b8 ensureRayTraceMaterialContextSlotsBuffer();
    public b8 ensureRayTraceMaterialContextSlotsHeapHandle();
    public b8 ensureRayTraceMaterialContextHeapHandle(mut Buffer buffer, mut GpuDescriptorHandle handle);
    public b8 replaceRayTraceMaterialContextHeapHandle(mut Buffer buffer, mut GpuDescriptorHandle handle);
    public b8 ensureShadowInstanceMaterialBuffer(in usize instanceCount);
    public b8 ensureShadowInstanceContextBuffer(in usize instanceCount);
    public b8 ensureShadowMaterialTypedBuffer(in usize byteCount);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

