[cpp_header("<tests/unit/metascript/compiler_access.h>"), cpp_name("::NWB::Core::Metascript::IIncludeResolver"), cpp_flags(no_copy, no_assign, polymorphic_base, abstract)]
extern class CompilerIncludeResolver{
    b8 resolveInclude(in StringView path, in b8 system, mut CompilerStorage storage, mut MString key, mut MString source);
    StringView resolveIncludeNamespace(in StringView key)const;
    void popIncludeScope();
};

type MStringView = StringView;

