#include <impl/ecs_render/module.adhd.h>

namespace NWB::Tests::Smoke{
using Impl::RefractionStatistics;

[[nodiscard]] FOUNDATION_INLINE AStringView RefractionSmokeProjectName()noexcept{
    return "RefractionSmokeProject";
}

FOUNDATION_INLINE void LogRefractionQueryDiagnosticsCounters(
    const Impl::RefractionStatistics& statistics,
    const u64 currentFrame,
    const u64 targetStart
){
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("RefractionQueryDiagnostics: sequence={} generation={} graphics_frame={} observed_frame={} target_start_frame={} completed_target_frames={} frame_index={} width={} height={}")
        FOUNDATION_TEXT(" hardware_requested={} hardware_available={} hardware_ready={} csg_enabled={} token_valid={} physical_valid={} token_queue={} token_value={} physical_queue={} device_generation={}")
        , statistics.sequence
        , statistics.generation
        , statistics.graphicsFrameIndex
        , currentFrame
        , targetStart
        , statistics.graphicsFrameIndex - targetStart
        , statistics.frameIndex
        , statistics.width
        , statistics.height
        , statistics.hardwareRequested ? 1u : 0u
        , statistics.hardwareAvailable ? 1u : 0u
        , statistics.hardwareReady ? 1u : 0u
        , statistics.csgHardwareEnabled ? 1u : 0u
        , statistics.acceptedToken.valid() ? 1u : 0u
        , statistics.acceptedToken.hasPhysicalQueueIdentity() ? 1u : 0u
        , static_cast<u32>(statistics.acceptedToken.queue)
        , statistics.acceptedToken.value
        , statistics.acceptedToken.physicalQueueIndex
        , statistics.acceptedToken.deviceGeneration
    );
#define NWB_SMOKE_REFRACTION_LOG_COUNTER(name, offset) \
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("RefractionQueryCounter: sequence={} generation={} name={} value={}"), statistics.sequence, statistics.generation, FOUNDATION_TEXT(#name), statistics.name);
    NWB_REFRACTION_DIAGNOSTIC_COUNTER_FIELDS(NWB_SMOKE_REFRACTION_LOG_COUNTER)
#undef NWB_SMOKE_REFRACTION_LOG_COUNTER
#define NWB_SMOKE_REFRACTION_COUNT_COUNTER(name, offset) + 1u
    constexpr u32 s_CounterCount = 0u NWB_REFRACTION_DIAGNOSTIC_COUNTER_FIELDS(NWB_SMOKE_REFRACTION_COUNT_COUNTER);
#undef NWB_SMOKE_REFRACTION_COUNT_COUNTER
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("RefractionQueryDiagnostics: complete sequence={} generation={} counters={}"), statistics.sequence, statistics.generation, s_CounterCount);
}
};


