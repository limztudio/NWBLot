type GpuCrashMarkerTestArena = HeapStorage;
type DefaultResourceTestArena = HeapStorage;
type SetupUploadScheduling = GpuTaskSchedulingHint;
type DescriptorBufferSegmentKindEnum = DescriptorBufferSegmentKind;

[ordered]
class DescriptorBufferAllocationHarness{
    public HeapStorage arena;
    public DescriptorBufferAllocationState state = DescriptorBufferAllocationState(this.arena);
    public Array<u8, 64> bytes;
    public Expected<DescriptorBufferSegment> allocate(in DescriptorBufferSegmentKind kind, in u32 size, in u32 alignment, in u32 generation){
        return this.state.allocate(kind, size, alignment, generation, cast<u32>(this.bytes.size()), this.bytes.data());
    }
    public void free(in DescriptorBufferSegment segment, in u32 generation){ this.state.free(segment, generation, cast<u32>(this.bytes.size())); }
    public b8 isLive(in DescriptorBufferSegment segment, in DescriptorBufferSegmentKind kind, in u32 generation)const{
        return this.state.isLive(segment, kind, generation, cast<u32>(this.bytes.size()));
    }
}

class BlasOpacityMicromapAttachmentCheck{
    public b8 absentGeometrySkipped = false;
    public b8 emptyUsageGeometryBound = false;
    public b8 emptyUsagePointerNull = false;
    public b8 populatedGeometryBound = false;
    public b8 populatedUsagePointerMatches = false;
}

BlasOpacityMicromapAttachmentCheck RunBlasOpacityMicromapAttachmentCheck(){
    ScratchStorage arena(s_TestArena);
    Array<RayTracingGeometryDesc, 3> geometries;
    SetGeometryUsageCount(geometries[2u], 2u);
    ScratchStorageVector<usize> offsets(arena);
    offsets.resize(3u);
    offsets[0u] = usize.max;
    offsets[1u] = 0u;
    offsets[2u] = 0u;
    ScratchStorageVector<VkMicromapUsage> usages(arena);
    usages.resize(2u);
    ScratchStorageVector<VkOpacityMicromap> micromaps(arena);
    micromaps.resize(3u);
    BlasGeometryScratch scratch(arena);
    scratch.resizeForSizeQuery(3u);
    AttachMicromaps(geometries, offsets, usages, micromaps, scratch);
    BlasOpacityMicromapAttachmentCheck check;
    check.absentGeometrySkipped = GeometryChainAddress(scratch, 0u) == 0u;
    check.emptyUsageGeometryBound = GeometryChainAddress(scratch, 1u) == TestValueAddress<VkOpacityMicromap>(micromaps[1u]);
    check.emptyUsagePointerNull = MicromapUsagesAddress(micromaps[1u]) == 0u;
    check.populatedGeometryBound = GeometryChainAddress(scratch, 2u) == TestValueAddress<VkOpacityMicromap>(micromaps[2u]);
    check.populatedUsagePointerMatches = MicromapUsagesAddress(micromaps[2u]) == TestDataAddress(usages);
    return check;
}

class EmbeddedNullMarkerHashes{
    public usize outerHash = 0u;
    public usize nestedHash = 0u;
}

EmbeddedNullMarkerHashes PushTruncatedAndEmbeddedNullMarkers(mut GpuCrashMarkerTracker tracker){
    Array<u8, 6> label(79u, 117u, 116u, 101u, 114u, 88u);
    EmbeddedNullMarkerHashes hashes;
    hashes.outerHash = tracker.pushEvent(BytePrefixText(label, 5u));
    label[0u] = 120u;
    const Array<u8, 3> nested(73u, 0u, 110u);
    hashes.nestedHash = tracker.pushEvent(BytePrefixText(nested, nested.size()));
    return hashes;
}

b8 MatchesEmbeddedNullNestedMarker(in StringView actual){
    const Array<u8, 9> expected(79u, 117u, 116u, 101u, 114u, 47u, 73u, 0u, 110u);
    return actual == BytePrefixText(expected, expected.size());
}

b8 IsConcurrentTextureImageConsistent(in TextureDesc desc, in VkImageCreateInfo imageInfo, in Span<u32> families, in VkImageCreateFlags extraFlags){
    VkImageCreateInfo copy = imageInfo;
    SetImageQueueFamilies(copy, families);
    copy.flags |= extraFlags;
    return IsTextureImageInfoConsistent(desc, copy);
}

void InsertCrashMarkers(mut GpuCrashTracker tracker, mut HeapStorage arena, in Span<StringView> names,
    mut TestLatch start, mut TestLatch midpoint, mut TestAtomic<b8> invalid, mut TestAtomic<u32> writers){
    {
        GpuCrashMarkerTracker local(tracker, arena);
        start.arrive_and_wait();
        for(usize i = 0u; i < names.size(); ++i){
            if(i == names.size() / 2u)
                midpoint.arrive_and_wait();
            local.resetEventStack();
            const usize hash = local.pushEvent(names[i]);
            const ResolvedMarker inserted = tracker.resolveMarker(hash);
            if(!inserted.first() || inserted.second() != names[i])
                invalid.store(true, MemoryOrder::release);
        }
    }
    const u32 previous = writers.fetch_sub(1u, MemoryOrder::acq_rel);
    if(previous == 0u || previous > 2u)
        invalid.store(true, MemoryOrder::release);
}

b8 RunConcurrentCrashMarkerGrowthCheck(mut GpuCrashTracker tracker, mut HeapStorage arena, in usize hash, in ResolvedMarker retained, in StringView label){
    const Array<StringView, 16> firstNames(
        "Concurrent writer A marker 00", "Concurrent writer A marker 01",
        "Concurrent writer A marker 02", "Concurrent writer A marker 03",
        "Concurrent writer A marker 04", "Concurrent writer A marker 05",
        "Concurrent writer A marker 06", "Concurrent writer A marker 07",
        "Concurrent writer A marker 08", "Concurrent writer A marker 09",
        "Concurrent writer A marker 10", "Concurrent writer A marker 11",
        "Concurrent writer A marker 12", "Concurrent writer A marker 13",
        "Concurrent writer A marker 14", "Concurrent writer A marker 15");
    const Array<StringView, 16> secondNames(
        "Concurrent writer B marker 00", "Concurrent writer B marker 01",
        "Concurrent writer B marker 02", "Concurrent writer B marker 03",
        "Concurrent writer B marker 04", "Concurrent writer B marker 05",
        "Concurrent writer B marker 06", "Concurrent writer B marker 07",
        "Concurrent writer B marker 08", "Concurrent writer B marker 09",
        "Concurrent writer B marker 10", "Concurrent writer B marker 11",
        "Concurrent writer B marker 12", "Concurrent writer B marker 13",
        "Concurrent writer B marker 14", "Concurrent writer B marker 15");
    TestLatch start(3u);
    TestLatch midpoint(3u);
    TestAtomic<u32> writers(2u);
    TestAtomic<b8> invalid(false);
    TestThread first(lambda[mut tracker, mut arena, in firstNames, mut start, mut midpoint, mut invalid, mut writers]() -> void{
        InsertCrashMarkers(tracker, arena, firstNames, start, midpoint, invalid, writers);
    });
    TestThread second(lambda[mut tracker, mut arena, in secondNames, mut start, mut midpoint, mut invalid, mut writers]() -> void{
        InsertCrashMarkers(tracker, arena, secondNames, start, midpoint, invalid, writers);
    });
    start.arrive_and_wait();
    auto valid = lambda[mut tracker, in hash, in retained, in label]() -> b8{
        const ResolvedMarker marker = tracker.resolveMarker(hash);
        return retained.second() == label && marker.first() && marker.second() == label;
    };
    if(!valid())
        invalid.store(true, MemoryOrder::release);
    midpoint.arrive_and_wait();
    do{
        if(!valid())
            invalid.store(true, MemoryOrder::release);
        YieldThread();
    }while(writers.load(MemoryOrder::acquire) != 0u);
    first.join();
    second.join();
    return invalid.load(MemoryOrder::acquire);
}

