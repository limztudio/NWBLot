UiPopupSmokeScene::UiPopupSmokeScene(mut GlobalArena arena){
    this.m_popupText = EditModel(arena);
    this.m_outsideText = EditModel(arena);
    const b8 initialized = this.m_popupText.setText("Popup") && this.m_outsideText.setText("Outside focus sentinel");
    [essential] assert(initialized, "Popup smoke text models must contain valid UTF8");
}

b8 UiPopupSmokeScene::paint(mut UiPaintContext context){
    ObserveSmokeDisplay(s_UiPopupSmokeTag, context.display, this.m_lastDisplay, this.m_displayChanged);
    context.ui.style().fontSize = 12.0f;
    context.ui.style().gap = 8.0f;
    if(!context.ui.beginPanel("popup_fixture", Rect(24.0f, 24.0f, 320.0f, 216.0f)))
        return false;
    const WidgetOptions title = MakeFixedHeightSmokeWidget(24.0f);
    if(!context.ui.label("title", "Popup focus and overlay fixture", title))
        return false;
    ContainerOptions row();
    row.height.policy = LayoutSizePolicy::Fixed;
    row.height.value = 40.0f;
    row.gap = 8.0f;
    if(!context.ui.beginRow("triggers", row))
        return false;
    const WidgetOptions trigger = MakeFixedSmokeWidget(120.0f, 36.0f);
    if(context.ui.button("open", "Open popup", trigger)){
        this.m_modal = false;
        this.m_popup.open();
    }
    if(context.ui.button(s_UiPopupSmokeModalKey, "Open modal", trigger)){
        this.m_modal = true;
        this.m_popup.open();
    }
    if(!context.ui.endContainer())
        return false;
    const WidgetOptions counter = MakeFixedSmokeWidget(130.0f, 36.0f);
    if(context.ui.button("underlying", "Underlying", counter))
        ++this.m_underlying;
    EditBoxOptions edit();
    edit.width.policy = LayoutSizePolicy::Fixed;
    edit.width.value = 260.0f;
    edit.height.policy = LayoutSizePolicy::Fixed;
    edit.height.value = 32.0f;
    const EditBoxResult outside = context.ui.editBox(s_UiPopupSmokeOutsideKey, this.m_outsideText, this.m_outsideEdit, edit);
    this.m_outsideFocused = outside.focused;
    if(!outside.valid || !context.ui.endPanel())
        return false;

    PopupOptions options();
    options.anchor = Rect(200.0f, 64.0f, 120.0f, 36.0f);
    options.size = MakeSmokePoint(220.0f, 236.0f);
    options.modal = this.m_modal;
    options.dismissOutside = !this.m_modal;
    if(this.m_edge)
        options.anchor = StoreRect(VectorSingle(context.display.logicalWidth, context.display.logicalHeight, 48.0f, 24.0f) - VectorSingle(60.0f, 48.0f, 0.0f, 0.0f));
    if(this.m_right)
        options.side = PopupPlacementSide::Right;
    else
        options.side = PopupPlacementSide::Below;
    this.m_popupFocused = false;
    if(this.m_visible && context.ui.beginPopup(s_UiPopupSmokePopupKey, this.m_popup, options)){
        const WidgetOptions caption = MakeFixedHeightSmokeWidget(20.0f);
        const WidgetOptions choice = MakeStretchWidthSmokeWidget(32.0f);
        if(!context.ui.label("caption", "Choose, edit, or dismiss", caption))
            return false;
        if(context.ui.button(s_UiPopupSmokeFirstKey, "First choice", choice)){
            this.m_selected = 1u;
            this.m_popup.close();
        }
        if(context.ui.button(s_UiPopupSmokeSecondKey, "Second choice", choice)){
            this.m_selected = 2u;
            this.m_popup.close();
        }
        if(context.ui.checkbox("checked", "Popup checkbox", this.m_checked, choice))
            [essential] info("UiPopupSmoke: checked={}", cast<u32>(this.m_checked));
        EditBoxOptions popupEditOptions();
        popupEditOptions.height.policy = LayoutSizePolicy::Fixed;
        popupEditOptions.height.value = 32.0f;
        const EditBoxResult popupEdit = context.ui.editBox("text", this.m_popupText, this.m_popupEdit, popupEditOptions);
        this.m_popupFocused = popupEdit.focused;
        if(!popupEdit.valid || !context.ui.endPopup())
            return false;
    }
    this.observeState();
    const Array<u32, 12u> markerValues = this.values();
    PaintSingleSmokeValueMarkers(markerValues, this.m_sequence, context);
    return true;
}

b8 UiPopupSmokeScene::paintLaterRoot(mut UiPaintContext context)const{
    Rect bounds = this.m_popup.placement().bounds;
    if(bounds.width <= 0.0f)
        bounds = Rect(200.0f, 104.0f, 220.0f, 236.0f);
    const Rect outer = StoreRect(VectorSingle(bounds.x, bounds.y, bounds.width, bounds.height) + VectorSingle(-8.0f, -8.0f, 16.0f, 16.0f));
    if(!context.ui.beginPanel("later_root", outer))
        return false;
    if(!context.ui.endPanel())
        return false;
    context.paint.fillRect(bounds, Color(0.72f, 0.02f, 0.04f, 1.0f));
    context.paint.fillRect(Rect(context.display.logicalWidth - 40.0f, 24.0f, 16.0f, 16.0f), Color(0.12f, 0.52f, 0.86f, 1.0f));
    return true;
}

b8 UiPopupSmokeScene::keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods){
    if(key != s_SmokeKeyF5 && key != s_SmokeKeyF6 && key != s_SmokeKeyF7)
        return false;
    if(action == s_SmokeActionPress){
        if(key == s_SmokeKeyF5){
            this.m_edge = !this.m_edge;
        }
        else if(key == s_SmokeKeyF6){
            this.m_right = !this.m_right;
        }
        else{
            this.m_visible = !this.m_visible;
            if(this.m_visible)
                this.m_popup.close();
        }
    }
    return true;
}

Array<u32, 12u> UiPopupSmokeScene::values()const{
    Array<u32, 12u> out;
    out[0u] = cast<u32>(this.m_visible && this.m_popup.isOpen());
    out[1u] = cast<u32>(this.m_modal);
    out[2u] = this.m_underlying;
    out[3u] = this.m_selected;
    out[4u] = cast<u32>(this.m_checked);
    out[5u] = cast<u32>(this.m_popupFocused);
    out[6u] = cast<u32>(this.m_outsideFocused);
    out[7u] = cast<u32>(this.m_edge);
    out[8u] = cast<u32>(this.m_right);
    out[9u] = cast<u32>(this.m_visible);
    out[10u] = cast<u32>(this.m_popupText.text().size());
    out[11u] = cast<u32>(this.m_popup.placement().side);
    return out;
}

void UiPopupSmokeScene::observeState(){
    const Array<u32, 12u> current = this.values();
    const PopupPlacement placement = this.m_popup.placement();
    if(
        this.m_sequence != 0u
        && !this.m_displayChanged
        && SameSmokeU32Span(current, this.m_lastValues)
        && SameSmokeRect(placement.bounds, this.m_lastPlacement.bounds)
        && SameSmokeRect(placement.viewport, this.m_lastPlacement.viewport)
    )
        return;
    ++this.m_sequence;
    this.m_lastValues = current;
    this.m_lastPlacement = placement;
    this.m_displayChanged = false;
    [essential] info(
        "UiPopupSmoke: state sequence={} values={},{},{},{},{},{},{},{},{},{},{},{}"
        , this.m_sequence
        , current[0u]
        , current[1u]
        , current[2u]
        , current[3u]
        , current[4u]
        , current[5u]
        , current[6u]
        , current[7u]
        , current[8u]
        , current[9u]
        , current[10u]
        , current[11u]
    );
    LogSmokeRect(s_UiPopupSmokeTag, this.m_sequence, s_UiPopupSmokePopupKey, placement.bounds);
    LogSmokeRect(s_UiPopupSmokeTag, this.m_sequence, "viewport", placement.viewport);
    LogSmokeRect(s_UiPopupSmokeTag, this.m_sequence, "trigger", Rect(32.0f, 64.0f, 120.0f, 36.0f));
    LogSmokeRect(s_UiPopupSmokeTag, this.m_sequence, s_UiPopupSmokeModalKey, Rect(160.0f, 64.0f, 120.0f, 36.0f));
    LogSmokeRect(s_UiPopupSmokeTag, this.m_sequence, "counter", Rect(32.0f, 112.0f, 130.0f, 36.0f));
    LogSmokeRect(s_UiPopupSmokeTag, this.m_sequence, s_UiPopupSmokeOutsideKey, this.m_outsideEdit.placement.bounds);
    const Rect first = StoreRect(VectorSingle(placement.bounds.x, placement.bounds.y, placement.bounds.width, 0.0f) + VectorSingle(8.0f, 36.0f, -16.0f, 32.0f));
    LogSmokeRect(s_UiPopupSmokeTag, this.m_sequence, s_UiPopupSmokeFirstKey, first);
    LogSmokeRect(s_UiPopupSmokeTag, this.m_sequence, s_UiPopupSmokeSecondKey, Rect(first.x, first.y + 40.0f, first.width, first.height));
    LogSmokeRect(s_UiPopupSmokeTag, this.m_sequence, "check", Rect(first.x, first.y + 80.0f, first.width, first.height));
    LogSmokeRect(s_UiPopupSmokeTag, this.m_sequence, "edit", this.m_popupEdit.placement.bounds);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


UiPopupToolsSmokeScene::UiPopupToolsSmokeScene(mut GlobalArena arena){
    this.m_sentinel = EditModel(arena);
    const b8 initialized = this.m_sentinel.setText("Sentinel");
    [essential] assert(initialized, "UI popup tools smoke sentinel must initialize");
}

b8 UiPopupToolsSmokeScene::paint(mut UiPaintContext context){
    ObserveSmokeDisplay(s_UiPopupToolsSmokeTag, context.display, this.m_lastDisplay, this.m_displayChanged);
    this.m_source.beginFrame();
    this.m_sentinelFocused = false;
    context.ui.style().fontSize = 12.0f;
    context.ui.style().gap = 8.0f;
    if(!context.ui.beginPanel("popup_tools_fixture", Rect(24.0f, 24.0f, 400.0f, 200.0f)))
        return false;
    const WidgetOptions caption = MakeFixedHeightSmokeWidget(24.0f);
    if(!context.ui.label("title", "Delayed tooltip and five context commands", caption))
        return false;
    const WidgetOptions anchor = MakeFixedEnabledSmokeWidget(220.0f, 36.0f, this.m_enabled);
    if(context.ui.button(s_UiPopupToolsAnchorKey, "Right-click / Menu / Shift+F10", anchor))
        ++this.m_anchorClicks;
    TooltipOptions tooltip();
    tooltip.delaySeconds = 8.0f;
    if(!context.ui.tooltip("hint", s_UiPopupToolsAnchorKey, "Open commands here; Delete is disabled.", this.m_tooltip, tooltip))
        return false;
    ContextMenuOptions menu();
    menu.size = MakeSmokePoint(220.0f, 180.0f);
    const ContextMenuResult result = context.ui.contextMenu("commands", s_UiPopupToolsAnchorKey, this.m_source, this.m_menu, menu);
    if(!result.valid)
        return false;
    if(result.activated){
        this.m_command = result.key;
        ++this.m_commits;
    }
    if(!context.ui.label("keys", "F5 reorder / F6 replace source / F9 disabled", caption))
        return false;
    EditBoxOptions edit();
    edit.width.policy = LayoutSizePolicy::Fixed;
    edit.width.value = 260.0f;
    edit.height.policy = LayoutSizePolicy::Fixed;
    edit.height.value = 36.0f;
    const EditBoxResult sentinel = context.ui.editBox(s_UiPopupToolsSentinelKey, this.m_sentinel, this.m_sentinelState, edit);
    this.m_sentinelFocused = sentinel.focused;
    if(!sentinel.valid || !context.ui.endPanel())
        return false;
    if(!context.ui.beginPanel("outside_fixture", Rect(448.0f, 24.0f, 146.0f, 52.0f)))
        return false;
    const WidgetOptions counter = MakeFixedSmokeWidget(130.0f, 36.0f);
    if(context.ui.button("underlying", "Outside counter", counter))
        ++this.m_underlying;
    if(!context.ui.endPanel())
        return false;
    this.observeState();
    const Array<u64, 15u> markerValues = this.values();
    PaintKeyedSmokeValueMarkersDefault(markerValues, cast<u64>(this.m_sequence), 16u, 12u, context);
    return true;
}

b8 UiPopupToolsSmokeScene::keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods){
    if(key != s_SmokeKeyF5 && key != s_SmokeKeyF6 && key != s_SmokeKeyF9)
        return false;
    if(action == s_SmokeActionPress){
        if(key == s_SmokeKeyF5)
            this.m_source.reverse();
        else if(key == s_SmokeKeyF6)
            this.m_source.replace();
        else
            this.m_enabled = !this.m_enabled;
    }
    return true;
}

Array<u64, 15u> UiPopupToolsSmokeScene::values()const{
    Array<u64, 15u> out;
    out[0u] = cast<u64>(this.m_tooltip.visible());
    out[1u] = cast<u64>(this.m_menu.isOpen());
    out[2u] = this.m_menu.cursorKey();
    out[3u] = this.m_command;
    out[4u] = cast<u64>(this.m_commits);
    out[5u] = cast<u64>(this.m_anchorClicks);
    out[6u] = cast<u64>(this.m_underlying);
    out[7u] = cast<u64>(this.m_sentinelFocused);
    out[8u] = cast<u64>(this.m_enabled);
    out[9u] = cast<u64>(this.m_source.reversed());
    out[10u] = this.m_source.revision();
    out[11u] = this.m_source.instanceGeneration();
    out[12u] = cast<u64>(this.m_source.labelReads());
    out[13u] = cast<u64>(this.m_sentinel.text().size());
    out[14u] = this.m_menu.listState().selectedKey();
    return out;
}

Rect UiPopupToolsSmokeScene::rowBounds(in u64 key)const{
    const ScrollPlacement placement = this.m_menu.listState().placement();
    if(!this.m_menu.isOpen())
        return Rect();
    const Expected<u64> index = this.m_source.indexOf(key);
    if(!index.has_value() || index.value() < placement.firstRow || index.value() >= placement.endRow)
        return Rect();
    return VisibleSmokeListRow(placement, index.value());
}

void UiPopupToolsSmokeScene::observeState(){
    const Array<u64, 15u> current = this.values();
    const PopupPlacement menu = this.m_menu.placement();
    const PopupPlacement tooltip = this.m_tooltip.placement();
    const Rect sentinel = this.m_sentinelState.placement.bounds;
    const ScrollPlacement list = this.m_menu.listState().placement();
    if(
        this.m_sequence != 0u
        && !this.m_displayChanged
        && SameSmokeU64Span(current, this.m_lastValues)
        && list.offset == this.m_lastList.offset
        && list.contentHeight == this.m_lastList.contentHeight
        && SameSmokeRect(list.viewport, this.m_lastList.viewport)
        && SameSmokeRect(menu.bounds, this.m_lastMenu.bounds)
        && SameSmokeRect(tooltip.bounds, this.m_lastTooltip.bounds)
        && SameSmokeRect(sentinel, this.m_lastSentinel)
    )
        return;
    ++this.m_sequence;
    this.m_lastValues = current;
    this.m_lastMenu = menu;
    this.m_lastList = list;
    this.m_lastTooltip = tooltip;
    this.m_lastSentinel = sentinel;
    this.m_displayChanged = false;
    [essential] info(
        "UiPopupToolsSmoke: state sequence={} values={},{},{},{},{},{},{},{},{},{},{},{},{},{},{}"
        , this.m_sequence
        , current[0u]
        , current[1u]
        , current[2u]
        , current[3u]
        , current[4u]
        , current[5u]
        , current[6u]
        , current[7u]
        , current[8u]
        , current[9u]
        , current[10u]
        , current[11u]
        , current[12u]
        , current[13u]
        , current[14u]
    );
    LogSmokeRect(s_UiPopupToolsSmokeTag, this.m_sequence, s_UiPopupToolsAnchorKey, Rect(32.0f, 64.0f, 220.0f, 36.0f));
    LogSmokeRect(s_UiPopupToolsSmokeTag, this.m_sequence, "menu", menu.bounds);
    LogSmokeRect(s_UiPopupToolsSmokeTag, this.m_sequence, "tooltip", tooltip.bounds);
    LogSmokeRect(s_UiPopupToolsSmokeTag, this.m_sequence, "list", list.bounds);
    LogSmokeRect(s_UiPopupToolsSmokeTag, this.m_sequence, "viewport", list.viewport);
    LogSmokeRect(s_UiPopupToolsSmokeTag, this.m_sequence, "first", this.rowBounds(1u));
    LogSmokeRect(s_UiPopupToolsSmokeTag, this.m_sequence, "second", this.rowBounds(2u));
    LogSmokeRect(s_UiPopupToolsSmokeTag, this.m_sequence, "disabled", this.rowBounds(3u));
    LogSmokeRect(s_UiPopupToolsSmokeTag, this.m_sequence, "last", this.rowBounds(5u));
    LogSmokeRect(s_UiPopupToolsSmokeTag, this.m_sequence, "cursor_row", this.rowBounds(this.m_menu.cursorKey()));
    LogSmokeRect(s_UiPopupToolsSmokeTag, this.m_sequence, s_UiPopupToolsSentinelKey, sentinel);
    LogSmokeRect(s_UiPopupToolsSmokeTag, this.m_sequence, "counter", Rect(456.0f, 32.0f, 130.0f, 36.0f));
}


