#include <impl/assets_shader/cook_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SlangCompilerValidatedInputs{
    public StringView stage = "";
    public StringView optimization = "";
}

class SlangCompilerArgumentCounts{
    public usize argumentReserve = 0u;
    public usize ownedArgumentCount = 0u;
}

class SlangCompilerRequestValidator{
    private Expected<StringView> mapStage(in StringView stage, in Span<SlangStageMapping> mappings)const{
        for(in SlangStageMapping mapping : mappings){
            if(stage == mapping.stage)
                return mapping.slangStage;
        }
        return MakeUnexpected(Failure());
    }

    public Expected<SlangCompilerValidatedInputs> validateInputs(
        in StringView shaderName,
        in b8 sourcePathEmpty,
        in b8 outputPathEmpty,
        in StringView entryPoint,
        in StringView stage,
        in u8 optimizationLevelValue,
        in Span<SlangStageMapping> stageMappings
    )const{
        if(sourcePathEmpty){
            error("Failed to compile shader '{}' : source path is empty", shaderName);
            return MakeUnexpected(Failure());
        }
        if(outputPathEmpty){
            error("Failed to compile shader '{}' : output path is empty", shaderName);
            return MakeUnexpected(Failure());
        }
        if(entryPoint.empty()){
            error("Failed to compile shader '{}' : entry point is empty", shaderName);
            return MakeUnexpected(Failure());
        }
        const Expected<StringView> slangStage = this.mapStage(stage, stageMappings);
        if(!slangStage.has_value()){
            error("Unknown shader stage '{}' in entry '{}'", stage, shaderName);
            return MakeUnexpected(Failure());
        }
        if(optimizationLevelValue >= cast<u8>(ShaderOptimizationLevel::kCount)){
            error("Shader '{}' uses an invalid optimization level {}", shaderName, cast<u32>(optimizationLevelValue));
            return MakeUnexpected(Failure());
        }
        SlangCompilerValidatedInputs result = SlangCompilerValidatedInputs();
        result.stage = slangStage.value();
        result.optimization = SlangOptimizationArgument(cast<ShaderOptimizationLevel>(optimizationLevelValue));
        return result;
    }

    public Expected<SlangCompilerArgumentCounts> argumentCounts(
        in StringView shaderName,
        in usize includeDirectoryCount,
        in usize defineCount
    )const{
        if(defineCount > usize.max - s_MaxFixedArgumentCount || includeDirectoryCount > (usize.max - s_MaxFixedArgumentCount - defineCount) / 2u){
            error("ShaderCook: compiler request for '{}' has too many arguments", shaderName);
            return MakeUnexpected(Failure());
        }
        SlangCompilerArgumentCounts result = SlangCompilerArgumentCounts();
        result.argumentReserve = s_MaxFixedArgumentCount + includeDirectoryCount * 2u + defineCount;
        result.ownedArgumentCount = s_SlangFixedOwnedArgumentCount + includeDirectoryCount + defineCount;
        return result;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

