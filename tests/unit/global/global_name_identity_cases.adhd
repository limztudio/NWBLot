NWB_ADHD_GTEST(Global, DerivedNamesReportInvalidInputsAndPreserveCanonicalBinaryIdentity, VerifyGlobal_DerivedNamesReportInvalidInputsAndPreserveCanonicalBinaryIdentity)
NWB_ADHD_GTEST(Global, ConstexprNameViewsPreserveBoundedIdentityAndSymbolCallbacks, VerifyGlobal_ConstexprNameViewsPreserveBoundedIdentityAndSymbolCallbacks)
NWB_ADHD_GTEST(Global, BinaryIdentityLanesDoNotRecordNameSymbols, VerifyGlobal_BinaryIdentityLanesDoNotRecordNameSymbols)
NWB_ADHD_GTEST(Global, NameBinaryIdentityNeverInvokesInstalledSymbolCallbacks, VerifyGlobal_NameBinaryIdentityNeverInvokesInstalledSymbolCallbacks)
NWB_ADHD_GTEST(Global, NameResolvedTextPreservesSymbolLookupAndHashFallback, VerifyGlobal_NameResolvedTextPreservesSymbolLookupAndHashFallback)
NWB_ADHD_GTEST(Global, DiagnosticNameTextNeverInvokesForeignSymbolCallbacks, VerifyGlobal_DiagnosticNameTextNeverInvokesForeignSymbolCallbacks)
NWB_ADHD_GTEST(Global, NameResolvedTextIsBoundedByStoredAndResolverBuffers, VerifyGlobal_NameResolvedTextIsBoundedByStoredAndResolverBuffers)
NWB_ADHD_GTEST(Global, NameHashTextDistinguishesNullEmptyAndEmbeddedNull, VerifyGlobal_NameHashTextDistinguishesNullEmptyAndEmbeddedNull)
NWB_ADHD_GTEST(Global, RuntimeNameTextAdmissionPreservesIdentityAndCallbackBoundaries, VerifyGlobal_RuntimeNameTextAdmissionPreservesIdentityAndCallbackBoundaries)
NWB_ADHD_GTEST(Global, OptionalNameTextPreservesAbsenceAndOwnedContainerErrors, VerifyGlobal_OptionalNameTextPreservesAbsenceAndOwnedContainerErrors)
NWB_ADHD_GTEST(Global, RuntimeNameFactoryPreservesRecursiveRecorderGuard, VerifyGlobal_RuntimeNameFactoryPreservesRecursiveRecorderGuard)
NWB_ADHD_GTEST(Global, NameHashDebugTextRejectsInvalidHex, VerifyGlobal_NameHashDebugTextRejectsInvalidHex)


