void VerifyGpuSubmission_TextureRectangleKeepsMipThenSliceRemainderOrder(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> textureResult = AddTextureMetadata(graph, s_GpuCaseTaskUseRectangle, "Texture Rectangle");
    ASSERT_TRUE(textureResult.has_value());
    const GpuGraphResourceId texture = textureResult.value();
    ASSERT_TRUE(texture.valid());
    Array<GpuTaskResourceUse, 2> uses = Array<GpuTaskResourceUse, 2>();
    uses[0u].resource = texture;
    uses[0u].range.textureSubresources = TextureSubresourceSet(1u, 1u, 1u, 1u);
    uses[1u].resource = texture;
    uses[1u].range.textureSubresources = TextureSubresourceSet(0u, 4u, 0u, 3u);
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    const GpuTaskGraphTaskView task = MakeGpuSubmissionTaskView(uses, declarations.generation(), 0u);
    const GpuTaskGraphResourceView resource = declarations.resourceAt(texture.index);
    GpuSubmissionUseIndexScope scope = GpuSubmissionUseIndexScope(declarations.resourceCount(), declarations.generation(), uses.size());
    ASSERT_TRUE(scope.index.build(task));
    scope.ranges.reserve(4u);
    ASSERT_TRUE(GpuSubmissionCollectFirstUseRanges(declarations, task, 1u, resource, uses[1u].range, scope));
    Array<TextureSubresourceSet, 4> expected = Array<TextureSubresourceSet, 4>();
    expected[0u] = TextureSubresourceSet(0u, 1u, 0u, 3u);
    expected[1u] = TextureSubresourceSet(2u, 2u, 0u, 3u);
    expected[2u] = TextureSubresourceSet(1u, 1u, 0u, 1u);
    expected[3u] = TextureSubresourceSet(1u, 1u, 2u, 1u);
    ASSERT_EQ(scope.ranges.size(), expected.size());
    for(usize index = 0u; index < expected.size(); ++index)
        EXPECT_EQ(scope.ranges[index].textureSubresources, expected[index]);
}

void VerifyGpuSubmission_CompiledResourceSetExpansionPreservesEveryInitialByteRange(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> aResult = AddBufferMetadata(graph, s_GpuCaseTaskUseExpandedA, "Expanded A", ResourceStates::Common);
    ASSERT_TRUE(aResult.has_value());
    const GpuGraphResourceId resA = aResult.value();
    const Expected<GpuGraphResourceId> bResult = AddBufferMetadata(graph, s_GpuCaseTaskUseExpandedB, "Expanded B", ResourceStates::Common);
    ASSERT_TRUE(bResult.has_value());
    const GpuGraphResourceId resB = bResult.value();
    ASSERT_TRUE(resA.valid());
    ASSERT_TRUE(resB.valid());

    Array<GpuGraphResourceId, 2> members = Array<GpuGraphResourceId, 2>();
    members[0u] = resA;
    members[1u] = resB;
    GpuGraphResourceSetDesc setDesc = GpuGraphResourceSetDesc();
    setDesc.setIdentity(s_GpuCaseTaskUseExpandedSet);
    setDesc.setMarkerLabel("Expanded Set");
    setDesc.setMembers(members);
    const Expected<GpuGraphResourceSetId> setResult = graph.importResourceSet(setDesc);
    ASSERT_TRUE(setResult.has_value());
    const GpuGraphResourceSetId set = setResult.value();
    ASSERT_TRUE(set.valid());

    Array<GpuTaskResourceUse, 2> direct = Array<GpuTaskResourceUse, 2>();
    direct[0u] = GpuSubmissionBufferUse(resA, 16u, 16u);
    direct[1u] = GpuSubmissionBufferUse(resB, 0u, 8u);
    Array<GpuTaskResourceSetUse, 1> expanded = Array<GpuTaskResourceSetUse, 1>();
    expanded[0u].resourceSet = set;
    expanded[0u].range.bufferRange = BufferRange(0u, s_GpuSubmissionAllBytes);
    expanded[0u].requiredState = ResourceStates::ShaderResource;
    expanded[0u].access = GpuTaskResourceAccess::Read;

    GpuTaskDesc desc = GpuTaskDesc();
    desc.setIdentity(s_GpuCaseTaskUseExpandedTask);
    desc.setMarkerLabel("Expanded Task");
    desc.setResourceUses(direct);
    desc.setResourceSetUses(expanded);
    const Expected<GpuTaskId> taskResult = graph.addTask(desc, GraphicsCommands());
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuSubmissionTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuSubmissionCompiledGraphReadView plan = GpuSubmissionCompiledGraphReadView(compiledGraph);

    Array<GpuGraphResourceId, 5> expectedResources = Array<GpuGraphResourceId, 5>();
    expectedResources[0u] = resA;
    expectedResources[1u] = resB;
    expectedResources[2u] = resA;
    expectedResources[3u] = resA;
    expectedResources[4u] = resB;

    Array<BufferRange, 5> expectedRanges = Array<BufferRange, 5>();
    expectedRanges[0u] = BufferRange(16u, 16u);
    expectedRanges[1u] = BufferRange(0u, 8u);
    expectedRanges[2u] = BufferRange(0u, 16u);
    expectedRanges[3u] = BufferRange(32u, s_GpuSubmissionAllBytes);
    expectedRanges[4u] = BufferRange(8u, s_GpuSubmissionAllBytes);

    native(in plan, in task, in expectedResources, in expectedRanges){
        const auto view = plan.findTask(task);
        ASSERT_NE(view.plan, nullptr);
        ASSERT_EQ(view.plan->prologueBarrierCount, 5u);
        ASSERT_NE(view.prologueBarriers, nullptr);
        for(usize index = 0u; index < expectedRanges.size(); ++index){
            SCOPED_TRACE(index);
            const auto& barrier = view.prologueBarriers[index];
            EXPECT_EQ(barrier.resource, expectedResources[index]);
            EXPECT_EQ(barrier.range.bufferRange, expectedRanges[index]);
            EXPECT_EQ(barrier.before, Core::ResourceStates::Common);
            EXPECT_EQ(barrier.after, index < 2u ? Core::ResourceStates::CopyDest : Core::ResourceStates::ShaderResource);
            EXPECT_TRUE(barrier.isGraphInitialState);
        }
    }
}

void VerifyGpuSubmission_RepeatedAccelerationStructureUsesKeepOneInitialTransitionAndLastStateExport(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuGraphResourceDesc accelDesc = GpuGraphResourceDesc();
    accelDesc.setIdentity(s_GpuCaseTaskUseAcceleration);
    accelDesc.setMarkerLabel("Repeated Acceleration");
    accelDesc.setType(GpuGraphResourceType::AccelStruct);
    accelDesc.setInitialState(ResourceStates::Common);
    accelDesc.setExternalFinalState(ResourceStates::AccelStructRead);
    const Expected<GpuGraphResourceId> accelerationResult = graph.importResource(accelDesc);
    ASSERT_TRUE(accelerationResult.has_value());
    const GpuGraphResourceId acceleration = accelerationResult.value();
    const Expected<GpuGraphResourceId> otherResult = AddBufferMetadata(graph, s_GpuCaseTaskUseAccelerationOther, "Unrelated Buffer", ResourceStates::Common);
    ASSERT_TRUE(otherResult.has_value());
    const GpuGraphResourceId other = otherResult.value();
    ASSERT_TRUE(acceleration.valid());
    ASSERT_TRUE(other.valid());

    Array<GpuTaskResourceUse, 4> uses = Array<GpuTaskResourceUse, 4>();
    uses[0u].resource = acceleration;
    uses[0u].requiredState = ResourceStates::AccelStructWrite;
    uses[0u].access = GpuTaskResourceAccess::Write;
    uses[1u] = GpuSubmissionBufferUse(other, 0u, 16u);
    uses[2u].resource = acceleration;
    uses[2u].requiredState = ResourceStates::AccelStructRead;
    uses[2u].access = GpuTaskResourceAccess::Read;
    uses[3u].resource = acceleration;
    uses[3u].requiredState = ResourceStates::AccelStructWrite;
    uses[3u].access = GpuTaskResourceAccess::Write;

    const Expected<GpuTaskId> taskResult = AddTask(
        s_GpuCaseTaskUseAccelerationTask,
        "Repeated Acceleration Task",
        Span<GpuTaskId>(),
        uses,
        Span<GpuTaskResourceSetUse>(),
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuSubmissionTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuSubmissionCompiledGraphReadView plan = GpuSubmissionCompiledGraphReadView(compiledGraph);

    native(in plan, in task, in acceleration, in other){
        const auto view = plan.findTask(task);
        ASSERT_NE(view.plan, nullptr);
        ASSERT_EQ(view.plan->prologueBarrierCount, 2u);
        ASSERT_NE(view.prologueBarriers, nullptr);
        EXPECT_EQ(view.prologueBarriers[0u].resource, acceleration);
        EXPECT_EQ(view.prologueBarriers[0u].before, Core::ResourceStates::Common);
        EXPECT_EQ(view.prologueBarriers[0u].after, Core::ResourceStates::AccelStructWrite);
        EXPECT_EQ(view.prologueBarriers[1u].resource, other);
        ASSERT_EQ(view.plan->epilogueBarrierCount, 1u);
        ASSERT_NE(view.epilogueBarriers, nullptr);
        EXPECT_EQ(view.epilogueBarriers[0u].resource, acceleration);
        EXPECT_EQ(view.epilogueBarriers[0u].before, Core::ResourceStates::AccelStructWrite);
        EXPECT_EQ(view.epilogueBarriers[0u].after, Core::ResourceStates::AccelStructRead);
    }
}


