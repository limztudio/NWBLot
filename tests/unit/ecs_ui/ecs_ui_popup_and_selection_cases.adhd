void VerifyUiTextEditSession_ExplicitEndClearsCompositionAndInvalidatesOldToken(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    UiEditModel model = UiEditModel(arena.arena);
    UiTextEditSession session = UiTextEditSession(arena.arena, service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Accepted);
    const TextInputSessionToken first = session.token();
    EXPECT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Busy);
    ASSERT_EQ(service.preedit("pending", 0u, 7u), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(s_SessionTestOwner, model).status, UiTextEditStatus::Applied);
    ASSERT_TRUE(session.end(s_SessionTestOwner, model));
    EXPECT_FALSE(model.composition().active);
    ASSERT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Accepted);
    EXPECT_NE(session.token(), first);
    TextInputEvent event = TextInputEvent(arena.arena);
    EXPECT_EQ(service.poll(first, event), TextInputPollResult::InvalidSession);
}

void VerifyUiTextEditSession_DestructionReleasesServiceWithoutBorrowingTheDestroyedModel(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    ASSERT_TRUE(service.setFocused(true));
    if(true){
        UiTextEditSession session = UiTextEditSession(arena.arena, service);
        if(true){
            UiEditModel model = UiEditModel(arena.arena);
            ASSERT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Accepted);
        }
        EXPECT_TRUE(service.activeSession().valid());
    }
    EXPECT_FALSE(service.activeSession().valid());
}


