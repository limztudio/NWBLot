#ifndef NWB_GRAPHICS_GI_HW_TRACE_SLANGI
#define NWB_GRAPHICS_GI_HW_TRACE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// HW backend of the GI trace seam: inline RayQuery reconstructing NwbGiTraceHit identically to SW (sub-ULP; same edge order/cross sign, same InstanceID-indexed material context). Shares hit + Lambert via gi_trace_common.slangi.


#include "constants.h"
#include "../bvh/constants.h"
#include "../bvh/ray_vertex_attrib.slangi"
#include "../raytrace/constants.h"
#include "../deferred/bindless_resources.slangi"
#include "../raytrace/material_context_slots.slangi"
#include "../bindless/bindless_heap_rt.slangi"
#include "surfel/surfel_heap_resources.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The shared scene-shading CB + light list are target-generation heap entries.
// The surfel trace push block selects the deferred target-generation payload from the global UniformBuffer table, so no local CBV remains.
#define g_NwbGiHwBindlessResources g_NwbHeapDeferredBindlessResources[g_NwbSurfelHeapPushConstants.deferredResourcesHeapSlot]
#define NWB_SCENE_SHADING_HEAP_SLOT g_NwbGiHwBindlessResources.avboitSlots.z
#define NWB_SCENE_LIGHT_LIST_HEAP_SLOT g_NwbGiHwBindlessResources.avboitSlots.w

// The shared InstanceID material table and material-surface buffers are global StorageBuffer heap entries.
// The pushed UniformBuffer slot keeps their selection uniform without retaining a local selector CBV.
#define g_NwbGiHwMaterialContextSlots g_NwbHeapSurfelMaterialContextSlotBuffers[g_NwbSurfelHeapPushConstants.materialContextSlotsHeapSlot]

uint nwbMeshFrameMaterialTypedHeapSlot(){
    return g_NwbGiHwMaterialContextSlots.sceneSlots.w;
}
uint nwbMeshFrameInstanceHeapSlot(){
    return g_NwbGiHwMaterialContextSlots.materialSlots.x;
}
uint nwbMeshFrameViewHeapSlot(){
    return 0u;
}
#include "../bindless/bindless_heap_mesh.slangi"

// GI shades direct scene lights with an occlusion ray; it never samples the screen-space shadow/caustic textures.
// Omitting those declarations prevents their default set-0 bindings from aliasing GI's typed material buffers.
#define NWB_SCENE_SHADOW_CAUSTIC_SAMPLING_DISABLED 1

// Reuse the cook-generated material-surface dispatch for GI albedo.
// The heap-selected context above gives the evaluator the same typed constants and mutable instance storage its raster/shadow invocation reads.
#include "../shadow/shadow_surface.slangi"
#include "shadow/generated/surface_dispatch.slangi"

#include "gi_geometry.slangi"

// bindless_heap_rt.slangi above also brings the raw geometry accessor.
// HW GI uses it for positions, indices, and attributes carried by the heap-selected instance-material record; inline RayQuery itself walks the TLAS.


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if NWB_GI_CSG_ENABLED
uint nwbCsgRayCollectCrossings(
    const uint contextSlot,
    const uint materialSlot,
    const uint instanceIndex,
    const uint membershipOffset,
    const float3 worldOrigin,
    const float3 worldDirection,
    const float minimum,
    const float maximum,
    const NwbCsgRayCutInterval cuts[NWB_CSG_RAY_MAX_CUTTERS],
    const uint cutCount,
    inout NwbCsgRayCrossing crossings[NWB_CSG_RAY_CROSSING_CAPACITY],
    inout uint crossingCount,
    out NwbCsgRayBoundary openBoundary
){
    openBoundary = (NwbCsgRayBoundary)0;
    openBoundary.distance = maximum;
    openBoundary.primitive = NWB_CSG_RAY_INVALID_INDEX;
    openBoundary.cutter = NWB_CSG_RAY_INVALID_INDEX;
    const NwbSwBvhInstance instance = nwbCsgRayLoadInstance(contextSlot, instanceIndex);
    const float3x4 worldToObject = nwbCsgRayWorldToObject(instance);
    const NwbRtInstanceMaterial material = nwbHeapRtInstanceMaterials(materialSlot)[instanceIndex];
    RayDesc ray;
    ray.Origin = worldOrigin;
    ray.Direction = worldDirection;
    ray.TMin = 0.0;
    ray.TMax = asfloat(0x7f7fffffu);
    RayQuery<RAY_FLAG_FORCE_NON_OPAQUE> query;
    query.TraceRayInline(nwbHeapAccelStruct(), RAY_FLAG_FORCE_NON_OPAQUE, NWB_RT_CSG_INSTANCE_MASK, ray);
    while(query.Proceed()){
        if(query.CandidateType() != CANDIDATE_NON_OPAQUE_TRIANGLE || query.CandidateInstanceID() != instanceIndex)
            continue;
        if(query.CandidateTriangleRayT() == 0.0)
            continue;
        const uint primitive = query.CandidatePrimitiveIndex();
        if(!nwbCsgRayPrimitiveClosed(contextSlot, membershipOffset, primitive)){
            nwbCsgRaySelectOpenBoundary(
                primitive, query.CandidateTriangleRayT(), query.CandidateTriangleBarycentrics(),
                minimum, cuts, cutCount, openBoundary
            );
            continue;
        }
        // Physical inverse-transpose normals preserve oriented volume membership under reflected instance transforms.
        const float3 normal = nwbRayTraceTriangleGeometricNormal(material, primitive, worldToObject);
        const float facing = dot(normal, worldDirection);
        if(!isfinite(facing) || facing == 0.0)
            return NWB_CSG_RAY_FAILURE_TOPOLOGY;
        NwbCsgRayCrossing crossing;
        crossing.distance = query.CandidateTriangleRayT();
        crossing.primitive = primitive;
        crossing.barycentrics = query.CandidateTriangleBarycentrics();
        crossing.windingDelta = facing < 0.0 ? 1 : -1;
        const uint failure = nwbCsgRayInsertCrossing(materialSlot, instanceIndex, crossing, crossings, crossingCount);
        if(failure != 0u)
            return failure;
    }
    return 0u;
}

void nwbGiHwCsgClosest(
    const float3 origin,
    const float3 direction,
    const float minimum,
    inout NwbGiGeometryHit closest
){
    const uint contextSlot = g_NwbGiHwMaterialContextSlots.materialSlots.w;
    const uint activeOffset = nwbHeapRawBuffer(contextSlot).Load(20u);
    const uint activeCount = nwbHeapRawBuffer(contextSlot).Load(24u);
    // Only active CSG receivers participate. Current-pose bounds discover caps even when their raw receiver exit is beyond the nearest ordinary hit.
    for(uint index = 0u; index < activeCount; ++index){
        const uint instanceIndex = nwbHeapRawBuffer(contextSlot).Load(activeOffset + index * 4u);
        const NwbSwBvhInstance instance = nwbCsgRayLoadInstance(contextSlot, instanceIndex);
        const NwbBvhNode root = nwbCsgRayReceiverRoot(contextSlot, instanceIndex, instance);
        if(!nwbCsgRayBoundsIntersect(instance, root, origin, direction, minimum, closest.distance))
            continue;
        const NwbGiGeometryHit geometry = nwbGiCsgGeometryHit(
            contextSlot, g_NwbGiHwMaterialContextSlots.sceneSlots.z, instanceIndex, origin, direction, minimum, closest.distance
        );
        if(geometry.hit)
            closest = geometry;
        if(closest.failure != 0u)
            return;
    }
}

bool nwbGiHwCsgOccluded(const float3 origin, const float3 direction, const float minimum, const float maximum){
    const uint contextSlot = g_NwbGiHwMaterialContextSlots.materialSlots.w;
    const uint activeOffset = nwbHeapRawBuffer(contextSlot).Load(20u);
    const uint activeCount = nwbHeapRawBuffer(contextSlot).Load(24u);
    for(uint index = 0u; index < activeCount; ++index){
        const uint instanceIndex = nwbHeapRawBuffer(contextSlot).Load(activeOffset + index * 4u);
        const NwbSwBvhInstance instance = nwbCsgRayLoadInstance(contextSlot, instanceIndex);
        const NwbBvhNode root = nwbCsgRayReceiverRoot(contextSlot, instanceIndex, instance);
        if(!nwbCsgRayBoundsIntersect(instance, root, origin, direction, minimum, maximum))
            continue;
        const NwbGiGeometryHit geometry = nwbGiCsgGeometryHit(
            contextSlot, g_NwbGiHwMaterialContextSlots.sceneSlots.z, instanceIndex, origin, direction, minimum, maximum
        );
        if(geometry.hit)
            return true;
    }
    return false;
}
#endif

NwbGiTraceHit nwbGiTraceClosest(float3 origin, float3 direction, float tMin, float tMax){
    NwbGiGeometryHit geometry = nwbGiEmptyGeometryHit(tMax);
    RayDesc ray;
    ray.Origin = origin;
    ray.Direction = direction;
    ray.TMin = tMin;
    ray.TMax = tMax;
    RayQuery<RAY_FLAG_FORCE_OPAQUE> query;
#if NWB_GI_CSG_ENABLED
    // CSG receivers omit this ordinary shadow bit. Their analytic boundaries are compared separately without narrowing the containment query.
    query.TraceRayInline(nwbHeapAccelStruct(), RAY_FLAG_FORCE_OPAQUE, NWB_RT_SHADOW_BASE_INSTANCE_MASK, ray);
#else
    query.TraceRayInline(nwbHeapAccelStruct(), RAY_FLAG_FORCE_OPAQUE, NWB_RAY_TRACING_ALL_INSTANCE_MASK, ray);
#endif
    while(query.Proceed()){}
    float3x4 worldToObject = float3x4(0.0);
    if(query.CommittedStatus() == COMMITTED_TRIANGLE_HIT){
        geometry.hit = true;
        geometry.instance = query.CommittedInstanceID();
        geometry.primitive = query.CommittedPrimitiveIndex();
        geometry.distance = query.CommittedRayT();
        geometry.barycentrics = query.CommittedTriangleBarycentrics();
        worldToObject = query.CommittedWorldToObject3x4();
#if NWB_GI_CSG_ENABLED
        geometry.cutter = NWB_CSG_RAY_INVALID_INDEX;
#endif
    }
#if NWB_GI_CSG_ENABLED
    nwbGiHwCsgClosest(origin, direction, tMin, geometry);
    if(geometry.hit && geometry.failure == 0u){
        const NwbRtInstanceMaterial material = nwbHeapRtInstanceMaterials(g_NwbGiHwMaterialContextSlots.sceneSlots.z)[geometry.instance];
        if((material.flags & NWB_RT_INSTANCE_MATERIAL_FLAG_CSG_SHADOW) != 0u)
            worldToObject = nwbCsgRayWorldToObject(nwbCsgRayLoadInstance(g_NwbGiHwMaterialContextSlots.materialSlots.w, geometry.instance));
    }
#endif
    if(
        geometry.hit && geometry.failure == 0u
#if NWB_GI_CSG_ENABLED
        && geometry.cutter == NWB_CSG_RAY_INVALID_INDEX
#endif
    ){
        const NwbRtInstanceMaterial material = nwbHeapRtInstanceMaterials(g_NwbGiHwMaterialContextSlots.sceneSlots.z)[geometry.instance];
#if NWB_GI_CSG_ENABLED
        if((material.flags & NWB_RT_INSTANCE_MATERIAL_FLAG_CSG_SHADOW) == 0u)
#endif
        {
            const uint3 indices = nwbHeapRawBuffer(material.indexSlot).Load3(geometry.primitive * NWB_RAYTRACE_TRIANGLE_CORNER_COUNT * NWB_RAYTRACE_INDEX_STRIDE_BYTES);
            const float3 v0 = asfloat(nwbHeapRawBuffer(material.positionSlot).Load3(indices.x * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
            const float3 v1 = asfloat(nwbHeapRawBuffer(material.positionSlot).Load3(indices.y * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
            const float3 v2 = asfloat(nwbHeapRawBuffer(material.positionSlot).Load3(indices.z * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
            const float3 objectNormal = normalize(cross(v1 - v0, v2 - v0));
            geometry.normal = nwbSafeNormalize(nwbGiTransformNormal(worldToObject, objectNormal), float3(0.0, 0.0, 1.0));
        }
    }
    return nwbGiReconstructHit(geometry, g_NwbGiHwMaterialContextSlots.sceneSlots.z, worldToObject, origin, direction);
}

bool nwbGiTraceOccluded(float3 origin, float3 direction, float tMin, float tMax){
    RayDesc ray;
    ray.Origin = origin;
    ray.Direction = direction;
    ray.TMin = tMin;
    ray.TMax = tMax;
    RayQuery<RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH> query;
#if NWB_GI_CSG_ENABLED
    query.TraceRayInline(
        nwbHeapAccelStruct(), RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH, NWB_RT_SHADOW_BASE_INSTANCE_MASK, ray
    );
#else
    query.TraceRayInline(
        nwbHeapAccelStruct(), RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH, NWB_RAY_TRACING_ALL_INSTANCE_MASK, ray
    );
#endif
    while(query.Proceed()){}
    if(query.CommittedStatus() == COMMITTED_TRIANGLE_HIT)
        return true;
#if NWB_GI_CSG_ENABLED
    return nwbGiHwCsgOccluded(origin, direction, tMin, tMax);
#else
    return false;
#endif
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


