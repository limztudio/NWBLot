[cook_entry("component", s_RigidBodyComponentDiagnosticPrefix, ParseRigidBodyComponentCookMetadata, document_and_value, log_failure, RigidBodyComponentCodec)]
Expected<RigidBodyComponentAsset> CookRigidBodyComponentVolumeEntry(in RigidBodyComponentCookEntry entry){
    return BuildComponentAssetFromEntry<RigidBodyComponentAsset, RigidBodyComponentCookEntry>(entry);
}

b8 ExtractRigidBodyComponentDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    return ReadCookDependencyEntry<RigidBodyComponentCookEntry>(context, s_RigidBodyComponentDiagnosticPrefix, ParseRigidBodyComponentCookMetadata).has_value();
}

[cook_entry("component", s_ColliderComponentDiagnosticPrefix, ParseColliderComponentCookMetadata, document_and_value, log_failure, ColliderComponentCodec)]
Expected<ColliderComponentAsset> CookColliderComponentVolumeEntry(in ColliderComponentCookEntry entry){
    return BuildComponentAssetFromEntry<ColliderComponentAsset, ColliderComponentCookEntry>(entry);
}

b8 CollectColliderAssetDependencies(
    in AssetRef<Mesh> meshAsset,
    in AssetRef<PhysicsMaterialAsset> materialAsset,
    in AssetRef<ConvexHullAsset> convexHullAsset,
    in AssetRef<CollisionMeshAsset> collisionMeshAsset,
    mut ICookDependencyCollector collector
){
    if(meshAsset.valid() && !collector.addAssetDependency(meshAsset.name(), Mesh::AssetTypeName()))
        return false;
    if(materialAsset.valid() && !collector.addAssetDependency(materialAsset.name(), PhysicsMaterialAsset::AssetTypeName()))
        return false;
    if(convexHullAsset.valid() && !collector.addAssetDependency(convexHullAsset.name(), ConvexHullAsset::AssetTypeName()))
        return false;
    if(collisionMeshAsset.valid() && !collector.addAssetDependency(collisionMeshAsset.name(), CollisionMeshAsset::AssetTypeName()))
        return false;
    return true;
}

b8 ExtractColliderComponentDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    const Expected<ColliderComponentCookEntry> entry = ReadCookDependencyEntry<ColliderComponentCookEntry>(context, s_ColliderComponentDiagnosticPrefix, ParseColliderComponentCookMetadata);
    if(!entry.has_value())
        return false;
    in ColliderComponent comp = entry.value().component;
    if(!CollectColliderAssetDependencies(comp.meshAsset, comp.materialAsset, comp.convexHullAsset, comp.collisionMeshAsset, collector))
        return false;
    for(usize i = 0u; i < comp.extraShapes.size(); ++i){
        in ColliderShapeEntry extra = comp.extraShapes[i];
        if(!CollectColliderAssetDependencies(extra.meshAsset, extra.materialAsset, extra.convexHullAsset, extra.collisionMeshAsset, collector))
            return false;
    }
    return true;
}

