#define EXPECT_TRUE(...) native{ EXPECT_TRUE(...) }
#define EXPECT_FALSE(...) native{ EXPECT_FALSE(...) }
#define EXPECT_EQ(...) native{ EXPECT_EQ(...) }

b8 UiRadioAndScrollLayoutCasesReady(in u64 value){
    return value != 0u;
}

native{
#include <tests/unit/ui/ui_numeric_and_control_fixtures.adhd.h>

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/widgets/radio_group.adhd.h>

#include <gtest/gtest.h>


