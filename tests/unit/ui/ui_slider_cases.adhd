    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.75);
    EXPECT_TRUE(self.m_state.result().valueChanged);
    EXPECT_TRUE(self.m_state.result().dragging);
    EXPECT_EQ(self.m_context.input().capture(), self.track());
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(Point(700.0f, 500.0f), InputEventType::PrimaryUp)).pointerConsumed);
    ASSERT_TRUE(self.accept(3u));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 1.0);
