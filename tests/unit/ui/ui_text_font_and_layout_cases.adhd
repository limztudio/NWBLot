void VerifyTextLayoutInkTests_EmptyShapingInkRemainsAnUnknownPerGlyphRectangle(mut TextLayoutInkTests self){
    self.m_shaper.m_ink = Rect();
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest(s_UiTextLayoutInkCommittedText)));
    ASSERT_EQ(self.m_layout.glyphs().size(), 1u);
    EXPECT_FLOAT_EQ(self.m_layout.glyphs()[0u].ink.width, 0.0f);
    EXPECT_FLOAT_EQ(self.m_layout.glyphs()[0u].ink.height, 0.0f);
    EXPECT_FLOAT_EQ(self.m_layout.inkBounds().width, 0.0f);
    EXPECT_FLOAT_EQ(self.m_layout.measure().x, 10.0f);
}

void VerifyTextLayoutInkTests_UnrepresentableRelativeInkEndpointRejectsTheShaperWithoutReplacingLayout(mut TextLayoutInkTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest(s_UiTextLayoutInkCommittedText)));
    self.m_shaper.m_ink = Rect(f32.max, 0.0f, f32.max, 1.0f);
    const auto layoutResult = self.m_builder.layout(MakeUiTextFontLayoutRequest(s_UiTextLayoutInkReplacementText));
    ASSERT_FALSE(layoutResult.has_value());
    EXPECT_EQ(layoutResult.error(), TextLayoutStatus::FontFailure);
    EXPECT_EQ(self.m_layout.utf8(), s_UiTextLayoutInkCommittedText);
    EXPECT_FLOAT_EQ(self.m_layout.glyphs()[0u].ink.x, -2.0f);
}

void VerifyTextLayoutInkTests_UnrepresentableTranslatedInkRejectsAtomicallyEvenWithEmptyInk(mut TextLayoutInkTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest(s_UiTextLayoutInkCommittedText)));
    self.m_shaper.m_offset.x = f32.max;
    self.m_shaper.m_ink = Rect(f32.max, 0.0f, 0.0f, 0.0f);
    const auto layoutResult = self.m_builder.layout(MakeUiTextFontLayoutRequest(s_UiTextLayoutInkReplacementText));
    ASSERT_FALSE(layoutResult.has_value());
    EXPECT_EQ(layoutResult.error(), TextLayoutStatus::InvalidParameters);
    EXPECT_EQ(self.m_layout.utf8(), s_UiTextLayoutInkCommittedText);
    EXPECT_FLOAT_EQ(self.m_layout.glyphs()[0u].position.x, 0.0f);
}

void VerifyTextLayoutInkTests_UnrepresentableUnionAcrossValidGlyphsRejectsAtomically(mut TextLayoutInkTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest(s_UiTextLayoutInkCommittedText)));
    self.m_shaper.m_offset.x = -f32.max * 0.75f;
    self.m_shaper.m_secondOffset.x = f32.max * 0.75f;
    self.m_shaper.m_ink = Rect(0.0f, -8.0f, 1.0f, 10.0f);
    self.m_shaper.m_advance.x = 0.0f;
    const auto layoutResult = self.m_builder.layout(MakeUiTextFontLayoutRequest(s_UiTextLayoutInkTwoGlyphReplacementText));
    ASSERT_FALSE(layoutResult.has_value());
    EXPECT_EQ(layoutResult.error(), TextLayoutStatus::InvalidParameters);
    EXPECT_EQ(self.m_layout.utf8(), s_UiTextLayoutInkCommittedText);
    EXPECT_FLOAT_EQ(self.m_layout.inkBounds().x, -2.0f);
}

void VerifyTextLayoutInkTests_UnrepresentablePositionOrAdvanceRejectsBeforeGlyphPublication(mut TextLayoutInkTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest(s_UiTextLayoutInkCommittedText)));
    self.m_shaper.m_ink = Rect();
    self.m_shaper.m_advance.x = f32.max;
    self.m_shaper.m_secondOffset.x = f32.max;
    const auto layoutResult = self.m_builder.layout(MakeUiTextFontLayoutRequest(s_UiTextLayoutInkTwoGlyphReplacementText));
    ASSERT_FALSE(layoutResult.has_value());
    EXPECT_EQ(layoutResult.error(), TextLayoutStatus::InvalidParameters);
    EXPECT_EQ(self.m_layout.utf8(), s_UiTextLayoutInkCommittedText);
    ASSERT_EQ(self.m_layout.glyphs().size(), 1u);
}

void VerifyTextLayoutInkTests_MalformedOrUnrepresentableKnownCoverageRejectsAtomically(mut TextLayoutInkTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest(s_UiTextLayoutInkCommittedText)));
    self.m_shaper.m_coverage = MakeUiTextFontLayoutCoverage(Rect(0.0f, 0.0f, -1.0f, 1.0f), true);
    const auto firstRejected = self.m_builder.layout(MakeUiTextFontLayoutRequest(s_UiTextLayoutInkReplacementText));
    ASSERT_FALSE(firstRejected.has_value());
    EXPECT_EQ(firstRejected.error(), TextLayoutStatus::FontFailure);
    EXPECT_EQ(self.m_layout.utf8(), s_UiTextLayoutInkCommittedText);
    self.m_shaper.m_coverage = MakeUiTextFontLayoutCoverage(Rect(f32.max, 0.0f, 0.0f, 0.0f), true);
    self.m_shaper.m_offset.x = f32.max;
    self.m_shaper.m_ink = Rect();
    const auto secondRejected = self.m_builder.layout(MakeUiTextFontLayoutRequest(s_UiTextLayoutInkReplacementText));
    ASSERT_FALSE(secondRejected.has_value());
    EXPECT_EQ(secondRejected.error(), TextLayoutStatus::InvalidParameters);
    EXPECT_EQ(self.m_layout.utf8(), s_UiTextLayoutInkCommittedText);
    EXPECT_FALSE(self.m_layout.glyphs()[0u].coverage.known);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyTextLayoutTests_CrLfAndTrailingNewlinePreserveSourceRangesAndEmptyFinalLine(mut TextLayoutTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest("A\r\nB\n")));
    ASSERT_EQ(self.m_layout.lines().size(), 3u);
    EXPECT_EQ(self.m_layout.lines()[0u].byteEnd, 1u);
    EXPECT_EQ(self.m_layout.lines()[0u].breakEnd, 3u);
    EXPECT_EQ(self.m_layout.lines()[1u].byteBegin, 3u);
    EXPECT_EQ(self.m_layout.lines()[2u].byteBegin, 5u);
    EXPECT_EQ(self.m_layout.lines()[2u].glyphCount, 0u);
    EXPECT_FLOAT_EQ(self.m_layout.measure().y, 36.0f);
    EXPECT_EQ(self.m_layout.hitTest(Point(20.0f, 100.0f)).byteOffset, 5u);
    EXPECT_FALSE(self.m_layout.caretRect(2u, TextCaretEdge::Leading).has_value());
    const auto caret = self.m_layout.caretRect(5u, TextCaretEdge::Leading);
    ASSERT_TRUE(caret.has_value());
    EXPECT_FLOAT_EQ(caret.value().y, 24.0f);
    EXPECT_FLOAT_EQ(caret.value().height, 12.0f);
}

void VerifyTextLayoutTests_LigatureAndCombiningClustersHaveOnlyRealSourceEdges(mut TextLayoutTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest(s_UiTextLayoutLigatureText)));
    ASSERT_EQ(self.m_layout.clusters().size(), 1u);
    EXPECT_EQ(self.m_layout.clusters()[0u].byteBegin, 0u);
    EXPECT_EQ(self.m_layout.clusters()[0u].byteEnd, 3u);
    EXPECT_EQ(self.m_layout.hitTest(Point(15.0f, 4.0f)).byteOffset, 0u);
    EXPECT_EQ(self.m_layout.hitTest(Point(15.01f, 4.0f)).byteOffset, 3u);
    EXPECT_FALSE(self.m_layout.caretRect(1u, TextCaretEdge::Leading).has_value());
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest(s_UiTextLayoutCombiningMarkText)));
    ASSERT_EQ(self.m_layout.clusters().size(), 1u);
    EXPECT_EQ(self.m_layout.clusters()[0u].glyphCount, 2u);
    EXPECT_FLOAT_EQ(self.m_layout.measure().x, 10.0f);
    EXPECT_FALSE(self.m_layout.caretRect(1u, TextCaretEdge::Leading).has_value());
    EXPECT_FALSE(self.m_layout.caretRect(2u, TextCaretEdge::Leading).has_value());
    EXPECT_EQ(self.m_layout.hitTest(Point(10.0f, 4.0f)).byteOffset, 3u);
}

void VerifyTextLayoutTests_NonBmpAndHangulClustersMapUtf8BytesRatherThanScalarIndices(mut TextLayoutTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest("A\xed\x95\x9c\xf0\x9f\x98\x80")));
    ASSERT_EQ(self.m_layout.clusters().size(), 3u);
    EXPECT_EQ(self.m_layout.clusters()[0u].byteEnd, 1u);
    EXPECT_EQ(self.m_layout.clusters()[1u].byteBegin, 1u);
    EXPECT_EQ(self.m_layout.clusters()[1u].byteEnd, 4u);
    EXPECT_EQ(self.m_layout.clusters()[2u].byteBegin, 4u);
    EXPECT_EQ(self.m_layout.clusters()[2u].byteEnd, 8u);
    EXPECT_FALSE(self.m_layout.caretRect(2u, TextCaretEdge::Trailing).has_value());
    EXPECT_FALSE(self.m_layout.caretRect(6u, TextCaretEdge::Leading).has_value());
    const auto caret = self.m_layout.caretRect(4u, TextCaretEdge::Leading);
    ASSERT_TRUE(caret.has_value());
    EXPECT_FLOAT_EQ(caret.value().x, 20.0f);
}

void VerifyTextLayoutTests_RtlVisualOrderReversesLogicalClusterEdgesAndPreservesByteEnds(mut TextLayoutTests self){
    ShapeRequest request = MakeUiTextFontLayoutRequest("abc");
    request.direction = TextDirection::RightToLeft;
    ASSERT_TRUE(self.applyLayout(request));
    ASSERT_EQ(self.m_layout.clusters().size(), 3u);
    EXPECT_EQ(self.m_layout.clusters()[0u].byteBegin, 2u);
    EXPECT_EQ(self.m_layout.clusters()[0u].byteEnd, 3u);
    EXPECT_FLOAT_EQ(self.m_layout.clusters()[0u].leadingX, 10.0f);
    EXPECT_FLOAT_EQ(self.m_layout.clusters()[0u].trailingX, 0.0f);
    EXPECT_EQ(self.m_layout.hitTest(Point(-1.0f, 4.0f)).byteOffset, 3u);
    EXPECT_EQ(self.m_layout.hitTest(Point(31.0f, 4.0f)).byteOffset, 0u);
    EXPECT_EQ(self.m_layout.hitTest(Point(5.0f, 4.0f)).byteOffset, 2u);
    auto caret = self.m_layout.caretRect(0u, TextCaretEdge::Leading);
    ASSERT_TRUE(caret.has_value());
    EXPECT_FLOAT_EQ(caret.value().x, 30.0f);
    caret = self.m_layout.caretRect(3u, TextCaretEdge::Trailing);
    ASSERT_TRUE(caret.has_value());
    EXPECT_FLOAT_EQ(caret.value().x, 0.0f);
}

void VerifyTextLayoutTests_FailedLaterLineAndSourceMutationPreserveCommittedLayout(mut TextLayoutTests self){
    String source = "";
    source.assign(s_UiTextLayoutTwoGlyphText.data(), s_UiTextLayoutTwoGlyphText.size());
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest(StringView(source.data(), source.size()))));
    source.assign("changed", 7u);
    EXPECT_EQ(self.m_layout.utf8(), s_UiTextLayoutTwoGlyphText);
    const auto missingResult = self.m_builder.layout(MakeUiTextFontLayoutRequest("C\nFAIL"));
    ASSERT_FALSE(missingResult.has_value());
    EXPECT_EQ(missingResult.error(), TextLayoutStatus::MissingGlyph);
    EXPECT_EQ(self.m_layout.utf8(), s_UiTextLayoutTwoGlyphText);
    EXPECT_FLOAT_EQ(self.m_layout.measure().x, 20.0f);
    ASSERT_EQ(self.m_layout.lines().size(), 1u);
    const auto tabResult = self.m_builder.layout(MakeUiTextFontLayoutRequest("A\tB"));
    ASSERT_FALSE(tabResult.has_value());
    EXPECT_EQ(tabResult.error(), TextLayoutStatus::UnsupportedControl);
    EXPECT_EQ(self.m_layout.utf8(), s_UiTextLayoutTwoGlyphText);
}

void VerifyTextLayoutTests_EmptyTextHasOneTypographicLineAndNoInk(mut TextLayoutTests self){
    ASSERT_TRUE(self.applyLayout(ShapeRequest()));
    EXPECT_EQ(self.m_layout.lines().size(), 1u);
    EXPECT_TRUE(self.m_layout.glyphs().empty());
    EXPECT_FLOAT_EQ(self.m_layout.measure().x, 0.0f);
    EXPECT_FLOAT_EQ(self.m_layout.measure().y, 12.0f);
    EXPECT_FLOAT_EQ(self.m_layout.inkBounds().width, 0.0f);
    const auto caret = self.m_layout.caretRect(0u, TextCaretEdge::Leading);
    ASSERT_TRUE(caret.has_value());
    EXPECT_FLOAT_EQ(caret.value().height, 12.0f);
}

void VerifyTextLayoutTests_StrictUtf8AndHorizontalRequestValidationAreFailureAtomic(mut TextLayoutTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest(s_UiTextLayoutTwoGlyphText)));
    Array<StringView, 5u> invalid;
    invalid[0u] = "\xc0\x80";
    invalid[1u] = "\xed\xa0\x80";
    invalid[2u] = "\xf4\x90\x80\x80";
    invalid[3u] = "\xe2\x82";
    invalid[4u] = MakeUiTextLayoutNullByteView();
    for(in StringView text : invalid){
        const auto layoutResult = self.m_builder.layout(MakeUiTextFontLayoutRequest(text));
        ASSERT_FALSE(layoutResult.has_value());
        EXPECT_EQ(layoutResult.error(), TextLayoutStatus::InvalidUtf8);
        EXPECT_EQ(self.m_layout.utf8(), s_UiTextLayoutTwoGlyphText);
    }
    const auto crResult = self.m_builder.layout(MakeUiTextFontLayoutRequest("A\rB"));
    ASSERT_FALSE(crResult.has_value());
    EXPECT_EQ(crResult.error(), TextLayoutStatus::UnsupportedControl);
    ShapeRequest request = MakeUiTextFontLayoutRequest(s_UiTextLayoutTwoGlyphText);
    request.fontSize = bit_cast<f32>(s_UiTextFontLayoutQuietNaNF32Bits);
    const auto nanResult = self.m_builder.layout(request);
    ASSERT_FALSE(nanResult.has_value());
    EXPECT_EQ(nanResult.error(), TextLayoutStatus::InvalidParameters);
    request.fontSize = 16.0f;
    request.scriptTag = 0u;
    const auto zeroTagResult = self.m_builder.layout(request);
    ASSERT_FALSE(zeroTagResult.has_value());
    EXPECT_EQ(zeroTagResult.error(), TextLayoutStatus::InvalidParameters);
    EXPECT_EQ(self.m_layout.utf8(), s_UiTextLayoutTwoGlyphText);
}


