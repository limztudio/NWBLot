#ifndef NWB_GRAPHICS_GI_SURFEL_CONSTANTS_SLANGI
#define NWB_GRAPHICS_GI_SURFEL_CONSTANTS_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Per-frame surfel params for spawn/hash/trace/gather (dedicated CB: five float4 lanes; mirrors NwbSurfelConstantsGpu).
// Divisor is 1 on bootstrap so every surfel seeds in one frame.
struct NwbSurfelConstants{
    float4 cameraPositionCellSize;  // xyz = camera world position, w = hash cell size (surfel spacing; one surfel per cell)
    float4 hashPoolFrameDivisor;    // x = hash cell count (pow2), y = pool capacity, z = frame index, w = update divisor
    float4 coverageRadiusBiasHyst;  // x = reserved (one-surfel-per-cell dropped the coverage sum), y = default spawn radius, z = normal bias, w = accumulation cap (bounded running-mean window)
    float4 ageRaysTileScreen;       // x = max age (frames before recycle), y = maximum rays/surfel, z = spawn tile (px), w = screen width
    float4 screenHeightPad;         // x = screen height, yzw = pad
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

