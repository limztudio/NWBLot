Expected<MultilineTextStep> TryBuildMultilineTextStep(in StringView source, in usize offset, in u32 scalar, in usize decodedBytes){
    MultilineTextStep outStep;
    outStep.sourceBytes = decodedBytes;
    const b8 lineBreak = IsMultilineLineBreakScalar(scalar);
    if(lineBreak || scalar == s_EditUnicodeTab){
        if(lineBreak)
            outStep.replacement = cast<u8>(s_EditUnicodeLineFeed);
        else
            outStep.replacement = cast<u8>(s_TextUnicodeSpace);
        outStep.outputBytes = 1u;
        if(scalar == s_EditUnicodeCarriageReturn && offset + outStep.sourceBytes < source.size() && cast<u32>(cast<u8>(source[offset + outStep.sourceBytes])) == s_EditUnicodeLineFeed)
            ++outStep.sourceBytes;
        return outStep;
    }
    if(!IsCanonicalMultilineScalar(scalar))
        return MakeUnexpected(Failure());
    outStep.outputBytes = outStep.sourceBytes;
    return outStep;
}

Expected<SingleLineTextStep> TryBuildSingleLineTextStep(in StringView source, in usize offset, in u32 scalar, in usize decodedBytes){
    SingleLineTextStep outStep;
    if(IsSingleLineRejectedScalar(scalar))
        return MakeUnexpected(Failure());
    const b8 space = IsSingleLineSpaceScalar(scalar);
    outStep.sourceBytes = decodedBytes;
    if(space)
        outStep.outputBytes = 1u;
    else
        outStep.outputBytes = outStep.sourceBytes;
    outStep.space = space;
    if(scalar == s_EditUnicodeCarriageReturn && offset + outStep.sourceBytes < source.size() && cast<u32>(cast<u8>(source[offset + outStep.sourceBytes])) == s_EditUnicodeLineFeed)
        ++outStep.sourceBytes;
    return outStep;
}

b8 ValidateGraphemeText(in StringView text, in b8 singleLine){
    if(text.size() > cast<usize>(i32.max))
        return false;
    usize offset = 0u;
    while(offset < text.size()){
        u32 scalar = 0u;
        usize byteCount = 0u;
        if(!TryDecodeUtf8Scalar(text.substr(offset, s_EditUtf8MaxSequenceBytes), scalar, byteCount))
            return false;
        if(singleLine && !IsSingleLineScalar(scalar))
            return false;
        offset += byteCount;
    }
    return true;
}

// Canonical multiline text contains LF and ordinary UTF8 scalars; all other ASCII/C1 controls and line separators fail.
b8 ValidateMultilineText(in StringView text){
    if(text.size() > cast<usize>(i32.max))
        return false;
    usize offset = 0u;
    while(offset < text.size()){
        u32 scalar = 0u;
        usize byteCount = 0u;
        if(!TryDecodeUtf8Scalar(text.substr(offset, s_EditUtf8MaxSequenceBytes), scalar, byteCount) || !IsCanonicalMultilineScalar(scalar))
            return false;
        offset += byteCount;
    }
    return true;
}

Expected<SingleLineTextStep> ReadSingleLineTextStep(in StringView source, in usize offset){
    u32 scalar = 0u;
    usize byteCount = 0u;
    if(!TryDecodeUtf8Scalar(source.substr(offset, s_EditUtf8MaxSequenceBytes), scalar, byteCount))
        return MakeUnexpected(Failure());
    return TryBuildSingleLineTextStep(source, offset, scalar, byteCount);
}

Expected<MultilineTextStep> ReadMultilineTextStep(in StringView source, in usize offset){
    u32 scalar = 0u;
    usize byteCount = 0u;
    if(!TryDecodeUtf8Scalar(source.substr(offset, s_EditUtf8MaxSequenceBytes), scalar, byteCount))
        return MakeUnexpected(Failure());
    return TryBuildMultilineTextStep(source, offset, scalar, byteCount);
}

b8 ValidateEditTextForMode(in StringView text, in EditTextMode textMode){
    if(textMode == EditTextMode::Multiline)
        return ValidateMultilineText(text);
    return ValidateGraphemeText(text, true);
}

Expected<usize, EditTextStatus> NormalizeSingleLineTextInto(in StringView source, in usize maxBytes, mut String outCandidate){
    if(!ValidateGraphemeText(source, false))
        return MakeUnexpected(EditTextStatus::InvalidText);
    usize normalizedBytes = 0u;
    usize offset = 0u;
    while(offset < source.size()){
        const Expected<SingleLineTextStep> step = ReadSingleLineTextStep(source, offset);
        if(!step.has_value())
            return MakeUnexpected(EditTextStatus::InvalidText);
        if(step.value().outputBytes > maxBytes - normalizedBytes)
            return MakeUnexpected(EditTextStatus::TooLarge);
        normalizedBytes += step.value().outputBytes;
        offset += step.value().sourceBytes;
    }
    outCandidate.clear();
    outCandidate.reserve(normalizedBytes);
    offset = 0u;
    while(offset < source.size()){
        const Expected<SingleLineTextStep> step = ReadSingleLineTextStep(source, offset);
        assert(step.has_value());
        if(step.value().space)
            outCandidate += " ";
        else
            outCandidate.append(source.substr(offset, step.value().sourceBytes));
        offset += step.value().sourceBytes;
    }
    return normalizedBytes;
}

Expected<usize, EditTextStatus> NormalizeMultilineTextInto(in StringView source, in usize maxBytes, mut String outCandidate){
    if(!ValidateGraphemeText(source, false))
        return MakeUnexpected(EditTextStatus::InvalidText);
    usize normalizedBytes = 0u;
    usize offset = 0u;
    while(offset < source.size()){
        const Expected<MultilineTextStep> step = ReadMultilineTextStep(source, offset);
        if(!step.has_value())
            return MakeUnexpected(EditTextStatus::InvalidText);
        if(step.value().outputBytes > maxBytes - normalizedBytes)
            return MakeUnexpected(EditTextStatus::TooLarge);
        normalizedBytes += step.value().outputBytes;
        offset += step.value().sourceBytes;
    }
    outCandidate.clear();
    outCandidate.reserve(normalizedBytes);
    offset = 0u;
    while(offset < source.size()){
        const Expected<MultilineTextStep> step = ReadMultilineTextStep(source, offset);
        assert(step.has_value());
        if(step.value().replacement != 0u){
            if(cast<u32>(step.value().replacement) == s_EditUnicodeLineFeed)
                outCandidate += "\n";
            else
                outCandidate += " ";
        }
        else{
            outCandidate.append(source.substr(offset, step.value().sourceBytes));
        }
        offset += step.value().sourceBytes;
    }
    return normalizedBytes;
}

void BuildReplacedEditString(in StringView currentText, in usize begin, in usize end, in StringView replacement, mut String outCandidate){
    const usize retainedBytes = currentText.size() - (end - begin);
    outCandidate.clear();
    outCandidate.reserve(retainedBytes + replacement.size());
    outCandidate.append(currentText.substr(0u, begin));
    if(!replacement.empty())
        outCandidate.append(replacement);
    outCandidate.append(currentText.substr(end, currentText.size() - end));
}

void BuildErasedAroundSelectionEditString(in StringView currentText, in usize beforeBytes, in usize afterBytes, in usize start, in usize end, mut String outCandidate){
    const usize prefixEnd = start - beforeBytes;
    const usize suffixStart = end + afterBytes;
    outCandidate.clear();
    outCandidate.reserve(currentText.size() - beforeBytes - afterBytes);
    outCandidate.append(currentText.substr(0u, prefixEnd));
    outCandidate.append(currentText.substr(start, end - start));
    outCandidate.append(currentText.substr(suffixStart, currentText.size() - suffixStart));
}

b8 TryBuildGraphemeBoundariesInto(in StringView text, in b8 singleLine, mut Vector<usize> outBoundaries){
    if(!ValidateGraphemeText(text, singleLine) || text.size() == usize.max)
        return false;
    outBoundaries.clear();
    outBoundaries.reserve(text.size() + 1u);
    usize offset = 0u;
    b8 valid = true;
    native(in text, mut offset, mut outBoundaries, mut valid){
        ::GraphemeBoundaryState state;
        while(offset < text.size()){
            const auto decoded = ::DecodeUtf8Scalar(text.substr(offset, ::s_Utf8MaxSequenceBytes));
            if(!decoded){
                valid = false;
                break;
            }
            const u32 scalar = decoded->codePoint;
            const ::GraphemeBreak::Enum current = ::LookupGraphemeBreak(scalar);
            const ::IndicConjunct::Enum indic = ::LookupIndicConjunct(scalar);
            const b8 pictograph = ::IsExtendedPictographic(scalar);
            if(state.breaksBefore(current, indic, pictograph))
                outBoundaries.push_back(offset);
            state.advance(current, indic, pictograph);
            offset += static_cast<usize>(decoded->byteCount);
        }
    }
    if(!valid)
        return false;
    outBoundaries.push_back(text.size());
    return true;
}


