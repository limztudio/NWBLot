Optional<in UiSkinRegion> Builder::prepareListFrame(in borrow IListDataSource source, mut ListState state, in ListOptions options, in ControlToken token, in u64 rowCount, in b8 focusOnCommit, in WidgetId commandFocus, mut BuilderListFrame outFrame){
    outFrame.source = Optional<in IListDataSource>(source);
    outFrame.state = Optional<mut ListState>(state);
    outFrame.widgetStyle = this.m_style;
    outFrame.style = this.m_listStyle;
    outFrame.options = options;
    outFrame.token = token;
    outFrame.rowCount = rowCount;
    outFrame.focusOnCommit = focusOnCommit;
    outFrame.commandFocus = commandFocus;
    outFrame.padding = outFrame.style.padding;
    const auto background = this.region(outFrame.style.background, outFrame.style.backgroundFallback);
    if(!background.has_value())
        return Optional<in UiSkinRegion>();
    outFrame.padding = MaxUiPadding(outFrame.padding, background.value().padding);
    if(!this.prepareListMetrics(outFrame))
        return Optional<in UiSkinRegion>();
    return background;
}

b8 Builder::prepareListMetrics(mut BuilderListFrame frame){
    if(!this.listMatches(frame) || !this.m_skin.has_value())
        return false;
    const auto metrics = MeasureSelectable(this.m_skin.value(), frame.style.row);
    if(!metrics.has_value())
        return false;
    frame.style.row.padding = metrics.value().padding;
    const auto keyResult = TryBuildListMeasureKey(
        frame.token.contentGeneration,
        frame.token.contentRevision,
        frame.rowCount,
        this.m_text.identity(),
        this.m_text.generation(),
        frame.widgetStyle.fontSize,
        this.m_paint.displayMetrics(),
        metrics.value(),
        this.m_textScriptTag,
        StringView(this.m_textLanguage)
    );
    if(!keyResult.has_value())
        return false;
    const ListMeasureKey key = keyResult.value();
    frame.measureKey = key;
    mut ListState state = frame.state.value();
    if(key != state.m_measureKey || state.m_rowHeight <= 0.0f){
        auto empty = this.m_text.layout(this.textShapeRequest("", key.fontSize));
        if(!empty.has_value())
            return false;
        const auto bounds = this.m_text.measure(empty.value(), this.m_paint.displayMetrics());
        if(!bounds.has_value())
            return false;
        const f32 height = ResolveListRowBaseHeight(metrics.value(), bounds.value().height);
        if(!IsFinite(height) || height <= 0.0f || !this.listMatches(frame))
            return false;
        state.m_measureKey = key;
        state.m_rowHeight = height;
    }
    // The last painted offset may belong to a different styled declaration than the measurement cache.
    if(NeedsListScrollOffsetRescale(state.m_scrollRowHeight, state.m_scrollSourceGeneration, key.sourceGeneration, state.m_rowHeight)){
        const f64 offset = ComputeListRescaledScrollOffset(
            state.m_placement.contentClip.y,
            state.m_placement.viewport.y,
            state.scrollOffset(),
            state.m_scrollRowHeight,
            state.m_rowHeight
        );
        if(!state.m_scroll.setOffset(offset))
            return false;
    }
    state.m_scrollRowHeight = state.m_rowHeight;
    state.m_scrollSourceGeneration = key.sourceGeneration;
    frame.rowHeight = state.m_rowHeight;
    frame.scrollOffset = state.scrollOffset();
    frame.cursorKey = state.cursorKey();
    frame.revealCursor = state.m_ensureCursor;
    return this.listMatches(frame);
}

ListResult Builder::virtualList(in StringView stableKey, in borrow IListDataSource source, mut ListState state, in ListOptions options){
    ListResult result;
    if(this.itemDeclarationBlocked() || !IsValidVirtualListWheelRows(options.wheelRows)){
        this.m_context.fail();
        return result;
    }
    // A body callback may have closed or reopened its popup; no model loan is allowed past that boundary.
    if(!this.synchronizePopup()){
        result.valid = true;
        return result;
    }
    this.m_declaring = true;
    BuilderOperationEnd finish(this.m_declaring);
    const auto widget = this.m_context.declare(stableKey, WidgetKind::VirtualList);
    if(!widget.has_value())
        return result;
    const b8 previouslyFocused = this.m_context.input().focus() == widget.value().id;
    const u64 previousSelection = state.selectedKey();
    if(!ReconcileListState(state, source)){
        this.m_context.fail();
        return result;
    }
    ControlToken token;
    token.instanceGeneration = state.inputGeneration();
    token.contentGeneration = source.instanceGeneration();
    token.contentRevision = source.revision();
    this.m_context.input().fenceControl(widget.value().id, widget.value().declarationGeneration, token);
    if(!options.enabled)
        this.m_context.input().invalidateTarget(widget.value().id);
    result.valid = true;
    result.selectionChanged = previousSelection != state.selectedKey();
    result.focused = options.enabled && this.m_context.input().focus() == widget.value().id;
    ListInput input(this.m_context);
    const ListInputMatches matches = lambda[]() -> b8{ return true; };
    const Optional<in IListDataSource> sourceLoan(source);
    const Optional<in ListOptions> optionsLoan(options);
    const ListInputApplyAction apply = lambda[in sourceLoan, in optionsLoan, mut state, mut result](in ControlAction action) -> ListActionOutcome{
        if(ApplyListControlAction(sourceLoan.value(), optionsLoan.value(), action, state, result))
            return ListActionOutcome::Continue;
        return ListActionOutcome::Failed;
    };
    if(!input.consume(
        widget.value(),
        token,
        options.enabled,
        state,
        matches,
        apply
    )){
        this.m_context.fail();
        result.valid = false;
        return result;
    }
    auto frame = this.makeListFrame();
    const auto background = this.prepareListFrame(source, state, options, token, source.rowCount(), options.enabled && previouslyFocused && !result.focused, WidgetId(), frame);
    if(!background.has_value()){
        this.m_context.fail();
        result.valid = false;
        return result;
    }
    // A fractional offset or a skin minimum can expose more than one row in a natural viewport.
    // Finish that bounded measurement before its intrinsic height enters the parent layout.
    if(options.height.policy == LayoutSizePolicy::Content && frame.rowCount != 0u){
        while(true){
            LayoutBox provisional;
            provisional.rectangle = ResolveListProbeRect(background.value(), frame.padding, frame.style.scrollbarWidth, frame.rowHeight);
            provisional.clip = provisional.rectangle;
            ListLayoutPreparer layout(this.m_scope.value(), this.m_context, this.m_text, this.m_paint);
            const auto placement = layout.measureListPlacement(frame, provisional, provisional.clip);
            if(!placement.has_value()){
                this.m_context.fail();
                result.valid = false;
                return result;
            }
            const f32 height = ResolveListIntrinsicSize(background.value(), frame.padding, frame.rowHeight).y;
            if(height == placement.value().bounds.height)
                break;
        }
    }
    auto item = this.makeItem();
    item.state = widget.value();
    item.enabled = options.enabled;
    item.list = cast<u32>(this.m_scope.value().m_lists.size());
    LayoutNodeDesc description;
    description.width = options.width;
    description.height = options.height;
    description.intrinsicSize = ResolveListIntrinsicSize(background.value(), frame.padding, frame.rowHeight);
    if(!this.addItemNode(description, item)){
        result.valid = false;
        return result;
    }
    AppendOwned<BuilderListFrame>(this.m_scope.value().m_lists, frame);
    AppendOwned<BuilderItem>(this.m_scope.value().m_items, item);
    return result;
}

b8 Builder::paintList(in BuilderItem item, in LayoutBox box){
    if(item.list >= this.m_scope.value().m_lists.size())
        return false;
    mut BuilderListFrame frame = this.m_scope.value().m_lists[item.list];
    if(!this.listMatches(frame))
        return false;
    const Rect clip = this.visibleClip(box.clip);
    ListLayoutPreparer layout(this.m_scope.value(), this.m_context, this.m_text, this.m_paint);
    const auto measuredPlacement = layout.measureListPlacement(frame, box, clip);
    if(!measuredPlacement.has_value())
        return false;
    in ScrollPlacement placement = measuredPlacement.value();
    if(!frame.state.value().m_scroll.setOffset(frame.scrollOffset))
        return false;
    frame.state.value().m_scrollRowHeight = frame.rowHeight;
    frame.state.value().m_scrollSourceGeneration = frame.token.contentGeneration;
    if(frame.revealCursor && frame.state.value().cursorKey() == frame.cursorKey)
        frame.state.value().m_ensureCursor = false;
    frame.state.value().m_placement = placement;
    const auto background = this.region(frame.style.background, frame.style.backgroundFallback);
    if(!background.has_value())
        return false;
    this.m_paint.pushClip(clip);
    const b8 painted = this.m_paint.drawRegion(background.value().name, box.rectangle);
    const b8 popped = this.m_paint.popClip();
    if(!painted || !popped)
        return false;
    HitTargetFactory targets;
    const HitTarget host = targets.makeListHostHitTarget(
        box.rectangle,
        clip,
        item.enabled,
        item.contextMenu,
        frame.token,
        frame.rowHeight,
        frame.options.wheelRows,
        placement,
        frame.rowCount,
        frame.focusOnCommit
    );
    if(!this.m_context.addTarget(item.state, host) || !this.paintListRows(item, frame, placement))
        return false;
    // Paint owns its glyph pages now; keep no shaped rows alive through later sibling lists.
    frame.rows.clear();
    if(placement.scrollbarVisible){
        const auto thumbId = TryMakeWidgetId(item.state.id, s_WidgetPartScrollbar);
        if(!thumbId.has_value())
            return false;
        const b8 hover = this.m_context.input().hover() == thumbId.value();
        ControlVisualPainter painter;
        if(!painter.paintListScrollbarVisual(this.m_paint, this.m_skin.value(), frame.style, placement, clip, hover))
            return false;
        if(item.enabled){
            const HitTarget trackTarget = targets.makeListScrollbarTrackHitTarget(placement, clip, frame.token);
            const auto trackId = TryMakeWidgetId(item.state.id, s_WidgetPartTrack);
            if(!trackId.has_value() || !this.m_context.addPartTarget(item.state, trackId.value(), trackTarget))
                return false;
            const HitTarget thumbTarget = targets.makeListScrollbarThumbHitTarget(placement, clip, frame.token);
            if(!this.m_context.addPartTarget(item.state, thumbId.value(), thumbTarget))
                return false;
        }
    }
    return true;
}

b8 Builder::paintListRows(in BuilderItem item, in BuilderListFrame frame, in ScrollPlacement placement){
    HitTargetFactory targets;
    in Vector<BuilderListRow> rows = frame.rows;
    const auto rowsId = TryMakeWidgetId(item.state.id, s_WidgetPartRows);
    if(!rowsId.has_value())
        return false;
    const b8 focused = IsListRowsFocused(this.m_context.input().focus(), item.state.id, frame.commandFocus);
    usize found = ListRowInsertionIndex(rows, placement.firstRow);
    for(u64 index = placement.firstRow; index < placement.endRow; ++index){
        if(found == rows.size() || rows[found].index != index || !this.listStateMatches(frame))
            return false;
        in BuilderListRow row = rows[found];
        ++found;
        const u64 key = row.key;
        const b8 enabled = item.enabled && row.enabled;
        const auto part = TryMakeWidgetPartId(rowsId.value(), key);
        if(!part.has_value())
            return false;
        const auto rectangle = CalculateScrollRowBounds(index, placement, frame.rowHeight);
        if(!rectangle.has_value())
            return false;
        SelectablePaintFlags flags;
        flags.enabled = enabled;
        flags.selected = frame.state.value().selectedKey() == key;
        flags.hover = this.m_context.input().hover() == part.value();
        flags.focused = focused && frame.state.value().cursorKey() == key;
        if(!PaintSelectable(this.m_paint, this.m_text, this.m_skin.value(), row.text, row.textBounds, frame.style.row.padding, rectangle.value(), placement.contentClip, frame.style.row, flags, frame.widgetStyle.text, frame.widgetStyle.disabledText))
            return false;
        if(item.enabled){
            const HitTarget target = targets.makeListRowHitTarget(rectangle.value(), placement.contentClip, enabled, frame.token, key);
            if(!this.m_context.addPartTarget(item.state, part.value(), target))
                return false;
        }
    }
    return this.listMatches(frame);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NumericEditBoxResult Builder::integerEdit(in StringView stableKey, mut IntegerEditModel model, mut EditBoxState state, in IntegerEditOptions options){
    NumericEditBoxResult result;
    if(this.declarationBlocked() || !ValidateIntegerBounds(options.bounds)){
        this.m_context.fail();
        return result;
    }
    result.numeric.valid = true;
    BuilderIntegerEditFrame frame;
    frame.model = Optional<mut IntegerEditModel>(model);
    frame.state = Optional<mut EditBoxState>(state);
    frame.revision = model.revision();
    NumericEditActions actions(options.bounds, this.m_context, model, result.numeric, frame.revision);
    const usize previousCount = this.m_scope.value().m_items.size();
    result.edit = this.declareEditBox(stableKey, options.edit, model.lendDraft(), state, Optional<mut IEditActionSink>(actions), Optional<mut BuilderIntegerEditFrame>(frame), Optional<mut BuilderFloatEditFrame>());
    result.numeric.valid = result.numeric.valid && result.edit.valid;
    if(result.edit.valid && this.m_scope.value().m_items.size() > previousCount){
        frame.item = cast<u32>(previousCount);
        this.m_scope.value().m_integerEdits.push_back(frame);
    }
    return result;
}

NumericEditBoxResult Builder::floatEdit(in StringView stableKey, mut FloatEditModel model, mut EditBoxState state, in FloatEditOptions options){
    NumericEditBoxResult result;
    if(this.declarationBlocked() || !ValidateFloatBounds(options.bounds)){
        this.m_context.fail();
        return result;
    }
    result.numeric.valid = true;
    BuilderFloatEditFrame frame;
    frame.model = Optional<mut FloatEditModel>(model);
    frame.state = Optional<mut EditBoxState>(state);
    frame.revision = model.revision();
    NumericEditActions actions(options.bounds, this.m_context, model, result.numeric, frame.revision);
    const usize previousCount = this.m_scope.value().m_items.size();
    result.edit = this.declareEditBox(stableKey, options.edit, model.lendDraft(), state, Optional<mut IEditActionSink>(actions), Optional<mut BuilderIntegerEditFrame>(), Optional<mut BuilderFloatEditFrame>(frame));
    result.numeric.valid = result.numeric.valid && result.edit.valid;
    if(result.edit.valid && this.m_scope.value().m_items.size() > previousCount){
        frame.item = cast<u32>(previousCount);
        this.m_scope.value().m_floatEdits.push_back(frame);
    }
    return result;
}

b8 Builder::numericEditMatches(in BuilderItem item)const{
    if(item.integerEdit != s_LayoutNoParent){
        if(item.integerEdit >= this.m_scope.value().m_integerEdits.size() || !this.numericEditFrameMatches(this.m_scope.value().m_integerEdits[item.integerEdit]))
            return false;
    }
    if(item.floatEdit != s_LayoutNoParent){
        if(item.floatEdit >= this.m_scope.value().m_floatEdits.size() || !this.numericEditFrameMatches(this.m_scope.value().m_floatEdits[item.floatEdit]))
            return false;
    }
    return true;
}

b8 Builder::numericStateAvailable(in EditBoxState state)const{
    for(usize index = 0u; index <= this.m_popupFrameCount; ++index){
        in BuilderScopeFrame scope = this.readPopupFrameAt(index);
        for(in auto frame : scope.m_integerEdits){
            if(frame.state.has_value() && SameAddress(frame.state.value(), state))
                return false;
        }
        for(in auto frame : scope.m_floatEdits){
            if(frame.state.has_value() && SameAddress(frame.state.value(), state))
                return false;
        }
    }
    return true;
}


