#include <impl/assets_ui_skin/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{
#include <impl/ecs_ui/toolkit/images/image_source.h>
namespace NWB::Impl{
class UiSkin;
class Texture;
}
namespace NWB::Impl::Ui{
template<typename TUiSkin, typename TTexture>
class SkinBindingRecord;
using SkinBinding = SkinBindingRecord<NWB::Impl::UiSkin, NWB::Impl::Texture>;
}
}


class Point{
    public f32 x = 0.0f;
    public f32 y = 0.0f;
}

class Rect{
    public f32 x = 0.0f;
    public f32 y = 0.0f;
    public f32 width = 0.0f;
    public f32 height = 0.0f;
}

class Insets{
    public f32 left = 0.0f;
    public f32 top = 0.0f;
    public f32 right = 0.0f;
    public f32 bottom = 0.0f;
}

// Input colors use linear RGB and straight alpha; frozen vertices use premultiplied alpha.
class Color{
    public f32 r = 1.0f;
    public f32 g = 1.0f;
    public f32 b = 1.0f;
    public f32 a = 1.0f;
}

[serialize]
class Vertex{
    public Point position;
    public Point texCoord;
    public Color color;
}

class DisplayMetrics{
    public f32 logicalWidth = 0.0f;
    public f32 logicalHeight = 0.0f;
    public f32 pixelScaleX = 1.0f;
    public f32 pixelScaleY = 1.0f;
}

enum<u8> PaintMaterial{
    Solid,
    Skin,
    Glyph,
    SdfGlyph,
    Image,
}

class DrawCommand{
    public Rect clip;
    public u32 firstIndex = 0u;
    public u32 indexCount = 0u;
    public u32 glyphPageIndex = 0xffffffffu;
    public u32 sdfPageIndex = 0xffffffffu;
    public u32 sdfChannel = 0u;
    // Base paint is layer zero; higher layers render later without changing owned index or image bindings.
    public u32 layer = 0u;
    public u32 textureImageIndex = 0xffffffffu;
    public PaintMaterial material = PaintMaterial::Solid;
}

// Share of free space placed before an item to center it, or the midpoint of an extent.
const f32 s_RectCenterFraction = 0.5f;
const f64 s_RectCenterFractionF64 = 0.5;
const f32 s_UiMaxFloat = 3.40282346638528859812e+38f;
const f64 s_UiMaxFloatF64 = cast<f64>(s_UiMaxFloat);

enum<u8> UiRectPrecision{
    RoundedEndpoints,
    BoundedEndpoints,
    PreciseExtents,
    EmptyPaint,
}

const usize s_PaintMaxImages = 64u;
const usize s_PaintMaxOverlayDepth = 16u;
const usize s_PaintDefaultClipDepth = 8u;

const u32 s_PaintQuadVertexCount = 4u;
const u32 s_PaintQuadIndexCount = 6u;
const u32 s_PaintNineSliceAxisCells = 3u;

// Typed references identify assets; this copy captures atlas metadata, not loaded/GPU resource ownership.
class SkinBindingRecord<TUiSkin, TTexture>{
    public AssetRef<TUiSkin> skin;
    public AssetRef<TTexture> texture;
    public u64 generation = 0u;
    public u32 atlasWidth = 0u;
    public u32 atlasHeight = 0u;
    public f32 referenceDensity = 1.0f;
}

class PaintOverlayFrame{
    public usize clipDepth = 0u;
    public u32 layer = 0u;
}

Color ResolveUiSkinColor(in UiSkinPalette palette, in UiSkinColorRole role){
    const UiSkinColor value = palette.colors[cast<usize>(role)];
    Color out;
    out.r = value.r;
    out.g = value.g;
    out.b = value.b;
    out.a = value.a;
    return out;
}

b8 SameTextureImageKey(in ImageSource first, in ImageSource second){
    return first.identity() == second.identity() && first.generation() == second.generation();
}

b8 ValidDrawCommandGlyphBinding(in DrawCommand command, in usize pageCount){
    if(command.material == PaintMaterial::Glyph)
        return cast<usize>(command.glyphPageIndex) < pageCount && command.sdfPageIndex == 0xffffffffu && command.sdfChannel == 0u;
    if(command.material == PaintMaterial::SdfGlyph)
        return command.glyphPageIndex == 0xffffffffu;
    if(command.material == PaintMaterial::Solid || command.material == PaintMaterial::Skin || command.material == PaintMaterial::Image)
        return command.glyphPageIndex == 0xffffffffu && command.sdfPageIndex == 0xffffffffu && command.sdfChannel == 0u;
    return false;
}

b8 ValidDrawCommandImageBinding(in DrawCommand command, in usize imageCount){
    if(command.material == PaintMaterial::Image)
        return cast<usize>(command.textureImageIndex) < imageCount && command.glyphPageIndex == 0xffffffffu && command.sdfPageIndex == 0xffffffffu && command.sdfChannel == 0u;
    return command.textureImageIndex == 0xffffffffu;
}

b8 ValidDrawCommandSdfBinding(in DrawCommand command, in usize pageCount, in u32 pageChannelCount){
    if(command.material == PaintMaterial::SdfGlyph)
        return cast<usize>(command.sdfPageIndex) < pageCount && command.sdfChannel < pageChannelCount;
    return true;
}

b8 ValidSnapshotImageCounts(in usize glyphPageCount, in usize sdfPageCount, in usize textureImageCount){
    return
        glyphPageCount <= s_PaintMaxImages
        && sdfPageCount <= s_PaintMaxImages
        && textureImageCount <= s_PaintMaxImages
        && glyphPageCount + sdfPageCount + textureImageCount <= s_PaintMaxImages
    ;
}

b8 IsValidPaintUvRect(in Rect uv){
    return
        isFinite(uv.x) && isFinite(uv.y) && isFinite(uv.width) && isFinite(uv.height)
        && uv.x >= 0.0f && uv.y >= 0.0f && uv.width > 0.0f && uv.height > 0.0f
        && uv.x + uv.width <= 1.0f && uv.y + uv.height <= 1.0f
    ;
}

Insets MaxUiPadding(in Insets lhs, in Insets rhs){
    const f32x4 first(lhs.left, lhs.top, lhs.right, lhs.bottom);
    const f32x4 second(rhs.left, rhs.top, rhs.right, rhs.bottom);
    const f32x4 maximum = max(first, second);
    Insets out;
    out.left = maximum.x;
    out.top = maximum.y;
    out.right = maximum.z;
    out.bottom = maximum.w;
    return out;
}

Insets MaxUiPadding(in Insets lhs, in UiSkinInsets rhs){
    Insets converted;
    converted.left = rhs.left;
    converted.top = rhs.top;
    converted.right = rhs.right;
    converted.bottom = rhs.bottom;
    return MaxUiPadding(lhs, converted);
}


