b8 ExtractPhysicsWorldConfigComponentDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    const Expected<PhysicsWorldConfigDepEntry> entryRes = ReadCookDependencyEntry<PhysicsWorldConfigDepEntry>(
        context,
        s_PhysicsWorldConfigComponentDiagnosticPrefix,
        ParsePhysicsWorldConfigDepEntry
    );
    if(!entryRes.has_value())
        return false;
    in AssetRef<CollisionLayerMatrixAsset> matrixAsset = entryRes.value().collisionLayerMatrixAsset;
    if(matrixAsset.valid() && !collector.addAssetDependency(matrixAsset.name(), CollisionLayerMatrixAsset::AssetTypeName()))
        return false;
    return true;
}

