void VerifySimdZeroAdditionPreservesSignedZeroAndSignalingNan(){
    const auto originalEnvironment = HoldFloatingPointExceptions();
    ASSERT_TRUE(originalEnvironment);
    FloatingPointEnvironmentGuard restoreEnvironment(originalEnvironment.value());
    const Array<u32, 2u> values32(0x80000000u, 0x7f800123u);
    const Array<u64, 2u> values64(0x8000000000000000ull, 0x7ff0000000000123ull);
    for(in i32 rounding : s_FloatingPointRoundingModes){
        ASSERT_TRUE(SetFloatingPointRoundingMode(rounding));
        for(usize i = 0u; i < 2u; ++i){
            const VectorSingle value32 = VectorSetInt(ObserveValue<u32>(values32[i]), ObserveValue<u32>(values32[i]), ObserveValue<u32>(values32[i]), ObserveValue<u32>(values32[i]));
            const VectorDouble value64 = VectorDoubleSetInt(ObserveValue<u64>(values64[i]), ObserveValue<u64>(values64[i]), ObserveValue<u64>(values64[i]), ObserveValue<u64>(values64[i]));
            for(u32 left = 0u; left < 2u; ++left){
                ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT));
                VectorSingle expected32 = VectorZero();
                if(left != 0u)
                    expected32 = VectorAdd(VectorZero(), value32);
                else
                    expected32 = VectorAdd(value32, VectorZero());
                const i32 expectedFlags32 = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT));
                VectorSingle actual32 = VectorZero();
                if(left != 0u)
                    actual32 = AddZeroLeftSingle(value32);
                else
                    actual32 = AddZeroRightSingle(value32);
                const i32 actualFlags32 = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                EXPECT_EQ(VectorGetIntX(actual32), VectorGetIntX(expected32));
                EXPECT_EQ(actualFlags32, expectedFlags32);

                ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT));
                VectorDouble expected64 = VectorDoubleZero();
                if(left != 0u)
                    expected64 = VectorDoubleAdd(VectorDoubleZero(), value64);
                else
                    expected64 = VectorDoubleAdd(value64, VectorDoubleZero());
                const i32 expectedFlags64 = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT));
                VectorDouble actual64 = VectorDoubleZero();
                if(left != 0u)
                    actual64 = AddZeroLeftDouble(value64);
                else
                    actual64 = AddZeroRightDouble(value64);
                const i32 actualFlags64 = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                EXPECT_EQ(VectorDoubleGetIntX(actual64), VectorDoubleGetIntX(expected64));
                EXPECT_EQ(actualFlags64, expectedFlags64);
            }
        }
    }
}
NWB_ADHD_GTEST(AdhdCompiler, SimdZeroAdditionPreservesSignedZeroAndSignalingNan, VerifySimdZeroAdditionPreservesSignedZeroAndSignalingNan)

void VerifySimdNegatedZeroPreservesSignAndAdditionFlags(){
    const auto originalEnvironment = HoldFloatingPointExceptions();
    ASSERT_TRUE(originalEnvironment);
    FloatingPointEnvironmentGuard restoreEnvironment(originalEnvironment.value());
    EXPECT_EQ(VectorGetIntX(NegateZeroSingle()), 0x80000000u);
    EXPECT_EQ(VectorGetIntX(NegateNegativeZeroSingle()), 0u);
    EXPECT_EQ(VectorGetIntX(DoubleNegateZeroSingle()), 0u);
    EXPECT_EQ(VectorGetIntX(TripleNegateZeroSingle()), 0x80000000u);
    EXPECT_EQ(VectorDoubleGetIntX(NegateZeroDouble()), 0x8000000000000000ull);
    EXPECT_EQ(VectorDoubleGetIntX(NegateNegativeZeroDouble()), 0ull);
    EXPECT_EQ(VectorDoubleGetIntX(DoubleNegateZeroDouble()), 0ull);
    EXPECT_EQ(VectorDoubleGetIntX(TripleNegateZeroDouble()), 0x8000000000000000ull);
    const Array<u32, 3u> values32(0u, 0x80000000u, 0x7f800123u);
    const Array<u64, 3u> values64(0ull, 0x8000000000000000ull, 0x7ff0000000000123ull);
    for(in i32 rounding : s_FloatingPointRoundingModes){
        ASSERT_TRUE(SetFloatingPointRoundingMode(rounding));
        for(usize i = 0u; i < 3u; ++i){
            const VectorSingle value32 = VectorSetInt(ObserveValue<u32>(values32[i]), ObserveValue<u32>(values32[i]), ObserveValue<u32>(values32[i]), ObserveValue<u32>(values32[i]));
            const VectorDouble value64 = VectorDoubleSetInt(ObserveValue<u64>(values64[i]), ObserveValue<u64>(values64[i]), ObserveValue<u64>(values64[i]), ObserveValue<u64>(values64[i]));
            const VectorSingle zero32 = VectorNegate(VectorZero());
            const VectorDouble zero64 = VectorDoubleNegate(VectorDoubleZero());
            for(u32 left = 0u; left < 2u; ++left){
                ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT));
                VectorSingle expected32 = VectorZero();
                if(left != 0u)
                    expected32 = VectorAdd(zero32, value32);
                else
                    expected32 = VectorAdd(value32, zero32);
                const i32 expectedFlags32 = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT));
                VectorSingle actual32 = VectorZero();
                if(left != 0u)
                    actual32 = AddNegativeZeroLeftSingle(value32);
                else
                    actual32 = AddNegativeZeroRightSingle(value32);
                const i32 actualFlags32 = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                EXPECT_EQ(VectorGetIntX(actual32), VectorGetIntX(expected32));
                EXPECT_EQ(actualFlags32, expectedFlags32);

                ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT));
                VectorDouble expected64 = VectorDoubleZero();
                if(left != 0u)
                    expected64 = VectorDoubleAdd(zero64, value64);
                else
                    expected64 = VectorDoubleAdd(value64, zero64);
                const i32 expectedFlags64 = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT));
                VectorDouble actual64 = VectorDoubleZero();
                if(left != 0u)
                    actual64 = AddNegativeZeroLeftDouble(value64);
                else
                    actual64 = AddNegativeZeroRightDouble(value64);
                const i32 actualFlags64 = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                EXPECT_EQ(VectorDoubleGetIntX(actual64), VectorDoubleGetIntX(expected64));
                EXPECT_EQ(actualFlags64, expectedFlags64);
            }
        }
    }
}
