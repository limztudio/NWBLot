NWB_ADHD_GTEST(MeshSolidTopology, BrokenWindingNonManifoldAndDegenerateFacesInvalidateTheirWholeComponent, VerifyMeshSolidTopology_BrokenWindingNonManifoldAndDegenerateFacesInvalidateTheirWholeComponent)
NWB_ADHD_GTEST(MeshSolidTopology, CoincidentIndependentPositionsDoNotRepairAnOpenSeam, VerifyMeshSolidTopology_CoincidentIndependentPositionsDoNotRepairAnOpenSeam)
NWB_ADHD_GTEST(MeshSolidTopology, MembershipCrossesWordBoundariesWithoutSettingTailPadding, VerifyMeshSolidTopology_MembershipCrossesWordBoundariesWithoutSettingTailPadding)
