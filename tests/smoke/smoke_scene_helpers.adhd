[[nodiscard]] FOUNDATION_INLINE b8 SetSmokeMaterialHalf4(
    const Core::ECS::EntityID entity,
    const Name& materialInterface,
    const AStringView parameterPath,
    const Float4& value,
    Core::ECS::World& world
){
    return Impl::SetMaterialMutableHalf4(world, entity, materialInterface, parameterPath, value);
}

[[nodiscard]] FOUNDATION_INLINE b8 SetSmokeSurfaceRoughnessF0(
    const Core::ECS::EntityID entity,
    const Name& materialInterface,
    const AStringView f0Path,
    const AStringView roughnessPath,
    const f32 f0,
    const f32 roughness,
    Core::ECS::World& world
){
    const Half4U packedF0 = MakeHalf4U(f0, f0, f0, 0.0f);
    const Half packedRoughness = ConvertFloatToHalf(roughness);
    return Impl::SetMaterialMutableParameter(
        world,
        entity,
        materialInterface,
        f0Path,
        Impl::MaterialLayoutFieldType::f16x3,
        Impl::PackMaterialInstanceBytes(Span<const Half>(packedF0.raw, 3u))
    ) && Impl::SetMaterialMutableParameter(
        world,
        entity,
        materialInterface,
        roughnessPath,
        Impl::MaterialLayoutFieldType::f16,
        Impl::PackMaterialInstanceValue(packedRoughness)
    );
}

[[nodiscard]] FOUNDATION_INLINE b8 SetSmokeOpticalMaterialParameters(
    const Core::ECS::EntityID entity,
    const Name& materialInterface,
    const f32 ior,
    const Float4& transmission,
    Core::ECS::World& world
){
    const Half packedIor = ConvertFloatToHalf(ior);
    const Half4U packedTransmission = MakeHalf4U(transmission.x, transmission.y, transmission.z, 0.0f);
    return Impl::SetMaterialMutableParameter(
        world,
        entity,
        materialInterface,
        "runtime.ior",
        Impl::MaterialLayoutFieldType::f16,
        Impl::PackMaterialInstanceValue(packedIor)
    ) && Impl::SetMaterialMutableParameter(
        world,
        entity,
        materialInterface,
        "runtime.unit_transmission",
        Impl::MaterialLayoutFieldType::f16x3,
        Impl::PackMaterialInstanceBytes(Span<const Half>(packedTransmission.raw, 3u))
    );
}

