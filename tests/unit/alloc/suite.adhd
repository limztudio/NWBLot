        EXPECT_EQ(zeroAllocation.address() % s_MaxAlignment, 0u);
        zeroAllocation[0u] = 47u;

        RawAllocation grown = ResizeCBytes(testArena, zeroAllocation, 37u);
        ASSERT_NE(grown, RawAllocation());
        EXPECT_EQ(grown.address() % s_MaxAlignment, 0u);
        EXPECT_EQ(grown[0u], 47u);
        FreeCBytes(testArena, grown);
    }

    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
}

void VerifyScratchArenaReuse_ReverseFreesCrossChunkBoundariesAndReuseAllEmptyChunks(){
    ScratchStorage testArena(s_AllocCaseScratchReuseCrossChunk, 256u);
    Array<AllocationRequest, 3> requests = Array<AllocationRequest, 3>();
    requests[0u] = MakeAllocationRequest(8u, 192u);
    requests[1u] = MakeAllocationRequest(8u, 128u);
    requests[2u] = MakeAllocationRequest(8u, 768u);
    ASSERT_TRUE(RunAllocationBatch(requests, testArena));
    const ArenaMemoryStats warm = testArena.memoryStats();
    EXPECT_EQ(warm.usedBytes, 0u);
    EXPECT_EQ(warm.allocationCount, 3u);
    EXPECT_EQ(warm.deallocationCount, 3u);
    EXPECT_EQ(warm.peakUsedBytes, 1088u);
    for(usize iteration = 0u; iteration < 32u; ++iteration){
        ASSERT_TRUE(RunAllocationBatch(requests, testArena));
        const ArenaMemoryStats current = testArena.memoryStats();
        EXPECT_EQ(current.usedBytes, 0u);
        EXPECT_EQ(current.reservedBytes, warm.reservedBytes);
        EXPECT_EQ(current.allocationCount, cast<u64>((iteration + 2u) * 3u));
        EXPECT_EQ(current.deallocationCount, current.allocationCount);
    }
}

void VerifyScratchArenaReuse_ColdAlignmentBucketsAllocateOnceAndReleaseAllBacking(){
    Array<usize, 9> alignments = Array<usize, 9>();
    alignments[0u] = 1u;
    alignments[1u] = 2u;
    alignments[2u] = 4u;
    alignments[3u] = 8u;
    alignments[4u] = 16u;
    alignments[5u] = 32u;
    alignments[6u] = 64u;
    alignments[7u] = 128u;
    alignments[8u] = 256u;
    ArenaMemoryStats before = ArenaMemoryStats();
    ArenaMemoryStats live = ArenaMemoryStats();
    b8 valid = true;
    usize expectedReserved = 0u;
    ArenaMemoryStats released = ArenaMemoryStats();
    {
        ScratchStorage testArena(s_AllocCaseScratchReuseColdAlignmentBuckets, 257u);
        Array<RawAllocation, 9> allocations;
        before = HeapBackingMemoryStats();
        for(usize index = 0u; index < alignments.size(); ++index){
            const usize alignment = alignments[index];
            const usize bytes = alignment + 3u;
            allocations[index] = AllocateBytes(testArena, alignment, bytes);
            if(allocations[index].address() == 0u){
                valid = false;
                continue;
            }
            valid &= allocations[index].address() % alignment == 0u;
            allocations[index][0u] = cast<u8>(index + 1u);
            allocations[index][bytes - 1u] = cast<u8>(index + 19u);
            expectedReserved += Alignment(alignment, 257u);
        }
        live = HeapBackingMemoryStats();
        valid &= testArena.memoryStats().reservedBytes == expectedReserved;
        usize index = alignments.size();
        while(index != 0u){
            --index;
            if(allocations[index].address() == 0u)
                continue;
            const usize alignment = alignments[index];
            const usize bytes = alignment + 3u;
            valid &= allocations[index][0u] == cast<u8>(index + 1u);
            valid &= allocations[index][bytes - 1u] == cast<u8>(index + 19u);
            FreeBytes(testArena, allocations[index], alignment, bytes);
        }
        released = testArena.memoryStats();
    }
    const ArenaMemoryStats after = HeapBackingMemoryStats();
    EXPECT_TRUE(valid);
    EXPECT_EQ(live.allocationCount - before.allocationCount, alignments.size());
    EXPECT_EQ(after.deallocationCount - before.deallocationCount, alignments.size());
    EXPECT_EQ(after.usedBytes, before.usedBytes);
    EXPECT_EQ(released.usedBytes, 0u);
    EXPECT_EQ(released.reservedBytes, expectedReserved);
}

[cpp_unwind]
void VerifyScratchArenaReuse_InvalidRuntimeAlignmentDoesNotConsumeExistingBucket(){
    ScratchStorage testArena(s_AllocCaseScratchReuseInvalidAlignment, 256u);
    {
        RawAllocation sentinel = AllocateBytes(testArena, 2u, 32u);
        ASSERT_NE(sentinel, RawAllocation());
        sentinel[0u] = cast<u8>(s_AllocCaseScratchReuseSentinelByte);
        const ArenaMemoryStats before = testArena.memoryStats();
        if(s_DebugAllocator){
            EXPECT_DEATH_IF_SUPPORTED(EXPECT_EQ(AllocateBytes(testArena, 3u, 32u), RawAllocation()), "");
            EXPECT_DEATH_IF_SUPPORTED(EXPECT_EQ(ResizeBytes(testArena, sentinel, 3u, 64u), RawAllocation()), "");
            EXPECT_DEATH_IF_SUPPORTED(FreeBytes(testArena, sentinel, 3u, 32u), "");
        }
        else{
            EXPECT_EQ(AllocateBytes(testArena, 3u, 32u), RawAllocation());
            EXPECT_EQ(ResizeBytes(testArena, sentinel, 3u, 64u), RawAllocation());
            FreeBytes(testArena, sentinel, 3u, 32u);
        }

        EXPECT_EQ(sentinel[0u], cast<u8>(s_AllocCaseScratchReuseSentinelByte));
        EXPECT_EQ(testArena.memoryStats().usedBytes, before.usedBytes);
        EXPECT_EQ(testArena.memoryStats().allocationCount, before.allocationCount);
        EXPECT_EQ(testArena.memoryStats().reallocationCount, before.reallocationCount);
        EXPECT_EQ(testArena.memoryStats().deallocationCount, before.deallocationCount);
        EXPECT_TRUE(ThrowsException<AllocationSizeException>(lambda[mut testArena]() -> void{ EXPECT_EQ(AllocateBytes(testArena, 256u, usize.max), RawAllocation()); }));
        EXPECT_EQ(testArena.memoryStats().usedBytes, before.usedBytes);
        FreeBytes(testArena, sentinel, 2u, 32u);
    }
    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
}

void VerifyScratchArenaReuse_AlignmentBucketsKeepIndependentLifoStacksAndCallerSentinels(){
    ScratchStorage testArena(s_AllocCaseScratchReuseAlignments, 256u);
    Array<AllocationRequest, 8> requests = Array<AllocationRequest, 8>();
    requests[0u] = MakeAllocationRequest(1u, 256u);
    requests[1u] = MakeAllocationRequest(8u, 256u);
    requests[2u] = MakeAllocationRequest(64u, 256u);
    requests[3u] = MakeAllocationRequest(256u, 256u);
    requests[4u] = MakeAllocationRequest(1u, 1536u);
    requests[5u] = MakeAllocationRequest(8u, 1536u);
    requests[6u] = MakeAllocationRequest(64u, 1536u);
    requests[7u] = MakeAllocationRequest(256u, 1536u);

    {
        const Array<usize, 4u> s_Alignments(1u, 8u, 64u, 256u);
        Array<RawAllocation, 4u> sentinels;
        for(usize index = 0u; index < s_Alignments.size(); ++index){
            sentinels[index] = AllocateBytes(testArena, s_Alignments[index], 64u);
            ASSERT_NE(sentinels[index], RawAllocation());
            sentinels[index][0u] = cast<u8>(index + s_AllocCaseScratchReuseSentinelByte);
            sentinels[index][63u] = cast<u8>(index + 83u);
        }
        const ArenaMemoryStats retained = testArena.memoryStats();
        for(usize iteration = 0u; iteration < 16u; ++iteration){
            ASSERT_TRUE(RunAllocationBatch(requests, testArena));
            EXPECT_EQ(testArena.memoryStats().usedBytes, retained.usedBytes);
            for(usize index = 0u; index < s_Alignments.size(); ++index){
                EXPECT_EQ(sentinels[index][0u], cast<u8>(index + s_AllocCaseScratchReuseSentinelByte));
                EXPECT_EQ(sentinels[index][63u], cast<u8>(index + 83u));
            }
        }
        for(usize index = 0u; index < s_Alignments.size(); ++index)
            FreeBytes(testArena, sentinels[index], s_Alignments[index], 64u);
    }

    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(testArena.memoryStats().allocationCount, testArena.memoryStats().deallocationCount);
}

void VerifyScratchArenaReuse_OutOfOrderFreeRemainsANoopUntilThatAllocationBecomesTop(){
    ScratchStorage testArena(s_AllocCaseScratchReuseOutOfOrder, 256u);
    {
        RawAllocation first = AllocateBytes(testArena, 8u, s_AllocCaseScratchReuseBlockBytes);
        RawAllocation second = AllocateBytes(testArena, 8u, s_AllocCaseScratchReuseBlockBytes);
        RawAllocation third = AllocateBytes(testArena, 8u, 192u);
        ASSERT_NE(first, RawAllocation());
        ASSERT_NE(second, RawAllocation());
        ASSERT_NE(third, RawAllocation());
        first[0u] = cast<u8>(s_AllocCaseScratchReuseFirstSentinel);
        first[95u] = 29u;
        const ArenaMemoryStats before = testArena.memoryStats();
        FreeBytes(testArena, first, 8u, s_AllocCaseScratchReuseBlockBytes);
        EXPECT_EQ(testArena.memoryStats().usedBytes, before.usedBytes);
        EXPECT_EQ(testArena.memoryStats().deallocationCount, before.deallocationCount);
        FreeBytes(testArena, third, 8u, 192u);
        FreeBytes(testArena, second, 8u, s_AllocCaseScratchReuseBlockBytes);
        EXPECT_EQ(testArena.memoryStats().usedBytes, s_AllocCaseScratchReuseBlockBytes);
        EXPECT_EQ(first[0u], cast<u8>(s_AllocCaseScratchReuseFirstSentinel));
        EXPECT_EQ(first[95u], 29u);
        FreeBytes(testArena, first, 8u, s_AllocCaseScratchReuseBlockBytes);
    }
    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(testArena.memoryStats().deallocationCount, 3u);
}

void VerifyScratchArenaReuse_RelocatedAndZeroSizedTopReallocationsExposeThePreviousLiveChunk(){
    ScratchStorage testArena(s_AllocCaseScratchReuseRelocation, 256u);
    {
        RawAllocation sentinel = AllocateBytes(testArena, 8u, 64u);
        RawAllocation allocation = AllocateBytes(testArena, 8u, 128u);
        ASSERT_NE(sentinel, RawAllocation());
        ASSERT_NE(allocation, RawAllocation());
        sentinel[0u] = 41u;
        for(usize index = 0u; index < 128u; ++index)
            allocation[index] = cast<u8>(index);
        RawAllocation grown = ResizeBytes(testArena, allocation, 8u, 1024u);
        ASSERT_NE(grown, RawAllocation());
        EXPECT_NE(grown, allocation);
        for(usize index = 0u; index < 128u; ++index)
            EXPECT_EQ(grown[index], cast<u8>(index));
        EXPECT_EQ(testArena.memoryStats().usedBytes, 1088u);
        EXPECT_EQ(testArena.memoryStats().allocationCount, 3u);
        EXPECT_EQ(testArena.memoryStats().deallocationCount, 1u);
        EXPECT_EQ(ResizeBytes(testArena, grown, 8u, 256u), grown);
        EXPECT_EQ(testArena.memoryStats().reallocationCount, 1u);
        EXPECT_EQ(testArena.memoryStats().usedBytes, 320u);
        EXPECT_EQ(ResizeBytes(testArena, grown, 8u, 0u), grown);
        EXPECT_EQ(testArena.memoryStats().usedBytes, 64u);
        EXPECT_EQ(sentinel[0u], 41u);
        FreeBytes(testArena, sentinel, 8u, 64u);
        EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
        EXPECT_EQ(testArena.memoryStats().deallocationCount, 3u);

        RawAllocation sole = AllocateBytes(testArena, 8u, 128u);
        ASSERT_NE(sole, RawAllocation());
        sole[0u] = 97u;
        RawAllocation moved = ResizeBytes(testArena, sole, 8u, 8192u);
        ASSERT_NE(moved, RawAllocation());
        EXPECT_EQ(moved[0u], 97u);
        FreeBytes(testArena, moved, 8u, 8192u);
    }
    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
    Array<AllocationRequest, 2> afterRelocation = Array<AllocationRequest, 2>();
    afterRelocation[0u] = MakeAllocationRequest(8u, 128u);
    afterRelocation[1u] = MakeAllocationRequest(8u, 8192u);
    ASSERT_TRUE(RunAllocationBatch(afterRelocation, testArena));
    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
}

void VerifyScratchArenaReuse_ZeroByteOperationsRemainValidBeforeAndAfterCachingTheLastChunk(){
    ScratchStorage testArena(s_AllocCaseScratchReuseZeroBytes, 256u);
    {
        EXPECT_EQ(AllocateTypedBytes(testArena, 0u), RawAllocation());
        EXPECT_EQ(testArena.memoryStats().reservedBytes, 0u);
        RawAllocation zero = AllocateBytes(testArena, 8u, 0u);
        ASSERT_NE(zero, RawAllocation());
        FreeBytes(testArena, zero, 8u, 0u);
        EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
        EXPECT_EQ(testArena.memoryStats().allocationCount, 0u);
        RawAllocation allocation = AllocateBytes(testArena, 8u, 128u);
        ASSERT_NE(allocation, RawAllocation());
        allocation[0u] = 43u;
        RawAllocation zeroAtTop = AllocateBytes(testArena, 8u, 0u);
        ASSERT_NE(zeroAtTop, RawAllocation());
        FreeBytes(testArena, zeroAtTop, 8u, 0u);
        EXPECT_EQ(allocation[0u], 43u);
        EXPECT_EQ(testArena.memoryStats().usedBytes, 128u);
        FreeBytes(testArena, allocation, 8u, 128u);
        FreeBytes(testArena, zeroAtTop, 8u, 0u);
        const ArenaMemoryStats cached = testArena.memoryStats();
        EXPECT_EQ(cached.usedBytes, 0u);
        RawAllocation reusedZero = AllocateBytes(testArena, 8u, 0u);
        ASSERT_NE(reusedZero, RawAllocation());
        FreeBytes(testArena, reusedZero, 8u, 0u);
        EXPECT_EQ(testArena.memoryStats().reservedBytes, cached.reservedBytes);
        EXPECT_EQ(testArena.memoryStats().allocationCount, cached.allocationCount);
        EXPECT_EQ(testArena.memoryStats().deallocationCount, cached.deallocationCount);
        RawAllocation resized = AllocateBytes(testArena, 8u, 64u);
        ASSERT_NE(resized, RawAllocation());
        EXPECT_EQ(ResizeBytes(testArena, resized, 8u, 0u), resized);
        FreeBytes(testArena, resized, 8u, 0u);
    }
    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(testArena.memoryStats().allocationCount, 2u);
    EXPECT_EQ(testArena.memoryStats().deallocationCount, 2u);
}

void VerifyScratchArenaReuse_ZeroInitialCapacityNeedsPositiveBackingBeforeRawZeroAllocation(){
    ScratchStorage testArena(s_AllocCaseScratchReuseZeroInitialCapacity, 0u);
    ArenaMemoryStats cached = ArenaMemoryStats();
    {
        EXPECT_EQ(AllocateBytes(testArena, 8u, 0u), RawAllocation());
        EXPECT_EQ(testArena.memoryStats().reservedBytes, 0u);
        EXPECT_EQ(testArena.memoryStats().allocationCount, 0u);
        RawAllocation allocation = AllocateBytes(testArena, 8u, 9u);
        ASSERT_NE(allocation, RawAllocation());
        FreeBytes(testArena, allocation, 8u, 9u);
        cached = testArena.memoryStats();
        EXPECT_NE(AllocateBytes(testArena, 8u, 0u), RawAllocation());
    }
    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(testArena.memoryStats().reservedBytes, cached.reservedBytes);
    EXPECT_EQ(testArena.memoryStats().allocationCount, cached.allocationCount);
}

void VerifyScratchArenaReuse_RelocationReusesCachedBackingAndUnlinksAnEmptiedFormerTop(){
    const usize cachedBytes = 1024u;
    ScratchStorage testArena(s_AllocCaseScratchReuseCachedRelocation, 256u);
    {
        RawAllocation sentinel = AllocateBytes(testArena, 8u, 64u);
        RawAllocation allocation = AllocateBytes(testArena, 8u, 128u);
        RawAllocation cached = AllocateBytes(testArena, 8u, cachedBytes);
        ASSERT_NE(sentinel, RawAllocation());
        ASSERT_NE(allocation, RawAllocation());
        ASSERT_NE(cached, RawAllocation());
        sentinel[0u] = 79u;
        for(usize index = 0u; index < 128u; ++index)
            allocation[index] = cast<u8>(index + 11u);
        FreeBytes(testArena, cached, 8u, cachedBytes);
        const ArenaMemoryStats beforeHeap = HeapBackingMemoryStats();
        RawAllocation relocated = ResizeBytes(testArena, allocation, 8u, cachedBytes);
        const ArenaMemoryStats afterHeap = HeapBackingMemoryStats();
        ASSERT_NE(relocated, RawAllocation());
        EXPECT_EQ(relocated, cached);
        EXPECT_EQ(afterHeap.allocationCount, beforeHeap.allocationCount);
        EXPECT_EQ(afterHeap.deallocationCount, beforeHeap.deallocationCount);
        for(usize index = 0u; index < 128u; ++index)
            EXPECT_EQ(relocated[index], cast<u8>(index + 11u));
        FreeBytes(testArena, relocated, 8u, cachedBytes);
        EXPECT_EQ(testArena.memoryStats().usedBytes, 64u);
        EXPECT_EQ(sentinel[0u], 79u);
        FreeBytes(testArena, sentinel, 8u, 64u);

        allocation = AllocateBytes(testArena, 8u, 128u);
        ASSERT_NE(allocation, RawAllocation());
        allocation[0u] = 101u;
        relocated = ResizeBytes(testArena, allocation, 8u, cachedBytes);
        ASSERT_NE(relocated, RawAllocation());
        EXPECT_EQ(relocated, cached);
        EXPECT_EQ(relocated[0u], 101u);
        FreeBytes(testArena, relocated, 8u, cachedBytes);
    }
    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
    Array<AllocationRequest, 2> requests = Array<AllocationRequest, 2>();
    requests[0u] = MakeAllocationRequest(8u, 128u);
    requests[1u] = MakeAllocationRequest(8u, 1024u);
    ASSERT_TRUE(RunAllocationBatch(requests, testArena));
    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(testArena.memoryStats().allocationCount, testArena.memoryStats().deallocationCount);
}

void VerifyScratchArenaReuse_FailedRelocationPreservesLiveAllocationsCachedChunksAndCounters(){
    const usize cachedBytes = 1536u;
    ScratchStorage testArena(s_AllocCaseScratchReuseFailedRelocation, 256u);
    {
        RawAllocation sentinel = AllocateBytes(testArena, 1u, 64u);
        RawAllocation allocation = AllocateBytes(testArena, 1u, 128u);
        RawAllocation cached = AllocateBytes(testArena, 1u, cachedBytes);
        ASSERT_NE(sentinel, RawAllocation());
        ASSERT_NE(allocation, RawAllocation());
        ASSERT_NE(cached, RawAllocation());
        sentinel[0u] = 131u;
        allocation[0u] = 139u;
        allocation[127u] = 149u;
        FreeBytes(testArena, cached, 1u, cachedBytes);
        const ArenaMemoryStats before = testArena.memoryStats();
        EXPECT_EQ(ResizeBytes(testArena, allocation, 1u, usize.max), RawAllocation());
        EXPECT_EQ(AllocateBytes(testArena, 256u, usize.max - 255u), RawAllocation());
        const ArenaMemoryStats after = testArena.memoryStats();
        EXPECT_EQ(after.usedBytes, before.usedBytes);
        EXPECT_EQ(after.reservedBytes, before.reservedBytes);
        EXPECT_EQ(after.peakUsedBytes, before.peakUsedBytes);
        EXPECT_EQ(after.allocationCount, before.allocationCount);
        EXPECT_EQ(after.reallocationCount, before.reallocationCount);
        EXPECT_EQ(after.deallocationCount, before.deallocationCount);
        EXPECT_EQ(sentinel[0u], 131u);
        EXPECT_EQ(allocation[0u], 139u);
        EXPECT_EQ(allocation[127u], 149u);
        RawAllocation reused = AllocateBytes(testArena, 1u, cachedBytes);
        ASSERT_NE(reused, RawAllocation());
        EXPECT_EQ(reused, cached);
        FreeBytes(testArena, reused, 1u, cachedBytes);
        FreeBytes(testArena, allocation, 1u, 128u);
        FreeBytes(testArena, sentinel, 1u, 64u);
    }
    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
}

void VerifyScratchArenaReuse_LargeSmallLargeRequestsDoNotRecreateUndersizedCachedChunks(){
    ScratchStorage testArena(s_AllocCaseScratchReuseMixedSizes, 256u);
    Array<AllocationRequest, 4> smallFirst = Array<AllocationRequest, 4>();
    smallFirst[0u] = MakeAllocationRequest(8u, 64u);
    smallFirst[1u] = MakeAllocationRequest(8u, 8192u);
    smallFirst[2u] = MakeAllocationRequest(8u, 96u);
    smallFirst[3u] = MakeAllocationRequest(8u, 512u);
    Array<AllocationRequest, 4> largeFirst = Array<AllocationRequest, 4>();
    largeFirst[0u] = MakeAllocationRequest(8u, 8192u);
    largeFirst[1u] = MakeAllocationRequest(8u, 96u);
    largeFirst[2u] = MakeAllocationRequest(8u, 64u);
    largeFirst[3u] = MakeAllocationRequest(8u, 8192u);
    for(usize iteration = 0u; iteration < 3u; ++iteration){
        ASSERT_TRUE(RunAllocationBatch(smallFirst, testArena));
        ASSERT_TRUE(RunAllocationBatch(largeFirst, testArena));
    }
    const ArenaMemoryStats warm = testArena.memoryStats();
    const ArenaMemoryStats beforeHeap = HeapBackingMemoryStats();
    b8 valid = true;
    for(usize iteration = 0u; iteration < 64u; ++iteration){
        valid = valid && RunAllocationBatch(smallFirst, testArena);
        valid = valid && RunAllocationBatch(largeFirst, testArena);
    }
    const ArenaMemoryStats afterHeap = HeapBackingMemoryStats();
    EXPECT_TRUE(valid);
    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(testArena.memoryStats().reservedBytes, warm.reservedBytes);
    EXPECT_EQ(afterHeap.allocationCount, beforeHeap.allocationCount);
    EXPECT_EQ(afterHeap.deallocationCount, beforeHeap.deallocationCount);
}

[cpp_unwind]
void VerifyScratchArenaReuse_NestedContainerDestructionAndCallerUnwindPreserveEarlierStorage(){
    ScratchStorage testArena(s_AllocCaseScratchReuseNestedContainers, 256u);
    {
        TestValueSlot<Vector<u64>> callerSlot;
        mut Vector<u64> caller = callerSlot.constructIn(testArena);
        caller.assign(48u, 0x12345678u);
        const ArenaMemoryStats retained = testArena.memoryStats();
        ASSERT_TRUE(RunScopedCollection(s_AllocCaseScratchReuseCollectionCount, testArena));
        const ArenaMemoryStats warm = testArena.memoryStats();
        EXPECT_EQ(warm.usedBytes, retained.usedBytes);
        for(usize iteration = 0u; iteration < 16u; ++iteration){
            ASSERT_TRUE(RunScopedCollection(s_AllocCaseScratchReuseCollectionCount, testArena));
            EXPECT_EQ(testArena.memoryStats().usedBytes, retained.usedBytes);
            EXPECT_EQ(testArena.memoryStats().reservedBytes, warm.reservedBytes);
        }
        EXPECT_TRUE(ThrowsException<RuntimeException>(lambda[mut testArena]() -> void{
            TestValueSlot<Vector<u64>> outerSlot;
            mut Vector<u64> outer = outerSlot.constructIn(testArena);
            outer.resize(2048u, 23u);
            TestValueSlot<Vector<u64>> innerSlot;
            mut Vector<u64> inner = innerSlot.constructIn(testArena);
            inner.resize(4096u, 47u);
            ThrowTestException<RuntimeException>(RuntimeException("scratch nested scope unwind"));
        }));
        EXPECT_EQ(testArena.memoryStats().usedBytes, retained.usedBytes);
        for(in u64 value : caller)
            EXPECT_EQ(value, 0x12345678u);
    }
}

void VerifyScratchArenaReuse_OwnerTelemetryRetainsHistoryAndSeparatesReservedBackingFromUsage(){
    const ArenaMemoryStats before = OwnerStats(s_ScratchReuseOwnerLifecycle);
    ArenaMemoryStats live = ArenaMemoryStats();
    {
        ScratchStorage testArena(s_ScratchReuseOwnerLifecycle, 256u);
        Array<AllocationRequest, 3> requests = Array<AllocationRequest, 3>();
        requests[0u] = MakeAllocationRequest(8u, 192u);
        requests[1u] = MakeAllocationRequest(8u, 128u);
        requests[2u] = MakeAllocationRequest(8u, 768u);
        ASSERT_TRUE(RunAllocationBatch(requests, testArena));
        live = testArena.memoryStats();
        EXPECT_EQ(live.usedBytes, 0u);
        EXPECT_GT(live.reservedBytes, 0u);
        const Optional<ArenaMemoryStats> liveResult = FindOwnerStats(s_ScratchReuseOwnerLifecycle, ArenaMemorySource::Arena);
        EXPECT_TRUE(liveResult.has_value());
        if(liveResult.has_value()){
            const ArenaMemoryStats liveOwner = liveResult.value();
            EXPECT_EQ(liveOwner.usedBytes, 0u);
            EXPECT_EQ(liveOwner.reservedBytes, live.reservedBytes);
            EXPECT_EQ(liveOwner.allocationCount, before.allocationCount + live.allocationCount);
            EXPECT_EQ(liveOwner.deallocationCount, before.deallocationCount + live.deallocationCount);
        }
    }
    const Optional<ArenaMemoryStats> afterResult = FindOwnerStats(s_ScratchReuseOwnerLifecycle, ArenaMemorySource::Arena);
    EXPECT_TRUE(afterResult.has_value());
    if(afterResult.has_value()){
        const ArenaMemoryStats afterOwner = afterResult.value();
        EXPECT_EQ(afterOwner.usedBytes, 0u);
        EXPECT_EQ(afterOwner.reservedBytes, 0u);
        EXPECT_EQ(afterOwner.allocationCount, before.allocationCount + live.allocationCount);
        EXPECT_EQ(afterOwner.deallocationCount, before.deallocationCount + live.deallocationCount);
        EXPECT_EQ(afterOwner.peakUsedBytes, Max(before.peakUsedBytes, live.peakUsedBytes));
    }
}

void VerifyAllocatorUsageBoundaries_GlobalArenaChargesUsableBytesAcrossOddSizeReallocations(){
    const usize oddBytes = 13u;
    HeapStorage testArena(s_AllocationOwnersOddReallocation);
    {
        RawAllocation pointer = AllocateBytes(testArena, 1u, oddBytes);
        ASSERT_NE(pointer, RawAllocation());
        for(usize index = 0u; index < oddBytes; ++index)
            pointer[index] = cast<u8>(index + 1u);
        EXPECT_EQ(testArena.memoryStats().usedBytes, BackendSize(pointer));
        EXPECT_EQ(testArena.memoryStats().reservedBytes, BackendSize(pointer));

        RawAllocation replacement = ResizeBytes(testArena, pointer, 1u, 21u);
        ASSERT_NE(replacement, RawAllocation());
        pointer = replacement;
        for(usize index = 0u; index < oddBytes; ++index)
            EXPECT_EQ(pointer[index], cast<u8>(index + 1u));
        EXPECT_EQ(testArena.memoryStats().usedBytes, BackendSize(pointer));
        EXPECT_EQ(OwnerStats(s_AllocationOwnersOddReallocation).usedBytes, BackendSize(pointer));

        replacement = ResizeBytes(testArena, pointer, 1u, 7u);
        ASSERT_NE(replacement, RawAllocation());
        pointer = replacement;
        EXPECT_EQ(testArena.memoryStats().usedBytes, BackendSize(pointer));
        const ArenaMemoryStats beforeFailure = testArena.memoryStats();
        SetRangeError();
        RawAllocation backendInvalidAlignment = BackendReallocate(pointer, 0u, 3u);
        const i32 backendInvalidAlignmentError = AllocationError();
        SetRangeError();
        RawAllocation invalidAlignment = ResizeBytes(testArena, pointer, 3u, 0u);
        const i32 invalidAlignmentError = AllocationError();
        EXPECT_EQ(invalidAlignment, RawAllocation());
        EXPECT_EQ(invalidAlignment, backendInvalidAlignment);
        EXPECT_EQ(invalidAlignmentError, backendInvalidAlignmentError);
        EXPECT_EQ(ResizeBytes(testArena, pointer, 1u, usize.max), RawAllocation());
        EXPECT_EQ(testArena.memoryStats().usedBytes, beforeFailure.usedBytes);
        EXPECT_EQ(testArena.memoryStats().reservedBytes, beforeFailure.reservedBytes);
        EXPECT_EQ(testArena.memoryStats().reallocationCount, beforeFailure.reallocationCount);
        EXPECT_EQ(testArena.memoryStats().deallocationCount, beforeFailure.deallocationCount);
        EXPECT_EQ(pointer[0u], 1u);
        FreeBytes(testArena, pointer, 1u, 7u);
    }
    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(testArena.memoryStats().reservedBytes, 0u);
    EXPECT_EQ(OwnerStats(s_AllocationOwnersOddReallocation).usedBytes, 0u);
    EXPECT_EQ(OwnerStats(s_AllocationOwnersOddReallocation).reservedBytes, 0u);
    EXPECT_EQ(testArena.memoryStats().allocationCount, 1u);
    EXPECT_EQ(testArena.memoryStats().reallocationCount, 2u);
    EXPECT_EQ(testArena.memoryStats().deallocationCount, 1u);
}

void VerifyAllocatorUsageBoundaries_ZeroSizeReallocationReleasesChargedBytes(){
    HeapStorage testArena(s_AllocationOwnersObjectAndZero);
    {
        RawAllocation allocation = AllocateBytes(testArena, 64u, 13u);
        ASSERT_NE(allocation, RawAllocation());
        EXPECT_EQ(ResizeBytes(testArena, allocation, 64u, 0u), RawAllocation());
    }
    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(testArena.memoryStats().reservedBytes, 0u);
    EXPECT_EQ(testArena.memoryStats().allocationCount, 1u);
    EXPECT_EQ(testArena.memoryStats().deallocationCount, 1u);
    EXPECT_EQ(OwnerStats(s_AllocationOwnersObjectAndZero).usedBytes, 0u);
}

Expected<Shared<SharedArenaPayload>> MakeEscapingSharedArenaPayload(){
    SharedPool pool();
    Expected<Shared<SharedArenaPayload>> result = pool.make<SharedArenaPayload>();
    if(result.has_value())
        result.value().deref().values.push_back(s_AllocCaseScratchReuseFirstSentinel);
    return result;
}

void VerifySharedPoolPayloadSurvivesScratchAndLastPeer(){
    Expected<Shared<SharedArenaPayload>> result = MakeEscapingSharedArenaPayload();
    ASSERT_TRUE(result.has_value());
    Shared<SharedArenaPayload> peer = result.value();
    result.value().reset();
    ASSERT_TRUE(peer.valid());
    peer.deref().values.push_back(s_AllocCaseScratchReuseSentinelByte);
    ASSERT_EQ(peer.deref().values.size(), 2u);
    EXPECT_EQ(peer.deref().values[0u], s_AllocCaseScratchReuseFirstSentinel);
    EXPECT_EQ(peer.deref().values[1u], s_AllocCaseScratchReuseSentinelByte);
}

NWB_ADHD_GTEST(SharedPoolTests, PayloadSurvivesScratchAndLastPeer, VerifySharedPoolPayloadSurvivesScratchAndLastPeer)

void VerifySharedPoolKeepsPreparedPayloadStorage(){
    SharedPool pool();
    SharedArenaPayload prepared;
    prepared.values.push_back(s_AllocCaseScratchReuseFirstSentinel);
    in u32 original = prepared.values[0u];
    auto shared = pool.makePrepared<SharedArenaPayload>(prepared);
    ASSERT_TRUE(shared.has_value());
    ASSERT_EQ(shared.value().deref().values.size(), 1u);
    EXPECT_TRUE(SameAddress(shared.value().deref().values[0u], original));
}

NWB_ADHD_GTEST(SharedPoolTests, KeepsPreparedPayloadStorage, VerifySharedPoolKeepsPreparedPayloadStorage)
