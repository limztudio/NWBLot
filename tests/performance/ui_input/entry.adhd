namespace NWB::Tests::UiInputBenchmarkCases{
using NWB::Core::ClipboardCapabilities;
using NWB::Core::ClipboardRequestToken;
using NWB::Core::QueuedClipboardService;
using NWB::Core::QueuedTextInputService;
using NWB::Core::TextInputCapabilities;
using NWB::Core::Alloc::GlobalArena;
using NWB::Core::Assets::AssetRef;
using NWB::Impl::Texture;
using NWB::Impl::UiEditBoxHost;
using NWB::Impl::UiSkin;
using namespace NWB::Impl::Ui;
namespace ClipboardChannel = NWB::Core::ClipboardChannel;
namespace ClipboardOperation = NWB::Core::ClipboardOperation;
namespace ClipboardStatus = NWB::Core::ClipboardStatus;
using TextLayoutStatusEnum = TextLayoutStatus::Enum;
using HitTargetVector = InputVector<HitTarget>;

class BenchmarkTextInput final : public QueuedTextInputService{
public:
    explicit BenchmarkTextInput(GlobalArena& arena) : QueuedTextInputService(arena){}

public:
    [[nodiscard]] virtual TextInputCapabilities capabilities()const noexcept override{ return { true, true, true, true }; }
};

class BenchmarkClipboard final : public QueuedClipboardService{
public:
    explicit BenchmarkClipboard(GlobalArena& arena) : QueuedClipboardService(arena){}

public:
    [[nodiscard]] virtual ClipboardCapabilities capabilities(ClipboardChannel::Enum)const noexcept override{ return {}; }

protected:
    virtual void startNativeRequest(const ClipboardRequestToken token, ClipboardOperation::Enum, ClipboardChannel::Enum, AStringView)noexcept override{
        const b8 completed = completeNativeRequest(token, ClipboardStatus::Unsupported);
        FOUNDATION_FATAL_ASSERT(completed);
    }
};

FOUNDATION_INLINE void WriteUiBenchmarkStdout(const AStringView text){
    FOUNDATION_COUT << text;
}

FOUNDATION_INLINE void ConfigureEmptySkinAtlas(GlobalArena& arena, UiSkin& skin, const Name textureName){
    UiSkin::RegionVector regions(arena);
    skin.setAtlas(AssetRef<Texture>(textureName), 8u, 8u, 1.0f, Move(regions));
}

FOUNDATION_INLINE b8 AdoptBuiltTextLayout(TextLayoutBuilder& layoutBuilder, const ShapeRequest& request, EditBoxView& view){
    auto layout = layoutBuilder.layout(request);
    return layout && view.adoptLayout(Move(*layout));
}

FOUNDATION_INLINE b8 TryDeclareEditBoxWidget(Context& context, const AStringView id, WidgetState& outWidget){
    const auto widget = context.declare(id, WidgetKind::EditBox);
    if(!widget)
        return false;
    outWidget = **widget;
    return true;
}

FOUNDATION_INLINE b8 HasCommittedTargetWithWidth(const Context& context, const WidgetId id, const u64 declarationGeneration, const f32 expectedWidth){
    const HitTarget* const target = context.input().findTarget(id, declarationGeneration);
    return target != nullptr && target->rectangle.width == expectedWidth;
}
};


