class DeferredLightingGraphTask{
    private mut RendererDeferredSystem m_system;
    private mut DeferredFrameTargets m_targets;
    private mut GpuTimingSubmissionTicket m_timingTicket;
    private b8 m_useLaggedLightingHistory;

    public DeferredLightingGraphTask(mut RendererDeferredSystem system, mut DeferredFrameTargets targets, mut GpuTimingSubmissionTicket timingTicket, in b8 useLaggedLightingHistory){
        this.m_system = system;
        this.m_targets = targets;
        this.m_timingTicket = timingTicket;
        this.m_useLaggedLightingHistory = useLaggedLightingHistory;
    }
    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const{
        GpuTimingTicketRecordingScope recording(this.m_timingTicket);
        return this.m_system.renderDeferredLighting(commands, this.m_targets, this.m_useLaggedLightingHistory);
    }
}

class DeferredCompositeGraphTask{
    private mut RendererDeferredSystem m_system;
    private mut DeferredFrameTargets m_targets;
    private mut GpuTimingSubmissionTicket m_timingTicket;
    private ReflectionCompositeInputs m_reflectionInputs;

    public DeferredCompositeGraphTask(mut RendererDeferredSystem system, mut DeferredFrameTargets targets, mut GpuTimingSubmissionTicket timingTicket, in ReflectionCompositeInputs reflectionInputs){
        this.m_system = system;
        this.m_targets = targets;
        this.m_timingTicket = timingTicket;
        this.m_reflectionInputs = reflectionInputs;
    }
    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const{
        GpuTimingTicketRecordingScope recording(this.m_timingTicket);
        return this.m_system.renderDeferredComposite(commands, this.m_targets, this.m_reflectionInputs);
    }
}

class DeferredDebugLinesGraphTask{
    private mut RendererDeferredSystem m_system;
    private mut DeferredFrameTargets m_targets;
    private f32x4x4 m_viewProj;
    private u32 m_depthVertexCount;
    private u32 m_overlayVertexCount;

    public DeferredDebugLinesGraphTask(
        mut RendererDeferredSystem system,
        mut DeferredFrameTargets targets,
        in MatrixSingle viewProj,
        in u32 depthVertexCount,
        in u32 overlayVertexCount
    ){
        this.m_system = system;
        this.m_targets = targets;
        this.m_viewProj = f32x4x4(viewProj);
        this.m_depthVertexCount = depthVertexCount;
        this.m_overlayVertexCount = overlayVertexCount;
    }

    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements requirements;
        requirements.requiredCapabilities = GpuQueueCapability::Graphics;
        return requirements;
    }

    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const{
        return this.m_system.renderDeferredDebugLines(commands, this.m_targets, MatrixSingle(this.m_viewProj), this.m_depthVertexCount, this.m_overlayVertexCount);
    }
}

RenderState BuildDeferredDebugLineRenderState(in b8 depthTest){
    RenderState renderState;
    renderState.rasterState.enableDepthClip().setCullNone();
    if(depthTest)
        renderState.depthStencilState.enableDepthTest().disableDepthWrite().setDepthFunc(ComparisonFunc::LessOrEqual);
    else
        renderState.depthStencilState.disableDepthTest().disableDepthWrite();
    renderState.blendState.targets[0u]
        .enableBlend()
        .setSrcBlend(BlendFactor::SrcAlpha)
        .setDestBlend(BlendFactor::InvSrcAlpha)
        .setBlendOp(BlendOp::Add)
        .setSrcBlendAlpha(BlendFactor::One)
        .setDestBlendAlpha(BlendFactor::InvSrcAlpha)
        .setBlendOpAlpha(BlendOp::Add)
        .setColorWriteMask(ColorMask::All)
    ;
    return renderState;
}

static_assert(s_DeferredSceneMaxLights == s_ShaderMaxSceneLights);
static_assert(s_DeferredLightingGroupSize == s_ShaderDeferredLightingGroupSize);
static_assert(s_DeferredCompositeGroupSize == s_ShaderDeferredCompositeGroupSize);
static_assert(size_of<DeferredLightingPushConstants>() == size_of<u32>());
static_assert(size_of<DeferredCompositePushConstants>() == size_of<u32>() * 5u);
static_assert(size_of<DeferredPresentPushConstants>() == size_of<u32>() * 6u);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 EnsureDeferredBuffer(
    in BufferDesc desc,
    in StringView errorMessage,
    mut GraphicsRuntime graphics,
    mut BufferHandle outBuffer
){
    if(outBuffer.valid())
        return true;

    const Expected<BufferHandle> result = graphics.createBuffer(desc);
    if(!result.has_value()){
        outBuffer.reset();
        error(errorMessage);
        return false;
    }
    outBuffer = result.value();
    return true;
}

u32 ComputeDeferredDispatchGroupCount(in u32 extent, in u32 groupSize){
    return DivideUpWrapping(extent, groupSize);
}

u64 ComputeSceneLightBufferByteSize(in usize recordByteSize, in usize maxLights){
    return cast<u64>(recordByteSize * maxLights);
}

b8 CanRenderDeferredLightingWithHistory(in b8 useLaggedLightingHistory, in b8 laggedHistoryValid){
    return !useLaggedLightingHistory || laggedHistoryValid;
}

u32 SelectDeferredPresentOutputLayerSlot(in b8 valid, in u32 slot, in u32 invalidSlot){
    if(valid)
        return slot;
    return invalidSlot;
}

void RendererDeferredSystem::confirmSceneShadingBufferUploads(
    in Span<SceneLightGpuData> lights,
    in b8 lightUploadRequired,
    in SceneShadingGpuData sceneShadingState,
    in b8 sceneShadingUploadRequired
){
    SceneShadingUploadTracker().confirm(
        lights,
        lightUploadRequired,
        sceneShadingState,
        sceneShadingUploadRequired,
        this.m_deferredState.m_lightGpuData,
        this.m_deferredState.m_lightGpuDataCount,
        this.m_deferredState.m_lightGpuDataValid,
        this.m_deferredState.m_sceneShadingGpuData,
        this.m_deferredState.m_sceneShadingGpuDataValid
    );
}

b8 RendererDeferredSystem::createDeferredLightingResources(){
    mut Device device = this.m_graphics.getDevice();
    if(!device.getDescriptorHeap().isInitialized()){
        error("RendererSystem: deferred lighting requires the global descriptor heap");
        return false;
    }

    BufferDesc sceneShadingBufferDesc;
    sceneShadingBufferDesc
        .setByteSize(sizeof(SceneShadingGpuData))
        .setIsConstantBuffer(true)
        .setDebugName(s_SceneShadingBufferName)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;
    if(!EnsureDeferredBuffer(sceneShadingBufferDesc, "RendererSystem: failed to create scene shading buffer", this.m_graphics, this.m_deferredState.m_sceneShadingBuffer))
        return false;

    BufferDesc lightBufferDesc;
    lightBufferDesc
        .setByteSize(ComputeSceneLightBufferByteSize(sizeof(SceneLightGpuData), s_DeferredSceneMaxLights))
        .setStructStride(sizeof(SceneLightGpuData))
        .setDebugName(s_SceneLightBufferName)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;
    if(!EnsureDeferredBuffer(lightBufferDesc, "RendererSystem: failed to create scene light buffer", this.m_graphics, this.m_deferredState.m_lightBuffer))
        return false;

    if(!EnsurePushConstantBindingLayout(device, sizeof(DeferredLightingPushConstants), ShaderTypeMask::Compute, this.m_deferredState.m_lightingBindingLayout)){
        error("RendererSystem: failed to create deferred lighting binding layout");
        return false;
    }

    if(!CreateClampSampler(false, device, this.m_deferredState.m_sampler)){
        error("RendererSystem: failed to create deferred lighting sampler");
        return false;
    }

    if(!this.m_shaderSystem.loadShader<ComputeShader, DeferredSubsystem>(lambda[](in DeferredSubsystem s) -> AssetRef<ComputeShader>{ return s.lightingCs; }, s_ShaderArchiveDefaultVariant, s_DeferredLightingShaderDebugName, this.m_deferredState.m_lightingComputeShader))
        return false;

    return true;
}

b8 RendererDeferredSystem::createDeferredLightingPipeline(){
    if(!this.createDeferredLightingResources())
        return false;

    if(this.m_deferredState.m_lightingPipeline.valid())
        return true;

    const Expected<ComputePipelineHandle> pipeline = CreateHeapComputePipeline(this.m_graphics.getDevice(), this.m_deferredState.m_lightingComputeShader, this.m_deferredState.m_lightingBindingLayout, false);
    if(!pipeline.has_value()){
        this.m_deferredState.m_lightingPipeline.reset();
        error("RendererSystem: failed to create deferred lighting pipeline");
        return false;
    }
    this.m_deferredState.m_lightingPipeline = pipeline.value();

    return true;
}

b8 RendererDeferredSystem::renderDeferredLighting(mut CommandList commandList, mut DeferredFrameTargets targets, in b8 useLaggedLightingHistory){
    assert(this.m_deferredState.m_lightingPipeline.valid());

    if(!CanRenderDeferredLightingWithHistory(useLaggedLightingHistory, targets.laggedLightingHistory.valid()))
        return false;

    GpuDescriptorHandle resourceSlots = targets.bindless.slotsBufferDescriptor;
    if(useLaggedLightingHistory)
        resourceSlots = targets.laggedLightingHistory.slotsBufferDescriptor;

    GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeDeferredLighting, this.m_graphics.getDevice(), commandList);

    ComputeState computeState;
    computeState.setPipeline(this.m_deferredState.m_lightingPipeline.deref());
    commandList.setComputeState(computeState);
    this.m_graphics.getDevice().getDescriptorHeap().bindCompute(commandList, this.m_deferredState.m_lightingPipeline.deref());
    const DeferredLightingPushConstants pushConstants = ResolveDeferredLightingPushConstants(resourceSlots.slot());
    commandList.setPushConstants(pushConstants);

    const u32 groupCountX = ComputeDeferredDispatchGroupCount(targets.width, s_DeferredLightingGroupSize);
    const u32 groupCountY = ComputeDeferredDispatchGroupCount(targets.height, s_DeferredLightingGroupSize);
    commandList.dispatch(groupCountX, groupCountY, 1u);
    return true;
}

b8 RendererDeferredSystem::createDeferredCompositeResources(){
    mut Device device = this.m_graphics.getDevice();
    if(!device.getDescriptorHeap().isInitialized()){
        error("RendererSystem: deferred compositing requires the global descriptor heap");
        return false;
    }

    if(!EnsurePushConstantBindingLayout(device, sizeof(DeferredCompositePushConstants), ShaderTypeMask::Compute, this.m_deferredState.m_compositeComputeBindingLayout)){
        error("RendererSystem: failed to create deferred composite-compute binding layout");
        return false;
    }

    if(!EnsurePushConstantBindingLayout(device, sizeof(DeferredPresentPushConstants), ShaderTypeMask::Pixel, this.m_deferredState.m_presentBindingLayout)){
        error("RendererSystem: failed to create deferred presentation binding layout");
        return false;
    }

    if(!EnsurePushConstantBindingLayout(device, sizeof(DeferredDebugLinePushConstants), ShaderTypeMask::Vertex, this.m_deferredState.m_debugLineBindingLayout)){
        error("RendererSystem: failed to create deferred debug-line binding layout");
        return false;
    }

    if(!CreateClampSampler(false, device, this.m_deferredState.m_sampler)){
        error("RendererSystem: failed to create deferred composite sampler");
        return false;
    }

    if(!this.m_shaderSystem.loadShader<ComputeShader, DeferredSubsystem>(lambda[](in DeferredSubsystem s) -> AssetRef<ComputeShader>{ return s.compositeCs; }, s_ShaderArchiveDefaultVariant, s_DeferredCompositeShaderDebugName, this.m_deferredState.m_compositeComputeShader))
        return false;

    if(!this.m_shaderSystem.loadDeferredCompositeVertexShader())
        return false;

    if(!this.m_shaderSystem.loadShader<PixelShader, DeferredSubsystem>(lambda[](in DeferredSubsystem s) -> AssetRef<PixelShader>{ return s.compositePs; }, s_ShaderArchiveDefaultVariant, s_DeferredPresentShaderDebugName, this.m_deferredState.m_presentPixelShader))
        return false;

    if(!this.m_shaderSystem.loadShader<VertexShader, DeferredSubsystem>(lambda[](in DeferredSubsystem s) -> AssetRef<VertexShader>{ return s.debugLineVs; }, s_ShaderArchiveDefaultVariant, s_DeferredDebugLineVertexShaderDebugName, this.m_deferredState.m_debugLineVertexShader))
        return false;

    if(!this.m_shaderSystem.loadShader<PixelShader, DeferredSubsystem>(lambda[](in DeferredSubsystem s) -> AssetRef<PixelShader>{ return s.debugLinePs; }, s_ShaderArchiveDefaultVariant, s_DeferredDebugLinePixelShaderDebugName, this.m_deferredState.m_debugLinePixelShader))
        return false;

    return true;
}

void RendererDeferredSystem::invalidateResources(){
    if(this.m_deferredState.m_debugLineVertexHeapHandle.valid()){
        mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
        if(heap.isInitialized())
            RetireDescriptor(heap, this.m_deferredState.m_debugLineVertexHeapHandle);
    }
    this.m_deferredState.invalidateResources();
}

b8 RendererDeferredSystem::createDeferredCompositePipeline(){
    if(!this.createDeferredCompositeResources())
        return false;

    if(this.m_deferredState.m_compositeComputePipeline.valid())
        return true;

    const Expected<ComputePipelineHandle> pipeline = CreateHeapComputePipeline(this.m_graphics.getDevice(), this.m_deferredState.m_compositeComputeShader, this.m_deferredState.m_compositeComputeBindingLayout, false);
    if(!pipeline.has_value()){
        this.m_deferredState.m_compositeComputePipeline.reset();
        error("RendererSystem: failed to create deferred composite-compute pipeline");
        return false;
    }
    this.m_deferredState.m_compositeComputePipeline = pipeline.value();

    return true;
}

b8 RendererDeferredSystem::createDeferredPresentPipeline(mut Framebuffer presentationFramebuffer){
    if(!this.createDeferredCompositeResources())
        return false;

    const FramebufferInfo framebufferInfo = FramebufferInfo(presentationFramebuffer.getFramebufferInfo());
    if(this.m_deferredState.m_presentPipeline.valid() && this.m_deferredState.m_presentPipeline.deref().getFramebufferInfo() == framebufferInfo)
        return true;

    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    GraphicsPipelineDesc pipelineDesc;
    pipelineDesc
        .setVertexShader(this.m_shaderSystem.deferredCompositeVertexShader())
        .setPixelShader(this.m_deferredState.m_presentPixelShader)
        .setRenderState(BuildCompositeRenderState())
        .addBindingLayout(this.m_deferredState.m_presentBindingLayout)
        .addBindingLayout(heap.getResourceLayout())
        .addBindingLayout(heap.getSamplerLayout())
    ;

    const Expected<GraphicsPipelineHandle> presentPipelineResult = device.createGraphicsPipeline(pipelineDesc, framebufferInfo);
    if(!presentPipelineResult.has_value()){
        this.m_deferredState.m_presentPipeline.reset();
        error("RendererSystem: failed to create deferred presentation pipeline");
        return false;
    }
    this.m_deferredState.m_presentPipeline = presentPipelineResult.value();

    return true;
}

b8 CreateDeferredDebugLinePipelineVariant(
    mut Device device,
    mut GpuDescriptorHeap heap,
    in RendererDeferredState deferredState,
    in FramebufferInfo framebufferInfo,
    in b8 depthTest,
    in StringView errorLabel,
    mut GraphicsPipelineHandle outPipeline
){
    GraphicsPipelineDesc desc;
    desc.primType = PrimitiveType::LineList;
    desc
        .setVertexShader(deferredState.m_debugLineVertexShader)
        .setPixelShader(deferredState.m_debugLinePixelShader)
        .setRenderState(BuildDeferredDebugLineRenderState(depthTest))
        .addBindingLayout(deferredState.m_debugLineBindingLayout)
        .addBindingLayout(heap.getResourceLayout())
        .addBindingLayout(heap.getSamplerLayout())
    ;
    const Expected<GraphicsPipelineHandle> result = device.createGraphicsPipeline(desc, framebufferInfo);
    if(!result.has_value()){
        error("RendererSystem: failed to create {}", errorLabel);
        return false;
    }
    outPipeline = result.value();
    return true;
}

b8 RendererDeferredSystem::createDeferredDebugLinePipelines(mut Framebuffer debugFramebuffer, mut Framebuffer colorOnlyFramebuffer){
    const FramebufferInfo debugFbInfo = FramebufferInfo(debugFramebuffer.getFramebufferInfo());
    const FramebufferInfo colorOnlyFbInfo = FramebufferInfo(colorOnlyFramebuffer.getFramebufferInfo());
    if(
        this.m_deferredState.m_debugLineVertexShader.valid()
        && this.m_deferredState.m_debugLinePixelShader.valid()
        && this.m_deferredState.m_debugLineBindingLayout.valid()
        && this.m_deferredState.m_debugLineDepthPipeline.valid()
        && this.m_deferredState.m_debugLineOverlayPipeline.valid()
        && this.m_deferredState.m_debugLineOverlayColorOnlyPipeline.valid()
        && this.m_deferredState.m_debugLineDepthPipeline.deref().getFramebufferInfo() == debugFbInfo
        && this.m_deferredState.m_debugLineOverlayPipeline.deref().getFramebufferInfo() == debugFbInfo
        && this.m_deferredState.m_debugLineOverlayColorOnlyPipeline.deref().getFramebufferInfo() == colorOnlyFbInfo
    )
        return true;

    if(!this.createDeferredCompositeResources())
        return false;

    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();

    GraphicsPipelineHandle depthPipeline;
    GraphicsPipelineHandle overlayPipeline;
    GraphicsPipelineHandle overlayColorOnlyPipeline;
    if(
        !CreateDeferredDebugLinePipelineVariant(device, heap, this.m_deferredState, debugFbInfo, true, "deferred depth-tested debug-line pipeline", depthPipeline)
        || !CreateDeferredDebugLinePipelineVariant(device, heap, this.m_deferredState, debugFbInfo, false, "deferred overlay debug-line pipeline", overlayPipeline)
        || !CreateDeferredDebugLinePipelineVariant(device, heap, this.m_deferredState, colorOnlyFbInfo, false, "deferred color-only overlay debug-line pipeline", overlayColorOnlyPipeline)
    ){
        this.m_deferredState.m_debugLineDepthPipeline.reset();
        this.m_deferredState.m_debugLineOverlayPipeline.reset();
        this.m_deferredState.m_debugLineOverlayColorOnlyPipeline.reset();
        return false;
    }

    this.m_deferredState.m_debugLineDepthPipeline = depthPipeline;
    this.m_deferredState.m_debugLineOverlayPipeline = overlayPipeline;
    this.m_deferredState.m_debugLineOverlayColorOnlyPipeline = overlayColorOnlyPipeline;
    return true;
}

b8 RendererDeferredSystem::ensureDeferredDebugLineVertexBuffer(in usize requiredVertices){
    if(requiredVertices == 0u)
        return true;
    if(requiredVertices > usize.max / size_of<GpuDebugLineVertex>())
        return false;
    if(this.m_deferredState.m_debugLineVertexBuffer.valid() && requiredVertices <= this.m_deferredState.m_debugLineVertexCapacity && this.m_deferredState.m_debugLineVertexHeapHandle.valid())
        return true;

    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized())
        return false;

    usize nextCapacity = s_DeferredDebugLineInitialVertexCapacity;
    if(this.m_deferredState.m_debugLineVertexCapacity > 0u){
        nextCapacity = this.m_deferredState.m_debugLineVertexCapacity;
        while(nextCapacity < requiredVertices){
            if(nextCapacity > usize.max / 2u){
                nextCapacity = requiredVertices;
                break;
            }
            nextCapacity *= 2u;
        }
    }
    if(nextCapacity < requiredVertices)
        nextCapacity = requiredVertices;
    if(nextCapacity > usize.max / size_of<GpuDebugLineVertex>())
        return false;

    BufferDesc vbDesc;
    vbDesc
        .setByteSize(nextCapacity * size_of<GpuDebugLineVertex>())
        .setCanHaveRawViews(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setDebugName(s_DeferredDebugLineVertexBufferName)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;
    const Expected<BufferHandle> vbResult = device.createBuffer(vbDesc);
    if(!vbResult.has_value()){
        error("RendererSystem: failed to create deferred debug-line vertex buffer");
        return false;
    }
    BufferHandle newVb = vbResult.value();
    if(!ReplaceDescriptor(heap, GpuDescriptorClass::StorageBuffer, DescriptorWriteItemRawBufferSrv(0u, newVb.deref()), this.m_deferredState.m_debugLineVertexHeapHandle)){
        error("RendererSystem: failed to register deferred debug-line vertex buffer descriptor");
        return false;
    }
    this.m_deferredState.m_debugLineVertexBuffer = newVb;
    this.m_deferredState.m_debugLineVertexCapacity = nextCapacity;
    return true;
}

b8 RendererDeferredSystem::renderDeferredComposite(mut CommandList commandList, mut DeferredFrameTargets targets, in ReflectionCompositeInputs reflectionInputs){
    assert(this.m_deferredState.m_compositeComputePipeline.valid());

    GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeDeferredComposite, this.m_graphics.getDevice(), commandList);

    ComputeState computeState;
    computeState.setPipeline(this.m_deferredState.m_compositeComputePipeline.deref());
    commandList.setComputeState(computeState);
    this.m_graphics.getDevice().getDescriptorHeap().bindCompute(commandList, this.m_deferredState.m_compositeComputePipeline.deref());
    const DeferredCompositePushConstants pushConstants = ResolveDeferredCompositePushConstants(
        targets.bindless.slotsBufferDescriptor.slot(),
        targets.avboit.refractionFramebuffer.valid(),
        reflectionInputs
    );
    commandList.setPushConstants(pushConstants);
    const u32 groupCountX = ComputeDeferredDispatchGroupCount(targets.width, s_DeferredCompositeGroupSize);
    const u32 groupCountY = ComputeDeferredDispatchGroupCount(targets.height, s_DeferredCompositeGroupSize);
    commandList.dispatch(groupCountX, groupCountY, 1u);
    return true;
}

b8 RendererDeferredSystem::renderDeferredPresent(mut CommandList commandList, mut DeferredFrameTargets targets, in AcquiredPresentationFrame presentationFrame, in GpuDescriptorHandle outputLayerImage){
    assert(presentationFrame.valid());
    assert(this.m_deferredState.m_presentPipeline.valid());
    mut Framebuffer presentationFramebuffer = presentationFrame.framebuffer.deref();
    assert(
        presentationFramebuffer.getDescription().colorAttachments.size() == 1u
        && this.m_deferredState.m_presentPipeline.deref().getFramebufferInfo() == FramebufferInfo(presentationFramebuffer.getFramebufferInfo())
    );

    GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeDeferredPresent, this.m_graphics.getDevice(), commandList);

    RenderPassParameters renderPassParameters;
    renderPassParameters.colorAttachmentActions[0u].loadAction = RenderPassLoadAction::Discard;
    renderPassParameters.colorAttachmentActions[0u].storeAction = RenderPassStoreAction::Store;
    commandList.beginRenderPass(presentationFramebuffer, renderPassParameters);
    if(!commandList.isRenderPassActive())
        return false;

    ViewportState viewportState;
    viewportState.addViewportAndScissorRect(presentationFramebuffer.getFramebufferInfo().getViewport());

    GraphicsState graphicsState;
    graphicsState.setPipeline(this.m_deferredState.m_presentPipeline.deref());
    graphicsState.setFramebuffer(presentationFramebuffer);
    graphicsState.setViewport(viewportState);

    commandList.setGraphicsState(graphicsState);
    this.m_graphics.getDevice().getDescriptorHeap().bindGraphics(commandList, this.m_deferredState.m_presentPipeline.deref());
    const DeferredPresentPushConstants pushConstants = ResolveDeferredPresentPushConstants(
        targets.bindless.slotsBufferDescriptor.slot(),
        this.m_graphics.isHDR10OutputActive(),
        this.m_deferredState.m_presentationSettings,
        SelectDeferredPresentOutputLayerSlot(outputLayerImage.valid(), outputLayerImage.slot(), s_DeferredInvalidHeapSlot)
    );
    commandList.setPushConstants(pushConstants);

    DrawArguments drawArgs;
    drawArgs.setVertexCount(s_FullscreenTriangleVertexCount);
    commandList.draw(drawArgs);
    commandList.endRenderPass();
    return !commandList.isRenderPassActive();
}

void RecordDeferredDebugLineDraw(
    mut CommandList commandList,
    mut GpuDescriptorHeap heap,
    mut GraphicsPipeline pipeline,
    mut Framebuffer framebuffer,
    in ViewportState viewportState,
    in DeferredDebugLinePushConstants pushConstants,
    in u32 vertexCount,
    in u32 startVertexLocation
){
    GraphicsState graphicsState;
    graphicsState.setPipeline(pipeline);
    graphicsState.setFramebuffer(framebuffer);
    graphicsState.setViewport(viewportState);
    commandList.setGraphicsState(graphicsState);
    heap.bindGraphics(commandList, pipeline);
    commandList.setPushConstants(pushConstants);

    DrawArguments drawArgs;
    drawArgs.setVertexCount(vertexCount).setStartVertexLocation(startVertexLocation);
    commandList.draw(drawArgs);
}

b8 RendererDeferredSystem::renderDeferredDebugLines(
    mut CommandList commandList,
    mut DeferredFrameTargets targets,
    in MatrixSingle viewProj,
    in u32 depthVertexCount,
    in u32 overlayVertexCount
){
    if(depthVertexCount == 0u && overlayVertexCount == 0u)
        return true;
    assert(targets.compositeFramebuffer.valid());
    assert(targets.compositeDebugFramebuffer.valid());
    assert(this.m_deferredState.m_debugLineDepthPipeline.valid());
    assert(this.m_deferredState.m_debugLineOverlayPipeline.valid());
    assert(this.m_deferredState.m_debugLineOverlayColorOnlyPipeline.valid());
    assert(this.m_deferredState.m_debugLineVertexHeapHandle.valid());

    DeferredDebugLinePushConstants pushConstants;
    pushConstants.viewProj = f32x4x4(viewProj);
    pushConstants.vertexBufferSlot = this.m_deferredState.m_debugLineVertexHeapHandle.slot();

    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    if(depthVertexCount == 0u){
        mut Framebuffer colorOnlyFramebuffer = targets.compositeFramebuffer.deref();
        RenderPassParameters renderPassParameters;
        renderPassParameters.colorAttachmentActions[0u].loadAction = RenderPassLoadAction::Load;
        renderPassParameters.colorAttachmentActions[0u].storeAction = RenderPassStoreAction::Store;
        commandList.beginRenderPass(colorOnlyFramebuffer, renderPassParameters);
        if(!commandList.isRenderPassActive())
            return false;

        ViewportState viewportState;
        viewportState.addViewportAndScissorRect(colorOnlyFramebuffer.getFramebufferInfo().getViewport());
        RecordDeferredDebugLineDraw(commandList, heap, this.m_deferredState.m_debugLineOverlayColorOnlyPipeline.deref(), colorOnlyFramebuffer, viewportState, pushConstants, overlayVertexCount, 0u);
        commandList.endRenderPass();
        return !commandList.isRenderPassActive();
    }

    mut Framebuffer debugFramebuffer = targets.compositeDebugFramebuffer.deref();
    RenderPassParameters renderPassParameters;
    renderPassParameters.colorAttachmentActions[0u].loadAction = RenderPassLoadAction::Load;
    renderPassParameters.colorAttachmentActions[0u].storeAction = RenderPassStoreAction::Store;
    renderPassParameters.depthAttachmentActions.loadAction = RenderPassLoadAction::Load;
    renderPassParameters.depthAttachmentActions.storeAction = RenderPassStoreAction::None;
    commandList.beginRenderPass(debugFramebuffer, renderPassParameters);
    if(!commandList.isRenderPassActive())
        return false;

    ViewportState viewportState;
    viewportState.addViewportAndScissorRect(debugFramebuffer.getFramebufferInfo().getViewport());

    RecordDeferredDebugLineDraw(commandList, heap, this.m_deferredState.m_debugLineDepthPipeline.deref(), debugFramebuffer, viewportState, pushConstants, depthVertexCount, 0u);
    if(overlayVertexCount > 0u)
        RecordDeferredDebugLineDraw(commandList, heap, this.m_deferredState.m_debugLineOverlayPipeline.deref(), debugFramebuffer, viewportState, pushConstants, overlayVertexCount, depthVertexCount);

    commandList.endRenderPass();
    return !commandList.isRenderPassActive();
}

RayTracingLightingClassification ClassifyDeferredSceneLights(in Span<f32> importance, in u32 refractiveInstanceCount, mut Span<SceneLightGpuData> lights, in u32 lightCount){
    auto activeLights = lights.subspan(0u, lightCount);
    RayTracingLightingClassification classification;
    classification.causticLightCount = ResolveCausticLights(importance, refractiveInstanceCount, activeLights);
    classification.softShadowSlotMask = ResolveSoftShadowSlotMask(activeLights);
    return classification;
}

SceneShadingBufferUploads RendererDeferredSystem::prepareSceneShadingBufferUploads(in f32 fallbackAspectRatio, in RayTracingLightingClassificationInput rayTracingInput, in PreflightedSceneLightsView preflightedLights)const{
    assert(this.m_deferredState.m_sceneShadingBuffer.valid());
    assert(this.m_deferredState.m_lightBuffer.valid());
    SceneShadingBufferUploads uploads;
    Array<f32, s_DeferredSceneMaxLights> causticLightImportance;
    if(preflightedLights.valid && preflightedLights.lights.size() <= uploads.lightData.size() && preflightedLights.causticImportance.size() == preflightedLights.lights.size()){
        uploads.lightCount = cast<u32>(preflightedLights.lights.size());
        for(usize i = 0u; i < preflightedLights.lights.size(); ++i){
            uploads.lightData[i] = preflightedLights.lights[i];
            causticLightImportance[i] = preflightedLights.causticImportance[i];
        }
    }
    else
        uploads.lightCount = ResolveSceneLights(this.m_world, uploads.lightData, causticLightImportance);
    const Span<SceneLightGpuData> lights(uploads.lightData.data(), uploads.lightCount);
    const Span<f32> importance(causticLightImportance.data(), uploads.lightCount);
    uploads.lightingClassification = ClassifyDeferredSceneLights(importance, rayTracingInput.refractiveInstanceCount, uploads.lightData, uploads.lightCount);
    uploads.lightUploadRequired = SceneShadingUploadTracker().lightUploadRequired(this.m_deferredState.m_lightGpuDataValid,
        this.m_deferredState.m_lightGpuDataCount, this.m_deferredState.m_lightGpuData, lights);
    uploads.sceneShadingState = ResolveSceneShadingState(fallbackAspectRatio, uploads.lightCount, this.m_world);
    uploads.sceneShadingUploadRequired = SceneShadingUploadTracker().shadingUploadRequired(this.m_deferredState.m_sceneShadingGpuDataValid,
        this.m_deferredState.m_sceneShadingGpuData, uploads.sceneShadingState);
    return uploads;
}

Expected<GpuTaskId> RendererDeferredSystem::declareDeferredLightingTask(
    mut GpuTaskGraph graph,
    in GpuTaskDesc desc,
    in b8 useLaggedLightingHistory,
    mut DeferredFrameTargets targets,
    mut GpuTimingSubmissionTicket timingTicket
){
    return graph.addPayloadTask(desc, DeferredLightingGraphTask(this, targets, timingTicket, useLaggedLightingHistory));
}

Expected<GpuTaskId> RendererDeferredSystem::declareDeferredCompositeTask(
    mut GpuTaskGraph graph,
    in GpuTaskDesc desc,
    in ReflectionCompositeInputs reflectionInputs,
    mut DeferredFrameTargets targets,
    mut GpuTimingSubmissionTicket timingTicket
){
    return graph.addPayloadTask(desc, DeferredCompositeGraphTask(this, targets, timingTicket, reflectionInputs));
}

Expected<Optional<GpuTaskId>> RendererDeferredSystem::declareDeferredDebugLinesTasks(
    mut GpuTaskGraph graph,
    mut DeferredFrameTargets targets,
    in GpuGraphResourceId compositeColor,
    in GpuGraphResourceId depth,
    in GpuTaskId compositeTask,
    in MatrixSingle viewProj,
    mut IDebugLineProvider provider
){
    this.m_deferredState.m_debugLineCollector.clear();
    provider.collectDebugLines(this.m_deferredState.m_debugLineCollector, viewProj);
    if(this.m_deferredState.m_debugLineCollector.empty())
        return Optional<GpuTaskId>();

    const Span<GpuDebugLineVertex> depthVerts = this.m_deferredState.m_debugLineCollector.depthTestedVertices();
    const Span<GpuDebugLineVertex> overlayVerts = this.m_deferredState.m_debugLineCollector.overlayVertices();
    const usize totalVertices = depthVerts.size() + overlayVerts.size();
    if(totalVertices == 0u || depthVerts.size() > cast<usize>(u32.max) || overlayVerts.size() > cast<usize>(u32.max) || totalVertices > cast<usize>(u32.max))
        return MakeUnexpected(Failure());

    if(!targets.compositeFramebuffer.valid() || !targets.compositeDebugFramebuffer.valid() || !compositeColor.valid() || (!depthVerts.empty() && !depth.valid()) || !compositeTask.valid())
        return MakeUnexpected(Failure());

    if(!this.createDeferredDebugLinePipelines(targets.compositeDebugFramebuffer.deref(), targets.compositeFramebuffer.deref()))
        return MakeUnexpected(Failure());

    if(!this.ensureDeferredDebugLineVertexBuffer(totalVertices))
        return MakeUnexpected(Failure());

    GpuUploadBlobId vertsBlob;
    if(overlayVerts.empty()){
        const auto blobRes = graph.copyUploadElements<GpuDebugLineVertex>(depthVerts);
        if(!blobRes.has_value())
            return MakeUnexpected(Failure());
        vertsBlob = blobRes.value();
    }
    else if(depthVerts.empty()){
        const auto blobRes = graph.copyUploadElements<GpuDebugLineVertex>(overlayVerts);
        if(!blobRes.has_value())
            return MakeUnexpected(Failure());
        vertsBlob = blobRes.value();
    }
    else{
        this.m_deferredState.m_debugLineCombinedScratch.clear();
        this.m_deferredState.m_debugLineCombinedScratch.reserve(totalVertices);
        for(usize i = 0u; i < depthVerts.size(); ++i)
            this.m_deferredState.m_debugLineCombinedScratch.push_back(depthVerts[i]);
        for(usize i = 0u; i < overlayVerts.size(); ++i)
            this.m_deferredState.m_debugLineCombinedScratch.push_back(overlayVerts[i]);

        const auto blobRes = graph.copyUploadElements<GpuDebugLineVertex>(Span<GpuDebugLineVertex>(this.m_deferredState.m_debugLineCombinedScratch.data(), totalVertices));
        if(!blobRes.has_value())
            return MakeUnexpected(Failure());
        vertsBlob = blobRes.value();
    }

    const auto debugVertsResourceResult = ImportExternalBuffer(
        graph,
        this.m_deferredState.m_debugLineVertexBuffer,
        Name(s_RenderNameRenderDeferredDebugLinesVerts),
        "Deferred Debug Line Vertices",
        ResourceStates::Common,
        ResourceStates::Common
    );
    if(!debugVertsResourceResult.has_value())
        return MakeUnexpected(Failure());
    const GpuGraphResourceId debugVertsResource = debugVertsResourceResult.value();

    GpuTaskSchedulingHint uploadScheduling;
    uploadScheduling.cost = GpuTaskCostHint::Tiny;
    uploadScheduling.forceSubmissionBoundary = false;
    uploadScheduling.allowPacketMerge = true;
    uploadScheduling.mergeWithPrevious = true;
    GpuTaskDesc uploadDesc;
    uploadDesc
        .setIdentity(Name(s_RenderNameRenderDeferredDebugLinesVertsUpload))
        .setMarkerLabel("Deferred Debug Line Vertices Upload")
        .setScheduling(uploadScheduling)
    ;
    GpuUploadBufferTaskDesc uploadTaskDesc;
    uploadTaskDesc.source = vertsBlob;
    uploadTaskDesc.destination = debugVertsResource;
    uploadTaskDesc.finalState = ResourceStates::ShaderResource;
    const auto uploadTaskResult = graph.addUploadBufferTask(uploadDesc, uploadTaskDesc);
    if(!uploadTaskResult.has_value())
        return MakeUnexpected(Failure());

    FixedVector<GpuTaskResourceUse, 3u> drawUses;
    drawUses.push_back(ReadUse(debugVertsResource, ResourceStates::ShaderResource));
    drawUses.push_back(ReadWriteUse(compositeColor, ResourceStates::RenderTarget));
    if(!depthVerts.empty())
        drawUses.push_back(ReadUse(depth, ResourceStates::DepthRead));
    const Array<GpuTaskId, 2u> drawDependencies(compositeTask, uploadTaskResult.value());
    GpuTaskSchedulingHint drawScheduling;
    drawScheduling.cost = GpuTaskCostHint::Small;
    drawScheduling.forceSubmissionBoundary = false;
    drawScheduling.allowPacketMerge = true;
    drawScheduling.mergeWithPrevious = true;
    GpuTaskDesc drawDesc;
    drawDesc
        .setIdentity(Name(s_RenderNameRenderDeferredDebugLines))
        .setMarkerLabel("Deferred Debug Lines")
        .setScheduling(drawScheduling)
        .setDependencies(drawDependencies)
        .setResourceUses(Span<GpuTaskResourceUse>(drawUses.data(), drawUses.size()))
    ;
    const auto drawTaskResult = graph.addPayloadTask(
        drawDesc,
        DeferredDebugLinesGraphTask(this, targets, viewProj, cast<u32>(depthVerts.size()), cast<u32>(overlayVerts.size()))
    );
    if(!drawTaskResult.has_value())
        return MakeUnexpected(Failure());
    return Optional<GpuTaskId>(drawTaskResult.value());
}


