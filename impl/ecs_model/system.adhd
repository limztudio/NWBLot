const StringView s_ModelSystemAssetLoadContext = "ModelSystem";

type ModelObjectRendererApplyFn = Func<void(in EntityID, in AssetRef<Material>, mut World, mut Entity)>;
type ModelObjectRendererCallback = Optional<ModelObjectRendererApplyFn>;

class ModelObjectRendererHooks{
    public ModelObjectRendererCallback apply;
    public FixedVector<ComponentAccess, 4u> accesses;

    public ModelObjectRendererHooks(){
        this.apply = ModelObjectRendererCallback();
        this.accesses = FixedVector<ComponentAccess, 4u>();
    }

    public ModelObjectRendererHooks(in ModelObjectRendererCallback inApply, in Span<ComponentAccess> inAccesses){
        this.apply = inApply;
        this.accesses = FixedVector<ComponentAccess, 4u>();
        assert(inAccesses.size() <= 4u);
        for(in ComponentAccess access : inAccesses)
            this.accesses.push_back(access);
    }
}

void ResetModelRuntimeState(mut ModelRuntimeComponent outRuntime){
    outRuntime.model = s_NameNone;
    outRuntime.objectCount = 0u;
}

b8 MatchesModelObjectIdentity(in ModelObjectComponent object, in EntityID owner, in Name objectName){
    return object.owner == owner && object.object == objectName;
}

MatrixSingle ComputeModelObjectWorldMatrix(in MatrixSingle parentMatrix, in MatrixSingle localMatrix){
    return Mul(parentMatrix, localMatrix);
}

MatrixSingle ComputeModelJointAttachmentWorldMatrix(
    in MatrixSingle parentMatrix,
    in MatrixSingle jointMatrix,
    in MatrixSingle localMatrix
){
    return Mul(Mul(parentMatrix, jointMatrix), localMatrix);
}

void ResolveModelAttachmentJointQueries(
    in Span<usize> parentOrder,
    in World world,
    mut Vector<SkeletonJointMatrix> jointPalette,
    mut Vector<ModelAttachmentJointQuery> queries
){
    const usize queryCount = queries.size();
    usize groupBegin = 0u;
    while(groupBegin < queryCount){
        const EntityID parentEntity = queries[ResolveModelAttachmentQueryIndex(parentOrder, groupBegin)].parentEntity;
        const usize groupEnd = FindModelAttachmentJointQueryGroupEnd(parentOrder, queries, groupBegin);

        if(world.hasComponent<SkeletonPoseComponent>(parentEntity)){
            in SkeletonPoseComponent pose = world.getComponent<SkeletonPoseComponent>(parentEntity);
            if(TryBuildStoredJointPaletteVectorFromSkeletonPose(pose, jointPalette).has_value())
                ResolveModelAttachmentJointQueryGroup(parentOrder, jointPalette, groupBegin, groupEnd, queries);
        }
        groupBegin = groupEnd;
    }
}

b8 IsInactiveModelObjectOwner(in World world, in EntityID owner){
    return !world.hasComponent<ModelRuntimeComponent>(owner) || !world.hasComponent<ModelComponent>(owner);
}

void RemoveInactiveModelEntities(mut World world, in usize inactiveObjectCount, in usize inactiveRuntimeCount){
    Vector<EntityID> inactiveEntities = Vector<EntityID>();
    inactiveEntities.reserve(Max(inactiveObjectCount, inactiveRuntimeCount));
    if(inactiveObjectCount != 0u){
        world.view<ModelObjectComponent>().each(lambda[mut world, mut inactiveEntities](in EntityID entity, in ModelObjectComponent object) -> void{
            if(IsInactiveModelObjectOwner(world, object.owner))
                inactiveEntities.push_back(entity);
        });
        for(in EntityID entity : inactiveEntities)
            world.destroyEntity(entity);
    }
    if(inactiveRuntimeCount != 0u){
        // Destroying objects can also remove runtime components.
        inactiveEntities.clear();
        world.view<ModelRuntimeComponent>().each(lambda[mut world, mut inactiveEntities](in EntityID entity, in ModelRuntimeComponent runtime) -> void{
            if(!world.hasComponent<ModelComponent>(entity))
                inactiveEntities.push_back(entity);
        });
        for(in EntityID entity : inactiveEntities)
            world.removeComponent<ModelRuntimeComponent>(entity);
    }
}

void DestroyOwnedModelEntities(mut World world, in EntityID entity, in usize ownedCount){
    Vector<EntityID> ownedEntities = Vector<EntityID>();
    ownedEntities.reserve(ownedCount);
    world.view<ModelObjectComponent>().each(lambda[in entity, mut ownedEntities](in EntityID objectEntity, in ModelObjectComponent object) -> void{
        if(object.owner == entity)
            ownedEntities.push_back(objectEntity);
    });
    for(in EntityID objectEntity : ownedEntities)
        world.destroyEntity(objectEntity);
}

void UpdateNonStaticModelObjectTransform(in World world, in ModelObjectComponent object, mut TransformComponent outTransform){
    if(object.kind == ModelObjectKind::StaticMesh)
        return;

    TryDecomposeAndAssignTransformComponent(
        ComputeModelObjectWorldMatrix(LoadEntityTransformMatrix(world, object.owner), MatrixSingle(object.localTransform)),
        outTransform
    );
}

void AppendModelStaticMeshAttachmentJointQuery(
    in ModelStaticMeshAttachmentComponent attachment,
    mut b8 inOutSharedParent,
    mut Vector<ModelAttachmentJointQuery> inOutJointQueries
){
    if(!attachment.hasJointAttachment())
        return;
    if(!inOutJointQueries.empty() && inOutJointQueries.front().parentEntity != attachment.parentEntity)
        inOutSharedParent = false;
    inOutJointQueries.push_back(MakeModelAttachmentJointQuery(attachment.parentEntity, attachment.parentJointIndex));
}

MatrixSingle ResolveModelStaticMeshAttachmentParentMatrix(in World world, in EntityID owner, in EntityID parentEntity){
    if(parentEntity.valid() && world.hasComponent<TransformComponent>(parentEntity))
        return LoadTransformMatrix(world.getComponent<TransformComponent>(parentEntity));
    return LoadEntityTransformMatrix(world, owner);
}

void UpdateModelStaticMeshAttachmentTransform(
    in World world,
    in usize queryCount,
    in Span<ModelAttachmentJointQuery> jointQueries,
    in ModelObjectComponent object,
    in ModelStaticMeshAttachmentComponent attachment,
    mut usize inOutNextQuery,
    mut TransformComponent outTransform
){
    const MatrixSingle parentMatrix = ResolveModelStaticMeshAttachmentParentMatrix(world, object.owner, attachment.parentEntity);
    const MatrixSingle localMatrix = MatrixSingle(attachment.localTransform);
    if(!attachment.hasJointAttachment()){
        TryDecomposeAndAssignTransformComponent(ComputeModelObjectWorldMatrix(parentMatrix, localMatrix), outTransform);
        return;
    }

    MatrixSingle jointMatrix = MatrixIdentity();
    if(queryCount > 1u){
        in ModelAttachmentJointQuery query = jointQueries[inOutNextQuery];
        ++inOutNextQuery;
        if(!query.resolved)
            return;
        jointMatrix = MatrixSingle(query.jointMatrix);
    }
    else{
        if(!world.hasComponent<SkeletonPoseComponent>(attachment.parentEntity))
            return;
        const Expected<MatrixSingle> resolvedJointMatrix = TryEvaluateSkeletonPoseJointMatrix(
            world.getComponent<SkeletonPoseComponent>(attachment.parentEntity),
            attachment.parentJointIndex
        );
        if(!resolvedJointMatrix.has_value())
            return;
        jointMatrix = resolvedJointMatrix.value();
    }
    TryDecomposeAndAssignTransformComponent(
        ComputeModelJointAttachmentWorldMatrix(parentMatrix, jointMatrix, localMatrix),
        outTransform
    );
}

[arena, system("model")]
class ModelSystem{
    private mut World m_world;
    private mut AssetManager m_assetManager;
    private ModelObjectRendererCallback m_applyRenderer;
    private Vector<SkeletonJointMatrix> m_scratchJoints;
    // Reused across updateStaticMeshAttachments() calls so per-frame updates perform no allocations.
    private Vector<ModelAttachmentJointQuery> m_attachmentJointQueries;
    private Vector<usize> m_attachmentParentOrder;

    public ModelSystem(mut World world, mut AssetManager assetManager){
        this.m_world = world;
        this.m_assetManager = assetManager;
        this.m_applyRenderer = ModelObjectRendererCallback();
        this.registerDefaultAccesses();
    }

    public ModelSystem(mut World world, mut AssetManager assetManager, in ModelObjectRendererHooks rendererHooks){
        this.m_world = world;
        this.m_assetManager = assetManager;
        this.m_applyRenderer = rendererHooks.apply;
        this.registerDefaultAccesses();

        for(usize i = 0u; i < rendererHooks.accesses.size(); ++i)
            this.registerAccess(rendererHooks.accesses[i].typeId, rendererHooks.accesses[i].mode);
    }

    public void prepare(mut World world)override{
        this.syncModelRuntimes();
    }

    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta)override{
        const Expected<void, CpuTaskAdmissionError> transformed = this.updateModelObjectTransforms();
        if(!transformed.has_value())
            return MakeUnexpected(transformed.error());
        this.updateStaticMeshAttachments();
        return Expected<void, CpuTaskAdmissionError>();
    }

    public void syncModelRuntimes();

    private void registerDefaultAccesses(){
        this.readAccess<ModelComponent>();
        this.writeAccess<ModelRuntimeComponent>();
        this.writeAccess<ModelObjectComponent>();
        this.writeAccess<ModelSkeletonComponent>();
        this.writeAccess<ModelStaticMeshAttachmentComponent>();
        this.writeAccess<MeshComponent>();
        this.writeAccess<SkinnedMeshBindingComponent>();
        this.writeAccess<TransformComponent>();
        this.writeAccess<SkeletonPoseComponent>();
    }

    private void clearInactiveModelRuntimes();
    private void ensureModelRuntime(in EntityID entity, in ModelComponent component){
        if(!component.model.valid()){
            this.clearModelRuntime(entity);
            this.m_world.removeComponent<ModelRuntimeComponent>(entity);
            return;
        }

        if(this.m_world.hasComponent<ModelRuntimeComponent>(entity)){
            in ModelRuntimeComponent existing = this.m_world.getComponent<ModelRuntimeComponent>(entity);
            if(existing.model == component.model.name())
                return;
        }
        else
            this.m_world.addComponent<ModelRuntimeComponent>(entity);

        this.clearModelRuntime(entity);
        mut ModelRuntimeComponent runtime = this.m_world.getComponent<ModelRuntimeComponent>(entity);

        const Name modelName = component.model.name();
        const Expected<UniquePtr<Model>> loadedModel = LoadTypedAssetSync<Model>(this.m_assetManager, modelName, s_ModelSystemAssetLoadContext);
        if(!loadedModel.has_value() || !loadedModel.value().valid()){
            ResetModelRuntimeState(runtime);
            return;
        }

        in Model model = loadedModel.value().deref();
        if(!this.expandModel(entity, model, runtime))
            this.clearModelRuntime(entity);
    }
    private void clearModelRuntime(in EntityID entity);

    private b8 expandModel(in EntityID owner, in Model model, mut ModelRuntimeComponent runtime){
        runtime.model = model.virtualPath();
        runtime.objectCount = 0u;

        b8 complete = true;
        for(in ModelSkeletonObject object : model.skeletonObjects()){
            if(this.spawnSkeletonObject(owner, object))
                ++runtime.objectCount;
            else
                complete = false;
        }
        for(in ModelStaticMeshObject object : model.staticMeshObjects()){
            if(this.spawnStaticMeshObject(owner, object))
                ++runtime.objectCount;
            else
                complete = false;
        }
        for(in ModelSkinnedMeshObject object : model.skinnedMeshObjects()){
            if(this.spawnSkinnedMeshObject(owner, object))
                ++runtime.objectCount;
            else
                complete = false;
        }

        return complete;
    }

    private b8 spawnSkeletonObject(in EntityID owner, in ModelSkeletonObject object){
        const Name skeletonName = object.skeleton.name();
        assert(skeletonName != s_NameNone);
        Expected<UniquePtr<Skeleton>> skeletonAsset = LoadTypedAssetSync<Skeleton>(this.m_assetManager, skeletonName, s_ModelSystemAssetLoadContext);
        if(!skeletonAsset.has_value() || !skeletonAsset.value().valid())
            return false;
        in Skeleton skeleton = skeletonAsset.value().deref();

        Entity entity = this.createSpawnedObjectEntity(owner, object.name, MatrixSingle(object.transform), ModelObjectKind::Skeleton);

        mut SkeletonPoseComponent pose = entity.addComponent<SkeletonPoseComponent>();
        InitializeSkeletonPoseFromJoints(skeleton.joints(), pose);

        mut ModelSkeletonComponent skeletonComponent = entity.addComponent<ModelSkeletonComponent>();
        skeletonComponent.skeleton = object.skeleton;

        return true;
    }

    private b8 spawnStaticMeshObject(in EntityID owner, in ModelStaticMeshObject object){
        Entity entity = this.createSpawnedObjectEntity(owner, object.name, MatrixSingle(object.transform), ModelObjectKind::StaticMesh);
        if(this.m_applyRenderer.has_value()){
            const ModelObjectRendererApplyFn applyFn = this.m_applyRenderer.value();
            applyFn(owner, object.material, this.m_world, entity);
        }

        mut MeshComponent mesh = entity.addComponent<MeshComponent>();
        mesh.mesh = object.mesh;

        mut ModelStaticMeshAttachmentComponent attachment = entity.addComponent<ModelStaticMeshAttachmentComponent>();
        attachment.localTransform = object.transform;

        assert(object.parentObject != s_NameNone || object.parentJoint == s_NameNone);
        if(object.parentObject != s_NameNone){
            attachment.parentEntity = this.findSpawnedObject(owner, object.parentObject);
            const b8 parentValid = attachment.parentEntity.valid();
            const b8 parentIsSkeleton = parentValid && this.m_world.hasComponent<ModelSkeletonComponent>(attachment.parentEntity);
            if(!ValidateModelStaticMeshParentEntity(object.name, object.parentObject, parentValid, parentIsSkeleton))
                return false;

            if(object.parentJoint != s_NameNone){
                const Name skeletonName = this.m_world.getComponent<ModelSkeletonComponent>(attachment.parentEntity).skeleton.name();
                if(skeletonName == s_NameNone)
                    return false;
                Expected<UniquePtr<Skeleton>> skeletonAsset = LoadTypedAssetSync<Skeleton>(this.m_assetManager, skeletonName, s_ModelSystemAssetLoadContext);
                if(!skeletonAsset.has_value() || !skeletonAsset.value().valid())
                    return false;
                in Skeleton skeleton = skeletonAsset.value().deref();

                attachment.parentJointIndex = skeleton.findJointIndex(object.parentJoint);
                if(!ValidateModelStaticMeshParentJoint(object.name, object.parentObject, object.parentJoint, attachment.parentJointIndex))
                    return false;
            }
        }

        return true;
    }

    private b8 spawnSkinnedMeshObject(in EntityID owner, in ModelSkinnedMeshObject object){
        const EntityID skeletonEntity = this.findSpawnedObject(owner, object.skeletonObject);
        if(!ValidateModelSkinnedMeshSkeletonEntity(object.name, skeletonEntity.valid()))
            return false;

        Entity entity = this.createSpawnedObjectEntity(owner, object.name, MatrixSingle(object.transform), ModelObjectKind::SkinnedMesh);
        if(this.m_applyRenderer.has_value()){
            const ModelObjectRendererApplyFn applyFn = this.m_applyRenderer.value();
            applyFn(owner, object.material, this.m_world, entity);
        }

        mut SkinnedMeshBindingComponent binding = entity.addComponent<SkinnedMeshBindingComponent>();
        binding.skin = object.skin;
        binding.skeletonEntity = skeletonEntity;
        return true;
    }

    private Entity createSpawnedObjectEntity(in EntityID owner, in Name objectName, in MatrixSingle localMatrix, in ModelObjectKind kind){
        Entity entity = this.m_world.createEntity();
        mut ModelObjectComponent modelObject = entity.addComponent<ModelObjectComponent>();
        modelObject = MakeModelObjectComponent(owner, this.m_world.entity(owner).getComponent<ModelRuntimeComponent>().model, objectName, localMatrix, kind);
        mut TransformComponent transform = entity.addComponent<TransformComponent>();
        TryDecomposeAndAssignTransformComponent(ComputeModelObjectWorldMatrix(LoadEntityTransformMatrix(this.m_world, owner), localMatrix), transform);
        return entity;
    }

    private EntityID findSpawnedObject(in EntityID owner, in Name objectName)const;
    private Expected<void, CpuTaskAdmissionError> updateModelObjectTransforms();
    private void updateStaticMeshAttachments();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ModelSystem::syncModelRuntimes(){
    this.clearInactiveModelRuntimes();
    mut ModelSystem system = this;
    this.m_world.view<ModelComponent>().each(lambda[mut system](in EntityID entity, in ModelComponent component) -> void{
        system.ensureModelRuntime(entity, component);
    });
}

void ModelSystem::clearInactiveModelRuntimes(){
    mut World world = this.m_world;
    const auto objects = world.view<ModelObjectComponent>();
    const auto runtimes = world.view<ModelRuntimeComponent>();
    usize inactiveObjectCount = 0u;
    objects.each(lambda[in world, mut inactiveObjectCount](in EntityID entity, in ModelObjectComponent object) -> void{
        if(IsInactiveModelObjectOwner(world, object.owner))
            ++inactiveObjectCount;
    });
    usize inactiveRuntimeCount = 0u;
    runtimes.each(lambda[in world, mut inactiveRuntimeCount](in EntityID entity, in ModelRuntimeComponent runtime) -> void{
        if(!world.hasComponent<ModelComponent>(entity))
            ++inactiveRuntimeCount;
    });
    if(inactiveObjectCount == 0u && inactiveRuntimeCount == 0u)
        return;

    RemoveInactiveModelEntities(world, inactiveObjectCount, inactiveRuntimeCount);
}

void ModelSystem::clearModelRuntime(in EntityID entity){
    const auto objects = this.m_world.view<ModelObjectComponent>();
    usize ownedCount = 0u;
    objects.each(lambda[in entity, mut ownedCount](in EntityID objectEntity, in ModelObjectComponent object) -> void{
        if(object.owner == entity)
            ++ownedCount;
    });
    if(ownedCount != 0u)
        DestroyOwnedModelEntities(this.m_world, entity, ownedCount);
    if(this.m_world.hasComponent<ModelRuntimeComponent>(entity))
        ResetModelRuntimeState(this.m_world.getComponent<ModelRuntimeComponent>(entity));
}

EntityID ModelSystem::findSpawnedObject(in EntityID owner, in Name objectName)const{
    for(in auto row : this.m_world.view<ModelObjectComponent>()){
        if(MatchesModelObjectIdentity(Get<1>(row), owner, objectName))
            return Get<0>(row);
    }
    return s_InvalidEntityId;
}

Expected<void, CpuTaskAdmissionError> ModelSystem::updateModelObjectTransforms(){
    mut World world = this.m_world;
    return world.view<ModelObjectComponent, TransformComponent>().parallelEach(
        world.taskScope(),
        s_ParallelModelObjectTransformGrainSize,
        lambda[in world](in EntityID entity, in ModelObjectComponent object, mut TransformComponent transform) -> void{
            UpdateNonStaticModelObjectTransform(world, object, transform);
        }
    );
}

void ModelSystem::updateStaticMeshAttachments(){
    mut World world = this.m_world;
    const auto attachments = world.view<ModelObjectComponent, ModelStaticMeshAttachmentComponent, TransformComponent>();
    usize queryCount = 0u;
    if(attachments.candidateCount() > 1u){
        attachments.each(lambda[mut queryCount](in EntityID entity, in ModelObjectComponent object, in ModelStaticMeshAttachmentComponent attachment, in TransformComponent transform) -> void{
            if(attachment.hasJointAttachment())
                ++queryCount;
        });
    }

    mut Vector<ModelAttachmentJointQuery> jointQueries = this.m_attachmentJointQueries;
    jointQueries.clear();
    if(queryCount > 1u){
        jointQueries.reserve(queryCount);
        b8 sharedParent = true;
        attachments.each(lambda[mut sharedParent, mut jointQueries](in EntityID entity, in ModelObjectComponent object, in ModelStaticMeshAttachmentComponent attachment, in TransformComponent transform) -> void{
            AppendModelStaticMeshAttachmentJointQuery(attachment, sharedParent, jointQueries);
        });
        if(sharedParent)
            ResolveModelAttachmentJointQueries(Span<usize>(), world, this.m_scratchJoints, jointQueries);
        else{
            BuildSortedModelAttachmentParentOrder(jointQueries, this.m_attachmentParentOrder);
            ResolveModelAttachmentJointQueries(this.m_attachmentParentOrder, world, this.m_scratchJoints, jointQueries);
        }
    }

    usize nextQuery = 0u;
    attachments.each(lambda[in world, in queryCount, in jointQueries, mut nextQuery](in EntityID entity, in ModelObjectComponent object, in ModelStaticMeshAttachmentComponent attachment, mut TransformComponent transform) -> void{
        UpdateModelStaticMeshAttachmentTransform(world, queryCount, jointQueries, object, attachment, nextQuery, transform);
    });
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

