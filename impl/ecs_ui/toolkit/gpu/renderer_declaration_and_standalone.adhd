#include <impl/ecs_ui/toolkit/gpu/image_resources.adhd>
#include <impl/ecs_ui/toolkit/gpu/renderer_internal.adhd>
#include <impl/ecs_ui/toolkit/gpu/renderer_tasks.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class GpuFrameTimingEndTask{
    private mut GpuTimingFrameTransaction m_transaction;

    public GpuFrameTimingEndTask(mut GpuTimingFrameTransaction transaction){
        this.m_transaction = transaction;
    }

    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements commands;
        commands.requiresPrimaryGraphicsQueue = true;
        return commands;
    }

    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const{
        return this.m_transaction.recordEnd(commands);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsGpuPendingFrameReadyToDeclare(in b8 hasPending, in b8 framePrepared, in b8 readyToDeclare){
    return hasPending && framePrepared && readyToDeclare;
}

b8 CanReuseDeclaredGpuOutputLayer(
    in b8 claimed,
    in b8 sameGraph,
    in u64 declaredGraphGeneration,
    in u64 currentGraphGeneration
){
    return claimed && sameGraph && declaredGraphGeneration == currentGraphGeneration;
}

GpuTaskResourceUse GpuLayerResourceUse(in GpuGraphResourceId resource, in ResourceStates required, in GpuTaskResourceAccess access){
    GpuTaskResourceUse use;
    use.resource = resource;
    use.requiredState = required;
    use.access = access;
    return use;
}

GpuTaskTimingMetadata GpuLayerTiming(in u32 resolutionClass, in GpuTaskTimingPolicy policy){
    GpuTaskTimingMetadata timing;
    timing.resolutionClass = resolutionClass;
    timing.policy = policy;
    return timing;
}

Name ResolveGpuRasterPipelineName(in usize modeIndex){
    if(modeIndex == cast<usize>(PaintBlendMode::Additive))
        return s_GpuRasterPipelineAdditiveName;
    if(modeIndex == cast<usize>(PaintBlendMode::Multiply))
        return s_GpuRasterPipelineMultiplyName;
    if(modeIndex == cast<usize>(PaintBlendMode::Screen))
        return s_GpuRasterPipelineScreenName;
    if(modeIndex == cast<usize>(PaintBlendMode::Erase))
        return s_GpuRasterPipelineEraseName;
    if(modeIndex == cast<usize>(PaintBlendMode::Replace))
        return s_GpuRasterPipelineReplaceName;
    return s_GpuRasterPipelineName;
}

Expected<Name> MakeGpuIndexedTaskName(in Name prefix, in usize index){
    CompactString suffix = CompactString("");
    AppendUnsignedU64Text(suffix, cast<u64>(index));
    return DeriveName(prefix, suffix.view());
}

Expected<GpuTaskId> ImportGpuScratchTarget(
    mut GpuTaskGraph graph,
    in GpuVersion<GpuTargetVersion> target,
    in Name readyIdentity,
    in StringView readyLabel,
    in Name textureIdentity,
    in StringView textureLabel,
    mut GpuGraphResourceId outTexture
){
    GpuExternalCompletionDesc readyDesc;
    readyDesc.setIdentity(readyIdentity);
    readyDesc.setMarkerLabel(readyLabel);
    readyDesc.setToken(target.deref().m_readinessToken);
    const auto readyResult = graph.importExternalCompletion(readyDesc);
    if(!readyResult.has_value())
        return MakeUnexpected(Failure());
    GpuGraphResourceDesc texDesc;
    texDesc.setIdentity(textureIdentity);
    texDesc.setMarkerLabel(textureLabel);
    texDesc.setType(GpuGraphResourceType::Texture);
    texDesc.setInitialAvailabilityCompletion(readyResult.value());
    texDesc.setExternalFinalState(ResourceStates::ShaderResource);
    const auto texResult = graph.importTexture(target.deref().m_color, texDesc);
    if(!texResult.has_value())
        return MakeUnexpected(Failure());
    outTexture = texResult.value();
    return GpuTaskId();
}

Expected<GpuTaskGraphOutputLayer> GpuRendererState::declare(mut GpuTaskGraph graph, in b8 allowEmptySceneLayer){
    mut GraphicsRuntime graphics = this.m_graphics;
    GpuTaskGraphOutputLayer layer;
    if(!IsGpuPendingFrameReadyToDeclare(this.m_pending.valid(), this.m_pending.valid() && this.m_pending.deref().m_prepared, this.m_readyToDeclare))
        return layer;
    in AcquiredPresentationFrame prepared = this.m_pending.deref().m_acquired;
    if(!MatchesGpuAcquiredPresentationFrame(graphics.acquiredPresentationFrame(), prepared))
        return layer;
    u64 generation = 0u;
    {
        const GpuTaskGraphDeclarationReadView view(graph);
        if(!view.valid())
            return MakeUnexpected(Failure());
        generation = view.generation();
    }
    const b8 sameGraph = this.m_declaredGraph.has_value() && SameAddress(this.m_declaredGraph.value(), graph);
    if(CanReuseDeclaredGpuOutputLayer(this.m_claimed, sameGraph, this.m_graphGeneration, generation))
        return this.m_declaredLayer;
    if(!this.m_pending.deref().prefixComplete(graphics.getDevice()))
        return layer;
    GpuFrame frame = this.m_pending;
    mut GpuFrameData data = frame.deref();
    data.m_vertexUpload = QueueSubmissionToken();
    data.m_indexUpload = QueueSubmissionToken();
    data.m_effectUpload = QueueSubmissionToken();
    data.m_clear = QueueSubmissionToken();
    data.m_raster = QueueSubmissionToken();
    data.m_extraTokens.clear();
    in DrawSnapshot snapshot = data.m_snapshot;
    if(
        allowEmptySceneLayer
        && IsEmptyGpuSceneSnapshot(snapshot.commands().size(), snapshot.vertices().size(), snapshot.indices().size(), snapshot.glyphPages().size(), snapshot.sdfPages().size(), snapshot.textureImages().size())
        && snapshot.effectWords().empty()
        && snapshot.effectLayers().empty()
    ){
        layer.frameGeneration = snapshot.generation();
        this.m_declaredLayer = layer;
        this.m_declaredGraph = Optional<in GpuTaskGraph>(graph);
        this.m_graphGeneration = generation;
        this.m_claimed = true;
        return layer;
    }
    GpuExternalCompletionDesc targetReadyDesc;
    targetReadyDesc.setIdentity(s_GpuLayerReadyName);
    targetReadyDesc.setMarkerLabel(s_GpuLayerReadyMarkerLabel);
    targetReadyDesc.setToken(data.m_target.deref().m_readinessToken);
    const auto targetReadyResult = graph.importExternalCompletion(targetReadyDesc);
    if(!targetReadyResult.has_value())
        return MakeUnexpected(Failure());
    const GpuExternalCompletionId targetReady = targetReadyResult.value();
    GpuGraphResourceDesc colorDesc;
    colorDesc.setIdentity(s_GpuLayerTextureName);
    colorDesc.setMarkerLabel(s_GpuLayerMarkerLabel);
    colorDesc.setType(GpuGraphResourceType::Texture);
    colorDesc.setInitialAvailabilityCompletion(targetReady);
    colorDesc.setExternalFinalState(ResourceStates::ShaderResource);
    const auto colorResult = graph.importTexture(
        data.m_target.deref().m_color,
        colorDesc
    );
    GpuExternalCompletionDesc skinReadyDesc;
    skinReadyDesc.setIdentity(s_GpuAtlasReadyName);
    skinReadyDesc.setMarkerLabel(s_GpuAtlasReadyMarkerLabel);
    skinReadyDesc.setToken(data.m_skin.deref().m_texture.readinessToken);
    const auto skinReadyResult = graph.importExternalCompletion(skinReadyDesc);
    if(!colorResult.has_value() || !skinReadyResult.has_value())
        return MakeUnexpected(Failure());
    const GpuExternalCompletionId skinReady = skinReadyResult.value();
    const GpuGraphResourceId color = colorResult.value();
    GpuGraphResourceDesc skinDesc;
    skinDesc.setIdentity(s_GpuAtlasTextureName);
    skinDesc.setMarkerLabel(s_GpuAtlasMarkerLabel);
    skinDesc.setType(GpuGraphResourceType::Texture);
    skinDesc.setInitialAvailabilityCompletion(skinReady);
    skinDesc.setExternalFinalState(ResourceStates::ShaderResource);
    const auto skinResult = graph.importTexture(
        data.m_skin.deref().m_texture.texture,
        skinDesc
    );
    GpuGraphResourceVersionDesc versionDesc;
    versionDesc.setResource(color);
    versionDesc.setOrigin(GpuGraphResourceVersionOrigin::TaskProduced);
    const auto versionResult = graph.declareResourceVersion(versionDesc);
    if(!skinResult.has_value() || !versionResult.has_value())
        return MakeUnexpected(Failure());
    const GpuGraphResourceVersionId version = versionResult.value();
    const GpuGraphResourceId skin = skinResult.value();

    Array<GpuGraphPipelineId, s_PaintBlendModeCount> pipelines;
    for(usize modeIdx = 0u; modeIdx < s_PaintBlendModeCount; ++modeIdx){
        GpuGraphPipelineDesc pipelineDesc;
        pipelineDesc.setIdentity(ResolveGpuRasterPipelineName(modeIdx));
        pipelineDesc.setMarkerLabel(s_GpuRasterPipelineMarkerLabel);
        pipelineDesc.setType(GpuGraphPipelineType::Graphics);
        const auto pipelineResult = graph.importGraphicsPipeline(data.m_resources.deref().m_pipelines[modeIdx], pipelineDesc);
        if(!pipelineResult.has_value())
            return MakeUnexpected(Failure());
        pipelines[modeIdx] = pipelineResult.value();
    }

    GpuTaskSchedulingHint layerScheduling;
    layerScheduling.cost = GpuTaskCostHint::Small;
    layerScheduling.allowParallelRecording = true;
    layerScheduling.allowSameClassQueueRouting = true;
    layerScheduling.preferNonPrimarySameClassQueue = true;
    FixedVector<GpuTaskId, s_GpuRasterDependencyCapacity> uploadDeps;
    GpuRasterResourceUses commonUses;
    GpuGraphResourceId vertices;
    GpuGraphResourceId indices;
    GpuGraphResourceId effectBuffer;
    commonUses.push_back(GpuLayerResourceUse(skin, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read));
    auto glyphPages = DeclareGpuGlyphPages(graph, snapshot, data.m_glyphPages, this.m_sampledTextureNames, commonUses);
    if(!glyphPages.has_value())
        return MakeUnexpected(Failure());
    auto sdfPages = DeclareGpuSdfPages(graph, snapshot, data.m_sdfPages, this.m_sampledTextureNames, commonUses);
    if(!sdfPages.has_value())
        return MakeUnexpected(Failure());
    auto textureImages = DeclareGpuTextureImages(graph, snapshot, data.m_textureImages, this.m_sampledTextureNames, commonUses);
    if(!textureImages.has_value())
        return MakeUnexpected(Failure());
    if(!snapshot.vertices().empty()){
        GpuGraphResourceDesc verticesDesc;
        verticesDesc.setIdentity(s_GpuVertexBufferName);
        verticesDesc.setMarkerLabel(s_GpuVerticesMarkerLabel);
        verticesDesc.setType(GpuGraphResourceType::Buffer);
        verticesDesc.setExternalFinalState(ResourceStates::Common);
        const auto verticesResult = graph.importBuffer(
            data.m_vertices,
            verticesDesc
        );
        GpuGraphResourceDesc indicesDesc;
        indicesDesc.setIdentity(s_GpuIndexBufferName);
        indicesDesc.setMarkerLabel(s_GpuIndicesMarkerLabel);
        indicesDesc.setType(GpuGraphResourceType::Buffer);
        indicesDesc.setExternalFinalState(ResourceStates::Common);
        const auto indicesResult = graph.importBuffer(
            data.m_indices,
            indicesDesc
        );
        if(!verticesResult.has_value() || !indicesResult.has_value())
            return MakeUnexpected(Failure());
        vertices = verticesResult.value();
        indices = indicesResult.value();
        const auto vertexBytesResult = graph.copyUploadElements<Vertex>(Span<Vertex>(snapshot.vertices()));
        const auto indexBytesResult = graph.copyUploadElements<u32>(Span<u32>(snapshot.indices()));
        if(!vertexBytesResult.has_value() || !indexBytesResult.has_value())
            return MakeUnexpected(Failure());
        const GpuUploadBlobId vertexBytes = vertexBytesResult.value();
        const GpuUploadBlobId indexBytes = indexBytesResult.value();
        GpuUploadBufferTaskDesc vertexUploadDesc;
        vertexUploadDesc.source = vertexBytes;
        vertexUploadDesc.destination = vertices;
        vertexUploadDesc.finalState = ResourceStates::Common;
        vertexUploadDesc.publishAcceptedToken(data.m_vertexUpload);
        GpuTaskDesc vertexUploadTaskDesc;
        vertexUploadTaskDesc.setIdentity(s_GpuVertexUploadTaskName).setMarkerLabel(s_GpuVertexUploadMarkerLabel).setScheduling(layerScheduling);
        const auto vertexUploadResult = graph.addUploadBufferTask(vertexUploadTaskDesc, vertexUploadDesc);
        GpuUploadBufferTaskDesc indexUploadDesc;
        indexUploadDesc.source = indexBytes;
        indexUploadDesc.destination = indices;
        indexUploadDesc.finalState = ResourceStates::Common;
        indexUploadDesc.publishAcceptedToken(data.m_indexUpload);
        GpuTaskDesc indexUploadTaskDesc;
        indexUploadTaskDesc.setIdentity(s_GpuIndexUploadTaskName).setMarkerLabel(s_GpuIndexUploadMarkerLabel).setScheduling(layerScheduling);
        const auto indexUploadResult = graph.addUploadBufferTask(indexUploadTaskDesc, indexUploadDesc);
        if(!vertexUploadResult.has_value() || !indexUploadResult.has_value())
            return MakeUnexpected(Failure());
        uploadDeps.push_back(vertexUploadResult.value());
        uploadDeps.push_back(indexUploadResult.value());
        commonUses.push_back(GpuLayerResourceUse(vertices, ResourceStates::VertexBuffer, GpuTaskResourceAccess::Read));
        commonUses.push_back(GpuLayerResourceUse(indices, ResourceStates::IndexBuffer, GpuTaskResourceAccess::Read));
    }
    if(!snapshot.effectWords().empty()){
        if(!data.m_effectBuffer.valid())
            return MakeUnexpected(Failure());
        GpuGraphResourceDesc effectDesc;
        effectDesc.setIdentity(s_GpuEffectBufferName);
        effectDesc.setMarkerLabel(s_GpuEffectsMarkerLabel);
        effectDesc.setType(GpuGraphResourceType::Buffer);
        effectDesc.setExternalFinalState(ResourceStates::Common);
        const auto effectBufResult = graph.importBuffer(data.m_effectBuffer.deref().m_buffer, effectDesc);
        const auto effectBytesResult = graph.copyUploadElements<u32>(Span<u32>(snapshot.effectWords()));
        if(!effectBufResult.has_value() || !effectBytesResult.has_value())
            return MakeUnexpected(Failure());
        effectBuffer = effectBufResult.value();
        GpuUploadBufferTaskDesc effectUploadDesc;
        effectUploadDesc.source = effectBytesResult.value();
        effectUploadDesc.destination = effectBuffer;
        effectUploadDesc.finalState = ResourceStates::Common;
        effectUploadDesc.publishAcceptedToken(data.m_effectUpload);
        GpuTaskDesc effectUploadTaskDesc;
        effectUploadTaskDesc.setIdentity(s_GpuEffectUploadTaskName).setMarkerLabel(s_GpuEffectUploadMarkerLabel).setScheduling(layerScheduling);
        const auto effectUploadResult = graph.addUploadBufferTask(effectUploadTaskDesc, effectUploadDesc);
        if(!effectUploadResult.has_value())
            return MakeUnexpected(Failure());
        uploadDeps.push_back(effectUploadResult.value());
        commonUses.push_back(GpuLayerResourceUse(effectBuffer, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read));
    }

    GpuClearTextureTaskDesc clearDesc;
    clearDesc.publishAcceptedToken(data.m_clear);
    clearDesc.destination = color;
    clearDesc.valueType = GpuClearTextureTaskValueType::Float;
    GpuTaskDesc clearTaskDesc;
    clearTaskDesc.setIdentity(s_GpuClearTaskName).setMarkerLabel(s_GpuClearMarkerLabel).setScheduling(layerScheduling);
    const auto clearResult = graph.addClearTextureTask(clearTaskDesc, clearDesc);
    if(!clearResult.has_value())
        return MakeUnexpected(Failure());
    const GpuTaskId clear = clearResult.value();

    GpuTaskId readyTask = clear;
    if(snapshot.effectLayers().empty()){
        FixedVector<GpuTaskId, s_GpuRasterDependencyCapacity> dependencies = uploadDeps;
        dependencies.push_back(clear);
        GpuRasterResourceUses uses;
        uses.push_back(GpuLayerResourceUse(color, ResourceStates::RenderTarget, GpuTaskResourceAccess::Write));
        for(in GpuTaskResourceUse u : commonUses)
            uses.push_back(u);
        GpuTaskResourceVersionUse produce;
        produce.version = version;
        produce.role = GpuTaskResourceVersionRole::Produce;
        const Array<GpuTaskResourceVersionUse, 1u> versions(produce);
        GpuRasterTask rasterPayload;
        rasterPayload.frame = frame;
        rasterPayload.color = color;
        rasterPayload.skin = skin;
        rasterPayload.pipelines = pipelines;
        rasterPayload.vertices = vertices;
        rasterPayload.indices = indices;
        rasterPayload.effectBuffer = effectBuffer;
        rasterPayload.glyphPages = glyphPages.value();
        rasterPayload.sdfPages = sdfPages.value();
        rasterPayload.textureImages = textureImages.value();
        rasterPayload.commandBegin = 0u;
        rasterPayload.commandEnd = snapshot.commands().size();
        rasterPayload.captureIndex = usize.max;
        rasterPayload.tokenSlotIndex = usize.max;
        rasterPayload.sampledScratchSlot = s_ShaderUiInvalidHeapSlot;
        rasterPayload.targetKind = 0u;
        rasterPayload.passMode = 0u;
        GpuTaskDesc rasterDesc;
        rasterDesc.setIdentity(s_GpuRasterTaskName).setMarkerLabel(s_GpuRasterMarkerLabel)
            .setScheduling(layerScheduling).setDependencies(dependencies).setResourceUses(uses)
            .setResourceVersionUses(versions)
            .setTiming(GpuLayerTiming(ComputeGpuTimingResolutionHash(this.m_width, this.m_height), GpuTaskTimingPolicy::Task));
        const auto rasterResult = graph.addPayloadTask(rasterDesc, rasterPayload);
        if(!rasterResult.has_value())
            return MakeUnexpected(Failure());
        readyTask = rasterResult.value();
    }
    else{
        if(!data.m_scratchA.valid() || !data.m_scratchB.valid())
            return MakeUnexpected(Failure());
        GpuGraphResourceId scratchA;
        GpuGraphResourceId scratchB;
        if(
            !ImportGpuScratchTarget(graph, data.m_scratchA, s_GpuScratchAReadyName, s_GpuScratchAReadyMarkerLabel, s_GpuScratchATextureName, s_GpuScratchAMarkerLabel, scratchA).has_value()
            || !ImportGpuScratchTarget(graph, data.m_scratchB, s_GpuScratchBReadyName, s_GpuScratchBReadyMarkerLabel, s_GpuScratchBTextureName, s_GpuScratchBMarkerLabel, scratchB).has_value()
        )
            return MakeUnexpected(Failure());

        in Vector<DrawCommand> mainCmds = snapshot.commands();
        in Vector<PaintEffectLayer> effectLayers = snapshot.effectLayers();
        data.m_extraTokens.resize(effectLayers.size() * 5u + 1u, QueueSubmissionToken());
        usize mainCursor = 0u;
        usize nextCaptureIdx = 0u;
        usize nextTokenIdx = 0u;
        usize passSeq = 0u;
        usize layerSeq = 0u;
        GpuTaskId prevMainTask = clear;
        b8 hasPendingScratch = false;
        GpuTaskId scratchProducerTask;
        u32 scratchSamplerSlot = s_ShaderUiInvalidHeapSlot;
        const u32 scratchASlot = data.m_scratchA.deref().m_sampledImage.slot();
        const u32 scratchBSlot = data.m_scratchB.deref().m_sampledImage.slot();

        for(usize cmdIdx = 0u; cmdIdx <= mainCmds.size(); ++cmdIdx){
            const b8 isEnd = cmdIdx == mainCmds.size();
            const b8 isLayerComposite = !isEnd && mainCmds[cmdIdx].material == PaintMaterial::EffectLayerComposite;
            if(!isEnd && !isLayerComposite)
                continue;

            if(cmdIdx > mainCursor || isEnd){
                FixedVector<GpuTaskId, s_GpuRasterDependencyCapacity> dependencies = uploadDeps;
                dependencies.push_back(prevMainTask);
                if(hasPendingScratch)
                    dependencies.push_back(scratchProducerTask);
                GpuRasterResourceUses uses;
                uses.push_back(GpuLayerResourceUse(color, ResourceStates::RenderTarget, GpuTaskResourceAccess::Write));
                for(in GpuTaskResourceUse u : commonUses)
                    uses.push_back(u);
                if(hasPendingScratch)
                    uses.push_back(GpuLayerResourceUse(scratchA, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read));

                GpuRasterTask segPayload;
                segPayload.frame = frame;
                segPayload.color = color;
                segPayload.skin = skin;
                segPayload.pipelines = pipelines;
                segPayload.vertices = vertices;
                segPayload.indices = indices;
                segPayload.effectBuffer = effectBuffer;
                segPayload.glyphPages = glyphPages.value();
                segPayload.sdfPages = sdfPages.value();
                segPayload.textureImages = textureImages.value();
                segPayload.commandBegin = mainCursor;
                segPayload.commandEnd = cmdIdx;
                segPayload.targetKind = 0u;
                segPayload.passMode = 0u;
                if(hasPendingScratch){
                    segPayload.sampledScratch = scratchA;
                    segPayload.sampledScratchSlot = scratchSamplerSlot;
                }

                Name taskName = s_GpuRasterTaskName;
                if(!isEnd){
                    const auto genName = MakeGpuIndexedTaskName(s_GpuRasterPassPrefix, passSeq);
                    if(!genName.has_value())
                        return MakeUnexpected(Failure());
                    taskName = genName.value();
                    segPayload.captureIndex = nextCaptureIdx;
                    segPayload.tokenSlotIndex = nextTokenIdx;
                    ++nextCaptureIdx;
                    ++nextTokenIdx;
                    ++passSeq;
                }
                else{
                    segPayload.captureIndex = usize.max;
                    segPayload.tokenSlotIndex = usize.max;
                }

                GpuTaskDesc segDesc;
                segDesc.setIdentity(taskName).setMarkerLabel(s_GpuRasterMarkerLabel)
                    .setScheduling(layerScheduling).setDependencies(dependencies).setResourceUses(uses)
                    .setTiming(GpuLayerTiming(ComputeGpuTimingResolutionHash(this.m_width, this.m_height), GpuTaskTimingPolicy::Task));
                if(isEnd){
                    GpuTaskResourceVersionUse produce;
                    produce.version = version;
                    produce.role = GpuTaskResourceVersionRole::Produce;
                    const Array<GpuTaskResourceVersionUse, 1u> versions(produce);
                    segDesc.setResourceVersionUses(versions);
                }
                const auto segResult = graph.addPayloadTask(segDesc, segPayload);
                if(!segResult.has_value())
                    return MakeUnexpected(Failure());
                prevMainTask = segResult.value();
                hasPendingScratch = false;
                scratchSamplerSlot = s_ShaderUiInvalidHeapSlot;
                if(isEnd){
                    readyTask = prevMainTask;
                    break;
                }
            }

            if(isLayerComposite){
                const usize layerIdx = cast<usize>(mainCmds[cmdIdx].effectOffset);
                if(layerIdx >= effectLayers.size())
                    return MakeUnexpected(Failure());
                in PaintEffectLayer effectLayer = effectLayers[layerIdx];

                const auto clearAName = MakeGpuIndexedTaskName(s_GpuEffectClearPrefix, layerSeq);
                const auto capName = MakeGpuIndexedTaskName(s_GpuEffectCapturePrefix, layerSeq);
                if(!clearAName.has_value() || !capName.has_value())
                    return MakeUnexpected(Failure());

                const Array<GpuTaskId, 1u> clearADeps(prevMainTask);
                GpuClearTextureTaskDesc clearADesc;
                clearADesc.destination = scratchA;
                clearADesc.valueType = GpuClearTextureTaskValueType::Float;
                GpuTaskDesc clearATaskDesc;
                clearATaskDesc.setIdentity(clearAName.value()).setMarkerLabel(s_GpuEffectClearMarkerLabel)
                    .setScheduling(layerScheduling).setDependencies(clearADeps);
                const auto clearAResult = graph.addClearTextureTask(clearATaskDesc, clearADesc);
                if(!clearAResult.has_value())
                    return MakeUnexpected(Failure());

                FixedVector<GpuTaskId, s_GpuRasterDependencyCapacity> capDeps = uploadDeps;
                capDeps.push_back(clearAResult.value());
                GpuRasterResourceUses capUses;
                capUses.push_back(GpuLayerResourceUse(scratchA, ResourceStates::RenderTarget, GpuTaskResourceAccess::Write));
                for(in GpuTaskResourceUse u : commonUses)
                    capUses.push_back(u);
                GpuRasterTask capPayload;
                capPayload.frame = frame;
                capPayload.color = scratchA;
                capPayload.skin = skin;
                capPayload.pipelines = pipelines;
                capPayload.vertices = vertices;
                capPayload.indices = indices;
                capPayload.effectBuffer = effectBuffer;
                capPayload.glyphPages = glyphPages.value();
                capPayload.sdfPages = sdfPages.value();
                capPayload.textureImages = textureImages.value();
                capPayload.commandBegin = cast<usize>(effectLayer.commandBegin);
                capPayload.commandEnd = cast<usize>(effectLayer.commandEnd);
                capPayload.captureIndex = nextCaptureIdx;
                capPayload.tokenSlotIndex = nextTokenIdx;
                capPayload.targetKind = 1u;
                capPayload.passMode = 1u;
                ++nextCaptureIdx;
                ++nextTokenIdx;
                GpuTaskDesc capDesc;
                capDesc.setIdentity(capName.value()).setMarkerLabel(s_GpuEffectCaptureMarkerLabel)
                    .setScheduling(layerScheduling).setDependencies(capDeps).setResourceUses(capUses);
                const auto capResult = graph.addPayloadTask(capDesc, capPayload);
                if(!capResult.has_value())
                    return MakeUnexpected(Failure());

                GpuTaskId readyScratch = capResult.value();
                if(effectLayer.blurRadius > 0.0f){
                    const auto clearBName = MakeGpuIndexedTaskName(s_GpuEffectClearBPrefix, layerSeq);
                    const auto blurHName = MakeGpuIndexedTaskName(s_GpuEffectBlurHPrefix, layerSeq);
                    const auto clearA2Name = MakeGpuIndexedTaskName(s_GpuEffectClearA2Prefix, layerSeq);
                    const auto blurVName = MakeGpuIndexedTaskName(s_GpuEffectBlurVPrefix, layerSeq);
                    if(!clearBName.has_value() || !blurHName.has_value() || !clearA2Name.has_value() || !blurVName.has_value())
                        return MakeUnexpected(Failure());

                    const Array<GpuTaskId, 1u> clearBDeps(readyScratch);
                    GpuClearTextureTaskDesc clearBDesc;
                    clearBDesc.destination = scratchB;
                    clearBDesc.valueType = GpuClearTextureTaskValueType::Float;
                    GpuTaskDesc clearBTaskDesc;
                    clearBTaskDesc.setIdentity(clearBName.value()).setMarkerLabel(s_GpuEffectClearMarkerLabel)
                        .setScheduling(layerScheduling).setDependencies(clearBDeps);
                    const auto clearBResult = graph.addClearTextureTask(clearBTaskDesc, clearBDesc);
                    if(!clearBResult.has_value())
                        return MakeUnexpected(Failure());

                    FixedVector<GpuTaskId, s_GpuRasterDependencyCapacity> blurHDeps = uploadDeps;
                    blurHDeps.push_back(clearBResult.value());
                    blurHDeps.push_back(readyScratch);
                    GpuRasterResourceUses blurHUses;
                    blurHUses.push_back(GpuLayerResourceUse(scratchB, ResourceStates::RenderTarget, GpuTaskResourceAccess::Write));
                    blurHUses.push_back(GpuLayerResourceUse(scratchA, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read));
                    for(in GpuTaskResourceUse u : commonUses)
                        blurHUses.push_back(u);
                    DrawCommand blurHCmd;
                    blurHCmd.clip = effectLayer.expandedBounds;
                    blurHCmd.firstIndex = effectLayer.blurFirstIndex;
                    blurHCmd.indexCount = s_PaintQuadIndexCount;
                    blurHCmd.material = PaintMaterial::Blur;
                    blurHCmd.effectOffset = effectLayer.blurHorizontalOffset;
                    blurHCmd.blendMode = PaintBlendMode::Replace;
                    GpuRasterTask blurHPayload;
                    blurHPayload.frame = frame;
                    blurHPayload.color = scratchB;
                    blurHPayload.skin = skin;
                    blurHPayload.pipelines = pipelines;
                    blurHPayload.vertices = vertices;
                    blurHPayload.indices = indices;
                    blurHPayload.effectBuffer = effectBuffer;
                    blurHPayload.sampledScratch = scratchA;
                    blurHPayload.sampledScratchSlot = scratchASlot;
                    blurHPayload.glyphPages = glyphPages.value();
                    blurHPayload.sdfPages = sdfPages.value();
                    blurHPayload.textureImages = textureImages.value();
                    blurHPayload.syntheticCommand = blurHCmd;
                    blurHPayload.captureIndex = nextCaptureIdx;
                    blurHPayload.tokenSlotIndex = nextTokenIdx;
                    blurHPayload.targetKind = 2u;
                    blurHPayload.passMode = 2u;
                    ++nextCaptureIdx;
                    ++nextTokenIdx;
                    GpuTaskDesc blurHDesc;
                    blurHDesc.setIdentity(blurHName.value()).setMarkerLabel(s_GpuEffectBlurHMarkerLabel)
                        .setScheduling(layerScheduling).setDependencies(blurHDeps).setResourceUses(blurHUses);
                    const auto blurHResult = graph.addPayloadTask(blurHDesc, blurHPayload);
                    if(!blurHResult.has_value())
                        return MakeUnexpected(Failure());

                    const Array<GpuTaskId, 1u> clearA2Deps(blurHResult.value());
                    GpuClearTextureTaskDesc clearA2Desc;
                    clearA2Desc.destination = scratchA;
                    clearA2Desc.valueType = GpuClearTextureTaskValueType::Float;
                    GpuTaskDesc clearA2TaskDesc;
                    clearA2TaskDesc.setIdentity(clearA2Name.value()).setMarkerLabel(s_GpuEffectClearMarkerLabel)
                        .setScheduling(layerScheduling).setDependencies(clearA2Deps);
                    const auto clearA2Result = graph.addClearTextureTask(clearA2TaskDesc, clearA2Desc);
                    if(!clearA2Result.has_value())
                        return MakeUnexpected(Failure());

                    FixedVector<GpuTaskId, s_GpuRasterDependencyCapacity> blurVDeps = uploadDeps;
                    blurVDeps.push_back(clearA2Result.value());
                    blurVDeps.push_back(blurHResult.value());
                    GpuRasterResourceUses blurVUses;
                    blurVUses.push_back(GpuLayerResourceUse(scratchA, ResourceStates::RenderTarget, GpuTaskResourceAccess::Write));
                    blurVUses.push_back(GpuLayerResourceUse(scratchB, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read));
                    for(in GpuTaskResourceUse u : commonUses)
                        blurVUses.push_back(u);
                    DrawCommand blurVCmd;
                    blurVCmd.clip = effectLayer.expandedBounds;
                    blurVCmd.firstIndex = effectLayer.blurFirstIndex;
                    blurVCmd.indexCount = s_PaintQuadIndexCount;
                    blurVCmd.material = PaintMaterial::Blur;
                    blurVCmd.effectOffset = effectLayer.blurVerticalOffset;
                    blurVCmd.blendMode = PaintBlendMode::Replace;
                    GpuRasterTask blurVPayload;
                    blurVPayload.frame = frame;
                    blurVPayload.color = scratchA;
                    blurVPayload.skin = skin;
                    blurVPayload.pipelines = pipelines;
                    blurVPayload.vertices = vertices;
                    blurVPayload.indices = indices;
                    blurVPayload.effectBuffer = effectBuffer;
                    blurVPayload.sampledScratch = scratchB;
                    blurVPayload.sampledScratchSlot = scratchBSlot;
                    blurVPayload.glyphPages = glyphPages.value();
                    blurVPayload.sdfPages = sdfPages.value();
                    blurVPayload.textureImages = textureImages.value();
                    blurVPayload.syntheticCommand = blurVCmd;
                    blurVPayload.captureIndex = nextCaptureIdx;
                    blurVPayload.tokenSlotIndex = nextTokenIdx;
                    blurVPayload.targetKind = 1u;
                    blurVPayload.passMode = 2u;
                    ++nextCaptureIdx;
                    ++nextTokenIdx;
                    GpuTaskDesc blurVDesc;
                    blurVDesc.setIdentity(blurVName.value()).setMarkerLabel(s_GpuEffectBlurVMarkerLabel)
                        .setScheduling(layerScheduling).setDependencies(blurVDeps).setResourceUses(blurVUses);
                    const auto blurVResult = graph.addPayloadTask(blurVDesc, blurVPayload);
                    if(!blurVResult.has_value())
                        return MakeUnexpected(Failure());
                    readyScratch = blurVResult.value();
                }
                hasPendingScratch = true;
                scratchProducerTask = readyScratch;
                scratchSamplerSlot = scratchASlot;
                mainCursor = cmdIdx;
                ++layerSeq;
            }
        }
    }
    layer.readyTask = readyTask;
    layer.color = color;
    layer.colorVersion = version;
    layer.sampledImage = data.m_target.deref().m_sampledImage;
    layer.frameGeneration = snapshot.generation();
    this.m_declaredLayer = layer;
    this.m_declaredGraph = Optional<in GpuTaskGraph>(graph);
    this.m_graphGeneration = generation;
    this.m_claimed = true;
    return layer;
}

Expected<GpuTaskId> GpuRendererState::declareStandalone(mut GpuTaskGraph graph, mut GpuTimingFrameTransaction frameTimingTransaction){
    mut GraphicsRuntime graphics = this.m_graphics;
    if(!IsGpuPendingFrameReadyToDeclare(this.m_pending.valid(), this.m_pending.valid() && this.m_pending.deref().m_prepared, this.m_readyToDeclare))
        return MakeUnexpected(Failure());
    GpuTaskSchedulingHint beginScheduling;
    beginScheduling.cost = GpuTaskCostHint::Tiny;
    beginScheduling.forceSubmissionBoundary = true;
    beginScheduling.allowPacketMerge = false;
    GpuTimingScopeDefinition timingScope;
    if(this.m_frameTimingScopePrepared)
        timingScope = s_UiFrameTimingScope;
    GpuTaskDesc beginDesc;
    beginDesc.setIdentity(s_GpuFrameTimingBeginTaskName).setMarkerLabel(s_GpuFrameTimingBeginMarkerLabel)
        .setScheduling(beginScheduling)
        .setTiming(GpuLayerTiming(0u, GpuTaskTimingPolicy::PacketOnly));
    const auto beginResult = AddFrameTimingBeginTask(graph,
        beginDesc,
        frameTimingTransaction, graphics.getDevice(), timingScope);
    if(!beginResult.has_value() || !graph.setNormalExecutionPrelude(beginResult.value()))
        return MakeUnexpected(Failure());
    const auto layer = this.declare(graph, false);
    if(!layer.has_value())
        return MakeUnexpected(layer.error());
    if(!layer.value().color.valid())
        return MakeUnexpected(Failure());
    GpuFrame frame = this.m_pending;
    GpuExternalCompletionDesc acquiredDesc;
    acquiredDesc.setIdentity(s_GpuAcquiredReadyName);
    acquiredDesc.setMarkerLabel(s_GpuAcquiredMarkerLabel);
    acquiredDesc.setToken(frame.deref().m_acquired.backBuffer.availabilityCompletion);
    const auto acquiredResult = graph.importExternalCompletion(acquiredDesc);
    if(!acquiredResult.has_value())
        return MakeUnexpected(Failure());
    const GpuExternalCompletionId acquired = acquiredResult.value();
    GpuGraphResourceDesc backBufferDesc;
    backBufferDesc.setIdentity(s_GpuBackBufferTextureName);
    backBufferDesc.setMarkerLabel(s_GpuBackBufferMarkerLabel);
    backBufferDesc.setType(GpuGraphResourceType::Texture);
    backBufferDesc.setInitialState(frame.deref().m_acquired.backBuffer.nativeInitialState);
    backBufferDesc.setExternalFinalState(ResourceStates::Present);
    backBufferDesc.setInitialAvailabilityCompletion(acquired);
    const auto backBufferResult = graph.importTexture(
        frame.deref().m_acquired.backBuffer.texture,
        backBufferDesc
    );
    GpuGraphPipelineDesc pipelineDesc;
    pipelineDesc.setIdentity(s_GpuOutputPipelineName);
    pipelineDesc.setMarkerLabel(s_GpuOutputPipelineMarkerLabel);
    pipelineDesc.setType(GpuGraphPipelineType::Graphics);
    const auto pipelineResult = graph.importGraphicsPipeline(frame.deref().m_outputPipeline, pipelineDesc);
    if(!backBufferResult.has_value() || !pipelineResult.has_value())
        return MakeUnexpected(Failure());
    const GpuGraphPipelineId pipeline = pipelineResult.value();
    const GpuGraphResourceId backBuffer = backBufferResult.value();
    const Array<GpuTaskResourceUse, s_GpuOutputResourceUseCount> uses(
        GpuLayerResourceUse(layer.value().color, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read),
        GpuLayerResourceUse(backBuffer, ResourceStates::RenderTarget, GpuTaskResourceAccess::Write)
    );
    GpuTaskResourceVersionUse consume;
    consume.version = layer.value().colorVersion;
    consume.role = GpuTaskResourceVersionRole::Consume;
    const Array<GpuTaskResourceVersionUse, 1u> versions(consume);
    GpuTaskSchedulingHint scheduling;
    scheduling.cost = GpuTaskCostHint::Small;
    scheduling.avoidQueueCrossing = true;
    GpuOutputTask outputPayload;
    outputPayload.frame = frame;
    outputPayload.backBuffer = backBuffer;
    outputPayload.color = layer.value().color;
    outputPayload.graphPipeline = pipeline;
    outputPayload.acquired = frame.deref().m_acquired;
    outputPayload.pipeline = frame.deref().m_outputPipeline;
    outputPayload.presentationMode = frame.deref().m_presentationMode;
    GpuTaskDesc outputDesc;
    outputDesc.setIdentity(s_GpuOutputTaskName).setMarkerLabel(s_GpuStandaloneOutputMarkerLabel)
        .setScheduling(scheduling).setDependency(layer.value().readyTask).setResourceUses(uses)
        .setResourceVersionUses(versions)
        .setTiming(GpuLayerTiming(ComputeGpuTimingResolutionHash(this.m_width, this.m_height), GpuTaskTimingPolicy::Task));
    const auto outputResult = graph.addPayloadTask(outputDesc, outputPayload);
    if(!outputResult.has_value())
        return MakeUnexpected(Failure());
    const GpuTaskId output = outputResult.value();
    GpuTaskId timingEndDependency = output;
    if(this.m_presentationContributor.has_value() && this.m_presentationContributor.value().hasTaskGraphPresentationWork()){
        const auto timingEndDependencyResult = this.m_presentationContributor.value().declareTaskGraphPresentation(graph, frame.deref().m_acquired, backBuffer, output);
        if(!timingEndDependencyResult.has_value())
            return MakeUnexpected(Failure());
        timingEndDependency = timingEndDependencyResult.value();
    }
    GpuTaskSchedulingHint timingEndScheduling;
    timingEndScheduling.cost = GpuTaskCostHint::Tiny;
    timingEndScheduling.overlapPreferred = false;
    timingEndScheduling.avoidQueueCrossing = true;
    timingEndScheduling.forceSubmissionBoundary = true;
    timingEndScheduling.allowPacketMerge = false;
    GpuTaskDesc terminalDesc;
    terminalDesc.setIdentity(s_GpuFrameTimingEndTaskName).setMarkerLabel(s_GpuFrameTimingEndMarkerLabel)
        .setScheduling(timingEndScheduling).setDependency(timingEndDependency)
        .setTiming(GpuLayerTiming(0u, GpuTaskTimingPolicy::PacketOnly));
    const auto terminalResult = graph.addPayloadTask(
        terminalDesc,
        GpuFrameTimingEndTask(frameTimingTransaction));
    if(!terminalResult.has_value())
        return MakeUnexpected(Failure());
    GpuPresentEndpoint endpoint;
    endpoint.producer = terminalResult.value();
    endpoint.backBuffer = backBuffer;
    if(!graph.declarePresentEndpoint(endpoint))
        return MakeUnexpected(Failure());
    return terminalResult.value();
}

void GpuRendererState::acceptOutputLayer(in u64 frameGeneration, in QueueSubmissionToken submissionToken){
    GpuFrame frame = this.m_pending;
    if(!frame.valid() || !MatchesPendingGpuFrameGeneration(true, frame.deref().m_snapshot.generation(), frameGeneration))
        return;
    [essential] assert(IsValidGpuSubmissionReadinessToken(submissionToken.valid(), submissionToken.hasPhysicalQueueIdentity()));
    frame.deref().m_finalConsumer = submissionToken;
    this.m_lastAcceptedAcquired = frame.deref().m_acquired;
    this.m_lastAcceptedGeneration = frameGeneration;
    this.m_pending.reset();
    this.m_claimed = false;
    this.m_declaredGraph.reset();
    this.m_graphGeneration = 0u;
    this.m_declaredLayer = GpuTaskGraphOutputLayer();
    this.m_readyToDeclare = false;
}

b8 GpuRendererState::renderStandalone(in AcquiredPresentationFrame frame){
    mut GraphicsRuntime graphics = this.m_graphics;
    if(!MatchesGpuAcquiredPresentationFrame(graphics.acquiredPresentationFrame(), frame))
        return false;
    if(MatchesGpuAcquiredPresentationFrame(this.m_lastAcceptedAcquired, frame))
        return true;
    if(!this.m_pending.valid())
        return false;
    in AcquiredPresentationFrame prepared = this.m_pending.deref().m_acquired;
    if(this.m_claimed && MatchesGpuAcquiredPresentationFrame(prepared, frame))
        return true;
    if(!this.prepare(frame))
        return false;
    if(!this.m_pending.deref().m_prepared || !this.m_readyToDeclare)
        return false;
    this.m_presentationContributor.reset();
    const auto contributor = graphics.borrowTaskGraphPresentationContributor();
    if(contributor.has_value()){
        if(contributor.value().prepareTaskGraphPresentation(frame))
            this.m_presentationContributor = contributor;
        else if(graphics.isDeviceRecreationRequested())
            return false;
        else
            warning("GpuRenderer: presentation contributor preparation failed; presenting UI output without its contribution");
    }
    const GpuPhysicalQueueId queue = graphics.getDevice().getPrimaryPhysicalQueue(CommandQueue::Graphics);
    if(!queue.valid())
        return false;
    GpuFrame pending = this.m_pending;
    GpuTimingFrameTransaction frameTimingTransaction(graphics.gpuTiming());
    const auto submitted = graphics.standaloneGraph().submitStandaloneTaskGraphWithTiming(lambda[mut this, mut frameTimingTransaction](mut GpuTaskGraph graph) -> Expected<GpuTaskId> {
        return this.declareStandalone(graph, frameTimingTransaction);
    }, queue, graphics.gpuTiming(), frameTimingTransaction);
    this.m_presentationContributor.reset();
    if(pending.deref().m_finalConsumer.valid())
        this.acceptOutputLayer(pending.deref().m_snapshot.generation(), pending.deref().m_finalConsumer);
    if(!submitted.has_value() || !submitted.value().valid()){
        this.m_claimed = false;
        this.m_declaredGraph.reset();
        return false;
    }
    return pending.deref().m_finalConsumer.valid();
}


