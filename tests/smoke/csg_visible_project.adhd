namespace NWB::Tests::Smoke{
using CsgVisibleMaterialRef = SmokeMaterialRef;
using Core::Perf::CaptureOptions;

[[nodiscard]] NWB_INLINE FramebufferCaptureOptions MakeCsgTemporalCaptureOptions(u64& nextCaptureFrame)noexcept{
    return FramebufferCaptureOptions{
        .shouldCapture = +[](void* const ctx, const u64 frame)noexcept -> b8{
            return frame >= *MakeNotNull(static_cast<const u64*>(ctx));
        },
        .predicateContext = &nextCaptureFrame,
        .requiredWidth = 1280u,
        .requiredHeight = 900u,
        .quitWhenReady = false
    };
}

inline constexpr AStringView s_GiTemporalEnvironment = "NWB_CSG_GI_TEMPORAL";
inline constexpr f32 s_CameraStartDepth = 6.5f;
inline constexpr Float2U s_CameraStart = Float2U(0.0f, s_CsgVisibleCameraTargetY);
inline constexpr f32 s_DefaultDirectionalLightPitch = -0.65f;
inline constexpr f32 s_DefaultDirectionalLightYaw = 0.45f;
inline constexpr f32 s_DefaultDirectionalLightIntensity = 3.0f;
inline constexpr f32 s_CubeRotationSpeed = 0.25f;
inline constexpr f32 s_MaxAnimationDelta = 1.0f / 15.0f;
inline constexpr CsgVisibleMaterialRef s_SolidMaterial{"project/smoke/csg_visible/materials/solid"};
inline constexpr CsgVisibleMaterialRef s_IndirectMaterial{"project/smoke/csg_visible/materials/indirect"};
inline constexpr CsgVisibleMaterialRef s_DirectMaterial{"project/smoke/csg_visible/materials/direct"};
inline constexpr CsgVisibleMaterialRef s_NormalMaterial{"project/smoke/csg_visible/materials/normal"};
inline constexpr CsgVisibleMaterialRef s_PositionMaterial{"project/smoke/csg_visible/materials/position"};
inline constexpr CsgVisibleMaterialRef s_CapStateMaterial{"project/smoke/csg_visible/materials/cap_state"};
inline constexpr CsgVisibleMaterialRef s_IntervalStateMaterial{"project/smoke/csg_visible/materials/interval_state"};
inline constexpr CsgVisibleMaterialRef s_EventStateMaterial{"project/smoke/csg_visible/materials/event_state"};
inline constexpr CsgVisibleMaterialRef s_EventDataMaterial{"project/smoke/csg_visible/materials/event_data"};
inline constexpr CsgVisibleMaterialRef s_EventOrderMaterial{"project/smoke/csg_visible/materials/event_order"};
inline constexpr CsgVisibleMaterialRef s_SpanStateMaterial{"project/smoke/csg_visible/materials/span_state"};
inline constexpr u32 s_TemporalSampleCount = 32u;
inline constexpr u64 s_TemporalMinimumFrame = 360u;
inline constexpr f64 s_TemporalWarmupSeconds = 30.0;
inline constexpr u64 s_TemporalFrameInterval = 8u;

[[nodiscard]] NWB_INLINE AStringView CsgVisibleFpsLabel()noexcept{
    return "CsgVisibleSmokeProject";
}

[[nodiscard]] NWB_INLINE NotNullUniquePtr<World> CreateCsgVisibleWorldOrDie(ProjectRuntimeContext& context){
    auto world = CreateSmokeWorldOrDie(CsgVisibleFpsLabel(), context);

    if(context.graphics.queryFeatureSupport(Core::Feature::Meshlets))
        NWB_LOGGER_ESSENTIAL_INFO(NWB_TEXT("CsgVisibleSmokeProject: natural native mesh-shader route selected"));
    else
        NWB_LOGGER_ESSENTIAL_INFO(NWB_TEXT("CsgVisibleSmokeProject: natural indexed route selected because Meshlets are unavailable"));

    auto& renderer = AddSmokeRenderSystems(*world, context);
    if(ReadSmokeEnvironmentFlag(s_GiTemporalEnvironment)){
        Impl::ReflectionSettings reflection;
        reflection.traceMode = Impl::ReflectionTraceMode::Disabled;
        NWB_FATAL_ASSERT_MSG(renderer.setReflectionSettings(reflection), NWB_TEXT("Invalid temporal reflection settings"));
        renderer.setFrameLaggedAsyncLightingEnabled(ReadSmokeEnvironmentFlag("NWB_CSG_GI_TEMPORAL_LAGGED"));
    }

    return world;
}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena]
class CsgVisibleSmokeProject : IProjectEntryCallbacks{
    public CsgVisibleSmokeProject(mut ProjectRuntimeContext context){
        this.m_context = context;
        this.m_world = CreateCsgVisibleWorldOrDie(context);
        this.m_fpsProbe = FpsProbe(CsgVisibleFpsLabel());
        this.m_gpuPassTimingProbe = GpuPassTimingProbe(CsgVisibleFpsLabel());
    }

    public ~CsgVisibleSmokeProject(){
        this.destroyWorld();
    }

    public b8 onStartup()override{
        this.m_temporalEnabled = ReadSmokeEnvironmentFlag(s_GiTemporalEnvironment);
        const b8 overlapping = this.m_temporalEnabled && ReadSmokeEnvironmentFlag("NWB_CSG_GI_TEMPORAL_OVERLAPPING");
        CsgVisibleMaterialRef material = s_SolidMaterial;
        if(this.m_temporalEnabled){
            this.m_context.setPerfCapture(CaptureOptions::GpuTimingOnly());
            const Expected<String> output = ReadSmokeEnvironmentString("NWB_SMOKE_FRAMEBUFFER_CAPTURE_PATH");
            const Expected<String> viewText = ReadSmokeEnvironmentString("NWB_CSG_GI_TEMPORAL_VIEW");
            if(!output.has_value() || !viewText.has_value())
                return false;
            const StringView view = StringView(viewText.value());
            if(view == "indirect")
                material = s_IndirectMaterial;
            else if(view == "direct")
                material = s_DirectMaterial;
            else if(view == "normal")
                material = s_NormalMaterial;
            else if(view == "position")
                material = s_PositionMaterial;
            else if(view == "cap_state")
                material = s_CapStateMaterial;
            else if(view == "interval_state")
                material = s_IntervalStateMaterial;
            else if(view == "event_state")
                material = s_EventStateMaterial;
            else if(view == "event_data"){
                material = s_EventDataMaterial;
                [essential] info("CsgVisibleSmokeProject: event-data red stores missing-span flags divided by 33");
            }
            else if(view == "event_order"){
                material = s_EventOrderMaterial;
                [essential] info("CsgVisibleSmokeProject: event-order RGB stores span/flags and validated raw FRONT=1 BACK=0.5");
            }
            else if(view == "span_state"){
                material = s_SpanStateMaterial;
                [essential] info("CsgVisibleSmokeProject: span-state RGB stores span count, flags, raw event count divided by 33");
            }
            else if(view != "full"){
                return false;
            }

            const FramebufferCaptureOptions captureOptions = MakeCsgTemporalCaptureOptions(this.m_nextCaptureFrame);
            SmokeCaptureFactory captureFactory = SmokeCaptureFactory(this.m_context);
            Expected<SmokeCaptureSeries> captureSeries = captureFactory.prepareSeries(StringView(output.value()), s_TemporalSampleCount, captureOptions);
            if(!captureSeries.has_value())
                return false;
            this.m_capturePaths = captureSeries.value().paths;
            MoveSmokeFramebufferCapture(captureSeries.value().capture, this.m_capture);

            this.m_temporalAnimated = ReadSmokeEnvironmentFlag("NWB_CSG_GI_TEMPORAL_ANIMATED");
            if(overlapping && this.m_temporalAnimated){
                error("CsgVisibleSmokeProject: overlapping receiver regression requires a static scene");
                return false;
            }
            const Expected<String> intervalText = ReadSmokeEnvironmentString("NWB_CSG_GI_TEMPORAL_INTERVAL");
            if(intervalText.has_value()){
                const Expected<u64> interval = ParseU64(StringView(intervalText.value()));
                if(!interval.has_value() || interval.value() == 0u || interval.value() > 64u){
                    error("CsgVisibleSmokeProject: temporal interval must be between 1 and 64");
                    return false;
                }
                this.m_temporalFrameInterval = interval.value();
            }
            u32 animatedVal = 0u;
            if(this.m_temporalAnimated)
                animatedVal = 1u;
            [essential] info(
                "CsgVisibleSmokeProject: temporal scene animated={} view={} minimum_frame=360 warmup_seconds=30 interval={} samples=32"
                , animatedVal
                , view
                , this.m_temporalFrameInterval
            );
            if(this.m_temporalAnimated)
                [essential] info("CsgVisibleSmokeProject: front-facing triangle pose from graphics frame");
        }

        EntityID cameraEntity = s_InvalidEntityId;
        EntityID directionalLight = s_InvalidEntityId;
        native(mut world = this.m_world, mut cameraEntity, mut directionalLight){
            auto activeCameraEntity = world->createEntity();
            auto& activeCamera = activeCameraEntity.addComponent<Impl::Scene::ActiveCameraComponent>();
            activeCamera.camera = Impl::Scene::CreateSceneCameraEntity(*world, Float4(s_CameraStart.x, s_CameraStart.y, -s_CameraStartDepth));
            cameraEntity = activeCamera.camera;
            directionalLight = Impl::Scene::CreateDirectionalLightEntity(*world, s_DefaultDirectionalLightPitch, s_DefaultDirectionalLightYaw, 0.0f, Float4(1.0f, 0.96f, 0.88f), s_DefaultDirectionalLightIntensity);
        }
        this.m_scene.create(material, overlapping, cameraEntity, directionalLight, SmokeWorldRef(this.m_world));
        [essential] info("CsgVisibleSmokeProject: visible CSG interval receiver scene created");
        return true;
    }

    public void onShutdown()override{
        this.destroyWorld();
        [essential] info("CsgVisibleSmokeProject: shutdown");
    }

    public b8 onUpdate(in f32 delta)override{
        f32 safeDelta = 0.0f;
        if(IsFinite(delta))
            safeDelta = Max(delta, 0.0f);
        this.m_fpsProbe.recordFrame(safeDelta);
        if(this.m_temporalEnabled){
            this.m_gpuPassTimingProbe.recordFrame(safeDelta, this.m_context.gpuTimingView());
            const u32 posePhase = cast<u32>(this.m_context.graphics.getFrameIndex() % 240u);
            if(this.m_temporalAnimated)
                this.m_animationTime = cast<f32>(Min(posePhase, 240u - posePhase)) * 0.3f / 120.0f;
            else
                this.m_animationTime = 0.0f;
            this.updateTemporalCapture();
        }
        else
            this.m_animationTime = Min(safeDelta, s_MaxAnimationDelta) * s_CubeRotationSpeed + this.m_animationTime;

        this.m_scene.update(this.m_animationTime, SmokeWorldRef(this.m_world));
        f32 tickDelta = safeDelta;
        if(this.m_temporalEnabled)
            tickDelta = 1.0f / 60.0f;
        return TickSmokeWorld(tickDelta, SmokeWorldRef(this.m_world));
    }

    private void destroyWorld(){
        DestroyCapturedSmokeRenderWorld(this.m_context, this.m_world, this.m_capture);
    }

    private void updateTemporalCapture(){
        if(this.m_temporalSample == s_TemporalSampleCount)
            return;
        if(!this.m_temporalWarmupStarted){
            const u64 frame = this.m_context.graphics.getFrameIndex();
            if(frame < s_TemporalMinimumFrame)
                return;
            this.m_temporalWarmupStart = TimerNow();
            this.m_temporalWarmupStarted = true;
            [essential] info("CsgVisibleSmokeProject: temporal warmup started graphics frame {}", frame);
            return;
        }
        if(!this.m_temporalCaptureStarted){
            const f64 elapsed = DurationInSeconds<f64>(TimerNow(), this.m_temporalWarmupStart);
            if(elapsed < s_TemporalWarmupSeconds)
                return;
            this.m_nextCaptureFrame = this.m_context.graphics.getFrameIndex();
            [essential] info("CsgVisibleSmokeProject: temporal warmup complete elapsed_seconds={:.6f} first_frame={}", elapsed, this.m_nextCaptureFrame);
            this.m_temporalCaptureStarted = true;
            return;
        }
        const u64 invalidFrame = ~cast<u64>(0u);
        if(this.m_temporalFrameInterval == 1u && SmokeFramebufferCapturedFrameIndex(this.m_capture) != invalidFrame){
            if(!this.m_context.graphics.waitForIdle()){
                error("CsgVisibleSmokeProject: consecutive capture completion failed");
                this.m_context.requestQuit();
                return;
            }
        }
        UpdateSmokeFramebufferCapture(this.m_capture);
        if(!SmokeFramebufferCaptureReady(this.m_capture))
            return;
        const u64 sourceFrame = SmokeFramebufferCapturedFrameIndex(this.m_capture);
        if(sourceFrame != this.m_nextCaptureFrame){
            error("CsgVisibleSmokeProject: temporal sample missed frame {} (captured {})", this.m_nextCaptureFrame, sourceFrame);
            this.m_context.requestQuit();
            return;
        }
        [essential] info("CsgVisibleSmokeProject: temporal sample {} graphics frame {}", this.m_temporalSample, sourceFrame);
        ++this.m_temporalSample;
        if(this.m_temporalSample == s_TemporalSampleCount){
            [essential] info("CsgVisibleSmokeProject: temporal series complete samples=32");
            FinishSmokeFramebufferCapture(this.m_capture);
            return;
        }
        this.m_nextCaptureFrame += this.m_temporalFrameInterval;
        if(!RearmSmokeFramebufferCapture(this.m_capture, StringView(this.m_capturePaths[this.m_temporalSample])))
            this.m_context.requestQuit();
    }

    private CsgVisibleScene m_scene = CsgVisibleScene();
    private mut ProjectRuntimeContext m_context;
    private NotNullUniquePtr<World> m_world;
    private FpsProbe m_fpsProbe;
    private GpuPassTimingProbe m_gpuPassTimingProbe;
    private Vector<String> m_capturePaths;
    private UniquePtr<FramebufferCapture> m_capture = UniquePtr<FramebufferCapture>();
    private Timer m_temporalWarmupStart = Timer();
    private u64 m_nextCaptureFrame = ~cast<u64>(0u);
    private u64 m_temporalFrameInterval = s_TemporalFrameInterval;
    private f32 m_animationTime = 0.0f;
    private u32 m_temporalSample = 0u;
    private b8 m_temporalEnabled = false;
    private b8 m_temporalAnimated = false;
    private b8 m_temporalWarmupStarted = false;
    private b8 m_temporalCaptureStarted = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB::ProjectFrameClientSize NWB::QueryProjectFrameClientSize(){
    return { 1280, 900 };
}

TStringView NWB::QueryProjectWindowTitle()noexcept{
    return NWB_TEXT("NWB CSG Visible Smoke");
}

UniquePtr<NWB::IProjectEntryCallbacks> NWB::CreateProjectEntryCallbacks(NWB::ProjectRuntimeContext& context){
    return MakeUnique<NWB::Tests::Smoke::CsgVisibleSmokeProject>(context);
}


