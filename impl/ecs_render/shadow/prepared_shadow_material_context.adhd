#include <impl/ecs_render/shadow/shadow_material_context_policy.adhd>
#include <impl/ecs_render/material/sampled_texture_collection.adhd>
#include <impl/ecs_render/raytrace/graph_snapshots.adhd>
#include <impl/ecs_render/raytrace/renderer_raytracing_state.adhd>
#include <impl/ecs_render/kernel/descriptor_register_utils.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class PendingShadowTextureReset : NoCopy{
    private mut MaterialSampledTextureCollector m_collector;

    public PendingShadowTextureReset(mut MaterialSampledTextureCollector collector){
        this.m_collector = collector;
    }
    public ~PendingShadowTextureReset(){
        this.m_collector.clear();
    }
}

class ShadowMaterialSampledTextureCollector : NoCopy{
    private MaterialSampledTextureCollector m_output;
    private mut Vector<TextureHandle> m_pendingTextures;
    private MaterialSampledTextureCollector m_pending;

    public ShadowMaterialSampledTextureCollector(mut Vector<TextureHandle> textures, mut Vector<TextureHandle> pending){
        this.m_output = MaterialSampledTextureCollector(textures);
        this.m_pendingTextures = pending;
        this.m_pending = MaterialSampledTextureCollector(pending);
    }
    [cpp_unwind]
    public void indexExisting(){
        this.m_output.indexExisting();
    }
    [cpp_unwind]
    public b8 collect(in MaterialSurfaceInfo material, in RendererMaterialResourceState resources){
        PendingShadowTextureReset reset(this.m_pending);
        if(!AppendPreparedMaterialSurfaceSampledTextures(material, resources, this.m_pending))
            return false;
        for(in TextureHandle texture : this.m_pendingTextures){
            if(!texture.valid() || texture.deref().getCreationDescription().name == s_NameNone)
                return false;
            this.m_output.append(texture);
        }
        return true;
    }
}

class PreparedShadowMaterialContext : NoCopy{
    private Vector<u8> m_instanceMaterialBytes;
    private Vector<u8> m_instanceBytes;
    private Vector<u8> m_materialTypedBytes;
    private BufferHandle m_instanceMaterialBuffer;
    private BufferHandle m_instanceBuffer;
    private BufferHandle m_materialTypedBuffer;
    private usize m_instanceMaterialCount = 0u;
    private usize m_instanceCount = 0u;
    private usize m_materialTypedUploadBytes = 0u;
    private usize m_instanceMaterialCapacity = 0u;
    private usize m_instanceCapacity = 0u;
    private usize m_materialTypedCapacity = 0u;
    private u64 m_hash = 0u;
    private GpuDescriptorHandle m_instanceMaterialHeapHandle;
    private GpuDescriptorHandle m_instanceHeapHandle;
    private GpuDescriptorHandle m_materialTypedHeapHandle;
    private PreparedShadowMaterialContextRoute m_route = PreparedShadowMaterialContextRoute::None;
    private b8 m_static = false;
    private b8 m_ready = false;
    private b8 m_uploadRequired = false;

    public b8 capture(
        in RendererRayTracingState state,
        in PreparedShadowMaterialContextRoute route,
        in b8 staticScene,
        in u64 hash,
        in Span<NwbRtInstanceMaterialGpu> instanceMaterials,
        in Span<InstanceGpuData> instances,
        in Span<u8> materialTypedBytes
    );
    public b8 captureCacheReuse(in RendererRayTracingState state, in PreparedShadowMaterialContextRoute route, in u64 hash, in usize instanceMaterialCount, in usize instanceCount, in usize materialTypedByteCount);
    public void clear(){
        this.m_instanceMaterialBytes.clear();
        this.m_instanceBytes.clear();
        this.m_materialTypedBytes.clear();
        this.m_instanceMaterialBuffer.reset();
        this.m_instanceBuffer.reset();
        this.m_materialTypedBuffer.reset();
        this.m_instanceMaterialHeapHandle = GpuDescriptorHandleInvalid();
        this.m_instanceHeapHandle = GpuDescriptorHandleInvalid();
        this.m_materialTypedHeapHandle = GpuDescriptorHandleInvalid();
        this.m_instanceMaterialCount = 0u;
        this.m_instanceCount = 0u;
        this.m_materialTypedUploadBytes = 0u;
        this.m_instanceMaterialCapacity = 0u;
        this.m_instanceCapacity = 0u;
        this.m_materialTypedCapacity = 0u;
        this.m_hash = 0u;
        this.m_route = PreparedShadowMaterialContextRoute::None;
        this.m_static = false;
        this.m_ready = false;
        this.m_uploadRequired = false;
    }

    public Expected<PreparedShadowMaterialContextUploads> retainUploads(in RendererRayTracingState state, mut GpuTaskGraph graph)const;
    public b8 publishAcceptedUpload(mut RendererRayTracingState state)const{
        return ShadowMaterialContextPolicy().publishAcceptedUpload(
            this.m_ready,
            this.m_uploadRequired,
            this.m_route,
            this.m_hash,
            this.m_static,
            state.shadow.m_hwShadowMaterialContextHash,
            state.shadow.m_hwShadowMaterialContextHashValid,
            state.shadow.m_swShadowMaterialContextHash,
            state.shadow.m_swShadowMaterialContextHashValid
        );
    }

    public b8 storageMatches(in RendererRayTracingState state)const{
        return state.shadow.m_shadowInstanceMaterialBuffer == this.m_instanceMaterialBuffer
            && state.shadow.m_shadowInstanceBuffer == this.m_instanceBuffer
            && state.shadow.m_shadowMaterialTypedBuffer == this.m_materialTypedBuffer
            && state.shadow.m_shadowInstanceMaterialHeapHandle == this.m_instanceMaterialHeapHandle
            && state.shadow.m_shadowInstanceHeapHandle == this.m_instanceHeapHandle
            && state.shadow.m_shadowMaterialTypedHeapHandle == this.m_materialTypedHeapHandle;
    }
    public b8 softwareSnapshotCovers(in usize sceneInstanceCount)const{
        return ShadowMaterialContextPolicy().softwareSnapshotCovers(this.m_ready, this.m_route, this.m_instanceMaterialCount, this.m_instanceCount, sceneInstanceCount);
    }
    public b8 softwareSnapshotAccepted(in RendererRayTracingState state)const{
        return ShadowMaterialContextPolicy().softwareSnapshotAccepted(
            this.m_uploadRequired,
            this.m_static,
            state.shadow.m_swShadowMaterialContextHashValid,
            state.shadow.m_swShadowMaterialContextHash,
            this.m_hash,
            state.sceneBvh.m_sceneBvhInstanceCount,
            this.m_instanceCount
        );
    }
    public b8 ready()const{ return this.m_ready; }
    public b8 uploadRequired()const{ return this.m_uploadRequired; }
    public PreparedShadowMaterialContextRoute route()const{ return this.m_route; }

    private void captureStorage(in RendererRayTracingState state, in u64 hash, in usize instanceMaterialCount, in usize instanceCount, in usize materialTypedByteCount){
        this.m_instanceMaterialBuffer = state.shadow.m_shadowInstanceMaterialBuffer;
        this.m_instanceBuffer = state.shadow.m_shadowInstanceBuffer;
        this.m_materialTypedBuffer = state.shadow.m_shadowMaterialTypedBuffer;
        this.m_instanceMaterialHeapHandle = state.shadow.m_shadowInstanceMaterialHeapHandle;
        this.m_instanceHeapHandle = state.shadow.m_shadowInstanceHeapHandle;
        this.m_materialTypedHeapHandle = state.shadow.m_shadowMaterialTypedHeapHandle;
        this.m_instanceMaterialCount = instanceMaterialCount;
        this.m_instanceCount = instanceCount;
        this.m_materialTypedUploadBytes = materialTypedByteCount;
        this.m_instanceMaterialCapacity = state.shadow.m_shadowInstanceMaterialCapacity;
        this.m_instanceCapacity = state.shadow.m_shadowInstanceCapacity;
        this.m_materialTypedCapacity = state.shadow.m_shadowMaterialTypedCapacity;
        this.m_hash = hash;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsPreparedShadowMaterialStorageReady(
    in RendererRayTracingState state,
    in usize instanceMaterialCount,
    in usize instanceCount,
    in usize materialTypedByteCount
){
    return state.shadow.m_shadowInstanceMaterialBuffer.valid()
        && state.shadow.m_shadowInstanceBuffer.valid()
        && state.shadow.m_shadowMaterialTypedBuffer.valid()
        && state.shadow.m_shadowInstanceMaterialCapacity >= instanceMaterialCount
        && state.shadow.m_shadowInstanceCapacity >= instanceCount
        && state.shadow.m_shadowMaterialTypedCapacity >= materialTypedByteCount
        && IsDescriptorClass(state.shadow.m_shadowInstanceMaterialHeapHandle, GpuDescriptorClass::StorageBuffer)
        && IsDescriptorClass(state.shadow.m_shadowInstanceHeapHandle, GpuDescriptorClass::StorageBuffer)
        && IsDescriptorClass(state.shadow.m_shadowMaterialTypedHeapHandle, GpuDescriptorClass::StorageBuffer)
    ;
}

b8 HasPreparedShadowMaterialContextBuffers(
    in RendererRayTracingState state,
    in usize materialCount,
    in usize instanceCount,
    in usize materialTypedUploadBytes
){
    const usize wordByteSize = 4u;
    const usize requiredMaterialTypedBytes = AlignUp(Max(materialTypedUploadBytes, wordByteSize), wordByteSize);
    return IsPreparedShadowMaterialStorageReady(state, materialCount, instanceCount, requiredMaterialTypedBytes);
}


