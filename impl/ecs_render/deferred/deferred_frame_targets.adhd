// Deferred owns these buffers, while the root module freezes their generation for graph imports and ray-tracing payloads.
b8 ValidDeferredCsgTargetLayerCounts(
    in u32 peelLayerCount,
    in u32 receiverEventLayerCount,
    in u32 receiverSpanLayerCount,
    in u32 removedIntervalLayerCount
){
    return peelLayerCount > 0u && receiverEventLayerCount > 0u && receiverSpanLayerCount > 0u && removedIntervalLayerCount > 0u;
}

b8 ValidLaggedLightingHistoryState(in b8 hasTextures, in b8 hasSlotsBuffer, in b8 descriptorsValid, in u64 generation){
    return hasTextures && hasSlotsBuffer && descriptorsValid && generation != 0u;
}

class DeferredLightingGraphResources{
    public BufferHandle sceneShadingBuffer;
    public BufferHandle lightBuffer;

    public DeferredLightingGraphResources(){
    }

    public DeferredLightingGraphResources(in BufferHandle sceneShadingBufferIn, in BufferHandle lightBufferIn){
        this.sceneShadingBuffer = sceneShadingBufferIn;
        this.lightBuffer = lightBufferIn;
    }

    public b8 valid()const{
        return this.sceneShadingBuffer.valid() && this.lightBuffer.valid();
    }
}

// Deferred target generation owns these heap registrations and retires them before target release.
class DeferredBindlessFrameResources{
    public BufferHandle slotsBuffer;
    public DeferredBindlessResourceSlots slots;
    // Shared global-heap UniformBuffer slot payload.
    public GpuDescriptorHandle slotsBufferDescriptor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle gbufferBaseColor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle gbufferNormal = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle gbufferWorldPosition = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle gbufferSpecularRoughness = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle gbufferDepth = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowVisibility = GpuDescriptorHandleInvalid();
    // Writable view of the sampled shadow visibility array.
    public GpuDescriptorHandle shadowVisibilityStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle causticIrradiance = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle causticIrradianceStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle surfelIrradiance = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle surfelIrradianceStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle surfelIrradianceHalf = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle surfelIrradianceHalfStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle sampler = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle opaqueColor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle opaqueColorStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle compositeColor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle compositeColorStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle avboitAccumColor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle avboitAccumExtinction = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle refractionDepth = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle refractionNormalIor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle refractionTintCoverage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle refractionInstance = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle refractionSpecularRoughness = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle refractionResolve = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle refractionResolveStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle avboitForegroundColor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle avboitForegroundExtinction = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle avboitTransmittance = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle avboitLinearSampler = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle sceneShading = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle lightList = GpuDescriptorHandleInvalid();
    // Typed uint accumulator plus floating-point caustic resolve views.
    public GpuDescriptorHandle causticAccumulator = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle causticAccumulatorStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle causticHistory = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle causticHistoryStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle causticResolveHalf = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle causticResolveHalfStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle causticResolveGeometry = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle causticResolveGeometryStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowCoarseTransmittanceStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowSoftGeometry = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowSoftGeometryStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowSoftGeometryPrev = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowSoftGeometryPrevStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowSoftHalfA = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowSoftHalfAStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowSoftHalfB = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowSoftHalfBStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowHistA = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowHistAStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowHistB = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowHistBStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowMomentsA = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowMomentsAStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowMomentsB = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowMomentsBStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle transparentSoftHalf = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle transparentSoftHalfStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle transparentHistA = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle transparentHistAStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle transparentHistB = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle transparentHistBStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle transparentMomentsA = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle transparentMomentsAStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle transparentMomentsB = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle transparentMomentsBStorage = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle csgCapBackNormal = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle csgIntervalDepth = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle csgIntervalId = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle csgReceiverEventData = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle csgReceiverEventCount = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle csgReceiverSpanData = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle csgReceiverSpanCount = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle csgRemovedIntervalDepth = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle csgRemovedIntervalCapNormal = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle csgRemovedIntervalData = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle csgRemovedIntervalCount = GpuDescriptorHandleInvalid();
    public b8 slotsUploaded = false;

    public b8 valid()const{
        return
            this.slotsBuffer.valid()
            && this.slotsBufferDescriptor.valid()
            && this.gbufferBaseColor.valid()
            && this.gbufferNormal.valid()
            && this.gbufferWorldPosition.valid()
            && this.gbufferSpecularRoughness.valid()
            && this.gbufferDepth.valid()
            && this.shadowVisibility.valid()
            && this.shadowVisibilityStorage.valid()
            && this.causticIrradiance.valid()
            && this.causticIrradianceStorage.valid()
            && this.surfelIrradiance.valid()
            && this.surfelIrradianceStorage.valid()
            && this.surfelIrradianceHalf.valid()
            && this.surfelIrradianceHalfStorage.valid()
            && this.sampler.valid()
            && this.opaqueColor.valid()
            && this.opaqueColorStorage.valid()
            && this.compositeColor.valid()
            && this.compositeColorStorage.valid()
            && this.avboitAccumColor.valid()
            && this.avboitAccumExtinction.valid()
            && this.avboitTransmittance.valid()
            && this.avboitLinearSampler.valid()
            && this.sceneShading.valid()
            && this.lightList.valid()
            && this.causticAccumulator.valid()
            && this.causticAccumulatorStorage.valid()
            && this.causticHistory.valid()
            && this.causticHistoryStorage.valid()
            && this.causticResolveHalf.valid()
            && this.causticResolveHalfStorage.valid()
            && this.causticResolveGeometry.valid()
            && this.causticResolveGeometryStorage.valid()
            && this.shadowCoarseTransmittanceStorage.valid()
            && this.shadowSoftGeometry.valid()
            && this.shadowSoftGeometryStorage.valid()
            && this.shadowSoftGeometryPrev.valid()
            && this.shadowSoftGeometryPrevStorage.valid()
            && this.shadowSoftHalfA.valid()
            && this.shadowSoftHalfAStorage.valid()
            && this.shadowSoftHalfB.valid()
            && this.shadowSoftHalfBStorage.valid()
            && this.shadowHistA.valid()
            && this.shadowHistAStorage.valid()
            && this.shadowHistB.valid()
            && this.shadowHistBStorage.valid()
            && this.shadowMomentsA.valid()
            && this.shadowMomentsAStorage.valid()
            && this.shadowMomentsB.valid()
            && this.shadowMomentsBStorage.valid()
            && this.transparentSoftHalf.valid()
            && this.transparentSoftHalfStorage.valid()
            && this.transparentHistA.valid()
            && this.transparentHistAStorage.valid()
            && this.transparentHistB.valid()
            && this.transparentHistBStorage.valid()
            && this.transparentMomentsA.valid()
            && this.transparentMomentsAStorage.valid()
            && this.transparentMomentsB.valid()
            && this.transparentMomentsBStorage.valid()
            && this.csgCapBackNormal.valid()
            && this.csgIntervalDepth.valid()
            && this.csgIntervalId.valid()
            && this.csgReceiverEventData.valid()
            && this.csgReceiverEventCount.valid()
            && this.csgReceiverSpanData.valid()
            && this.csgReceiverSpanCount.valid()
            && this.csgRemovedIntervalDepth.valid()
            && this.csgRemovedIntervalCapNormal.valid()
            && this.csgRemovedIntervalData.valid()
            && this.csgRemovedIntervalCount.valid()
        ;
    }
}

// Optional immutable one-frame-lagged lighting history.
class DeferredLaggedLightingHistoryResources{
    public TextureHandle shadowVisibility;
    public TextureHandle causticIrradiance;
    public TextureHandle surfelIrradiance;
    public BufferHandle slotsBuffer;
    public DeferredBindlessResourceSlots slots;
    public GpuDescriptorHandle slotsBufferDescriptor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle shadowVisibilityDescriptor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle causticIrradianceDescriptor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle surfelIrradianceDescriptor = GpuDescriptorHandleInvalid();
    // Prevents accepting history from a recycled target generation.
    public u64 generation = 0u;
    public b8 slotsUploaded = false;

    public b8 valid()const{
        const b8 hasTextures = this.shadowVisibility.valid() && this.causticIrradiance.valid() && this.surfelIrradiance.valid();
        const b8 descriptorsValid = this.slotsBufferDescriptor.valid() && this.shadowVisibilityDescriptor.valid() && this.causticIrradianceDescriptor.valid() && this.surfelIrradianceDescriptor.valid();
        return ValidLaggedLightingHistoryState(hasTextures, this.slotsBuffer.valid(), descriptorsValid, this.generation);
    }
}

[modular]
class DeferredFrameTargets{
    public u32 width = 0u;
    public u32 height = 0u;
    public u32 surfelResolveFactor = 0u;
    public u32 shadowReceiverFactor = 0u;
    public Format albedoFormat = Format::UNKNOWN;
    public Format normalFormat = Format::UNKNOWN;
    public Format worldPositionFormat = Format::UNKNOWN;
    public Format specularRoughnessFormat = Format::UNKNOWN;
    public Format opaqueColorFormat = Format::UNKNOWN;
    public Format compositeColorFormat = Format::UNKNOWN;
    public Format depthFormat = Format::UNKNOWN;
    public Format shadowVisibilityFormat = Format::UNKNOWN;
    public Format causticIrradianceFormat = Format::UNKNOWN;
    public Format surfelIrradianceFormat = Format::UNKNOWN;
    public Format causticAccumulatorFormat = Format::UNKNOWN;
    public Format causticHistoryFormat = Format::UNKNOWN;
    public Format csgCapNormalFormat = Format::UNKNOWN;
    public Format csgIntervalDepthFormat = Format::UNKNOWN;
    public Format csgIntervalIdFormat = Format::UNKNOWN;
    public Format csgReceiverEventDataFormat = Format::UNKNOWN;
    public Format csgReceiverEventCountFormat = Format::UNKNOWN;
    public Format csgReceiverSpanDataFormat = Format::UNKNOWN;
    public Format csgReceiverSpanCountFormat = Format::UNKNOWN;
    public Format csgRemovedIntervalDepthFormat = Format::UNKNOWN;
    public Format csgRemovedIntervalCapNormalFormat = Format::UNKNOWN;
    public Format csgRemovedIntervalDataFormat = Format::UNKNOWN;
    public Format csgRemovedIntervalCountFormat = Format::UNKNOWN;
    public Format shadowCoarseTransmittanceFormat = Format::UNKNOWN;
    public Format shadowSoftFormat = Format::UNKNOWN;
    public Format shadowSoftGeometryFormat = Format::UNKNOWN;
    public u32 csgPeelLayerCount = 0u;
    public u32 csgReceiverEventLayerCount = 0u;
    public u32 csgReceiverSpanLayerCount = 0u;
    public u32 csgRemovedIntervalLayerCount = 0u;
    public TextureHandle albedo;
    public TextureHandle normal;
    public TextureHandle worldPosition;
    public TextureHandle specularRoughness;
    public TextureHandle csgCapBackNormal;
    public TextureHandle csgIntervalDepth;
    public TextureHandle csgIntervalId;
    public TextureHandle csgReceiverEventData;
    public TextureHandle csgReceiverEventCount;
    public TextureHandle csgReceiverSpanData;
    public TextureHandle csgReceiverSpanCount;
    public TextureHandle csgRemovedIntervalDepth;
    public TextureHandle csgRemovedIntervalCapNormal;
    public TextureHandle csgRemovedIntervalData;
    public TextureHandle csgRemovedIntervalCount;
    public TextureHandle opaqueColor;
    // Compute output presented by a Graphics blit.
    public TextureHandle compositeColor;
    public TextureHandle depth;
    // Full-resolution per-light visibility; HW opaque and SW transparent paths combine here.
    public TextureHandle shadowVisibility;
    // Half-resolution adaptive transparent-shadow scratch; null when disabled.
    public TextureHandle shadowCoarseTransmittance;
    // Half-resolution opaque soft-shadow ping-pong and geometry cache.
    public TextureHandle shadowSoftHalfA;
    public TextureHandle shadowSoftHalfB;
    public TextureHandle shadowSoftGeometry;
    // Reprojected opaque soft-shadow history and moments; reset with the visibility target.
    public TextureHandle shadowHistA;
    public TextureHandle shadowHistB;
    public TextureHandle shadowMomentsA;
    public TextureHandle shadowMomentsB;
    public TextureHandle shadowSoftGeometryPrev;
    // Separate transparent history is denoised before multiplying onto opaque visibility.
    public TextureHandle transparentSoftHalf;
    public TextureHandle transparentHistA;
    public TextureHandle transparentHistB;
    public TextureHandle transparentMomentsA;
    public TextureHandle transparentMomentsB;
    // Additive caustic targets; black is the no-producer identity.
    public TextureHandle causticIrradiance;
    // Screen-space surfel GI avoids sharing the writable pool with deferred lighting.
    public TextureHandle surfelIrradiance;
    // Reduced-resolution surfel GI gather output; surfelResolveFactor belongs to this target generation.
    public TextureHandle surfelIrradianceHalf;
    public TextureHandle causticAccumulator;
    // Half-resolution caustic a-trous ping-pong.
    public TextureHandle causticHistory;
    public TextureHandle causticResolveHalf;
    // Half-resolution caustic geometry cache.
    public TextureHandle causticResolveGeometry;
    public FramebufferHandle framebuffer;
    public DeferredBindlessFrameResources bindless;
    public DeferredLaggedLightingHistoryResources laggedLightingHistory;
    public AvboitFrameTargets avboit;

    public b8 csgIntervalTargetsValid()const{
        return
            this.csgCapNormalFormat != Format::UNKNOWN
            && this.csgIntervalDepthFormat != Format::UNKNOWN
            && this.csgIntervalIdFormat != Format::UNKNOWN
            && this.csgReceiverEventDataFormat != Format::UNKNOWN
            && this.csgReceiverEventCountFormat != Format::UNKNOWN
            && this.csgReceiverSpanDataFormat != Format::UNKNOWN
            && this.csgReceiverSpanCountFormat != Format::UNKNOWN
            && this.csgRemovedIntervalDepthFormat != Format::UNKNOWN
            && this.csgRemovedIntervalCapNormalFormat != Format::UNKNOWN
            && this.csgRemovedIntervalDataFormat != Format::UNKNOWN
            && this.csgRemovedIntervalCountFormat != Format::UNKNOWN
            && ValidDeferredCsgTargetLayerCounts(this.csgPeelLayerCount, this.csgReceiverEventLayerCount, this.csgReceiverSpanLayerCount, this.csgRemovedIntervalLayerCount)
            && this.csgCapBackNormal.valid()
            && this.csgIntervalDepth.valid()
            && this.csgIntervalId.valid()
            && this.csgReceiverEventData.valid()
            && this.csgReceiverEventCount.valid()
            && this.csgReceiverSpanData.valid()
            && this.csgReceiverSpanCount.valid()
            && this.csgRemovedIntervalDepth.valid()
            && this.csgRemovedIntervalCapNormal.valid()
            && this.csgRemovedIntervalData.valid()
            && this.csgRemovedIntervalCount.valid()
        ;
    }

    public b8 valid()const;
}

void ResetCsgIntervalTargets(mut DeferredFrameTargets targets){
    targets.csgCapBackNormal.reset();
    targets.csgIntervalDepth.reset();
    targets.csgIntervalId.reset();
    targets.csgReceiverEventData.reset();
    targets.csgReceiverEventCount.reset();
    targets.csgReceiverSpanData.reset();
    targets.csgReceiverSpanCount.reset();
    targets.csgRemovedIntervalDepth.reset();
    targets.csgRemovedIntervalCapNormal.reset();
    targets.csgRemovedIntervalData.reset();
    targets.csgRemovedIntervalCount.reset();
}


