#include <impl/assets_scene/component_binary.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidLightComponentParameters(in LightComponent component){
    VectorSingle color = component.color();
    f32 intensity = component.intensity();
    b8 validType =
        component.type == LightType::Directional
        || component.type == LightType::Point
        || component.type == LightType::Spot
    ;
    if(
        !validType
        || !IsFinite(color.x) || !IsFinite(color.y) || !IsFinite(color.z)
        || color.x < 0.0f || color.y < 0.0f || color.z < 0.0f
        || !IsFinite(intensity) || intensity <= 0.0f
        || !IsFinite(component.range) || component.range <= 0.0f
        || !IsFinite(component.angularRadius) || component.angularRadius < 0.0f
        || !IsFinite(component.sourceRadius) || component.sourceRadius < 0.0f
    )
        return false;
    return true;
}

b8 IsAllowedTransformComponentField(in StringView fieldName){
    return
        fieldName == s_TransformPositionField
        || fieldName == s_TransformRotationField
        || fieldName == s_TransformRotationEulerField
        || fieldName == s_TransformRotationEulerDegreesField
        || fieldName == s_TransformScaleField
    ;
}

b8 IsAllowedCameraComponentField(in StringView fieldName){
    return
        fieldName == s_CameraVerticalFovDegreesField
        || fieldName == s_CameraVerticalFovRadiansField
        || fieldName == s_CameraNearPlaneField
        || fieldName == s_CameraFarPlaneField
        || fieldName == s_CameraAspectRatioField
    ;
}

b8 IsAllowedLightComponentField(in StringView fieldName){
    return
        fieldName == s_LightTypeField
        || fieldName == s_LightColorField
        || fieldName == s_LightIntensityField
        || fieldName == s_LightRangeField
        || fieldName == s_LightInnerConeCosField
        || fieldName == s_LightOuterConeCosField
        || fieldName == s_LightAngularRadiusField
        || fieldName == s_LightSourceRadiusField
        || fieldName == s_LightEnableCausticsField
    ;
}

Expected<VectorSingle> TryNormalizeTransformQuaternion(in f32 x, in f32 y, in f32 z, in f32 w){
    const VectorSingle rawQuaternion(x, y, z, w);
    const f32 lenSq = LengthSq(rawQuaternion);
    if(!IsFinite(lenSq) || lenSq <= s_SceneMinQuaternionLengthSq)
        return MakeUnexpected(Failure());

    return Normalize(rawQuaternion);
}

b8 IsValidTransformComponentParameters(in TransformComponent component){
    if(
        !IsFinite(component.position.x) || !IsFinite(component.position.y) || !IsFinite(component.position.z)
        || !IsFinite(component.rotation.x) || !IsFinite(component.rotation.y) || !IsFinite(component.rotation.z) || !IsFinite(component.rotation.w)
        || !IsFinite(component.scale.x) || !IsFinite(component.scale.y) || !IsFinite(component.scale.z)
    )
        return false;

    const f32 rotationLengthSq = LengthSq(VectorSingle(component.rotation));
    return IsFinite(rotationLengthSq) && Abs(rotationLengthSq - 1.0f) <= s_TransformRotationUnitLengthSquaredTolerance;
}

b8 ValidateTransformComponentAssetPayload(in TransformComponent component, in Name virtualPath){
    if(IsValidTransformComponentParameters(component))
        return true;

    error(
        "TransformComponentAsset::validatePayload failed: transform '{}' must have finite position/scale and unit quaternion rotation"
        , virtualPath.resolvedText()
    );
    return false;
}

b8 ValidateCameraComponentAssetPayload(in CameraComponent component, in Name virtualPath){
    const VectorSingle projection(component.projection);
    const f32 aspectRatio = projection.w;
    const Expected<CameraProjection> builtProjection = TryBuildCameraProjection(
        projection.x,
        projection.y,
        projection.z,
        aspectRatio,
        s_CameraFallbackAspectRatio
    );
    if(
        !IsFinite(projection.x) || !IsFinite(projection.y) || !IsFinite(projection.z) || !IsFinite(projection.w)
        || aspectRatio < 0.0f
        || !builtProjection.has_value()
    ){
        error(
            "CameraComponentAsset::validatePayload failed: camera '{}' has invalid projection parameters"
            , virtualPath.resolvedText()
        );
        return false;
    }
    return true;
}

b8 ValidateLightComponentAssetPayload(in LightComponent component, in Name virtualPath){
    if(IsValidLightComponentParameters(component) && IsValidLightCone(component.innerConeCos, component.outerConeCos))
        return true;

    error(
        "LightComponentAsset::validatePayload failed: light '{}' has invalid parameters"
        , virtualPath.resolvedText()
    );
    return false;
}

[serialize]
class SceneAssetEntryBinary{
    public NameHash nicknameHash;
    public NameHash assetHash;
}

const usize s_ComponentHeaderBinaryBytes = 80u;

const usize s_TransformComponentPayloadBinaryBytes = 48u;
const usize s_CameraComponentPayloadBinaryBytes = 16u;
const usize s_LightComponentPayloadBinaryBytes = 40u;


