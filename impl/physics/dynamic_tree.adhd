////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/physics/math.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u8 s_TreeNodeHasSensor = 0x01u;
const u8 s_TreeNodeHasSensorEvents = 0x02u;
const u8 s_TreeNodeHasNonSensor = 0x04u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TreeNode{
    public f32x3_u32 aabbMinUser(0.0f, 0.0f, 0.0f, s_NullIndex);
    public f32x3_u32 aabbMaxCategory(0.0f, 0.0f, 0.0f, 0u);
    public u32 parentOrNext = s_NullIndex;
    public u32 child1 = s_NullIndex;
    public u32 child2 = s_NullIndex;
    public i16 height = -1;
    public b8 moved = false;
    public u8 nodeFlags = 0u;

    public b8 isLeaf()const{
        return this.child1 == s_NullIndex;
    }

    public Aabb3D aabb()const{
        return Aabb3D(VectorSingle(this.aabbMinUser, 0.0f), VectorSingle(this.aabbMaxCategory, 0.0f));
    }

    public void setAabb(in Aabb3D box){
        this.aabbMinUser = f32x3_u32(box.lowerBound.x, box.lowerBound.y, box.lowerBound.z, this.aabbMinUser.w);
        this.aabbMaxCategory = f32x3_u32(box.upperBound.x, box.upperBound.y, box.upperBound.z, this.aabbMaxCategory.w);
    }

    public u32 userData()const{
        return this.aabbMinUser.w;
    }

    public u32 categoryBits()const{
        return this.aabbMaxCategory.w;
    }
}

class DynamicTree{
    private Vector<TreeNode> m_nodes;
    private Vector<u32> m_moveIndices;
    private u32 m_root = s_NullIndex;
    private u32 m_freeList = s_NullIndex;
    private u32 m_nodeCount = 0u;

    public void clear(){
        this.m_nodes.clear();
        this.m_moveIndices.clear();
        this.m_root = s_NullIndex;
        this.m_freeList = s_NullIndex;
        this.m_nodeCount = 0u;
    }

    public u32 createProxyWithFlags(in Aabb3D aabb, in u32 categoryBits, in u8 nodeFlags, in u32 userData){
        const u32 proxyId = this.allocateNode();
        const f32 margin = ComputeAabbMargin(aabb);
        const Aabb3D fat = FattenAabb(aabb, margin);
        this.m_nodes[proxyId].aabbMinUser = f32x3_u32(fat.lowerBound.x, fat.lowerBound.y, fat.lowerBound.z, userData);
        this.m_nodes[proxyId].aabbMaxCategory = f32x3_u32(fat.upperBound.x, fat.upperBound.y, fat.upperBound.z, categoryBits);
        this.m_nodes[proxyId].height = 0;
        this.m_nodes[proxyId].moved = false;
        this.m_nodes[proxyId].nodeFlags = nodeFlags;
        this.m_moveIndices[proxyId] = s_NullIndex;
        this.insertLeaf(proxyId);
        return proxyId;
    }

    public u32 createProxy(in Aabb3D aabb, in u32 categoryBits, in u32 userData){
        return this.createProxyWithFlags(aabb, categoryBits, 0u, userData);
    }

    public void setNodeFlags(in u32 proxyId, in u8 nodeFlags){
        if(proxyId >= this.m_nodes.size() || !this.m_nodes[proxyId].isLeaf())
            return;
        if(this.m_nodes[proxyId].nodeFlags == nodeFlags)
            return;
        this.m_nodes[proxyId].nodeFlags = nodeFlags;
        u32 parent = this.m_nodes[proxyId].parentOrNext;
        while(parent != s_NullIndex){
            const u32 c1 = this.m_nodes[parent].child1;
            const u32 c2 = this.m_nodes[parent].child2;
            const u8 mergedFlags = this.m_nodes[c1].nodeFlags | this.m_nodes[c2].nodeFlags;
            if(this.m_nodes[parent].nodeFlags == mergedFlags)
                break;
            this.m_nodes[parent].nodeFlags = mergedFlags;
            parent = this.m_nodes[parent].parentOrNext;
        }
    }

    public void destroyProxy(in u32 proxyId){
        if(proxyId >= this.m_nodes.size() || !this.m_nodes[proxyId].isLeaf())
            return;
        this.removeLeaf(proxyId);
        this.freeNode(proxyId);
    }

    public b8 needsMove(in u32 proxyId, in Aabb3D aabb, in b8 keepEnlarged)const{
        if(proxyId >= this.m_nodes.size() || !this.m_nodes[proxyId].isLeaf())
            return false;
        const Aabb3D curAabb = this.m_nodes[proxyId].aabb();
        if(!AabbContains(curAabb, aabb))
            return true;
        if(keepEnlarged)
            return false;
        const f32 margin = ComputeAabbMargin(aabb);
        const Aabb3D hugeAabb = FattenAabb(FattenAabb(aabb, margin), 4.0f * margin);
        return !AabbContains(hugeAabb, curAabb);
    }

    public void moveProxyUnchecked(in u32 proxyId, in Aabb3D aabb, in VectorSingle displacement){
        if(proxyId >= this.m_nodes.size() || !this.m_nodes[proxyId].isLeaf())
            return;

        const f32 margin = ComputeAabbMargin(aabb);
        const Aabb3D fattened = FattenAabb(aabb, margin);
        const VectorSingle d = VectorSingle(displacement, 0.0f) * 2.0f;
        VectorSingle lower = VectorSingle(fattened.lowerBound);
        VectorSingle upper = VectorSingle(fattened.upperBound);
        if(d.x < 0.0f)
            lower = VectorSetX(lower, lower.x + d.x);
        else
            upper = VectorSetX(upper, upper.x + d.x);
        if(d.y < 0.0f)
            lower = VectorSetY(lower, lower.y + d.y);
        else
            upper = VectorSetY(upper, upper.y + d.y);
        if(d.z < 0.0f)
            lower = VectorSetZ(lower, lower.z + d.z);
        else
            upper = VectorSetZ(upper, upper.z + d.z);

        this.removeLeaf(proxyId);
        this.m_nodes[proxyId].setAabb(Aabb3D(lower, upper));
        this.insertLeaf(proxyId);
    }

    public b8 moveProxy(in u32 proxyId, in Aabb3D aabb, in VectorSingle displacement){
        if(proxyId >= this.m_nodes.size() || !this.m_nodes[proxyId].isLeaf())
            return false;

        const f32 margin = ComputeAabbMargin(aabb);
        const Aabb3D fattened = FattenAabb(aabb, margin);
        const Aabb3D hugeAabb = FattenAabb(fattened, 4.0f * margin);
        const Aabb3D curAabb = this.m_nodes[proxyId].aabb();
        if(AabbContains(curAabb, aabb) && AabbContains(hugeAabb, curAabb))
            return false;

        this.moveProxyUnchecked(proxyId, aabb, displacement);
        return true;
    }

    public b8 isMoved(in u32 proxyId)const{
        if(proxyId >= this.m_nodes.size())
            return false;
        return this.m_nodes[proxyId].moved;
    }

    public void setMoved(in u32 proxyId, in b8 moved){
        if(proxyId < this.m_nodes.size())
            this.m_nodes[proxyId].moved = moved;
    }

    public u32 moveIndex(in u32 proxyId)const{
        if(proxyId >= this.m_moveIndices.size())
            return s_NullIndex;
        return this.m_moveIndices[proxyId];
    }

    public void setMoveIndex(in u32 proxyId, in u32 idx){
        if(proxyId < this.m_moveIndices.size())
            this.m_moveIndices[proxyId] = idx;
    }

    public Aabb3D fatAabb(in u32 proxyId)const{
        return this.m_nodes[proxyId].aabb();
    }

    public u32 root()const{
        return this.m_root;
    }

    public u32 userData(in u32 proxyId)const{
        return this.m_nodes[proxyId].userData();
    }

    public b8 isValidLeaf(in u32 proxyId)const{
        if(proxyId >= this.m_nodes.size())
            return false;
        in TreeNode n = this.m_nodes[proxyId];
        return n.height == 0 && n.isLeaf() && n.userData() != s_NullIndex;
    }

    public void queryAabbFiltered<Callback>(in Aabb3D queryBox, in u32 maskBits, in u8 requiredNodeFlags, in Callback callback)const{
        if(this.m_root == s_NullIndex || maskBits == 0u)
            return;

        in TreeNode rootNode = this.m_nodes[this.m_root];
        if(maskBits != u32.max && (rootNode.categoryBits() & maskBits) == 0u)
            return;
        if(requiredNodeFlags != 0u && (rootNode.nodeFlags & requiredNodeFlags) == 0u)
            return;
        const VectorSingle qMin = VectorSingle(queryBox.lowerBound);
        const VectorSingle qMax = VectorSingle(queryBox.upperBound);
        if(
            (VectorMoveMask(VectorAndInt(VectorLessOrEqual(VectorSingle(rootNode.aabbMinUser, 0.0f), qMax), VectorLessOrEqual(qMin, VectorSingle(rootNode.aabbMaxCategory, 0.0f)))) & 7u)
            != 7u
        )
            return;
        if(rootNode.isLeaf()){
            callback(this.m_root, rootNode.userData());
            return;
        }

        Array<u32, 256u> fixedStack;
        fixedStack[0u] = this.m_root;
        u32 fixedCount = 1u;
        while(fixedCount > 0u){
            --fixedCount;
            const u32 nodeId = fixedStack[fixedCount];
            in TreeNode node = this.m_nodes[nodeId];
            if(node.child1 != s_NullIndex){
                in TreeNode c1 = this.m_nodes[node.child1];
                if(
                    (maskBits == u32.max || (c1.categoryBits() & maskBits) != 0u)
                    && (requiredNodeFlags == 0u || (c1.nodeFlags & requiredNodeFlags) != 0u)
                    && (VectorMoveMask(VectorAndInt(VectorLessOrEqual(VectorSingle(c1.aabbMinUser, 0.0f), qMax), VectorLessOrEqual(qMin, VectorSingle(c1.aabbMaxCategory, 0.0f)))) & 7u) == 7u
                ){
                    if(c1.isLeaf()){
                        if(!callback(node.child1, c1.userData()))
                            return;
                    }
                    else if(fixedCount < 256u){
                        fixedStack[fixedCount] = node.child1;
                        ++fixedCount;
                    }
                }
            }
            if(node.child2 != s_NullIndex){
                in TreeNode c2 = this.m_nodes[node.child2];
                if(
                    (maskBits == u32.max || (c2.categoryBits() & maskBits) != 0u)
                    && (requiredNodeFlags == 0u || (c2.nodeFlags & requiredNodeFlags) != 0u)
                    && (VectorMoveMask(VectorAndInt(VectorLessOrEqual(VectorSingle(c2.aabbMinUser, 0.0f), qMax), VectorLessOrEqual(qMin, VectorSingle(c2.aabbMaxCategory, 0.0f)))) & 7u) == 7u
                ){
                    if(c2.isLeaf()){
                        if(!callback(node.child2, c2.userData()))
                            return;
                    }
                    else if(fixedCount < 256u){
                        fixedStack[fixedCount] = node.child2;
                        ++fixedCount;
                    }
                }
            }
        }
    }

    public void queryAabb<Callback>(in Aabb3D queryBox, in u32 maskBits, in Callback callback)const{
        this.queryAabbFiltered(queryBox, maskBits, 0u, callback);
    }

    public void rayCastFiltered<Callback>(
        in VectorSingle origin,
        in VectorSingle translation,
        in u32 maskBits,
        in f32 initialMaxFraction,
        in u8 requiredNodeFlags,
        in Callback callback
    )const{
        if(this.m_root == s_NullIndex || maskBits == 0u || initialMaxFraction <= 0.0f)
            return;

        in TreeNode rootNode = this.m_nodes[this.m_root];
        if(maskBits != u32.max && (rootNode.categoryBits() & maskBits) == 0u)
            return;
        if(requiredNodeFlags != 0u && (rootNode.nodeFlags & requiredNodeFlags) == 0u)
            return;

        f32 maxFraction = initialMaxFraction;
        const RayCastSlabData ray = MakeRayCastSlabData(origin, translation);
        f32 rootTMin = 0.0f;
        if(!AabbRayCastFast(rootNode.aabb(), ray, maxFraction, rootTMin))
            return;
        if(rootNode.isLeaf()){
            callback(this.m_root, rootNode.userData(), maxFraction);
            return;
        }

        Array<u32, 256u> fixedStack;
        Array<f32, 256u> fixedStackTMin;
        fixedStack[0u] = this.m_root;
        fixedStackTMin[0u] = rootTMin;
        u32 fixedCount = 1u;
        while(fixedCount > 0u){
            --fixedCount;
            const u32 nodeId = fixedStack[fixedCount];
            const f32 poppedTMin = fixedStackTMin[fixedCount];
            if(poppedTMin > maxFraction)
                continue;

            in TreeNode node = this.m_nodes[nodeId];
            if(node.isLeaf()){
                maxFraction = callback(nodeId, node.userData(), maxFraction);
                if(maxFraction <= 0.0f)
                    return;
            }
            else{
                b8 hit1 = false;
                f32 t1 = 0.0f;
                if(node.child1 != s_NullIndex){
                    in TreeNode c1 = this.m_nodes[node.child1];
                    if(
                        (maskBits == u32.max || (c1.categoryBits() & maskBits) != 0u)
                        && (requiredNodeFlags == 0u || (c1.nodeFlags & requiredNodeFlags) != 0u)
                    )
                        hit1 = AabbRayCastFast(c1.aabb(), ray, maxFraction, t1);
                }
                b8 hit2 = false;
                f32 t2 = 0.0f;
                if(node.child2 != s_NullIndex){
                    in TreeNode c2 = this.m_nodes[node.child2];
                    if(
                        (maskBits == u32.max || (c2.categoryBits() & maskBits) != 0u)
                        && (requiredNodeFlags == 0u || (c2.nodeFlags & requiredNodeFlags) != 0u)
                    )
                        hit2 = AabbRayCastFast(c2.aabb(), ray, maxFraction, t2);
                }
                PushRayCastChildrenOrdered(fixedStack, fixedStackTMin, fixedCount, node.child1, hit1, t1, node.child2, hit2, t2);
            }
        }
    }

    public void rayCast<Callback>(
        in VectorSingle origin,
        in VectorSingle translation,
        in u32 maskBits,
        in Callback callback
    )const{
        this.rayCastFiltered(origin, translation, maskBits, 1.0f, 0u, callback);
    }

    private u32 allocateNode(){
        if(this.m_freeList == s_NullIndex){
            const usize prevCap = this.m_nodes.size();
            usize newCap = 64u;
            if(prevCap != 0u)
                newCap = prevCap * 2u;
            this.m_nodes.resize(newCap);
            this.m_moveIndices.resize(newCap, s_NullIndex);
            for(usize i = prevCap; i < newCap - 1u; ++i){
                this.m_nodes[i].parentOrNext = cast<u32>(i + 1u);
                this.m_nodes[i].height = -1;
            }
            this.m_nodes[newCap - 1u].parentOrNext = s_NullIndex;
            this.m_nodes[newCap - 1u].height = -1;
            this.m_freeList = cast<u32>(prevCap);
        }

        const u32 nodeId = this.m_freeList;
        this.m_freeList = this.m_nodes[nodeId].parentOrNext;
        this.m_nodes[nodeId].parentOrNext = s_NullIndex;
        this.m_nodes[nodeId].child1 = s_NullIndex;
        this.m_nodes[nodeId].child2 = s_NullIndex;
        this.m_nodes[nodeId].height = 0;
        this.m_nodes[nodeId].aabbMinUser.w = s_NullIndex;
        this.m_nodes[nodeId].moved = false;
        this.m_nodes[nodeId].nodeFlags = 0u;
        this.m_moveIndices[nodeId] = s_NullIndex;
        ++this.m_nodeCount;
        return nodeId;
    }

    private void freeNode(in u32 nodeId){
        this.m_nodes[nodeId].parentOrNext = this.m_freeList;
        this.m_nodes[nodeId].height = -1;
        this.m_nodes[nodeId].child1 = s_NullIndex;
        this.m_nodes[nodeId].child2 = s_NullIndex;
        this.m_nodes[nodeId].aabbMinUser.w = s_NullIndex;
        this.m_nodes[nodeId].aabbMaxCategory.w = 0u;
        this.m_nodes[nodeId].moved = false;
        this.m_nodes[nodeId].nodeFlags = 0u;
        this.m_moveIndices[nodeId] = s_NullIndex;
        this.m_freeList = nodeId;
        if(this.m_nodeCount > 0u)
            --this.m_nodeCount;
    }

    private void insertLeaf(in u32 leaf){
        if(this.m_root == s_NullIndex){
            this.m_root = leaf;
            this.m_nodes[leaf].parentOrNext = s_NullIndex;
            return;
        }

        const Aabb3D leafAabb = this.m_nodes[leaf].aabb();
        u32 index = this.m_root;
        while(!this.m_nodes[index].isLeaf()){
            const u32 c1 = this.m_nodes[index].child1;
            const u32 c2 = this.m_nodes[index].child2;
            const Aabb3D idxBox = this.m_nodes[index].aabb();
            const Aabb3D c1Box = this.m_nodes[c1].aabb();
            const Aabb3D c2Box = this.m_nodes[c2].aabb();
            const f32 area = AabbPerimeter(idxBox);

            const Aabb3D combined = AabbUnion(idxBox, leafAabb);
            const f32 combinedArea = AabbPerimeter(combined);
            const f32 cost = 2.0f * combinedArea;
            const f32 inheritanceCost = 2.0f * (combinedArea - area);

            f32 cost1 = 0.0f;
            if(this.m_nodes[c1].isLeaf())
                cost1 = AabbPerimeter(AabbUnion(leafAabb, c1Box)) + inheritanceCost;
            else
                cost1 = (AabbPerimeter(AabbUnion(leafAabb, c1Box)) - AabbPerimeter(c1Box)) + inheritanceCost;

            f32 cost2 = 0.0f;
            if(this.m_nodes[c2].isLeaf())
                cost2 = AabbPerimeter(AabbUnion(leafAabb, c2Box)) + inheritanceCost;
            else
                cost2 = (AabbPerimeter(AabbUnion(leafAabb, c2Box)) - AabbPerimeter(c2Box)) + inheritanceCost;

            if(cost < cost1 && cost < cost2)
                break;

            if(cost1 < cost2)
                index = c1;
            else
                index = c2;
        }

        const u32 sibling = index;
        const u32 oldParent = this.m_nodes[sibling].parentOrNext;
        const u32 newParent = this.allocateNode();
        this.m_nodes[newParent].parentOrNext = oldParent;
        this.m_nodes[newParent].setAabb(AabbUnion(leafAabb, this.m_nodes[sibling].aabb()));
        this.m_nodes[newParent].height = cast<i16>(cast<i32>(this.m_nodes[sibling].height) + 1);

        if(oldParent != s_NullIndex){
            if(this.m_nodes[oldParent].child1 == sibling)
                this.m_nodes[oldParent].child1 = newParent;
            else
                this.m_nodes[oldParent].child2 = newParent;
        }
        else{
            this.m_root = newParent;
        }

        this.m_nodes[newParent].child1 = sibling;
        this.m_nodes[newParent].child2 = leaf;
        this.m_nodes[newParent].aabbMaxCategory.w = this.m_nodes[sibling].categoryBits() | this.m_nodes[leaf].categoryBits();
        this.m_nodes[newParent].nodeFlags = this.m_nodes[sibling].nodeFlags | this.m_nodes[leaf].nodeFlags;
        this.m_nodes[sibling].parentOrNext = newParent;
        this.m_nodes[leaf].parentOrNext = newParent;

        this.syncHierarchy(newParent);
    }

    private void removeLeaf(in u32 leaf){
        if(leaf == this.m_root){
            this.m_root = s_NullIndex;
            return;
        }

        const u32 parent = this.m_nodes[leaf].parentOrNext;
        const u32 grandParent = this.m_nodes[parent].parentOrNext;
        u32 sibling = this.m_nodes[parent].child1;
        if(sibling == leaf)
            sibling = this.m_nodes[parent].child2;

        if(grandParent != s_NullIndex){
            if(this.m_nodes[grandParent].child1 == parent)
                this.m_nodes[grandParent].child1 = sibling;
            else
                this.m_nodes[grandParent].child2 = sibling;
            this.m_nodes[sibling].parentOrNext = grandParent;
            this.freeNode(parent);
            this.syncHierarchy(grandParent);
        }
        else{
            this.m_root = sibling;
            this.m_nodes[sibling].parentOrNext = s_NullIndex;
            this.freeNode(parent);
        }
    }

    private void syncHierarchy(in u32 startNode){
        u32 index = startNode;
        while(index != s_NullIndex){
            index = this.balance(index);
            const u32 c1 = this.m_nodes[index].child1;
            const u32 c2 = this.m_nodes[index].child2;
            this.m_nodes[index].height = cast<i16>(1 + Max(cast<i32>(this.m_nodes[c1].height), cast<i32>(this.m_nodes[c2].height)));
            this.m_nodes[index].setAabb(AabbUnion(this.m_nodes[c1].aabb(), this.m_nodes[c2].aabb()));
            this.m_nodes[index].aabbMaxCategory.w = this.m_nodes[c1].categoryBits() | this.m_nodes[c2].categoryBits();
            this.m_nodes[index].nodeFlags = this.m_nodes[c1].nodeFlags | this.m_nodes[c2].nodeFlags;
            index = this.m_nodes[index].parentOrNext;
        }
    }

    private u32 balance(in u32 iA){
        if(this.m_nodes[iA].isLeaf() || this.m_nodes[iA].height < 2)
            return iA;

        const u32 iB = this.m_nodes[iA].child1;
        const u32 iC = this.m_nodes[iA].child2;
        const i32 heightDiff = cast<i32>(this.m_nodes[iC].height) - cast<i32>(this.m_nodes[iB].height);

        if(heightDiff > 1){
            const u32 iF = this.m_nodes[iC].child1;
            const u32 iG = this.m_nodes[iC].child2;
            this.m_nodes[iC].child1 = iA;
            this.m_nodes[iC].parentOrNext = this.m_nodes[iA].parentOrNext;
            this.m_nodes[iA].parentOrNext = iC;
            if(this.m_nodes[iC].parentOrNext != s_NullIndex){
                if(this.m_nodes[this.m_nodes[iC].parentOrNext].child1 == iA)
                    this.m_nodes[this.m_nodes[iC].parentOrNext].child1 = iC;
                else
                    this.m_nodes[this.m_nodes[iC].parentOrNext].child2 = iC;
            }
            else{
                this.m_root = iC;
            }
            if(this.m_nodes[iF].height > this.m_nodes[iG].height){
                this.m_nodes[iC].child2 = iF;
                this.m_nodes[iA].child2 = iG;
                this.m_nodes[iG].parentOrNext = iA;
                this.m_nodes[iA].setAabb(AabbUnion(this.m_nodes[iB].aabb(), this.m_nodes[iG].aabb()));
                this.m_nodes[iA].aabbMaxCategory.w = this.m_nodes[iB].categoryBits() | this.m_nodes[iG].categoryBits();
                this.m_nodes[iA].nodeFlags = this.m_nodes[iB].nodeFlags | this.m_nodes[iG].nodeFlags;
                this.m_nodes[iC].setAabb(AabbUnion(this.m_nodes[iA].aabb(), this.m_nodes[iF].aabb()));
                this.m_nodes[iC].aabbMaxCategory.w = this.m_nodes[iA].categoryBits() | this.m_nodes[iF].categoryBits();
                this.m_nodes[iC].nodeFlags = this.m_nodes[iA].nodeFlags | this.m_nodes[iF].nodeFlags;
                this.m_nodes[iA].height = cast<i16>(1 + Max(cast<i32>(this.m_nodes[iB].height), cast<i32>(this.m_nodes[iG].height)));
                this.m_nodes[iC].height = cast<i16>(1 + Max(cast<i32>(this.m_nodes[iA].height), cast<i32>(this.m_nodes[iF].height)));
            }
            else{
                this.m_nodes[iC].child2 = iG;
                this.m_nodes[iA].child2 = iF;
                this.m_nodes[iF].parentOrNext = iA;
                this.m_nodes[iA].setAabb(AabbUnion(this.m_nodes[iB].aabb(), this.m_nodes[iF].aabb()));
                this.m_nodes[iA].aabbMaxCategory.w = this.m_nodes[iB].categoryBits() | this.m_nodes[iF].categoryBits();
                this.m_nodes[iA].nodeFlags = this.m_nodes[iB].nodeFlags | this.m_nodes[iF].nodeFlags;
                this.m_nodes[iC].setAabb(AabbUnion(this.m_nodes[iA].aabb(), this.m_nodes[iG].aabb()));
                this.m_nodes[iC].aabbMaxCategory.w = this.m_nodes[iA].categoryBits() | this.m_nodes[iG].categoryBits();
                this.m_nodes[iC].nodeFlags = this.m_nodes[iA].nodeFlags | this.m_nodes[iG].nodeFlags;
                this.m_nodes[iA].height = cast<i16>(1 + Max(cast<i32>(this.m_nodes[iB].height), cast<i32>(this.m_nodes[iF].height)));
                this.m_nodes[iC].height = cast<i16>(1 + Max(cast<i32>(this.m_nodes[iA].height), cast<i32>(this.m_nodes[iG].height)));
            }
            return iC;
        }

        if(heightDiff < -1){
            const u32 iD = this.m_nodes[iB].child1;
            const u32 iE = this.m_nodes[iB].child2;
            this.m_nodes[iB].child1 = iA;
            this.m_nodes[iB].parentOrNext = this.m_nodes[iA].parentOrNext;
            this.m_nodes[iA].parentOrNext = iB;
            if(this.m_nodes[iB].parentOrNext != s_NullIndex){
                if(this.m_nodes[this.m_nodes[iB].parentOrNext].child1 == iA)
                    this.m_nodes[this.m_nodes[iB].parentOrNext].child1 = iB;
                else
                    this.m_nodes[this.m_nodes[iB].parentOrNext].child2 = iB;
            }
            else{
                this.m_root = iB;
            }
            if(this.m_nodes[iD].height > this.m_nodes[iE].height){
                this.m_nodes[iB].child2 = iD;
                this.m_nodes[iA].child1 = iE;
                this.m_nodes[iE].parentOrNext = iA;
                this.m_nodes[iA].setAabb(AabbUnion(this.m_nodes[iC].aabb(), this.m_nodes[iE].aabb()));
                this.m_nodes[iA].aabbMaxCategory.w = this.m_nodes[iC].categoryBits() | this.m_nodes[iE].categoryBits();
                this.m_nodes[iA].nodeFlags = this.m_nodes[iC].nodeFlags | this.m_nodes[iE].nodeFlags;
                this.m_nodes[iB].setAabb(AabbUnion(this.m_nodes[iA].aabb(), this.m_nodes[iD].aabb()));
                this.m_nodes[iB].aabbMaxCategory.w = this.m_nodes[iA].categoryBits() | this.m_nodes[iD].categoryBits();
                this.m_nodes[iB].nodeFlags = this.m_nodes[iA].nodeFlags | this.m_nodes[iD].nodeFlags;
                this.m_nodes[iA].height = cast<i16>(1 + Max(cast<i32>(this.m_nodes[iC].height), cast<i32>(this.m_nodes[iE].height)));
                this.m_nodes[iB].height = cast<i16>(1 + Max(cast<i32>(this.m_nodes[iA].height), cast<i32>(this.m_nodes[iD].height)));
            }
            else{
                this.m_nodes[iB].child2 = iE;
                this.m_nodes[iA].child1 = iD;
                this.m_nodes[iD].parentOrNext = iA;
                this.m_nodes[iA].setAabb(AabbUnion(this.m_nodes[iC].aabb(), this.m_nodes[iD].aabb()));
                this.m_nodes[iA].aabbMaxCategory.w = this.m_nodes[iC].categoryBits() | this.m_nodes[iD].categoryBits();
                this.m_nodes[iA].nodeFlags = this.m_nodes[iC].nodeFlags | this.m_nodes[iD].nodeFlags;
                this.m_nodes[iB].setAabb(AabbUnion(this.m_nodes[iA].aabb(), this.m_nodes[iE].aabb()));
                this.m_nodes[iB].aabbMaxCategory.w = this.m_nodes[iA].categoryBits() | this.m_nodes[iE].categoryBits();
                this.m_nodes[iB].nodeFlags = this.m_nodes[iA].nodeFlags | this.m_nodes[iE].nodeFlags;
                this.m_nodes[iA].height = cast<i16>(1 + Max(cast<i32>(this.m_nodes[iC].height), cast<i32>(this.m_nodes[iD].height)));
                this.m_nodes[iB].height = cast<i16>(1 + Max(cast<i32>(this.m_nodes[iA].height), cast<i32>(this.m_nodes[iE].height)));
            }
            return iB;
        }

        return iA;
    }
}


