}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_ExceptionalLabel = "exceptional";
const StringView s_RandomLabel = "random";
const StringView s_PositiveFiniteLabel = "positive_finite";
const f32 s_EncodeExponent = 1.0f / 2.4f;
const f32 s_DecodeScale = 1.0f / 1.055f;
const usize s_PowExceptionalCount = 29u;

enum<u8> PowVariant{
    Production = 0u,
    PackedSingle = 1u,
    PackedDouble = 2u,
    kCount = 3u
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class PowFlagsSnapshot{
    public i32 standard = 0;
    public u32 mapped = 0u;
    public u64 nativeBits = 0u;
}

class PowObservation{
    public Array<u32, 4> bits;
    public PowFlagsSnapshot flags = PowFlagsSnapshot();
    public i32 error = 0;
}

class PowCounts{
    public u64 vectors = 0u;
    public u64 bits = 0u;
    public u64 flags = 0u;
    public u64 errors = 0u;
    public u64 quantized = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<PowVariant> ParsePowVariant(in StringView text){
    if(text == "production")
        return PowVariant::Production;
    if(text == "packed_single")
        return PowVariant::PackedSingle;
    if(text == "packed_double")
        return PowVariant::PackedDouble;
    return MakeUnexpected(Failure());
}

b8 EqualPowFlags(in PowFlagsSnapshot lhs, in PowFlagsSnapshot rhs){
    return lhs.standard == rhs.standard && lhs.mapped == rhs.mapped && lhs.nativeBits == rhs.nativeBits;
}

u32 ExceptionalPowBitAt(in usize index){
    switch(index){
    case 0u: return 0u;
    case 1u: return 0x80000000u;
    case 2u: return 1u;
    case 3u: return 0x80000001u;
    case 4u: return 0x007fffffu;
    case 5u: return 0x00800000u;
    case 6u: return 0x80800000u;
    case 7u: return 0x7f7fffffu;
    case 8u: return 0xff7fffffu;
    case 9u: return 0x7f800000u;
    case 10u: return 0xff800000u;
    case 11u: return 0x7fc00123u;
    case 12u: return 0xffc00124u;
    case 13u: return 0x7f800125u;
    case 14u: return 0xff800126u;
    case 15u: return 0x3f800000u;
    case 16u: return 0xbf800000u;
    case 17u: return 0x40000000u;
    case 18u: return 0xc0000000u;
    case 19u: return 0x3f000000u;
    case 20u: return 0xbf000000u;
    case 21u: return 0x40400000u;
    case 22u: return 0xc0400000u;
    case 23u: return 0x4b7fffffu;
    case 24u: return 0x4b800000u;
    case 25u: return 0x4b800001u;
    case 26u: return 0x3eaaaaabu;
    case 27u: return 0x42fe0000u;
    default: return 0xc3160000u;
    }
}

Expected<PowObservation> ObservePow(in u8 variantCode, in b8 useReference, in VectorSingle x, in VectorSingle y){
    PowObservation observation = PowObservation();
    if(!ObservePowKernel(
        variantCode,
        useReference,
        x,
        y,
        observation.bits,
        observation.flags.standard,
        observation.flags.mapped,
        observation.flags.nativeBits,
        observation.error
    ))
        return MakeUnexpected(Failure());
    return observation;
}

VectorSingle EncodePowSrgb(in VectorSingle linear, in u8 variantCode, in b8 useReference){
    const VectorSingle clamped = Saturate(linear);
    const VectorSingle exponent = VectorSingle(s_EncodeExponent, s_EncodeExponent, s_EncodeExponent, s_EncodeExponent);
    u32x4 powBits = u32x4(0u, 0u, 0u, 0u);
    EvaluatePowKernel(variantCode, useReference, clamped, exponent, powBits);
    const VectorSingle nonlinear = VectorSingle(powBits) * 1.055f - VectorSingle(0.055f, 0.055f, 0.055f, 0.055f);
    u32x4 branchBits = u32x4(0u, 0u, 0u, 0u);
    SelectPowSrgbLinearBranch(nonlinear, clamped * 12.92f, clamped, 0.0031308f, branchBits);
    const VectorSingle encoded = VectorSingle(branchBits);
    const VectorSingle scaled = Saturate(encoded) * 255.0f + VectorSingle(0.5f, 0.5f, 0.5f, 0.5f);
    return Min(Floor(scaled), VectorSingle(255.0f, 255.0f, 255.0f, 255.0f));
}

b8 ComparePowCase(
    in StringView category,
    in PowVariant variant,
    in VectorSingle x,
    in VectorSingle y,
    in b8 quantize,
    mut PowCounts counts
){
    const u8 variantCode = cast<u8>(variant);
    const Expected<PowObservation> expected = ObservePow(variantCode, true, x, y);
    const Expected<PowObservation> actual = ObservePow(variantCode, false, x, y);
    if(!expected.has_value() || !actual.has_value())
        return false;
    ++counts.vectors;

    const b8 flagsDiffer = !EqualPowFlags(expected.value().flags, actual.value().flags);
    const b8 errorDiffers = expected.value().error != actual.value().error;
    if(flagsDiffer)
        ++counts.flags;
    if(errorDiffers)
        ++counts.errors;

    for(usize lane = 0u; lane < 4u; ++lane){
        const u32 expectedBits = expected.value().bits[lane];
        const u32 actualBits = actual.value().bits[lane];
        if(expectedBits != actualBits){
            if(counts.bits < 4u){
                WriteBenchmarkStdout(StringFormat(
                    "bits category={} lane={} x=0x{:x} y=0x{:x} expected=0x{:x} actual=0x{:x}\n",
                    category,
                    lane,
                    SimdGetSingleLaneBits(x, lane),
                    SimdGetSingleLaneBits(y, lane),
                    expectedBits,
                    actualBits
                ));
            }
            ++counts.bits;
        }
    }
    if(flagsDiffer && counts.flags <= 2u){
        const PowFlagsSnapshot expFlags = expected.value().flags;
        const PowFlagsSnapshot actFlags = actual.value().flags;
        WriteBenchmarkStdout(StringFormat(
            "flags category={} x0=0x{:x} y0=0x{:x} expected={}/{}/{} actual={}/{}/{}\n",
            category,
            SimdGetSingleLaneBits(x, 0u),
            SimdGetSingleLaneBits(y, 0u),
            expFlags.standard,
            expFlags.mapped,
            expFlags.nativeBits,
            actFlags.standard,
            actFlags.mapped,
            actFlags.nativeBits
        ));
    }
    if(errorDiffers && counts.errors <= 2u){
        WriteBenchmarkStdout(StringFormat(
            "errno category={} x0=0x{:x} y0=0x{:x} expected={} actual={}\n",
            category,
            SimdGetSingleLaneBits(x, 0u),
            SimdGetSingleLaneBits(y, 0u),
            expected.value().error,
            actual.value().error
        ));
    }
    if(quantize){
        const VectorSingle expectedQuantized = EncodePowSrgb(x, variantCode, true);
        const VectorSingle actualQuantized = EncodePowSrgb(x, variantCode, false);
        for(usize lane = 0u; lane < 4u; ++lane){
            if(SimdGetSingleLaneBits(expectedQuantized, lane) != SimdGetSingleLaneBits(actualQuantized, lane)){
                if(counts.quantized < 4u){
                    WriteBenchmarkStdout(StringFormat(
                        "quantized category={} lane={} x=0x{:x} expected={} actual={}\n",
                        category,
                        lane,
                        SimdGetSingleLaneBits(x, lane),
                        SimdGetSingleLane(expectedQuantized, lane),
                        SimdGetSingleLane(actualQuantized, lane)
                    ));
                }
                ++counts.quantized;
            }
        }
    }
    return true;
}

void PrintPowCounts(in StringView category, in PowCounts counts){
    WriteBenchmarkStdout(StringFormat(
        "summary category={} vectors={} lanes={} bits={} flags={} errno={} quantized={}\n",
        category,
        counts.vectors,
        counts.vectors * 4u,
        counts.bits,
        counts.flags,
        counts.errors,
        counts.quantized
    ));
}

u64 TotalPowFailures(in PowCounts counts){
    return counts.bits + counts.flags + counts.errors + counts.quantized;
}

u64 VerifyPowVariant(in PowVariant variant){
    u64 failures = 0u;
    const u8 variantCode = cast<u8>(variant);
    const VectorSingle encodeExponent = VectorSingle(s_EncodeExponent, s_EncodeExponent, s_EncodeExponent, s_EncodeExponent);
    const VectorSingle decodeExponent = VectorSingle(2.4f, 2.4f, 2.4f, 2.4f);
    const VectorSingle decodeOffset = VectorSingle(0.055f, 0.055f, 0.055f, 0.055f);

    for(usize modeIndex = 0u; modeIndex < 4u; ++modeIndex){
        const i32 mode = SimdRoundingModeByIndex(modeIndex);
        if(!SetFloatingPointRoundingMode(mode).has_value()){
            ++failures;
            break;
        }
        WriteBenchmarkStdout(StringFormat("rounding={}\n", mode));
        PowCounts exceptional = PowCounts();
        PowCounts random = PowCounts();
        PowCounts positive = PowCounts();
        PowCounts srgb = PowCounts();
        b8 ok = true;

        for(usize xi = 0u; xi < s_PowExceptionalCount && ok; ++xi){
            const u32 xBits = ExceptionalPowBitAt(xi);
            for(usize yi = 0u; yi < s_PowExceptionalCount && ok; ++yi){
                const u32 yBits = ExceptionalPowBitAt(yi);
                for(usize lane = 0u; lane < 4u && ok; ++lane){
                    Array<u32, 4> leftWords;
                    Array<u32, 4> rightWords;
                    for(usize w = 0u; w < 4u; ++w){
                        leftWords[w] = 0x3f800000u;
                        rightWords[w] = 0x3f800000u;
                    }
                    leftWords[lane] = xBits;
                    rightWords[lane] = yBits;
                    const VectorSingle left = VectorSingle(u32x4(leftWords[0], leftWords[1], leftWords[2], leftWords[3]));
                    const VectorSingle right = VectorSingle(u32x4(rightWords[0], rightWords[1], rightWords[2], rightWords[3]));
                    if(!ComparePowCase(s_ExceptionalLabel, variant, left, right, false, exceptional)){
                        ++failures;
                        ok = false;
                    }
                }
            }
        }
        if(!ok)
            break;

        u64 seed = 0x8923409102431291ull;
        for(usize index = 0u; index < 32768u && ok; ++index){
            Array<u32, 4> xWords;
            Array<u32, 4> yWords;
            for(usize lane = 0u; lane < 4u; ++lane){
                xWords[lane] = cast<u32>(NextSeed(seed));
                yWords[lane] = cast<u32>(NextSeed(seed));
            }
            const VectorSingle left = VectorSingle(u32x4(xWords[0], xWords[1], xWords[2], xWords[3]));
            const VectorSingle right = VectorSingle(u32x4(yWords[0], yWords[1], yWords[2], yWords[3]));
            if(!ComparePowCase(s_RandomLabel, variant, left, right, false, random)){
                ++failures;
                ok = false;
            }
        }
        if(!ok)
            break;

        for(usize index = 0u; index < 65536u && ok; ++index){
            Array<u32, 4> xWords;
            Array<u32, 4> yWords;
            for(usize lane = 0u; lane < 4u; ++lane){
                xWords[lane] = 0x00800000u + cast<u32>(NextSeed(seed) % 0x7f000000u);
                yWords[lane] = (0x3c000000u + cast<u32>(NextSeed(seed) % 0x06000000u)) | (cast<u32>(NextSeed(seed)) & 0x80000000u);
            }
            const VectorSingle left = VectorSingle(u32x4(xWords[0], xWords[1], xWords[2], xWords[3]));
            const VectorSingle right = VectorSingle(u32x4(yWords[0], yWords[1], yWords[2], yWords[3]));
            if(!ComparePowCase(s_PositiveFiniteLabel, variant, left, right, false, positive)){
                ++failures;
                ok = false;
            }
        }
        if(!ok)
            break;

        for(u32 first = 0u; first < 65536u && ok; first += 4u){
            const VectorSingle linear = VectorSingle(cast<f32>(first), cast<f32>(first + 1u), cast<f32>(first + 2u), cast<f32>(first + 3u)) * (1.0f / 65535.0f);
            if(!ComparePowCase("srgb_uniform16", variant, linear, encodeExponent, true, srgb)){
                ++failures;
                ok = false;
            }
        }
        if(!ok)
            break;

        for(u32 first = 0u; first < 256u && ok; first += 4u){
            const VectorSingle encoded = VectorSingle(cast<f32>(first), cast<f32>(first + 1u), cast<f32>(first + 2u), cast<f32>(first + 3u)) * (1.0f / 255.0f);
            const VectorSingle base = (encoded + decodeOffset) * s_DecodeScale;
            if(!ComparePowCase("srgb_decode8", variant, base, decodeExponent, false, srgb)){
                ++failures;
                ok = false;
            }
        }
        if(!ok)
            break;

        // Search every 8-bit transition in the actual rounded reference expression.
        for(u32 transition = 1u; transition < 256u && ok; ++transition){
            u32 lower = 0u;
            u32 upper = 0x3f800000u;
            while(lower < upper){
                const u32 midpoint = lower + (upper - lower) / 2u;
                const VectorSingle probe = VectorSingle(u32x4(midpoint, midpoint, midpoint, midpoint));
                if(EncodePowSrgb(probe, variantCode, true).x < cast<f32>(transition))
                    lower = midpoint + 1u;
                else
                    upper = midpoint;
            }
            for(i32 offset = -16; offset <= 16 && ok; ++offset){
                const u32 sampleBits = lower + cast<u32>(offset);
                const VectorSingle linear = VectorSingle(u32x4(sampleBits, sampleBits, sampleBits, sampleBits));
                if(!ComparePowCase("srgb_transition", variant, linear, encodeExponent, true, srgb)){
                    ++failures;
                    ok = false;
                }
            }
        }
        if(!ok)
            break;

        PrintPowCounts(s_ExceptionalLabel, exceptional);
        PrintPowCounts(s_RandomLabel, random);
        PrintPowCounts(s_PositiveFiniteLabel, positive);
        PrintPowCounts("srgb", srgb);
        failures += TotalPowFailures(exceptional);
        failures += TotalPowFailures(random);
        failures += TotalPowFailures(positive);
        failures += TotalPowFailures(srgb);
    }
    return failures;
}

i32 VerifyPowTraps(in PowVariant variant){
    return VerifyPowTrapsKernel(cast<u8>(variant));
}

i32 VerifyPowTrapEdges(in PowVariant variant){
    return VerifyPowTrapEdgesKernel(cast<u8>(variant));
}

i32 RunPowQualificationCli(in Span<StringView> args){
    if(args.size() != 2u && args.size() != 3u){
        WriteBenchmarkStderr("usage: simd_pow_qualification production|packed_single|packed_double [traps]\n");
        return 2;
    }
    const StringView variantText = args[1];
    const Expected<PowVariant> parsedVariant = ParsePowVariant(variantText);
    if(!parsedVariant.has_value())
        return 2;
    const PowVariant variant = parsedVariant.value();

    if(args.size() == 3u){
        if(args[2] != "traps")
            return 2;
        const i32 originalTraps = VerifyPowTraps(variant);
        if(originalTraps == 0)
            return VerifyPowTrapEdges(variant);
        return originalTraps;
    }

    PowQualificationEnvironmentScope environmentScope = PowQualificationEnvironmentScope();
    if(!environmentScope.available())
        return 2;
    WriteBenchmarkStdout(StringFormat("variant={}\n", variantText));
    const u64 failures = VerifyPowVariant(variant);
    u32 admitted = 0u;
    if(failures == 0u)
        admitted = 1u;
    WriteBenchmarkStdout(StringFormat("qualification differences={} admitted={}\n", failures, admitted));
    if(failures == 0u)
        return 0;
    return 1;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


int main(const int argc, const char* const* argv){
    if(argc <= 0)
        return 2;
    Array<StringView, 4> args{};
    const usize count = Min(static_cast<usize>(argc), args.size());
    for(usize index = 0u; index < count; ++index)
        args[index] = StringView(argv[index]);
    return SimdOptimizationBenchmark::RunPowQualificationCli(Span<const StringView>(args.data(), count));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


