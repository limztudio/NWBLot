void VerifyUiScrollLayoutTests_DisjointAndZeroAreaClipsHaveNoVisibleRowsButKeepScrolling(){
    const Rect bounds = Rect(10.0f, 20.0f, 200.0f, 100.0f);
    Array<Rect, 4u> clips;
    clips[0u] = Rect(300.0f, 20.0f, 100.0f, 100.0f);
    clips[1u] = Rect(10.0f, 200.0f, 100.0f, 100.0f);
    clips[2u] = Rect(10.0f, 20.0f, 0.0f, 100.0f);
    clips[3u] = Rect(10.0f, 20.0f, 100.0f, 0.0f);
    for(in Rect clip : clips){
        const auto placementResult = CalculateScrollPlacement(bounds, clip, Insets(), 12.0f, 16.0f, 20u, 20.0f, 40.0);
        ASSERT_TRUE(placementResult.has_value());
        const ScrollPlacement placement = placementResult.value();
        EXPECT_EQ(placement.firstRow, 0u);
        EXPECT_EQ(placement.endRow, 0u);
        EXPECT_DOUBLE_EQ(placement.offset, 40.0);
        EXPECT_DOUBLE_EQ(placement.maxOffset, 300.0);
        EXPECT_TRUE(placement.scrollbarVisible);
    }
}

