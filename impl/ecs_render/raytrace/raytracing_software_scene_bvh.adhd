b8 PreparedSceneSwBvhTraversal::capture(in Span<PreparedSceneSwBvhMesh> meshes, in u32 instanceCount, in b8 storageReady, in World world){
    this.clear();
    SoftwareSceneBvhValidationPolicy validationPolicy;
    const usize meshCount = meshes.size();
    if(!validationPolicy.validateTraversalCaptureCounts(meshCount, instanceCount) || !storageReady)
        return false;

    this.m_preparedSceneSwBvhMeshes.reserve(meshCount);
    for(in PreparedSceneSwBvhMesh mesh : meshes){
        if(
            !validationPolicy.validateTraversalMeshMetadata(mesh.meshName, mesh.primitiveCount, mesh.nodeByteSize, mesh.positionByteSize, mesh.triangleIndexByteSize, mesh.attributeByteSize)
            || !mesh.nodeBuffer.valid()
            || !mesh.positionBuffer.valid()
            || !mesh.triangleIndexBuffer.valid()
            || !mesh.attributeBuffer.valid()
            || !IsDescriptorClass(mesh.nodeHeapHandle, GpuDescriptorClass::StorageBuffer)
            || !IsDescriptorClass(mesh.positionHeapHandle, GpuDescriptorClass::StorageBuffer)
            || !IsDescriptorClass(mesh.triangleIndexHeapHandle, GpuDescriptorClass::StorageBuffer)
            || !IsDescriptorClass(mesh.attributeHeapHandle, GpuDescriptorClass::StorageBuffer)
        ){
            this.clear();
            return false;
        }
        this.m_preparedSceneSwBvhMeshes.push_back(mesh);
    }
    this.m_preparedSceneSwBvhInstanceCount = instanceCount;
    this.m_preparedSceneSwBvhRendererMutationVersion = world.componentMutationVersion<RendererComponent>();
    this.m_preparedSceneSwBvhTransformMutationVersion = world.componentMutationVersion<TransformComponent>();
    this.m_preparedSceneSwBvhMaterialMutationVersion = world.componentMutationVersion<MaterialInstanceComponent>();
    this.m_preparedSceneSwBvhReady = true;
    return true;
}

b8 PreparedSceneSwBvhTraversal::matchesWorld(in World world)const{
    return world.componentMutationVersion<RendererComponent>() == this.m_preparedSceneSwBvhRendererMutationVersion
        && world.componentMutationVersion<TransformComponent>() == this.m_preparedSceneSwBvhTransformMutationVersion
        && world.componentMutationVersion<MaterialInstanceComponent>() == this.m_preparedSceneSwBvhMaterialMutationVersion;
}

b8 PreparedSceneBvhUpload::capture(in RendererRayTracingState state, in b8 staticScene, in u64 staticSceneHash, in Span<NwbBvhNodeGpu> nodes, in Span<SceneSwBvhInstanceGpu> instances){
    this.clear();
    const usize nodeCount = nodes.size();
    const usize instanceCount = instances.size();
    const b8 validStorage = IsPreparedSceneBvhStorageReady(state, nodeCount, instanceCount);
    if(nodeCount == 0u || instanceCount == 0u || !validStorage)
        return false;

    SceneBvhUploadPolicy().captureBytes(nodes, instances, this.m_nodeBytes, this.m_instanceBytes);
    this.m_nodeBuffer = state.sceneBvh.m_sceneBvhNodeBuffer;
    this.m_instanceBuffer = state.sceneBvh.m_sceneInstanceBuffer;
    this.m_nodeHeapHandle = state.sceneBvh.m_sceneBvhNodeHeapHandle;
    this.m_instanceHeapHandle = state.sceneBvh.m_sceneInstanceHeapHandle;
    this.m_nodeCount = nodeCount;
    this.m_instanceCount = instanceCount;
    this.m_nodeCapacity = state.sceneBvh.m_sceneBvhNodeCapacity;
    this.m_instanceCapacity = state.sceneBvh.m_sceneInstanceCapacity;
    this.m_staticSceneHash = staticSceneHash;
    this.m_static = staticScene;
    this.m_ready = true;
    this.m_uploadRequired = true;
    return true;
}

b8 PreparedSceneBvhUpload::captureCacheReuse(in RendererRayTracingState state, in u64 staticSceneHash, in u32 instanceCount){
    this.clear();
    if(instanceCount == 0u)
        return false;

    const usize requiredNodeCount = ComputeBinaryBvhNodeCount(cast<usize>(instanceCount));
    const b8 validStorage = IsPreparedSceneBvhStorageReady(state, requiredNodeCount, instanceCount);
    if(!state.sceneBvh.m_sceneSwBvhStaticSceneHashValid || state.sceneBvh.m_sceneSwBvhStaticSceneHash != staticSceneHash || state.sceneBvh.m_sceneBvhInstanceCount != instanceCount || !validStorage)
        return false;

    this.m_nodeBuffer = state.sceneBvh.m_sceneBvhNodeBuffer;
    this.m_instanceBuffer = state.sceneBvh.m_sceneInstanceBuffer;
    this.m_nodeHeapHandle = state.sceneBvh.m_sceneBvhNodeHeapHandle;
    this.m_instanceHeapHandle = state.sceneBvh.m_sceneInstanceHeapHandle;
    this.m_nodeCount = requiredNodeCount;
    this.m_instanceCount = instanceCount;
    this.m_nodeCapacity = state.sceneBvh.m_sceneBvhNodeCapacity;
    this.m_instanceCapacity = state.sceneBvh.m_sceneInstanceCapacity;
    this.m_staticSceneHash = staticSceneHash;
    this.m_static = true;
    this.m_ready = true;
    this.m_uploadRequired = false;
    return true;
}

b8 PreparedSceneBvhUpload::publishAcceptedUpload(mut RendererRayTracingState state)const{
    return SceneBvhUploadPolicy().publishAcceptedUpload(this.m_ready, this.m_uploadRequired, this.m_static, this.m_staticSceneHash, state.sceneBvh.m_sceneSwBvhStaticSceneHash, state.sceneBvh.m_sceneSwBvhStaticSceneHashValid);
}

b8 PreparedSceneBvhUpload::storageMatches(in RendererRayTracingState state)const{
    return state.sceneBvh.m_sceneBvhNodeBuffer == this.m_nodeBuffer
        && state.sceneBvh.m_sceneInstanceBuffer == this.m_instanceBuffer
        && state.sceneBvh.m_sceneBvhNodeCapacity == this.m_nodeCapacity
        && state.sceneBvh.m_sceneInstanceCapacity == this.m_instanceCapacity
        && state.sceneBvh.m_sceneBvhNodeHeapHandle == this.m_nodeHeapHandle
        && state.sceneBvh.m_sceneInstanceHeapHandle == this.m_instanceHeapHandle;
}

b8 PreparedSceneBvhUpload::snapshotAccepted(in RendererRayTracingState state)const{
    return SceneBvhUploadPolicy().snapshotAccepted(this.m_uploadRequired, this.m_static, state.sceneBvh.m_sceneSwBvhStaticSceneHashValid, state.sceneBvh.m_sceneSwBvhStaticSceneHash, this.m_staticSceneHash,
        state.sceneBvh.m_sceneBvhInstanceCount, this.m_instanceCount);
}


Expected<PreparedSceneBvhUploads> PreparedSceneBvhUpload::retainUploads(in RendererRayTracingState state, mut GpuTaskGraph graph)const{
    PreparedSceneBvhUploads result;
    if(!this.m_ready)
        return result;

    if(!SceneBvhUploadPolicy().validateRetainState(
        this.storageMatches(state),
        IsPreparedSceneBvhStorageReady(state, this.m_nodeCount, this.m_instanceCount),
        this.m_uploadRequired,
        this.m_static,
        state.sceneBvh.m_sceneSwBvhStaticSceneHashValid,
        state.sceneBvh.m_sceneSwBvhStaticSceneHash,
        this.m_staticSceneHash,
        state.sceneBvh.m_sceneBvhInstanceCount,
        this.m_instanceCount,
        this.m_nodeBytes.size(),
        this.m_nodeCount,
        this.m_instanceBytes.size()
    ))
        return MakeUnexpected(Failure());
    if(!this.m_uploadRequired)
        return result;

    const Expected<GpuUploadBlobId> nodeResult = graph.copyUploadBytes<NwbBvhNodeGpu>(Span<u8>(this.m_nodeBytes));
    const Expected<GpuUploadBlobId> instanceResult = graph.copyUploadBytes<SceneSwBvhInstanceGpu>(Span<u8>(this.m_instanceBytes));
    if(!(nodeResult.has_value() && instanceResult.has_value()))
        return MakeUnexpected(Failure());
    result.node = nodeResult.value();
    result.instance = instanceResult.value();
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RendererRayTracingSystem::rejectPreparedTraversal(){
    if(!this.m_preparedSceneBvh.uploadRequired())
        this.m_rayTracingState.sceneBvh.m_sceneSwBvhStaticSceneHashValid = false;
    if(!this.m_preparedShadowMaterialContext.uploadRequired())
        this.m_rayTracingState.shadow.m_swShadowMaterialContextHashValid = false;
    return false;
}

b8 RendererRayTracingSystem::matchesPreparedTraversalMesh(in MeshRayTracingResourceSnapshot mesh, in PreparedSceneSwBvhMesh prepared)const{
    if(!prepared.attributeBuffer.valid())
        return false;
    in RtMeshHeapHandleCache cache = this.m_rayTracingState.shadow.m_swMeshHeapHandleCache;
    const b8 topologyReady = mesh.swBvhTopologyBuilt || this.preparedMeshSwBvhBuildProducesTopology(mesh);
    return
        mesh.meshName == prepared.meshName
        && mesh.runtimeMesh == prepared.runtimeMesh
        && mesh.runtimeMeshVersion == prepared.runtimeMeshVersion
        && mesh.runtimeGeometryContentRevision == prepared.geometryContentRevision
        && mesh.swBvhNodeBuffer == prepared.nodeBuffer
        && mesh.positionBuffer == prepared.positionBuffer
        && mesh.triangleIndexBuffer == prepared.triangleIndexBuffer
        && mesh.attributeBuffer == prepared.attributeBuffer
        && mesh.swBvhNodeHeapHandle == prepared.nodeHeapHandle
        && mesh.swBvhPositionHeapHandle == prepared.positionHeapHandle
        && mesh.swBvhTriangleIndexHeapHandle == prepared.triangleIndexHeapHandle
        && cache.contains(prepared.attributeBuffer.identity())
        && cache.at(prepared.attributeBuffer.identity()).handle == prepared.attributeHeapHandle
        && topologyReady
        && mesh.meshletPrimitiveIndexCount == prepared.primitiveCount * s_RayTracingTriangleIndexCount
        && mesh.swBvhNodeBuffer.deref().getCreationDescription().byteSize == prepared.nodeByteSize
        && mesh.positionBuffer.deref().getCreationDescription().byteSize == prepared.positionByteSize
        && mesh.triangleIndexBuffer.deref().getCreationDescription().byteSize == prepared.triangleIndexByteSize
        && mesh.attributeBuffer.deref().getCreationDescription().byteSize == prepared.attributeByteSize
        && IsDescriptorClass(prepared.nodeHeapHandle, GpuDescriptorClass::StorageBuffer)
        && IsDescriptorClass(prepared.positionHeapHandle, GpuDescriptorClass::StorageBuffer)
        && IsDescriptorClass(prepared.triangleIndexHeapHandle, GpuDescriptorClass::StorageBuffer)
        && IsDescriptorClass(prepared.attributeHeapHandle, GpuDescriptorClass::StorageBuffer)
    ;
}

b8 RendererRayTracingSystem::recordPreparedSceneSwBvhTraversal(){
    mut RendererRayTracingState state = this.m_rayTracingState;
    const auto meshes = this.m_preparedSceneSwBvhTraversal.meshes();
    const u32 instanceCount = this.m_preparedSceneSwBvhTraversal.instanceCount();
    const SoftwareSceneBvhValidationPolicy validationPolicy();
    const b8 sceneSnapshotValid = this.m_preparedSceneBvh.snapshotAccepted(state);
    const b8 materialSnapshotValid = this.m_preparedShadowMaterialContext.softwareSnapshotAccepted(state);
    if(
        !this.m_preparedSceneSwBvhTraversal.ready()
        || meshes.empty()
        || instanceCount == 0u
        || !this.m_preparedSceneBvh.covers(instanceCount)
        || !this.m_preparedShadowMaterialContext.softwareSnapshotCovers(instanceCount)
        || !sceneSnapshotValid
        || !materialSnapshotValid
        || !this.preparedTraversalStorageMatchesCurrent()
        || !IsDescriptorClass(state.sceneBvh.m_sceneBvhNodeHeapHandle, GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(state.sceneBvh.m_sceneInstanceHeapHandle, GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(state.shadow.m_shadowInstanceMaterialHeapHandle, GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(state.shadow.m_shadowInstanceHeapHandle, GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(state.shadow.m_shadowMaterialTypedHeapHandle, GpuDescriptorClass::StorageBuffer)
    ){
        warning("RendererSystem: frozen software scene traversal no longer matches preflight storage");
        return this.rejectPreparedTraversal();
    }
    if(!this.m_preparedSceneSwBvhTraversal.matchesWorld(this.m_world)){
        warning("RendererSystem: frozen software scene inputs changed after graph preflight");
        return this.rejectPreparedTraversal();
    }

    for(in PreparedSceneSwBvhMesh prepared : meshes){
        auto meshResult = this.m_meshSystem.findRayTracingResourceSnapshot(prepared.meshName);
        if(!meshResult.has_value() || !this.matchesPreparedTraversalMesh(meshResult.value(), prepared)){
            warning("RendererSystem: frozen software scene lost mesh '{}'", prepared.meshName.resolvedText());
            return this.rejectPreparedTraversal();
        }
    }

    if(!validationPolicy.matchesTraversalTableSizes(
        state.shadow.m_swShadowMeshCount,
        meshes.size(),
        state.sceneBvh.m_sceneBvhInstanceCount,
        instanceCount,
        state.shadow.m_swShadowMeshNodeBuffers.size(),
        state.shadow.m_swShadowMeshPositionBuffers.size(),
        state.shadow.m_swShadowMeshIndexBuffers.size(),
        state.shadow.m_swShadowMeshAttributeBuffers.size(),
        state.shadow.m_swShadowMeshNodeHandles.size(),
        state.shadow.m_swShadowMeshPositionHandles.size(),
        state.shadow.m_swShadowMeshIndexHandles.size(),
        state.shadow.m_swShadowMeshAttributeHandles.size()
    )){
        warning("RendererSystem: frozen software scene traversal table changed after graph preflight");
        return this.rejectPreparedTraversal();
    }
    for(usize index = 0u; index < meshes.size(); ++index){
        in PreparedSceneSwBvhMesh prepared = meshes[index];
        if(
            !prepared.nodeBuffer.valid() || !SameAddress(state.shadow.m_swShadowMeshNodeBuffers[index], prepared.nodeBuffer.deref())
            || !prepared.positionBuffer.valid() || !SameAddress(state.shadow.m_swShadowMeshPositionBuffers[index], prepared.positionBuffer.deref())
            || !prepared.triangleIndexBuffer.valid() || !SameAddress(state.shadow.m_swShadowMeshIndexBuffers[index], prepared.triangleIndexBuffer.deref())
            || !prepared.attributeBuffer.valid() || !SameAddress(state.shadow.m_swShadowMeshAttributeBuffers[index], prepared.attributeBuffer.deref())
            || state.shadow.m_swShadowMeshNodeHandles[index] != prepared.nodeHeapHandle
            || state.shadow.m_swShadowMeshPositionHandles[index] != prepared.positionHeapHandle
            || state.shadow.m_swShadowMeshIndexHandles[index] != prepared.triangleIndexHeapHandle
            || state.shadow.m_swShadowMeshAttributeHandles[index] != prepared.attributeHeapHandle
        ){
            warning("RendererSystem: frozen software scene traversal table no longer matches preflight");
            return this.rejectPreparedTraversal();
        }
    }
    return true;
}


