void VerifyUiEditActionHostTests_OldEpochCancelDoesNotClearLaterRefocusOrApplyItsRetiredBlur(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    ASSERT_TRUE(self.replaceNative("42"));
