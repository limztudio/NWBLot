#include <impl/ecs_render/deferred/deferred_internal.adhd>
#include <impl/ecs_render/deferred/deferred_system.adhd>
#include <impl/ecs_render/kernel/descriptor_register_utils.adhd>
#include <impl/ecs_render/kernel/renderer_constants_private.adhd>


