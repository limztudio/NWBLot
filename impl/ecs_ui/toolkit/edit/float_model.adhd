////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "numeric_model_operations.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class FloatEditModel : NoCopy{
    private NumericEditDraft m_draft;
    private f64 m_value = s_DefaultFloatEditValue;

    [cpp_unwind] public FloatEditModel(){
        if(!this.canonicalize(this.m_value).has_value())
            TerminateInvariant();
    }

    public f64 value()const{ return this.m_value; }

    public in EditModel draft()const{ return this.m_draft.model(); }

    public mut EditModel lendDraft(){ return this.m_draft.lend(); }

    public b8 dirty()const{ return this.m_draft.dirty(); }

    public u64 revision()const{ return this.m_draft.revision(); }

    [cpp_unwind] public b8 setDraft(in StringView text){ return this.m_draft.setText(text); }

    [cpp_unwind] public b8 setValue(in f64 value){
        if(!IsFinite(VectorDouble(value)) || !this.canonicalize(value).has_value())
            return false;
        this.m_value = value;
        this.m_draft.advance();
        return true;
    }

    public NumericParseStatus status(in FloatBounds bounds)const{ return EvaluateFloatDraftStatus(this.draft().text(), bounds); }

    public NumericParseStatus status()const{ return this.status(FloatBounds()); }

    [cpp_unwind] public NumericEditResult submit(in FloatBounds bounds){ return this.commit(bounds, false); }

    [cpp_unwind] public NumericEditResult submit(){ return this.submit(FloatBounds()); }

    [cpp_unwind] public NumericEditResult blur(in FloatBounds bounds){ return this.commit(bounds, true); }

    [cpp_unwind] public NumericEditResult blur(){ return this.blur(FloatBounds()); }

    [cpp_unwind] public NumericEditResult cancel(){ return this.m_draft.restore(this.canonicalize(this.m_value), true); }

    [cpp_unwind] public NumericEditResult abandon(){ return this.m_draft.restore(this.canonicalize(this.m_value), false); }

    [cpp_unwind] public NumericEditResult applyAction(in FloatBounds bounds, in EditAction action, in b8 readOnly){
        return ApplyNumericEditModelAction(bounds, ParseFloatDraft(this.draft().text()), action, readOnly, this.m_draft, this.m_value);
    }

    [cpp_unwind] private Expected<b8, ErrorCode> canonicalize(in f64 value){
        return CanonicalizeNumericEditDraft(value, this.m_draft);
    }

    [cpp_unwind] private NumericEditResult commit(in FloatBounds bounds, in b8 canonical){
        return CommitNumericEdit(bounds, ParseFloatDraft(this.draft().text()), canonical, this.m_draft, this.m_value);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

