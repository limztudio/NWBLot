class GpuHazardOwnerExpectedHazard{
    public usize producer = 0u;
    public usize consumer = 0u;
    public GpuTaskHazardTypeEnum hazard = GpuTaskHazardType::Explicit;
}

class GpuHazardOwnerIndexPair{
    public usize first = 0u;
    public usize second = 0u;
}

GpuHazardOwnerExpectedHazard GpuHazardOwner_MakeExpectedHazard(in usize p, in usize c, in GpuTaskHazardTypeEnum h){
    GpuHazardOwnerExpectedHazard out = GpuHazardOwnerExpectedHazard();
    out.producer = p;
    out.consumer = c;
    out.hazard = h;
    return out;
}

GpuHazardOwnerIndexPair GpuHazardOwner_MakeIndexPair(in usize f, in usize s){
    GpuHazardOwnerIndexPair out = GpuHazardOwnerIndexPair();
    out.first = f;
    out.second = s;
    return out;
}

SingleQueueCompile GpuHazardOwner_MakeSingleQueueCompile(mut TestArena testArena){
    return SingleQueueCompile(testArena);
}

ThreeQueueCompile GpuHazardOwner_MakeThreeQueueCompile(mut TestArena testArena){
    return ThreeQueueCompile(testArena);
}

GpuPhysicalQueueId GpuHazardOwner_MakeQueueId(in u16 index, in u16 deviceGeneration){
    GpuPhysicalQueueId id = GpuPhysicalQueueId();
    id.index = index;
    id.deviceGeneration = deviceGeneration;
    return id;
}

QueueSubmissionToken GpuHazardOwner_MakeToken(
    in u64 value,
    in u16 physicalQueueIndex,
    in u16 deviceGeneration,
    in CommandQueueEnum queue
){
    QueueSubmissionToken token = QueueSubmissionToken();
    token.value = value;
    token.physicalQueueIndex = physicalQueueIndex;
    token.deviceGeneration = deviceGeneration;
    token.queue = queue;
    return token;
}

Expected<GpuTaskId> GpuHazardOwner_AddEmptyTask(in Name identity, in AStringView label, mut GpuTaskGraph graph){
    const Span<GpuTaskId> emptyDeps = Span<GpuTaskId>();
    const Span<GpuTaskResourceUse> emptyUses = Span<GpuTaskResourceUse>();
    const Span<GpuTaskResourceSetUse> emptySets = Span<GpuTaskResourceSetUse>();
    const Span<GpuTaskResourceVersionUse> emptyVersions = Span<GpuTaskResourceVersionUse>();
    const Span<GpuExternalCompletionId> emptyExternals = Span<GpuExternalCompletionId>();
    return AddTask(identity, label, emptyDeps, emptyUses, emptySets, emptyVersions, emptyExternals, graph);
}

Expected<GpuTaskId> GpuHazardOwner_AddDepTask(in Name identity, in AStringView label, in Span<GpuTaskId> deps, mut GpuTaskGraph graph){
    const Span<GpuTaskResourceUse> emptyUses = Span<GpuTaskResourceUse>();
    const Span<GpuTaskResourceSetUse> emptySets = Span<GpuTaskResourceSetUse>();
    const Span<GpuTaskResourceVersionUse> emptyVersions = Span<GpuTaskResourceVersionUse>();
    const Span<GpuExternalCompletionId> emptyExternals = Span<GpuExternalCompletionId>();
    return AddTask(identity, label, deps, emptyUses, emptySets, emptyVersions, emptyExternals, graph);
}

Expected<GpuTaskId> GpuHazardOwner_AddUseTask(in Name identity, in AStringView label, in Span<GpuTaskResourceUse> uses, mut GpuTaskGraph graph){
    const Span<GpuTaskId> emptyDeps = Span<GpuTaskId>();
    const Span<GpuTaskResourceSetUse> emptySets = Span<GpuTaskResourceSetUse>();
    const Span<GpuTaskResourceVersionUse> emptyVersions = Span<GpuTaskResourceVersionUse>();
    const Span<GpuExternalCompletionId> emptyExternals = Span<GpuExternalCompletionId>();
    return AddTask(identity, label, emptyDeps, uses, emptySets, emptyVersions, emptyExternals, graph);
}

GpuTaskResourceUse GpuHazardOwner_BufferUse(
    in GpuGraphResourceId resource,
    in u64 offset,
    in u64 size,
    in GpuTaskResourceAccessEnum access
){
    GpuTaskResourceUse use = GpuTaskResourceUse();
    use.resource = resource;
    use.range.bufferRange = BufferRange(offset, size);
    if(access == GpuTaskResourceAccess::Read)
        use.requiredState = ResourceStates::ShaderResource;
    else
        use.requiredState = ResourceStates::UnorderedAccess;
    use.access = access;
    return use;
}

void VerifyGpuHazardOwner_HazardTrackingPreservesResourceAndSurvivingWriterOrder(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto bufferAResult = AddBufferMetadata(graph, s_GpuCaseHazardTrackingA, "A");
    ASSERT_TRUE(bufferAResult.has_value());
    const GpuGraphResourceId bufferA = bufferAResult.value();
    const auto bufferBResult = AddBufferMetadata(graph, s_GpuCaseHazardTrackingB, "B");
    ASSERT_TRUE(bufferBResult.has_value());
    const GpuGraphResourceId bufferB = bufferBResult.value();
    ASSERT_TRUE(bufferA.valid());
    ASSERT_TRUE(bufferB.valid());

    Array<GpuTaskResourceUse, 11> uses = Array<GpuTaskResourceUse, 11>();
    uses[0u] = GpuHazardOwner_BufferUse(bufferA, 0u, 16u, GpuTaskResourceAccess::Write);
    uses[1u] = GpuHazardOwner_BufferUse(bufferB, 0u, 64u, GpuTaskResourceAccess::Write);
    uses[2u] = GpuHazardOwner_BufferUse(bufferA, 16u, 16u, GpuTaskResourceAccess::Write);
    uses[3u] = GpuHazardOwner_BufferUse(bufferA, 32u, 16u, GpuTaskResourceAccess::Write);
    uses[4u] = GpuHazardOwner_BufferUse(bufferA, 16u, 16u, GpuTaskResourceAccess::Write);
    uses[5u] = GpuHazardOwner_BufferUse(bufferA, 0u, 48u, GpuTaskResourceAccess::Read);
    uses[6u] = GpuHazardOwner_BufferUse(bufferA, 0u, 48u, GpuTaskResourceAccess::Write);
    uses[7u] = GpuHazardOwner_BufferUse(bufferA, 0u, 48u, GpuTaskResourceAccess::Read);
    uses[8u] = GpuHazardOwner_BufferUse(bufferB, 0u, 64u, GpuTaskResourceAccess::Read);
    uses[9u] = GpuHazardOwner_BufferUse(bufferA, 16u, 16u, GpuTaskResourceAccess::Write);
    uses[10u] = GpuHazardOwner_BufferUse(bufferA, 0u, 48u, GpuTaskResourceAccess::Read);

    Array<GpuTaskId, 11> tasks = Array<GpuTaskId, 11>();
    for(usize index = 0u; index < uses.size(); ++index){
        const auto derivedNameResult = IndexedName(s_GpuCaseHazardTrackingTask, index);
        ASSERT_TRUE(derivedNameResult.has_value());
        Array<GpuTaskResourceUse, 1> singleUse = Array<GpuTaskResourceUse, 1>();
        singleUse[0u] = uses[index];
        const auto taskAdmission = GpuHazardOwner_AddUseTask(derivedNameResult.value(), "Task", singleUse, graph);
        ASSERT_TRUE(taskAdmission.has_value());
        tasks[index] = taskAdmission.value();
        ASSERT_TRUE(tasks[index].valid());
    }

    Array<GpuHazardOwnerExpectedHazard, 14> expected = Array<GpuHazardOwnerExpectedHazard, 14>();
    expected[0u] = GpuHazardOwner_MakeExpectedHazard(2u, 4u, GpuTaskHazardType::WriteAfterWrite);
    expected[1u] = GpuHazardOwner_MakeExpectedHazard(0u, 5u, GpuTaskHazardType::ReadAfterWrite);
    expected[2u] = GpuHazardOwner_MakeExpectedHazard(3u, 5u, GpuTaskHazardType::ReadAfterWrite);
    expected[3u] = GpuHazardOwner_MakeExpectedHazard(4u, 5u, GpuTaskHazardType::ReadAfterWrite);
    expected[4u] = GpuHazardOwner_MakeExpectedHazard(0u, 6u, GpuTaskHazardType::WriteAfterWrite);
    expected[5u] = GpuHazardOwner_MakeExpectedHazard(3u, 6u, GpuTaskHazardType::WriteAfterWrite);
    expected[6u] = GpuHazardOwner_MakeExpectedHazard(4u, 6u, GpuTaskHazardType::WriteAfterWrite);
    expected[7u] = GpuHazardOwner_MakeExpectedHazard(5u, 6u, GpuTaskHazardType::WriteAfterRead);
    expected[8u] = GpuHazardOwner_MakeExpectedHazard(6u, 7u, GpuTaskHazardType::ReadAfterWrite);
    expected[9u] = GpuHazardOwner_MakeExpectedHazard(1u, 8u, GpuTaskHazardType::ReadAfterWrite);
    expected[10u] = GpuHazardOwner_MakeExpectedHazard(6u, 9u, GpuTaskHazardType::WriteAfterWrite);
    expected[11u] = GpuHazardOwner_MakeExpectedHazard(7u, 9u, GpuTaskHazardType::WriteAfterRead);
    expected[12u] = GpuHazardOwner_MakeExpectedHazard(6u, 10u, GpuTaskHazardType::ReadAfterWrite);
    expected[13u] = GpuHazardOwner_MakeExpectedHazard(9u, 10u, GpuTaskHazardType::ReadAfterWrite);

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_EQ(analysis.inferredEdges().size(), expected.size());
    for(usize index = 0u; index < expected.size(); ++index){
        const GpuTaskDependencyEdge edge = analysis.inferredEdges()[index];
        EXPECT_EQ(edge.producer, tasks[expected[index].producer]);
        EXPECT_EQ(edge.consumer, tasks[expected[index].consumer]);
        EXPECT_EQ(edge.hazard, expected[index].hazard);
        GpuGraphResourceId expectedRes = bufferA;
        if(expected[index].consumer == 8u)
            expectedRes = bufferB;
        EXPECT_EQ(edge.resource, expectedRes);
    }
}

void VerifyGpuHazardOwner_HazardTrackingRetiresOnlyCoveredReadersAndPreservesAppendOrder(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto bufferResult = AddBufferMetadata(graph, s_GpuCaseHazardTrackingReaders, "Readers");
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    ASSERT_TRUE(buffer.valid());

    Array<GpuTaskResourceUse, 8> uses = Array<GpuTaskResourceUse, 8>();
    uses[0u] = GpuHazardOwner_BufferUse(buffer, 0u, 16u, GpuTaskResourceAccess::Read);
    uses[1u] = GpuHazardOwner_BufferUse(buffer, 16u, 16u, GpuTaskResourceAccess::Read);
    uses[2u] = GpuHazardOwner_BufferUse(buffer, 32u, 16u, GpuTaskResourceAccess::Read);
    uses[3u] = GpuHazardOwner_BufferUse(buffer, 16u, 16u, GpuTaskResourceAccess::Write);
    uses[4u] = GpuHazardOwner_BufferUse(buffer, 48u, 16u, GpuTaskResourceAccess::Read);
    uses[5u] = GpuHazardOwner_BufferUse(buffer, 0u, 64u, GpuTaskResourceAccess::Write);
    uses[6u] = GpuHazardOwner_BufferUse(buffer, 0u, 16u, GpuTaskResourceAccess::Read);
    uses[7u] = GpuHazardOwner_BufferUse(buffer, 0u, 64u, GpuTaskResourceAccess::Write);

    Array<GpuTaskId, 8> tasks = Array<GpuTaskId, 8>();
    for(usize index = 0u; index < uses.size(); ++index){
        const auto derivedNameResult = IndexedName(s_GpuCaseHazardTrackingReadTask, index);
        ASSERT_TRUE(derivedNameResult.has_value());
        Array<GpuTaskResourceUse, 1> singleUse = Array<GpuTaskResourceUse, 1>();
        singleUse[0u] = uses[index];
        const auto taskAdmission = GpuHazardOwner_AddUseTask(derivedNameResult.value(), "Read Task", singleUse, graph);
        ASSERT_TRUE(taskAdmission.has_value());
        tasks[index] = taskAdmission.value();
        ASSERT_TRUE(tasks[index].valid());
    }

    Array<GpuHazardOwnerIndexPair, 8> expectedPairs = Array<GpuHazardOwnerIndexPair, 8>();
    expectedPairs[0u] = GpuHazardOwner_MakeIndexPair(1u, 3u);
    expectedPairs[1u] = GpuHazardOwner_MakeIndexPair(3u, 5u);
    expectedPairs[2u] = GpuHazardOwner_MakeIndexPair(0u, 5u);
    expectedPairs[3u] = GpuHazardOwner_MakeIndexPair(2u, 5u);
    expectedPairs[4u] = GpuHazardOwner_MakeIndexPair(4u, 5u);
    expectedPairs[5u] = GpuHazardOwner_MakeIndexPair(5u, 6u);
    expectedPairs[6u] = GpuHazardOwner_MakeIndexPair(5u, 7u);
    expectedPairs[7u] = GpuHazardOwner_MakeIndexPair(6u, 7u);

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_EQ(analysis.inferredEdges().size(), expectedPairs.size());
    for(usize index = 0u; index < expectedPairs.size(); ++index){
        EXPECT_EQ(analysis.inferredEdges()[index].producer, tasks[expectedPairs[index].first]);
        EXPECT_EQ(analysis.inferredEdges()[index].consumer, tasks[expectedPairs[index].second]);
    }
}

void VerifyGpuHazardOwner_HazardTrackingPreservesSameTaskAccessAndResetSemantics(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    for(usize iteration = 0u; iteration < 2u; ++iteration){
        const auto bufferResult = AddBufferMetadata(graph, s_GpuCaseHazardTrackingSameTask, "Same Task");
        ASSERT_TRUE(bufferResult.has_value());
        const GpuGraphResourceId buffer = bufferResult.value();
        ASSERT_TRUE(buffer.valid());
        Array<GpuTaskResourceUse, 3> firstUses = Array<GpuTaskResourceUse, 3>();
        firstUses[0u] = GpuHazardOwner_BufferUse(buffer, 0u, 32u, GpuTaskResourceAccess::Write);
        firstUses[1u] = GpuHazardOwner_BufferUse(buffer, 0u, 16u, GpuTaskResourceAccess::Read);
        firstUses[2u] = GpuHazardOwner_BufferUse(buffer, 32u, 16u, GpuTaskResourceAccess::Read);
        const auto firstResult = GpuHazardOwner_AddUseTask(s_GpuCaseHazardTrackingFirst, "First", firstUses, graph);
        ASSERT_TRUE(firstResult.has_value());
        const GpuTaskId first = firstResult.value();

        Array<GpuTaskResourceUse, 1> secondUses = Array<GpuTaskResourceUse, 1>();
        secondUses[0u] = GpuHazardOwner_BufferUse(buffer, 0u, 48u, GpuTaskResourceAccess::Write);
        const auto secondResult = GpuHazardOwner_AddUseTask(s_GpuCaseHazardTrackingSecond, "Second", secondUses, graph);
        ASSERT_TRUE(secondResult.has_value());
        const GpuTaskId second = secondResult.value();

        Array<GpuTaskResourceUse, 1> thirdUses = Array<GpuTaskResourceUse, 1>();
        thirdUses[0u] = GpuHazardOwner_BufferUse(buffer, 0u, 48u, GpuTaskResourceAccess::ReadWrite);
        const auto thirdResult = GpuHazardOwner_AddUseTask(s_GpuCaseHazardTrackingThird, "Third", thirdUses, graph);
        ASSERT_TRUE(thirdResult.has_value());
        const GpuTaskId third = thirdResult.value();

        ASSERT_TRUE(first.valid());
        ASSERT_TRUE(second.valid());
        ASSERT_TRUE(third.valid());
        ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
        ASSERT_EQ(analysis.inferredEdges().size(), 4u);
        EXPECT_TRUE(HasInferredHazard(analysis, first, second, buffer, GpuTaskHazardType::WriteAfterWrite));
        EXPECT_TRUE(HasInferredHazard(analysis, first, second, buffer, GpuTaskHazardType::WriteAfterRead));
        EXPECT_TRUE(HasInferredHazard(analysis, second, third, buffer, GpuTaskHazardType::ReadAfterWrite));
        EXPECT_TRUE(HasInferredHazard(analysis, second, third, buffer, GpuTaskHazardType::WriteAfterWrite));
        graph.reset();
    }
}

GpuGraphResourceDesc GpuHazardOwner_ImportResourceDesc(in Name identity, in GpuGraphResourceTypeEnum resourceType){
    GpuGraphResourceDesc desc = GpuGraphResourceDesc();
    desc.setIdentity(identity);
    desc.setMarkerLabel("Graph Import Index Resource");
    desc.setType(resourceType);
    desc.setInitialState(ResourceStates::Unknown);
    return desc;
}

GraphStamp GpuHazardOwner_ReadStamp(in GpuTaskGraph graph){
    const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
    EXPECT_TRUE(view.valid());
    GraphStamp stamp = GraphStamp();
    stamp.generation = view.generation();
    stamp.revision = view.declarationRevision();
    stamp.resources = view.resourceCount();
    stamp.sets = view.resourceSetCount();
    return stamp;
}

void GpuHazardOwner_ExpectUnchanged(in GpuTaskGraph graph, in GraphStamp before){
    const GraphStamp after = GpuHazardOwner_ReadStamp(graph);
    EXPECT_EQ(after.generation, before.generation);
    EXPECT_EQ(after.revision, before.revision);
    EXPECT_EQ(after.resources, before.resources);
    EXPECT_EQ(after.sets, before.sets);
}

void GpuHazardOwner_PrepareImportContext(mut GpuHazardOwnerImportContext context, in usize count){
    context.genericDescriptions.resize(count);
    context.setDescriptions.resize(count);
    context.resources.resize(count);
    context.sets.resize(count);
    for(usize index = 0u; index < count; ++index){
        const auto resourceNameResult = IndexedName(s_GpuCaseGraphImportIndexGeneric, index);
        ASSERT_TRUE(resourceNameResult.has_value());
        context.genericDescriptions[index] = GpuHazardOwner_ImportResourceDesc(resourceNameResult.value(), GpuGraphResourceType::HazardDomain);
        const auto secondResourceNameResult = IndexedName(s_GpuCaseGraphImportIndexSet, index);
        ASSERT_TRUE(secondResourceNameResult.has_value());
        const Name setName = secondResourceNameResult.value();
        context.setDescriptions[index].setIdentity(setName);
        context.setDescriptions[index].setMarkerLabel("Graph Import Index Set");
        context.setDescriptions[index].setMembers(context.singleResourceSpan(index));
    }
}

void VerifyGpuHazardOwner_EveryNameHashLaneParticipatesAndResourceSetIdentityHasItsOwnNamespace(){
    GpuHazardOwnerImportContext context = GpuHazardOwnerImportContext();
    const usize count = 64u;
    context.resources.resize(count);
    context.sets.resize(count);
    Vector<Name> identities = Vector<Name>();
    identities.reserve(count);
    for(usize index = 0u; index < count; ++index){
        NameHash hash = ComputeNameHash(MakeNotNull("tests/graph_import_index/full_identity"));
        hash.qwords[index % s_NameHashLaneCount] ^= cast<u64>(index + 1u);
        const Name laneIdentity = Name(hash);
        identities.push_back(laneIdentity);
        const GpuGraphResourceDesc description = GpuHazardOwner_ImportResourceDesc(identities.back(), GpuGraphResourceType::HazardDomain);
        const auto resourceTaskAdmission = context.graph.importResource(description);
        ASSERT_TRUE(resourceTaskAdmission.has_value());
        context.resources[index] = resourceTaskAdmission.value();
        ASSERT_TRUE(context.resources[index].valid());
        EXPECT_EQ(context.resources[index].index, index);

        Array<GpuGraphResourceId, 1> memberArr = Array<GpuGraphResourceId, 1>();
        memberArr[0u] = context.resources[index];
        GpuGraphResourceSetDesc setDesc = GpuGraphResourceSetDesc();
        setDesc.setIdentity(identities.back());
        setDesc.setMarkerLabel("Binary Identity Set");
        setDesc.setMembers(memberArr);
        const auto setTaskAdmission = context.graph.importResourceSet(setDesc);
        ASSERT_TRUE(setTaskAdmission.has_value());
        context.sets[index] = setTaskAdmission.value();
        ASSERT_TRUE(context.sets[index].valid());
        EXPECT_EQ(context.sets[index].index, index);
    }

    const GraphStamp before = GpuHazardOwner_ReadStamp(context.graph);
    for(usize remaining = count; remaining != 0u; --remaining){
        const usize index = remaining - 1u;
        const Name equalIdentity = Name(identities[index].identityHash());
        {
            const auto gpuTaskAdmission = context.graph.importResource(GpuHazardOwner_ImportResourceDesc(equalIdentity, GpuGraphResourceType::HazardDomain));
            EXPECT_TRUE(gpuTaskAdmission.has_value());
            if(gpuTaskAdmission.has_value())
                EXPECT_EQ(gpuTaskAdmission.value(), context.resources[index]);
        }
        {
            Array<GpuGraphResourceId, 1> memberArr = Array<GpuGraphResourceId, 1>();
            memberArr[0u] = context.resources[index];
            GpuGraphResourceSetDesc setDesc = GpuGraphResourceSetDesc();
            setDesc.setIdentity(equalIdentity);
            setDesc.setMarkerLabel("Later Binary Identity Label");
            setDesc.setMembers(memberArr);
            const auto secondGpuTaskAdmission = context.graph.importResourceSet(setDesc);
            EXPECT_TRUE(secondGpuTaskAdmission.has_value());
            if(secondGpuTaskAdmission.has_value())
                EXPECT_EQ(secondGpuTaskAdmission.value(), context.sets[index]);
        }
    }
    GpuHazardOwner_ExpectUnchanged(context.graph, before);
    ASSERT_FALSE(TestHasFatalFailure());
    EXPECT_EQ(before.resources, count);
    EXPECT_EQ(before.sets, count);
}

void VerifyGpuHazardOwner_DuplicatePointerRollsBackOnlyNewIdentity(){
    GpuHazardImportIndexRig rig = GpuHazardImportIndexRig();
    rig.resources.resize(32u);
    for(usize idx = 0u; idx < rig.resources.size(); ++idx){
        const Expected<Name> name = IndexedName(s_TaskGraphImportPrefix, idx);
        ASSERT_TRUE(name.has_value());
        rig.resources[idx].identity = name.value();
    }
    const GpuHazardResourcePointerKey pointer = MakeNonNullBufferPointerKey();
    rig.index.prepareResourceIndexes(rig.resources, pointer);
    const Name first = Name(s_TaskGraphImportFirstPointer);
    const Name second = Name(s_TaskGraphImportRejectedPointer);
    GpuHazardImportPublication accepted = GpuHazardImportPublication();
    ASSERT_TRUE(rig.index.publishResource(first.identityHash(), pointer, 32u, accepted));
    GpuHazardImportPublication rejected = GpuHazardImportPublication();
    EXPECT_FALSE(rig.index.publishResource(second.identityHash(), pointer, 33u, rejected));
    EXPECT_TRUE(rejected.identity);
    EXPECT_FALSE(rejected.pointer);
    rig.index.rollbackResource(second.identityHash(), pointer, rejected);
    EXPECT_EQ(rig.index.findResourceIdentity(rig.resources, second), u32.max);
    EXPECT_EQ(rig.index.findResourceIdentity(rig.resources, first), 32u);
    const auto match = FindNullIdentityResourceImportMatch(rig, pointer);
    EXPECT_TRUE(match.samePointer);
    EXPECT_EQ(match.index, 32u);
}

void VerifyGpuHazardOwner_ManySetsReuseOnlyTheirOriginalOrderedMembersAndRetainFirstLabels(){
    GpuHazardOwnerImportContext context = GpuHazardOwnerImportContext();
    const usize count = 96u;
    GpuHazardOwner_PrepareImportContext(context, count);
    ASSERT_FALSE(TestHasFatalFailure());
    for(usize index = 0u; index < count; ++index){
        const auto resourceTaskAdmission = context.graph.importResource(context.genericDescriptions[index]);
        ASSERT_TRUE(resourceTaskAdmission.has_value());
        context.resources[index] = resourceTaskAdmission.value();
        ASSERT_TRUE(context.resources[index].valid());
        const auto setTaskAdmission = context.graph.importResourceSet(context.setDescriptions[index]);
        ASSERT_TRUE(setTaskAdmission.has_value());
        context.sets[index] = setTaskAdmission.value();
        ASSERT_TRUE(context.sets[index].valid());
    }
    const GraphStamp before = GpuHazardOwner_ReadStamp(context.graph);
    for(usize index = 0u; index < count; ++index){
        const usize selected = (index * 73u) % count;
        GpuGraphResourceSetDesc description = context.setDescriptions[selected];
        description.markerLabel = "Different Later Set Label";
        {
            const auto gpuTaskAdmission = context.graph.importResourceSet(description);
            EXPECT_TRUE(gpuTaskAdmission.has_value());
            if(gpuTaskAdmission.has_value())
                EXPECT_EQ(gpuTaskAdmission.value(), context.sets[selected]);
        }
        Array<GpuGraphResourceId, 1> mismatchedMembers = Array<GpuGraphResourceId, 1>();
        mismatchedMembers[0u] = context.resources[(selected + 1u) % count];
        description.setMembers(mismatchedMembers);
        EXPECT_FALSE(context.graph.importResourceSet(description).has_value());
    }
    GpuHazardOwner_ExpectUnchanged(context.graph, before);
    ASSERT_FALSE(TestHasFatalFailure());

    const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(context.graph);
    ASSERT_TRUE(view.valid());
    for(usize index = 0u; index < count; ++index){
        const GpuTaskGraphResourceSetView set = view.resourceSetAt(context.sets[index].index);
        EXPECT_EQ(set.identity, context.setDescriptions[index].identity);
        EXPECT_EQ(set.markerLabel, "Graph Import Index Set");
        ASSERT_EQ(set.memberCount, 1u);
        EXPECT_EQ(ResourceSetMembersSpan(set)[0u], context.resources[index]);
    }
}

void VerifyGpuHazardOwner_PreservesCompletionUpgradeConflictsAndResetAcrossIndexBoundaries(){
    Array<usize, 3> prefixCounts = Array<usize, 3>();
    prefixCounts[0u] = 0u;
    prefixCounts[1u] = 32u;
    prefixCounts[2u] = 33u;
    for(in usize prefixCount : prefixCounts){
        const ScopedTestTrace trace = ScopedTestTrace(prefixCount);
        TestArena testArena = TestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        for(usize index = 0u; index < prefixCount; ++index){
            const auto prefixNameResult = IndexedName(s_GpuCaseImportScalingCompletionPrefix, index);
            ASSERT_TRUE(prefixNameResult.has_value());
            GpuExternalCompletionDesc prefixDesc = GpuExternalCompletionDesc();
            prefixDesc.setIdentity(prefixNameResult.value());
            prefixDesc.setMarkerLabel("Completion Prefix");
            const auto gpuTaskAdmission = graph.importExternalCompletion(prefixDesc);
            ASSERT_TRUE(gpuTaskAdmission.has_value());
            ASSERT_TRUE(gpuTaskAdmission.value().valid());
        }

        GpuExternalCompletionDesc metadata = GpuExternalCompletionDesc();
        metadata.setIdentity(s_GpuCaseImportScalingUpgradedCompletion);
        metadata.setMarkerLabel("Original Completion");
        const auto idResult = graph.importExternalCompletion(metadata);
        ASSERT_TRUE(idResult.has_value());
        const GpuExternalCompletionId id = idResult.value();
        ASSERT_TRUE(id.valid());
        u64 metadataRevision = 0u;
        {
            const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
            metadataRevision = view.declarationRevision();
        }

        GpuExternalCompletionDesc upgraded = metadata;
        upgraded.markerLabel = "Token Upgrade Label";
        upgraded.token = GpuHazardOwner_MakeToken(31u, 0u, 17u, CommandQueue::Graphics);
        {
            const auto secondGpuTaskAdmission = graph.importExternalCompletion(upgraded);
            EXPECT_TRUE(secondGpuTaskAdmission.has_value());
            if(secondGpuTaskAdmission.has_value())
                EXPECT_EQ(secondGpuTaskAdmission.value(), id);
        }
        u64 upgradedRevision = 0u;
        {
            const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
            upgradedRevision = view.declarationRevision();
            EXPECT_NE(upgradedRevision, metadataRevision);
            EXPECT_EQ(view.externalCompletionAt(id.index).markerLabel, metadata.markerLabel);
            const Optional<QueueSubmissionToken> token = ExternalCompletionTokenValue(view, id);
            ASSERT_TRUE(token.has_value());
            EXPECT_EQ(token.value().value, upgraded.token.value);
        }
        {
            const auto thirdGpuTaskAdmission = graph.importExternalCompletion(metadata);
            EXPECT_TRUE(thirdGpuTaskAdmission.has_value());
            if(thirdGpuTaskAdmission.has_value())
                EXPECT_EQ(thirdGpuTaskAdmission.value(), id);
        }
        {
            const auto fourthGpuTaskAdmission = graph.importExternalCompletion(upgraded);
            EXPECT_TRUE(fourthGpuTaskAdmission.has_value());
            if(fourthGpuTaskAdmission.has_value())
                EXPECT_EQ(fourthGpuTaskAdmission.value(), id);
        }
        GpuExternalCompletionDesc conflict = upgraded;
        ++conflict.token.value;
        EXPECT_FALSE(graph.importExternalCompletion(conflict).has_value());

        GpuExternalCompletionDesc differentGeneration = upgraded;
        differentGeneration.identity = s_GpuCaseImportScalingDifferentGenerationCompletion;
        ++differentGeneration.token.deviceGeneration;
        EXPECT_FALSE(graph.importExternalCompletion(differentGeneration).has_value());
        {
            const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
            EXPECT_EQ(view.declarationRevision(), upgradedRevision);
            EXPECT_EQ(view.externalCompletionCount(), prefixCount + 1u);
            const Optional<QueueSubmissionToken> token = ExternalCompletionTokenValue(view, id);
            ASSERT_TRUE(token.has_value());
            EXPECT_EQ(token.value().value, upgraded.token.value);
        }

        graph.reset();
        ++upgraded.token.deviceGeneration;
        const auto reboundResult = graph.importExternalCompletion(upgraded);
        ASSERT_TRUE(reboundResult.has_value());
        const GpuExternalCompletionId rebound = reboundResult.value();
        ASSERT_TRUE(rebound.valid());
        EXPECT_EQ(rebound.index, 0u);
        EXPECT_NE(rebound.generation, id.generation);
        const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
        EXPECT_FALSE(view.validExternalCompletion(id));
        const Optional<QueueSubmissionToken> reboundTok = ExternalCompletionTokenValue(view, rebound);
        ASSERT_TRUE(reboundTok.has_value());
        EXPECT_EQ(reboundTok.value().value, upgraded.token.value);
        EXPECT_EQ(reboundTok.value().deviceGeneration, upgraded.token.deviceGeneration);
        EXPECT_TRUE(view.validForDeviceGeneration(upgraded.token.deviceGeneration));
        EXPECT_FALSE(view.validForDeviceGeneration(cast<u16>(upgraded.token.deviceGeneration - 1u)));
    }
}

Expected<GpuTaskId> GpuHazardOwner_AddFirstUse(
    mut GpuTaskGraph graph,
    in GpuGraphResourceId resource,
    in Name identity,
    in AStringView label,
    in GpuTaskCommandRequirements commands
){
    Array<GpuTaskResourceUse, 1> uses = Array<GpuTaskResourceUse, 1>();
    uses[0u].resource = resource;
    uses[0u].requiredState = ResourceStates::CopyDest;
    uses[0u].access = GpuTaskResourceAccess::Write;
    GpuTaskDesc desc = GpuTaskDesc();
    desc.setIdentity(identity);
    desc.setMarkerLabel(label);
    desc.setResourceUses(uses);
    return graph.addTask(desc, commands);
}

Expected<GpuGraphResourceId> GpuHazardOwner_AddOwnerBuffer(
    mut GpuTaskGraph graph,
    in Name identity,
    in AStringView label,
    in GpuPhysicalQueueId owner,
    in ResourceQueueSharingMask queueSharing
){
    GpuGraphResourceDesc desc = GpuGraphResourceDesc();
    desc.setIdentity(identity);
    desc.setMarkerLabel(label);
    desc.setType(GpuGraphResourceType::Buffer);
    desc.setInitialState(ResourceStates::Common);
    desc.setInitialOwnerQueue(owner);
    desc.setQueueSharing(queueSharing);
    return graph.importResource(desc);
}

void VerifyGpuHazardOwner_ValidatesInitialExclusiveOwnerBeforeFirstUse(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = MakeTopology(queues);
    const GpuTaskCommandRequirements graphicsCommands = GraphicsCommands();
    const GpuTaskCommandRequirements computeCommands = ComputeCommands();

    {
        TestArena testArena = TestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        const auto resourceResult = GpuHazardOwner_AddOwnerBuffer(graph, s_GpuCaseTaskGraphInitialOwnerGraphics, "Initial Owner Graphics", queues[0u].id, ResourceQueueSharing::Exclusive);
        ASSERT_TRUE(resourceResult.has_value());
        const GpuGraphResourceId resource = resourceResult.value();
        ASSERT_TRUE(resource.valid());
        const auto taskResult = GpuHazardOwner_AddFirstUse(graph, resource, s_GpuCaseTaskGraphInitialOwnerGraphicsUse, "Initial Owner Graphics Use", graphicsCommands);
        ASSERT_TRUE(taskResult.has_value());
        const GpuTaskId task = taskResult.value();
        ASSERT_TRUE(task.valid());

        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
        GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
        ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);
        const Optional<GpuCompiledTask> compiledTask = TaskPlan(compiledPlan.findTask(task));
        ASSERT_TRUE(compiledTask.has_value());
        EXPECT_EQ(compiledTask.value().queue, queues[0u].id);
    }

    {
        TestArena testArena = TestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        const auto resourceResult = GpuHazardOwner_AddOwnerBuffer(graph, s_GpuCaseTaskGraphInitialOwnerCrossQueue, "Initial Owner Cross Queue", queues[0u].id, ResourceQueueSharing::Exclusive);
        ASSERT_TRUE(resourceResult.has_value());
        const GpuGraphResourceId resource = resourceResult.value();
        ASSERT_TRUE(resource.valid());
        const auto gpuTaskAdmission = GpuHazardOwner_AddFirstUse(graph, resource, s_GpuCaseTaskGraphInitialOwnerComputeUse, "Initial Owner Compute Use", computeCommands);
        ASSERT_TRUE(gpuTaskAdmission.has_value());
        ASSERT_TRUE(gpuTaskAdmission.value().valid());

        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
        GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
        EXPECT_FALSE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);
        EXPECT_FALSE(compiledPlan.valid());
    }

    {
        TestArena testArena = TestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        const auto resourceResult = GpuHazardOwner_AddOwnerBuffer(
            graph,
            s_GpuInitialOwnerStale,
            "Initial Owner Stale",
            GpuHazardOwner_MakeQueueId(queues[0u].id.index, cast<u16>(queues[0u].id.deviceGeneration + 1u)),
            ResourceQueueSharing::Exclusive
        );
        ASSERT_TRUE(resourceResult.has_value());
        const GpuGraphResourceId resource = resourceResult.value();
        ASSERT_TRUE(resource.valid());
        const auto secondGpuTaskAdmission = GpuHazardOwner_AddFirstUse(graph, resource, s_GpuCaseTaskGraphInitialOwnerStaleUse, "Initial Owner Stale Use", graphicsCommands);
        ASSERT_TRUE(secondGpuTaskAdmission.has_value());
        ASSERT_TRUE(secondGpuTaskAdmission.value().valid());

        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
        GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
        EXPECT_FALSE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);
        EXPECT_FALSE(compiledPlan.valid());
    }

    {
        TestArena testArena = TestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        const auto resourceResult = GpuHazardOwner_AddOwnerBuffer(
            graph,
            s_GpuCaseTaskGraphInitialOwnerConcurrent,
            "Initial Owner Concurrent",
            queues[0u].id,
            ResourceQueueSharing::GraphicsAndAsyncCompute
        );
        ASSERT_TRUE(resourceResult.has_value());
        const GpuGraphResourceId resource = resourceResult.value();
        ASSERT_TRUE(resource.valid());
        const auto thirdGpuTaskAdmission = GpuHazardOwner_AddFirstUse(graph, resource, s_GpuCaseTaskGraphInitialOwnerConcurrentUse, "Initial Owner Concurrent Use", graphicsCommands);
        ASSERT_TRUE(thirdGpuTaskAdmission.has_value());
        ASSERT_TRUE(thirdGpuTaskAdmission.value().valid());

        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
        GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
        EXPECT_FALSE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);
        EXPECT_FALSE(compiledPlan.valid());
    }
}

void VerifyGpuHazardOwner_RejectsInvalidSingleSourceInitialOwnerHandoffsForBufferAndAccelStruct(){
    const GpuPhysicalQueueInfo sourceQueue = GraphicsQueue();
    const GpuPhysicalQueueInfo destinationQueue = DedicatedComputeQueue();
    Vector<GpuTaskInitialOwnerCase> resourceCases = Vector<GpuTaskInitialOwnerCase>();
    resourceCases.push_back(GpuTaskInitialOwnerCase(GpuGraphResourceType::Buffer, ResourceStates::ShaderResource, s_GpuCaseTaskGraphInvalidInitialOwnerBuffer, "Invalid Initial Owner Buffer"));
    resourceCases.push_back(GpuTaskInitialOwnerCase(GpuGraphResourceType::AccelStruct, ResourceStates::AccelStructRead, s_GpuCaseTaskGraphInvalidInitialOwnerAccelStruct, "Invalid Initial Owner Accel Struct"));

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuExternalCompletionDesc compDesc = GpuExternalCompletionDesc();
    compDesc.setIdentity(s_GpuCaseTaskGraphInvalidTypedInitialOwnerCompletion);
    compDesc.setMarkerLabel("Invalid Typed Initial Owner Completion");
    const auto completionResult = graph.importExternalCompletion(compDesc);
    ASSERT_TRUE(completionResult.has_value());
    const GpuExternalCompletionId completion = completionResult.value();
    ASSERT_TRUE(completion.valid());

    const QueueSubmissionToken minimumCompletionToken = GpuHazardOwner_MakeToken(7u, sourceQueue.id.index, sourceQueue.id.deviceGeneration, CommandQueue::Graphics);
    CommandListResourceStateHandoff stateSource = CommandListResourceStateHandoff(testArena.arena);
    ASSERT_FALSE(stateSource.valid());

    for(in GpuTaskInitialOwnerCase resourceCase : resourceCases){
        Array<GpuGraphInitialOwnerHandoffSourceDesc, 1> sources = Array<GpuGraphInitialOwnerHandoffSourceDesc, 1>();
        sources[0u] = MakeHandoffSourceWithState(
            GpuTaskResourceRange(),
            sourceQueue.id,
            destinationQueue.id,
            completion,
            minimumCompletionToken,
            stateSource
        );
        GpuGraphResourceDesc resDesc = GpuGraphResourceDesc();
        resDesc.setIdentity(resourceCase.identity);
        resDesc.setMarkerLabel(resourceCase.markerLabel);
        resDesc.setType(resourceCase.resourceType);
        resDesc.setInitialState(resourceCase.initialState);
        resDesc.setInitialOwnerHandoffSources(sources);
        EXPECT_FALSE(graph.importResource(resDesc).has_value());
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        EXPECT_EQ(declarations.resourceCount(), 0u);
    }
}

void VerifyGpuHazardOwner_RejectsMultiSourceInitialOwnerCompletionAcrossQueues(){
    const GpuPhysicalQueueInfo graphicsQueue = GraphicsQueue();
    const GpuPhysicalQueueInfo computeQueue = DedicatedComputeQueue();
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuExternalCompletionDesc compDesc = GpuExternalCompletionDesc();
    compDesc.setIdentity(s_GpuCaseTaskGraphMultiOwnerSharedCompletion);
    compDesc.setMarkerLabel("Multi Owner Shared Completion");
    const auto sharedCompletionResult = graph.importExternalCompletion(compDesc);
    ASSERT_TRUE(sharedCompletionResult.has_value());
    const GpuExternalCompletionId sharedCompletion = sharedCompletionResult.value();
    ASSERT_TRUE(sharedCompletion.valid());

    CommandListResourceStateHandoff graphicsState = CommandListResourceStateHandoff(testArena.arena);
    CommandListResourceStateHandoff computeState = CommandListResourceStateHandoff(testArena.arena);
    GpuTaskResourceRange firstRange = GpuTaskResourceRange();
    firstRange.textureSubresources = TextureSubresourceSet(0u, 1u, 0u, 1u);
    GpuTaskResourceRange secondRange = GpuTaskResourceRange();
    secondRange.textureSubresources = TextureSubresourceSet(1u, 1u, 0u, 1u);
    Array<GpuGraphInitialOwnerHandoffSourceDesc, 2> sources = Array<GpuGraphInitialOwnerHandoffSourceDesc, 2>();
    sources[0u] = MakeHandoffSourceWithState(
        firstRange,
        graphicsQueue.id,
        graphicsQueue.id,
        sharedCompletion,
        GpuHazardOwner_MakeToken(7u, graphicsQueue.id.index, graphicsQueue.id.deviceGeneration, CommandQueue::Graphics),
        graphicsState
    );
    sources[1u] = MakeHandoffSourceWithState(
        secondRange,
        computeQueue.id,
        graphicsQueue.id,
        sharedCompletion,
        GpuHazardOwner_MakeToken(11u, computeQueue.id.index, computeQueue.id.deviceGeneration, CommandQueue::Compute),
        computeState
    );
    GpuGraphResourceDesc multiOwnerDesc = GpuGraphResourceDesc();
    multiOwnerDesc.setIdentity(s_GpuCaseTaskGraphMultiOwnerSharedCompletionTexture);
    multiOwnerDesc.setMarkerLabel("Multi Owner Shared Completion Texture");
    multiOwnerDesc.setType(GpuGraphResourceType::Texture);
    multiOwnerDesc.setInitialState(ResourceStates::ShaderResource);
    multiOwnerDesc.setInitialOwnerHandoffSources(sources);
    EXPECT_FALSE(graph.importResource(multiOwnerDesc).has_value());

    GpuGraphResourceDesc concurrentRelDesc = GpuGraphResourceDesc();
    concurrentRelDesc.setIdentity(s_GpuCaseTaskGraphConcurrentExternalReleaseTexture);
    concurrentRelDesc.setMarkerLabel("Concurrent External Release Texture");
    concurrentRelDesc.setType(GpuGraphResourceType::Texture);
    concurrentRelDesc.setInitialState(ResourceStates::ShaderResource);
    concurrentRelDesc.setExternalFinalState(ResourceStates::ShaderResource);
    concurrentRelDesc.setExternalFinalReleaseDestinationQueue(graphicsQueue.id);
    concurrentRelDesc.setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute);
    EXPECT_FALSE(graph.importResource(concurrentRelDesc).has_value());
}

