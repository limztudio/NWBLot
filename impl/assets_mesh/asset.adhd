////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/global.adhd>
#include <impl/assets_mesh/payload_validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena, asset("mesh")]
class Mesh{
    private Vector<f32x3u> m_positionStream;
    private Vector<f16x4u> m_normalStream;
    private Vector<f16x4u> m_tangentStream;
    private Vector<f32x2u> m_uv0Stream;
    private Vector<f16x4u> m_colorStream;
    private Vector<MeshletDesc> m_meshlets;
    private Vector<MeshletBounds> m_meshletBounds;
    private Vector<u8> m_meshletPositionRefDeltas;
    private Vector<u8> m_meshletAttributeRefDeltas;
    private Vector<MeshletLocalVertexRef> m_meshletLocalVertexRefs;
    private Vector<u8> m_meshletPrimitiveIndices;
    private Vector<u32> m_solidTriangleWords;

    private b8 hasIncompleteGeometryPayload()const{
        return HasIncompleteMeshGeometryPayload(
            this.m_positionStream,
            this.m_normalStream,
            this.m_tangentStream,
            this.m_uv0Stream,
            this.m_colorStream,
            this.m_meshlets,
            this.m_meshletBounds,
            this.m_meshletPositionRefDeltas,
            this.m_meshletAttributeRefDeltas,
            this.m_meshletLocalVertexRefs,
            this.m_meshletPrimitiveIndices,
            this.m_solidTriangleWords
        );
    }

    public b8 loadBinary(in Span<u8> binary);
    public b8 validatePayload()const;
    public b8 validatePayload(mut ScratchArena scratchArena)const;

    public void setPayload(
        in Vector<f32x3u> positions,
        in Vector<f16x4u> normals,
        in Vector<f16x4u> tangents,
        in Vector<f32x2u> uv0,
        in Vector<f16x4u> colors,
        in Vector<MeshletDesc> meshlets,
        in Vector<MeshletBounds> meshletBounds,
        in Vector<u8> meshletPositionRefDeltas,
        in Vector<u8> meshletAttributeRefDeltas,
        in Vector<MeshletLocalVertexRef> meshletLocalVertexRefs,
        in Vector<u8> meshletPrimitiveIndices,
        in Vector<u32> solidTriangleWords
    ){
        this.m_positionStream = positions;
        this.m_normalStream = normals;
        this.m_tangentStream = tangents;
        this.m_uv0Stream = uv0;
        this.m_colorStream = colors;
        this.m_meshlets = meshlets;
        this.m_meshletBounds = meshletBounds;
        this.m_meshletPositionRefDeltas = meshletPositionRefDeltas;
        this.m_meshletAttributeRefDeltas = meshletAttributeRefDeltas;
        this.m_meshletLocalVertexRefs = meshletLocalVertexRefs;
        this.m_meshletPrimitiveIndices = meshletPrimitiveIndices;
        this.m_solidTriangleWords = solidTriangleWords;
    }

    public in Vector<f32x3u> positionStream()const{ return this.m_positionStream; }
    public in Vector<f16x4u> normalStream()const{ return this.m_normalStream; }
    public in Vector<f16x4u> tangentStream()const{ return this.m_tangentStream; }
    public in Vector<f32x2u> uv0Stream()const{ return this.m_uv0Stream; }
    public in Vector<f16x4u> colorStream()const{ return this.m_colorStream; }
    public in Vector<MeshletDesc> meshlets()const{ return this.m_meshlets; }
    public in Vector<MeshletBounds> meshletBounds()const{ return this.m_meshletBounds; }
    public in Vector<u8> meshletPositionRefDeltas()const{ return this.m_meshletPositionRefDeltas; }
    public in Vector<u8> meshletAttributeRefDeltas()const{ return this.m_meshletAttributeRefDeltas; }
    public in Vector<MeshletLocalVertexRef> meshletLocalVertexRefs()const{ return this.m_meshletLocalVertexRefs; }
    public in Vector<u8> meshletPrimitiveIndices()const{ return this.m_meshletPrimitiveIndices; }
    public in Vector<u32> solidTriangleWords()const{ return this.m_solidTriangleWords; }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
