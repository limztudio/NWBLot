#include "context_staging.adhd"
#include "router_commands.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 LessTargetLookup(in TargetLookup lhs, in TargetLookup rhs){
    return lhs.value < rhs.value;
}

void SortTargetLookupVector(mut Vector<TargetLookup> inOutLookup){
    b8 sorted = true;
    for(usize index = 1u; index < inOutLookup.size(); ++index){
        if(LessTargetLookup(inOutLookup[index], inOutLookup[index - 1u])){
            sorted = false;
            break;
        }
    }
    if(sorted)
        return;
    SortSequence<TargetLookup>(inOutLookup, LessTargetLookup);
}

void RebuildRouterTargetLookup(in Span<HitTarget> targets, mut Vector<TargetLookup> outLookup){
    outLookup.clear();
    b8 needsSort = false;
    u64 previousIdValue = 0u;
    for(usize index = 0u; index < targets.size(); ++index){
        TargetLookup entry;
        entry.value = targets[index].id.value;
        entry.index = cast<u32>(index);
        if(index > 0u && entry.value < previousIdValue)
            needsSort = true;
        previousIdValue = entry.value;
        outLookup.push_back(entry);
    }
    if(needsSort)
        SortTargetLookupVector(outLookup);
}

b8 StageRouterHitTargets(
    in Span<HitTarget> targets,
    in Span<PopupRecord> stagedPopups,
    mut Vector<HitTarget> stagedTargets,
    mut Vector<TargetLookup> stagedLookup,
    mut b8 outHasOwners,
    mut b8 outHasCommandOwners,
    mut b8 outHasScrollOwners,
    mut b8 outNeedsSort,
    mut b8 outHasFocusOnCommit
){
    stagedTargets.clear();
    stagedLookup.clear();
    stagedLookup.reserve(targets.size());
    outHasOwners = false;
    outHasCommandOwners = false;
    outHasScrollOwners = false;
    outNeedsSort = false;
    outHasFocusOnCommit = false;
    b8 needsSort = false;
    u64 previousIdValue = 0u;
    for(usize index = 0u; index < targets.size(); ++index){
        in HitTarget target = targets[index];
        const b8 validRect = target.rectangle.width >= 0.0f
            && target.rectangle.height >= 0.0f
            && IsFinite(VectorSingle(target.rectangle.x, target.rectangle.y, 0.0f, 0.0f) + VectorSingle(target.rectangle.width, target.rectangle.height, 0.0f, 0.0f));
        const b8 validClip = target.clip.width >= 0.0f
            && target.clip.height >= 0.0f
            && IsFinite(VectorSingle(target.clip.x, target.clip.y, 0.0f, 0.0f) + VectorSingle(target.clip.width, target.clip.height, 0.0f, 0.0f));
        const b8 gestureZero = target.gestureReference.x == 0.0f && target.gestureReference.y == 0.0f && target.gestureReference.width == 0.0f && target.gestureReference.height == 0.0f;
        const b8 validGestureRef = gestureZero || (
            target.gestureReference.width >= 0.0f
            && target.gestureReference.height >= 0.0f
            && (target.gestureReference.width == 0.0f) == (target.gestureReference.height == 0.0f)
            && IsFinite(VectorSingle(target.gestureReference.x, target.gestureReference.y, 0.0f, 0.0f) + VectorSingle(target.gestureReference.width, target.gestureReference.height, 0.0f, 0.0f))
        );
        const b8 validPopup = ValidStagedPopupTarget(target, stagedPopups);
        b8 validControlProps = false;
        if(!target.owner.valid() && !target.commandOwner.valid()){
            validControlProps =
                (target.control.empty() || target.control.valid())
                && target.ownerDeclarationGeneration == 0u
                && target.commandOwnerDeclarationGeneration == 0u
                && target.commandControl.empty()
                && IsFinite(VectorDouble(target.scrollStep, target.scrollStepX, target.gestureMaximum, target.gestureMaximumX))
                && target.scrollStep >= 0.0
                && target.scrollStepX >= 0.0
                && target.gestureMaximum >= 0.0 && target.pageRows != 0u
                && target.gestureMaximumX >= 0.0
                && ((!target.navigable && !target.scrollable) || (target.control.valid() && target.focusable))
                && (!target.horizontalNavigation || target.navigable)
                && (!target.focusOnCommit || target.focusable);
        }
        else
            validControlProps = HasValidHitTargetControlProperties(target) && HasValidHitTargetCommandOwnerProperties(target);
        if(
            !target.id.valid() || target.declarationGeneration == 0u
            || !validRect || !validClip || !validGestureRef
            || !validPopup
            || !validControlProps
            || !HasValidHitTargetScrollOwnerProperties(target)
        )
            return false;
        if(target.owner.valid())
            outHasOwners = true;
        if(target.commandOwner.valid())
            outHasCommandOwners = true;
        if(target.scrollOwner.valid())
            outHasScrollOwners = true;
        if(target.focusOnCommit && target.focusable)
            outHasFocusOnCommit = true;
        TargetLookup entry;
        entry.value = target.id.value;
        entry.index = cast<u32>(index);
        if(index > 0u){
            if(entry.value < previousIdValue)
                needsSort = true;
            else if(entry.value == previousIdValue)
                return false;
        }
        previousIdValue = entry.value;
        stagedLookup.push_back(entry);
    }
    AssignTriviallyCopyableVector(stagedTargets, targets);
    if(needsSort)
        SortSequence<TargetLookup>(stagedLookup, LessTargetLookup);
    outNeedsSort = needsSort;
    return true;
}

b8 ValidateSortedStagedRouterTargetsAndPopups(
    in Span<HitTarget> stagedTargets,
    in Span<TargetLookup> stagedLookup,
    in Span<PopupRecord> stagedPopups,
    in b8 hasOwners,
    in b8 hasCommandOwners,
    in b8 hasScrollOwners,
    in b8 checkDuplicates
){
    if(checkDuplicates){
        for(usize index = 1u; index < stagedLookup.size(); ++index){
            if(stagedLookup[index - 1u].value == stagedLookup[index].value)
                return false;
        }
    }
    if(hasOwners || hasCommandOwners || hasScrollOwners){
        for(in HitTarget target : stagedTargets){
            if(target.owner.valid()){
                const Expected<usize> hostIndex = FindTargetIndexInTable(stagedTargets, stagedLookup, target.owner, target.ownerDeclarationGeneration);
                if(!hostIndex.has_value())
                    return false;
                in HitTarget host = stagedTargets[hostIndex.value()];
                if(!host.enabled || !host.focusable || host.owner.valid() || host.control != target.control || host.popup != target.popup || host.layer != target.layer || host.zOrder != target.zOrder || host.windowId != target.windowId || host.windowDeclarationGeneration != target.windowDeclarationGeneration)
                    return false;
            }
            if(target.commandOwner.valid()){
                const Expected<usize> hostIndex = FindTargetIndexInTable(stagedTargets, stagedLookup, target.commandOwner, target.commandOwnerDeclarationGeneration);
                if(!hostIndex.has_value())
                    return false;
                in HitTarget host = stagedTargets[hostIndex.value()];
                if(!host.enabled || !host.focusable || !host.navigable || host.owner.valid() || host.control != target.commandControl || host.popup != target.popup || host.layer != target.layer || host.zOrder != target.zOrder || host.windowId != target.windowId || host.windowDeclarationGeneration != target.windowDeclarationGeneration)
                    return false;
            }
            if(target.scrollOwner.valid()){
                const Expected<usize> scrollHostIndex = FindTargetIndexInTable(stagedTargets, stagedLookup, target.scrollOwner, target.scrollOwnerDeclarationGeneration);
                if(!scrollHostIndex.has_value())
                    return false;
                in HitTarget scrollHost = stagedTargets[scrollHostIndex.value()];
                if(scrollHost.owner.valid() || scrollHost.popup != target.popup || scrollHost.layer != target.layer || scrollHost.zOrder != target.zOrder || scrollHost.windowId != target.windowId || scrollHost.windowDeclarationGeneration != target.windowDeclarationGeneration)
                    return false;
            }
        }
    }
    for(in PopupRecord popup : stagedPopups){
        const Expected<usize> ownerIndex = FindTargetIndexInTable(stagedTargets, stagedLookup, popup.scope.token.widget, popup.scope.token.declarationGeneration);
        if(!ownerIndex.has_value())
            return false;
        in HitTarget ownerTarget = stagedTargets[ownerIndex.value()];
        if(ownerTarget.popup != popup.scope.token || !ownerTarget.enabled)
            return false;
        if(popup.scope.dismissFocusTraversal){
            const Expected<usize> anchorIndex = FindTargetIndexInTable(stagedTargets, stagedLookup, popup.scope.focusAnchor, popup.scope.focusAnchorDeclarationGeneration);
            if(!anchorIndex.has_value())
                return false;
            in HitTarget anchorTarget = stagedTargets[anchorIndex.value()];
            if(anchorTarget.popup != popup.scope.parent || !anchorTarget.focusable || !anchorTarget.enabled || anchorTarget.owner.valid())
                return false;
        }
    }
    return true;
}

void ApplyRouterFocusOnCommit(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in b8 windowFocused,
    in u64 focusLossGeneration,
    in u64 expectedFocusLossGeneration,
    in b8 hasFocusOnCommit,
    mut WidgetId inOutFocus,
    mut u64 inOutFocusDeclaration,
    mut ControlToken inOutFocusControl
){
    if(!hasFocusOnCommit || inOutFocus.valid() || !windowFocused || (expectedFocusLossGeneration != u64.max && expectedFocusLossGeneration != focusLossGeneration))
        return;
    for(in HitTarget target : targets){
        if(target.focusOnCommit && target.focusable && IsRouterTargetInteractive(targets, lookup, popups, target)){
            inOutFocus = target.id;
            inOutFocusDeclaration = target.declarationGeneration;
            inOutFocusControl = target.control;
            break;
        }
    }
}

b8 EraseInvalidatedRouterTargets(in WidgetId id, in Span<TargetLookup> lookup, mut Vector<HitTarget> targets){
    if(!FindTargetIndexInTable(targets, lookup, id, 0u).has_value())
        return false;
    usize keptTargets = 0u;
    for(usize index = 0u; index < targets.size(); ++index){
        if(targets[index].id != id && targets[index].owner != id){
            if(keptTargets != index)
                targets[keptTargets] = targets[index];
            ++keptTargets;
        }
    }
    targets.resize(keptTargets);
    return true;
}

b8 EraseInvalidatedRouterTargetsBatch(
    in Span<WidgetId> ids,
    in Span<TargetLookup> lookup,
    mut Vector<HitTarget> targets
){
    HashSet<u64> invalidatedIds;
    for(in WidgetId id : ids){
        if(FindTargetIndexInTable(targets, lookup, id, 0u).has_value())
            invalidatedIds.insert(id.value);
    }
    if(invalidatedIds.empty())
        return false;
    usize keptTargets = 0u;
    for(usize index = 0u; index < targets.size(); ++index){
        if(!invalidatedIds.contains(targets[index].id.value) && !invalidatedIds.contains(targets[index].owner.value)){
            if(keptTargets != index)
                targets[keptTargets] = targets[index];
            ++keptTargets;
        }
    }
    targets.resize(keptTargets);
    return true;
}


