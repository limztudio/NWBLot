Expected<PreparedShaderPlan> PrepareEvaluatorShaderPlan(mut TestArena testArena, mut GraphicsScratchArena scratch, in ResolvedCookPaths paths, in GraphicsTestPath bindRoot, in GraphicsTestPath csgRoot, in IncludeMetadataMap includeMetadata, in StringView authoredDefine, in u32 mode){
    Vector<MaterialBindEntry> binds;
    Vector<MaterialCookEntry> materials;
    Vector<ShaderCookEntry> entries;
    ShaderCookEntry entry;
    entry.name = "project/shaders/dependency_plan";
    entry.source = "shader.slang";
    entry.stage = s_ShaderStagePs;
    entry.archiveStage = s_ShaderStagePs;
    const Array<StringView, 1u> authored("authored");
    InsertEvaluatorDefine(entry.defineValues, authoredDefine, authored);
    if(mode == 1u){
        const Array<StringView, 1u> quoted("\"../common.slangi\"");
        InsertEvaluatorDefine(entry.defineValues, s_CsgProjectEvaluatorModuleDefineName, quoted);
    }
    else if(mode == 2u){
        const Array<StringView, 2u> quoted("\"first.slangi\"", "\"second.slangi\"");
        InsertEvaluatorDefine(entry.defineValues, s_CsgProjectEvaluatorModuleDefineName, quoted);
    }
    entries.push_back(entry);
    const Path empty = Path();
    return PrepareShaderEntriesForCook(paths, bindRoot, csgRoot, empty, empty, includeMetadata, binds, materials, entries);
}

