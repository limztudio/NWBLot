namespace NWB::Tests::Smoke{
using Core::GraphicsRuntime;
using Impl::PresentationSettings;

class ReflectionTimingRenderPass final : public Core::IRenderPass{
private:
    static constexpr u32 s_InFlightRanges = s_ReflectionTimingInFlightRanges;


public:
    explicit ReflectionTimingRenderPass(Core::GraphicsRuntime& graphics)noexcept
        : IRenderPass(graphics){}


public:
    [[nodiscard]] b8 prepareQueries(const u32 width, const u32 height){
        u32 mipCount = 0u;
        for(u32 extent = Max(width, height); extent > 0u; extent >>= 1u)
            ++mipCount;
        if(width == 0u || height == 0u || mipCount > NWB_REFLECTION_MAX_DEPTH_MIPS){
            NWB_LOGGER_ERROR(NWB_TEXT("ReflectionSmokeProjectImpl: invalid extent for depth timing capacity"));
            return false;
        }
        const Array<Name, 17> singleRangeScopes = {
            Impl::RendererGpuTimingScope::s_Frame.identity,
            Impl::RendererGpuTimingScope::s_OpaqueRegular.identity,
            Impl::RendererGpuTimingScope::s_ShadowVisibility.identity,
            Impl::RendererGpuTimingScope::s_DeferredLighting.identity,
            Impl::RendererGpuTimingScope::s_DeferredComposite.identity,
            Impl::RendererGpuTimingScope::s_DeferredPresent.identity,
            Impl::RendererGpuTimingScope::s_AvboitClear.identity,
            Impl::RendererGpuTimingScope::s_AvboitOccupancy.identity,
            Impl::RendererGpuTimingScope::s_AvboitDepthWarp.identity,
            Impl::RendererGpuTimingScope::s_AvboitExtinction.identity,
            Impl::RendererGpuTimingScope::s_AvboitIntegration.identity,
            Impl::RendererGpuTimingScope::s_AvboitAccumulate.identity,
            Impl::ReflectionGpuTimingScope::s_Classify.identity,
            Impl::ReflectionGpuTimingScope::s_BuildArgs.identity,
            Impl::ReflectionGpuTimingScope::s_Hardware.identity,
            Impl::ReflectionGpuTimingScope::s_Temporal.identity,
            Impl::ReflectionGpuTimingScope::s_Spatial.identity,
        };
        auto& graphics = getGraphics();
        auto& timing = graphics.gpuTiming();
        auto& device = graphics.getDevice();
        // Reserve enough timer queries to cover all in-flight passes and depth mips.
        for(const Name& scope : singleRangeScopes){
            if(!timing.prepareScopeQueries(scope, device, s_InFlightRanges)){
                NWB_LOGGER_ERROR(NWB_TEXT("ReflectionSmokeProjectImpl: failed to prepare timing scope '{}'"), ConvertString(scope.resolvedText()));
                return false;
            }
        }
        if(!timing.prepareScopeQueries(Impl::ReflectionGpuTimingScope::s_DepthPyramid.identity, device, s_InFlightRanges * mipCount)){
            NWB_LOGGER_ERROR(NWB_TEXT("ReflectionSmokeProjectImpl: failed to prepare depth timing capacity"));
            return false;
        }
        NWB_LOGGER_ESSENTIAL_INFO(NWB_TEXT("ReflectionSmokeProjectImpl: timing in-flight ranges {}"), s_InFlightRanges);
        NWB_LOGGER_ESSENTIAL_INFO(NWB_TEXT("ReflectionSmokeProjectImpl: timing depth mip count {}"), mipCount);
        return true;
    }

    virtual b8 shouldRenderUnfocused()noexcept override{ return true; }
};

[[nodiscard]] inline TStringView ReflectionSmokeProjectName()noexcept{
    return NWB_TEXT("ReflectionSmokeProjectImpl");
}

[[nodiscard]] inline TStringView ReflectionCpuTimingOwnerLabel()noexcept{
    return NWB_TEXT("reflection");
}

[[nodiscard]] inline Name ReflectionFrameGpuTimingScope()noexcept{
    return Impl::RendererGpuTimingScope::s_Frame.identity;
}

[[nodiscard]] inline Name ReflectionHardwareGpuTimingScope()noexcept{
    return Impl::ReflectionGpuTimingScope::s_Hardware.identity;
}

[[nodiscard]] inline Name ReflectionSpatialGpuTimingScope()noexcept{
    return Impl::ReflectionGpuTimingScope::s_Spatial.identity;
}

[[nodiscard]] inline NotNullUniquePtr<Core::ECS::World> CreateReflectionSmokeWorldOrDie(ProjectRuntimeContext& context){
    auto world = CreateSmokeWorldOrDie(ReflectionSmokeProjectName(), context);
    Core::Alloc::ScratchArena scratchArena(s_SmokeEnvironmentArena);
    const auto caseText = ReadSmokeEnvironmentText(scratchArena, "NWB_REFLECTION_SMOKE_CASE");
    const AStringView caseName = caseText ? AStringView(caseText->data(), caseText->size()) : AStringView{};
    if(caseName == "temporal_deform" || caseName == "rough_deform")
        AddSmokeSkinnedRenderSystems(*world, context);
    else
        SetupSmokeRenderSystems(*world, context);
    return world;
}
};
}


