    EXPECT_EQ(m_context.input().hitTest({ 215.0f, 175.0f }), candidate.child.id);
}

TEST_F(UiPopupContextTests, ScopeOmissionRetainsLiveAcceptedDeclarationsUntilCommitThenRestoresFocus){
