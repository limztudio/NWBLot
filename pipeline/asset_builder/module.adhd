#include <pipeline/command_line.adhd>
#include <pipeline/asset_builder/build.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
i32 RunPipelineOptions(mut PipelineOptions options){
    CpuTaskScheduler scheduler(QueryAssetBuilderWorkerCoreCount());
    AssetBuildOptions build(scheduler);
    build.outputDirectory = Path(StringView(options.outputPath));
    build.configuration = options.configuration;
    if(options.assetType.has_value())
        build.assetType = options.assetType.value();
    build.useExplicitInputs = true;
    const auto repo = ResolvePipelineRepoRoot(StringView(options.repoRoot), "AssetBuilder");
    if(!repo.has_value())
        return s_PipelineExitFailure;
    build.repoRoot = repo.value();
    const auto roots = ResolvePipelineAssetRoots(build.repoRoot, options.inputs, options.assetRoots, AssetRootDuplicatePolicy::ExactText, "AssetBuilder", "an empty input list requires --asset-root");
    if(!roots.has_value())
        return s_PipelineExitFailure;
    build.assetRoots = roots.value();
    build.inputs = options.inputs;
    const b8 built = BuildAssets(build);
    scheduler.wait();
    if(built)
        return s_PipelineExitSuccess;
    return s_PipelineExitFailure;
}

[cpp_unwind]
i32 Run(in ConsoleArguments args){
    PipelineOptions options;
    const auto status = ParsePipelineOptions(args, PipelineTool::AssetBuilder, options);
    if(status.has_value())
        return status.value();
    return RunPipelineOptions(options);
}


