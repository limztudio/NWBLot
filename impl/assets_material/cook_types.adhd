#include <impl/assets_material/bind_typed_layout.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_MaterialMetaDiagnosticPrefix = "Material meta";
const StringView s_MaterialMetaInterfaceField = "interface";
const StringView s_MaterialMetaSurfaceField = "surface";
const StringView s_MaterialMetaShadersField = "shaders";
const StringView s_MaterialMetaShaderVariantField = "shader_variant";
const StringView s_MaterialMetaParametersField = "parameters";
const StringView s_MaterialMetaTransparentField = "transparent";
const StringView s_MaterialMetaTwoSidedField = "two_sided";
const StringView s_MaterialMetaRefractiveField = "refractive";
const StringView s_MaterialMetaBxdfField = "bxdf";
const StringView s_MaterialBxdfExtension = ".bxdf";
const StringView s_MaterialSurfaceExtension = ".surface";
const u32 s_NoSurfaceDispatchId = 0xFFFFFFFFu;
const StringView s_DeferredBxdfFunctionMacro = "NWB_DEFERRED_BXDF_FUNCTION";
const StringView s_DeferredBxdfModelPrefix = "nwbDeferredBxdfModel";
const StringView s_DeferredBxdfIncludeSubDir = "deferred_modules";
const StringView s_DeferredBxdfModuleSubPath = "deferred/generated/bxdf_dispatch.slangi";
const StringView s_DeferredBxdfUnknownFallbackSource = "    default: return half3(1.0h, 0.0h, 1.0h); // no engine default BXDF: an unknown id shows magenta\n";
const StringView s_GeneratedUndefBlockEnd = "\n\n";
const StringView s_GeneratedSwitchCaseLabel = "    case ";
const StringView s_GeneratedSwitchCaseReturn = "u: return ";
const StringView s_GeneratedSwitchEnd = "    }\n";
const StringView s_GeneratedDispatchEnd = "}\n\n#endif\n";
const usize s_ShadowSurfaceBindLayoutAliasCount = 7u;
const usize s_ShadowSurfaceBindInstanceAliasReserveCount = 4u;
const StringView s_ShadowSurfaceFunctionMacro = "nwbMaterialSurface";
const StringView s_ShadowSurfaceModelPrefix = "nwbShadowSurfaceModel";
const StringView s_ShadowSurfaceBindNamespacePrefix = "nwbShadowBindModel";
const StringView s_ShadowSurfaceIncludeSubDir = "shadow_modules";
const StringView s_ShadowSurfaceModuleSubPath = "shadow/generated/surface_dispatch.slangi";
const StringView s_ShadowSurfaceUnknownFallbackSource = "    default: return nwbMakeMeshSurface(half3(0.5h, 0.5h, 0.5h), hit.worldNormal, half(0.0), half(0.0));\n";
const StringView s_AvboitAccumulatePixelShaderGeneratedPrefix = "generated/avboit_accumulate_ps/";
const StringView s_AvboitOccupancyPixelShaderGeneratedPrefix = "generated/avboit_occupancy_ps/";
const StringView s_AvboitExtinctionPixelShaderGeneratedPrefix = "generated/avboit_extinction_ps/";
const StringView s_GeneratedCacheDirectory = "generated";
const StringView s_GeneratedShaderSourceExtension = ".slang";
const StringView s_GeneratedPixelShaderBindHookLine = "// typed .bind + its surface hook. The material declares only its 'surface' fragment; the cook\n";
const StringView s_GeneratedPixelShaderCookCacheLine = "// assembles this here, in the cook cache. Do not edit -- regenerated every cook.\n";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsAllowedMaterialAssetField(in StringView fieldName){
    return fieldName == s_MaterialMetaInterfaceField
        || fieldName == s_MaterialMetaSurfaceField
        || fieldName == s_MaterialMetaShadersField
        || fieldName == s_MaterialMetaShaderVariantField
        || fieldName == s_MaterialMetaParametersField
        || fieldName == s_MaterialMetaTransparentField
        || fieldName == s_MaterialMetaTwoSidedField
        || fieldName == s_MaterialMetaRefractiveField
        || fieldName == s_MaterialMetaBxdfField;
}

MaterialTypedLayoutBlockBinary PackMaterialTypedLayoutBlockBinary(in MaterialTypedLayoutBlock block){
    MaterialTypedLayoutBlockBinary blockBinary;
    blockBinary.blockNameHash = block.blockName.hash();
    blockBinary.blockClass = cast<u32>(block.blockClass);
    blockBinary.fieldBegin = block.fieldBegin;
    blockBinary.fieldCount = block.fieldCount;
    blockBinary.byteSize = block.byteSize;
    return blockBinary;
}

MaterialTypedLayoutFieldBinary PackMaterialTypedLayoutFieldBinary(in MaterialTypedLayoutField field){
    MaterialTypedLayoutFieldBinary fieldBinary;
    fieldBinary.fieldNameHash = field.fieldName.hash();
    fieldBinary.fieldType = cast<u32>(field.fieldType);
    fieldBinary.offset = field.offset;
    fieldBinary.defaultValue = field.defaultValue;
    return fieldBinary;
}

MaterialResourceReferenceBinary PackMaterialResourceReferenceBinary(in MaterialResourceReference resourceReference){
    MaterialResourceReferenceBinary resourceReferenceBinary;
    resourceReferenceBinary.blockNameHash = resourceReference.blockName.hash();
    resourceReferenceBinary.fieldNameHash = resourceReference.fieldName.hash();
    if(resourceReference.resourceKind == MaterialResourceKind::SampledImage2D)
        resourceReferenceBinary.resourceNameHash = resourceReference.textureAsset.name().hash();
    else
        resourceReferenceBinary.resourceNameHash = resourceReference.samplerAsset.name().hash();
    resourceReferenceBinary.resourceKind = cast<u32>(resourceReference.resourceKind);
    resourceReferenceBinary.constantByteOffset = resourceReference.constantByteOffset;
    return resourceReferenceBinary;
}

u32 PackMaterialFlags(in b8 transparent, in b8 twoSided, in b8 refractive){
    u32 materialFlags = 0u;
    if(transparent)
        materialFlags |= cast<u32>(MaterialFlag::Transparent);
    if(twoSided)
        materialFlags |= cast<u32>(MaterialFlag::TwoSided);
    if(refractive)
        materialFlags |= cast<u32>(MaterialFlag::Refractive);
    return materialFlags;
}

b8 ValidateMaterialCookEntryRequiredFields(
    in StringView virtualPath,
    in StringView materialInterface,
    in u64 typedLayoutHash,
    in StringView shaderVariant
){
    if(materialInterface.empty()){
        error("Material cook: material '{}' is missing required material interface", virtualPath);
        return false;
    }
    if(typedLayoutHash == 0u){
        error("Material cook: interface material '{}' is missing typed layout data", virtualPath);
        return false;
    }
    if(shaderVariant.empty()){
        error("Material cook: material '{}' has empty shader variant", virtualPath);
        return false;
    }
    return true;
}

b8 ValidateMaterialGeneratedPixelShaderEntry(
    in StringView virtualPath,
    in b8 hasExplicitShaders,
    in b8 hasSurface,
    in StringView materialInterface
){
    if(hasExplicitShaders){
        if(hasSurface){
            error("Material cook: material '{}' declares both 'surface' and 'shaders'; declare exactly one", virtualPath);
            return false;
        }
        return true;
    }
    if(!hasSurface){
        error("Material cook: material '{}' declares neither 'surface' nor 'shaders'", virtualPath);
        return false;
    }
    if(materialInterface.empty()){
        error("Material cook: material '{}' needs an interface to generate its pixel shader", virtualPath);
        return false;
    }
    return true;
}

String BuildDeferredBxdfDispatchModuleSource(in Span<StringView> sourceById){
    String outSource = "";
    outSource.append("// Generated by the asset cook from material `bxdf` declarations. Do not edit.\n");
    outSource.append("#ifndef NWB_GRAPHICS_DEFERRED_GENERATED_BXDF_DISPATCH_SLANGI\n");
    outSource.append("#define NWB_GRAPHICS_DEFERRED_GENERATED_BXDF_DISPATCH_SLANGI\n\n");

    for(usize id = 0u; id < sourceById.size(); ++id){
        if(sourceById[id].empty())
            continue;
        outSource.append(s_GeneratedDefineDirective);
        outSource.append(s_DeferredBxdfFunctionMacro);
        outSource.push_back(' ');
        outSource.append(s_DeferredBxdfModelPrefix);
        AppendDecimalU32(cast<u32>(id), outSource);
        outSource.push_back('\n');
        outSource.append(s_GeneratedIncludeDirective);
        outSource.append(sourceById[id]);
        outSource.append(s_GeneratedIncludeDirectiveEnd);
        outSource.append(s_GeneratedUndefDirective);
        outSource.append(s_DeferredBxdfFunctionMacro);
        outSource.append(s_GeneratedUndefBlockEnd);
    }

    outSource.append("half3 nwbDeferredDispatchBxdf(uint shadingModel, NwbBxdfSurface surface, int2 pixel){\n");
    outSource.append("    switch(shadingModel){\n");
    for(usize id = 0u; id < sourceById.size(); ++id){
        if(sourceById[id].empty())
            continue;
        outSource.append(s_GeneratedSwitchCaseLabel);
        AppendDecimalU32(cast<u32>(id), outSource);
        outSource.append(s_GeneratedSwitchCaseReturn);
        outSource.append(s_DeferredBxdfModelPrefix);
        AppendDecimalU32(cast<u32>(id), outSource);
        outSource.append("(surface, pixel);\n");
    }
    outSource.append(s_DeferredBxdfUnknownFallbackSource);
    outSource.append(s_GeneratedSwitchEnd);
    outSource.append(s_GeneratedDispatchEnd);
    return outSource;
}

String BuildShadowSurfaceDispatchHeader(){
    String outSource = "";
    outSource.append("// Generated by the asset cook from material `surface` declarations. Do not edit.\n");
    outSource.append("#ifndef NWB_GRAPHICS_SHADOW_GENERATED_SURFACE_DISPATCH_SLANGI\n");
    outSource.append("#define NWB_GRAPHICS_SHADOW_GENERATED_SURFACE_DISPATCH_SLANGI\n\n");
    return outSource;
}

void AppendShadowSurfaceBindAliasDefinition(in StringView symbol, in StringView bindNamespace, mut String inOutSource){
    inOutSource.append(s_GeneratedDefineDirective);
    inOutSource.append(symbol);
    inOutSource.push_back(' ');
    inOutSource.append(bindNamespace);
    inOutSource.append("::");
    inOutSource.append(symbol);
    inOutSource.push_back('\n');
}

void AppendShadowSurfaceInputDefines(mut String inOutSource){
    inOutSource.append("#define inColor (nwbShadowSurfaceInputs.color)\n");
    inOutSource.append("#define inNormal (nwbShadowSurfaceInputs.normal)\n");
    inOutSource.append("#define inTangent (nwbShadowSurfaceInputs.tangent)\n");
    inOutSource.append("#define inUv0 (nwbShadowSurfaceInputs.uv0)\n");
    inOutSource.append("#define inWorldPosition (nwbShadowSurfaceInputs.worldPosition)\n");
    inOutSource.append("#define inIncidentDirection (nwbShadowSurfaceInputs.incidentDirection)\n");
}

void AppendShadowSurfaceInputUndefines(mut String inOutSource){
    inOutSource.append("#undef inIncidentDirection\n");
    inOutSource.append("#undef inWorldPosition\n");
    inOutSource.append("#undef inUv0\n");
    inOutSource.append("#undef inTangent\n");
    inOutSource.append("#undef inNormal\n");
    inOutSource.append("#undef inColor\n");
}

void AppendShadowSurfaceNamespaceInclude(in StringView bindNamespace, in StringView interfaceName, mut String inOutSource){
    inOutSource.append("namespace ");
    inOutSource.append(bindNamespace);
    inOutSource.append("{\n#include \"");
    inOutSource.append(interfaceName);
    inOutSource.append(".bind\"\n}\n");
}

void AppendShadowSurfaceHookInclude(in u32 id, in StringView surfaceSource, mut String inOutSource){
    inOutSource.append(s_GeneratedDefineDirective);
    inOutSource.append(s_ShadowSurfaceFunctionMacro);
    inOutSource.append("() ");
    inOutSource.append(s_ShadowSurfaceModelPrefix);
    AppendDecimalU32(id, inOutSource);
    inOutSource.append("(const NwbMeshSurfaceInputs nwbShadowSurfaceInputs)\n");
    inOutSource.append(s_GeneratedIncludeDirective);
    inOutSource.append(surfaceSource);
    inOutSource.append(s_GeneratedIncludeDirectiveEnd);
    inOutSource.append(s_GeneratedUndefDirective);
    inOutSource.append(s_ShadowSurfaceFunctionMacro);
    inOutSource.push_back('\n');
}

void AppendShadowSurfaceDispatchFunction(in Span<StringView> surfaceById, mut String inOutSource){
    inOutSource.append("NwbMeshSurface nwbShadowDispatchSurface(uint surfaceDispatchId, NwbShadowHit hit){\n");
    inOutSource.append("    nwbShadowSetMaterialContext(hit);\n");
    inOutSource.append("    const NwbMeshSurfaceInputs in = nwbShadowBuildSurfaceInputs(hit);\n");
    inOutSource.append("    switch(surfaceDispatchId){\n");
    for(usize id = 0u; id < surfaceById.size(); ++id){
        if(surfaceById[id].empty())
            continue;
        inOutSource.append(s_GeneratedSwitchCaseLabel);
        AppendDecimalU32(cast<u32>(id), inOutSource);
        inOutSource.append(s_GeneratedSwitchCaseReturn);
        inOutSource.append(s_ShadowSurfaceModelPrefix);
        AppendDecimalU32(cast<u32>(id), inOutSource);
        inOutSource.append("(in);\n");
    }
    inOutSource.append(s_ShadowSurfaceUnknownFallbackSource);
    inOutSource.append(s_GeneratedSwitchEnd);
    inOutSource.append(s_GeneratedDispatchEnd);
}

void BuildGeneratedMaterialPixelShaderSource(
    in StringView headerCommentLine,
    in StringView authoringHeaderInclude,
    in StringView materialInterface,
    in StringView surfaceSource,
    mut String outSource
){
    outSource.clear();
    outSource.append(headerCommentLine);
    outSource.append(s_GeneratedPixelShaderBindHookLine);
    outSource.append(s_GeneratedPixelShaderCookCacheLine);
    outSource.append(s_GeneratedIncludeDirective);
    outSource.append(authoringHeaderInclude);
    outSource.append(s_GeneratedIncludeDirectiveEnd);
    outSource.append(s_GeneratedIncludeDirective);
    outSource.append(materialInterface);
    outSource.append(".bind\"\n");
    outSource.append(s_GeneratedIncludeDirective);
    outSource.append(surfaceSource);
    outSource.append(s_GeneratedIncludeDirectiveEnd);
}

void AppendShadowSurfaceBindAlias(
    in StringView symbol,
    in StringView bindNamespace,
    mut Vector<String> outAliasSymbols,
    mut HashSet<String> inOutSeenSymbols,
    mut String inOutSource
){
    String ownedSymbol = "";
    ownedSymbol.append(symbol);
    if(inOutSeenSymbols.contains(ownedSymbol))
        return;
    inOutSeenSymbols.insert(ownedSymbol);
    AppendShadowSurfaceBindAliasDefinition(symbol, bindNamespace, inOutSource);
    outAliasSymbols.push_back(ownedSymbol);
}

void AppendShadowSurfaceBindLayoutAliases(
    in StringView bindNamespace,
    mut Vector<String> outAliasSymbols,
    mut HashSet<String> inOutSeenSymbols,
    mut String inOutSource
){
    for(u32 lane = 0u; lane < s_NameHashLaneCount; ++lane){
        String suffix = "";
        suffix.append(s_MaterialBindInterfaceHashSymbolPrefix);
        AppendDecimalU32(lane, suffix);
        const String symbol = BuildMaterialBindGeneratedSymbol(suffix);
        AppendShadowSurfaceBindAlias(symbol, bindNamespace, outAliasSymbols, inOutSeenSymbols, inOutSource);
    }

    const String layoutHashSymbol = BuildMaterialBindGeneratedSymbol(s_MaterialBindLayoutHashSymbol);
    const String blockCountSymbol = BuildMaterialBindGeneratedSymbol(s_MaterialBindBlockCountSymbol);
    const String fieldCountSymbol = BuildMaterialBindGeneratedSymbol(s_MaterialBindFieldCountSymbol);
    const String storageConstantSymbol = BuildMaterialBindGeneratedSymbol(s_MaterialBindStorageConstantSymbol);
    const String storageMutableSymbol = BuildMaterialBindGeneratedSymbol(s_MaterialBindStorageMutableSymbol);
    const String constantByteSizeSymbol = BuildMaterialBindGeneratedSymbol(s_MaterialBindConstantByteSizeSymbol);
    const String mutableByteSizeSymbol = BuildMaterialBindGeneratedSymbol(s_MaterialBindMutableByteSizeSymbol);
    AppendShadowSurfaceBindAlias(layoutHashSymbol, bindNamespace, outAliasSymbols, inOutSeenSymbols, inOutSource);
    AppendShadowSurfaceBindAlias(blockCountSymbol, bindNamespace, outAliasSymbols, inOutSeenSymbols, inOutSource);
    AppendShadowSurfaceBindAlias(fieldCountSymbol, bindNamespace, outAliasSymbols, inOutSeenSymbols, inOutSource);
    AppendShadowSurfaceBindAlias(storageConstantSymbol, bindNamespace, outAliasSymbols, inOutSeenSymbols, inOutSource);
    AppendShadowSurfaceBindAlias(storageMutableSymbol, bindNamespace, outAliasSymbols, inOutSeenSymbols, inOutSource);
    AppendShadowSurfaceBindAlias(constantByteSizeSymbol, bindNamespace, outAliasSymbols, inOutSeenSymbols, inOutSource);
    AppendShadowSurfaceBindAlias(mutableByteSizeSymbol, bindNamespace, outAliasSymbols, inOutSeenSymbols, inOutSource);
}

void AppendShadowSurfaceBindInstanceBlockAliases(
    in StringView instanceName,
    in StringView bindNamespace,
    mut Vector<String> outAliasSymbols,
    mut HashSet<String> inOutSeenSymbols,
    mut String inOutSource
){
    const String storageSymbol = BuildMaterialBindGeneratedSymbol(instanceName, s_MaterialBindStorageSymbolSuffix);
    const String byteOffsetSymbol = BuildMaterialBindGeneratedSymbol(instanceName, s_MaterialBindByteOffsetSymbolSuffix);
    const String byteSizeSymbol = BuildMaterialBindGeneratedSymbol(instanceName, s_MaterialBindByteSizeSymbolSuffix);
    AppendShadowSurfaceBindAlias(storageSymbol, bindNamespace, outAliasSymbols, inOutSeenSymbols, inOutSource);
    AppendShadowSurfaceBindAlias(byteOffsetSymbol, bindNamespace, outAliasSymbols, inOutSeenSymbols, inOutSource);
    AppendShadowSurfaceBindAlias(byteSizeSymbol, bindNamespace, outAliasSymbols, inOutSeenSymbols, inOutSource);

    const String blockAccessor = BuildMaterialBindAccessorName(instanceName);
    AppendShadowSurfaceBindAlias(blockAccessor, bindNamespace, outAliasSymbols, inOutSeenSymbols, inOutSource);
}

void AppendShadowSurfaceBindInstanceFieldAliases(
    in StringView instanceName,
    in StringView fieldName,
    in StringView bindNamespace,
    mut Vector<String> outAliasSymbols,
    mut HashSet<String> inOutSeenSymbols,
    mut String inOutSource
){
    const String byteOffsetSymbol = BuildMaterialBindGeneratedSymbol(instanceName, fieldName, s_MaterialBindByteOffsetSymbolSuffix);
    const String keySymbol = BuildMaterialBindGeneratedSymbol(instanceName, fieldName, s_MaterialBindKeySymbolSuffix);
    const String defaultSymbol = BuildMaterialBindGeneratedSymbol(instanceName, fieldName, s_MaterialBindDefaultSymbolSuffix);
    AppendShadowSurfaceBindAlias(byteOffsetSymbol, bindNamespace, outAliasSymbols, inOutSeenSymbols, inOutSource);
    AppendShadowSurfaceBindAlias(keySymbol, bindNamespace, outAliasSymbols, inOutSeenSymbols, inOutSource);
    AppendShadowSurfaceBindAlias(defaultSymbol, bindNamespace, outAliasSymbols, inOutSeenSymbols, inOutSource);

    const String fieldAccessor = BuildMaterialBindAccessorName(instanceName, fieldName);
    AppendShadowSurfaceBindAlias(fieldAccessor, bindNamespace, outAliasSymbols, inOutSeenSymbols, inOutSource);
}

void AppendShadowSurfaceBindAliasUndefines(in Span<String> aliasSymbols, mut String inOutSource){
    for(usize index = aliasSymbols.size(); index > 0u; --index){
        inOutSource.append(s_GeneratedUndefDirective);
        inOutSource.append(aliasSymbols[index - 1u]);
        inOutSource.push_back('\n');
    }
}

String BuildShadowSurfaceBindNamespace(in u32 bindNamespaceId){
    String bindNamespace = "";
    bindNamespace.append(s_ShadowSurfaceBindNamespacePrefix);
    AppendDecimalU32(bindNamespaceId, bindNamespace);
    return bindNamespace;
}


