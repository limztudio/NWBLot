class StableDedupValue{
    public u32 key = 0u;
    public u32 order = 0u;
}

class IntervalProbe{
    public u64 first = 0u;
    public u64 last = 0u;
    public u32 index = 0u;
}

class WordRangeProbe{
    public usize begin = 0u;
    public usize end = 0u;
}


