////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanPublishAvboitReusableGeometryProducer(in b8 captured, in b8 taskValid){
    return captured && taskValid;
}

usize ResolveRefractionCaptureSetUseCount(in b8 sampledTextureSetValid){
    if(sampledTextureSetValid)
        return s_RefractionCaptureGeometryAndTextureSetUseCount;
    return 1u;
}

usize ComputeRefractionCaptureDrawUseCapacity(in usize commonUseCount, in b8 csg, in usize csgUseCount){
    usize total = commonUseCount + s_RefractionCaptureDrawExtraUseCapacity;
    if(csg)
        total += csgUseCount;
    return total;
}


