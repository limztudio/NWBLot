[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/material/renderer_draw_types.adhd.h>

#include <core/task/gpu/task_graph.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererMaterialSystem;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct OpaqueGbufferMaterialResources{
    Core::GpuGraphResourceSetId geometrySet;
    Core::GpuGraphResourceSetId sampledTextureSet;
    b8 geometryStatesGraphOwned = false;
    b8 sampledTexturesCollected = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class OpaqueGbufferMaterialResourceCollector final : NoCopy{
public:
    OpaqueGbufferMaterialResourceCollector(Core::GpuTaskGraph& graph, const RendererMaterialSystem& materialSystem, Core::Alloc::ScratchArena& scratchArena)noexcept
        : m_graph(graph)
        , m_materialSystem(materialSystem)
        , m_scratchArena(scratchArena)
    {}


public:
    [[nodiscard]] Expected<OpaqueGbufferMaterialResources> gather(const MaterialPassDrawItemPartitions& drawItems);


private:
    Core::GpuTaskGraph& m_graph;
    const RendererMaterialSystem& m_materialSystem;
    Core::Alloc::ScratchArena& m_scratchArena;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

