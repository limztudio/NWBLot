#include <impl/ecs_mesh/skinning/runtime_cache_validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<MeshletRefTotalCounts> TrySumRuntimeMeshletRefCounts(in Span<MeshletDesc> meshlets){
    MeshletRefTotalCounts counts;
    for(in MeshletDesc meshlet : meshlets){
        counts.positionRefCount += cast<usize>(MeshletPositionCount(meshlet));
        counts.attributeRefCount += cast<usize>(MeshletAttributeCount(meshlet));
    }
    if(counts.positionRefCount > cast<usize>(u32.max) || counts.attributeRefCount > cast<usize>(u32.max))
        return MakeUnexpected(Failure());
    return counts;
}

Expected<MeshletPositionStreamRef> TryDecodeSourceMeshletPositionRef(
    in Span<u8> positionRefDeltas,
    in MeshletDesc sourceMeshlet,
    in usize meshletIndex,
    in u32 localPositionIndex,
    in usize positionCount,
    in usize skinCount
){
    const Expected<MeshletPositionStreamRef> sourceRef = TryDecodeMeshletPositionRef(positionRefDeltas, sourceMeshlet, localPositionIndex, false);
    if(
        !sourceRef.has_value()
        || !MeshletPositionRefInRange(sourceRef.value(), positionCount, skinCount, false)
        || cast<usize>(sourceRef.value().position) >= skinCount
    ){
        error("MeshSkinningRuntimeCache: source meshlet {} position ref {} is invalid", meshletIndex, localPositionIndex);
        return MakeUnexpected(Failure());
    }
    return sourceRef.value();
}

Expected<MeshletAttributeStreamRef> TryDecodeSourceMeshletAttributeRef(
    in Span<u8> attributeRefDeltas,
    in MeshletDesc sourceMeshlet,
    in usize meshletIndex,
    in u32 localAttributeIndex,
    in usize normalCount,
    in usize tangentCount,
    in usize uv0Count,
    in usize colorCount
){
    const Expected<MeshletAttributeStreamRef> sourceRef = TryDecodeMeshletAttributeRef(attributeRefDeltas, sourceMeshlet, localAttributeIndex);
    if(
        !sourceRef.has_value()
        || !MeshletAttributeRefInRange(sourceRef.value(), normalCount, tangentCount, uv0Count, colorCount)
    ){
        error("MeshSkinningRuntimeCache: source meshlet {} attribute ref {} is invalid", meshletIndex, localAttributeIndex);
        return MakeUnexpected(Failure());
    }
    return sourceRef.value();
}

MeshletPositionStreamRef MakeRuntimeMeshletPositionStreamRef(in MeshletPositionStreamRef sourceRef, in usize runtimePositionIndex){
    MeshletPositionStreamRef runtimeRef = sourceRef;
    runtimeRef.position = cast<u32>(runtimePositionIndex);
    runtimeRef.skin = sourceRef.position;
    return runtimeRef;
}

MeshletAttributeStreamRef MakeRuntimeMeshletAttributeStreamRef(in MeshletAttributeStreamRef sourceRef, in usize runtimeAttributeIndex){
    MeshletAttributeStreamRef runtimeRef = sourceRef;
    runtimeRef.normal = cast<u32>(runtimeAttributeIndex);
    runtimeRef.tangent = cast<u32>(runtimeAttributeIndex);
    return runtimeRef;
}

b8 TryDecodeRuntimeZippedMeshletStreams(
    in Span<MeshletDesc> sourceMeshlets,
    in Span<u8> sourcePositionRefDeltas,
    in Span<u8> sourceAttributeRefDeltas,
    in Span<f32x3u> sourcePositions,
    in Span<f16x4u> sourceNormals,
    in Span<f16x4u> sourceTangents,
    in usize sourceUv0Count,
    in usize sourceColorCount,
    in usize skinStreamCount,
    mut Vector<f32x3u> outRestPositions,
    mut Vector<f16x4u> outRestNormals,
    mut Vector<f16x4u> outRestTangents,
    mut Vector<MeshletDesc> outMeshlets,
    mut Span<MeshletPositionStreamRef> outPositionRefs,
    mut Span<MeshletAttributeStreamRef> outAttributeRefs
){
    const Expected<MeshletRefTotalCounts> totalCounts = TrySumRuntimeMeshletRefCounts(sourceMeshlets);
    if(!totalCounts.has_value())
        return false;
    const usize positionRefCount = totalCounts.value().positionRefCount;
    const usize attributeRefCount = totalCounts.value().attributeRefCount;
    if(outPositionRefs.size() < positionRefCount || outAttributeRefs.size() < attributeRefCount)
        return false;

    outRestPositions.clear();
    outRestNormals.clear();
    outRestTangents.clear();
    outMeshlets.clear();
    outMeshlets.reserve(sourceMeshlets.size());
    outRestPositions.reserve(positionRefCount);
    outRestNormals.reserve(attributeRefCount);
    outRestTangents.reserve(attributeRefCount);

    usize writtenPositionRefCount = 0u;
    usize writtenAttributeRefCount = 0u;
    for(usize meshletIndex = 0u; meshletIndex < sourceMeshlets.size(); ++meshletIndex){
        const MeshletDesc sourceMeshlet = sourceMeshlets[meshletIndex];
        MeshletDesc runtimeMeshlet = sourceMeshlet;
        runtimeMeshlet.positionRefOffset = cast<u32>(writtenPositionRefCount);
        runtimeMeshlet.attributeRefOffset = cast<u32>(writtenAttributeRefCount);
        outMeshlets.push_back(runtimeMeshlet);

        for(u32 localPositionIndex = 0u; localPositionIndex < MeshletPositionCount(sourceMeshlet); ++localPositionIndex){
            const Expected<MeshletPositionStreamRef> sourceRef = TryDecodeSourceMeshletPositionRef(
                sourcePositionRefDeltas,
                sourceMeshlet,
                meshletIndex,
                localPositionIndex,
                sourcePositions.size(),
                skinStreamCount
            );
            if(!sourceRef.has_value())
                return false;

            const MeshletPositionStreamRef runtimeRef = MakeRuntimeMeshletPositionStreamRef(sourceRef.value(), writtenPositionRefCount);
            outRestPositions.push_back(sourcePositions[cast<usize>(sourceRef.value().position)]);
            outPositionRefs[writtenPositionRefCount] = runtimeRef;
            ++writtenPositionRefCount;
        }

        for(u32 localAttributeIndex = 0u; localAttributeIndex < MeshletAttributeCount(sourceMeshlet); ++localAttributeIndex){
            const Expected<MeshletAttributeStreamRef> sourceRef = TryDecodeSourceMeshletAttributeRef(
                sourceAttributeRefDeltas,
                sourceMeshlet,
                meshletIndex,
                localAttributeIndex,
                sourceNormals.size(),
                sourceTangents.size(),
                sourceUv0Count,
                sourceColorCount
            );
            if(!sourceRef.has_value())
                return false;

            outRestNormals.push_back(sourceNormals[cast<usize>(sourceRef.value().normal)]);
            outRestTangents.push_back(sourceTangents[cast<usize>(sourceRef.value().tangent)]);

            const MeshletAttributeStreamRef runtimeRef = MakeRuntimeMeshletAttributeStreamRef(sourceRef.value(), writtenAttributeRefCount);
            outAttributeRefs[writtenAttributeRefCount] = runtimeRef;
            ++writtenAttributeRefCount;
        }
    }
    return true;
}

b8 ResolveRuntimeZippedAttributeSkins(
    in Span<MeshletDesc> meshlets,
    in Span<MeshletPositionStreamRef> positionRefs,
    in Span<MeshletLocalVertexRef> localVertexRefs,
    in usize attributeCount,
    mut Vector<u32> outAttributeSkins
){
    outAttributeSkins.clear();
    outAttributeSkins.resize(attributeCount, s_MeshMissingStreamIndex);

    usize meshletPositionBase = 0u;
    usize meshletAttributeBase = 0u;
    for(usize meshletIndex = 0u; meshletIndex < meshlets.size(); ++meshletIndex){
        const MeshletDesc meshlet = meshlets[meshletIndex];
        const u32 vertexCount = MeshletVertexCount(meshlet);
        for(u32 localVertexIndex = 0u; localVertexIndex < vertexCount; ++localVertexIndex){
            const MeshletLocalVertexRef localVertexRef = localVertexRefs[cast<usize>(meshlet.localVertexOffset) + cast<usize>(localVertexIndex)];
            const usize attributeIndex = meshletAttributeBase + cast<usize>(localVertexRef.localAttribute);
            const u32 skinIndex = positionRefs[meshletPositionBase + cast<usize>(localVertexRef.localDeformedPosition)].skin;

            const u32 attributeSkin = outAttributeSkins[attributeIndex];
            if(attributeSkin == s_MeshMissingStreamIndex){
                outAttributeSkins[attributeIndex] = skinIndex;
                continue;
            }
            if(attributeSkin == skinIndex)
                continue;
            error("MeshSkinningRuntimeCache: source meshlet {} shares an attribute across skin identities", meshletIndex);
            return false;
        }

        meshletPositionBase += cast<usize>(MeshletPositionCount(meshlet));
        meshletAttributeBase += cast<usize>(MeshletAttributeCount(meshlet));
    }

    for(usize attributeIndex = 0u; attributeIndex < outAttributeSkins.size(); ++attributeIndex){
        if(outAttributeSkins[attributeIndex] != s_MeshMissingStreamIndex)
            continue;
        error("MeshSkinningRuntimeCache: source attribute ref {} is unreferenced", attributeIndex);
        return false;
    }

    return true;
}

Expected<RuntimeMeshLocalBounds> TryBuildRuntimeMeshLocalBounds(in Name sourceName, in Span<f32x3u> restPositions){
    if(restPositions.empty()){
        error("MeshSkinningRuntimeCache: skinning source '{}' has no positions for runtime bounds", sourceName.resolvedText());
        return MakeUnexpected(Failure());
    }
    VectorSingle minBounds(f32.max, f32.max, f32.max, 0.0f);
    VectorSingle maxBounds(f32.min, f32.min, f32.min, 0.0f);
    for(in f32x3u pos : restPositions){
        if(!IsFinite(pos.x) || !IsFinite(pos.y) || !IsFinite(pos.z)){
            error("MeshSkinningRuntimeCache: skinning source '{}' has invalid runtime bounds", sourceName.resolvedText());
            return MakeUnexpected(Failure());
        }
        const VectorSingle p(pos);
        minBounds = Min(minBounds, p);
        maxBounds = Max(maxBounds, p);
    }
    if(
        !IsFinite(minBounds.xyz)
        || !IsFinite(maxBounds.xyz)
        || minBounds.x > maxBounds.x
        || minBounds.y > maxBounds.y
        || minBounds.z > maxBounds.z
    ){
        error("MeshSkinningRuntimeCache: skinning source '{}' has invalid runtime bounds", sourceName.resolvedText());
        return MakeUnexpected(Failure());
    }
    RuntimeMeshLocalBounds bounds;
    bounds.minBounds = f32x3_i32(minBounds, s_RuntimeMeshBoundsValidFlag);
    bounds.maxBounds = f32x3_i32(maxBounds, 0);
    return bounds;
}

b8 BuildRuntimeMeshLocalBounds(in Name sourceName, in Span<f32x3u> restPositions, mut RuntimeMeshLocalBounds outBounds){
    const Expected<RuntimeMeshLocalBounds> bounds = TryBuildRuntimeMeshLocalBounds(sourceName, restPositions);
    if(!bounds.has_value()){
        outBounds = RuntimeMeshLocalBounds();
        return false;
    }
    outBounds = bounds.value();
    return true;
}


