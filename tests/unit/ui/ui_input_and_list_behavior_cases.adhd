void VerifyUiInputBindingsTests_OverlappingIgnoredModifierChordsRejectAtomicallyRegardlessOfCommand(mut UiInputBindingsTests self){
    const InputKeyBinding accepted = MakeUiInputKeyBinding(CoreKey::W, 0, 0, InputCommand::Left);
    ASSERT_TRUE(self.setSingle(accepted));
    const usize previous = self.bindingsDataAddress();
    Array<InputKeyBinding, 2u> overlap = Array<InputKeyBinding, 2u>();
    overlap[0u] = MakeUiInputKeyBinding(CoreKey::W, CoreInputModifier::Control, CoreInputModifier::Shift, InputCommand::Right);
    overlap[1u] = MakeUiInputKeyBinding(CoreKey::W, CoreInputModifier::Shift, CoreInputModifier::Control, InputCommand::Up);
    EXPECT_FALSE(self.setSpan(overlap));
    EXPECT_EQ(self.bindingsDataAddress(), previous);
    EXPECT_EQ(self.m_bindings.resolve(CoreKey::W, 0).command, InputCommand::Left);
    EXPECT_EQ(self.m_bindings.resolve(CoreKey::W, CoreInputModifier::Control | CoreInputModifier::Shift).command, InputCommand::None);
    Array<InputKeyBinding, 2u> duplicate = Array<InputKeyBinding, 2u>();
    duplicate[0u] = accepted;
    duplicate[1u] = accepted;
    EXPECT_FALSE(self.setSpan(duplicate));
    EXPECT_EQ(self.bindingsDataAddress(), previous);
}

void VerifyUiInputBindingsTests_MalformedKeysEnumsAndModifiersPreserveAcceptedProfile(mut UiInputBindingsTests self){
    const InputKeyBinding accepted = MakeUiInputKeyBinding(CoreKey::W, 0, 0, InputCommand::Left);
    ASSERT_TRUE(self.setSingle(accepted));
    const usize previous = self.bindingsDataAddress();
    Array<i32, 5u> invalidKeys = Array<i32, 5u>();
    invalidKeys[0u] = CoreKey::Unknown;
    invalidKeys[1u] = CoreKey::Space - 1;
    invalidKeys[2u] = CoreKey::Menu + 1;
    invalidKeys[3u] = CoreKey::Apostrophe + 1;
    invalidKeys[4u] = CoreKey::GraveAccent + 1;
    for(in i32 key : invalidKeys){
        InputKeyBinding invalid = accepted;
        invalid.key = key;
        EXPECT_FALSE(self.setSingle(invalid));
        EXPECT_EQ(self.bindingsDataAddress(), previous);
        EXPECT_EQ(self.m_bindings.resolve(key, 0).command, InputCommand::None);
    }
    InputKeyBinding invalid = accepted;
    invalid.command = InputCommand::None;
    EXPECT_FALSE(self.setSingle(invalid));
    invalid.command = bit_cast<InputCommandEnum>(u8(255u));
    EXPECT_FALSE(self.setSingle(invalid));
    invalid = accepted;
    invalid.selection = bit_cast<InputSelectionPolicyEnum>(u8(255u));
    EXPECT_FALSE(self.setSingle(invalid));
    invalid = accepted;
    invalid.modifiers = CoreInputModifier::CapsLock;
    EXPECT_FALSE(self.setSingle(invalid));
    invalid = accepted;
    invalid.ignoredModifiers = CoreInputModifier::NumLock;
    EXPECT_FALSE(self.setSingle(invalid));
    invalid.modifiers = CoreInputModifier::Shift;
    invalid.ignoredModifiers = CoreInputModifier::Shift;
    EXPECT_FALSE(self.setSingle(invalid));
    EXPECT_EQ(self.m_bindings.resolve(CoreKey::W, 0x0040).command, InputCommand::None);
    EXPECT_EQ(self.bindingsDataAddress(), previous);
    EXPECT_EQ(self.m_bindings.resolve(CoreKey::W, 0).command, InputCommand::Left);
}

void VerifyUiInputBindingsTests_WorldKeyCodesRejectSparseNeighborsWithoutReplacingTheAcceptedProfile(mut UiInputBindingsTests self){
    Array<InputKeyBinding, 2u> accepted = Array<InputKeyBinding, 2u>();
    accepted[0u] = MakeUiInputKeyBinding(CoreKey::World1, 0, 0, InputCommand::Left);
    accepted[1u] = MakeUiInputKeyBinding(CoreKey::World2, 0, 0, InputCommand::Right);
    ASSERT_TRUE(self.setSpan(accepted));
    const usize previous = self.bindingsDataAddress();
    Array<i32, 3u> invalidKeys = Array<i32, 3u>();
    invalidKeys[0u] = CoreKey::GraveAccent + 1;
    invalidKeys[1u] = CoreKey::World1 - 1;
    invalidKeys[2u] = CoreKey::World2 + 1;
    for(in i32 key : invalidKeys){
        InputKeyBinding invalid = accepted[0u];
        invalid.key = key;
        EXPECT_FALSE(self.setSingle(invalid));
        EXPECT_EQ(self.bindingsDataAddress(), previous);
        EXPECT_EQ(self.m_bindings.resolve(key, 0).command, InputCommand::None);
        EXPECT_EQ(self.m_bindings.resolve(161, 0).command, InputCommand::Left);
        EXPECT_EQ(self.m_bindings.resolve(162, 0).command, InputCommand::Right);
    }
}

void VerifyUiInputBindingsTests_ExactCapacitySucceedsAndOverflowPreservesTheProfile(mut UiInputBindingsTests self){
    Array<InputKeyBinding, 257u> custom = Array<InputKeyBinding, 257u>();
    ASSERT_EQ(custom.size(), s_InputMaxBindings + 1u);
    for(usize index = 0u; index < s_InputMaxBindings; ++index){
        custom[index].key = CoreKey::F1 + cast<i32>(index / 16u);
        custom[index].modifiers = cast<i32>(index % 16u);
        custom[index].command = InputCommand::Right;
    }
    ASSERT_TRUE(self.setCount(custom, s_InputMaxBindings));
    const usize previous = self.bindingsDataAddress();
    EXPECT_FALSE(self.setSpan(custom));
    EXPECT_EQ(self.bindingsDataAddress(), previous);
    EXPECT_EQ(self.m_bindings.resolve(CoreKey::F16, s_InputBindingModifierMask).command, InputCommand::Right);
    EXPECT_EQ(self.m_bindings.resolve(CoreKey::F17, 0).command, InputCommand::None);
}

void VerifyUiInputBindingsTests_EmptyAndAliasedProfileReplacementCanRecoverToDefaults(mut UiInputBindingsTests self){
    Array<InputKeyBinding, 2u> custom = Array<InputKeyBinding, 2u>();
    custom[0u] = MakeUiInputKeyBinding(CoreKey::W, 0, 0, InputCommand::Up);
    custom[1u] = MakeUiInputKeyBinding(CoreKey::F, 0, 0, InputCommand::Activate);
    ASSERT_TRUE(self.setSpan(custom));
    ASSERT_TRUE(self.setAliasedSlice(1u, 1u));
    EXPECT_EQ(self.m_bindings.resolve(CoreKey::W, 0).command, InputCommand::None);
    EXPECT_EQ(self.m_bindings.resolve(CoreKey::F, 0).command, InputCommand::Activate);
    ASSERT_TRUE(self.setEmpty());
    EXPECT_EQ(self.m_bindings.resolve(CoreKey::F, 0).command, InputCommand::None);
    EXPECT_EQ(self.m_bindings.resolve(CoreKey::Tab, 0).command, InputCommand::None);
    self.m_bindings.restoreDefaults();
    EXPECT_EQ(self.m_bindings.resolve(CoreKey::F, 0).command, InputCommand::None);
    EXPECT_EQ(self.m_bindings.resolve(CoreKey::Tab, CoreInputModifier::Shift).command, InputCommand::FocusPrevious);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyUiInputTests_AcceptedTargetLookupPreservesCommittedGeometryAcrossFailureRetirementAndReset(mut UiInputTests self){
    Array<HitTarget, 3u> initial = Array<HitTarget, 3u>();
    initial[0u] = MakeUiInputTarget(50u);
    initial[1u] = MakeUiInputTarget(10u);
    initial[2u] = MakeUiInputTarget(90u);
    ASSERT_TRUE(self.commitSpan(initial, 1u));
    EXPECT_EQ(self.findTargetAddress(WidgetId()), 0u);
    EXPECT_EQ(self.findTargetAddress(WidgetId(20u)), 0u);
    EXPECT_EQ(self.findTargetAddress(WidgetId(10u), initial[1u].declarationGeneration + 1u), 0u);
    const usize acceptedAddress = self.findTargetAddress(WidgetId(10u), initial[1u].declarationGeneration);
    ASSERT_NE(acceptedAddress, 0u);
    EXPECT_EQ(acceptedAddress, self.targetEntryAddress(1u));

    Array<HitTarget, 2u> duplicate = Array<HitTarget, 2u>();
    duplicate[0u] = MakeUiInputTarget(70u);
    duplicate[1u] = MakeUiInputTarget(70u);
    duplicate[0u].rectangle.x = 40.0f;
    EXPECT_FALSE(self.commitSpan(duplicate, 2u));
    EXPECT_EQ(self.findTargetAddress(WidgetId(10u)), acceptedAddress);
    EXPECT_EQ(self.findTargetAddress(WidgetId(70u)), 0u);
    const Optional<HitTarget> acceptedCopy = self.findTargetCopy(WidgetId(10u));
    ASSERT_TRUE(acceptedCopy.has_value());
    EXPECT_FLOAT_EQ(acceptedCopy.value().rectangle.x, initial[1u].rectangle.x);

    self.m_router.invalidateTarget(WidgetId(50u));
    EXPECT_EQ(self.findTargetAddress(WidgetId(50u)), 0u);
    ASSERT_NE(self.findTargetAddress(WidgetId(10u)), 0u);
    EXPECT_EQ(self.findTargetAddress(WidgetId(10u)), self.targetEntryAddress(0u));
    ASSERT_NE(self.findTargetAddress(WidgetId(90u)), 0u);
    EXPECT_EQ(self.findTargetAddress(WidgetId(90u)), self.targetEntryAddress(1u));

    HitTarget replacement = MakeUiInputTarget(10u);
    replacement.declarationGeneration = initial[1u].declarationGeneration + 1u;
    replacement.rectangle.x = 60.0f;
    ASSERT_TRUE(self.commitSingle(replacement, 2u));
    EXPECT_EQ(self.findTargetAddress(WidgetId(10u), initial[1u].declarationGeneration), 0u);
    ASSERT_NE(self.findTargetAddress(WidgetId(10u), replacement.declarationGeneration), 0u);
    const Optional<HitTarget> replacedCopy = self.findTargetCopy(WidgetId(10u));
    ASSERT_TRUE(replacedCopy.has_value());
    EXPECT_FLOAT_EQ(replacedCopy.value().rectangle.x, 60.0f);
    EXPECT_EQ(self.findTargetAddress(WidgetId(90u)), 0u);
    self.m_router.reset();
    EXPECT_EQ(self.findTargetAddress(WidgetId(10u)), 0u);
}

void VerifyUiInputTests_AbsentTargetInvalidationPreservesLiveFocusCaptureHoverAndQueuedActions(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 7u));
    self.click();
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    const u64 actionSequence = self.m_router.actions()[0u].id.sequence;
    ASSERT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    const u64 hoverActivity = self.m_router.hoverActivityGeneration();
    self.m_router.invalidateTarget(WidgetId(999u));
    self.m_router.invalidateTarget(WidgetId());
    EXPECT_EQ(self.m_router.layoutGeneration(), 7u);
    EXPECT_EQ(self.m_router.targets().size(), 1u);
    EXPECT_EQ(self.m_router.focus(), target.id);
    EXPECT_EQ(self.m_router.capture(), target.id);
    EXPECT_EQ(self.m_router.hover(), target.id);
    EXPECT_EQ(self.m_router.hoverActivityGeneration(), hoverActivity);
    EXPECT_TRUE(self.m_router.primaryDown());
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_EQ(self.m_router.actions()[0u].id.sequence, actionSequence);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
}

void VerifyUiInputTests_FirstClickConsumesBeforeFocusExistsAndActivationIsNotReplayed(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 7u));
    EXPECT_FALSE(self.m_router.focus().valid());
    const InputRoutingResult pressed = self.send(MakeUiInputPointer(InputEventType::PrimaryDown));
    EXPECT_TRUE(pressed.pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    const InputRoutingResult released = self.send(MakeUiInputPointer(InputEventType::PrimaryUp));
    EXPECT_TRUE(released.pointerConsumed);
    EXPECT_FALSE(released.capture.valid());
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    const UiInputAction action = self.m_router.actions()[0u];
    EXPECT_FALSE(self.m_router.process().pointerConsumed);
    EXPECT_EQ(self.m_router.actions()[0u].id.sequence, action.id.sequence);
    EXPECT_FALSE(self.commitSingle(target, 7u));
    EXPECT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.m_router.actions().empty());
}

void VerifyUiInputTests_HitTestRespectsPaintOrderClippingDisabledTargetsAndHalfOpenBounds(mut UiInputTests self){
    Array<HitTarget, 4u> targets = Array<HitTarget, 4u>();
    targets[0u] = MakeUiInputTarget(1u);
    targets[1u] = MakeUiInputTarget(2u);
    targets[2u] = MakeUiInputTarget(3u);
    targets[3u] = MakeUiInputTarget(4u);
    for(usize index = 0u; index < 4u; ++index){
        targets[index].rectangle = Rect(0.0f, 0.0f, 100.0f, 100.0f);
    }
    targets[0u].paintOrder = 20u;
    targets[0u].clip = Rect(40.0f, 40.0f, 20.0f, 20.0f);
    targets[1u].paintOrder = 1u;
    targets[2u].paintOrder = 100u;
    targets[2u].enabled = false;
    targets[3u].paintOrder = 20u;
    targets[3u].clip = Rect(45.0f, 45.0f, 5.0f, 5.0f);
    ASSERT_TRUE(self.commitSpan(targets, 1u));
    EXPECT_EQ(self.m_router.hitTest(Point(40.0f, 40.0f)).value, 1u);
    EXPECT_EQ(self.m_router.hitTest(Point(45.0f, 45.0f)).value, 4u);
    EXPECT_EQ(self.m_router.hitTest(Point(50.0f, 50.0f)).value, 1u);
    EXPECT_EQ(self.m_router.hitTest(Point(60.0f, 60.0f)).value, 2u);
    EXPECT_EQ(self.m_router.hitTest(Point(10.0f, 10.0f)).value, 2u);
    EXPECT_FALSE(self.m_router.hitTest(Point(100.0f, 10.0f)).valid());
    EXPECT_FALSE(self.m_router.hitTest(Point(UiInputLayoutQuietNaNF32(), 0.0f)).valid());
    EXPECT_TRUE(self.m_router.wouldConsumePointer(Point(45.0f, 45.0f)));
    EXPECT_FALSE(self.m_router.wouldConsumePointer(Point(-1.0f, -1.0f)));
}

void VerifyUiInputTests_TransientHoverDepartureAndReentryAdvanceActivityBeforeTheNextPaint(mut UiInputTests self){
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = MakeUiInputTarget(1u);
    targets[1u] = MakeUiInputTargetAt(2u, Rect(40.0f, 10.0f, 20.0f, 20.0f));
    ASSERT_TRUE(self.commitSpan(targets, 1u));
    ASSERT_EQ(self.send(MakeUiInputPointer(InputEventType::PointerMove)).hover, targets[0u].id);
    const u64 stable = self.m_router.hoverActivityGeneration();
    ASSERT_EQ(self.send(MakeUiInputPointerAt(InputEventType::PointerMove, Point(16.0f, 16.0f))).hover, targets[0u].id);
    EXPECT_EQ(self.m_router.hoverActivityGeneration(), stable);
    ASSERT_TRUE(self.commitSpan(targets, 2u));
    EXPECT_EQ(self.m_router.hoverActivityGeneration(), stable);
    EXPECT_FALSE(self.commitSpan(targets, 2u));
    EXPECT_EQ(self.m_router.hoverActivityGeneration(), stable);

    ASSERT_TRUE(self.queueNative(MakeUiInputPointerAt(InputEventType::PointerMove, Point(45.0f, 15.0f))));
    ASSERT_TRUE(self.queueNative(MakeUiInputPointer(InputEventType::PointerMove)));
    EXPECT_EQ(self.m_router.process().hover, targets[0u].id);
    const u64 returned = self.m_router.hoverActivityGeneration();
    EXPECT_GT(returned, stable);

    ASSERT_TRUE(self.queueNative(MakeUiInputBareEvent(InputEventType::PointerLeave)));
    ASSERT_TRUE(self.queueNative(MakeUiInputPointer(InputEventType::PointerMove)));
    EXPECT_EQ(self.m_router.process().hover, targets[0u].id);
    EXPECT_GT(self.m_router.hoverActivityGeneration(), returned);
}

void VerifyUiInputTests_HoverActivityUsesTheControlHostLifetimeAcrossOwnedParts(mut UiInputTests self){
    Array<HitTarget, 3u> targets = Array<HitTarget, 3u>();
    targets[0u] = MakeUiInputTargetAt(1u, Rect(10.0f, 10.0f, 80.0f, 20.0f));
    targets[1u] = MakeUiInputTargetAt(2u, Rect(20.0f, 10.0f, 10.0f, 20.0f));
    targets[2u] = MakeUiInputTargetAt(3u, Rect(40.0f, 10.0f, 10.0f, 20.0f));
    targets[0u].control = ControlToken(11u, 12u, 13u);
    for(usize index = 1u; index < 3u; ++index){
        targets[index].owner = targets[0u].id;
        targets[index].ownerDeclarationGeneration = targets[0u].declarationGeneration;
        targets[index].control = targets[0u].control;
        targets[index].focusable = false;
        targets[index].paintOrder = cast<u32>(index);
    }
    ASSERT_TRUE(self.commitSpan(targets, 1u));
    ASSERT_EQ(self.send(MakeUiInputPointerAt(InputEventType::PointerMove, Point(15.0f, 15.0f))).hover, targets[0u].id);
    const u64 ownerGeneration = self.m_router.hoverActivityGeneration();
    EXPECT_EQ(self.send(MakeUiInputPointerAt(InputEventType::PointerMove, Point(25.0f, 15.0f))).hover, targets[1u].id);
    EXPECT_EQ(self.send(MakeUiInputPointerAt(InputEventType::PointerMove, Point(45.0f, 15.0f))).hover, targets[2u].id);
    EXPECT_EQ(self.send(MakeUiInputPointerAt(InputEventType::PointerMove, Point(80.0f, 15.0f))).hover, targets[0u].id);
    EXPECT_EQ(self.m_router.hoverActivityGeneration(), ownerGeneration);
    ASSERT_TRUE(self.commitSpan(targets, 2u));
    EXPECT_EQ(self.m_router.hoverActivityGeneration(), ownerGeneration);

    targets[0u].control.contentRevision = 14u;
    targets[1u].control = targets[0u].control;
    targets[2u].control = targets[0u].control;
    ASSERT_TRUE(self.commitSpan(targets, 3u));
    const u64 changedControl = self.m_router.hoverActivityGeneration();
    EXPECT_GT(changedControl, ownerGeneration);
    targets[0u].declarationGeneration = 2u;
    targets[1u].ownerDeclarationGeneration = 2u;
    targets[2u].ownerDeclarationGeneration = 2u;
    ASSERT_TRUE(self.commitSpan(targets, 4u));
    EXPECT_GT(self.m_router.hoverActivityGeneration(), changedControl);
}

void VerifyUiInputTests_PressCaptureLossFocusLossAndResetFenceHoverActivity(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    ASSERT_EQ(self.send(MakeUiInputPointer(InputEventType::PointerMove)).hover, target.id);
    u64 previous = self.m_router.hoverActivityGeneration();
    ASSERT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_GT(self.m_router.hoverActivityGeneration(), previous);
    previous = self.m_router.hoverActivityGeneration();
    ASSERT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_EQ(self.m_router.hoverActivityGeneration(), previous);

    ASSERT_TRUE(self.send(MakeUiInputPointer(InputEventType::SecondaryDown)).pointerConsumed);
    EXPECT_GT(self.m_router.hoverActivityGeneration(), previous);
    previous = self.m_router.hoverActivityGeneration();
    ASSERT_TRUE(self.send(MakeUiInputPointer(InputEventType::SecondaryUp)).pointerConsumed);
    EXPECT_EQ(self.m_router.hoverActivityGeneration(), previous);

    ASSERT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_GT(self.m_router.hoverActivityGeneration(), previous);
    previous = self.m_router.hoverActivityGeneration();
    self.send(MakeUiInputBareEvent(InputEventType::PointerCaptureLost));
    EXPECT_GT(self.m_router.hoverActivityGeneration(), previous);
    previous = self.m_router.hoverActivityGeneration();
    self.send(MakeUiInputBareEvent(InputEventType::FocusLost));
    self.m_router.cancelDeviceInput(0u);
    EXPECT_GT(self.m_router.hoverActivityGeneration(), previous);
    previous = self.m_router.hoverActivityGeneration();
    self.m_router.reset();
    EXPECT_GT(self.m_router.hoverActivityGeneration(), previous);
    previous = self.m_router.hoverActivityGeneration();
    ASSERT_TRUE(self.commitSingle(target, 1u));
    self.send(MakeUiInputBareEvent(InputEventType::FocusGained));
    EXPECT_EQ(self.send(MakeUiInputPointer(InputEventType::PointerMove)).hover, target.id);
    EXPECT_GT(self.m_router.hoverActivityGeneration(), previous);
}

void VerifyUiInputTests_DragOutsideDoesNotActivateAndRemovalKeepsReleaseConsumption(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    const InputRoutingResult moved = self.send(MakeUiInputPointerAt(InputEventType::PointerMove, Point(90.0f, 90.0f)));
    EXPECT_TRUE(moved.pointerConsumed);
    EXPECT_FALSE(moved.hover.valid());
    EXPECT_EQ(moved.capture.value, 1u);
    EXPECT_TRUE(self.m_router.wouldConsumePointer(Point(90.0f, 90.0f)));
    EXPECT_TRUE(self.send(MakeUiInputPointerAt(InputEventType::PrimaryUp, Point(90.0f, 90.0f))).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    ASSERT_TRUE(self.commitEmpty(2u));
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_FALSE(self.m_router.focus().valid());
    const InputRoutingResult afterRemoval = self.send(MakeUiInputPointerAt(InputEventType::PointerMove, Point(90.0f, 90.0f)));
    EXPECT_TRUE(afterRemoval.pointerConsumed);
    EXPECT_TRUE(afterRemoval.wantsPointer);
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.send(MakeUiInputPointer(InputEventType::PointerMove)).pointerConsumed);
    EXPECT_FALSE(self.m_router.wouldConsumePointer(Point(15.0f, 15.0f)));
}

void VerifyUiInputTests_PointerLeaveClearsHoverButPreservesLogicalCaptureAndReleaseOwnership(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PointerMove)).pointerConsumed);
    const InputRoutingResult hoveredLeave = self.send(MakeUiInputBareEvent(InputEventType::PointerLeave));
    EXPECT_FALSE(hoveredLeave.hover.valid());
    EXPECT_FALSE(hoveredLeave.wantsPointer);
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    const InputRoutingResult capturedLeave = self.send(MakeUiInputBareEvent(InputEventType::PointerLeave));
    EXPECT_TRUE(capturedLeave.pointerConsumed);
    EXPECT_TRUE(capturedLeave.wantsPointer);
    EXPECT_FALSE(capturedLeave.hover.valid());
    EXPECT_EQ(capturedLeave.capture.value, 1u);
    EXPECT_EQ(capturedLeave.focus.value, 1u);
    EXPECT_TRUE(self.send(MakeUiInputPointerAt(InputEventType::PrimaryUp, Point(90.0f, 90.0f))).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.capture().valid());
}

void VerifyUiInputTests_NewDeclarationAndDisabledTargetsCancelPendingStateAndActions(mut UiInputTests self){
    HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    self.click();
    ASSERT_EQ(self.m_router.actions().size(), 1u);
