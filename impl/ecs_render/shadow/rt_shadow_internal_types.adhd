////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<u32> ImplEcsRenderShadowRtShadowInternalTypesDrawCount(in Span<LightSpaceShadowCaster> casters){
    u64 drawCount = 0u;
    for(usize i = 0u; i < casters.size(); ++i){
        drawCount += LightSpaceCasterDrawCount(casters[i].meshletCount);
        if(drawCount > u32.max)
            return MakeUnexpected(Failure());
    }
    return cast<u32>(drawCount);
}


