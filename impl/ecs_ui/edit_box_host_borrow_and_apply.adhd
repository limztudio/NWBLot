#include <impl/ecs_ui/edit_box_host.adhd>
#include <impl/ecs_ui/edit_geometry.adhd>
#include <impl/ecs_ui/text_edit_session.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 HasUiEditModelGenerationsChanged(
    in u64 beforeRevision,
    in u64 beforeExternalRevision,
    in u64 beforeSelectionGeneration,
    in u64 beforeCompositionGeneration,
    in u64 afterRevision,
    in u64 afterExternalRevision,
    in u64 afterSelectionGeneration,
    in u64 afterCompositionGeneration
){
    return afterRevision != beforeRevision
        || afterExternalRevision != beforeExternalRevision
        || afterSelectionGeneration != beforeSelectionGeneration
        || afterCompositionGeneration != beforeCompositionGeneration;
}

b8 IsUiEditEntryRebound(
    in UiTextEditOwner currentOwner,
    in UiTextEditOwner nextOwner,
    in PopupToken currentPopup,
    in PopupToken nextPopup,
    in b8 currentActionCapable,
    in b8 nextActionCapable,
    in u64 currentNavigationInstance,
    in u64 nextNavigationInstance
){
    return currentOwner != nextOwner
        || currentPopup != nextPopup
        || currentActionCapable != nextActionCapable
        || currentNavigationInstance != nextNavigationInstance;
}

b8 IsMutatingUiEditClipboardAction(in EditClipboardAction action){
    return action == EditClipboardAction::Cut || action == EditClipboardAction::Paste;
}

void SynchronizeUiEditBoxSession(
    in EditBoxOptions options,
    in b8 inputMethod,
    in b8 entryFocused,
    in DisplayMetrics display,
    in UiEditBoxGeometry displayed,
    in UiTextEditOwner owner,
    in PopupToken popup,
    mut UiTextEditSession session,
    mut EditModel model,
    mut u64 inOutLastNativeSequence,
    mut TextInputSessionToken inOutRejectedNative,
    mut TextAreaModelStamp inOutNativePublished
){
    if(!options.enabled || options.readOnly || !entryFocused){
        if(session.owner() == owner && !session.cancel())
            TerminateInvariant();
        model.cancelComposition();
        return;
    }
    if(!UiEditGeometry().sessionReady(displayed, owner, popup))
        return;
    if(session.token().valid() && session.owner() != owner && !session.cancel())
        TerminateInvariant();
    TextInputChangeCause cause = TextInputChangeCause::Other;
    if(inputMethod)
        cause = TextInputChangeCause::InputMethod;
    if(!session.token().valid()){
        model.cancelComposition();
        if(session.begin(owner, MakeUiEditNativeCaretRect(displayed, display), model) != TextInputAdmission::Accepted)
            return;
        inOutLastNativeSequence = 0u;
        inOutRejectedNative = TextInputSessionToken();
    }
    else{
        if(session.adoptLocal(owner, model, MakeUiEditNativeCaretRect(displayed, display), cause) != TextInputAdmission::Accepted){
            model.cancelComposition();
            if(!session.cancel())
                TerminateInvariant();
            return;
        }
    }
    inOutNativePublished = model.stamp();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


EditBoxResult UiEditBoxHost::editBorrowed(in WidgetState widget, in EditBoxOptions options, in PopupToken popup, mut EditModel model, in Optional<mut IEditActionSink> actions, in Optional<mut UiEditNavigationBorrow> navigation){
    if(this.rejectBorrowedMutation())
        return EditBoxResult();
    if(navigation.has_value() && model.textMode() != EditTextMode::Multiline)
        return EditBoxResult();
    if(actions.has_value())
        this.synchronizeFocus();
    this.m_borrowed = true;
    this.m_borrowRejected = false;
    UiEditBorrowRelease release(this.m_borrowed);

    EditBoxResult result;
    result.valid = true;
    result.focused = options.enabled && this.m_context.input().focus() == widget.id;
    UiTextEditOwner owner;
    owner.widget = widget.id;
    owner.declarationGeneration = widget.declarationGeneration;
    owner.modelGeneration = model.instanceGeneration();
    auto entry = this.findEntry(widget.id);
    u64 navigationInstance = 0u;
    if(navigation.has_value())
        navigationInstance = navigation.value().state.instanceGeneration();
    b8 abandon = false;
    if(!entry.has_value()){
        if(this.m_entries.size() == s_UiEditBoxMaxEntries){
            result.valid = false;
            return result;
        }
        this.m_entries.emplace_back();
        entry = Optional<mut UiEditBoxEntry>(this.m_entries[this.m_entries.size() - 1u]);
        entry.value().owner = owner;
        entry.value().expected.capture(model);
        entry.value().navigationResetPending = navigation.has_value();
        abandon = actions.has_value();
    }
    else{
        const b8 rebound = IsUiEditEntryRebound(entry.value().owner, owner, entry.value().popup, popup, entry.value().actionCapable, actions.has_value(), entry.value().navigationInstanceGeneration, navigationInstance);
        const b8 policyChanged = entry.value().enabled != options.enabled || entry.value().readOnly != options.readOnly;
        abandon = actions.has_value() && (rebound || policyChanged);
        if(rebound || policyChanged || !entry.value().expected.matches(model)){
            this.m_context.input().cancelSubmitCommands(widget.id);
            entry.value().navigationResetPending = navigation.has_value();
            if(HasPendingUiEditOwnerTransfer(entry.value().owner, this.m_session.owner(), this.m_clipboard.pending(), this.m_clipboardOwner, this.m_primary.pending(), this.m_primaryOwner))
                this.cancelTransfers();
            this.discard(entry.value().owner);
            entry.value().owner = owner;
            entry.value().dragging = false;
            entry.value().wordDragging = false;
            this.m_clickTracker.cancel();
            model.cancelComposition();
            entry.value().expected.capture(model);
            if(rebound || policyChanged){
                entry.value().focused = false;
                entry.value().focusGeneration = 0u;
                entry.value().retiredFocusGeneration = 0u;
            }
        }
    }
    entry.value().widget = widget;
    entry.value().popup = popup;
    entry.value().seen = this.m_generation;
    entry.value().actionCapable = actions.has_value();
    entry.value().navigationInstanceGeneration = navigationInstance;
    entry.value().enabled = options.enabled;
    entry.value().readOnly = options.readOnly;
    if(actions.has_value() && result.focused && !entry.value().focused){
        entry.value().focused = true;
        entry.value().focusGeneration = this.nextFocusGeneration();
    }
    const u64 beforeRevision = model.revision();
    const usize beforeAnchor = model.anchor();
    const usize beforeCaret = model.caret();
    if(this.m_borrowRejected){
        result.valid = false;
        return result;
    }
    if(navigation.has_value() && entry.value().navigationResetPending){
        navigation.value().state.reset();
        entry.value().navigationResetPending = false;
    }
    if(abandon && !this.applyAction(options, EditAction::Abandon, entry.value(), model, result, actions.value(), navigation)){
        result.valid = false;
        this.discard(owner);
        return result;
    }
    if((!result.focused && !actions.has_value()) || options.readOnly || !options.enabled){
        if(this.m_session.owner() == owner)
            this.cancelTransfers();
        model.cancelComposition();
    }
    b8 inputMethod = false;
    usize index = 0u;
    while(index < this.m_events.size()){
        if(this.m_events[index].owner != owner){
            ++index;
            continue;
        }
        UiEditBoxEvent event = this.makeEvent();
        MoveInto<UiEditBoxEvent>(event, this.m_events[index]);
        this.m_queuedTextBytes -= event.native.text.size();
        this.m_events.erase(this.m_events.begin() + cast<isize>(index));
        if(actions.has_value() && event.focusGeneration <= entry.value().retiredFocusGeneration)
            continue;
        if(options.enabled){
            if(!this.apply(options, event, entry.value(), model, result, actions, navigation)){
                result.valid = false;
                this.discard(owner);
                if(HasPendingUiEditOwnerTransfer(owner, this.m_session.owner(), this.m_clipboard.pending(), this.m_clipboardOwner, this.m_primary.pending(), this.m_primaryOwner))
                    this.cancelTransfers();
                return result;
            }
            inputMethod = event.kind == UiEditBoxEventKind::Native;
        }
    }
    if(this.m_clipboard.pending() && this.m_clipboardOwner == owner){
        if(!result.focused){
            if(!this.m_clipboard.cancel())
                TerminateInvariant();
        }
        else{
            const auto action = this.m_clipboard.action();
            const b8 mutates = IsMutatingUiEditClipboardAction(action);
            if(mutates){
                if(this.m_session.owner() == owner && !this.m_session.cancel())
                    TerminateInvariant();
            }
            const auto completion = this.m_clipboard.drain(owner, model, options.readOnly);
            result.textChanged |= completion.textChanged;
            result.selectionChanged |= completion.selectionChanged;
            if(navigation.has_value() && !this.m_borrowRejected && mutates && completion.status == UiEditClipboardStatus::Applied)
                navigation.value().state.reset();
        }
    }
    if(this.m_primary.pending() && this.m_primaryOwner == owner){
        const auto completion = this.m_primary.drain(owner, model, options.readOnly);
        result.textChanged |= completion.textChanged;
        result.selectionChanged |= completion.selectionChanged;
    }
    result.textChanged |= beforeRevision != model.revision();
    result.selectionChanged |= beforeAnchor != model.anchor() || beforeCaret != model.caret();
    result.focused = options.enabled && this.m_context.input().focus() == widget.id;
    result.preeditCaretVisible = entry.value().preeditCaretVisible;
    this.synchronizeSession(options, inputMethod, entry.value(), model);
    result.valid = !this.m_borrowRejected;
    entry.value().expected.capture(model);
    return result;
}

b8 UiEditBoxHost::apply(in EditBoxOptions options, mut UiEditBoxEvent event, mut UiEditBoxEntry entry, mut EditModel model, mut EditBoxResult result, in Optional<mut IEditActionSink> actions, in Optional<mut UiEditNavigationBorrow> navigation){
    const u64 revision = model.revision();
    const u64 externalRevision = model.externalRevision();
    const u64 selectionGeneration = model.selectionGeneration();
    const u64 compositionGeneration = model.compositionGeneration();
    const b8 clipboard = this.m_clipboard.cancel();
    const b8 primary = this.m_primary.cancel();
    if(!clipboard || !primary)
        TerminateInvariant();
    if(this.m_borrowRejected)
        return false;
    const b8 composing = model.composition().active;
    if(event.kind == UiEditBoxEventKind::Command){
        if(event.navigation){
            if(navigation.has_value())
                return this.applyNavigation(event, event.navigationDirection, model, navigation.value());
            return true;
        }
        const auto command = ApplyEditCommand(model, event.command, options.readOnly);
        result.submitted |= command.submitted;
        result.cancelled |= command.cancelled;
        if(actions.has_value() && (command.submitted || command.cancelled)){
            EditAction action = EditAction::Cancel;
            if(command.submitted)
                action = EditAction::Submit;
            if(!this.applyAction(options, action, entry, model, result, actions.value(), navigation))
                return false;
        }
        if(command.cancelled){
            const b8 cancelFocus = !actions.has_value() || (entry.focused && entry.focusGeneration == event.focusGeneration && this.m_context.input().focus() == entry.widget.id);
            if(actions.has_value()){
                entry.retiredFocusGeneration = Max(entry.retiredFocusGeneration, event.focusGeneration);
                if(entry.focusGeneration == event.focusGeneration)
                    entry.focused = false;
            }
            if(cancelFocus){
                if(!this.m_context.input().dismissPopup(PopupDismissReason::Cancel))
                    this.m_context.input().clearFocus();
            }
        }
        if(command.clipboard != EditClipboardAction::None){
            if(command.clipboard == EditClipboardAction::Copy){
                if(!model.hasSelection())
                    return true;
                this.drainPublications();
                const auto status = this.m_publications.request(model.selectedText());
                this.m_clipboardFailure |= status != UiClipboardPublicationStatus::Pending;
            }
            else{
                const auto request = this.m_clipboard.request(entry.owner, model, command.clipboard, ClipboardChannel::Clipboard, options.readOnly);
                if(request.status == UiEditClipboardStatus::Pending)
                    this.m_clipboardOwner = entry.owner;
            }
        }
    }
    else if(event.kind == UiEditBoxEventKind::Character){
        if(!options.readOnly && !model.replaceSelection(event.native.text))
            return true;
    }
    else if(event.kind == UiEditBoxEventKind::Native){
        if(options.readOnly || event.native.token == entry.rejectedNative)
            return true;
        if(event.native.kind == TextInputEventKind::Commit && event.native.text.size() == 1u && !IsTextInputCodePoint(cast<u8>(event.native.text[0u])))
            return true;
        const b8 matching = MatchesUiEditNativeSurroundingState(
            model.revision(),
            event.surroundingModelRevision,
            model.externalRevision(),
            event.geometryExternalRevision,
            model.selectionGeneration(),
            event.surroundingSelectionGeneration,
            model.anchor(),
            event.surroundingAnchor,
            model.caret(),
            event.surroundingCaret,
            !actions.has_value() || (this.m_session.owner() == entry.owner && this.m_session.token() == event.native.token)
        );
        const auto status = ApplyUiTextEditEvent(model, event.native, event.surroundingRevision, matching);
        if(status != UiTextEditStatus::Applied){
            model.cancelComposition();
            entry.rejectedNative = event.native.token;
            if(this.m_session.owner() == entry.owner && !this.m_session.cancel())
                TerminateInvariant();
        }
        entry.preeditCaretVisible = event.native.kind != TextInputEventKind::Preedit || event.native.caretVisible;
    }
    else if(event.kind == UiEditBoxEventKind::Selection){
        if(model.revision() != event.geometryRevision || model.externalRevision() != event.geometryExternalRevision){
            if(event.completed){
                entry.dragging = false;
                entry.wordDragging = false;
            }
            return true;
        }
        if(event.wordSelect){
            const auto range = model.wordRangeAt(event.wordPosition);
            if(!range.has_value() || !model.setSelection(range.value().begin, range.value().end))
                return true;
            entry.wordDragStart = range.value().begin;
            entry.wordDragEnd = range.value().end;
            entry.wordDragging = true;
        }
        else if(event.dragging && entry.dragging && entry.wordDragging){
            const auto range = model.wordRangeAt(event.wordPosition);
            if(!range.has_value())
                return true;
            const EditWordRange selection = ResolveUiEditWordDragSelection(event.wordPosition, entry.wordDragStart, entry.wordDragEnd, range.value());
            if(!model.setSelection(selection.begin, selection.end))
                return true;
        }
        else{
            const usize anchor = ResolveUiEditSelectionAnchor(event.dragging, entry.dragging, entry.dragAnchor, event.extend, model.anchor(), event.position);
            if(!model.setSelection(anchor, event.position))
                return true;
            entry.dragAnchor = anchor;
            entry.wordDragging = false;
        }
        entry.dragging = !event.completed;
        if(event.completed)
            entry.wordDragging = false;
        if(model.hasSelection() && this.m_clipboardService.capabilities(ClipboardChannel::PrimarySelection).writeText){
            const auto request = this.m_primary.request(entry.owner, model, EditClipboardAction::PublishSelection, ClipboardChannel::PrimarySelection, options.readOnly);
            if(request.status == UiEditClipboardStatus::Pending)
                this.m_primaryOwner = entry.owner;
        }
    }
    else if(event.kind == UiEditBoxEventKind::PastePrimary){
        const auto request = this.m_clipboard.request(entry.owner, model, EditClipboardAction::Paste, ClipboardChannel::PrimarySelection, options.readOnly);
        if(request.status == UiEditClipboardStatus::Pending)
            this.m_clipboardOwner = entry.owner;
    }
    else if(event.kind == UiEditBoxEventKind::Blur && actions.has_value()){
        entry.retiredFocusGeneration = event.focusGeneration;
        return this.applyAction(options, EditAction::Blur, entry, model, result, actions.value(), navigation);
    }
    else if(event.kind == UiEditBoxEventKind::Focus && navigation.has_value()){
        navigation.value().state.reset();
    }
    if(composing && !model.composition().active && event.kind != UiEditBoxEventKind::Native){
        entry.rejectedNative = this.m_session.token();
        if(this.m_session.owner() == entry.owner && !this.m_session.cancel())
            TerminateInvariant();
    }
    if(this.m_borrowRejected)
        return false;
    if(navigation.has_value() && HasUiEditModelGenerationsChanged(revision, externalRevision, selectionGeneration, compositionGeneration, model.revision(), model.externalRevision(), model.selectionGeneration(), model.compositionGeneration()))
        navigation.value().state.reset();
    return true;
}

b8 UiEditBoxHost::applyNavigation(in UiEditBoxEvent event, in EditNavigationDirection direction, mut EditModel model, mut UiEditNavigationBorrow navigation){
    if(this.m_borrowRejected || this.m_context.failed())
        return false;
    if(model.textMode() != EditTextMode::Multiline || model.composition().active)
        return true;
    if(!IsValidUiEditNavigationViewportHeight(direction, event.navigationViewportHeight))
        return false;
    const TextAreaModelStamp expected = model.stamp();
    const EditNavigationSnapshot preferred = navigation.state.snapshot();
    const auto target = navigation.resolver.resolve(model, direction, preferred, event.navigationViewportHeight);
    if(this.m_borrowRejected || this.m_context.failed() || !model.matchesStamp(expected) || model.composition().active || !navigation.state.matches(preferred) || !target.has_value() || !IsFinite(target.value().preferredX))
        return false;
    if(!IsCommittedByteOnGraphemeBoundary(model.graphemeBoundaries(), target.value().committedByte))
        return false;
    usize anchor = target.value().committedByte;
    if(event.command.extend)
        anchor = expected.anchor;
    if(!model.setSelection(anchor, target.value().committedByte))
        return false;
    if(!navigation.state.setPreferredX(target.value().preferredX))
        TerminateInvariant();
    return true;
}

b8 UiEditBoxHost::applyAction(in EditBoxOptions options, in EditAction action, mut UiEditBoxEntry entry, mut EditModel model, mut EditBoxResult result, mut IEditActionSink actions, in Optional<mut UiEditNavigationBorrow> navigation){
    const u64 revision = model.revision();
    const u64 selectionGeneration = model.selectionGeneration();
    const u64 compositionGeneration = model.compositionGeneration();
    if(this.m_clipboard.pending() && this.m_clipboardOwner == entry.owner && !this.m_clipboard.cancel())
        TerminateInvariant();
    if(this.m_primary.pending() && this.m_primaryOwner == entry.owner && !this.m_primary.cancel())
        TerminateInvariant();
    if(action == EditAction::Blur || action == EditAction::Abandon)
        model.cancelComposition();
    const u64 externalRevision = model.externalRevision();
    if(this.m_borrowRejected || !actions.apply(model, action, options.readOnly) || this.m_borrowRejected)
        return false;
    if(
        navigation.has_value()
        && ShouldResetUiEditNavigationAfterAction(
            action,
            revision,
            externalRevision,
            selectionGeneration,
            compositionGeneration,
            model.revision(),
            model.externalRevision(),
            model.selectionGeneration(),
            model.compositionGeneration()
        )
    )
        navigation.value().state.reset();
    MergeUiEditActionToResult(action, result);
    if(action != EditAction::Submit || model.externalRevision() != externalRevision){
        if(this.m_session.owner() == entry.owner && !this.m_session.cancel())
            TerminateInvariant();
    }
    return !this.m_borrowRejected;
}

void UiEditBoxHost::synchronizeSession(in EditBoxOptions options, in b8 inputMethod, mut UiEditBoxEntry entry, mut EditModel model){
    SynchronizeUiEditBoxSession(
        options,
        inputMethod,
        this.m_context.input().focus() == entry.widget.id,
        this.m_display,
        entry.displayed,
        entry.owner,
        entry.popup,
        this.m_session,
        model,
        this.m_lastNativeSequence,
        entry.rejectedNative,
        this.m_nativePublished
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

