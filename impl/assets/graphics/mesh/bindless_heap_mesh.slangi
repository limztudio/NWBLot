////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_MESH_BINDLESS_HEAP_MESH_SLANGI
#define NWB_GRAPHICS_MESH_BINDLESS_HEAP_MESH_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../bindless/bindless_heap.slangi"
#include "meshlet_payload.slangi"
#include "material_typed_bindings.slangi"
#include "bindless_heap_mesh_view.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#pragma warning(push)
#pragma warning(disable: 39001)
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] StructuredBuffer<NwbMeshPosition, Std430DataLayout> g_NwbHeapMeshPositionBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] StructuredBuffer<NwbMeshHalf4, Std430DataLayout> g_NwbHeapMeshHalf4Buffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] StructuredBuffer<NwbMeshUv0, Std430DataLayout> g_NwbHeapMeshUv0Buffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] StructuredBuffer<NwbMeshletDesc, Std430DataLayout> g_NwbHeapMeshletDescBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] StructuredBuffer<NwbMeshletLocalVertexRef, Std430DataLayout> g_NwbHeapMeshletLocalVertexRefBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] StructuredBuffer<uint, Std430DataLayout> g_NwbHeapMeshMaterialTypedBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] StructuredBuffer<NwbMeshInstanceData, Std430DataLayout> g_NwbHeapMeshInstanceBuffers[];
#pragma warning(pop)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StructuredBuffer<NwbMeshPosition, Std430DataLayout> nwbHeapMeshPositions(const uint slot){
    return g_NwbHeapMeshPositionBuffers[NonUniformResourceIndex(slot)];
}

StructuredBuffer<NwbMeshHalf4, Std430DataLayout> nwbHeapMeshHalf4s(const uint slot){
    return g_NwbHeapMeshHalf4Buffers[NonUniformResourceIndex(slot)];
}

StructuredBuffer<NwbMeshUv0, Std430DataLayout> nwbHeapMeshUv0s(const uint slot){
    return g_NwbHeapMeshUv0Buffers[NonUniformResourceIndex(slot)];
}

StructuredBuffer<NwbMeshletDesc, Std430DataLayout> nwbHeapMeshletDescs(const uint slot){
    return g_NwbHeapMeshletDescBuffers[NonUniformResourceIndex(slot)];
}

StructuredBuffer<NwbMeshletLocalVertexRef, Std430DataLayout> nwbHeapMeshletLocalVertexRefs(const uint slot){
    return g_NwbHeapMeshletLocalVertexRefBuffers[NonUniformResourceIndex(slot)];
}

StructuredBuffer<uint, Std430DataLayout> nwbHeapMeshMaterialTypedWords(const uint slot){
    return g_NwbHeapMeshMaterialTypedBuffers[slot];
}

StructuredBuffer<NwbMeshInstanceData, Std430DataLayout> nwbHeapMeshInstances(const uint slot){
    return g_NwbHeapMeshInstanceBuffers[slot];
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

