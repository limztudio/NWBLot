const usize s_SoftBodyParallelThreshold = 64u;
const usize s_SoftBodyPredictVelThreshold = 1024u;

class SoftBodyCandShapeCache{
    public ShapeId shapeId;
    public Aabb3D aabb;
    public Transform3D worldXf;
    public Transform3D bodyXf;
