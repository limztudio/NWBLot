void VerifyCpuTaskCleanupTests_UnrelatedUnwindCancelsQueuedTasksWithoutReplacingTheOriginalFailure(){
    Atomic<u32> retirements(0u);
    u32 callbacks = 0u;
    u32 retiredOnCatch = 0u;
    i32 result = 0;
    result = InvokeTerminalEntry<TerminalTaskError>(lambda[mut retirements, mut callbacks]() -> i32{
        CpuTaskScheduler scheduler(0u);
        CpuTaskScope scope(scheduler);
        const auto cpuTaskAdmission = scheduler.submit(RetireAfterTask(LifetimeProbe(retirements, 0u), lambda[mut callbacks](mut LifetimeProbe probe, in b8 active) -> void{
            EXPECT_TRUE(active);
            ++callbacks;
            ThrowTestException<TerminalTaskError>(TerminalTaskError(53));
        }), MainThreadOptions());
        EXPECT_TRUE(cpuTaskAdmission.has_value());
        if(cpuTaskAdmission.has_value())
            EXPECT_TRUE(cpuTaskAdmission.value().valid());
        const auto secondCpuTaskAdmission = scope.submit(RetireAfterTask(LifetimeProbe(retirements, 0u), lambda[mut callbacks](mut LifetimeProbe probe, in b8 active) -> void{
            EXPECT_TRUE(active);
            ++callbacks;
            ThrowTestException<TerminalTaskError>(TerminalTaskError(59));
        }));
        EXPECT_TRUE(secondCpuTaskAdmission.has_value());
