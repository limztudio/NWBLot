[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if defined(NWB_COOK)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_texture/asset.adhd.h>

#include <core/alloc/scratch.h>
#include <core/metascript/parser.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct TextureCookEntry{
    Name virtualPath = s_NameNone;
    u32 width = 0u;
    u32 height = 0u;
    u32 depth = 1u;
    TextureDimension::Enum dimension = TextureDimension::Texture2D;
    TexturePayloadFormat::Enum payloadFormat = TexturePayloadFormat::UastcLdr4x4;
    TextureAlphaMode::Enum alphaMode = TextureAlphaMode::Opaque;
    u8 alphaConstantUnorm8 = TextureFormat::s_OpaqueAlphaUnorm8;
    Core::Assets::AssetBytes payloadBytes;


public:
    explicit TextureCookEntry(Core::Assets::AssetArena& arena)noexcept
        : payloadBytes(arena)
    {}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] Expected<TextureCookEntry> ParseTextureCookMetadata(Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<TextureCookEntry> ParseTextureCookMetadata(const Path& assetRoot, AStringView virtualRoot, const Path& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);

template<typename FileArenaT>
    requires (!IsSame_V<FileArenaT, Core::Alloc::GlobalArena>)
[[nodiscard]] FOUNDATION_INLINE Expected<TextureCookEntry> ParseTextureCookMetadata(const Name virtualPath, const ::Path<FileArenaT>& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    return ParseTextureCookMetadata(virtualPath, Path(arena, nwbFilePath), asset, arena, scratchArena);
}

template<typename RootArenaT, typename FileArenaT>
    requires (!IsSame_V<RootArenaT, Core::Alloc::GlobalArena> || !IsSame_V<FileArenaT, Core::Alloc::GlobalArena>)
[[nodiscard]] FOUNDATION_INLINE Expected<TextureCookEntry> ParseTextureCookMetadata(const ::Path<RootArenaT>& assetRoot, const AStringView virtualRoot, const ::Path<FileArenaT>& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    return ParseTextureCookMetadata(Path(arena, assetRoot), virtualRoot, Path(arena, nwbFilePath), doc, arena, scratchArena);
}
[[nodiscard]] Expected<Texture> BuildTextureAsset(const TextureCookEntry& textureEntry, Core::Assets::AssetArena& arena);
[[nodiscard]] Expected<Texture> BuildTextureAsset(TextureCookEntry&& textureEntry, Core::Assets::AssetArena& arena);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_TextureUnsupportedAlphaModeHint = "has unsupported alpha_mode";
const StringView s_TextureUnsupportedFormatHint = "has unsupported texture format";
const StringView s_TextureUnsupportedDimensionHint = "has unsupported texture dimension";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidTextureUnsignedFieldValue(in i64 rawValue, in u32 minimum, in u32 maximum){
    if(rawValue < 0)
        return false;
    const u64 unsignedValue = cast<u64>(rawValue);
    return unsignedValue >= cast<u64>(minimum) && unsignedValue <= cast<u64>(maximum);
}

usize ExpectedTextureResolutionComponentCount(in b8 isVolumeDimension){
    if(isVolumeDimension)
        return s_VolumeResolutionComponentCount;
    return s_PlanarResolutionComponentCount;
}

b8 IsPositiveTextureResolutionDimension(in i64 rawValue){
    return rawValue > 0 && cast<u64>(rawValue) <= cast<u64>(u32.max);
}

b8 IsValidCubeTextureResolution(in b8 isCubeDimension, in u32 width, in u32 height){
    return !isCubeDimension || width == height;
}

Expected<u32> ValidateTextureUnsignedField(
    in Path nwbFilePath,
    in StringView fieldName,
    in b8 present,
    in b8 isInteger,
    in i64 rawValue,
    in u32 minimum,
    in u32 maximum
){
    if(!present){
        error("{} '{}': field '{}' is required", s_TextureDiagnosticPrefix, PathToString(nwbFilePath), fieldName);
        return MakeUnexpected(Failure());
    }
    if(!isInteger || !IsValidTextureUnsignedFieldValue(rawValue, minimum, maximum)){
        error("{} '{}': field '{}' must be an integer in [{}, {}]", s_TextureDiagnosticPrefix, PathToString(nwbFilePath), fieldName, minimum, maximum);
        return MakeUnexpected(Failure());
    }
    return cast<u32>(rawValue);
}

b8 ValidateTextureResolutionListCount(in Path nwbFilePath, in b8 isList, in usize listSize, in usize expectedCount){
    if(isList && listSize == expectedCount)
        return true;

    error("{} '{}': resolution must contain exactly {} positive integer dimensions", s_TextureDiagnosticPrefix, PathToString(nwbFilePath), expectedCount);
    return false;
}

Expected<u32> ValidateTextureResolutionComponent(in Path nwbFilePath, in usize component, in b8 isInteger, in i64 rawValue){
    if(isInteger && IsPositiveTextureResolutionDimension(rawValue))
        return cast<u32>(rawValue);

    error("{} '{}': resolution component {} must be a positive u32 integer", s_TextureDiagnosticPrefix, PathToString(nwbFilePath), component);
    return MakeUnexpected(Failure());
}

b8 ValidateCubeTextureSquareResolution(in Path nwbFilePath, in b8 isCubeDimension, in u32 width, in u32 height){
    if(IsValidCubeTextureResolution(isCubeDimension, width, height))
        return true;

    error("{} '{}': cube resolution must be square", s_TextureDiagnosticPrefix, PathToString(nwbFilePath));
    return false;
}

b8 ValidateTextureCompleteMipChain(in Path nwbFilePath, in b8 hasCompleteMipCount){
    if(hasCompleteMipCount)
        return true;

    error("{} '{}': resolution cannot describe a complete mip chain", s_TextureDiagnosticPrefix, PathToString(nwbFilePath));
    return false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if defined(NWB_COOK)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_texture/texture_binary_codec.adhd.h>

#include <core/assets/binary_payload_io.h>
#include <core/assets/cook_metadata.h>
#include <core/common/log.h>

#include <global/binary.h>
#include <global/filesystem.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_texture_cook_metadata{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using Core::Metascript::Value;

static Core::Assets::AssetPairedSidecarRuleAutoRegistrar s_TexturePairedSidecarRegistrar(Core::Assets::AssetPairedSidecarRule{
    .sidecarExtension = TextureFormat::s_TextureDataExtension,
});


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] static Expected<u32> ReadUnsignedField(const Path& nwbFilePath, const Value& asset, const AStringView fieldName, const u32 minimum, const u32 maximum){
    const Value* const field = asset.findField(fieldName);
    const b8 present = field != nullptr;
    const b8 isInteger = present && field->isInteger();
    const i64 rawValue = isInteger ? field->asInteger() : 0;
    return ValidateTextureUnsignedField(nwbFilePath, fieldName, present, isInteger, rawValue, minimum, maximum);
}

[[nodiscard]] static Expected<TextureResolution> ReadResolution(const Path& nwbFilePath, const Value& asset, const TextureDimension::Enum dimension){
    const Value* const field = asset.findField(s_TextureResolutionField);
    const usize componentCount = ExpectedTextureResolutionComponentCount(dimension == TextureDimension::Texture3D);
    const b8 isList = field != nullptr && field->isList();
    const usize listSize = isList ? field->asList().size() : 0u;
    if(!ValidateTextureResolutionListCount(nwbFilePath, isList, listSize, componentCount))
        return MakeUnexpected(Failure{});
    Array<u32, s_VolumeResolutionComponentCount> dimensions{ 0u, 0u, 1u };
    for(usize component = 0u; component < componentCount; ++component){
        const Value& value = field->asList()[component];
        const b8 isInteger = value.isInteger();
        const Expected<u32> parsed = ValidateTextureResolutionComponent(nwbFilePath, component, isInteger, isInteger ? value.asInteger() : 0);
        if(!parsed)
            return MakeUnexpected(Failure{});
        dimensions[component] = *parsed;
    }
    if(!ValidateCubeTextureSquareResolution(nwbFilePath, dimension == TextureDimension::TextureCube, dimensions[0u], dimensions[1u]))
        return MakeUnexpected(Failure{});
    return TextureResolution(dimensions[0u], dimensions[1u], dimensions[2u]);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_texture_cook{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] static Expected<Texture::MipLevelVector> BuildMipLevels(const TextureCookEntry& entry, Core::Assets::AssetArena& arena){
    Texture::MipLevelVector levels(arena);
    if(!BuildTextureCookMipLevels(
        static_cast<u8>(entry.payloadFormat),
        static_cast<u8>(entry.dimension),
        entry.width,
        entry.height,
        entry.depth,
        static_cast<u8>(entry.alphaMode),
        entry.payloadBytes.size(),
        levels
    ))
        return MakeUnexpected(Failure{});
    return Move(levels);
}

[[nodiscard]] static Expected<Texture> FinalizeTextureAsset(
    const TextureCookEntry& textureEntry,
    Texture::MipLevelVector&& mipLevels,
    Core::Assets::AssetBytes&& payload,
    Core::Assets::AssetArena& arena
){
    Texture asset(arena, textureEntry.virtualPath);
    asset.setPayload(
        textureEntry.width,
        textureEntry.height,
        Move(mipLevels),
        Move(payload),
        textureEntry.dimension,
        textureEntry.depth,
        textureEntry.payloadFormat,
        textureEntry.alphaMode,
        textureEntry.alphaConstantUnorm8
    );
    if(!asset.validatePayload())
        return MakeUnexpected(Failure{});
    return asset;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<TextureCookEntry> ParseTextureCookMetadata(const Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    using namespace __hidden_texture_cook_metadata;

    if(!Core::Assets::CheckMetadataAssetMap(nwbFilePath, asset, s_TextureDiagnosticPrefix))
        return MakeUnexpected(Failure{});
    const auto alphaMode = Core::Assets::ParseNamedMetadataEnumField<TextureAlphaMode::Enum>(
        nwbFilePath,
        asset,
        s_TextureDiagnosticPrefix,
        s_TextureAlphaModeField,
        TextureFormat::s_AlphaModeCases,
        s_TextureUnsupportedAlphaModeHint
    );
    if(!alphaMode)
        return MakeUnexpected(Failure{});
    if(!Core::Assets::ValidateMetadataAssetFields(nwbFilePath, asset, s_TextureDiagnosticPrefix, [allowAlphaConstant = *alphaMode == TextureAlphaMode::ConstantUnorm8](const AStringView fieldName)noexcept{
        return IsAllowedTextureMetadataField(fieldName, allowAlphaConstant);
    }))
        return MakeUnexpected(Failure{});

    const auto format = Core::Assets::ParseNamedMetadataEnumField<TexturePayloadFormat::Enum>(
        nwbFilePath,
        asset,
        s_TextureDiagnosticPrefix,
        s_TextureFormatField,
        TextureFormat::s_PayloadFormatCases,
        s_TextureUnsupportedFormatHint
    );
    const auto dimension = Core::Assets::ParseNamedMetadataEnumField<TextureDimension::Enum>(
        nwbFilePath,
        asset,
        s_TextureDiagnosticPrefix,
        s_TextureDimensionField,
        TextureFormat::s_DimensionCases,
        s_TextureUnsupportedDimensionHint
    );
    if(!format || !dimension)
        return MakeUnexpected(Failure{});
    const auto resolution = ReadResolution(nwbFilePath, asset, *dimension);
    if(!resolution)
        return MakeUnexpected(Failure{});
    const auto completeMipCount = TextureFormat::ComputeCompleteMipCount(*dimension, resolution->width, resolution->height, resolution->depth);
    if(!ValidateTextureCompleteMipChain(nwbFilePath, completeMipCount.has_value()))
        return MakeUnexpected(Failure{});

    TextureCookEntry entry(arena);
    if(!Core::Assets::AssignCookEntryVirtualPath(virtualPath, nwbFilePath, s_TextureDiagnosticPrefix, entry))
        return MakeUnexpected(Failure{});
    entry.width = resolution->width;
    entry.height = resolution->height;
    entry.depth = resolution->depth;
    entry.dimension = *dimension;
    entry.payloadFormat = *format;
    entry.alphaMode = *alphaMode;
    if(entry.alphaMode == TextureAlphaMode::ConstantUnorm8){
        const auto constant = ReadUnsignedField(nwbFilePath, asset, s_TextureAlphaConstantField, 0u, TextureFormat::s_MaxConstantAlphaUnorm8);
        if(!constant)
            return MakeUnexpected(Failure{});
        entry.alphaConstantUnorm8 = static_cast<u8>(*constant);
    }

    ::Path<Core::Alloc::ScratchArena> dataPath(scratchArena, nwbFilePath);
    dataPath.replaceExtension(TextureFormat::s_TextureDataExtension);
    const auto readResult = ReadBinaryFile(dataPath, entry.payloadBytes);
    if(!readResult){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("{} '{}': failed to read raw texture sidecar '{}': {}"), ConvertString(s_TextureDiagnosticPrefix), PathToString<tchar>(nwbFilePath), PathToString<tchar>(dataPath), ConvertString(readResult.error().message()));
        return MakeUnexpected(Failure{});
    }
    return entry;
}

Expected<TextureCookEntry> ParseTextureCookMetadata(const Path& assetRoot, const AStringView virtualRoot, const Path& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    return Core::Assets::ParseCookMetadataDocument<TextureCookEntry, &ParseTextureCookMetadata>(assetRoot, virtualRoot, nwbFilePath, doc, s_TextureDiagnosticPrefix, arena, scratchArena);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 TextureAssetCodec::serialize(const Core::Assets::IAsset& asset, Core::Assets::AssetBytes& outBinary)const{
    if(!checkSerializeAssetType(asset, FOUNDATION_TEXT("TextureAssetCodec::serialize")))
        return false;

    const Texture& texture = static_cast<const Texture&>(asset);
    if(!texture.validatePayload())
        return false;

    return TextureBinaryCodec().serialize(
        static_cast<u8>(texture.dimension()),
        texture.width(),
        texture.height(),
        texture.depth(),
        static_cast<u8>(texture.alphaMode()),
        texture.alphaConstantUnorm8(),
        static_cast<u8>(texture.payloadFormat()),
        texture.mipLevels(),
        texture.payloadBytes(),
        outBinary
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<Texture> BuildTextureAsset(const TextureCookEntry& textureEntry, Core::Assets::AssetArena& arena){
    auto mipLevels = __hidden_texture_cook::BuildMipLevels(textureEntry, arena);
    if(!mipLevels)
        return MakeUnexpected(Failure{});
    Core::Assets::AssetBytes payload(textureEntry.payloadBytes.begin(), textureEntry.payloadBytes.end(), arena);
    return __hidden_texture_cook::FinalizeTextureAsset(textureEntry, Move(*mipLevels), Move(payload), arena);
}

Expected<Texture> BuildTextureAsset(TextureCookEntry&& textureEntry, Core::Assets::AssetArena& arena){
    auto mipLevels = __hidden_texture_cook::BuildMipLevels(textureEntry, arena);
    if(!mipLevels)
        return MakeUnexpected(Failure{});
    Core::Assets::AssetBytes payload = &textureEntry.payloadBytes.get_allocator().arena() == &arena
        ? Move(textureEntry.payloadBytes)
        : Core::Assets::AssetBytes(textureEntry.payloadBytes.begin(), textureEntry.payloadBytes.end(), arena);
    return __hidden_texture_cook::FinalizeTextureAsset(textureEntry, Move(*mipLevels), Move(payload), arena);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


