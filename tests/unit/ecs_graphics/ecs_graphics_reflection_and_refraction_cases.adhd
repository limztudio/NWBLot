inline constexpr usize s_ReflectionCounterWordCount = NWB_REFLECTION_COUNTER_SIZE / sizeof(u32);
inline constexpr usize s_RefractionCounterWordCount = NWB_REFRACTION_DIAGNOSTIC_COUNTER_SIZE / sizeof(u32);

using ReflectionCounterArray = Array<u32, s_ReflectionCounterWordCount>;
using RefractionCounterArray = Array<u32, s_RefractionCounterWordCount>;

[[nodiscard]] inline ReflectionCounterArray MakeSampleReflectionCounters()noexcept{
    constexpr ReflectionCounterArray s_Counters = {
        100u, 64u, 30u, 80u, 20u, 50u, 90u, 20u, 98u, 42u, 12u, 2u, 1u, 3u, 4u, 5u, 123u, 25u, 70u, 2u, 17u, 3u, 6u, 19u, 31u,
    };
    static_assert(sizeof(s_Counters) == NWB_REFLECTION_COUNTER_SIZE);
    return s_Counters;
}

[[nodiscard]] inline RefractionCounterArray MakeSampleRefractionCounters()noexcept{
    constexpr RefractionCounterArray s_Counters = {
        23u, 41u, 2u, 3u, 5u, 7u, 11u, 43u, 13u, 17u, 19u, 29u, 31u, 47u, 37u, 53u,
        59u, 61u, 67u, 71u, 73u, 79u, 83u, 89u, 97u, 101u, 103u, 107u, 1u,
    };
    return s_Counters;
}

inline void ExpectRefractionDiagnosticCountersMatch(const RefractionStatistics& statistics, const RefractionCounterArray& counters){
#define NWB_CHECK_REFRACTION_COUNTER(field, byteOffset) EXPECT_EQ(statistics.field, counters[(byteOffset) / NWB_REFRACTION_DIAGNOSTIC_WORD_BYTES]);
    NWB_REFRACTION_DIAGNOSTIC_COUNTER_FIELDS(NWB_CHECK_REFRACTION_COUNTER)
#undef NWB_CHECK_REFRACTION_COUNTER
}

struct ReflectionStatsContext{
    ReflectionStatisticsTestHelpers::StatisticsContext<ReflectionStatisticsControl> inner;


public:
    [[nodiscard]] b8 valid()const noexcept{ return static_cast<b8>(inner.control); }
    [[nodiscard]] auto reserve(const ReflectionStatistics& metadata){ return inner.control->reserve(metadata); }
    void discard(const StatisticsReservationKey& key){ inner.control->discard(key); }
    void accept(const StatisticsReservationKey& key, const Core::QueueSubmissionToken& token, const b8 hardwareReady){
        inner.control->accept(key, token, hardwareReady);
    }
    void acceptWithFeedback(const StatisticsReservationKey& key, const Core::QueueSubmissionToken& token, const b8 hardwareReady, const ReflectionFeedbackOutcome& feedback){
        inner.control->accept(key, token, hardwareReady, nullptr, &feedback);
    }
    void complete(const StatisticsReservationKey& key, const Core::QueueSubmissionToken& token, const Span<const u32> counters){
        inner.control->complete(key, token, counters);
    }
    void completeEmpty(const StatisticsReservationKey& key, const Core::QueueSubmissionToken& token){
        inner.control->complete(key, token, {});
    }
    void reset(const u16 generation){ inner.control->reset(generation); }
    [[nodiscard]] Expected<ReflectionStatistics> tryGetLatestStatistics(){ return inner.control->tryGetLatestStatistics(); }
    [[nodiscard]] auto pending(const u32 slot){ return inner.control->pending(slot); }
};

struct RefractionStatsContext{
    ReflectionStatisticsTestHelpers::StatisticsContext<RefractionStatisticsControl> inner;


public:
    [[nodiscard]] b8 valid()const noexcept{ return static_cast<b8>(inner.control); }
    [[nodiscard]] auto reserve(const RefractionStatistics& metadata){ return inner.control->reserve(metadata); }
    void discard(const StatisticsReservationKey& key){ inner.control->discard(key); }
    void accept(const StatisticsReservationKey& key, const Core::QueueSubmissionToken& token, const b8 hardwareReady){
        inner.control->accept(key, token, hardwareReady);
    }
    void complete(const StatisticsReservationKey& key, const Core::QueueSubmissionToken& token, const Span<const u32> counters){
        inner.control->complete(key, token, counters);
    }
    void completeEmpty(const StatisticsReservationKey& key, const Core::QueueSubmissionToken& token){
        inner.control->complete(key, token, {});
    }
    void reset(const u16 generation){ inner.control->reset(generation); }
    [[nodiscard]] Expected<RefractionStatistics> tryGetLatestStatistics(){ return inner.control->tryGetLatestStatistics(); }
    [[nodiscard]] auto pending(const u32 slot){ return inner.control->pending(slot); }
};

struct ReflectionFeedbackControlContext{
    ReflectionStatisticsTestHelpers::StatisticsContext<ReflectionFeedbackControl> inner;
    Core::GpuTaskGraph graph{ inner.arena };


public:
    [[nodiscard]] b8 valid()const noexcept{ return static_cast<b8>(inner.control); }
    [[nodiscard]] ReflectionFeedbackPlan plan(const ReflectionSceneContentStamp& stamp, const ReflectionSettings& settings, const b8 enabled, const u64 graphicsFrame){
        return inner.control->plan(stamp, settings, enabled, graphicsFrame);
    }
    [[nodiscard]] b8 reserve(const ReflectionFeedbackPlan& plan){ return inner.control->reserve(plan); }
    void discard(const ReflectionFeedbackPlan& plan){ inner.control->discard(plan); }
    [[nodiscard]] ReflectionFeedbackReservation makeReservation(const ReflectionFeedbackPlan& plan){
        return ReflectionFeedbackReservation(inner.control, plan);
    }
};

