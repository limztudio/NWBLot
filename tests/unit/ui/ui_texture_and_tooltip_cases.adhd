    ASSERT_TRUE(state.visible());
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 1u, 0u, true, 100.0f, options));
    EXPECT_FALSE(state.visible());
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 1u, 0u, true, 0.5f, options));
    EXPECT_TRUE(state.visible());
}

void VerifyUiTooltipBehaviorTests_ChangingDelayCannotMakePreviousElapsedTimeQualifyTheNewOptions(){
