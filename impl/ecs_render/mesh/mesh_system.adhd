#include <impl/ecs_render/mesh/renderer_mesh_state.adhd>
#include <impl/ecs_render/mesh/mesh_acceleration_state_policy.adhd>
#include <impl/ecs_render/mesh/mesh_raytracing_snapshot_policy.adhd>
#include <impl/ecs_render/shared/renderer_frame_bindings.adhd>
#include <impl/assets_mesh/asset.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type MeshSoftwareBvhParentBuildStateVector = Vector<MeshSoftwareBvhParentBuildState>;
type MeshRetainedAccelerationStateBufferVector = Vector<BufferHandle>;
type MeshBlasGraphStateVector = Vector<MeshBlasGraphState>;
type MeshRayTracingResourceSnapshotVector = Vector<MeshRayTracingResourceSnapshot>;


[modular]
class RendererMeshSystem : NoCopy{
    private mut World m_world;
    private mut GraphicsRuntime m_graphics;
    private mut AssetManager m_assetManager;
    private mut RendererMeshState m_meshState;

    public RendererMeshSystem(mut World world, mut GraphicsRuntime graphics, mut AssetManager assetManager, mut RendererMeshState meshState){
        this.m_world = world;
        this.m_graphics = graphics;
        this.m_assetManager = assetManager;
        this.m_meshState = meshState;
    }

    [owner_result]
    private MeshResources emptyMesh()const{
        return MeshResources();
    }

    public void invalidateMeshViewBufferUploadMirror(){
        this.m_meshState.m_meshViewGpuDataValid = false;
    }

    [cpp_unwind]
    public void invalidateResources();

    [cpp_unwind]
    public Expected<mut MeshResources> createMeshResources(in AssetRef<Mesh> meshAsset);

    public Expected<mut MeshResources> findMeshResources(in Name meshKey);

    [cpp_unwind]
    public Expected<mut MeshResources> createRuntimeMeshResources(in RuntimeMeshDesc desc);

    public Expected<mut MeshResources> findRuntimeMeshResources(in RuntimeMeshDesc desc);

    [cpp_unwind]
    public b8 prepareComputeEmulationResources(mut MeshResources mesh);

    [cpp_unwind]
    public b8 prepareObjectGeometryCache(mut MeshResources mesh, in ComputePipelineHandle decoderPipeline);

    public b8 confirmObjectGeometryCache(in Name meshKey, in RuntimeMeshBuffers sourceBuffers, in ObjectGeometryCacheSnapshot expected, in b8 runtimeMesh);

    [cpp_unwind]
    public void pruneRuntimeMeshResources();

    [cpp_unwind]
    public void collectRayTracingResourceSnapshots(mut MeshRayTracingResourceSnapshotVector outSnapshots)const{
        outSnapshots.clear();
        outSnapshots.reserve(this.m_meshState.m_meshes.size());
        for(in auto entry : this.m_meshState.m_meshes){
            auto snapshot = MeshRayTracingSnapshotPolicy().capture(entry.second);
            outSnapshots.push_back(snapshot);
        }
    }

    public Expected<MeshRayTracingResourceSnapshot> findRayTracingResourceSnapshot(in Name meshName)const;

    public Expected<MeshRayTracingResourceSnapshot> findRenderableRayTracingResourceSnapshot(in RenderableMeshDesc desc)const;

    [cpp_unwind]
    public b8 commitRayTracingResourceSnapshot(in MeshRayTracingResourceSnapshot expected, mut MeshRayTracingResourceSnapshot desired);

    [cpp_unwind]
    public Expected<MeshRayTracingResourceSnapshot> ensureRayTracingInputHeapHandles(in MeshRayTracingResourceSnapshot expected);

    public void discardRayTracingBuildState();

    [cpp_unwind]
    public Expected<MeshSoftwareBvhParentBuildStateVector> collectSoftwareBvhParentBuildStates()const;

    [cpp_unwind]
    public void collectRetainedAccelerationStateBuffers(mut MeshRetainedAccelerationStateBufferVector outBuffers)const{
        outBuffers.clear();
        outBuffers.reserve(this.m_meshState.m_meshes.size() * s_RetainedAccelerationBuffersPerMesh);
        for(in auto entry : this.m_meshState.m_meshes){
            in MeshResources mesh = entry.second;
            // Retain every live BLAS source and backing buffer across preparation packets.
            if(mesh.blas.valid()){
                outBuffers.push_back(mesh.buffers.positionBuffer);
                outBuffers.push_back(mesh.triangleIndexBuffer);
                outBuffers.push_back(mesh.blas.deref().getBackingBufferHandle());
            }
            // Preserve mesh-local software buffers across tracing-backend changes.
            outBuffers.push_back(mesh.swBvhNodeBuffer);
            outBuffers.push_back(mesh.swBvhParentBuffer);
        }
    }

    [cpp_unwind]
    public void collectBlasGraphStates(mut MeshBlasGraphStateVector outStates)const{
        outStates.clear();
        outStates.reserve(this.m_meshState.m_meshes.size());
        for(in auto entry : this.m_meshState.m_meshes){
            in MeshResources mesh = entry.second;
            if(!mesh.blas.valid())
                continue;
            // This predicate consumes only build/revision state; the graph output below retains the BLAS.
            const b8 nativeBuildsBlas = MeshAccelerationStatePolicy().requiresBlasUpdate(mesh.blasBuildPending, mesh.blasBuildAccepted, mesh.runtimeMesh, mesh.runtimeGeometryContentRevision, mesh.blasGeometryContentRevision);
            outStates.push_back(MeshBlasGraphState(mesh.meshName, mesh.blas, mesh.blasBackingFresh, nativeBuildsBlas));
        }
    }

    [cpp_unwind]
    public b8 createMeshViewBuffer();

    public MeshViewBufferSnapshot meshViewBufferSnapshot()const;

    public Expected<f32x4x4> snapshotAcceptedMeshViewWorldToClip()const;

    public MeshViewBufferUpload prepareMeshViewBufferUpload(in f32 fallbackAspectRatio)const;

    public void confirmMeshViewBufferUpload(in MeshViewGpuData viewState);

    [cpp_unwind]
    public b8 prepareMeshFrameBindings(in MaterialPassBufferSnapshot materialBuffers);

    public MeshFrameBindingSnapshot meshFrameBindingSnapshot()const;

    public void populateMeshGeometryHeapSlots(in MeshResources mesh, mut InstanceGpuData outInstance)const;

    [cpp_unwind]
    public void releaseMeshGeometryHeapHandles(mut MeshResources mesh);

    [cpp_unwind]
    private void releaseMeshFrameHeapHandles();

    [cpp_unwind]
    private b8 createMeshRenderBindings(mut MeshResources mesh);

    private b8 meshRenderBindingsReady(in MeshResources mesh)const;

    [cpp_unwind]
    private b8 createMeshGeometryHeapHandles(mut MeshResources mesh);

    [cpp_unwind]
    private b8 ensureMeshSwBvhInputHeapHandles(mut MeshResources mesh);

    [cpp_unwind]
    private void releaseAllMeshGeometryHeapHandles();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

