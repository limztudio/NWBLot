    b8 isDrawIndirectArgs;
    b8 isAccelStructBuildInput;
    b8 isAccelStructStorage;
    b8 isShaderBindingTable;
    b8 isVolatile;
    b8 isVirtual;
    b8 keepInitialState;
    BufferDesc enableAutomaticStateTracking(...);
    BufferDesc setByteSize(...);
    BufferDesc setCanHaveRawViews(...);
    BufferDesc setCanHaveUAVs(...);
    BufferDesc setCpuAccess(...);
    BufferDesc setDebugName(...);
    BufferDesc setFormat(...);
    BufferDesc setInitialState(...);
    BufferDesc setIsAccelStructBuildInput(...);
    BufferDesc setIsConstantBuffer(...);
    BufferDesc setIsDrawIndirectArgs(...);
    BufferDesc setIsIndexBuffer(...);
    BufferDesc setIsVertexBuffer(...);
    BufferDesc setKeepInitialState(...);
    BufferDesc setQueueSharing(...);
    BufferDesc setStructStride(...);
};

