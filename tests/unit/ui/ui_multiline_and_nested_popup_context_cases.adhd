void VerifyUiMultilineViewTests_SnapshotOwnsMultilineModeTextAndCrossLineSelection(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("ab\ncd"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 4u));
    ASSERT_TRUE(self.shapeView());
    EXPECT_EQ(self.m_view.displayText(), "ab\ncd");
    EXPECT_EQ(self.m_view.selectionRange().begin, 1u);
    EXPECT_EQ(self.m_view.selectionRange().end, 4u);
    EXPECT_EQ(self.m_view.displayCaret(), 4u);
    const u64 revision = self.m_view.revision();
    ASSERT_TRUE(self.m_model.setText("replacement\ntext"));
    EXPECT_EQ(self.m_view.displayText(), "ab\ncd");
    EXPECT_EQ(self.m_view.layout().utf8(), "ab\ncd");
    EXPECT_EQ(self.m_view.revision(), revision);
    EXPECT_EQ(self.m_view.selectionRange().begin, 1u);
    EXPECT_EQ(self.m_view.selectionRange().end, 4u);
    ASSERT_TRUE(self.place());
    ExpectUiRect(self.m_placement.caret, MakeUiMultilinePopupRect(20.0f, 32.0f, 1.0f, 12.0f));
}

void VerifyUiMultilineViewTests_NewSnapshotRequiresMatchingLayoutBeforePlacementOrHits(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("old\nview"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    const EditBoxPlacement previous = self.m_placement;
    ASSERT_TRUE(self.m_model.setText("new\ncontent\n"));
    ASSERT_TRUE(self.m_view.snapshot(self.m_model));
    EXPECT_FALSE(self.m_view.ready());
    EXPECT_FALSE(self.place());
    ExpectUiMultilineViewPlacement(self.m_placement, previous);
    EXPECT_FALSE(self.m_view.hitTest(MakeUiMultilinePopupPoint(10.0f, 20.0f), previous).has_value());
    auto layout = self.buildLayout(self.m_view.displayText());
    ASSERT_TRUE(layout.has_value());
    ASSERT_TRUE(self.adoptBuiltLayout(layout));
    EXPECT_TRUE(self.m_view.ready());
    ASSERT_TRUE(self.place());
    EXPECT_EQ(self.m_view.layout().lines().size(), 3u);
}

void VerifyUiMultilineViewTests_EmptyAndTrailingHardLinesKeepDistinctCaretRows(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("ab\n\ncd\n"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_EQ(self.m_view.layout().lines().size(), 4u);
    ASSERT_EQ(self.m_view.caretGeometry().lines().size(), 4u);
    EXPECT_EQ(self.m_view.caretStops().size(), 8u);
    EXPECT_EQ(self.m_view.caretGeometry().lines()[1u].byteBegin, 3u);
    EXPECT_EQ(self.m_view.caretGeometry().lines()[1u].byteEnd, 3u);
    EXPECT_EQ(self.m_view.caretGeometry().lines()[3u].byteBegin, 7u);
    EXPECT_FLOAT_EQ(self.m_view.layout().measure().y, 48.0f);
    ASSERT_TRUE(self.place());
    ExpectUiRect(self.m_placement.caret, MakeUiMultilinePopupRect(10.0f, 56.0f, 1.0f, 12.0f));
    EXPECT_FLOAT_EQ(self.m_placement.textOrigin.y, 20.0f);
    ASSERT_TRUE(self.m_model.setText(""));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    ASSERT_EQ(self.m_view.caretStops().size(), 1u);
    ASSERT_EQ(self.m_view.caretGeometry().lines().size(), 1u);
    ExpectUiRect(self.m_placement.caret, MakeUiMultilinePopupRect(10.0f, 20.0f, 1.0f, 12.0f));
}

void VerifyUiMultilineViewTests_HitTestingUsesYAndClampsOutsideTheFirstAndLastLine(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("ab\ncd\n"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    Expected<usize> hit = self.m_view.hitTest(MakeUiMultilinePopupPoint(21.0f, 26.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 1u);
    hit = self.m_view.hitTest(MakeUiMultilinePopupPoint(21.0f, 50.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 6u);
    hit = self.m_view.hitTest(MakeUiMultilinePopupPoint(21.0f, -100.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 1u);
    hit = self.m_view.hitTest(MakeUiMultilinePopupPoint(100.0f, 400.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 6u);
}

void VerifyUiMultilineViewTests_LigatureStopsRetainTheirHardLineAndCommittedOffsets(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("ffi\nffi"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 6u));
    ASSERT_TRUE(self.shapeView());
    ASSERT_EQ(self.m_view.layout().clusters().size(), 2u);
    ASSERT_EQ(self.m_view.caretStops().size(), 8u);
    EXPECT_EQ(self.m_view.caretStops()[1u].lineIndex, 0u);
    EXPECT_FLOAT_EQ(self.m_view.caretStops()[1u].x, 10.0f);
    EXPECT_EQ(self.m_view.caretStops()[5u].lineIndex, 1u);
    EXPECT_EQ(self.m_view.caretStops()[5u].committedByte, 5u);
    EXPECT_FLOAT_EQ(self.m_view.caretStops()[5u].x, 10.0f);
    ASSERT_TRUE(self.place());
    ExpectUiRect(self.m_placement.caret, MakeUiMultilinePopupRect(30.0f, 32.0f, 1.0f, 12.0f));
    const Expected<usize> hit = self.m_view.hitTest(MakeUiMultilinePopupPoint(21.0f, 38.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 5u);
}

void VerifyUiMultilineViewTests_CrossLinePreeditKeepsNativeScalarCaretInsideItsGrapheme(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("A\nB\nC"));
    ASSERT_TRUE(self.m_model.setSelection(2u, 3u));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("x\n\xe1\x84\x92\xe1\x85\xa1\xe1\x86\xab", 0u, 5u));
    ASSERT_TRUE(self.shapeView());
    EXPECT_EQ(self.m_model.text(), "A\nB\nC");
    EXPECT_EQ(self.m_view.displayText(), "A\nx\n\xe1\x84\x92\xe1\x85\xa1\xe1\x86\xab\nC");
    EXPECT_EQ(self.m_view.replacementRange().begin, 2u);
    EXPECT_EQ(self.m_view.replacementRange().end, 3u);
    EXPECT_EQ(self.m_view.preeditRange().begin, 2u);
    EXPECT_EQ(self.m_view.preeditRange().end, 13u);
    EXPECT_EQ(self.m_view.selectionRange().begin, 2u);
    EXPECT_EQ(self.m_view.selectionRange().end, 7u);
    EXPECT_EQ(self.m_view.displayCaret(), 7u);
    ASSERT_TRUE(self.place());
    ExpectUiRect(self.m_placement.caret, MakeUiMultilinePopupRect(14.0f, 44.0f, 1.0f, 12.0f));
    const Expected<usize> hit = self.m_view.hitTest(MakeUiMultilinePopupPoint(20.0f, 62.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 5u);
    self.m_model.cancelComposition();
    ASSERT_TRUE(self.m_model.setText("changed"));
    EXPECT_TRUE(self.m_view.composing());
    EXPECT_EQ(self.m_view.displayCaret(), 7u);
    ASSERT_TRUE(self.place());
    ExpectUiRect(self.m_placement.caret, MakeUiMultilinePopupRect(14.0f, 44.0f, 1.0f, 12.0f));
}

void VerifyUiMultilineViewTests_BothScrollAxesRevealCaretAndClampAfterDocumentHomeOrShrink(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("abcde\nabcdef\nabcdefg"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place(20.0f, 12.0f));
    EXPECT_FLOAT_EQ(self.m_placement.scroll, 51.0f);
    EXPECT_FLOAT_EQ(self.m_placement.scrollY, 24.0f);
    ExpectUiRect(self.m_placement.caret, MakeUiMultilinePopupRect(29.0f, 20.0f, 1.0f, 12.0f));
    const Expected<usize> hit = self.m_view.hitTest(MakeUiMultilinePopupPoint(self.m_placement.caret.x, self.m_placement.caret.y + 6.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), self.m_model.caret());
    const Point previous = MakeUiMultilinePopupPoint(self.m_placement.scroll, self.m_placement.scrollY);
    ASSERT_TRUE(self.m_model.move(EditMove::DocumentHome));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place(20.0f, 12.0f, previous));
    EXPECT_FLOAT_EQ(self.m_placement.scroll, 0.0f);
    EXPECT_FLOAT_EQ(self.m_placement.scrollY, 0.0f);
    ASSERT_TRUE(self.m_model.setText("A"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place(20.0f, 12.0f, previous));
    EXPECT_FLOAT_EQ(self.m_placement.scroll, 0.0f);
    EXPECT_FLOAT_EQ(self.m_placement.scrollY, 0.0f);
}

void VerifyUiMultilineViewTests_PaddingAndOuterClipIntersectWithoutChangingLogicalLineGeometry(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("ab\ncd"));
    ASSERT_TRUE(self.shapeView());
    const auto arranged = self.m_view.arrange(
        MakeUiMultilinePopupRect(10.0f, 20.0f, 100.0f, 40.0f),
        MakeUiMultilineViewInsets(8.0f, 4.0f, 8.0f, 4.0f),
        MakeUiMultilinePopupRect(30.0f, 22.0f, 20.0f, 40.0f),
        Point()
    );
    ASSERT_TRUE(arranged.has_value());
    self.m_placement = arranged.value();
    ExpectUiRect(self.m_placement.frameClip, MakeUiMultilinePopupRect(30.0f, 22.0f, 20.0f, 38.0f));
    ExpectUiRect(self.m_placement.clip, MakeUiMultilinePopupRect(30.0f, 24.0f, 20.0f, 32.0f));
    ExpectUiRect(self.m_placement.caret, MakeUiMultilinePopupRect(38.0f, 36.0f, 1.0f, 12.0f));
    EXPECT_FLOAT_EQ(self.m_view.caretGeometry().lines()[1u].top, 12.0f);
}

void VerifyUiMultilineViewTests_ZeroViewportKeepsFiniteCaretAndScrollAndProducesAnEmptyClip(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("abcde\nabcdef\nabcdefg"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place(0.0f, 0.0f, MakeUiMultilinePopupPoint(500.0f, 500.0f)));
    EXPECT_FLOAT_EQ(self.m_placement.clip.width, 0.0f);
    EXPECT_FLOAT_EQ(self.m_placement.clip.height, 0.0f);
    EXPECT_FLOAT_EQ(self.m_placement.scroll, 71.0f);
    EXPECT_FLOAT_EQ(self.m_placement.scrollY, 36.0f);
    const VectorSingle caretEnd = VectorSingle(self.m_placement.caret.x, self.m_placement.caret.y, 0.0f, 0.0f) + VectorSingle(self.m_placement.caret.width, self.m_placement.caret.height, 0.0f, 0.0f);
    EXPECT_FLOAT_EQ(caretEnd.x, self.m_placement.content.x);
    EXPECT_FLOAT_EQ(caretEnd.y, self.m_placement.content.y);
}

void VerifyUiMultilineViewTests_FailedPlacementPreservesStateAndInvalidHitsAreRejected(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("abc\ndef"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place(20.0f, 12.0f));
    const EditBoxPlacement previous = self.m_placement;
    const f32 nan = UiMultilineViewQuietNaN();
    EXPECT_FALSE(self.place(20.0f, 12.0f, MakeUiMultilinePopupPoint(0.0f, nan)));
    ExpectUiMultilineViewPlacement(self.m_placement, previous);
    EXPECT_FALSE(self.place(20.0f, 12.0f, MakeUiMultilinePopupPoint(0.0f, -1.0f)));
    ExpectUiMultilineViewPlacement(self.m_placement, previous);
    EXPECT_FALSE(self.m_view.arrange(MakeUiMultilinePopupRect(10.0f, 20.0f, -1.0f, 20.0f), Insets(), Rect(), Point()).has_value());
    ExpectUiMultilineViewPlacement(self.m_placement, previous);
    EXPECT_FALSE(self.m_view.arrange(previous.bounds, MakeUiMultilineViewInsets(0.0f, -1.0f, 0.0f, 0.0f), previous.clip, Point()).has_value());
    ExpectUiMultilineViewPlacement(self.m_placement, previous);
    EXPECT_FALSE(self.m_view.arrange(previous.bounds, Insets(), previous.clip, Point(), 0.0f).has_value());
    ExpectUiMultilineViewPlacement(self.m_placement, previous);
    EXPECT_FALSE(self.m_view.hitTest(MakeUiMultilinePopupPoint(10.0f, nan), previous).has_value());
    EditBoxPlacement malformed = previous;
    malformed.textOrigin.y = nan;
    EXPECT_FALSE(self.m_view.hitTest(MakeUiMultilinePopupPoint(10.0f, 20.0f), malformed).has_value());
}

void VerifyUiMultilineViewTests_FailedLayoutAdoptionRetainsMultilineGeometryAndPlacement(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("ab\ncd"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    const EditBoxPlacement previous = self.m_placement;
    auto wrong = self.buildLayout("other\ntext");
    ASSERT_TRUE(wrong.has_value());
    EXPECT_FALSE(self.adoptBuiltLayout(wrong));
    auto rtl = self.buildDirectionalLayout(self.m_view.displayText(), TextDirection::RightToLeft);
    ASSERT_TRUE(rtl.has_value());
    EXPECT_FALSE(self.adoptBuiltLayout(rtl));
    EXPECT_EQ(self.m_view.layout().utf8(), "ab\ncd");
    EXPECT_EQ(self.m_view.caretGeometry().lines().size(), 2u);
    EXPECT_TRUE(self.m_view.ready());
    ASSERT_TRUE(self.place());
    ExpectUiMultilineViewPlacement(self.m_placement, previous);
    EXPECT_NE(self.m_view.shape(self.m_text), TextLayoutStatus::Success);
    ASSERT_TRUE(self.place());
    ExpectUiMultilineViewPlacement(self.m_placement, previous);
}

void VerifyUiMultilineViewTests_MovingTheViewRetainsOwnedPreeditLineMappingsAndReadyGeometry(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("ab\ncd"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 4u));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("x\ny", 0u, 3u));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    const EditBoxPlacement previous = self.m_placement;
    EditBoxView assigned = EditBoxView(self.m_arena);
    native(mut view = self.m_view, mut assigned){
        EditBoxView moved = ::Move(view);
        assigned = ::Move(moved);
    }
    self.m_model.cancelComposition();
    ASSERT_TRUE(self.m_model.setText("replacement"));
    EXPECT_EQ(assigned.displayText(), "ax\nyd");
    EXPECT_EQ(assigned.layout().utf8(), "ax\nyd");
    EXPECT_TRUE(assigned.composing());
    EXPECT_TRUE(assigned.ready());
    const auto arranged = assigned.arrange(previous.bounds, Insets(), previous.clip, Point());
    ASSERT_TRUE(arranged.has_value());
    self.m_placement = arranged.value();
    ExpectUiMultilineViewPlacement(self.m_placement, previous);
    const Expected<usize> hit = assigned.hitTest(MakeUiMultilinePopupPoint(30.0f, 38.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 5u);
}

void VerifyUiMultilineViewTests_PaintOwnsSelectionSegmentsIncludingAnEmptySelectedHardLine(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.loadFont());
    ASSERT_TRUE(self.m_model.setText("ab\n\ncd\n"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 6u));
    ASSERT_TRUE(self.m_view.snapshot(self.m_model));
    ASSERT_EQ(self.m_view.shape(self.m_text), TextLayoutStatus::Success);
    ASSERT_TRUE(self.place(300.0f, 200.0f));
    ASSERT_TRUE(self.m_model.setText("changed"));
    EditBoxStyle style = EditBoxStyle();
    style.selection = MakeUiMultilineViewColor(1.0f, 0.0f, 0.0f, 1.0f);
    EditBoxPaintFlags flags = EditBoxPaintFlags();
    flags.focused = true;
    flags.caretVisible = false;
    const auto snapshot = self.paintView(style, flags);
    ASSERT_TRUE(snapshot.has_value());
    UiMultilineViewRectVector selected = UiMultilineViewRectVector(self.m_arena);
    CollectUiMultilineViewSolidRects(snapshot.value(), style.selection, selected);
    ASSERT_EQ(selected.size(), 3u);
    for(u32 line = 0u; line < 3u; ++line){
        EXPECT_FLOAT_EQ(selected[line].y, self.m_placement.textOrigin.y + self.m_view.caretGeometry().lines()[line].top);
        EXPECT_FLOAT_EQ(selected[line].height, self.m_view.caretGeometry().lines()[line].height);
    }
    EXPECT_FLOAT_EQ(selected[1u].x, self.m_placement.textOrigin.x);
    EXPECT_FLOAT_EQ(selected[1u].width, 1.0f);
    EXPECT_FLOAT_EQ(selected[2u].width, self.m_view.caretGeometry().lines()[2u].advance);
    EXPECT_FALSE(snapshot.value().glyphPages().empty());
    EXPECT_EQ(self.m_view.layout().utf8(), "ab\n\ncd\n");
}

void VerifyUiMultilineViewTests_PaintOwnsPreeditUnderlinesIncludingAnEmptyHardLine(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.loadFont());
    ASSERT_TRUE(self.m_model.setText("A\nB\nC"));
    ASSERT_TRUE(self.m_model.setSelection(2u, 3u));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("x\n\nz", 0u, 4u));
    ASSERT_TRUE(self.m_view.snapshot(self.m_model));
    ASSERT_EQ(self.m_view.shape(self.m_text), TextLayoutStatus::Success);
    ASSERT_TRUE(self.place(300.0f, 200.0f));
    self.m_model.cancelComposition();
    ASSERT_TRUE(self.m_model.setText("changed"));
    EditBoxStyle style = EditBoxStyle();
    style.preedit = MakeUiMultilineViewColor(0.0f, 1.0f, 0.0f, 1.0f);
    EditBoxPaintFlags flags = EditBoxPaintFlags();
    flags.focused = true;
    flags.caretVisible = false;
    flags.preeditCaretVisible = false;
    const auto snapshot = self.paintView(style, flags);
    ASSERT_TRUE(snapshot.has_value());
    UiMultilineViewRectVector underlines = UiMultilineViewRectVector(self.m_arena);
    CollectUiMultilineViewSolidRects(snapshot.value(), style.preedit, underlines);
    ASSERT_EQ(underlines.size(), 3u);
    for(u32 index = 0u; index < 3u; ++index){
        const EditCaretLine line = self.m_view.caretGeometry().lines()[index + 1u];
        EXPECT_FLOAT_EQ(underlines[index].y, self.m_placement.textOrigin.y + line.top + line.height - 1.0f);
        EXPECT_FLOAT_EQ(underlines[index].height, 1.0f);
    }
    EXPECT_FLOAT_EQ(underlines[1u].width, 1.0f);
}

void VerifyUiMultilineViewTests_SingleLineCenteringRejectsVerticalScrollInfluence(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("abc\ndef"));
    ASSERT_TRUE(self.shapeView());
    EditModel single = EditModel(self.m_arena);
    ASSERT_TRUE(single.setText("abc"));
    ASSERT_TRUE(self.m_view.snapshot(single));
    auto layout = self.buildLayout(self.m_view.displayText());
    ASSERT_TRUE(layout.has_value());
    ASSERT_TRUE(self.adoptBuiltLayout(layout));
    ASSERT_TRUE(self.place(100.0f, 40.0f, MakeUiMultilinePopupPoint(0.0f, 20.0f)));
