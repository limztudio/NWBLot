class GpuPacketWaitStatisticsValue{
    public usize plannedWaitTokenCount = 0u;
    public usize sameQueueWaitElisionCount = 0u;
    public usize timelineWaitCount = 0u;
    public usize mergedTimelineWaitCount = 0u;
}


class GpuPacketRecordingIntervalEntry{
    public u64 beginNanoseconds = 0u;
    public u64 endNanoseconds = 0u;
    public u32 packetIndex = 0u;
}


class GpuNativeSubmissionInfo{
    public usize commandListCount = 0u;
    public usize plannedWaitTokenCount = 0u;
    public usize sameQueueWaitElisionCount = 0u;
    public usize timelineWaitCount = 0u;
    public usize mergedTimelineWaitCount = 0u;
    public usize inheritedTimelineWaitElisionCount = 0u;
    public f64 submissionSeconds = 0.0;
}


