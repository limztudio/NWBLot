    public ShadowGpuTaskId transparentTemporalMerge = ShadowGpuTaskId();
    public ShadowGpuTaskId transparentFirstWavelet = ShadowGpuTaskId();
    public ShadowGpuTaskId diagnostics = ShadowGpuTaskId();
    public b8 combinedUpsample = false;
    public b8 combinedWavelet = false;
    public b8 combinedTemporal = false;
}

class ShadowVisibilityMergeValidationResult{
    public b8 preparedTasksMerged = false;
    public b8 allLitClearMerged = false;
    public b8 adaptivePrimitivesMerged = false;
}

// Only accepted static scene/light identities can authorize a reduced per-pixel sampling budget.
class SoftwareTransparentSamplingHistory{
    public void prepareScene(in RayTracingSceneContentStamp scene){
        this.m_scene = scene;
        this.m_lightingPrepared = false;
    }

    public void prepareLighting(in Span<SceneLightGpuData> lights){
        SceneShadingGpuData shading;
        this.m_lightHash = ComputeSceneLightingContentHash(shading, lights);
        this.m_lightingPrepared = true;
    }

    public void accept(){
        this.m_acceptedScene = this.m_scene;
        this.m_acceptedLightHash = this.m_lightHash;
        this.m_accepted = this.m_scene.trusted && this.m_lightingPrepared;
    }

    public void discard(){
        this.m_accepted = false;
    }

    public b8 usable()const{
        return
            this.m_accepted
            && this.m_lightingPrepared
            && this.m_scene.trusted
            && this.m_acceptedScene.trusted
            && this.m_scene.geometry == this.m_acceptedScene.geometry
            && this.m_scene.material == this.m_acceptedScene.material
            && this.m_lightHash == this.m_acceptedLightHash
        ;
    }

    private RayTracingSceneContentStamp m_scene;
    private RayTracingSceneContentStamp m_acceptedScene;
    private u64 m_lightHash = 0u;
    private u64 m_acceptedLightHash = 0u;
    private b8 m_lightingPrepared = false;
    private b8 m_accepted = false;
}

class GraphOwnedAdaptiveShadowPlan{
    public b8 enabled = false;
    public b8 compact = false;
}

class ShadowPreparationOutcome{
    public b8 resourcesValid = false;
    public b8 ready = false;
}

class ShadowTraceBufferRecord{
    public ShadowTraceBufferRecord(){
        this.firstMesh[0u] = usize.max;
        this.firstMesh[1u] = usize.max;
        this.firstMesh[2u] = usize.max;
        this.firstMesh[3u] = usize.max;
        this.preparedIndex = usize.max;
        this.accepted = false;
    }

    public Array<usize, 4u> firstMesh;
    public usize preparedIndex;
    public b8 accepted;
}


void ResetSoftShadowTemporalHistoryState(
    mut b8 outSoftShadowTemporalSeeded,
    mut b8 outSoftShadowTemporalHistoryAdvancePending,
    mut b8 outPrevWorldToClipValid,
    mut u32 outSoftShadowHistoryFrontIsA
){
    outSoftShadowTemporalSeeded = false;
    outSoftShadowTemporalHistoryAdvancePending = false;
    outPrevWorldToClipValid = false;
    outSoftShadowHistoryFrontIsA = 1u;
}

ShadowGpuTaskId SelectOpaqueShadowCompletion(in b8 combinedTemporal, in b8 combinedUpsample, in ShadowGpuTaskId opaque, in ShadowGpuTaskId firstWavelet, in ShadowGpuTaskId resolve){
    if(combinedTemporal)
        return opaque;
    if(combinedUpsample)
        return firstWavelet;
    return resolve;
}

Expected<u32> TryResolveShadowEdgeListCapacityRecords(in u32 width, in u32 height){
    const u64 edgeListCapacity = cast<u64>(width) * cast<u64>(height);
    if(edgeListCapacity > cast<u64>(u32.max)){
        error("RendererSystem: shadow edge-list capacity exceeds u32 limits");
        return MakeUnexpected(Failure());
    }
    return cast<u32>(edgeListCapacity);
}


class OpaqueSoftShadowResolveOptions{
    public b8 frontIsA = false;
    public b8 temporalActive = false;
    public b8 graphOwnsGeometryEntry = false;
    public b8 graphOwnsTraceToFirstWavelet = false;
    public b8 dispatchResolve = false;
    public b8 dispatchResolveTail = false;
    public SoftShadowOpaqueResolvePhase phase = SoftShadowOpaqueResolvePhase::TemporalAndWavelet;
}


class TransparentSoftShadowResolveOptions{
    public b8 frontIsA = false;
    public b8 temporalActive = false;
    public b8 dispatchResolve = false;
    public b8 dispatchResolveTail = false;
    public b8 splitResolve = false;
    public b8 dispatchTemporalMerge = false;
    public b8 graphOwnsTraceToResolve = false;
}


