    private b8 evalOverlapShapeCollectCandidate(
        in u32 shapeIdx,
        in ShapeProxyView queryViewRef,
        in VectorSingle queryPos,
        in VectorSingle queryRot,
        in Filter filterRef,
        in b8 hitSensors,
        in BodyId ignoreBodyId,
        in ShapeId ignoreShapeId,
        in b8 useCustomFilter,
        in Optional<ShapeQueryFilterCallback> queryFilter,
        in SphereShape qSphereRef,
        in CapsuleShape qCapRef,
        in OverlapCollectorCallback collectorRef,
        mut u8 queryKind,
        mut b8 queryHullAttempted,
        mut HullShape queryHull,
        mut b8 stopped
    )const{
        if(stopped)
            return false;
        ShapeOverlapHit singleHit;
        b8 hasHit = false;
        this.evalOverlapShapeSingleCandidate(shapeIdx, queryViewRef, queryPos, queryRot, filterRef, hitSensors, ignoreBodyId, ignoreShapeId, useCustomFilter, queryFilter, qSphereRef, qCapRef, queryKind, queryHullAttempted, queryHull, singleHit, hasHit);
        if(hasHit){
            if(!collectorRef(singleHit)){
                stopped = true;
                return false;
            }
        }
        return true;
    }

    private void overlapShapeCollectImpl(
        in ShapeProxyView queryView,
        in Transform3D queryTransform,
        in Filter filter,
        in b8 hitSensors,
        in BodyId ignoreBodyId,
        in ShapeId ignoreShapeId,
        in b8 useCustomFilter,
        in Optional<ShapeQueryFilterCallback> queryFilter,
        in OverlapCollectorCallback collector
    )const{
        const VectorSingle queryPos(queryTransform.position);
        const VectorSingle rawQueryRot(queryTransform.rotation);
        if(!this.validateShapeQueryProxyView(queryView) || !IsValidPositionVec3(queryPos) || !IsFinite(rawQueryRot))
            return;

        const VectorSingle queryRot = SafeNormalizeQuat(rawQueryRot);
        VectorSingle qMin(0.0f);
        VectorSingle qMax(0.0f);
        ComputeShapeProxyViewWorldAabbValues(queryView, queryPos, queryRot, 0.0f, qMin, qMax);
        const Aabb3D queryBox(qMin, qMax);

        const u32 queryMask = this.broadPhaseQueryMask(filter);
        if(queryMask == 0u)
            return;
        u8 reqNodeFlags = s_TreeNodeHasNonSensor;
        if(hitSensors)
            reqNodeFlags = 0u;

        SphereShape querySphere;
        CapsuleShape queryCapsule;
        HullShape queryHull;
        u8 queryKind = 0u;
        b8 queryHullAttempted = false;
        if(queryView.kind == ProxyKind::PointCloud && queryView.scaleMinMargin.w < 0.0f){
            if(queryView.points.size() == 1u){
                queryKind = 1u;
                querySphere.centerRadius = f32x4(VectorSingle(queryView.points[0u], 0.0f), queryView.radius);
            }
            else if(queryView.points.size() == 2u){
                queryKind = 2u;
                queryCapsule.center1Radius = f32x4(VectorSingle(queryView.points[0u], 0.0f), queryView.radius);
                queryCapsule.center2 = f32x4(VectorSingle(queryView.points[1u], 0.0f), 0.0f);
            }
        }

        b8 stopped = false;
        in ShapeProxyView queryViewRef = queryView;
        in Filter filterRef = filter;
        in SphereShape qSphereRef = querySphere;
        in CapsuleShape qCapRef = queryCapsule;
        in OverlapCollectorCallback collectorRef = collector;
        for(usize t = 0u; t < s_TreeCount; ++t){
            this.m_broadPhase.trees[t].queryAabbFiltered(
                queryBox,
                queryMask,
                reqNodeFlags,
                lambda[in this, in t, in queryViewRef, in queryPos, in queryRot, in filterRef, in hitSensors, in ignoreBodyId, in ignoreShapeId, in useCustomFilter, in queryFilter, in qSphereRef, in qCapRef, in collectorRef, mut queryKind, mut queryHullAttempted, mut queryHull, mut stopped](in u32 proxyId, in u32 shapeIdx) -> b8{
                    if(stopped)
                        return false;
                    if(this.isAwakeShapeDuringDirtyTree(t, shapeIdx))
                        return true;
                    return this.evalOverlapShapeCollectCandidate(shapeIdx, queryViewRef, queryPos, queryRot, filterRef, hitSensors, ignoreBodyId, ignoreShapeId, useCustomFilter, queryFilter, qSphereRef, qCapRef, collectorRef, queryKind, queryHullAttempted, queryHull, stopped);
                }
            );
            if(stopped)
                return;
        }
        this.queryAwakeShapesAabb(
            qMin,
            qMax,
            queryMask,
            reqNodeFlags,
            lambda[in this, in queryViewRef, in queryPos, in queryRot, in filterRef, in hitSensors, in ignoreBodyId, in ignoreShapeId, in useCustomFilter, in queryFilter, in qSphereRef, in qCapRef, in collectorRef, mut queryKind, mut queryHullAttempted, mut queryHull, mut stopped](in u32 shapeIdx) -> b8{
                return this.evalOverlapShapeCollectCandidate(shapeIdx, queryViewRef, queryPos, queryRot, filterRef, hitSensors, ignoreBodyId, ignoreShapeId, useCustomFilter, queryFilter, qSphereRef, qCapRef, collectorRef, queryKind, queryHullAttempted, queryHull, stopped);
            }
        );
    }

