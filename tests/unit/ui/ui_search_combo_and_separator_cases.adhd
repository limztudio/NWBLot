    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(0.0f, 0.0f, 160.0f, 100.0f)));
    ASSERT_TRUE(self.m_builder.separator("divider"));
