[friend(Builder)]
class SliderFrame : MoveOnly{
    private mut SliderState m_state;
    private SliderOptions m_options;
    private SliderStyle m_style;
    private SliderMetrics m_metrics;
    private SliderSnapshot m_snapshot;
    private WidgetState m_widget;
    private ControlToken m_token;
    private SliderResult m_result;
    private b8 m_focusOnCommit = false;
    private b8 m_interactive = false;

    public SliderFrame(mut SliderState state){ this.m_state = state; }
}


