}

void VerifyAssetsGraphics_DecodedShaderIndexOwnsVariantTextAfterEncodedBytesAreOverwritten(){
    TestArena testArena = TestArena();
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    ScratchArena scratchArena(s_AssetCaseTestsAssetsGraphicsBorrowedIndex);
    native(in logger, mut testArena, mut scratchArena){
        namespace ShaderArchive = NWB::Core::ShaderArchive;
        NWB::Core::GraphicsVector<ShaderArchive::Record> records(testArena.arena);
        ShaderArchive::Record& record = records.emplace_back(testArena.arena);
        record.shaderName = Name(s_AssetCaseProjectShadersBorrowedIndex);
        record.variantName = "BORROWED_VARIANT=nontrivial_owned_text";
        record.stage = Name(s_AssetCasePs);
        const Expected<Name> virtualPath = ShaderArchive::BuildVirtualPathName(record.shaderName, AStringView(record.variantName), record.stage);
        ASSERT_TRUE(virtualPath);
        record.virtualPathHash = virtualPath->hash();

        auto encoded = ShaderArchive::SerializeIndex(records, testArena.arena, scratchArena);
        ASSERT_TRUE(encoded);
        const auto decoded = ShaderArchive::DeserializeIndex(testArena.arena, BinaryByteView{ encoded->data(), encoded->size() });
        ASSERT_TRUE(decoded);
        ASSERT_EQ(decoded->size(), 1u);
        encoded->assign(encoded->size(), 0u);
        EXPECT_EQ(AStringView(decoded->front().variantName), AStringView(record.variantName));
        EXPECT_EQ(decoded->front().virtualPathHash, record.virtualPathHash);
        EXPECT_EQ(logger.errorCount(), 0u);
    }
}

void VerifyGatherInputs_MissingOutputIsRejectedBeforeInputDiscovery(mut GatherInputs self){
    self.m_options.outputDirectory.clear();
    self.addRawInput("missing-gather-input");
    EXPECT_FALSE(GatherAssets(self.m_options, self.m_scratchArena));
    EXPECT_TRUE(SawCapturedError(self.m_logger, "output directory is empty"));
    EXPECT_FALSE(SawCapturedError(self.m_logger, "failed to inspect input"));
    EXPECT_EQ(self.m_logger.errorCount(), 1u);
}

void VerifyGatherInputs_InputListEncodingRejectsUnrepresentablePathsWithoutLosingDuplicates(mut GatherInputs self){
    String encodedText = String();
    native(mut self, mut encodedText){
        namespace Assets = NWB::Core::Assets;
        Assets::AssetVector<Assets::AssetString> inputs(self.m_testArena.arena);
        inputs.emplace_back("valid path", self.m_testArena.arena);
        inputs.emplace_back("valid path", self.m_testArena.arena);
        const auto encoded = Assets::EncodeAssetInputList(inputs, self.m_scratchArena);
        ASSERT_TRUE(encoded);
        encodedText.assign(encoded->data(), encoded->size());
    }
    EXPECT_EQ(encodedText, "valid path\nvalid path\n");

    for(u32 invalidIndex = 0u; invalidIndex < 4u; ++invalidIndex){
        b8 accepted = true;
        native(in invalidIndex, mut self, mut accepted){
            namespace Assets = NWB::Core::Assets;
            Assets::AssetVector<Assets::AssetString> inputs(self.m_testArena.arena);
            inputs.emplace_back("valid path", self.m_testArena.arena);
            inputs.emplace_back("valid path", self.m_testArena.arena);
            AStringView invalid = AStringView();
            if(invalidIndex == 1u)
                invalid = "line\nbreak";
            else if(invalidIndex == 2u)
                invalid = "carriage\rreturn";
            else if(invalidIndex == 3u)
                invalid = AStringView("nul\0byte", 8u);
            inputs.back().assign(invalid);
            accepted = Assets::EncodeAssetInputList(inputs, self.m_scratchArena).has_value();
        }
        EXPECT_FALSE(accepted);
    }
}

void VerifyGatherInputs_IdenticalDuplicatesKeepExactPayloadsWithoutMergeCalls(mut GatherInputs self){
    self.writeInputs("a", 64u, 257u, 7u);
    ASSERT_FALSE(self.hasFatalFailure());
    self.writeInputs("b", 64u, 257u, 7u);
    ASSERT_FALSE(self.hasFatalFailure());
    self.duplicateFirstInput();
    self.enableTestMerge();
    ASSERT_TRUE(GatherAssets(self.m_options, self.m_scratchArena));
    EXPECT_EQ(self.mergeCallCount(), 0u);
    self.verifyPayloads(64u, 257u, 7u);
    ASSERT_FALSE(self.hasFatalFailure());
}

void VerifyGatherInputs_ConflictingDuplicatesPreservePublishedVolume(mut GatherInputs self){
    self.writeInputs("a", 4u, 8u, 3u);
    ASSERT_FALSE(self.hasFatalFailure());
    ASSERT_TRUE(GatherAssets(self.m_options, self.m_scratchArena));
    self.writeInputs("b", 4u, 8u, 9u);
    ASSERT_FALSE(self.hasFatalFailure());
    EXPECT_FALSE(GatherAssets(self.m_options, self.m_scratchArena));
    EXPECT_GT(self.m_logger.errorCount(), 0u);
    self.verifyPayloads(4u, 8u, 3u);
    ASSERT_FALSE(self.hasFatalFailure());
}

void VerifyGatherInputs_DuplicateManifestPathsPreservePublishedVolume(mut GatherInputs self){
    self.writeInputs("a", 1u, 8u, 3u);
    ASSERT_FALSE(self.hasFatalFailure());
    ASSERT_TRUE(GatherAssets(self.m_options, self.m_scratchArena));
    const Expected<Name> name = GatherInputAssetName(0u);
    ASSERT_TRUE(name.has_value());
    const Name duplicateName = name.value();
    b8 wroteVolume = true;
    native(in duplicateName, mut self, mut wroteVolume){
        namespace Assets = NWB::Core::Assets;
        namespace Pack = Assets::AssetsVolumeCookDetail;
        Pack::AssetVolumePackManifest manifest(self.m_testArena.arena);
        ASSERT_TRUE(Pack::ReserveAssetVolumePackManifest(2u, manifest));
        const Array<u8, 1u> first{ 7u };
        const Array<u8, 1u> second{ 8u };
        ASSERT_TRUE(Pack::AppendPayloadBytesToManifest(duplicateName, first, manifest, 1u));
        ASSERT_TRUE(Pack::AppendPayloadBytesToManifest(duplicateName, second, manifest, 1u));
        Assets::ResolvedCookPaths paths(self.m_testArena.arena);
        paths.outputDirectory = self.m_root / s_GatherOutputDirectory;
        wroteVolume = Pack::WriteAssetVolume(paths, "tests", manifest, self.m_testArena.arena, self.m_scratchArena).has_value();
    }
    EXPECT_FALSE(wroteVolume);
    EXPECT_GT(self.m_logger.errorCount(), 0u);
    self.verifyPayloads(1u, 8u, 3u);
    ASSERT_FALSE(self.hasFatalFailure());
}

void VerifyGatherInputs_MergedPayloadIdentitySurvivesLaterIdenticalDuplicate(mut GatherInputs self){
    self.writeInputs("a", 1u, 2u, 5u);
    ASSERT_FALSE(self.hasFatalFailure());
    self.writeInputs("b", 1u, 2u, 5u);
    ASSERT_FALSE(self.hasFatalFailure());
    self.writeInputs("c", 1u, 4u, 5u);
    ASSERT_FALSE(self.hasFatalFailure());
    // Equal payloads collapse while the distinct third payload is appended once.
    self.enableTestMerge();
    ASSERT_TRUE(GatherAssets(self.m_options, self.m_scratchArena));
    EXPECT_EQ(self.mergeCallCount(), 1u);
    self.verifyPayloads(1u, 6u, 5u);
    ASSERT_FALSE(self.hasFatalFailure());
    self.writeInputs("d", 1u, 6u, 5u);
    ASSERT_FALSE(self.hasFatalFailure());
    self.resetMergeCallCount();
    ASSERT_TRUE(GatherAssets(self.m_options, self.m_scratchArena));
    EXPECT_EQ(self.mergeCallCount(), 1u);
    self.verifyPayloads(1u, 6u, 5u);
    ASSERT_FALSE(self.hasFatalFailure());
}

void VerifyMaterialAvboitShaderGenerator_MissingInterfaceRejectsTransparentEntryWithoutChangingShaderNames(){
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_AssetCaseTestsAvboitShaderGeneratorScratch);
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard guard(logger, s_ReportOnly);
    native(in logger, mut testArena, mut scratchArena){
        auto root = PrepareAssetsGraphicsCaseRoot(testArena, "avboit_shader_missing_interface_v2");
        ASSERT_TRUE(root);

        NWB::Impl::MaterialCookVector<NWB::Impl::MaterialCookEntry> entries(testArena.arena);
        entries.emplace_back(testArena.arena);
        entries.back().virtualPath = "project/materials/opaque";
        entries.back().surfaceSource = "opaque.slang";
        entries.emplace_back(testArena.arena);
        entries.back().virtualPath = "project/materials/transparent";
        entries.back().surfaceSource = "transparent.slang";
        entries.back().transparent = true;

        using Generator = NWB::Impl::MaterialAvboitShaderGenerator;
        EXPECT_FALSE(Generator::EmitAccumulate(*root, "test", testArena.arena, scratchArena, entries));
        EXPECT_FALSE(Generator::EmitOccupancy(*root, "test", testArena.arena, scratchArena, entries));
        EXPECT_FALSE(Generator::EmitExtinction(*root, "test", testArena.arena, scratchArena, entries));
        EXPECT_TRUE(entries[0u].avboitAccumulatePixelShaderName.empty());
        EXPECT_TRUE(entries[0u].avboitOccupancyPixelShaderName.empty());
        EXPECT_TRUE(entries[0u].avboitExtinctionPixelShaderName.empty());
        EXPECT_TRUE(entries[1u].avboitAccumulatePixelShaderName.empty());
        EXPECT_TRUE(entries[1u].avboitOccupancyPixelShaderName.empty());
        EXPECT_TRUE(entries[1u].avboitExtinctionPixelShaderName.empty());
        EXPECT_EQ(logger.errorCount(), 3u);
        EXPECT_TRUE(logger.sawErrorContaining(NWB_TEXT("project/materials/transparent")));
        EXPECT_FALSE(logger.sawErrorContaining(NWB_TEXT("project/materials/opaque")));
    }
}


