[[nodiscard]] FOUNDATION_INLINE Expected<u64> ComputeSingleAliasShaderDependencyChecksumImpl(const ShaderCookPathVector& dependencies, const ShaderCookPathVector& includeDirectories, const Path& aliasRoot, const AStringView aliasName, ScratchArena& scratchArena){
    const auto result = Impl::ShaderCook::ComputeDependencyChecksum(dependencies, includeDirectories, { { aliasRoot, aliasName } }, scratchArena);
    if(!result)
        return MakeUnexpected(Failure{});
    return result->checksum;
}

[[nodiscard]] FOUNDATION_INLINE b8 PathVectorContainsImpl(const ShaderCookPathVector& paths, const Path& target)noexcept{
    return FindIf(paths.begin(), paths.end(), [&target](const Path& path)noexcept{ return path == target; }) != paths.end();
}

[[nodiscard]] FOUNDATION_INLINE b8 ReadTextFileMatchesImpl(const Path& path, const AStringView expected, ScratchArena& scratchArena, b8& outMatches){
    ScratchString contents(scratchArena);
    if(!::ReadTextFile(path, contents)){
        outMatches = false;
        return false;
    }
    outMatches = AStringView(contents) == expected;
    return true;
}

