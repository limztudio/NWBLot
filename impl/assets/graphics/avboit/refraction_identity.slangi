////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_AVBOIT_REFRACTION_IDENTITY_SLANGI
#define NWB_GRAPHICS_AVBOIT_REFRACTION_IDENTITY_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static const uint NWB_AVBOIT_ENTITY_ID_CHANNEL_BITS = 16u;
static const uint NWB_AVBOIT_ENTITY_ID_CHANNEL_MASK = (1u << NWB_AVBOIT_ENTITY_ID_CHANNEL_BITS) - 1u;
static const uint NWB_AVBOIT_REFRACTION_FRONT_BOUNDARY_BIT = 1u << NWB_AVBOIT_ENTITY_ID_CHANNEL_BITS;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// RG32_FLOAT carries the full entity ID as two exact finite uint16 values plus the front-boundary bit in channel X; readers use unfiltered texel loads and capture depth establishes validity.
float2 nwbAvboitPackRefractionIdentity(const uint entityId, const bool frontBoundary){
    const uint low = (entityId & NWB_AVBOIT_ENTITY_ID_CHANNEL_MASK) | (frontBoundary ? NWB_AVBOIT_REFRACTION_FRONT_BOUNDARY_BIT : 0u);
    return float2(float(low), float(entityId >> NWB_AVBOIT_ENTITY_ID_CHANNEL_BITS));
}

float2 nwbAvboitPackRefractionEntityId(const uint entityId){
    return nwbAvboitPackRefractionIdentity(entityId, false);
}

bool nwbAvboitUnpackRefractionFrontBoundary(const float2 channels){
    return (uint(channels.x) & NWB_AVBOIT_REFRACTION_FRONT_BOUNDARY_BIT) != 0u;
}

uint nwbAvboitUnpackRefractionEntityId(const float2 channels){
    return (uint(channels.x) & NWB_AVBOIT_ENTITY_ID_CHANNEL_MASK) | (uint(channels.y) << NWB_AVBOIT_ENTITY_ID_CHANNEL_BITS);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

