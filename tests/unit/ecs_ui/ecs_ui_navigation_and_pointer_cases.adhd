    ASSERT_TRUE(self.frame(self.m_model));
    ASSERT_TRUE(WordSelectClickAt(self, point, 1200u));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.selectedText(), "one");
}

