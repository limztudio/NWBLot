native{
#include <impl/ecs_render/avboit/avboit_frame_targets.adhd.h>
#include <impl/ecs_render/shared/frame_types.adhd.h>

#include <core/graphics/api.h>
#include <core/graphics/rhi/gpu_descriptor_heap.h>


