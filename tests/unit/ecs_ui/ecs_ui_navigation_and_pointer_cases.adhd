void VerifyUiEditNavigationLifetimeTests_NativePreeditSuppressesVerticalKeysAndFirstEscapeAllowsFreshNavigation(mut UiEditNavigationLifetimeTests self){
    ASSERT_TRUE(self.seedPreferredColumn());
    ASSERT_EQ(self.m_textInput.preedit("IME", 0u, 3u), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    ASSERT_TRUE(self.navigationFrame());
    ASSERT_TRUE(self.m_navigationModel.composition().active);
    UiEditModelSnapshot preedit = UiEditModelSnapshot(self.m_arena);
    preedit.capture(self.m_navigationModel);
    const UiEditNavigationSnapshot preferred = self.m_navigation.snapshot();
    self.m_resolver.records.clear();
    self.m_actions.records.clear();

    Array<KeyEnum, 4> keys = Array<KeyEnum, 4>();
    keys[0u] = Key::Up;
    keys[1u] = Key::Down;
    keys[2u] = Key::PageUp;
    keys[3u] = Key::PageDown;
    for(in KeyEnum value : keys)
        ASSERT_TRUE(self.key(value));
    ASSERT_TRUE(self.navigationFrame());
    EXPECT_TRUE(self.m_resolver.records.empty());
    EXPECT_TRUE(preedit.matches(self.m_navigationModel));
    EXPECT_TRUE(self.m_navigation.matches(preferred));
    EXPECT_TRUE(self.m_actions.records.empty());

    ASSERT_TRUE(self.key(Key::Escape));
    ASSERT_TRUE(self.key(Key::Down));
    ASSERT_TRUE(self.navigationFrame());
    EXPECT_FALSE(self.m_navigationModel.composition().active);
    EXPECT_EQ(self.m_navigationModel.text(), "abcdef\nx\nabcdef");
    EXPECT_EQ(self.m_navigationModel.revision(), preedit.m_expectedRevision);
    EXPECT_EQ(self.m_navigationModel.externalRevision(), preedit.m_expectedExternalRevision);
    EXPECT_EQ(self.m_navigationModel.anchor(), 10u);
    EXPECT_EQ(self.m_navigationModel.caret(), 10u);
    EXPECT_FALSE(self.m_navigationModel.canUndo());
    EXPECT_FALSE(self.m_result.cancelled);
    EXPECT_TRUE(self.m_result.focused);
    EXPECT_TRUE(self.m_actions.records.empty());
    ASSERT_EQ(self.m_resolver.records.size(), 1u);
    EXPECT_FALSE(self.m_resolver.records[0u].navigation.valid);
    EXPECT_EQ(self.m_resolver.records[0u].caret, 8u);
    EXPECT_FLOAT_EQ(self.m_navigation.preferredX(), 10.0f);
}

void VerifyUiEditNavigationLifetimeTests_DisableDiscardsQueuedNavigationAndResetsOnlyTheLentState(mut UiEditNavigationLifetimeTests self){
    ASSERT_TRUE(self.seedPreferredColumn());
    UiEditModelSnapshot before = UiEditModelSnapshot(self.m_arena);
    before.capture(self.m_navigationModel);
    const UiEditNavigationSnapshot preferred = self.m_navigation.snapshot();
    const TextInputSessionToken oldSession = self.m_textInput.activeSession();
    ASSERT_TRUE(self.key(Key::Down));
    ASSERT_TRUE(self.commitNative("late"));
    EXPECT_TRUE(self.m_navigation.matches(preferred));
    EXPECT_TRUE(before.matches(self.m_navigationModel));

    UiEditBoxOptions disabled = UiEditBoxOptions();
    disabled.enabled = false;
    ASSERT_TRUE(self.navigationFrame(disabled));
    EXPECT_TRUE(self.m_result.abandoned);
    EXPECT_FALSE(self.m_result.focused);
    EXPECT_TRUE(before.matches(self.m_navigationModel));
    EXPECT_TRUE(self.m_resolver.records.empty());
    EXPECT_FALSE(self.m_navigation.hasPreferredX());
    EXPECT_FALSE(self.m_navigation.matches(preferred));
    EXPECT_EQ(self.m_actions.count(UiEditAction::Abandon), 1u);
    ASSERT_EQ(self.m_actions.records.size(), 1u);
    EXPECT_EQ(self.m_actions.records[0u].text, "abcdef\nx\nabcdef");
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.m_textInput.emitCommit(oldSession, "later"), TextInputAdmission::InvalidSession);
    ASSERT_TRUE(self.navigationFrame(disabled));
    EXPECT_FALSE(self.m_result.abandoned);
    EXPECT_EQ(self.m_actions.count(UiEditAction::Abandon), 1u);
    EXPECT_TRUE(self.m_resolver.records.empty());
}

void VerifyUiEditNavigationLifetimeTests_BlurResetsPreferredColumnAtItsOrderedPositionBetweenVerticalKeys(mut UiEditNavigationLifetimeTests self){
    ASSERT_TRUE(self.seedPreferredColumn());
    ASSERT_TRUE(self.m_navigation.setPreferredX(40.0f));
    const UiEditNavigationSnapshot preferred = self.m_navigation.snapshot();
    UiEditModelSnapshot before = UiEditModelSnapshot(self.m_arena);
    before.capture(self.m_navigationModel);
    ASSERT_TRUE(self.key(Key::Up));
    ASSERT_TRUE(self.focusOther());
    ASSERT_TRUE(self.focusNavigation());
    ASSERT_TRUE(self.key(Key::Down));
    EXPECT_TRUE(before.matches(self.m_navigationModel));
    EXPECT_TRUE(self.m_navigation.matches(preferred));

    ASSERT_TRUE(self.navigationFrame());
    EXPECT_TRUE(self.m_result.blurred);
    EXPECT_TRUE(self.m_result.focused);
    EXPECT_EQ(self.m_navigationModel.text(), "abcdef\nx\nabcdef");
    EXPECT_EQ(self.m_navigationModel.revision(), before.m_expectedRevision);
    EXPECT_EQ(self.m_navigationModel.externalRevision(), before.m_expectedExternalRevision);
    EXPECT_EQ(self.m_navigationModel.anchor(), 8u);
    EXPECT_EQ(self.m_navigationModel.caret(), 8u);
    EXPECT_FALSE(self.m_navigationModel.canUndo());
    EXPECT_EQ(self.m_actions.count(UiEditAction::Blur), 1u);
    ASSERT_EQ(self.m_resolver.records.size(), 2u);
    EXPECT_EQ(self.m_resolver.records[0u].caret, 8u);
    EXPECT_TRUE(self.m_resolver.records[0u].navigation.valid);
    EXPECT_FLOAT_EQ(self.m_resolver.records[0u].navigation.preferredX, 40.0f);
    ASSERT_TRUE(self.m_resolver.records[0u].result.has_value());
    EXPECT_EQ(self.m_resolver.records[0u].result.value().committedByte, 4u);
    EXPECT_EQ(self.m_resolver.records[1u].caret, 4u);
    EXPECT_FALSE(self.m_resolver.records[1u].navigation.valid);
    ASSERT_TRUE(self.m_resolver.records[1u].result.has_value());
    EXPECT_EQ(self.m_resolver.records[1u].result.value().committedByte, 8u);
    EXPECT_FLOAT_EQ(self.m_navigation.preferredX(), 40.0f);
}

void VerifyUiEditNavigationLifetimeTests_BlurPreservesDraftBeforeFreshFocusEpochNavigation(mut UiEditNavigationLifetimeTests self){
    ASSERT_TRUE(self.seedPreferredColumn());
    const TextInputSessionToken oldSession = self.m_textInput.activeSession();
    const UiEditNavigationSnapshot preferred = self.m_navigation.snapshot();
    ASSERT_TRUE(self.commitNative("!"));
    ASSERT_TRUE(self.focusOther());
    ASSERT_TRUE(self.focusNavigation());
    ASSERT_TRUE(self.key(Key::Down));
    EXPECT_EQ(self.m_navigationModel.text(), "abcdef\nx\nabcdef");
    EXPECT_TRUE(self.m_navigation.matches(preferred));
    EXPECT_TRUE(self.m_actions.records.empty());

    ASSERT_TRUE(self.navigationFrame());
    EXPECT_TRUE(self.m_result.blurred);
    EXPECT_TRUE(self.m_result.focused);
    EXPECT_EQ(self.m_navigationModel.text(), "abcdef\nx!\nabcdef");
    EXPECT_EQ(self.m_navigationModel.anchor(), 12u);
    EXPECT_EQ(self.m_navigationModel.caret(), 12u);
    EXPECT_EQ(self.m_actions.count(UiEditAction::Blur), 1u);
    EXPECT_EQ(self.m_actions.count(UiEditAction::Cancel), 0u);
    EXPECT_EQ(self.m_actions.count(UiEditAction::Abandon), 0u);
    ASSERT_EQ(self.m_actions.records.size(), 1u);
    EXPECT_EQ(self.m_actions.records[0u].text, "abcdef\nx!\nabcdef");
    ASSERT_EQ(self.m_resolver.records.size(), 1u);
    EXPECT_EQ(self.m_resolver.records[0u].text, "abcdef\nx!\nabcdef");
    EXPECT_EQ(self.m_resolver.records[0u].caret, 9u);
    EXPECT_FALSE(self.m_resolver.records[0u].navigation.valid);
    EXPECT_FLOAT_EQ(self.m_navigation.preferredX(), 20.0f);
    EXPECT_TRUE(self.m_textInput.activeSession().valid());
    EXPECT_NE(self.m_textInput.activeSession(), oldSession);
    ASSERT_TRUE(self.m_navigationModel.undo());
    EXPECT_EQ(self.m_navigationModel.text(), "abcdef\nx\nabcdef");
    EXPECT_EQ(self.m_navigationModel.caret(), 8u);
    EXPECT_FALSE(self.m_navigationModel.canUndo());
}

void VerifyUiEditNavigationLifetimeTests_OrdinaryCancelRetiresPreferredColumnWhilePreservingTheDraft(mut UiEditNavigationLifetimeTests self){
    ASSERT_TRUE(self.seedPreferredColumn());
    UiEditModelSnapshot before = UiEditModelSnapshot(self.m_arena);
    before.capture(self.m_navigationModel);
    const UiEditNavigationSnapshot preferred = self.m_navigation.snapshot();
    const TextInputSessionToken oldSession = self.m_textInput.activeSession();
    ASSERT_TRUE(self.key(Key::Escape));
    EXPECT_TRUE(self.m_navigation.matches(preferred));
    EXPECT_TRUE(before.matches(self.m_navigationModel));

    ASSERT_TRUE(self.navigationFrame());
    EXPECT_TRUE(self.m_result.cancelled);
    EXPECT_FALSE(self.m_result.focused);
    EXPECT_TRUE(before.matches(self.m_navigationModel));
    EXPECT_FALSE(self.m_navigation.snapshot().valid);
    EXPECT_FALSE(self.m_navigation.matches(preferred));
    EXPECT_TRUE(self.m_resolver.records.empty());
    EXPECT_EQ(self.m_actions.count(UiEditAction::Cancel), 1u);
    ASSERT_EQ(self.m_actions.records.size(), 1u);
    EXPECT_EQ(self.m_actions.records[0u].text, "abcdef\nx\nabcdef");
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.m_textInput.emitCommit(oldSession, "later"), TextInputAdmission::InvalidSession);
}

void VerifyUiEditNavigationLifetimeTests_OldEpochCancelPreservesDraftAndLaterRefocusNavigation(mut UiEditNavigationLifetimeTests self){
    ASSERT_TRUE(self.seedPreferredColumn());
    const TextInputSessionToken oldSession = self.m_textInput.activeSession();
    const UiEditNavigationSnapshot preferred = self.m_navigation.snapshot();
    const u64 revision = self.m_navigationModel.revision();
    ASSERT_TRUE(self.key(Key::Escape));
    ASSERT_TRUE(self.commitNative("late"));
    ASSERT_TRUE(self.focusOther());
    ASSERT_TRUE(self.focusNavigation());
    ASSERT_TRUE(self.key(Key::Up));
    EXPECT_TRUE(self.m_navigation.matches(preferred));
    EXPECT_EQ(self.m_navigationModel.caret(), 8u);

    ASSERT_TRUE(self.navigationFrame());
    EXPECT_TRUE(self.m_result.cancelled);
    EXPECT_TRUE(self.m_result.focused);
    EXPECT_EQ(self.m_navigationModel.text(), "abcdef\nx\nabcdef");
    EXPECT_EQ(self.m_navigationModel.revision(), revision);
    EXPECT_EQ(self.m_navigationModel.anchor(), 1u);
    EXPECT_EQ(self.m_navigationModel.caret(), 1u);
    EXPECT_FALSE(self.m_navigationModel.canUndo());
    EXPECT_EQ(self.m_actions.count(UiEditAction::Cancel), 1u);
    EXPECT_EQ(self.m_actions.count(UiEditAction::Blur), 0u);
    ASSERT_EQ(self.m_actions.records.size(), 1u);
    EXPECT_EQ(self.m_actions.records[0u].text, "abcdef\nx\nabcdef");
    ASSERT_EQ(self.m_resolver.records.size(), 1u);
    EXPECT_FALSE(self.m_resolver.records[0u].navigation.valid);
    EXPECT_EQ(self.m_resolver.records[0u].caret, 8u);
    EXPECT_FLOAT_EQ(self.m_navigation.preferredX(), 10.0f);
    EXPECT_TRUE(self.m_textInput.activeSession().valid());
    EXPECT_NE(self.m_textInput.activeSession(), oldSession);
    EXPECT_EQ(self.m_textInput.emitCommit(oldSession, "later"), TextInputAdmission::InvalidSession);
}

void VerifyUiEditNavigationLifetimeTests_OmissionLeavesCallerStateExactUntilRedeclarationAbandonsOwnership(mut UiEditNavigationLifetimeTests self){
    ASSERT_TRUE(self.seedPreferredColumn());
    UiEditModelSnapshot before = UiEditModelSnapshot(self.m_arena);
    before.capture(self.m_navigationModel);
    const UiEditNavigationSnapshot preferred = self.m_navigation.snapshot();
    const u64 declaration = self.m_widget.declarationGeneration;
    const TextInputSessionToken oldSession = self.m_textInput.activeSession();
    ASSERT_TRUE(self.commitNative("late"));
    ASSERT_TRUE(self.emptyFrame());
    EXPECT_TRUE(self.m_navigation.matches(preferred));
    EXPECT_TRUE(before.matches(self.m_navigationModel));
    EXPECT_TRUE(self.m_actions.records.empty());
    EXPECT_TRUE(self.m_resolver.records.empty());
    EXPECT_FALSE(self.m_textInput.activeSession().valid());

    ASSERT_TRUE(self.navigationFrame());
    EXPECT_TRUE(self.m_result.abandoned);
    EXPECT_NE(self.m_widget.declarationGeneration, declaration);
    EXPECT_TRUE(before.matches(self.m_navigationModel));
    EXPECT_FALSE(self.m_navigation.hasPreferredX());
    EXPECT_FALSE(self.m_navigation.matches(preferred));
    EXPECT_EQ(self.m_actions.count(UiEditAction::Abandon), 1u);
    ASSERT_EQ(self.m_actions.records.size(), 1u);
    EXPECT_EQ(self.m_actions.records[0u].text, "abcdef\nx\nabcdef");
    EXPECT_EQ(self.m_textInput.emitCommit(oldSession, "later"), TextInputAdmission::InvalidSession);
    ASSERT_TRUE(self.navigationFrame());
    EXPECT_FALSE(self.m_result.abandoned);
    EXPECT_EQ(self.m_actions.count(UiEditAction::Abandon), 1u);
}

void VerifyUiEditNavigationLifetimeTests_HostResetCannotTouchUnlentDraftOrPreferredColumn(mut UiEditNavigationLifetimeTests self){
    ASSERT_TRUE(self.seedPreferredColumn());
    UiEditModelSnapshot before = UiEditModelSnapshot(self.m_arena);
    before.capture(self.m_navigationModel);
    const UiEditNavigationSnapshot preferred = self.m_navigation.snapshot();
    const TextInputSessionToken oldSession = self.m_textInput.activeSession();
    self.m_host.reset();
    EXPECT_TRUE(before.matches(self.m_navigationModel));
    EXPECT_TRUE(self.m_navigation.matches(preferred));
    EXPECT_TRUE(self.m_actions.records.empty());
    EXPECT_TRUE(self.m_resolver.records.empty());
    EXPECT_FALSE(self.m_textInput.activeSession().valid());

    ASSERT_TRUE(self.navigationFrame());
    EXPECT_TRUE(self.m_result.abandoned);
    EXPECT_TRUE(before.matches(self.m_navigationModel));
    EXPECT_FALSE(self.m_navigation.hasPreferredX());
    EXPECT_FALSE(self.m_navigation.matches(preferred));
    EXPECT_EQ(self.m_actions.count(UiEditAction::Abandon), 1u);
    EXPECT_EQ(self.m_textInput.emitCommit(oldSession, "later"), TextInputAdmission::InvalidSession);
}

void VerifyUiEditNavigationLifetimeTests_RebindingResetsOnlyTheNewlyLentModelAndNavigationOwnership(mut UiEditNavigationLifetimeTests self){
    ASSERT_TRUE(self.seedPreferredColumn());
    UiEditModelSnapshot original = UiEditModelSnapshot(self.m_arena);
    original.capture(self.m_navigationModel);
    const UiEditNavigationSnapshot originalPreferred = self.m_navigation.snapshot();
    UiEditModel replacement = UiEditModel(self.m_arena, UiEditLimits(), UiEditTextMode::Multiline);
    ASSERT_TRUE(replacement.setText("zz\nabc"));
    ASSERT_TRUE(replacement.setSelection(1u, 1u));
    UiEditNavigationState replacementNavigation = UiEditNavigationState();
    ASSERT_TRUE(replacementNavigation.setPreferredX(70.0f));
    const UiEditNavigationSnapshot replacementPreferred = replacementNavigation.snapshot();
    UiEditModelSnapshot replacementBefore = UiEditModelSnapshot(self.m_arena);
    replacementBefore.capture(replacement);
    ASSERT_TRUE(self.key(Key::Down));
    EXPECT_TRUE(self.m_navigation.matches(originalPreferred));
    EXPECT_TRUE(replacementNavigation.matches(replacementPreferred));

    ASSERT_TRUE(self.prepareNavigationModel(replacement, replacementNavigation));
    ASSERT_TRUE(self.commit());
    EXPECT_TRUE(self.m_result.abandoned);
    EXPECT_TRUE(original.matches(self.m_navigationModel));
    EXPECT_TRUE(replacementBefore.matches(replacement));
    EXPECT_TRUE(self.m_navigation.matches(originalPreferred));
    EXPECT_FALSE(replacementNavigation.hasPreferredX());
    EXPECT_FALSE(replacementNavigation.matches(replacementPreferred));
    EXPECT_TRUE(self.m_resolver.records.empty());
    EXPECT_EQ(self.m_actions.count(UiEditAction::Abandon), 1u);
    ASSERT_TRUE(self.key(Key::Down));
    ASSERT_TRUE(self.prepareNavigationModel(replacement, replacementNavigation));
    ASSERT_TRUE(self.commit());
    EXPECT_EQ(replacement.caret(), 4u);
    ASSERT_EQ(self.m_resolver.records.size(), 1u);
    EXPECT_EQ(self.m_resolver.records[0u].text, "zz\nabc");
    EXPECT_FALSE(self.m_resolver.records[0u].navigation.valid);
    EXPECT_FLOAT_EQ(replacementNavigation.preferredX(), 10.0f);
    EXPECT_TRUE(self.m_navigation.matches(originalPreferred));

    const UiEditNavigationSnapshot replacementAccepted = replacementNavigation.snapshot();
    ASSERT_TRUE(self.navigationFrame());
    EXPECT_TRUE(self.m_result.abandoned);
    EXPECT_TRUE(original.matches(self.m_navigationModel));
    EXPECT_FALSE(self.m_navigation.hasPreferredX());
    EXPECT_TRUE(replacementNavigation.matches(replacementAccepted));
    EXPECT_EQ(replacement.text(), "zz\nabc");
    EXPECT_EQ(replacement.caret(), 4u);
    EXPECT_EQ(self.m_actions.count(UiEditAction::Abandon), 2u);
}

void VerifyUiEditNavigationHostTests_CopiedCommitDownAndCommitResolveTheCurrentEventPosition(mut UiEditNavigationHostTests self){
    ASSERT_TRUE(self.m_navigationModel.setText("ab\ncdef\nxy"));
    ASSERT_TRUE(self.m_navigationModel.setSelection(1u, 1u));
    ASSERT_TRUE(self.activateNavigation());
    ASSERT_TRUE(self.commitNative("Q"));
    ASSERT_TRUE(self.key(Key::Down));
    ASSERT_TRUE(self.commitNative("!"));
    EXPECT_EQ(self.m_navigationModel.text(), "ab\ncdef\nxy");
    EXPECT_EQ(self.m_navigationModel.caret(), 1u);
    ASSERT_TRUE(self.navigationFrame());
    ASSERT_EQ(self.m_resolver.records.size(), 1u);
    EXPECT_EQ(self.m_resolver.records[0u].text, "aQb\ncdef\nxy");
    EXPECT_EQ(self.m_resolver.records[0u].caret, 2u);
    ASSERT_TRUE(self.m_resolver.records[0u].result.has_value());
    EXPECT_FLOAT_EQ(self.m_resolver.records[0u].result.value().preferredX, 20.0f);
    EXPECT_EQ(self.m_resolver.records[0u].result.value().committedByte, 6u);
    EXPECT_EQ(self.m_navigationModel.text(), "aQb\ncd!ef\nxy");
    EXPECT_EQ(self.m_navigationModel.caret(), 7u);
    ASSERT_TRUE(self.m_navigationModel.undo());
    EXPECT_EQ(self.m_navigationModel.text(), "aQb\ncdef\nxy");
    ASSERT_TRUE(self.m_navigationModel.undo());
    EXPECT_EQ(self.m_navigationModel.text(), "ab\ncdef\nxy");
    EXPECT_FALSE(self.m_navigationModel.canUndo());
}

void VerifyUiEditNavigationHostTests_RepeatedVerticalMovementPreservesTheColumnAcrossShortLines(mut UiEditNavigationHostTests self){
    ASSERT_TRUE(self.m_navigationModel.setText("abcdef\nx\nabcdef"));
    ASSERT_TRUE(self.m_navigationModel.setSelection(5u, 5u));
    ASSERT_TRUE(self.activateNavigation());
    const u64 revision = self.m_navigationModel.revision();
    UiInputEvent downEvent = UiInputEvent();
    downEvent.key = Key::Down;
    downEvent.type = UiInputEventType::KeyDown;
    downEvent.shift = true;
    ASSERT_TRUE(self.dispatch(downEvent));
    downEvent.repeat = true;
    ASSERT_TRUE(self.dispatch(downEvent));
    UiInputEvent upEvent = UiInputEvent();
    upEvent.key = Key::Down;
    upEvent.type = UiInputEventType::KeyUp;
    upEvent.shift = true;
    ASSERT_TRUE(self.dispatch(upEvent));
    ASSERT_TRUE(self.navigationFrame());
    ASSERT_EQ(self.m_resolver.records.size(), 2u);
    ASSERT_TRUE(self.m_resolver.records[0u].result.has_value());
    EXPECT_EQ(self.m_resolver.records[0u].result.value().committedByte, 8u);
    ASSERT_TRUE(self.m_resolver.records[1u].result.has_value());
    EXPECT_EQ(self.m_resolver.records[1u].result.value().committedByte, 14u);
    EXPECT_TRUE(self.m_resolver.records[1u].navigation.valid);
    EXPECT_FLOAT_EQ(self.m_resolver.records[1u].navigation.preferredX, 50.0f);
    EXPECT_EQ(self.m_navigationModel.anchor(), 5u);
    EXPECT_EQ(self.m_navigationModel.caret(), 14u);
    ASSERT_TRUE(self.key(Key::Up));
    ASSERT_TRUE(self.key(Key::Up));
    ASSERT_TRUE(self.navigationFrame());
    ASSERT_EQ(self.m_resolver.records.size(), 4u);
    ASSERT_TRUE(self.m_resolver.records[2u].result.has_value());
    EXPECT_EQ(self.m_resolver.records[2u].result.value().committedByte, 8u);
    ASSERT_TRUE(self.m_resolver.records[3u].result.has_value());
    EXPECT_EQ(self.m_resolver.records[3u].result.value().committedByte, 5u);
    EXPECT_FLOAT_EQ(self.m_resolver.records[3u].navigation.preferredX, 50.0f);
    EXPECT_EQ(self.m_navigationModel.anchor(), 5u);
    EXPECT_EQ(self.m_navigationModel.caret(), 5u);
    EXPECT_EQ(self.m_navigationModel.revision(), revision);
    EXPECT_FALSE(self.m_navigationModel.canUndo());
}

