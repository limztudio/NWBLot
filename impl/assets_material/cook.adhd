[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if defined(NWB_COOK)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_material/asset.adhd.h>
#include <impl/assets_material/bind_storage.adhd.h>
#include <impl/assets_material/bind_typed_layout.adhd.h>
#include <impl/assets_material/cook_types.adhd.h>

#include <core/alloc/global.h>
#include <core/alloc/scratch.h>
#include <core/metascript/parser.h>

#include <global/algorithm.h>
#include <global/not_null.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using MaterialCookArena = Core::Alloc::GlobalArena;
using MaterialCookString = AString<MaterialCookArena>;

template<typename T>
using MaterialCookVector = Vector<T, MaterialCookArena>;

template<typename T, typename V>
using MaterialCookMap = HashMap<T, V, MaterialCookArena, Hasher<T>, EqualTo<T>>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct MaterialBindEntry{
    MaterialCookString source;
    MaterialCookString virtualPath;
    MaterialCookVector<MaterialBindStruct> structs;
    MaterialCookVector<MaterialBindInstance> instances;


public:
    explicit MaterialBindEntry(MaterialCookArena& memoryArena)noexcept
        : source(memoryArena)
        , virtualPath(memoryArena)
        , structs(memoryArena)
        , instances(memoryArena)
    {}


public:
    [[nodiscard]] const MaterialBindStruct* findStruct(const AStringView typeName)const noexcept{
        const auto found = FindMaterialBindStructIndex(structs, typeName);
        return found ? &structs[*found] : nullptr;
    }
    [[nodiscard]] const MaterialBindInstance* findInstance(const AStringView instanceName)const noexcept{
        const auto found = FindMaterialBindInstanceIndex(instances, instanceName);
        return found ? &instances[*found] : nullptr;
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using MaterialBindParameterMap = MaterialCookMap<ACompactString, ACompactString>;
using MaterialBindTypedLayoutBlockLookup = MaterialCookMap<Name, MaterialBindTypedLayoutBlockLookupEntry>;
using MaterialBindTypedLayoutParameterLookup = MaterialCookMap<ACompactString, MaterialBindTypedLayoutParameterLookupEntry>;

struct MaterialBindTypedLayout{
    const MaterialBindEntry* bindEntry = nullptr;
    u64 layoutHash = 0u;
    Material::TypedLayoutBlockVector typedLayoutBlocks;
    Material::TypedLayoutFieldVector typedLayoutFields;
    Material::TypedBlockByteVector typedBlockBytes;
    MaterialBindTypedLayoutBlockLookup blockLookup;
    MaterialBindTypedLayoutParameterLookup parameterLookup;


public:
    explicit MaterialBindTypedLayout(MaterialCookArena& memoryArena)
        : typedLayoutBlocks(memoryArena)
        , typedLayoutFields(memoryArena)
        , typedBlockBytes(memoryArena)
        , blockLookup(0, Hasher<Name>(), EqualTo<Name>(), memoryArena)
        , parameterLookup(0, Hasher<ACompactString>(), EqualTo<ACompactString>(), memoryArena)
    {}
};

struct MaterialBindTypedLayoutCache{
    MaterialCookVector<MaterialBindTypedLayout> entries;
    MaterialCookMap<Name, usize> lookup;


public:
    explicit MaterialBindTypedLayoutCache(MaterialCookArena& memoryArena)
        : entries(memoryArena)
        , lookup(0, Hasher<Name>(), EqualTo<Name>(), memoryArena)
    {}


public:
    void reserve(const usize count){
        entries.reserve(count);
        lookup.reserve(count);
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] Expected<MaterialBindEntry> ParseMaterialBindSource(const Path& bindFilePath, MaterialCookArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<MaterialBindTypedLayout> BuildMaterialBindTypedLayout(const MaterialBindEntry& bindEntry, const Name& contextName, MaterialCookArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<NotNull<const MaterialBindTypedLayout*>> FindOrBuildMaterialBindTypedLayout(const Name& materialInterface, const MaterialBindEntry& bindEntry, Core::Alloc::ScratchArena& scratchArena, MaterialBindTypedLayoutCache& inOutCache);
NWB_INLINE void CopyMaterialBindTypedLayoutDefaults(const MaterialBindTypedLayout& layout, u64& outLayoutHash, Material::TypedLayoutBlockVector& outBlocks, Material::TypedLayoutFieldVector& outFields, Material::TypedBlockByteVector& outBlockBytes){
    MaterialBindStorage{}.copyMaterialBindTypedLayoutDefaults(layout.layoutHash, layout.typedLayoutBlocks, layout.typedLayoutFields, layout.typedBlockBytes, outLayoutHash, outBlocks, outFields, outBlockBytes);
}
[[nodiscard]] b8 ApplyMaterialBindTypedLayoutParameters(
    const MaterialBindTypedLayout& layout,
    const Name& materialName,
    const MaterialBindParameterMap& parameters,
    Material::TypedBlockByteVector& inOutBlockBytes,
    Material::ResourceReferenceVector& outResourceReferences
);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct MaterialCookEntry{
    using StageShaderMap = MaterialCookMap<Core::ShaderType::Enum, Core::Assets::AssetRef<IShader>>;
    using ParameterMap = MaterialBindParameterMap;


public:
    // Readable source text (not Name); the cook builds paths and dedup keys from it.
    MaterialCookString virtualPath;
    MaterialCookString materialInterface;
    u64 typedLayoutHash = 0u;
    Material::TypedLayoutBlockVector typedLayoutBlocks;
    Material::TypedLayoutFieldVector typedLayoutFields;
    Material::TypedBlockByteVector typedBlockBytes;
    Material::ResourceReferenceVector resourceReferences;
    MaterialCookString shaderVariant;
    // Deferred lighting BXDF source; resolved and deduped by the cross-asset phase.
    MaterialCookString bxdfSource;
    // Surface hook; empty when explicit `shaders` are declared instead.
    MaterialCookString surfaceSource;
    StageShaderMap stageShaders;
    // Generated AVBOIT accumulate PS name; empty for opaque materials.
    MaterialCookString avboitAccumulatePixelShaderName;
    // Occupancy/extinction twins of the accumulate name.
    MaterialCookString avboitOccupancyPixelShaderName;
    MaterialCookString avboitExtinctionPixelShaderName;
    ParameterMap parameters;
    u32 shadingModelId = 0u;
    // Surface dispatch id, deduped over the `surface` source set.
    u32 surfaceDispatchId = 0u;
    b8 transparent = false;
    b8 twoSided = false;
    // Explicit caster classification, independent of transparency; NwbMeshSurface supplies the optical parameters.
    b8 refractive = false;


public:
    explicit MaterialCookEntry(MaterialCookArena& arena)
        : virtualPath(arena)
        , materialInterface(arena)
        , typedLayoutBlocks(arena)
        , typedLayoutFields(arena)
        , typedBlockBytes(arena)
        , resourceReferences(arena)
        , shaderVariant(arena)
        , bxdfSource(arena)
        , surfaceSource(arena)
        , stageShaders(0, Hasher<Core::ShaderType::Enum>(), EqualTo<Core::ShaderType::Enum>(), arena)
        , avboitAccumulatePixelShaderName(arena)
        , avboitOccupancyPixelShaderName(arena)
        , avboitExtinctionPixelShaderName(arena)
        , parameters(0, Hasher<ACompactString>(), EqualTo<ACompactString>(), arena)
    {}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Cook-generated PS for a `surface`-authored material; cooks like any other shader.
struct GeneratedMaterialPixelShader{
    MaterialCookString name;    // shader virtual name (identity), e.g. "generated/material_ps/<material path>"
    MaterialCookString source;  // absolute, forward-slash path of the generated .slang source in the cook cache


public:
    explicit GeneratedMaterialPixelShader(MaterialCookArena& arena)noexcept
        : name(arena)
        , source(arena)
    {}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct MaterialBindDependency{
    MaterialCookString interfacePath;
    // Authored `.bind` files behind the generated includes. They are not compiler inputs, but their edits must recook the shader.
    MaterialCookVector<Path> interfaceSources;
    Name interfaceName = s_NameNone;
    b8 dependsOnMaterialBind = false;


public:
    explicit MaterialBindDependency(MaterialCookArena& arena)noexcept
        : interfacePath(arena)
        , interfaceSources(arena)
    {}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] Expected<MaterialCookEntry> ParseMaterialCookMetadata(const Path& assetRoot, AStringView virtualRoot, const Path& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] b8 ValidateMaterialCookInterfaces(Span<const MaterialBindEntry> materialBindEntries, Span<MaterialCookEntry> materialEntries, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<MaterialCookString> BuildMaterialBindIncludeSource(const MaterialBindEntry& entry, MaterialCookArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<Path> EmitMaterialBindIncludes(const Path& cacheDirectory, AStringView configurationSafeName, Span<const MaterialBindEntry> materialBindEntries, MaterialCookArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<MaterialBindDependency> ResolveMaterialBindDependencyInterface(
    AStringView shaderName,
    const Path& materialBindIncludeRoot,
    Span<const MaterialBindEntry> materialBindEntries,
    Span<const Path> dependencies,
    MaterialCookArena& arena,
    Core::Alloc::ScratchArena& scratchArena
);
[[nodiscard]] Expected<Material> BuildMaterialAsset(const MaterialCookEntry& materialEntry, Core::Assets::AssetArena& arena);

// Deterministic shading-model id (unique `bxdf`) + surface dispatch id (unique `surface`); shared sources share ids.
// Before material build + dispatch emission.
[[nodiscard]] b8 AssignMaterialShadingModelIds(Span<MaterialCookEntry> materialEntries, Core::Alloc::ScratchArena& scratchArena);
// BXDF dispatch module (per-bxdf include, macro-renamed per id; unknown id = magenta, no engine default).
// Always written; after AssignMaterialShadingModelIds, before PrepareShaderEntriesForCook.
[[nodiscard]] Expected<Path> EmitDeferredBxdfDispatchModule(const Path& cacheDirectory, AStringView configurationSafeName, Span<const MaterialCookEntry> materialEntries, Core::Alloc::ScratchArena& scratchArena);

// G-buffer PS per `surface` material (engine authoring + typed `.bind` + resolved hook); pixel = generated PS, mesh = shared.
// Explicit `shaders` only for opaque non-refractive; transparent/refractive must use `surface`.
// Sources must be absolute paths.
[[nodiscard]] Expected<MaterialCookVector<GeneratedMaterialPixelShader>> EmitMaterialPixelShaders(
    const Path& cacheDirectory,
    AStringView configurationSafeName,
    const Name& sharedMeshShaderName,
    MaterialCookArena& arena,
    Core::Alloc::ScratchArena& scratchArena,
    Span<MaterialCookEntry> materialEntries
);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ShadowSurfaceDispatchGenerator{
public:
    [[nodiscard]] Expected<Path> emit(
        const Path& cacheDirectory,
        AStringView configurationSafeName,
        Span<const MaterialBindEntry> materialBindEntries,
        Span<const MaterialCookEntry> materialEntries,
        Core::Alloc::ScratchArena& scratchArena
    );
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


