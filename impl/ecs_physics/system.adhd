type EcsPhysicsPreStepCallback = Func<64u, void(mut World, mut PhysicsWorld, in f32)>;
type EcsContactBeginCallback = Func<64u, void(in EcsContactBeginEvent)>;
type EcsContactEndCallback = Func<64u, void(in EcsContactEndEvent)>;
type EcsContactHitCallback = Func<64u, void(in EcsContactHitEvent)>;
type EcsSensorBeginCallback = Func<64u, void(in EcsSensorBeginEvent)>;
type EcsSensorEndCallback = Func<64u, void(in EcsSensorEndEvent)>;
type EcsJointBreakCallback = Func<64u, void(in EcsJointBreakEvent)>;
type EcsCharacterEventCallback = Func<64u, void(in EcsCharacterControllerEvent)>;
type EcsVehicleEventCallback = Func<64u, void(in EcsVehicleTelemetryEvent)>;
type EcsFluidSplashCallback = Func<64u, void(in EcsFluidSplashEvent)>;
type EcsFractureEventCallback = Func<64u, void(in EcsFractureEvent)>;


Transform3D InterpolatePhysicsTransform(in Transform3D prevXf, in Transform3D currXf, in f32 alpha){
    const f32 clampedAlpha = Clamp(alpha, 0.0f, 1.0f);
    if(clampedAlpha >= 1.0f - 1.0e-6f)
        return currXf;
    VectorSingle q0 = SafeNormalizeQuat(VectorSingle(prevXf.rotation));
    VectorSingle q1 = SafeNormalizeQuat(VectorSingle(currXf.rotation));
    if(Vector4Dot(q0, q1).x < 0.0f)
        q1 = -q1;
    const VectorSingle tVec(clampedAlpha);
    const VectorSingle pos = Lerp(VectorSingle(prevXf.position), VectorSingle(currXf.position), tVec);
    const VectorSingle rot = SafeNormalizeQuat(Lerp(q0, q1, tVec));
    return Transform3D(pos, rot);
}


void SiftDownEntityIds(mut Vector<EntityID> items, in usize start, in usize count){
    usize root = start;
    while(root * 2u + 1u < count){
        const usize left = root * 2u + 1u;
        usize swapIdx = root;
        if(items[swapIdx].id < items[left].id)
            swapIdx = left;
        const usize right = left + 1u;
        if(right < count && items[swapIdx].id < items[right].id)
            swapIdx = right;
        if(swapIdx == root)
            return;
        const EntityID tmp = items[root];
        items[root] = items[swapIdx];
        items[swapIdx] = tmp;
        root = swapIdx;
    }
}

void CollectSortedEntities<T>(mut World world, mut Vector<EntityID> outEntities){
    outEntities.clear();
    const auto view = world.view<T>();
    outEntities.reserve(view.candidateCount());
    for(in auto row : view)
        outEntities.push_back(Get<0>(row));
    const usize n = outEntities.size();
    if(n <= 1u)
        return;
    for(usize k = n / 2u; k > 0u; --k)
        SiftDownEntityIds(outEntities, k - 1u, n);
    for(usize endIdx = n - 1u; endIdx > 0u; --endIdx){
        const EntityID top = outEntities[0u];
        outEntities[0u] = outEntities[endIdx];
        outEntities[endIdx] = top;
        SiftDownEntityIds(outEntities, 0u, endIdx);
    }
}

