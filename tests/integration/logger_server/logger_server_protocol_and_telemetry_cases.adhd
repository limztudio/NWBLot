void VerifyMinidumpBoundaryTests_InvalidModuleNameLengthsAndTerminatorsCannotBorrowOtherDumpBytes(mut MinidumpBoundaryTests self){
    if(!IsWindowsLoggerCrashPlatform())
        return;

    u32 invalidModuleReports = 0u;
    native(mut self, mut invalidModuleReports){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        struct InvalidName{
            ULONG byteCount;
            b8 terminated;
            b8 includeTerminator;
        };
        for(const auto& invalid : Array<InvalidName, 4u>{ InvalidName{ 1u, true, true }, InvalidName{ Limit<ULONG>::s_Max - 1u, true, true }, InvalidName{ sizeof(wchar), false, true }, InvalidName{ sizeof(wchar), false, false } }){
            constexpr usize s_StreamSize = offsetof(MINIDUMP_MODULE_LIST, Modules) + sizeof(MINIDUMP_MODULE);
            auto bytes = ExceptionDump(self.m_testArena.arena, ModuleListStream, s_StreamSize);
            const usize streamOffset = bytes.size() - s_StreamSize;
            const ULONG count = 1u;
            const RVA nameOffset = static_cast<RVA>(bytes.size());
            MINIDUMP_MODULE module{};
            module.ModuleNameRva = nameOffset;
            StoreDumpRecord(streamOffset, count, bytes);
            StoreDumpRecord(streamOffset + offsetof(MINIDUMP_MODULE_LIST, Modules), module, bytes);
            bytes.resize(bytes.size() + sizeof(ULONG) + sizeof(wchar) * (invalid.includeTerminator ? 2u : 1u), 0u);
            StoreDumpRecord(nameOffset, invalid.byteCount, bytes);
            const wchar character = L'a';
            StoreDumpRecord(nameOffset + sizeof(ULONG), character, bytes);
            if(invalid.includeTerminator){
                const wchar terminator = invalid.terminated ? L'\0' : L'x';
                StoreDumpRecord(nameOffset + sizeof(ULONG) + sizeof(wchar), terminator, bytes);
            }
            const auto actual = self.report(bytes);
            ASSERT_TRUE(actual);
            if(actual->find("module_load=invalid_module_list") != Log::CrashReportText::npos)
                ++invalidModuleReports;
        }
#endif
    }
    EXPECT_EQ(invalidModuleReports, 4u);
}

void VerifyMinidumpBoundaryTests_UnalignedExceptionAndContextRecordsKeepTheirBoundedValues(mut MinidumpBoundaryTests self){
    if(!IsWindowsLoggerCrashPlatform())
        return;

    String actualReport = String();
    native(mut self, mut actualReport){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        const auto original = ExceptionDump(self.m_testArena.arena, UnusedStream, 0u);
        constexpr usize s_ExceptionOffset = sizeof(MINIDUMP_HEADER) + 2u * sizeof(MINIDUMP_DIRECTORY);
        DumpBytes bytes(self.m_testArena.arena);
        bytes.resize(original.size() + 1u, 0u);
        FOUNDATION_MEMCPY(bytes.data(), bytes.size(), original.data(), s_ExceptionOffset);
        FOUNDATION_MEMCPY(bytes.data() + s_ExceptionOffset + 1u, bytes.size() - s_ExceptionOffset - 1u, original.data() + s_ExceptionOffset, original.size() - s_ExceptionOffset);
        MINIDUMP_DIRECTORY directory{};
        directory.StreamType = ExceptionStream;
        directory.Location.DataSize = sizeof(MINIDUMP_EXCEPTION_STREAM);
        directory.Location.Rva = s_ExceptionOffset + 1u;
        StoreDumpRecord(sizeof(MINIDUMP_HEADER), directory, bytes);
        MINIDUMP_EXCEPTION_STREAM exception{};
        exception.ThreadId = 1u;
        exception.ThreadContext.DataSize = sizeof(CONTEXT);
        exception.ThreadContext.Rva = s_ExceptionOffset + sizeof(MINIDUMP_EXCEPTION_STREAM) + 1u;
        StoreDumpRecord(s_ExceptionOffset + 1u, exception, bytes);
        const auto actual = self.report(bytes);
        ASSERT_TRUE(actual);
        actualReport.assign(actual->data(), actual->size());
#endif
    }
    EXPECT_TRUE(Contains(StringView(actualReport), "status=decoded"));
    EXPECT_FALSE(Contains(StringView(actualReport), "status=not_decoded"));
}

void VerifyLoggerClipboardText_EmptyInputOwnsOneTerminatedNativeString(){
    if(!IsWindowsLoggerCrashPlatform())
        return;

    LoggerTestArena testArena = LoggerTestArena();
    usize allocatedBytes = 0u;
    usize minimumBytes = 1u;
    b8 firstCharIsNull = false;
    b8 unlockedCleanly = false;
    native(mut testArena, mut allocatedBytes, mut minimumBytes, mut firstCharIsNull, mut unlockedCleanly){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        Log::FrameDetail::MessageDeque messages(testArena.arena);
        auto memory = Log::FrameDetail::BuildClipboardText(messages);
        ASSERT_TRUE(memory);
        allocatedBytes = static_cast<usize>(GlobalSize(memory->native()));
        minimumBytes = sizeof(tchar);
        const auto* const text = static_cast<const tchar*>(GlobalLock(memory->native()));
        ASSERT_NE(text, nullptr);
        firstCharIsNull = text[0] == tchar{};
        SetLastError(NO_ERROR);
        unlockedCleanly = GlobalUnlock(memory->native()) || GetLastError() == NO_ERROR;
#endif
    }
    EXPECT_GE(allocatedBytes, minimumBytes);
    EXPECT_TRUE(firstCharIsNull);
    EXPECT_TRUE(unlockedCleanly);
}

void VerifyLoggerClipboardText_MultipleUnicodeMessagesPreserveOrderCrLfAndTerminator(){
    if(!IsWindowsLoggerCrashPlatform())
        return;

    LoggerTestArena testArena = LoggerTestArena();
    usize allocatedBytes = 0u;
    usize minimumBytes = 1u;
    b8 contentMatches = false;
    b8 nullTerminated = false;
    b8 unlockedCleanly = false;
    native(mut testArena, mut allocatedBytes, mut minimumBytes, mut contentMatches, mut nullTerminated, mut unlockedCleanly){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        Log::FrameDetail::MessageDeque messages(testArena.arena);
        messages.emplace_back(Log::LogString(FOUNDATION_TEXT("first"), testArena.arena), Core::Common::LogType::Info);
        messages.emplace_back(Log::LogString(FOUNDATION_TEXT("\uD55C\uAE00 \u03A9"), testArena.arena), Core::Common::LogType::Warning);
        auto memory = Log::FrameDetail::BuildClipboardText(messages);
        ASSERT_TRUE(memory);
        constexpr TStringView s_Expected = FOUNDATION_TEXT("first\r\n\uD55C\uAE00 \u03A9\r\n");
        allocatedBytes = static_cast<usize>(GlobalSize(memory->native()));
        minimumBytes = (s_Expected.size() + 1u) * sizeof(tchar);
        const auto* const text = static_cast<const tchar*>(GlobalLock(memory->native()));
        ASSERT_NE(text, nullptr);
        contentMatches = TStringView(text, s_Expected.size()) == s_Expected;
        nullTerminated = text[s_Expected.size()] == tchar{};
        SetLastError(NO_ERROR);
        unlockedCleanly = GlobalUnlock(memory->native()) || GetLastError() == NO_ERROR;
#endif
    }
    EXPECT_GE(allocatedBytes, minimumBytes);
    EXPECT_TRUE(contentMatches);
    EXPECT_TRUE(nullTerminated);
    EXPECT_TRUE(unlockedCleanly);
}

void VerifyLoggerClipboardText_NativeOwnershipFreesUntransferredMemoryAndReleasesTransferredMemory(){
    if(!IsWindowsLoggerCrashPlatform())
        return;

    LoggerTestArena testArena = LoggerTestArena();
    b8 untransferredInvalidated = false;
    b8 transferredRemainsValid = false;
    usize transferredBytes = 0u;
    native(mut testArena, mut untransferredInvalidated, mut transferredRemainsValid, mut transferredBytes){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        Log::FrameDetail::MessageDeque messages(testArena.arena);
        HGLOBAL freed = nullptr;
        {
            auto memory = Log::FrameDetail::BuildClipboardText(messages);
            ASSERT_TRUE(memory);
            freed = memory->native();
        }
        untransferredInvalidated = GlobalFlags(freed) == GMEM_INVALID_HANDLE;
        HGLOBAL transferred = nullptr;
        {
            auto memory = Log::FrameDetail::BuildClipboardText(messages);
            ASSERT_TRUE(memory);
            transferred = memory->native();
            memory->release();
        }
        ScopeExit cleanup([&]()noexcept{
            if(transferred && GlobalFree(transferred))
                TerminateInvariant();
        });
        transferredRemainsValid = GlobalFlags(transferred) != GMEM_INVALID_HANDLE;
        transferredBytes = static_cast<usize>(GlobalSize(transferred));
#endif
    }
    EXPECT_TRUE(untransferredInvalidated);
    EXPECT_TRUE(transferredRemainsValid);
    EXPECT_NE(transferredBytes, 0u);
}

void VerifyLoggerClipboardText_ByteCountRejectsOverflowBeforeNativeAllocation(){
    if(!IsWindowsLoggerCrashPlatform())
        return;

    usize tcharBytes = 1u;
    usize emptyBytes = 0u;
    usize maxCharacters = 0u;
    usize boundaryBytes = 0u;
    b8 overflowRejected = false;
    b8 overflowValueTooLarge = false;
    native(mut tcharBytes, mut emptyBytes, mut maxCharacters, mut boundaryBytes, mut overflowRejected, mut overflowValueTooLarge){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        tcharBytes = sizeof(tchar);
        const auto empty = Log::FrameDetail::ClipboardByteCount(0u);
        ASSERT_TRUE(empty);
        emptyBytes = *empty;
        constexpr usize s_MaxCharacters = (Limit<usize>::s_Max / sizeof(tchar)) - 1u;
        maxCharacters = s_MaxCharacters;
        const auto boundary = Log::FrameDetail::ClipboardByteCount(s_MaxCharacters);
        ASSERT_TRUE(boundary);
        boundaryBytes = *boundary;
        const auto overflow = Log::FrameDetail::ClipboardByteCount(s_MaxCharacters + 1u);
        overflowRejected = !overflow.has_value();
        if(!overflow)
            overflowValueTooLarge = overflow.error() == MakeErrorCode(ErrorCondition::value_too_large);
#endif
    }
    EXPECT_EQ(emptyBytes, tcharBytes);
    EXPECT_EQ(boundaryBytes, (maxCharacters + 1u) * tcharBytes);
    EXPECT_TRUE(overflowRejected);
    EXPECT_TRUE(overflowValueTooLarge);
}


