////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Writable typed views over the shared StorageBuffer binding for SW-BVH build kernels. Dispatch-uniform slots:
// no NonUniformResourceIndex needed.


#ifndef NWB_GRAPHICS_BVH_HEAP_RESOURCES_SLANGI
#define NWB_GRAPHICS_BVH_HEAP_RESOURCES_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "bvh_common.slangi"
#include "../bindless/bindless_heap.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#pragma warning(push)
#pragma warning(disable: 39001) // Deliberate writable typed aliases of the global StorageBuffer descriptor table.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
RWStructuredBuffer<uint, Std430DataLayout> g_NwbHeapBvhWritableUintBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
globallycoherent RWStructuredBuffer<NwbBvhNode, Std430DataLayout> g_NwbHeapBvhWritableNodeBuffers[];
#pragma warning(pop)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

