////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_DEFERRED_LIGHTING_FRAMEWORK_SLANGI
#define NWB_GRAPHICS_DEFERRED_LIGHTING_FRAMEWORK_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Deferred lighting library: surface inputs + light list + shadow accessor. The pass owns the loop (load surface, dispatch BXDF, apply per-light visibility). Linear transport.


#include "binding_slots.h"
#include "bxdf_surface.slangi"
#include "bindless_resources.slangi"
#include "../scene/binding_slots.h"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Scene-shading cbuffer + light list are global-heap entries fetched via the per-frame slot cbuffer; declared below before the scene include so the slot resolves.
#define NWB_SCENE_SHADING_HEAP_SLOT g_NwbDeferredBindlessResources.avboitSlots.z
#define NWB_SCENE_LIGHT_LIST_HEAP_SLOT g_NwbDeferredBindlessResources.avboitSlots.w
// All inputs + selector are global-heap entries: no local descriptor set. Keep the selector macro alive through the cook-generated BXDF module (scene accessors expand there too).
struct NwbDeferredLightingPushConstants{
    uint resourceSlots;
    uint presentationMode;
};

[[vk::push_constant]] ConstantBuffer<NwbDeferredLightingPushConstants> g_NwbDeferredLightingPushConstants;

#define g_NwbDeferredBindlessResources g_NwbHeapDeferredBindlessResources[g_NwbDeferredLightingPushConstants.resourceSlots]


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


bool nwbDeferredPresentationIsHdr10(){
    return g_NwbDeferredLightingPushConstants.presentationMode == NWB_DEFERRED_PRESENTATION_HDR10;
}

// This presentation query describes the output surface; transport passes use radiance.
bool nwbBxdfPresentationIsHdr10(){
    return nwbDeferredPresentationIsHdr10();
}

// Authored BXDFs return linear radiance in all harnesses. Display mapping runs once after composition, so reflected samples and fresh hits share one color space.
bool nwbBxdfRequiresLinearOutput(){
    return true;
}

#define NWB_SCENE_SHADOW_VISIBILITY_RESOURCE nwbHeapSampledImage2DArray(g_NwbDeferredBindlessResources.lightingSlots.x)
#define NWB_SCENE_CAUSTIC_IRRADIANCE_RESOURCE nwbHeapSampledImage2D(g_NwbDeferredBindlessResources.lightingSlots.y)
// Brings math helpers, scene/buffer accessors, and the engine-owned transport. Project BXDFs own their BRDF, light-loop, and tone-map policy.
#include "../scene/lighting.slangi"
#undef NWB_SCENE_SHADOW_VISIBILITY_RESOURCE
#undef NWB_SCENE_CAUSTIC_IRRADIANCE_RESOURCE


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Resolved surfel irradiance texture (rgb = indirect, a = coverage). Lighting reads this, not the RW pool: no frames-in-flight race. Cleared to 0 when GI is off.

// Indirect irradiance for the OPAQUE path: blend the normalized surfel field with hemiAmbient by coverage. The resolve texture is 1:1 with the screen, so sample this pixel.
half3 nwbBxdfResolvedIndirect(const int2 pixel, float3 normalVector){
    const half4 resolved = half4(nwbHeapSampledImage2D(g_NwbDeferredBindlessResources.lightingSlots.z).Load(int3(pixel, 0)));
    return lerp(nwbGiHemiAmbient(normalVector), half3(resolved.rgb), saturate(resolved.a));
}

// NwbBxdfSurface (the BXDF parameter type) is shared with the transparent / AVBOIT accumulate path; it lives in deferred/bxdf_surface.slangi, included above.


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


float3 nwbDeferredDecodeNormal(half3 value){
    return nwbSafeNormalize(float3(value) * 2.0 - 1.0, float3(0.0, 0.0, 1.0));
}

// Unpack the G-buffer at one screen texel into the BXDF surface. Mip-0 Loads match the Graphics point sampler with no implicit derivatives in this Compute shader.
NwbBxdfSurface nwbBxdfLoadSurface(const int2 pixel){
    const int3 texel = int3(pixel, 0);
    const half4 baseColorSample = half4(nwbHeapSampledImage2D(g_NwbDeferredBindlessResources.gbufferSlots.x).Load(texel));
    const half4 normalSample = half4(nwbHeapSampledImage2D(g_NwbDeferredBindlessResources.gbufferSlots.y).Load(texel));
    // Every G-buffer color/vector attachment is RGBA16F. Keep this payload native-half until the FP32 world-space shading below.
    const half4 worldSample = half4(nwbHeapSampledImage2D(g_NwbDeferredBindlessResources.gbufferSlots.z).Load(texel));
    const float depth = nwbHeapSampledImage2D(g_NwbDeferredBindlessResources.gbufferSlots.w).Load(texel).r;

    NwbBxdfSurface surface;
    surface.baseColor = baseColorSample.rgb;
    surface.shadingModel = uint(float(baseColorSample.a) + 0.5);
    surface.normal = nwbDeferredDecodeNormal(normalSample.rgb);
    surface.param0 = normalSample.a;
    surface.worldPosition = float3(worldSample.xyz);
    surface.param1 = worldSample.a;
    surface.viewVector = nwbSafeNormalize(g_NwbSceneCameraPosition.xyz - surface.worldPosition, float3(0.0, 0.0, 1.0));
    surface.isBackground = depth >= NWB_SCENE_BACKGROUND_DEPTH;
    surface.indirectIrradiance = nwbBxdfResolvedIndirect(pixel, surface.normal);
    return surface;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

