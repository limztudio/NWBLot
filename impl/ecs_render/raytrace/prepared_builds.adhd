#include <impl/ecs_render/raytrace/graph_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// A BLAS build derives geometry from retained buffers. Keep the resolved op, not a mesh pointer: meshes may prune before record.
class PreparedMeshBlasBuild{
    public Name meshName = Name();
    public RayTraceBufferHandle positionBuffer = RayTraceBufferHandle();
    public RayTraceBufferHandle triangleIndexBuffer = RayTraceBufferHandle();
    public RayTraceAccelStructHandle blas = RayTraceAccelStructHandle();
    public RayTraceBufferHandle blasBackingBuffer = RayTraceBufferHandle();
    public u64 runtimeMeshVersion = 0u;
    public u64 geometryContentRevision = 0u;
    public u64 acceptedGeometryContentRevision = 0u;
    public usize positionByteSize = 0u;
    public u32 vertexStride = 0u;
    public u32 vertexCount = 0u;
    public u32 indexCount = 0u;
    public u32 refitsBeforeBuild = 0u;
    public u32 refitsAfterBuild = 0u;
    public b8 runtimeMesh = false;
    public b8 buildPending = false;
    public b8 firstBuild = false;
    public b8 backingFresh = false;
    public b8 performRefit = false;
}


// The software builder shares global scratch; one frozen op retains mesh inputs/outputs plus the scratch generation.
// Never retain MeshResources pointers: runtime geometry can be replaced or pruned between preflight and Shadow Preparation recording.
class PreparedMeshSwBvhBuild{
    public Name meshName = Name();
    public RayTraceBufferHandle positionBuffer = RayTraceBufferHandle();
    public RayTraceBufferHandle triangleIndexBuffer = RayTraceBufferHandle();
    public RayTraceBufferHandle nodeBuffer = RayTraceBufferHandle();
    public RayTraceBufferHandle parentBuffer = RayTraceBufferHandle();
    public RayTraceBufferHandle sortKeysBuffer = RayTraceBufferHandle();
    public RayTraceBufferHandle sortPayloadBuffer = RayTraceBufferHandle();
    public RayTraceBufferHandle visitCounterBuffer = RayTraceBufferHandle();
    public RayTraceDescriptorHandle positionHeapHandle = RayTraceDescriptorHandle();
    public RayTraceDescriptorHandle triangleIndexHeapHandle = RayTraceDescriptorHandle();
    public RayTraceDescriptorHandle nodeHeapHandle = RayTraceDescriptorHandle();
    public RayTraceDescriptorHandle parentHeapHandle = RayTraceDescriptorHandle();
    public RayTraceDescriptorHandle sortKeysHeapHandle = RayTraceDescriptorHandle();
    public RayTraceDescriptorHandle sortPayloadHeapHandle = RayTraceDescriptorHandle();
    public RayTraceDescriptorHandle visitCounterHeapHandle = RayTraceDescriptorHandle();
    public f32x3_i32 aabbMin = f32x3_i32(0.0f, 0.0f, 0.0f, 0);
    public f32x3_i32 aabbMax = f32x3_i32(0.0f, 0.0f, 0.0f, 0);
    public u64 runtimeMeshVersion = 0u;
    public u64 geometryContentRevision = 0u;
    public u64 acceptedGeometryContentRevision = 0u;
    public usize positionByteSize = 0u;
    public usize indexByteSize = 0u;
    public usize nodeByteSize = 0u;
    public usize parentByteSize = 0u;
    public usize sortKeysByteSize = 0u;
    public usize sortPayloadByteSize = 0u;
    public usize visitCounterByteSize = 0u;
    public u32 primitiveCount = 0u;
    public u32 refitsBeforeBuild = 0u;
    public u32 refitsAfterBuild = 0u;
    public b8 runtimeMesh = false;
    public b8 buildPending = false;
    public b8 firstBuild = false;
    public b8 performRefit = false;
}


// Scene traversal consumes one descriptor entry per distinct mesh. Own the handles so recording sees preparation's set.
class PreparedSceneSwBvhMesh{
    public Name meshName = Name();
    public RayTraceBufferHandle nodeBuffer = RayTraceBufferHandle();
    public RayTraceBufferHandle positionBuffer = RayTraceBufferHandle();
    public RayTraceBufferHandle triangleIndexBuffer = RayTraceBufferHandle();
    public RayTraceBufferHandle attributeBuffer = RayTraceBufferHandle();
    public RayTraceDescriptorHandle nodeHeapHandle = RayTraceDescriptorHandle();
    public RayTraceDescriptorHandle positionHeapHandle = RayTraceDescriptorHandle();
    public RayTraceDescriptorHandle triangleIndexHeapHandle = RayTraceDescriptorHandle();
    public RayTraceDescriptorHandle attributeHeapHandle = RayTraceDescriptorHandle();
    public u64 runtimeMeshVersion = 0u;
    public u64 geometryContentRevision = 0u;
    public usize nodeByteSize = 0u;
    public usize positionByteSize = 0u;
    public usize triangleIndexByteSize = 0u;
    public usize attributeByteSize = 0u;
    public u32 primitiveCount = 0u;
    public b8 runtimeMesh = false;
}


