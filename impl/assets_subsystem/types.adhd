////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Name s_SubsystemLoadBinaryArena = "impl/assets_subsystem/load_binary";
const Name s_SubsystemSerializeArena = "impl/assets_subsystem/serialize";

const StringView s_SubsystemDiagnosticPrefix = "Subsystem meta";
const StringView s_SubsystemSubsystemsFieldName = "subsystems";

const u32 s_SubsystemMagic = 0x53554231u; // SUB1
const u32 s_SubsystemVersion = 1u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SubsystemFieldValueDescriptor{
    public StringView fieldName = "";
    public Name expectedAssetType = s_NameNone;
    public b8 isArray = false;
}

[serialize]
class SubsystemHeaderBinary{
    public u32 magic = s_SubsystemMagic;
    public u32 version = s_SubsystemVersion;
    public NameHash subsystemTypeHash;
    public u64 subsystemCount = 0u;
    public u64 fieldCount = 0u;
    public u64 assetCount = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 TrySumSubsystemFieldElementCounts(in Span<u64> fieldCounts, mut u64 outTotalCount){
    u64 totalCount = 0u;
    for(usize i = 0u; i < fieldCounts.size(); ++i){
        u64 count = fieldCounts[i];
        if(count == 0u || count > 0xFFFFFFFFFFFFFFFFu - totalCount)
            return false;
        totalCount += count;
    }
    outTotalCount = totalCount;
    return true;
}


