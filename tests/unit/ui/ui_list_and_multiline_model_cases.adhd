void VerifyUiListReconciliationTests_ReorderingRetainsStableSelectionAndCursorKeys(){
    UiListReconcileRangeSource source = UiListReconcileRangeSource();
    ListState state = ListState();
    state.select(5u);
    ASSERT_TRUE(UiListReconcile(state, source));
    ListOptions options = ListOptions();
    options.selectOnNavigate = false;
    ListResult result = ListResult();
    ASSERT_TRUE(UiListReconcileApply(source, options, MakeUiListReconcileAction(state, source, ControlActionKind::Down), state, result));
    ASSERT_EQ(state.cursorKey(), 6u);
    source.reversed = true;
    ++source.revisionValue;
    ASSERT_TRUE(UiListReconcile(state, source));
    EXPECT_EQ(state.selectedKey(), 5u);
    EXPECT_EQ(state.cursorKey(), 6u);
}

void VerifyUiListReconciliationTests_RemovedCursorClearsIndependentlyOfSurvivingSelection(){
    UiListReconcileRangeSource source = UiListReconcileRangeSource();
    ListState state = ListState();
    state.select(5u);
    ASSERT_TRUE(UiListReconcile(state, source));
    ListOptions options = ListOptions();
    options.selectOnNavigate = false;
    ListResult result = ListResult();
    ASSERT_TRUE(UiListReconcileApply(source, options, MakeUiListReconcileAction(state, source, ControlActionKind::Down), state, result));
    source.count = 5u;
    ++source.revisionValue;
    ASSERT_TRUE(UiListReconcile(state, source));
    EXPECT_EQ(state.selectedKey(), 5u);
    EXPECT_EQ(state.cursorKey(), 0u);
}

void VerifyUiListReconciliationTests_DisabledSelectionClearsIndependentlyOfEnabledCursor(){
    UiListReconcileRangeSource source = UiListReconcileRangeSource();
    ListState state = ListState();
    state.select(5u);
    ASSERT_TRUE(UiListReconcile(state, source));
    ListOptions options = ListOptions();
    options.selectOnNavigate = false;
    ListResult result = ListResult();
    ASSERT_TRUE(UiListReconcileApply(source, options, MakeUiListReconcileAction(state, source, ControlActionKind::Down), state, result));
    source.disabledBegin = 4u;
    source.disabledEnd = 5u;
    ++source.revisionValue;
    ASSERT_TRUE(UiListReconcile(state, source));
