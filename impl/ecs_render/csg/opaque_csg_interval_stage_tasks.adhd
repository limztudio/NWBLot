#include <impl/ecs_render/kernel/renderer_constants_private.adhd>
#include <impl/ecs_render/kernel/task_graph_resource_utils.adhd>
#include <impl/ecs_render/kernel/task_graph_clear_timing.adhd>
#include <impl/ecs_render/material/task_graph_resource_sets.adhd>
#include <impl/ecs_render/shared/renderer_frame_bindings.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void OpaqueCsgIntervalStage::capturePayloads(
    in MeshFrameBindingSnapshot frameBindings,
    in CsgGraphResourceSnapshot csgResources,
    in MaterialPassDrawItemPartitionsView opaqueDrawItems,
    in CsgFrameGpuDataView csgFrameData,
    in usize instanceCount,
    in usize materialTypedByteCount,
    in b8 materialDrawBuffersUploaded,
    in b8 csgFrameBuffersUploaded,
    in b8 hasOpaqueDrawItems,
    in b8 hasOpaqueCsgFrameWork
){
    this.m_receiverSpanPayload.inputs.frameBindings = frameBindings;
    this.m_intervalCombinePayload.inputs.frameBindings = frameBindings;
    this.m_intervalSamplePayload.inputs.frameBindings = frameBindings;
    this.m_intervalSamplePayload.inputs.csgResources = csgResources;
    this.m_intervalSampleComputeEmulationPayload.frameBindings = frameBindings;
    if(!hasOpaqueCsgFrameWork)
        return;

    // The graph owns the producer fence chain. Normal prefix merges with G-buffer; FrontierSafe keeps each ticket.
    this.m_receiverSpanPayload.inputs.materialDrawBuffersUploaded = materialDrawBuffersUploaded;
    this.m_receiverSpanPayload.inputs.csgFrameBuffersUploaded = csgFrameBuffersUploaded;
    this.m_receiverSpanPayload.inputs.csgResources = csgResources;
    this.m_receiverSpanPayload.inputs.opaqueDrawSnapshot.capture(opaqueDrawItems, csgFrameData, instanceCount, materialTypedByteCount);
    this.m_intervalCombinePayload.inputs.materialDrawBuffersUploaded = materialDrawBuffersUploaded;
    this.m_intervalCombinePayload.inputs.csgFrameBuffersUploaded = csgFrameBuffersUploaded;
    this.m_intervalCombinePayload.inputs.csgResources = csgResources;
    this.m_intervalCombinePayload.inputs.opaqueDrawSnapshot.capture(opaqueDrawItems, csgFrameData, instanceCount, materialTypedByteCount);
    this.m_intervalSamplePayload.inputs.materialDrawBuffersUploaded = materialDrawBuffersUploaded;
    this.m_intervalSamplePayload.inputs.csgFrameBuffersUploaded = csgFrameBuffersUploaded;
    this.m_intervalSamplePayload.materialFrameStatesGraphOwned = hasOpaqueDrawItems;
    this.m_intervalSamplePayload.inputs.opaqueDrawSnapshot.capture(opaqueDrawItems, csgFrameData, instanceCount, materialTypedByteCount);
}

Expected<OpaqueCsgIntervalStageTasks> OpaqueCsgIntervalStage::declare(in OpaqueCsgIntervalStageInputs inputs, mut ObjectGeometryCacheGraph objectGeometry){

    FixedVector<GpuTaskResourceUse, s_CsgReceiverSpanResourceUseCapacity> csgReceiverSpanResourceUses;
    FixedVector<GpuTaskResourceUse, s_CsgIntervalCombineResourceUseCapacity> csgIntervalCombineResourceUses;
    csgReceiverSpanResourceUses.push_back(ReadTextureUse(inputs.resources.csgReceiverEventData, inputs.resources.csgReceiverEventDataSubresources, ResourceStates::UnorderedAccess));
    csgReceiverSpanResourceUses.push_back(ReadTextureUse(inputs.resources.csgReceiverEventCount, inputs.resources.csgReceiverEventCountSubresources, ResourceStates::UnorderedAccess));
    if(inputs.hasCsgFrameGpuWork){
        csgReceiverSpanResourceUses.push_back(ReadUse(inputs.resources.csgClipContextSlots, ResourceStates::ConstantBuffer));
        csgReceiverSpanResourceUses.push_back(ReadUse(inputs.resources.currentBindlessSlots, ResourceStates::ConstantBuffer));
    }
    csgReceiverSpanResourceUses.push_back(WriteTextureUse(inputs.resources.csgReceiverSpanData, inputs.resources.csgReceiverSpanDataSubresources, ResourceStates::UnorderedAccess));
    csgReceiverSpanResourceUses.push_back(WriteTextureUse(inputs.resources.csgReceiverSpanCount, inputs.resources.csgReceiverSpanCountSubresources, ResourceStates::UnorderedAccess));
    csgIntervalCombineResourceUses.push_back(ReadTextureUse(inputs.resources.csgCapBackNormal, inputs.resources.csgPeelSubresources, ResourceStates::UnorderedAccess));
    csgIntervalCombineResourceUses.push_back(ReadTextureUse(inputs.resources.csgIntervalDepth, inputs.resources.csgPeelSubresources, ResourceStates::UnorderedAccess));
    csgIntervalCombineResourceUses.push_back(ReadTextureUse(inputs.resources.csgIntervalId, inputs.resources.csgPeelSubresources, ResourceStates::UnorderedAccess));
    csgIntervalCombineResourceUses.push_back(ReadTextureUse(inputs.resources.csgReceiverSpanData, inputs.resources.csgReceiverSpanDataSubresources, ResourceStates::UnorderedAccess));
    csgIntervalCombineResourceUses.push_back(ReadTextureUse(inputs.resources.csgReceiverSpanCount, inputs.resources.csgReceiverSpanCountSubresources, ResourceStates::UnorderedAccess));
    if(inputs.hasCsgFrameGpuWork){
        csgIntervalCombineResourceUses.push_back(ReadUse(inputs.resources.csgClipContextSlots, ResourceStates::ConstantBuffer));
        csgIntervalCombineResourceUses.push_back(ReadUse(inputs.resources.currentBindlessSlots, ResourceStates::ConstantBuffer));
    }
    csgIntervalCombineResourceUses.push_back(WriteTextureUse(inputs.resources.csgRemovedIntervalDepth, inputs.resources.csgRemovedIntervalSubresources, ResourceStates::UnorderedAccess));
    csgIntervalCombineResourceUses.push_back(WriteTextureUse(inputs.resources.csgRemovedIntervalCapNormal, inputs.resources.csgRemovedIntervalSubresources, ResourceStates::UnorderedAccess));
    csgIntervalCombineResourceUses.push_back(WriteTextureUse(inputs.resources.csgRemovedIntervalData, inputs.resources.csgRemovedIntervalSubresources, ResourceStates::UnorderedAccess));
    csgIntervalCombineResourceUses.push_back(WriteTextureUse(inputs.resources.csgRemovedIntervalCount, inputs.resources.csgRemovedIntervalCountSubresources, ResourceStates::UnorderedAccess));

    OpaqueCsgIntervalStageTasks tasks;
    GpuGraphResourceSetId opaqueCsgIntervalSampleComputeEmulationOutputSet;
    GpuTaskSchedulingHint csgReceiverSpanScheduling;
    csgReceiverSpanScheduling.cost = GpuTaskCostHint::Medium;
    csgReceiverSpanScheduling.forceSubmissionBoundary = false;
    csgReceiverSpanScheduling.allowPacketMerge = true;
    csgReceiverSpanScheduling.mergeWithPrevious = true;
    GpuTaskDesc csgReceiverSpanDesc;
    csgReceiverSpanDesc
        .setIdentity(Name(s_RenderNameRenderGraphicsPrefixCsgReceiverSpan))
        .setMarkerLabel("Opaque CSG Receiver Span")
        .setScheduling(csgReceiverSpanScheduling)
        .setDependency(inputs.dependencyTask)
        .setResourceUses(csgReceiverSpanResourceUses)
    ;
    const auto receiverSpanTaskResult = this.m_graph.addPreparedPayloadTask(csgReceiverSpanDesc, this.m_receiverSpanPayload);
    if(!receiverSpanTaskResult.has_value()){
        tasks.receiverSpanTask = GpuTaskId();
        warning("RendererSystem: could not declare opaque CSG receiver-span task");
        return MakeUnexpected(Failure());
    }
    tasks.receiverSpanTask = receiverSpanTaskResult.value();

    GpuTaskSchedulingHint csgIntervalCombineScheduling;
    csgIntervalCombineScheduling.cost = GpuTaskCostHint::Medium;
    csgIntervalCombineScheduling.forceSubmissionBoundary = false;
    csgIntervalCombineScheduling.allowPacketMerge = true;
    csgIntervalCombineScheduling.mergeWithPrevious = true;
    GpuTaskDesc csgIntervalCombineDesc;
    csgIntervalCombineDesc
        .setIdentity(Name(s_RenderNameRenderGraphicsPrefixCsgIntervalCombine))
        .setMarkerLabel("Opaque CSG Interval Combine")
        .setScheduling(csgIntervalCombineScheduling)
        .setDependency(tasks.receiverSpanTask)
        .setResourceUses(csgIntervalCombineResourceUses)
    ;
    const auto intervalCombineTaskResult = this.m_graph.addPreparedPayloadTask(csgIntervalCombineDesc, this.m_intervalCombinePayload);
    if(!intervalCombineTaskResult.has_value()){
        tasks.intervalCombineTask = GpuTaskId();
        warning("RendererSystem: could not declare opaque CSG interval-combine task");
        return MakeUnexpected(Failure());
    }
    tasks.intervalCombineTask = intervalCombineTaskResult.value();

    Vector<GpuTaskResourceUse> csgIntervalSampleResourceUses;
    GpuGraphResourceSetId csgIntervalSampleMaterialGeometrySet;
    GpuGraphResourceSetId csgIntervalSampleMaterialSampledTextureSet;
    const Array<MaterialPassDrawItemsView, 1u> csgIntervalSampleMaterialGeometryDrawSets(inputs.opaqueDrawItems.csg);
    const b8 csgIntervalSampleUsesMaterialGeometry = !inputs.opaqueDrawItems.csg.empty();
    this.m_intervalSamplePayload.materialGeometryStatesGraphOwned = false;
    if(csgIntervalSampleUsesMaterialGeometry){
        const auto csgIntervalSampleMaterialGeometrySetResult = GatherPreparedMaterialGeometryResourceSet(
            csgIntervalSampleMaterialGeometryDrawSets,
            Name(s_RenderNameRenderGraphicsPrefixCsgIntervalSampleMaterialGeometry),
            "Opaque CSG Material Geometry",
            this.m_graph
        );
        this.m_intervalSamplePayload.materialGeometryStatesGraphOwned = csgIntervalSampleMaterialGeometrySetResult.has_value();
        if(csgIntervalSampleMaterialGeometrySetResult.has_value())
            csgIntervalSampleMaterialGeometrySet = csgIntervalSampleMaterialGeometrySetResult.value();
    }
    if(csgIntervalSampleUsesMaterialGeometry && !this.m_intervalSamplePayload.materialGeometryStatesGraphOwned){
        warning("RendererSystem: could not declare prepared opaque CSG material geometry states");
        return MakeUnexpected(Failure());
    }
    b8 csgIntervalSampleMaterialSampledTexturesCollected = false;
    if(csgIntervalSampleUsesMaterialGeometry){
        const auto csgIntervalSampleMaterialSampledTextureSetResult = GatherPreparedMaterialSampledTextureResourceSet(
            this.m_materialSystem,
            csgIntervalSampleMaterialGeometryDrawSets,
            Name(s_RenderNameRenderGraphicsPrefixCsgIntervalSampleMaterialSampledTextures),
            "Opaque CSG Material Sampled Textures",
            this.m_graph
        );
        csgIntervalSampleMaterialSampledTexturesCollected = csgIntervalSampleMaterialSampledTextureSetResult.has_value();
        if(csgIntervalSampleMaterialSampledTextureSetResult.has_value())
            csgIntervalSampleMaterialSampledTextureSet = csgIntervalSampleMaterialSampledTextureSetResult.value();
    }
    if(csgIntervalSampleUsesMaterialGeometry && !csgIntervalSampleMaterialSampledTexturesCollected){
        warning("RendererSystem: could not declare prepared opaque CSG material sampled textures");
        return MakeUnexpected(Failure());
    }

    // Interval-sample material follows Combine immediately, unlike opaque/receiver work. Sample rasterizes right after.
    // That makes pairwise-distinct outputs graph-ownable without excluding earlier regular/receiver aliases.
    const b8 opaqueCsgIntervalSampleComputeEmulationPlanCaptured = CanCaptureOpaqueCsgIntervalSampleComputeEmulationPlan(
        inputs.hasCsgFrameGpuWork,
        this.m_intervalSamplePayload.materialFrameStatesGraphOwned,
        this.m_intervalSamplePayload.materialGeometryStatesGraphOwned,
        csgIntervalSampleMaterialSampledTexturesCollected
    ) && this.m_intervalSampleComputeEmulationPayload.plan.capture(inputs.opaqueDrawItems.csg, inputs.csgFrameData);
    b8 opaqueCsgIntervalSampleComputeEmulationOutputStatesGraphOwned = false;
    if(opaqueCsgIntervalSampleComputeEmulationPlanCaptured){
        const auto opaqueCsgIntervalSampleComputeEmulationOutputSetResult = GatherImportedOutputBufferResourceSet(
            this.m_graph,
            this.m_intervalSampleComputeEmulationPayload.plan.geometry.generated.captured,
            this.m_intervalSampleComputeEmulationPayload.plan.geometry.generated.outputBuffers,
            Name(s_RenderNameRenderGraphicsPrefixOpaqueCsgIntervalSampleComputeEmulationOutputs),
            "Opaque CSG Interval-Sample Compute Emulation Outputs"
        );
        opaqueCsgIntervalSampleComputeEmulationOutputStatesGraphOwned = opaqueCsgIntervalSampleComputeEmulationOutputSetResult.has_value();
        if(opaqueCsgIntervalSampleComputeEmulationOutputSetResult.has_value())
            opaqueCsgIntervalSampleComputeEmulationOutputSet = opaqueCsgIntervalSampleComputeEmulationOutputSetResult.value();
    }
    if(opaqueCsgIntervalSampleComputeEmulationPlanCaptured && !opaqueCsgIntervalSampleComputeEmulationOutputStatesGraphOwned)
        warning("RendererSystem: could not declare graph-owned opaque CSG interval-sample compute-emulation outputs");
    this.m_intervalSamplePayload.csgComputeEmulationOutputStatesGraphOwned = opaqueCsgIntervalSampleComputeEmulationOutputStatesGraphOwned;
    if(opaqueCsgIntervalSampleComputeEmulationOutputStatesGraphOwned)
        this.m_intervalSamplePayload.opaqueCsgComputeEmulationTiming = Optional<mut Optional<GpuTimingMeasure>>(this.m_intervalSampleComputeEmulationTiming);
    else
        this.m_intervalSamplePayload.opaqueCsgComputeEmulationTiming.reset();
    // Material instance and typed-material reads.
    csgIntervalSampleResourceUses.reserve(ComputeOpaqueCsgIntervalSampleResourceUseCapacity(inputs.hasOpaqueDrawItems, inputs.hasCsgFrameGpuWork));
    csgIntervalSampleResourceUses.push_back(ReadUse(inputs.resources.meshView, ResourceStates::ConstantBuffer));
    if(inputs.hasOpaqueDrawItems){
        csgIntervalSampleResourceUses.push_back(ReadBufferUse(inputs.resources.materialInstances, inputs.materialInstanceRange));
        csgIntervalSampleResourceUses.push_back(ReadBufferUse(inputs.resources.materialTyped, inputs.materialTypedRange));
    }
    if(inputs.hasCsgFrameGpuWork){
        csgIntervalSampleResourceUses.push_back(ReadBufferUse(inputs.resources.csgReceiverRanges, inputs.csgReceiverRange));
        csgIntervalSampleResourceUses.push_back(ReadBufferUse(inputs.resources.csgCutters, inputs.csgCutterRange));
        csgIntervalSampleResourceUses.push_back(ReadUse(inputs.resources.csgClipContextSlots, ResourceStates::ConstantBuffer));
        csgIntervalSampleResourceUses.push_back(ReadUse(inputs.resources.csgIntervalSampleState, ResourceStates::ConstantBuffer));
        csgIntervalSampleResourceUses.push_back(ReadUse(inputs.resources.currentBindlessSlots, ResourceStates::ConstantBuffer));
    }
    csgIntervalSampleResourceUses.push_back(ReadTextureUse(inputs.resources.csgRemovedIntervalDepth, inputs.resources.csgRemovedIntervalSubresources, ResourceStates::UnorderedAccess));
    csgIntervalSampleResourceUses.push_back(ReadTextureUse(inputs.resources.csgRemovedIntervalCapNormal, inputs.resources.csgRemovedIntervalSubresources, ResourceStates::UnorderedAccess));
    csgIntervalSampleResourceUses.push_back(ReadTextureUse(inputs.resources.csgRemovedIntervalData, inputs.resources.csgRemovedIntervalSubresources, ResourceStates::UnorderedAccess));
    csgIntervalSampleResourceUses.push_back(ReadTextureUse(inputs.resources.csgRemovedIntervalCount, inputs.resources.csgRemovedIntervalCountSubresources, ResourceStates::UnorderedAccess));
    csgIntervalSampleResourceUses.push_back(ReadWriteUse(inputs.resources.albedo, ResourceStates::RenderTarget));
    csgIntervalSampleResourceUses.push_back(ReadWriteUse(inputs.resources.normal, ResourceStates::RenderTarget));
    csgIntervalSampleResourceUses.push_back(ReadWriteUse(inputs.resources.worldPosition, ResourceStates::RenderTarget));
    csgIntervalSampleResourceUses.push_back(ReadWriteUse(inputs.resources.specularRoughness, ResourceStates::RenderTarget));
    csgIntervalSampleResourceUses.push_back(ReadWriteUse(inputs.resources.depth, ResourceStates::DepthWrite));
    const GpuTaskResourceSetUse csgIntervalSampleMaterialGeometrySetUse = MakeResourceSetUse(csgIntervalSampleMaterialGeometrySet, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
    const GpuTaskResourceSetUse csgIntervalSampleMaterialSampledTextureSetUse = MakeResourceSetUse(csgIntervalSampleMaterialSampledTextureSet, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
    const GpuTaskResourceSetUse opaqueCsgIntervalSampleComputeEmulationOutputUavSetUse = MakeResourceSetUse(opaqueCsgIntervalSampleComputeEmulationOutputSet, ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write);
    const GpuTaskResourceSetUse opaqueCsgIntervalSampleComputeEmulationOutputVertexBufferSetUse = MakeResourceSetUse(opaqueCsgIntervalSampleComputeEmulationOutputSet, s_ObjectGeometryRasterState, GpuTaskResourceAccess::Read);
    FixedVector<GpuTaskResourceSetUse, s_OpaqueCsgIntervalSampleResourceSetUseCapacity> csgIntervalSampleMaterialResourceSetUses;
    if(this.m_intervalSamplePayload.materialGeometryStatesGraphOwned)
        csgIntervalSampleMaterialResourceSetUses.push_back(csgIntervalSampleMaterialGeometrySetUse);
    if(csgIntervalSampleMaterialSampledTextureSet.valid())
        csgIntervalSampleMaterialResourceSetUses.push_back(csgIntervalSampleMaterialSampledTextureSetUse);
    if(opaqueCsgIntervalSampleComputeEmulationOutputStatesGraphOwned)
        csgIntervalSampleMaterialResourceSetUses.push_back(opaqueCsgIntervalSampleComputeEmulationOutputVertexBufferSetUse);

    GpuTaskId csgIntervalSampleDependency = tasks.intervalCombineTask;
    if(this.m_intervalSamplePayload.inputs.materialDrawBuffersUploaded && !objectGeometry.prepare(
        inputs.opaqueDrawItems.csg.indexedDrawItems,
        inputs.frameBindings, csgIntervalSampleDependency, csgIntervalSampleResourceUses,
        GraphicsPrefixTimingTicket(), inputs.intervalSampleTimingTicket
    ))
        return MakeUnexpected(Failure());
    if(opaqueCsgIntervalSampleComputeEmulationOutputStatesGraphOwned){
        this.m_intervalSampleComputeEmulationPayload.csgResources = inputs.csgResources;
        // Producer and sample share one CSG interval-sample ticket, spanning compute through the raster half.
        this.m_intervalSampleComputeEmulationPayload.instanceCount = inputs.instanceCount;
        this.m_intervalSampleComputeEmulationPayload.materialTypedByteCount = inputs.materialTypedByteCount;
        this.m_intervalSampleComputeEmulationPayload.materialDrawBuffersUploaded = this.m_intervalSamplePayload.inputs.materialDrawBuffersUploaded;
        this.m_intervalSampleComputeEmulationPayload.csgFrameBuffersUploaded = this.m_intervalSamplePayload.inputs.csgFrameBuffersUploaded;
        this.m_intervalSampleComputeEmulationPayload.materialFrameStatesGraphOwned = this.m_intervalSamplePayload.materialFrameStatesGraphOwned;
        this.m_intervalSampleComputeEmulationPayload.materialGeometryStatesGraphOwned = this.m_intervalSamplePayload.materialGeometryStatesGraphOwned;

        const Array<GpuTaskResourceUse, 12u> opaqueCsgIntervalSampleComputeEmulationResourceUses(
            ReadUse(inputs.resources.meshView, ResourceStates::ConstantBuffer),
            ReadBufferUse(inputs.resources.materialInstances, inputs.materialInstanceRange),
            ReadBufferUse(inputs.resources.materialTyped, inputs.materialTypedRange),
            ReadBufferUse(inputs.resources.csgReceiverRanges, inputs.csgReceiverRange),
            ReadBufferUse(inputs.resources.csgCutters, inputs.csgCutterRange),
            ReadUse(inputs.resources.csgClipContextSlots, ResourceStates::ConstantBuffer),
            ReadUse(inputs.resources.csgIntervalSampleState, ResourceStates::ConstantBuffer),
            ReadUse(inputs.resources.currentBindlessSlots, ResourceStates::ConstantBuffer),
            ReadTextureUse(inputs.resources.csgRemovedIntervalDepth, inputs.resources.csgRemovedIntervalSubresources, ResourceStates::UnorderedAccess),
            ReadTextureUse(inputs.resources.csgRemovedIntervalCapNormal, inputs.resources.csgRemovedIntervalSubresources, ResourceStates::UnorderedAccess),
            ReadTextureUse(inputs.resources.csgRemovedIntervalData, inputs.resources.csgRemovedIntervalSubresources, ResourceStates::UnorderedAccess),
            ReadTextureUse(inputs.resources.csgRemovedIntervalCount, inputs.resources.csgRemovedIntervalCountSubresources, ResourceStates::UnorderedAccess));
        FixedVector<GpuTaskResourceSetUse, s_OpaqueCsgIntervalSampleResourceSetUseCapacity> opaqueCsgIntervalSampleComputeEmulationResourceSetUses;
        opaqueCsgIntervalSampleComputeEmulationResourceSetUses.push_back(csgIntervalSampleMaterialGeometrySetUse);
        if(csgIntervalSampleMaterialSampledTextureSet.valid())
            opaqueCsgIntervalSampleComputeEmulationResourceSetUses.push_back(csgIntervalSampleMaterialSampledTextureSetUse);
        opaqueCsgIntervalSampleComputeEmulationResourceSetUses.push_back(opaqueCsgIntervalSampleComputeEmulationOutputUavSetUse);
        GpuTaskSchedulingHint opaqueCsgIntervalSampleComputeEmulationScheduling;
        opaqueCsgIntervalSampleComputeEmulationScheduling.cost = GpuTaskCostHint::Medium;
        opaqueCsgIntervalSampleComputeEmulationScheduling.forceSubmissionBoundary = false;
        opaqueCsgIntervalSampleComputeEmulationScheduling.allowPacketMerge = true;
        opaqueCsgIntervalSampleComputeEmulationScheduling.mergeWithPrevious = true;
        // Combine is the explicit immediate predecessor.
        // The interval-image UAV handoff survives FrontierSafe splits; Sample merges so vertex handoff and timing stay together.
        opaqueCsgIntervalSampleComputeEmulationScheduling.allowMergeAcrossConsumerFrontier = true;
        GpuTaskDesc opaqueCsgIntervalSampleComputeEmulationDesc;
        opaqueCsgIntervalSampleComputeEmulationDesc
            .setIdentity(Name(s_RenderNameRenderGraphicsPrefixOpaqueCsgIntervalSampleComputeEmulation))
            .setMarkerLabel("Opaque CSG Interval-Sample Compute Emulation")
            .setScheduling(opaqueCsgIntervalSampleComputeEmulationScheduling)
            .setDependency(csgIntervalSampleDependency)
            .setResourceUses(opaqueCsgIntervalSampleComputeEmulationResourceUses)
            .setResourceSetUses(opaqueCsgIntervalSampleComputeEmulationResourceSetUses)
        ;
        const auto intervalSampleComputeEmulationTaskResult = this.m_graph.addPreparedPayloadTask(opaqueCsgIntervalSampleComputeEmulationDesc, this.m_intervalSampleComputeEmulationPayload);
        if(!intervalSampleComputeEmulationTaskResult.has_value()){
            tasks.intervalSampleComputeEmulationTask = GpuTaskId();
            warning("RendererSystem: could not declare opaque CSG interval-sample compute-emulation producer");
            return MakeUnexpected(Failure());
        }
        tasks.intervalSampleComputeEmulationTask = intervalSampleComputeEmulationTaskResult.value();
        csgIntervalSampleDependency = tasks.intervalSampleComputeEmulationTask;
    }

    GpuTaskSchedulingHint csgIntervalSampleScheduling;
    csgIntervalSampleScheduling.cost = GpuTaskCostHint::Medium;
    csgIntervalSampleScheduling.forceSubmissionBoundary = false;
    csgIntervalSampleScheduling.allowPacketMerge = true;
    csgIntervalSampleScheduling.mergeWithPrevious = true;
    csgIntervalSampleScheduling.allowMergeAcrossConsumerFrontier = opaqueCsgIntervalSampleComputeEmulationOutputStatesGraphOwned;
    GpuTaskDesc csgIntervalSampleDesc;
    csgIntervalSampleDesc
        .setIdentity(Name(s_RenderNameRenderGraphicsPrefixCsgIntervalSample))
        .setMarkerLabel("Opaque CSG Interval Sample")
        .setScheduling(csgIntervalSampleScheduling)
        .setDependency(csgIntervalSampleDependency)
        .setResourceUses(csgIntervalSampleResourceUses)
        .setResourceSetUses(csgIntervalSampleMaterialResourceSetUses)
    ;
    const auto intervalSampleTaskResult = this.m_graph.addPreparedPayloadTask(csgIntervalSampleDesc, this.m_intervalSamplePayload);
    if(!intervalSampleTaskResult.has_value()){
        tasks.intervalSampleTask = GpuTaskId();
        warning("RendererSystem: could not declare opaque CSG interval-sample task");
        return MakeUnexpected(Failure());
    }
    tasks.intervalSampleTask = intervalSampleTaskResult.value();
    return tasks;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class OpaqueIntervalReadiness{
    public MaterialPassDrawItemPartitionsView opaqueDrawItems;
    public CsgFrameGpuDataView csgFrameData;
    public OpaqueCsgIntervalReadinessState state;
}

OpaqueIntervalReadiness ResolveOpaqueIntervalReadiness(in OpaqueCsgIntervalRecordInputs payload){
    OpaqueIntervalReadiness readiness;
    const b8 frameSetupReady = FrameSetupReady(payload.meshViewSetupReady, payload.sceneShadingSetupReady);
    if(frameSetupReady){
        readiness.opaqueDrawItems = payload.opaqueDrawSnapshot.drawItemsView();
        readiness.csgFrameData = payload.opaqueDrawSnapshot.csgFrameDataView();
    }

    const b8 hasDeferredDrawItems = !readiness.opaqueDrawItems.empty();
    const b8 frameBindingsReady = hasDeferredDrawItems && payload.frameBindings.frameReady(payload.opaqueDrawSnapshot.passes.instanceCount, payload.opaqueDrawSnapshot.passes.materialTypedByteCount);
    const b8 hasCsgFrameWork = readiness.csgFrameData.hasWork();
    const b8 csgResourcesFrameReady = hasCsgFrameWork && payload.csgResources.frameReady(readiness.csgFrameData);
    const b8 csgReceiverSurfaceEmpty = readiness.opaqueDrawItems.csgReceiverSurface.empty();
    const b8 csgReceiverSurfaceDrawResourcesReady = !csgReceiverSurfaceEmpty && payload.materialSystem.drawRecorder().materialPassDrawResourcesReady(readiness.opaqueDrawItems.csgReceiverSurface, payload.frameBindings);
    readiness.state = EvaluateOpaqueCsgIntervalReadiness(
        hasDeferredDrawItems,
        payload.materialDrawBuffersUploaded,
        frameBindingsReady,
        hasCsgFrameWork,
        payload.csgFrameBuffersUploaded,
        csgResourcesFrameReady,
        csgReceiverSurfaceEmpty,
        csgReceiverSurfaceDrawResourcesReady
    );
    return readiness;
}

b8 OpaqueCsgComputeIntervalGraphTask::record(mut CommandList commands, in GpuTaskRecordContext context)const{
    if(!this.inputs.opaqueDrawSnapshot.passes.captured)
        return false;
    GpuTimingTicketRecordingScope recording(this.inputs.timingTicket.value());
    const OpaqueIntervalReadiness readiness = ResolveOpaqueIntervalReadiness(this.inputs);
    if(readiness.state.csgResourcesReady && readiness.csgFrameData.hasWork() && readiness.state.csgReceiverSurfaceDrawResourcesReady){
        if(this.pass == OpaqueCsgComputeIntervalPass::ReceiverSpan)
            this.inputs.csgSystem.dispatchCsgReceiverSpanBuild(commands, this.inputs.targets, readiness.csgFrameData, this.inputs.csgResources);
        else
            this.inputs.csgSystem.dispatchCsgIntervalCombine(commands, this.inputs.targets, readiness.csgFrameData, this.inputs.csgResources);
    }
    commands.endRenderPass();
    return true;
}

b8 OpaqueCsgIntervalSampleGraphTask::record(mut CommandList commands, in GpuTaskRecordContext context)const{
    if(!this.inputs.opaqueDrawSnapshot.passes.captured || (this.csgComputeEmulationOutputStatesGraphOwned && !this.opaqueCsgComputeEmulationTiming.has_value()))
        return false;

    GpuTimingTicketRecordingScope recording(this.inputs.timingTicket.value());
    const OpaqueIntervalReadiness readiness = ResolveOpaqueIntervalReadiness(this.inputs);
    const MaterialPassDrawItemPartitionsView opaqueDrawItems = readiness.opaqueDrawItems;
    const CsgFrameGpuDataView csgFrameData = readiness.csgFrameData;
    const b8 csgDrawResourcesReady = readiness.state.csgResourcesReady && (opaqueDrawItems.csg.empty() || this.inputs.materialSystem.drawRecorder().materialPassDrawResourcesReady(opaqueDrawItems.csg, this.inputs.frameBindings));
    const b8 csgReceiverSurfaceDrawResourcesReady = readiness.state.csgReceiverSurfaceDrawResourcesReady;
    // Retire the reservation on later disagreement; never leave it stale.
    if(this.csgComputeEmulationOutputStatesGraphOwned && this.opaqueCsgComputeEmulationTiming.value().has_value() && !csgDrawResourcesReady){
        this.opaqueCsgComputeEmulationTiming.value().value().discardTiming();
        this.opaqueCsgComputeEmulationTiming.value().reset();
        commands.endRenderPass();
        return true;
    }
    const b8 csgComputeEmulationReady = !this.csgComputeEmulationOutputStatesGraphOwned || this.opaqueCsgComputeEmulationTiming.value().has_value();
    if(csgDrawResourcesReady && csgComputeEmulationReady){
        ViewportState deferredViewportState;
        deferredViewportState.addViewportAndScissorRect(this.inputs.targets.framebuffer.deref().getFramebufferInfo().getViewport());
        MaterialPassDrawContext csgDrawContext(
            commands,
            deferredViewportState,
            this.inputs.frameBindings,
            MaterialPipelinePass::Opaque,
            this.materialFrameStatesGraphOwned,
            this.materialGeometryStatesGraphOwned,
            this.csgComputeEmulationOutputStatesGraphOwned
        );
        csgDrawContext.setFramebuffer(this.inputs.targets.framebuffer).setCsgResources(this.inputs.csgResources);
        if(!opaqueDrawItems.csg.empty()){
            if(this.csgComputeEmulationOutputStatesGraphOwned){
                this.inputs.materialSystem.drawRecorder().renderMaterialPassDrawItems(csgDrawContext, opaqueDrawItems.csg);
                this.opaqueCsgComputeEmulationTiming.value().value().finishTiming(commands);
                this.opaqueCsgComputeEmulationTiming.value().reset();
            }
            else{
                GpuTimingMeasure timing(this.graphics.gpuTiming(), s_TimingScopeOpaqueCsg, this.graphics.getDevice(), commands);

                this.inputs.materialSystem.drawRecorder().renderMaterialPassDrawItems(csgDrawContext, opaqueDrawItems.csg);
            }
        }
        if(csgFrameData.hasWork() && csgReceiverSurfaceDrawResourcesReady)
            this.inputs.csgSystem.renderCsgIntervalCaps(commands, this.inputs.targets, csgFrameData, this.inputs.csgResources);
    }
    commands.endRenderPass();
    return true;
}


