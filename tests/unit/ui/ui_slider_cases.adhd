namespace __hidden_ui_slider_behavior_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace Impl::Ui;


class UiSliderBehaviorTests : public testing::Test{
public:
    virtual void SetUp()override{
        ASSERT_TRUE(refresh());
    }

    [[nodiscard]] b8 refresh()noexcept{
        const auto metrics = MeasureSlider(m_options, {});
        if(!metrics)
            return false;
        const auto normalized = SliderBehavior::Normalize(m_options.minimum, m_options.maximum, m_state.value());
        if(!normalized)
            return false;
        const auto placement = PlaceSlider(m_bounds, m_bounds, *metrics, *normalized);
        if(!placement)
            return false;
        m_placement = *placement;
        return SliderBehavior::Admit(m_state, m_options, m_placement);
    }

    [[nodiscard]] b8 set(const f64 value)noexcept{
        return m_state.setValue(value) && refresh();
    }

    [[nodiscard]] ControlAction key(const ControlActionKind::Enum kind, const u64 sequence = 1u)const noexcept{
        ControlAction action;
        action.id = { { 41u }, 3u, 7u, sequence };
        action.control = m_state.controlToken();
        action.kind = kind;
        return action;
    }

    [[nodiscard]] PointerGesture gesture(const b8 thumb = true)const noexcept{
        PointerGesture item;
        item.id = { { thumb ? 42u : 43u }, 3u, 7u, 11u };
        item.origin = { m_placement.thumb.width * 0.5f + m_placement.thumb.x, 36.0f };
        item.position = item.origin;
        item.targetRectangle = thumb ? m_placement.thumb : m_placement.track;
        item.referenceRectangle = thumb ? m_placement.travelBounds : m_placement.centerTravel;
        item.control = m_state.controlToken();
        item.updateSequence = 12u;
        item.value = BitCast<u64>(m_state.value());
        return item;
    }


public:
    SliderState m_state;
    SliderOptions m_options;
    SliderPlacement m_placement;
    Rect m_bounds = { 10.0f, 20.0f, 240.0f, 32.0f };
    SliderResult m_result;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_END


