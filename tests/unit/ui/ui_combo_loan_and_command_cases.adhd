using namespace NWB;
using namespace NWB::Impl::Ui;

[[nodiscard]] inline HitTarget MakeEditor()noexcept{
    HitTarget target;
    target.id = { 1u };
    target.declarationGeneration = 7u;
    target.rectangle = { 0.0f, 0.0f, 120.0f, 24.0f };
    target.clip = { 0.0f, 0.0f, 300.0f, 200.0f };
    target.focusable = true;
    target.textEditable = true;
    target.control = { 101u, 102u, 103u };
    return target;
}

[[nodiscard]] inline HitTarget MakeList(const u64 id = 2u, const f32 x = 0.0f)noexcept{
    HitTarget target;
    target.id = { id };
    target.declarationGeneration = 11u;
    target.rectangle = { x, 40.0f, 120.0f, 120.0f };
    target.clip = { 0.0f, 0.0f, 300.0f, 200.0f };
    target.focusable = true;
    target.navigable = true;
    target.control = { 31u, 41u, 51u };
    target.pageRows = 5u;
    return target;
}

using UiTestSupport::Key;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiCommandOwnerTests : public UiTestSupport::RouterTestFixture{
public:
    UiCommandOwnerTests()
        : RouterTestFixture(Name(NWB::Tests::UiCases::s_UiCaseTestsUiKeyboardOwner))
    {
        m_targets = { MakeEditor(), MakeList(), MakeList(3u, 140.0f) };
        m_targets[2u].control.instanceGeneration = 32u;
        bind(m_targets[1u]);
    }


public:
    void bind(const HitTarget& owner)noexcept{
        m_targets[0u].commandOwner = owner.id;
        m_targets[0u].commandOwnerDeclarationGeneration = owner.declarationGeneration;
        m_targets[0u].commandControl = owner.control;
    }

    void clearBinding()noexcept{
        m_targets[0u].commandOwner = {};
        m_targets[0u].commandOwnerDeclarationGeneration = 0u;
        m_targets[0u].commandControl = {};
    }

    void press(const Core::Key::Enum key){
        EXPECT_TRUE(send(Key(InputEventType::KeyDown, key)).commandConsumed);
        EXPECT_TRUE(send(Key(InputEventType::KeyUp, key)).commandConsumed);
    }

    void focus(){
        InputEvent event;
        event.type = InputEventType::PrimaryDown;
        event.position = { 10.0f, 10.0f };
        EXPECT_TRUE(send(event).pointerConsumed);
        event.type = InputEventType::PrimaryUp;
        EXPECT_TRUE(send(event).pointerConsumed);
        EXPECT_EQ(m_router.focus(), m_targets[0u].id);
    }

    [[nodiscard]] Expected<ControlAction> take(const usize owner = 1u)noexcept{
        const HitTarget& target = m_targets[owner];
        return m_router.consumeControlAction(target.id, target.declarationGeneration, target.control);
    }

    [[nodiscard]] PopupScope popup()noexcept{
        PopupScope scope;
        scope.token = { { 10u }, 12u, 13u, 14u };
        scope.bounds = { 0.0f, 0.0f, 300.0f, 200.0f };
        scope.viewport = scope.bounds;
        scope.layer = 1u;
        return scope;
    }


public:
    Array<HitTarget, 3u> m_targets;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


