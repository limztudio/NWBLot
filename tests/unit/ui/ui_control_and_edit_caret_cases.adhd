void VerifyEditBoxLayoutTests_LigaturesExposeEachGraphemeCaretAndPartialSelection(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.setText("ffi"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 2u));
    ASSERT_TRUE(self.shapeView());
    ASSERT_EQ(self.m_view.layout().clusters().size(), 1u);
    ASSERT_EQ(self.m_view.caretStops().size(), 4u);
    for(usize index = 0u; index < 4u; ++index){
        EXPECT_EQ(self.m_view.caretStops()[index].committedByte, index);
        EXPECT_FLOAT_EQ(self.m_view.caretStops()[index].x, cast<f32>(index) * 10.0f);
    }
    ASSERT_TRUE(self.place());
    EXPECT_FLOAT_EQ(self.m_placement.caret.x, 30.0f);
    const Expected<Rect> selection = self.rangeRect(self.m_view.selectionRange());
    ASSERT_TRUE(selection.has_value());
    EXPECT_FLOAT_EQ(selection.value().x, 20.0f);
    EXPECT_FLOAT_EQ(selection.value().width, 10.0f);
    Expected<usize> hit = self.m_view.hitTest(MakeUiControlCaretPoint(21.0f, 24.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 1u);
    hit = self.m_view.hitTest(MakeUiControlCaretPoint(27.0f, 24.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 2u);
}

void VerifyEditBoxLayoutTests_CombiningAndDecomposedHangulHitsStayOnWholeGraphemes(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.setText("A\314\201B"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    ASSERT_EQ(self.m_view.caretStops().size(), 3u);
    EXPECT_EQ(self.m_view.caretStops()[1u].committedByte, 3u);
    Expected<usize> hit = self.m_view.hitTest(MakeUiControlCaretPoint(14.9f, 24.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 0u);
    hit = self.m_view.hitTest(MakeUiControlCaretPoint(15.1f, 24.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 3u);
    ASSERT_TRUE(self.m_model.setText("\xe1\x84\x92\xe1\x85\xa1\xe1\x86\xab"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    ASSERT_EQ(self.m_view.caretStops().size(), 2u);
    EXPECT_EQ(self.m_view.caretStops()[1u].committedByte, 9u);
    hit = self.m_view.hitTest(MakeUiControlCaretPoint(17.0f, 24.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 9u);
}

void VerifyEditBoxLayoutTests_PreeditReplacesOnlyTheDisplayAndOwnsItsSelectionAndUnderline(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.setText("ABC"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 2u));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("\xed\x95\x9c\xea\xb8\x80", 0u, 3u));
    ASSERT_TRUE(self.shapeView());
    EXPECT_EQ(self.m_model.text(), "ABC");
    EXPECT_EQ(self.m_view.displayText(), "A\355\225\234\352\270\200C");
    EXPECT_EQ(self.m_view.preeditRange().begin, 1u);
    EXPECT_EQ(self.m_view.preeditRange().end, 7u);
    EXPECT_EQ(self.m_view.displayCaret(), 4u);
    EXPECT_EQ(self.m_view.selectionRange().begin, 1u);
    EXPECT_EQ(self.m_view.selectionRange().end, 4u);
    ASSERT_EQ(self.m_view.caretStops().size(), 4u);
    EXPECT_EQ(self.m_view.caretStops()[2u].committedByte, 2u);
    EXPECT_EQ(self.m_view.caretStops()[2u].displayByte, 7u);
    ASSERT_TRUE(self.place());
    const Expected<Rect> selection = self.rangeRect(self.m_view.selectionRange());
    ASSERT_TRUE(selection.has_value());
    const Expected<Rect> preedit = self.rangeRect(self.m_view.preeditRange());
    ASSERT_TRUE(preedit.has_value());
    EXPECT_FLOAT_EQ(selection.value().x, 20.0f);
    EXPECT_FLOAT_EQ(selection.value().width, 10.0f);
    EXPECT_FLOAT_EQ(preedit.value().x, 20.0f);
    EXPECT_FLOAT_EQ(preedit.value().width, 20.0f);
    EXPECT_FLOAT_EQ(Min(self.m_placement.caret.width, preedit.value().height), 1.0f);
    const Expected<usize> hit = self.m_view.hitTest(MakeUiControlCaretPoint(39.0f, 24.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 2u);
    self.m_model.cancelComposition();
    ASSERT_TRUE(self.m_model.setText("changed"));
    EXPECT_EQ(self.m_view.displayText(), "A\355\225\234\352\270\200C");
    EXPECT_TRUE(self.m_view.composing());
}

void VerifyEditBoxLayoutTests_NativePreeditCaretCanAddressScalarEdgesInsideOneGrapheme(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("\xe1\x84\x92\xe1\x85\xa1\xe1\x86\xab", 3u, 6u));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    EXPECT_FLOAT_EQ(self.m_placement.caret.x, 18.0f);
    const Expected<Rect> selection = self.rangeRect(self.m_view.selectionRange());
    ASSERT_TRUE(selection.has_value());
    const Expected<Rect> preedit = self.rangeRect(self.m_view.preeditRange());
    ASSERT_TRUE(preedit.has_value());
    EXPECT_FLOAT_EQ(selection.value().x, 14.0f);
    EXPECT_FLOAT_EQ(selection.value().width, 4.0f);
    EXPECT_FLOAT_EQ(preedit.value().width, 12.0f);
    ASSERT_EQ(self.m_view.caretStops().size(), 2u);
    EXPECT_EQ(self.m_view.caretStops()[0u].committedByte, 0u);
    EXPECT_EQ(self.m_view.caretStops()[1u].committedByte, 0u);
}

void VerifyEditBoxLayoutTests_HorizontalScrollFollowsCaretAndClampsWhenTextShrinks(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.setText("abcdef"));
    ASSERT_TRUE(self.shapeView());
    const Expected<EditBoxPlacement> arranged = self.m_view.arrange(
        MakeUiControlCaretRect(10.0f, 20.0f, 26.0f, 20.0f),
        MakeUiControlCaretInsets(3.0f, 0.0f, 3.0f, 0.0f),
        MakeUiControlCaretRect(0.0f, 0.0f, 500.0f, 500.0f),
        Point()
    );
    ASSERT_TRUE(arranged.has_value());
    self.m_placement = arranged.value();
    EXPECT_FLOAT_EQ(self.m_placement.content.x, 13.0f);
    EXPECT_FLOAT_EQ(self.m_placement.content.width, 20.0f);
    EXPECT_FLOAT_EQ(self.m_placement.scroll, 41.0f);
    EXPECT_FLOAT_EQ(self.m_placement.caret.x + self.m_placement.caret.width, 33.0f);
    ASSERT_TRUE(self.m_model.move(EditMove::Home));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place(20.0f, 41.0f));
    EXPECT_FLOAT_EQ(self.m_placement.scroll, 0.0f);
    EXPECT_FLOAT_EQ(self.m_placement.caret.x, 10.0f);
    ASSERT_TRUE(self.m_model.setText("A"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place(20.0f, 41.0f));
    EXPECT_FLOAT_EQ(self.m_placement.scroll, 0.0f);
}

void VerifyEditBoxLayoutTests_PlacementIntersectsFrameAndContentClipsAndRejectsInvalidInputs(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.setText("abc"));
    ASSERT_TRUE(self.shapeView());
    const Expected<EditBoxPlacement> arranged = self.m_view.arrange(
        MakeUiControlCaretRect(10.0f, 20.0f, 100.0f, 30.0f),
        MakeUiControlCaretInsets(8.0f, 4.0f, 8.0f, 4.0f),
        MakeUiControlCaretRect(30.0f, 22.0f, 20.0f, 40.0f),
        Point()
    );
    ASSERT_TRUE(arranged.has_value());
    self.m_placement = arranged.value();
    EXPECT_FLOAT_EQ(self.m_placement.frameClip.x, 30.0f);
    EXPECT_FLOAT_EQ(self.m_placement.frameClip.y, 22.0f);
    EXPECT_FLOAT_EQ(self.m_placement.frameClip.height, 28.0f);
    EXPECT_FLOAT_EQ(self.m_placement.clip.y, 24.0f);
    EXPECT_FLOAT_EQ(self.m_placement.clip.height, 22.0f);
    EXPECT_FALSE(self.m_view.arrange(MakeUiControlCaretRect(0.0f, 0.0f, -1.0f, 20.0f), Insets(), Rect(), Point()).has_value());
    EXPECT_FALSE(self.m_view.arrange(MakeUiControlCaretRect(0.0f, 0.0f, 20.0f, 20.0f), MakeUiControlCaretInsets(-1.0f, 0.0f, 0.0f, 0.0f), Rect(), Point()).has_value());
    EXPECT_FALSE(self.m_view.arrange(MakeUiControlCaretRect(0.0f, 0.0f, 20.0f, 20.0f), Insets(), Rect(), MakeUiControlCaretPoint(UiControlCaretQuietNaNF32(), 0.0f)).has_value());
    EXPECT_FALSE(self.m_view.hitTest(MakeUiControlCaretPoint(UiControlCaretQuietNaNF32(), 0.0f), self.m_placement).has_value());
}

void VerifyEditBoxLayoutTests_MismatchedAndRtlLayoutsPreserveTheAdmittedGeometry(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.setText("abc"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    const f32 oldCaret = self.m_placement.caret.x;
    EXPECT_FALSE(self.tryAdoptBuiltLayout("other"));
    EXPECT_EQ(self.m_view.layout().utf8(), "abc");
    EXPECT_FALSE(self.tryAdoptBuiltLayout("abc", TextDirection::RightToLeft));
    ASSERT_TRUE(self.place());
    EXPECT_FLOAT_EQ(self.m_placement.caret.x, oldCaret);
    ShapeRequest request = ShapeRequest();
    request.text = "abc";
    request.direction = TextDirection::RightToLeft;
    TextService service = TextService(self.m_arena);
    EXPECT_EQ(self.m_view.shape(service, request), TextLayoutStatus::InvalidParameters);
    EXPECT_EQ(self.m_view.layout().utf8(), "abc");
}

void VerifyEditBoxLayoutTests_SnapshotOwnsModelBytesAndReshapingRejectsUnsupportedSingleLineControls(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.setText("owned"));
    ASSERT_TRUE(self.shapeView());
    const u64 revision = self.m_view.revision();
    ASSERT_TRUE(self.m_model.setText("replacement"));
    EXPECT_EQ(self.m_view.displayText(), "owned");
    EXPECT_EQ(self.m_view.layout().utf8(), "owned");
    EXPECT_EQ(self.m_view.revision(), revision);
    EditBoxView moved = EditBoxView(self.m_arena);
    self.moveViewTo(moved);
    EXPECT_EQ(moved.displayText(), "owned");
    EXPECT_EQ(moved.layout().utf8(), "owned");
    EXPECT_TRUE(moved.ready());
    ASSERT_TRUE(self.m_model.setText("A\tB"));
    ASSERT_TRUE(moved.snapshot(self.m_model));
    EXPECT_FALSE(moved.ready());
    TextService service = TextService(self.m_arena);
    EXPECT_EQ(moved.shape(service), TextLayoutStatus::UnsupportedControl);
    EXPECT_FALSE(moved.arrange(Rect(), Insets(), Rect(), Point()).has_value());
}

void VerifyEditBoxLayoutTests_EmptyTextKeepsOneCaretAndCanPaintWithoutAFontOrEditSkinRegion(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    ASSERT_EQ(self.m_view.caretStops().size(), 1u);
    EXPECT_FLOAT_EQ(self.m_placement.caret.x, 10.0f);
    EXPECT_FLOAT_EQ(self.m_placement.caret.height, 12.0f);
    UiSkin skin = UiSkin(self.m_arena, s_UiEditBoxSkinAssetName);
    self.configureSkin(skin);
    PaintBuilder paint = PaintBuilder(self.m_arena);
    TextService service = TextService(self.m_arena);
    EditBoxPaintFlags flags = EditBoxPaintFlags();
    flags.focused = true;
    flags.caretVisible = false;
    const EditBoxStyle style = EditBoxStyle();
    self.beginSkinPaint(paint, skin, 1u);
    ASSERT_TRUE(self.m_view.paint(service, paint, skin, self.m_placement, style, flags));
    EXPECT_EQ(paint.freeze().vertices().size(), 4u);
    flags.caretVisible = true;
    self.beginSkinPaint(paint, skin, 2u);
    ASSERT_TRUE(self.m_view.paint(service, paint, skin, self.m_placement, style, flags));
    EXPECT_EQ(paint.freeze().vertices().size(), 8u);
    flags.readOnly = true;
    self.beginSkinPaint(paint, skin, 3u);
    ASSERT_TRUE(self.m_view.paint(service, paint, skin, self.m_placement, style, flags));
    EXPECT_EQ(paint.freeze().vertices().size(), 4u);
}

void VerifyEditBoxLayoutTests_EmptySelectionRejectsInvalidCaretWidthsAndRestoresClippingWithoutADrawnCaret(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    UiSkin skin = UiSkin(self.m_arena, s_UiEditBoxSkinAssetName);
    self.configureSkin(skin);
    PaintBuilder paint = PaintBuilder(self.m_arena);
    TextService service = TextService(self.m_arena);
    EditBoxPaintFlags flags = EditBoxPaintFlags();
    flags.focused = true;
    flags.caretVisible = false;
    const EditBoxStyle style = EditBoxStyle();
    u64 generation = 0u;
    Array<f32, 3u> widths = Array<f32, 3u>();
    widths[0u] = -1.0f;
    widths[1u] = UiControlCaretQuietNaNF32();
    widths[2u] = UiControlCaretInfinityF32();
    for(in f32 width : widths){
        EditBoxPlacement placement = self.m_placement;
        placement.caret.width = width;
        ++generation;
        self.beginSkinPaint(paint, skin, generation);
        EXPECT_FALSE(self.m_view.paint(service, paint, skin, placement, style, flags));
        EXPECT_FALSE(paint.popClip());
        EXPECT_EQ(paint.freeze().vertices().size(), 4u);
    }
}

void VerifyEditBoxLayoutTests_EmptyPreeditSelectionStillPaintsItsUnderlineAndRestoresClipping(mut EditBoxLayoutTests self){
    ScratchArena fontScratchArena = ScratchArena(s_UiCaseNameFontScratch);
    Font font = Font(self.m_arena, s_UiEditBoxFontAssetName);
    TextService service = TextService(self.m_arena);
    ASSERT_TRUE(self.installBundledLatinFont(fontScratchArena, font, service));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("IME", 3u, 3u));
    ASSERT_TRUE(self.m_view.snapshot(self.m_model));
    ASSERT_EQ(self.m_view.shape(service), TextLayoutStatus::Success);
    ASSERT_EQ(self.m_view.selectionRange().begin, self.m_view.selectionRange().end);
    const Expected<EditBoxPlacement> placement = self.m_view.arrange(
        MakeUiControlCaretRect(10.0f, 20.0f, 180.0f, 80.0f),
        Insets(),
        MakeUiControlCaretRect(0.0f, 0.0f, 200.0f, 120.0f),
        Point()
    );
    ASSERT_TRUE(placement.has_value());
    UiSkin skin = UiSkin(self.m_arena, s_UiEditBoxSkinAssetName);
    self.configureSkin(skin);
    PaintBuilder paint = PaintBuilder(self.m_arena);
    EditBoxStyle style = EditBoxStyle();
    style.preedit.r = 0.0f;
    style.preedit.g = 1.0f;
    style.preedit.b = 0.0f;
    style.preedit.a = 1.0f;
    EditBoxPaintFlags flags = EditBoxPaintFlags();
    flags.focused = true;
    flags.preeditCaretVisible = false;
    self.beginSkinPaint(paint, skin, 1u, 200.0f, 120.0f);
    ASSERT_TRUE(self.m_view.paint(service, paint, skin, placement.value(), style, flags));
    EXPECT_FALSE(paint.popClip());
    const DrawSnapshot snapshot = paint.freeze();
    usize underlineVertices = 0u;
    for(usize index = 0u; index < snapshot.vertices().size(); ++index){
        const Vertex vertex = snapshot.vertices()[index];
        if(vertex.color.r == 0.0f && vertex.color.g == 1.0f && vertex.color.b == 0.0f && vertex.color.a == 1.0f)
            ++underlineVertices;
    }
    EXPECT_EQ(underlineVertices, 4u);
}

void VerifyEditBoxLayoutTests_PaintingRestoresClipStackAndBoundsVerticesAcrossDisplayScales(mut EditBoxLayoutTests self){
    ScratchArena fontScratchArena = ScratchArena(s_UiCaseNameFontScratch);
    Font font = Font(self.m_arena, s_UiEditBoxFontAssetName);
    TextService service = TextService(self.m_arena);
    ASSERT_TRUE(self.installBundledLatinFont(fontScratchArena, font, service));
    ASSERT_TRUE(self.m_model.setText("ffi"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 2u));
    ASSERT_TRUE(self.m_view.snapshot(self.m_model));
    ASSERT_EQ(self.m_view.shape(service), TextLayoutStatus::Success);
    ASSERT_TRUE(self.place());
    UiSkin skin = UiSkin(self.m_arena, s_UiEditBoxSkinAssetName);
    self.configureSkin(skin, true);
    PaintBuilder paint = PaintBuilder(self.m_arena);
    EditBoxPaintFlags flags = EditBoxPaintFlags();
    flags.focused = true;
    const EditBoxStyle style = EditBoxStyle();
    Array<f32, 2u> scales = Array<f32, 2u>();
    scales[0u] = 1.0f;
    scales[1u] = 2.0f;
    for(in f32 scale : scales){
        self.beginSkinPaint(paint, skin, cast<u64>(scale), 200.0f, 100.0f, scale);
        ASSERT_TRUE(self.m_view.paint(service, paint, skin, self.m_placement, style, flags));
        EXPECT_FALSE(paint.popClip());
        const DrawSnapshot snapshot = paint.freeze();
        ASSERT_FALSE(snapshot.glyphPages().empty());
        ASSERT_FALSE(snapshot.vertices().empty());
        const f32 boundsRight = self.m_placement.bounds.x + self.m_placement.bounds.width;
        for(usize index = 0u; index < snapshot.vertices().size(); ++index){
            const Vertex vertex = snapshot.vertices()[index];
            EXPECT_GE(vertex.position.x, self.m_placement.bounds.x);
            EXPECT_LE(vertex.position.x, boundsRight);
        }
    }
}

void VerifyEditBoxLayoutTests_NegativeZeroScrollClampsToPositiveZero(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.setText("abcdef"));
    ASSERT_TRUE(self.m_model.move(EditMove::Home));
    ASSERT_TRUE(self.shapeView());
    Array<b8, 2u> revealChoices = Array<b8, 2u>();
    revealChoices[0u] = false;
    revealChoices[1u] = true;
    for(in b8 revealCaret : revealChoices){
        const Expected<EditBoxPlacement> placement = self.m_view.arrange(
            MakeUiControlCaretRect(10.0f, 20.0f, 26.0f, 20.0f),
            Insets(),
            MakeUiControlCaretRect(0.0f, 0.0f, 500.0f, 500.0f),
            MakeUiControlCaretPoint(-0.0f, -0.0f),
            1.0f,
            revealCaret
        );
        ASSERT_TRUE(placement.has_value());
        EXPECT_FLOAT_EQ(placement.value().scroll, 0.0f);
        EXPECT_FALSE(UiEditBoxSignBit(placement.value().scroll));
    }
}


