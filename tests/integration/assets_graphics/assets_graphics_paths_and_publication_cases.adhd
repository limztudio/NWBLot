void VerifyAssetPaths_StemAndExtensionPreserveTrailingSeparatorsDotsAndRoots(){
    ScratchArena scratchArena(s_AssetCaseTestsAssetPathNativeFilenameSpans);
    Vector<StemExtensionCase> cases = Vector<StemExtensionCase>();
    cases.reserve(6u);
    cases.push_back(StemExtensionCase("foo.bar/", "foo", ".bar"));
    cases.push_back(StemExtensionCase("Folder/.Hidden///", ".Hidden", ""));
    cases.push_back(StemExtensionCase("Folder/..//", ".", "."));
    cases.push_back(StemExtensionCase("Folder/Name.///", "Name", "."));
    cases.push_back(StemExtensionCase("/", "", ""));
    cases.push_back(StemExtensionCase("", "", ""));

    for(in StemExtensionCase testCase : cases){
        const ScratchPath path(scratchArena, testCase.input);
        const ScratchPath stem = path.stem();
        const ScratchPath extension = path.extension();
        EXPECT_EQ(PathToString(stem), testCase.stem);
        EXPECT_EQ(PathToString(extension), testCase.extension);
    }
}

