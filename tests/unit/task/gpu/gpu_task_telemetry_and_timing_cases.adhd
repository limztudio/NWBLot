inline constexpr u32 s_GpuTelemetryAllMipLevels = Core::TextureSubresourceSet::s_AllMipLevels;
inline constexpr u32 s_GpuTelemetryAllArraySlices = Core::TextureSubresourceSet::s_AllArraySlices;
inline constexpr Core::TextureSubresourceSet s_GpuTelemetryAllSubresources = Core::s_AllSubresources;
inline constexpr u32 s_GpuTelemetryNameHashLaneCount = s_NameHashLaneCount;

struct GpuTelemetryFrameGraphScope{
public:
    Telemetry::FrameGraphNodeDescs nodes;
    Telemetry::FrameGraphEdgeDescs edges;
    Telemetry::FrameGraphPendingNameEdges pendingEdges;
    Telemetry::FrameGraphBuilder builder;


public:
    GpuTelemetryFrameGraphScope(
        Core::Alloc::ScratchArena& scratchArena,
        Telemetry::TelemetryArena& arena,
        const usize nodeCapacity,
        const usize edgeCapacity
    )
        : nodes(arena)
        , edges(arena)
        , pendingEdges(arena)
        , builder(scratchArena, nodes, edges, pendingEdges)
    {
        nodes.reserve(nodeCapacity);
        edges.reserve(edgeCapacity);
    }
};

struct GpuTelemetryTimingInput{
public:
    Core::GpuTaskTimingKey key;
    Core::GpuPhysicalQueueId queue;
};

[[nodiscard]] inline GpuTelemetryTimingInput MakeGpuTelemetryTimingInput(const u32 index, const u16 generation = 1u)noexcept{
    return GpuTelemetryTimingInput{
        .key = {
            .task = Name(TaskGraphTestUtils::s_GpuTimingWork),
            .variant = index,
            .resolutionClass = index % 3u,
            .queue = static_cast<Core::CommandQueue::Enum>(index % Core::CommandQueue::kCount),
        },
        .queue = { static_cast<u16>(index % 7u), generation },
    };
}

[[nodiscard]] inline Name MakeGpuTelemetryFlippedHashName(const Name& base, const u32 lane)noexcept{
    NameHash hash = base.hash();
    hash.qwords[lane] ^= 1u;
    return Name(hash);
}

struct GpuTelemetryHistoryScope{
public:
    Core::GraphicsArena arena;
    Core::GpuTaskTimingHistoryStore store;
    Core::GpuTaskTimingHistorySnapshot snapshot;


public:
    explicit GpuTelemetryHistoryScope(const Name& owner)
        : arena(owner)
        , store(arena)
        , snapshot(arena)
    {}

    GpuTelemetryHistoryScope(const Name& owner, const u32 sampleCapacity)
        : arena(owner)
        , store(arena, sampleCapacity)
        , snapshot(arena)
    {}
};

struct GpuTelemetryDualStoreScope{
public:
    Core::GraphicsArena arena;
    Core::GpuTaskTimingHistoryStore historyStore;
    Core::GpuTaskTimingHistoryStore assignmentStore;
    Core::GpuTaskTimingHistorySnapshot snapshot;


public:
    explicit GpuTelemetryDualStoreScope(const Name& owner)
        : arena(owner)
        , historyStore(arena)
        , assignmentStore(arena)
        , snapshot(arena)
    {}
};

[[nodiscard]] inline Core::GpuPhysicalQueueTopology MakeGpuTelemetryTopology(const Span<const Core::GpuPhysicalQueueInfo> queues)noexcept{
    return Core::GpuPhysicalQueueTopology{ .queues = queues.data(), .queueCount = queues.size() };
}

[[nodiscard]] inline Span<const Core::GpuTaskResourceUse> MakeGpuTelemetryUsePrefixSpan(
    const Span<const Core::GpuTaskResourceUse> uses,
    const usize count
)noexcept{
    return Span<const Core::GpuTaskResourceUse>(uses.data(), count);
}

[[nodiscard]] inline b8 BenefitExceedsGpuTelemetryHysteresis(
    const Core::GpuTaskTimingHistory& incumbent,
    const Core::GpuTaskTimingHistory& candidate,
    const Core::GpuTaskTimingFeedbackPolicy& policy
)noexcept{
    return Core::GpuTaskTimingDecision::BenefitExceedsHysteresis(incumbent, candidate, policy);
}


