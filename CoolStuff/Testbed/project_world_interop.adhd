TestbedPhysicsHudStats QueryPhysicsStats(mut NotNullUniquePtr<World> worldHandle){
    TestbedPhysicsHudStats outStats = TestbedPhysicsHudStats();
    const Optional<mut PhysicsSystem> physicsSystem = worldHandle.deref().borrowSystem<PhysicsSystem>();
    if(physicsSystem.has_value()){
        in WorldStepStats stats = physicsSystem.value().lastStepStats();
        outStats.bodyCount = stats.bodyCount;
        outStats.awakeBodyCount = stats.awakeBodyCount;
        outStats.contactCount = stats.contactCount;
        outStats.jointCount = stats.jointCount;
        outStats.islandCount = stats.islandCount;
        outStats.cpuSolvedBodyCount = stats.cpuSolvedBodyCount;
        outStats.gpuSolvedBodyCount = stats.gpuSolvedBodyCount;
        outStats.cpuSolvedIslandCount = stats.cpuSolvedIslandCount;
        outStats.gpuSolvedIslandCount = stats.gpuSolvedIslandCount;
        outStats.backendUsed = cast<u8>(stats.backendUsed);
        outStats.stepMs = physicsSystem.value().lastStepMs();
        outStats.broadphaseMs = stats.broadphaseMs;
        outStats.narrowphaseMs = stats.narrowphaseMs;
        outStats.solveMs = stats.solveMs;
        outStats.ccdMs = stats.ccdMs;
    }
    return outStats;
}

void SyncWorldModelRuntimes(mut NotNullUniquePtr<World> worldHandle){
    const Optional<mut ModelSystem> modelSystem = worldHandle.deref().borrowSystem<ModelSystem>();
    if(modelSystem.has_value())
        modelSystem.value().syncModelRuntimes();
}

b8 TickProjectWorld(mut NotNullUniquePtr<World> worldHandle, in f32 safeDelta){
    const Expected<void, CpuTaskAdmissionError> updated = worldHandle.deref().tick(safeDelta);
    if(!updated.has_value()){
        error("Project: world update rejected CPU work: {}", cast<u32>(updated.error()));
        return false;
    }
    return true;
}

void QueryUiCaptureState(mut NotNullUniquePtr<World> worldHandle, mut b8 outPointerCaptured, mut b8 outKeyboardCaptured){
    const Optional<mut UiLayerSystem> uiLayerSystem = worldHandle.deref().borrowSystem<UiLayerSystem>();
    if(uiLayerSystem.has_value()){
        in UiLayerSystem ui = uiLayerSystem.value();
        outPointerCaptured = ui.wantsPointer();
        outKeyboardCaptured = ui.wantsKeyboard();
    }
    else{
        outPointerCaptured = false;
        outKeyboardCaptured = false;
    }
}

b8 WantsUiKeyboard(mut NotNullUniquePtr<World> worldHandle){
    const Optional<mut UiLayerSystem> uiLayerSystem = worldHandle.deref().borrowSystem<UiLayerSystem>();
    return uiLayerSystem.has_value() && uiLayerSystem.value().wantsKeyboard();
}

b8 WantsUiPointer(mut NotNullUniquePtr<World> worldHandle){
    const Optional<mut UiLayerSystem> uiLayerSystem = worldHandle.deref().borrowSystem<UiLayerSystem>();
    return uiLayerSystem.has_value() && uiLayerSystem.value().wantsPointer();
}

void ApplyFlyCameraTransform(
    mut TransformComponent transform,
    in VectorSingle moveAxes,
    in b8 boosted,
    in VectorSingle mouseDelta,
    in f32 deltaSeconds
){
    const FlyCameraMotion motion = FlyCameraMotion();
    const f32x4 rotationValue = transform.rotation;
    const f32x4 positionValue = transform.position;
    const VectorSingle currentRotation = VectorSingle(rotationValue);
    const VectorSingle currentPosition = VectorSingle(positionValue);
    const VectorSingle resolvedRotation = motion.resolveStepRotation(currentRotation, mouseDelta);
    const VectorSingle resolvedPosition = motion.resolvePosition(currentPosition, moveAxes, resolvedRotation, deltaSeconds, boosted);
    transform.rotation = f32x4(resolvedRotation);
    transform.position = f32x4(resolvedPosition);
}

void ApplyFlyCameraInputToWorld(
    mut World world,
    in VectorSingle moveAxes,
    in b8 boosted,
    in VectorSingle mouseDelta,
    in f32 deltaSeconds
){
    const SceneCameraView cameraView = ResolveSceneCameraView(world);
    assert(cameraView.valid());
    Entity cameraEntity = world.entity(cameraView.entity);
    ApplyFlyCameraTransform(cameraEntity.getComponent<TransformComponent>(), moveAxes, boosted, mouseDelta, deltaSeconds);
}

void ApplyFlyCameraInputToMainCamera(
    mut NotNullUniquePtr<World> worldHandle,
    in VectorSingle moveAxes,
    in b8 boosted,
    in VectorSingle mouseDelta,
    in f32 deltaSeconds
){
    ApplyFlyCameraInputToWorld(worldHandle.deref(), moveAxes, boosted, mouseDelta, deltaSeconds);
}

b8 InstantiateSceneSubsystemsEntities(
    in ActiveSceneSubsystems sceneSubsystems,
    mut NotNullUniquePtr<World> worldHandle,
    mut InstantiatedSceneEntities outInstantiated
){
    const b8 ok = sceneSubsystems.instantiateEntities(worldHandle.deref(), outInstantiated);
    if(ok){
        const Optional<mut PhysicsSystem> physicsSystem = worldHandle.deref().borrowSystem<PhysicsSystem>();
        if(physicsSystem.has_value())
            physicsSystem.value().registerNamedSceneEntities(outInstantiated);
    }
    return ok;
}

AssetRef<Texture> ResolveUiGallerySkinTextureRef(in AssetManager assets, in ActiveSceneSubsystems sceneSubsystems){
    const auto uiSubsystem = sceneSubsystems.findSubsystem<UiSubsystem>();
    if(uiSubsystem.has_value() && uiSubsystem.value().basicSkin.valid()){
        const auto skin = LoadTypedAssetSync<UiSkin>(assets, uiSubsystem.value().basicSkin.name(), "UiImageGallery");
        if(skin.has_value() && skin.value().valid())
            return skin.value().deref().texture();
    }
    return AssetRef<Texture>();
}

Expected<SharedImageSource> LoadUiGallerySkinImageSource(in SharedPool pool, mut ProjectRuntimeContext context, in ActiveSceneSubsystems sceneSubsystems){
    const AssetRef<Texture> textureRef = ResolveUiGallerySkinTextureRef(context.assetManager, sceneSubsystems);
    if(!textureRef.valid())
        return MakeUnexpected(Failure());
    return LoadImageSource(pool, context.assetManager, textureRef);
}

PhysicsDebugDrawStats PaintPhysicsDebugOverlay(
    in PhysicsDebugDrawOptions options,
    in b8 drawPhysicsWorldDebug,
    in TestbedGrabState grabState,
    mut NotNullUniquePtr<World> worldHandle,
    mut UiPaintContext context,
    mut PhysicsDebugDrawScratch debugScratch,
    mut Vector<PaintLineSegment> screenLines
){
    if(!drawPhysicsWorldDebug && !grabState.active)
        return PhysicsDebugDrawStats();

    mut World world = worldHandle.deref();
    const Optional<mut PhysicsSystem> physicsSystem = world.borrowSystem<PhysicsSystem>();
    if(!physicsSystem.has_value())
        return PhysicsDebugDrawStats();

    const DisplayMetrics metrics = context.paint.displayMetrics();
    if(metrics.logicalWidth <= 0.0f || metrics.logicalHeight <= 0.0f)
        return PhysicsDebugDrawStats();

    const VectorSingle hVec(metrics.logicalHeight);
    const VectorSingle oneVec(1.0f);
    const SceneCameraView cameraView = ResolveSceneCameraView(world, metrics.logicalWidth / VectorSelect(oneVec, hVec, VectorGreater(hVec, oneVec)).x);
    if(!cameraView.valid())
        return PhysicsDebugDrawStats();

    in TransformComponent camXf = cameraView.components.value().transform;
    in CameraProjection camProj = cameraView.projection;
    const PhysicsDebugScreenProjector projector(camXf, camProj, metrics.logicalWidth, metrics.logicalHeight);
    if(!projector.valid())
        return PhysicsDebugDrawStats();

    PhysicsDebugDrawStats stats;
    if(drawPhysicsWorldDebug){
        TestbedProjectedDebugLineSink sink(projector, options.maxLines, screenLines);
        stats = BuildEcsPhysicsDebugLinesToSink<TestbedProjectedDebugLineSink>(world, physicsSystem.value(), options, projector, sink, debugScratch);
    }
    else{
        screenLines.clear();
    }
    if(grabState.active){
        VectorSingle grabSeg(0.0f);
        if(projector.projectSegment(VectorSingle(grabState.grabWorldPoint), VectorSingle(grabState.targetWorldPoint), grabSeg)){
            PaintLineSegment grabLine;
            grabLine.start = Point(grabSeg.x, grabSeg.y);
            grabLine.end = Point(grabSeg.z, grabSeg.w);
            grabLine.color = Color(0.98f, 0.92f, 0.20f, 1.0f);
            screenLines.push_back(grabLine);
        }
    }
    if(!screenLines.empty()){
        f32 lineThickness = 1.5f;
        if(IsFinite(VectorSingle(options.lineThickness)) && options.lineThickness > 0.0f)
            lineThickness = options.lineThickness;
        context.paint.drawLineBatch(Span<PaintLineSegment>(screenLines.data(), screenLines.size()), lineThickness);
    }
    return stats;
}


