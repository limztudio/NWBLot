[cpp_header("<global/simd/collision_detail.h>"), cpp_name("::CollisionDoubleDetail::MinMaxIntersects")]
extern b8 GeometryMinMaxIntersects(in VectorDouble minA, in VectorDouble maxA, in VectorDouble minB, in VectorDouble maxB);

[cpp_header("<global/simd/collision_triangle.h>"), cpp_name("::TriangleDoubleTests::Intersects")]
extern b8 GeometryProduction(in VectorDouble a0, in VectorDouble a1, in VectorDouble a2, in VectorDouble b0, in VectorDouble b1, in VectorDouble b2);

[cpp_header("<tests/performance/simd_optimization/benchmark_abi.h>"), cpp_name("::SimdBenchmarkAbi::ConsumeChecksum")]
extern void ConsumeGeometryChecksum(in u64 value);

[cpp_header("<tests/performance/simd_optimization/benchmark_abi.h>"), cpp_name("::SimdBenchmarkAbi::s_HasPosixFpTraps")]
extern const b8 s_HasGeometryTraps;

[cpp_header("<tests/performance/simd_optimization/benchmark_abi.h>"), cpp_name("::SimdBenchmarkAbi::InstallFloatTrapExit")]
extern b8 InstallFloatTrapExit(in i32 exitOffset);

[cpp_header("<tests/performance/simd_optimization/benchmark_abi.h>"), cpp_name("::SimdBenchmarkAbi::EnableFloatTraps")]
extern b8 EnableFloatTraps(in i32 mask);

b8 GeometryBaseline(in VectorDouble a0, in VectorDouble a1, in VectorDouble a2, in VectorDouble b0, in VectorDouble b1, in VectorDouble b2){
    const VectorDouble first0 = VectorDoubleAndInt(a0, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble first1 = VectorDoubleAndInt(a1, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble first2 = VectorDoubleAndInt(a2, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble second0 = VectorDoubleAndInt(b0, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble second1 = VectorDoubleAndInt(b1, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble second2 = VectorDoubleAndInt(b2, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble minA = VectorDoubleMin(first0, VectorDoubleMin(first1, first2));
    const VectorDouble maxA = VectorDoubleMax(first0, VectorDoubleMax(first1, first2));
    const VectorDouble minB = VectorDoubleMin(second0, VectorDoubleMin(second1, second2));
    const VectorDouble maxB = VectorDoubleMax(second0, VectorDoubleMax(second1, second2));
    if(!GeometryMinMaxIntersects(minA, maxA, minB, maxB))
        return false;

    const VectorDouble zero = VectorDoubleZero();
    const VectorDouble relativeA1 = VectorDoubleSubtract(first1, first0);
    const VectorDouble relativeA2 = VectorDoubleSubtract(first2, first0);
    const VectorDouble relativeB0 = VectorDoubleSubtract(second0, first0);
    const VectorDouble relativeB1 = VectorDoubleSubtract(second1, first0);
    const VectorDouble relativeB2 = VectorDoubleSubtract(second2, first0);
    auto differenceRoundoff = lambda[](in VectorDouble point, in VectorDouble origin, in VectorDouble difference) -> VectorDouble{
        // TwoDiff recovers the subtraction residual without expanding the allowance with a large common translation.
        const VectorDouble virtualOrigin = VectorDoubleSubtract(point, difference);
        const VectorDouble virtualPoint = VectorDoubleAdd(difference, virtualOrigin);
        return VectorDoubleAdd(VectorDoubleSubtract(point, virtualPoint), VectorDoubleSubtract(virtualOrigin, origin));
    };
    const VectorDouble roundoffA1 = differenceRoundoff(first1, first0, relativeA1);
    const VectorDouble roundoffA2 = differenceRoundoff(first2, first0, relativeA2);
    const VectorDouble roundoffB0 = differenceRoundoff(second0, first0, relativeB0);
    const VectorDouble roundoffB1 = differenceRoundoff(second1, first0, relativeB1);
    const VectorDouble roundoffB2 = differenceRoundoff(second2, first0, relativeB2);
    const VectorDouble edgeA0 = relativeA1;
    const VectorDouble edgeA1 = VectorDoubleSubtract(first2, first1);
    const VectorDouble edgeA2 = VectorDoubleNegate(relativeA2);
    const VectorDouble edgeB0 = VectorDoubleSubtract(second1, second0);
    const VectorDouble edgeB1 = VectorDoubleSubtract(second2, second1);
    const VectorDouble edgeB2 = VectorDoubleSubtract(second0, second2);
    auto crossAxis = lambda[](in VectorDouble first, in VectorDouble second) -> VectorDouble{
        // Separate products make parallel directions produce a zero axis instead of an explicit-FMA residual.
        const VectorDouble positive = VectorDoubleMultiply(first.yzxw, second.zxyw);
        const VectorDouble negative = VectorDoubleMultiply(first.zxyw, second.yzxw);
        return VectorDoubleSubtract(positive, negative);
    };
    auto separated = lambda[in zero, in relativeA1, in relativeA2, in relativeB0, in relativeB1, in relativeB2, in roundoffA1, in roundoffA2, in roundoffB0, in roundoffB1, in roundoffB2](in VectorDouble axis) -> b8{
        const VectorDouble absoluteAxis = VectorDoubleAbs(axis);
        auto projectionInterval = lambda[in absoluteAxis, in axis](in VectorDouble relative, in VectorDouble roundoff) -> VectorDouble{
            const VectorDouble projection = BaselineDot3(relative, axis);
            const VectorDouble magnitude = BaselineDot3(VectorDoubleAbs(relative), absoluteAxis);
            const VectorDouble coordinateError = BaselineDot3(VectorDoubleAbs(roundoff), absoluteAxis);
            // Eight epsilons bound cancellation and endpoint rounding across three products and two sums.
            const VectorDouble allowance = VectorDoubleMultiplyAddExpression(VectorDoubleAdd(magnitude, coordinateError), VectorDoubleReplicate(0x1p-49), coordinateError);
            return VectorDoubleSelect(VectorDoubleSubtract(projection, allowance), VectorDoubleAdd(projection, allowance), VectorDouble(u64x4(0u, u64.max, 0u, 0u)));
        };
        const VectorDouble intervalA1 = projectionInterval(relativeA1, roundoffA1);
        const VectorDouble intervalA2 = projectionInterval(relativeA2, roundoffA2);
        const VectorDouble minimumA = VectorDoubleMin(zero, VectorDoubleMin(VectorDoubleSplatX(intervalA1), VectorDoubleSplatX(intervalA2)));
        const VectorDouble maximumA = VectorDoubleMax(zero, VectorDoubleMax(VectorDoubleSplatY(intervalA1), VectorDoubleSplatY(intervalA2)));
        const VectorDouble intervalB0 = projectionInterval(relativeB0, roundoffB0);
        const VectorDouble intervalB1 = projectionInterval(relativeB1, roundoffB1);
        const VectorDouble intervalB2 = projectionInterval(relativeB2, roundoffB2);
        const VectorDouble minimumB = VectorDoubleMin(VectorDoubleSplatX(intervalB0), VectorDoubleMin(VectorDoubleSplatX(intervalB1), VectorDoubleSplatX(intervalB2)));
        const VectorDouble maximumB = VectorDoubleMax(VectorDoubleSplatY(intervalB0), VectorDoubleMax(VectorDoubleSplatY(intervalB1), VectorDoubleSplatY(intervalB2)));
        return VectorDouble4Less(maximumA, minimumB) || VectorDouble4Less(maximumB, minimumA);
    };
    const VectorDouble normalA = crossAxis(edgeA0, VectorDoubleNegate(edgeA2));
    const VectorDouble normalB = crossAxis(edgeB0, VectorDoubleNegate(edgeB2));
    if(separated(normalA) || separated(normalB))
        return false;

    if(VectorDouble3Equal(normalA, zero) && VectorDouble3Equal(normalB, zero)){
        // Closed degenerate triangles retain their point/segment hulls, including collinear endpoint contact.
        VectorDouble directionA = edgeA0;
        if(VectorDouble3Equal(edgeA0, zero))
            directionA = edgeA1;
        VectorDouble directionB = edgeB0;
        if(VectorDouble3Equal(edgeB0, zero))
            directionB = edgeB1;
        const VectorDouble normal = crossAxis(directionA, directionB);
        if(separated(directionA) || separated(directionB) || separated(normal) || separated(crossAxis(directionA, normal)) || separated(crossAxis(directionB, normal)))
            return false;
        auto parallelSeparated = lambda[in crossAxis, in separated](in VectorDouble direction) -> b8{
            return separated(crossAxis(direction, VectorDouble(1.0, 0.0, 0.0, 0.0))) || separated(crossAxis(direction, VectorDouble(0.0, 1.0, 0.0, 0.0))) || separated(crossAxis(direction, VectorDouble(0.0, 0.0, 1.0, 0.0)));
        };
        return !parallelSeparated(directionA) && !parallelSeparated(directionB);
    }

    auto edgeSeparated = lambda[in edgeB0, in edgeB1, in edgeB2, in crossAxis, in separated, in normalA, in normalB](in VectorDouble edge) -> b8{
        // In-plane edge normals are necessary when the triangles are coplanar or one hull is degenerate.
        return separated(crossAxis(edge, normalA)) || separated(crossAxis(edge, normalB)) || separated(crossAxis(edge, edgeB0)) || separated(crossAxis(edge, edgeB1)) || separated(crossAxis(edge, edgeB2));
    };
    if(edgeSeparated(edgeA0) || edgeSeparated(edgeA1) || edgeSeparated(edgeA2))
        return false;
    auto secondEdgeSeparated = lambda[in crossAxis, in separated, in normalA, in normalB](in VectorDouble edge) -> b8{
        return separated(crossAxis(edge, normalA)) || separated(crossAxis(edge, normalB));
    };
    return !secondEdgeSeparated(edgeB0) && !secondEdgeSeparated(edgeB1) && !secondEdgeSeparated(edgeB2);
}

b8 GeometryCurrentDot3Baseline(in VectorDouble a0, in VectorDouble a1, in VectorDouble a2, in VectorDouble b0, in VectorDouble b1, in VectorDouble b2){
    const VectorDouble first0 = VectorDoubleAndInt(a0, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble first1 = VectorDoubleAndInt(a1, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble first2 = VectorDoubleAndInt(a2, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble second0 = VectorDoubleAndInt(b0, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble second1 = VectorDoubleAndInt(b1, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble second2 = VectorDoubleAndInt(b2, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble minA = VectorDoubleMin(first0, VectorDoubleMin(first1, first2));
    const VectorDouble maxA = VectorDoubleMax(first0, VectorDoubleMax(first1, first2));
    const VectorDouble minB = VectorDoubleMin(second0, VectorDoubleMin(second1, second2));
    const VectorDouble maxB = VectorDoubleMax(second0, VectorDoubleMax(second1, second2));
    if(!GeometryMinMaxIntersects(minA, maxA, minB, maxB))
        return false;

    const VectorDouble zero = VectorDoubleZero();
    const VectorDouble relativeA1 = VectorDoubleSubtract(first1, first0);
    const VectorDouble relativeA2 = VectorDoubleSubtract(first2, first0);
    const VectorDouble relativeB0 = VectorDoubleSubtract(second0, first0);
    const VectorDouble relativeB1 = VectorDoubleSubtract(second1, first0);
    const VectorDouble relativeB2 = VectorDoubleSubtract(second2, first0);
    auto differenceRoundoff = lambda[](in VectorDouble point, in VectorDouble origin, in VectorDouble difference) -> VectorDouble{
        const VectorDouble virtualOrigin = VectorDoubleSubtract(point, difference);
        const VectorDouble virtualPoint = VectorDoubleAdd(difference, virtualOrigin);
        return VectorDoubleAdd(VectorDoubleSubtract(point, virtualPoint), VectorDoubleSubtract(virtualOrigin, origin));
    };
    const VectorDouble roundoffA1 = differenceRoundoff(first1, first0, relativeA1);
    const VectorDouble roundoffA2 = differenceRoundoff(first2, first0, relativeA2);
    const VectorDouble roundoffB0 = differenceRoundoff(second0, first0, relativeB0);
    const VectorDouble roundoffB1 = differenceRoundoff(second1, first0, relativeB1);
    const VectorDouble roundoffB2 = differenceRoundoff(second2, first0, relativeB2);
    const VectorDouble edgeA0 = relativeA1;
    const VectorDouble edgeA1 = VectorDoubleSubtract(first2, first1);
    const VectorDouble edgeA2 = VectorDoubleNegate(relativeA2);
    const VectorDouble edgeB0 = VectorDoubleSubtract(second1, second0);
    const VectorDouble edgeB1 = VectorDoubleSubtract(second2, second1);
    const VectorDouble edgeB2 = VectorDoubleSubtract(second0, second2);
    auto crossAxis = lambda[](in VectorDouble first, in VectorDouble second) -> VectorDouble{
        const VectorDouble positive = VectorDoubleMultiply(first.yzxw, second.zxyw);
        const VectorDouble negative = VectorDoubleMultiply(first.zxyw, second.yzxw);
        return VectorDoubleSubtract(positive, negative);
    };
    auto separated = lambda[in zero, in relativeA1, in relativeA2, in relativeB0, in relativeB1, in relativeB2, in roundoffA1, in roundoffA2, in roundoffB0, in roundoffB1, in roundoffB2](in VectorDouble axis) -> b8{
        const VectorDouble absoluteAxis = VectorDoubleAbs(axis);
        auto projectionInterval = lambda[in absoluteAxis, in axis](in VectorDouble relative, in VectorDouble roundoff) -> VectorDouble{
            const VectorDouble projection = VectorDouble3Dot(relative, axis);
            const VectorDouble magnitude = VectorDouble3Dot(VectorDoubleAbs(relative), absoluteAxis);
            const VectorDouble coordinateError = VectorDouble3Dot(VectorDoubleAbs(roundoff), absoluteAxis);
            const VectorDouble allowance = VectorDoubleMultiplyAddExpression(VectorDoubleAdd(magnitude, coordinateError), VectorDoubleReplicate(0x1p-49), coordinateError);
            return VectorDoubleSelect(VectorDoubleSubtract(projection, allowance), VectorDoubleAdd(projection, allowance), VectorDouble(u64x4(0u, u64.max, 0u, 0u)));
        };
        const VectorDouble intervalA1 = projectionInterval(relativeA1, roundoffA1);
        const VectorDouble intervalA2 = projectionInterval(relativeA2, roundoffA2);
        const VectorDouble minimumA = VectorDoubleMin(zero, VectorDoubleMin(VectorDoubleSplatX(intervalA1), VectorDoubleSplatX(intervalA2)));
        const VectorDouble maximumA = VectorDoubleMax(zero, VectorDoubleMax(VectorDoubleSplatY(intervalA1), VectorDoubleSplatY(intervalA2)));
        const VectorDouble intervalB0 = projectionInterval(relativeB0, roundoffB0);
        const VectorDouble intervalB1 = projectionInterval(relativeB1, roundoffB1);
        const VectorDouble intervalB2 = projectionInterval(relativeB2, roundoffB2);
        const VectorDouble minimumB = VectorDoubleMin(VectorDoubleSplatX(intervalB0), VectorDoubleMin(VectorDoubleSplatX(intervalB1), VectorDoubleSplatX(intervalB2)));
        const VectorDouble maximumB = VectorDoubleMax(VectorDoubleSplatY(intervalB0), VectorDoubleMax(VectorDoubleSplatY(intervalB1), VectorDoubleSplatY(intervalB2)));
        return VectorDouble4Less(maximumA, minimumB) || VectorDouble4Less(maximumB, minimumA);
    };
    const VectorDouble normalA = crossAxis(edgeA0, VectorDoubleNegate(edgeA2));
    const VectorDouble normalB = crossAxis(edgeB0, VectorDoubleNegate(edgeB2));
    if(separated(normalA) || separated(normalB))
        return false;

    if(VectorDouble3Equal(normalA, zero) && VectorDouble3Equal(normalB, zero)){
        VectorDouble directionA = edgeA0;
        if(VectorDouble3Equal(edgeA0, zero))
            directionA = edgeA1;
        VectorDouble directionB = edgeB0;
        if(VectorDouble3Equal(edgeB0, zero))
            directionB = edgeB1;
        const VectorDouble normal = crossAxis(directionA, directionB);
        if(separated(directionA) || separated(directionB) || separated(normal) || separated(crossAxis(directionA, normal)) || separated(crossAxis(directionB, normal)))
            return false;
        auto parallelSeparated = lambda[in crossAxis, in separated](in VectorDouble direction) -> b8{
            return separated(crossAxis(direction, VectorDouble(1.0, 0.0, 0.0, 0.0))) || separated(crossAxis(direction, VectorDouble(0.0, 1.0, 0.0, 0.0))) || separated(crossAxis(direction, VectorDouble(0.0, 0.0, 1.0, 0.0)));
        };
        return !parallelSeparated(directionA) && !parallelSeparated(directionB);
    }

    auto edgeSeparated = lambda[in edgeB0, in edgeB1, in edgeB2, in crossAxis, in separated, in normalA, in normalB](in VectorDouble edge) -> b8{
        return separated(crossAxis(edge, normalA)) || separated(crossAxis(edge, normalB)) || separated(crossAxis(edge, edgeB0)) || separated(crossAxis(edge, edgeB1)) || separated(crossAxis(edge, edgeB2));
    };
    if(edgeSeparated(edgeA0) || edgeSeparated(edgeA1) || edgeSeparated(edgeA2))
        return false;
    auto secondEdgeSeparated = lambda[in crossAxis, in separated, in normalA, in normalB](in VectorDouble edge) -> b8{
        return separated(crossAxis(edge, normalA)) || separated(crossAxis(edge, normalB));
    };
    return !secondEdgeSeparated(edgeB0) && !secondEdgeSeparated(edgeB1) && !secondEdgeSeparated(edgeB2);
}

b8 GeometryZeroAxis(in VectorDouble a0, in VectorDouble a1, in VectorDouble a2, in VectorDouble b0, in VectorDouble b1, in VectorDouble b2){
    const VectorDouble first0 = VectorDoubleAndInt(a0, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble first1 = VectorDoubleAndInt(a1, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble first2 = VectorDoubleAndInt(a2, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble second0 = VectorDoubleAndInt(b0, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble second1 = VectorDoubleAndInt(b1, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble second2 = VectorDoubleAndInt(b2, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble minA = VectorDoubleMin(first0, VectorDoubleMin(first1, first2));
    const VectorDouble maxA = VectorDoubleMax(first0, VectorDoubleMax(first1, first2));
    const VectorDouble minB = VectorDoubleMin(second0, VectorDoubleMin(second1, second2));
    const VectorDouble maxB = VectorDoubleMax(second0, VectorDoubleMax(second1, second2));
    if(!GeometryMinMaxIntersects(minA, maxA, minB, maxB))
        return false;

    const VectorDouble zero = VectorDoubleZero();
    const VectorDouble relativeA1 = VectorDoubleSubtract(first1, first0);
    const VectorDouble relativeA2 = VectorDoubleSubtract(first2, first0);
    const VectorDouble relativeB0 = VectorDoubleSubtract(second0, first0);
    const VectorDouble relativeB1 = VectorDoubleSubtract(second1, first0);
    const VectorDouble relativeB2 = VectorDoubleSubtract(second2, first0);
    auto differenceRoundoff = lambda[](in VectorDouble point, in VectorDouble origin, in VectorDouble difference) -> VectorDouble{
        const VectorDouble virtualOrigin = VectorDoubleSubtract(point, difference);
        const VectorDouble virtualPoint = VectorDoubleAdd(difference, virtualOrigin);
        return VectorDoubleAdd(VectorDoubleSubtract(point, virtualPoint), VectorDoubleSubtract(virtualOrigin, origin));
    };
    const VectorDouble roundoffA1 = differenceRoundoff(first1, first0, relativeA1);
    const VectorDouble roundoffA2 = differenceRoundoff(first2, first0, relativeA2);
    const VectorDouble roundoffB0 = differenceRoundoff(second0, first0, relativeB0);
    const VectorDouble roundoffB1 = differenceRoundoff(second1, first0, relativeB1);
    const VectorDouble roundoffB2 = differenceRoundoff(second2, first0, relativeB2);
    const VectorDouble edgeA0 = relativeA1;
    const VectorDouble edgeA1 = VectorDoubleSubtract(first2, first1);
    const VectorDouble edgeA2 = VectorDoubleNegate(relativeA2);
    const VectorDouble edgeB0 = VectorDoubleSubtract(second1, second0);
    const VectorDouble edgeB1 = VectorDoubleSubtract(second2, second1);
    const VectorDouble edgeB2 = VectorDoubleSubtract(second0, second2);
    auto crossAxis = lambda[](in VectorDouble first, in VectorDouble second) -> VectorDouble{
        const VectorDouble positive = VectorDoubleMultiply(first.yzxw, second.zxyw);
        const VectorDouble negative = VectorDoubleMultiply(first.zxyw, second.yzxw);
        return VectorDoubleSubtract(positive, negative);
    };
    auto separated = lambda[in zero, in relativeA1, in relativeA2, in relativeB0, in relativeB1, in relativeB2, in roundoffA1, in roundoffA2, in roundoffB0, in roundoffB1, in roundoffB2](in VectorDouble axis) -> b8{
        if(VectorDouble3Equal(axis, zero))
            return false;
        const VectorDouble absoluteAxis = VectorDoubleAbs(axis);
        auto projectionInterval = lambda[in absoluteAxis, in axis](in VectorDouble relative, in VectorDouble roundoff) -> VectorDouble{
            const VectorDouble projection = VectorDouble3Dot(relative, axis);
            const VectorDouble magnitude = VectorDouble3Dot(VectorDoubleAbs(relative), absoluteAxis);
            const VectorDouble coordinateError = VectorDouble3Dot(VectorDoubleAbs(roundoff), absoluteAxis);
            const VectorDouble allowance = VectorDoubleMultiplyAddExpression(VectorDoubleAdd(magnitude, coordinateError), VectorDoubleReplicate(0x1p-49), coordinateError);
            return VectorDoubleSelect(VectorDoubleSubtract(projection, allowance), VectorDoubleAdd(projection, allowance), VectorDouble(u64x4(0u, u64.max, 0u, 0u)));
        };
        const VectorDouble intervalA1 = projectionInterval(relativeA1, roundoffA1);
        const VectorDouble intervalA2 = projectionInterval(relativeA2, roundoffA2);
        const VectorDouble minimumA = VectorDoubleMin(zero, VectorDoubleMin(VectorDoubleSplatX(intervalA1), VectorDoubleSplatX(intervalA2)));
        const VectorDouble maximumA = VectorDoubleMax(zero, VectorDoubleMax(VectorDoubleSplatY(intervalA1), VectorDoubleSplatY(intervalA2)));
        const VectorDouble intervalB0 = projectionInterval(relativeB0, roundoffB0);
        const VectorDouble intervalB1 = projectionInterval(relativeB1, roundoffB1);
        const VectorDouble intervalB2 = projectionInterval(relativeB2, roundoffB2);
        const VectorDouble minimumB = VectorDoubleMin(VectorDoubleSplatX(intervalB0), VectorDoubleMin(VectorDoubleSplatX(intervalB1), VectorDoubleSplatX(intervalB2)));
        const VectorDouble maximumB = VectorDoubleMax(VectorDoubleSplatY(intervalB0), VectorDoubleMax(VectorDoubleSplatY(intervalB1), VectorDoubleSplatY(intervalB2)));
        return VectorDouble4Less(maximumA, minimumB) || VectorDouble4Less(maximumB, minimumA);
    };
    const VectorDouble normalA = crossAxis(edgeA0, VectorDoubleNegate(edgeA2));
    const VectorDouble normalB = crossAxis(edgeB0, VectorDoubleNegate(edgeB2));
    if(separated(normalA) || separated(normalB))
        return false;

    if(VectorDouble3Equal(normalA, zero) && VectorDouble3Equal(normalB, zero)){
        VectorDouble directionA = edgeA0;
        if(VectorDouble3Equal(edgeA0, zero))
            directionA = edgeA1;
        VectorDouble directionB = edgeB0;
        if(VectorDouble3Equal(edgeB0, zero))
            directionB = edgeB1;
        const VectorDouble normal = crossAxis(directionA, directionB);
        if(separated(directionA) || separated(directionB) || separated(normal) || separated(crossAxis(directionA, normal)) || separated(crossAxis(directionB, normal)))
            return false;
        auto parallelSeparated = lambda[in crossAxis, in separated](in VectorDouble direction) -> b8{
            return separated(crossAxis(direction, VectorDouble(1.0, 0.0, 0.0, 0.0))) || separated(crossAxis(direction, VectorDouble(0.0, 1.0, 0.0, 0.0))) || separated(crossAxis(direction, VectorDouble(0.0, 0.0, 1.0, 0.0)));
        };
        return !parallelSeparated(directionA) && !parallelSeparated(directionB);
    }

    auto edgeSeparated = lambda[in edgeB0, in edgeB1, in edgeB2, in crossAxis, in separated, in normalA, in normalB](in VectorDouble edge) -> b8{
        return separated(crossAxis(edge, normalA)) || separated(crossAxis(edge, normalB)) || separated(crossAxis(edge, edgeB0)) || separated(crossAxis(edge, edgeB1)) || separated(crossAxis(edge, edgeB2));
    };
    if(edgeSeparated(edgeA0) || edgeSeparated(edgeA1) || edgeSeparated(edgeA2))
        return false;
    auto secondEdgeSeparated = lambda[in crossAxis, in separated, in normalA, in normalB](in VectorDouble edge) -> b8{
        return separated(crossAxis(edge, normalA)) || separated(crossAxis(edge, normalB));
    };
    return !secondEdgeSeparated(edgeB0) && !secondEdgeSeparated(edgeB1) && !secondEdgeSeparated(edgeB2);
}

b8 GeometryAbsHoisted(in VectorDouble a0, in VectorDouble a1, in VectorDouble a2, in VectorDouble b0, in VectorDouble b1, in VectorDouble b2){
    const VectorDouble first0 = VectorDoubleAndInt(a0, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble first1 = VectorDoubleAndInt(a1, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble first2 = VectorDoubleAndInt(a2, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble second0 = VectorDoubleAndInt(b0, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble second1 = VectorDoubleAndInt(b1, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble second2 = VectorDoubleAndInt(b2, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble minA = VectorDoubleMin(first0, VectorDoubleMin(first1, first2));
    const VectorDouble maxA = VectorDoubleMax(first0, VectorDoubleMax(first1, first2));
    const VectorDouble minB = VectorDoubleMin(second0, VectorDoubleMin(second1, second2));
    const VectorDouble maxB = VectorDoubleMax(second0, VectorDoubleMax(second1, second2));
    if(!GeometryMinMaxIntersects(minA, maxA, minB, maxB))
        return false;

    const VectorDouble zero = VectorDoubleZero();
    const VectorDouble relativeA1 = VectorDoubleSubtract(first1, first0);
    const VectorDouble relativeA2 = VectorDoubleSubtract(first2, first0);
    const VectorDouble relativeB0 = VectorDoubleSubtract(second0, first0);
    const VectorDouble relativeB1 = VectorDoubleSubtract(second1, first0);
    const VectorDouble relativeB2 = VectorDoubleSubtract(second2, first0);
    const VectorDouble absoluteA1 = VectorDoubleAbs(relativeA1);
    const VectorDouble absoluteA2 = VectorDoubleAbs(relativeA2);
    const VectorDouble absoluteB0 = VectorDoubleAbs(relativeB0);
    const VectorDouble absoluteB1 = VectorDoubleAbs(relativeB1);
    const VectorDouble absoluteB2 = VectorDoubleAbs(relativeB2);
    auto differenceRoundoff = lambda[](in VectorDouble point, in VectorDouble origin, in VectorDouble difference) -> VectorDouble{
        const VectorDouble virtualOrigin = VectorDoubleSubtract(point, difference);
        const VectorDouble virtualPoint = VectorDoubleAdd(difference, virtualOrigin);
        return VectorDoubleAdd(VectorDoubleSubtract(point, virtualPoint), VectorDoubleSubtract(virtualOrigin, origin));
    };
    const VectorDouble roundoffA1 = VectorDoubleAbs(differenceRoundoff(first1, first0, relativeA1));
    const VectorDouble roundoffA2 = VectorDoubleAbs(differenceRoundoff(first2, first0, relativeA2));
    const VectorDouble roundoffB0 = VectorDoubleAbs(differenceRoundoff(second0, first0, relativeB0));
    const VectorDouble roundoffB1 = VectorDoubleAbs(differenceRoundoff(second1, first0, relativeB1));
    const VectorDouble roundoffB2 = VectorDoubleAbs(differenceRoundoff(second2, first0, relativeB2));
    const VectorDouble edgeA0 = relativeA1;
    const VectorDouble edgeA1 = VectorDoubleSubtract(first2, first1);
    const VectorDouble edgeA2 = VectorDoubleNegate(relativeA2);
    const VectorDouble edgeB0 = VectorDoubleSubtract(second1, second0);
    const VectorDouble edgeB1 = VectorDoubleSubtract(second2, second1);
    const VectorDouble edgeB2 = VectorDoubleSubtract(second0, second2);
    auto crossAxis = lambda[](in VectorDouble first, in VectorDouble second) -> VectorDouble{
        const VectorDouble positive = VectorDoubleMultiply(first.yzxw, second.zxyw);
        const VectorDouble negative = VectorDoubleMultiply(first.zxyw, second.yzxw);
        return VectorDoubleSubtract(positive, negative);
    };
    auto separated = lambda[in zero, in relativeA1, in relativeA2, in relativeB0, in relativeB1, in relativeB2, in absoluteA1, in absoluteA2, in absoluteB0, in absoluteB1, in absoluteB2, in roundoffA1, in roundoffA2, in roundoffB0, in roundoffB1, in roundoffB2](in VectorDouble axis) -> b8{
        if(VectorDouble3Equal(axis, zero))
            return false;
        const VectorDouble absoluteAxis = VectorDoubleAbs(axis);
        auto projectionInterval = lambda[in absoluteAxis, in axis](in VectorDouble relative, in VectorDouble absoluteRelative, in VectorDouble absoluteRoundoff) -> VectorDouble{
            const VectorDouble projection = VectorDouble3Dot(relative, axis);
            const VectorDouble magnitude = VectorDouble3Dot(absoluteRelative, absoluteAxis);
            const VectorDouble coordinateError = VectorDouble3Dot(absoluteRoundoff, absoluteAxis);
            const VectorDouble allowance = VectorDoubleMultiplyAddExpression(VectorDoubleAdd(magnitude, coordinateError), VectorDoubleReplicate(0x1p-49), coordinateError);
            return VectorDoubleSelect(VectorDoubleSubtract(projection, allowance), VectorDoubleAdd(projection, allowance), VectorDouble(u64x4(0u, u64.max, 0u, 0u)));
        };
        const VectorDouble intervalA1 = projectionInterval(relativeA1, absoluteA1, roundoffA1);
        const VectorDouble intervalA2 = projectionInterval(relativeA2, absoluteA2, roundoffA2);
        const VectorDouble minimumA = VectorDoubleMin(zero, VectorDoubleMin(VectorDoubleSplatX(intervalA1), VectorDoubleSplatX(intervalA2)));
        const VectorDouble maximumA = VectorDoubleMax(zero, VectorDoubleMax(VectorDoubleSplatY(intervalA1), VectorDoubleSplatY(intervalA2)));
        const VectorDouble intervalB0 = projectionInterval(relativeB0, absoluteB0, roundoffB0);
        const VectorDouble intervalB1 = projectionInterval(relativeB1, absoluteB1, roundoffB1);
        const VectorDouble intervalB2 = projectionInterval(relativeB2, absoluteB2, roundoffB2);
        const VectorDouble minimumB = VectorDoubleMin(VectorDoubleSplatX(intervalB0), VectorDoubleMin(VectorDoubleSplatX(intervalB1), VectorDoubleSplatX(intervalB2)));
        const VectorDouble maximumB = VectorDoubleMax(VectorDoubleSplatY(intervalB0), VectorDoubleMax(VectorDoubleSplatY(intervalB1), VectorDoubleSplatY(intervalB2)));
        return VectorDouble4Less(maximumA, minimumB) || VectorDouble4Less(maximumB, minimumA);
    };
    const VectorDouble normalA = crossAxis(edgeA0, VectorDoubleNegate(edgeA2));
    const VectorDouble normalB = crossAxis(edgeB0, VectorDoubleNegate(edgeB2));
    if(separated(normalA) || separated(normalB))
        return false;

    if(VectorDouble3Equal(normalA, zero) && VectorDouble3Equal(normalB, zero)){
        VectorDouble directionA = edgeA0;
        if(VectorDouble3Equal(edgeA0, zero))
            directionA = edgeA1;
        VectorDouble directionB = edgeB0;
        if(VectorDouble3Equal(edgeB0, zero))
            directionB = edgeB1;
        const VectorDouble normal = crossAxis(directionA, directionB);
        if(separated(directionA) || separated(directionB) || separated(normal) || separated(crossAxis(directionA, normal)) || separated(crossAxis(directionB, normal)))
            return false;
        auto parallelSeparated = lambda[in crossAxis, in separated](in VectorDouble direction) -> b8{
            return separated(crossAxis(direction, VectorDouble(1.0, 0.0, 0.0, 0.0))) || separated(crossAxis(direction, VectorDouble(0.0, 1.0, 0.0, 0.0))) || separated(crossAxis(direction, VectorDouble(0.0, 0.0, 1.0, 0.0)));
        };
        return !parallelSeparated(directionA) && !parallelSeparated(directionB);
    }

    auto edgeSeparated = lambda[in edgeB0, in edgeB1, in edgeB2, in crossAxis, in separated, in normalA, in normalB](in VectorDouble edge) -> b8{
        return separated(crossAxis(edge, normalA)) || separated(crossAxis(edge, normalB)) || separated(crossAxis(edge, edgeB0)) || separated(crossAxis(edge, edgeB1)) || separated(crossAxis(edge, edgeB2));
    };
    if(edgeSeparated(edgeA0) || edgeSeparated(edgeA1) || edgeSeparated(edgeA2))
        return false;
    auto secondEdgeSeparated = lambda[in crossAxis, in separated, in normalA, in normalB](in VectorDouble edge) -> b8{
        return separated(crossAxis(edge, normalA)) || separated(crossAxis(edge, normalB));
    };
    return !secondEdgeSeparated(edgeB0) && !secondEdgeSeparated(edgeB1) && !secondEdgeSeparated(edgeB2);
}

type GeometryIntersection = Func<0u, b8(in VectorDouble, in VectorDouble, in VectorDouble, in VectorDouble, in VectorDouble, in VectorDouble)>;

GeometryIntersection SelectGeometryImplementation(in u32 implementation){
    switch(implementation){
    case 0u: return GeometryBaseline;
    case 1u: return GeometryCurrentDot3Baseline;
    case 2u: return GeometryZeroAxis;
    case 3u: return GeometryAbsHoisted;
    default: return lambda[](in VectorDouble a0, in VectorDouble a1, in VectorDouble a2, in VectorDouble b0, in VectorDouble b1, in VectorDouble b2) -> b8{
        return GeometryProduction(a0, a1, a2, b0, b1, b2);
    };
    }
}

b8 EvaluateGeometryPair(in GeometryIntersection implementation, in TrianglePair pair){
    return implementation(VectorDouble(pair.first[0u]), VectorDouble(pair.first[1u]), VectorDouble(pair.first[2u]),
        VectorDouble(pair.second[0u]), VectorDouble(pair.second[1u]), VectorDouble(pair.second[2u]));
}

u64 RunGeometryBatchKernel(in u32 implId, in Span<TrianglePair> pairs, in u32 passes){
    const GeometryIntersection implementation = SelectGeometryImplementation(implId);
    u64 result = 0u;
    for(u32 pass = 0u; pass < passes; ++pass){
        for(in TrianglePair pair : pairs){
            if(EvaluateGeometryPair(implementation, pair))
                ++result;
        }
    }
    ConsumeGeometryChecksum(result);
    return result;
}

Expected<i32> GeometryTrapResult(in GeometryIntersection implementation, in TrianglePair pair, in i32 mask){
    const i32 child = ForkTestChild();
    if(child < 0)
        return MakeUnexpected(Failure());
    if(child == 0){
        if(!InstallFloatTrapExit(32) || !HoldFloatingPointExceptions() || !EnableFloatTraps(mask))
            ExitTestChild(127);
        if(EvaluateGeometryPair(implementation, pair))
            ExitTestChild(1);
        ExitTestChild(0);
    }
    const ChildWaitResult status = WaitForTestChild(child);
    if(!status.collected || !status.exited)
        return MakeUnexpected(Failure());
    return status.exitCode;
}

b8 CheckTrapEquivalence(in TrianglePair pair){
    if(!s_HasGeometryTraps)
        return true;
    const Array<i32, 4> masks(FE_INVALID, FE_OVERFLOW, FE_INVALID | FE_OVERFLOW, FE_INVALID | FE_OVERFLOW | FE_UNDERFLOW | FE_INEXACT);
    for(in i32 mask : masks){
        const auto baseline = GeometryTrapResult(SelectGeometryImplementation(0u), pair, mask);
        if(!baseline || baseline.value() == 127)
            return false;
        const auto zeroAxis = GeometryTrapResult(SelectGeometryImplementation(2u), pair, mask);
        if(!zeroAxis || zeroAxis.value() != baseline.value())
            return false;
        const auto hoisted = GeometryTrapResult(SelectGeometryImplementation(3u), pair, mask);
        if(!hoisted || hoisted.value() != baseline.value())
            return false;
        const auto production = GeometryTrapResult(SelectGeometryImplementation(4u), pair, mask);
        if(!production || production.value() != baseline.value())
            return false;
    }
    return true;
}

b8 CheckExceptionEquivalence(in TrianglePair pair){
    const auto originalEnvironment = HoldFloatingPointExceptions();
    if(!originalEnvironment)
        return false;
    FloatingPointEnvironmentGuard restoreEnvironment(originalEnvironment.value());
    const b8 original = GeometryBaseline(VectorDouble(pair.first[0]), VectorDouble(pair.first[1]), VectorDouble(pair.first[2]), VectorDouble(pair.second[0]), VectorDouble(pair.second[1]), VectorDouble(pair.second[2]));
    const i32 originalFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    const b8 reference = GeometryZeroAxis(VectorDouble(pair.first[0]), VectorDouble(pair.first[1]), VectorDouble(pair.first[2]), VectorDouble(pair.second[0]), VectorDouble(pair.second[1]), VectorDouble(pair.second[2]));
    const i32 referenceFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    const b8 hoisted = GeometryAbsHoisted(VectorDouble(pair.first[0]), VectorDouble(pair.first[1]), VectorDouble(pair.first[2]), VectorDouble(pair.second[0]), VectorDouble(pair.second[1]), VectorDouble(pair.second[2]));
    const i32 hoistedFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    const b8 production = GeometryProduction(VectorDouble(pair.first[0]), VectorDouble(pair.first[1]), VectorDouble(pair.first[2]), VectorDouble(pair.second[0]), VectorDouble(pair.second[1]), VectorDouble(pair.second[2]));
    const i32 productionFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    return original == reference && reference == hoisted && hoisted == production && originalFlags == referenceFlags && referenceFlags == hoistedFlags && hoistedFlags == productionFlags;
}

u64 NextGeometryVerifySeed(mut u64 state){
    state ^= state << 13u;
    state ^= state >> 7u;
    state ^= state << 17u;
    return state;
}

b8 CheckTrianglePairPermutationsKernel(in TrianglePair pair, in b8 expected){
    const Array<Array<u32, 3>, 6> permutations(
        Array<u32, 3>(0u, 1u, 2u), Array<u32, 3>(0u, 2u, 1u), Array<u32, 3>(1u, 0u, 2u),
        Array<u32, 3>(1u, 2u, 0u), Array<u32, 3>(2u, 0u, 1u), Array<u32, 3>(2u, 1u, 0u));
    b8 valid = true;
    for(in auto firstOrder : permutations){
        for(in auto secondOrder : permutations){
            for(u32 reverse = 0u; reverse < 2u; ++reverse){
                TrianglePair permuted;
                for(usize vertex = 0u; vertex < 3u; ++vertex){
                    if(reverse != 0u){
                        permuted.first[vertex] = pair.second[secondOrder[vertex]];
                        permuted.second[vertex] = pair.first[firstOrder[vertex]];
                    }
                    else{
                        permuted.first[vertex] = pair.first[firstOrder[vertex]];
                        permuted.second[vertex] = pair.second[secondOrder[vertex]];
                    }
                }
                const b8 original = EvaluateGeometryPair(SelectGeometryImplementation(0u), permuted);
                const b8 zeroAxis = EvaluateGeometryPair(SelectGeometryImplementation(2u), permuted);
                const b8 production = EvaluateGeometryPair(SelectGeometryImplementation(4u), permuted);
                const b8 hoisted = EvaluateGeometryPair(SelectGeometryImplementation(3u), permuted);
                if(original != expected || zeroAxis != expected || production != expected || hoisted != expected)
                    valid = false;
            }
        }
    }
    return valid;
}

b8 ValidateGeometryContainmentAndTrapsKernel(in TrianglePair fixture0, in TrianglePair fixture3){
    const u64 s_VerifyInitialState = 0x4f1bbcdc6762c13fu;
    const u32 s_ContainedSampleCount = 200000u;
    u64 state = s_VerifyInitialState;
    b8 valid = true;
    for(u32 sample = 0u; sample < s_ContainedSampleCount && valid; ++sample){
        TrianglePair pair;
        for(u32 vertex = 0u; vertex < 3u; ++vertex){
            Array<f64, 3> coordinates;
            for(mut f64 coordinate : coordinates)
                coordinate = cast<f64>(cast<i64>(NextGeometryVerifySeed(state) % 2000000001u) - 1000000000);
            pair.first[vertex] = f64x4(VectorDoubleScale(VectorDoubleSet(coordinates[0], coordinates[1], coordinates[2], 0.0), 0.25));
        }
        const VectorDouble contained = VectorDoubleScale(VectorDoubleAdd(VectorDoubleAdd(VectorDoubleScale(VectorDouble(pair.first[0]), 2.0), VectorDouble(pair.first[1])), VectorDouble(pair.first[2])), 0.25);
        for(mut f64x4 vertex : pair.second)
            vertex = f64x4(contained);
        if(
            !GeometryBaseline(VectorDouble(pair.first[0]), VectorDouble(pair.first[1]), VectorDouble(pair.first[2]), contained, contained, contained)
            || !GeometryZeroAxis(VectorDouble(pair.first[0]), VectorDouble(pair.first[1]), VectorDouble(pair.first[2]), contained, contained, contained)
            || !GeometryProduction(VectorDouble(pair.first[0]), VectorDouble(pair.first[1]), VectorDouble(pair.first[2]), contained, contained, contained)
            || !GeometryAbsHoisted(VectorDouble(pair.first[0]), VectorDouble(pair.first[1]), VectorDouble(pair.first[2]), contained, contained, contained)
        ){
            valid = false;
            break;
        }
        for(u32 vertex = 0u; vertex < 3u; ++vertex){
            Array<f64, 3> coordinates;
            for(mut f64 coordinate : coordinates)
                coordinate = cast<f64>(cast<i64>(NextGeometryVerifySeed(state) % 2000001u) - 1000000);
            pair.first[vertex] = f64x4(VectorDoubleSet(coordinates[0], coordinates[1], coordinates[2], 0.0));
        }
        const VectorDouble containedSingle = VectorDoubleScale(VectorDoubleAdd(VectorDoubleAdd(VectorDoubleScale(VectorDouble(pair.first[0]), 2.0), VectorDouble(pair.first[1])), VectorDouble(pair.first[2])), 0.25);
        for(u32 vertex = 0u; vertex < 3u; ++vertex){
            pair.first[vertex] = f64x4(ConvertVectorSingleToDouble(ConvertVectorDoubleToSingle(VectorDouble(pair.first[vertex]))));
            pair.second[vertex] = f64x4(ConvertVectorSingleToDouble(ConvertVectorDoubleToSingle(containedSingle)));
        }
        if(
            !GeometryBaseline(VectorDouble(pair.first[0]), VectorDouble(pair.first[1]), VectorDouble(pair.first[2]), VectorDouble(pair.second[0]), VectorDouble(pair.second[1]), VectorDouble(pair.second[2]))
            || !GeometryZeroAxis(VectorDouble(pair.first[0]), VectorDouble(pair.first[1]), VectorDouble(pair.first[2]), VectorDouble(pair.second[0]), VectorDouble(pair.second[1]), VectorDouble(pair.second[2]))
            || !GeometryProduction(VectorDouble(pair.first[0]), VectorDouble(pair.first[1]), VectorDouble(pair.first[2]), VectorDouble(pair.second[0]), VectorDouble(pair.second[1]), VectorDouble(pair.second[2]))
            || !GeometryAbsHoisted(VectorDouble(pair.first[0]), VectorDouble(pair.first[1]), VectorDouble(pair.first[2]), VectorDouble(pair.second[0]), VectorDouble(pair.second[1]), VectorDouble(pair.second[2]))
        ){
            valid = false;
            break;
        }
    }
    if(valid){
        TrianglePair signaling = fixture0;
        const u64 s_SignalingNaNBits = 0x7ff0000000000001u;
        for(mut f64x4 vertex : signaling.first)
            vertex = f64x4(VectorDoubleSetIntW(VectorDouble(vertex), s_SignalingNaNBits));
        for(mut f64x4 vertex : signaling.second)
            vertex = f64x4(VectorDoubleSetIntW(VectorDouble(vertex), s_SignalingNaNBits));
        const auto environment = HoldFloatingPointExceptions();
        if(!environment){
            valid = false;
        }
        else{
            const b8 baseline = GeometryBaseline(VectorDouble(signaling.first[0]), VectorDouble(signaling.first[1]), VectorDouble(signaling.first[2]), VectorDouble(signaling.second[0]), VectorDouble(signaling.second[1]), VectorDouble(signaling.second[2]));
            const i32 baselineExceptions = TestFloatingPointExceptions(FE_ALL_EXCEPT);
            if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT)){
                valid = false;
            }
            else{
                const b8 candidate = GeometryZeroAxis(VectorDouble(signaling.first[0]), VectorDouble(signaling.first[1]), VectorDouble(signaling.first[2]), VectorDouble(signaling.second[0]), VectorDouble(signaling.second[1]), VectorDouble(signaling.second[2]));
                const i32 candidateExceptions = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT)){
                    valid = false;
                }
                else{
                    const b8 production = GeometryProduction(VectorDouble(signaling.first[0]), VectorDouble(signaling.first[1]), VectorDouble(signaling.first[2]), VectorDouble(signaling.second[0]), VectorDouble(signaling.second[1]), VectorDouble(signaling.second[2]));
                    const i32 productionExceptions = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT)){
                        valid = false;
                    }
                    else{
                        const b8 hoisted = GeometryAbsHoisted(VectorDouble(signaling.first[0]), VectorDouble(signaling.first[1]), VectorDouble(signaling.first[2]), VectorDouble(signaling.second[0]), VectorDouble(signaling.second[1]), VectorDouble(signaling.second[2]));
                        const i32 hoistedExceptions = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                        if(!SetFloatingPointEnvironment(environment.value()))
                            valid = false;
                        if(!(baseline && candidate && production && hoisted && baselineExceptions == candidateExceptions && candidateExceptions == productionExceptions && productionExceptions == hoistedExceptions && (candidateExceptions & FE_INVALID) == 0))
                            valid = false;
                    }
                }
            }
        }
    }
    if(valid){
        const Array<u64, 3> activeBits(0x7ff0000000000000u, 0x7ff8000012345678u, 0x7ff0000000000001u);
        const Array<f64, 6> s_Scales(0.0, 0x1p-300, 0x1p-100, 0x1p+100, 0x1p+300, 0x1p+900);
        for(in f64 scale : s_Scales){
            TrianglePair scaled = fixture3;
            for(u32 vertex = 0u; vertex < 3u; ++vertex){
                scaled.first[vertex] = f64x4(VectorDoubleMultiply(VectorDouble(scaled.first[vertex]), VectorDoubleReplicate(scale)));
                scaled.second[vertex] = f64x4(VectorDoubleMultiply(VectorDouble(scaled.second[vertex]), VectorDoubleReplicate(scale)));
            }
            if(!CheckExceptionEquivalence(scaled))
                valid = false;
        }
        for(u32 index = 0u; index < activeBits.size(); ++index){
            TrianglePair active = fixture3;
            const u64 bits = ObserveValue<u64>(activeBits[index]);
            active.first[0] = f64x4(VectorDoubleSetIntX(VectorDouble(active.first[0]), bits));
            if(!CheckExceptionEquivalence(active))
                valid = false;
        }
        const f64 s_Maximum = f64.max;
        Array<TrianglePair, 2> extreme;
        extreme[0].first = Array<f64x4, 3>(f64x4(0.0, 1.0, 1.0, 0.0), f64x4(0.0, 1.0, 1.0, 0.0), f64x4(0.0, 1.0, 1.0, 0.0));
        extreme[0].second = Array<f64x4, 3>(f64x4(bit_cast<f64>(0x7ff0000000000000ull), 1.0, 2.0, 0.0), f64x4(-1.0, -1.0, -1.0, 0.0), f64x4(1.0, 3.0, 4.0, 0.0));
        extreme[1].first = Array<f64x4, 3>(f64x4(s_Maximum, 0.0, 0.0, 0.0), f64x4(s_Maximum, 0.0, 0.0, 0.0), f64x4(s_Maximum, 0.0, 0.0, 0.0));
        extreme[1].second = Array<f64x4, 3>(f64x4(-s_Maximum, -1.0, -1.0, 0.0), f64x4(0.0, 1.0, 1.0, 0.0), f64x4(s_Maximum, 0.0, 0.0, 0.0));
        for(in TrianglePair pair : extreme){
            if(!CheckExceptionEquivalence(pair) || !CheckTrapEquivalence(pair))
                valid = false;
        }
    }
    return valid;
}

const StringView s_ZeroAxisLabel = "zero_axis";
const StringView s_ValidateMode = "validate";
const StringView s_AbsoluteMode = "abs";
const StringView s_GuardMode = "guard";
const u32 s_GeometryFixtureCount = 64u;
const u32 s_GeometryRounds = 7u;
const u32 s_GeometryPasses = 512u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TrianglePair{
    public Array<f64x4, 3> first;
    public Array<f64x4, 3> second;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StringView GeometryWorkloadName(in u32 kind){
    switch(kind){
    case 0u: return "coplanar";
    case 1u: return "point_hull";
    case 2u: return "segment_hull";
    case 3u: return "noncoplanar";
    case 4u: return "noncoplanar_miss";
    case 5u: return "aabb_miss";
    default: return "point_point";
    }
}

void FillTrianglePairs(in u32 kind, mut Span<TrianglePair> pairs){
    for(usize index = 0u; index < pairs.size(); ++index){
        // Multiply by -0.25 to match the negated product bits.
        const f64 step = cast<f64>(index);
        const f64 tx = step * 0.25;
        const f64 ty = step * -0.25;
        const f64 tz = step * 0.25;
        Array<f64x4, 3> first;
        Array<f64x4, 3> second;
        if(kind == 0u){
            first[0] = f64x4(0.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[1] = f64x4(4.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[2] = f64x4(0.0 + tx, 4.0 + ty, 0.0 + tz, 0.0);
            second[0] = f64x4(1.0 + tx, 1.0 + ty, 0.0 + tz, 0.0);
            second[1] = f64x4(3.0 + tx, 1.0 + ty, 0.0 + tz, 0.0);
            second[2] = f64x4(1.0 + tx, 3.0 + ty, 0.0 + tz, 0.0);
        }
        else if(kind == 1u){
            first[0] = f64x4(0.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[1] = f64x4(4.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[2] = f64x4(0.0 + tx, 4.0 + ty, 0.0 + tz, 0.0);
            second[0] = f64x4(1.0 + tx, 1.0 + ty, 0.0 + tz, 0.0);
            second[1] = f64x4(1.0 + tx, 1.0 + ty, 0.0 + tz, 0.0);
            second[2] = f64x4(1.0 + tx, 1.0 + ty, 0.0 + tz, 0.0);
        }
        else if(kind == 2u){
            first[0] = f64x4(0.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[1] = f64x4(1.0 + tx, 1.0 + ty, 0.0 + tz, 0.0);
            first[2] = f64x4(2.0 + tx, 2.0 + ty, 0.0 + tz, 0.0);
            second[0] = f64x4(1.0 + tx, 1.0 + ty, 0.0 + tz, 0.0);
            second[1] = f64x4(2.0 + tx, 2.0 + ty, 0.0 + tz, 0.0);
            second[2] = f64x4(3.0 + tx, 3.0 + ty, 0.0 + tz, 0.0);
        }
        else if(kind == 3u){
            first[0] = f64x4(0.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[1] = f64x4(3.0 + tx, 1.0 + ty, 2.0 + tz, 0.0);
            first[2] = f64x4(1.0 + tx, 4.0 + ty, -1.0 + tz, 0.0);
            second[0] = f64x4(1.0 + tx, 1.25 + ty, 0.25 + tz, 0.0);
            second[1] = f64x4(1.5 + tx, 2.5 + ty, 1.0 + tz, 0.0);
            second[2] = f64x4(0.25 + tx, 1.75 + ty, 1.75 + tz, 0.0);
        }
        else if(kind == 4u){
            first[0] = f64x4(0.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[1] = f64x4(2.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[2] = f64x4(0.0 + tx, 2.0 + ty, 0.0 + tz, 0.0);
            second[0] = f64x4(1.5 + tx, 1.5 + ty, -1.0 + tz, 0.0);
            second[1] = f64x4(1.5 + tx, 2.0 + ty, 1.0 + tz, 0.0);
            second[2] = f64x4(2.0 + tx, 1.5 + ty, 1.0 + tz, 0.0);
        }
        else if(kind == 5u){
            first[0] = f64x4(0.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[1] = f64x4(2.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[2] = f64x4(0.0 + tx, 2.0 + ty, 0.0 + tz, 0.0);
            second[0] = f64x4(100.0 + tx, 100.0 + ty, 100.0 + tz, 0.0);
            second[1] = f64x4(102.0 + tx, 100.0 + ty, 100.0 + tz, 0.0);
            second[2] = f64x4(100.0 + tx, 102.0 + ty, 100.0 + tz, 0.0);
        }
        else{
            first[0] = f64x4(1.0 + tx, 1.0 + ty, 1.0 + tz, 0.0);
            first[1] = f64x4(1.0 + tx, 1.0 + ty, 1.0 + tz, 0.0);
            first[2] = f64x4(1.0 + tx, 1.0 + ty, 1.0 + tz, 0.0);
            second[0] = f64x4(1.0 + tx, 1.0 + ty, 1.0 + tz, 0.0);
            second[1] = f64x4(1.0 + tx, 1.0 + ty, 1.0 + tz, 0.0);
            second[2] = f64x4(1.0 + tx, 1.0 + ty, 1.0 + tz, 0.0);
        }
        pairs[index].first = first;
        pairs[index].second = second;
    }
}

b8 CheckTrianglePair(in TrianglePair pair, in b8 expected){
    return CheckTrianglePairPermutationsKernel(pair, expected);
}

b8 ValidateGeometryBenchmark(){
    Array<TrianglePair, s_GeometryFixtureCount> pairs;
    for(u32 kind = 0u; kind < 7u; ++kind){
        FillTrianglePairs(kind, pairs);
        if(!CheckTrianglePair(pairs[0], kind != 4u && kind != 5u))
            return false;
    }

    FillTrianglePairs(0u, pairs);
    const TrianglePair fixture0 = pairs[0];
    FillTrianglePairs(3u, pairs);
    const TrianglePair fixture3 = pairs[0];
    return ValidateGeometryContainmentAndTrapsKernel(fixture0, fixture3);
}

void SortGeometryRoundValues(mut Array<f64, s_GeometryRounds> sorted){
    for(usize index = 1u; index < s_GeometryRounds; ++index){
        const f64 value = sorted[index];
        usize destination = index;
        while(destination != 0u && sorted[destination - 1u] > value){
            sorted[destination] = sorted[destination - 1u];
            --destination;
        }
        sorted[destination] = value;
    }
}

void PrintGeometrySummary(in StringView prefix, in StringView workload, in Array<f64, s_GeometryRounds> values){
    Array<f64, s_GeometryRounds> sorted = values;
    SortGeometryRoundValues(sorted);
    const f64 medianValue = sorted[s_GeometryRounds / 2u];
    const f64 minValue = sorted[0];
    const f64 maxValue = sorted[s_GeometryRounds - 1u];
    WriteBenchmarkStdout(StringFormat("{}_summary,{},{},{},{}\n", prefix, workload, medianValue, minValue, maxValue));
}

u64 RunGeometryImplementation(in u32 implId, in Array<TrianglePair, s_GeometryFixtureCount> pairs, in u32 passes){
    return RunGeometryBatchKernel(implId, pairs, passes);
}

i32 RunGeometryBenchmark(in b8 validationOnly, in b8 measureAbs, in b8 guardOnly){
    if(!ValidateGeometryBenchmark()){
        WriteBenchmarkStderr("validation failed\n");
        return 1;
    }
    WriteBenchmarkStdout("validation,400000 exact containment probes, winding, finite/nonfinite FENV and trap-order equivalence,passed\n");
    if(validationOnly)
        return 0;

    u32 referenceId = 0u;
    u32 selectedId = 4u;
    StringView referenceName = "baseline";
    StringView selectedName = "production";
    StringView modeLabel = "production_vs_original_baseline";
    if(measureAbs){
        referenceId = 2u;
        selectedId = 3u;
        referenceName = s_ZeroAxisLabel;
        selectedName = "abs_hoisted";
        modeLabel = "abs_hoisted_vs_zero_axis";
    }
    else if(guardOnly){
        referenceId = 1u;
        selectedId = 2u;
        referenceName = "current_dot3_baseline";
        selectedName = s_ZeroAxisLabel;
        modeLabel = "zero_axis_vs_current_dot3";
    }

    WriteBenchmarkStdout(StringFormat("timer,TimerNow/DurationInNS\nmode,{}\n", modeLabel));

    Array<TrianglePair, s_GeometryFixtureCount> pairs;
    for(u32 kind = 0u; kind < 7u; ++kind){
        FillTrianglePairs(kind, pairs);
        const u64 expected = RunGeometryImplementation(referenceId, pairs, 1u) * cast<u64>(s_GeometryPasses);
        if(RunGeometryImplementation(selectedId, pairs, 1u) * cast<u64>(s_GeometryPasses) != expected)
            return 2;

        const StringView workloadName = GeometryWorkloadName(kind);
        Array<f64, s_GeometryRounds> baselineValues;
        Array<f64, s_GeometryRounds> candidateValues;
        Array<f64, s_GeometryRounds> ratios;
        for(u32 round = 0u; round < s_GeometryRounds; ++round){
            for(u32 step = 0u; step < 2u; ++step){
                const b8 candidate = ((round + step) & 1u) != 0u;
                u32 implId = referenceId;
                StringView implName = referenceName;
                if(candidate){
                    implId = selectedId;
                    implName = selectedName;
                }
                const Timer begin = TimerNow();
                const u64 checksum = RunGeometryImplementation(implId, pairs, s_GeometryPasses);
                const f64 elapsedNs = DurationInNS<f64>(TimerNow(), begin);
                if(checksum != expected)
                    return 3;
                const f64 nanoseconds = elapsedNs / cast<f64>(s_GeometryPasses * s_GeometryFixtureCount);
                if(candidate)
                    candidateValues[cast<usize>(round)] = nanoseconds;
                else
                    baselineValues[cast<usize>(round)] = nanoseconds;
                WriteBenchmarkStdout(StringFormat("sample,{},{},{},{},{}\n", workloadName, implName, round, nanoseconds, checksum));
            }
            ratios[cast<usize>(round)] = candidateValues[cast<usize>(round)] / baselineValues[cast<usize>(round)];
        }
        PrintGeometrySummary(referenceName, workloadName, baselineValues);
        PrintGeometrySummary(selectedName, workloadName, candidateValues);
        PrintGeometrySummary("ratio", workloadName, ratios);
    }
    return 0;
}

i32 RunGeometryBenchmarkCli(in Span<StringView> args){
    StringView mode = "";
    if(args.size() > 1u)
        mode = args[1];
    if(!mode.empty() && mode != s_ValidateMode && mode != s_AbsoluteMode && mode != s_GuardMode)
        return 2;
    return RunGeometryBenchmark(mode == s_ValidateMode, mode == s_AbsoluteMode, mode == s_GuardMode);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


i32 RunGeometryBenchmarkCliEntry(in ConsoleArguments arguments){
    if(arguments.count <= 0)
        return 2;
    Array<StringView, 4> args;
    const usize count = Min(cast<usize>(arguments.count), args.size());
    for(usize index = 0u; index < count; ++index)
        args[index] = arguments.text(cast<i32>(index));
    return RunGeometryBenchmarkCli(Span<StringView>(args).first(count));
}

