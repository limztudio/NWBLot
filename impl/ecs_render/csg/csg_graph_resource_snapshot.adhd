class CsgGraphResourceSnapshot{
    public BufferHandle receiverRanges;
    public BufferHandle cutters;
    public BufferHandle clipContextSlots;
    public BufferHandle intervalSampleState;
    public GraphicsPipelineHandle refractionCapFillPipeline;
    public usize receiverRangeCapacity = 0u;
    public usize cutterCapacity = 0u;
    public GpuDescriptorHandle receiverRangeHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle cutterHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle clipContextSlotsHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle intervalSampleStateHeapHandle = GpuDescriptorHandleInvalid();

    public b8 bindingValid()const;
    public b8 frameReady(in CsgFrameGpuDataView csgFrameData)const;
    public Expected<u32> findClipContextHeapSlot()const;
}


