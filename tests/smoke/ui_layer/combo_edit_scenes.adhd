const Name s_UiSmokeNameRadioMark = "radio.mark";
const StringView s_UiComboSmokeTag = "UiComboSmoke";
const StringView s_UiEditSmokeTag = "UiEditSmoke";
const StringView s_UiEditSmokePrimaryKey = "primary";
const StringView s_UiEditSmokeSecondaryKey = "secondary";
const StringView s_UiEditSmokePrimaryText = "Hello 한글";
const StringView s_UiEditSmokeSecondaryText = "Target";
const StringView s_UiImageSmokeTag = "UiImageSmoke";
const StringView s_UiImageSmokeTitleKey = "title";
const StringView s_UiInteractiveSmokeIncrease = "increase";
const StringView s_UiInteractiveSmokeEnabled = "enabled";
const StringView s_UiInteractiveSmokeReset = "reset";
const StringView s_UiListSmokeTag = "UiListSmoke";


