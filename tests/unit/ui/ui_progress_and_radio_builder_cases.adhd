const StringView s_ProgressTrackRegion = "progress.track";
const StringView s_ProgressFillRegion = "progress.fill";
const StringView s_ScrollbarTrackRegion = "scrollbar.track";
const StringView s_ScrollbarThumbRegion = "scrollbar.thumb.normal";
const StringView s_MissingTrackRegion = "missing.track";
const StringView s_MissingFillRegion = "missing.fill";
const StringView s_UiProgressCasePanelKey = "panel";
const StringView s_UiRadioCasePanelKey = "panel";
enum<u8> RadioCallbackPhase{ None, Generation, Revision, RowCount, Key, Lookup, Enabled }
enum<u8> RadioSourceMutation{ SelectIdentical, SelectAba, Reset, Reconcile, Apply, SourceRevision, SourceGeneration, SourceCount, GuardFailure }

class UiProgressBuilderTests : WidgetFixture{


    public void setup(){
        this.setUpWidgetBase();
        if(HasFatalTestFailure())
            return;
        this.configureProgress();
        this.m_builder.progressStyle().padding = Insets(4.0f, 4.0f, 4.0f, 4.0f);
    }
    public void configureProgress(){ this.configureProgress(true); }
    public void configureProgress(in b8 preferred){ this.configureProgress(preferred, true); }
    public void configureProgress(in b8 preferred, in b8 fallback){
        this.configureSkin();
        RegionVector regions;
        for(in UiSkinRegion region : this.m_skin.regions())
            regions.push_back(region);
        const Array<Name, 4u> names( Name(s_ProgressTrackRegion), Name(s_ProgressFillRegion), Name(s_ScrollbarTrackRegion), Name(s_ScrollbarThumbRegion));
        for(u32 index = 0u; index < 4u; ++index){
            if((index < 2u && !preferred) || (index >= 2u && !fallback))
                continue;
            UiSkinRegion region;
            region.name = names[index];
            region.rectangle = UiSkinRect(96u + index * 32u, 8u, 24u, 24u);
            region.sliceInsets = UiSkinSliceInsets(6u, 6u, 6u, 6u);
            region.minimumWidth = 12.0f;
            region.minimumHeight = 12.0f;
            region.drawMode = UiSkinDrawMode::NineSlice;
            regions.push_back(region);
        }
        this.m_skin.setAtlas(AssetRef<Texture>("tests/ui/texture"), 256u, 32u, 1.0f, regions);
        ASSERT_TRUE(this.m_skin.validatePayload());
        this.m_builder.setSkin(this.m_skin);
    }
    public Expected<UiFixtureSkinPaintSample> sampleTrackRegion(in DrawSnapshot snapshot)const{
        return this.sampleSkinPaint(snapshot, Name(s_ProgressTrackRegion));
    }
    public Expected<UiFixtureSkinPaintSample> sampleFillRegion(in DrawSnapshot snapshot)const{
        return this.sampleSkinPaint(snapshot, Name(s_ProgressFillRegion));
    }
    public Expected<UiFixtureSkinPaintSample> sampleScrollbarTrackRegion(in DrawSnapshot snapshot)const{
        return this.sampleSkinPaint(snapshot, Name(s_ScrollbarTrackRegion));
    }
    public Expected<UiFixtureSkinPaintSample> sampleScrollbarThumbRegion(in DrawSnapshot snapshot)const{
        return this.sampleSkinPaint(snapshot, Name(s_ScrollbarThumbRegion));
    }
    public void setMissingStyleRegions(){
        this.m_builder.progressStyle().track = Name(s_MissingTrackRegion);
        this.m_builder.progressStyle().fill = Name(s_MissingFillRegion);
    }
    public void setMissingFallbackRegions(){
        this.m_builder.progressStyle().trackFallback = Name(s_MissingTrackRegion);
        this.m_builder.progressStyle().fillFallback = Name(s_MissingFillRegion);
    }
}


class ReconcileGate : IRadioGroupReconcileGuard{
    public Optional<mut RadioGroupState> state;
    public b8 allowed = true;
    public TestObserved<b8> mutateState;

    public b8 current()const override{
        if(this.mutateState.value() && this.state.has_value()){
            this.mutateState.value() = false;
            this.state.value().select(this.state.value().selectedKey());
        }
        return this.allowed;
    }
    public void bindState(mut RadioGroupState targetState){
        this.state = Optional<mut RadioGroupState>(targetState);
    }
}


class ChoiceSource : IListDataSource{
    public Vector<RadioGroupChoice> rows;
    public TestObserved<u64> generation = TestObserved<u64>(41u);
    public TestObserved<u64> revisionValue = TestObserved<u64>(7u);
    public TestObserved<u64> count = TestObserved<u64>(4u);
    public Optional<mut RadioGroupState> state;
    public Optional<mut ReconcileGate> gate;
    public RadioGroupChoices borrowedChoices;
    public TestObserved<u32> keyCalls;
    public TestObserved<u32> findCalls;
    public TestObserved<u32> countCalls;
    public TestObserved<u32> callbackCalls;
    public TestObserved<u32> callbacksAtMutation;
    public u32 triggerCount = 0u;
    public RadioCallbackPhase phase = RadioCallbackPhase::None;
    public RadioSourceMutation mutation = RadioSourceMutation::SelectIdentical;
    public b8 badLookup = false;
    public b8 missingLookup = false;
    public TestObserved<b8> armed;
    public TestObserved<b8> nestedSucceeded = TestObserved<b8>(true);

    public ChoiceSource(){
        this.ensureCapacity(64u);
    }
    public void ensureCapacity(in u32 required){
        const u32 current = cast<u32>(this.rows.size());
        if(required <= current)
            return;
        this.rows.resize(cast<usize>(required));
        for(u32 index = current; index < required; ++index)
            this.rows[index] = RadioGroupChoice(index + 1u, true);
    }
    public void bindState(mut RadioGroupState targetState){
        this.state = Optional<mut RadioGroupState>(targetState);
    }
    public void bindGate(mut ReconcileGate targetGate){
        this.gate = Optional<mut ReconcileGate>(targetGate);
    }
    public u64 instanceGeneration()const override{
        this.callback(RadioCallbackPhase::Generation);
        return this.generation.value();
    }
    public u64 revision()const override{
        this.callback(RadioCallbackPhase::Revision);
        return this.revisionValue.value();
    }
    public u64 rowCount()const override{
        ++this.countCalls.value();
        this.callback(RadioCallbackPhase::RowCount);
        return this.count.value();
    }
    public u64 key(in u64 index)const override{
        this.callback(RadioCallbackPhase::Key);
        ++this.keyCalls.value();
        if(index < this.rows.size())
            return this.rows[cast<usize>(index)].key;
        return 0u;
    }
    public Expected<u64> indexOf(in u64 key)const override{
        u64 index = 0u;
        this.callback(RadioCallbackPhase::Lookup);
        const u64 limit = Min<u64>(this.count.value(), cast<u64>(this.rows.size()));
        for(u64 candidate = 0u; candidate < limit; ++candidate){
            if(this.rows[cast<usize>(candidate)].key == key){
                index = candidate;
                if(this.badLookup)
                    index = this.count.value();
                if(this.missingLookup)
                    return MakeUnexpected(Failure());
                return index;
            }
        }
        return MakeUnexpected(Failure());
    }
    public Expected<u64> findEnabled(in u64 start, in b8 reverse)const override{
        u64 index = 0u;
        ++this.findCalls.value();
        if(start >= this.count.value() || this.count.value() > cast<u64>(this.rows.size()))
            return MakeUnexpected(Failure());
        index = start;
        for(u64 visited = 0u; visited < this.count.value(); ++visited){
            if(this.rows[cast<usize>(index)].enabled)
                return index;
            if(reverse){
                if(index == 0u)
                    return MakeUnexpected(Failure());
                --index;
            }
            else{
                ++index;
                if(index == this.count.value())
                    return MakeUnexpected(Failure());
            }
        }
        return MakeUnexpected(Failure());
    }
    public StringView text(in u64 arg0)const override{ return "choice"; }
    public b8 enabled(in u64 index)const override{
        this.callback(RadioCallbackPhase::Enabled);
        return index < cast<u64>(this.rows.size()) && this.rows[cast<usize>(index)].enabled;
    }
    public void callback(in RadioCallbackPhase current)const{
        ++this.callbackCalls.value();
        if(!this.armed.value() || this.phase != current || (this.triggerCount != 0u && this.countCalls.value() != this.triggerCount))
            return;
        this.armed.value() = false;
        this.callbacksAtMutation.value() = this.callbackCalls.value();
        if(this.mutation == RadioSourceMutation::GuardFailure){
            if(this.gate.has_value())
                this.gate.value().allowed = false;
            return;
        }
        if(this.mutation == RadioSourceMutation::SourceRevision){
            ++this.revisionValue.value();
            return;
        }
        if(this.mutation == RadioSourceMutation::SourceGeneration){
            ++this.generation.value();
            return;
        }
        if(this.mutation == RadioSourceMutation::SourceCount){
            ++this.count.value();
            return;
        }
        if(!this.state.has_value())
            return;
        switch(this.mutation){
        case RadioSourceMutation::SelectIdentical:
            this.state.value().select(this.state.value().selectedKey());
            break;
        case RadioSourceMutation::SelectAba:{
            const u64 original = this.state.value().selectedKey();
            if(original == 1u)
                this.state.value().select(2u);
            else
                this.state.value().select(1u);
            this.state.value().select(original);
            break;
        }
        case RadioSourceMutation::Reset:
            this.state.value().reset();
            break;
        case RadioSourceMutation::Reconcile:{
            RadioGroupResult nestedResult;
            this.nestedSucceeded.value() = ReconcileRadioGroup(this, this.state.value(), nestedResult).has_value();
            break;
        }
        case RadioSourceMutation::Apply:{
            ControlAction action;
            const RadioGroupSnapshot snapshot = this.state.value().snapshot();
            action.control = ControlToken(snapshot.inputGeneration, snapshot.sourceGeneration, snapshot.sourceRevision);
            action.kind = ControlActionKind::Down;
            RadioGroupResult nestedResult;
            this.nestedSucceeded.value() = ApplyRadioGroupControlAction(this.borrowedChoices, RadioGroupOptions(), action, this.state.value(), nestedResult);
            break;
        }
        default:
            break;
        }
    }
}


class UiRadioGroupBuilderTests : RadioGroupFixture{


    public Expected<RadioGroupChoicePlacement> findChoice(in u64 keyValue)const{ return this.tryChoice(keyValue, this.m_state); }
    public void verifyTemporaryLabelsOwned(in DrawSnapshot actual){
        PaintBuilder reference;
        reference.begin(DisplayMetrics(800.0f, 600.0f, 1.0f, 1.0f), 2u, 1u, AssetRef<UiSkin>("tests/ui/skin"), this.m_skin);
        for(u32 index = 0u; index < 5u; ++index){
            String bytes = String("Abcd");
            const StringView letters = "ABCDE";
            bytes[0u] = letters[index];
            ShapeRequest request;
            request.text = StringView(bytes);
            request.fontSize = 14.0f;
            auto layout = this.m_text.layout(request);
            ASSERT_TRUE(layout.has_value());
            in RadioGroupChoicePlacement row = this.m_state.placement().rows[index];
            const auto measured = this.m_text.measure(layout.value(), reference.displayMetrics());
            ASSERT_TRUE(measured.has_value());
            const VectorSingle rawCentering((row.rectangle.height - measured.value().height) * 0.5f);
            const VectorSingle zero(0.0f);
            const f32 centering = VectorSelect(rawCentering, zero, VectorGreater(zero, rawCentering)).x;
            const VectorSingle rawOrigin = VectorSingle(row.indicator.x + row.indicator.width + this.m_builder.radioGroupStyle().gap, row.rectangle.y + centering, 0.0f, 0.0f) - VectorSingle(measured.value().x, measured.value().y, 0.0f, 0.0f);
            const Point origin = Point(rawOrigin.x, rawOrigin.y);
            reference.pushClip(row.clip);
            reference.pushClip(row.textClip);
            Color color = this.m_builder.style().disabledText;
            if(row.enabled)
                color = this.m_builder.style().text;
            ASSERT_TRUE(this.m_text.paint(reference, layout.value(), origin, color));
            ASSERT_TRUE(reference.popClip());
            ASSERT_TRUE(reference.popClip());
        }
        const DrawSnapshot expected = reference.freeze();
        Vector<Vertex> actualGlyphs;
        Vector<Vertex> expectedGlyphs;
        CopyGlyphVertices(actual, actualGlyphs);
        CopyGlyphVertices(expected, expectedGlyphs);
        ASSERT_EQ(actualGlyphs.size(), expectedGlyphs.size());
        ASSERT_GT(actualGlyphs.size(), 0u);
        for(usize index = 0u; index < actualGlyphs.size(); ++index){
            EXPECT_FLOAT_EQ(actualGlyphs[index].position.x, expectedGlyphs[index].position.x);
            EXPECT_FLOAT_EQ(actualGlyphs[index].position.y, expectedGlyphs[index].position.y);
            EXPECT_FLOAT_EQ(actualGlyphs[index].texCoord.x, expectedGlyphs[index].texCoord.x);
            EXPECT_FLOAT_EQ(actualGlyphs[index].texCoord.y, expectedGlyphs[index].texCoord.y);
        }
    }
}


