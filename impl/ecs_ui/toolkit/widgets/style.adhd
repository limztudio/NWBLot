#include <impl/ecs_ui/toolkit/input/input.adhd>
#include <impl/ecs_ui/toolkit/input/popup.adhd>
#include <impl/ecs_ui/toolkit/layout/validation.adhd>
#include <impl/ecs_ui/toolkit/text/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_StyleSpacingSmall = 4.0f;
const f32 s_StyleSpacingMedium = 8.0f;
const f32 s_StyleFieldPaddingY = 6.0f;
const f32 s_StyleControlExtent = 24.0f;
const f32 s_StyleControlHeight = 32.0f;
const f32 s_StyleMinimumFieldWidth = 120.0f;
const f32 s_StyleSliderTrackHeight = 12.0f;
const f32 s_StyleScrollbarThickness = 14.0f;
const f32 s_StyleScrollbarMinimumThumb = 20.0f;
const f32 s_StyleScrollWheelStep = 3.0f;
const f32 s_StyleMarkInset = 0.3f;
const f32 s_StyleDisabledIconAlpha = 0.5f;
const f32 s_CheckmarkInsetFraction = 0.2f;
const f32 s_CheckmarkInsetSides = 2.0f;
const f32 s_StyleWindowCollapseExtent = 20.0f;
const f32 s_StyleWindowResizeExtent = 16.0f;
const Color s_StyleTextColor = Color(0.92f, 0.94f, 0.98f, 1.0f);
const Color s_StyleDisabledTextColor = Color(0.48f, 0.50f, 0.55f, 1.0f);
const Color s_StyleInsetColor = Color(0.08f, 0.10f, 0.14f, 1.0f);
const Color s_StyleHoverTint = Color(1.08f, 1.08f, 1.08f, 1.0f);
const Color s_StylePressedTint = Color(0.85f, 0.85f, 0.85f, 1.0f);
const Color s_StyleDisabledTint = Color(0.55f, 0.55f, 0.55f, 0.6f);
const Name s_StylePanelNormalRegionName = "panel.normal";
const Name s_StyleWindowNormalRegionName = "window.normal";
const Name s_StyleWindowTitleRegionName = "window.title";
const Name s_StyleWindowCollapseRegionName = "window.collapse";
const Name s_StyleWindowResizeRegionName = "window.resize";
const Name s_StyleSeparatorRegionName = "separator";
const Name s_StyleWhiteRegionName = "white";
const Name s_StyleButtonNormalRegionName = "button.normal";
const Name s_StyleButtonHoverRegionName = "button.hover";
const Name s_StyleButtonPressedRegionName = "button.pressed";
const Name s_StyleButtonDisabledRegionName = "button.disabled";
const Name s_StyleCheckboxNormalRegionName = "checkbox.normal";
const Name s_StyleCheckboxHoverRegionName = "checkbox.hover";
const Name s_StyleCheckboxCheckedRegionName = "checkbox.checked";
const Name s_StyleCheckboxDisabledRegionName = "checkbox.disabled";
const Name s_StyleCheckboxMarkRegionName = "checkbox.mark";
const Name s_StyleFocusOverlayRegionName = "focus.overlay";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> SeparatorDirection{
    Horizontal,
    Vertical,
}

class WidgetStyle{
    public Name panel = s_StylePanelNormalRegionName;
    public Name window = s_StyleWindowNormalRegionName;
    public Name windowTitle = s_StyleWindowTitleRegionName;
    public Name windowCollapse = s_StyleWindowCollapseRegionName;
    public Name windowResize = s_StyleWindowResizeRegionName;
    public Name separator = s_StyleSeparatorRegionName;
    public Name white = s_StyleWhiteRegionName;
    public Name button = s_StyleButtonNormalRegionName;
    public Name buttonHover = s_StyleButtonHoverRegionName;
    public Name buttonPressed = s_StyleButtonPressedRegionName;
    public Name buttonDisabled = s_StyleButtonDisabledRegionName;
    public Name checkbox = s_StyleCheckboxNormalRegionName;
    public Name checkboxHover = s_StyleCheckboxHoverRegionName;
    public Name checkboxChecked = s_StyleCheckboxCheckedRegionName;
    public Name checkboxDisabled = s_StyleCheckboxDisabledRegionName;
    public Name checkboxMark = s_StyleCheckboxMarkRegionName;
    public Name focus = s_StyleFocusOverlayRegionName;
    public Color text = s_StyleTextColor;
    public Color disabledText = s_StyleDisabledTextColor;
    public f32 fontSize = s_TextDefaultFontSize;
    public f32 gap = s_StyleSpacingMedium;
    public f32 checkboxExtent = s_StyleControlExtent;
    public f32 windowCollapseExtent = s_StyleWindowCollapseExtent;
    public f32 windowResizeExtent = s_StyleWindowResizeExtent;
}

class WidgetOptions{
    public LayoutSize width;
    public LayoutSize height;
    public b8 enabled = true;
}

class ContainerOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public LayoutSize height;
    public Insets padding;
    public f32 gap = s_StyleSpacingMedium;
}

class SeparatorOptions{
    public LayoutSize length = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public f32 thickness = 0.0f;
    public SeparatorDirection direction = SeparatorDirection::Horizontal;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ApplySkinPaletteToWidgetStyle(in UiSkinPalette palette, mut WidgetStyle style){
    style.text = ResolveUiSkinColor(palette, UiSkinColorRole::TextNormal);
    style.disabledText = ResolveUiSkinColor(palette, UiSkinColorRole::TextDisabled);
}

Expected<Point> TryResolveSkinRegionMinimumSize(in UiSkinRegion region, in f32 density){
    VectorSingle minimum(0.0f);
    if(!TryLoadUiSkinMinimumSize(region, cast<f64>(density), minimum))
        return MakeUnexpected(Failure());
    return Point(minimum.x, minimum.y);
}

Point ResolveCenteredTextOrigin(in Rect bounds, in f32 xInset, in f32 lineHeight){
    const f32 verticalOffset = UiSimdMax(bounds.height - lineHeight, 0.0f) * s_RectCenterFraction;
    const VectorSingle origin = VectorSingle(bounds.x, bounds.y, bounds.x, bounds.y) + VectorSingle(xInset, verticalOffset, xInset, verticalOffset);
    return Point(origin.x, origin.y);
}

Point ResolveCenteredTextOrigin(in Rect bounds, in f32 xInset, in Rect textBounds){
    const Point origin = ResolveCenteredTextOrigin(bounds, xInset, textBounds.height);
    const VectorSingle position = VectorSingle(origin.x, origin.y, origin.x, origin.y) - VectorSingle(textBounds.x, textBounds.y, textBounds.x, textBounds.y);
    return Point(position.x, position.y);
}

Name ResolveButtonPreferredName(in WidgetStyle style, in b8 enabled, in b8 pressed, in b8 hover){
    if(!enabled)
        return style.buttonDisabled;
    if(pressed)
        return style.buttonPressed;
    if(hover)
        return style.buttonHover;
    return style.button;
}

void ResolveButtonTextPlacement(in Rect bounds, in Insets padding, in Point measured, mut Rect outTextClip, mut Point outOrigin){
    outTextClip = InsetUiRectBounds(bounds, padding);
    outOrigin = ResolveCenteredTextOrigin(outTextClip, UiSimdMax(0.0f, (outTextClip.width - measured.x) * s_RectCenterFraction), measured.y);
}

Name ResolveCheckboxPreferredName(in WidgetStyle style, in b8 enabled, in b8 checked, in b8 hover){
    if(!enabled)
        return style.checkboxDisabled;
    if(checked)
        return style.checkboxChecked;
    if(hover)
        return style.checkboxHover;
    return style.checkbox;
}

void ResolveCheckboxPlacement(
    in Rect bounds,
    in f32 checkboxExtent,
    in f32 gap,
    in Point measured,
    mut Rect outSquare,
    mut Rect outMark,
    mut Rect outTextClip,
    mut Point outOrigin
){
    const f32 squareOffsetY = UiSimdMax(0.0f, (bounds.height - checkboxExtent) * s_RectCenterFraction);
    outSquare = Rect(bounds.x, bounds.y + squareOffsetY, checkboxExtent, checkboxExtent);
    const f32 inset = checkboxExtent * s_CheckmarkInsetFraction;
    const f32 markExtent = checkboxExtent - (s_CheckmarkInsetSides * inset);
    const VectorSingle markOrigin = VectorSingle(outSquare.x, outSquare.y, outSquare.x, outSquare.y) + VectorSingle(inset);
    outMark = Rect(markOrigin.x, markOrigin.y, markExtent, markExtent);
    const f32 textOffsetX = checkboxExtent + gap;
    outOrigin = ResolveCenteredTextOrigin(bounds, textOffsetX, measured.y);
    const f32 clipWidth = UiSimdMax(0.0f, bounds.width - textOffsetX);
    outTextClip = Rect(outOrigin.x, bounds.y, clipWidth, bounds.height);
}

void AccumulateButtonRegionMetrics(in UiSkinRegion skinRegion, mut Point inOutMinimum, mut Insets inOutPadding){
    const VectorSingle minimum = Max(VectorSingle(inOutMinimum.x, inOutMinimum.y, inOutMinimum.x, inOutMinimum.y), VectorSingle(skinRegion.minimumWidth, skinRegion.minimumHeight, skinRegion.minimumWidth, skinRegion.minimumHeight));
    inOutMinimum.x = minimum.x;
    inOutMinimum.y = minimum.y;
    inOutPadding = MaxUiPadding(inOutPadding, skinRegion.padding);
}

void AccumulateEditRegionMinimumSize(in UiSkinRegion skinRegion, mut Point inOutMinimum){
    const VectorSingle minimum = Max(VectorSingle(inOutMinimum.x, inOutMinimum.y, inOutMinimum.x, inOutMinimum.y), VectorSingle(skinRegion.minimumWidth, skinRegion.minimumHeight, skinRegion.minimumWidth, skinRegion.minimumHeight));
    inOutMinimum.x = minimum.x;
    inOutMinimum.y = minimum.y;
}

Point ResolveEditIntrinsicSize(in Point minimum, in f32 visualHeight, in Insets padding){
    const f32 paddedHeight = (visualHeight + padding.top) + padding.bottom;
    return Point(minimum.x, UiSimdMax(minimum.y, paddedHeight));
}

Point ResolvePaddedIntrinsicSize(in Point textBounds, in Insets padding, in Point minimum){
    const VectorSingle textSize(textBounds.x, textBounds.y, textBounds.x, textBounds.y);
    const VectorSingle leadingPadding(padding.left, padding.top, padding.left, padding.top);
    const VectorSingle trailingPadding(padding.right, padding.bottom, padding.right, padding.bottom);
    const VectorSingle measured = (textSize + leadingPadding) + trailingPadding;
    const VectorSingle extent = Max(VectorSingle(minimum.x, minimum.y, minimum.x, minimum.y), VectorSingle(measured.x, measured.y, measured.x, measured.y));
    return Point(extent.x, extent.y);
}

Point ResolveCheckboxIntrinsicSize(in Point textBounds, in f32 checkboxExtent, in f32 gap){
    return Point(textBounds.x + checkboxExtent + gap, UiSimdMax(textBounds.y, checkboxExtent));
}

LayoutNodeDesc ResolveSeparatorNodeDesc(in UiSkinRegion skinRegion, in SeparatorOptions options){
    const b8 horizontal = options.direction == SeparatorDirection::Horizontal;
    f32 minimum = skinRegion.minimumWidth;
    if(horizontal)
        minimum = skinRegion.minimumHeight;
    f32 thickness = UiSimdMax(1.0f, minimum);
    if(options.thickness > 0.0f)
        thickness = options.thickness;
    LayoutNodeDesc description;
    if(horizontal){
        description.width = options.length;
        description.height = LayoutSize(LayoutSizePolicy::Fixed, thickness);
    }
    else{
        description.width = LayoutSize(LayoutSizePolicy::Fixed, thickness);
        description.height = options.length;
    }
    description.intrinsicSize = Point(skinRegion.minimumWidth, skinRegion.minimumHeight);
    return description;
}

LayoutNodeDesc BuildWidthLeafNodeDesc(in LayoutSize width, in Point intrinsicSize){
    LayoutNodeDesc description;
    description.width = width;
    description.intrinsicSize = intrinsicSize;
    return description;
}


