void VerifyUiRadioGroupPopupTests_AncestorClosureSuppressesMetadataAndRetiresCaptureBeforeFreshChildReuse(mut UiRadioGroupPopupTests self){
    ASSERT_TRUE(self.acceptFamily(1u));
    ASSERT_TRUE(self.declareFamily(2u));
    Rect rowRect = Rect();
    native(in self, mut rowRect){
        const auto* row = self.choice(20u, self.m_childState);
        ASSERT_NE(row, nullptr);
        rowRect = row->rectangle;
    }
    const Point point = CenterUiRect(rowRect);
    InputEvent down = InputEvent();
    down.position = point;
    down.type = InputEventType::PrimaryDown;
    EXPECT_TRUE(self.send(down).pointerConsumed);
    EXPECT_TRUE(self.m_context.input().capture().valid());
    self.m_source.resetCounters();
    self.m_childSource.resetCounters();
    self.m_parent.close();
    ASSERT_TRUE(self.finishParent());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_source.m_calls, 0u);
    EXPECT_EQ(self.m_childSource.m_calls, 0u);
    EXPECT_EQ(self.m_context.input().popupCount(), 0u);
    EXPECT_FALSE(self.m_context.input().capture().valid());
    EXPECT_EQ(self.m_childState.selectedKey(), 20u);
    self.m_parent.open();
    ASSERT_TRUE(self.beginParent(3u));
    EXPECT_FALSE(self.m_builder.beginPopup("child", self.m_child, MakeNestedChildPopupOptions()));
    EXPECT_FALSE(self.m_child.isOpen());
    ASSERT_TRUE(self.finishParent());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    self.m_child.open();
    ASSERT_TRUE(self.acceptFamily(4u));
    InputEvent up = InputEvent();
    up.position = point;
    up.type = InputEventType::PrimaryUp;
    EXPECT_TRUE(self.send(up).pointerConsumed);
    ASSERT_TRUE(self.acceptFamily(5u));
    EXPECT_EQ(self.m_childState.selectedKey(), 20u);
    EXPECT_FALSE(self.m_childResult.activated);
}

void VerifyUiRadioGroupPopupTests_InstanceCallbackClosingThePopupRetiresQueuedRightBeforeReconcile(mut UiRadioGroupPopupTests self){
    ExpectUiRadioGroupPopupSourceClosure(self, UiRadioCallbackSite::Instance);
}


