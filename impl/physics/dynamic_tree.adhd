////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/physics/math.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TreeNode{
    public Aabb3D aabb;
    public u32 userData = s_NullIndex;
    public u32 categoryBits = 0u;
    public u32 parentOrNext = s_NullIndex;
    public u32 child1 = s_NullIndex;
    public u32 child2 = s_NullIndex;
    public i32 height = -1;
    public b8 moved = false;

    public b8 isLeaf()const{
        return this.child1 == s_NullIndex;
    }
}

class DynamicTree{
    private Vector<TreeNode> m_nodes;
    private u32 m_root = s_NullIndex;
    private u32 m_freeList = s_NullIndex;
    private u32 m_nodeCount = 0u;

    public void clear(){
        this.m_nodes.clear();
        this.m_root = s_NullIndex;
        this.m_freeList = s_NullIndex;
        this.m_nodeCount = 0u;
    }

    public u32 createProxy(in Aabb3D aabb, in u32 categoryBits, in u32 userData){
        const u32 proxyId = this.allocateNode();
        const f32 margin = ComputeAabbMargin(aabb);
        this.m_nodes[proxyId].aabb = FattenAabb(aabb, margin);
        this.m_nodes[proxyId].userData = userData;
        this.m_nodes[proxyId].categoryBits = categoryBits;
        this.m_nodes[proxyId].height = 0;
        this.m_nodes[proxyId].moved = true;
        this.insertLeaf(proxyId);
        return proxyId;
    }

    public void destroyProxy(in u32 proxyId){
        if(proxyId >= this.m_nodes.size() || !this.m_nodes[proxyId].isLeaf())
            return;
        this.removeLeaf(proxyId);
        this.freeNode(proxyId);
    }

    public b8 moveProxy(in u32 proxyId, in Aabb3D aabb, in VectorSingle displacement){
        if(proxyId >= this.m_nodes.size() || !this.m_nodes[proxyId].isLeaf())
            return false;

        const f32 margin = ComputeAabbMargin(aabb);
        const Aabb3D fattened = FattenAabb(aabb, margin);
        const Aabb3D hugeAabb = FattenAabb(fattened, 4.0f * margin);
        if(AabbContains(this.m_nodes[proxyId].aabb, aabb) && AabbContains(hugeAabb, this.m_nodes[proxyId].aabb))
            return false;

        VectorSingle d = VectorSingle(displacement, 0.0f) * 2.0f;
        VectorSingle lower = VectorSingle(fattened.lowerBound);
        VectorSingle upper = VectorSingle(fattened.upperBound);
        if(d.x < 0.0f)
            lower = VectorSetX(lower, lower.x + d.x);
        else
            upper = VectorSetX(upper, upper.x + d.x);
        if(d.y < 0.0f)
            lower = VectorSetY(lower, lower.y + d.y);
        else
            upper = VectorSetY(upper, upper.y + d.y);
        if(d.z < 0.0f)
            lower = VectorSetZ(lower, lower.z + d.z);
        else
            upper = VectorSetZ(upper, upper.z + d.z);

        this.removeLeaf(proxyId);
        this.m_nodes[proxyId].aabb = Aabb3D(lower, upper);
        this.insertLeaf(proxyId);
        this.m_nodes[proxyId].moved = true;
        return true;
    }

    public in Aabb3D fatAabb(in u32 proxyId)const{
        return this.m_nodes[proxyId].aabb;
    }

    public u32 userData(in u32 proxyId)const{
        return this.m_nodes[proxyId].userData;
    }

    public b8 isValidLeaf(in u32 proxyId)const{
        if(proxyId >= this.m_nodes.size())
            return false;
        in TreeNode n = this.m_nodes[proxyId];
        return n.height == 0 && n.isLeaf() && n.userData != s_NullIndex;
    }

    public void queryAabb<Callback>(in Aabb3D queryBox, in u32 maskBits, in Callback callback)const{
        if(this.m_root == s_NullIndex)
            return;

        Vector<u32> stack;
        stack.reserve(64u);
        stack.push_back(this.m_root);
        while(!stack.empty()){
            const u32 nodeId = stack[stack.size() - 1u];
            stack.pop_back();
            if(nodeId == s_NullIndex)
                continue;

            in TreeNode node = this.m_nodes[nodeId];
            if(!AabbOverlaps(node.aabb, queryBox))
                continue;

            if(node.isLeaf()){
                if((node.categoryBits & maskBits) != 0u){
                    if(!callback(nodeId, node.userData))
                        return;
                }
            }
            else{
                stack.push_back(node.child1);
                stack.push_back(node.child2);
            }
        }
    }

    public void rayCast<Callback>(
        in VectorSingle origin,
        in VectorSingle translation,
        in u32 maskBits,
        in Callback callback
    )const{
        if(this.m_root == s_NullIndex)
            return;

        f32 maxFraction = 1.0f;
        Vector<u32> stack;
        stack.reserve(64u);
        stack.push_back(this.m_root);
        while(!stack.empty()){
            const u32 nodeId = stack[stack.size() - 1u];
            stack.pop_back();
            if(nodeId == s_NullIndex)
                continue;

            in TreeNode node = this.m_nodes[nodeId];
            f32 tMin = 0.0f;
            if(!AabbRayCast(node.aabb, origin, translation, maxFraction, tMin))
                continue;

            if(node.isLeaf()){
                if((node.categoryBits & maskBits) != 0u){
                    maxFraction = callback(nodeId, node.userData, maxFraction);
                    if(maxFraction <= 0.0f)
                        return;
                }
            }
            else{
                stack.push_back(node.child1);
                stack.push_back(node.child2);
            }
        }
    }

    private u32 allocateNode(){
        if(this.m_freeList == s_NullIndex){
            const usize prevCap = this.m_nodes.size();
            usize newCap = 64u;
            if(prevCap != 0u)
                newCap = prevCap * 2u;
            this.m_nodes.resize(newCap);
            for(usize i = prevCap; i < newCap - 1u; ++i){
                this.m_nodes[i].parentOrNext = cast<u32>(i + 1u);
                this.m_nodes[i].height = -1;
            }
            this.m_nodes[newCap - 1u].parentOrNext = s_NullIndex;
            this.m_nodes[newCap - 1u].height = -1;
            this.m_freeList = cast<u32>(prevCap);
        }

        const u32 nodeId = this.m_freeList;
        this.m_freeList = this.m_nodes[nodeId].parentOrNext;
        this.m_nodes[nodeId].parentOrNext = s_NullIndex;
        this.m_nodes[nodeId].child1 = s_NullIndex;
        this.m_nodes[nodeId].child2 = s_NullIndex;
        this.m_nodes[nodeId].height = 0;
        this.m_nodes[nodeId].userData = s_NullIndex;
        this.m_nodes[nodeId].moved = false;
        ++this.m_nodeCount;
        return nodeId;
    }

    private void freeNode(in u32 nodeId){
        this.m_nodes[nodeId].parentOrNext = this.m_freeList;
        this.m_nodes[nodeId].height = -1;
        this.m_nodes[nodeId].child1 = s_NullIndex;
        this.m_nodes[nodeId].child2 = s_NullIndex;
        this.m_nodes[nodeId].userData = s_NullIndex;
        this.m_nodes[nodeId].categoryBits = 0u;
        this.m_freeList = nodeId;
        if(this.m_nodeCount > 0u)
            --this.m_nodeCount;
    }

    private void insertLeaf(in u32 leaf){
        if(this.m_root == s_NullIndex){
            this.m_root = leaf;
            this.m_nodes[leaf].parentOrNext = s_NullIndex;
            return;
        }

        const Aabb3D leafAabb = this.m_nodes[leaf].aabb;
        u32 index = this.m_root;
        while(!this.m_nodes[index].isLeaf()){
            const u32 c1 = this.m_nodes[index].child1;
            const u32 c2 = this.m_nodes[index].child2;
            const f32 area = AabbPerimeter(this.m_nodes[index].aabb);

            const Aabb3D combined = AabbUnion(this.m_nodes[index].aabb, leafAabb);
            const f32 combinedArea = AabbPerimeter(combined);
            const f32 cost = 2.0f * combinedArea;
            const f32 inheritanceCost = 2.0f * (combinedArea - area);

            f32 cost1 = 0.0f;
            if(this.m_nodes[c1].isLeaf())
                cost1 = AabbPerimeter(AabbUnion(leafAabb, this.m_nodes[c1].aabb)) + inheritanceCost;
            else
                cost1 = (AabbPerimeter(AabbUnion(leafAabb, this.m_nodes[c1].aabb)) - AabbPerimeter(this.m_nodes[c1].aabb)) + inheritanceCost;

            f32 cost2 = 0.0f;
            if(this.m_nodes[c2].isLeaf())
                cost2 = AabbPerimeter(AabbUnion(leafAabb, this.m_nodes[c2].aabb)) + inheritanceCost;
            else
                cost2 = (AabbPerimeter(AabbUnion(leafAabb, this.m_nodes[c2].aabb)) - AabbPerimeter(this.m_nodes[c2].aabb)) + inheritanceCost;

            if(cost < cost1 && cost < cost2)
                break;

            if(cost1 < cost2)
                index = c1;
            else
                index = c2;
        }

        const u32 sibling = index;
        const u32 oldParent = this.m_nodes[sibling].parentOrNext;
        const u32 newParent = this.allocateNode();
        this.m_nodes[newParent].parentOrNext = oldParent;
        this.m_nodes[newParent].aabb = AabbUnion(leafAabb, this.m_nodes[sibling].aabb);
        this.m_nodes[newParent].height = this.m_nodes[sibling].height + 1;

        if(oldParent != s_NullIndex){
            if(this.m_nodes[oldParent].child1 == sibling)
                this.m_nodes[oldParent].child1 = newParent;
            else
                this.m_nodes[oldParent].child2 = newParent;
        }
        else{
            this.m_root = newParent;
        }

        this.m_nodes[newParent].child1 = sibling;
        this.m_nodes[newParent].child2 = leaf;
        this.m_nodes[sibling].parentOrNext = newParent;
        this.m_nodes[leaf].parentOrNext = newParent;

        this.syncHierarchy(newParent);
    }

    private void removeLeaf(in u32 leaf){
        if(leaf == this.m_root){
            this.m_root = s_NullIndex;
            return;
        }

        const u32 parent = this.m_nodes[leaf].parentOrNext;
        const u32 grandParent = this.m_nodes[parent].parentOrNext;
        u32 sibling = this.m_nodes[parent].child1;
        if(sibling == leaf)
            sibling = this.m_nodes[parent].child2;

        if(grandParent != s_NullIndex){
            if(this.m_nodes[grandParent].child1 == parent)
                this.m_nodes[grandParent].child1 = sibling;
            else
                this.m_nodes[grandParent].child2 = sibling;
            this.m_nodes[sibling].parentOrNext = grandParent;
            this.freeNode(parent);
            this.syncHierarchy(grandParent);
        }
        else{
            this.m_root = sibling;
            this.m_nodes[sibling].parentOrNext = s_NullIndex;
            this.freeNode(parent);
        }
    }

    private void syncHierarchy(in u32 startNode){
        u32 index = startNode;
        while(index != s_NullIndex){
            index = this.balance(index);
            const u32 c1 = this.m_nodes[index].child1;
            const u32 c2 = this.m_nodes[index].child2;
            this.m_nodes[index].height = 1 + Max(this.m_nodes[c1].height, this.m_nodes[c2].height);
            this.m_nodes[index].aabb = AabbUnion(this.m_nodes[c1].aabb, this.m_nodes[c2].aabb);
            index = this.m_nodes[index].parentOrNext;
        }
    }

    private u32 balance(in u32 iA){
        if(this.m_nodes[iA].isLeaf() || this.m_nodes[iA].height < 2)
            return iA;

        const u32 iB = this.m_nodes[iA].child1;
        const u32 iC = this.m_nodes[iA].child2;
        const i32 heightDiff = this.m_nodes[iC].height - this.m_nodes[iB].height;

        if(heightDiff > 1){
            const u32 iF = this.m_nodes[iC].child1;
            const u32 iG = this.m_nodes[iC].child2;
            this.m_nodes[iC].child1 = iA;
            this.m_nodes[iC].parentOrNext = this.m_nodes[iA].parentOrNext;
            this.m_nodes[iA].parentOrNext = iC;
            if(this.m_nodes[iC].parentOrNext != s_NullIndex){
                if(this.m_nodes[this.m_nodes[iC].parentOrNext].child1 == iA)
                    this.m_nodes[this.m_nodes[iC].parentOrNext].child1 = iC;
                else
                    this.m_nodes[this.m_nodes[iC].parentOrNext].child2 = iC;
            }
            else{
                this.m_root = iC;
            }
            if(this.m_nodes[iF].height > this.m_nodes[iG].height){
                this.m_nodes[iC].child2 = iF;
                this.m_nodes[iA].child2 = iG;
                this.m_nodes[iG].parentOrNext = iA;
                this.m_nodes[iA].aabb = AabbUnion(this.m_nodes[iB].aabb, this.m_nodes[iG].aabb);
                this.m_nodes[iC].aabb = AabbUnion(this.m_nodes[iA].aabb, this.m_nodes[iF].aabb);
                this.m_nodes[iA].height = 1 + Max(this.m_nodes[iB].height, this.m_nodes[iG].height);
                this.m_nodes[iC].height = 1 + Max(this.m_nodes[iA].height, this.m_nodes[iF].height);
            }
            else{
                this.m_nodes[iC].child2 = iG;
                this.m_nodes[iA].child2 = iF;
                this.m_nodes[iF].parentOrNext = iA;
                this.m_nodes[iA].aabb = AabbUnion(this.m_nodes[iB].aabb, this.m_nodes[iF].aabb);
                this.m_nodes[iC].aabb = AabbUnion(this.m_nodes[iA].aabb, this.m_nodes[iG].aabb);
                this.m_nodes[iA].height = 1 + Max(this.m_nodes[iB].height, this.m_nodes[iF].height);
                this.m_nodes[iC].height = 1 + Max(this.m_nodes[iA].height, this.m_nodes[iG].height);
            }
            return iC;
        }

        if(heightDiff < -1){
            const u32 iD = this.m_nodes[iB].child1;
            const u32 iE = this.m_nodes[iB].child2;
            this.m_nodes[iB].child1 = iA;
            this.m_nodes[iB].parentOrNext = this.m_nodes[iA].parentOrNext;
            this.m_nodes[iA].parentOrNext = iB;
            if(this.m_nodes[iB].parentOrNext != s_NullIndex){
                if(this.m_nodes[this.m_nodes[iB].parentOrNext].child1 == iA)
                    this.m_nodes[this.m_nodes[iB].parentOrNext].child1 = iB;
                else
                    this.m_nodes[this.m_nodes[iB].parentOrNext].child2 = iB;
            }
            else{
                this.m_root = iB;
            }
            if(this.m_nodes[iD].height > this.m_nodes[iE].height){
                this.m_nodes[iB].child2 = iD;
                this.m_nodes[iA].child1 = iE;
                this.m_nodes[iE].parentOrNext = iA;
                this.m_nodes[iA].aabb = AabbUnion(this.m_nodes[iC].aabb, this.m_nodes[iE].aabb);
                this.m_nodes[iB].aabb = AabbUnion(this.m_nodes[iA].aabb, this.m_nodes[iD].aabb);
                this.m_nodes[iA].height = 1 + Max(this.m_nodes[iC].height, this.m_nodes[iE].height);
                this.m_nodes[iB].height = 1 + Max(this.m_nodes[iA].height, this.m_nodes[iD].height);
            }
            else{
                this.m_nodes[iB].child2 = iE;
                this.m_nodes[iA].child1 = iD;
                this.m_nodes[iD].parentOrNext = iA;
                this.m_nodes[iA].aabb = AabbUnion(this.m_nodes[iC].aabb, this.m_nodes[iD].aabb);
                this.m_nodes[iB].aabb = AabbUnion(this.m_nodes[iA].aabb, this.m_nodes[iE].aabb);
                this.m_nodes[iA].height = 1 + Max(this.m_nodes[iC].height, this.m_nodes[iD].height);
                this.m_nodes[iB].height = 1 + Max(this.m_nodes[iA].height, this.m_nodes[iE].height);
            }
            return iB;
        }

        return iA;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

