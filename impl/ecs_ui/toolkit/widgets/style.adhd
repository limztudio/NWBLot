#include <impl/ecs_ui/toolkit/input/input.adhd>
#include <impl/ecs_ui/toolkit/input/popup.adhd>
#include <impl/ecs_ui/toolkit/layout/validation.adhd>
#include <impl/ecs_ui/toolkit/text/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Default metrics and colors shared by the widget styles and options.
const f32 s_StyleSpacingSmall = 4.0f;
const f32 s_StyleSpacingMedium = 8.0f;
const f32 s_StyleFieldPaddingY = 6.0f;
const f32 s_StyleControlExtent = 24.0f;
const f32 s_StyleControlHeight = 32.0f;
const f32 s_StyleMinimumFieldWidth = 120.0f;
const f32 s_StyleSliderTrackHeight = 12.0f;
const f32 s_StyleScrollbarThickness = 14.0f;
const f32 s_StyleScrollbarMinimumThumb = 20.0f;
const f32 s_StyleScrollWheelStep = 3.0f;
const f32 s_StyleMarkInset = 0.3f;
const f32 s_StyleDisabledIconAlpha = 0.5f;
const f32 s_CheckmarkInsetFraction = 0.2f;
// The mark loses its inset on both opposite sides.
const f32 s_CheckmarkInsetSides = 2.0f;
const f32 s_StyleWindowCollapseExtent = 20.0f;
const f32 s_StyleWindowResizeExtent = 16.0f;
const Color s_StyleTextColor = Color(0.92f, 0.94f, 0.98f, 1.0f);
const Color s_StyleDisabledTextColor = Color(0.48f, 0.50f, 0.55f, 1.0f);
const Color s_StyleInsetColor = Color(0.08f, 0.10f, 0.14f, 1.0f);
const Color s_StyleHoverTint = Color(1.08f, 1.08f, 1.08f, 1.0f);
const Color s_StylePressedTint = Color(0.85f, 0.85f, 0.85f, 1.0f);
const Color s_StyleDisabledTint = Color(0.55f, 0.55f, 0.55f, 0.6f);

// Semantic atlas names let another skin replace imagery and control metrics without application changes.
class WidgetStyle{
    public Name panel = Name("panel.normal");
    public Name window = Name("window.normal");
    public Name windowTitle = Name("window.title");
    public Name windowCollapse = Name("window.collapse");
    public Name windowResize = Name("window.resize");
    public Name separator = Name("separator");
    public Name white = Name("white");
    public Name button = Name("button.normal");
    public Name buttonHover = Name("button.hover");
    public Name buttonPressed = Name("button.pressed");
    public Name buttonDisabled = Name("button.disabled");
    public Name checkbox = Name("checkbox.normal");
    public Name checkboxHover = Name("checkbox.hover");
    public Name checkboxChecked = Name("checkbox.checked");
    public Name checkboxDisabled = Name("checkbox.disabled");
    public Name checkboxMark = Name("checkbox.mark");
    public Name focus = Name("focus.overlay");
    public Color text = s_StyleTextColor;
    public Color disabledText = s_StyleDisabledTextColor;
    public f32 fontSize = s_TextDefaultFontSize;
    public f32 gap = s_StyleSpacingMedium;
    public f32 checkboxExtent = s_StyleControlExtent;
    public f32 windowCollapseExtent = s_StyleWindowCollapseExtent;
    public f32 windowResizeExtent = s_StyleWindowResizeExtent;
}

class WidgetOptions{
    public LayoutSize width;
    public LayoutSize height;
    public b8 enabled = true;
}

class ContainerOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public LayoutSize height;
    public Insets padding;
    public f32 gap = s_StyleSpacingMedium;
}

enum<u8> SeparatorDirection{
    Horizontal,
    Vertical,
}

class SeparatorOptions{
    public LayoutSize length = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    // Zero uses the skin's minimum thickness, or one logical unit when no minimum is specified.
    public f32 thickness = 0.0f;
    public SeparatorDirection direction = SeparatorDirection::Horizontal;
}

void ApplySkinPaletteToWidgetStyle(in UiSkinPalette palette, mut WidgetStyle style){
    style.text = ResolveUiSkinColor(palette, UiSkinColorRole::TextNormal);
    style.disabledText = ResolveUiSkinColor(palette, UiSkinColorRole::TextDisabled);
}

Expected<Point> TryResolveSkinRegionMinimumSize(in UiSkinRegion region, in f32 density){
    const Expected<f32x4> minimum = TryLoadUiSkinMinimumSize(region, cast<f64>(density));
    if(!minimum.has_value())
        return makeUnexpected(Failure());
    return Point(minimum.value().x, minimum.value().y);
}

Point ResolveCenteredTextOrigin(in Rect bounds, in f32 xInset, in f32 lineHeight){
    return Point(bounds.x + xInset, bounds.y + max(bounds.height - lineHeight, 0.0f) * s_RectCenterFraction);
}

Point ResolveCenteredTextOrigin(in Rect bounds, in f32 xInset, in Rect textBounds){
    const Point origin = ResolveCenteredTextOrigin(bounds, xInset, textBounds.height);
    return Point(origin.x - textBounds.x, origin.y - textBounds.y);
}

Name ResolveButtonPreferredName(in WidgetStyle style, in b8 enabled, in b8 pressed, in b8 hover){
    if(!enabled)
        return style.buttonDisabled;
    if(pressed)
        return style.buttonPressed;
    if(hover)
        return style.buttonHover;
    return style.button;
}

void ResolveButtonTextPlacement(in Rect bounds, in Insets padding, in Point measured, mut Rect outTextClip, mut Point outOrigin){
    outTextClip = InsetUiRectBounds(bounds, padding);
    outOrigin = ResolveCenteredTextOrigin(outTextClip, max(0.0f, (outTextClip.width - measured.x) * s_RectCenterFraction), measured.y);
}

Name ResolveCheckboxPreferredName(in WidgetStyle style, in b8 enabled, in b8 checked, in b8 hover){
    if(!enabled)
        return style.checkboxDisabled;
    if(checked)
        return style.checkboxChecked;
    if(hover)
        return style.checkboxHover;
    return style.checkbox;
}

void ResolveCheckboxPlacement(
    in Rect bounds,
    in f32 checkboxExtent,
    in f32 gap,
    in Point measured,
    mut Rect outSquare,
    mut Rect outMark,
    mut Rect outTextClip,
    mut Point outOrigin
){
    const f32 squareOffsetY = max(0.0f, (bounds.height - checkboxExtent) * s_RectCenterFraction);
    outSquare = Rect(bounds.x, bounds.y + squareOffsetY, checkboxExtent, checkboxExtent);
    const f32 inset = checkboxExtent * s_CheckmarkInsetFraction;
    const f32 markExtent = checkboxExtent - (s_CheckmarkInsetSides * inset);
    outMark = Rect(outSquare.x + inset, outSquare.y + inset, markExtent, markExtent);
    const f32 textOffsetX = checkboxExtent + gap;
    outOrigin = ResolveCenteredTextOrigin(bounds, textOffsetX, measured.y);
    const f32 clipWidth = max(0.0f, bounds.width - textOffsetX);
    outTextClip = Rect(outOrigin.x, bounds.y, clipWidth, bounds.height);

}


