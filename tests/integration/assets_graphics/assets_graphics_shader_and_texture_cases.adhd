const StringView s_TexturesDirectory = "textures";
const StringView s_CheckerMetadataFilename = "checker.nwb";
const StringView s_TextureTestMetadata = "texture asset;\n\nasset.format = \"uastc_ldr_4x4\";\nasset.dimension = \"2d\";\nasset.resolution = [7, 5];\nasset.alpha_mode = \"embedded_ldr\";\n";

class TextureMetadataDiagnosticCase{
    public StringView m_assignment;
    public StringView m_diagnostic;

    public TextureMetadataDiagnosticCase(in StringView assignment, in StringView diagnostic){
        this.m_assignment = assignment;
        this.m_diagnostic = diagnostic;
    }
}

class ShaderRayQueryMetadataCase{
    public StringView m_fields;
    public b8 m_accepted;

    public ShaderRayQueryMetadataCase(in StringView fields, in b8 accepted){
        this.m_fields = fields;
        this.m_accepted = accepted;
    }
}

class MipRecordCorruptionCase{
    public usize m_fieldOffset;
    public u32 m_value;

    public MipRecordCorruptionCase(in usize fieldOffset, in u32 value){
        this.m_fieldOffset = fieldOffset;
        this.m_value = value;
    }
}

class OverflowLayoutCase{
    public TextureDimensionEnum m_dimension;
    public u32 m_width;
    public u32 m_height;
    public u32 m_depth;
    public StringView m_diagnostic;

    public OverflowLayoutCase(in TextureDimensionEnum dimension, in u32 width, in u32 height, in u32 depth, in StringView diagnostic){
        this.m_dimension = dimension;
        this.m_width = width;
        this.m_height = height;
        this.m_depth = depth;
        this.m_diagnostic = diagnostic;
    }
}

b8 TryParseTextureMetadata(in StringView metadata, in StringView caseName, mut TestArena testArena, mut ScratchArena scratchArena){
    MetaDocument document(testArena.arena);
    if(!document.parse(metadata))
        return false;
    const GraphicsTestPath assetRoot = JoinGraphicsPath(GetGraphicsTestCaseRoot(testArena, caseName), s_AssetsDirectory);
    const GraphicsTestPath metadataPath = JoinGraphicsPath2(assetRoot, s_TexturesDirectory, s_CheckerMetadataFilename);
    return ParseTestTextureCookMetadata(assetRoot, "project", metadataPath, document, testArena, scratchArena).has_value();
}

void VerifyAssetsGraphics_ShaderDependenciesTrackContinuedIncludesAndRejectUnplannedIncludes(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_ShaderScratchArena);

    const Expected<GraphicsTestPath> rootResult = PrepareCaseRoot(testArena, "shader_dependency_directives");
    ASSERT_TRUE(rootResult.has_value());
    const GraphicsTestPath root = rootResult.value();

    const GraphicsTestPath sourcePath = JoinGraphicsPath(root, "source.slang");
    const GraphicsTestPath trackedInclude = JoinGraphicsPath(root, "tracked.slangi");
    const StringView validSource = "/*\n#include \"missing_block.slangi\"\n*/\n// #include \"missing_line.slangi\"\n#include \\\r\n\"tracked.slangi\"\n";
    ASSERT_TRUE(WriteTextFile(sourcePath, validSource));
    ASSERT_TRUE(WriteTextFile(trackedInclude, "static const uint trackedValue = 1u;\n"));

    ShaderCookPathVector includeDirectories(testArena.arena);
    ShaderCookPathVector dependencies(testArena.arena);
    ASSERT_TRUE(GatherShaderDependencies(sourcePath, includeDirectories, scratchArena, dependencies));
    ASSERT_EQ(dependencies.size(), 2u);
    ASSERT_TRUE(PathVectorContains(dependencies, trackedInclude));

    const Expected<u64> beforeChecksum = ComputeSingleAliasShaderDependencyChecksum(dependencies, includeDirectories, root, "source", scratchArena);
    ASSERT_TRUE(beforeChecksum.has_value());
    ASSERT_TRUE(WriteTextFile(trackedInclude, "static const uint trackedValue = 2u;\n"));
    const Expected<u64> afterChecksum = ComputeSingleAliasShaderDependencyChecksum(dependencies, includeDirectories, root, "source", scratchArena);
    ASSERT_TRUE(afterChecksum.has_value());
    EXPECT_NE(beforeChecksum.value(), afterChecksum.value());
    EXPECT_EQ(logger.errorCount(), 0u);

    Vector<StringView> unplannedIncludes = Vector<StringView>();
    unplannedIncludes.reserve(3u);
    unplannedIncludes.push_back("#define GENERATED_INCLUDE \"tracked.slangi\"\n#include GENERATED_INCLUDE\n");
    unplannedIncludes.push_back("#include_next \"tracked.slangi\"\n");
    unplannedIncludes.push_back("#import \"tracked.slangi\"\n");
    for(in StringView source : unplannedIncludes){
        const ScopedTestTrace trace(source);
        ASSERT_TRUE(WriteTextFile(sourcePath, source));
        EXPECT_FALSE(GatherShaderDependencies(sourcePath, includeDirectories, scratchArena, dependencies));
    }
    const u32 failureErrors = logger.errorCount();
    EXPECT_GT(failureErrors, 0u);
    ASSERT_TRUE(WriteTextFile(sourcePath, validSource));
    EXPECT_TRUE(GatherShaderDependencies(sourcePath, includeDirectories, scratchArena, dependencies));
    EXPECT_EQ(logger.errorCount(), failureErrors);
    EXPECT_TRUE(RemoveAllIfExists(root));
}

void VerifyAssetsGraphics_ShaderDependencyChecksumAliasesGeneratedRoot(){
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_ShaderScratchArena);

    const Expected<GraphicsTestPath> rootResult = PrepareCaseRoot(testArena, "shader_dependency_checksum_alias");
    ASSERT_TRUE(rootResult.has_value());
    const GraphicsTestPath root = rootResult.value();

    const GraphicsTestPath firstGeneratedRoot = JoinGraphicsPath2(root, "first", s_MaterialBindIncludesDirectory);
    const GraphicsTestPath secondGeneratedRoot = JoinGraphicsPath2(root, "second", s_MaterialBindIncludesDirectory);
    const GraphicsTestPath firstGeneratedInclude = JoinGraphicsPath3(firstGeneratedRoot, "project", "material_interfaces", "test_surface.bind");
    const GraphicsTestPath secondGeneratedInclude = JoinGraphicsPath3(secondGeneratedRoot, "project", "material_interfaces", "test_surface.bind");
    EXPECT_TRUE(WriteTextFile(firstGeneratedInclude, "generated include\n"));
    EXPECT_TRUE(WriteTextFile(secondGeneratedInclude, "generated include\n"));

    ShaderCookPathVector includeDirectories(testArena.arena);
    ShaderCookPathVector firstDependencies(testArena.arena);
    ShaderCookPathVector secondDependencies(testArena.arena);
    firstDependencies.push_back(firstGeneratedInclude);
    secondDependencies.push_back(secondGeneratedInclude);

    const Expected<u64> firstChecksum = ComputeSingleAliasShaderDependencyChecksum(firstDependencies, includeDirectories, firstGeneratedRoot, s_MaterialBindIncludesDirectory, scratchArena);
    ASSERT_TRUE(firstChecksum.has_value());
    const Expected<u64> secondChecksum = ComputeSingleAliasShaderDependencyChecksum(secondDependencies, includeDirectories, secondGeneratedRoot, s_MaterialBindIncludesDirectory, scratchArena);
    ASSERT_TRUE(secondChecksum.has_value());
    EXPECT_EQ(firstChecksum.value(), secondChecksum.value());

    EXPECT_TRUE(WriteTextFile(secondGeneratedInclude, "changed generated include\n"));
    const Expected<u64> changedChecksum = ComputeSingleAliasShaderDependencyChecksum(secondDependencies, includeDirectories, secondGeneratedRoot, s_MaterialBindIncludesDirectory, scratchArena);
    ASSERT_TRUE(changedChecksum.has_value());
    EXPECT_NE(firstChecksum.value(), changedChecksum.value());

    if(AssetsGraphicsTestConfigurationName() == "fin"){
        const GraphicsTestPath unaliasedDependency = JoinGraphicsPath2(root, "outside", "unaliased.slangi");
        EXPECT_TRUE(WriteTextFile(unaliasedDependency, "outside alias root\n"));
        ShaderCookPathVector unaliasedDependencies(testArena.arena);
        unaliasedDependencies.push_back(unaliasedDependency);

        CapturingLogger logger = CapturingLogger();
        LoggerRegistrationGuard loggerRegistrationGuard(logger, s_ReportOnly);
        EXPECT_FALSE(ComputeSingleAliasShaderDependencyChecksum(unaliasedDependencies, includeDirectories, firstGeneratedRoot, s_MaterialBindIncludesDirectory, scratchArena).has_value());
        EXPECT_TRUE(SawCapturedError(logger, "outside the declared dependency root aliases"));
    }

    EXPECT_TRUE(RemoveAllIfExists(root));
}

void VerifyAssetsGraphics_ShaderDependencyChecksumIncludesOrderedSearchRootsWithSameFileUnion(){
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_ShaderScratchArena);

    const Expected<GraphicsTestPath> rootResult = PrepareCaseRoot(testArena, "shader_dependency_search_order");
    ASSERT_TRUE(rootResult.has_value());
    const GraphicsTestPath root = rootResult.value();
    const GraphicsTestPath firstRoot = JoinGraphicsPath(root, "first");
    const GraphicsTestPath secondRoot = JoinGraphicsPath(root, "second");
    const GraphicsTestPath sourcePath = JoinGraphicsPath(root, "source.slang");
    ASSERT_TRUE(WriteTextFile(sourcePath, "#include <choice.slangi>\nstatic const uint selectedValue = NWB_TEST_SELECTED;\n"));
    ASSERT_TRUE(WriteTextFile(JoinGraphicsPath(firstRoot, "choice.slangi"), "#ifndef NWB_TEST_FIRST\n#define NWB_TEST_FIRST\n#ifndef NWB_TEST_SELECTED\n#define NWB_TEST_SELECTED 1\n#endif\n#include \"../second/choice.slangi\"\n#endif\n"));
    ASSERT_TRUE(WriteTextFile(JoinGraphicsPath(secondRoot, "choice.slangi"), "#ifndef NWB_TEST_SECOND\n#define NWB_TEST_SECOND\n#ifndef NWB_TEST_SELECTED\n#define NWB_TEST_SELECTED 2\n#endif\n#include \"../first/choice.slangi\"\n#endif\n"));

    ShaderCookPathVector firstDirectories(testArena.arena);
    ShaderCookPathVector secondDirectories(testArena.arena);
    ShaderCookPathVector noDirectories(testArena.arena);
    firstDirectories.push_back(firstRoot);
    firstDirectories.push_back(secondRoot);
    secondDirectories.push_back(secondRoot);
    secondDirectories.push_back(firstRoot);

    ShaderCookPathVector firstDependencies(testArena.arena);
    ShaderCookPathVector secondDependencies(testArena.arena);
    ASSERT_TRUE(GatherShaderDependencies(sourcePath, firstDirectories, scratchArena, firstDependencies));
    ASSERT_TRUE(GatherShaderDependencies(sourcePath, secondDirectories, scratchArena, secondDependencies));
    ASSERT_EQ(firstDependencies.size(), 3u);
    ASSERT_EQ(secondDependencies.size(), firstDependencies.size());
    for(in GraphicsTestPath dependency : firstDependencies)
        EXPECT_TRUE(PathVectorContains(secondDependencies, dependency));

    const Expected<u64> firstFileUnion = ComputeSingleAliasShaderDependencyChecksum(firstDependencies, noDirectories, root, "source", scratchArena);
    const Expected<u64> secondFileUnion = ComputeSingleAliasShaderDependencyChecksum(secondDependencies, noDirectories, root, "source", scratchArena);
    ASSERT_TRUE(firstFileUnion.has_value());
    ASSERT_TRUE(secondFileUnion.has_value());
    EXPECT_EQ(firstFileUnion.value(), secondFileUnion.value());

    const Expected<u64> firstSearch = ComputeSingleAliasShaderDependencyChecksum(firstDependencies, firstDirectories, root, "source", scratchArena);
    const Expected<u64> secondSearch = ComputeSingleAliasShaderDependencyChecksum(secondDependencies, secondDirectories, root, "source", scratchArena);
    ASSERT_TRUE(firstSearch.has_value());
    ASSERT_TRUE(secondSearch.has_value());
    EXPECT_NE(firstSearch.value(), secondSearch.value());

    firstDirectories.push_back(root.parentPath());
    const Expected<u64> externalSearch = ComputeSingleAliasShaderDependencyChecksum(firstDependencies, firstDirectories, root, "source", scratchArena);
    ASSERT_TRUE(externalSearch.has_value());
    EXPECT_NE(externalSearch.value(), firstSearch.value());

    // Unused case-only search roots keep their exact spelling even on case-insensitive hosts.
    firstDirectories.clear();
    firstDirectories.push_back(JoinGraphicsPath(root, "CaseOnly"));
    const Expected<u64> upperCaseSearch = ComputeSingleAliasShaderDependencyChecksum(firstDependencies, firstDirectories, root, "source", scratchArena);
    firstDirectories.clear();
    firstDirectories.push_back(JoinGraphicsPath(root, "caseonly"));
    const Expected<u64> lowerCaseSearch = ComputeSingleAliasShaderDependencyChecksum(firstDependencies, firstDirectories, root, "source", scratchArena);
    ASSERT_TRUE(upperCaseSearch.has_value());
    ASSERT_TRUE(lowerCaseSearch.has_value());
    EXPECT_NE(upperCaseSearch.value(), lowerCaseSearch.value());
    EXPECT_TRUE(RemoveAllIfExists(root));
}

void VerifyAssetsGraphics_ShaderDependencyChecksumPreservesPhysicalPathCaseAcrossAliasedRoots(){
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_ShaderScratchArena);

    const Expected<GraphicsTestPath> rootResult = PrepareCaseRoot(testArena, "shader_dependency_case_identity");
    ASSERT_TRUE(rootResult.has_value());
    const GraphicsTestPath root = rootResult.value();
    const GraphicsTestPath firstRoot = JoinGraphicsPath(root, "first");
    const GraphicsTestPath secondRoot = JoinGraphicsPath(root, "second");
    const GraphicsTestPath upperPath = JoinGraphicsPath(firstRoot, "Case.slangi");
    const GraphicsTestPath lowerPath = JoinGraphicsPath(secondRoot, "case.slangi");
    ASSERT_TRUE(WriteTextFile(upperPath, "same dependency bytes\n"));
    ASSERT_TRUE(WriteTextFile(lowerPath, "same dependency bytes\n"));

    ShaderCookPathVector noDirectories(testArena.arena);
    ShaderCookPathVector upperDependencies(testArena.arena);
    ShaderCookPathVector lowerDependencies(testArena.arena);
    upperDependencies.push_back(upperPath);
    lowerDependencies.push_back(lowerPath);
    const Expected<u64> upperKey = ComputeSingleAliasShaderDependencyChecksum(upperDependencies, noDirectories, firstRoot, "source", scratchArena);
    const Expected<u64> lowerKey = ComputeSingleAliasShaderDependencyChecksum(lowerDependencies, noDirectories, secondRoot, "source", scratchArena);
    ASSERT_TRUE(upperKey.has_value());
    ASSERT_TRUE(lowerKey.has_value());
    EXPECT_NE(upperKey.value(), lowerKey.value());
    EXPECT_TRUE(RemoveAllIfExists(root));
}

void VerifyAssetsGraphics_ShaderDependencyCollectionRetainsCaseDistinctPhysicalInputs(){
    if(IsWindowsPlatformHost()){
        native{
            GTEST_SKIP() << "Windows shader path duplicate policy is case insensitive";
        }
        return;
    }

    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_ShaderScratchArena);
    const Expected<GraphicsTestPath> rootResult = PrepareCaseRoot(testArena, "shader_dependency_case_collection");
    ASSERT_TRUE(rootResult.has_value());
    const GraphicsTestPath root = rootResult.value();

    const GraphicsTestPath sourcePath = JoinGraphicsPath(root, "source.slang");
    const GraphicsTestPath upperPath = JoinGraphicsPath(root, "Case.slangi");
    const GraphicsTestPath lowerPath = JoinGraphicsPath(root, "case.slangi");
    const StringView upperExpected = "static const uint upperValue = 1;\n";
    ASSERT_TRUE(WriteTextFile(upperPath, upperExpected));
    ASSERT_TRUE(WriteTextFile(lowerPath, "static const uint lowerValue = 2;\n"));

    b8 caseDistinct = false;
    ASSERT_TRUE(ReadTextFileMatches(upperPath, upperExpected, scratchArena, caseDistinct));
    if(!caseDistinct){
        EXPECT_TRUE(RemoveAllIfExists(root));
        native{
            GTEST_SKIP() << "Filesystem provider cannot store case-distinct shader inputs";
        }
        return;
    }

    ASSERT_TRUE(WriteTextFile(sourcePath, "#include \"Case.slangi\"\n#include \"case.slangi\"\n"));
    ShaderCookPathVector noDirectories(testArena.arena);
    ShaderCookPathVector dependencies(testArena.arena);
    ASSERT_TRUE(GatherShaderDependencies(sourcePath, noDirectories, scratchArena, dependencies));
    ASSERT_EQ(dependencies.size(), 3u);
    EXPECT_TRUE(PathVectorContains(dependencies, upperPath));
    EXPECT_TRUE(PathVectorContains(dependencies, lowerPath));

    const Expected<u64> firstKey = ComputeSingleAliasShaderDependencyChecksum(dependencies, noDirectories, root, "source", scratchArena);
    ASSERT_TRUE(firstKey.has_value());
    ASSERT_TRUE(WriteTextFile(lowerPath, "static const uint lowerValue = 3;\n"));
    const Expected<u64> changedKey = ComputeSingleAliasShaderDependencyChecksum(dependencies, noDirectories, root, "source", scratchArena);
    ASSERT_TRUE(changedKey.has_value());
    EXPECT_NE(firstKey.value(), changedKey.value());
    EXPECT_TRUE(RemoveAllIfExists(root));
}

void VerifyAssetsGraphics_ShaderMetadataRejectsDefaultVariantAlias(){
    if(AssetsGraphicsTestConfigurationName() != "fin")
        return;

    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_ReportOnly);
    TestArena testArena = TestArena();
    const Expected<GraphicsTestPath> rootResult = PrepareCaseRoot(testArena, "shader_default_variant_alias");
    ASSERT_TRUE(rootResult.has_value());
    const GraphicsTestPath root = rootResult.value();

    const GraphicsTestPath assetRoot = JoinGraphicsPath(root, "assets");
    const GraphicsTestPath includeMetaPath = JoinGraphicsPath2(assetRoot, "shaders", "default_variant_include.nwb");
    const GraphicsTestPath includeSourcePath = JoinGraphicsPath2(assetRoot, "shaders", "default_variant_include.slangi");
    EXPECT_TRUE(WriteTextFile(includeMetaPath, "include asset;\n\nasset.default_variant = \"NWB_FEATURE=0\";\nasset.defines = {\n    \"NWB_FEATURE\": [\"0\", \"1\"],\n};\n"));
    EXPECT_TRUE(WriteTextFile(includeSourcePath, ""));

    ScratchArena scratchArena(s_ShaderScratchArena);
    ShaderCook shaderCook(testArena.arena);
    EXPECT_FALSE(CanParseIncludeEntryFile(includeMetaPath, testArena, scratchArena, shaderCook));
    EXPECT_TRUE(SawCapturedError(logger, "unsupported asset field 'default_variant'"));
    EXPECT_TRUE(RemoveAllIfExists(root));
}

void VerifyAssetsGraphics_ShaderMetadataRejectsRetiredGenericTypeAndStageField(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_ShaderScratchArena);

    const Expected<GraphicsTestPath> rootResult = PrepareCaseRoot(testArena, "shader_retired_type_and_stage");
    ASSERT_TRUE(rootResult.has_value());
    const GraphicsTestPath root = rootResult.value();

    const GraphicsTestPath metadataPath = JoinGraphicsPath(root, "shader.nwb");
    ASSERT_TRUE(WriteTextFile(JoinGraphicsPath(root, "shader.slang"), "[numthreads(1, 1, 1)] void main(){}\n"));
    ShaderCook shaderCook(testArena.arena);
    const StringView validMetadata = "compute_shader asset;\nasset.entry_point = \"main\";\n";

    Vector<StringView> retiredMetadata = Vector<StringView>();
    retiredMetadata.reserve(4u);
    retiredMetadata.push_back("shader asset;\nasset.stage = \"cs\";\nasset.entry_point = \"main\";\n");
    retiredMetadata.push_back("shader asset;\nasset.entry_point = \"main\";\n");
    retiredMetadata.push_back("compute_shader asset;\nasset.stage = \"cs\";\nasset.entry_point = \"main\";\n");
    retiredMetadata.push_back("compute_shader asset;\nasset.stage = \"ps\";\nasset.entry_point = \"main\";\n");

    for(in StringView metadata : retiredMetadata){
        const ScopedTestTrace trace(metadata);
        ASSERT_TRUE(WriteTextFile(metadataPath, validMetadata));
        ASSERT_TRUE(CanParseShaderEntryFile(metadataPath, testArena, scratchArena, shaderCook));
        ASSERT_TRUE(WriteTextFile(metadataPath, metadata));
        EXPECT_FALSE(CanParseShaderEntryFile(metadataPath, testArena, scratchArena, shaderCook));
        ASSERT_TRUE(WriteTextFile(metadataPath, validMetadata));
        EXPECT_TRUE(CanParseShaderEntryFile(metadataPath, testArena, scratchArena, shaderCook));
    }
    EXPECT_TRUE(RemoveAllIfExists(root));
}

void VerifyAssetsGraphics_ShaderMetadataRejectsObsoleteProfilesAndInvalidConditionalFlags(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_ShaderScratchArena);

    const Expected<GraphicsTestPath> rootResult = PrepareCaseRoot(testArena, "shader_ray_query_metadata");
    ASSERT_TRUE(rootResult.has_value());
    const GraphicsTestPath root = rootResult.value();

    const GraphicsTestPath metadataPath = JoinGraphicsPath(root, "shader.nwb");
    ASSERT_TRUE(WriteTextFile(JoinGraphicsPath(root, "shader.slang"), "void main(){}\n"));

    Vector<ShaderRayQueryMetadataCase> cases = Vector<ShaderRayQueryMetadataCase>();
    cases.reserve(13u);
    cases.push_back(ShaderRayQueryMetadataCase("", true));
    cases.push_back(ShaderRayQueryMetadataCase("asset.ray_query = 0;\n", true));
    cases.push_back(ShaderRayQueryMetadataCase("asset.ray_query = 1;\n", true));
    cases.push_back(ShaderRayQueryMetadataCase("asset.ray_query = -1;\n", false));
    cases.push_back(ShaderRayQueryMetadataCase("asset.ray_query = 2;\n", false));
    cases.push_back(ShaderRayQueryMetadataCase("asset.ray_query = 1.0;\n", false));
    cases.push_back(ShaderRayQueryMetadataCase("asset.ray_query = \"1\";\n", false));
    cases.push_back(ShaderRayQueryMetadataCase("asset.ray_query = [];\n", false));
    cases.push_back(ShaderRayQueryMetadataCase("asset.ray_query = {};\n", false));
    cases.push_back(ShaderRayQueryMetadataCase("asset.target_profile = \"spirv_1_5\";\n", false));
    cases.push_back(ShaderRayQueryMetadataCase("asset.target_profile = \"spirv_1_5+spvRayQueryKHR\";\n", false));
    cases.push_back(ShaderRayQueryMetadataCase("asset.emit_mesh_compute_shadow = 0;\n", false));
    cases.push_back(ShaderRayQueryMetadataCase("asset.emit_mesh_compute_shadow = 1;\n", false));

    ShaderCook shaderCook(testArena.arena);
    for(in ShaderRayQueryMetadataCase testCase : cases){
        const ScopedTestTrace trace(testCase.m_fields);
        TestAString metadata = TestAString();
        metadata.append("compute_shader asset;\nasset.entry_point = \"main\";\n");
        metadata.append(testCase.m_fields);
        ASSERT_TRUE(WriteTextFile(metadataPath, ViewTestString(metadata)));
        EXPECT_EQ(CanParseShaderEntryFile(metadataPath, testArena, scratchArena, shaderCook), testCase.m_accepted);
    }

    Vector<StringView> shaderAssetTypes = Vector<StringView>();
    shaderAssetTypes.reserve(3u);
    shaderAssetTypes.push_back("vertex_shader");
    shaderAssetTypes.push_back("pixel_shader");
    shaderAssetTypes.push_back("ray_generation_shader");
    for(in StringView shaderAssetType : shaderAssetTypes){
        TestAString metadata = TestAString();
        metadata.append(shaderAssetType);
        metadata.append(" asset;\nasset.entry_point = \"main\";\nasset.emit_mesh_compute_shadow = 1;\n");
        ASSERT_TRUE(WriteTextFile(metadataPath, ViewTestString(metadata)));
        EXPECT_FALSE(CanParseShaderEntryFile(metadataPath, testArena, scratchArena, shaderCook));
    }
    ASSERT_TRUE(WriteTextFile(metadataPath, "mesh_shader asset;\nasset.entry_point = \"main\";\nasset.emit_mesh_compute_shadow = 0;\n"));
    ASSERT_TRUE(CanParseShaderEntryFile(metadataPath, testArena, scratchArena, shaderCook));
    EXPECT_TRUE(RemoveAllIfExists(root));
}

void VerifyAssetsGraphics_ShaderMetadataRejectsEngineTransportDefinesAndRecoversWithRealVariants(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_ShaderScratchArena);

    const Expected<GraphicsTestPath> rootResult = PrepareCaseRoot(testArena, "shader_transport_defines");
    ASSERT_TRUE(rootResult.has_value());
    const GraphicsTestPath root = rootResult.value();

    const GraphicsTestPath shaderPath = JoinGraphicsPath(root, "shader.nwb");
    const GraphicsTestPath includePath = JoinGraphicsPath(root, "include.nwb");
    ASSERT_TRUE(WriteTextFile(JoinGraphicsPath(root, "shader.slang"), "void main(){}\n"));
    ASSERT_TRUE(WriteTextFile(JoinGraphicsPath(root, "include.slangi"), "static const uint sourceValue = 1u;\n"));

    const StringView shaderDeclaration = "compute_shader asset;\nasset.entry_point = \"main\";\n";
    const StringView realDefines = "asset.defines = { \"PROJECT_QUALITY\": [\"0\", \"1\"] };\n";
    TestAString validShaderMetadata = TestAString();
    validShaderMetadata.append(shaderDeclaration);
    validShaderMetadata.append(realDefines);
    TestAString validIncludeMetadata = TestAString();
    validIncludeMetadata.append("include asset;\n");
    validIncludeMetadata.append(realDefines);

    ShaderCook shaderCook(testArena.arena);
    ShaderCookShaderEntry shaderEntry(testArena.arena);
    ShaderCookIncludeEntry includeEntry(testArena.arena);

    Vector<StringView> transportNames = Vector<StringView>();
    transportNames.reserve(2u);
    transportNames.push_back("NWB_BINDLESS_TLAS");
    transportNames.push_back("NWB_CAUSTIC_PHOTON_TRANSPORT");

    Vector<StringView> retiredValues = Vector<StringView>();
    retiredValues.reserve(2u);
    retiredValues.push_back("0");
    retiredValues.push_back("1");

    for(in StringView transportName : transportNames){
        const ScopedTestTrace traceTransport(transportName);
        for(in StringView retiredValue : retiredValues){
            const ScopedTestTrace traceRetired(retiredValue);
            ASSERT_TRUE(WriteTextFile(shaderPath, ViewTestString(validShaderMetadata)));
            {
                Expected<ShaderCookShaderEntry> metadataResult5 = ParseTestShaderEntryFile(shaderPath, testArena, scratchArena, shaderCook);
                ASSERT_TRUE(metadataResult5.has_value());
                shaderEntry = metadataResult5.value();
            }
            ASSERT_FALSE(shaderEntry.defineValues.empty());

            TestAString obsoleteShaderMetadata = TestAString();
            obsoleteShaderMetadata.append(shaderDeclaration);
            obsoleteShaderMetadata.append("asset.defines = { \"");
            obsoleteShaderMetadata.append(transportName);
            obsoleteShaderMetadata.append("\": [\"");
            obsoleteShaderMetadata.append(retiredValue);
            obsoleteShaderMetadata.append("\"] };\n");
            ASSERT_TRUE(WriteTextFile(shaderPath, ViewTestString(obsoleteShaderMetadata)));
            EXPECT_FALSE(CanParseShaderEntryFile(shaderPath, testArena, scratchArena, shaderCook));
            EXPECT_FALSE(shaderEntry.defineValues.empty());

            TestAString expectedDiagnostic = TestAString();
            expectedDiagnostic.append("define '");
            expectedDiagnostic.append(transportName);
            expectedDiagnostic.append("' is an engine transport feature");
            EXPECT_TRUE(SawCapturedError(logger, ViewTestString(expectedDiagnostic)));

            ASSERT_TRUE(WriteTextFile(shaderPath, ViewTestString(validShaderMetadata)));
            {
                Expected<ShaderCookShaderEntry> metadataResult4 = ParseTestShaderEntryFile(shaderPath, testArena, scratchArena, shaderCook);
                ASSERT_TRUE(metadataResult4.has_value());
                shaderEntry = metadataResult4.value();
            }
            EXPECT_TRUE(ValidateShaderEntryVariantSignature("project/shader", "PROJECT_QUALITY=0", shaderEntry, scratchArena));
            EXPECT_TRUE(ValidateShaderEntryVariantSignature("project/shader", "PROJECT_QUALITY=1", shaderEntry, scratchArena));

            TestAString invalidSignature = TestAString();
            invalidSignature.append(transportName);
            invalidSignature.append("=1;PROJECT_QUALITY=1");
            EXPECT_FALSE(ValidateShaderEntryVariantSignature("project/shader", ViewTestString(invalidSignature), shaderEntry, scratchArena));

            ASSERT_TRUE(WriteTextFile(includePath, ViewTestString(validIncludeMetadata)));
            {
                Expected<ShaderCookIncludeEntry> metadataResult3 = ParseTestIncludeEntryFile(includePath, testArena, scratchArena, shaderCook);
                ASSERT_TRUE(metadataResult3.has_value());
                includeEntry = metadataResult3.value();
            }
            ASSERT_FALSE(includeEntry.defineValues.empty());

            TestAString obsoleteIncludeMetadata = TestAString();
            obsoleteIncludeMetadata.append("include asset;\nasset.defines = { \"");
            obsoleteIncludeMetadata.append(transportName);
            obsoleteIncludeMetadata.append("\": [\"");
            obsoleteIncludeMetadata.append(retiredValue);
            obsoleteIncludeMetadata.append("\"] };\n");
            ASSERT_TRUE(WriteTextFile(includePath, ViewTestString(obsoleteIncludeMetadata)));
            EXPECT_FALSE(CanParseIncludeEntryFile(includePath, testArena, scratchArena, shaderCook));
            EXPECT_FALSE(includeEntry.defineValues.empty());

            ASSERT_TRUE(WriteTextFile(includePath, ViewTestString(validIncludeMetadata)));
            {
                Expected<ShaderCookIncludeEntry> metadataResult2 = ParseTestIncludeEntryFile(includePath, testArena, scratchArena, shaderCook);
                ASSERT_TRUE(metadataResult2.has_value());
                includeEntry = metadataResult2.value();
            }
            EXPECT_TRUE(ValidateIncludeEntryVariantSignature("project/include", "PROJECT_QUALITY=1", includeEntry, scratchArena));
        }
    }
    EXPECT_TRUE(RemoveAllIfExists(root));
}

void VerifyAssetsGraphics_InvalidShaderDefineNamePrecedesInvalidValueShape(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_ShaderScratchArena);

    const Expected<GraphicsTestPath> rootResult = PrepareCaseRoot(testArena, "shader_invalid_define_name_and_value");
    ASSERT_TRUE(rootResult.has_value());
    const GraphicsTestPath root = rootResult.value();
    const GraphicsTestPath metadataPath = JoinGraphicsPath(root, "shader.nwb");
    ASSERT_TRUE(WriteTextFile(JoinGraphicsPath(root, "shader.slang"), "void main(){}\n"));
    ASSERT_TRUE(WriteTextFile(metadataPath, "compute_shader asset;\nasset.entry_point = \"main\";\nasset.defines = { \"9BAD\": 1 };\n"));
    ShaderCook shaderCook(testArena.arena);
    EXPECT_FALSE(CanParseShaderEntryFile(metadataPath, testArena, scratchArena, shaderCook));
    EXPECT_TRUE(SawCapturedError(logger, "must be an ASCII shader identifier"));
    EXPECT_FALSE(SawCapturedError(logger, "values must be a list of strings"));
