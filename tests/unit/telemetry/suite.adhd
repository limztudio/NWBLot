class OwnedAllocation : NoCopy{
    private mut HeapStorage m_owner;
    private RawAllocation m_block;
    public usize requestedBytes;
    public OwnedAllocation(mut HeapStorage owner, in usize size){
        this.m_owner = owner;
        this.m_block = AllocateBytes(owner, 1u, size);
        this.requestedBytes = size;
    }
    public ~OwnedAllocation(){ this.releaseNow(); }
    public b8 valid()const{ return this.m_block.address() != 0u; }
    public u64 usableBytes()const{
        if(this.valid())
            return BackendSize(this.m_block);
        return 0u;
    }
    public b8 resizeTo(in usize size){
        RawAllocation resized = ResizeBytes(this.m_owner, this.m_block, 1u, size);
        if(resized.address() == 0u)
            return false;
        this.m_block = resized;
        this.requestedBytes = size;
        return true;
    }
    public void releaseNow(){
        if(this.valid()){
            FreeBytes(this.m_owner, this.m_block, 1u, this.requestedBytes);
            this.m_block = RawAllocation();
        }
    }
}
