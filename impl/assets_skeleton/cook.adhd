[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if defined(NWB_COOK)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <core/alloc/scratch.h>
#include <core/metascript/parser.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct SkeletonCookEntry{
    Name virtualPath = s_NameNone;
    Core::Assets::AssetVector<SkeletonCookJoint> joints;


public:
    explicit SkeletonCookEntry(Core::Assets::AssetArena& arena)noexcept
        : joints(arena)
    {}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] Expected<SkeletonCookEntry> ParseSkeletonCookMetadata(Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<SkeletonCookEntry> ParseSkeletonCookMetadata(const Path& assetRoot, AStringView virtualRoot, const Path& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<Skeleton> BuildSkeletonAsset(const SkeletonCookEntry& skeletonEntry, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<SkeletonCookJoint> ParseSkeletonCookJoint(in Path nwbFilePath, in MetascriptValue jointValue, in usize jointIndex){
    if(!jointValue.isMap()){
        error("Skeleton meta '{}': joints[{}] must be a map", PathToString(nwbFilePath), jointIndex);
        return MakeUnexpected(Failure());
    }
    if(!ValidateMetadataAssetFields(nwbFilePath, jointValue, s_SkeletonJointDiagnosticPrefix, lambda[](in StringView fieldName) -> b8{
        return IsAllowedSkeletonJointMetadataField(fieldName);
    }))
        return MakeUnexpected(Failure());

    const Expected<Name> nameResult = ReadMetadataNameField(nwbFilePath, jointValue, s_SkeletonJointMetaKind, s_SkeletonNameField, true);
    if(!nameResult)
        return MakeUnexpected(Failure());

    const Expected<Name> parentResult = ReadMetadataNameField(nwbFilePath, jointValue, s_SkeletonJointMetaKind, s_SkeletonParentField, false);
    if(!parentResult)
        return MakeUnexpected(Failure());

    Expected<SkeletonJointMatrix> localBindPose = MakeIdentitySkeletonJointMatrix();
    jointValue.visitField(s_SkeletonLocalBindPoseField, lambda[in nwbFilePath, mut localBindPose](in MetascriptValue fieldValue) -> void{
        localBindPose = ParseSkeletonJointMatrixValue(nwbFilePath, fieldValue, s_SkeletonMetaKind, s_SkeletonLocalBindPoseField);
    });
    if(!localBindPose)
        return MakeUnexpected(Failure());

    SkeletonCookJoint joint;
    joint.name = nameResult.value();
    joint.parent = parentResult.value();
    joint.localBindPose = localBindPose.value();
    return joint;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if defined(NWB_COOK)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <core/assets/binary_payload_io.h>
#include <core/assets/cook_metadata.h>

#include <global/binary.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 SkeletonAssetCodec::serialize(const Core::Assets::IAsset& asset, Core::Assets::AssetBytes& outBinary)const{
    if(!checkSerializeAssetType(asset, AStringView("SkeletonAssetCodec::serialize")))
        return false;

    const Skeleton& skeleton = *MakeNotNull(checked_cast<const Skeleton*>(&asset));
    Core::Alloc::ScratchArena scratchArena(s_AssetsSkeletonSerializeArena);
    if(!skeleton.validatePayload(scratchArena))
        return false;

    Vector<NameHash, Core::Alloc::ScratchArena> jointNameHashes(skeleton.joints().size(), NameHash{}, scratchArena);
    return SerializeSkeletonBinaryPayload(skeleton.joints(), skeleton.jointIndices(), Span<NameHash>(jointNameHashes.data(), jointNameHashes.size()), outBinary);
}

Expected<SkeletonCookEntry> ParseSkeletonCookMetadata(const Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    SkeletonCookEntry entry(arena);

    if(!Core::Assets::CheckMetadataAssetMap(nwbFilePath, asset, s_SkeletonMetaDiagnosticPrefix))
        return MakeUnexpected(Failure{});

    if(!Core::Assets::AssignCookEntryVirtualPath(virtualPath, nwbFilePath, s_SkeletonMetaDiagnosticPrefix, entry))
        return MakeUnexpected(Failure{});
    if(!Core::Assets::ValidateMetadataAssetFields(nwbFilePath, asset, s_SkeletonMetaDiagnosticPrefix, &IsAllowedSkeletonMetadataField))
        return MakeUnexpected(Failure{});

    const auto joints = Core::Assets::ReadMetadataListField(nwbFilePath, asset, s_SkeletonMetaDiagnosticPrefix, s_SkeletonJointsField);
    if(!joints)
        return MakeUnexpected(joints.error());

    entry.joints.reserve(joints->size());
    for(usize jointIndex = 0u; jointIndex < joints->size(); ++jointIndex){
        auto jointResult = ParseSkeletonCookJoint(nwbFilePath, (*joints)[jointIndex], jointIndex);
        if(!jointResult)
            return MakeUnexpected(Failure{});
        entry.joints.push_back(*jointResult);
    }

    if(!BuildSkeletonAsset(entry, arena, scratchArena))
        return MakeUnexpected(Failure{});
    return entry;
}

Expected<SkeletonCookEntry> ParseSkeletonCookMetadata(const Path& assetRoot, const AStringView virtualRoot, const Path& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    return Core::Assets::ParseCookMetadataDocument<SkeletonCookEntry, &ParseSkeletonCookMetadata>(assetRoot, virtualRoot, nwbFilePath, doc, s_SkeletonMetaDiagnosticPrefix, arena, scratchArena);
}

Expected<Skeleton> BuildSkeletonAsset(const SkeletonCookEntry& skeletonEntry, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    Skeleton::JointVector joints(arena);
    Skeleton::JointIndexMap jointIndices(0, Hasher<Name>(), EqualTo<Name>(), arena);
    if(!BuildSkeletonCookJoints(skeletonEntry.virtualPath, skeletonEntry.joints, joints, jointIndices))
        return MakeUnexpected(Failure{});

    Skeleton asset(arena, skeletonEntry.virtualPath);
    asset.setJoints(Move(joints), Move(jointIndices));
    if(!asset.validatePayload(scratchArena))
        return MakeUnexpected(Failure{});
    return asset;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


