void VerifyAssetsUiSkin_TextureValidationRejectsIdentityDimensionAndExtentMismatch(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    SkinTestArena testArena = SkinTestArena();
    UiSkin skin(testArena.arena, Name(s_AtlasPath));
    ASSERT_TRUE(skin.loadBinary(MakeBinary(ValidHeader(), ValidRegion(), testArena)));
    for(u32 variant = 0u; variant < 4u; ++variant){
        const ScopedTestTrace trace(variant);
        Name texName = Name(s_TexturePath);
        if(variant == 0u)
            texName = s_UiTestProjectOther;
        Texture texture(testArena.arena, texName);
        native(in variant, mut testArena, mut texture){
            Texture::MipLevelVector mips(testArena.arena);
            Core::Assets::AssetBytes payload(testArena.arena);
            texture.setPayload(
                variant == 1u ? 63u : 64u,
                variant == 2u ? 31u : 32u,
                Move(mips),
                Move(payload),
                variant == 3u ? TextureDimension::TextureCube : TextureDimension::Texture2D,
                1u,
                TexturePayloadFormat::UastcLdr4x4,
                TextureAlphaMode::EmbeddedLdr,
                TextureFormat::s_OpaqueAlphaUnorm8
            );
        }
        EXPECT_FALSE(skin.validateTexture(texture));
    }
}

