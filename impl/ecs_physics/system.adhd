    public void shiftOrigin(mut World world, in VectorDouble delta){
        if(!IsFinite(delta))
            return;
        if(delta.x == 0.0 && delta.y == 0.0 && delta.z == 0.0)
            return;

        this.m_physicsWorld.shiftOrigin(delta);
        const VectorSingle negDelta(cast<f32>(-delta.x), cast<f32>(-delta.y), cast<f32>(-delta.z), 0.0f);
        this.m_environmentScratch.shiftOrigin(negDelta);

        world.view<TransformComponent>().each(
            lambda[in negDelta, mut world](in EntityID entity, mut TransformComponent xf) -> void{
                xf.position = f32x4(VectorSingle(xf.position) + negDelta, 0.0f);
                if(EntityUsesLocalHierarchyTransform(world, entity)){
                    const Optional<mut LocalTransformComponent> localOpt = world.borrowComponent<LocalTransformComponent>(entity);
                    if(localOpt.has_value()){
                        EntityID parent = s_InvalidEntityId;
                        b8 inheritScale = true;
                        if(!TryGetPhysicsOrSceneParent(world, entity, parent, inheritScale) || !parent.valid() || parent == entity || !world.alive(parent) || !world.hasComponent<TransformComponent>(parent))
                            localOpt.value().position = f32x4(VectorSingle(localOpt.value().position) + negDelta, 0.0f);
                    }
                }
            }
        );

        world.view<CharacterControllerComponent>().each(
            lambda[in negDelta](in EntityID entity, mut CharacterControllerComponent cc) -> void{
                cc.controller.shiftOrigin(negDelta);
            }
        );
        world.view<VehicleComponent>().each(
            lambda[in negDelta](in EntityID entity, mut VehicleComponent vc) -> void{
                vc.controller.shiftOrigin(negDelta);
            }
        );
        world.view<RagdollComponent>().each(
            lambda[in negDelta](in EntityID entity, mut RagdollComponent rc) -> void{
                rc.instance.shiftOrigin(negDelta);
            }
        );
        world.view<ArticulationComponent>().each(
            lambda[in negDelta](in EntityID entity, mut ArticulationComponent ac) -> void{
                ac.articulation.shiftOrigin(negDelta);
            }
        );
        world.view<SoftBodyComponent>().each(
            lambda[in negDelta](in EntityID entity, mut SoftBodyComponent sb) -> void{
                sb.softBody.shiftOrigin(negDelta);
            }
        );
        world.view<FractureComponent>().each(
            lambda[in negDelta](in EntityID entity, mut FractureComponent fc) -> void{
                fc.cluster.shiftOrigin(negDelta);
            }
        );

        for(usize i = 0u; i < this.m_bodyTransformSnapshots.size(); ++i){
            mut EcsBodyTransformSnapshot snap = this.m_bodyTransformSnapshots[i];
            snap.prevTransform.position = f32x4(VectorSingle(snap.prevTransform.position) + negDelta, 0.0f);
            snap.currTransform.position = f32x4(VectorSingle(snap.currTransform.position) + negDelta, 0.0f);
        }
        for(in auto kv : this.m_syncScratch.characterSyncStates){
            mut EcsCharacterControllerSyncState cs = this.m_syncScratch.characterSyncStates.at(kv.first);
            cs.prevPosition = f32x4(VectorSingle(cs.prevPosition) + negDelta, 0.0f);
            cs.currPosition = f32x4(VectorSingle(cs.currPosition) + negDelta, 0.0f);
        }
        for(in auto kv : this.m_syncScratch.articulationLiveStates){
            mut EcsArticulationLiveState ls = this.m_syncScratch.articulationLiveStates.at(kv.first);
            ls.prevBaseTransform.position = f32x4(VectorSingle(ls.prevBaseTransform.position) + negDelta, 0.0f);
            ls.currBaseTransform.position = f32x4(VectorSingle(ls.currBaseTransform.position) + negDelta, 0.0f);
            for(usize li = 0u; li < ls.prevLinkWorldTransforms.size(); ++li)
                ls.prevLinkWorldTransforms[li].position = f32x4(VectorSingle(ls.prevLinkWorldTransforms[li].position) + negDelta, 0.0f);
            for(usize li = 0u; li < ls.currLinkWorldTransforms.size(); ++li)
                ls.currLinkWorldTransforms[li].position = f32x4(VectorSingle(ls.currLinkWorldTransforms[li].position) + negDelta, 0.0f);
        }
        for(usize i = 0u; i < this.m_syncScratch.ecsFluidImmersionState.size(); ++i)
            this.m_syncScratch.ecsFluidImmersionState[i].lastPoint = f32x4(VectorSingle(this.m_syncScratch.ecsFluidImmersionState[i].lastPoint) + negDelta, 0.0f);
        this.m_syncScratch.writeBackPoseCache.clear();
    }

    public void shiftOrigin(in VectorDouble delta){
        this.shiftOrigin(this.m_world, delta);
    }

    public b8 captureWorldSnapshot(mut Vector<u8> outBytes){
        this.syncGpuResidentToWorld();
        PhysicsSubsystemsBundle bundle;
        bundle.environment = this.m_environmentScratch;
        Vector<EntityID> sortedIds;

        CollectSortedEntities<SoftBodyComponent>(this.m_world, sortedIds);
        bundle.softBodies.reserve(sortedIds.size());
        for(usize i = 0u; i < sortedIds.size(); ++i){
            const Optional<mut SoftBodyComponent> sbOpt = this.m_world.borrowComponent<SoftBodyComponent>(sortedIds[i]);
            if(sbOpt.has_value())
                bundle.softBodies.push_back(sbOpt.value().softBody);
        }

        CollectSortedEntities<VehicleComponent>(this.m_world, sortedIds);
        bundle.vehicles.reserve(sortedIds.size());
        for(usize i = 0u; i < sortedIds.size(); ++i){
            const Optional<mut VehicleComponent> vcOpt = this.m_world.borrowComponent<VehicleComponent>(sortedIds[i]);
            if(vcOpt.has_value())
                bundle.vehicles.push_back(vcOpt.value().controller);
        }

        CollectSortedEntities<RagdollComponent>(this.m_world, sortedIds);
        bundle.ragdolls.reserve(sortedIds.size());
        for(usize i = 0u; i < sortedIds.size(); ++i){
            const Optional<mut RagdollComponent> rcOpt = this.m_world.borrowComponent<RagdollComponent>(sortedIds[i]);
            if(rcOpt.has_value())
                bundle.ragdolls.push_back(rcOpt.value().instance);
        }

        CollectSortedEntities<CharacterControllerComponent>(this.m_world, sortedIds);
        bundle.characters.reserve(sortedIds.size());
        for(usize i = 0u; i < sortedIds.size(); ++i){
            const Optional<mut CharacterControllerComponent> ccOpt = this.m_world.borrowComponent<CharacterControllerComponent>(sortedIds[i]);
            if(ccOpt.has_value())
                bundle.characters.push_back(ccOpt.value().controller);
        }

        CollectSortedEntities<ArticulationComponent>(this.m_world, sortedIds);
        bundle.articulations.reserve(sortedIds.size());
        for(usize i = 0u; i < sortedIds.size(); ++i){
            const Optional<mut ArticulationComponent> acOpt = this.m_world.borrowComponent<ArticulationComponent>(sortedIds[i]);
            if(acOpt.has_value())
                bundle.articulations.push_back(acOpt.value().articulation);
        }

        CollectSortedEntities<FractureComponent>(this.m_world, sortedIds);
        bundle.fractureClusters.reserve(sortedIds.size());
        for(usize i = 0u; i < sortedIds.size(); ++i){
            const Optional<mut FractureComponent> fcOpt = this.m_world.borrowComponent<FractureComponent>(sortedIds[i]);
            if(fcOpt.has_value())
                bundle.fractureClusters.push_back(fcOpt.value().cluster);
        }

        return SerializeFullPhysicsSnapshot(this.m_physicsWorld, bundle, outBytes);
    }

    public b8 restoreWorldSnapshot(in Span<u8> bytes){
        PhysicsSubsystemsBundle bundle;
        if(!RestoreFullPhysicsSnapshot(bytes, this.m_physicsWorld, bundle))
            return false;

        ReleaseEcsPhysicsAssetCache(this.m_assetCache, this.m_physicsWorld, false);
        this.m_environmentScratch = bundle.environment;
        this.m_syncScratch.jointFastCache.clear();
        this.m_hasAnyPhysicsParents = AnyPhysicsHierarchyActive(this.m_world);

        in WorldDef restoredDef = this.m_physicsWorld.m_def;
        const PhysicsBackendMode restoredBackend = this.m_physicsWorld.m_backendMode;
        const u32 restoredGpuThresh = this.m_physicsWorld.m_gpuDispatchThreshold;
        const f32 restoredGpuFrac = this.m_physicsWorld.m_gpuWorkloadFraction;
        const b8 restoredWarm = this.m_physicsWorld.m_enableWarmStarting;
        this.m_world.view<PhysicsWorldConfigComponent>().each(
            lambda[in restoredDef, in restoredBackend, in restoredGpuThresh, in restoredGpuFrac, in restoredWarm](
                in EntityID entity,
                mut PhysicsWorldConfigComponent cfg
            ) -> void{
                cfg.gravity = restoredDef.gravity;
                cfg.restitutionThreshold = restoredDef.restitutionThreshold;
                cfg.hitEventThreshold = restoredDef.hitEventThreshold;
                cfg.contactHertz = restoredDef.contactHertz;
                cfg.contactDampingRatio = restoredDef.contactDampingRatio;
                cfg.maxLinearVelocity = restoredDef.maxLinearVelocity;
                cfg.timeToSleep = restoredDef.timeToSleep;
                cfg.enableSleep = restoredDef.enableSleep;
                cfg.enableContinuous = restoredDef.enableContinuous;
                cfg.enableContactSoftening = restoredDef.enableContactSoftening;
                cfg.enableGpuCollision = restoredDef.enableGpuCollision;
                cfg.forceGpuCollision = restoredDef.forceGpuCollision;
                cfg.gpuResidentMode = restoredDef.gpuResidentMode;
                cfg.useGpuLbvhBroadphase = restoredDef.useGpuLbvhBroadphase;
                cfg.backendMode = restoredBackend;
                cfg.gpuDispatchThreshold = restoredGpuThresh;
                cfg.gpuWorkloadFraction = restoredGpuFrac;
                cfg.enableWarmStarting = restoredWarm;
                cfg.dirty = false;
            }
        );

        const usize bodyCount = this.m_physicsWorld.m_bodies.size();
        const usize shapeCount = this.m_physicsWorld.m_shapes.size();
        const usize jointCount = this.m_physicsWorld.m_joints.size();
        this.m_bodyIndexToEntity.clear();
        this.m_bodyIndexToEntity.resize(bodyCount);
        this.m_shapeIndexToEntity.clear();
        this.m_shapeIndexToEntity.resize(shapeCount);
        this.m_jointIndexToEntity.clear();
        this.m_jointIndexToEntity.resize(jointCount);

        this.m_syncScratch.writeBackPoseCache.clear();
        this.m_syncScratch.restoreRemoveRecsScratch.clear();
        mut Vector<EntityID> removeRecs = this.m_syncScratch.restoreRemoveRecsScratch;
        mut Vector<ShapeId> validExtras = this.m_syncScratch.restoreValidExtrasScratch;
        for(in auto kv : this.m_entityRecords){
            const EntityID entity = kv.first;
            mut EcsEntityPhysicsRecord rec = this.m_entityRecords.at(entity);
            const b8 validBody = rec.bodyId.valid() && this.m_physicsWorld.isValidBody(rec.bodyId);
            const b8 validPrimary = rec.primaryShapeId.valid() && this.m_physicsWorld.isValidShape(rec.primaryShapeId);
            validExtras.clear();
            for(usize si = 0u; si < rec.extraShapeIds.size(); ++si){
                const ShapeId sId = rec.extraShapeIds[si];
                if(sId.valid() && this.m_physicsWorld.isValidShape(sId))
                    validExtras.push_back(sId);
            }
            const b8 droppedExtra = (validExtras.size() != rec.extraShapeIds.size());
            const b8 entityAlive = this.m_world.alive(entity);

            if(!validBody && !validPrimary && validExtras.empty()){
                removeRecs.push_back(entity);
                if(entityAlive){
                    const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
                    if(rbOpt.has_value()){
                        rbOpt.value().runtimeBodyId = BodyId();
                        rbOpt.value().dirty = true;
                    }
                    const Optional<mut ColliderComponent> colOpt = this.m_world.borrowComponent<ColliderComponent>(entity);
                    if(colOpt.has_value()){
                        colOpt.value().runtimeShapeId = ShapeId();
                        colOpt.value().runtimeExtraShapeIds.clear();
                        colOpt.value().boundBodyId = BodyId();
                        colOpt.value().dirty = true;
                    }
                }
                continue;
            }

            if(!validBody){
                rec.bodyId = BodyId();
                rec.attachedToParentBody = false;
                rec.parentBodyEntity = s_InvalidEntityId;
                if(entityAlive){
                    const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
                    if(rbOpt.has_value()){
                        rbOpt.value().runtimeBodyId = BodyId();
                        rbOpt.value().dirty = true;
                    }
                }
            }
            else if(!rec.attachedToParentBody && rec.bodyId.index < cast<u32>(bodyCount)){
                in Body b = this.m_physicsWorld.m_bodies[rec.bodyId.index];
                mut EcsSlotOwner bOwner = this.m_bodyIndexToEntity[rec.bodyId.index];
                bOwner.entity = entity;
                bOwner.generation = b.generation;
                bOwner.hasPhysicsParent = rec.hadPhysicsParent;
                if(entityAlive){
                    const Expected<Transform3D> xf = this.m_physicsWorld.tryGetBodyTransform(rec.bodyId);
                    if(xf.has_value())
                        WriteWorldPoseBackToEntityTransform(entity, xf.value(), this.m_hasAnyPhysicsParents, this.m_world, this.m_syncScratch.writeBackPoseCache);
                    const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
                    if(rbOpt.has_value()){
                        mut RigidBodyComponent rb = rbOpt.value();
                        rb.runtimeBodyId = rec.bodyId;
                        rb.type = b.type;
                        rb.isEnabled = this.m_physicsWorld.isBodyEnabled(rec.bodyId);
                        rb.isBullet = (b.flags & cast<u32>(BodyFlags::IsBullet)) != 0u;
                        rb.hasCustomMaxAngularVelocity = (b.flags & cast<u32>(BodyFlags::HasCustomMaxAngularVelocity)) != 0u;
                        if(rb.hasCustomMaxAngularVelocity)
                            rb.maxAngularVelocity = b.maxAngularVelocity;
                        else
                            rb.maxAngularVelocity = 0.0f;
                        rb.motionLocks = b.flags & 0x3Fu;
                        rb.enableSleep = (b.flags & cast<u32>(BodyFlags::EnableSleep)) != 0u;
                        rb.allowFastRotation = (b.flags & cast<u32>(BodyFlags::AllowFastRotation)) != 0u;
                        rb.enableGyroscopicTorque = (b.flags & cast<u32>(BodyFlags::EnableGyroscopicTorque)) != 0u;
                        rb.sleepThreshold = b.sleepThreshold;
                        rb.userData = b.userData;
                        if(b.setIndex < this.m_physicsWorld.m_solverSets.size() && b.localIndex < this.m_physicsWorld.m_solverSets[b.setIndex].sims.size()){
                            in BodySim sim = this.m_physicsWorld.m_solverSets[b.setIndex].sims[b.localIndex];
                            rb.gravityScale = sim.gravityScale;
                            rb.linearDamping = sim.linearDamping();
                            rb.angularDamping = sim.angularDamping();
                            if(rb.useCustomMass){
                                rb.customMass = b.mass;
                                rb.customCenterOfMass = f32x4(sim.localCenter(), 0.0f);
                                rb.customInertiaDiag = f32x4(b.inertiaLocal.m00, b.inertiaLocal.m11, b.inertiaLocal.m22, 0.0f);
                                rb.customInertiaOffDiag = f32x4(b.inertiaLocal.m01, b.inertiaLocal.m02, b.inertiaLocal.m12, 0.0f);
                            }
                        }
                        SyncRigidBodyVelocityAndAwakeDirect(this.m_physicsWorld, rec.bodyId.index, rb);
                        rb.dirty = false;
                    }
                }
            }

            if(validPrimary && rec.primaryShapeId.index < cast<u32>(shapeCount)){
                mut EcsSlotOwner sOwner = this.m_shapeIndexToEntity[rec.primaryShapeId.index];
                sOwner.entity = entity;
                sOwner.generation = rec.primaryShapeId.generation;
                sOwner.hasPhysicsParent = rec.hadPhysicsParent;
            }
            else if(!validPrimary){
                rec.primaryShapeId = ShapeId();
            }

            if(droppedExtra){
                rec.extraShapeIds.clear();
                for(usize si = 0u; si < validExtras.size(); ++si)
                    rec.extraShapeIds.push_back(validExtras[si]);
            }
            for(usize si = 0u; si < validExtras.size(); ++si){
                const ShapeId sId = validExtras[si];
                if(sId.index < cast<u32>(shapeCount)){
                    mut EcsSlotOwner sOwner = this.m_shapeIndexToEntity[sId.index];
                    sOwner.entity = entity;
                    sOwner.generation = sId.generation;
                    sOwner.hasPhysicsParent = rec.hadPhysicsParent;
                }
            }

            if(entityAlive){
                const Optional<mut ColliderComponent> colOpt = this.m_world.borrowComponent<ColliderComponent>(entity);
                if(colOpt.has_value()){
                    mut ColliderComponent col = colOpt.value();
                    col.runtimeShapeId = rec.primaryShapeId;
                    col.runtimeExtraShapeIds.clear();
                    for(usize si = 0u; si < validExtras.size(); ++si)
                        col.runtimeExtraShapeIds.push_back(validExtras[si]);
                    col.boundBodyId = rec.bodyId;
                    if(!validPrimary || droppedExtra || !validBody)
                        col.dirty = true;
                }
            }
        }
        for(usize ri = 0u; ri < removeRecs.size(); ++ri)
            this.m_entityRecords.erase(removeRecs[ri]);
        removeRecs.clear();
        validExtras.clear();

        this.m_syncScratch.restoreRemoveJointsScratch.clear();
        mut Vector<EntityID> removeJoints = this.m_syncScratch.restoreRemoveJointsScratch;
        for(in auto kv : this.m_entityJoints){
            const EntityID entity = kv.first;
            mut EcsJointSyncRecord jRec = this.m_entityJoints.at(entity);
            jRec.hasStructure = false;
            for(usize ei = 0u; ei < jRec.extraHasStructures.size(); ++ei)
                jRec.extraHasStructures[ei] = false;
            const b8 validPrimaryJoint = jRec.jointId.valid() && this.m_physicsWorld.isValidJoint(jRec.jointId);
            if(validPrimaryJoint && jRec.jointId.index < cast<u32>(jointCount)){
                mut EcsSlotOwner jOwner = this.m_jointIndexToEntity[jRec.jointId.index];
                jOwner.entity = entity;
                jOwner.generation = jRec.jointId.generation;
                jRec.primaryBroken = false;
            }
            else{
                jRec.jointId = JointId();
            }

            b8 anyValidExtra = false;
            for(usize ei = 0u; ei < jRec.extraJointIds.size(); ++ei){
                const JointId eId = jRec.extraJointIds[ei];
                if(eId.valid() && this.m_physicsWorld.isValidJoint(eId) && eId.index < cast<u32>(jointCount)){
                    mut EcsSlotOwner eOwner = this.m_jointIndexToEntity[eId.index];
                    eOwner.entity = entity;
                    eOwner.generation = eId.generation;
                    anyValidExtra = true;
                    if(ei < jRec.extraBroken.size())
                        jRec.extraBroken[ei] = false;
                }
                else{
                    jRec.extraJointIds[ei] = JointId();
                }
            }

            const b8 entityAlive = this.m_world.alive(entity);
            if(!validPrimaryJoint && !anyValidExtra){
                removeJoints.push_back(entity);
                if(entityAlive){
                    const Optional<mut JointComponent> jcOpt = this.m_world.borrowComponent<JointComponent>(entity);
                    if(jcOpt.has_value()){
                        mut JointComponent jc = jcOpt.value();
                        jc.runtimeJointId = JointId();
                        jc.runtimeExtraJointIds.clear();
                        jc.boundBodyIdA = BodyId();
                        jc.boundBodyIdB = BodyId();
                        jc.boundExtraBodyIdAs.clear();
                        jc.boundExtraBodyIdBs.clear();
                        jc.dirty = true;
                    }
                }
                continue;
            }

            if(entityAlive){
                const Optional<mut JointComponent> jcOpt = this.m_world.borrowComponent<JointComponent>(entity);
                if(jcOpt.has_value()){
                    mut JointComponent jc = jcOpt.value();
                    jc.runtimeJointId = jRec.jointId;
                    jc.runtimeExtraJointIds.clear();
                    for(usize ei = 0u; ei < jRec.extraJointIds.size(); ++ei)
                        jc.runtimeExtraJointIds.push_back(jRec.extraJointIds[ei]);
                }
            }
        }
        for(usize ri = 0u; ri < removeJoints.size(); ++ri)
            this.m_entityJoints.erase(removeJoints[ri]);
        removeJoints.clear();

        Vector<EntityID> sortedIds;

        this.m_activeRagdolls.clear();
        this.m_activeFractures.clear();
        CollectSortedEntities<RagdollComponent>(this.m_world, sortedIds);
        for(usize ri = 0u; ri < sortedIds.size(); ++ri){
            const EntityID entity = sortedIds[ri];
            const Optional<mut RagdollComponent> rcOpt = this.m_world.borrowComponent<RagdollComponent>(entity);
            if(!rcOpt.has_value())
                continue;
            mut RagdollComponent rc = rcOpt.value();
            b8 ragdollValid = (ri < bundle.ragdolls.size()) && !bundle.ragdolls[ri].boneBodies.empty();
            if(ragdollValid){
                for(usize bi = 0u; bi < bundle.ragdolls[ri].boneBodies.size(); ++bi){
                    if(!this.m_physicsWorld.isValidBody(bundle.ragdolls[ri].boneBodies[bi])){
                        ragdollValid = false;
                        break;
                    }
                }
            }
            if(ragdollValid){
                rc.instance = bundle.ragdolls[ri];
                rc.enableSelfCollision = rc.instance.enableSelfCollision;
                rc.disabledSelfCollisionPairs = rc.instance.disabledSelfCollisionPairs;
                rc.initialized = true;
                rc.dirty = false;
                EcsTrackedRagdoll tracked;
                tracked.syncedKinematic = rc.kinematic;
                tracked.syncedKinematicMask = rc.boneKinematicMask;
                tracked.syncedEnableSelfCollision = rc.enableSelfCollision;
                tracked.syncedDisabledSelfCollisionPairs = rc.disabledSelfCollisionPairs;
                tracked.syncedCollisionLayer = rc.collisionLayer;
                ComputeRagdollBoneToJointOffsetsFromDef(rc, tracked.boneToJointLocalOffsets);
                RegisterTrackedRagdollSlots(
                    entity,
                    rc.instance,
                    this.m_physicsWorld,
                    this.m_bodyIndexToEntity,
                    this.m_shapeIndexToEntity,
                    this.m_jointIndexToEntity,
                    tracked
                );
                this.m_activeRagdolls.insert_or_assign(entity, tracked);
            }
            else{
                rc.initialized = false;
                rc.dirty = true;
                rc.instance.reset();
            }
        }

        CollectSortedEntities<VehicleComponent>(this.m_world, sortedIds);
        for(usize vi = 0u; vi < sortedIds.size(); ++vi){
            const Optional<mut VehicleComponent> vcOpt = this.m_world.borrowComponent<VehicleComponent>(sortedIds[vi]);
            if(!vcOpt.has_value())
                continue;
            mut VehicleComponent vc = vcOpt.value();
            if(
                vi < bundle.vehicles.size()
                && bundle.vehicles[vi].chassisBodyId.valid()
                && this.m_physicsWorld.isValidBody(bundle.vehicles[vi].chassisBodyId)
            ){
                vc.controller = bundle.vehicles[vi];
                vc.initialized = true;
                vc.dirty = false;
            }
            else{
                vc.controller = VehicleController();
                vc.initialized = false;
                vc.dirty = true;
            }
        }

        this.m_syncScratch.characterSyncStates.clear();
        CollectSortedEntities<CharacterControllerComponent>(this.m_world, sortedIds);
        for(usize ci = 0u; ci < sortedIds.size(); ++ci){
            const EntityID entity = sortedIds[ci];
            const Optional<mut CharacterControllerComponent> ccOpt = this.m_world.borrowComponent<CharacterControllerComponent>(entity);
            if(!ccOpt.has_value())
                continue;
            mut CharacterControllerComponent cc = ccOpt.value();
            if(ci < bundle.characters.size()){
                cc.controller = bundle.characters[ci];
                cc.initialized = true;
                cc.dirty = false;
                const Transform3D charXf(VectorSingle(cc.controller.position), SafeNormalizeQuat(VectorSingle(cc.controller.rotation)));
                WriteWorldPoseBackToEntityTransform(entity, charXf, this.m_hasAnyPhysicsParents, this.m_world, this.m_syncScratch.writeBackPoseCache);
                EcsCharacterControllerSyncState charSync;
                charSync.prevPosition = cc.controller.position;
                charSync.currPosition = cc.controller.position;
                charSync.prevRotation = cc.controller.rotation;
                charSync.currRotation = cc.controller.rotation;
                charSync.hasPrevSnapshot = true;
                charSync.prevGroundState = cc.controller.groundState;
                charSync.prevGroundBodyId = cc.controller.groundBodyId;
                charSync.hasPrevGroundState = true;
                charSync.prevHitCeiling = cc.controller.hitCeiling;
                this.m_syncScratch.characterSyncStates.insert_or_assign(entity, charSync);
            }
            else{
                cc.initialized = false;
                cc.dirty = true;
            }
        }

        this.m_syncScratch.articulationProxySyncStates.clear();
        this.m_syncScratch.articulationLiveStates.clear();
        CollectSortedEntities<ArticulationComponent>(this.m_world, sortedIds);
        for(usize ai = 0u; ai < sortedIds.size(); ++ai){
            const Optional<mut ArticulationComponent> acOpt = this.m_world.borrowComponent<ArticulationComponent>(sortedIds[ai]);
            if(!acOpt.has_value())
                continue;
            mut ArticulationComponent ac = acOpt.value();
            if(ai < bundle.articulations.size() && !bundle.articulations[ai].linkDefs.empty()){
                ac.articulation = bundle.articulations[ai];
                ac.initialized = true;
                ac.dirty = false;
            }
            else{
                ac.articulation = Articulation();
                ac.initialized = false;
                ac.dirty = true;
            }
        }

        this.m_syncScratch.softBodySyncStates.clear();
        CollectSortedEntities<SoftBodyComponent>(this.m_world, sortedIds);
        for(usize si = 0u; si < sortedIds.size(); ++si){
            const EntityID entity = sortedIds[si];
            const Optional<mut SoftBodyComponent> sbOpt = this.m_world.borrowComponent<SoftBodyComponent>(entity);
            if(!sbOpt.has_value())
                continue;
            mut SoftBodyComponent sb = sbOpt.value();
            if(si < bundle.softBodies.size()){
                sb.softBody = bundle.softBodies[si];
                sb.dirty = false;
                EcsSoftBodySyncState sbSync;
                sbSync.transformApplied = !sb.softBody.particles.empty();
                this.m_syncScratch.softBodySyncStates.insert_or_assign(entity, sbSync);
            }
        }

        CollectSortedEntities<FractureComponent>(this.m_world, sortedIds);
        for(usize fi = 0u; fi < sortedIds.size(); ++fi){
            const EntityID entity = sortedIds[fi];
            const Optional<mut FractureComponent> fcOpt = this.m_world.borrowComponent<FractureComponent>(entity);
            if(!fcOpt.has_value())
                continue;
            mut FractureComponent fc = fcOpt.value();
            b8 fractureValid = (fi < bundle.fractureClusters.size()) && !bundle.fractureClusters[fi].chunks.empty();
            if(fractureValid){
                in FractureClusterBody cand = bundle.fractureClusters[fi];
                b8 anyLiveBody = cand.rootBodyId.valid() && this.m_physicsWorld.isValidBody(cand.rootBodyId);
                if(!anyLiveBody){
                    for(usize di = 0u; di < cand.detachedBodies.size(); ++di){
                        if(cand.detachedBodies[di].valid() && this.m_physicsWorld.isValidBody(cand.detachedBodies[di])){
                            anyLiveBody = true;
                            break;
                        }
                    }
                }
                fractureValid = anyLiveBody;
            }
            if(fractureValid){
                fc.cluster = bundle.fractureClusters[fi];
                fc.initialized = true;
                fc.dirty = false;
                EcsTrackedFracture tracked;
                RegisterTrackedFractureSlots(
                    entity,
                    fc.cluster,
                    this.m_physicsWorld,
                    this.m_bodyIndexToEntity,
                    this.m_shapeIndexToEntity,
                    tracked
                );
                this.m_activeFractures.insert_or_assign(entity, tracked);
            }
            else{
                fc.cluster.clear();
                fc.initialized = false;
                fc.dirty = true;
            }
        }

        const usize currJointCount = this.m_physicsWorld.m_joints.size();
        for(usize ji = 0u; ji < currJointCount; ++ji){
            in Joint j = this.m_physicsWorld.m_joints[ji];
            if(!j.alive())
                continue;
            const b8 owned =
                (ji < this.m_jointIndexToEntity.size())
                && this.m_jointIndexToEntity[ji].entity.valid()
                && this.m_jointIndexToEntity[ji].generation == j.generation
            ;
            if(!owned)
                this.m_physicsWorld.destroyJoint(this.m_physicsWorld.makeJointId(cast<u32>(ji)));
        }

        const usize currBodyCount = this.m_physicsWorld.m_bodies.size();
        for(usize bi = 0u; bi < currBodyCount; ++bi){
            in Body b = this.m_physicsWorld.m_bodies[bi];
            if(!b.alive)
                continue;
            const b8 owned =
                (bi < this.m_bodyIndexToEntity.size())
                && this.m_bodyIndexToEntity[bi].entity.valid()
                && this.m_bodyIndexToEntity[bi].generation == b.generation
            ;
            if(!owned)
                this.m_physicsWorld.destroyBody(this.m_physicsWorld.makeBodyId(cast<u32>(bi)));
        }

        this.m_bodyTransformSnapshots.resize(currBodyCount);
        this.m_bodyTransformSnapshotMeta.resize(currBodyCount, 0u);
        for(usize bi = 0u; bi < currBodyCount; ++bi){
            in Body b = this.m_physicsWorld.m_bodies[bi];
            const BodyId id = this.m_physicsWorld.makeBodyId(cast<u32>(bi));
            if(b.alive && id.valid()){
                const Expected<Transform3D> xf = this.m_physicsWorld.tryGetBodyTransform(id);
                if(xf.has_value())
                    SetBodyTransformSnapshotBoth(id, xf.value(), this.m_bodyTransformSnapshots, this.m_bodyTransformSnapshotMeta);
                else
                    this.m_bodyTransformSnapshotMeta[bi] = 0u;
            }
            else{
                this.m_bodyTransformSnapshotMeta[bi] = 0u;
            }
        }

        WriteBackEcsRagdollRootPoses(
            this.m_physicsWorld,
            this.m_scopedNames,
            this.m_activeRagdolls,
            this.m_bodyTransformSnapshots,
            this.m_bodyTransformSnapshotMeta,
            false,
            1.0f,
            this.m_hasAnyPhysicsParents,
            this.m_world,
            this.m_syncScratch
        );
        WriteBackEcsVehicleWheelPoses(
            this.m_physicsWorld,
            this.m_scopedNames,
            this.m_bodyTransformSnapshots,
            this.m_bodyTransformSnapshotMeta,
            false,
            1.0f,
            true,
            this.m_hasAnyPhysicsParents,
            this.m_world,
            this.m_syncScratch
        );
        WriteBackEcsArticulationPoses(
            this.m_physicsWorld,
            this.m_scopedNames,
            this.m_bodyIndexToEntity,
            false,
            1.0f,
            true,
            this.m_hasAnyPhysicsParents,
            this.m_world,
            this.m_syncScratch
        );

        this.m_physicsWorld.consumePendingEndEvents(this.m_frameContactEndEvents, this.m_frameSensorEndEvents);
        this.m_physicsWorld.consumePendingWakeEvents(this.m_frameBodyWakeEvents);
        this.clearFrameEvents();
        this.m_syncScratch.writeBackPoseCache.clear();
        this.m_gpuDispatcher.invalidateWorldCaches();
        ClearDestroyedSlotOwners(this.m_syncScratch);
        this.m_syncScratch.vehicleEventSyncStates.clear();
        this.m_syncScratch.ecsFluidImmersionState.clear();
        this.m_syncScratch.ecsFluidSamplesScratch.clear();
        this.m_syncScratch.ecsFluidSplashScratch.clear();
        this.m_syncScratch.activeFluidEntitiesById.clear();
        this.m_syncScratch.seenFluidIdsThisStep.clear();
        this.m_syncScratch.csgColliderStates.clear();
        this.m_syncScratch.envFluidEntitiesScratch.clear();
        this.m_syncScratch.bodySyncedPoses.clear();
        this.m_syncScratch.staticBodyPoseCache.clear();
        this.m_syncScratch.colliderScaleCache.clear();
        this.m_syncScratch.syncedParentNames.clear();
        this.m_syncScratch.pendingWriteBackBodyIndices.clear();
        this.m_syncScratch.prevAwakeWriteBackBodyIndices.clear();
        this.m_syncScratch.nextAwakeWriteBackBodyIndices.clear();
        this.m_syncScratch.dirtyPrevSnapshotBodyIndices.clear();
        this.m_syncScratch.drivenKinematicEntries.clear();
        this.m_syncScratch.kinematicTargets.clear();
        ClearMovedStaticBodies(this.m_syncScratch.movedStaticBodyFlags, this.m_syncScratch.movedStaticBodyIndices);
        this.m_syncScratch.hasSyncedTopologyVersion = false;
        this.m_syncScratch.hasRagdollTopology = false;
        this.m_syncScratch.mutationVersionsValid = false;
        this.m_syncScratch.tagPrepassVersionsValid = false;
        this.m_accumulator = 0.0f;
        this.m_interpolationAlpha = 1.0f;
        return true;
    }

    public void setCollisionLayerMatrix(in CollisionLayerMatrix matrix){
        this.m_collisionLayerMatrix = matrix;
        this.m_syncScratch.collisionLayerMatrixChanged = true;
    }

    public in CollisionLayerMatrix collisionLayerMatrix()const{
        return this.m_collisionLayerMatrix;
    }

    public b8 loadCollisionLayerMatrixAsset(in AssetRef<CollisionLayerMatrixAsset> assetRef){
        if(!assetRef.valid() || !this.m_assetManager.has_value())
            return false;
        const auto loaded = LoadTypedAssetSync<CollisionLayerMatrixAsset>(this.m_assetManager.value(), assetRef.name(), "PhysicsSystem");
        if(!loaded.has_value())
            return false;
        this.m_collisionLayerMatrix = loaded.value().deref().layerMatrix();
        this.m_syncScratch.collisionLayerMatrixChanged = true;
        return true;
    }

    public Filter makeLayerFilter(in u32 layerIdx, in i32 groupIndex)const{
        return this.m_collisionLayerMatrix.makeFilter(layerIdx, groupIndex);
    }

    public Filter makeLayerFilterByName(in Name layerName, in i32 groupIndex)const{
        return this.m_collisionLayerMatrix.makeFilterByName(layerName, groupIndex);
    }

    public b8 dispatchGpuBatchSpatialQueries(
        in Span<GpuPhysicsSpatialQuery> queries,
        mut Vector<GpuPhysicsSpatialQueryResult> outResults
    ){
        return this.m_gpuDispatcher.dispatchBatchSpatialQueries(this.m_physicsWorld, queries, outResults);
    }

    public b8 castShapeBatchGpu(
        in Span<ShapeProxy> queryProxies,
        in Span<ShapeCastInput> inputs,
        mut Vector<GpuPhysicsSpatialQueryResult> outResults
    ){
        return this.m_gpuDispatcher.castShapeBatchGpu(this.m_physicsWorld, queryProxies, inputs, outResults);
    }

    public b8 overlapShapeBatchGpu(
        in Span<ShapeProxy> queryProxies,
        in Span<Transform3D> queryTransforms,
        in Filter filter,
        in b8 hitSensors,
        mut Vector<GpuPhysicsSpatialQueryResult> outResults,
        mut Vector<GpuPhysicsSpatialQueryResult> outMultiHits,
        in u32 maxHitsPerQuery
    ){
        return this.m_gpuDispatcher.overlapShapeBatchGpu(this.m_physicsWorld, queryProxies, queryTransforms, filter, hitSensors, outResults, outMultiHits, maxHitsPerQuery);
    }

    public b8 overlapShapeBatchGpu(
        in Span<ShapeProxy> queryProxies,
        in Span<Transform3D> queryTransforms,
        in Filter filter,
        in b8 hitSensors,
        mut Vector<GpuPhysicsSpatialQueryResult> outResults
    ){
        return this.m_gpuDispatcher.overlapShapeBatchGpu(this.m_physicsWorld, queryProxies, queryTransforms, filter, hitSensors, outResults);
    }

    public b8 stepGpuResidentBodies(in f32 dt, in u32 subStepCount, in b8 readbackToWorld){
        const b8 ok = this.m_gpuDispatcher.stepGpuResidentBodies(this.m_physicsWorld, dt, subStepCount, readbackToWorld);
        if(ok){
            this.m_lastStepStats = this.m_physicsWorld.lastStepStats();
            this.m_lastStepTopologyVersion = this.m_physicsWorld.m_topologyVersion;
        }
        return ok;
    }

    public void reset(){
        this.m_physicsWorld.clear();
        this.m_gpuDispatcher.invalidateWorldCaches();
        this.m_collisionLayerMatrix = CollisionLayerMatrix();
        this.m_preStepCallback.reset();
        this.clearEventCallbacks();
        this.m_entityRecords.clear();
        this.m_entityJoints.clear();
        this.m_activeRagdolls.clear();
        this.m_activeFractures.clear();
        this.m_environmentScratch = PhysicsEnvironment();
        this.m_bodyTransformSnapshots.clear();
        this.m_bodyTransformSnapshotMeta.clear();
        this.m_bodyIndexToEntity.clear();
        this.m_shapeIndexToEntity.clear();
        this.m_jointIndexToEntity.clear();
        this.m_scopedNames = EcsScopedEntityNames();
        this.m_syncedRigidBodyTags.clear();
        this.m_syncedColliderTags.clear();
        this.m_syncScratch = EcsPhysicsSyncScratch();
        ReleaseEcsPhysicsAssetCache(this.m_assetCache, this.m_physicsWorld, false);
        this.m_exportBindingsScratch.clear();
        this.m_gpuResidentEventsScratch.clear();
        this.m_prevGpuResidentContactPairs.clear();
        this.m_currGpuResidentContactPairs.clear();
        this.m_prevGpuResidentSensorPairs.clear();
        this.m_currGpuResidentSensorPairs.clear();
        this.m_pendingCpuWakeBodiesScratch.clear();
        this.clearFrameEvents();
        this.m_publishEventsToMessageBus = false;
        this.m_publishContinuousEventsToMessageBus = false;
        this.m_cfgPublishEventsToMessageBus = false;
        this.m_cfgPublishContinuousEventsToMessageBus = false;
        this.m_accumulator = 0.0f;
        this.m_interpolationAlpha = 1.0f;
        this.m_pendingSingleStep = false;
        this.m_hasAnyPhysicsParents = false;
        this.m_lastStepStats = WorldStepStats();
        this.m_lastStepMs = 0.0;
        this.m_lastStepTopologyVersion = 0u;
    }

    private void collectEcsExportBindings(){
        const b8 hasAnyPhysicsParents = AnyPhysicsHierarchyActive(this.m_world);
        if(hasAnyPhysicsParents)
            this.m_syncScratch.writeBackPoseCache.clear();
        const b8 bodyHandlesTrusted = this.m_syncScratch.hasSyncedTopologyVersion && (this.m_physicsWorld.m_topologyVersion == this.m_syncScratch.lastSyncedTopologyVersion);
        CollectEcsGpuRenderTransformBindings(this.m_world, this.m_entityRecords, this.m_bodyIndexToEntity, hasAnyPhysicsParents, bodyHandlesTrusted, this.m_syncScratch.writeBackPoseCache, this.m_physicsWorld, this.m_exportBindingsScratch);
    }

    public b8 exportRenderTransforms(mut Vector<GpuPhysicsRenderTransformOut> outTransforms){
        this.collectEcsExportBindings();
        return this.m_gpuDispatcher.exportRenderTransforms(
            this.m_physicsWorld,
            Span<GpuPhysicsRenderTransformBinding>(this.m_exportBindingsScratch.data(), this.m_exportBindingsScratch.size()),
            outTransforms
        );
    }

    public b8 exportRenderTransformsToBuffer(
        mut BufferHandle targetBuffer,
        in u32 targetUavSlot,
        in u32 instanceStrideFloat4
    ){
        this.collectEcsExportBindings();
        return this.m_gpuDispatcher.exportRenderTransformsToBuffer(
            this.m_physicsWorld,
            Span<GpuPhysicsRenderTransformBinding>(this.m_exportBindingsScratch.data(), this.m_exportBindingsScratch.size()),
            targetBuffer,
            targetUavSlot,
            instanceStrideFloat4
        );
    }

    public b8 exportRenderTransformsToBufferAsync(
        mut BufferHandle targetBuffer,
        in u32 targetUavSlot,
        in u32 instanceStrideFloat4,
        mut QueueSubmissionToken outToken
    ){
        this.collectEcsExportBindings();
        return this.m_gpuDispatcher.exportRenderTransformsToBufferAsync(
            this.m_physicsWorld,
            Span<GpuPhysicsRenderTransformBinding>(this.m_exportBindingsScratch.data(), this.m_exportBindingsScratch.size()),
            targetBuffer,
            targetUavSlot,
            instanceStrideFloat4,
            outToken
        );
    }

    public b8 syncGpuResidentToWorld(){
        if(!this.m_gpuDispatcher.isGpuResidentDirtyCpu())
            return true;
        this.m_gpuDispatcher.syncGpuResidentToWorld(this.m_physicsWorld);
        PreparePrevEcsBodyTransformSnapshots(
            this.m_physicsWorld,
            this.m_physicsWorld.bodyMoveEvents(),
            this.m_syncScratch.dirtyPrevSnapshotBodyIndices,
            this.m_syncScratch.snapshotBodyStamps,
            this.m_syncScratch.snapshotStamp,
            this.m_bodyTransformSnapshots,
            this.m_bodyTransformSnapshotMeta
        );
        WriteBackPhysicsTransformsToEcs(
            this.m_physicsWorld,
            this.m_physicsWorld.bodyMoveEvents(),
            this.m_bodyIndexToEntity,
            this.m_hasAnyPhysicsParents,
            true,
            false,
            1.0f,
            this.m_world,
            this.m_syncScratch,
            this.m_bodyTransformSnapshots,
            this.m_bodyTransformSnapshotMeta
        );
        return true;
    }

    public b8 prepareInstanceTransformPatches()override{
        const u32 bodyCount = this.m_physicsWorld.activeBodyCount();
        const u32 exportCount = cast<u32>(this.m_world.view<GpuRenderTransformExportComponent>().candidateCount());
        const u32 recordCount = cast<u32>(this.m_entityRecords.size());
        const u32 estimatedBindings = Max(Max(bodyCount, exportCount), recordCount);
        return this.m_gpuDispatcher.beginRenderExportFrame(estimatedBindings * 12u, estimatedBindings * 6u);
    }

    public Expected<GpuTaskId> declareInstanceTransformPatch(
        in GpuTaskGraphInstanceTransformPatchRequest request,
        in Span<u32> instanceEntityIds,
        mut GpuTaskGraph graph
    )override{
        u32 exportMode = s_GpuExportModePatchInstanceBuffer;
        if(request.layout == GpuTaskGraphInstanceTransformPatchLayout::Affine3x4ObjectToWorld)
            exportMode = s_GpuExportModePatchAffine3x4ObjToWorld;
        else if(request.layout == GpuTaskGraphInstanceTransformPatchLayout::Affine3x4WorldToObject)
            exportMode = s_GpuExportModePatchAffine3x4WorldToObj;
        else if(request.layout != GpuTaskGraphInstanceTransformPatchLayout::InstanceTrs)
            return MakeUnexpected(Failure());

        const b8 hasAnyPhysicsParents = AnyPhysicsHierarchyActive(this.m_world);
        if(hasAnyPhysicsParents)
            this.m_syncScratch.writeBackPoseCache.clear();
        const b8 bodyHandlesTrusted = this.m_syncScratch.hasSyncedTopologyVersion && (this.m_physicsWorld.m_topologyVersion == this.m_syncScratch.lastSyncedTopologyVersion);
        CollectEcsPassGpuRenderTransformBindings(
            instanceEntityIds,
            this.m_entityRecords,
            this.m_bodyIndexToEntity,
            hasAnyPhysicsParents,
            bodyHandlesTrusted,
            this.m_physicsWorld,
            this.m_gpuDispatcher,
            this.m_world,
            this.m_syncScratch.writeBackPoseCache,
            this.m_exportBindingsScratch
        );
        if(this.m_exportBindingsScratch.empty())
            return Expected<GpuTaskId>(request.dependency);

        GpuTaskId outTaskId;
        if(!this.m_gpuDispatcher.declareExportRenderTransformsTask(
            graph,
            this.m_physicsWorld,
            Span<GpuPhysicsRenderTransformBinding>(this.m_exportBindingsScratch.data(), this.m_exportBindingsScratch.size()),
            request.instanceBufferResource,
            request.instanceBufferUavSlot,
            request.instanceStrideFloat4,
            exportMode,
            request.baseFloat4Offset,
            request.passIdentityPrefix,
            request.mergeWithPrevious,
            request.allowMergeAcrossConsumerFrontier,
            request.dependency,
            outTaskId
        ))
            return MakeUnexpected(Failure());
        return Expected<GpuTaskId>(outTaskId);
    }

    public b8 declareExportRenderTransformsTask(
        mut GpuTaskGraph graph,
        in GpuGraphResourceId targetResource,
        in u32 targetUavSlot,
        in u32 instanceStrideFloat4,
        in u32 exportMode,
        in u32 baseFloat4Offset,
        in Name passIdentityPrefix,
        in b8 mergeWithPrevious,
        in b8 allowMergeAcrossConsumerFrontier,
        in GpuTaskId dependency,
        mut GpuTaskId outTaskId
    ){
        this.collectEcsExportBindings();
        return this.m_gpuDispatcher.declareExportRenderTransformsTask(
            graph,
            this.m_physicsWorld,
            Span<GpuPhysicsRenderTransformBinding>(this.m_exportBindingsScratch.data(), this.m_exportBindingsScratch.size()),
            targetResource,
            targetUavSlot,
            instanceStrideFloat4,
            exportMode,
            baseFloat4Offset,
            passIdentityPrefix,
            mergeWithPrevious,
            allowMergeAcrossConsumerFrontier,
            dependency,
            outTaskId
        );
    }

    private void processGpuResidentStepEvents(mut World world){
        this.m_physicsWorld.m_inStep = true;
        this.m_physicsWorld.m_bodyMoveEvents.clear();
        this.m_physicsWorld.m_contactBeginEvents.clear();
        this.m_physicsWorld.m_contactEndEvents.clear();
        this.m_physicsWorld.m_contactPersistEvents.clear();
        this.m_physicsWorld.m_contactHitEvents.clear();
        this.m_physicsWorld.m_sensorBeginEvents.clear();
        this.m_physicsWorld.m_sensorEndEvents.clear();
        this.m_physicsWorld.m_sensorStayEvents.clear();
        this.m_physicsWorld.m_bodyWakeEvents.clear();
        this.m_physicsWorld.consumePendingEndEvents(this.m_physicsWorld.m_contactEndEvents, this.m_physicsWorld.m_sensorEndEvents);
        this.m_physicsWorld.consumePendingWakeEvents(this.m_physicsWorld.m_bodyWakeEvents);
        this.m_physicsWorld.m_jointBreakEvents.clear();

        this.m_currGpuResidentContactPairs.clear();
        this.m_currGpuResidentSensorPairs.clear();
        this.m_pendingCpuWakeBodiesScratch.clear();

        b8 needsCpuFallbackSync = false;
        for(usize ei = 0u; ei < this.m_gpuResidentEventsScratch.size(); ++ei){
            in GpuPhysicsEvent ev = this.m_gpuResidentEventsScratch[ei];
            const u32 evType = ev.header.x;
            if(evType == s_GpuEventContactActive){
                const u32 sA = ev.header.y;
                const u32 sB = ev.header.z;
                u32 loS = sA;
                u32 hiS = sB;
                if(sB < sA){
                    loS = sB;
                    hiS = sA;
                }
                const u64 pairKey = (cast<u64>(loS) << 32u) | cast<u64>(hiS);
                const u64 bodiesVal = (cast<u64>(ev.bodyIds.x) << 32u) | cast<u64>(ev.bodyIds.y);
                this.m_currGpuResidentContactPairs.insert_or_assign(pairKey, bodiesVal);
            }
            else if(evType == s_GpuEventSensorOverlap){
                const u32 sA = ev.header.y;
                const u32 sB = ev.header.z;
                u32 sensorId = sA;
                u32 visitorId = sB;
                const b8 aIsSensor = (sensorId < this.m_physicsWorld.m_shapes.size() && this.m_physicsWorld.m_shapes[sensorId].isSensor());
                const b8 bIsSensor = (visitorId < this.m_physicsWorld.m_shapes.size() && this.m_physicsWorld.m_shapes[visitorId].isSensor());
                if(!aIsSensor && bIsSensor){
                    sensorId = sB;
                    visitorId = sA;
                }
                else if(aIsSensor && bIsSensor && sB < sA){
                    sensorId = sB;
                    visitorId = sA;
                }
                const u64 pairKey = (cast<u64>(sensorId) << 32u) | cast<u64>(visitorId);
                const u64 bodiesVal = (cast<u64>(ev.bodyIds.x) << 32u) | cast<u64>(ev.bodyIds.y);
                this.m_currGpuResidentSensorPairs.insert_or_assign(pairKey, bodiesVal);
            }
            else if(evType == s_GpuEventContactHit){
                ContactHitEvent hitEv;
                hitEv.shapeIdA = this.m_physicsWorld.makeShapeId(ev.header.y);
                hitEv.shapeIdB = this.m_physicsWorld.makeShapeId(ev.header.z);
                hitEv.point = ev.pointImpulse;
                hitEv.normalApproachSpeed = ev.normalApproach;
                this.m_physicsWorld.m_contactHitEvents.push_back(hitEv);
            }
            else if(evType == s_GpuEventJointBreak){
                const u32 jIdx = ev.header.y;
                if(jIdx < this.m_physicsWorld.m_joints.size() && this.m_physicsWorld.m_joints[jIdx].alive()){
                    in Joint jRef = this.m_physicsWorld.m_joints[jIdx];
                    JointBreakEvent jbEv;
                    jbEv.jointId = this.m_physicsWorld.makeJointId(jIdx);
                    jbEv.bodyIdA = this.m_physicsWorld.makeBodyId(jRef.edges[0u].bodyId);
                    jbEv.bodyIdB = this.m_physicsWorld.makeBodyId(jRef.edges[1u].bodyId);
                    jbEv.userData = jRef.userData;
                    jbEv.peakForce = ev.pointImpulse.w;
                    jbEv.peakTorque = ev.normalApproach.w;
                    this.m_physicsWorld.m_jointBreakEvents.push_back(jbEv);
                    this.m_physicsWorld.destroyJointInternal(jIdx);
                }
            }
            else if(evType == s_GpuEventBodySleep){
                const u32 bodyId = this.m_gpuDispatcher.residentBodyIdAtSlot(ev.header.y);
                if(bodyId < this.m_physicsWorld.m_bodies.size() && this.m_physicsWorld.m_bodies[bodyId].alive){
                    BodyWakeEvent sleepEv;
                    sleepEv.bodyId = this.m_physicsWorld.makeBodyId(bodyId);
                    sleepEv.userData = this.m_physicsWorld.m_bodies[bodyId].userData;
                    sleepEv.awake = false;
                    this.m_physicsWorld.m_bodyWakeEvents.push_back(sleepEv);
                }
            }
            else if(evType == s_GpuEventBodyWake){
                if((ev.header.w & s_GpuEventFlagCpuSleepWake) != 0u){
                    this.m_pendingCpuWakeBodiesScratch.push_back(ev.header.y);
                }
                else{
                    const u32 bodyId = this.m_gpuDispatcher.residentBodyIdAtSlot(ev.header.y);
                    if(bodyId < this.m_physicsWorld.m_bodies.size() && this.m_physicsWorld.m_bodies[bodyId].alive){
                        BodyWakeEvent wakeEv;
                        wakeEv.bodyId = this.m_physicsWorld.makeBodyId(bodyId);
                        wakeEv.userData = this.m_physicsWorld.m_bodies[bodyId].userData;
                        wakeEv.awake = true;
                        this.m_physicsWorld.m_bodyWakeEvents.push_back(wakeEv);
                    }
                }
            }
            else if(evType == s_GpuEventFluidSplash){
                FluidSplashEvent fsEv;
                fsEv.type = cast<FluidSplashEventType>(ev.header.w & 3u);
                const u32 bodyId = this.m_gpuDispatcher.residentBodyIdAtSlot(ev.header.y);
                if(bodyId < this.m_physicsWorld.m_bodies.size())
                    fsEv.bodyId = this.m_physicsWorld.makeBodyId(bodyId);
                fsEv.fluidIndex = ev.header.z;
                fsEv.submergedFraction = ev.pointImpulse.w;
                fsEv.impactSpeed = ev.normalApproach.w;
                fsEv.point = f32x4(ev.pointImpulse.x, ev.pointImpulse.y, ev.pointImpulse.z, 0.0f);
                fsEv.normal = f32x4(ev.normalApproach.x, ev.normalApproach.y, ev.normalApproach.z, 0.0f);
                EcsFluidSplashEvent ecsSplash;
                ecsSplash.bodyEntity = this.resolveEcsEventBodyEntity(fsEv.bodyId, true);
                if(cast<usize>(fsEv.fluidIndex) < this.m_syncScratch.envFluidEntitiesScratch.size())
                    ecsSplash.fluidEntity = this.m_syncScratch.envFluidEntitiesScratch[cast<usize>(fsEv.fluidIndex)];
                ecsSplash.event = fsEv;
                this.m_syncScratch.frameFluidSplashEvents.push_back(ecsSplash);
            }
            else if(evType == s_GpuEventCpuFallback){
                needsCpuFallbackSync = true;
            }
        }

        for(in auto kv : this.m_currGpuResidentContactPairs){
            const u64 k = kv.first;
            const u32 loS = cast<u32>((k >> 32u) & 0xffffffffu);
            const u32 hiS = cast<u32>(k & 0xffffffffu);
            if(this.m_prevGpuResidentContactPairs.find(k) == this.m_prevGpuResidentContactPairs.end()){
                ContactBeginTouchEvent ev;
                ev.shapeIdA = this.m_physicsWorld.makeShapeId(loS);
                ev.shapeIdB = this.m_physicsWorld.makeShapeId(hiS);
                this.m_physicsWorld.m_contactBeginEvents.push_back(ev);
            }
            else{
                ContactPersistEvent ev;
                ev.shapeIdA = this.m_physicsWorld.makeShapeId(loS);
                ev.shapeIdB = this.m_physicsWorld.makeShapeId(hiS);
                this.m_physicsWorld.m_contactPersistEvents.push_back(ev);
            }
        }
        for(in auto kv : this.m_prevGpuResidentContactPairs){
            const u64 k = kv.first;
            if(this.m_currGpuResidentContactPairs.find(k) == this.m_currGpuResidentContactPairs.end()){
                const u32 loS = cast<u32>((k >> 32u) & 0xffffffffu);
                const u32 hiS = cast<u32>(k & 0xffffffffu);
                ContactEndTouchEvent ev;
                ev.shapeIdA = this.m_physicsWorld.makeShapeId(loS);
                ev.shapeIdB = this.m_physicsWorld.makeShapeId(hiS);
                this.m_physicsWorld.m_contactEndEvents.push_back(ev);
            }
        }
        this.m_prevGpuResidentContactPairs.clear();
        for(in auto kv : this.m_currGpuResidentContactPairs)
            this.m_prevGpuResidentContactPairs.insert_or_assign(kv.first, kv.second);

        for(in auto kv : this.m_currGpuResidentSensorPairs){
            const u64 k = kv.first;
            const u32 sId = cast<u32>((k >> 32u) & 0xffffffffu);
            const u32 vId = cast<u32>(k & 0xffffffffu);
            if(this.m_prevGpuResidentSensorPairs.find(k) == this.m_prevGpuResidentSensorPairs.end()){
                SensorBeginTouchEvent ev;
                ev.sensorShapeId = this.m_physicsWorld.makeShapeId(sId);
                ev.visitorShapeId = this.m_physicsWorld.makeShapeId(vId);
                this.m_physicsWorld.m_sensorBeginEvents.push_back(ev);
            }
            else{
                SensorStayEvent ev;
                ev.sensorShapeId = this.m_physicsWorld.makeShapeId(sId);
                ev.visitorShapeId = this.m_physicsWorld.makeShapeId(vId);
                this.m_physicsWorld.m_sensorStayEvents.push_back(ev);
            }
        }
        for(in auto kv : this.m_prevGpuResidentSensorPairs){
            const u64 k = kv.first;
            if(this.m_currGpuResidentSensorPairs.find(k) == this.m_currGpuResidentSensorPairs.end()){
                const u32 sId = cast<u32>((k >> 32u) & 0xffffffffu);
                const u32 vId = cast<u32>(k & 0xffffffffu);
                SensorEndTouchEvent ev;
                ev.sensorShapeId = this.m_physicsWorld.makeShapeId(sId);
                ev.visitorShapeId = this.m_physicsWorld.makeShapeId(vId);
                this.m_physicsWorld.m_sensorEndEvents.push_back(ev);
            }
        }
        this.m_prevGpuResidentSensorPairs.clear();
        for(in auto kv : this.m_currGpuResidentSensorPairs)
            this.m_prevGpuResidentSensorPairs.insert_or_assign(kv.first, kv.second);

        this.m_physicsWorld.m_inStep = false;
        if(!this.m_pendingCpuWakeBodiesScratch.empty() || needsCpuFallbackSync){
            this.syncGpuResidentToWorld();
            for(usize wi = 0u; wi < this.m_pendingCpuWakeBodiesScratch.size(); ++wi){
                const u32 wakeBodyId = this.m_pendingCpuWakeBodiesScratch[wi];
                if(wakeBodyId < this.m_physicsWorld.m_bodies.size() && this.m_physicsWorld.m_bodies[wakeBodyId].alive)
                    this.m_physicsWorld.wakeBody(this.m_physicsWorld.makeBodyId(wakeBodyId));
            }
            this.m_physicsWorld.m_pendingBodyWakeEvents.clear();
        }
    }

    public b8 readbackGpuResidentEvents(mut Vector<GpuPhysicsEvent> outEvents){
        return this.m_gpuDispatcher.readbackGpuResidentEvents(this.m_physicsWorld, outEvents);
    }

    public b8 stepGpuBulletToiResident(in f32 dt){
        return this.m_gpuDispatcher.stepGpuBulletToiResident(this.m_physicsWorld, dt);
    }

    public b8 stepSoftBodyGpu(
        mut SoftBody softBody,
        in Optional<in PhysicsEnvironment> env,
        in f32 dt,
        in b8 readbackToSoftBody,
        in Optional<in SoftBodyGpuDeformTarget> deformTarget
    ){
        return this.m_gpuDispatcher.stepSoftBodyGpu(softBody, this.m_physicsWorld, env, dt, readbackToSoftBody, deformTarget);
    }

    public b8 applyEnvironmentGpu(in PhysicsEnvironment env, in f32 dt){
        return this.m_gpuDispatcher.applyEnvironmentGpu(this.m_physicsWorld, env, dt);
    }

    public b8 applyExplosionGpu(
        in VectorSingle origin,
        in f32 radius,
        in f32 impulse,
        in f32 upwardBias,
        in f32 falloffPower,
        in b8 readbackToWorld,
        in Filter filter
    ){
        return this.m_gpuDispatcher.applyExplosionGpu(this.m_physicsWorld, origin, radius, impulse, upwardBias, falloffPower, readbackToWorld, filter);
    }

    public b8 applyExplosion(in ExplosionDef def){
        if(def.radius <= 0.0f)
            return true;
        const b8 canUseGpu =
            (this.m_gpuDispatcher.isGpuResidentDirtyCpu()
                || (this.m_physicsWorld.m_def.gpuResidentMode && this.m_physicsWorld.m_backendMode != PhysicsBackendMode::CpuOnly))
            && !def.checkOcclusion
            && this.m_gpuDispatcher.isReady()
        ;
        if(canUseGpu){
            Filter f;
            if(def.useCustomFilter)
                f = def.filter;
            if(this.m_gpuDispatcher.applyExplosionGpu(this.m_physicsWorld, VectorSingle(def.position), def.radius, def.impulsePerLength, 0.0f, def.falloff, false, f))
                return true;
        }
        if(this.m_gpuDispatcher.isGpuResidentDirtyCpu())
            this.syncGpuResidentToWorld();
        this.m_physicsWorld.explode(def);
        return true;
    }

    public void setActiveSceneSubsystems(in ActiveSceneSubsystemsRef subsystems){
        this.m_gpuDispatcher.setActiveSceneSubsystems(subsystems);
    }

    public b8 validateResources(){
        const b8 ok = this.m_gpuDispatcher.validateResources();
        if(!ok)
            warning("PhysicsSystem: GPU physics pipelines unavailable; falling back to CPU solver");
        return ok;
    }

    public void invalidateResources(){
        this.m_gpuDispatcher.invalidateResources();
    }

    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta)override{
        ClearDestroyedSlotOwners(this.m_syncScratch);
        this.clearFrameEvents();

        f32 fixedDt = 1.0f / 60.0f;
        u32 subStepCount = 4u;
        u32 maxSubStepsPerFrame = 4u;
        b8 paused = false;
        b8 interpolateTransforms = false;
        b8 hasConfig = false;
        b8 cfgPublishEventsToMessageBus = false;
        b8 cfgPublishContinuousEventsToMessageBus = false;
        ResolvePhysicsConfigSettings(
            world,
            this.m_physicsWorld,
            this.m_assetManager,
            this.m_collisionLayerMatrix,
            this.m_syncScratch,
            fixedDt,
            subStepCount,
            maxSubStepsPerFrame,
            paused,
            interpolateTransforms,
            hasConfig,
            cfgPublishEventsToMessageBus,
            cfgPublishContinuousEventsToMessageBus
        );
        this.m_cfgPublishEventsToMessageBus = hasConfig && cfgPublishEventsToMessageBus;
        this.m_cfgPublishContinuousEventsToMessageBus = hasConfig && cfgPublishContinuousEventsToMessageBus;
        if((!this.m_physicsWorld.m_def.gpuResidentMode || this.m_physicsWorld.m_backendMode == PhysicsBackendMode::CpuOnly) && this.m_gpuDispatcher.isGpuResidentDirtyCpu())
            this.syncGpuResidentToWorld();

        const b8 collisionLayerMatrixDirty = this.m_syncScratch.collisionLayerMatrixChanged;
        b8 hasAnyPhysicsParents = false;
        b8 hasDrivenKinematic = false;
        SyncEcsCsgColliderDeforms(
            this.m_assetManager,
            AnyPhysicsHierarchyActive(world),
            this.m_csgShapeRegistry,
            world,
            this.m_syncScratch
        );
        SyncEcsEntitiesToPhysicsWorld(
            this.m_assetManager,
            this.m_collisionLayerMatrix,
            this.m_assetCache,
            world,
            this.m_physicsWorld,
            this.m_entityRecords,
            this.m_entityJoints,
            this.m_bodyIndexToEntity,
            this.m_shapeIndexToEntity,
            this.m_jointIndexToEntity,
            this.m_scopedNames,
            this.m_syncedRigidBodyTags,
            this.m_syncedColliderTags,
            this.m_bodyTransformSnapshots,
            this.m_bodyTransformSnapshotMeta,
            this.m_syncScratch,
            hasAnyPhysicsParents,
            hasDrivenKinematic
        );
        this.m_hasAnyPhysicsParents = hasAnyPhysicsParents;
        PruneRemovedEcsRagdolls(
            world,
            this.m_physicsWorld,
            this.m_activeRagdolls,
            this.m_bodyIndexToEntity,
            this.m_shapeIndexToEntity,
            this.m_jointIndexToEntity,
            this.m_syncScratch.deadRagdolls
        );
        PruneRemovedEcsFractures(
            world,
            this.m_physicsWorld,
            this.m_activeFractures,
            this.m_bodyIndexToEntity,
            this.m_shapeIndexToEntity,
            this.m_syncScratch.deadRagdolls
        );

        const b8 runSingleStep = this.m_pendingSingleStep;
        this.m_pendingSingleStep = false;

        if((paused && !runSingleStep) || (!runSingleStep && (!IsFinite(VectorSingle(delta)) || delta <= 0.0f))){
            if(this.m_physicsWorld.m_topologyVersion != this.m_lastStepTopologyVersion){
                this.m_lastStepStats = WorldStepStats();
                this.m_lastStepMs = 0.0;
                this.m_lastStepTopologyVersion = this.m_physicsWorld.m_topologyVersion;
            }
            this.m_lastStepStats.bodyCount = this.m_physicsWorld.activeBodyCount();
            this.m_lastStepStats.awakeBodyCount = this.m_physicsWorld.awakeBodyCount();
            this.m_lastStepStats.shapeCount = this.m_physicsWorld.activeShapeCount();
            this.m_lastStepStats.contactCount = cast<u32>(this.m_physicsWorld.m_pairContactMap.size());
            this.m_lastStepStats.jointCount = this.m_physicsWorld.activeJointCount();
            u32 aliveIslands = 0u;
            for(usize ii = 0u; ii < this.m_physicsWorld.m_islands.size(); ++ii){
                if(this.m_physicsWorld.m_islands[ii].alive)
                    ++aliveIslands;
            }
            this.m_lastStepStats.islandCount = aliveIslands;
            this.m_physicsWorld.consumePendingEndEvents(this.m_frameContactEndEvents, this.m_frameSensorEndEvents);
            this.m_physicsWorld.consumePendingWakeEvents(this.m_frameBodyWakeEvents);
            this.dispatchFrameEventCallbacks();
            this.publishFrameEventsToMessageBus(world);
            return Expected<void, CpuTaskAdmissionError>();
        }

        u32 maxAllowedSteps = maxSubStepsPerFrame;
        if(runSingleStep){
            this.m_accumulator = fixedDt;
            maxAllowedSteps = 1u;
        }
        else{
            const f32 clampedDelta = Min(delta, fixedDt * cast<f32>(maxSubStepsPerFrame));
            this.m_accumulator += clampedDelta;
        }

        u32 plannedSteps = 0u;
        f32 simAccum = this.m_accumulator;
        while(simAccum + 1.0e-6f >= fixedDt && plannedSteps < maxAllowedSteps){
            if(simAccum >= fixedDt)
                simAccum -= fixedDt;
            else
                simAccum = 0.0f;
            ++plannedSteps;
        }

        const b8 useCollectedEnv = plannedSteps > 1u;
        const auto fluidCheckView = world.view<FluidVolumeComponent>();
        const auto fieldCheckView = world.view<ForceFieldComponent>();
        const b8 hasAnyEnvEntities = fluidCheckView.candidateCount() > 0u || fieldCheckView.candidateCount() > 0u;
        b8 allFluidsGpuSupported = true;
        if(fluidCheckView.candidateCount() > 0u){
            fluidCheckView.each(
                lambda[mut allFluidsGpuSupported](in EntityID ent, in FluidVolumeComponent fvc) -> void{
                    if(fvc.enabled && fvc.volume.enabled && !IsGpuSupportedFluidVolume(fvc.volume))
                        allFluidsGpuSupported = false;
                }
            );
        }

        const b8 gpuResidentEligible =
            this.m_physicsWorld.m_def.gpuResidentMode
            && this.m_physicsWorld.m_backendMode != PhysicsBackendMode::CpuOnly
            && allFluidsGpuSupported
            && !hasDrivenKinematic
            && !hasAnyPhysicsParents
            && !interpolateTransforms
            && world.view<CharacterControllerComponent>().candidateCount() == 0u
            && world.view<VehicleComponent>().candidateCount() == 0u
            && world.view<ArticulationComponent>().candidateCount() == 0u
            && world.view<RagdollComponent>().candidateCount() == 0u
            && world.view<SoftBodyComponent>().candidateCount() == 0u
            && world.view<FractureComponent>().candidateCount() == 0u
        ;
        if(useCollectedEnv || (gpuResidentEligible && hasAnyEnvEntities)){
            if(useCollectedEnv && hasDrivenKinematic)
                SnapshotDrivenKinematicTargets(this.m_physicsWorld, this.m_syncScratch.drivenKinematicEntries, hasAnyPhysicsParents, world, this.m_syncScratch.writeBackPoseCache, this.m_syncScratch.kinematicTargets);
            CollectEcsPhysicsEnvironment(hasAnyPhysicsParents, this.m_collisionLayerMatrix, world, this.m_syncScratch.writeBackPoseCache, this.m_environmentScratch, this.m_syncScratch.envFluidEntitiesScratch);
        }
        const b8 gpuResidentActive = gpuResidentEligible && this.m_gpuDispatcher.isReady();
        const Optional<mut SoftBodyMeshSystem> softBodyMeshSystem = world.borrowSystem<SoftBodyMeshSystem>();
        if(!gpuResidentEligible){
            this.m_prevGpuResidentContactPairs.clear();
            this.m_prevGpuResidentSensorPairs.clear();
            if(this.m_gpuDispatcher.isGpuResidentDirtyCpu())
                this.syncGpuResidentToWorld();
        }

        mut CpuTaskScheduler scheduler = world.taskScheduler();
        b8 usedGpuResidentNoReadback = false;
        u32 stepsExecuted = 0u;
        while(this.m_accumulator + 1.0e-6f >= fixedDt && stepsExecuted < maxAllowedSteps){
            if(this.m_accumulator >= fixedDt)
                this.m_accumulator -= fixedDt;
            else
                this.m_accumulator = 0.0f;

            const b8 isFinalStep = ((stepsExecuted + 1u) == plannedSteps);
            if(isFinalStep && !gpuResidentEligible)
                PreparePrevEcsBodyTransformSnapshots(this.m_physicsWorld, this.bodyMoveEvents(), this.m_syncScratch.dirtyPrevSnapshotBodyIndices, this.m_syncScratch.snapshotBodyStamps, this.m_syncScratch.snapshotStamp, this.m_bodyTransformSnapshots, this.m_bodyTransformSnapshotMeta);
            if(hasDrivenKinematic){
                if(plannedSteps <= 1u)
                    ApplyKinematicTargetsFromEcs(this.m_syncScratch.drivenKinematicEntries, fixedDt, hasAnyPhysicsParents, world, this.m_syncScratch.writeBackPoseCache, this.m_physicsWorld);
                else
                    ApplyInterpolatedKinematicTargets(this.m_syncScratch.kinematicTargets, stepsExecuted, plannedSteps, fixedDt, this.m_physicsWorld);
            }
            if(this.m_preStepCallback.has_value())
                this.m_preStepCallback.value()(world, this.m_physicsWorld, fixedDt);

            const b8 writeBackCharacters = isFinalStep && !interpolateTransforms;
            StepEcsPhysicsSubsystemBridges(
                world,
                this.m_physicsWorld,
                this.m_entityRecords,
                this.m_scopedNames,
                this.m_collisionLayerMatrix,
                collisionLayerMatrixDirty,
                this.m_bodyIndexToEntity,
                this.m_shapeIndexToEntity,
                this.m_jointIndexToEntity,
                fixedDt,
                useCollectedEnv,
                gpuResidentActive,
                writeBackCharacters,
                hasAnyPhysicsParents,
                isFinalStep,
                this.m_environmentScratch,
                this.m_activeRagdolls,
                this.m_activeFractures,
                this.m_syncScratch,
                scheduler,
                this.m_gpuDispatcher,
                softBodyMeshSystem
            );

            const Timer stepStart = TimerNow();
            b8 gpuEnvOk = true;
            if(gpuResidentActive && (!this.m_environmentScratch.fluids.empty() || !this.m_environmentScratch.forceFields.empty())){
                gpuEnvOk = this.m_gpuDispatcher.applyEnvironmentGpu(this.m_physicsWorld, this.m_environmentScratch, fixedDt);
                if(gpuEnvOk)
                    this.m_environmentScratch.elapsedTimeSec += fixedDt;
            }
            if(gpuResidentActive && gpuEnvOk && this.m_gpuDispatcher.stepGpuResidentBodies(this.m_physicsWorld, fixedDt, subStepCount, false)){
                usedGpuResidentNoReadback = true;
                this.m_gpuDispatcher.stepGpuBulletToiResident(this.m_physicsWorld, fixedDt);
                if(this.m_gpuDispatcher.readbackGpuResidentEvents(this.m_physicsWorld, this.m_gpuResidentEventsScratch))
                    this.processGpuResidentStepEvents(world);
            }
            else{
                usedGpuResidentNoReadback = false;
                if(this.m_gpuDispatcher.isGpuResidentDirtyCpu())
                    this.m_gpuDispatcher.syncGpuResidentToWorld(this.m_physicsWorld);
                if(gpuResidentActive && !gpuEnvOk){
                    this.m_environmentScratch.elapsedTimeSec += fixedDt;
                    for(usize fi = 0u; fi < this.m_environmentScratch.forceFields.size(); ++fi)
                        ApplyForceFieldWithScheduler(this.m_physicsWorld, this.m_environmentScratch.forceFields[fi], this.m_environmentScratch.elapsedTimeSec, fixedDt, scheduler);
                }
                StepWorldWithGpu(this.m_physicsWorld, this.m_gpuDispatcher, fixedDt, subStepCount, scheduler);
            }
            this.m_lastStepMs = DurationInMS<f64>(TimerNow(), stepStart);

            ProcessEcsFracturePostStepHits(
                world,
                this.m_physicsWorld,
                this.m_bodyIndexToEntity,
                this.m_shapeIndexToEntity,
                this.m_activeFractures,
                this.m_syncScratch
            );

            this.recordBrokenJointOwnersFromWorld();
            if(plannedSteps == 1u)
                this.m_useDirectWorldEvents = true;
            else
                this.appendLastStepEvents();
            this.m_lastStepStats = this.m_physicsWorld.lastStepStats();
            this.m_lastStepTopologyVersion = this.m_physicsWorld.m_topologyVersion;
            ++stepsExecuted;
        }

        if(runSingleStep){
            this.m_accumulator = 0.0f;
            this.m_interpolationAlpha = 1.0f;
        }
        else{
            this.m_interpolationAlpha = Clamp(this.m_accumulator / fixedDt, 0.0f, 1.0f);
        }

        if(stepsExecuted > 0u){
            if(!usedGpuResidentNoReadback){
                if(stepsExecuted == 1u){
                    WriteBackPhysicsTransformsToEcs(
                        this.m_physicsWorld,
                        this.bodyMoveEvents(),
                        this.m_bodyIndexToEntity,
                        hasAnyPhysicsParents,
                        true,
                        interpolateTransforms,
                        this.m_interpolationAlpha,
                        world,
                        this.m_syncScratch,
                        this.m_bodyTransformSnapshots,
                        this.m_bodyTransformSnapshotMeta
                    );
                }
                else{
                    CommitCurrEcsBodyTransformSnapshots(this.m_physicsWorld, this.m_syncScratch.dirtyPrevSnapshotBodyIndices, this.m_bodyTransformSnapshots, this.m_bodyTransformSnapshotMeta);
                    WriteBackPhysicsTransformsToEcs(
                        this.m_physicsWorld,
                        this.bodyMoveEvents(),
                        this.m_bodyIndexToEntity,
                        hasAnyPhysicsParents,
                        false,
                        interpolateTransforms,
                        this.m_interpolationAlpha,
                        world,
                        this.m_syncScratch,
                        this.m_bodyTransformSnapshots,
                        this.m_bodyTransformSnapshotMeta
                    );
                }
                WriteBackEcsRagdollRootPoses(
                    this.m_physicsWorld,
                    this.m_scopedNames,
                    this.m_activeRagdolls,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta,
                    interpolateTransforms,
                    this.m_interpolationAlpha,
                    hasAnyPhysicsParents,
                    world,
                    this.m_syncScratch
                );
                WriteBackEcsVehicleWheelPoses(
                    this.m_physicsWorld,
                    this.m_scopedNames,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta,
                    interpolateTransforms,
                    this.m_interpolationAlpha,
                    true,
                    hasAnyPhysicsParents,
                    world,
                    this.m_syncScratch
                );
                WriteBackEcsArticulationPoses(
                    this.m_physicsWorld,
                    this.m_scopedNames,
                    this.m_bodyIndexToEntity,
                    interpolateTransforms,
                    this.m_interpolationAlpha,
                    true,
                    hasAnyPhysicsParents,
                    world,
                    this.m_syncScratch
                );
                WriteBackEcsFracturePoses(
                    this.m_physicsWorld,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta,
                    interpolateTransforms,
                    this.m_interpolationAlpha,
                    hasAnyPhysicsParents,
                    world,
                    this.m_syncScratch
                );
                if(interpolateTransforms)
                    ApplyInterpolatedCharacterTransformsToEcs(this.m_syncScratch.characterSyncStates, this.m_interpolationAlpha, hasAnyPhysicsParents, world, this.m_syncScratch.writeBackPoseCache);
            }
        }
        else{
            this.m_physicsWorld.consumePendingEndEvents(this.m_frameContactEndEvents, this.m_frameSensorEndEvents);
            this.m_physicsWorld.consumePendingWakeEvents(this.m_frameBodyWakeEvents);
            if(interpolateTransforms && !this.m_gpuDispatcher.isGpuResidentDirtyCpu()){
                ApplyInterpolatedRenderTransformsToEcs(
                    this.m_physicsWorld,
                    this.m_bodyIndexToEntity,
                    hasAnyPhysicsParents,
                    this.m_interpolationAlpha,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta,
                    world,
                    this.m_syncScratch
                );
                ApplyInterpolatedCharacterTransformsToEcs(this.m_syncScratch.characterSyncStates, this.m_interpolationAlpha, hasAnyPhysicsParents, world, this.m_syncScratch.writeBackPoseCache);
                WriteBackEcsRagdollRootPoses(
                    this.m_physicsWorld,
                    this.m_scopedNames,
                    this.m_activeRagdolls,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta,
                    true,
                    this.m_interpolationAlpha,
                    hasAnyPhysicsParents,
                    world,
                    this.m_syncScratch
                );
                WriteBackEcsVehicleWheelPoses(
                    this.m_physicsWorld,
                    this.m_scopedNames,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta,
                    true,
                    this.m_interpolationAlpha,
                    false,
                    hasAnyPhysicsParents,
                    world,
                    this.m_syncScratch
                );
                WriteBackEcsArticulationPoses(
                    this.m_physicsWorld,
                    this.m_scopedNames,
                    this.m_bodyIndexToEntity,
                    true,
                    this.m_interpolationAlpha,
                    false,
                    hasAnyPhysicsParents,
                    world,
                    this.m_syncScratch
                );
            }
        }

        this.dispatchFrameEventCallbacks();
        this.publishFrameEventsToMessageBus(world);
        return Expected<void, CpuTaskAdmissionError>();
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

