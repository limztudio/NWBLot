#include <impl/ecs_render/optics/optical_scene_internal.adhd>
#include <impl/ecs_render/optics/optical_scene_resources_and_upload.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<RayTracingOpticalSceneGraphBuffer> ImportRayTracingOpticalSceneBuffer(in RayTracingOpticalSceneSnapshot resources, in borrow GpuTaskId priorReadersDrained, mut GpuTaskGraph graph){
    const auto uploaded = ImportOpticalSceneUpload(resources, priorReadersDrained, graph);
    if(!uploaded.has_value() || !resources.finalize.valid())
        return uploaded;
    return DeclareOpticalBoundsFinalize(resources, uploaded.value().resource, priorReadersDrained, graph);
}


