        colorStarts[c] = totalContacts;
        const usize cCount = world.m_graph.colors[c].contactIds.size();
        outConstraints[c].resize(cCount);
        totalContacts += cCount;
    }
    if(totalContacts == 0u)
        return true;

    if(cpuScheduler.isParallelEnabled() && totalContacts >= s_CpuPrepareContactThreshold){
        in Array<usize, s_GraphColorCount> colorStartsRef = colorStarts;
        const usize grain = ComputePhysicsGrain(cpuScheduler, totalContacts, cast<usize>(32u));
        const auto res = cpuScheduler.parallelFor(
            0u,
            totalContacts,
            grain,
            lambda[in worldRef, in colorStartsRef, in dynamicSoftness, in staticSoftness, in contactHertz, in contactDampingRatio, in h, in enableContactSoftening, mut outConstraints](in usize flatIdx) -> void{
                const usize c = ResolveColorSlotIndex(colorStartsRef, flatIdx);
                const usize idx = flatIdx - colorStartsRef[c];
                const u32 contactId = worldRef.m_graph.colors[c].contactIds[idx];
                PrepareContactConstraint(
                    worldRef.m_bodies,
                    worldRef.m_solverSets,
