    for(usize c = 0u; c < s_GraphColorCount; ++c){
        colorStarts[c] = totalContacts;
        const usize cCount = world.m_graph.colors[c].contactIds.size();
        outConstraints[c].resize(cCount);
        outCaches[c].resize(cCount);
        totalContacts += cCount;
    }
    if(totalContacts == 0u)
        return true;

    if(cpuScheduler.isParallelEnabled() && totalContacts >= s_CpuPrepareContactThreshold){
        in Array<usize, s_GraphColorCount> colorStartsRef = colorStarts;
        const usize grain = ComputePhysicsGrain(cpuScheduler, totalContacts, cast<usize>(32u));
        const auto res = cpuScheduler.parallelFor(
            0u,
            totalContacts,
            grain,
            lambda[in worldRef, in colorStartsRef, in dynamicSoftness, in staticSoftness, in contactHertz, in contactDampingRatio, in h, in enableContactSoftening, mut outConstraints, mut outCaches](in usize flatIdx) -> void{
                const usize c = ResolveColorSlotIndex(colorStartsRef, flatIdx);
                const usize idx = flatIdx - colorStartsRef[c];
                const u32 contactId = worldRef.m_graph.colors[c].contactIds[idx];
                PrepareContactConstraintWithCache(
                    worldRef.m_bodies,
                    worldRef.m_solverSets,
                    worldRef.m_contacts[contactId],
                    dynamicSoftness,
                    staticSoftness,
                    contactHertz,
                    contactDampingRatio,
                    h,
                    enableContactSoftening,
                    worldRef.m_enableWarmStarting,
                    outConstraints[c][idx],
                    outCaches[c][idx]
                );
            },
            CpuTaskOptions()
        );
        if(!res.has_value())
            return false;
        return true;
    }

    for(usize c = 0u; c < s_GraphColorCount; ++c){
        in Vector<u32> ids = world.m_graph.colors[c].contactIds;
        for(usize idx = 0u; idx < ids.size(); ++idx){
            const u32 contactId = ids[idx];
            PrepareContactConstraintWithCache(
                world.m_bodies,
                world.m_solverSets,
                world.m_contacts[contactId],
                dynamicSoftness,
                staticSoftness,
                contactHertz,
                contactDampingRatio,
                h,
                enableContactSoftening,
                world.m_enableWarmStarting,
                outConstraints[c][idx],
                outCaches[c][idx]
            );
        }
    }
    return true;
}

void EmitContactHitEventIfNeeded(mut PhysicsWorld world, in ContactConstraint cc, in Contact contact){
    if((contact.flags & cast<u32>(ContactFlags::EnableHitEvents)) == 0u)
        return;
    f32 maxApproach = 0.0f;
    u32 maxApproachIdx = 0u;
    for(u32 p = 0u; p < cc.pointCount; ++p){
        const f32 relVel = cc.points[p].relativeVelocity();
        if(-relVel > maxApproach && cc.points[p].totalNormalImpulse > 0.0f){
            maxApproach = -relVel;
            maxApproachIdx = p;
        }
    }
    if(maxApproach >= world.m_def.hitEventThreshold && maxApproachIdx < contact.manifold.pointCount()){
        ContactHitEvent hitEv;
        hitEv.shapeIdA = world.makeShapeId(contact.shapeIdA);
        hitEv.shapeIdB = world.makeShapeId(contact.shapeIdB);
        hitEv.point = f32x4(contact.manifold.points[maxApproachIdx].point(), 0.0f);
        hitEv.normalApproachSpeed = f32x4(contact.manifold.normal(), maxApproach);
        world.m_contactHitEvents.push_back(hitEv);
    }
}

u8 StoreContactConstraintImpulsesFast(in ContactConstraint cc, mut Contact contact, in f32 hitThreshold){
    StoreContactConstraintImpulses(cc, contact);
    if((contact.flags & cast<u32>(ContactFlags::EnableHitEvents)) == 0u)
        return 1u;
    f32 maxApproach = 0.0f;
    u32 maxApproachIdx = 0u;
    for(u32 p = 0u; p < cc.pointCount; ++p){
        const f32 relVel = cc.points[p].relativeVelocity();
        if(-relVel > maxApproach && cc.points[p].totalNormalImpulse > 0.0f){
            maxApproach = -relVel;
            maxApproachIdx = p;
        }
    }
    if(maxApproach >= hitThreshold && maxApproachIdx < contact.manifold.pointCount())
        return 2u;
    return 1u;
}

void StoreContactConstraintImpulsesAndHitEvents(mut PhysicsWorld world, in ContactConstraint cc){
    mut Contact contact = world.m_contacts[cc.contactId];
    StoreContactConstraintImpulses(cc, contact);
    EmitContactHitEventIfNeeded(world, cc, contact);
}

void EmitJointBreakEventIfNeeded(
    mut PhysicsWorld world,
    in JointConstraint jc,
    in f32 invH,
    in Joint joint,
    mut Vector<u32> outBrokenJointIds
){
    if(joint.breakForce <= 0.0f && joint.breakTorque <= 0.0f)
        return;
    const f32 peakForce = SimdMax(Vector3Length(joint.lastConstraintForce()).x, jc.maxLinearImpulseMag() * invH);
    const f32 peakTorque = SimdMax(Vector3Length(joint.lastConstraintTorque()).x, jc.maxAngularImpulseMag() * invH);
    const b8 brokeForce = joint.breakForce > 0.0f && peakForce > joint.breakForce;
    const b8 brokeTorque = joint.breakTorque > 0.0f && peakTorque > joint.breakTorque;
    if(brokeForce || brokeTorque){
        JointBreakEvent ev;
        ev.jointId = world.makeJointId(jc.jointId);
        ev.bodyIdA = world.makeBodyId(joint.edges[0u].bodyId);
        ev.bodyIdB = world.makeBodyId(joint.edges[1u].bodyId);
        ev.userData = joint.userData;
        ev.peakForce = peakForce;
        ev.peakTorque = peakTorque;
        world.m_jointBreakEvents.push_back(ev);
        outBrokenJointIds.push_back(jc.jointId);
    }
}

u8 StoreJointImpulsesFast(in JointConstraint jc, in f32 invH, mut Joint joint){
    StoreJointConstraintImpulses(jc, invH, joint);
    if(joint.breakForce <= 0.0f && joint.breakTorque <= 0.0f)
        return 1u;
    const f32 peakForce = SimdMax(Vector3Length(joint.lastConstraintForce()).x, jc.maxLinearImpulseMag() * invH);
    const f32 peakTorque = SimdMax(Vector3Length(joint.lastConstraintTorque()).x, jc.maxAngularImpulseMag() * invH);
    const b8 brokeForce = joint.breakForce > 0.0f && peakForce > joint.breakForce;
    const b8 brokeTorque = joint.breakTorque > 0.0f && peakTorque > joint.breakTorque;
    if(brokeForce || brokeTorque)
        return 2u;
    return 1u;
}

void StoreJointImpulsesAndCollectBroken(
    mut PhysicsWorld world,
    in JointConstraint jc,
    in f32 invH,
    mut Vector<u32> outBrokenJointIds
){
    mut Joint joint = world.m_joints[jc.jointId];
    StoreJointConstraintImpulses(jc, invH, joint);
    EmitJointBreakEventIfNeeded(world, jc, invH, joint, outBrokenJointIds);
}

void StoreSolvedPartitionImpulsesAndEventsCpu(
    mut PhysicsWorld world,
    in Array<Vector<ContactConstraint>, s_GraphColorCount> colorConstraints,
    in Vector<JointConstraint> jointConstraints,
    in f32 invH,
    mut Vector<u32> outBrokenJointIds
){
    if(!world.m_cpuScratch.parImpulsesStored){
        for(usize ji = 0u; ji < jointConstraints.size(); ++ji)
            StoreJointImpulsesAndCollectBroken(world, jointConstraints[ji], invH, outBrokenJointIds);
        for(usize c = 0u; c < s_GraphColorCount; ++c){
            for(usize idx = 0u; idx < colorConstraints[c].size(); ++idx)
                StoreContactConstraintImpulsesAndHitEvents(world, colorConstraints[c][idx]);
        }
        return;
    }

    world.m_cpuScratch.parImpulsesStored = false;
    in Vector<u8> jointFlags = world.m_cpuScratch.parJointBreakFlags;
    for(usize ji = 0u; ji < jointConstraints.size(); ++ji){
        const u8 flag = jointFlags[ji];
        if(flag == 1u)
            continue;
        if(flag == 0u)
            StoreJointImpulsesAndCollectBroken(world, jointConstraints[ji], invH, outBrokenJointIds);
        else
            EmitJointBreakEventIfNeeded(world, jointConstraints[ji], invH, world.m_joints[jointConstraints[ji].jointId], outBrokenJointIds);
    }

    for(usize c = 0u; c < s_GraphColorCount; ++c){
        in Vector<ContactConstraint> cons = colorConstraints[c];
        in Vector<u8> flags = world.m_cpuScratch.parContactHitFlags[c];
        for(usize idx = 0u; idx < cons.size(); ++idx){
            const u8 flag = flags[idx];
            if(flag == 1u)
                continue;
            if(flag == 0u)
                StoreContactConstraintImpulsesAndHitEvents(world, cons[idx]);
            else
                EmitContactHitEventIfNeeded(world, cons[idx], world.m_contacts[cons[idx].contactId]);
        }
    }
}

void PrepareJointConstraintsCpu(
    in PhysicsWorld world,
    in Vector<u32> jointIds,
    in f32 jointDefaultHertz,
    in f32 h,
    mut CpuTaskScheduler cpuScheduler,
    mut Vector<JointConstraint> outConstraints
){
    const usize count = jointIds.size();
    outConstraints.resize(count);
    if(count == 0u)
        return;

    const b8 warmStart = world.m_enableWarmStarting;
    if(cpuScheduler.isParallelEnabled() && count >= s_CpuParallelThreshold){
        in PhysicsWorld worldRef = world;
        const Span<u32> jointIdSpan = Span<u32>(jointIds);
        const usize grain = ComputePhysicsGrain(cpuScheduler, count, cast<usize>(16u));
        const auto res = cpuScheduler.parallelFor(
            0u,
            count,
            grain,
            lambda[in worldRef, in jointIdSpan, in jointDefaultHertz, in h, in warmStart, mut outConstraints](in usize ji) -> void{
                PrepareJointConstraint(worldRef.m_bodies, worldRef.m_solverSets, worldRef.m_joints[jointIdSpan[ji]], jointDefaultHertz, h, warmStart, outConstraints[ji]);
            },
            CpuTaskOptions()
        );
        if(res.has_value())
            return;
    }

    for(usize ji = 0u; ji < count; ++ji)
        PrepareJointConstraint(world.m_bodies, world.m_solverSets, world.m_joints[jointIds[ji]], jointDefaultHertz, h, warmStart, outConstraints[ji]);
}

void RecordWorldStepStats(
    mut PhysicsWorld world,
    in u32 pairCount,
    in u32 cpuSolvedBodies,
    in u32 gpuSolvedBodies,
    in u32 cpuSolvedIslands,
    in u32 gpuSolvedIslands,
    in ExecutionBackendUsed backend
){
    world.m_lastStats.bodyCount = world.activeBodyCount();
    world.m_lastStats.awakeBodyCount = world.awakeBodyCount();
    world.m_lastStats.sleepingBodyCount = CountSleepingBodies(world);
    world.m_lastStats.shapeCount = world.activeShapeCount();
    world.m_lastStats.contactCount = cast<u32>(world.m_pairContactMap.size());
    world.m_lastStats.jointCount = world.activeJointCount();
    world.m_lastStats.islandCount = cast<u32>(world.m_solverSets[s_AwakeSetIndex].islands.size());
    world.m_lastStats.overflowContactCount = cast<u32>(world.m_graph.colors[s_OverflowColorIndex].contactIds.size());
    world.m_lastStats.broadphasePairCount = pairCount;
    world.m_lastStats.cpuSolvedBodyCount = cpuSolvedBodies;
    world.m_lastStats.gpuSolvedBodyCount = gpuSolvedBodies;
    world.m_lastStats.cpuSolvedIslandCount = cpuSolvedIslands;
    world.m_lastStats.gpuSolvedIslandCount = gpuSolvedIslands;
    world.m_lastStats.backendUsed = backend;
}

b8 IsTinyBulletComponent(in SolverComponentInfo comp){
    return comp.hasBullet && comp.bodyCount <= 2u;
}

u32 CountColorBits(in u32 mask){
    u32 m = mask;
    u32 count = 0u;
    while(m != 0u){
        m &= (m - 1u);
        ++count;
    }
    return count;
}

u32 ResolveComponentGpuAffinityTier(in SolverComponentInfo comp){
    if(comp.hasOverflowContact || IsTinyBulletComponent(comp))
        return 4u;
    if(!comp.hasAwakeKinematic && comp.jointCount == 0u && (comp.contactCount == 0u || (comp.bodyCount <= s_GpuContactIslandMaxBodies && comp.contactCount <= s_GpuContactIslandMaxContacts)))
        return 0u;
    if(comp.jointCount == 0u && comp.maxDynamicColor <= 3u)
        return 1u;
    if(!comp.hasAwakeKinematic && comp.jointCount > 0u && comp.bodyCount <= s_GpuJointIslandMaxBodies && comp.contactCount <= s_GpuJointIslandMaxContacts && comp.jointCount <= s_GpuJointIslandMaxJoints)
        return 2u;
    return 3u;
}

void BuildSolverWorkPartition(
    in PhysicsWorld world,
    in f32 gpuWorkloadFraction,
    in b8 allowCpuSplit,
    mut SolverWorkPartition outPartition
){
    outPartition.resetForStep();
    const u32 awakeCount = world.awakeBodyCount();
    if(awakeCount == 0u)
        return;

    outPartition.awakeBodyOwner.resize(awakeCount, 0u);
    outPartition.awakeToGpuSlot.resize(awakeCount, s_NullIndex);

    mut Vector<u32> activeJointIds = outPartition.scratchActiveJointIds;
    CollectActiveAwakeJointIds(world, outPartition.scratchJointVisitStamps, outPartition.scratchJointVisitStamp, activeJointIds);

    mut Vector<u32> dsuParents = outPartition.scratchDsuParents;
    dsuParents.resize(awakeCount);
    for(u32 i = 0u; i < awakeCount; ++i)
        dsuParents[i] = i;
    mut Vector<u8> dsuRanks = outPartition.scratchDsuRanks;
    dsuRanks.clear();
    dsuRanks.resize(awakeCount, 0u);

    for(usize c = 0u; c < s_GraphColorCount; ++c){
        in Vector<u32> cIds = world.m_graph.colors[c].contactIds;
        for(usize idx = 0u; idx < cIds.size(); ++idx){
            in Contact contact = world.m_contacts[cIds[idx]];
            in Body bA = world.m_bodies[contact.edges[0u].bodyId];
            in Body bB = world.m_bodies[contact.edges[1u].bodyId];
            if(
                bA.type == BodyType::Dynamic && bA.setIndex == s_AwakeSetIndex
                && bB.type == BodyType::Dynamic && bB.setIndex == s_AwakeSetIndex
            )
                JoinDisjointSets(cast<isize>(bA.localIndex), cast<isize>(bB.localIndex), dsuParents, dsuRanks);
        }
    }

    for(usize ji = 0u; ji < activeJointIds.size(); ++ji){
        in Joint joint = world.m_joints[activeJointIds[ji]];
        in Body bA = world.m_bodies[joint.edges[0u].bodyId];
        in Body bB = world.m_bodies[joint.edges[1u].bodyId];
        if(
            bA.type == BodyType::Dynamic && bA.setIndex == s_AwakeSetIndex
            && bB.type == BodyType::Dynamic && bB.setIndex == s_AwakeSetIndex
        )
            JoinDisjointSets(cast<isize>(bA.localIndex), cast<isize>(bB.localIndex), dsuParents, dsuRanks);
    }

    in SolverSet awakeSet = world.m_solverSets[s_AwakeSetIndex];
    mut Vector<SolverComponentInfo> components = outPartition.scratchComponents;
    components.clear();
    mut Vector<u32> rootToComp = outPartition.scratchRootToComp;
    rootToComp.clear();
    rootToComp.resize(awakeCount, s_NullIndex);
    mut Vector<u32> awakeCompIdx = outPartition.scratchAwakeCompIdx;
    awakeCompIdx.clear();
    awakeCompIdx.resize(awakeCount, s_NullIndex);
    u32 totalDynAwake = 0u;
    for(u32 i = 0u; i < awakeCount; ++i){
        in Body body = world.m_bodies[awakeSet.sims[i].bodyId];
        if(body.type != BodyType::Dynamic)
            continue;
        const u32 compRoot = cast<u32>(FindDisjointRoot(cast<isize>(i), dsuParents));
        u32 ci = rootToComp[compRoot];
        if(ci == s_NullIndex){
            ci = cast<u32>(components.size());
            SolverComponentInfo compInfo;
            compInfo.componentRoot = compRoot;
            components.push_back(compInfo);
            rootToComp[compRoot] = ci;
        }
        awakeCompIdx[i] = ci;
        ++components[ci].bodyCount;
        ++totalDynAwake;
        if((body.flags & cast<u32>(BodyFlags::IsBullet)) != 0u)
            components[ci].hasBullet = true;
    }

    for(usize c = 0u; c < s_GraphColorCount; ++c){
        in Vector<u32> cIds = world.m_graph.colors[c].contactIds;
        for(usize idx = 0u; idx < cIds.size(); ++idx){
            in Contact contact = world.m_contacts[cIds[idx]];
            in Body bA = world.m_bodies[contact.edges[0u].bodyId];
            in Body bB = world.m_bodies[contact.edges[1u].bodyId];
            u32 dynAwakeIdx = s_NullIndex;
            if(bA.type == BodyType::Dynamic && bA.setIndex == s_AwakeSetIndex)
                dynAwakeIdx = bA.localIndex;
            else if(bB.type == BodyType::Dynamic && bB.setIndex == s_AwakeSetIndex)
                dynAwakeIdx = bB.localIndex;
            if(dynAwakeIdx != s_NullIndex){
                const u32 ci = awakeCompIdx[dynAwakeIdx];
                if(ci != s_NullIndex){
                    ++components[ci].contactCount;
                    if((bA.type != BodyType::Dynamic && bA.setIndex == s_AwakeSetIndex) || (bB.type != BodyType::Dynamic && bB.setIndex == s_AwakeSetIndex))
                        components[ci].hasAwakeKinematic = true;
                    if(c == s_OverflowColorIndex){
                        components[ci].hasOverflowContact = true;
                    }
                    else{
                        components[ci].colorMask |= (1u << cast<u32>(c));
                        if(c < s_DynamicColorCount && cast<u32>(c) > components[ci].maxDynamicColor)
                            components[ci].maxDynamicColor = cast<u32>(c);
                    }
                }
            }
        }
    }

    for(usize ji = 0u; ji < activeJointIds.size(); ++ji){
        in Joint joint = world.m_joints[activeJointIds[ji]];
        in Body bA = world.m_bodies[joint.edges[0u].bodyId];
        in Body bB = world.m_bodies[joint.edges[1u].bodyId];
        u32 dynAwakeIdx = s_NullIndex;
        if(bA.type == BodyType::Dynamic && bA.setIndex == s_AwakeSetIndex)
            dynAwakeIdx = bA.localIndex;
        else if(bB.type == BodyType::Dynamic && bB.setIndex == s_AwakeSetIndex)
            dynAwakeIdx = bB.localIndex;
        if(dynAwakeIdx != s_NullIndex){
            const u32 ci = awakeCompIdx[dynAwakeIdx];
            if(ci != s_NullIndex){
                ++components[ci].jointCount;
                if((bA.type != BodyType::Dynamic && bA.setIndex == s_AwakeSetIndex) || (bB.type != BodyType::Dynamic && bB.setIndex == s_AwakeSetIndex))
                    components[ci].hasAwakeKinematic = true;
            }
        }
    }

    if(components.empty()){
        for(u32 i = 0u; i < awakeCount; ++i){
            outPartition.awakeBodyOwner[i] = 0u;
            outPartition.cpuAwakeIndices.push_back(i);
            ++outPartition.cpuOwnedBodyCount;
        }
        return;
    }

    u32 totalWork = 0u;
    for(usize ci = 0u; ci < components.size(); ++ci){
        const u32 score = components[ci].bodyCount + components[ci].contactCount * 2u + components[ci].jointCount * 3u;
        components[ci].workScore = score;
        totalWork += score;
    }

    const f32 frac = SimdClamp(gpuWorkloadFraction, 0.0f, 1.0f);
    if(!allowCpuSplit || frac >= 1.0f){
        for(usize ci = 0u; ci < components.size(); ++ci)
            components[ci].assignGpu = true;
    }
    else if(frac <= 0.0f){
        for(usize ci = 0u; ci < components.size(); ++ci)
            components[ci].assignGpu = false;
    }
    else if(components.size() == 1u){
        components[0u].assignGpu = true;
    }
    else{
        mut Vector<usize> order = outPartition.scratchCompOrder;
        order.resize(components.size());
        for(usize ci = 0u; ci < components.size(); ++ci)
            order[ci] = ci;

        const Span<SolverComponentInfo> compSpan = Span<SolverComponentInfo>(components);
        SortSequence<usize>(
            order,
            lambda[in compSpan](in usize lhs, in usize rhs) -> b8{
                in SolverComponentInfo a = compSpan[lhs];
                in SolverComponentInfo b = compSpan[rhs];
                const u32 tierA = ResolveComponentGpuAffinityTier(a);
                const u32 tierB = ResolveComponentGpuAffinityTier(b);
                if(tierA != tierB)
                    return tierA < tierB;
                if(tierA == 1u || tierA == 3u){
                    if(a.maxDynamicColor != b.maxDynamicColor)
                        return a.maxDynamicColor < b.maxDynamicColor;
                    const u32 bitsA = CountColorBits(a.colorMask);
                    const u32 bitsB = CountColorBits(b.colorMask);
                    if(bitsA != bitsB)
                        return bitsA < bitsB;
                }
                if(a.workScore != b.workScore)
                    return a.workScore > b.workScore;
                return a.componentRoot < b.componentRoot;
            }
        );

        const u32 targetGpuWork = Max(1u, cast<u32>(cast<f32>(totalWork) * frac + 0.5f));
        u32 gpuWork = 0u;
        usize assignedGpuCount = 0u;
        for(usize oi = 0u; oi < order.size(); ++oi){
            if(assignedGpuCount + 1u >= components.size())
                break;
            const usize ci = order[oi];
            in SolverComponentInfo comp = components[ci];
            if(assignedGpuCount > 0u && (IsTinyBulletComponent(comp) || comp.hasOverflowContact))
                continue;
            const u32 nextWork = gpuWork + comp.workScore;
            if(assignedGpuCount == 0u){
                components[ci].assignGpu = true;
                gpuWork = nextWork;
                ++assignedGpuCount;
                if(gpuWork >= targetGpuWork)
                    break;
                continue;
            }
            if(gpuWork >= targetGpuWork)
                break;
            if(nextWork <= targetGpuWork || (nextWork - targetGpuWork) < (targetGpuWork - gpuWork)){
                components[ci].assignGpu = true;
                gpuWork = nextWork;
                ++assignedGpuCount;
            }
        }
    }

    const usize compCount = components.size();
    mut Vector<u8> gpuCompKind = outPartition.scratchGpuCompKind;
    gpuCompKind.clear();
    gpuCompKind.resize(compCount, 0u);
    mut Vector<u32> compToCpuCompIdx = outPartition.scratchCompToCpuCompIdx;
    compToCpuCompIdx.clear();
    compToCpuCompIdx.resize(compCount, s_NullIndex);
    mut Vector<usize> sortedFreeComps = outPartition.scratchSortedFreeComps;
    sortedFreeComps.clear();
    mut Vector<usize> sortedContactIslands = outPartition.scratchSortedContactIslands;
    sortedContactIslands.clear();
    mut Vector<usize> sortedJointIslands = outPartition.scratchSortedJointIslands;
    sortedJointIslands.clear();
    b8 anyCpuCompHasKinematic = false;
    for(usize ci = 0u; ci < compCount; ++ci){
        in SolverComponentInfo comp = components[ci];
        if(comp.assignGpu){
            ++outPartition.gpuComponentCount;
            if(!comp.hasAwakeKinematic && comp.contactCount == 0u && comp.jointCount == 0u){
                gpuCompKind[ci] = 4u;
                sortedFreeComps.push_back(ci);
            }
            else if(!comp.hasAwakeKinematic && comp.jointCount == 0u && comp.contactCount > 0u && comp.bodyCount <= s_GpuContactIslandMaxBodies && comp.contactCount <= s_GpuContactIslandMaxContacts){
                gpuCompKind[ci] = 1u;
                sortedContactIslands.push_back(ci);
            }
            else if(!comp.hasAwakeKinematic && comp.jointCount > 0u && comp.jointCount <= s_GpuJointIslandMaxJoints && comp.bodyCount <= s_GpuJointIslandMaxBodies && comp.contactCount <= s_GpuJointIslandMaxContacts){
                gpuCompKind[ci] = 2u;
                sortedJointIslands.push_back(ci);
            }
            else{
                gpuCompKind[ci] = 3u;
            }
        }
        else{
            compToCpuCompIdx[ci] = outPartition.cpuComponentCount;
            ++outPartition.cpuComponentCount;
            outPartition.cpuCompWorkScores.push_back(comp.workScore);
            if(comp.hasAwakeKinematic)
                anyCpuCompHasKinematic = true;
        }
    }

    const Span<SolverComponentInfo> compView = Span<SolverComponentInfo>(components);
    const auto islandCmp = lambda[in compView](in usize lhs, in usize rhs) -> b8{
        in SolverComponentInfo a = compView[lhs];
        in SolverComponentInfo b = compView[rhs];
        if(a.workScore != b.workScore)
            return a.workScore > b.workScore;
        return a.componentRoot < b.componentRoot;
    };
    if(sortedContactIslands.size() > 1u)
        SortSequence<usize>(sortedContactIslands, islandCmp);
    if(sortedJointIslands.size() > 1u)
        SortSequence<usize>(sortedJointIslands, islandCmp);

    outPartition.gpuContactIslandCount = cast<u32>(sortedContactIslands.size());
    outPartition.gpuJointIslandCount = cast<u32>(sortedJointIslands.size());
    const u32 totalIslandCount = outPartition.gpuContactIslandCount + outPartition.gpuJointIslandCount;
    outPartition.gpuIslandSlices.resize(totalIslandCount);
    for(u32 si = 0u; si < totalIslandCount; ++si){
        outPartition.gpuIslandSlices[si].bodyOffset = 0u;
        outPartition.gpuIslandSlices[si].bodyCount = 0u;
        outPartition.gpuIslandSlices[si].contactOffset = 0u;
        outPartition.gpuIslandSlices[si].contactCount = 0u;
        outPartition.gpuIslandSlices[si].jointOffset = 0u;
        outPartition.gpuIslandSlices[si].jointCount = 0u;
        for(usize c = 0u; c < s_GraphColorCount; ++c)
            outPartition.gpuIslandSlices[si].contactColorCounts[c] = 0u;
    }
    mut Vector<u32> islandOrder = outPartition.scratchIslandOrder;
    islandOrder.clear();
    islandOrder.resize(totalIslandCount, 0u);
    mut Vector<u32> compToIslandIdx = outPartition.scratchCompToIslandIdx;
    compToIslandIdx.clear();
    compToIslandIdx.resize(compCount, s_NullIndex);
    for(u32 si = 0u; si < outPartition.gpuContactIslandCount; ++si){
        const u32 ci = cast<u32>(sortedContactIslands[si]);
        islandOrder[si] = ci;
        compToIslandIdx[ci] = si;
    }
    for(u32 si = 0u; si < outPartition.gpuJointIslandCount; ++si){
        const u32 dstIdx = outPartition.gpuContactIslandCount + si;
        const u32 ci = cast<u32>(sortedJointIslands[si]);
        islandOrder[dstIdx] = ci;
        compToIslandIdx[ci] = dstIdx;
    }

    mut Vector<u32> compDynOffsets = outPartition.scratchCompDynOffsets;
    compDynOffsets.clear();
    compDynOffsets.resize(compCount + 1u, 0u);
    for(usize ci = 0u; ci < compCount; ++ci)
        compDynOffsets[ci + 1u] = compDynOffsets[ci] + components[ci].bodyCount;
    mut Vector<u32> compDynCursors = outPartition.scratchCompDynCursors;
    compDynCursors.resize(compCount + 1u);
    for(usize ci = 0u; ci <= compCount; ++ci)
        compDynCursors[ci] = compDynOffsets[ci];
    mut Vector<u32> compDynBodies = outPartition.scratchCompDynBodies;
    compDynBodies.clear();
    compDynBodies.resize(totalDynAwake, 0u);
    for(u32 i = 0u; i < awakeCount; ++i){
        const u32 ci = awakeCompIdx[i];
        if(ci == s_NullIndex)
            continue;
        const u32 dst = compDynCursors[ci];
        compDynCursors[ci] = dst + 1u;
        compDynBodies[dst] = i;
    }

    outPartition.gpuAwakeIndices.reserve(awakeCount);
    outPartition.gpuAwakeWriteBack.reserve(awakeCount);

    const Span<u32> compDynOffsetsSpan = Span<u32>(compDynOffsets);
    const Span<u32> compDynBodiesSpan = Span<u32>(compDynBodies);
    const auto emitGpuOwnedComp = lambda[mut outPartition, in compDynOffsetsSpan, in compDynBodiesSpan](in u32 ci) -> void{
        const u32 start = compDynOffsetsSpan[ci];
        const u32 end = compDynOffsetsSpan[ci + 1u];
        for(u32 k = start; k < end; ++k){
            const u32 awakeIdx = compDynBodiesSpan[k];
            outPartition.awakeBodyOwner[awakeIdx] = 1u;
            outPartition.awakeToGpuSlot[awakeIdx] = cast<u32>(outPartition.gpuAwakeIndices.size());
            outPartition.gpuAwakeIndices.push_back(awakeIdx);
            outPartition.gpuAwakeWriteBack.push_back(1u);
            ++outPartition.gpuOwnedBodyCount;
        }
    };

    for(usize fi = 0u; fi < sortedFreeComps.size(); ++fi)
        emitGpuOwnedComp(cast<u32>(sortedFreeComps[fi]));
    outPartition.gpuFreeBodyCount = cast<u32>(outPartition.gpuAwakeIndices.size());

    for(u32 si = 0u; si < totalIslandCount; ++si){
        const u32 ci = islandOrder[si];
        const u32 bodyOff = cast<u32>(outPartition.gpuAwakeIndices.size());
        outPartition.gpuIslandSlices[si].bodyOffset = bodyOff;
        outPartition.gpuIslandSlices[si].bodyCount = compDynOffsets[ci + 1u] - compDynOffsets[ci];
        emitGpuOwnedComp(ci);
    }

    outPartition.gpuColorBodyOffset = cast<u32>(outPartition.gpuAwakeIndices.size());

    for(usize ci = 0u; ci < compCount; ++ci){
        if(gpuCompKind[ci] != 3u)
            continue;
        emitGpuOwnedComp(cast<u32>(ci));
    }

    const u32 cpuCompCount = outPartition.cpuComponentCount;
    outPartition.cpuCompBodyOffsets.resize(cpuCompCount + 1u, 0u);
    outPartition.cpuAwakeIndices.reserve(awakeCount);
    outPartition.cpuCompBodyIndices.reserve(awakeCount);
    for(usize ci = 0u; ci < compCount; ++ci){
        const u32 cci = compToCpuCompIdx[ci];
        if(cci == s_NullIndex)
            continue;
        outPartition.cpuCompBodyOffsets[cci] = cast<u32>(outPartition.cpuCompBodyIndices.size());
        const u32 start = compDynOffsets[ci];
        const u32 end = compDynOffsets[ci + 1u];
        for(u32 k = start; k < end; ++k){
            const u32 awakeIdx = compDynBodies[k];
            outPartition.awakeBodyOwner[awakeIdx] = 0u;
            outPartition.cpuAwakeIndices.push_back(awakeIdx);
            outPartition.cpuCompBodyIndices.push_back(awakeIdx);
            ++outPartition.cpuOwnedBodyCount;
        }
    }
    outPartition.cpuCompBodyOffsets[cpuCompCount] = cast<u32>(outPartition.cpuCompBodyIndices.size());

    for(u32 i = 0u; i < awakeCount; ++i){
        in Body body = world.m_bodies[awakeSet.sims[i].bodyId];
        if(body.type == BodyType::Dynamic)
            continue;
        if(outPartition.cpuOwnedBodyCount > 0u || frac <= 0.0f){
            outPartition.awakeBodyOwner[i] = 0u;
            outPartition.cpuAwakeIndices.push_back(i);
            outPartition.cpuKinAwakeIndices.push_back(i);
            ++outPartition.cpuOwnedBodyCount;
        }
        else{
            outPartition.awakeBodyOwner[i] = 1u;
            outPartition.awakeToGpuSlot[i] = cast<u32>(outPartition.gpuAwakeIndices.size());
            outPartition.gpuAwakeIndices.push_back(i);
            outPartition.gpuAwakeWriteBack.push_back(1u);
            ++outPartition.gpuOwnedBodyCount;
        }
    }

    mut Vector<u32> stagedContactIds = outPartition.scratchStagedContactIds;
    mut Vector<u32> stagedContactIslands = outPartition.scratchStagedContactIslands;
    mut Vector<CpuContactSlotRef> stagedCpuContactSlots = outPartition.scratchStagedCpuContactSlots;
    mut Vector<u32> stagedCpuContactComps = outPartition.scratchStagedCpuContactComps;
    stagedContactIds.clear();
    stagedContactIslands.clear();
    stagedCpuContactSlots.clear();
    stagedCpuContactComps.clear();
    outPartition.cpuCompContactOffsets.resize(cpuCompCount + 1u, 0u);
    for(usize c = 0u; c < s_GraphColorCount; ++c){
        in Vector<u32> cIds = world.m_graph.colors[c].contactIds;
        for(usize idx = 0u; idx < cIds.size(); ++idx){
            const u32 cId = cIds[idx];
            in Contact contact = world.m_contacts[cId];
            in Body bA = world.m_bodies[contact.edges[0u].bodyId];
            in Body bB = world.m_bodies[contact.edges[1u].bodyId];

            u8 owner = 0u;
            u32 compIdx = s_NullIndex;
            if(bA.type == BodyType::Dynamic && bA.setIndex == s_AwakeSetIndex){
                owner = outPartition.awakeBodyOwner[bA.localIndex];
                compIdx = awakeCompIdx[bA.localIndex];
            }
            else if(bB.type == BodyType::Dynamic && bB.setIndex == s_AwakeSetIndex){
                owner = outPartition.awakeBodyOwner[bB.localIndex];
                compIdx = awakeCompIdx[bB.localIndex];
            }

            if(owner != 0u){
                outPartition.gpuColorContactIds[c].push_back(cId);
                u32 islandIdx = s_NullIndex;
                if(compIdx != s_NullIndex)
                    islandIdx = compToIslandIdx[compIdx];
                if(islandIdx != s_NullIndex){
                    stagedContactIds.push_back(cId);
                    stagedContactIslands.push_back(islandIdx);
                    ++outPartition.gpuIslandSlices[islandIdx].contactCount;
                    ++outPartition.gpuIslandSlices[islandIdx].contactColorCounts[c];
                }
                else{
                    if(bA.setIndex == s_AwakeSetIndex && outPartition.awakeToGpuSlot[bA.localIndex] == s_NullIndex){
                        outPartition.awakeToGpuSlot[bA.localIndex] = cast<u32>(outPartition.gpuAwakeIndices.size());
                        outPartition.gpuAwakeIndices.push_back(bA.localIndex);
                        outPartition.gpuAwakeWriteBack.push_back(0u);
                    }
                    if(bB.setIndex == s_AwakeSetIndex && outPartition.awakeToGpuSlot[bB.localIndex] == s_NullIndex){
                        outPartition.awakeToGpuSlot[bB.localIndex] = cast<u32>(outPartition.gpuAwakeIndices.size());
                        outPartition.gpuAwakeIndices.push_back(bB.localIndex);
                        outPartition.gpuAwakeWriteBack.push_back(0u);
                    }
                    outPartition.gpuColorOnlyContactIds[c].push_back(cId);
                }
            }
            else{
                const u32 slotIdx = cast<u32>(outPartition.cpuColorContactIds[c].size());
                outPartition.cpuColorContactIds[c].push_back(cId);
                if(compIdx != s_NullIndex){
                    const u32 cci = compToCpuCompIdx[compIdx];
                    if(cci != s_NullIndex){
                        CpuContactSlotRef slotRef;
                        slotRef.color = cast<u32>(c);
                        slotRef.index = slotIdx;
                        stagedCpuContactSlots.push_back(slotRef);
                        stagedCpuContactComps.push_back(cci);
                        ++outPartition.cpuCompContactOffsets[cci + 1u];
                    }
                }
            }
        }
    }

    for(u32 ci = 1u; ci <= cpuCompCount; ++ci)
        outPartition.cpuCompContactOffsets[ci] += outPartition.cpuCompContactOffsets[ci - 1u];
    if(!stagedCpuContactSlots.empty()){
        mut Vector<u32> cpuConCursors = outPartition.scratchCursors;
        cpuConCursors.resize(outPartition.cpuCompContactOffsets.size());
        for(usize ci = 0u; ci < outPartition.cpuCompContactOffsets.size(); ++ci)
            cpuConCursors[ci] = outPartition.cpuCompContactOffsets[ci];
        outPartition.cpuCompContactSlots.resize(stagedCpuContactSlots.size());
        for(usize k = 0u; k < stagedCpuContactSlots.size(); ++k){
            const u32 cci = stagedCpuContactComps[k];
            const u32 dst = cpuConCursors[cci];
            cpuConCursors[cci] = dst + 1u;
            outPartition.cpuCompContactSlots[dst] = stagedCpuContactSlots[k];
        }
    }

    if(!stagedContactIds.empty()){
        mut Vector<u32> contactCursors = outPartition.scratchIslandCursors;
        contactCursors.clear();
        contactCursors.resize(totalIslandCount, 0u);
        u32 runningCon = 0u;
        for(u32 si = 0u; si < totalIslandCount; ++si){
            outPartition.gpuIslandSlices[si].contactOffset = runningCon;
            contactCursors[si] = runningCon;
            runningCon += outPartition.gpuIslandSlices[si].contactCount;
        }
        outPartition.gpuIslandContactIds.resize(stagedContactIds.size(), 0u);
        for(usize k = 0u; k < stagedContactIds.size(); ++k){
            const u32 si = stagedContactIslands[k];
            const u32 dst = contactCursors[si];
            contactCursors[si] = dst + 1u;
            outPartition.gpuIslandContactIds[dst] = stagedContactIds[k];
        }
    }

    mut Vector<u32> stagedJointIds = outPartition.scratchStagedJointIds;
    mut Vector<u32> stagedJointIslands = outPartition.scratchStagedJointIslands;
    mut Vector<u32> stagedCpuJointLocalIds = outPartition.scratchStagedCpuJointLocalIds;
    mut Vector<u32> stagedCpuJointComps = outPartition.scratchStagedCpuJointComps;
    stagedJointIds.clear();
    stagedJointIslands.clear();
    stagedCpuJointLocalIds.clear();
    stagedCpuJointComps.clear();
    outPartition.cpuCompJointOffsets.resize(cpuCompCount + 1u, 0u);
    for(usize ji = 0u; ji < activeJointIds.size(); ++ji){
        const u32 jId = activeJointIds[ji];
        in Joint joint = world.m_joints[jId];
        in Body bA = world.m_bodies[joint.edges[0u].bodyId];
        in Body bB = world.m_bodies[joint.edges[1u].bodyId];

        u8 owner = 0u;
        u32 compIdx = s_NullIndex;
        if(bA.type == BodyType::Dynamic && bA.setIndex == s_AwakeSetIndex){
            owner = outPartition.awakeBodyOwner[bA.localIndex];
            compIdx = awakeCompIdx[bA.localIndex];
        }
        else if(bB.type == BodyType::Dynamic && bB.setIndex == s_AwakeSetIndex){
            owner = outPartition.awakeBodyOwner[bB.localIndex];
            compIdx = awakeCompIdx[bB.localIndex];
        }

        if(owner != 0u){
            outPartition.gpuJointIds.push_back(jId);
            u32 islandIdx = s_NullIndex;
            if(compIdx != s_NullIndex)
                islandIdx = compToIslandIdx[compIdx];
            if(islandIdx != s_NullIndex){
                stagedJointIds.push_back(jId);
                stagedJointIslands.push_back(islandIdx);
                ++outPartition.gpuIslandSlices[islandIdx].jointCount;
            }
            else{
                if(bA.setIndex == s_AwakeSetIndex && outPartition.awakeToGpuSlot[bA.localIndex] == s_NullIndex){
                    outPartition.awakeToGpuSlot[bA.localIndex] = cast<u32>(outPartition.gpuAwakeIndices.size());
                    outPartition.gpuAwakeIndices.push_back(bA.localIndex);
                    outPartition.gpuAwakeWriteBack.push_back(0u);
                }
                if(bB.setIndex == s_AwakeSetIndex && outPartition.awakeToGpuSlot[bB.localIndex] == s_NullIndex){
                    outPartition.awakeToGpuSlot[bB.localIndex] = cast<u32>(outPartition.gpuAwakeIndices.size());
                    outPartition.gpuAwakeIndices.push_back(bB.localIndex);
                    outPartition.gpuAwakeWriteBack.push_back(0u);
                }
                outPartition.gpuColorOnlyJointIds.push_back(jId);
            }
        }
        else{
            const u32 localJointIdx = cast<u32>(outPartition.cpuJointIds.size());
            outPartition.cpuJointIds.push_back(jId);
            if(compIdx != s_NullIndex){
                const u32 cci = compToCpuCompIdx[compIdx];
                if(cci != s_NullIndex){
                    stagedCpuJointLocalIds.push_back(localJointIdx);
                    stagedCpuJointComps.push_back(cci);
                    ++outPartition.cpuCompJointOffsets[cci + 1u];
                }
            }
        }
    }

    for(u32 ci = 1u; ci <= cpuCompCount; ++ci)
        outPartition.cpuCompJointOffsets[ci] += outPartition.cpuCompJointOffsets[ci - 1u];
    if(!stagedCpuJointLocalIds.empty()){
        mut Vector<u32> cpuJointCursors = outPartition.scratchCursors;
        cpuJointCursors.resize(outPartition.cpuCompJointOffsets.size());
        for(usize ci = 0u; ci < outPartition.cpuCompJointOffsets.size(); ++ci)
            cpuJointCursors[ci] = outPartition.cpuCompJointOffsets[ci];
        outPartition.cpuCompJointIndices.resize(stagedCpuJointLocalIds.size(), 0u);
        for(usize k = 0u; k < stagedCpuJointLocalIds.size(); ++k){
            const u32 cci = stagedCpuJointComps[k];
            const u32 dst = cpuJointCursors[cci];
            cpuJointCursors[cci] = dst + 1u;
            outPartition.cpuCompJointIndices[dst] = stagedCpuJointLocalIds[k];
        }
    }

    outPartition.cpuCanSolveParallel = (cpuCompCount >= 2u && !anyCpuCompHasKinematic);

    if(!stagedJointIds.empty()){
        mut Vector<u32> jointCursors = outPartition.scratchIslandCursors;
        jointCursors.clear();
        jointCursors.resize(totalIslandCount, 0u);
        u32 runningJoint = 0u;
        for(u32 si = 0u; si < totalIslandCount; ++si){
            outPartition.gpuIslandSlices[si].jointOffset = runningJoint;
            jointCursors[si] = runningJoint;
            runningJoint += outPartition.gpuIslandSlices[si].jointCount;
        }
        outPartition.gpuIslandJointIds.resize(stagedJointIds.size(), 0u);
        for(usize k = 0u; k < stagedJointIds.size(); ++k){
            const u32 si = stagedJointIslands[k];
            const u32 dst = jointCursors[si];
            jointCursors[si] = dst + 1u;
            outPartition.gpuIslandJointIds[dst] = stagedJointIds[k];
        }
    }
}

void ResizeConstraintStepCaches(
    in Array<Vector<ContactConstraint>, s_GraphColorCount> colorConstraints,
    in Vector<JointConstraint> jointConstraints,
    mut Array<Vector<ContactConstraintStepCache>, s_GraphColorCount> colorCaches,
    mut Vector<JointConstraintStepCache> jointCaches
){
    for(usize c = 0u; c < s_GraphColorCount; ++c)
        colorCaches[c].resize(colorConstraints[c].size());
    jointCaches.resize(jointConstraints.size());
}

void FinalizeDynamicBodiesCpu(
    mut PhysicsWorld world,
    in Span<u32> dynIndices,
    in usize dynCount,
    in usize totalAwake,
    in b8 contiguousAwake,
    in f32 dt,
    mut CpuTaskScheduler cpuScheduler
){
    if(dynCount == 0u)
        return;

    if(cpuScheduler.isParallelEnabled() && dynCount >= s_CpuColorParallelThreshold){
        const usize grain = ComputePhysicsGrain(cpuScheduler, dynCount, cast<usize>(64u));
        if(contiguousAwake && dynCount == totalAwake){
            const auto res = cpuScheduler.parallelFor(
                0u,
                totalAwake,
                grain,
                lambda[mut world, in dt](in usize idx) -> void{
                    FinalizeAwakeBodyAt(world, dt, idx);
                },
                CpuTaskOptions()
            );
            if(res.has_value())
                return;
        }
        else{
            const auto res = cpuScheduler.parallelFor(
                0u,
                dynCount,
                grain,
                lambda[mut world, in dynIndices, in dt](in usize idx) -> void{
                    FinalizeAwakeBodyAt(world, dt, cast<usize>(dynIndices[idx]));
                },
                CpuTaskOptions()
            );
            if(res.has_value())
                return;
        }
    }

    for(usize idx = 0u; idx < dynCount; ++idx)
        FinalizeAwakeBodyAt(world, dt, cast<usize>(dynIndices[idx]));
}

void SolveSingleComponentBatchCpu(
    mut PhysicsWorld world,
    mut Vector<BodySim> sims,
    mut Vector<BodyState> states,
    mut Array<Vector<ContactConstraint>, s_GraphColorCount> colorConstraints,
    mut Array<Vector<ContactConstraintStepCache>, s_GraphColorCount> colorCaches,
    mut Vector<JointConstraint> jointConstraints,
    mut Vector<JointConstraintStepCache> jointCaches,
    mut Array<Vector<u8>, s_GraphColorCount> contactHitFlags,
    mut Vector<u8> jointBreakFlags,
    in Span<u32> compBodyIndices,
    in u32 bodyStart,
    in u32 bodyEnd,
    in Span<CpuContactSlotRef> compContactSlots,
    in u32 contactStart,
    in u32 contactEnd,
    in Span<u32> compJointIndices,
    in u32 jointStart,
    in u32 jointEnd,
    in VectorSingle gravity,
    in u32 subStepCount,
    in f32 h,
    in f32 invH,
    in f32 maxLinVel,
    in f32 restThresh,
    in f32 hitThresh,
    in b8 enableWarmStarting,
    in b8 contactCachesPrebuilt
){
    if(!contactCachesPrebuilt){
        for(u32 ci = contactStart; ci < contactEnd; ++ci){
            const CpuContactSlotRef ref = compContactSlots[ci];
            BuildContactConstraintStepCache(colorConstraints[ref.color][ref.index], colorCaches[ref.color][ref.index]);
        }
    }
    for(u32 ji = jointStart; ji < jointEnd; ++ji){
        const u32 jointIdx = compJointIndices[ji];
        BuildJointConstraintStepCache(states, jointConstraints[jointIdx], jointCaches[jointIdx]);
    }

    for(u32 subStep = 0u; subStep < subStepCount; ++subStep){
        for(u32 bi = bodyStart; bi < bodyEnd; ++bi)
            IntegrateBodyVelocitiesRange(sims, states, gravity, h, maxLinVel, cast<usize>(compBodyIndices[bi]));

        if(enableWarmStarting){
            for(u32 ci = contactStart; ci < contactEnd; ++ci){
                const CpuContactSlotRef ref = compContactSlots[ci];
                WarmStartContactConstraintCached(states, colorConstraints[ref.color][ref.index], colorCaches[ref.color][ref.index]);
            }
            for(u32 ji = jointStart; ji < jointEnd; ++ji)
                WarmStartJointConstraint(states, jointConstraints[compJointIndices[ji]]);
        }
        else if(subStep > 0u){
            for(u32 ci = contactStart; ci < contactEnd; ++ci){
                const CpuContactSlotRef ref = compContactSlots[ci];
                ResetContactConstraintSubStepImpulses(colorConstraints[ref.color][ref.index]);
            }
            for(u32 ji = jointStart; ji < jointEnd; ++ji)
                ResetJointConstraintSubStepImpulses(jointConstraints[compJointIndices[ji]]);
        }

        for(u32 ci = contactStart; ci < contactEnd; ++ci){
            const CpuContactSlotRef ref = compContactSlots[ci];
            SolveContactConstraintCached(states, colorConstraints[ref.color][ref.index], colorCaches[ref.color][ref.index], invH, true);
        }
        for(u32 ji = jointStart; ji < jointEnd; ++ji){
            const u32 jointIdx = compJointIndices[ji];
            SolveJointConstraintCached(states, jointConstraints[jointIdx], jointCaches[jointIdx], h, true);
        }

        for(u32 bi = bodyStart; bi < bodyEnd; ++bi)
            IntegrateBodyPositionsAt(states, h, cast<usize>(compBodyIndices[bi]));

        for(u32 ci = contactStart; ci < contactEnd; ++ci){
            const CpuContactSlotRef ref = compContactSlots[ci];
            SolveContactConstraintCached(states, colorConstraints[ref.color][ref.index], colorCaches[ref.color][ref.index], invH, false);
        }
        for(u32 ji = jointStart; ji < jointEnd; ++ji){
            const u32 jointIdx = compJointIndices[ji];
            SolveJointConstraintCached(states, jointConstraints[jointIdx], jointCaches[jointIdx], h, false);
        }
    }

    for(u32 ci = contactStart; ci < contactEnd; ++ci){
        const CpuContactSlotRef ref = compContactSlots[ci];
        ApplyRestitutionContactConstraint(states, colorConstraints[ref.color][ref.index], restThresh);
        in ContactConstraint cc = colorConstraints[ref.color][ref.index];
        mut Contact contact = world.m_contacts[cc.contactId];
        contactHitFlags[ref.color][ref.index] = StoreContactConstraintImpulsesFast(cc, contact, hitThresh);
    }
    for(u32 ji = jointStart; ji < jointEnd; ++ji){
        const u32 jointIdx = compJointIndices[ji];
        in JointConstraint jc = jointConstraints[jointIdx];
        mut Joint joint = world.m_joints[jc.jointId];
        jointBreakFlags[jointIdx] = StoreJointImpulsesFast(jc, invH, joint);
    }
}

Expected<b8> TrySolvePartitionComponentsParallelCpu(
    mut PhysicsWorld world,
    in Vector<u32> awakeIndices,
    mut Array<Vector<ContactConstraint>, s_GraphColorCount> colorConstraints,
    mut Vector<JointConstraint> jointConstraints,
    in f32 dt,
    in u32 subStepCount,
    mut CpuTaskScheduler cpuScheduler,
    in b8 contactCachesPrebuilt
){
    const usize bodyCount = awakeIndices.size();
    if(!cpuScheduler.isParallelEnabled() || bodyCount < 24u || dt <= 0.0f || subStepCount == 0u)
        return false;

    const usize totalAwake = world.m_solverSets[s_AwakeSetIndex].states.size();
    if(totalAwake == 0u)
        return false;

    const usize awakeIslandCount = world.m_solverSets[s_AwakeSetIndex].islands.size();
    if(bodyCount == totalAwake && awakeIslandCount == 1u){
        const u32 singleIslandId = world.m_solverSets[s_AwakeSetIndex].islands[0u];
        if(singleIslandId < world.m_islands.size()){
            in Island singleIsl = world.m_islands[singleIslandId];
            if(singleIsl.alive && singleIsl.setIndex == s_AwakeSetIndex && singleIsl.bodies.size() == totalAwake && singleIsl.constraintRemoveCount == 0u)
                return false;
        }
    }

    mut Vector<u32> awakeToLocal = world.m_cpuScratch.parAwakeToLocal;
    awakeToLocal.clear();
    awakeToLocal.resize(totalAwake, s_NullIndex);
    mut Vector<u32> dynAwakeIndices = world.m_cpuScratch.parDynAwakeIndices;
    mut Vector<u32> kinAwakeIndices = world.m_cpuScratch.parKinAwakeIndices;
    dynAwakeIndices.clear();
    kinAwakeIndices.clear();
    dynAwakeIndices.reserve(bodyCount);

    const u32 dynBit = cast<u32>(BodyFlags::Dynamic);
    in Vector<BodyState> statesView = world.m_solverSets[s_AwakeSetIndex].states;
    for(usize i = 0u; i < bodyCount; ++i){
        const u32 awakeIdx = awakeIndices[i];
        if(awakeIdx >= totalAwake)
            continue;
        if((statesView[awakeIdx].flags() & dynBit) != 0u){
            awakeToLocal[awakeIdx] = cast<u32>(dynAwakeIndices.size());
            dynAwakeIndices.push_back(awakeIdx);
        }
        else{
            kinAwakeIndices.push_back(awakeIdx);
        }
    }

    const usize dynCount = dynAwakeIndices.size();
    if(dynCount < 2u)
        return false;

    in Vector<BodySim> simsView = world.m_solverSets[s_AwakeSetIndex].sims;
    b8 canTryIslandFastPath = (bodyCount == totalAwake && kinAwakeIndices.empty() && awakeIslandCount >= 2u);
    mut Vector<u64> crossIslandEdges = world.m_cpuScratch.parCrossIslandEdges;
    crossIslandEdges.clear();
    usize totalContacts = 0u;
    for(usize c = 0u; c < s_GraphColorCount; ++c){
        in Vector<ContactConstraint> cons = colorConstraints[c];
        totalContacts += cons.size();
        for(usize idx = 0u; idx < cons.size(); ++idx){
            in ContactConstraint cc = cons[idx];
            if(cc.pointCount == 0u)
                continue;
            const u32 idxA = cc.indexA;
            const u32 idxB = cc.indexB;
            if(idxA != s_NullIndex && (statesView[idxA].flags() & dynBit) == 0u)
                return false;
            if(idxB != s_NullIndex && (statesView[idxB].flags() & dynBit) == 0u)
                return false;
            if(canTryIslandFastPath && idxA != s_NullIndex && idxB != s_NullIndex){
                in Body bA = world.m_bodies[simsView[idxA].bodyId];
                in Body bB = world.m_bodies[simsView[idxB].bodyId];
                if(bA.islandId >= world.m_islands.size() || bB.islandId >= world.m_islands.size()){
                    canTryIslandFastPath = false;
                }
                else if(bA.islandId != bB.islandId){
                    in Island islA = world.m_islands[bA.islandId];
                    in Island islB = world.m_islands[bB.islandId];
                    if(
                        !islA.alive || islA.setIndex != s_AwakeSetIndex || islA.localIndex >= awakeIslandCount
                        || !islB.alive || islB.setIndex != s_AwakeSetIndex || islB.localIndex >= awakeIslandCount
                    )
                        canTryIslandFastPath = false;
                    else if(islA.localIndex != islB.localIndex)
                        crossIslandEdges.push_back((cast<u64>(islA.localIndex) << 32u) | cast<u64>(islB.localIndex));
                }
            }
        }
    }

    for(usize ji = 0u; ji < jointConstraints.size(); ++ji){
        in JointConstraint jc = jointConstraints[ji];
        const u32 idxA = jc.indexA;
        const u32 idxB = jc.indexB;
        if(idxA != s_NullIndex && (statesView[idxA].flags() & dynBit) == 0u)
            return false;
        if(idxB != s_NullIndex && (statesView[idxB].flags() & dynBit) == 0u)
            return false;
        if(canTryIslandFastPath && idxA != s_NullIndex && idxB != s_NullIndex){
            in Body bA = world.m_bodies[simsView[idxA].bodyId];
            in Body bB = world.m_bodies[simsView[idxB].bodyId];
            if(bA.islandId >= world.m_islands.size() || bB.islandId >= world.m_islands.size()){
                canTryIslandFastPath = false;
            }
            else if(bA.islandId != bB.islandId){
                in Island islA = world.m_islands[bA.islandId];
                in Island islB = world.m_islands[bB.islandId];
                if(
                    !islA.alive || islA.setIndex != s_AwakeSetIndex || islA.localIndex >= awakeIslandCount
                    || !islB.alive || islB.setIndex != s_AwakeSetIndex || islB.localIndex >= awakeIslandCount
                )
                    canTryIslandFastPath = false;
                else if(islA.localIndex != islB.localIndex)
                    crossIslandEdges.push_back((cast<u64>(islA.localIndex) << 32u) | cast<u64>(islB.localIndex));
            }
        }
    }

    if(dynCount + totalContacts + jointConstraints.size() < 48u)
        return false;

    mut Vector<u32> rootToComp = world.m_cpuScratch.parRootToComp;
    mut Vector<u32> dynBodyComps = world.m_cpuScratch.parDynBodyComps;
    dynBodyComps.clear();
    dynBodyComps.resize(dynCount, 0u);
    usize compCount = 0u;

    if(canTryIslandFastPath){
        mut Vector<u32> islDsuParents = world.m_cpuScratch.parDsuParents;
        mut Vector<u8> islDsuRanks = world.m_cpuScratch.parDsuRanks;
        if(!crossIslandEdges.empty()){
            islDsuParents.resize(awakeIslandCount);
            islDsuRanks.clear();
            islDsuRanks.resize(awakeIslandCount, 0u);
            for(usize ii = 0u; ii < awakeIslandCount; ++ii)
                islDsuParents[ii] = cast<u32>(ii);
            for(usize ei = 0u; ei < crossIslandEdges.size(); ++ei){
                const u64 edge = crossIslandEdges[ei];
                JoinDisjointSets(cast<isize>(edge >> 32u), cast<isize>(edge & 0xffffffffull), islDsuParents, islDsuRanks);
            }
        }
        rootToComp.clear();
        rootToComp.resize(awakeIslandCount, s_NullIndex);
        for(usize i = 0u; i < dynCount; ++i){
            const u32 bodyId = simsView[dynAwakeIndices[i]].bodyId;
            const u32 islId = world.m_bodies[bodyId].islandId;
            if(islId >= world.m_islands.size()){
                canTryIslandFastPath = false;
                break;
            }
            in Island isl = world.m_islands[islId];
            if(!isl.alive || isl.setIndex != s_AwakeSetIndex || isl.localIndex >= awakeIslandCount){
                canTryIslandFastPath = false;
                break;
            }
            u32 islKey = isl.localIndex;
            if(!crossIslandEdges.empty())
                islKey = cast<u32>(FindDisjointRoot(cast<isize>(islKey), islDsuParents));
            u32 compIdx = rootToComp[islKey];
            if(compIdx == s_NullIndex){
                compIdx = cast<u32>(compCount);
                rootToComp[islKey] = compIdx;
                ++compCount;
            }
            dynBodyComps[i] = compIdx;
        }
    }

    if(!canTryIslandFastPath){
        mut Vector<u32> dsuParents = world.m_cpuScratch.parDsuParents;
        mut Vector<u8> dsuRanks = world.m_cpuScratch.parDsuRanks;
        dsuParents.resize(dynCount);
        dsuRanks.clear();
        dsuRanks.resize(dynCount, 0u);
        for(usize i = 0u; i < dynCount; ++i)
            dsuParents[i] = cast<u32>(i);

        for(usize c = 0u; c < s_GraphColorCount; ++c){
            in Vector<ContactConstraint> cons = colorConstraints[c];
            for(usize idx = 0u; idx < cons.size(); ++idx){
                in ContactConstraint cc = cons[idx];
                if(cc.pointCount == 0u)
                    continue;
                const u32 idxA = cc.indexA;
                const u32 idxB = cc.indexB;
                if(idxA != s_NullIndex && idxB != s_NullIndex){
                    const u32 locA = awakeToLocal[idxA];
                    const u32 locB = awakeToLocal[idxB];
                    if(locA != s_NullIndex && locB != s_NullIndex)
                        JoinDisjointSets(cast<isize>(locA), cast<isize>(locB), dsuParents, dsuRanks);
                }
            }
        }

        for(usize ji = 0u; ji < jointConstraints.size(); ++ji){
            in JointConstraint jc = jointConstraints[ji];
            const u32 idxA = jc.indexA;
            const u32 idxB = jc.indexB;
            if(idxA != s_NullIndex && idxB != s_NullIndex){
                const u32 locA = awakeToLocal[idxA];
                const u32 locB = awakeToLocal[idxB];
                if(locA != s_NullIndex && locB != s_NullIndex)
                    JoinDisjointSets(cast<isize>(locA), cast<isize>(locB), dsuParents, dsuRanks);
            }
        }

        compCount = 0u;
        rootToComp.clear();
        rootToComp.resize(dynCount, s_NullIndex);
        for(usize i = 0u; i < dynCount; ++i){
            const u32 root = cast<u32>(FindDisjointRoot(cast<isize>(i), dsuParents));
            u32 compIdx = rootToComp[root];
            if(compIdx == s_NullIndex){
                compIdx = cast<u32>(compCount);
                rootToComp[root] = compIdx;
                ++compCount;
            }
            dynBodyComps[i] = compIdx;
        }
    }

    if(compCount < 2u)
        return false;

    mut Vector<u32> compBodyOffsets = world.m_cpuScratch.parCompBodyOffsets;
    compBodyOffsets.clear();
    compBodyOffsets.resize(compCount + 1u, 0u);
    for(usize i = 0u; i < dynCount; ++i)
        ++compBodyOffsets[dynBodyComps[i] + 1u];
    for(usize ci = 1u; ci <= compCount; ++ci)
        compBodyOffsets[ci] += compBodyOffsets[ci - 1u];
    mut Vector<u32> compBodyCursors = world.m_cpuScratch.parCompBodyCursors;
    compBodyCursors.resize(compCount + 1u);
    for(usize ci = 0u; ci <= compCount; ++ci)
        compBodyCursors[ci] = compBodyOffsets[ci];
    mut Vector<u32> compBodyIndices = world.m_cpuScratch.parCompBodyIndices;
    compBodyIndices.clear();
    compBodyIndices.resize(dynCount, 0u);
    for(usize i = 0u; i < dynCount; ++i){
        const u32 compIdx = dynBodyComps[i];
        const u32 dst = compBodyCursors[compIdx];
        compBodyCursors[compIdx] = dst + 1u;
        compBodyIndices[dst] = dynAwakeIndices[i];
    }

    mut Vector<CpuContactSlotRef> flatContactSlots = world.m_cpuScratch.parFlatContactSlots;
    mut Vector<u32> flatContactComps = world.m_cpuScratch.parFlatContactComps;
    flatContactSlots.clear();
    flatContactComps.clear();
    flatContactSlots.reserve(totalContacts);
    flatContactComps.reserve(totalContacts);
    mut Vector<u32> compContactOffsets = world.m_cpuScratch.parCompContactOffsets;
    compContactOffsets.clear();
    compContactOffsets.resize(compCount + 1u, 0u);
    for(usize c = 0u; c < s_GraphColorCount; ++c){
        in Vector<ContactConstraint> cons = colorConstraints[c];
        for(usize idx = 0u; idx < cons.size(); ++idx){
            in ContactConstraint cc = cons[idx];
            if(cc.pointCount == 0u)
                continue;
            u32 loc = s_NullIndex;
            if(cc.indexA != s_NullIndex)
                loc = awakeToLocal[cc.indexA];
            else if(cc.indexB != s_NullIndex)
                loc = awakeToLocal[cc.indexB];
            if(loc == s_NullIndex)
                continue;
            const u32 compIdx = dynBodyComps[loc];
            CpuContactSlotRef slotRef;
            slotRef.color = cast<u32>(c);
            slotRef.index = cast<u32>(idx);
            flatContactSlots.push_back(slotRef);
            flatContactComps.push_back(compIdx);
            ++compContactOffsets[compIdx + 1u];
        }
    }
    for(usize ci = 1u; ci <= compCount; ++ci)
        compContactOffsets[ci] += compContactOffsets[ci - 1u];
    mut Vector<u32> compContactCursors = world.m_cpuScratch.parCursors;
    compContactCursors.resize(compCount + 1u);
    for(usize ci = 0u; ci <= compCount; ++ci)
        compContactCursors[ci] = compContactOffsets[ci];
    mut Vector<CpuContactSlotRef> compContactSlots = world.m_cpuScratch.parCompContactSlots;
    compContactSlots.resize(flatContactSlots.size());
    for(usize fi = 0u; fi < flatContactSlots.size(); ++fi){
        const u32 compIdx = flatContactComps[fi];
        const u32 dst = compContactCursors[compIdx];
        compContactCursors[compIdx] = dst + 1u;
        compContactSlots[dst] = flatContactSlots[fi];
    }

    mut Vector<u32> flatJointIds = world.m_cpuScratch.parFlatJointIds;
    mut Vector<u32> flatJointComps = world.m_cpuScratch.parFlatJointComps;
    flatJointIds.clear();
    flatJointComps.clear();
    flatJointIds.reserve(jointConstraints.size());
    flatJointComps.reserve(jointConstraints.size());
    mut Vector<u32> compJointOffsets = world.m_cpuScratch.parCompJointOffsets;
    compJointOffsets.clear();
    compJointOffsets.resize(compCount + 1u, 0u);
    for(usize ji = 0u; ji < jointConstraints.size(); ++ji){
        in JointConstraint jc = jointConstraints[ji];
        u32 loc = s_NullIndex;
        if(jc.indexA != s_NullIndex)
            loc = awakeToLocal[jc.indexA];
        else if(jc.indexB != s_NullIndex)
            loc = awakeToLocal[jc.indexB];
        if(loc == s_NullIndex)
            continue;
        const u32 compIdx = dynBodyComps[loc];
        flatJointIds.push_back(cast<u32>(ji));
        flatJointComps.push_back(compIdx);
        ++compJointOffsets[compIdx + 1u];
    }
    for(usize ci = 1u; ci <= compCount; ++ci)
        compJointOffsets[ci] += compJointOffsets[ci - 1u];
    mut Vector<u32> compJointCursors = world.m_cpuScratch.parCursors;
    compJointCursors.resize(compCount + 1u);
    for(usize ci = 0u; ci <= compCount; ++ci)
        compJointCursors[ci] = compJointOffsets[ci];
    mut Vector<u32> compJointIndices = world.m_cpuScratch.parCompJointIndices;
    compJointIndices.clear();
    compJointIndices.resize(flatJointIds.size(), 0u);
    for(usize fi = 0u; fi < flatJointIds.size(); ++fi){
        const u32 compIdx = flatJointComps[fi];
        const u32 dst = compJointCursors[compIdx];
        compJointCursors[compIdx] = dst + 1u;
        compJointIndices[dst] = flatJointIds[fi];
    }

    mut Vector<u32> compScores = world.m_cpuScratch.parCompScores;
    mut Vector<usize> compOrder = world.m_cpuScratch.parCompOrder;
    compScores.clear();
    compScores.resize(compCount, 0u);
    compOrder.resize(compCount);
    for(usize ci = 0u; ci < compCount; ++ci){
        const u32 bCnt = compBodyOffsets[ci + 1u] - compBodyOffsets[ci];
        const u32 cCnt = compContactOffsets[ci + 1u] - compContactOffsets[ci];
        const u32 jCnt = compJointOffsets[ci + 1u] - compJointOffsets[ci];
        compScores[ci] = bCnt + cCnt * 2u + jCnt * 3u;
        compOrder[ci] = ci;
    }

    const Span<u32> scoreSpan = Span<u32>(compScores);
    SortSequence<usize>(
        compOrder,
        lambda[in scoreSpan](in usize lhs, in usize rhs) -> b8{
            return scoreSpan[lhs] > scoreSpan[rhs];
        }
    );

    const usize bucketCount = ComputePhysicsBucketCount(cpuScheduler, compCount);
    mut Vector<Vector<usize>> buckets = world.m_cpuScratch.parBuckets;
    buckets.resize(bucketCount);
    for(usize b = 0u; b < bucketCount; ++b)
        buckets[b].clear();
    mut Vector<u64> bucketLoads = world.m_cpuScratch.parBucketLoads;
    bucketLoads.clear();
    bucketLoads.resize(bucketCount, 0u);
    for(usize oi = 0u; oi < compOrder.size(); ++oi){
        const usize ci = compOrder[oi];
        usize bestBucket = 0u;
        for(usize b = 1u; b < bucketCount; ++b){
            if(bucketLoads[b] < bucketLoads[bestBucket])
                bestBucket = b;
        }
        buckets[bestBucket].push_back(ci);
        bucketLoads[bestBucket] += cast<u64>(compScores[ci]);
    }

    const f32 h = dt / cast<f32>(subStepCount);
    const f32 invH = 1.0f / h;
    const VectorSingle gravity = VectorSingle(world.m_def.gravity);
    const f32 maxLinVel = world.m_def.maxLinearVelocity;
    const f32 restThresh = world.m_def.restitutionThreshold;
    const b8 enableWarmStarting = world.m_enableWarmStarting;
    mut Vector<BodySim> sims = world.m_solverSets[s_AwakeSetIndex].sims;
    mut Vector<BodyState> states = world.m_solverSets[s_AwakeSetIndex].states;
    const Span<u32> bodyOffSpan = Span<u32>(compBodyOffsets);
    const Span<u32> bodyIdxSpan = Span<u32>(compBodyIndices);
    const Span<u32> contactOffSpan = Span<u32>(compContactOffsets);
    const Span<CpuContactSlotRef> contactSlotSpan = Span<CpuContactSlotRef>(compContactSlots);
    const Span<u32> jointOffSpan = Span<u32>(compJointOffsets);
    const Span<u32> jointIdxSpan = Span<u32>(compJointIndices);
    const Span<Vector<usize>> bucketSpan = Span<Vector<usize>>(buckets);
    mut Array<Vector<ContactConstraintStepCache>, s_GraphColorCount> colorCaches = world.m_cpuScratch.colorConstraintCaches;
    mut Vector<JointConstraintStepCache> jointCaches = world.m_cpuScratch.jointConstraintCaches;
    if(!contactCachesPrebuilt)
        ResizeConstraintStepCaches(colorConstraints, jointConstraints, colorCaches, jointCaches);
    else
        jointCaches.resize(jointConstraints.size());

    const f32 hitThresh = world.m_def.hitEventThreshold;
    mut Array<Vector<u8>, s_GraphColorCount> contactHitFlags = world.m_cpuScratch.parContactHitFlags;
    for(usize c = 0u; c < s_GraphColorCount; ++c){
        contactHitFlags[c].clear();
        contactHitFlags[c].resize(colorConstraints[c].size(), 0u);
    }
    mut Vector<u8> jointBreakFlags = world.m_cpuScratch.parJointBreakFlags;
    jointBreakFlags.clear();
    jointBreakFlags.resize(jointConstraints.size(), 0u);

    const auto res = cpuScheduler.parallelFor(
        0u,
        bucketCount,
        1u,
        lambda[mut world, mut sims, mut states, mut colorConstraints, mut colorCaches, mut jointConstraints, mut jointCaches, mut contactHitFlags, mut jointBreakFlags, in bodyOffSpan, in bodyIdxSpan, in contactOffSpan, in contactSlotSpan, in jointOffSpan, in jointIdxSpan, in bucketSpan, in gravity, in subStepCount, in h, in invH, in maxLinVel, in restThresh, in hitThresh, in enableWarmStarting, in contactCachesPrebuilt](in usize bucketIdx) -> void{
            in Vector<usize> compIds = bucketSpan[bucketIdx];
            for(usize k = 0u; k < compIds.size(); ++k){
                const usize ci = compIds[k];
                SolveSingleComponentBatchCpu(
                    world,
                    sims,
                    states,
                    colorConstraints,
                    colorCaches,
                    jointConstraints,
                    jointCaches,
                    contactHitFlags,
                    jointBreakFlags,
                    bodyIdxSpan,
                    bodyOffSpan[ci],
                    bodyOffSpan[ci + 1u],
                    contactSlotSpan,
                    contactOffSpan[ci],
                    contactOffSpan[ci + 1u],
                    jointIdxSpan,
                    jointOffSpan[ci],
                    jointOffSpan[ci + 1u],
                    gravity,
                    subStepCount,
                    h,
                    invH,
                    maxLinVel,
                    restThresh,
                    hitThresh,
                    enableWarmStarting,
                    contactCachesPrebuilt
                );
            }
        },
        CpuTaskOptions()
    );
    if(!res.has_value())
        return MakeUnexpected(Failure());

    for(usize ki = 0u; ki < kinAwakeIndices.size(); ++ki){
        const usize kIdx = cast<usize>(kinAwakeIndices[ki]);
        for(u32 subStep = 0u; subStep < subStepCount; ++subStep)
            IntegrateBodyPositionsAt(states, h, kIdx);
        FinalizeAwakeBodyAt(world, dt, kIdx);
    }
    FinalizeDynamicBodiesCpu(world, Span<u32>(dynAwakeIndices), dynCount, totalAwake, kinAwakeIndices.empty() && bodyCount == totalAwake, dt, cpuScheduler);
    world.m_cpuScratch.parImpulsesStored = true;

    return true;
}

b8 SolvePartitionSubStepsCpuImpl(
    mut PhysicsWorld world,
    in Vector<u32> awakeIndices,
    mut Array<Vector<ContactConstraint>, s_GraphColorCount> colorConstraints,
    mut Vector<JointConstraint> jointConstraints,
    in f32 dt,
    in u32 subStepCount,
    mut CpuTaskScheduler cpuScheduler,
    in b8 contactCachesPrebuilt
){
    world.m_cpuScratch.parImpulsesStored = false;
    const usize bodyCount = awakeIndices.size();
    if(bodyCount == 0u || dt <= 0.0f || subStepCount == 0u)
        return true;

    const Expected<b8> handledParallel = TrySolvePartitionComponentsParallelCpu(world, awakeIndices, colorConstraints, jointConstraints, dt, subStepCount, cpuScheduler, contactCachesPrebuilt);
    if(!handledParallel.has_value())
        return false;
    if(handledParallel.value())
        return true;

    const f32 h = dt / cast<f32>(subStepCount);
    const f32 invH = 1.0f / h;
    const VectorSingle gravity = VectorSingle(world.m_def.gravity);
    const f32 maxLinVel = world.m_def.maxLinearVelocity;
    const f32 restThresh = world.m_def.restitutionThreshold;
    mut Vector<BodySim> sims = world.m_solverSets[s_AwakeSetIndex].sims;
    mut Vector<BodyState> states = world.m_solverSets[s_AwakeSetIndex].states;
    const Span<u32> awakeSpan = Span<u32>(awakeIndices);
    mut Array<Vector<ContactConstraintStepCache>, s_GraphColorCount> colorCaches = world.m_cpuScratch.colorConstraintCaches;
    mut Vector<JointConstraintStepCache> jointCaches = world.m_cpuScratch.jointConstraintCaches;
    if(!contactCachesPrebuilt){
        ResizeConstraintStepCaches(colorConstraints, jointConstraints, colorCaches, jointCaches);

        for(usize c = 0u; c < s_GraphColorCount; ++c){
            const usize cCount = colorConstraints[c].size();
            if(cCount == 0u)
                continue;
            if(cpuScheduler.isParallelEnabled() && cCount >= s_CpuColorParallelThreshold){
                const usize grain = ComputePhysicsGrain(cpuScheduler, cCount, cast<usize>(64u));
                const Span<ContactConstraint> colorSpan = Span<ContactConstraint>(colorConstraints[c]);
                const auto res = cpuScheduler.parallelFor(
                    0u,
                    cCount,
                    grain,
                    lambda[in colorSpan, mut colorCaches, in c](in usize idx) -> void{
                        BuildContactConstraintStepCache(colorSpan[idx], colorCaches[c][idx]);
                    },
                    CpuTaskOptions()
                );
                if(!res.has_value())
                    return false;
            }
            else{
                for(usize idx = 0u; idx < cCount; ++idx)
                    BuildContactConstraintStepCache(colorConstraints[c][idx], colorCaches[c][idx]);
            }
        }
    }
    else{
        jointCaches.resize(jointConstraints.size());
    }
    for(usize ji = 0u; ji < jointConstraints.size(); ++ji)
        BuildJointConstraintStepCache(states, jointConstraints[ji], jointCaches[ji]);

    for(u32 subStep = 0u; subStep < subStepCount; ++subStep){
        if(cpuScheduler.isParallelEnabled() && bodyCount >= s_CpuColorParallelThreshold){
            const usize grain = ComputePhysicsGrain(cpuScheduler, bodyCount, cast<usize>(64u));
            const auto res = cpuScheduler.parallelFor(
                0u,
                bodyCount,
                grain,
                lambda[mut sims, mut states, in awakeSpan, in gravity, in h, in maxLinVel](in usize idx) -> void{
                    IntegrateBodyVelocitiesRange(sims, states, gravity, h, maxLinVel, cast<usize>(awakeSpan[idx]));
                },
                CpuTaskOptions()
            );
            if(!res.has_value())
                return false;
        }
        else{
            for(usize idx = 0u; idx < bodyCount; ++idx)
                IntegrateBodyVelocitiesRange(sims, states, gravity, h, maxLinVel, cast<usize>(awakeIndices[idx]));
        }

        if(world.m_enableWarmStarting){
            for(usize c = 0u; c < s_OverflowColorIndex; ++c){
                const usize cCount = colorConstraints[c].size();
                if(cCount == 0u)
                    continue;
                if(cpuScheduler.isParallelEnabled() && cCount >= s_CpuColorParallelThreshold){
                    const usize grain = ComputePhysicsGrain(cpuScheduler, cCount, cast<usize>(64u));
                    const Span<ContactConstraint> colorSpan = Span<ContactConstraint>(colorConstraints[c]);
                    const Span<ContactConstraintStepCache> cacheSpan = Span<ContactConstraintStepCache>(colorCaches[c]);
                    const auto res = cpuScheduler.parallelFor(
                        0u,
                        cCount,
                        grain,
                        lambda[mut states, in colorSpan, in cacheSpan](in usize idx) -> void{
                            WarmStartContactConstraintCached(states, colorSpan[idx], cacheSpan[idx]);
                        },
                        CpuTaskOptions()
                    );
                    if(!res.has_value())
                        return false;
                }
                else{
                    for(usize idx = 0u; idx < cCount; ++idx)
                        WarmStartContactConstraintCached(states, colorConstraints[c][idx], colorCaches[c][idx]);
                }
            }
            for(usize idx = 0u; idx < colorConstraints[s_OverflowColorIndex].size(); ++idx)
                WarmStartContactConstraintCached(states, colorConstraints[s_OverflowColorIndex][idx], colorCaches[s_OverflowColorIndex][idx]);

            for(usize ji = 0u; ji < jointConstraints.size(); ++ji)
                WarmStartJointConstraint(states, jointConstraints[ji]);
        }
        else if(subStep > 0u){
            for(usize c = 0u; c < s_GraphColorCount; ++c){
                for(usize idx = 0u; idx < colorConstraints[c].size(); ++idx)
                    ResetContactConstraintSubStepImpulses(colorConstraints[c][idx]);
            }
            for(usize ji = 0u; ji < jointConstraints.size(); ++ji)
                ResetJointConstraintSubStepImpulses(jointConstraints[ji]);
        }

        for(usize c = 0u; c < s_OverflowColorIndex; ++c){
            const usize cCount = colorConstraints[c].size();
            if(cCount == 0u)
                continue;
            if(cpuScheduler.isParallelEnabled() && cCount >= s_CpuColorParallelThreshold){
                const usize grain = ComputePhysicsGrain(cpuScheduler, cCount, cast<usize>(64u));
                const Span<ContactConstraintStepCache> cacheSpan = Span<ContactConstraintStepCache>(colorCaches[c]);
                const auto res = cpuScheduler.parallelFor(
                    0u,
                    cCount,
                    grain,
                    lambda[mut states, mut colorConstraints, in cacheSpan, in c, in invH](in usize idx) -> void{
                        SolveContactConstraintCached(states, colorConstraints[c][idx], cacheSpan[idx], invH, true);
                    },
                    CpuTaskOptions()
                );
                if(!res.has_value())
                    return false;
            }
            else{
                for(usize idx = 0u; idx < cCount; ++idx)
                    SolveContactConstraintCached(states, colorConstraints[c][idx], colorCaches[c][idx], invH, true);
            }
        }
        for(usize idx = 0u; idx < colorConstraints[s_OverflowColorIndex].size(); ++idx)
            SolveContactConstraintCached(states, colorConstraints[s_OverflowColorIndex][idx], colorCaches[s_OverflowColorIndex][idx], invH, true);

        for(usize ji = 0u; ji < jointConstraints.size(); ++ji)
            SolveJointConstraintCached(states, jointConstraints[ji], jointCaches[ji], h, true);

        if(cpuScheduler.isParallelEnabled() && bodyCount >= s_CpuColorParallelThreshold){
            const usize grain = ComputePhysicsGrain(cpuScheduler, bodyCount, cast<usize>(64u));
            const auto res = cpuScheduler.parallelFor(
                0u,
                bodyCount,
                grain,
                lambda[mut states, in awakeSpan, in h](in usize idx) -> void{
                    IntegrateBodyPositionsAt(states, h, cast<usize>(awakeSpan[idx]));
                },
                CpuTaskOptions()
            );
            if(!res.has_value())
                return false;
        }
        else{
            for(usize idx = 0u; idx < bodyCount; ++idx)
                IntegrateBodyPositionsAt(states, h, cast<usize>(awakeIndices[idx]));
        }

        for(usize c = 0u; c < s_OverflowColorIndex; ++c){
            const usize cCount = colorConstraints[c].size();
            if(cCount == 0u)
                continue;
            if(cpuScheduler.isParallelEnabled() && cCount >= s_CpuColorParallelThreshold){
                const usize grain = ComputePhysicsGrain(cpuScheduler, cCount, cast<usize>(64u));
                const Span<ContactConstraintStepCache> cacheSpan = Span<ContactConstraintStepCache>(colorCaches[c]);
                const auto res = cpuScheduler.parallelFor(
                    0u,
                    cCount,
                    grain,
                    lambda[mut states, mut colorConstraints, in cacheSpan, in c, in invH](in usize idx) -> void{
                        SolveContactConstraintCached(states, colorConstraints[c][idx], cacheSpan[idx], invH, false);
                    },
                    CpuTaskOptions()
                );
                if(!res.has_value())
                    return false;
            }
            else{
                for(usize idx = 0u; idx < cCount; ++idx)
                    SolveContactConstraintCached(states, colorConstraints[c][idx], colorCaches[c][idx], invH, false);
            }
        }
        for(usize idx = 0u; idx < colorConstraints[s_OverflowColorIndex].size(); ++idx)
            SolveContactConstraintCached(states, colorConstraints[s_OverflowColorIndex][idx], colorCaches[s_OverflowColorIndex][idx], invH, false);

        for(usize ji = 0u; ji < jointConstraints.size(); ++ji)
            SolveJointConstraintCached(states, jointConstraints[ji], jointCaches[ji], h, false);
    }

    for(usize c = 0u; c < s_OverflowColorIndex; ++c){
        const usize cCount = colorConstraints[c].size();
        if(cCount == 0u)
            continue;
        if(cpuScheduler.isParallelEnabled() && cCount >= s_CpuColorParallelThreshold){
            const usize grain = ComputePhysicsGrain(cpuScheduler, cCount, cast<usize>(64u));
            const auto res = cpuScheduler.parallelFor(
                0u,
                cCount,
                grain,
                lambda[mut states, mut colorConstraints, in c, in restThresh](in usize idx) -> void{
                    ApplyRestitutionContactConstraint(states, colorConstraints[c][idx], restThresh);
                },
                CpuTaskOptions()
            );
            if(!res.has_value())
                return false;
        }
        else{
            for(usize idx = 0u; idx < cCount; ++idx)
                ApplyRestitutionContactConstraint(states, colorConstraints[c][idx], restThresh);
        }
    }
    for(usize idx = 0u; idx < colorConstraints[s_OverflowColorIndex].size(); ++idx)
        ApplyRestitutionContactConstraint(states, colorConstraints[s_OverflowColorIndex][idx], restThresh);

    if(cpuScheduler.isParallelEnabled() && bodyCount >= s_CpuColorParallelThreshold){
        const usize grain = ComputePhysicsGrain(cpuScheduler, bodyCount, cast<usize>(64u));
        const auto res = cpuScheduler.parallelFor(
            0u,
            bodyCount,
            grain,
            lambda[mut world, in awakeSpan, in dt](in usize idx) -> void{
                FinalizeAwakeBodyAt(world, dt, cast<usize>(awakeSpan[idx]));
            },
            CpuTaskOptions()
        );
        if(!res.has_value())
            return false;
    }
    else{
        for(usize idx = 0u; idx < bodyCount; ++idx)
            FinalizeAwakeBodyAt(world, dt, cast<usize>(awakeIndices[idx]));
    }
    return true;
}

b8 SolvePartitionSubStepsCpu(
    mut PhysicsWorld world,
    in Vector<u32> awakeIndices,
    mut Array<Vector<ContactConstraint>, s_GraphColorCount> colorConstraints,
    mut Vector<JointConstraint> jointConstraints,
    in f32 dt,
    in u32 subStepCount,
    mut CpuTaskScheduler cpuScheduler
){
    return SolvePartitionSubStepsCpuImpl(world, awakeIndices, colorConstraints, jointConstraints, dt, subStepCount, cpuScheduler, false);
}

b8 SolvePartitionSubStepsCpuWithPartition(
    mut PhysicsWorld world,
    in SolverWorkPartition partition,
    mut Array<Vector<ContactConstraint>, s_GraphColorCount> colorConstraints,
    mut Vector<JointConstraint> jointConstraints,
    in f32 dt,
    in u32 subStepCount,
    mut CpuTaskScheduler cpuScheduler
){
    world.m_cpuScratch.parImpulsesStored = false;
    const usize bodyCount = partition.cpuAwakeIndices.size();
    if(bodyCount == 0u || dt <= 0.0f || subStepCount == 0u)
        return true;

    const usize compCount = cast<usize>(partition.cpuComponentCount);
    const usize workItems = partition.cpuCompBodyIndices.size() + partition.cpuCompContactSlots.size() + partition.cpuCompJointIndices.size();
    if(cpuScheduler.isParallelEnabled() && partition.cpuCanSolveParallel && compCount >= 2u && bodyCount >= 24u && workItems >= 48u){
        mut Vector<usize> compOrder = world.m_cpuScratch.parCompOrder;
        compOrder.resize(compCount);
        for(usize ci = 0u; ci < compCount; ++ci)
            compOrder[ci] = ci;

        const Span<u32> scoreSpan = Span<u32>(partition.cpuCompWorkScores);
        SortSequence<usize>(
            compOrder,
            lambda[in scoreSpan](in usize lhs, in usize rhs) -> b8{
                return scoreSpan[lhs] > scoreSpan[rhs];
            }
        );

        const usize bucketCount = ComputePhysicsBucketCount(cpuScheduler, compCount);
        mut Vector<Vector<usize>> buckets = world.m_cpuScratch.parBuckets;
        buckets.resize(bucketCount);
        for(usize b = 0u; b < bucketCount; ++b)
            buckets[b].clear();
        mut Vector<u64> bucketLoads = world.m_cpuScratch.parBucketLoads;
        bucketLoads.clear();
        bucketLoads.resize(bucketCount, 0u);
        for(usize oi = 0u; oi < compOrder.size(); ++oi){
            const usize ci = compOrder[oi];
            usize bestBucket = 0u;
            for(usize b = 1u; b < bucketCount; ++b){
                if(bucketLoads[b] < bucketLoads[bestBucket])
                    bestBucket = b;
            }
            buckets[bestBucket].push_back(ci);
            bucketLoads[bestBucket] += cast<u64>(partition.cpuCompWorkScores[ci]);
        }

        const f32 h = dt / cast<f32>(subStepCount);
        const f32 invH = 1.0f / h;
        const VectorSingle gravity = VectorSingle(world.m_def.gravity);
        const f32 maxLinVel = world.m_def.maxLinearVelocity;
        const f32 restThresh = world.m_def.restitutionThreshold;
        const f32 hitThresh = world.m_def.hitEventThreshold;
        const b8 enableWarmStarting = world.m_enableWarmStarting;
        mut Vector<BodySim> sims = world.m_solverSets[s_AwakeSetIndex].sims;
        mut Vector<BodyState> states = world.m_solverSets[s_AwakeSetIndex].states;
        const Span<u32> bodyOffSpan = Span<u32>(partition.cpuCompBodyOffsets);
        const Span<u32> bodyIdxSpan = Span<u32>(partition.cpuCompBodyIndices);
        const Span<u32> contactOffSpan = Span<u32>(partition.cpuCompContactOffsets);
        const Span<CpuContactSlotRef> contactSlotSpan = Span<CpuContactSlotRef>(partition.cpuCompContactSlots);
        const Span<u32> jointOffSpan = Span<u32>(partition.cpuCompJointOffsets);
        const Span<u32> jointIdxSpan = Span<u32>(partition.cpuCompJointIndices);
        const Span<Vector<usize>> bucketSpan = Span<Vector<usize>>(buckets);
        mut Array<Vector<ContactConstraintStepCache>, s_GraphColorCount> colorCaches = world.m_cpuScratch.colorConstraintCaches;
        mut Vector<JointConstraintStepCache> jointCaches = world.m_cpuScratch.jointConstraintCaches;
        ResizeConstraintStepCaches(colorConstraints, jointConstraints, colorCaches, jointCaches);

        mut Array<Vector<u8>, s_GraphColorCount> contactHitFlags = world.m_cpuScratch.parContactHitFlags;
        for(usize c = 0u; c < s_GraphColorCount; ++c){
            contactHitFlags[c].clear();
            contactHitFlags[c].resize(colorConstraints[c].size(), 0u);
        }
        mut Vector<u8> jointBreakFlags = world.m_cpuScratch.parJointBreakFlags;
        jointBreakFlags.clear();
        jointBreakFlags.resize(jointConstraints.size(), 0u);

        const auto res = cpuScheduler.parallelFor(
            0u,
            bucketCount,
            1u,
            lambda[mut world, mut sims, mut states, mut colorConstraints, mut colorCaches, mut jointConstraints, mut jointCaches, mut contactHitFlags, mut jointBreakFlags, in bodyOffSpan, in bodyIdxSpan, in contactOffSpan, in contactSlotSpan, in jointOffSpan, in jointIdxSpan, in bucketSpan, in gravity, in subStepCount, in h, in invH, in maxLinVel, in restThresh, in hitThresh, in enableWarmStarting](in usize bucketIdx) -> void{
                in Vector<usize> compIds = bucketSpan[bucketIdx];
                for(usize k = 0u; k < compIds.size(); ++k){
                    const usize ci = compIds[k];
                    SolveSingleComponentBatchCpu(
                        world,
                        sims,
                        states,
                        colorConstraints,
                        colorCaches,
                        jointConstraints,
                        jointCaches,
                        contactHitFlags,
                        jointBreakFlags,
                        bodyIdxSpan,
                        bodyOffSpan[ci],
                        bodyOffSpan[ci + 1u],
                        contactSlotSpan,
                        contactOffSpan[ci],
                        contactOffSpan[ci + 1u],
                        jointIdxSpan,
                        jointOffSpan[ci],
                        jointOffSpan[ci + 1u],
                        gravity,
                        subStepCount,
                        h,
                        invH,
                        maxLinVel,
                        restThresh,
                        hitThresh,
                        enableWarmStarting,
                        false
                    );
                }
            },
            CpuTaskOptions()
        );
        if(!res.has_value())
            return false;

        for(usize ki = 0u; ki < partition.cpuKinAwakeIndices.size(); ++ki){
            const usize kIdx = cast<usize>(partition.cpuKinAwakeIndices[ki]);
            for(u32 subStep = 0u; subStep < subStepCount; ++subStep)
                IntegrateBodyPositionsAt(states, h, kIdx);
            FinalizeAwakeBodyAt(world, dt, kIdx);
        }
        const usize totalAwake = world.m_solverSets[s_AwakeSetIndex].states.size();
        FinalizeDynamicBodiesCpu(
            world,
            bodyIdxSpan,
            partition.cpuCompBodyIndices.size(),
            totalAwake,
            partition.cpuKinAwakeIndices.empty() && partition.cpuCompBodyIndices.size() == totalAwake,
            dt,
            cpuScheduler
        );
        world.m_cpuScratch.parImpulsesStored = true;
        return true;
    }

    return SolvePartitionSubStepsCpu(world, partition.cpuAwakeIndices, colorConstraints, jointConstraints, dt, subStepCount, cpuScheduler);
}

void SolveStepCpu(mut PhysicsWorld world, in f32 dt, in u32 subStepCount, mut CpuTaskScheduler cpuScheduler){
    world.m_inStep = true;
    world.m_bodyMoveEvents.clear();
    world.m_contactBeginEvents.clear();
    world.m_contactEndEvents.clear();
    world.m_contactHitEvents.clear();
    world.m_sensorBeginEvents.clear();
    world.m_sensorEndEvents.clear();
    world.consumePendingEndEvents(world.m_contactEndEvents, world.m_sensorEndEvents);
    world.m_jointBreakEvents.clear();
    world.flushDirtyBodyMasses();

    WakeJointConnectedIslands(world);
    EnlargeFastAndBulletBroadphaseBounds(world, dt);

    u32 pairCount = 0u;
    UpdateBroadPhasePairsCpu(world, cpuScheduler, pairCount);
    CollideContactsCpu(world, dt, cpuScheduler);
    SplitDirtyAwakeIslands(world);

    const u32 awakeCount = world.awakeBodyCount();
    const u32 awakeIslandCount = cast<u32>(world.m_solverSets[s_AwakeSetIndex].islands.size());

    if(dt <= 0.0f || subStepCount == 0u){
        mut SolverSet awakeSet = world.m_solverSets[s_AwakeSetIndex];
        for(usize i = 0u; i < awakeSet.sims.size(); ++i){
            awakeSet.sims[i].setForce(VectorSingle(0.0f));
            awakeSet.sims[i].setTorque(VectorSingle(0.0f));
        }
        RecordWorldStepStats(world, pairCount, awakeCount, 0u, awakeIslandCount, 0u, ExecutionBackendUsed::Cpu);
        world.m_inStep = false;
        return;
    }

    const f32 h = dt / cast<f32>(subStepCount);
    const f32 invH = 1.0f / h;

    mut Array<Vector<ContactConstraint>, s_GraphColorCount> colorConstraints = world.m_cpuScratch.colorConstraints;
    mut Array<Vector<ContactConstraintStepCache>, s_GraphColorCount> colorCaches = world.m_cpuScratch.colorConstraintCaches;
    if(!PrepareColorContactConstraintsFromGraphWithCache(
        world,
        h,
        cpuScheduler,
        colorConstraints,
        colorCaches
    )){
        world.m_inStep = false;
        return;
    }

    mut Vector<u32> activeJointIds = world.m_cpuScratch.activeJointIds;
    CollectActiveAwakeJointIds(world, world.m_cpuScratch.jointVisitStamps, world.m_cpuScratch.jointVisitStamp, activeJointIds);
    mut Vector<JointConstraint> jointConstraints = world.m_cpuScratch.jointConstraints;
    const f32 jointDefaultHertz = SimdMax(world.m_def.contactHertz, 30.0f);
    PrepareJointConstraintsCpu(world, activeJointIds, jointDefaultHertz, h, cpuScheduler, jointConstraints);

    mut Vector<u32> awakeIndices = world.m_cpuScratch.awakeIndices;
    awakeIndices.resize(awakeCount);
    for(u32 i = 0u; i < awakeCount; ++i)
        awakeIndices[i] = i;

    if(!SolvePartitionSubStepsCpuImpl(world, awakeIndices, colorConstraints, jointConstraints, dt, subStepCount, cpuScheduler, true)){
        world.m_inStep = false;
        return;
    }

    mut Vector<u32> brokenJointIds = world.m_cpuScratch.brokenJointIds;
    brokenJointIds.clear();
    StoreSolvedPartitionImpulsesAndEventsCpu(world, colorConstraints, jointConstraints, invH, brokenJointIds);
    for(usize bi = 0u; bi < brokenJointIds.size(); ++bi)
        world.destroyJointInternal(brokenJointIds[bi]);

    SolveBulletContinuousCpuWithScheduler(world, dt, cpuScheduler);
    FinalizeMovedBodiesBroadphaseAndEventsWithScheduler(world, dt, cpuScheduler);
    EvaluateSleepingIslands(world);

    RecordWorldStepStats(world, pairCount, awakeCount, 0u, awakeIslandCount, 0u, ExecutionBackendUsed::Cpu);
    world.m_inStep = false;
}

void StepPhysicsWorld(mut PhysicsWorld world, in f32 dt, in u32 subStepCount, mut CpuTaskScheduler cpuScheduler){
    SolveStepCpu(world, dt, subStepCount, cpuScheduler);
}


