const usize s_GpuCmdIrTextureByteCount = 96u;
const usize s_GpuCmdIrLargeBlobBytes = 70u * 1024u + 4u;

SingleQueueCompile GpuCmdIr_MakeSingleQueueCompile(mut TestArena testArena){
    return SingleQueueCompile(testArena);
}

GpuTaskId GpuCmdIr_MakeTaskId(in u64 generation, in u32 index){
    GpuTaskId id = GpuTaskId();
    id.generation = generation;
    id.index = index;
    return id;
}

GpuSubmissionPacketId GpuCmdIr_MakePacketId(in u64 generation, in u32 index){
    GpuSubmissionPacketId id = GpuSubmissionPacketId();
    id.generation = generation;
    id.index = index;
    return id;
}

GpuPhysicalQueueId GpuCmdIr_MakeQueueId(in u16 index, in u16 deviceGeneration){
    GpuPhysicalQueueId id = GpuPhysicalQueueId();
    id.index = index;
    id.deviceGeneration = deviceGeneration;
    return id;
}

GpuGraphResourceId GpuCmdIr_MakeResourceId(in u64 generation, in u32 index){
    GpuGraphResourceId id = GpuGraphResourceId();
    id.generation = generation;
    id.index = index;
    return id;
}

GpuGraphPipelineId GpuCmdIr_MakePipelineId(in u64 generation, in u32 index){
    GpuGraphPipelineId id = GpuGraphPipelineId();
    id.generation = generation;
    id.index = index;
    return id;
}

GpuUploadBlobId GpuCmdIr_MakeBlobId(in u64 generation, in u32 index){
    GpuUploadBlobId id = GpuUploadBlobId();
    id.generation = generation;
    id.index = index;
    return id;
}

BinaryByteView GpuCmdIr_SpanByteView(in Span<u8> bytes){
    BinaryByteView view = BinaryByteView();
    native(in bytes, mut view){
        view = BinaryByteView{ bytes.data(), bytes.size() };
    }
    return view;
}

BinaryByteView GpuCmdIr_GraphicsByteView(in GraphicsBytes bytes){
    BinaryByteView view = BinaryByteView();
    native(in bytes, mut view){
        view = BinaryByteView{ bytes.data(), bytes.size() };
    }
    return view;
}

BinaryByteView GpuCmdIr_SubByteView(in BinaryByteView source, in usize offset, in usize count){
    BinaryByteView view = BinaryByteView();
    native(in source, in offset, in count, mut view){
        view = BinaryByteView{ source.data() + offset, count };
    }
    return view;
}

b8 GpuCmdIr_BytesEqual(in BinaryByteView lhs, in BinaryByteView rhs){
    if(lhs.size() != rhs.size())
        return false;
    b8 equal = true;
    native(in lhs, in rhs, mut equal){
        if(!lhs.empty())
            equal = NWB_MEMCMP(lhs.data(), rhs.data(), lhs.size()) == 0;
    }
    return equal;
}

void GpuCmdIr_WriteU8(in usize offset, in u8 value, mut GraphicsBytes bytes){
    native(in offset, in value, mut bytes){
        WriteCommandIrPod(offset, value, bytes);
    }
}

void GpuCmdIr_WriteU16(in usize offset, in u16 value, mut GraphicsBytes bytes){
    native(in offset, in value, mut bytes){
        WriteCommandIrPod(offset, value, bytes);
    }
}

void GpuCmdIr_WriteU32(in usize offset, in u32 value, mut GraphicsBytes bytes){
    native(in offset, in value, mut bytes){
        WriteCommandIrPod(offset, value, bytes);
    }
}

void GpuCmdIr_WriteU64(in usize offset, in u64 value, mut GraphicsBytes bytes){
    native(in offset, in value, mut bytes){
        WriteCommandIrPod(offset, value, bytes);
    }
}

void GpuCmdIr_WriteF32(in usize offset, in f32 value, mut GraphicsBytes bytes){
    native(in offset, in value, mut bytes){
        WriteCommandIrPod(offset, value, bytes);
    }
}

Optional<GpuSubmissionPacket> GpuCmdIr_PacketPlan(in GpuCompiledPacketView view){
    Optional<GpuSubmissionPacket> out = Optional<GpuSubmissionPacket>();
    native(in view, mut out){
        if(view.plan)
            out = *view.plan;
    }
    return out;
}

void VerifyGpuCmdIr_RejectsForeignGraphAndPlanGenerationsWithoutChangingCapturedBytes(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    const GpuTaskId task = GpuCmdIr_MakeTaskId(17u, 4u);
    const GpuSubmissionPacketId packet = GpuCmdIr_MakePacketId(23u, 2u);
    const GpuPhysicalQueueId queue = GpuCmdIr_MakeQueueId(1u, 3u);
    const GpuGraphResourceId source = GpuCmdIr_MakeResourceId(17u, 5u);
    const GpuGraphResourceId destination = GpuCmdIr_MakeResourceId(17u, 6u);

    ASSERT_TRUE(capture.captureCopyBuffer(task, packet, queue, source, 16u, destination, 32u, 64u));
    GpuClearTextureTaskDesc clearTexture = GpuClearTextureTaskDesc();
    clearTexture.destination = destination;
    clearTexture.subresources = TextureSubresourceSet(0u, 1u, 0u, 1u);
    clearTexture.valueType = GpuClearTextureTaskValueType::Float;
    clearTexture.floatValue = Color(0.25f, 0.5f, 0.75f, 1.0f);
    // The stream omits aspect flags ignored by native color-clear lowering.
    clearTexture.clearDepth = true;
    clearTexture.clearStencil = true;
    ASSERT_TRUE(capture.captureClearTexture(task, packet, queue, destination, clearTexture));

    GraphicsBytes streamBeforeRejectedRecord = GraphicsBytes(testArena.arena);
    CopyCommandIrBytes(capture.commandBytes(), streamBeforeRejectedRecord);

    const GpuTaskId anotherGraphTask = GpuCmdIr_MakeTaskId(task.generation + 1u, task.index);
    const GpuSubmissionPacketId anotherGraphPacket = GpuCmdIr_MakePacketId(packet.generation + 1u, packet.index);
    const GpuGraphResourceId anotherGraphResource = GpuCmdIr_MakeResourceId(destination.generation + 1u, destination.index);
    EXPECT_FALSE(capture.captureClearBuffer(anotherGraphTask, anotherGraphPacket, queue, anotherGraphResource, 0xdecafbadu));
    EXPECT_FALSE(capture.captureClearBuffer(task, GpuCmdIr_MakePacketId(packet.generation + 2u, packet.index), queue, destination, 0xdecafbadu));
    const BinaryByteView bytesAfterRejectedRecord = capture.commandBytes();
    EXPECT_EQ(bytesAfterRejectedRecord.size(), streamBeforeRejectedRecord.size());
    EXPECT_TRUE(GpuCmdIr_BytesEqual(bytesAfterRejectedRecord, GpuCmdIr_GraphicsByteView(streamBeforeRejectedRecord)));
}

void VerifyGpuCmdIr_RejectsNonEmptyCaptureFromDifferentRecordingAttempt(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    const GpuTaskId task = GpuCmdIr_MakeTaskId(17u, 4u);
    const GpuSubmissionPacketId packet = GpuCmdIr_MakePacketId(23u, 2u);
    const GpuPhysicalQueueId queue = GpuCmdIr_MakeQueueId(1u, 3u);
    const GpuGraphResourceId source = GpuCmdIr_MakeResourceId(17u, 5u);
    const GpuGraphResourceId destination = GpuCmdIr_MakeResourceId(17u, 6u);

    ASSERT_TRUE(capture.beginRecordingAttempt(41u));
    EXPECT_EQ(capture.recordingAttemptGeneration(), 41u);
    ASSERT_TRUE(capture.captureCopyBuffer(task, packet, queue, source, 0u, destination, 0u, 4u));
    EXPECT_FALSE(capture.beginRecordingAttempt(42u));
    EXPECT_TRUE(capture.beginRecordingAttempt(41u));

    capture.rollback(0u);
    EXPECT_EQ(capture.recordingAttemptGeneration(), 0u);
    EXPECT_TRUE(capture.beginRecordingAttempt(42u));
    EXPECT_EQ(capture.recordingAttemptGeneration(), 42u);
}

void VerifyGpuCmdIr_RejectsDegenerateRectUIntClearAndEarlierStreamVersions(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    GpuClearTextureRectUIntTaskDesc clear = GpuClearTextureRectUIntTaskDesc();
    clear.destination = s_CommandIrDestination;
    clear.subresources = TextureSubresourceSet(2u, 3u, 4u, 5u);
    clear.rect = Rect(-2, 7, 3, 11);
    clear.uintValue = UIntColor(0x10203040u, 0x50607080u, 0x90a0b0c0u, 0xd0e0f000u);
    ASSERT_TRUE(capture.captureClearTextureRectUInt(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, s_CommandIrDestination, clear));

    ASSERT_EQ(capture.recordCount(), 1u);
    const BinaryByteView bytes = capture.commandBytes();
    GpuCommandIrStreamReader reader = GpuCommandIrStreamReader(bytes);
    ASSERT_TRUE(reader.nextBuiltinTask().has_value());

    clear.rect = Rect(4, 4, 0, 1);
    EXPECT_FALSE(capture.captureClearTextureRectUInt(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, s_CommandIrDestination, clear));
    EXPECT_EQ(capture.recordCount(), 1u);

    GraphicsBytes downgradedRectBytes = GraphicsBytes(testArena.arena);
    CopyCommandIrBytes(bytes, downgradedRectBytes);
    GpuCmdIr_WriteU16(s_GpuCmdIrHdrVersionOffset, cast<u16>(s_GpuCommandIrStreamVersion - 1u), downgradedRectBytes);
    GpuCommandIrStreamReader downgradedRectReader = GpuCommandIrStreamReader(GpuCmdIr_GraphicsByteView(downgradedRectBytes));
    const auto terminal1 = downgradedRectReader.nextBuiltinTask();
    ASSERT_FALSE(terminal1.has_value());
    EXPECT_EQ(terminal1.error(), GpuCommandIrStreamReadStatus::Error);
    EXPECT_EQ(downgradedRectReader.validation().error, GpuCommandIrStreamValidationError::UnsupportedVersion);
}

void VerifyGpuCmdIr_RollbackPreservesExactMixedRecordPrefixAtRecordBoundaries(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    const GpuTaskId task = GpuCmdIr_MakeTaskId(17u, 4u);
    const GpuSubmissionPacketId packet = GpuCmdIr_MakePacketId(17u, 2u);
    const GpuPhysicalQueueId queue = GpuCmdIr_MakeQueueId(1u, 3u);
    const GpuGraphResourceId source = GpuCmdIr_MakeResourceId(17u, 5u);
    const GpuGraphResourceId destination = GpuCmdIr_MakeResourceId(17u, 6u);

    TextureSlice sourceSlice = TextureSlice();
    sourceSlice.setOrigin(1u, 2u, 3u);
    sourceSlice.setSize(4u, 5u, 6u);
    sourceSlice.setMipLevel(7u);
    sourceSlice.setArraySlice(8u);
    TextureSlice destinationSlice = TextureSlice();
    destinationSlice.setOrigin(9u, 10u, 11u);
    destinationSlice.setSize(12u, 13u, 14u);
    destinationSlice.setMipLevel(15u);
    destinationSlice.setArraySlice(16u);
    GpuClearTextureTaskDesc clearTexture = GpuClearTextureTaskDesc();
    clearTexture.destination = destination;
    clearTexture.subresources = TextureSubresourceSet(2u, 3u, 4u, 5u);
    clearTexture.valueType = GpuClearTextureTaskValueType::DepthStencil;
    clearTexture.floatValue = Color(0.25f, 0.5f, 0.75f, 1.0f);
    clearTexture.uintValue = UIntColor(2u, 3u, 5u, 7u);
    clearTexture.intValue = IntColor(-2, -3, -5, -7);
    clearTexture.depthValue = 0.125f;
    clearTexture.stencilValue = 19u;
    clearTexture.clearDepth = true;
    clearTexture.clearStencil = true;

    ASSERT_TRUE(capture.captureCopyBuffer(task, packet, queue, source, 16u, destination, 32u, 64u));
    ASSERT_TRUE(capture.captureCopyTexture(task, packet, queue, source, sourceSlice, destination, destinationSlice));
    ASSERT_TRUE(capture.captureClearBuffer(task, packet, queue, destination, 0xdecafbadu));
    ASSERT_TRUE(capture.captureClearTexture(task, packet, queue, destination, clearTexture));

    const BinaryByteView bytes = capture.commandBytes();
    const usize copyTextureEnd = s_GpuCmdIrStreamHeaderBytes + s_GpuCmdIrCopyBufferRecordBytes + s_GpuCmdIrCopyTextureRecordBytes;
    ASSERT_EQ(capture.recordCount(), 4u);

    GraphicsBytes expectedPrefix = GraphicsBytes(testArena.arena);
    CopyCommandIrBytes(GpuCmdIr_SubByteView(bytes, 0u, copyTextureEnd), expectedPrefix);
    capture.rollback(2u);
    const BinaryByteView rolledBackBytes = capture.commandBytes();
    EXPECT_EQ(capture.recordCount(), 2u);
    EXPECT_EQ(capture.graphGeneration(), task.generation);
    ASSERT_EQ(rolledBackBytes.size(), expectedPrefix.size());
    // Rollback rewrites the header count/payload; the two surviving records stay an exact byte prefix of the capture.
    EXPECT_TRUE(GpuCmdIr_BytesEqual(
        GpuCmdIr_SubByteView(rolledBackBytes, s_GpuCmdIrStreamHeaderBytes, expectedPrefix.size() - s_GpuCmdIrStreamHeaderBytes),
        GpuCmdIr_SubByteView(GpuCmdIr_GraphicsByteView(expectedPrefix), s_GpuCmdIrStreamHeaderBytes, expectedPrefix.size() - s_GpuCmdIrStreamHeaderBytes)
    ));

    Optional<GpuCommandIrStreamHeader> streamHeader = Optional<GpuCommandIrStreamHeader>();
    native(in rolledBackBytes, mut streamHeader){
        usize cursor = 0u;
        if(const auto parsed = ReadPOD<Core::GpuCommandIrStreamHeader>(rolledBackBytes, cursor))
            streamHeader = *parsed;
    }
    ASSERT_TRUE(streamHeader.has_value());
    EXPECT_EQ(streamHeader.value().recordCount, 2u);
    EXPECT_EQ(streamHeader.value().commandBytes, s_GpuCmdIrCopyBufferRecordBytes + s_GpuCmdIrCopyTextureRecordBytes);
}

void VerifyGpuCmdIr_RetainedOwnerAnchorOutlivesIndependentCaptureArena(){
    TestArena ownerArena = TestArena();
    u32 releases = 0u;
    GpuCommandIrOwnerAnchor exported = GpuCommandIrOwnerAnchor();
    {
        TestArena captureArena = TestArena();
        GpuCommandIrCapture capture = GpuCommandIrCapture(captureArena.arena);
        b8 hasSource = false;
        native(mut ownerArena, mut releases, mut exported, mut hasSource){
            const auto source = Core::MakeGpuCommandIrOwnerAnchor(ownerArena.arena, GpuCmdIrOwnerReleaseProbe(releases));
            hasSource = source.has_value();
            if(source)
                exported = *source;
        }
        ASSERT_TRUE(hasSource);
        capture.reset();
        EXPECT_EQ(releases, 0u);
    }
    EXPECT_TRUE(exported.valid());
    EXPECT_EQ(releases, 0u);
    exported = GpuCommandIrOwnerAnchor();
    EXPECT_EQ(releases, 1u);
}

void VerifyGpuCmdIr_DrawWithoutHeapBindingRejectsWholePacket(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto colorResult = AddTextureMetadata(graph, s_GpuCaseCommandIrRasterColor, "Raster Color", ResourceStates::RenderTarget);
    ASSERT_TRUE(colorResult.has_value());
    const GpuGraphResourceId color = colorResult.value();
    const auto pipelineResult = AddPipelineMetadata(graph, s_GpuCaseCommandIrRasterPipeline, "Raster Pipeline", GpuGraphPipelineType::Graphics);
    ASSERT_TRUE(pipelineResult.has_value());
    const GpuGraphPipelineId pipeline = pipelineResult.value();
    ASSERT_TRUE(color.valid());
    ASSERT_TRUE(pipeline.valid());

    Array<GpuTaskResourceUse, 1> uses = Array<GpuTaskResourceUse, 1>();
    uses[0u].resource = color;
    uses[0u].requiredState = ResourceStates::RenderTarget;
    uses[0u].access = GpuTaskResourceAccess::Write;
    GpuTaskDesc description = GpuTaskDesc();
    description.setIdentity(s_GpuCaseCommandIrRasterDraw);
    description.setMarkerLabel("Raster Draw");
    description.setResourceUses(uses);
    const auto taskResult = graph.addTask(description, GraphicsCommands());
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    SingleQueueCompile compiled = GpuCmdIr_MakeSingleQueueCompile(testArena);
    ASSERT_TRUE(compiled.compile(graph));
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    const GpuCmdIrCompiledGraphReadView plan = GpuCmdIrCompiledGraphReadView(compiled.compiledGraph);
    const GpuSubmissionPacketId packet = plan.packetForTask(task);
    ASSERT_TRUE(packet.valid());
    const Optional<GpuSubmissionPacket> packetPlan = GpuCmdIr_PacketPlan(plan.packet(packet));
    ASSERT_TRUE(packetPlan.has_value());
    const GpuPhysicalQueueId queue = packetPlan.value().queue;

    GpuCommandIrRasterStateDesc state = GpuCommandIrRasterStateDesc();
    state.pipeline = pipeline;
    state.colorAttachment = color;
    state.viewport = Viewport(64.0f, 48.0f);
    Array<u8, 4> pushBytes = Array<u8, 4>();
    pushBytes[0u] = 0x11u;
    pushBytes[1u] = 0x22u;
    pushBytes[2u] = 0x33u;
    pushBytes[3u] = 0x44u;

    GpuCommandIrCapture validCapture = GpuCommandIrCapture(testArena.arena);
    ASSERT_TRUE(validCapture.captureSetGraphicsState(task, packet, queue, state));
    ASSERT_TRUE(validCapture.captureEndRenderPass(task, packet, queue));
    const auto valid = validCapture.exportOwned(testArena.arena);
    ASSERT_TRUE(valid.has_value());
    const GpuCommandIrReplayResult accepted = PreflightGpuCommandIrPacket(valid.value(), declarations, plan, packet);
    EXPECT_EQ(accepted.error, GpuCommandIrReplayError::None);
    EXPECT_TRUE(accepted.streamValidation.valid());

    // Converting INT32_MAX to f32 rounds up beyond the scissor range.
    Array<b8, 2> boolCases = Array<b8, 2>();
    boolCases[0u] = false;
    boolCases[1u] = true;
    for(in b8 vertical : boolCases){
        for(in b8 overLimit : boolCases){
            for(in b8 explicitScissor : boolCases){
                GpuCommandIrRasterStateDesc boundary = state;
                f32 maximum = 2147483520.0f;
                if(overLimit)
                    maximum = 2147483648.0f;
                if(vertical)
                    boundary.viewport = Viewport(0.0f, 64.0f, 0.0f, maximum, 0.0f, 1.0f);
                else
                    boundary.viewport = Viewport(0.0f, maximum, 0.0f, 48.0f, 0.0f, 1.0f);
                boundary.hasScissor = explicitScissor;
                boundary.scissor = Rect(0, 1, 0, 1);
                GpuCommandIrCapture boundaryCapture = GpuCommandIrCapture(testArena.arena);
                ASSERT_TRUE(boundaryCapture.captureSetGraphicsState(task, packet, queue, boundary));
                ASSERT_TRUE(boundaryCapture.captureEndRenderPass(task, packet, queue));
                const auto boundaryStream = boundaryCapture.exportOwned(testArena.arena);
                ASSERT_TRUE(boundaryStream.has_value());
                const GpuCommandIrReplayResult boundaryResult = PreflightGpuCommandIrPacket(boundaryStream.value(), declarations, plan, packet);
                GpuCmdIrReplayErrorEnum expectedErr = GpuCommandIrReplayError::None;
                if(overLimit && !explicitScissor)
                    expectedErr = GpuCommandIrReplayError::InvalidRasterState;
                EXPECT_EQ(boundaryResult.error, expectedErr);
            }
        }
    }

    GpuCommandIrCapture invalidCapture = GpuCommandIrCapture(testArena.arena);
    ASSERT_TRUE(invalidCapture.captureSetGraphicsState(task, packet, queue, state));
    ASSERT_TRUE(invalidCapture.capturePushConstants(task, packet, queue, GpuCmdIr_SpanByteView(pushBytes)));
    DrawArguments drawArgs = DrawArguments();
    drawArgs.setVertexCount(3u);
    ASSERT_TRUE(invalidCapture.captureDraw(task, packet, queue, drawArgs, false));
    ASSERT_TRUE(invalidCapture.captureEndRenderPass(task, packet, queue));
    const auto invalid = invalidCapture.exportOwned(testArena.arena);
    ASSERT_TRUE(invalid.has_value());
    const GpuCommandIrReplayResult rejected = PreflightGpuCommandIrPacket(invalid.value(), declarations, plan, packet);
    EXPECT_EQ(rejected.error, GpuCommandIrReplayError::InvalidRasterDraw);
    EXPECT_EQ(rejected.recordIndex, 2u);
    EXPECT_TRUE(rejected.streamValidation.valid());

    const GpuCommandIrReplayResult raw = PreflightGpuCommandIrPacket(valid.value().bytes(), declarations, plan, packet);
    EXPECT_EQ(raw.error, GpuCommandIrReplayError::MissingOwnedSidecar);
    EXPECT_TRUE(raw.streamValidation.valid());

    GpuCmdIrRasterReplayState graphState = GpuCmdIrRasterReplayState();
    GpuCommandIrRasterTaskRecord stateRecord = GpuCommandIrRasterTaskRecord();
    stateRecord.opcode = GpuCommandIrWireOpcode::SetGraphicsState;
    stateRecord.task = task;
    stateRecord.pipeline = pipeline;
    stateRecord.colorAttachment = color;
    stateRecord.viewport = state.viewport;

    GpuCommandIrRasterTaskRecord heapRecord = GpuCommandIrRasterTaskRecord();
    heapRecord.opcode = GpuCommandIrWireOpcode::BindGraphicsHeap;
    heapRecord.task = task;
    heapRecord.pipeline = pipeline;

    GpuCommandIrRasterTaskRecord pushRecord = GpuCommandIrRasterTaskRecord();
    pushRecord.opcode = GpuCommandIrWireOpcode::SetPushConstants;
    pushRecord.task = task;
    pushRecord.blobSizeBytes = pushBytes.size();

    GpuCommandIrRasterTaskRecord indexedDraw = GpuCommandIrRasterTaskRecord();
    indexedDraw.opcode = GpuCommandIrWireOpcode::DrawIndexed;
    indexedDraw.task = task;
    indexedDraw.drawArguments.setVertexCount(3u);

    native(in declarations, in task, in stateRecord, in heapRecord, in pushRecord, in indexedDraw, mut graphState){
        ASSERT_EQ(Core::GpuCommandIrDetail::ValidateRasterGraphOperation(stateRecord, declarations, declarations.taskAt(task.index), graphState), Core::GpuCommandIrReplayError::None);
        ASSERT_EQ(Core::GpuCommandIrDetail::ValidateRasterGraphOperation(heapRecord, declarations, declarations.taskAt(task.index), graphState), Core::GpuCommandIrReplayError::None);
        ASSERT_EQ(Core::GpuCommandIrDetail::ValidateRasterGraphOperation(pushRecord, declarations, declarations.taskAt(task.index), graphState), Core::GpuCommandIrReplayError::None);
        EXPECT_EQ(Core::GpuCommandIrDetail::ValidateRasterGraphOperation(indexedDraw, declarations, declarations.taskAt(task.index), graphState), Core::GpuCommandIrReplayError::InvalidRasterDraw);
    }
}

GpuCommandIrRasterStateDesc GpuCmdIr_RasterState(){
    GpuCommandIrRasterStateDesc state = GpuCommandIrRasterStateDesc();
    state.pipeline = GpuCmdIr_MakePipelineId(s_CommandIrTask.generation, 2u);
    state.colorAttachment = s_CommandIrDestination;
    state.viewport = Viewport(0.0f, 64.0f, 0.0f, 48.0f, 0.0f, 1.0f);
    state.scissor = Rect(4, 60, 3, 45);
    state.blendConstantColor = Color(0.25f, 0.5f, 0.75f, 1.0f);
    state.dynamicStencilRefValue = 7u;
    state.hasScissor = true;
    GpuCommandIrRasterVertexOwner vertexOwner = GpuCommandIrRasterVertexOwner();
    vertexOwner.resource = s_CommandIrSource;
    vertexOwner.slot = 3u;
    vertexOwner.offset = 16u;
    state.vertexBuffers.push_back(vertexOwner);
    state.indexResource = GpuCmdIr_MakeResourceId(s_CommandIrTask.generation, 9u);
    state.indexFormat = Format::R32_UINT;
    state.indexOffset = 4u;
    return state;
}

void VerifyGpuCmdIr_PreservesCapturedPushBytesAfterCallerMutationAcrossRasterRecords(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    const GpuCommandIrRasterStateDesc state = GpuCmdIr_RasterState();
    Array<u8, 8> pushBytes = Array<u8, 8>();
    Array<u8, 8> expectedPush = Array<u8, 8>();
    for(usize index = 0u; index < 8u; ++index){
        const u8 val = cast<u8>((index + 1u) * 0x11u);
        pushBytes[index] = val;
        expectedPush[index] = val;
    }
    DrawArguments draw = DrawArguments();
    draw.setVertexCount(6u);
    draw.setInstanceCount(2u);
    draw.setStartIndexLocation(5u);
    draw.setStartVertexLocation(3u);
    draw.setStartInstanceLocation(1u);

    ASSERT_TRUE(capture.captureSetGraphicsState(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, state));
    ASSERT_TRUE(capture.capturePushConstants(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, GpuCmdIr_SpanByteView(pushBytes)));
    for(mut u8 value : pushBytes)
        value = 0u;
    ASSERT_TRUE(capture.captureDraw(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, draw, true));
    ASSERT_TRUE(capture.captureEndRenderPass(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue));
    const auto owned = capture.exportOwned(testArena.arena);
    ASSERT_TRUE(owned.has_value());

    const BinaryByteView bytes = owned.value().bytes();
    EXPECT_TRUE(ValidateGpuCommandIrStream(bytes).valid());

    GpuCommandIrStreamReader reader = GpuCommandIrStreamReader(bytes);
    const auto firstDecoded = reader.next();
    ASSERT_TRUE(firstDecoded.has_value());
    const auto secondDecoded = reader.next();
    ASSERT_TRUE(secondDecoded.has_value());
    ASSERT_EQ(secondDecoded.value().raster.blobSizeBytes, expectedPush.size());
    const BinaryByteView blob = reader.blobBytes();
    ASSERT_LE(secondDecoded.value().raster.blobOffsetBytes, blob.size());
    ASSERT_LE(secondDecoded.value().raster.blobSizeBytes, blob.size() - secondDecoded.value().raster.blobOffsetBytes);
    EXPECT_TRUE(GpuCmdIr_BytesEqual(
        GpuCmdIr_SubByteView(blob, cast<usize>(secondDecoded.value().raster.blobOffsetBytes), expectedPush.size()),
        GpuCmdIr_SpanByteView(expectedPush)
    ));
}

void VerifyGpuCmdIr_RejectsLateOutOfBlobPushAndEarlierVersion(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    const GpuCommandIrRasterStateDesc state = GpuCmdIr_RasterState();
    Array<u8, 4> pushBytes = Array<u8, 4>();
    pushBytes[0u] = 0x31u;
    pushBytes[1u] = 0x41u;
    pushBytes[2u] = 0x59u;
    pushBytes[3u] = 0x26u;
    ASSERT_TRUE(capture.captureSetGraphicsState(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, state));
    ASSERT_TRUE(capture.capturePushConstants(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, GpuCmdIr_SpanByteView(pushBytes)));

    GraphicsBytes malformed = GraphicsBytes(testArena.arena);
    CopyCommandIrBytes(capture.commandBytes(), malformed);
    const usize secondRecord = s_GpuCmdIrStreamHeaderBytes + s_GpuCmdIrSetGraphicsStateRecordBytes;
    GpuCmdIr_WriteU64(secondRecord + s_GpuCmdIrPushBlobOffsetOffset, u64.max, malformed);
    const GpuCommandIrStreamValidationResult invalid = ValidateGpuCommandIrStream(GpuCmdIr_GraphicsByteView(malformed));
    EXPECT_EQ(invalid.error, GpuCommandIrStreamValidationError::InvalidBlobRange);
    EXPECT_EQ(invalid.recordIndex, 1u);

    GpuCmdIr_WriteU16(s_GpuCmdIrHdrVersionOffset, 4u, malformed);
    const GpuCommandIrStreamValidationResult oldVersion = ValidateGpuCommandIrStream(GpuCmdIr_GraphicsByteView(malformed));
    EXPECT_EQ(oldVersion.error, GpuCommandIrStreamValidationError::UnsupportedVersion);
}

void VerifyGpuCmdIr_RejectsCorruptedViewportBeforeExposingRasterRecord(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    const GpuCommandIrRasterStateDesc state = GpuCmdIr_RasterState();
    ASSERT_TRUE(capture.captureSetGraphicsState(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, state));
    GraphicsBytes malformed = GraphicsBytes(testArena.arena);
    CopyCommandIrBytes(capture.commandBytes(), malformed);
    const usize maxXOffset = s_GpuCmdIrStreamHeaderBytes + s_GpuCmdIrGfxViewportMaxXOffset;
    GpuCmdIr_WriteF32(maxXOffset, 0.0f, malformed);
    GpuCommandIrStreamReader reader = GpuCommandIrStreamReader(GpuCmdIr_GraphicsByteView(malformed));

    const auto terminal1 = reader.next();
    ASSERT_FALSE(terminal1.has_value());
    EXPECT_EQ(terminal1.error(), GpuCommandIrStreamReadStatus::Error);
    EXPECT_EQ(reader.validation().error, GpuCommandIrStreamValidationError::InvalidRecord);
    EXPECT_EQ(reader.validation().recordIndex, 0u);
}

void VerifyGpuCmdIr_EmptyAndExhaustedStreamsReportEndWithoutProducingARecord(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture emptyCapture = GpuCommandIrCapture(testArena.arena);
    GpuCommandIrStreamReader emptyReader = GpuCommandIrStreamReader(emptyCapture.commandBytes());

    const auto terminal1 = emptyReader.nextBuiltinTask();
    ASSERT_FALSE(terminal1.has_value());
    EXPECT_EQ(terminal1.error(), GpuCommandIrStreamReadStatus::End);
    EXPECT_TRUE(emptyReader.validation().valid());

    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    ASSERT_TRUE(CaptureAllBuiltinCommandIrRecords(capture));
    GpuCommandIrStreamReader reader = GpuCommandIrStreamReader(capture.commandBytes());
    for(u32 recordIndex = 0u; recordIndex < 4u; ++recordIndex)
        ASSERT_TRUE(reader.nextBuiltinTask().has_value());

    const auto terminal2 = reader.nextBuiltinTask();
    ASSERT_FALSE(terminal2.has_value());
    EXPECT_EQ(terminal2.error(), GpuCommandIrStreamReadStatus::End);
    const auto terminal3 = reader.nextBuiltinTask();
    ASSERT_FALSE(terminal3.has_value());
    EXPECT_EQ(terminal3.error(), GpuCommandIrStreamReadStatus::End);

    EXPECT_TRUE(reader.validation().complete);
    EXPECT_TRUE(reader.validation().valid());
    EXPECT_EQ(reader.validation().byteOffset, capture.commandBytes().size());
    EXPECT_EQ(reader.validation().recordIndex, 4u);
}

void GpuCmdIr_AssertHeaderError(in GraphicsBytes corruptedBytes, in GpuCmdIrValidationErrorEnum expectedError){
    const GpuCommandIrStreamValidationResult result = ValidateGpuCommandIrStream(GpuCmdIr_GraphicsByteView(corruptedBytes));
    EXPECT_EQ(result.error, expectedError);
    EXPECT_TRUE(result.complete);
    EXPECT_TRUE(result.failed());
    EXPECT_FALSE(result.valid());
    EXPECT_EQ(result.byteOffset, 0u);
    EXPECT_EQ(result.recordIndex, u64.max);
}

void VerifyGpuCmdIr_RejectsMalformedHeadersBeforeReadingRecords(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    ASSERT_TRUE(CaptureAllBuiltinCommandIrRecords(capture));
    const BinaryByteView validBytes = capture.commandBytes();

    GpuCommandIrStreamValidationResult nullData = GpuCommandIrStreamValidationResult();
    native(mut nullData){
        nullData = Core::ValidateGpuCommandIrStream(BinaryByteView{ nullptr, 1u });
    }
    EXPECT_EQ(nullData.error, GpuCommandIrStreamValidationError::NullData);
    EXPECT_TRUE(nullData.complete);
    EXPECT_FALSE(nullData.valid());
    EXPECT_EQ(nullData.recordIndex, u64.max);

    const GpuCommandIrStreamValidationResult truncatedHeader = ValidateGpuCommandIrStream(
        GpuCmdIr_SubByteView(validBytes, 0u, s_GpuCmdIrStreamHeaderBytes - 1u)
    );
    EXPECT_EQ(truncatedHeader.error, GpuCommandIrStreamValidationError::TruncatedStreamHeader);
    EXPECT_TRUE(truncatedHeader.complete);
    EXPECT_FALSE(truncatedHeader.valid());

    GraphicsBytes corruptedBytes = GraphicsBytes(testArena.arena);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU32(s_GpuCmdIrHdrMagicOffset, 0u, corruptedBytes);
    GpuCmdIr_AssertHeaderError(corruptedBytes, GpuCommandIrStreamValidationError::InvalidMagic);

    for(u16 version = 0u; version < s_GpuCommandIrStreamVersion; ++version){
        CopyCommandIrBytes(validBytes, corruptedBytes);
        GpuCmdIr_WriteU16(s_GpuCmdIrHdrVersionOffset, version, corruptedBytes);
        GpuCmdIr_AssertHeaderError(corruptedBytes, GpuCommandIrStreamValidationError::UnsupportedVersion);
    }

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU16(s_GpuCmdIrHdrVersionOffset, cast<u16>(s_GpuCommandIrStreamVersion + 1u), corruptedBytes);
    GpuCmdIr_AssertHeaderError(corruptedBytes, GpuCommandIrStreamValidationError::UnsupportedVersion);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU16(s_GpuCmdIrHdrVersionOffset, u16.max, corruptedBytes);
    GpuCmdIr_AssertHeaderError(corruptedBytes, GpuCommandIrStreamValidationError::UnsupportedVersion);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU16(s_GpuCmdIrHdrReservedOffset, 1u, corruptedBytes);
    GpuCmdIr_AssertHeaderError(corruptedBytes, GpuCommandIrStreamValidationError::InvalidHeaderReserved);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU64(s_GpuCmdIrHdrCommandBytesOffset, cast<u64>(corruptedBytes.size()), corruptedBytes);
    GpuCmdIr_AssertHeaderError(corruptedBytes, GpuCommandIrStreamValidationError::PayloadSizeMismatch);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU64(s_GpuCmdIrHdrGraphGenOffset, 0u, corruptedBytes);
    GpuCmdIr_AssertHeaderError(corruptedBytes, GpuCommandIrStreamValidationError::InvalidGraphGeneration);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU64(s_GpuCmdIrHdrPlanGenOffset, 0u, corruptedBytes);
    GpuCmdIr_AssertHeaderError(corruptedBytes, GpuCommandIrStreamValidationError::InvalidPlanGeneration);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU32(s_GpuCmdIrHdrRecordCountOffset, 0u, corruptedBytes);
    GpuCmdIr_AssertHeaderError(corruptedBytes, GpuCommandIrStreamValidationError::InvalidGraphGeneration);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU32(s_GpuCmdIrHdrRecordCountOffset, 64u, corruptedBytes);
    GpuCmdIr_AssertHeaderError(corruptedBytes, GpuCommandIrStreamValidationError::InvalidRecordCount);
}

void GpuCmdIr_AssertRecordError(
    in GraphicsBytes corruptedBytes,
    in usize validPrefixCount,
    in usize expectedByteOffset,
    in GpuCmdIrValidationErrorEnum expectedError
){
    GpuCommandIrStreamReader reader = GpuCommandIrStreamReader(GpuCmdIr_GraphicsByteView(corruptedBytes));
    for(usize recordIndex = 0u; recordIndex < validPrefixCount; ++recordIndex)
        ASSERT_TRUE(reader.nextBuiltinTask().has_value());

    const auto terminal4 = reader.nextBuiltinTask();
    ASSERT_FALSE(terminal4.has_value());
    EXPECT_EQ(terminal4.error(), GpuCommandIrStreamReadStatus::Error);

    EXPECT_EQ(reader.validation().error, expectedError);
    EXPECT_TRUE(reader.validation().complete);
    EXPECT_TRUE(reader.validation().failed());
    EXPECT_EQ(reader.validation().byteOffset, expectedByteOffset);
    EXPECT_EQ(reader.validation().recordIndex, validPrefixCount);

    const auto terminal5 = reader.nextBuiltinTask();
    ASSERT_FALSE(terminal5.has_value());
    EXPECT_EQ(terminal5.error(), GpuCommandIrStreamReadStatus::Error);
}

void VerifyGpuCmdIr_RejectsMalformedRecordsWithoutProducingPartialValues(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    ASSERT_TRUE(CaptureAllBuiltinCommandIrRecords(capture));
    const BinaryByteView validBytes = capture.commandBytes();
    GraphicsBytes corruptedBytes = GraphicsBytes(testArena.arena);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU16(s_CommandIrCopyTextureOffset + s_GpuCmdIrRecByteSizeOffset, 3u, corruptedBytes);
    GpuCmdIr_AssertRecordError(corruptedBytes, 1u, s_CommandIrCopyTextureOffset, GpuCommandIrStreamValidationError::InvalidRecordSize);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU16(s_CommandIrCopyTextureOffset + s_GpuCmdIrRecByteSizeOffset, u16.max, corruptedBytes);
    GpuCmdIr_AssertRecordError(corruptedBytes, 1u, s_CommandIrCopyTextureOffset, GpuCommandIrStreamValidationError::InvalidRecordSize);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU8(s_CommandIrCopyTextureOffset + s_GpuCmdIrRecOpcodeOffset, cast<u8>(GpuCommandIrWireOpcode::SetGraphicsState), corruptedBytes);
    GpuCmdIr_AssertRecordError(corruptedBytes, 1u, s_CommandIrCopyTextureOffset, GpuCommandIrStreamValidationError::UnsupportedOpcode);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU8(s_CommandIrCopyTextureOffset + s_GpuCmdIrRecOpcodeOffset, cast<u8>(GpuCommandIrWireOpcode::Count), corruptedBytes);
    GpuCmdIr_AssertRecordError(corruptedBytes, 1u, s_CommandIrCopyTextureOffset, GpuCommandIrStreamValidationError::UnsupportedOpcode);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU64(s_CommandIrCopyBufferOffset + s_GpuCmdIrCopyBufDataSizeOffset, 0u, corruptedBytes);
    GpuCmdIr_AssertRecordError(corruptedBytes, 0u, s_CommandIrCopyBufferOffset, GpuCommandIrStreamValidationError::InvalidRecord);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU32(s_CommandIrCopyBufferOffset + s_GpuCmdIrCopyBufSrcResOffset, u32.max, corruptedBytes);
    GpuCmdIr_AssertRecordError(corruptedBytes, 0u, s_CommandIrCopyBufferOffset, GpuCommandIrStreamValidationError::InvalidRecord);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU16(s_CommandIrCopyBufferOffset + s_GpuCmdIrCopyBufQueueGenOffset, 0u, corruptedBytes);
    GpuCmdIr_AssertRecordError(corruptedBytes, 0u, s_CommandIrCopyBufferOffset, GpuCommandIrStreamValidationError::InvalidRecord);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU32(s_CommandIrCopyTextureOffset + s_GpuCmdIrCopyTexDstResOffset, u32.max, corruptedBytes);
    GpuCmdIr_AssertRecordError(corruptedBytes, 1u, s_CommandIrCopyTextureOffset, GpuCommandIrStreamValidationError::InvalidRecord);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU32(s_CommandIrClearBufferOffset + s_GpuCmdIrClearBufDstResOffset, u32.max, corruptedBytes);
    GpuCmdIr_AssertRecordError(corruptedBytes, 2u, s_CommandIrClearBufferOffset, GpuCommandIrStreamValidationError::InvalidRecord);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU32(s_CommandIrClearTextureOffset + s_GpuCmdIrClearTexNumMipsOffset, 0u, corruptedBytes);
    GpuCmdIr_AssertRecordError(corruptedBytes, 3u, s_CommandIrClearTextureOffset, GpuCommandIrStreamValidationError::InvalidRecord);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU8(s_CommandIrClearTextureOffset + s_GpuCmdIrClearTexValueTypeOffset, cast<u8>(GpuClearTextureTaskValueType::Count), corruptedBytes);
    GpuCmdIr_AssertRecordError(corruptedBytes, 3u, s_CommandIrClearTextureOffset, GpuCommandIrStreamValidationError::InvalidRecord);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU8(s_CommandIrClearTextureOffset + s_GpuCmdIrClearTexFlagsOffset, 4u, corruptedBytes);
    GpuCmdIr_AssertRecordError(corruptedBytes, 3u, s_CommandIrClearTextureOffset, GpuCommandIrStreamValidationError::InvalidRecord);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU8(s_CommandIrClearTextureOffset + s_GpuCmdIrClearTexFlagsOffset, cast<u8>(GpuCommandIrClearTextureFlag::None), corruptedBytes);
    GpuCmdIr_AssertRecordError(corruptedBytes, 3u, s_CommandIrClearTextureOffset, GpuCommandIrStreamValidationError::InvalidRecord);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU8(s_CommandIrClearTextureOffset + s_GpuCmdIrClearTexValueTypeOffset, cast<u8>(GpuClearTextureTaskValueType::Float), corruptedBytes);
    GpuCmdIr_WriteU8(s_CommandIrClearTextureOffset + s_GpuCmdIrClearTexFlagsOffset, cast<u8>(GpuCommandIrClearTextureFlag::ClearDepth), corruptedBytes);
    GpuCmdIr_AssertRecordError(corruptedBytes, 3u, s_CommandIrClearTextureOffset, GpuCommandIrStreamValidationError::InvalidRecord);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU8(s_CommandIrClearTextureOffset + s_GpuCmdIrClearTexReservedOffset, 1u, corruptedBytes);
    GpuCmdIr_AssertRecordError(corruptedBytes, 3u, s_CommandIrClearTextureOffset, GpuCommandIrStreamValidationError::InvalidRecord);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU32(s_GpuCmdIrHdrRecordCountOffset, 3u, corruptedBytes);
    GpuCmdIr_AssertRecordError(corruptedBytes, 3u, s_CommandIrClearTextureOffset, GpuCommandIrStreamValidationError::TrailingPayload);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    GpuCmdIr_WriteU32(s_GpuCmdIrHdrRecordCountOffset, 5u, corruptedBytes);
    GpuCmdIr_AssertRecordError(corruptedBytes, 4u, validBytes.size(), GpuCommandIrStreamValidationError::TruncatedRecord);

    CopyCommandIrBytes(validBytes, corruptedBytes);
    corruptedBytes.resize(s_CommandIrCopyTextureOffset + s_GpuCmdIrRecordHeaderBytes);
    GpuCmdIr_WriteU32(s_GpuCmdIrHdrRecordCountOffset, 2u, corruptedBytes);
    GpuCmdIr_WriteU64(s_GpuCmdIrHdrCommandBytesOffset, cast<u64>(corruptedBytes.size() - s_GpuCmdIrStreamHeaderBytes), corruptedBytes);
    GpuCmdIr_AssertRecordError(corruptedBytes, 1u, s_CommandIrCopyTextureOffset, GpuCommandIrStreamValidationError::TruncatedRecord);
}

void VerifyGpuCmdIr_RequiresExactPhysicalQueueBeyondBroadQueueClass(){
    const GpuPhysicalQueueInfo packetQueue = GraphicsQueue();
    const GpuPhysicalQueueInfo sameClassOtherQueue = GraphicsQueue(1u);

    CommandListParameters exactDescription = CommandListParameters();
    exactDescription.setPhysicalQueue(packetQueue.id);
    CommandListParameters sameClassWrongDescription = CommandListParameters();
    sameClassWrongDescription.setPhysicalQueue(sameClassOtherQueue.id);
    CommandListParameters wrongClassDescription = CommandListParameters();
    wrongClassDescription.setPhysicalQueue(packetQueue.id);
    wrongClassDescription.queueType = CommandQueue::Compute;

    native(in packetQueue, in exactDescription, in sameClassWrongDescription, in wrongClassDescription){
        EXPECT_EQ(Core::GpuCommandIrDetail::ValidateReplayCommandListQueue(exactDescription, packetQueue.id, packetQueue.queueClass), Core::GpuCommandIrReplayError::None);
        EXPECT_EQ(Core::GpuCommandIrDetail::ValidateReplayCommandListQueue(sameClassWrongDescription, packetQueue.id, packetQueue.queueClass), Core::GpuCommandIrReplayError::CommandListQueueMismatch);
        EXPECT_EQ(Core::GpuCommandIrDetail::ValidateReplayCommandListQueue(wrongClassDescription, packetQueue.id, packetQueue.queueClass), Core::GpuCommandIrReplayError::CommandListQueueMismatch);
    }
}

void VerifyGpuCmdIr_PreflightsTheWholeStreamAgainstTheCompiledPacketBeforeLowering(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto sourceResult = AddBufferMetadata(graph, s_GpuCaseCommandIrReplaySource, "Replay Source");
    ASSERT_TRUE(sourceResult.has_value());
    const GpuGraphResourceId source = sourceResult.value();
    const auto destinationResult = AddBufferMetadata(graph, s_GpuCaseCommandIrReplayDestination, "Replay Destination");
    ASSERT_TRUE(destinationResult.has_value());
    const GpuGraphResourceId destination = destinationResult.value();
    ASSERT_TRUE(source.valid());
    ASSERT_TRUE(destination.valid());

    Array<GpuTaskResourceUse, 2> uses = Array<GpuTaskResourceUse, 2>();
    uses[0u].resource = source;
    uses[0u].requiredState = ResourceStates::CopySource;
    uses[0u].access = GpuTaskResourceAccess::Read;
    uses[1u].resource = destination;
    uses[1u].requiredState = ResourceStates::CopyDest;
    uses[1u].access = GpuTaskResourceAccess::Write;

    GpuTaskCommandRequirements transferCommands = GpuTaskCommandRequirements();
    transferCommands.requiredCapabilities = GpuQueueCapability::Transfer;
    GpuTaskDesc desc = GpuTaskDesc();
    desc.setIdentity(s_GpuCaseCommandIrReplayCopy);
    desc.setMarkerLabel("Replay Copy");
    desc.setResourceUses(uses);
    const auto taskResult = graph.addTask(desc, transferCommands);
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    Array<GpuTaskId, 1> secondDependencies = Array<GpuTaskId, 1>();
    secondDependencies[0u] = task;
    GpuTaskDesc secondDesc = GpuTaskDesc();
    secondDesc.setIdentity(s_GpuCaseCommandIrReplayCopySecond);
    secondDesc.setMarkerLabel("Replay Copy Second");
    secondDesc.setResourceUses(uses);
    secondDesc.setDependencies(secondDependencies);
    const auto secondTaskResult = graph.addTask(secondDesc, transferCommands);
    ASSERT_TRUE(secondTaskResult.has_value());
    const GpuTaskId secondTask = secondTaskResult.value();
    ASSERT_TRUE(secondTask.valid());

    SingleQueueCompile singleQueueCompile = GpuCmdIr_MakeSingleQueueCompile(testArena);
    ASSERT_TRUE(singleQueueCompile.compile(graph));
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    const GpuCmdIrCompiledGraphReadView compiledPlan = GpuCmdIrCompiledGraphReadView(singleQueueCompile.compiledGraph);

    const GpuSubmissionPacketId packet = compiledPlan.packetForTask(task);
    const GpuSubmissionPacketId secondPacket = compiledPlan.packetForTask(secondTask);
    ASSERT_TRUE(packet.valid());
    ASSERT_TRUE(secondPacket.valid());
    ASSERT_NE(secondPacket, packet);
    const Optional<GpuSubmissionPacket> firstPacketPlan = GpuCmdIr_PacketPlan(compiledPlan.packet(packet));
    const Optional<GpuSubmissionPacket> secondPacketPlan = GpuCmdIr_PacketPlan(compiledPlan.packet(secondPacket));
    ASSERT_TRUE(firstPacketPlan.has_value());
    ASSERT_TRUE(secondPacketPlan.has_value());
    const GpuPhysicalQueueId queue = firstPacketPlan.value().queue;
    ASSERT_EQ(secondPacketPlan.value().queue, queue);

    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    ASSERT_TRUE(capture.captureCopyBuffer(task, packet, queue, source, 0u, destination, 0u, 4u));
    ASSERT_TRUE(capture.captureCopyBuffer(secondTask, secondPacket, queue, source, 0u, destination, 0u, 4u));
    ASSERT_EQ(capture.recordCount(), 2u);
    const GpuCommandIrReplayResult validContext = PreflightGpuCommandIrPacket(capture.commandBytes(), declarations, compiledPlan, packet);
    // Metadata-only imports never lower. Preflight already set stream, graph, packet, queue, order, kinds, uses.
    EXPECT_EQ(validContext.error, GpuCommandIrReplayError::MissingBackendResource);
    EXPECT_TRUE(validContext.streamValidation.valid());
    EXPECT_EQ(validContext.recordIndex, 0u);

    // Selecting the second packet skips the unlowerable first packet.
    const GpuCommandIrReplayResult secondPacketContext = PreflightGpuCommandIrPacket(capture.commandBytes(), declarations, compiledPlan, secondPacket);
    EXPECT_EQ(secondPacketContext.error, GpuCommandIrReplayError::MissingBackendResource);
    EXPECT_TRUE(secondPacketContext.streamValidation.valid());
    EXPECT_EQ(secondPacketContext.recordIndex, 1u);

    GpuCommandIrCapture otherRasterCapture = GpuCommandIrCapture(testArena.arena);
    Array<u8, 4> pushBytes = Array<u8, 4>();
    pushBytes[0u] = 1u;
    pushBytes[1u] = 2u;
    pushBytes[2u] = 3u;
    pushBytes[3u] = 4u;
    ASSERT_TRUE(otherRasterCapture.capturePushConstants(secondTask, secondPacket, queue, GpuCmdIr_SpanByteView(pushBytes)));
    const GpuCommandIrReplayResult otherRaster = PreflightGpuCommandIrPacket(otherRasterCapture.commandBytes(), declarations, compiledPlan, packet);
    EXPECT_EQ(otherRaster.error, GpuCommandIrReplayError::None);
    EXPECT_TRUE(otherRaster.streamValidation.valid());
    const GpuCommandIrReplayResult selectedRaster = PreflightGpuCommandIrPacket(otherRasterCapture.commandBytes(), declarations, compiledPlan, secondPacket);
    EXPECT_EQ(selectedRaster.error, GpuCommandIrReplayError::MissingOwnedSidecar);

    GraphicsBytes malformedOther = GraphicsBytes(testArena.arena);
    CopyCommandIrBytes(otherRasterCapture.commandBytes(), malformedOther);
    GpuCmdIr_WriteU16(s_GpuCmdIrStreamHeaderBytes + s_GpuCmdIrRecByteSizeOffset, 0u, malformedOther);
    const GpuCommandIrReplayResult invalidOther = PreflightGpuCommandIrPacket(GpuCmdIr_GraphicsByteView(malformedOther), declarations, compiledPlan, packet);
    EXPECT_EQ(invalidOther.error, GpuCommandIrReplayError::InvalidStream);

    const GpuCommandIrReplayResult invalidPacket = PreflightGpuCommandIrPacket(
        capture.commandBytes(),
        declarations,
        compiledPlan,
        GpuCmdIr_MakePacketId(packet.generation, u32.max - 1u)
    );
    EXPECT_EQ(invalidPacket.error, GpuCommandIrReplayError::InvalidPacket);
    EXPECT_TRUE(invalidPacket.streamValidation.valid());

    GpuCommandIrCapture wrongQueueCapture = GpuCommandIrCapture(testArena.arena);
    ASSERT_TRUE(wrongQueueCapture.captureCopyBuffer(
        task,
        packet,
        GpuCmdIr_MakeQueueId(cast<u16>(queue.index + 1u), queue.deviceGeneration),
        source,
        0u,
        destination,
        0u,
        4u
    ));
    const GpuCommandIrReplayResult wrongQueue = PreflightGpuCommandIrPacket(wrongQueueCapture.commandBytes(), declarations, compiledPlan, packet);
    EXPECT_EQ(wrongQueue.error, GpuCommandIrReplayError::RecordQueueMismatch);
    EXPECT_TRUE(wrongQueue.streamValidation.valid());
    EXPECT_EQ(wrongQueue.recordIndex, 0u);

    const GpuCommandIrReplayResult malformed = PreflightGpuCommandIrPacket(BinaryByteView(), declarations, compiledPlan, packet);
    EXPECT_EQ(malformed.error, GpuCommandIrReplayError::InvalidStream);
    EXPECT_EQ(malformed.streamValidation.error, GpuCommandIrStreamValidationError::TruncatedStreamHeader);
}

b8 GpuCmdIr_AppendMixedRecords(mut GpuCommandIrCapture capture, in usize begin, in usize end){
    for(usize index = begin; index < end; ++index){
        const GpuTaskId task = GpuCmdIr_MakeTaskId(s_CommandIrTask.generation, cast<u32>(index));
        const GpuSubmissionPacketId packet = GpuCmdIr_MakePacketId(s_CommandIrPacket.generation, cast<u32>(index / 64u));
        if(index % 2u == 0u){
            if(!capture.captureCopyBuffer(task, packet, s_CommandIrQueue, s_CommandIrSource, index * 16u, s_CommandIrDestination, index * 32u, 64u))
                return false;
        }
        else if(!capture.captureClearBuffer(task, packet, s_CommandIrQueue, s_CommandIrDestination, cast<u32>(index))){
            return false;
        }
    }
    return true;
}

void GpuCmdIr_VerifyMixedRecords(in GpuCommandIrCapture capture, in usize count){
    ASSERT_EQ(capture.recordCount(), count);
    GpuCommandIrStreamReader reader = GpuCommandIrStreamReader(capture.commandBytes());
    EXPECT_EQ(reader.recordCount(), count);
    u64 expectedGraphGen = s_CommandIrTask.generation;
    u64 expectedPlanGen = s_CommandIrPacket.generation;
    if(count == 0u){
        expectedGraphGen = 0u;
        expectedPlanGen = 0u;
    }
    EXPECT_EQ(reader.graphGeneration(), expectedGraphGen);
    EXPECT_EQ(reader.planGeneration(), expectedPlanGen);
    for(usize index = 0u; index < count; ++index){
        const auto decoded = reader.nextBuiltinTask();
        ASSERT_TRUE(decoded.has_value());
        const GpuCommandIrBuiltinTaskRecord rec = decoded.value();
        EXPECT_EQ(rec.task.generation, s_CommandIrTask.generation);
        EXPECT_EQ(rec.packet.generation, s_CommandIrPacket.generation);
        EXPECT_EQ(rec.task.index, index);
        EXPECT_EQ(rec.packet.index, index / 64u);
        EXPECT_EQ(rec.queue, s_CommandIrQueue);
        EXPECT_EQ(rec.destination, s_CommandIrDestination);
        if(index % 2u == 0u){
            EXPECT_EQ(rec.opcode, GpuCommandIrOpcode::CopyBuffer);
            EXPECT_EQ(rec.source, s_CommandIrSource);
            EXPECT_EQ(rec.sourceOffsetBytes, index * 16u);
            EXPECT_EQ(rec.destinationOffsetBytes, index * 32u);
            EXPECT_EQ(rec.dataSizeBytes, 64u);
        }
        else{
            EXPECT_EQ(rec.opcode, GpuCommandIrOpcode::ClearBuffer);
            EXPECT_EQ(rec.uintClearValue.r, index);
        }
    }
    const auto terminal1 = reader.nextBuiltinTask();
    ASSERT_FALSE(terminal1.has_value());
    EXPECT_EQ(terminal1.error(), GpuCommandIrStreamReadStatus::End);
    EXPECT_TRUE(reader.validation().valid());
}

void VerifyGpuCmdIr_MixedRecordGrowthRollbackAndRefillPreserveTheExactPrefix(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    ASSERT_TRUE(capture.beginRecordingAttempt(31u));
    ASSERT_TRUE(GpuCmdIr_AppendMixedRecords(capture, 0u, 257u));
    GraphicsBytes original = GraphicsBytes(testArena.arena);
    CopyCommandIrBytes(capture.commandBytes(), original);
    GpuCmdIr_VerifyMixedRecords(capture, 257u);

    capture.rollback(129u);
    GpuCmdIr_VerifyMixedRecords(capture, 129u);
    EXPECT_EQ(capture.recordingAttemptGeneration(), 31u);
    const BinaryByteView prefix = capture.commandBytes();
    EXPECT_TRUE(GpuCmdIr_BytesEqual(
        GpuCmdIr_SubByteView(prefix, s_GpuCmdIrStreamHeaderBytes, prefix.size() - s_GpuCmdIrStreamHeaderBytes),
        GpuCmdIr_SubByteView(GpuCmdIr_GraphicsByteView(original), s_GpuCmdIrStreamHeaderBytes, prefix.size() - s_GpuCmdIrStreamHeaderBytes)
    ));
    const usize prefixBytes = prefix.size();
    capture.rollback(130u);
    EXPECT_EQ(capture.commandBytes().size(), prefixBytes);
    GpuCmdIr_VerifyMixedRecords(capture, 129u);
    ASSERT_TRUE(GpuCmdIr_AppendMixedRecords(capture, 129u, 257u));
    ASSERT_EQ(capture.commandBytes().size(), original.size());
    EXPECT_TRUE(GpuCmdIr_BytesEqual(capture.commandBytes(), GpuCmdIr_GraphicsByteView(original)));
    GpuCmdIr_VerifyMixedRecords(capture, 257u);
}

void VerifyGpuCmdIr_ResetAndRollbackReuseCapacityAcrossRecordingAttempts(){
    TestArena testArena = TestArena();
    const ArenaMemoryStats initial = testArena.arena.memoryStats();
    {
        GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
        ASSERT_TRUE(capture.beginRecordingAttempt(31u));
        ASSERT_TRUE(GpuCmdIr_AppendMixedRecords(capture, 0u, 512u));
        const ArenaMemoryStats warmed = testArena.arena.memoryStats();
        for(u64 attempt = 32u; attempt < 40u; ++attempt){
            capture.rollback(255u);
            ASSERT_TRUE(GpuCmdIr_AppendMixedRecords(capture, 255u, 512u));
            capture.reset();
            EXPECT_EQ(capture.graphGeneration(), 0u);
            EXPECT_EQ(capture.planGeneration(), 0u);
            EXPECT_EQ(capture.recordingAttemptGeneration(), 0u);
            EXPECT_EQ(capture.commandBytes().size(), s_GpuCmdIrStreamHeaderBytes);
            ASSERT_TRUE(capture.beginRecordingAttempt(attempt));
            ASSERT_TRUE(GpuCmdIr_AppendMixedRecords(capture, 0u, 512u));
            EXPECT_EQ(capture.recordingAttemptGeneration(), attempt);
        }
        const ArenaMemoryStats after = testArena.arena.memoryStats();
        EXPECT_EQ(after.allocationCount, warmed.allocationCount);
        EXPECT_EQ(after.reallocationCount, warmed.reallocationCount);
        EXPECT_EQ(after.deallocationCount, warmed.deallocationCount);
        EXPECT_EQ(after.usedBytes, warmed.usedBytes);
        GpuCmdIr_VerifyMixedRecords(capture, 512u);
        capture.rollback(0u);
        GpuCmdIr_VerifyMixedRecords(capture, 0u);
        EXPECT_EQ(capture.recordingAttemptGeneration(), 0u);
    }
    EXPECT_EQ(testArena.arena.memoryStats().usedBytes, initial.usedBytes);
}

void VerifyGpuCmdIr_RejectedAppendsPreserveBytesAndGenerationUntilRollbackCompletes(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    ASSERT_TRUE(capture.beginRecordingAttempt(31u));
    ASSERT_TRUE(GpuCmdIr_AppendMixedRecords(capture, 0u, 129u));
    GraphicsBytes original = GraphicsBytes(testArena.arena);
    CopyCommandIrBytes(capture.commandBytes(), original);
    const ArenaMemoryStats before = testArena.arena.memoryStats();
    EXPECT_FALSE(capture.beginRecordingAttempt(32u));
    const GpuSubmissionPacketId otherPlan = GpuCmdIr_MakePacketId(s_CommandIrPacket.generation + 1u, 0u);
    EXPECT_FALSE(capture.captureClearBuffer(s_CommandIrTask, otherPlan, s_CommandIrQueue, s_CommandIrDestination, 5u));
    EXPECT_FALSE(capture.captureCopyBuffer(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, s_CommandIrSource, 0u, s_CommandIrDestination, 0u, 0u));
    EXPECT_EQ(testArena.arena.memoryStats().allocationCount, before.allocationCount);
    ASSERT_EQ(capture.commandBytes().size(), original.size());
    EXPECT_TRUE(GpuCmdIr_BytesEqual(capture.commandBytes(), GpuCmdIr_GraphicsByteView(original)));
    GpuCmdIr_VerifyMixedRecords(capture, 129u);
    capture.rollback(0u);
    ASSERT_TRUE(capture.beginRecordingAttempt(32u));
    const GpuTaskId otherTask = GpuCmdIr_MakeTaskId(s_CommandIrTask.generation + 1u, 0u);
    const GpuGraphResourceId otherResource = GpuCmdIr_MakeResourceId(otherTask.generation, 0u);
    ASSERT_TRUE(capture.captureClearBuffer(otherTask, otherPlan, s_CommandIrQueue, otherResource, 7u));
    EXPECT_EQ(capture.graphGeneration(), otherTask.generation);
    EXPECT_EQ(capture.planGeneration(), otherPlan.generation);
    EXPECT_EQ(capture.recordingAttemptGeneration(), 32u);
    EXPECT_TRUE(ValidateGpuCommandIrStream(capture.commandBytes()).valid());
}

void VerifyGpuCmdIr_CapturesBorrowedCommandBytesAcrossGrowthForUploadAndPushConstants(){
    TestArena testArena = TestArena();
    Array<b8, 2> pushConstantModes = Array<b8, 2>();
    pushConstantModes[0u] = false;
    pushConstantModes[1u] = true;
    for(in b8 pushConstants : pushConstantModes){
        GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
        const BinaryByteView commands = capture.commandBytes();
        ASSERT_EQ(commands.size(), s_GpuCmdIrStreamHeaderBytes);
        const BinaryByteView source = GpuCmdIr_SubByteView(commands, 4u, commands.size() - 4u);
        GraphicsBytes expected = GraphicsBytes(testArena.arena);
        CopyCommandIrBytes(source, expected);
        if(pushConstants){
            ASSERT_TRUE(capture.capturePushConstants(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, source));
        }
        else{
            const GpuUploadBlobId blob = GpuCmdIr_MakeBlobId(s_CommandIrTask.generation, 0u);
            ASSERT_TRUE(capture.captureUploadBuffer(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, blob, s_CommandIrDestination, 0u, source, ResourceStates::CopyDest));
        }
        const auto stream = capture.exportOwned(testArena.arena);
        ASSERT_TRUE(stream.has_value());
        GpuCommandIrStreamReader reader = GpuCommandIrStreamReader(stream.value().bytes());
        ASSERT_TRUE(reader.next().has_value());
        const BinaryByteView captured = reader.blobBytes();
        ASSERT_EQ(captured.size(), expected.size());
        EXPECT_TRUE(GpuCmdIr_BytesEqual(captured, GpuCmdIr_GraphicsByteView(expected)));
    }
}

void VerifyGpuCmdIr_OwnsLargeGraphBlobAfterCallerMutationAndGraphReset(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    GraphicsBytes caller = GraphicsBytes(testArena.arena);
    GraphicsBytes expected = GraphicsBytes(testArena.arena);
    caller.resize(s_GpuCmdIrLargeBlobBytes);
    expected.resize(s_GpuCmdIrLargeBlobBytes);
    for(usize index = 0u; index < s_GpuCmdIrLargeBlobBytes; ++index){
        const u8 b = cast<u8>((index * 17u + 3u) & 0xffu);
        caller[index] = b;
        expected[index] = b;
    }

    Expected<GpuUploadBlobId> blobResult = MakeUnexpected(Failure());
    native(mut graph, in caller, mut blobResult){
        blobResult = graph.copyUploadData(caller.data(), caller.size(), alignof(u32));
    }
    ASSERT_TRUE(blobResult.has_value());
    const GpuUploadBlobId blob = blobResult.value();
    ASSERT_TRUE(blob.valid());
    const GpuTaskId task = GpuCmdIr_MakeTaskId(blob.generation, 4u);
    const GpuSubmissionPacketId packet = GpuCmdIr_MakePacketId(19u, 2u);
    const GpuGraphResourceId destination = GpuCmdIr_MakeResourceId(blob.generation, 6u);
    ASSERT_TRUE(capture.beginRecordingAttempt(31u));
    for(usize index = 0u; index < s_GpuCmdIrLargeBlobBytes; ++index)
        caller[index] = 0u;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        const auto stored = declarations.uploadBlobData(blob);
        ASSERT_TRUE(stored.has_value());
        ASSERT_EQ(stored.value().size(), s_GpuCmdIrLargeBlobBytes);
        ASSERT_TRUE(capture.captureUploadBuffer(task, packet, s_CommandIrQueue, blob, destination, 64u, stored.value(), ResourceStates::CopyDest));
    }

    graph.reset();
    const auto owned = capture.exportOwned(testArena.arena);
    ASSERT_TRUE(owned.has_value());
    ASSERT_TRUE(ValidateGpuCommandIrStream(owned.value().bytes()).valid());
    GpuCommandIrStreamReader reader = GpuCommandIrStreamReader(owned.value().bytes());
    const auto record = reader.nextBuiltinTask();
    ASSERT_TRUE(record.has_value());
    EXPECT_EQ(record.value().blobSizeBytes, s_GpuCmdIrLargeBlobBytes);
    const BinaryByteView blobBytes = reader.blobBytes();
    ASSERT_EQ(blobBytes.size(), s_GpuCmdIrLargeBlobBytes);
    EXPECT_TRUE(GpuCmdIr_BytesEqual(blobBytes, GpuCmdIr_GraphicsByteView(expected)));
    const auto terminal1 = reader.nextBuiltinTask();
    ASSERT_FALSE(terminal1.has_value());
    EXPECT_EQ(terminal1.error(), GpuCommandIrStreamReadStatus::End);

    capture.reset();
    ASSERT_TRUE(ValidateGpuCommandIrStream(owned.value().bytes()).valid());
    GpuCommandIrStreamReader retainedReader = GpuCommandIrStreamReader(owned.value().bytes());
    ASSERT_TRUE(retainedReader.nextBuiltinTask().has_value());
    EXPECT_TRUE(GpuCmdIr_BytesEqual(retainedReader.blobBytes(), GpuCmdIr_GraphicsByteView(expected)));
}

void VerifyGpuCmdIr_CheckpointRollbackKeepsExactCommandAndBlobPrefixThenRefills(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    Array<u8, 4> firstBytes = Array<u8, 4>();
    firstBytes[0u] = 0x11u;
    firstBytes[1u] = 0x22u;
    firstBytes[2u] = 0x33u;
    firstBytes[3u] = 0x44u;
    Array<u8, 8> secondBytes = Array<u8, 8>();
    secondBytes[0u] = 0x55u;
    secondBytes[1u] = 0x66u;
    secondBytes[2u] = 0x77u;
    secondBytes[3u] = 0x88u;
    secondBytes[4u] = 0x99u;
    secondBytes[5u] = 0xaau;
    secondBytes[6u] = 0xbbu;
    secondBytes[7u] = 0xccu;

    const GpuUploadBlobId firstBlob = GpuCmdIr_MakeBlobId(s_CommandIrTask.generation, 0u);
    const GpuUploadBlobId secondBlob = GpuCmdIr_MakeBlobId(s_CommandIrTask.generation, 1u);
    ASSERT_TRUE(capture.beginRecordingAttempt(31u));
    ASSERT_TRUE(capture.captureUploadBuffer(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, firstBlob, s_CommandIrDestination, 0u, GpuCmdIr_SpanByteView(firstBytes), ResourceStates::CopyDest));
    const GpuCommandIrCaptureCheckpoint checkpoint = capture.checkpoint();
    const auto prefix = capture.exportOwned(testArena.arena);
    ASSERT_TRUE(prefix.has_value());
    ASSERT_TRUE(capture.captureUploadBuffer(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, secondBlob, s_CommandIrDestination, 16u, GpuCmdIr_SpanByteView(secondBytes), ResourceStates::ShaderResource));
    const auto full = capture.exportOwned(testArena.arena);
    ASSERT_TRUE(full.has_value());
    ASSERT_EQ(capture.recordCount(), 2u);
    ASSERT_TRUE(capture.rollback(checkpoint));
    ASSERT_EQ(capture.recordCount(), 1u);
    const auto rolledBack = capture.exportOwned(testArena.arena);
    ASSERT_TRUE(rolledBack.has_value());
    ASSERT_EQ(rolledBack.value().bytes().size(), prefix.value().bytes().size());
    EXPECT_TRUE(GpuCmdIr_BytesEqual(rolledBack.value().bytes(), prefix.value().bytes()));
    ASSERT_TRUE(ValidateGpuCommandIrStream(rolledBack.value().bytes()).valid());

    ASSERT_TRUE(capture.captureUploadBuffer(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, secondBlob, s_CommandIrDestination, 16u, GpuCmdIr_SpanByteView(secondBytes), ResourceStates::ShaderResource));
    const auto refilled = capture.exportOwned(testArena.arena);
    ASSERT_TRUE(refilled.has_value());
    ASSERT_EQ(refilled.value().bytes().size(), full.value().bytes().size());
    EXPECT_TRUE(GpuCmdIr_BytesEqual(refilled.value().bytes(), full.value().bytes()));
    EXPECT_TRUE(ValidateGpuCommandIrStream(refilled.value().bytes()).valid());
}

void VerifyGpuCmdIr_RejectedInputsAndForeignOrStaleCheckpointsPreserveAcceptedBytes(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    GpuCommandIrCapture foreign = GpuCommandIrCapture(testArena.arena);
    Array<u8, 4> bytes = Array<u8, 4>();
    bytes[0u] = 0x11u;
    bytes[1u] = 0x22u;
    bytes[2u] = 0x33u;
    bytes[3u] = 0x44u;
    const GpuUploadBlobId blob = GpuCmdIr_MakeBlobId(s_CommandIrTask.generation, 0u);
    const GpuUploadBlobId staleBlob = GpuCmdIr_MakeBlobId(s_CommandIrTask.generation + 1u, 0u);
    ASSERT_TRUE(capture.beginRecordingAttempt(31u));
    ASSERT_TRUE(capture.captureUploadBuffer(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, blob, s_CommandIrDestination, 0u, GpuCmdIr_SpanByteView(bytes), ResourceStates::CopyDest));
    const GpuCommandIrCaptureCheckpoint checkpoint = capture.checkpoint();
    const auto before = capture.exportOwned(testArena.arena);
    ASSERT_TRUE(before.has_value());
    EXPECT_FALSE(capture.beginRecordingAttempt(32u));
    EXPECT_FALSE(capture.captureUploadBuffer(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, staleBlob, s_CommandIrDestination, 16u, GpuCmdIr_SpanByteView(bytes), ResourceStates::CopyDest));
    b8 nullRejected = false;
    native(mut capture, in blob, mut nullRejected){
        nullRejected = !capture.captureUploadBuffer(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, blob, s_CommandIrDestination, 16u, BinaryByteView{ nullptr, 4u }, Core::ResourceStates::CopyDest);
    }
    EXPECT_TRUE(nullRejected);
    EXPECT_FALSE(foreign.rollback(checkpoint));
    const auto after = capture.exportOwned(testArena.arena);
    ASSERT_TRUE(after.has_value());
    ASSERT_EQ(after.value().bytes().size(), before.value().bytes().size());
    EXPECT_TRUE(GpuCmdIr_BytesEqual(after.value().bytes(), before.value().bytes()));
    EXPECT_EQ(capture.recordCount(), 1u);
    EXPECT_EQ(capture.recordingAttemptGeneration(), 31u);

    capture.reset();
    EXPECT_FALSE(capture.rollback(checkpoint));
    EXPECT_EQ(capture.recordCount(), 0u);
    EXPECT_EQ(capture.recordingAttemptGeneration(), 0u);
    EXPECT_TRUE(ValidateGpuCommandIrStream(before.value().bytes()).valid());
}

b8 GpuCmdIr_CaptureTwoUploads(in BinaryByteView bufferBytes, in BinaryByteView textureBytes, mut GpuCommandIrCapture capture){
    const GpuUploadBlobId bufferBlob = GpuCmdIr_MakeBlobId(s_CommandIrTask.generation, 7u);
    const GpuUploadBlobId textureBlob = GpuCmdIr_MakeBlobId(s_CommandIrTask.generation, 8u);
    TextureSlice slice = TextureSlice();
    slice.setOrigin(0u, 0u, 0u);
    slice.setSize(4u, 3u, 2u);
    slice.setMipLevel(1u);
    slice.setArraySlice(2u);
    return capture.captureUploadBuffer(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, bufferBlob, s_CommandIrDestination, 32u, bufferBytes, ResourceStates::ShaderResource)
        && capture.captureUploadTexture(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, textureBlob, s_CommandIrDestination, slice, 16u, 48u, TextureUploadAspect::Color, textureBytes, ResourceStates::ShaderResource);
}

void VerifyGpuCmdIr_PreservesBufferAndPitchedTextureBlobsAfterCallerMutation(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    Array<u8, 5> bufferBytes = Array<u8, 5>();
    bufferBytes[0u] = 11u;
    bufferBytes[1u] = 12u;
    bufferBytes[2u] = 13u;
    bufferBytes[3u] = 14u;
    bufferBytes[4u] = 15u;
    Array<u8, 96> textureBytes = Array<u8, 96>();
    for(usize index = 0u; index < s_GpuCmdIrTextureByteCount; ++index)
        textureBytes[index] = cast<u8>(index + 1u);
    ASSERT_TRUE(GpuCmdIr_CaptureTwoUploads(GpuCmdIr_SpanByteView(bufferBytes), GpuCmdIr_SpanByteView(textureBytes), capture));

    bufferBytes[0u] = 99u;
    textureBytes[0u] = 99u;
    const BinaryByteView bytes = capture.commandBytes();
    const GpuCommandIrStreamValidationResult validation = ValidateGpuCommandIrStream(bytes);
    ASSERT_TRUE(validation.valid());

    GpuCommandIrStreamReader reader = GpuCommandIrStreamReader(bytes);
    const BinaryByteView blobs = reader.blobBytes();
    ASSERT_EQ(blobs.size(), bufferBytes.size() + textureBytes.size());
    ASSERT_FALSE(blobs.empty());
    EXPECT_EQ(blobs[0u], 11u);
    EXPECT_EQ(blobs[bufferBytes.size()], 1u);
}

void VerifyGpuCmdIr_LateBadBlobOffsetRejectsWithoutOverwritingTheFailingRecord(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    Array<u8, 4> bufferBytes = Array<u8, 4>();
    bufferBytes[0u] = 1u;
    bufferBytes[1u] = 2u;
    bufferBytes[2u] = 3u;
    bufferBytes[3u] = 4u;
    Array<u8, 96> textureBytes = Array<u8, 96>();
    ASSERT_TRUE(GpuCmdIr_CaptureTwoUploads(GpuCmdIr_SpanByteView(bufferBytes), GpuCmdIr_SpanByteView(textureBytes), capture));

    const usize secondUploadOffset = s_GpuCmdIrStreamHeaderBytes + s_GpuCmdIrUploadBufferRecordBytes;
    GraphicsBytes bytes = GraphicsBytes(testArena.arena);
    CopyCommandIrBytes(capture.commandBytes(), bytes);
    GpuCmdIr_WriteU64(secondUploadOffset + s_GpuCmdIrUploadTexBlobOffsetOffset, u64.max, bytes);
    const BinaryByteView malformed = GpuCmdIr_GraphicsByteView(bytes);
    const GpuCommandIrStreamValidationResult validation = ValidateGpuCommandIrStream(malformed);
    EXPECT_TRUE(validation.failed());
    EXPECT_EQ(validation.error, GpuCommandIrStreamValidationError::InvalidBlobRange);
    EXPECT_EQ(validation.recordIndex, 1u);
    EXPECT_EQ(validation.byteOffset, secondUploadOffset);

    GpuCommandIrStreamReader reader = GpuCommandIrStreamReader(malformed);
    const auto output = reader.nextBuiltinTask();
    ASSERT_TRUE(output.has_value());
    EXPECT_EQ(output.value().opcode, GpuCommandIrOpcode::UploadBuffer);

    const auto terminal1 = reader.nextBuiltinTask();
    ASSERT_FALSE(terminal1.has_value());
    EXPECT_EQ(terminal1.error(), GpuCommandIrStreamReadStatus::Error);

    const auto terminal2 = reader.nextBuiltinTask();
    ASSERT_FALSE(terminal2.has_value());
    EXPECT_EQ(terminal2.error(), GpuCommandIrStreamReadStatus::Error);
    EXPECT_TRUE(reader.validation().failed());
}

void VerifyGpuCmdIr_BlobSizeOverflowAndTruncationRejectTheSecondRecord(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    Array<u8, 4> bufferBytes = Array<u8, 4>();
    bufferBytes[0u] = 1u;
    bufferBytes[1u] = 2u;
    bufferBytes[2u] = 3u;
    bufferBytes[3u] = 4u;
    Array<u8, 96> textureBytes = Array<u8, 96>();
    ASSERT_TRUE(GpuCmdIr_CaptureTwoUploads(GpuCmdIr_SpanByteView(bufferBytes), GpuCmdIr_SpanByteView(textureBytes), capture));

    const usize secondUploadOffset = s_GpuCmdIrStreamHeaderBytes + s_GpuCmdIrUploadBufferRecordBytes;
    GraphicsBytes bytes = GraphicsBytes(testArena.arena);
    CopyCommandIrBytes(capture.commandBytes(), bytes);
    GpuCmdIr_WriteU64(secondUploadOffset + s_GpuCmdIrUploadTexBlobSizeOffset, u64.max, bytes);
    GpuCommandIrStreamValidationResult validation = ValidateGpuCommandIrStream(GpuCmdIr_GraphicsByteView(bytes));
    EXPECT_EQ(validation.error, GpuCommandIrStreamValidationError::InvalidBlobRange);
    EXPECT_EQ(validation.recordIndex, 1u);

    CopyCommandIrBytes(capture.commandBytes(), bytes);
    bytes.resize(bytes.size() - 1u);
    GpuCmdIr_WriteU64(s_GpuCmdIrHdrBlobBytesOffset, cast<u64>(bufferBytes.size() + textureBytes.size() - 1u), bytes);
    validation = ValidateGpuCommandIrStream(GpuCmdIr_GraphicsByteView(bytes));
    EXPECT_EQ(validation.error, GpuCommandIrStreamValidationError::InvalidBlobRange);
    EXPECT_EQ(validation.recordIndex, 1u);
    EXPECT_EQ(validation.byteOffset, secondUploadOffset);

    CopyCommandIrBytes(capture.commandBytes(), bytes);
    bytes.resize(bytes.size() - 1u);
    validation = ValidateGpuCommandIrStream(GpuCmdIr_GraphicsByteView(bytes));
    EXPECT_EQ(validation.error, GpuCommandIrStreamValidationError::PayloadSizeMismatch);
    EXPECT_EQ(validation.recordIndex, u64.max);
}

void VerifyGpuCmdIr_TruncatedLateRecordDoesNotPublishPartialOutput(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    Array<u8, 4> uploadBytes = Array<u8, 4>();
    uploadBytes[0u] = 1u;
    uploadBytes[1u] = 2u;
    uploadBytes[2u] = 3u;
    uploadBytes[3u] = 4u;
    const GpuUploadBlobId bufferBlob = GpuCmdIr_MakeBlobId(s_CommandIrTask.generation, 7u);
    ASSERT_TRUE(capture.captureClearBuffer(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, s_CommandIrDestination, 0xdecafbadu));
    ASSERT_TRUE(capture.captureUploadBuffer(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, bufferBlob, s_CommandIrDestination, 32u, GpuCmdIr_SpanByteView(uploadBytes), ResourceStates::ShaderResource));

    GraphicsBytes bytes = GraphicsBytes(testArena.arena);
    CopyCommandIrBytes(capture.commandBytes(), bytes);
    const usize secondOffset = s_GpuCmdIrStreamHeaderBytes + s_GpuCmdIrClearBufferRecordBytes;
    bytes.resize(secondOffset + s_GpuCmdIrRecordHeaderBytes);
    GpuCmdIr_WriteU64(s_GpuCmdIrHdrCommandBytesOffset, cast<u64>(s_GpuCmdIrClearBufferRecordBytes + s_GpuCmdIrRecordHeaderBytes), bytes);
    GpuCmdIr_WriteU64(s_GpuCmdIrHdrBlobBytesOffset, 0u, bytes);
    const BinaryByteView malformed = GpuCmdIr_GraphicsByteView(bytes);
    const GpuCommandIrStreamValidationResult validation = ValidateGpuCommandIrStream(malformed);
    EXPECT_EQ(validation.error, GpuCommandIrStreamValidationError::TruncatedRecord);
    EXPECT_EQ(validation.recordIndex, 1u);
    EXPECT_EQ(validation.byteOffset, secondOffset);

    GpuCommandIrStreamReader reader = GpuCommandIrStreamReader(malformed);
    const auto output = reader.nextBuiltinTask();
    ASSERT_TRUE(output.has_value());
    EXPECT_EQ(output.value().opcode, GpuCommandIrOpcode::ClearBuffer);

    const auto terminal3 = reader.nextBuiltinTask();
    ASSERT_FALSE(terminal3.has_value());
    EXPECT_EQ(terminal3.error(), GpuCommandIrStreamReadStatus::Error);
}

void VerifyGpuCmdIr_EarlierWireVersionRejectsBeforeAnyRecordOrBlobIsExposed(){
    TestArena testArena = TestArena();
    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    Array<u8, 4> uploadBytes = Array<u8, 4>();
    uploadBytes[0u] = 1u;
    uploadBytes[1u] = 2u;
    uploadBytes[2u] = 3u;
    uploadBytes[3u] = 4u;
    const GpuUploadBlobId bufferBlob = GpuCmdIr_MakeBlobId(s_CommandIrTask.generation, 7u);
    ASSERT_TRUE(capture.captureUploadBuffer(s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, bufferBlob, s_CommandIrDestination, 32u, GpuCmdIr_SpanByteView(uploadBytes), ResourceStates::ShaderResource));

    GraphicsBytes bytes = GraphicsBytes(testArena.arena);
    CopyCommandIrBytes(capture.commandBytes(), bytes);
    GpuCmdIr_WriteU16(s_GpuCmdIrPrefixVersionOffset, cast<u16>(s_GpuCommandIrStreamVersion - 1u), bytes);
    const BinaryByteView oldVersion = GpuCmdIr_GraphicsByteView(bytes);
    const GpuCommandIrStreamValidationResult validation = ValidateGpuCommandIrStream(oldVersion);
    EXPECT_EQ(validation.error, GpuCommandIrStreamValidationError::UnsupportedVersion);
    EXPECT_EQ(validation.recordIndex, u64.max);

    GpuCommandIrStreamReader reader = GpuCommandIrStreamReader(oldVersion);
    const auto terminal4 = reader.nextBuiltinTask();
    ASSERT_FALSE(terminal4.has_value());
    EXPECT_EQ(terminal4.error(), GpuCommandIrStreamReadStatus::Error);
    EXPECT_TRUE(reader.blobBytes().empty());
}


