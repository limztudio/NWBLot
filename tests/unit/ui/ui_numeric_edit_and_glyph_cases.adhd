class UiNumericEditLoanMutationSource : ComboSource{
    public TestObserved<Optional<mut IntegerEditModel>> onText;
    public TestObserved<Optional<mut IntegerEditModel>> onRevision;
    public TestObserved<Optional<mut UiNumericEditLoanMutationSource>> armSource;
    public Optional<mut IntegerEditModel> armModel;
    public TestObserved<b8> mutationApplied;

    public UiNumericEditLoanMutationSource(){ this.count = 5u; }
    public u64 revision()const override{
        if(this.onRevision.value().has_value()){
            mut IntegerEditModel model = this.onRevision.value().value();
            this.onRevision.value().reset();
            this.mutationApplied.value() = model.setValue(99);
        }
        return this.contentRevision;
    }
    public StringView text(in u64 index)const override{
        const StringView result = this.baseText(index);
        if(this.onText.value().has_value()){
            mut IntegerEditModel model = this.onText.value().value();
            this.onText.value().reset();
            this.mutationApplied.value() = model.setValue(99);
        }
        if(this.armSource.value().has_value()){
            this.armSource.value().value().onRevision.value() = this.armModel;
            this.armSource.value().reset();
        }
        return result;
    }
    public void armTextModel(mut IntegerEditModel model){
        this.onText.value() = Optional<mut IntegerEditModel>(model);
    }
    public void armRevisionOnSource(mut UiNumericEditLoanMutationSource source, mut IntegerEditModel model){
        this.armSource.value() = Optional<mut UiNumericEditLoanMutationSource>(source);
        this.armModel = Optional<mut IntegerEditModel>(model);
    }
}

