[reflect]
class RuntimeMeshHandle{
    public b8 operator==(in RuntimeMeshHandle rhs)const{
        return this.value == rhs.value;
    }

    public b8 operator!=(in RuntimeMeshHandle rhs)const{
        return this.value != rhs.value;
    }

    public b8 valid()const{
        return this.value != 0u;
    }

    public void reset(){
        this.value = 0u;
    }

    public u64 value = 0u;
}

const RuntimeMeshHandle s_InvalidRuntimeMeshHandle();


