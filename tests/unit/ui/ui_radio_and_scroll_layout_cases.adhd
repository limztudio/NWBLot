TEST(UiScrollbarLayoutTests, ExtremeFiniteStoredOffsetsClampBeforeThumbArithmetic){
    const Rect bounds{ 10.0f, 20.0f, 100.0f, 80.0f };
    ScrollViewportPlacement placement;
    const auto placementResult = CalculateScrollViewportPlacement(bounds, bounds, {}, { 399.0f, 200.0f }, 1.0f, { Limit<f32>::s_Max, Limit<f32>::s_Max }, 12.0f, 16.0f);
    ASSERT_TRUE(placementResult);
    placement = *placementResult;
    EXPECT_DOUBLE_EQ(placement.horizontal.offset, 312.0);
    EXPECT_DOUBLE_EQ(placement.vertical.offset, 132.0);
    // Lanes are horizontal thumb end, horizontal track end, vertical thumb end, vertical track end.
    const SIMDVectorSingle starts = VectorSet(placement.horizontal.thumb.x, placement.horizontal.track.x, placement.vertical.thumb.y, placement.vertical.track.y);
    const SIMDVectorSingle ends = VectorAdd(starts, VectorSet(placement.horizontal.thumb.width, placement.horizontal.track.width, placement.vertical.thumb.height, placement.vertical.track.height));
    EXPECT_FLOAT_EQ(VectorGetX(ends), VectorGetY(ends));
    EXPECT_FLOAT_EQ(VectorGetZ(ends), VectorGetW(ends));
}

TEST(UiScrollbarLayoutTests, OverscrollUpdatesClampBothThumbsAndRestoreExactStartGeometry){
    const Rect bounds{ 10.0f, 20.0f, 112.0f, 112.0f };
    ScrollViewportPlacement placement;
    const auto placementResult = CalculateScrollViewportPlacement(bounds, bounds, {}, { 399.0f, 400.0f }, 1.0f, {}, 12.0f, 0.0f);
    ASSERT_TRUE(placementResult);
    placement = *placementResult;
    const ScrollViewportPlacement initial = placement;
    ASSERT_TRUE(TryUpdateScrollViewportOffsets({ 1000.0f, 1000.0f }, placement));
    ExpectReservedGeometry(placement, initial);
    UiPaintAssertions::ExpectRect(placement.horizontal.thumb, { 85.0f, 120.0f, 25.0f, 12.0f });
    UiPaintAssertions::ExpectRect(placement.vertical.thumb, { 110.0f, 95.0f, 12.0f, 25.0f });
    ASSERT_TRUE(TryUpdateScrollViewportOffsets({}, placement));
    ExpectPlacement(placement, initial);
}

TEST(UiScrollbarLayoutTests, InvalidCalculationInputsRejectPlacement){
    const Rect bounds{ 10.0f, 20.0f, 112.0f, 112.0f };
    const Insets padding{ 1.0f, 2.0f, 3.0f, 4.0f };
    const auto reject = [](const Rect& valueBounds, const Rect& clip, const Insets& valuePadding, const Point& measure, const f32 caret, const Point& scroll, const f32 thickness, const f32 minimum){
        EXPECT_FALSE(CalculateScrollViewportPlacement(valueBounds, clip, valuePadding, measure, caret, scroll, thickness, minimum));
    };
    const f32 nan = Limit<f32>::s_QuietNaN;
    const f32 infinity = Limit<f32>::s_Infinity;
    reject({ nan, 20.0f, 112.0f, 112.0f }, bounds, padding, { 399.0f, 400.0f }, 1.0f, {}, 12.0f, 16.0f);
    reject({ 10.0f, 20.0f, -1.0f, 112.0f }, bounds, padding, { 399.0f, 400.0f }, 1.0f, {}, 12.0f, 16.0f);
    reject({ Limit<f32>::s_Max, 0.0f, Limit<f32>::s_Max, 112.0f }, bounds, padding, { 399.0f, 400.0f }, 1.0f, {}, 12.0f, 16.0f);
    reject(bounds, { 10.0f, infinity, 112.0f, 112.0f }, padding, { 399.0f, 400.0f }, 1.0f, {}, 12.0f, 16.0f);
    reject(bounds, { 10.0f, 20.0f, 112.0f, -1.0f }, padding, { 399.0f, 400.0f }, 1.0f, {}, 12.0f, 16.0f);
    reject(bounds, bounds, { -1.0f, 2.0f, 3.0f, 4.0f }, { 399.0f, 400.0f }, 1.0f, {}, 12.0f, 16.0f);
    reject(bounds, bounds, { 1.0f, 2.0f, 3.0f, nan }, { 399.0f, 400.0f }, 1.0f, {}, 12.0f, 16.0f);
    reject(bounds, bounds, padding, { -1.0f, 400.0f }, 1.0f, {}, 12.0f, 16.0f);
    reject(bounds, bounds, padding, { 399.0f, nan }, 1.0f, {}, 12.0f, 16.0f);
    reject(bounds, bounds, padding, { infinity, 400.0f }, 1.0f, {}, 12.0f, 16.0f);
    reject(bounds, bounds, padding, { 399.0f, 400.0f }, 0.0f, {}, 12.0f, 16.0f);
    reject(bounds, bounds, padding, { 399.0f, 400.0f }, infinity, {}, 12.0f, 16.0f);
    reject(bounds, bounds, padding, { 399.0f, 400.0f }, nan, {}, 12.0f, 16.0f);
    reject(bounds, bounds, padding, { 399.0f, 400.0f }, 1.0f, { -1.0f, 0.0f }, 12.0f, 16.0f);
    reject(bounds, bounds, padding, { 399.0f, 400.0f }, 1.0f, { 0.0f, infinity }, 12.0f, 16.0f);
    reject(bounds, bounds, padding, { 399.0f, 400.0f }, 1.0f, { nan, 0.0f }, 12.0f, 16.0f);
    reject(bounds, bounds, padding, { 399.0f, 400.0f }, 1.0f, {}, -1.0f, 16.0f);
    reject(bounds, bounds, padding, { 399.0f, 400.0f }, 1.0f, {}, infinity, 16.0f);
    reject(bounds, bounds, padding, { 399.0f, 400.0f }, 1.0f, {}, 12.0f, -1.0f);
    reject(bounds, bounds, padding, { 399.0f, 400.0f }, 1.0f, {}, 12.0f, nan);
}

TEST(UiScrollbarLayoutTests, UnrepresentableFinalViewportRejectsExtremeContent){
    const Rect bounds{ 0.0f, 0.0f, 112.0f, 112.0f };
    EXPECT_FALSE(CalculateScrollViewportPlacement(bounds, bounds, {}, { Limit<f32>::s_Max, Limit<f32>::s_Max }, Limit<f32>::s_Max, { Limit<f32>::s_Max, Limit<f32>::s_Max }, 12.0f, 16.0f));
    EXPECT_FALSE(CalculateScrollViewportPlacement(bounds, bounds, {}, { 1.0e30f, 1.0e30f }, 1.0f, {}, 0.0f, 16.0f));
}

TEST(UiScrollbarLayoutTests, UnrepresentableBarReservationRejectsCalculation){
    const Rect bounds{ 0.0f, 0.0f, 112.0f, 112.0f };
    EXPECT_FALSE(CalculateScrollViewportPlacement(bounds, bounds, {}, { 399.0f, 400.0f }, 1.0f, {}, 1.0e-30f, 0.0f));
}

TEST(UiScrollbarLayoutTests, InvalidOffsetRequestsPreserveBothAxesAndGeometry){
    const Rect bounds{ 0.0f, 0.0f, 112.0f, 112.0f };
    ScrollViewportPlacement previous;
    const auto previousResult = CalculateScrollViewportPlacement(bounds, bounds, {}, { 399.0f, 400.0f }, 1.0f, { 40.0f, 50.0f }, 12.0f, 16.0f);
    ASSERT_TRUE(previousResult);
    previous = *previousResult;
    const Array<Point, 4> inputs = { Point{ -1.0f, 0.0f }, Point{ 0.0f, -1.0f }, Point{ Limit<f32>::s_QuietNaN, 0.0f }, Point{ 0.0f, Limit<f32>::s_Infinity } };
    for(const Point& input : inputs){
        ScrollViewportPlacement placement = previous;
        EXPECT_FALSE(TryUpdateScrollViewportOffsets(input, placement));
        ExpectPlacement(placement, previous);
    }
}

TEST(UiScrollbarLayoutTests, InvalidOwnedProjectionRejectsOffsetUpdateAtomically){
    const Rect bounds{ 0.0f, 0.0f, 112.0f, 112.0f };
    ScrollViewportPlacement previous;
    const auto previousResult = CalculateScrollViewportPlacement(bounds, bounds, {}, { 399.0f, 400.0f }, 1.0f, {}, 12.0f, 16.0f);
    ASSERT_TRUE(previousResult);
    previous = *previousResult;
    const auto reject = [](ScrollViewportPlacement& placement){
        const ScrollViewportPlacement expected = placement;
        EXPECT_FALSE(TryUpdateScrollViewportOffsets({ 40.0f, 50.0f }, placement));
        ExpectPlacement(placement, expected);
    };
    ScrollViewportPlacement placement = previous;
    placement.horizontal.maximum = -1.0;
    reject(placement);
    placement = previous;
    placement.vertical.offset = placement.vertical.maximum + 1.0;
    reject(placement);
    placement = previous;
    placement.horizontal.viewportExtent = placement.horizontal.viewportExtent + 1.0;
    reject(placement);
    placement = previous;
    placement.vertical.thumb.height = placement.vertical.track.height + 1.0f;
    reject(placement);
    placement = previous;
    placement.horizontal.visible = false;
    reject(placement);
    placement = previous;
    placement.corner.width = -1.0f;
    reject(placement);
    placement = previous;
    placement.contentClip.y = Limit<f32>::s_Infinity;
    reject(placement);
    placement = previous;
    placement.vertical.contentExtent = Limit<f64>::s_Infinity;
    reject(placement);
}


