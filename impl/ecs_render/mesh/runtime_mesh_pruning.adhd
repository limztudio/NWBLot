#include <impl/ecs_render/mesh/mesh_system.adhd>
#include <impl/ecs_mesh/system.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
void RendererMeshSystem::pruneRuntimeMeshResources(){
    if(this.m_meshState.m_meshes.empty())
        return;

    const Optional<mut MeshSystem> meshSystem = this.m_world.borrowSystem<MeshSystem>();
    usize runtimeMeshCount = 0u;
    if(meshSystem.has_value()){
        for(in auto entry : this.m_meshState.m_meshes){
            if(entry.second.runtimeMesh)
                ++runtimeMeshCount;
        }
        if(runtimeMeshCount == 0u)
            return;
    }
    RuntimeMeshRequestSet requests(runtimeMeshCount);
    if(meshSystem.has_value()){
        for(in auto entry : this.m_meshState.m_meshes){
            in MeshResources mesh = entry.second;
            if(mesh.runtimeMesh)
                requests.add(mesh.meshName, mesh.runtimeMeshVersion);
        }
        meshSystem.value().markLiveRuntimeMeshes(requests);
    }

    auto it = this.m_meshState.m_meshes.begin();
    while(it != this.m_meshState.m_meshes.end()){
        mut MeshResources mesh = it.value();
        if(!mesh.runtimeMesh || (meshSystem.has_value() && requests.containsLive(mesh.meshName, mesh.runtimeMeshVersion))){
            ++it;
            continue;
        }
        this.releaseMeshGeometryHeapHandles(mesh);
        it = this.m_meshState.m_meshes.erase(it);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

