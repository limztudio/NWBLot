////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_GI_SURFEL_GATHER_FIELD_SLANGI
#define NWB_GRAPHICS_GI_SURFEL_GATHER_FIELD_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The including pass selects a read-only surfel field through the four macros below. Keeping the traversal here
// prevents the live deferred-lighting gather and the previous-frame trace gather from drifting apart.


#ifndef NWB_SURFEL_GATHER_FIELD_POOL
    #error NWB_SURFEL_GATHER_FIELD_POOL must select a read-only NwbSurfel buffer
#endif
#ifndef NWB_SURFEL_GATHER_FIELD_CELL_HEAD
    #error NWB_SURFEL_GATHER_FIELD_CELL_HEAD must select a read-only cell-head buffer
#endif
#ifndef NWB_SURFEL_GATHER_FIELD_CONSTANTS
    #error NWB_SURFEL_GATHER_FIELD_CONSTANTS must select NwbSurfelConstants
#endif
#ifndef NWB_SURFEL_GATHER_FIELD_INDEX_VALID
    #error NWB_SURFEL_GATHER_FIELD_INDEX_VALID must validate a cell-list index
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "surfel_heap_resources.slangi"
#include "surfel_hash.slangi"
#include "surfel_sh.slangi"
#include "surfel_coverage.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


bool nwbSurfelGatherField(
    const float3 worldPosition,
    const float3 normal,
    const uint poolCapacity,
    out half3 outIrradiance,
    out half outCoverage
){
    outIrradiance = half3(0.0h);
    outCoverage = half(0.0h);

    const float cellSize = NWB_SURFEL_GATHER_FIELD_CONSTANTS.cameraPositionCellSize.w;
    const uint cellCount = uint(NWB_SURFEL_GATHER_FIELD_CONSTANTS.hashPoolFrameDivisor.x);
    const float normalBias = NWB_SURFEL_GATHER_FIELD_CONSTANTS.coverageRadiusBiasHyst.z;
    const float3 biasedPosition = worldPosition + normal * normalBias;

    half3 irradianceSum = half3(0.0h);
    // Gather weights are (0, 1) bounded factors, so half arithmetic is sufficient here.
    half totalWeight = half(0.0h);
    const int3 baseCell = nwbSurfelCellCoord(biasedPosition, cellSize);
    for(int dz = -NWB_SURFEL_GATHER_CELL_EXTENT; dz <= NWB_SURFEL_GATHER_CELL_EXTENT; ++dz)
    for(int dy = -NWB_SURFEL_GATHER_CELL_EXTENT; dy <= NWB_SURFEL_GATHER_CELL_EXTENT; ++dy){
        // These immutable heads are independent of each list walk; consume them in the original dx order.
        uint rowHeads[2 * NWB_SURFEL_GATHER_CELL_EXTENT + 1];
        [unroll] for(int dx = -NWB_SURFEL_GATHER_CELL_EXTENT; dx <= NWB_SURFEL_GATHER_CELL_EXTENT; ++dx){
            const uint bucket = nwbSurfelHashCell(baseCell + int3(dx, dy, dz), cellCount);
            rowHeads[dx + NWB_SURFEL_GATHER_CELL_EXTENT] = NWB_SURFEL_GATHER_FIELD_CELL_HEAD[bucket];
        }
        for(int dx = -NWB_SURFEL_GATHER_CELL_EXTENT; dx <= NWB_SURFEL_GATHER_CELL_EXTENT; ++dx){
            uint id = rowHeads[dx + NWB_SURFEL_GATHER_CELL_EXTENT];
            uint walk = 0u;
            [loop] while(NWB_SURFEL_GATHER_FIELD_INDEX_VALID(id, poolCapacity) && walk < NWB_SURFEL_MAX_WALK){
                const uint nextInCell = NWB_SURFEL_GATHER_FIELD_POOL[id].nextInCell;
                const uint sampleCount = NWB_SURFEL_GATHER_FIELD_POOL[id].sampleCount;
                if(NWB_SURFEL_GATHER_FIELD_POOL[id].alive != 0u && sampleCount != 0u){
                    const float dist = length(biasedPosition - NWB_SURFEL_GATHER_FIELD_POOL[id].position);
                    const half normalWeight = half(saturate(dot(normal, NWB_SURFEL_GATHER_FIELD_POOL[id].normal)));
                    const half distanceWeight = half(saturate(1.0 - dist / max(NWB_SURFEL_GATHER_FIELD_POOL[id].radius, NWB_SURFEL_RADIUS_MIN)));
                    const half confidence = half(saturate(float(sampleCount) / NWB_SURFEL_GATHER_FULL_CONFIDENCE_SAMPLE_COUNT));
                    const half weight = normalWeight * distanceWeight * confidence;
                    // Different faces now share buckets. Avoid fetching and reconstructing their SH when the exact
                    // rounded gather weight is zero; retain the original order and weights of all contributors.
                    if(weight > half(0.0h)){
                        irradianceSum += nwbSurfelShReconstruct(
                            half4(NWB_SURFEL_GATHER_FIELD_POOL[id].shR),
                            half4(NWB_SURFEL_GATHER_FIELD_POOL[id].shG),
                            half4(NWB_SURFEL_GATHER_FIELD_POOL[id].shB), normal
                        ) * weight;
                    }
                    totalWeight += weight;
                }
                id = nextInCell;
                ++walk;
            }
        }
    }

    if(totalWeight < half(NWB_SURFEL_GATHER_WEIGHT_EPSILON))
        return false;
    // Keep the field's normalized irradiance for bounce tracing. Coverage separately fades its visible contribution
    // near the edge of a surfel's support, where dividing by a tiny weight would otherwise cause a hard cutoff.
    outIrradiance = irradianceSum / totalWeight;
    outCoverage = half(nwbSurfelGatherCoverage(float(totalWeight)));
    return true;
}

// Bounce tracing uses the normalized previous-frame field, not its screen-space ambient-blend confidence.
bool nwbSurfelGatherField(
    const float3 worldPosition,
    const float3 normal,
    const uint poolCapacity,
    out half3 outIrradiance
){
    half ignoredCoverage;
    return nwbSurfelGatherField(worldPosition, normal, poolCapacity, outIrradiance, ignoredCoverage);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

