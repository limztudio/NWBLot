[cpp_header("<core/telemetry/recorder.h>"), cpp_name("::NWB::Core::Telemetry::s_DiagnosticCaptureEventCapacity")]
extern const usize s_DiagnosticCaptureEventCapacity;
[cpp_header("<core/telemetry/recorder.h>"), cpp_name("::NWB::Core::Telemetry::s_DiagnosticCapturePayloadCapacity")]
