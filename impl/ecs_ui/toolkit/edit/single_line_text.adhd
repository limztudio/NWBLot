////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/edit/text_normalization.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<String, EditTextStatus> NormalizeSingleLineText(in StringView source, in usize maxBytes){
    String candidate;
    const Expected<usize, EditTextStatus> status = NormalizeEditTextInto(source, maxBytes, false, candidate);
    if(!status.has_value())
        return MakeUnexpected(status.error());
    return candidate;
}

Expected<String, EditTextStatus> NormalizeMultilineText(in StringView source, in usize maxBytes){
    String candidate;
    const Expected<usize, EditTextStatus> status = NormalizeEditTextInto(source, maxBytes, true, candidate);
    if(!status.has_value())
        return MakeUnexpected(status.error());
    return candidate;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

