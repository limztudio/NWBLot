////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "gpu_probe_resources.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_CsgRayProbeCaseCount = 25u;
const u32 s_CsgRayProbeWordCount = s_CsgRayProbeCaseCount + 4u;
const u32 s_CsgRayProbeSentinel = 0xa59137cbu;

class CsgRayProbeTask{
    public BufferHandle output = BufferHandle();
    public BufferHandle readback = BufferHandle();
    public ComputePipelineHandle pipeline = ComputePipelineHandle();
    public mut GpuDescriptorHeap heap;
    public u32 slot = 0u;

    public CsgRayProbeTask(mut GpuDescriptorHeap heap){
        this.heap = heap;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return ComputeTransferProbeCommands(); }

    [cpp_unwind]
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const{
        commands.setBufferState(this.output.deref(), ResourceStates::UnorderedAccess);
        commands.commitBarriers();
        commands.clearBufferUInt(this.output.deref(), s_CsgRayProbeSentinel);
        ComputeState state;
        state.setPipeline(this.pipeline.deref());
        commands.setComputeState(state);
        this.heap.bindCompute(commands, this.pipeline.deref());
        commands.setPushConstants(this.slot);
        commands.dispatch(1u, 1u, 1u);
        commands.setBufferState(this.output.deref(), ResourceStates::CopySource);
        commands.commitBarriers();
        commands.copyBuffer(this.readback.deref(), 0u, this.output.deref(), 0u, s_CsgRayProbeWordCount * size_of<u32>());
        commands.setBufferState(this.output.deref(), ResourceStates::CopyDest);
        commands.commitBarriers();
        return !commands.commandRecordingFailed();
    }
}

[cpp_unwind]
Expected<GpuTaskId> DeclareCsgRayProbe(in CsgRayProbeTask payload, mut GpuTaskGraph graph){
    const Array<BufferHandle, 2u> buffers(payload.output, payload.readback);
    Array<GpuTaskResourceUse, 2u> uses;
    for(u32 i = 0u; i < buffers.size(); ++i){
        GpuGraphResourceDesc description;
        description.setIdentity(buffers[i].deref().getCreationDescription().debugName).setMarkerLabel("CSG ray edge probe buffer")
            .setType(GpuGraphResourceType::Buffer).setInitialState(ResourceStates::CopyDest).setExternalFinalState(ResourceStates::CopyDest);
        const auto imported = graph.importBuffer(buffers[i], description);
        if(!imported.has_value())
            return MakeUnexpected(Failure());
        uses[i].resource = imported.value();
        uses[i].requiredState = ResourceStates::CopyDest;
        uses[i].access = GpuTaskResourceAccess::ReadWrite;
    }
    GpuTaskDesc description;
    description.setIdentity(Name("tests/csg_ray/dispatch")).setMarkerLabel("CSG ray edge probe").setResourceUses(uses);
    CsgRayProbeTask recorded = payload;
    const auto task = graph.addPayloadTask(description, recorded);
    if(!task.has_value() || !task.value().valid())
        return MakeUnexpected(Failure());
    return task;
}

[cpp_unwind]
Expected<void> RunCsgRayRuntimeProbe(mut ProjectRuntimeContext context){
    mut GraphicsRuntime graphics = context.graphics;
    mut Device device = graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    ComputePipelineHandle pipeline;
    if(!LoadGpuProbePipeline(context, Name("project/shaders/csg_ray_probe_cs"), s_DefaultVariant, Name("tests/csg_ray/shader"), "CsgRayProbe", size_of<u32>(), pipeline))
        return MakeUnexpected(Failure());
    BufferDesc description;
    description.setDebugName(Name("tests/csg_ray/output")).setByteSize(s_CsgRayProbeWordCount * size_of<u32>()).setStructStride(size_of<u32>())
        .setCanHaveUAVs(true).enableAutomaticStateTracking(ResourceStates::CopyDest);
    const auto output = graphics.createBuffer(description);
    if(!output.has_value())
        return MakeUnexpected(Failure());
    description.setDebugName(Name("tests/csg_ray/readback")).setCanHaveUAVs(false).setCpuAccess(CpuAccessMode::Read);
    const auto readback = graphics.createBuffer(description);
    if(!readback.has_value())
        return MakeUnexpected(Failure());
    const auto descriptor = heap.allocate(GpuDescriptorClass::StorageBuffer);
    if(!descriptor.has_value())
        return MakeUnexpected(Failure());
    GpuProbeDescriptors cleanup(graphics);
    cleanup.retain(descriptor.value());
    if(!heap.write(descriptor.value(), DescriptorWriteItemStructuredBufferUav(0u, output.value().deref())))
        return MakeUnexpected(Failure());
    CsgRayProbeTask payload(heap);
    payload.output = output.value();
    payload.readback = readback.value();
    payload.pipeline = pipeline;
    payload.slot = descriptor.value().slot();
    const auto token = graphics.standaloneGraph().submitStandaloneTaskGraph(
        lambda[in payload](mut GpuTaskGraph graph) -> Expected<GpuTaskId>{ return DeclareCsgRayProbe(payload, graph); }, GpuPhysicalQueueId());
    if(!token.has_value() || !device.waitForSubmissionToken(token.value()))
        return MakeUnexpected(Failure());
    Array<u32, s_CsgRayProbeWordCount> words;
    if(!device.readMappedBuffer(payload.readback.deref(), words))
        return MakeUnexpected(Failure());
    for(u32 i = 0u; i < words.size(); ++i){
        u32 expected = s_CsgRayProbeSentinel;
        if(i < s_CsgRayProbeCaseCount)
            expected = 1u;
        if(words[i] != expected){
            error("CsgRayProbe: case {} expected {} observed {}", i, expected, words[i]);
            return MakeUnexpected(Failure());
        }
    }
    [essential] info("CsgRayProbe: passed 25 shared-edge, winding, thin-span, exact-predicate and conservative-BVH cases with sentinel checks");
    return Expected<void>();
}


