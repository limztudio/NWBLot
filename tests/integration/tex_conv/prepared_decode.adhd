#include "name_cases.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_texture/cook.adhd.h>
#include <impl/assets_texture/texture_mip_decoder.adhd.h>

#include <basisu_transcoder.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace NWB::Tests::TextureDecodeCases{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using AssetArena = Core::Assets::AssetArena;
using ScratchArena = Core::Alloc::ScratchArena;
using MetascriptDocument = Core::Metascript::Document;
using Impl::Texture;
using Impl::TextureCookEntry;
using Impl::TextureMipLevel;
using Impl::BuildTextureAsset;
using Impl::ParseTextureCookMetadata;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Name s_DecodeArena = s_OneOffNameTestsIntegrationTexConvPreparedDecode;
const usize s_MaxFixtureBytes = 64u * 1024u * 1024u;
const u32 s_ChannelCount = 4u;
const f32 s_Unorm8MaxF32 = 255.0f;

Expected<u32> ParseMipIndex(in StringView mipText){
    if(mipText.empty())
        return MakeUnexpected(Failure());
    u32 mipIndex = 0u;
    for(usize i = 0u; i < mipText.size(); ++i){
        const u8 ch = cast<u8>(mipText[i]);
        if(ch < 48u || ch > 57u)
            return MakeUnexpected(Failure());
        const u32 digit = cast<u32>(ch - 48u);
        if(mipIndex > (u32.max - digit) / 10u)
            return MakeUnexpected(Failure());
        mipIndex = mipIndex * 10u + digit;
    }
    return mipIndex;
}

void WriteLittleEndianU32(mut Vector<u8> output, mut usize offset, in u32 value){
    for(u32 byte = 0u; byte < 4u; ++byte){
        output[offset] = cast<u8>(value >> (byte * 8u));
        offset += 1u;
    }
}

Expected<Texture> CookDecodedTexture(in Path sourcePath, in MetascriptDocument document, mut AssetArena assetArena, mut ScratchArena scratchArena){
    const Expected<TextureCookEntry> entry = ParseTextureCookMetadata(sourcePath.parentPath(), "tests", sourcePath, document, assetArena, scratchArena);
    if(!entry.has_value())
        return MakeUnexpected(Failure());
    return BuildTextureAsset(entry.value(), assetArena);
}

b8 Decode(in StringView source, in StringView destination, in StringView mipText){
    const Expected<u32> mipIndexResult = ParseMipIndex(mipText);
    if(!mipIndexResult.has_value())
        return false;
    const u32 mipIndex = mipIndexResult.value();

    AssetArena assetArena(s_DecodeArena);
    ScratchArena scratchArena(s_DecodeArena);
    const Path sourcePath = Path(source);
    const Path destinationPath = Path(destination);
    String metadata = "";
    if(!ReadTextFile(sourcePath, metadata).has_value())
        return false;
    MetascriptDocument document(assetArena);
    if(!document.parse(metadata))
        return false;
    const Expected<Texture> builtTexture = CookDecodedTexture(sourcePath, document, assetArena, scratchArena);
    if(!builtTexture.has_value() || cast<usize>(mipIndex) >= builtTexture.value().mipLevels().size())
        return false;

    in Texture texture = builtTexture.value();
    const TextureMipLevel mip = texture.mipLevels()[mipIndex];
    const u64 planeTexels = cast<u64>(mip.width) * cast<u64>(mip.height);
    const u64 bytesPerPlaneTexel = cast<u64>(mip.sliceCount) * cast<u64>(s_ChannelCount) * 4u;
    if(bytesPerPlaneTexel == 0u || planeTexels > cast<u64>(s_MaxFixtureBytes) / bytesPerPlaneTexel)
        return false;
    const usize componentCount = cast<usize>(planeTexels * cast<u64>(mip.sliceCount) * cast<u64>(s_ChannelCount));
    const b8 hdr = IsHdrTexturePayloadFormat(texture.payloadFormat());

    Vector<u8> decodedBytes = Vector<u8>();
    b8 decodedOk = false;
    native(in texture, in mip, in mipIndex, in hdr, mut scratchArena, mut decodedBytes, mut decodedOk){
        basist::basisu_transcoder_init();
        NWB::Impl::TextureMipDecoder decoder;
        const auto decoded = decoder.decode(texture, mip, mipIndex, hdr ? NWB::Core::Format::RGBA16_FLOAT : NWB::Core::Format::RGBA8_UNORM, scratchArena);
        if(!decoded)
            return false;
        decodedBytes.assign(decoded->bytes.begin(), decoded->bytes.end());
        decodedOk = true;
    }
    usize bytesPerComponent = 1u;
    if(hdr)
        bytesPerComponent = 2u;
    if(!decodedOk || decodedBytes.size() != componentCount * bytesPerComponent)
        return false;

    // Export the selected mip extent followed by interleaved linear RGBA binary32 values in little-endian order.
    Vector<u8> output = Vector<u8>();
    output.resize(cast<usize>(s_ChannelCount) * 4u + componentCount * 4u);
    usize offset = 0u;
    WriteLittleEndianU32(output, offset, mip.width);
    WriteLittleEndianU32(output, offset, mip.height);
    WriteLittleEndianU32(output, offset, mip.sliceCount);
    WriteLittleEndianU32(output, offset, s_ChannelCount);
    for(usize index = 0u; index < componentCount; ++index){
        f32 value = 0.0f;
        if(hdr){
            const u16 halfBits = cast<u16>(decodedBytes[index * 2u]) | (cast<u16>(decodedBytes[index * 2u + 1u]) << 8u);
            value = ConvertHalfToFloat(halfBits);
        }
        else{
            value = cast<f32>(decodedBytes[index]) / s_Unorm8MaxF32;
        }
        WriteLittleEndianU32(output, offset, BitCast<u32>(value));
    }
    return WriteBinaryFile(destinationPath, output);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <logger/client/module.h>

#include <core/common/application_entry.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_tex_conv_prepared_decode{
int Run(const int argc, char** argv){
    using namespace NWB::Tests::TextureDecodeCases;
    NWB::Log::ClientStandalone logger;
    if(!logger.init(FOUNDATION_TEXT("tex_conv_prepared_decode"))){
        FOUNDATION_TCERR << FOUNDATION_TEXT("[tex_conv_prepared_decode] logger.init() failed\n");
        return 1;
    }
    NWB::Core::Common::LoggerRegistrationGuard loggerGuard(logger, NWB::Core::Common::LoggerBreakPolicy::BreakOnFatal);
    constexpr int s_ExpectedArgCount = 4;
    if(argc != s_ExpectedArgCount || !Decode(argv[1], argv[2], argv[3])){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("tex_conv_prepared_decode: expected valid texture metadata with its paired raw sidecar, output filename, and mip index."));
        return 1;
    }
    return 0;
}
};

NWB_DEFINE_UTF8_APPLICATION_ENTRY_POINT(__hidden_tex_conv_prepared_decode::Run)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


