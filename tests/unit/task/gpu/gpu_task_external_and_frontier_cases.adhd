#define EXPECT_TRUE(...) native{ EXPECT_TRUE(...) }
#define EXPECT_FALSE(...) native{ EXPECT_FALSE(...) }
#define EXPECT_EQ(...) native{ EXPECT_EQ(...) }

b8 GpuTaskExternalAndFrontierCasesReady(in u64 value){
    return value != 0u;
}

native{
#include <tests/unit/task/gpu/suite.adhd.h>

#include <tests/unit/task/gpu/case_types.adhd.h>

#include <core/task/gpu/packet_runtime_internal.h>


