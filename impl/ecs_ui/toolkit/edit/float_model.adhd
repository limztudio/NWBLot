#include <impl/ecs_ui/toolkit/edit/numeric_model_operations.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <global/numeric_text.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Committed doubles are finite; signed zero and every finite value survive canonical text roundtrips.
class FloatEditModel final : public NumericEditModelBase<f64, FloatBounds, FloatEditModel>{
    friend class NumericEditModelBase<f64, FloatBounds, FloatEditModel>;


public:
    explicit FloatEditModel(Core::Alloc::GlobalArena& arena);


public:
    [[nodiscard]] NumericParseStatus::Enum status(const FloatBounds& bounds = {})const noexcept;

    // Nonfinite values fail atomically. Successful external replacements always fence pending input.
    [[nodiscard]] b8 setValue(f64 value);


private:
    [[nodiscard]] NumericEditResult commit(const FloatBounds& bounds, b8 canonical);
    [[nodiscard]] Expected<b8, ErrorCode> canonicalize(f64 value);
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f64 s_DefaultFloatEditValue = 0.0;

b8 HasFloatEditBitsChanged(in f64 candidate, in f64 value){
    return bit_cast<u64>(candidate) != bit_cast<u64>(value);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


FloatEditModel::FloatEditModel(Core::Alloc::GlobalArena& arena)
    : NumericEditModelBase(arena)
{
    initializeDefault(s_DefaultFloatEditValue);
}

NumericParseStatus::Enum FloatEditModel::status(const FloatBounds& bounds)const noexcept{
    return EvaluateFloatDraftStatus(m_draft.text(), bounds);
}

b8 FloatEditModel::setValue(const f64 value){
    return IsFinite(value) && assignAuthoritativeValue(value);
}

NumericEditResult FloatEditModel::commit(const FloatBounds& bounds, const b8 canonical){
    return commitDraftWith(
        bounds,
        canonical,
        ValidateFloatBounds,
        ParseFloatDraft,
        HasFloatEditBitsChanged
    );
}

Expected<b8, ErrorCode> FloatEditModel::canonicalize(const f64 value){
    return canonicalizeWith(value, [](const f64 candidate, const Span<char> buffer)noexcept{ return FormatF64(candidate, buffer); });
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

