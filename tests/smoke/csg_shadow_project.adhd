#include "csg_shadow_runtime.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CsgShadowSmokeProject : IProjectEntryCallbacks{
    public CsgShadowSmokeProject(mut ProjectRuntimeContext context){
        this.m_impl = CsgShadowSmokeProjectImpl(context);
    }

    public b8 onStartup()override{
        return this.m_impl.onStartup();
    }

    public void onShutdown()override{
        this.m_impl.onShutdown();
    }

    public b8 onUpdate(in f32 delta)override{
        return this.m_impl.onUpdate(delta);
    }

    private CsgShadowSmokeProjectImpl m_impl;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
