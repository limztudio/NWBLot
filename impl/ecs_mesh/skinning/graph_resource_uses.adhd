////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_mesh/skinning/graph_dispatch_plan.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> SkinningGraphResourceUseError{
    MissingPlans,
    DeformationUsesFailed,
    PostDispatchUsesFailed,
    LocalBoundsUsesFailed,
    FinalizerUsesFailed,
    MissingFinalState
}

class MeshSkinningGraphResourceUses{
    public Vector<GpuTaskResourceUse> deformation;
    public Vector<GpuTaskResourceUse> postDispatch;
    public Vector<GpuTaskResourceUse> localBounds;
    public Vector<GpuTaskResourceUse> finalizer;
}

class SkinningResourceKey{
    public GpuGraphResourceId resource;

    public SkinningResourceKey(in GpuGraphResourceId resourceId){
        this.resource = resourceId;
    }

    public b8 operator==(in SkinningResourceKey other)const{
        return this.resource == other.resource;
    }

    public usize hash()const{
        return HashCombineValue(HashValue(this.resource.generation), this.resource.index);
    }
}

class SkinningResourceUseInfo{
    public usize outputIndex = 0u;
    public ResourceStates requiredState = ResourceStates::Unknown;
    public GpuTaskResourceAccess access = GpuTaskResourceAccess::Read;
}

class SkinningResourceUseEntry{
    public GpuGraphResourceId resource = GpuGraphResourceId();
    public SkinningResourceUseInfo useInfo;
}

type SkinningResourceUseIndex = HashMap<SkinningResourceKey, SkinningResourceUseInfo>;

class SkinningResourceUseCollector<const usize Capacity>{
    private Array<SkinningResourceUseEntry, Capacity> m_inline;
    private Optional<SkinningResourceUseIndex> m_index;
    private usize m_count = 0u;

    public b8 empty()const{
        return this.m_count == 0u;
    }

    public void clear(){
        this.m_count = 0u;
        if(this.m_index.has_value())
            this.m_index.value().clear();
    }

    public b8 add(in GpuGraphResourceId resource, in ResourceStates state, in GpuTaskResourceAccess access){
        if(!resource.valid())
            return false;
        SkinningResourceUseInfo useInfo = SkinningResourceUseInfo();
        useInfo.outputIndex = this.m_count;
        useInfo.requiredState = state;
        useInfo.access = access;

        if(!this.m_index.has_value()){
            for(usize index = 0u; index < this.m_count; ++index){
                mut SkinningResourceUseEntry entry = this.m_inline[index];
                if(entry.resource == resource)
                    return MergeSkinningResourceUse(state, access, entry.useInfo);
            }
            if(this.m_count < Capacity){
                this.m_inline[this.m_count].resource = resource;
                this.m_inline[this.m_count].useInfo = useInfo;
                ++this.m_count;
                return true;
            }

            if(!this.promoteIndex())
                return false;
        }

        auto inserted = this.m_index.value().try_emplace(SkinningResourceKey(resource), useInfo);
        if(inserted.second){
            ++this.m_count;
            return true;
        }
        return MergeSkinningResourceUse(state, access, inserted.first.value());
    }

    public void writeTo(mut Vector<GpuTaskResourceUse> uses)const{
        uses.resize(this.m_count);
        if(this.m_index.has_value()){
            in HashMap<SkinningResourceKey, SkinningResourceUseInfo> entries = this.m_index.value();
            for(auto it = entries.begin(); it != entries.end(); ++it)
                uses[it.value().outputIndex] = MakeSkinningResourceUse(it.key().resource, it.value());
        }
        else{
            for(usize index = 0u; index < this.m_count; ++index){
                in SkinningResourceUseEntry entry = this.m_inline[index];
                uses[index] = MakeSkinningResourceUse(entry.resource, entry.useInfo);
            }
        }
    }

    private b8 promoteIndex(){
        this.m_index = Optional<SkinningResourceUseIndex>(SkinningResourceUseIndex());
        this.m_index.value().reserve(ComputePromotedSkinningResourceUseCapacity(Capacity, s_SkinningPromotedIndexCapacityFactor));
        for(usize index = 0u; index < this.m_count; ++index){
            in SkinningResourceUseEntry entry = this.m_inline[index];
            if(!this.m_index.value().try_emplace(SkinningResourceKey(entry.resource), entry.useInfo).second){
                assert(false);
                return false;
            }
        }
        return true;
    }
}

class MeshSkinningGraphResourceUseScratch{
    public MeshSkinningGraphResourceUses uses;
    public SkinningResourceUseCollector<s_SkinningDeformationUseCapacity> deformation;
    public SkinningResourceUseCollector<s_SkinningPostDispatchUseCapacity> postDispatch;
    public SkinningResourceUseCollector<s_SkinningLocalBoundsUseCapacity> localBounds;
    public SkinningResourceUseCollector<s_SkinningFinalizerUseCapacity> finalizer;

    public void clear(){
        this.uses.deformation.clear();
        this.uses.postDispatch.clear();
        this.uses.localBounds.clear();
        this.uses.finalizer.clear();
        this.deformation.clear();
        this.postDispatch.clear();
        this.localBounds.clear();
        this.finalizer.clear();
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize ComputePromotedSkinningResourceUseCapacity(in usize inlineCapacity, in usize factor){
    return inlineCapacity * factor;
}

b8 ShouldDeclareSkinningStreamFinalizerUses(in b8 hasActiveSkin, in b8 copiedRestStreams){
    return hasActiveSkin || copiedRestStreams;
}

void ReportSkinningGraphResourceUseError(in SkinningGraphResourceUseError err){
    switch(err){
    case SkinningGraphResourceUseError::MissingPlans:
        error("MeshSkinningSystem: graph resource uses require dispatch plans");
        break;
    case SkinningGraphResourceUseError::DeformationUsesFailed:
        error("MeshSkinningSystem: failed to declare graph resource uses for skinning deformation");
        break;
    case SkinningGraphResourceUseError::PostDispatchUsesFailed:
        error("MeshSkinningSystem: failed to declare graph resource uses for skinning bounds/repack");
        break;
    case SkinningGraphResourceUseError::LocalBoundsUsesFailed:
        error("MeshSkinningSystem: failed to declare local bounds reduction resources");
        break;
    case SkinningGraphResourceUseError::FinalizerUsesFailed:
        error("MeshSkinningSystem: failed to declare graph-owned skinning final states");
        break;
    case SkinningGraphResourceUseError::MissingFinalState:
        error("MeshSkinningSystem: graph-owned skinning dispatch has no final state");
        break;
    }
}

b8 MergeSkinningResourceUse(in ResourceStates state, in GpuTaskResourceAccess access, mut SkinningResourceUseInfo useInfo){
    if(useInfo.requiredState != state)
        return false;
    if(useInfo.access != access)
        useInfo.access = GpuTaskResourceAccess::ReadWrite;
    return true;
}

GpuTaskResourceUse MakeSkinningResourceUse(in GpuGraphResourceId resource, in SkinningResourceUseInfo useInfo){
    GpuTaskResourceUse use = GpuTaskResourceUse();
    use.resource = resource;
    use.requiredState = useInfo.requiredState;
    use.access = useInfo.access;
    return use;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 BuildMeshSkinningGraphResourceUsesInto(in Span<MeshSkinningGraphDispatchPlan> plans, mut MeshSkinningGraphResourceUseScratch scratch){
    scratch.clear();
    if(plans.empty())
        return true;
    if(!plans.data()){
        ReportSkinningGraphResourceUseError(SkinningGraphResourceUseError::MissingPlans);
        return false;
    }

    mut SkinningResourceUseCollector<s_SkinningDeformationUseCapacity> deformation = scratch.deformation;
    mut SkinningResourceUseCollector<s_SkinningPostDispatchUseCapacity> postDispatch = scratch.postDispatch;
    mut SkinningResourceUseCollector<s_SkinningLocalBoundsUseCapacity> localBounds = scratch.localBounds;
    mut SkinningResourceUseCollector<s_SkinningFinalizerUseCapacity> finalizer = scratch.finalizer;
    for(in MeshSkinningGraphDispatchPlan plan : plans){
        if(!plan.hasActiveSkin)
            continue;
        if(
            !deformation.add(plan.bindlessResourceSlotsResource, ResourceStates::ConstantBuffer, GpuTaskResourceAccess::Read)
            || !deformation.add(plan.restPositionResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
            || !deformation.add(plan.restNormalResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
            || !deformation.add(plan.restTangentResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
            || !deformation.add(plan.skinnedPositionResource, ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write)
            || !deformation.add(plan.skinnedNormalResource, ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write)
            || !deformation.add(plan.skinnedTangentResource, ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write)
            || !deformation.add(plan.meshletDescResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
            || !deformation.add(plan.meshletPositionRefDeltaResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
            || !deformation.add(plan.meshletAttributeRefDeltaResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
            || !deformation.add(plan.attributeSkinResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
            || !deformation.add(plan.skinResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
            || !deformation.add(plan.jointPaletteResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
        ){
            ReportSkinningGraphResourceUseError(SkinningGraphResourceUseError::DeformationUsesFailed);
            return false;
        }
    }

    for(in MeshSkinningGraphDispatchPlan plan : plans){
        if(
            !postDispatch.add(plan.bindlessResourceSlotsResource, ResourceStates::ConstantBuffer, GpuTaskResourceAccess::Read)
            || !postDispatch.add(plan.skinnedPositionResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
            || !postDispatch.add(plan.meshletDescResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
            || !postDispatch.add(plan.meshletPositionRefDeltaResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
            || !postDispatch.add(plan.meshletLocalVertexRefResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
            || !postDispatch.add(plan.meshletPrimitiveIndexResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
            || !postDispatch.add(plan.meshletBoundsResource, ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write)
            || (plan.updatesMeshletBounds && !postDispatch.add(plan.meshletLocalBoundsResource, ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write))
            || (plan.repacksNormals && (
                !postDispatch.add(plan.skinnedNormalResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
                || !postDispatch.add(plan.meshletAttributeRefDeltaResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
                || !postDispatch.add(plan.attributeResource, ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write)
            ))
        ){
            ReportSkinningGraphResourceUseError(SkinningGraphResourceUseError::PostDispatchUsesFailed);
            return false;
        }
    }

    for(in MeshSkinningGraphDispatchPlan plan : plans){
        if(!plan.updatesMeshletBounds)
            continue;
        if(
            !localBounds.add(plan.bindlessResourceSlotsResource, ResourceStates::ConstantBuffer, GpuTaskResourceAccess::Read)
            || !localBounds.add(plan.meshletLocalBoundsResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
            || !localBounds.add(plan.localBoundsResource, ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write)
        ){
            ReportSkinningGraphResourceUseError(SkinningGraphResourceUseError::LocalBoundsUsesFailed);
            return false;
        }
    }

    for(in MeshSkinningGraphDispatchPlan plan : plans){
        if(
            (ShouldDeclareSkinningStreamFinalizerUses(plan.hasActiveSkin, plan.copiedRestStreams) && (
                !finalizer.add(plan.skinnedPositionResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
                || !finalizer.add(plan.skinnedNormalResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
                || !finalizer.add(plan.skinnedTangentResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
            ))
            || (plan.updatesMeshletBounds && (
                !finalizer.add(plan.meshletBoundsResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
                || !finalizer.add(plan.localBoundsResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
            ))
            || (plan.repacksNormals && !finalizer.add(plan.attributeResource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read))
        ){
            ReportSkinningGraphResourceUseError(SkinningGraphResourceUseError::FinalizerUsesFailed);
            return false;
        }
    }
    if(finalizer.empty()){
        ReportSkinningGraphResourceUseError(SkinningGraphResourceUseError::MissingFinalState);
        return false;
    }

    deformation.writeTo(scratch.uses.deformation);
    postDispatch.writeTo(scratch.uses.postDispatch);
    localBounds.writeTo(scratch.uses.localBounds);
    finalizer.writeTo(scratch.uses.finalizer);
    return true;
}

Expected<MeshSkinningGraphResourceUses> BuildMeshSkinningGraphResourceUses(in Span<MeshSkinningGraphDispatchPlan> plans){
    MeshSkinningGraphResourceUseScratch scratch;
    if(!BuildMeshSkinningGraphResourceUsesInto(plans, scratch))
        return MakeUnexpected(Failure());
    return scratch.uses;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

