// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/raytrace/raytrace_internal.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_RefractionDiagnosticVariantCount = 2u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RayTraceSceneQueryReadinessPolicy{
    public b8 canPrepareSceneQuery(
        in b8 hardwareSupported, in b8 traceResourcesPreflighted, in b8 rayQuerySupported, in b8 heapInitialized, in b8 heapHasAccelStructLayout,
        in b8 hasTlas, in b8 tlasHeapHandleValid, in b8 hasInstanceMaterialBuffer, in b8 hasMaterialTypedBuffer, in b8 hasInstanceBuffer, in b8 hasMaterialContextSlotsBuffer
    )const{
        return hardwareSupported && traceResourcesPreflighted && rayQuerySupported && heapInitialized && heapHasAccelStructLayout
            && hasTlas && tlasHeapHandleValid && hasInstanceMaterialBuffer && hasMaterialTypedBuffer && hasInstanceBuffer && hasMaterialContextSlotsBuffer;
    }

    public b8 canPublishHardwareSceneGraphResources(in b8 hardwareSupported, in b8 traceResourcesPreflighted, in b8 materialContextSlotsValid)const{
        return hardwareSupported && traceResourcesPreflighted && materialContextSlotsValid;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


RayTraceMaterialContextSlots PackRayTraceMaterialContextSlots(in u32 sceneBvhNodes, in u32 sceneInstances, in u32 instanceMaterial, in u32 materialTyped, in u32 meshInstances, in b8 opticalValid, in u32 opticalSlot, in u32 opticalInstanceCount, in b8 hasCsgContext, in u32 csgContextSlot){
    RayTraceMaterialContextSlots slots;
    slots.sceneBvhNodes = sceneBvhNodes;
    slots.sceneInstances = sceneInstances;
    slots.instanceMaterial = instanceMaterial;
    slots.materialTyped = materialTyped;
    slots.meshInstances = meshInstances;
    if(opticalValid){
        slots.opticalScene = opticalSlot;
        slots.opticalInstanceCount = opticalInstanceCount;
    }
    if(hasCsgContext)
        slots.csgContext = csgContextSlot;
    return slots;
}


