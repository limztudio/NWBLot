    public Expected<ShapeId> createChainShape(in BodyId bodyId, in ChainDef def){
        if(!this.isValidBody(bodyId) || !this.validateShapeDef(def.shapeDef))
            return MakeUnexpected(Failure());
        for(usize i = 0u; i < def.points.size(); ++i){
            if(!IsValidPositionVec3(VectorSingle(def.points[i])))
                return MakeUnexpected(Failure());
        }
        const Expected<ChainShape> chainRes = MakeChainShape(
            Span<f32x4>(def.points),
            def.radius,
            def.isLoop,
            def.shapeDef.material,
            Span<SurfaceMaterial>(),
            Span<u16>(),
            VectorSingle(0.0f),
            VectorSingle(0.0f)
        );
        if(!chainRes.has_value())
            return MakeUnexpected(Failure());
        return this.createChainShape(bodyId, def.shapeDef, chainRes.value());
    }

