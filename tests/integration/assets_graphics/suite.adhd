b8 CookSingleGraphicsMeta(in StringView metaText, in StringView assetDirectory, in StringView assetFilename, in CookCase cookCase, mut TestArena testArena){
    b8 ok = false;
    native(in metaText, in assetDirectory, in assetFilename, in cookCase, mut testArena, mut ok){
        const Path assetRoot = cookCase.root / s_AssetsDirectory;
        const Path metaPath = assetRoot / assetDirectory / assetFilename;
        if(WriteTextFile(metaPath, metaText))
            ok = CookPreparedGraphicsAssetRoots(testArena, cookCase.root, cookCase.outputDirectory, { assetRoot });
    }
    return ok;
}

b8 CookSingleMeshMeta(in StringView metaText, in CookCase cookCase, mut TestArena testArena){
    return CookSingleGraphicsMeta(metaText, "meshes", "minimal_mesh.nwb", cookCase, testArena);
}

b8 CookSmokeAssetMeta(in StringView assetDirectory, in StringView assetFilename, in CookCase cookCase, mut TestArena testArena){
    b8 ok = false;
    native(in assetDirectory, in assetFilename, in cookCase, mut testArena, mut ok){
        const auto metaText = ReadSmokeAssetMeta(testArena, assetDirectory, assetFilename);
        if(metaText)
            ok = CookSingleGraphicsMeta(AStringView(metaText->data(), metaText->size()), assetDirectory, assetFilename, cookCase, testArena);
    }
    return ok;
}


