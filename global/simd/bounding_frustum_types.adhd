[cpp_name("::BoundingDoubleFrustum::CreateFromMatrix")]
extern void BoundingDoubleFrustumCreateFromMatrix(mut auto a0, in MatrixDouble a1, in auto a2 = {});

[cpp_name("::BoundingFrustum::CreateFromMatrix")]
extern void BoundingFrustumCreateFromMatrix(mut auto a0, in MatrixSingle a1, in auto a2 = {});


