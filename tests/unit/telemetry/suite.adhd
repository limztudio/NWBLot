[[nodiscard]] inline Expected<Name> DeriveSequenceName(const Name& prefix, const u64 seq){
    Array<char, 32u> sequenceText = {};
    return DeriveName(prefix, FormatDecimal(seq, sequenceText));
}

[[nodiscard]] inline ArenaMemoryStats SampleTemporaryScratchStats(const Name& scratchName, b8& outAllocated){
    ScratchArena temporary(scratchName);
    outAllocated = temporary.allocate(1u, 97u) != nullptr;
    return temporary.memoryStats();
}

[[nodiscard]] inline b8 HasOwnerMemoryEvent(const EventView& events, const Name& owner, const MemorySourceEnum source)noexcept{
    return FindOwnerEvent(events, owner, source) != nullptr;
}

[[nodiscard]] inline u64 OwnerMemoryEventFrameIndex(const EventView& events, const Name& owner, const MemorySourceEnum source)noexcept{
    return FindOwnerEvent(events, owner, source)->header.frameIndex;
}

[[nodiscard]] inline Expected<Core::Telemetry::PerfMemoryPayload> ParseOwnerMemoryEvent(const EventView& events, const Name& owner, const MemorySourceEnum source){
    const EventRecord* const ev = FindOwnerEvent(events, owner, source);
    return Core::Telemetry::ParsePerfMemoryPayload(ev->payload.data(), ev->payload.size());
}

[[nodiscard]] inline AStringView ReportJsonView(const TelemetryReport& report)noexcept{
    return AStringView(report.json.data(), report.json.size());
}

[[nodiscard]] inline AStringView ReportGraphView(const TelemetryReport& report)noexcept{
    return AStringView(report.graph.data(), report.graph.size());
}

[[nodiscard]] inline AStringView ReportPerfCsvView(const TelemetryReport& report)noexcept{
    return AStringView(report.perfCsv.data(), report.perfCsv.size());
}

template<typename Number>
inline void ExpectJsonNumberField(ScratchArena& scratchArena, const AStringView record, const AStringView field, const Number value){
    AString<ScratchArena> expected(scratchArena);
    expected.reserve(field.size() + 32u);
    StringAppendFormat(expected, "\"{}\": {}", field, value);
    const usize position = record.find(AStringView(expected.data(), expected.size()));
    ASSERT_NE(position, AStringView::npos);
    const usize end = position + expected.size();
    EXPECT_TRUE(end == record.size() || record[end] == ',' || record[end] == '}' || record[end] == ' ');
}


