////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_REFLECTION_SAMPLING_SLANGI
#define NWB_GRAPHICS_REFLECTION_SAMPLING_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../common/math.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// A fixed pixel/dimension digital scramble preserves the progressive Sobol elementary intervals. The accepted
// sample index remains separate from this seed and the bounded history length. No texture or subgroup is needed.
// Reference: https://pbr-book.org/4ed/Sampling_and_Reconstruction/Sobol_Samplers
uint nwbReflectionSamplingHash(uint value){
    value = (value ^ (value >> 16u)) * 0x7feb352du;
    value = (value ^ (value >> 15u)) * 0x846ca68bu;
    return value ^ (value >> 16u);
}

float2 nwbReflectionSample2D(const uint2 pixel, const uint2 sampleBase, const uint seed){
    const uint pixelSeed = nwbReflectionSamplingHash(pixel.x ^ nwbReflectionSamplingHash(pixel.y ^ seed));
    // Reflection preparation computes this sample-index-only Sobol pair once on the CPU. Classify and hardware
    // consume the same immutable pair; no queue-order dependence or per-invocation generator loop remains.
    const uint first = sampleBase.x ^ nwbReflectionSamplingHash(pixelSeed);
    const uint second = sampleBase.y ^ nwbReflectionSamplingHash(pixelSeed ^ 0x9e3779b9u);
    // A 23-bit midpoint is exactly representable in float and strictly inside (0, 1), including the final bin.
    return (float2(first >> 9u, second >> 9u) + 0.5) * 0.00000011920928955078125;
}

float3 nwbReflectionSchlick(const float3 f0, const float viewHalfCosine){
    // The Schlick factor is a (0, 1) bounded color multiplier, so half arithmetic is sufficient here.
    const half complement = half(1.0 - saturate(viewHalfCosine));
    const half square = complement * complement;
    const half3 fresnel = (half3(1.0h) - half3(f0)) * square * square * complement;
    return f0 + float3(fresnel);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Isotropic visible-GGX sampling and the correlated Smith single-scattering estimator. Sampling H from the VNDF
// cancels D and the reflection Jacobian: throughput = F(V,H) * G2(V,L) / G1(V). This factor is bounded by one;
// bright incident radiance can still have variance, so no arbitrary radiance clamp is applied.
// Reference: https://jcgt.org/published/0007/04/01/paper.pdf (Appendices A and B).
void nwbReflectionSampleGgx(
    const float3 normal,
    const float3 viewDirection,
    const float3 f0,
    const float roughness,
    const float2 random,
    out float3 direction,
    out float3 throughput){
    direction = reflect(-viewDirection, normal);
    const float viewCosine = saturate(dot(normal, viewDirection));
    throughput = nwbReflectionSchlick(f0, viewCosine);
    const float alpha = roughness * roughness;
    // Preserve the delta interface at zero roughness. The additional limit only prevents FP32 alpha^2 underflow.
    if(alpha < 1e-18)
        return;

    const float3 tangent = nwbFrameFallbackTangent(normal);
    const float3 bitangent = cross(normal, tangent);
    const float3 localView = float3(dot(viewDirection, tangent), dot(viewDirection, bitangent), viewCosine);
    float3 stretchedView = float3(alpha * localView.xy, localView.z);
    stretchedView /= max(max(abs(stretchedView.x), abs(stretchedView.y)), stretchedView.z);
    stretchedView = normalize(stretchedView);
    const float tangentLength = dot(stretchedView.xy, stretchedView.xy);
    const float3 diskTangent = tangentLength > 0.0
        ? float3(-stretchedView.y, stretchedView.x, 0.0) * rsqrt(tangentLength)
        : float3(1.0, 0.0, 0.0);
    const float3 diskBitangent = cross(stretchedView, diskTangent);
    const float radius = sqrt(random.x);
    const float azimuth = 6.283185307179586 * random.y;
    const float diskX = radius * cos(azimuth);
    float diskY = radius * sin(azimuth);
    const float visibleFraction = 0.5 * (1.0 + stretchedView.z);
    diskY = (1.0 - visibleFraction) * sqrt(max(0.0, 1.0 - diskX * diskX)) + visibleFraction * diskY;
    const float diskZ = sqrt(max(0.0, 1.0 - diskX * diskX - diskY * diskY));
    const float3 stretchedHalf = diskX * diskTangent + diskY * diskBitangent + diskZ * stretchedView;
    float3 localHalf = float3(alpha * stretchedHalf.xy, max(stretchedHalf.z, 0.0));
    localHalf /= max(max(abs(localHalf.x), abs(localHalf.y)), localHalf.z);
    localHalf = normalize(localHalf);
    const float3 halfVector = tangent * localHalf.x + bitangent * localHalf.y + normal * localHalf.z;
    const float viewHalfCosine = saturate(dot(viewDirection, halfVector));
    direction = reflect(-viewDirection, halfVector);
    const float lightCosine = dot(normal, direction);
    if(lightCosine <= 0.0){
        // This is a valid zero Monte Carlo sample, not a missing sample. Resampling until above the horizon biases
        // the BRDF integral, and tracing this direction would intersect the receiver's interior.
        throughput = float3(0.0);
        return;
    }

    const float alphaSquared = alpha * alpha;
    const float viewRoot = sqrt(alphaSquared + (1.0 - alphaSquared) * viewCosine * viewCosine);
    const float lightRoot = sqrt(alphaSquared + (1.0 - alphaSquared) * lightCosine * lightCosine);
    const float smithRatio = saturate(
        lightCosine * (viewCosine + viewRoot) / (lightCosine * viewRoot + viewCosine * lightRoot)
    );
    throughput = nwbReflectionSchlick(f0, viewHalfCosine) * smithRatio;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

