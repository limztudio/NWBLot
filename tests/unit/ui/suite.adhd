b8 TextAreaLoanFixture::acceptBaseline(){
    useHost();
    if(!m_model.setText("alpha\nbeta") || !frameArea(1u, AreaOptions()))
        return false;
    m_host.publications.clear();
    m_host.publishes = 0u;
    m_host.loans = 0u;
    return true;
}

