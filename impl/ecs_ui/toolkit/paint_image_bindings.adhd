////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{
#include <impl/ecs_ui/toolkit/global.adhd.h>
#include <impl/ecs_ui/toolkit/images/image_source.adhd.h>
#include <impl/ecs_ui/toolkit/text/glyph_page.adhd.h>
#include <impl/ecs_ui/toolkit/text/sdf_page.adhd.h>
#include <impl/ecs_ui/toolkit/paint_types.adhd.h>

#include <global/assert.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class PaintImageBindings final{
public:
    explicit PaintImageBindings(Core::Alloc::GlobalArena& arena)noexcept
        : m_glyphPages(arena)
        , m_sdfPages(arena)
        , m_textureImages(arena)
    {}
    PaintImageBindings(PaintImageBindings&&)noexcept = default;
    PaintImageBindings(const PaintImageBindings&) = delete;
    PaintImageBindings& operator=(PaintImageBindings&&)noexcept = default;
    PaintImageBindings& operator=(const PaintImageBindings&) = delete;


public:
    [[nodiscard]] b8 prepare(const Span<const SharedGlyphPage> glyphPages, const Span<const SharedSdfAtlasPage> sdfPages, const Span<const SharedImageSource> textureImages){
        const usize glyphCount = glyphPages.size();
        const usize sdfCount = sdfPages.size();
        const usize textureCount = textureImages.size();
        if(glyphCount > s_PaintMaxImages || sdfCount > s_PaintMaxImages || textureCount > s_PaintMaxImages)
            return false;
        usize addedGlyphs = 0u;
        for(usize candidate = 0u; candidate < glyphCount; ++candidate){
            if(!glyphPages[candidate])
                return false;
            const GlyphPageBinding& binding = glyphPages[candidate]->binding();
            b8 found = false;
            for(const SharedGlyphPage& existing : m_glyphPages){
                if(SameGlyphPageKey(binding, existing->binding())){
                    if(binding.width != existing->binding().width || binding.height != existing->binding().height)
                        return false;
                    found = true;
                    break;
                }
            }
            for(usize previous = 0u; previous < candidate; ++previous){
                if(SameGlyphPageKey(binding, glyphPages[previous]->binding())){
                    const GlyphPageBinding& previousBinding = glyphPages[previous]->binding();
                    if(binding.width != previousBinding.width || binding.height != previousBinding.height)
                        return false;
                    found = true;
                    break;
                }
            }
            if(!found)
                ++addedGlyphs;
        }
        usize addedSdf = 0u;
        for(usize candidate = 0u; candidate < sdfCount; ++candidate){
            if(!sdfPages[candidate])
                return false;
            const SdfAtlasPageBinding& binding = sdfPages[candidate]->binding();
            b8 found = false;
            for(const SharedSdfAtlasPage& existing : m_sdfPages){
                if(SameSdfAtlasPageKey(binding, existing->binding())){
                    if(!(binding == existing->binding()))
                        return false;
                    found = true;
                    break;
                }
            }
            for(usize previous = 0u; previous < candidate; ++previous){
                if(SameSdfAtlasPageKey(binding, sdfPages[previous]->binding())){
                    if(!(binding == sdfPages[previous]->binding()))
                        return false;
                    found = true;
                    break;
                }
            }
            if(!found)
                ++addedSdf;
        }
        usize addedTextures = 0u;
        for(usize candidate = 0u; candidate < textureCount; ++candidate){
            if(!textureImages[candidate])
                return false;
            b8 found = false;
            for(const SharedImageSource& existing : m_textureImages){
                if(SameTextureImageKey(*textureImages[candidate], *existing)){
                    found = true;
                    break;
                }
            }
            for(usize previous = 0u; previous < candidate; ++previous){
                if(SameTextureImageKey(*textureImages[candidate], *textureImages[previous])){
                    found = true;
                    break;
                }
            }
            if(!found)
                ++addedTextures;
        }
        if(!CanAdmitPaintImageBindingCounts(m_glyphPages.size(), m_sdfPages.size(), m_textureImages.size(), addedGlyphs, addedSdf, addedTextures))
            return false;
        // All image kinds are admitted before any binding is published, including append-only coverage upgrades.
        m_glyphPages.reserve(m_glyphPages.size() + addedGlyphs);
        m_sdfPages.reserve(m_sdfPages.size() + addedSdf);
        m_textureImages.reserve(m_textureImages.size() + addedTextures);
        for(usize candidate = 0u; candidate < glyphCount; ++candidate){
            SharedGlyphPage* existing = nullptr;
            for(SharedGlyphPage& bound : m_glyphPages){
                if(SameGlyphPageKey(bound->binding(), glyphPages[candidate]->binding())){
                    existing = &bound;
                    break;
                }
            }
            if(!existing)
                m_glyphPages.push_back(glyphPages[candidate]);
            else if((*existing)->binding().generation < glyphPages[candidate]->binding().generation)
                *existing = glyphPages[candidate];
        }
        for(usize candidate = 0u; candidate < sdfCount; ++candidate){
            b8 found = false;
            for(const SharedSdfAtlasPage& bound : m_sdfPages){
                if(SameSdfAtlasPageKey(bound->binding(), sdfPages[candidate]->binding())){
                    found = true;
                    break;
                }
            }
            if(!found)
                m_sdfPages.push_back(sdfPages[candidate]);
        }
        for(usize candidate = 0u; candidate < textureCount; ++candidate){
            b8 found = false;
            for(const SharedImageSource& bound : m_textureImages){
                if(SameTextureImageKey(*bound, *textureImages[candidate])){
                    found = true;
                    break;
                }
            }
            if(!found)
                m_textureImages.push_back(textureImages[candidate]);
        }
        return true;
    }

    void clear()noexcept{ m_glyphPages.clear(); m_sdfPages.clear(); m_textureImages.clear(); }
    [[nodiscard]] const Vector<SharedGlyphPage, Core::Alloc::GlobalArena>& glyphPages()const noexcept{ return m_glyphPages; }
    [[nodiscard]] const Vector<SharedSdfAtlasPage, Core::Alloc::GlobalArena>& sdfPages()const noexcept{ return m_sdfPages; }
    [[nodiscard]] const Vector<SharedImageSource, Core::Alloc::GlobalArena>& textureImages()const noexcept{ return m_textureImages; }

    template<typename TResource, typename TPrepare, typename TSameKey>
    [[nodiscard]] static b8 Resolve(
        const Vector<TResource, Core::Alloc::GlobalArena>& resources,
        const TResource& candidate,
        TPrepare&& prepare,
        TSameKey&& sameKey,
        u32& outIndex
    ){
        for(u32 index = 0u; index < resources.size(); ++index){
            if(resources[index].get() == candidate.get()){
                outIndex = index;
                return true;
            }
        }
        if(!prepare(Span<const TResource>(&candidate, 1u)))
            return false;
        for(u32 index = 0u; index < resources.size(); ++index){
            if(sameKey(*resources[index], *candidate)){
                outIndex = index;
                return true;
            }
        }
        FOUNDATION_ASSERT(false);
        return false;
    }


private:
    Vector<SharedGlyphPage, Core::Alloc::GlobalArena> m_glyphPages;
    Vector<SharedSdfAtlasPage, Core::Alloc::GlobalArena> m_sdfPages;
    Vector<SharedImageSource, Core::Alloc::GlobalArena> m_textureImages;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ImplEcsUiToolkitPaintImageBindingsAdhdModule(in u64 value){
    return value != 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
