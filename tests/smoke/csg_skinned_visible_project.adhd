////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <loader/project_entry.adhd>
#include <loader/runtime_constants.adhd>
#include <impl/ecs_scene/module.adhd>
#include "csg_smoke_helpers.adhd"
#include "presentation_types.adhd"
#include "smoke_scene_helpers.adhd"
#include "smoke_project_helpers.adhd"
#include "smoke_skinned_scene_helpers.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_CsgSkinnedProjectName = "CsgSkinnedVisibleSmokeProject";
#if defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER)
const SmokeMaterialRef s_CsgSkinnedReceiverMaterial = "project/smoke/transparent_multi/materials/shared";
#else
const SmokeMaterialRef s_CsgSkinnedReceiverMaterial = "project/smoke/csg_visible/materials/solid";
#endif
const f32 s_CsgSkinnedCameraDistance = 1.75f;
const f32 s_CsgSkinnedCameraHeight = 0.92f;
const f32 s_CsgSkinnedDefaultDirectionalLightPitch = -0.62f;
const f32 s_CsgSkinnedDefaultDirectionalLightYaw = 0.54f;
const f32 s_CsgSkinnedDefaultDirectionalLightIntensity = 3.0f;
const f32 s_CsgSkinnedCutterAnimationSpeed = 0.18f;
const f32 s_CsgSkinnedReceiverYawSpeed = 0.92f;
const f32 s_CsgSkinnedMaxAnimationDelta = s_SmokeSpinMaxDelta;
const f32 s_CsgSkinnedInitialAnimationTime = s_HalfPi / s_CsgSkinnedReceiverYawSpeed;
#if defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER)
const f32 s_CsgSkinnedTransparentReceiverAlpha = 0.44f;
#endif
const f32 s_CsgSkinnedReceiverOffsetX = 0.48f;
const f32 s_CsgSkinnedCutterGentleRollSpeed = 0.18f;
const f32 s_CsgSkinnedCutterAnchorFallbackY = 0.90f;
#if defined(NWB_CSG_SKINNED_VISIBLE_SPHERE_CUTTER)
const b8 s_CsgSkinnedSphereCutter = true;
const f32 s_CsgSkinnedSphereCutterRadius = 0.18f;
const f32 s_CsgSkinnedCapsuleCutterRadius = 0.0f;
const f32 s_CsgSkinnedCapsuleCutterHalfHeight = 0.0f;
#else
const b8 s_CsgSkinnedSphereCutter = false;
const f32 s_CsgSkinnedSphereCutterRadius = 0.0f;
const f32 s_CsgSkinnedCapsuleCutterRadius = 0.105f;
const f32 s_CsgSkinnedCapsuleCutterHalfHeight = 0.27f;
#endif
#if defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER)
const b8 s_CsgSkinnedTransparentReceiver = true;
#else
const b8 s_CsgSkinnedTransparentReceiver = false;
#endif
const SmokeModelRef s_CsgSkinnedModel = "project/characters/body/model";
const Name s_CsgSkinnedReceiverGroup = s_SmokeNameProjectSmokeCsgSkinnedVisibleFemaleReceiver;
const Name s_CsgSkinnedCutterAnchorBoneName = s_SmokeNameHip;
const u16 s_CsgSkinnedFrameClientWidth = 1280u;
const u16 s_CsgSkinnedFrameClientHeight = 900u;
const f32x4 s_CsgSkinnedPlainReceiverTint(0.86f, 0.88f, 0.90f, 1.0f);
const f32x4 s_CsgSkinnedCsgReceiverTint(0.85f, 0.72f, 1.0f, 1.0f);
const f32x4 s_CsgSkinnedWarmDirectionalLightColor(1.0f, 0.96f, 0.88f, 0.0f);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena]
class CsgSkinnedVisibleSmokeProject : IProjectEntryCallbacks{
    public CsgSkinnedVisibleSmokeProject(mut NotNullUniquePtr<World> world, mut ProjectRuntimeContext context){
        this.m_context = context;
        this.m_world = TakeSmokeWorld(world);
        this.m_fpsProbe = FpsProbe(CsgSkinnedVisibleFpsLabel());
    }

    public ~CsgSkinnedVisibleSmokeProject(){
        this.destroyWorld();
    }

    public b8 onStartup()override{
        mut World world = SmokeWorldRef(this.m_world);
        const EntityID activeCamera = CreateSmokeCameraAt(VectorSingle(0.0f, s_CsgSkinnedCameraHeight, -s_CsgSkinnedCameraDistance, 0.0f), world);
        const EntityID directionalLight = CreateDirectionalLightEntity(
            world,
            s_CsgSkinnedDefaultDirectionalLightPitch,
            s_CsgSkinnedDefaultDirectionalLightYaw,
            0.0f,
            VectorSingle(s_CsgSkinnedWarmDirectionalLightColor),
            s_CsgSkinnedDefaultDirectionalLightIntensity
        );
        if(s_CsgSkinnedTransparentReceiver && world.hasComponent<LightComponent>(directionalLight)){
            mut LightComponent light = world.entity(directionalLight).getComponent<LightComponent>();
            light.enableCaustics = false;
        }

        this.createReceiver();
        SyncSmokeModelRuntimes(world);
        const b8 receiverReady = this.installCsgReceiverOnSpawnedModelObject();
        const VectorSingle cutterLocalCenter = this.loadCutterAnchorLocalCenter();
        this.m_cutterLocalCenter = f32x4(cutterLocalCenter);
        this.createCutter(cutterLocalCenter);
        [essential] assert(
            activeCamera.valid() && directionalLight.valid()
                && this.m_plainReceiver.valid()
                && this.m_receiver.valid()
                && this.m_receiverObject.valid()
                && this.m_cutter.valid(),
            "CsgSkinnedVisibleSmokeProject failed to create all scene entities"
        );
        [essential] assert(receiverReady, "CsgSkinnedVisibleSmokeProject failed to bind CSG receiver to spawned model object");
        [essential] info("{}", CsgSkinnedStartupSummary());
        return true;
    }

    public void onShutdown()override{
        this.m_context.graphics.setFrameSubmissionSuspended(false);
        this.destroyWorld();
        [essential] info("CsgSkinnedVisibleSmokeProject: shutdown");
    }

    public b8 onUpdate(in f32 delta)override{
        const u32 captureFreezeFrame = RendererBaselineCaptureFreezeFrame();
        if(captureFreezeFrame != 0u && this.m_rendererBaselineRenderedFrameCount >= captureFreezeFrame){
            SuspendSmokeCapture(this.m_context.graphics, this.m_rendererBaselineCapturePaused, "CsgSkinnedVisibleSmokeProject", this.m_rendererBaselineRenderedFrameCount, "rendered frames");
            return true;
        }

        const f32 safeDelta = SafeRendererBaselineDelta(delta);
        this.m_fpsProbe.recordFrame(safeDelta);
        const VectorSingle safeVec(safeDelta);
        const VectorSingle maxVec(s_CsgSkinnedMaxAnimationDelta);
        this.m_animationTime = VectorSelect(maxVec, safeVec, VectorLess(safeVec, maxVec)).x * s_CsgSkinnedCutterAnimationSpeed + this.m_animationTime;

        const VectorSingle receiverRotation = BuildCsgSkinnedReceiverRotation(this.m_animationTime);
        this.updateSceneTransforms(receiverRotation, LoadFloat(this.m_cutterLocalCenter));
        if(!TickSmokeWorld(safeDelta, SmokeWorldRef(this.m_world)))
            return false;
        ++this.m_rendererBaselineRenderedFrameCount;
        return true;
    }

    private void destroyWorld(){
        DestroySmokeSkinnedRenderWorld(this.m_context, this.m_world);
    }

    private EntityID createSkinnedReceiverInstance(in VectorSingle position, in VectorSingle colorTint){
        const SmokeTintedModelEntityResult modelResult = CreateTintedModelEntity(
            s_CsgSkinnedModel,
            s_CsgSkinnedReceiverMaterial,
            NameTextAscii(s_SmokeSurfaceMaterialInterface),
            colorTint,
            position,
            VectorSingle(1.0f, 1.0f, 1.0f, 0.0f),
            SmokeWorldRef(this.m_world)
        );
        if(!modelResult.tintApplied)
            error("CsgSkinnedVisibleSmokeProject: failed to set receiver material tint");
        return modelResult.entity;
    }

    private b8 installCsgReceiverOnSpawnedModelObject(){
        this.m_receiverObject = FindSpawnedModelObject(this.m_receiver, s_SmokeNameMesh, ModelObjectKind::SkinnedMesh, SmokeWorldRef(this.m_world));
        if(!this.m_receiverObject.valid()){
            error("CsgSkinnedVisibleSmokeProject: failed to find spawned receiver model object");
            return false;
        }
        AddSkinnedCsgMeshReceiver(
            this.m_receiverObject,
            s_CsgSkinnedReceiverGroup,
            !s_CsgSkinnedTransparentReceiver,
            s_CsgSkinnedTransparentReceiver,
            SmokeWorldRef(this.m_world)
        );
        return true;
    }

    private void createReceiver(){
        const f32 alpha = CsgSkinnedReceiverAlpha();
        this.m_plainReceiver = this.createSkinnedReceiverInstance(VectorSingle(-s_CsgSkinnedReceiverOffsetX, 0.0f, 0.0f, 0.0f), VectorSingle(s_CsgSkinnedPlainReceiverTint.x, s_CsgSkinnedPlainReceiverTint.y, s_CsgSkinnedPlainReceiverTint.z, alpha));
        this.m_receiver = this.createSkinnedReceiverInstance(VectorSingle(s_CsgSkinnedReceiverOffsetX, 0.0f, 0.0f, 0.0f), VectorSingle(s_CsgSkinnedCsgReceiverTint.x, s_CsgSkinnedCsgReceiverTint.y, s_CsgSkinnedCsgReceiverTint.z, alpha));
    }

    private VectorSingle loadCutterAnchorLocalCenter()const{
        const VectorSingle fallback = VectorSingle(0.0f, s_CsgSkinnedCutterAnchorFallbackY, 0.0f, 0.0f);
        mut AssetManager assets = this.m_context.assetManager;
        const auto loadedModel = assets.loadSync(Model::AssetTypeName(), s_CsgSkinnedModel.name());
        if(!loadedModel.has_value()){
            error("CsgSkinnedVisibleSmokeProject: failed to load model for cutter anchor");
            return fallback;
        }
        assert(loadedModel.value().valid());
        const Optional<in Model> model = BorrowTypedAsset<Model>(loadedModel.value().deref());
        if(!model.has_value() || model.value().skeletonObjects().empty())
            return fallback;
        const auto loadedSkeleton = assets.loadSync(Skeleton::AssetTypeName(), model.value().skeletonObjects().front().skeleton.name());
        if(!loadedSkeleton.has_value()){
            error("CsgSkinnedVisibleSmokeProject: failed to load skeleton for cutter anchor");
            return fallback;
        }
        assert(loadedSkeleton.value().valid());
        const Optional<in Skeleton> skeleton = BorrowTypedAsset<Skeleton>(loadedSkeleton.value().deref());
        if(!skeleton.has_value())
            return fallback;
        const u32 count = skeleton.value().jointCount();
        const u32 anchor = skeleton.value().findJointIndex(s_CsgSkinnedCutterAnchorBoneName);
        if(anchor == s_SkeletonInvalidJointIndex || anchor >= count){
            error("CsgSkinnedVisibleSmokeProject: skeleton has no '{}' bone for cutter anchor", s_CsgSkinnedCutterAnchorBoneName.resolvedText());
            return fallback;
        }
        in JointVector joints = skeleton.value().joints();
        MatrixSingle boneToModel = MatrixSingle(joints[anchor].localBindPose);
        for(u32 parent = joints[anchor].parentIndex; parent != s_SkeletonInvalidJointIndex && parent < count; parent = joints[parent].parentIndex)
            boneToModel = MatrixSingle(joints[parent].localBindPose) * boneToModel;
        return VectorSingle(boneToModel[0u].w, boneToModel[1u].w, boneToModel[2u].w, 0.0f);
    }

    private void createCutter(in VectorSingle cutterLocalCenter){
        mut World world = SmokeWorldRef(this.m_world);
        const VectorSingle receiverRotation = BuildCsgSkinnedReceiverRotation(0.0f);
        const VectorSingle worldCenter = BuildCsgSkinnedCutterWorldCenter(cutterLocalCenter, receiverRotation);
        const VectorSingle worldRotation = BuildCsgSkinnedCutterWorldRotation(0.0f, receiverRotation);
        if(s_CsgSkinnedSphereCutter){
            this.m_cutter = CreateSmokeCsgSphereCutter(
                s_CsgSkinnedReceiverGroup,
                s_CsgSphereShapeName,
                true,
                VectorSingle(s_CsgSkinnedSphereCutterRadius, 0.0f, 0.0f, 0.0f),
                worldCenter,
                worldRotation,
                world
            );
            return;
        }
        this.m_cutter = CreateSmokeCsgCapsuleCutter(
            s_CsgSkinnedReceiverGroup,
            s_CsgCapsuleShapeName,
            true,
            VectorSingle(s_CsgSkinnedCapsuleCutterRadius, s_CsgSkinnedCapsuleCutterHalfHeight, 0.0f, 0.0f),
            worldCenter,
            worldRotation,
            world
        );
    }

    private void updateSceneTransforms(in VectorSingle receiverRotation, in VectorSingle cutterLocalCenter){
        const f32x4 storedReceiverRotation = f32x4(receiverRotation);
        const VectorSingle cutterCenter = BuildCsgSkinnedCutterWorldCenter(cutterLocalCenter, receiverRotation);
        const VectorSingle cutterRotation = BuildCsgSkinnedCutterWorldRotation(this.m_animationTime, receiverRotation);
        SetSmokeEntityRotationIfPresent(this.m_plainReceiver, VectorSingle(storedReceiverRotation), SmokeWorldRef(this.m_world));
        SetSmokeEntityRotationIfPresent(this.m_receiver, VectorSingle(storedReceiverRotation), SmokeWorldRef(this.m_world));
        SetSmokeCsgCutterTransform(this.m_cutter, cutterCenter, cutterRotation, SmokeWorldRef(this.m_world));
    }

    private Float4 m_cutterLocalCenter = Float4(0.0f, s_CsgSkinnedCutterAnchorFallbackY, 0.0f, 0.0f);
    private mut ProjectRuntimeContext m_context;
    private NotNullUniquePtr<World> m_world;
    private FpsProbe m_fpsProbe;
    private EntityID m_plainReceiver = s_InvalidEntityId;
    private EntityID m_receiver = s_InvalidEntityId;
    private EntityID m_receiverObject = s_InvalidEntityId;
    private EntityID m_cutter = s_InvalidEntityId;
    private f32 m_animationTime = s_CsgSkinnedInitialAnimationTime;
    private u32 m_rendererBaselineRenderedFrameCount = 0u;
    private b8 m_rendererBaselineCapturePaused = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StringView CsgSkinnedVisibleFpsLabel(){
#if defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER) && defined(NWB_CSG_SKINNED_VISIBLE_SPHERE_CUTTER)
    return "CsgSkinnedTransparentSphereVisibleSmokeProject";
#elif defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER)
    return "CsgSkinnedTransparentVisibleSmokeProject";
#elif defined(NWB_CSG_SKINNED_VISIBLE_SPHERE_CUTTER)
    return "CsgSkinnedSphereVisibleSmokeProject";
#else
    return s_CsgSkinnedProjectName;
#endif
}

f32 CsgSkinnedReceiverAlpha(){
#if defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER)
    return s_CsgSkinnedTransparentReceiverAlpha;
#else
    return 1.0f;
#endif
}

PlatformStringView CsgSkinnedStartupSummary(){
#if defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER) && defined(NWB_CSG_SKINNED_VISIBLE_SPHERE_CUTTER)
    return PlatformTextLiteral("CsgSkinnedVisibleSmokeProject: transparent skinned CSG receiver scene with sphere cutter and non-CSG control created");
#elif defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER)
    return PlatformTextLiteral("CsgSkinnedVisibleSmokeProject: transparent skinned CSG receiver scene with non-CSG control created");
#elif defined(NWB_CSG_SKINNED_VISIBLE_SPHERE_CUTTER)
    return PlatformTextLiteral("CsgSkinnedVisibleSmokeProject: skinned CSG receiver scene with sphere cutter and non-CSG control created");
#else
    return PlatformTextLiteral("CsgSkinnedVisibleSmokeProject: skinned CSG receiver scene with non-CSG control created");
#endif
}

VectorSingle BuildCsgSkinnedReceiverRotation(in f32 animationTime){
    return QuaternionRotationRollPitchYawFromVector(VectorSingle(0.0f, animationTime, 0.0f, 0.0f) * s_CsgSkinnedReceiverYawSpeed);
}

VectorSingle BuildCsgSkinnedReceiverPosition(){
    return VectorSingle(s_CsgSkinnedReceiverOffsetX, 0.0f, 0.0f, 0.0f);
}

VectorSingle BuildCsgSkinnedCutterLocalRotation(in f32 animationTime){
    const VectorSingle horizontalCapsule = QuaternionRotationRollPitchYawFromVector(VectorSingle(s_HalfPi, s_HalfPi, 0.0f, 0.0f));
    const VectorSingle gentleRoll = QuaternionRotationRollPitchYawFromVector(VectorSingle(0.0f, animationTime, 0.0f, 0.0f) * s_CsgSkinnedCutterGentleRollSpeed);
    return QuaternionNormalize(QuaternionMultiply(horizontalCapsule, gentleRoll));
}

VectorSingle BuildCsgSkinnedCutterWorldCenter(in VectorSingle cutterLocalCenter, in VectorSingle receiverRotation){
    return BuildCsgSkinnedReceiverPosition() + Vector3Rotate(cutterLocalCenter, receiverRotation);
}

VectorSingle BuildCsgSkinnedCutterWorldRotation(in f32 animationTime, in VectorSingle receiverRotation){
    return QuaternionNormalize(QuaternionMultiply(receiverRotation, BuildCsgSkinnedCutterLocalRotation(animationTime)));
}

ProjectFrameClientSize GetProjectFrameClientSize(){
    return ProjectFrameClientSize(s_CsgSkinnedFrameClientWidth, s_CsgSkinnedFrameClientHeight);
}

PlatformStringView GetProjectWindowTitle(){
#if defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER) && defined(NWB_CSG_SKINNED_VISIBLE_SPHERE_CUTTER)
    return PlatformTextLiteral("NWB Transparent Skinned Sphere CSG Smoke");
#elif defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER)
    return PlatformTextLiteral("NWB Transparent Skinned CSG Smoke");
#elif defined(NWB_CSG_SKINNED_VISIBLE_SPHERE_CUTTER)
    return PlatformTextLiteral("NWB Skinned Sphere CSG Smoke");
#else
    return PlatformTextLiteral("NWB Skinned CSG Smoke");
#endif
}

[cpp_unwind]
UniquePtr<IProjectEntryCallbacks> CreateProjectCallbacks(mut ProjectRuntimeContext context){
    auto world = CreateSmokeSkinnedRenderWorld(s_CsgSkinnedProjectName, SmokeRenderQualitySettings(), context);
    if(!world.has_value())
        return UniquePtr<IProjectEntryCallbacks>();
    mut NotNullUniquePtr<World> owner = world.value();
    return MakeUnique<CsgSkinnedVisibleSmokeProject>(owner, context);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

