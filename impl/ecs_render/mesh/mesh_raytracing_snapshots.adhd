#include <impl/ecs_render/mesh/mesh_system.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_MeshShadowTraceSwParentSuffix = ":shadow_trace_sw_parent";

enum<u8> MeshSwBvhBufferPairState{
    Unused = 0,
    Complete = 1,
    Incomplete = 2,
    kCount
}

MeshSwBvhBufferPairState ClassifyMeshSwBvhBufferPair(in b8 hasNodeBuffer, in b8 hasParentBuffer){
    if(!hasNodeBuffer && !hasParentBuffer)
        return MeshSwBvhBufferPairState::Unused;
    if(hasNodeBuffer && hasParentBuffer)
        return MeshSwBvhBufferPairState::Complete;
    return MeshSwBvhBufferPairState::Incomplete;
}

b8 ShouldFreeUnreferencedSwBvhHandle(in b8 heapInitialized, in b8 handleValid, in b8 matchesRef0, in b8 matchesRef1){
    return heapInitialized && handleValid && !matchesRef0 && !matchesRef1;
}

b8 ShouldFreeUnreferencedSwBvhHandle(in b8 heapInitialized, in b8 handleValid, in b8 matchesRef0, in b8 matchesRef1, in b8 matchesRef2, in b8 matchesRef3){
    return heapInitialized && handleValid && !matchesRef0 && !matchesRef1 && !matchesRef2 && !matchesRef3;
}

b8 MatchesRenderableRuntimeMeshRevisions(
    in b8 runtimeMesh,
    in u64 meshVersion,
    in u64 descVersion,
    in u64 meshContentRevision,
    in u64 descContentRevision,
    in u32 meshPrimitiveIndexCount,
    in u32 descPrimitiveIndexCount
){
    return runtimeMesh && meshVersion == descVersion && meshContentRevision == descContentRevision && meshPrimitiveIndexCount == descPrimitiveIndexCount;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<MeshRayTracingResourceSnapshot> RendererMeshSystem::findRayTracingResourceSnapshot(in Name meshName)const{
    const auto found = this.m_meshState.m_meshes.find(meshName);
    if(found == this.m_meshState.m_meshes.end())
        return MakeUnexpected(Failure());

    return MeshRayTracingSnapshotPolicy().capture(found.value());
}

Expected<MeshRayTracingResourceSnapshot> CaptureRenderableRayTracingResourceSnapshot(in MeshResources mesh, in RenderableMeshDesc desc, in b8 bindingsReady){
    if(
        (desc.runtime && (
            !MatchesRenderableRuntimeMeshRevisions(
                mesh.runtimeMesh,
                mesh.runtimeMeshVersion,
                desc.runtimeMesh.version,
                mesh.runtimeGeometryContentRevision,
                desc.runtimeMesh.geometryContentRevision,
                mesh.meshletPrimitiveIndexCount,
                desc.runtimeMesh.meshletPrimitiveIndexCount
            )
            || mesh.buffers.positionBuffer != desc.runtimeMesh.buffers.positionBuffer
            || mesh.triangleIndexBuffer != desc.runtimeMesh.triangleIndexBuffer
            || mesh.attributeBuffer != desc.runtimeMesh.attributeBuffer
            || mesh.runtimeLocalBoundsBuffer != desc.runtimeMesh.localBoundsBuffer
            || mesh.runtimeMeshletLocalBoundsBuffer != desc.runtimeMesh.meshletLocalBoundsBuffer
        ))
        || !bindingsReady
    )
        return MakeUnexpected(Failure());

    return MeshRayTracingSnapshotPolicy().capture(mesh);
}

Expected<MeshRayTracingResourceSnapshot> RendererMeshSystem::findRenderableRayTracingResourceSnapshot(in RenderableMeshDesc desc)const{
    if(!desc.valid())
        return MakeUnexpected(Failure());

    Name meshName = desc.mesh.name();
    if(desc.runtime)
        meshName = desc.runtimeMesh.meshKey;
    const auto found = this.m_meshState.m_meshes.find(meshName);
    if(found == this.m_meshState.m_meshes.end())
        return MakeUnexpected(Failure());

    return CaptureRenderableRayTracingResourceSnapshot(found.value(), desc, this.meshRenderBindingsReady(found.value()));
}

[cpp_unwind]
b8 RendererMeshSystem::commitRayTracingResourceSnapshot(in MeshRayTracingResourceSnapshot expected, mut MeshRayTracingResourceSnapshot desired){
    const auto found = this.m_meshState.m_meshes.find(expected.meshName);
    const b8 currentMatches = found != this.m_meshState.m_meshes.end() && MeshRayTracingSnapshotPolicy().matches(found.value(), expected);
    if(!currentMatches || !MatchesMeshRayTracingSnapshotIdentity(expected, desired)){
        mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
        GpuDescriptorHandle currentNodeHandle = GpuDescriptorHandleInvalid();
        GpuDescriptorHandle currentParentHandle = GpuDescriptorHandleInvalid();
        if(found != this.m_meshState.m_meshes.end()){
            currentNodeHandle = found.value().swBvhNodeHeapHandle;
            currentParentHandle = found.value().swBvhParentHeapHandle;
        }
        const GpuDescriptorHandle candidateNodeHandle = desired.swBvhNodeHeapHandle;
        if(ShouldFreeUnreferencedSwBvhHandle(
            heap.isInitialized(),
            candidateNodeHandle.valid(),
            candidateNodeHandle == expected.swBvhNodeHeapHandle,
            candidateNodeHandle == expected.swBvhParentHeapHandle,
            candidateNodeHandle == currentNodeHandle,
            candidateNodeHandle == currentParentHandle
        )){
            heap.free(candidateNodeHandle);
            desired.swBvhNodeHeapHandle = GpuDescriptorHandleInvalid();
            if(desired.swBvhParentHeapHandle == candidateNodeHandle)
                desired.swBvhParentHeapHandle = GpuDescriptorHandleInvalid();
        }
        const GpuDescriptorHandle candidateParentHandle = desired.swBvhParentHeapHandle;
        if(ShouldFreeUnreferencedSwBvhHandle(
            heap.isInitialized(),
            candidateParentHandle.valid(),
            candidateParentHandle == expected.swBvhNodeHeapHandle,
            candidateParentHandle == expected.swBvhParentHeapHandle,
            candidateParentHandle == currentNodeHandle,
            candidateParentHandle == currentParentHandle
        )){
            heap.free(candidateParentHandle);
            desired.swBvhParentHeapHandle = GpuDescriptorHandleInvalid();
        }
        return false;
    }

    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    if(ShouldFreeUnreferencedSwBvhHandle(
        heap.isInitialized(),
        expected.swBvhNodeHeapHandle.valid(),
        expected.swBvhNodeHeapHandle == desired.swBvhNodeHeapHandle,
        expected.swBvhNodeHeapHandle == desired.swBvhParentHeapHandle
    ))
        heap.free(expected.swBvhNodeHeapHandle);
    if(ShouldFreeUnreferencedSwBvhHandle(
        heap.isInitialized(),
        expected.swBvhParentHeapHandle.valid(),
        expected.swBvhParentHeapHandle == expected.swBvhNodeHeapHandle,
        expected.swBvhParentHeapHandle == desired.swBvhNodeHeapHandle,
        expected.swBvhParentHeapHandle == desired.swBvhParentHeapHandle,
        false
    ))
        heap.free(expected.swBvhParentHeapHandle);

    mut MeshResources mesh = found.value();
    const b8 blasReplaced = mesh.blas != desired.blas;
    const b8 swBvhReplaced = mesh.swBvhNodeBuffer != desired.swBvhNodeBuffer || mesh.swBvhParentBuffer != desired.swBvhParentBuffer;
    mesh.blas = desired.blas;
    mesh.swBvhNodeBuffer = desired.swBvhNodeBuffer;
    mesh.swBvhParentBuffer = desired.swBvhParentBuffer;
    mesh.swBvhNodeHeapHandle = desired.swBvhNodeHeapHandle;
    mesh.swBvhParentHeapHandle = desired.swBvhParentHeapHandle;
    MeshAccelerationStatePolicy().commitSnapshot(
        blasReplaced,
        swBvhReplaced,
        desired.blasRefitsSinceRebuild,
        desired.swBvhRefitsSinceRebuild,
        desired.blasBuildPending,
        desired.blasBackingFresh,
        desired.swBvhBuildPending,
        desired.swBvhTopologyBuilt,
        desired.blasBuildAccepted,
        desired.swBvhBuildAccepted,
        desired.blasGeometryContentRevision,
        desired.swBvhGeometryContentRevision,
        mesh.blasRefitsSinceRebuild,
        mesh.swBvhRefitsSinceRebuild,
        mesh.blasBuildPending,
        mesh.blasBackingFresh,
        mesh.swBvhBuildPending,
        mesh.swBvhTopologyBuilt,
        mesh.blasBuildAccepted,
        mesh.swBvhBuildAccepted,
        mesh.blasGeometryContentRevision,
        mesh.swBvhGeometryContentRevision
    );
    desired = MeshRayTracingSnapshotPolicy().capture(mesh);
    return true;
}

[cpp_unwind]
Expected<MeshRayTracingResourceSnapshot> RendererMeshSystem::ensureRayTracingInputHeapHandles(in MeshRayTracingResourceSnapshot expected){
    const auto found = this.m_meshState.m_meshes.find(expected.meshName);
    if(found == this.m_meshState.m_meshes.end() || !MeshRayTracingSnapshotPolicy().matches(found.value(), expected) || !this.ensureMeshSwBvhInputHeapHandles(found.value()))
        return MakeUnexpected(Failure());

    return MeshRayTracingSnapshotPolicy().capture(found.value());
}

void RendererMeshSystem::discardRayTracingBuildState(){
    for(auto meshIt = this.m_meshState.m_meshes.begin(); meshIt != this.m_meshState.m_meshes.end(); ++meshIt){
        mut MeshResources mesh = meshIt.value();
        MeshAccelerationStatePolicy().resetBuild(
            mesh.blas.valid(),
            mesh.swBvhNodeBuffer.valid() || mesh.swBvhParentBuffer.valid(),
            mesh.blasBuildPending,
            mesh.blasBuildAccepted,
            mesh.blasGeometryContentRevision,
            mesh.blasRefitsSinceRebuild,
            mesh.swBvhBuildPending,
            mesh.swBvhTopologyBuilt,
            mesh.swBvhBuildAccepted,
            mesh.swBvhGeometryContentRevision,
            mesh.swBvhRefitsSinceRebuild
        );
    }
}

[cpp_unwind]
Expected<MeshSoftwareBvhParentBuildStateVector> RendererMeshSystem::collectSoftwareBvhParentBuildStates()const{
    MeshSoftwareBvhParentBuildStateVector states;
    states.reserve(this.m_meshState.m_meshes.size());
    for(in auto entry : this.m_meshState.m_meshes){
        in MeshResources mesh = entry.second;
        const MeshSwBvhBufferPairState pairState = ClassifyMeshSwBvhBufferPair(mesh.swBvhNodeBuffer.valid(), mesh.swBvhParentBuffer.valid());
        if(pairState == MeshSwBvhBufferPairState::Unused)
            continue;
        if(pairState != MeshSwBvhBufferPairState::Complete){
            warning("RendererMeshSystem: incomplete software BVH state for a live mesh");
            return MakeUnexpected(Failure());
        }
        const auto identity = DeriveName(mesh.meshName, s_MeshShadowTraceSwParentSuffix);
        if(!identity.has_value())
            return MakeUnexpected(Failure());
        states.push_back(MeshSoftwareBvhParentBuildState(mesh.swBvhParentBuffer, identity.value()));
    }
    return states;
}


