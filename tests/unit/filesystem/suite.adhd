void BlockingRestoreLogger::block(){
    m_blocked = static_cast<b8>(EnsureDirectories(m_blockedPath));
    if(m_throwAfterBlock)
        throw Tests::FilesystemCases::s_FilesystemPublishLogFailure;
}

FilesystemVolumeTest::FilesystemVolumeTest()
    : m_arena(Tests::FilesystemCases::s_FilesystemNameTestsFilesystem)
    , m_directory(m_arena, "filesystem_unit_test_volume")
    , m_desc(m_arena)
    , m_loggerGuard(m_logger, Core::Common::LoggerBreakPolicy::ReportOnly)
{}

void FilesystemVolumeTest::SetUp(){
    ASSERT_TRUE(RemoveAllIfExists(m_directory));
    ASSERT_TRUE(m_desc.volumeName.assign("test"));
    m_desc.mountDirectory = m_directory;
    m_desc.segmentSize = 4096;
    m_desc.metadataSize = 512;
    m_desc.createIfMissing = true;
    m_desc.usage = Core::Filesystem::VolumeUsage::CookWrite;
}

void FilesystemVolumeTest::TearDown(){
    EXPECT_TRUE(RemoveAllIfExists(m_directory));
}


