namespace NWB::Tests::Smoke{
[[nodiscard]] inline TStringView StressTestProjectName()noexcept{
    return NWB_TEXT("StressTestSmokeProjectImpl");
}

[[nodiscard]] inline TStringView StressCpuTimingOwnerName()noexcept{
    return NWB_TEXT("stress");
}

#if defined(NWB_ASYNC_SHADOW_M4_BENCHMARK)
inline constexpr b8 s_StressAsyncShadowM4Benchmark = true;
#else
inline constexpr b8 s_StressAsyncShadowM4Benchmark = false;
#endif

#if defined(NWB_HARDWARE_SHADOW_BOUNDARY_BENCHMARK)
inline constexpr b8 s_StressHardwareShadowBenchmark = true;
#else
inline constexpr b8 s_StressHardwareShadowBenchmark = false;
#endif

#if defined(NWB_ASYNC_SHADOW_M4_BENCHMARK) || defined(NWB_HARDWARE_SHADOW_BOUNDARY_BENCHMARK)
inline constexpr b8 s_StressContinuousBenchmarkRendering = true;
#else
inline constexpr b8 s_StressContinuousBenchmarkRendering = false;
#endif

[[nodiscard]] inline NotNullUniquePtr<Core::ECS::World> CreateStressTestWorldOrDie(ProjectRuntimeContext& context){
    auto world = CreateSmokeWorldOrDie(StressTestProjectName(), context);

    SmokeRenderQualitySettings settings;
    settings.shadow.transparentSampling = Impl::TransparentShadowSampling::TemporalOne;
    settings.shadow.receiverResolution = Impl::ShadowReceiverResolution::Quarter;
    settings.surfelGi.resolveResolution = Impl::SurfelGiResolveResolution::Quarter;
    settings.softwareShadow.blockerSearch = Impl::SoftwareShadowBlockerSearch::Center1;
    settings.softwareShadow.coverage = Impl::SoftwareShadowCoverage::FittedVolume;
    settings.softwareShadow.captureCadence = Impl::SoftwareShadowCaptureCadence::ReuseTwoFrames;
    settings.caustic.photonGridDivisor = context.graphics.queryFeatureSupport(Core::Feature::RayQuery) ? 2u : 4u;
    AddSmokeSkinnedRenderSystems(*world, context, settings);
    return world;
}
};
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f64 s_StressTimingWarmupSeconds = 5.0;
const f64 s_StressDefaultWarmupSeconds = 0.25;
const f64 s_StressTimingMeasurementSeconds = 30.0;
const f32 s_StressMaxM4FreezeFrame = 1000000.0f;

b8 StressTimingEnabled(){
    b8 enabled = false;
    native(mut enabled){
        static const b8 s_Enabled = ReadSmokeEnvironmentFlag("NWB_STRESS_SMOKE_TIMING");
        enabled = s_Enabled;
    }
    return enabled;
}

f64 StressFpsWarmupSeconds(){
    if(StressTimingEnabled())
        return s_StressTimingWarmupSeconds;
    return s_StressDefaultWarmupSeconds;
}

f64 StressFpsMeasurementSeconds(){
    if(StressTimingEnabled())
        return s_StressTimingMeasurementSeconds;
    return 0.0;
}

u32 ParseStressM4PixelCaptureFreezeFrame(){
    const Expected<f32> configuredFrame = ReadSmokeEnvironmentF32("NWB_M4_PIXEL_CAPTURE_FREEZE_FRAME");
    if(!configuredFrame.has_value() || !IsFinite(configuredFrame.value()) || configuredFrame.value() < 1.0f)
        return 0u;
    return cast<u32>(Min(configuredFrame.value(), s_StressMaxM4FreezeFrame));
}

u32 StressM4PixelCaptureFreezeFrame(){
    if(!s_StressAsyncShadowM4Benchmark)
        return 0u;
    u32 captureFrame = 0u;
    native(mut captureFrame){
        static const u32 s_CaptureFrame = ParseStressM4PixelCaptureFreezeFrame();
        captureFrame = s_CaptureFrame;
    }
    return captureFrame;
}

b8 StressHardwareShadowOpaqueBaseline(){
    if(!s_StressHardwareShadowBenchmark)
        return false;
    b8 enabled = false;
    native(mut enabled){
        static const b8 s_Enabled = ReadSmokeEnvironmentFlag("NWB_HARDWARE_SHADOW_BOUNDARY_OPAQUE_BASELINE");
        enabled = s_Enabled;
    }
    return enabled;
}

Expected<u32> ReadStressCharactersPerClass(){
    b8 readFailed = false;
    b8 hasValue = false;
    String text;
    native(mut readFailed, mut hasValue, mut text){
        Core::Alloc::GlobalArena arena{s_SmokeNameTestsStressWorkload};
        const auto value = ReadEnvironmentVariable(arena, "NWB_STRESS_CHARACTERS_PER_CLASS");
        if(!value){
            NWB_LOGGER_ERROR(NWB_TEXT("StressTestSmokeProjectImpl: failed to read workload environment: {}"), ConvertString(value.error().message()));
            readFailed = true;
        }
        else if(*value){
            hasValue = true;
            text.assign((*value)->data(), (*value)->size());
        }
    }
    if(readFailed)
        return MakeUnexpected(Failure());
    if(!hasValue)
        return s_StressDefaultCharactersPerClass;
    const StringView view = StringView(text);
    if(view == "5")
        return s_StressComparisonCharactersPerClass;
    if(view != "10"){
        error("StressTestSmokeProjectImpl: characters per class must be exactly 5 or 10");
        return MakeUnexpected(Failure());
    }
    return s_StressDefaultCharactersPerClass;
}

f32 StressFrozenYaw(){
    return ReadSmokeFrozenYawCached("NWB_STRESS_TEST_SPIN_ANGLE");
}

b8 ValidateStressM4QueueTopology(mut ProjectRuntimeContext context){
    if(!s_StressAsyncShadowM4Benchmark)
        return true;
    b8 validTopology = true;
    u32 asyncRequestedFlag = 0u;
    u32 asyncEffectiveFlag = 0u;
    u16 graphicsQueueIndex = 0u;
    u16 graphicsQueueGeneration = 0u;
    u16 computeQueueIndex = 0u;
    u16 computeQueueGeneration = 0u;
    u32 computeDedicatedFlag = 0u;
    u32 computeSupportedFlag = 0u;
    u32 computeGraphicsFlag = 0u;
    native(
        mut context,
        mut validTopology,
        mut asyncRequestedFlag,
        mut asyncEffectiveFlag,
        mut graphicsQueueIndex,
        mut graphicsQueueGeneration,
        mut computeQueueIndex,
        mut computeQueueGeneration,
        mut computeDedicatedFlag,
        mut computeSupportedFlag,
        mut computeGraphicsFlag
    ){
#if defined(NWB_ASYNC_SHADOW_M4_BENCHMARK)
#if defined(NWB_SMOKE_DISABLE_ASYNC_COMPUTE)
        constexpr b8 s_AsyncRequested = false;
#else
        constexpr b8 s_AsyncRequested = true;
#endif
        const auto& device = context.graphics.getDevice();
        const auto graphicsQueue = device.getPrimaryPhysicalQueue(Core::CommandQueue::Graphics);
        const auto computeQueue = device.getPrimaryPhysicalQueue(Core::CommandQueue::Compute);
        const auto* const graphicsInfo = device.getPhysicalQueueInfo(graphicsQueue);
        const auto* const computeInfo = device.getPhysicalQueueInfo(computeQueue);
        const auto topology = device.getPhysicalQueueTopology();
        const u16 deviceGeneration = device.getDeviceGeneration();
        b8 graphicsRegistered = false;
        b8 computeRegistered = false;
        b8 topologyValid = topology.queues && topology.queueCount != 0u;
        if(topologyValid){
            for(usize queueIndex = 0u; queueIndex < topology.queueCount; ++queueIndex){
                const auto& queue = topology.queues[queueIndex];
                topologyValid = topologyValid && queue.id.valid() && queue.id.deviceGeneration == deviceGeneration;
                graphicsRegistered = graphicsRegistered || queue.id == graphicsQueue;
                computeRegistered = computeRegistered || queue.id == computeQueue;
            }
        }
        if(
            !topologyValid || !graphicsQueue.valid() || graphicsQueue.deviceGeneration != deviceGeneration
            || !graphicsInfo || graphicsInfo->id != graphicsQueue || !graphicsRegistered
            || (computeQueue.valid() ? !computeInfo || computeInfo->id != computeQueue || !computeRegistered || computeQueue.deviceGeneration != deviceGeneration : computeQueue != Core::GpuPhysicalQueueId{} || computeInfo != nullptr)
        ){
            validTopology = false;
        }
        else{
            const b8 computeDedicated = computeInfo && computeInfo->dedicated;
            const b8 computeSupported = computeInfo && (computeInfo->capabilities & Core::GpuQueueCapability::Compute) != Core::GpuQueueCapability::None;
            const b8 computeGraphics = computeInfo && (computeInfo->capabilities & Core::GpuQueueCapability::Graphics) != Core::GpuQueueCapability::None;
            const b8 asyncEffective = s_AsyncRequested && computeQueue != graphicsQueue && computeDedicated && computeSupported && !computeGraphics;
            asyncRequestedFlag = s_AsyncRequested ? 1u : 0u;
            asyncEffectiveFlag = asyncEffective ? 1u : 0u;
            graphicsQueueIndex = graphicsQueue.index;
            graphicsQueueGeneration = graphicsQueue.deviceGeneration;
            computeQueueIndex = computeQueue.index;
            computeQueueGeneration = computeQueue.deviceGeneration;
            computeDedicatedFlag = computeDedicated ? 1u : 0u;
            computeSupportedFlag = computeSupported ? 1u : 0u;
            computeGraphicsFlag = computeGraphics ? 1u : 0u;
        }
#else
        (void)context;
#endif
    }
    if(!validTopology){
        error("StressTestSmokeProjectImpl: M4 selected queue topology is invalid");
        return false;
    }
    [essential] info(
        "StressTestSmokeProjectImpl: M4 async compute requested={} effective={} graphicsQueue={}:{} computeQueue={}:{} computeDedicated={} computeSupported={} computeGraphics={}"
        , asyncRequestedFlag
        , asyncEffectiveFlag
        , graphicsQueueIndex
        , graphicsQueueGeneration
        , computeQueueIndex
        , computeQueueGeneration
        , computeDedicatedFlag
        , computeSupportedFlag
        , computeGraphicsFlag
    );
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class StressTestSmokeProjectImpl : IProjectEntryCallbacks{
    public StressTestSmokeProjectImpl(mut ProjectRuntimeContext context){
        this.m_context = context;
        this.m_world = CreateStressTestWorldOrDie(context);
        this.m_scene = StressCrowdScene(context);
        this.m_timingRenderPass = AvboitTimingRenderPass(context.graphics);
        this.m_fpsProbe = PresentationFpsProbe(StressFpsWarmupSeconds(), StressFpsMeasurementSeconds());
        this.m_pacingRing = PresentationPacingRing();
        this.m_cpuTimingProbe = SmokeCpuGpuTimingProbe(StressCpuTimingOwnerName());
        this.m_gpuPassTimingProbe = GpuPassTimingProbe(StressTestProjectName());
        this.m_arrowYawInput = ArrowYawInputHandler();
        this.m_frameGraphSnapshotPath = SmokeEnvironmentString(context.objectArena);
        this.m_reflectionStatisticsSequence = 0u;
        this.m_reflectionStatisticsGeneration = 0u;
        this.m_yaw = YawSpinController();
        this.m_charactersPerClass = s_StressDefaultCharactersPerClass;
        this.m_m4RenderedFrameCount = 0u;
        this.m_timingEnabled = StressTimingEnabled();
        this.m_cpuDiagnosticsEnabled = ReadSmokeEnvironmentFlag("NWB_STRESS_CPU_DIAGNOSTICS");
        this.m_reflectionDiagnosticsEnabled = ReadSmokeEnvironmentFlag("NWB_STRESS_REFLECTION_DIAGNOSTICS");
        this.m_timingComplete = false;
        this.m_m4PixelCapturePaused = false;
        this.m_rendererBaselineCapturePaused = false;
    }

    public ~StressTestSmokeProjectImpl(){
        native(mut ctx = this.m_context, mut inputHandler = this.m_arrowYawInput){
            ctx.input.removeHandler(inputHandler);
        }
        this.m_timingRenderPass.stop();
        this.destroyWorld();
    }

    public b8 onStartup()override{
        if(!ValidateStressM4QueueTopology(this.m_context))
            return false;

        if(s_StressAsyncShadowM4Benchmark){
            b8 hasSnapshotPath = false;
            native(mut ctx = this.m_context, mut dstPath = this.m_frameGraphSnapshotPath, mut hasSnapshotPath){
                auto snapshotPath = ReadSmokeEnvironmentText(ctx.objectArena, "NWB_STRESS_FRAME_GRAPH_FILE");
                if(snapshotPath){
                    dstPath = Move(*snapshotPath);
                    hasSnapshotPath = true;
                }
                else
                    dstPath.clear();
            }
            if(hasSnapshotPath && (this.m_timingEnabled || StressM4PixelCaptureFreezeFrame() == 0u)){
                error("StressTestSmokeProjectImpl: frame graph snapshot requires pixel freeze and excludes presentation measurement");
                return false;
            }
        }

        const Expected<u32> charactersPerClass = ReadStressCharactersPerClass();
        if(!charactersPerClass.has_value())
            return false;
        this.m_charactersPerClass = charactersPerClass.value();

        const b8 reflectionDiagnostics = this.m_reflectionDiagnosticsEnabled;
        b8 reflectionSettingsApplied = false;
        native(in reflectionDiagnostics, mut world = this.m_world, mut reflectionSettingsApplied){
            auto& renderer = *MakeNotNull(world->getSystem<Impl::RendererSystem>());
            Impl::ReflectionSettings reflectionSettings;
            reflectionSettings.diagnosticsEnabled = reflectionDiagnostics;
            reflectionSettingsApplied = ApplyReflectionQualitySmokeSettings(reflectionSettings, renderer);
        }
        if(!reflectionSettingsApplied)
            return false;
        if(this.m_reflectionDiagnosticsEnabled)
            [essential] info("StressTestSmokeProjectImpl: reflection diagnostics enabled");

        String cpuTimingPath;
        const Expected<String> cpuTimingEnv = ReadSmokeEnvironmentString("NWB_STRESS_CPU_TIMING_FILE");
        if(cpuTimingEnv.has_value())
            cpuTimingPath = cpuTimingEnv.value();
        if(!this.m_cpuTimingProbe.initialize(this.m_cpuDiagnosticsEnabled, this.m_timingEnabled, StringView(cpuTimingPath)))
            return false;

        const b8 cpuDiagnostics = this.m_cpuDiagnosticsEnabled;
        b8 hasQuitCallback = false;
        native(in cpuDiagnostics, mut ctx = this.m_context, mut hasQuitCallback){
            Core::Perf::CaptureOptions capture = Core::Perf::CaptureOptions::GpuTimingOnly();
            capture.cpuTiming = cpuDiagnostics;
            ctx.setPerfCapture(capture);
            hasQuitCallback = static_cast<b8>(ctx.requestQuit);
        }
        if(this.m_timingEnabled && (StressM4PixelCaptureFreezeFrame() != 0u || RendererBaselineCaptureFreezeFrame() != 0u || !hasQuitCallback)){
            error("StressTestSmokeProjectImpl: timing requires continuous submissions and a quit callback");
            return false;
        }
        if((this.m_timingEnabled || s_StressContinuousBenchmarkRendering) && !this.m_timingRenderPass.start(true))
            return false;
        if(this.m_timingEnabled){
            this.m_pacingRing.reset();
            [essential] info("StressTestSmokeProjectImpl: presentation timing warmup_seconds=5 measure_seconds=30 clock=steady accepted_native_present=1");
            native(in ctx = this.m_context){
                NWB_LOGGER_ESSENTIAL_INFO(
                    NWB_TEXT("StressTestSmokeProjectImpl: device capability meshlets={} rayquery={} raypipeline={} accelstruct={} wavelanes={} renderer={}")
                    , ctx.graphics.queryFeatureSupport(Core::Feature::Meshlets) ? 1u : 0u
                    , ctx.graphics.queryFeatureSupport(Core::Feature::RayQuery) ? 1u : 0u
                    , ctx.graphics.queryFeatureSupport(Core::Feature::RayTracingPipeline) ? 1u : 0u
                    , ctx.graphics.queryFeatureSupport(Core::Feature::RayTracingAccelStruct) ? 1u : 0u
                    , ctx.graphics.queryWaveLaneCount()
                    , ctx.graphics.getRendererString()
                );
            }
        }

        native(mut ctx = this.m_context, mut inputHandler = this.m_arrowYawInput){
            ctx.input.addHandlerToBack(inputHandler);
        }

        const u32 charsPerClass = this.m_charactersPerClass;
        const b8 comparison = charsPerClass == s_StressComparisonCharactersPerClass;
        const b8 opaqueOnly = StressHardwareShadowOpaqueBaseline();
        b8 sceneReady = false;
        native(in charsPerClass, in comparison, in opaqueOnly, mut ctx = this.m_context, mut world = this.m_world, mut scene = this.m_scene, mut sceneReady){
            sceneReady = scene.initialize(ctx, *world, charsPerClass, comparison, opaqueOnly);
        }
        if(!sceneReady)
            return false;
        return true;
    }

    public void onShutdown()override{
        native(mut ctx = this.m_context, mut inputHandler = this.m_arrowYawInput){
            ctx.graphics.setFrameSubmissionSuspended(false);
            ctx.input.removeHandler(inputHandler);
        }
        this.m_timingRenderPass.stop();
        if(this.m_timingEnabled && !this.m_timingComplete)
            error("StressTestSmokeProjectImpl: presentation measurement incomplete");
        this.destroyWorld();
        [essential] info("StressTestSmokeProjectImpl: shutdown");
    }

    public b8 onUpdate(in f32 delta)override{
        const u32 m4CaptureFreezeFrame = StressM4PixelCaptureFreezeFrame();
        if(m4CaptureFreezeFrame != 0u && this.m_m4RenderedFrameCount >= m4CaptureFreezeFrame){
            if(!this.m_m4PixelCapturePaused){
                if(s_StressAsyncShadowM4Benchmark){
                    const u64 renderedFrames = cast<u64>(this.m_m4RenderedFrameCount);
                    b8 snapshotOk = true;
                    native(in snapshotPath = this.m_frameGraphSnapshotPath, in renderedFrames, mut ctx = this.m_context, mut snapshotOk){
                        if(!snapshotPath.empty())
                            snapshotOk = CaptureStressFrameGraphSnapshot(AStringView(snapshotPath.data(), snapshotPath.size()), renderedFrames, ctx);
                    }
                    if(!snapshotOk)
                        return false;
                }
                native(mut ctx = this.m_context){
                    ctx.graphics.setFrameSubmissionSuspended(true);
                }
                this.m_m4PixelCapturePaused = true;
                [essential] info("StressTestSmokeProjectImpl: M4 pixel capture ready after {} rendered frames; render submission suspended", this.m_m4RenderedFrameCount);
            }
            return true;
        }

        const u32 baselineCaptureFreezeFrame = RendererBaselineCaptureFreezeFrame();
        if(baselineCaptureFreezeFrame != 0u && this.m_m4RenderedFrameCount >= baselineCaptureFreezeFrame){
            if(!this.m_rendererBaselineCapturePaused){
                native(mut ctx = this.m_context){
                    ctx.graphics.setFrameSubmissionSuspended(true);
                }
                this.m_rendererBaselineCapturePaused = true;
                [essential] info("StressTestSmokeProjectImpl: renderer baseline capture ready after {} rendered frames; render submission suspended", this.m_m4RenderedFrameCount);
            }
            return true;
        }

        const f32 fixedDelta = RendererBaselineFixedDelta();
        f32 safeDelta = 0.0f;
        if(fixedDelta > 0.0f)
            safeDelta = fixedDelta;
        else if(IsFinite(delta))
            safeDelta = Max(delta, 0.0f);

        if(!this.samplePresentationFps())
            return false;
        native(in safeDelta, in ctx = this.m_context, mut gpuProbe = this.m_gpuPassTimingProbe){
            gpuProbe.recordFrame(safeDelta, ctx.gpuTimingView());
        }
        const f32 frozen = StressFrozenYaw();
        this.m_yaw.update(safeDelta, frozen, frozen >= 0.0f, this.m_arrowYawInput, s_StressManualYawSpeed, s_StressSpinSpeed, s_StressMaxSpinDelta);

        const f32 currentYaw = this.m_yaw.yaw();
        b8 sceneUpdated = false;
        native(in currentYaw, mut world = this.m_world, mut scene = this.m_scene, mut sceneUpdated){
            sceneUpdated = scene.update(currentYaw, *world);
        }
        if(!sceneUpdated)
            return false;

        SetSmokeYawWindowTitle(currentYaw, this.m_yaw.manualControl(), s_StressTwoPi, this.m_context);

        b8 worldTicked = false;
        native(in safeDelta, mut world = this.m_world, mut worldTicked){
            worldTicked = TickSmokeWorld(safeDelta, *world);
        }
        if(!worldTicked)
            return false;

        this.reportReflectionStatistics();
        ++this.m_m4RenderedFrameCount;
        return true;
    }

    private void destroyWorld(){
        DestroySmokeSkinnedRenderWorld(this.m_context, this.m_world);
    }

    private void reportReflectionStatistics(){
        if(!this.m_reflectionDiagnosticsEnabled)
            return;
        const u64 prevSeq = this.m_reflectionStatisticsSequence;
        const u64 prevGen = this.m_reflectionStatisticsGeneration;
        b8 hasNewStats = false;
        u64 sequence = 0u;
        u64 generation = 0u;
        u64 frameIndex = 0u;
        u64 graphicsFrameIndex = 0u;
        u32 hardwareReadyFlag = 0u;
        u32 opticalTransportFlag = 0u;
        u32 candidates = 0u;
        u32 hardwareRays = 0u;
        u32 exteriorEligibleRays = 0u;
        u32 queryBudgetUnits = 0u;
        u32 physicalQueries = 0u;
        u32 bootstrapEvents = 0u;
        u32 transparentPaths = 0u;
        u32 unsupportedPaths = 0u;
        u32 screenAttempts = 0u;
        u32 screenHits = 0u;
        u32 screenReturns = 0u;
        u32 screenIterations = 0u;
        u32 screenLimitMisses = 0u;
        native(
            in prevSeq,
            in prevGen,
            mut world = this.m_world,
            mut hasNewStats,
            mut sequence,
            mut generation,
            mut frameIndex,
            mut graphicsFrameIndex,
            mut hardwareReadyFlag,
            mut opticalTransportFlag,
            mut candidates,
            mut hardwareRays,
            mut exteriorEligibleRays,
            mut queryBudgetUnits,
            mut physicalQueries,
            mut bootstrapEvents,
            mut transparentPaths,
            mut unsupportedPaths,
            mut screenAttempts,
            mut screenHits,
            mut screenReturns,
            mut screenIterations,
            mut screenLimitMisses
        ){
            const auto& renderer = *MakeNotNull(world->getSystem<Impl::RendererSystem>());
            if(const auto statisticsResult = renderer.tryGetLatestReflectionStatistics()){
                const Impl::ReflectionStatistics& statistics = *statisticsResult;
                if(statistics.sequence != prevSeq || statistics.generation != prevGen){
                    hasNewStats = true;
                    sequence = statistics.sequence;
                    generation = statistics.generation;
                    frameIndex = statistics.frameIndex;
                    graphicsFrameIndex = statistics.graphicsFrameIndex;
                    hardwareReadyFlag = statistics.hardwareReady ? 1u : 0u;
                    opticalTransportFlag = statistics.opticalTransportEnabled ? 1u : 0u;
                    candidates = statistics.candidates;
                    hardwareRays = statistics.hardwareRays;
                    exteriorEligibleRays = statistics.exteriorEligibleRays;
                    queryBudgetUnits = statistics.queryBudgetUnits;
                    physicalQueries = statistics.physicalQueries;
                    bootstrapEvents = statistics.bootstrapEvents;
                    transparentPaths = statistics.transparentPaths;
                    unsupportedPaths = statistics.unsupportedPaths;
                    screenAttempts = statistics.screenAttempts;
                    screenHits = statistics.screenHits;
                    screenReturns = statistics.screenReturns;
                    screenIterations = statistics.screenIterations;
                    screenLimitMisses = statistics.screenLimitMisses;
                }
            }
        }
        if(!hasNewStats)
            return;
        this.m_reflectionStatisticsSequence = sequence;
        this.m_reflectionStatisticsGeneration = generation;
        [essential] info(
            "StressReflectionStatistics: sequence={} generation={} frame={} graphics_frame={} hardware_ready={} transport_enabled={} candidates={} hardware_rays={} exterior_eligible_rays={} query_budget_units={} physical_queries={} bootstrap_events={} transparent_paths={} unsupported_paths={} screen_attempts={} screen_hits={} screen_returns={} screen_iterations={} screen_limit_misses={}"
            , sequence
            , generation
            , frameIndex
            , graphicsFrameIndex
            , hardwareReadyFlag
            , opticalTransportFlag
            , candidates
            , hardwareRays
            , exteriorEligibleRays
            , queryBudgetUnits
            , physicalQueries
            , bootstrapEvents
            , transparentPaths
            , unsupportedPaths
            , screenAttempts
            , screenHits
            , screenReturns
            , screenIterations
            , screenLimitMisses
        );
    }

    private b8 samplePresentationFps(){
        u64 successfulPresentations = 0u;
        Timer observationTime = Timer();
        native(in ctx = this.m_context, mut successfulPresentations, mut observationTime){
            successfulPresentations = ctx.graphics.getSuccessfulPresentationCount();
            observationTime = TimerNow();
        }
        this.m_pacingRing.record(successfulPresentations, observationTime);
        const PresentationFpsStatus status = this.m_fpsProbe.observe(successfulPresentations, observationTime);
        if(status == PresentationFpsStatus::Invalid){
            error("StressTestSmokeProjectImpl: presentation measurement invalid counter or clock");
            return false;
        }
        b8 cpuObserveOk = false;
        const b8 measurementComplete = status == PresentationFpsStatus::Complete;
        native(
            in ctx = this.m_context,
            in fpsProbe = this.m_fpsProbe,
            in successfulPresentations,
            in measurementComplete,
            mut cpuProbe = this.m_cpuTimingProbe,
            mut cpuObserveOk
        ){
            cpuObserveOk = cpuProbe.observe(ctx.perfSession, fpsProbe, successfulPresentations, measurementComplete);
        }
        if(!cpuObserveOk)
            return false;
        if(status == PresentationFpsStatus::Waiting)
            return true;

        const PresentationFpsSample interval = this.m_fpsProbe.interval();
        [essential] info(
            "StressTestSmokeProjectImpl: presentation fps avg={} presentations={} seconds={} first={} last={}"
            , interval.averageFps()
            , interval.presentations()
            , interval.wallSeconds
            , interval.firstPresentationCount
            , interval.lastPresentationCount
        );
        if(status == PresentationFpsStatus::Complete){
            const PresentationFpsSample total = this.m_fpsProbe.total();
            const PresentationPacingSummary pacingSummary = this.m_pacingRing.summarize();
            [essential] info(
                "StressTestSmokeProjectImpl: presentation pacing samples={} p50ms={} p95ms={} maxms={} stalls50ms={}"
                , pacingSummary.samples
                , pacingSummary.p50Ms
                , pacingSummary.p95Ms
                , pacingSummary.maxMs
                , pacingSummary.stallsOver50Ms
            );
            this.m_timingComplete = true;
            [essential] info(
                "StressTestSmokeProjectImpl: presentation measurement complete fps={} presentations={} seconds={} first={} last={}"
                , total.averageFps()
                , total.presentations()
                , total.wallSeconds
                , total.firstPresentationCount
                , total.lastPresentationCount
            );
            native(mut ctx = this.m_context){
                ctx.requestQuit();
            }
        }
        return true;
    }

    private mut ProjectRuntimeContext m_context;
    private NotNullUniquePtr<World> m_world;
    private StressCrowdScene m_scene;
    private AvboitTimingRenderPass m_timingRenderPass;
    private PresentationFpsProbe m_fpsProbe;
    private PresentationPacingRing m_pacingRing;
    private SmokeCpuGpuTimingProbe m_cpuTimingProbe;
    private GpuPassTimingProbe m_gpuPassTimingProbe;
    private ArrowYawInputHandler m_arrowYawInput;
    private SmokeEnvironmentString m_frameGraphSnapshotPath;
    private u64 m_reflectionStatisticsSequence;
    private u64 m_reflectionStatisticsGeneration;
    private YawSpinController m_yaw;
    private u32 m_charactersPerClass;
    private u32 m_m4RenderedFrameCount;
    private b8 m_timingEnabled;
    private b8 m_cpuDiagnosticsEnabled;
    private b8 m_reflectionDiagnosticsEnabled;
    private b8 m_timingComplete;
    private b8 m_m4PixelCapturePaused;
    private b8 m_rendererBaselineCapturePaused;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{
NWB::ProjectFrameClientSize NWB::QueryProjectFrameClientSize(){
    return { 1280, 900 };
}

TStringView NWB::QueryProjectWindowTitle()noexcept{
#if defined(NWB_HARDWARE_SHADOW_BOUNDARY_BENCHMARK)
    return NWB_TEXT("NWB Hardware Shadow Boundary Benchmark");
#elif defined(NWB_ASYNC_SHADOW_M4_BENCHMARK)
    return NWB_TEXT("NWB Async Shadow M4 Benchmark");
#else
    return NWB_TEXT("NWB Stress Test Smoke");
#endif
}

UniquePtr<NWB::IProjectEntryCallbacks> NWB::CreateProjectEntryCallbacks(NWB::ProjectRuntimeContext& context){
    return MakeUnique<NWB::Tests::Smoke::StressTestSmokeProjectImpl>(context);
}
}


