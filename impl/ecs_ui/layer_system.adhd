[system("ui_layer"), friend(UiLayerPaintGuard)]
class UiLayerSystem : IRenderPass, IInputEventHandler{
    private mut World m_world;
    private mut GraphicsRuntime m_graphics;
    private mut InputDispatcher m_input;
    private mut IClipboardService m_clipboard;
    private mut ITextInputService m_textInput;
    private mut ICursorService m_cursor;
    private mut IAccessibilityService m_accessibility;
    private mut AssetManager m_assetManager;
    private ActiveSceneSubsystems m_defaultSceneSubsystems;
    private ActiveSceneSubsystemsRef m_activeSceneSubsystems;
    private UiSkinSelectionState m_skinSelection;
    private UniquePtr<UiSkin> m_skinAsset;
    private UiPaintBuilder m_paint;
    private UiTextService m_text;
    private UiContext m_context;
    private UiEditBoxHost m_editHost;
    private UiBuilder m_ui;
    private GamepadNavigationAdapter m_gamepad;
    private UiLiveRootVector m_liveRoots;
    private UiWidgetRootVector m_rootIdentities;
    private UiGpuRenderer m_renderer;
    private UiDisplayMetrics m_display;
    private UiPoint m_pointer;
    private u64 m_frameGeneration = 0u;
    private u64 m_lastPublishedA11yGeneration = 0u;
    private u64 m_lastPublishedA11yRevision = 0u;
    private u64 m_lastAnnouncedA11yGeneration = 0u;
    private f32 m_lastPublishedA11yScaleX = 0.0f;
    private f32 m_lastPublishedA11yScaleY = 0.0f;
    private WidgetId m_lastPublishedA11yFocus;
    private UiFrameDelta m_frameDelta;
    private u32 m_pressedButtons = 0u;
    private u32 m_width = 0u;
    private u32 m_height = 0u;
    private Array<u8, s_UiNativeKeySlotCount> m_nativeKeyOwners;
    private UiLayerPresentation m_presentation;
    private CursorShape m_lastAppliedCursor = CursorShape::Default;
    private u8 m_pointerOwner = 0u;
    private b8 m_cursorApplied = false;
    private b8 m_blockNativeChars = false;
    private b8 m_blockCommandChars = false;
    private b8 m_resourcesReady = false;
    private b8 m_fontsReady = false;

    public UiLayerSystem(
        mut World world,
        mut GraphicsRuntime graphics,
        mut InputDispatcher input,
        mut IClipboardService clipboard,
        mut ITextInputService textInput,
        mut ICursorService cursor,
        mut IAccessibilityService accessibility,
        mut AssetManager assetManager,
        in UiLayerShaderPathResolveCallback shaderPathResolver,
        in AssetRef<UiSkin> skin,
        in UiLayerPresentation presentation
    ){
        this.m_world = world;
        this.m_graphics = graphics;
        this.m_input = input;
        this.m_clipboard = clipboard;
        this.m_textInput = textInput;
        this.m_cursor = cursor;
        this.m_accessibility = accessibility;
        this.m_assetManager = assetManager;
        this.m_skinSelection = MakeUiSkinSelectionState(skin);
        this.m_editHost = UiEditBoxHost(this.m_context, textInput, clipboard);
        this.m_ui = UiBuilder(this.m_context, this.m_paint, this.m_text);
        this.m_renderer = UiGpuRenderer(graphics, assetManager, shaderPathResolver);
        this.m_presentation = presentation;
        this.writeAccess<UiPaintComponent>();
        this.m_ui.setEditHost(this.m_editHost);
        this.m_liveRoots.reserve(s_InputMaxTargets);
        this.m_rootIdentities.reserve(s_InputMaxTargets);
        this.m_input.addHandlerToBack(this);
        if(!this.m_input.windowFocused())
            this.windowFocusUpdate(false);
        if(this.m_presentation == UiLayerPresentation::Scene)
            this.m_graphics.setTaskGraphOutputLayerContributor(this.m_renderer);
    }
    public ~UiLayerSystem(){
        this.m_input.removeHandler(this);
        this.m_graphics.clearTaskGraphOutputLayerContributor(this.m_renderer);
    }

    public void setActiveSceneSubsystems(in ActiveSceneSubsystemsRef subsystems){
        this.m_activeSceneSubsystems = subsystems;
        this.m_renderer.setActiveSceneSubsystems(subsystems);
    }
    public void setGpuCommandRecordingMode(in UiGpuCommandRecordingMode mode){ this.m_renderer.setCommandRecordingMode(mode); }

    public CpuTaskOptions taskOptions()const override;
    public void prepare(mut World world)override;
    [cpp_unwind]
    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta)override;
    [cpp_unwind]
    public b8 validateResources(in u32 width, in u32 height, in u32 sampleCount)override;
    public void invalidateResources()override;
    public b8 prepareResources(in FramebufferPtr framebuffer)override;
    public void render(in FramebufferPtr framebuffer)override;
    public void displayScaleChanged(in f32 scaleX, in f32 scaleY)override;

    [cpp_unwind]
    public b8 setInputBindings(in Span<UiInputKeyBinding> bindings);
    [cpp_unwind]
    public b8 dispatchInputEvent(in UiInputEvent event);
    [cpp_unwind]
    public b8 dispatchInputEvent(in UiInputEvent event, mut b8 outBlockText);
    [cpp_unwind]
    public b8 dispatchPointerInput(in UiPointerInput input);
    [cpp_unwind]
    public b8 dispatchPointerInput(in UiPointerInput input, mut b8 outConsumed);
    [cpp_unwind]
    public void cancelPointerDevice(in u64 device);
    [cpp_unwind]
    public KeyboardInputResult keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods)override;
    [cpp_unwind]
    public b8 keyboardCharInput(in u32 unicode, in i32 mods)override;
    [cpp_unwind]
    public b8 mousePosUpdate(in f64 xpos, in f64 ypos)override;
    [cpp_unwind]
    public b8 mouseButtonUpdate(in i32 button, in i32 action, in i32 mods)override;
    [cpp_unwind]
    public b8 mouseScrollUpdate(in f64 xoffset, in f64 yoffset)override;
    [cpp_unwind]
    public void windowFocusUpdate(in b8 focused)override;
    [cpp_unwind]
    public void pointerLeave()override;
    [cpp_unwind]
    public void pointerCaptureLost()override;
    [cpp_unwind]
    public void gamepadConnectionUpdate(in u32 gamepadIndex, in b8 connected)override;
    [cpp_unwind]
    public b8 gamepadButtonUpdate(in u32 gamepadIndex, in i32 button, in i32 action)override;
    [cpp_unwind]
    public b8 gamepadAxisUpdate(in u32 gamepadIndex, in i32 axis, in f32 value)override;
    public b8 wantsKeyboard()const;
    public b8 wantsPointer()const;

    [cpp_unwind]
    private void collectRoots();
    [cpp_unwind]
    private void commitAcceptedFrameIfReady();
    [cpp_unwind]
    private void synchronizeInput();
    private void synchronizeCursor();
    private void synchronizeCursorForRouter(in PointerCursor routerCursor);
    [cpp_unwind]
    private void synchronizeAccessibility();
    [cpp_unwind]
    private void synchronizeGamepadOutputs(in b8 consumed, in WidgetId prevFocus, in WidgetId prevHover, in WidgetId prevCapture);
    [cpp_unwind]
    private void pollAccessibilityActions();
    [cpp_unwind]
    private void routeInput(in UiInputEvent event);
    [cpp_unwind]
    private b8 routeInput(in UiInputEvent event, mut b8 outBlockText);
    [cpp_unwind]
    private void routePointerInput(in UiPointerInput input);
    [cpp_unwind]
    private b8 routePointerInput(in UiPointerInput input, mut b8 outConsumed);
    [cpp_unwind]
    private b8 routeInputCore(in WidgetId previousCapture, in Expected<InputEvent> normalized, in b8 pointerMode, mut b8 outBlockText, mut b8 outConsumed);
    [cpp_unwind]
    private void synchronizeNativeInput();
    [cpp_unwind]
    private void abandonPendingFrame();
    [cpp_unwind]
    private void abandonPendingFrame(in b8 resetUi);
    private void resetNormalizedInput();
    [cpp_unwind]
    private void resetNativeInputState();
    [cpp_unwind]
    private b8 loadFonts();
    [cpp_unwind]
    private b8 tryBindSkin(in AssetRef<UiSkin> ref);
    private AssetRef<UiSkin> basicSkin()const;
    private AssetRef<UiSkin> resolveSkin(in AssetRef<UiSkin> ref)const;
}

class UiLayerPaintGuard : NoCopy{
    private mut UiLayerSystem m_layer;
    private b8 m_armed = true;

    public UiLayerPaintGuard(mut UiLayerSystem layer){
        this.m_layer = layer;
    }
    public ~UiLayerPaintGuard(){
        if(this.m_armed)
            this.m_layer.abandonPendingFrame(true);
    }
    public void release(){ this.m_armed = false; }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidUiDisplayScale(in f32 scaleX, in f32 scaleY){
    return IsFinite(VectorSingle(scaleX, scaleY, 0.0f, 0.0f)) && scaleX > 0.0f && scaleY > 0.0f;
}

b8 ShouldSuppressControlCharInput(in b8 hasControlModifier, in b8 hasAltModifier){
    return hasControlModifier && !hasAltModifier;
}

b8 ShouldBlockRoutedCommandText(in b8 isCommandDown, in b8 hasCommand, in b8 allowText){
    return isCommandDown && hasCommand && !allowText;
}

u8 ResolveUiPointerPressOwner(
    in b8 nativeActive,
    in b8 wouldConsumePointer,
    in b8 hasPopup,
    in b8 hitTargetValid
){
    b8 consumed = hasPopup || hitTargetValid;
    if(nativeActive)
        consumed = wouldConsumePointer;
    if(consumed)
        return cast<u8>(UiInputOwner::Custom);
    return cast<u8>(UiInputOwner::Scene);
}

b8 CanBeginUiLayerPaintFrame(in b8 resourcesReady, in b8 rendererHasPendingFrame, in b8 contextReady){
    return resourcesReady && !rendererHasPendingFrame && !contextReady;
}

CursorShape MapPointerCursorToCoreCursor(in PointerCursor cursor){
    switch(cursor){
    case PointerCursor::TextInput: return CursorShape::TextInput;
    case PointerCursor::Hand: return CursorShape::Hand;
    case PointerCursor::Crosshair: return CursorShape::Crosshair;
    case PointerCursor::ResizeEW: return CursorShape::ResizeEW;
    case PointerCursor::ResizeNS: return CursorShape::ResizeNS;
    case PointerCursor::ResizeNWSE: return CursorShape::ResizeNWSE;
    case PointerCursor::ResizeNESW: return CursorShape::ResizeNESW;
    case PointerCursor::Move: return CursorShape::Move;
    case PointerCursor::NotAllowed: return CursorShape::NotAllowed;
    case PointerCursor::Wait: return CursorShape::Wait;
    case PointerCursor::Progress: return CursorShape::Progress;
    case PointerCursor::Grab: return CursorShape::Grab;
    case PointerCursor::Grabbing: return CursorShape::Grabbing;
    case PointerCursor::Hidden: return CursorShape::Hidden;
    default: return CursorShape::Default;
    }
}

CpuTaskOptions UiLayerSystem::taskOptions()const{
    CpuTaskOptions options;
    options.cost = CpuTaskCost::Light;
    options.target = CpuTaskTarget::MainThread;
    return options;
}

void UiLayerSystem::prepare(mut World world){
}

[cpp_unwind]
void UiLayerSystem::abandonPendingFrame(){
    this.abandonPendingFrame(false);
}

[cpp_unwind]
void UiLayerSystem::abandonPendingFrame(in b8 resetUi){
    this.m_blockCommandChars = false;
    this.m_context.abandonFrame();
    this.m_editHost.reset();
    if(resetUi)
        this.m_ui.reset();
}

void UiLayerSystem::resetNormalizedInput(){
    this.m_blockCommandChars = false;
    this.m_context.resetInput();
    this.m_editHost.reset();
}

[cpp_unwind]
void UiLayerSystem::resetNativeInputState(){
    this.m_context.input().cancelDeviceInput(0u);
    this.m_gamepad.reset(this.m_context.input());
    for(mut u8 owner : this.m_nativeKeyOwners)
        owner = 0u;
    this.m_pressedButtons = 0u;
    this.m_pointerOwner = cast<u8>(UiInputOwner::Scene);
    this.m_blockNativeChars = false;
    this.m_blockCommandChars = false;
    this.synchronizeCursor();
}

void UiLayerSystem::displayScaleChanged(in f32 scaleX, in f32 scaleY){
    assert(IsValidUiDisplayScale(scaleX, scaleY));
    const VectorSingle scale(scaleX, scaleY, scaleX, scaleY);
    this.m_frameDelta.clear();
    this.abandonPendingFrame(true);
    const VectorSingle extent(cast<f32>(this.m_width), cast<f32>(this.m_height), cast<f32>(this.m_width), cast<f32>(this.m_height));
    const VectorSingle logicalSize = extent / scale;
    this.m_display.logicalWidth = logicalSize.x;
    this.m_display.logicalHeight = logicalSize.y;
    this.m_display.pixelScaleX = scaleX;
    this.m_display.pixelScaleY = scaleY;
}

[cpp_unwind]
b8 UiLayerSystem::setInputBindings(in Span<UiInputKeyBinding> bindings){
    this.synchronizeNativeInput();
    return this.m_context.input().setBindings(bindings);
}

[cpp_unwind]
KeyboardInputResult UiLayerSystem::keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods){
    if(!IsValidInputKeyCode(key) || action < s_InputActionReleaseBase || action > s_InputActionRepeat)
        return KeyboardInputResult();
    this.synchronizeNativeInput();
    const usize slot = ResolveUiNativeKeySlot(key);
    b8 held = false;
    u8 previousOwner = 0u;
    b8 customOwned = false;
    ResolveUiNativeKeyAdmission(this.m_nativeKeyOwners[slot], this.m_context.input().ownsKey(key), held, previousOwner, customOwned);
    const b8 isRelease = action == s_InputActionReleaseBase;
    if(!isRelease)
        this.m_blockCommandChars = false;
    if(isRelease || customOwned || !held){
        InputEvent event;
        if(isRelease)
            event.type = InputEventType::KeyUp;
        else
            event.type = InputEventType::KeyDown;
        event.key = key;
        event.shift = (mods & cast<i32>(InputModifier::Shift)) != 0;
        event.control = (mods & cast<i32>(InputModifier::Control)) != 0;
        event.alt = (mods & cast<i32>(InputModifier::Alt)) != 0;
        event.super = (mods & cast<i32>(InputModifier::Super)) != 0;
        event.repeat = !isRelease && (action == s_InputActionRepeat || held);
        if(isRelease)
            this.routeInput(event);
        else
            this.routeInput(event, this.m_blockCommandChars);
    }
    const b8 routerClaimsKey = this.m_context.input().hasBlockingPopup() || this.m_context.input().focus().valid() || this.m_context.input().ownsKey(key);
    b8 consumed = false;
    FinalizeUiNativeKeyState(isRelease, held, previousOwner, routerClaimsKey, this.m_nativeKeyOwners[slot], this.m_blockNativeChars, consumed);
    KeyboardInputResult result;
    result.consumed = consumed;
    result.blocksText = this.m_blockCommandChars;
    return result;
}

[cpp_unwind]
b8 UiLayerSystem::keyboardCharInput(in u32 unicode, in i32 mods){
    this.synchronizeNativeInput();
    this.m_editHost.collectNative();
    if(this.m_editHost.hasTextFocus()){
        if(ShouldSuppressControlCharInput((mods & cast<i32>(InputModifier::Control)) != 0, (mods & cast<i32>(InputModifier::Alt)) != 0))
            return true;
        return this.m_editHost.character(unicode);
    }
    if(this.m_blockNativeChars || this.m_context.input().hasBlockingPopup() || this.m_context.input().focus().valid())
        return true;
    return false;
}

[cpp_unwind]
b8 UiLayerSystem::mousePosUpdate(in f64 xpos, in f64 ypos){
    if(!ValidUiMouseCoordinate(xpos, ypos))
        return false;
    if(this.m_context.ready())
        this.commitAcceptedFrameIfReady();
    this.m_pointer = Point(cast<f32>(xpos), cast<f32>(ypos));
    PointerInput event;
    event.source = s_NativePointerSource;
    event.position = this.m_pointer;
    event.hoverCapable = true;
    if(this.m_pressedButtons != 0u && this.m_pointerOwner == cast<u8>(UiInputOwner::Scene)){
        event.phase = PointerPhase::Leave;
        this.routePointerInput(event);
        return false;
    }
    event.phase = PointerPhase::Move;
    b8 consumed = false;
    this.routePointerInput(event, consumed);
    return consumed || (this.m_pressedButtons != 0u && this.m_pointerOwner == cast<u8>(UiInputOwner::Custom));
}

[cpp_unwind]
b8 UiLayerSystem::mouseButtonUpdate(in i32 button, in i32 action, in i32 mods){
    if(button < cast<i32>(MouseButton::Left) || button > cast<i32>(MouseButton::Button8) || (action != s_InputActionPress && action != s_InputActionReleaseBase))
        return false;
    this.synchronizeNativeInput();
    const u32 bit = 1u << cast<u32>(button);
    const b8 firstPress = action == s_InputActionPress && (this.m_pressedButtons & bit) == 0u;
    if(action == s_InputActionPress && this.m_pressedButtons == 0u){
        const b8 acceptsSource = this.m_context.input().acceptsPointerSource(s_NativePointerSource);
        const b8 nativeActive = this.m_context.input().activePointerSource() == s_NativePointerSource;
        this.m_pointerOwner = ResolveUiPointerPressOwner(
            nativeActive,
            nativeActive && this.m_context.input().wouldConsumePointer(this.m_pointer),
            this.m_context.input().hasBlockingPopup(),
            !nativeActive && this.m_context.input().hitTest(this.m_pointer).valid()
        );
        if(acceptsSource && this.m_pointerOwner != cast<u8>(UiInputOwner::Custom))
            this.m_context.input().clearFocus();
    }
    if(action == s_InputActionPress)
        this.m_pressedButtons |= bit;
    const u8 owner = this.m_pointerOwner;
    PointerInput event;
    event.source = s_NativePointerSource;
    event.position = this.m_pointer;
    event.extend = (mods & cast<i32>(InputModifier::Shift)) != 0;
    event.toggle = (mods & cast<i32>(InputModifier::Control)) != 0;
    event.hoverCapable = true;
    if(owner == cast<u8>(UiInputOwner::Custom) && (button == cast<i32>(MouseButton::Left) || button == cast<i32>(MouseButton::Right))){
        if(action == s_InputActionReleaseBase)
            event.phase = PointerPhase::Release;
        else
            event.phase = PointerPhase::Press;
        if(button == cast<i32>(MouseButton::Left))
            event.intent = PointerIntent::Activate;
        else
            event.intent = PointerIntent::ContextMenu;
        if(event.phase == PointerPhase::Press && event.intent == PointerIntent::Activate)
            event.timestampMs = Max(cast<u64>(1u), DurationInMS<u64>(TimerNow()));
        this.routePointerInput(event);
    }
    if(owner == cast<u8>(UiInputOwner::Custom) && button == cast<i32>(MouseButton::Middle) && action == s_InputActionPress && this.m_context.input().acceptsPointerSource(s_NativePointerSource)){
        this.m_editHost.collectNative();
        const b8 pasted = this.m_editHost.pastePrimary(this.m_pointer);
        if(!pasted)
            this.m_editHost.synchronizeFocus();
    }
    if(firstPress && (owner == cast<u8>(UiInputOwner::Scene) || (button != cast<i32>(MouseButton::Left) && button != cast<i32>(MouseButton::Right)))){
        event.phase = PointerPhase::Leave;
        this.routePointerInput(event);
    }
    if(action == s_InputActionReleaseBase){
        this.m_pressedButtons &= ~bit;
        if(this.m_pressedButtons == 0u){
            this.m_pointerOwner = cast<u8>(UiInputOwner::Scene);
            event.phase = PointerPhase::Move;
            event.timestampMs = 0u;
            this.routePointerInput(event);
        }
    }
    return owner != cast<u8>(UiInputOwner::Scene);
}

[cpp_unwind]
b8 UiLayerSystem::mouseScrollUpdate(in f64 xoffset, in f64 yoffset){
    if(!ValidUiMouseScroll(xoffset, yoffset))
        return false;
    this.synchronizeNativeInput();
    if(this.m_pressedButtons != 0u && this.m_pointerOwner == cast<u8>(UiInputOwner::Scene))
        return false;
    PointerInput event;
    event.source = s_NativePointerSource;
    event.phase = PointerPhase::Scroll;
    event.position = this.m_pointer;
    event.scrollX = xoffset;
    event.scrollY = yoffset;
    event.hoverCapable = true;
    b8 consumed = false;
    this.routePointerInput(event, consumed);
    return consumed || this.m_pointerOwner == cast<u8>(UiInputOwner::Custom);
}

[cpp_unwind]
void UiLayerSystem::windowFocusUpdate(in b8 focused){
    InputEvent event;
    if(focused)
        event.type = InputEventType::FocusGained;
    else
        event.type = InputEventType::FocusLost;
    this.routeInput(event);
    if(!focused)
        this.resetNativeInputState();
}

[cpp_unwind]
void UiLayerSystem::pointerLeave(){
    PointerInput event;
    event.source = s_NativePointerSource;
    event.phase = PointerPhase::Leave;
    event.position = this.m_pointer;
    event.hoverCapable = true;
    this.routePointerInput(event);
}

[cpp_unwind]
void UiLayerSystem::pointerCaptureLost(){
    if(this.m_pressedButtons == 0u)
        return;
    PointerInput event;
    event.source = s_NativePointerSource;
    event.phase = PointerPhase::Cancel;
    event.position = this.m_pointer;
    event.hoverCapable = true;
    this.routePointerInput(event);
    this.m_pressedButtons = 0u;
    this.m_pointerOwner = cast<u8>(UiInputOwner::Scene);
}

[cpp_unwind]
void UiLayerSystem::gamepadConnectionUpdate(in u32 gamepadIndex, in b8 connected){
    this.synchronizeNativeInput();
    this.m_gamepad.onConnection(gamepadIndex, connected, this.m_context.input());
    this.synchronizeCursor();
    this.synchronizeAccessibility();
}

[cpp_unwind]
void UiLayerSystem::synchronizeGamepadOutputs(in b8 consumed, in WidgetId prevFocus, in WidgetId prevHover, in WidgetId prevCapture){
    if(
        consumed
        || this.m_context.input().focus() != prevFocus
        || this.m_context.input().hover() != prevHover
        || this.m_context.input().capture() != prevCapture
    ){
        this.synchronizeCursor();
        this.synchronizeAccessibility();
    }
}

[cpp_unwind]
b8 UiLayerSystem::gamepadButtonUpdate(in u32 gamepadIndex, in i32 button, in i32 action){
    this.synchronizeNativeInput();
    const WidgetId prevFocus = this.m_context.input().focus();
    const WidgetId prevHover = this.m_context.input().hover();
    const WidgetId prevCapture = this.m_context.input().capture();
    const b8 consumed = this.m_gamepad.onButton(gamepadIndex, button, action, this.m_context.input());
    this.synchronizeGamepadOutputs(consumed, prevFocus, prevHover, prevCapture);
    return consumed;
}

[cpp_unwind]
b8 UiLayerSystem::gamepadAxisUpdate(in u32 gamepadIndex, in i32 axis, in f32 value){
    GamepadStickDirection prevDir = GamepadStickDirection::None;
    GamepadStickDirection nextDir = GamepadStickDirection::None;
    if(!this.m_gamepad.stageAxis(gamepadIndex, axis, value, prevDir, nextDir))
        return false;
    this.synchronizeNativeInput();
    const WidgetId prevFocus = this.m_context.input().focus();
    const WidgetId prevHover = this.m_context.input().hover();
    const WidgetId prevCapture = this.m_context.input().capture();
    const b8 consumed = this.m_gamepad.commitAxisTransition(gamepadIndex, prevDir, nextDir, this.m_context.input());
    this.synchronizeGamepadOutputs(consumed, prevFocus, prevHover, prevCapture);
    return consumed;
}

b8 UiLayerSystem::wantsKeyboard()const{
    return this.m_resourcesReady && this.m_context.input().wantsCommands();
}

b8 UiLayerSystem::wantsPointer()const{
    if(this.m_pressedButtons != 0u)
        return this.m_pointerOwner != cast<u8>(UiInputOwner::Scene);
    return this.m_resourcesReady && this.m_context.input().wantsPointer();
}

[cpp_unwind]
b8 UiLayerSystem::dispatchInputEvent(in UiInputEvent event){
    b8 unusedBlockText = false;
    return this.dispatchInputEvent(event, unusedBlockText);
}

[cpp_unwind]
b8 UiLayerSystem::dispatchInputEvent(in UiInputEvent event, mut b8 outBlockText){
    this.synchronizeNativeInput();
    return this.routeInput(event, outBlockText);
}

[cpp_unwind]
b8 UiLayerSystem::dispatchPointerInput(in UiPointerInput input){
    b8 unusedConsumed = false;
    return this.dispatchPointerInput(input, unusedConsumed);
}

[cpp_unwind]
b8 UiLayerSystem::dispatchPointerInput(in UiPointerInput input, mut b8 outConsumed){
    this.synchronizeNativeInput();
    return this.routePointerInput(input, outConsumed);
}

[cpp_unwind]
void UiLayerSystem::cancelPointerDevice(in u64 device){
    this.synchronizeNativeInput();
    this.m_context.input().cancelDeviceInput(device);
    if(device == 0u){
        this.m_pressedButtons = 0u;
        this.m_pointerOwner = cast<u8>(UiInputOwner::Scene);
    }
}

[cpp_unwind]
b8 UiLayerSystem::routeInputCore(in WidgetId previousCapture, in Expected<InputEvent> normalized, in b8 pointerMode, mut b8 outBlockText, mut b8 outConsumed){
    outBlockText = false;
    outConsumed = false;
    if(!normalized.has_value()){
        if(pointerMode)
            error("UiLayerSystem: invalid or overflowing pointer input");
        else
            error("UiLayerSystem: invalid or overflowing normalized input");
        this.resetNormalizedInput();
        return false;
    }
    const b8 isPointer = pointerMode || IsPointerInputEventType(normalized.value().type);
    b8 submit = false;
    if(!isPointer)
        submit = this.m_editHost.prepareSubmit(normalized.value());
    const InputRoutingResult result = this.m_context.input().process();
    if(!isPointer){
        this.m_editHost.input(normalized.value(), previousCapture, submit);
        outBlockText = ShouldBlockRoutedCommandText(normalized.value().type == InputEventType::CommandDown, normalized.value().command != InputCommand::None, normalized.value().allowText);
    }
    else if(result.pointerRouted)
        this.m_editHost.input(normalized.value(), previousCapture, false);
    LogUiInputRoutingOverflows(result.activationOverflow, result.gestureOverflow);
    outConsumed = result.pointerConsumed;
    this.synchronizeCursorForRouter(result.cursor);
    this.synchronizeAccessibility();
    return true;
}

[cpp_unwind]
void UiLayerSystem::routeInput(in UiInputEvent event){
    b8 unusedBlockText = false;
    this.routeInput(event, unusedBlockText);
}

[cpp_unwind]
b8 UiLayerSystem::routeInput(in UiInputEvent event, mut b8 outBlockText){
    this.m_editHost.collectNative();
    const WidgetId previousCapture = this.m_context.input().capture();
    b8 unusedConsumed = false;
    return this.routeInputCore(previousCapture, this.m_context.input().queue(event), false, outBlockText, unusedConsumed);
}

[cpp_unwind]
void UiLayerSystem::routePointerInput(in UiPointerInput input){
    b8 unusedConsumed = false;
    this.routePointerInput(input, unusedConsumed);
}

[cpp_unwind]
b8 UiLayerSystem::routePointerInput(in UiPointerInput input, mut b8 outConsumed){
    this.m_editHost.collectNative();
    const WidgetId previousCapture = this.m_context.input().capture();
    b8 unusedBlockText = false;
    return this.routeInputCore(previousCapture, this.m_context.input().queuePointer(input), true, unusedBlockText, outConsumed);
}

[cpp_unwind]
void UiLayerSystem::synchronizeNativeInput(){
    this.m_world.taskScope().wait();
    this.synchronizeInput();
}

[cpp_unwind]
b8 UiLayerSystem::tryBindSkin(in AssetRef<UiSkin> ref){
    const AssetRef<UiSkin> resolved = this.resolveSkin(ref);
    if(ref == this.m_skinSelection.selected && this.m_skinAsset.valid()){
        in UiSkin current = this.m_skinAsset.deref();
        return ValidateUiSkinToolkitContract(current) && this.m_renderer.setSkin(resolved, current, this.m_skinSelection.generation);
    }
    auto candidate = LoadTypedAssetSync<UiSkin>(this.m_assetManager, resolved.name(), s_UiLayerSystemOwnerName);
    if(!candidate.has_value() || !candidate.value().valid())
        return false;
    in UiSkin skin = candidate.value().deref();
    if(!ValidateUiSkinToolkitContract(skin) || !this.m_renderer.setSkin(resolved, skin, this.m_skinSelection.generation))
        return false;
    this.m_skinAsset.swap(candidate.value());
    return true;
}

[cpp_unwind]
b8 UiLayerSystem::validateResources(in u32 width, in u32 height, in u32 sampleCount){
    this.m_resourcesReady = false;
    this.m_width = width;
    this.m_height = height;
    if(width == 0u || height == 0u)
        return true;

    if(!this.m_activeSceneSubsystems.has_value()){
        if(!this.m_defaultSceneSubsystems.loadProjectStartScene(this.m_assetManager))
            return false;
        this.m_activeSceneSubsystems = Optional<in ActiveSceneSubsystems>(this.m_defaultSceneSubsystems);
        this.m_renderer.setActiveSceneSubsystems(this.m_activeSceneSubsystems);
    }
    if(!this.m_activeSceneSubsystems.value().hasSubsystem<UiSubsystem>()){
        error("UiLayerSystem: active scene does not include required subsystem 'ui_subsystem'");
        return false;
    }

    if(!this.m_fontsReady){
        if(!this.loadFonts())
            return false;
    }
    if(!this.m_renderer.validateResources(width, height))
        return false;

    mut UiLayerSystem layer = this;
    auto tryBind = lambda[mut layer](in AssetRef<UiSkin> ref) -> b8{ return layer.tryBindSkin(ref); };
    const UiSkinSelectionResult selection = EnsureUiSkinSelection(this.m_skinSelection, this.basicSkin(), tryBind);
    if(selection == UiSkinSelectionResult::Failed)
        return false;
    if(selection == UiSkinSelectionResult::DefaultFallback){
        warning("UiLayerSystem: custom UI skin '{}' is unavailable; using engine default", this.m_skinSelection.requested.name().resolvedText());
    }

    f32 scaleX = 1.0f;
    f32 scaleY = 1.0f;
    this.m_graphics.getDPIScaleInfo(scaleX, scaleY);
    this.displayScaleChanged(scaleX, scaleY);
    this.m_resourcesReady = true;
    return true;
}

void UiLayerSystem::invalidateResources(){
    this.m_resourcesReady = false;
    this.m_frameDelta.clear();
    this.abandonPendingFrame(true);
    this.resetNativeInputState();
    this.m_renderer.invalidateResources();
}

b8 UiLayerSystem::prepareResources(in FramebufferPtr framebuffer){
    if(!IsValidFramebufferPtr(framebuffer) || !this.m_resourcesReady)
        return false;
    const b8 prepared = this.m_renderer.prepareTaskGraphOutputLayer(this.m_graphics.acquiredPresentationFrame());
    if(!prepared && this.m_presentation == UiLayerPresentation::Standalone)
        this.m_graphics.requestDeviceRecreation();
    return prepared;
}

void UiLayerSystem::render(in FramebufferPtr framebuffer){
    if(!IsValidFramebufferPtr(framebuffer) || !this.m_resourcesReady || this.m_presentation == UiLayerPresentation::Scene)
        return;
    if(!this.m_renderer.renderStandalone(this.m_graphics.acquiredPresentationFrame())){
        error("UiLayerSystem: standalone UI presentation failed");
        this.m_graphics.requestDeviceRecreation();
    }
}

[cpp_unwind]
b8 UiLayerSystem::loadFonts(){
    if(this.m_fontsReady)
        return true;
    if(!this.m_activeSceneSubsystems.has_value())
        return false;
    const auto uiSubsystem = this.m_activeSceneSubsystems.value().findSubsystem<UiSubsystem>();
    if(!uiSubsystem.has_value())
        return false;
    const usize fontCount = uiSubsystem.value().basicFonts.size();
    if(!ValidateUiSubsystemFontCount(fontCount, s_TextMaxFontSources))
        return false;
    Array<UniquePtr<Font>, s_TextMaxFontSources> assets;
    Array<UniquePtr<FontAtlas>, s_TextMaxFontSources> atlasAssets;
    Vector<FontSource> sources;
    sources.reserve(fontCount);
    for(usize index = 0u; index < fontCount; ++index){
        in AssetRef<FontAtlas> atlasRef = uiSubsystem.value().basicFonts[index];
        auto loadedAtlas = LoadTypedAssetSync<FontAtlas>(this.m_assetManager, atlasRef.name(), s_UiLayerSystemOwnerName);
        if(!loadedAtlas.has_value())
            return false;
        atlasAssets[index] = loadedAtlas.value();
        in FontAtlas atlas = atlasAssets[index].deref();
        in AssetRef<Font> fontRef = atlas.payload().font;
        auto font = LoadTypedAssetSync<Font>(this.m_assetManager, fontRef.name(), s_UiLayerSystemOwnerName);
        if(!font.has_value())
            return false;
        assets[index] = font.value();
        sources.push_back(FontSource(fontRef, assets[index].deref(), 1u, atlas));
    }
    this.m_fontsReady = this.m_text.setFonts(sources);
    return this.m_fontsReady;
}

AssetRef<UiSkin> UiLayerSystem::basicSkin()const{
    if(!this.m_activeSceneSubsystems.has_value())
        return AssetRef<UiSkin>();
    const auto uiSubsystem = this.m_activeSceneSubsystems.value().findSubsystem<UiSubsystem>();
    if(uiSubsystem.has_value())
        return uiSubsystem.value().basicSkin;
    return AssetRef<UiSkin>();
}

AssetRef<UiSkin> UiLayerSystem::resolveSkin(in AssetRef<UiSkin> ref)const{
    const AssetRef<UiSkin> fallbackSkin = this.basicSkin();
    if(!fallbackSkin.valid())
        return AssetRef<UiSkin>();
    if(!ref.valid() || ref == fallbackSkin)
        return fallbackSkin;
    return this.m_activeSceneSubsystems.value().findSceneAsset<UiSkin>(ref.name());
}

[cpp_unwind]
Expected<void, CpuTaskAdmissionError> UiLayerSystem::update(mut World world, in f32 delta){
    this.m_frameDelta.add(delta);
    this.synchronizeInput();
    this.pollAccessibilityActions();
    if(this.m_context.input().windowFocused()){
        if(this.m_gamepad.tick(delta, this.m_context.input())){
            this.synchronizeCursor();
            this.synchronizeAccessibility();
        }
    }
    if(!CanBeginUiLayerPaintFrame(this.m_resourcesReady, this.m_renderer.hasPendingFrame(), this.m_context.ready()))
        return Expected<void, CpuTaskAdmissionError>();
    AdvanceUiLayerFrameGeneration(this.m_frameGeneration);
    in UiSkin skin = this.m_skinAsset.deref();
    if(!this.m_context.beginFrame(this.m_frameGeneration))
        TerminateInvariant();
    UiLayerPaintGuard abandon(this);
    const f32 frameDelta = this.m_frameDelta.consume();
    this.m_editHost.beginFrame(this.m_frameGeneration, this.m_display);
    if(this.m_editHost.takeClipboardFailure())
        warning("UiLayerSystem: clipboard publication failed");
    this.m_ui.reset();
    this.m_ui.setSkin(skin);
    this.m_paint.begin(this.m_display, this.m_frameGeneration, this.m_skinSelection.generation, AssetRef<UiSkin>(skin.virtualPath()), skin);
    this.m_paint.reserve(s_UiLayerPaintReserveQuads);
    this.m_ui.setDeltaSeconds(frameDelta);
    this.m_ui.setPointerBusy(this.m_pressedButtons != 0u || this.m_context.input().primaryDown() || this.m_context.input().secondaryDown());
    UiPaintContext context(this.m_world, this.m_clipboard, this.m_textInput, this.m_cursor, this.m_accessibility, this.m_paint, this.m_text, this.m_display, this.m_ui);
    context.deltaSeconds = frameDelta;
    SortSequence<UiLiveRoot>(this.m_liveRoots, IsUiLiveRootOrderedBefore);
    for(in UiLiveRoot root : this.m_liveRoots){
        const Optional<mut UiPaintComponent> component = this.m_world.borrowComponent<UiPaintComponent>(root.entity);
        if(!component.has_value() || !component.value().visible || !component.value().paint.present())
            continue;
        WidgetRoot id;
        id.value = root.entity.id;
        if(!this.m_context.beginRoot(id))
            break;
        context.entity = root.entity;
        component.value().paint.invoke(context);
        if(!this.m_ui.balanced())
            this.m_context.fail();
        if(!this.m_context.endRoot())
            break;
    }
    if(!this.m_context.finishFrame()){
        error("UiLayerSystem: rejected unbalanced or invalid UI declarations");
        return Expected<void, CpuTaskAdmissionError>();
    }
    this.m_editHost.finishFrame();
    DrawSnapshot snapshot = this.m_paint.freeze();
    if(!this.m_renderer.submit(snapshot)){
        error("UiLayerSystem: GPU renderer rejected a new paint snapshot");
        this.abandonPendingFrame();
        abandon.release();
        return Expected<void, CpuTaskAdmissionError>();
    }
    this.m_paint.recycle(snapshot);
    abandon.release();
    return Expected<void, CpuTaskAdmissionError>();
}

[cpp_unwind]
void UiLayerSystem::collectRoots(){
    this.m_liveRoots.clear();
    this.m_rootIdentities.clear();
    for(in auto row : this.m_world.view<UiPaintComponent>()){
        const EntityID entity = Get<0>(row);
        if(!Get<1>(row).visible || !Get<1>(row).paint.present())
            continue;
        UiLiveRoot live;
        live.entity = entity;
        live.order = Get<1>(row).order;
        this.m_liveRoots.push_back(live);
        WidgetRoot identity;
        identity.value = entity.id;
        this.m_rootIdentities.push_back(identity);
    }

}

void UiLayerSystem::commitAcceptedFrameIfReady(){
    if(!this.m_context.ready() || this.m_renderer.lastAcceptedGeneration() != this.m_context.readyGeneration())
        return;
    const auto status = this.m_renderer.lastAcceptedPresentationStatus();
    if(status == PresentationReceiptStatus::Accepted){
        const b8 committed = this.m_context.commitFrame(this.m_renderer.lastAcceptedGeneration());
        [essential] assert(committed);
        this.m_editHost.commitFrame(this.m_renderer.lastAcceptedGeneration());
        this.m_editHost.synchronizeFocus();
        this.synchronizeCursor();
        this.synchronizeAccessibility();
    }
    else if(status == PresentationReceiptStatus::Rejected){
        this.abandonPendingFrame();
        this.m_editHost.synchronizeFocus();
        this.synchronizeCursor();
    }
}

void UiLayerSystem::synchronizeCursorForRouter(in PointerCursor routerCursor){
    PointerCursor resolved = this.m_context.frameCursor();
    if(resolved == PointerCursor::Default)
        resolved = routerCursor;
    const CursorShape desired = MapPointerCursorToCoreCursor(resolved);
    if(!this.m_cursorApplied || desired != this.m_lastAppliedCursor){
        if(this.m_cursor.setCursor(desired)){
            this.m_lastAppliedCursor = desired;
            this.m_cursorApplied = true;
        }
    }
}

void UiLayerSystem::synchronizeCursor(){
    this.synchronizeCursorForRouter(this.m_context.input().resolvedCursor());
}

void UiLayerSystem::synchronizeAccessibility(){
    mut AccessibleTree tree = this.m_context.accessibility();
    const u64 gen = tree.generation();
    if(gen == 0u)
        return;
    in InputRouter input = this.m_context.input();
    const WidgetId focused = input.focus();
    const WidgetId hovered = input.hover();
    WidgetId pressed;
    if(input.pressed(focused))
        pressed = focused;
    else if(input.pressed(input.capture()))
        pressed = input.capture();
    if(focused != tree.focusedId() || hovered != tree.hoveredId() || pressed != tree.pressedId())
        tree.updateInteractionState(focused, hovered, pressed);

    const u64 contentRev = tree.contentRevision();
    const b8 treeDirty =
        contentRev != this.m_lastPublishedA11yRevision
        || this.m_display.pixelScaleX != this.m_lastPublishedA11yScaleX
        || this.m_display.pixelScaleY != this.m_lastPublishedA11yScaleY
    ;
    b8 publishedOk = true;
    if(treeDirty){
        publishedOk = this.m_accessibility.publishTree(
            Span<AccessibilityNodeData>(tree.nodes()),
            tree.textStorage(),
            focused.value,
            gen,
            this.m_display.pixelScaleX,
            this.m_display.pixelScaleY
        );
        if(publishedOk){
            this.m_lastPublishedA11yRevision = contentRev;
            this.m_lastPublishedA11yGeneration = gen;
            this.m_lastPublishedA11yFocus = focused;
            this.m_lastPublishedA11yScaleX = this.m_display.pixelScaleX;
            this.m_lastPublishedA11yScaleY = this.m_display.pixelScaleY;
        }
    }
    else if(focused != this.m_lastPublishedA11yFocus){
        if(this.m_accessibility.updateFocus(focused.value))
            this.m_lastPublishedA11yFocus = focused;
    }

    if(publishedOk && gen != this.m_lastAnnouncedA11yGeneration){
        this.m_lastAnnouncedA11yGeneration = gen;
        const usize count = tree.announcementCount();
        for(usize index = 0u; index < count; ++index){
            in AccessibleAnnouncement entry = tree.announcementAt(index);
            const StringView text = tree.announcementText(entry);
            if(!text.empty() && !this.m_accessibility.announce(text, entry.liveMode))
                warning("UiLayerSystem: accessibility announcement failed");
        }
    }
}

void UiLayerSystem::pollAccessibilityActions(){
    b8 appliedAny = false;
    AccessibilityActionEvent action;
    for(usize count = 0u; count < s_AccessibilityMaxActions; ++count){
        if(!this.m_accessibility.pollAction(action))
            break;
        if(this.m_context.applyAccessibleAction(action))
            appliedAny = true;
    }
    if(appliedAny){
        this.synchronizeCursor();
        this.synchronizeAccessibility();
    }
}

void UiLayerSystem::synchronizeInput(){
    this.collectRoots();
    this.m_context.retainRoots(this.m_rootIdentities);
    this.commitAcceptedFrameIfReady();
    this.m_editHost.synchronizeFocus();
}


