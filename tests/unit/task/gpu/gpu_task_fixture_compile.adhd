[[nodiscard]] FOUNDATION_INLINE Core::GpuTaskGraphQueueAssignmentOptions MakeQueueAssignmentOptionsWithLoads(
    const Span<const Core::GpuTaskQueueLoad> loads
)noexcept{
    Core::GpuTaskGraphQueueAssignmentOptions options{};
    options.queueLoads = loads.data();
    options.queueLoadCount = loads.size();
    return options;
}

[[nodiscard]] FOUNDATION_INLINE b8 TryBuildResourceVersionDependencyEdges(
    const Core::GpuTaskGraph::DeclarationReadView& declarations,
    Core::Alloc::ScratchArena& scratchArena,
    Vector<Core::GpuTaskDependencyEdge, Core::Alloc::ScratchArena>& outEdges
){
    Vector<Core::GpuTaskDependencyEdge, Core::Alloc::ScratchArena> rawEdges(scratchArena);
    if(!Core::GpuTaskGraphCompilerDetail::BuildResourceVersionDependencyEdges(declarations, scratchArena, rawEdges).has_value())
        return false;
    for(const Core::GpuTaskDependencyEdge& edge : rawEdges)
        outEdges.push_back(edge);
    return true;
}

