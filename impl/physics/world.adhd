    public b8 setShapeEnableContactEvents(in ShapeId shapeId, in b8 enabled){
        if(!this.isValidShape(shapeId))
            return false;
        if(this.m_shapes[shapeId.index].enableContactEvents() == enabled)
            return true;
        this.m_shapes[shapeId.index].setFlag(ShapeFlags::EnableContactEvents, enabled);
        this.refreshShapeContactEventFlags(shapeId.index);
        return true;
    }

    public b8 setShapeEnableHitEvents(in ShapeId shapeId, in b8 enabled){
        if(!this.isValidShape(shapeId))
            return false;
        if(this.m_shapes[shapeId.index].enableHitEvents() == enabled)
            return true;
        this.m_shapes[shapeId.index].setFlag(ShapeFlags::EnableHitEvents, enabled);
        if(enabled)
            ++this.m_hitEventShapeCount;
        else if(this.m_hitEventShapeCount > 0u)
            --this.m_hitEventShapeCount;
        this.refreshShapeContactEventFlags(shapeId.index);
        return true;
    }

    public b8 setShapeEnableSensorEvents(in ShapeId shapeId, in b8 enabled){
        if(!this.isValidShape(shapeId))
            return false;
        mut Shape shape = this.m_shapes[shapeId.index];
        if(shape.enableSensorEvents() == enabled)
            return true;
        const b8 wasSensorEv = shape.isSensor() && shape.enableSensorEvents();
        shape.setFlag(ShapeFlags::EnableSensorEvents, enabled);
        const b8 nowSensorEv = shape.isSensor() && shape.enableSensorEvents();
        if(!wasSensorEv && nowSensorEv)
            ++this.m_sensorEventShapeCount;
        else if(wasSensorEv && !nowSensorEv && this.m_sensorEventShapeCount > 0u)
            --this.m_sensorEventShapeCount;
        if(shape.proxyKey != s_NullIndex)
            this.m_broadPhase.setNodeFlags(shape.proxyKey, this.computeShapeTreeNodeFlags(shape));
        this.refreshShapeContactEventFlags(shapeId.index);
        return true;
    }

    public b8 setShapeEnablePreSolveEvents(in ShapeId shapeId, in b8 enabled){
        if(!this.isValidShape(shapeId))
            return false;
        const u32 shapeIdx = shapeId.index;
        if(this.m_shapes[shapeIdx].enablePreSolveEvents() == enabled)
            return true;
        this.m_shapes[shapeIdx].setFlag(ShapeFlags::EnablePreSolveEvents, enabled);
        const u32 bodyIdx = this.m_shapes[shapeIdx].bodyId;
        if(bodyIdx < this.m_bodies.size() && this.m_bodies[bodyIdx].alive)
            this.wakeBody(this.makeBodyId(bodyIdx));
        this.wakeShapeNeighbors(shapeIdx);
        if(!enabled)
            this.refreshContactMaterialsForShape(shapeIdx);
        return true;
    }

