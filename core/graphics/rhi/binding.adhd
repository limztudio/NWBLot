    BindlessLayoutDesc setDescriptorSetIndex(...);
    BindlessLayoutDesc setLayoutType(...);
    BindlessLayoutDesc setMaxCapacity(...);
    BindlessLayoutDesc setVisibility(...);
};

[cpp_header("<core/graphics/rhi/binding.h>"), cpp_name("::NWB::Core::DescriptorWriteItem")]
