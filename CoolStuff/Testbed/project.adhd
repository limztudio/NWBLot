////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "ui_skin_preview.adhd"
#include "project_world_interop.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class Project : IProjectEntryCallbacks, IInputEventHandler{
    public Project(mut ProjectRuntimeContext context){
        this.m_context = context;
        this.m_world = CreateInitialWorldOrDie(context);
        this.m_sceneSubsystems = ActiveSceneSubsystems(context.objectArena);
        this.m_uiPreview = UiSkinPreview(context.objectArena);
    }

    public ~Project(){
        this.unregisterInputHandler();
        this.destroyWorld();
    }

    public b8 onStartup()override{
        if(!this.m_sceneSubsystems.loadProjectStartScene(this.m_context.assetManager))
            return false;
        if(!this.m_uiPreview.loadAssets(this.m_context.objectArena, this.m_context.assetManager, this.m_sceneSubsystems))
            return false;
        BindActiveSceneSubsystemsToWorld(this.m_world, this.m_sceneSubsystems);
        if(!CreateStartupCameraAndLights(this.m_world))
            return false;
        if(!this.createDefaultScene())
            return false;
        SyncWorldModelRuntimes(this.m_world);
        this.registerInputHandler();
        return true;
    }

    public void onShutdown()override{
        this.unregisterInputHandler();
        this.m_cameraInput.clear();
        this.destroyWorld();
        [essential] info("ProjectTestbed: shutdown");
    }

    public b8 onUpdate(in f32 delta)override{
        const f32 safeDelta = FlyCameraMotion().sanitizeDelta(delta);
        this.updateMainCamera(safeDelta);
        return TickProjectWorld(this.m_world, safeDelta);
    }

    public void windowFocusUpdate(in b8 focused)override{
        if(!focused)
            this.m_cameraInput.clear();
    }

    public void pointerCaptureLost()override{
        this.m_cameraInput.pointerCaptureLost();
    }

    public KeyboardInputResult keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods)override{
        if(action == CoreInputAction::Release)
            this.m_cameraInput.setKeyState(key, false);

        if(WantsUiKeyboard(this.m_world))
            return false;

        if(action == CoreInputAction::Press || action == CoreInputAction::Repeat)
            this.m_cameraInput.setKeyState(key, true);

        return false;
    }

    public b8 mousePosUpdate(in f64 xpos, in f64 ypos)override{
        this.m_cameraInput.updatePointer(xpos, ypos, WantsUiPointer(this.m_world));
        return false;
    }

    public b8 mouseButtonUpdate(in i32 button, in i32 action, in i32 mods)override{
        this.m_cameraInput.updateButton(
            WantsUiPointer(this.m_world),
            button == MouseButton::Right,
            action == CoreInputAction::Press,
            action == CoreInputAction::Release
        );
        return false;
    }

    public void paintUiLayer(mut UiPaintContext context){
        this.drawUiControls(context);
        this.m_uiPreview.paint(context);
    }

    private b8 createDefaultScene(){
        if(!InstantiateSceneSubsystemsEntities(this.m_sceneSubsystems, this.m_world)){
            error("ProjectTestbed initialization failed: failed to instantiate scene entities");
            return false;
        }

        AttachProjectUiPaintEntity(this.m_world, this);
        [essential] info("ProjectTestbed: startup scene created ({})", "45-degree directional + point light, female skinned character on a white ground plane");
        return true;
    }

    private void registerInputHandler(){
        if(this.m_inputRegistered)
            return;

        this.m_context.input.addHandlerToFront(this);
        this.m_inputRegistered = true;
    }

    private void unregisterInputHandler(){
        if(!this.m_inputRegistered)
            return;

        this.m_context.input.removeHandler(this);
        this.m_inputRegistered = false;
    }

    private void updateMainCamera(in f32 delta){
        const b8 pointerCaptured = WantsUiPointer(this.m_world);
        const FlyCameraPointerDelta mouseDelta = this.m_cameraInput.takePointerDelta(pointerCaptured);

        const b8 keyboardCaptured = WantsUiKeyboard(this.m_world);
        const VectorSingle moveAxes = FlyCameraMotion().buildMoveAxes(
            keyboardCaptured,
            this.m_cameraInput.keyPressed(Key::D),
            this.m_cameraInput.keyPressed(Key::A),
            this.m_cameraInput.keyPressed(Key::W),
            this.m_cameraInput.keyPressed(Key::S)
        );
        const b8 boosted = !keyboardCaptured && (this.m_cameraInput.keyPressed(Key::LeftShift) || this.m_cameraInput.keyPressed(Key::RightShift));

        ApplyFlyCameraInputToMainCamera(this.m_world, moveAxes, boosted, VectorSingle(mouseDelta.x, mouseDelta.y, 0.0f, 0.0f), delta);
    }

    private void destroyWorld(){
        DestroyInitialProjectWorld(this.m_context, this.m_world);
    }

    private void drawUiControls(mut UiPaintContext context){
        WindowOptions options = WindowOptions();
        options.initialBounds = Rect(s_GalleryMargin, s_GalleryMargin, s_OverviewWidth, s_OverviewHeight);
        options.contentHeightFirstUse = true;
        const Expected<Rect> gallery = this.m_uiPreview.galleryBounds(context);
        if(!gallery.has_value() || !CanShowTestbedOverviewWindow(gallery.value(), options.initialBounds))
            return;
        SeparatorOptions separator = SeparatorOptions();
        separator.thickness = 1.0f;
        if(context.ui.beginWindow("testbed_window", s_WindowTitleText, this.m_uiWindow, options)){
            const b8 declared = context.ui.label("renderer", s_RendererLine) && context.ui.separator("separator", separator) && context.ui.label("character", s_CharacterLine);
            [essential] assert(declared);
        }
        const b8 ended = context.ui.endWindow();
        [essential] assert(ended);
    }

    private mut ProjectRuntimeContext m_context;
    private NotNullUniquePtr<World> m_world;
    private ActiveSceneSubsystems m_sceneSubsystems;
    private UiSkinPreview m_uiPreview;
    private WindowState m_uiWindow = WindowState();
    private FlyCameraInput m_cameraInput = FlyCameraInput();
    private b8 m_inputRegistered = false;
}

native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB::ProjectFrameClientSize NWB::QueryProjectFrameClientSize(){
    return { s_DefaultProjectFrameClientWidth, s_DefaultProjectFrameClientHeight };
}

TStringView NWB::QueryProjectWindowTitle()noexcept{
    return Testbed::s_WindowTitle;
}

b8 NWB::ConfigureProjectRuntime(ProjectStartupContext& context)noexcept{
    Core::GraphicsRuntime& graphics = context.graphics;
    return graphics.setBindlessHeapAbi(Impl::AssetsGraphicsBindless::MakeGpuDescriptorHeapAbi()) && graphics.setHDR10OutputEnabled(true);
}

UniquePtr<NWB::IProjectEntryCallbacks> NWB::CreateProjectEntryCallbacks(NWB::ProjectRuntimeContext& context){
    return MakeUnique<Testbed::Project>(context);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

