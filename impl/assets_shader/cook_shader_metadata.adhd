#include <impl/assets_shader/shader_define_planner.adhd>
#include <impl/assets_shader/shader_types.adhd>
#include <impl/assets_shader/slang_compiler.adhd>
#include <impl/assets_shader/cook_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type ShaderDefineMap = HashMap<String, ShaderDefineEntry>;
type ShaderDefineCombo = HashMap<StringView, StringView>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ShaderDefineEntry{
    public Vector<String> values;
}

class ShaderIncludeEntry{
    public String source;
    public ShaderDefineMap defineValues;
}

class ShaderCookEntry{
    public String name;
    public StringView stage = "";
    public StringView archiveStage = "";
    public String entryPoint;
    public String source;
    public Vector<String> includeRoots;
    public ShaderDefineMap defineValues;
    public HashMap<String, String> implicitDefines;
    public ShaderOptimizationLevel optimizationLevel = ShaderOptimizationLevel::Default;
    public b8 rayQuery = false;
    public b8 emitMeshComputeShadow = true;

    public ShaderCookEntry(){ this.entryPoint.assign(s_DefaultEntryName); }
}

b8 ReadShaderDefineValues(in Path file, in MetascriptValue asset, mut ShaderDefineMap defines){
    const Optional<in MetascriptValue> field = asset.borrowField(s_ShaderDefinesField);
    if(!field.has_value())
        return true;
    if(!field.value().isMap()){
        error("Meta '{}': defines must be a map", file);
        return false;
    }
    return field.value().forEachMapEntry(lambda[in file, mut defines](in StringView key, in MetascriptValue value) -> b8{
        const ShaderDefineNameStatus status = ClassifyShaderDefineName(key);
        if(status == ShaderDefineNameStatus::Reserved){
            error("Meta '{}': define '{}' is an engine transport feature selected in shader source", file, key);
            return false;
        }
        if(status == ShaderDefineNameStatus::Invalid){
            error("Meta '{}': define '{}' must be an ASCII shader identifier", file, key);
            return false;
        }
        mut ShaderDefineEntry definition = GetOrCreateTextRecord<ShaderDefineEntry>(defines, key);
        if(!value.copyStringList(definition.values)){
            error("Meta '{}': define '{}' values must be a list of strings", file, key);
            return false;
        }
        b8 valid = !definition.values.empty();
        for(in String text : definition.values){
            if(!IsValidShaderDefineValueText(text)){
                valid = false;
                break;
            }
        }
        if(valid)
            return true;
        Vector<StringView> values;
        values.reserve(definition.values.size());
        for(in String text : definition.values)
            values.push_back(StringView(text));
        return ValidateShaderDefineEntrySpec(PathToString(file), key, values);
    });
}

b8 ReadShaderFields(in Path file, in MetascriptValue asset, in ShaderType type, mut ShaderCookEntry entry){
    const Expected<String> source = ReadPairedMetadataSource(file);
    if(!source.has_value())
        return false;
    entry.source.assign(StringView(source.value()));
    if(!CheckMetadataSourceExtension(file, entry.source, s_SlangSourceExtension, s_ShaderDiagnosticPrefix))
        return false;
    entry.stage = ArchiveStageTextFromShaderType(type);
    if(entry.stage.empty() && !ValidateDerivedShaderStageText(PathToString(file), entry.stage))
        return false;
    entry.archiveStage = entry.stage;
    if(!ValidateMetadataAssetFields(file, asset, s_ShaderMetaDiagnosticPrefix, lambda[in type](in StringView key) -> b8{
        return IsAllowedShaderMetadataField(key, type == ShaderType::MeshStage);
    }))
        return false;
    if(!ReadOptionalMetadataBoolField(file, asset, s_ShaderOptionalBoolMetaPrefix, s_ShaderRayQueryField, entry.rayQuery))
        return false;
    const Expected<MetadataStringField> optimization = ReadMetadataStringField(file, asset, s_ShaderMetaDiagnosticPrefix, s_ShaderOptimizationLevelField, false);
    if(!optimization.has_value())
        return false;
    if(optimization.value().present){
        const Expected<ShaderOptimizationLevel> level = TryParseShaderOptimizationLevelText(optimization.value().text);
        if(!level.has_value()){
            error("Shader meta '{}': unsupported optimization_level '{}'", file, optimization.value().text);
            return false;
        }
        entry.optimizationLevel = level.value();
    }
    const Expected<MetadataStringField> entryPoint = ReadMetadataStringField(file, asset, s_ShaderMetaDiagnosticPrefix, s_ShaderEntryPointField, false);
    if(!entryPoint.has_value())
        return false;
    entry.entryPoint.assign(entryPoint.value().text);
    if(entry.entryPoint.empty() && !ValidateNonEmptyShaderEntryPoint(PathToString(file), entry.entryPoint))
        return false;
    if(!ReadOptionalMetadataBoolField(file, asset, s_ShaderOptionalBoolMetaPrefix, s_ShaderEmitMeshComputeShadowField, entry.emitMeshComputeShadow))
        return false;
    const Optional<in MetascriptValue> roots = asset.borrowField(s_ShaderIncludeRootsField);
    if(roots.has_value()){
        if(!roots.value().copyStringList(entry.includeRoots)){
            error("Shader meta '{}': include_roots must be a list of strings", file);
            return false;
        }
        for(in String root : entry.includeRoots){
            if(root.empty()){
                Vector<StringView> views;
                views.reserve(entry.includeRoots.size());
                for(in String includeRoot : entry.includeRoots)
                    views.push_back(StringView(includeRoot));
                if(!ValidateShaderIncludeRoots(PathToString(file), views))
                    return false;
                break;
            }
        }
    }
    return ReadShaderDefineValues(file, asset, entry.defineValues);
}

Expected<ShaderCookEntry> ReadShaderMetadata(in Path file, in MetascriptDocument document){
    const Optional<StringView> declaration = document.declarationType(s_MetadataAssetVariable);
    if(!declaration.has_value()){
        error("Shader meta '{}': missing asset declaration '{}'", file, s_MetadataAssetVariable);
        return MakeUnexpected(Failure());
    }
    const ShaderType type = ShaderTypeFromAssetTypeText(declaration.value());
    if(type == ShaderType::Invalid){
        error("Shader meta '{}': unsupported shader asset type '{}'", file, declaration.value());
        return MakeUnexpected(Failure());
    }
    ShaderCookEntry entry;
    if(!VisitMetadataAssetMap(file, document, s_ShaderDiagnosticPrefix, lambda[in file, in type, mut entry](in MetascriptValue asset) -> b8{
        return ReadShaderFields(file, asset, type, entry);
    }))
        return MakeUnexpected(Failure());
    return entry;
}

Expected<ShaderIncludeEntry> ReadShaderIncludeMetadata(in Path file, in MetascriptDocument document){
    ShaderIncludeEntry entry;
    const Optional<StringView> declaration = document.declarationType(s_MetadataAssetVariable);
    if(!declaration.has_value()){
        error("Include meta '{}': missing asset declaration '{}'", file, s_MetadataAssetVariable);
        return MakeUnexpected(Failure());
    }
    if(!IsIncludeShaderAssetType(declaration.value(), s_ShaderAssetTypeInclude))
        return entry;
    const Expected<String> source = ReadPairedMetadataSource(file);
    if(!source.has_value())
        return MakeUnexpected(Failure());
    entry.source.assign(StringView(source.value()));
    if(!CheckMetadataSourceExtension(file, entry.source, s_SlangIncludeExtension, s_IncludeDiagnosticPrefix))
        return MakeUnexpected(Failure());
    if(!VisitMetadataAssetMap(file, document, s_IncludeDiagnosticPrefix, lambda[in file, mut entry](in MetascriptValue asset) -> b8{
        return ValidateMetadataAssetFields(file, asset, s_IncludeMetaDiagnosticPrefix, lambda[](in StringView key) -> b8{ return IsAllowedIncludeMetadataField(key); })
            && ReadShaderDefineValues(file, asset, entry.defineValues);
    }))
        return MakeUnexpected(Failure());
    return entry;
}


