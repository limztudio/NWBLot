void VerifyMetadataRegistryStorage_TypedGrowthPreservesInputOrderAndDoesNotReserveUnusedBuckets(){
    AssetArena fixtureArena(s_AssetCaseTestsMetadataRegistryFixture);
    AssetArena parseArena(s_AssetCaseTestsMetadataRegistryOutput);
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);

    CpuTaskScheduler cpuScheduler(0u);
    const GraphicsTestPath root = JoinGraphicsPath2(GetAssetArenaRepoRoot(fixtureArena), s_BuildDirectory, "metadata_registry_storage");
    ASSERT_TRUE(EnsureDirectories(root).has_value());

    DiscoveredNwbFileVector files(fixtureArena);
    files.reserve(s_MetadataRegistrySamplerCount + 1u);
    const StringView samplerFields = "sampler asset;\r\nasset.min_filter = \"linear\";\r\nasset.mag_filter = \"linear\";\r\nasset.mip_filter = \"linear\";\r\nasset.address_u = \"wrap\";\r\nasset.address_v = \"wrap\";\r\nasset.address_w = \"wrap\";\r\nasset.reduction = \"standard\";\r\nasset.max_anisotropy = 1.0;\r\n";
    for(usize index = 0u; index < s_MetadataRegistrySamplerCount; ++index){
        const usize identity = (index * 37u) % s_MetadataRegistrySamplerCount;
        AppendMetadataRegistrySamplerFile(fixtureArena, root, samplerFields, identity, files);
    }

    for(u32 passIndex = 0u; passIndex < 2u; ++passIndex){
        const b8 rejectDuplicate = passIndex == 1u;
        if(rejectDuplicate)
            files.push_back(files[0u]);
        VerifyMetadataRegistryStoragePass(fixtureArena, parseArena, root, files, cpuScheduler, s_MetadataRegistrySamplerCount, rejectDuplicate);
        EXPECT_EQ(parseArena.memoryStats().usedBytes, 0u);
        if(rejectDuplicate)
            EXPECT_TRUE(SawCapturedError(logger, "duplicate property asset virtual path"));
        else
            EXPECT_EQ(logger.errorCount(), 0u);
    }
}

