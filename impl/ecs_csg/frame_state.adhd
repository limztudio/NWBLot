#include <impl/ecs_csg/frame_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


interface ICsgReceiverVisibility{
    b8 visible(mut World world, in EntityID entity, in CsgReceiverKind kind, in CsgReceiverComponent receiver)const;
}

class CsgReceiverVisibility{
    public in ICsgReceiverVisibility filter;

    public CsgReceiverVisibility(in ICsgReceiverVisibility filter){
        this.filter = filter;
    }
}

class CsgFrameBuildDesc{
    public Optional<CsgReceiverVisibility> visibility;
    public b8 includeOpaquePass = true;
    public b8 includeTransparentPass = true;
}

class CsgFrameCutterRef{
    public EntityID entity;
    public in CsgCutterComponent cutter;

    public CsgFrameCutterRef(in EntityID entity, in CsgCutterComponent cutter){
        this.entity = entity;
        this.cutter = cutter;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(is_standard_layout<CsgReceiverComponent>(), "CsgReceiverComponent must stay layout-stable for ECS storage");
static_assert(is_trivially_copyable<CsgReceiverComponent>(), "CsgReceiverComponent must stay cheap to move in dense ECS storage");
static_assert(is_standard_layout<StaticCsgMeshComponent>(), "StaticCsgMeshComponent must stay layout-stable for ECS storage");
static_assert(is_trivially_copyable<StaticCsgMeshComponent>(), "StaticCsgMeshComponent must stay cheap to move in dense ECS storage");
static_assert(is_standard_layout<SkinnedCsgMeshComponent>(), "SkinnedCsgMeshComponent must stay layout-stable for ECS storage");
static_assert(is_trivially_copyable<SkinnedCsgMeshComponent>(), "SkinnedCsgMeshComponent must stay cheap to move in dense ECS storage");
static_assert(is_standard_layout<CsgReceiverDrawState>(), "CsgReceiverDrawState must stay layout-stable for frame handoff");
static_assert(is_trivially_copyable<CsgReceiverDrawState>(), "CsgReceiverDrawState must stay cheap to pass by value");
static_assert(is_standard_layout<CsgFrameState>(), "CsgFrameState must stay layout-stable for frame handoff");
static_assert(is_trivially_copyable<CsgFrameState>(), "CsgFrameState must stay cheap to pass by value");
static_assert(is_standard_layout<CsgFrameCutterRange>(), "CsgFrameCutterRange must stay layout-stable for frame handoff");
static_assert(is_trivially_copyable<CsgFrameCutterRange>(), "CsgFrameCutterRange must stay cheap to pass by value");
static_assert(is_standard_layout<CsgFrameCutterRangeEntry>(), "CsgFrameCutterRangeEntry must stay layout-stable for frame handoff");
static_assert(is_trivially_copyable<CsgFrameCutterRangeEntry>(), "CsgFrameCutterRangeEntry must stay cheap to pass by value");
static_assert(is_standard_layout<CsgFrameBuildDesc>(), "CsgFrameBuildDesc must stay layout-stable");
static_assert(is_trivially_copyable<CsgFrameBuildDesc>(), "CsgFrameBuildDesc must stay cheap to pass by value");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CsgFrameReceiverLookup : NoCopy{
    private mut World m_world;
    private HashMap<Name, CsgFrameCutterRangeEntry> m_cutterRanges;
    private Vector<Optional<CsgFrameCutterRef>> m_cutterRefs;

    public CsgFrameReceiverLookup(mut World world){
        this.m_world = world;
        const auto cutterView = world.view<CsgCutterComponent>();
        this.m_cutterRanges.reserve(cutterView.candidateCount());
        for(in auto row : cutterView)
            this.countCutter(Get<1>(row));

        u32 firstCutter = 0u;
        for(in auto group : this.m_cutterRanges){
            mut CsgFrameCutterRangeEntry entry = this.m_cutterRanges[group.first];
            entry.range.firstCutter = firstCutter;
            firstCutter = AddSaturating<u32>(firstCutter, entry.range.cutterCount);
        }

        if(firstCutter > 0u){
            this.m_cutterRefs.resize(cast<usize>(firstCutter));
            for(in auto row : cutterView)
                this.indexCutter(Get<0>(row), Get<1>(row));
        }
    }

    private void countCutter(in CsgCutterComponent cutter){
        if(!IsActiveCsgCutter(cutter))
            return;
        mut CsgFrameCutterRangeEntry entry = this.m_cutterRanges[cutter.receiverGroup];
        entry.range.cutterCount = AddSaturating<u32>(entry.range.cutterCount, 1u);
    }

    private void indexCutter(in EntityID entity, in CsgCutterComponent cutter){
        if(!IsActiveCsgCutter(cutter))
            return;
        mut CsgFrameCutterRangeEntry entry = this.m_cutterRanges[cutter.receiverGroup];
        if(entry.writtenCount >= entry.range.cutterCount)
            return;
        const usize index = cast<usize>(entry.range.firstCutter + entry.writtenCount);
        assert(index < this.m_cutterRefs.size());
        this.m_cutterRefs[index] = CsgFrameCutterRef(entity, cutter);
        ++entry.writtenCount;
    }

    public b8 empty()const{
        return this.m_cutterRanges.empty();
    }

    public u32 cutterCount()const{
        return cast<u32>(this.m_cutterRefs.size());
    }

    public Expected<CsgReceiverDrawState> resolveReceiverDrawState(in EntityID entity, in CsgReceiverPass receiverPass)const{
        const Expected<CsgResolvedReceiver> resolved = ResolveCsgReceiverComponent(this.m_world, entity);
        if(!resolved.has_value())
            return MakeUnexpected(Failure());
        in CsgResolvedReceiver receiver = resolved.value();
        if(!receiver.receiver.enabled || !IsCsgReceiverPassEnabled(receiver.receiver, receiverPass))
            return MakeUnexpected(Failure());
        const auto found = this.m_cutterRanges.find(receiver.receiver.receiverGroup);
        if(found == this.m_cutterRanges.end() || found.value().range.cutterCount == 0u)
            return MakeUnexpected(Failure());
        return MakeCsgReceiverDrawState(receiver.receiverKind, found.value().range);
    }

    public Span<Optional<CsgFrameCutterRef>> receiverCutters(in CsgReceiverDrawState drawState)const{
        if(!drawState.active || drawState.cutterCount == 0u)
            return Span<Optional<CsgFrameCutterRef>>();
        if(!IsValidCsgReceiverDrawRange(drawState, this.m_cutterRefs.size())){
            assert(false);
            return Span<Optional<CsgFrameCutterRef>>();
        }
        const Span<Optional<CsgFrameCutterRef>> cutters = Span<Optional<CsgFrameCutterRef>>(this.m_cutterRefs);
        return cutters.subspan(drawState.firstCutter, drawState.cutterCount);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void GatherCsgReceiverState<ReceiverT>(
    mut World world,
    in CsgReceiverKind kind,
    in CsgFrameReceiverLookup lookup,
    in CsgFrameBuildDesc desc,
    mut CsgFrameState state
){
    for(in auto row : world.view<ReceiverT>()){
        const EntityID entity = Get<0>(row);
        const CsgReceiverComponent receiver = Get<1>(row).asReceiver();
        if(!receiver.enabled)
            continue;
        if(desc.visibility.has_value() && !desc.visibility.value().filter.visible(world, entity, kind, receiver))
            continue;
        u32 cutterCount = 0u;
        b8 opaqueWork = false;
        b8 transparentWork = false;
        if(desc.includeOpaquePass){
            const Expected<CsgReceiverDrawState> opaque = lookup.resolveReceiverDrawState(entity, CsgReceiverPass::Opaque);
            if(opaque.has_value() && opaque.value().receiverKind == kind){
                cutterCount = opaque.value().cutterCount;
                opaqueWork = true;
            }
        }
        if(desc.includeTransparentPass){
            const Expected<CsgReceiverDrawState> transparent = lookup.resolveReceiverDrawState(entity, CsgReceiverPass::Transparent);
            if(transparent.has_value() && transparent.value().receiverKind == kind){
                cutterCount = transparent.value().cutterCount;
                transparentWork = true;
            }
        }
        if(opaqueWork || transparentWork)
            AddCsgFrameReceiverWork(kind, opaqueWork, transparentWork, cutterCount, state);
    }
}

CsgFrameState BuildCsgFrameState(mut World world, in CsgFrameBuildDesc desc){
    CsgFrameState state = CsgFrameState();
    if(!HasCsgFrameCandidates(world))
        return state;
    const CsgFrameReceiverLookup lookup = CsgFrameReceiverLookup(world);
    if(!lookup.empty()){
        GatherCsgReceiverState<StaticCsgMeshComponent>(world, CsgReceiverKind::Static, lookup, desc, state);
        GatherCsgReceiverState<SkinnedCsgMeshComponent>(world, CsgReceiverKind::Skinned, lookup, desc, state);
        FinalizeCsgFrameState(state);
    }
    return state;
}

CsgFrameState BuildCsgFrameState(mut World world){
    return BuildCsgFrameState(world, CsgFrameBuildDesc());
}


