#include <impl/ecs_render/optics/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class OpticalSceneIdentityBuilder{
    public u64 baseHash(
        in RayTracingOpticalSceneHeaderGpu header,
        in Span<RayTracingOpticalInstanceGpu> instances,
        in b8 hasRuntimeBounds,
        in b8 boundsCompleteExceptRuntime
    )const{
        u64 hash = 14695981039346656037ul;
        hash = UpdateFnv64U32(hash, bit_cast<u32>(header.boundsMin.x));
        hash = UpdateFnv64U32(hash, bit_cast<u32>(header.boundsMin.y));
        hash = UpdateFnv64U32(hash, bit_cast<u32>(header.boundsMin.z));
        hash = UpdateFnv64U32(hash, header.transparentCount);
        hash = UpdateFnv64U32(hash, bit_cast<u32>(header.boundsMax.x));
        hash = UpdateFnv64U32(hash, bit_cast<u32>(header.boundsMax.y));
        hash = UpdateFnv64U32(hash, bit_cast<u32>(header.boundsMax.z));
        hash = UpdateFnv64U32(hash, header.flags);
        for(in RayTracingOpticalInstanceGpu instance : instances){
            hash = UpdateFnv64U32(hash, instance.entityId);
            hash = UpdateFnv64U32(hash, bit_cast<u32>(instance.mediumPriority));
            hash = UpdateFnv64U32(hash, instance.boundaryMode);
            hash = UpdateFnv64U32(hash, instance.flags);
        }
        if(hasRuntimeBounds){
            u8 completeByte = 0u;
            if(boundsCompleteExceptRuntime)
                completeByte = 1u;
            hash = UpdateFnv64Byte(hash, completeByte);
        }
        return hash;
    }

    public u64 updateRuntimeBounds(
        in u64 hash,
        in MatrixSingle objectToWorld,
        in u32 instanceIndex
    )const{
        u64 result = hash;
        for(u32 rowIndex = 0u; rowIndex < 3u; ++rowIndex){
            const VectorSingle row = objectToWorld[rowIndex];
            result = UpdateFnv64U32(result, bit_cast<u32>(row.x));
            result = UpdateFnv64U32(result, bit_cast<u32>(row.y));
            result = UpdateFnv64U32(result, bit_cast<u32>(row.z));
            result = UpdateFnv64U32(result, bit_cast<u32>(row.w));
        }
        return UpdateFnv64U32(result, instanceIndex);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
