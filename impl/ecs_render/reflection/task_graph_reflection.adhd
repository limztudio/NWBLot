#include <impl/ecs_render/raytrace/raytracing_system.adhd>
#include <impl/ecs_render/reflection/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ReflectionGraphInputs{
    public mut RendererRayTracingSystem raytracingSystem;
    public GpuGraphResourceId opaqueDepth;
    public GpuGraphResourceId opaqueColor;
    public Span<GpuTaskResourceUse> surfaceReads;
    public Span<GpuTaskResourceUse> hardwareReads;
    public Span<GpuTaskResourceSetUse> hardwareSetReads;
    public in b8 hardwarePreparationReady;
    public mut b8 hardwareDispatchLogged;
    public mut b8 fallbackDispatchLogged;

    public ReflectionGraphInputs(
        mut RendererRayTracingSystem raytracingSystem,
        in borrow b8 hardwarePreparationReady,
        mut b8 hardwareDispatchLogged,
        mut b8 fallbackDispatchLogged
    ){
        this.raytracingSystem = raytracingSystem;
        this.hardwarePreparationReady = hardwarePreparationReady;
        this.hardwareDispatchLogged = hardwareDispatchLogged;
        this.fallbackDispatchLogged = fallbackDispatchLogged;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<Name, ErrorCode> BuildReflectionCsgHardwareSliceIdentity(in u32 slice){
    const Expected<NameHash> derivedHash = BeginDerivedNameHash(s_ReflectionCsgHardwareSliceFamily);
    if(!derivedHash.has_value())
        return MakeUnexpected(MakeErrorCode(ErrorCondition::invalid_argument));
    NameHash hash = derivedHash.value();
    if(!UpdateDerivedNameHashDecimal(hash, slice))
        return MakeUnexpected(MakeErrorCode(ErrorCondition::invalid_argument));
    const Expected<Name> identity = FinishDerivedNameHash(hash);
    if(!identity.has_value())
        return MakeUnexpected(MakeErrorCode(ErrorCondition::invalid_argument));
    return identity.value();
}

Expected<Name, ErrorCode> ReflectionCsgHardwareSliceIdentity(in u32 slice){
    return BuildReflectionCsgHardwareSliceIdentity(slice);
}


