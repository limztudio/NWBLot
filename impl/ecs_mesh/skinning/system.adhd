////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_scene/asset.adhd>
#include <impl/ecs_scene/hierarchy.adhd>
#include <impl/ecs_skeleton/components.adhd>
#include <impl/ecs_mesh/runtime/mesh.adhd>
#include <impl/ecs_mesh/skinning/graph_dispatch_plan.adhd>
#include <impl/ecs_mesh/skinning/graph_resource_uses.adhd>
#include <impl/ecs_mesh/skinning/local_bounds.adhd>
#include <impl/ecs_mesh/skinning/timing_names.adhd>
#include <impl/ecs_mesh/skinning/runtime_cache.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type MeshSkinningShaderPathResolveCallback = ShaderArchivePathResolver;
type MeshSkinningRuntimeResourceMap = HashMap<u64, MeshSkinningRuntimeResources>;
type MeshSkinningBufferVector = Vector<BufferHandle>;

class CachedSkinningSkeletonPoseEntry{
    public usize offset = 0u;
    public usize count = 0u;
    public u32 skinningMode = cast<u32>(SkeletonSkinningMode::LinearBlend);
    public b8 valid = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[system("mesh_skinning")]
class MeshSkinningSystem : IRenderPass, IRuntimeMeshProvider{
    private GpuTaskGraph m_frameTaskGraph;
    private GpuCompiledGraph m_frameCompiledGraph;
    private GpuTaskGraphAnalysis m_frameTaskGraphAnalysis;
    private GpuGraphSubmissionTransaction m_frameSubmissionTransaction;
    private GpuPersistentResourceStateCache m_acceptedSkinningState;
    private GpuTaskGraphQueueAssignments m_frameTaskGraphQueueAssignments;
    private GpuRecordedGraph m_frameRecordedGraph;
    public BindingLayoutHandle m_skinningBindingLayout;
    public ShaderHandle m_skinningComputeShader;
    public ComputePipelineHandle m_skinningComputePipeline;
    public BindingLayoutHandle m_boundsBindingLayout;
    public ShaderHandle m_boundsComputeShader;
    public ComputePipelineHandle m_boundsComputePipeline;
    public ShaderHandle m_localBoundsComputeShader;
    public ComputePipelineHandle m_localBoundsComputePipeline;
    public BindingLayoutHandle m_repackBindingLayout;
    public ShaderHandle m_repackComputeShader;
    public ComputePipelineHandle m_repackComputePipeline;
    public mut World m_world;
    private mut GraphicsRuntime m_graphics;
    private mut AssetManager m_assetManager;
    private mut IRuntimeMeshRegistry m_runtimeMeshRegistry;
    private MeshSkinningShaderPathResolveCallback m_shaderPathResolver;
    public MeshSkinningRuntimeCache m_runtimeMeshCache;
    private ActiveSceneSubsystems m_defaultSceneSubsystems;
    private ActiveSceneSubsystemsRef m_activeSceneSubsystems;
    public MeshSkinningRuntimeResourceMap m_runtimeResources;
    private Vector<MeshSkinningGraphDispatchPlan> m_frameDispatchPlans;
    private Vector<MeshSkinningGraphDispatchPlan> m_frameDeformationPlans;
    private Vector<MeshSkinningLocalBoundsDispatch> m_frameLocalBoundsDispatches;
    private MeshSkinningBufferVector m_frameLiveBuffers;
    private HashSet<BufferHandle> m_frameLiveBufferIndex;
    private MeshSkinningGraphResourceUseScratch m_frameResourceUsesScratch;
    public RuntimeSkinPayloadScratch m_framePayloadScratch;
    public Vector<SkeletonJointMatrix> m_frameCachedPoseJoints;
    public HashMap<EntityID, CachedSkinningSkeletonPoseEntry> m_frameCachedPoses;
    public SceneEntityNameIndex m_frameSceneNameIndex;
    public b8 m_frameSceneNameIndexBuilt = false;
    public u64 m_lastSceneNamePoolVersion = 0u;
    public HashSet<SceneEntityNameQueryKey> m_unresolvedSkeletonQueries;
    private Vector<GpuTaskId> m_frameUploadTasks;
    private b8 m_runtimeSetupReady = false;
    private u64 m_runtimeTopologyGeneration = 1u;
    private u64 m_acceptedSkinningStateTopologyGeneration = 0u;
    private u64 m_cachedCacheTopologyGeneration = 0u;

    public MeshSkinningSystem(
        mut World world,
        mut GraphicsRuntime graphics,
        mut AssetManager assetManager,
        mut IRuntimeMeshRegistry runtimeMeshRegistry,
        in MeshSkinningShaderPathResolveCallback shaderPathResolver
    ){
        this.m_world = world;
        this.m_graphics = graphics;
        this.m_assetManager = assetManager;
        this.m_runtimeMeshRegistry = runtimeMeshRegistry;
        this.m_shaderPathResolver = shaderPathResolver;
        this.m_runtimeMeshCache = MeshSkinningRuntimeCache(graphics, assetManager);
        this.m_frameTaskGraph = world.makeSystemResource<GpuTaskGraph>();
        this.m_frameCompiledGraph = world.makeSystemResource<GpuCompiledGraph>();
        this.m_frameTaskGraphAnalysis = world.makeSystemResource<GpuTaskGraphAnalysis>();
        this.m_frameSubmissionTransaction = world.makeSystemResource<GpuGraphSubmissionTransaction>();
        this.m_acceptedSkinningState = world.makeSystemResource<GpuPersistentResourceStateCache>();
        this.m_frameTaskGraphQueueAssignments = world.makeSystemResource<GpuTaskGraphQueueAssignments>();
        this.m_frameRecordedGraph = world.makeSystemResource<GpuRecordedGraph>();
        this.writeAccess<SkinnedMeshBindingComponent>();
        this.readAccess<SkeletonJointPaletteComponent>();
        this.readAccess<SkeletonPoseComponent>();
        this.readAccess<SceneEntityNameComponent>();
        runtimeMeshRegistry.registerRuntimeMeshProvider(this);
    }
    public ~MeshSkinningSystem(){
        {
            const GpuCompiledGraphReadView planAccess(this.m_frameCompiledGraph);
            this.resolveFrameTaskGraphAttempt(planAccess);
        }
        this.m_frameTaskGraph.reset();
        this.m_runtimeMeshRegistry.unregisterRuntimeMeshProvider(this);
    }

    public void prepare(mut World world)override;
    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta)override{
        return Expected<void, CpuTaskAdmissionError>();
    }
    public b8 validateResources(in u32 width, in u32 height, in u32 sampleCount)override{
        if(width == 0u || height == 0u)
            return true;
        if(!this.ensureActiveSceneSubsystems())
            return false;
        if(!this.isSkinningFeatureEnabled())
            return true;

        mut Device device = this.m_graphics.getDevice();
        mut GpuTimingRecorder timing = this.m_graphics.gpuTiming();

        const b8 timingReady =
            timing.prepareScopeQueries(s_TimingScopeMeshSkinning.identity, device, s_PerRuntimeMeshTimingQueries)
            && timing.prepareScopeQueries(s_TimingScopeMeshSkinningMeshletBounds.identity, device, s_PerRuntimeMeshTimingQueries)
            && timing.prepareScopeQueries(s_TimingScopeMeshSkinningLocalBounds.identity, device, s_PerRuntimeMeshTimingQueries)
            && timing.prepareScopeQueries(s_TimingScopeMeshSkinningRepackNormals.identity, device, s_PerRuntimeMeshTimingQueries)
        ;
        if(!timingReady)
            warning("MeshSkinningSystem: GPU timing scope preparation failed; timing samples may be skipped");

        if(!this.ensureSkinningPipeline() || !this.ensureBoundsPipeline() || !this.ensureLocalBoundsPipeline() || !this.ensureRepackPipeline()){
            error("MeshSkinningSystem: failed to create skinning pipelines during resource validation");
            return false;
        }
        return true;
    }
    public b8 prepareResources(in FramebufferPtr framebuffer)override;
    public void render(in FramebufferPtr framebuffer)override{
        if(!this.isSkinningFeatureEnabled())
            return;
        if(!this.submitFrameSkinningGraph())
            warning("MeshSkinningSystem: skipped skinning because graph-owned work was not accepted");
    }
    public void invalidateResources()override;

    public Expected<RuntimeMeshDesc> resolveRuntimeMesh(in EntityID entity)override;
    public b8 hasRuntimeMeshBinding(in EntityID entity)const override{
        return this.m_world.hasComponent<SkinnedMeshBindingComponent>(entity);
    }
    public void markLiveRuntimeMeshes(mut RuntimeMeshRequestSet requests)override;

    public void setActiveSceneSubsystems(in ActiveSceneSubsystemsRef subsystems){
        this.m_activeSceneSubsystems = subsystems;
    }
    public b8 isSkinningFeatureEnabled()const;

    private b8 ensureActiveSceneSubsystems();
    private b8 ensureSkinningPipeline();
    private b8 ensureBoundsPipeline();
    private b8 ensureLocalBoundsPipeline();
    private b8 ensureRepackPipeline();
    private b8 skinningPipelineReady()const{
        return this.m_skinningBindingLayout.valid() && this.m_skinningComputePipeline.valid();
    }
    private b8 boundsPipelinesReady()const{
        return this.m_boundsBindingLayout.valid() && this.m_boundsComputePipeline.valid() && this.m_localBoundsComputePipeline.valid();
    }
    private b8 repackPipelineReady()const{
        return this.m_repackBindingLayout.valid() && this.m_repackComputePipeline.valid();
    }
    private b8 submitFrameSkinningGraph();
    private b8 prepareRuntimeMeshResources(mut MeshSkinningRuntimeInstance instance){
        instance.deformationState.invalidateCurrent();
        if(instance.meshlets.empty())
            return true;
        if(!AreMeshSkinningRuntimePipelinesReady(this.skinningPipelineReady(), this.boundsPipelinesReady(), instance.attributeBuffer.valid(), this.repackPipelineReady()))
            return false;

        const Expected<b8> resourcesChanged = this.ensureRuntimeResources(instance);
        if(!resourcesChanged.has_value())
            return false;
        if(resourcesChanged.value()){
            mut RuntimeMeshDirtyFlag dirtyFlags = instance.dirtyFlags;
            MarkRebuiltRuntimeMeshDirtyFlags(dirtyFlags);
            instance.dirtyFlags = dirtyFlags;
            ++this.m_runtimeTopologyGeneration;
        }
        return true;
    }
    public b8 recordGraphOwnedSkinningDeformationBatch(in Span<MeshSkinningGraphDispatchPlan> plans, in GpuTaskRecordContext context, mut CommandList commandList);
    public b8 recordGraphOwnedSkinningPostDispatchBatch(in Span<MeshSkinningGraphDispatchPlan> plans, in GpuTaskRecordContext context, mut CommandList commandList);
    public void confirmGraphOwnedSkinningDispatch(in MeshSkinningGraphDispatchPlan plan);
    private void collectLiveSkinningStateBuffers();
    private b8 replaceAcceptedSkinningState(in CommandListResourceStateHandoff state);
    private Expected<b8> ensureRuntimeResources(mut MeshSkinningRuntimeInstance instance);
    private b8 createRuntimeResourceBindlessHeapHandles(mut MeshSkinningRuntimeInstance instance, mut MeshSkinningRuntimeResources resources);
    public void releaseRuntimeResourceBindlessHeapHandles(mut MeshSkinningRuntimeResources resources){
        mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
        if(heap.isInitialized()){
            if(resources.bindlessHeapHandles.resourceSlots.valid())
                heap.free(resources.bindlessHeapHandles.resourceSlots);
            resources.bindlessHeapHandles.resourceSlots = GpuDescriptorHandleInvalid();
            for(mut GpuDescriptorHandle handle : resources.bindlessHeapHandles.storageBuffers){
                if(handle.valid())
                    heap.free(handle);
                handle = GpuDescriptorHandleInvalid();
            }
        }
        resources.bindlessHeapHandles = MeshSkinningRuntimeBindlessHeapHandles();
        resources.bindlessResourceSlots = MeshSkinningBindlessResourceSlots();
        resources.bindlessResourceSlotsUploaded = false;
    }
    public void resetFrameScratchResources(){
        this.m_framePayloadScratch.reset(cast<u32>(SkeletonSkinningMode::LinearBlend));
        this.m_frameCachedPoseJoints.clear();
        this.m_frameCachedPoses.clear();
        this.m_frameSceneNameIndex.clear();
        this.m_frameSceneNameIndexBuilt = false;
        this.m_frameResourceUsesScratch.clear();
        this.m_frameLiveBufferIndex.clear();
    }
    private b8 pruneRuntimeResources();
    private void resolveFrameTaskGraphAttempt(in GpuCompiledGraphReadView planAccess){
        if(!planAccess.valid())
            return;
        const u64 recordingAttemptGeneration = this.m_frameRecordedGraph.recordingAttemptGeneration();
        if(recordingAttemptGeneration != 0u && !this.m_frameSubmissionTransaction.discardUnaccepted(this.m_frameTaskGraph, this.m_frameCompiledGraph, recordingAttemptGeneration))
            [essential] assert(false, "skinning task-graph reset must resolve every unaccepted packet");
    }
    private void resetPipelineResources(){
        this.m_skinningBindingLayout.reset();
        this.m_skinningComputeShader.reset();
        this.m_skinningComputePipeline.reset();
        this.m_boundsBindingLayout.reset();
        this.m_boundsComputeShader.reset();
        this.m_boundsComputePipeline.reset();
        this.m_localBoundsComputeShader.reset();
        this.m_localBoundsComputePipeline.reset();
        this.m_repackBindingLayout.reset();
        this.m_repackComputeShader.reset();
        this.m_repackComputePipeline.reset();
    }
    private void resetFrameTaskGraph(){
        {
            const GpuCompiledGraphReadView planAccess(this.m_frameCompiledGraph);
            this.resolveFrameTaskGraphAttempt(planAccess);
            if(planAccess.valid()){
                this.m_frameSubmissionTransaction.reset(this.m_frameCompiledGraph);
                this.m_frameRecordedGraph.reset(this.m_frameCompiledGraph);
            }
        }

        this.m_frameTaskGraph.reset();
        this.m_frameTaskGraphAnalysis.reset();
        this.m_frameTaskGraphQueueAssignments.reset();
        this.m_frameCompiledGraph.reset();
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

