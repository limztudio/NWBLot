#include <impl/ecs_render/shared/frame_push_constants.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type ReadbackQueueToken = QueueSubmissionToken;
type AvboitGeometryResourceSetId = GpuGraphResourceSetId;
type AvboitGraphResourceId = GpuGraphResourceId;
type AvboitGraphTaskId = GpuTaskId;
type CausticGraphTaskId = GpuTaskId;
type CausticGraphResourceId = GpuGraphResourceId;
type CausticLabelView = StringView;
type CausticStageShaderHandle = ShaderHandle;
type CausticStagePipelineHandle = ComputePipelineHandle;
type CsgGraphTaskId = GpuTaskId;
type CsgGraphResourceSetId = GpuGraphResourceSetId;
type DeferredTailGpuTaskId = GpuTaskId;
type DeferredGraphResourceId = GpuGraphResourceId;
type DeferredGraphTextureRange = TextureSubresourceSet;
type SurfelGiGpuTaskId = GpuTaskId;
type SurfelGiQueueSubmissionToken = QueueSubmissionToken;
type RendererTimingPolicy = GpuTaskTimingFeedbackPolicy;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class StatisticsPendingReadback{
    public StatisticsReservationKey key;
    public ReadbackQueueToken token;

    public StatisticsPendingReadback(){
        this.key = StatisticsReservationKey();
        this.token = ReadbackQueueToken();
    }

    public StatisticsPendingReadback(in StatisticsReservationKey key, in ReadbackQueueToken token){
        this.key = key;
        this.token = token;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<BufferHandle> CreateStatisticsReadbackBuffer(in usize counterByteSize, in Name debugName, mut GraphicsRuntime graphics){
    BufferDesc desc;
    desc.setByteSize(cast<u64>(counterByteSize));
    desc.setCpuAccess(CpuAccessMode::Read);
    desc.setDebugName(debugName);
    desc.setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute);
    desc.enableAutomaticStateTracking(ResourceStates::CopyDest);
    return graphics.createBuffer(desc);
}


