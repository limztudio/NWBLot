using CooperativeVectorMatrixPolicy = Core::GraphicsBackend::CooperativeVectorMatrixPolicy;
using StandardMatrixLayout = Core::GraphicsBackend::CooperativeVectorMatrixPolicy::StandardMatrixLayout;

using SwapChainSurfacePolicy = Core::GraphicsBackend::SwapChainSurfacePolicy;
using SwapChainSurfaceFormatSelection = Core::GraphicsBackend::VulkanDetail::SwapChainSurfaceFormatSelection;
