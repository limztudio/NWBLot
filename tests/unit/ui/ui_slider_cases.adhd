void VerifyUiSliderInputTests_TrackPressSeeksDuringFinalPaintAndReleaseOutsideAppliesTheFinalEndpoint(mut UiSliderInputTests self){
    ASSERT_TRUE(self.accept(1u));
    const Point point = self.trackPoint(0.75, self.m_state);
