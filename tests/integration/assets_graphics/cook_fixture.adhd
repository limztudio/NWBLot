}

void InsertEvaluatorIncludeMetadata(in GraphicsTestPath path, in StringView option, in Span<StringView> values, in StringView authoredDefine, mut IncludeMetadataMap includes){
    ShaderIncludeEntry entry;
    InsertEvaluatorDefine(entry.defineValues, option, values);
    const Array<StringView, 1u> inherited("inherited");
    InsertEvaluatorDefine(entry.defineValues, authoredDefine, inherited);
    String key = PathToString(path);
    if(IsWindowsPlatformHost())
        CanonicalizeTextInPlace(key);
    ASSERT_TRUE(includes.emplace(key, entry).second);
}

