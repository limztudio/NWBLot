b8 OverwritePOD<T>(in usize offset, in T value, mut Span<u8> bytes){
    const Span<u8> payload = PodBytes(value);
    if(offset > bytes.size() || payload.size() > bytes.size() - offset)
        return false;
    for(usize i = 0u; i < payload.size(); ++i)
        bytes[offset + i] = payload[i];
    return true;
}


