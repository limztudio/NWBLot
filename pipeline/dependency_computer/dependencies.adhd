namespace_wrapper NWB_DEPENDENCY_COMPUTER;

class AssetDependencyOptions{
    public Vector<String> inputs;
    public Vector<String> assetRoots;
    public String repoRoot;
    public String outputPath;
}

class DependencyInputSelection{
    public Vector<u8> selected;
    public Vector<usize> order;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class DependencyRequest{
    public Name path = s_NameNone;
    public Name expectedType = s_NameNone;
    public String hint;
}

class FrontierExtractionResult{
    public b8 ok = false;
    public Vector<DependencyRequest> requests;
}

class ResolvedDependencyEntry{
    public Name expectedType = s_NameNone;
    public usize value = s_InvalidProviderIndex;
    public usize next = s_InvalidProviderIndex;
}

class ResolvedDependencyCache{
    private HashMap<Name, usize> m_heads;
    private Vector<ResolvedDependencyEntry> m_entries;

    public void reserve(in usize count){
        this.m_heads.reserve(count);
        this.m_entries.reserve(count);
    }

    public Optional<usize> find(in Name path, in Name expectedType)const{
        const auto head = this.m_heads.find(path);
        if(head == this.m_heads.end())
            return Optional<usize>();
        for(usize index = head.value(); index != s_InvalidProviderIndex; index = this.m_entries[index].next){
            if(this.m_entries[index].expectedType == expectedType)
                return Optional<usize>(this.m_entries[index].value);
        }
        return Optional<usize>();
    }

    public void insert(in Name path, in Name expectedType, in usize value){
        const auto head = this.m_heads.try_emplace(path, s_InvalidProviderIndex);
        for(usize index = head.first.value(); index != s_InvalidProviderIndex; index = this.m_entries[index].next){
            if(this.m_entries[index].expectedType == expectedType){
                this.m_entries[index].value = value;
                return;
            }
        }
        ResolvedDependencyEntry entry;
        entry.expectedType = expectedType;
        entry.value = value;
        entry.next = head.first.value();
        const usize entryIndex = this.m_entries.size();
        this.m_entries.push_back(entry);
        head.first.value() = entryIndex;
    }
}

class DependencyProviderCatalog : NoCopy{
    private mut AssetCookWorkspace m_workspace;
    public mut CookFileCatalog catalog;
    public mut CookDependencyAccess access;
    public Vector<Name> virtualPaths;
    private HashMap<Name, usize> m_providerHeads;
    private Vector<usize> m_providerNext;

    public DependencyProviderCatalog(mut AssetCookWorkspace workspace, mut CookFileCatalog catalog, mut CookDependencyAccess access){
        this.m_workspace = workspace;
        this.catalog = catalog;
        this.access = access;
    }

    public b8 discover(in AssetDependencyOptions options){
        const auto repo = ResolvePipelineRepoRoot(StringView(options.repoRoot), s_DiagnosticPrefix);
        if(!repo.has_value())
            return false;
        const auto roots = ResolvePipelineAssetRoots(repo.value(), options.inputs, options.assetRoots, AssetRootDuplicatePolicy::HostFilesystem, s_DiagnosticPrefix, "no asset roots available for dependency resolution");
        if(!roots.has_value())
            return false;
        CookFileCatalog discovered(this.m_workspace);
        discovered.setRepoRoot(repo.value());
        discovered.paths.assetRoots.reserve(roots.value().size());
        for(in PipelineAssetRoot root : roots.value())
            discovered.appendRoot(root.path, root.virtualRoot.view());
        if(!discovered.discover(s_NwbExtension))
            return false;

        const usize fileCount = discovered.files.size();
        Vector<Name> names;
        names.resize(fileCount, s_NameNone);
        if(fileCount > 1u){
            Vector<u8> derivedOk;
            derivedOk.resize(fileCount, 0u);
            parallel_for(usize index = 0u; index < fileCount; ++index){
                in DiscoveredNwbFile file = discovered.files[index];
                const auto path = BuildDerivedAssetVirtualPath(file.assetRoot, file.virtualRoot.view(), file.filePath);
                if(path.has_value()){
                    names[index] = path.value();
                    derivedOk[index] = 1u;
                }
            }
            for(in u8 ok : derivedOk){
                if(ok == 0u)
                    return false;
            }
        }
        else if(fileCount == 1u){
            in DiscoveredNwbFile file = discovered.files[0u];
            const auto path = BuildDerivedAssetVirtualPath(file.assetRoot, file.virtualRoot.view(), file.filePath);
            if(!path.has_value())
                return false;
            names[0u] = path.value();
        }

        HashMap<Name, usize> providerHeads;
        providerHeads.reserve(fileCount);
        Vector<usize> providerNext;
        providerNext.resize(fileCount, s_InvalidProviderIndex);
        for(usize rev = fileCount; rev > 0u; --rev){
            const usize index = rev - 1u;
            const auto head = providerHeads.try_emplace(names[index], s_InvalidProviderIndex);
            providerNext[index] = head.first.value();
            head.first.value() = index;
        }

        this.catalog.replace(discovered);
        this.virtualPaths = names;
        this.m_providerHeads = providerHeads;
        this.m_providerNext = providerNext;
        return true;
    }

    private b8 matchesType(in Name actual, in Name expected)const{
        return expected == s_NameNone || actual == expected || this.access.registry.matchesAssetType(actual, expected);
    }

    private Expected<b8> matchesFile(in DiscoveredNwbFile file, in MetascriptDocument document, in Name path, in Name type)const{
        const auto bunch = HasAssetBunchDeclaration(document);
        if(!bunch.has_value())
            return MakeUnexpected(Failure());
        if(bunch.value()){
            if(type != s_NameNone){
                LogMultipleAssetsDeclaredForPath(PathToString(file.filePath), path);
                return MakeUnexpected(Failure());
            }
            if(!this.access.expandBunch(file, document))
                return MakeUnexpected(Failure());
            return true;
        }
        const auto declared = document.declarationType(s_MetadataAssetVariable);
        if(!declared.has_value())
            return false;
        const auto parsed = ParseName(declared.value());
        if(!parsed.has_value())
            return MakeUnexpected(Failure());
        if(!this.matchesType(parsed.value(), type))
            return false;
        const auto composite = HasCompositeAssetDeclarations(document);
        if(!composite.has_value())
            return MakeUnexpected(Failure());
        if(composite.value()){
            if(!this.access.expandComposite(file, document))
                return MakeUnexpected(Failure());
        }
        else if(document.declarationCount() != 1u){
            LogMultipleAssetsDeclaredForPath(PathToString(file.filePath), path);
            return MakeUnexpected(Failure());
        }
        return true;
    }

    private Expected<b8> matchesChild(in DiscoveredNwbFile file, in MetascriptDocument document, in Name path, in Name type)const{
        const Optional<in Name> pathOwner(path);
        const Optional<in Name> typeOwner(type);
        const auto found = this.access.visitExpanded(file, document, lambda[in this, in pathOwner, in typeOwner](in Span<ExpandedAssetMetadata> items) -> b8{
            for(in ExpandedAssetMetadata item : items){
                if(item.virtualPath == pathOwner.value() && this.matchesType(item.assetType, typeOwner.value()))
                    return true;
            }
            return false;
        });
        if(!found.has_value()){
            if(found.error() == AssetBunchExpandFailure::Unsupported)
                return false;
            return MakeUnexpected(Failure());
        }
        return found.value();
    }

    private b8 resolveCandidates(in Name lookupPath, in b8 exact, in Name path, in Name type, mut usize inOutMatched)const{
        const auto head = this.m_providerHeads.find(lookupPath);
        if(head == this.m_providerHeads.end())
            return true;
        for(usize index = head.value(); index != s_InvalidProviderIndex; index = this.m_providerNext[index]){
            in DiscoveredNwbFile file = this.catalog.files[index];
            const auto document = this.access.read(file, s_DiagnosticPrefix);
            if(!document.has_value())
                return false;
            Expected<b8> found = false;
            if(exact)
                found = this.matchesFile(file, document.value(), path, type);
            else
                found = this.matchesChild(file, document.value(), path, type);
            if(!found.has_value() || (found.value() && !RecordDependencyProviderMatch(path, index, inOutMatched)))
                return false;
        }
        return true;
    }

    public Expected<usize> resolve(in Name path, in Name type, in StringView hint)const{
        if(path == s_NameNone)
            return MakeUnexpected(Failure());
        const StringView text = ResolveDependencyVirtualPathText(path, hint);
        const Optional<Name> parent = ExtractParentVirtualPath(text);
        usize matched = s_InvalidProviderIndex;
        if(!this.resolveCandidates(path, true, path, type, matched))
            return MakeUnexpected(Failure());
        if(parent.has_value() && parent.value() != path && !this.resolveCandidates(parent.value(), false, path, type, matched))
            return MakeUnexpected(Failure());
        if(matched == s_InvalidProviderIndex){
            LogMissingDependencyProvider(path, type, text);
            return MakeUnexpected(Failure());
        }
        return matched;
    }

    public Expected<DependencyInputSelection> selectInputs(in AssetDependencyOptions options)const;
}

class DependencyTraversal : NoCopy{
    private in DependencyProviderCatalog m_providers;
    private mut Vector<String> m_candidates;

    public DependencyTraversal(in DependencyProviderCatalog providers, mut Vector<String> candidates){
        this.m_providers = providers;
        this.m_candidates = candidates;
    }

    public b8 traverse(in DependencyInputSelection selected, in b8 includeInitialSelection);
}

b8 ValidateSingleProviderAssetDeclaration(in usize declarationCount, in StringView providerPathText){
    if(declarationCount != 1u){
        error("DependencyComputer: provider '{}' declares multiple assets without an asset_bunch", providerPathText);
        return false;
    }
    return true;
}

void LogMissingMetadataAssetDeclaration(in StringView providerPathText){
    error("DependencyComputer: meta '{}' is missing asset declaration 'asset'", providerPathText);
}

b8 WriteDependencyListOutput(in StringView outputPathText, in StringView encodedListText){
    const Expected<Path, ErrorCode> output = AbsolutePath(Path(outputPathText));
    if(!output.has_value())
        return false;
    if(!EnsureDirectories(output.value().parentPath()).has_value())
        return false;
    return StagedFileWriter(output.value()).writeTextAtomic(encodedListText);
}

void LogUnrepresentableDependencyList(){
    error("DependencyComputer: input paths cannot be represented in the dependency list");
}

void LogDependencyOutputWriteFailure(in StringView outputPath){
    error("DependencyComputer: failed to write output '{}'", outputPath);
}

void LogReturnedDependencyInputCount(in usize count){
    [essential] info("DependencyComputer: returned {} inputs", count);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void CollectValuePathHints(in MetascriptValue value, mut DependencyPathHints hints){
    if(value.isString()){
        hints.record(value.asString());
        return;
    }
    if(value.isList()){
        for(in MetascriptValue item : value.listView())
            CollectValuePathHints(item, hints);
        return;
    }
    if(value.isMap())
        value.forEachMapEntry(lambda[mut hints](in StringView key, in MetascriptValue item) -> b8{
            hints.record(key);
            CollectValuePathHints(item, hints);
            return true;
        });
}

void CollectDocumentPathHints(in MetascriptDocument document, mut DependencyPathHints hints){
    const Optional<in MetascriptDocument> owner(document);
    document.forEachDeclaration(lambda[in owner, mut hints](in StringView typeName, in StringView variableName) -> b8{
        owner.value().visitVariable(variableName, lambda[mut hints](in MetascriptValue value) -> b8{
            CollectValuePathHints(value, hints);
            return true;
        });
        return true;
    });
}

Expected<DependencyInputSelection> DependencyProviderCatalog::selectInputs(in AssetDependencyOptions options)const{
    DependencyInputSelection result;
    result.selected.resize(this.catalog.files.size(), 0u);
    result.order.reserve(this.catalog.files.size());
    if(options.inputs.empty()){
        in DefaultCookEntryAssetDescriptor entry = this.access.registry.defaultEntryAsset();
        if(!ValidateDefaultDependencyEntryAsset(entry.virtualPath))
            return MakeUnexpected(Failure());
        const auto provider = this.resolve(entry.virtualPath, entry.assetType, entry.virtualPathText);
        if(!provider.has_value()){
            LogProjectRootMissing(entry.virtualPathText);
            return MakeUnexpected(Failure());
        }
        result.selected[provider.value()] = 1u;
        result.order.push_back(provider.value());
    }
    else if(!this.catalog.select(options.inputs, result.selected, result.order, lambda[](in CookInputSelectionError failure) -> void{ LogCookInputSelectionFailure(failure, s_DiagnosticPrefix); }))
        return MakeUnexpected(Failure());
    return result;
}

b8 ExtractSingleAssetDependencies(
    in DependencyProviderCatalog providers,
    in DiscoveredNwbFile file,
    in Name assetType,
    in Name virtualPath,
    in MetascriptValue value,
    in Optional<in MetascriptDocument> document,
    in DependencyPathHints hints,
    mut Vector<DependencyRequest> outRequests
){
    const Optional<in DependencyPathHints> hintOwner(hints);
    return providers.access.extract(file, assetType, virtualPath, value, document, lambda[in hintOwner, mut outRequests](in Name dep, in Name expected) -> b8{
        if(dep == s_NameNone)
            return false;
        DependencyRequest req;
        req.path = dep;
        req.expectedType = expected;
        req.hint = String(hintOwner.value().lookup(dep));
        outRequests.push_back(req);
        return true;
    });
}

FrontierExtractionResult ExtractFileDependencies(in DependencyProviderCatalog providers, in usize index){
    FrontierExtractionResult result;
    in DiscoveredNwbFile file = providers.catalog.files[index];
    const auto doc = providers.access.read(file, s_DiagnosticPrefix);
    if(!doc.has_value())
        return result;
    in MetascriptDocument document = doc.value();
    DependencyPathHints hints;
    CollectDocumentPathHints(document, hints);
    const Optional<in DependencyProviderCatalog> providerOwner(providers);
    const Optional<in DiscoveredNwbFile> fileOwner(file);
    Vector<DependencyRequest> requests;
    const auto expanded = providers.access.visitExpanded(file, document, lambda[in providerOwner, in fileOwner, mut hints, mut requests](in Span<ExpandedAssetMetadata> items) -> b8{
        for(in ExpandedAssetMetadata item : items)
            CollectValuePathHints(item.value, hints);
        for(in ExpandedAssetMetadata item : items){
            if(!ExtractSingleAssetDependencies(providerOwner.value(), fileOwner.value(), item.assetType, item.virtualPath, item.value, Optional<in MetascriptDocument>(), hints, requests))
                return false;
        }
        return true;
    });
    if(expanded.has_value()){
        result.requests = requests;
        result.ok = expanded.value();
        return result;
    }
    if(expanded.error() != AssetBunchExpandFailure::Unsupported)
        return result;
    if(document.declarationCount() != 1u && !ValidateSingleProviderAssetDeclaration(document.declarationCount(), PathToString(file.filePath)))
        return result;
    const auto declared = document.declarationType(s_MetadataAssetVariable);
    if(!declared.has_value()){
        LogMissingMetadataAssetDeclaration(PathToString(file.filePath));
        return result;
    }
    const auto type = ParseName(declared.value());
    if(!type.has_value())
        return result;
    if(!document.hasVariable(s_MetadataAssetVariable)){
        error("{} '{}': missing asset declaration '{}'", s_DiagnosticPrefix, file.filePath, s_MetadataAssetVariable);
        return result;
    }
    const Name declaredType = type.value();
    const Name virtualPath = providers.virtualPaths[index];
    const Optional<in MetascriptDocument> owner(document);
    const Optional<in DependencyPathHints> hintOwner(hints);
    if(!document.visitVariable(s_MetadataAssetVariable, lambda[in providerOwner, in fileOwner, in declaredType, in virtualPath, in owner, in hintOwner, mut requests](in MetascriptValue value) -> b8{
        return ExtractSingleAssetDependencies(providerOwner.value(), fileOwner.value(), declaredType, virtualPath, value, owner, hintOwner.value(), requests);
    }))
        return result;
    result.requests = requests;
    result.ok = true;
    return result;
}

b8 DependencyTraversal::traverse(in DependencyInputSelection selected, in b8 includeInitialSelection){
    in DependencyProviderCatalog providers = this.m_providers;
    const usize fileCount = providers.catalog.files.size();

    Vector<u8> included;
    included.reserve(selected.selected.size());
    for(usize i = 0u; i < selected.selected.size(); ++i)
        included.push_back(selected.selected[i]);

    Vector<u8> processed;
    processed.resize(fileCount, 0u);

    Vector<usize> frontier;
    frontier.reserve(selected.order.size());

    Vector<String> discoveredPaths;
    discoveredPaths.reserve(fileCount);

    for(in usize file : selected.order){
        if(includeInitialSelection)
            discoveredPaths.push_back(PathToString(providers.catalog.files[file].filePath.lexicallyNormal()));
        if(processed[file] == 0u){
            processed[file] = 1u;
            frontier.push_back(file);
        }
    }

    ResolvedDependencyCache resolvedCache;
    resolvedCache.reserve(fileCount);

    while(!frontier.empty()){
        Vector<FrontierExtractionResult> waveResults;
        waveResults.resize(frontier.size());
        if(frontier.size() > 1u){
            parallel_for(usize slot = 0u; slot < frontier.size(); ++slot){
                waveResults[slot] = ExtractFileDependencies(providers, frontier[slot]);
            }
        }
        else{
            waveResults[0u] = ExtractFileDependencies(providers, frontier[0u]);
        }

        usize totalRequests = 0u;
        for(in FrontierExtractionResult entry : waveResults){
            if(!entry.ok)
                return false;
            totalRequests += entry.requests.size();
        }

        Vector<usize> waveProviders;
        waveProviders.reserve(totalRequests);
        Vector<DependencyRequest> pendingRequests;
        pendingRequests.reserve(totalRequests);
        ResolvedDependencyCache wavePending;
        wavePending.reserve(totalRequests);

        for(in FrontierExtractionResult entry : waveResults){
            for(in DependencyRequest req : entry.requests){
                const auto cached = resolvedCache.find(req.path, req.expectedType);
                if(cached.has_value()){
                    waveProviders.push_back(cached.value());
                    continue;
                }
                const auto queued = wavePending.find(req.path, req.expectedType);
                if(queued.has_value()){
                    if(pendingRequests[queued.value()].hint.empty() && !req.hint.empty())
                        pendingRequests[queued.value()].hint = req.hint;
                    continue;
                }
                const usize pendingIndex = pendingRequests.size();
                wavePending.insert(req.path, req.expectedType, pendingIndex);
                pendingRequests.push_back(req);
            }
        }

        if(!pendingRequests.empty()){
            const usize pendingCount = pendingRequests.size();
            Vector<usize> resolvedProviders;
            resolvedProviders.resize(pendingCount, s_InvalidProviderIndex);
            Vector<u8> resolvedOk;
            resolvedOk.resize(pendingCount, 0u);
            if(pendingCount > 1u){
                parallel_for(usize reqIndex = 0u; reqIndex < pendingCount; ++reqIndex){
                    in DependencyRequest req = pendingRequests[reqIndex];
                    const auto found = providers.resolve(req.path, req.expectedType, StringView(req.hint));
                    if(found.has_value()){
                        resolvedProviders[reqIndex] = found.value();
                        resolvedOk[reqIndex] = 1u;
                    }
                }
            }
            else{
                in DependencyRequest req = pendingRequests[0u];
                const auto found = providers.resolve(req.path, req.expectedType, StringView(req.hint));
                if(!found.has_value())
                    return false;
                resolvedProviders[0u] = found.value();
                resolvedOk[0u] = 1u;
            }

            for(usize reqIndex = 0u; reqIndex < pendingCount; ++reqIndex){
                if(resolvedOk[reqIndex] == 0u)
                    return false;
                in DependencyRequest req = pendingRequests[reqIndex];
                const usize providerIndex = resolvedProviders[reqIndex];
                resolvedCache.insert(req.path, req.expectedType, providerIndex);
                waveProviders.push_back(providerIndex);
            }
        }

        Vector<usize> nextFrontier;
        nextFrontier.reserve(waveProviders.size());
        for(in usize providerIndex : waveProviders){
            if(included[providerIndex] == 0u){
                included[providerIndex] = 1u;
                discoveredPaths.push_back(PathToString(providers.catalog.files[providerIndex].filePath.lexicallyNormal()));
            }
            if(processed[providerIndex] == 0u){
                processed[providerIndex] = 1u;
                nextFrontier.push_back(providerIndex);
            }
        }
        frontier = nextFrontier;
    }

    SortUniqueSequence<String>(discoveredPaths);
    this.m_candidates.reserve(this.m_candidates.size() + discoveredPaths.size());
    for(in String path : discoveredPaths)
        this.m_candidates.push_back(path);
    return true;
}

Expected<Vector<String>> ComputeAssetDependencies(in AssetDependencyOptions options){
    AssetCookWorkspace workspace(s_DependencyComputerArena);
    CookFileCatalog catalog(workspace);
    CookDependencyAccess access(workspace);
    DependencyProviderCatalog providers(workspace, catalog, access);
    if(!providers.access.registerTypes() || !providers.discover(options))
        return MakeUnexpected(Failure());
    const auto selection = providers.selectInputs(options);
    if(!selection.has_value())
        return MakeUnexpected(Failure());
    Vector<String> paths;
    b8 includeInitialSelection = true;
    if(!options.inputs.empty()){
        paths = options.inputs;
        includeInitialSelection = false;
    }
    DependencyTraversal traversal(providers, paths);
    if(!traversal.traverse(selection.value(), includeInitialSelection))
        return MakeUnexpected(Failure());
    return paths;
}

b8 WriteAssetDependencies(in AssetDependencyOptions options){
    const auto paths = ComputeAssetDependencies(options);
    if(!paths.has_value())
        return false;
    const auto text = EncodeCookInputPaths(paths.value());
    if(!text.has_value()){
        LogUnrepresentableDependencyList();
        return false;
    }
    if(!WriteDependencyListOutput(options.outputPath, text.value())){
        LogDependencyOutputWriteFailure(options.outputPath);
        return false;
    }
    LogReturnedDependencyInputCount(paths.value().size());
    return true;
}


