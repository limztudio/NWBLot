namespace __hidden_ui_context_claim_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB;
using namespace NWB::Impl::Ui;

class UiContextClaimTests : public testing::Test{
public:
    UiContextClaimTests()
        : m_arena(Name(NWB::Tests::UiCases::s_UiCaseTestsUiContextClaim))
        , m_context(m_arena)
    {}


public:
    [[nodiscard]] b8 begin(const u64 generation){
        return m_context.beginFrame(generation) && m_context.beginRoot({ 17u, 1u });
    }

    [[nodiscard]] b8 commit(const u64 generation){
        return m_context.endRoot() && m_context.finishFrame() && m_context.commitFrame(generation);
    }

    [[nodiscard]] Expected<WidgetState> declareState(const AStringView stableKey, const WidgetKind::Enum kind){
        const auto declared = m_context.declare(stableKey, kind);
        if(!declared)
            return MakeUnexpected(Failure{});
        return **declared;
    }


public:
    Core::Alloc::GlobalArena m_arena;
    Context m_context;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


