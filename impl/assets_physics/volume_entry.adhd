b8 CollectColliderAssetDependencies(
    in AssetRef<Mesh> meshAsset,
    in AssetRef<PhysicsMaterialAsset> materialAsset,
    in AssetRef<ConvexHullAsset> convexHullAsset,
    in AssetRef<CompoundHullAsset> compoundHullAsset,
    in AssetRef<CollisionMeshAsset> collisionMeshAsset,
    in AssetRef<HeightfieldAsset> heightfieldAsset,
    mut ICookDependencyCollector collector
){
    if(meshAsset.valid() && !collector.addAssetDependency(meshAsset.name(), Mesh::AssetTypeName()))
        return false;
    if(materialAsset.valid() && !collector.addAssetDependency(materialAsset.name(), PhysicsMaterialAsset::AssetTypeName()))
        return false;
    if(convexHullAsset.valid() && !collector.addAssetDependency(convexHullAsset.name(), ConvexHullAsset::AssetTypeName()))
        return false;
    if(compoundHullAsset.valid() && !collector.addAssetDependency(compoundHullAsset.name(), CompoundHullAsset::AssetTypeName()))
        return false;
    if(collisionMeshAsset.valid() && !collector.addAssetDependency(collisionMeshAsset.name(), CollisionMeshAsset::AssetTypeName()))
        return false;
    if(heightfieldAsset.valid() && !collector.addAssetDependency(heightfieldAsset.name(), HeightfieldAsset::AssetTypeName()))
        return false;
    return true;
}

b8 ExtractColliderComponentDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    const Expected<PhysicsColliderDepEntry> entryRes = ReadCookDependencyEntry<PhysicsColliderDepEntry>(context, s_ColliderComponentDiagnosticPrefix, ParseColliderDepEntry);
    if(!entryRes.has_value())
        return false;
    in PhysicsColliderDepEntry dep = entryRes.value();
    if(!CollectColliderAssetDependencies(dep.meshAsset, dep.materialAsset, dep.convexHullAsset, dep.compoundHullAsset, dep.collisionMeshAsset, dep.heightfieldAsset, collector))
        return false;
    for(usize i = 0u; i < dep.extraMeshAssets.size(); ++i){
        if(!collector.addAssetDependency(dep.extraMeshAssets[i].name(), Mesh::AssetTypeName()))
            return false;
    }
    for(usize i = 0u; i < dep.extraMaterialAssets.size(); ++i){
        if(!collector.addAssetDependency(dep.extraMaterialAssets[i].name(), PhysicsMaterialAsset::AssetTypeName()))
            return false;
    }
    for(usize i = 0u; i < dep.extraConvexHullAssets.size(); ++i){
        if(!collector.addAssetDependency(dep.extraConvexHullAssets[i].name(), ConvexHullAsset::AssetTypeName()))
            return false;
    }
    for(usize i = 0u; i < dep.extraCompoundHullAssets.size(); ++i){
        if(!collector.addAssetDependency(dep.extraCompoundHullAssets[i].name(), CompoundHullAsset::AssetTypeName()))
            return false;
    }
    for(usize i = 0u; i < dep.extraCollisionMeshAssets.size(); ++i){
        if(!collector.addAssetDependency(dep.extraCollisionMeshAssets[i].name(), CollisionMeshAsset::AssetTypeName()))
            return false;
    }
    for(usize i = 0u; i < dep.extraHeightfieldAssets.size(); ++i){
        if(!collector.addAssetDependency(dep.extraHeightfieldAssets[i].name(), HeightfieldAsset::AssetTypeName()))
            return false;
    }
    return true;
}

