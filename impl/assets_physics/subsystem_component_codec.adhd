    public u8 bodyType = cast<u8>(BodyType::Dynamic);
    public u8 bodyFlags = 0u;
    public u8 shapeFlags = 0u;
    public u8 extraFlags = 0u;
    public Array<u8, 8u> sixDofMotions;
    public Array<u8, 8u> sixDofFlags;
    public Array<f32, 42u> sixDofParams;
    public u64 reserved0 = 0u;
}

