#include <impl/ecs_render/deferred/deferred_frame_targets.adhd>
#include <impl/ecs_render/shared/frame_push_constants.adhd>
#include <impl/ecs_render/raytrace/raytracing_system.adhd>
#include <impl/ecs_render/caustic/caustic_resolve_state.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class HardwareCausticsStageInputs{
    public mut DeferredFrameTargets targets;
    public in DeferredLightingGraphResources lightingResources;
    public in MeshViewBufferSnapshot meshViewSnapshot;
    public in RayTracingDeferredGraphResourceSnapshot rayTracingResources;
    public in RendererFrameGraphFeatures features;
    public GpuGraphResourceId worldPosition;
    public GpuGraphResourceId depth;
    public GpuGraphResourceId currentCausticIrradiance;
    public GpuGraphResourceId currentBindlessSlots;
    public GpuGraphResourceId sceneShading;
    public GpuGraphResourceId lights;
    public GpuGraphResourceId materialContextSlots;
    public GpuGraphResourceId opticalScene;
    public GpuGraphResourceSetId hardwareTraceGeometrySet;
    public Span<GpuGraphResourceId> hardwareTraceGeometryResources;
    public GpuGraphResourceSetId traceMaterialSampledTextureSet;
    public GpuTaskId graphicsPrefixTask;
    public in b8 shadowPreparationReady;
    public in GpuExternalCompletionId historyWriterDrainCompletion;
    public mut GpuPersistentResourceStateCache accumulatorPersistentState;
    public b8 declaresHardwareCaustics = false;
    public mut b8 producerDispatched;
    public mut GpuTimingSubmissionTicket timingTicket;
    public mut Optional<GpuTimingMeasure> photonTiming;
    public mut Optional<GpuTimingMeasure> resolveTiming;

    public HardwareCausticsStageInputs(
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources lightingResources,
        in MeshViewBufferSnapshot meshViewSnapshot,
        in RayTracingDeferredGraphResourceSnapshot rayTracingResources,
        in RendererFrameGraphFeatures features,
        in borrow b8 shadowPreparationReady,
        in GpuExternalCompletionId historyWriterDrainCompletion,
        mut GpuPersistentResourceStateCache accumulatorPersistentState,
        mut b8 producerDispatched,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> photonTiming,
        mut Optional<GpuTimingMeasure> resolveTiming
    ){
        this.targets = targets;
        this.lightingResources = lightingResources;
        this.meshViewSnapshot = meshViewSnapshot;
        this.rayTracingResources = rayTracingResources;
        this.features = features;
        this.shadowPreparationReady = shadowPreparationReady;
        this.historyWriterDrainCompletion = historyWriterDrainCompletion;
        this.accumulatorPersistentState = accumulatorPersistentState;
        this.producerDispatched = producerDispatched;
        this.timingTicket = timingTicket;
        this.photonTiming = photonTiming;
        this.resolveTiming = resolveTiming;
    }
}


class HardwareCausticsStageResult{
    public GpuTaskId hardwareCausticsTask;
    public GpuTaskId causticIrradianceClearTask;
    public GpuTaskId causticAccumulatorBootstrapClearTask;
    public GpuTaskId causticAccumulatorDecayTask;
    public GpuTaskId causticPhotonTask;
    public GpuTaskId causticGeometryTask;
    public GpuTaskId causticResolvePrepareTask;
    public Array<GpuTaskId, s_CausticResolvePassCount> causticResolveWaveletTasks;
    public GpuTaskId causticResolveUpsampleTask;

    public HardwareCausticsStageResult(){}
}

[modular]
class HardwareCausticsStageBuilder : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut RendererRayTracingSystem m_raytracingSystem;

    public HardwareCausticsStageBuilder(mut GpuTaskGraph graph, mut RendererRayTracingSystem raytracingSystem){
        this.m_graph = graph;
        this.m_raytracingSystem = raytracingSystem;
    }

    public Expected<HardwareCausticsStageResult> declare(in HardwareCausticsStageInputs inputs);
}


