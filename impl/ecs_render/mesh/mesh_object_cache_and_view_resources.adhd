////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_MeshObjectGeometryBufferSuffix = ":object_geometry";

b8 IsObjectGeometryCacheReady(in b8 hasBuffer, in b8 heapHandleValid){
    return hasBuffer && heapHandleValid;
}

b8 ShouldRecordMeshGraphicsFrameMarker(in b8 shadowVisibilityRunsOnCompute, in b8 frameScopeValid){
    return !shadowVisibilityRunsOnCompute && frameScopeValid;
}

b8 ShouldRecordMeshSplitAsyncPrefixTiming(in b8 shadowVisibilityRunsOnCompute, in b8 asyncPrefixTimingSpansOnePacket){
    return shadowVisibilityRunsOnCompute && asyncPrefixTimingSpansOnePacket;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/mesh/mesh_resources_internal.adhd.h>
#include <impl/ecs_render/mesh/renderer_mesh_types.adhd.h>
#include <impl/global.adhd.h>
#include <impl/ecs_render/mesh/mesh_system.adhd.h>
#include <impl/ecs_render/kernel/descriptor_register_utils.adhd.h>
#include <impl/ecs_render/mesh/renderer_mesh_state.adhd.h>
#include <impl/ecs_render/shared/renderer_push_constants_private.adhd.h>
#include <core/common/log.h>
#include <core/graphics/rhi/gpu_descriptor_heap.h>
#include <core/graphics/runtime/runtime.h>
#include <impl/ecs_render/mesh/mesh_geometry_buffer_policy.adhd.h>
#include <impl/ecs_render/mesh/object_geometry_cache.adhd.h>
#include <impl/assets/graphics/mesh/object_geometry_constants.h>
#include <impl/ecs_render/mesh/mesh_view_state_policy.adhd.h>
#include <impl/ecs_render/mesh/mesh_view_private.adhd.h>
#include <impl/ecs_render/mesh/task_graph_prefix_tasks.adhd.h>
#include <impl/ecs_render/kernel/task_graph_queue_lookup.adhd.h>
#include <impl/ecs_render/kernel/timing_names.adhd.h>
