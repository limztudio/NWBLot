#include <impl/ecs_ui/edit_geometry.adhd>
#include <impl/ecs_ui/edit_box_host_records.adhd>
#include <impl/ecs_ui/text_edit_session.adhd>
#include <impl/ecs_ui/edit_clipboard_controller.adhd>
#include <impl/ecs_ui/clipboard_publications.adhd>
#include <impl/ecs_ui/toolkit/context.adhd>
#include <impl/ecs_ui/toolkit/edit/text_normalization.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[modular]
class UiEditBoxHost : IEditBoxHost{
    [cpp_unwind]
    public UiEditBoxHost(mut Context context, mut ITextInputService textInput, mut IClipboardService clipboard){
        this.m_context = context;
        this.m_textInput = textInput;
        this.m_clipboardService = clipboard;
        this.m_session = UiTextEditSession(textInput);
        this.m_clipboard = UiEditClipboardController(clipboard);
        this.m_primary = UiEditClipboardController(clipboard);
        this.m_publications = UiClipboardPublications(clipboard);
        this.m_entries.reserve(s_UiEditBoxMaxEntries);
        this.m_events.reserve(s_InputMaxEvents);
    }

    public ~UiEditBoxHost(){ this.cancelTransfers(); }

    public EditBoxResult edit(in WidgetState widget, in EditBoxOptions options, mut EditModel model)override{
        return this.editBorrowed(widget, options, this.m_context.popupToken(), model, Optional<mut IEditActionSink>(), Optional<mut UiEditNavigationBorrow>());
    }

    public EditBoxResult editInPopup(in WidgetState widget, in EditBoxOptions options, in PopupToken popup, mut EditModel model)override{
        return this.editBorrowed(widget, options, popup, model, Optional<mut IEditActionSink>(), Optional<mut UiEditNavigationBorrow>());
    }

    public EditBoxResult editActions(in WidgetState widget, in EditBoxOptions options, in PopupToken popup, mut EditModel model, mut IEditActionSink actions)override{
        return this.editBorrowed(widget, options, popup, model, Optional<mut IEditActionSink>(actions), Optional<mut UiEditNavigationBorrow>());
    }
    public EditBoxResult editNavigated(
        in WidgetState widget,
        in EditBoxOptions options,
        in PopupToken popup,
        mut EditModel model,
        mut EditNavigationState navigation,
        mut IEditNavigationResolver resolver,
        mut IEditActionSink actions
    )override;
    public b8 publish(in WidgetState widget, in EditBoxView view, in EditBoxPlacement placement, in EditBoxOptions options)override;
    [cpp_unwind]
    public void beginFrame(in u64 generation, in DisplayMetrics display);
    [cpp_unwind]
    public void finishFrame();
    [cpp_unwind]
    public void commitFrame(in u64 generation);
    [cpp_unwind]
    public void collectNative();
    public b8 prepareSubmit(in InputEvent event);
    [cpp_unwind]
    public void input(in InputEvent input, in WidgetId previousCapture, in b8 submit);
    [cpp_unwind]
    public b8 character(in u32 unicode);
    [cpp_unwind]
    public b8 pastePrimary(in Point position);
    public b8 hasTextFocus()const;
    public b8 wantsTextInput()const;
    public b8 takeClipboardFailure();
    [cpp_unwind]
    public void synchronizeFocus();
    [cpp_unwind]
    public void reset();
    private Optional<mut UiEditBoxEntry> findEntry(in WidgetId widget);
    private Optional<in UiEditBoxEntry> findConstEntry(in WidgetId widget)const;
    private Optional<in UiEditBoxEntry> focusedTextEntry()const;
    [cpp_unwind]
    private b8 append(mut UiEditBoxEvent event);
    private b8 compositionActive(in UiEditBoxEntry entry)const;
    private void discard(in UiTextEditOwner owner);
    private b8 rejectBorrowedMutation();
    private u64 nextFocusGeneration();
    [cpp_unwind]
    private void cancelTransfers();
    [cpp_unwind]
    private void drainPublications();
    [cpp_unwind]
    private EditBoxResult editBorrowed(in WidgetState widget, in EditBoxOptions options, in PopupToken popup, mut EditModel model, in Optional<mut IEditActionSink> actions, in Optional<mut UiEditNavigationBorrow> navigation);
    [cpp_unwind]
    private b8 apply(in EditBoxOptions options, mut UiEditBoxEvent event, mut UiEditBoxEntry entry, mut EditModel model, mut EditBoxResult result, in Optional<mut IEditActionSink> actions, in Optional<mut UiEditNavigationBorrow> navigation);
    [cpp_unwind]
    private b8 applyNavigation(in UiEditBoxEvent event, in EditNavigationDirection direction, mut EditModel model, mut UiEditNavigationBorrow navigation);
    [cpp_unwind]
    private b8 applyAction(in EditBoxOptions options, in EditAction action, mut UiEditBoxEntry entry, mut EditModel model, mut EditBoxResult result, mut IEditActionSink actions, in Optional<mut UiEditNavigationBorrow> navigation);
    [cpp_unwind]
    private void synchronizeSession(in EditBoxOptions options, in b8 inputMethod, mut UiEditBoxEntry entry, mut EditModel model);
    [owner_result]
    private UiEditBoxEvent makeEvent()const{ return UiEditBoxEvent(); }

    private TextInputRect nativeCaret(in UiEditBoxGeometry geometry)const{
        return MakeUiEditNativeCaretRect(geometry, this.m_display);
    }

    private mut Context m_context;
    private mut ITextInputService m_textInput;
    private mut IClipboardService m_clipboardService;
    private UiTextEditSession m_session;
    private UiEditClipboardController m_clipboard;
    private UiEditClipboardController m_primary;
    private UiClipboardPublications m_publications;
    private UiEditClickTracker m_clickTracker;
    private Vector<UiEditBoxEntry> m_entries;
    private Vector<UiEditBoxEvent> m_events;
    private TextAreaModelStamp m_nativePublished;
    private UiTextEditOwner m_clipboardOwner;
    private UiTextEditOwner m_primaryOwner;
    private DisplayMetrics m_display;
    private u64 m_generation = 0u;
    private u64 m_lastNativeSequence = 0u;
    private u64 m_focusGeneration = 0u;
    private u64 m_selectionSequence = 0u;
    private u64 m_activeSelectionSequence = 0u;
    private InputSource m_selectionSource;
    private usize m_queuedTextBytes = 0u;
    private b8 m_clipboardFailure = false;
    private b8 m_borrowed = false;
    private b8 m_borrowRejected = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

