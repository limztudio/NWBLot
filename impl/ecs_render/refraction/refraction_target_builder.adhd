class GraphicsRuntime;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_CORE_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct DeferredFrameTargets;


class RefractionTargetBuilder final : NoCopy{
public:
    explicit RefractionTargetBuilder(Core::GraphicsRuntime& graphics)noexcept : m_graphics(graphics){}


public:
    [[nodiscard]] b8 createImages(DeferredFrameTargets& createdTargets, AvboitFrameTargets& avboitTargets, Core::Format::Enum accumColorFormat, Core::Format::Enum accumExtinctionFormat, const Core::Color& transparentBlack);
    [[nodiscard]] b8 createTileBuffers(u64 tileCount, AvboitFrameTargets& avboitTargets);


private:
    Core::GraphicsRuntime& m_graphics;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Name s_RefractionDepthTargetName = "engine/avboit/refraction_depth";
const Name s_RefractionResolveTargetName = "engine/avboit/refraction_resolve";

u64 ComputeRefractionTileListByteSize(in u64 tileCount){
    return tileCount * 4u;
}

void LogFailedRefractionTileBuffers(){
    error("RendererSystem: failed to create refraction tile scheduling buffers");
}


