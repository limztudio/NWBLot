#include <impl/ecs_render/optics/optical_scene.adhd>
#include <impl/ecs_render/optics/optical_scene_binary_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RayTracingOpticalSceneUpload{
    public Vector<u8> bytes;
    public u32 instanceCount = 0u;

    public RayTracingOpticalSceneUpload(in RayTracingOpticalSceneGather gather){
        OpticalSceneBinaryCodec().serialize(gather.header, Span<RayTracingOpticalInstanceGpu>(gather.instances), this.bytes, this.instanceCount);
    }
}

type RayTracingOpticalSceneUploadHandle = Shared<RayTracingOpticalSceneUpload>;

class RayTracingOpticalUploadPlan{
    public BufferHandle buffer;
    public RayTracingOpticalSceneUploadHandle upload;
    public QueueSubmissionToken acceptedToken;
    public usize owner = 0u;
    public u64 sequence = 0u;
    public u64 acceptedSequence = 0u;
    public GpuPhysicalQueueId queue;
    public b8 reused = false;
    public b8 available = false;

    public b8 valid()const{
        return this.available && this.buffer.valid() && this.upload.valid() && this.owner != 0u && this.sequence != 0u && this.queue.valid();
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanPlanRayTracingOpticalUpload(
    in b8 retired,
    in b8 quarantined,
    in u64 reservedSequence,
    in b8 hasBuffer,
    in b8 hasUploadBytes,
    in b8 primaryQueueValid,
    in u64 primaryQueueGeneration,
    in u64 bufferGeneration,
    in u64 nextSequence
){
    return
        !retired
        && !quarantined
        && reservedSequence == 0u
        && hasBuffer
        && hasUploadBytes
        && primaryQueueValid
        && primaryQueueGeneration == bufferGeneration
        && nextSequence != u64.max
    ;
}

b8 CanReserveRayTracingOpticalUpload(
    in b8 matchesBuffer,
    in b8 reused,
    in u64 reservedSequence,
    in u64 planAcceptedSequence,
    in u64 acceptedSequence,
    in u64 planSequence,
    in u64 nextSequence
){
    return matchesBuffer && !reused && reservedSequence == 0u && planAcceptedSequence == acceptedSequence && planSequence < nextSequence;
}

b8 ValidAcceptedOpticalSubmissionToken(
    in b8 tokenValid,
    in b8 isGraphicsQueue,
    in b8 matchesPhysicalQueue,
    in b8 hasPreviousAcceptedToken,
    in u64 tokenValue,
    in u64 previousTokenValue
){
    return tokenValid && isGraphicsQueue && matchesPhysicalQueue && (!hasPreviousAcceptedToken || tokenValue > previousTokenValue);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Only an accepted write on the primary Graphics queue can replace the resident upload.
class RayTracingOpticalUploadState : NoCopy{
    private BufferHandle m_buffer;
    private RayTracingOpticalSceneUploadHandle m_acceptedUpload;
    private RayTracingOpticalSceneUploadHandle m_reservedUpload;
    private QueueSubmissionToken m_acceptedToken;
    private u64 m_nextSequence = 1u;
    private u64 m_acceptedSequence = 0u;
    private u64 m_reservedSequence = 0u;
    private GpuPhysicalQueueId m_primaryQueue;
    private Futex m_mutex;
    private b8 m_retired = false;
    private b8 m_quarantined = false;

    public RayTracingOpticalUploadState(in BufferHandle buffer, in GpuPhysicalQueueId primaryQueue){
        this.m_buffer = buffer;
        this.m_primaryQueue = primaryQueue;
    }

    public void invalidate(){
        const FutexGuard guard = AcquireFutex(this.m_mutex);

        this.m_retired = true;
        this.m_reservedSequence = 0u;
        this.m_reservedUpload.reset();
        this.m_acceptedUpload.reset();
        this.m_acceptedToken = QueueSubmissionToken();
    }

    public RayTracingOpticalUploadPlan plan(in RayTracingOpticalSceneUploadHandle upload){
        const FutexGuard guard = AcquireFutex(this.m_mutex);

        RayTracingOpticalUploadPlan result;
        u64 generation = 0u;
        if(this.m_buffer.valid())
            generation = this.m_buffer.deref().getDeviceGeneration();
        if(!CanPlanRayTracingOpticalUpload(
            this.m_retired,
            this.m_quarantined,
            this.m_reservedSequence,
            this.m_buffer.valid(),
            upload.valid() && !upload.deref().bytes.empty(),
            this.m_primaryQueue.valid(),
            this.m_primaryQueue.deviceGeneration,
            generation,
            this.m_nextSequence
        ))
            return result;

        result.buffer = this.m_buffer;
        result.upload = upload;
        result.acceptedToken = this.m_acceptedToken;
        result.owner = ObjectAddressKey(this);
        result.sequence = this.m_nextSequence;
        ++this.m_nextSequence;
        result.acceptedSequence = this.m_acceptedSequence;
        result.queue = this.m_primaryQueue;
        result.reused = this.m_acceptedUpload == upload && this.m_acceptedToken.valid();
        result.available = true;
        return result;
    }

    public b8 reserve(in RayTracingOpticalUploadPlan plan){
        const FutexGuard guard = AcquireFutex(this.m_mutex);

        if(!CanReserveRayTracingOpticalUpload(this.matchesBuffer(plan), plan.reused, this.m_reservedSequence, plan.acceptedSequence, this.m_acceptedSequence, plan.sequence, this.m_nextSequence))
            return false;

        this.m_reservedSequence = plan.sequence;
        this.m_reservedUpload = plan.upload;
        return true;
    }

    public b8 isReserved(in RayTracingOpticalUploadPlan plan)const{
        const FutexGuard guard = AcquireFutex(this.m_mutex);

        return this.matchesBuffer(plan) && plan.sequence == this.m_reservedSequence && plan.upload == this.m_reservedUpload;
    }

    public void discard(in RayTracingOpticalUploadPlan plan){
        const FutexGuard guard = AcquireFutex(this.m_mutex);

        if(plan.owner == ObjectAddressKey(this) && plan.buffer.identity() == this.m_buffer.identity() && plan.sequence == this.m_reservedSequence && plan.upload == this.m_reservedUpload){
            this.m_reservedSequence = 0u;
            this.m_reservedUpload.reset();
        }
    }

    public b8 accept(in RayTracingOpticalUploadPlan plan, in QueueSubmissionToken token){
        const FutexGuard guard = AcquireFutex(this.m_mutex);

        if(!this.matchesBuffer(plan) || plan.sequence != this.m_reservedSequence || plan.upload != this.m_reservedUpload)
            return false;
        this.m_reservedSequence = 0u;
        this.m_reservedUpload.reset();
        if(!ValidAcceptedOpticalSubmissionToken(
            token.valid(),
            token.queue == CommandQueue::Graphics,
            token.matchesPhysicalQueue(this.m_primaryQueue.index, this.m_primaryQueue.deviceGeneration),
            this.m_acceptedToken.valid(),
            token.value,
            this.m_acceptedToken.value
        )){
            // This callback follows native acceptance. Discard cannot prove the old bytes survived an unknown write.
            this.m_quarantined = true;
            return false;
        }

        this.m_acceptedUpload = plan.upload;
        this.m_acceptedSequence = plan.sequence;
        this.m_acceptedToken = token;
        return true;
    }

    private b8 matchesBuffer(in RayTracingOpticalUploadPlan plan)const{
        return !this.m_retired && !this.m_quarantined && plan.valid() && plan.owner == ObjectAddressKey(this) && plan.buffer.identity() == this.m_buffer.identity() && plan.queue == this.m_primaryQueue
            && this.m_primaryQueue.deviceGeneration == this.m_buffer.deref().getDeviceGeneration();
    }
}

type RayTracingOpticalUploadControlHandle = Shared<RayTracingOpticalUploadState>;

Expected<RayTracingOpticalUploadControlHandle> CreateRayTracingOpticalUploadControl(in SharedPool pool, in BufferHandle buffer, in GpuPhysicalQueueId primaryQueue){
    if(!buffer.valid() || !primaryQueue.valid() || primaryQueue.deviceGeneration != buffer.deref().getDeviceGeneration())
        return MakeUnexpected(Failure());
    return pool.make<RayTracingOpticalUploadState>(buffer, primaryQueue);
}

[move_only]
class RayTracingOpticalUploadReservation{
    private PlanReservation<RayTracingOpticalUploadControlHandle, RayTracingOpticalUploadPlan> m_lease;

    public RayTracingOpticalUploadReservation(in RayTracingOpticalUploadControlHandle control, in RayTracingOpticalUploadPlan plan){
        this.m_lease = PlanReservation<RayTracingOpticalUploadControlHandle, RayTracingOpticalUploadPlan>(control, plan, !plan.reused);
    }

    public b8 valid()const{
        if(!this.m_lease.valid())
            return false;
        const RayTracingOpticalUploadControlHandle control = this.m_lease.control();
        return control.deref().isReserved(this.m_lease.plan());
    }

    public b8 accept(in QueueSubmissionToken token){
        if(!this.m_lease.valid())
            return false;
        const RayTracingOpticalUploadControlHandle control = this.m_lease.control();
        const b8 accepted = control.deref().accept(this.m_lease.plan(), token);
        if(accepted)
            this.m_lease.release();
        else
            this.m_lease.discard();
        return accepted;
    }

    public void discard(){
        this.m_lease.discard();
    }
}


