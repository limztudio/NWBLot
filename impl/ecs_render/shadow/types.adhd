enum<u8> SoftShadowOpaqueResolvePhase{
    TemporalAndWavelet,
    TemporalOnly,
    WaveletOnly
}

// Soft resolve either overwrites visibility or multiplies transparent transmittance.
enum<u32> SoftShadowUpsampleFold{
    Overwrite = 0u,
    Multiply
}

enum<u8> PreparedShadowMaterialContextRoute{
    None = 0u,
    Hardware = 1u,
    Software = 2u
}

// Shader-mirrored shadow resolve stages.
enum<u32> ShadowResolveStage{
    Wavelet = 1u,
    Upsample = 2u
}

flag<u8> PreparedShadowTraceGeometryRole{
    None = 0u,
    HardwarePosition,
    HardwareIndex,
    HardwareAttribute,
    SoftwareNode,
    SoftwarePosition,
    SoftwareIndex,
    SoftwareAttribute
}

