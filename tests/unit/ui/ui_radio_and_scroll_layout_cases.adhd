void VerifyUiScrollLayoutTests_ExtremeFiniteOffsetClampsBeforeProducingVisibleFloatGeometry(){
    const Rect bounds = Rect(10.0f, 20.0f, 240.0f, 128.0f);
    const auto placementResult = CalculateScrollPlacement(bounds, bounds, Insets(), 12.0f, 16.0f, 100000u, 32.0f, f64.max);
    ASSERT_TRUE(placementResult.has_value());
    const ScrollPlacement placement = placementResult.value();
    EXPECT_DOUBLE_EQ(placement.offset, 3199872.0);
    EXPECT_EQ(placement.firstRow, 99996u);
    EXPECT_EQ(placement.endRow, 100000u);
    const auto lastResult = CalculateScrollRowBounds(99999u, placement, 32.0f);
    ASSERT_TRUE(lastResult.has_value());
    ExpectUiRect(lastResult.value(), Rect(10.0f, 116.0f, 228.0f, 32.0f));
}

