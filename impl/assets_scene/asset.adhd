////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_scene/components.adhd>
#include <impl/assets_scene/scene_assets.adhd>
#include <impl/assets_subsystem/asset.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type ComponentRef = AssetRef<IComponent>;
type ComponentRefVector = Vector<ComponentRef>;
type SceneRef = AssetRef<SceneAsset>;
type SubsystemRef = AssetRef<ISubsystem>;
type EntityRef = AssetRef<EntityAsset>;
type SceneAssetRef = AssetRef<IAsset>;
type SubsystemRefVector = Vector<SubsystemRef>;
type EntityRefVector = Vector<EntityRef>;
type AssetMap = HashMap<Name, SceneAssetRef>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena, asset("entity")]
class EntityAsset{
    private ComponentRefVector m_components;

    public b8 validatePayload()const;
    public b8 validatePayload(mut ScratchArena scratchArena)const;
    public b8 loadBinary(in Span<u8> binary);

    public void setComponents(in ComponentRefVector components){
        this.m_components = components;
    }

    public ComponentRefVector takeComponents(){
        ComponentRefVector result = this.m_components;
        this.m_components.clear();
        return result;
    }

    public in ComponentRefVector components()const{
        return this.m_components;
    }
}

[arena, asset("project")]
class ProjectAsset{
    private SceneRef m_startScene;

    public b8 validatePayload()const;
    public b8 loadBinary(in Span<u8> binary);

    public void setStartScene(in SceneRef startScene){
        this.m_startScene = startScene;
    }

    public in SceneRef startScene()const{
        return this.m_startScene;
    }
}

[arena, asset("scene")]
class SceneAsset{
    private SubsystemRefVector m_subsystems;
    private EntityRefVector m_entities;
    private AssetMap m_assets;

    public b8 validatePayload()const;
    public b8 validatePayload(mut ScratchArena scratchArena)const;
    public b8 loadBinary(in Span<u8> binary);

    public void setContents(
        in SubsystemRefVector subsystems,
        in AssetMap assets,
        in EntityRefVector entities
    ){
        this.m_subsystems = subsystems;
        DeduplicateSubsystemRefs(this.m_subsystems);
        this.m_entities = entities;
        this.m_assets = assets;
    }

    public void takeContents(
        mut SubsystemRefVector outSubsystems,
        mut AssetMap outAssets,
        mut EntityRefVector outEntities
    ){
        outSubsystems = this.m_subsystems;
        this.m_subsystems.clear();
        outAssets = this.m_assets;
        this.m_assets.clear();
        outEntities = this.m_entities;
        this.m_entities.clear();
    }

    public in SubsystemRefVector subsystems()const{ return this.m_subsystems; }
    public in EntityRefVector entities()const{ return this.m_entities; }
    public in AssetMap assets()const{ return this.m_assets; }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_scene/components.adhd.h>
#include <impl/assets_scene/scene_assets.adhd.h>
#include <impl/assets_subsystem/asset.adhd.h>

#include <core/assets/manager.h>
#include <core/assets/ref.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class EntityAsset;
class ProjectAsset;
class SceneAsset;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


inline constexpr TStringView s_ProjectAssetKindLabel = FOUNDATION_TEXT("project");
inline constexpr TStringView s_ProjectLoadBinaryContext = FOUNDATION_TEXT("ProjectAsset::loadBinary");
#if defined(NWB_COOK)
inline constexpr TStringView s_ProjectSerializeContext = FOUNDATION_TEXT("ProjectAssetCodec::serialize");
#endif

inline constexpr TStringView s_ComponentLoadBinaryContext = FOUNDATION_TEXT("IComponent::loadBinary");
#if defined(NWB_COOK)
inline constexpr TStringView s_ComponentSerializeContext = FOUNDATION_TEXT("ComponentAssetCodec::serialize");
#endif

inline constexpr TStringView s_EntityAssetKindLabel = FOUNDATION_TEXT("entity");
inline constexpr TStringView s_EntityLoadBinaryContext = FOUNDATION_TEXT("EntityAsset::loadBinary");
#if defined(NWB_COOK)
inline constexpr TStringView s_EntitySerializeContext = FOUNDATION_TEXT("EntityAssetCodec::serialize");
#endif
inline constexpr TStringView s_EntityComponentsPayloadLabel = FOUNDATION_TEXT("entity components");

inline constexpr TStringView s_SceneAssetKindLabel = FOUNDATION_TEXT("scene");
inline constexpr TStringView s_SceneLoadBinaryContext = FOUNDATION_TEXT("SceneAsset::loadBinary");
#if defined(NWB_COOK)
inline constexpr TStringView s_SceneSerializeContext = FOUNDATION_TEXT("SceneAssetCodec::serialize");
#endif
inline constexpr TStringView s_SceneSubsystemsPayloadLabel = FOUNDATION_TEXT("scene subsystems");
inline constexpr TStringView s_SceneEntitiesPayloadLabel = FOUNDATION_TEXT("scene entities");
inline constexpr TStringView s_SceneAssetsPayloadLabel = FOUNDATION_TEXT("scene referenced assets");

inline constexpr Core::Assets::AssetRef<ProjectAsset> s_DefaultProjectRef(s_DefaultProjectVirtualPathText);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ActiveSceneSubsystems final{
public:
    using ProjectRef = Core::Assets::AssetRef<ProjectAsset>;
    using SceneRef = Core::Assets::AssetRef<SceneAsset>;
    using SubsystemRef = ISubsystem::SubsystemRef;
    using EntityRef = Core::Assets::AssetRef<EntityAsset>;
    using ComponentRef = Core::Assets::AssetRef<IComponent>;
    using AssetMap = HashMap<Name, Core::Assets::AssetRef<Core::Assets::IAsset>, ::ArenaBase>;
    using LoadedSubsystemVector = Vector<UniquePtr<ISubsystem>, Core::Alloc::GlobalArena>;
    using LoadedComponentVector = Vector<UniquePtr<IComponent>, Core::Alloc::GlobalArena>;


public:
    struct LoadedEntity{
        EntityRef entity;
        LoadedComponentVector components;


    public:
        LoadedEntity(const EntityRef& inEntity, LoadedComponentVector&& inComponents)noexcept
            : entity(inEntity)
            , components(Move(inComponents))
        {}
    };

    using LoadedEntityVector = Vector<LoadedEntity, Core::Alloc::GlobalArena>;


public:
    explicit ActiveSceneSubsystems(Core::Alloc::GlobalArena& arena)noexcept
        : m_arena(arena)
        , m_sceneAssets(0, Hasher<Name>(), EqualTo<Name>(), arena)
        , m_loadedSubsystems(arena)
        , m_loadedEntities(arena)
    {}


public:
    [[nodiscard]] b8 loadProjectStartScene(Core::Assets::AssetManager& assetManager, const ProjectRef& project = s_DefaultProjectRef);
    [[nodiscard]] b8 loadScene(const SceneRef& scene, Core::Assets::AssetManager& assetManager);
    [[nodiscard]] b8 instantiateEntities(Core::ECS::World& world)const;

    [[nodiscard]] b8 valid()const noexcept{ return m_scene.valid() && !m_loadedSubsystems.empty(); }
    [[nodiscard]] const SceneRef& scene()const noexcept{ return m_scene; }
    [[nodiscard]] usize subsystemCount()const noexcept{ return m_loadedSubsystems.size(); }

    template<typename SubsystemT>
    [[nodiscard]] const SubsystemT* findSubsystem()const noexcept{
        for(const UniquePtr<ISubsystem>& loaded : m_loadedSubsystems){
            if(loaded && loaded->assetType() == SubsystemT::AssetTypeName())
                return checked_cast<const SubsystemT*>(loaded.get());
        }
        return nullptr;
    }

    template<typename SubsystemT>
    [[nodiscard]] b8 hasSubsystem()const noexcept{
        return findSubsystem<SubsystemT>() != nullptr;
    }

    template<typename TAsset = Core::Assets::IAsset>
    [[nodiscard]] Core::Assets::AssetRef<TAsset> findSceneAsset(const Name& nickname)const noexcept{
        if(!nickname)
            return {};
        const auto found = m_sceneAssets.find(nickname);
        if(found == m_sceneAssets.end())
            return {};
        Core::Assets::AssetRef<TAsset> result;
        result.virtualPath = found.value().name();
        return result;
    }


private:
    Core::Alloc::GlobalArena& m_arena;
    SceneRef m_scene;
    AssetMap m_sceneAssets;
    LoadedSubsystemVector m_loadedSubsystems;
    LoadedEntityVector m_loadedEntities;
};

using ActiveSceneSubsystemsConstPtr = const ActiveSceneSubsystems*;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
