////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_BVH_COMMON_SLANGI
#define NWB_GRAPHICS_BVH_COMMON_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "constants.h"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Binary LBVH node (2N-1 nodes for N prims; 0 = root).
// Leaf: NWB_BVH_LEAF_FLAG + prim index/count in children.
// Decode rightChild via nwbBvhNodeRightChildIndex() (transparent-subtree tag).
// 32 bytes / 2 float4 lanes.
struct NwbBvhNode{
    float3 aabbMin;
    uint leftChild;
    float3 aabbMax;
    uint rightChild;
};

// Per-dispatch constants shared by the LBVH build kernels (Morton, topology, fit). aabbMin/aabbMax are the object-space bounds used to quantize centroids into Morton codes.
struct NwbBvhBuildPushConstants{
    uint primitiveCount;
    uint internalCount;
    uint refitMode;
    uint positionHeapSlot;
    uint triangleIndexHeapSlot;
    uint keysHeapSlot;
    uint payloadHeapSlot;
    uint nodeHeapSlot;
    float3 aabbMin;
    uint parentHeapSlot;
    float3 aabbMax;
    uint visitCounterHeapSlot;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static const uint NWB_BVH_KEY_BIT_COUNT = 32u;
static const uint NWB_BVH_KEY_HIGHEST_BIT = 31u;

// Karras Morton expansion: each multiply copies the bits up by the shift, and the mask keeps one copy.
static const uint NWB_BVH_MORTON_EXPAND_MULTIPLY_16 = 0x00010001u;
static const uint NWB_BVH_MORTON_EXPAND_MASK_16 = 0xFF0000FFu;
static const uint NWB_BVH_MORTON_EXPAND_MULTIPLY_8 = 0x00000101u;
static const uint NWB_BVH_MORTON_EXPAND_MASK_8 = 0x0F00F00Fu;
static const uint NWB_BVH_MORTON_EXPAND_MULTIPLY_4 = 0x00000011u;
static const uint NWB_BVH_MORTON_EXPAND_MASK_4 = 0xC30C30C3u;
static const uint NWB_BVH_MORTON_EXPAND_MULTIPLY_2 = 0x00000005u;
static const uint NWB_BVH_MORTON_EXPAND_MASK_2 = 0x49249249u;

static const float NWB_BVH_MORTON_AXIS_CELL_COUNT = 1024.0;
static const float NWB_BVH_MORTON_AXIS_CELL_MAX = 1023.0;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


bool nwbBvhNodeIsLeaf(const NwbBvhNode node){
    return (node.leftChild & NWB_BVH_LEAF_FLAG) != 0u;
}

uint nwbBvhLeafPrimitive(const NwbBvhNode node){
    return node.leftChild & ~NWB_BVH_LEAF_FLAG;
}

// Keep the invalid sentinel while stripping the CPU transparent-subtree tag from a valid right-child link. Per-mesh GPU BVHs never set it, so this is also their identity decode.
uint nwbBvhNodeRightChildIndex(const NwbBvhNode node){
    return node.rightChild == NWB_BVH_INVALID ? NWB_BVH_INVALID : (node.rightChild & NWB_BVH_CHILD_INDEX_MASK);
}

bool nwbBvhNodeContainsTransparentOccluder(const NwbBvhNode node){
    return (node.rightChild & NWB_BVH_TRANSPARENT_SUBTREE_FLAG) != 0u;
}

// Count leading zero bits (0..32); firstbithigh returns -1 for zero, which this maps to 32.
uint nwbBvhClz(const uint value){
    if(value == 0u)
        return NWB_BVH_KEY_BIT_COUNT;
    return NWB_BVH_KEY_HIGHEST_BIT - (uint)firstbithigh(value);
}

// Spread the low 10 bits of value so they occupy every third bit (Karras Morton expansion).
uint nwbBvhExpandBits10(uint value){
    value = (value * NWB_BVH_MORTON_EXPAND_MULTIPLY_16) & NWB_BVH_MORTON_EXPAND_MASK_16;
    value = (value * NWB_BVH_MORTON_EXPAND_MULTIPLY_8) & NWB_BVH_MORTON_EXPAND_MASK_8;
    value = (value * NWB_BVH_MORTON_EXPAND_MULTIPLY_4) & NWB_BVH_MORTON_EXPAND_MASK_4;
    value = (value * NWB_BVH_MORTON_EXPAND_MULTIPLY_2) & NWB_BVH_MORTON_EXPAND_MASK_2;
    return value;
}

// 30-bit Morton code (10 bits/axis) of a point already normalized into [0, 1]^3.
uint nwbBvhMorton3D(const float3 normalizedPosition){
    const float3 scaled = clamp(normalizedPosition * NWB_BVH_MORTON_AXIS_CELL_COUNT, 0.0, NWB_BVH_MORTON_AXIS_CELL_MAX);
    const uint x = nwbBvhExpandBits10((uint)scaled.x);
    const uint y = nwbBvhExpandBits10((uint)scaled.y);
    const uint z = nwbBvhExpandBits10((uint)scaled.z);
    return (x << 2) | (y << 1) | z;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

