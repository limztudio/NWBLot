class PhysicsGpuBufferSlot{
    public BufferHandle buffer;
    public GpuDescriptorHandle descriptor;
    public BufferHandle readback;
    public u32 capacity = 0u;
    public u32 readbackCapacity = 0u;
    public u32 stride = 0u;
    public b8 isIndirectArgs = false;
    public b8 cpuReadable = false;

    public b8 hasValidUav()const{
        return this.buffer.valid() && this.descriptor.valid();
    }
}

class PhysicsGpuColorSlice{
    public u32 offset = 0u;
    public u32 count = 0u;
}

class PhysicsGpuBufferGroup{
    public BufferHandle bodySimBuffer;
    public BufferHandle bodyStateBuffer;
    public BufferHandle bodyOutBuffer;
    public BufferHandle shapeBuffer;
    public BufferHandle pairBuffer;
    public BufferHandle counterBuffer;
    public BufferHandle counterReadback;
    public BufferHandle indirectArgsBuffer;
    public BufferHandle gridBuffer;
    public BufferHandle largeListBuffer;
    public BufferHandle hullVertexBuffer;
    public BufferHandle meshNodeBuffer;
    public BufferHandle meshTriBuffer;
    public BufferHandle manifoldBuffer;
    public BufferHandle constraintBuffer;
    public BufferHandle contactImpulseOutBuffer;
    public BufferHandle jointConstraintBuffer;
    public BufferHandle jointImpulseOutBuffer;
    public BufferHandle islandSliceBuffer;
    public u32x4 slots0;
    public u32x4 slots1;
    public u32x4 slots2;

    public PhysicsGpuBufferGroup(){
        this.slots0 = u32x4(s_GpuInvalidIndex, s_GpuInvalidIndex, s_GpuInvalidIndex, s_GpuInvalidIndex);
        this.slots1 = u32x4(s_GpuInvalidIndex, s_GpuInvalidIndex, s_GpuInvalidIndex, s_GpuInvalidIndex);
        this.slots2 = u32x4(s_GpuInvalidIndex, s_GpuInvalidIndex, s_GpuInvalidIndex, s_GpuInvalidIndex);
    }
}

[cpp_unwind]
void ReleasePhysicsGpuBufferSlot(mut GpuDescriptorHeap heap, mut PhysicsGpuBufferSlot slot){
    if(slot.descriptor.valid() && heap.isInitialized())
        heap.free(slot.descriptor);
    slot.descriptor = GpuDescriptorHandle();
    slot.buffer.reset();
    slot.readback.reset();
    slot.capacity = 0u;
    slot.readbackCapacity = 0u;
    slot.stride = 0u;
    slot.isIndirectArgs = false;
    slot.cpuReadable = false;
}

[cpp_unwind]
b8 EnsurePhysicsGpuStorageBuffer(
    mut GraphicsRuntime graphics,
    mut GpuDescriptorHeap heap,
    in Name debugName,
    in u32 stride,
    in u32 requiredCount,
    in b8 isIndirectArgs,
    in b8 cpuReadable,
    mut PhysicsGpuBufferSlot slot
){
    const u32 targetCount = Max(requiredCount, 64u);
    if(slot.hasValidUav() && slot.stride == stride && slot.isIndirectArgs == isIndirectArgs && slot.cpuReadable == cpuReadable && slot.capacity >= targetCount)
        return true;

    const u32 newCap = Max(targetCount, slot.capacity * 2u);
    if(slot.buffer.valid() || slot.descriptor.valid()){
        if(!graphics.waitForIdle())
            return false;
        if(slot.descriptor.valid() && heap.isInitialized())
            heap.free(slot.descriptor);
        slot.descriptor = GpuDescriptorHandle();
        slot.buffer.reset();
        slot.capacity = 0u;
        slot.isIndirectArgs = false;
        slot.cpuReadable = false;
    }

    BufferDesc desc;
    desc
        .setDebugName(debugName)
        .setByteSize(cast<u64>(newCap) * cast<u64>(stride))
        .setStructStride(stride)
        .setCanHaveUAVs(true)
        .setIsDrawIndirectArgs(isIndirectArgs)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;
    if(cpuReadable)
        desc.setCpuAccess(CpuAccessMode::Read);
    const Expected<BufferHandle> bufferResult = graphics.createBuffer(desc);
    if(!bufferResult.has_value())
        return false;

    const Expected<GpuDescriptorHandle> descResult = heap.allocate(GpuDescriptorClass::StorageBuffer);
    if(!descResult.has_value())
        return false;
    GpuDescriptorRetirementGuard retire(heap, descResult.value());
    if(!heap.write(descResult.value(), DescriptorWriteItemStructuredBufferUav(0u, bufferResult.value().deref())))
        return false;
    retire.release();

    slot.buffer = bufferResult.value();
    slot.descriptor = descResult.value();
    slot.capacity = newCap;
    slot.stride = stride;
    slot.isIndirectArgs = isIndirectArgs;
    slot.cpuReadable = cpuReadable;
    return true;
}

[cpp_unwind]
b8 EnsurePhysicsGpuReadbackBuffer(
    mut GraphicsRuntime graphics,
    in Name debugName,
    in u32 stride,
    in u32 requiredCount,
    mut PhysicsGpuBufferSlot slot
){
    const u32 targetCount = Max(requiredCount, 64u);
    if(slot.readback.valid() && slot.stride == stride && slot.readbackCapacity >= targetCount)
        return true;

    const u32 newCap = Max(targetCount, slot.readbackCapacity * 2u);
    if(slot.readback.valid()){
        if(!graphics.waitForIdle())
            return false;
        slot.readback.reset();
        slot.readbackCapacity = 0u;
    }

    BufferDesc desc;
    desc
        .setDebugName(debugName)
        .setByteSize(cast<u64>(newCap) * cast<u64>(stride))
        .setStructStride(stride)
        .setCanHaveUAVs(false)
        .setCpuAccess(CpuAccessMode::Read)
        .enableAutomaticStateTracking(ResourceStates::CopyDest)
    ;
    const Expected<BufferHandle> rbResult = graphics.createBuffer(desc);
    if(!rbResult.has_value())
        return false;

    slot.readback = rbResult.value();
    slot.readbackCapacity = newCap;
    return true;
}

[cpp_unwind]
b8 ImportBufferUse(
    mut GpuTaskGraph graph,
    in BufferHandle buffer,
    in StringView label,
    in ResourceStates state,
    in GpuTaskResourceAccess access,
    mut GpuTaskResourceUse outUse
){
    GpuGraphResourceDesc desc;
    desc
        .setIdentity(buffer.deref().getCreationDescription().debugName)
        .setMarkerLabel(label)
        .setType(GpuGraphResourceType::Buffer)
        .setInitialState(state)
        .setExternalFinalState(state)
    ;
    const auto resource = graph.importBuffer(buffer, desc);
    if(!resource.has_value())
        return false;
    outUse.resource = resource.value();
    outUse.requiredState = state;
    outUse.access = access;
    return true;
}

[cpp_unwind]
b8 LoadPhysicsComputePipeline(
    mut GraphicsRuntime graphics,
    mut AssetManager assetManager,
    mut ShaderArchivePathResolver shaderPathResolver,
    in BindingLayoutHandle bindingLayout,
    in Name shaderName,
    in StringView variantName,
    in Name debugName,
    mut ShaderHandle outShader,
    mut ComputePipelineHandle outPipeline
){
    if(outPipeline.valid())
        return true;
    if(!shaderName || !bindingLayout.valid())
        return false;

    if(!Load<ComputeShader, ShaderArchivePathResolver>(
        shaderName,
        variantName,
        debugName,
        s_PhysicsGpuAssetOwnerName,
        graphics,
        assetManager,
        shaderPathResolver,
        Optional<Name>(),
        outShader
    ))
        return false;

    mut Device device = graphics.getDevice();
    in GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized())
        return false;

    ComputePipelineDesc desc;
    desc.setComputeShader(outShader).addBindingLayout(bindingLayout).addBindingLayout(heap.getResourceLayout()).addBindingLayout(heap.getSamplerLayout());
    const Expected<ComputePipelineHandle> pipeResult = device.createComputePipeline(desc);
    if(!pipeResult.has_value()){
        outPipeline.reset();
        return false;
    }
    outPipeline = pipeResult.value();
    return true;
}


