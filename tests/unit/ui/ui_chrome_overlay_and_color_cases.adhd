    public WidgetId pickerId()const{
        return this.id("cp", "panel");
    }

    public Point partPoint(in StringView partKey, in f32 nx, in f32 ny){
        const auto idOpt = TryMakeWidgetId(this.pickerId(), partKey);
        EXPECT_TRUE(idOpt.has_value());
        const auto tgt = this.tryTarget(idOpt.value());
        EXPECT_TRUE(tgt.has_value());
        if(!tgt.has_value())
            return Point();
        in Rect r = tgt.value().rectangle;
        return Point(r.x + r.width * nx, r.y + r.height * ny);
