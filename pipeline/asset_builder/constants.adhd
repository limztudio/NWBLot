const StringView s_DefaultPipelineConfig = "default";
const StringView s_AssetCacheDirectory = "__asset_cache";
const Name s_AssetBuilderArena = "pipeline/asset_builder";
const u32 s_MinParallelCoreCount = 1u;

u32 ComputeWorkerCoreCount(in u32 cores){
    if(cores > s_MinParallelCoreCount)
        return cores - s_MinParallelCoreCount;
    return 0u;
}

b8 ValidateAssetBuildType(in StringView assetType, in StringView expectedAssetVolumeName){
    if(assetType != expectedAssetVolumeName){
        error("AssetBuilder: unsupported --asset-type '{}'. Available types: graphics", assetType);
        return false;
    }
    return true;
}

b8 ValidateAssetBuilderPathInputs(in b8 hasAssetRoots, in b8 hasOutputDirectory){
    if(!hasAssetRoots){
        error("AssetBuilder: no asset roots specified");
        return false;
    }
    if(!hasOutputDirectory){
        error("AssetBuilder: output directory is empty");
        return false;
    }
    return true;
}

b8 IsValidAssetBuildVirtualRoot(in StringView virtualRoot, in StringView engineVirtualRoot, in StringView projectVirtualRoot){
    return virtualRoot == engineVirtualRoot || virtualRoot == projectVirtualRoot;
}


