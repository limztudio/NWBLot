class RendererRayTracingSystem;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ShadowMaterialContextPreparer final : NoCopy{
public:
    explicit ShadowMaterialContextPreparer(RendererRayTracingSystem& system)noexcept
        : m_system(system)
    {}


public:
    [[nodiscard]] Expected<u64> prepare(
        PreparedShadowMaterialContextRoute::Enum route,
        b8 staticScene,
        usize sceneInstanceCount,
        Span<const NwbRtInstanceMaterialGpu> instanceMaterials,
        Span<const InstanceGpuData> shadowInstanceData,
        MaterialTypedByteDataVector& shadowMaterialTypedBytes
    );


private:
    RendererRayTracingSystem& m_system;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


