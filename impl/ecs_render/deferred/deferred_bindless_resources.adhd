        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.transparentHistB = descriptor.value();
    descriptor = RegisterStorageTexture(this.m_heap, this.m_targets.transparentHistB, this.m_targets.shadowSoftFormat, TextureDimension::Texture2DArray);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.transparentHistBStorage = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage2DArray, this.m_targets.transparentMomentsA, this.m_targets.shadowSoftFormat, s_ShadowVisibilitySubresources, TextureDimension::Texture2DArray);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.transparentMomentsA = descriptor.value();
    descriptor = RegisterStorageTexture(this.m_heap, this.m_targets.transparentMomentsA, this.m_targets.shadowSoftFormat, TextureDimension::Texture2DArray);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.transparentMomentsAStorage = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage2DArray, this.m_targets.transparentMomentsB, this.m_targets.shadowSoftFormat, s_ShadowVisibilitySubresources, TextureDimension::Texture2DArray);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.transparentMomentsB = descriptor.value();
    descriptor = RegisterStorageTexture(this.m_heap, this.m_targets.transparentMomentsB, this.m_targets.shadowSoftFormat, TextureDimension::Texture2DArray);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.transparentMomentsBStorage = descriptor.value();
    return Expected<void>();
}


