void VerifyUiRadioGroupBuilderTests_TemporaryLabelsAreOwnedBeforeTheNextSourceCallback(mut UiRadioGroupBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    const DrawSnapshot actual = self.m_paint.freeze();
    self.verifyTemporaryLabelsOwned(actual);
}

void VerifyUiRadioGroupBuilderTests_SelectionCommitsOnReleaseAndNotOnPress(mut UiRadioGroupBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    const Point point = self.choicePoint(20u);
    EXPECT_TRUE(self.send(MakeUiRadioPointEvent(InputEventType::PrimaryDown, point)).pointerConsumed);
    ASSERT_TRUE(self.accept(2u));
    EXPECT_EQ(self.m_state.selectedKey(), 10u);
    EXPECT_FALSE(self.m_result.selectionChanged);
    EXPECT_FALSE(self.m_result.activated);
    EXPECT_TRUE(self.send(MakeUiRadioPointEvent(InputEventType::PrimaryUp, point)).pointerConsumed);
    ASSERT_TRUE(self.accept(3u));
    EXPECT_EQ(self.m_state.selectedKey(), 20u);
    EXPECT_TRUE(self.m_result.selectionChanged);
    EXPECT_TRUE(self.m_result.activated);
}

void VerifyUiRadioGroupBuilderTests_ReleaseOutsideAndDisabledChoiceCannotActivate(mut UiRadioGroupBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    self.drag(self.choicePoint(20u), MakeUiProgressPoint(700.0f, 500.0f));
    ASSERT_TRUE(self.accept(2u));
    EXPECT_EQ(self.m_state.selectedKey(), 10u);
    EXPECT_FALSE(self.m_result.activated);
    self.click(self.choicePoint(30u));
    ASSERT_TRUE(self.accept(3u));
    EXPECT_EQ(self.m_state.selectedKey(), 10u);
    EXPECT_FALSE(self.m_result.selectionChanged);
    EXPECT_FALSE(self.m_result.activated);
}

void VerifyUiRadioGroupBuilderTests_HorizontalAndVerticalKeysShareTheHostAndSkipDisabledChoices(mut UiRadioGroupBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    self.press(Key::Tab);
    const u64 token = self.m_state.inputGeneration();
    self.press(Key::Right);
    self.press(Key::Down);
    ASSERT_TRUE(self.accept(2u));
    EXPECT_EQ(self.m_state.selectedKey(), 40u);
    EXPECT_TRUE(self.m_result.selectionChanged);
    EXPECT_FALSE(self.m_result.activated);
    EXPECT_EQ(self.m_state.inputGeneration(), token);
    self.press(Key::End);
    self.press(Key::Right);
    ASSERT_TRUE(self.accept(3u));
    EXPECT_EQ(self.m_state.selectedKey(), 10u);
    self.press(Key::Left);
    ASSERT_TRUE(self.accept(4u));
    EXPECT_EQ(self.m_state.selectedKey(), 50u);
    self.press(Key::Home);
    self.press(Key::Up);
    ASSERT_TRUE(self.accept(5u));
    EXPECT_EQ(self.m_state.selectedKey(), 50u);
}

void VerifyUiRadioGroupBuilderTests_HeldSubmitWaitsForReleaseWhileAnUnchangedChoiceStaysSelected(mut UiRadioGroupBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    self.press(Key::Tab);
    InputEvent event = InputEvent();
    event.type = InputEventType::KeyDown;
    event.key = Key::Enter;
    EXPECT_TRUE(self.send(event).commandConsumed);
    ASSERT_TRUE(self.accept(2u));
    EXPECT_FALSE(self.m_result.activated);
    EXPECT_FALSE(self.m_result.selectionChanged);
    event.repeat = true;
    EXPECT_TRUE(self.send(event).commandConsumed);
    ASSERT_TRUE(self.accept(3u));
    EXPECT_FALSE(self.m_result.activated);
    event.type = InputEventType::KeyUp;
    event.repeat = false;
    EXPECT_TRUE(self.send(event).commandConsumed);
    ASSERT_TRUE(self.accept(4u));
    EXPECT_TRUE(self.m_result.activated);
    EXPECT_FALSE(self.m_result.selectionChanged);
    self.press(Key::Space);
    ASSERT_TRUE(self.accept(5u));
    EXPECT_TRUE(self.m_result.activated);
    EXPECT_FALSE(self.m_result.selectionChanged);
}

void VerifyUiRadioGroupBuilderTests_EscapeBeforeReleaseCancelsPointerAndKeyboardSubmission(mut UiRadioGroupBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    const Point point = self.choicePoint(20u);
    EXPECT_TRUE(self.send(MakeUiRadioPointEvent(InputEventType::PrimaryDown, point)).pointerConsumed);
    ASSERT_TRUE(self.accept(2u));
    EXPECT_FALSE(self.m_result.activated);
    self.press(Key::Escape);
    EXPECT_TRUE(self.send(MakeUiRadioPointEvent(InputEventType::PrimaryUp, point)).pointerConsumed);
    ASSERT_TRUE(self.accept(3u));
    EXPECT_EQ(self.m_state.selectedKey(), 10u);
    EXPECT_FALSE(self.m_result.activated);
    EXPECT_FALSE(self.m_result.selectionChanged);
    self.press(Key::Tab);
    ASSERT_EQ(self.m_context.input().focus(), self.host());
    EXPECT_TRUE(self.send(MakeUiRadioKeyEvent(InputEventType::KeyDown, Key::Enter)).commandConsumed);
    ASSERT_TRUE(self.accept(4u));
    EXPECT_FALSE(self.m_result.activated);
    self.press(Key::Escape);
    EXPECT_TRUE(self.send(MakeUiRadioKeyEvent(InputEventType::KeyUp, Key::Enter)).commandConsumed);
    ASSERT_TRUE(self.accept(5u));
    EXPECT_EQ(self.m_state.selectedKey(), 10u);
    EXPECT_FALSE(self.m_result.activated);
    EXPECT_FALSE(self.m_result.selectionChanged);
    self.press(Key::Tab);
    ASSERT_EQ(self.m_context.input().focus(), self.host());
    self.press(Key::Enter);
    ASSERT_TRUE(self.accept(6u));
    EXPECT_TRUE(self.m_result.activated);
    EXPECT_FALSE(self.m_result.selectionChanged);
}

void VerifyUiRadioGroupBuilderTests_SelectedDisabledChoiceKeepsItsCheckedFrameAndMark(mut UiRadioGroupBuilderTests self){
    self.m_state.select(30u);
    ASSERT_TRUE(self.accept(1u));
    EXPECT_EQ(self.m_state.selectedKey(), 30u);
    EXPECT_EQ(self.m_state.cursorKey(), 40u);
    const WidgetId part = RequireUiWidgetPartId(RequireUiWidgetId(self.host(), "choices"), 30u);
    const auto partTarget = self.findTarget(part);
    ASSERT_TRUE(partTarget.has_value());
    EXPECT_FALSE(partTarget.value().enabled);
    const DrawSnapshot snapshot = self.m_paint.freeze();
    EXPECT_EQ(self.regionQuads(snapshot, s_UiInputNameRadioChecked), 1u);
    EXPECT_EQ(self.regionQuads(snapshot, s_UiInputNameRadioMark), 1u);
}

void VerifyUiRadioGroupBuilderTests_WholeDisabledGroupKeepsThePanelBarrierAndRetiresQueuedNavigation(mut UiRadioGroupBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    self.press(Key::Tab);
    self.press(Key::Right);
    RadioGroupOptions options = RadioGroupOptions();
    options.enabled = false;
    ASSERT_TRUE(self.accept(2u, options));
    EXPECT_EQ(self.m_state.selectedKey(), 10u);
    EXPECT_FALSE(self.m_result.activated);
    const auto hostTarget = self.findTarget(self.host());
    ASSERT_TRUE(hostTarget.has_value());
    EXPECT_FALSE(hostTarget.value().enabled);
    EXPECT_FALSE(hostTarget.value().focusable);
    EXPECT_FALSE(self.hasTarget(RequireUiWidgetPartId(RequireUiWidgetId(self.host(), "choices"), 10u)));
    const Point point = self.choicePoint(10u);
    EXPECT_EQ(self.m_context.input().hitTest(point), RequireUiWidgetId(RequireUiRootId(self.m_root), s_UiRadioCasePanelKey));
    EXPECT_TRUE(self.send(MakeUiRadioPointEvent(InputEventType::PrimaryDown, point)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiRadioPointEvent(InputEventType::PrimaryUp, point)).pointerConsumed);
    ASSERT_TRUE(self.accept(3u, options));
    EXPECT_EQ(self.m_state.selectedKey(), 10u);
    EXPECT_FALSE(self.m_result.selectionChanged);
}

void VerifyUiRadioGroupBuilderTests_EmptyAndAllDisabledSourcesAreValidWithoutATabStop(mut UiRadioGroupBuilderTests self){
    self.m_source.m_count = 0u;
    ASSERT_TRUE(self.accept(1u));
    EXPECT_EQ(self.m_state.placement().count, 0u);
    EXPECT_EQ(self.m_state.selectedKey(), 0u);
    const auto emptyHost = self.findTarget(self.host());
    ASSERT_TRUE(emptyHost.has_value());
    EXPECT_FALSE(emptyHost.value().focusable);
    self.m_source.m_count = 5u;
    self.m_source.m_allDisabled = true;
    ++self.m_source.m_contentRevision;
    self.m_state.select(30u);
    ASSERT_TRUE(self.accept(2u));
    EXPECT_EQ(self.m_state.selectedKey(), 30u);
    EXPECT_EQ(self.m_state.cursorKey(), 0u);
    const auto disabledHost = self.findTarget(self.host());
    ASSERT_TRUE(disabledHost.has_value());
    EXPECT_FALSE(disabledHost.value().enabled);
    EXPECT_FALSE(self.m_result.activated);
}

void VerifyUiRadioGroupBuilderTests_SixtyFourChoicesSucceedAndTheSixtyFifthRejectsAtomically(mut UiRadioGroupBuilderTests self){
    self.m_source.m_count = 64u;
    ASSERT_TRUE(self.accept(1u));
    EXPECT_EQ(self.m_state.placement().count, 64u);
    const UiRadioAcceptedInputState displayed = self.accepted();
    const RadioGroupSnapshot saved = self.m_state.snapshot();
    self.m_source.resetCounters();
    self.m_source.m_count = 65u;
    ++self.m_source.m_contentRevision;
    EXPECT_FALSE(self.declare(2u));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_TRUE(self.m_state.matches(saved));
    EXPECT_EQ(self.m_source.m_textCalls, 0u);
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    self.expectAccepted(displayed);
}

void VerifyUiRadioGroupBuilderTests_DuplicateStableKeysRejectBeforeAnyLabelBorrow(mut UiRadioGroupBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    const UiRadioAcceptedInputState displayed = self.accepted();
    const RadioGroupSnapshot saved = self.m_state.snapshot();
    self.m_source.resetCounters();
    self.m_source.m_duplicate = true;
    ++self.m_source.m_contentRevision;
    EXPECT_FALSE(self.declare(2u));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_TRUE(self.m_state.matches(saved));
    EXPECT_EQ(self.m_source.m_textCalls, 0u);
    self.expectAccepted(displayed);
}

void VerifyUiRadioGroupBuilderTests_SourceRevisionFencesQueuedKeysAndReorderKeepsStableSelection(mut UiRadioGroupBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    self.press(Key::Tab);
    self.press(Key::Right);
    self.m_source.m_reverse = true;
    ++self.m_source.m_contentRevision;
    ASSERT_TRUE(self.accept(2u));
    EXPECT_EQ(self.m_state.selectedKey(), 10u);
    EXPECT_FALSE(self.m_result.selectionChanged);
    EXPECT_EQ(self.m_state.placement().rows[4u].key, 10u);
    self.press(Key::Right);
    ASSERT_TRUE(self.accept(3u));
    EXPECT_EQ(self.m_state.selectedKey(), 50u);
    EXPECT_TRUE(self.m_result.selectionChanged);
}

void VerifyUiRadioGroupBuilderTests_RemovalAndKnownSourceReplacementClearTheCommittedSelection(mut UiRadioGroupBuilderTests self){
    self.m_state.select(20u);
    ASSERT_TRUE(self.accept(1u));
    self.m_source.m_removed = 20u;
    ++self.m_source.m_contentRevision;
    ASSERT_TRUE(self.accept(2u));
    EXPECT_EQ(self.m_state.selectedKey(), 0u);
    EXPECT_TRUE(self.m_result.selectionChanged);
    self.m_state.select(40u);
    ++self.m_source.m_generation;
    ++self.m_source.m_contentRevision;
    self.m_source.m_removed = 0u;
    ASSERT_TRUE(self.accept(3u));
    EXPECT_EQ(self.m_state.selectedKey(), 0u);
    EXPECT_TRUE(self.m_result.selectionChanged);
}

void VerifyUiRadioGroupBuilderTests_PreparedGeometryDoesNotReplaceAcceptedChoiceTargetsUntilCommit(mut UiRadioGroupBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    const auto initialHost = self.findTarget(self.host());
    ASSERT_TRUE(initialHost.has_value());
    const Rect oldBounds = initialHost.value().rectangle;
    ASSERT_TRUE(self.prepare(2u, RadioGroupOptions(), MakeUiProgressRect(80.0f, 40.0f, 420.0f, 360.0f)));
    const auto preparedHost = self.findTarget(self.host());
    ASSERT_TRUE(preparedHost.has_value());
    ExpectUiRect(preparedHost.value().rectangle, oldBounds);
    EXPECT_NE(self.m_state.placement().bounds.x, oldBounds.x);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    const auto committedHost = self.findTarget(self.host());
    ASSERT_TRUE(committedHost.has_value());
    ExpectUiRect(committedHost.value().rectangle, self.m_state.placement().bounds);
}

void VerifyUiRadioGroupBuilderTests_DeclarationFreezesStyleMetricsBeforeTheOwningPanelEnds(mut UiRadioGroupBuilderTests self){
    ASSERT_TRUE(self.declare(1u));
    self.m_builder.radioGroupStyle().indicatorExtent = 40.0f;
    self.m_builder.style().fontSize = 28.0f;
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const auto row = self.findChoice(10u);
    ASSERT_TRUE(row.has_value());
    EXPECT_FLOAT_EQ(row.value().indicator.width, 24.0f);
    EXPECT_FLOAT_EQ(row.value().rectangle.height, 24.0f);
}

void VerifyUiRadioGroupBuilderTests_InvalidWidthRejectsBeforeSourceCallbacksOrStateMutation(mut UiRadioGroupBuilderTests self){
    const RadioGroupSnapshot saved = self.m_state.snapshot();
    RadioGroupOptions options = RadioGroupOptions();
    options.width.policy = LayoutSizePolicy::Fixed;
    options.width.value = -1.0f;
    EXPECT_FALSE(self.declare(1u, options));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_TRUE(self.m_state.matches(saved));
    EXPECT_EQ(self.m_source.m_textCalls, 0u);
}


