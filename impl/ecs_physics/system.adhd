    public EcsClosestPointHit closestPoint(in VectorSingle worldPoint, in f32 maxDistance, in Filter filter, in b8 hitSensors, in EntityID ignoreEntity)const{
        BodyId ignoreBodyId;
        ShapeId ignoreShapeId;
        this.resolveIgnoreEntityTarget(ignoreEntity, ignoreBodyId, ignoreShapeId);
        EcsClosestPointHit outHit;
        if(!ignoreShapeId.valid())
            outHit.hit = this.m_physicsWorld.closestPoint(worldPoint, maxDistance, filter, hitSensors, ignoreBodyId);
        else
            outHit.hit = this.m_physicsWorld.closestPoint(worldPoint, maxDistance, filter, hitSensors, ignoreBodyId, ignoreShapeId, ShapeQueryFilterCallback(lambda[](in ShapeId id) -> b8{ return true; }));
        if(outHit.hit.hit)
            outHit.entity = this.entityForShape(outHit.hit.shapeId);
        return outHit;
    }

