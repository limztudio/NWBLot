    EXPECT_EQ(state.reserve(MakeReflectionStatisticsMetadata()).slot, 0u);
}

void VerifyRefractionStatistics_RingSaturationDoesNotRecycleOutstandingGpuWork(){
    StatisticsTestControl<RefractionStatisticsState> context;
    ASSERT_TRUE(context.control.valid());
    mut RefractionStatisticsState state = context.control.deref();
    const StatisticsReservationKey first = state.reserve(MakeRefractionStatisticsMetadata());
    const StatisticsReservationKey second = state.reserve(MakeRefractionStatisticsMetadata());
    const StatisticsReservationKey third = state.reserve(MakeRefractionStatisticsMetadata());
    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(second.valid());
    ASSERT_TRUE(third.valid());
    EXPECT_NE(first.slot, second.slot);
    EXPECT_NE(first.slot, third.slot);
    EXPECT_NE(second.slot, third.slot);
    state.accept(first, Token(), true);
    state.discard(first);
    EXPECT_FALSE(state.reserve(MakeRefractionStatisticsMetadata()).valid());
    state.discard(second);
    const StatisticsReservationKey reused = state.reserve(MakeRefractionStatisticsMetadataAt(10u));
    EXPECT_EQ(reused.slot, second.slot);
    EXPECT_GT(reused.sequence, second.sequence);
    EXPECT_FALSE(state.reserve(MakeRefractionStatisticsMetadata()).valid());
}

void VerifyRefractionStatistics_CompletionRequiresExactAcceptedPhysicalToken(){
    StatisticsTestControl<RefractionStatisticsState> context;
    ASSERT_TRUE(context.control.valid());
    mut RefractionStatisticsState state = context.control.deref();
    const StatisticsReservationKey key = state.reserve(MakeRefractionStatisticsMetadata());
    state.accept(key, Token(), true);
    const RefractionCounterArray counters = RefractionCounterArray();
    QueueSubmissionToken wrong = Token();
    wrong.physicalQueueIndex = 1u;
    state.complete(key, wrong, counters);
    wrong = Token();
    wrong.deviceGeneration = 8u;
    state.complete(key, wrong, counters);
    wrong = Token();
    wrong.queue = CommandQueue::Compute;
    state.complete(key, wrong, counters);
    state.complete(key, Token(19u), counters);
    state.complete(key, QueueSubmissionToken(), counters);
    EXPECT_FALSE(state.tryGetLatestStatistics().has_value());
    EXPECT_TRUE(state.pending(key.slot).has_value());
    state.complete(key, Token(), counters);
    const Expected<RefractionStatistics> statistics = state.tryGetLatestStatistics();
    ASSERT_TRUE(statistics.has_value());
    EXPECT_EQ(statistics.value().acceptedToken.value, Token().value);
    EXPECT_EQ(statistics.value().acceptedToken.physicalQueueIndex, 0u);
    EXPECT_FALSE(state.pending(key.slot).has_value());
}

void VerifyRefractionStatistics_OlderCompletionsCannotReplaceFrozenNewerPublication(){
    StatisticsTestControl<RefractionStatisticsState> context;
    ASSERT_TRUE(context.control.valid());
    mut RefractionStatisticsState state = context.control.deref();
    RefractionStatistics metadata = MakeRefractionStatisticsMetadataAt(10u);
    const StatisticsReservationKey older = state.reserve(metadata);
    metadata.frameIndex = 11u;
    metadata.graphicsFrameIndex = 111u;
    const StatisticsReservationKey newer = state.reserve(metadata);
    metadata.frameIndex = 999u;
    metadata.width = 1u;
    state.accept(older, Token(20u), true);
    state.accept(newer, Token(21u), false);
    const RefractionCounterArray counters = MakeSampleRefractionCounters();
    state.complete(newer, Token(21u), counters);
    const RefractionCounterArray olderCounters = RefractionCounterArray();
    state.complete(older, Token(20u), olderCounters);
    const Expected<RefractionStatistics> statistics = state.tryGetLatestStatistics();
    ASSERT_TRUE(statistics.has_value());
    EXPECT_EQ(statistics.value().sequence, newer.sequence);
    EXPECT_EQ(statistics.value().frameIndex, 11u);
    EXPECT_EQ(statistics.value().graphicsFrameIndex, 111u);
    EXPECT_EQ(statistics.value().width, 320u);
    EXPECT_EQ(statistics.value().height, 180u);
    EXPECT_FALSE(statistics.value().hardwareReady);
    EXPECT_FALSE(statistics.value().csgHardwareEnabled);
    EXPECT_EQ(statistics.value().hardwarePixels, 23u);
    EXPECT_EQ(statistics.value().entryQueries, 41u);
    EXPECT_EQ(statistics.value().exitQueries, 43u);
    EXPECT_EQ(statistics.value().backgroundQueries, 47u);
    EXPECT_EQ(statistics.value().physicalQueries, 103u);
    EXPECT_EQ(statistics.value().queryBudgetUnits, 107u);
    EXPECT_EQ(statistics.value().overflowFlags, 1u);
    ExpectRefractionDiagnosticCountersMatch(statistics.value(), counters);
    EXPECT_EQ(state.reserve(MakeRefractionStatisticsMetadata()).slot, older.slot);
}

void VerifyRefractionStatistics_DeviceResetRejectsStaleAcceptanceAndCompletion(){
    StatisticsTestControl<RefractionStatisticsState> context;
    ASSERT_TRUE(context.control.valid());
    mut RefractionStatisticsState state = context.control.deref();
    const StatisticsReservationKey previous = state.reserve(MakeRefractionStatisticsMetadata());
    state.accept(previous, Token(), true);
    const RefractionCounterArray counters = RefractionCounterArray();
    state.complete(previous, Token(), counters);
    state.reset(0u);
    EXPECT_FALSE(state.tryGetLatestStatistics().has_value());
    EXPECT_FALSE(state.reserve(MakeRefractionStatisticsMetadata()).valid());
    state.reset(8u);
    const StatisticsReservationKey current = state.reserve(MakeRefractionStatisticsMetadataAt(12u));
    ASSERT_TRUE(current.valid());
    EXPECT_GT(current.generation, previous.generation);
    state.accept(previous, Token(), true);
    state.discard(previous);
    state.complete(previous, Token(), counters);
    EXPECT_FALSE(state.tryGetLatestStatistics().has_value());
    QueueSubmissionToken next = Token(1u);
    next.deviceGeneration = 8u;
    state.accept(current, next, true);
    state.complete(current, next, counters);
    const Expected<RefractionStatistics> statistics = state.tryGetLatestStatistics();
    ASSERT_TRUE(statistics.has_value());
    EXPECT_EQ(statistics.value().frameIndex, 12u);
    EXPECT_EQ(statistics.value().acceptedToken.deviceGeneration, 8u);
    EXPECT_TRUE(statistics.value().hardwareReady);
    EXPECT_TRUE(statistics.value().csgHardwareEnabled);
}

void VerifyRefractionStatistics_FailedMappingRetiresSlotWithoutReplacingPublication(){
    StatisticsTestControl<RefractionStatisticsState> context;
    ASSERT_TRUE(context.control.valid());
    mut RefractionStatisticsState state = context.control.deref();
    const StatisticsReservationKey first = state.reserve(MakeRefractionStatisticsMetadata());
    state.accept(first, Token(), true);
    const RefractionCounterArray counters = RefractionCounterArray();
    state.complete(first, Token(), counters);
    const StatisticsReservationKey failed = state.reserve(MakeRefractionStatisticsMetadataAt(10u));
    state.accept(failed, Token(21u), true);
    state.complete(failed, Token(21u), Span<u32>());
    const Expected<RefractionStatistics> statistics = state.tryGetLatestStatistics();
    ASSERT_TRUE(statistics.has_value());
    EXPECT_EQ(statistics.value().sequence, first.sequence);
    EXPECT_EQ(state.reserve(MakeRefractionStatisticsMetadata()).slot, failed.slot);
}

void VerifyRenderableMeshResolution_StaticAttachmentWithoutAssetIsUnavailable(){
    PruneContext context = PruneContext();
    const EntityID entity = context.addMeshEntity();
    const RenderableMeshStatusResult unavailable = context.meshSystem.resolveRenderableMeshStatus(entity);
    ASSERT_FALSE(unavailable.has_value());
    EXPECT_EQ(unavailable.error(), RenderableMeshResolution::Unavailable);
    context.setMeshAsset(entity, "tests/runtime_mesh_pruning/static_attachment");
    const RenderableMeshStatusResult description = context.meshSystem.resolveRenderableMeshStatus(entity);
    ASSERT_TRUE(description.has_value());
}

void VerifyRenderableMeshResolution_SkinnedAttachmentWithoutProviderIsUnavailable(){
    PruneContext context = PruneContext();
    const EntityID entity = context.addSkinnedEntity();
    const RenderableMeshStatusResult unavailable = context.meshSystem.resolveRenderableMeshStatus(entity);
    ASSERT_FALSE(unavailable.has_value());
    EXPECT_EQ(unavailable.error(), RenderableMeshResolution::Unavailable);
}

void VerifyRuntimeMeshPruning_RequestedIdentitiesKeepFullNameAndVersionAcrossHintedAndGrowingIndices(){
    Array<Name, 40> names = Array<Name, 40>();
    for(usize index = 0u; index < 40u; ++index)
        names[index] = MakeVariantPruningName(index);
    Array<usize, 2> hints = Array<usize, 2>();
    hints[0u] = 0u;
    hints[1u] = 64u;
    const u64 highVersion = (1uLL << 40u) + 7uLL;
    for(in usize capacityHint : hints){
        RuntimeMeshPruningContext context = RuntimeMeshPruningContext(capacityHint);
        context.requests.add(s_NameNone, 7u);
        context.requests.markLive(s_NameNone, 7u);
        EXPECT_TRUE(context.requests.complete());
        EXPECT_FALSE(context.requests.containsLive(s_NameNone, 7u));
        for(usize index = 0u; index < 40u; ++index){
            context.requests.add(names[index], 7u);
            context.requests.add(names[index], 7u);
            if(index < 16u)
                context.requests.markLive(names[index], 7u);
        }
        context.requests.add(names[0u], 0u);
        context.requests.add(names[0u], highVersion);
        for(usize index = 0u; index < 40u; ++index){
            EXPECT_EQ(context.requests.containsLive(names[index], 7u), index < 16u);
            EXPECT_FALSE(context.requests.containsLive(names[index], 8u));
        }
        context.requests.markLive(Name(s_EcsGraphicsCaseTestsRuntimeMeshPruningNotRequested), 7u);
        EXPECT_FALSE(context.requests.complete());
        for(usize index = 0u; index < 40u; ++index){
            context.requests.markLive(names[index], 7u);
            context.requests.markLive(names[index], 7u);
        }
        EXPECT_FALSE(context.requests.complete());
        EXPECT_FALSE(context.requests.containsLive(names[0u], 0u));
        EXPECT_FALSE(context.requests.containsLive(names[0u], highVersion));
        context.requests.markLive(names[0u], highVersion);
        EXPECT_FALSE(context.requests.complete());
        context.requests.markLive(names[0u], 0u);
        EXPECT_TRUE(context.requests.complete());
        context.requests.add(names[0u], 7u);
        EXPECT_TRUE(context.requests.complete());
        for(usize index = 0u; index < 40u; ++index)
            EXPECT_TRUE(context.requests.containsLive(names[index], 7u));
    }
}

void ConfirmSceneShadingUpload(
    mut SceneShadingUploadTracker tracker,
    in SceneLightSpan lights,
    in b8 lightUploaded,
    in SceneShadingGpuData shading,
    in b8 shadingUploaded,
    mut Array<u8, 5120> lightBytes,
    mut u32 lightCount,
    mut b8 lightValid,
    mut Array<u8, 16> shadingBytes,
    mut b8 shadingValid
){
    tracker.confirm(lights, lightUploaded, shading, shadingUploaded, lightBytes, lightCount, lightValid, shadingBytes, shadingValid);
}

void VerifySceneShadingUploads_EmptyLightTransitionInvalidatesThePreviousLightMirror(){
    SceneShadingUploadTracker tracker = SceneShadingUploadTracker();
    Array<u8, 5120> lightBytes = Array<u8, 5120>();
    Array<u8, 16> shadingBytes = Array<u8, 16>();
    u32 lightCount = 0u;
    b8 lightValid = false;
    b8 shadingValid = false;
    SceneShadingGpuData shading = SceneShadingGpuData();
    Array<SceneLightGpuData, 1> light = Array<SceneLightGpuData, 1>();
    const SceneLightSpan empty = SceneLightSpan();
    const SceneLightSpan one = SceneLightSpan(light.data(), light.size());

    EXPECT_FALSE(tracker.lightUploadRequired(lightValid, lightCount, lightBytes, empty));
    EXPECT_TRUE(tracker.shadingUploadRequired(shadingValid, shadingBytes, shading));
    ConfirmSceneShadingUpload(tracker, empty, false, shading, true, lightBytes, lightCount, lightValid, shadingBytes, shadingValid);
    EXPECT_TRUE(lightValid);
    EXPECT_EQ(lightCount, 0u);
    EXPECT_FALSE(tracker.shadingUploadRequired(shadingValid, shadingBytes, shading));

    ASSERT_TRUE(tracker.lightUploadRequired(lightValid, lightCount, lightBytes, one));
    ConfirmSceneShadingUpload(tracker, one, true, shading, false, lightBytes, lightCount, lightValid, shadingBytes, shadingValid);
    EXPECT_FALSE(tracker.lightUploadRequired(lightValid, lightCount, lightBytes, one));
    light[0u].position.x = 1.0f;
    EXPECT_TRUE(tracker.lightUploadRequired(lightValid, lightCount, lightBytes, one));
    ConfirmSceneShadingUpload(tracker, empty, false, shading, false, lightBytes, lightCount, lightValid, shadingBytes, shadingValid);
    EXPECT_EQ(lightCount, 0u);
    EXPECT_TRUE(tracker.lightUploadRequired(lightValid, lightCount, lightBytes, one));
}

void VerifyShadowMaterialContextPolicy_RejectedAndCrossRouteUploadsDoNotAdmitStaleCache(){
    const ShadowMaterialContextPolicy policy = ShadowMaterialContextPolicy();
    u64 hardwareHash = 11u;
    u64 softwareHash = 22u;
    b8 hardwareValid = true;
    b8 softwareValid = true;
    EXPECT_FALSE(policy.publishAcceptedUpload(false, true, PreparedShadowMaterialContextRoute::Hardware, 33u, true, hardwareHash, hardwareValid, softwareHash, softwareValid));
    EXPECT_EQ(hardwareHash, 11u);
    EXPECT_EQ(softwareHash, 22u);
    EXPECT_TRUE(hardwareValid);
    EXPECT_TRUE(softwareValid);
    EXPECT_TRUE(policy.publishAcceptedUpload(true, true, PreparedShadowMaterialContextRoute::Hardware, 33u, true, hardwareHash, hardwareValid, softwareHash, softwareValid));
    EXPECT_EQ(hardwareHash, 33u);
    EXPECT_TRUE(hardwareValid);
    EXPECT_FALSE(softwareValid);
    EXPECT_FALSE(policy.softwareSnapshotCovers(true, PreparedShadowMaterialContextRoute::Hardware, 2u, 2u, 2u));
    EXPECT_FALSE(policy.softwareSnapshotCovers(true, PreparedShadowMaterialContextRoute::Software, 2u, 1u, 2u));
    EXPECT_FALSE(policy.softwareSnapshotAccepted(false, true, false, 22u, 22u, 2u, 2u));
    EXPECT_FALSE(policy.softwareSnapshotAccepted(false, true, true, 22u, 23u, 2u, 2u));
    EXPECT_FALSE(policy.softwareSnapshotAccepted(false, true, true, 22u, 22u, 2u, 3u));
    EXPECT_TRUE(policy.softwareSnapshotAccepted(false, true, true, 22u, 22u, 2u, 2u));
}

