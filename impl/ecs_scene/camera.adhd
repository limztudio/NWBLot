////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_scene/components.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SceneCameraComponents{
    public mut TransformComponent transform;
    public mut CameraComponent camera;

    public SceneCameraComponents(mut TransformComponent transform, mut CameraComponent camera){
        this.transform = transform;
        this.camera = camera;
    }
}

class SceneCameraView{
    public EntityID entity;
    public Optional<SceneCameraComponents> components;
    public CameraProjection projection;

    public SceneCameraView(){
        this.entity = s_InvalidEntityId;
    }

    public SceneCameraView(in EntityID entity, mut TransformComponent transform, mut CameraComponent camera, in CameraProjection projection){
        this.entity = entity;
        this.components = SceneCameraComponents(transform, camera);
        this.projection = projection;
    }

    public b8 valid()const{
        return IsValidSceneCameraViewProjection(this.entity, this.components.has_value(), this.projection);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(is_standard_layout<ActiveCameraComponent>(), "ActiveCameraComponent must stay layout-stable for ECS storage");
static_assert(is_trivially_copyable<ActiveCameraComponent>(), "ActiveCameraComponent must stay cheap to move in dense ECS storage");
static_assert(size_of<ActiveCameraComponent>() == size_of<EntityID>(), "ActiveCameraComponent must only contain the active camera entity reference");
static_assert(is_standard_layout<CameraComponent>(), "CameraComponent must stay layout-stable for ECS storage");
static_assert(is_trivially_copyable<CameraComponent>(), "CameraComponent must stay cheap to move in dense ECS storage");
static_assert(align_of<CameraComponent>() >= align_of<f32x4>(), "CameraComponent must stay aligned for SIMD component loads");
static_assert(size_of<CameraComponent>() == size_of<f32x4>(), "CameraComponent must stay one aligned vector wide");
static_assert((size_of<CameraComponent>() % align_of<CameraComponent>()) == 0u, "CameraComponent array stride must keep every element SIMD-aligned");
static_assert((offset_of<CameraComponent>(projection) % align_of<f32x4>()) == 0u, "CameraComponent::projection must stay aligned");
static_assert(is_standard_layout<TransformComponent>(), "TransformComponent must stay layout-stable for ECS storage");
static_assert(is_trivially_copyable<TransformComponent>(), "TransformComponent must stay cheap to move in dense ECS storage");
static_assert(align_of<TransformComponent>() >= align_of<f32x4>(), "TransformComponent must stay aligned for SIMD component loads");
static_assert(size_of<TransformComponent>() == size_of<f32x4>() + size_of<f32x4>() + size_of<f32x4>(), "TransformComponent must only contain aligned decomposed transform state");
static_assert((size_of<TransformComponent>() % align_of<TransformComponent>()) == 0u, "TransformComponent array stride must keep every element SIMD-aligned");
static_assert((offset_of<TransformComponent>(position) % align_of<f32x4>()) == 0u, "TransformComponent::position must stay aligned");
static_assert((offset_of<TransformComponent>(rotation) % align_of<f32x4>()) == 0u, "TransformComponent::rotation must stay aligned");
static_assert((offset_of<TransformComponent>(scale) % align_of<f32x4>()) == 0u, "TransformComponent::scale must stay aligned");
static_assert(is_standard_layout<CameraProjection>(), "CameraProjection must stay layout-stable");
static_assert(is_trivially_copyable<CameraProjection>(), "CameraProjection must stay cheap to pass by value");
static_assert(align_of<CameraProjection>() >= align_of<f32x4>(), "CameraProjection must keep storage vectors aligned");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


SceneCameraView ResolveSceneCameraView(mut World world, in f32 fallbackAspectRatio){
    EntityID activeCamera = s_InvalidEntityId;
    for(in auto row : world.view<ActiveCameraComponent>()){
        activeCamera = Get<1>(row).camera;
        break;
    }

    const Expected<CameraProjection> requested = TryResolveEntityCameraProjection(world, activeCamera, fallbackAspectRatio);
    if(requested.has_value())
        return SceneCameraView(activeCamera, world.getComponent<TransformComponent>(activeCamera), world.getComponent<CameraComponent>(activeCamera), requested.value());

    for(in auto row : world.view<TransformComponent, CameraComponent>()){
        const Expected<CameraProjection> projection = TryResolveCameraComponentProjection(Get<1>(row), Get<2>(row), fallbackAspectRatio);
        if(projection.has_value()){
            auto components = row;
            return SceneCameraView(Get<0>(components), Get<1>(components), Get<2>(components), projection.value());
        }
    }
    return SceneCameraView();
}

SceneCameraView ResolveSceneCameraView(mut World world){
    return ResolveSceneCameraView(world, s_CameraFallbackAspectRatio);
}

EntityID CreateSceneCameraEntity(mut World world, in VectorSingle position){
    Entity cameraEntity = world.createEntity();
    cameraEntity.addComponent<TransformComponent>() = MakePositionTransformComponent(position);
    cameraEntity.addComponent<CameraComponent>();
    return cameraEntity.id();
}


