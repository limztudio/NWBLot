// The caret is visible for the first half of its one-second cycle.
const f64 s_CaretVisiblePhaseEnd = 0.5;

const usize s_EditDefaultMaxBytes = 4096u;
const usize s_EditDefaultMaxHistoryRecords = 64u;
const usize s_EditDefaultMaxHistoryBytes = 131072u;
const usize s_EditMaxBytes = 1048576u;
const usize s_EditMaxHistoryRecords = 256u;
const usize s_EditMaxHistoryBytes = 16777216u;
const usize s_EditUtf8MaxSequenceBytes = 4u;
const StringView s_EditNewlineText = "\n";

const u32 s_EditUnicodeTab = 0x09u;
const u32 s_EditUnicodeLineFeed = 0x0Au;
const u32 s_EditUnicodeCarriageReturn = 0x0Du;
const u32 s_EditUnicodeNextLine = 0x85u;
const u32 s_EditUnicodeNoBreakSpace = 0xA0u;
const u32 s_EditUnicodeOghamSpaceMark = 0x1680u;
const u32 s_EditUnicodeEnQuad = 0x2000u;
const u32 s_EditUnicodeHairSpace = 0x200Au;
const u32 s_EditUnicodeNarrowNoBreakSpace = 0x202Fu;
const u32 s_EditUnicodeMediumMathematicalSpace = 0x205Fu;
const u32 s_EditUnicodeIdeographicSpace = 0x3000u;
const u32 s_EditAsciiExclamation = 0x21u;
const u32 s_EditAsciiSlash = 0x2Fu;
const u32 s_EditAsciiColon = 0x3Au;
const u32 s_EditAsciiAt = 0x40u;
const u32 s_EditAsciiLeftBracket = 0x5Bu;
const u32 s_EditAsciiGrave = 0x60u;
const u32 s_EditAsciiLeftBrace = 0x7Bu;
const u32 s_EditAsciiTilde = 0x7Eu;

const usize s_NumericEditMaxBytes = 128u;
const usize s_NumericEditMaxHistoryRecords = 64u;
const usize s_NumericEditHistoryBytesFactor = 128u;

const i64 s_NumericEditMaxI64 = 9223372036854775807ll;
const i64 s_NumericEditMinI64 = -s_NumericEditMaxI64 - 1ll;
const f64 s_NumericEditMaxF64 = 1.79769313486231570815e+308;
const f64 s_NumericEditMinF64 = -s_NumericEditMaxF64;


