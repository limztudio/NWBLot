[cpp_header("<core/metascript/preprocessor.h>"), cpp_name("::NWB::Core::Metascript::Preprocessor")]
extern class MetascriptPreprocessor{
    void defineObjectMacro(...);
    Span<String> includedFiles(...)const;
    b8 isOffsetInIncludedRange(...)const;
    b8 process(...);
    Span<String> resolvedIncludedFiles(...)const;
    void undefineMacro(...);
};

[cpp_header("<core/metascript/preprocessor.h>"), cpp_name("::NWB::Core::Metascript::PreprocessorMacro")]
extern class MetascriptPreprocessorMacro{
    String name;
    String body;
    b8 isFunctionLike;
    b8 isVariadic;
};


