#include <impl/ecs_render/kernel/task_graph_resource_descs.adhd>
#include <impl/ecs_render/csg/cutter_gpu_data.adhd>
#include <impl/ecs_render/csg/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class OpaqueCsgIntervalReadinessState{
    public b8 deferredResourcesReady = false;
    public b8 csgResourcesReady = false;
    public b8 csgReceiverSurfaceDrawResourcesReady = false;
}

usize ComputeOpaqueCsgIntervalSampleResourceUseCapacity(in b8 hasOpaqueDrawItems, in b8 hasCsgFrameGpuWork){
    usize capacity = 1u + s_OpaqueCsgRemovedIntervalResourceUseCount + s_OpaqueCsgGbufferColorResourceUseCount;
    if(hasOpaqueDrawItems)
        capacity += s_OpaqueCsgMaterialBufferResourceUseCount;
    if(hasCsgFrameGpuWork)
        capacity += s_OpaqueCsgFrameResourceUseCount;
    return capacity;
}

b8 CanCaptureOpaqueCsgIntervalSampleComputeEmulationPlan(
    in b8 hasCsgFrameGpuWork,
    in b8 materialFrameStatesGraphOwned,
    in b8 materialGeometryStatesGraphOwned,
    in b8 materialSampledTexturesCollected
){
    return hasCsgFrameGpuWork
        && materialFrameStatesGraphOwned
        && materialGeometryStatesGraphOwned
        && materialSampledTexturesCollected
    ;
}

OpaqueCsgIntervalReadinessState EvaluateOpaqueCsgIntervalReadiness(
    in b8 hasDeferredDrawItems,
    in b8 materialDrawBuffersUploaded,
    in b8 frameBindingsReady,
    in b8 hasCsgFrameWork,
    in b8 csgFrameBuffersUploaded,
    in b8 csgResourcesFrameReady,
    in b8 csgReceiverSurfaceEmpty,
    in b8 csgReceiverSurfaceDrawResourcesReady
){
    OpaqueCsgIntervalReadinessState state;
    state.deferredResourcesReady = hasDeferredDrawItems && materialDrawBuffersUploaded && frameBindingsReady;
    state.csgResourcesReady = state.deferredResourcesReady && (!hasCsgFrameWork || (csgFrameBuffersUploaded && csgResourcesFrameReady));
    state.csgReceiverSurfaceDrawResourcesReady = state.csgResourcesReady && (csgReceiverSurfaceEmpty || csgReceiverSurfaceDrawResourcesReady);
    return state;
}


