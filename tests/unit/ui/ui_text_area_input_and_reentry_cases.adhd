void VerifyUiTextAreaNavigationTests_FiniteExtremeViewportHeightClampsToDocumentEnds(mut UiTextAreaNavigationTests self){
    ASSERT_TRUE(self.m_model.setText("MMMM\nMMMM\nMMMM"));
    ASSERT_TRUE(self.m_model.setSelection(2u, 2u));
    const auto last = self.resolve(EditNavigationDirection::PageDown, f32.max);
    ASSERT_TRUE(last.has_value());
    EXPECT_EQ(last.value().committedByte, 12u);
    ASSERT_TRUE(self.m_model.setSelection(12u, 12u));
    const auto first = self.resolve(EditNavigationDirection::PageUp, f32.max);
    ASSERT_TRUE(first.has_value());
    EXPECT_EQ(first.value().committedByte, 2u);
    EXPECT_TRUE(IsFinite(first.value().preferredX));
    EXPECT_TRUE(IsFinite(last.value().preferredX));
}

