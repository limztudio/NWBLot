void VerifyNumericLifetimeTests_SameValueExternalReplacementFencesHistorySelectionAndComposition(mut NumericLifetimeIntegerFixture self){
    ASSERT_TRUE(self.m_model.setValue(7));
    ASSERT_TRUE(self.m_model.lendDraft().replaceSelection("8"));
    ASSERT_TRUE(self.m_model.lendDraft().setSelection(0u, 1u));
    ASSERT_TRUE(self.m_model.lendDraft().beginComposition());
    ASSERT_TRUE(self.m_model.lendDraft().updateComposition("9", 0u, 1u));
    const u64 generation = self.m_model.draft().instanceGeneration();
    const u64 external = self.m_model.draft().externalRevision();
    const u64 epoch = self.m_model.revision();
    ASSERT_TRUE(self.m_model.setValue(7));
    EXPECT_GT(self.m_model.revision(), epoch);
    EXPECT_GT(self.m_model.draft().externalRevision(), external);
    EXPECT_EQ(self.m_model.draft().instanceGeneration(), generation);
    EXPECT_EQ(self.m_model.draft().text(), "7");
    EXPECT_EQ(self.m_model.draft().anchor(), 1u);
    EXPECT_EQ(self.m_model.draft().caret(), 1u);
    EXPECT_FALSE(self.m_model.draft().composition().active);
    EXPECT_FALSE(self.m_model.draft().canUndo());
    EXPECT_FALSE(self.m_model.dirty());
    const u64 sameTextRevision = self.m_model.draft().revision();
    const u64 sameExternal = self.m_model.draft().externalRevision();
    const u64 sameEpoch = self.m_model.revision();
    ASSERT_TRUE(self.m_model.setValue(7));
    EXPECT_EQ(self.m_model.draft().revision(), sameTextRevision);
    EXPECT_GT(self.m_model.draft().externalRevision(), sameExternal);
    EXPECT_GT(self.m_model.revision(), sameEpoch);
}

