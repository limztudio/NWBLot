////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{
#include <impl/global.adhd.h>

#include <core/assets/module.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] b8 MergeGatheredGraphicsAsset(const Name& virtualPath, Span<const u8> incomingPayload, Core::Alloc::ScratchArena& scratchArena, Core::Assets::AssetBytes& existingPayload);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<usize> TryComputeMergedGraphicsShaderRecordCapacity(in usize existingCount, in usize incomingCount){
    if(incomingCount > usize.max - existingCount){
        error("GraphicsGather: merged shader index size overflows");
        return MakeUnexpected(Failure());
    }
    return existingCount + incomingCount;
}

b8 ValidateMatchingGatheredShaderRecord(
    in Name previousShaderName,
    in Name previousStage,
    in StringView previousVariantName,
    in u64 previousSourceChecksum,
    in u64 previousBytecodeChecksum,
    in Name incomingShaderName,
    in Name incomingStage,
    in StringView incomingVariantName,
    in u64 incomingSourceChecksum,
    in u64 incomingBytecodeChecksum
){
    if(
        previousShaderName == incomingShaderName
        && previousStage == incomingStage
        && previousVariantName == incomingVariantName
        && previousSourceChecksum == incomingSourceChecksum
        && previousBytecodeChecksum == incomingBytecodeChecksum
    )
        return true;

    error(
        "GraphicsGather: conflicting shader index record '{}' variant '{}' stage '{}'"
        , incomingShaderName.resolvedText()
        , incomingVariantName
        , incomingStage.resolvedText()
    );
    return false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{
#include <core/alloc/scratch.h>
#include <core/assets/gather_merge_registry.h>
#include <core/graphics/shader_archive.h>
#include <core/common/log.h>

#include <global/binary.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_graphics_gather{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static b8 ValidateRecordIdentity(const Core::ShaderArchive::Record& record){
    const Expected<Name> expectedPath = Core::ShaderArchive::BuildVirtualPathName(record.shaderName, record.variantName, record.stage);
    if(expectedPath && expectedPath->hash() == record.virtualPathHash)
        return true;

    NWB_LOGGER_ERROR(NWB_TEXT("GraphicsGather: shader index record has an invalid runtime identity"));
    return false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MergeGatheredGraphicsAsset(const Name& virtualPath, const Span<const u8> incomingPayload, Core::Alloc::ScratchArena& scratchArena, Core::Assets::AssetBytes& existingPayload){
    if(virtualPath != Core::ShaderArchive::s_IndexVirtualPathName)
        return false;
    if(!incomingPayload.empty() && incomingPayload.data() == nullptr)
        return false;

    Core::Assets::AssetArena& arena = existingPayload.get_allocator().arena();
    auto parsedRecords = Core::ShaderArchive::DeserializeIndex(arena, { existingPayload.data(), existingPayload.size() });
    if(!parsedRecords)
        return false;
    auto parsedIncomingRecords = Core::ShaderArchive::DeserializeIndex(arena, { incomingPayload.data(), incomingPayload.size() });
    if(!parsedIncomingRecords)
        return false;
    auto& records = *parsedRecords;
    auto& incomingRecords = *parsedIncomingRecords;
    const Expected<usize> mergedCapacity = TryComputeMergedGraphicsShaderRecordCapacity(records.size(), incomingRecords.size());
    if(!mergedCapacity)
        return false;

    HashMap<NameHash, usize, Core::Alloc::ScratchArena, Hasher<NameHash>, EqualTo<NameHash>> recordIndices(scratchArena);
    recordIndices.reserve(*mergedCapacity);
    records.reserve(*mergedCapacity);
    for(usize i = 0u; i < records.size(); ++i){
        if(!__hidden_graphics_gather::ValidateRecordIdentity(records[i]))
            return false;
        if(!recordIndices.emplace(records[i].virtualPathHash, i).second){
            NWB_LOGGER_ERROR(NWB_TEXT("GraphicsGather: duplicate shader index identity"));
            return false;
        }
    }

    for(auto& record : incomingRecords){
        if(!__hidden_graphics_gather::ValidateRecordIdentity(record))
            return false;
        const auto found = recordIndices.find(record.virtualPathHash);
        if(found == recordIndices.end()){
            if(!recordIndices.emplace(record.virtualPathHash, records.size()).second)
                return false;
            records.push_back(Move(record));
            continue;
        }

        const auto& previous = records[found.value()];
        if(!ValidateMatchingGatheredShaderRecord(
            previous.shaderName,
            previous.stage,
            previous.variantName,
            previous.sourceChecksum,
            previous.bytecodeChecksum,
            record.shaderName,
            record.stage,
            record.variantName,
            record.sourceChecksum,
            record.bytecodeChecksum
        ))
            return false;
    }

    auto merged = Core::ShaderArchive::SerializeIndex(records, arena, scratchArena);
    if(!merged)
        return false;
    existingPayload = Move(*merged);
    return true;
}

static Core::Assets::AssetGatherMergeAutoRegistrar s_GraphicsGatherMergeRegistrar(&MergeGatheredGraphicsAsset);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

