                    dynamicSoftness,
                    staticSoftness,
                    contactHertz,
                    contactDampingRatio,
                    h,
                    enableContactSoftening,
                    worldRef.m_enableWarmStarting,
                    outConstraints[c][idx]
                );
            },
            CpuTaskOptions()
        );
        if(!res.has_value())
            return false;
        return true;
    }

    for(usize c = 0u; c < s_GraphColorCount; ++c){
        in Vector<u32> ids = world.m_graph.colors[c].contactIds;
        for(usize idx = 0u; idx < ids.size(); ++idx){
            const u32 contactId = ids[idx];
            PrepareContactConstraint(
                world.m_bodies,
                world.m_solverSets,
                world.m_contacts[contactId],
                dynamicSoftness,
                staticSoftness,
                contactHertz,
                contactDampingRatio,
                h,
                enableContactSoftening,
                world.m_enableWarmStarting,
                outConstraints[c][idx]
            );
        }
    }
    return true;
}

b8 PrepareColorContactConstraintsFromGraphWithCache(
    in PhysicsWorld world,
    in f32 h,
    mut CpuTaskScheduler cpuScheduler,
    mut Array<Vector<ContactConstraint>, s_GraphColorCount> outConstraints,
    mut Array<Vector<ContactConstraintStepCache>, s_GraphColorCount> outCaches
){
    const f32 contactHertz = world.m_def.contactHertz;
    const f32 contactDampingRatio = world.m_def.contactDampingRatio;
    const b8 enableContactSoftening = world.m_def.enableContactSoftening;
