    const Expected<HitTarget> hostTarget = self.tryTarget(self.id(s_UiListScrollbarListKey, s_UiListScrollbarPanelKey));
    ASSERT_TRUE(hostTarget.has_value());
    EXPECT_EQ(hostTarget.value().pageRows, 1u);
    EXPECT_EQ(self.m_source.textCalls.value(), 0u);
}

void VerifyUiListBuilderScrollbarTests_SmallDatasetBoundsPageSizeByRows(mut UiListBuilderTests self){
    self.m_source.count = 2u;
    const ListOptions options = MakeListFixtureOptions();
