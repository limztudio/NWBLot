b8 IsWindowsLoggerCrashPlatform(){
    b8 isWindows = false;
    native(mut isWindows){
#if defined(NWB_PLATFORM_WINDOWS)
        isWindows = true;
#endif
    }
    return isWindows;
}

b8 IsDesktopLinuxLoggerCrashPlatform(){
    b8 isDesktopLinux = false;
    native(mut isDesktopLinux){
#if defined(NWB_PLATFORM_LINUX) && !defined(NWB_PLATFORM_ANDROID)
        isDesktopLinux = true;
#endif
    }
    return isDesktopLinux;
}

b8 IsDesktopLoggerCrashPlatform(){
    return IsWindowsLoggerCrashPlatform() || IsDesktopLinuxLoggerCrashPlatform();
}

CrashTestPath StorageDirectory(mut GlobalArena arena, in StringView testGroup){
    return TestCaseDirectory(arena, testGroup) / "storage";
}

CrashTestPath ArchiveInputDirectory(mut GlobalArena arena, in StringView testGroup){
    return TestCaseDirectory(arena, testGroup) / "input";
}

CrashTestPath ArchiveFileName(mut GlobalArena arena, in StringView stem){
    CrashTestPath fileName = CrashTestPath(arena, stem);
    fileName.replaceExtension(s_CrashUploadArchiveFileExtension);
    return fileName;
}

CrashTestPath ArchivePath(mut GlobalArena arena, in StringView testGroup, in StringView stem){
    return ArchiveInputDirectory(arena, testGroup) / ArchiveFileName(arena, stem);
}

CrashTestPath ExtractedPackageDirectory(mut GlobalArena arena, in StringView testGroup, in StringView stem){
    return StorageDirectory(arena, testGroup) / s_CrashExtractedDirectoryName / stem;
}

CrashTestPath RawArchivePath(mut GlobalArena arena, in StringView testGroup, in StringView stem){
    return StorageDirectory(arena, testGroup) / s_CrashRawDirectoryName / ArchiveFileName(arena, stem);
}

CrashTestPath InvalidArchivePath(mut GlobalArena arena, in StringView testGroup, in StringView stem){
    return StorageDirectory(arena, testGroup) / s_CrashInvalidDirectoryName / ArchiveFileName(arena, stem);
}

void AppendArchiveFile(in StringView relativePath, in StringView content, mut CrashTestText archive){
    native(in relativePath, in content, mut archive){
        Array<char, 32u> sizeBuffer = {};
        archive += CrashNames::s_ArchiveFileHeaderPrefix;
        archive += relativePath;
        archive += " ";
        archive += FormatDecimal(content.size(), sizeBuffer);
        archive += "\n";
        archive += content;
        archive += CrashNames::s_ArchiveEntryEndText;
    }
}

CrashTestText BuildManifest(
    in StringView crashId,
    in StringView platform,
    in StringView event,
    in StringView reasonKind,
    in u64 reasonCode,
    in ManifestEventFieldEnum eventField,
    in ManifestTriggerFields trigger,
    mut GlobalArena arena
){
    CrashTestText manifest = CrashTestText(arena);
    native(in crashId, in platform, in event, in reasonKind, in reasonCode, in eventField, in trigger, mut manifest){
        Array<char, 32u> reasonCodeBuffer = {};
        Array<char, 32u> triggerLineBuffer = {};
        manifest += "{\n";
        manifest += "  \"format\": \"";
        manifest += CrashNames::s_ManifestFormatValue;
        manifest += "\",\n";
        manifest += "  \"crash_id\": \"";
        manifest += crashId;
        manifest += "\",\n  \"application\": \"logger_server_test\",\n";
        manifest += "  \"version\": \"1\",\n";
        manifest += "  \"build_id\": \"unit-test\",\n";
        manifest += "  \"abi\": \"test-abi\",\n";
        manifest += "  \"platform\": \"";
        manifest += platform;
        manifest += "\",\n  \"reason_kind\": \"";
        manifest += reasonKind;
        manifest += "\",\n  \"reason_code\": ";
        manifest += FormatDecimal(static_cast<usize>(reasonCode), reasonCodeBuffer);
        manifest += ",\n  \"process_id\": 1,\n";
        manifest += "  \"thread_id\": 7,\n";
        manifest += "  \"has_exception_context\": false,\n";
        manifest += "  \"fault_address\": 0,\n";
        manifest += "  \"instruction_pointer\": 0,\n";
        manifest += "  \"stack_pointer\": 0,\n";
        manifest += "  \"frame_pointer\": 0,\n";
        if(eventField == ManifestEventField::Include){
            manifest += "  \"event\": \"";
            manifest += event;
            manifest += "\",\n";
        }
        manifest += "  \"trigger_category\": \"";
        manifest += trigger.category;
        manifest += "\",\n";
        manifest += "  \"trigger_expression\": \"";
        manifest += trigger.expression;
        manifest += "\",\n";
        manifest += "  \"trigger_message\": \"";
        manifest += trigger.message;
        manifest += "\",\n";
        manifest += "  \"trigger_file\": \"";
        manifest += trigger.file;
        manifest += "\",\n";
        manifest += "  \"trigger_line\": ";
        manifest += FormatDecimal(static_cast<usize>(trigger.line), triggerLineBuffer);
        manifest += ",\n";
        manifest += "  \"dump_detail_mode\": \"small\",\n";
        manifest += "  \"artifact_strategy\": \"unit_test\",\n";
        manifest += "  \"handler_lifetime\": \"unit_test\"\n";
        manifest += "}\n";
    }
    return manifest;
}

void BeginArchiveWithManifest(
    in StringView crashId,
    in StringView platform,
    in StringView event,
    in StringView reasonKind,
    in u64 reasonCode,
    in ManifestEventFieldEnum eventField,
    in ManifestTriggerFields trigger,
    mut GlobalArena arena,
    mut CrashTestText archive
){
    archive += s_ArchiveHeaderText;
    const CrashTestText manifest = BuildManifest(crashId, platform, event, reasonKind, reasonCode, eventField, trigger, arena);
    AppendArchiveFile(s_ManifestFileName, StringView(manifest.data(), manifest.size()), archive);
}

b8 WriteArchive(mut GlobalArena arena, in StringView testGroup, in StringView stem, in StringView archive){
    b8 ok = false;
    const CrashTestPath inputDir = ArchiveInputDirectory(arena, testGroup);
    const CrashTestPath archivePath = ArchivePath(arena, testGroup, stem);
    native(in inputDir, in archivePath, in archive, mut ok){
        if(EnsureDirectories(inputDir))
            ok = WriteTextFile(archivePath, archive);
    }
    return ok;
}

CrashIngestConfig MakeIngestConfig(mut GlobalArena arena, in StringView testGroup){
    CrashIngestConfig config = CrashIngestConfig(arena);
    config.storageDirectory = StorageDirectory(arena, testGroup);
    return config;
}

void BuildLinuxCrashArchive(in StringView crashId, mut GlobalArena arena, mut CrashTestText archive){
    BeginArchiveWithManifest(crashId, s_Linux, s_Crash, s_Signal, 11u, s_IncludeEventField, ManifestTriggerFields(), arena, archive);
    AppendArchiveFile(s_CpuContextFileName, "fault_address=0\ninstruction_pointer=4198964\nstack_pointer=0\nframe_pointer=0\n", archive);
    AppendArchiveFile(s_CallstackFileName, "#0 0x0000000000401234\n#1 0x0000000000401240\n", archive);
    AppendArchiveFile(s_ProcMapsFileName, "00400000-00452000 r-xp 00000000 08:01 123 /tmp/nwb_loader\n", archive);
}

CrashIngestResult ProcessCrashArchive(mut GlobalArena arena, in StringView testGroup, in StringView stem, in StringView archive, in CrashIngestConfig config){
    EXPECT_TRUE(WriteArchive(arena, testGroup, stem, archive));
    return ProcessCrashUpload(arena, ArchivePath(arena, testGroup, stem), config);
}

CrashIngestResult ProcessCrashArchive(mut GlobalArena arena, in StringView testGroup, in StringView stem, in StringView archive){
    const CrashIngestConfig config = MakeIngestConfig(arena, testGroup);
    return ProcessCrashArchive(arena, testGroup, stem, archive, config);
}

b8 ReadServerSymbolicationText(mut GlobalArena arena, in StringView testGroup, in StringView stem, mut CrashTestText outReport){
    b8 ok = false;
    native(mut arena, in testGroup, in stem, mut outReport, mut ok){
        auto result = ReadServerSymbolication(arena, testGroup, stem);
        if(result){
            outReport = Move(*result);
            ok = true;
        }
    }
    return ok;
}

void ExpectPathExists(in CrashTestPath path, in b8 expected){
    native(in path, in expected){
        const auto query = FileExists(path);
        ASSERT_TRUE(query);
        EXPECT_EQ(*query, expected);
    }
}

void ExpectIsDirectory(in CrashTestPath path, in b8 expected){
    native(in path, in expected){
        const auto query = IsDirectory(path);
        ASSERT_TRUE(query);
        EXPECT_EQ(*query, expected);
    }
}

void ExpectIsRegularFile(in CrashTestPath path, in b8 expected){
    native(in path, in expected){
        const auto query = IsRegularFile(path);
        ASSERT_TRUE(query);
        EXPECT_EQ(*query, expected);
    }
}


