[ordered]
class RevisionArmingComboSource : IListDataSource{
    public TestObserved<u64> textCalls;
    public TestObserved<b8> armed;
    public mut PopupToolsSource m_menuSource;
    public mut ComboState m_combo;
    public PopupToolsSource m_rows;

    public RevisionArmingComboSource(mut PopupToolsSource menuSource, mut ComboState combo){
        this.m_menuSource = menuSource;
        this.m_combo = combo;
        this.m_rows.generation = 1501u;
    }
    public u64 instanceGeneration()const override{ return this.m_rows.instanceGeneration(); }
    public u64 revision()const override{ return this.m_rows.revision(); }
    public u64 rowCount()const override{ return this.m_rows.rowCount(); }
    public u64 key(in u64 index)const override{ return this.m_rows.key(index); }
    public Expected<u64> indexOf(in u64 key)const override{ return this.m_rows.indexOf(key); }
    public Expected<u64> findEnabled(in u64 start, in b8 reverse)const override{
        return this.m_rows.findEnabled(start, reverse);
    }
    public StringView text(in u64 index)const override{
        ++this.textCalls.value();
        if(!this.armed.value()){
            this.m_menuSource.closeComboOnRevision.value() = Optional<mut ComboState>(this.m_combo);
            this.armed.value() = true;
        }
        return this.m_rows.text(index);
    }
    public b8 enabled(in u64 index)const override{ return this.m_rows.enabled(index); }
}


