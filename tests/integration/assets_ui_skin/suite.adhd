void VerifyAssetsUiSkin_RejectsObsoleteBinaryVersionsWithoutReplacingCurrentSkin(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    SkinTestArena testArena = SkinTestArena();
    UiSkin skin(testArena.arena, Name(s_AtlasPath));
    ASSERT_TRUE(skin.loadBinary(MakeBinary(ValidHeader(), ValidRegion(), testArena)));
    for(u32 version = 1u; version <= 2u; ++version){
        const ScopedTestTrace trace(version);
        UiSkinHeaderBinary header = ValidHeader();
        header.version = version;
        AssetBytes binary = MakeBinary(header, ValidRegion(), testArena);
        EXPECT_FALSE(skin.loadBinary(binary));
        usize obsoleteSize = s_UiSkinHeaderBinarySize + s_UiSkinRegionBinarySize;
        if(version == 2u)
            obsoleteSize += s_ColorRoleCount * s_UiSkinColorSize;
        binary.resize(obsoleteSize);
        EXPECT_FALSE(skin.loadBinary(binary));
        EXPECT_EQ(skin.regions().size(), 1u);
        EXPECT_FLOAT_EQ(skin.typography().defaultFontSize, 16.0f);
    }
    EXPECT_TRUE(logger.sawErrorContaining(s_ErrRecookRequired));
}

void VerifyAssetsUiSkin_LoadRejectsMalformedHeaderAndCountWithoutReplacingSkin(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    SkinTestArena testArena = SkinTestArena();
    const UiSkinHeaderBinary validHeader = ValidHeader();
    const UiSkinRegionBinary validRegion = ValidRegion();
    UiSkin skin(testArena.arena, Name(s_AtlasPath));
    ASSERT_TRUE(skin.loadBinary(MakeBinary(validHeader, validRegion, testArena)));

    for(u32 variant = 0u; variant < 10u; ++variant){
        const ScopedTestTrace trace(variant);
        UiSkinHeaderBinary header = validHeader;
        switch(variant){
        case 0u: header.magic = 0u; break;
        case 1u: header.version = 4u; break;
        case 2u: header.reserved0 = 1u; break;
        case 3u: header.reserved1 = 1u; break;
        case 4u: header.regionCount = 0u; break;
        case 5u: header.regionCount = u32.max; break;
        case 6u: header.textureNameHash = NameHash(); break;
        case 7u: header.atlasWidth = 0u; break;
        case 8u: header.referenceDensity = 0.0f; break;
        case 9u: header.referenceDensity = s_QuietNaNF32; break;
        default: break;
        }
        const AssetBytes binary = MakeBinary(header, validRegion, testArena);
        EXPECT_FALSE(skin.loadBinary(binary));
        ASSERT_EQ(skin.regions().size(), 1u);
        EXPECT_EQ(skin.atlasWidth(), validHeader.atlasWidth);
    }

    AssetBytes binary = MakeBinary(validHeader, validRegion, testArena);
    binary.pop_back();
    EXPECT_FALSE(skin.loadBinary(binary));
    binary.resize(s_UiSkinHeaderBinarySize - 1u);
    EXPECT_FALSE(skin.loadBinary(binary));
    binary = MakeBinary(validHeader, validRegion, testArena);
    binary.push_back(0u);
    EXPECT_FALSE(skin.loadBinary(binary));
    EXPECT_TRUE(logger.sawErrorContaining(s_ErrTrailingBytes));
}

void VerifyAssetsUiSkin_LoadRejectsInvalidRegionBoundsMetricsAndFlags(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    SkinTestArena testArena = SkinTestArena();
    const UiSkinHeaderBinary header = ValidHeader();
    for(u32 variant = 0u; variant < 14u; ++variant){
        const ScopedTestTrace trace(variant);
        UiSkinRegionBinary region = ValidRegion();
        switch(variant){
        case 0u: region.nameHash = NameHash(); break;
        case 1u: region.nameHash = Name("").hash(); break;
        case 2u: region.width = 0u; break;
        case 3u: region.x = u32.max; break;
        case 4u: region.y = 32u; break;
        case 5u: region.width = u32.max; break;
        case 6u: region.sliceLeft = 25u; break;
        case 7u: region.sliceTop = u32.max; break;
        case 8u: region.drawMode = 256u; break;
        case 9u: region.reserved = 1u; break;
        case 10u: region.paddingLeft = -1.0f; break;
        case 11u: region.minimumWidth = s_QuietNaNF32; break;
        case 12u: region.minimumHeight = s_InfinityF32; break;
        case 13u: region.drawMode = s_DrawModeSprite; break;
        default: break;
        }
        UiSkin skin(testArena.arena, Name(s_AtlasPath));
        EXPECT_FALSE(skin.loadBinary(MakeBinary(header, region, testArena)));
        EXPECT_TRUE(skin.regions().empty());
    }
}

void VerifyAssetsUiSkin_RejectsOverLimitCountsBeforeReadingOrCopyingRegions(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    SkinTestArena testArena = SkinTestArena();
    UiSkin skin(testArena.arena, Name(s_AtlasPath));
    ASSERT_TRUE(skin.loadBinary(MakeBinary(ValidHeader(), ValidRegion(), testArena)));

    UiSkinHeaderBinary header = ValidHeader();
    header.regionCount = s_UiSkinMaxRegionCount + 1u;
    AssetBytes binary(testArena.arena);
    native(in header, mut binary){
        binary.reserve(sizeof(header));
        AppendPOD(binary, header);
    }
    EXPECT_FALSE(skin.loadBinary(binary));
    EXPECT_TRUE(logger.sawErrorContaining(s_ErrLoadRegionLimit));
    ASSERT_EQ(skin.regions().size(), 1u);
    EXPECT_EQ(skin.regions().front().name, s_UiTestPanelNormal);

    const TestAString paletteMeta = PaletteMetadata(0u, true);
    native(in paletteMeta, mut testArena){
        Core::Metascript::Document document(testArena.arena);
        ASSERT_TRUE(document.parse(paletteMeta));
        Core::Metascript::Value* const asset = document.findVariable("asset");
        ASSERT_NE(asset, nullptr);
        Core::Metascript::Value& regions = asset->field("regions");
        const Core::Metascript::Value regionTemplate(regions.asList().front());
        regions.asList().clear();
        regions.asList().reserve(s_UiSkinMaxRegionCount + 1u);
        for(u32 index = 0u; index <= s_UiSkinMaxRegionCount; ++index)
            regions.asList().push_back(regionTemplate);
        const Path assetRoot(testArena.arena, s_SkinAssetRoot);
        const Path metadataPath = assetRoot / s_UiDirectory / s_AtlasMetadataFilename;
        Core::Alloc::ScratchArena scratchArena(s_OneOffNameTestsIntegrationAssetsUiSkinCook);
        EXPECT_FALSE(ParseUiSkinCookMetadata(assetRoot, "project", metadataPath, document, testArena.arena, scratchArena));
    }
    EXPECT_TRUE(logger.sawErrorContaining(s_ErrCookRegionLimit));

    RegionVector oversized(testArena.arena);
    oversized.reserve(s_UiSkinMaxRegionCount + 1u);
    for(u32 index = 0u; index <= s_UiSkinMaxRegionCount; ++index)
        oversized.push_back(skin.regions().front());
    UiSkin constructed(testArena.arena, skin.virtualPath());
    native(in skin, mut oversized, mut constructed){
        constructed.setAtlas(skin.texture(), skin.atlasWidth(), skin.atlasHeight(), skin.referenceDensity(), Move(oversized));
    }
    EXPECT_FALSE(constructed.validatePayload());
    EXPECT_TRUE(logger.sawErrorContaining(s_ErrValidateRegionLimit));
}

void VerifyAssetsUiSkin_CookRejectsObsoleteMetadataUnknownFieldsAndMalformedArrays(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    SkinTestArena testArena = SkinTestArena();
    for(usize index = 0u; index < s_InvalidCookOverrides.size(); ++index){
        const StringView overrideText = s_InvalidCookOverrides[index];
        const ScopedTestTrace trace(overrideText);
        TestAString metadata = PaletteMetadata(0u, true);
        metadata.append(overrideText);
        EXPECT_FALSE(CanParseMetadata(metadata, testArena));
    }
    EXPECT_TRUE(logger.sawErrorContaining(s_ErrUnsupportedField));
    EXPECT_TRUE(logger.sawErrorContaining(s_ErrToolkitContractWidgets));
}

void VerifyAssetsUiSkin_RetiredSpriteSliceFieldsAreRejected(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    SkinTestArena testArena = SkinTestArena();
    ASSERT_TRUE(CanParseMetadata(PaletteMetadata(0u, true), testArena));
    for(usize index = 0u; index < s_RetiredSpriteSliceOverrides.size(); ++index){
        TestAString metadata = PaletteMetadata(0u, true);
        metadata.append("asset.texture = \"project/other_texture\";\r\n");
        metadata.append(s_RetiredSpriteSliceOverrides[index]);
        EXPECT_FALSE(CanParseMetadata(metadata, testArena));
    }
    EXPECT_TRUE(logger.sawErrorContaining(s_ErrUnsupportedSliceField));
    TestAString spriteMetadata = PaletteMetadata(0u, true);
    spriteMetadata.append("asset.regions = [{ \"name\": \"sprite\", \"rect\": [0, 0, 4, 4], \"draw_mode\": \"sprite\" }];\r\n");
    usize spriteRegionCount = 0u;
    b8 parsedSprite = false;
    native(in spriteMetadata, mut testArena, mut spriteRegionCount, mut parsedSprite){
        Core::Metascript::Document document(testArena.arena);
        if(document.parse(spriteMetadata)){
            const Path assetRoot(testArena.arena, s_SkinAssetRoot);
            const Path metadataPath = assetRoot / s_UiDirectory / s_AtlasMetadataFilename;
            Core::Alloc::ScratchArena scratchArena(s_OneOffNameTestsIntegrationAssetsUiSkinCook);
            auto entryResult = ParseUiSkinCookMetadata(assetRoot, "project", metadataPath, document, testArena.arena, scratchArena);
            if(entryResult){
                spriteRegionCount = entryResult->regions.size();
                parsedSprite = true;
            }
        }
    }
    ASSERT_TRUE(parsedSprite);
    ASSERT_EQ(spriteRegionCount, 1u);
}

