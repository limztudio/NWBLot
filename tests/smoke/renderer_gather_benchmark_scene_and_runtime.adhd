#include "smoke_skinned_scene_helpers.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_GatherBenchmarkFixedDelta = 0.016666667f;
const u32 s_GatherBenchmarkInFlightRanges = 32u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{
#include <loader/project_entry.h>
#include <impl/ecs_render/module.adhd.h>
#include <impl/ecs_mesh/skinning/system.adhd.h>
#include <core/alloc/scratch.h>
#include <core/common/log.h>
#include <core/graphics/runtime/runtime.h>
#include <global/simd/vector.h>


