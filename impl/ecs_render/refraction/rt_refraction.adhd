#include <impl/ecs_render/refraction/types.adhd>
#include <impl/ecs_render/refraction/rt_refraction_targets_and_tasks.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanEnableRefractionHardwareTracing(
    in b8 hardwareTracingEnabled,
    in b8 shadowVisibilityHardwareSupported,
    in b8 traceResourcesPreflighted,
    in b8 backendPipelinePreflighted,
    in b8 rayQuerySupported,
    in b8 hasAccelStructLayout,
    in b8 hasTlas,
    in b8 tlasHandleValid,
    in b8 hasMaterialContextSlotsBuffer
){
    return hardwareTracingEnabled
        && shadowVisibilityHardwareSupported
        && traceResourcesPreflighted
        && backendPipelinePreflighted
        && rayQuerySupported
        && hasAccelStructLayout
        && hasTlas
        && tlasHandleValid
        && hasMaterialContextSlotsBuffer;
}

b8 IsRefractionStatisticsResourcesReady(in b8 hasCounters, in b8 counterDescriptorValid, in b8 hasBuffer0){
    return hasCounters && counterDescriptorValid && hasBuffer0;
}


