////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The cook combines this hook with engine pixel authoring and the material's typed .bind.
#include "material_color.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static const half NWB_TESTBED_UV_DEBUG_CHECKER_CELLS_PER_AXIS = 8.0h;
static const half NWB_TESTBED_UV_DEBUG_CHECKER_PERIOD = 2.0h;
static const half NWB_TESTBED_UV_DEBUG_CHECKER_DARK_SCALE = 0.55h;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


half3 nwbProjectUvDebug(const float2 uv0){
    const half2 wrappedUv = half2(frac(uv0));
    const half2 checkerCell = floor(wrappedUv * NWB_TESTBED_UV_DEBUG_CHECKER_CELLS_PER_AXIS);
    const half checker = fmod(checkerCell.x + checkerCell.y, NWB_TESTBED_UV_DEBUG_CHECKER_PERIOD);
    const half3 uvColor = half3(wrappedUv, 1.0h - wrappedUv.x);
    return lerp(uvColor * NWB_TESTBED_UV_DEBUG_CHECKER_DARK_SCALE, uvColor, checker);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NwbMeshSurface nwbMaterialSurface(){
    return nwbMakeMeshSurface(nwbProjectUvDebug(inUv0) * nwbMaterialSurfaceBaseColor(), inNormal);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

