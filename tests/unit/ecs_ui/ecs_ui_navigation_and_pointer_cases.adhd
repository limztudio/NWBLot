void VerifyUiEditPointerCaptureTests_MainEditorCaptureStillClampsAnOutOfBoundsCrossLineDrag(mut UiEditPointerCaptureTests self){
    ASSERT_TRUE(self.m_navigationModel.setText("ab\ncd\nxy"));
    ASSERT_TRUE(self.m_navigationModel.setSelection(0u, 0u));
    ASSERT_TRUE(self.activateNavigation());
    ASSERT_TRUE(PublishEcsUiPointerCapturePart(self, true));
    ASSERT_TRUE(self.core.dispatchPoint(MakeEcsUiPoint(20.0f, 26.0f), InputEventType::PrimaryDown));
    EXPECT_EQ(self.core.m_context.input().capture(), self.core.m_widget.id);
    ASSERT_TRUE(self.core.dispatchPoint(MakeEcsUiPoint(30.0f, 120.0f), InputEventType::PointerMove));
    ASSERT_TRUE(self.core.dispatchPoint(MakeEcsUiPoint(30.0f, 120.0f), InputEventType::PrimaryUp));
    ASSERT_TRUE(self.navigationFrame());
    EXPECT_EQ(self.m_navigationModel.anchor(), 1u);
    EXPECT_EQ(self.m_navigationModel.caret(), 8u);
    EXPECT_EQ(self.m_navigationModel.selectedText(), "b\ncd\nxy");
    EXPECT_FALSE(self.m_navigationModel.canUndo());
    EXPECT_FALSE(self.core.m_context.input().capture().valid());
}

void VerifyUiEditPointerSourceTests_ForeignContactCannotMoveOrEndTheAcceptedEditorSelection(mut UiEditPointerSourceTests self){
    ASSERT_TRUE(self.m_model.setText("abcdef"));
    ASSERT_TRUE(self.activate());
    const InputSource first = MakeEcsUiInputSource(17u, 1u);
    const InputSource second = MakeEcsUiInputSource(17u, 2u);
    PointerInput input = PointerInput();
    input.source = first;
    input.position = self.atByte(1u);
    input.phase = PointerPhase::Press;
    ASSERT_TRUE(self.dispatchPointer(input));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.caret(), 1u);

    input.source = second;
    input.position = self.atByte(5u);
    input.phase = PointerPhase::Press;
    ASSERT_TRUE(self.dispatchPointer(input));
    input.position = self.atByte(6u);
    input.phase = PointerPhase::Move;
    ASSERT_TRUE(self.dispatchPointer(input));
    input.phase = PointerPhase::Release;
    ASSERT_TRUE(self.dispatchPointer(input));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.caret(), 1u);
    EXPECT_EQ(self.m_model.anchor(), 1u);
    EXPECT_EQ(self.m_context.input().activePointerSource(), first);

    input.source = first;
    input.position = self.atByte(4u);
    input.phase = PointerPhase::Move;
    ASSERT_TRUE(self.dispatchPointer(input));
    input.phase = PointerPhase::Release;
    ASSERT_TRUE(self.dispatchPointer(input));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.selectedText(), "bcd");
    EXPECT_FALSE(self.m_context.input().activePointerSource().valid());
}

void VerifyUiEditPointerSourceTests_TouchTimestampsCannotManufactureNativeDoubleClickWordSelection(mut UiEditPointerSourceTests self){
    ASSERT_TRUE(self.m_model.setText("one two"));
    ASSERT_TRUE(self.activate());
    const InputSource touch = MakeEcsUiInputSource(21u, 9u);
    Array<u64, 2> timestamps = Array<u64, 2>();
    timestamps[0u] = 1000u;
    timestamps[1u] = 1200u;
    for(in u64 timestamp : timestamps){
        PointerInput press = PointerInput();
        press.source = touch;
        press.timestampMs = timestamp;
        press.position = self.atByte(1u);
        press.phase = PointerPhase::Press;
        ASSERT_TRUE(self.dispatchPointer(press));
        PointerInput release = PointerInput();
        release.source = touch;
        release.position = self.atByte(1u);
        release.phase = PointerPhase::Release;
        ASSERT_TRUE(self.dispatchPointer(release));
        ASSERT_TRUE(self.frame(self.m_model));
        EXPECT_EQ(self.m_model.caret(), 1u);
        EXPECT_EQ(self.m_model.anchor(), 1u);
        EXPECT_TRUE(self.m_model.selectedText().empty());
    }
}

void VerifyUiEditPointerSourceTests_CancelledContactCannotEraseAnEarlierCompletedSelection(mut UiEditPointerSourceTests self){
    ASSERT_TRUE(self.m_model.setText("abcdef"));
    ASSERT_TRUE(self.activate());
    const InputSource completed = MakeEcsUiInputSource(31u, 1u);
    const InputSource next = MakeEcsUiInputSource(31u, 2u);
    Array<InputSource, 2> sources = Array<InputSource, 2>();
    sources[0u] = completed;
    sources[1u] = next;
    for(in InputSource cancelled : sources){
        ASSERT_TRUE(self.m_model.setSelection(0u, 0u));
        ASSERT_TRUE(self.frame(self.m_model));

        PointerInput event = PointerInput();
        event.source = completed;
        event.position = self.atByte(1u);
        event.phase = PointerPhase::Press;
        ASSERT_TRUE(self.dispatchPointer(event));
        event.phase = PointerPhase::Release;
        ASSERT_TRUE(self.dispatchPointer(event));

        event.source = cancelled;
        event.position = self.atByte(5u);
        event.phase = PointerPhase::Press;
        ASSERT_TRUE(self.dispatchPointer(event));
        event.phase = PointerPhase::Cancel;
        ASSERT_TRUE(self.dispatchPointer(event));
        EXPECT_EQ(self.m_model.caret(), 0u);
        EXPECT_FALSE(self.m_context.input().activePointerSource().valid());
        ASSERT_TRUE(self.frame(self.m_model));
        EXPECT_EQ(self.m_model.caret(), 1u);
        EXPECT_EQ(self.m_model.anchor(), 1u);
        EXPECT_TRUE(self.m_model.selectedText().empty());

        event.source = cancelled;
        event.position = self.atByte(2u);
        event.phase = PointerPhase::Press;
        ASSERT_TRUE(self.dispatchPointer(event));
        event.phase = PointerPhase::Release;
        ASSERT_TRUE(self.dispatchPointer(event));
        ASSERT_TRUE(self.frame(self.m_model));
        EXPECT_EQ(self.m_model.caret(), 2u);
        EXPECT_EQ(self.m_model.anchor(), 2u);
    }
}

void VerifyUiEditActionHostTests_HeldSubmitObservesReleaseAfterDraftEventsWithoutRepeating(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    ASSERT_TRUE(self.replaceNative("42"));
    InputEvent down = InputEvent();
    down.key = Key::Enter;
    down.type = InputEventType::KeyDown;
    ASSERT_TRUE(self.core.dispatch(down));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_FALSE(self.core.m_result.submitted);
    EXPECT_TRUE(self.m_actions.records.empty());
    EXPECT_EQ(self.core.m_model.text(), "42");
    ASSERT_TRUE(self.core.dispatch(down));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_FALSE(self.core.m_result.submitted);
    EXPECT_TRUE(self.m_actions.records.empty());
    ASSERT_TRUE(self.commitNative("7"));
    InputEvent up = InputEvent();
    up.key = Key::Enter;
    up.type = InputEventType::KeyUp;
    ASSERT_TRUE(self.core.dispatch(up));
    ASSERT_TRUE(self.commitNative("9"));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_TRUE(self.core.m_result.submitted);
    ASSERT_EQ(self.actionCount(EditAction::Submit), 1u);
    EXPECT_EQ(self.m_actions.records[0u].text, "427");
    EXPECT_EQ(self.m_actions.committed, "427");
    EXPECT_EQ(self.core.m_model.text(), "4279");
    ASSERT_TRUE(self.core.dispatch(up));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_EQ(self.actionCount(EditAction::Submit), 1u);
}

void VerifyUiEditActionHostTests_EscapeCancelsConcurrentKeyboardAndControllerSubmitsBeforeRelease(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    ASSERT_TRUE(self.replaceNative("42"));
    const InputSource controller = MakeEcsUiInputSource(7u, 3u);
    InputEvent keyDown = InputEvent();
    keyDown.key = Key::Enter;
    keyDown.type = InputEventType::KeyDown;
    ASSERT_TRUE(self.core.dispatch(keyDown));
    InputEvent cmdDown = InputEvent();
    cmdDown.source = controller;
    cmdDown.type = InputEventType::CommandDown;
    cmdDown.command = InputCommand::Submit;
    ASSERT_TRUE(self.core.dispatch(cmdDown));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_TRUE(self.m_actions.records.empty());
    ASSERT_TRUE(self.core.key(Key::Escape));
    keyDown.repeat = true;
    ASSERT_TRUE(self.core.dispatch(keyDown));
    InputEvent keyUp = InputEvent();
    keyUp.key = Key::Enter;
    keyUp.type = InputEventType::KeyUp;
    ASSERT_TRUE(self.core.dispatch(keyUp));
    InputEvent cmdUp = InputEvent();
    cmdUp.source = controller;
    cmdUp.type = InputEventType::CommandUp;
    ASSERT_TRUE(self.core.dispatch(cmdUp));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_FALSE(self.core.m_result.submitted);
    EXPECT_TRUE(self.core.m_result.cancelled);
    EXPECT_EQ(self.actionCount(EditAction::Submit), 0u);
    EXPECT_EQ(self.actionCount(EditAction::Cancel), 1u);
    EXPECT_EQ(self.m_actions.committed, "0");
    EXPECT_EQ(self.core.m_model.text(), "0");
    ASSERT_TRUE(self.focusEditor());
    ASSERT_TRUE(self.actionFrame());
    ASSERT_TRUE(self.core.key(Key::Enter));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_EQ(self.actionCount(EditAction::Submit), 1u);
}

