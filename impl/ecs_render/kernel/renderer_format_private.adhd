    return nullptr;
}

[[nodiscard]] FOUNDATION_INLINE KernelGpuCompiledGraphReadViewConstPtr AddressOfKernelCompiledGraphReadView(const KernelGpuCompiledGraphReadView& plan)noexcept{
    return &plan;
}

[[nodiscard]] FOUNDATION_INLINE b8 CompiledGraphTaskIsValid(const KernelGpuCompiledGraphReadViewConstPtr plan, const KernelGpuTaskId& task)noexcept{
    return plan && plan->findTask(task).valid();
}

[[nodiscard]] FOUNDATION_INLINE b8 CompiledGraphTasksSharePacket(const KernelGpuCompiledGraphReadViewConstPtr plan, const KernelGpuTaskId& first, const KernelGpuTaskId& second)noexcept{
    return plan && plan->tasksSharePacket(first, second);
}

[[nodiscard]] FOUNDATION_INLINE b8 CompiledGraphTaskPrecedesInSamePacket(const KernelGpuCompiledGraphReadViewConstPtr plan, const KernelGpuTaskId& first, const KernelGpuTaskId& second)noexcept{
    return plan && plan->taskPrecedesInSamePacket(first, second);
}

[[nodiscard]] FOUNDATION_INLINE b8 CompiledGraphTaskPrecedesOrSharesPacket(const KernelGpuCompiledGraphReadViewConstPtr plan, const KernelGpuTaskId& first, const KernelGpuTaskId& second)noexcept{
    return plan && plan->taskPrecedesOrSharesPacket(first, second);
}

[[nodiscard]] FOUNDATION_INLINE b8 CompiledGraphTaskPairIsContiguous(const KernelGpuCompiledGraphReadViewConstPtr plan, const KernelGpuTaskId& first, const KernelGpuTaskId& second)noexcept{
    if(!plan)
        return false;
    const Array<Core::GpuTaskId, 2u> sequence = { first, second };
    return plan->tasksFormContiguousPacketSequence(sequence);
}

[[nodiscard]] FOUNDATION_INLINE b8 CompiledGraphTaskPrefixIsContiguous(const KernelGpuCompiledGraphReadViewConstPtr plan, const Span<const KernelGpuTaskId> tasks, const usize count)noexcept{
    return plan && count <= tasks.size() && plan->tasksFormContiguousPacketSequence(tasks.subspan(0u, count));
}

[[nodiscard]] FOUNDATION_INLINE b8 QueueInfoIsGraphicsQueue(const KernelGpuPhysicalQueueInfoConstPtr queue)noexcept{
    return queue && queue->queueClass == Core::CommandQueue::Graphics;
}

[[nodiscard]] FOUNDATION_INLINE b8 CompiledGraphTaskIsOnGraphicsQueue(const KernelGpuCompiledGraphReadViewConstPtr plan, const KernelGpuTaskId& task)noexcept{
    return plan && QueueInfoIsGraphicsQueue(plan->queueInfoForTask(task));
}

[[nodiscard]] FOUNDATION_INLINE KernelFormat SelectKernelSupportedFormat(KernelDevice& device, const Span<const KernelFormat> candidates, const KernelFormatSupportMask requiredSupport)noexcept{
    return ECSRenderDetail::SelectSupportedFormat(device, candidates, requiredSupport);
}

[[nodiscard]] FOUNDATION_INLINE b8 PrepareKernelGpuTimingScopeQueries(KernelGraphicsRuntime& graphics, const Name& scope, const u32 queryCount){
    return graphics.gpuTiming().prepareScopeQueries(scope, graphics.getDevice(), queryCount);
}

[[nodiscard]] FOUNDATION_INLINE KernelGpuTimingRecorderStatistics QueryKernelGpuTimingStatistics(KernelGraphicsRuntime& graphics){
