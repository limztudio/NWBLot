#include <impl/ecs_render/mesh/mesh_system.adhd>
#include <impl/ecs_render/raytrace/raytracing_system.adhd>
#include <impl/ecs_render/raytrace/graph_snapshots.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Software-BVH build-state import owns the mesh software-BVH parent plus raytracing BVH sort-buffer graph imports.
class FrameGraphSoftwareBvhBuildStateInputs{
    public in RayTracingShadowPreparationResourceSnapshot rayTracingShadowResources;
    public b8 softwareTraceResourcesPrepared;

    public FrameGraphSoftwareBvhBuildStateInputs(in RayTracingShadowPreparationResourceSnapshot inRayTracingShadowResources){
        this.rayTracingShadowResources = inRayTracingShadowResources;
        this.softwareTraceResourcesPrepared = false;
    }

    public FrameGraphSoftwareBvhBuildStateInputs(
        in RayTracingShadowPreparationResourceSnapshot inRayTracingShadowResources,
        in b8 inSoftwareTraceResourcesPrepared
    ){
        this.rayTracingShadowResources = inRayTracingShadowResources;
        this.softwareTraceResourcesPrepared = inSoftwareTraceResourcesPrepared;
    }
}


class FrameGraphSoftwareBvhBuildStateResult{
    public Vector<GpuGraphResourceId> buildStateResources;
}


[modular]
class FrameGraphSoftwareBvhBuildStateImporter : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut RendererMeshSystem m_meshSystem;

    public FrameGraphSoftwareBvhBuildStateImporter(mut GpuTaskGraph graph, mut RendererMeshSystem meshSystem){
        this.m_graph = graph;
        this.m_meshSystem = meshSystem;
    }

    public Expected<FrameGraphSoftwareBvhBuildStateResult> declare(in FrameGraphSoftwareBvhBuildStateInputs inputs);
}


// Graph imports for the preflighted trace geometry buffers, trace material textures, their resource sets, and software BVH build state.
class FrameGraphTraceGeometryResult{
    public Vector<GpuGraphResourceId> traceGeometry;
    public Vector<GpuGraphResourceId> hardwareTraceGeometry;
    public Vector<GpuGraphResourceId> softwareTraceGeometry;
    public Vector<GpuGraphResourceId> softwareBvhBuildState;
    public GpuGraphResourceSetId shadowTraceGeometrySet;
    public GpuGraphResourceSetId softwareTraceGeometrySet;
    public GpuGraphResourceSetId traceMaterialSampledTextureSet;
    public GpuGraphResourceSetId hardwareTraceGeometrySet;
    public b8 softwareTraceResourcesPrepared = false;
}


[modular]
class FrameGraphTraceGeometryImporter : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut RendererMeshSystem m_meshSystem;

    public FrameGraphTraceGeometryImporter(mut GpuTaskGraph graph, mut RendererRayTracingSystem raytracingSystem, mut RendererMeshSystem meshSystem){
        this.m_graph = graph;
        this.m_raytracingSystem = raytracingSystem;
        this.m_meshSystem = meshSystem;
    }

    public Expected<FrameGraphTraceGeometryResult> declare(in RayTracingShadowPreparationResourceSnapshot rayTracingShadowResources);
    private GpuGraphResourceSetId importSet(in Span<GpuGraphResourceId> members, in Name identity, in StringView markerLabel);
}


