#include <impl/ecs_render/renderer_frame_pipeline.adhd>
#include <impl/ecs_render/avboit/frame_graph_avboit_stage.adhd>
#include <impl/ecs_render/caustic/hardware_caustics_stage_builder.adhd>
#include <impl/ecs_render/deferred/deferred_frame_target_builder.adhd>
#include <impl/ecs_render/deferred/frame_tail_builder.adhd>
#include <impl/ecs_render/deferred/graph_resource_import_builder.adhd>
#include <impl/ecs_render/deferred/lighting_stage_builder.adhd>
#include <impl/ecs_render/deferred/task_graph_suffix_builder.adhd>
#include <impl/ecs_render/kernel/task_graph_clear_timing.adhd>
#include <impl/ecs_render/kernel/task_graph_resource_utils.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>
#include <impl/ecs_render/material/task_graph_object_geometry_cache.adhd>
#include <impl/ecs_render/optics/task_graph_optical_scene_upload.adhd>
#include <impl/ecs_render/raytrace/frame_graph_trace_geometry.adhd>
#include <impl/ecs_render/raytrace/rt_private.adhd>
#include <impl/ecs_render/reflection/frame_graph_reflection_resolve.adhd>
#include <impl/ecs_render/refraction/task_graph_refraction_resolve.adhd>
#include <impl/ecs_render/shared/frame_types.adhd>
#include <impl/ecs_render/kernel/graphics_prefix_timing_ticket.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 HasDedicatedAsyncComputeQueueFamily(in u32 graphicsFamilyIndex, in u32 computeFamilyIndex){
    return computeFamilyIndex != u32.max && computeFamilyIndex != graphicsFamilyIndex;
}

b8 ShouldUseLaggedLightingHistoryInGraph(in b8 dedicatedAsyncCompute, in b8 frameLaggedAsyncLightingEnabled, in b8 laggedLightingHistoryReady, in b8 laggedLightingHistoryReadReady){
    return dedicatedAsyncCompute && frameLaggedAsyncLightingEnabled && laggedLightingHistoryReady && laggedLightingHistoryReadReady;
}

b8 ShouldCaptureLaggedLightingHistoryInGraph(in b8 includeCapture, in b8 dedicatedAsyncCompute, in b8 frameLaggedAsyncLightingEnabled){
    return includeCapture && dedicatedAsyncCompute && frameLaggedAsyncLightingEnabled;
}

b8 ShouldRetainRefractionCapPipeline(in b8 preparedRefractionActive, in b8 hasTransparentStaticWork, in b8 hasTransparentSkinnedWork){
    return preparedRefractionActive && (hasTransparentStaticWork || hasTransparentSkinnedWork);
}

b8 ShouldImportSharedHardwareOpticalSceneReads(in b8 hardwareTransparentTrace, in b8 declaresHardwareCaustics, in b8 causticOpticalReader){
    return hardwareTransparentTrace || (declaresHardwareCaustics && causticOpticalReader);
}

b8 ShouldRequestOpticalCapture(in b8 hasTransparentRenderers, in b8 refractionEnabled, in b8 reflectionEnabled){
    return hasTransparentRenderers && (refractionEnabled || reflectionEnabled);
}

b8 IsRefractionStageActive(in b8 preparedRefractionActive, in b8 opticalCaptureRequested){
    return preparedRefractionActive && opticalCaptureRequested;
}

b8 IsDeferredGraphTargetAndViewReady(in b8 targetsValid, in b8 bindlessValid, in b8 meshViewValid, in b8 csgEmpty, in b8 frameBindingsValid, in b8 lightingResourcesValid){
    return targetsValid && bindlessValid && meshViewValid && (csgEmpty || frameBindingsValid) && lightingResourcesValid;
}

b8 IsDeferredGraphPresentationAndHistoryReady(in b8 backBufferMatchesAttachment, in b8 hasTransparentRenderers, in b8 featureHasTransparentRenderers, in b8 useLaggedLightingHistory, in b8 historyValid, in b8 capturesLaggedLightingHistory, in b8 captureHistoryValid){
    return backBufferMatchesAttachment && hasTransparentRenderers == featureHasTransparentRenderers && (!useLaggedLightingHistory || historyValid) && (!capturesLaggedLightingHistory || captureHistoryValid);
}

b8 ImportDeferredExternalCompletion(
    in Name identity,
    in StringView markerLabel,
    in QueueSubmissionToken token,
    mut GpuTaskGraph graph,
    mut GpuExternalCompletionId outCompletion
){
    GpuExternalCompletionDesc desc;
    desc.setIdentity(identity).setMarkerLabel(markerLabel).setToken(token);
    const Expected<GpuExternalCompletionId> completionResult = graph.importExternalCompletion(desc);
    if(!completionResult.has_value()){
        outCompletion = GpuExternalCompletionId();
        return false;
    }
    outCompletion = completionResult.value();
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Span<GpuGraphResourceId> SelectFrameTraceGeometry(in FrameGraphTraceGeometryResult geometry, in b8 hardware){
    if(hardware)
        return Span<GpuGraphResourceId>(geometry.hardwareTraceGeometry);
    return Span<GpuGraphResourceId>(geometry.softwareTraceGeometry);
}

GpuGraphResourceSetId SelectFrameTraceGeometrySet(in FrameGraphTraceGeometryResult geometry, in b8 hardware){
    if(hardware)
        return geometry.hardwareTraceGeometrySet;
    return geometry.softwareTraceGeometrySet;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
void RendererFramePipeline::buildDeferredLightingTaskGraph(
    in RendererFrameGraphFeatures features,
    in CsgFrameState csgFrameState,
    in b8 clearAvboitTargets,
    in b8 hasTransparentRenderers,
    in b8 hasOpaqueCsgFrameWork,
    in f32 meshViewAspectRatio,
    in AcquiredPresentationFrame presentationFrame,
    in borrow b8 asyncPrefixTimingSpansOnePacket,
    in QueueSubmissionToken surfelCounterReadbackCompletionToken,
    in QueueSubmissionToken laggedLightingHistoryReadReadyToken,
    in QueueSubmissionToken laggedLightingHistoryWriterDrainToken,
    in b8 includeLaggedLightingHistoryCapture,
    mut DeferredFrameTargets deferredTargets,
    mut GpuTimingFrameTransaction frameTimingTransaction,
    mut Optional<GpuTimingMeasure> asyncPrefixTiming,
    mut Optional<GpuTimingMeasure> deferredClearTiming,
    mut GraphClearTimingRecordState deferredClearTimingState,
    mut GraphClearTimingRecordState opaqueCsgIntervalClearTimingState,
    mut Optional<GpuTimingMeasure> opaqueRegularSharedComputeEmulationTiming,
    mut Optional<GpuTimingMeasure> opaqueCsgIntervalSampleComputeEmulationTiming,
    mut GpuTimingSubmissionTicket shadowPrepareTimingTicket,
    mut Span<GraphicsPrefixTimingTicket> graphicsPrefixTimingTickets,
    mut Optional<GpuTimingMeasure> asyncFinalTiming,
    mut GpuTimingSubmissionTicket avboitPreTimingTicket,
    mut GraphClearTimingRecordState avboitClearTimingState,
    mut GraphClearTimingRecordState transparentCsgIntervalClearTimingState,
    mut Optional<GpuTimingMeasure> transparentCsgIntervalsTiming,
    mut Optional<GpuTimingMeasure> avboitOccupancyComputeEmulationTiming,
    mut Optional<GpuTimingMeasure> avboitExtinctionComputeEmulationTiming,
    mut Optional<GpuTimingMeasure> avboitAccumulationComputeEmulationTiming,
    mut GpuTimingSubmissionTicket avboitDepthWarpTimingTicket,
    mut GpuTimingSubmissionTicket avboitExtinctionTimingTicket,
    mut GpuTimingSubmissionTicket avboitIntegrationTimingTicket,
    mut GpuTimingSubmissionTicket avboitAccumulationTimingTicket,
    mut GpuTimingSubmissionTicket shadowVisibilityTimingTicket,
    mut Optional<GpuTimingMeasure> shadowVisibilityAsyncTiming,
    mut Optional<GpuTimingMeasure> shadowVisibilityTiming,
    mut Optional<GpuTimingMeasure> opaqueSoftResolveTiming,
    mut Optional<GpuTimingMeasure> transparentSoftResolveTiming,
    mut b8 shadowVisibilityOpaqueProduced,
    mut b8 shadowVisibilityTransparentTraceProduced,
    mut u32 shadowVisibilityOpaqueFrameIndex,
    mut GpuTimingSubmissionTicket softwareCausticsTimingTicket,
    mut GpuTimingSubmissionTicket surfelGiTimingTicket,
    mut Optional<GpuTimingMeasure> surfelGiAsyncTiming,
    mut GpuTimingSubmissionTicket hardwareCausticsTimingTicket,
    mut Optional<GpuTimingMeasure> causticPhotonTiming,
    mut Optional<GpuTimingMeasure> causticResolveTiming,
    mut GpuTimingSubmissionTicket lightingTimingTicket,
    mut GpuTimingSubmissionTicket compositeTimingTicket,
    mut GpuTimingSubmissionTicket presentTimingTicket
){
    const RayTracingShadowPreparationResourceSnapshot rayTracingShadowResources = this.m_raytracingSystem.snapshotShadowPreparationResources();
    const RayTracingDeferredGraphResourceSnapshot rayTracingGraphResources = this.m_raytracingSystem.snapshotDeferredGraphResources();
    const RayTracingSurfelPersistentResourceSnapshot rayTracingSurfelResources = this.m_raytracingSystem.snapshotSurfelPersistentResources();

    this.m_deferredFrameTimingBeginTask = GpuTaskId();
    this.m_shadowPrepareGraph.resetShadowPrepareTaskState();
    this.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalClearFirstTask = GpuTaskId();
    this.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalClearTask = GpuTaskId();
    this.resetDeferredFrameTaskIdsAndFlags();
    this.resetDeferredTaskGraphRuntime();
    const Timer declarationBegin = TimerNow();
    if(!this.declareFrameTimingBeginTask(frameTimingTransaction))
        return;

    const b8 dedicatedAsyncCompute = HasDedicatedAsyncComputeQueueFamily(this.m_graphics.getDevice().getQueueFamilyIndex(CommandQueue::Graphics), this.m_graphics.getDevice().getQueueFamilyIndex(CommandQueue::Compute));
    const b8 useLaggedLightingHistory = ShouldUseLaggedLightingHistoryInGraph(dedicatedAsyncCompute, features.frameLaggedAsyncLightingEnabled, features.laggedLightingHistoryReady, features.laggedLightingHistoryReadReady);
    const b8 declaresHardwareCaustics = features.hardwareCaustics;
    const b8 capturesLaggedLightingHistory = ShouldCaptureLaggedLightingHistoryInGraph(includeLaggedLightingHistoryCapture, dedicatedAsyncCompute, features.frameLaggedAsyncLightingEnabled);
    Optional<in DeferredLaggedLightingHistoryResources> history;
    if(useLaggedLightingHistory)
        history.emplace(deferredTargets.laggedLightingHistory);
    Optional<in DeferredLaggedLightingHistoryResources> captureHistory;
    if(capturesLaggedLightingHistory)
        captureHistory.emplace(deferredTargets.laggedLightingHistory);
    if(!presentationFrame.valid())
        return;
    in FramebufferDesc presentationFramebufferDesc = presentationFrame.framebuffer.deref().getDescription();
    const DeferredLightingGraphResources deferredLightingResources = this.m_deferredSystem.lightingGraphResources();
    const MeshFrameBindingSnapshot frameBindings = this.m_meshSystem.meshFrameBindingSnapshot();
    const b8 retainRefractionCapPipeline = ShouldRetainRefractionCapPipeline(this.m_preparedRefractionActive, csgFrameState.hasTransparentStaticWork, csgFrameState.hasTransparentSkinnedWork);
    CsgGraphResourceSnapshot csgResources;
    if(!csgFrameState.empty())
        csgResources = this.m_csgSystem.csgGraphResourceSnapshot(retainRefractionCapPipeline);
    in MeshViewBufferSnapshot meshViewBufferSnapshot = frameBindings.meshView;
    const b8 backBufferMatchesAttachment = presentationFramebufferDesc.colorAttachments.size() == 1u && presentationFramebufferDesc.colorAttachments[0u].hasTexture(presentationFrame.backBuffer.texture.deref());
    if(!IsDeferredGraphTargetAndViewReady(deferredTargets.valid(), deferredTargets.bindless.valid(), meshViewBufferSnapshot.valid(), csgFrameState.empty(), frameBindings.bindingValid(), deferredLightingResources.valid()))
        return;
    if(!IsDeferredGraphPresentationAndHistoryReady(backBufferMatchesAttachment, hasTransparentRenderers, features.hasTransparentRenderers, useLaggedLightingHistory, history.has_value() && history.value().valid(),
        capturesLaggedLightingHistory, captureHistory.has_value() && captureHistory.value().valid()))
        return;

    FrameGraphTraceGeometryImporter traceGeometryImporter(this.m_deferredLightingTaskGraph, this.m_raytracingSystem, this.m_meshSystem);
    const auto traceGeometryResult = traceGeometryImporter.declare(rayTracingShadowResources);
    if(!traceGeometryResult.has_value())
        return;
    in FrameGraphTraceGeometryResult traceGeometry = traceGeometryResult.value();
    DeferredGraphResourceImportBuilder deferredGraphResourceImportBuilder(this.m_deferredLightingTaskGraph);
    DeferredGraphResourceImportInputs importInputs(deferredTargets, deferredLightingResources, frameBindings, meshViewBufferSnapshot, csgResources, rayTracingGraphResources);
    importInputs.history = history;
    importInputs.captureHistory = captureHistory;
    importInputs.clearAvboitTargets = clearAvboitTargets;
    importInputs.capturesLaggedLightingHistory = capturesLaggedLightingHistory;
    importInputs.hasCsgFrameWork = !csgFrameState.empty();
    auto deferredGraphResources = deferredGraphResourceImportBuilder.declare(importInputs);
    if(!deferredGraphResources.has_value()){
        warning("RendererSystem: could not import deferred-lighting graph resources");
        return;
    }
    in DeferredGraphResourceImportResult graphResources = deferredGraphResources.value();

    const ShadowPrepareGraphContext shadowPrepareContext(this.m_deferredLightingTaskGraph, this.m_graphics, this.m_meshSystem, this.m_raytracingSystem, this.m_shadowPreparePersistentState);
    if(!this.m_shadowPrepareGraph.declareDeferredShadowPrepareTask(shadowPrepareContext, rayTracingShadowResources, rayTracingGraphResources, graphResources.currentBindlessSlots, graphResources.materialContextSlots,
        Span<GpuGraphResourceId>(traceGeometry.traceGeometry), Span<GpuGraphResourceId>(traceGeometry.softwareBvhBuildState), traceGeometry.softwareTraceResourcesPrepared, deferredTargets, shadowPrepareTimingTicket)){
        warning("RendererSystem: could not declare shared shadow-preparation packet");
        return;
    }
    GpuTaskId shadowPrepareHandoffTask = this.m_shadowPrepareGraph.m_deferredShadowPrepareTask;
    if(this.m_shadowPrepareGraph.m_deferredShadowPrepareAccelStructFinalizeTask.valid())
        shadowPrepareHandoffTask = this.m_shadowPrepareGraph.m_deferredShadowPrepareAccelStructFinalizeTask;

    const MeshViewBufferUpload meshViewUpload = this.m_meshSystem.prepareMeshViewBufferUpload(meshViewAspectRatio);
    ReflectionSceneContentStamp reflectionContentStamp;
    reflectionContentStamp.view = s_Fnv64OffsetBasis;
    Fnv64AppendValue(reflectionContentStamp.view, meshViewUpload.viewState);
    ObjectGeometryCacheGraph objectGeometry(this.m_deferredLightingTaskGraph, this.m_materialSystem, this.m_meshSystem);
    const GraphicsPrefixGraphContext graphicsPrefixContext(this.m_graphics, this.m_deferredLightingTaskGraph, this.m_csgSystem, this.m_deferredSystem, this.m_materialSystem, this.m_meshSystem, this.m_raytracingSystem,
        this.m_shadowVisibilityGraph.m_deferredShadowVisibilityTask);
    auto graphicsPrefixResult = this.m_graphicsPrefixGraph.declareDeferredGraphicsPrefixTasks(
        graphicsPrefixContext,
        shadowPrepareHandoffTask,
        csgFrameState,
        frameBindings,
        csgResources,
        hasOpaqueCsgFrameWork,
        meshViewAspectRatio,
        meshViewUpload.viewState,
        meshViewUpload.uploadRequired,
        graphResources,
        Span<GpuGraphResourceId>(traceGeometry.traceGeometry),
        traceGeometry.shadowTraceGeometrySet,
        asyncPrefixTimingSpansOnePacket,
        deferredTargets,
        objectGeometry,
        asyncPrefixTiming,
        deferredClearTiming,
        deferredClearTimingState,
        opaqueCsgIntervalClearTimingState,
        opaqueRegularSharedComputeEmulationTiming,
        opaqueCsgIntervalSampleComputeEmulationTiming,
        graphicsPrefixTimingTickets
    );
    if(!graphicsPrefixResult.has_value()){
        warning("RendererSystem: could not declare deferred graphics-prefix packet");
        return;
    }
    reflectionContentStamp.lighting = graphicsPrefixResult.value();

    if(!this.m_raytracingSystem.prepareCausticOpticalReadTracking(meshViewBufferSnapshot)){
        warning("RendererSystem: could not prepare accepted optical reader tracking");
        return;
    }
    b8 causticOpticalReader = false;
    if(declaresHardwareCaustics)
        causticOpticalReader = this.m_raytracingSystem.hasHwCausticWork(meshViewBufferSnapshot);
    else
        causticOpticalReader = this.m_raytracingSystem.hasCausticWork(meshViewBufferSnapshot);
    const Span<GpuGraphResourceId> causticTraceGeometryResources = SelectFrameTraceGeometry(traceGeometry, declaresHardwareCaustics);
    const GpuGraphResourceSetId causticTraceGeometrySet = SelectFrameTraceGeometrySet(traceGeometry, declaresHardwareCaustics);

    RayTracingShadowVisibilityGraphPlanSnapshot rayTracingShadowVisibilityPlan = this.m_raytracingSystem.snapshotShadowVisibilityGraphPlan(declaresHardwareCaustics);
    if(rayTracingShadowVisibilityPlan.lightSpaceReady() && hasOpaqueCsgFrameWork){
        if(!csgResources.bindingValid() || !frameBindings.meshView.bindingValid()){
            warning("RendererSystem: could not bind the current direct-shadow receiver cap state");
            return;
        }
        mut LightSpaceShadowSnapshot lightSpaceSnapshot = rayTracingShadowVisibilityPlan.lightSpace.deref().snapshot;
        lightSpaceSnapshot.push.csgFlags |= s_CsgShadowFlagCurrentReceiverCaps;
        lightSpaceSnapshot.receiverView = frameBindings.meshView.buffer;
        lightSpaceSnapshot.push.receiverViewSlot = frameBindings.meshView.heapHandle.slot();
        lightSpaceSnapshot.push.receiverCsgSampleStateSlot = csgResources.intervalSampleStateHeapHandle.slot();
        lightSpaceSnapshot.receiverCsgSampleState = csgResources.intervalSampleState;
    }
    const RayTracingSceneGraphResources sceneResources = this.m_raytracingSystem.snapshotSceneGraphResources();
    RayTracingSceneGraphReads sceneReads;
    if(ShouldImportSharedHardwareOpticalSceneReads(rayTracingShadowVisibilityPlan.hardwareTransparentTrace, declaresHardwareCaustics, causticOpticalReader)){
        auto sceneReadsResult = ImportRayTracingSceneGraphReads(sceneResources, this.m_raytracingSystem.sceneTlasBackingInitialState(), this.m_shadowPrepareGraph.m_rayTraceMaterialContextSlotsUploadTask, this.m_deferredLightingTaskGraph);
        if(!sceneReadsResult.has_value()){
            warning("RendererSystem: could not import shared hardware optical scene reads");
            return;
        }
        sceneReads = sceneReadsResult.value();
    }

    GpuGraphResourceId causticOpticalScene;
    if(causticOpticalReader && declaresHardwareCaustics)
        causticOpticalScene = sceneReads.uses[sceneReads.uses.size() - 1u].resource;
    else if(causticOpticalReader){
        const auto optical = ImportRayTracingOpticalSceneBuffer(sceneResources.opticalScene, this.m_shadowPrepareGraph.m_rayTraceMaterialContextSlotsUploadTask, this.m_deferredLightingTaskGraph);
        if(!optical.has_value()){
            warning("RendererSystem: could not import software caustic optical scene reads");
            return;
        }
        causticOpticalScene = optical.value().resource;
    }

    if(useLaggedLightingHistory && !ImportDeferredExternalCompletion(Name(s_FrameGraphNameRenderDeferredLightingLaggedHistoryReadReady), "Lagged Lighting History Read Ready", laggedLightingHistoryReadReadyToken,
        this.m_deferredLightingTaskGraph, this.m_deferredLightingHistoryReadReadyCompletion)){
        warning("RendererSystem: could not import lagged-lighting history read-ready completion");
        return;
    }
    if(features.laggedLightingHistoryWriterWaitPending && !ImportDeferredExternalCompletion(Name(s_FrameGraphNameRenderDeferredLightingLaggedHistoryWriterDrain), "Lagged Lighting History Writer Drain",
        laggedLightingHistoryWriterDrainToken, this.m_deferredLightingTaskGraph, this.m_deferredLightingHistoryWriterDrainCompletion)){
        warning("RendererSystem: could not import lagged-lighting history writer-drain completion");
        return;
    }
    if(this.m_raytracingSystem.hasSurfelWork() && rayTracingSurfelResources.countReadbackSubmissionToken.valid() && !ImportDeferredExternalCompletion(Name(s_FrameGraphNameRenderSurfelGiCounterReadbackComplete),
        "Surfel Counter Readback Complete", surfelCounterReadbackCompletionToken, this.m_deferredLightingTaskGraph, this.m_deferredSurfelGiCounterReadbackCompletion)){
        warning("RendererSystem: could not import surfel counter-readback completion");
        return;
    }

    GpuExternalCompletionId writerDrain;
    if(features.laggedLightingHistoryWriterWaitPending)
        writerDrain = this.m_deferredLightingHistoryWriterDrainCompletion;
    const ShadowVisibilityGraphContext shadowGraphContext(this.m_graphics, this.m_deferredLightingTaskGraph, this.m_raytracingSystem, this.m_shadowComputePersistentState, this.m_shadowVisibilityReturnState,
        this.m_shadowPrepareGraph.m_shadowPreparationOutcome.ready);
    if(!this.m_shadowVisibilityGraph.declareDeferredShadowVisibilityTask(
        shadowGraphContext,
        deferredLightingResources,
        rayTracingShadowResources,
        rayTracingGraphResources,
        rayTracingShadowVisibilityPlan,
        sceneReads,
        declaresHardwareCaustics,
        graphResources.worldPosition,
        graphResources.normal,
        graphResources.depth,
        graphResources.currentShadowVisibility,
        graphResources.currentBindlessSlots,
        graphResources.sceneShading,
        graphResources.lights,
        graphResources.materialContextSlots,
        SelectFrameTraceGeometry(traceGeometry, rayTracingShadowVisibilityPlan.hardwareTransparentTrace),
        SelectFrameTraceGeometrySet(traceGeometry, rayTracingShadowVisibilityPlan.hardwareTransparentTrace),
        traceGeometry.traceMaterialSampledTextureSet,
        this.m_graphicsPrefixGraph.m_graphicsPrefixTask,
        writerDrain,
        deferredTargets,
        shadowVisibilityTimingTicket,
        shadowVisibilityAsyncTiming,
        shadowVisibilityTiming,
        opaqueSoftResolveTiming,
        transparentSoftResolveTiming,
        shadowVisibilityOpaqueProduced,
        shadowVisibilityTransparentTraceProduced,
        shadowVisibilityOpaqueFrameIndex
    ))
        return;
    const CausticsGraphContext causticsGraphContext(
        this.m_meshSystem,
        this.m_raytracingSystem,
        this.m_deferredLightingTaskGraph,
        this.m_causticsComputePersistentState,
        this.m_causticIrradianceReturnState,
        this.m_shadowVisibilityGraph.m_deferredShadowVisibilityTask,
        this.m_shadowPrepareGraph.m_shadowPreparationOutcome.ready
    );
    if(!declaresHardwareCaustics && !this.m_causticsGraph.declareDeferredSoftwareCausticsTask(
        causticsGraphContext,
        declaresHardwareCaustics,
        deferredLightingResources,
        rayTracingGraphResources,
        graphResources.worldPosition,
        graphResources.depth,
        graphResources.currentCausticIrradiance,
        graphResources.currentBindlessSlots,
        graphResources.sceneShading,
        graphResources.lights,
        graphResources.materialContextSlots,
        causticOpticalScene,
        traceGeometry.softwareTraceGeometry,
        traceGeometry.softwareTraceGeometrySet,
        traceGeometry.traceMaterialSampledTextureSet,
        deferredTargets,
        softwareCausticsTimingTicket,
        causticPhotonTiming,
        causticResolveTiming
    ))
        return;
    GpuTaskId effectsTask = this.m_causticsGraph.m_deferredSoftwareCausticsTask;
    if(declaresHardwareCaustics)
        effectsTask = this.m_shadowVisibilityGraph.m_deferredShadowVisibilityTask;
    const SurfelGiGraphContext surfelGraphContext(this.m_deferredLightingTaskGraph, this.m_raytracingSystem, this.m_surfelGiComputePersistentState, this.m_surfelGiCounterPersistentState, this.m_surfelIrradianceReturnState, this.m_deferredFrameTimingEndTask);
    if(!this.m_surfelGiGraph.declareDeferredSurfelGiTask(
        surfelGraphContext,
        deferredLightingResources,
        rayTracingGraphResources,
        rayTracingSurfelResources,
        graphResources.worldPosition,
        graphResources.normal,
        graphResources.currentSurfelIrradiance,
        graphResources.currentBindlessSlots,
        graphResources.sceneShading,
        graphResources.lights,
        graphResources.materialContextSlots,
        SelectFrameTraceGeometry(traceGeometry, rayTracingGraphResources.surfelUsesHardwareTrace),
        SelectFrameTraceGeometrySet(traceGeometry, rayTracingGraphResources.surfelUsesHardwareTrace),
        traceGeometry.traceMaterialSampledTextureSet,
        effectsTask,
        useLaggedLightingHistory,
        this.m_deferredSurfelGiCounterReadbackCompletion,
        deferredTargets,
        surfelGiTimingTicket,
        surfelGiAsyncTiming
    ))
        return;

    if(declaresHardwareCaustics){
        HardwareCausticsStageBuilder hardwareCausticsStageBuilder(this.m_deferredLightingTaskGraph, this.m_raytracingSystem);
        HardwareCausticsStageInputs hardwareInputs(
            deferredTargets,
            deferredLightingResources,
            meshViewBufferSnapshot,
            rayTracingGraphResources,
            features,
            this.m_shadowPrepareGraph.m_shadowPreparationOutcome.ready,
            this.m_deferredLightingHistoryWriterDrainCompletion,
            this.m_hardwareCausticAccumulatorPersistentState,
            this.m_causticsGraph.m_deferredCausticProducerDispatched,
            hardwareCausticsTimingTicket,
            causticPhotonTiming,
            causticResolveTiming
        );
        hardwareInputs.worldPosition = graphResources.worldPosition;
        hardwareInputs.depth = graphResources.depth;
        hardwareInputs.currentCausticIrradiance = graphResources.currentCausticIrradiance;
        hardwareInputs.currentBindlessSlots = graphResources.currentBindlessSlots;
        hardwareInputs.sceneShading = graphResources.sceneShading;
        hardwareInputs.lights = graphResources.lights;
        hardwareInputs.materialContextSlots = graphResources.materialContextSlots;
        hardwareInputs.opticalScene = causticOpticalScene;
        hardwareInputs.hardwareTraceGeometrySet = causticTraceGeometrySet;
        hardwareInputs.hardwareTraceGeometryResources = causticTraceGeometryResources;
        hardwareInputs.traceMaterialSampledTextureSet = traceGeometry.traceMaterialSampledTextureSet;
        hardwareInputs.graphicsPrefixTask = this.m_graphicsPrefixGraph.m_graphicsPrefixTask;
        hardwareInputs.declaresHardwareCaustics = declaresHardwareCaustics;
        auto hardwareCausticsStageResult = hardwareCausticsStageBuilder.declare(hardwareInputs);
        if(!hardwareCausticsStageResult.has_value()){
            warning("RendererSystem: could not declare hardware-caustics stage");
            return;
        }
        this.m_causticsGraph.m_deferredCausticIrradianceClearTask = hardwareCausticsStageResult.value().causticIrradianceClearTask;
        this.m_causticsGraph.m_deferredCausticAccumulatorBootstrapClearTask = hardwareCausticsStageResult.value().causticAccumulatorBootstrapClearTask;
        this.m_causticsGraph.m_deferredCausticAccumulatorDecayTask = hardwareCausticsStageResult.value().causticAccumulatorDecayTask;
        this.m_causticsGraph.m_deferredCausticPhotonTask = hardwareCausticsStageResult.value().causticPhotonTask;
        this.m_causticsGraph.m_deferredCausticGeometryTask = hardwareCausticsStageResult.value().causticGeometryTask;
        this.m_causticsGraph.m_deferredCausticResolvePrepareTask = hardwareCausticsStageResult.value().causticResolvePrepareTask;
        this.m_causticsGraph.m_deferredCausticResolveWaveletTasks = hardwareCausticsStageResult.value().causticResolveWaveletTasks;
        this.m_causticsGraph.m_deferredCausticResolveUpsampleTask = hardwareCausticsStageResult.value().causticResolveUpsampleTask;
        this.m_causticsGraph.m_deferredHardwareCausticsTask = hardwareCausticsStageResult.value().hardwareCausticsTask;
    }

    const b8 refractionActive = IsRefractionStageActive(this.m_preparedRefractionActive, ShouldRequestOpticalCapture(hasTransparentRenderers, this.m_refractionEnabled, this.m_reflectionSettings.traceMode != ReflectionTraceMode::Disabled));
    RayTracingRefractionGraphResources refractionResources = this.m_preparedRefractionResources;
    FrameGraphAvboitStage avboitStage(this.m_deferredLightingTaskGraph, this.m_graphics, this.m_materialSystem, this.m_csgSystem, this.m_avboitSystem, this.m_deferredTaskTimingFeedback);
    FrameGraphAvboitStageInputs avboitInputs(deferredTargets, graphResources, csgFrameState, frameBindings, csgResources, meshViewUpload.viewState);
    avboitInputs.prefixTask = this.m_graphicsPrefixGraph.m_graphicsPrefixTask;
    avboitInputs.hasTransparentRenderers = hasTransparentRenderers;
    avboitInputs.clearTargets = clearAvboitTargets;
    avboitInputs.refractionCaptureEnabled = refractionActive && refractionResources.valid();
    const FrameGraphAvboitStageTiming avboitTiming(
        avboitPreTimingTicket, avboitDepthWarpTimingTicket, avboitExtinctionTimingTicket, avboitIntegrationTimingTicket, avboitAccumulationTimingTicket,
        avboitClearTimingState, transparentCsgIntervalClearTimingState, transparentCsgIntervalsTiming,
        avboitOccupancyComputeEmulationTiming, avboitExtinctionComputeEmulationTiming, avboitAccumulationComputeEmulationTiming
    );
    const auto avboitStageResult = avboitStage.declare(avboitInputs, avboitTiming, objectGeometry);
    if(!avboitStageResult.has_value())
        return;

    DeferredLightingStageBuilder deferredLightingStageBuilder(this.m_deferredLightingTaskGraph, this.m_deferredSystem);
    DeferredLightingStageInputs lightingInputs(deferredTargets);
    lightingInputs.albedo = graphResources.albedo;
    lightingInputs.normal = graphResources.normal;
    lightingInputs.worldPosition = graphResources.worldPosition;
    lightingInputs.depth = graphResources.depth;
    lightingInputs.shadowVisibility = graphResources.shadowVisibility;
    lightingInputs.causticIrradiance = graphResources.causticIrradiance;
    lightingInputs.surfelIrradiance = graphResources.surfelIrradiance;
    lightingInputs.sceneShading = graphResources.sceneShading;
    lightingInputs.lights = graphResources.lights;
    lightingInputs.bindlessSlots = graphResources.bindlessSlots;
    lightingInputs.opaqueColor = graphResources.opaqueColor;
    lightingInputs.graphicsPrefixTask = this.m_graphicsPrefixGraph.m_graphicsPrefixTask;
    lightingInputs.shadowVisibilityTask = this.m_shadowVisibilityGraph.m_deferredShadowVisibilityTask;
    lightingInputs.surfelGiTask = this.m_surfelGiGraph.m_deferredSurfelGiTask;
    lightingInputs.avboitFinalTask = avboitStageResult.value();
    lightingInputs.hardwareCausticsTask = this.m_causticsGraph.m_deferredHardwareCausticsTask;
    lightingInputs.softwareCausticsTask = this.m_causticsGraph.m_deferredSoftwareCausticsTask;
    lightingInputs.historyReadReadyCompletion = this.m_deferredLightingHistoryReadReadyCompletion;
    lightingInputs.useLaggedLightingHistory = useLaggedLightingHistory;
    lightingInputs.declaresHardwareCaustics = declaresHardwareCaustics;
    lightingInputs.hasTransparentRenderers = hasTransparentRenderers;
    lightingInputs.history = history;
    auto deferredLightingStageResult = deferredLightingStageBuilder.declare(lightingInputs, lightingTimingTicket);
    if(!deferredLightingStageResult.has_value()){
        warning("RendererSystem: could not declare deferred-lighting graph task");
        return;
    }
    this.m_deferredLaggedLightingHistorySlotsUploadTask = deferredLightingStageResult.value().historySlotsUploadTask;
    this.m_deferredLightingTask = deferredLightingStageResult.value().lightingTask;

    FrameGraphReflectionResolve reflectionResolve(this.m_deferredLightingTaskGraph, this.m_graphics, this.m_raytracingSystem, this.m_reflectionSystem);
    FrameGraphReflectionResolveInputs reflectionInputs(
        deferredTargets,
        meshViewBufferSnapshot,
        sceneResources,
        this.m_reflectionSettings,
        reflectionContentStamp,
        csgFrameState,
        this.m_shadowPrepareGraph.m_shadowPreparationOutcome.ready,
        this.m_reflectionHardwareLogged,
        this.m_reflectionFallbackLogged
    );
    reflectionInputs.reflectionFrameIndex = this.m_reflectionFrameIndex;
    reflectionInputs.reflectionSceneAvailable = this.m_preparedReflectionSceneAvailable;
    reflectionInputs.useLaggedLightingHistory = useLaggedLightingHistory;
    reflectionInputs.specularRoughness = graphResources.specularRoughness;
    reflectionInputs.refractionSpecularRoughness = graphResources.refractionSpecularRoughness;
    reflectionInputs.normal = graphResources.normal;
    reflectionInputs.depth = graphResources.depth;
    reflectionInputs.worldPosition = graphResources.worldPosition;
    reflectionInputs.refractionDepth = graphResources.refractionDepth;
    reflectionInputs.refractionNormalIor = graphResources.refractionNormalIor;
    reflectionInputs.opaqueColor = graphResources.opaqueColor;
    reflectionInputs.meshView = graphResources.meshView;
    reflectionInputs.currentBindlessSlots = graphResources.currentBindlessSlots;
    reflectionInputs.sceneShading = graphResources.sceneShading;
    reflectionInputs.lights = graphResources.lights;
    reflectionInputs.hardwareTraceGeometrySet = traceGeometry.hardwareTraceGeometrySet;
    reflectionInputs.traceMaterialSampledTextureSet = traceGeometry.traceMaterialSampledTextureSet;
    reflectionInputs.traceContextUploadTask = this.m_shadowPrepareGraph.m_rayTraceMaterialContextSlotsUploadTask;
    reflectionInputs.lightingTask = this.m_deferredLightingTask;
    auto reflectionResolveResult = reflectionResolve.declare(reflectionInputs, sceneReads);
    if(!reflectionResolveResult.has_value()){
        warning("RendererSystem: could not declare reflection graph tasks");
        return;
    }
    refractionResources.opaqueReflectionSlot = reflectionResolveResult.value().reflectionCompositeInputs.opaqueRadianceSlot;

    FrameGraphRefractionResolve refractionResolveBuilder(this.m_deferredLightingTaskGraph, this.m_graphics, this.m_raytracingSystem);
    FrameGraphRefractionResolveInputs refractionInputs(deferredTargets, sceneResources, refractionResources, this.m_shadowPrepareGraph.m_shadowPreparationOutcome.ready, this.m_refractionHardwareLogged, this.m_refractionScreenLogged);
    refractionInputs.refractionActive = refractionActive;
    refractionInputs.depth = graphResources.depth;
    refractionInputs.worldPosition = graphResources.worldPosition;
    refractionInputs.refractionDepth = graphResources.refractionDepth;
    refractionInputs.refractionNormalIor = graphResources.refractionNormalIor;
    refractionInputs.refractionTintCoverage = graphResources.refractionTintCoverage;
    refractionInputs.refractionInstance = graphResources.refractionInstance;
    refractionInputs.refractionResolve = graphResources.refractionResolve;
    refractionInputs.opaqueColor = graphResources.opaqueColor;
    refractionInputs.opaqueReflectionRadiance = reflectionResolveResult.value().reflectionGraph.opaqueRadiance;
    refractionInputs.meshView = graphResources.meshView;
    refractionInputs.currentBindlessSlots = graphResources.currentBindlessSlots;
    refractionInputs.sceneShading = graphResources.sceneShading;
    refractionInputs.lights = graphResources.lights;
    refractionInputs.avboitAccumColor = graphResources.avboitAccumColor;
    refractionInputs.avboitAccumExtinction = graphResources.avboitAccumExtinction;
    refractionInputs.avboitForegroundColor = graphResources.avboitForegroundColor;
    refractionInputs.avboitForegroundExtinction = graphResources.avboitForegroundExtinction;
    refractionInputs.hardwareTraceGeometrySet = traceGeometry.hardwareTraceGeometrySet;
    refractionInputs.traceMaterialSampledTextureSet = traceGeometry.traceMaterialSampledTextureSet;
    refractionInputs.traceContextUploadTask = this.m_shadowPrepareGraph.m_rayTraceMaterialContextSlotsUploadTask;
    refractionInputs.reflectionCompletionTask = reflectionResolveResult.value().reflectionGraph.completion;
    refractionInputs.avboitFinalTask = avboitStageResult.value();
    refractionInputs.surfelGiTask = this.m_surfelGiGraph.m_deferredSurfelGiTask;
    auto refractionResolveResult = refractionResolveBuilder.declare(refractionInputs, sceneReads);
    if(!refractionResolveResult.has_value()){
        warning("RendererSystem: could not declare refraction resolve graph tasks");
        return;
    }

    DeferredGraphSuffixBuilder suffixBuilder(this.m_deferredLightingTaskGraph, this.m_deferredSystem, this.m_graphics, this.m_preparedTaskGraphPresentationContributor, this.m_preparedTaskGraphOutputLayerContributor);
    DeferredGraphSuffixInputs suffixInputs(deferredTargets, presentationFrame, presentationFramebufferDesc);
    suffixInputs.opaqueColor = graphResources.opaqueColor;
    suffixInputs.avboitAccumColor = graphResources.avboitAccumColor;
    suffixInputs.avboitAccumExtinction = graphResources.avboitAccumExtinction;
    suffixInputs.avboitForegroundColor = graphResources.avboitForegroundColor;
    suffixInputs.avboitForegroundExtinction = graphResources.avboitForegroundExtinction;
    suffixInputs.refractionResolve = graphResources.refractionResolve;
    suffixInputs.refractionDepth = graphResources.refractionDepth;
    suffixInputs.currentBindlessSlots = graphResources.currentBindlessSlots;
    suffixInputs.reflectionGraph = reflectionResolveResult.value().reflectionGraph;
    suffixInputs.reflectionCompositeInputs = reflectionResolveResult.value().reflectionCompositeInputs;
    suffixInputs.useLaggedLightingHistory = useLaggedLightingHistory;
    suffixInputs.lightingTask = this.m_deferredLightingTask;
    suffixInputs.avboitFinalTask = avboitStageResult.value();
    suffixInputs.refractionResolveTask = refractionResolveResult.value();
    suffixInputs.surfelGiTask = this.m_surfelGiGraph.m_deferredSurfelGiTask;
    if(declaresHardwareCaustics)
        suffixInputs.hardwareCausticsTask = this.m_causticsGraph.m_deferredHardwareCausticsTask;
    auto suffixResult = suffixBuilder.declare(suffixInputs, this.m_shadowVisibilityGraph.m_deferredShadowVisibilityTask, compositeTimingTicket,
        presentTimingTicket, asyncFinalTiming, frameTimingTransaction);
    if(!suffixResult.has_value())
        return;
    this.m_deferredCompositeTask = suffixResult.value().compositeTask;
    this.m_deferredPresentationOverlayRequired = suffixResult.value().overlayRequired;
    this.m_deferredPresentationOverlayTask = suffixResult.value().overlayTask;
    this.m_deferredPresentTask = suffixResult.value().presentTask;
    this.m_deferredFrameTimingEndTask = suffixResult.value().frameTimingEndTask;

    this.m_surfelGiGraph.declareDeferredSurfelCountReadbackTask(surfelGraphContext, rayTracingSurfelResources);

    DeferredFrameTailBuilder deferredFrameTailBuilder(this.m_deferredLightingTaskGraph);
    DeferredFrameTailInputs tailInputs(frameTimingTransaction, this.m_laggedLightingHistorySubmissionToken, this.m_deferredFrameRecoveryArmed, this.m_deferredFrameRecoveryRetiresTiming);
    tailInputs.terminalPresentationTask = this.m_deferredFrameTimingEndTask;
    tailInputs.historyCopyShadowVisibility = graphResources.historyCopyShadowVisibility;
    tailInputs.historyCopyCausticIrradiance = graphResources.historyCopyCausticIrradiance;
    tailInputs.historyCopySurfelIrradiance = graphResources.historyCopySurfelIrradiance;
    tailInputs.historyCopyDestinationShadowVisibility = graphResources.historyCopyDestinationShadowVisibility;
    tailInputs.historyCopyDestinationCausticIrradiance = graphResources.historyCopyDestinationCausticIrradiance;
    tailInputs.historyCopyDestinationSurfelIrradiance = graphResources.historyCopyDestinationSurfelIrradiance;
    tailInputs.capturesLaggedLightingHistory = capturesLaggedLightingHistory;
    auto deferredFrameTailResult = deferredFrameTailBuilder.declare(tailInputs);
    if(!deferredFrameTailResult.has_value())
        return;
    this.m_deferredLaggedLightingHistoryTask = deferredFrameTailResult.value().historyCopyTask;
    this.m_deferredFrameRecoveryTask = deferredFrameTailResult.value().recoveryTask;

    this.m_deferredLightingTaskGraphDeclarationSeconds = DurationInSeconds<f64>(TimerNow(), declarationBegin);
    this.m_deferredLightingTaskGraphDeclared = true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

