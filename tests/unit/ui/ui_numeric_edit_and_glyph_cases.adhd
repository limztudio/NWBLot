void VerifyUiNumericEditLoanTests_ClosedAncestorSuppressesNumericPublicationAndHiddenSources(mut UiNumericEditLoanTests self){
    self.useHost();
    UiNumericEditLoanMutationSource source = UiNumericEditLoanMutationSource();
    ListState list = ListState();
    self.m_parent.open();
    self.m_child.open();
