void VerifyUiTextRegionTests_SelectableCentersWithinAsymmetricVerticalPaddingInsteadOfTheWholeRow(mut UiTextRegionTests self){
    const StringView text = "MMMMMMMMMMMMMMMM";
    self.m_builder.listStyle().row.padding = Insets(7.0f, 11.0f, 13.0f, 3.0f);
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPanel(s_UiTextRegionPanelKey, Rect(10.0f, 20.0f, 220.0f, 130.0f)));
    WidgetOptions options = WidgetOptions();
    options.width = LayoutSize(LayoutSizePolicy::Fixed, 90.0f);
    options.height = LayoutSize(LayoutSizePolicy::Fixed, 70.0f);
    EXPECT_FALSE(self.m_builder.selectable("selectable", text, false, options));
    ASSERT_TRUE(self.finishPanel());
    const DrawSnapshot actual = self.m_paint.freeze();
    const Rect content = Rect(20.0f, 35.0f, 70.0f, 54.0f);
    ExpectUiTextGlyphRegion(actual, content);
    auto layout = self.m_text.layout(MakeUiTextRegionShapeRequest(text, self.m_builder.style().fontSize));
    ASSERT_TRUE(layout.has_value());
    const DisplayMetrics display = DisplayMetrics(800.0f, 600.0f, 1.0f, 1.0f);
    const auto measured = self.m_text.measure(layout.value(), display);
    ASSERT_TRUE(measured.has_value());
    ASSERT_LT(measured.value().height, content.height);
    PaintBuilder reference = PaintBuilder(self.m_arena);
    reference.begin(display, 2u, 1u, MakeUiSkinAssetRef(s_TestSkinPath), self.m_skin);
    reference.pushClip(content);
    const f32 centeredY = (content.height - measured.value().height) * 0.5f + content.y;
    const Point origin = Point(content.x - measured.value().x, centeredY - measured.value().y);
    ASSERT_TRUE(self.m_text.paint(reference, layout.value(), origin, self.m_builder.style().text));
    ASSERT_TRUE(reference.popClip());
    const DrawSnapshot expected = reference.freeze();
    Vector<Vertex> actualGlyphs = Vector<Vertex>();
    Vector<Vertex> expectedGlyphs = Vector<Vertex>();
    CopyGlyphVertices(actual, actualGlyphs);
    CopyGlyphVertices(expected, expectedGlyphs);
    ASSERT_EQ(actualGlyphs.size(), expectedGlyphs.size());
    ASSERT_GT(actualGlyphs.size(), 0u);
    for(usize index = 0u; index < actualGlyphs.size(); ++index){
        EXPECT_FLOAT_EQ(actualGlyphs[index].position.x, expectedGlyphs[index].position.x);
        EXPECT_FLOAT_EQ(actualGlyphs[index].position.y, expectedGlyphs[index].position.y);
        EXPECT_FLOAT_EQ(actualGlyphs[index].texCoord.x, expectedGlyphs[index].texCoord.x);
        EXPECT_FLOAT_EQ(actualGlyphs[index].texCoord.y, expectedGlyphs[index].texCoord.y);
    }
}

void VerifyUiTextRegionTests_WindowTitleInkKeepsPaddingAndCollapseReservationWhenViewportShrinks(mut UiTextRegionTests self){
    self.m_builder.style().fontSize = 24.0f;
    u64 generation = 1u;
    Array<b8, 2u> collapsibleModes;
    collapsibleModes[0u] = false;
    collapsibleModes[1u] = true;
    Array<f32, 2u> widths;
    widths[0u] = 800.0f;
    widths[1u] = 100.0f;
    for(usize modeIndex = 0u; modeIndex < collapsibleModes.size(); ++modeIndex){
        const b8 collapsible = collapsibleModes[modeIndex];
        WindowState state = WindowState();
        WindowOptions options = WindowOptions();
        options.initialBounds = Rect(10.0f, 15.0f, 75.0f, 100.0f);
        options.minimumSize = Point(0.0f, 0.0f);
        options.collapsible = collapsible;
        options.resizable = false;
        for(usize widthIndex = 0u; widthIndex < widths.size(); ++widthIndex){
            const f32 width = widths[widthIndex];
            f32 scale = 2.0f;
            if(width == 800.0f)
                scale = 1.0f;
            ASSERT_TRUE(self.begin(generation, DisplayMetrics(width, 200.0f, scale, scale)));
            ASSERT_TRUE(self.m_builder.beginWindow("window", "jjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjj", state, options));
            ASSERT_TRUE(self.finishWindow());
            EXPECT_FALSE(self.m_paint.popClip());
            const DrawSnapshot snapshot = self.m_paint.freeze();
            ASSERT_TRUE(self.m_context.commitFrame(generation));
            ++generation;
            const auto foundTitle = self.tryTarget(self.id("@window.title"));
            ASSERT_TRUE(foundTitle.has_value());
            const HitTarget title = foundTitle.value();
            const Rect header = title.rectangle;
            const f32 titleStart = header.x + 5.0f;
            f32 collapseOffset = 0.0f;
            if(collapsible)
                collapseOffset = 28.0f;
            const f32 left = titleStart + collapseOffset;
            const f32 right = Min(width, header.x + header.width - 7.0f);
            const f32 inkTop = header.y + 6.0f;
            const f32 inkHeight = header.height - 14.0f;
            ExpectUiTextGlyphRegion(snapshot, Rect(left, inkTop, right - left, inkHeight));
            const Name windowTitleName = Name(s_UiCaseWindowTitle);
            const auto skin = self.sampleSkinPaint(snapshot, windowTitleName);
            ASSERT_TRUE(skin.has_value());
            ExpectUiRect(skin.value().bounds, title.clip);
            if(collapsible){
                const auto foundCollapse = self.tryTarget(self.id("@window.collapse"));
                ASSERT_TRUE(foundCollapse.has_value());
                const HitTarget collapse = foundCollapse.value();
                EXPECT_FLOAT_EQ(collapse.rectangle.x, titleStart);
                EXPECT_FLOAT_EQ(collapse.rectangle.width, 20.0f);
                EXPECT_LE(collapse.rectangle.x + collapse.rectangle.width, left);
            }
        }
        EXPECT_TRUE(state.initialized);
    }
}

