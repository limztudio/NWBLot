    self.m_parent.open();
    self.m_child.open();
    sibling.open();
    ASSERT_TRUE(self.beginParent(1u));
    ASSERT_TRUE(self.m_builder.beginPopup("child", self.m_child, MakeLargeLoanChildPopupOptions()));
    ASSERT_TRUE(self.m_builder.floatEdit(s_UiNumericEditDecimalKey, self.m_float, self.m_floatState).edit.valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    ASSERT_TRUE(self.m_builder.beginPopup("sibling", sibling, MakeLargeLoanChildPopupOptions()));
    ASSERT_TRUE(self.m_builder.virtualList("list", source, list, MakeLargeLoanListOptions()).valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    source.armTextDraft(self.m_float.lendDraft());
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_TRUE(source.mutationApplied);
    EXPECT_EQ(self.m_host.publishes, 1u);
    EXPECT_DOUBLE_EQ(self.m_float.value(), 1.25);
    EXPECT_EQ(self.m_float.draft().anchor(), 4u);
    EXPECT_EQ(self.m_float.draft().caret(), 4u);
}

void VerifyUiNumericSelectionEpochTests_FinalSourceValidationRejectsTheParentSelectionRoundTripAfterChildPaint(mut UiNumericSelectionEpochTests self){
    self.useHost();
    ASSERT_TRUE(self.m_integer.setValue(42));
    UiNumericSelectionEpochSource parentSource = UiNumericSelectionEpochSource();
    UiNumericSelectionEpochSource childSource = UiNumericSelectionEpochSource();
    ListState parentList = ListState();
    ListState childList = ListState();
    self.m_parent.open();
    self.m_child.open();
    ASSERT_TRUE(self.beginParent(1u));
    ASSERT_TRUE(self.m_builder.integerEdit(s_UiNumericEditIntegerKey, self.m_integer, self.m_integerState).edit.valid);
    ASSERT_TRUE(self.m_builder.virtualList("list", parentSource, parentList, MakeLargeLoanListOptions()).valid);
    ASSERT_TRUE(self.m_builder.beginPopup("child", self.m_child, MakeLargeLoanChildPopupOptions()));
    ASSERT_TRUE(self.m_builder.virtualList("list", childSource, childList, MakeLargeLoanListOptions()).valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    childSource.armRevisionOnSource(parentSource, self.m_integer.lendDraft());
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_TRUE(parentSource.mutationApplied);
    EXPECT_EQ(self.m_host.publishes, 1u);
    EXPECT_GT(childSource.textCalls, 0u);
    EXPECT_EQ(self.m_integer.value(), 42);
    EXPECT_EQ(self.m_integer.draft().anchor(), 2u);
    EXPECT_EQ(self.m_integer.draft().caret(), 2u);
}


