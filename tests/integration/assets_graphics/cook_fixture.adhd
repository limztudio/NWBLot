[[nodiscard]] FOUNDATION_INLINE Expected<Impl::RendererComponent> LoadCookedRendererComponentImpl(TestArena& testArena, const Path& outputDirectory, const Name& virtualPath, const usize expectedVolumeFileCount){
    const auto loadedAsset = LoadCookedAsset<NWB::Impl::ComponentAssetCodec>(outputDirectory, virtualPath, expectedVolumeFileCount, testArena);
    if(!loadedAsset || loadedAsset->get() == nullptr)
        return MakeUnexpected(Failure{});
    EXPECT_EQ((*loadedAsset)->assetType(), NWB::Impl::RendererComponentAsset::AssetTypeName());
    if((*loadedAsset)->assetType() != NWB::Impl::RendererComponentAsset::AssetTypeName())
        return MakeUnexpected(Failure{});
    return static_cast<const NWB::Impl::RendererComponentAsset*>(loadedAsset->get())->component;
}

FOUNDATION_INLINE void InsertEvaluatorDefineImpl(TestArena& testArena, NWB::Impl::ShaderCook::CookMap<NWB::Impl::ShaderCook::CookString, NWB::Impl::ShaderCook::DefineEntry>& defines, const AStringView name, const InitializerList<AStringView> values){
    NWB::Impl::ShaderCook::DefineEntry definition(testArena.arena);
    for(const AStringView value : values)
        definition.values.emplace_back(value, testArena.arena);
    ASSERT_TRUE(defines.emplace(NWB::Impl::ShaderCook::CookString(name, testArena.arena), Move(definition)).second);
}

FOUNDATION_INLINE void InsertEvaluatorIncludeMetadataImpl(TestArena& testArena, const Path& path, const AStringView option, const InitializerList<AStringView> values, const AStringView authoredDefine, IncludeMetadataMap& includeMetadata){
    NWB::Impl::ShaderCook::IncludeEntry entry(testArena.arena);
    InsertEvaluatorDefineImpl(testArena, entry.defineValues, option, values);
    InsertEvaluatorDefineImpl(testArena, entry.defineValues, authoredDefine, { "inherited" });
    auto key = PathToString(testArena.arena, path);
#if defined(FOUNDATION_PLATFORM_WINDOWS)
    CanonicalizeTextInPlace(key);
#endif
    ASSERT_TRUE(includeMetadata.emplace(Move(key), Move(entry)).second);
}

FOUNDATION_INLINE void InsertEvaluatorIncludeMetadata1Impl(TestArena& testArena, const Path& path, const AStringView option, const AStringView val0, const AStringView authoredDefine, IncludeMetadataMap& includeMetadata){
    InsertEvaluatorIncludeMetadataImpl(testArena, path, option, { val0 }, authoredDefine, includeMetadata);
}

FOUNDATION_INLINE void InsertEvaluatorIncludeMetadata2Impl(TestArena& testArena, const Path& path, const AStringView option, const AStringView val0, const AStringView val1, const AStringView authoredDefine, IncludeMetadataMap& includeMetadata){
    InsertEvaluatorIncludeMetadataImpl(testArena, path, option, { val0, val1 }, authoredDefine, includeMetadata);
}

[[nodiscard]] FOUNDATION_INLINE Expected<PreparedShaderPlan> PrepareEvaluatorShaderPlanImpl(
    TestArena& testArena,
    ScratchArena& scratchArena,
    const ResolvedCookPaths& paths,
    const Path& bindRoot,
    const Path& csgRoot,
    const IncludeMetadataMap& includeMetadata,
    const AStringView authoredDefine,
    const u32 mode
){
    namespace Plan = Impl::AssetsGraphicsCookDetail;
    using ShaderCook = Impl::ShaderCook;
    ShaderCook::CookVector<Impl::MaterialBindEntry> materialBinds(testArena.arena);
    ShaderCook::CookVector<Impl::MaterialCookEntry> materials(testArena.arena);
    Plan::ShaderEntryVector entries(testArena.arena);
    ShaderCook::ShaderEntry entry(testArena.arena);
    entry.name = "project/shaders/dependency_plan";
    entry.source = "shader.slang";
    entry.stage = s_ShaderStagePs;
    entry.archiveStage = s_ShaderStagePs;
    InsertEvaluatorDefineImpl(testArena, entry.defineValues, authoredDefine, { "authored" });
    if(mode == 1u)
        InsertEvaluatorDefineImpl(testArena, entry.defineValues, Impl::s_CsgProjectEvaluatorModuleDefineName, { "\"../common.slangi\"" });
    else if(mode == 2u)
        InsertEvaluatorDefineImpl(testArena, entry.defineValues, Impl::s_CsgProjectEvaluatorModuleDefineName, { "\"first.slangi\"", "\"second.slangi\"" });
    entries.push_back(Move(entry));
    const Path emptyPath(testArena.arena);
    return Plan::PrepareShaderEntriesForCook(paths, bindRoot, csgRoot, emptyPath, emptyPath, includeMetadata, materialBinds, materials, testArena.arena, scratchArena, entries);
}

