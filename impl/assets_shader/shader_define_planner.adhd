b8 ShouldReserveMergedShaderDefines(in b8 canReserve, in usize reserveCount, in usize existingCount){
    return canReserve && reserveCount > existingCount;
}

b8 ValidateDerivedShaderStageText(in StringView nwbFilePathText, in StringView stageText){
    if(!stageText.empty())
        return true;

    error("Shader meta '{}': failed to derive shader stage", nwbFilePathText);
    return false;
}

b8 ValidateNonEmptyShaderEntryPoint(in StringView nwbFilePathText, in StringView entryPoint){
    if(!entryPoint.empty())
        return true;

    error("Shader meta '{}': entry_point must not be empty", nwbFilePathText);
    return false;
}

b8 IsIncludeShaderAssetType(in StringView assetTypeText, in StringView expectedIncludeAssetType){
    return assetTypeText == expectedIncludeAssetType;
}


