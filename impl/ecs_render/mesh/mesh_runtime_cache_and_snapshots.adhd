////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RequiresShadowSoftwareBvhBuild(in b8 rtSupported){
    return !rtSupported;
}

b8 RuntimeMeshSourceDimensionsMatch(
    in u64 meshVersion,
    in u64 descVersion,
    in u32 meshletCount,
    in u32 descMeshletCount,
    in u32 primitiveIndexCount,
    in u32 descPrimitiveIndexCount
){
    return meshVersion == descVersion && meshletCount == descMeshletCount && primitiveIndexCount == descPrimitiveIndexCount;
}

b8 ValidateRawBufferLogicalByteCount(
    in BufferHandle buffer,
    in u32 logicalByteCount,
    in Name meshName,
    in StringView label
){
    if(!buffer.valid())
        return ValidateMeshRawBufferLogicalByteCount(false, 0u, 0u, logicalByteCount, meshName, label);
    const BufferDesc desc = buffer.deref().getCreationDescription();
    return ValidateMeshRawBufferLogicalByteCount(true, desc.structStride, desc.byteSize, logicalByteCount, meshName, label);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CreateUploadedMeshBuffer(
    mut GraphicsRuntime graphics,
    in Name meshName,
    in StringView suffix,
    in StringView label,
    in BufferFlags flags,
    in Func<64u, Expected<BufferHandle, BufferSetupFailure>(mut GraphicsRuntime, in Name, in BufferFlags)> createBuffer,
    mut BufferHandle destination
){
    const auto bufferName = DeriveMeshBufferName(meshName, suffix, label);
    if(!bufferName.has_value())
        return false;
    const auto result = createBuffer(graphics, bufferName.value(), flags);
    if(!result.has_value()){
        ReportMeshBufferSetupFailure(result.error(), meshName, label);
        return false;
    }
    destination = result.value();
    return true;
}

b8 UploadMeshStream<T>(mut GraphicsRuntime graphics, in Name meshName, in StringView suffix, in Span<T> payload, in StringView label, mut BufferHandle destination, in b8 rawViews, in b8 buildInput){
    const Span<T> payloadRef = payload;
    const BufferFlags flags(false, rawViews, buildInput, ResourceQueueSharing::GraphicsAndAsyncCompute, false);
    return CreateUploadedMeshBuffer(
        graphics,
        meshName,
        suffix,
        label,
        flags,
        lambda[in payloadRef](mut GraphicsRuntime targetGraphics, in Name bufferName, in BufferFlags bufferFlags) -> Expected<BufferHandle, BufferSetupFailure>{
            return SetupRequiredBuffer<T>(targetGraphics, bufferName, payloadRef, bufferFlags);
        },
        destination
    );
}

b8 UploadMeshBytes(mut GraphicsRuntime graphics, in Name meshName, in StringView suffix, in Span<u8> payload, in StringView label, mut BufferHandle destination){
    const Span<u8> payloadRef = payload;
    const BufferFlags flags(false, true, false, ResourceQueueSharing::GraphicsAndAsyncCompute, false);
    return CreateUploadedMeshBuffer(
        graphics,
        meshName,
        suffix,
        label,
        flags,
        lambda[in payloadRef](mut GraphicsRuntime targetGraphics, in Name bufferName, in BufferFlags bufferFlags) -> Expected<BufferHandle, BufferSetupFailure>{
            return SetupRequiredPaddedRawByteBuffer(targetGraphics, bufferName, payloadRef, bufferFlags);
        },
        destination
    );
}

b8 RuntimeMeshSourceMatches(in MeshResources mesh, in RuntimeMeshDesc desc){
    return
        RuntimeMeshSourceDimensionsMatch(mesh.runtimeMeshVersion, desc.version, mesh.meshletCount, desc.meshletCount, mesh.meshletPrimitiveIndexCount, desc.meshletPrimitiveIndexCount)
        && mesh.buffers.sameBuffers(desc.buffers)
        && mesh.triangleIndexBuffer == desc.triangleIndexBuffer
        && mesh.attributeBuffer == desc.attributeBuffer
        && mesh.runtimeLocalBoundsBuffer == desc.localBoundsBuffer
        && mesh.runtimeMeshletLocalBoundsBuffer == desc.meshletLocalBoundsBuffer
    ;
}

void RefreshRuntimeMeshContent(mut MeshResources mesh, in RuntimeMeshDesc desc){
    mesh.runtimeGeometryContentRevision = desc.geometryContentRevision;
    mesh.dynamicMeshletBoundsFresh = desc.dynamicMeshletBoundsFresh;
    mesh.dynamicMeshletConesFresh = desc.dynamicMeshletConesFresh;
    RefreshRuntimeMeshCsgBounds(VectorSingle(desc.localBounds.minBounds), VectorSingle(desc.localBounds.maxBounds), desc.localBounds.finite(), mesh.csgLocalBounds);
}

Expected<mut MeshResources> RendererMeshSystem::createMeshResources(in AssetRef<Mesh> meshAsset){
    const Name meshPath = meshAsset.name();
    if(meshPath == s_NameNone){
        error("RendererSystem: renderer mesh is empty");
        return MakeUnexpected(Failure());
    }

    const auto foundMesh = this.m_meshState.m_meshes.find(meshPath);
    if(foundMesh != this.m_meshState.m_meshes.end()){
        assert(this.meshRenderBindingsReady(foundMesh.value()));
        assert(foundMesh.value().valid());
        mut MeshResources stored = this.m_meshState.m_meshes.at(meshPath);
        return Expected<mut MeshResources>(stored);
    }

    auto loadedAsset = LoadTypedAssetSync<Mesh>(this.m_assetManager, meshPath, s_RendererAssetOwnerName);
    if(!loadedAsset.has_value())
        return MakeUnexpected(Failure());

    in Mesh mesh = loadedAsset.value().deref();
    assert(mesh.validatePayload());
    assert(mesh.meshlets().size() <= cast<usize>(u32.max));
    assert(mesh.meshletPrimitiveIndices().size() <= cast<usize>(u32.max));

    MeshResources createdMesh = this.emptyMesh();
    createdMesh.meshName = meshPath;
    createdMesh.meshletCount = cast<u32>(mesh.meshlets().size());
    createdMesh.meshletPrimitiveIndexCount = cast<u32>(mesh.meshletPrimitiveIndices().size());
    if(!TryCopyVector<u32>(createdMesh.solidTriangleWords, Span<u32>(mesh.solidTriangleWords())))
        return MakeUnexpected(Failure());
    const Expected<CsgReceiverCpuBounds> csgLocalBounds = BuildPositionStreamBounds(mesh.positionStream());
    if(!csgLocalBounds.has_value()){
        error("RendererSystem: mesh '{}' has invalid CSG receiver bounds", meshPath.resolvedText());
        return MakeUnexpected(Failure());
    }
    createdMesh.csgLocalBounds = csgLocalBounds.value();

    const b8 rtSupported = this.m_graphics.queryFeatureSupport(Feature::RayTracingAccelStruct);
    const b8 swShadow = RequiresShadowSoftwareBvhBuild(rtSupported);

    b8 uploaded = true;
    uploaded = UploadMeshStream<f32x3u>(this.m_graphics, meshPath, s_PositionsBufferName, mesh.positionStream(), s_MeshPositionBufferLabel, createdMesh.buffers.positionBuffer, true, rtSupported) && uploaded;
    uploaded = UploadMeshStream<f16x4u>(this.m_graphics, meshPath, s_NormalsBufferName, mesh.normalStream(), s_MeshNormalBufferLabel, createdMesh.buffers.normalBuffer, false, false) && uploaded;
    uploaded = UploadMeshStream<f16x4u>(this.m_graphics, meshPath, s_TangentsBufferName, mesh.tangentStream(), s_MeshTangentBufferLabel, createdMesh.buffers.tangentBuffer, false, false) && uploaded;
    uploaded = UploadMeshStream<f32x2u>(this.m_graphics, meshPath, s_Uv0BufferName, mesh.uv0Stream(), s_MeshUv0BufferLabel, createdMesh.buffers.uv0Buffer, false, false) && uploaded;
    uploaded = UploadMeshStream<f16x4u>(this.m_graphics, meshPath, s_ColorsBufferName, mesh.colorStream(), s_MeshColorBufferLabel, createdMesh.buffers.colorBuffer, false, false) && uploaded;
    uploaded = UploadMeshStream<MeshletDesc>(this.m_graphics, meshPath, s_MeshletsBufferName, mesh.meshlets(), s_MeshletDescriptorBufferLabel, createdMesh.buffers.meshletDescBuffer, false, false) && uploaded;
    uploaded = UploadMeshStream<MeshletBounds>(this.m_graphics, meshPath, s_MeshletBoundsBufferName, mesh.meshletBounds(), s_MeshletBoundsBufferLabel, createdMesh.buffers.meshletBoundsBuffer, true, false) && uploaded;
    uploaded = UploadMeshBytes(this.m_graphics, meshPath, s_MeshletPositionRefDeltasBufferName, mesh.meshletPositionRefDeltas(), s_MeshletPositionRefDeltaBufferLabel, createdMesh.buffers.meshletPositionRefDeltaBuffer) && uploaded;
    uploaded = UploadMeshBytes(this.m_graphics, meshPath, s_MeshletAttributeRefDeltasBufferName, mesh.meshletAttributeRefDeltas(), s_MeshletAttributeRefDeltaBufferLabel, createdMesh.buffers.meshletAttributeRefDeltaBuffer) && uploaded;
    uploaded = UploadMeshStream<MeshletLocalVertexRef>(this.m_graphics, meshPath, s_MeshletLocalVertexRefsBufferName, mesh.meshletLocalVertexRefs(), s_MeshletLocalVertexRefBufferLabel, createdMesh.buffers.meshletLocalVertexRefBuffer, false, false) && uploaded;
    uploaded = UploadMeshBytes(this.m_graphics, meshPath, s_MeshletPrimitiveIndicesBufferName, mesh.meshletPrimitiveIndices(), s_MeshletPrimitiveIndexBufferLabel, createdMesh.buffers.meshletPrimitiveIndexBuffer) && uploaded;
    if(!uploaded)
        return MakeUnexpected(Failure());

    {
        const auto triangleIndices = BuildMeshletTriangleIndices(mesh);
        if(!triangleIndices.has_value()){
            error("RendererSystem: failed to reconstruct shadow trace triangle indices for mesh '{}'", meshPath.resolvedText());
            return MakeUnexpected(Failure());
        }

        const auto indexBufferName = DeriveName(meshPath, s_RtTriangleIndicesBufferName);
        if(!indexBufferName.has_value()){
            error("RendererSystem: failed to derive shadow trace index buffer name for mesh '{}'", meshPath.resolvedText());
            return MakeUnexpected(Failure());
        }

        BufferFlags indexFlags;
        indexFlags.canHaveRawViews = true;
        indexFlags.isIndexBuffer = true;
        indexFlags.accelStructBuildInput = rtSupported;
        indexFlags.queueSharing = ResourceQueueSharing::GraphicsAndAsyncCompute;
        auto indexBuffer = SetupRequiredBuffer<u32>(this.m_graphics, indexBufferName.value(), triangleIndices.value(), indexFlags);
        if(!indexBuffer.has_value()){
            error("RendererSystem: failed to create shadow trace index buffer for mesh '{}'", meshPath.resolvedText());
            return MakeUnexpected(Failure());
        }

        createdMesh.triangleIndexBuffer = indexBuffer.value();
        MeshAccelerationStatePolicy().finalizeShadowIndices(meshPath, triangleIndices.value().size(), createdMesh.meshletPrimitiveIndexCount, rtSupported, swShadow, createdMesh.blasBuildPending, createdMesh.swBvhBuildPending);
    }

    {
        const auto triangleAttributes = BuildMeshletTriangleAttributes(mesh);
        if(!triangleAttributes.has_value()){
            error("RendererSystem: failed to reconstruct shadow trace triangle attributes for mesh '{}'", meshPath.resolvedText());
            return MakeUnexpected(Failure());
        }

        const auto attributeBufferName = DeriveName(meshPath, s_RtTriangleAttributesBufferName);
        if(!attributeBufferName.has_value()){
            error("RendererSystem: failed to derive shadow trace attribute buffer name for mesh '{}'", meshPath.resolvedText());
            return MakeUnexpected(Failure());
        }

        BufferFlags attributeFlags;
        attributeFlags.canHaveRawViews = true;
        attributeFlags.queueSharing = ResourceQueueSharing::GraphicsAndAsyncCompute;
        auto attributeBuffer = SetupRequiredBuffer<AttribGpu>(this.m_graphics, attributeBufferName.value(), triangleAttributes.value(), attributeFlags);
        if(!attributeBuffer.has_value()){
            error("RendererSystem: failed to create shadow trace triangle attribute buffer for mesh '{}'", meshPath.resolvedText());
            return MakeUnexpected(Failure());
        }
        createdMesh.attributeBuffer = attributeBuffer.value();
    }

    assert(createdMesh.valid());
    MeshDescriptorTransaction retireUnpublished(this, createdMesh);
    if(!this.createMeshRenderBindings(createdMesh))
        return MakeUnexpected(Failure());

    auto result = TryEmplaceOwned<MeshResources>(this.m_meshState.m_meshes, meshPath, createdMesh);
    if(result)
        retireUnpublished.release();

    mut MeshResources stored = this.m_meshState.m_meshes.at(meshPath);
    assert(stored.valid());
    return Expected<mut MeshResources>(stored);
}

Expected<mut MeshResources> RendererMeshSystem::findMeshResources(in Name meshKey){
    if(meshKey == s_NameNone)
        return MakeUnexpected(Failure());

    const auto foundMesh = this.m_meshState.m_meshes.find(meshKey);
    if(foundMesh == this.m_meshState.m_meshes.end())
        return MakeUnexpected(Failure());

    mut MeshResources stored = this.m_meshState.m_meshes.at(meshKey);
    assert(this.meshRenderBindingsReady(stored));
    assert(stored.valid());
    return Expected<mut MeshResources>(stored);
}

Expected<mut MeshResources> RendererMeshSystem::createRuntimeMeshResources(in RuntimeMeshDesc desc){
    assert(desc.valid());

    const auto foundMesh = this.m_meshState.m_meshes.find(desc.meshKey);
    if(foundMesh != this.m_meshState.m_meshes.end()){
        if(!foundMesh.value().runtimeMesh){
            error("RendererSystem: runtime mesh '{}' collides with a static mesh resource", desc.meshKey.resolvedText());
            return MakeUnexpected(Failure());
        }
        if(!RuntimeMeshSourceMatches(foundMesh.value(), desc)){
            this.releaseMeshGeometryHeapHandles(foundMesh.value());
            this.m_meshState.m_meshes.erase(foundMesh);
            if(this.m_meshState.m_runtimeMeshCount > 0u)
                --this.m_meshState.m_runtimeMeshCount;
        }
        else{
            mut MeshResources mesh = this.m_meshState.m_meshes.at(desc.meshKey);
            assert(this.meshRenderBindingsReady(mesh));
            RefreshRuntimeMeshContent(mesh, desc);
            assert(mesh.valid());
            return Expected<mut MeshResources>(mesh);
        }
    }

    MeshResources createdMesh = this.emptyMesh();
    createdMesh.meshName = desc.meshKey;
    if(!TryCopyVector<u32>(createdMesh.solidTriangleWords, Span<u32>(desc.solidTriangleWords)))
        return MakeUnexpected(Failure());
    createdMesh.buffers = desc.buffers;
    createdMesh.triangleIndexBuffer = desc.triangleIndexBuffer;
    createdMesh.attributeBuffer = desc.attributeBuffer;
    createdMesh.runtimeLocalBoundsBuffer = desc.localBoundsBuffer;
    createdMesh.runtimeMeshletLocalBoundsBuffer = desc.meshletLocalBoundsBuffer;
    createdMesh.blasBuildPending = (desc.triangleIndexBuffer.valid());
    createdMesh.meshletCount = desc.meshletCount;
    createdMesh.meshletPrimitiveIndexCount = desc.meshletPrimitiveIndexCount;
    createdMesh.runtimeMesh = true;
    createdMesh.runtimeMeshVersion = desc.version;
    assert(desc.localBounds.valid());
    RefreshRuntimeMeshContent(createdMesh, desc);
    if(!ValidateRuntimeMeshPrimitiveIndexCount(createdMesh.meshName, createdMesh.meshletPrimitiveIndexCount, s_MeshletTriangleIndexCount))
        return MakeUnexpected(Failure());
    if(!ValidateRawBufferLogicalByteCount(createdMesh.buffers.meshletPrimitiveIndexBuffer, createdMesh.meshletPrimitiveIndexCount, createdMesh.meshName, s_MeshletPrimitiveIndexBufferLabel))
        return MakeUnexpected(Failure());
    assert(createdMesh.valid());
    MeshDescriptorTransaction retireUnpublished(this, createdMesh);
    if(!this.createMeshRenderBindings(createdMesh))
        return MakeUnexpected(Failure());

    auto result = TryEmplaceOwned<MeshResources>(this.m_meshState.m_meshes, desc.meshKey, createdMesh);
    if(result){
        retireUnpublished.release();
        ++this.m_meshState.m_runtimeMeshCount;
    }

    mut MeshResources stored = this.m_meshState.m_meshes.at(desc.meshKey);
    assert(stored.valid());
    return Expected<mut MeshResources>(stored);
}

Expected<mut MeshResources> RendererMeshSystem::findRuntimeMeshResources(in RuntimeMeshDesc desc){
    assert(desc.valid());

    const auto foundMesh = this.m_meshState.m_meshes.find(desc.meshKey);
    if(foundMesh == this.m_meshState.m_meshes.end())
        return MakeUnexpected(Failure());

    mut MeshResources mesh = this.m_meshState.m_meshes.at(desc.meshKey);
    if(!mesh.runtimeMesh || !RuntimeMeshSourceMatches(mesh, desc))
        return MakeUnexpected(Failure());

    assert(this.meshRenderBindingsReady(mesh));
    RefreshRuntimeMeshContent(mesh, desc);
    assert(mesh.valid());
    return Expected<mut MeshResources>(mesh);
}


