[cpp_header("<core/metascript/value.h>"), cpp_name("::NWB::Core::Metascript::ValueType::Enum")]
extern enum MetascriptValueType : u8{
    Null,
    Integer,
    Double,
    String,
    Reference,
    List,
    Map
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<core/metascript/value.h>"), cpp_name("::NWB::Core::Metascript::Value")]
extern class MetascriptValue{
    f64 asDouble(...)const;
    mut MetascriptList asList();
    mut MetascriptMap asMap();
    i64 asInteger(...)const;
    StringView asReference(...)const;
    StringView asString(...)const;
    mut MetascriptValue field(...);
    b8 copyStringList(mut Vector<String> output)const;
    b8 forEachMapEntry(in Func<b8(in StringView, in MetascriptValue)> a0)const;
    Optional<in MetascriptValue> borrowField(in StringView name)const;
    b8 hasField(...)const;
    b8 isDouble(...)const;
    b8 isInteger(...)const;
    b8 isList(...)const;
    b8 isMap(...)const;
    b8 isNull(...)const;
    b8 isNumeric(...)const;
    b8 isReference(...)const;
    b8 isString(...)const;
    Span<MetascriptValue> listView(...)const;
    void makeList(...);
    void makeMap(...);
    void setDouble(...);
    void setInteger(...);
    void setReference(...);
    void setString(...);
    f64 toDouble(...)const;
    MetascriptValueType type(...)const;
    b8 visitField(in StringView a0, in Func<void(in MetascriptValue)> a1)const;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<core/metascript/value.h>"), cpp_name("::NWB::Core::Metascript::Value::ListType")]
extern class MetascriptList{
    void clear();
    usize size()const;
    void pop_back();
    void reserve(in usize count);
    void push_back(in MetascriptValue value);
    in MetascriptValue front()const;
    mut MetascriptValue operator[](in usize index);
};

[cpp_header("<core/metascript/value.h>"), cpp_name("::NWB::Core::Metascript::Value::MapType")]
extern class MetascriptMap{
    usize erase(in StringView key);
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<core/metascript/value.h>"), cpp_name("::NWB::Core::Metascript::ValueType::s_ValueTypeNullBase")]
extern const u8 s_ValueTypeNullBase;


