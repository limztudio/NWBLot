Expected<UiEditNavigationResult> ResolveEcsUiEditViewNavigation(mut RecordingNavigationResolver self, in UiEditModel model, in UiEditNavigationDirectionEnum direction, in UiEditNavigationSnapshot navigation, in f32 viewportHeight){
    NavigationCall record = NavigationCall(self.arena());
    record.text.assign(model.text().data(), model.text().size());
    record.navigation = navigation;
    record.selectionGeneration = model.selectionGeneration();
    record.caret = model.caret();
    record.viewportHeight = viewportHeight;

    Expected<UiEditNavigationResult> result = MakeUnexpected(Failure());
    UiEditBoxView view = UiEditBoxView(self.arena());
    if(PrepareEcsUiEditView(model, self.layoutBuilder(), view)){
        const auto caret = view.caretGeometry().caretRect(view.displayCaret());
        if(caret){
            f32 preferredX = caret.value().x;
            if(navigation.valid){
                preferredX = navigation.preferredX;
            }
            Expected<usize> target = MakeUnexpected(Failure());
            if(direction == UiEditNavigationDirection::Up || direction == UiEditNavigationDirection::Down){
                target = view.caretGeometry().verticalTarget(view.displayCaret(), direction == UiEditNavigationDirection::Down, preferredX);
            }
            else{
                f32 distance = -viewportHeight;
                if(direction == UiEditNavigationDirection::PageDown){
                    distance = viewportHeight;
                }
                target = view.caretGeometry().hitTest(MakeEcsUiPoint(preferredX, caret.value().y + caret.value().height * 0.5f + distance));
            }
            if(target){
                UiEditNavigationResult resolved = UiEditNavigationResult();
                resolved.committedByte = target.value();
                resolved.preferredX = preferredX;
                result = resolved;
            }
        }
    }
    if(self.forceResult){
        result = self.forcedResult;
    }
    record.result = result;
    self.records.push_back(record);
    self.invokeHookIfPresent();
    return result;
}

b8 ApplyEcsUiAcceptingNavigationAction(mut AcceptingNavigationActions self, mut UiEditModel model, in UiEditActionEnum action){
    NavigationAction record = NavigationAction(self.arena());
    record.text.assign(model.text().data(), model.text().size());
    record.action = action;
    self.records.push_back(record);
    return true;
}

usize CountEcsUiNavigationActions(in AcceptingNavigationActions self, in UiEditActionEnum action){
    usize result = 0u;
    for(usize i = 0u; i < self.records.size(); ++i){
        if(self.records[i].action == action){
            ++result;
        }
    }
    return result;
}

b8 PrepareEcsUiNavigationModel(mut UiEditNavigationHostTests self, mut UiEditModel model, mut UiEditNavigationState navigation, in UiEditBoxOptions options, in UiRect bounds, in UiPoint previousScroll){
    if(!BeginEcsUiEditFrame(self)){
        return false;
    }
    self.m_result = self.m_host.editNavigated(self.m_widget, options, UiPopupToken(), model, navigation, self.m_resolver, self.m_actions);
    if(!self.m_result.valid || !PublishEcsUiEditBox(self, model, options, bounds, previousScroll)){
        return false;
    }
    if(!DeclareEcsUiWidget(self.m_context, "other", UiWidgetKind::Button, self.m_otherWidget)){
        return false;
    }
    UiHitTarget other = UiHitTarget();
    other.rectangle = MakeEcsUiRect(230.0f, 20.0f, 100.0f, 30.0f);
    other.clip = MakeEcsUiRect(0.0f, 0.0f, s_EcsUiViewportWidth, s_EcsUiViewportHeight);
    other.focusable = true;
    other.activatable = true;
    if(!self.m_context.addTarget(self.m_otherWidget, other) || !self.m_context.endRoot() || !self.m_context.finishFrame()){
        return false;
    }
    self.m_host.finishFrame();
    return true;
}

b8 CommitEcsUiNavigationText(mut UiEditNavigationHostTests self, in StringView text){
    if(self.m_textInput.commit(text) != TextInputAdmission::Accepted){
        return false;
    }
    self.m_host.collectNative();
    return true;
}

void VerifyUiTextEditSession_TrailingPreeditClearPreservesCommittedSelectedReplacementAndSingleUndo(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    UiEditModel model = UiEditModel(arena.arena);
    UiTextEditSession session = UiTextEditSession(arena.arena, service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("abcd"));
    ASSERT_TRUE(model.setSelection(1u, 3u));
    ASSERT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.preedit("xy", 0u, 2u), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(s_SessionTestOwner, model).status, UiTextEditStatus::Applied);
    EXPECT_EQ(model.text(), "abcd");
    EXPECT_FALSE(model.canUndo());
    ASSERT_EQ(service.preedit("xyz", 1u, 3u), TextInputAdmission::Accepted);
    ASSERT_EQ(service.commit("Z"), TextInputAdmission::Accepted);
    ASSERT_EQ(service.preedit(StringView(), 0u, 0u), TextInputAdmission::Accepted);
    const UiTextEditResult result = session.drain(s_SessionTestOwner, model);
    EXPECT_EQ(result.eventsApplied, 3u);
    EXPECT_EQ(model.text(), "aZd");
    EXPECT_FALSE(model.composition().active);
    ASSERT_TRUE(session.end(s_SessionTestOwner, model));
    ASSERT_TRUE(model.undo());
    EXPECT_EQ(model.text(), "abcd");
    EXPECT_EQ(model.anchor(), 1u);
    EXPECT_EQ(model.caret(), 3u);
    EXPECT_FALSE(model.canUndo());
}

void VerifyUiTextEditSession_EmptyPreeditCancelsWithoutChangingCommittedText(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    UiEditModel model = UiEditModel(arena.arena);
    UiTextEditSession session = UiTextEditSession(arena.arena, service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("base"));
    ASSERT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.preedit("transient", 0u, 9u), TextInputAdmission::Accepted);
    ASSERT_EQ(service.preedit(StringView(), 0u, 0u), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(s_SessionTestOwner, model).status, UiTextEditStatus::Applied);
    EXPECT_EQ(model.text(), "base");
    EXPECT_FALSE(model.composition().active);
    EXPECT_FALSE(model.canUndo());
}

void VerifyUiTextEditSession_FocusLossDiscardsQueuedCommitAndClearsOnlyTransientPreedit(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    UiEditModel model = UiEditModel(arena.arena);
    UiTextEditSession session = UiTextEditSession(arena.arena, service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("base"));
    ASSERT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.preedit("new", 0u, 3u), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(s_SessionTestOwner, model).status, UiTextEditStatus::Applied);
    ASSERT_EQ(service.commit("lost"), TextInputAdmission::Accepted);
    ASSERT_TRUE(service.setFocused(false));
    EXPECT_EQ(session.drain(s_SessionTestOwner, model).status, UiTextEditStatus::Cancelled);
    EXPECT_EQ(model.text(), "base");
    EXPECT_FALSE(model.composition().active);
    EXPECT_FALSE(session.token().valid());
}

void VerifyUiTextEditSession_ReplacedOwnerCannotReceiveOldQueuedCommit(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    UiEditModel oldModel = UiEditModel(arena.arena);
    UiEditModel newModel = UiEditModel(arena.arena);
    UiTextEditSession session = UiTextEditSession(arena.arena, service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(newModel.setText("replacement"));
    ASSERT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, oldModel), TextInputAdmission::Accepted);
    ASSERT_EQ(service.commit("old"), TextInputAdmission::Accepted);
    const UiTextEditOwner replacement = MakeReplacedSessionOwner(2u);
    EXPECT_EQ(session.drain(replacement, newModel).status, UiTextEditStatus::StaleOwner);
    EXPECT_EQ(newModel.text(), "replacement");
    EXPECT_FALSE(service.activeSession().valid());
    EXPECT_FALSE(session.token().valid());
}

void VerifyUiTextEditSession_ExternalTextAndSelectionChangesFenceOldNativeEvents(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    UiEditModel model = UiEditModel(arena.arena);
    UiTextEditSession session = UiTextEditSession(arena.arena, service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("abcd"));
    ASSERT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.commit("late"), TextInputAdmission::Accepted);
    ASSERT_TRUE(model.setSelection(0u, 2u));
    EXPECT_EQ(session.refresh(s_SessionTestOwner, model, s_SessionTestCaret), TextInputAdmission::InvalidSession);
    EXPECT_EQ(session.drain(s_SessionTestOwner, model).status, UiTextEditStatus::StaleModel);
    EXPECT_EQ(model.text(), "abcd");
    EXPECT_EQ(model.anchor(), 0u);
    EXPECT_EQ(model.caret(), 2u);
    ASSERT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.commit("late"), TextInputAdmission::Accepted);
    ASSERT_TRUE(model.setText("host value"));
    EXPECT_EQ(session.drain(s_SessionTestOwner, model).status, UiTextEditStatus::StaleModel);
    EXPECT_EQ(model.text(), "host value");
}

void VerifyUiTextEditSession_DeleteAddressesPublishedUtf8BytesThenCommitUsesUpdatedSelection(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    UiEditModel model = UiEditModel(arena.arena);
    UiTextEditSession session = UiTextEditSession(arena.arena, service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("abCde"));
    ASSERT_TRUE(model.setSelection(3u, 3u));
    ASSERT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.erase(1u, 1u, service.surroundingRevision(service.activeSession()), TextInputDeletionBasis::Caret), TextInputAdmission::Accepted);
    ASSERT_EQ(service.commit("X"), TextInputAdmission::Accepted);
    const UiTextEditResult result = session.drain(s_SessionTestOwner, model);
    EXPECT_EQ(result.status, UiTextEditStatus::Applied);
    EXPECT_EQ(result.eventsApplied, 2u);
    EXPECT_EQ(model.text(), "abXe");
}

void VerifyUiTextEditSession_PreeditClearBeforeCommitPreservesTheOriginalReplacementSelection(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    UiEditModel model = UiEditModel(arena.arena);
    UiTextEditSession session = UiTextEditSession(arena.arena, service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("abcd"));
    ASSERT_TRUE(model.setSelection(3u, 1u));
    ASSERT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.preedit("pending", 0u, 7u), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(s_SessionTestOwner, model).status, UiTextEditStatus::Applied);
    ASSERT_EQ(service.preedit(StringView(), 0u, 0u), TextInputAdmission::Accepted);
    ASSERT_EQ(service.commit("X"), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(s_SessionTestOwner, model).status, UiTextEditStatus::Applied);
    EXPECT_EQ(model.text(), "aXd");
    ASSERT_TRUE(session.end(s_SessionTestOwner, model));
    ASSERT_TRUE(model.undo());
    EXPECT_EQ(model.anchor(), 3u);
    EXPECT_EQ(model.caret(), 1u);
}

void VerifyUiTextEditSession_DeleteAfterUnpublishedCommitCannotDeleteDifferentText(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    UiEditModel model = UiEditModel(arena.arena);
    UiTextEditSession session = UiTextEditSession(arena.arena, service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("ab"));
    ASSERT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.commit("X"), TextInputAdmission::Accepted);
    ASSERT_EQ(service.erase(1u, 0u, service.surroundingRevision(service.activeSession()), TextInputDeletionBasis::Caret), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(s_SessionTestOwner, model).status, UiTextEditStatus::StaleSurrounding);
    EXPECT_EQ(model.text(), "abX");
    EXPECT_FALSE(session.token().valid());
}

void VerifyUiTextEditSession_NativeByteDeleteCannotSplitAGrapheme(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    UiEditModel model = UiEditModel(arena.arena);
    UiTextEditSession session = UiTextEditSession(arena.arena, service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("e\xCC\x81"));
    ASSERT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.erase(2u, 0u, service.surroundingRevision(service.activeSession()), TextInputDeletionBasis::Caret), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(s_SessionTestOwner, model).status, UiTextEditStatus::ModelRejected);
    EXPECT_EQ(model.text(), "e\xCC\x81");
    EXPECT_FALSE(model.canUndo());
}

void VerifyUiTextEditSession_RejectedCommitPreservesCommittedTextAndCancelsNativeSession(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    UiEditLimits limits = UiEditLimits();
    limits.maxBytes = 2u;
    limits.maxHistoryRecords = 4u;
    limits.maxHistoryBytes = 128u;
    UiEditModel model = UiEditModel(arena.arena, limits);
    UiTextEditSession session = UiTextEditSession(arena.arena, service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("ab"));
    ASSERT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.commit("too large"), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(s_SessionTestOwner, model).status, UiTextEditStatus::ModelRejected);
    EXPECT_EQ(model.text(), "ab");
    EXPECT_FALSE(model.canUndo());
    EXPECT_FALSE(service.activeSession().valid());
}

void VerifyUiTextEditSession_ExplicitEndClearsCompositionAndInvalidatesOldToken(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    UiEditModel model = UiEditModel(arena.arena);
    UiTextEditSession session = UiTextEditSession(arena.arena, service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Accepted);
    const TextInputSessionToken first = session.token();
    EXPECT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Busy);
    ASSERT_EQ(service.preedit("pending", 0u, 7u), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(s_SessionTestOwner, model).status, UiTextEditStatus::Applied);
    ASSERT_TRUE(session.end(s_SessionTestOwner, model));
    EXPECT_FALSE(model.composition().active);
    ASSERT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Accepted);
    EXPECT_NE(session.token(), first);
    TextInputEvent event = TextInputEvent(arena.arena);
    EXPECT_EQ(service.poll(first, event), TextInputPollResult::InvalidSession);
}

void VerifyUiTextEditSession_DestructionReleasesServiceWithoutBorrowingTheDestroyedModel(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    ASSERT_TRUE(service.setFocused(true));
    if(true){
        UiTextEditSession session = UiTextEditSession(arena.arena, service);
        if(true){
            UiEditModel model = UiEditModel(arena.arena);
            ASSERT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Accepted);
        }
        EXPECT_TRUE(service.activeSession().valid());
    }
    EXPECT_FALSE(service.activeSession().valid());
}


