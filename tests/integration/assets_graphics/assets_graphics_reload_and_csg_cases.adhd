const StringView s_BuildInputANwb = "a.nwb";
const StringView s_BuildInputAssetsANwb = "assets/a.nwb";
const StringView s_CsgAuthoredDefine = "AUTHORED";
const StringView s_CsgModuleOptionDefine = "MODULE_OPTION";
const StringView s_CsgModulePath = "project/csg/module";
const StringView s_CsgGeneratedModulePath = "project/csg/generated/module.slangi";
const StringView s_RendererComponentMetadata = "renderer_component asset;\nasset.material = \"project/materials/glass\";\nasset.visible = 1;\nasset.optical_volume_coincidence = \"shared_group\";\nasset.optical_volume_group = \"lens_assembly\";\nasset.optical_volume_priority = 4;\nasset.optical_boundary_mode = \"closed_priority\";\nasset.optical_medium_priority = 9;\n";


void VerifyAssetsGraphics_SkinBinaryRejectsInvalidWeightsJointsMatricesAndReservedFieldsWithoutReplacingState(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    native(mut testArena){
        using namespace NWB::Impl;
        SkinHeaderBinary header;
        header.meshNameHash = Name(s_AssetCaseProjectMeshesOriginal).hash();
        header.skeletonNameHash = Name(s_AssetCaseProjectSkeletonsOriginal).hash();
        header.influenceCount = 1u;
        header.inverseBindMatrixCount = 1u;
        SkinInfluence4 influence;
        influence.weight = Float4U(1.0f, 0.0f, 0.0f, 0.0f);
        const SkeletonJointMatrix originalMatrix = MatrixIdentity<Float34>();
        Core::Assets::AssetBytes original(testArena.arena);
        AppendPOD(original, header);
        AppendPOD(original, influence);
        AppendPOD(original, originalMatrix);
        Skin skin(testArena.arena, Name(s_AssetCaseProjectSkinsOriginal));
        ASSERT_TRUE(skin.loadBinary(original));
        SkinAssetCodec codec;
        for(u32 invalidCase = 0u; invalidCase < 8u; ++invalidCase){
            SkinHeaderBinary malformedHeader = header;
            malformedHeader.meshNameHash = Name(s_AssetCaseProjectMeshesReplacement).hash();
            SkinInfluence4 malformedInfluence = influence;
            SkeletonJointMatrix matrix = originalMatrix;
            switch(invalidCase){
            case 0u: malformedHeader.padding0 = 1u; break;
            case 1u: malformedInfluence.weight.x = BitCast<f32>(0x7fc00001u); break;
            case 2u: malformedInfluence.weight.x = -1.0f; break;
            case 3u: malformedInfluence.weight.x = 0.5f; break;
            case 4u: malformedInfluence.joint[3u] = 1u; break;
            case 5u: matrix._11 = 0.0f; break;
            case 6u: matrix._14 = BitCast<f32>(0x7f800000u); break;
            }
            Core::Assets::AssetBytes malformed(testArena.arena);
            AppendPOD(malformed, malformedHeader);
            AppendPOD(malformed, malformedInfluence);
            AppendPOD(malformed, matrix);
            if(invalidCase == 7u)
                malformed.push_back(0u);
            EXPECT_FALSE(skin.loadBinary(malformed)) << invalidCase;
            Core::Assets::AssetBytes retained(testArena.arena);
            ASSERT_TRUE(codec.serialize(skin, retained));
            EXPECT_EQ(retained, original) << invalidCase;
        }
    }
}

void VerifyAssetsGraphics_ModelBinaryRejectsNonFiniteTransformsAndReservedFieldsWithoutReplacingState(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    native(mut testArena){
        using namespace NWB::Impl;
        ModelHeaderBinary header;
        header.skeletonObjectCount = 1u;
        header.staticMeshObjectCount = 1u;
        header.skinnedMeshObjectCount = 1u;
        ModelSkeletonObjectBinary skeleton;
        skeleton.nameHash = Name(s_AssetCaseRig).hash();
        skeleton.skeletonNameHash = Name(s_AssetCaseProjectSkeletonsOriginal).hash();
        skeleton.transform = MatrixIdentity<Float34>();
        ModelStaticMeshObjectBinary staticMesh;
        staticMesh.nameHash = Name(s_AssetCaseProp).hash();
        staticMesh.meshNameHash = Name(s_AssetCaseProjectMeshesProp).hash();
        staticMesh.transform = MatrixIdentity<Float34>();
        ModelSkinnedMeshObjectBinary skinnedMesh;
        skinnedMesh.nameHash = Name(s_AssetCaseBody).hash();
        skinnedMesh.skinNameHash = Name(s_AssetCaseProjectSkinsBody).hash();
        skinnedMesh.skeletonObjectNameHash = skeleton.nameHash;
        skinnedMesh.transform = MatrixIdentity<Float34>();
        Core::Assets::AssetBytes original(testArena.arena);
        AppendPOD(original, header);
        AppendPOD(original, skeleton);
        AppendPOD(original, staticMesh);
        AppendPOD(original, skinnedMesh);
        Model model(testArena.arena, Name(s_AssetCaseProjectModelsOriginal));
        ASSERT_TRUE(model.loadBinary(original));
        ModelAssetCodec codec;
        for(u32 invalidCase = 0u; invalidCase < 7u; ++invalidCase){
            auto malformedHeader = header;
            auto malformedSkeleton = skeleton;
            auto malformedStatic = staticMesh;
            auto malformedSkinned = skinnedMesh;
            switch(invalidCase){
            case 0u: malformedHeader.padding0 = 1u; break;
            case 1u: malformedSkeleton.transform._11 = BitCast<f32>(0x7fc00001u); break;
            case 2u: malformedStatic.transform._24 = BitCast<f32>(0x7f800000u); break;
            case 3u: malformedSkinned.transform._33 = BitCast<f32>(0xff800000u); break;
            case 4u: malformedStatic.nameHash = skeleton.nameHash; break;
            case 5u: malformedSkinned.skeletonObjectNameHash = staticMesh.nameHash; break;
            }
            Core::Assets::AssetBytes malformed(testArena.arena);
            AppendPOD(malformed, malformedHeader);
            AppendPOD(malformed, malformedSkeleton);
            AppendPOD(malformed, malformedStatic);
            AppendPOD(malformed, malformedSkinned);
            if(invalidCase == 6u)
                malformed.pop_back();
            EXPECT_FALSE(model.loadBinary(malformed)) << invalidCase;
            Core::Assets::AssetBytes retained(testArena.arena);
            ASSERT_TRUE(codec.serialize(model, retained));
            EXPECT_EQ(retained, original) << invalidCase;
        }
    }
}

void VerifyAssetsGraphics_SkeletonBinaryRejectsNonFinitePosesInvalidParentsAndReservedFieldsWithoutReplacingState(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    native(mut testArena){
        using namespace NWB::Impl;
        SkeletonHeaderBinary header;
        header.jointCount = 1u;
        SkeletonJointBinary joint;
        joint.nameHash = Name(s_AssetCaseRoot).hash();
        joint.parentIndex = s_SkeletonInvalidJointIndex;
        joint.localBindPose = MatrixIdentity<Float34>();
        Core::Assets::AssetBytes original(testArena.arena);
        AppendPOD(original, header);
        AppendPOD(original, joint);
        Skeleton skeleton(testArena.arena, Name(s_AssetCaseProjectSkeletonsOriginal));
        ASSERT_TRUE(skeleton.loadBinary(original));
        SkeletonAssetCodec codec;
        for(u32 invalidCase = 0u; invalidCase < 7u; ++invalidCase){
            auto malformedHeader = header;
            auto malformedJoint = joint;
            malformedJoint.nameHash = Name(s_AssetCaseReplacement).hash();
            switch(invalidCase){
            case 0u: malformedHeader.padding0 = 1u; break;
            case 1u: malformedJoint.padding0 = 1u; break;
            case 2u: malformedJoint.padding1[1u] = 1u; break;
            case 3u: malformedJoint.localBindPose._14 = BitCast<f32>(0x7fc00001u); break;
            case 4u: malformedJoint.parentIndex = 0u; break;
            case 5u: malformedHeader.jointCount = static_cast<u64>(Limit<u32>::s_Max) + 1u; break;
            }
            Core::Assets::AssetBytes malformed(testArena.arena);
            AppendPOD(malformed, malformedHeader);
            AppendPOD(malformed, malformedJoint);
            if(invalidCase == 6u)
                malformed.push_back(0u);
            EXPECT_FALSE(skeleton.loadBinary(malformed)) << invalidCase;
            Core::Assets::AssetBytes retained(testArena.arena);
            ASSERT_TRUE(codec.serialize(skeleton, retained));
            EXPECT_EQ(retained, original) << invalidCase;
            EXPECT_EQ(skeleton.findJointIndex(Name(s_AssetInputNameRoot)), 0u);
            EXPECT_EQ(skeleton.findJointIndex(Name(s_AssetInputNameReplacement)), s_SkeletonInvalidJointIndex);
        }
    }
}

void VerifyBuildInputSelection_MissingRootTakesPriorityOverMissingOutput(mut BuildInputSelection self){
    EXPECT_FALSE(ValidateAssetBuilderPathInputs(false, false));
    EXPECT_TRUE(SawCapturedError(self.m_logger, "no asset roots specified"));
    EXPECT_FALSE(SawCapturedError(self.m_logger, "output directory is empty"));
    EXPECT_FALSE(ValidateAssetBuilderPathInputs(true, false));
    EXPECT_TRUE(SawCapturedError(self.m_logger, "output directory is empty"));
    EXPECT_EQ(self.m_logger.errorCount(), 2u);
}

void VerifyBuildInputSelection_EmptyBuildDomainIsRejectedBeforeInputDiscovery(mut BuildInputSelection self){
    self.m_options.assetType.clear();
    EXPECT_FALSE(BuildAssets(self.m_options, self.m_scratchArena));
    EXPECT_TRUE(SawCapturedError(self.m_logger, "unsupported --asset-type ''"));
    EXPECT_EQ(self.m_logger.errorCount(), 1u);

    ASSERT_TRUE(self.m_options.assetType.assign(s_AssetVolumeName));
    EXPECT_FALSE(BuildAssets(self.m_options, self.m_scratchArena));
    EXPECT_TRUE(SawCapturedError(self.m_logger, "no asset roots specified"));
    EXPECT_EQ(self.m_logger.errorCount(), 2u);
}

void VerifyBuildInputSelection_ExactInputsPreserveDiscoveredOrderAndDuplicateRecords(mut BuildInputSelection self){
    self.addFile("assets/z.nwb");
    self.addFile(s_BuildInputAssetsANwb);
    self.addFile("assets/excluded.nwb");
    self.addFile(s_BuildInputAssetsANwb);
    self.addInput("assets/./a.nwb");
    self.addInput("assets/z.nwb");
    self.addInput(s_BuildInputAssetsANwb);
    ASSERT_TRUE(self.select());
    ASSERT_EQ(self.fileCount(), 3u);
    const AssetString file0 = self.filenameAt(0u);
    const AssetString file1 = self.filenameAt(1u);
    const AssetString file2 = self.filenameAt(2u);
    EXPECT_EQ(ViewArenaString(file0), "z.nwb");
    EXPECT_EQ(ViewArenaString(file1), s_BuildInputANwb);
    EXPECT_EQ(ViewArenaString(file2), s_BuildInputANwb);
}

void VerifyBuildInputSelection_DirectoryInputsRespectBoundariesAndAllowEmptyRoots(mut BuildInputSelection self){
    self.addFile("assets/part/a.nwb");
    self.addFile("assets/partial/b.nwb");
    self.addFile("assets/part/nested/c.nwb");
    self.addInput("assets/part/../part");
    self.addInput("assets/part/nested");
    self.addInput("assets/empty");
    ASSERT_TRUE(self.select());
    ASSERT_EQ(self.fileCount(), 2u);
    const AssetString file0 = self.filenameAt(0u);
    const AssetString file1 = self.filenameAt(1u);
    EXPECT_EQ(ViewArenaString(file0), s_BuildInputANwb);
    EXPECT_EQ(ViewArenaString(file1), "c.nwb");
}

void VerifyBuildInputSelection_RejectedInputsLeaveDiscoveredFilesIntact(mut BuildInputSelection self){
    self.addFile(s_BuildInputAssetsANwb);
    self.addFile("outside/b.nwb");
    self.addInput(s_BuildInputAssetsANwb);
    self.addInput("outside");
    EXPECT_FALSE(self.select());
    EXPECT_EQ(self.fileCount(), 2u);
    self.clearInputs();
    self.addInput("assets/missing.nwb");
    EXPECT_FALSE(self.select());
    EXPECT_EQ(self.fileCount(), 2u);
    self.clearInputs();
    self.addInput("assets/empty");
    ASSERT_TRUE(self.select());
    EXPECT_EQ(self.fileCount(), 0u);
}

void VerifyBuildInputSelection_DirectoryCaseFollowsHostFilesystemContract(mut BuildInputSelection self){
    self.addFile("assets/Case/a.nwb");
    self.addFile("assets/case/b.nwb");
    self.addInput("assets/Case");
    ASSERT_TRUE(self.select());
    if(IsWindowsPlatformHost()){
        EXPECT_EQ(self.fileCount(), 2u);
    }
    else{
        ASSERT_EQ(self.fileCount(), 1u);
        const AssetString file0 = self.filenameAt(0u);
        EXPECT_EQ(ViewArenaString(file0), s_BuildInputANwb);
    }
}

void VerifyBuildInputSelection_InferredRootsDeduplicateAssetsAncestorsWithoutDroppingExternalDirectories(mut BuildInputSelection self){
    self.addFile("assets/part/a.nwb");
    self.addFile("impl/assets/b.nwb");
    self.addFile("loose/c.nwb");
    ScratchArena scratchArena(s_AssetCaseTestsAssetsInferredRoots);
    CookStringVector sources = self.makeCookSources();
    self.appendCookSource("assets/part/../part/a.nwb", sources);
    self.appendCookSource("impl/assets/b.nwb", sources);
    self.appendCookSource("assets/empty", sources);
    self.appendCookSource("loose/c.nwb", sources);
    const Expected<ResolvedAssetRootVector, AssetRootResolutionError> rootsResult = ResolveTestAssetRoots(self.m_root, sources, true, s_DuplicatePolicyExactText, scratchArena);
    ASSERT_TRUE(rootsResult.has_value());
    const ResolvedAssetRootVector roots = rootsResult.value();
    ASSERT_EQ(roots.size(), 3u);
    EXPECT_EQ(roots[0u].path, JoinGraphicsPath(self.m_root, s_AssetsDirectory).lexicallyNormal());
    EXPECT_EQ(roots[0u].virtualRoot.view(), s_ProjectVirtualRoot);
    EXPECT_EQ(roots[1u].path, JoinGraphicsPath2(self.m_root, "impl", s_AssetsDirectory).lexicallyNormal());
    EXPECT_EQ(roots[1u].virtualRoot.view(), "engine");
    EXPECT_EQ(roots[2u].path, JoinGraphicsPath(self.m_root, "loose").lexicallyNormal());
    EXPECT_EQ(roots[2u].virtualRoot.view(), s_ProjectVirtualRoot);
}

void VerifyBuildInputSelection_ExplicitRootsPreserveFirstSpellingAndCallerDuplicatePolicy(mut BuildInputSelection self){
    ScratchArena scratchArena(s_AssetCaseTestsAssetsExplicitRoots);
    CookStringVector sources = self.makeCookSources();
    self.appendCookSource("assets/./Case", sources);
    self.appendCookSource("assets/Case", sources);
    self.appendCookSource("assets/case", sources);
    self.appendCookSource("impl/assets/graphics", sources);
    self.appendCookPathSource(JoinGraphicsPath2(self.m_root, s_AssetsDirectory, "Case"), sources);
    const Expected<ResolvedAssetRootVector, AssetRootResolutionError> exactResult = ResolveTestAssetRoots(self.m_root, sources, false, s_DuplicatePolicyExactText, scratchArena);
    ASSERT_TRUE(exactResult.has_value());
    const ResolvedAssetRootVector exact = exactResult.value();
    ASSERT_EQ(exact.size(), 3u);
    EXPECT_EQ(exact[0u].path, JoinGraphicsPath2(self.m_root, s_AssetsDirectory, "Case").lexicallyNormal());
    EXPECT_EQ(exact[1u].path, JoinGraphicsPath2(self.m_root, s_AssetsDirectory, "case").lexicallyNormal());
    // Explicit roots remain exact directories rather than climbing to their assets ancestor.
    EXPECT_EQ(exact[2u].path, JoinGraphicsPath3(self.m_root, "impl", s_AssetsDirectory, "graphics").lexicallyNormal());
    EXPECT_EQ(exact[2u].virtualRoot.view(), s_ProjectVirtualRoot);
    const Expected<ResolvedAssetRootVector, AssetRootResolutionError> hostResult = ResolveTestAssetRoots(self.m_root, sources, false, s_DuplicatePolicyHostFilesystem, scratchArena);
    ASSERT_TRUE(hostResult.has_value());
    const ResolvedAssetRootVector host = hostResult.value();
    if(IsWindowsPlatformHost()){
        ASSERT_EQ(host.size(), 2u);
        EXPECT_EQ(host[1u].path, exact[2u].path);
    }
    else{
        ASSERT_EQ(host.size(), exact.size());
        EXPECT_EQ(host[1u].path, exact[1u].path);
    }
    EXPECT_EQ(host[0u].path, exact[0u].path);
}

void VerifyBuildInputSelection_RootResolutionFailureRetainsSourceIndexWithoutPublishingPartialRoots(mut BuildInputSelection self){
    ScratchArena scratchArena(s_AssetCaseTestsAssetsRejectedRoots);
    CookStringVector sources = self.makeCookSources();
    self.appendCookSource("assets", sources);
    self.appendCookSource("", sources);
    const Expected<ResolvedAssetRootVector, AssetRootResolutionError> rejected = ResolveTestAssetRoots(self.m_root, sources, false, s_DuplicatePolicyExactText, scratchArena);
    ASSERT_FALSE(rejected.has_value());
    EXPECT_EQ(rejected.error().sourceIndex, 1u);
    EXPECT_EQ(rejected.error().reason, s_RootFailureResolvePath);
    EXPECT_TRUE(rejected.error().inputPath.empty());
    EXPECT_TRUE(HasNonZeroErrorCode(rejected.error().error));
    sources[1u].assign("assets/empty");
    const Expected<ResolvedAssetRootVector, AssetRootResolutionError> recoveredResult = ResolveTestAssetRoots(self.m_root, sources, true, s_DuplicatePolicyExactText, scratchArena);
    ASSERT_TRUE(recoveredResult.has_value());
    const ResolvedAssetRootVector recovered = recoveredResult.value();
    ASSERT_EQ(recovered.size(), 1u);
    EXPECT_EQ(recovered[0u].path, JoinGraphicsPath(self.m_root, s_AssetsDirectory).lexicallyNormal());
}

void VerifyAssetsGraphics_RendererOpticalVolumeGroupRejectsOnlyAsciiEdgePadding(){
    EXPECT_FALSE(IsUnpaddedRendererOpticalVolumeGroup(""));
    EXPECT_FALSE(IsUnpaddedRendererOpticalVolumeGroup(" \t "));
    EXPECT_FALSE(IsUnpaddedRendererOpticalVolumeGroup(" group"));
    EXPECT_FALSE(IsUnpaddedRendererOpticalVolumeGroup("group\n"));
    EXPECT_TRUE(IsUnpaddedRendererOpticalVolumeGroup("group\tname"));
    EXPECT_TRUE(IsUnpaddedRendererOpticalVolumeGroup("\xc2\xa0group"));
}

void VerifyAssetsGraphics_RendererComponentCookAndSerializePreservesOpticalFields(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    const Expected<CookCase> cookCaseResult = PrepareCookCase(testArena, "renderer_component_optical_fields");
    ASSERT_TRUE(cookCaseResult.has_value());
    const CookCase cookCase = cookCaseResult.value();
    const GraphicsTestPath root = cookCase.root;
    const GraphicsTestPath outputDirectory = cookCase.outputDirectory;
    const GraphicsTestPath assetRoot = JoinGraphicsPath(root, s_AssetsDirectory);
    const Name virtualPath = s_ProjectEntitiesLensRenderer;

    ASSERT_TRUE(WriteTextFile(JoinGraphicsPath3(assetRoot, "entities", "lens", "renderer.nwb"), s_RendererComponentMetadata));
    ASSERT_TRUE(CookSingleAssetRoot(testArena, root, outputDirectory, assetRoot, 1u));

    const Expected<RendererComponent> loadedComponent = LoadCookedRendererComponent(testArena, outputDirectory, virtualPath, 1u);
    ASSERT_TRUE(loadedComponent.has_value());
    const RendererComponent component = loadedComponent.value();
    EXPECT_EQ(component.material.name(), Name("project/materials/glass"));
    EXPECT_TRUE(component.visible);
    EXPECT_EQ(component.opticalVolumeCoincidence, s_OpticalCoincidenceSharedGroup);
    EXPECT_EQ(component.opticalVolumeGroup, Name("lens_assembly"));
    EXPECT_EQ(component.opticalVolumePriority, 4);
    EXPECT_EQ(component.opticalBoundaryMode, s_OpticalBoundaryClosedPriority);
    EXPECT_EQ(component.opticalMediumPriority, 9);
    EXPECT_EQ(logger.errorCount(), 0u);
    EXPECT_TRUE(RemoveAllIfExists(root).has_value());
}

void VerifyAssetsGraphics_ShaderPlanningCapacityBoundaries(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    const usize maxSize = usize.max;
    const usize clipExtra = s_CsgClipAddedDefineCount;
    const usize preparedFactor = s_MaxPreparedEntriesPerShaderEntry;

    const Expected<usize> clipCapacity = TryComputeCsgClipDefineCapacity("edge", maxSize - clipExtra);
    ASSERT_TRUE(clipCapacity.has_value());
    EXPECT_EQ(clipCapacity.value(), maxSize);
    EXPECT_FALSE(TryComputeCsgClipDefineCapacity("edge", maxSize - clipExtra + 1u).has_value());

    const Expected<usize> includeCapacity = TryComputeShaderIncludeRootCapacity("edge", maxSize - 1u, 1u);
    ASSERT_TRUE(includeCapacity.has_value());
    EXPECT_EQ(includeCapacity.value(), maxSize);
    EXPECT_FALSE(TryComputeShaderIncludeRootCapacity("edge", maxSize, 1u).has_value());

    const Expected<usize> preparedCapacity = TryComputePreparedShaderEntryCapacity(maxSize / preparedFactor);
    ASSERT_TRUE(preparedCapacity.has_value());
    EXPECT_EQ(preparedCapacity.value(), (maxSize / preparedFactor) * preparedFactor);
    EXPECT_FALSE(TryComputePreparedShaderEntryCapacity(maxSize / preparedFactor + 1u).has_value());

    const Expected<usize> implicitCapacity = TryComputeImplicitShaderIncludeRootCapacity(maxSize - 1u, 1u);
    ASSERT_TRUE(implicitCapacity.has_value());
    EXPECT_EQ(implicitCapacity.value(), maxSize);
    EXPECT_FALSE(TryComputeImplicitShaderIncludeRootCapacity(maxSize, 1u).has_value());

    EXPECT_TRUE(ValidateShaderMergedDefineCount("edge", cast<usize>(u32.max)));
    if(maxSize > cast<usize>(u32.max))
        EXPECT_FALSE(ValidateShaderMergedDefineCount("edge", cast<usize>(u32.max) + 1u));
}

void VerifyAssetsGraphics_ShaderPlanMergesEvaluatorDependenciesOnceAndKeepsInheritedDefines(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_ShaderScratchArena);
    const Expected<GraphicsTestPath> rootResult = PrepareCaseRoot(testArena, "evaluator_dependency_plan");
    ASSERT_TRUE(rootResult.has_value());
    const GraphicsTestPath root = rootResult.value();

    const GraphicsTestPath bindRoot = JoinGraphicsPath(root, "bind");
    const GraphicsTestPath csgRoot = JoinGraphicsPath(root, "csg");
    ASSERT_TRUE(WriteTextFile(JoinGraphicsPath(bindRoot, "unused.slangi"), "// Empty bind root.\n"));
    ASSERT_TRUE(WriteTextFile(JoinGraphicsPath(root, "shader.slang"), "#include \"common.slangi\"\nvoid main(){}\n"));
    ASSERT_TRUE(WriteTextFile(JoinGraphicsPath(root, "common.slangi"), "static const uint sharedValue = 1u;\n"));
    ASSERT_TRUE(WriteTextFile(JoinGraphicsPath(csgRoot, "first.slangi"), "#include \"../common.slangi\"\n"));
    ASSERT_TRUE(WriteTextFile(JoinGraphicsPath(csgRoot, "second.slangi"), "#include \"../common.slangi\"\n"));

    ResolvedCookPaths paths(testArena.arena);
    paths.repoRoot = root;
    paths.cacheDirectory = JoinGraphicsPath(root, s_CacheDirectory);
    IncludeMetadataMap includeMetadata(testArena.arena);
    AddEvaluatorIncludeMetadata2(testArena, JoinGraphicsPath(root, "common.slangi"), "SHARED_OPTION", "0", "1", s_CsgAuthoredDefine, includeMetadata);
    AddEvaluatorIncludeMetadata2(testArena, JoinGraphicsPath(csgRoot, "first.slangi"), s_CsgModuleOptionDefine, "0", "1", s_CsgAuthoredDefine, includeMetadata);
    AddEvaluatorIncludeMetadata1(testArena, JoinGraphicsPath(csgRoot, "second.slangi"), s_CsgModuleOptionDefine, "2", s_CsgAuthoredDefine, includeMetadata);

    for(u32 mode = 0u; mode < 3u; ++mode){
        const ScopedTestTrace trace(mode);
        PreparedShaderPlan plan(testArena.arena);
        {
            Expected<PreparedShaderPlan> planResult = PrepareEvaluatorShaderPlan(testArena, scratchArena, paths, bindRoot, csgRoot, includeMetadata, s_CsgAuthoredDefine, mode);
            ASSERT_TRUE(planResult.has_value());
            plan = planResult.value();
        }
        ASSERT_EQ(plan.preparedEntries.size(), 1u);
        const PreparedShaderEntry prepared = plan.preparedEntries[0u];
        usize expectedDependencyCount = 2u;
        u64 expectedVariantCount = 2u;
        if(mode == 2u){
            expectedDependencyCount = 4u;
            expectedVariantCount = 8u;
        }
        ASSERT_EQ(prepared.dependencies.size(), expectedDependencyCount);
        EXPECT_EQ(prepared.dependencies[0u], JoinGraphicsPath(root, "shader.slang"));
        EXPECT_EQ(prepared.dependencies[1u], JoinGraphicsPath(root, "common.slangi"));
        ASSERT_TRUE(HasPreparedShaderDefine(prepared, s_CsgAuthoredDefine));
        const CookStringVector authoredValues = GetPreparedShaderDefineValues(prepared, s_CsgAuthoredDefine);
        ASSERT_EQ(authoredValues.size(), 1u);
        EXPECT_EQ(ViewArenaString(authoredValues[0u]), "authored");
        EXPECT_EQ(prepared.variantCount, expectedVariantCount);
        EXPECT_EQ(plan.plannedFileCount, prepared.variantCount + 1u);
        if(mode == 2u){
            EXPECT_EQ(prepared.dependencies[2u], JoinGraphicsPath(csgRoot, "first.slangi"));
            EXPECT_EQ(prepared.dependencies[3u], JoinGraphicsPath(csgRoot, "second.slangi"));
            ASSERT_TRUE(HasPreparedShaderDefine(prepared, s_CsgModuleOptionDefine));
            const CookStringVector inheritedValues = GetPreparedShaderDefineValues(prepared, s_CsgModuleOptionDefine);
            ASSERT_EQ(inheritedValues.size(), 2u);
            EXPECT_EQ(ViewArenaString(inheritedValues[0u]), "0");
            EXPECT_EQ(ViewArenaString(inheritedValues[1u]), "1");
            ASSERT_TRUE(WriteTextFile(JoinGraphicsPath(csgRoot, "second.slangi"), "#include \"../common.slangi\"\n// Changed module.\n"));
            PreparedShaderPlan changedPlan(testArena.arena);
            {
                Expected<PreparedShaderPlan> changedResult = PrepareEvaluatorShaderPlan(testArena, scratchArena, paths, bindRoot, csgRoot, includeMetadata, s_CsgAuthoredDefine, mode);
                ASSERT_TRUE(changedResult.has_value());
                changedPlan = changedResult.value();
            }
            ASSERT_EQ(changedPlan.preparedEntries.size(), 1u);
            EXPECT_NE(changedPlan.preparedEntries[0u].dependencyChecksum, prepared.dependencyChecksum);
            EXPECT_EQ(changedPlan.preparedEntries[0u].variantCount, prepared.variantCount);
        }
    }
    EXPECT_EQ(logger.errorCount(), 0u);
    EXPECT_TRUE(RemoveAllIfExists(root).has_value());
}

void VerifyAssetsGraphics_CsgShapeCookAndRuntimeUseCanonicalIdsRegardlessOfRegistrationOrder(){
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_ShaderScratchArena);
    const Name alphaShape = s_ProjectCsgAlphaShape;
    const Name zebraShape = s_ProjectCsgZebraShape;
    const Name alphaModule = s_ProjectCsgAlphaModule;
    const Name zebraModule = s_ProjectCsgZebraModule;
    const StringView alphaInclude = "project/csg/generated/alpha.slangi";
    const StringView zebraInclude = "project/csg/generated/zebra.slangi";

    CsgShapeCookEntryVector cookedEntries(testArena.arena);
    // The cooker normalizes its input by name, while the runtime deliberately receives the inverse order.
    AddCsgShapeCookEntry(zebraShape, zebraModule, zebraInclude, testArena, cookedEntries);
    AddCsgShapeCookEntry(alphaShape, alphaModule, alphaInclude, testArena, cookedEntries);
    ASSERT_TRUE(AssignTestCsgShapeCookIds(cookedEntries, scratchArena));

    const CsgShapeTypeId cookedAlphaId = FindCookedCsgShapeTypeId(cookedEntries, alphaShape);
    const CsgShapeTypeId cookedZebraId = FindCookedCsgShapeTypeId(cookedEntries, zebraShape);
    ASSERT_NE(cookedAlphaId, s_InvalidCsgShapeTypeId);
    ASSERT_NE(cookedZebraId, s_InvalidCsgShapeTypeId);
    EXPECT_NE(cookedAlphaId, cookedZebraId);

    CsgShapeRegistry registry(testArena.arena);
    const Expected<CsgShapeTypeId> runtimeZebraId = registry.registerShapeType(MakeCsgCookTestShapeDesc(zebraShape, zebraModule, zebraInclude, testArena));
    ASSERT_TRUE(runtimeZebraId.has_value());
    const Expected<CsgShapeTypeId> runtimeAlphaId = registry.registerShapeType(MakeCsgCookTestShapeDesc(alphaShape, alphaModule, alphaInclude, testArena));
    ASSERT_TRUE(runtimeAlphaId.has_value());
    EXPECT_EQ(runtimeAlphaId.value(), cookedAlphaId);
    EXPECT_EQ(runtimeZebraId.value(), cookedZebraId);
}

void VerifyAssetsGraphics_CsgShapeIdsRejectDuplicateCanonicalNamesBeforePublishingTheDuplicate(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_ShaderScratchArena);
    CsgShapeCookEntryVector entries(testArena.arena);
    AddCsgShapeCookEntry(Name("project/csg/duplicate"), Name(s_CsgModulePath), s_CsgGeneratedModulePath, testArena, entries);
    AddCsgShapeCookEntry(Name("PROJECT/CSG/DUPLICATE"), Name(s_CsgModulePath), s_CsgGeneratedModulePath, testArena, entries);

    EXPECT_FALSE(AssignTestCsgShapeCookIds(entries, scratchArena));
    ASSERT_EQ(entries.size(), 2u);
    EXPECT_NE(entries[0u].shapeTypeId, s_InvalidCsgShapeTypeId);
    EXPECT_EQ(entries[1u].shapeTypeId, s_InvalidCsgShapeTypeId);
    EXPECT_TRUE(SawCapturedError(logger, "collide on canonical GPU id"));
    EXPECT_EQ(logger.errorCount(), 1u);
}

void VerifyAssetsGraphics_CsgMixedCaseModuleIncludeRetainsCookedPathAndRuntimeIdentity(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_ShaderScratchArena);
    const Expected<GraphicsTestPath> rootResult = PrepareCaseRoot(testArena, "csg_mixed_case_module_include");
    ASSERT_TRUE(rootResult.has_value());
    const GraphicsTestPath root = rootResult.value();
    MetaDocument document(testArena.arena);
    ASSERT_TRUE(document.parse("csg_shape asset;\nasset.shape = \"project/csg/mixed_case_shape\";\nasset.module = \"project/csg/mixed_case_module\";\nasset.module_include = \"project/csg/Generated/MixedCaseEvaluator.slangi\";\nasset.eval = \"project/csg/MixedCaseEval.slangi\";\n"));
    const Expected<CsgShapeCookEntry> cookedResult = ParseTestCsgShapeMetadata(JoinGraphicsPath(root, "shape.nwb"), document, testArena, scratchArena);
    ASSERT_TRUE(cookedResult.has_value());
    const CsgShapeCookEntry cooked = cookedResult.value();
    const StringView moduleInclude = "project/csg/Generated/MixedCaseEvaluator.slangi";
    EXPECT_EQ(ViewArenaString(cooked.moduleInclude), moduleInclude);
    CsgShapeCookEntryVector entries(testArena.arena);
    entries.push_back(cooked);
    ASSERT_TRUE(AssignTestCsgShapeCookIds(entries, scratchArena));
    const Expected<GraphicsTestPath> generatedRoot = EmitTestCsgShapeModules(JoinGraphicsPath(root, s_CacheDirectory), "tests", entries, scratchArena);
    ASSERT_TRUE(generatedRoot.has_value());
    const Expected<b8, ErrorCode> generatedExists = FileExists(JoinGraphicsPath(generatedRoot.value(), moduleInclude));
    ASSERT_TRUE(generatedExists.has_value());
    EXPECT_TRUE(generatedExists.value());
    CsgShapeRegistry registry(testArena.arena);
    const Expected<CsgShapeTypeId> registered = registry.registerShapeType(MakeCsgCookTestShapeDesc(entries[0u].shapeName, entries[0u].shaderModule, ViewArenaString(entries[0u].moduleInclude), testArena));
    ASSERT_TRUE(registered.has_value());
    const Expected<GlobalArenaString> selectedIncludeResult = FindRegistryShaderModuleInclude(registry, entries[0u].shaderModule, testArena);
    ASSERT_TRUE(selectedIncludeResult.has_value());
    const GlobalArenaString selectedInclude = selectedIncludeResult.value();
    EXPECT_EQ(ViewArenaString(selectedInclude), ViewArenaString(entries[0u].moduleInclude));
    EXPECT_TRUE(UsesTestArenaAllocator(selectedInclude, testArena));
    EXPECT_EQ(logger.errorCount(), 0u);
    EXPECT_TRUE(RemoveAllIfExists(root).has_value());
}

void VerifyAssetsGraphics_CsgRegistryOwnsExactModuleTextAfterSourceRetirementAndReplacement(){
    TestArena registryArena = TestArena();
    CsgShapeRegistry registry(registryArena.arena);
    const Name shapeName = s_ProjectCsgExactTextShape;
    const Name moduleName = s_ProjectCsgExactTextModule;
    const StringView originalInclude = "project/csg/Generated/LongMixedCaseEvaluatorOwnedByTheRegistry.slangi";
    {
        TestArena sourceArena = TestArena();
        const CsgShapeTypeDesc source = MakeCsgCookTestShapeDesc(shapeName, moduleName, originalInclude, sourceArena);
        ASSERT_TRUE(registry.registerShapeType(source).has_value());
    }
    const Expected<GlobalArenaString> selectedResult = FindRegistryShaderModuleInclude(registry, moduleName, registryArena);
    ASSERT_TRUE(selectedResult.has_value());
    const GlobalArenaString selected = selectedResult.value();
    EXPECT_EQ(ViewArenaString(selected), originalInclude);
    for(u32 index = 0u; index < 32u; ++index){
        const Expected<Name> extraNameResult = DeriveIndexedTestName(Name(s_AssetCaseProjectCsgExactTextExtra), index);
        ASSERT_TRUE(extraNameResult.has_value());
        const CsgShapeTypeDesc extra = MakeCsgCookTestShapeDesc(extraNameResult.value(), s_NameNone, "", registryArena);
        ASSERT_TRUE(registry.registerShapeType(extra).has_value());
    }
    const Expected<CsgShapeTypeInfo> storedResult = registry.findShapeType(shapeName);
    ASSERT_TRUE(storedResult.has_value());
    const CsgShapeTypeInfo stored = storedResult.value();
    EXPECT_EQ(ViewArenaString(stored.desc.shaderModuleInclude), originalInclude);
    EXPECT_TRUE(UsesTestArenaAllocator(stored.desc.shaderModuleInclude, registryArena));
    const StringView replacementInclude = "project/csg/Generated/ReplacementMixedCaseEvaluatorOwnedByTheRegistry.slangi";
    const CsgShapeTypeDesc replacement = MakeCsgCookTestShapeDesc(shapeName, moduleName, replacementInclude, registryArena);
    ASSERT_TRUE(registry.registerShapeType(replacement, true).has_value());
    const Expected<GlobalArenaString> currentResult = FindRegistryShaderModuleInclude(registry, moduleName, registryArena);
    ASSERT_TRUE(currentResult.has_value());
    EXPECT_EQ(ViewArenaString(currentResult.value()), replacementInclude);
    EXPECT_EQ(ViewArenaString(selected), originalInclude);
    EXPECT_EQ(ViewArenaString(stored.desc.shaderModuleInclude), originalInclude);
}

void VerifyAssetsGraphics_CsgRegistryRejectsQuotedIncludeControlBytesWithoutReplacingPublishedState(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    CsgShapeRegistry registry(testArena.arena);
    const Name shapeName = s_ProjectCsgControlByteShape;
    const Name moduleName = s_ProjectCsgControlByteModule;
    const StringView originalInclude = "project/csg/Generated/OriginalEvaluator.slangi";
    const Expected<CsgShapeTypeId> original = registry.registerShapeType(MakeCsgCookTestShapeDesc(shapeName, moduleName, originalInclude, testArena));
    ASSERT_TRUE(original.has_value());
    const u64 revision = registry.revision();
    const usize count = registry.shapeTypeCount();
    Array<u8, 6u> forbiddenBytes = Array<u8, 6u>();
    forbiddenBytes[0u] = 0u;
    forbiddenBytes[1u] = 13u;
    forbiddenBytes[2u] = 10u;
    forbiddenBytes[3u] = 34u;
    forbiddenBytes[4u] = 59u;
    forbiddenBytes[5u] = 61u;
    for(in u8 forbidden : forbiddenBytes){
        CsgShapeTypeDesc replacement = MakeCsgCookTestShapeDesc(shapeName, moduleName, originalInclude, testArena);
        AppendByteToShapeModuleInclude(replacement, forbidden);
        replacement.shaderModuleInclude.append("InjectedEvaluator.slangi");
        EXPECT_FALSE(registry.registerShapeType(replacement, true).has_value());
        EXPECT_EQ(registry.revision(), revision);
        EXPECT_EQ(registry.shapeTypeCount(), count);
        const Expected<CsgShapeTypeInfo> retainedShape = registry.findShapeType(shapeName);
        ASSERT_TRUE(retainedShape.has_value());
        EXPECT_EQ(retainedShape.value().id, original.value());
        EXPECT_EQ(ViewArenaString(retainedShape.value().desc.shaderModuleInclude), originalInclude);
        const Expected<GlobalArenaString> retainedInclude = FindRegistryShaderModuleInclude(registry, moduleName, testArena);
        ASSERT_TRUE(retainedInclude.has_value());
        EXPECT_EQ(ViewArenaString(retainedInclude.value()), originalInclude);
    }
    EXPECT_EQ(logger.errorCount(), 6u);
}

void VerifyAssetsGraphics_CsgShapeCookRejectsGeneratedModuleIncludeCollisions(){
    if(AssetsGraphicsTestConfigurationName() != "fin")
        return;

    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_ReportOnly);
    TestArena testArena = TestArena();
    const Expected<GraphicsTestPath> rootResult = PrepareCaseRoot(testArena, "csg_module_include_collision");
    ASSERT_TRUE(rootResult.has_value());
    const GraphicsTestPath root = rootResult.value();

    ScratchArena scratchArena(s_ShaderScratchArena);
    CsgShapeCookEntryVector entries(testArena.arena);
    AddCsgShapeCookEntry(Name(s_AssetCaseProjectCsgFirstShape), Name(s_AssetCaseProjectCsgFirstModule), "project/csg/generated/shared.slangi", testArena, entries);
    AddCsgShapeCookEntry(Name(s_AssetCaseProjectCsgSecondShape), Name(s_AssetCaseProjectCsgSecondModule), "project/csg/generated/SHARED.slangi", testArena, entries);
    const b8 emitted = EmitTestCsgShapeModules(JoinGraphicsPath(root, s_CacheDirectory), "tests", entries, scratchArena).has_value();
    EXPECT_FALSE(emitted);
    EXPECT_TRUE(SawCapturedError(logger, "generated include"));
    EXPECT_TRUE(RemoveAllIfExists(root).has_value());
}

void VerifyAssetsGraphics_DecodedShaderIndexOwnsVariantTextAfterEncodedBytesAreOverwritten(){
    TestArena testArena = TestArena();
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    ScratchArena scratchArena(s_AssetCaseTestsAssetsGraphicsBorrowedIndex);
    ShaderArchiveRecordVector records(testArena.arena);
    ShaderArchiveRecord record(testArena.arena);
    record.shaderName = Name(s_AssetCaseProjectShadersBorrowedIndex);
    record.variantName.assign("BORROWED_VARIANT=nontrivial_owned_text");
    record.stage = Name(s_AssetCasePs);
    const Expected<Name> virtualPath = BuildVirtualPathName(record.shaderName, ViewArenaString(record.variantName), record.stage);
    ASSERT_TRUE(virtualPath.has_value());
    record.virtualPathHash = virtualPath.value().hash();
    records.push_back(record);

    const Expected<GraphicsBytes> encodedResult = SerializeTestShaderIndex(records, testArena, scratchArena);
    ASSERT_TRUE(encodedResult.has_value());
    GraphicsBytes encoded = encodedResult.value();
    const Expected<ShaderArchiveRecordVector> decodedResult = DeserializeTestShaderIndex(testArena, encoded);
    ASSERT_TRUE(decodedResult.has_value());
    const ShaderArchiveRecordVector decoded = decodedResult.value();
    ASSERT_EQ(decoded.size(), 1u);
    ZeroFillGraphicsBytes(encoded);
    EXPECT_EQ(ViewArenaString(decoded[0u].variantName), ViewArenaString(record.variantName));
    EXPECT_EQ(decoded[0u].virtualPathHash, record.virtualPathHash);
    EXPECT_EQ(logger.errorCount(), 0u);
}

void VerifyGatherInputs_MissingOutputIsRejectedBeforeInputDiscovery(mut GatherInputs self){
    self.m_options.outputDirectory.clear();
    self.addRawInput("missing-gather-input");
    EXPECT_FALSE(GatherGraphicsAssets(self.m_options, self.m_scratchArena));
    EXPECT_TRUE(SawCapturedError(self.m_logger, "output directory is empty"));
    EXPECT_FALSE(SawCapturedError(self.m_logger, "failed to inspect input"));
    EXPECT_EQ(self.m_logger.errorCount(), 1u);
}

void VerifyGatherInputs_InputListEncodingRejectsUnrepresentablePathsWithoutLosingDuplicates(mut GatherInputs self){
    AssetTestVector<AssetString> validInputs = self.makeInputStrings();
    self.appendInputString("valid path", validInputs);
    self.appendInputString("valid path", validInputs);
    const Expected<ScratchString> encoded = EncodeTestAssetInputList(validInputs, self.m_scratchArena);
    ASSERT_TRUE(encoded.has_value());
    EXPECT_EQ(ViewArenaString(encoded.value()), "valid path\nvalid path\n");

    for(u32 invalidIndex = 0u; invalidIndex < 4u; ++invalidIndex){
        AssetTestVector<AssetString> inputs = self.makeInputStrings();
        self.appendInputString("valid path", inputs);
        self.appendInputString("valid path", inputs);
        StringView invalid = "";
        if(invalidIndex == 1u)
            invalid = "line\nbreak";
        else if(invalidIndex == 2u)
            invalid = "carriage\rreturn";
        else if(invalidIndex == 3u)
            invalid = EmbeddedNulInputPath();
        inputs[1u].assign(invalid);
        EXPECT_FALSE(EncodeTestAssetInputList(inputs, self.m_scratchArena).has_value());
    }
}

void VerifyGatherInputs_IdenticalDuplicatesKeepExactPayloadsWithoutMergeCalls(mut GatherInputs self){
    self.writeInputs("a", 64u, 257u, 7u);
    ASSERT_FALSE(self.hasFatalFailure());
    self.writeInputs("b", 64u, 257u, 7u);
    ASSERT_FALSE(self.hasFatalFailure());
    self.duplicateFirstInput();
    self.enableTestMerge();
    ASSERT_TRUE(GatherGraphicsAssets(self.m_options, self.m_scratchArena));
    EXPECT_EQ(self.mergeCallCount(), 0u);
    self.verifyPayloads(64u, 257u, 7u);
    ASSERT_FALSE(self.hasFatalFailure());
}

void VerifyGatherInputs_ConflictingDuplicatesPreservePublishedVolume(mut GatherInputs self){
    self.writeInputs("a", 4u, 8u, 3u);
    ASSERT_FALSE(self.hasFatalFailure());
    ASSERT_TRUE(GatherGraphicsAssets(self.m_options, self.m_scratchArena));
    self.writeInputs("b", 4u, 8u, 9u);
    ASSERT_FALSE(self.hasFatalFailure());
    EXPECT_FALSE(GatherGraphicsAssets(self.m_options, self.m_scratchArena));
    EXPECT_GT(self.m_logger.errorCount(), 0u);
    self.verifyPayloads(4u, 8u, 3u);
    ASSERT_FALSE(self.hasFatalFailure());
}

void VerifyGatherInputs_DuplicateManifestPathsPreservePublishedVolume(mut GatherInputs self){
    self.writeInputs("a", 1u, 8u, 3u);
    ASSERT_FALSE(self.hasFatalFailure());
    ASSERT_TRUE(GatherGraphicsAssets(self.m_options, self.m_scratchArena));
    const Expected<Name> name = GatherInputAssetName(0u);
    ASSERT_TRUE(name.has_value());
    EXPECT_FALSE(self.writeDuplicateEntryManifestVolume(name.value()));
    EXPECT_GT(self.m_logger.errorCount(), 0u);
    self.verifyPayloads(1u, 8u, 3u);
    ASSERT_FALSE(self.hasFatalFailure());
}

void VerifyGatherInputs_MergedPayloadIdentitySurvivesLaterIdenticalDuplicate(mut GatherInputs self){
    self.writeInputs("a", 1u, 2u, 5u);
    ASSERT_FALSE(self.hasFatalFailure());
    self.writeInputs("b", 1u, 2u, 5u);
    ASSERT_FALSE(self.hasFatalFailure());
    self.writeInputs("c", 1u, 4u, 5u);
    ASSERT_FALSE(self.hasFatalFailure());
    // Equal payloads collapse while the distinct third payload is appended once.
    self.enableTestMerge();
    ASSERT_TRUE(GatherGraphicsAssets(self.m_options, self.m_scratchArena));
    EXPECT_EQ(self.mergeCallCount(), 1u);
    self.verifyPayloads(1u, 6u, 5u);
    ASSERT_FALSE(self.hasFatalFailure());
    self.writeInputs("d", 1u, 6u, 5u);
    ASSERT_FALSE(self.hasFatalFailure());
    self.resetMergeCallCount();
    ASSERT_TRUE(GatherGraphicsAssets(self.m_options, self.m_scratchArena));
    EXPECT_EQ(self.mergeCallCount(), 1u);
    self.verifyPayloads(1u, 6u, 5u);
    ASSERT_FALSE(self.hasFatalFailure());
}

void VerifyMaterialAvboitShaderGenerator_MissingInterfaceRejectsTransparentEntryWithoutChangingShaderNames(){
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_AssetCaseTestsAvboitShaderGeneratorScratch);
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard guard(logger, s_ReportOnly);
    const Expected<GraphicsTestPath> rootResult = PrepareCaseRoot(testArena, "avboit_shader_missing_interface_v2");
    ASSERT_TRUE(rootResult.has_value());
    const GraphicsTestPath root = rootResult.value();

    MaterialCookEntryVector entries(testArena.arena);
    MaterialCookEntry opaqueEntry(testArena.arena);
    opaqueEntry.virtualPath.assign("project/materials/opaque");
    opaqueEntry.surfaceSource.assign("opaque.slang");
    entries.push_back(opaqueEntry);

    MaterialCookEntry transparentEntry(testArena.arena);
    transparentEntry.virtualPath.assign("project/materials/transparent");
    transparentEntry.surfaceSource.assign("transparent.slang");
    transparentEntry.transparent = true;
    entries.push_back(transparentEntry);

    EXPECT_FALSE(EmitAvboitAccumulateShaders(root, "test", testArena, scratchArena, entries));
    EXPECT_FALSE(EmitAvboitOccupancyShaders(root, "test", testArena, scratchArena, entries));
    EXPECT_FALSE(EmitAvboitExtinctionShaders(root, "test", testArena, scratchArena, entries));
    EXPECT_TRUE(entries[0u].avboitAccumulatePixelShaderName.empty());
    EXPECT_TRUE(entries[0u].avboitOccupancyPixelShaderName.empty());
    EXPECT_TRUE(entries[0u].avboitExtinctionPixelShaderName.empty());
    EXPECT_TRUE(entries[1u].avboitAccumulatePixelShaderName.empty());
    EXPECT_TRUE(entries[1u].avboitOccupancyPixelShaderName.empty());
    EXPECT_TRUE(entries[1u].avboitExtinctionPixelShaderName.empty());
    EXPECT_EQ(logger.errorCount(), 3u);
    EXPECT_TRUE(SawCapturedError(logger, "project/materials/transparent"));
    EXPECT_FALSE(SawCapturedError(logger, "project/materials/opaque"));
}


