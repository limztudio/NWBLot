#include <impl/assets_graphics/shadow_subsystem.adhd>
#include <impl/ecs_render/raytrace/raytracing_system.adhd>
#include <impl/ecs_render/shadow/hardware_transparent_shadow_resources.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>
#include <impl/ecs_render/shadow/quality_settings.adhd>
#include <impl/ecs_render/shadow/rt_shadow_state.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Name s_HardwareTransparentShadowDebugName = "ECSRender_HardwareTransparentShadow";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ShadowHardwareTransparentGrid2D{
    public u32 groupsX = 0u;
    public u32 groupsY = 0u;
}

ShadowHardwareTransparentGrid2D ResolveHardwareTransparentDispatchGrid(in u32 width, in u32 height, in u32 receiverFactor, in u32 groupSize){
    const u32 halfWidth = DivideUp(width, receiverFactor);
    const u32 halfHeight = DivideUp(height, receiverFactor);
    ShadowHardwareTransparentGrid2D grid;
    grid.groupsX = DivideUp(halfWidth, groupSize);
    grid.groupsY = DivideUp(halfHeight, groupSize);
    return grid;
}

b8 IsShadowLightSlotEnabled(in u32 softShadowSlotMask, in u32 slot){
    return (softShadowSlotMask & (1u << slot)) != 0u;
}

Array<u32, 4u> MakeEmptyHardwareTransparentOverflowArgs(){
    Array<u32, 4u> emptyArgs;
    emptyArgs[0u] = 0u;
    emptyArgs[1u] = 1u;
    emptyArgs[2u] = 1u;
    emptyArgs[3u] = 0u;
    return emptyArgs;
}

void PopulateHardwareTransparentSlotSamplePush(in u32 lightSlot, in u32 sampleIndex, mut HardwareTransparentShadowPushConstants outPush){
    outPush.lightSlot = lightSlot;
    outPush.sampleIndex = sampleIndex;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets/graphics/shadow/hardware_transparent_binding_slots.h>"), cpp_name("NWB_HW_TRANSPARENT_PUSH_CONSTANT_BYTES")]
extern const u32 s_ShaderHwTransparentPushConstantBytes;

[cpp_header("<impl/assets/graphics/shadow/hardware_transparent_binding_slots.h>"), cpp_name("NWB_HW_TRANSPARENT_WORDS_PER_RAY")]
extern const u32 s_ShaderHwTransparentWordsPerRay;

[cpp_header("<impl/assets/graphics/shadow/hardware_transparent_binding_slots.h>"), cpp_name("NWB_HW_TRANSPARENT_OVERFLOW_ARGS_WORDS")]
extern const u32 s_ShaderHwTransparentOverflowArgsWords;

[cpp_header("<impl/assets/graphics/shadow/hardware_transparent_binding_slots.h>"), cpp_name("NWB_HW_TRANSPARENT_GROUP_SIZE")]
extern const u32 s_ShaderHwTransparentGroupSize;

static_assert(size_of<HardwareTransparentShadowPushConstants>() == s_ShaderHwTransparentPushConstantBytes);
static_assert(offset_of<HardwareTransparentShadowPushConstants>(receiverFactor) == s_HwTransparentReceiverFactorByteOffset);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 HardwareTransparentShadowResources::prepareHardwareTransparentShadowResources(mut DeferredFrameTargets targets){
    mut HardwareTransparentShadowState state = this.m_state;
    state.m_ready = false;
    if(state.m_pipelineFailed)
        return false;
    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized() || !heap.hasAccelStructLayout())
        return false;
    if(!EnsurePushConstantBindingLayout(device, sizeof(HardwareTransparentShadowPushConstants), ShaderTypeMask::Compute, state.m_bindingLayout)){
        error("RendererSystem: failed to create hardware transparent-shadow binding layout");
        state.m_pipelineFailed = true;
        return false;
    }
    for(u32 i = 0u; i < state.m_pipelines.size(); ++i){
        if(state.m_pipelines[i].valid())
            continue;
        if(!this.m_shaderSystem.loadShader<ComputeShader, ShadowSubsystem>(
            lambda[in i](in ShadowSubsystem subsystem) -> AssetRef<ComputeShader>{
                if(i == s_HwTransparentGatherStage)
                    return subsystem.hardwareTransparentGatherCs;
                if(i == s_HwTransparentEvaluateStage)
                    return subsystem.hardwareTransparentEvaluateCs;
                return subsystem.hardwareTransparentOverflowCs;
            },
            s_ShaderArchiveDefaultVariant,
            s_HardwareTransparentShadowDebugName,
            state.m_shaders[i]
        )){
            state.m_pipelineFailed = true;
            return false;
        }
        if(!CreateHeapComputePipeline(device, state.m_shaders[i], state.m_bindingLayout, true, state.m_pipelines[i])){
            error("RendererSystem: failed to create hardware transparent-shadow pipeline {}", i);
            state.m_pipelineFailed = true;
            return false;
        }
    }

    u32 pixels = 0u;
    Array<u64, 3u> sizes;
    if(!ValidateHardwareTransparentShadowScratchExtent(
        targets.width,
        targets.height,
        targets.shadowReceiverFactor,
        s_ShaderHwTransparentWordsPerRay,
        s_ShaderHwTransparentOverflowArgsWords,
        pixels,
        sizes
    ))
        return false;
    if(pixels > state.m_pixelsCapacity){
        Array<Name, 3u> names;
        names[0u] = s_HardwareShadowCrossings;
        names[1u] = s_HardwareShadowOverflowList;
        names[2u] = s_HardwareShadowOverflowArgs;
        Array<BufferHandle, s_HwTransparentScratchBufferCount> buffers;
        Array<GpuDescriptorHandle, s_HwTransparentScratchBufferCount> descriptors;
        GpuDescriptorRetirementGuard retireUnpublished(heap, Span<GpuDescriptorHandle>(descriptors));
        for(u32 i = 0u; i < buffers.size(); ++i){
            BufferDesc desc;
            desc
                .setByteSize(sizes[i])
                .setStructStride(sizeof(u32))
                .setCanHaveUAVs(true)
                .setIsDrawIndirectArgs(i == s_HwTransparentOverflowArgsBufferIndex)
                .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
                .setDebugName(names[i])
                .enableAutomaticStateTracking(ResourceStates::UnorderedAccess)
            ;
            const Expected<BufferHandle> buffersResult = this.m_graphics.createBuffer(desc);
            if(buffersResult.has_value())
                buffers[i] = buffersResult.value();
            else
                buffers[i].reset();
            if(!buffersResult.has_value()){
                error("RendererSystem: failed to create hardware transparent-shadow scratch {}", i);
                return false;
            }
            const Expected<GpuDescriptorHandle> descriptor = RegisterHeapBuffer(heap, buffers[i].deref(), GpuDescriptorClass::StorageBuffer, true);
            if(!descriptor.has_value()){
                error("RendererSystem: failed to create hardware transparent-shadow scratch {}", i);
                return false;
            }
            descriptors[i] = descriptor.value();
        }
        RetireDescriptor(heap, state.m_crossingsHeapHandle);
        RetireDescriptor(heap, state.m_overflowListHeapHandle);
        RetireDescriptor(heap, state.m_overflowArgsHeapHandle);
        state.m_crossingsBuffer = buffers[s_HwTransparentCrossingsBufferIndex];
        state.m_overflowListBuffer = buffers[s_HwTransparentOverflowListBufferIndex];
        state.m_overflowArgsBuffer = buffers[s_HwTransparentOverflowArgsBufferIndex];
        state.m_crossingsHeapHandle = descriptors[s_HwTransparentCrossingsBufferIndex];
        state.m_overflowListHeapHandle = descriptors[s_HwTransparentOverflowListBufferIndex];
        state.m_overflowArgsHeapHandle = descriptors[s_HwTransparentOverflowArgsBufferIndex];
        for(usize i = 0u; i < descriptors.size(); ++i)
            descriptors[i] = GpuDescriptorHandleInvalid();
        state.m_pixelsCapacity = cast<u32>(pixels);
    }
    state.m_ready = true;
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RendererRayTracingSystem::hardwareTransparentShadowReady()const{
    return this.m_shadowVisibilityHardwareSupported && this.m_rayTracingState.m_hardwareTransparentShadow.m_ready;
}

void BindHardwareTransparentShadowStage(in HardwareTransparentShadowState state, in u32 stage, in b8 indirect, in GpuDescriptorHandle tlas, in HardwareTransparentShadowPushConstants push, mut CommandList commandList, mut GpuDescriptorHeap heap){
    ComputeState compute;
    compute.setPipeline(state.m_pipelines[stage].deref());
    if(indirect)
        compute.setIndirectParams(state.m_overflowArgsBuffer.deref());
    commandList.setComputeState(compute);
    heap.bindCompute(commandList, state.m_pipelines[stage].deref(), tlas);
    commandList.setPushConstants(push);
}

void RendererRayTracingSystem::dispatchHardwareTransparentShadow(mut CommandList commandList, mut DeferredFrameTargets targets, in u32 frameIndex){
    mut HardwareTransparentShadowState state = this.m_rayTracingState.m_hardwareTransparentShadow;
    assert(state.m_ready);
    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    const ShadowHardwareTransparentGrid2D dispatchGrid = ResolveHardwareTransparentDispatchGrid(
        targets.width,
        targets.height,
        cast<u32>(targets.shadowReceiverFactor),
        cast<u32>(s_ShaderHwTransparentGroupSize)
    );
    const u32 groupsX = dispatchGrid.groupsX;
    const u32 groupsY = dispatchGrid.groupsY;
    const u32 sampleCount = this.transparentShadowSampleCount();
    HardwareTransparentShadowPushConstants push = ResolveHardwareTransparentShadowPushConstants(
        targets.width,
        targets.height,
        frameIndex,
        sampleCount,
        targets.bindless.slotsBufferDescriptor.slot(),
        this.m_rayTracingState.sceneBvh.m_rayTraceMaterialContextSlotsHeapHandle.slot(),
        state.m_crossingsHeapHandle.slot(),
        state.m_overflowListHeapHandle.slot(),
        state.m_overflowArgsHeapHandle.slot(),
        targets.bindless.transparentSoftHalfStorage.slot(),
        targets.shadowReceiverFactor
    );
    for(u32 slot = 0u; slot < s_SceneShadowSlotCount; ++slot){
        if(!IsShadowLightSlotEnabled(this.m_rayTracingState.softShadow.m_softShadowSlotMask, slot))
            continue;
        for(u32 sample = 0u; sample < sampleCount; ++sample){
            PopulateHardwareTransparentSlotSamplePush(slot, sample, push);
            const Array<u32, 4u> emptyArgs = MakeEmptyHardwareTransparentOverflowArgs();
            if(!commandList.tryWriteBuffer(state.m_overflowArgsBuffer.deref(), emptyArgs, 0u)){
                error("RendererSystem: failed to reset hardware transparent-shadow continuation arguments");
                return;
            }
            commandList.setBufferState(state.m_crossingsBuffer.deref(), ResourceStates::UnorderedAccess, true);
            commandList.setBufferState(state.m_overflowListBuffer.deref(), ResourceStates::UnorderedAccess, true);
            commandList.setBufferState(state.m_overflowArgsBuffer.deref(), ResourceStates::UnorderedAccess);
            commandList.setTextureState(targets.transparentSoftHalf.deref(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess, true);
            commandList.commitBarriers();
            {
                GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeShadowTransparentGather, device, commandList);

                BindHardwareTransparentShadowStage(state, s_HwTransparentGatherStage, false, this.m_rayTracingState.sceneBvh.m_tlasHeapHandle, push, commandList, heap);
                commandList.dispatch(groupsX, groupsY, 1u);
            }
            commandList.setBufferState(state.m_crossingsBuffer.deref(), ResourceStates::ShaderResource);
            commandList.setBufferState(state.m_overflowListBuffer.deref(), ResourceStates::ShaderResource);
            commandList.setBufferState(state.m_overflowArgsBuffer.deref(), ResourceStates::IndirectArgument | ResourceStates::ShaderResource);
            commandList.commitBarriers();
            {
                GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeShadowTransparentEvaluate, device, commandList);

                BindHardwareTransparentShadowStage(state, s_HwTransparentEvaluateStage, false, this.m_rayTracingState.sceneBvh.m_tlasHeapHandle, push, commandList, heap);
                commandList.dispatch(groupsX, groupsY, 1u);
            }
            commandList.setTextureState(targets.transparentSoftHalf.deref(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess, true);
            commandList.commitBarriers();
            {
                GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeShadowTransparentContinuation, device, commandList);

                BindHardwareTransparentShadowStage(state, s_HwTransparentOverflowStage, true, this.m_rayTracingState.sceneBvh.m_tlasHeapHandle, push, commandList, heap);
                commandList.dispatchIndirect(0u);
            }
        }
    }
    if(this.m_rayTracingState.softShadow.m_softShadowSlotMask != 0u)
        this.reportTransparentShadowSampling(sampleCount);
    commandList.setBufferState(state.m_crossingsBuffer.deref(), ResourceStates::UnorderedAccess);
    commandList.setBufferState(state.m_overflowListBuffer.deref(), ResourceStates::UnorderedAccess);
    commandList.setBufferState(state.m_overflowArgsBuffer.deref(), ResourceStates::UnorderedAccess);
    commandList.commitBarriers();
    LogHardwareTransparentShadowDispatchIfNeeded(
        targets.width,
        targets.height,
        this.m_rayTracingState.sceneBvh.m_tlasInstanceCount,
        state.m_dispatchLogged
    );
}


