    if(
        !AssignDeferredStorage2DArray(this.m_heap, this.m_targets.shadowCoarseTransmittance, this.m_targets.shadowCoarseTransmittanceFormat, this.m_targets.bindless.shadowCoarseTransmittanceStorage)
        || !AssignDeferredSampledAndStorage2D(this.m_heap, this.m_targets.shadowSoftGeometry, this.m_targets.shadowSoftGeometryFormat, this.m_targets.bindless.shadowSoftGeometry, this.m_targets.bindless.shadowSoftGeometryStorage)
        || !AssignDeferredSampledAndStorage2D(this.m_heap, this.m_targets.shadowSoftGeometryPrev, this.m_targets.shadowSoftGeometryFormat, this.m_targets.bindless.shadowSoftGeometryPrev, this.m_targets.bindless.shadowSoftGeometryPrevStorage)
        || !AssignDeferredSampledAndStorageShadowArray(this.m_heap, this.m_targets.shadowSoftHalfA, this.m_targets.shadowSoftFormat, this.m_targets.bindless.shadowSoftHalfA, this.m_targets.bindless.shadowSoftHalfAStorage)
        || !AssignDeferredSampledAndStorageShadowArray(this.m_heap, this.m_targets.shadowSoftHalfB, this.m_targets.shadowSoftFormat, this.m_targets.bindless.shadowSoftHalfB, this.m_targets.bindless.shadowSoftHalfBStorage)
        || !AssignDeferredSampledAndStorageShadowArray(this.m_heap, this.m_targets.shadowHistA, this.m_targets.shadowSoftFormat, this.m_targets.bindless.shadowHistA, this.m_targets.bindless.shadowHistAStorage)
        || !AssignDeferredSampledAndStorageShadowArray(this.m_heap, this.m_targets.shadowHistB, this.m_targets.shadowSoftFormat, this.m_targets.bindless.shadowHistB, this.m_targets.bindless.shadowHistBStorage)
        || !AssignDeferredSampledAndStorageShadowArray(this.m_heap, this.m_targets.shadowMomentsA, this.m_targets.shadowSoftFormat, this.m_targets.bindless.shadowMomentsA, this.m_targets.bindless.shadowMomentsAStorage)
        || !AssignDeferredSampledAndStorageShadowArray(this.m_heap, this.m_targets.shadowMomentsB, this.m_targets.shadowSoftFormat, this.m_targets.bindless.shadowMomentsB, this.m_targets.bindless.shadowMomentsBStorage)
        || !AssignDeferredSampledAndStorageShadowArray(this.m_heap, this.m_targets.transparentSoftHalf, this.m_targets.shadowSoftFormat, this.m_targets.bindless.transparentSoftHalf, this.m_targets.bindless.transparentSoftHalfStorage)
        || !AssignDeferredSampledAndStorageShadowArray(this.m_heap, this.m_targets.transparentHistA, this.m_targets.shadowSoftFormat, this.m_targets.bindless.transparentHistA, this.m_targets.bindless.transparentHistAStorage)
        || !AssignDeferredSampledAndStorageShadowArray(this.m_heap, this.m_targets.transparentHistB, this.m_targets.shadowSoftFormat, this.m_targets.bindless.transparentHistB, this.m_targets.bindless.transparentHistBStorage)
        || !AssignDeferredSampledAndStorageShadowArray(this.m_heap, this.m_targets.transparentMomentsA, this.m_targets.shadowSoftFormat, this.m_targets.bindless.transparentMomentsA, this.m_targets.bindless.transparentMomentsAStorage)
        || !AssignDeferredSampledAndStorageShadowArray(this.m_heap, this.m_targets.transparentMomentsB, this.m_targets.shadowSoftFormat, this.m_targets.bindless.transparentMomentsB, this.m_targets.bindless.transparentMomentsBStorage)
    )
        return MakeUnexpected(Failure());
    return Expected<void>();
}

void RendererDeferredSystem::resetDeferredBindlessFrameResources(mut DeferredFrameTargets targets){
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    if(heap.isInitialized()){
        heap.free(targets.bindless.slotsBufferDescriptor);
        heap.free(targets.bindless.gbufferBaseColor);
        heap.free(targets.bindless.gbufferNormal);
        heap.free(targets.bindless.gbufferWorldPosition);
        heap.free(targets.bindless.gbufferSpecularRoughness);
        heap.free(targets.bindless.gbufferDepth);
        heap.free(targets.bindless.shadowVisibility);
        heap.free(targets.bindless.shadowVisibilityStorage);
        heap.free(targets.bindless.causticIrradiance);
        heap.free(targets.bindless.causticIrradianceStorage);
        heap.free(targets.bindless.surfelIrradiance);
        heap.free(targets.bindless.surfelIrradianceStorage);
        heap.free(targets.bindless.surfelIrradianceHalf);
        heap.free(targets.bindless.surfelIrradianceHalfStorage);
        heap.free(targets.bindless.sampler);
        heap.free(targets.bindless.opaqueColor);
        heap.free(targets.bindless.opaqueColorStorage);
        heap.free(targets.bindless.compositeColor);
        heap.free(targets.bindless.compositeColorStorage);
        heap.free(targets.bindless.avboitAccumColor);
        heap.free(targets.bindless.avboitAccumExtinction);
        heap.free(targets.bindless.refractionDepth);
        heap.free(targets.bindless.refractionNormalIor);
        heap.free(targets.bindless.refractionTintCoverage);
        heap.free(targets.bindless.refractionInstance);
        heap.free(targets.bindless.refractionSpecularRoughness);
        heap.free(targets.bindless.refractionResolve);
        heap.free(targets.bindless.avboitForegroundColor);
        heap.free(targets.bindless.avboitForegroundExtinction);
        heap.free(targets.bindless.refractionResolveStorage);
        heap.free(targets.bindless.avboitTransmittance);
        heap.free(targets.bindless.avboitLinearSampler);
        heap.free(targets.bindless.sceneShading);
        heap.free(targets.bindless.lightList);
        heap.free(targets.bindless.causticAccumulator);
        heap.free(targets.bindless.causticAccumulatorStorage);
        heap.free(targets.bindless.causticHistory);
        heap.free(targets.bindless.causticHistoryStorage);
        heap.free(targets.bindless.causticResolveHalf);
        heap.free(targets.bindless.causticResolveHalfStorage);
        heap.free(targets.bindless.causticResolveGeometry);
        heap.free(targets.bindless.causticResolveGeometryStorage);
        heap.free(targets.bindless.shadowCoarseTransmittanceStorage);
        heap.free(targets.bindless.shadowSoftGeometry);
        heap.free(targets.bindless.shadowSoftGeometryStorage);
        heap.free(targets.bindless.shadowSoftGeometryPrev);
        heap.free(targets.bindless.shadowSoftGeometryPrevStorage);
        heap.free(targets.bindless.shadowSoftHalfA);
        heap.free(targets.bindless.shadowSoftHalfAStorage);
        heap.free(targets.bindless.shadowSoftHalfB);
        heap.free(targets.bindless.shadowSoftHalfBStorage);
        heap.free(targets.bindless.shadowHistA);
        heap.free(targets.bindless.shadowHistAStorage);
        heap.free(targets.bindless.shadowHistB);
        heap.free(targets.bindless.shadowHistBStorage);
        heap.free(targets.bindless.shadowMomentsA);
        heap.free(targets.bindless.shadowMomentsAStorage);
        heap.free(targets.bindless.shadowMomentsB);
        heap.free(targets.bindless.shadowMomentsBStorage);
        heap.free(targets.bindless.transparentSoftHalf);
        heap.free(targets.bindless.transparentSoftHalfStorage);
        heap.free(targets.bindless.transparentHistA);
        heap.free(targets.bindless.transparentHistAStorage);
        heap.free(targets.bindless.transparentHistB);
        heap.free(targets.bindless.transparentHistBStorage);
        heap.free(targets.bindless.transparentMomentsA);
        heap.free(targets.bindless.transparentMomentsAStorage);
        heap.free(targets.bindless.transparentMomentsB);
        heap.free(targets.bindless.transparentMomentsBStorage);
        heap.free(targets.bindless.csgCapBackNormal);
        heap.free(targets.bindless.csgIntervalDepth);
        heap.free(targets.bindless.csgIntervalId);
        heap.free(targets.bindless.csgReceiverEventData);
        heap.free(targets.bindless.csgReceiverEventCount);
        heap.free(targets.bindless.csgReceiverSpanData);
        heap.free(targets.bindless.csgReceiverSpanCount);
        heap.free(targets.bindless.csgRemovedIntervalDepth);
        heap.free(targets.bindless.csgRemovedIntervalCapNormal);
        heap.free(targets.bindless.csgRemovedIntervalData);
        heap.free(targets.bindless.csgRemovedIntervalCount);
    }
    targets.bindless = DeferredBindlessFrameResources();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ResetCreatedDeferredFrameTargets(
    mut RendererAvboitSystem avboit,
    mut RendererDeferredSystem deferred,
    mut DeferredFrameTargets createdTargets
){
    avboit.resetAvboitFrameTargets(createdTargets.avboit);
    deferred.resetDeferredFrameTargets(createdTargets);
}

b8 RendererDeferredSystem::createDeferredBindlessFrameResources(mut DeferredFrameTargets targets, mut RhiSampler avboitLinearSampler){
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    if(!heap.isInitialized()){
        LogDeferredBindlessHeapMissing();
        return false;
    }
    assert(this.m_deferredState.m_sampler.valid());
    assert(this.m_deferredState.m_sceneShadingBuffer.valid());
    assert(this.m_deferredState.m_lightBuffer.valid());
    assert(targets.csgIntervalTargetsValid());

    mut DeferredBindlessFrameResources bindless = targets.bindless;
    DeferredBindlessDescriptorSources sources(
        this.m_deferredState.m_sampler.deref(),
        avboitLinearSampler,
        this.m_deferredState.m_sceneShadingBuffer.deref(),
        this.m_deferredState.m_lightBuffer.deref()
    );
    DeferredBindlessDescriptorRegistrar registrar(heap, targets, sources);
    if(!registrar.registerAll().has_value()){
        LogDeferredBindlessRegistrationFailed();
        this.resetDeferredBindlessFrameResources(targets);
        return false;
    }

    bindless.slots = DeferredBindlessSlotsBuilder().build(
        bindless.gbufferBaseColor.slot(),
        bindless.gbufferNormal.slot(),
        bindless.gbufferWorldPosition.slot(),
        bindless.gbufferDepth.slot(),
        bindless.shadowVisibility.slot(),
        bindless.causticIrradiance.slot(),
        bindless.surfelIrradiance.slot(),
        bindless.sampler.slot(),
        bindless.opaqueColor.slot(),
        bindless.opaqueColorStorage.slot(),
        bindless.compositeColor.slot(),
        bindless.compositeColorStorage.slot(),
        bindless.avboitAccumColor.slot(),
        bindless.avboitAccumExtinction.slot(),
        bindless.refractionDepth.slot(),
        bindless.refractionNormalIor.slot(),
        bindless.refractionTintCoverage.slot(),
        bindless.refractionInstance.slot(),
        bindless.refractionResolve.slot(),
        bindless.avboitForegroundColor.slot(),
        bindless.avboitForegroundExtinction.slot(),
        bindless.refractionResolveStorage.slot(),
        bindless.avboitTransmittance.slot(),
        bindless.avboitLinearSampler.slot(),
        bindless.sceneShading.slot(),
        bindless.lightList.slot(),
        bindless.csgCapBackNormal.slot(),
        bindless.csgIntervalDepth.slot(),
        bindless.csgIntervalId.slot(),
        bindless.csgReceiverEventData.slot(),
        bindless.csgReceiverEventCount.slot(),
        bindless.csgReceiverSpanData.slot(),
        bindless.csgReceiverSpanCount.slot(),
        bindless.csgRemovedIntervalDepth.slot(),
        bindless.csgRemovedIntervalCapNormal.slot(),
        bindless.csgRemovedIntervalData.slot(),
        bindless.csgRemovedIntervalCount.slot()
    );

    BufferDesc slotsBufferDesc;
    slotsBufferDesc
        .setByteSize(sizeof(DeferredBindlessResourceSlots))
        .setIsConstantBuffer(true)
        .setDebugName(s_DeferredBindlessSlotsBufferName)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .enableAutomaticStateTracking(ResourceStates::ConstantBuffer)
    ;
    const Expected<BufferHandle> slotsBufferResult = this.m_graphics.createBuffer(slotsBufferDesc);
    if(!slotsBufferResult.has_value()){
        bindless.slotsBuffer.reset();
        LogDeferredBindlessSlotBufferCreateFailed();
        this.resetDeferredBindlessFrameResources(targets);
        return false;
    }
    bindless.slotsBuffer = slotsBufferResult.value();

    if(!TryAdoptDescriptor(RegisterConstantBuffer(heap, bindless.slotsBuffer), bindless.slotsBufferDescriptor)){
        LogDeferredBindlessSlotBufferRegisterFailed();
        this.resetDeferredBindlessFrameResources(targets);
        return false;
    }

    return true;
}

Expected<DeferredFrameTargets> DeferredFrameTargetBuilder::build(
    in u32 width,
    in u32 height,
    in u32 shadowReceiverFactor,
    in u32 surfelResolveFactor
){
    Expected<DeferredFrameTargets> createdTargetsResult = this.m_deferred.createDeferredFrameTargets(width, height);
    if(!createdTargetsResult.has_value())
        return MakeUnexpected(Failure());
    DeferredFrameTargets createdTargets = createdTargetsResult.value();
    if(!this.m_avboit.createAvboitSampler()){
        ResetCreatedDeferredFrameTargets(this.m_avboit, this.m_deferred, createdTargets);
        return MakeUnexpected(Failure());
    }
    if(!this.m_avboit.createAvboitFrameTargets(createdTargets)){
        ResetCreatedDeferredFrameTargets(this.m_avboit, this.m_deferred, createdTargets);
        return MakeUnexpected(Failure());
    }
    if(!this.m_csg.createCsgPeelTargets(createdTargets)){
        ResetCreatedDeferredFrameTargets(this.m_avboit, this.m_deferred, createdTargets);
        return MakeUnexpected(Failure());
    }
    createdTargets.shadowReceiverFactor = shadowReceiverFactor;
    ShadowVisibilityTargetBuilder shadowVisibilityTargetBuilder(this.m_graphics, this.m_rayTracingState);
    if(!shadowVisibilityTargetBuilder.build(createdTargets)){
        ResetCreatedDeferredFrameTargets(this.m_avboit, this.m_deferred, createdTargets);
        return MakeUnexpected(Failure());
    }
    if(!this.m_rayTracing.createCausticTargets(createdTargets)){
        ResetCreatedDeferredFrameTargets(this.m_avboit, this.m_deferred, createdTargets);
        return MakeUnexpected(Failure());
    }
    createdTargets.surfelResolveFactor = surfelResolveFactor;
    if(!this.m_rayTracing.createSurfelTargets(createdTargets)){
        ResetCreatedDeferredFrameTargets(this.m_avboit, this.m_deferred, createdTargets);
        return MakeUnexpected(Failure());
    }
    if(!this.m_deferred.createDeferredFrameTargetResources(createdTargets, this.m_avboit.linearSampler())){
        ResetCreatedDeferredFrameTargets(this.m_avboit, this.m_deferred, createdTargets);
        return MakeUnexpected(Failure());
    }
    if(!this.m_avboit.registerAvboitFrameTargetDescriptors(createdTargets, createdTargets.avboit)){
        ResetCreatedDeferredFrameTargets(this.m_avboit, this.m_deferred, createdTargets);
        return MakeUnexpected(Failure());
    }
    return createdTargets;
}


