    public b8 updateBodyMass(in BodyId bodyId){
        if(!this.isValidBody(bodyId))
            return false;
        this.updateBodyMassInternal(bodyId.index);
        return true;
    }

    public void flushDirtyBodyMasses(){
        if(!this.m_hasDirtyBodyMass)
            return;
        for(u32 i = 0u; i < this.m_bodies.size(); ++i){
            if(this.m_bodies[i].alive && (this.m_bodies[i].flags & cast<u32>(BodyFlags::DirtyMass)) != 0u)
                this.updateBodyMassInternal(i);
        }
        this.m_hasDirtyBodyMass = false;
    }

    public b8 setBodyMassData(in BodyId bodyId, in MassData massData){
        if(!this.isValidBody(bodyId))
            return false;
        if(this.m_bodies[bodyId.index].type != BodyType::Dynamic)
            return false;
        const f32 massVal = massData.mass();
        const VectorSingle massCenter = massData.center();
        if(
            !IsFinite(massVal)
            || massVal <= 0.0f
            || !IsFiniteVec3(massCenter)
            || !IsFiniteVec3(VectorSingle(massData.inertia.row0))
            || !IsFiniteVec3(VectorSingle(massData.inertia.row1))
            || !IsFiniteVec3(VectorSingle(massData.inertia.row2))
        )
            return false;

        if(this.m_bodies[bodyId.index].setIndex != s_DisabledSetIndex){
            if(this.m_bodies[bodyId.index].setIndex >= 3u)
                this.wakeBody(bodyId);
            this.wakeBodyNeighbors(bodyId.index);
        }

        mut Body body = this.m_bodies[bodyId.index];
        mut BodySim sim = this.m_solverSets[body.setIndex].sims[body.localIndex];
        const VectorSingle worldCenter = TransformPoint(sim.transform, massCenter);
        body.mass = massVal;
        sim.setInvMass(1.0f / massVal);
        sim.setLocalCenter(massCenter);
        sim.setCenter(worldCenter);
        sim.setCenter0(worldCenter);
        sim.invInertiaLocal = InvertSymMat3(SymMat3FromMat3(massData.inertia));
        sim.invInertiaWorld = RotateSymMat3(VectorSingle(sim.transform.rotation), sim.invInertiaLocal);
        this.updateBodyExtentsFromShapes(body, sim);
        body.flags &= ~cast<u32>(BodyFlags::DirtyMass);
        this.syncBodyFlagsToSimAndState(bodyId.index);
        if(body.setIndex != s_AwakeSetIndex)
            ++this.m_topologyVersion;
        return true;
    }

    public Expected<MassData> tryGetBodyMassData(in BodyId bodyId)const{
        if(!this.isValidBody(bodyId))
            return MakeUnexpected(Failure());
        in Body body = this.m_bodies[bodyId.index];
        in BodySim sim = this.m_solverSets[body.setIndex].sims[body.localIndex];
        MassData outMass;
        outMass.setCenterMass(sim.localCenter(), body.mass);
        outMass.inertia = Mat3FromSymMat3(InvertSymMat3(sim.invInertiaLocal));
        return outMass;
    }

