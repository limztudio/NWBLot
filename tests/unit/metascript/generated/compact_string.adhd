usize StepSubstrArg(mut i32 argCounter, in usize value){
    ++argCounter;
    return value;
}

String ExtractLongStringSubstrOnce(mut i32 recvCounter, mut i32 posCounter, mut i32 countCounter){
    auto sub = StepAndMakeLongString(recvCounter).substr(
        StepSubstrArg(posCounter, 10u),
        StepSubstrArg(countCounter, 72u)
    );
    return sub;
}

CompactString ExtractCompactSubstr(in CompactString value, in usize pos, in usize count){
    auto fullCopy = value.substr();
    auto sliced = fullCopy.substr(pos, count);
    return sliced;
}

i32 SelectByteOverload(in u8 value){
    return 1000 + cast<i32>(value);
}

i32 SelectByteOverload(in i32 value){
    return -1000 + value;
}

i32 SelectByteSignedness(in u8 value){
    return 2000 + cast<i32>(value);
}

i32 SelectByteSignedness(in i8 value){
    return -2000 + cast<i32>(value);
}

void IncrementMutableByte(mut u8 target){
    target += 1u;
}

u32 ExerciseHighByteStringOps(in StringView viewValue, in CompactString compactValue){
    auto vf = viewValue.front();
    auto vb = viewValue.back();
    auto cf = compactValue.front();
    auto cb = compactValue.back();
    u32 sum = 0u;
    if(vf > 0x7fu && vf == 0x80u && vb == 0xffu && cf == 0x80u && cb == 0xfeu){
        sum += cast<u32>(vf) + cast<u32>(vb) + cast<u32>(cf) + cast<u32>(cb);
    }
    sum += cast<u32>(SelectByteOverload(viewValue.front()));
    sum += cast<u32>(SelectByteSignedness(compactValue.back()));

    String owned = String(viewValue);
    owned.front() >>= 1u;
    owned.back() = 0x80u;
    u8 postInc = owned.back()++;
    IncrementMutableByte(owned[1u]);
    if(postInc == 0x80u && owned.front() == 0x40u && owned.back() == 0x81u && owned[1u] == 0x80u){
        sum += cast<u32>(owned.front()) + cast<u32>(owned.back()) + cast<u32>(owned[1u]);
    }
    return sum;
}

usize ConsumeStringValue(in String s){
    return s.size();
}

usize BorrowLocalStringAcrossValueCall(){
    String text = String("  0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789  ");
    StringView view = TrimView(text);
    const usize consumed = ConsumeStringValue(text);
    return consumed + view.size();
}

VectorSingle AddNegativeZeroRightSingle(in VectorSingle value){ return value + -VectorSingle(0.0f); }

VectorSingle AddNegativeZeroLeftSingle(in VectorSingle value){ return -VectorSingle(0.0f) + value; }

VectorDouble AddNegativeZeroRightDouble(in VectorDouble value){ return value + -VectorDouble(0.0); }

VectorDouble AddNegativeZeroLeftDouble(in VectorDouble value){ return -VectorDouble(0.0) + value; }

VectorSingle NegateZeroSingle(){ return -VectorSingle(0.0f); }

VectorSingle NegateNegativeZeroSingle(){ return -VectorSingle(-0.0f); }

VectorSingle DoubleNegateZeroSingle(){ return -(-VectorSingle(0.0f)); }

VectorSingle TripleNegateZeroSingle(){ return -(-(-VectorSingle(0.0f))); }

VectorDouble NegateZeroDouble(){ return -VectorDouble(0.0); }

VectorDouble NegateNegativeZeroDouble(){ return -VectorDouble(-0.0); }

VectorDouble DoubleNegateZeroDouble(){ return -(-VectorDouble(0.0)); }

VectorDouble TripleNegateZeroDouble(){ return -(-(-VectorDouble(0.0))); }

VectorSingle SubZeroRightSingle(in VectorSingle value){ return value - VectorSingle(0.0f); }
VectorSingle SubZeroLeftSingle(in VectorSingle value){ return VectorSingle(0.0f) - value; }
VectorSingle MulZeroRightSingle(in VectorSingle value){ return value * VectorSingle(0.0f); }
VectorSingle MulZeroLeftSingle(in VectorSingle value){ return VectorSingle(0.0f) * value; }
VectorSingle ZeroDivideSingle(in VectorSingle value){ return VectorSingle(0.0f) / value; }
VectorSingle NestedZeroSubSingle(in VectorSingle a, in VectorSingle b){ return (VectorSingle(0.0f) - a) + (b - VectorSingle(0.0f)); }
VectorSingle NegateZeroSubSingle(in VectorSingle value){ return -(VectorSingle(0.0f) - value); }

VectorDouble SubZeroRightDouble(in VectorDouble value){ return value - VectorDouble(0.0); }
VectorDouble SubZeroLeftDouble(in VectorDouble value){ return VectorDouble(0.0) - value; }
VectorDouble MulZeroRightDouble(in VectorDouble value){ return value * VectorDouble(0.0); }
VectorDouble MulZeroLeftDouble(in VectorDouble value){ return VectorDouble(0.0) * value; }
VectorDouble ZeroDivideDouble(in VectorDouble value){ return VectorDouble(0.0) / value; }
VectorDouble NestedZeroSubDouble(in VectorDouble a, in VectorDouble b){ return (VectorDouble(0.0) - a) + (b - VectorDouble(0.0)); }
VectorDouble NegateZeroSubDouble(in VectorDouble value){ return -(VectorDouble(0.0) - value); }

VectorSingle AddZeroRightSingle(in VectorSingle value){ return value + VectorSingle(0.0f); }

VectorSingle AddZeroLeftSingle(in VectorSingle value){ return VectorSingle(0.0f) + value; }

VectorDouble AddZeroRightDouble(in VectorDouble value){ return value + VectorDouble(0.0); }

VectorDouble AddZeroLeftDouble(in VectorDouble value){ return VectorDouble(0.0) + value; }

VectorSingle AddProductZeroRightSingle(in VectorSingle value, in VectorSingle factor){ return (value * factor) + VectorSingle(0.0f); }

VectorSingle AddProductZeroLeftSingle(in VectorSingle value, in VectorSingle factor){ return VectorSingle(0.0f) + (value * factor); }

VectorDouble AddProductZeroRightDouble(in VectorDouble value, in VectorDouble factor){ return (value * factor) + VectorDouble(0.0); }

VectorDouble AddProductZeroLeftDouble(in VectorDouble value, in VectorDouble factor){ return VectorDouble(0.0) + (value * factor); }

b8 AnyLaneGreater3Single(in VectorSingle lhs, in VectorSingle rhs){
    return lhs.x > rhs.x || lhs.y > rhs.y || lhs.z > rhs.z;
}

b8 AnyLaneGreater3Double(in VectorDouble lhs, in VectorDouble rhs){
    return lhs.x > rhs.x || lhs.y > rhs.y || lhs.z > rhs.z;
}

b8 FiniteLane3Single(in VectorSingle value){
    return IsFinite(value.xyz);
}

b8 FiniteLane3Double(in VectorDouble value){
    return IsFinite(value.xyz);
}

const StringView s_MetascriptValueItemsField = "items";
const usize s_MetascriptValueInitialCount = 8u;

b8 AnyLaneGreater2Single(in VectorSingle lhs, in VectorSingle rhs){
    return lhs.x > rhs.x || lhs.y > rhs.y;
}

class GlobalExportEdgeHolder{
    private Path m_root = "alpha";
    private Path m_sub("beta");
    private MemoryOrder m_order;
    private AtomicFlag m_flag;

    public b8 verifyEdgeCases(){
        if(this.m_order != MemoryOrder::relaxed){
            return false;
        }
        this.m_order = MemoryOrder::seq_cst;
        const b8 firstSet = this.m_flag.testAndSet(this.m_order);
        const b8 secondSet = this.m_flag.test(MemoryOrder::acquire);
        if(firstSet || !secondSet){
            return false;
        }

        Path leaf = "item.bin";
        Path combined = this.m_root / this.m_sub / leaf;
        const String stemOwned = PathToString(combined.stem());
        const Name probeName = Name("probe");
        const String probeOwned = String("probe");
        if(probeOwned != String("probe")){
            return false;
        }
        if(probeName != Name("probe")){
            return false;
        }
        String formatted = StringFormat("{0}|{1}|{2}", String("hdr"), stemOwned, probeOwned);
        if(StringView(formatted) != "hdr|item|probe"){
            return false;
        }

        if(!AddOverflows<u64>(u64.max, 1u) || AddOverflows<u64>(u64.max - 1u, 1u)){
            return false;
        }

        const Sha256Digest emptyDigest = ComputeSha256(StringView(""));
        const Expected<Sha256Digest> parsedDigest = ParseSha256("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
        if(!parsedDigest.has_value() || emptyDigest != parsedDigest.value() || emptyDigest.bytes[0u] != 0xe3u){
            return false;
        }

        const Expected<Vector<usize>> boundaries = BuildGraphemeBoundaries("a\xf0\x9f\x91\x8b\xf0\x9f\x8f\xbbz");
        if(!boundaries.has_value() || boundaries.value().size() != 4u || boundaries.value()[2u] != 9u){
            return false;
        }
        return true;
    }
}

b8 ExerciseGlobalExportEdgeCases(){
    GlobalExportEdgeHolder holder = GlobalExportEdgeHolder();
    return holder.verifyEdgeCases();
}

class ArenaGenericSlot<T>{
    public T item = T();
}

class ArenaEdgeLeaf{
    public String payload = "";
    public ArenaGenericSlot<String> slot = ArenaGenericSlot<String>();
}

class ArenaEdgeBranch{
    public ArenaEdgeLeaf leaf = ArenaEdgeLeaf();
    public Vector<String> tags;
    public HashMap<Name, String> hints;
}

class ArenaEdgeParameterizedMember{
    public String label;
    public ArenaEdgeParameterizedMember(in StringView tag){
        this.label = StringFormat("{0}_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_ctor", tag);
    }
}

[arena]
class ArenaEdgeRoot{
    public ArenaEdgeParameterizedMember constructedMember;
    public ArenaEdgeBranch primary = ArenaEdgeBranch();
    public Vector<ArenaEdgeBranch> history;
    public HashMap<Name, String> registry;
    public ArenaGenericSlot<u32> counter = ArenaGenericSlot<u32>();

    public ArenaEdgeRoot(){
        this.constructedMember = ArenaEdgeParameterizedMember("root_init");
    }
}

void RecordTransientHintIntoMap(mut HashMap<Name, String> targetMap, in Name key, in StringView prefix){
    String transientValue = StringFormat("{0}_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_hint", prefix);
    if(!targetMap.contains(key)){
        targetMap.try_emplace(key, String(transientValue));
    }
    else{
        targetMap.insert_or_assign(key, String(transientValue));
    }
}

ArenaEdgeBranch MakeBorrowedArenaBranch(in StringView prefix){
    ArenaEdgeBranch branch = ArenaEdgeBranch();
    branch.leaf.payload = StringFormat("{0}_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_leaf", prefix);
    branch.leaf.slot.item = StringFormat("{0}_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_slot", prefix);
    branch.tags.push_back(StringFormat("{0}_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_tag0", prefix));
    RecordTransientHintIntoMap(branch.hints, Name("primary_hint"), prefix);
    return branch;
}

void PopulateArenaRootFromTransientScratch(mut ArenaEdgeRoot root){
    ArenaEdgeBranch transientBranch = MakeBorrowedArenaBranch("ephemeral");
    transientBranch.tags.push_back(String("ephemeral_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_tag1"));
    root.primary = transientBranch;
    root.history.push_back(MakeBorrowedArenaBranch("archived"));
    root.history.push_back(transientBranch);
    RecordTransientHintIntoMap(root.registry, Name("entry"), "initial");
    RecordTransientHintIntoMap(root.registry, Name("entry"), "overwritten");
    root.counter.item = 2u;
}

usize ClobberTransientScratchScope(){
    Vector<String> noise;
    for(u32 i = 0u; i < 16u; ++i){
        noise.push_back(StringFormat("noise_{0}_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX", i));
    }
    return noise.size();
}

b8 ExerciseNestedMotherArenaAndScratchRebind(){
    ArenaEdgeRoot root = ArenaEdgeRoot();
    PopulateArenaRootFromTransientScratch(root);
    if(ClobberTransientScratchScope() != 16u){
        return false;
    }
    if(root.counter.item != 2u || root.history.size() != 2u || root.primary.tags.size() != 2u){
        return false;
    }
    if(StringView(root.constructedMember.label) != "root_init_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_ctor"){
        return false;
    }
    if(!root.primary.hints.contains(Name("primary_hint")) || !root.registry.contains(Name("entry"))){
        return false;
    }
    if(StringView(root.primary.hints.at(Name("primary_hint"))) != "ephemeral_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_hint"){
        return false;
    }
    if(StringView(root.history[0u].hints.at(Name("primary_hint"))) != "archived_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_hint"){
        return false;
    }
    if(StringView(root.registry.at(Name("entry"))) != "overwritten_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_hint"){
        return false;
    }
    if(StringView(root.primary.leaf.payload) != "ephemeral_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_leaf"){
        return false;
    }
    if(StringView(root.primary.leaf.slot.item) != "ephemeral_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_slot"){
        return false;
    }
    if(StringView(root.primary.tags[1u]) != "ephemeral_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_tag1"){
        return false;
    }
    if(StringView(root.history[0u].leaf.payload) != "archived_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_leaf"){
        return false;
    }
    if(StringView(root.history[1u].tags[0u]) != "ephemeral_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_tag0"){
        return false;
    }
    return true;
}


