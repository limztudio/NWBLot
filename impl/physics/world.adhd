    public Expected<ShapeId> createScaledShape(in BodyId bodyId, in ShapeDef def, in ScaledShape scaled){
        if(!this.isValidBody(bodyId) || !this.validateShapeDef(def) || !this.validateScaledShape(scaled))
            return MakeUnexpected(Failure());
        b8 infinitePlane = false;
        if(scaled.childType == ShapeType::Plane){
            PlaneShape pl;
            pl.normalOffset = scaled.geom0;
            pl.halfExtent = scaled.geom1;
            infinitePlane = !pl.isFiniteExtent();
        }
        if(
            this.m_bodies[bodyId.index].type == BodyType::Dynamic
            && (scaled.childType == ShapeType::Mesh || scaled.childType == ShapeType::Heightfield || infinitePlane)
        )
            return MakeUnexpected(Failure());
        Shape proto;
        proto.type = ShapeType::Scaled;
        proto.geometryIndex = this.allocateScaledShape(scaled);
        return this.attachPreparedShapeInternal(bodyId, def, proto);
    }

