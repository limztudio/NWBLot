#include <impl/ecs_render/csg/graph_types.adhd>
#include <impl/ecs_render/csg/renderer_csg_types.adhd>
#include <impl/ecs_render/kernel/task_graph_clear_timing.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class OpaqueCsgIntervalClearInputs{
    public CsgFrameWorkRegion workRegion;
    public u32 width = 0u;
    public u32 height = 0u;
    public GpuGraphResourceId csgIntervalId;
    public GpuGraphResourceId csgReceiverEventCount;
    public TextureSubresourceSet csgPeelSubresources;
    public TextureSubresourceSet csgReceiverEventCountSubresources;
    public GpuTaskId dependencyTask;
    public b8 hasOpaqueCsgFrameWork = false;
}

class CsgIntervalRectClearDesc{
    public Name intervalClearIdentity = s_NameNone;
    public StringView intervalClearMarkerLabel = "";
    public StringView intervalClearWarningMessage = "";
    public Name receiverEventClearIdentity = s_NameNone;
    public StringView receiverEventClearMarkerLabel = "";
    public StringView receiverEventClearWarningMessage = "";
    public GpuGraphResourceId csgIntervalId;
    public GpuGraphResourceId csgReceiverEventCount;
    public TextureSubresourceSet csgPeelSubresources;
    public TextureSubresourceSet csgReceiverEventCountSubresources;
    public Rect clearRect;
    public GpuTaskId dependencyTask;
}


[cpp_unwind]
b8 DeclareCsgIntervalRectClearTasks(
    in CsgIntervalRectClearDesc desc,
    mut GpuTaskGraph graph,
    mut GraphClearTimingRecordState clearTimingState,
    mut GpuTaskId outFirstTask,
    mut GpuTaskId outTailTask
){
    GpuTaskSchedulingHint scheduling;
    scheduling.cost = GpuTaskCostHint::Tiny;
    scheduling.forceSubmissionBoundary = false;
    scheduling.allowPacketMerge = true;
    scheduling.mergeWithPrevious = true;
    GpuTaskDesc firstDesc;
    firstDesc.setIdentity(desc.intervalClearIdentity).setMarkerLabel(desc.intervalClearMarkerLabel).setScheduling(scheduling);
    firstDesc.setDependency(desc.dependencyTask);
    GpuClearTextureRectUIntTaskDesc clear;
    clear.destination = desc.csgIntervalId;
    clear.subresources = desc.csgPeelSubresources;
    clear.rect = desc.clearRect;
    clear.uintValue = UIntColor(0u);
    clear.recordHooks = clearTimingState.hooks(true, false);
    const auto firstTask = graph.addClearTextureRectUIntTask(firstDesc, clear);
    if(!firstTask.has_value()){
        outFirstTask = GpuTaskId();
        warning("{}", desc.intervalClearWarningMessage);
        return false;
    }
    outFirstTask = firstTask.value();

    // Keep the endpoint in the first clear's graphics packet across queue consumers.
    scheduling.allowMergeAcrossConsumerFrontier = true;
    GpuTaskDesc tailDesc;
    tailDesc.setIdentity(desc.receiverEventClearIdentity).setMarkerLabel(desc.receiverEventClearMarkerLabel).setScheduling(scheduling);
    tailDesc.setDependency(outFirstTask);
    clear.destination = desc.csgReceiverEventCount;
    clear.subresources = desc.csgReceiverEventCountSubresources;
    clear.recordHooks = clearTimingState.hooks(false, true);
    const auto tailTask = graph.addClearTextureRectUIntTask(tailDesc, clear);
    if(!tailTask.has_value()){
        outTailTask = GpuTaskId();
        warning("{}", desc.receiverEventClearWarningMessage);
        return false;
    }
    outTailTask = tailTask.value();
    return true;
}


class OpaqueCsgIntervalClearBuilder : NoCopy{
    private mut GpuTaskGraph m_graph;

    public OpaqueCsgIntervalClearBuilder(mut GpuTaskGraph graph){ this.m_graph = graph; }

    [cpp_unwind]
    public Expected<OpaqueCsgIntervalClearResult> declare(in OpaqueCsgIntervalClearInputs inputs, mut GraphClearTimingRecordState clearTimingState){
        OpaqueCsgIntervalClearResult result;
        if(!inputs.dependencyTask.valid())
            return MakeUnexpected(Failure());
        if(!inputs.hasOpaqueCsgFrameWork)
            return result;
        if(!inputs.csgIntervalId.valid() || !inputs.csgReceiverEventCount.valid())
            return MakeUnexpected(Failure());
        CsgIntervalRectClearDesc desc;
        desc.intervalClearIdentity = s_RenderNameRenderGraphicsPrefixCsgIntervalClear;
        desc.intervalClearMarkerLabel = "CSG Interval Id Clear";
        desc.intervalClearWarningMessage = "RendererSystem: could not declare graph-owned opaque CSG interval-id clear";
        desc.receiverEventClearIdentity = s_RenderNameRenderGraphicsPrefixCsgReceiverEventCountClear;
        desc.receiverEventClearMarkerLabel = "CSG Receiver Event Count Clear";
        desc.receiverEventClearWarningMessage = "RendererSystem: could not declare graph-owned opaque CSG receiver-event clear";
        desc.csgIntervalId = inputs.csgIntervalId;
        desc.csgReceiverEventCount = inputs.csgReceiverEventCount;
        desc.csgPeelSubresources = inputs.csgPeelSubresources;
        desc.csgReceiverEventCountSubresources = inputs.csgReceiverEventCountSubresources;
        desc.clearRect = ToCoreRect(inputs.workRegion.resolveRect(inputs.width, inputs.height));
        desc.dependencyTask = inputs.dependencyTask;
        if(!DeclareCsgIntervalRectClearTasks(desc, this.m_graph, clearTimingState, result.clearFirstTask, result.clearTask))
            return MakeUnexpected(Failure());
        return result;
    }
}


