class TransparentCsgIntervalGraphSnapshot{
    private MaterialPassDrawItems m_drawItems;
    public CsgFrameGpuData frameData;
    public usize instanceCount = 0u;
    public usize materialTypedByteCount = 0u;
    public b8 captured = false;

    public void capture(in MaterialPassDrawItemsView items, in CsgFrameGpuDataView frame, in usize instances, in usize materialBytes){
        AssignVector(this.m_drawItems.meshDrawItems, items.meshDrawItems);
        AssignVector(this.m_drawItems.indexedDrawItems, items.indexedDrawItems);
        AssignVector(this.m_drawItems.computeDrawItems, items.computeDrawItems);
        AssignVector(this.frameData.receiverRanges, frame.receiverRanges);
        AssignVector(this.frameData.cutters, frame.cutters);
        this.frameData.workRegion = frame.workRegion;
        this.instanceCount = instances;
        this.materialTypedByteCount = materialBytes;
        this.captured = true;
    }

    public MaterialPassDrawItemsView receiverSurfaceDrawItemsView()const{
        return MaterialPassDrawItemsView(this.m_drawItems);
    }

    public CsgFrameGpuDataView csgFrameDataView()const{
        return CsgFrameGpuDataView(this.frameData);
    }
}

class TransparentCsgComputeIntervalSnapshot{
    public CsgFrameGpuData frameData;
    public usize instanceCount = 0u;
    public usize materialTypedByteCount = 0u;
    public b8 hasReceiverSurfaceDrawItems = false;
    public b8 receiverSurfaceDrawResourcesReady = false;
    public b8 captured = false;

    public void capture(in CsgFrameGpuDataView frame, in usize instances, in usize materialBytes, in b8 hasReceiverDraws, in b8 receiverDrawsReady){
        AssignVector(this.frameData.receiverRanges, frame.receiverRanges);
        AssignVector(this.frameData.cutters, frame.cutters);
        this.frameData.workRegion = frame.workRegion;
        this.instanceCount = instances;
        this.materialTypedByteCount = materialBytes;
        this.hasReceiverSurfaceDrawItems = hasReceiverDraws;
        this.receiverSurfaceDrawResourcesReady = receiverDrawsReady;
        this.captured = true;
    }

    public CsgFrameGpuDataView csgFrameDataView()const{
        return CsgFrameGpuDataView(this.frameData);
    }
}


[modular]
class AvboitPreGraphTaskPayload{
    public mut RendererAvboitSystem avboitSystem;
    public mut DeferredFrameTargets targets;
    public mut GpuTimingSubmissionTicket timingTicket;
    public mut Optional<GpuTimingMeasure> transparentCsgIntervalsTiming;
    public MeshFrameBindingSnapshot frameBindings;
    public CsgGraphResourceSnapshot csgResources;
    public TransparentCsgIntervalGraphSnapshot transparentCsgSnapshot;
    public b8 hasTransparentRenderers = false;
    public b8 transparentCsgStreamsUploaded = false;
    public b8 transparentCsgMaterialGeometryStatesGraphOwned = false;

    public AvboitPreGraphTaskPayload(
        mut RendererAvboitSystem avboitSystemIn,
        mut DeferredFrameTargets targetsIn,
        mut GpuTimingSubmissionTicket timingTicketIn,
        mut Optional<GpuTimingMeasure> transparentCsgIntervalsTimingIn
    ){
        this.avboitSystem = avboitSystemIn;
        this.targets = targetsIn;
        this.timingTicket = timingTicketIn;
        this.transparentCsgIntervalsTiming = transparentCsgIntervalsTimingIn;
    }
    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Graphics | GpuQueueCapability::Compute); }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const;
    public void discarded(){
        DiscardGpuTimingMeasure(this.transparentCsgIntervalsTiming);
    }
}


enum<u8> TransparentCsgIntervalPass{
    ReceiverSpan,
    Combine,
}


[modular]
class TransparentCsgIntervalRecordInputs{
    private TransparentCsgIntervalPass m_pass;

    private mut MaterialPassDrawRecorder m_drawRecorder;
    public mut RendererCsgSystem csgSystem;
    public mut DeferredFrameTargets targets;
    public mut GpuTimingSubmissionTicket timingTicket;
    public mut Optional<GpuTimingMeasure> transparentCsgIntervalsTiming;
    public MeshFrameBindingSnapshot frameBindings;
    public CsgGraphResourceSnapshot csgResources;
    public TransparentCsgComputeIntervalSnapshot transparentCsgSnapshot;
    public b8 csgFrameBuffersUploaded = false;

    public TransparentCsgIntervalRecordInputs(
        in TransparentCsgIntervalPass pass,
        mut MaterialPassDrawRecorder drawRecorder,
        mut RendererCsgSystem csgSystemIn,
        mut DeferredFrameTargets targetsIn,
        mut GpuTimingSubmissionTicket timingTicketIn,
        mut Optional<GpuTimingMeasure> transparentCsgIntervalsTimingIn
    ){
        this.m_pass = pass;
        this.m_drawRecorder = drawRecorder;
        this.csgSystem = csgSystemIn;
        this.targets = targetsIn;
        this.timingTicket = timingTicketIn;
        this.transparentCsgIntervalsTiming = transparentCsgIntervalsTimingIn;
    }
    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const;
    public void discarded(){
        DiscardGpuTimingMeasure(this.transparentCsgIntervalsTiming);
    }
}


