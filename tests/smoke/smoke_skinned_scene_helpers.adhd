native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace NWB::Tests::Smoke{
NotNullUniquePtr<Core::ECS::World> CreateSmokeSkinnedRenderWorldOrDie(const TStringView projectName, const SmokeRenderQualitySettings& baseSettings, ProjectRuntimeContext& context){
    auto world = CreateSmokeWorldOrDie(projectName, context);
    AddSmokeSkinnedRenderSystems(*world, context, baseSettings);
    return world;
}

NotNullUniquePtr<Core::ECS::World> CreateSmokeSkinnedRenderWorldOrDie(const TStringView projectName, ProjectRuntimeContext& context){
    return CreateSmokeSkinnedRenderWorldOrDie(projectName, SmokeRenderQualitySettings(), context);
}
};


