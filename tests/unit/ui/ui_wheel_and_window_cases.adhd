////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using ShaderFloat4 = ::__hidden_ui_glyph_sdf_tests::ShaderFloat4;
using float4 = ShaderFloat4;
using uint = u32;

[[nodiscard]] FOUNDATION_INLINE ShaderFloat4 operator*(const ShaderFloat4 value, const f32 scale)noexcept{
    const SIMDVectorSingle scaled = VectorScale(VectorSet(value.x, value.y, value.z, value.w), scale);
    return { .x = VectorGetX(scaled), .y = VectorGetY(scaled), .z = VectorGetZ(scaled), .w = VectorGetW(scaled) };
}

[[nodiscard]] FOUNDATION_INLINE f32 saturate(const f32 value)noexcept{
    return value > 0.0f ? Min(1.0f, value) : 0.0f;
}

[[nodiscard]] FOUNDATION_INLINE f32 max(const f32 first, const f32 second)noexcept{
    return Max(first, second);
}


