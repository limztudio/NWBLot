void VerifyModelCookMetadata_RedundantSkinnedMeshReferenceIsRejectedAndSkinOnlyReferenceRecovers(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration(logger, s_BreakOnFatal);
    ModelMetadata metadata = ModelMetadata();

    metadata.addSkeleton(s_ModelRigSegment, "tests/model_cook_metadata/skeleton");
    metadata.addSkinnedMesh(s_ModelBodySegment, s_ModelRigSegment, s_ModelRigSegment);
    ASSERT_TRUE(metadata.parse());
    metadata.verifyObjectReferences();

    metadata.setNestedFieldString(s_ModelMetaSkinnedMeshesField, s_ModelBodySegment, s_ModelMetaMeshField, s_ModelMetaMeshVirtualPath);
    EXPECT_FALSE(metadata.parse());
    metadata.verifyObjectReferences();
    EXPECT_TRUE(SawCapturedError(logger, "unsupported asset field 'mesh'"));

    ASSERT_EQ(metadata.eraseNestedField(s_ModelMetaSkinnedMeshesField, s_ModelBodySegment, s_ModelMetaMeshField), 1u);
    ASSERT_TRUE(metadata.parse());
    metadata.verifyObjectReferences();
    EXPECT_EQ(logger.errorCount(), 1u);
}

// Metadata construction and result checks stay outside the timed public cook-metadata parsing operation.
void VerifyModelCookMetadata_FourRowTransformFailsWithoutReplacingPreviousValueAndThreeRowsRecover(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration(logger, s_BreakOnFatal);
    ModelMetadata metadata = ModelMetadata();

    metadata.initThreeRowStaticTransform(s_PropObjectField, s_ModelMetaMeshVirtualPath, 0.5);
    ASSERT_TRUE(metadata.parse());
    ASSERT_EQ(metadata.entry.staticMeshObjects.size(), 1u);
    EXPECT_EQ(metadata.firstStaticTransform14(), 0.5f);

    metadata.appendHomogeneousStaticTransformRow(s_PropObjectField);
    EXPECT_FALSE(metadata.parse());
    ASSERT_EQ(metadata.entry.staticMeshObjects.size(), 1u);
    EXPECT_EQ(metadata.firstStaticTransform14(), 0.5f);
    EXPECT_TRUE(SawCapturedError(logger, "must be a 3x4 affine matrix"));

    metadata.popStaticTransformRow(s_PropObjectField);
    ASSERT_TRUE(metadata.parse());
    ASSERT_EQ(metadata.entry.staticMeshObjects.size(), 1u);
    EXPECT_EQ(metadata.firstStaticTransform14(), 0.5f);
    EXPECT_EQ(logger.errorCount(), 1u);
}

void VerifyModelPayload_RejectsDuplicateNamesWithinAndAcrossObjectKinds(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, s_BreakOnFatal);
    for(u32 duplicateCase = 0u; duplicateCase < 7u; ++duplicateCase){
        const ScopedTestTrace trace(duplicateCase);
        ModelInputs inputs = ModelInputs();
        switch(duplicateCase){
        case 0u: inputs.skeletonObjects.push_back(inputs.skeletonObjects[0u]); break;
        case 1u: inputs.staticMeshObjects.push_back(inputs.staticMeshObjects[0u]); break;
        case 2u: inputs.skinnedMeshObjects.push_back(inputs.skinnedMeshObjects[0u]); break;
        case 3u: inputs.staticMeshObjects[0u].name = inputs.skeletonObjects[0u].name; break;
        case 4u: inputs.skinnedMeshObjects[0u].name = inputs.skeletonObjects[0u].name; break;
        case 5u: inputs.skinnedMeshObjects[0u].name = inputs.staticMeshObjects[0u].name; break;
        case 6u: inputs.staticMeshObjects[0u].name = Name("RIG"); break;
        default: break;
        }
        inputs.publish();
        EXPECT_FALSE(inputs.validate());
    }
    EXPECT_EQ(logger.errorCount(), 7u);
}

void VerifyModelPayload_RejectsMissingNamesRequiredReferencesAndEmptyModels(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, s_BreakOnFatal);
    for(u32 invalidCase = 0u; invalidCase < 7u; ++invalidCase){
        const ScopedTestTrace trace(invalidCase);
        ModelInputs inputs = ModelInputs();
        switch(invalidCase){
        case 0u: inputs.skeletonObjects[0u].name = s_NameNone; break;
        case 1u: inputs.skeletonObjects[0u].skeleton.reset(); break;
        case 2u: inputs.staticMeshObjects[0u].name = s_NameNone; break;
        case 3u: inputs.staticMeshObjects[0u].mesh.reset(); break;
        case 4u: inputs.skinnedMeshObjects[0u].name = s_NameNone; break;
        case 5u: inputs.skinnedMeshObjects[0u].skin.reset(); break;
        case 6u: inputs.skinnedMeshObjects[0u].skeletonObject = s_NameNone; break;
        default: break;
        }
        inputs.publish();
        EXPECT_FALSE(inputs.validate());
    }

    ModelInputs inputs = ModelInputs();
    inputs.skeletonObjects.clear();
    inputs.staticMeshObjects.clear();
    inputs.skinnedMeshObjects.clear();
    inputs.publish();
    EXPECT_FALSE(inputs.validate());
    EXPECT_FALSE(inputs.validateUnnamedModel());
}

