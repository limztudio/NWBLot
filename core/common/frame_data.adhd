[cpp_header("<core/common/frame_data.h>"), cpp_name("::NWB::Core::Common::FrameData"), cpp_flags(self_defaulted, brace_init)]
extern class FrameData{
    FrameParam frameParam(...)const;
    u16 height(...)const;
    u16 width(...)const;
};

[cpp_header("<core/common/frame_data.h>"), cpp_name("::NWB::Core::Common::FrameParam"), cpp_flags(self_defaulted, brace_init)]
extern class FrameParam{
    u16 width;
    u16 height;
    b8 active;
};


