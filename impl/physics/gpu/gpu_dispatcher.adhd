    public Vector<u32x4> surfTris;
    public Vector<f32x4> restRel;
    public PhysicsGpuBufferSlot distConSlot;
    public PhysicsGpuBufferSlot volConSlot;
    public PhysicsGpuBufferSlot bendConSlot;
    public PhysicsGpuBufferSlot adjRangeSlot;
    public PhysicsGpuBufferSlot adjListSlot;
    public PhysicsGpuBufferSlot aeroRangeSlot;
    public PhysicsGpuBufferSlot aeroListSlot;
    public PhysicsGpuBufferSlot surfTriSlot;
    public PhysicsGpuBufferSlot restRelSlot;
    public PhysicsGpuBufferSlot shapeOutSlot;

    public void clearState(){
        this.topoKey = 0u;
        this.topoVersion = 0u;
        this.particleCount = 0u;
        this.distCount = 0u;
        this.bendCount = 0u;
        this.dihBendCount = 0u;
        this.surfTriCount = 0u;
        this.volCount = 0u;
        this.lastUsedEpoch = 0u;
        this.valid = false;
        this.restRelValid = false;
        this.distGpuValid = false;
        this.volGpuValid = false;
        this.bendGpuValid = false;
        this.adjGpuValid = false;
        this.aeroGpuValid = false;
        this.restRelGpuValid = false;
        this.distCons.clear();
        this.distSlices.clear();
        this.volCons.clear();
        this.volSlices.clear();
        this.bendCons.clear();
        this.bendSlices.clear();
        this.adjRange.clear();
        this.adjList.clear();
        this.aeroRange.clear();
        this.aeroList.clear();
        this.surfTris.clear();
        this.restRel.clear();
    }
}

class SoftBodyGpuDeformCacheSlot{
    public u64 topoKey = 0u;
    public u64 lastUsedEpoch = 0u;
    public b8 valid = false;
    public b8 gpuValid = false;
    public PhysicsGpuBufferSlot vertMapSlot;
    public PhysicsGpuBufferSlot cagePartSlot;
    public PhysicsGpuBufferSlot cageBarySlot;
    public PhysicsGpuBufferSlot triIdxSlot;
    public PhysicsGpuBufferSlot vertTriRangeSlot;
