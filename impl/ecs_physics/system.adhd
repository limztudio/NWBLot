    public b8 setBodyTransformDouble(in EntityID entity, in VectorDouble position, in VectorSingle rotation){
        const auto found = this.m_entityRecords.find(entity);
        if(found == this.m_entityRecords.end() || found.value().attachedToParentBody || !found.value().bodyId.valid())
            return false;
        const BodyId bodyId = found.value().bodyId;
        if(!this.m_physicsWorld.setBodyTransformDouble(bodyId, position, rotation))
            return false;
        if(this.m_physicsWorld.m_bodies[bodyId.index].type == BodyType::Static)
            MarkStaticBodyMoved(bodyId, this.m_syncScratch.movedStaticBodyFlags, this.m_syncScratch.movedStaticBodyIndices);
        const VectorDouble originOff = this.m_physicsWorld.worldOriginOffset();
        const VectorSingle localPos(
            cast<f32>(position.x - originOff.x),
            cast<f32>(position.y - originOff.y),
            cast<f32>(position.z - originOff.z),
            0.0f
        );
        const Transform3D normXf(localPos, SafeNormalizeQuat(rotation));
        SetBodySyncedPose(bodyId, normXf, this.m_syncScratch.bodySyncedPoses);
        SetBodyTransformSnapshotBoth(bodyId, normXf, this.m_bodyTransformSnapshots, this.m_bodyTransformSnapshotMeta);
        ClearStaticBodyPoseCacheIfMatches(bodyId, this.m_syncScratch.staticBodyPoseCache);
        if(this.m_world.alive(entity)){
            if(this.m_hasAnyPhysicsParents)
                this.m_syncScratch.writeBackPoseCache.clear();
            WriteWorldPoseBackToEntityTransform(entity, normXf, this.m_hasAnyPhysicsParents, this.m_world, this.m_syncScratch.writeBackPoseCache);
            this.syncEcsRigidBodyRuntimeState(entity, bodyId);
        }
        return true;
    }

    public EcsRayCastDoubleHit rayCastClosestDouble(in RayCastDoubleInput input)const{
        EcsRayCastDoubleHit outHit;
        outHit.hit = this.m_physicsWorld.rayCastClosestDouble(input);
        if(outHit.hit.hit)
            outHit.entity = this.entityForShape(outHit.hit.shapeId);
        return outHit;
    }

    public EcsShapeCastDoubleHit shapeCastClosestDouble(in ShapeProxy queryProxy, in ShapeCastDoubleInput input)const{
        EcsShapeCastDoubleHit outHit;
        outHit.hit = this.m_physicsWorld.shapeCastClosestDouble(queryProxy, input);
        if(outHit.hit.hit)
            outHit.entity = this.entityForShape(outHit.hit.shapeId);
        return outHit;
    }

