const u32 s_UiTextFontLayoutQuietNaNF32Bits = 0x7fc00000u;
const u32 s_UiTextFontLayoutPosInfF32Bits = 0x7f800000u;
const AStringView s_UiTextFontKoreanLanguage = "ko";
const AStringView s_UiTextFontSampleGlyphText = "A";
const AStringView s_UiTextFontWideGlyphText = "W";
const AStringView s_UiTextLayoutInkCommittedText = "a";
const AStringView s_UiTextLayoutInkReplacementText = "b";
const AStringView s_UiTextLayoutInkTwoGlyphReplacementText = "bc";
const AStringView s_UiTextLayoutLigatureText = "ffi";
const AStringView s_UiTextLayoutCombiningMarkText = "A\xcc\x81";
const AStringView s_UiTextLayoutTwoGlyphText = "AB";


ShapeRequest MakeUiTextFontLayoutRequest(in StringView text){
    ShapeRequest request = ShapeRequest();
    request.text = text;
    return request;
}

GlyphCoverageBounds MakeUiTextFontLayoutCoverage(in Rect ink, in b8 known){
    GlyphCoverageBounds coverage = GlyphCoverageBounds();
    coverage.ink = ink;
    coverage.known = known;
    return coverage;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyTextFontConstruction_ThrowingNativeFaceDiagnosticReleasesAcquiredArenaMemory(){
    b8 sawFaceFailure = false;
    u64 beforeAllocs = 0u;
    u64 afterAllocs = 0u;
    usize beforeUsed = 0u;
    usize afterUsed = 0u;
    usize beforeReserved = 0u;
    usize afterReserved = 0u;
    native(mut sawFaceFailure, mut beforeAllocs, mut afterAllocs, mut beforeUsed, mut afterUsed, mut beforeReserved, mut afterReserved){
        ::NWB::Core::Alloc::GlobalArena sourceArena{Name(::NWB::Tests::UiCases::s_UiFixtureNameTestsUiFontConstructionSource)};
        const ::NWB::Core::Assets::AssetRef<::NWB::Impl::Font> emptyFontRef("tests/ui/font_construction/empty");
        ::NWB::Impl::Font emptyFont(sourceArena, emptyFontRef.name());
        ::NWB::Core::Alloc::GlobalArena fontArena{Name(::NWB::Tests::UiCases::s_UiFixtureNameTestsUiFontConstructionNative)};
        ::NWB::Core::Alloc::ScratchArena scratchArena{Name(::NWB::Tests::UiCases::s_UiFixtureNameTestsUiFontConstructionScratch)};
        ::NWB::Core::Common::LogArena logArena{Name(::NWB::Tests::UiCases::s_UiFixtureNameTestsUiFontConstructionLogger)};
        ThrowingFontConstructionLogger logger(logArena);
        ::NWB::Core::Common::LoggerRegistrationGuard loggerGuard(logger, ::NWB::Core::Common::LoggerBreakPolicy::ReportOnly);
        const ::NWB::Impl::Ui::FontSource source{ emptyFontRef, emptyFont, 1u };
        const auto before = fontArena.memoryStats();
        EXPECT_THROW({ const auto failed = ::NWB::Impl::Ui::MakeFontFace(scratchArena, fontArena, source); EXPECT_FALSE(failed && (*failed)->valid()); }, i32);
        sawFaceFailure = logger.sawFaceFailure();
        const auto after = fontArena.memoryStats();
        beforeAllocs = before.allocationCount;
        afterAllocs = after.allocationCount;
        beforeUsed = before.usedBytes;
        afterUsed = after.usedBytes;
        beforeReserved = before.reservedBytes;
        afterReserved = after.reservedBytes;
    }
    EXPECT_TRUE(sawFaceFailure);
    EXPECT_GT(afterAllocs, beforeAllocs);
    EXPECT_EQ(afterUsed, beforeUsed);
    EXPECT_EQ(afterReserved, beforeReserved);
}

void VerifyTextFontTests_MissingLatinHangulGlyphsUseKoreanFallbackForBothLabelClusters(mut TextFontTests self){
    ShapeRequest request = MakeUiTextFontLayoutRequest("\xed\x95\x9c\xea\xb8\x80");
    request.scriptTag = PackFourCharTag(72u, 97u, 110u, 103u);
    request.language = s_UiTextFontKoreanLanguage;
    ASSERT_TRUE(self.applyLayout(request));
    ASSERT_EQ(self.m_layout.clusters().size(), 2u);
    for(usize index = 0u; index < self.m_layout.glyphs().size(); ++index)
        EXPECT_EQ(FontFaceIdentityName(self.m_layout.glyphs()[index].face), Name(s_TestKoreanFontPath));
}

void VerifyTextFontTests_RtlHarfBuzzClustersUseLogicalEndRatherThanNextVisualStart(mut TextFontTests self){
    ShapeRequest request = MakeUiTextFontLayoutRequest("abc");
    request.direction = TextDirection::RightToLeft;
    ASSERT_TRUE(self.applyLayout(request));
    ASSERT_EQ(self.m_layout.clusters().size(), 3u);
    EXPECT_EQ(self.m_layout.clusters()[0u].byteBegin, 2u);
    EXPECT_EQ(self.m_layout.clusters()[0u].byteEnd, 3u);
    EXPECT_EQ(self.m_layout.clusters()[1u].byteBegin, 1u);
    EXPECT_EQ(self.m_layout.clusters()[1u].byteEnd, 2u);
    EXPECT_GT(self.m_layout.clusters()[0u].leadingX, self.m_layout.clusters()[0u].trailingX);
}

void VerifyTextFontTests_FontReplacementAndAssetMutationKeepOldCpuFaceAndLayoutUsable(mut TextFontTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest("AV")));
    const f32 width = self.m_layout.measure().x;
    const u64 oldServiceGeneration = self.m_service.generation();
    const SharedFontFace oldFace = self.m_layout.glyphs()[0u].face;
    ASSERT_TRUE(self.setLatinFontGeneration(2u));
    EXPECT_EQ(self.m_service.generation(), oldServiceGeneration + 1u);
    self.clearLatinFontBytes();
    self.beginPaint(1u);
    ASSERT_TRUE(self.m_service.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f)));
    const DrawSnapshot snapshot = self.m_paint.freeze();
    ASSERT_FALSE(snapshot.glyphPages().empty());
    const u64 pageFontGeneration = GlyphPageBindingOf(snapshot.glyphPages()[0u]).fontGeneration;
    const u64 oldFaceGeneration = FontFaceGeneration(oldFace);
    const b8 setEmptyAccepted = self.setEmptyFonts();
    EXPECT_EQ(pageFontGeneration, 1u);
    EXPECT_EQ(oldFaceGeneration, 1u);
    EXPECT_FLOAT_EQ(self.m_layout.measure().x, width);
    EXPECT_FALSE(setEmptyAccepted);
    EXPECT_EQ(self.m_service.generation(), oldServiceGeneration + 1u);
}

void VerifyTextFontTests_AppendingGlyphKeepsEarlierCoverageBytesImmutable(mut TextFontTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest(s_UiTextFontSampleGlyphText)));
    self.beginPaint(1u);
    ASSERT_TRUE(self.m_service.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f)));
    const DrawSnapshot first = self.m_paint.freeze();
    ASSERT_EQ(first.glyphPages().size(), 1u);
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest("B")));
    self.beginPaint(2u);
    ASSERT_TRUE(self.m_service.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f)));
    const DrawSnapshot second = self.m_paint.freeze();
    ASSERT_EQ(second.glyphPages().size(), 1u);
    const SharedGlyphPage oldPage = first.glyphPages()[0u];
    const Span<u8> initialOldPixels = GlyphPagePixelsOf(oldPage);
    Vector<u8> saved = Vector<u8>();
    saved.reserve(initialOldPixels.size());
    for(usize index = 0u; index < initialOldPixels.size(); ++index)
        saved.push_back(initialOldPixels[index]);
    const SharedGlyphPage newPage = second.glyphPages()[0u];
    EXPECT_EQ(GlyphPageBindingOf(newPage).atlasIdentity, GlyphPageBindingOf(oldPage).atlasIdentity);
    EXPECT_GT(GlyphPageBindingOf(newPage).generation, GlyphPageBindingOf(oldPage).generation);
    const Span<u8> currentOldPixels = GlyphPagePixelsOf(oldPage);
    ASSERT_EQ(currentOldPixels.size(), saved.size());
    const Span<u8> newPixels = GlyphPagePixelsOf(newPage);
    for(usize pixel = 0u; pixel < saved.size(); ++pixel){
        EXPECT_EQ(currentOldPixels[pixel], saved[pixel]);
        if(saved[pixel] != 0u)
            EXPECT_EQ(newPixels[pixel], saved[pixel]);
    }
}

void VerifyTextFontTests_RasterDpiChangesPagesWithoutChangingLogicalMeasurement(mut TextFontTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest("Ag")));
    const Point measured = self.m_layout.measure();
    self.beginPaint(1u);
    ASSERT_TRUE(self.m_service.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f)));
    const DrawSnapshot first = self.m_paint.freeze();
    self.beginPaint(2u, 1.5f);
    ASSERT_TRUE(self.m_service.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f)));
    const DrawSnapshot second = self.m_paint.freeze();
    EXPECT_FLOAT_EQ(self.m_layout.measure().x, measured.x);
    EXPECT_FLOAT_EQ(self.m_layout.measure().y, measured.y);
    ASSERT_EQ(first.glyphPages().size(), 1u);
    ASSERT_EQ(second.glyphPages().size(), 1u);
    EXPECT_GT(GlyphPageBindingOf(second.glyphPages()[0u]).generation, GlyphPageBindingOf(first.glyphPages()[0u]).generation);
}

void VerifyTextFontTests_OversizedGlyphRejectsWholeLabelBeforePaintingAnyQuads(mut TextFontTests self){
    ShapeRequest request = MakeUiTextFontLayoutRequest(s_UiTextFontWideGlyphText);
    request.fontSize = 1024.0f;
    ASSERT_TRUE(self.applyLayout(request));
    self.beginPaint(1u);
    self.m_paint.fillRect(Rect(1.0f, 1.0f, 10.0f, 10.0f));
    EXPECT_FALSE(self.m_service.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f)));
    const DrawSnapshot snapshot = self.m_paint.freeze();
    EXPECT_EQ(snapshot.vertices().size(), 4u);
    EXPECT_TRUE(snapshot.glyphPages().empty());
}

void VerifyTextFontTests_GlyphAtlasIndexKeepsFaceSizeAndEmptyGlyphsDistinctAcrossReset(mut TextFontTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest(s_UiTextFontSampleGlyphText)));
    ASSERT_EQ(self.m_layout.glyphs().size(), 1u);
    const u32 glyphId = self.m_layout.glyphs()[0u].glyphId;
    GlyphAtlas atlas = GlyphAtlas(self.m_arena);
    const SharedFontFace face = self.m_layout.glyphs()[0u].face;
    const auto otherFaceResult = self.makeLatinFace(1u);
    ASSERT_TRUE(otherFaceResult.has_value());
    const SharedFontFace otherFace = otherFaceResult.value();
    ASSERT_TRUE(FontFaceValid(otherFace));
    ASSERT_NE(face, otherFace);
    ASSERT_TRUE(atlas.prepare(face, glyphId, 24u));
    const usize firstSlot = AtlasGlyphSlotId(atlas, face, glyphId, 24u);
    ASSERT_NE(firstSlot, 0u);
    ASSERT_TRUE(atlas.prepare(face, glyphId, 24u));
    EXPECT_EQ(atlas.glyphCount(), 1u);
    EXPECT_EQ(AtlasGlyphSlotId(atlas, face, glyphId, 24u), firstSlot);
    ASSERT_TRUE(atlas.prepare(face, glyphId, 32u));
    ASSERT_TRUE(atlas.prepare(otherFace, glyphId, 24u));
    EXPECT_EQ(atlas.glyphCount(), 3u);
    EXPECT_NE(AtlasGlyphSlotId(atlas, face, glyphId, 32u), firstSlot);
    EXPECT_NE(AtlasGlyphSlotId(atlas, otherFace, glyphId, 24u), firstSlot);

    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest(" ")));
    ASSERT_EQ(self.m_layout.glyphs().size(), 1u);
    const u32 spaceId = self.m_layout.glyphs()[0u].glyphId;
    GlyphBitmap bitmap = GlyphBitmap(self.m_arena);
    ASSERT_TRUE(FontFaceRasterize(face, spaceId, 24u, bitmap));
    ASSERT_TRUE(bitmap.width == 0u || bitmap.height == 0u);
    ASSERT_TRUE(atlas.prepare(face, spaceId, 24u));
    const auto spaceResult = TryFindAtlasGlyph(atlas, face, spaceId, 24u);
    ASSERT_TRUE(spaceResult.has_value());
    EXPECT_EQ(spaceResult.value().pageIndex, s_GlyphAtlasNoPage);
    ASSERT_TRUE(atlas.prepare(face, spaceId, 24u));
    EXPECT_EQ(atlas.glyphCount(), 4u);

    const auto oldPageCreationResult = atlas.page(0u);
    ASSERT_TRUE(oldPageCreationResult.has_value());
    const SharedGlyphPage oldPage = oldPageCreationResult.value();
    ASSERT_TRUE(cast<b8>(oldPage));
    atlas.reset();
    EXPECT_EQ(atlas.glyphCount(), 0u);
    EXPECT_EQ(atlas.pageCount(), 0u);
    EXPECT_FALSE(HasAtlasGlyph(atlas, face, glyphId, 24u));
    EXPECT_FALSE(HasAtlasGlyph(atlas, face, spaceId, 24u));
    ASSERT_TRUE(atlas.prepare(face, glyphId, 24u));
    const auto newPageCreationResult = atlas.page(0u);
    ASSERT_TRUE(newPageCreationResult.has_value());
    const SharedGlyphPage newPage = newPageCreationResult.value();
    ASSERT_TRUE(cast<b8>(newPage));
    EXPECT_NE(GlyphPageBindingOf(newPage).atlasIdentity, GlyphPageBindingOf(oldPage).atlasIdentity);
}

void VerifyTextFontTests_AtlasWrapsToNextRowWithoutChangingExistingGlyphs(mut TextFontTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest(s_UiTextFontWideGlyphText)));
    ASSERT_FALSE(self.m_layout.glyphs().empty());
    const PlacedGlyph glyph = self.m_layout.glyphs()[0u];
    GlyphAtlas atlas = GlyphAtlas(self.m_arena);
    ASSERT_TRUE(atlas.prepare(glyph.face, glyph.glyphId, 24u));
    const auto firstFound = TryFindAtlasGlyph(atlas, glyph.face, glyph.glyphId, 24u);
    ASSERT_TRUE(firstFound.has_value());
    const Rect firstPixels = firstFound.value().pixels;
    b8 wrapped = false;
    for(u32 size = 25u; size <= 120u; ++size){
        ASSERT_TRUE(atlas.prepare(glyph.face, glyph.glyphId, size));
        const auto foundRecord = TryFindAtlasGlyph(atlas, glyph.face, glyph.glyphId, size);
        ASSERT_TRUE(foundRecord.has_value());
        const AtlasGlyph record = foundRecord.value();
        if(record.pageIndex == 0u && record.pixels.y > firstPixels.y){
            EXPECT_FLOAT_EQ(record.pixels.x, 1.0f);
            wrapped = true;
            break;
        }
    }
    ASSERT_TRUE(wrapped);
    const auto currentFound = TryFindAtlasGlyph(atlas, glyph.face, glyph.glyphId, 24u);
    ASSERT_TRUE(currentFound.has_value());
    const Rect currentPixels = currentFound.value().pixels;
    ExpectUiRect(currentPixels, firstPixels);
}

void VerifyTextFontTests_AtlasGrowthStaysWithinBoundsAndStopsAtSixteenPages(mut TextFontTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextFontLayoutRequest(s_UiTextFontWideGlyphText)));
    const PlacedGlyph glyph = self.m_layout.glyphs()[0u];
    GlyphAtlas atlas = GlyphAtlas(self.m_arena);
    for(u32 index = 0u; index < s_GlyphAtlasMaxPages; ++index){
        ASSERT_TRUE(atlas.prepare(glyph.face, glyph.glyphId, 460u + index));
        ASSERT_EQ(cast<u32>(atlas.pageCount()), index + 1u);
        const auto foundRecord = TryFindAtlasGlyph(atlas, glyph.face, glyph.glyphId, 460u + index);
        ASSERT_TRUE(foundRecord.has_value());
        const AtlasGlyph record = foundRecord.value();
        const auto pageResult = atlas.page(index);
        ASSERT_TRUE(pageResult.has_value());
        ASSERT_TRUE(cast<b8>(pageResult.value()));
        const VectorSingle pixelEnd = VectorSingle(record.pixels.x, record.pixels.y, 0.0f, 0.0f) + VectorSingle(record.pixels.width, record.pixels.height, 0.0f, 0.0f);
        EXPECT_LT(pixelEnd.x, cast<f32>(s_GlyphAtlasPageExtent));
        EXPECT_LT(pixelEnd.y, cast<f32>(s_GlyphAtlasPageExtent));
    }
    EXPECT_FALSE(atlas.prepare(glyph.face, glyph.glyphId, 476u));
    EXPECT_FALSE(HasAtlasGlyph(atlas, glyph.face, glyph.glyphId, 476u));
    EXPECT_TRUE(atlas.prepare(glyph.face, glyph.glyphId, 460u));
    EXPECT_EQ(atlas.glyphCount(), s_GlyphAtlasMaxPages);
    EXPECT_EQ(atlas.pageCount(), s_GlyphAtlasMaxPages);
}

void VerifyTextFontTests_NativeCffCoverageAndFaceSurviveFontReplacement(mut TextFontTests self){
    ShapeRequest request = MakeUiTextFontLayoutRequest("\xed\x95\x9c");
    request.scriptTag = PackFourCharTag(72u, 97u, 110u, 103u);
    request.language = s_UiTextFontKoreanLanguage;
    ASSERT_TRUE(self.applyLayout(request));
    ASSERT_EQ(self.m_layout.glyphs().size(), 1u);
    const PlacedGlyph glyph = self.m_layout.glyphs()[0u];
    EXPECT_TRUE(glyph.coverage.known);
    EXPECT_GT(glyph.coverage.ink.width, 0.0f);
    EXPECT_GT(glyph.coverage.ink.height, 0.0f);
    const Rect saved = glyph.coverage.ink;
    const SharedFontFace placedFace = self.m_layout.glyphs()[0u].face;
    const b8 reliableBefore = FontFaceCoverageInkReliable(placedFace);
    ASSERT_TRUE(self.setLatinFontGeneration(2u));
    const b8 validAfter = FontFaceValid(placedFace);
    EXPECT_FALSE(reliableBefore);
    EXPECT_TRUE(self.m_layout.glyphs()[0u].coverage.known);
    EXPECT_FLOAT_EQ(self.m_layout.glyphs()[0u].coverage.ink.x, saved.x);
    EXPECT_FLOAT_EQ(self.m_layout.glyphs()[0u].coverage.ink.width, saved.width);
    EXPECT_TRUE(validAfter);
}

void VerifyTextFontTests_NativeCffBoundsCoverFractionalDpiRasterFringes(mut TextFontTests self){
    Array<f32, 3u> sizes;
    sizes[0u] = 32.0078125f;
    sizes[1u] = 64.21875f;
    sizes[2u] = 320.0078125f;
    const u32 hangulTag = PackFourCharTag(72u, 97u, 110u, 103u);
    for(in f32 fontSize : sizes){
        ShapeRequest request = MakeUiTextFontLayoutRequest("\xed\x95\x9c");
        request.scriptTag = hangulTag;
        request.language = s_UiTextFontKoreanLanguage;
        request.fontSize = fontSize;
        ASSERT_TRUE(self.applyLayout(request));
        ASSERT_EQ(self.m_layout.glyphs().size(), 1u);
        const PlacedGlyph glyph = self.m_layout.glyphs()[0u];
        ASSERT_TRUE(glyph.coverage.known);
        const f32 pixelSizeFloat = Ceil(fontSize * 1.375f);
        const u32 pixelSize = cast<u32>(pixelSizeFloat);
        GlyphBitmap bitmap = GlyphBitmap(self.m_arena);
        ASSERT_TRUE(FontFaceRasterize(glyph.face, glyph.glyphId, pixelSize, bitmap));
        const f32 scaleValue = pixelSizeFloat / fontSize;
        const VectorSingle scale = VectorSingle(scaleValue, scaleValue, scaleValue, scaleValue);
        const f32 fringeScalar = 2.0f / scaleValue;
        const VectorSingle fringe = VectorSingle(fringeScalar, fringeScalar, fringeScalar, fringeScalar);
        const Rect bounds = glyph.coverage.ink;
        const VectorSingle boundsStart = VectorSingle(bounds.x, bounds.y, 0.0f, 0.0f);
        const VectorSingle bearing = VectorSingle(cast<f32>(bitmap.bearingX), -cast<f32>(bitmap.bearingY), 0.0f, 0.0f);
        const VectorSingle rasterStart = bearing / scale;
        const VectorSingle rasterEnd = (bearing + VectorSingle(cast<f32>(bitmap.width), cast<f32>(bitmap.height), 0.0f, 0.0f)) / scale;
        const VectorSingle limitStart = boundsStart - fringe;
        const VectorSingle limitEnd = boundsStart + VectorSingle(bounds.width, bounds.height, 0.0f, 0.0f) + fringe;
        EXPECT_GE(rasterStart.x, limitStart.x);
        EXPECT_GE(rasterStart.y, limitStart.y);
        EXPECT_LE(rasterEnd.x, limitEnd.x);
        EXPECT_LE(rasterEnd.y, limitEnd.y);
    }
}


