[[nodiscard]] FOUNDATION_INLINE TextInputSessionToken MakeSessionToken(const u64 service, const u64 generation)noexcept{
    return TextInputSessionToken{ service, generation };
}

[[nodiscard]] FOUNDATION_INLINE WaylandTextInputProvenance MakeWaylandProvenance(const TextInputSessionToken token, const u64 revision, const b8 revisionKnown)noexcept{
    return WaylandTextInputProvenance{ token, revision, revisionKnown };
}

FOUNDATION_INLINE void AppendGlobalString(GlobalString& target, const AStringView text){
    target.append(text.data(), text.size());
}

FOUNDATION_INLINE void ReplaceGlobalString(GlobalString& target, const usize pos, const usize count, const AStringView text){
    target.replace(pos, count, text.data(), text.size());
}

FOUNDATION_INLINE void ClearAndShrinkGlobalString(GlobalString& target){
    target.clear();
    target.shrink_to_fit();
}

[[nodiscard]] inline constexpr usize GetX11PreeditMaxBytes()noexcept{
    return X11PreeditBuffer::s_MaxBytes;
}

#if defined(FOUNDATION_PLATFORM_LINUX)
inline constexpr u32 s_SelectionChangeTimeoutMS = 3000u;
inline constexpr u32 s_ClipboardCompletionTimeoutMS = 6000u;
inline constexpr u32 s_PollIntervalMS = 1u;
inline constexpr AStringView s_ClipboardAtomName = "CLIPBOARD";

struct OwnedPipe final : NoCopy{
    int m_readFd = -1;
    int m_writeFd = -1;

    ~OwnedPipe()noexcept{
        CloseClipboardPipe(m_readFd);
        CloseClipboardPipe(m_writeFd);
    }

    void reset()noexcept{
        CloseClipboardPipe(m_readFd);
        CloseClipboardPipe(m_writeFd);
    }

    [[nodiscard]] b8 open()noexcept{
        reset();
        const auto pipe = OpenClipboardPipe();
        if(!pipe)
            return false;
        m_readFd = pipe->readFd;
        m_writeFd = pipe->writeFd;
        return true;
    }

    [[nodiscard]] int releaseWrite()noexcept{
        const int fd = m_writeFd;
        m_writeFd = -1;
        return fd;
    }
};

struct ClipboardPipeContext{
    NWB::Tests::TestArena<> arena;
    OwnedPipe pipe;
    ClipboardTextAccumulator received;
    ClipboardPipeWriter writer;
    GlobalString input;
    GlobalString expected;

    ClipboardPipeContext()
        : received(arena.arena)
        , writer(arena.arena)
        , input(arena.arena)
        , expected(arena.arena)
    {}

    [[nodiscard]] b8 openPipe()noexcept{ return pipe.open(); }
    void closeWriteEnd()noexcept{ CloseClipboardPipe(pipe.m_writeFd); }
    void closeReadEnd()noexcept{ CloseClipboardPipe(pipe.m_readFd); }
    [[nodiscard]] i32 releaseWriteFd()noexcept{ return static_cast<i32>(pipe.releaseWrite()); }
    [[nodiscard]] isize writeRaw(const AStringView bytes)noexcept{ return static_cast<isize>(write(pipe.m_writeFd, bytes.data(), bytes.size())); }
    [[nodiscard]] Expected<b8, ClipboardPipeReadFailure> readPipe(){ return ReadClipboardPipe(pipe.m_readFd, received); }
    [[nodiscard]] AStringView receivedText()const noexcept{ return received.text(); }
    void clearReceived()noexcept{ received.clear(); }
    [[nodiscard]] b8 beginWriter(const i32 fd, const AStringView text){ return writer.begin(static_cast<int>(fd), text); }
    [[nodiscard]] ClipboardStatus::Enum advanceWriter()noexcept{ return writer.advance(); }
    [[nodiscard]] b8 writerFinished()const noexcept{ return writer.finished(); }
    [[nodiscard]] i32 queryFdFlags(const i32 fd)const noexcept{ return static_cast<i32>(fcntl(static_cast<int>(fd), F_GETFL)); }
    [[nodiscard]] b8 hasNonblockFlag(const i32 flags)const noexcept{ return (flags & O_NONBLOCK) != 0; }
    [[nodiscard]] i32 pollPipeWritable(const i32 fd)const noexcept{
        pollfd writable{ .fd = static_cast<int>(fd), .events = POLLOUT, .revents = 0 };
        return static_cast<i32>(poll(&writable, 1u, 0));
    }
};

