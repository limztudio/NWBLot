Expected<Material> BuildTestMaterialFromBindAndMeta(in StringView bindText, in StringView materialText, in StringView caseName, mut TestArena testArena, mut GraphicsScratchArena scratch){
    const auto entry = ParseMaterialEntryFromMetaText(materialText, testArena);
    if(!entry.has_value())
        return MakeUnexpected(Failure());
    const auto root = PrepareCaseRoot(testArena, caseName);
    if(!root.has_value())
        return MakeUnexpected(root.error());
    Expected<Material> built = MakeUnexpected(Failure());
    auto bind = ParseTestMaterialBindFromText(bindText, root.value(), testArena, scratch);
    if(bind.has_value()){
        bind.value().virtualPath = s_ProjectMaterialInterfacesTestSurface;
        Vector<MaterialBindEntry> bindings;
        bindings.push_back(bind.value());
        Vector<MaterialCookEntry> materials;
        materials.push_back(entry.value());
        if(ValidateMaterialCookInterfaces(bindings, materials))
            built = BuildMaterialAsset(materials[0u]);
    }
    if(!root.value().empty() && !GraphicsRemoveAllIfExists(root.value()).has_value())
        return MakeUnexpected(Failure());
    return built;
}

