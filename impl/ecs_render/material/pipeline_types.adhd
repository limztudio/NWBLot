enum<u8> MaterialPipelinePass{
    Opaque,
    CsgReceiverSurface,
    AvboitOccupancy,
    AvboitExtinction,
    AvboitAccumulate,
    AvboitRefractionCapture
}

enum<u8> RenderPath{
    MeshShader,
    VertexIndexed,
    ComputeEmulation
}

enum<u8> MaterialPipelineCsgMode{
    None,
    ClipOnly
}

enum<u8> RendererResourceLookupMode{
    CreateMissing = 0u,
    PreparedOnly = 1u
}

enum<u8> SampledTextureImportFailure{
    GraphUnavailable = 0u,
    MissingIdentity = 1u,
    ImportFailed = 2u
}

class MaterialPipelineCsgBindingUse{
    public b8 clip = false;
    public b8 avboitClip = false;
}

class ShaderVariantDefineAssignment{
    public ShaderVariantDefineAssignment(){
        this.name = "";
        this.assignment = "";
    }

    public ShaderVariantDefineAssignment(in StringView nameIn, in StringView assignmentIn){
        this.name = nameIn;
        this.assignment = assignmentIn;
    }

    public StringView name;
    public StringView assignment;
}

// Buffer identity alone does not describe which regions a retained draw generates and consumes.
class GeneratedGeometryOutputLayout{
    public b8 matches(in u32 indexByteOffset, in b8 indexed)const{
        return this.indexByteOffset == indexByteOffset && this.indexed == indexed;
    }

    public u32 indexByteOffset = 0u;
    public b8 indexed = false;
}

// Retain the selected draw metadata so recording rejects changed packet inputs before generating into the shared output.
class GeneratedGeometryEquivalenceKey{
    public b8 matches(
        in Name drawMeshKey,
        in Name drawMaterial,
        in MaterialPipelinePass drawPass,
        in MaterialPipelineCsgMode drawCsgMode,
        in u32 drawInstanceIndex,
        in u32 drawMaterialConstantByteOffset,
        in u32 drawShadingModelId,
        in b8 outputHeapValid,
        in u32 drawOutputHeapSlot,
        in u32 drawEmulationIndexByteOffset,
        in b8 drawIndexedGeometryOutput
    )const{
        return
            drawMeshKey == this.meshKey
            && drawMaterial == this.material
            && drawPass == this.pass
            && drawCsgMode == MaterialPipelineCsgMode::None
            && drawInstanceIndex == this.instanceIndex
            && drawMaterialConstantByteOffset == this.materialConstantByteOffset
            && drawShadingModelId == this.shadingModelId
            && outputHeapValid
            && drawOutputHeapSlot == this.outputHeapSlot
            && drawEmulationIndexByteOffset == this.emulationIndexByteOffset
            && drawIndexedGeometryOutput == this.indexedGeometryOutput
        ;
    }

    public Name meshKey = s_NameNone;
    public Name material = s_NameNone;
    public u32 instanceIndex = 0u;
    public u32 materialConstantByteOffset = 0u;
    public u32 shadingModelId = 0u;
    public u32 outputHeapSlot = 0u;
    public u32 emulationIndexByteOffset = 0u;
    public MaterialPipelinePass pass = MaterialPipelinePass::Opaque;
    public b8 indexedGeometryOutput = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MaterialPipelinePassUsesRendererAvboit(in MaterialPipelinePass pass){
    return pass == MaterialPipelinePass::AvboitOccupancy || pass == MaterialPipelinePass::AvboitExtinction || pass == MaterialPipelinePass::AvboitAccumulate || pass == MaterialPipelinePass::AvboitRefractionCapture;
}

b8 MaterialPipelinePassUsesRendererCsgShaderVariant(in MaterialPipelinePass pass){
    if(pass == MaterialPipelinePass::Opaque || pass == MaterialPipelinePass::CsgReceiverSurface)
        return true;
    return MaterialPipelinePassUsesRendererAvboit(pass);
}

b8 MaterialPipelinePassUsesRendererCsgClip(in MaterialPipelinePass pass, in b8 transparent){
    if(pass == MaterialPipelinePass::Opaque)
        return !transparent;
    if(pass == MaterialPipelinePass::CsgReceiverSurface)
        return true;
    return transparent && MaterialPipelinePassUsesRendererAvboit(pass);
}

MaterialPipelineCsgBindingUse MaterialPipelineResolveCsgBindingUse(in MaterialPipelineCsgMode csgMode, in MaterialPipelinePass pass){
    MaterialPipelineCsgBindingUse result;
    result.clip = csgMode != MaterialPipelineCsgMode::None && MaterialPipelinePassUsesRendererCsgShaderVariant(pass);
    result.avboitClip = result.clip && MaterialPipelinePassUsesRendererAvboit(pass);
    return result;
}

StringView VariantSegmentDefineName(in StringView segment){
    const usize equalPos = segment.find('=');
    if(equalPos >= segment.size())
        return "";
    return segment.substr(0u, equalPos);
}

Expected<StringView> TryFindVariantDefineAssignment(
    in StringView variant,
    in StringView defineName,
    in StringView defaultVariant
){
    if(variant.empty() || defineName.empty() || variant == defaultVariant)
        return makeUnexpected(Failure());

    usize begin = 0u;
    while(begin < variant.size()){
        usize segmentEnd = variant.find(';', begin);
        if(segmentEnd >= variant.size())
            segmentEnd = variant.size();

        const StringView segment = variant.substr(begin, segmentEnd - begin);
        const StringView segmentDefineName = VariantSegmentDefineName(segment);
        if(segmentDefineName.empty())
            return makeUnexpected(Failure());
        if(segmentDefineName == defineName){
            const usize valueBegin = segmentDefineName.size() + 1u;
            if(valueBegin >= segment.size())
                return makeUnexpected(Failure());
            return segment;
        }

        begin = segmentEnd + 1u;
    }
    return makeUnexpected(Failure());
}

Expected<String> TryBuildCsgClipShaderVariantText(
    in StringView baseVariant,
    in StringView defaultVariant,
    in Span<ShaderVariantDefineAssignment> defineAssignments
){
    String outVariant = "";
    const usize defineAssignmentCount = defineAssignments.size();
    if(baseVariant.empty() || defineAssignmentCount == 0u || defineAssignmentCount > s_MaxCsgClipShaderVariantDefineAssignments)
        return makeUnexpected(Failure());
    if(baseVariant == defaultVariant){
        Array<b8, s_MaxCsgClipShaderVariantDefineAssignments> insertedDefines;
        for(usize outputIndex = 0u; outputIndex < defineAssignmentCount; ++outputIndex){
            usize selectedIndex = defineAssignmentCount;
            for(usize i = 0u; i < defineAssignmentCount; ++i){
                if(insertedDefines[i])
                    continue;
                if(selectedIndex == defineAssignmentCount || defineAssignments[i].name < defineAssignments[selectedIndex].name)
                    selectedIndex = i;
            }
            if(selectedIndex == defineAssignmentCount)
                return makeUnexpected(Failure());
            if(!outVariant.empty())
                outVariant += ";";
            outVariant += defineAssignments[selectedIndex].assignment;
            insertedDefines[selectedIndex] = true;
        }
        return outVariant;
    }

    usize reserveSize = baseVariant.size();
    for(usize i = 0u; i < defineAssignmentCount; ++i)
        reserveSize += 1u + defineAssignments[i].assignment.size();
    outVariant.reserve(reserveSize);

    Array<b8, s_MaxCsgClipShaderVariantDefineAssignments> insertedDefines;
    usize begin = 0u;
    while(begin < baseVariant.size()){
        usize segmentEnd = baseVariant.find(';', begin);
        if(segmentEnd >= baseVariant.size())
            segmentEnd = baseVariant.size();

        const StringView segment = baseVariant.substr(begin, segmentEnd - begin);
        const StringView defineName = VariantSegmentDefineName(segment);
        if(defineName.empty())
            return makeUnexpected(Failure());

        for(usize step = 0u; step < defineAssignmentCount; ++step){
            usize selectedIndex = defineAssignmentCount;
            for(usize i = 0u; i < defineAssignmentCount; ++i){
                if(insertedDefines[i])
                    continue;
                if(defineName > defineAssignments[i].name && (selectedIndex == defineAssignmentCount || defineAssignments[i].name < defineAssignments[selectedIndex].name))
                    selectedIndex = i;
            }
            if(selectedIndex == defineAssignmentCount)
                break;
            if(!outVariant.empty())
                outVariant += ";";
            outVariant += defineAssignments[selectedIndex].assignment;
            insertedDefines[selectedIndex] = true;
        }

        b8 replacedExistingSegment = false;
        for(usize i = 0u; i < defineAssignmentCount; ++i){
            if(defineName != defineAssignments[i].name)
                continue;
            if(!outVariant.empty())
                outVariant += ";";
            outVariant += defineAssignments[i].assignment;
            insertedDefines[i] = true;
            replacedExistingSegment = true;
            break;
        }
        if(!replacedExistingSegment){
            if(!outVariant.empty())
                outVariant += ";";
            outVariant += segment;
        }

        begin = segmentEnd + 1u;
    }

    for(usize step = 0u; step < defineAssignmentCount; ++step){
        usize selectedIndex = defineAssignmentCount;
        for(usize i = 0u; i < defineAssignmentCount; ++i){
            if(insertedDefines[i])
                continue;
            if(selectedIndex == defineAssignmentCount || defineAssignments[i].name < defineAssignments[selectedIndex].name)
                selectedIndex = i;
        }
        if(selectedIndex == defineAssignmentCount)
            break;
        if(!outVariant.empty())
            outVariant += ";";
        outVariant += defineAssignments[selectedIndex].assignment;
        insertedDefines[selectedIndex] = true;
    }
    return outVariant;
}

usize ComputeMaterialPipelineBaseHash(
    in Name material,
    in MaterialPipelinePass pass,
    in b8 twoSided,
    in MaterialPipelineCsgMode csgMode,
    in Name csgEvaluatorVariant,
    in u64 csgShapeRegistryRevision,
    in u32 depthFormat,
    in u32 sampleCount,
    in u32 sampleQuality
){
    usize seed = hashValue(material);
    seed = hashCombineValue(seed, cast<u32>(pass));
    if(twoSided)
        seed = hashCombineValue(seed, 1u);
    else
        seed = hashCombineValue(seed, 0u);
    seed = hashCombineValue(seed, cast<u32>(csgMode));
    seed = hashCombineValue(seed, hashValue(csgEvaluatorVariant));
    seed = hashCombineValue(seed, csgShapeRegistryRevision);
    seed = hashCombineValue(seed, depthFormat);
    seed = hashCombineValue(seed, sampleCount);
    return hashCombineValue(seed, sampleQuality);
}

b8 MeshletConeCullScaleSafe(in VectorSingle scale){
    if(!isFinite(scale.x) || !isFinite(scale.y) || !isFinite(scale.z))
        return false;
    if(scale.x <= 0.0f || scale.y <= 0.0f || scale.z <= 0.0f)
        return false;

    f32 minScale = min(scale.x, min(scale.y, scale.z));
    f32 maxScale = max(scale.x, max(scale.y, scale.z));
    f32 tolerance = max(maxScale, 1.0f) * s_MeshletConeCullUniformScaleEpsilon;
    return (maxScale - minScale) <= tolerance;
}

u32 ResolveMeshDispatchFlags(
    in b8 runtimeMesh,
    in b8 dynamicMeshletBoundsFresh,
    in b8 dynamicMeshletConesFresh,
    in MaterialPipelinePass pass,
    in b8 twoSided,
    in b8 meshletConeCullScaleSafe
){
    u32 flags = 0u;
    b8 meshletBoundsFresh = !runtimeMesh || dynamicMeshletBoundsFresh;
    b8 meshletConesFresh = !runtimeMesh || dynamicMeshletConesFresh;
    if(meshletBoundsFresh)
        flags |= s_MeshDispatchFlagMeshletFrustumCull;
    if(meshletConesFresh && pass == MaterialPipelinePass::Opaque && !twoSided && meshletConeCullScaleSafe)
        flags |= s_MeshDispatchFlagMeshletConeCull;
    if(!runtimeMesh)
        flags |= s_MeshDispatchFlagCsgMeshletFullyRemovedCull;
    return flags;
}

u32 ResolveMaterialPassDrawDispatchFlags(
    in b8 runtimeMesh,
    in b8 dynamicMeshletBoundsFresh,
    in b8 dynamicMeshletConesFresh,
    in MaterialPipelinePass pass,
    in b8 twoSided,
    in b8 meshletConeCullScaleSafe,
    in MaterialPipelineCsgMode csgMode,
    in u32 shadingModelId
){
    u32 flags = ResolveMeshDispatchFlags(runtimeMesh, dynamicMeshletBoundsFresh, dynamicMeshletConesFresh, pass, twoSided, meshletConeCullScaleSafe);
    if(csgMode != MaterialPipelineCsgMode::None)
        flags &= ~s_MeshDispatchFlagCsgMeshletFullyRemovedCull;
    flags = (flags & s_MeshDispatchFlagMask) | ((shadingModelId & s_MeshDispatchShadingModelMask) << s_MeshDispatchShadingModelShift);
    return flags;
}

Name ResolveAvboitPixelShaderDebugName(in MaterialPipelinePass pass){
    switch(pass){
    case MaterialPipelinePass::AvboitOccupancy:
        return s_AvboitOccupancyPsDebugName;
    case MaterialPipelinePass::AvboitExtinction:
        return s_AvboitExtinctionPsDebugName;
    case MaterialPipelinePass::AvboitAccumulate:
        return s_AvboitAccumulatePsDebugName;
    case MaterialPipelinePass::AvboitRefractionCapture:
        return s_AvboitRefractionCapturePsDebugName;
    default:
        return s_InvalidAvboitPixelShaderDebugName;
    }
}


