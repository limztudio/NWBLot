[subsystem("ui_subsystem")]
class UiSubsystem{
    public Vector<AssetRef<FontAtlas>> basicFonts;
    public AssetRef<UiSkin> basicSkin;
    public AssetRef<PixelShader> outputPs;
    public AssetRef<VertexShader> outputVs;
    public AssetRef<PixelShader> ps;
    public AssetRef<VertexShader> vs;
}


