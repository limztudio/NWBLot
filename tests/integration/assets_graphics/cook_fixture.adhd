b8 RunGraphicsParserFailureIteration(mut TestArena ownerArena, in DiscoveredNwbFile file, in MetaDocument document, mut GraphicsScratchArena scratch){
    ParsedAssetMetadata metadata(ownerArena.arena);
    AssetDocumentMetadataParseContext context(ownerArena.arena, file, DescribeAssetType<ComputeShader>().name, document, metadata, scratch.arena);
    const b8 errored = TryAutoCollectedDocumentMetadataParsers(context) == AssetMetadataParseResult::Error;
    EXPECT_EQ(ExtensionMap(metadata).size(), 1u);
    EXPECT_GT(ownerArena.memoryStats().usedBytes, 0u);
    return errored;
}

CompactString RegistrySamplerStem(in usize identity){
    CompactString name("sampler_");
    if(identity < 100u)
        EXPECT_TRUE(name.append("0"));
    if(identity < 10u)
        EXPECT_TRUE(name.append("0"));
    AppendUnsignedDecimal(name, identity);
    return name;
}

void AppendMetadataRegistrySamplerFile(mut TestArena fixtureArena, in GraphicsTestPath root, in StringView samplerFields, in usize identity, mut DiscoveredNwbFileVector outFiles){
    CompactString filename = RegistrySamplerStem(identity);
    ASSERT_TRUE(filename.append(".nwb"));
    const GraphicsTestPath path = JoinGraphicsPath(root, filename.view());
    AssetString source(samplerFields, fixtureArena.arena);
    GraphicsStringAppendFormat(source, "asset.mip_bias = {};\r\n", identity);
    ASSERT_TRUE(WriteGraphicsText(path, StringView(source)));
    const String normalized = PathToString(path.lexicallyNormal());
    outFiles.emplace_back(fixtureArena.arena, root, path, normalized, s_ProjectVirtualRoot);
}

void VerifyMetadataRegistryStoragePass(mut TestArena fixtureArena, mut TestArena parseArena, in GraphicsTestPath root, in DiscoveredNwbFileVector files, mut CpuTaskScheduler cpuScheduler, in usize samplerCount, in b8 rejectDuplicate){
    GraphicsScratchArena scratch(s_AssetCaseTestsMetadataRegistryScratch);
    ParsedAssetMetadata metadata(parseArena.arena);
    ASSERT_TRUE(RegisterAutoCollectedCookEntryTypes(metadata.entryRegistry, scratch.arena));
    mut HeapStorageVector<SamplerCookEntry> samplers = GraphicsRegistryEntries<SamplerCookEntry>(metadata.entryRegistry, DescribeAssetType<Sampler>().name);
    in HeapStorageVector<ModelCookEntry> models = GraphicsRegistryEntries<ModelCookEntry>(metadata.entryRegistry, DescribeAssetType<Model>().name);
    const GraphicsTestPath emptyPath(fixtureArena.arena);
    EXPECT_EQ(ParseGraphicsAssetMetadata(files, root, emptyPath, parseArena.arena, cpuScheduler, scratch.arena, metadata), !rejectDuplicate);
    ASSERT_EQ(samplers.size(), samplerCount);
    EXPECT_GE(samplers.capacity(), samplerCount);
    EXPECT_TRUE(models.empty());
    EXPECT_EQ(models.capacity(), 0u);
    EXPECT_TRUE(ExtensionMap(metadata).empty());
    EXPECT_EQ(metadata.entryRegistry.entryCount(), samplerCount);
    for(usize index = 0u; index < samplerCount; ++index){
        const usize identity = (index * 37u) % samplerCount;
        CompactString path("project/");
        ASSERT_TRUE(path.append(RegistrySamplerStem(identity).view()));
        const auto expected = ToName(path.view());
        ASSERT_TRUE(expected.has_value());
        ASSERT_TRUE(expected.value().has_value());
        EXPECT_EQ(samplers[index].virtualPath, expected.value().value());
        EXPECT_TRUE(TestUsesStorage(samplers, parseArena));
        EXPECT_FLOAT_EQ(samplers[index].description.mipBias, cast<f32>(identity));
    }
}

