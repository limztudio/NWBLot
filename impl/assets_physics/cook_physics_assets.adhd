    return ParseCookMetadataDocument<CollisionLayerMatrixCookEntry>(root, virtualRoot, file, document, s_CollisionLayerMatrixDiagnosticPrefix, lambda[in file](in Name path, in MetascriptValue value) -> Expected<CollisionLayerMatrixCookEntry>{
