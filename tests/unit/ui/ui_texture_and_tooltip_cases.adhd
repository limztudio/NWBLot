const u32 s_UiTextureQuietNaNF32Bits = 0x7fc00000u;
const u32 s_UiTexturePosInfF32Bits = 0x7f800000u;
const u32 s_UiTextureNegInfF32Bits = 0xff800000u;
const u32 s_UiTextureMaxF32Bits = 0x7f7fffffu;
const AStringView s_UiTexturePanelKey = "panel";
const AStringView s_UiTextureBeforeKey = "before";
const AStringView s_UiTextureCopiedImagePath = "tests/ui/copied_builder_image";
const AStringView s_UiTextureFrozenImagePath = "tests/ui/frozen_builder_image";
const AStringView s_UiTextureVersionedImagePath = "tests/ui/versioned_builder_image";
const AStringView s_UiTextureCapacityImagePath = "tests/ui/capacity_image";
const AStringView s_UiTextureLayoutVersionImagePath = "tests/ui/layout_version";
const u64 s_UiTooltipDeclaration = 17u;


class UiTextureImagePaintSample{
    public usize quads = 0u;
    public Rect bounds = Rect();
    public Rect uv = Rect();
    public Color color = Color();
    public u32 layer = 0u;
}

class UiTooltipTestBinding{
    public WidgetId anchor = WidgetId();
    public u64 declaration = 0u;
    public PopupToken popup = PopupToken();
}

UiTooltipTestBinding MakeUiTooltipTestBinding(in WidgetId inAnchor, in u64 inDeclaration, in PopupToken inPopup){
    UiTooltipTestBinding binding = UiTooltipTestBinding();
    binding.anchor = inAnchor;
    binding.declaration = inDeclaration;
    binding.popup = inPopup;
    return binding;
}


Expected<UiTextureImagePaintSample> SampleUiTextureImage(in DrawSnapshot snapshot, in u64 generation){
    UiTextureImagePaintSample candidate = UiTextureImagePaintSample();
    // Lanes are x, y.
    f32 originX = 0.0f;
    f32 originY = 0.0f;
    f32 cornerX = 0.0f;
    f32 cornerY = 0.0f;
    const usize commandCount = snapshot.commands().size();
    for(usize cmdIndex = 0u; cmdIndex < commandCount; ++cmdIndex){
        const DrawCommand command = snapshot.commands()[cmdIndex];
        if(command.material != PaintMaterial::Image || command.textureImageIndex >= snapshot.textureImages().size())
            continue;
        if(!UiTextureImageMatchesGeneration(snapshot.textureImages()[command.textureImageIndex], generation))
            continue;
        for(u32 index = command.firstIndex; index + 5u < command.firstIndex + command.indexCount; index += 6u){
            const Vertex first = snapshot.vertices()[snapshot.indices()[index]];
            const Vertex opposite = snapshot.vertices()[snapshot.indices()[index + 2u]];
            if(candidate.quads == 0u){
                originX = first.position.x;
                originY = first.position.y;
                cornerX = opposite.position.x;
                cornerY = opposite.position.y;
                const VectorSingle uvSize = VectorSingle(opposite.texCoord.x, opposite.texCoord.y, 0.0f, 0.0f) - VectorSingle(first.texCoord.x, first.texCoord.y, 0.0f, 0.0f);
                candidate.uv = Rect(first.texCoord.x, first.texCoord.y, uvSize.x, uvSize.y);
                candidate.color = first.color;
                candidate.layer = command.layer;
            }
            originX = Min(originX, first.position.x);
            originY = Min(originY, first.position.y);
            cornerX = Max(cornerX, opposite.position.x);
            cornerY = Max(cornerY, opposite.position.y);
            ++candidate.quads;
        }
    }
    if(candidate.quads == 0u)
        return MakeUnexpected(Failure());
    candidate.bounds = Rect(originX, originY, cornerX - originX, cornerY - originY);
    return candidate;
}

PopupOptions MakeUiTextureParentOptions(){
    PopupOptions options = PopupOptions();
    options.anchor = Rect(20.0f, 20.0f, 80.0f, 20.0f);
    options.size = Point(300.0f, 280.0f);
    return options;
}

PopupOptions MakeUiTextureChildOptions(){
    PopupOptions options = PopupOptions();
    options.anchor = Rect(420.0f, 20.0f, 80.0f, 20.0f);
    options.size = Point(280.0f, 240.0f);
    return options;
}

InputEvent MakeUiTextureTabKeyEvent(in InputEventTypeEnum eventType){
    InputEvent event = InputEvent();
    event.key = UiTextureKey::Tab;
    event.type = eventType;
    return event;
}

WidgetId MakeUiTooltipAnchor(){
    return WidgetId(201u);
}

PopupToken MakeUiTooltipPopup(){
    PopupToken token = PopupToken();
    token.widget = WidgetId(301u);
    token.declarationGeneration = 19u;
    token.instanceGeneration = 23u;
    token.openGeneration = 7u;
    return token;
}

PopupToken MakeUiTooltipPartialPopup(in WidgetId widget, in u64 declaration, in u64 instance, in u64 openGen){
    PopupToken token = PopupToken();
    token.widget = widget;
    token.declarationGeneration = declaration;
    token.instanceGeneration = instance;
    token.openGeneration = openGen;
    return token;
}


