#include <impl/assets_material/cook_shader_metadata_and_asset_emit.adhd>
#include <impl/assets_shader/shader_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MaterialStageDependency{
    public Name path = s_NameNone;
    public Name assetType = s_NameNone;
}

b8 IsValidMaterialResourceDependencyName(in b8 parsedOk, in Name resourceName){
    return parsedOk && resourceName != s_NameNone;
}

b8 IsMaterialResourceParameterValue(in StringView valueText){
    const StringView trimmed = TrimView(valueText);
    if(!IsMaterialResourceParameterCandidate(trimmed))
        return false;
    return HasReservedAssetVirtualRoot(trimmed);
}

Expected<Vector<Name>> CollectSortedMaterialResourceDependencyNames(
    in HashMap<CompactString, CompactString> parameters
){
    Vector<StringView> resourceParameterValues;
    resourceParameterValues.reserve(parameters.size());
    for(in auto entry : parameters){
        const StringView valueView = TrimView(entry.second.view());
        if(IsMaterialResourceParameterValue(valueView))
            resourceParameterValues.push_back(valueView);
    }

    for(usize i = 1u; i < resourceParameterValues.size(); ++i){
        const StringView current = resourceParameterValues[i];
        usize j = i;
        while(j > 0u && current < resourceParameterValues[j - 1u]){
            resourceParameterValues[j] = resourceParameterValues[j - 1u];
            --j;
        }
        resourceParameterValues[j] = current;
    }

    Vector<Name> resourceNames;
    resourceNames.reserve(resourceParameterValues.size());
    for(in StringView resourceValue : resourceParameterValues){
        const Expected<Optional<Name>, NameTextError> resourceName = ToName(resourceValue);
        Name resolvedName = s_NameNone;
        if(resourceName.has_value() && resourceName.value().has_value())
            resolvedName = resourceName.value().value();
        if(!IsValidMaterialResourceDependencyName(resourceName.has_value() && resourceName.value().has_value(), resolvedName))
            return MakeUnexpected(Failure());
        resourceNames.push_back(resolvedName);
    }
    return resourceNames;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


register_asset Material using NonStandaloneAssetRegistration<Material>;

[cook_entry("material", s_MaterialMetaDiagnosticPrefix, ParseMaterialCookMetadata, document_only, quiet)]
Expected<Material> CookMaterialVolumeEntry(in MaterialCookEntry entry){
    return BuildMaterialAsset(entry);
}

b8 CollectMaterialDependencies(in MaterialCookEntry entry, mut ICookDependencyCollector collector){
    Vector<MaterialStageDependency> stages;
    stages.reserve(entry.stageShaders.size());
    for(in auto pair : entry.stageShaders){
        MaterialStageDependency dependency;
        dependency.path = pair.second.name();
        dependency.assetType = AssetTypeNameFromShaderType(pair.first);
        if(dependency.assetType == s_NameNone)
            return false;
        stages.push_back(dependency);
    }
    SortSequence<MaterialStageDependency>(stages, lambda[](in MaterialStageDependency lhs, in MaterialStageDependency rhs) -> b8{
        if(lhs.path != rhs.path)
            return lhs.path < rhs.path;
        return lhs.assetType < rhs.assetType;
    });
    for(in MaterialStageDependency stage : stages){
        if(!collector.addAssetDependency(stage.path, stage.assetType))
            return false;
    }
    const Expected<Vector<Name>> resources = CollectSortedMaterialResourceDependencyNames(entry.parameters);
    if(!resources.has_value())
        return false;
    for(in Name resource : resources.value()){
        if(!collector.addAssetDependency(resource))
            return false;
    }
    return true;
}

b8 ExtractMaterialDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    in CookDependencyItemContext contextRef = context;
    return context.visitDocument(lambda[in contextRef, mut collector](in MetascriptDocument doc) -> b8{
        const Expected<MaterialCookEntry> entry = ParseMaterialCookMetadata(contextRef.assetRoot, contextRef.virtualRoot, contextRef.nwbFilePath, doc);
        return entry.has_value() && CollectMaterialDependencies(entry.value(), collector);
    });
}

[cook_registrar]
b8 RegisterMaterialDependencies(mut CookDependencyRegistry registry){
    return registry.registerType(Material::AssetTypeName(), ExtractMaterialDependencies);
}


