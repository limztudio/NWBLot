void VerifyCrash_SpoolAdmissionPreservesFilesystemCategoryAndCodeAfterUnlock(){
    if(!IsDesktopCrashPlatform())
        return;

    const StringView group = "crash_failed_spool_admission";
    RemoveTestArtifacts(group);
    const Path caseDirectory = TestCaseDirectory(group);
    ASSERT_TRUE(EnsureDirectories(caseDirectory).has_value());
    const Path blocked = caseDirectory / "blocked";
    ASSERT_TRUE(WriteTextFile(blocked, "This file cannot be a parent directory.\n"));
    const Path spoolDirectory = blocked / s_SpoolDirectoryName;
    const Path pendingDirectory = spoolDirectory / s_PendingDirectoryName;
    UninstallCrashHandler();

    const auto failure = EnsureDirectories(pendingDirectory);
    ASSERT_FALSE(failure.has_value());
    const String expectedCategory = StringFormat("category={}", NativeErrorCategory(failure.error()));
    const String expectedCode = StringFormat("code={}", failure.error().value());
    CrashDiagnosticObserver observed("crash_native_lifecycle", true);
    CrashDiagnosticSubscription<CrashDiagnosticObserver> registration(observed);
    PersistentStorage installArena(s_InstallArena, PersistentArenaStructureAlignedSize(64u * 1024u));
    TestValueSlot<PersistentCrashConfig> slot;
    mut PersistentCrashConfig config = slot.constructIn(installArena);
    config.applicationName = "bad-spool-admission";
    config.spoolDirectory = spoolDirectory;
    EXPECT_FALSE(InstallCrashHandler(config));
    in CrashRuntimeState state = TestCrashState();
    EXPECT_FALSE(state.installed);
    EXPECT_FALSE(state.handlerStarted);
    EXPECT_FALSE(state.platformRestorePending);
    EXPECT_EQ(observed.count, 1u);
    EXPECT_EQ(observed.unlocked, 1u);
    EXPECT_EQ(FixedBufferView(observed.operation), "prepare_spool");
    EXPECT_TRUE(Contains(FixedBufferView(observed.message), StringView(expectedCategory)));
    EXPECT_TRUE(Contains(FixedBufferView(observed.message), StringView(expectedCode)));
    UninstallCrashHandler();
    RemoveTestArtifacts(group);
}

void VerifyExecutableAdmission(in Path spoolDirectory, in StringView executable){
    CrashDiagnosticObserver observed("crash_native_lifecycle", true);
    CrashDiagnosticSubscription<CrashDiagnosticObserver> registration(observed);
    PersistentStorage installArena(s_InstallArena, PersistentArenaStructureAlignedSize(64u * 1024u));
    TestValueSlot<PersistentCrashConfig> slot;
    mut PersistentCrashConfig config = slot.constructIn(installArena);

    config.applicationName = "bad-executable-admission";
    config.spoolDirectory = spoolDirectory;
    config.handlerExecutablePath = executable;
    EXPECT_FALSE(InstallCrashHandler(config));

    const Optional<usize> before = ProcessHandleCount();
    ASSERT_TRUE(before.has_value());
    in CrashRuntimeState state = TestCrashState();
    for(u32 attempt = 0u; attempt < 4u; ++attempt){
        EXPECT_FALSE(InstallCrashHandler(config));
        EXPECT_FALSE(state.installed);
        EXPECT_FALSE(state.handlerStarted);
        EXPECT_FALSE(state.platformRestorePending);
    }
    const Optional<usize> after = ProcessHandleCount();
    ASSERT_TRUE(after.has_value());
    EXPECT_EQ(after.value(), before.value());
    EXPECT_EQ(observed.count, 5u);
    EXPECT_EQ(observed.unlocked, observed.count);
    EXPECT_TRUE(Contains(FixedBufferView(observed.message), "code="));
}

void VerifyCrash_FailedExecutableAdmissionReleasesResourcesAndObservesFailureAfterUnlock(){
    if(!IsDesktopCrashPlatform())
        return;

    const StringView group = "crash_bad_executable_admission";
    RemoveTestArtifacts(group);
    const Path caseDirectory = TestCaseDirectory(group);
    ASSERT_TRUE(EnsureDirectories(caseDirectory).has_value());
    const Path invalidExecutable = caseDirectory / "invalid_handler";
    ASSERT_TRUE(WriteTextFile(invalidExecutable, "This is not an executable image.\n"));
    const Path spoolDirectory = SpoolDirectory(group);
    UninstallCrashHandler();

    ASSERT_TRUE(SetOwnerExecutable(invalidExecutable));
    const String executable = PathToString(invalidExecutable);
    VerifyExecutableAdmission(spoolDirectory, StringView(executable));
    UninstallCrashHandler();
    RemoveTestArtifacts(group);
}

void VerifyCrash_MetadataRejectsTruncationAndEmbeddedNullWithoutChangingPublishedValue(){
    const StringView key = "bounded_metadata";
    ASSERT_TRUE(SetCrashMetadata(key, "original"));
    b8 found = false;
    const String longKey(s_CrashMaxShortText, 107);
    const String longValue(s_CrashMaxMediumText, 118);
    const StringView embedded = StringView("a\0b", 3u);
    EXPECT_TRUE(SetCrashMetadata(StringView(longKey).substr(0u, longKey.size() - 1u), StringView(longValue).substr(0u, longValue.size() - 1u)));
    EXPECT_FALSE(SetCrashMetadata(StringView(longKey), "value"));
    EXPECT_FALSE(SetCrashMetadata(key, StringView(longValue)));
    EXPECT_FALSE(SetCrashMetadata(embedded, "value"));
    EXPECT_FALSE(SetCrashMetadata(key, embedded));
    const CrashRequest request = BuildCrashDumpRequest(RequestReason::ManualDump, 0u, CrashRequestOptions());
    for(u32 i = 0u; i < request.metadataCount; ++i){
        if(FixedBufferView(request.metadata[i].key) == key){
            found = true;
            EXPECT_EQ(FixedBufferView(request.metadata[i].value), "original");
        }
    }
    EXPECT_TRUE(found);
}

void VerifyCrash_SnapshotKeepsPublishedMetadataDuringInterruptedWriter(){
    const StringView key = "snapshot_interrupted_writer";
    const StringView published = "published_complete_value";
    ASSERT_TRUE(SetCrashMetadata(key, published));

    CrashRequest request = CrashRequest();
    b8 exercisedWriter = false;
    b8 found = false;
    mut CrashRuntimeState state = TestCrashState();
    const FutexGuard guard = AcquireFutex(state.mutex);
    for(mut CrashMetadata metadata : state.metadata){
        if(metadata.used == 0u || FixedBufferView(metadata.key) != key)
            continue;
        const CrashMetadata original = metadata;
        CopyFixedBuffer(metadata.value, "unpublished_partial_value");
        request = BuildCrashDumpRequest(RequestReason::ManualDump, 0u, CrashRequestOptions());
        metadata = original;
        exercisedWriter = true;
        break;
    }
    for(u32 i = 0u; i < request.metadataCount; ++i){
        if(FixedBufferView(request.metadata[i].key) == key){
            EXPECT_EQ(FixedBufferView(request.metadata[i].value), published);
            found = true;
        }
    }
    ASSERT_TRUE(exercisedWriter);
    EXPECT_TRUE(found);
}

void VerifyCrash_ConcurrentPublicWritersPublishCompleteMetadataAndBreadcrumbRecords(){
    const StringView key = "snapshot_concurrent_writer";
    const StringView category = "snapshot_concurrent_breadcrumb";
    const usize iterations = 2000u;
    const String first(s_CrashMaxMediumText - 1u, 97);
    const String second(s_CrashMaxMediumText - 1u, 98);
    const StringView firstText = first;
    const StringView secondText = second;
    ASSERT_TRUE(SetCrashMetadata(key, firstText));
    TestAtomic<u32> failures(0u);
    Latch start(2);
    JoiningThread writer(lambda[mut start, in firstText, in secondText, in key, in category, mut failures]() -> void{
        start.arrive_and_wait();
        for(usize i = 0u; i < iterations; ++i){
            StringView text = secondText;
            if((i & 1u) != 0u)
                text = firstText;
            if(!SetCrashMetadata(key, text))
                failures.fetch_add(1u, MemoryOrder::relaxed);
            AddCrashBreadcrumb(category, text);
        }
    });
    start.arrive_and_wait();
    for(usize iteration = 0u; iteration < iterations; ++iteration){
        const CrashRequest request = BuildCrashDumpRequest(RequestReason::ManualDump, 0u, CrashRequestOptions());
        b8 found = false;
        for(u32 i = 0u; i < request.metadataCount; ++i){
            in CrashMetadata metadata = request.metadata[i];
            if(FixedBufferView(metadata.key) != key)
                continue;
            const StringView value = FixedBufferView(metadata.value);
            if(value != firstText && value != secondText)
                failures.fetch_add(1u, MemoryOrder::relaxed);
            found = true;
        }
        if(!found)
            failures.fetch_add(1u, MemoryOrder::relaxed);
        for(u32 i = 0u; i < request.breadcrumbCount; ++i){
            in CrashBreadcrumb breadcrumb = request.breadcrumbs[i];
            if(FixedBufferView(breadcrumb.category) != category)
                continue;
            const StringView message = FixedBufferView(breadcrumb.message);
            if(message != firstText && message != secondText)
                failures.fetch_add(1u, MemoryOrder::relaxed);
        }
    }
    writer.join();
    const u32 failureCount = failures.load(MemoryOrder::relaxed);
    EXPECT_EQ(failureCount, 0u);
}

void VerifyCrash_WriteCrashPackageFailsWhenSpoolPathIsFile(){
    const StringView group = "crash_package_bad_spool_test";
    RemoveTestArtifacts(group);

    const Path caseDirectory = TestCaseDirectory(group);
    const Path spoolPath = SpoolDirectory(group);
    EXPECT_TRUE(EnsureDirectories(caseDirectory).has_value());
    EXPECT_TRUE(WriteTextFile(spoolPath, "not a directory"));

    CrashRequest request = CrashRequest();
    FillPackageRequest(spoolPath, "crash-package-bad-spool", request);
    EXPECT_FALSE(WriteCrashPackage(request));

    RemoveTestArtifacts(group);
}

void VerifyCrash_CrashSpoolRetentionPrunesOldestPackages(){
    ScratchStorage testArena(s_OperationScratch);
    const StringView group = "crash_spool_retention_test";
    RemoveTestArtifacts(group);

    EXPECT_TRUE(CreatePackageDirectory(group, s_PendingDirectoryName, s_Crash001));
    EXPECT_TRUE(CreatePackageDirectory(group, s_PendingDirectoryName, s_Crash002));
    EXPECT_TRUE(CreatePackageDirectory(group, s_PendingDirectoryName, s_Crash003));
    EXPECT_TRUE(CreatePackageDirectory(group, s_PendingDirectoryName, "bad package name"));
    EXPECT_TRUE(CreatePackageDirectory(group, s_UploadedDirectoryName, s_Crash001));
    EXPECT_TRUE(CreatePackageDirectory(group, s_UploadedDirectoryName, s_Crash002));
    EXPECT_TRUE(CreatePackageDirectory(group, s_FailedDirectoryName, s_Crash001));
    EXPECT_TRUE(CreatePackageDirectory(group, s_FailedDirectoryName, s_Crash002));
    EXPECT_TRUE(CreatePackageDirectory(group, s_UploadingDirectoryName, s_Crash001));
    EXPECT_TRUE(CreatePackageDirectory(group, s_UploadingDirectoryName, s_Crash002));

    CrashSpoolRetentionConfig retention = CrashSpoolRetentionConfig();
    retention.maxPendingPackages = 2u;
    retention.maxUploadedPackages = 1u;
    retention.maxFailedPackages = 1u;
    retention.maxUploadingPackages = 1u;
    EXPECT_TRUE(RetainTestCrashPackages(testArena, SpoolDirectory(group), retention, "").has_value());

    ExpectPathExists(PackageDirectory(group, s_PendingDirectoryName, s_Crash001), false);
    ExpectIsDirectory(PackageDirectory(group, s_PendingDirectoryName, s_Crash002), true);
    ExpectIsDirectory(PackageDirectory(group, s_PendingDirectoryName, s_Crash003), true);
    ExpectIsDirectory(PackageDirectory(group, s_PendingDirectoryName, "bad package name"), true);
    ExpectPathExists(PackageDirectory(group, s_UploadedDirectoryName, s_Crash001), false);
    ExpectIsDirectory(PackageDirectory(group, s_UploadedDirectoryName, s_Crash002), true);
    ExpectPathExists(PackageDirectory(group, s_FailedDirectoryName, s_Crash001), false);
    ExpectIsDirectory(PackageDirectory(group, s_FailedDirectoryName, s_Crash002), true);
    ExpectPathExists(PackageDirectory(group, s_UploadingDirectoryName, s_Crash001), false);
    ExpectIsDirectory(PackageDirectory(group, s_UploadingDirectoryName, s_Crash002), true);

    RemoveTestArtifacts(group);
}

void VerifyCrash_CrashSpoolRetentionZeroDisablesPruning(){
    ScratchStorage testArena(s_OperationScratch);
    const StringView group = "crash_spool_retention_zero_test";
    RemoveTestArtifacts(group);

    EXPECT_TRUE(CreatePackageDirectory(group, s_PendingDirectoryName, s_Crash001));
    EXPECT_TRUE(CreatePackageDirectory(group, s_PendingDirectoryName, s_Crash002));

    CrashSpoolRetentionConfig retention = CrashSpoolRetentionConfig();
    retention.maxPendingPackages = 0u;
    retention.maxUploadedPackages = 0u;
    retention.maxFailedPackages = 0u;
    retention.maxUploadingPackages = 0u;
    EXPECT_TRUE(RetainTestCrashPackages(testArena, SpoolDirectory(group), retention, "").has_value());

    ExpectIsDirectory(PackageDirectory(group, s_PendingDirectoryName, s_Crash001), true);
    ExpectIsDirectory(PackageDirectory(group, s_PendingDirectoryName, s_Crash002), true);

    RemoveTestArtifacts(group);
}

void VerifyCrash_CrashSpoolRetentionProtectsActivePendingPackage(){
    ScratchStorage testArena(s_OperationScratch);
    const StringView group = "crash_spool_retention_protect_test";
    RemoveTestArtifacts(group);

    EXPECT_TRUE(CreatePackageDirectory(group, s_PendingDirectoryName, s_Crash001));
    EXPECT_TRUE(CreatePackageDirectory(group, s_PendingDirectoryName, s_Crash002));
    EXPECT_TRUE(CreatePackageDirectory(group, s_PendingDirectoryName, s_Crash003));

    CrashSpoolRetentionConfig retention = CrashSpoolRetentionConfig();
    retention.maxPendingPackages = 1u;
    retention.maxUploadedPackages = 0u;
    retention.maxFailedPackages = 0u;
    retention.maxUploadingPackages = 0u;
    EXPECT_TRUE(RetainTestCrashPackages(testArena, SpoolDirectory(group), retention, "crash-001").has_value());

    ExpectIsDirectory(PackageDirectory(group, s_PendingDirectoryName, s_Crash001), true);
    ExpectPathExists(PackageDirectory(group, s_PendingDirectoryName, s_Crash002), false);
    ExpectIsDirectory(PackageDirectory(group, s_PendingDirectoryName, s_Crash003), true);

    RemoveTestArtifacts(group);
}

void VerifyCrash_FlushReportsFailsWhenUploadingRecoveryIsBlocked(){
    HeapStorage testArena;
    const StringView group = "crash_uploading_recovery_blocked_test";
    const StringView crashId = "crash-recovery-blocked";
    RemoveTestArtifacts(group);

    EXPECT_TRUE(CreatePackageDirectory(group, s_UploadingDirectoryName, crashId));
    const Path blockedBucket = BucketDirectory(group, s_PendingDirectoryName);
    const Path spoolPath = SpoolDirectory(group);
    EXPECT_TRUE(WriteTextFile(blockedBucket, "blocked"));
    CrashUploadSnapshot snapshot = CrashUploadSnapshot();
    CopyCrashPath(spoolPath, snapshot.spoolDirectory);
    CopyFixedBuffer(snapshot.logServerUrl, "http://127.0.0.1:1");

    EXPECT_FALSE(FlushTestCrashReports(testArena, snapshot));
    ExpectIsDirectory(PackageDirectory(group, s_UploadingDirectoryName, crashId), true);
    ExpectIsRegularFile(blockedBucket, true);
    EXPECT_TRUE(TextFileContains(PackageDirectory(group, s_UploadingDirectoryName, crashId) / s_UploadAttemptFileName, s_UploadAttemptRetryInterruptedState));

    RemoveTestArtifacts(group);
}

NWB_ADHD_GTEST(Crash, MetadataRejectsTruncationAndEmbeddedNullWithoutChangingPublishedValue, VerifyCrash_MetadataRejectsTruncationAndEmbeddedNullWithoutChangingPublishedValue)
NWB_ADHD_GTEST(Crash, SnapshotKeepsPublishedMetadataDuringInterruptedWriter, VerifyCrash_SnapshotKeepsPublishedMetadataDuringInterruptedWriter)
NWB_ADHD_GTEST(Crash, ConcurrentPublicWritersPublishCompleteMetadataAndBreadcrumbRecords, VerifyCrash_ConcurrentPublicWritersPublishCompleteMetadataAndBreadcrumbRecords)
NWB_ADHD_GTEST(Crash, WriteCrashPackageFailsWhenSpoolPathIsFile, VerifyCrash_WriteCrashPackageFailsWhenSpoolPathIsFile)
NWB_ADHD_GTEST(Crash, CrashSpoolRetentionPrunesOldestPackages, VerifyCrash_CrashSpoolRetentionPrunesOldestPackages)
NWB_ADHD_GTEST(Crash, CrashSpoolRetentionZeroDisablesPruning, VerifyCrash_CrashSpoolRetentionZeroDisablesPruning)
NWB_ADHD_GTEST(Crash, CrashSpoolRetentionProtectsActivePendingPackage, VerifyCrash_CrashSpoolRetentionProtectsActivePendingPackage)
NWB_ADHD_GTEST(Crash, FlushReportsFailsWhenUploadingRecoveryIsBlocked, VerifyCrash_FlushReportsFailsWhenUploadingRecoveryIsBlocked)


