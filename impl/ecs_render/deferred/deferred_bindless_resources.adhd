const Name s_DeferredBindlessSlotsBufferName = "ECSRender_DeferredBindlessResourceSlots";


void LogDeferredBindlessHeapMissing(){
    error("RendererSystem: deferred lighting/compositor requires the global descriptor heap");
}

void LogDeferredBindlessRegistrationFailed(){
    error("RendererSystem: failed to register deferred frame resources in the descriptor heap");
}

void LogDeferredBindlessSlotBufferCreateFailed(){
    error("RendererSystem: failed to create deferred bindless slot buffer");
}

void LogDeferredBindlessSlotBufferRegisterFailed(){
    error("RendererSystem: failed to register deferred bindless slot buffer in the descriptor heap");
}

b8 AssignDeferredSampled2D(
    mut GpuDescriptorHeap heap,
    in TextureHandle texture,
    in Format format,
    mut GpuDescriptorHandle outHandle
){
    return AssignSampledTexture(
        heap,
        GpuDescriptorClass::SampledImage,
        texture,
        format,
        s_FramebufferSubresources,
        TextureDimension::Texture2D,
        outHandle
    );
}

b8 AssignDeferredStorage2D(
    mut GpuDescriptorHeap heap,
    in TextureHandle texture,
    in Format format,
    mut GpuDescriptorHandle outHandle
){
    return AssignStorageTexture(heap, texture, format, TextureDimension::Texture2D, outHandle);
}

b8 AssignDeferredSampledAndStorage2D(
    mut GpuDescriptorHeap heap,
    in TextureHandle texture,
    in Format format,
    mut GpuDescriptorHandle outSampledHandle,
    mut GpuDescriptorHandle outStorageHandle
){
    return AssignDeferredSampled2D(heap, texture, format, outSampledHandle) && AssignDeferredStorage2D(heap, texture, format, outStorageHandle);
}

b8 AssignDeferredStorage2DArray(
    mut GpuDescriptorHeap heap,
    in TextureHandle texture,
    in Format format,
    mut GpuDescriptorHandle outHandle
){
    return AssignStorageTexture(heap, texture, format, TextureDimension::Texture2DArray, outHandle);
}

b8 AssignDeferredSampledAndStorageShadowArray(
    mut GpuDescriptorHeap heap,
    in TextureHandle texture,
    in Format format,
    mut GpuDescriptorHandle outSampledHandle,
    mut GpuDescriptorHandle outStorageHandle
){
    return
        AssignSampledTexture(
            heap,
            GpuDescriptorClass::SampledImage2DArray,
            texture,
            format,
            s_ShadowVisibilitySubresources,
            TextureDimension::Texture2DArray,
            outSampledHandle
        )
        && AssignDeferredStorage2DArray(heap, texture, format, outStorageHandle)
    ;
}

Expected<void> DeferredBindlessDescriptorRegistrar::registerAll(){
    if(
        !this.registerLightingTargets().has_value()
        || !this.registerTransparencyTargets().has_value()
        || !this.registerSceneBuffers().has_value()
        || !this.registerCsgIntervalTargets().has_value()
        || !this.registerCausticResolveTargets().has_value()
        || !this.registerSoftShadowTargets().has_value()
    )
        return MakeUnexpected(Failure());
    return Expected<void>();
}

Expected<void> DeferredBindlessDescriptorRegistrar::registerLightingTargets(){
    if(
        !AssignDeferredSampled2D(this.m_heap, this.m_targets.albedo, this.m_targets.albedoFormat, this.m_targets.bindless.gbufferBaseColor)
        || !AssignDeferredSampled2D(this.m_heap, this.m_targets.normal, this.m_targets.normalFormat, this.m_targets.bindless.gbufferNormal)
        || !AssignDeferredSampled2D(this.m_heap, this.m_targets.worldPosition, this.m_targets.worldPositionFormat, this.m_targets.bindless.gbufferWorldPosition)
        || !AssignDeferredSampled2D(this.m_heap, this.m_targets.specularRoughness, this.m_targets.specularRoughnessFormat, this.m_targets.bindless.gbufferSpecularRoughness)
        || !AssignDeferredSampled2D(this.m_heap, this.m_targets.depth, this.m_targets.depthFormat, this.m_targets.bindless.gbufferDepth)
        || !AssignDeferredSampledAndStorageShadowArray(this.m_heap, this.m_targets.shadowVisibility, this.m_targets.shadowVisibilityFormat, this.m_targets.bindless.shadowVisibility, this.m_targets.bindless.shadowVisibilityStorage)
        || !AssignDeferredSampledAndStorage2D(this.m_heap, this.m_targets.causticIrradiance, this.m_targets.causticIrradianceFormat, this.m_targets.bindless.causticIrradiance, this.m_targets.bindless.causticIrradianceStorage)
        || !AssignDeferredSampledAndStorage2D(this.m_heap, this.m_targets.surfelIrradiance, this.m_targets.surfelIrradianceFormat, this.m_targets.bindless.surfelIrradiance, this.m_targets.bindless.surfelIrradianceStorage)
        || !AssignDeferredSampledAndStorage2D(this.m_heap, this.m_targets.surfelIrradianceHalf, this.m_targets.surfelIrradianceFormat, this.m_targets.bindless.surfelIrradianceHalf, this.m_targets.bindless.surfelIrradianceHalfStorage)
        || !AssignSampler(this.m_heap, this.m_sources.sampler, this.m_targets.bindless.sampler)
        || !AssignDeferredSampledAndStorage2D(this.m_heap, this.m_targets.opaqueColor, this.m_targets.opaqueColorFormat, this.m_targets.bindless.opaqueColor, this.m_targets.bindless.opaqueColorStorage)
        || !AssignDeferredSampledAndStorage2D(this.m_heap, this.m_targets.compositeColor, this.m_targets.compositeColorFormat, this.m_targets.bindless.compositeColor, this.m_targets.bindless.compositeColorStorage)
    )
        return MakeUnexpected(Failure());
    return Expected<void>();
}

Expected<void> DeferredBindlessDescriptorRegistrar::registerTransparencyTargets(){
    if(
        !AssignDeferredSampled2D(this.m_heap, this.m_targets.avboit.accumColor, this.m_targets.avboit.accumColorFormat, this.m_targets.bindless.avboitAccumColor)
        || !AssignDeferredSampled2D(this.m_heap, this.m_targets.avboit.accumExtinction, this.m_targets.avboit.accumExtinctionFormat, this.m_targets.bindless.avboitAccumExtinction)
        || !AssignDeferredSampled2D(this.m_heap, this.m_targets.avboit.refractionDepth, this.m_targets.depthFormat, this.m_targets.bindless.refractionDepth)
        || !AssignDeferredSampled2D(this.m_heap, this.m_targets.avboit.refractionNormalIor, Format::RGBA16_FLOAT, this.m_targets.bindless.refractionNormalIor)
        || !AssignDeferredSampled2D(this.m_heap, this.m_targets.avboit.refractionTintCoverage, Format::RGBA16_FLOAT, this.m_targets.bindless.refractionTintCoverage)
        || !AssignDeferredSampled2D(this.m_heap, this.m_targets.avboit.refractionInstance, Format::RG32_FLOAT, this.m_targets.bindless.refractionInstance)
        || !AssignDeferredSampled2D(this.m_heap, this.m_targets.avboit.refractionSpecularRoughness, Format::RGBA16_FLOAT, this.m_targets.bindless.refractionSpecularRoughness)
        || !AssignDeferredSampled2D(this.m_heap, this.m_targets.avboit.refractionResolve, Format::RGBA16_FLOAT, this.m_targets.bindless.refractionResolve)
        || !AssignDeferredSampled2D(this.m_heap, this.m_targets.avboit.foregroundAccumColor, this.m_targets.avboit.accumColorFormat, this.m_targets.bindless.avboitForegroundColor)
        || !AssignDeferredSampled2D(this.m_heap, this.m_targets.avboit.foregroundAccumExtinction, this.m_targets.avboit.accumExtinctionFormat, this.m_targets.bindless.avboitForegroundExtinction)
        || !AssignDeferredStorage2D(this.m_heap, this.m_targets.avboit.refractionResolve, Format::RGBA16_FLOAT, this.m_targets.bindless.refractionResolveStorage)
        || !AssignSampledTexture(
            this.m_heap,
            GpuDescriptorClass::SampledImage3D,
            this.m_targets.avboit.transmittanceTexture,
            this.m_targets.avboit.transmittanceFormat,
            s_FramebufferSubresources,
            TextureDimension::Texture3D,
            this.m_targets.bindless.avboitTransmittance
        )
        || !AssignSampler(this.m_heap, this.m_sources.avboitLinearSampler, this.m_targets.bindless.avboitLinearSampler)
    )
        return MakeUnexpected(Failure());
    return Expected<void>();
}

Expected<void> DeferredBindlessDescriptorRegistrar::registerSceneBuffers(){
    if(
        !AssignConstantBuffer(this.m_heap, this.m_sources.sceneShadingBuffer, this.m_targets.bindless.sceneShading)
        || !AssignStructuredBuffer(this.m_heap, this.m_sources.lightBuffer, this.m_targets.bindless.lightList)
    )
        return MakeUnexpected(Failure());
    return Expected<void>();
}

Expected<void> DeferredBindlessDescriptorRegistrar::registerCsgIntervalTargets(){
    if(
        !AssignDeferredStorage2DArray(this.m_heap, this.m_targets.csgCapBackNormal, this.m_targets.csgCapNormalFormat, this.m_targets.bindless.csgCapBackNormal)
        || !AssignDeferredStorage2DArray(this.m_heap, this.m_targets.csgIntervalDepth, this.m_targets.csgIntervalDepthFormat, this.m_targets.bindless.csgIntervalDepth)
        || !AssignDeferredStorage2DArray(this.m_heap, this.m_targets.csgIntervalId, this.m_targets.csgIntervalIdFormat, this.m_targets.bindless.csgIntervalId)
        || !AssignDeferredStorage2DArray(this.m_heap, this.m_targets.csgReceiverEventData, this.m_targets.csgReceiverEventDataFormat, this.m_targets.bindless.csgReceiverEventData)
        || !AssignDeferredStorage2DArray(this.m_heap, this.m_targets.csgReceiverEventCount, this.m_targets.csgReceiverEventCountFormat, this.m_targets.bindless.csgReceiverEventCount)
        || !AssignDeferredStorage2DArray(this.m_heap, this.m_targets.csgReceiverSpanData, this.m_targets.csgReceiverSpanDataFormat, this.m_targets.bindless.csgReceiverSpanData)
        || !AssignDeferredStorage2DArray(this.m_heap, this.m_targets.csgReceiverSpanCount, this.m_targets.csgReceiverSpanCountFormat, this.m_targets.bindless.csgReceiverSpanCount)
        || !AssignDeferredStorage2DArray(this.m_heap, this.m_targets.csgRemovedIntervalDepth, this.m_targets.csgRemovedIntervalDepthFormat, this.m_targets.bindless.csgRemovedIntervalDepth)
        || !AssignDeferredStorage2DArray(this.m_heap, this.m_targets.csgRemovedIntervalCapNormal, this.m_targets.csgRemovedIntervalCapNormalFormat, this.m_targets.bindless.csgRemovedIntervalCapNormal)
        || !AssignDeferredStorage2DArray(this.m_heap, this.m_targets.csgRemovedIntervalData, this.m_targets.csgRemovedIntervalDataFormat, this.m_targets.bindless.csgRemovedIntervalData)
        || !AssignDeferredStorage2DArray(this.m_heap, this.m_targets.csgRemovedIntervalCount, this.m_targets.csgRemovedIntervalCountFormat, this.m_targets.bindless.csgRemovedIntervalCount)
    )
        return MakeUnexpected(Failure());
    return Expected<void>();
}

Expected<void> DeferredBindlessDescriptorRegistrar::registerCausticResolveTargets(){
    if(
        !AssignSampledTexture(
            this.m_heap,
            GpuDescriptorClass::SampledImage2DArrayUint,
            this.m_targets.causticAccumulator,
            this.m_targets.causticAccumulatorFormat,
            s_CausticAccumulatorSubresources,
            TextureDimension::Texture2DArray,
            this.m_targets.bindless.causticAccumulator
        )
        || !AssignDeferredStorage2DArray(this.m_heap, this.m_targets.causticAccumulator, this.m_targets.causticAccumulatorFormat, this.m_targets.bindless.causticAccumulatorStorage)
        || !AssignDeferredSampledAndStorage2D(this.m_heap, this.m_targets.causticHistory, this.m_targets.causticHistoryFormat, this.m_targets.bindless.causticHistory, this.m_targets.bindless.causticHistoryStorage)
        || !AssignDeferredSampledAndStorage2D(this.m_heap, this.m_targets.causticResolveHalf, this.m_targets.causticHistoryFormat, this.m_targets.bindless.causticResolveHalf, this.m_targets.bindless.causticResolveHalfStorage)
        || !AssignDeferredSampledAndStorage2D(this.m_heap, this.m_targets.causticResolveGeometry, this.m_targets.causticHistoryFormat, this.m_targets.bindless.causticResolveGeometry, this.m_targets.bindless.causticResolveGeometryStorage)
    )
        return MakeUnexpected(Failure());
    return Expected<void>();
}

