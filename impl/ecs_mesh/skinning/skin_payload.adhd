#include <impl/ecs_mesh/skinning/runtime_instance.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets/graphics/skinned_mesh/constants.h>"), cpp_name("NWB_SKINNED_MESH_SKIN_JOINT_WORD_COUNT")]
extern const u32 s_ShaderSkinnedMeshSkinJointWordCount;

[cpp_header("<impl/assets/graphics/skinned_mesh/constants.h>"), cpp_name("NWB_SKINNED_MESH_SKIN_INFLUENCE_BYTE_SIZE")]
extern const u32 s_ShaderSkinnedMeshSkinInfluenceByteSize;

[cpp_header("<impl/assets/graphics/skinned_mesh/constants.h>"), cpp_name("NWB_SKINNED_MESH_SKIN_INFLUENCE_ALIGNMENT")]
extern const u32 s_ShaderSkinnedMeshSkinInfluenceAlignment;

[cpp_header("<impl/assets/graphics/skinned_mesh/constants.h>"), cpp_name("NWB_SKINNED_MESH_SKIN_WEIGHT_BYTE_OFFSET")]
extern const u32 s_ShaderSkinnedMeshSkinWeightByteOffset;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[layout(8)]
class MeshSkinningInfluenceGpu{
    public Array<u32, 2u> packedJoint;
    public f32x4u weight;
}

static_assert(size_of<Array<u32, 2u>>() == size_of<u32>() * s_ShaderSkinnedMeshSkinJointWordCount);
static_assert(size_of<MeshSkinningInfluenceGpu>() == s_ShaderSkinnedMeshSkinInfluenceByteSize, "MeshSkinning influence GPU layout drifted");
static_assert(align_of<MeshSkinningInfluenceGpu>() == s_ShaderSkinnedMeshSkinInfluenceAlignment, "MeshSkinning influence GPU alignment must match the packed uint2");
static_assert(offset_of<MeshSkinningInfluenceGpu>(packedJoint) == 0u, "MeshSkinning packed joints must lead each GPU record");
static_assert(offset_of<MeshSkinningInfluenceGpu>(weight) == s_ShaderSkinnedMeshSkinWeightByteOffset, "MeshSkinning FP32 weights must follow the packed joints");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SkinningComponentView<T>{
    public in T component;

    public SkinningComponentView(in T value){
        this.component = value;
    }
}

Optional<SkinningComponentView<T>> FindSkinningComponent<T>(in World world, in EntityID entity){
    if(world.hasComponent<T>(entity))
        return SkinningComponentView<T>(world.getComponent<T>(entity));
    return Optional<SkinningComponentView<T>>();
}

b8 BuildRuntimeSkinPayload(
    in MeshSkinningRuntimeInstance instance,
    in Optional<SkinningComponentView<SkeletonJointPaletteComponent>> jointPalette,
    in Optional<SkinningComponentView<SkeletonPoseComponent>> skeletonPose,
    mut RuntimeSkinPayloadScratch payload
){
    if(skeletonPose.has_value() && HasSkeletonPoseData(skeletonPose.value().component))
        return PopulateRuntimeSkinPayloadFromPose(instance, skeletonPose.value().component, payload);
    if(jointPalette.has_value())
        return PopulateRuntimeSkinPayloadFromPalette(instance, jointPalette.value().component, payload);
    payload.reset(cast<u32>(SkeletonSkinningMode::LinearBlend));
    return true;
}

[cpp_unwind]
Expected<Vector<MeshSkinningInfluenceGpu>> BuildSkinInfluences(in MeshSkinningRuntimeInstance instance){
    if(!ValidateMeshSkinningInfluenceStream(instance.handle.value, instance.skeletonJointCount, instance.skin))
        return MakeUnexpected(Failure());

    Vector<MeshSkinningInfluenceGpu> influences = Vector<MeshSkinningInfluenceGpu>();
    influences.reserve(instance.skin.size());
    for(in SkinInfluence4 sourceSkin : instance.skin){
        MeshSkinningInfluenceGpu influence = MeshSkinningInfluenceGpu();
        influence.packedJoint = PackSkinInfluenceJoints(sourceSkin);
        influence.weight = sourceSkin.weight;
        influences.push_back(influence);
    }
    return influences;
}


