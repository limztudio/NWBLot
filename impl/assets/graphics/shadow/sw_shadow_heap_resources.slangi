#ifndef NWB_GRAPHICS_SHADOW_SW_SHADOW_HEAP_RESOURCES_SLANGI
#define NWB_GRAPHICS_SHADOW_SW_SHADOW_HEAP_RESOURCES_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "shadow_heap_resources.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Default 80-byte push ABI for opaque and coarse software-shadow kernels; soft transparent defines its own push block before include.
#ifndef NWB_SW_SHADOW_PUSH_DECLARED
struct NwbSwShadowHeapPushConstants{
    uint width;
    uint height;
    uint instanceCount;
    uint frameIndex;
    uint coarseWidth;
    uint coarseHeight;
    float edgeThreshold;
    uint edgeCapacity;
    uint traceGroupSize;
    uint deferredResourcesHeapSlot;
    uint materialContextSlotsHeapSlot;
    uint visibilityStorageSlot;
    uint coarseStorageSlot;
    uint softHalfStorageSlot;
    uint transparentSoftHalfStorageSlot;
    uint edgeCounterStorageSlot;
    uint edgeListStorageSlot;
    uint indirectArgsStorageSlot;
    uint softSampleCount;
    uint receiverFactor;
};

[[vk::push_constant]] ConstantBuffer<NwbSwShadowHeapPushConstants> g_NwbSwShadowPush;
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


