////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Name s_TextureUploadScratchArena = "impl/assets_texture/upload";

const StringView s_TextureDiagnosticPrefix = "Texture meta";
const StringView s_TextureFormatField = "format";
const StringView s_TextureDimensionField = "dimension";
const StringView s_TextureResolutionField = "resolution";
const StringView s_TextureAlphaModeField = "alpha_mode";
const StringView s_TextureAlphaConstantField = "alpha_constant_unorm8";
const usize s_PlanarResolutionComponentCount = 2u;
const usize s_VolumeResolutionComponentCount = 3u;

const u32 s_TextureRgbaBytesPerTexel = 4u;
const u32 s_TextureRgba16FloatComponentCount = 4u;
const u32 s_TextureRgba16FloatBytesPerTexel = 8u;
const u32 s_TextureRgba16FloatAlphaByteOffset = 6u;
const u64 s_TextureUastcBytesPerBlock = 16u;
const u32 s_TextureBinaryMagic = 0x54455831u; // TEX1
const u32 s_TextureBinaryVersion = 4u;
const usize s_TextureHeaderBinaryBytes = 44u;
const usize s_TextureMipLevelBinaryBytes = 40u;
const u32 s_TextureAlphaInfoModeMask = 0x000000FFu;
const u32 s_TextureAlphaInfoConstantShift = 8u;
const u32 s_TextureAlphaInfoConstantMask = 0x0000FF00u;
const u32 s_TextureAlphaInfoReservedMask = 0xFFFF0000u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
class TextureMipLevel{
    public u64 offsetBytes = 0u;
    public u64 sizeBytes = 0u;
    public u32 width = 0u;
    public u32 height = 0u;
    public u32 blockCountX = 0u;
    public u32 blockCountY = 0u;
    // 2D payload planes per mip: one for 2D, six for cubemap, reduced Z extent for 3D.
    public u32 sliceCount = 1u;
}

class TextureResolution{
    public u32 width = 0u;
    public u32 height = 0u;
    public u32 depth = 1u;
}

class UastcSliceLayout{
    public u64 offsetBytes = 0u;
    public u64 byteCount = 0u;
    public u64 blockCount = 0u;
}

class PrimaryUastcSlice{
    public Span<u8> bytes;
    public u64 blockCount = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsAllowedTextureMetadataField(in StringView fieldName, in b8 allowAlphaConstant){
    return
        fieldName == s_TextureFormatField
        || fieldName == s_TextureDimensionField
        || fieldName == s_TextureResolutionField
        || fieldName == s_TextureAlphaModeField
        || (allowAlphaConstant && fieldName == s_TextureAlphaConstantField)
    ;
}

Expected<UastcSliceLayout> TryComputeUastcSliceLayout(in TextureMipLevel mip, in u32 sliceIndex){
    if(
        mip.sliceCount == 0u
        || sliceIndex >= mip.sliceCount
        || (mip.sizeBytes % cast<u64>(mip.sliceCount)) != 0u
        || mip.blockCountX == 0u
        || mip.blockCountY == 0u
    )
        return makeUnexpected(Failure());

    const u64 blockCount = cast<u64>(mip.blockCountX) * cast<u64>(mip.blockCountY);
    if(blockCount > u64.max / s_TextureUastcBytesPerBlock)
        return makeUnexpected(Failure());

    const u64 sliceByteCount = mip.sizeBytes / cast<u64>(mip.sliceCount);
    if(sliceByteCount != blockCount * s_TextureUastcBytesPerBlock)
        return makeUnexpected(Failure());

    UastcSliceLayout layout;
    layout.offsetBytes = sliceByteCount * cast<u64>(sliceIndex);
    layout.byteCount = sliceByteCount;
    layout.blockCount = blockCount;
    return layout;
}

Expected<u64> TryComputeUastcSliceAbsoluteOffset(in TextureMipLevel mip, in UastcSliceLayout layout){
    if(mip.offsetBytes > u64.max - layout.offsetBytes)
        return makeUnexpected(Failure());

    return mip.offsetBytes + layout.offsetBytes;
}

b8 IsUastcSliceRangeWithinPrimaryPayload(
    in u64 sliceOffsetBytes,
    in u64 sliceByteCount,
    in u64 primaryPayloadByteCount,
    in usize totalPayloadByteCount
){
    return primaryPayloadByteCount <= cast<u64>(totalPayloadByteCount)
        && sliceOffsetBytes <= primaryPayloadByteCount
        && sliceByteCount <= primaryPayloadByteCount - sliceOffsetBytes
    ;
}

b8 TryComputeTextureMipUploadPitchAndSliceBytes(
    in u32 rowUnits,
    in u64 bytesPerUnit,
    in u32 rowCount,
    mut usize outRowPitch,
    mut usize outSliceByteCount
){
    const u64 rowPitch64 = cast<u64>(rowUnits) * bytesPerUnit;
    if(rowPitch64 > cast<u64>(usize.max))
        return false;
    if(rowCount != 0u && rowPitch64 > u64.max / cast<u64>(rowCount))
        return false;

    const u64 sliceByteCount64 = rowPitch64 * cast<u64>(rowCount);
    if(sliceByteCount64 > cast<u64>(usize.max))
        return false;

    outRowPitch = cast<usize>(rowPitch64);
    outSliceByteCount = cast<usize>(sliceByteCount64);
    return true;
}

Expected<usize> TryComputeTextureMipUploadTotalBytes(
    in usize sliceByteCount,
    in u32 sliceCount
){
    if(sliceCount == 0u || sliceByteCount > usize.max / cast<usize>(sliceCount))
        return makeUnexpected(Failure());

    return sliceByteCount * cast<usize>(sliceCount);
}

u64 ComputeTexturePrimaryPayloadByteCount(in Span<TextureMipLevel> mipLevels){
    if(mipLevels.empty())
        return 0u;
    const TextureMipLevel lastMip = mipLevels[mipLevels.size() - 1u];
    return lastMip.offsetBytes + lastMip.sizeBytes;
}

Expected<PrimaryUastcSlice> TryGetPrimaryUastcSlice(
    in Span<u8> payloadBytes,
    in u64 primaryPayloadByteCount,
    in TextureMipLevel mip,
    in u32 sliceIndex
){
    const Expected<UastcSliceLayout> layout = TryComputeUastcSliceLayout(mip, sliceIndex);
    if(!layout.has_value()){
        error("TextureAssetLoader: invalid UASTC slice layout");
        return makeUnexpected(Failure());
    }
    const Expected<u64> sourceOffsetBytes = TryComputeUastcSliceAbsoluteOffset(mip, layout.value());
    if(!sourceOffsetBytes.has_value()){
        error("TextureAssetLoader: UASTC primary slice offset exceeds addressable memory");
        return makeUnexpected(Failure());
    }
    if(!IsUastcSliceRangeWithinPrimaryPayload(sourceOffsetBytes.value(), layout.value().byteCount, primaryPayloadByteCount, payloadBytes.size())){
        error("TextureAssetLoader: UASTC primary slice is outside the texture payload");
        return makeUnexpected(Failure());
    }

    PrimaryUastcSlice slice;
    slice.bytes = payloadBytes.subspan(cast<usize>(sourceOffsetBytes.value()), cast<usize>(layout.value().byteCount));
    slice.blockCount = layout.value().blockCount;
    return slice;
}

Expected<Span<u8>> TryGetSeparateAlphaUastcSlice(
    in Span<u8> payloadBytes,
    in u64 primaryPayloadByteCount,
    in b8 hasSeparateAlpha,
    in TextureMipLevel mip,
    in u32 sliceIndex
){
    if(!hasSeparateAlpha){
        error("TextureAssetLoader: texture does not have a separate UASTC alpha stream");
        return makeUnexpected(Failure());
    }
    const Expected<UastcSliceLayout> layout = TryComputeUastcSliceLayout(mip, sliceIndex);
    if(!layout.has_value()){
        error("TextureAssetLoader: invalid UASTC slice layout");
        return makeUnexpected(Failure());
    }
    const Expected<u64> alphaSliceOffsetBytes = TryComputeUastcSliceAbsoluteOffset(mip, layout.value());
    if(!alphaSliceOffsetBytes.has_value()){
        error("TextureAssetLoader: UASTC alpha slice offset exceeds addressable memory");
        return makeUnexpected(Failure());
    }
    if(
        !IsUastcSliceRangeWithinPrimaryPayload(alphaSliceOffsetBytes.value(), layout.value().byteCount, primaryPayloadByteCount, payloadBytes.size())
        || primaryPayloadByteCount > cast<u64>(payloadBytes.size()) - primaryPayloadByteCount
    ){
        error("TextureAssetLoader: UASTC alpha slice is outside the texture payload");
        return makeUnexpected(Failure());
    }
    return payloadBytes.subspan(cast<usize>(primaryPayloadByteCount + alphaSliceOffsetBytes.value()), cast<usize>(layout.value().byteCount));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

