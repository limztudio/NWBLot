////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/execute/frame_execute_lifecycle.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class FrameExecuteStateLifecycleSet : NoCopy{
    public Vector<BufferHandle> meshAccelerationStateBuffers;
    public Vector<BufferHandle> shadowPrepareLiveStateBuffers;
    public Array<TextureHandle, s_SinglePersistentResourceCapacity> shadowVisibilityReturnTextures;
    public Array<TextureHandle, s_ShadowComputeScratchTextureCapacity> shadowComputeScratchTextures;
    public Array<BufferHandle, s_ShadowComputeScratchBufferCapacity> shadowComputeScratchBuffers;
    public Array<TextureHandle, s_CausticsComputeScratchTextureCapacity> causticsComputeScratchTextures;
    public Array<TextureHandle, s_SinglePersistentResourceCapacity> causticIrradianceTextures;
    public Array<TextureHandle, s_SinglePersistentResourceCapacity> surfelIrradianceReturnTextures;
    public Array<BufferHandle, s_SinglePersistentResourceCapacity> surfelGiCounterBuffers;
    public Array<TextureHandle, s_SinglePersistentResourceCapacity> surfelGiComputeScratchTextures;
    public Array<BufferHandle, s_SurfelGiComputeScratchBufferCapacity> surfelGiComputeScratchBuffers;
    public Array<TextureHandle, s_SinglePersistentResourceCapacity> hardwareCausticAccumulatorTextures;
    public ShadowPrepareStateLifecycleContext shadowPrepareStateLifecycle;
    public ShadowVisibilityStateLifecycleContext shadowVisibilityStateLifecycle;
    public SoftwareCausticsStateLifecycleContext softwareCausticsStateLifecycle;
    public SurfelGiStateLifecycleContext surfelGiStateLifecycle;
    public HardwareCausticsStateLifecycleContext hardwareCausticsStateLifecycle;
    public DeferredLightingStateLifecycleContext deferredLightingStateLifecycle;
    public Array<GpuTaskGraphTaskRecordedCallback, s_FrameExecuteLifecycleCallbackCapacity> recordedCallbacks;
    public Array<GpuTaskGraphTaskAcceptedCallback, s_FrameExecuteLifecycleCallbackCapacity> acceptedCallbacks;
    public usize recordedCallbackCount = 0u;
    public usize acceptedCallbackCount = 0u;

    [cpp_unwind]
    public FrameExecuteStateLifecycleSet(
        mut RendererFramePipeline renderer,
        mut DeferredFrameTargets targets,
        in RayTracingShadowPreparationResourceSnapshot rayTracingShadowResources,
        in RayTracingDeferredGraphResourceSnapshot rayTracingGraphResources,
        in RayTracingSurfelPersistentResourceSnapshot rayTracingSurfelResources,
        in b8 hardwareShadowSupported,
        in b8 usesLaggedHistory
    ){
        this.shadowPrepareStateLifecycle = ShadowPrepareStateLifecycleContext(renderer);
        this.shadowVisibilityStateLifecycle = ShadowVisibilityStateLifecycleContext(renderer, targets);
        this.softwareCausticsStateLifecycle = SoftwareCausticsStateLifecycleContext(renderer);
        this.surfelGiStateLifecycle = SurfelGiStateLifecycleContext(renderer);
        this.hardwareCausticsStateLifecycle = HardwareCausticsStateLifecycleContext(renderer);
        this.deferredLightingStateLifecycle = DeferredLightingStateLifecycleContext(renderer, targets);
        const Array<TextureHandle, s_SinglePersistentResourceCapacity> shadowVisibilityReturnTextures(targets.shadowVisibility);
        this.shadowVisibilityReturnTextures = shadowVisibilityReturnTextures;
        in LightSpaceShadowSnapshot lightSpaceShadowResources = renderer.m_raytracingSystem.lightSpaceShadowSnapshotRef();
        const Array<TextureHandle, s_ShadowComputeScratchTextureCapacity> shadowComputeScratchTextures(lightSpaceShadowResources.depth,
            targets.shadowCoarseTransmittance,
            targets.shadowSoftHalfA,
            targets.shadowSoftHalfB,
            targets.shadowSoftGeometry,
            targets.shadowSoftGeometryPrev,
            targets.shadowHistA,
            targets.shadowHistB,
            targets.shadowMomentsA,
            targets.shadowMomentsB,
            targets.transparentSoftHalf,
            targets.transparentHistA,
            targets.transparentHistB,
            targets.transparentMomentsA,
            targets.transparentMomentsB);
        this.shadowComputeScratchTextures = shadowComputeScratchTextures;
        const Array<BufferHandle, s_ShadowComputeScratchBufferCapacity> shadowComputeScratchBuffers(lightSpaceShadowResources.counts,
            lightSpaceShadowResources.events,
            lightSpaceShadowResources.views,
            lightSpaceShadowResources.drawArguments,
            lightSpaceShadowResources.csgContext,
            lightSpaceShadowResources.csgOpaqueDepth,
            rayTracingShadowResources.swShadowEdgeCounterBuffer,
            rayTracingShadowResources.swShadowEdgeListBuffer,
            rayTracingShadowResources.swShadowIndirectArgsBuffer,
            rayTracingGraphResources.hardwareTransparentCrossingsBuffer,
            rayTracingGraphResources.hardwareTransparentOverflowListBuffer,
            rayTracingGraphResources.hardwareTransparentOverflowArgsBuffer);
        this.shadowComputeScratchBuffers = shadowComputeScratchBuffers;
        const Array<TextureHandle, s_CausticsComputeScratchTextureCapacity> causticsComputeScratchTextures(targets.causticAccumulator, targets.causticHistory, targets.causticResolveHalf, targets.causticResolveGeometry);
        this.causticsComputeScratchTextures = causticsComputeScratchTextures;
        const Array<TextureHandle, s_SinglePersistentResourceCapacity> causticIrradianceTextures(targets.causticIrradiance);
        this.causticIrradianceTextures = causticIrradianceTextures;
        const Array<TextureHandle, s_SinglePersistentResourceCapacity> surfelIrradianceReturnTextures(targets.surfelIrradiance);
        this.surfelIrradianceReturnTextures = surfelIrradianceReturnTextures;
        const Array<BufferHandle, s_SinglePersistentResourceCapacity> surfelGiCounterBuffers(rayTracingSurfelResources.counterBuffer);
        this.surfelGiCounterBuffers = surfelGiCounterBuffers;
        const Array<TextureHandle, s_SinglePersistentResourceCapacity> surfelGiComputeScratchTextures(targets.surfelIrradianceHalf);
        this.surfelGiComputeScratchTextures = surfelGiComputeScratchTextures;
        const Array<BufferHandle, s_SurfelGiComputeScratchBufferCapacity> surfelGiComputeScratchBuffers(rayTracingSurfelResources.poolBuffer,
            rayTracingSurfelResources.cellHeadBuffer,
            rayTracingSurfelResources.traceIndirectArgsBuffer,
            rayTracingSurfelResources.freeListBuffer,
            rayTracingSurfelResources.poolSnapshotBuffer,
            rayTracingSurfelResources.cellHeadSnapshotBuffer);
        this.surfelGiComputeScratchBuffers = surfelGiComputeScratchBuffers;
        const Array<TextureHandle, s_SinglePersistentResourceCapacity> hardwareCausticAccumulatorTextures(targets.causticAccumulator);
        this.hardwareCausticAccumulatorTextures = hardwareCausticAccumulatorTextures;
        this.shadowVisibilityStateLifecycle.returnTextures = Span<TextureHandle>(this.shadowVisibilityReturnTextures);
        this.shadowVisibilityStateLifecycle.scratchTextures = Span<TextureHandle>(this.shadowComputeScratchTextures);
        this.shadowVisibilityStateLifecycle.scratchBuffers = Span<BufferHandle>(this.shadowComputeScratchBuffers);
        this.shadowVisibilityStateLifecycle.lightSpacePrepared = Optional<in b8>(renderer.m_shadowPrepareGraph.m_shadowPreparationOutcome.ready);
        this.shadowVisibilityStateLifecycle.lightSpaceCaptureTicket = lightSpaceShadowResources.captureTicket;
        this.softwareCausticsStateLifecycle.irradianceTextures = Span<TextureHandle>(this.causticIrradianceTextures);
        this.softwareCausticsStateLifecycle.scratchTextures = Span<TextureHandle>(this.causticsComputeScratchTextures);
        this.surfelGiStateLifecycle.returnTextures = Span<TextureHandle>(this.surfelIrradianceReturnTextures);
        this.surfelGiStateLifecycle.counterBuffers = Span<BufferHandle>(this.surfelGiCounterBuffers);
        this.surfelGiStateLifecycle.computeTextures = Span<TextureHandle>(this.surfelGiComputeScratchTextures);
        this.surfelGiStateLifecycle.computeBuffers = Span<BufferHandle>(this.surfelGiComputeScratchBuffers);
        this.hardwareCausticsStateLifecycle.accumulatorTextures = Span<TextureHandle>(this.hardwareCausticAccumulatorTextures);
        this.deferredLightingStateLifecycle.shadowReturnTextures = Span<TextureHandle>(this.shadowVisibilityReturnTextures);
        this.deferredLightingStateLifecycle.causticReturnTextures = Span<TextureHandle>(this.causticIrradianceTextures);
        this.deferredLightingStateLifecycle.surfelReturnTextures = Span<TextureHandle>(this.surfelIrradianceReturnTextures);
        this.deferredLightingStateLifecycle.usesLaggedHistory = usesLaggedHistory;
        this.collectShadowPrepareStateBuffers(renderer, rayTracingShadowResources, rayTracingGraphResources);
        this.bindCallbacks(renderer, hardwareShadowSupported);
    }

    public b8 selectedCausticsStateReady(in b8 hardwareShadowSupported)const{
        if(hardwareShadowSupported)
            return this.hardwareCausticsStateLifecycle.stateReady;
        return this.softwareCausticsStateLifecycle.stateReady;
    }

    private void appendStateBuffer(in BufferHandle buffer){
        if(buffer.valid())
            this.shadowPrepareLiveStateBuffers.push_back(buffer);
    }

    [cpp_unwind]
    private void collectShadowPrepareStateBuffers(mut RendererFramePipeline renderer, in RayTracingShadowPreparationResourceSnapshot rayTracingShadowResources, in RayTracingDeferredGraphResourceSnapshot rayTracingGraphResources){
        renderer.m_meshSystem.collectRetainedAccelerationStateBuffers(this.meshAccelerationStateBuffers);
        const Span<BufferHandle> acceptedTraceGeometry = renderer.m_raytracingSystem.acceptedShadowTraceGeometryBuffers();
        const Span<PreparedShadowTraceGeometryBuffer> preparedTraceGeometry = renderer.m_raytracingSystem.preparedShadowTraceGeometryBuffers();
        const usize shadowPrepareFixedCapacity = SelectShadowPrepareFixedStateBufferCapacity(rayTracingGraphResources.csgTraceContextBuffer.valid());
        this.shadowPrepareLiveStateBuffers.reserve(AddSize(AddSize(acceptedTraceGeometry.size(), preparedTraceGeometry.size()), AddSize(this.meshAccelerationStateBuffers.size(), shadowPrepareFixedCapacity)));
        if(rayTracingShadowResources.sceneTlasBackingBuffer.valid())
            this.appendStateBuffer(rayTracingShadowResources.sceneTlasBackingBuffer);
        b8 stateCandidateRequired = rayTracingShadowResources.sceneTlas.valid() || renderer.m_raytracingSystem.preparedMeshSwBvhBuildsReady() || renderer.m_raytracingSystem.shadowVisibilitySoftwareResourcesPreflighted();
        for(in BufferHandle acceptedBuffer : acceptedTraceGeometry){
            this.appendStateBuffer(acceptedBuffer);
            stateCandidateRequired = true;
        }
        for(in PreparedShadowTraceGeometryBuffer preparedBuffer : preparedTraceGeometry){
            this.appendStateBuffer(preparedBuffer.buffer);
            stateCandidateRequired = true;
        }
        for(in BufferHandle buffer : this.meshAccelerationStateBuffers){
            if(buffer.valid())
                stateCandidateRequired = true;
            this.appendStateBuffer(buffer);
        }
        this.appendStateBuffer(rayTracingShadowResources.bvhSortKeysBuffer);
        this.appendStateBuffer(rayTracingShadowResources.bvhSortPayloadBuffer);
        this.appendStateBuffer(rayTracingShadowResources.bvhVisitCounterBuffer);
        if(rayTracingGraphResources.csgTraceContextBuffer.valid()){
            this.appendStateBuffer(rayTracingGraphResources.csgTraceContextBuffer);
            stateCandidateRequired = true;
        }

        this.shadowPrepareStateLifecycle.buffers = Span<BufferHandle>(this.shadowPrepareLiveStateBuffers);
        this.shadowPrepareStateLifecycle.stateCandidateRequired = stateCandidateRequired;
    }

    private void bindCallbacks(in RendererFramePipeline renderer, in b8 hardwareShadowSupported){
        this.recordedCallbacks[this.recordedCallbackCount++] = MakeGpuTaskRecordedCallback(renderer.m_shadowPrepareGraph.m_deferredShadowPrepareTask, this.shadowPrepareStateLifecycle);
        this.recordedCallbacks[this.recordedCallbackCount++] = MakeGpuTaskRecordedCallback(renderer.m_shadowVisibilityGraph.m_deferredShadowVisibilityTask, this.shadowVisibilityStateLifecycle);
        if(!hardwareShadowSupported)
            this.recordedCallbacks[this.recordedCallbackCount++] = MakeGpuTaskRecordedCallback(renderer.m_causticsGraph.m_deferredSoftwareCausticsTask, this.softwareCausticsStateLifecycle);
        this.recordedCallbacks[this.recordedCallbackCount++] = MakeGpuTaskRecordedCallback(renderer.m_surfelGiGraph.m_deferredSurfelGiTask, this.surfelGiStateLifecycle);
        if(hardwareShadowSupported)
            this.recordedCallbacks[this.recordedCallbackCount++] = MakeGpuTaskRecordedCallback(renderer.m_causticsGraph.m_deferredHardwareCausticsTask, this.hardwareCausticsStateLifecycle);
        this.recordedCallbacks[this.recordedCallbackCount++] = MakeGpuTaskRecordedCallback(renderer.m_deferredLightingTask, this.deferredLightingStateLifecycle);
        assert(this.recordedCallbackCount <= this.recordedCallbacks.size());

        this.acceptedCallbacks[this.acceptedCallbackCount++] = MakeGpuTaskAcceptedCallback(renderer.m_shadowPrepareGraph.m_deferredShadowPrepareTask, this.shadowPrepareStateLifecycle);
        this.acceptedCallbacks[this.acceptedCallbackCount++] = MakeGpuTaskAcceptedCallback(renderer.m_shadowVisibilityGraph.m_deferredShadowVisibilityTask, this.shadowVisibilityStateLifecycle);
        if(!hardwareShadowSupported)
            this.acceptedCallbacks[this.acceptedCallbackCount++] = MakeGpuTaskAcceptedCallback(renderer.m_causticsGraph.m_deferredSoftwareCausticsTask, this.softwareCausticsStateLifecycle);
        this.acceptedCallbacks[this.acceptedCallbackCount++] = MakeGpuTaskAcceptedCallback(renderer.m_surfelGiGraph.m_deferredSurfelGiTask, this.surfelGiStateLifecycle);
        if(hardwareShadowSupported)
            this.acceptedCallbacks[this.acceptedCallbackCount++] = MakeGpuTaskAcceptedCallback(renderer.m_causticsGraph.m_deferredHardwareCausticsTask, this.hardwareCausticsStateLifecycle);
        this.acceptedCallbacks[this.acceptedCallbackCount++] = MakeGpuTaskAcceptedCallback(renderer.m_deferredLightingTask, this.deferredLightingStateLifecycle);
        assert(this.acceptedCallbackCount <= this.acceptedCallbacks.size());
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

