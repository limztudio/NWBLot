void VerifyUiEditPointerSourceTests_ForeignContactCannotMoveOrEndTheAcceptedEditorSelection(mut UiEditPointerSourceTests self){
    ASSERT_TRUE(self.m_model.setText("abcdef"));
    ASSERT_TRUE(self.activate());
    const UiInputSource first = MakeEcsUiInputSource(17u, 1u);
    const UiInputSource second = MakeEcsUiInputSource(17u, 2u);
    UiPointerInput input = UiPointerInput();
    input.source = first;
    input.position = self.atByte(1u);
    input.phase = UiPointerPhase::Press;
    ASSERT_TRUE(self.dispatchPointer(input));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.caret(), 1u);

    input.source = second;
    input.position = self.atByte(5u);
    input.phase = UiPointerPhase::Press;
    ASSERT_TRUE(self.dispatchPointer(input));
    input.position = self.atByte(6u);
    input.phase = UiPointerPhase::Move;
    ASSERT_TRUE(self.dispatchPointer(input));
    input.phase = UiPointerPhase::Release;
    ASSERT_TRUE(self.dispatchPointer(input));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.caret(), 1u);
    EXPECT_EQ(self.m_model.anchor(), 1u);
    EXPECT_EQ(self.m_context.input().activePointerSource(), first);

    input.source = first;
    input.position = self.atByte(4u);
    input.phase = UiPointerPhase::Move;
    ASSERT_TRUE(self.dispatchPointer(input));
    input.phase = UiPointerPhase::Release;
    ASSERT_TRUE(self.dispatchPointer(input));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.selectedText(), "bcd");
    EXPECT_FALSE(self.m_context.input().activePointerSource().valid());
}

void VerifyUiEditPointerSourceTests_TouchTimestampsCannotManufactureNativeDoubleClickWordSelection(mut UiEditPointerSourceTests self){
    ASSERT_TRUE(self.m_model.setText("one two"));
    ASSERT_TRUE(self.activate());
    const UiInputSource touch = MakeEcsUiInputSource(21u, 9u);
    Array<u64, 2> timestamps = Array<u64, 2>();
    timestamps[0u] = 1000u;
    timestamps[1u] = 1200u;
    for(in u64 timestamp : timestamps){
        UiPointerInput press = UiPointerInput();
        press.source = touch;
        press.timestampMs = timestamp;
        press.position = self.atByte(1u);
        press.phase = UiPointerPhase::Press;
        ASSERT_TRUE(self.dispatchPointer(press));
        UiPointerInput release = UiPointerInput();
        release.source = touch;
        release.position = self.atByte(1u);
        release.phase = UiPointerPhase::Release;
        ASSERT_TRUE(self.dispatchPointer(release));
        ASSERT_TRUE(self.frame(self.m_model));
        EXPECT_EQ(self.m_model.caret(), 1u);
        EXPECT_EQ(self.m_model.anchor(), 1u);
        EXPECT_TRUE(self.m_model.selectedText().empty());
    }
}

void VerifyUiEditPointerSourceTests_CancelledContactCannotEraseAnEarlierCompletedSelection(mut UiEditPointerSourceTests self){
    ASSERT_TRUE(self.m_model.setText("abcdef"));
    ASSERT_TRUE(self.activate());
    const UiInputSource completed = MakeEcsUiInputSource(31u, 1u);
    const UiInputSource next = MakeEcsUiInputSource(31u, 2u);
    Array<UiInputSource, 2> sources = Array<UiInputSource, 2>();
    sources[0u] = completed;
    sources[1u] = next;
    for(in UiInputSource cancelled : sources){
        ASSERT_TRUE(self.m_model.setSelection(0u, 0u));
        ASSERT_TRUE(self.frame(self.m_model));

        UiPointerInput event = UiPointerInput();
        event.source = completed;
        event.position = self.atByte(1u);
        event.phase = UiPointerPhase::Press;
        ASSERT_TRUE(self.dispatchPointer(event));
        event.phase = UiPointerPhase::Release;
        ASSERT_TRUE(self.dispatchPointer(event));

        event.source = cancelled;
        event.position = self.atByte(5u);
        event.phase = UiPointerPhase::Press;
        ASSERT_TRUE(self.dispatchPointer(event));
        event.phase = UiPointerPhase::Cancel;
        ASSERT_TRUE(self.dispatchPointer(event));
        EXPECT_EQ(self.m_model.caret(), 0u);
        EXPECT_FALSE(self.m_context.input().activePointerSource().valid());
        ASSERT_TRUE(self.frame(self.m_model));
        EXPECT_EQ(self.m_model.caret(), 1u);
        EXPECT_EQ(self.m_model.anchor(), 1u);
        EXPECT_TRUE(self.m_model.selectedText().empty());

        event.source = cancelled;
        event.position = self.atByte(2u);
        event.phase = UiPointerPhase::Press;
        ASSERT_TRUE(self.dispatchPointer(event));
        event.phase = UiPointerPhase::Release;
        ASSERT_TRUE(self.dispatchPointer(event));
        ASSERT_TRUE(self.frame(self.m_model));
        EXPECT_EQ(self.m_model.caret(), 2u);
        EXPECT_EQ(self.m_model.anchor(), 2u);
    }
}

void VerifyUiEditActionHostTests_HeldSubmitObservesReleaseAfterDraftEventsWithoutRepeating(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    ASSERT_TRUE(self.replaceNative("42"));
    UiInputEvent down = UiInputEvent();
    down.key = Key::Enter;
    down.type = UiInputEventType::KeyDown;
    ASSERT_TRUE(self.dispatch(down));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_FALSE(self.m_result.submitted);
    EXPECT_TRUE(self.m_actions.records.empty());
    EXPECT_EQ(self.m_model.text(), "42");
    ASSERT_TRUE(self.dispatch(down));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_FALSE(self.m_result.submitted);
    EXPECT_TRUE(self.m_actions.records.empty());
    ASSERT_TRUE(self.commitNative("7"));
    UiInputEvent up = UiInputEvent();
    up.key = Key::Enter;
    up.type = UiInputEventType::KeyUp;
    ASSERT_TRUE(self.dispatch(up));
    ASSERT_TRUE(self.commitNative("9"));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_TRUE(self.m_result.submitted);
    ASSERT_EQ(self.actionCount(UiEditAction::Submit), 1u);
    EXPECT_EQ(self.m_actions.records[0u].text, "427");
    EXPECT_EQ(self.m_actions.committed, "427");
    EXPECT_EQ(self.m_model.text(), "4279");
    ASSERT_TRUE(self.dispatch(up));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_EQ(self.actionCount(UiEditAction::Submit), 1u);
}

void VerifyUiEditActionHostTests_EscapeCancelsConcurrentKeyboardAndControllerSubmitsBeforeRelease(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    ASSERT_TRUE(self.replaceNative("42"));
    const UiInputSource controller = MakeEcsUiInputSource(7u, 3u);
    UiInputEvent keyDown = UiInputEvent();
    keyDown.key = Key::Enter;
    keyDown.type = UiInputEventType::KeyDown;
    ASSERT_TRUE(self.dispatch(keyDown));
    UiInputEvent cmdDown = UiInputEvent();
    cmdDown.source = controller;
    cmdDown.type = UiInputEventType::CommandDown;
    cmdDown.command = UiInputCommand::Submit;
    ASSERT_TRUE(self.dispatch(cmdDown));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_TRUE(self.m_actions.records.empty());
    ASSERT_TRUE(self.key(Key::Escape));
    keyDown.repeat = true;
    ASSERT_TRUE(self.dispatch(keyDown));
    UiInputEvent keyUp = UiInputEvent();
    keyUp.key = Key::Enter;
    keyUp.type = UiInputEventType::KeyUp;
    ASSERT_TRUE(self.dispatch(keyUp));
    UiInputEvent cmdUp = UiInputEvent();
    cmdUp.source = controller;
    cmdUp.type = UiInputEventType::CommandUp;
    ASSERT_TRUE(self.dispatch(cmdUp));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_FALSE(self.m_result.submitted);
    EXPECT_TRUE(self.m_result.cancelled);
    EXPECT_EQ(self.actionCount(UiEditAction::Submit), 0u);
    EXPECT_EQ(self.actionCount(UiEditAction::Cancel), 1u);
    EXPECT_EQ(self.m_actions.committed, "0");
    EXPECT_EQ(self.m_model.text(), "0");
    ASSERT_TRUE(self.focusEditor());
    ASSERT_TRUE(self.actionFrame());
    ASSERT_TRUE(self.key(Key::Enter));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_EQ(self.actionCount(UiEditAction::Submit), 1u);
}

