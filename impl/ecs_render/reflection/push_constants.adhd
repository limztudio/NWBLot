}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Precompute two Sobol dimensions per frame; scrambling stays in the shader.
ReflectionSampleBase ComputeReflectionSampleBase(in u32 sampleIndex){
    const u64 sample = computeSobol2U32(sampleIndex);
    ReflectionSampleBase base;
    base.x = cast<u32>(sample);
    base.y = cast<u32>(sample >> 32u);
    return base;
}

void CopyReflectionDiagnosticCounters(in Span<u32> completedCounters, in ReflectionStatistics metadata, mut ReflectionStatistics latest){
    latest.candidates = completedCounters[0u];
    latest.hardwareRays = completedCounters[1u];
    latest.exteriorEligibleRays = completedCounters[23u];
    latest.hardwareHits = completedCounters[2u];
    latest.opaquePixels = completedCounters[3u];
    latest.glassPixels = completedCounters[4u];
    latest.fallbackPixels = completedCounters[5u];
    latest.screenAttempts = completedCounters[6u];
    latest.screenHits = completedCounters[7u];
    latest.queryBudgetUnits = completedCounters[8u];
    if(metadata.csgHardwareEnabled)
        latest.physicalQueries = completedCounters[24u];
    else
        latest.physicalQueries = latest.queryBudgetUnits;
    latest.bootstrapEvents = completedCounters[9u];
    latest.transparentPaths = completedCounters[10u];
    latest.unsupportedPaths = completedCounters[11u];
    latest.limitedPaths = completedCounters[12u];
    latest.ambiguousPaths = completedCounters[13u];
    latest.tirEvents = completedCounters[14u];
    latest.mediumOverflowPaths = completedCounters[15u];
    latest.potentialReceivers = completedCounters[16u];
    latest.screenReturns = completedCounters[17u];
    latest.feedbackBypassedPixels = completedCounters[18u];
    latest.feedbackProbeTiles = completedCounters[19u];
    const u64 screenIterationsLow = cast<u64>(completedCounters[20u]);
    const u64 screenIterationsHigh = cast<u64>(completedCounters[21u]);
    latest.screenIterations = screenIterationsLow | (screenIterationsHigh << s_ReflectionCounterHighWordShiftBits);
    latest.screenLimitMisses = completedCounters[22u];
}

Expected<ReflectionFeedbackExtent> TryComputeReflectionFeedbackExtent(in u32 width, in u32 height){
    if(width == 0u || height == 0u)
        return makeUnexpected(Failure());
    const u32 tilesX = divideUp(width, s_ReflectionFeedbackGroupSize);
    const u32 tilesY = divideUp(height, s_ReflectionFeedbackGroupSize);
    const u64 entryCount = cast<u64>(tilesX) * cast<u64>(tilesY) * s_ReflectionFeedbackSurfaceCount;
    const u64 byteCount = s_ReflectionFeedbackHeaderBytes + entryCount * s_ReflectionFeedbackEntryBytes;
    if(entryCount > s_ReflectionFeedbackMaxCount || byteCount > s_ReflectionFeedbackMaxCount)
        return makeUnexpected(Failure());
    return ReflectionFeedbackExtent(width, height, tilesX, tilesY, cast<u32>(entryCount), cast<u32>(byteCount));
}

Expected<u32> TryResolveReflectionQueueCapacity(in u32 width, in u32 height, in u32 maxHardwareRaysPerFrame){
    u64 pixelCount = cast<u64>(width) * cast<u64>(height);
    if(width == 0u || height == 0u || pixelCount > cast<u64>(0xFFFFFFFFu) / 2u)
        return makeUnexpected(Failure());
    u64 boundedCapacity = max(cast<u64>(1u), min(pixelCount * 2u, cast<u64>(maxHardwareRaysPerFrame)));
    if(boundedCapacity > cast<u64>(0xFFFFFFFFu) / 4u)
        return makeUnexpected(Failure());
    return cast<u32>(boundedCapacity);
}

u32 ResolveReflectionIndirectArgumentCount(in u32 capacity, in b8 sliced){
    if(sliced)
        return divideUp(capacity, s_ReflectionTraceSliceRays);
    return 1u;
}

StringView ResolveReflectionSpatialVariant(in u32 radiusIndex){
    switch(radiusIndex){
    case 0u:
        return s_ReflectionSpatialRadius1Variant;
    case 1u:
        return s_ReflectionSpatialRadius2Variant;
    case 2u:
        return s_ReflectionSpatialRadius3Variant;
    default:
        return s_ReflectionSpatialRadius1Variant;
    }
}


