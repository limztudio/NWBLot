    m_shadowMaterialTypedHeapHandle = Core::GpuDescriptorHandle::Invalid();
    m_shadowInstanceCapacity = 0u;
    m_shadowMaterialTypedCapacity = 0u;
    m_bvhSortBindingLayout.reset();
