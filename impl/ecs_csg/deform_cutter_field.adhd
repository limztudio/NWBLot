#include <impl/ecs_csg/deform_clip_plan.adhd>
#include <impl/ecs_csg/shape_registry_validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<b8, CsgDeformViabilityReason> EvaluateCsgDeformBuiltInDistancesLoop<ShapeT : ICsgShape>(
    in Span<CsgDeformVertex> vertices,
    in MatrixSingle worldToShape,
    in CsgShapeInlineParameters inlineParameters,
    in f32 boundaryEpsilon,
    mut Vector<f32> outDistances
){
    const ShapeT shape = ShapeT();
    const usize vertexCount = vertices.size();
    for(usize vertexIndex = 0u; vertexIndex < vertexCount; ++vertexIndex){
        const VectorSingle shapePosition = TransformCsgDeformVertexPosition(vertices[vertexIndex], worldToShape);
        const f32 distance = shape.evaluateSignedDistance(shapePosition, inlineParameters);
        const Expected<f32, CsgDeformViabilityReason> snapped = TrySnapCsgDeformSignedDistance(distance, boundaryEpsilon);
        if(!snapped.has_value())
            return MakeUnexpected(snapped.error());
        outDistances[vertexIndex] = snapped.value();
    }
    return true;
}

Expected<b8, CsgDeformViabilityReason> ComputeCsgDeformShapeDistances(
    in CsgDeformShape shape,
    in Span<CsgDeformVertex> vertices,
    in f32 boundaryEpsilon,
    in u32 registryParameterByteSize,
    in Optional<Func<Expected<f32>(in VectorSingle, in CsgShapeInlineParameters)>> registryDistanceCallback,
    mut Vector<f32> outDistances
){
    CsgShapeInlineParameters inlineParameters = MakeCsgShapeInlineParameters(VectorSingle(shape.parameter0), VectorSingle(shape.parameter1));
    const usize vertexCount = vertices.size();
    outDistances.clear();
    outDistances.resize(vertexCount, s_KeepDistanceZero);

    const MatrixSingle worldToShape(shape.worldToShape);
    if(registryDistanceCallback.has_value()){
        const Expected<FixedVector<u8, s_CsgShapeInlineParameterMaxBytes>> packedParameterBytes = PackCsgShapeDefaultParameterBytes(registryParameterByteSize, inlineParameters);
        if(!packedParameterBytes.has_value())
            return MakeUnexpected(CsgDeformViabilityReason::InvalidCutter);
        inlineParameters = ReadCsgShapeInlineParameters(packedParameterBytes.value());
        for(usize vertexIndex = 0u; vertexIndex < vertexCount; ++vertexIndex){
            const VectorSingle shapePosition = TransformCsgDeformVertexPosition(vertices[vertexIndex], worldToShape);
            const Expected<f32> evaluated = registryDistanceCallback.value()(shapePosition, inlineParameters);
            if(!evaluated.has_value())
                return MakeUnexpected(CsgDeformViabilityReason::InvalidCutter);
            const Expected<f32, CsgDeformViabilityReason> snapped = TrySnapCsgDeformSignedDistance(evaluated.value(), boundaryEpsilon);
            if(!snapped.has_value())
                return MakeUnexpected(snapped.error());
            outDistances[vertexIndex] = snapped.value();
        }
        return true;
    }

    const Expected<CsgBuiltInShapeKind> resolvedBuiltInKind = TryResolveBuiltInCsgShapeKind(shape.shapeType);
    if(!resolvedBuiltInKind.has_value())
        return MakeUnexpected(CsgDeformViabilityReason::InvalidCutter);
    switch(resolvedBuiltInKind.value()){
    case CsgBuiltInShapeKind::Plane:
        return EvaluateCsgDeformBuiltInDistancesLoop<CsgPlaneShape>(vertices, worldToShape, inlineParameters, boundaryEpsilon, outDistances);
    case CsgBuiltInShapeKind::Box:
        return EvaluateCsgDeformBuiltInDistancesLoop<CsgBoxShape>(vertices, worldToShape, inlineParameters, boundaryEpsilon, outDistances);
    case CsgBuiltInShapeKind::Sphere:
        return EvaluateCsgDeformBuiltInDistancesLoop<CsgSphereShape>(vertices, worldToShape, inlineParameters, boundaryEpsilon, outDistances);
    case CsgBuiltInShapeKind::Capsule:
        return EvaluateCsgDeformBuiltInDistancesLoop<CsgCapsuleShape>(vertices, worldToShape, inlineParameters, boundaryEpsilon, outDistances);
    }
    return MakeUnexpected(CsgDeformViabilityReason::InvalidCutter);
}


