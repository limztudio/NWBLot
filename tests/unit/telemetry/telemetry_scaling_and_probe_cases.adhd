void VerifyTelemetry_PacketStatisticsInvalidInputDoesNotConsumeIdentity(){
    TelemetryTestArena testArena = TelemetryTestArena();
    StatisticsFixture fixture = StatisticsFixture(testArena.arena);
    native(in testArena, mut fixture){
        PrepareFixture(2u, 1u, fixture);
    }
    FrameGraphBuilder builder = FrameGraphBuilder(testArena.scratchArena, fixture.nodes, fixture.edges, fixture.pendingEdges, fixture.queues, fixture.packets);
    FrameGraphPhysicalQueueRuntimeStatistics queue = QueueStatistics(1u, 1u);
    queue.planGeneration = 74u;
    EXPECT_FALSE(builder.addPhysicalQueueRuntimeStatistics(MakeNodeHandle(0u), queue));
    queue.planGeneration = 72u;
    EXPECT_TRUE(builder.addPhysicalQueueRuntimeStatistics(MakeNodeHandle(0u), queue));
    FrameGraphPacketSubmissionStatisticsRecord packet = FrameGraphPacketSubmissionStatisticsRecord();
    packet.packetGeneration = 74u;
    packet.taskCount = 1u;
    packet.commandListCount = 1u;
    packet.queue.index = 1u;
    packet.queue.deviceGeneration = 17u;
    packet.ownerNodeIndex = 0u;
    packet.packetIndex = 0u;
    packet.queueClass = FrameGraphQueueClass::Graphics;
    EXPECT_FALSE(builder.addPacketSubmissionStatistics(MakeNodeHandle(0u), packet));
    packet.packetGeneration = 72u;
    EXPECT_TRUE(builder.addPacketSubmissionStatistics(MakeNodeHandle(0u), packet));
    EXPECT_FALSE(builder.addPacketSubmissionStatistics(MakeNodeHandle(0u), packet));
    EXPECT_EQ(fixture.queues.size(), 1u);
    EXPECT_EQ(fixture.packets.size(), 1u);
}

void VerifyTelemetry_PacketStatisticsQueueSourceSurvivesDestinationGrowth(){
    TelemetryTestArena testArena = TelemetryTestArena();
    StatisticsFixture fixture = StatisticsFixture(testArena.arena);
    FrameGraphBuilder builder = FrameGraphBuilder(testArena.scratchArena, fixture.nodes, fixture.edges, fixture.pendingEdges, fixture.queues, fixture.packets);
    FrameGraphPassMetadata metadata = FrameGraphPassMetadata();
    metadata.runtimeStatistics = OwnerStatistics(1u);
    const FrameGraphNodeHandle firstOwner = builder.addPass(Name(s_QueueAliasOwner), s_QueueAliasOwnerLabel, metadata);
    ASSERT_TRUE(builder.addPhysicalQueueRuntimeStatistics(firstOwner, QueueStatistics(1u, 1u)));
    while(fixture.queues.size() < fixture.queues.capacity()){
        const FrameGraphNodeHandle owner = builder.addPass(Name(s_QueueAliasOwner), s_QueueAliasOwnerLabel, metadata);
        ASSERT_TRUE(builder.addPhysicalQueueRuntimeStatistics(owner, fixture.queues[0u].statistics));
    }
    const usize capacityBeforeGrowth = fixture.queues.capacity();
    const FrameGraphNodeHandle owner = builder.addPass(Name(s_QueueAliasOwner), s_QueueAliasOwnerLabel, metadata);
    ASSERT_TRUE(builder.addPhysicalQueueRuntimeStatistics(owner, fixture.queues[0u].statistics));
    ASSERT_GT(fixture.queues.capacity(), capacityBeforeGrowth);
    EXPECT_EQ(fixture.queues.back().ownerNodeIndex, owner.index);
    EXPECT_EQ(fixture.queues.back().statistics.queue, fixture.queues[0u].statistics.queue);
    EXPECT_EQ(fixture.queues.back().statistics.planGeneration, 72u);
    EXPECT_EQ(fixture.queues.back().statistics.compile.packetCount, 1u);
    EXPECT_EQ(fixture.queues.back().statistics.submission.nativeSubmissionCount, 1u);
}

