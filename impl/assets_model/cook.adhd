[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if defined(NWB_COOK)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <core/alloc/scratch.h>
#include <core/metascript/parser.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct ModelCookEntry{
    Name virtualPath = s_NameNone;
    Model::SkeletonObjectVector skeletonObjects;
    Model::StaticMeshObjectVector staticMeshObjects;
    Model::SkinnedMeshObjectVector skinnedMeshObjects;


public:
    explicit ModelCookEntry(Core::Assets::AssetArena& arena)noexcept
        : skeletonObjects(arena)
        , staticMeshObjects(arena)
        , skinnedMeshObjects(arena)
    {}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] Expected<ModelCookEntry> ParseModelCookMetadata(Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<ModelCookEntry> ParseModelCookMetadata(const Path& assetRoot, AStringView virtualRoot, const Path& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<Model> BuildModelAsset(ModelCookEntry& modelEntry, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateModelMetadataMapField(in b8 isMap, in StringView filePathText, in StringView fieldName){
    if(isMap)
        return true;

    error("Model meta '{}': field '{}' must be a map", filePathText, fieldName);
    return false;
}

b8 CheckModelObjectIsMap(in MetascriptValue objectValue, in StringView objectKind, in StringView filePathText){
    if(objectValue.isMap())
        return true;

    error("{} '{}': value must be a map", objectKind, filePathText);
    return false;
}

b8 ValidateModelObjectNameResolved(in b8 hasName, in StringView objectKind, in StringView filePathText){
    if(hasName)
        return true;

    error("{} '{}': object name contains an embedded null", objectKind, filePathText);
    return false;
}

Expected<SkeletonJointMatrix> ReadModelTransformField(in Path nwbFilePath, in MetascriptValue object, in StringView objectKind){
    Expected<SkeletonJointMatrix> transformResult = MakeIdentitySkeletonJointMatrix();
    object.visitField(s_ModelTransformField, lambda[in nwbFilePath, in objectKind, mut transformResult](in MetascriptValue fieldValue) -> void{
        transformResult = ParseSkeletonJointMatrixValue(nwbFilePath, fieldValue, objectKind, s_ModelTransformField);
    });
    return transformResult;
}

Expected<ModelSkeletonObject> ParseModelSkeletonObject(in Path nwbFilePath, in StringView filePathText, in MetascriptValue objectValue){
    if(!CheckModelObjectIsMap(objectValue, s_ModelSkeletonObjectKind, filePathText))
        return MakeUnexpected(Failure());
    if(!ValidateMetadataAssetFields(nwbFilePath, objectValue, s_ModelSkeletonObjectKind, lambda[](in StringView fieldName) -> b8{
        return IsAllowedModelSkeletonObjectField(fieldName);
    }))
        return MakeUnexpected(Failure());

    const Expected<AssetRef<Skeleton>> skeletonResult = ReadMetadataAssetRefField<Skeleton>(nwbFilePath, objectValue, s_ModelSkeletonObjectKind, s_ModelSkeletonField, true);
    if(!skeletonResult)
        return MakeUnexpected(Failure());

    const Expected<SkeletonJointMatrix> transformResult = ReadModelTransformField(nwbFilePath, objectValue, s_ModelSkeletonObjectKind);
    if(!transformResult)
        return MakeUnexpected(Failure());

    ModelSkeletonObject object;
    object.skeleton = skeletonResult.value();
    object.transform = transformResult.value();
    return object;
}

Expected<ModelStaticMeshObject> ParseModelStaticMeshObject(in Path nwbFilePath, in StringView filePathText, in MetascriptValue objectValue){
    if(!CheckModelObjectIsMap(objectValue, s_ModelStaticMeshObjectKind, filePathText))
        return MakeUnexpected(Failure());
    if(!ValidateMetadataAssetFields(nwbFilePath, objectValue, s_ModelStaticMeshObjectKind, lambda[](in StringView fieldName) -> b8{
        return IsAllowedModelStaticMeshObjectField(fieldName);
    }))
        return MakeUnexpected(Failure());

    const Expected<AssetRef<Mesh>> meshResult = ReadMetadataAssetRefField<Mesh>(nwbFilePath, objectValue, s_ModelStaticMeshObjectKind, s_ModelMeshField, true);
    if(!meshResult)
        return MakeUnexpected(Failure());

    const Expected<AssetRef<Material>> materialResult = ReadMetadataAssetRefField<Material>(nwbFilePath, objectValue, s_ModelStaticMeshObjectKind, s_ModelMaterialField, false);
    if(!materialResult)
        return MakeUnexpected(Failure());

    const Expected<Name> parentObjectResult = ReadMetadataNameField(nwbFilePath, objectValue, s_ModelStaticMeshObjectKind, s_ModelParentObjectField, false);
    if(!parentObjectResult)
        return MakeUnexpected(Failure());

    const Expected<Name> parentJointResult = ReadMetadataNameField(nwbFilePath, objectValue, s_ModelStaticMeshObjectKind, s_ModelParentJointField, false);
    if(!parentJointResult)
        return MakeUnexpected(Failure());

    const Expected<SkeletonJointMatrix> transformResult = ReadModelTransformField(nwbFilePath, objectValue, s_ModelStaticMeshObjectKind);
    if(!transformResult)
        return MakeUnexpected(Failure());

    ModelStaticMeshObject object;
    object.mesh = meshResult.value();
    object.material = materialResult.value();
    object.parentObject = parentObjectResult.value();
    object.parentJoint = parentJointResult.value();
    object.transform = transformResult.value();
    return object;
}

Expected<ModelSkinnedMeshObject> ParseModelSkinnedMeshObject(in Path nwbFilePath, in StringView filePathText, in MetascriptValue objectValue){
    if(!CheckModelObjectIsMap(objectValue, s_ModelSkinnedMeshObjectKind, filePathText))
        return MakeUnexpected(Failure());
    if(!ValidateMetadataAssetFields(nwbFilePath, objectValue, s_ModelSkinnedMeshObjectKind, lambda[](in StringView fieldName) -> b8{
        return IsAllowedModelSkinnedMeshObjectField(fieldName);
    }))
        return MakeUnexpected(Failure());

    const Expected<AssetRef<Skin>> skinResult = ReadMetadataAssetRefField<Skin>(nwbFilePath, objectValue, s_ModelSkinnedMeshObjectKind, s_ModelSkinField, true);
    if(!skinResult)
        return MakeUnexpected(Failure());

    const Expected<AssetRef<Material>> materialResult = ReadMetadataAssetRefField<Material>(nwbFilePath, objectValue, s_ModelSkinnedMeshObjectKind, s_ModelMaterialField, false);
    if(!materialResult)
        return MakeUnexpected(Failure());

    const Expected<Name> skeletonObjectResult = ReadMetadataNameField(nwbFilePath, objectValue, s_ModelSkinnedMeshObjectKind, s_ModelSkeletonField, true);
    if(!skeletonObjectResult)
        return MakeUnexpected(Failure());

    const Expected<SkeletonJointMatrix> transformResult = ReadModelTransformField(nwbFilePath, objectValue, s_ModelSkinnedMeshObjectKind);
    if(!transformResult)
        return MakeUnexpected(Failure());

    ModelSkinnedMeshObject object;
    object.skin = skinResult.value();
    object.material = materialResult.value();
    object.skeletonObject = skeletonObjectResult.value();
    object.transform = transformResult.value();
    return object;
}

b8 SerializeModelBinaryPayload(
    in Span<ModelSkeletonObject> skeletonObjects,
    in Span<ModelStaticMeshObject> staticMeshObjects,
    in Span<ModelSkinnedMeshObject> skinnedMeshObjects,
    mut Vector<u8> outBinary
){
    ModelBinaryCodec codec;
    return codec.serialize(skeletonObjects, staticMeshObjects, skinnedMeshObjects, outBinary);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if defined(NWB_COOK)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <core/assets/binary_payload_io.h>
#include <core/assets/cook_metadata.h>
#include <core/metascript/parser.h>

#include <global/binary.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_model_cook{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


template<typename ObjectT, typename ParseObjectFn>
[[nodiscard]] Expected<Vector<ObjectT, ::ArenaBase>> ParseObjectMap(const AStringView filePathText, const Core::Metascript::Value& asset, const AStringView fieldName, const AStringView objectKind, ParseObjectFn&& parseObject, Core::Assets::AssetArena& arena){
    Vector<ObjectT, ::ArenaBase> objects(arena);

    const Core::Metascript::Value* fieldValue = asset.findField(fieldName);
    if(!fieldValue)
        return objects;
    if(!ValidateModelMetadataMapField(fieldValue->isMap(), filePathText, fieldName))
        return MakeUnexpected(Failure{});

    const auto& map = fieldValue->asMap();
    objects.reserve(map.size());
    for(const auto& [objectName, objectValue] : map){
        const auto nameResult = Name::FromText(AStringView(objectName.data(), objectName.size()));
        if(!ValidateModelObjectNameResolved(nameResult.has_value(), objectKind, filePathText))
            return MakeUnexpected(Failure{});
        const Name name = *nameResult;
        auto object = parseObject(objectValue);
        if(!object)
            return MakeUnexpected(Failure{});
        object->name = name;
        objects.push_back(*object);
    }

    return objects;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ModelAssetCodec::serialize(const Core::Assets::IAsset& asset, Core::Assets::AssetBytes& outBinary)const{
    if(!checkSerializeAssetType(asset, s_ModelSerializeContext))
        return false;

    const Model& model = static_cast<const Model&>(asset);
    Core::Alloc::ScratchArena scratchArena(s_AssetsModelSerializeArena);
    if(!model.validatePayload(scratchArena))
        return false;

    return SerializeModelBinaryPayload(model.skeletonObjects(), model.staticMeshObjects(), model.skinnedMeshObjects(), outBinary);
}

Expected<ModelCookEntry> ParseModelCookMetadata(const Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    using namespace __hidden_model_cook;

    ModelCookEntry entry(arena);

    if(!Core::Assets::CheckMetadataAssetMap(nwbFilePath, asset, s_ModelMetaDiagnosticPrefix))
        return MakeUnexpected(Failure{});

    if(!Core::Assets::AssignCookEntryVirtualPath(virtualPath, nwbFilePath, s_ModelMetaDiagnosticPrefix, entry))
        return MakeUnexpected(Failure{});
    if(!Core::Assets::ValidateMetadataAssetFields(nwbFilePath, asset, s_ModelMetaDiagnosticPrefix, &IsAllowedModelMetadataField))
        return MakeUnexpected(Failure{});

    const AString<Core::Alloc::ScratchArena> filePathText = PathToString<char>(scratchArena, nwbFilePath);

    auto skeletonObjectsResult = ParseObjectMap<ModelSkeletonObject>(filePathText, asset, s_ModelSkeletonsField, s_ModelSkeletonObjectKind, [&](const Core::Metascript::Value& objectValue){
        return ParseModelSkeletonObject(nwbFilePath, filePathText, objectValue);
    }, arena);
    if(!skeletonObjectsResult)
        return MakeUnexpected(Failure{});
    entry.skeletonObjects = Move(*skeletonObjectsResult);

    auto staticMeshObjectsResult = ParseObjectMap<ModelStaticMeshObject>(filePathText, asset, s_ModelStaticMeshesField, s_ModelStaticMeshObjectKind, [&](const Core::Metascript::Value& objectValue){
        return ParseModelStaticMeshObject(nwbFilePath, filePathText, objectValue);
    }, arena);
    if(!staticMeshObjectsResult)
        return MakeUnexpected(Failure{});
    entry.staticMeshObjects = Move(*staticMeshObjectsResult);

    auto skinnedMeshObjectsResult = ParseObjectMap<ModelSkinnedMeshObject>(filePathText, asset, s_ModelSkinnedMeshesField, s_ModelSkinnedMeshObjectKind, [&](const Core::Metascript::Value& objectValue){
        return ParseModelSkinnedMeshObject(nwbFilePath, filePathText, objectValue);
    }, arena);
    if(!skinnedMeshObjectsResult)
        return MakeUnexpected(Failure{});
    entry.skinnedMeshObjects = Move(*skinnedMeshObjectsResult);

    Model candidateModel(entry.skeletonObjects.get_allocator().arena(), entry.virtualPath);
    candidateModel.setObjects(Move(entry.skeletonObjects), Move(entry.staticMeshObjects), Move(entry.skinnedMeshObjects));
    if(!candidateModel.validatePayload(scratchArena))
        return MakeUnexpected(Failure{});
    candidateModel.takeObjects(entry.skeletonObjects, entry.staticMeshObjects, entry.skinnedMeshObjects);
    return entry;
}

Expected<ModelCookEntry> ParseModelCookMetadata(const Path& assetRoot, const AStringView virtualRoot, const Path& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    return Core::Assets::ParseCookMetadataDocument<ModelCookEntry, &ParseModelCookMetadata>(assetRoot, virtualRoot, nwbFilePath, doc, s_ModelMetaDiagnosticPrefix, arena, scratchArena);
}

Expected<Model> BuildModelAsset(ModelCookEntry& modelEntry, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    Model asset(arena, modelEntry.virtualPath);
    asset.setObjects(Move(modelEntry.skeletonObjects), Move(modelEntry.staticMeshObjects), Move(modelEntry.skinnedMeshObjects));
    if(!asset.validatePayload(scratchArena))
        return MakeUnexpected(Failure{});
    return asset;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

