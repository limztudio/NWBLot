type MeshRayTracingSnapshot = MeshRayTracingResourceSnapshot;
type MeshViewByteArray = Array<u8, s_MeshViewGpuDataBytes>;
type ConstByteSpan = Span<u8>;
type ObjectGeometryCacheSnapshotType = ObjectGeometryCacheSnapshot;
