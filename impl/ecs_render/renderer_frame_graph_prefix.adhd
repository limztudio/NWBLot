#include <impl/ecs_render/deferred/opaque_upload_chain_builder.adhd>
#include <impl/ecs_render/deferred/post_gbuffer_normalize_builder.adhd>
#include <impl/ecs_render/deferred/prefix_scene_upload_builder.adhd>
#include <impl/ecs_render/deferred/task_graph_gbuffer_task.adhd>
