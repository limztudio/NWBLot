NWB_ADHD_GTEST(MeshSolidCodec, TailPaddingAndInconsistentPrimitiveCountsAreRejected, VerifyMeshSolidCodec_TailPaddingAndInconsistentPrimitiveCountsAreRejected)
NWB_ADHD_GTEST(MeshSolidCodec, AdjacentBoundsPreserveFloatBitsAndRejectATruncatedLastCone, VerifyMeshSolidCodec_AdjacentBoundsPreserveFloatBitsAndRejectATruncatedLastCone)
NWB_ADHD_GTEST(MeshSolidCodec, PreviousMeshMagicCannotAdmitOtherwiseValidCurrentPayload, VerifyMeshSolidCodec_PreviousMeshMagicCannotAdmitOtherwiseValidCurrentPayload)
