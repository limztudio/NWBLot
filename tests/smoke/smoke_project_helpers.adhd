[cpp_header("<tests/smoke/test_environment.h>"), cpp_name("::NWB::Tests::Smoke::InitializeOnce")]
extern T InitializeOnce<T>(in auto initializer);


[cpp_unwind]
Expected<NotNullUniquePtr<World>> CreateSmokeWorld(in StringView projectName, mut ProjectRuntimeContext context){
    auto world = MakeUnique<World>(context.objectArena, context.cpuTasks);
    if(!world.valid()){
        [essential] error("{}: ECS world allocation failed", projectName);
        return MakeUnexpected(Failure());
    }
    if(!cast<b8>(context.shaderPathResolver)){
        [essential] error("{} initialization failed: shader path resolver callback is null", projectName);
        return MakeUnexpected(Failure());
    }
    return TryTakeNotNullUnique<World>(world);
}

b8 SmokeContextHasQuitCallback(in ProjectRuntimeContext context){ return cast<b8>(context.requestQuit); }

void RequestSmokeQuit(mut ProjectRuntimeContext context){
    if(SmokeContextHasQuitCallback(context))
        context.requestQuit();
}

NotNullUniquePtr<World> TakeSmokeWorld(mut NotNullUniquePtr<World> world){
    return TakeNotNullUnique<World>(world);
}

mut World SmokeWorldRef(mut NotNullUniquePtr<World> world){ return world.deref(); }

void SetSmokeWindowTitleSuffix(mut ProjectRuntimeContext context, in PlatformStringView projectTitle, in StringView suffix){
    const PlatformOwnedString title = AppendPlatformText(projectTitle, suffix);
    mut GraphicsRuntime graphics = context.graphics;
    graphics.setWindowTitle(PlatformStringView(title));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_DegreesPerTurn = 360.0f;
const f32 s_MaxBaselineFreezeFrame = 1000000.0f;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ArrowYawInputHandler : IInputEventHandler{
    public KeyboardInputResult keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods)override{
        const b8 pressed = action == InputAction::Press || action == InputAction::Repeat;
        if(key == Key::Left){
            this.m_leftHeld = pressed;
            return true;
        }
        if(key == Key::Right){
            this.m_rightHeld = pressed;
            return true;
        }
        return false;
    }

    public void clear(){
        this.m_leftHeld = false;
        this.m_rightHeld = false;
    }

    public f32 axis()const{
        f32 right = 0.0f;
        if(this.m_rightHeld)
            right = 1.0f;
        f32 left = 0.0f;
        if(this.m_leftHeld)
            left = 1.0f;
        return right - left;
    }

    private b8 m_leftHeld = false;
    private b8 m_rightHeld = false;
}

class YawSpinController{
    public void update(in f32 safeDelta, in f32 frozenYaw, in b8 frozenYawValid, in ArrowYawInputHandler arrowYawInput, in f32 manualYawSpeed, in f32 spinSpeed, in f32 maxSpinDelta){
        if(frozenYawValid){
            this.m_yaw = frozenYaw;
            return;
        }

        const f32 manualAxis = arrowYawInput.axis();
        if(manualAxis != 0.0f)
            this.m_manualControl = true;

        if(this.m_manualControl)
            this.m_yaw += manualAxis * manualYawSpeed * safeDelta;
        else
            this.m_yaw += Min(safeDelta, maxSpinDelta) * spinSpeed;
    }

    public f32 yaw()const{ return this.m_yaw; }

    public b8 manualControl()const{ return this.m_manualControl; }

    private f32 m_yaw = 0.0f;
    private b8 m_manualControl = false;
}

f32 ReadSmokeFrozenYawFromEnvironment(in StringView variableName){
    const Expected<f32> parsed = ReadSmokeEnvironmentF32(variableName);
    if(parsed.has_value())
        return parsed.value();
    return -1.0f;
}

u32 ParseRendererBaselineCaptureFreezeFrame(){
    const Expected<f32> configuredFrame = ReadSmokeEnvironmentF32("NWB_RENDERER_BASELINE_CAPTURE_FREEZE_FRAME");
    if(!configuredFrame.has_value() || !IsFinite(configuredFrame.value()) || configuredFrame.value() < 1.0f)
        return 0u;
    return cast<u32>(Min(configuredFrame.value(), s_MaxBaselineFreezeFrame));
}

u32 RendererBaselineCaptureFreezeFrame(){
    return InitializeOnce<u32>(lambda[]() -> u32{ return ParseRendererBaselineCaptureFreezeFrame(); });
}

f32 ParseRendererBaselineFixedDelta(){
    const Expected<f32> configuredDelta = ReadSmokeEnvironmentF32("NWB_RENDERER_BASELINE_FIXED_DELTA_SECONDS");
    if(!configuredDelta.has_value() || !IsFinite(configuredDelta.value()) || configuredDelta.value() <= 0.0f || configuredDelta.value() > 1.0f)
        return 0.0f;
    return configuredDelta.value();
}

f32 RendererBaselineFixedDelta(){
    return InitializeOnce<f32>(lambda[]() -> f32{ return ParseRendererBaselineFixedDelta(); });
}

VectorSingle CalculateSmokeYawDisplay(in VectorSingle yaw, in VectorSingle turn){
    const f32 turnScalar = turn.x;
    f32 wrapped = FMod(yaw.x, turnScalar);
    if(wrapped < 0.0f)
        wrapped += turnScalar;
    const f32 degrees = wrapped * (s_DegreesPerTurn / turnScalar);
    return VectorSingle(wrapped, degrees, wrapped, wrapped);
}

String FormatSmokeYawWindowTitleSuffix(in f32 yaw, in b8 manualControl, in f32 twoPi){
    const VectorSingle display = CalculateSmokeYawDisplay(VectorSingle(yaw), VectorSingle(twoPi));
    const f32 radians = display.x;
    const f32 degrees = display.y;
    StringView manualSuffix = "";
    if(manualControl)
        manualSuffix = "  [manual: <- ->]";
    return StringFormat("  |  yaw {:.4f} rad ({:.2f} deg){}", radians, degrees, manualSuffix);
}

EntityID CreateSmokeCameraAt(in VectorSingle position, in VectorSingle rotation, mut World world){
    Entity activeCameraEntity = world.createEntity();
    mut ActiveCameraComponent activeCamera = activeCameraEntity.addComponent<ActiveCameraComponent>();
    activeCamera.camera = CreateSceneCameraEntity(world, position);
    Entity cameraEntity = world.entity(activeCamera.camera);
    mut TransformComponent cameraTransform = cameraEntity.getComponent<TransformComponent>();
    cameraTransform.rotation = f32x4(rotation);
    return activeCamera.camera;
}

EntityID CreateSmokeCameraAt(in VectorSingle position, mut World world){
    return CreateSmokeCameraAt(position, QuaternionIdentity(), world);
}

EntityID CreateSmokeCamera(in f32 cameraHeight, in f32 cameraDistance, in f32 cameraPitch, mut World world){
    const VectorSingle pitchRotation = QuaternionRotationRollPitchYawFromVector(VectorSingle(cameraPitch, 0.0f, 0.0f, 0.0f));
    return CreateSmokeCameraAt(VectorSingle(0.0f, cameraHeight, -cameraDistance, 0.0f), pitchRotation, world);
}


