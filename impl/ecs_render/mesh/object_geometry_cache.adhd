#include <impl/ecs_render/mesh/instance_gpu_data.adhd.h>

#include <core/graphics/rhi/gpu_descriptor_heap.h>
#include <core/graphics/rhi/pipeline.h>
#include <core/graphics/rhi/resource.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ObjectGeometryCacheState;
class ObjectGeometryCacheSnapshot;
struct MeshResources;
struct RuntimeMeshBuffers;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace ECSRenderDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using ObjectGeometryCacheState = ::NWB::Impl::ObjectGeometryCacheState;
using ObjectGeometryCacheSnapshot = ::NWB::Impl::ObjectGeometryCacheSnapshot;

[[nodiscard]] b8 AcceptObjectGeometryCacheWrite(MeshResources& mesh, const RuntimeMeshBuffers& sourceBuffers, const ObjectGeometryCacheSnapshot& expected, b8 runtimeMesh)noexcept;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const ResourceStates s_ObjectGeometryRasterState = ResourceStates::VertexBuffer | ResourceStates::IndexBuffer;


class ObjectGeometryCacheState{
    public BufferHandle buffer;
    public ComputePipelineHandle decoderPipeline;
    public u64 acceptedContentRevision = 0u;
    public GpuDescriptorHandle heapHandle = GpuDescriptorHandleInvalid();
    public u32 indexByteOffset = 0u;
    public u32 indexCount = 0u;
    public b8 acceptedContent = false;
    public b8 initialized = false;
}

// The declaration retains the buffer and current content generation; acceptance validates them against the mesh owner.
class ObjectGeometryCacheSnapshot{
    public BufferHandle buffer;
    public ComputePipelineHandle decoderPipeline;
    public u64 sourceRevision = 0u;
    public GpuDescriptorHandle heapHandle = GpuDescriptorHandleInvalid();
    public u32 indexByteOffset = 0u;
    public u32 indexCount = 0u;
    public b8 initialized = false;
    public b8 requiresDecode = true;

    public b8 valid()const{
        return this.buffer.valid()
            && this.decoderPipeline.valid()
            && this.heapHandle.valid()
            && this.heapHandle.descriptorClass() == GpuDescriptorClass::StorageBuffer
            && this.indexByteOffset != 0u
            && this.indexCount != 0u;
    }
}


