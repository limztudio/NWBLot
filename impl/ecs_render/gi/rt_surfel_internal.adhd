class SurfelGiLifecycleBuilder : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut RendererRayTracingSystem m_raytracingSystem;

    public SurfelGiLifecycleBuilder(mut GpuTaskGraph graph, mut RendererRayTracingSystem raytracingSystem){
        this.m_graph = graph;
        this.m_raytracingSystem = raytracingSystem;
    }

    public Expected<SurfelGiLifecycleResult> declare(in SurfelGiLifecycleInputs inputs);
}

class SurfelGiResourceBuilder : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut RendererRayTracingSystem m_raytracingSystem;

    public SurfelGiResourceBuilder(mut GpuTaskGraph graph, mut RendererRayTracingSystem raytracingSystem){
        this.m_graph = graph;
        this.m_raytracingSystem = raytracingSystem;
    }

    public b8 prepare(in SurfelGiResourceInputs inputs, mut SurfelGiResourcePlan result);
}

class SurfelGiCounterReadbackBuilder : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut RendererRayTracingSystem m_raytracingSystem;

    public SurfelGiCounterReadbackBuilder(mut GpuTaskGraph graph, mut RendererRayTracingSystem raytracingSystem){
        this.m_graph = graph;
        this.m_raytracingSystem = raytracingSystem;
    }

    public void declare(in RayTracingSurfelPersistentResourceSnapshot rayTracingSurfelResources, in GpuTaskId surfelTask, in GpuTaskId timingEndTask, mut GpuTaskId outTask);
}

class SurfelGiTaskBuilder : NoCopy{
    private mut RendererRayTracingSystem m_system;
    private mut GpuTaskGraph m_graph;

    public SurfelGiTaskBuilder(mut RendererRayTracingSystem system, mut GpuTaskGraph graph){
        this.m_system = system;
        this.m_graph = graph;
    }

    public Expected<GpuTaskId> declareAgeFreeTask(
        in GpuTaskDesc desc,
        in DeferredLightingGraphResources deferredLightingResources,
        mut DeferredFrameTargets targets,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming
    );
    public Expected<GpuTaskId> declareHashBuildTask(
        in GpuTaskDesc desc,
        in DeferredLightingGraphResources deferredLightingResources,
        mut DeferredFrameTargets targets,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming
    );
    public Expected<GpuTaskId> declareSpawnTask(
        in GpuTaskDesc desc,
        in DeferredLightingGraphResources deferredLightingResources,
        mut DeferredFrameTargets targets,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming
    );
    public Expected<GpuTaskId> declareTraceBuildArgsTask(
        in GpuTaskDesc desc,
        in DeferredLightingGraphResources deferredLightingResources,
        mut DeferredFrameTargets targets,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming
    );
    public Expected<GpuTaskId> declareTraceTask(
        in GpuTaskDesc desc,
        in DeferredLightingGraphResources deferredLightingResources,
        mut DeferredFrameTargets targets,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming
    );
    public Expected<GpuTaskId> declareResolveTask(
        in GpuTaskDesc desc,
        in DeferredLightingGraphResources deferredLightingResources,
        mut DeferredFrameTargets targets,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming
    );
    public Expected<GpuTaskId> declareTerminalTask(
        in GpuTaskDesc desc,
        in DeferredLightingGraphResources deferredLightingResources,
        mut DeferredFrameTargets targets,
        mut GpuTimingSubmissionTicket timingTicket
    );
    public Expected<GpuTaskId> declareTerminalTask(
        in GpuTaskDesc desc,
        in DeferredLightingGraphResources deferredLightingResources,
        mut DeferredFrameTargets targets,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming
    );
}

class SurfelGiPipelineSet : NoCopy{
    private mut GraphicsRuntime m_graphics;
    private mut RendererShaderSystem m_shaderSystem;
    private mut RtSurfelGiState m_rayTracingState;

    public SurfelGiPipelineSet(mut GraphicsRuntime graphics, mut RendererShaderSystem shaderSystem, mut RtSurfelGiState state){
        this.m_graphics = graphics;
        this.m_shaderSystem = shaderSystem;
        this.m_rayTracingState = state;
    }

    public b8 ensureSurfelSpawnPipeline();
    public b8 ensureSurfelAgeFreePipeline();
    public b8 ensureSurfelHashBuildPipeline();
    public b8 ensureSurfelTracePipeline();
    public b8 ensureSurfelTraceHwPipeline();
    public b8 ensureSurfelResolvePipeline();
    public b8 ensureSurfelUpsamplePipeline();
    public b8 ensureSurfelTraceBuildArgsPipeline();
}


