struct TestCsgVisibilityFilter{
    Core::ECS::EntityID hiddenEntity = Core::ECS::s_InvalidEntityId;
};

[[nodiscard]] NWB_INLINE b8 TestCsgReceiverVisible(
    [[maybe_unused]] Core::ECS::World& world,
    const Core::ECS::EntityID entity,
    [[maybe_unused]] const Impl::CsgReceiverKind::Enum receiverKind,
    [[maybe_unused]] const Impl::CsgReceiverComponent& receiver,
    void* userData
)noexcept{
    const auto* filter = static_cast<const TestCsgVisibilityFilter*>(userData);
    return !filter || entity != filter->hiddenEntity;
}

[[nodiscard]] NWB_INLINE Impl::CsgFrameState BuildFilteredCsgFrameState(
    Core::ECS::World& world,
    Core::Alloc::ScratchArena& scratchArena,
    const Core::ECS::EntityID hiddenEntity
){
    TestCsgVisibilityFilter filter;
    filter.hiddenEntity = hiddenEntity;

    Impl::CsgFrameBuildDesc desc;
    desc.receiverVisible = &TestCsgReceiverVisible;
    desc.receiverVisibleUserData = &filter;
    return Impl::BuildCsgFrameState(world, scratchArena, desc);
}

[[nodiscard]] NWB_INLINE Expected<Impl::CsgDeformStats, Impl::CsgDeformFailure> PreviewDeformWithoutRegistry(
    Core::Alloc::ScratchArena& scratchArena,
    const Span<const Impl::CsgDeformVertex> inputVertices,
    const Span<const Impl::CsgDeformTriangle> inputTriangles,
    const Span<const Impl::CsgDeformCutDesc> cuts,
    const Impl::CsgDeformBuildOptions& options,
    Impl::CsgDeformVertexVector<Core::Alloc::ScratchArena>& outVertices,
    Impl::CsgDeformTriangleVector<Core::Alloc::ScratchArena>& outTriangles
){
    return Impl::PreviewCsgDeformCuts(scratchArena, inputVertices, inputTriangles, cuts, options, nullptr, outVertices, outTriangles);
}

template<typename CommitArenaT>
[[nodiscard]] NWB_INLINE Expected<Impl::CsgDeformStats, Impl::CsgDeformFailure> CommitDeformWithoutRegistry(
    Core::Alloc::ScratchArena& scratchArena,
    CommitArenaT& commitArena,
    const Span<const Impl::CsgDeformVertex> inputVertices,
    const Span<const Impl::CsgDeformTriangle> inputTriangles,
    const Span<const Impl::CsgDeformCutDesc> cuts,
    const Impl::CsgDeformBuildOptions& options,
    Impl::CsgDeformVertexVector<CommitArenaT>& outVertices,
    Impl::CsgDeformTriangleVector<CommitArenaT>& outTriangles
){
    return Impl::CommitCsgDeformCuts(scratchArena, commitArena, inputVertices, inputTriangles, cuts, options, nullptr, outVertices, outTriangles);
}

template<typename CommitArenaT>
[[nodiscard]] NWB_INLINE Expected<Impl::CsgDeformStats, Impl::CsgDeformFailure> CommitDeformWithRegistry(
    Core::Alloc::ScratchArena& scratchArena,
    CommitArenaT& commitArena,
    const Span<const Impl::CsgDeformVertex> inputVertices,
    const Span<const Impl::CsgDeformTriangle> inputTriangles,
    const Span<const Impl::CsgDeformCutDesc> cuts,
    const Impl::CsgDeformBuildOptions& options,
    const Impl::CsgShapeRegistry& registry,
    Impl::CsgDeformVertexVector<CommitArenaT>& outVertices,
    Impl::CsgDeformTriangleVector<CommitArenaT>& outTriangles
){
    return Impl::CommitCsgDeformCuts(scratchArena, commitArena, inputVertices, inputTriangles, cuts, options, &registry, outVertices, outTriangles);
}

[[nodiscard]] NWB_INLINE Impl::CsgDeformViability CheckDeformViabilityWithRegistry(
    Core::Alloc::ScratchArena& scratchArena,
    const Span<const Impl::CsgDeformVertex> inputVertices,
    const Span<const Impl::CsgDeformTriangle> inputTriangles,
    const Span<const Impl::CsgDeformCutDesc> cuts,
    const Impl::CsgDeformBuildOptions& options,
    const Impl::CsgShapeRegistry& registry
){
    return Impl::CheckCsgDeformCutsViability(scratchArena, inputVertices, inputTriangles, cuts, options, &registry);
}

[[nodiscard]] NWB_INLINE f32 CsgWorldBoundsMinX(const Impl::CsgShapeBounds& bounds)noexcept{
    return VectorGetX(bounds.minBounds);
}

[[nodiscard]] NWB_INLINE f32 CsgWorldBoundsMaxX(const Impl::CsgShapeBounds& bounds)noexcept{
    return VectorGetX(bounds.maxBounds);
}


