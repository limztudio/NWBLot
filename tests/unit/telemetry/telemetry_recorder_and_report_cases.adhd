inline constexpr AStringView s_RendererFrameText = "Renderer Frame";
inline constexpr u32 s_ScopeNameConversionFailure = 0x5C0FEu;
inline constexpr AStringView s_ReportArenaName = "tests/telemetry/report_work";
inline constexpr AStringView s_GBuffer = "gbuffer";
inline constexpr AStringView s_RuntimeStatisticsNone = "runtime_statistics=\"none\"";
inline constexpr AStringView s_RuntimeStatisticsNullJson = "\"runtimeStatistics\": null";
inline constexpr AStringView s_ResourceWithNullStatisticsJson = "\"kind\": \"resource\", \"flags\": 0, \"queueAssignment\": null, \"compiledTask\": null, \"runtimeStatistics\": null";

struct GenericScopeRecord{
    Name name;
    u32 generation = 1u;
};

struct BorrowedScopePointer{
    GenericScopeRecord* record = nullptr;


public:
    [[nodiscard]] GenericScopeRecord* const& get()const noexcept{ return record; }
};

struct ThrowingScopeName{
    explicit operator Name()& noexcept{ return s_NameNone; }
    operator const Name&()const&{ throw s_ScopeNameConversionFailure; }
};

struct ThrowingScopeRecord{
    ThrowingScopeName name;
};

struct PayloadBuildFailure{};

[[nodiscard]] inline b8 RecordFilledPayload(Telemetry::Recorder& recorder, const usize byteCount, const u8 value){
    return recorder.recordBuiltPayload(Telemetry::EventKind::PerfFrame, 1u, 0u, [byteCount, value](Telemetry::TelemetryArena&, Telemetry::TelemetryBytes& payload){
        EXPECT_TRUE(payload.empty());
        payload.resize(byteCount, value);
        return true;
    });
}

void RunConcurrentReset(b8 disableCapture);

void CheckTextLogPayload(Span<const u8> payload, Span<const u8> expected = {});


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


