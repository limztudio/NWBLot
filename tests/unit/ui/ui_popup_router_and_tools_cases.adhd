void VerifyUiPopupToolsBuilderTests_TooltipDelayBeginsOnlyAfterTheAnchorLayoutIsAccepted(mut UiPopupToolsBuilderTests self){
    self.m_tooltipOptions.delaySeconds = 0.5f;
    self.m_deltaSeconds = 0.25f;
    ASSERT_TRUE(self.prepareTools(1u, true, false));
    EXPECT_FALSE(self.send(MakeUiPopupRouterPointerEvent(InputEventType::PointerMove, 30.0f, 30.0f)).hover.valid());
    EXPECT_FALSE(self.m_tooltip.visible());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    ASSERT_TRUE(self.moveToAnchor());
    ASSERT_TRUE(self.acceptTools(2u, true, false));
    EXPECT_FALSE(self.m_tooltip.visible());
    ASSERT_TRUE(self.acceptTools(3u, true, false));
    EXPECT_FALSE(self.m_tooltip.visible());
    ASSERT_TRUE(self.acceptTools(4u, true, false));
    EXPECT_TRUE(self.m_tooltip.visible());
}

void VerifyUiPopupToolsBuilderTests_ZeroDelayTooltipPaintsWithoutCreatingPopupTargetsOrTakingFocus(mut UiPopupToolsBuilderTests self){
    ASSERT_TRUE(self.acceptTools(1u, true, false));
    const usize targetCount = self.m_context.input().targets().size();
    ASSERT_TRUE(self.moveToAnchor());
    ASSERT_TRUE(self.acceptTools(2u, true, false));
    EXPECT_TRUE(self.m_tooltip.visible());
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_EQ(self.m_context.input().targets().size(), targetCount);
    EXPECT_FALSE(self.hasTarget(self.id("tip", "panel")));
    const DrawSnapshot snapshot = self.m_paint.freeze();
    ASSERT_FALSE(snapshot.commands().empty());
    EXPECT_GT(snapshot.commands().back().layer, 0u);
    for(in HitTarget accepted : self.m_context.input().targets()){
        EXPECT_FALSE(accepted.popup.valid());
        EXPECT_EQ(accepted.layer, 0u);
    }
    self.press(Key::Tab);
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiPopupToolsCaseAnchorKey, s_UiPopupToolsCasePanelKey));
}

void VerifyUiPopupToolsBuilderTests_VisibleTooltipPaintsItsDeclarationStyleAfterALaterStyleChange(mut UiPopupToolsBuilderTests self){
    ASSERT_TRUE(self.acceptTools(1u, true, false));
    ASSERT_TRUE(self.moveToAnchor());
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", MakeUiPopupRouterRect(10.0f, 10.0f, 360.0f, 280.0f)));
    EXPECT_FALSE(self.m_builder.button("anchor", "Anchor", self.m_anchorOptions));
    self.m_builder.tooltipStyle().background = s_UiCaseNameButtonNormal;
    ASSERT_TRUE(self.m_builder.tooltip("tip", "anchor", "Helpful text", self.m_tooltip, self.m_tooltipOptions));
    self.m_builder.tooltipStyle().background = s_UiCaseButtonPressed;
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_tooltip.visible());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    const auto background = self.skinQuad(snapshot, 6u);
    ASSERT_TRUE(background.has_value());
    EXPECT_FLOAT_EQ(background.value().x, self.m_tooltip.placement().bounds.x);
    EXPECT_FLOAT_EQ(background.value().y, self.m_tooltip.placement().bounds.y);
}

void VerifyUiPopupToolsBuilderTests_LeavingTheAnchorCancelsVisibleTooltipAndRequiresAnotherDelay(mut UiPopupToolsBuilderTests self){
    self.m_tooltipOptions.delaySeconds = 0.5f;
    self.m_deltaSeconds = 0.5f;
    ASSERT_TRUE(self.acceptTools(1u, true, false));
    ASSERT_TRUE(self.moveToAnchor());
    ASSERT_TRUE(self.acceptTools(2u, true, false));
    ASSERT_TRUE(self.acceptTools(3u, true, false));
    ASSERT_TRUE(self.m_tooltip.visible());
    EXPECT_NE(self.send(MakeUiPopupRouterPointerEvent(InputEventType::PointerMove, 790.0f, 590.0f)).hover, self.id(s_UiPopupToolsCaseAnchorKey, s_UiPopupToolsCasePanelKey));
    ASSERT_TRUE(self.acceptTools(4u, true, false));
    EXPECT_FALSE(self.m_tooltip.visible());
    ASSERT_TRUE(self.moveToAnchor());
    ASSERT_TRUE(self.acceptTools(5u, true, false));
    EXPECT_FALSE(self.m_tooltip.visible());
    ASSERT_TRUE(self.acceptTools(6u, true, false));
    EXPECT_TRUE(self.m_tooltip.visible());
}

void VerifyUiPopupToolsBuilderTests_LeaveAndReturnBetweenDeclarationsRestartsTheTooltipDelay(mut UiPopupToolsBuilderTests self){
    self.m_tooltipOptions.delaySeconds = 0.5f;
    self.m_deltaSeconds = 0.25f;
    ASSERT_TRUE(self.acceptTools(1u, true, false));
    ASSERT_TRUE(self.moveToAnchor());
    ASSERT_TRUE(self.acceptTools(2u, true, false));
    ASSERT_TRUE(self.acceptTools(3u, true, false));
    EXPECT_FALSE(self.m_tooltip.visible());
    const u64 activity = self.m_context.input().hoverActivityGeneration();
    EXPECT_NE(self.send(MakeUiPopupRouterPointerEvent(InputEventType::PointerMove, 790.0f, 590.0f)).hover, self.id(s_UiPopupToolsCaseAnchorKey, s_UiPopupToolsCasePanelKey));
    ASSERT_TRUE(self.moveToAnchor());
    EXPECT_GT(self.m_context.input().hoverActivityGeneration(), activity);
    ASSERT_TRUE(self.acceptTools(4u, true, false));
    EXPECT_FALSE(self.m_tooltip.visible());
    ASSERT_TRUE(self.acceptTools(5u, true, false));
    EXPECT_FALSE(self.m_tooltip.visible());
    ASSERT_TRUE(self.acceptTools(6u, true, false));
    EXPECT_TRUE(self.m_tooltip.visible());
}

void VerifyUiPopupToolsBuilderTests_SameAnchorPointerMotionKeepsTheTooltipDelay(mut UiPopupToolsBuilderTests self){
    self.m_tooltipOptions.delaySeconds = 0.5f;
    self.m_deltaSeconds = 0.25f;
    ASSERT_TRUE(self.acceptTools(1u, true, false));
    ASSERT_TRUE(self.moveToAnchor());
    ASSERT_TRUE(self.acceptTools(2u, true, false));
    const u64 activity = self.m_context.input().hoverActivityGeneration();
    const Point pointer = self.m_context.input().pointerPosition();
    EXPECT_EQ(self.send(MakeUiPopupRouterPointerEvent(InputEventType::PointerMove, pointer.x + 5.0f, pointer.y)).hover, self.id(s_UiPopupToolsCaseAnchorKey, s_UiPopupToolsCasePanelKey));
    EXPECT_EQ(self.m_context.input().hoverActivityGeneration(), activity);
    ASSERT_TRUE(self.acceptTools(3u, true, false));
    EXPECT_FALSE(self.m_tooltip.visible());
    ASSERT_TRUE(self.acceptTools(4u, true, false));
    EXPECT_TRUE(self.m_tooltip.visible());
}

void VerifyUiPopupToolsBuilderTests_ClickBetweenDeclarationsRestartsTheTooltipDelay(mut UiPopupToolsBuilderTests self){
    self.m_tooltipOptions.delaySeconds = 0.5f;
    self.m_deltaSeconds = 0.25f;
    ASSERT_TRUE(self.acceptTools(1u, true, false));
    ASSERT_TRUE(self.moveToAnchor());
    ASSERT_TRUE(self.acceptTools(2u, true, false));
    ASSERT_TRUE(self.acceptTools(3u, true, false));
    ASSERT_TRUE(self.acceptTools(4u, true, false));
    ASSERT_TRUE(self.m_tooltip.visible());
    const u64 activity = self.m_context.input().hoverActivityGeneration();
    const Point pointer = self.m_context.input().pointerPosition();
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointEvent(InputEventType::PrimaryDown, pointer)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointEvent(InputEventType::PrimaryUp, pointer)).pointerConsumed);
    EXPECT_GT(self.m_context.input().hoverActivityGeneration(), activity);
    ASSERT_TRUE(self.acceptTools(5u, true, false));
    EXPECT_FALSE(self.m_tooltip.visible());
    ASSERT_TRUE(self.acceptTools(6u, true, false));
    EXPECT_FALSE(self.m_tooltip.visible());
    ASSERT_TRUE(self.acceptTools(7u, true, false));
    EXPECT_TRUE(self.m_tooltip.visible());
}

void VerifyUiPopupToolsBuilderTests_PrimaryCaptureAndSecondaryPressSuppressTheTooltip(mut UiPopupToolsBuilderTests self){
    ASSERT_TRUE(self.acceptTools(1u, true, false));
    ASSERT_TRUE(self.moveToAnchor());
    ASSERT_TRUE(self.acceptTools(2u, true, false));
    ASSERT_TRUE(self.m_tooltip.visible());
    const Point pointer = self.m_context.input().pointerPosition();
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointEvent(InputEventType::PrimaryDown, pointer)).pointerConsumed);
    ASSERT_TRUE(self.acceptTools(3u, true, false));
    EXPECT_FALSE(self.m_tooltip.visible());
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointEvent(InputEventType::PrimaryUp, pointer)).pointerConsumed);
    ASSERT_TRUE(self.acceptTools(4u, true, false));
    ASSERT_TRUE(self.m_tooltip.visible());
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointEvent(InputEventType::SecondaryDown, pointer)).pointerConsumed);
    ASSERT_TRUE(self.acceptTools(5u, true, false));
    EXPECT_FALSE(self.m_tooltip.visible());
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointEvent(InputEventType::SecondaryUp, pointer)).pointerConsumed);
}

void VerifyUiPopupToolsBuilderTests_DisabledTooltipAndDisabledAnchorCannotRetainVisibleHelp(mut UiPopupToolsBuilderTests self){
    ASSERT_TRUE(self.acceptTools(1u, true, false));
    ASSERT_TRUE(self.moveToAnchor());
    ASSERT_TRUE(self.acceptTools(2u, true, false));
    ASSERT_TRUE(self.m_tooltip.visible());
    self.m_tooltipOptions.enabled = false;
    ASSERT_TRUE(self.acceptTools(3u, true, false));
    EXPECT_FALSE(self.m_tooltip.visible());
    self.m_tooltipOptions.enabled = true;
    self.m_anchorOptions.enabled = false;
    ASSERT_TRUE(self.acceptTools(4u, true, false));
    EXPECT_FALSE(self.m_tooltip.visible());
    EXPECT_FALSE(self.m_context.input().hasPopup());
}

void VerifyUiPopupToolsBuilderTests_UnknownPointerAndNativeFocusLossCannotQualifyTooltipHover(mut UiPopupToolsBuilderTests self){
    ASSERT_TRUE(self.acceptTools(1u, true, false));
    EXPECT_FALSE(self.m_context.input().pointerKnown());
    EXPECT_FALSE(self.m_tooltip.visible());
    ASSERT_TRUE(self.moveToAnchor());
    ASSERT_TRUE(self.acceptTools(2u, true, false));
    ASSERT_TRUE(self.m_tooltip.visible());
    EXPECT_FALSE(self.send(MakeUiPopupRouterBareEvent(InputEventType::FocusLost)).focus.valid());
    EXPECT_FALSE(self.m_context.input().capture().valid());
    EXPECT_FALSE(self.send(MakeUiPopupRouterBareEvent(InputEventType::FocusGained)).focus.valid());
    ASSERT_TRUE(self.acceptTools(3u, true, false));
