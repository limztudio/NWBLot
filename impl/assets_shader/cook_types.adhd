#include <impl/assets_shader/cook_constants.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StringView ShaderOptimizationLevelText(in ShaderOptimizationLevel optimizationLevel){
    if(optimizationLevel == ShaderOptimizationLevel::None)
        return s_ShaderNoneOptText;
    if(optimizationLevel == ShaderOptimizationLevel::Default)
        return s_ShaderDefaultVariantText;
    if(optimizationLevel == ShaderOptimizationLevel::High)
        return s_ShaderHighOptText;
    if(optimizationLevel == ShaderOptimizationLevel::Maximal)
        return s_ShaderMaximalOptText;
    return "";
}

StringView SlangOptimizationArgument(in ShaderOptimizationLevel optimizationLevel){
    if(optimizationLevel == ShaderOptimizationLevel::None)
        return "-O0";
    if(optimizationLevel == ShaderOptimizationLevel::High)
        return "-O2";
    if(optimizationLevel == ShaderOptimizationLevel::Maximal)
        return "-O3";
    return "";
}

b8 IsAllowedShaderMetadataField(in StringView field, in b8 isMesh){
    return
        field == s_ShaderRayQueryField
        || field == s_ShaderOptimizationLevelField
        || field == s_ShaderEntryPointField
        || field == s_ShaderIncludeRootsField
        || field == s_ShaderDefinesField
        || (isMesh && field == s_ShaderEmitMeshComputeShadowField)
    ;
}

b8 IsReservedShaderEngineDefineName(in StringView defineName){
    return defineName == "NWB_BINDLESS_TLAS" || defineName == "NWB_CAUSTIC_PHOTON_TRANSPORT";
}

Expected<IncludeDirective> TryExtractIncludeDirective(in StringView line){
    IncludeDirective include;

    usize cursor = 0u;
    while(cursor < line.size() && isAsciiSpace(line[cursor]))
        ++cursor;
    if(cursor >= line.size() || line[cursor] != '#')
        return makeUnexpected(Failure());
    ++cursor;
    while(cursor < line.size() && isAsciiSpace(line[cursor]))
        ++cursor;
    usize directiveBegin = cursor;
    while(cursor < line.size() && isAsciiIdentifierChar(line[cursor]))
        ++cursor;
    StringView directive = line.substr(directiveBegin, cursor - directiveBegin);
    if(directive == "include_next" || directive == "import"){
        include.kind = IncludeKind::Unsupported;
        include.name = trimView(line.substr(cursor));
        return include;
    }
    if(directive != "include")
        return makeUnexpected(Failure());
    while(cursor < line.size() && isAsciiSpace(line[cursor]))
        ++cursor;
    if(cursor >= line.size()){
        include.kind = IncludeKind::Unsupported;
        return include;
    }

    i8 closingDelimiter = '"';
    if(line[cursor] == '"')
        include.kind = IncludeKind::Relative;
    else if(line[cursor] == '<'){
        include.kind = IncludeKind::Standard;
        closingDelimiter = '>';
    }
    else{
        include.kind = IncludeKind::Macro;
        include.name = trimView(line.substr(cursor));
        return include;
    }
    ++cursor;
    usize closingDelimiterPos = line.size();
    for(usize i = cursor; i < line.size(); ++i){
        if(line[i] == closingDelimiter){
            closingDelimiterPos = i;
            break;
        }
    }
    if(closingDelimiterPos >= line.size() || closingDelimiterPos <= cursor){
        include.kind = IncludeKind::Unsupported;
        return include;
    }
    include.name = line.substr(cursor, closingDelimiterPos - cursor);
    return include;
}

b8 IsAllowedIncludeMetadataField(in StringView field){
    return field == s_ShaderDefinesField;
}

b8 IsValidShaderDefineValueText(in StringView valueView){
    if(valueView.empty() || trimView(valueView) != valueView)
        return false;
    for(usize i = 0u; i < valueView.size(); ++i){
        const i8 ch = valueView[i];
        if(ch == ';' || ch == '\0' || ch == '\r' || ch == '\n')
            return false;
    }
    return true;
}

b8 TryParseVariantSignatureSegment(
    in StringView variantSignature,
    mut usize inOutCursor,
    mut StringView outSegment,
    mut StringView outDefineName,
    mut StringView outDefineValue,
    mut VariantSignatureSegmentError outError
){
    const usize begin = inOutCursor;
    usize segmentEnd = variantSignature.size();
    for(usize i = begin; i < variantSignature.size(); ++i){
        if(variantSignature[i] == ';'){
            segmentEnd = i;
            break;
        }
    }
    inOutCursor = segmentEnd + 1u;

    const StringView segment = trimView(variantSignature.substr(begin, segmentEnd - begin));
    outSegment = segment;
    if(segment.empty()){
        outError = VariantSignatureSegmentError::EmptySegment;
        return false;
    }

    usize equalPos = segment.size();
    for(usize i = 0u; i < segment.size(); ++i){
        if(segment[i] == '='){
            equalPos = i;
            break;
        }
    }
    if(equalPos == 0u || equalPos + 1u >= segment.size()){
        outError = VariantSignatureSegmentError::InvalidAssignment;
        return false;
    }

    const StringView defineName = trimView(segment.substr(0u, equalPos));
    const StringView defineValue = trimView(segment.substr(equalPos + 1u));
    if(defineName.empty() || defineValue.empty()){
        outError = VariantSignatureSegmentError::InvalidAssignment;
        return false;
    }

    outDefineName = defineName;
    outDefineValue = defineValue;
    outError = VariantSignatureSegmentError::None;
    return true;
}

b8 ValidateVariantSignaturePreamble(
    in StringView contextLabel,
    in StringView variantSignature,
    in b8 definesEmpty,
    mut b8 outIsComplete
){
    outIsComplete = false;
    if(variantSignature.empty()){
        outIsComplete = true;
        return true;
    }
    if(variantSignature == s_ShaderDefaultVariantText){
        if(definesEmpty){
            outIsComplete = true;
            return true;
        }
        error("Meta '{}': variant 'default' is only valid when no defines are specified", contextLabel);
        return false;
    }
    if(definesEmpty){
        error("Meta '{}': variant '{}' requires defines to be specified", contextLabel, variantSignature);
        return false;
    }
    return true;
}

b8 ValidateVariantSignatureAssignmentStatus(
    in StringView contextLabel,
    in StringView variantSignature,
    in StringView defineName,
    in StringView defineValue,
    in b8 defineKnown,
    in b8 valueFound,
    in b8 insertedUnique
){
    if(!defineKnown){
        error("Meta '{}': variant '{}' references unknown define '{}'", contextLabel, variantSignature, defineName);
        return false;
    }
    if(!valueFound){
        error("Meta '{}': variant '{}' has unsupported value '{}' for define '{}'", contextLabel, variantSignature, defineValue, defineName);
        return false;
    }
    if(!insertedUnique){
        error("Meta '{}': variant '{}' assigns define '{}' more than once", contextLabel, variantSignature, defineName);
        return false;
    }
    return true;
}

void ReportVariantSignatureSegmentError(
    in StringView contextLabel,
    in StringView variantSignature,
    in VariantSignatureSegmentError segmentError,
    in StringView segment
){
    if(segmentError == VariantSignatureSegmentError::EmptySegment)
        error("Meta '{}': variant '{}' has invalid empty segment", contextLabel, variantSignature);
    else
        error("Meta '{}': variant '{}' has invalid assignment '{}'", contextLabel, variantSignature, segment);
}

b8 ValidateVariantSignatureSeenCount(
    in StringView contextLabel,
    in StringView variantSignature,
    in usize seenCount,
    in usize expectedCount
){
    if(seenCount == expectedCount)
        return true;

    error("Meta '{}': variant '{}' must assign all defines", contextLabel, variantSignature);
    return false;
}

Expected<ShaderOptimizationLevel> TryParseShaderOptimizationLevelText(in StringView text){
    if(text == s_ShaderNoneOptText)
        return ShaderOptimizationLevel::None;
    if(text == s_ShaderDefaultVariantText)
        return ShaderOptimizationLevel::Default;
    if(text == s_ShaderHighOptText)
        return ShaderOptimizationLevel::High;
    if(text == s_ShaderMaximalOptText)
        return ShaderOptimizationLevel::Maximal;
    return makeUnexpected(Failure());
}

b8 ValidateShaderDefineEntrySpec(
    in StringView nwbFilePathText,
    in StringView authoredName,
    in Span<String> defineValues
){
    if(IsReservedShaderEngineDefineName(authoredName)){
        error("Meta '{}': define '{}' is an engine transport feature selected in shader source", nwbFilePathText, authoredName);
        return false;
    }
    if(!IsAsciiIdentifier(authoredName)){
        error("Meta '{}': define '{}' must be an ASCII shader identifier", nwbFilePathText, authoredName);
        return false;
    }
    if(defineValues.empty()){
        error("Meta '{}': define '{}' must provide at least one value", nwbFilePathText, authoredName);
        return false;
    }
    for(in String defineValue : defineValues){
        if(!IsValidShaderDefineValueText(defineValue)){
            error("Meta '{}': define '{}' values must be nonempty variant text without semicolons, line breaks, nulls, or surrounding whitespace", nwbFilePathText, authoredName);
            return false;
        }
    }
    return true;
}

b8 ValidateShaderIncludeRoots(in StringView nwbFilePathText, in Span<String> includeRoots){
    for(in String includeRoot : includeRoots){
        if(includeRoot.empty()){
            error("Shader meta '{}': include_roots entries must not be empty", nwbFilePathText);
            return false;
        }
    }
    return true;
}

void AppendShaderChecksumLine(in StringView text, mut u64 inOutChecksum){
    for(usize i = 0u; i < text.size(); ++i)
        inOutChecksum = updateFnv64Byte(inOutChecksum, cast<u8>(text[i]));
    inOutChecksum = updateFnv64Byte(inOutChecksum, s_ShaderChecksumNewlineByte);
}

u64 BeginShaderSourceChecksum(
    in StringView name,
    in StringView stage,
    in StringView archiveStage,
    in b8 rayQuery,
    in ShaderOptimizationLevel optimizationLevel,
    in StringView entryPoint,
    in StringView variantSignature
){
    u64 checksum = 14695981039346656037ul;
    AppendShaderChecksumLine(s_ShaderSourceChecksumVersionTag, checksum);
    AppendShaderChecksumLine(name, checksum);
    AppendShaderChecksumLine(stage, checksum);
    AppendShaderChecksumLine(archiveStage, checksum);
    if(rayQuery)
        AppendShaderChecksumLine(s_Spirv15RayQueryTargetProfileText, checksum);
    else
        AppendShaderChecksumLine(s_Spirv15TargetProfileText, checksum);
    AppendShaderChecksumLine(ShaderOptimizationLevelText(optimizationLevel), checksum);
    AppendShaderChecksumLine(entryPoint, checksum);
    AppendShaderChecksumLine(variantSignature, checksum);
    return checksum;
}

u64 FinalizeShaderSourceChecksum(
    in u64 dependencyChecksum,
    in u64 compilerFingerprint,
    mut u64 inOutChecksum
){
    inOutChecksum = updateFnv64U64(inOutChecksum, dependencyChecksum);
    inOutChecksum = updateFnv64U64(inOutChecksum, compilerFingerprint);
    return inOutChecksum;
}

b8 HasShaderDependencyUtf8Bom(in Span<u8> bytes){
    return bytes.size() >= 3u && bytes[0u] == 0xEFu && bytes[1u] == 0xBBu && bytes[2u] == 0xBFu;
}

void AppendShaderDependencyItemChecksum(
    in StringView canonicalPath,
    in Span<u8> dependencyBytes,
    mut u64 inOutChecksum,
    mut b8 inOutCompilerInputsHaveBom
){
    AppendShaderChecksumLine(canonicalPath, inOutChecksum);
    if(HasShaderDependencyUtf8Bom(dependencyBytes))
        inOutCompilerInputsHaveBom = true;
    for(in u8 b : dependencyBytes)
        inOutChecksum = updateFnv64Byte(inOutChecksum, b);
    inOutChecksum = updateFnv64Byte(inOutChecksum, s_ShaderChecksumZeroByte);
}

void AppendShaderFingerprintText(in StringView text, mut u64 inOutFingerprint){
    for(usize i = 0u; i < text.size(); ++i)
        inOutFingerprint = updateFnv64Byte(inOutFingerprint, cast<u8>(text[i]));
}

Expected<StringView> TryMapStageToSlangStageFromTable(in StringView stage, in Span<SlangStageMapping> mappings){
    for(in SlangStageMapping mapping : mappings){
        if(stage == mapping.stage)
            return mapping.slangStage;
    }
    return makeUnexpected(Failure());
}

u64 FinalizeSlangCompilerFingerprint(
    in StringView versionText,
    in Span<StringView> commonArguments,
    in Span<StringView> baselineCapabilities,
    in Span<SlangStageMapping> stageMappings,
    mut u64 inOutFingerprint
){
    AppendShaderFingerprintText(trimView(versionText), inOutFingerprint);
    for(in StringView argument : commonArguments)
        AppendShaderFingerprintText(argument, inOutFingerprint);
    for(in StringView capability : baselineCapabilities){
        AppendShaderFingerprintText(s_SlangCapabilityArgument, inOutFingerprint);
        AppendShaderFingerprintText(capability, inOutFingerprint);
    }
    AppendShaderFingerprintText(s_SpvRayQueryCapabilityText, inOutFingerprint);
    AppendShaderFingerprintText(s_SlangEntryPointArgument, inOutFingerprint);
    AppendShaderFingerprintText(s_SlangStageArgument, inOutFingerprint);
    AppendShaderFingerprintText(s_SlangIncludeArgument, inOutFingerprint);
    AppendShaderFingerprintText(s_SlangDefineArgument, inOutFingerprint);
    AppendShaderFingerprintText(s_SlangOutputArgument, inOutFingerprint);
    for(in SlangStageMapping mapping : stageMappings){
        AppendShaderFingerprintText(mapping.stage, inOutFingerprint);
        AppendShaderFingerprintText(mapping.slangStage, inOutFingerprint);
    }
    for(u8 optimizationLevel = 0u; optimizationLevel < cast<u8>(ShaderOptimizationLevel::kCount); ++optimizationLevel)
        AppendShaderFingerprintText(SlangOptimizationArgument(cast<ShaderOptimizationLevel>(optimizationLevel)), inOutFingerprint);
    return inOutFingerprint;
}

b8 ValidateSlangCompilerRequestInputs(
    in StringView shaderName,
    in b8 sourcePathEmpty,
    in b8 outputPathEmpty,
    in StringView entryPoint,
    in StringView stage,
    in u8 optimizationLevelValue,
    in Span<SlangStageMapping> stageMappings,
    mut StringView outSlangStage,
    mut StringView outOptimizationArgument
){
    if(sourcePathEmpty){
        error("Failed to compile shader '{}' : source path is empty", shaderName);
        return false;
    }
    if(outputPathEmpty){
        error("Failed to compile shader '{}' : output path is empty", shaderName);
        return false;
    }
    if(entryPoint.empty()){
        error("Failed to compile shader '{}' : entry point is empty", shaderName);
        return false;
    }
    const Expected<StringView> slangStage = TryMapStageToSlangStageFromTable(stage, stageMappings);
    if(!slangStage.has_value()){
        error("Unknown shader stage '{}' in entry '{}'", stage, shaderName);
        return false;
    }
    if(optimizationLevelValue >= cast<u8>(ShaderOptimizationLevel::kCount)){
        error("Shader '{}' uses an invalid optimization level {}", shaderName, cast<u32>(optimizationLevelValue));
        return false;
    }
    outSlangStage = slangStage.value();
    outOptimizationArgument = SlangOptimizationArgument(cast<ShaderOptimizationLevel>(optimizationLevelValue));
    return true;
}

b8 TryComputeSlangCompilerArgumentCounts(
    in StringView shaderName,
    in usize includeDirectoryCount,
    in usize defineCount,
    mut usize outArgumentReserve,
    mut usize outOwnedArgumentCount
){
    if(defineCount > usize.max - s_MaxFixedArgumentCount || includeDirectoryCount > (usize.max - s_MaxFixedArgumentCount - defineCount) / 2u){
        error("ShaderCook: compiler request for '{}' has too many arguments", shaderName);
        return false;
    }
    outArgumentReserve = s_MaxFixedArgumentCount + includeDirectoryCount * 2u + defineCount;
    outOwnedArgumentCount = s_SlangFixedOwnedArgumentCount + includeDirectoryCount + defineCount;
    return true;
}


