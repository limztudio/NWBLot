void VerifyClipboard_RequestsCopyTextAndPublishOnlyWhenPumped(){
    FakeClipboardContext ctx = FakeClipboardContext();
    AssignGlobalString(ctx.scratch, "Hello \xED\x95\x9C\xEA\xB8\x80 \xF0\x9F\x98\x80");
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> write = ctx.service.requestWriteText(ClipboardChannel::Clipboard, ViewGlobalString(ctx.scratch));
    ASSERT_TRUE(write.has_value());
    AssignGlobalString(ctx.scratch, "changed");
    EXPECT_EQ(ctx.service.poll(write.value(), ctx.completion), ClipboardPollResult::Pending);
    EXPECT_EQ(ctx.service.m_writeCount, 0u);
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> read = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(read.has_value());
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.poll(write.value(), ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.status, ClipboardStatus::Success);
    EXPECT_EQ(ctx.service.poll(read.value(), ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.text, "Hello \xED\x95\x9C\xEA\xB8\x80 \xF0\x9F\x98\x80");
    EXPECT_EQ(ctx.completion.token, read.value());
    EXPECT_EQ(ctx.service.poll(read.value(), ctx.completion), ClipboardPollResult::InvalidRequest);
}

void VerifyClipboard_CancelPreventsPendingWritesAndRejectsReusedGenerations(){
    FakeClipboardContext ctx = FakeClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> canceledAdmission = ctx.service.requestWriteText(ClipboardChannel::Clipboard, "discard");
    ASSERT_TRUE(canceledAdmission.has_value());
    const ClipboardRequestToken canceled = canceledAdmission.value();
    ASSERT_TRUE(ctx.service.cancel(canceled));
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> currentAdmission = ctx.service.requestWriteText(ClipboardChannel::Clipboard, "keep");
    ASSERT_TRUE(currentAdmission.has_value());
    const ClipboardRequestToken current = currentAdmission.value();
    EXPECT_NE(canceled.generation, current.generation);
    EXPECT_EQ(ctx.service.poll(canceled, ctx.completion), ClipboardPollResult::InvalidRequest);
    EXPECT_FALSE(ctx.service.cancel(canceled));
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.m_writeCount, 1u);
    EXPECT_EQ(ctx.service.m_text, "keep");
    ASSERT_TRUE(ctx.service.cancel(current));
    EXPECT_EQ(ctx.service.poll(current, ctx.completion), ClipboardPollResult::InvalidRequest);
    EXPECT_EQ(ctx.service.m_text, "keep");
}

void VerifyClipboard_ReusedSlotsKeepRequestOrdering(){
    FakeClipboardContext ctx = FakeClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> firstAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(firstAdmission.has_value());
    const ClipboardRequestToken first = firstAdmission.value();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> secondAdmission = ctx.service.requestWriteText(ClipboardChannel::Clipboard, "second");
    ASSERT_TRUE(secondAdmission.has_value());
    const ClipboardRequestToken second = secondAdmission.value();
    ASSERT_TRUE(ctx.service.cancel(first));
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> thirdAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(thirdAdmission.has_value());
    const ClipboardRequestToken third = thirdAdmission.value();
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.poll(second, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.service.poll(third, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.text, "second");
}

void VerifyClipboard_TokensCannotCrossServicesOrSurviveServiceRecreation(){
    StandaloneClipboardCompletion out = StandaloneClipboardCompletion();
    ClipboardRequestToken old = ClipboardRequestToken();
    {
        FakeClipboardContext previous = FakeClipboardContext();
        const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> oldAdmission = previous.service.requestReadText(ClipboardChannel::Clipboard);
        ASSERT_TRUE(oldAdmission.has_value());
        old = oldAdmission.value();
    }
    FakeClipboardContext currentCtx = FakeClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> currentAdmission = currentCtx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(currentAdmission.has_value());
    const ClipboardRequestToken current = currentAdmission.value();
    EXPECT_NE(old.service, current.service);
    EXPECT_EQ(currentCtx.service.poll(old, out.completion), ClipboardPollResult::InvalidRequest);
    EXPECT_FALSE(currentCtx.service.cancel(old));
    EXPECT_EQ(currentCtx.service.poll(ClipboardRequestToken(), out.completion), ClipboardPollResult::InvalidRequest);
}

void VerifyClipboard_CanceledNativeCompletionCannotReachNewRequest(){
    FakeClipboardContext ctx = FakeClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> oldAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(oldAdmission.has_value());
    const ClipboardRequestToken old = oldAdmission.value();
    ClipboardRequestToken current = ClipboardRequestToken();
    native(mut ctx, in old, mut current){
        ctx.service.m_onRead = [&]() {
            EXPECT_TRUE(ctx.service.cancel(old));
            const auto currentAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
            ASSERT_TRUE(currentAdmission);
            current = *currentAdmission;
            EXPECT_FALSE(ctx.service.pump());
        };
        ASSERT_NO_FATAL_FAILURE(ASSERT_TRUE(ctx.service.pump()));
        ctx.service.m_onRead = {};
    }
    EXPECT_EQ(ctx.service.poll(old, ctx.completion), ClipboardPollResult::InvalidRequest);
    EXPECT_EQ(ctx.service.poll(current, ctx.completion), ClipboardPollResult::Pending);
    AssignGlobalString(ctx.service.m_text, "new completion");
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.poll(current, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.text, "new completion");
}

void VerifyClipboard_UnsupportedChannelsAndUnavailableReadsStayExplicit(){
    FakeClipboardContext ctx = FakeClipboardContext();
    EXPECT_FALSE(ctx.service.capabilities(ClipboardChannel::PrimarySelection).readText);
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> primaryAdmission = ctx.service.requestReadText(ClipboardChannel::PrimarySelection);
    ASSERT_TRUE(primaryAdmission.has_value());
    const ClipboardRequestToken primary = primaryAdmission.value();
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.poll(primary, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.status, ClipboardStatus::Unsupported);
    EXPECT_EQ(ctx.service.m_readCount, 0u);
    ctx.service.m_readStatus = ClipboardStatus::Unavailable;
    AssignGlobalString(ctx.service.m_text, "must not escape failed read");
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> unavailableAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(unavailableAdmission.has_value());
    const ClipboardRequestToken unavailable = unavailableAdmission.value();
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.poll(unavailable, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.status, ClipboardStatus::Unavailable);
    EXPECT_TRUE(ctx.completion.text.empty());
}

void VerifyClipboard_UnsupportedFactoryDoesNotAccessNativeClipboard(){
    UnsupportedClipboardContext ctx = UnsupportedClipboardContext();
    ASSERT_TRUE(ctx.factorySucceeded);
    ASSERT_TRUE(ctx.hasService());
    EXPECT_FALSE(ctx.capabilities(ClipboardChannel::Clipboard).readText);
    EXPECT_FALSE(ctx.capabilities(ClipboardChannel::Clipboard).writeText);
    EXPECT_FALSE(ctx.capabilities(ClipboardChannel::PrimarySelection).readText);
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> tokenAdmission = ctx.requestWriteText(ClipboardChannel::Clipboard, "unused");
    ASSERT_TRUE(tokenAdmission.has_value());
    const ClipboardRequestToken token = tokenAdmission.value();
    ASSERT_TRUE(ctx.pump());
    EXPECT_EQ(ctx.poll(token), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.status, ClipboardStatus::Unsupported);
}

void VerifyClipboard_AdmissionBoundsOutstandingRequestsAndText(){
    FakeClipboardContext ctx = FakeClipboardContext();
    Vector<ClipboardRequestToken> tokens = Vector<ClipboardRequestToken>();
    for(usize index = 0u; index < s_ClipboardMaxOutstandingRequests; ++index){
        const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> request = ctx.service.requestReadText(ClipboardChannel::Clipboard);
        ASSERT_TRUE(request.has_value());
        tokens.push_back(request.value());
    }
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> queueFullRead = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_FALSE(queueFullRead.has_value());
    EXPECT_EQ(queueFullRead.error(), ClipboardAdmission::QueueFull);
    for(in ClipboardRequestToken token : tokens){
        ASSERT_TRUE(ctx.service.cancel(token));
    }
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> invalidAdmission = ctx.service.requestWriteText(ClipboardChannel::Clipboard, StringView("a\0b", 3u));
    ASSERT_TRUE(invalidAdmission.has_value());
    const ClipboardRequestToken invalid = invalidAdmission.value();
    EXPECT_EQ(ctx.service.poll(invalid, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.status, ClipboardStatus::InvalidText);
    FillGlobalString(ctx.scratch, s_ClipboardMaxTextBytes + 1u, 0x78u);
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> largeAdmission = ctx.service.requestWriteText(ClipboardChannel::Clipboard, ViewGlobalString(ctx.scratch));
    ASSERT_TRUE(largeAdmission.has_value());
    const ClipboardRequestToken large = largeAdmission.value();
    EXPECT_EQ(ctx.service.poll(large, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.status, ClipboardStatus::TooLarge);
    EXPECT_EQ(ctx.service.m_writeCount, 0u);
}

void VerifyClipboard_WrongThreadCallsNeverTouchRequestStorage(){
    FakeClipboardContext ctx = FakeClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> tokenAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(tokenAdmission.has_value());
    const ClipboardRequestToken token = tokenAdmission.value();
    native(mut ctx, in token){
        Thread worker([&]() {
            EXPECT_FALSE(ctx.service.isOwnerThread());
            const auto wrongThreadRead = ctx.service.requestReadText(ClipboardChannel::Clipboard);
            ASSERT_FALSE(wrongThreadRead);
            EXPECT_EQ(wrongThreadRead.error(), ClipboardAdmission::WrongThread);
            const auto wrongThreadWrite = ctx.service.requestWriteText(ClipboardChannel::Clipboard, "ignored");
            ASSERT_FALSE(wrongThreadWrite);
            EXPECT_EQ(wrongThreadWrite.error(), ClipboardAdmission::WrongThread);
            EXPECT_EQ(ctx.service.poll(token, ctx.completion), ClipboardPollResult::WrongThread);
            EXPECT_FALSE(ctx.service.cancel(token));
            EXPECT_FALSE(ctx.service.pump());
        });
        worker.join();
        ASSERT_FALSE(::testing::Test::HasFatalFailure());
    }
    EXPECT_EQ(ctx.service.poll(token, ctx.completion), ClipboardPollResult::Pending);
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.poll(token, ctx.completion), ClipboardPollResult::Completed);
}

void VerifyClipboard_ConsumedCompletionOutlivesServiceAndItsArena(){
    StandaloneClipboardCompletion out = StandaloneClipboardCompletion();
    {
        FakeClipboardContext ctx = FakeClipboardContext();
        AssignGlobalString(ctx.service.m_text, "owned result");
        const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> tokenAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
        ASSERT_TRUE(tokenAdmission.has_value());
        const ClipboardRequestToken token = tokenAdmission.value();
        ASSERT_TRUE(ctx.service.pump());
        EXPECT_EQ(ctx.service.poll(token, out.completion), ClipboardPollResult::Completed);
    }
    EXPECT_EQ(out.completion.text, "owned result");
}


