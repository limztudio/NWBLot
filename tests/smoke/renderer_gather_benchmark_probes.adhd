namespace Tests::Smoke{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererCompilerStatisticsProbe final : public Core::IRenderPass{
private:
    struct Sample{
        Core::GpuTaskGraphCompileStatistics compile;
        u64 sourceFrame = 0u;
        u64 recordingAttempt = 0u;
        usize acceptedPackets = 0u;
        usize acceptedTasks = 0u;
        usize rejectedPackets = 0u;
        usize rejectedTasks = 0u;
        b8 valid = false;
    };


private:
    static constexpr usize s_Capacity = s_CompilerStatisticsProbeCapacity;


public:
    RendererCompilerStatisticsProbe(Core::GraphicsRuntime& graphics, Core::Alloc::GlobalArena& arena)noexcept;
    virtual ~RendererCompilerStatisticsProbe()noexcept override;


public:
    [[nodiscard]] b8 start(AStringView path, Impl::RendererSystem& renderer);
    void stop();
    [[nodiscard]] b8 write()const;
    virtual b8 shouldRenderUnfocused()noexcept override{ return true; }
    virtual void render(Core::Framebuffer*)override;


private:
    Vector<Sample, Core::Alloc::GlobalArena> m_samples;
    AString<Core::Alloc::GlobalArena> m_output;
    Impl::RendererSystem* m_renderer = nullptr;
    u64 m_attempts = 0u;
    b8 m_enabled = false;
    b8 m_registered = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_renderer_compiler_statistics_probe{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


constexpr AStringView s_ValidStatus = "valid";

struct DurationField{
    AStringView name;
    f64 Core::GpuTaskGraphCompileStatistics::*member;
};

struct CountField{
    AStringView name;
    usize Core::GpuTaskGraphCompileStatistics::*member;
};

static constexpr Array<DurationField, 12> s_Durations = {{
    { "declaration", &Core::GpuTaskGraphCompileStatistics::declarationSeconds },
    { "analysis", &Core::GpuTaskGraphCompileStatistics::analysisSeconds },
    { "validation", &Core::GpuTaskGraphCompileStatistics::validationSeconds },
    { "dependency_analysis", &Core::GpuTaskGraphCompileStatistics::dependencyAnalysisSeconds },
    { "hazard_analysis", &Core::GpuTaskGraphCompileStatistics::hazardAnalysisSeconds },
    { "topological_order", &Core::GpuTaskGraphCompileStatistics::topologicalOrderSeconds },
    { "queue_assignment", &Core::GpuTaskGraphCompileStatistics::queueAssignmentSeconds },
    { "planning", &Core::GpuTaskGraphCompileStatistics::planningSeconds },
    { "total", &Core::GpuTaskGraphCompileStatistics::totalSeconds },
    { "packetization", &Core::GpuTaskGraphCompileStatistics::packetizationSeconds },
    { "resource_state_planning", &Core::GpuTaskGraphCompileStatistics::resourceStatePlanningSeconds },
    { "packet_dependency_planning", &Core::GpuTaskGraphCompileStatistics::packetDependencyPlanningSeconds },
}};

static constexpr Array<CountField, 19> s_Counts = {{
    { "task", &Core::GpuTaskGraphCompileStatistics::taskCount },
    { "resource", &Core::GpuTaskGraphCompileStatistics::resourceCount },
    { "resource_use", &Core::GpuTaskGraphCompileStatistics::resourceUseCount },
    { "resource_version", &Core::GpuTaskGraphCompileStatistics::resourceVersionCount },
    { "resource_version_edge", &Core::GpuTaskGraphCompileStatistics::resourceVersionEdgeCount },
    { "explicit_dependency", &Core::GpuTaskGraphCompileStatistics::explicitDependencyCount },
    { "inferred_dependency", &Core::GpuTaskGraphCompileStatistics::inferredDependencyCount },
    { "external_dependency", &Core::GpuTaskGraphCompileStatistics::externalDependencyCount },
    { "packet", &Core::GpuTaskGraphCompileStatistics::packetCount },
    { "packet_dependency", &Core::GpuTaskGraphCompileStatistics::packetDependencyCount },
    { "packet_external_dependency", &Core::GpuTaskGraphCompileStatistics::packetExternalDependencyCount },
    { "cross_queue_packet_dependency", &Core::GpuTaskGraphCompileStatistics::crossQueuePacketDependencyCount },
    { "prologue_state_seed", &Core::GpuTaskGraphCompileStatistics::prologueStateSeedCount },
    { "prologue_barrier", &Core::GpuTaskGraphCompileStatistics::prologueBarrierCount },
    { "epilogue_barrier", &Core::GpuTaskGraphCompileStatistics::epilogueBarrierCount },
    { "state_export_barrier", &Core::GpuTaskGraphCompileStatistics::stateExportBarrierCount },
    { "resource_set", &Core::GpuTaskGraphCompileStatistics::resourceSetCount },
    { "direct_resource_use", &Core::GpuTaskGraphCompileStatistics::directResourceUseCount },
    { "expanded_resource_set_member_use", &Core::GpuTaskGraphCompileStatistics::expandedResourceSetMemberUseCount },
}};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


RendererCompilerStatisticsProbe::RendererCompilerStatisticsProbe(Core::GraphicsRuntime& graphics, Core::Alloc::GlobalArena& arena)noexcept
    : IRenderPass(graphics)
    , m_samples(arena)
    , m_output(arena)
{}

RendererCompilerStatisticsProbe::~RendererCompilerStatisticsProbe()noexcept{ stop(); }

b8 RendererCompilerStatisticsProbe::start(const AStringView path, Impl::RendererSystem& renderer){
    if(m_enabled || path.empty())
        return false;
    m_output.assign(path);
    m_samples.reserve(s_Capacity);
    m_renderer = &renderer;
    getGraphics().addRenderPassToBack(*this);
    m_registered = true;
    m_enabled = true;
    return true;
}

void RendererCompilerStatisticsProbe::stop(){
    if(m_registered){
        getGraphics().removeRenderPass(*this);
        m_registered = false;
    }
    m_renderer = nullptr;
}

b8 RendererCompilerStatisticsProbe::write()const{
    if(!m_enabled)
        return true;
    if(m_registered)
        return false;
    OutputFileStream output(m_output.c_str(), s_FileOpenTruncate);
    if(!output.is_open())
        return false;
    output.precision(17);
    output << "{\"type\":\"compiler_statistics_configuration\",\"schema\":1,\"capacity\":" << s_Capacity << "}\n";
    usize invalid = 0u;
    for(usize index = 0u; index < m_samples.size(); ++index){
        const Sample& sample = m_samples[index];
        AStringView status = sample.valid ? __hidden_renderer_compiler_statistics_probe::s_ValidStatus : "invalid_snapshot";
        if(sample.valid){
            for(const auto& field : __hidden_renderer_compiler_statistics_probe::s_Durations){
                const f64 seconds = sample.compile.*field.member;
                if(!IsFinite(seconds) || seconds < 0.0){
                    status = "invalid_duration";
                    break;
                }
            }
            for(usize previous = 0u; previous < index; ++previous){
                const Sample& prior = m_samples[previous];
                if(prior.valid && prior.compile.graphGeneration == sample.compile.graphGeneration && prior.compile.planGeneration == sample.compile.planGeneration && prior.compile.deviceGeneration == sample.compile.deviceGeneration){
                    status = "duplicate_plan";
                    break;
                }
            }
        }
        if(index != 0u && sample.sourceFrame <= m_samples[index - 1u].sourceFrame)
            status = "non_monotonic_frame";
        output << "{\"type\":\"compiler_statistics\",\"sequence\":" << index << ",\"source_frame\":" << sample.sourceFrame << ",\"status\":\"" << status << '\"';
        if(status == __hidden_renderer_compiler_statistics_probe::s_ValidStatus){
            output << ",\"identity\":{\"graph_generation\":" << sample.compile.graphGeneration
                << ",\"plan_generation\":" << sample.compile.planGeneration
                << ",\"device_generation\":" << sample.compile.deviceGeneration
                << ",\"recording_attempt_generation\":" << sample.recordingAttempt << "},\"seconds\":{";
            b8 first = true;
            for(const auto& field : __hidden_renderer_compiler_statistics_probe::s_Durations){
                if(!first)
                    output << ',';
                first = false;
                output << '\"' << field.name << "\":" << sample.compile.*field.member;
            }
            output << "},\"counts\":{";
            first = true;
            for(const auto& field : __hidden_renderer_compiler_statistics_probe::s_Counts){
                if(!first)
                    output << ',';
                first = false;
                output << '\"' << field.name << "\":" << sample.compile.*field.member;
            }
            output << "},\"submission\":{\"accepted_packets\":" << sample.acceptedPackets << ",\"accepted_tasks\":" << sample.acceptedTasks << ",\"rejected_packets\":" << sample.rejectedPackets << ",\"rejected_tasks\":" << sample.rejectedTasks << '}';
        }
        else
            ++invalid;
        output << "}\n";
    }
    const u64 overflow = m_attempts - m_samples.size();
    const b8 complete = !m_samples.empty() && overflow == 0u;
    output << "{\"type\":\"compiler_statistics_complete\",\"attempts\":" << m_attempts << ",\"stored\":" << m_samples.size() << ",\"overflow\":" << overflow << ",\"invalid\":" << invalid << ",\"complete\":" << (complete ? "true" : "false") << "}\n";
    output.close();
    return output.good() && complete;
}

void RendererCompilerStatisticsProbe::render(Core::Framebuffer*){
    if(!m_renderer)
        return;
    ++m_attempts;
    if(m_samples.size() == s_Capacity)
        return;
    Sample sample;
    sample.sourceFrame = getGraphics().getFrameIndex();
    const auto statistics = m_renderer->deferredTaskGraphRuntimeStatistics();
    sample.valid = statistics.valid() && statistics.compile.deviceGeneration != 0u;
    if(sample.valid){
        sample.compile = statistics.compile;
        sample.recordingAttempt = statistics.recording.recordingAttemptGeneration;
        sample.acceptedPackets = statistics.submission.acceptedPacketCount;
        sample.acceptedTasks = statistics.submission.acceptedTaskCount;
        sample.rejectedPackets = statistics.submission.rejectedPacketCount;
        sample.rejectedTasks = statistics.submission.rejectedTaskCount;
    }
    m_samples.push_back(Move(sample));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererGatherBenchmarkProbe final : NoCopy{
public:
    static constexpr u32 s_WarmupFrames = s_GatherBenchmarkWarmupFrames;
    static constexpr u32 s_SampleFrames = s_GatherBenchmarkSampleFrames;
    static constexpr u32 s_DrainFrames = s_GatherBenchmarkDrainFrames;
    static constexpr u32 s_CpuScopeCount = s_GatherBenchmarkCpuScopeCount;
    static constexpr u32 s_GpuScopeCount = s_GatherBenchmarkGpuScopeCount;
    static constexpr u32 s_ArenaScopeCount = s_GatherBenchmarkArenaScopeCount;
    static constexpr Array<StringView, s_CpuScopeCount> s_CpuNames = {
        "graphics.frame", "graphics.frame_preamble", "graphics.prepare_resources", "graphics.render_passes",
        "graphics.render", "frame.project_update", "graphics.present", "graphics.begin_frame",
    };
    static constexpr Array<StringView, s_GpuScopeCount> s_GpuNames = {
        "render.frame", "render.opaque_regular", "render.shadow_visibility", "render.deferred_lighting",
        "render.deferred_composite", "render.deferred_present", "render.avboit_clear", "render.avboit_occupancy",
        "render.avboit_depth_warp", "render.avboit_extinction", "render.avboit_integration", "render.avboit_accumulate",
        "render.reflection_classify", "render.reflection_build_args", "render.reflection_hardware",
        "render.reflection_depth_pyramid", "render.reflection_temporal", "render.reflection_spatial",
    };
    static constexpr Array<StringView, s_ArenaScopeCount> s_ArenaNames = { "impl/ecs_render/prepare", "impl/ecs_render/render", "impl/ecs_render/task_graph", };


private:
    struct CpuSample{
        Array<Core::Perf::MemorySnapshot, s_ArenaScopeCount> memory = {};
        Array<f64, s_CpuScopeCount> milliseconds = {};
        u64 sourceFrame = 0u;
        u64 publishFrame = 0u;
    };
    struct GpuSample{
        Core::Perf::TimingStats timing;
        u32 scope = 0u;
    };


private:
    static void WriteMemory(Span<const Core::Perf::MemorySnapshot> snapshots, OutputFileStream& output);


public:
    explicit RendererGatherBenchmarkProbe(Core::Alloc::GlobalArena& arena);


public:
    [[nodiscard]] b8 poll(const Core::Perf::SessionReport& report, b8 memoryEnabled);

    [[nodiscard]] b8 finished()const noexcept{ return m_successfulFrames >= s_WarmupFrames + s_SampleFrames + s_DrainFrames; }

    [[nodiscard]] u32 successfulFrames()const noexcept{ return m_successfulFrames; }

    [[nodiscard]] b8 write(AStringView path, AStringView workload, b8 memoryEnabled, u32 renderers, u32 runtimeRenderers, u32 transparentRenderers, u32 runtimeOwners)const;


private:
    Array<Core::Perf::MemorySnapshot, s_ArenaScopeCount> m_memoryBaseline = {};
    Array<u64, s_GpuScopeCount> m_gpuPublish = {};
    Vector<CpuSample, Core::Alloc::GlobalArena> m_cpu;
    Vector<GpuSample, Core::Alloc::GlobalArena> m_gpu;
    Array<b8, s_GpuScopeCount> m_hasGpuPublication = {};
    u64 m_lastPublish = 0u;
    u32 m_successfulFrames = 0u;
    b8 m_hasPublication = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_renderer_gather_benchmark_probe{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


constexpr f64 s_MillisecondsPerSecond = s_PresentationPacingMsPerSecond;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void RendererGatherBenchmarkProbe::WriteMemory(const Span<const Core::Perf::MemorySnapshot> snapshots, OutputFileStream& output){
    output << '{';
    for(u32 scope = 0u; scope < s_ArenaScopeCount; ++scope){
        if(scope != 0u)
            output << ',';
        const auto& snapshot = snapshots[scope];
        output << '"' << s_ArenaNames[scope] << "\":{\"present\":" << (snapshot.valid() ? "true" : "false")
            << ",\"frame\":" << snapshot.frameIndex << ",\"reserved\":" << snapshot.reservedBytes
            << ",\"used\":" << snapshot.usedBytes << ",\"historical_arena_peak\":" << snapshot.peakUsedBytes
            << ",\"allocations\":" << snapshot.allocationCount << ",\"reallocations\":" << snapshot.reallocationCount
            << ",\"deallocations\":" << snapshot.deallocationCount << '}';
    }
    output << '}';
}

RendererGatherBenchmarkProbe::RendererGatherBenchmarkProbe(Core::Alloc::GlobalArena& arena)
    : m_cpu(arena)
    , m_gpu(arena)
{
    m_cpu.reserve(s_SampleFrames);
    m_gpu.reserve((s_WarmupFrames + s_SampleFrames + s_DrainFrames) * s_GpuScopeCount);
}

b8 RendererGatherBenchmarkProbe::poll(const Core::Perf::SessionReport& report, const b8 memoryEnabled){
    const auto& frame = report.cpuTiming.stats(Name(s_CpuNames[0u]));
    if(!frame.valid() || (m_hasPublication && frame.publishFrameIndex == m_lastPublish))
        return true;
    if((m_hasPublication && frame.publishFrameIndex < m_lastPublish) || frame.sampleCount != 1u || frame.firstSampleFrameIndex != frame.lastSampleFrameIndex)
        return false;
    const auto& failedPreparation = report.cpuTiming.stats(Name(s_PresentationTimingNamePrepareResourcesFailed));
    if(failedPreparation.valid() && failedPreparation.publishFrameIndex == frame.publishFrameIndex)
        return false;
    const auto& preamble = report.cpuTiming.stats(Name(s_PresentationTimingNameFramePreamble));
    if((!preamble.valid() || preamble.publishFrameIndex != frame.publishFrameIndex) && m_successfulFrames == 0u)
        return true;
    CpuSample sample;
    sample.sourceFrame = frame.firstSampleFrameIndex;
    sample.publishFrame = frame.publishFrameIndex;
    for(u32 scope = 0u; scope < s_CpuScopeCount; ++scope){
        const auto scopeName = Name::FromText(s_CpuNames[scope]);
        if(!scopeName)
            return false;
        const auto& timing = report.cpuTiming.stats(*scopeName);
        if(!timing.valid() || timing.sampleCount != 1u || timing.publishFrameIndex != frame.publishFrameIndex || timing.firstSampleFrameIndex != sample.sourceFrame || timing.lastSampleFrameIndex != sample.sourceFrame)
            return false;
        sample.milliseconds[scope] = timing.seconds;
    }
    u32 scope = 0u;
    for(; scope + 1u < s_CpuScopeCount; scope += 2u){
        const SIMDVectorDouble milliseconds = VectorDoubleScale(VectorDoubleSet(sample.milliseconds[scope], sample.milliseconds[scope + 1u], 0.0, 0.0), __hidden_renderer_gather_benchmark_probe::s_MillisecondsPerSecond);
        sample.milliseconds[scope] = VectorDoubleGetX(milliseconds);
        sample.milliseconds[scope + 1u] = VectorDoubleGetY(milliseconds);
    }
    if(scope < s_CpuScopeCount)
        sample.milliseconds[scope] = sample.milliseconds[scope] * (__hidden_renderer_gather_benchmark_probe::s_MillisecondsPerSecond);
    if(memoryEnabled){
        for(u32 scope = 0u; scope < s_ArenaScopeCount; ++scope){
            const auto arenaName = Name::FromText(s_ArenaNames[scope]);
            if(!arenaName)
                return false;
            const auto& snapshot = report.memory.snapshot(*arenaName, Core::Perf::MemorySource::Arena);
            if(snapshot.valid() && snapshot.frameIndex != sample.publishFrame)
                return false;
            sample.memory[scope] = snapshot;
        }
    }
    for(u32 scope = 0u; scope < s_GpuScopeCount; ++scope){
        const auto scopeName = Name::FromText(s_GpuNames[scope]);
        if(!scopeName)
            return false;
        const auto& timing = report.gpuTiming.stats(*scopeName);
        if(!timing.valid() || (m_hasGpuPublication[scope] && timing.publishFrameIndex == m_gpuPublish[scope]))
            continue;
        if(m_hasGpuPublication[scope] && timing.publishFrameIndex < m_gpuPublish[scope])
            return false;
        m_hasGpuPublication[scope] = true;
        m_gpuPublish[scope] = timing.publishFrameIndex;
        m_gpu.push_back(GpuSample{ timing, scope });
    }
    m_lastPublish = frame.publishFrameIndex;
    m_hasPublication = true;
    ++m_successfulFrames;
    if(m_successfulFrames == s_WarmupFrames)
        m_memoryBaseline = sample.memory;
    if(m_successfulFrames > s_WarmupFrames && m_cpu.size() < s_SampleFrames)
        m_cpu.push_back(Move(sample));
    return true;
}

b8 RendererGatherBenchmarkProbe::write(const AStringView path, const AStringView workload, const b8 memoryEnabled, const u32 renderers, const u32 runtimeRenderers, const u32 transparentRenderers, const u32 runtimeOwners)const{
    const b8 complete = finished() && m_cpu.size() == s_SampleFrames;
    const AString<Core::Alloc::GlobalArena> outputPath(path, m_cpu.get_allocator());
    OutputFileStream output(outputPath.c_str(), s_FileOpenTruncate);
    if(!output.is_open())
        return false;
    output.setf(s_FileFormatFixed, s_FileFormatFloatField);
    output.precision(9);
    output << "{\"type\":\"configuration\",\"schema\":2,\"workload\":\"" << workload
        << "\",\"mode\":\"" << (memoryEnabled ? "memory" : "timing")
        << "\",\"width\":960,\"height\":720,\"warmup\":" << s_WarmupFrames
        << ",\"samples\":" << s_SampleFrames << ",\"drain\":" << s_DrainFrames
        << ",\"successful_frames\":" << m_successfulFrames << ",\"renderers\":" << renderers
        << ",\"runtime_renderers\":" << runtimeRenderers << ",\"transparent_renderers\":" << transparentRenderers
        << ",\"runtime_owners\":" << runtimeOwners
        << ",\"reflection_mode\":\"hardware\",\"hardware_budget\":4096,\"optical_queries\":16"
        << ",\"temporal\":false,\"spatial\":false,\"feedback\":false,\"diagnostics\":false"
        << ",\"fixed_delta_seconds\":0.016666667,\"sampling_seed\":0,\"refraction\":true}\n";
    if(memoryEnabled){
        output << "{\"type\":\"memory_baseline\",\"arenas\":";
        WriteMemory(m_memoryBaseline, output);
        output << "}\n";
    }
    for(const CpuSample& sample : m_cpu){
        output << "{\"type\":\"cpu\",\"source_frame\":" << sample.sourceFrame << ",\"publish_frame\":" << sample.publishFrame << ",\"scopes_ms\":{";
        for(u32 scope = 0u; scope < s_CpuScopeCount; ++scope){
            if(scope != 0u)
                output << ',';
            output << '"' << s_CpuNames[scope] << "\":" << sample.milliseconds[scope];
        }
        output << '}';
        if(memoryEnabled){
            output << ",\"arenas\":";
            WriteMemory(sample.memory, output);
        }
        output << "}\n";
    }
    for(usize index = 0u; index < m_gpu.size(); index += 2u){
        const usize count = Min(usize{ 2u }, m_gpu.size() - index);
        const SIMDVectorDouble milliseconds = VectorDoubleScale(VectorDoubleSet(m_gpu[index].timing.seconds, count > 1u ? m_gpu[index + 1u].timing.seconds : 0.0, 0.0, 0.0), __hidden_renderer_gather_benchmark_probe::s_MillisecondsPerSecond);
        for(usize lane = 0u; lane < count; ++lane){
            const GpuSample& sample = m_gpu[index + lane];
            output << "{\"type\":\"gpu\",\"scope\":\"" << s_GpuNames[sample.scope]
                << "\",\"publish_frame\":" << sample.timing.publishFrameIndex
                << ",\"first_source_frame\":" << sample.timing.firstSampleFrameIndex
                << ",\"last_source_frame\":" << sample.timing.lastSampleFrameIndex
                << ",\"total_ms\":" << VectorDoubleGetByIndex(milliseconds, lane)
                << ",\"samples\":" << sample.timing.sampleCount << "}\n";
        }
    }
    if(complete)
        output << "{\"type\":\"complete\"}\n";
    output.close();
    return output.good() && complete;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


