    public void bodyShapes(in BodyId bodyId, mut Vector<ShapeId> outShapes)const{
        outShapes.clear();
        if(!this.isValidBody(bodyId))
            return;
        u32 shapeIdx = this.m_bodies[bodyId.index].headShapeId;
        while(shapeIdx != s_NullIndex){
            if(this.m_shapes[shapeIdx].alive())
                outShapes.push_back(this.makeShapeId(shapeIdx));
            shapeIdx = this.m_shapes[shapeIdx].nextShapeId;
        }
    }

    public void bodyJoints(in BodyId bodyId, mut Vector<JointId> outJoints)const{
        outJoints.clear();
        if(!this.isValidBody(bodyId))
            return;
        u32 key = this.m_bodies[bodyId.index].headJointKey;
        while(key != s_NullIndex){
            const u32 jId = DecodeJointKeyId(key);
            const u32 edgeIdx = DecodeJointKeyEdge(key);
            in Joint j = this.m_joints[jId];
            if(j.alive())
                outJoints.push_back(this.makeJointId(jId));
            key = j.edges[edgeIdx].nextKey;
        }
    }

    public void bodyContacts(in BodyId bodyId, mut Vector<ContactPairInfo> outContacts)const{
        outContacts.clear();
        if(!this.isValidBody(bodyId))
            return;
        u32 key = this.m_bodies[bodyId.index].headContactKey;
        while(key != s_NullIndex){
            const u32 cId = DecodeContactKeyId(key);
            const u32 edgeIdx = DecodeContactKeyEdge(key);
            in Contact c = this.m_contacts[cId];
            if((c.flags & cast<u32>(ContactFlags::Alive)) != 0u){
                ContactPairInfo pairInfo;
                pairInfo.shapeIdA = this.makeShapeId(c.shapeIdA);
                pairInfo.shapeIdB = this.makeShapeId(c.shapeIdB);
                pairInfo.normal = f32x4(c.manifold.normal(), 0.0f);
                pairInfo.pointCount = c.manifold.pointCount();
                pairInfo.touching = (c.flags & cast<u32>(ContactFlags::Touching)) != 0u;
                outContacts.push_back(pairInfo);
            }
            key = c.edges[edgeIdx].nextKey;
        }
    }

