using namespace NWB;
using namespace NWB::Impl::Ui;

[[nodiscard]] NWB_INLINE HitTarget Button(const u64 id, const Rect& rectangle, const u32 paintOrder = 0u)noexcept{
    HitTarget target;
    target.id = { id };
    target.rectangle = rectangle;
    target.clip = { 0.0f, 0.0f, 200.0f, 120.0f };
    target.paintOrder = paintOrder;
    target.focusable = true;
    target.activatable = true;
    return target;
}

[[nodiscard]] NWB_INLINE PopupScope Scope(const u64 widget = 100u, const u32 layer = 3u, const u64 openGeneration = 1u)noexcept{
    PopupScope scope;
    scope.token = { { widget }, 10u, 20u, openGeneration };
    scope.bounds = { 40.0f, 40.0f, 100.0f, 70.0f };
    scope.viewport = { 0.0f, 0.0f, 200.0f, 120.0f };
    scope.layer = layer;
    return scope;
}

[[nodiscard]] NWB_INLINE Array<HitTarget, 2u> BaseTargets()noexcept{
    return { Button(1u, { 10.0f, 10.0f, 30.0f, 20.0f }), Button(2u, { 60.0f, 10.0f, 30.0f, 20.0f }) };
}

[[nodiscard]] NWB_INLINE HitTarget Barrier(const PopupScope& scope)noexcept{
    HitTarget target;
    target.id = scope.token.widget;
    target.declarationGeneration = scope.token.declarationGeneration;
    target.rectangle = scope.bounds;
    target.clip = scope.viewport;
    target.paintOrder = 10u;
    target.popup = scope.token;
    target.layer = scope.layer;
    return target;
}

[[nodiscard]] NWB_INLINE HitTarget Child(const PopupScope& scope, const u64 id, const Rect& rectangle, const u32 paintOrder)noexcept{
    HitTarget target = Button(id, rectangle, paintOrder);
    target.clip = scope.bounds;
    target.popup = scope.token;
    target.layer = scope.layer;
    return target;
}

[[nodiscard]] NWB_INLINE Array<HitTarget, 5u> Targets(const PopupScope& scope)noexcept{
    const auto base = BaseTargets();
    return { base[0u], base[1u], Barrier(scope), Child(scope, scope.token.widget.value + 1u, { 50.0f, 50.0f, 30.0f, 20.0f }, 11u), Child(scope, scope.token.widget.value + 2u, { 90.0f, 50.0f, 30.0f, 20.0f }, 12u) };
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiPopupRouterTests : public UiTestSupport::RouterTestFixture{
public:
    UiPopupRouterTests()
        : RouterTestFixture(Name(NWB::Tests::UiCases::s_UiCaseTestsUiPopupRouter))
    {}


public:
    [[nodiscard]] b8 install(const PopupScope& scope, const u64 generation){
        const auto targets = Targets(scope);
        return m_router.commitTargets(targets, generation, Span(&scope, 1u));
    }

    [[nodiscard]] b8 commitWithScope(const Span<const HitTarget> targets, const u64 generation, const PopupScope& scope){
        return m_router.commitTargets(targets, generation, Span(&scope, 1u));
    }

    [[nodiscard]] b8 commitCountWithScope(const Span<const HitTarget> targets, const usize count, const u64 generation, const PopupScope& scope){
        return m_router.commitTargets(targets.subspan(0u, count), generation, Span(&scope, 1u));
    }

    [[nodiscard]] b8 commitSingle(const HitTarget& target, const u64 generation){
        return m_router.commitTargets(Span(&target, 1u), generation);
    }

    void focusBase(){
        const auto targets = BaseTargets();
        ASSERT_TRUE(m_router.commitTargets(targets, 1u));
        key(Core::Key::Tab);
        ASSERT_EQ(m_router.focus().value, 1u);
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


