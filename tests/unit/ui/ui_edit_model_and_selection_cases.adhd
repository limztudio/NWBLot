void VerifyUiEditCompositionTests_PreeditOwnsTransientTextWithoutPublishingCommittedRevisionOrHistory(mut UiEditCompositionTests self){
    ASSERT_TRUE(self.m_model.setText("abcd"));
    ASSERT_TRUE(self.m_model.setSelection(3u, 1u));
    const u64 revision = self.m_model.revision();
    ASSERT_TRUE(self.m_model.beginComposition());
    String value = "xy";
    ASSERT_TRUE(self.m_model.updateComposition(value, 0u, 2u));
    value.assign("zz");
    const EditCompositionView composition = self.m_model.composition();
    EXPECT_TRUE(composition.active);
    EXPECT_EQ(composition.text, "xy");
    EXPECT_EQ(composition.anchor, 0u);
    EXPECT_EQ(composition.caret, 2u);
    EXPECT_EQ(composition.replacementStart, 1u);
    EXPECT_EQ(composition.replacementEnd, 3u);
    EXPECT_EQ(self.m_model.text(), "abcd");
    EXPECT_EQ(self.m_model.revision(), revision);
    EXPECT_EQ(self.m_model.anchor(), 3u);
    EXPECT_EQ(self.m_model.caret(), 1u);
    EXPECT_FALSE(self.m_model.canUndo());
}

void VerifyUiEditCompositionTests_NativePreeditClearBeforeCommitRetainsOriginalReplacementBaseline(mut UiEditCompositionTests self){
    ASSERT_TRUE(self.m_model.setText("abcd"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 3u));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("transient", 4u, 4u));
    ASSERT_TRUE(self.m_model.updateComposition("", 0u, 0u));
    EXPECT_TRUE(self.m_model.composition().active);
    EXPECT_EQ(self.m_model.composition().replacementStart, 1u);
    EXPECT_EQ(self.m_model.composition().replacementEnd, 3u);
    ASSERT_TRUE(self.m_model.commitComposition("X"));
    EXPECT_EQ(self.m_model.text(), "aXd");
}

void VerifyUiEditCompositionTests_CancellationPreservesCommittedTextSelectionRevisionAndHistory(mut UiEditCompositionTests self){
    ASSERT_TRUE(self.m_model.setText("abc"));
