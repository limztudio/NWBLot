#include <impl/ecs_ui/toolkit/input/bindings.adhd>
#include <impl/ecs_ui/toolkit/input/input.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class InputAdmission : NoCopy{
    public InputAdmission(){
        this.m_boundSources.reserve(s_InputSourceReserve);
        this.m_pointerBindings.reserve(s_InputSourceReserve);
        this.m_events.reserve(s_InputMaxEvents);
    }

    public Expected<InputEvent> queue(in InputEvent event){
        return TryQueueRouterInputEvent(this.m_bindings.bindings(), event, this.m_pointerBindings, this.m_boundSources, this.m_events);
    }

    public Expected<InputEvent> queuePointer(in PointerInput input){
        return TryQueueRouterPointerInput(this.m_bindings.bindings(), input, this.m_pointerBindings, this.m_boundSources, this.m_events);
    }

    public b8 setBindings(in Span<InputKeyBinding> bindings){
        return this.m_bindings.set(bindings);
    }

    public void restoreDefaultBindings(){
        this.m_bindings.restoreDefaults();
    }

    public in InputBindings bindings()const{
        return this.m_bindings;
    }

    public Span<InputEvent> events()const{
        return this.m_events;
    }

    public void clear(){
        this.m_events.clear();
    }

    public void cancelDevice(in u64 device, mut PointerSourceTable pointerSources, mut Vector<CommandSource> commandSources){
        EraseRouterDeviceInputs(device, pointerSources, this.m_pointerBindings, commandSources, this.m_boundSources, this.m_events);
    }

    private InputBindings m_bindings;
    private Vector<BoundSource> m_boundSources;
    private PointerBindingTable m_pointerBindings;
    private Vector<InputEvent> m_events;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

