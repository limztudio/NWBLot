void VerifyHorizontalNavigationFixture_CapabilityRemovalRetiresHorizontalIntentionsWhileVerticalHoldSurvives(mut HorizontalNavigationFixture self){
    ASSERT_TRUE(self.publish());
    self.focusTarget();
    EXPECT_TRUE(self.keyDown(CoreKey::Left).commandConsumed);
    EXPECT_TRUE(self.keyDown(CoreKey::Up).commandConsumed);
    self.press(CoreKey::Right);
    ASSERT_EQ(self.m_router.controlActions().size(), 3u);
    self.m_targets[0u].horizontalNavigation = false;
    ASSERT_TRUE(self.publish());
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    ASSERT_EQ(self.m_router.controlActions().size(), 1u);
    EXPECT_EQ(self.m_router.controlActions()[0u].kind, ControlActionKind::Up);
    EXPECT_TRUE(self.keyDown(CoreKey::Left, true).commandConsumed);
    EXPECT_TRUE(self.keyDown(CoreKey::Up, true).commandConsumed);
    ASSERT_EQ(self.m_router.controlActions().size(), 2u);
    const Expected<ControlAction> actionResult1 = self.take();
    ASSERT_TRUE(actionResult1.has_value());
    EXPECT_EQ(actionResult1.value().kind, ControlActionKind::Up);
    const Expected<ControlAction> actionResult2 = self.take();
    ASSERT_TRUE(actionResult2.has_value());
    EXPECT_EQ(actionResult2.value().kind, ControlActionKind::Up);
    self.m_targets[0u].horizontalNavigation = true;
    ASSERT_TRUE(self.publish());
    EXPECT_TRUE(self.keyDown(CoreKey::Left, true).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.keyDown(CoreKey::Up, true).commandConsumed);
    const Expected<ControlAction> actionResult3 = self.take();
    ASSERT_TRUE(actionResult3.has_value());
    EXPECT_EQ(actionResult3.value().kind, ControlActionKind::Up);
    EXPECT_TRUE(self.keyUp(CoreKey::Left).commandConsumed);
    EXPECT_TRUE(self.keyUp(CoreKey::Up).commandConsumed);
    self.press(CoreKey::Left);
    const Expected<ControlAction> actionResult4 = self.take();
    ASSERT_TRUE(actionResult4.has_value());
    EXPECT_EQ(actionResult4.value().kind, ControlActionKind::Left);
}

void VerifyHorizontalNavigationFixture_EnablingCapabilityCannotAdoptAnAlreadyHeldLocalKey(mut HorizontalNavigationFixture self){
    self.m_targets[0u].horizontalNavigation = false;
    ASSERT_TRUE(self.publish());
    self.focusTarget();
    EXPECT_TRUE(self.keyDown(CoreKey::Right).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    self.m_targets[0u].horizontalNavigation = true;
    ASSERT_TRUE(self.publish());
    EXPECT_TRUE(self.keyDown(CoreKey::Right, true).commandConsumed);
    EXPECT_TRUE(self.keyDown(CoreKey::Right).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.keyUp(CoreKey::Right).commandConsumed);
    self.press(CoreKey::Right);
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_EQ(actionResult.value().kind, ControlActionKind::Right);
}

void VerifyHorizontalNavigationFixture_FocusTransferCannotRedirectHeldHorizontalKeyToAnotherHost(mut HorizontalNavigationFixture self){
    ASSERT_TRUE(self.publish());
    self.focusTarget();
    EXPECT_TRUE(self.keyDown(CoreKey::Right).commandConsumed);
    const Expected<ControlAction> actionResult1 = self.take();
    ASSERT_TRUE(actionResult1.has_value());
    EXPECT_EQ(actionResult1.value().id.target, self.m_targets[0u].id);
    self.focusTarget(1u);
    EXPECT_TRUE(self.keyDown(CoreKey::Right, true).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.keyUp(CoreKey::Right).commandConsumed);
    self.press(CoreKey::Right);
    const Expected<ControlAction> actionResult2 = self.take(1u);
    ASSERT_TRUE(actionResult2.has_value());
    EXPECT_EQ(actionResult2.value().kind, ControlActionKind::Right);
    EXPECT_EQ(actionResult2.value().id.target, self.m_targets[1u].id);
    EXPECT_EQ(actionResult2.value().source, self.m_targets[1u].id);
}

void VerifyHorizontalNavigationFixture_RestoringOriginalControlTokenCannotReviveRetiredHorizontalHold(mut HorizontalNavigationFixture self){
    ASSERT_TRUE(self.publish());
    self.focusTarget();
    EXPECT_TRUE(self.keyDown(CoreKey::Left).commandConsumed);
    const ControlToken original = self.m_targets[0u].control;
    ++self.m_targets[0u].control.contentRevision;
    ASSERT_TRUE(self.publish());
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_TRUE(self.m_router.controlActions().empty());
    self.focusTarget();
    EXPECT_TRUE(self.keyDown(CoreKey::Left, true).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    self.m_targets[0u].control = original;
    ASSERT_TRUE(self.publish());
    self.focusTarget();
    EXPECT_TRUE(self.keyDown(CoreKey::Left, true).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.keyUp(CoreKey::Left).commandConsumed);
    self.press(CoreKey::Left);
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_EQ(actionResult.value().kind, ControlActionKind::Left);
    EXPECT_EQ(actionResult.value().control, original);
}

