    EXPECT_FALSE(self.m_state.focused());
    model.expect(self.m_model);
}

void VerifyUiTextAreaInputScrollTests_WheelViewportPersistsUntilAnAcceptedIdenticalCaretIntentResumesReveal(mut UiTextAreaInputScrollTests self){
    ASSERT_TRUE(self.prepareScroll());
    const u64 revision = self.m_model.revision();
    const u64 selection = self.m_model.selectionGeneration();
    ASSERT_TRUE(self.wheel(1.0, -1.0));
    ASSERT_TRUE(self.frameArea(2u, UiTextAreaScrollOptions()));
    const Point scroll = self.m_state.scroll();
    ASSERT_GT(scroll.x, 0.0f);
    ASSERT_GT(scroll.y, 0.0f);
    ASSERT_TRUE(self.frameArea(3u, UiTextAreaScrollOptions()));
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, scroll.x);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, scroll.y);
