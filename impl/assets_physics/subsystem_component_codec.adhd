////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SubsystemPhysicsComponentBinaryCodec{
    private void appendNameHashList(in Vector<Name> names, mut Vector<u8> outBinary)const{
        for(usize ni = 0u; ni < names.size(); ++ni)
            AppendPOD(outBinary, names[ni].hash());
    }

    private b8 readNameHashList(in Span<u8> payload, in u32 count, mut usize cursor, mut Vector<Name> outNames)const{
        if(cast<u64>(count) * cast<u64>(size_of<NameHash>()) > cast<u64>(payload.size() - cursor))
            return false;
        outNames.resize(count);
        for(u32 ni = 0u; ni < count; ++ni){
            const Expected<NameHash> hRes = ReadPOD<NameHash>(payload, cursor);
            if(!hRes.has_value())
                return false;
            outNames[ni] = DecodeOptionalPhysicsName(hRes.value());
        }
        return true;
    }

    public b8 validCharacterControllerData(in CharacterControllerComponent c)const{
        in CharacterControllerDef d = c.def;
        if(cast<u8>(d.shapeType) >= cast<u8>(CharacterShapeType::kCount))
            return false;
        if(!PhysicsRigBinaryCodec().validFilter(d.filter))
            return false;
        if(!IsFinite(VectorSingle(d.radius, d.halfHeight, d.skinWidth, d.maxSlopeAngleRad)))
            return false;
        if(!IsFinite(VectorSingle(d.stepUpHeight, d.stepDownHeight, d.maxStrength, d.mass))
            || !IsFinite(VectorSingle(d.predictiveContactDistance, d.characterFriction, d.characterRestitution, d.gravityScale))
            || !IsFinite(VectorSingle(d.slopeSlideAcceleration)))
            return false;
        if(!IsFinite(VectorSingle(d.up)) || Vector3LengthSq(VectorSingle(d.up)).x <= s_NormalizeEpsilonSq)
            return false;
        if(!IsFinite(VectorSingle(d.boxHalfExtents)) || d.boxHalfExtents.x < 0.0f || d.boxHalfExtents.y < 0.0f || d.boxHalfExtents.z < 0.0f)
            return false;
        if(!IsFinite(VectorSingle(d.customShapeScale)) || d.customShapeScale.x <= 0.0f || d.customShapeScale.y <= 0.0f || d.customShapeScale.z <= 0.0f)
            return false;
        if(d.shapeType == CharacterShapeType::Box && (d.boxHalfExtents.x <= 0.0f || d.boxHalfExtents.y <= 0.0f || d.boxHalfExtents.z <= 0.0f))
            return false;
        return d.radius > 0.0f
            && d.halfHeight >= 0.0f
            && d.skinWidth >= 0.0f
            && d.maxSlopeAngleRad >= 0.0f
            && d.maxSlopeAngleRad <= s_Pi * 0.5f + 1.0e-4f
            && d.stepUpHeight >= 0.0f
            && d.stepDownHeight >= 0.0f
            && d.maxStrength >= 0.0f
            && d.mass > 0.0f
            && d.predictiveContactDistance >= 0.0f
            && d.characterFriction >= 0.0f
            && d.characterRestitution >= 0.0f
            && d.slopeSlideAcceleration >= 0.0f
            && d.maxCollisionIterations >= 1u
            && d.maxConstraintIterations >= 1u;
    }

    public b8 validateCharacterController(in CharacterControllerComponent c, in Name virtualPath)const{
        if(this.validCharacterControllerData(c))
            return true;
        error("CharacterControllerComponentAsset::validatePayload failed: invalid config for '{}'", virtualPath.resolvedText());
        return false;
    }

    public b8 appendCharacterControllerValidated(in CharacterControllerComponent c, mut Vector<u8> outBinary)const{
        static_assert(size_of<CharacterControllerComponentBinary>() == 208u && offset_of<CharacterControllerComponentBinary>(reserved1) == 200u);
        if(!CanAppendBytes(outBinary, size_of<CharacterControllerComponentBinary>()))
            return false;
        in CharacterControllerDef d = c.def;
        const PhysicsRigBinaryCodec rigCodec = PhysicsRigBinaryCodec();
        CharacterControllerComponentBinary bin;
        bin.up = d.up;
        bin.boxHalfExtents = d.boxHalfExtents;
        bin.customShapeScale = d.customShapeScale;
        bin.collisionLayerHash = c.collisionLayer.hash();
        bin.filter = rigCodec.packFilter(d.filter);
        bin.radius = d.radius;
        bin.halfHeight = d.halfHeight;
        bin.skinWidth = d.skinWidth;
        bin.maxSlopeAngleRad = d.maxSlopeAngleRad;
        bin.stepUpHeight = d.stepUpHeight;
        bin.stepDownHeight = d.stepDownHeight;
        bin.maxStrength = d.maxStrength;
        bin.mass = d.mass;
        bin.predictiveContactDistance = d.predictiveContactDistance;
        bin.characterFriction = d.characterFriction;
        bin.characterRestitution = d.characterRestitution;
        bin.gravityScale = d.gravityScale;
        bin.slopeSlideAcceleration = d.slopeSlideAcceleration;
        bin.maxCollisionIterations = d.maxCollisionIterations;
        bin.maxConstraintIterations = d.maxConstraintIterations;
        u16 flags = 0u;
        if(d.hitSensors) flags |= s_CharCtrlFlagHitSensors;
        if(d.stickToFloor) flags |= s_CharCtrlFlagStickToFloor;
        if(d.pushDynamicBodies) flags |= s_CharCtrlFlagPushDynamicBodies;
        if(c.enabled) flags |= s_CharCtrlFlagEnabled;
        if(c.syncFromTransform) flags |= s_CharCtrlFlagSyncFromTransform;
        if(d.applyStandingWeight) flags |= s_CharCtrlFlagApplyStandingWeight;
        if(d.followPlatformPitchRoll) flags |= s_CharCtrlFlagFollowPlatformPitchRoll;
        if(d.enableGroundFriction) flags |= s_CharCtrlFlagEnableGroundFriction;
        if(d.enableRotationalSweep) flags |= s_CharCtrlFlagEnableRotationalSweep;
        if(d.enableGravityAndSlopeSlide) flags |= s_CharCtrlFlagEnableGravityAndSlopeSlide;
        if(d.inheritPlatformVelocity) flags |= s_CharCtrlFlagInheritPlatformVelocity;
        bin.flags = flags;
        bin.shapeType = cast<u8>(d.shapeType);
        outBinary.reserve(outBinary.size() + size_of<CharacterControllerComponentBinary>());
        AppendPOD(outBinary, bin);
        return true;
    }

    public b8 serializeCharacterController(in CharacterControllerComponent c, mut Vector<u8> outPayload)const{
        if(!this.validCharacterControllerData(c))
            return false;
        outPayload.clear();
        return this.appendCharacterControllerValidated(c, outPayload);
    }

    public Expected<CharacterControllerComponent> deserializeCharacterController(in Span<u8> payload)const{
        usize cursor = 0u;
        const Expected<CharacterControllerComponentBinary> res = ReadPOD<CharacterControllerComponentBinary>(payload, cursor);
        if(!res.has_value() || cursor != payload.size()){
            error("CharacterControllerComponentAsset::loadComponentPayload failed: invalid payload size");
            return MakeUnexpected(Failure());
        }
        in CharacterControllerComponentBinary bin = res.value();
        if(bin.reserved0 != 0u || bin.reserved1 != 0u || (bin.flags & ~s_CharCtrlAllFlagsMask) != 0u){
            error("CharacterControllerComponentAsset::loadComponentPayload failed: unsupported flags");
            return MakeUnexpected(Failure());
        }
        const Expected<Filter> fltRes = PhysicsRigBinaryCodec().unpackFilter(bin.filter);
        if(!fltRes.has_value()){
            error("CharacterControllerComponentAsset::loadComponentPayload failed: invalid filter");
            return MakeUnexpected(Failure());
        }
        CharacterControllerComponent c;
        c.collisionLayer = DecodeOptionalPhysicsName(bin.collisionLayerHash);
        c.def.up = bin.up;
        c.def.boxHalfExtents = bin.boxHalfExtents;
        c.def.customShapeScale = bin.customShapeScale;
        c.def.shapeType = cast<CharacterShapeType>(bin.shapeType);
        c.def.radius = bin.radius;
        c.def.halfHeight = bin.halfHeight;
        c.def.skinWidth = bin.skinWidth;
        c.def.maxSlopeAngleRad = bin.maxSlopeAngleRad;
        c.def.stepUpHeight = bin.stepUpHeight;
        c.def.stepDownHeight = bin.stepDownHeight;
        c.def.maxStrength = bin.maxStrength;
        c.def.mass = bin.mass;
        c.def.predictiveContactDistance = bin.predictiveContactDistance;
        c.def.characterFriction = bin.characterFriction;
        c.def.characterRestitution = bin.characterRestitution;
        c.def.gravityScale = bin.gravityScale;
        c.def.slopeSlideAcceleration = bin.slopeSlideAcceleration;
        c.def.maxCollisionIterations = bin.maxCollisionIterations;
        c.def.maxConstraintIterations = bin.maxConstraintIterations;
        c.def.filter = fltRes.value();
        c.def.hitSensors = (bin.flags & s_CharCtrlFlagHitSensors) != 0u;
        c.def.stickToFloor = (bin.flags & s_CharCtrlFlagStickToFloor) != 0u;
        c.def.pushDynamicBodies = (bin.flags & s_CharCtrlFlagPushDynamicBodies) != 0u;
        c.enabled = (bin.flags & s_CharCtrlFlagEnabled) != 0u;
        c.syncFromTransform = (bin.flags & s_CharCtrlFlagSyncFromTransform) != 0u;
        c.def.applyStandingWeight = (bin.flags & s_CharCtrlFlagApplyStandingWeight) != 0u;
        c.def.followPlatformPitchRoll = (bin.flags & s_CharCtrlFlagFollowPlatformPitchRoll) != 0u;
        c.def.enableGroundFriction = (bin.flags & s_CharCtrlFlagEnableGroundFriction) != 0u;
        c.def.enableRotationalSweep = (bin.flags & s_CharCtrlFlagEnableRotationalSweep) != 0u;
        c.def.enableGravityAndSlopeSlide = (bin.flags & s_CharCtrlFlagEnableGravityAndSlopeSlide) != 0u;
        c.def.inheritPlatformVelocity = (bin.flags & s_CharCtrlFlagInheritPlatformVelocity) != 0u;
        c.dirty = true;
        c.initialized = false;
        if(!this.validCharacterControllerData(c)){
            error("CharacterControllerComponentAsset::loadComponentPayload failed: invalid fields");
            return MakeUnexpected(Failure());
        }
        return c;
    }

    private b8 validVehicleComponentExtras(in VehicleComponent v)const{
        in VehicleEngineDef eng = v.engine;
        if(
            eng.idleRpm >= eng.maxRpm
            || eng.shiftDownRpm < 0.0f
            || eng.shiftDownRpm > eng.shiftUpRpm
            || eng.shiftUpRpm > eng.maxRpm
            || eng.finalDriveRatio == 0.0f
            || eng.reverseRatio >= 0.0f
            || eng.differentialBias < 0.0f
            || eng.differentialBias > 1.0f
            || eng.centerDiffFrontSplit < 0.0f
            || eng.centerDiffFrontSplit > 1.0f
            || eng.differentialLockTorque < 0.0f
            || eng.clutchStrength < 0.0f
            || eng.torqueConverterStallRpm < 0.0f
            || eng.torqueConverterMaxTorqueRatio < 1.0f
            || eng.dragCoeff < 0.0f
            || eng.downforceCoeff < 0.0f
            || eng.espStrength < 0.0f
            || eng.espMaxBrakeTorque < 0.0f
        )
            return false;
        for(u32 gi = 0u; gi < eng.gearCount; ++gi){
            if(eng.forwardGearRatios[gi] <= 0.0f)
                return false;
        }
        for(usize ti = 1u; ti < eng.torqueCurvePoints.size(); ++ti){
            if(eng.torqueCurvePoints[ti].x <= eng.torqueCurvePoints[ti - 1u].x)
                return false;
        }
        if(
            !IsFinite(VectorSingle(v.input.throttle, v.input.brake, v.input.steer, v.input.handbrake))
            || !IsFinite(VectorSingle(v.input.clutch))
            || v.input.throttle < 0.0f || v.input.throttle > 1.0f
            || v.input.brake < 0.0f || v.input.brake > 1.0f
            || v.input.handbrake < 0.0f || v.input.handbrake > 1.0f
            || v.input.clutch < 0.0f || v.input.clutch > 1.0f
            || v.input.steer < -1.0f || v.input.steer > 1.0f
            || v.input.requestedGear < -1 || v.input.requestedGear > cast<i32>(eng.gearCount)
            || v.wheelEntityNames.size() > cast<usize>(u32.max)
            || v.wheelJointIndices.size() > cast<usize>(u32.max)
        )
            return false;
        const i32 wheelCountI = cast<i32>(v.wheels.size());
        for(usize wi = 0u; wi < v.wheels.size(); ++wi){
            in VehicleWheelDef w = v.wheels[wi];
            if(
                (w.suspensionReboundDamping != -1.0f && w.suspensionReboundDamping < 0.0f)
                || w.bumpStopStiffness < 0.0f
                || w.bumpStopRestitution < 0.0f
                || w.bumpStopRestitution > 1.0f
                || w.wheelWidth <= 0.0f
                || w.maxSteerAngleRad < 0.0f
                || w.maxSteerAngleRad >= s_Pi * 0.5f
                || w.driveFraction < 0.0f
                || w.loadSensitivity < 0.0f
                || w.nominalWheelLoad <= 0.0f
                || w.rollingResistanceCoeff < 0.0f
                || w.longitudinalStiffness < 0.0f
                || w.lateralStiffness < 0.0f
                || w.antiRollStiffness < 0.0f
                || w.pacejkaShapeC <= 0.0f
                || w.antiRollPairIndex < -1
                || w.antiRollPairIndex >= wheelCountI
                || w.antiRollPairIndex == cast<i32>(wi)
                || w.axleIndex < -1
            )
                return false;
        }
        return true;
    }

    public b8 validVehicleData(in VehicleComponent v)const{
        if(!PhysicsRigBinaryCodec().validVehicleFields(v.engine, v.wheels, v.queryFilter, v.wheelSlipEventThreshold, VectorSingle(v.trailerLocalHitchChassis), VectorSingle(v.trailerLocalHitchTrailer), v.trailerSwingLimitRad, true))
            return false;
        return this.validVehicleComponentExtras(v);
    }

    public b8 validateVehicle(in VehicleComponent v, in Name virtualPath)const{
        if(this.validVehicleData(v))
            return true;
        error("VehicleComponentAsset::validatePayload failed: invalid vehicle config for '{}'", virtualPath.resolvedText());
        return false;
    }

    public b8 appendVehicleValidated(in VehicleComponent v, mut Vector<u8> outBinary)const{
        static_assert(size_of<VehicleComponentBinary>() == 296u && offset_of<VehicleComponentBinary>(reserved2) == 292u);
        if(v.wheelEntityNames.size() > cast<usize>(u32.max) || v.wheelJointIndices.size() > cast<usize>(u32.max))
            return false;
        const PhysicsRigBinaryCodec rigCodec = PhysicsRigBinaryCodec();
        usize reqBytes = size_of<VehicleComponentBinary>();
        usize rigBytes = 0u;
        if(!rigCodec.vehicleFieldsPayloadBytes(v.engine, v.wheels, rigBytes))
            return false;
        if(
            rigBytes > cast<usize>(usize.max) - reqBytes
            || v.wheelEntityNames.size() > cast<usize>(usize.max) / size_of<NameHash>()
            || v.wheelJointIndices.size() > cast<usize>(usize.max) / size_of<u32>()
        )
            return false;
        reqBytes += rigBytes;
        const usize nameBytes = v.wheelEntityNames.size() * size_of<NameHash>();
        const usize idxBytes = v.wheelJointIndices.size() * size_of<u32>();
        if(nameBytes > cast<usize>(usize.max) - reqBytes)
            return false;
        reqBytes += nameBytes;
        if(idxBytes > cast<usize>(usize.max) - reqBytes)
            return false;
        reqBytes += idxBytes;
        if(!CanAppendBytes(outBinary, reqBytes))
            return false;
        outBinary.reserve(outBinary.size() + reqBytes);

        VehicleComponentBinary bin;
        bin.collisionLayerHash = v.collisionLayer.hash();
        bin.vehicleAssetHash = v.vehicleAsset.name().hash();
        bin.skeletonEntityNameHash = v.skeletonEntityName.hash();
        bin.trailerEntityNameHash = v.trailerEntityName.hash();
        bin.inputThrottle = v.input.throttle;
        bin.inputBrake = v.input.brake;
        bin.inputSteer = v.input.steer;
        bin.inputHandbrake = v.input.handbrake;
        bin.inputClutch = v.input.clutch;
        bin.inputRequestedGear = v.input.requestedGear;
        bin.wheelEntityNameCount = cast<u32>(v.wheelEntityNames.size());
        bin.wheelJointIndexCount = cast<u32>(v.wheelJointIndices.size());
        if(v.enabled) bin.flags |= s_VehicleCompFlagEnabled;
        if(v.writeBackToSkeleton) bin.flags |= s_VehicleCompFlagWriteBackToSkeleton;
        AppendPOD(outBinary, bin);

        if(!rigCodec.appendVehicleFields(v.engine, v.wheels, v.queryFilter, v.wheelSlipEventThreshold, VectorSingle(v.trailerLocalHitchChassis), VectorSingle(v.trailerLocalHitchTrailer), v.trailerSwingLimitRad, outBinary))
            return false;
        this.appendNameHashList(v.wheelEntityNames, outBinary);
        return AppendBinaryVectorPayload(outBinary, v.wheelJointIndices).has_value();
    }

    public b8 serializeVehicle(in VehicleComponent v, mut Vector<u8> outPayload)const{
        if(!this.validVehicleData(v))
            return false;
        outPayload.clear();
        return this.appendVehicleValidated(v, outPayload);
    }

    public Expected<VehicleComponent> deserializeVehicle(in Span<u8> payload)const{
        usize cursor = 0u;
        const Expected<VehicleComponentBinary> binRes = ReadPOD<VehicleComponentBinary>(payload, cursor);
        if(!binRes.has_value()){
            error("VehicleComponentAsset::loadComponentPayload failed: truncated header");
            return MakeUnexpected(Failure());
        }
        in VehicleComponentBinary bin = binRes.value();
        if(bin.reserved0 != 0u || bin.reserved1 != 0u || bin.reserved2 != 0u || (bin.flags & ~s_VehicleCompAllFlagsMask) != 0u){
            error("VehicleComponentAsset::loadComponentPayload failed: unsupported flags or non-zero reserved bits");
            return MakeUnexpected(Failure());
        }
        const Expected<VehicleAssetData> rigRes = PhysicsRigBinaryCodec().readVehiclePayload(payload, cursor, true);
        if(!rigRes.has_value()){
            error("VehicleComponentAsset::loadComponentPayload failed: invalid vehicle rig payload");
            return MakeUnexpected(Failure());
        }
        VehicleComponent v;
        in VehicleAssetData rig = rigRes.value();
        v.engine = rig.engine;
        v.wheels = rig.wheels;
        v.queryFilter = rig.queryFilter;
        v.wheelSlipEventThreshold = rig.wheelSlipEventThreshold;
        v.trailerLocalHitchChassis = rig.trailerLocalHitchChassis;
        v.trailerLocalHitchTrailer = rig.trailerLocalHitchTrailer;
        v.trailerSwingLimitRad = rig.trailerSwingLimitRad;
        v.collisionLayer = DecodeOptionalPhysicsName(bin.collisionLayerHash);
        v.vehicleAsset.virtualPath = DecodeOptionalPhysicsName(bin.vehicleAssetHash);
        v.skeletonEntityName = DecodeOptionalPhysicsName(bin.skeletonEntityNameHash);
        v.trailerEntityName = DecodeOptionalPhysicsName(bin.trailerEntityNameHash);
        v.input.throttle = bin.inputThrottle;
        v.input.brake = bin.inputBrake;
        v.input.steer = bin.inputSteer;
        v.input.handbrake = bin.inputHandbrake;
        v.input.clutch = bin.inputClutch;
        v.input.requestedGear = bin.inputRequestedGear;
        v.enabled = (bin.flags & s_VehicleCompFlagEnabled) != 0u;
        v.writeBackToSkeleton = (bin.flags & s_VehicleCompFlagWriteBackToSkeleton) != 0u;
        v.skeletonEntity = s_InvalidEntityId;
        v.trailerEntity = s_InvalidEntityId;
        v.dirty = true;
        v.initialized = false;
        if(!this.readNameHashList(payload, bin.wheelEntityNameCount, cursor, v.wheelEntityNames)
            || !ReadBinaryVectorPayload(payload, bin.wheelJointIndexCount, cursor, v.wheelJointIndices).has_value()
            || cursor != payload.size()
            || !this.validVehicleComponentExtras(v)){
            error("VehicleComponentAsset::loadComponentPayload failed: invalid trailing vehicle component data");
            return MakeUnexpected(Failure());
        }
        return v;
    }

    private b8 validRagdollComponentExtras(in RagdollComponent r)const{
        if(r.targetPose.size() > cast<usize>(u32.max)
            || r.boneEntityNames.size() > cast<usize>(u32.max)
            || r.boneMaterialAssets.size() > cast<usize>(u32.max))
            return false;
        for(usize pi = 0u; pi < r.targetPose.size(); ++pi){
            in Transform3D xf = r.targetPose[pi];
            if(!IsValidPositionVec3(VectorSingle(xf.position)) || !ValidPhysicsQuaternion(VectorSingle(xf.rotation)))
                return false;
        }
        return true;
    }

    public b8 validRagdollData(in RagdollComponent r)const{
        if(!PhysicsRigBinaryCodec().validRagdollFields(r.bones, r.mode, r.disabledSelfCollisionPairs, r.autoGenParams, r.driveStrengthMultiplier, r.boneKinematicMask, r.boneJointIndices, true))
            return false;
        return this.validRagdollComponentExtras(r);
    }

    public b8 validateRagdoll(in RagdollComponent r, in Name virtualPath)const{
        if(this.validRagdollData(r))
            return true;
        error("RagdollComponentAsset::validatePayload failed: invalid ragdoll config for '{}'", virtualPath.resolvedText());
        return false;
    }

    public b8 appendRagdollValidated(in RagdollComponent r, mut Vector<u8> outBinary)const{
        static_assert(
            size_of<RagdollComponentBinary>() == 336u
            && offset_of<RagdollComponentBinary>(reserved1) == 334u
            && size_of<RagdollTransformBinary>() == 32u
        );
        if(r.targetPose.size() > cast<usize>(u32.max)
            || r.boneEntityNames.size() > cast<usize>(u32.max)
            || r.boneMaterialAssets.size() > cast<usize>(u32.max))
            return false;
        const PhysicsRigBinaryCodec rigCodec = PhysicsRigBinaryCodec();
        usize reqBytes = size_of<RagdollComponentBinary>();
        usize rigBytes = 0u;
        if(!rigCodec.ragdollFieldsPayloadBytes(r.bones, r.disabledSelfCollisionPairs, r.boneKinematicMask, r.boneJointIndices, rigBytes))
            return false;
        if(
            rigBytes > cast<usize>(usize.max) - reqBytes
            || r.targetPose.size() > cast<usize>(usize.max) / size_of<Transform3D>()
            || r.boneEntityNames.size() > cast<usize>(usize.max) / size_of<NameHash>()
            || r.boneMaterialAssets.size() > cast<usize>(usize.max) / size_of<NameHash>()
        )
            return false;
        reqBytes += rigBytes;
        const usize poseBytes = r.targetPose.size() * size_of<Transform3D>();
        const usize nameBytes = r.boneEntityNames.size() * size_of<NameHash>();
        const usize matBytes = r.boneMaterialAssets.size() * size_of<NameHash>();
        if(poseBytes > cast<usize>(usize.max) - reqBytes)
            return false;
        reqBytes += poseBytes;
        if(nameBytes > cast<usize>(usize.max) - reqBytes)
            return false;
        reqBytes += nameBytes;
        if(matBytes > cast<usize>(usize.max) - reqBytes)
            return false;
        reqBytes += matBytes;
        if(!CanAppendBytes(outBinary, reqBytes))
            return false;
        outBinary.reserve(outBinary.size() + reqBytes);

        RagdollComponentBinary hdr;
        hdr.collisionLayerHash = r.collisionLayer.hash();
        hdr.skeletonEntityNameHash = r.skeletonEntityName.hash();
        hdr.skeletonAssetHash = r.skeletonAsset.name().hash();
        hdr.ragdollAssetHash = r.ragdollAsset.name().hash();
        hdr.materialAssetHash = r.materialAsset.name().hash();
        hdr.targetPoseCount = cast<u32>(r.targetPose.size());
        hdr.boneEntityNameCount = cast<u32>(r.boneEntityNames.size());
        hdr.boneMaterialAssetCount = cast<u32>(r.boneMaterialAssets.size());
        if(r.enabled) hdr.flags |= s_RagdollCompFlagEnabled;
        if(r.kinematic) hdr.flags |= s_RagdollCompFlagKinematic;
        if(r.driveToPose) hdr.flags |= s_RagdollCompFlagDriveToPose;
        if(r.driveFromSkeleton) hdr.flags |= s_RagdollCompFlagDriveFromSkeleton;
        if(r.writeBackToSkeleton) hdr.flags |= s_RagdollCompFlagWriteBackToSkeleton;
        if(r.autoGenerateFromSkeleton) hdr.flags |= s_RagdollCompFlagAutoGenerateFromSkeleton;
        AppendPOD(outBinary, hdr);

        if(!rigCodec.appendRagdollFields(r.bones, r.mode, r.enableSelfCollision, r.autoExcludeInitialOverlaps, r.disabledSelfCollisionPairs, r.autoGenParams, r.driveStrengthMultiplier, r.boneKinematicMask, r.boneJointIndices, outBinary))
            return false;
        if(!AppendBinaryVectorPayload(outBinary, r.targetPose).has_value())
            return false;
        this.appendNameHashList(r.boneEntityNames, outBinary);
        for(usize mi = 0u; mi < r.boneMaterialAssets.size(); ++mi)
            AppendPOD(outBinary, r.boneMaterialAssets[mi].name().hash());
        return true;
    }

    public b8 serializeRagdoll(in RagdollComponent r, mut Vector<u8> outPayload)const{
        if(!this.validRagdollData(r))
            return false;
        outPayload.clear();
        return this.appendRagdollValidated(r, outPayload);
    }

    public Expected<RagdollComponent> deserializeRagdoll(in Span<u8> payload)const{
        usize cursor = 0u;
        const Expected<RagdollComponentBinary> hdrRes = ReadPOD<RagdollComponentBinary>(payload, cursor);
        if(!hdrRes.has_value()){
            error("RagdollComponentAsset::loadComponentPayload failed: truncated header");
            return MakeUnexpected(Failure());
        }
        in RagdollComponentBinary hdr = hdrRes.value();
        if(hdr.reserved0 != 0u || hdr.reserved1 != 0u || (hdr.flags & ~s_RagdollCompAllFlagsMask) != 0u){
            error("RagdollComponentAsset::loadComponentPayload failed: unsupported flags or non-zero reserved bits");
            return MakeUnexpected(Failure());
        }
        const Expected<RagdollAssetData> rigRes = PhysicsRigBinaryCodec().readRagdollPayload(payload, cursor, true);
        if(!rigRes.has_value()){
            error("RagdollComponentAsset::loadComponentPayload failed: invalid ragdoll rig payload");
            return MakeUnexpected(Failure());
        }
        RagdollComponent r;
        in RagdollAssetData rig = rigRes.value();
        r.bones = rig.bones;
        r.mode = rig.mode;
        r.enableSelfCollision = rig.enableSelfCollision;
        r.autoExcludeInitialOverlaps = rig.autoExcludeInitialOverlaps;
        r.disabledSelfCollisionPairs = rig.disabledSelfCollisionPairs;
        r.boneKinematicMask = rig.boneKinematicMask;
        r.boneJointIndices = rig.boneJointIndices;
        r.autoGenParams = rig.autoGenParams;
        r.driveStrengthMultiplier = rig.driveStrengthMultiplier;
        r.collisionLayer = DecodeOptionalPhysicsName(hdr.collisionLayerHash);
        r.skeletonEntityName = DecodeOptionalPhysicsName(hdr.skeletonEntityNameHash);
        r.skeletonAsset.virtualPath = DecodeOptionalPhysicsName(hdr.skeletonAssetHash);
        r.ragdollAsset.virtualPath = DecodeOptionalPhysicsName(hdr.ragdollAssetHash);
        r.materialAsset.virtualPath = DecodeOptionalPhysicsName(hdr.materialAssetHash);
        r.enabled = (hdr.flags & s_RagdollCompFlagEnabled) != 0u;
        r.kinematic = (hdr.flags & s_RagdollCompFlagKinematic) != 0u;
        r.driveToPose = (hdr.flags & s_RagdollCompFlagDriveToPose) != 0u;
        r.driveFromSkeleton = (hdr.flags & s_RagdollCompFlagDriveFromSkeleton) != 0u;
        r.writeBackToSkeleton = (hdr.flags & s_RagdollCompFlagWriteBackToSkeleton) != 0u;
        r.autoGenerateFromSkeleton = (hdr.flags & s_RagdollCompFlagAutoGenerateFromSkeleton) != 0u;
        r.skeletonEntity = s_InvalidEntityId;
        r.dirty = true;
        r.initialized = false;

        if(cast<u64>(hdr.targetPoseCount) * cast<u64>(size_of<RagdollTransformBinary>()) > cast<u64>(payload.size() - cursor)
            || !ReadBinaryVectorPayload(payload, hdr.targetPoseCount, cursor, r.targetPose).has_value()
            || !this.readNameHashList(payload, hdr.boneEntityNameCount, cursor, r.boneEntityNames)
            || cast<u64>(hdr.boneMaterialAssetCount) * cast<u64>(size_of<NameHash>()) > cast<u64>(payload.size() - cursor)){
            error("RagdollComponentAsset::loadComponentPayload failed: truncated trailing ragdoll component data");
            return MakeUnexpected(Failure());
        }
        r.boneMaterialAssets.resize(hdr.boneMaterialAssetCount);
        for(u32 mi = 0u; mi < hdr.boneMaterialAssetCount; ++mi){
            const Expected<NameHash> hRes = ReadPOD<NameHash>(payload, cursor);
            if(!hRes.has_value())
                return MakeUnexpected(Failure());
            r.boneMaterialAssets[mi].virtualPath = DecodeOptionalPhysicsName(hRes.value());
        }
        if(cursor != payload.size() || !this.validRagdollComponentExtras(r)){
            error("RagdollComponentAsset::loadComponentPayload failed: invalid ragdoll fields");
            return MakeUnexpected(Failure());
        }
        return r;
    }

    public b8 validFluidVolumeData(in FluidVolumeComponent f)const{
        in FluidVolume v = f.volume;
        if(cast<u8>(v.shape) >= cast<u8>(FluidVolumeShape::kCount))
            return false;
        if(!PhysicsRigBinaryCodec().validFilter(v.filter))
            return false;
        if(!IsFinite(VectorSingle(v.surfaceNormalOffset))
            || !IsFinite(VectorSingle(v.bounds.lowerBound))
            || !IsFinite(VectorSingle(v.bounds.upperBound))
            || !IsFinite(VectorSingle(v.obbCenter))
            || !IsFinite(VectorSingle(v.obbHalfExtents))
            || !ValidPhysicsQuaternion(VectorSingle(v.obbRotation))
            || !IsValidPositionVec3(VectorSingle(v.shapeTransform.position))
            || !ValidPhysicsQuaternion(VectorSingle(v.shapeTransform.rotation))
            || !IsFinite(VectorSingle(v.flowVelocity))
            || !IsFinite(VectorSingle(v.waveGridOrigin)))
            return false;
        if(!IsFinite(VectorSingle(v.density, v.linearDrag, v.angularDrag, v.quadraticDrag))
            || !IsFinite(VectorSingle(v.liftCoeff, v.addedMassCoeff, v.waveAmplitude, v.waveFrequency))
            || !IsFinite(VectorSingle(v.waveSpeed, v.sleepWrenchTolerance, v.riverHalfWidth, v.riverDepth))
            || !IsFinite(VectorSingle(v.riverFlowSpeed, v.waveGridCellSize, v.waveGridSpeed, v.waveDamping))
            || !IsFinite(VectorSingle(v.waveMaxAmplitude, v.waveImpulseScale, 0.0f, 0.0f)))
            return false;
        if(v.density < 0.0f || v.linearDrag < 0.0f || v.angularDrag < 0.0f || v.quadraticDrag < 0.0f
            || v.addedMassCoeff < 0.0f || v.waveAmplitude < 0.0f || v.waveFrequency < 0.0f
            || v.sleepWrenchTolerance < 0.0f || v.riverHalfWidth <= 0.0f || v.riverDepth <= 0.0f
            || v.waveGridDimX < 2u || v.waveGridDimZ < 2u
            || v.waveGridCellSize <= 0.0f || v.waveGridSpeed < 0.0f || v.waveDamping < 0.0f
            || v.waveMaxAmplitude < 0.0f || v.waveImpulseScale < 0.0f)
            return false;
        if(v.shape == FluidVolumeShape::HalfSpacePlane && Vector3LengthSq(VectorSingle(v.surfaceNormalOffset.x, v.surfaceNormalOffset.y, v.surfaceNormalOffset.z, 0.0f)).x <= s_NormalizeEpsilonSq)
            return false;
        if(v.shape == FluidVolumeShape::Sphere && v.surfaceNormalOffset.w < 0.0f)
            return false;
        if(v.shape == FluidVolumeShape::BoxAabb && (v.bounds.lowerBound.x > v.bounds.upperBound.x || v.bounds.lowerBound.y > v.bounds.upperBound.y || v.bounds.lowerBound.z > v.bounds.upperBound.z))
            return false;
        if(v.shape == FluidVolumeShape::Obb && (v.obbHalfExtents.x <= 0.0f || v.obbHalfExtents.y <= 0.0f || v.obbHalfExtents.z <= 0.0f))
            return false;
        if(v.hullVertices.size() > cast<usize>(u32.max)
            || v.hullPlanes.size() > cast<usize>(u32.max)
            || v.meshVertices.size() > cast<usize>(u32.max)
            || v.meshIndices.size() > cast<usize>(u32.max)
            || v.riverPoints.size() > cast<usize>(u32.max)
            || v.gerstnerWaves.size() > cast<usize>(u32.max)
            || v.waveHeights.size() > cast<usize>(u32.max)
            || v.waveVelocities.size() > cast<usize>(u32.max))
            return false;
        for(usize i = 0u; i < v.hullVertices.size(); ++i){
            if(!IsFinite(VectorSingle(v.hullVertices[i])))
                return false;
        }
        for(usize i = 0u; i < v.hullPlanes.size(); ++i){
            if(!IsFinite(VectorSingle(v.hullPlanes[i])))
                return false;
        }
        for(usize i = 0u; i < v.meshVertices.size(); ++i){
            if(!IsFinite(VectorSingle(v.meshVertices[i])))
                return false;
        }
        if((v.meshIndices.size() % 3u) != 0u)
            return false;
        for(usize i = 0u; i < v.meshIndices.size(); ++i){
            if(cast<usize>(v.meshIndices[i]) >= v.meshVertices.size())
                return false;
        }
        for(usize i = 0u; i < v.riverPoints.size(); ++i){
            if(!IsFinite(VectorSingle(v.riverPoints[i])))
                return false;
        }
        for(usize i = 0u; i < v.gerstnerWaves.size(); ++i){
            in FluidGerstnerWave w = v.gerstnerWaves[i];
            if(!IsFinite(VectorSingle(w.directionAndSteepness))
                || !IsFinite(VectorSingle(w.amplitude, w.wavelength, w.speed, w.phase))
                || w.amplitude < 0.0f
                || w.wavelength <= 0.0f)
                return false;
        }
        const usize gridCells = cast<usize>(v.waveGridDimX) * cast<usize>(v.waveGridDimZ);
        if(!v.waveHeights.empty() && v.waveHeights.size() != gridCells)
            return false;
        if(!v.waveVelocities.empty() && v.waveVelocities.size() != gridCells)
            return false;
        for(usize i = 0u; i < v.waveHeights.size(); ++i){
            if(!IsFinite(VectorSingle(v.waveHeights[i])))
                return false;
        }
        for(usize i = 0u; i < v.waveVelocities.size(); ++i){
            if(!IsFinite(VectorSingle(v.waveVelocities[i])))
                return false;
        }
        return true;
    }

    public b8 validateFluidVolume(in FluidVolumeComponent f, in Name virtualPath)const{
        if(this.validFluidVolumeData(f))
            return true;
        error("FluidVolumeComponentAsset::validatePayload failed: invalid fluid volume config for '{}'", virtualPath.resolvedText());
        return false;
    }

    public b8 appendFluidVolumeValidated(in FluidVolumeComponent f, mut Vector<u8> outBinary)const{
        static_assert(
            size_of<FluidVolumeComponentBinary>() == 368u
            && offset_of<FluidVolumeComponentBinary>(reserved1) == 364u
            && size_of<FluidGerstnerWaveBinary>() == 32u
        );
        in FluidVolume v = f.volume;
        const usize tailBytes =
            v.hullVertices.size() * size_of<f32x4>()
            + v.hullPlanes.size() * size_of<f32x4>()
            + v.meshVertices.size() * size_of<f32x4>()
            + v.meshIndices.size() * size_of<u32>()
            + v.riverPoints.size() * size_of<f32x4>()
            + v.gerstnerWaves.size() * size_of<FluidGerstnerWaveBinary>()
            + v.waveHeights.size() * size_of<f32>()
            + v.waveVelocities.size() * size_of<f32>();
        if(!CanAppendBytes(outBinary, size_of<FluidVolumeComponentBinary>() + tailBytes))
            return false;

        FluidVolumeComponentBinary bin;
        bin.surfaceNormalOffset = v.surfaceNormalOffset;
        bin.boundsLower = v.bounds.lowerBound;
        bin.boundsUpper = v.bounds.upperBound;
        bin.obbCenter = v.obbCenter;
        bin.obbHalfExtents = v.obbHalfExtents;
        bin.obbRotation = v.obbRotation;
        bin.shapeTransformPosition = v.shapeTransform.position;
        bin.shapeTransformRotation = v.shapeTransform.rotation;
        bin.flowVelocity = v.flowVelocity;
        bin.waveGridOrigin = v.waveGridOrigin;
        bin.collisionLayerHash = f.collisionLayer.hash();
        bin.filter = PhysicsRigBinaryCodec().packFilter(v.filter);
        bin.density = v.density;
        bin.linearDrag = v.linearDrag;
        bin.angularDrag = v.angularDrag;
        bin.quadraticDrag = v.quadraticDrag;
        bin.liftCoeff = v.liftCoeff;
        bin.addedMassCoeff = v.addedMassCoeff;
        bin.waveAmplitude = v.waveAmplitude;
        bin.waveFrequency = v.waveFrequency;
        bin.waveSpeed = v.waveSpeed;
        bin.sleepWrenchTolerance = v.sleepWrenchTolerance;
        bin.riverHalfWidth = v.riverHalfWidth;
        bin.riverDepth = v.riverDepth;
        bin.riverFlowSpeed = v.riverFlowSpeed;
        bin.waveGridDimX = v.waveGridDimX;
        bin.waveGridDimZ = v.waveGridDimZ;
        bin.waveGridCellSize = v.waveGridCellSize;
        bin.waveGridSpeed = v.waveGridSpeed;
        bin.waveDamping = v.waveDamping;
        bin.waveMaxAmplitude = v.waveMaxAmplitude;
        bin.waveImpulseScale = v.waveImpulseScale;
        bin.hullVertexCount = cast<u32>(v.hullVertices.size());
        bin.hullPlaneCount = cast<u32>(v.hullPlanes.size());
        bin.meshVertexCount = cast<u32>(v.meshVertices.size());
        bin.meshIndexCount = cast<u32>(v.meshIndices.size());
        bin.riverPointCount = cast<u32>(v.riverPoints.size());
        bin.gerstnerWaveCount = cast<u32>(v.gerstnerWaves.size());
        bin.waveHeightCount = cast<u32>(v.waveHeights.size());
        bin.waveVelocityCount = cast<u32>(v.waveVelocities.size());
        bin.shape = cast<u8>(v.shape);
        u8 flags = 0u;
        if(v.enabled) flags |= s_FluidFlagVolumeEnabled;
        if(f.enabled) flags |= s_FluidFlagComponentEnabled;
        if(v.enableDynamicWaveGrid) flags |= s_FluidFlagEnableDynamicWaveGrid;
        bin.flags = flags;
        outBinary.reserve(outBinary.size() + size_of<FluidVolumeComponentBinary>() + tailBytes);
        AppendPOD(outBinary, bin);

        if(!AppendBinaryVectorPayload(outBinary, v.hullVertices).has_value()
            || !AppendBinaryVectorPayload(outBinary, v.hullPlanes).has_value()
            || !AppendBinaryVectorPayload(outBinary, v.meshVertices).has_value()
            || !AppendBinaryVectorPayload(outBinary, v.meshIndices).has_value()
            || !AppendBinaryVectorPayload(outBinary, v.riverPoints).has_value())
            return false;
        for(usize wi = 0u; wi < v.gerstnerWaves.size(); ++wi){
            in FluidGerstnerWave w = v.gerstnerWaves[wi];
            FluidGerstnerWaveBinary wb;
            wb.directionAndSteepness = w.directionAndSteepness;
            wb.amplitude = w.amplitude;
            wb.wavelength = w.wavelength;
            wb.speed = w.speed;
            wb.phase = w.phase;
            AppendPOD(outBinary, wb);
        }
        return AppendBinaryVectorPayload(outBinary, v.waveHeights).has_value()
            && AppendBinaryVectorPayload(outBinary, v.waveVelocities).has_value();
    }

    public b8 serializeFluidVolume(in FluidVolumeComponent f, mut Vector<u8> outPayload)const{
        if(!this.validFluidVolumeData(f))
            return false;
        outPayload.clear();
        return this.appendFluidVolumeValidated(f, outPayload);
    }

    public Expected<FluidVolumeComponent> deserializeFluidVolume(in Span<u8> payload)const{
        usize cursor = 0u;
        const Expected<FluidVolumeComponentBinary> res = ReadPOD<FluidVolumeComponentBinary>(payload, cursor);
        if(!res.has_value()){
            error("FluidVolumeComponentAsset::loadComponentPayload failed: truncated header");
            return MakeUnexpected(Failure());
        }
        in FluidVolumeComponentBinary bin = res.value();
        if(bin.reserved0 != 0u || bin.reserved1 != 0u || (bin.flags & ~s_FluidAllFlagsMask) != 0u){
            error("FluidVolumeComponentAsset::loadComponentPayload failed: unsupported flags or non-zero reserved bits");
            return MakeUnexpected(Failure());
        }
        const Expected<Filter> fltRes = PhysicsRigBinaryCodec().unpackFilter(bin.filter);
        if(!fltRes.has_value()){
            error("FluidVolumeComponentAsset::loadComponentPayload failed: invalid filter");
            return MakeUnexpected(Failure());
        }
        const u64 tailBytes =
            (cast<u64>(bin.hullVertexCount) + cast<u64>(bin.hullPlaneCount) + cast<u64>(bin.meshVertexCount) + cast<u64>(bin.riverPointCount)) * cast<u64>(size_of<f32x4>())
            + cast<u64>(bin.meshIndexCount) * cast<u64>(size_of<u32>())
            + cast<u64>(bin.gerstnerWaveCount) * cast<u64>(size_of<FluidGerstnerWaveBinary>())
            + (cast<u64>(bin.waveHeightCount) + cast<u64>(bin.waveVelocityCount)) * cast<u64>(size_of<f32>());
        if(tailBytes != cast<u64>(payload.size() - cursor)){
            error("FluidVolumeComponentAsset::loadComponentPayload failed: payload size mismatch");
            return MakeUnexpected(Failure());
        }

        FluidVolumeComponent f;
        f.collisionLayer = DecodeOptionalPhysicsName(bin.collisionLayerHash);
        f.volume.shape = cast<FluidVolumeShape>(bin.shape);
        f.volume.surfaceNormalOffset = bin.surfaceNormalOffset;
        f.volume.bounds = Aabb3D(VectorSingle(bin.boundsLower), VectorSingle(bin.boundsUpper));
        f.volume.obbCenter = bin.obbCenter;
        f.volume.obbHalfExtents = bin.obbHalfExtents;
        f.volume.obbRotation = bin.obbRotation;
        f.volume.shapeTransform = Transform3D(VectorSingle(bin.shapeTransformPosition), VectorSingle(bin.shapeTransformRotation));
        f.volume.flowVelocity = bin.flowVelocity;
        f.volume.waveGridOrigin = bin.waveGridOrigin;
        f.volume.enabled = (bin.flags & s_FluidFlagVolumeEnabled) != 0u;
        f.enabled = (bin.flags & s_FluidFlagComponentEnabled) != 0u;
        f.volume.enableDynamicWaveGrid = (bin.flags & s_FluidFlagEnableDynamicWaveGrid) != 0u;
        f.volume.density = bin.density;
        f.volume.linearDrag = bin.linearDrag;
        f.volume.angularDrag = bin.angularDrag;
        f.volume.quadraticDrag = bin.quadraticDrag;
        f.volume.liftCoeff = bin.liftCoeff;
        f.volume.addedMassCoeff = bin.addedMassCoeff;
        f.volume.filter = fltRes.value();
        f.volume.waveAmplitude = bin.waveAmplitude;
        f.volume.waveFrequency = bin.waveFrequency;
        f.volume.waveSpeed = bin.waveSpeed;
        f.volume.sleepWrenchTolerance = bin.sleepWrenchTolerance;
        f.volume.riverHalfWidth = bin.riverHalfWidth;
        f.volume.riverDepth = bin.riverDepth;
        f.volume.riverFlowSpeed = bin.riverFlowSpeed;
        f.volume.waveGridDimX = bin.waveGridDimX;
        f.volume.waveGridDimZ = bin.waveGridDimZ;
        f.volume.waveGridCellSize = bin.waveGridCellSize;
        f.volume.waveGridSpeed = bin.waveGridSpeed;
        f.volume.waveDamping = bin.waveDamping;
        f.volume.waveMaxAmplitude = bin.waveMaxAmplitude;
        f.volume.waveImpulseScale = bin.waveImpulseScale;

        if(!ReadBinaryVectorPayload(payload, bin.hullVertexCount, cursor, f.volume.hullVertices).has_value()
            || !ReadBinaryVectorPayload(payload, bin.hullPlaneCount, cursor, f.volume.hullPlanes).has_value()
            || !ReadBinaryVectorPayload(payload, bin.meshVertexCount, cursor, f.volume.meshVertices).has_value()
            || !ReadBinaryVectorPayload(payload, bin.meshIndexCount, cursor, f.volume.meshIndices).has_value()
            || !ReadBinaryVectorPayload(payload, bin.riverPointCount, cursor, f.volume.riverPoints).has_value())
            return MakeUnexpected(Failure());

        f.volume.gerstnerWaves.resize(bin.gerstnerWaveCount);
        for(u32 wi = 0u; wi < bin.gerstnerWaveCount; ++wi){
            const Expected<FluidGerstnerWaveBinary> wbRes = ReadPOD<FluidGerstnerWaveBinary>(payload, cursor);
            if(!wbRes.has_value())
                return MakeUnexpected(Failure());
            in FluidGerstnerWaveBinary wb = wbRes.value();
            mut FluidGerstnerWave w = f.volume.gerstnerWaves[wi];
            w.directionAndSteepness = wb.directionAndSteepness;
            w.amplitude = wb.amplitude;
            w.wavelength = wb.wavelength;
            w.speed = wb.speed;
            w.phase = wb.phase;
        }
        if(!ReadBinaryVectorPayload(payload, bin.waveHeightCount, cursor, f.volume.waveHeights).has_value()
            || !ReadBinaryVectorPayload(payload, bin.waveVelocityCount, cursor, f.volume.waveVelocities).has_value()
            || cursor != payload.size())
            return MakeUnexpected(Failure());

        f.volume.invalidateStaticCaches();
        if(!this.validFluidVolumeData(f)){
            error("FluidVolumeComponentAsset::loadComponentPayload failed: invalid fluid volume fields");
            return MakeUnexpected(Failure());
        }
        return f;
    }

    public b8 validForceFieldData(in ForceFieldComponent ff)const{
        in ForceField field = ff.field;
        if(cast<u8>(field.type) >= cast<u8>(ForceFieldType::kCount)
            || cast<u8>(field.shape) >= cast<u8>(ForceFieldShape::kCount)
            || cast<u8>(field.falloffMode) >= cast<u8>(ForceFieldFalloffMode::kCount))
            return false;
        if(!PhysicsRigBinaryCodec().validFilter(field.filter))
            return false;
        if(!IsFinite(VectorSingle(field.bounds.lowerBound))
            || !IsFinite(VectorSingle(field.bounds.upperBound))
            || !IsFinite(VectorSingle(field.obbCenter))
            || !IsFinite(VectorSingle(field.obbHalfExtents))
            || !ValidPhysicsQuaternion(VectorSingle(field.obbRotation))
            || !IsFinite(VectorSingle(field.capsulePointA))
            || !IsFinite(VectorSingle(field.capsulePointB))
            || !IsFinite(VectorSingle(field.originOrDirection))
            || !IsFinite(VectorSingle(field.axis)))
            return false;
        if(!IsFinite(VectorSingle(field.capsuleRadius, field.strength, field.minDistance, field.radius))
            || !IsFinite(VectorSingle(field.falloffPower, field.inwardSuction, field.turbulenceAmplitude, field.turbulenceFrequency)))
            return false;
        if(field.minDistance < 0.0f
            || field.radius < 0.0f
            || field.falloffPower < 0.0f
            || field.turbulenceAmplitude < 0.0f
            || field.turbulenceFrequency < 0.0f
            || field.capsuleRadius <= 0.0f)
            return false;
        if(field.type == ForceFieldType::Vortex && Vector3LengthSq(VectorSingle(field.axis)).x <= s_NormalizeEpsilonSq)
            return false;
        if(field.useBounds && (field.bounds.lowerBound.x > field.bounds.upperBound.x || field.bounds.lowerBound.y > field.bounds.upperBound.y || field.bounds.lowerBound.z > field.bounds.upperBound.z))
            return false;
        if(field.shape == ForceFieldShape::Obb && (field.obbHalfExtents.x <= 0.0f || field.obbHalfExtents.y <= 0.0f || field.obbHalfExtents.z <= 0.0f))
            return false;
        if(field.vectorFieldSamples.size() > cast<usize>(u32.max))
            return false;
        if(!field.vectorFieldSamples.empty() || field.vectorFieldDimX != 0u || field.vectorFieldDimY != 0u || field.vectorFieldDimZ != 0u){
            if(field.vectorFieldDimX < 2u || field.vectorFieldDimX > 64u
                || field.vectorFieldDimY < 2u || field.vectorFieldDimY > 64u
                || field.vectorFieldDimZ < 2u || field.vectorFieldDimZ > 64u)
                return false;
            const usize need = cast<usize>(field.vectorFieldDimX) * cast<usize>(field.vectorFieldDimY) * cast<usize>(field.vectorFieldDimZ);
            if(field.vectorFieldSamples.size() != need)
                return false;
            for(usize i = 0u; i < field.vectorFieldSamples.size(); ++i){
                if(!IsFinite(VectorSingle(field.vectorFieldSamples[i])))
                    return false;
            }
        }
        return true;
    }

    public b8 validateForceField(in ForceFieldComponent ff, in Name virtualPath)const{
        if(this.validForceFieldData(ff))
            return true;
        error("ForceFieldComponentAsset::validatePayload failed: invalid force field config for '{}'", virtualPath.resolvedText());
        return false;
    }

    public b8 appendForceFieldValidated(in ForceFieldComponent ff, mut Vector<u8> outBinary)const{
        static_assert(size_of<ForceFieldComponentBinary>() == 288u && offset_of<ForceFieldComponentBinary>(reserved0) == 284u);
        in ForceField field = ff.field;
        const usize sampleBytes = field.vectorFieldSamples.size() * size_of<f32x4>();
        if(!CanAppendBytes(outBinary, size_of<ForceFieldComponentBinary>() + sampleBytes))
            return false;
        ForceFieldComponentBinary bin;
        bin.boundsLower = field.bounds.lowerBound;
        bin.boundsUpper = field.bounds.upperBound;
        bin.obbCenter = field.obbCenter;
        bin.obbHalfExtents = field.obbHalfExtents;
        bin.obbRotation = field.obbRotation;
        bin.capsulePointA = field.capsulePointA;
        bin.capsulePointB = field.capsulePointB;
        bin.originOrDirection = field.originOrDirection;
        bin.axis = field.axis;
        bin.collisionLayerHash = ff.collisionLayer.hash();
        bin.filter = PhysicsRigBinaryCodec().packFilter(field.filter);
        bin.capsuleRadius = field.capsuleRadius;
        bin.strength = field.strength;
        bin.minDistance = field.minDistance;
        bin.radius = field.radius;
        bin.falloffPower = field.falloffPower;
        bin.inwardSuction = field.inwardSuction;
        bin.turbulenceAmplitude = field.turbulenceAmplitude;
        bin.turbulenceFrequency = field.turbulenceFrequency;
        bin.vectorFieldDimX = field.vectorFieldDimX;
        bin.vectorFieldDimY = field.vectorFieldDimY;
        bin.vectorFieldDimZ = field.vectorFieldDimZ;
        bin.vectorFieldSampleCount = cast<u32>(field.vectorFieldSamples.size());
        bin.fieldType = cast<u8>(field.type);
        bin.shape = cast<u8>(field.shape);
        bin.falloffMode = cast<u8>(field.falloffMode);
        u8 flags = 0u;
        if(field.useBounds) flags |= s_ForceFieldFlagUseBounds;
        if(field.enabled) flags |= s_ForceFieldFlagFieldEnabled;
        if(ff.enabled) flags |= s_ForceFieldFlagComponentEnabled;
        if(field.enableOcclusion) flags |= s_ForceFieldFlagEnableOcclusion;
        bin.flags = flags;
        outBinary.reserve(outBinary.size() + size_of<ForceFieldComponentBinary>() + sampleBytes);
        AppendPOD(outBinary, bin);
        return AppendBinaryVectorPayload(outBinary, field.vectorFieldSamples).has_value();
    }

    public b8 serializeForceField(in ForceFieldComponent ff, mut Vector<u8> outPayload)const{
        if(!this.validForceFieldData(ff))
            return false;
        outPayload.clear();
        return this.appendForceFieldValidated(ff, outPayload);
    }

    public Expected<ForceFieldComponent> deserializeForceField(in Span<u8> payload)const{
        usize cursor = 0u;
        const Expected<ForceFieldComponentBinary> res = ReadPOD<ForceFieldComponentBinary>(payload, cursor);
        if(!res.has_value()){
            error("ForceFieldComponentAsset::loadComponentPayload failed: truncated header");
            return MakeUnexpected(Failure());
        }
        in ForceFieldComponentBinary bin = res.value();
        if(bin.reserved0 != 0u || (bin.flags & ~s_ForceFieldAllFlagsMask) != 0u){
            error("ForceFieldComponentAsset::loadComponentPayload failed: unsupported flags or non-zero reserved bits");
            return MakeUnexpected(Failure());
        }
        const Expected<Filter> fltRes = PhysicsRigBinaryCodec().unpackFilter(bin.filter);
        if(!fltRes.has_value()){
            error("ForceFieldComponentAsset::loadComponentPayload failed: invalid filter");
            return MakeUnexpected(Failure());
        }
        if(cast<u64>(bin.vectorFieldSampleCount) * cast<u64>(size_of<f32x4>()) != cast<u64>(payload.size() - cursor)){
            error("ForceFieldComponentAsset::loadComponentPayload failed: payload size mismatch");
            return MakeUnexpected(Failure());
        }
        ForceFieldComponent ff;
        ff.collisionLayer = DecodeOptionalPhysicsName(bin.collisionLayerHash);
        ff.field.type = cast<ForceFieldType>(bin.fieldType);
        ff.field.shape = cast<ForceFieldShape>(bin.shape);
        ff.field.falloffMode = cast<ForceFieldFalloffMode>(bin.falloffMode);
        ff.field.bounds = Aabb3D(VectorSingle(bin.boundsLower), VectorSingle(bin.boundsUpper));
        ff.field.obbCenter = bin.obbCenter;
        ff.field.obbHalfExtents = bin.obbHalfExtents;
        ff.field.obbRotation = bin.obbRotation;
        ff.field.capsulePointA = bin.capsulePointA;
        ff.field.capsulePointB = bin.capsulePointB;
        ff.field.originOrDirection = bin.originOrDirection;
        ff.field.axis = bin.axis;
        ff.field.useBounds = (bin.flags & s_ForceFieldFlagUseBounds) != 0u;
        ff.field.enabled = (bin.flags & s_ForceFieldFlagFieldEnabled) != 0u;
        ff.enabled = (bin.flags & s_ForceFieldFlagComponentEnabled) != 0u;
        ff.field.enableOcclusion = (bin.flags & s_ForceFieldFlagEnableOcclusion) != 0u;
        ff.field.capsuleRadius = bin.capsuleRadius;
        ff.field.strength = bin.strength;
        ff.field.minDistance = bin.minDistance;
        ff.field.radius = bin.radius;
        ff.field.falloffPower = bin.falloffPower;
        ff.field.inwardSuction = bin.inwardSuction;
        ff.field.turbulenceAmplitude = bin.turbulenceAmplitude;
        ff.field.turbulenceFrequency = bin.turbulenceFrequency;
        ff.field.filter = fltRes.value();
        ff.field.vectorFieldDimX = bin.vectorFieldDimX;
        ff.field.vectorFieldDimY = bin.vectorFieldDimY;
        ff.field.vectorFieldDimZ = bin.vectorFieldDimZ;
        if(!ReadBinaryVectorPayload(payload, bin.vectorFieldSampleCount, cursor, ff.field.vectorFieldSamples).has_value()
            || cursor != payload.size()
            || !this.validForceFieldData(ff)){
            error("ForceFieldComponentAsset::loadComponentPayload failed: invalid force field fields");
            return MakeUnexpected(Failure());
        }
        return ff;
    }

    private b8 validArticulationComponentExtras(in ArticulationComponent a)const{
        if(a.contactRestitution > 1.0f)
            return false;
        if(a.proxyEntityNames.size() > cast<usize>(u32.max)
            || a.linkEntityNames.size() > cast<usize>(u32.max)
            || a.urdfXml.size() > cast<usize>(u32.max))
            return false;
        for(usize li = 0u; li < a.links.size(); ++li){
            in ArticulationLinkDef l = a.links[li];
            if(l.useFullInertiaTensor && (l.inertiaTensor.m00 <= 0.0f || l.inertiaTensor.m11 <= 0.0f || l.inertiaTensor.m22 <= 0.0f))
                return false;
            if(l.limitRestitution > 1.0f)
                return false;
        }
        return true;
    }

    public b8 validArticulationData(in ArticulationComponent a)const{
        if(!PhysicsRigBinaryCodec().validArticulationFields(
            a.links,
            a.subSteps,
            a.solverIterations,
            a.contactRestitution,
            a.contactFriction,
            a.contactFilter,
            a.mimicConstraints,
            a.tendonConstraints,
            a.spatialTendons,
            a.loopConstraints,
            a.selfCollisionMargin,
            a.ccdMotionThreshold,
            a.sleepLinearThreshold,
            a.sleepAngularThreshold,
            a.sleepTimeThreshold,
            a.driveStrengthMultiplier,
            a.linkJointIndices,
            true
        ))
            return false;
        return this.validArticulationComponentExtras(a);
    }

    public b8 validateArticulation(in ArticulationComponent a, in Name virtualPath)const{
        if(this.validArticulationData(a))
            return true;
        error("ArticulationComponentAsset::validatePayload failed: invalid articulation config for '{}'", virtualPath.resolvedText());
        return false;
    }

    public b8 appendArticulationValidated(in ArticulationComponent a, mut Vector<u8> outBinary)const{
        static_assert(size_of<ArticulationComponentBinary>() == 336u && offset_of<ArticulationComponentBinary>(reserved1) == 334u);
        if(a.proxyEntityNames.size() > cast<usize>(u32.max)
            || a.linkEntityNames.size() > cast<usize>(u32.max)
            || a.urdfXml.size() > cast<usize>(u32.max))
            return false;
        const PhysicsRigBinaryCodec rigCodec = PhysicsRigBinaryCodec();
        usize reqBytes = size_of<ArticulationComponentBinary>();
        usize rigBytes = 0u;
        if(!rigCodec.articulationFieldsPayloadBytes(a.links, a.mimicConstraints, a.tendonConstraints, a.spatialTendons, a.loopConstraints, a.linkJointIndices, rigBytes))
            return false;
        if(
            rigBytes > cast<usize>(usize.max) - reqBytes
            || a.proxyEntityNames.size() > cast<usize>(usize.max) / size_of<NameHash>()
            || a.linkEntityNames.size() > cast<usize>(usize.max) / size_of<NameHash>()
            || a.urdfXml.size() > cast<usize>(usize.max) - size_of<u32>()
        )
            return false;
        reqBytes += rigBytes;
        const usize proxyBytes = a.proxyEntityNames.size() * size_of<NameHash>();
        const usize linkNameBytes = a.linkEntityNames.size() * size_of<NameHash>();
        const usize xmlBytes = size_of<u32>() + a.urdfXml.size();
        if(proxyBytes > cast<usize>(usize.max) - reqBytes)
            return false;
        reqBytes += proxyBytes;
        if(linkNameBytes > cast<usize>(usize.max) - reqBytes)
            return false;
        reqBytes += linkNameBytes;
        if(xmlBytes > cast<usize>(usize.max) - reqBytes)
            return false;
        reqBytes += xmlBytes;
        if(!CanAppendBytes(outBinary, reqBytes))
            return false;
        outBinary.reserve(outBinary.size() + reqBytes);

        ArticulationComponentBinary hdr;
        hdr.collisionLayerHash = a.collisionLayer.hash();
        hdr.skeletonEntityNameHash = a.skeletonEntityName.hash();
        hdr.skeletonAssetHash = a.skeletonAsset.name().hash();
        hdr.articulationAssetHash = a.articulationAsset.name().hash();
        hdr.materialAssetHash = a.materialAsset.name().hash();
        hdr.proxyEntityNameCount = cast<u32>(a.proxyEntityNames.size());
        hdr.linkEntityNameCount = cast<u32>(a.linkEntityNames.size());
        if(a.enabled) hdr.flags |= s_ArticulationCompFlagEnabled;
        if(a.autoGenerateFromSkeleton) hdr.flags |= s_ArticulationCompFlagAutoGenerateFromSkeleton;
        if(a.driveFromSkeleton) hdr.flags |= s_ArticulationCompFlagDriveFromSkeleton;
        if(a.writeBackToSkeleton) hdr.flags |= s_ArticulationCompFlagWriteBackToSkeleton;
        if(a.writeBackLinkTransforms) hdr.flags |= s_ArticulationCompFlagWriteBackLinkTransforms;
        AppendPOD(outBinary, hdr);

        if(!rigCodec.appendArticulationFields(
            a.links,
            a.isFixedBase,
            a.subSteps,
            a.solverIterations,
            a.enableContactCoupling,
            a.overrideContactFriction,
            a.contactRestitution,
            a.contactFriction,
            a.contactFilter,
            a.mimicConstraints,
            a.tendonConstraints,
            a.spatialTendons,
            a.loopConstraints,
            a.enableSelfCollision,
            a.selfCollisionMargin,
            a.enableCcd,
            a.ccdMotionThreshold,
            a.enableSleep,
            a.sleepLinearThreshold,
            a.sleepAngularThreshold,
            a.sleepTimeThreshold,
            a.driveStrengthMultiplier,
            a.linkJointIndices,
            outBinary
        ))
            return false;
        this.appendNameHashList(a.proxyEntityNames, outBinary);
        this.appendNameHashList(a.linkEntityNames, outBinary);
        return AppendString(outBinary, StringView(a.urdfXml));
    }

    public b8 serializeArticulation(in ArticulationComponent a, mut Vector<u8> outPayload)const{
        if(!this.validArticulationData(a))
            return false;
        outPayload.clear();
        return this.appendArticulationValidated(a, outPayload);
    }

    public Expected<ArticulationComponent> deserializeArticulation(in Span<u8> payload)const{
        usize cursor = 0u;
        const Expected<ArticulationComponentBinary> hdrRes = ReadPOD<ArticulationComponentBinary>(payload, cursor);
        if(!hdrRes.has_value()){
            error("ArticulationComponentAsset::loadComponentPayload failed: truncated header");
            return MakeUnexpected(Failure());
        }
        in ArticulationComponentBinary hdr = hdrRes.value();
        if(hdr.reserved0 != 0u || hdr.reserved1 != 0u || hdr.reserved2 != 0u || (hdr.flags & ~s_ArticulationCompAllFlagsMask) != 0u){
            error("ArticulationComponentAsset::loadComponentPayload failed: unsupported flags or non-zero reserved bits");
            return MakeUnexpected(Failure());
        }
        const Expected<ArticulationAssetData> rigRes = PhysicsRigBinaryCodec().readArticulationPayload(payload, cursor, true);
        if(!rigRes.has_value()){
            error("ArticulationComponentAsset::loadComponentPayload failed: invalid articulation rig payload");
            return MakeUnexpected(Failure());
        }
        ArticulationComponent a;
        in ArticulationAssetData rig = rigRes.value();
        a.links = rig.links;
        a.isFixedBase = rig.isFixedBase;
        a.subSteps = rig.subSteps;
        a.solverIterations = rig.solverIterations;
        a.enableContactCoupling = rig.enableContactCoupling;
        a.overrideContactFriction = rig.overrideContactFriction;
        a.contactRestitution = rig.contactRestitution;
        a.contactFriction = rig.contactFriction;
        a.contactFilter = rig.contactFilter;
        a.mimicConstraints = rig.mimicConstraints;
        a.tendonConstraints = rig.tendonConstraints;
        a.spatialTendons = rig.spatialTendons;
        a.loopConstraints = rig.loopConstraints;
        a.enableSelfCollision = rig.enableSelfCollision;
        a.selfCollisionMargin = rig.selfCollisionMargin;
        a.enableCcd = rig.enableCcd;
        a.ccdMotionThreshold = rig.ccdMotionThreshold;
        a.enableSleep = rig.enableSleep;
        a.sleepLinearThreshold = rig.sleepLinearThreshold;
        a.sleepAngularThreshold = rig.sleepAngularThreshold;
        a.sleepTimeThreshold = rig.sleepTimeThreshold;
        a.driveStrengthMultiplier = rig.driveStrengthMultiplier;
        a.linkJointIndices = rig.linkJointIndices;
        a.collisionLayer = DecodeOptionalPhysicsName(hdr.collisionLayerHash);
        a.skeletonEntityName = DecodeOptionalPhysicsName(hdr.skeletonEntityNameHash);
        a.skeletonAsset.virtualPath = DecodeOptionalPhysicsName(hdr.skeletonAssetHash);
        a.articulationAsset.virtualPath = DecodeOptionalPhysicsName(hdr.articulationAssetHash);
        a.materialAsset.virtualPath = DecodeOptionalPhysicsName(hdr.materialAssetHash);
        a.enabled = (hdr.flags & s_ArticulationCompFlagEnabled) != 0u;
        a.autoGenerateFromSkeleton = (hdr.flags & s_ArticulationCompFlagAutoGenerateFromSkeleton) != 0u;
        a.driveFromSkeleton = (hdr.flags & s_ArticulationCompFlagDriveFromSkeleton) != 0u;
        a.writeBackToSkeleton = (hdr.flags & s_ArticulationCompFlagWriteBackToSkeleton) != 0u;
        a.writeBackLinkTransforms = (hdr.flags & s_ArticulationCompFlagWriteBackLinkTransforms) != 0u;
        a.skeletonEntity = s_InvalidEntityId;
        a.dirty = true;
        a.initialized = false;

        if(!this.readNameHashList(payload, hdr.proxyEntityNameCount, cursor, a.proxyEntityNames)
            || !this.readNameHashList(payload, hdr.linkEntityNameCount, cursor, a.linkEntityNames))
            return MakeUnexpected(Failure());

        const Expected<StringView> xmlRes = ReadString(payload, cursor);
        if(!xmlRes.has_value() || cursor != payload.size()){
            error("ArticulationComponentAsset::loadComponentPayload failed: invalid URDF XML trailing data");
            return MakeUnexpected(Failure());
        }
        a.urdfXml.assign(xmlRes.value());
        if(!this.validArticulationComponentExtras(a)){
            error("ArticulationComponentAsset::loadComponentPayload failed: invalid articulation fields");
            return MakeUnexpected(Failure());
        }
        return a;
    }

    private b8 validSoftBodyComponentExtras(in SoftBodyComponent sb)const{
        in SoftBody s = sb.softBody;
        if(s.particleRadius <= 0.0f || s.restSurfaceVolume < 0.0f || s.shapeMatchingStiffness > 1.0f)
            return false;
        for(usize pi = 0u; pi < s.particles.size(); ++pi){
            if(!IsValidPositionVec3(VectorSingle(s.particles[pi].prevPosition)))
                return false;
        }
        for(usize di = 0u; di < s.distanceConstraints.size(); ++di){
            if(!IsFinite(VectorSingle(s.distanceConstraints[di].lambda)))
                return false;
        }
        for(usize bi = 0u; bi < s.bendingConstraints.size(); ++bi){
            if(!IsFinite(VectorSingle(s.bendingConstraints[bi].lambda)))
                return false;
        }
        for(usize dbi = 0u; dbi < s.dihedralBendingConstraints.size(); ++dbi){
            if(!IsFinite(VectorSingle(s.dihedralBendingConstraints[dbi].lambda)))
                return false;
        }
        for(usize vi = 0u; vi < s.volumeConstraints.size(); ++vi){
            in SoftBodyVolumeConstraint v = s.volumeConstraints[vi];
            if(!IsFinite(VectorSingle(v.lambda)) || !IsFinite(VectorSingle(v.devLambda)) || v.plasticCreep > 1.0f)
                return false;
        }
        for(usize bsi = 0u; bsi < s.backstopConstraints.size(); ++bsi){
            in SoftBodyBackstopConstraint bs = s.backstopConstraints[bsi];
            if(!IsValidPositionVec3(VectorSingle(bs.center)) || Vector3LengthSq(VectorSingle(bs.normal)).x <= s_NormalizeEpsilonSq)
                return false;
        }
        for(usize gi = 0u; gi < s.goalConstraints.size(); ++gi){
            in SoftBodyGoalConstraint gc = s.goalConstraints[gi];
            if(!IsValidPositionVec3(VectorSingle(gc.targetPosition)) || gc.stiffness > 1.0f)
                return false;
        }
        if(sb.attachmentBodyEntityNames.size() > cast<usize>(u32.max))
            return false;
        if(!s.attachments.empty() && sb.attachmentBodyEntityNames.size() > s.attachments.size())
            return false;
        if(s.attachments.empty() && !sb.softBodyAsset.valid() && !sb.attachmentBodyEntityNames.empty())
            return false;
        return true;
    }

    public b8 validSoftBodyData(in SoftBodyComponent sb)const{
        if(!PhysicsRigBinaryCodec().validSoftBodyData(sb.softBody, true))
            return false;
        return this.validSoftBodyComponentExtras(sb);
    }

    public b8 validateSoftBody(in SoftBodyComponent sb, in Name virtualPath)const{
        if(this.validSoftBodyData(sb))
            return true;
        error("SoftBodyComponentAsset::validatePayload failed: invalid soft body config for '{}'", virtualPath.resolvedText());
        return false;
    }

    public b8 appendSoftBodyValidated(in SoftBodyComponent sb, mut Vector<u8> outBinary)const{
        static_assert(size_of<SoftBodyComponentBinary>() == 200u && offset_of<SoftBodyComponentBinary>(reserved1) == 198u);
        if(sb.attachmentBodyEntityNames.size() > cast<usize>(u32.max))
            return false;
        const PhysicsRigBinaryCodec rigCodec = PhysicsRigBinaryCodec();
        usize reqBytes = size_of<SoftBodyComponentBinary>();
        usize rigBytes = 0u;
        if(!rigCodec.softBodyPayloadBytes(sb.softBody, rigBytes))
            return false;
        if(
            rigBytes > cast<usize>(usize.max) - reqBytes
            || sb.attachmentBodyEntityNames.size() > cast<usize>(usize.max) / size_of<NameHash>()
        )
            return false;
        reqBytes += rigBytes;
        const usize attachBytes = sb.attachmentBodyEntityNames.size() * size_of<NameHash>();
        if(attachBytes > cast<usize>(usize.max) - reqBytes)
            return false;
        reqBytes += attachBytes;
        if(!CanAppendBytes(outBinary, reqBytes))
            return false;
        outBinary.reserve(outBinary.size() + reqBytes);

        SoftBodyComponentBinary hdr;
        hdr.collisionLayerHash = sb.collisionLayer.hash();
        hdr.softBodyAssetHash = sb.softBodyAsset.name().hash();
        hdr.materialAssetHash = sb.materialAsset.name().hash();
        hdr.attachmentBodyEntityNameCount = cast<u32>(sb.attachmentBodyEntityNames.size());
        if(sb.enabled) hdr.flags |= s_SoftBodyCompFlagEnabled;
        AppendPOD(outBinary, hdr);

        if(!rigCodec.appendSoftBodyPayload(sb.softBody, outBinary))
            return false;
        this.appendNameHashList(sb.attachmentBodyEntityNames, outBinary);
        return true;
    }

    public b8 serializeSoftBody(in SoftBodyComponent sb, mut Vector<u8> outPayload)const{
        if(!this.validSoftBodyData(sb))
            return false;
        outPayload.clear();
        return this.appendSoftBodyValidated(sb, outPayload);
    }

    public Expected<SoftBodyComponent> deserializeSoftBody(in Span<u8> payload)const{
        usize cursor = 0u;
        const Expected<SoftBodyComponentBinary> hdrRes = ReadPOD<SoftBodyComponentBinary>(payload, cursor);
        if(!hdrRes.has_value()){
            error("SoftBodyComponentAsset::loadComponentPayload failed: truncated header");
            return MakeUnexpected(Failure());
        }
        in SoftBodyComponentBinary hdr = hdrRes.value();
        if(hdr.reserved0 != 0u || hdr.reserved1 != 0u || (hdr.flags & ~s_SoftBodyCompAllFlagsMask) != 0u){
            error("SoftBodyComponentAsset::loadComponentPayload failed: unsupported flags or non-zero reserved bits");
            return MakeUnexpected(Failure());
        }
        const Expected<SoftBody> sbRes = PhysicsRigBinaryCodec().readSoftBodyPayload(payload, cursor, true);
        if(!sbRes.has_value()){
            error("SoftBodyComponentAsset::loadComponentPayload failed: invalid soft body payload");
            return MakeUnexpected(Failure());
        }
        SoftBodyComponent sb;
        sb.softBody = sbRes.value();
        sb.collisionLayer = DecodeOptionalPhysicsName(hdr.collisionLayerHash);
        sb.softBodyAsset.virtualPath = DecodeOptionalPhysicsName(hdr.softBodyAssetHash);
        sb.materialAsset.virtualPath = DecodeOptionalPhysicsName(hdr.materialAssetHash);
        sb.enabled = (hdr.flags & s_SoftBodyCompFlagEnabled) != 0u;
        sb.dirty = false;
        if(!this.readNameHashList(payload, hdr.attachmentBodyEntityNameCount, cursor, sb.attachmentBodyEntityNames)
            || cursor != payload.size()
            || !this.validSoftBodyComponentExtras(sb)){
            error("SoftBodyComponentAsset::loadComponentPayload failed: invalid trailing soft body component data");
            return MakeUnexpected(Failure());
        }
        return sb;
    }

    public b8 validFractureData(in FractureComponent fc)const{
        if(cast<u8>(fc.pattern) >= cast<u8>(FracturePatternType::kCount) || fc.chunkCount < 2u)
            return false;
        if(!PhysicsRigBinaryCodec().validFilter(fc.collisionFilter))
            return false;
        const PhysicsAssetBinaryCodec assetCodec = PhysicsAssetBinaryCodec();
        if(!assetCodec.validSurfaceMaterial(fc.material))
            return false;
        if(fc.useCustomHull && !assetCodec.validHullShapeData(fc.customHull))
            return false;
        if(!fc.customHull.vertices.empty() && !assetCodec.validHullShapeData(fc.customHull))
            return false;
        if(
            !IsFinite(VectorSingle(fc.boxHalfExtents))
            || !IsFinite(VectorSingle(fc.convexRadius, fc.bondStrengthPerArea, fc.impactDamageThreshold, fc.impactEnergyThreshold))
            || !IsFinite(VectorSingle(fc.damageRadius, fc.totalMass, fc.stressPropagationDecay, fc.gravityStressScale))
            || !IsFinite(VectorSingle(fc.outwardBurstScale, fc.minChunkVolumeRatio, fc.impactPointBias, fc.anchorBottomThreshold))
            || fc.boxHalfExtents.x <= 0.0f || fc.boxHalfExtents.y <= 0.0f || fc.boxHalfExtents.z <= 0.0f
            || fc.convexRadius < 0.0f
            || fc.bondStrengthPerArea < 0.0f
            || fc.impactDamageThreshold < 0.0f
            || fc.impactEnergyThreshold < 0.0f
            || fc.damageRadius < 0.0f
            || fc.totalMass <= 0.0f
            || fc.stressPropagationDecay < 0.0f || fc.stressPropagationDecay > 1.0f
            || fc.minChunkVolumeRatio < 0.0f || fc.minChunkVolumeRatio > 1.0f
            || fc.anchorBottomThreshold < 0.0f
        )
            return false;
        return true;
    }

    public b8 validateFracture(in FractureComponent fc, in Name virtualPath)const{
        if(this.validFractureData(fc))
            return true;
        error("FractureComponentAsset::validatePayload failed: invalid fracture config for '{}'", virtualPath.resolvedText());
        return false;
    }

    public b8 appendFractureValidated(in FractureComponent fc, mut Vector<u8> outBinary)const{
        static_assert(size_of<FractureComponentBinary>() == 400u && offset_of<FractureComponentBinary>(reserved2) == 392u);
        const PhysicsAssetBinaryCodec assetCodec = PhysicsAssetBinaryCodec();
        const PhysicsRigBinaryCodec rigCodec = PhysicsRigBinaryCodec();
        const b8 hasHull = fc.useCustomHull || !fc.customHull.vertices.empty();
        usize extraHullBytes = 0u;
        if(hasHull)
            extraHullBytes = assetCodec.convexHullSerializedBytes(fc.customHull);
        if(!CanAppendBytes(outBinary, size_of<FractureComponentBinary>() + extraHullBytes))
            return false;

        FractureComponentBinary bin;
        bin.boxHalfExtents = fc.boxHalfExtents;
        bin.material = assetCodec.packSurfaceMaterialFields(fc.material);
        bin.collisionLayerHash = fc.collisionLayer.hash();
        bin.materialAssetHash = fc.materialAsset.name().hash();
        bin.fractureAssetHash = fc.fractureAsset.name().hash();
        bin.collisionFilter = rigCodec.packFilter(fc.collisionFilter);
        bin.chunkCount = fc.chunkCount;
        bin.seed = fc.seed;
        bin.convexRadius = fc.convexRadius;
        bin.bondStrengthPerArea = fc.bondStrengthPerArea;
        bin.impactDamageThreshold = fc.impactDamageThreshold;
        bin.impactEnergyThreshold = fc.impactEnergyThreshold;
        bin.damageRadius = fc.damageRadius;
        bin.totalMass = fc.totalMass;
        bin.stressPropagationDecay = fc.stressPropagationDecay;
        bin.gravityStressScale = fc.gravityStressScale;
        bin.outwardBurstScale = fc.outwardBurstScale;
        bin.minChunkVolumeRatio = fc.minChunkVolumeRatio;
        bin.impactPointBias = fc.impactPointBias;
        bin.anchorBottomThreshold = fc.anchorBottomThreshold;
        bin.hierarchyLevel2SiteCount = fc.hierarchyLevel2SiteCount;
        bin.secondaryChunkCount = fc.secondaryChunkCount;
        bin.maxSecondaryFractureDepth = fc.maxSecondaryFractureDepth;
        bin.pattern = cast<u8>(fc.pattern);
        if(fc.useCustomHull) bin.flags |= s_FractureCompFlagUseCustomHull;
        if(fc.anchorBottomChunks) bin.flags |= s_FractureCompFlagAnchorBottomChunks;
        if(fc.autoFractureOnImpact) bin.flags |= s_FractureCompFlagAutoFractureOnImpact;
        if(fc.useHierarchyCollection) bin.flags |= s_FractureCompFlagUseHierarchyCollection;
        if(fc.allowSecondaryFracture) bin.flags |= s_FractureCompFlagAllowSecondaryFracture;
        if(fc.spawnDetachedChunkEntities) bin.flags |= s_FractureCompFlagSpawnDetachedChunkEntities;
        if(fc.generateChunkVisualMeshes) bin.flags |= s_FractureCompFlagGenerateChunkVisualMeshes;
        if(fc.enabled) bin.flags |= s_FractureCompFlagEnabled;
        if(hasHull) bin.flags |= s_FractureCompFlagHasCustomHullPayload;

        outBinary.reserve(outBinary.size() + size_of<FractureComponentBinary>() + extraHullBytes);
        AppendPOD(outBinary, bin);
        if(hasHull)
            return assetCodec.appendConvexHullBinary(fc.customHull, outBinary);
        return true;
    }

    public b8 serializeFracture(in FractureComponent fc, mut Vector<u8> outPayload)const{
        if(!this.validFractureData(fc))
            return false;
        outPayload.clear();
        return this.appendFractureValidated(fc, outPayload);
    }

    public Expected<FractureComponent> deserializeFracture(in Span<u8> payload)const{
        usize cursor = 0u;
        const Expected<FractureComponentBinary> binRes = ReadPOD<FractureComponentBinary>(payload, cursor);
        if(!binRes.has_value()){
            error("FractureComponentAsset::loadComponentPayload failed: truncated header");
            return MakeUnexpected(Failure());
        }
        in FractureComponentBinary bin = binRes.value();
        if(bin.reserved0 != 0u || bin.reserved1 != 0u || bin.reserved2 != 0u || (bin.flags & ~s_FractureCompAllFlagsMask) != 0u){
            error("FractureComponentAsset::loadComponentPayload failed: unsupported flags or non-zero reserved bits");
            return MakeUnexpected(Failure());
        }
        const PhysicsAssetBinaryCodec assetCodec = PhysicsAssetBinaryCodec();
        const Expected<SurfaceMaterial> matRes = assetCodec.unpackSurfaceMaterialFields(bin.material);
        const Expected<Filter> fltRes = PhysicsRigBinaryCodec().unpackFilter(bin.collisionFilter);
        if(!matRes.has_value() || !fltRes.has_value()){
            error("FractureComponentAsset::loadComponentPayload failed: invalid material or collision filter");
            return MakeUnexpected(Failure());
        }

        FractureComponent fc;
        fc.pattern = cast<FracturePatternType>(bin.pattern);
        fc.boxHalfExtents = bin.boxHalfExtents;
        fc.material = matRes.value();
        fc.collisionLayer = DecodeOptionalPhysicsName(bin.collisionLayerHash);
        fc.materialAsset.virtualPath = DecodeOptionalPhysicsName(bin.materialAssetHash);
        fc.fractureAsset.virtualPath = DecodeOptionalPhysicsName(bin.fractureAssetHash);
        fc.collisionFilter = fltRes.value();
        fc.chunkCount = bin.chunkCount;
        fc.seed = bin.seed;
        fc.convexRadius = bin.convexRadius;
        fc.bondStrengthPerArea = bin.bondStrengthPerArea;
        fc.impactDamageThreshold = bin.impactDamageThreshold;
        fc.impactEnergyThreshold = bin.impactEnergyThreshold;
        fc.damageRadius = bin.damageRadius;
        fc.totalMass = bin.totalMass;
        fc.stressPropagationDecay = bin.stressPropagationDecay;
        fc.gravityStressScale = bin.gravityStressScale;
        fc.outwardBurstScale = bin.outwardBurstScale;
        fc.minChunkVolumeRatio = bin.minChunkVolumeRatio;
        fc.impactPointBias = bin.impactPointBias;
        fc.anchorBottomThreshold = bin.anchorBottomThreshold;
        fc.hierarchyLevel2SiteCount = bin.hierarchyLevel2SiteCount;
        fc.secondaryChunkCount = bin.secondaryChunkCount;
        fc.maxSecondaryFractureDepth = bin.maxSecondaryFractureDepth;
        fc.useCustomHull = (bin.flags & s_FractureCompFlagUseCustomHull) != 0u;
        fc.anchorBottomChunks = (bin.flags & s_FractureCompFlagAnchorBottomChunks) != 0u;
        fc.autoFractureOnImpact = (bin.flags & s_FractureCompFlagAutoFractureOnImpact) != 0u;
        fc.useHierarchyCollection = (bin.flags & s_FractureCompFlagUseHierarchyCollection) != 0u;
        fc.allowSecondaryFracture = (bin.flags & s_FractureCompFlagAllowSecondaryFracture) != 0u;
        fc.spawnDetachedChunkEntities = (bin.flags & s_FractureCompFlagSpawnDetachedChunkEntities) != 0u;
        fc.generateChunkVisualMeshes = (bin.flags & s_FractureCompFlagGenerateChunkVisualMeshes) != 0u;
        fc.enabled = (bin.flags & s_FractureCompFlagEnabled) != 0u;
        if((bin.flags & s_FractureCompFlagHasCustomHullPayload) != 0u){
            const Expected<HullShape> hullRes = assetCodec.readConvexHullPayload(payload, cursor);
            if(!hullRes.has_value())
                return MakeUnexpected(Failure());
            fc.customHull = hullRes.value();
        }
        fc.dirty = true;
        fc.initialized = false;
        if(cursor != payload.size() || !this.validFractureData(fc)){
            error("FractureComponentAsset::loadComponentPayload failed: invalid fracture fields");
            return MakeUnexpected(Failure());
        }
        return fc;
    }

    public b8 validGpuRenderTransformExportData(in GpuRenderTransformExportComponent g)const{
        return IsFinite(VectorSingle(g.localScale))
            && cast<u32>(g.target) <= cast<u32>(GpuRenderTransformExportTarget::FractureBody);
    }

    public b8 validateGpuRenderTransformExport(in GpuRenderTransformExportComponent g, in Name virtualPath)const{
        if(this.validGpuRenderTransformExportData(g))
            return true;
        error("GpuRenderTransformExportComponentAsset::validatePayload failed: invalid export config for '{}'", virtualPath.resolvedText());
        return false;
    }

    public b8 appendGpuRenderTransformExportValidated(in GpuRenderTransformExportComponent g, mut Vector<u8> outBinary)const{
        static_assert(size_of<GpuRenderTransformExportComponentBinary>() == 48u && offset_of<GpuRenderTransformExportComponentBinary>(reserved3) == 40u);
        if(!CanAppendBytes(outBinary, size_of<GpuRenderTransformExportComponentBinary>()))
            return false;
        GpuRenderTransformExportComponentBinary bin;
        bin.localScale = g.localScale;
        bin.target = cast<u32>(g.target);
        bin.subTargetIndex = g.subTargetIndex;
        bin.instanceIndex = g.instanceIndex;
        bin.flags = g.flags;
        if(g.enabled)
            bin.enabledFlag = s_GpuExportFlagEnabled;
        else
            bin.enabledFlag = 0u;
        outBinary.reserve(outBinary.size() + size_of<GpuRenderTransformExportComponentBinary>());
        AppendPOD(outBinary, bin);
        return true;
    }

    public b8 serializeGpuRenderTransformExport(in GpuRenderTransformExportComponent g, mut Vector<u8> outPayload)const{
        if(!this.validGpuRenderTransformExportData(g))
            return false;
        outPayload.clear();
        return this.appendGpuRenderTransformExportValidated(g, outPayload);
    }

    public Expected<GpuRenderTransformExportComponent> deserializeGpuRenderTransformExport(in Span<u8> payload)const{
        usize cursor = 0u;
        const Expected<GpuRenderTransformExportComponentBinary> res = ReadPOD<GpuRenderTransformExportComponentBinary>(payload, cursor);
        if(!res.has_value() || cursor != payload.size()){
            error("GpuRenderTransformExportComponentAsset::loadComponentPayload failed: invalid payload size");
            return MakeUnexpected(Failure());
        }
        in GpuRenderTransformExportComponentBinary bin = res.value();
        if(bin.reserved0 != 0u || bin.reserved1 != 0u || bin.reserved2 != 0u || bin.reserved3 != 0u || (bin.enabledFlag & 0xfeu) != 0u){
            error("GpuRenderTransformExportComponentAsset::loadComponentPayload failed: unsupported flags or non-zero reserved bits");
            return MakeUnexpected(Failure());
        }
        GpuRenderTransformExportComponent g;
        g.localScale = bin.localScale;
        g.target = cast<GpuRenderTransformExportTarget>(bin.target);
        g.subTargetIndex = bin.subTargetIndex;
        g.instanceIndex = bin.instanceIndex;
        g.flags = bin.flags;
        g.enabled = (bin.enabledFlag & s_GpuExportFlagEnabled) != 0u;
        if(!this.validGpuRenderTransformExportData(g)){
            error("GpuRenderTransformExportComponentAsset::loadComponentPayload failed: invalid export fields");
            return MakeUnexpected(Failure());
        }
        return g;
    }
}


