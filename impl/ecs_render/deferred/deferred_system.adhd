#include <impl/ecs_render/deferred/deferred_frame_targets.adhd>
#include <impl/ecs_render/deferred/renderer_deferred_state.adhd>
#include <impl/ecs_render/shader/shader_system.adhd>
#include <impl/ecs_render/shared/frame_push_constants.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[modular]
class RendererDeferredSystem : NoCopy{
    private mut GlobalArena m_arena;
    private mut World m_world;
    private mut GraphicsRuntime m_graphics;
    private mut RendererDeferredState m_deferredState;
    private mut RendererShaderSystem m_shaderSystem;

    public RendererDeferredSystem(
        mut GlobalArena arena,
        mut World world,
        mut GraphicsRuntime graphics,
        mut RendererDeferredState deferredState,
        mut RendererShaderSystem shaderSystem
    ){
        this.m_arena = arena;
        this.m_world = world;
        this.m_graphics = graphics;
        this.m_deferredState = deferredState;
        this.m_shaderSystem = shaderSystem;
    }

    public DeferredLightingGraphResources lightingGraphResources()const{
        return DeferredLightingGraphResources(this.m_deferredState.m_sceneShadingBuffer, this.m_deferredState.m_lightBuffer);
    }

    public void invalidateSceneLightingUploadMirrors(){
        this.m_deferredState.m_sceneShadingGpuDataValid = false;
        this.m_deferredState.m_lightGpuDataValid = false;
    }

    public void invalidateResources(){
        this.m_deferredState.invalidateResources();
    }

    public b8 setPresentationSettings(in PresentationSettings settings);

    // Resolve immutable per-frame data; confirm CPU mirrors only after packet accepts.
    public SceneShadingBufferUploads prepareSceneShadingBufferUploads(in f32 fallbackAspectRatio, in RayTracingLightingClassificationInput rayTracingInput)const;
    public void confirmSceneShadingBufferUploads(in Span<SceneLightGpuData> lights, in b8 lightUploadRequired, in SceneShadingGpuData sceneShadingState, in b8 sceneShadingUploadRequired);
    public b8 createDeferredLightingResources();
    public b8 createDeferredLightingPipeline();
    public Expected<GpuTaskId> declareDeferredLightingTask(mut GpuTaskGraph graph, in GpuTaskDesc desc, in b8 useLaggedLightingHistory, mut DeferredFrameTargets targets, mut GpuTimingSubmissionTicket timingTicket);

    public b8 renderDeferredLighting(mut CommandList commandList, mut DeferredFrameTargets targets){
        return this.renderDeferredLighting(commandList, targets, false);
    }

    public b8 renderDeferredLighting(mut CommandList commandList, mut DeferredFrameTargets targets, in b8 useLaggedLightingHistory);
    public Expected<DeferredFrameTargets> createDeferredFrameTargets(in u32 width, in u32 height);
    public b8 createDeferredFrameTargetResources(mut DeferredFrameTargets targets, mut RhiSampler avboitLinearSampler);
    public b8 createDeferredCompositeResources();
    public b8 createDeferredCompositePipeline();
    public b8 createDeferredPresentPipeline(mut Framebuffer presentationFramebuffer);
    public void resetDeferredFrameTargets(mut DeferredFrameTargets targets);
    public Expected<GpuTaskId> declareDeferredCompositeTask(mut GpuTaskGraph graph, in GpuTaskDesc desc, in ReflectionCompositeInputs reflectionInputs, mut DeferredFrameTargets targets, mut GpuTimingSubmissionTicket timingTicket);
    public b8 renderDeferredComposite(mut CommandList commandList, mut DeferredFrameTargets targets, in ReflectionCompositeInputs reflectionInputs);
    public b8 renderDeferredPresent(mut CommandList commandList, mut DeferredFrameTargets targets, in AcquiredPresentationFrame presentationFrame, in GpuDescriptorHandle outputLayerImage);

    private b8 createDeferredBindlessFrameResources(mut DeferredFrameTargets targets, mut RhiSampler avboitLinearSampler);
    private void resetDeferredBindlessFrameResources(mut DeferredFrameTargets targets);
    private void resetLaggedLightingHistoryResources(mut DeferredFrameTargets targets);
    private b8 createLaggedLightingHistoryResources(mut DeferredFrameTargets targets);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

