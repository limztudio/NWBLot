}

[[nodiscard]] FOUNDATION_INLINE u64 KernelSkippedScopeCount(const KernelGpuTimingRecorderStatistics& statistics, const usize reasonIndex)noexcept{
    return statistics.skippedScopeCountByReason[reasonIndex];
}

[[nodiscard]] FOUNDATION_INLINE KernelGpuPhysicalQueueTopology QueryKernelPhysicalQueueTopology(const KernelGraphicsRuntime& graphics)noexcept{
