const StringView s_UiNumericEditDecimalKey = "decimal";
const u64 s_UiPaintGlyphDefaultAtlasIdentity = 11u;

enum<u8> UiNumericSelectionEpochMutation{ SelectionRoundTrip, SameSelection, CompositionRoundTrip }


