#include <impl/ecs_render/renderer_frame_pipeline.adhd>
#include <impl/ecs_render/raytrace/graph_snapshots.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class FrameExecuteCpuSnapshot{
    public RayTracingFrameCpuStateSnapshot rayTracing;
    public b8 avboitTargetsNeedClear = false;
    public b8 deferredBindlessSlotsUploaded = false;
}


// Recovers a partly accepted deferred frame: runs the graph-owned recovery packet, then rejects the remaining normal packets.
[modular]
class FrameExecuteRecovery : NoCopy{
    private mut RendererFramePipeline m_renderer;
    private mut GpuTimingFrameTransaction m_frameTimingTransaction;
    private in GpuCompiledGraphReadView m_compiledPlan;

    public FrameExecuteRecovery(
        mut RendererFramePipeline renderer,
        mut GpuTimingFrameTransaction frameTimingTransaction,
        in GpuCompiledGraphReadView compiledPlan
    ){
        this.m_renderer = renderer;
        this.m_frameTimingTransaction = frameTimingTransaction;
        this.m_compiledPlan = compiledPlan;
    }

    public b8 discardUnacceptedGraphPackets();
    public b8 executeFrameRecoveryTask();
    public b8 recoverPendingFrameSubmission();
    public b8 recoverPendingFrameThenDiscardUnaccepted();
    public void failFrameRenderRecovery();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

