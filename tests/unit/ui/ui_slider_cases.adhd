}

void VerifyUiSliderBuilderTests_DisabledSliderKeepsAPointerBarrierWithoutApplyingQueuedInput(mut UiSliderBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    self.press(UiSliderKey::Tab);
    self.press(UiSliderKey::Right);
    SliderOptions disabled = MakeSliderFixtureOptions();
    disabled.enabled = false;
    ASSERT_TRUE(self.accept(2u, disabled));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.25);
    EXPECT_FALSE(self.m_state.result().valueChanged);
    native(in self){
        ASSERT_NE(self.target(self.host()), nullptr);
        EXPECT_FALSE(self.target(self.host())->enabled);
        EXPECT_FALSE(self.target(self.host())->focusable);
    }
    const Point center = CenterUiRect(self.m_state.placement().bounds);
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(center, InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(center, InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_FALSE(self.m_context.input().focus().valid());
    ASSERT_TRUE(self.accept(3u, disabled));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.25);
}

void VerifyUiSliderBuilderTests_ConstantRangeIsValidAndNoninteractiveWithoutRewritingTheApplicationValue(mut UiSliderBuilderTests self){
