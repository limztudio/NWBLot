// CPU mirror of NwbShadowResolvePushConstants.
[serialize]
class ShadowResolvePushConstants{
    public u32 width = 0u;
    public u32 height = 0u;
    public u32 halfWidth = 0u;
    public u32 halfHeight = 0u;
    public u32 stepWidth = 1u;
    public u32 stage = 1u;
    public u32 lightSlotStart = 0u;
    public u32 lightSlotCount = 0u;
    public u32 momentsValid = 0u;
    public u32 upsampleFold = 0u;
    public u32 geometrySlot = 0u;
    public u32 depthSlot = 0u;
    public u32 worldPositionSlot = 0u;
    public u32 normalSlot = 0u;
    public u32 inputColorSlot = 0u;
    public u32 momentsSlot = 0u;
    public u32 outputStorageSlot = 0u;
    public u32 visibilityStorageSlot = 0u;
    public u32 sceneShadingSlot = 0u;
    public u32 opaqueInputColorSlot = 0u;
    public u32 receiverFactor = s_ShadowReceiverFactorHalf;
}

// The combined wavelet extends the shared resolve ABI with opaque moments and output.
[serialize]
class ShadowCombinedWaveletPushConstants{
    public ShadowResolvePushConstants resolve;
    public u32 opaqueMomentsSlot = 0u;
    public u32 opaqueMomentsValid = 0u;
    public u32 opaqueOutputStorageSlot = 0u;
}

