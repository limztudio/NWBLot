#include <pipeline/volume_workspace.adhd>
#include "constants.adhd"
#include "gather_input_discovery.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace_wrapper NWB_ASSET_GATHERER;

class AssetGatherOptions{
    public Vector<String> inputs;
    public String outputDirectory;
    public CompactString configuration;
    public GatherMergeCallback mergePayloads;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void LogConflictingBuiltAssetIdentity(in Name virtualPath){
    error("AssetGatherer: conflicting built asset identity '{}'", virtualPath.resolvedText());
}

void LogGatherOutputResolveFailure(in StringView outputDirectory){
    error("AssetGatherer: failed to resolve output '{}'", outputDirectory);
}

void LogAssetsGathered(in u64 fileCount, in StringView outputDirectory){
    [essential] info("AssetGatherer: gathered {} assets into '{}'", fileCount, outputDirectory);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<Vector<String>> CollectGatherInputFiles(in AssetGatherOptions options){
    Vector<String> files;
    files.reserve(options.inputs.size());
    for(in String input : options.inputs){
        const auto absolute = AbsolutePath(Path(StringView(input)));
        if(!absolute.has_value()){
            LogGatherInputResolveFailure(input);
            return MakeUnexpected(Failure());
        }
        const Path path = absolute.value().lexicallyNormal();
        const auto directory = IsDirectory(path);
        if(!directory.has_value()){
            LogGatherInputInspectFailure(input);
            return MakeUnexpected(Failure());
        }
        if(!directory.value()){
            files.push_back(PathToString(path));
            continue;
        }
        const Path manifest = path / s_BuiltAssetManifestFilename;
        const auto exists = FileExists(manifest);
        if(!exists.has_value()){
            LogGatherBuildManifestInspectFailure(PathToString(manifest));
            return MakeUnexpected(Failure());
        }
        if(exists.value()){
            if(!ReadAssetInputPaths(manifest, files, true))
                return MakeUnexpected(Failure());
            continue;
        }
        const auto entries = RecursiveDirectoryIteratorCreate(path);
        if(!entries.has_value()){
            LogGatherInputScanFailure(input);
            return MakeUnexpected(Failure());
        }
        for(in DirectoryEntry entry : entries.value()){
            const auto regular = entry.isRegularFile();
            if(!regular.has_value()){
                LogGatherInputEntryInspectFailure(PathToString(entry.path()));
                return MakeUnexpected(Failure());
            }
            if(regular.value() && PathToString(entry.path().extension()) == s_BuiltAssetExtension)
                files.push_back(PathToString(entry.path()));
        }
    }
    SortUniqueSequence<String>(files);
    return files;
}

b8 GatherAssets(in AssetGatherOptions options){
    if(!ValidateAssetGathererOutputDirectory(!options.outputDirectory.empty()))
        return false;
    const auto files = CollectGatherInputFiles(options);
    if(!files.has_value())
        return false;
    AssetCookWorkspace workspace(s_AssetGathererArena);
    CookVolumeManifest volume(workspace);
    if(!volume.reserve(cast<u64>(files.value().size())))
        return false;
    HashMap<Name, usize> indices;
    indices.reserve(files.value().size());
    for(in String file : files.value()){
        const auto builtCount = volume.readBuiltAsset(Path(StringView(file)));
        if(!builtCount.has_value())
            return false;
        for(usize entryIndex = 0u; entryIndex < builtCount.value(); ++entryIndex){
            const BuiltAssetPayload built = volume.builtEntry(entryIndex);
            const Name path = built.virtualPath;
            const Span<u8> bytes = volume.sourceBytes(built.payloadOffset, built.payloadSize);
            const auto inserted = indices.try_emplace(path, volume.manifest.entries.size());
            if(!inserted.second){
                mut CookPackEntry existing = volume.manifest.entries[inserted.first.value()];
                if(!AreGatheredAssetPayloadsIdentical(existing.payloadBytes, bytes)){
                    if(!options.mergePayloads.apply(path, bytes, workspace, existing.payloadBytes)){
                        LogConflictingBuiltAssetIdentity(path);
                        return false;
                    }
                    existing.identity.payloadSize = existing.payloadBytes.size();
                    existing.identity.payloadHash = ComputeGatheredPayloadHash(existing.payloadBytes);
                }
            }
            else if(!volume.append(path, bytes))
                return false;
        }
    }
    volume.manifest.plannedFileCount = cast<u64>(volume.manifest.entries.size());
    const auto output = AbsolutePath(Path(StringView(options.outputDirectory)));
    if(!output.has_value()){
        LogGatherOutputResolveFailure(options.outputDirectory);
        return false;
    }
    const String configuration = ResolveEffectiveGatherConfiguration(options.configuration.view());
    const auto written = volume.writeVolume(output.value().lexicallyNormal(), configuration);
    if(!written.has_value())
        return false;
    LogAssetsGathered(written.value().fileCount, options.outputDirectory);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

