[cpp_header("<core/assets/volume/pack_manifest.h>"), cpp_name("::NWB::Core::Assets::AssetsVolumeCookDetail::AssetVolumePayloadIdentity")]
extern class CookPayloadIdentity{
    u64 payloadSize;
    u64 payloadHash;
    u64 cookKeyHash;
};

[cpp_header("<core/assets/volume/pack_manifest.h>"), cpp_name("::NWB::Core::Assets::AssetsVolumeCookDetail::AssetVolumePackEntry")]
extern class CookPackEntry{
    Name virtualPath;
    CookPayloadIdentity identity;
    Vector<u8> payloadBytes;
};

[cpp_header("<core/assets/volume/pack_manifest.h>"), cpp_name("::NWB::Core::Assets::AssetsVolumeCookDetail::AssetVolumePackManifest")]
extern class CookPackManifest{
    Vector<CookPackEntry> entries;
    u64 plannedFileCount;
};

[cpp_header("<core/assets/volume/built_asset.h>"), cpp_name("::NWB::Core::Assets::BuiltAssetDetail::BuiltAssetPayload"), cpp_flags(small_value, brace_init)]
extern class BuiltAssetPayload{
    Name virtualPath;
    usize payloadOffset;
    usize payloadSize;
};

[cpp_header("<core/assets/volume/cook_types.h>"), cpp_name("::NWB::Core::Assets::AssetsVolumeCookDetail::AssetVolumeWriteResult")]
extern class CookVolumeWriteResult{
    u64 fileCount;
};

[cpp_header("<pipeline/volume_workspace.h>"), cpp_name("::NWB::Pipeline::CookVolumeManifest"), cpp_flags(no_copy, no_assign)]
extern class CookVolumeManifest{
    CookPackManifest manifest;
    b8 reserve(in u64 count);
    b8 append(in Name path, in Span<u8> bytes);
    Expected<usize> readBuiltAsset(in Path file);
    BuiltAssetPayload builtEntry(in usize index)const;
    Span<u8> sourceBytes(in usize offset, in usize size)const;
    Expected<CookVolumeWriteResult> writeVolume(in Path output, in StringView configuration)const;
    b8 writeBuiltAssets(in Path output)const;
};

[cpp_header("<core/assets/volume/built_asset.h>"), cpp_name("::NWB::Core::Assets::BuiltAssetDetail::s_ManifestFilename")]
extern const StringView s_BuiltAssetManifestFilename;
[cpp_header("<core/assets/volume/built_asset.h>"), cpp_name("::NWB::Core::Assets::BuiltAssetDetail::s_Extension")]
extern const StringView s_BuiltAssetExtension;
[cpp_header("<core/assets/volume/cook_types.h>"), cpp_name("::NWB::Core::Assets::AssetsVolumeCookDetail::s_AssetVolumeName")]
extern const StringView s_CookAssetVolumeName;

[cpp_header("<pipeline/volume_workspace.h>"), cpp_name("::NWB::Pipeline::CookVolumePreparation"), cpp_flags(no_copy, no_assign)]
extern class CookVolumePreparation{
    u64 plannedFileCount;
    b8 registerEntryTypes();
    b8 parse(mut CpuTaskScheduler scheduler);
    void setConfiguration(in StringView value);
    b8 registerPreparers();
    usize entryCount()const;
    u64 cachedEntryCount()const;
    void reservePaths(in usize count);
    b8 seedCachedPaths();
    usize writerCount()const;
    b8 writeManifest(in usize index, mut CookVolumeManifest volume);
    b8 writeRegistryObjects(mut CpuTaskScheduler scheduler, mut CookVolumeManifest volume);
    b8 writeBuiltAssets(in Path output, in CookVolumeManifest volume)const;
};


