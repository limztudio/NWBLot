////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_csg/shape_module_source.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CsgShapeCookEntry{
    public Name shapeName = s_NameNone;
    public Name shaderModule = s_NameNone;
    public u32 shapeTypeId = 0u;
    public String evalInclude;
    public String moduleInclude;
}

type CsgShapeCookEntryVector = Vector<CsgShapeCookEntry>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 HasNonEmptyCsgMetadataText(in StringView text){
    return !TrimView(text).empty();
}

b8 HasCsgBackslashPathSeparator(in StringView includePath){
    for(usize i = 0u; i < includePath.size(); ++i){
        if(includePath[i] == '\\')
            return true;
    }
    return false;
}

b8 IsSharedCsgGeneratedIncludeConflict(in b8 inserted, in Name existingModule, in Name currentModule){
    return !inserted && existingModule != currentModule;
}

b8 ValidateCsgNonEmptyMetadataField(in Path nwbFilePath, in StringView fieldName, in StringView text){
    if(HasNonEmptyCsgMetadataText(text))
        return true;

    error("{} '{}': field '{}' must not be empty", s_CsgShapeMetaDiagnosticPrefix, nwbFilePath, fieldName);
    return false;
}

b8 ValidateCsgIncludePath(in Path nwbFilePath, in StringView fieldName, in StringView includePath, in b8 isAbsoluteOrEmpty, in b8 isCleanRelative){
    if(includePath.empty()){
        error("{} '{}': field '{}' must not be empty", s_CsgShapeMetaDiagnosticPrefix, nwbFilePath, fieldName);
        return false;
    }
    if(HasCsgBackslashPathSeparator(includePath)){
        error("{} '{}': field '{}' must use '/' path separators", s_CsgShapeMetaDiagnosticPrefix, nwbFilePath, fieldName);
        return false;
    }
    if(isAbsoluteOrEmpty){
        error("{} '{}': field '{}' must be a relative include path", s_CsgShapeMetaDiagnosticPrefix, nwbFilePath, fieldName);
        return false;
    }
    if(!isCleanRelative){
        error("{} '{}': field '{}' has invalid include path '{}'", s_CsgShapeMetaDiagnosticPrefix, nwbFilePath, fieldName, includePath);
        return false;
    }
    return true;
}

b8 ValidateCsgSlangIncludeExtension(in Path nwbFilePath, in StringView fieldName, in b8 hasSlangIncludeExtension){
    if(hasSlangIncludeExtension)
        return true;

    error("{} '{}': field '{}' must reference a .slangi file", s_CsgShapeMetaDiagnosticPrefix, nwbFilePath, fieldName);
    return false;
}

b8 ValidateCsgReservedVirtualRoot(in Path nwbFilePath, in StringView fieldName, in b8 hasReservedVirtualRoot){
    if(hasReservedVirtualRoot)
        return true;

    error("{} '{}': field '{}' must be a project/- or engine/-rooted virtual path (e.g. 'engine/csg/box/eval.slangi')", s_CsgShapeMetaDiagnosticPrefix, nwbFilePath, fieldName);
    return false;
}

Expected<StringView> ParseCsgStringField(in Path nwbFilePath, in MetascriptValue asset, in StringView fieldName, in b8 required){
    const Expected<MetadataStringField> textResult = ReadMetadataStringField(nwbFilePath, asset, s_CsgShapeMetaDiagnosticPrefix, fieldName, required);
    if(!textResult.has_value())
        return MakeUnexpected(Failure());
    if(!textResult.value().present)
        return StringView();
    if(!ValidateCsgNonEmptyMetadataField(nwbFilePath, fieldName, textResult.value().text))
        return MakeUnexpected(Failure());
    return textResult.value().text;
}

b8 ValidateCsgIncludePathValue(in Path nwbFilePath, in StringView fieldName, in StringView includePath){
    const Path includePathValue = Path(includePath);
    return ValidateCsgIncludePath(
        nwbFilePath,
        fieldName,
        includePath,
        includePathValue.isAbsolute() || includePathValue.empty(),
        IsRelativeSlashPathWithoutDotSegments(includePath)
    );
}

b8 HasCsgSlangIncludeExtension(in StringView includePath){
    const Path includePathValue = Path(includePath);
    Array<StringView, 1u> slangIncludeExtensions;
    slangIncludeExtensions[0u] = s_CsgSlangIncludeExtension;
    return PathHasListedExtension(includePathValue, slangIncludeExtensions);
}

b8 ValidateCsgReservedVirtualRootPath(in Path nwbFilePath, in StringView fieldName, in StringView includePath){
    return ValidateCsgReservedVirtualRoot(nwbFilePath, fieldName, HasReservedAssetVirtualRoot(includePath));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ReadCsgShapeMetadata(in Path file, in MetascriptValue asset, mut CsgShapeCookEntry entry){
    if(!ValidateMetadataAssetFields(file, asset, s_CsgShapeMetaDiagnosticPrefix, IsAllowedCsgShapeAssetField))
        return false;
    const auto shape = ReadMetadataNameField(file, asset, s_CsgShapeMetaDiagnosticPrefix, s_CsgShapeField, true);
    const auto module = ReadMetadataNameField(file, asset, s_CsgShapeMetaDiagnosticPrefix, s_CsgModuleField, true);
    if(!shape.has_value() || !module.has_value())
        return false;
    entry.shapeName = shape.value();
    entry.shaderModule = module.value();
    const auto eval = ParseCsgStringField(file, asset, s_CsgEvalField, true);
    const auto moduleInclude = ParseCsgStringField(file, asset, s_CsgModuleIncludeField, false);
    if(!eval.has_value() || !moduleInclude.has_value())
        return false;
    entry.evalInclude = eval.value();
    entry.moduleInclude = moduleInclude.value();
    if(entry.moduleInclude.empty()){
        const String safeModuleName = BuildCanonicalSafeCacheName(entry.shaderModule.resolvedText());
        const auto generated = CsgShapeModuleSource().buildDefaultPath(entry.shaderModule, safeModuleName);
        if(!generated.has_value()){
            error("CSG shape meta '{}': failed to build generated module include for '{}'", file, entry.shaderModule.resolvedText());
            return false;
        }
        entry.moduleInclude = generated.value();
    }
    return ValidateCsgIncludePathValue(file, s_CsgEvalField, entry.evalInclude)
        && ValidateCsgIncludePathValue(file, s_CsgModuleIncludeField, entry.moduleInclude)
        && ValidateCsgSlangIncludeExtension(file, s_CsgEvalField, HasCsgSlangIncludeExtension(entry.evalInclude))
        && ValidateCsgSlangIncludeExtension(file, s_CsgModuleIncludeField, HasCsgSlangIncludeExtension(entry.moduleInclude))
        && ValidateCsgReservedVirtualRootPath(file, s_CsgEvalField, entry.evalInclude)
        && ValidateCsgReservedVirtualRootPath(file, s_CsgModuleIncludeField, entry.moduleInclude);
}

Expected<CsgShapeCookEntry> ParseCsgShapeCookMetadata(in Path file, in MetascriptDocument doc){
    CsgShapeCookEntry entry;
    if(!VisitMetadataAssetMap(file, doc, s_CsgShapeMetaDiagnosticPrefix, lambda[in file, mut entry](in MetascriptValue value) -> b8{
        return ReadCsgShapeMetadata(file, value, entry);
    }))
        return MakeUnexpected(Failure());
    return entry;
}

b8 AssignCsgShapeCookIds(mut CsgShapeCookEntryVector entries){
    SortSequence<CsgShapeCookEntry>(entries, lambda[](in CsgShapeCookEntry lhs, in CsgShapeCookEntry rhs) -> b8{
        return IsBeforeCsgShapeCookName(lhs.shapeName, rhs.shapeName);
    });
    HashMap<CsgShapeTypeId, Name> names;
    names.reserve(entries.size());
    for(usize index = 0u; index < entries.size(); ++index){
        const Expected<CsgShapeTypeId> shapeTypeId = ResolveAndCheckCsgShapeTypeIdCollision(index, entries[index].shapeName, names);
        if(!shapeTypeId.has_value())
            return false;
        entries[index].shapeTypeId = shapeTypeId.value();
    }
    return true;
}


