native{
#include <impl/assets_graphics/deferred_subsystem.adhd.h>
#include <impl/assets_graphics/components.adhd.h>
#include <impl/assets_scene/asset.adhd.h>
#include <impl/assets_shader/loader.adhd.h>

#include <core/assets/global.h>
#include <core/graphics/rhi/shader.h>
#include <core/graphics/shader_archive.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_CORE_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class GraphicsRuntime;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_CORE_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_ASSETS_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class AssetManager;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_ASSETS_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


inline constexpr TStringView s_RendererAssetOwnerName = FOUNDATION_TEXT("RendererSystem");

using RendererShaderPathResolveCallback = Function< Expected<Name>(const Name& shaderName, AStringView variantName, const Name& stageName) >;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererShaderSystem final : NoCopy{
public:
    RendererShaderSystem(Core::GraphicsRuntime& graphics, Core::Assets::AssetManager& assetManager, RendererShaderPathResolveCallback& shaderPathResolver)noexcept
        : m_graphics(graphics)
        , m_assetManager(assetManager)
        , m_shaderPathResolver(shaderPathResolver)
    {}


public:
    void setActiveSceneSubsystems(const ActiveSceneSubsystems* subsystems)noexcept{ m_activeSceneSubsystems = subsystems; }

    template<typename SubsystemT>
    [[nodiscard]] const SubsystemT* findSubsystem()const noexcept{
        return m_activeSceneSubsystems ? m_activeSceneSubsystems->findSubsystem<SubsystemT>() : nullptr;
    }

    template<typename SubsystemT, typename TAsset>
    [[nodiscard]] Name resolveSubsystemAsset(const Core::Assets::AssetRef<TAsset> SubsystemT::* member)const noexcept{
        const SubsystemT* const subsystem = findSubsystem<SubsystemT>();
        if(!subsystem)
            return s_NameNone;
        const Core::Assets::AssetRef<TAsset>& ref = subsystem->*member;
        return ref.valid() ? ref.name() : s_NameNone;
    }

    void invalidateResources()noexcept{ m_deferredCompositeVertexShader.reset(); }
    template<typename TShader, typename SubsystemT>
        requires(IsBaseOf_V<IShader, TShader> && requires{ TShader::s_Stage; })
    [[nodiscard]] b8 loadShader(const Core::Assets::AssetRef<TShader> SubsystemT::* member, const AStringView variantName, const Name& debugName, Core::ShaderHandle& outShader){
        return loadShader<TShader>(member, variantName, debugName, nullptr, outShader);
    }
    template<typename TShader, typename SubsystemT>
        requires(IsBaseOf_V<IShader, TShader> && requires{ TShader::s_Stage; })
    [[nodiscard]] b8 loadShader(const Core::Assets::AssetRef<TShader> SubsystemT::* member, const AStringView variantName, const Name& debugName, const Name* archiveStageName, Core::ShaderHandle& outShader){
        static_assert(Core::ShaderType::IsValid(TShader::s_Stage));
        const Name resolvedShaderName = resolveSubsystemAsset<SubsystemT>(member);
        if(!resolvedShaderName)
            return false;
        return loadShader<TShader>(resolvedShaderName, variantName, debugName, archiveStageName, outShader);
    }
    template<typename TShader>
        requires(IsBaseOf_V<IShader, TShader> && requires{ TShader::s_Stage; })
    [[nodiscard]] b8 loadShader(const Name& shaderAssetName, const AStringView variantName, const Name& debugName, Core::ShaderHandle& outShader){
        return loadShader<TShader>(shaderAssetName, variantName, debugName, nullptr, outShader);
    }
    template<typename TShader>
        requires(IsBaseOf_V<IShader, TShader> && requires{ TShader::s_Stage; })
    [[nodiscard]] b8 loadShader(const Name& shaderAssetName, const AStringView variantName, const Name& debugName, const Name* archiveStageName, Core::ShaderHandle& outShader){
        static_assert(Core::ShaderType::IsValid(TShader::s_Stage));
        return ShaderAssetLoader::Load<TShader>(shaderAssetName, variantName, debugName, s_RendererAssetOwnerName, m_graphics, m_assetManager, m_shaderPathResolver, archiveStageName, outShader);
    }

    [[nodiscard]] b8 hasShaderArchiveStage(const Name& shaderAssetName, const AStringView variantName, const Name& stageName)const{
        return m_shaderPathResolver(shaderAssetName, variantName, stageName).has_value();
    }
    [[nodiscard]] b8 loadDeferredCompositeVertexShader(){
        return loadShader<VertexShader>(&DeferredSubsystem::compositeVs, Core::ShaderArchive::s_DefaultVariant, "ECSRender_DeferredCompositeVS", m_deferredCompositeVertexShader);
    }
    [[nodiscard]] const Core::ShaderHandle& deferredCompositeVertexShader()const noexcept{ return m_deferredCompositeVertexShader; }


private:
    Core::GraphicsRuntime& m_graphics;
    Core::Assets::AssetManager& m_assetManager;
    RendererShaderPathResolveCallback& m_shaderPathResolver;
    const ActiveSceneSubsystems* m_activeSceneSubsystems = nullptr;
    Core::ShaderHandle m_deferredCompositeVertexShader;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ImplEcsRenderShaderShaderSystemAdhdModule(in u64 value){
    return value != 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
