#include <impl/ecs_ui/toolkit/text/layout_clusters.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 FitsTextCoordinates(in VectorDouble values){
    if(!IsFinite(values))
        return false;
    const VectorDouble magnitude = Abs(values);
    return
        magnitude.x <= s_TextMaxCoordinateF64
        && magnitude.y <= s_TextMaxCoordinateF64
        && magnitude.z <= s_TextMaxCoordinateF64
        && magnitude.w <= s_TextMaxCoordinateF64
    ;
}

TextGlyphIntersection TryIntersectTextBounds(in f64 minX, in f64 minY, in f64 maxX, in f64 maxY, in Rect clip){
    if(!FitsTextCoordinates(VectorDouble(minX, minY, maxX, maxY)) || maxX < minX || maxY < minY)
        return TextGlyphIntersection::Invalid;
    const VectorDouble minVec(minX, minY, minX, minY);
    const VectorDouble maxVec(maxX, maxY, maxX, maxY);
    const VectorDouble extent = maxVec - minVec;
    if(extent.x > s_TextMaxCoordinateF64 || extent.y > s_TextMaxCoordinateF64)
        return TextGlyphIntersection::Invalid;
    const VectorDouble clipOrigin(cast<f64>(clip.x), cast<f64>(clip.y), cast<f64>(clip.x), cast<f64>(clip.y));
    if(maxX <= minX || maxY <= minY || clip.width <= 0.0f || clip.height <= 0.0f || maxX <= clipOrigin.x || maxY <= clipOrigin.y)
        return TextGlyphIntersection::Invisible;
    const VectorDouble clipEnd = clipOrigin + VectorDouble(cast<f64>(clip.width), cast<f64>(clip.height), cast<f64>(clip.width), cast<f64>(clip.height));
    if(minX >= clipEnd.x || minY >= clipEnd.y)
        return TextGlyphIntersection::Invisible;
    return TextGlyphIntersection::Visible;
}

TextGlyphIntersection TryIntersectTextRects(in Rect rectangle, in Rect clip){
    if(!IsValidUiRect(rectangle) || !IsValidUiRect(clip))
        return TextGlyphIntersection::Invalid;
    const VectorDouble minVec(cast<f64>(rectangle.x), cast<f64>(rectangle.y), 0.0, 0.0);
    const VectorDouble maxVec = minVec + VectorDouble(cast<f64>(rectangle.width), cast<f64>(rectangle.height), 0.0, 0.0);
    return TryIntersectTextBounds(minVec.x, minVec.y, maxVec.x, maxVec.y, clip);
}

Point ResolveLabelPaintOrigin(in Rect bounds, in Rect measured){
    const VectorSingle origin = VectorSingle(bounds.x, bounds.y, bounds.x, bounds.y) - VectorSingle(measured.x, measured.y, measured.x, measured.y);
    return Point(origin.x, origin.y);
}

b8 IsValidTextGlyphLocation(in Point glyphPosition, in Point topLeft){
    return IsFinite(VectorSingle(glyphPosition.x, glyphPosition.y, topLeft.x, topLeft.y));
}

Expected<VectorDouble> TryLoadGlyphAtlasRectangle(
    in Point glyphPosition,
    in Point topLeft,
    in f32 fontSize,
    in u32 unitsPerEm,
    in FontAtlasGlyph record
){
    if(!IsValidTextGlyphLocation(glyphPosition, topLeft) || !IsValidTextFontSize(fontSize) || unitsPerEm == 0u)
        return MakeUnexpected(Failure());
    if(record.drawable == 0u)
        return VectorDouble(0.0, 0.0, 0.0, 0.0);
    if(
        !IsFinite(VectorSingle(record.planeLeft, record.planeTop, record.planeRight, record.planeBottom))
        || record.planeRight <= record.planeLeft || record.planeBottom <= record.planeTop
    )
        return MakeUnexpected(Failure());
    const VectorDouble scaleVec(cast<f64>(fontSize) / cast<f64>(unitsPerEm));
    const VectorDouble origin = VectorDouble(cast<f64>(topLeft.x), cast<f64>(topLeft.y), 0.0, 0.0) + VectorDouble(cast<f64>(glyphPosition.x), cast<f64>(glyphPosition.y), 0.0, 0.0);
    const VectorDouble planeOrigin(cast<f64>(record.planeLeft), cast<f64>(record.planeTop), 0.0, 0.0);
    const VectorDouble scaledPlaneOrigin = planeOrigin * scaleVec;
    const VectorDouble xy = origin + scaledPlaneOrigin;
    const VectorDouble planeExtent = VectorDouble(cast<f64>(record.planeRight), cast<f64>(record.planeBottom), 0.0, 0.0) - planeOrigin;
    const VectorDouble wh = planeExtent * scaleVec;
    const VectorDouble candidate(xy.x, xy.y, wh.x, wh.y);
    if(!FitsTextCoordinates(candidate) || wh.x < 0.0 || wh.y < 0.0)
        return MakeUnexpected(Failure());
    if(!FitsTextCoordinate(xy.x + wh.x) || !FitsTextCoordinate(xy.y + wh.y))
        return MakeUnexpected(Failure());
    const VectorSingle rounded(cast<f32>(xy.x), cast<f32>(xy.y), cast<f32>(wh.x), cast<f32>(wh.y));
    if(!IsFinite(rounded) || !(IsFinite(rounded.x + rounded.z) && IsFinite(rounded.y + rounded.w)))
        return MakeUnexpected(Failure());
    return VectorDouble(rounded);
}

TextGlyphIntersection IntersectTextCoverageInk(
    in Point glyphPosition,
    in Point topLeft,
    in Rect ink,
    in b8 coverageKnown,
    in u32 unitsPerEm,
    in f32 fontSize,
    in f32 physicalSize,
    in Rect clip,
    in Point pixelScale
){
    const f64 fontSizeF64 = cast<f64>(fontSize);
    const f64 shapedSize = Floor((fontSizeF64 * s_TextFixedPointScaleF64) + s_TextHalfPixel) / s_TextFixedPointScaleF64;
    f64 correctionScalar = 1.0;
    if(!coverageKnown)
        correctionScalar = fontSizeF64 / shapedSize;
    const f64 rasterScale = cast<f64>(physicalSize) / fontSizeF64;
    f64 outlineAllowance = 0.0;
    if(!coverageKnown)
        outlineAllowance = fontSizeF64 / cast<f64>(unitsPerEm);
    // Native outline bounds include their design-unit allowance; keep raster rounding and physical-pixel snapping conservative.
    const f64 rasterMarginScalar = ((Max(1.0, correctionScalar) / s_TextFixedPointScaleF64) + (s_TextRasterMarginPixels / rasterScale)) + outlineAllowance;
    const VectorDouble margin = VectorDouble(rasterMarginScalar) + (VectorDouble(s_TextHalfPixel) / VectorDouble(cast<f64>(pixelScale.x), cast<f64>(pixelScale.y), cast<f64>(pixelScale.x), cast<f64>(pixelScale.y)));
    const VectorDouble inkOrigin(cast<f64>(ink.x), cast<f64>(ink.y), cast<f64>(ink.x), cast<f64>(ink.y));
    const VectorDouble inkEnd = inkOrigin + VectorDouble(cast<f64>(ink.width), cast<f64>(ink.height), cast<f64>(ink.width), cast<f64>(ink.height));
    const VectorDouble pos = VectorDouble(cast<f64>(topLeft.x), cast<f64>(topLeft.y), cast<f64>(topLeft.x), cast<f64>(topLeft.y)) + VectorDouble(cast<f64>(glyphPosition.x), cast<f64>(glyphPosition.y), cast<f64>(glyphPosition.x), cast<f64>(glyphPosition.y));
    const VectorDouble correctedOrigin = inkOrigin * correctionScalar;
    const VectorDouble correctedEnd = inkEnd * correctionScalar;
    const VectorDouble minXY = (pos + Min(inkOrigin, correctedOrigin)) - margin;
    const VectorDouble maxXY = (pos + Max(inkEnd, correctedEnd)) + margin;
    return TryIntersectTextBounds(minXY.x, minXY.y, maxXY.x, maxXY.y, clip);
}

Expected<Rect> TryResolveGlyphCoverageRectangle(
    in Point glyphPosition,
    in u32 pageIndex,
    in Rect recordPixels,
    in i32 bearingX,
    in i32 bearingY,
    in f32 rasterScale,
    in Point topLeft,
    in Point pixelScale
){
    if(
        !IsValidTextGlyphLocation(glyphPosition, topLeft)
        || !IsFinite(rasterScale) || rasterScale <= 0.0f
        || !IsValidUiRect(recordPixels)
        || !IsFinite(VectorSingle(pixelScale.x, pixelScale.y, pixelScale.x, pixelScale.y).xy) || pixelScale.x <= 0.0f || pixelScale.y <= 0.0f
    )
        return MakeUnexpected(Failure());
    if(pageIndex == s_GlyphAtlasNoPage)
        return Rect();
    const VectorDouble invRasterScale(cast<f64>(rasterScale));
    const VectorDouble origin = VectorDouble(cast<f64>(topLeft.x), cast<f64>(topLeft.y), cast<f64>(topLeft.x), cast<f64>(topLeft.y)) + VectorDouble(cast<f64>(glyphPosition.x), cast<f64>(glyphPosition.y), cast<f64>(glyphPosition.x), cast<f64>(glyphPosition.y));
    const VectorDouble bearing = VectorDouble(cast<f64>(bearingX), cast<f64>(bearingY), cast<f64>(bearingX), cast<f64>(bearingY)) / invRasterScale;
    const VectorDouble pos = origin + VectorDouble(bearing.x, -bearing.y, bearing.x, -bearing.y);
    const VectorDouble scaleVec(cast<f64>(pixelScale.x), cast<f64>(pixelScale.y), cast<f64>(pixelScale.x), cast<f64>(pixelScale.y));
    const VectorDouble rounded = VectorDoubleMultiplyAddExpression(pos, scaleVec, VectorDouble(s_TextHalfPixel));
    const VectorDouble aligned = VectorDouble(Floor(rounded.x), Floor(rounded.y), Floor(rounded.x), Floor(rounded.y)) / scaleVec;
    const f64 alignedX = aligned.x;
    const f64 alignedY = aligned.y;
    const VectorDouble size = VectorDouble(cast<f64>(recordPixels.width), cast<f64>(recordPixels.height), 0.0, 0.0) / invRasterScale;
    return TryMakeUiRect(alignedX, alignedY, size.x, size.y, UiRectPrecision::BoundedEndpoints);
}

Rect ToTextGlyphAtlasRect(in VectorDouble rectangle){
    return Rect(
        cast<f32>(rectangle.x),
        cast<f32>(rectangle.y),
        cast<f32>(rectangle.z),
        cast<f32>(rectangle.w)
    );
}

TextGlyphIntersection IntersectGlyphAtlasRectangle(in VectorDouble rectangle, in Rect clip){
    const VectorDouble maxXY = VectorDouble(rectangle.x, rectangle.y, 0.0, 0.0) + VectorDouble(rectangle.z, rectangle.w, 0.0, 0.0);
    return TryIntersectTextBounds(rectangle.x, rectangle.y, maxXY.x, maxXY.y, clip);
}

TextGlyphIntersection ValidateTextGlyphCandidateInputs(
    in Point glyphPosition,
    in Point topLeft,
    in f32 fontSize,
    in f32 physicalSize,
    in Rect clip,
    in Point pixelScale
){
    if(
        !IsValidTextGlyphLocation(glyphPosition, topLeft) || !IsValidTextFontSize(fontSize) || !IsFinite(physicalSize)
        || physicalSize < 1.0f || physicalSize > s_TextMaxRasterPpemF32 || !IsValidUiRect(clip)
        || !IsFinite(VectorSingle(pixelScale.x, pixelScale.y, pixelScale.x, pixelScale.y).xy) || pixelScale.x <= 0.0f || pixelScale.y <= 0.0f
    )
        return TextGlyphIntersection::Invalid;
    if(clip.width <= 0.0f || clip.height <= 0.0f)
        return TextGlyphIntersection::Invisible;
    return TextGlyphIntersection::Visible;
}

TextGlyphIntersection EvaluateUnselectedAtlasGlyphCandidate(
    in Point glyphPosition,
    in Point topLeft,
    in Rect glyphInk,
    in GlyphCoverageBounds coverage,
    in b8 hasValidFace,
    in b8 coverageInkReliable,
    in u32 faceUnitsPerEm,
    in f32 fontSize,
    in f32 physicalSize,
    in Rect clip,
    in Point pixelScale
){
    if(!IsValidUiRect(glyphInk) || (coverage.known && !IsValidUiRect(coverage.ink)))
        return TextGlyphIntersection::Invalid;
    Rect ink = glyphInk;
    if(coverage.known)
        ink = coverage.ink;
    if(coverage.known && (ink.width <= 0.0f || ink.height <= 0.0f))
        return TextGlyphIntersection::Invisible;
    u32 unitsPerEm = 1u;
    if(!coverage.known){
        if(!hasValidFace)
            return TextGlyphIntersection::Invalid;
        if(ink.width <= 0.0f || ink.height <= 0.0f || !coverageInkReliable)
            return TextGlyphIntersection::Visible;
        unitsPerEm = faceUnitsPerEm;
    }
    return IntersectTextCoverageInk(glyphPosition, topLeft, ink, coverage.known, unitsPerEm, fontSize, physicalSize, clip, pixelScale);
}


