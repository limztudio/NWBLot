#include <impl/ecs_render/kernel/task_graph_resource_descs.adhd>
#include <impl/ecs_render/kernel/task_graph_resource_utils.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<GpuGraphResourceId> ImportReflectionGraphTexture(mut GpuTaskGraph graph, in TextureHandle texture, in StringView resourceLabel, in b8 firstWrite){
    if(firstWrite)
        return FindOrImportTexture(graph, texture, resourceLabel, ResourceStates::Unknown);
    return FindOrImportTexture(graph, texture, resourceLabel, ResourceStates::Common);
}

Expected<GpuGraphResourceId> ImportReflectionTexture(mut GpuTaskGraph graph, in TextureHandle texture, in StringView resourceLabel, in b8 firstWrite){
    return ImportReflectionGraphTexture(graph, texture, resourceLabel, firstWrite);
}

Expected<GpuGraphResourceId> ImportReflectionTexture(mut GpuTaskGraph graph, in TextureHandle texture){
    return ImportReflectionTexture(graph, texture, "Reflection Output", true);
}

GpuTaskDesc ReflectionTaskDesc(in Name identity, in StringView label, in borrow GpuTaskId dependency){
    GpuTaskSchedulingHint scheduling;
    scheduling.cost = GpuTaskCostHint::Tiny;
    scheduling.allowPacketMerge = true;
    scheduling.mergeWithPrevious = true;
    scheduling.allowMergeAcrossConsumerFrontier = true;
    GpuTaskDesc desc;
    desc.setIdentity(identity).setMarkerLabel(label).setScheduling(scheduling);
    if(dependency.valid())
        desc.setDependency(dependency);
    return desc;
}

GpuTaskTimingMetadata ReflectionPacketTiming(){
    GpuTaskTimingMetadata timing;
    timing.policy = GpuTaskTimingPolicy::PacketOnly;
    return timing;
}


