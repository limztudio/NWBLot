const StringView s_UiPopupToolsCasePanelKey = "panel";
const StringView s_UiPopupToolsCaseAnchorKey = "anchor";

WidgetId MakeUiPopupRouterWidgetId(in u64 value){
    WidgetId id = WidgetId();
    id.value = value;
    return id;
}

Point MakeUiPopupRouterPoint(in f32 x, in f32 y){
    Point point = Point();
    point.x = x;
    point.y = y;
    return point;
}

Rect MakeUiPopupRouterRect(in f32 x, in f32 y, in f32 width, in f32 height){
    Rect rect = Rect();
    rect.x = x;
    rect.y = y;
    rect.width = width;
    rect.height = height;
    return rect;
}

InputEvent MakeUiPopupRouterBareEvent(in InputEventTypeEnum type){
    InputEvent event = InputEvent();
    event.type = type;
    return event;
}

InputEvent MakeUiPopupRouterPointerEvent(in InputEventTypeEnum type, in f32 x, in f32 y){
    InputEvent event = InputEvent();
    event.type = type;
    event.position = MakeUiPopupRouterPoint(x, y);
    return event;
}

InputEvent MakeUiPopupRouterPointEvent(in InputEventTypeEnum type, in Point point){
    InputEvent event = InputEvent();
    event.type = type;
    event.position = point;
    return event;
}

InputEvent MakeUiPopupRouterKeyEvent(in InputEventTypeEnum type, in KeyEnum key, in b8 repeat){
    InputEvent event = InputEvent();
    event.type = type;
    event.key = key;
    event.repeat = repeat;
    return event;
}

HitTarget MakeUiPopupRouterButtonOrdered(in u64 idValue, in Rect rectangle, in u32 paintOrder){
    HitTarget target = HitTarget();
    target.id.value = idValue;
    target.rectangle = rectangle;
    target.clip = MakeUiPopupRouterRect(0.0f, 0.0f, 200.0f, 120.0f);
    target.paintOrder = paintOrder;
    target.focusable = true;
    target.activatable = true;
    return target;
}

HitTarget MakeUiPopupRouterButton(in u64 idValue, in Rect rectangle){
    return MakeUiPopupRouterButtonOrdered(idValue, rectangle, 0u);
}

PopupScope MakeUiPopupRouterScopeEpoch(in u64 widgetValue, in u32 layer, in u64 openGeneration){
    PopupScope scope = PopupScope();
    scope.token.widget.value = widgetValue;
    scope.token.declarationGeneration = 10u;
    scope.token.instanceGeneration = 20u;
    scope.token.openGeneration = openGeneration;
    scope.bounds = MakeUiPopupRouterRect(40.0f, 40.0f, 100.0f, 70.0f);
    scope.viewport = MakeUiPopupRouterRect(0.0f, 0.0f, 200.0f, 120.0f);
    scope.layer = layer;
    return scope;
}

PopupScope MakeUiPopupRouterScopeLayer(in u64 widgetValue, in u32 layer){
    return MakeUiPopupRouterScopeEpoch(widgetValue, layer, 1u);
}

PopupScope MakeUiPopupRouterScope(){
    return MakeUiPopupRouterScopeEpoch(100u, 3u, 1u);
}

Array<HitTarget, 2u> MakeUiPopupRouterBaseTargets(){
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = MakeUiPopupRouterButton(1u, MakeUiPopupRouterRect(10.0f, 10.0f, 30.0f, 20.0f));
    targets[1u] = MakeUiPopupRouterButton(2u, MakeUiPopupRouterRect(60.0f, 10.0f, 30.0f, 20.0f));
    return targets;
}

HitTarget MakeUiPopupRouterBarrier(in PopupScope scope){
    HitTarget target = HitTarget();
    target.id = scope.token.widget;
    target.declarationGeneration = scope.token.declarationGeneration;
    target.rectangle = scope.bounds;
    target.clip = scope.viewport;
    target.paintOrder = 10u;
    target.popup = scope.token;
    target.layer = scope.layer;
    return target;
}

HitTarget MakeUiPopupRouterChild(in PopupScope scope, in u64 idValue, in Rect rectangle, in u32 paintOrder){
    HitTarget target = MakeUiPopupRouterButtonOrdered(idValue, rectangle, paintOrder);
    target.clip = scope.bounds;
    target.popup = scope.token;
    target.layer = scope.layer;
    return target;
}

Array<HitTarget, 5u> MakeUiPopupRouterTargets(in PopupScope scope){
    const Array<HitTarget, 2u> base = MakeUiPopupRouterBaseTargets();
    Array<HitTarget, 5u> targets = Array<HitTarget, 5u>();
    targets[0u] = base[0u];
    targets[1u] = base[1u];
    targets[2u] = MakeUiPopupRouterBarrier(scope);
    targets[3u] = MakeUiPopupRouterChild(scope, scope.token.widget.value + 1u, MakeUiPopupRouterRect(50.0f, 50.0f, 30.0f, 20.0f), 11u);
    targets[4u] = MakeUiPopupRouterChild(scope, scope.token.widget.value + 2u, MakeUiPopupRouterRect(90.0f, 50.0f, 30.0f, 20.0f), 12u);
    return targets;
}

Array<HitTarget, 7u> MakeUiPopupRouterTwoLayerTargets(in PopupScope lower, in PopupScope higher){
    const Array<HitTarget, 5u> lowerTargets = MakeUiPopupRouterTargets(lower);
    Array<HitTarget, 7u> targets = Array<HitTarget, 7u>();
    targets[0u] = lowerTargets[0u];
    targets[1u] = lowerTargets[1u];
    targets[2u] = lowerTargets[2u];
    targets[3u] = lowerTargets[3u];
    targets[4u] = lowerTargets[4u];
    targets[5u] = MakeUiPopupRouterBarrier(higher);
    targets[6u] = MakeUiPopupRouterChild(higher, 201u, MakeUiPopupRouterRect(50.0f, 50.0f, 30.0f, 20.0f), 11u);
    return targets;
}


