#include <utilities/fbx_to_nwb/common.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StringView SelectPromptBoolSuffix(in b8 defaultValue){
    if(defaultValue)
        return " [Y/n]: ";
    return " [y/N]: ";
}

b8 ShouldPromptPreserveSpace(in b8 hasPreserveSpace, in b8 acceptDefaults, in b8 listMeshes){
    return !hasPreserveSpace && !acceptDefaults && !listMeshes;
}

Expected<b8> ParseFbxConfirmText(in StringView rawText){
    const StringView view = TrimView(rawText);
    if(EqualsAsciiIgnoreCase(view, "y") || EqualsAsciiIgnoreCase(view, "yes") || EqualsAsciiIgnoreCase(view, "true") || view == "1")
        return true;
    if(EqualsAsciiIgnoreCase(view, "n") || EqualsAsciiIgnoreCase(view, "no") || EqualsAsciiIgnoreCase(view, "false") || view == "0")
        return false;
    return MakeUnexpected(Failure());
}

String FormatAssetTypePromptLabel(){
    String prompt;
    prompt.reserve(80u);
    prompt.append("Asset type (");
    AppendOutputAssetTypeOptionsText(prompt);
    prompt.append(")");
    return prompt;
}

String FormatNormalModePromptLabel(){
    String prompt;
    prompt.reserve(64u);
    prompt.append("Normal mode (");
    AppendNormalModeOptionsText(prompt);
    prompt.append(")");
    return prompt;
}

StringView UnquoteFbxInputText(in StringView text){
    StringView view = TrimView(text);
    if(view.size() >= 2u){
        const u8 first = view[0u];
        const u8 last = view[view.size() - 1u];
        if((first == s_AsciiDoubleQuoteByte && last == s_AsciiDoubleQuoteByte) || (first == s_AsciiSingleQuoteByte && last == s_AsciiSingleQuoteByte))
            view = view.substr(1u, view.size() - 2u);
    }
    return view;
}


