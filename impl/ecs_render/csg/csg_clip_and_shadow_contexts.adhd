Expected<CsgReceiverClipDrawInfo> RendererCsgSystem::resolveCsgReceiverClipDrawInfo(
    in CsgFrameReceiverLookup receiverLookup,
    in CsgReceiverDrawState receiverDrawState,
    in CsgReceiverCpuBounds receiverBounds
)const{
    return ResolveCsgReceiverClipDrawInfoImpl(this.m_csgShapeRegistry, receiverLookup, receiverDrawState, receiverBounds, Optional<in TransformComponent>());
}

Expected<CsgReceiverClipDrawInfo> RendererCsgSystem::resolveCsgReceiverClipDrawInfo(
    in CsgFrameReceiverLookup receiverLookup,
    in CsgReceiverDrawState receiverDrawState,
    in CsgReceiverCpuBounds receiverBounds,
    in TransformComponent transform
)const{
    return ResolveCsgReceiverClipDrawInfoImpl(this.m_csgShapeRegistry, receiverLookup, receiverDrawState, receiverBounds, Optional<in TransformComponent>(transform));
}

Expected<CsgReceiverRangeGpuData> RendererCsgSystem::appendCsgReceiverClipData(
    in CsgFrameReceiverLookup receiverLookup,
    in CsgReceiverDrawState receiverDrawState,
    in CsgReceiverCpuBounds receiverBounds,
    in u32 frameWidth,
    in u32 frameHeight,
    mut CsgFrameGpuData csgFrameData
)const{
    return AppendCsgReceiverClipDataImpl(this.m_csgShapeRegistry, this.m_meshSystem, receiverLookup, receiverDrawState, receiverBounds, Optional<in TransformComponent>(), frameWidth, frameHeight, Optional<in MeshViewGpuData>(), csgFrameData);
}

Expected<CsgReceiverRangeGpuData> RendererCsgSystem::appendCsgReceiverClipData(
    in CsgFrameReceiverLookup receiverLookup,
    in CsgReceiverDrawState receiverDrawState,
    in CsgReceiverCpuBounds receiverBounds,
    in TransformComponent transform,
    in u32 frameWidth,
