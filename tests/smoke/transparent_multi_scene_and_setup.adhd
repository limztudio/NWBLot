#if defined(NWB_TRANSPARENT_MULTI_ENABLE_CSG)
inline constexpr b8 s_TransparentMultiEnableCsg = true;
#else
inline constexpr b8 s_TransparentMultiEnableCsg = false;
#endif
#if defined(NWB_TRANSPARENT_MULTI_CAUSTIC_SPHERE)
inline constexpr b8 s_TransparentMultiCausticSphere = true;
#else
inline constexpr b8 s_TransparentMultiCausticSphere = false;
#endif
#if defined(NWB_TRANSPARENT_MULTI_FRAME_LAGGED_ASYNC_LIGHTING_SMOKE)
inline constexpr b8 s_TransparentMultiFrameLaggedAsyncLighting = true;
#else
inline constexpr b8 s_TransparentMultiFrameLaggedAsyncLighting = false;
#endif
inline constexpr f32 s_TransparentMultiHalfPi = s_PIDIV2;
inline constexpr f32 s_TransparentMultiTwoPi = s_2PI;
};


