void VerifyUiPopupToolsLoanTests_ClosingAUserPopupAfterTooltipDeclarationHidesHelpWithoutOrphanOverlay(mut UiPopupToolsLoanTests self){
    self.m_plainPopup.open();
    ASSERT_TRUE(self.acceptPopupTooltip(1u));
    ASSERT_TRUE(self.moveToAnchor("plain"));
    ASSERT_TRUE(self.acceptPopupTooltip(2u));
    ASSERT_TRUE(self.m_tooltip.visible());
    ASSERT_TRUE(self.m_context.input().hasPopup());
    ASSERT_TRUE(self.begin(3u));
    PopupOptions options = PopupOptions();
    options.anchor = Rect(40.0f, 40.0f, 40.0f, 24.0f);
    options.size = Point(320.0f, 220.0f);
    ASSERT_TRUE(self.m_builder.beginPopup("plain", self.m_plainPopup, options));
    EXPECT_FALSE(self.m_builder.button("anchor", "Popup anchor", self.m_anchorOptions));
    ASSERT_TRUE(self.m_builder.tooltip("tip", "anchor", "Overlay help", self.m_tooltip, self.m_tooltipOptions));
    ASSERT_TRUE(self.m_tooltip.visible());
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 2u);
    self.m_plainPopup.close();
    ASSERT_TRUE(self.m_builder.endPopup());
    EXPECT_TRUE(self.m_builder.balanced());
    EXPECT_FALSE(self.m_tooltip.visible());
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 2u);
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    EXPECT_TRUE(snapshot.commands().empty());
    EXPECT_TRUE(snapshot.vertices().empty());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_TRUE(self.m_context.input().targets().empty());
}

void VerifyUiPopupToolsLoanTests_MenuRowCallbackCannotReplaceAnAlreadyPaintedOrdinaryListAndPublish(mut UiPopupToolsLoanTests self){
    ASSERT_TRUE(self.acceptTools(1u, false, false));
    PopupToolsSource ordinarySource = PopupToolsSource();
    ordinarySource.generation = 1502u;
    ListState ordinary = ListState();
    ordinary.select(1u);
    ASSERT_TRUE(self.m_menu.open(Rect(40.0f, 60.0f, 0.0f, 0.0f)));
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(10.0f, 10.0f, 360.0f, 360.0f)));
    ListOptions options = ListOptions();
    options.width.policy = LayoutSizePolicy::Fixed;
    options.width.value = 220.0f;
    options.height.policy = LayoutSizePolicy::Fixed;
    options.height.value = 168.0f;
    ASSERT_TRUE(self.m_builder.virtualList("ordinary", ordinarySource, ordinary, options).valid);
    EXPECT_FALSE(self.m_builder.button("anchor", "Anchor", self.m_anchorOptions));
    ASSERT_TRUE(self.m_builder.contextMenu("menu", "anchor", self.m_source, self.m_menu, self.m_menuOptions).valid);
    const u64 inputGeneration = ordinary.inputGeneration();
    self.armSelectListOnText(ordinary, 4u);
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_FALSE(self.hasSelectListOnText());
    EXPECT_EQ(ordinary.selectedKey(), 4u);
    EXPECT_EQ(ordinary.cursorKey(), 4u);
    EXPECT_NE(ordinary.inputGeneration(), inputGeneration);
    EXPECT_GT(ordinary.placement().bounds.width, 0.0f);
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
}

void VerifyUiPopupToolsLoanTests_LateMenuMetadataCallbackCannotCloseAPaintedComboAndPublish(mut UiPopupToolsLoanTests self){
    ASSERT_TRUE(self.acceptTools(1u, false, false));
    ComboState combo = ComboState();
    RevisionArmingComboSource comboSource = RevisionArmingComboSource(self.m_source, combo);
    combo.open();
    ASSERT_EQ(combo.selectedKey(), 0u);
    ASSERT_TRUE(self.m_menu.open(Rect(40.0f, 60.0f, 0.0f, 0.0f)));
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(10.0f, 10.0f, 360.0f, 360.0f)));
    EXPECT_FALSE(self.m_builder.button("anchor", "Anchor", self.m_anchorOptions));
    ASSERT_TRUE(self.m_builder.contextMenu("menu", "anchor", self.m_source, self.m_menu, self.m_menuOptions).valid);
    ComboOptions options = ComboOptions();
    options.width.policy = LayoutSizePolicy::Fixed;
    options.width.value = 220.0f;
    options.height.policy = LayoutSizePolicy::Fixed;
    options.height.value = 32.0f;
    options.popupHeight = 176.0f;
    ASSERT_TRUE(self.m_builder.comboBox("combo", comboSource, combo, options).valid);
    ASSERT_EQ(comboSource.textCalls.value(), 0u);
    ASSERT_FALSE(self.hasCloseComboOnRevision());
    const u64 inputGeneration = combo.inputGeneration();
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(comboSource.armed.value());
    EXPECT_GT(comboSource.textCalls.value(), 0u);
    EXPECT_FALSE(self.hasCloseComboOnRevision());
    EXPECT_FALSE(combo.isOpen());
    EXPECT_NE(combo.inputGeneration(), inputGeneration);
    EXPECT_GT(combo.placement().bounds.width, 0.0f);
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyUiPopupToolsNavigationTests_SourceRevisionRestoresRowsFocusAtAcceptanceAndRetiresHeldInput(mut UiPopupToolsNavigationTests self){
    ASSERT_TRUE(self.acceptTools(1u, false));
    ASSERT_TRUE(self.openBySecondary(2u));
    const auto initialHost = self.findMenuHost();
    ASSERT_TRUE(initialHost.has_value());
    const WidgetId rows = initialHost.value().id;
    ASSERT_EQ(self.m_context.input().focus(), rows);
    self.press(Key::End);
    ASSERT_TRUE(self.acceptTools(3u, false));
    ASSERT_EQ(self.m_menu.cursorKey(), 5u);
    ASSERT_FALSE(self.m_menuResult.activated);
    const u64 oldInputGeneration = self.m_menu.listState().inputGeneration();
    const auto thirdHost = self.findMenuHost();
    ASSERT_TRUE(thirdHost.has_value());
    const u64 oldSourceRevision = thirdHost.value().control.contentRevision;

    self.press(Key::Enter);
    InputEvent heldNavigation = InputEvent();
    heldNavigation.type = InputEventType::KeyDown;
    heldNavigation.key = Key::Down;
    EXPECT_TRUE(self.send(heldNavigation).commandConsumed);
    ASSERT_FALSE(self.m_context.input().controlActions().empty());
    self.m_source.count = 4u;
    ++self.m_source.contentRevision.value();

    ASSERT_TRUE(self.prepareTools(4u, false));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 3u);
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_FALSE(self.m_context.input().capture().valid());
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
    EXPECT_NE(self.m_menu.listState().inputGeneration(), oldInputGeneration);
    EXPECT_EQ(self.m_menu.cursorKey(), 1u);
    EXPECT_TRUE(self.m_menu.isOpen());
    EXPECT_FALSE(self.m_menuResult.activated);
    EXPECT_EQ(self.m_menuResult.key, 0u);
    EXPECT_FALSE(self.m_context.commitFrame(3u));
    EXPECT_FALSE(self.m_context.input().focus().valid());

    ASSERT_TRUE(self.m_context.commitFrame(4u));
    const auto committedHost = self.findMenuHost();
    ASSERT_TRUE(committedHost.has_value());
    EXPECT_EQ(committedHost.value().id, rows);
    EXPECT_EQ(self.m_context.input().focus(), rows);
    EXPECT_NE(committedHost.value().control.contentRevision, oldSourceRevision);
    EXPECT_EQ(committedHost.value().control.contentRevision, self.m_source.contentRevision.value());
    EXPECT_EQ(committedHost.value().control.instanceGeneration, self.m_menu.listState().inputGeneration());
    heldNavigation.repeat = true;
    EXPECT_TRUE(self.send(heldNavigation).commandConsumed);
    ASSERT_TRUE(self.acceptTools(5u, false));
    EXPECT_EQ(self.m_menu.cursorKey(), 1u);
    EXPECT_FALSE(self.m_menuResult.activated);
    EXPECT_TRUE(self.m_menu.isOpen());
    heldNavigation.type = InputEventType::KeyUp;
    heldNavigation.repeat = false;
    EXPECT_TRUE(self.send(heldNavigation).commandConsumed);

    self.press(Key::End);
    ASSERT_TRUE(self.acceptTools(6u, false));
    EXPECT_EQ(self.m_menu.cursorKey(), 4u);
    EXPECT_FALSE(self.m_menuResult.activated);
    self.press(Key::Enter);
    ASSERT_TRUE(self.acceptTools(9u, false));
    EXPECT_TRUE(self.m_menuResult.activated);
    EXPECT_EQ(self.m_menuResult.key, 4u);
    EXPECT_TRUE(self.m_menuResult.closed);
    EXPECT_FALSE(self.m_menu.isOpen());
    EXPECT_FALSE(self.m_context.input().hasPopup());
}

void VerifyUiPopupToolsNavigationTests_FocusLossAndRegainCannotRestorePreparedRowsFocus(mut UiPopupToolsNavigationTests self){
    ASSERT_TRUE(self.acceptTools(1u, false));
    ASSERT_TRUE(self.openBySecondary(2u));
    const auto host = self.findMenuHost();
    ASSERT_TRUE(host.has_value());
    ASSERT_EQ(self.m_context.input().focus(), host.value().id);
    self.m_source.count = 4u;
    ++self.m_source.contentRevision.value();
    ASSERT_TRUE(self.prepareTools(3u, false));
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_TRUE(self.m_menu.isOpen());

    EXPECT_FALSE(self.send(MakeUiBareInputEvent(InputEventType::FocusLost)).focus.valid());
    EXPECT_FALSE(self.send(MakeUiBareInputEvent(InputEventType::FocusGained)).focus.valid());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_FALSE(self.m_context.input().capture().valid());
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
    ASSERT_TRUE(self.acceptTools(4u, false));
    EXPECT_TRUE(self.m_menuResult.closed);
    EXPECT_FALSE(self.m_menuResult.activated);
    EXPECT_FALSE(self.m_menu.isOpen());
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_FALSE(self.m_context.input().focus().valid());
}


