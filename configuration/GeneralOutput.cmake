include_guard(GLOBAL)

include("${CMAKE_CURRENT_LIST_DIR}/toolchains/ToolchainUtilities.cmake")

macro(nwb_require_supported_architecture)
    if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
        message(FATAL_ERROR "NWBLot supports 64-bit x64 and ARM64 targets only.")
    endif()

    nwb_resolve_target_architecture("${CMAKE_SYSTEM_PROCESSOR}" NWB_OUTPUT_ARCH)
endmacro()

macro(nwb_resolve_output_domain)
    if(DEFINED NWB_OUTPUT_DOMAIN AND NOT NWB_OUTPUT_DOMAIN STREQUAL "")
        set(_nwb_output_domain "${NWB_OUTPUT_DOMAIN}")
    else()
        get_filename_component(_nwb_output_domain "${CMAKE_BINARY_DIR}" NAME)
        if(_nwb_output_domain STREQUAL "")
            set(_nwb_output_domain "default")
        endif()
    endif()

    string(TOLOWER "${CMAKE_SYSTEM_NAME}" NWB_OUTPUT_PLATFORM)
    set(NWB_OUTPUT_DOMAIN "${_nwb_output_domain}")
    if(NWB_OUTPUT_DOMAIN STREQUAL "engine")
        set(NWB_OUTPUT_ROOT "${PROJECT_SOURCE_DIR}/__exec/${NWB_OUTPUT_PLATFORM}/${NWB_OUTPUT_ARCH}")
    else()
        set(NWB_OUTPUT_ROOT "${PROJECT_SOURCE_DIR}/__exec/${NWB_OUTPUT_PLATFORM}/${NWB_OUTPUT_ARCH}/${NWB_OUTPUT_DOMAIN}")
    endif()
endmacro()

macro(nwb_configure_general_output)
    nwb_resolve_output_domain()

    foreach(_type RUNTIME LIBRARY ARCHIVE)
        foreach(_cfg IN LISTS NWB_BUILD_CONFIGURATIONS)
            string(TOUPPER "${_cfg}" _cfg_upper)
            set(CMAKE_${_type}_OUTPUT_DIRECTORY_${_cfg_upper} "${NWB_OUTPUT_ROOT}/${_cfg}")
        endforeach()
    endforeach()
endmacro()
