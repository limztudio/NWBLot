#include <impl/ecs_mesh/system.adhd>
#include <impl/ecs_csg/components.adhd>
#include <impl/ecs_scene/components.adhd>
#include <impl/ecs_render/optics/optical_scene.adhd>
#include <impl/ecs_render/material/material_surface_lookup.adhd>
#include <impl/ecs_render/optics/coincident_volume_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void TryAppendCoincidentOpticalVolumeCandidate(
    mut World world,
    in MeshSystem meshSystem,
    mut IPreparedMaterialLookup materials,
    in EntityID entity,
    in RendererComponent renderer,
    mut Vector<CoincidentOpticalVolumeCandidate> candidates
){
    if(!RendererComponentOpticalVolumeMergingEnabled(renderer))
        return;
    const Expected<mut MaterialSurfaceInfo> material = materials.findMaterialSurfaceInfo(renderer.material);
    if(!material.has_value())
        return;
    const b8 closed = OpticalBoundaryModeIsClosed(renderer.opticalBoundaryMode);
    if(!MaterialParticipatesInOpticalVolumeSelection(material.value().transparent, material.value().refractive, closed))
        return;
    const auto mesh = meshSystem.resolveRenderableMeshStatus(entity);
    if(!mesh.has_value() || mesh.value().runtime || !mesh.value().mesh.valid())
        return;
    if(world.hasComponent<StaticCsgMeshComponent>(entity) || world.hasComponent<SkinnedCsgMeshComponent>(entity) || world.hasComponent<CsgReceiverComponent>(entity))
        return;

    Optional<in MaterialInstanceComponent> materialInstance;
    const Optional<mut MaterialInstanceComponent> borrowedInstance = world.borrowComponent<MaterialInstanceComponent>(entity);
    if(borrowedInstance.has_value())
        materialInstance.emplace(borrowedInstance.value());
    const auto bytes = materials.findPreparedMaterialInstanceMutableTypedBytes(entity, material.value(), materialInstance);
    if(!bytes.has_value())
        return;
    CoincidentOpticalVolumeCandidate candidate = MakeCoincidentOpticalVolumeCandidate(entity, mesh.value().mesh, renderer, bytes.value());
    const Optional<mut TransformComponent> borrowedTransform = world.borrowComponent<TransformComponent>(entity);
    if(borrowedTransform.has_value()){
        candidate.position = borrowedTransform.value().position;
        candidate.rotation = borrowedTransform.value().rotation;
        candidate.scale = borrowedTransform.value().scale;
    }
    candidates.push_back(candidate);
}

class RendererOpticalVolumeSelection : NoCopy{
    private HashSet<EntityID> m_suppressed;

    public RendererOpticalVolumeSelection(){}

    public void prepare(mut World world, mut IPreparedMaterialLookup materials){
        const Optional<mut MeshSystem> meshSystem = world.borrowSystem<MeshSystem>();
        if(!meshSystem.has_value() || world.view<RendererComponent>().candidateCount() < s_MinCoincidentCandidateCount){
            this.reset();
            return;
        }

        usize candidateCapacity = 0u;
        for(in auto row : world.view<RendererComponent>()){
            if(RendererComponentOpticalVolumeMergingEnabled(Get<1>(row)))
                ++candidateCapacity;
        }
        if(candidateCapacity < s_MinCoincidentCandidateCount){
            this.reset();
            return;
        }

        Vector<CoincidentOpticalVolumeCandidate> candidates;
        candidates.reserve(candidateCapacity);
        for(in auto row : world.view<RendererComponent>())
            TryAppendCoincidentOpticalVolumeCandidate(world, meshSystem.value(), materials, Get<0>(row), Get<1>(row), candidates);
        this.select(Span<CoincidentOpticalVolumeCandidate>(candidates));
    }

    public void select(in Span<CoincidentOpticalVolumeCandidate> candidates){
        SelectSuppressedCoincidentOpticalVolumes(candidates, this.m_suppressed);
    }

    public void reset(){
        this.m_suppressed.clear();
    }

    public b8 isSuppressed(in EntityID entity)const{
        return !this.m_suppressed.empty() && this.m_suppressed.contains(entity);
    }
}


