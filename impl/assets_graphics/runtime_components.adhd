////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_ModelComponentLoadPayloadContext = "ModelComponentAsset::loadComponentPayload";
const StringView s_ModelComponentValidatePayloadContext = "ModelComponentAsset::validatePayload";
const StringView s_ModelComponentKindLabel = "model_component";
const StringView s_MeshComponentLoadPayloadContext = "MeshComponentAsset::loadComponentPayload";
const StringView s_MeshComponentValidatePayloadContext = "MeshComponentAsset::validatePayload";
const StringView s_MeshComponentKindLabel = "mesh_component";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_graphics/bvh_subsystem.adhd.h>
#include <impl/assets_graphics/csg_subsystem.adhd.h>
#include <impl/assets_graphics/deferred_subsystem.adhd.h>
#include <impl/assets_graphics/gi_subsystem.adhd.h>
#include <impl/assets_graphics/mesh_subsystem.adhd.h>
#include <impl/assets_graphics/reflection_subsystem.adhd.h>
#include <impl/assets_graphics/refractive_subsystem.adhd.h>
#include <impl/assets_graphics/renderer_subsystem.adhd.h>
#include <impl/assets_graphics/shadow_subsystem.adhd.h>
#include <impl/assets_graphics/transparent_subsystem.adhd.h>
#include <impl/assets_graphics/components.adhd.h>

#include <impl/assets_graphics/graphics_component_binary_codec.adhd.h>

#include <core/common/log.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_assets_graphics_runtime_components{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_DEFINE_SUBSYSTEM_ASSET_REGISTRAR(s_RendererSubsystemAssetAutoRegistrar, RendererSubsystem);
NWB_DEFINE_SUBSYSTEM_ASSET_REGISTRAR(s_MeshSubsystemAssetAutoRegistrar, MeshSubsystem);
NWB_DEFINE_SUBSYSTEM_ASSET_REGISTRAR(s_DeferredSubsystemAssetAutoRegistrar, DeferredSubsystem);
NWB_DEFINE_SUBSYSTEM_ASSET_REGISTRAR(s_BvhSubsystemAssetAutoRegistrar, BvhSubsystem);
NWB_DEFINE_SUBSYSTEM_ASSET_REGISTRAR(s_GiSubsystemAssetAutoRegistrar, GiSubsystem);
NWB_DEFINE_SUBSYSTEM_ASSET_REGISTRAR(s_ReflectionSubsystemAssetAutoRegistrar, ReflectionSubsystem);
NWB_DEFINE_SUBSYSTEM_ASSET_REGISTRAR(s_ShadowSubsystemAssetAutoRegistrar, ShadowSubsystem);
NWB_DEFINE_SUBSYSTEM_ASSET_REGISTRAR(s_TransparentSubsystemAssetAutoRegistrar, TransparentSubsystem);
NWB_DEFINE_SUBSYSTEM_ASSET_REGISTRAR(s_RefractiveSubsystemAssetAutoRegistrar, RefractiveSubsystem);
NWB_DEFINE_SUBSYSTEM_ASSET_REGISTRAR(s_CsgSubsystemAssetAutoRegistrar, CsgSubsystem);
NWB_DEFINE_COMPONENT_ASSET_REGISTRAR(s_ModelComponentAssetAutoRegistrar, ModelComponentAsset);
NWB_DEFINE_COMPONENT_ASSET_REGISTRAR(s_MeshComponentAssetAutoRegistrar, MeshComponentAsset);
NWB_DEFINE_COMPONENT_ASSET_REGISTRAR(s_RendererComponentAssetAutoRegistrar, RendererComponentAsset);

template<typename ComponentAssetT, typename TAsset>
[[nodiscard]] static b8 ValidateSingleAssetRefComponentPayload(const ComponentAssetT& componentAsset, const Core::Assets::AssetRef<TAsset>& assetRef, const TStringView context, const AStringView contextAscii, const AStringView kindLabel){
    if(!componentAsset.checkVirtualPath(context))
        return false;
    return GraphicsComponentBinaryCodec{}.validateAssetRef(assetRef.valid(), componentAsset.virtualPath(), contextAscii, kindLabel);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ModelComponentAsset::loadComponentPayload(const Span<const u8> payload){
    return GraphicsComponentBinaryCodec{}.deserializeAssetRef(payload, s_ModelComponentLoadPayloadContext, component.model.virtualPath);
}

b8 ModelComponentAsset::validatePayload()const{
    return __hidden_assets_graphics_runtime_components::ValidateSingleAssetRefComponentPayload(*this, component.model, NWB_TEXT("ModelComponentAsset::validatePayload"), s_ModelComponentValidatePayloadContext, s_ModelComponentKindLabel);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MeshComponentAsset::loadComponentPayload(const Span<const u8> payload){
    return GraphicsComponentBinaryCodec{}.deserializeAssetRef(payload, s_MeshComponentLoadPayloadContext, component.mesh.virtualPath);
}

b8 MeshComponentAsset::validatePayload()const{
    return __hidden_assets_graphics_runtime_components::ValidateSingleAssetRefComponentPayload(*this, component.mesh, NWB_TEXT("MeshComponentAsset::validatePayload"), s_MeshComponentValidatePayloadContext, s_MeshComponentKindLabel);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RendererComponentAsset::loadComponentPayload(const Span<const u8> payload){
    return GraphicsComponentBinaryCodec{}.deserializeRenderer(payload, component);
}

b8 RendererComponentAsset::validatePayload()const{
    if(!checkVirtualPath(NWB_TEXT("RendererComponentAsset::validatePayload")))
        return false;
    return GraphicsComponentBinaryCodec{}.validateRenderer(component, virtualPath());
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

