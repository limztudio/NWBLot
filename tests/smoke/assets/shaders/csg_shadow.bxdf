half3 NWB_DEFERRED_BXDF_FUNCTION(NwbBxdfSurface surface, int2 pixel){
    // The receiver displays the actual shadow output independently of GI, radiance and BRDF terms.
    return nwbSceneLightCount() == 1u ? nwbBxdfLightTransmittance(pixel, 0u) : half3(1.0h, 0.0h, 1.0h);
}


