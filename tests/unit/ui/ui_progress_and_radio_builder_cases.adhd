void VerifyUiProgressBuilderTests_VerticalIndeterminateAndCenteredLabelRenderCorrectly(mut UiProgressBuilderTests self){
    ASSERT_TRUE(self.panel(1u));
    ProgressOptions options = ProgressOptions();
    options.width.policy = LayoutSizePolicy::Fixed;
    options.width.value = 180.0f;
    options.height = 36.0f;
    options.indeterminate = true;
    options.indeterminatePhase = 0.25;
    options.label = "75%";
    ASSERT_TRUE(self.m_builder.progress("indeterminate", 0.0, options));
    ASSERT_TRUE(self.finishPanel());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    const auto track = self.sampleTrackRegion(snapshot);
    const auto fill = self.sampleFillRegion(snapshot);
    ASSERT_TRUE(track.has_value());
    ASSERT_TRUE(fill.has_value());
    EXPECT_GT(fill.value().bounds.x, track.value().bounds.x + 4.0f);
    EXPECT_LT(fill.value().bounds.width, track.value().bounds.width - 8.0f);
    usize glyphCommands = 0u;
    for(in DrawCommand command : snapshot.commands()){
        if(command.material == PaintMaterial::Glyph || command.material == PaintMaterial::SdfGlyph)
            ++glyphCommands;
    }
    EXPECT_GT(glyphCommands, 0u);
}

void VerifyUiProgressLayoutTests_VerticalAndIndeterminatePhaseWrapAndNanReject(){
    UiSkinRegion track;
    track.rectangle = UiSkinRect(0u, 0u, 16u, 16u);
    track.minimumWidth = 8.0f;
    track.minimumHeight = 8.0f;
    UiSkinRegion fill = track;
    ProgressOptions invalid = ProgressOptions();
    invalid.indeterminate = true;
    const u64 quietNanBits = 0x7ff8000000000000u;
    invalid.indeterminatePhase = bit_cast<f64>(quietNanBits);
    EXPECT_FALSE(MeasureProgress(invalid, ProgressStyle(), track, fill, 1.0f).has_value());
    invalid.indeterminatePhase = 0.0;
    invalid.orientation = cast<ProgressOrientation>(9u);
    EXPECT_FALSE(MeasureProgress(invalid, ProgressStyle(), track, fill, 1.0f).has_value());

    ProgressOptions vertical = ProgressOptions();
    vertical.orientation = ProgressOrientation::Vertical;
    vertical.height = 100.0f;
    const Expected<ProgressMetrics> metrics = MeasureProgress(vertical, ProgressStyle(), track, fill, 1.0f);
    ASSERT_TRUE(metrics.has_value());
    const Rect bounds = Rect(10.0f, 20.0f, 24.0f, 100.0f);
    const Expected<ProgressPlacement> empty = PlaceProgress(bounds, bounds, metrics.value(), 0.0);
    const Expected<ProgressPlacement> quarter = PlaceProgress(bounds, bounds, metrics.value(), 0.25);
    ASSERT_TRUE(empty.has_value());
    ASSERT_TRUE(quarter.has_value());
    EXPECT_FLOAT_EQ(empty.value().fillReveal.height, 0.0f);
    EXPECT_FLOAT_EQ(quarter.value().fillReveal.height, 25.0f);
    EXPECT_FLOAT_EQ(quarter.value().fillReveal.y, 95.0f);

    const Expected<ProgressPlacement> indStart = PlaceProgress(bounds, bounds, metrics.value(), 0.0, true, 0.0);
    const Expected<ProgressPlacement> indMid = PlaceProgress(bounds, bounds, metrics.value(), 0.0, true, 0.5);
    const Expected<ProgressPlacement> indNeg = PlaceProgress(bounds, bounds, metrics.value(), 0.0, true, -0.5);
    ASSERT_TRUE(indStart.has_value());
    ASSERT_TRUE(indMid.has_value());
    ASSERT_TRUE(indNeg.has_value());
    EXPECT_FLOAT_EQ(indStart.value().fillReveal.y, 90.0f);
    EXPECT_FLOAT_EQ(indMid.value().fillReveal.y, 20.0f);
    EXPECT_FLOAT_EQ(indNeg.value().fillReveal.y, 20.0f);
}


