[move_only]
class CachedEditBoxView{
    public EditBoxView view;
    public TextAreaModelStamp modelStamp;
    public String language;
    public u64 textIdentity = 0u;
    public u64 textGeneration = 0u;
    public u64 atlasIdentity = 0u;
    public usize atlasGlyphCount = 0u;
    public u32 fontSizeBits = 0u;
    public u32 scriptTag = 0u;
    public u32 maskCodePoint = s_EditBoxDefaultMaskCodePoint;
    public TextDirection direction = TextDirection::LeftToRight;
    public u32 pixelScaleXBits = 0u;
    public u32 pixelScaleYBits = 0u;
    public u32 wrapWidthBits = 0u;
    public u32 tabStopSpaces = s_TextDefaultTabStopSpaces;
    public TextWrapMode wrapMode = TextWrapMode::None;
    public b8 preserveWrapSpaces = false;
    public b8 password = false;
    public b8 valid = false;

    public b8 matchesShape(in TextAreaModelStamp stamp, in u64 textId, in u64 textGen, in u32 sizeBits, in u32 script, in StringView lang, in TextDirection dir, in b8 pass, in u32 mask)const{
        return this.matchesShape(stamp, textId, textGen, sizeBits, script, lang, dir, pass, mask, TextWrapMode::None, 0u, s_TextDefaultTabStopSpaces, false);
    }

    public b8 matchesShape(
        in TextAreaModelStamp stamp,
        in u64 textId,
        in u64 textGen,
        in u32 sizeBits,
        in u32 script,
        in StringView lang,
        in TextDirection dir,
        in b8 pass,
        in u32 mask,
        in TextWrapMode mode,
        in u32 wrapBits,
        in u32 tabSpaces,
        in b8 keepWrapSpaces
    )const{
        return this.valid
            && this.modelStamp == stamp
            && this.textIdentity == textId
            && this.textGeneration == textGen
            && this.fontSizeBits == sizeBits
            && this.scriptTag == script
            && this.direction == dir
            && this.password == pass
            && this.maskCodePoint == mask
            && this.wrapMode == mode
            && this.wrapWidthBits == wrapBits
            && this.tabStopSpaces == tabSpaces
            && this.preserveWrapSpaces == keepWrapSpaces
            && StringView(this.language) == lang;
    }

    public b8 matchesMeasure(in u32 scaleXBits, in u32 scaleYBits, in u64 atlasId, in usize atlasGlyphs)const{
        return this.pixelScaleXBits == scaleXBits
            && this.pixelScaleYBits == scaleYBits
            && this.atlasIdentity == atlasId
            && this.atlasGlyphCount == atlasGlyphs;
    }
}

