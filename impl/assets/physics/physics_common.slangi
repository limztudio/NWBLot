};

struct NwbPhysicsGpuNarrowphaseManifold{
    uint4 pairInfo;
    float4 normalPad;
    float4 anchorAFeature[NWB_PHYSICS_MAX_MANIFOLD_POINTS];
    float4 anchorBSeparation[NWB_PHYSICS_MAX_MANIFOLD_POINTS];
};

struct NwbPhysicsGpuContactPoint{
    float4 rABaseSep;
    float4 rBRelVel;
};

struct NwbPhysicsGpuBodyOut{
    float4 positionSleepTime;
    float4 rotation;
    float4 linearVelocityFlags;
    float4 angularVelocityPad;
};

struct NwbPhysicsGpuContactImpulseOut{
    float4 frictionTwistRollX;
    float4 rollYZMaxApproach;
    float4 normalImpulses;
    float4 totalNormalImpulses;
};

struct NwbPhysicsGpuJointImpulseOut{
    float4 linearImpulseMax;
    float4 angularImpulseMax;
    float4 limitImpulses;
};

struct NwbPhysicsGpuIslandSlice{
