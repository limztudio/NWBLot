////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SCENE_LIGHTING_SLANGI
#define NWB_GRAPHICS_SCENE_LIGHTING_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../common/math.slangi"
#include "buffer.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Test-only caustic path override.
#ifndef NWB_CAUSTIC_DEBUG_FORCE_GREY
#define NWB_CAUSTIC_DEBUG_FORCE_GREY 0
#endif

// Engine-owned scene-light transport limits. Keep these tunables here rather than in binding_slots.h: the latter is
// included by C++ as well, while these values intentionally use Slang half/half3 expressions. Project BXDFs own
// BRDF and tone-map policy.
#ifndef NWB_SCENE_CAUSTIC_DEBUG_IRRADIANCE
#define NWB_SCENE_CAUSTIC_DEBUG_IRRADIANCE half3(0.15h, 0.15h, 0.15h)
#endif

#ifndef NWB_SCENE_LIGHT_RADIANCE_COLOR_MAX
#define NWB_SCENE_LIGHT_RADIANCE_COLOR_MAX 1.5h
#endif
#ifndef NWB_SCENE_LIGHT_RADIANCE_INTENSITY_MAX
#define NWB_SCENE_LIGHT_RADIANCE_INTENSITY_MAX 2.0h
#endif
#ifndef NWB_SCENE_LIGHT_RANGE_MIN
#define NWB_SCENE_LIGHT_RANGE_MIN 0.0001
#endif

// Per-light transmittance and black-cleared additive caustic irradiance.
#if !defined(NWB_SCENE_SHADOW_CAUSTIC_SAMPLING_DISABLED)
#if !defined(NWB_SCENE_SHADOW_VISIBILITY_RESOURCE) || !defined(NWB_SCENE_CAUSTIC_IRRADIANCE_RESOURCE)
#error "Renderer screen-space shadow and caustic inputs require global descriptor-heap aliases"
#endif
#endif

// Dedicated resolve keeps the writable surfel pool off deferred lighting.

// Shadow slots store colored transmittance; absent slots are fully lit.
half3 nwbBxdfLightTransmittance(int2 pixel, uint lightIndex){
#ifdef NWB_SCENE_SHADOW_CAUSTIC_SAMPLING_DISABLED
    return half3(1.0h, 1.0h, 1.0h);
#else
    // Negative pixels bypass opaque-G-buffer shadow sampling.
    if(pixel.x < 0)
        return half3(1.0h, 1.0h, 1.0h);

    const float slot = g_NwbSceneLights[lightIndex].params.z;
    if(slot < 0.0)
        return half3(1.0h, 1.0h, 1.0h);

    return half3(NWB_SCENE_SHADOW_VISIBILITY_RESOURCE.Load(int4(pixel, int(slot), 0)).rgb);
#endif
}

// Black is the additive caustic no-op; negative pixels bypass opaque-G-buffer sampling.
half3 nwbBxdfCausticIrradiance(int2 pixel){
#if NWB_CAUSTIC_DEBUG_FORCE_GREY
    return NWB_SCENE_CAUSTIC_DEBUG_IRRADIANCE;
#elif defined(NWB_SCENE_SHADOW_CAUSTIC_SAMPLING_DISABLED)
    return half3(0.0h, 0.0h, 0.0h);
#else
    if(pixel.x < 0)
        return half3(0.0h, 0.0h, 0.0h);

    return half3(NWB_SCENE_CAUSTIC_IRRADIANCE_RESOURCE.Load(int3(pixel, 0)).rgb);
#endif
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void nwbSceneResolveLight(NwbSceneLight light, float3 worldPosition, out float3 lightVector, out half3 radiance){
    const half3 baseRadiance = clamp(half3(light.colorIntensity.xyz), half3(0.0h), half3(NWB_SCENE_LIGHT_RADIANCE_COLOR_MAX))
        * clamp(half(light.colorIntensity.w), half(0.0h), half(NWB_SCENE_LIGHT_RADIANCE_INTENSITY_MAX));
    const float lightType = light.params.y;

    if(lightType < NWB_SCENE_LIGHT_TYPE_DIRECTIONAL_MAX){
        lightVector = nwbSafeNormalize(light.direction.xyz, float3(0.0, 0.0, -1.0));
        radiance = baseRadiance;
        return;
    }

    const float3 toLight = light.position.xyz - worldPosition;
    lightVector = nwbSafeNormalize(toLight, float3(0.0, 0.0, -1.0));

    const float range = max(light.params.x, NWB_SCENE_LIGHT_RANGE_MIN);
    half attenuation = half(saturate(1.0 - length(toLight) / range));
    attenuation *= attenuation;

    if(lightType > NWB_SCENE_LIGHT_TYPE_POINT_MAX){
        const float innerConeCos = light.position.w;
        const float outerConeCos = light.direction.w;
        const float3 emission = nwbSafeNormalize(light.direction.xyz, float3(0.0, 0.0, -1.0));
        attenuation *= half(smoothstep(outerConeCos, innerConeCos, dot(-lightVector, emission)));
    }

    radiance = baseRadiance * attenuation;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Configurable hemispherical ambient fallback.
#ifndef NWB_GI_HEMI_AMBIENT_SKY
#define NWB_GI_HEMI_AMBIENT_SKY half3(0.045h, 0.055h, 0.075h)
#endif
#ifndef NWB_GI_HEMI_AMBIENT_GROUND
#define NWB_GI_HEMI_AMBIENT_GROUND half3(0.008h, 0.012h, 0.02h)
#endif
half3 nwbGiHemiAmbient(float3 normalVector){
    const half skyAmount = half(normalVector.z * 0.5 + 0.5);
    return lerp(NWB_GI_HEMI_AMBIENT_GROUND, NWB_GI_HEMI_AMBIENT_SKY, skyAmount);
}

// Transparent and null-coverage indirect-light fallback.
half3 nwbBxdfIndirectIrradiance(float3 worldPosition, float3 normalVector){
    return nwbGiHemiAmbient(normalVector);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

