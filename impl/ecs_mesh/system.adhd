#include <impl/assets_mesh/asset.adhd>
#include <impl/ecs_mesh/components.adhd>
#include <impl/ecs_mesh/runtime/mesh.adhd>
#include <impl/ecs_mesh/runtime/mesh_requests.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena, system("mesh")]
class MeshSystem : IRuntimeMeshRegistry{
    private mut World m_world;
    private Vector<mut IRuntimeMeshProvider> m_runtimeMeshProviders;

    public MeshSystem(mut World world){
        this.m_world = world;
        this.readAccess<MeshComponent>();
        this.readAccess<SkinnedMeshBindingComponent>();
    }

    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta)override{
        return Expected<void, CpuTaskAdmissionError>();
    }

    public Expected<AssetRef<Mesh>> resolveMesh(in EntityID entity)const{
        if(!this.m_world.hasComponent<MeshComponent>(entity))
            return MakeUnexpected(Failure());

        const MeshComponent mesh = this.m_world.getComponent<MeshComponent>(entity);
        if(!mesh.mesh.valid())
            return MakeUnexpected(Failure());

        return mesh.mesh;
    }

    // Distinguish non-rendering owners from temporarily unavailable meshes.
    public Expected<RenderableMeshDesc, RenderableMeshResolution> resolveRenderableMeshStatus(in EntityID entity)const{
        RenderableMeshDesc mesh;

        for(usize i = 0u; i < this.m_runtimeMeshProviders.size(); ++i){
            const Expected<RuntimeMeshDesc> runtimeMesh = this.m_runtimeMeshProviders[i].resolveRuntimeMesh(entity);
            if(runtimeMesh.has_value() && runtimeMesh.value().valid()){
                mesh.runtimeMesh = runtimeMesh.value();
                mesh.runtime = true;
                return mesh;
            }
        }

        const Expected<AssetRef<Mesh>> meshAsset = this.resolveMesh(entity);
        if(!meshAsset.has_value())
            return MakeUnexpected(ClassifyRenderableMeshFailure(this.m_world.hasComponent<MeshComponent>(entity), this.hasRuntimeMeshBinding(entity)));

        mesh.mesh = meshAsset.value();
        return mesh;
    }

    public b8 hasRuntimeMeshBinding(in EntityID entity)const{
        if(this.m_world.hasComponent<SkinnedMeshBindingComponent>(entity))
            return true;
        for(usize i = 0u; i < this.m_runtimeMeshProviders.size(); ++i){
            if(this.m_runtimeMeshProviders[i].hasRuntimeMeshBinding(entity))
                return true;
        }
        return false;
    }

    public void markLiveRuntimeMeshes(mut RuntimeMeshRequestSet requests)const{
        for(usize i = 0u; i < this.m_runtimeMeshProviders.size(); ++i){
            if(requests.complete())
                return;

            this.m_runtimeMeshProviders[i].markLiveRuntimeMeshes(requests);
        }
    }

    public void registerRuntimeMeshProvider(mut IRuntimeMeshProvider provider)override{
        for(usize i = 0u; i < this.m_runtimeMeshProviders.size(); ++i){
            if(SameAddress(this.m_runtimeMeshProviders[i], provider))
                return;
        }

        this.m_runtimeMeshProviders.push_back(provider);
    }

    public void unregisterRuntimeMeshProvider(mut IRuntimeMeshProvider provider)override{
        for(usize i = 0u; i < this.m_runtimeMeshProviders.size(); ++i){
            if(SameAddress(this.m_runtimeMeshProviders[i], provider)){
                this.m_runtimeMeshProviders.erase(this.m_runtimeMeshProviders.begin() + i);
                return;
            }
        }
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
