void VerifyClipboardAsync_PendingNativeRequestPreservesFifoAndCopiedWriteInput(){
    DelayedClipboardContext ctx = DelayedClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> firstAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(firstAdmission.has_value());
    const ClipboardRequestToken first = firstAdmission.value();
    AssignGlobalString(ctx.scratch, "copied write");
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> secondAdmission = ctx.service.requestWriteText(ClipboardChannel::Clipboard, ViewGlobalString(ctx.scratch));
    ASSERT_TRUE(secondAdmission.has_value());
    const ClipboardRequestToken second = secondAdmission.value();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> thirdAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(thirdAdmission.has_value());
    const ClipboardRequestToken third = thirdAdmission.value();
    AssignGlobalString(ctx.scratch, "changed caller input");

    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.m_nativeToken, first);
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.m_startCount, 1u);
    EXPECT_EQ(ctx.service.poll(second, ctx.completion), ClipboardPollResult::Pending);
    ASSERT_TRUE(ctx.service.deliver(first, ClipboardStatus::Success, "first result"));
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.m_nativeToken, second);
    EXPECT_EQ(ctx.service.m_nativeOperation, ClipboardOperation::WriteText);
    EXPECT_EQ(ctx.service.m_startedText, "copied write");
    ASSERT_TRUE(ctx.service.deliver(second, ClipboardStatus::Success));
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.m_nativeToken, third);
    EXPECT_EQ(ctx.service.m_startCount, 3u);
    ASSERT_TRUE(ctx.service.deliver(third, ClipboardStatus::Success, "third result"));

    ASSERT_EQ(ctx.service.poll(first, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.text, "first result");
    ASSERT_EQ(ctx.service.poll(second, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.operation, ClipboardOperation::WriteText);
    EXPECT_TRUE(ctx.completion.text.empty());
    ASSERT_EQ(ctx.service.poll(third, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.text, "third result");
}

void VerifyClipboardAsync_CancellationReleasesFifoAndLateNativeRepliesCannotCompleteReplacement(){
    DelayedClipboardContext ctx = DelayedClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> oldAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(oldAdmission.has_value());
    const ClipboardRequestToken old = oldAdmission.value();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> nextAdmission = ctx.service.requestWriteText(ClipboardChannel::Clipboard, "next");
    ASSERT_TRUE(nextAdmission.has_value());
    const ClipboardRequestToken next = nextAdmission.value();
    ASSERT_TRUE(ctx.service.pump());
    ASSERT_TRUE(ctx.service.cancel(old));
    EXPECT_EQ(ctx.service.m_cancelCount, 1u);
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> replacementAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(replacementAdmission.has_value());
    const ClipboardRequestToken replacement = replacementAdmission.value();
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.m_nativeToken, next);
    EXPECT_FALSE(ctx.service.deliver(old, ClipboardStatus::Success, "stale bytes"));
    EXPECT_EQ(ctx.service.poll(old, ctx.completion), ClipboardPollResult::InvalidRequest);
    ASSERT_TRUE(ctx.service.deliver(next, ClipboardStatus::Success));
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.m_nativeToken, replacement);
    EXPECT_FALSE(ctx.service.deliver(old, ClipboardStatus::Success, "stale bytes"));
    EXPECT_EQ(ctx.service.poll(replacement, ctx.completion), ClipboardPollResult::Pending);
    ASSERT_TRUE(ctx.service.deliver(replacement, ClipboardStatus::Success, "replacement bytes"));
    ASSERT_EQ(ctx.service.poll(replacement, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.text, "replacement bytes");
}

void VerifyClipboardAsync_CancellationInvalidatesTokenBeforeReentrantNativeCleanup(){
    DelayedClipboardContext ctx = DelayedClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> oldAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(oldAdmission.has_value());
    const ClipboardRequestToken old = oldAdmission.value();
    ASSERT_TRUE(ctx.service.pump());
    ClipboardRequestToken replacement = ClipboardRequestToken();
    b8 observedCancellation = false;
    native(mut ctx, in old, mut replacement, mut observedCancellation){
        ctx.service.m_onCancel = [&]() {
            if(observedCancellation)
                return;
            observedCancellation = true;
            EXPECT_FALSE(ctx.service.cancel(old));
            EXPECT_EQ(ctx.service.poll(old, ctx.completion), ClipboardPollResult::InvalidRequest);
            EXPECT_FALSE(ctx.service.deliver(old, ClipboardStatus::Success, "late during cancellation"));
            const auto replacementAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
            ASSERT_TRUE(replacementAdmission);
            replacement = *replacementAdmission;
        };
        ASSERT_NO_FATAL_FAILURE(ASSERT_TRUE(ctx.service.cancel(old)));
        ctx.service.m_onCancel = {};
    }
    EXPECT_TRUE(observedCancellation);
    EXPECT_EQ(ctx.service.m_cancelCount, 1u);
    ASSERT_TRUE(replacement.valid());
    EXPECT_EQ(ctx.service.poll(replacement, ctx.completion), ClipboardPollResult::Pending);
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.m_nativeToken, replacement);
    ASSERT_TRUE(ctx.service.deliver(replacement, ClipboardStatus::Success, "survives cleanup"));
    ASSERT_EQ(ctx.service.poll(replacement, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.text, "survives cleanup");
}

void VerifyClipboardAsync_ReentrantStartCancellationDefersNewGenerationToNextPump(){
    DelayedClipboardContext ctx = DelayedClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> oldAdmission = ctx.service.requestWriteText(ClipboardChannel::Clipboard, "old input");
    ASSERT_TRUE(oldAdmission.has_value());
    const ClipboardRequestToken old = oldAdmission.value();
    ClipboardRequestToken replacement = ClipboardRequestToken();
    native(mut ctx, in old, mut replacement){
        ctx.service.m_onStart = [&]() {
            if(ctx.service.m_nativeToken != old)
                return;
            ASSERT_TRUE(ctx.service.cancel(old));
            const auto replacementAdmission = ctx.service.requestWriteText(ClipboardChannel::Clipboard, "new input");
            ASSERT_TRUE(replacementAdmission);
            replacement = *replacementAdmission;
            EXPECT_FALSE(ctx.service.deliver(old, ClipboardStatus::Success));
            EXPECT_FALSE(ctx.service.pump());
        };
        ASSERT_NO_FATAL_FAILURE(ASSERT_TRUE(ctx.service.pump()));
        ctx.service.m_onStart = {};
    }
    EXPECT_EQ(ctx.service.m_startCount, 1u);
    EXPECT_EQ(ctx.service.poll(old, ctx.completion), ClipboardPollResult::InvalidRequest);
    EXPECT_EQ(ctx.service.poll(replacement, ctx.completion), ClipboardPollResult::Pending);
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.m_startCount, 2u);
    EXPECT_EQ(ctx.service.m_nativeToken, replacement);
    EXPECT_EQ(ctx.service.m_startedText, "new input");
    ASSERT_TRUE(ctx.service.deliver(replacement, ClipboardStatus::Success));
}

void VerifyClipboardAsync_DelayedRepliesValidateUtf8AndOwnTheirCompletionBytes(){
    DelayedClipboardContext ctx = DelayedClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> invalidAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(invalidAdmission.has_value());
    const ClipboardRequestToken invalid = invalidAdmission.value();
    ASSERT_TRUE(ctx.service.pump());
    ASSERT_TRUE(ctx.service.deliver(invalid, ClipboardStatus::Success, "\xF0\x9F"));
    ASSERT_EQ(ctx.service.poll(invalid, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.status, ClipboardStatus::InvalidText);
    EXPECT_TRUE(ctx.completion.text.empty());

    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> validAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(validAdmission.has_value());
    const ClipboardRequestToken valid = validAdmission.value();
    ASSERT_TRUE(ctx.service.pump());
    AssignGlobalString(ctx.scratch, "\xED\x95\x9C\xF0\x9F\x98\x80");
    ASSERT_TRUE(ctx.service.deliver(valid, ClipboardStatus::Success, ViewGlobalString(ctx.scratch)));
    AssignGlobalString(ctx.scratch, "changed source");
    ASSERT_EQ(ctx.service.poll(valid, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.status, ClipboardStatus::Success);
    EXPECT_EQ(ctx.completion.text, "\xED\x95\x9C\xF0\x9F\x98\x80");
    EXPECT_FALSE(ctx.service.deliver(valid, ClipboardStatus::Success, "duplicate reply"));
}


