[modular, move_only]
class RefractionStatisticsReadbackGraphTask{
    public BufferHandle source;
    public BufferHandle destination;
    public GpuGraphResourceId sourceResource;
    public GpuGraphResourceId destinationResource;
    public RefractionStatisticsReservation reservation;
    private in b8 hardwareReady;
    private b8 hardwareEnabled;

    public RefractionStatisticsReadbackGraphTask(in RefractionStatisticsReadbackSnapshot snapshot, in borrow b8 ready, in b8 enabled){
        this.source = snapshot.counters;
        this.reservation = StatisticsReservation<RefractionStatistics, RefractionStatisticsOutcome>(snapshot.control, snapshot.metadata);
        this.hardwareReady = ready;
        this.hardwareEnabled = enabled;
    }

    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements requirements;
        requirements.requiredCapabilities = GpuQueueCapability::Transfer;
        requirements.requiresPrimaryGraphicsQueue = true;
        return requirements;
    }
    [cpp_unwind]
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const;
    public void accepted(in QueueSubmissionToken token){ this.reservation.acceptReservation(token, this.hardwareEnabled && this.hardwareReady); }
    public void discarded(){ this.reservation.discard(); }
}

class RefractionClassifyTilesGraphTask{
    private mut RefractionRenderer renderer;
    private in DeferredFrameTargets targets;
    private RayTracingRefractionGraphResources resources;

    public RefractionClassifyTilesGraphTask(mut RefractionRenderer renderer, in borrow DeferredFrameTargets targets, in RayTracingRefractionGraphResources resources){
        this.renderer = renderer;
        this.targets = targets;
        this.resources = resources;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }
    [cpp_unwind]
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const{
        return this.renderer.recordRefractionTileClassification(commands, this.targets, this.resources);
    }
}

[modular]
class RefractionResolveGraphTask{
    private mut RendererRayTracingSystem system;
    private in DeferredFrameTargets targets;
    private RayTracingRefractionGraphResources resources;
    private in b8 hardwareReady;
    private mut b8 hardwareLogged;
    private mut b8 screenLogged;
    private b8 diagnostics;

    public RefractionResolveGraphTask(mut RendererRayTracingSystem system, in borrow DeferredFrameTargets targets, in RayTracingRefractionGraphResources resources,
        in borrow b8 ready, mut b8 hardwareLogged, mut b8 screenLogged, in b8 diagnostics){
        this.system = system;
        this.targets = targets;
        this.resources = resources;
        this.hardwareReady = ready;
        this.hardwareLogged = hardwareLogged;
        this.screenLogged = screenLogged;
        this.diagnostics = diagnostics;
    }

    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements requirements;
        requirements.requiredCapabilities = GpuQueueCapability::Compute;
        requirements.requiresPrimaryGraphicsQueue = this.diagnostics;
        return requirements;
    }
    [cpp_unwind]
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const;
    [cpp_unwind]
    public void accepted(in QueueSubmissionToken token);
}

class FrameGraphRefractionResolveInputs{
    public mut DeferredFrameTargets targets;
    public in RayTracingSceneGraphResources sceneResources;
    public in RayTracingRefractionGraphResources refractionResources;
    public b8 refractionActive = false;
    public GpuGraphResourceId depth;
    public GpuGraphResourceId worldPosition;
    public GpuGraphResourceId refractionDepth;
    public GpuGraphResourceId refractionNormalIor;
    public GpuGraphResourceId refractionTintCoverage;
    public GpuGraphResourceId refractionInstance;
    public GpuGraphResourceId refractionResolve;
    public GpuGraphResourceId opaqueColor;
    public GpuGraphResourceId opaqueReflectionRadiance;
    public GpuGraphResourceId meshView;
    public GpuGraphResourceId currentBindlessSlots;
    public GpuGraphResourceId sceneShading;
    public GpuGraphResourceId lights;
    public GpuGraphResourceId avboitAccumColor;
    public GpuGraphResourceId avboitAccumExtinction;
    public GpuGraphResourceId avboitForegroundColor;
    public GpuGraphResourceId avboitForegroundExtinction;
    public GpuGraphResourceSetId hardwareTraceGeometrySet;
    public GpuGraphResourceSetId traceMaterialSampledTextureSet;
    public GpuTaskId traceContextUploadTask;
    public GpuTaskId reflectionCompletionTask;
    public GpuTaskId avboitFinalTask;
    public GpuTaskId surfelGiTask;
    public in b8 hardwarePreparationReady;
    public mut b8 refractionHardwareLogged;
    public mut b8 refractionScreenLogged;

    public FrameGraphRefractionResolveInputs(
        mut DeferredFrameTargets targets,
        in RayTracingSceneGraphResources sceneResources,
        in RayTracingRefractionGraphResources refractionResources,
        in b8 hardwarePreparationReady,
        mut b8 refractionHardwareLogged,
        mut b8 refractionScreenLogged
    ){
        this.targets = targets;
        this.sceneResources = sceneResources;
        this.refractionResources = refractionResources;
        this.hardwarePreparationReady = hardwarePreparationReady;
        this.refractionHardwareLogged = refractionHardwareLogged;
        this.refractionScreenLogged = refractionScreenLogged;
    }
}

[modular]
class FrameGraphRefractionResolve : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut GraphicsRuntime m_graphics;
    private mut RendererRayTracingSystem m_raytracingSystem;

    public FrameGraphRefractionResolve(mut GpuTaskGraph graph, mut GraphicsRuntime graphics, mut RendererRayTracingSystem system){
        this.m_graph = graph;
        this.m_graphics = graphics;
        this.m_raytracingSystem = system;
    }
    [cpp_unwind]
    public Expected<GpuTaskId> declare(in FrameGraphRefractionResolveInputs inputs, mut RayTracingSceneGraphReads sceneReads);
}


b8 IsRefractionHardwareDispatchReady(in b8 hardwareEnabled, in b8 hasPreparationFlag, in b8 preparationReady){
    return hardwareEnabled && hasPreparationFlag && preparationReady;
}

usize ComputeRefractionResolveResourceUseCapacity(in usize inputCount, in usize sceneUseCount, in usize csgUseCount){
    return inputCount + s_RefractionFixedUseCapacity + sceneUseCount + csgUseCount;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RefractionClearTileArgumentsGraphTask{
    private mut GraphicsRuntime m_graphics;
    private BufferHandle m_destination;
    private GpuGraphResourceId m_resource;

    public RefractionClearTileArgumentsGraphTask(mut GraphicsRuntime graphics, in BufferHandle destination, in GpuGraphResourceId resource){
        this.m_graphics = graphics;
        this.m_destination = destination;
        this.m_resource = resource;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Transfer); }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        const GpuGraphResourceId resource = this.m_resource;
        if(!CaptureGpuTaskCommandsIfEnabled(context, lambda[in context, in resource](mut GpuCommandIrCapture capture) -> b8{
            return capture.captureClearBuffer(context.task, context.packet, context.queue, resource, 0u);
        }))
            return false;
        commandList.endRenderPass();
        GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeRefractionClearTileArguments, this.m_graphics.getDevice(), commandList);
        commandList.clearBufferUInt(this.m_destination.deref(), 0u);
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Diagnostic counter writes and readback share the resolve's primary graphics queue.
class RefractionClearStatisticsGraphTask{
    private BufferHandle m_destination;
    private GpuGraphResourceId m_resource;

    public RefractionClearStatisticsGraphTask(in BufferHandle destination, in GpuGraphResourceId resource){
        this.m_destination = destination;
        this.m_resource = resource;
    }

    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements commands;
        commands.requiredCapabilities = GpuQueueCapability::Transfer;
        commands.requiresPrimaryGraphicsQueue = true;
        return commands;
    }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_destination.valid())
            return false;
        const GpuGraphResourceId resource = this.m_resource;
        if(!CaptureGpuTaskCommandsIfEnabled(context, lambda[in context, in resource](mut GpuCommandIrCapture capture) -> b8{
            return capture.captureClearBuffer(context.task, context.packet, context.queue, resource, 0u);
        }))
            return false;
        commandList.endRenderPass();
        commandList.clearBufferUInt(this.m_destination.deref(), 0u);
        return !commandList.commandRecordingFailed();
    }
}


