////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ShadowTraceGeometryBackendSelection{
    public b8 includeHardware = false;
    public b8 includeSoftware = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanEnableSurfelSceneTrace(in b8 backendReady, in u32 instanceCount, in u32 meshCount){
    return backendReady && instanceCount > 0u && meshCount > 0u;
}

b8 CanCompleteSoftwareMeshBuildsAtRecord(in b8 buildPlanFrozen, in b8 meshSwBvhBuildsGraphOwned, in b8 preparedMeshSwBvhBuildsRecordedByGraph){
    if(!buildPlanFrozen)
        return false;
    if(meshSwBvhBuildsGraphOwned && !preparedMeshSwBvhBuildsRecordedByGraph)
        return false;
    return true;
}

b8 ResolveSoftTransparentTemporalReady(in b8 softTransparentReady, in b8 softShadowTemporalReady){
    return softTransparentReady && softShadowTemporalReady;
}

ShadowTraceGeometryBackendSelection ResolveShadowTraceGeometryBackendSelection(in b8 hardwareSupported, in b8 traceResourcesPreflighted){
    ShadowTraceGeometryBackendSelection selection;
    selection.includeHardware = hardwareSupported && traceResourcesPreflighted;
    selection.includeSoftware = !hardwareSupported && traceResourcesPreflighted;
    return selection;
}

b8 AreSurfelSplitGraphPipelinesReady(
    in b8 ageFreeReady,
    in b8 hashBuildReady,
    in b8 spawnReady,
    in b8 useHwTrace,
    in b8 useCsgTrace,
    in b8 traceCsgHwReady,
    in b8 traceHwReady,
    in b8 traceCsgSwReady,
    in b8 traceSwReady,
    in b8 resolveReady,
    in b8 upsampleReady,
    in b8 traceBuildArgsReady
){
    b8 traceReady = false;
    if(useHwTrace){
        if(useCsgTrace)
            traceReady = traceCsgHwReady;
        else
            traceReady = traceHwReady;
    }
    else{
        if(useCsgTrace)
            traceReady = traceCsgSwReady;
        else
            traceReady = traceSwReady;
    }
    return ageFreeReady && hashBuildReady && spawnReady && traceReady && resolveReady && upsampleReady && traceBuildArgsReady;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
b8 RendererRayTracingSystem::preflightShadowVisibilityResources(mut DeferredFrameTargets targets){
    RayTraceMaterialResources materialResources(this.m_graphics, this.m_rayTracingState.sceneBvh, this.m_rayTracingState.shadow);
        this.m_rayTracingState.shadow.m_softwareTransparentSampling.m_history.prepareScene(RayTracingSceneContentStamp());
    this.m_lightSpaceShadow.m_captureHistory.beginFrame();
    this.m_lightSpaceShadow.m_captureSceneTrusted = false;
    this.m_lightSpaceShadow.m_sceneBuffers.clear();
    this.m_lightSpaceShadow.m_sceneTextures.clear();
    this.m_lightSpaceShadow.m_snapshot.captureTicket = LightSpaceCaptureTicket();
    this.m_lightSpaceShadow.m_snapshot.ready = false;
    this.m_lightSpaceShadow.m_frozenSnapshot.reset();
    this.m_lightSpaceShadow.m_preflightedLightsValid = false;
    this.m_lightSpaceShadow.m_preflightedPlanValid = false;
    this.m_lightSpaceShadow.m_resourcesPrepared = false;
    this.m_lightSpaceShadow.m_sceneEligible = false;
    this.m_lightSpaceShadow.m_casters.clear();
    this.m_shadowVisibilityPreparedTargets.reset();
    this.m_preparedSceneContentStamp = RayTracingSceneContentStamp();
    this.m_hardwareOpticalScene.resetPrepared();
    this.m_softwareOpticalScene.resetPrepared();
    this.m_shadowVisibilityResourcesPreflighted = false;
    this.m_shadowVisibilityHardwareSupported = false;
    this.m_opticalCausticReaderAdmitted = false;
    this.m_shadowVisibilityTraceResourcesPreflighted = false;
    this.m_shadowVisibilityBackendPipelinePreflighted = false;
    this.clearPreparedShadowTraceMaterialSampledTextures();
    this.clearPreparedShadowMaterialContext();
    this.clearPreparedSceneBvh();
    this.m_preparedSceneTlas.clear();
    this.clearPreparedMeshBlasBuilds();
    this.clearPreparedMeshSwBvhBuilds();
    this.m_rayTracingState.m_hardwareTransparentShadow.m_ready = false;
    this.m_rayTracingState.softShadow.m_softTransparentReady = false;
    this.m_rayTracingState.softShadow.m_softTransparentTemporalReady = false;
    this.m_rayTracingState.surfelGi.m_surfelEnabled = false;
    this.m_rayTracingState.surfelGi.m_surfelUseHwTrace = false;
    if(!targets.shadowVisibility)
        return false;
    if(!materialResources.ensureRayTraceMaterialContextSlotsBuffer())
        return false;

    if(!this.prepareCausticEmissionTargetResources())
        warning("RendererSystem: caustic emission-target gather failed");

    ShadowPipelineSet shadowPipelines(this.m_graphics, this.m_shaderSystem, this.m_rayTracingState.shadow, this.m_rayTracingState.softShadow);
    this.m_shadowVisibilityHardwareSupported = this.m_graphics.queryFeatureSupport(Feature::RayTracingAccelStruct) && this.m_graphics.queryFeatureSupport(Feature::RayQuery);
    if(this.m_shadowVisibilityHardwareSupported){
        if(!this.preparePendingMeshBlasResources()){
            if(!materialResources.ensureRayTraceMaterialContextSlotsHeapHandle())
                return false;
            this.m_shadowVisibilityPreparedTargets = Optional<mut DeferredFrameTargets>(targets);
            this.m_shadowVisibilityResourcesPreflighted = true;
            return true;
        }

        const b8 sceneReady = this.prepareSceneTlasResources();
        if(!sceneReady){
            if(!materialResources.ensureRayTraceMaterialContextSlotsHeapHandle())
                return false;
            this.m_shadowVisibilityPreparedTargets = Optional<mut DeferredFrameTargets>(targets);
            this.m_shadowVisibilityResourcesPreflighted = true;
            return true;
        }
        if(!this.ensureCsgTraceContextResources())
            return false;

        if(!this.capturePreparedMeshBlasBuilds()){
            warning("RendererSystem: could not freeze hardware BLAS build plan");
            this.m_preparedSceneTlas.clear();
            return false;
        }
        this.m_shadowVisibilityTraceResourcesPreflighted = true;
        const b8 backendReady = shadowPipelines.ensureShadowPipeline();
        this.m_shadowVisibilityBackendPipelinePreflighted = backendReady;

        this.m_rayTracingState.softShadow.m_softShadowReady = backendReady && shadowPipelines.ensureShadowSoftPipeline() && shadowPipelines.ensureShadowGeometryDownsamplePipeline() && shadowPipelines.ensureSoftShadowResolvePipeline();
        if(backendReady && !this.m_rayTracingState.softShadow.m_softShadowReady)
            warning("RendererSystem: HW soft opaque shadow resource preparation failed; HW shadows fall back to the full-res trace this frame");

        this.m_rayTracingState.softShadow.m_softShadowTemporalReady = this.m_rayTracingState.softShadow.m_softShadowReady && shadowPipelines.ensureShadowReprojectMergePipeline();
        if(this.m_rayTracingState.softShadow.m_softShadowReady && !this.m_rayTracingState.softShadow.m_softShadowTemporalReady)
            warning("RendererSystem: HW soft opaque shadow temporal resource preparation failed; no temporal accumulation this frame");

        HardwareTransparentShadowResources transparentResources(this.m_graphics, this.m_shaderSystem, this.m_rayTracingState.m_hardwareTransparentShadow);
        this.m_rayTracingState.softShadow.m_softTransparentReady = this.m_rayTracingState.softShadow.m_softShadowReady && this.m_rayTracingState.sceneBvh.m_sceneHasTransparentOccluder
            && transparentResources.prepareHardwareTransparentShadowResources(targets) && shadowPipelines.ensureSoftTransparentResolvePipeline();
        if(this.m_rayTracingState.softShadow.m_softShadowReady && this.m_rayTracingState.sceneBvh.m_sceneHasTransparentOccluder && !this.m_rayTracingState.softShadow.m_softTransparentReady)
            warning("RendererSystem: hardware transparent shadow resource preparation failed; colored shadows unavailable this frame");

        this.m_rayTracingState.softShadow.m_softTransparentTemporalReady = ResolveSoftTransparentTemporalReady(this.m_rayTracingState.softShadow.m_softTransparentReady, this.m_rayTracingState.softShadow.m_softShadowTemporalReady);

        shadowPipelines.prepareSoftCombinedResolvePipelines();

        if(!this.prepareHwCausticResources(targets))
            warning("RendererSystem: hardware caustic producer resource preparation failed");

        if(CanEnableSurfelSceneTrace(backendReady, this.m_rayTracingState.sceneBvh.m_tlasInstanceCount, this.m_rayTracingState.shadow.m_shadowMeshCount)){
            this.m_rayTracingState.surfelGi.m_surfelEnabled = true;
            this.m_rayTracingState.surfelGi.m_surfelUseHwTrace = true;
            if(!this.prepareSurfelResources(targets))
                warning("RendererSystem: HW surfel GI resource preparation failed");
        }

        if(!materialResources.ensureRayTraceMaterialContextSlotsHeapHandle())
            return false;
        this.m_shadowVisibilityPreparedTargets = Optional<mut DeferredFrameTargets>(targets);
        this.preflightLightSpaceShadowResources();
        if(this.m_lightSpaceShadow.m_csgRequired && !this.m_lightSpaceShadow.m_resourcesPrepared){
            error("RendererSystem: CSG shadow map preparation failed");
            return false;
        }
        this.m_shadowVisibilityResourcesPreflighted = true;
        return true;
    }

    const b8 meshResourcesReady = this.preparePendingMeshSwBvhResources();
    if(!meshResourcesReady)
        warning("RendererSystem: software shadow BVH resource preparation failed");
    if(!meshResourcesReady || !this.prepareSceneSwBvhResources()){
        warning("RendererSystem: software shadow scene BVH build failed");
        this.m_shadowVisibilityPreparedTargets = Optional<mut DeferredFrameTargets>(targets);
        this.m_shadowVisibilityResourcesPreflighted = true;
        return true;
    }
    if(!this.ensureCsgTraceContextResources())
        return false;

    if(CanEnableSurfelSceneTrace(true, this.m_rayTracingState.sceneBvh.m_sceneBvhInstanceCount, this.m_rayTracingState.shadow.m_swShadowMeshCount)){
        this.m_rayTracingState.surfelGi.m_surfelEnabled = true;
        this.m_rayTracingState.surfelGi.m_surfelUseHwTrace = false;
        if(!this.prepareSurfelResources(targets))
            warning("RendererSystem: surfel GI resource preparation failed");
    }

    if(this.m_rayTracingState.sceneBvh.m_sceneBvhInstanceCount == 0u){
        if(!materialResources.ensureRayTraceMaterialContextSlotsHeapHandle())
            return false;
        this.m_shadowVisibilityPreparedTargets = Optional<mut DeferredFrameTargets>(targets);
        this.m_shadowVisibilityResourcesPreflighted = true;
        return true;
    }
    if(!this.capturePreparedMeshSwBvhBuilds()){
        warning("RendererSystem: could not freeze software BVH mesh build plan");
        return false;
    }
    this.m_shadowVisibilityTraceResourcesPreflighted = true;

    const b8 backendReady = shadowPipelines.ensureSwShadowPipeline();
    this.m_shadowVisibilityBackendPipelinePreflighted = backendReady;

    this.m_rayTracingState.softShadow.m_softShadowReady = backendReady && shadowPipelines.ensureShadowGeometryDownsamplePipeline() && shadowPipelines.ensureSoftShadowResolvePipeline();
    if(backendReady && !this.m_rayTracingState.softShadow.m_softShadowReady)
        warning("RendererSystem: soft opaque shadow resource preparation failed; shadows hard this frame");

    this.m_rayTracingState.softShadow.m_softShadowTemporalReady = this.m_rayTracingState.softShadow.m_softShadowReady && shadowPipelines.ensureShadowReprojectMergePipeline();
    if(this.m_rayTracingState.softShadow.m_softShadowReady && !this.m_rayTracingState.softShadow.m_softShadowTemporalReady)
        warning("RendererSystem: soft opaque shadow temporal resource preparation failed; no temporal accumulation this frame");

    this.m_rayTracingState.softShadow.m_softTransparentReady = this.m_rayTracingState.softShadow.m_softShadowReady && shadowPipelines.ensureSoftTransparentResolvePipeline();
    if(this.m_rayTracingState.softShadow.m_softShadowReady && !this.m_rayTracingState.softShadow.m_softTransparentReady)
        warning("RendererSystem: soft transparent shadow resource preparation failed; colored shadows fall back to the hard-ish path this frame");

    this.m_rayTracingState.softShadow.m_softTransparentTemporalReady = ResolveSoftTransparentTemporalReady(this.m_rayTracingState.softShadow.m_softTransparentReady, this.m_rayTracingState.softShadow.m_softShadowTemporalReady);

    shadowPipelines.prepareSoftCombinedResolvePipelines();

    if(!this.prepareGpuBvhCausticResources(targets))
        warning("RendererSystem: software caustic producer resource preparation failed");

    if(!materialResources.ensureRayTraceMaterialContextSlotsHeapHandle())
        return false;
    this.m_shadowVisibilityPreparedTargets = Optional<mut DeferredFrameTargets>(targets);
    this.preflightLightSpaceShadowResources();
    if(this.m_lightSpaceShadow.m_csgRequired && !this.m_lightSpaceShadow.m_resourcesPrepared){
        error("RendererSystem: CSG shadow map preparation failed");
        return false;
    }
    this.m_shadowVisibilityResourcesPreflighted = true;
    return true;
}

[cpp_unwind]
Expected<b8> RendererRayTracingSystem::recordPreflightShadowVisibilityResources(
    mut CommandList commandList,
    mut DeferredFrameTargets targets,
    in b8 sceneTlasBuildGraphOwned,
    in b8 meshBlasBuildsGraphOwned,
    in b8 meshBlasGeometryBuildInputStatesGraphOwned,
    in b8 meshSwBvhBuildsGraphOwned,
    in b8 preparedMeshSwBvhBuildsRecordedByGraph
){
    if(!this.m_shadowVisibilityResourcesPreflighted || (!this.m_shadowVisibilityPreparedTargets.has_value() || !SameAddress(this.m_shadowVisibilityPreparedTargets.value(), targets)))
        return MakeUnexpected(Failure());

    if(!this.m_shadowVisibilityTraceResourcesPreflighted)
        return false;

    if(this.m_shadowVisibilityHardwareSupported){
        if(meshBlasBuildsGraphOwned && !this.recordPreparedMeshBlasBuilds(commandList, meshBlasGeometryBuildInputStatesGraphOwned))
            return MakeUnexpected(Failure());
        if(sceneTlasBuildGraphOwned && !this.m_preparedSceneTlas.record(this.m_rayTracingState, commandList))
            return MakeUnexpected(Failure());
        return this.m_shadowVisibilityBackendPipelinePreflighted;
    }

    if(!CanCompleteSoftwareMeshBuildsAtRecord(this.m_preparedMeshSwBvhBuildPlanFrozen, meshSwBvhBuildsGraphOwned, preparedMeshSwBvhBuildsRecordedByGraph)){
        warning("RendererSystem: software shadow mesh builds have no frozen graph completion");
        return MakeUnexpected(Failure());
    }
    if(!this.m_preparedSceneSwBvhTraversal.ready()){
        warning("RendererSystem: software shadow scene has no frozen preflight traversal");
        return MakeUnexpected(Failure());
    }
    if(!this.recordPreparedSceneSwBvhTraversal())
        return MakeUnexpected(Failure());
    if(this.m_rayTracingState.sceneBvh.m_sceneBvhInstanceCount == 0u){
        this.m_rayTracingState.surfelGi.m_surfelEnabled = false;
        this.m_rayTracingState.surfelGi.m_surfelUseHwTrace = false;
        return false;
    }

    return this.m_shadowVisibilityBackendPipelinePreflighted;
}

void RendererRayTracingSystem::discardPreflightShadowVisibilityResources(){
    this.invalidateLightSpaceShadowCapture();
    this.m_lightSpaceShadow.m_frozenSnapshot.reset();
    this.m_lightSpaceShadow.m_preflightedLightsValid = false;
    this.m_lightSpaceShadow.m_preflightedPlanValid = false;
    this.m_rayTracingState.shadow.m_softwareTransparentSampling.m_history.discard();
    this.m_preparedShadowTraceGeometryBuffers.clear();
    this.clearPreparedShadowTraceMaterialSampledTextures();
    this.m_preparedCausticEmissionTargetBytes.clear();
    this.clearPreparedShadowMaterialContext();
    this.clearPreparedSceneBvh();
    this.m_preparedSceneTlas.clear();
    this.clearPreparedMeshBlasBuilds();
    this.clearPreparedMeshSwBvhBuilds();
    this.m_shadowVisibilityPreparedTargets.reset();
    this.m_preparedSceneContentStamp = RayTracingSceneContentStamp();
    this.m_hardwareOpticalScene.resetPrepared();
    this.m_softwareOpticalScene.resetPrepared();
    this.m_shadowVisibilityResourcesPreflighted = false;
    this.m_shadowVisibilityHardwareSupported = false;
    this.m_opticalCausticReaderAdmitted = false;
    this.m_shadowVisibilityTraceResourcesPreflighted = false;
    this.m_shadowVisibilityBackendPipelinePreflighted = false;

    this.m_rayTracingState.sceneBvh.m_tlasStaticSceneHashValid = false;
    this.m_rayTracingState.sceneBvh.m_sceneSwBvhStaticSceneHashValid = false;
    this.m_rayTracingState.shadow.m_hwShadowMaterialContextHashValid = false;
    this.m_rayTracingState.shadow.m_swShadowMaterialContextHashValid = false;
    this.m_rayTracingState.surfelGi.m_surfelEnabled = false;
    this.m_rayTracingState.surfelGi.m_surfelUseHwTrace = false;
    this.m_sceneGatherScratch.clear();

    this.m_meshSystem.discardRayTracingBuildState();
}

[cpp_unwind]
b8 RendererRayTracingSystem::freezePreparedShadowTraceGeometryBuffers(){
    this.m_preparedShadowTraceGeometryBuffers.clear();
    if(!this.m_shadowVisibilityResourcesPreflighted)
        return false;

    mut MeshRayTracingResourceSnapshotVector meshes = this.m_sceneGatherScratch.rayTracingSnapshots;
    this.m_meshSystem.collectRayTracingResourceSnapshots(meshes);

    const ShadowTraceGeometryBackendSelection backendSelection = ResolveShadowTraceGeometryBackendSelection(this.m_shadowVisibilityHardwareSupported, this.m_shadowVisibilityTraceResourcesPreflighted);
    ShadowTraceGeometrySelection selection;
    selection.hardwarePositions = this.m_rayTracingState.shadow.m_shadowMeshPositionBuffers;
    selection.hardwareIndices = this.m_rayTracingState.shadow.m_shadowMeshIndexBuffers;
    selection.hardwareAttributes = this.m_rayTracingState.shadow.m_shadowMeshAttributeBuffers;
    selection.softwareNodes = this.m_rayTracingState.shadow.m_swShadowMeshNodeBuffers;
    selection.softwarePositions = this.m_rayTracingState.shadow.m_swShadowMeshPositionBuffers;
    selection.softwareIndices = this.m_rayTracingState.shadow.m_swShadowMeshIndexBuffers;
    selection.softwareAttributes = this.m_rayTracingState.shadow.m_swShadowMeshAttributeBuffers;
    selection.includeHardware = backendSelection.includeHardware;
    selection.includeSoftware = backendSelection.includeSoftware;
    const b8 frozen = FreezePreparedShadowTraceGeometryBuffers(meshes, selection, this.m_acceptedShadowTraceGeometryBuffers, this.m_preparedShadowTraceGeometryBuffers);
    meshes.clear();
    return frozen;
}

void RendererRayTracingSystem::confirmPreparedShadowTraceGeometryNormalization(){
    for(mut PreparedShadowTraceGeometryBuffer resource : this.m_preparedShadowTraceGeometryBuffers){
        if(resource.buffer.valid() && resource.normalizationPending){
            assert(this.m_acceptedShadowTraceGeometryBuffers.size() < this.m_acceptedShadowTraceGeometryBuffers.capacity());
            this.m_acceptedShadowTraceGeometryBuffers.push_back(resource.buffer);
            resource.normalizationPending = false;
        }
    }
}

void RendererRayTracingSystem::invalidatePreparedShadowTraceGeometryBuffers(){
    this.m_preparedShadowTraceGeometryBuffers.clear();
    this.m_acceptedShadowTraceGeometryBuffers.clear();
    this.clearPreparedShadowTraceMaterialSampledTextures();
}

void RendererRayTracingSystem::confirmPreparedSceneBvhUploads(){
    if(this.m_preparedSceneBvh.publishAcceptedUpload(this.m_rayTracingState))
        this.clearPreparedSceneBvh();
}

ResourceStates RendererRayTracingSystem::sceneTlasBackingInitialState()const{
    in RendererRayTracingState state = this.m_rayTracingState;
    if(state.sceneBvh.m_tlasBackingFresh)
        return ResourceStates::Common;
    return ResourceStates::Unknown;
}

[cpp_unwind]
b8 RendererRayTracingSystem::capturePreparedSceneBvh(in b8 staticScene, in u64 staticSceneHash, in Span<NwbBvhNodeGpu> nodes, in Span<SceneSwBvhInstanceGpu> instances){
    this.clearPreparedSceneBvh();
    return this.m_preparedSceneBvh.capture(this.m_rayTracingState, staticScene, staticSceneHash, nodes, instances);
}

b8 RendererRayTracingSystem::capturePreparedSceneBvhCacheReuse(in u64 staticSceneHash, in u32 instanceCount){
    this.clearPreparedSceneBvh();
    return this.m_preparedSceneBvh.captureCacheReuse(this.m_rayTracingState, staticSceneHash, instanceCount);
}

void RendererRayTracingSystem::clearPreparedSceneBvh(){
    this.m_preparedSceneSwBvhRefit.reset();
    this.m_preparedSceneSwBvhTraversal.clear();
    this.m_preparedSceneBvh.clear();
}

[cpp_unwind]
void RendererRayTracingSystem::invalidateResources(){
    RayTraceMaterialResources materialResources(this.m_graphics, this.m_rayTracingState.sceneBvh, this.m_rayTracingState.shadow);
    SoftwareBvhBuilder bvh(this.m_graphics, this.m_shaderSystem, this.m_rayTracingState.sceneBvh);
    this.discardPreflightShadowVisibilityResources();
    this.invalidatePreparedShadowTraceGeometryBuffers();
    this.m_hardwareOpticalScene.invalidate();
    this.m_softwareOpticalScene.invalidate();
    this.m_preparedSceneSwBvhRefit.reset();
    this.m_sceneSwBvhRefit.invalidate();
    this.releaseSceneTlasHeapHandle();
    this.releaseCausticEmissionTargetHeapHandle();
    CausticActivityResources activity(this.m_graphics, this.m_rayTracingState.caustics.m_causticResolve.m_activity);
    activity.releaseCausticResolveActivity();
    materialResources.releaseRayTraceMaterialContextHeapHandles();
    bvh.releaseSwBvhScratchHeapHandles();
    this.releaseSurfelGiHeapHandles();
    HardwareTransparentShadowResources transparentResources(this.m_graphics, this.m_shaderSystem, this.m_rayTracingState.m_hardwareTransparentShadow);
    transparentResources.releaseHardwareTransparentShadowResources();
    LightSpaceResourceSet resources(this.m_graphics, this.m_shaderSystem, this.m_lightSpaceShadow, this.m_shadowVisibilityHardwareSupported);
    resources.releaseLightSpaceShadowResources();
    this.m_refraction.invalidateResources();
    this.m_rayTracingState.invalidateResources();
}

[cpp_unwind]
void RendererRayTracingSystem::releaseSceneTlasHeapHandle(){
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    if(heap.isInitialized()){
        RetireDescriptor(heap, this.m_rayTracingState.sceneBvh.m_tlasHeapHandle);
        return;
    }
    this.m_rayTracingState.sceneBvh.m_tlasHeapHandle = GpuDescriptorHandleInvalid();
}

RayTracingLightingClassificationInput RendererRayTracingSystem::snapshotLightingClassificationInput()const{
    RayTracingLightingClassificationInput result;
    result.refractiveInstanceCount = this.m_rayTracingState.caustics.m_causticRefractiveInstanceCount;
    return result;
}

[cpp_unwind]
void RendererRayTracingSystem::publishPreparedLightingClassification(in RayTracingLightingClassification classification, in Span<SceneLightGpuData> lights){
    RayTracingDiagnostics diagnostics;
    this.m_rayTracingState.caustics.m_causticLightCount = classification.causticLightCount;
    diagnostics.unsupportedCausticVolumes(
        this.m_shadowVisibilityTraceResourcesPreflighted,
        classification.causticLightCount,
        this.m_unsupportedCausticVolumeCount,
        this.m_unsupportedCausticVolumeHash,
        this.m_firstUnsupportedCausticVolumeEntity,
        this.m_unsupportedCausticVolumeReported,
        this.m_reportedUnsupportedCausticVolumeHash
    );
    this.m_rayTracingState.softShadow.m_softShadowSlotMask = classification.softShadowSlotMask;
    this.m_rayTracingState.shadow.m_softwareTransparentSampling.m_history.prepareLighting(lights);
    this.prepareLightSpaceShadows(lights);

    diagnostics.causticEmissionGate(
        classification.causticLightCount,
        this.m_rayTracingState.caustics.m_causticRefractiveInstanceCount,
        LoadFloat(this.m_rayTracingState.caustics.m_causticTargetBoundsMin),
        LoadFloat(this.m_rayTracingState.caustics.m_causticTargetBoundsMax),
        lights,
        this.m_rayTracingState.caustics.m_causticEmissionGateLogged
    );
}

RayTracingShadowPreparationResourceSnapshot RendererRayTracingSystem::snapshotShadowPreparationResources()const{
    RayTracingShadowPreparationResourceSnapshot snapshot;
    snapshot.sceneTlas = this.m_rayTracingState.sceneBvh.m_tlas;
    if(this.m_rayTracingState.sceneBvh.m_tlas.valid())
        snapshot.sceneTlasBackingBuffer = this.m_rayTracingState.sceneBvh.m_tlas.deref().getBackingBufferHandle();
    if(!this.m_shadowVisibilityHardwareSupported){
        snapshot.bvhSortKeysBuffer = this.m_rayTracingState.sceneBvh.m_bvhSortKeysBuffer;
        snapshot.bvhSortPayloadBuffer = this.m_rayTracingState.sceneBvh.m_bvhSortPayloadBuffer;
        snapshot.bvhVisitCounterBuffer = this.m_rayTracingState.sceneBvh.m_bvhVisitCounterBuffer;
        snapshot.swShadowEdgeCounterBuffer = this.m_rayTracingState.shadow.m_swShadowEdgeCounterBuffer;
        snapshot.swShadowEdgeListBuffer = this.m_rayTracingState.shadow.m_swShadowEdgeListBuffer;
        snapshot.swShadowIndirectArgsBuffer = this.m_rayTracingState.shadow.m_swShadowIndirectArgsBuffer;
    }
    return snapshot;
}

RayTracingDeferredGraphResourceSnapshot RendererRayTracingSystem::snapshotDeferredGraphResources()const{
    in RendererRayTracingState state = this.m_rayTracingState;
    const b8 hasCsgTrace = this.m_shadowVisibilityTraceResourcesPreflighted && this.m_lightSpaceShadow.m_csg.snapshot.hasCsg;
    usize contextReadTokenCount = 0u;
    for(in QueueSubmissionToken token : state.shadow.m_rayTraceContextReadSubmissionTokens){
        if(token.valid()){
            contextReadTokenCount = state.shadow.m_rayTraceContextReadSubmissionTokens.size();
            break;
        }
    }
    RayTracingDeferredGraphResourceSnapshot snapshot;
    snapshot.materialContextSlotsBuffer = state.sceneBvh.m_rayTraceMaterialContextSlotsBuffer;
    if(hasCsgTrace)
        snapshot.csgTraceContextBuffer = state.sceneBvh.m_csgTraceContextBuffer;
    if(contextReadTokenCount != 0u)
        snapshot.rayTraceContextReadSubmissionTokens = Span<QueueSubmissionToken>(state.shadow.m_rayTraceContextReadSubmissionTokens).first(contextReadTokenCount);
    if(hasCsgTrace)
        snapshot.csgTraceBoundsBuffers = Span<BufferHandle>(this.m_lightSpaceShadow.m_csg.dynamicBounds);
    snapshot.shadowInstanceMaterialBuffer = state.shadow.m_shadowInstanceMaterialBuffer;
    snapshot.shadowMaterialTypedBuffer = state.shadow.m_shadowMaterialTypedBuffer;
    snapshot.shadowInstanceBuffer = state.shadow.m_shadowInstanceBuffer;
    snapshot.causticEmissionTargetBuffer = state.caustics.m_causticEmissionTargets.buffer;
    snapshot.surfelFrameConstantsBuffer = state.surfelGi.m_surfelConstants;
    snapshot.hardwareTransparentCrossingsBuffer = state.m_hardwareTransparentShadow.m_crossingsBuffer;
    snapshot.hardwareTransparentOverflowListBuffer = state.m_hardwareTransparentShadow.m_overflowListBuffer;
    snapshot.hardwareTransparentOverflowArgsBuffer = state.m_hardwareTransparentShadow.m_overflowArgsBuffer;
    if(!this.m_shadowVisibilityHardwareSupported){
        snapshot.sceneBvhNodeBuffer = state.sceneBvh.m_sceneBvhNodeBuffer;
        snapshot.sceneInstanceBuffer = state.sceneBvh.m_sceneInstanceBuffer;
    }
    snapshot.sceneTlas = state.sceneBvh.m_tlas;
    snapshot.causticAccumulatorInitialized = state.caustics.m_causticAccumulatorInitialized;
    snapshot.surfelUsesHardwareTrace = state.surfelGi.m_surfelUseHwTrace;
    snapshot.surfelSplitGraphPipelinesReady = AreSurfelSplitGraphPipelinesReady(
        state.surfelGi.m_surfelAgeFreePipeline.valid(),
        state.surfelGi.m_surfelHashBuildPipeline.valid(),
        state.surfelGi.m_surfelSpawnPipeline.valid(),
        state.surfelGi.m_surfelUseHwTrace,
        state.surfelGi.m_surfelUseCsgTrace,
        state.surfelGi.m_surfelTraceCsgHwPipeline.valid(),
        state.surfelGi.m_surfelTraceHwPipeline.valid(),
        state.surfelGi.m_surfelTraceCsgPipeline.valid(),
        state.surfelGi.m_surfelTracePipeline.valid(),
        state.surfelGi.m_surfelResolvePipeline.valid(),
        state.surfelGi.m_surfelUpsamplePipeline.valid(),
        state.surfelGi.m_surfelTraceBuildArgsPipeline.valid()
    );
    return snapshot;
}

[cpp_unwind]
void RendererRayTracingSystem::logCapabilityOnce(){
    RayTracingDiagnostics diagnostics;
    diagnostics.rayTracingCapability(
        this.m_graphics.queryFeatureSupport(Feature::RayTracingAccelStruct),
        this.m_graphics.queryFeatureSupport(Feature::RayTracingPipeline),
        this.m_graphics.queryFeatureSupport(Feature::RayQuery),
        this.m_rayTracingState.sceneBvh.m_capabilityLogged
    );
}


