#include <impl/ecs_render/shadow/quality_settings.adhd>
#include <impl/ecs_render/shared/frame_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_ShadowCaptureReuseLimitOneFrame = 1u;
const u32 s_ShadowCaptureReuseLimitTwoFrames = 2u;
const u32 s_ShadowDefaultDirectionalResolution = 512u;
const u32 s_ShadowDefaultPointResolution = 256u;
const u64 s_ShadowDefaultMemoryBudgetBytes = 268435456ull;
const u32 s_ShadowMinResolution = 32u;
const u32 s_ShadowMaxResolution = 2048u;
const u64 s_ShadowMaxMemoryBudgetBytes = 4294967295ull;
// A point light renders one view per cube face.
const u32 s_SceneMaxLights = 64u;
const u32 s_PointLightViewCount = 6u;
const usize s_LightSpaceMaxViews = 48u;
const u64 s_LightSpaceEventsPerTexel = 16u;
const u64 s_LightSpaceEventBytes = 20u;
const u64 s_LightSpacePixelWordBytes = 4u;
const u64 s_LightSpaceViewBytes = 128u;
const u64 s_LightSpaceDrawArgumentBytes = 20u;
const u8 s_LightSpaceLightTypeDirectional = 0u;
const u8 s_LightSpaceLightTypePoint = 1u;
const u8 s_LightSpaceLightTypeSpot = 2u;
const u8 s_LightSpaceLightTypeCount = 3u;
const u32 s_LightSpaceInvalidGpuDescriptorSlot = 0xffffffffu;
const u32 s_LightSpaceMeshletsPerDraw = 32u;
const u32 s_LightSpaceTriangleCornerCount = 3u;
const u32 s_LightSpaceCsgRayContextBytes = 32u;
const u32 s_LightSpaceCsgShadowFlagHwCompose = 2u;
const u32 s_LightSpaceCsgRayFailureUnsupported = 1u;
const u32 s_LightSpaceCsgRayFailureCapacity = 2u;
const u32 s_LightSpaceCsgRayFailureTopology = 4u;
const u32 s_LightSpaceCsgRayFailureOpenCapacity = 16u;
const u32 s_LightSpaceDiagnosticInterval = 60u;
const u32 s_LightSpaceMaxIndirectDraws = 65535u;
const usize s_LightSpaceShaderCount = 14u;
const StringView s_LightSpaceNoCsgOccluder0 = "NWB_LIGHT_SPACE_CSG_ENABLED=0;NWB_LIGHT_SPACE_OCCLUDER=0";
const StringView s_LightSpaceNoCsgOccluder1 = "NWB_LIGHT_SPACE_CSG_ENABLED=0;NWB_LIGHT_SPACE_OCCLUDER=1";
const StringView s_LightSpaceCsgShade0 = "NWB_LIGHT_SPACE_CSG_SHADE=0";
const StringView s_LightSpaceCsgShade1 = "NWB_LIGHT_SPACE_CSG_SHADE=1";
const StringView s_LightSpaceCsgOccluder0 = "NWB_LIGHT_SPACE_CSG_ENABLED=1;NWB_LIGHT_SPACE_OCCLUDER=0";
const StringView s_LightSpaceCsgOccluder1 = "NWB_LIGHT_SPACE_CSG_ENABLED=1;NWB_LIGHT_SPACE_OCCLUDER=1";
// Inclusive index ranges into the compute shader/pipeline tables of ensureLightSpaceShadowPipelines.
const u32 s_LightSpaceFirstCsgOnlyPipelineIndex = 6u;
const u32 s_LightSpaceLastCsgOnlyPipelineIndex = 10u;
const u32 s_LightSpaceFirstCsgResolvePipelineIndex = 7u;
const u32 s_LightSpaceLastCsgResolvePipelineIndex = 8u;
const u32 s_LightSpaceFirstCsgFallbackPipelineIndex = 9u;
const u32 s_LightSpaceLastCsgFallbackPipelineIndex = 10u;
const u32 s_LightSpaceCaptureVertexShaderIndex = 12u;
const u32 s_LightSpaceCapturePixelShaderIndex = 13u;
const u32 s_LightSpaceCapturePipelineKindCount = 2u;
const u32 s_LightSpaceCountsBufferIndex = 0u;
const u32 s_LightSpaceEventsBufferIndex = 1u;
const u32 s_LightSpaceViewsBufferIndex = 2u;
const u32 s_LightSpaceDrawArgumentsBufferIndex = 3u;
const u32 s_LightSpaceDepthDescriptorIndex = 4u;
const usize s_LightSpaceBufferCount = 4u;
const usize s_LightSpaceDescriptorCount = 5u;
const Name s_LightSpaceDiagnosticsIdentity = "render.light_space_shadow.diagnostics";
const StringView s_LightSpaceDiagnosticsLabel = "CSG Shadow Diagnostics";
const Name s_LightSpaceViewUploadIdentity = "render.light_space_shadow.view_upload";
const StringView s_LightSpaceViewUploadLabel = "Light-Space View Upload";
const usize s_LightSpaceFixedResourceUseCount = 5u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
enum<u8> SoftwareShadowBackend{
    Automatic,
    SoftwareTrace,
    LightSpace
}

[reflect]
enum<u8> SoftwareShadowCoverage{
    Reference,
    FittedVolume
}

[reflect]
enum<u8> SoftwareShadowBlockerSearch{
    ReferenceGrid9,
    CompactCross5,
    Center1
}

[reflect]
enum<u8> SoftwareShadowCaptureCadence{
    EveryFrame,
    ReuseOneFrame,
    ReuseTwoFrames
}

flag<u32> LightSpaceFlag{
    None = 0u,
    Point,
    Eligible,
    FittedCoverage,
    CompactBlockers,
    CenterBlocker
}

[reflect]
class SoftwareShadowSettings{
    public SoftwareShadowBackend backend = SoftwareShadowBackend::Automatic;
    public SoftwareShadowCoverage coverage = SoftwareShadowCoverage::Reference;
    public SoftwareShadowBlockerSearch blockerSearch = SoftwareShadowBlockerSearch::ReferenceGrid9;
    public SoftwareShadowCaptureCadence captureCadence = SoftwareShadowCaptureCadence::EveryFrame;
    public u32 directionalResolution = s_ShadowDefaultDirectionalResolution;
    public u32 pointResolution = s_ShadowDefaultPointResolution;
    public u64 memoryBudgetBytes = s_ShadowDefaultMemoryBudgetBytes;
}

class LightSpaceCaptureIdentity{
    public u64 scene = 0u;
    public u64 lighting = 0u;
    public u64 layout = 0u;
    public b8 trusted = false;
}

class LightSpaceCaptureTicket{
    public b8 valid()const{
        return this.sequence != 0u;
    }

    public u64 sequence = 0u;
    public b8 reuse = false;
}

// A capture publishes only after its complete native packet and retained resource states are accepted.
class LightSpaceCaptureHistory{
    public void beginFrame(){
        // A skipped or rejected frame cannot extend the lifetime of the prior map generation.
        if(!this.m_frameAccepted)
            this.m_accepted = false;
        this.m_pendingTicket = LightSpaceCaptureTicket();
        this.m_captureRecorded = false;
        this.m_frameAccepted = false;
    }

    public LightSpaceCaptureTicket prepare(in LightSpaceCaptureIdentity identity, in SoftwareShadowCaptureCadence cadence){
        if(cadence == SoftwareShadowCaptureCadence::ReuseTwoFrames)
            this.m_pendingReuseLimit = cast<u8>(s_ShadowCaptureReuseLimitTwoFrames);
        else if(cadence == SoftwareShadowCaptureCadence::ReuseOneFrame)
            this.m_pendingReuseLimit = cast<u8>(s_ShadowCaptureReuseLimitOneFrame);
        else
            this.m_pendingReuseLimit = 0u;
        const b8 reuse =
            this.m_acceptedReuseCount < this.m_pendingReuseLimit
            && this.m_accepted
            && identity.trusted
            && this.m_acceptedIdentity.trusted
            && identity.scene == this.m_acceptedIdentity.scene
            && identity.lighting == this.m_acceptedIdentity.lighting
            && identity.layout == this.m_acceptedIdentity.layout
        ;
        advanceWrappingNonzeroU64(this.m_sequence);
        this.m_pendingIdentity = identity;
        this.m_pendingTicket.sequence = this.m_sequence;
        this.m_pendingTicket.reuse = reuse;
        this.m_captureRecorded = false;
        // Refresh writes the maps in place. Their old identity must be unavailable even if recording or submission fails.
        if(!reuse)
            this.m_accepted = false;
        return this.m_pendingTicket;
    }

    public void recordCapture(in LightSpaceCaptureTicket ticket){
        if(ticket.valid() && ticket.sequence == this.m_pendingTicket.sequence && !ticket.reuse && !this.m_pendingTicket.reuse)
            this.m_captureRecorded = true;
    }

    public b8 accept(in LightSpaceCaptureTicket ticket){
        if(!ticket.valid() || ticket.sequence != this.m_pendingTicket.sequence || ticket.reuse != this.m_pendingTicket.reuse)
            return false;
        if(ticket.reuse){
            if(!this.m_accepted || this.m_acceptedReuseCount >= this.m_pendingReuseLimit)
                return false;
            ++this.m_acceptedReuseCount;
            ++this.m_acceptedReuses;
        }
        else{
            if(!this.m_captureRecorded)
                return false;
            this.m_acceptedIdentity = this.m_pendingIdentity;
            this.m_accepted = this.m_pendingIdentity.trusted;
            this.m_acceptedReuseCount = 0u;
            ++this.m_acceptedCaptures;
        }
        this.m_pendingTicket = LightSpaceCaptureTicket();
        this.m_frameAccepted = true;
        return true;
    }

    public void invalidate(){
        this.m_accepted = false;
        this.m_pendingTicket = LightSpaceCaptureTicket();
        this.m_captureRecorded = false;
        this.m_frameAccepted = false;
    }

    public u64 acceptedCaptures()const{
        return this.m_acceptedCaptures;
    }

    public u64 acceptedReuses()const{
        return this.m_acceptedReuses;
    }

    public u32 acceptedReuseAge()const{
        return cast<u32>(this.m_acceptedReuseCount);
    }

    private LightSpaceCaptureIdentity m_acceptedIdentity;
    private LightSpaceCaptureIdentity m_pendingIdentity;
    private LightSpaceCaptureTicket m_pendingTicket;
    private u64 m_sequence = 0u;
    private u64 m_acceptedCaptures = 0u;
    private u64 m_acceptedReuses = 0u;
    private u8 m_acceptedReuseCount = 0u;
    private u8 m_pendingReuseLimit = 0u;
    private b8 m_accepted = false;
    private b8 m_captureRecorded = false;
    private b8 m_frameAccepted = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateSoftwareShadowSettings(in SoftwareShadowSettings settings){
    return
        cast<u8>(settings.backend) <= cast<u8>(SoftwareShadowBackend::LightSpace)
        && cast<u8>(settings.coverage) <= cast<u8>(SoftwareShadowCoverage::FittedVolume)
        && cast<u8>(settings.blockerSearch) <= cast<u8>(SoftwareShadowBlockerSearch::Center1)
        && cast<u8>(settings.captureCadence) <= cast<u8>(SoftwareShadowCaptureCadence::ReuseTwoFrames)
        && settings.directionalResolution >= s_ShadowMinResolution && settings.directionalResolution <= s_ShadowMaxResolution
        && settings.pointResolution >= s_ShadowMinResolution && settings.pointResolution <= s_ShadowMaxResolution
        && settings.memoryBudgetBytes > 0ull && settings.memoryBudgetBytes <= s_ShadowMaxMemoryBudgetBytes
    ;
}

b8 SameSoftwareShadowSettings(in SoftwareShadowSettings first, in SoftwareShadowSettings second){
    return
        first.backend == second.backend
        && first.coverage == second.coverage
        && first.blockerSearch == second.blockerSearch
        && first.captureCadence == second.captureCadence
        && first.directionalResolution == second.directionalResolution
        && first.pointResolution == second.pointResolution
        && first.memoryBudgetBytes == second.memoryBudgetBytes
    ;
}

u32 ResolveSoftwareShadowRequiredReuses(in SoftwareShadowCaptureCadence cadence){
    if(cadence == SoftwareShadowCaptureCadence::ReuseTwoFrames)
        return s_ShadowCaptureReuseLimitTwoFrames;
    return s_ShadowCaptureReuseLimitOneFrame;
}


