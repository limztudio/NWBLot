void VerifyUiTextAreaNavigationTests_FailedContextRejectsAnOtherwiseCurrentBorrow(mut UiTextAreaNavigationTests self){
    ASSERT_TRUE(self.m_model.setText("MM\nMM"));
    TextAreaNavigationResolver resolver = TextAreaNavigationResolver(self.m_arena, self.m_text, self.m_context, self.m_state, 14.0f);
    const u64 revision = self.m_model.revision();
    const EditNavigationSnapshot preferred = self.m_state.navigation().snapshot();
    self.m_context.fail();
    EXPECT_FALSE(resolver.resolve(self.m_model, EditNavigationDirection::Down, preferred, 160.0f).has_value());
    EXPECT_EQ(self.m_model.revision(), revision);
    EXPECT_TRUE(self.m_state.navigation().matches(preferred));
}

void VerifyUiTextAreaNavigationTests_ShapeFailurePreservesModelAndViewportIntent(mut UiTextAreaNavigationTests self){
    ASSERT_TRUE(self.m_model.setText("MM\nMM"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 1u));
    ASSERT_TRUE(self.m_state.scrollTo(Point(5.0f, 20.0f)));
    TextService empty = TextService(self.m_arena);
    TextAreaNavigationResolver resolver = TextAreaNavigationResolver(self.m_arena, empty, self.m_context, self.m_state, 14.0f);
    const u64 revision = self.m_state.revision();
    const u64 selection = self.m_model.selectionGeneration();
    const EditNavigationSnapshot preferred = self.m_state.navigation().snapshot();
    EXPECT_FALSE(resolver.resolve(self.m_model, EditNavigationDirection::Down, preferred, 160.0f).has_value());
    EXPECT_EQ(self.m_model.text(), "MM\nMM");
    EXPECT_EQ(self.m_model.caret(), 1u);
    EXPECT_EQ(self.m_model.selectionGeneration(), selection);
    EXPECT_EQ(self.m_state.revision(), revision);
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 5.0f);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 20.0f);
    EXPECT_TRUE(self.m_state.navigation().matches(preferred));
    EXPECT_EQ(empty.generation(), 0u);
}

void VerifyUiTextAreaNavigationTests_ExplicitHangulPolicyKeepsVerticalTargetAlignedWithVisibleJamo(mut UiTextAreaNavigationTests self){
    ASSERT_TRUE(self.installKoreanFallback());
    ASSERT_TRUE(self.m_model.setText("\xe1\x84\x92\xe1\x85\xa1\xe1\x86\xab\naaa"));
    ASSERT_TRUE(self.m_model.setSelection(9u, 9u));
    const u32 hangulTag = PackFourCharTag(72u, 97u, 110u, 103u);
    ShapeRequest request = ShapeRequest();
    request.language = s_UiTextAreaKoreanLanguage;
    request.fontSize = 14.0f;
    request.scriptTag = hangulTag;
    request.direction = TextDirection::LeftToRight;
    EditBoxView visual = EditBoxView(self.m_arena);
    ASSERT_TRUE(visual.snapshot(self.m_model));
    ASSERT_EQ(visual.shape(self.m_text, request), TextLayoutStatus::Success);
    const auto caret = visual.caretGeometry().caretRect(visual.displayCaret());
    ASSERT_TRUE(caret.has_value());
    const auto expected = visual.caretGeometry().verticalTarget(visual.displayCaret(), true, caret.value().x);
    ASSERT_TRUE(expected.has_value());

    const EditNavigationSnapshot preferred = self.m_state.navigation().snapshot();
    String language = "ko";
    TextAreaNavigationResolver configured = TextAreaNavigationResolver(self.m_arena, self.m_text, self.m_context, self.m_state, 14.0f, hangulTag, StringView(language.data(), language.size()));
    language.assign("!!", 2u);
    const auto matching = configured.resolve(self.m_model, EditNavigationDirection::Down, preferred, 0.0f);
    ASSERT_TRUE(matching.has_value());
    EXPECT_EQ(matching.value().committedByte, expected.value());
    TextAreaNavigationResolver defaultPolicy = TextAreaNavigationResolver(self.m_arena, self.m_text, self.m_context, self.m_state, 14.0f);
    const auto different = defaultPolicy.resolve(self.m_model, EditNavigationDirection::Down, preferred, 0.0f);
    ASSERT_TRUE(different.has_value());
    EXPECT_NE(matching.value().committedByte, different.value().committedByte);
}


