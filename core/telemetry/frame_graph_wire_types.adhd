[serialize]
class EncodedFrameGraphPayloadHeader{
    public u32 magic = s_FrameGraphPayloadMagic;
    public u16 version = s_FrameGraphPayloadVersion;
    public u16 reserved = 0u;
    public u64 frameIndex = 0u;
    public u32 nodeCount = 0u;
    public u32 edgeCount = 0u;
    public u32 stringTableBytes = 0u;
    public u32 queueAssignmentCount = 0u;
    public u32 compiledTaskCount = 0u;
    public u32 runtimeStatisticsCount = 0u;
    public u32 physicalQueueRuntimeStatisticsCount = 0u;
    public u32 packetSubmissionStatisticsCount = 0u;
    public u8 packetSubmissionStatisticsPresent = 0u;
    public Array<u8, 3u> reservedTail;
}


[serialize]
class EncodedFrameGraphNode{
    public NameHash nameHash;
    public u32 labelOffset = 0u;
    public u8 kind = s_WireNodeKindUnknown;
    public u8 flags = 0u;
    public u16 reserved = 0u;
}


[serialize]
class EncodedFrameGraphEdge{
    public u32 fromNodeIndex = 0u;
    public u32 toNodeIndex = 0u;
    public u8 kind = s_WireEdgeKindUnknown;
    public u8 flags = 0u;
    public u16 reserved = 0u;
}


[serialize]
class EncodedFrameGraphPhysicalQueueId{
    public u16 index = s_MaxU16;
    public u16 deviceGeneration = 0u;
}


[serialize]
class EncodedFrameGraphQueueAssignment{
    public u32 nodeIndex = 0u;
    public EncodedFrameGraphPhysicalQueueId initialQueue;
    public EncodedFrameGraphPhysicalQueueId plannedQueue;
    public EncodedFrameGraphPhysicalQueueId acceptedQueue;
    public EncodedFrameGraphPhysicalQueueId previousAcceptedQueue;
    public i32 scoreOverlap = 0;
    public i32 scoreQueueLoad = 0;
    public i32 scoreIncomingCrossings = 0;
    public i32 scoreOutgoingCrossings = 0;
    public i32 scoreOwnershipTransfers = 0;
    public i32 scoreTotal = 0;
    public u8 queueClass = s_WireQueueClassUnknown;
    public u8 reason = s_WireQueueReasonUnknown;
    public u8 modifiers = s_WireQueueModifierNone;
    public u8 acceptance = s_WireQueueAcceptanceNotAccepted;
    public u8 dedicated = 0u;
    public Array<u8, 3u> reserved;
}


[serialize]
class EncodedFrameGraphCompiledTask{
    public u32 nodeIndex = 0u;
    public u32 packetIndex = s_MaxU32;
    public u64 planGeneration = 0u;
    public u8 packetizationDecision = s_WirePacketizationUnknown;
    public Array<u8, 3u> reserved;
}


