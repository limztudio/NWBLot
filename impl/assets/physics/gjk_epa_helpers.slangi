#ifndef NWB_PHYSICS_ENABLE_GJK
#define NWB_PHYSICS_ENABLE_GJK 1
#endif

#ifndef NWB_PHYSICS_ENABLE_EPA
#define NWB_PHYSICS_ENABLE_EPA 0
