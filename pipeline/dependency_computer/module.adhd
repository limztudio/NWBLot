////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <pipeline/dependency_computer/dependencies.adhd.h>
#include <pipeline/command_line.h>

#include <core/alloc/scratch.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_PIPELINE_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


int RunPipelineTool(const int argc, char** argv){
    Core::Assets::AssetArena arena(DependencyComputer::s_DependencyComputerArena);
    Core::Alloc::ScratchArena scratchArena(DependencyComputer::s_DependencyComputerArena);
    PipelineCommandLine commandLine(PipelineTool::DependencyComputer);
    return commandLine.run(argc, argv, [&](PipelineOptions& options){
        DependencyComputer::AssetDependencyOptions dependencyOptions(arena);
        dependencyOptions.inputs = Move(options.inputs);
        dependencyOptions.assetRoots = Move(options.assetRoots);
        dependencyOptions.repoRoot = Move(options.repoRoot);
        dependencyOptions.outputPath = Move(options.outputPath);
        return DependencyComputer::WriteAssetDependencies(dependencyOptions, scratchArena) ? s_PipelineExitSuccess : s_PipelineExitFailure;
    }, arena, scratchArena);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_PIPELINE_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

