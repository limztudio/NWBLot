class UiNestedPopupLoanMutationSource : ComboSource{
    public TestObserved<u64> metadataCalls;
    public TestObserved<Optional<mut PopupState>> closePopupOnText;
    public TestObserved<Optional<mut PopupState>> reopenPopupOnText;
    public TestObserved<Optional<mut ListState>> selectListOnText;
    public TestObserved<Optional<mut ListState>> selectListOnRevision;
    public TestObserved<Optional<mut ComboState>> selectComboOnText;
    public TestObserved<Optional<mut ContextMenuState>> closeMenuOnText;
    public TestObserved<Optional<mut EditModel>> queryOnText;
    public TestObserved<Optional<mut UiNestedPopupLoanMutationSource>> armSourceOnText;
    public Optional<mut ListState> armList;

    public UiNestedPopupLoanMutationSource(in u64 instance){
        this.generation = instance;
        this.count = 5u;
    }
    public u64 instanceGeneration()const override{ ++this.metadataCalls.value(); return this.generation; }
    public u64 revision()const override{
        ++this.metadataCalls.value();
        if(this.selectListOnRevision.value().has_value()){
            mut ListState state = this.selectListOnRevision.value().value();
            this.selectListOnRevision.value().reset();
            state.select(4u);
        }
        return this.contentRevision;
    }
    public u64 rowCount()const override{ ++this.metadataCalls.value(); return this.count; }
    public StringView text(in u64 index)const override{
        const StringView value = this.baseText(index);
        if(this.closePopupOnText.value().has_value()){
            mut PopupState state = this.closePopupOnText.value().value();
            this.closePopupOnText.value().reset();
            state.close();
        }
        if(this.reopenPopupOnText.value().has_value()){
            mut PopupState state = this.reopenPopupOnText.value().value();
            this.reopenPopupOnText.value().reset();
            state.close();
            state.open();
        }
        if(this.selectListOnText.value().has_value()){
            mut ListState state = this.selectListOnText.value().value();
            this.selectListOnText.value().reset();
            state.select(4u);
        }
        if(this.selectComboOnText.value().has_value()){
            mut ComboState state = this.selectComboOnText.value().value();
            this.selectComboOnText.value().reset();
            state.select(4u);
        }
        if(this.closeMenuOnText.value().has_value()){
            mut ContextMenuState state = this.closeMenuOnText.value().value();
            this.closeMenuOnText.value().reset();
            state.close();
        }
        if(this.queryOnText.value().has_value()){
            mut EditModel query = this.queryOnText.value().value();
            this.queryOnText.value().reset();
            EXPECT_TRUE(query.setText(s_CallbackQuery));
        }
        if(this.armSourceOnText.value().has_value()){
            mut UiNestedPopupLoanMutationSource source = this.armSourceOnText.value().value();
            this.armSourceOnText.value().reset();
            source.selectListOnRevision.value() = this.armList;
        }
        return value;
    }
    public void resetAllCounters()const{ this.resetCounters(); this.metadataCalls.value() = 0u; }
    public void armSelectListOnText(mut ListState state){ this.selectListOnText.value() = Optional<mut ListState>(state); }
    public b8 hasSelectListOnText()const{ return this.selectListOnText.value().has_value(); }
    public b8 hasSelectListOnRevision()const{ return this.selectListOnRevision.value().has_value(); }
    public void armSourceSelectList(mut UiNestedPopupLoanMutationSource source, mut ListState list){
        this.armSourceOnText.value() = Optional<mut UiNestedPopupLoanMutationSource>(source);
        this.armList = Optional<mut ListState>(list);
    }
    public b8 hasArmSourceOnText()const{ return this.armSourceOnText.value().has_value(); }
    public void armSelectComboOnText(mut ComboState state){ this.selectComboOnText.value() = Optional<mut ComboState>(state); }
    public void armQueryOnText(mut EditModel query){ this.queryOnText.value() = Optional<mut EditModel>(query); }
    public void armCloseMenuOnText(mut ContextMenuState state){ this.closeMenuOnText.value() = Optional<mut ContextMenuState>(state); }
    public void armClosePopupOnText(mut PopupState state){ this.closePopupOnText.value() = Optional<mut PopupState>(state); }
    public b8 hasClosePopupOnText()const{ return this.closePopupOnText.value().has_value(); }
    public void armReopenPopupOnText(mut PopupState state){ this.reopenPopupOnText.value() = Optional<mut PopupState>(state); }
    public b8 hasReopenPopupOnText()const{ return this.reopenPopupOnText.value().has_value(); }
}

class NestedSearchSource : ISearchableListDataSource{
    public UiNestedPopupLoanMutationSource full = UiNestedPopupLoanMutationSource(2201u);
    public UiNestedPopupLoanMutationSource view = UiNestedPopupLoanMutationSource(2202u);
    public u64 filterCalls = 0u;
    public TestObserved<u64> filteredCalls;
    public String m_query;

    public u64 instanceGeneration()const override{ return this.full.instanceGeneration(); }
    public u64 revision()const override{ return this.full.revision(); }
    public u64 rowCount()const override{ return this.full.rowCount(); }
    public u64 key(in u64 index)const override{ return this.full.key(index); }
    public Expected<u64> indexOf(in u64 key)const override{ return this.full.indexOf(key); }
    public Expected<u64> findEnabled(in u64 start, in b8 reverse)const override{
        return this.full.findEnabled(start, reverse);
    }
    public StringView text(in u64 index)const override{ return this.full.text(index); }
    public b8 enabled(in u64 index)const override{ return this.full.enabled(index); }
    public b8 filter(in StringView query)override{
        ++this.filterCalls;
        const StringView previous = StringView(this.m_query);
        if(previous != query){
            this.m_query.assign(query);
            ++this.view.contentRevision;
        }
        this.view.count = 0u;
        if(query.empty())
            this.view.count = this.full.count;
        return true;
    }
    public in IListDataSource filtered()const override{ ++this.filteredCalls.value(); return this.view; }
}

class UiNestedPopupLoanTests : WidgetFixture{
    public UiNestedPopupLoanMutationSource m_parentSource = UiNestedPopupLoanMutationSource(2101u);
    public UiNestedPopupLoanMutationSource m_childSource = UiNestedPopupLoanMutationSource(2102u);
    public UiNestedPopupLoanMutationSource m_comboSource = UiNestedPopupLoanMutationSource(2103u);
    public UiNestedPopupLoanMutationSource m_menuSource = UiNestedPopupLoanMutationSource(2104u);
    public PopupState m_parent;
    public PopupState m_child;
    public ListState m_parentList;
    public ListState m_childList;
    public ComboState m_combo;
    public ContextMenuState m_menu;
    public NestedSearchSource m_searchSource;
    public SearchComboState m_search;
    public SearchEditHost m_host;

    public UiNestedPopupLoanTests(){ this.m_host = SearchEditHost(this.m_context); }
    public void setup(){
        this.setUpWidgetBase();
        this.m_builder.setEditHost(this.m_host);
        this.m_parent.open();
        this.m_child.open();
    }
    public b8 beginParent(in u64 generation){
        return this.begin(generation) && this.m_builder.beginPopup(s_ParentPopupKey, this.m_parent, MakeNestedParentPopupOptions());
    }
    public b8 acceptBase(in u64 generation){
        if(!this.begin(generation) || !this.m_builder.beginPanel("base", Rect(0.0f, 0.0f, 100.0f, 80.0f)))
            return false;
        if(!this.m_builder.label("label", "Baseline") || !this.m_builder.endPanel() || !this.finishRoot())
            return false;
        return this.m_context.commitFrame(generation);
    }
    public b8 declareLists(in u64 generation){
        if(!this.beginParent(generation) || !this.m_builder.virtualList(s_UiNestedPopupRouterListKey, this.m_parentSource, this.m_parentList, MakeLargeLoanListOptions()).valid)
            return false;
        if(!this.m_builder.beginPopup(s_ChildPopupKey, this.m_child, MakeNestedChildPopupOptions()) || !this.m_builder.virtualList(s_UiNestedPopupRouterListKey, this.m_childSource, this.m_childList, MakeLargeLoanListOptions()).valid)
            return false;
        return this.m_builder.endPopup();
    }
    public b8 acceptLists(in u64 generation){
        return this.declareLists(generation) && this.m_builder.endPopup() && this.finishRoot() && this.m_context.commitFrame(generation);
    }
    public b8 declareChildCompounds(in u64 generation){
        if(!this.beginParent(generation) || !this.m_builder.beginPopup(s_ChildPopupKey, this.m_child, MakeNestedChildPopupOptions()))
            return false;
        if(!this.m_builder.virtualList(s_UiNestedPopupRouterListKey, this.m_childSource, this.m_childList, MakeLargeLoanListOptions()).valid || !this.m_builder.comboBox(s_ComboKey, this.m_comboSource, this.m_combo, MakeComboFixtureOptions()).valid)
            return false;
        SearchComboOptions searchOptions;
        searchOptions.combo = MakeComboFixtureOptions();
        searchOptions.combo.popupHeight = 220.0f;
        if(!this.m_builder.searchComboBox("search", this.m_searchSource, this.m_search, searchOptions).combo.valid)
            return false;
        WidgetOptions anchorOptions;
        anchorOptions.width = LayoutSize(LayoutSizePolicy::Fixed, 220.0f);
        anchorOptions.height = LayoutSize(LayoutSizePolicy::Fixed, 30.0f);
        const b8 activated = this.m_builder.button(s_AnchorKey, "Menu", anchorOptions);
        if(activated)
            return false;
        if(!this.m_builder.contextMenu("menu", s_AnchorKey, this.m_menuSource, this.m_menu).valid)
            return false;
        return this.m_builder.endPopup();
    }
    public void resetChildCounters(){
        this.m_childSource.resetAllCounters();
        this.m_comboSource.resetAllCounters();
        this.m_menuSource.resetAllCounters();
        this.m_searchSource.full.resetAllCounters();
        this.m_searchSource.view.resetAllCounters();
        this.m_searchSource.filterCalls = 0u;
        this.m_searchSource.filteredCalls.value() = 0u;
        this.m_host.publications = 0u;
    }
    public void expectNoChildCallbacks()const{
        ExpectNoNestedSourceCallbacks(this.m_childSource);
        ExpectNoNestedSourceCallbacks(this.m_comboSource);
        ExpectNoNestedSourceCallbacks(this.m_menuSource);
        ExpectNoNestedSourceCallbacks(this.m_searchSource.full);
        ExpectNoNestedSourceCallbacks(this.m_searchSource.view);
        EXPECT_EQ(this.m_searchSource.filterCalls, 0u);
        EXPECT_EQ(this.m_searchSource.filteredCalls.value(), 0u);
        EXPECT_EQ(this.m_host.publications, 0u);
    }
}

class ReentrySource : ComboSource{
    public Optional<in ReentrySource> m_observer;
    public TestObserved<Optional<mut Builder>> m_textBuilder;
    public TestObserved<Optional<mut Builder>> m_revisionBuilder;
    public TestObserved<Optional<mut Builder>> m_armBuilder;
    public TestObserved<Optional<mut ReentrySource>> m_armSource;
    public TestObserved<u64> m_metadataCalls;
    public TestObserved<u64> m_callbacksAfterAttempt;
    public TestObserved<u64> m_arms;
    public TestObserved<u64> m_attempts;
    public TestObserved<u64> m_resetAttempts;
    public TestObserved<u64> m_beginAttempts;
    public TestObserved<u64> m_endAttempts;
    public UiNestedPopupReentryKind m_kind = UiNestedPopupReentryKind::Reset;
    public TestObserved<b8> m_beginAccepted;
    public TestObserved<b8> m_endAccepted;
    public TestObserved<b8> m_failedAtAttempt;

    public ReentrySource(in u64 instance){
        this.generation = instance;
        this.count = 5u;
    }
    public u64 instanceGeneration()const override{
        this.observeCallback();
        ++this.m_metadataCalls.value();
        return this.generation;
    }
    public u64 revision()const override{
        this.observeCallback();
        ++this.m_metadataCalls.value();
        if(this.m_revisionBuilder.value().has_value()){
            mut Builder builder = this.m_revisionBuilder.value().value();
            this.m_revisionBuilder.value().reset();
            this.attempt(UiNestedPopupReentryKind::Panel, builder);
        }
        return this.contentRevision;
    }
    public u64 rowCount()const override{
        this.observeCallback();
        ++this.m_metadataCalls.value();
        return this.count;
    }
    public StringView text(in u64 index)const override{
        const StringView value = this.baseText(index);
        if(this.m_textBuilder.value().has_value()){
            mut Builder builder = this.m_textBuilder.value().value();
            this.m_textBuilder.value().reset();
            this.attempt(this.m_kind, builder);
        }
        if(this.m_armSource.value().has_value()){
            mut ReentrySource source = this.m_armSource.value().value();
            this.m_armSource.value().reset();
            const Optional<mut Builder> builder = this.m_armBuilder.value();
            this.m_armBuilder.value().reset();
            ++this.m_arms.value();
            source.m_revisionBuilder.value() = builder;
        }
        return value;
    }
    public void armText(in UiNestedPopupReentryKind kind, mut Builder builder){
        this.m_textBuilder.value() = Optional<mut Builder>(builder);
        this.m_kind = kind;
    }
    public void armRevisionAfterText(mut ReentrySource source, mut Builder builder){
        this.m_armSource.value() = Optional<mut ReentrySource>(source);
        this.m_armBuilder.value() = Optional<mut Builder>(builder);
    }
    public void observeAttemptsOf(in borrow ReentrySource source){ this.m_observer = Optional<in ReentrySource>(source); }
    public void resetObservations()const{
        this.resetCounters();
        this.m_metadataCalls.value() = 0u;
        this.m_callbacksAfterAttempt.value() = 0u;
        this.m_arms.value() = 0u;
        this.m_attempts.value() = 0u;
        this.m_resetAttempts.value() = 0u;
        this.m_beginAttempts.value() = 0u;
        this.m_endAttempts.value() = 0u;
        this.m_beginAccepted.value() = false;
        this.m_endAccepted.value() = false;
        this.m_failedAtAttempt.value() = false;
    }
    public u64 metadataCalls()const{ return this.m_metadataCalls.value(); }
    public u64 callbacksAfterAttempt()const{ return this.m_callbacksAfterAttempt.value(); }
    public u64 arms()const{ return this.m_arms.value(); }
    public u64 attempts()const{ return this.m_attempts.value(); }
    public u64 resetAttempts()const{ return this.m_resetAttempts.value(); }
    public u64 beginAttempts()const{ return this.m_beginAttempts.value(); }
    public u64 endAttempts()const{ return this.m_endAttempts.value(); }
    public b8 beginAccepted()const{ return this.m_beginAccepted.value(); }
    public b8 endAccepted()const{ return this.m_endAccepted.value(); }
    public b8 failedAtAttempt()const{ return this.m_failedAtAttempt.value(); }
    public void observeCallback()const override{
        if(this.m_attempts.value() != 0u || (this.m_observer.has_value() && this.m_observer.value().attempts() != 0u))
            ++this.m_callbacksAfterAttempt.value();
    }
    public void attempt(in UiNestedPopupReentryKind kind, mut Builder builder)const{
        ++this.m_attempts.value();
        if(kind == UiNestedPopupReentryKind::Reset){
            ++this.m_resetAttempts.value();
            builder.reset();
        }
        else{
            ++this.m_beginAttempts.value();
            this.m_beginAccepted.value() = builder.beginPanel("reentered", Rect(0.0f, 0.0f, 100.0f, 80.0f));
            ++this.m_endAttempts.value();
            this.m_endAccepted.value() = builder.endPanel();
        }
        this.m_failedAtAttempt.value() = builder.failed();
    }
}

class UiNestedPopupReentryAcceptedFrame{
    public Array<HitTarget, 32u> targets;
    public usize count = 0u;
    public usize popupCount = 0u;
    public u64 generation = 0u;
    public WidgetId focus;
    public WidgetId capture;


}

class UiNestedPopupReentryTests : WidgetFixture{
    public ReentrySource m_parentSource = ReentrySource(2401u);
    public ReentrySource m_childSource = ReentrySource(2402u);
    public ReentrySource m_siblingSource = ReentrySource(2403u);
    public ReentrySource m_comboSource = ReentrySource(2404u);
    public PopupState m_parent;
    public PopupState m_child;
    public PopupState m_sibling;
    public ListState m_parentList;
    public ListState m_childList;
    public ListState m_siblingList;
    public ComboState m_combo;

    public void setup(){
        this.setUpWidgetBase();
        this.m_parent.open();
        this.m_child.open();
        this.m_sibling.open();
        this.m_parentList.select(2u);
        this.m_childList.select(2u);
        this.m_siblingList.select(2u);
    }
    public b8 acceptBase(){
        if(!this.begin(1u) || !this.m_builder.beginPanel("base", Rect(0.0f, 0.0f, 180.0f, 100.0f)))
            return false;
        if(this.m_builder.button("button", "Accepted baseline"))
            return false;
        return this.finishPanel() && this.m_context.commitFrame(1u);
    }
    public b8 beginParent(){ return this.begin(2u) && this.m_builder.beginPopup(s_ParentPopupKey, this.m_parent, MakeNestedParentPopupOptions()); }
    public b8 declareChild(){
        return this.m_builder.beginPopup(s_ChildPopupKey, this.m_child, MakeNestedChildPopupOptions()) && this.m_builder.virtualList(s_UiNestedPopupRouterListKey, this.m_childSource, this.m_childList, MakeLargeLoanListOptions()).valid && this.m_builder.endPopup();
    }
    public b8 declareSibling(){
        return this.m_builder.beginPopup("sibling", this.m_sibling, MakeNestedChildPopupOptions()) && this.m_builder.virtualList(s_UiNestedPopupRouterListKey, this.m_siblingSource, this.m_siblingList, MakeLargeLoanListOptions()).valid && this.m_builder.endPopup();
    }
    public UiNestedPopupReentryAcceptedFrame accepted()const{
        UiNestedPopupReentryAcceptedFrame frame;
        frame.count = this.m_context.input().targets().size();
        frame.popupCount = this.m_context.input().popupCount();
        frame.generation = this.m_context.input().layoutGeneration();
        frame.focus = this.m_context.input().focus();
        frame.capture = this.m_context.input().capture();
        for(usize index = 0u; index < Min(frame.count, frame.targets.size()); ++index)
            frame.targets[index] = this.m_context.input().targets()[index];
        return frame;
    }
    public void expectRejected(in UiNestedPopupReentryAcceptedFrame frame)const{
        EXPECT_TRUE(this.m_builder.failed());
        EXPECT_TRUE(this.m_context.failed());
        EXPECT_FALSE(this.m_context.ready());
        EXPECT_EQ(this.m_context.input().layoutGeneration(), frame.generation);
        EXPECT_EQ(this.m_context.input().popupCount(), frame.popupCount);
        EXPECT_EQ(this.m_context.input().focus(), frame.focus);
        EXPECT_EQ(this.m_context.input().capture(), frame.capture);
        ASSERT_EQ(this.m_context.input().targets().size(), frame.count);
        ASSERT_LE(frame.count, frame.targets.size());
        for(usize index = 0u; index < frame.count; ++index){
            in HitTarget before = frame.targets[index];
            in HitTarget after = this.m_context.input().targets()[index];
            ExpectUiHitTargetIdentity(after, before);
            EXPECT_EQ(after.ownerDeclarationGeneration, before.ownerDeclarationGeneration);
            EXPECT_EQ(after.popup, before.popup);
            ExpectUiRect(after.rectangle, before.rectangle);
            ExpectUiRect(after.clip, before.clip);
        }
    }
    public void expectSourcePreserved(in ReentrySource source, in u64 generation)const{
        EXPECT_EQ(source.generation, generation);
        EXPECT_EQ(source.contentRevision, 1u);
        EXPECT_EQ(source.count, 5u);
        EXPECT_EQ(source.callbacksAfterAttempt(), 0u);
    }
    public void expectListPreserved(in ListState state, in u64 generation)const{
        EXPECT_EQ(state.inputGeneration(), generation);
        EXPECT_EQ(state.selectedKey(), 2u);
        EXPECT_EQ(state.cursorKey(), 2u);
        EXPECT_DOUBLE_EQ(state.scrollOffset(), 0.0);
    }
    public void expectPanelRejected(in ReentrySource source)const{
        EXPECT_EQ(source.attempts(), 1u);
        EXPECT_EQ(source.beginAttempts(), 1u);
        EXPECT_EQ(source.endAttempts(), 1u);
        EXPECT_FALSE(source.beginAccepted());
        EXPECT_FALSE(source.endAccepted());
        EXPECT_TRUE(source.failedAtAttempt());
    }
}

class UiNestedPopupRouterTests : RouterTestFixture{


    public b8 install(in Span<PopupScope> scopes, in u64 generation){ return this.install(scopes, generation, false); }
    public b8 install(in Span<PopupScope> scopes, in u64 generation, in b8 navigation){
        Array<HitTarget, s_NestedRouterTargetCount> targets;
        targets[0u] = MakeUiNestedPopupRouterBaseHitTarget();
        for(usize index = 0u; index < scopes.size(); ++index){
            const u32 order = cast<u32>(1u + index * 3u);
            targets[order] = MakeUiNestedPopupRouterBarrier(scopes[index], order);
            targets[order + 1u] = MakeUiNestedPopupRouterChild(scopes[index], 1u, order + 1u, navigation);
            targets[order + 2u] = MakeUiNestedPopupRouterChild(scopes[index], 2u, order + 2u, navigation);
        }
        return this.m_router.commitTargets(Span<HitTarget>(targets).subspan(0u, 1u + scopes.size() * 3u), generation, scopes);
    }
    public b8 installEmpty(in u64 generation){ return this.installEmpty(generation, false); }
    public b8 installEmpty(in u64 generation, in b8 navigation){
        return this.install(Span<PopupScope>(), generation, navigation);
    }
    public b8 installOne(in PopupScope scope, in u64 generation){ return this.installOne(scope, generation, false); }
    public b8 installOne(in PopupScope scope, in u64 generation, in b8 navigation){
        return this.install(MakeUiSinglePopupScopeArray(scope), generation, navigation);
    }
    public b8 commitSingleScopeTargets(in Span<HitTarget> targets, in u64 generation, in PopupScope scope){
        return this.m_router.commitTargets(targets, generation, MakeUiSinglePopupScopeArray(scope));
    }
    public Optional<PopupScope> findPopupScope(in PopupToken token)const{
        const auto found = this.m_router.popupScope(token);
        if(found.has_value())
            return Optional<PopupScope>(found.value());
        return Optional<PopupScope>();
    }
    public b8 hasPopupScope(in PopupToken token)const{
        return this.m_router.popupScope(token).has_value();
    }
    public b8 hasRouterTarget(in WidgetId id)const{
        return this.m_router.findTarget(id).has_value();
    }
    public void focusBase(){
        ASSERT_TRUE(this.install(Span<PopupScope>(), 1u));
        this.key(Key::Tab);
        ASSERT_EQ(this.m_router.focus().value, 1u);
    }
}

class UiNestedPopupTriggerTests : ComboFixture{
    public PopupState m_parent;
    public PopupState m_child;
    public ContextMenuState m_menu;
    public PopupToolsSource m_menuSource;
    public ContextMenuResult m_menuResult;
    public b8 m_anchorActivated = false;

    public WidgetOptions controlOptions()const{
        WidgetOptions options;
        options.width = LayoutSize(LayoutSizePolicy::Fixed, 220.0f);
        options.height = LayoutSize(LayoutSizePolicy::Fixed, 32.0f);
        return options;
    }
    public void setup(){
        this.setUpWidgetBase();
        this.m_source.count = 5u;
        this.m_source.disabled = 3u;
        this.m_parent.open();
        this.m_child.open();
    }
    public WidgetId fieldId()const{ return RequireUiWidgetId(this.childId(), s_ComboKey); }
    public WidgetId rowsId()const{ return RequireUiWidgetId(this.fieldId(), "rows"); }
    public WidgetId anchorId()const{ return RequireUiWidgetId(this.childId(), s_AnchorKey); }
    public WidgetId menuRows()const{ return RequireUiWidgetId(RequireUiWidgetId(this.childId(), s_MenuKey), "rows"); }
    public WidgetId comboRow(in u64 key)const{
        return RequireUiWidgetPartId(RequireUiWidgetId(this.rowsId(), "rows"), key);
    }
    public b8 beginChild(in u64 generation){
        if(!this.begin(generation) || !this.m_builder.beginPopup(s_ParentPopupKey, this.m_parent, MakeNestedParentPopupOptions()))
            return false;
        if(this.m_builder.button("before", "Parent before", this.controlOptions()))
            return false;
        return this.m_builder.beginPopup(s_ChildPopupKey, this.m_child, MakeNestedChildPopupOptions());
    }
    public b8 finishChild(in u64 generation){
        if(this.m_builder.button("after", "MakeUiNestedPopupRouterChild after", this.controlOptions()) || !this.m_builder.endPopup())
            return false;
        if(this.m_builder.button("after", "Parent after", this.controlOptions()) || !this.m_builder.endPopup())
            return false;
        return this.m_context.endRoot() && this.m_context.finishFrame() && this.m_context.commitFrame(generation);
    }
    public b8 acceptChildCombo(in u64 generation){
        if(!this.beginChild(generation))
            return false;
        this.m_result = this.m_builder.comboBox(s_ComboKey, this.m_source, this.m_state, MakeComboFixtureOptions());
        return this.m_result.valid && this.finishChild(generation);
    }
    public b8 acceptChildMenu(in u64 generation){
        if(!this.beginChild(generation))
            return false;
        this.m_anchorActivated = this.m_builder.button(s_AnchorKey, "Commands", this.controlOptions());
        this.m_menuResult = this.m_builder.contextMenu(s_MenuKey, s_AnchorKey, this.m_menuSource, this.m_menu);
        return this.m_menuResult.valid && this.finishChild(generation);
    }
    public void expectUserParentsOpen()const{
        EXPECT_TRUE(this.m_parent.isOpen());
        EXPECT_TRUE(this.m_child.isOpen());
        const auto parent = this.target(this.parentId());
        const auto child = this.target(this.childId());
        ASSERT_TRUE(parent.has_value());
        ASSERT_TRUE(child.has_value());
        EXPECT_EQ(parent.value().layer, 1u);
        EXPECT_EQ(child.value().layer, 2u);
        EXPECT_TRUE(this.hasTarget(RequireUiWidgetId(this.parentId(), "after")));
        EXPECT_TRUE(this.hasTarget(RequireUiWidgetId(this.childId(), "after")));
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


HitTarget MakeUiNestedPopupRouterBaseHitTarget(){
    HitTarget target;
    target.id = WidgetId(1u);
    target.rectangle = Rect(4.0f, 4.0f, 20.0f, 18.0f);
    target.clip = Rect(0.0f, 0.0f, 400.0f, 300.0f);
    target.focusable = true;
    target.activatable = true;
    return target;
}

PopupScope MakeUiNestedPopupRouterScope(in u64 widget, in u32 layer){ return MakeUiNestedPopupRouterScope(widget, layer, PopupToken()); }

PopupScope MakeUiNestedPopupRouterScope(in u64 widget, in u32 layer, in PopupToken parent){
    PopupScope scope;
    scope.token = PopupToken(WidgetId(widget), 10u, 20u, 1u);
    if(widget == 100u)
        scope.bounds = Rect(30.0f, 30.0f, 110.0f, 70.0f);
    else if(widget == 200u)
        scope.bounds = Rect(170.0f, 120.0f, 100.0f, 80.0f);
    else if(widget == 300u)
        scope.bounds = Rect(280.0f, 200.0f, 100.0f, 70.0f);
    else
        scope.bounds = Rect(250.0f, 30.0f, 120.0f, 70.0f);
    scope.viewport = Rect(0.0f, 0.0f, 400.0f, 300.0f);
    scope.layer = layer;
    scope.parent = parent;
    return scope;
}

HitTarget MakeUiNestedPopupRouterBarrier(in PopupScope scope, in u32 order){
    HitTarget target;
    target.id = scope.token.widget;
    target.declarationGeneration = scope.token.declarationGeneration;
    target.rectangle = scope.bounds;
    target.clip = scope.viewport;
    target.paintOrder = order;
    target.popup = scope.token;
    target.layer = scope.layer;
    return target;
}

HitTarget MakeUiNestedPopupRouterChild(in PopupScope scope, in u64 offset, in u32 order, in b8 navigation){
    HitTarget target;
    target.id = WidgetId(scope.token.widget.value + offset);
    target.declarationGeneration = 10u;
    const VectorSingle inset = VectorSingle(scope.bounds.x, scope.bounds.y, 0.0f, 0.0f) + VectorSingle(4.0f, 4.0f, 0.0f, 0.0f);
    target.rectangle = Rect(cast<f32>(offset - 1u) * 35.0f + inset.x, inset.y, 24.0f, 18.0f);
    target.clip = scope.bounds;
    target.paintOrder = order;
    target.popup = scope.token;
    target.layer = scope.layer;
    target.focusable = true;
    target.activatable = true;
    if(navigation && offset == 1u){
        target.navigable = true;
        target.contextMenu = true;
        target.control = ControlToken(600u, 700u, 800u);
    }
    return target;
}

void ExpectNoNestedSourceCallbacks(in UiNestedPopupLoanMutationSource source){
    EXPECT_EQ(source.metadataCalls.value(), 0u);
    EXPECT_EQ(source.keyCalls.value(), 0u);
    EXPECT_EQ(source.lookupCalls.value(), 0u);
    EXPECT_EQ(source.searchCalls.value(), 0u);
    EXPECT_EQ(source.textCalls.value(), 0u);
    EXPECT_EQ(source.enabledCalls.value(), 0u);
}

PopupToken MakeUiNestedPopupRouterToken(in u64 widgetValue, in u64 declarationGeneration, in u64 instanceGeneration, in u64 openGeneration){
    PopupToken token = PopupToken();
    token.widget = WidgetId(widgetValue);
    token.declarationGeneration = declarationGeneration;
    token.instanceGeneration = instanceGeneration;
    token.openGeneration = openGeneration;
    return token;
}

ControlToken MakeUiNestedPopupRouterControlToken(in u64 instanceGeneration, in u64 contentGeneration, in u64 contentRevision){
    ControlToken token = ControlToken();
    token.instanceGeneration = instanceGeneration;
    token.contentGeneration = contentGeneration;
    token.contentRevision = contentRevision;
    return token;
}

