////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SHADOW_REPROJECT_MERGE_SLANGI
#define NWB_GRAPHICS_SHADOW_REPROJECT_MERGE_SLANGI


#include "shadow_reproject_merge_binding_slots.h"
#include "shadow_heap_resources.slangi"
#include "../common/math.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#define NWB_SHADOW_TEMPORAL_LUMA_MIN 0.001h


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct NwbShadowMergeReprojection{
    int2 texel;
    bool onScreen;
};

struct NwbShadowMergeResult{
    float4 history;
    float4 moments;
};

half4 nwbShadowMergeGeometry(const uint geometrySlot, const int2 texel){
    return half4(nwbHeapSampledImage2D(geometrySlot).Load(int3(texel, 0)));
}

NwbShadowMergeReprojection nwbShadowReprojectHistory(const float3 worldPosition, const float4x4 prevWorldToClip, const uint historyValid, const uint halfWidth, const uint halfHeight){
    const int hw = (int)halfWidth;
    const int hh = (int)halfHeight;
    const float4 clipPrev = mul(prevWorldToClip, float4(worldPosition, 1.0));
    NwbShadowMergeReprojection result;
    result.onScreen = false;
    result.texel = int2(0, 0);
    if(clipPrev.w > 0.0 && historyValid != 0u){
        const float3 ndc = clipPrev.xyz / clipPrev.w;
        const float2 uvPrev = float2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
        if(uvPrev.x >= 0.0 && uvPrev.x <= 1.0 && uvPrev.y >= 0.0 && uvPrev.y <= 1.0 && ndc.z >= 0.0 && ndc.z <= 1.0){
            const float2 histTexelF = uvPrev * float2((float)halfWidth, (float)halfHeight) - 0.5;
            result.texel = int2(clamp((int)round(histTexelF.x), 0, hw - 1), clamp((int)round(histTexelF.y), 0, hh - 1));
            result.onScreen = true;
        }
    }
    return result;
}

bool nwbShadowMergeHistoryAccepted(const NwbShadowMergeReprojection reprojection, const bool valid, const uint geometryPrevSlot, const float3 currentNormal, const float currentCameraDistance){
    bool historyAccepted = false;
    if(reprojection.onScreen && valid){
        const half4 gp = nwbShadowMergeGeometry(geometryPrevSlot, reprojection.texel);
        if(gp.w > half(NWB_SHADOW_GEOMETRY_VALID_THRESHOLD)){
            const float3 previousNormal = nwbOctDecodeNormal(float2(gp.xy));
            const float worldSpacing = max(currentCameraDistance * NWB_SHADOW_TEMPORAL_WORLD_SPACING_SCALE, NWB_SHADOW_TEMPORAL_WORLD_SPACING_MIN);
            const bool planeOk = abs(currentCameraDistance - float(gp.z)) < (NWB_SHADOW_TEMPORAL_PLANE_K * worldSpacing);
            const bool normalOk = dot(currentNormal, previousNormal) > NWB_SHADOW_TEMPORAL_NORMAL_MIN;
            historyAccepted = planeOk && normalOk;
        }
    }
    return historyAccepted;
}

void nwbShadowMergePreparePixel(
    const uint2 h,
    const int hw,
    const int hh,
    const uint halfWidth,
    const uint halfHeight,
    const uint fullWidth,
    const uint fullHeight,
    const uint receiverFactor,
    const row_major float4x4 prevWorldToClip,
    const uint historyValid,
    const uint geometryCurrSlot,
    const uint geometryPrevSlot,
    const uint worldPositionSlot,
    out bool outValid,
    out NwbShadowMergeReprojection outReprojection,
    out bool outHistoryAccepted,
    out uint outValidTapMask
){
    const int2 texel = int2(h);
    const half4 gc = nwbShadowMergeGeometry(geometryCurrSlot, texel);
    outValid = gc.w > half(NWB_SHADOW_GEOMETRY_VALID_THRESHOLD);
    outReprojection.texel = int2(0, 0);
    outReprojection.onScreen = false;
    outHistoryAccepted = false;
    outValidTapMask = 0u;
    if(!outValid)
        return;
    const float3 currentNormal = nwbOctDecodeNormal(float2(gc.xy));
    const float currentCameraDistance = float(gc.z);
    const int2 full = int2(min(h * receiverFactor, uint2(fullWidth, fullHeight) - 1u));
    const half3 worldPositionSample = half3(nwbHeapSampledImage2D(worldPositionSlot).Load(int3(full, 0)).xyz);
    const float3 currentWorldPosition = float3(worldPositionSample);
    outReprojection = nwbShadowReprojectHistory(currentWorldPosition, prevWorldToClip, historyValid, halfWidth, halfHeight);
    outHistoryAccepted = nwbShadowMergeHistoryAccepted(outReprojection, true, geometryPrevSlot, currentNormal, currentCameraDistance);
    [unroll] for(int dy = -1; dy <= 1; ++dy){
        [unroll] for(int dx = -1; dx <= 1; ++dx){
            const int2 tap = clamp(texel + int2(dx, dy), int2(0), int2(hw - 1, hh - 1));
            if(!(nwbShadowMergeGeometry(geometryCurrSlot, tap).w <= half(NWB_SHADOW_GEOMETRY_VALID_THRESHOLD)))
                outValidTapMask |= 1u << uint((dy + 1) * 3 + dx + 1);
        }
    }
}

NwbShadowMergeResult nwbShadowMergeChannel<let UseValidTapMask : bool>(
    const int2 texel,
    const int2 hp,
    const int hw,
    const int hh,
    const uint slot,
    const bool valid,
    const bool historyAccepted,
    const uint softTraceSlot,
    const uint historyInSlot,
    const uint momentsInSlot,
    const uint geometryCurrSlot,
    const uint validTapMask
){
    const half3 currentVisibilitySample = half3(nwbHeapSampledImage2DArray(softTraceSlot).Load(int4(texel, slot, 0)).rgb);
    const float3 cur = float3(currentVisibilitySample);

    if(!valid){
        NwbShadowMergeResult result;
        result.history = float4(cur, 1.0);
        const half lumaCur0 = nwbLuminance(currentVisibilitySample);
        result.moments = float4(float(lumaCur0), float(lumaCur0) * float(lumaCur0), 0.0, 0.0);
        return result;
    }

    float3 hist = cur;
    half n = half(0.0h);
    half m1Prev = half(0.0h);
    half m2Prev = half(0.0h);
    if(historyAccepted){
        const half3 historySample = half3(nwbHeapSampledImage2DArray(historyInSlot).Load(int4(hp, slot, 0)).rgb);
        const half3 momentSample = half3(nwbHeapSampledImage2DArray(momentsInSlot).Load(int4(hp, slot, 0)).xyz);
        hist = float3(historySample);
        const half3 mom = momentSample;
        m1Prev = mom.x;
        m2Prev = mom.y;
        n = mom.z;
    }

    const half lumaCur = nwbLuminance(currentVisibilitySample);
    const half lumaHistRaw = nwbLuminance(half3(hist));
    const half temporalDelta = lumaCur - lumaHistRaw;
    const half temporalDeltaAbs = abs(temporalDelta);
    float3 mu = float3(0.0, 0.0, 0.0);
    float3 mu2 = float3(0.0, 0.0, 0.0);
    float lumaM1 = 0.0;
    float lumaM2 = 0.0;
    int cnt = 0;
    uint temporalChangeSupport = 0u;
    [unroll] for(int dy = -1; dy <= 1; ++dy){
        [unroll] for(int dx = -1; dx <= 1; ++dx){
            const int2 unclampedTap = texel + int2(dx, dy);
            const bool supportTapInBounds = unclampedTap.x >= 0 && unclampedTap.y >= 0 && unclampedTap.x < hw && unclampedTap.y < hh;
            const int2 t = int2(clamp(unclampedTap.x, 0, hw - 1), clamp(unclampedTap.y, 0, hh - 1));
            if(UseValidTapMask){
                const uint tapBit = 1u << uint((dy + 1) * 3 + dx + 1);
                if((validTapMask & tapBit) == 0u)
                    continue;
            }
            else if(nwbShadowMergeGeometry(geometryCurrSlot, t).w <= half(NWB_SHADOW_GEOMETRY_VALID_THRESHOLD))
                continue;
            const half3 s = half3(nwbHeapSampledImage2DArray(softTraceSlot).Load(int4(t, slot, 0)).rgb);
            mu += float3(s);
            mu2 += float3(s * s);
            const half sl = nwbLuminance(s);
            lumaM1 += float(sl);
            lumaM2 += float(sl * sl);
            const half tapDelta = sl - lumaHistRaw;
            if(supportTapInBounds && temporalDeltaAbs > half(0.0h) && tapDelta * temporalDelta > half(0.0h) && abs(tapDelta) >= temporalDeltaAbs * half(NWB_SHADOW_TEMPORAL_ANTILAG_SUPPORT_FRACTION))
                ++temporalChangeSupport;
            ++cnt;
        }
    }
    float3 histClamped = hist;
    float sigmaLuma = 0.0;
    if(cnt > 0){
        const float invCount = 1.0 / (float)cnt;
        mu *= invCount;
        const float3 variance = max(mu2 * invCount - mu * mu, float3(0.0, 0.0, 0.0));
        const float3 sigma = sqrt(variance);
        const float3 lo = mu - NWB_SHADOW_TEMPORAL_GAMMA * sigma;
        const float3 hi = mu + NWB_SHADOW_TEMPORAL_GAMMA * sigma;
        histClamped = clamp(hist, lo, hi);
        const float lumaMean = lumaM1 * invCount;
        sigmaLuma = sqrt(max(lumaM2 * invCount - lumaMean * lumaMean, 0.0));
    }

    const half lumaHist = nwbLuminance(half3(histClamped));
    const bool temporalChangeCoherent = temporalChangeSupport >= NWB_SHADOW_TEMPORAL_ANTILAG_MIN_SUPPORT;
    const half edgeSignal = temporalChangeCoherent ? max(half(0.0h), abs(lumaCur - lumaHist) - half(NWB_SHADOW_TEMPORAL_NOISE_SLACK) * half(sigmaLuma)) : half(0.0h);
    const half tempGrad = edgeSignal / max(max(lumaCur, lumaHist), half(NWB_SHADOW_TEMPORAL_LUMA_MIN));
    const half nEff = n * saturate(half(1.0h) - half(NWB_SHADOW_TEMPORAL_ANTILAG) * tempGrad);

    const half alpha = max(half(1.0h) / (nEff + half(1.0h)), half(NWB_SHADOW_TEMPORAL_ALPHA_MIN));
    const half3 outVis = lerp(half3(histClamped), currentVisibilitySample, alpha);
    const half nNext = min(nEff + half(1.0h), half(NWB_SHADOW_TEMPORAL_MAX_HISTORY));

    const half m1 = lerp(m1Prev, lumaCur, alpha);
    const half m2 = lerp(m2Prev, lumaCur * lumaCur, alpha);

    NwbShadowMergeResult result;
    result.history = float4(float3(outVis), 1.0);
    result.moments = float4(float(m1), float(m2), float(nNext), 0.0);
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

