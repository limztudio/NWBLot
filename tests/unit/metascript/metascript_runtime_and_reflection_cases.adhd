void VerifySimdZeroArithmeticPreservesExceptionalValuesAndFlags(){
    const auto originalEnvironment = HoldFloatingPointExceptions();
    ASSERT_TRUE(originalEnvironment);
    FloatingPointEnvironmentGuard restoreEnvironment(originalEnvironment.value());
    const Array<u32, 6u> values32(0u, 0x80000000u, 0x7f800000u, 0xff800000u, 0x7f800123u, 0xbf800000u);
    const Array<u64, 6u> values64(0ull, 0x8000000000000000ull, 0x7ff0000000000000ull, 0xfff0000000000000ull, 0x7ff0000000000123ull, 0xbff0000000000000ull);
    for(in i32 rounding : s_FloatingPointRoundingModes){
        ASSERT_TRUE(SetFloatingPointRoundingMode(rounding));
        for(usize i = 0u; i < 6u; ++i){
            const VectorSingle value32 = VectorSetInt(ObserveValue<u32>(values32[i]), ObserveValue<u32>(values32[i]), ObserveValue<u32>(values32[i]), ObserveValue<u32>(values32[i]));
            const VectorDouble value64 = VectorDoubleSetInt(ObserveValue<u64>(values64[i]), ObserveValue<u64>(values64[i]), ObserveValue<u64>(values64[i]), ObserveValue<u64>(values64[i]));
            const VectorSingle zero32 = VectorZero();
            const VectorDouble zero64 = VectorDoubleZero();
            const VectorSingle negativeZero32 = VectorNegate(zero32);
            const VectorDouble negativeZero64 = VectorDoubleNegate(zero64);
            for(u32 operation = 0u; operation < 7u; ++operation){
                ScopedTestTrace traceOperation(operation);
                ScopedTestTrace traceIndex(i);
                ScopedTestTrace traceRounding(rounding);
                const auto apply32 = lambda[in operation, in value32, in zero32, in negativeZero32](in b8 reference) -> VectorSingle{
                    switch(operation){
                    case 0u:
                        if(reference) return VectorSubtract(value32, zero32);
                        return SubZeroRightSingle(value32);
                    case 1u:
                        if(reference) return VectorSubtract(zero32, value32);
                        return SubZeroLeftSingle(value32);
                    case 2u:
                        if(reference) return VectorMultiply(value32, zero32);
                        return MulZeroRightSingle(value32);
                    case 3u:
                        if(reference) return VectorMultiply(zero32, value32);
                        return MulZeroLeftSingle(value32);
                    case 4u:
                        if(reference) return VectorDivide(zero32, value32);
                        return ZeroDivideSingle(value32);
                    case 5u:
                        if(reference) return VectorAdd(VectorSubtract(zero32, value32), VectorSubtract(negativeZero32, zero32));
                        return NestedZeroSubSingle(value32, negativeZero32);
                    default:
                        if(reference) return VectorNegate(VectorSubtract(zero32, value32));
                        return NegateZeroSubSingle(value32);
                    }
                };
                const auto apply64 = lambda[in operation, in value64, in zero64, in negativeZero64](in b8 reference) -> VectorDouble{
                    switch(operation){
                    case 0u:
                        if(reference) return VectorDoubleSubtract(value64, zero64);
                        return SubZeroRightDouble(value64);
                    case 1u:
                        if(reference) return VectorDoubleSubtract(zero64, value64);
                        return SubZeroLeftDouble(value64);
                    case 2u:
                        if(reference) return VectorDoubleMultiply(value64, zero64);
                        return MulZeroRightDouble(value64);
                    case 3u:
                        if(reference) return VectorDoubleMultiply(zero64, value64);
                        return MulZeroLeftDouble(value64);
                    case 4u:
                        if(reference) return VectorDoubleDivide(zero64, value64);
                        return ZeroDivideDouble(value64);
                    case 5u:
                        if(reference) return VectorDoubleAdd(VectorDoubleSubtract(zero64, value64), VectorDoubleSubtract(negativeZero64, zero64));
                        return NestedZeroSubDouble(value64, negativeZero64);
                    default:
                        if(reference) return VectorDoubleNegate(VectorDoubleSubtract(zero64, value64));
                        return NegateZeroSubDouble(value64);
                    }
                };
                ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT));
                const VectorSingle expected32 = apply32(true);
                const i32 expectedFlags32 = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT));
                const VectorSingle actual32 = apply32(false);
                const i32 actualFlags32 = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                EXPECT_EQ(VectorGetIntX(actual32), VectorGetIntX(expected32));
                EXPECT_EQ(actualFlags32, expectedFlags32);

                ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT));
                const VectorDouble expected64 = apply64(true);
                const i32 expectedFlags64 = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT));
                const VectorDouble actual64 = apply64(false);
                const i32 actualFlags64 = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                EXPECT_EQ(VectorDoubleGetIntX(actual64), VectorDoubleGetIntX(expected64));
                EXPECT_EQ(actualFlags64, expectedFlags64);
            }
        }
    }
}
NWB_ADHD_GTEST(AdhdCompiler, SimdZeroArithmeticPreservesExceptionalValuesAndFlags, VerifySimdZeroArithmeticPreservesExceptionalValuesAndFlags)

void VerifySimdProductPlusZeroPreservesNegativeZeroAddition(){
    const auto originalEnvironment = HoldFloatingPointExceptions();
    ASSERT_TRUE(originalEnvironment);
    FloatingPointEnvironmentGuard restoreEnvironment(originalEnvironment.value());
    ASSERT_TRUE(SetFloatingPointRoundingMode(FE_TONEAREST));
    const u32 negativeZero32 = ObserveValue<u32>(0x80000000u);
    const u64 negativeZero64 = ObserveValue<u64>(0x8000000000000000ull);
    const VectorSingle value32 = VectorSetInt(negativeZero32, negativeZero32, negativeZero32, negativeZero32);
    const VectorDouble value64 = VectorDoubleSetInt(negativeZero64, negativeZero64, negativeZero64, negativeZero64);
    const VectorSingle one32 = VectorReplicate(1.0f);
    const VectorDouble one64 = VectorDoubleReplicate(1.0);
    EXPECT_EQ(VectorGetIntX(AddProductZeroRightSingle(value32, one32)), 0u);
    EXPECT_EQ(VectorGetIntX(AddProductZeroLeftSingle(value32, one32)), 0u);
    EXPECT_EQ(VectorDoubleGetIntX(AddProductZeroRightDouble(value64, one64)), 0ull);
    EXPECT_EQ(VectorDoubleGetIntX(AddProductZeroLeftDouble(value64, one64)), 0ull);
}
NWB_ADHD_GTEST(AdhdCompiler, SimdProductPlusZeroPreservesNegativeZeroAddition, VerifySimdProductPlusZeroPreservesNegativeZeroAddition)


