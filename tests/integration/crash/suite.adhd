}

void VerifyCrash_LinuxSignalHandlerWritesCrashPackage(){
    native{
#if defined(NWB_PLATFORM_LINUX) && !defined(NWB_PLATFORM_ANDROID)
        CrashTestArena testArena;
        auto& arena = testArena.arena;
        constexpr AStringView s_Group("crash_linux_signal_runtime_test");
        RemoveTestArtifacts(arena, s_Group);

        const CrashTestPath spoolDirectory = SpoolDirectory(arena, s_Group);
        const pid_t childPid = fork();
        ASSERT_GE(childPid, 0);
        if(childPid == 0){
            PersistentArena installArena(s_SignalChildInstallArena, PersistentArena::StructureAlignedSize(64u * 1024u));
            Core::Crash::CrashConfigT<PersistentArena> config(installArena);
            config.applicationName = AStringView(s_CrashTests);
            config.version = AStringView(s_ApplicationVersion);
            config.buildId = AStringView("linux-signal-runtime-test");
            config.spoolDirectory = spoolDirectory;

            {
                ScopedLock lock(Core::Crash::CrashDetail::g_State.mutex);
                Core::Crash::CrashDetail::g_State.crashSequence.store(1u, MemoryOrder::relaxed);
            }

            if(!Core::Crash::InstallCrashHandler(config))
                _exit(111);

            raise(SIGSEGV);
            _exit(112);
        }

        if(childPid > 0){
            int status = 0;
            while(waitpid(childPid, &status, 0) < 0){
                if(errno == EINTR)
                    continue;
                break;
            }

            EXPECT_TRUE(WIFSIGNALED(status));
            EXPECT_EQ(WTERMSIG(status), SIGSEGV);

            Array<char, Core::Crash::CrashDetail::s_MaxShortText> crashId = {};
            BuildCrashIdForProcess(static_cast<u32>(childPid), 1u, crashId);

            const CrashTestPath packageDirectory = PackageDirectory(arena, s_Group, CrashNames::s_PendingDirectoryName, FixedBufferView(crashId));
            constexpr u32 s_MissingPackageReadyTimeoutMS = 1000u;
            ExpectDirectoryReady(packageDirectory, s_MissingPackageReadyTimeoutMS);
            ExpectIsRegularFile(packageDirectory / CrashNames::s_ManifestFileName, true);
            ExpectIsRegularFile(packageDirectory / CrashNames::s_CallstackFileName, true);
            // The faulting callstack must reach past the leaf frame without frame pointers.
            EXPECT_TRUE(TextFileContains(packageDirectory / CrashNames::s_CallstackFileName, AStringView("#1 0x")));
            ExpectIsRegularFile(packageDirectory / CrashNames::s_ProcMapsFileName, true);
            EXPECT_TRUE(TextFileContains(packageDirectory / CrashNames::s_ManifestFileName, AStringView("\"reason_kind\": \"signal\"")));
        }

        RemoveTestArtifacts(arena, s_Group);
#endif
    }
}

