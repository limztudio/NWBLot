#include <impl/assets_material/bind_codegen_constants.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Resource fields name an engine/project asset resolved to a heap slot at runtime.
b8 IsMaterialAssetReference(in StringView resourceName){
    usize rootEnd = resourceName.size();
    for(usize i = 0u; i < resourceName.size(); ++i){
        if(resourceName[i] == '/'){
            rootEnd = i;
            break;
        }
    }
    if(rootEnd == 0u || rootEnd + 1u >= resourceName.size())
        return false;

    const StringView virtualRoot = resourceName.substr(0u, rootEnd);
    if(virtualRoot != s_MaterialEngineVirtualRoot && virtualRoot != s_MaterialProjectVirtualRoot)
        return false;

    usize componentBegin = rootEnd + 1u;
    for(usize index = componentBegin; index <= resourceName.size(); ++index){
        if(index != resourceName.size() && resourceName[index] != '/')
            continue;

        const StringView component = resourceName.substr(componentBegin, index - componentBegin);
        if(component.empty() || component == "." || component == "..")
            return false;
        for(usize charIndex = 0u; charIndex < component.size(); ++charIndex){
            if(component[charIndex] == '\\')
                return false;
        }
        componentBegin = index + 1u;
    }
    return true;
}

b8 IsSupportedMaterialResourceReference(in MaterialResourceKind resourceKind, in StringView resourceName){
    return IsValidMaterialResourceKind(resourceKind) && IsMaterialAssetReference(resourceName);
}

MaterialLayoutFieldType MaterialLayoutFieldTypeFromParameterType(in MaterialParameterValueType valueType, in u32 componentCount){
    if(componentCount == 0u || componentCount > s_MaterialLayoutFieldComponentsPerValueType)
        return MaterialLayoutFieldType::None;

    u32 firstFieldType = 0u;
    switch(valueType){
        case MaterialParameterValueType::b8: firstFieldType = cast<u32>(MaterialLayoutFieldType::b8); break;
        case MaterialParameterValueType::i8: firstFieldType = cast<u32>(MaterialLayoutFieldType::i8); break;
        case MaterialParameterValueType::u8: firstFieldType = cast<u32>(MaterialLayoutFieldType::u8); break;
        case MaterialParameterValueType::i16: firstFieldType = cast<u32>(MaterialLayoutFieldType::i16); break;
        case MaterialParameterValueType::u16: firstFieldType = cast<u32>(MaterialLayoutFieldType::u16); break;
        case MaterialParameterValueType::i32: firstFieldType = cast<u32>(MaterialLayoutFieldType::i32); break;
        case MaterialParameterValueType::u32: firstFieldType = cast<u32>(MaterialLayoutFieldType::u32); break;
        case MaterialParameterValueType::f16: firstFieldType = cast<u32>(MaterialLayoutFieldType::f16); break;
        case MaterialParameterValueType::f32: firstFieldType = cast<u32>(MaterialLayoutFieldType::f32); break;
        default: return MaterialLayoutFieldType::None;
    }

    return cast<MaterialLayoutFieldType>(firstFieldType + componentCount - 1u);
}

Expected<MaterialParameterValueType> TryParseMaterialParameterBaseTypeText(in StringView baseTypeText){
    switch(baseTypeText){
        case "bool":
            return MaterialParameterValueType::b8;
        case "char":
            return MaterialParameterValueType::i8;
        case "uchar":
            return MaterialParameterValueType::u8;
        case "short":
            return MaterialParameterValueType::i16;
        case "ushort":
            return MaterialParameterValueType::u16;
        case "int":
            return MaterialParameterValueType::i32;
        case "uint":
            return MaterialParameterValueType::u32;
        case "half":
            return MaterialParameterValueType::f16;
        case "float":
            return MaterialParameterValueType::f32;
        default:
            return makeUnexpected(Failure());
    }
}

Expected<MaterialParameterType> TryParseMaterialParameterTypeText(in StringView typeText){
    if(typeText.empty())
        return makeUnexpected(Failure());

    const Expected<MaterialParameterValueType> valueType = TryParseMaterialParameterBaseTypeText(typeText);
    if(valueType.has_value()){
        MaterialParameterType outType;
        outType.valueType = valueType.value();
        outType.componentCount = 1u;
        return outType;
    }

    if(typeText.size() > 1u){
        const u8 suffix = cast<u8>(typeText[typeText.size() - 1u]);
        if(suffix >= 50u && suffix <= 52u){
            const Expected<MaterialParameterValueType> vectorValueType = TryParseMaterialParameterBaseTypeText(typeText.substr(0u, typeText.size() - 1u));
            if(vectorValueType.has_value()){
                MaterialParameterType outType;
                outType.valueType = vectorValueType.value();
                outType.componentCount = cast<u32>(suffix - 48u);
                return outType;
            }
        }
    }

    return makeUnexpected(Failure());
}

Expected<MaterialLayoutFieldType> TryParseMaterialBindResourceFieldTypeText(in StringView typeText){
    if(typeText == s_MaterialBindFieldTypeTexture2D)
        return MaterialLayoutFieldType::SampledImage2D;
    if(typeText == s_MaterialBindFieldTypeSampler)
        return MaterialLayoutFieldType::Sampler;
    return makeUnexpected(Failure());
}

Expected<MaterialLayoutFieldType> TryParseMaterialLayoutFieldTypeText(in StringView typeText){
    const Expected<MaterialLayoutFieldType> resourceFieldType = TryParseMaterialBindResourceFieldTypeText(typeText);
    if(resourceFieldType.has_value())
        return resourceFieldType.value();

    const Expected<MaterialParameterType> paramType = TryParseMaterialParameterTypeText(typeText);
    if(!paramType.has_value())
        return makeUnexpected(Failure());

    const MaterialLayoutFieldType fieldType = MaterialLayoutFieldTypeFromParameterType(paramType.value().valueType, paramType.value().componentCount);
    if(!IsValidMaterialLayoutFieldType(fieldType))
        return makeUnexpected(Failure());

    return fieldType;
}

StringView MaterialBindFieldLookupFunctionStorageName(in MaterialBlockClass blockClass){
    switch(blockClass){
        case MaterialBlockClass::MaterialConstant:
            return "Constant";
        case MaterialBlockClass::MaterialMutable:
            return "Mutable";
        default:
            return "";
    }
}

StringView MaterialBindFieldLookupFunctionTypeName(in MaterialLayoutFieldType fieldType){
    switch(fieldType){
        case MaterialLayoutFieldType::b8: return "Bool";
        case MaterialLayoutFieldType::b8x2: return "Bool2";
        case MaterialLayoutFieldType::b8x3: return "Bool3";
        case MaterialLayoutFieldType::b8x4: return "Bool4";
        case MaterialLayoutFieldType::i8: return "Char";
        case MaterialLayoutFieldType::i8x2: return "Char2";
        case MaterialLayoutFieldType::i8x3: return "Char3";
        case MaterialLayoutFieldType::i8x4: return "Char4";
        case MaterialLayoutFieldType::u8: return "UChar";
        case MaterialLayoutFieldType::u8x2: return "UChar2";
        case MaterialLayoutFieldType::u8x3: return "UChar3";
        case MaterialLayoutFieldType::u8x4: return "UChar4";
        case MaterialLayoutFieldType::i16: return "Short";
        case MaterialLayoutFieldType::i16x2: return "Short2";
        case MaterialLayoutFieldType::i16x3: return "Short3";
        case MaterialLayoutFieldType::i16x4: return "Short4";
        case MaterialLayoutFieldType::u16: return "UShort";
        case MaterialLayoutFieldType::u16x2: return "UShort2";
        case MaterialLayoutFieldType::u16x3: return "UShort3";
        case MaterialLayoutFieldType::u16x4: return "UShort4";
        case MaterialLayoutFieldType::i32: return "Int";
        case MaterialLayoutFieldType::i32x2: return "Int2";
        case MaterialLayoutFieldType::i32x3: return "Int3";
        case MaterialLayoutFieldType::i32x4: return "Int4";
        case MaterialLayoutFieldType::u32: return "UInt";
        case MaterialLayoutFieldType::u32x2: return "UInt2";
        case MaterialLayoutFieldType::u32x3: return "UInt3";
        case MaterialLayoutFieldType::u32x4: return "UInt4";
        case MaterialLayoutFieldType::f16: return "Half";
        case MaterialLayoutFieldType::f16x2: return "Half2";
        case MaterialLayoutFieldType::f16x3: return "Half3";
        case MaterialLayoutFieldType::f16x4: return "Half4";
        case MaterialLayoutFieldType::f32: return "Float";
        case MaterialLayoutFieldType::f32x2: return "Float2";
        case MaterialLayoutFieldType::f32x3: return "Float3";
        case MaterialLayoutFieldType::f32x4: return "Float4";
        default: return "";
    }
}

StringView MaterialBindResourceSlangTypeName(in MaterialLayoutFieldType fieldType){
    switch(fieldType){
        case MaterialLayoutFieldType::SampledImage2D:
            return "Texture2D<float4>";
        case MaterialLayoutFieldType::Sampler:
            return "SamplerState";
        default:
            return "";
    }
}

StringView MaterialBindResourceHeapAccessorName(in MaterialLayoutFieldType fieldType){
    switch(fieldType){
        case MaterialLayoutFieldType::SampledImage2D:
            return "nwbHeapSampledImage2DNonUniform";
        case MaterialLayoutFieldType::Sampler:
            return "nwbHeapSamplerNonUniform";
        default:
            return "";
    }
}

String BuildMaterialBindFieldLookupFunctionName(in MaterialLayoutFieldType fieldType, in MaterialBlockClass blockClass){
    String functionName = "";
    const StringView storageName = MaterialBindFieldLookupFunctionStorageName(blockClass);
    const StringView typeName = MaterialBindFieldLookupFunctionTypeName(fieldType);
    if(storageName.empty() || typeName.empty())
        return functionName;
    functionName += s_MaterialBindLoadFunctionPrefix;
    functionName += storageName;
    functionName += typeName;
    return functionName;
}

void AppendMaterialBindResourceFieldAccessor(
    in MaterialLayoutFieldType fieldType,
    in StringView byteOffsetSymbol,
    in StringView functionName,
    mut String inOutSource
){
    const StringView slangTypeName = MaterialBindResourceSlangTypeName(fieldType);
    const StringView heapAccessorName = MaterialBindResourceHeapAccessorName(fieldType);
    inOutSource.append(slangTypeName);
    inOutSource.push_back(' ');
    inOutSource.append(functionName);
    inOutSource.append(s_MaterialBindAccessorInstanceParameter);
    inOutSource.append(s_GeneratedReturnPrefix);
    inOutSource.append(heapAccessorName);
    inOutSource.append(s_MaterialBindResourceLoadConstantUIntPrefix);
    inOutSource.append(byteOffsetSymbol);
    inOutSource.append(s_MaterialBindNestedCallStatementEnd);
    inOutSource.append(s_GeneratedFunctionEnd);
}


