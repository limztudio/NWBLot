////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "name_cases.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<tests/common/utf8_log_sink.h>"), cpp_name("::NWB::Tests::Utf8LogSink"), cpp_flags(no_copy, no_assign, abstract, polymorphic_base)]
extern class Utf8LogSink{
    [cpp_flags(unwind)] void receive(in StringView text, in LogType kind);
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena]
class CapturingLogger : Utf8LogSink{
    private Futex m_mutex;
    private Vector<String> m_messages;
    private Vector<String> m_errors;
    private LogType m_lastType = LogType::Info;

    public void receive(in StringView text, in LogType kind)override{
        const auto lock = AcquireFutex(this.m_mutex);
        this.m_lastType = kind;
        AppendArenaElement<String>(this.m_messages);
        this.m_messages.back().assign(text);
        if(kind == LogType::Error){
            AppendArenaElement<String>(this.m_errors);
            this.m_errors.back().assign(text);
        }
    }

    public u32 messageCount()const{
        const auto lock = AcquireFutex(this.m_mutex);
        return cast<u32>(this.m_messages.size());
    }

    public u32 errorCount()const{
        const auto lock = AcquireFutex(this.m_mutex);
        return cast<u32>(this.m_errors.size());
    }

    public LogType lastType()const{
        const auto lock = AcquireFutex(this.m_mutex);
        return this.m_lastType;
    }

    public b8 sawMessageContainingUtf8(in StringView text)const{
        const auto lock = AcquireFutex(this.m_mutex);
        for(in String message : this.m_messages){
            if(message.find(text) != usize.max)
                return true;
        }
        return false;
    }

    public b8 sawErrorContainingUtf8(in StringView text)const{
        const auto lock = AcquireFutex(this.m_mutex);
        for(in String message : this.m_errors){
            if(message.find(text) != usize.max)
                return true;
        }
        return false;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 SawCapturedMessage(in CapturingLogger logger, in StringView text){
    return logger.sawMessageContainingUtf8(text);
}

b8 SawCapturedError(in CapturingLogger logger, in StringView text){
    return logger.sawErrorContainingUtf8(text);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

