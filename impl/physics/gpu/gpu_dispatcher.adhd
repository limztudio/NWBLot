[arena]
class PhysicsGpuDispatcher{
    private Optional<mut GraphicsRuntime> m_graphics;
    private Optional<mut AssetManager> m_assetManager;
    private ShaderArchivePathResolver m_shaderPathResolver;
    private ActiveSceneSubsystemsRef m_activeSceneSubsystems;

    private BindingLayoutHandle m_bindingLayout;
    private ShaderHandle m_broadphaseShader;
    private ComputePipelineHandle m_broadphasePipeline;
    private ShaderHandle m_narrowphasePrimShader;
    private ComputePipelineHandle m_narrowphasePrimPipeline;
    private ShaderHandle m_narrowphaseComplexShader;
    private ComputePipelineHandle m_narrowphaseComplexPipeline;
    private ShaderHandle m_bulletToiShader;
    private ComputePipelineHandle m_bulletToiPipeline;
    private ShaderHandle m_integrateVelShader;
    private ComputePipelineHandle m_integrateVelPipeline;
    private ShaderHandle m_contactsShader;
    private ComputePipelineHandle m_contactsPipeline;
    private ShaderHandle m_jointsShader;
    private ComputePipelineHandle m_jointsPipeline;
    private ShaderHandle m_integratePosShader;
    private ComputePipelineHandle m_integratePosPipeline;
    private ShaderHandle m_finalizeShader;
    private ComputePipelineHandle m_finalizePipeline;
    private ShaderHandle m_islandsShader;
    private ComputePipelineHandle m_islandsPipeline;
    private ShaderHandle m_jointIslandsShader;
    private ComputePipelineHandle m_jointIslandsPipeline;

    private PhysicsGpuBufferSlot m_bodySimSlot;
    private PhysicsGpuBufferSlot m_bodyStateSlot;
    private PhysicsGpuBufferSlot m_bodyOutSlot;
    private PhysicsGpuBufferSlot m_shapeSlot;
    private PhysicsGpuBufferSlot m_pairSlot;
    private PhysicsGpuBufferSlot m_counterSlot;
    private PhysicsGpuBufferSlot m_indirectArgsSlot;
    private PhysicsGpuBufferSlot m_gridSlot;
    private PhysicsGpuBufferSlot m_largeListSlot;
    private PhysicsGpuBufferSlot m_hullVertexSlot;
    private PhysicsGpuBufferSlot m_meshNodeSlot;
    private PhysicsGpuBufferSlot m_meshTriSlot;
    private PhysicsGpuBufferSlot m_manifoldSlot;
    private PhysicsGpuBufferSlot m_constraintSlot;
    private PhysicsGpuBufferSlot m_contactImpulseOutSlot;
    private PhysicsGpuBufferSlot m_jointConstraintSlot;
    private PhysicsGpuBufferSlot m_jointImpulseOutSlot;
    private PhysicsGpuBufferSlot m_islandSliceSlot;

    private u16 m_cachedWorldIndex = 0u;
    private u64 m_cachedWorldGeneration = 0u;
    private u64 m_cachedTopologyVersion = 0u;
    private b8 m_staticGeomValid = false;
    private b8 m_staticGeomDirtyUpload = true;
    private Vector<f32x4> m_cachedHullData;
    private Vector<f32x4> m_cachedMeshNodes;
    private Vector<f32x4> m_cachedMeshTris;
    private Vector<u32> m_shapeDataOffset;
    private Vector<u32> m_shapeDataMeta;

    private Vector<GpuPhysicsBodySim> m_gpuSimsScratch;
    private Vector<GpuPhysicsShapeProxy> m_gpuShapesScratch;
    private Vector<GpuPhysicsNarrowphaseManifold> m_gpuManifoldsScratch;
    private Vector<GpuPhysicsBodyState> m_solverStatesScratch;
    private Vector<GpuPhysicsContactConstraint> m_gpuConstraintsScratch;
    private Vector<GpuPhysicsJointConstraint> m_gpuJointsScratch;
    private Vector<GpuPhysicsIslandSlice> m_gpuIslandSlicesScratch;
    private Vector<u32> m_gpuContactIdsScratch;
    private Vector<GpuPhysicsBodyOut> m_outBodiesScratch;
    private Vector<GpuPhysicsContactImpulseOut> m_outContactImpulsesScratch;
    private Vector<GpuPhysicsJointImpulseOut> m_outJointImpulsesScratch;
    private Vector<u32> m_bodyToGpuSimScratch;
    private Vector<u32> m_wasBodyAwakeStampScratch;
    private Vector<u32> m_seenContactsStampScratch;
    private u32 m_stepStamp = 0u;
    private Vector<u32> m_manifoldContactIdsScratch;
    private Vector<u8> m_manifoldSwappedScratch;
    private Vector<u8> m_contactTransitionFlagsScratch;
    private Vector<Manifold> m_resolvedManifoldsScratch;
    private Vector<u32> m_staleIdsScratch;
    private Vector<u8> m_contactRestFlagsScratch;
    private Vector<JointConstraint> m_flatGpuJointsScratch;
    private Array<Vector<JointConstraint>, s_GpuJointColorCount> m_jointColorBucketsScratch;
    private Vector<u32> m_bodyJointColorMaskScratch;
    private Vector<u8> m_hitFlagsScratch;
    private SolverWorkPartition m_partitionScratch;
    private Array<Vector<ContactConstraint>, s_GraphColorCount> m_cpuColorConstraintsScratch;
    private Vector<JointConstraint> m_cpuJointConstraintsScratch;
    private Vector<u32> m_brokenJointIdsScratch;
    private Vector<u32> m_sharedKinAwakeIndicesScratch;
