void AppendTestMeta(in StringView text, mut TestAString inOutMeta){
    native(in text, mut inOutMeta){
        inOutMeta.append(text.data(), text.size());
    }
}

b8 PrepareCleanDirectory(in GraphicsTestPath directory){
    b8 ok = false;
    native(in directory, mut ok){
        if(RemoveAllIfExists(directory))
            ok = EnsureDirectories(directory).has_value();
    }
    return ok;
}

b8 WriteTextFile(in GraphicsTestPath filePath, in StringView text){
    b8 ok = false;
    native(in filePath, in text, mut ok){
        if(EnsureDirectories(filePath.parentPath()))
            ok = ::WriteTextFile(filePath, text);
    }
    return ok;
}

StringView AssetsGraphicsTestConfigurationName(){
    StringView name = "opt";
    native(mut name){
#if defined(NWB_DEBUG)
        name = "dbg";
#elif defined(NWB_FINAL)
        name = "fin";
#endif
    }
    return name;
}


