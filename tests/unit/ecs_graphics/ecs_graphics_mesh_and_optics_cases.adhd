    EXPECT_FALSE(bounds.has_value());
}

void VerifyOutputLayerColor_TransparentHdrLayerPreservesSceneAndOpaqueUiIgnoresSceneExposure(){
    const ShaderFloat3 scene = ShaderFloat3(0.1, 3.0, 100.0);
    OutputLayerColor_ExpectColorNear(EcsGraphicsMeshOptics_nwbHdr10EncodeSceneWithUi(scene, ShaderFloat3(0.0), 0.0f), EcsGraphicsMeshOptics_nwbHdr10EncodeScene(scene), 0.000001);
    const ShaderFloat3 ui = ShaderFloat3(0.2, 0.5, 0.9);
    const ShaderFloat3 expected = EcsGraphicsMeshOptics_nwbHdr10EncodeUiLinear(ui);
    OutputLayerColor_ExpectColorNear(EcsGraphicsMeshOptics_nwbHdr10EncodeSceneWithUi(scene, ui, 1.0f), expected, 0.000001);
    OutputLayerColor_ExpectColorNear(EcsGraphicsMeshOptics_nwbHdr10EncodeSceneWithUi(scene * ShaderFloat3(64.0), ui, 1.0f), expected, 0.000001);
}

void VerifyOutputLayerColor_HdrBlendsInLinearNitsBeforeOnePqEncoding(){
    // Half-opacity paper white over black is 101.5 nits, not half of the encoded paper-white signal.
    const ShaderFloat3 actual = EcsGraphicsMeshOptics_nwbHdr10EncodeSceneWithUi(ShaderFloat3(0.0), ShaderFloat3(0.5), 0.5f);
    OutputLayerColor_ExpectColorNear(actual, EcsGraphicsMeshOptics_nwbHdr10PqEncodeNits(ShaderFloat3(101.5)), 0.000001);
    const ShaderFloat3 encodedBlend = EcsGraphicsMeshOptics_nwbHdr10EncodeUiLinear(ShaderFloat3(1.0)) * ShaderFloat3(0.5);
    EXPECT_GT(actual.x - encodedBlend.x, 0.1);
}

void VerifyOutputLayerColor_NegativeUiRadianceClampsAndHighlightsRemainBelowTheOutputBound(){
    EXPECT_LT(EcsGraphicsMeshOptics_nwbHdr10SceneToNits(ShaderFloat3(100.0)).x, 1000.0);
    OutputLayerColor_ExpectColorNear(EcsGraphicsMeshOptics_nwbHdr10EncodeUiLinear(ShaderFloat3(-1.0)), EcsGraphicsMeshOptics_nwbHdr10EncodeUiLinear(ShaderFloat3(0.0)), 0.000001);
}

void VerifyOutputLayer_MissingContributorInvalidTokenAndZeroGenerationCannotPublishAcceptance(){
