void VerifyUiPointerGestureValueTests_InitialPressCopiesAcceptedOpaqueBitsWithoutNumericInterpretation(mut UiPointerGestureValueTests self){
    Array<u64, 6u> values = Array<u64, 6u>();
    values[0u] = 0u;
    values[1u] = bit_cast<u64>(-0.0);
    values[2u] = bit_cast<u64>(f64.max);
    values[3u] = 0xfedcba9876543210u;
    values[4u] = 0x7ff8000000000042u;
    values[5u] = u64.max;
    for(in u64 value : values){
        const ScopedTestTrace trace = ScopedTestTrace(value);
        self.m_targets[1u].value = value;
        ASSERT_TRUE(self.publish());
        self.m_targets[1u].value = ~value;
        EXPECT_EQ(self.m_router.targets()[1u].value, value);
        EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryDown, 30.0f, 30.0f)).pointerConsumed);
        const auto gestureResult1 = self.take();
        ASSERT_TRUE(gestureResult1.has_value());
        PointerGesture gesture = gestureResult1.value();
        EXPECT_EQ(gesture.value, value);
        EXPECT_EQ(gesture.state, PointerGestureState::Active);
        EXPECT_EQ(gesture.id.layoutGeneration, self.m_generation);
        EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryUp, 30.0f, 30.0f)).pointerConsumed);
        const auto gestureResult2 = self.take();
        ASSERT_TRUE(gestureResult2.has_value());
        gesture = gestureResult2.value();
        EXPECT_EQ(gesture.value, value);
        EXPECT_EQ(gesture.state, PointerGestureState::Completed);
        EXPECT_FALSE(self.take().has_value());
    }
}

void VerifyUiPointerGestureValueTests_ActiveUpdatesAndOutsideCompletionKeepOriginalPayload(mut UiPointerGestureValueTests self){
    ASSERT_TRUE(self.publish());
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryDown, 30.0f, 30.0f)).pointerConsumed);
    const auto gestureResult1 = self.take();
    ASSERT_TRUE(gestureResult1.has_value());
    PointerGesture gesture = gestureResult1.value();
    const PointerGesture baseline = gesture;
    EXPECT_EQ(baseline.value, bit_cast<u64>(-0.0));
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PointerMove, 30.0f, 30.0f)).pointerConsumed);
    EXPECT_FALSE(self.take().has_value());
    self.m_targets[1u].value = 91u;
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PointerMove, 70.0f, 30.0f)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PointerMove, 110.0f, 50.0f)).pointerConsumed);
    const auto gestureResult2 = self.take();
    ASSERT_TRUE(gestureResult2.has_value());
    gesture = gestureResult2.value();
    EXPECT_EQ(gesture.value, baseline.value);
    EXPECT_EQ(gesture.id.sequence, baseline.id.sequence);
    EXPECT_EQ(gesture.id.layoutGeneration, baseline.id.layoutGeneration);
    EXPECT_GT(gesture.updateSequence, baseline.updateSequence);
    EXPECT_FLOAT_EQ(gesture.origin.x, 30.0f);
    EXPECT_FLOAT_EQ(gesture.position.x, 110.0f);
    EXPECT_FLOAT_EQ(gesture.position.y, 50.0f);
    const u64 moveSequence = gesture.updateSequence;
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryUp, 260.0f, 180.0f)).pointerConsumed);
    const auto gestureResult3 = self.take();
    ASSERT_TRUE(gestureResult3.has_value());
    gesture = gestureResult3.value();
    EXPECT_EQ(gesture.value, baseline.value);
    EXPECT_EQ(gesture.id.sequence, baseline.id.sequence);
    EXPECT_EQ(gesture.state, PointerGestureState::Completed);
    EXPECT_GT(gesture.updateSequence, moveSequence);
    EXPECT_FLOAT_EQ(gesture.position.x, 260.0f);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.m_router.controlActions().empty());
}

void VerifyUiPointerGestureValueTests_RepaintingValueAndThumbGeometryDoesNotReplaceAnActivePressBaseline(mut UiPointerGestureValueTests self){
    ASSERT_TRUE(self.publish());
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryDown, 30.0f, 30.0f)).pointerConsumed);
    const auto gestureResult1 = self.take();
    ASSERT_TRUE(gestureResult1.has_value());
    PointerGesture gesture = gestureResult1.value();
    const PointerGesture baseline = gesture;
    self.m_targets[1u].value = bit_cast<u64>(f64.max);
    self.m_targets[1u].rectangle = MakeUiPointerGestureRect(120.0f, 20.0f, 40.0f, 20.0f);
    self.m_targets[1u].gestureReference = MakeUiPointerGestureRect(90.0f, 20.0f, 100.0f, 20.0f);
    self.m_targets[1u].gestureMaximum = 19.0;
    ASSERT_TRUE(self.publish());
    EXPECT_EQ(self.m_router.capture(), self.m_targets[1u].id);
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_EQ(self.m_router.targets()[1u].value, self.m_targets[1u].value);
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PointerMove, 140.0f, 30.0f)).pointerConsumed);
    const auto gestureResult2 = self.take();
    ASSERT_TRUE(gestureResult2.has_value());
    gesture = gestureResult2.value();
    EXPECT_EQ(gesture.value, baseline.value);
    EXPECT_EQ(gesture.id.sequence, baseline.id.sequence);
    EXPECT_EQ(gesture.id.layoutGeneration, 1u);
    EXPECT_FLOAT_EQ(gesture.targetRectangle.x, 20.0f);
    EXPECT_FLOAT_EQ(gesture.referenceRectangle.x, 10.0f);
    EXPECT_FLOAT_EQ(gesture.referenceRectangle.width, 180.0f);
    EXPECT_DOUBLE_EQ(gesture.maximum, 9.0);
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryUp, 150.0f, 30.0f)).pointerConsumed);
    const auto gestureResult3 = self.take();
    ASSERT_TRUE(gestureResult3.has_value());
    gesture = gestureResult3.value();
    EXPECT_EQ(gesture.value, baseline.value);
    EXPECT_EQ(gesture.state, PointerGestureState::Completed);
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryDown, 130.0f, 30.0f)).pointerConsumed);
    const auto gestureResult4 = self.take();
    ASSERT_TRUE(gestureResult4.has_value());
    gesture = gestureResult4.value();
    EXPECT_EQ(gesture.value, self.m_targets[1u].value);
    EXPECT_EQ(gesture.id.layoutGeneration, 2u);
    EXPECT_GT(gesture.id.sequence, baseline.id.sequence);
    EXPECT_FLOAT_EQ(gesture.targetRectangle.x, 120.0f);
    EXPECT_FLOAT_EQ(gesture.referenceRectangle.x, 90.0f);
    EXPECT_DOUBLE_EQ(gesture.maximum, 19.0);
}

void VerifyUiPointerGestureValueTests_SeveralCompletedPressesRetainTheirOwnPublishedValuesUntilConsumption(mut UiPointerGestureValueTests self){
    Array<u64, 3u> values = Array<u64, 3u>();
    values[0u] = 17u;
    values[1u] = bit_cast<u64>(-0.0);
    values[2u] = 0xfedcba9876543210u;
    for(usize index = 0u; index < values.size(); ++index){
        self.m_targets[1u].value = values[index];
        ASSERT_TRUE(self.publish());
        EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryDown, 30.0f, 30.0f)).pointerConsumed);
        EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryUp, 35.0f, 30.0f)).pointerConsumed);
    }
    u64 previousSequence = 0u;
    for(usize index = 0u; index < values.size(); ++index){
        const auto gestureResult = self.take();
        ASSERT_TRUE(gestureResult.has_value());
        const PointerGesture gesture = gestureResult.value();
        EXPECT_EQ(gesture.value, values[index]);
        EXPECT_EQ(gesture.id.layoutGeneration, index + 1u);
        EXPECT_EQ(gesture.state, PointerGestureState::Completed);
        EXPECT_GT(gesture.id.sequence, previousSequence);
        previousSequence = gesture.id.sequence;
    }
    EXPECT_FALSE(self.take().has_value());
}

void VerifyUiPointerGestureValueTests_CoalescedMoveUsesItsUpdateSequenceAmongOrderedControlActions(mut UiPointerGestureValueTests self){
    ASSERT_TRUE(self.publish());
    self.focusHost();
    ASSERT_TRUE(self.m_router.queue(NativeInput(MakeUiPointerGestureKeyEvent(InputEventType::KeyDown, Key::Right))).has_value());
    ASSERT_TRUE(self.m_router.queue(NativeInput(MakeUiPointerGestureKeyEvent(InputEventType::KeyUp, Key::Right))).has_value());
    ASSERT_TRUE(self.m_router.queue(NativeInput(MakeUiPointerGestureEventAt(InputEventType::PrimaryDown, 30.0f, 30.0f))).has_value());
    ASSERT_TRUE(self.m_router.queue(NativeInput(MakeUiPointerGestureEventAt(InputEventType::PointerMove, 50.0f, 30.0f))).has_value());
    ASSERT_TRUE(self.m_router.queue(NativeInput(MakeUiPointerGestureKeyEvent(InputEventType::KeyDown, Key::Left))).has_value());
    ASSERT_TRUE(self.m_router.queue(NativeInput(MakeUiPointerGestureKeyEvent(InputEventType::KeyUp, Key::Left))).has_value());
    ASSERT_TRUE(self.m_router.queue(NativeInput(MakeUiPointerGestureEventAt(InputEventType::PointerMove, 80.0f, 30.0f))).has_value());
    const InputRoutingResult result = self.m_router.process();
    EXPECT_TRUE(result.pointerConsumed);
    EXPECT_TRUE(result.commandConsumed);
    ASSERT_EQ(self.m_router.controlActions().size(), 2u);
    const auto rightResult = self.takeControl();
    ASSERT_TRUE(rightResult.has_value());
    const ControlAction right = rightResult.value();
    const auto leftResult = self.takeControl();
    ASSERT_TRUE(leftResult.has_value());
    const ControlAction left = leftResult.value();
    const auto gestureResult1 = self.take();
    ASSERT_TRUE(gestureResult1.has_value());
    PointerGesture gesture = gestureResult1.value();
    EXPECT_EQ(right.kind, ControlActionKind::Right);
    EXPECT_EQ(left.kind, ControlActionKind::Left);
    EXPECT_LT(right.id.sequence, gesture.id.sequence);
    EXPECT_LT(gesture.id.sequence, left.id.sequence);
    EXPECT_LT(left.id.sequence, gesture.updateSequence);
    EXPECT_EQ(gesture.value, bit_cast<u64>(-0.0));
    EXPECT_FLOAT_EQ(gesture.position.x, 80.0f);
    EXPECT_FALSE(self.take().has_value());
    const u64 moveSequence = gesture.updateSequence;
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryUp, 80.0f, 30.0f)).pointerConsumed);
    const auto gestureResult2 = self.take();
    ASSERT_TRUE(gestureResult2.has_value());
    gesture = gestureResult2.value();
    EXPECT_GT(gesture.updateSequence, moveSequence);
    EXPECT_EQ(gesture.value, bit_cast<u64>(-0.0));
    EXPECT_EQ(gesture.state, PointerGestureState::Completed);
}

void VerifyUiPointerGestureValueTests_RejectedPublicationPreservesAcceptedPayloadAndActiveCapture(mut UiPointerGestureValueTests self){
    ASSERT_TRUE(self.publish());
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryDown, 30.0f, 30.0f)).pointerConsumed);
    const HitTarget accepted = self.m_targets[1u];
    self.m_targets[1u].value = 91u;
    self.m_targets[1u].rectangle.width = -1.0f;
    EXPECT_FALSE(self.publish());
    EXPECT_EQ(self.m_router.layoutGeneration(), 1u);
    EXPECT_EQ(self.m_router.capture(), accepted.id);
    EXPECT_EQ(self.m_router.targets()[1u].value, accepted.value);
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryUp, 70.0f, 30.0f)).pointerConsumed);
    const auto gestureResult = self.take();
    ASSERT_TRUE(gestureResult.has_value());
    const PointerGesture gesture = gestureResult.value();
    EXPECT_EQ(gesture.value, accepted.value);
    EXPECT_EQ(gesture.id.layoutGeneration, 1u);
    EXPECT_EQ(gesture.state, PointerGestureState::Completed);
}

void VerifyUiPointerGestureValueTests_ReplacedControlTokenRetiresPayloadAndRestorationCannotReviveHeldPress(mut UiPointerGestureValueTests self){
    ASSERT_TRUE(self.publish());
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryDown, 30.0f, 30.0f)).pointerConsumed);
    const ControlToken original = self.m_targets[0u].control;
    for(mut HitTarget target : self.m_targets)
        ++target.control.contentRevision;
    ASSERT_TRUE(self.publish());
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.m_router.primaryDown());
    EXPECT_FALSE(self.take().has_value());
    for(mut HitTarget target : self.m_targets)
        target.control = original;
    self.m_targets[1u].value = 101u;
    ASSERT_TRUE(self.publish());
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryDown, 30.0f, 30.0f)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PointerMove, 70.0f, 30.0f)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryUp, 70.0f, 30.0f)).pointerConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryDown, 30.0f, 30.0f)).pointerConsumed);
    const auto gestureResult = self.take();
    ASSERT_TRUE(gestureResult.has_value());
    const PointerGesture gesture = gestureResult.value();
    EXPECT_EQ(gesture.value, 101u);
    EXPECT_EQ(gesture.id.layoutGeneration, 3u);
}

void VerifyUiPointerGestureValueTests_DeclarationPolicyClipAndOmissionRetirePayloadBeforeTheirRestoration(mut UiPointerGestureValueTests self){
    const HitTarget original = self.m_targets[1u];
    for(usize variant = 0u; variant < 5u; ++variant){
        const ScopedTestTrace trace = ScopedTestTrace(variant);
        self.m_targets[1u] = original;
        self.m_targets[1u].value = variant + 17u;
        ASSERT_TRUE(self.publish());
        EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryDown, 30.0f, 30.0f)).pointerConsumed);
        usize count = 2u;
        switch(variant){
        case 0u:
            ++self.m_targets[1u].declarationGeneration;
            break;
        case 1u:
            self.m_targets[1u].enabled = false;
            break;
        case 2u:
            self.m_targets[1u].clip = MakeUiPointerGestureRect(220.0f, 150.0f, 20.0f, 20.0f);
            break;
        case 3u:
            self.m_targets[1u].pointerGesture = false;
            break;
        default:
            count = 1u;
            break;
        }
        ASSERT_TRUE(self.publish(count));
        EXPECT_FALSE(self.take().has_value());
        self.m_targets[1u] = original;
        self.m_targets[1u].value = variant + 101u;
        ASSERT_TRUE(self.publish());
        EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PointerMove, 70.0f, 30.0f)).pointerConsumed);
        EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryUp, 70.0f, 30.0f)).pointerConsumed);
        EXPECT_FALSE(self.take().has_value());
        EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryDown, 30.0f, 30.0f)).pointerConsumed);
        EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryUp, 30.0f, 30.0f)).pointerConsumed);
        const auto gestureResult = self.take();
        ASSERT_TRUE(gestureResult.has_value());
        const PointerGesture gesture = gestureResult.value();
        EXPECT_EQ(gesture.value, variant + 101u);
        EXPECT_EQ(gesture.state, PointerGestureState::Completed);
    }
}

void VerifyUiPointerGestureValueTests_NativeCaptureLossDiscardsActivePayloadAndKeepsCompletedPressSnapshot(mut UiPointerGestureValueTests self){
    self.m_targets[1u].value = 17u;
    ASSERT_TRUE(self.publish());
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryDown, 30.0f, 30.0f)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryUp, 35.0f, 30.0f)).pointerConsumed);
    self.m_targets[1u].value = 91u;
    ASSERT_TRUE(self.publish());
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryDown, 30.0f, 30.0f)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiPointerGestureBareEvent(InputEventType::PointerCaptureLost)).pointerConsumed);
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_FALSE(self.m_router.primaryDown());
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    const auto gestureResult1 = self.take();
    ASSERT_TRUE(gestureResult1.has_value());
    PointerGesture gesture = gestureResult1.value();
    EXPECT_EQ(gesture.value, 17u);
    EXPECT_EQ(gesture.state, PointerGestureState::Completed);
    const u64 previousSequence = gesture.id.sequence;
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiPointerGestureEventAt(InputEventType::PrimaryDown, 30.0f, 30.0f)).pointerConsumed);
    const auto gestureResult2 = self.take();
    ASSERT_TRUE(gestureResult2.has_value());
    gesture = gestureResult2.value();
    EXPECT_GT(gesture.id.sequence, previousSequence);
}


