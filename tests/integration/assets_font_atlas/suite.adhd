const StringView s_BodyFontPath = "project/fonts/body";
const StringView s_BodyFontAtlasPath = "project/fonts/body_atlas";
const StringView s_LatinFontFilename = "latin.font";
const StringView s_LatinMetadataFilename = "latin.nwb";
const StringView s_FontVirtualRoot = "project/fonts";
const StringView s_GlyphsField = "glyphs";
const StringView s_FontField = "font";
const StringView s_FaceVariable = "face";
const StringView s_AtlasVariable = "atlas";
