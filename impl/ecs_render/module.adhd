#include <impl/ecs_render/caustic/settings.adhd.h>
#include <impl/ecs_render/gi/quality_settings.adhd.h>
#include <impl/ecs_render/material/material_instance.adhd.h>
#include <impl/ecs_render/reflection/frame_parameters.adhd.h>
#include <impl/ecs_render/refraction/types.adhd.h>
#include <impl/ecs_render/deferred/presentation_settings.adhd.h>
#include <impl/ecs_render/shadow/light_space_plan.adhd.h>
#include <impl/ecs_render/shadow/quality_settings.adhd.h>

#include <core/alloc/general.h>
#include <core/ecs/system.h>
#include <core/graphics/runtime/render_pass.h>
#include <core/task/gpu/packet_runtime.h>
#include <core/telemetry/frame_graph_contributor.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_ASSETS_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class AssetManager;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_ASSETS_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ActiveSceneSubsystems;
class RendererFramePipeline;

using ActiveSceneSubsystemsConstPtr = const ActiveSceneSubsystems*;
using RendererShaderPathResolveCallback = Function< Expected<Name>(const Name& shaderName, AStringView variantName, const Name& stageName) >;
using RendererFramePipelineOwner = NotNullUniquePtr<RendererFramePipeline, Core::GlobalUniquePtr<RendererFramePipeline>::deleter_type>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena, system("renderer")]
class RendererSystem : IRenderPass, IFrameGraphContributor{
    private RendererFramePipelineOwner m_pipeline;

    public RendererSystem(mut World world, mut GraphicsRuntime graphics, mut AssetManager assetManager, in RendererShaderPathResolveCallback shaderPathResolver);
    public ~RendererSystem();

    public b8 validateResources(in u32 width, in u32 height, in u32 sampleCount)override;
    public void invalidateResources()override;

    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta)override;

    public b8 prepareResources(in FramebufferPtr framebuffer)override;
    public void render(in FramebufferPtr framebuffer)override;
    public b8 appendFrameGraph(mut FrameGraphBuilder builder)override;

    public void setActiveSceneSubsystems(in ActiveSceneSubsystemsConstPtr subsystems);
    public void setRefractionEnabled(in b8 enabled);
    public void setRefractionHardwareTracingEnabled(in b8 enabled);
    public void setRefractionDiagnosticsEnabled(in b8 enabled);
    public Expected<RefractionStatistics> tryGetLatestRefractionStatistics()const;
    public b8 setCausticQualitySettings(in CausticQualitySettings settings);
    public b8 setSurfelGiQualitySettings(in SurfelGiQualitySettings settings);
    public b8 setSoftwareShadowSettings(in SoftwareShadowSettings settings);
    public b8 setShadowQualitySettings(in ShadowQualitySettings settings);
    public b8 setReflectionSettings(in ReflectionSettings settings);
    public Expected<ReflectionStatistics> tryGetLatestReflectionStatistics()const;
    public b8 setPresentationSettings(in PresentationSettings settings);
    public void setFrameLaggedAsyncLightingEnabled(in b8 enabled);
    public GpuTaskGraphRuntimeStatistics deferredTaskGraphRuntimeStatistics()const;
}


