class DeferredGraphResourceImportResult;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct OpaqueGbufferResourceUseInputs{
    const DeferredGraphResourceImportResult& resources;
    Core::BufferRange materialInstanceRange;
    Core::BufferRange materialTypedRange;
    Core::BufferRange csgReceiverRange;
    Core::BufferRange csgCutterRange;
    Core::TextureSubresourceSet csgPeelSubresources;
    Core::TextureSubresourceSet csgReceiverEventDataSubresources;
    Core::TextureSubresourceSet csgReceiverEventCountSubresources;
    b8 hasOpaqueDrawItems = false;
    b8 hasCsgFrameGpuWork = false;
    b8 hasOpaqueCsgFrameWork = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class OpaqueGbufferResourceUseBuilder final{
public:
    static void Append(const OpaqueGbufferResourceUseInputs& inputs, Vector<Core::GpuTaskResourceUse, Core::Alloc::ScratchArena>& uses);
};


