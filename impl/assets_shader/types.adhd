////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_SpvMagic = 0x07230203u;
const usize s_SpvWordBytes = 4u;
const usize s_SpvWordByteMask = s_SpvWordBytes - 1u;
const u32 s_AssetPayloadMagic = 0x53484431u; // SHD1
const u32 s_AssetPayloadVersion = 1u;
const usize s_AssetPayloadHeaderBytes = 8u;
const usize s_MaxShaderEntryPointBytes = 0xFFFFFFFFu;
const Name s_MeshComputeArchiveStageName = "mesh_compute";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
enum<u8> BytecodeValidationFailure{
    None,
    InvalidSize,
    InvalidMagic
}

[reflect]
enum<u8> AssetPayloadEncodeFailure{
    None,
    InvalidEntryPoint,
    InvalidBytecode,
    OutputSizeOverflow
}

[reflect]
enum<u8> AssetPayloadDecodeFailure{
    InvalidHeader,
    UnsupportedVersion,
    InvalidEntryPoint,
    InvalidBytecode
}

class AssetPayloadView{
    public StringView entryPoint = "";
    public Span<u8> bytecode;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidBytecodeSize(in usize byteSize){
    return byteSize >= s_SpvWordBytes && (byteSize % s_SpvWordBytes) == 0u;
}

BytecodeValidationFailure ValidateBytecode(in Span<u8> binary){
    if(!IsValidBytecodeSize(binary.size()))
        return BytecodeValidationFailure::InvalidSize;

    const u32 magic =
        cast<u32>(binary[0u])
        | (cast<u32>(binary[1u]) << 8u)
        | (cast<u32>(binary[2u]) << 16u)
        | (cast<u32>(binary[3u]) << 24u)
    ;
    if(magic != s_SpvMagic)
        return BytecodeValidationFailure::InvalidMagic;

    return BytecodeValidationFailure::None;
}

Expected<usize> TryComputeShaderAssetPayloadByteCount(
    in usize entryPointByteLength,
    in usize bytecodeByteLength
){
    usize entryPointBytes = 4u + entryPointByteLength;
    if(entryPointBytes < entryPointByteLength || entryPointBytes > 0xFFFFFFFFFFFFFFFFu - s_AssetPayloadHeaderBytes)
        return MakeUnexpected(Failure());
    usize headerAndEntryPointBytes = s_AssetPayloadHeaderBytes + entryPointBytes;
    if(bytecodeByteLength > 0xFFFFFFFFFFFFFFFFu - headerAndEntryPointBytes)
        return MakeUnexpected(Failure());
    return headerAndEntryPointBytes + bytecodeByteLength;
}

void ReportShaderAssetPayloadDecodeFailure(in AssetPayloadDecodeFailure failure){
    switch(failure){
    case AssetPayloadDecodeFailure::InvalidHeader:
        error("IShader::loadBinaryForStage failed: invalid shader payload header");
        break;
    case AssetPayloadDecodeFailure::UnsupportedVersion:
        error("IShader::loadBinaryForStage failed: unsupported shader payload version");
        break;
    case AssetPayloadDecodeFailure::InvalidEntryPoint:
        error("IShader::loadBinaryForStage failed: invalid shader entry point");
        break;
    case AssetPayloadDecodeFailure::InvalidBytecode:
        error("IShader::loadBinaryForStage failed: invalid SPIR-V bytecode");
        break;
    }
}

AssetPayloadEncodeFailure EncodeAssetPayload(
    in StringView entryPoint,
    in Span<u8> bytecode,
    mut Vector<u8> outPayload
){
    if(entryPoint.empty() || entryPoint.size() > s_MaxShaderEntryPointBytes)
        return AssetPayloadEncodeFailure::InvalidEntryPoint;
    if(ValidateBytecode(bytecode) != BytecodeValidationFailure::None)
        return AssetPayloadEncodeFailure::InvalidBytecode;

    const Expected<usize> payloadBytes = TryComputeShaderAssetPayloadByteCount(entryPoint.size(), bytecode.size());
    if(!payloadBytes.has_value())
        return AssetPayloadEncodeFailure::OutputSizeOverflow;

    outPayload.clear();
    outPayload.reserve(payloadBytes.value());
    AppendU32LittleEndian(outPayload, s_AssetPayloadMagic);
    AppendU32LittleEndian(outPayload, s_AssetPayloadVersion);
    if(!AppendString(outPayload, entryPoint))
        return AssetPayloadEncodeFailure::OutputSizeOverflow;
    for(in u8 byte : bytecode)
        outPayload.push_back(byte);
    return AssetPayloadEncodeFailure::None;
}

b8 SerializeShaderAssetPayload(
    in StringView entryPoint,
    in Span<u8> bytecode,
    mut Vector<u8> outBinary
){
    switch(EncodeAssetPayload(entryPoint, bytecode, outBinary)){
    case AssetPayloadEncodeFailure::None:
        return true;
    case AssetPayloadEncodeFailure::InvalidEntryPoint:
        error("ShaderAssetCodec::serialize failed: shader entry point is empty or too long");
        return false;
    case AssetPayloadEncodeFailure::InvalidBytecode:
        error("ShaderAssetCodec::serialize failed: invalid SPIR-V bytecode");
        return false;
    case AssetPayloadEncodeFailure::OutputSizeOverflow:
        error("ShaderAssetCodec::serialize failed: shader payload size overflow");
        return false;
    }
    return false;
}

Expected<AssetPayloadView, AssetPayloadDecodeFailure> DecodeAssetPayload(in Span<u8> payload){
    usize cursor = 0u;
    const Expected<u32> magic = ReadU32LittleEndian(payload, cursor);
    const Expected<u32> version = ReadU32LittleEndian(payload, cursor);
    if(!magic.has_value() || !version.has_value() || magic.value() != s_AssetPayloadMagic)
        return MakeUnexpected(AssetPayloadDecodeFailure::InvalidHeader);
    if(version.value() != s_AssetPayloadVersion)
        return MakeUnexpected(AssetPayloadDecodeFailure::UnsupportedVersion);
    const Expected<StringView> entryPoint = ReadString(payload, cursor);
    if(!entryPoint.has_value() || entryPoint.value().empty())
        return MakeUnexpected(AssetPayloadDecodeFailure::InvalidEntryPoint);

    const Span<u8> bytecode = payload.subspan(cursor, payload.size() - cursor);
    if(ValidateBytecode(bytecode) != BytecodeValidationFailure::None)
        return MakeUnexpected(AssetPayloadDecodeFailure::InvalidBytecode);
    AssetPayloadView outView;
    outView.entryPoint = entryPoint.value();
    outView.bytecode = bytecode;
    return outView;
}

StringView ShaderEntryPointView(in Span<u8> bytecode, in usize offset, in usize length){
    StringView entryPoint = "";
    if(length == 0u || offset >= bytecode.size() || length >= bytecode.size() - offset)
        return entryPoint;
    native(in bytecode, in offset, in length, mut entryPoint){
        entryPoint = AStringView(reinterpret_cast<const char*>(bytecode.data()) + offset, length);
    }
    return entryPoint;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

