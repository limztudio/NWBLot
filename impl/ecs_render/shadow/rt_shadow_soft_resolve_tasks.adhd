#include <impl/ecs_render/raytrace/raytracing_system.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>
#include <impl/ecs_render/shadow/rt_shadow_state.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void FinishGpuTimingMeasure(mut Optional<GpuTimingMeasure> timing, mut CommandList commandList){
    if(timing.has_value()){
        timing.value().finishTiming(commandList);
        timing.reset();
    }
}

class ShadowVisibilityOpaqueGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut GraphicsRuntime m_graphics;
    private SoftShadowSplitTaskContext m_context;
    private b8 m_hardwareShadowSupported;
    private b8 m_graphOwnsOpaqueTemporalMergeEntryStates;
    private FrozenLightSpaceShadowHandle m_lightSpace;
    private in b8 m_prepared;

    public ShadowVisibilityOpaqueGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut GraphicsRuntime graphics,
        in SoftShadowSplitTaskContext context,
        in b8 hardwareShadowSupported,
        in b8 graphOwnsOpaqueTemporalMergeEntryStates,
        in FrozenLightSpaceShadowHandle lightSpace,
        in borrow b8 prepared
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_graphics = graphics;
        this.m_context = context;
        this.m_hardwareShadowSupported = hardwareShadowSupported;
        this.m_graphOwnsOpaqueTemporalMergeEntryStates = graphOwnsOpaqueTemporalMergeEntryStates;
        this.m_lightSpace = lightSpace;
        this.m_prepared = prepared;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute | GpuQueueCapability::Transfer); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_context.deferredLightingResources.valid())
            return false;

        const Optional<GpuPhysicalQueueInfo> queue = context.compiledPlan.findQueueInfo(context.queue);
        if(!queue.has_value())
            return false;

        this.m_context.opaqueProduced = false;
        this.m_context.opaqueFrameIndex = 0u;
        DiscardGpuTimingMeasure(this.m_context.shadowVisibilityTiming);
        DiscardGpuTimingMeasure(this.m_context.asyncTiming);

        GpuTimingTicketRecordingScope timingRecording(this.m_context.timingTicket);
        if(queue.value().queueClass == CommandQueue::Compute)
            this.m_context.asyncTiming.emplace(this.m_graphics.gpuTiming(), s_TimingScopeAsyncShadow, this.m_graphics.getDevice(), commandList);
        this.m_context.shadowVisibilityTiming.emplace(this.m_graphics.gpuTiming(), s_TimingScopeShadowVisibility, this.m_graphics.getDevice(), commandList);

        b8 opaqueRecorded = false;
        if(this.m_prepared){
            Optional<in LightSpaceShadowSnapshot> lightSpaceOpt;
            if(this.m_lightSpace.valid())
                lightSpaceOpt = Optional<in LightSpaceShadowSnapshot>(this.m_lightSpace.deref().snapshot);
            Expected<u32> opaqueFrame = MakeUnexpected(Failure());
            if(this.m_hardwareShadowSupported)
                opaqueFrame = this.m_raytracingSystem.renderShadowVisibilityOpaque(commandList, this.m_context.targets, this.m_context.deferredLightingResources, this.m_graphOwnsOpaqueTemporalMergeEntryStates, lightSpaceOpt);
            else
                opaqueFrame = this.m_raytracingSystem.renderGpuBvhShadowVisibilityOpaque(commandList, this.m_context.targets, this.m_context.deferredLightingResources, this.m_graphOwnsOpaqueTemporalMergeEntryStates, lightSpaceOpt);
            opaqueRecorded = opaqueFrame.has_value();
            if(opaqueFrame.has_value())
                this.m_context.opaqueFrameIndex = opaqueFrame.value();
        }
        if(!opaqueRecorded){
            warning("RendererSystem: split opaque soft-shadow producer failed; retaining all-lit visibility");
            this.m_raytracingSystem.clearShadowVisibility(commandList, this.m_context.targets);
            commandList.setTextureState(this.m_context.targets.shadowVisibility.deref(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
            commandList.commitBarriers();
            DiscardGpuTimingMeasure(this.m_context.shadowVisibilityTiming);
            DiscardGpuTimingMeasure(this.m_context.asyncTiming);
            return true;
        }

        this.m_context.opaqueProduced = true;
        const b8 visibilityMarkerFinished = FinishSplitGpuTimingMarker(this.m_context.shadowVisibilityTiming);
        b8 asyncMarkerFinished = true;
        if(this.m_context.asyncTiming.has_value())
            asyncMarkerFinished = FinishSplitGpuTimingMarker(this.m_context.asyncTiming);
        if(!asyncMarkerFinished || !visibilityMarkerFinished){
            DiscardGpuTimingMeasure(this.m_context.asyncTiming);
            DiscardGpuTimingMeasure(this.m_context.shadowVisibilityTiming);
            return false;
        }
        return true;
    }

    public void discarded(){
        this.m_context.opaqueProduced = false;
        DiscardGpuTimingMeasure(this.m_context.shadowVisibilityTiming);
        DiscardGpuTimingMeasure(this.m_context.asyncTiming);
    }
}

class ShadowVisibilityOpaqueFirstWaveletGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut GraphicsRuntime m_graphics;
    private SoftShadowSplitTaskContext m_context;
    private b8 m_hardwareShadowSupported;
    private b8 m_graphOwnsOpaqueTemporalMergeEntryStates;
    private b8 m_deferUpsample;
    private b8 m_deferWavelet;

    public ShadowVisibilityOpaqueFirstWaveletGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut GraphicsRuntime graphics,
        in SoftShadowSplitTaskContext context,
        in b8 hardwareShadowSupported,
        in b8 graphOwnsOpaqueTemporalMergeEntryStates,
        in b8 deferUpsample,
        in b8 deferWavelet
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_graphics = graphics;
        this.m_context = context;
        this.m_hardwareShadowSupported = hardwareShadowSupported;
        this.m_graphOwnsOpaqueTemporalMergeEntryStates = graphOwnsOpaqueTemporalMergeEntryStates;
        this.m_deferUpsample = deferUpsample;
        this.m_deferWavelet = deferWavelet;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_context.deferredLightingResources.valid())
            return false;
        if(!this.m_context.opaqueProduced)
            return true;

        GpuTimingTicketRecordingScope timingRecording(this.m_context.timingTicket);
        DiscardGpuTimingMeasure(this.m_context.opaqueResolveTiming);
        this.m_context.opaqueResolveTiming.emplace(this.m_graphics.gpuTiming(), s_TimingScopeShadowOpaqueResolve, this.m_graphics.getDevice(), commandList);
        if(this.m_raytracingSystem.renderSoftOpaqueShadowResolvePhase(
            commandList,
            this.m_context.targets,
            this.m_context.deferredLightingResources,
            this.m_context.opaqueFrameIndex,
            this.m_hardwareShadowSupported,
            this.m_graphOwnsOpaqueTemporalMergeEntryStates,
            ResolveSoftShadowOpaqueFirstWaveletPhase(this.m_deferWavelet)
        )){
            if(this.m_deferUpsample){
                FinishGpuTimingMeasure(this.m_context.opaqueResolveTiming, commandList);
                return true;
            }
            return FinishSplitGpuTimingMarker(this.m_context.opaqueResolveTiming);
        }

        warning("RendererSystem: split opaque soft-shadow first wavelet failed; retaining all-lit visibility");
        RecoverOpaqueSoftShadowAllLit(this.m_raytracingSystem, this.m_context.targets, this.m_context.opaqueProduced, this.m_context.asyncTiming, this.m_context.shadowVisibilityTiming, this.m_context.opaqueResolveTiming, commandList);
        return true;
    }

    public void discarded(){
        this.m_context.opaqueProduced = false;
        DiscardGpuTimingMeasure(this.m_context.asyncTiming);
        DiscardGpuTimingMeasure(this.m_context.shadowVisibilityTiming);
        DiscardGpuTimingMeasure(this.m_context.opaqueResolveTiming);
    }
}

class ShadowVisibilityOpaqueResolveTailGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private SoftShadowSplitTaskContext m_context;
    private b8 m_hardwareShadowSupported;

    public ShadowVisibilityOpaqueResolveTailGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        in SoftShadowSplitTaskContext context,
        in b8 hardwareShadowSupported
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_context = context;
        this.m_hardwareShadowSupported = hardwareShadowSupported;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_context.deferredLightingResources.valid())
            return false;
        if(!this.m_context.opaqueProduced)
            return true;
        if(!this.m_context.opaqueResolveTiming.has_value())
            return false;

        GpuTimingTicketRecordingScope timingRecording(this.m_context.timingTicket);
        if(this.m_raytracingSystem.renderSoftOpaqueShadowResolveTail(commandList, this.m_context.targets, this.m_context.deferredLightingResources, this.m_context.opaqueFrameIndex, this.m_hardwareShadowSupported)){
            FinishGpuTimingMeasure(this.m_context.opaqueResolveTiming, commandList);
            return true;
        }

        warning("RendererSystem: split opaque soft-shadow resolve tail failed; retaining all-lit visibility");
        RecoverOpaqueSoftShadowAllLit(this.m_raytracingSystem, this.m_context.targets, this.m_context.opaqueProduced, this.m_context.asyncTiming, this.m_context.shadowVisibilityTiming, this.m_context.opaqueResolveTiming, commandList);
        return true;
    }

    public void discarded(){
        this.m_context.opaqueProduced = false;
        DiscardGpuTimingMeasure(this.m_context.asyncTiming);
        DiscardGpuTimingMeasure(this.m_context.shadowVisibilityTiming);
        DiscardGpuTimingMeasure(this.m_context.opaqueResolveTiming);
    }
}

class ShadowTransparentSoftTraceGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private SoftShadowSplitTaskContext m_context;
    private FrozenLightSpaceShadowHandle m_lightSpace;

    public ShadowTransparentSoftTraceGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        in SoftShadowSplitTaskContext context,
        in FrozenLightSpaceShadowHandle lightSpace
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_context = context;
        this.m_lightSpace = lightSpace;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute | GpuQueueCapability::Transfer); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_context.deferredLightingResources.valid())
            return false;

        this.m_context.transparentTraceProduced = false;
        if(!this.m_context.opaqueProduced)
            return true;

        GpuTimingTicketRecordingScope timingRecording(this.m_context.timingTicket);
        Optional<in LightSpaceShadowSnapshot> lightSpaceOpt;
        if(this.m_lightSpace.valid())
            lightSpaceOpt = Optional<in LightSpaceShadowSnapshot>(this.m_lightSpace.deref().snapshot);
        if(!this.m_raytracingSystem.renderSoftTransparentShadowTrace(commandList, this.m_context.targets, this.m_context.deferredLightingResources, this.m_context.opaqueFrameIndex, true, lightSpaceOpt)){
            warning("RendererSystem: split transparent soft-shadow trace could not record; preserving opaque visibility");
            return true;
        }
        this.m_context.transparentTraceProduced = true;
        return true;
    }

    public void discarded(){
        this.m_context.transparentTraceProduced = false;

    }
}

class ShadowTransparentSoftTemporalMergeGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut GraphicsRuntime m_graphics;
    private SoftShadowSplitTaskContext m_context;
    private b8 m_graphOwnsTransparentTemporalMergeEntryStates;
    private b8 m_combinedTemporal;
    private b8 m_hardwareShadowSupported;

    public ShadowTransparentSoftTemporalMergeGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut GraphicsRuntime graphics,
        in SoftShadowSplitTaskContext context,
        in b8 graphOwnsTransparentTemporalMergeEntryStates,
        in b8 combinedTemporal,
        in b8 hardwareShadowSupported
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_graphics = graphics;
        this.m_context = context;
        this.m_graphOwnsTransparentTemporalMergeEntryStates = graphOwnsTransparentTemporalMergeEntryStates;
        this.m_combinedTemporal = combinedTemporal;
        this.m_hardwareShadowSupported = hardwareShadowSupported;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    private b8 recoverOpaqueTemporal(mut CommandList commandList)const{
        if(!this.m_combinedTemporal)
            return true;
        return this.m_raytracingSystem.renderSoftOpaqueShadowResolvePhase(commandList, this.m_context.targets, this.m_context.deferredLightingResources, this.m_context.opaqueFrameIndex, this.m_hardwareShadowSupported, true, SoftShadowOpaqueResolvePhase::TemporalOnly);
    }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_context.deferredLightingResources.valid())
            return false;
        if(!this.m_context.opaqueProduced)
            return true;

        GpuTimingTicketRecordingScope timingRecording(this.m_context.timingTicket);
        if(!this.m_context.transparentTraceProduced)
            return this.recoverOpaqueTemporal(commandList);
        DiscardGpuTimingMeasure(this.m_context.transparentResolveTiming);
        this.m_context.transparentResolveTiming.emplace(this.m_graphics.gpuTiming(), s_TimingScopeShadowTransparentResolve, this.m_graphics.getDevice(), commandList);
        b8 merged = false;
        if(this.m_combinedTemporal)
            merged = this.m_raytracingSystem.renderSoftShadowCombinedTemporalMerge(commandList, this.m_context.targets);
        else
            merged = this.m_raytracingSystem.renderSoftTransparentShadowTemporalMerge(commandList, this.m_context.targets, this.m_context.deferredLightingResources, this.m_context.opaqueFrameIndex, this.m_graphOwnsTransparentTemporalMergeEntryStates);
        if(merged)
            return FinishSplitGpuTimingMarker(this.m_context.transparentResolveTiming);

        warning("RendererSystem: split transparent soft-shadow temporal merge failed; preserving opaque visibility");
        this.m_context.transparentTraceProduced = false;
        DiscardGpuTimingMeasure(this.m_context.transparentResolveTiming);
        return this.recoverOpaqueTemporal(commandList);
    }

    public void discarded(){
        this.m_context.transparentTraceProduced = false;
        DiscardGpuTimingMeasure(this.m_context.transparentResolveTiming);
    }
}

class ShadowTransparentSoftFirstWaveletGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut GraphicsRuntime m_graphics;
    private SoftShadowSplitTaskContext m_context;
    private b8 m_graphOwnsTransparentWaveletInputBoundary;
    private b8 m_startsTransparentResolveTiming;
    private b8 m_combinedWavelet;

    public ShadowTransparentSoftFirstWaveletGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut GraphicsRuntime graphics,
        in SoftShadowSplitTaskContext context,
        in b8 graphOwnsTransparentWaveletInputBoundary,
        in b8 startsTransparentResolveTiming,
        in b8 combinedWavelet
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_graphics = graphics;
        this.m_context = context;
        this.m_graphOwnsTransparentWaveletInputBoundary = graphOwnsTransparentWaveletInputBoundary;
        this.m_startsTransparentResolveTiming = startsTransparentResolveTiming;
        this.m_combinedWavelet = combinedWavelet;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_context.deferredLightingResources.valid())
            return false;
        if(!this.m_context.opaqueProduced)
            return true;
        if(this.m_combinedWavelet){
            GpuTimingTicketRecordingScope timingRecording(this.m_context.timingTicket);
            if(this.m_context.transparentTraceProduced && this.m_context.transparentResolveTiming.has_value()){
                if(this.m_raytracingSystem.renderSoftShadowCombinedWavelet(commandList, this.m_context.targets))
                    return true;
            }
            this.m_context.transparentTraceProduced = false;
            DiscardGpuTimingMeasure(this.m_context.transparentResolveTiming);
            return this.m_raytracingSystem.renderSoftOpaqueShadowResolvePhase(commandList, this.m_context.targets, this.m_context.deferredLightingResources, this.m_context.opaqueFrameIndex, true, true, SoftShadowOpaqueResolvePhase::WaveletOnly);
        }
        if(!this.m_context.transparentTraceProduced)
            return true;

        GpuTimingTicketRecordingScope timingRecording(this.m_context.timingTicket);
        if(this.m_startsTransparentResolveTiming){
            DiscardGpuTimingMeasure(this.m_context.transparentResolveTiming);
            this.m_context.transparentResolveTiming.emplace(this.m_graphics.gpuTiming(), s_TimingScopeShadowTransparentResolve, this.m_graphics.getDevice(), commandList);
        }
        else if(!this.m_context.transparentResolveTiming.has_value()){
            warning("RendererSystem: split transparent soft-shadow wavelet lost its temporal timing envelope; preserving opaque visibility");
            this.m_context.transparentTraceProduced = false;
            return true;
        }

        if(this.m_raytracingSystem.renderSoftTransparentShadowFirstWavelet(commandList, this.m_context.targets, this.m_context.deferredLightingResources, this.m_context.opaqueFrameIndex, this.m_graphOwnsTransparentWaveletInputBoundary)){
            if(this.m_startsTransparentResolveTiming && !FinishSplitGpuTimingMarker(this.m_context.transparentResolveTiming))
                return false;
            return true;
        }

        warning("RendererSystem: split transparent soft-shadow first wavelet failed; preserving opaque visibility");
        this.m_context.transparentTraceProduced = false;
        DiscardGpuTimingMeasure(this.m_context.transparentResolveTiming);
        return true;
    }

    public void discarded(){
        this.m_context.transparentTraceProduced = false;
        DiscardGpuTimingMeasure(this.m_context.transparentResolveTiming);
    }
}

class ShadowTransparentSoftFoldGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private SoftShadowSplitTaskContext m_context;
    private b8 m_combinedUpsample;

    public ShadowTransparentSoftFoldGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        in SoftShadowSplitTaskContext context,
        in b8 combinedUpsample
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_context = context;
        this.m_combinedUpsample = combinedUpsample;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_context.deferredLightingResources.valid())
            return false;

        const Optional<GpuPhysicalQueueInfo> queue = context.compiledPlan.findQueueInfo(context.queue);
        if(!queue.has_value())
            return false;
        if(!this.m_context.opaqueProduced)
            return true;
        if(!this.m_context.shadowVisibilityTiming.has_value() || (queue.value().queueClass == CommandQueue::Compute && !this.m_context.asyncTiming.has_value()))
            return false;

        GpuTimingTicketRecordingScope timingRecording(this.m_context.timingTicket);
        if(this.m_context.transparentTraceProduced){
            if(!this.m_context.transparentResolveTiming.has_value())
                return false;
            b8 resolved = false;
            if(this.m_combinedUpsample)
                resolved = this.m_raytracingSystem.renderSoftShadowTerminalUpsample(commandList, this.m_context.targets, this.m_context.deferredLightingResources, true);
            else
                resolved = this.m_raytracingSystem.renderSoftTransparentShadowFold(commandList, this.m_context.targets, this.m_context.deferredLightingResources, this.m_context.opaqueFrameIndex);
            if(resolved)
                FinishGpuTimingMeasure(this.m_context.transparentResolveTiming, commandList);
            else{
                warning("RendererSystem: split transparent soft-shadow resolve failed; preserving opaque visibility");
                this.m_context.transparentTraceProduced = false;
                DiscardGpuTimingMeasure(this.m_context.transparentResolveTiming);
            }
        }else{
            DiscardGpuTimingMeasure(this.m_context.transparentResolveTiming);
            warning("RendererSystem: split transparent soft-shadow trace or first wavelet failed; preserving opaque visibility");
        }

        if(ShouldPublishDeferredOpaqueFallbackUpsample(this.m_combinedUpsample, this.m_context.transparentTraceProduced)){
            if(!this.m_raytracingSystem.renderSoftShadowTerminalUpsample(commandList, this.m_context.targets, this.m_context.deferredLightingResources, false))
                return false;
        }

        FinishGpuTimingMeasure(this.m_context.shadowVisibilityTiming, commandList);
        FinishGpuTimingMeasure(this.m_context.asyncTiming, commandList);
        return true;
    }

    public void discarded(){
        this.m_context.transparentTraceProduced = false;
        DiscardGpuTimingMeasure(this.m_context.asyncTiming);
        DiscardGpuTimingMeasure(this.m_context.shadowVisibilityTiming);
        DiscardGpuTimingMeasure(this.m_context.transparentResolveTiming);
        this.m_raytracingSystem.discardSoftShadowTemporalHistory();
    }
}

class ShadowVisibilityGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut GraphicsRuntime m_graphics;
    private mut DeferredFrameTargets m_targets;
    private DeferredLightingGraphResources m_deferredLightingResources;
    private mut GpuTimingSubmissionTicket m_timingTicket;
    private in b8 m_prepared;
    private GraphOwnedAdaptiveShadowPlan m_graphOwnedAdaptivePlan;
    private b8 m_hardwareShadowSupported;

    public ShadowVisibilityGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut GraphicsRuntime graphics,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources deferredLightingResources,
        mut GpuTimingSubmissionTicket timingTicket,
        in borrow b8 prepared,
        in GraphOwnedAdaptiveShadowPlan graphOwnedAdaptivePlan,
        in b8 hardwareShadowSupported
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_graphics = graphics;
        this.m_targets = targets;
        this.m_deferredLightingResources = deferredLightingResources;
        this.m_timingTicket = timingTicket;
        this.m_prepared = prepared;
        this.m_graphOwnedAdaptivePlan = graphOwnedAdaptivePlan;
        this.m_hardwareShadowSupported = hardwareShadowSupported;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute | GpuQueueCapability::Transfer); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_deferredLightingResources.valid())
            return false;

        Optional<in GraphOwnedAdaptiveShadowPlan> graphOwnedAdaptivePlan;
        if(this.m_graphOwnedAdaptivePlan.enabled)
            graphOwnedAdaptivePlan = Optional<in GraphOwnedAdaptiveShadowPlan>(this.m_graphOwnedAdaptivePlan);

        const Optional<GpuPhysicalQueueInfo> queue = context.compiledPlan.findQueueInfo(context.queue);
        if(!queue.has_value())
            return false;

        GpuTimingTicketRecordingScope timingRecording(this.m_timingTicket);
        Optional<GpuTimingMeasure> asyncTiming;
        if(queue.value().queueClass == CommandQueue::Compute)
            asyncTiming.emplace(this.m_graphics.gpuTiming(), s_TimingScopeAsyncShadow, this.m_graphics.getDevice(), commandList);

        b8 shadowVisibilityWritten = false;
        if(this.m_prepared && this.m_hardwareShadowSupported){
            shadowVisibilityWritten = this.m_raytracingSystem.renderShadowVisibility(commandList, this.m_targets, this.m_deferredLightingResources).has_value();
            if(!shadowVisibilityWritten)
                warning("RendererSystem: ray-traced shadow visibility pass failed");
        }
        else if(this.m_prepared){
            ShadowVisibilityRenderOptions renderOptions;
            renderOptions.graphOwnedAdaptivePlan = graphOwnedAdaptivePlan;
            shadowVisibilityWritten = this.m_raytracingSystem.renderGpuBvhShadowVisibility(commandList, this.m_targets, this.m_deferredLightingResources, renderOptions).has_value();
        }

        FinishGpuTimingMeasure(asyncTiming, commandList);
        return true;
    }

    public void discarded(){
        this.m_raytracingSystem.discardSoftShadowTemporalHistory();

    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


SoftShadowOpaqueResolvePhase ResolveSoftShadowOpaqueFirstWaveletPhase(in b8 deferWavelet){
    if(deferWavelet)
        return SoftShadowOpaqueResolvePhase::TemporalOnly;
    return SoftShadowOpaqueResolvePhase::TemporalAndWavelet;
}

b8 ShouldPublishDeferredOpaqueFallbackUpsample(in b8 combinedUpsample, in b8 transparentTraceProduced){
    return combinedUpsample && !transparentTraceProduced;
}

void RecoverOpaqueSoftShadowAllLit(
    mut RendererRayTracingSystem raytracingSystem,
    mut DeferredFrameTargets targets,
    mut b8 opaqueProduced,
    mut Optional<GpuTimingMeasure> asyncTiming,
    mut Optional<GpuTimingMeasure> shadowVisibilityTiming,
    mut Optional<GpuTimingMeasure> opaqueResolveTiming,
    mut CommandList commandList
){
    raytracingSystem.clearShadowVisibility(commandList, targets);
    commandList.setTextureState(targets.shadowVisibility.deref(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
    commandList.commitBarriers();
    opaqueProduced = false;
    DiscardGpuTimingMeasure(asyncTiming);
    DiscardGpuTimingMeasure(shadowVisibilityTiming);
    DiscardGpuTimingMeasure(opaqueResolveTiming);
}

Expected<GpuTaskId> RendererRayTracingSystem::declareShadowVisibilityTask(
    mut GpuTaskGraph graph,
    in GpuTaskDesc desc,
    in DeferredLightingGraphResources deferredLightingResources,
    in borrow b8 prepared,
    in b8 hardwareShadowSupported,
    in GraphOwnedAdaptiveShadowPlan graphOwnedAdaptivePlan,
    mut DeferredFrameTargets targets,
    mut GpuTimingSubmissionTicket timingTicket
){
    return graph.addPayloadTask(desc, ShadowVisibilityGraphTask(
        this,
        this.m_graphics,
        targets,
        deferredLightingResources,
        timingTicket,
        prepared,
        graphOwnedAdaptivePlan,
        hardwareShadowSupported
    ));
}

