#include <impl/ecs_render/csg/csg_graph_resource_snapshot.adhd>
#include <impl/ecs_render/csg/csg_system.adhd>
#include <impl/ecs_render/deferred/deferred_frame_targets.adhd>
#include <impl/ecs_render/kernel/graphics_prefix_timing_ticket.adhd>
#include <impl/ecs_render/material/material_system.adhd>
#include <impl/ecs_render/shared/task_graph_draw_snapshots.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[modular]
class GbufferGraphTask{
    public mut GraphicsRuntime graphics;
    public mut RendererMaterialSystem materialSystem;
    public mut RendererCsgSystem csgSystem;
    public mut DeferredFrameTargets targets;
    public in GraphicsPrefixTimingTicket timingTicket;
    public in b8 meshViewSetupReady;
    public in b8 sceneShadingSetupReady;
    public MeshFrameBindingSnapshot frameBindings;
    public CsgGraphResourceSnapshot csgResources;
    public OpaqueMaterialPassGraphSnapshot opaqueDrawSnapshot;
    public b8 materialDrawBuffersUploaded = false;
    public b8 csgFrameBuffersUploaded = false;
    public b8 materialFrameStatesGraphOwned = false;
    public b8 materialGeometryStatesGraphOwned = false;
    public b8 regularComputeEmulationOutputStatesGraphOwned = false;
    public b8 regularSharedComputeEmulationDrawsGraphOwned = false;
    public b8 csgReceiverComputeEmulationOutputStatesGraphOwned = false;
    public Optional<mut Optional<GpuTimingMeasure>> regularSharedComputeEmulationTiming;

    public GbufferGraphTask(
        mut GraphicsRuntime graphics, mut RendererMaterialSystem materials, mut RendererCsgSystem csg,
        mut DeferredFrameTargets targets, in GraphicsPrefixTimingTicket ticket, in b8 meshReady, in b8 shadingReady
    ){
        this.graphics = graphics;
        this.materialSystem = materials;
        this.csgSystem = csg;
        this.targets = targets;
        this.timingTicket = ticket;
        this.meshViewSetupReady = meshReady;
        this.sceneShadingSetupReady = shadingReady;
    }
    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements requirements;
        requirements.requiredCapabilities = GpuQueueCapability::Graphics | GpuQueueCapability::Compute;
        return requirements;
    }
    [cpp_unwind]
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const;
    public void discarded(){
        if(this.regularSharedComputeEmulationTiming.has_value())
            DiscardGpuTimingMeasure(this.regularSharedComputeEmulationTiming.value());
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

