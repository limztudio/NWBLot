void VerifyUiTextAreaNavigationTests_ResolverReadsReplacedTextInsteadOfStaleLayout(mut UiTextAreaNavigationTests self){
    ASSERT_TRUE(self.m_model.setText("MMMM\nMMMM"));
    ASSERT_TRUE(self.m_model.setSelection(2u, 2u));
    TextAreaNavigationResolver resolver = TextAreaNavigationResolver(self.m_arena, self.m_text, self.m_context, self.m_state, 14.0f);
    const EditNavigationSnapshot preferred = self.m_state.navigation().snapshot();
    const auto first = resolver.resolve(self.m_model, EditNavigationDirection::Down, preferred, 0.0f);
    ASSERT_TRUE(first.has_value());
    EXPECT_EQ(first.value().committedByte, 7u);
    ASSERT_TRUE(self.m_model.setText("M\nMMMM\nM"));
    ASSERT_TRUE(self.m_model.setSelection(0u, 0u));
    const auto second = resolver.resolve(self.m_model, EditNavigationDirection::Down, preferred, 0.0f);
    ASSERT_TRUE(second.has_value());
    EXPECT_EQ(second.value().committedByte, 2u);
    EXPECT_EQ(self.m_model.caret(), 0u);
}

void VerifyUiTextAreaNavigationTests_AdjacentNavigationReachesEmptyAndTrailingHardLines(mut UiTextAreaNavigationTests self){
    ASSERT_TRUE(self.m_model.setText("MM\n\nMM\n"));
    ASSERT_TRUE(self.m_model.setSelection(0u, 0u));
    const auto empty = self.resolve(EditNavigationDirection::Down);
    ASSERT_TRUE(empty.has_value());
    EXPECT_EQ(empty.value().committedByte, 3u);
    ASSERT_TRUE(self.m_model.setSelection(3u, 3u));
    const auto next = self.resolve(EditNavigationDirection::Down);
    ASSERT_TRUE(next.has_value());
    EXPECT_EQ(next.value().committedByte, 4u);
    ASSERT_TRUE(self.m_model.setSelection(7u, 7u));
    const auto previous = self.resolve(EditNavigationDirection::Up);
    ASSERT_TRUE(previous.has_value());
    EXPECT_EQ(previous.value().committedByte, 4u);
    EXPECT_FLOAT_EQ(previous.value().preferredX, 0.0f);
}

void VerifyUiTextAreaNavigationTests_VerticalTargetsRemainOnExtendedGraphemeBoundaries(mut UiTextAreaNavigationTests self){
    ASSERT_TRUE(self.m_model.setText("e\xcc\x81M\ne\xcc\x81M"));
