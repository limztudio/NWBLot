        static_assert(noexcept(::operator==(first, nullptr)));
        static_assert(noexcept(::operator>(first, second)));
        static_assert(noexcept(::operator<=(first, second)));
        static_assert(noexcept(::operator>=(first, second)));
        VerifyComparisonResultConversions<UniqueComparisonOwner>();
