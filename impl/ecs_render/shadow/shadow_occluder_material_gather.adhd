#include <impl/ecs_render/material/material_system.adhd>
#include <impl/ecs_render/optics/optical_scene.adhd>
#include <impl/ecs_render/shadow/prepared_shadow_material_context.adhd>
#include <impl/ecs_render/raytrace/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void EvaluateShadowOccluderMaterialCompleteness(
    in b8 hasMaterialInfo,
    in b8 transparent,
    in u32 surfaceDispatchId,
    mut b8 inOutContentComplete,
    mut b8 outMarkOpticalSceneIncomplete
){
    if(!hasMaterialInfo || surfaceDispatchId == u32.max)
        inOutContentComplete = false;
    outMarkOpticalSceneIncomplete = !hasMaterialInfo || (transparent && surfaceDispatchId == u32.max);
}

class ShadowOccluderMaterialGather{
    private mut RendererMaterialSystem m_materialSystem;
    private mut ShadowMaterialSampledTextureCollector m_sampledTextureCollector;
    private mut MaterialTypedByteDataVector m_shadowMaterialTypedBytes;
    private mut MaterialTypedConstantRangeMap m_shadowConstantTypedRanges;
    private mut MaterialTypedByteContentRangeMap m_shadowMutableTypedRanges;
    private mut RayTracingOpticalSceneGather m_opticalScene;
    private mut b8 m_contentComplete;

    public ShadowOccluderMaterialGather(mut RendererMaterialSystem materialSystem, mut ShadowMaterialSampledTextureCollector textures, mut MaterialTypedByteDataVector bytes, mut MaterialTypedConstantRangeMap constants,
        mut MaterialTypedByteContentRangeMap ranges, mut RayTracingOpticalSceneGather opticalScene, mut b8 contentComplete){
        this.m_materialSystem = materialSystem;
        this.m_sampledTextureCollector = textures;
        this.m_shadowMaterialTypedBytes = bytes;
        this.m_shadowConstantTypedRanges = constants;
        this.m_shadowMutableTypedRanges = ranges;
        this.m_opticalScene = opticalScene;
        this.m_contentComplete = contentComplete;
    }

    [cpp_unwind]
    public b8 resolve(in EntityID entity, in AssetRef<Material> material, in Optional<in TransformComponent> transform, in u32 meshInstanceIndex, mut NwbRtInstanceMaterialGpu outMaterial, mut InstanceGpuData outInstance,
        in Optional<mut b8> transparentOccluder){
        outMaterial = NwbRtInstanceMaterialGpu();
        outInstance = InstanceGpuData();
        const Expected<mut MaterialSurfaceInfo> result = this.m_materialSystem.findMaterialSurfaceInfo(material);
        b8 transparent = false;
        u32 dispatchId = u32.max;
        if(result.has_value()){
            mut MaterialSurfaceInfo info = result.value();
            transparent = info.transparent;
            dispatchId = info.surfaceDispatchId;
            if(transparent && transparentOccluder.has_value())
                transparentOccluder.value() = true;
            if(dispatchId != u32.max && !this.m_sampledTextureCollector.collect(info, this.m_materialSystem.materialState().m_resourceState))
                return false;
            const Expected<ShadowOccluderMaterialContext> context = this.m_materialSystem.appendShadowOccluderMaterialContext(entity, info, transform, this.m_shadowMaterialTypedBytes, this.m_shadowConstantTypedRanges, this.m_shadowMutableTypedRanges);
            if(!context.has_value())
                return false;
            outInstance = context.value().instance;
            outMaterial = ResolveInstanceShadowMaterialData(dispatchId, info.shadingModelId, transparent, info.refractive, context.value().constantByteOffset, meshInstanceIndex);
        }
        b8 incomplete = false;
        EvaluateShadowOccluderMaterialCompleteness(result.has_value(), transparent, dispatchId, this.m_contentComplete, incomplete);
        if(incomplete)
            this.m_opticalScene.markIncomplete();
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

