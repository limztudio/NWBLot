[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/global.adhd.h>

#include <core/assets/module.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] b8 MergeGatheredGraphicsAsset(const Name& virtualPath, Span<const u8> incomingPayload, Core::Alloc::ScratchArena& scratchArena, Core::Assets::AssetBytes& existingPayload);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateGatheredShaderRecordIdentity(in b8 hasExpectedPath, in Name expectedPath, in NameHash recordVirtualPathHash){
    if(hasExpectedPath && expectedPath.hash() == recordVirtualPathHash)
        return true;

    error("GraphicsGather: shader index record has an invalid runtime identity");
    return false;
}

b8 ValidateUniqueGatheredShaderRecordIndex(in b8 inserted){
    if(inserted)
        return true;

    error("GraphicsGather: duplicate shader index identity");
    return false;
}

Expected<usize> TryComputeMergedGraphicsShaderRecordCapacity(in usize existingCount, in usize incomingCount){
    if(incomingCount > usize.max - existingCount){
        error("GraphicsGather: merged shader index size overflows");
        return MakeUnexpected(Failure());
    }
    return existingCount + incomingCount;
}

b8 ValidateMatchingGatheredShaderRecord(
    in Name previousShaderName,
    in Name previousStage,
    in StringView previousVariantName,
    in u64 previousSourceChecksum,
    in u64 previousBytecodeChecksum,
    in Name incomingShaderName,
    in Name incomingStage,
    in StringView incomingVariantName,
    in u64 incomingSourceChecksum,
    in u64 incomingBytecodeChecksum
){
    if(
        previousShaderName == incomingShaderName
        && previousStage == incomingStage
        && previousVariantName == incomingVariantName
        && previousSourceChecksum == incomingSourceChecksum
        && previousBytecodeChecksum == incomingBytecodeChecksum
    )
        return true;

    error(
        "GraphicsGather: conflicting shader index record '{}' variant '{}' stage '{}'"
        , incomingShaderName.resolvedText()
        , incomingVariantName
        , incomingStage.resolvedText()
    );
    return false;
}

b8 ValidateGatheredShaderArchiveRecordIdentity(in Record record){
    const Expected<Name> expectedPath = BuildVirtualPathName(record.shaderName, record.variantName, record.stage);
    Name resolvedPath = s_NameNone;
    if(expectedPath.has_value())
        resolvedPath = expectedPath.value();
    return ValidateGatheredShaderRecordIdentity(expectedPath.has_value(), resolvedPath, record.virtualPathHash);
}

b8 MergeShaderArchiveIndexRecords(in Span<Record> incomingRecords, mut Vector<Record> inOutRecords){
    const Expected<usize> mergedCapacity = TryComputeMergedGraphicsShaderRecordCapacity(inOutRecords.size(), incomingRecords.size());
    if(!mergedCapacity.has_value())
        return false;

    HashMap<NameHash, usize> recordIndices;
    recordIndices.reserve(mergedCapacity.value());
    inOutRecords.reserve(mergedCapacity.value());
    for(usize i = 0u; i < inOutRecords.size(); ++i){
        if(!ValidateGatheredShaderArchiveRecordIdentity(inOutRecords[i]))
            return false;
        if(!ValidateUniqueGatheredShaderRecordIndex(recordIndices.try_emplace(inOutRecords[i].virtualPathHash, i).second))
            return false;
    }

    for(in Record record : incomingRecords){
        if(!ValidateGatheredShaderArchiveRecordIdentity(record))
            return false;
        if(!recordIndices.contains(record.virtualPathHash)){
            if(!recordIndices.try_emplace(record.virtualPathHash, inOutRecords.size()).second)
                return false;
            inOutRecords.push_back(record);
            continue;
        }

        const usize previousIndex = recordIndices.at(record.virtualPathHash);
        const Record previous = inOutRecords[previousIndex];
        if(!ValidateMatchingGatheredShaderRecord(
            previous.shaderName,
            previous.stage,
            previous.variantName,
            previous.sourceChecksum,
            previous.bytecodeChecksum,
            record.shaderName,
            record.stage,
            record.variantName,
            record.sourceChecksum,
            record.bytecodeChecksum
        ))
            return false;
    }

    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <core/alloc/scratch.h>
#include <core/assets/gather_merge_registry.h>
#include <core/graphics/shader_archive.h>
#include <core/common/log.h>

#include <global/binary.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_graphics_gather{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static b8 MergeGatheredGraphicsAssetImpl(const Name& virtualPath, const Span<const u8> incomingPayload, Core::Alloc::ScratchArena& scratchArena, Core::Assets::AssetBytes& existingPayload){
    (void)scratchArena;
    if(virtualPath != Core::ShaderArchive::s_IndexVirtualPathName)
        return false;
    if(!incomingPayload.empty() && incomingPayload.data() == nullptr)
        return false;

    Core::Assets::AssetArena& arena = existingPayload.get_allocator().arena();
    auto parsedRecords = Core::ShaderArchive::DeserializeIndex(arena, { existingPayload.data(), existingPayload.size() });
    if(!parsedRecords)
        return false;
    auto parsedIncomingRecords = Core::ShaderArchive::DeserializeIndex(arena, { incomingPayload.data(), incomingPayload.size() });
    if(!parsedIncomingRecords)
        return false;
    auto& records = *parsedRecords;
    if(!MergeShaderArchiveIndexRecords(*parsedIncomingRecords, records))
        return false;

    auto merged = Core::ShaderArchive::SerializeIndex(records, arena, scratchArena);
    if(!merged)
        return false;
    existingPayload = Move(*merged);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MergeGatheredGraphicsAsset(const Name& virtualPath, const Span<const u8> incomingPayload, Core::Alloc::ScratchArena& scratchArena, Core::Assets::AssetBytes& existingPayload){
    return __hidden_graphics_gather::MergeGatheredGraphicsAssetImpl(virtualPath, incomingPayload, scratchArena, existingPayload);
}

static Core::Assets::AssetGatherMergeAutoRegistrar s_GraphicsGatherMergeRegistrar(&MergeGatheredGraphicsAsset);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

