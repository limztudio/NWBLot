[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if defined(NWB_COOK)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <core/alloc/scratch.h>
#include <core/metascript/parser.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct TextureCookEntry{
    Name virtualPath = s_NameNone;
    u32 width = 0u;
    u32 height = 0u;
    u32 depth = 1u;
    TextureDimension::Enum dimension = TextureDimension::Texture2D;
    TexturePayloadFormat::Enum payloadFormat = TexturePayloadFormat::UastcLdr4x4;
    TextureAlphaMode::Enum alphaMode = TextureAlphaMode::Opaque;
    u8 alphaConstantUnorm8 = TextureFormat::s_OpaqueAlphaUnorm8;
    Core::Assets::AssetBytes payloadBytes;


public:
    explicit TextureCookEntry(Core::Assets::AssetArena& arena)noexcept
        : payloadBytes(arena)
    {}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] Expected<TextureCookEntry> ParseTextureCookMetadata(Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<TextureCookEntry> ParseTextureCookMetadata(const Path& assetRoot, AStringView virtualRoot, const Path& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);

template<typename FileArenaT>
    requires (!IsSame_V<FileArenaT, Core::Alloc::GlobalArena>)
[[nodiscard]] FOUNDATION_INLINE Expected<TextureCookEntry> ParseTextureCookMetadata(const Name virtualPath, const ::Path<FileArenaT>& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    return ParseTextureCookMetadata(virtualPath, Path(arena, nwbFilePath), asset, arena, scratchArena);
}

template<typename RootArenaT, typename FileArenaT>
    requires (!IsSame_V<RootArenaT, Core::Alloc::GlobalArena> || !IsSame_V<FileArenaT, Core::Alloc::GlobalArena>)
[[nodiscard]] FOUNDATION_INLINE Expected<TextureCookEntry> ParseTextureCookMetadata(const ::Path<RootArenaT>& assetRoot, const AStringView virtualRoot, const ::Path<FileArenaT>& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    return ParseTextureCookMetadata(Path(arena, assetRoot), virtualRoot, Path(arena, nwbFilePath), doc, arena, scratchArena);
}
[[nodiscard]] Expected<Texture> BuildTextureAsset(const TextureCookEntry& textureEntry, Core::Assets::AssetArena& arena);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TextureCookMetadataHeader{
    public Name virtualPath = s_NameNone;
    public u32 width = 0u;
    public u32 height = 0u;
    public u32 depth = 1u;
    public TexturePayloadDimension dimension = TexturePayloadDimension::Texture2D;
    public TexturePayloadFormat payloadFormat = TexturePayloadFormat::UastcLdr4x4;
    public TextureAlphaMode alphaMode = TextureAlphaMode::Opaque;
    public u8 alphaConstantUnorm8 = s_OpaqueAlphaUnorm8;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_TextureUnsupportedAlphaModeHint = "has unsupported alpha_mode";
const StringView s_TextureUnsupportedFormatHint = "has unsupported texture format";
const StringView s_TextureUnsupportedDimensionHint = "has unsupported texture dimension";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidTextureUnsignedFieldValue(in i64 rawValue, in u32 minimum, in u32 maximum){
    if(rawValue < 0)
        return false;
    const u64 unsignedValue = cast<u64>(rawValue);
    return unsignedValue >= cast<u64>(minimum) && unsignedValue <= cast<u64>(maximum);
}

usize ExpectedTextureResolutionComponentCount(in b8 isVolumeDimension){
    if(isVolumeDimension)
        return s_VolumeResolutionComponentCount;
    return s_PlanarResolutionComponentCount;
}

b8 IsPositiveTextureResolutionDimension(in i64 rawValue){
    return rawValue > 0 && cast<u64>(rawValue) <= cast<u64>(u32.max);
}

b8 IsValidCubeTextureResolution(in b8 isCubeDimension, in u32 width, in u32 height){
    return !isCubeDimension || width == height;
}

Expected<u32> ValidateTextureUnsignedField(
    in Path nwbFilePath,
    in StringView fieldName,
    in b8 present,
    in b8 isInteger,
    in i64 rawValue,
    in u32 minimum,
    in u32 maximum
){
    if(!present){
        error("{} '{}': field '{}' is required", s_TextureDiagnosticPrefix, nwbFilePath, fieldName);
        return MakeUnexpected(Failure());
    }
    if(!isInteger || !IsValidTextureUnsignedFieldValue(rawValue, minimum, maximum)){
        error("{} '{}': field '{}' must be an integer in [{}, {}]", s_TextureDiagnosticPrefix, nwbFilePath, fieldName, minimum, maximum);
        return MakeUnexpected(Failure());
    }
    return cast<u32>(rawValue);
}

b8 ValidateTextureResolutionListCount(in Path nwbFilePath, in b8 isList, in usize listSize, in usize expectedCount){
    if(isList && listSize == expectedCount)
        return true;

    error("{} '{}': resolution must contain exactly {} positive integer dimensions", s_TextureDiagnosticPrefix, nwbFilePath, expectedCount);
    return false;
}

Expected<u32> ValidateTextureResolutionComponent(in Path nwbFilePath, in usize component, in b8 isInteger, in i64 rawValue){
    if(isInteger && IsPositiveTextureResolutionDimension(rawValue))
        return cast<u32>(rawValue);

    error("{} '{}': resolution component {} must be a positive u32 integer", s_TextureDiagnosticPrefix, nwbFilePath, component);
    return MakeUnexpected(Failure());
}

b8 ValidateCubeTextureSquareResolution(in Path nwbFilePath, in b8 isCubeDimension, in u32 width, in u32 height){
    if(IsValidCubeTextureResolution(isCubeDimension, width, height))
        return true;

    error("{} '{}': cube resolution must be square", s_TextureDiagnosticPrefix, nwbFilePath);
    return false;
}

b8 ValidateTextureCompleteMipChain(in Path nwbFilePath, in b8 hasCompleteMipCount){
    if(hasCompleteMipCount)
        return true;

    error("{} '{}': resolution cannot describe a complete mip chain", s_TextureDiagnosticPrefix, nwbFilePath);
    return false;
}

Expected<u32> ReadTextureUnsignedField(in Path nwbFilePath, in MetascriptValue asset, in StringView fieldName, in u32 minimum, in u32 maximum){
    b8 present = false;
    b8 isInteger = false;
    i64 rawValue = 0;
    asset.visitField(fieldName, lambda[mut present, mut isInteger, mut rawValue](in MetascriptValue value) -> void{
        present = true;
        if(value.isInteger()){
            isInteger = true;
            rawValue = value.asInteger();
        }
    });
    return ValidateTextureUnsignedField(nwbFilePath, fieldName, present, isInteger, rawValue, minimum, maximum);
}

Expected<TextureAlphaMode> ParseTextureAlphaModeField(in Path nwbFilePath, in MetascriptValue asset){
    const Expected<MetadataStringField> field = ReadMetadataStringField(nwbFilePath, asset, s_TextureDiagnosticPrefix, s_TextureAlphaModeField, true);
    if(!field.has_value())
        return MakeUnexpected(Failure());

    in StringView text = field.value().text;
    if(text == s_OpaqueAlphaMode)
        return TextureAlphaMode::Opaque;
    if(text == s_EmbeddedLdrAlphaMode)
        return TextureAlphaMode::EmbeddedLdr;
    if(text == s_ConstantUnorm8AlphaMode)
        return TextureAlphaMode::ConstantUnorm8;
    if(text == s_SeparateUastcLdr4x4AlphaMode)
        return TextureAlphaMode::SeparateUastcLdr4x4;

    error("{} '{}': field '{}' {}", s_TextureDiagnosticPrefix, PathToString(nwbFilePath), s_TextureAlphaModeField, s_TextureUnsupportedAlphaModeHint);
    return MakeUnexpected(Failure());
}

Expected<TexturePayloadFormat> ParseTexturePayloadFormatField(in Path nwbFilePath, in MetascriptValue asset){
    const Expected<MetadataStringField> field = ReadMetadataStringField(nwbFilePath, asset, s_TextureDiagnosticPrefix, s_TextureFormatField, true);
    if(!field.has_value())
        return MakeUnexpected(Failure());

    in StringView text = field.value().text;
    if(text == s_UastcLdr4x4Format)
        return TexturePayloadFormat::UastcLdr4x4;
    if(text == s_UastcHdr4x4Format)
        return TexturePayloadFormat::UastcHdr4x4;

    error("{} '{}': field '{}' {}", s_TextureDiagnosticPrefix, PathToString(nwbFilePath), s_TextureFormatField, s_TextureUnsupportedFormatHint);
    return MakeUnexpected(Failure());
}

Expected<TexturePayloadDimension> ParseTextureDimensionField(in Path nwbFilePath, in MetascriptValue asset){
    const Expected<MetadataStringField> field = ReadMetadataStringField(nwbFilePath, asset, s_TextureDiagnosticPrefix, s_TextureDimensionField, true);
    if(!field.has_value())
        return MakeUnexpected(Failure());

    in StringView text = field.value().text;
    if(text == s_Texture2DDimension)
        return TexturePayloadDimension::Texture2D;
    if(text == s_TextureCubeDimension)
        return TexturePayloadDimension::TextureCube;
    if(text == s_Texture3DDimension)
        return TexturePayloadDimension::Texture3D;

    error("{} '{}': field '{}' {}", s_TextureDiagnosticPrefix, PathToString(nwbFilePath), s_TextureDimensionField, s_TextureUnsupportedDimensionHint);
    return MakeUnexpected(Failure());
}

Expected<TextureResolution> ReadTextureResolution(in Path nwbFilePath, in MetascriptValue asset, in TexturePayloadDimension dimension){
    b8 isList = false;
    usize listSize = 0u;
    Span<MetascriptValue> listValues = Span<MetascriptValue>();
    asset.visitField(s_TextureResolutionField, lambda[mut isList, mut listSize, mut listValues](in MetascriptValue value) -> void{
        if(value.isList()){
            isList = true;
            listValues = value.listView();
            listSize = listValues.size();
        }
    });
    const usize componentCount = ExpectedTextureResolutionComponentCount(dimension == TexturePayloadDimension::Texture3D);
    if(!ValidateTextureResolutionListCount(nwbFilePath, isList, listSize, componentCount))
        return MakeUnexpected(Failure());

    u32 width = 0u;
    u32 height = 0u;
    u32 depth = 1u;
    for(usize component = 0u; component < componentCount; ++component){
        in MetascriptValue value = listValues[component];
        const b8 isInteger = value.isInteger();
        i64 rawValue = 0;
        if(isInteger)
            rawValue = value.asInteger();
        const Expected<u32> parsed = ValidateTextureResolutionComponent(nwbFilePath, component, isInteger, rawValue);
        if(!parsed.has_value())
            return MakeUnexpected(Failure());
        if(component == 0u)
            width = parsed.value();
        else if(component == 1u)
            height = parsed.value();
        else
            depth = parsed.value();
    }
    if(!ValidateCubeTextureSquareResolution(nwbFilePath, dimension == TexturePayloadDimension::TextureCube, width, height))
        return MakeUnexpected(Failure());

    TextureResolution resolution;
    resolution.width = width;
    resolution.height = height;
    resolution.depth = depth;
    return resolution;
}

Expected<TextureCookMetadataHeader> ParseTextureCookMetadataHeader(in Name virtualPath, in Path nwbFilePath, in MetascriptValue asset){
    if(!CheckMetadataAssetMap(nwbFilePath, asset, s_TextureDiagnosticPrefix))
        return MakeUnexpected(Failure());

    const Expected<TextureAlphaMode> alphaMode = ParseTextureAlphaModeField(nwbFilePath, asset);
    if(!alphaMode.has_value())
        return MakeUnexpected(Failure());

    const b8 allowAlphaConstant = alphaMode.value() == TextureAlphaMode::ConstantUnorm8;
    if(!ValidateMetadataAssetFields(nwbFilePath, asset, s_TextureDiagnosticPrefix, lambda[in allowAlphaConstant](in StringView fieldName) -> b8{
        return IsAllowedTextureMetadataField(fieldName, allowAlphaConstant);
    }))
        return MakeUnexpected(Failure());

    const Expected<TexturePayloadFormat> format = ParseTexturePayloadFormatField(nwbFilePath, asset);
    const Expected<TexturePayloadDimension> dimension = ParseTextureDimensionField(nwbFilePath, asset);
    if(!format.has_value() || !dimension.has_value())
        return MakeUnexpected(Failure());

    const Expected<TextureResolution> resolution = ReadTextureResolution(nwbFilePath, asset, dimension.value());
    if(!resolution.has_value())
        return MakeUnexpected(Failure());

    const Expected<u32> completeMipCount = ComputeCompleteMipCount(dimension.value(), resolution.value().width, resolution.value().height, resolution.value().depth);
    if(!ValidateTextureCompleteMipChain(nwbFilePath, completeMipCount.has_value()))
        return MakeUnexpected(Failure());

    TextureCookMetadataHeader header;
    if(!AssignCookEntryVirtualPath(virtualPath, nwbFilePath, s_TextureDiagnosticPrefix, header))
        return MakeUnexpected(Failure());
    header.width = resolution.value().width;
    header.height = resolution.value().height;
    header.depth = resolution.value().depth;
    header.dimension = dimension.value();
    header.payloadFormat = format.value();
    header.alphaMode = alphaMode.value();
    if(header.alphaMode == TextureAlphaMode::ConstantUnorm8){
        const Expected<u32> constant = ReadTextureUnsignedField(nwbFilePath, asset, s_TextureAlphaConstantField, 0u, s_MaxConstantAlphaUnorm8);
        if(!constant.has_value())
            return MakeUnexpected(Failure());
        header.alphaConstantUnorm8 = cast<u8>(constant.value());
    }
    return header;
}

void LogTextureSidecarReadFailed(in Path nwbFilePath, in Path dataPath, in ErrorCode errorCode){
    const String errorMessage = StringFormat("{}", errorCode.message());
    error("{} '{}': failed to read raw texture sidecar '{}': {}", s_TextureDiagnosticPrefix, PathToString(nwbFilePath), PathToString(dataPath), errorMessage);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if defined(NWB_COOK)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_texture/texture_binary_codec.adhd.h>

#include <core/assets/cook_metadata.h>

#include <global/filesystem.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static Core::Assets::AssetPairedSidecarRuleAutoRegistrar s_TexturePairedSidecarRegistrar(Core::Assets::AssetPairedSidecarRule{
    .sidecarExtension = TextureFormat::s_TextureDataExtension,
});


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<TextureCookEntry> ParseTextureCookMetadata(const Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    const Expected<TextureCookMetadataHeader> header = ParseTextureCookMetadataHeader(virtualPath, nwbFilePath, asset);
    if(!header)
        return MakeUnexpected(Failure{});

    TextureCookEntry entry(arena);
    entry.virtualPath = header->virtualPath;
    entry.width = header->width;
    entry.height = header->height;
    entry.depth = header->depth;
    entry.dimension = header->dimension;
    entry.payloadFormat = header->payloadFormat;
    entry.alphaMode = header->alphaMode;
    entry.alphaConstantUnorm8 = header->alphaConstantUnorm8;

    ::Path<Core::Alloc::ScratchArena> dataPath(scratchArena, nwbFilePath);
    dataPath.replaceExtension(TextureFormat::s_TextureDataExtension);
    const Expected<void, ErrorCode> readResult = ReadBinaryFile(dataPath, entry.payloadBytes);
    if(!readResult){
        LogTextureSidecarReadFailed(nwbFilePath, dataPath, readResult.error());
        return MakeUnexpected(Failure{});
    }
    return entry;
}

Expected<TextureCookEntry> ParseTextureCookMetadata(const Path& assetRoot, const AStringView virtualRoot, const Path& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    return Core::Assets::ParseCookMetadataDocument<TextureCookEntry, &ParseTextureCookMetadata>(assetRoot, virtualRoot, nwbFilePath, doc, s_TextureDiagnosticPrefix, arena, scratchArena);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 TextureAssetCodec::serialize(const Core::Assets::IAsset& asset, Core::Assets::AssetBytes& outBinary)const{
    if(!checkSerializeAssetType(asset, FOUNDATION_TEXT("TextureAssetCodec::serialize")))
        return false;

    const Texture& texture = static_cast<const Texture&>(asset);
    if(!texture.validatePayload())
        return false;

    return TextureBinaryCodec().serialize(
        static_cast<u8>(texture.dimension()),
        texture.width(),
        texture.height(),
        texture.depth(),
        static_cast<u8>(texture.alphaMode()),
        texture.alphaConstantUnorm8(),
        static_cast<u8>(texture.payloadFormat()),
        texture.mipLevels(),
        texture.payloadBytes(),
        outBinary
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<Texture> BuildTextureAsset(const TextureCookEntry& textureEntry, Core::Assets::AssetArena& arena){
    Texture::MipLevelVector mipLevels(arena);
    if(!BuildTextureCookMipLevels(
        static_cast<u8>(textureEntry.payloadFormat),
        static_cast<u8>(textureEntry.dimension),
        textureEntry.width,
        textureEntry.height,
        textureEntry.depth,
        static_cast<u8>(textureEntry.alphaMode),
        textureEntry.payloadBytes.size(),
        mipLevels
    ))
        return MakeUnexpected(Failure{});

    Texture asset(arena, textureEntry.virtualPath);
    asset.setPayload(
        textureEntry.width,
        textureEntry.height,
        mipLevels,
        textureEntry.payloadBytes,
        textureEntry.dimension,
        textureEntry.depth,
        textureEntry.payloadFormat,
        textureEntry.alphaMode,
        textureEntry.alphaConstantUnorm8
    );
    if(!asset.validatePayload())
        return MakeUnexpected(Failure{});
    return asset;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

