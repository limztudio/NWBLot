        return this.index != s_NullIndex && this.generation != 0u && this.worldIndex != 0u;
    }

    public b8 operator==(in JointId rhs)const{
        return this.index == rhs.index && this.generation == rhs.generation && this.worldIndex == rhs.worldIndex;
    }
}

