namespace __hidden_ui_combo_behavior_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB;
using namespace NWB::Impl::Ui;

namespace CallbackStage{
    enum Enum : u8{ None, Generation, Revision, Count, Lookup, Key, Enabled };
};

namespace CallbackMutation{
    enum Enum : u8{ Select, Open, Close, Generation, Revision, Count };
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ComboSource final : public IListDataSource{
public:
    ComboSource()noexcept = default;

    explicit ComboSource(ComboState& state)noexcept
        : m_state(&state)
    {}


public:
    [[nodiscard]] virtual u64 instanceGeneration()const noexcept override{
        mutate(CallbackStage::Generation);
        return generation;
    }

    [[nodiscard]] virtual u64 revision()const noexcept override{
        mutate(CallbackStage::Revision);
        return revisionValue;
    }

    [[nodiscard]] virtual u64 rowCount()const noexcept override{
        mutate(CallbackStage::Count);
        return count;
    }

    [[nodiscard]] virtual u64 key(const u64 index)const noexcept override{
        mutate(CallbackStage::Key);
        return index < count ? UiWidgetTests::ArithmeticFixtureRowKey(count, 0u, reversed, index) : 0u;
    }

    [[nodiscard]] virtual Expected<u64> indexOf(const u64 keyValue)const noexcept override{
        mutate(CallbackStage::Lookup);
        const auto index = UiWidgetTests::FindArithmeticFixtureRowIndex(count, 0u, reversed, keyValue);
        if(!index)
            return index;
        return badLookup ? count : wrongLookup ? 0u : *index;
    }

    [[nodiscard]] virtual Expected<u64> findEnabled(const u64 start, const b8 reverse)const noexcept override{
        return UiWidgetTests::FindSingleDisabledFixtureRow(count, 0u, false, start, reverse, disabledKey);
    }

    [[nodiscard]] virtual StringView text(u64)const noexcept override{ return "row"; }

    [[nodiscard]] virtual b8 enabled(const u64 index)const noexcept override{
        mutate(CallbackStage::Enabled);
        const u64 keyValue = reversed ? count - index : index + 1u;
        return index < count && keyValue != disabledKey;
    }

    void arm(const CallbackStage::Enum stage, const CallbackMutation::Enum mutation, const u64 selected = 8u)noexcept{
        m_stage = stage;
        m_mutation = mutation;
        m_selected = selected;
    }


private:
    void mutate(const CallbackStage::Enum stage)const noexcept{
        if(m_stage != stage)
            return;
        m_stage = CallbackStage::None;
        switch(m_mutation){
        case CallbackMutation::Select:
            if(m_state)
                m_state->select(m_selected);
            break;
        case CallbackMutation::Open:
            if(m_state)
                m_state->open();
            break;
        case CallbackMutation::Close:
            if(m_state)
                m_state->close();
            break;
        case CallbackMutation::Generation:
            ++generation;
            break;
        case CallbackMutation::Revision:
            ++revisionValue;
            break;
        case CallbackMutation::Count:
            if(count != 0u)
                --count;
            break;
        }
    }


public:
    mutable u64 generation = 51u;
    mutable u64 revisionValue = 1u;
    mutable u64 count = 10u;
    u64 disabledKey = 0u;
    b8 reversed = false;
    b8 badLookup = false;
    b8 wrongLookup = false;


private:
    ComboState* m_state = nullptr;
    u64 m_selected = 8u;
    mutable CallbackStage::Enum m_stage = CallbackStage::None;
    CallbackMutation::Enum m_mutation = CallbackMutation::Select;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] FOUNDATION_INLINE b8 Navigate(const ComboSource& source, const ControlActionKind::Enum kind, ComboState& state)noexcept{
    ListState& preview = ComboBehavior::Preview(state);
    if(!ListBehavior::Reconcile(preview, source))
        return false;
    ListOptions options;
    options.selectOnNavigate = false;
    ControlAction action;
    action.kind = kind;
    action.control = { preview.inputGeneration(), source.instanceGeneration(), source.revision() };
    ListResult result;
    return ListBehavior::Apply(source, options, action, preview, result);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


