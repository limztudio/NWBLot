[[nodiscard]] inline FrameGraphNodeHandle MakeNodeHandle(const u32 index)noexcept{
    return FrameGraphNodeHandle{ index };
}

[[nodiscard]] inline Expected<Name> MakeDecimalScopeName(const u32 index){
    Array<char, 32u> scopeText = {};
    const auto parsed = Name::FromText(FormatDecimal(index, scopeText));
    if(!parsed.has_value())
        return MakeUnexpected(Failure{});
    return parsed.value();
}


