////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize ResolveShadowTraceGeometryReserveCount(in usize baseCapacity, in b8 traceGeometryStatesGraphOwned, in usize traceGeometryCount){
    if(traceGeometryStatesGraphOwned)
        return baseCapacity;
    return baseCapacity + traceGeometryCount;
}

u32 EncodeShadowHistoryValidFlag(in b8 historyReadable){
    if(historyReadable)
        return 1u;
    return 0u;
}

b8 CanUseSoftwareTransparentSamplingHistory(
    in SoftwareTransparentShadowTraceInputs inputs,
    in b8 softTransparentTemporalReady,
    in b8 samplingHistoryUsable
){
    return inputs.temporalHistoryReadable && softTransparentTemporalReady && samplingHistoryUsable;
}

usize SelectSoftwareTransparentSamplingPipelineIndex(in b8 samplingHistoryUsable){
    if(samplingHistoryUsable)
        return 1u;
    return 0u;
}


