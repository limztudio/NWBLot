#include <impl/ecs_render/caustic/caustic_resolve_state.adhd.h>
#include <impl/ecs_render/raytrace/task_graph_scene_resources.adhd.h>
#include <impl/ecs_render/optics/optical_scene_resources.adhd.h>
#include <impl/ecs_render/shadow/shadow_trace_geometry.adhd.h>
#include <impl/ecs_render/raytrace/prepared_builds.adhd.h>
