[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/global.adhd.h>
#include <impl/ecs_mesh/skinning/submission_state.adhd.h>

#include <core/alloc/scratch.h>
#include <core/task/gpu/persistent_state.h>
#include <core/task/gpu/scheduler.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SkinningStateHandoff final : NoCopy{
public:
    SkinningStateHandoff(Core::GpuPersistentResourceStateCache& cache, Core::Alloc::ScratchArena& scratchArena, const Span<const Core::BufferHandle> buffers)
        : m_cache(cache)
        , m_scratchArena(scratchArena)
        , m_candidate(cache)
        , m_buffers(buffers)
    {}


public:
    [[nodiscard]] static b8 Prepare(void* const rawContext, const Core::CommandListResourceStateHandoff* const finalState){
        SkinningStateHandoff* const context = static_cast<SkinningStateHandoff*>(rawContext);
        if(!context)
            return false;
        context->m_preparationInvoked = true;
        if(!CanPrepareSkinningStateHandoff(finalState != nullptr, context->m_buffers.empty(), context->m_buffers.data() != nullptr))
            return false;
        context->m_statePrepared = context->m_cache.buildMergedBufferSubset(*finalState, Span<const Core::BufferHandle>(context->m_buffers), context->m_scratchArena, context->m_candidate);
        return context->m_statePrepared;
    }
    [[nodiscard]] static b8 Accept(void* const rawContext, [[maybe_unused]] const Core::QueueSubmissionToken& token)noexcept{
        SkinningStateHandoff* const context = static_cast<SkinningStateHandoff*>(rawContext);
        if(!context || !context->m_statePrepared)
            return false;
        context->m_stateAccepted = context->m_cache.commit(context->m_candidate);
        return context->m_stateAccepted;
    }
    [[nodiscard]] b8 preparationInvoked()const noexcept{ return m_preparationInvoked; }
    [[nodiscard]] b8 statePrepared()const noexcept{ return m_statePrepared; }
    [[nodiscard]] b8 stateAccepted()const noexcept{ return m_stateAccepted; }


private:
    Core::GpuPersistentResourceStateCache& m_cache;
    Core::Alloc::ScratchArena& m_scratchArena;
    Core::GpuPersistentResourceStateCache::Candidate m_candidate;
    Span<const Core::BufferHandle> m_buffers;
    b8 m_preparationInvoked = false;
    b8 m_statePrepared = false;
    b8 m_stateAccepted = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

