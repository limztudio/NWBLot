const StringView s_FractureDiagnosticPrefix = "Fracture meta";
const StringView s_SoftBodyDiagnosticPrefix = "SoftBody meta";
const StringView s_RagdollDiagnosticPrefix = "Ragdoll meta";
const StringView s_ArticulationDiagnosticPrefix = "Articulation meta";
const StringView s_VehicleDiagnosticPrefix = "Vehicle meta";


