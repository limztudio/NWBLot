const u32 s_UiRadioScrollQuietNaNF32Bits = 0x7fc00000u;
const u32 s_UiRadioScrollPosInfF32Bits = 0x7f800000u;
const u32 s_UiRadioScrollNegInfF32Bits = 0xff800000u;
const u64 s_UiRadioScrollQuietNaNF64Bits = 0x7ff8000000000000u;
const u64 s_UiRadioScrollPosInfF64Bits = 0x7ff0000000000000u;
const u64 s_UiRadioScrollNegZeroF64Bits = 0x8000000000000000u;

Insets MakeUiRadioScrollInsets(in f32 left, in f32 top, in f32 right, in f32 bottom){
    Insets insets = Insets();
    insets.left = left;
    insets.top = top;
    insets.right = right;
    insets.bottom = bottom;
    return insets;
}

RadioGroupChoices MakeUiRadioGroupLayoutChoices(in u32 count){
    RadioGroupChoices choices = RadioGroupChoices();
    choices.sourceGeneration = 41u;
    choices.sourceRevision = 7u;
    choices.count = count;
    for(u32 index = 0u; index < count && index < s_RadioGroupMaxChoices; ++index){
        RadioGroupChoice row = RadioGroupChoice();
        row.key = cast<u64>(index + 1u);
        row.enabled = (index % 2u) == 0u;
        choices.rows[index] = row;
    }
    return choices;
}

void ExpectUiRadioGroupPopupSourceClosure(mut UiRadioGroupPopupTests self, in UiRadioCallbackSiteEnum site){
    ASSERT_TRUE(self.acceptParent(1u));
    ASSERT_EQ(self.m_context.input().focus(), self.parentHost());
    InputEvent held = InputEvent();
    held.type = InputEventType::KeyDown;
    held.key = UiRadioKey::Right;
    ASSERT_TRUE(self.send(held).commandConsumed);
    const RadioGroupSnapshot before = self.m_state.snapshot();
    self.m_source.resetCounters();
    self.m_source.armClose(self.m_parent, site);
    ASSERT_TRUE(self.beginParent(2u));
    EXPECT_FALSE(self.m_parent.isOpen());
    EXPECT_TRUE(self.m_result.valid);
    EXPECT_FALSE(self.m_result.selectionChanged);
    EXPECT_FALSE(self.m_result.activated);
    EXPECT_TRUE(self.m_state.matches(before));
    EXPECT_EQ(self.m_state.selectedKey(), 10u);
    EXPECT_EQ(self.m_source.m_mutations, 1u);
    EXPECT_EQ(self.m_source.m_callbacksAfterMutation, 0u);
    EXPECT_EQ(self.m_source.m_textCalls, 0u);
    ASSERT_TRUE(self.finishParent());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().popupCount(), 0u);
    native(in self){
        EXPECT_EQ(self.target(self.parentHost()), nullptr);
    }
    self.m_parent.open();
    ASSERT_TRUE(self.acceptParent(3u));
    held.repeat = true;
    ASSERT_TRUE(self.send(held).commandConsumed);
    ASSERT_TRUE(self.acceptParent(4u));
    EXPECT_EQ(self.m_state.selectedKey(), 10u);
    EXPECT_FALSE(self.m_result.selectionChanged);
    EXPECT_FALSE(self.m_result.activated);
    held.type = InputEventType::KeyUp;
    ASSERT_TRUE(self.send(held).commandConsumed);
}

void ExpectUiScrollLayoutRejected(in Rect bounds, in Rect clip, in Insets padding, in f32 width, in f32 minimum, in f32 height, in f64 offset){
    EXPECT_FALSE(CalculateScrollPlacement(bounds, clip, padding, width, minimum, 20u, height, offset).has_value());
}

void ExpectUiScrollbarBar(in ScrollbarPlacement actual, in ScrollbarPlacement expected){
    ExpectUiRect(actual.track, expected.track);
    ExpectUiRect(actual.thumb, expected.thumb);
    EXPECT_DOUBLE_EQ(actual.contentExtent, expected.contentExtent);
    EXPECT_DOUBLE_EQ(actual.viewportExtent, expected.viewportExtent);
    EXPECT_DOUBLE_EQ(actual.maximum, expected.maximum);
    EXPECT_DOUBLE_EQ(actual.offset, expected.offset);
    EXPECT_EQ(actual.visible, expected.visible);
}

void ExpectUiScrollbarPlacement(in ScrollViewportPlacement actual, in ScrollViewportPlacement expected){
    ExpectUiRect(actual.viewport, expected.viewport);
    ExpectUiRect(actual.contentClip, expected.contentClip);
    ExpectUiRect(actual.corner, expected.corner);
    ExpectUiScrollbarBar(actual.horizontal, expected.horizontal);
    ExpectUiScrollbarBar(actual.vertical, expected.vertical);
}

void ExpectUiScrollbarReservedGeometry(in ScrollViewportPlacement actual, in ScrollViewportPlacement expected){
    ExpectUiRect(actual.viewport, expected.viewport);
    ExpectUiRect(actual.contentClip, expected.contentClip);
    ExpectUiRect(actual.corner, expected.corner);
    ExpectUiRect(actual.horizontal.track, expected.horizontal.track);
    ExpectUiRect(actual.vertical.track, expected.vertical.track);
    EXPECT_FLOAT_EQ(actual.horizontal.thumb.width, expected.horizontal.thumb.width);
    EXPECT_FLOAT_EQ(actual.horizontal.thumb.height, expected.horizontal.thumb.height);
    EXPECT_FLOAT_EQ(actual.vertical.thumb.width, expected.vertical.thumb.width);
    EXPECT_FLOAT_EQ(actual.vertical.thumb.height, expected.vertical.thumb.height);
    EXPECT_DOUBLE_EQ(actual.horizontal.contentExtent, expected.horizontal.contentExtent);
    EXPECT_DOUBLE_EQ(actual.vertical.contentExtent, expected.vertical.contentExtent);
    EXPECT_DOUBLE_EQ(actual.horizontal.viewportExtent, expected.horizontal.viewportExtent);
    EXPECT_DOUBLE_EQ(actual.vertical.viewportExtent, expected.vertical.viewportExtent);
    EXPECT_DOUBLE_EQ(actual.horizontal.maximum, expected.horizontal.maximum);
    EXPECT_DOUBLE_EQ(actual.vertical.maximum, expected.vertical.maximum);
    EXPECT_EQ(actual.horizontal.visible, expected.horizontal.visible);
    EXPECT_EQ(actual.vertical.visible, expected.vertical.visible);
}

void ExpectUiScrollbarViewportRejected(in Rect valueBounds, in Rect clip, in Insets valuePadding, in Point measure, in f32 caret, in Point scroll, in f32 thickness, in f32 minimum){
    EXPECT_FALSE(CalculateScrollViewportPlacement(valueBounds, clip, valuePadding, measure, caret, scroll, thickness, minimum).has_value());
}

void ExpectUiScrollbarOffsetUpdateRejected(mut ScrollViewportPlacement placement){
    const ScrollViewportPlacement expected = placement;
    EXPECT_FALSE(TryUpdateScrollViewportOffsets(Point(40.0f, 50.0f), placement));
    ExpectUiScrollbarPlacement(placement, expected);
}


