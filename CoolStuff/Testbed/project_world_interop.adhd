b8 CreateStartupCameraAndLightsOnWorld(mut World world){
    Entity activeCameraEntity = world.createEntity();
    mut ActiveCameraComponent activeCamera = activeCameraEntity.addComponent<ActiveCameraComponent>();
    const f32x4 cameraPosition(0.0f, s_CharacterCameraTargetY, s_CameraStartDepth, 0.0f);
    activeCamera.camera = CreateSceneCameraEntity(world, cameraPosition);
    assert(activeCamera.camera.valid());
    Entity cameraEntity = world.entity(activeCamera.camera);
    mut TransformComponent cameraTransform = cameraEntity.getComponent<TransformComponent>();
    cameraTransform.rotation = f32x4(QuaternionRotationRollPitchYawFromVector(VectorSingle(0.0f, s_PI, 0.0f, 0.0f)));
    const EntityID directionalLight = CreateDirectionalLightEntity(
        world,
        s_DefaultDirectionalLightPitch,
        s_DefaultDirectionalLightYaw,
        s_DefaultDirectionalLightRoll,
        s_DefaultDirectionalLightColor,
        s_DefaultDirectionalLightIntensity
    );
    const EntityID pointLight = CreatePointLightEntity(
        world,
        s_PointLightPosition,
        s_PointLightColor,
        s_PointLightIntensity,
        s_PointLightRange
    );
    return directionalLight.valid() && pointLight.valid();
}

void ApplyFlyCameraTransform(
    mut TransformComponent transform,
    in VectorSingle moveAxes,
    in b8 boosted,
    in VectorSingle mouseDelta,
    in f32 deltaSeconds
){
    const FlyCameraMotion motion = FlyCameraMotion();
    const f32x4 rotationValue = transform.rotation;
    const f32x4 positionValue = transform.position;
    const VectorSingle currentRotation = VectorSingle(rotationValue);
    const VectorSingle currentPosition = VectorSingle(positionValue);
    const VectorSingle resolvedRotation = motion.resolveStepRotation(currentRotation, mouseDelta);
    const VectorSingle resolvedPosition = motion.resolvePosition(currentPosition, moveAxes, resolvedRotation, deltaSeconds, boosted);
    transform.rotation = f32x4(resolvedRotation);
    transform.position = f32x4(resolvedPosition);
}

void ApplyFlyCameraInputToWorld(
    mut World world,
    in VectorSingle moveAxes,
    in b8 boosted,
    in VectorSingle mouseDelta,
    in f32 deltaSeconds
){
    const SceneCameraView cameraView = ResolveSceneCameraView(world);
    assert(cameraView.valid());
    Entity cameraEntity = world.entity(cameraView.entity);
    ApplyFlyCameraTransform(cameraEntity.getComponent<TransformComponent>(), moveAxes, boosted, mouseDelta, deltaSeconds);
}

void LogProjectWorldTickRejected(in u32 errorCode){
    error("Project: world update rejected CPU work: {}", errorCode);
}


