class AvboitGeometryPhaseIdentities{
    public Name geometryIdentity = s_NameNone;
    public StringView geometryLabel = "";
    public Name sampledIdentity = s_NameNone;
    public StringView sampledLabel = "";
}

const Name s_AvboitExtinctionGeometryIdentity = "render.avboit.extinction.material_geometry";
const StringView s_AvboitExtinctionGeometryLabel = "AVBOIT Extinction Material Geometry";
const Name s_AvboitExtinctionSampledIdentity = "render.avboit.extinction.material_sampled_textures";
const StringView s_AvboitExtinctionSampledLabel = "AVBOIT Extinction Material Sampled Textures";
const Name s_AvboitAccumulationGeometryIdentity = "render.avboit.accumulation.material_geometry";
const StringView s_AvboitAccumulationGeometryLabel = "AVBOIT Accumulation Material Geometry";
const Name s_AvboitAccumulationSampledIdentity = "render.avboit.accumulation.material_sampled_textures";
const StringView s_AvboitAccumulationSampledLabel = "AVBOIT Accumulation Material Sampled Textures";
const Name s_AvboitOccupancyGeometryIdentity = "render.avboit.occupancy.material_geometry";
const StringView s_AvboitOccupancyGeometryLabel = "AVBOIT Occupancy Material Geometry";
const Name s_AvboitOccupancySampledIdentity = "render.avboit.occupancy.material_sampled_textures";
const StringView s_AvboitOccupancySampledLabel = "AVBOIT Occupancy Material Sampled Textures";

AvboitGeometryPhaseIdentities ResolveAvboitGeometryPhaseIdentities(in AvboitGeometryPhase phase){
    AvboitGeometryPhaseIdentities identities;
    switch(phase){
    case AvboitGeometryPhase::Extinction:
        identities.geometryIdentity = s_AvboitExtinctionGeometryIdentity;
        identities.geometryLabel = s_AvboitExtinctionGeometryLabel;
        identities.sampledIdentity = s_AvboitExtinctionSampledIdentity;
        identities.sampledLabel = s_AvboitExtinctionSampledLabel;
        return identities;
    case AvboitGeometryPhase::Accumulation:
        identities.geometryIdentity = s_AvboitAccumulationGeometryIdentity;
        identities.geometryLabel = s_AvboitAccumulationGeometryLabel;
        identities.sampledIdentity = s_AvboitAccumulationSampledIdentity;
        identities.sampledLabel = s_AvboitAccumulationSampledLabel;
        return identities;
    case AvboitGeometryPhase::Occupancy:
    default:
        identities.geometryIdentity = s_AvboitOccupancyGeometryIdentity;
        identities.geometryLabel = s_AvboitOccupancyGeometryLabel;
        identities.sampledIdentity = s_AvboitOccupancySampledIdentity;
        identities.sampledLabel = s_AvboitOccupancySampledLabel;
        return identities;
    }
}

