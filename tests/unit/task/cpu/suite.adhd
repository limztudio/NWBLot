void VerifyCpuTaskSchedulerTests_LargeDistinctFanInWaitsForEveryDependency(){
    VerifyFanIn(4096u, 1u);
}

void VerifyCpuTaskSchedulerTests_LargeRepeatedFanInPublishesExactlyOneJoin(){
    VerifyFanIn(1024u, 4u);
}

void VerifyCpuTaskSchedulerTests_NestedLargeFanInAcceptsIndependentPredecessorsAndDuplicateEdges(){
    usize fanIn = 1024u;
    const usize chainLength = 1024u;
    u32 predecessors = 0u;
    u32 continuations = 0u;
    u32 childInvocations = 0u;
    DeadlineGuard deadline(false, s_TestTimeoutMS);
    Vector<CpuTaskHandle> prerequisites = Vector<CpuTaskHandle>();
    prerequisites.resize(fanIn + 2u, CpuTaskHandle());
    const CpuTaskOptions defaultOptions = CpuTaskOptions();
    CpuTaskScheduler scheduler(0u);
    const auto cpuTaskAdmission = scheduler.submit(lambda[mut scheduler, mut predecessors, mut childInvocations, in fanIn, in defaultOptions, mut prerequisites]() -> void{
        const auto secondCpuTaskAdmission = scheduler.submit(lambda[mut predecessors, mut childInvocations, in fanIn]() -> void{
            EXPECT_EQ(predecessors, cast<u32>(fanIn));
            ++childInvocations;
        }, defaultOptions, prerequisites.data(), prerequisites.size());
        ASSERT_TRUE(secondCpuTaskAdmission.has_value());
        ASSERT_TRUE(secondCpuTaskAdmission.value().valid());
    });
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    const CpuTaskHandle root = cpuTaskAdmission.value();
    ASSERT_TRUE(root.valid());
    CpuTaskHandle tail = root;
    for(usize index = 0u; index < chainLength; ++index){
        const auto thirdCpuTaskAdmission = scheduler.submit(lambda[mut childInvocations, mut continuations]() -> void{
            EXPECT_EQ(childInvocations, 1u);
            ++continuations;
        }, tail);
        ASSERT_TRUE(thirdCpuTaskAdmission.has_value());
        tail = thirdCpuTaskAdmission.value();
        ASSERT_TRUE(tail.valid());
    }
    for(usize index = 0u; index < fanIn; ++index){
        const auto prerequisiteTaskAdmission = scheduler.submit(lambda[mut predecessors]() -> void{
            ++predecessors;
        });
        ASSERT_TRUE(prerequisiteTaskAdmission.has_value());
        prerequisites[index] = prerequisiteTaskAdmission.value();
        ASSERT_TRUE(prerequisites[index].valid());
    }
    prerequisites[fanIn] = prerequisites[0u];
    scheduler.wait();
    EXPECT_EQ(predecessors, cast<u32>(fanIn));
    EXPECT_EQ(continuations, cast<u32>(chainLength));
    EXPECT_EQ(childInvocations, 1u);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}

void VerifyCpuTaskSchedulerTests_NestedLargeFanInRejectsACycleAtTheEndOfTheDependencyList(){
    const usize fanIn = 1024u;
    u32 invocations = 0u;
    b8 rejected = false;
    DeadlineGuard deadline(false, s_TestTimeoutMS);
    Vector<CpuTaskHandle> prerequisites = Vector<CpuTaskHandle>();
    prerequisites.resize(fanIn + 1u, CpuTaskHandle());
    const CpuTaskOptions defaultOptions = CpuTaskOptions();
    CpuTaskScheduler scheduler(0u);
    const auto cpuTaskAdmission = scheduler.submit(lambda[mut scheduler, mut invocations, mut rejected, in defaultOptions, mut prerequisites]() -> void{
        const auto secondCpuTaskAdmission = scheduler.submit(lambda[mut invocations]() -> void{
            ++invocations;
        }, defaultOptions, prerequisites.data(), prerequisites.size());
        rejected = !secondCpuTaskAdmission.has_value() || !secondCpuTaskAdmission.value().valid();
        ++invocations;
    });
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    CpuTaskHandle tail = cpuTaskAdmission.value();
    ASSERT_TRUE(tail.valid());
    for(usize index = 0u; index < fanIn; ++index){
        const auto tailTaskAdmission = scheduler.submit(lambda[mut invocations]() -> void{
            ++invocations;
        }, tail);
        ASSERT_TRUE(tailTaskAdmission.has_value());
        tail = tailTaskAdmission.value();
        ASSERT_TRUE(tail.valid());
    }
    prerequisites[fanIn] = tail;
    for(usize index = 0u; index < fanIn; ++index){
        const auto prerequisiteTaskAdmission = scheduler.submit(lambda[mut invocations]() -> void{
            ++invocations;
        });
        ASSERT_TRUE(prerequisiteTaskAdmission.has_value());
        prerequisites[index] = prerequisiteTaskAdmission.value();
        ASSERT_TRUE(prerequisites[index].valid());
    }
    scheduler.wait();
    EXPECT_TRUE(rejected);
    EXPECT_EQ(invocations, cast<u32>(fanIn * 2u + 1u));
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}

void VerifyCpuTaskSchedulerTests_NestedDependencyAcceptsARetiredGenerationInTheAncestorsSlot(){
    b8 accepted = false;
    b8 invoked = false;
    DeadlineGuard deadline(false, s_TestTimeoutMS);
    CpuTaskScheduler scheduler(0u);
    const auto completedTaskAdmission = scheduler.submit(lambda[]() -> void{});
    ASSERT_TRUE(completedTaskAdmission.has_value());
    const CpuTaskHandle completed = completedTaskAdmission.value();
    ASSERT_TRUE(completed.valid());
    scheduler.wait(completed);
    const auto cpuTaskAdmission = scheduler.submit(lambda[mut scheduler, mut accepted, mut invoked, in completed]() -> void{
        const auto secondCpuTaskAdmission = scheduler.submit(lambda[mut invoked]() -> void{
            invoked = true;
        }, completed);
        accepted = secondCpuTaskAdmission.has_value() && secondCpuTaskAdmission.value().valid();
    });
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    const CpuTaskHandle parent = cpuTaskAdmission.value();
    ASSERT_TRUE(parent.valid());
    scheduler.wait();
    EXPECT_EQ(parent.index, completed.index);
    EXPECT_NE(parent.generation, completed.generation);
    EXPECT_TRUE(accepted);
    EXPECT_TRUE(invoked);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}


