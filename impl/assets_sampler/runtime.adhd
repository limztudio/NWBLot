////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_sampler/asset.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsSamplerFilterFlagEnabled(in u32 filterFlag){
    return filterFlag != 0u;
}

b8 Sampler::validatePayload()const{
    if(!this.checkVirtualPath(s_SamplerValidatePayloadContext))
        return false;
    return ValidateSamplerDescriptionPayload(
        this.virtualPath(),
        this.m_description.borderColor.r,
        this.m_description.borderColor.g,
        this.m_description.borderColor.b,
        this.m_description.borderColor.a,
        this.m_description.maxAnisotropy,
        this.m_description.mipBias,
        cast<u32>(this.m_description.addressU),
        cast<u32>(this.m_description.addressV),
        cast<u32>(this.m_description.addressW),
        cast<u32>(this.m_description.reductionType)
    );
}

b8 Sampler::loadBinary(in Span<u8> binary){
    const Expected<SamplerBinaryHeader> headerResult = DeserializeSamplerBinaryHeader(binary);
    if(!headerResult.has_value())
        return false;
    if(!this.checkVirtualPath(s_SamplerValidatePayloadContext))
        return false;

    in SamplerBinaryHeader header = headerResult.value();
    this.m_description.borderColor = Color(header.borderColorR, header.borderColorG, header.borderColorB, header.borderColorA);
    this.m_description.maxAnisotropy = header.maxAnisotropy;
    this.m_description.mipBias = header.mipBias;
    this.m_description.minFilter = IsSamplerFilterFlagEnabled(header.minFilter);
    this.m_description.magFilter = IsSamplerFilterFlagEnabled(header.magFilter);
    this.m_description.mipFilter = IsSamplerFilterFlagEnabled(header.mipFilter);
    this.m_description.addressU = cast<SamplerAddressMode>(header.addressU);
    this.m_description.addressV = cast<SamplerAddressMode>(header.addressV);
    this.m_description.addressW = cast<SamplerAddressMode>(header.addressW);
    this.m_description.reductionType = cast<SamplerReductionType>(header.reductionType);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
