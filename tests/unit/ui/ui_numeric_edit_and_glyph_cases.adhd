    ASSERT_TRUE(self.acceptNumeric());
    EXPECT_EQ(StringView(self.m_host.displayed.data(), self.m_host.displayed.size()), "99");
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyUiNumericFormatTests_IntegerCanonicalTextRoundtripsExtremaWithoutFloatingPointConversion(){
    Array<i64, 4u> values = Array<i64, 4u>();
    values[0u] = 9007199254740993ll;
    values[1u] = -9007199254740993ll;
    values[2u] = i64.min;
    values[3u] = i64.max;
    for(in i64 value : values){
        const ScopedTestTrace trace = ScopedTestTrace(value);
        const UiNumericFormatBuffer formatted = FormatUiNumericI64(value);
        ASSERT_TRUE(formatted.hasValue());
        const StringView text = formatted.text();
        const auto parsed = ParseIntegerDraft(text);
        ASSERT_TRUE(parsed.has_value());
        EXPECT_EQ(parsed.value(), value);
        if(value == 9007199254740993ll)
            EXPECT_EQ(text, "9007199254740993");
        if(value == i64.min)
            EXPECT_EQ(text, "-9223372036854775808");
    }
}

void VerifyUiNumericFormatTests_ExtremeSubnormalSignedZeroAndAdjacentUlpValuesRoundtripWithExactBits(){
    Array<u64, 10u> patterns = Array<u64, 10u>();
    patterns[0u] = 0x8000000000000000ull;
    patterns[1u] = 0x0000000000000001ull;
    patterns[2u] = 0x8000000000000001ull;
    patterns[3u] = 0x000fffffffffffffull;
    patterns[4u] = 0x0010000000000000ull;
    patterns[5u] = 0x3fefffffffffffffull;
    patterns[6u] = 0x3ff0000000000001ull;
    patterns[7u] = 0x4340000000000001ull;
    patterns[8u] = 0x7fefffffffffffffull;
    patterns[9u] = 0xffefffffffffffffull;
    for(in u64 bits : patterns){
        const ScopedTestTrace trace = ScopedTestTrace(bits);
        const UiNumericFormatBuffer formatted = FormatUiNumericF64(bit_cast<f64>(bits));
        ASSERT_TRUE(formatted.hasValue());
        const StringView text = formatted.text();
        const auto parsed = ParseFloatDraft(text);
        ASSERT_TRUE(parsed.has_value());
        EXPECT_EQ(bit_cast<u64>(parsed.value()), bits);
    }
}

void VerifyUiNumericFormatTests_InsufficientCallerStorageReportsSizeErrorWithoutWritingOutsideTheBuffer(){
    UiNumericFormatGuardedOneByteBuffer integer = UiNumericFormatGuardedOneByteBuffer();
    const auto integerText = integer.formatInteger(i64.min);
    ASSERT_FALSE(integerText.has_value());
    EXPECT_EQ(integerText.error(), MakeUiNumericValueTooLargeError());
    EXPECT_TRUE(integer.firstIntact());
    EXPECT_TRUE(integer.lastIntact());

    UiNumericFormatGuardedOneByteBuffer floating = UiNumericFormatGuardedOneByteBuffer();
    const auto floatingText = floating.formatFloat(123.25);
    ASSERT_FALSE(floatingText.has_value());
    EXPECT_EQ(floatingText.error(), MakeUiNumericValueTooLargeError());
    EXPECT_TRUE(floating.firstIntact());
    EXPECT_TRUE(floating.lastIntact());
}

void VerifyUiNumericFormatTests_NonfiniteFloatFormattingIsRejected(){
    Array<f64, 3u> values = Array<f64, 3u>();
    values[0u] = UiNumericInfinityF64();
    values[1u] = -UiNumericInfinityF64();
    values[2u] = UiNumericQuietNaNF64();
    for(in f64 value : values){
        const UiNumericFormatBuffer formatted = FormatUiNumericF64(value);
        ASSERT_FALSE(formatted.hasValue());
        EXPECT_EQ(formatted.error(), MakeUiNumericInvalidArgumentError());
    }
}


