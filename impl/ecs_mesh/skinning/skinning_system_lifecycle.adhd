#include <impl/ecs_mesh/runtime/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 AreMeshSkinningRuntimePipelinesReady(
    in b8 skinningReady,
    in b8 boundsReady,
    in b8 hasAttributeBuffer,
    in b8 repackReady
){
    if(!skinningReady || !boundsReady)
        return false;
    if(hasAttributeBuffer && !repackReady)
        return false;
    return true;
}

b8 CanRetainPreparedRuntimeResources(in b8 hasValidInstance, in u32 instanceEditRevision, in u32 resourceEditRevision){
    return hasValidInstance && instanceEditRevision == resourceEditRevision;
}

void MarkRebuiltRuntimeMeshDirtyFlags(mut RuntimeMeshDirtyFlag inOutDirtyFlags){
    inOutDirtyFlags |= RuntimeMeshDirtyFlag::SkinningInputDirty | RuntimeMeshDirtyFlag::MeshletBoundsDirty;
}

void LogSkinningDescriptorHeapRequired(in StringView requirementLabel){
    error("MeshSkinningSystem: {} compute requires the initialized global descriptor heap", requirementLabel);
}

void LogSkinningBindingLayoutCreateFailed(in StringView layoutLabel){
    error("MeshSkinningSystem: failed to create {} binding layout", layoutLabel);
}

void LogSkinningComputePipelineCreateFailed(in StringView pipelineLabel){
    error("MeshSkinningSystem: failed to create {} compute pipeline", pipelineLabel);
}


