b8 ValidDeferredOutputLayerTextureShape(
    in b8 isSampledImageClass,
    in u32 width,
    in u32 height,
    in u32 expectedWidth,
    in u32 expectedHeight,
    in b8 isTexture2D,
    in b8 isRgba16Float,
    in u32 sampleCount,
    in u32 mipLevels,
    in u32 arraySize,
    in b8 coversEntireTexture
){
    return
        isSampledImageClass
        && width == expectedWidth
        && height == expectedHeight
        && isTexture2D
        && isRgba16Float
        && sampleCount == 1u
        && mipLevels == 1u
        && arraySize == 1u
        && coversEntireTexture
    ;
}

b8 ValidDeferredOutputLayer(in GpuTaskGraph graph, in GpuTaskGraphOutputLayer output, in AcquiredPresentationFrame frame){
    const GpuTaskGraphDeclarationReadView declarations(graph);
    if(!declarations.valid() || !output.validShape() || (output.readyTask.valid() && !declarations.validTask(output.readyTask)))
        return false;
    if(!output.color.valid())
        return true;
    if(!declarations.validResource(output.color) || !declarations.validResourceVersion(output.colorVersion))
        return false;
    const GpuTaskGraphResourceVersionView version = declarations.resourceVersionAt(output.colorVersion.index);
    if(version.resource != output.color || version.origin != GpuGraphResourceVersionOrigin::TaskProduced)
        return false;
    in TextureDesc backBuffer = frame.backBuffer.texture.deref().getDescription();
    in GpuTaskGraphOutputLayer outputRef = output;
    in GpuTaskGraphResourceVersionView versionRef = version;
    return VisitGpuTaskTexture(declarations, output.color, lambda[in backBuffer, in outputRef, in versionRef](mut RhiTexture texture) -> b8{
        in TextureDesc desc = texture.getDescription();
        return ValidDeferredOutputLayerTextureShape(outputRef.sampledImage.descriptorClass() == GpuDescriptorClass::SampledImage,
            desc.width, desc.height, backBuffer.width, backBuffer.height, desc.dimension == TextureDimension::Texture2D, desc.format == Format::RGBA16_FLOAT,
            desc.sampleCount, desc.mipLevels, desc.arraySize, versionRef.range.textureSubresources.isEntireTexture(desc));
    });
}

Expected<DeferredGraphSuffixResult> DeferredGraphSuffixBuilder::declare(
    mut DeferredGraphSuffixInputs inputs,
    in borrow GpuTaskId shadowVisibilityTask,
    mut GpuTimingSubmissionTicket compositeTimingTicket,
    mut GpuTimingSubmissionTicket presentTimingTicket,
    mut Optional<GpuTimingMeasure> asyncFinalTiming,
    mut GpuTimingFrameTransaction frameTimingTransaction
){
    DeferredGraphSuffixResult result;
    if(
        !inputs.opaqueColor.valid()
        || !inputs.avboitAccumColor.valid()
        || !inputs.avboitAccumExtinction.valid()
        || !inputs.refractionResolve.valid()
        || !inputs.refractionDepth.valid()
        || !inputs.currentBindlessSlots.valid()
        || !inputs.lightingTask.valid()
        || !inputs.avboitFinalTask.valid()
        || !inputs.refractionResolveTask.valid()
        || !inputs.reflectionGraph.valid()
        || !inputs.presentationFrame.valid()
    )
        return MakeUnexpected(Failure());

    GpuTaskGraphOutputLayer outputLayer;
    if(this.m_outputLayerContributor.has_value()){
        const auto declared = this.m_outputLayerContributor.value().declareTaskGraphOutputLayer(this.m_graph);
        if(!declared.has_value()){
            warning("RendererSystem: output layer did not declare its graph work");
            return MakeUnexpected(Failure());
        }
        outputLayer = declared.value();
    }
    if(!ValidDeferredOutputLayer(this.m_graph, outputLayer, inputs.presentationFrame))
        return MakeUnexpected(Failure());

    GpuGraphResourceDesc colorDesc = TextureResourceDesc(s_RenderNameRenderDeferredCompositeCompositeColor, "Composite Color");
    colorDesc.setInitialState(ResourceStates::Unknown);
    const auto compositeColorResult = this.m_graph.importTexture(inputs.targets.compositeColor, colorDesc);
    const GpuGraphResourceId compositeBindlessSlots = inputs.currentBindlessSlots;
    if(!compositeColorResult.has_value() || !compositeBindlessSlots.valid()){
        warning("RendererSystem: could not import deferred-composite graph resources");
        return MakeUnexpected(Failure());
    }
    const GpuGraphResourceId compositeColor = compositeColorResult.value();

    const Array<GpuTaskResourceUse, 11u> compositeResourceUses(
        ReadUse(inputs.opaqueColor),
        ReadUse(inputs.reflectionGraph.opaqueRadiance),
        ReadUse(inputs.reflectionGraph.glassRadiance),
        ReadUse(inputs.avboitAccumColor),
        ReadUse(inputs.avboitAccumExtinction),
        ReadUse(inputs.avboitForegroundColor),
        ReadUse(inputs.avboitForegroundExtinction),
        ReadUse(inputs.refractionResolve),
        ReadUse(inputs.refractionDepth),
        ReadUse(compositeBindlessSlots, ResourceStates::ConstantBuffer),
        WriteUse(compositeColor, ResourceStates::UnorderedAccess)
    );
    GpuTaskSchedulingHint compositeScheduling;
    compositeScheduling.cost = GpuTaskCostHint::Medium;
    compositeScheduling.avoidQueueCrossing = inputs.useLaggedLightingHistory;
    compositeScheduling.forceSubmissionBoundary = false;
    compositeScheduling.allowPacketMerge = true;
    compositeScheduling.mergeWithPrevious = true;
    const Array<GpuTaskId, 4u> compositeDependencies(inputs.lightingTask, inputs.avboitFinalTask, inputs.refractionResolveTask, inputs.reflectionGraph.completion);
    GpuTaskDesc compositeDesc;
    compositeDesc
        .setIdentity(Name(s_RenderNameRenderDeferredComposite))
        .setMarkerLabel(s_DeferredCompositeLabel)
        .setScheduling(compositeScheduling)
        .setDependencies(compositeDependencies)
        .setResourceUses(compositeResourceUses)
    ;
    const auto compositeTaskResult = this.m_deferredSystem.declareDeferredCompositeTask(this.m_graph, compositeDesc, inputs.reflectionCompositeInputs, inputs.targets, compositeTimingTicket);
    if(!compositeTaskResult.has_value()){
        result.compositeTask = GpuTaskId();
        warning("RendererSystem: could not declare deferred-composite graph task");
        return MakeUnexpected(Failure());
    }
    result.compositeTask = compositeTaskResult.value();

    in AcquiredPresentationFrame presentationFrame = inputs.presentationFrame;
    in FramebufferDesc presentationFramebufferDesc = inputs.presentationFramebufferDesc;
    GpuExternalCompletionDesc availability;
    availability.identity = s_RenderNameRenderDeferredPresentBackbufferAvailability;
    availability.markerLabel = "Presentation Back Buffer Availability";
    availability.token = presentationFrame.backBuffer.availabilityCompletion;
    const auto backBufferAvailabilityResult = this.m_graph.importExternalCompletion(availability);
    if(!backBufferAvailabilityResult.has_value()){
        warning("RendererSystem: could not import presentation back-buffer availability");
        return MakeUnexpected(Failure());
    }
    const GpuExternalCompletionId backBufferAvailability = backBufferAvailabilityResult.value();

    GpuGraphResourceDesc backBufferDesc = TextureResourceDesc(Name(s_RenderNameRenderDeferredPresentBackbuffer), "Presentation Back Buffer");
    backBufferDesc.setInitialState(presentationFrame.backBuffer.nativeInitialState).setInitialAvailabilityCompletion(backBufferAvailability).setExternalFinalState(ResourceStates::Present);
    const auto backbufferResult = this.m_graph.importTexture(presentationFrame.backBuffer.texture, backBufferDesc);
    if(!backbufferResult.has_value()){
        warning("RendererSystem: could not import deferred-present graph resources");
        return MakeUnexpected(Failure());
    }
    const GpuGraphResourceId backbuffer = backbufferResult.value();

    FixedVector<GpuTaskResourceUse, s_PresentMaxResourceUseCount> presentResourceUses;
    presentResourceUses.push_back(ReadUse(compositeColor));
    presentResourceUses.push_back(ReadUse(compositeBindlessSlots, ResourceStates::ConstantBuffer));
    presentResourceUses.push_back(WriteTextureUse(backbuffer, presentationFramebufferDesc.colorAttachments[0u].subresources, ResourceStates::RenderTarget));
    FixedVector<GpuTaskResourceVersionUse, 1u> outputVersions;
    if(outputLayer.color.valid()){
        presentResourceUses.push_back(ReadUse(outputLayer.color));
        GpuTaskResourceVersionUse version;
        version.version = outputLayer.colorVersion;
        version.role = GpuTaskResourceVersionRole::Consume;
        outputVersions.push_back(version);
    }
    GpuTaskSchedulingHint presentScheduling;
    presentScheduling.cost = GpuTaskCostHint::Medium;
    presentScheduling.avoidQueueCrossing = inputs.useLaggedLightingHistory;
    presentScheduling.forceSubmissionBoundary = true;
    presentScheduling.allowPacketMerge = false;
    FixedVector<GpuTaskId, s_PresentMaxDependencyCount> presentDependencies;
    presentDependencies.push_back(result.compositeTask);
    if(inputs.useLaggedLightingHistory){
        presentDependencies.push_back(inputs.surfelGiTask);
        if(inputs.hardwareCausticsTask.valid())
            presentDependencies.push_back(inputs.hardwareCausticsTask);
    }
    if(outputLayer.readyTask.valid())
        presentDependencies.push_back(outputLayer.readyTask);
    GpuTaskDesc presentDesc;
    presentDesc.setIdentity(s_RenderNameRenderDeferredPresent).setMarkerLabel(s_DeferredPresentLabel).setScheduling(presentScheduling)
        .setDependencies(presentDependencies).setResourceUses(presentResourceUses).setResourceVersionUses(outputVersions);
    const auto presentTaskResult = this.m_graph.addPayloadTask(presentDesc, DeferredPresentGraphTask(this.m_deferredSystem, this.m_graphics, inputs.targets,
        presentationFrame, backbuffer, outputLayer, this.m_outputLayerContributor, asyncFinalTiming, presentTimingTicket, shadowVisibilityTask));
    if(!presentTaskResult.has_value()){
        result.presentTask = GpuTaskId();
        warning("RendererSystem: could not declare deferred-present graph task");
        return MakeUnexpected(Failure());
    }
    result.presentTask = presentTaskResult.value();

    result.overlayRequired = this.m_presentationContributor.has_value() && this.m_presentationContributor.value().hasTaskGraphPresentationWork();
    if(result.overlayRequired){
        const auto overlayTaskResult = this.m_presentationContributor.value().declareTaskGraphPresentation(this.m_graph, presentationFrame, backbuffer, result.presentTask);
        if(!overlayTaskResult.has_value()){
            result.overlayTask = GpuTaskId();
            warning("RendererSystem: presentation contributor did not declare its final graph task");
            return MakeUnexpected(Failure());
        }
        result.overlayTask = overlayTaskResult.value();
    }

    GpuTaskId frameTimingEndDependency = result.presentTask;
    if(result.overlayTask.valid())
        frameTimingEndDependency = result.overlayTask;
    GpuTaskSchedulingHint frameTimingEndScheduling;
    frameTimingEndScheduling.cost = GpuTaskCostHint::Tiny;
    frameTimingEndScheduling.forceSubmissionBoundary = true;
    frameTimingEndScheduling.allowPacketMerge = false;
    GpuTaskDesc frameTimingEndDesc;
    frameTimingEndDesc.setIdentity(Name(s_RenderNameRenderFrameTimingEnd)).setMarkerLabel("Frame Timing End").setScheduling(frameTimingEndScheduling).setDependency(frameTimingEndDependency);
    const auto frameTimingEndTaskResult = this.m_graph.addPayloadTask(frameTimingEndDesc, FrameTimingEndGraphTask(frameTimingTransaction));
    if(!frameTimingEndTaskResult.has_value()){
        result.frameTimingEndTask = GpuTaskId();
        warning("RendererSystem: could not declare deferred frame-timing endpoint graph task");
        return MakeUnexpected(Failure());
    }
    result.frameTimingEndTask = frameTimingEndTaskResult.value();
    GpuPresentEndpoint endpoint;
    endpoint.producer = result.frameTimingEndTask;
    endpoint.backBuffer = backbuffer;
    if(!this.m_graph.declarePresentEndpoint(endpoint)){
        warning("RendererSystem: could not declare deferred graph presentation endpoint");
        return MakeUnexpected(Failure());
    }

    return result;
}


