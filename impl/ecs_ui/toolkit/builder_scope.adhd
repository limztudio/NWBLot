class BuilderItem{
    public WidgetState state;
    public SharedTextLayout text;
    public Rect textBounds;
    public Insets padding;
    public f32 checkboxExtent = 0.0f;
    public u32 styleIndex = 0u;
    public u32 selectableStyleIndex = 0u;
    public u32 node = 0u;
    public u32 editBox = s_LayoutNoParent;
    public u32 list = s_LayoutNoParent;
    public u32 radioGroup = s_LayoutNoParent;
    public u32 slider = s_LayoutNoParent;
    public u32 progress = s_LayoutNoParent;
    public u32 image = s_LayoutNoParent;
    public u32 combo = s_LayoutNoParent;
    public u32 textArea = s_LayoutNoParent;
    public u32 integerEdit = s_LayoutNoParent;
    public u32 floatEdit = s_LayoutNoParent;
    public b8 enabled = true;
    public b8 checked = false;
    public b8 contextMenu = false;
    public b8 annotated = false;
}

class BuilderEditBoxFrame{
    public EditBoxStyle editStyle;
    public ScrollbarStyle scrollbarStyle;
    public Optional<mut EditBoxState> editState;
    public EditBoxOptions editOptions;
    public EditBoxPaintFlags editFlags;
    public u32 editViewCache = u32.max;
}

[move_only]
class CachedEditBoxView{
    public EditBoxView view;
    public TextAreaModelStamp modelStamp;
    public String language;
    public u64 textIdentity = 0u;
    public u64 textGeneration = 0u;
    public u64 atlasIdentity = 0u;
    public usize atlasGlyphCount = 0u;
    public u32 fontSizeBits = 0u;
    public u32 scriptTag = 0u;
    public u32 pixelScaleXBits = 0u;
    public u32 pixelScaleYBits = 0u;
    public b8 valid = false;

    public b8 matchesShape(in TextAreaModelStamp stamp, in u64 textId, in u64 textGen, in u32 sizeBits, in u32 script, in StringView lang)const{
        return this.valid
            && this.modelStamp == stamp
            && this.textIdentity == textId
            && this.textGeneration == textGen
            && this.fontSizeBits == sizeBits
            && this.scriptTag == script
            && StringView(this.language) == lang;
    }

    public b8 matchesMeasure(in u32 scaleXBits, in u32 scaleYBits, in u64 atlasId, in usize atlasGlyphs)const{
        return this.pixelScaleXBits == scaleXBits
            && this.pixelScaleYBits == scaleYBits
            && this.atlasIdentity == atlasId
            && this.atlasGlyphCount == atlasGlyphs;
    }
}

class BuilderWindowFrame{
    public Optional<mut WindowState> state;
    public WidgetStyle style;
    public WindowOptions options;
    public WindowMetrics metrics;
    public b8 firstUse = false;
    public WidgetState titleState;
    public WidgetState collapseState;
    public WidgetState resizeState;
    public SharedTextLayout title;
    public Rect titleBounds;
}

class BuilderTextAreaFrame{
    public f32 wheelLines = s_StyleScrollWheelStep;
    public Optional<in EditModel> model;
    public Optional<mut TextAreaState> state;
    public EditNavigationSnapshot navigation;
    public TextAreaModelStamp modelStamp;
    public u64 stateRevision = 0u;
    public u32 item = s_LayoutNoParent;
    public b8 focused = false;
}

class BuilderNumericEditFrame<Model>{
    public Optional<mut EditBoxState> state;
    public TextAreaModelStamp draftStamp;
    public u64 revision = 0u;
    public u32 item = s_LayoutNoParent;
    public b8 focused = false;
    public Optional<in Model> model;
}

type BuilderIntegerEditFrame = BuilderNumericEditFrame<IntegerEditModel>;
type BuilderFloatEditFrame = BuilderNumericEditFrame<FloatEditModel>;

class BuilderListRow{
    public SharedTextLayout text;
    public Rect textBounds;
    public u64 index = 0u;
    public u64 key = 0u;
    public b8 enabled = false;
}

class BuilderListFrame{
    public Vector<BuilderListRow> rows;
    public Optional<in IListDataSource> source;
    public Optional<mut ListState> state;
    public WidgetStyle widgetStyle;
    public ListStyle style;
    public ListOptions options;
    public ListMeasureKey measureKey;
    public f64 scrollOffset = 0.0;
    public u64 cursorKey = 0u;
    public f32 rowHeight = 0.0f;
    public b8 revealCursor = false;
    public b8 focusOnCommit = false;
    public ControlToken token;
    public Insets padding;
    public u64 rowCount = 0u;
    public WidgetId commandFocus;
}

class BuilderComboFrame{
    public Optional<in IListDataSource> source;
    public Optional<in IListDataSource> results;
    public Optional<mut ISearchableListDataSource> searchSource;
    public Optional<mut SearchComboState> search;
    public Optional<mut ComboState> state;
    public ComboStyle style;
    public PopupStyle popupStyle;
    public ComboOptions options;
    public WidgetState popup;
    public WidgetState rows;
    public PopupToken popupToken;
    public PopupToken parentToken;
    public ControlToken token;
    public ControlToken listToken;
    public Rect visibleField;
    public TextAreaModelStamp queryStamp;
    public u64 rowCount = 0u;
    public u64 resultCount = 0u;
    public u32 editor = s_LayoutNoParent;
    public u32 list = s_LayoutNoParent;
    public f32 arrowExtent = 0.0f;
    public f32 queryHeight = 0.0f;
    public f32 queryGap = 0.0f;
    public b8 open = false;
    public b8 focusOnCommit = false;
    public b8 listFocusOnCommit = false;
    public b8 editorSubmitted = false;
    public b8 queryChanged = false;
}

[move_only]
class BuilderTooltipFrame{
    public WidgetState widget;
    public WidgetState anchor;
    public Optional<mut TooltipState> state;
    public TooltipStyle style;
    public TooltipOptions options;
    public SharedTextLayout text;
    public u64 revision = 0u;
    public u32 anchorIndex = 0u;
    public u32 layer = 1u;
}

class BuilderContextMenuFrame{
    public WidgetState widget;
    public WidgetState anchor;
    public WidgetState popup;
    public WidgetState rows;
    public Optional<in IListDataSource> source;
    public Optional<mut ContextMenuState> state;
    public PopupStyle popupStyle;
    public ContextMenuOptions options;
    public PopupToken popupToken;
    public PopupToken parentToken;
    public ControlToken listToken;
    public u64 rowCount = 0u;
    public u64 revision = 0u;
    public u32 anchorIndex = 0u;
    public u32 list = s_LayoutNoParent;
    public b8 open = false;
}


