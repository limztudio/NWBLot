#include <impl/ecs_ui/toolkit/text/layout.adhd>
#include <impl/ecs_ui/toolkit/widgets/radio_group.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[move_only, friend(Builder)]
class RadioGroupLabel{
    private SharedTextLayout m_text;
    private Rect m_bounds;

    public RadioGroupLabel(in SharedTextLayout layout, in Rect bounds){
        this.m_text = layout;
        this.m_bounds = bounds;
    }
}

[move_only, friend(Builder)]
class RadioGroupFrame : NoCopy{
    private in IListDataSource m_source;
    private mut RadioGroupState m_state;
    private Vector<RadioGroupLabel> m_labels;
    private RadioGroupChoices m_choices;
    private RadioGroupSnapshot m_snapshot;
    private RadioGroupOptions m_options;
    private b8 m_focusOnCommit = false;
    private RadioGroupStyle m_style;
    private RadioGroupMetrics m_metrics;
    private WidgetStyle m_widgetStyle;
    private ControlToken m_token;

    public RadioGroupFrame(in IListDataSource source, mut RadioGroupState state){
        this.m_source = source;
        this.m_state = state;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

