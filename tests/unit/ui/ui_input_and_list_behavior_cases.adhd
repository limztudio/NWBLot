void VerifyUiListBehaviorTests_EmptySourceClearsKeysAndNavigationAndSubmitAreValidNoOps(){
    RangeSource source = RangeSource();
    source.count = 0u;
    ListState state = ListState();
    state.select(5u);
    ASSERT_TRUE(ReconcileListState(state, source));
    EXPECT_EQ(state.selectedKey(), 0u);
    EXPECT_EQ(state.cursorKey(), 0u);
    ListResult result = ListResult();
    ASSERT_TRUE(ApplyListControlAction(source, ListOptions(), MakeRangeSourceAction(state, source, ControlActionKind::Down), state, result));
    ASSERT_TRUE(ApplyListControlAction(source, ListOptions(), MakeRangeSourceAction(state, source, ControlActionKind::Submit), state, result));
    EXPECT_TRUE(result.valid);
    EXPECT_FALSE(result.selectionChanged);
    EXPECT_FALSE(result.activated);
    EXPECT_EQ(source.findCalls.value(), 0u);
    EXPECT_EQ(source.lookupCalls.value(), 0u);
}

void VerifyUiListBehaviorTests_HundredThousandRowsSkipALargeDisabledRangeWithBoundedSourceCalls(){
    RangeSource source = RangeSource();
    source.count = 100000u;
    source.disabledBegin = 49999u;
    source.disabledEnd = 99999u;
    ListState state = ListState();
    state.select(49999u);
    ASSERT_TRUE(ReconcileListState(state, source));
    source.clearCalls();
    ListResult result = ListResult();
    ASSERT_TRUE(ApplyListControlAction(source, ListOptions(), MakeRangeSourceAction(state, source, ControlActionKind::Down), state, result));
    EXPECT_EQ(state.selectedKey(), 100000u);
    EXPECT_EQ(state.cursorKey(), 100000u);
    EXPECT_EQ(source.findCalls.value(), 1u);
    EXPECT_LE(source.lookupCalls.value(), 2u);
    EXPECT_LE(source.keyCalls.value(), 3u);
    EXPECT_LE(source.enabledCalls.value(), 2u);
    ASSERT_TRUE(ApplyListControlAction(source, ListOptions(), MakeRangeSourceAction(state, source, ControlActionKind::Up), state, result));
    EXPECT_EQ(state.cursorKey(), 49999u);
    EXPECT_TRUE(result.selectionChanged);
    EXPECT_FALSE(result.activated);
}

void VerifyUiListBehaviorTests_HomeEndAndBoundaryNavigationNeverWrap(){
    RangeSource source = RangeSource();
    ListState state = ListState();
    ASSERT_TRUE(ReconcileListState(state, source));
    ListResult result = ListResult();
    ASSERT_TRUE(ApplyListControlAction(source, ListOptions(), MakeRangeSourceAction(state, source, ControlActionKind::Home), state, result));
    ASSERT_TRUE(ApplyListControlAction(source, ListOptions(), MakeRangeSourceAction(state, source, ControlActionKind::Up), state, result));
    EXPECT_EQ(state.cursorKey(), 1u);
    ASSERT_TRUE(ApplyListControlAction(source, ListOptions(), MakeRangeSourceAction(state, source, ControlActionKind::End), state, result));
    ASSERT_TRUE(ApplyListControlAction(source, ListOptions(), MakeRangeSourceAction(state, source, ControlActionKind::Down), state, result));
    EXPECT_EQ(state.cursorKey(), 10u);
    EXPECT_FALSE(result.activated);
}

void VerifyUiListBehaviorTests_PageNavigationUsesAcceptedRowsAndSaturatesWithoutIntegerOverflow(){
    RangeSource source = RangeSource();
