void VerifyUiSelectionEpochTests_RejectedSelectionDoesNotRetireACompletedPaste(mut UiSelectionEpochTests self){
    ASSERT_TRUE(self.seedSelection());
    UiEditClipboardController controller = UiEditClipboardController(self.m_arena, self.m_clipboard);
    self.m_clipboard.delayed = true;
    ASSERT_EQ(controller.request(self.owner(), self.m_model, UiEditClipboardAction::Paste).status, UiEditClipboardStatus::Pending);
    ASSERT_TRUE(self.m_clipboard.pump());
    const u64 selectionGeneration = self.m_model.selectionGeneration();
    ASSERT_FALSE(self.m_model.setSelection(0u, self.m_model.text().size() + 1u));
    EXPECT_EQ(self.m_model.selectionGeneration(), selectionGeneration);
    ASSERT_TRUE(self.m_clipboard.deliver(controller.token(), ClipboardStatus::Success, "X"));
    const UiEditClipboardResult result = controller.drain(self.owner(), self.m_model);
    EXPECT_EQ(result.status, UiEditClipboardStatus::Applied);
    EXPECT_EQ(self.m_model.text(), "aXd");
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "abcd");
    EXPECT_EQ(self.m_model.anchor(), 1u);
    EXPECT_EQ(self.m_model.caret(), 3u);
}

