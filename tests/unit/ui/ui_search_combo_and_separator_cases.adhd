const AStringView s_UiSearchComboCallbackQuery = "callback";
const AStringView s_UiSearchComboEmptyResultQuery = "None";
const AStringView s_UiSearchComboSecondHalfQuery = "Second";
const AStringView s_UiSearchComboPreeditText = "preedit";
const AStringView s_UiSearchComboKey = "combo";
const AStringView s_UiSearchComboPanelKey = "panel";
const u32 s_UiSeparatorQuietNaNF32Bits = 0x7fc00000u;


b8 AcceptUiSearchSelectionEpochInitial(mut UiSearchSelectionEpochTests self){
    self.m_search.combo().select(4u);
    self.m_search.combo().open();
    if(!self.m_search.query().setText(s_UiSearchComboSecondHalfQuery) || !self.m_search.query().setSelection(1u, 4u))
        return false;
    if(!self.declareEpochSearch(1u) || !self.finishPanel() || !self.m_context.commitFrame(1u))
        return false;
    b8 foundEditor = false;
    Rect editorRect = Rect();
    native(in self, mut foundEditor, mut editorRect){
        const auto* editor = self.target(self.query());
        if(editor != nullptr){
            foundEditor = true;
            editorRect = editor->rectangle;
        }
    }
    if(!foundEditor)
        return false;
    self.m_displayedEditor = editorRect;
    self.m_displayedFocus = self.m_context.input().focus();
    self.m_queryRevision = self.m_search.query().revision();
    self.m_queryExternalRevision = self.m_search.query().externalRevision();
    self.m_compositionGeneration = self.m_search.query().compositionGeneration();
    self.m_selectionGeneration = self.m_search.query().selectionGeneration();
    return true;
}

void ExpectUiSearchSelectionEpochPreservedState(mut UiSearchSelectionEpochTests self, in b8 focusRetired){
    EXPECT_EQ(self.m_search.query().text(), s_UiSearchComboSecondHalfQuery);
    EXPECT_EQ(self.m_search.query().anchor(), 1u);
    EXPECT_EQ(self.m_search.query().caret(), 4u);
    EXPECT_EQ(self.m_search.query().revision(), self.m_queryRevision);
    EXPECT_EQ(self.m_search.query().externalRevision(), self.m_queryExternalRevision);
    EXPECT_EQ(self.m_search.query().compositionGeneration(), self.m_compositionGeneration);
    EXPECT_NE(self.m_search.query().selectionGeneration(), self.m_selectionGeneration);
    EXPECT_EQ(self.m_search.combo().selectedKey(), 4u);
    EXPECT_TRUE(self.m_search.combo().isOpen());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    if(focusRetired)
        EXPECT_FALSE(self.m_context.input().focus().valid());
    else
        EXPECT_EQ(self.m_context.input().focus(), self.m_displayedFocus);
    Rect actualEditor = Rect();
    native(in self, mut actualEditor){
        const auto* editor = self.target(self.query());
        ASSERT_NE(editor, nullptr);
        actualEditor = editor->rectangle;
    }
    ExpectUiRect(actualEditor, self.m_displayedEditor);
}

void VerifyUiSearchSelectionEpochFilterRejection(mut UiSearchSelectionEpochTests self, in UiSearchSelectionMutationEnum mutation){
    ASSERT_TRUE(AcceptUiSearchSelectionEpochInitial(self));
    const u64 loans = self.m_host.loans;
    const u64 rowCalls = self.m_epochSource.view().textCalls();
    ++self.m_searchSource.full.contentRevision;
    self.m_epochSource.armFilter(mutation);
    EXPECT_FALSE(self.declareEpochSearch(2u));
    EXPECT_EQ(self.m_epochSource.filterMutationCalls(), 1u);
    EXPECT_EQ(self.m_host.loans, loans);
    EXPECT_EQ(self.m_epochSource.view().textCalls(), rowCalls);
    EXPECT_EQ(self.m_searchSource.full.contentRevision, 2u);
    ExpectUiSearchSelectionEpochPreservedState(self, false);
}

void VerifyUiSearchSelectionEpochDeferredPaintRejection(mut UiSearchSelectionEpochTests self, in UiSearchSelectionMutationEnum mutation){
    ASSERT_TRUE(AcceptUiSearchSelectionEpochInitial(self));
    ASSERT_TRUE(self.declareEpochSearch(2u));
    const u64 rowCalls = self.m_epochSource.view().textCalls();
    self.m_epochSource.view().arm(mutation);
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_EQ(self.m_epochSource.view().mutationCalls(), 1u);
    EXPECT_GT(self.m_epochSource.view().textCalls(), rowCalls);
    ExpectUiSearchSelectionEpochPreservedState(self, true);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyUiSearchComboBehaviorTests_QueryChangeRetiresPreviewAndScrollWithoutChangingCommittedSelection(mut UiSearchComboBehaviorTests self){
    self.m_state.combo().select(5u);
    ASSERT_TRUE(UiSearchComboReconcileCombo(self.m_state.combo(), self.m_source));
    ASSERT_TRUE(UiSearchComboFilterState(self.m_state, self.m_source));
    ASSERT_TRUE(UiSearchComboReconcilePreview(self.m_state, self.m_source.filtered()));
    UiSearchComboSelectPreview(self.m_state, 10u);
    ASSERT_TRUE(UiSearchComboScrollPreview(self.m_state, 96.0));
    const u64 previewGeneration = self.m_state.combo().listState().inputGeneration();
    ASSERT_TRUE(self.m_state.query().setText("tail"));
    ASSERT_TRUE(UiSearchComboFilterState(self.m_state, self.m_source));
    EXPECT_EQ(self.m_state.combo().selectedKey(), 5u);
    EXPECT_NE(self.m_state.combo().listState().inputGeneration(), previewGeneration);
    EXPECT_DOUBLE_EQ(self.m_state.combo().listState().scrollOffset(), 0.0);
    ASSERT_TRUE(UiSearchComboReconcilePreview(self.m_state, self.m_source.filtered()));
    EXPECT_EQ(self.m_state.combo().listState().selectedKey(), 0u);
    EXPECT_EQ(self.m_state.combo().listState().cursorKey(), 0u);
    EXPECT_EQ(self.m_state.combo().selectedKey(), 5u);
    EXPECT_EQ(self.m_source.filterCalls, 2u);
}

void VerifyUiSearchComboBehaviorTests_NoResultsPreserveTheFullSourceSelectionAndOpenPopup(mut UiSearchComboBehaviorTests self){
    self.m_state.combo().select(5u);
    ASSERT_TRUE(UiSearchComboReconcileCombo(self.m_state.combo(), self.m_source));
    self.m_state.combo().open();
    ASSERT_TRUE(self.m_state.query().setText("none"));
    ASSERT_TRUE(UiSearchComboFilterState(self.m_state, self.m_source));
    ASSERT_TRUE(UiSearchComboReconcilePreview(self.m_state, self.m_source.filtered()));
    EXPECT_EQ(self.m_state.combo().selectedKey(), 5u);
    EXPECT_TRUE(self.m_state.combo().isOpen());
    EXPECT_EQ(self.m_state.combo().listState().cursorKey(), 0u);
    EXPECT_EQ(self.m_source.view.count, 0u);
}

void VerifyUiSearchComboBehaviorTests_FullSourceRevisionChangeRebuildsAndRetiresPreviewWithSameQuery(mut UiSearchComboBehaviorTests self){
    ASSERT_TRUE(UiSearchComboFilterState(self.m_state, self.m_source));
    UiSearchComboSelectPreview(self.m_state, 8u);
    ASSERT_TRUE(UiSearchComboScrollPreview(self.m_state, 96.0));
    const u64 inputGeneration = self.m_state.combo().listState().inputGeneration();
    ++self.m_source.revisionValue;
    ASSERT_TRUE(UiSearchComboFilterState(self.m_state, self.m_source));
    EXPECT_EQ(self.m_source.filterCalls, 2u);
    EXPECT_EQ(self.m_source.rebuilds, 2u);
    EXPECT_NE(self.m_state.combo().listState().inputGeneration(), inputGeneration);
    EXPECT_EQ(self.m_state.combo().listState().cursorKey(), self.m_state.combo().selectedKey());
    EXPECT_DOUBLE_EQ(self.m_state.combo().listState().scrollOffset(), 0.0);
}

void VerifyUiSearchComboBehaviorTests_FullDatasetShrinkRebuildsAStaleLargerView(mut UiSearchComboBehaviorTests self){
    ASSERT_TRUE(UiSearchComboFilterState(self.m_state, self.m_source));
    ASSERT_EQ(self.m_source.view.count, 100000u);
    self.m_source.count = 10u;
    ++self.m_source.revisionValue;
    ASSERT_TRUE(UiSearchComboFilterState(self.m_state, self.m_source));
    EXPECT_EQ(self.m_source.view.count, 10u);
    EXPECT_EQ(self.m_source.filterCalls, 2u);
}

void VerifyUiSearchComboBehaviorTests_FullSourceReplacementRebuildsWithoutHoldingAnySourcePointer(mut UiSearchComboBehaviorTests self){
    ASSERT_TRUE(UiSearchComboFilterState(self.m_state, self.m_source));
    UiSearchComboBehaviorSource replacement = UiSearchComboBehaviorSource(self.m_arena, self.m_state);
    replacement.generation = 72u;
    replacement.count = 12u;
    ASSERT_TRUE(UiSearchComboFilterState(self.m_state, replacement));
    EXPECT_EQ(replacement.filterCalls, 1u);
    EXPECT_EQ(replacement.view.count, 12u);
    EXPECT_EQ(self.m_source.filterCalls, 1u);
}

