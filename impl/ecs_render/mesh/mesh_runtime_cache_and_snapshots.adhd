template<typename PayloadT>
[[nodiscard]] static Expected<Core::BufferHandle, BufferSetupFailure::Enum> SetupMeshBuffer(
    Core::GraphicsRuntime& graphics,
    const Name& meshName,
    const AStringView suffix,
    const Span<const PayloadT> payload,
    const AStringView label,
    const b8 canHaveRawViews = false,
    const b8 accelStructBuildInput = false
){
    const auto bufferName = DeriveMeshBufferName(meshName, suffix, label);
    if(!bufferName)
        return MakeUnexpected(BufferSetupFailure::CreateFailed);

    auto buffer = RuntimeMeshBufferUpload::SetupRequiredBuffer<PayloadT>(graphics, *bufferName, payload, { false, canHaveRawViews, accelStructBuildInput, Core::ResourceQueueSharing::GraphicsAndAsyncCompute });
    if(!buffer){
        ReportMeshBufferSetupFailure(buffer.error(), meshName, label);
        return MakeUnexpected(buffer.error());
    }
    return Move(*buffer);
}

[[nodiscard]] static Expected<Core::BufferHandle, BufferSetupFailure::Enum> SetupPaddedRawMeshBuffer(
    Core::GraphicsRuntime& graphics,
    Core::Alloc::ScratchArena& scratchArena,
    const Name& meshName,
    const AStringView suffix,
    const Span<const u8> payload,
    const AStringView label
){
    const auto bufferName = DeriveMeshBufferName(meshName, suffix, label);
    if(!bufferName)
        return MakeUnexpected(BufferSetupFailure::CreateFailed);

    auto buffer = RuntimeMeshBufferUpload::SetupRequiredPaddedRawByteBuffer(graphics, scratchArena, *bufferName, payload, { false, true, false, Core::ResourceQueueSharing::GraphicsAndAsyncCompute });
    if(!buffer){
        ReportMeshBufferSetupFailure(buffer.error(), meshName, label);
        return MakeUnexpected(buffer.error());
    }
    return Move(*buffer);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<NotNull<MeshResources*>> RendererMeshSystem::createMeshResources(const Core::Assets::AssetRef<Mesh>& meshAsset, Core::Alloc::ScratchArena& scratchArena){
    const Name meshPath = meshAsset.name();
    if(!meshPath){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: renderer mesh is empty"));
        return MakeUnexpected(Failure{});
    }

    const auto foundMesh = m_meshState.m_meshes.find(meshPath);
    if(foundMesh != m_meshState.m_meshes.end()){
        NWB_ASSERT(meshRenderBindingsReady(foundMesh.value()));
        NWB_ASSERT(foundMesh.value().valid());
        return MakeNotNull(&foundMesh.value());
    }

    auto loadedAsset = m_assetManager.loadTypedSync<Mesh>(meshPath, s_RendererAssetOwnerName);
    if(!loadedAsset)
        return MakeUnexpected(Failure{});

    const Mesh& mesh = **loadedAsset;
    // Mesh::loadBinary already ran the full payload validation (including u32 stream limits).
    NWB_ASSERT(mesh.validatePayload(scratchArena));
    NWB_ASSERT(mesh.meshlets().size() <= static_cast<usize>(Limit<u32>::s_Max));
    NWB_ASSERT(mesh.meshletPrimitiveIndices().size() <= static_cast<usize>(Limit<u32>::s_Max));

    MeshResources createdMesh;
    createdMesh.meshName = meshPath;
    createdMesh.meshletCount = static_cast<u32>(mesh.meshlets().size());
    createdMesh.meshletPrimitiveIndexCount = static_cast<u32>(mesh.meshletPrimitiveIndices().size());
    createdMesh.solidTriangleWords = Core::MakeGlobalUnique<u32[]>(m_arena, mesh.solidTriangleWords().size());
    if(!createdMesh.solidTriangleWords)
        return MakeUnexpected(Failure{});
    const usize solidByteCount = ComputeSolidTriangleWordByteSize(mesh.solidTriangleWords().size(), sizeof(u32));
    NWB_MEMCPY(createdMesh.solidTriangleWords.get(), solidByteCount, mesh.solidTriangleWords().data(), solidByteCount);
    const Expected<CsgReceiverCpuBounds> csgLocalBounds = NWB::Impl::BuildPositionStreamBounds(mesh.positionStream());
    if(!csgLocalBounds){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: mesh '{}' has invalid CSG receiver bounds"), ConvertString(meshPath.resolvedText()));
        return MakeUnexpected(Failure{});
    }
    createdMesh.csgLocalBounds = *csgLocalBounds;

    const b8 rtSupported = m_graphics.queryFeatureSupport(Core::Feature::RayTracingAccelStruct);
    // Both tracing backends read raw position/index buffers for material evaluation.
    const b8 swShadow = RequiresShadowSoftwareBvhBuild(rtSupported);

    b8 uploaded = true;
    auto positionBufferResult = __hidden_mesh_resources::SetupMeshBuffer<Float3U>(m_graphics, meshPath, s_PositionsBufferName, mesh.positionStream(), s_MeshPositionBufferLabel, true, rtSupported);
    if(positionBufferResult)
        createdMesh.positionBuffer = Move(*positionBufferResult);
    else
        createdMesh.positionBuffer.reset();
    uploaded = static_cast<b8>(positionBufferResult) && uploaded;
    auto normalBufferResult = __hidden_mesh_resources::SetupMeshBuffer<Half4U>(m_graphics, meshPath, s_NormalsBufferName, mesh.normalStream(), s_MeshNormalBufferLabel);
    if(normalBufferResult)
        createdMesh.normalBuffer = Move(*normalBufferResult);
    else
        createdMesh.normalBuffer.reset();
    uploaded = static_cast<b8>(normalBufferResult) && uploaded;
    auto tangentBufferResult = __hidden_mesh_resources::SetupMeshBuffer<Half4U>(m_graphics, meshPath, s_TangentsBufferName, mesh.tangentStream(), s_MeshTangentBufferLabel);
    if(tangentBufferResult)
        createdMesh.tangentBuffer = Move(*tangentBufferResult);
    else
        createdMesh.tangentBuffer.reset();
    uploaded = static_cast<b8>(tangentBufferResult) && uploaded;
    auto uv0BufferResult = __hidden_mesh_resources::SetupMeshBuffer<Float2U>(m_graphics, meshPath, s_Uv0BufferName, mesh.uv0Stream(), s_MeshUv0BufferLabel);
    if(uv0BufferResult)
        createdMesh.uv0Buffer = Move(*uv0BufferResult);
    else
        createdMesh.uv0Buffer.reset();
    uploaded = static_cast<b8>(uv0BufferResult) && uploaded;
    auto colorBufferResult = __hidden_mesh_resources::SetupMeshBuffer<Half4U>(m_graphics, meshPath, s_ColorsBufferName, mesh.colorStream(), s_MeshColorBufferLabel);
    if(colorBufferResult)
        createdMesh.colorBuffer = Move(*colorBufferResult);
    else
        createdMesh.colorBuffer.reset();
    uploaded = static_cast<b8>(colorBufferResult) && uploaded;
    auto meshletDescBufferResult = __hidden_mesh_resources::SetupMeshBuffer<MeshletDesc>(m_graphics, meshPath, s_MeshletsBufferName, mesh.meshlets(), s_MeshletDescriptorBufferLabel);
    if(meshletDescBufferResult)
        createdMesh.meshletDescBuffer = Move(*meshletDescBufferResult);
    else
        createdMesh.meshletDescBuffer.reset();
    uploaded = static_cast<b8>(meshletDescBufferResult) && uploaded;
    auto meshletBoundsBufferResult = __hidden_mesh_resources::SetupMeshBuffer<MeshletBounds>(m_graphics, meshPath, s_MeshletBoundsBufferName, mesh.meshletBounds(), s_MeshletBoundsBufferLabel, true);
    if(meshletBoundsBufferResult)
        createdMesh.meshletBoundsBuffer = Move(*meshletBoundsBufferResult);
    else
        createdMesh.meshletBoundsBuffer.reset();
    uploaded = static_cast<b8>(meshletBoundsBufferResult) && uploaded;
    auto meshletPositionRefDeltaBufferResult = __hidden_mesh_resources::SetupPaddedRawMeshBuffer(m_graphics, scratchArena, meshPath, s_MeshletPositionRefDeltasBufferName, mesh.meshletPositionRefDeltas(), s_MeshletPositionRefDeltaBufferLabel);
    if(meshletPositionRefDeltaBufferResult)
        createdMesh.meshletPositionRefDeltaBuffer = Move(*meshletPositionRefDeltaBufferResult);
    else
        createdMesh.meshletPositionRefDeltaBuffer.reset();
    uploaded = static_cast<b8>(meshletPositionRefDeltaBufferResult) && uploaded;
    auto meshletAttributeRefDeltaBufferResult = __hidden_mesh_resources::SetupPaddedRawMeshBuffer(m_graphics, scratchArena, meshPath, s_MeshletAttributeRefDeltasBufferName, mesh.meshletAttributeRefDeltas(), s_MeshletAttributeRefDeltaBufferLabel);
    if(meshletAttributeRefDeltaBufferResult)
        createdMesh.meshletAttributeRefDeltaBuffer = Move(*meshletAttributeRefDeltaBufferResult);
    else
        createdMesh.meshletAttributeRefDeltaBuffer.reset();
    uploaded = static_cast<b8>(meshletAttributeRefDeltaBufferResult) && uploaded;
    auto meshletLocalVertexRefBufferResult = __hidden_mesh_resources::SetupMeshBuffer<MeshletLocalVertexRef>(m_graphics, meshPath, s_MeshletLocalVertexRefsBufferName, mesh.meshletLocalVertexRefs(), s_MeshletLocalVertexRefBufferLabel);
    if(meshletLocalVertexRefBufferResult)
        createdMesh.meshletLocalVertexRefBuffer = Move(*meshletLocalVertexRefBufferResult);
    else
        createdMesh.meshletLocalVertexRefBuffer.reset();
    uploaded = static_cast<b8>(meshletLocalVertexRefBufferResult) && uploaded;
    auto meshletPrimitiveIndexBufferResult = __hidden_mesh_resources::SetupPaddedRawMeshBuffer(m_graphics, scratchArena, meshPath, s_MeshletPrimitiveIndicesBufferName, mesh.meshletPrimitiveIndices(), s_MeshletPrimitiveIndexBufferLabel);
    if(meshletPrimitiveIndexBufferResult)
        createdMesh.meshletPrimitiveIndexBuffer = Move(*meshletPrimitiveIndexBufferResult);
    else
        createdMesh.meshletPrimitiveIndexBuffer.reset();
    uploaded = static_cast<b8>(meshletPrimitiveIndexBufferResult) && uploaded;
    if(!uploaded)
        return MakeUnexpected(Failure{});

    // Both shadow backends trace triangles; always create the reconstructed index buffer.
    {
        const auto triangleIndices = BuildMeshletTriangleIndices(mesh, scratchArena);
        if(!triangleIndices){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to reconstruct shadow trace triangle indices for mesh '{}'"), ConvertString(meshPath.resolvedText()));
            return MakeUnexpected(Failure{});
        }

        const auto indexBufferName = DeriveName(meshPath, s_RtTriangleIndicesBufferName);
        if(!indexBufferName){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to derive shadow trace index buffer name for mesh '{}'"), ConvertString(meshPath.resolvedText()));
            return MakeUnexpected(Failure{});
        }

        RuntimeMeshBufferUpload::BufferFlags indexFlags;
        indexFlags.canHaveRawViews = true;
        indexFlags.isIndexBuffer = true;
        indexFlags.accelStructBuildInput = rtSupported;
        // Async shadow packet shares this stream; keep sharing consistent to avoid ownership transfer.
        indexFlags.queueSharing = Core::ResourceQueueSharing::GraphicsAndAsyncCompute;
        auto indexBuffer = RuntimeMeshBufferUpload::SetupRequiredBuffer<u32>(m_graphics, *indexBufferName, *triangleIndices, indexFlags);
        if(!indexBuffer){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to create shadow trace index buffer for mesh '{}'"), ConvertString(meshPath.resolvedText()));
            return MakeUnexpected(Failure{});
        }

        createdMesh.triangleIndexBuffer = Move(*indexBuffer);
        MeshAccelerationStatePolicy().finalizeShadowIndices(meshPath, triangleIndices->size(), createdMesh.meshletPrimitiveIndexCount, rtSupported, swShadow, createdMesh.blasBuildPending, createdMesh.swBvhBuildPending);
    }

    // Flat per-corner trace attributes in lockstep with the index buffer; always carries a raw view.
    {
        const auto triangleAttributes = BuildMeshletTriangleAttributes(mesh, scratchArena);
        if(!triangleAttributes){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to reconstruct shadow trace triangle attributes for mesh '{}'"), ConvertString(meshPath.resolvedText()));
            return MakeUnexpected(Failure{});
        }

        const auto attributeBufferName = DeriveName(meshPath, s_RtTriangleAttributesBufferName);
        if(!attributeBufferName){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to derive shadow trace attribute buffer name for mesh '{}'"), ConvertString(meshPath.resolvedText()));
            return MakeUnexpected(Failure{});
        }

        RuntimeMeshBufferUpload::BufferFlags attributeFlags;
        attributeFlags.canHaveRawViews = true;
        // Tracing shares these attributes on AsyncCompute; keep shared-read input.
        attributeFlags.queueSharing = Core::ResourceQueueSharing::GraphicsAndAsyncCompute;
        auto attributeBuffer = RuntimeMeshBufferUpload::SetupRequiredBuffer<AttribGpu>(m_graphics, *attributeBufferName, *triangleAttributes, attributeFlags);
        if(!attributeBuffer){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to create shadow trace triangle attribute buffer for mesh '{}'"), ConvertString(meshPath.resolvedText()));
            return MakeUnexpected(Failure{});
        }
        createdMesh.attributeBuffer = Move(*attributeBuffer);
    }

    NWB_ASSERT(createdMesh.valid());
    MeshDescriptorTransaction retireUnpublished(*this, createdMesh);
    if(!createMeshRenderBindings(createdMesh))
        return MakeUnexpected(Failure{});

    auto result = m_meshState.m_meshes.try_emplace(meshPath, Move(createdMesh));
    if(result.second)
        retireUnpublished.release();
    auto it = result.first;

    NWB_ASSERT(it.value().valid());
    return MakeNotNull(&it.value());
}

Expected<NotNull<MeshResources*>> RendererMeshSystem::findMeshResources(const Name& meshKey)noexcept{
    if(!meshKey)
        return MakeUnexpected(Failure{});

    const auto foundMesh = m_meshState.m_meshes.find(meshKey);
    if(foundMesh == m_meshState.m_meshes.end())
        return MakeUnexpected(Failure{});

    NWB_ASSERT(meshRenderBindingsReady(foundMesh.value()));
    NWB_ASSERT(foundMesh.value().valid());
    return MakeNotNull(&foundMesh.value());
}

Expected<NotNull<MeshResources*>> RendererMeshSystem::createRuntimeMeshResources(const RuntimeMeshDesc& desc){
    return RuntimeMeshResourceCache(*this).create(desc);
}

Expected<NotNull<MeshResources*>> RendererMeshSystem::findRuntimeMeshResources(const RuntimeMeshDesc& desc)noexcept{
    return RuntimeMeshResourceCache(*this).find(desc);
}

void RendererMeshSystem::pruneRuntimeMeshResources(Core::Alloc::ScratchArena& scratchArena){
    if(m_meshState.m_meshes.empty())
        return;

    const auto* meshSystemPtr = m_world.getSystem<NWB::Impl::MeshSystem>();
    ECSRenderDetail::PruneRuntimeMeshResources(m_meshState.m_meshes, meshSystemPtr, [this](MeshResources& mesh){ releaseMeshGeometryHeapHandles(mesh); }, scratchArena);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_runtime_mesh_resource_cache{


[[nodiscard]] static b8 RuntimeMeshSourceMatches(const MeshResources& mesh, const RuntimeMeshDesc& desc)noexcept{
    return
        RuntimeMeshSourceDimensionsMatch(mesh.runtimeMeshVersion, desc.version, mesh.meshletCount, desc.meshletCount, mesh.meshletPrimitiveIndexCount, desc.meshletPrimitiveIndexCount)
        && mesh.sameBuffers(desc)
        && mesh.triangleIndexBuffer == desc.triangleIndexBuffer
        && mesh.attributeBuffer == desc.attributeBuffer
        && mesh.runtimeLocalBoundsBuffer == desc.localBoundsBuffer
        && mesh.runtimeMeshletLocalBoundsBuffer == desc.meshletLocalBoundsBuffer
    ;
}

static void RefreshRuntimeMeshContent(MeshResources& mesh, const RuntimeMeshDesc& desc)noexcept{
    mesh.runtimeGeometryContentRevision = desc.geometryContentRevision;
    mesh.dynamicMeshletBoundsFresh = desc.dynamicMeshletBoundsFresh;
    mesh.dynamicMeshletConesFresh = desc.dynamicMeshletConesFresh;
    RefreshRuntimeMeshCsgBounds(LoadFloatInt(desc.localBounds.minBounds), LoadFloatInt(desc.localBounds.maxBounds), desc.localBounds.finite(), mesh.csgLocalBounds);
}

[[nodiscard]] static b8 ValidateRawBufferLogicalByteCount(const Core::BufferHandle& buffer, const u32 logicalByteCount, const Name& meshName, const AStringView label){
    const Core::BufferDesc emptyDesc{};
    const Core::BufferDesc& desc = buffer ? buffer->getCreationDescription() : emptyDesc;
    return ValidateMeshRawBufferLogicalByteCount(buffer != nullptr, desc.structStride, desc.byteSize, logicalByteCount, meshName, label);
}


};


Expected<NotNull<MeshResources*>> RuntimeMeshResourceCache::create(const RuntimeMeshDesc& desc){
    NWB_ASSERT(desc.valid());

    const auto foundMesh = m_system.m_meshState.m_meshes.find(desc.meshKey);
    if(foundMesh != m_system.m_meshState.m_meshes.end()){
        if(!foundMesh.value().runtimeMesh){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: runtime mesh '{}' collides with a static mesh resource"), ConvertString(desc.meshKey.resolvedText()));
            return MakeUnexpected(Failure{});
        }
        if(!__hidden_runtime_mesh_resource_cache::RuntimeMeshSourceMatches(foundMesh.value(), desc)){
            m_system.releaseMeshGeometryHeapHandles(foundMesh.value());
            m_system.m_meshState.m_meshes.erase(foundMesh);
        }
        else{
            NWB_ASSERT(m_system.meshRenderBindingsReady(foundMesh.value()));
            MeshResources& mesh = foundMesh.value();
            __hidden_runtime_mesh_resource_cache::RefreshRuntimeMeshContent(mesh, desc);
            NWB_ASSERT(mesh.valid());
            return MakeNotNull(&mesh);
        }
    }

    MeshResources createdMesh;
    createdMesh.meshName = desc.meshKey;
    createdMesh.solidTriangleWords = Core::MakeGlobalUnique<u32[]>(m_system.m_arena, desc.solidTriangleWords.size());
    if(!createdMesh.solidTriangleWords)
        return MakeUnexpected(Failure{});
    const usize solidByteCount = desc.solidTriangleWords.size_bytes();
    NWB_MEMCPY(createdMesh.solidTriangleWords.get(), solidByteCount, desc.solidTriangleWords.data(), solidByteCount);
    createdMesh.positionBuffer = desc.positionBuffer;
    createdMesh.normalBuffer = desc.normalBuffer;
    createdMesh.tangentBuffer = desc.tangentBuffer;
    createdMesh.uv0Buffer = desc.uv0Buffer;
    createdMesh.colorBuffer = desc.colorBuffer;
    createdMesh.meshletDescBuffer = desc.meshletDescBuffer;
    createdMesh.meshletBoundsBuffer = desc.meshletBoundsBuffer;
    createdMesh.meshletPositionRefDeltaBuffer = desc.meshletPositionRefDeltaBuffer;
    createdMesh.meshletAttributeRefDeltaBuffer = desc.meshletAttributeRefDeltaBuffer;
    createdMesh.meshletLocalVertexRefBuffer = desc.meshletLocalVertexRefBuffer;
    createdMesh.meshletPrimitiveIndexBuffer = desc.meshletPrimitiveIndexBuffer;
    createdMesh.triangleIndexBuffer = desc.triangleIndexBuffer;
    createdMesh.attributeBuffer = desc.attributeBuffer;
    createdMesh.runtimeLocalBoundsBuffer = desc.localBoundsBuffer;
    createdMesh.runtimeMeshletLocalBoundsBuffer = desc.meshletLocalBoundsBuffer;
    createdMesh.blasBuildPending = (desc.triangleIndexBuffer != nullptr);
    createdMesh.meshletCount = desc.meshletCount;
    createdMesh.meshletPrimitiveIndexCount = desc.meshletPrimitiveIndexCount;
    createdMesh.runtimeMesh = true;
    createdMesh.runtimeMeshVersion = desc.version;
    NWB_ASSERT(desc.localBounds.valid());
    __hidden_runtime_mesh_resource_cache::RefreshRuntimeMeshContent(createdMesh, desc);
    if(!ValidateRuntimeMeshPrimitiveIndexCount(createdMesh.meshName, createdMesh.meshletPrimitiveIndexCount, s_MeshletTriangleIndexCount))
        return MakeUnexpected(Failure{});
    if(!__hidden_runtime_mesh_resource_cache::ValidateRawBufferLogicalByteCount(createdMesh.meshletPrimitiveIndexBuffer, createdMesh.meshletPrimitiveIndexCount, createdMesh.meshName, s_MeshletPrimitiveIndexBufferLabel))
        return MakeUnexpected(Failure{});
    NWB_ASSERT(createdMesh.valid());
    MeshDescriptorTransaction retireUnpublished(m_system, createdMesh);
    if(!m_system.createMeshRenderBindings(createdMesh))
        return MakeUnexpected(Failure{});

    auto result = m_system.m_meshState.m_meshes.try_emplace(desc.meshKey, Move(createdMesh));
    if(result.second)
        retireUnpublished.release();
    auto it = result.first;

    NWB_ASSERT(it.value().valid());
    return MakeNotNull(&it.value());
}

Expected<NotNull<MeshResources*>> RuntimeMeshResourceCache::find(const RuntimeMeshDesc& desc)noexcept{
    NWB_ASSERT(desc.valid());

    const auto foundMesh = m_system.m_meshState.m_meshes.find(desc.meshKey);
    if(foundMesh == m_system.m_meshState.m_meshes.end())
        return MakeUnexpected(Failure{});

    MeshResources& mesh = foundMesh.value();
    if(!mesh.runtimeMesh || !__hidden_runtime_mesh_resource_cache::RuntimeMeshSourceMatches(mesh, desc))
        return MakeUnexpected(Failure{});

    NWB_ASSERT(m_system.meshRenderBindingsReady(mesh));
    __hidden_runtime_mesh_resource_cache::RefreshRuntimeMeshContent(mesh, desc);
    NWB_ASSERT(mesh.valid());
    return MakeNotNull(&mesh);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


