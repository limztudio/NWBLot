////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_csg/deform_rebuild.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<CsgDeformStats, CsgDeformFailure> PreviewCsgDeformCuts(
    in Span<CsgDeformVertex> inputVertices,
    in Span<CsgDeformTriangle> inputTriangles,
    in Span<CsgDeformCutDesc> cuts,
    in CsgDeformBuildOptions options,
    mut Vector<CsgDeformVertex> outVertices,
    mut Vector<CsgDeformTriangle> outTriangles
){
    CsgDeformRebuild rebuild = CsgDeformRebuild();
    return rebuild.build(inputVertices, inputTriangles, cuts, options, outVertices, outTriangles);
}

Expected<CsgDeformStats, CsgDeformFailure> PreviewCsgDeformCuts(
    in Span<CsgDeformVertex> inputVertices,
    in Span<CsgDeformTriangle> inputTriangles,
    in Span<CsgDeformCutDesc> cuts,
    in CsgDeformBuildOptions options,
    in CsgShapeRegistry registry,
    mut Vector<CsgDeformVertex> outVertices,
    mut Vector<CsgDeformTriangle> outTriangles
){
    CsgDeformRebuild rebuild = CsgDeformRebuild();
    rebuild.bindRegistry(registry, cuts);
    return rebuild.build(inputVertices, inputTriangles, cuts, options, outVertices, outTriangles);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


CsgDeformViability CheckCsgDeformCutsViability(
    in Span<CsgDeformVertex> inputVertices,
    in Span<CsgDeformTriangle> inputTriangles,
    in Span<CsgDeformCutDesc> cuts,
    in CsgDeformBuildOptions options
){
    CsgDeformRebuild rebuild = CsgDeformRebuild();
    return rebuild.viability(inputVertices, inputTriangles, cuts, options);
}

CsgDeformViability CheckCsgDeformCutsViability(
    in Span<CsgDeformVertex> inputVertices,
    in Span<CsgDeformTriangle> inputTriangles,
    in Span<CsgDeformCutDesc> cuts,
    in CsgDeformBuildOptions options,
    in CsgShapeRegistry registry
){
    CsgDeformRebuild rebuild = CsgDeformRebuild();
    rebuild.bindRegistry(registry, cuts);
    return rebuild.viability(inputVertices, inputTriangles, cuts, options);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<CsgDeformStats, CsgDeformFailure> CommitCsgDeformCuts(
    in AllocationIdentity destination,
    in Span<CsgDeformVertex> inputVertices,
    in Span<CsgDeformTriangle> inputTriangles,
    in Span<CsgDeformCutDesc> cuts,
    in CsgDeformBuildOptions options,
    mut Vector<CsgDeformVertex> outVertices,
    mut Vector<CsgDeformTriangle> outTriangles
){
    if(!destination.owns(outVertices) || !destination.owns(outTriangles))
        return MakeUnexpected(MakeCsgDeformFailure(CsgDeformViabilityReason::InvalidOutputArena, CsgDeformStats()));
    return PreviewCsgDeformCuts(inputVertices, inputTriangles, cuts, options, outVertices, outTriangles);
}

Expected<CsgDeformStats, CsgDeformFailure> CommitCsgDeformCuts(
    in AllocationIdentity destination,
    in Span<CsgDeformVertex> inputVertices,
    in Span<CsgDeformTriangle> inputTriangles,
    in Span<CsgDeformCutDesc> cuts,
    in CsgDeformBuildOptions options,
    in CsgShapeRegistry registry,
    mut Vector<CsgDeformVertex> outVertices,
    mut Vector<CsgDeformTriangle> outTriangles
){
    if(!destination.owns(outVertices) || !destination.owns(outTriangles))
        return MakeUnexpected(MakeCsgDeformFailure(CsgDeformViabilityReason::InvalidOutputArena, CsgDeformStats()));
    return PreviewCsgDeformCuts(inputVertices, inputTriangles, cuts, options, registry, outVertices, outTriangles);
}


