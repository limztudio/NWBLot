    EXPECT_FALSE(bounds.has_value());
}

void VerifyOutputLayerColor_TransparentHdrLayerPreservesSceneAndOpaqueUiIgnoresSceneExposure(){
    const ShaderFloat3 scene = ShaderFloat3(0.1, 3.0, 100.0);
    OutputLayerColor_ExpectColorNear(nwbHdr10EncodeSceneWithUi(scene, ShaderFloat3(0.0), 0.0f), nwbHdr10EncodeScene(scene), 0.000001);
    const ShaderFloat3 ui = ShaderFloat3(0.2, 0.5, 0.9);
    const ShaderFloat3 expected = nwbHdr10EncodeUiLinear(ui);
    OutputLayerColor_ExpectColorNear(nwbHdr10EncodeSceneWithUi(scene, ui, 1.0f), expected, 0.000001);
    OutputLayerColor_ExpectColorNear(nwbHdr10EncodeSceneWithUi(HdrMultiply(scene, ShaderFloat3(64.0)), ui, 1.0f), expected, 0.000001);
}

void VerifyOutputLayerColor_HdrBlendsInLinearNitsBeforeOnePqEncoding(){
    const ShaderFloat3 actual = nwbHdr10EncodeSceneWithUi(ShaderFloat3(0.0), ShaderFloat3(0.5), 0.5f);
    OutputLayerColor_ExpectColorNear(actual, nwbHdr10PqEncodeNits(ShaderFloat3(101.5)), 0.000001);
    const ShaderFloat3 encodedBlend = HdrMultiply(nwbHdr10EncodeUiLinear(ShaderFloat3(1.0)), ShaderFloat3(0.5));
    EXPECT_GT(actual.x - encodedBlend.x, 0.1);
}

void VerifyOutputLayerColor_NegativeUiRadianceClampsAndHighlightsRemainBelowTheOutputBound(){
    EXPECT_LT(nwbHdr10SceneToNits(ShaderFloat3(100.0)).x, 1000.0);
    OutputLayerColor_ExpectColorNear(nwbHdr10EncodeUiLinear(ShaderFloat3(-1.0)), nwbHdr10EncodeUiLinear(ShaderFloat3(0.0)), 0.000001);
}

void PublishRecordingOutputLayer(mut RecordingLayerContributor contributor, in u64 frameGeneration, in QueueSubmissionToken token){
    AcceptRecordingOutputLayer(contributor, frameGeneration, token);
}

void VerifyOutputLayer_MissingContributorInvalidTokenAndZeroGenerationCannotPublishAcceptance(){
    RecordingLayerContributor contributor = RecordingLayerContributor();
    const QueueSubmissionToken emptyToken = QueueSubmissionToken();
    AcceptNullOutputLayer(17u, emptyToken);
    PublishRecordingOutputLayer(contributor, 17u, emptyToken);
    EXPECT_EQ(contributor.acceptanceCount, 0u);
    QueueSubmissionToken consumerToken = QueueSubmissionToken();
    consumerToken.value = 101u;
    consumerToken.physicalQueueIndex = 0u;
    consumerToken.deviceGeneration = 3u;
    consumerToken.queue = CommandQueue::Graphics;
    PublishRecordingOutputLayer(contributor, 17u, consumerToken);
    EXPECT_EQ(contributor.acceptanceCount, 1u);
    PublishRecordingOutputLayer(contributor, 0u, consumerToken);
    EXPECT_EQ(contributor.acceptanceCount, 1u);
}

void VerifyPreparedSoftwareBvhGraphResources_MissingImportedBuildBuffersCannotPublishResources(){
    SwBvhBuildContext context = SwBvhBuildContext();
    const PreparedMeshSwBvhGraphResourceVectorResult emptyResources = ResolveSwBvhGraphResources(context, PreparedMeshSwBvhBuildSpan());
    ASSERT_TRUE(emptyResources.has_value());
    EXPECT_TRUE(emptyResources.value().empty());
    const Array<PreparedMeshSwBvhBuild, 1> missingBuilds = Array<PreparedMeshSwBvhBuild, 1>();
    EXPECT_FALSE(ResolveSwBvhGraphResources(context, PreparedMeshSwBvhBuildSpan(missingBuilds.data(), missingBuilds.size())).has_value());
    const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(context.graph);
    ASSERT_TRUE(view.valid());
    EXPECT_EQ(view.resourceCount(), 0u);
}

