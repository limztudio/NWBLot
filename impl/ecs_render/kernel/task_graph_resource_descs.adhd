Expected<GpuGraphResourceId> ImportExternalTexture(
    in TextureHandle texture,
    in Name identity,
    in StringView label,
    in Optional<ResourceStates> initialState,
    in Optional<ResourceStates> externalFinalState,
    mut GpuTaskGraph graph
){
    GpuGraphResourceDesc desc = TextureResourceDesc(identity, label);
    if(initialState.has_value())
        desc.setInitialState(initialState.value());
    if(externalFinalState.has_value())
        desc.setExternalFinalState(externalFinalState.value());
    return graph.importTexture(texture, desc);
}

Expected<GpuGraphResourceId> ImportExternalTexture(
    mut GpuTaskGraph graph,
    in TextureHandle texture,
    in Name identity,
    in StringView label,
    in Optional<ResourceStates> initialState,
    in Optional<ResourceStates> externalFinalState
){
    return ImportExternalTexture(texture, identity, label, initialState, externalFinalState, graph);
}

