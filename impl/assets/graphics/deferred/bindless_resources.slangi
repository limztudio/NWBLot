////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_DEFERRED_BINDLESS_RESOURCES_SLANGI
#define NWB_GRAPHICS_DEFERRED_BINDLESS_RESOURCES_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../bindless/bindless_heap.slangi"

struct NwbDeferredBindlessResources{
    uint4 gbufferSlots;
    uint4 lightingSlots;
    uint4 compositeSlots;
    uint4 avboitSlots;
    uint4 avboitWorkSlots0;
    uint4 avboitWorkSlots1;
    uint4 csgPeelSlots;
    uint4 csgSpanSlots;
    uint4 csgRemovedSlots;
    uint4 refractionSlots0;
    uint4 refractionSlots1;
};

#pragma warning(push)
#pragma warning(disable: 39001)
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_UNIFORM_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] ConstantBuffer<NwbDeferredBindlessResources, Std140DataLayout> g_NwbHeapDeferredBindlessResources[];
#pragma warning(pop)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


ConstantBuffer<NwbDeferredBindlessResources, Std140DataLayout> nwbHeapDeferredBindlessResources(const uint slot){
    return g_NwbHeapDeferredBindlessResources[slot];
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


