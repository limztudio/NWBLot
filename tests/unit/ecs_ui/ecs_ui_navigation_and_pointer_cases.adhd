void VerifyUiEditBoxHostTests_MultilineAcceptEditsOnPressWhileExplicitSubmitWaitsForRelease(mut UiEditBoxHostTests self){
    UiEditModel multiline = UiEditModel(self.m_arena, UiEditLimits(), UiEditTextMode::Multiline);
    ASSERT_TRUE(self.frame(multiline));
    ASSERT_TRUE(self.key(Key::Tab));
    ASSERT_TRUE(self.frame(multiline));
    UiInputEvent down = UiInputEvent();
    down.key = Key::Enter;
    down.type = UiInputEventType::KeyDown;
    ASSERT_TRUE(self.dispatch(down));
    ASSERT_TRUE(self.frame(multiline));
    EXPECT_EQ(multiline.text(), "\n");
    EXPECT_FALSE(self.m_result.submitted);
    down.repeat = true;
    ASSERT_TRUE(self.dispatch(down));
    ASSERT_TRUE(self.frame(multiline));
    EXPECT_EQ(multiline.text(), "\n\n");
    UiInputEvent up = UiInputEvent();
    up.key = Key::Enter;
    up.type = UiInputEventType::KeyUp;
    ASSERT_TRUE(self.dispatch(up));
    ASSERT_TRUE(self.frame(multiline));
    EXPECT_EQ(multiline.text(), "\n\n");
    EXPECT_FALSE(self.m_result.submitted);
    UiInputEvent ctrlDown = UiInputEvent();
    ctrlDown.key = Key::Enter;
    ctrlDown.type = UiInputEventType::KeyDown;
    ctrlDown.control = true;
    ASSERT_TRUE(self.dispatch(ctrlDown));
    ASSERT_TRUE(self.frame(multiline));
    EXPECT_FALSE(self.m_result.submitted);
    ASSERT_TRUE(self.dispatch(up));
    ASSERT_TRUE(self.frame(multiline));
    EXPECT_TRUE(self.m_result.submitted);
    EXPECT_EQ(multiline.text(), "\n\n");
}

