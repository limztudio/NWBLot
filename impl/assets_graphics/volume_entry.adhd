b8 RegisterGraphicsComponentCookDependencies(mut CookDependencyRegistry registry){
    return registry.registerType(ModelComponentAsset::AssetTypeName(), ExtractModelComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(MeshComponentAsset::AssetTypeName(), ExtractMeshComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(RendererComponentAsset::AssetTypeName(), ExtractRendererComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(MaterialInstanceComponentAsset::AssetTypeName(), ExtractMaterialInstanceComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(SkeletonJointPaletteComponentAsset::AssetTypeName(), ExtractSkeletonJointPaletteComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(SkeletonPoseComponentAsset::AssetTypeName(), ExtractSkeletonPoseComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(SkinnedMeshBindingComponentAsset::AssetTypeName(), ExtractSkinnedMeshBindingComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(CsgReceiverComponentAsset::AssetTypeName(), ExtractCsgReceiverComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(StaticCsgMeshComponentAsset::AssetTypeName(), ExtractStaticCsgMeshComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(SkinnedCsgMeshComponentAsset::AssetTypeName(), ExtractSkinnedCsgMeshComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(CsgCutterComponentAsset::AssetTypeName(), ExtractCsgCutterComponentDependencies, IComponent::AssetTypeName());
}


