void VerifyUiEditPointerCaptureTests_ScrollbarGestureFocusCannotCollapseCrossLineSelection(mut UiEditPointerCaptureTests self){
    ASSERT_TRUE(self.m_navigationModel.setText("abcdef\nuvwxyz"));
    ASSERT_TRUE(self.m_navigationModel.setSelection(2u, 9u));
    ASSERT_TRUE(self.activateNavigation());
    ASSERT_TRUE(self.publishPart(true));
    ASSERT_TRUE(self.m_navigation.setPreferredX(40.0f));
    const UiEditNavigationSnapshot navigation = self.m_navigation.snapshot();
    const u64 revision = self.m_navigationModel.revision();
    const u64 selection = self.m_navigationModel.selectionGeneration();
    ASSERT_TRUE(self.dispatchPoint(MakeEcsUiPoint(185.0f, 62.0f), UiInputEventType::PrimaryDown));
    EXPECT_EQ(self.m_context.input().focus(), self.m_widget.id);
    EXPECT_EQ(self.m_context.input().capture(), self.m_otherWidget.id);
    ASSERT_TRUE(self.dispatchPoint(MakeEcsUiPoint(450.0f, 180.0f), UiInputEventType::PointerMove));
    ASSERT_TRUE(self.dispatchPoint(MakeEcsUiPoint(450.0f, 180.0f), UiInputEventType::PrimaryUp));
    ASSERT_TRUE(self.navigationFrame());
    EXPECT_EQ(self.m_navigationModel.anchor(), 2u);
    EXPECT_EQ(self.m_navigationModel.caret(), 9u);
    EXPECT_EQ(self.m_navigationModel.revision(), revision);
    EXPECT_EQ(self.m_navigationModel.selectionGeneration(), selection);
    EXPECT_TRUE(self.m_navigation.matches(navigation));
    EXPECT_FALSE(self.m_navigationModel.canUndo());
    EXPECT_TRUE(self.m_result.focused);
}

