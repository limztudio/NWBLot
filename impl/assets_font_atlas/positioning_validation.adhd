// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_font_atlas/gdef_validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class FontAtlasTableValidator{
    public FontAtlasTableValidator(in Span<u8> bytes, in u32 glyphCount){
        this.m_reader = FontAtlasOtTableReader(bytes, glyphCount);
    }

    public b8 gpos(){
        if(!this.m_reader.range(0u, s_FontAtlasGposHeaderBytes) || this.m_reader.u16At(0u) != 1u || this.m_reader.u16At(s_FontAtlasOtMinorVersionOffset) > 1u)
            return false;
        const u64 scripts = cast<u64>(this.m_reader.u16At(s_FontAtlasGposScriptListOffset));
        const u64 features = cast<u64>(this.m_reader.u16At(s_FontAtlasGposFeatureListOffset));
        const u64 lookups = cast<u64>(this.m_reader.u16At(s_FontAtlasGposLookupListOffset));
        if(scripts < s_FontAtlasGposHeaderBytes || features < s_FontAtlasGposHeaderBytes || lookups < s_FontAtlasGposHeaderBytes || !this.m_reader.range(features, s_FontAtlasOtU16Bytes) || !this.m_reader.range(lookups, s_FontAtlasOtU16Bytes))
            return false;
        const u32 featureCount = cast<u32>(this.m_reader.u16At(features));
        const u32 lookupCount = cast<u32>(this.m_reader.u16At(lookups));
        if(!this.scriptList(scripts, featureCount) || !this.featureList(features, lookupCount) || !this.lookupList(lookups))
            return false;
        if(this.m_reader.u16At(s_FontAtlasOtMinorVersionOffset) == 1u){
            if(!this.m_reader.range(0u, s_FontAtlasGposHeaderV11Bytes))
                return false;
            const u64 variations = cast<u64>(this.m_reader.u32At(s_FontAtlasGposFeatureVariationsOffset));
            if(
                variations != 0u
                && (
                    !this.m_reader.range(variations, s_FontAtlasFeatureVariationsHeaderBytes)
                    || this.m_reader.u16At(variations) != 1u
                    || this.m_reader.u16At(variations + s_FontAtlasOtMinorVersionOffset) != 0u
                    || !this.m_reader.range(variations + s_FontAtlasFeatureVariationsHeaderBytes, cast<u64>(this.m_reader.u32At(variations + s_FontAtlasFeatureVariationsCountOffset)) * s_FontAtlasFeatureVariationRecordBytes)
                )
            )
                return false;
        }
        return true;
    }

    private FontAtlasOtTableReader m_reader;

    private u32 valueSize(in u16 format)const{
        u32 bitCount = 0u;
        const u32 masked = cast<u32>(format) & s_FontAtlasValueFormatFieldMask;
        for(u32 bit = 0u; bit < s_FontAtlasValueFormatFieldBitCount; ++bit)
            if((masked & (1u << bit)) != 0u)
                ++bitCount;
        return bitCount * s_FontAtlasOtU16Bytes;
    }

    private b8 value(in u64 offset, in u16 format, in u64 parent){
        if((cast<u32>(format) & s_FontAtlasValueFormatReservedMask) != 0u || !this.m_reader.range(offset, this.valueSize(format)))
            return false;
        u32 field = 0u;
        for(u32 bit = 0u; bit < s_FontAtlasValueFormatFieldBitCount; ++bit){
            if((cast<u32>(format) & (1u << bit)) == 0u)
                continue;
            if(bit >= s_FontAtlasValueFormatFirstDeviceBit && !this.m_reader.device(parent, cast<u32>(this.m_reader.u16At(offset + field))))
                return false;
            field += s_FontAtlasOtU16Bytes;
        }
        return true;
    }

    private b8 langSys(in u64 offset, in u32 featureCount){
        if(!this.m_reader.range(offset, s_FontAtlasLangSysHeaderBytes) || this.m_reader.u16At(offset) != 0u)
            return false;
        const u32 required = cast<u32>(this.m_reader.u16At(offset + s_FontAtlasLangSysRequiredFeatureOffset));
        const u32 count = cast<u32>(this.m_reader.u16At(offset + s_FontAtlasLangSysFeatureCountOffset));
        if((required != s_FontAtlasLangSysNoRequiredFeature && required >= featureCount) || !this.m_reader.range(offset + s_FontAtlasLangSysHeaderBytes, cast<u64>(count) * s_FontAtlasOtU16Bytes) || !this.m_reader.spend(count))
            return false;
        for(u32 index = 0u; index < count; ++index)
            if(cast<u32>(this.m_reader.u16At(offset + s_FontAtlasLangSysHeaderBytes + cast<u64>(index) * s_FontAtlasOtU16Bytes)) >= featureCount)
                return false;
        return true;
    }

    private b8 scriptList(in u64 offset, in u32 featureCount){
        if(!this.m_reader.range(offset, s_FontAtlasOtU16Bytes))
            return false;
        const u32 count = cast<u32>(this.m_reader.u16At(offset));
        if(!this.m_reader.range(offset + s_FontAtlasOtU16Bytes, cast<u64>(count) * s_FontAtlasOtTagRecordBytes) || !this.m_reader.spend(count))
            return false;
        for(u32 index = 0u; index < count; ++index){
            const u32 displacement = cast<u32>(this.m_reader.u16At(offset + s_FontAtlasOtTagListFirstOffsetField + cast<u64>(index) * s_FontAtlasOtTagRecordBytes));
            const u64 script = offset + displacement;
            if(displacement == 0u || !this.m_reader.range(script, s_FontAtlasScriptHeaderBytes))
                return false;
            const u32 defaultLang = cast<u32>(this.m_reader.u16At(script));
            const u32 languageCount = cast<u32>(this.m_reader.u16At(script + s_FontAtlasScriptLangSysCountOffset));
            if((defaultLang != 0u && !this.langSys(script + defaultLang, featureCount)) || !this.m_reader.range(script + s_FontAtlasScriptHeaderBytes, cast<u64>(languageCount) * s_FontAtlasOtTagRecordBytes))
                return false;
            for(u32 language = 0u; language < languageCount; ++language){
                const u32 delta = cast<u32>(this.m_reader.u16At(script + s_FontAtlasScriptFirstLangSysOffsetField + cast<u64>(language) * s_FontAtlasOtTagRecordBytes));
                if(delta == 0u || !this.langSys(script + delta, featureCount))
                    return false;
            }
        }
        return true;
    }

    private b8 featureList(in u64 offset, in u32 lookupCount){
        if(!this.m_reader.range(offset, s_FontAtlasOtU16Bytes))
            return false;
        const u32 count = cast<u32>(this.m_reader.u16At(offset));
        if(!this.m_reader.range(offset + s_FontAtlasOtU16Bytes, cast<u64>(count) * s_FontAtlasOtTagRecordBytes) || !this.m_reader.spend(count))
            return false;
        for(u32 index = 0u; index < count; ++index){
            const u32 delta = cast<u32>(this.m_reader.u16At(offset + s_FontAtlasOtTagListFirstOffsetField + cast<u64>(index) * s_FontAtlasOtTagRecordBytes));
            const u64 feature = offset + delta;
            if(delta == 0u || !this.m_reader.range(feature, s_FontAtlasFeatureHeaderBytes))
                return false;
            const u32 params = cast<u32>(this.m_reader.u16At(feature));
            const u32 itemCount = cast<u32>(this.m_reader.u16At(feature + s_FontAtlasFeatureLookupCountOffset));
            if((params != 0u && !this.m_reader.range(feature + params, s_FontAtlasFeatureParamsMinBytes)) || !this.m_reader.range(feature + s_FontAtlasFeatureHeaderBytes, cast<u64>(itemCount) * s_FontAtlasOtU16Bytes) || !this.m_reader.spend(itemCount))
                return false;
            for(u32 item = 0u; item < itemCount; ++item)
                if(cast<u32>(this.m_reader.u16At(feature + s_FontAtlasFeatureHeaderBytes + cast<u64>(item) * s_FontAtlasOtU16Bytes)) >= lookupCount)
                    return false;
        }
        return true;
    }

    private b8 pairPos(in u64 offset){
        if(!this.m_reader.range(offset, s_FontAtlasPairPosSetHeaderBytes))
            return false;
        const u16 format = this.m_reader.u16At(offset);
        const u16 firstFormat = this.m_reader.u16At(offset + s_FontAtlasPairPosValueFormat1Offset);
        const u16 secondFormat = this.m_reader.u16At(offset + s_FontAtlasPairPosValueFormat2Offset);
        if(this.m_reader.u16At(offset + s_FontAtlasPosCoverageOffset) == 0u)
            return false;
        const Expected<u32> coverageCount = this.m_reader.coverage(offset + this.m_reader.u16At(offset + s_FontAtlasPosCoverageOffset));
        if(!coverageCount.has_value() || (cast<u32>(firstFormat | secondFormat) & s_FontAtlasValueFormatReservedMask) != 0u)
            return false;
        const u32 stride = this.valueSize(firstFormat) + this.valueSize(secondFormat);
        if(format == 1u){
            const u32 count = cast<u32>(this.m_reader.u16At(offset + s_FontAtlasPairPosSetCountOffset));
            if(count != coverageCount.value() || !this.m_reader.range(offset + s_FontAtlasPairPosSetHeaderBytes, cast<u64>(count) * s_FontAtlasOtU16Bytes))
                return false;
            for(u32 index = 0u; index < count; ++index){
                const u32 delta = cast<u32>(this.m_reader.u16At(offset + s_FontAtlasPairPosSetHeaderBytes + cast<u64>(index) * s_FontAtlasOtU16Bytes));
                const u64 set = offset + delta;
                if(delta == 0u || !this.m_reader.range(set, s_FontAtlasOtU16Bytes))
                    return false;
                const u32 pairs = cast<u32>(this.m_reader.u16At(set));
                if(!this.m_reader.range(set + s_FontAtlasOtU16Bytes, cast<u64>(pairs) * (stride + s_FontAtlasOtU16Bytes)) || !this.m_reader.spend(pairs))
                    return false;
                u32 previous = 0u;
                for(u32 pair = 0u; pair < pairs; ++pair){
                    const u64 record = set + s_FontAtlasOtU16Bytes + cast<u64>(pair) * (stride + s_FontAtlasOtU16Bytes);
                    const u32 second = cast<u32>(this.m_reader.u16At(record));
                    if(second >= this.m_reader.glyphCount() || (pair > 0u && second <= previous) || !this.value(record + s_FontAtlasOtU16Bytes, firstFormat, set) || !this.value(record + s_FontAtlasOtU16Bytes + this.valueSize(firstFormat), secondFormat, set))
                        return false;
                    previous = second;
                }
            }
            return true;
        }
        if(format != s_FontAtlasPairPosClassFormat || !this.m_reader.range(offset, s_FontAtlasPairPosClassHeaderBytes))
            return false;
        const u32 firstClasses = cast<u32>(this.m_reader.u16At(offset + s_FontAtlasPairPosClass1CountOffset));
        const u32 secondClasses = cast<u32>(this.m_reader.u16At(offset + s_FontAtlasPairPosClass2CountOffset));
        const u64 pairs = cast<u64>(firstClasses) * secondClasses;
        if(
            firstClasses == 0u
            || secondClasses == 0u
            || pairs > s_FontAtlasPairPosMaxClassPairs
            || this.m_reader.u16At(offset + s_FontAtlasPairPosClassDef1Offset) == 0u
            || this.m_reader.u16At(offset + s_FontAtlasPairPosClassDef2Offset) == 0u
            || !this.m_reader.classDef(offset + this.m_reader.u16At(offset + s_FontAtlasPairPosClassDef1Offset), firstClasses)
            || !this.m_reader.classDef(offset + this.m_reader.u16At(offset + s_FontAtlasPairPosClassDef2Offset), secondClasses)
            || !this.m_reader.range(offset + s_FontAtlasPairPosClassHeaderBytes, pairs * stride)
            || !this.m_reader.spend(cast<u32>(pairs))
        )
            return false;
        for(u32 pair = 0u; pair < cast<u32>(pairs); ++pair){
            const u64 record = offset + s_FontAtlasPairPosClassHeaderBytes + cast<u64>(pair) * stride;
            if(!this.value(record, firstFormat, offset) || !this.value(record + this.valueSize(firstFormat), secondFormat, offset))
                return false;
        }
        return true;
    }

    private b8 subtable(in u64 offset, in u32 type){
        if(!this.m_reader.range(offset, s_FontAtlasPosSubtableHeaderBytes))
            return false;
        if(type == s_FontAtlasGposExtensionLookupType){
            if(this.m_reader.u16At(offset) != 1u || !this.m_reader.range(offset, s_FontAtlasExtensionPosBytes))
                return false;
            const u32 actualType = cast<u32>(this.m_reader.u16At(offset + s_FontAtlasExtensionPosTypeOffset));
            const u32 delta = this.m_reader.u32At(offset + s_FontAtlasExtensionPosOffsetField);
            return actualType >= 1u && actualType <= s_FontAtlasGposChainedContextLookupType && delta != 0u && this.subtable(offset + delta, actualType);
        }
        if(type == s_FontAtlasGposPairLookupType)
            return this.pairPos(offset);
        const u32 format = cast<u32>(this.m_reader.u16At(offset));
        if(type == 1u){
            if(!this.m_reader.range(offset, s_FontAtlasSinglePosHeaderBytes))
                return false;
            const u16 valueFormat = this.m_reader.u16At(offset + s_FontAtlasSinglePosValueFormatOffset);
            if(this.m_reader.u16At(offset + s_FontAtlasPosCoverageOffset) == 0u)
                return false;
            const Expected<u32> count = this.m_reader.coverage(offset + this.m_reader.u16At(offset + s_FontAtlasPosCoverageOffset));
            if(!count.has_value())
                return false;
            if(format == 1u)
                return this.value(offset + s_FontAtlasSinglePosHeaderBytes, valueFormat, offset);
            if(format != s_FontAtlasSinglePosArrayFormat || !this.m_reader.range(offset, s_FontAtlasSinglePosArrayHeaderBytes) || count.value() != cast<u32>(this.m_reader.u16At(offset + s_FontAtlasSinglePosValueCountOffset)) || !this.m_reader.spend(count.value()))
                return false;
            for(u32 index = 0u; index < count.value(); ++index)
                if(!this.value(offset + s_FontAtlasSinglePosArrayHeaderBytes + cast<u64>(index) * this.valueSize(valueFormat), valueFormat, offset))
                    return false;
            return true;
        }
        // Non-pair positioning is retained opaque after bounded format/root admission; runtime executes the source font.
        if(type >= s_FontAtlasGposCursiveLookupType && type <= s_FontAtlasGposMarkMarkLookupType)
            return format == 1u && this.m_reader.u16At(offset + s_FontAtlasPosCoverageOffset) != 0u && this.m_reader.coverage(offset + this.m_reader.u16At(offset + s_FontAtlasPosCoverageOffset)).has_value();
        return (type == s_FontAtlasGposContextLookupType || type == s_FontAtlasGposChainedContextLookupType) && format >= 1u && format <= s_FontAtlasContextMaxFormat;
    }

    private b8 lookupList(in u64 offset){
        if(!this.m_reader.range(offset, s_FontAtlasOtU16Bytes))
            return false;
        const u32 count = cast<u32>(this.m_reader.u16At(offset));
        if(!this.m_reader.range(offset + s_FontAtlasOtU16Bytes, cast<u64>(count) * s_FontAtlasOtU16Bytes) || !this.m_reader.spend(count))
            return false;
        for(u32 index = 0u; index < count; ++index){
            const u32 delta = cast<u32>(this.m_reader.u16At(offset + s_FontAtlasOtU16Bytes + cast<u64>(index) * s_FontAtlasOtU16Bytes));
            const u64 lookup = offset + delta;
            if(delta == 0u || !this.m_reader.range(lookup, s_FontAtlasLookupHeaderBytes))
                return false;
            const u32 type = cast<u32>(this.m_reader.u16At(lookup));
            const u32 flags = cast<u32>(this.m_reader.u16At(lookup + s_FontAtlasLookupFlagOffset));
            const u32 itemCount = cast<u32>(this.m_reader.u16At(lookup + s_FontAtlasLookupSubtableCountOffset));
            u64 filterBytes = 0u;
            if((flags & s_FontAtlasLookupFlagUseMarkFilteringSet) != 0u)
                filterBytes = s_FontAtlasOtU16Bytes;
            if(type < 1u || type > s_FontAtlasGposExtensionLookupType || (flags & s_FontAtlasLookupFlagReservedMask) != 0u || !this.m_reader.range(lookup + s_FontAtlasLookupHeaderBytes, cast<u64>(itemCount) * s_FontAtlasOtU16Bytes + filterBytes))
                return false;
            for(u32 item = 0u; item < itemCount; ++item){
                const u32 displacement = cast<u32>(this.m_reader.u16At(lookup + s_FontAtlasLookupHeaderBytes + cast<u64>(item) * s_FontAtlasOtU16Bytes));
                if(displacement == 0u || !this.subtable(lookup + displacement, type))
                    return false;
            }
        }
        return true;
    }
}

b8 ValidateFontAtlasPositioningTableBytes(in u32 tag, in Span<u8> bytes, in u32 glyphCount){
    if(bytes.empty() || bytes.size() > s_FontAtlasMaxPositioningBytes || glyphCount == 0u || glyphCount > s_FontAtlasMaxGlyphCount)
        return false;
    FontAtlasTableValidator validator(bytes, glyphCount);
    b8 valid = false;
    if(tag == s_FontAtlasKernTag)
        valid = ValidateFontAtlasKernTableBytes(bytes, glyphCount);
    else if(tag == s_FontAtlasGposTag)
        valid = validator.gpos();
    else if(tag == s_FontAtlasGdefTag)
        valid = ValidateFontAtlasGdefTableBytes(bytes, glyphCount);
    if(!valid){
        error("font_atlas: invalid or over-budget raw positioning table {}", tag);
    }
    return valid;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

