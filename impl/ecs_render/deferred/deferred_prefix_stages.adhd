#include <impl/ecs_render/deferred/import_types.adhd>
#include <impl/ecs_render/material/task_graph_resource_sets.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<GpuGraphResourceSetId> GatherOpaqueGbufferGeometrySet(in MaterialPassDrawItemPartitions drawItems, mut GpuTaskGraph graph){
    const Array<MaterialPassDrawItemsView, 2u> drawSets(MaterialPassDrawItemsView(drawItems.regular), MaterialPassDrawItemsView(drawItems.csgReceiverSurface));
    return GatherPreparedMaterialGeometryResourceSet(drawSets, s_GbufferMaterialGeometrySet, "Opaque Material Geometry", graph);
}

Expected<GpuGraphResourceSetId> GatherOpaqueGbufferSampledTextureSet(
    in MaterialPassDrawItemPartitions drawItems,
    in RendererMaterialSystem materialSystem,
    mut GpuTaskGraph graph
){
    const Array<MaterialPassDrawItemsView, 2u> drawSets(MaterialPassDrawItemsView(drawItems.regular), MaterialPassDrawItemsView(drawItems.csgReceiverSurface));
    return GatherPreparedMaterialSampledTextureResourceSet(materialSystem, drawSets, s_FrameGraphNameRenderGraphicsPrefixGbufferMaterialSampledTextures, "Opaque Material Sampled Textures", graph);
}


