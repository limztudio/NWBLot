extern const u32 s_ShaderSurfelGuideFloat4SPerSurfel;

[cpp_header("<impl/assets/graphics/gi/surfel/surfel_binding_slots.h>"), cpp_name("NWB_SURFEL_TRACE_INDIRECT_ARGS_WORD_COUNT")]
extern const u32 s_ShaderSurfelTraceIndirectArgsWordCount;


