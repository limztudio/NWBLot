#include "validation.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ReportPaintClipRecordingOff(){
    error("PaintSystem: paint clip pushed while recording is off");
}

void ReportPaintClipPopRecordingOff(){
    error("PaintSystem: paint clip popped while recording is off");
}

void ReportPaintQuadRecordingOff(){
    error("PaintSystem: paint quad emitted while recording is off");
}

void ReportPaintQuadInvalidColor(){
    error("PaintSystem: paint quad color is invalid");
}

void ReportPaintLineRecordingOff(){
    error("PaintSystem: paint line emitted while recording is off");
}

void ReportPaintLineInvalidColor(){
    error("PaintSystem: paint line color is invalid");
}

void ReservePaintSnapshot(
    in usize quadCount,
    in usize clipDepth,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut Vector<PaintClipEntry> clips
){
    if(quadCount > cast<usize>(u32.max / s_PaintQuadIndexCount) || clipDepth == usize.max){
        assert(false);
        return;
    }
    vertices.reserve(quadCount * cast<usize>(s_PaintQuadVertexCount));
    indices.reserve(quadCount * cast<usize>(s_PaintQuadIndexCount));
    commands.reserve(quadCount);
    clips.reserve(clipDepth + 1u);
}

PaintClipEntry ComputeIntersectedPaintClipEntry(in PaintClipEntry parent, in Rect clip, in b8 validateParent){
    PaintClipEntry next;
    if(parent.rect.width < 0.0f || parent.rect.height < 0.0f || clip.width < 0.0f || clip.height < 0.0f)
        return next;
    const VectorSingle clipOrigin(clip.x, clip.y, 0.0f, 0.0f);
    const VectorSingle clipEnd = VectorSingle(clip.width, clip.height, 0.0f, 0.0f) + clipOrigin;
    if(!IsFinite(VectorSingle(clip.x, clip.y, clipEnd.x, clipEnd.y)))
        return next;
    if(validateParent && !IsFinite(VectorSingle(parent.right, parent.bottom, 0.0f, 0.0f)))
        return next;
    const VectorSingle parentBounds(parent.rect.x, parent.rect.y, parent.right, parent.bottom);
    const VectorSingle curBounds(clip.x, clip.y, clipEnd.x, clipEnd.y);
    const VectorSingle maxOrigin = VectorSelect(curBounds, parentBounds, VectorGreater(parentBounds, curBounds));
    const VectorSingle minEnd = VectorSelect(curBounds, parentBounds, VectorLess(parentBounds, curBounds));
    const VectorSingle zeroVec(0.0f);
    const VectorSingle rawSize(minEnd.z - maxOrigin.x, minEnd.w - maxOrigin.y, 0.0f, 0.0f);
    const VectorSingle clampedSize = VectorSelect(zeroVec, rawSize, VectorGreater(rawSize, zeroVec));
    const f32 x0 = maxOrigin.x;
    const f32 y0 = maxOrigin.y;
    const f32 w = clampedSize.x;
    const f32 h = clampedSize.y;
    if(IsFinite(VectorSingle(w, h, 0.0f, 0.0f))){
        next.rect = Rect(x0, y0, w, h);
        const VectorSingle outEnd = VectorSingle(x0, y0, 0.0f, 0.0f) + VectorSingle(w, h, 0.0f, 0.0f);
        next.right = outEnd.x;
        next.bottom = outEnd.y;
    }
    return next;
}

void PushPaintClip(in b8 recording, in Rect clip, mut Vector<PaintClipEntry> clips){
    if(!recording){
        ReportPaintClipRecordingOff();
        return;
    }
    clips.push_back(ComputeIntersectedPaintClipEntry(clips.back(), clip, true));
}

void PushPaintClipValidatedParent(in b8 recording, in Rect clip, mut Vector<PaintClipEntry> clips){
    if(!recording){
        ReportPaintClipRecordingOff();
        return;
    }
    clips.push_back(ComputeIntersectedPaintClipEntry(clips.back(), clip, false));
}

b8 PopPaintClip(
    in b8 recording,
    in usize overlayDepth,
    in Array<PaintOverlayFrame, s_PaintMaxOverlayDepth> overlays,
    mut Vector<PaintClipEntry> clips
){
    if(!recording){
        ReportPaintClipPopRecordingOff();
        return false;
    }
    if(clips.size() <= 1u || (overlayDepth != 0u && clips.size() <= overlays[overlayDepth - 1u].clipDepth + 1u))
        return false;
    clips.pop_back();
    return true;
}

b8 BeginPaintOverlay(
    in b8 recording,
    in u32 layer,
    in DisplayMetrics display,
    mut Array<PaintOverlayFrame, s_PaintMaxOverlayDepth> overlays,
    mut usize inOutOverlayDepth,
    mut u32 inOutLayer,
    mut Vector<PaintClipEntry> clips
){
    if(!recording || layer == 0u || inOutOverlayDepth == s_PaintMaxOverlayDepth)
        return false;
    PaintOverlayFrame frame;
    frame.clipDepth = clips.size();
    frame.layer = inOutLayer;
    overlays[inOutOverlayDepth] = frame;
    ++inOutOverlayDepth;
    PaintClipEntry rootClip;
    rootClip.rect = Rect(0.0f, 0.0f, display.logicalWidth, display.logicalHeight);
    rootClip.right = display.logicalWidth;
    rootClip.bottom = display.logicalHeight;
    clips.push_back(rootClip);
    inOutLayer = layer;
    return true;
}

b8 EndPaintOverlay(
    in b8 recording,
    in Array<PaintOverlayFrame, s_PaintMaxOverlayDepth> overlays,
    mut usize inOutOverlayDepth,
    mut u32 outLayer,
    mut Vector<PaintClipEntry> clips
){
    if(!recording || inOutOverlayDepth == 0u || clips.size() != overlays[inOutOverlayDepth - 1u].clipDepth + 1u)
        return false;
    clips.pop_back();
    --inOutOverlayDepth;
    outLayer = overlays[inOutOverlayDepth].layer;
    return true;
}

void EmitPaintQuadImpl(
    in b8 recording,
    in b8 clipValidated,
    in PaintClipEntry clipEntry,
    in Rect rectangle,
    in Rect uv,
    in Color color,
    in PaintMaterial material,
    in u32 layer,
    in u32 glyphPageIndex,
    in u32 sdfPageIndex,
    in u32 sdfChannel,
    in u32 textureImageIndex,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered,
    mut b8 inOutCommandsStrictlyDescending
){
    if(!recording){
        ReportPaintQuadRecordingOff();
        return;
    }
    if(!IsFinite(VectorSingle(color.r, color.g, color.b, color.a)) || color.a < 0.0f || color.a > 1.0f){
        ReportPaintQuadInvalidColor();
        return;
    }
    if(!(rectangle.width > 0.0f) || !(rectangle.height > 0.0f) || !(clipEntry.rect.width > 0.0f) || !(clipEntry.rect.height > 0.0f))
        return;
    const VectorSingle rectOrigin(rectangle.x, rectangle.y, 0.0f, 0.0f);
    const VectorSingle rectEnd = rectOrigin + VectorSingle(rectangle.width, rectangle.height, 0.0f, 0.0f);
    if(!IsFinite(rectEnd.xy))
        return;
    if(!clipValidated && !IsFinite(VectorSingle(clipEntry.right, clipEntry.bottom, 0.0f, 0.0f).xy))
        return;
    const VectorSingle clipOrigin(clipEntry.rect.x, clipEntry.rect.y, 0.0f, 0.0f);
    const VectorSingle clipEnd(clipEntry.right, clipEntry.bottom, 0.0f, 0.0f);
    const VectorSingle clippedOrigin = VectorSelect(rectOrigin, clipOrigin, VectorGreater(clipOrigin, rectOrigin));
    const VectorSingle clippedEnd = VectorSelect(rectEnd, clipEnd, VectorLess(clipEnd, rectEnd));
    const VectorSingle visSize = clippedEnd - clippedOrigin;
    const f32 x0 = clippedOrigin.x;
    const f32 y0 = clippedOrigin.y;
    const f32 visW = visSize.x;
    const f32 visH = visSize.y;
    if(!(visW > 0.0f) || !(visH > 0.0f) || !IsFinite(visSize.xy) || color.a <= 0.0f)
        return;
    const VectorSingle visEnd = clippedOrigin + visSize;
    const f32 visEndX = visEnd.x;
    const f32 visEndY = visEnd.y;
    if(!IsFinite(visEnd.xy))
        return;
    if(vertices.size() > cast<usize>(u32.max - s_PaintQuadVertexCount) || indices.size() > cast<usize>(u32.max - s_PaintQuadIndexCount)){
        assert(false);
        return;
    }
    f32 left = 0.0f;
    f32 top = 0.0f;
    f32 right = 0.0f;
    f32 bottom = 0.0f;
    if(material != PaintMaterial::Solid && (uv.width != 0.0f || uv.height != 0.0f || uv.x != 0.0f || uv.y != 0.0f)){
        if(x0 == rectangle.x && y0 == rectangle.y && visW == rectangle.width && visH == rectangle.height && visEndX == rectEnd.x && visEndY == rectEnd.y){
            left = uv.x;
            top = uv.y;
            right = uv.x + uv.width;
            bottom = uv.y + uv.height;
        }
        else{
            const VectorSingle uvEdges = ((VectorSingle(x0, y0, visEndX, visEndY) - VectorSingle(rectangle.x, rectangle.y, rectangle.x, rectangle.y)) / VectorSingle(rectangle.width, rectangle.height, rectangle.width, rectangle.height)) * VectorSingle(uv.width, uv.height, uv.width, uv.height) + VectorSingle(uv.x, uv.y, uv.x, uv.y);
            left = uvEdges.x;
            top = uvEdges.y;
            right = uvEdges.z;
            bottom = uvEdges.w;
        }
    }
    Color premultiplied = color;
    if(color.a != 1.0f){
        const VectorSingle premul = VectorSingle(color.r, color.g, color.b, 0.0f) * color.a;
        premultiplied = Color(premul.x, premul.y, premul.z, color.a);
    }
    const u32 vertexBase = cast<u32>(vertices.size());
    const u32 firstIndex = cast<u32>(indices.size());
    vertices.push_back(Vertex(Point(x0, y0), Point(left, top), premultiplied));
    vertices.push_back(Vertex(Point(visEndX, y0), Point(right, top), premultiplied));
    vertices.push_back(Vertex(Point(visEndX, visEndY), Point(right, bottom), premultiplied));
    vertices.push_back(Vertex(Point(x0, visEndY), Point(left, bottom), premultiplied));
    indices.push_back(vertexBase);
    indices.push_back(vertexBase + 1u);
    indices.push_back(vertexBase + 2u);
    indices.push_back(vertexBase);
    indices.push_back(vertexBase + 2u);
    indices.push_back(vertexBase + 3u);
    if(!commands.empty()){
        const usize lastIndex = commands.size() - 1u;
        in DrawCommand previous = commands[lastIndex];
        if(
            previous.layer == layer && previous.material == material && previous.glyphPageIndex == glyphPageIndex
            && previous.sdfPageIndex == sdfPageIndex && previous.sdfChannel == sdfChannel
            && previous.textureImageIndex == textureImageIndex
            && EqualUiRect(previous.clip, clipEntry.rect)
        ){
            commands[lastIndex].indexCount += s_PaintQuadIndexCount;
            return;
        }
        if(previous.layer > layer)
            inOutCommandsOrdered = false;
        else
            inOutCommandsStrictlyDescending = false;
    }
    DrawCommand command;
    command.firstIndex = firstIndex;
    command.indexCount = s_PaintQuadIndexCount;
    command.clip = clipEntry.rect;
    command.material = material;
    command.glyphPageIndex = glyphPageIndex;
    command.sdfPageIndex = sdfPageIndex;
    command.sdfChannel = sdfChannel;
    command.layer = layer;
    command.textureImageIndex = textureImageIndex;
    commands.push_back(command);
}

void EmitPaintQuad(
    in b8 recording,
    in PaintClipEntry clip,
    in Rect rectangle,
    in Rect uv,
    in Color color,
    in PaintMaterial material,
    in u32 layer,
    in u32 glyphPageIndex,
    in u32 sdfPageIndex,
    in u32 sdfChannel,
    in u32 textureImageIndex,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered,
    mut b8 inOutCommandsStrictlyDescending
){
    EmitPaintQuadImpl(
        recording, false, clip, rectangle, uv, color, material, layer,
        glyphPageIndex, sdfPageIndex, sdfChannel, textureImageIndex,
        vertices, indices, commands, inOutCommandsOrdered, inOutCommandsStrictlyDescending
    );
}

void EmitPaintQuadValidated(
    in b8 recording,
    in PaintClipEntry clip,
    in Rect rectangle,
    in Rect uv,
    in Color color,
    in PaintMaterial material,
    in u32 layer,
    in u32 glyphPageIndex,
    in u32 sdfPageIndex,
    in u32 sdfChannel,
    in u32 textureImageIndex,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered,
    mut b8 inOutCommandsStrictlyDescending
){
    EmitPaintQuadImpl(
        recording, true, clip, rectangle, uv, color, material, layer,
        glyphPageIndex, sdfPageIndex, sdfChannel, textureImageIndex,
        vertices, indices, commands, inOutCommandsOrdered, inOutCommandsStrictlyDescending
    );
}

void EmitPaintOpaqueWhiteRectValidated(
    in b8 recording,
    in PaintClipEntry clipEntry,
    in Rect rectangle,
    in u32 layer,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered,
    mut b8 inOutCommandsStrictlyDescending
){
    if(!recording){
        ReportPaintQuadRecordingOff();
        return;
    }
    if(!(rectangle.width > 0.0f) || !(rectangle.height > 0.0f) || !(clipEntry.rect.width > 0.0f) || !(clipEntry.rect.height > 0.0f))
        return;
    const VectorSingle rectOrigin(rectangle.x, rectangle.y, 0.0f, 0.0f);
    const VectorSingle rectEnd = rectOrigin + VectorSingle(rectangle.width, rectangle.height, 0.0f, 0.0f);
    if(!IsFinite(rectEnd.xy))
        return;
    const VectorSingle clipOrigin(clipEntry.rect.x, clipEntry.rect.y, 0.0f, 0.0f);
    const VectorSingle clipEnd(clipEntry.right, clipEntry.bottom, 0.0f, 0.0f);
    const VectorSingle clippedOrigin = VectorSelect(rectOrigin, clipOrigin, VectorGreater(clipOrigin, rectOrigin));
    const VectorSingle clippedEnd = VectorSelect(rectEnd, clipEnd, VectorLess(clipEnd, rectEnd));
    const VectorSingle visSize = clippedEnd - clippedOrigin;
    const f32 x0 = clippedOrigin.x;
    const f32 y0 = clippedOrigin.y;
    const f32 x1 = clippedEnd.x;
    const f32 y1 = clippedEnd.y;
    const f32 visW = visSize.x;
    const f32 visH = visSize.y;
    if(!(visW > 0.0f) || !(visH > 0.0f) || !IsFinite(visSize.xy))
        return;
    if(vertices.size() > cast<usize>(u32.max - s_PaintQuadVertexCount) || indices.size() > cast<usize>(u32.max - s_PaintQuadIndexCount)){
        assert(false);
        return;
    }
    const Color opaqueWhite = Color();
    const u32 vertexBase = cast<u32>(vertices.size());
    const u32 firstIndex = cast<u32>(indices.size());
    vertices.push_back(Vertex(Point(x0, y0), Point(0.0f, 0.0f), opaqueWhite));
    vertices.push_back(Vertex(Point(x1, y0), Point(0.0f, 0.0f), opaqueWhite));
    vertices.push_back(Vertex(Point(x1, y1), Point(0.0f, 0.0f), opaqueWhite));
    vertices.push_back(Vertex(Point(x0, y1), Point(0.0f, 0.0f), opaqueWhite));
    indices.push_back(vertexBase);
    indices.push_back(vertexBase + 1u);
    indices.push_back(vertexBase + 2u);
    indices.push_back(vertexBase);
    indices.push_back(vertexBase + 2u);
    indices.push_back(vertexBase + 3u);
    if(!commands.empty()){
        const usize lastIndex = commands.size() - 1u;
        in DrawCommand previous = commands[lastIndex];
        if(previous.layer == layer && previous.material == PaintMaterial::Solid && EqualUiRect(previous.clip, clipEntry.rect)){
            commands[lastIndex].indexCount += s_PaintQuadIndexCount;
            return;
        }
        if(previous.layer > layer)
            inOutCommandsOrdered = false;
        else
            inOutCommandsStrictlyDescending = false;
    }
    DrawCommand command;
    command.firstIndex = firstIndex;
    command.indexCount = s_PaintQuadIndexCount;
    command.clip = clipEntry.rect;
    command.material = PaintMaterial::Solid;
    command.glyphPageIndex = u32.max;
    command.sdfPageIndex = u32.max;
    command.sdfChannel = 0u;
    command.layer = layer;
    command.textureImageIndex = u32.max;
    commands.push_back(command);
}

void EmitPaintSolidQuadValidated(
    in b8 recording,
    in PaintClipEntry clipEntry,
    in Rect rectangle,
    in Color color,
    in u32 layer,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered,
    mut b8 inOutCommandsStrictlyDescending
){
    if(!recording){
        ReportPaintQuadRecordingOff();
        return;
    }
    if(!IsFinite(VectorSingle(color.r, color.g, color.b, color.a)) || color.a < 0.0f || color.a > 1.0f){
        ReportPaintQuadInvalidColor();
        return;
    }
    if(!(rectangle.width > 0.0f) || !(rectangle.height > 0.0f) || !(clipEntry.rect.width > 0.0f) || !(clipEntry.rect.height > 0.0f) || color.a <= 0.0f)
        return;
    const VectorSingle rectOrigin(rectangle.x, rectangle.y, 0.0f, 0.0f);
    const VectorSingle rectEnd = rectOrigin + VectorSingle(rectangle.width, rectangle.height, 0.0f, 0.0f);
    if(!IsFinite(rectEnd.xy))
        return;
    const VectorSingle clipOrigin(clipEntry.rect.x, clipEntry.rect.y, 0.0f, 0.0f);
    const VectorSingle clipEnd(clipEntry.right, clipEntry.bottom, 0.0f, 0.0f);
    const VectorSingle clippedOrigin = VectorSelect(rectOrigin, clipOrigin, VectorGreater(clipOrigin, rectOrigin));
    const VectorSingle clippedEnd = VectorSelect(rectEnd, clipEnd, VectorLess(clipEnd, rectEnd));
    const VectorSingle visSize = clippedEnd - clippedOrigin;
    const f32 x0 = clippedOrigin.x;
    const f32 y0 = clippedOrigin.y;
    const f32 x1 = clippedEnd.x;
    const f32 y1 = clippedEnd.y;
    const f32 visW = visSize.x;
    const f32 visH = visSize.y;
    if(!(visW > 0.0f) || !(visH > 0.0f) || !IsFinite(visSize.xy))
        return;
    if(vertices.size() > cast<usize>(u32.max - s_PaintQuadVertexCount) || indices.size() > cast<usize>(u32.max - s_PaintQuadIndexCount)){
        assert(false);
        return;
    }
    Color premultiplied = color;
    if(color.a != 1.0f){
        const VectorSingle premul = VectorSingle(color.r, color.g, color.b, 1.0f) * VectorSingle(color.a);
        premultiplied = Color(premul.x, premul.y, premul.z, premul.w);
    }
    const u32 vertexBase = cast<u32>(vertices.size());
    const u32 firstIndex = cast<u32>(indices.size());
    vertices.push_back(Vertex(Point(x0, y0), Point(0.0f, 0.0f), premultiplied));
    vertices.push_back(Vertex(Point(x1, y0), Point(0.0f, 0.0f), premultiplied));
    vertices.push_back(Vertex(Point(x1, y1), Point(0.0f, 0.0f), premultiplied));
    vertices.push_back(Vertex(Point(x0, y1), Point(0.0f, 0.0f), premultiplied));
    indices.push_back(vertexBase);
    indices.push_back(vertexBase + 1u);
    indices.push_back(vertexBase + 2u);
    indices.push_back(vertexBase);
    indices.push_back(vertexBase + 2u);
    indices.push_back(vertexBase + 3u);
    if(!commands.empty()){
        const usize lastIndex = commands.size() - 1u;
        in DrawCommand previous = commands[lastIndex];
        if(previous.layer == layer && previous.material == PaintMaterial::Solid && EqualUiRect(previous.clip, clipEntry.rect)){
            commands[lastIndex].indexCount += s_PaintQuadIndexCount;
            return;
        }
        if(previous.layer > layer)
            inOutCommandsOrdered = false;
        else
            inOutCommandsStrictlyDescending = false;
    }
    DrawCommand command;
    command.firstIndex = firstIndex;
    command.indexCount = s_PaintQuadIndexCount;
    command.clip = clipEntry.rect;
    command.material = PaintMaterial::Solid;
    command.glyphPageIndex = u32.max;
    command.sdfPageIndex = u32.max;
    command.sdfChannel = 0u;
    command.layer = layer;
    command.textureImageIndex = u32.max;
    commands.push_back(command);
}

void EmitPaintLine(
    in b8 recording,
    in Rect clip,
    in Point start,
    in Point end,
    in f32 thickness,
    in Color color,
    in u32 layer,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered,
    mut b8 inOutCommandsStrictlyDescending
){
    if(!recording){
        ReportPaintLineRecordingOff();
        return;
    }
    if(!IsFinite(VectorSingle(color.r, color.g, color.b, color.a)) || color.a < 0.0f || color.a > 1.0f){
        ReportPaintLineInvalidColor();
        return;
    }
    if(!(clip.width > 0.0f) || !(clip.height > 0.0f) || color.a <= 0.0f || !IsFinite(VectorSingle(thickness)) || thickness <= 0.0f)
        return;
    const VectorSingle clipEnd = VectorSingle(clip.x, clip.y, 0.0f, 0.0f) + VectorSingle(clip.width, clip.height, 0.0f, 0.0f);
    const f32 clipEndX = clipEnd.x;
    const f32 clipEndY = clipEnd.y;
    if(!IsFinite(clipEnd))
        return;
    if(!IsFinite(VectorSingle(start.x, start.y, end.x, end.y)))
        return;

    const VectorSingle startVec(start.x, start.y, 0.0f, 0.0f);
    const VectorSingle endVec(end.x, end.y, 0.0f, 0.0f);
    const VectorSingle delta = endVec - startVec;
    const f32 dx = delta.x;
    const f32 dy = delta.y;
    const f32 lenSq = dx * dx + dy * dy;
    if(!IsFinite(VectorSingle(lenSq)) || lenSq <= 1.0e-8f)
        return;

    const f32 halfW = 0.5f * thickness;
    const f32 invLen = 1.0f / VectorSqrt(VectorSingle(lenSq)).x;
    const VectorSingle normal = (VectorSingle(-dy, dx, 0.0f, 0.0f) * invLen) * halfW;
    const f32 nx = normal.x;
    const f32 ny = normal.y;
    const VectorSingle absNormal = VectorAbs(normal);
    const VectorSingle minBounds = VectorSelect(endVec, startVec, VectorLess(startVec, endVec)) - absNormal;
    const VectorSingle maxBounds = VectorSelect(endVec, startVec, VectorGreater(startVec, endVec)) + absNormal;
    const f32 minX = minBounds.x;
    const f32 maxX = maxBounds.x;
    const f32 minY = minBounds.y;
    const f32 maxY = maxBounds.y;
    if(maxX <= clip.x || maxY <= clip.y || minX >= clipEndX || minY >= clipEndY)
        return;

    if(vertices.size() > cast<usize>(u32.max - s_PaintQuadVertexCount) || indices.size() > cast<usize>(u32.max - s_PaintQuadIndexCount)){
        assert(false);
        return;
    }

    Color premultiplied = color;
    if(color.a != 1.0f){
        const VectorSingle premul = VectorSingle(color.r, color.g, color.b, 0.0f) * color.a;
        premultiplied = Color(premul.x, premul.y, premul.z, color.a);
    }
    const u32 vertexBase = cast<u32>(vertices.size());
    const u32 firstIndex = cast<u32>(indices.size());
    vertices.push_back(Vertex(Point(start.x + nx, start.y + ny), Point(0.0f, 0.0f), premultiplied));
    vertices.push_back(Vertex(Point(end.x + nx, end.y + ny), Point(0.0f, 0.0f), premultiplied));
    vertices.push_back(Vertex(Point(end.x - nx, end.y - ny), Point(0.0f, 0.0f), premultiplied));
    vertices.push_back(Vertex(Point(start.x - nx, start.y - ny), Point(0.0f, 0.0f), premultiplied));
    indices.push_back(vertexBase);
    indices.push_back(vertexBase + 1u);
    indices.push_back(vertexBase + 2u);
    indices.push_back(vertexBase);
    indices.push_back(vertexBase + 2u);
    indices.push_back(vertexBase + 3u);

    if(!commands.empty()){
        const usize lastIndex = commands.size() - 1u;
        in DrawCommand previous = commands[lastIndex];
        if(previous.layer == layer && previous.material == PaintMaterial::Solid && EqualUiRect(previous.clip, clip)){
            commands[lastIndex].indexCount += s_PaintQuadIndexCount;
            return;
        }
        if(previous.layer > layer)
            inOutCommandsOrdered = false;
        else
            inOutCommandsStrictlyDescending = false;
    }

    DrawCommand command;
    command.firstIndex = firstIndex;
    command.indexCount = s_PaintQuadIndexCount;
    command.clip = clip;
    command.material = PaintMaterial::Solid;
    command.glyphPageIndex = u32.max;
    command.sdfPageIndex = u32.max;
    command.sdfChannel = 0u;
    command.layer = layer;
    command.textureImageIndex = u32.max;
    commands.push_back(command);
}


