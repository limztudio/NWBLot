class PhysicsDepCheckEntry{
    public Name virtualPath = s_NameNone;
}

class PhysicsColliderDepEntry{
    public Name virtualPath = s_NameNone;
    public AssetRef<Mesh> meshAsset;
    public AssetRef<PhysicsMaterialAsset> materialAsset;
    public AssetRef<ConvexHullAsset> convexHullAsset;
    public AssetRef<CompoundHullAsset> compoundHullAsset;
    public AssetRef<CollisionMeshAsset> collisionMeshAsset;
    public AssetRef<HeightfieldAsset> heightfieldAsset;
    public Vector<AssetRef<Mesh>> extraMeshAssets;
    public Vector<AssetRef<PhysicsMaterialAsset>> extraMaterialAssets;
    public Vector<AssetRef<ConvexHullAsset>> extraConvexHullAssets;
    public Vector<AssetRef<CompoundHullAsset>> extraCompoundHullAssets;
    public Vector<AssetRef<CollisionMeshAsset>> extraCollisionMeshAssets;
    public Vector<AssetRef<HeightfieldAsset>> extraHeightfieldAssets;
}

class PhysicsWorldConfigDepEntry{
    public Name virtualPath = s_NameNone;
    public AssetRef<CollisionLayerMatrixAsset> collisionLayerMatrixAsset;
}

Expected<PhysicsDepCheckEntry> ParsePhysicsDepEntryWithPrefix(
    in Name virtualPath,
    in Path file,
    in MetascriptValue value,
    in StringView diagnosticPrefix,
    in b8 requireMap
){
    PhysicsDepCheckEntry entry;
    b8 validMap = false;
    if(requireMap)
        validMap = CheckMetadataAssetMap(file, value, diagnosticPrefix);
    else
        validMap = ValidateOptionalSceneMetadataMap(file, value, diagnosticPrefix);
    if(!validMap || !AssignCookEntryVirtualPath(virtualPath, file, diagnosticPrefix, entry))
        return MakeUnexpected(Failure());
    return entry;
}

Expected<PhysicsDepCheckEntry> ParseRigidBodyDepEntry(in Name virtualPath, in Path file, in MetascriptValue value){
    return ParsePhysicsDepEntryWithPrefix(virtualPath, file, value, s_RigidBodyComponentDiagnosticPrefix, false);
}

