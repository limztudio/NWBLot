#include <impl/ecs_render/reflection/frame_snapshot.adhd>
#include <impl/ecs_render/shader/shader_system.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererReflectionPipelines : NoCopy{
    public RendererReflectionPipelines(mut GraphicsRuntime graphics, mut RendererShaderSystem shaders){
        this.m_graphics = graphics;
        this.m_shaders = shaders;
    }

    public b8 prepare(in b8 prepareHardware, in b8 prepareCsgHardware, mut ReflectionFrameSnapshot resources);
    public void invalidate(mut ReflectionFrameSnapshot resources);

    public in ComputePipelineHandle plainHardwarePipeline()const{
        return this.m_plainHardwarePipeline;
    }

    public in ComputePipelineHandle unspecifiedHardwarePipeline()const{
        return this.m_unspecifiedHardwarePipeline;
    }

    public in ComputePipelineHandle fastHardwarePipeline()const{
        return this.m_fastHardwarePipeline;
    }

    public in ComputePipelineHandle buildOpticalArgsPipeline()const{
        return this.m_buildOpticalArgsPipeline;
    }

    public in ComputePipelineHandle csgBuildArgsPipeline()const{
        return this.m_csgBuildArgsPipeline;
    }

    public in ComputePipelineHandle csgHardwarePipeline()const{
        return this.m_csgHardwarePipeline;
    }

    public in ComputePipelineHandle csgPlainHardwarePipeline()const{
        return this.m_csgPlainHardwarePipeline;
    }

    public in ComputePipelineHandle csgUnspecifiedHardwarePipeline()const{
        return this.m_csgUnspecifiedHardwarePipeline;
    }

    private mut GraphicsRuntime m_graphics;
    private mut RendererShaderSystem m_shaders;
    private BindingLayoutHandle m_bindingLayout;
    private BindingLayoutHandle m_depthBindingLayout;
    private BindingLayoutHandle m_csgBindingLayout;
    private ShaderHandle m_classifyShader;
    private ShaderHandle m_buildArgsShader;
    private ShaderHandle m_hardwareShader;
    private ShaderHandle m_plainHardwareShader;
    private ShaderHandle m_unspecifiedHardwareShader;
    private ShaderHandle m_fastHardwareShader;
    private ShaderHandle m_buildOpticalArgsShader;
    private ComputePipelineHandle m_plainHardwarePipeline;
    private ComputePipelineHandle m_unspecifiedHardwarePipeline;
    private ComputePipelineHandle m_fastHardwarePipeline;
    private ComputePipelineHandle m_buildOpticalArgsPipeline;
    private ShaderHandle m_csgBuildArgsShader;
    private ComputePipelineHandle m_csgBuildArgsPipeline;
    private ShaderHandle m_csgHardwareShader;
    private ShaderHandle m_csgPlainHardwareShader;
    private ShaderHandle m_csgUnspecifiedHardwareShader;
    private ComputePipelineHandle m_csgHardwarePipeline;
    private ComputePipelineHandle m_csgPlainHardwarePipeline;
    private ComputePipelineHandle m_csgUnspecifiedHardwarePipeline;
    private ShaderHandle m_depthShader;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

