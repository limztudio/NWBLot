namespace UiSliderTests{
FOUNDATION_INLINE StringView SliderCallbackSource::text(const u64)const{
    ++m_calls;
    if(m_mutation == SliderCallbackMutation::None)
        return s_LaterCallbackText;
    const SliderCallbackMutation::Enum mutation = m_mutation;
    m_mutation = SliderCallbackMutation::None;
    ++m_mutations;
    if(mutation == SliderCallbackMutation::SameValue || mutation == SliderCallbackMutation::AwayAndBack || mutation == SliderCallbackMutation::SetValue)
        ::__hidden_ui_glyph_sdf_tests::ApplySliderCallbackStateMutation(mutation, *m_state);
    else if(mutation == SliderCallbackMutation::ResetBuilder || mutation == SliderCallbackMutation::PanelBuilder)
        ::__hidden_ui_glyph_sdf_tests::ApplySliderCallbackBuilderMutation(mutation, const_cast<SliderCallbackSource&>(*this), *m_builder);
    else if(mutation == SliderCallbackMutation::ClosePopup)
        m_popup->close();
    return s_LaterCallbackText;
}
