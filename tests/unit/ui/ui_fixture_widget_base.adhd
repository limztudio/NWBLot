void ExpectUiSamePaintSnapshots(in DrawSnapshot actual, in DrawSnapshot expected){
    ASSERT_EQ(actual.glyphPages().size(), expected.glyphPages().size());
    ASSERT_EQ(actual.sdfPages().size(), expected.sdfPages().size());
    ASSERT_EQ(actual.vertices().size(), expected.vertices().size());
    ASSERT_EQ(actual.commands().size(), expected.commands().size());
    const Span<u32> actualIndices = actual.indices();
    const Span<u32> expectedIndices = expected.indices();
    ASSERT_EQ(actualIndices.size(), expectedIndices.size());
    for(usize index = 0u; index < actualIndices.size(); ++index)
        EXPECT_EQ(actualIndices[index], expectedIndices[index]);
    for(usize index = 0u; index < actual.glyphPages().size(); ++index){
        const SharedGlyphPage actualPage = actual.glyphPages()[index];
        const SharedGlyphPage expectedPage = expected.glyphPages()[index];
        ASSERT_TRUE(cast<b8>(actualPage));
        ASSERT_TRUE(cast<b8>(expectedPage));
        EXPECT_EQ(actualPage, expectedPage);
        EXPECT_EQ(GlyphPageBindingOf(actualPage), GlyphPageBindingOf(expectedPage));
        const Span<u8> actualPixels = GlyphPagePixelsOf(actualPage);
        const Span<u8> expectedPixels = GlyphPagePixelsOf(expectedPage);
        ASSERT_EQ(actualPixels.size(), expectedPixels.size());
        for(usize pixelIndex = 0u; pixelIndex < actualPixels.size(); ++pixelIndex)
            EXPECT_EQ(actualPixels[pixelIndex], expectedPixels[pixelIndex]);
    }
    for(usize index = 0u; index < actual.sdfPages().size(); ++index){
        const SharedSdfAtlasPage actualPage = actual.sdfPages()[index];
        const SharedSdfAtlasPage expectedPage = expected.sdfPages()[index];
        ASSERT_TRUE(cast<b8>(actualPage));
        ASSERT_TRUE(cast<b8>(expectedPage));
        EXPECT_EQ(actualPage, expectedPage);
        EXPECT_EQ(SdfPageBindingOf(actualPage), SdfPageBindingOf(expectedPage));
        const Span<u8> actualPixels = SdfPagePixelsOf(actualPage);
        const Span<u8> expectedPixels = SdfPagePixelsOf(expectedPage);
        ASSERT_EQ(actualPixels.size(), expectedPixels.size());
        for(usize pixelIndex = 0u; pixelIndex < actualPixels.size(); ++pixelIndex)
            EXPECT_EQ(actualPixels[pixelIndex], expectedPixels[pixelIndex]);
    }
    ExpectUiSameVertices(actual, expected);
    ExpectUiSameDrawCommands(actual, expected);
}

b8 BeginWidgetFixtureFrame(mut WidgetFixture self, in u64 generation, in DisplayMetrics display){
    if(!self.m_context.beginFrame(generation))
        return false;
    self.m_paint.begin(display, generation, self.m_skinGeneration, MakeUiSkinAssetRef(s_TestSkinPath), self.m_skin);
    return self.m_context.beginRoot(self.m_root);
}

InputRoutingResult SendWidgetFixtureEvent(mut WidgetFixture self, in InputEvent event){
    const b8 queued = self.m_context.input().queue(NativeInput(event)).has_value();
    EXPECT_TRUE(queued);
    if(!queued)
        return InputRoutingResult();
    return self.m_context.input().process();
}

void ClickWidgetFixturePoint(mut WidgetFixture self, in Point point){
    InputEvent down = InputEvent();
    down.position = point;
    down.type = InputEventType::PrimaryDown;
    EXPECT_TRUE(self.send(down).pointerConsumed);
    InputEvent up = InputEvent();
    up.position = point;
    up.type = InputEventType::PrimaryUp;
    EXPECT_TRUE(self.send(up).pointerConsumed);
}

void DragWidgetFixturePoints(mut WidgetFixture self, in Point origin, in Point destination){
    InputEvent down = InputEvent();
    down.position = origin;
    down.type = InputEventType::PrimaryDown;
    EXPECT_TRUE(self.send(down).pointerConsumed);
    InputEvent move = InputEvent();
    move.position = destination;
    move.type = InputEventType::PointerMove;
    EXPECT_TRUE(self.send(move).pointerConsumed);
    InputEvent up = InputEvent();
    up.position = destination;
    up.type = InputEventType::PrimaryUp;
    EXPECT_TRUE(self.send(up).pointerConsumed);
}

void PressWidgetFixtureKey(mut WidgetFixture self, in KeyEnum value, in b8 repeat, in b8 shift){
    InputEvent event = InputEvent();
    event.type = InputEventType::KeyDown;
    event.key = value;
    event.repeat = repeat;
    event.shift = shift;
    EXPECT_TRUE(self.send(event).commandConsumed);
    if(!repeat){
        event.type = InputEventType::KeyUp;
        EXPECT_TRUE(self.send(event).commandConsumed);
    }
}


