[modular, friend(ListLayoutPreparer)]
class Builder : NoCopy{
    private mut Context m_context;
    private mut PaintBuilder m_paint;
    private mut TextService m_text;
    private BuilderScopeFrame m_scopeFrame;
    private Optional<mut BuilderScopeFrame> m_scope;
    private Array<ArenaObjectSlot<BuilderScopeFrame>, s_MaxNestedPopupFrames> m_popupFrames;
    private usize m_popupFrameCount = 0u;
    private Optional<in UiSkin> m_skin;
    private WidgetStyle m_style;
    private String m_textLanguage;
    private u32 m_textScriptTag = s_TextDefaultScriptTag;
    private TextDirection m_textDirection = TextDirection::LeftToRight;
    private TextBidiMode m_textBidiMode = TextBidiMode::None;
    private f32 m_skinDefaultFontSize = s_TextDefaultFontSize;
    private EditBoxStyle m_editStyle;
    private ScrollbarStyle m_scrollbarStyle;
    private PopupStyle m_popupStyle;
    private ListStyle m_listStyle;
    private RadioGroupStyle m_radioGroupStyle;
    private SliderStyle m_sliderStyle;
