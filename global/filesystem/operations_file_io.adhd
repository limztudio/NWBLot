[cpp_header("<global/filesystem/operations_file_io.h>"), cpp_name("::BinaryInputStream"), cpp_flags(no_copy, no_assign)]
extern class BinaryInputStream{
    b8 isOpen()const;
    i64 seekEnd();
    b8 seekBegin();
    b8 readBytes(mut Span<u8> bytes);
    Expected<usize> readChunk(mut Span<u8> destination);
    b8 verifyEnd();
};


