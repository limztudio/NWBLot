#include <impl/assets_scene/component_asset_binary_codec.adhd>
#include <impl/assets_scene/scene_asset_binary_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_ActiveSceneSubsystemsDiagnosticOwner = "ActiveSceneSubsystems";

void LogSceneSubsystemLoadFailed(in Name subsystemName){
    error("{}: failed to load subsystem asset '{}'", s_ActiveSceneSubsystemsDiagnosticOwner, subsystemName.resolvedText());
}

void LogSceneAssetNotSubsystem(in Name subsystemName){
    error("{}: asset '{}' is not a subsystem", s_ActiveSceneSubsystemsDiagnosticOwner, subsystemName.resolvedText());
}

void LogSceneDuplicateSubsystemType(in Name subsystemType, in Name sceneName){
    error(
        "{}: duplicate subsystem type '{}' in scene '{}'"
        , s_ActiveSceneSubsystemsDiagnosticOwner
        , subsystemType.resolvedText()
        , sceneName.resolvedText()
    );
}

void LogSceneComponentLoadFailed(in Name componentName, in Name entityName){
    error(
        "{}: failed to load component asset '{}' for entity '{}'"
        , s_ActiveSceneSubsystemsDiagnosticOwner
        , componentName.resolvedText()
        , entityName.resolvedText()
    );
}

void LogSceneAssetNotComponent(in Name componentName){
    error("{}: asset '{}' is not a component", s_ActiveSceneSubsystemsDiagnosticOwner, componentName.resolvedText());
}

void LogSceneDuplicateComponentType(in Name componentType, in Name entityName){
    error(
        "{}: duplicate component type '{}' on entity '{}'"
        , s_ActiveSceneSubsystemsDiagnosticOwner
        , componentType.resolvedText()
        , entityName.resolvedText()
    );
}

b8 ValidateSceneEntityInstantiationReady(in b8 sceneValid){
    if(sceneValid)
        return true;

    error("{}: cannot instantiate entities before loading a valid scene", s_ActiveSceneSubsystemsDiagnosticOwner);
    return false;
}

b8 ValidateSceneLoadedEntityHasComponents(in b8 hasComponents, in Name entityName){
    if(hasComponents)
        return true;

    error("{}: loaded entity '{}' has no components", s_ActiveSceneSubsystemsDiagnosticOwner, entityName.resolvedText());
    return false;
}

b8 ValidateCreatedSceneEcsEntity(in EntityID entityId, in Name entityName){
    if(entityId.valid())
        return true;

    error("{}: failed to create ECS entity for '{}'", s_ActiveSceneSubsystemsDiagnosticOwner, entityName.resolvedText());
    return false;
}


