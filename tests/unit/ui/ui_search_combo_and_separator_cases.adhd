    self.m_source.onFilter = UiSearchComboBehaviorMutation::QuerySelection;
    EXPECT_FALSE(FilterSearchCombo(self.m_state, self.m_source));
    EXPECT_EQ(self.m_state.query().text(), "tail");
    EXPECT_EQ(self.m_state.query().revision(), revision);
    EXPECT_EQ(self.m_state.query().externalRevision(), externalRevision);
    EXPECT_EQ(self.m_state.query().anchor(), 0u);
    EXPECT_EQ(self.m_state.query().caret(), 4u);
    EXPECT_EQ(self.m_state.combo().listState().inputGeneration(), previewGeneration);
}

void VerifyUiSearchComboBehaviorTests_CompositionBeginCancelCycleCannotRestoreAnOldFilterLoan(mut UiSearchComboBehaviorTests self){
    ASSERT_TRUE(self.m_state.query().setText("tail"));
    const u64 compositionGeneration = self.m_state.query().compositionGeneration();
    const u64 previewGeneration = self.m_state.combo().listState().inputGeneration();
    self.m_source.onFilter = UiSearchComboBehaviorMutation::CompositionCycle;
    EXPECT_FALSE(FilterSearchCombo(self.m_state, self.m_source));
    EXPECT_FALSE(self.m_state.query().composition().active);
    EXPECT_EQ(self.m_state.query().text(), "tail");
    EXPECT_NE(self.m_state.query().compositionGeneration(), compositionGeneration);
    EXPECT_EQ(self.m_state.combo().listState().inputGeneration(), previewGeneration);
}

void VerifyUiSearchComboBehaviorTests_ReentrantComboSelectionAndPopupChangesRemainAuthoritative(mut UiSearchComboBehaviorTests self){
    Array<UiSearchComboBehaviorMutation, 3u> mutations;
    mutations[0u] = UiSearchComboBehaviorMutation::Selection;
    mutations[1u] = UiSearchComboBehaviorMutation::Open;
    mutations[2u] = UiSearchComboBehaviorMutation::Close;
    for(in UiSearchComboBehaviorMutation mutation : mutations){
        SearchComboState state = SearchComboState();
        UiSearchComboBehaviorSource source = UiSearchComboBehaviorSource(state);
        state.combo().select(5u);
        state.combo().open();
        const u64 inputGeneration = state.combo().inputGeneration();
        source.onFilter = mutation;
        EXPECT_FALSE(FilterSearchCombo(state, source));
        EXPECT_NE(state.combo().inputGeneration(), inputGeneration);
        u64 expectedSelected = 5u;
        if(mutation == UiSearchComboBehaviorMutation::Selection)
            expectedSelected = 8u;
        EXPECT_EQ(state.combo().selectedKey(), expectedSelected);
        EXPECT_EQ(state.combo().isOpen(), mutation == UiSearchComboBehaviorMutation::Open);
    }
}

void VerifyUiSearchComboBehaviorTests_ReentrantPreviewScrollCannotBeOverwrittenByFilterReset(mut UiSearchComboBehaviorTests self){
    self.m_source.onFilter = UiSearchComboBehaviorMutation::PreviewScroll;
    EXPECT_FALSE(FilterSearchCombo(self.m_state, self.m_source));
