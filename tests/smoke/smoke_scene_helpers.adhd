type SmokeMaterialRef = AssetRef<Material>;
type SmokeMeshRef = AssetRef<Mesh>;

Expected<SmokeMeshRef, NameTextError> SmokeMeshRefFromText(in StringView path){
    return SmokeMeshRef::FromText(path);
}

Expected<SmokeMaterialRef, NameTextError> SmokeMaterialRefFromText(in StringView path){
    return SmokeMaterialRef::FromText(path);
}

mut RendererSystem SmokeRendererSystemRef(mut World world){
    const Optional<mut RendererSystem> system = world.borrowSystem<RendererSystem>();
    return system.value();
}

mut MeshSystem SmokeMeshSystemRef(mut World world){
    const Optional<mut MeshSystem> system = world.borrowSystem<MeshSystem>();
    return system.value();
}

class SmokeRenderSystems{
    public mut MeshSystem mesh;
    public mut RendererSystem renderer;

    public SmokeRenderSystems(mut MeshSystem mesh, mut RendererSystem renderer){
        this.mesh = mesh;
        this.renderer = renderer;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u64 s_SmokeMaxU32Setting = 4294967295u;
const u64 s_SmokeBytesPerMiB = 1048576u;
const u64 s_SmokeMaxSoftwareShadowBudgetMiB = s_SmokeMaxU32Setting / s_SmokeBytesPerMiB;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SmokeRenderQualitySettings{
    public CausticQualitySettings caustic = CausticQualitySettings();
    public SurfelGiQualitySettings surfelGi = SurfelGiQualitySettings();
    public ShadowQualitySettings shadow = ShadowQualitySettings();
    public SoftwareShadowSettings softwareShadow = SoftwareShadowSettings();
}

b8 SetSmokeEntityRotation(in EntityID entity, in VectorSingle rotation, mut World world){
    if(!world.hasComponent<TransformComponent>(entity))
        return false;

    mut TransformComponent transform = world.getComponent<TransformComponent>(entity);
    transform.rotation = f32x4(rotation);
    return true;
}

b8 SetSmokeEntityTransform(in EntityID entity, in VectorSingle position, in VectorSingle rotation, mut World world){
    if(!world.hasComponent<TransformComponent>(entity))
        return false;

    mut TransformComponent transform = world.getComponent<TransformComponent>(entity);
    transform.position = f32x4(position);
    transform.rotation = f32x4(rotation);
    return true;
}

