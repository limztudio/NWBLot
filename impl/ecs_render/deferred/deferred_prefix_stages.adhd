////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize ComputeOpaqueGbufferResourceUseCapacity(
    in b8 hasOpaqueDrawItems,
    in b8 hasCsgFrameGpuWork,
    in b8 hasOpaqueCsgFrameWork,
    in usize opaqueDrawUseCount,
    in usize noOpaqueDrawUseCount,
    in usize csgFrameUseCount
){
    usize count = noOpaqueDrawUseCount;
    if(hasOpaqueDrawItems)
        count = opaqueDrawUseCount;
    if(hasCsgFrameGpuWork)
        count += csgFrameUseCount;
    if(hasOpaqueCsgFrameWork)
        count += csgFrameUseCount;
    return count;
}

b8 HasValidPrefixSceneUploadInputs(
    in b8 meshViewValid,
    in b8 lightsValid,
    in b8 sceneShadingValid,
    in b8 shadowPrepareTaskValid
){
    return meshViewValid && lightsValid && sceneShadingValid && shadowPrepareTaskValid;
}

b8 UsesOpaqueMaterialGeometry(in b8 regularEmpty, in b8 csgReceiverSurfaceEmpty){
    return !regularEmpty || !csgReceiverSurfaceEmpty;
}

b8 ValidateAddressableUploadElementCount(in usize count, in usize elementStride){
    return count <= usize.max / elementStride;
}

void LogOpaqueMaterialGeometryStatesUnavailable(){
    warning("RendererSystem: could not declare prepared opaque material geometry states");
}

void LogOpaqueMaterialSampledTexturesUnavailable(){
    warning("RendererSystem: could not declare prepared opaque material sampled textures");
}


