#include "benchmark_support.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<tests/performance/simd_optimization/benchmark_abi.h>"), cpp_name("::SimdBenchmarkAbi::AvxMoveMask")]
extern u32 BenchmarkAvxMoveMask(in VectorDouble value);

[cpp_header("<tests/performance/simd_optimization/benchmark_abi.h>"), cpp_name("::SimdBenchmarkAbi::PairMoveMask")]
extern u32 BenchmarkPairMoveMask(in VectorDouble value, in b8 high);

[cpp_header("<tests/performance/simd_optimization/benchmark_abi.h>"), cpp_name("::SimdBenchmarkAbi::ShiftDoubleSignLanes")]
extern VectorDouble BenchmarkSignLanes(in VectorDouble value);

[cpp_header("<tests/performance/simd_optimization/benchmark_abi.h>"), cpp_name("::SimdBenchmarkAbi::LowFloatBits")]
extern VectorSingle BenchmarkLowSingleBits(in VectorDouble value);

enum<u32> MaskOperation{
    Move = 0u,
    EqualFloat = 1u,
    EqualDouble = 2u,
    EqualDoubleXYZ = 3u
};

class MaskDataset{
    public Array<u64x4, 64> left;
    public Array<u64x4, 64> right;
}

u32 MaskKernelBaselineMoveDouble(in VectorDouble value){
    if(s_HasAvxInstructionSet)
        return BenchmarkAvxMoveMask(value);
    if(s_BenchmarkUsesSsePairs)
        return BenchmarkPairMoveMask(value, false) | (BenchmarkPairMoveMask(value, true) << 2u);
    const VectorDouble bits = BenchmarkSignLanes(value);
    return cast<u32>(SimdGetDoubleLaneBits(bits, 0u) | (SimdGetDoubleLaneBits(bits, 1u) << 1u) |
        (SimdGetDoubleLaneBits(bits, 2u) << 2u) | (SimdGetDoubleLaneBits(bits, 3u) << 3u));
}

u32 MaskKernelMoveDouble<const b8 Candidate>(in VectorDouble value){
    if(Candidate)
        return VectorDoubleMoveMask(value);
    return MaskKernelBaselineMoveDouble(value);
}

b8 MaskKernelEqualFloat4<const b8 Candidate>(in VectorSingle a, in VectorSingle b){
    if(Candidate)
        return Vector4Equal(a, b);
    return (VectorMoveMask(VectorEqual(a, b)) & 15u) == 15u;
}

b8 MaskKernelEqualDouble4<const b8 Candidate>(in VectorDouble a, in VectorDouble b){
    if(Candidate)
        return VectorDouble4Equal(a, b);
    return (MaskKernelBaselineMoveDouble(VectorDoubleEqual(a, b)) & 15u) == 15u;
}

b8 MaskKernelEqualDouble3<const b8 Candidate>(in VectorDouble a, in VectorDouble b){
    if(Candidate)
        return VectorDouble3Equal(a, b);
    return (MaskKernelBaselineMoveDouble(VectorDoubleEqual(a, b)) & 7u) == 7u;
}

u32 MaskKernelApply<const u32 KindIndex, const b8 Candidate>(in VectorDouble a, in VectorDouble b){
    if(KindIndex == 0u)
        return MaskKernelMoveDouble<Candidate>(a);
    else if(KindIndex == 1u)
        return MaskKernelEqualFloat4<Candidate>(BenchmarkLowSingleBits(a), BenchmarkLowSingleBits(b));
    else if(KindIndex == 2u)
        return MaskKernelEqualDouble4<Candidate>(a, b);
    else
        return MaskKernelEqualDouble3<Candidate>(a, b);
}

u64 MaskKernelRunWorkload<const u32 KindIndex, const b8 Candidate>(in MaskDataset data, in usize iterations, in b8 latency){
    Array<u64, 8> results;
    if(latency){
        usize index = 1u;
        for(usize i = 0u; i < iterations; ++i){
            const u32 result = MaskKernelApply<KindIndex, Candidate>(VectorDouble(data.left[index]), VectorDouble(data.right[index]));
            results[0] += result;
            index = (index + result + 1u) & 63u;
        }
    }
    else{
        for(usize i = 0u; i < iterations; ++i){
            const usize index = i & 63u;
            for(usize lane = 0u; lane < 8u; ++lane)
                results[lane] += MaskKernelApply<KindIndex, Candidate>(VectorDouble(data.left[(index + lane * 7u) & 63u]), VectorDouble(data.right[(index + lane * 7u) & 63u]));
        }
    }
    u64 checksum = 0u;
    for(usize lane = 0u; lane < 8u; ++lane)
        checksum += results[lane];
    return checksum;
}

b8 MaskKernelCheckMoveMaskDoubleEquivalence(in VectorDouble value){
    return MaskKernelMoveDouble<false>(value) == MaskKernelMoveDouble<true>(value);
}

u32 MaskKernelAuditCompareImpl<const u32 KindIndex>(in VectorDouble a, in VectorDouble b){
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return 3u;
    WritePowerError(0);
    const u32 baselineValue = MaskKernelApply<KindIndex, false>(a, b);
    const i32 baselineFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    const i32 baselineErrno = ReadPowerError();
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return 3u;
    WritePowerError(0);
    const u32 candidateValue = MaskKernelApply<KindIndex, true>(a, b);
    if(candidateValue != baselineValue || TestFloatingPointExceptions(FE_ALL_EXCEPT) != baselineFlags || ReadPowerError() != baselineErrno)
        return 4u;
    return 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u32 AuditCompareMaskOperation<const u32 KindIndex>(in VectorDouble a, in VectorDouble b){
    return MaskKernelAuditCompareImpl<KindIndex>( a, b);
}

usize MaskRoundingModeSlot(in usize orderIndex){
    switch(orderIndex){
    case 0u: return 0u;
    case 1u: return 2u;
    case 2u: return 1u;
    default: return 3u;
    }
}

u32 QualifyMaskBenchmark(){
    u64 state = 0x7462825482129431ull;
    Array<u64, 14> edges;
    edges[0] = 0u;
    edges[1] = 0x8000000000000000ull;
    edges[2] = 1u;
    edges[3] = 0x8000000000000001ull;
    edges[4] = 0x0010000000000000ull;
    edges[5] = 0x3FF0000000000000ull;
    edges[6] = 0xBFF0000000000000ull;
    edges[7] = 0x7FEFFFFFFFFFFFFFull;
    edges[8] = 0x7FF0000000000000ull;
    edges[9] = 0xFFF0000000000000ull;
    edges[10] = 0x7FF8123412341234ull;
    edges[11] = 0x7FF0234523452345ull;
    edges[12] = 0x7FC012347FC01234ull;
    edges[13] = 0x7F8012347F801234ull;

    const Expected<FloatingPointEnvironment> originalEnvironment = HoldFloatingPointExceptions();
    if(!originalEnvironment.has_value())
        return 2u;

    FloatingPointEnvironmentGuard restoreEnvironment = FloatingPointEnvironmentGuard(originalEnvironment.value());
    u32 status = 0u;
    for(usize sample = 0u; sample < 1000000u && status == 0u; ++sample){
        const u64 w0 = NextSeed(state);
        const u64 w1 = NextSeed(state);
        const u64 w2 = NextSeed(state);
        const u64 w3 = NextSeed(state);
        const VectorDouble value = VectorDouble(u64x4(w0, w1, w2, w3));
        if(!MaskKernelCheckMoveMaskDoubleEquivalence(value))
            status = 1u;
    }

    const usize edgeCount = edges.size();
    for(usize orderIndex = 0u; orderIndex < 4u && status == 0u; ++orderIndex){
        const i32 mode = SimdRoundingModeByIndex(MaskRoundingModeSlot(orderIndex));
        if(!SetFloatingPointRoundingMode(mode).has_value()){
            status = 2u;
            break;
        }
        for(usize sample = 0u; sample < 2048u && status == 0u; ++sample){
            const u64 a0 = edges[cast<usize>(NextSeed(state) % cast<u64>(edgeCount))];
            const u64 a1 = edges[cast<usize>(NextSeed(state) % cast<u64>(edgeCount))];
            const u64 a2 = edges[cast<usize>(NextSeed(state) % cast<u64>(edgeCount))];
            const u64 a3 = edges[cast<usize>(NextSeed(state) % cast<u64>(edgeCount))];
            const VectorDouble a = VectorDouble(u64x4(a0, a1, a2, a3));
            VectorDouble b = a;
            if(sample % 2u == 0u){
                const u64 b0 = edges[cast<usize>(NextSeed(state) % cast<u64>(edgeCount))];
                const u64 b1 = edges[cast<usize>(NextSeed(state) % cast<u64>(edgeCount))];
                const u64 b2 = edges[cast<usize>(NextSeed(state) % cast<u64>(edgeCount))];
                const u64 b3 = edges[cast<usize>(NextSeed(state) % cast<u64>(edgeCount))];
                b = VectorDouble(u64x4(b0, b1, b2, b3));
            }
            status = AuditCompareMaskOperation<1u>(a, b);
            if(status == 0u)
                status = AuditCompareMaskOperation<2u>(a, b);
            if(status == 0u)
                status = AuditCompareMaskOperation<3u>(a, b);
        }
    }
    if(status == 0u && !SetFloatingPointRoundingMode(SimdRoundingModeByIndex(0u)).has_value())
        status = 2u;
    return status;
}

void InitializeMaskDataset(mut MaskDataset dataset){
    u64 state = 0x5629842965734193ull;
    for(usize i = 0u; i < 64u; ++i){
        const u64 w0 = NextSeed(state);
        const u64 w1 = NextSeed(state);
        const u64 w2 = NextSeed(state);
        const u64 w3 = NextSeed(state);
        u64 differing = 0u;
        if(i % 3u == 0u)
            differing = 1u;
        dataset.left[i] = u64x4(w0, w1, w2, w3);
        dataset.right[i] = u64x4(w0 ^ differing, w1, w2, w3);
    }
}

void MeasureMaskVariant<const u32 KindIndex, const b8 Candidate>(in MaskDataset data, in usize iterations, in b8 latency){
    const Timer start = TimerNow();
    const u64 checksum = MaskKernelRunWorkload<KindIndex, Candidate>( data, iterations, latency);
    const f64 nanoseconds = DurationInNS<f64>(TimerNow(), start);
    usize operations = iterations * 8u;
    if(latency)
        operations = iterations;
    const f64 nanosecondsPerOperation = nanoseconds / cast<f64>(operations);
    StringView variantLabel = "baseline";
    if(Candidate)
        variantLabel = "candidate";
    StringView workloadLabel = "throughput";
    if(latency)
        workloadLabel = "latency";
    WriteBenchmarkStdout(StringFormat(
        "{{\"operation\":{},\"variant\":\"{}\",\"workload\":\"{}\",\"operations\":{},\"nanoseconds\":{:.17g},\"ns_per_operation\":{:.17g},\"checksum\":{}}}\n",
        KindIndex,
        variantLabel,
        workloadLabel,
        operations,
        nanoseconds,
        nanosecondsPerOperation,
        checksum
    ));
}

void SelectMaskVariant<const u32 KindIndex>(in MaskDataset data, in b8 candidate, in usize iterations, in b8 latency){
    if(candidate)
        MeasureMaskVariant<KindIndex, true>(data, iterations, latency);
    else
        MeasureMaskVariant<KindIndex, false>(data, iterations, latency);
}

i32 RunMaskBenchmarkCli(in Span<StringView> args){
    if(args.size() == 2u && args[1] == "--verify"){
        const u32 status = QualifyMaskBenchmark();
        WriteBenchmarkStdout(StringFormat("qualification_status={}\n", status));
        return cast<i32>(status);
    }
    if(args.size() != 6u || args[1] != "--measure")
        return 2;

    const b8 latency = args[5] == "latency";
    usize divisor = 8u;
    if(latency)
        divisor = 1u;
    const Expected<MeasureOptions> options = ParseMeasureOptions(args[3], args[4], args[5], usize.max / divisor, true);
    if(!options.has_value())
        return 2;
    const b8 candidate = options.value().candidate;
    const usize iterations = options.value().iterations;

    MaskDataset data = MaskDataset();
    InitializeMaskDataset(data);
    if(args[2] == "move")
        SelectMaskVariant<0u>(data, candidate, iterations, latency);
    else if(args[2] == "equal_float")
        SelectMaskVariant<1u>(data, candidate, iterations, latency);
    else if(args[2] == "equal_double")
        SelectMaskVariant<2u>(data, candidate, iterations, latency);
    else if(args[2] == "equal_double3")
        SelectMaskVariant<3u>(data, candidate, iterations, latency);
    else
        return 2;
    return 0;
}


