    public b8 setJointMaxTorque(in JointId jointId, in f32 maxTorque){
        if(!this.isValidJoint(jointId) || !IsFinite(maxTorque) || maxTorque < 0.0f)
            return false;
        this.m_joints[jointId.index].maxTorque = maxTorque;
        if(maxTorque <= 0.0f && this.m_joints[jointId.index].type == JointType::Motor)
            this.m_joints[jointId.index].setAngularImpulse(VectorSingle(0.0f));
        this.wakeJointBodies(jointId.index);
        return true;
    }

    public b8 setJointCorrectionFactor(in JointId jointId, in f32 correctionFactor){
        if(!this.isValidJoint(jointId) || !IsFinite(correctionFactor) || correctionFactor < 0.0f)
            return false;
        this.m_joints[jointId.index].correctionFactor = Clamp(correctionFactor, 0.0f, 1.0f);
        this.wakeJointBodies(jointId.index);
        return true;
    }

    public b8 setJointTargetRotation(in JointId jointId, in VectorSingle referenceRotation){
        if(!this.isValidJoint(jointId) || !IsFiniteQuat(referenceRotation))
            return false;
        this.m_joints[jointId.index].referenceRotation = f32x4(SafeNormalizeQuat(referenceRotation));
        this.wakeJointBodies(jointId.index);
        return true;
