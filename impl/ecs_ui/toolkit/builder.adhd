    private b8 paintPopup();

    private b8 synchronizePopup();

    private b8 popupFrameVisible(in BuilderScopeFrame frame)const{ return frame.popupVisible(); }

    private b8 popupAncestorsVisible()const{ return this.m_scope.value().popupAncestorsVisible(this.m_context); }

    [cpp_unwind]
    private b8 finishPopupFamily();

    private in BuilderScopeFrame readPopupFrameAt(in usize index)const{
        if(index == 0u)
            return this.m_scopeFrame;
        return this.m_popupFrames[index - 1u].read();
    }

    private mut BuilderScopeFrame popupFrameAt(in usize index){
        if(index == 0u)
            return this.m_scopeFrame;
        return this.m_popupFrames[index - 1u].value();
    }

    [cpp_unwind]
    private b8 paintPopupFamily(mut BuilderScopeFrame frame);

    [cpp_unwind]
    private b8 validatePopupFamily();

    private void releasePopupFamily();

    [cpp_unwind]
    private b8 reserveCompoundPopup(in WidgetState widget, in PopupToken token);

    private Rect visibleClip(in Rect clip)const{
        in DisplayMetrics display = this.m_paint.displayMetrics();
        return IntersectUiRectsBounds(Rect(0.0f, 0.0f, display.logicalWidth, display.logicalHeight), clip);
    }

    private b8 numericEditFrameMatches(in BuilderIntegerEditFrame frame)const{
        return frame.model.has_value() && frame.model.value().revision() == frame.revision && this.popupAncestorsVisible() && frame.state.has_value()
            && frame.model.value().draft().matchesStamp(frame.draftStamp) && frame.state.value().matchesStamp(frame.draftStamp, frame.focused);
    }
    private b8 numericEditFrameMatches(in BuilderFloatEditFrame frame)const{
        return frame.model.has_value() && frame.model.value().revision() == frame.revision && this.popupAncestorsVisible() && frame.state.has_value()
            && frame.model.value().draft().matchesStamp(frame.draftStamp) && frame.state.value().matchesStamp(frame.draftStamp, frame.focused);
    }
}


