void VerifyCpuTaskWaitTests_ScopeRejectsAnIndependentTaskDependingOnTheCaller(){
    u32 callbacks = 0u;
    DeadlineGuard deadline(false, s_WaitWatchdogTimeoutMS);
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope scope(scheduler);
    CpuTaskHandle caller = CpuTaskHandle();
    native(mut scheduler, mut scope, mut caller){
        const auto callerTaskAdmission = scheduler.submit([&]() { scope.wait(); });
        ASSERT_TRUE(callerTaskAdmission);
        caller = *callerTaskAdmission;
    }
    ASSERT_TRUE(caller.valid());
    const auto cpuTaskAdmission = scope.submit(lambda[mut callbacks]() -> void{
        ++callbacks;
    }, caller);
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    ASSERT_TRUE(cpuTaskAdmission.value().valid());
    EXPECT_THROW(scheduler.wait(caller), RuntimeException);
    scope.wait();
    EXPECT_EQ(callbacks, 0u);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}

void VerifyCpuTaskWaitTests_ScopeRejectsTransitiveDependentsOfTheCallersAncestor(){
    DeadlineGuard deadline(false, s_WaitWatchdogTimeoutMS);
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope scope(scheduler);
    CpuTaskHandle ancestor = CpuTaskHandle();
    native(mut scheduler, mut scope, mut ancestor){
        const auto cpuTaskAdmission = scheduler.submit([&]() {
            const auto secondCpuTaskAdmission = scheduler.submit([&]() { scope.wait(); });
            ASSERT_TRUE(secondCpuTaskAdmission);
            if(secondCpuTaskAdmission)
                ASSERT_TRUE(secondCpuTaskAdmission->valid());
        });
        ASSERT_TRUE(cpuTaskAdmission);
        ancestor = *cpuTaskAdmission;
    }
    ASSERT_TRUE(ancestor.valid());
    const auto middleTaskAdmission = scheduler.submit(lambda[]() -> void{}, ancestor);
    ASSERT_TRUE(middleTaskAdmission.has_value());
    const CpuTaskHandle middle = middleTaskAdmission.value();
    ASSERT_TRUE(middle.valid());
    const auto thirdCpuTaskAdmission = scope.submit(lambda[]() -> void{}, middle);
    ASSERT_TRUE(thirdCpuTaskAdmission.has_value());
    ASSERT_TRUE(thirdCpuTaskAdmission.value().valid());
    EXPECT_THROW(scheduler.wait(ancestor), RuntimeException);
    scope.wait();
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}

void VerifyCpuTaskWaitTests_ScopeRechecksDependenciesPublishedByCooperativeWork(){
    u32 callbacks = 0u;
    DeadlineGuard deadline(false, s_WaitWatchdogTimeoutMS);
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope scope(scheduler);
    CpuTaskHandle caller = CpuTaskHandle();
    native(mut scheduler, mut scope, mut caller){
        const auto callerTaskAdmission = scheduler.submit([&]() { scope.wait(); });
        ASSERT_TRUE(callerTaskAdmission);
        caller = *callerTaskAdmission;
    }
    ASSERT_TRUE(caller.valid());
    const auto cpuTaskAdmission = scope.submit(lambda[mut scope, mut callbacks, in caller]() -> void{
        ++callbacks;
        const auto secondCpuTaskAdmission = scope.submit(lambda[mut callbacks]() -> void{
            ++callbacks;
        }, caller);
        ASSERT_TRUE(secondCpuTaskAdmission.has_value());
        ASSERT_TRUE(secondCpuTaskAdmission.value().valid());
    });
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    ASSERT_TRUE(cpuTaskAdmission.value().valid());
    EXPECT_THROW(scheduler.wait(caller), RuntimeException);
    scope.wait();
    EXPECT_EQ(callbacks, 1u);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}

void VerifyCpuTaskWaitTests_NewDependencyInvalidatesAnEarlierUnrelatedSearch(){
    DeadlineGuard deadline(false, s_WaitWatchdogTimeoutMS);
    u32 sequence = 0u;
    u32 unrelated = 0u;
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope scope(scheduler);
    const auto prerequisiteTaskAdmission = scheduler.submit(lambda[mut sequence]() -> void{
        EXPECT_EQ(++sequence, 2u);
    });
    ASSERT_TRUE(prerequisiteTaskAdmission.has_value());
    const CpuTaskHandle prerequisite = prerequisiteTaskAdmission.value();
    ASSERT_TRUE(prerequisite.valid());
    const auto cpuTaskAdmission = scheduler.submit(lambda[mut unrelated]() -> void{
        ++unrelated;
    });
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    ASSERT_TRUE(cpuTaskAdmission.value().valid());
    const auto secondCpuTaskAdmission = scope.submit(lambda[mut scope, mut sequence, in prerequisite]() -> void{
        EXPECT_EQ(++sequence, 1u);
        const auto thirdCpuTaskAdmission = scope.submit(lambda[mut sequence]() -> void{
            EXPECT_EQ(++sequence, 3u);
        }, prerequisite);
        ASSERT_TRUE(thirdCpuTaskAdmission.has_value());
        ASSERT_TRUE(thirdCpuTaskAdmission.value().valid());
    });
    ASSERT_TRUE(secondCpuTaskAdmission.has_value());
    ASSERT_TRUE(secondCpuTaskAdmission.value().valid());
    scope.wait();
    const u32 unrelatedAfterScope = unrelated;
    scheduler.wait();
    const u32 unrelatedAfterAll = unrelated;
    EXPECT_EQ(sequence, 3u);
    EXPECT_EQ(unrelatedAfterScope, 0u);
    EXPECT_EQ(unrelatedAfterAll, 1u);
}

void VerifyCpuTaskWaitTests_ReusedUnrelatedSlotCanBecomeAScopedDescendant(){
    u32 callbacks = 0u;
    DeadlineGuard deadline(false, s_WaitWatchdogTimeoutMS);
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope scope(scheduler);
    const auto unrelatedTaskAdmission = scheduler.submit(lambda[mut callbacks]() -> void{
        ++callbacks;
    });
    ASSERT_TRUE(unrelatedTaskAdmission.has_value());
    const CpuTaskHandle unrelated = unrelatedTaskAdmission.value();
    ASSERT_TRUE(unrelated.valid());
    const auto cpuTaskAdmission = scope.submit(lambda[mut scheduler, mut callbacks, in unrelated]() -> void{
        EXPECT_EQ(callbacks, 0u);
        scheduler.wait(unrelated);
        const auto childTaskAdmission = scheduler.submit(lambda[mut callbacks]() -> void{
            ++callbacks;
        });
        ASSERT_TRUE(childTaskAdmission.has_value());
        const CpuTaskHandle child = childTaskAdmission.value();
        ASSERT_TRUE(child.valid());
        EXPECT_EQ(child.index, unrelated.index);
        EXPECT_NE(child.generation, unrelated.generation);
    });
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    ASSERT_TRUE(cpuTaskAdmission.value().valid());
    scope.wait();
    EXPECT_EQ(callbacks, 2u);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}

void VerifyCpuTaskWaitTests_NestedScopesUseIndependentSearchIdentities(){
    DeadlineGuard deadline(false, s_WaitWatchdogTimeoutMS);
    u32 innerCallbacks = 0u;
    u32 unrelatedCallbacks = 0u;
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope inner(scheduler);
    CpuTaskScope outer(scheduler);
    const auto prerequisiteTaskAdmission = scheduler.submit(lambda[mut innerCallbacks]() -> void{
        ++innerCallbacks;
    });
    ASSERT_TRUE(prerequisiteTaskAdmission.has_value());
    const CpuTaskHandle prerequisite = prerequisiteTaskAdmission.value();
    ASSERT_TRUE(prerequisite.valid());
    const auto cpuTaskAdmission = inner.submit(lambda[mut innerCallbacks]() -> void{
        ++innerCallbacks;
    }, prerequisite);
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    ASSERT_TRUE(cpuTaskAdmission.value().valid());
    const auto secondCpuTaskAdmission = scheduler.submit(lambda[mut unrelatedCallbacks]() -> void{
        ++unrelatedCallbacks;
    });
    ASSERT_TRUE(secondCpuTaskAdmission.has_value());
    ASSERT_TRUE(secondCpuTaskAdmission.value().valid());
    const auto thirdCpuTaskAdmission = outer.submit(lambda[mut inner, mut innerCallbacks]() -> void{
        EXPECT_EQ(innerCallbacks, 0u);
        inner.wait();
        EXPECT_EQ(innerCallbacks, 2u);
    });
    ASSERT_TRUE(thirdCpuTaskAdmission.has_value());
    ASSERT_TRUE(thirdCpuTaskAdmission.value().valid());
    outer.wait();
    const u32 unrelatedAfterOuter = unrelatedCallbacks;
    scheduler.wait();
    const u32 unrelatedAfterAll = unrelatedCallbacks;
    EXPECT_EQ(unrelatedAfterOuter, 0u);
    EXPECT_EQ(unrelatedAfterAll, 1u);
}

void VerifyCpuTaskWaitTests_ConcurrentScopeWaitersCanSwitchTheSharedSearchCache(){
    CpuTaskSchedulerConfig config = CpuTaskSchedulerConfig();
    config.workerCount = 2u;
    config.heterogeneous = false;
    DeadlineGuard deadline(false, s_WaitWatchdogTimeoutMS);
    Atomic<u32> entered(0u);
    Atomic<b8> start(false);
    Atomic<u32> visitsA(0u);
    Atomic<u32> visitsB(0u);
    CpuTaskScheduler scheduler(config);
    CpuTaskScope scopeA(scheduler);
    CpuTaskScope scopeB(scheduler);
    const auto cpuTaskAdmission = scheduler.submit(lambda[mut entered, mut start, mut scopeA]() -> void{
        entered.fetch_add(1u, MemoryOrder::release);
        while(!start.load(MemoryOrder::acquire)){
            SleepMS(s_PollIntervalMS);
        }
        scopeA.wait();
    });
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    const CpuTaskHandle waiterA = cpuTaskAdmission.value();
    const auto secondCpuTaskAdmission = scheduler.submit(lambda[mut entered, mut start, mut scopeB]() -> void{
        entered.fetch_add(1u, MemoryOrder::release);
        while(!start.load(MemoryOrder::acquire)){
            SleepMS(s_PollIntervalMS);
        }
        scopeB.wait();
    });
    ASSERT_TRUE(secondCpuTaskAdmission.has_value());
    const CpuTaskHandle waiterB = secondCpuTaskAdmission.value();
    ASSERT_TRUE(waiterA.valid());
    ASSERT_TRUE(waiterB.valid());
    while(entered.load(MemoryOrder::acquire) != 2u){
        SleepMS(s_PollIntervalMS);
    }
    for(u32 index = 0u; index < 32u; ++index){
        const auto prerequisiteBTaskAdmission = scheduler.submit(lambda[]() -> void{});
        ASSERT_TRUE(prerequisiteBTaskAdmission.has_value());
        const CpuTaskHandle prerequisiteB = prerequisiteBTaskAdmission.value();
        const auto prerequisiteATaskAdmission = scheduler.submit(lambda[]() -> void{});
        ASSERT_TRUE(prerequisiteATaskAdmission.has_value());
        const CpuTaskHandle prerequisiteA = prerequisiteATaskAdmission.value();
        EXPECT_TRUE(prerequisiteB.valid());
        EXPECT_TRUE(prerequisiteA.valid());
        const auto thirdCpuTaskAdmission = scopeB.submit(lambda[mut visitsB]() -> void{
            visitsB.fetch_add(1u, MemoryOrder::relaxed);
        }, prerequisiteB);
        EXPECT_TRUE(thirdCpuTaskAdmission.has_value());
        if(thirdCpuTaskAdmission.has_value()){
            EXPECT_TRUE(thirdCpuTaskAdmission.value().valid());
        }
        const auto fourthCpuTaskAdmission = scopeA.submit(lambda[mut visitsA]() -> void{
            visitsA.fetch_add(1u, MemoryOrder::relaxed);
        }, prerequisiteA);
        EXPECT_TRUE(fourthCpuTaskAdmission.has_value());
        if(fourthCpuTaskAdmission.has_value()){
            EXPECT_TRUE(fourthCpuTaskAdmission.value().valid());
        }
    }
    start.store(true, MemoryOrder::release);
    scheduler.wait(waiterA);
    scheduler.wait(waiterB);
    EXPECT_EQ(visitsA.load(MemoryOrder::acquire), 32u);
    EXPECT_EQ(visitsB.load(MemoryOrder::acquire), 32u);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}

void VerifyCpuTaskWaitTests_ScopeJoinSkipsUnrelatedPrefixesAcrossPriorityQueues(){
    const u32 unrelatedTasks = 1024u;
    const u32 scopedTasks = 128u;
    const u32 priorities = 3u;
    DeadlineGuard deadline(false, s_WaitWatchdogTimeoutMS);
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope scope(scheduler);
    u32 joined = 0u;
    u32 unrelated = 0u;
    for(u32 index = 0u; index < unrelatedTasks; ++index){
        CpuTaskOptions options = CpuTaskOptions();
        options.priority = cast<CpuTaskPriorityEnum>(index % priorities);
        const auto cpuTaskAdmission = scheduler.submit(lambda[mut unrelated]() -> void{
            ++unrelated;
        }, options);
        ASSERT_TRUE(cpuTaskAdmission.has_value());
        ASSERT_TRUE(cpuTaskAdmission.value().valid());
    }
    for(u32 index = 0u; index < scopedTasks; ++index){
        CpuTaskOptions options = CpuTaskOptions();
        options.priority = cast<CpuTaskPriorityEnum>(index % priorities);
        const auto secondCpuTaskAdmission = scope.submit(lambda[mut joined]() -> void{
            ++joined;
        }, options);
        ASSERT_TRUE(secondCpuTaskAdmission.has_value());
        ASSERT_TRUE(secondCpuTaskAdmission.value().valid());
    }
    scope.wait();
    const u32 unrelatedAfterScope = unrelated;
    scheduler.wait();
    const u32 unrelatedAfterAll = unrelated;
    EXPECT_EQ(joined, scopedTasks);
    EXPECT_EQ(unrelatedAfterScope, 0u);
    EXPECT_EQ(unrelatedAfterAll, unrelatedTasks);
}

void VerifyCpuTaskWaitTests_NestedJoinCanRetireAnUnrelatedAnchorWithoutNewPublication(){
    DeadlineGuard deadline(false, s_WaitWatchdogTimeoutMS);
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope scope(scheduler);
    u32 joined = 0u;
    u32 unrelated = 0u;
    const auto anchorTaskAdmission = scheduler.submit(lambda[mut unrelated]() -> void{
        ++unrelated;
    });
    ASSERT_TRUE(anchorTaskAdmission.has_value());
    const CpuTaskHandle anchor = anchorTaskAdmission.value();
    ASSERT_TRUE(anchor.valid());
    const auto cpuTaskAdmission = scope.submit(lambda[mut scheduler, mut unrelated, mut joined, in anchor]() -> void{
        EXPECT_EQ(unrelated, 0u);
        scheduler.wait(anchor);
        EXPECT_EQ(unrelated, 1u);
        ++joined;
    });
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    ASSERT_TRUE(cpuTaskAdmission.value().valid());
    const auto secondCpuTaskAdmission = scheduler.submit(lambda[mut unrelated]() -> void{
        ++unrelated;
    });
    ASSERT_TRUE(secondCpuTaskAdmission.has_value());
    ASSERT_TRUE(secondCpuTaskAdmission.value().valid());
    const auto thirdCpuTaskAdmission = scope.submit(lambda[mut joined]() -> void{
        ++joined;
    });
    ASSERT_TRUE(thirdCpuTaskAdmission.has_value());
    ASSERT_TRUE(thirdCpuTaskAdmission.value().valid());
    scope.wait();
    const u32 unrelatedAfterScope = unrelated;
    scheduler.wait();
    const u32 unrelatedAfterAll = unrelated;
    EXPECT_EQ(joined, 2u);
    EXPECT_EQ(unrelatedAfterScope, 1u);
    EXPECT_EQ(unrelatedAfterAll, 2u);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}

void VerifyCpuTaskWaitTests_AnotherWorkerCanClaimAnUnrelatedAnchorDuringScopeExecution(){
    CpuTaskSchedulerConfig config = CpuTaskSchedulerConfig();
    config.workerCount = 2u;
    config.heterogeneous = false;
    DeadlineGuard deadline(false, s_WaitWatchdogTimeoutMS);
    Atomic<b8> waiterEntered(false);
    Atomic<b8> blockerEntered(false);
    Atomic<b8> startWaiter(false);
    Atomic<b8> releaseBlocker(false);
    Atomic<b8> anchorEntered(false);
    Atomic<b8> releaseAnchor(false);
    Atomic<u32> joined(0u);
    Atomic<u32> unrelated(0u);
    CpuTaskScheduler scheduler(config);
    CpuTaskScope scope(scheduler);
    ScopeExit release(lambda[mut startWaiter, mut releaseBlocker, mut releaseAnchor]() -> void{
        startWaiter.store(true, MemoryOrder::release);
        releaseBlocker.store(true, MemoryOrder::release);
        releaseAnchor.store(true, MemoryOrder::release);
    });
    const auto cpuTaskAdmission = scheduler.submit(lambda[mut waiterEntered, mut startWaiter, mut scope]() -> void{
        waiterEntered.store(true, MemoryOrder::release);
        while(!startWaiter.load(MemoryOrder::acquire)){
            SleepMS(s_PollIntervalMS);
        }
        scope.wait();
    });
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    const CpuTaskHandle waiter = cpuTaskAdmission.value();
    ASSERT_TRUE(waiter.valid());
    while(!waiterEntered.load(MemoryOrder::acquire)){
        SleepMS(s_PollIntervalMS);
    }
    const auto secondCpuTaskAdmission = scheduler.submit(lambda[mut blockerEntered, mut releaseBlocker]() -> void{
        blockerEntered.store(true, MemoryOrder::release);
        while(!releaseBlocker.load(MemoryOrder::acquire)){
            SleepMS(s_PollIntervalMS);
        }
    });
    ASSERT_TRUE(secondCpuTaskAdmission.has_value());
    ASSERT_TRUE(secondCpuTaskAdmission.value().valid());
    while(!blockerEntered.load(MemoryOrder::acquire)){
        SleepMS(s_PollIntervalMS);
    }
    const auto thirdCpuTaskAdmission = scheduler.submit(lambda[mut anchorEntered, mut releaseAnchor]() -> void{
        anchorEntered.store(true, MemoryOrder::release);
        while(!releaseAnchor.load(MemoryOrder::acquire)){
            SleepMS(s_PollIntervalMS);
        }
    });
    ASSERT_TRUE(thirdCpuTaskAdmission.has_value());
    ASSERT_TRUE(thirdCpuTaskAdmission.value().valid());
    const auto fourthCpuTaskAdmission = scope.submit(lambda[mut releaseBlocker, mut anchorEntered, mut joined]() -> void{
        releaseBlocker.store(true, MemoryOrder::release);
        while(!anchorEntered.load(MemoryOrder::acquire)){
            SleepMS(s_PollIntervalMS);
        }
        joined.fetch_add(1u, MemoryOrder::relaxed);
    });
    ASSERT_TRUE(fourthCpuTaskAdmission.has_value());
    ASSERT_TRUE(fourthCpuTaskAdmission.value().valid());
    const auto fifthCpuTaskAdmission = scheduler.submit(lambda[mut unrelated]() -> void{
        unrelated.fetch_add(1u, MemoryOrder::relaxed);
    });
    ASSERT_TRUE(fifthCpuTaskAdmission.has_value());
    ASSERT_TRUE(fifthCpuTaskAdmission.value().valid());
    const auto sixthCpuTaskAdmission = scope.submit(lambda[mut unrelated, mut joined, mut releaseAnchor]() -> void{
        EXPECT_EQ(unrelated.load(MemoryOrder::acquire), 0u);
        joined.fetch_add(1u, MemoryOrder::relaxed);
        releaseAnchor.store(true, MemoryOrder::release);
    });
    ASSERT_TRUE(sixthCpuTaskAdmission.has_value());
    ASSERT_TRUE(sixthCpuTaskAdmission.value().valid());
    startWaiter.store(true, MemoryOrder::release);
    scheduler.wait(waiter);
    scheduler.wait();
    EXPECT_EQ(joined.load(MemoryOrder::acquire), 2u);
    EXPECT_EQ(unrelated.load(MemoryOrder::acquire), 1u);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}

void VerifyCpuTaskWaitTests_DependencyCompletionAppendsScopedWorkAfterAnUnrelatedAnchor(){
    DeadlineGuard deadline(false, s_WaitWatchdogTimeoutMS);
    Atomic<b8> entered(false);
    Atomic<b8> release(false);
    CpuTaskScheduler scheduler(1u);
    CpuTaskScope scope(scheduler);
    ScopeExit releaseOnFailure(lambda[mut release]() -> void{
        release.store(true, MemoryOrder::release);
    });
    const auto cpuTaskAdmission = scheduler.submit(lambda[mut entered, mut release]() -> void{
        entered.store(true, MemoryOrder::release);
        while(!release.load(MemoryOrder::acquire)){
            SleepMS(s_PollIntervalMS);
        }
    });
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    const CpuTaskHandle prerequisite = cpuTaskAdmission.value();
    ASSERT_TRUE(prerequisite.valid());
    while(!entered.load(MemoryOrder::acquire)){
        SleepMS(s_PollIntervalMS);
    }
    CpuTaskOptions mainThread = CpuTaskOptions();
    mainThread.target = CpuTaskTarget::MainThread;
    u32 joined = 0u;
    u32 unrelated = 0u;
    const auto secondCpuTaskAdmission = scheduler.submit(lambda[mut unrelated]() -> void{
        ++unrelated;
    }, mainThread);
    ASSERT_TRUE(secondCpuTaskAdmission.has_value());
    ASSERT_TRUE(secondCpuTaskAdmission.value().valid());
    const auto thirdCpuTaskAdmission = scope.submit(lambda[mut joined, mut release]() -> void{
        ++joined;
        release.store(true, MemoryOrder::release);
    }, mainThread);
    ASSERT_TRUE(thirdCpuTaskAdmission.has_value());
    ASSERT_TRUE(thirdCpuTaskAdmission.value().valid());
    Array<CpuTaskHandle, 1> prerequisiteDeps = Array<CpuTaskHandle, 1>();
    prerequisiteDeps[0u] = prerequisite;
    const auto fourthCpuTaskAdmission = scope.submit(lambda[mut joined]() -> void{
        ++joined;
    }, mainThread, prerequisiteDeps.data(), 1u);
    ASSERT_TRUE(fourthCpuTaskAdmission.has_value());
    ASSERT_TRUE(fourthCpuTaskAdmission.value().valid());
    scope.wait();
    const u32 unrelatedAfterScope = unrelated;
    scheduler.wait();
    const u32 unrelatedAfterAll = unrelated;
    EXPECT_EQ(joined, 2u);
    EXPECT_EQ(unrelatedAfterScope, 0u);
    EXPECT_EQ(unrelatedAfterAll, 1u);
}

void VerifyCpuTaskWaitTests_APositiveSearchCannotAdmitVisitedUnrelatedSiblingBranches(){
    DeadlineGuard deadline(false, s_WaitWatchdogTimeoutMS);
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope scope(scheduler);
    u32 prerequisites = 0u;
    u32 joined = 0u;
    u32 unrelated = 0u;
    const auto rootTaskAdmission = scheduler.submit(lambda[mut prerequisites]() -> void{
        ++prerequisites;
    });
    ASSERT_TRUE(rootTaskAdmission.has_value());
    const CpuTaskHandle root = rootTaskAdmission.value();
    ASSERT_TRUE(root.valid());
    const auto siblingTaskAdmission = scheduler.submit(lambda[mut unrelated]() -> void{
        ++unrelated;
    }, root);
    ASSERT_TRUE(siblingTaskAdmission.has_value());
    const CpuTaskHandle sibling = siblingTaskAdmission.value();
    ASSERT_TRUE(sibling.valid());
    const auto cpuTaskAdmission = scheduler.submit(lambda[mut unrelated]() -> void{
        ++unrelated;
    }, sibling);
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    ASSERT_TRUE(cpuTaskAdmission.value().valid());
    const auto positiveTaskAdmission = scheduler.submit(lambda[mut prerequisites]() -> void{
        ++prerequisites;
    }, root);
    ASSERT_TRUE(positiveTaskAdmission.has_value());
    const CpuTaskHandle positive = positiveTaskAdmission.value();
    ASSERT_TRUE(positive.valid());
    const auto secondCpuTaskAdmission = scope.submit(lambda[mut joined]() -> void{
        ++joined;
    }, positive);
    ASSERT_TRUE(secondCpuTaskAdmission.has_value());
    ASSERT_TRUE(secondCpuTaskAdmission.value().valid());
    scope.wait();
    const u32 unrelatedAfterScope = unrelated;
    scheduler.wait();
    const u32 unrelatedAfterAll = unrelated;
    EXPECT_EQ(prerequisites, 2u);
    EXPECT_EQ(joined, 1u);
    EXPECT_EQ(unrelatedAfterScope, 0u);
    EXPECT_EQ(unrelatedAfterAll, 2u);
}

void VerifyCpuTaskWaitTests_PublicationCanMakeAnEarlierNegativeSiblingContribute(){
    DeadlineGuard deadline(false, s_WaitWatchdogTimeoutMS);
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope scope(scheduler);
    u32 prerequisite = 0u;
    u32 joined = 0u;
    u32 unrelatedTail = 0u;
    const auto rootTaskAdmission = scheduler.submit(lambda[]() -> void{});
    ASSERT_TRUE(rootTaskAdmission.has_value());
    const CpuTaskHandle root = rootTaskAdmission.value();
    ASSERT_TRUE(root.valid());
    const auto siblingTaskAdmission = scheduler.submit(lambda[mut prerequisite]() -> void{
        ++prerequisite;
    }, root);
    ASSERT_TRUE(siblingTaskAdmission.has_value());
    const CpuTaskHandle sibling = siblingTaskAdmission.value();
    ASSERT_TRUE(sibling.valid());
    const auto cpuTaskAdmission = scheduler.submit(lambda[mut unrelatedTail]() -> void{
        ++unrelatedTail;
    }, sibling);
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    ASSERT_TRUE(cpuTaskAdmission.value().valid());
    const auto positiveTaskAdmission = scheduler.submit(lambda[]() -> void{}, root);
    ASSERT_TRUE(positiveTaskAdmission.has_value());
    const CpuTaskHandle positive = positiveTaskAdmission.value();
    ASSERT_TRUE(positive.valid());
    const auto secondCpuTaskAdmission = scope.submit(lambda[mut scope, mut prerequisite, mut joined, in sibling]() -> void{
        EXPECT_EQ(prerequisite, 0u);
        ++joined;
        const auto thirdCpuTaskAdmission = scope.submit(lambda[mut joined]() -> void{
            ++joined;
        }, sibling);
        EXPECT_TRUE(thirdCpuTaskAdmission.has_value());
        if(thirdCpuTaskAdmission.has_value()){
            EXPECT_TRUE(thirdCpuTaskAdmission.value().valid());
        }
    }, positive);
    ASSERT_TRUE(secondCpuTaskAdmission.has_value());
    ASSERT_TRUE(secondCpuTaskAdmission.value().valid());
    scope.wait();
    const u32 unrelatedAfterScope = unrelatedTail;
    scheduler.wait();
    const u32 unrelatedAfterAll = unrelatedTail;
    EXPECT_EQ(prerequisite, 1u);
    EXPECT_EQ(joined, 2u);
    EXPECT_EQ(unrelatedAfterScope, 0u);
    EXPECT_EQ(unrelatedAfterAll, 1u);
}

