// Bindings or device adapters supply admitted editing intent; native-consumed input is filtered before translation.
// Accept inserts LF in multiline mode and submits in single-line mode; Submit always submits.
EditCommandRequest TranslateEditCommand(in InputCommandIntent intent, in b8 repeat, in EditTextMode mode){
    EditCommandRequest request;
    request.command = EditCommand::None;
    request.extend = intent.extend;
    request.repeat = repeat;
    if(!intent.edit || cast<u8>(mode) > cast<u8>(EditTextMode::Multiline))
        return request;
    switch(intent.command){
        case InputCommand::Left: request.command = EditCommand::Left; break;
        case InputCommand::Right: request.command = EditCommand::Right; break;
        case InputCommand::Home: request.command = EditCommand::Home; break;
        case InputCommand::End: request.command = EditCommand::End; break;
        case InputCommand::WordLeft: request.command = EditCommand::WordLeft; break;
        case InputCommand::WordRight: request.command = EditCommand::WordRight; break;
        case InputCommand::DocumentHome:
            if(mode == EditTextMode::Multiline)
                request.command = EditCommand::DocumentHome;
            else
                request.command = EditCommand::Home;
            break;
        case InputCommand::DocumentEnd:
            if(mode == EditTextMode::Multiline)
                request.command = EditCommand::DocumentEnd;
            else
                request.command = EditCommand::End;
            break;
        case InputCommand::Backspace: request.command = EditCommand::Backspace; break;
        case InputCommand::Delete: request.command = EditCommand::Delete; break;
        case InputCommand::WordBackspace: request.command = EditCommand::WordBackspace; break;
        case InputCommand::WordDelete: request.command = EditCommand::WordDelete; break;
        case InputCommand::SelectAll: request.command = EditCommand::SelectAll; break;
        case InputCommand::Copy: request.command = EditCommand::Copy; break;
        case InputCommand::Cut: request.command = EditCommand::Cut; break;
        case InputCommand::Paste: request.command = EditCommand::Paste; break;
        case InputCommand::Undo: request.command = EditCommand::Undo; break;
        case InputCommand::Redo: request.command = EditCommand::Redo; break;
        case InputCommand::Accept:
            if(mode == EditTextMode::Multiline)
                request.command = EditCommand::Newline;
            else
                request.command = EditCommand::Submit;
            break;
        case InputCommand::Submit: request.command = EditCommand::Submit; break;
        case InputCommand::Cancel: request.command = EditCommand::Cancel; break;
        case InputCommand::Newline: request.command = EditCommand::Newline; break;
        default: break;
    }
    return request;
}

b8 ValidateIntegerBounds(in IntegerBounds bounds){
    return bounds.minimum <= bounds.maximum && (bounds.policy == NumericBoundsPolicy::Reject || bounds.policy == NumericBoundsPolicy::Clamp);
}

b8 ValidateFloatBounds(in FloatBounds bounds){
    return isFinite(bounds.minimum) && isFinite(bounds.maximum) && bounds.minimum <= bounds.maximum && (bounds.policy == NumericBoundsPolicy::Reject || bounds.policy == NumericBoundsPolicy::Clamp);
}

usize SkipNumericSign(in StringView text){
    if(!text.empty() && (text[0u] == '+' || text[0u] == '-'))
        return 1u;
    return 0u;
}

NumericParseStatus ValidateIntegerGrammar(in StringView text){
    const usize begin = SkipNumericSign(text);
    if(begin == text.size())
        return NumericParseStatus::Incomplete;
    for(usize index = begin; index < text.size(); ++index){
        const u8 ch = cast<u8>(text[index]);
        if(ch < '0' || ch > '9')
            return NumericParseStatus::Invalid;
    }
    return NumericParseStatus::Complete;
}

NumericParseStatus ValidateFloatGrammar(in StringView text){
    usize index = SkipNumericSign(text);
    b8 digits = false;
    while(index < text.size() && text[index] >= '0' && text[index] <= '9'){
        digits = true;
        ++index;
    }
    if(index < text.size() && text[index] == '.'){
        ++index;
        while(index < text.size() && text[index] >= '0' && text[index] <= '9'){
            digits = true;
            ++index;
        }
    }
    if(!digits){
        if(index == text.size())
            return NumericParseStatus::Incomplete;
        return NumericParseStatus::Invalid;
    }
    if(index < text.size() && (text[index] == 'e' || text[index] == 'E')){
        ++index;
        if(index < text.size() && (text[index] == '+' || text[index] == '-'))
            ++index;
        const usize exponent = index;
        while(index < text.size() && text[index] >= '0' && text[index] <= '9')
            ++index;
        if(exponent == index){
            if(index == text.size())
                return NumericParseStatus::Incomplete;
            return NumericParseStatus::Invalid;
        }
    }
    if(index == text.size())
        return NumericParseStatus::Complete;
    return NumericParseStatus::Invalid;
}

// ASCII edge whitespace is ignored; incomplete and malformed drafts retain their classification.
Expected<i64, NumericParseStatus> ParseIntegerDraft(in StringView text){
    const StringView trimmed = trimView(text);
    const NumericParseStatus status = ValidateIntegerGrammar(trimmed);
    if(status != NumericParseStatus::Complete)
        return makeUnexpected(status);
    StringView number = trimmed;
    if(trimmed.front() == '+')
        number = trimmed.substr(1u);
    const Expected<i64> value = parseI64(number);
    if(!value.has_value())
        return makeUnexpected(NumericParseStatus::OutOfRange);
    return value.value();
}

Expected<f64, NumericParseStatus> ParseFloatDraft(in StringView text){
    const StringView trimmed = trimView(text);
    const NumericParseStatus status = ValidateFloatGrammar(trimmed);
    if(status != NumericParseStatus::Complete)
        return makeUnexpected(status);
    StringView number = trimmed;
    if(trimmed.front() == '+')
        number = trimmed.substr(1u);
    const Expected<f64> value = parseF64(number);
    if(!value.has_value() || !isFinite(value.value()))
        return makeUnexpected(NumericParseStatus::OutOfRange);
    return value.value();
}

enum<u8> EditNavigationRunClass{
    Whitespace,
    Punctuation,
    Text,
    LineBreak,
}

class MultilineTextStep{
    public usize sourceBytes = 0u;
    public usize outputBytes = 0u;
    public u8 replacement = 0u;
}

class SingleLineTextStep{
    public usize sourceBytes = 0u;
    public usize outputBytes = 0u;
    public b8 space = false;
}

Expected<EditNavigationDirection> TryTranslateEditNavigation(in InputCommandIntent intent){
    if(!intent.edit)
        return makeUnexpected(Failure());
    switch(intent.command){
    case InputCommand::Up: return EditNavigationDirection::Up;
    case InputCommand::Down: return EditNavigationDirection::Down;
    case InputCommand::PageUp: return EditNavigationDirection::PageUp;
    case InputCommand::PageDown: return EditNavigationDirection::PageDown;
    default: return makeUnexpected(Failure());
    }
}

b8 IsMutatingEditCommand(in EditCommand command){
    return
        command == EditCommand::Backspace || command == EditCommand::Delete || command == EditCommand::WordBackspace
        || command == EditCommand::WordDelete || command == EditCommand::Cut || command == EditCommand::Paste
        || command == EditCommand::Undo || command == EditCommand::Redo || command == EditCommand::Newline
    ;
}

b8 ShouldSuppressEditCommandRepeat(in EditCommand command){
    return command == EditCommand::SelectAll || command == EditCommand::Copy || command == EditCommand::Cut || command == EditCommand::Paste || command == EditCommand::Submit || command == EditCommand::Cancel;
}

EditLimits ClampEditLimits(in EditLimits limits){
    EditLimits bounded;
    bounded.maxBytes = min(limits.maxBytes, s_EditMaxBytes);
    bounded.maxHistoryRecords = min(limits.maxHistoryRecords, s_EditMaxHistoryRecords);
    bounded.maxHistoryBytes = min(limits.maxHistoryBytes, s_EditMaxHistoryBytes);
    return bounded;
}

b8 IsSingleLineScalar(in u32 scalar){
    return scalar != 0u && scalar != s_EditUnicodeLineFeed && scalar != s_EditUnicodeCarriageReturn && scalar != s_TextUnicodeLineSeparator && scalar != s_TextUnicodeParagraphSeparator;
}

b8 IsSingleLineSpaceScalar(in u32 scalar){
    return (scalar >= s_EditUnicodeTab && scalar <= s_EditUnicodeCarriageReturn) || scalar == s_EditUnicodeNextLine || scalar == s_TextUnicodeLineSeparator || scalar == s_TextUnicodeParagraphSeparator;
}

b8 IsSingleLineRejectedScalar(in u32 scalar){
    return !IsSingleLineSpaceScalar(scalar) && (scalar < s_TextUnicodeSpace || scalar == s_TextUnicodeDelete);
}

b8 IsMultilineLineBreakScalar(in u32 scalar){
    return scalar == s_EditUnicodeCarriageReturn || scalar == s_EditUnicodeNextLine || scalar == s_TextUnicodeLineSeparator || scalar == s_TextUnicodeParagraphSeparator;
}

b8 IsCanonicalMultilineScalar(in u32 scalar){
    return scalar == s_EditUnicodeLineFeed || (scalar >= s_TextUnicodeSpace && (scalar < s_TextUnicodeDelete || scalar > s_TextUnicodeC1Last) && scalar != s_TextUnicodeLineSeparator && scalar != s_TextUnicodeParagraphSeparator);
}

b8 IsEditWhitespaceScalar(in u32 scalar){
    return
        (scalar >= s_EditUnicodeTab && scalar <= s_EditUnicodeCarriageReturn) || scalar == s_TextUnicodeSpace || scalar == s_EditUnicodeNextLine || scalar == s_EditUnicodeNoBreakSpace
        || scalar == s_EditUnicodeOghamSpaceMark || (scalar >= s_EditUnicodeEnQuad && scalar <= s_EditUnicodeHairSpace) || scalar == s_TextUnicodeLineSeparator
        || scalar == s_TextUnicodeParagraphSeparator || scalar == s_EditUnicodeNarrowNoBreakSpace || scalar == s_EditUnicodeMediumMathematicalSpace || scalar == s_EditUnicodeIdeographicSpace
    ;
}

b8 IsEditAsciiPunctuationScalar(in u32 scalar){
    return
        (scalar >= s_EditAsciiExclamation && scalar <= s_EditAsciiSlash)
        || (scalar >= s_EditAsciiColon && scalar <= s_EditAsciiAt)
        || (scalar >= s_EditAsciiLeftBracket && scalar <= s_EditAsciiGrave)
        || (scalar >= s_EditAsciiLeftBrace && scalar <= s_EditAsciiTilde)
    ;
}

EditNavigationRunClass ClassifyEditNavigationScalar(in u32 scalar){
    if(IsEditWhitespaceScalar(scalar))
        return EditNavigationRunClass::Whitespace;
    if(IsEditAsciiPunctuationScalar(scalar))
        return EditNavigationRunClass::Punctuation;
    return EditNavigationRunClass::Text;
}

// The caret has a one-second cycle. Invalid or nonpositive deltas leave its phase unchanged.
f64 AdvanceCaretPhase(in f64 phase, in f64 deltaSeconds){
    const b8 validPhase = isFinite(phase) && phase > 0.0;
    const b8 validDelta = isFinite(deltaSeconds) && deltaSeconds > 0.0;
    f64 phaseIn = 0.0;
    if(validPhase)
        phaseIn = phase;
    f64 deltaIn = 0.0;
    if(validDelta)
        deltaIn = deltaSeconds;
    const f64 wrappedPhase = phaseIn - floor(phaseIn);
    if(!validDelta)
        return wrappedPhase;
    const f64 wrappedDelta = deltaIn - floor(deltaIn);
    const f64 next = wrappedPhase + wrappedDelta;
    if(next >= 1.0)
        return next - 1.0;
    return next;
}

Expected<MultilineTextStep> TryBuildMultilineTextStep(in StringView source, in usize offset, in u32 scalar, in usize decodedBytes){
    MultilineTextStep outStep;
    outStep.sourceBytes = decodedBytes;
    const b8 lineBreak = IsMultilineLineBreakScalar(scalar);
    if(lineBreak || scalar == s_EditUnicodeTab){
        if(lineBreak)
            outStep.replacement = cast<u8>(s_EditUnicodeLineFeed);
        else
            outStep.replacement = cast<u8>(s_TextUnicodeSpace);
        outStep.outputBytes = 1u;
        if(scalar == s_EditUnicodeCarriageReturn && offset + outStep.sourceBytes < source.size() && cast<u32>(cast<u8>(source[offset + outStep.sourceBytes])) == s_EditUnicodeLineFeed)
            ++outStep.sourceBytes;
        return outStep;
    }
    if(!IsCanonicalMultilineScalar(scalar))
        return makeUnexpected(Failure());
    outStep.outputBytes = outStep.sourceBytes;
    return outStep;
}

Expected<SingleLineTextStep> TryBuildSingleLineTextStep(in StringView source, in usize offset, in u32 scalar, in usize decodedBytes){
    SingleLineTextStep outStep;
    if(IsSingleLineRejectedScalar(scalar))
        return makeUnexpected(Failure());
    const b8 space = IsSingleLineSpaceScalar(scalar);
    outStep.sourceBytes = decodedBytes;
    if(space)
        outStep.outputBytes = 1u;
    else
        outStep.outputBytes = outStep.sourceBytes;
    outStep.space = space;
    if(scalar == s_EditUnicodeCarriageReturn && offset + outStep.sourceBytes < source.size() && cast<u32>(cast<u8>(source[offset + outStep.sourceBytes])) == s_EditUnicodeLineFeed)
        ++outStep.sourceBytes;
    return outStep;
}

b8 ValidateGraphemeText(in StringView text, in b8 singleLine){
    if(text.size() > cast<usize>(i32.max))
        return false;
    usize offset = 0u;
    while(offset < text.size()){
        u32 scalar = 0u;
        usize byteCount = 0u;
        if(!tryDecodeUtf8Scalar(text.substr(offset, s_EditUtf8MaxSequenceBytes), scalar, byteCount))
            return false;
        if(singleLine && !IsSingleLineScalar(scalar))
            return false;
        offset += byteCount;
    }
    return true;
}

// Canonical multiline text contains LF and ordinary UTF8 scalars; all other ASCII/C1 controls and line separators fail.
b8 ValidateMultilineText(in StringView text){
    if(text.size() > cast<usize>(i32.max))
        return false;
    usize offset = 0u;
    while(offset < text.size()){
        u32 scalar = 0u;
        usize byteCount = 0u;
        if(!tryDecodeUtf8Scalar(text.substr(offset, s_EditUtf8MaxSequenceBytes), scalar, byteCount) || !IsCanonicalMultilineScalar(scalar))
            return false;
        offset += byteCount;
    }
    return true;
}

Expected<SingleLineTextStep> ReadSingleLineTextStep(in StringView source, in usize offset){
    u32 scalar = 0u;
    usize byteCount = 0u;
    if(!tryDecodeUtf8Scalar(source.substr(offset, s_EditUtf8MaxSequenceBytes), scalar, byteCount))
        return makeUnexpected(Failure());
    return TryBuildSingleLineTextStep(source, offset, scalar, byteCount);
}

Expected<MultilineTextStep> ReadMultilineTextStep(in StringView source, in usize offset){
    u32 scalar = 0u;
    usize byteCount = 0u;
    if(!tryDecodeUtf8Scalar(source.substr(offset, s_EditUtf8MaxSequenceBytes), scalar, byteCount))
        return makeUnexpected(Failure());
    return TryBuildMultilineTextStep(source, offset, scalar, byteCount);
}

usize LowerBoundEditBoundaryIndex(in Span<usize> boundaries, in usize position){
    usize first = 0u;
    usize count = boundaries.size();
    while(count > 0u){
        const usize step = count / 2u;
        const usize mid = first + step;
        if(boundaries[mid] < position){
            first = mid + 1u;
            count -= step + 1u;
        }
        else{
            count = step;
        }
    }
    return first;
}

b8 IsEditBoundary(in Span<usize> boundaries, in usize position){
    const usize index = LowerBoundEditBoundaryIndex(boundaries, position);
    return index < boundaries.size() && boundaries[index] == position;
}

usize PreviousEditBoundary(in Span<usize> boundaries, in usize position){
    const usize index = LowerBoundEditBoundaryIndex(boundaries, position);
    if(index == 0u)
        return 0u;
    return boundaries[index - 1u];
}

usize NextEditBoundary(in Span<usize> boundaries, in usize textSize, in usize position){
    usize index = LowerBoundEditBoundaryIndex(boundaries, position);
    if(index < boundaries.size() && boundaries[index] == position)
        ++index;
    if(index >= boundaries.size())
        return textSize;
    return boundaries[index];
}

EditNavigationRunClass ClassifyEditNavigationOffset(in StringView text, in usize offset){
    u32 codePoint = 0u;
    usize byteCount = 0u;
    if(!tryDecodeUtf8CodePoint(text.substr(offset, s_EditUtf8MaxSequenceBytes), codePoint, byteCount))
        return EditNavigationRunClass::Text;
    return ClassifyEditNavigationScalar(codePoint);
}

EditNavigationRunClass ClassifyEditWordRangeOffset(in StringView text, in usize offset){
    if(text[offset] == '\n')
        return EditNavigationRunClass::LineBreak;
    return ClassifyEditNavigationOffset(text, offset);
}

usize ResolveEditWordBoundary(in StringView text, in Span<usize> boundaries, in usize position, in b8 forward){
    if((forward && position == text.size()) || (!forward && position == 0u) || boundaries.empty())
        return position;
    usize cursor = LowerBoundEditBoundaryIndex(boundaries, position);
    const usize lastBoundaryIndex = boundaries.size() - 1u;
    if(forward){
        const EditNavigationRunClass category = ClassifyEditNavigationOffset(text, position);
        while(cursor < lastBoundaryIndex && ClassifyEditNavigationOffset(text, boundaries[cursor]) == category)
            ++cursor;
        while(cursor < lastBoundaryIndex && ClassifyEditNavigationOffset(text, boundaries[cursor]) == EditNavigationRunClass::Whitespace)
            ++cursor;
        return boundaries[cursor];
    }
    while(cursor != 0u && ClassifyEditNavigationOffset(text, boundaries[cursor - 1u]) == EditNavigationRunClass::Whitespace)
        --cursor;
    if(cursor == 0u)
        return 0u;
    const EditNavigationRunClass category = ClassifyEditNavigationOffset(text, boundaries[cursor - 1u]);
    while(cursor != 0u && ClassifyEditNavigationOffset(text, boundaries[cursor - 1u]) == category)
        --cursor;
    return boundaries[cursor];
}

Expected<EditWordRange> ResolveEditWordRangeAt(in StringView text, in Span<usize> boundaries, in usize position){
    const usize requested = LowerBoundEditBoundaryIndex(boundaries, position);
    if(requested >= boundaries.size() || boundaries[requested] != position)
        return makeUnexpected(Failure());
    if(text.empty())
        return EditWordRange();
    usize origin = requested;
    if(position == text.size())
        origin = requested - 1u;
    const EditNavigationRunClass run = ClassifyEditWordRangeOffset(text, boundaries[origin]);
    usize first = origin;
    usize last = origin + 1u;
    const usize lastBoundaryIndex = boundaries.size() - 1u;
    while(first != 0u && ClassifyEditWordRangeOffset(text, boundaries[first - 1u]) == run)
        --first;
    while(last < lastBoundaryIndex && ClassifyEditWordRangeOffset(text, boundaries[last]) == run)
        ++last;
    EditWordRange range;
    range.begin = boundaries[first];
    range.end = boundaries[last];
    return range;
}

Expected<usize> TryResolveEditMoveTarget(
    in StringView text,
    in Span<usize> boundaries,
    in EditTextMode textMode,
    in usize anchor,
    in usize caret,
    in EditMove movement,
    in b8 extend
){
    if(cast<u8>(movement) > cast<u8>(EditMove::DocumentEnd))
        return makeUnexpected(Failure());
    usize target = caret;
    if(!extend && anchor != caret && (movement == EditMove::Left || movement == EditMove::Right)){
        if(movement == EditMove::Left)
            target = min(anchor, caret);
        else
            target = max(anchor, caret);
    }
    else{
        switch(movement){
        case EditMove::Left:
            target = PreviousEditBoundary(boundaries, target);
            break;
        case EditMove::Right:
            target = NextEditBoundary(boundaries, text.size(), target);
            break;
        case EditMove::Home:
            if(textMode == EditTextMode::SingleLine){
                target = 0u;
            }
            else{
                while(target != 0u && text[target - 1u] != '\n')
                    --target;
            }
            break;
        case EditMove::End:
            if(textMode == EditTextMode::SingleLine){
                target = text.size();
            }
            else{
                while(target < text.size() && text[target] != '\n')
                    ++target;
            }
            break;
        case EditMove::WordLeft:
            target = ResolveEditWordBoundary(text, boundaries, target, false);
            break;
        case EditMove::WordRight:
            target = ResolveEditWordBoundary(text, boundaries, target, true);
            break;
        case EditMove::DocumentHome:
            target = 0u;
            break;
        case EditMove::DocumentEnd:
            target = text.size();
            break;
        }
    }
    return target;
}

b8 TryResolveEditNavigationPreferredX(in f32 preferredX, mut f32 outPreferredX, mut b8 outValid){
    if(!isFinite(preferredX))
        return false;
    outPreferredX = preferredX;
    outValid = true;
    return true;
}

void ClearEditNavigationPreferredX(mut f32 outPreferredX, mut b8 outValid){
    outPreferredX = 0.0f;
    outValid = false;
}

b8 MatchesEditModelSurrounding(
    in TextAreaModelStamp currentStamp,
    in StringView currentText,
    in TextAreaModelStamp expectedStamp,
    in StringView expectedText
){
    return currentStamp.revision == expectedStamp.revision
        && currentStamp.externalRevision == expectedStamp.externalRevision
        && currentStamp.selectionGeneration == expectedStamp.selectionGeneration
        && currentText == expectedText
        && currentStamp.anchor == expectedStamp.anchor
        && currentStamp.caret == expectedStamp.caret;
}

b8 MatchesEditModelSnapshot(
    in TextAreaModelStamp currentStamp,
    in StringView currentText,
    in EditCompositionView currentComposition,
    in TextAreaModelStamp expectedStamp,
    in StringView expectedText,
    in EditCompositionView expectedComposition,
    in StringView expectedPreedit
){
    return currentStamp == expectedStamp
        && currentText == expectedText
        && currentComposition.active == expectedComposition.active
        && currentComposition.text == expectedPreedit
        && currentComposition.anchor == expectedComposition.anchor
        && currentComposition.caret == expectedComposition.caret
        && currentComposition.replacementStart == expectedComposition.replacementStart
        && currentComposition.replacementEnd == expectedComposition.replacementEnd;
}

NumericParseStatus EvaluateIntegerDraftStatus(in StringView text, in IntegerBounds bounds){
    if(!ValidateIntegerBounds(bounds))
        return NumericParseStatus::Invalid;
    const Expected<i64, NumericParseStatus> parsed = ParseIntegerDraft(text);
    if(!parsed.has_value())
        return parsed.error();
    const i64 value = parsed.value();
    if(value < bounds.minimum || value > bounds.maximum)
        return NumericParseStatus::OutOfRange;
    return NumericParseStatus::Complete;
}

NumericParseStatus EvaluateFloatDraftStatus(in StringView text, in FloatBounds bounds){
    if(!ValidateFloatBounds(bounds))
        return NumericParseStatus::Invalid;
    const Expected<f64, NumericParseStatus> parsed = ParseFloatDraft(text);
    if(!parsed.has_value())
        return parsed.error();
    const f64 value = parsed.value();
    if(value < bounds.minimum || value > bounds.maximum)
        return NumericParseStatus::OutOfRange;
    return NumericParseStatus::Complete;
}

b8 DifferentFloatEditValues(in f64 lhs, in f64 rhs){
    return bit_cast<u64>(lhs) != bit_cast<u64>(rhs);
}

Expected<EditMove> TryMapEditCommandToMove(in EditCommand command){
    switch(command){
    case EditCommand::Left: return EditMove::Left;
    case EditCommand::Right: return EditMove::Right;
    case EditCommand::Home: return EditMove::Home;
    case EditCommand::End: return EditMove::End;
    case EditCommand::WordLeft: return EditMove::WordLeft;
    case EditCommand::WordRight: return EditMove::WordRight;
    case EditCommand::DocumentHome: return EditMove::DocumentHome;
    case EditCommand::DocumentEnd: return EditMove::DocumentEnd;
    default: return makeUnexpected(Failure());
    }
}

b8 TryMapEditCommandToPassiveResult(in EditCommand command, mut EditCommandResult inOutResult){
    switch(command){
    case EditCommand::Copy: inOutResult.clipboard = EditClipboardAction::Copy; return true;
    case EditCommand::Cut: inOutResult.clipboard = EditClipboardAction::Cut; return true;
    case EditCommand::Paste: inOutResult.clipboard = EditClipboardAction::Paste; return true;
    case EditCommand::Submit: inOutResult.submitted = true; return true;
    case EditCommand::Cancel: inOutResult.cancelled = true; return true;
    default: return false;
    }
}

void ComputeEditWordEraseDistances(in b8 forward, in usize caret, in usize boundary, mut usize outBeforeBytes, mut usize outAfterBytes){
    if(forward){
        outBeforeBytes = 0u;
        outAfterBytes = boundary - caret;
    }
    else{
        outBeforeBytes = caret - boundary;
        outAfterBytes = 0u;
    }

}


