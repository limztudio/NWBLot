void VerifyCppUnwindPreservesExceptionAcrossNestedLambdas(){
    const CppUnwindCallback probe = CppUnwindCallback();
    Func<u32()> callback = lambda[]() -> u32{ ThrowTestException<UnexpectedReadFailure>(UnexpectedReadFailure()); return 0u; };
    in IUnwindCallback dispatch = probe;
    EXPECT_TRUE(ThrowsException<UnexpectedReadFailure>(lambda[in dispatch, mut callback]() -> void{ dispatch.record(callback); }));
}

