void VerifyTelemetry_CaptureScopeRestoresLoggerAndStopsDiagnosticsAfterDestruction(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryCaptureSession session = TelemetryCaptureSession(testArena.arena);
    session.setCaptureOptions(CaptureAll());

    CapturingLogger previousLogger = CapturingLogger();
    native(mut session, mut previousLogger){
        {
            LoggerRegistrationGuard previousRegistration(previousLogger);
            {
                CaptureSessionCaptureScope captureScope(session);
                NWB_LOGGER_ESSENTIAL_INFO(NWB_TEXT("scope text"));
                CaptureDiagnosticEvent(DiagnosticEventRecord{
                    .event = DiagnosticEventName::s_Error,
                    .category = TelemetryCaptureCasesDetail::s_ScopeDiagnosticCategory,
                    .message = "scope diagnostic",
                    .file = "scope.cpp",
                    .line = 67u,
                });
            }
            NWB_LOGGER_ESSENTIAL_INFO(NWB_TEXT("after scope"));
        }
        CaptureDiagnosticEvent(DiagnosticEventRecord{
            .event = DiagnosticEventName::s_Error,
            .category = TelemetryCaptureCasesDetail::s_ScopeDiagnosticCategory,
            .message = "ignored after scope",
        });
    }

    EXPECT_EQ(previousLogger.messageCount(), 2u);
    EXPECT_TRUE(SawCapturedMessage(previousLogger, "scope text"));
    EXPECT_TRUE(SawCapturedMessage(previousLogger, "after scope"));
    EXPECT_EQ(session.eventCount(), 2u);
}

void VerifyTelemetry_TextCaptureCountsRejectedPayloadsWithoutCountingFilteredEventsAndStillForwards(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    CapturingLogger forwardLogger = CapturingLogger();
    native(mut testArena, mut recorder, mut forwardLogger){
        TextLogCaptureLogger capture(recorder, &forwardLogger);
        Core::Common::LogString message(NWB_TEXT("capture admission"), testArena.arena);
        const auto invalidType = static_cast<LogType::Enum>(0xffu);
        capture.enqueue(message, invalidType);
        EXPECT_EQ(capture.droppedTextLogCount(), 0u);
        EXPECT_EQ(recorder.eventCount(), 0u);

        recorder.setCaptureOptions(CaptureAll());
        capture.enqueue(message, invalidType);
        EXPECT_EQ(capture.droppedTextLogCount(), 1u);
        EXPECT_EQ(recorder.eventCount(), 0u);
        capture.enqueue(message, LogType::Info);
        EXPECT_EQ(capture.droppedTextLogCount(), 1u);
        EXPECT_EQ(recorder.eventCount(), 1u);

        recorder.setCaptureOptions(CaptureDisabled());
        capture.enqueue(message, invalidType);
        EXPECT_EQ(capture.droppedTextLogCount(), 1u);
        EXPECT_EQ(recorder.eventCount(), 0u);
    }
    EXPECT_EQ(forwardLogger.messageCount(), 4u);
    EXPECT_TRUE(SawCapturedMessage(forwardLogger, "capture admission"));
}

void VerifyTelemetry_DiagnosticPayloadPreservesBoundedTextAndRejectsCorruptedHeader(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    native(mut testArena, mut payload){
        constexpr Array<char, 3> s_Message = { 'd', 0, 'm' };
        const DiagnosticEventRecord source{
            .event = AStringView("error.trailing").substr(0u, 5u),
            .category = "unit_category",
            .expression = "value != nullptr",
            .message = AStringView(s_Message.data(), s_Message.size()),
            .file = "diagnostic_test.cpp",
            .instructionPointer = 0x1234u,
            .line = 77u,
            .terminatesProcess = true,
        };
        ASSERT_TRUE(Core::Telemetry::BuildDiagnosticPayload(source, testArena.arena, payload));
        auto parsed = Core::Telemetry::ParseDiagnosticPayload(payload.data(), payload.size());
        ASSERT_TRUE(parsed.has_value());
        EXPECT_EQ(AStringView(parsed.value().event), source.event);
        EXPECT_EQ(AStringView(parsed.value().message), source.message);

        payload[0u] = 0u;
        EXPECT_FALSE(Core::Telemetry::ParseDiagnosticPayload(payload.data(), payload.size()).has_value());
    }
}

void VerifyTelemetry_DiagnosticPayloadPreservesAliasedTextFields(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    native(mut testArena, mut payload){
        constexpr AStringView s_Text = "event category expression message file";
        payload.reserve(512u);
        payload.resize(s_Text.size());
        NWB_MEMCPY(payload.data(), payload.size(), s_Text.data(), s_Text.size());
        const AStringView text(reinterpret_cast<const char*>(payload.data()), payload.size());
        const DiagnosticEventRecord record{
            .event = text.substr(0u, 5u),
            .category = text.substr(6u, 8u),
            .expression = text.substr(15u, 10u),
            .message = text.substr(26u, 7u),
            .file = text.substr(34u, 4u),
        };
        ASSERT_TRUE(Core::Telemetry::BuildDiagnosticPayload(record, testArena.arena, payload));
        const auto parsed = Core::Telemetry::ParseDiagnosticPayload(payload.data(), payload.size());
        ASSERT_TRUE(parsed.has_value());
        EXPECT_EQ(parsed.value().event, "event");
        EXPECT_EQ(parsed.value().category, "category");
        EXPECT_EQ(parsed.value().expression, "expression");
        EXPECT_EQ(parsed.value().message, "message");
        EXPECT_EQ(parsed.value().file, "file");
        const DiagnosticEventRecord roundtrip{
            .event = parsed.value().event,
            .category = parsed.value().category,
            .expression = parsed.value().expression,
            .message = parsed.value().message,
            .file = parsed.value().file,
        };
        ASSERT_TRUE(Core::Telemetry::BuildDiagnosticPayload(roundtrip, testArena.arena, payload));
        const auto rebuilt = Core::Telemetry::ParseDiagnosticPayload(payload.data(), payload.size());
        ASSERT_TRUE(rebuilt.has_value());
        EXPECT_EQ(rebuilt.value().message, "message");
        EXPECT_EQ(rebuilt.value().file, "file");
    }
}

void VerifyTelemetry_DiagnosticCaptureGuardDoesNotReplaceExistingCallback(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    u32 callbackCount = 0u;
    native(mut recorder, mut callbackCount){
        TelemetryCaptureCasesDetail::g_ExistingDiagnosticCallbackCount = 0u;
        SetDiagnosticEventCallback(TelemetryCaptureCasesDetail::ExistingDiagnosticCallback);
        {
            DiagnosticCaptureGuard guard(recorder);
            EXPECT_FALSE(guard.installed());
            CaptureDiagnosticEvent(DiagnosticEventRecord{
                .event = DiagnosticEventName::s_Error,
                .message = "existing callback should keep ownership",
            });
        }
        ClearDiagnosticEventCallback(TelemetryCaptureCasesDetail::ExistingDiagnosticCallback);
        callbackCount = TelemetryCaptureCasesDetail::g_ExistingDiagnosticCallbackCount;
    }
    EXPECT_EQ(callbackCount, 1u);
    EXPECT_EQ(recorder.eventCount(), 0u);
}

void VerifyTelemetry_DiagnosticObserverReusesPreparedStorageAndCountsPoolOverflow(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    const ArenaMemoryStats prepared = testArena.arena.memoryStats();
    native(mut recorder){
        const DiagnosticEventRecord source{ .event = TelemetryCaptureCasesDetail::s_ErrorEvent, .message = "bounded observer", };
        for(u32 iteration = 0u; iteration < 3u; ++iteration){
            recorder.setCaptureOptions(CaptureAll());
            DiagnosticCaptureGuard guard(recorder);
            ASSERT_TRUE(guard.installed());
            static_assert(noexcept(guard.capture(source)));
            guard.setFrameIndex(iteration);
            guard.setStreamId(9u);
            for(usize eventIndex = 0u; eventIndex < Core::Telemetry::s_DiagnosticCaptureEventCapacity; ++eventIndex)
                guard.capture(source);
            guard.capture(source);
            EXPECT_EQ(recorder.eventCount(), Core::Telemetry::s_DiagnosticCaptureEventCapacity);
            EXPECT_EQ(recorder.droppedDiagnosticCount(), iteration + 1u);
            const auto* const first = recorder.view().eventAt(0u);
            ASSERT_NE(first, nullptr);
            EXPECT_EQ(first->header.frameIndex, iteration);
            EXPECT_EQ(first->header.streamId, 9u);
            recorder.clear();
        }
    }
    const ArenaMemoryStats reused = testArena.arena.memoryStats();
    EXPECT_EQ(reused.allocationCount, prepared.allocationCount);
    EXPECT_EQ(reused.reallocationCount, prepared.reallocationCount);
    EXPECT_EQ(reused.deallocationCount, prepared.deallocationCount);
}

void VerifyTelemetry_DiagnosticObserverRejectsOversizeWithoutTruncatingDirectDiagnostics(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    DiagnosticCaptureGuard guard = DiagnosticCaptureGuard(recorder);
    ASSERT_TRUE(guard.installed());
    native(mut testArena, mut recorder, mut guard){
        AString<Core::Telemetry::TelemetryArena> message(testArena.arena);
        constexpr usize s_MessageCapacity = Core::Telemetry::s_DiagnosticCapturePayloadCapacity - sizeof(Core::Telemetry::EncodedDiagnosticPayloadHeader) - 5u;
        message.resize(s_MessageCapacity + 1u, 'x');
        DiagnosticEventRecord source{ .event = TelemetryCaptureCasesDetail::s_ErrorEvent, .message = AStringView(message.data(), s_MessageCapacity), };
        const auto prepared = testArena.arena.memoryStats();
        guard.capture(source);
        ASSERT_EQ(recorder.eventCount(), 1u);
        const auto* const boundedEvent = recorder.view().eventAt(0u);
        ASSERT_NE(boundedEvent, nullptr);
        EXPECT_EQ(boundedEvent->payload.size(), Core::Telemetry::s_DiagnosticCapturePayloadCapacity);
        source.message = AStringView(message);
        guard.capture(source);
        EXPECT_EQ(recorder.droppedDiagnosticCount(), 1u);
        EXPECT_EQ(recorder.eventCount(), 1u);
        const auto captured = testArena.arena.memoryStats();
        EXPECT_EQ(captured.allocationCount, prepared.allocationCount);
        EXPECT_EQ(captured.reallocationCount, prepared.reallocationCount);

        ASSERT_TRUE(RecordDiagnostic(recorder, source));
        const auto* const directEvent = recorder.view().eventAt(1u);
        ASSERT_NE(directEvent, nullptr);
        const auto parsed = Core::Telemetry::ParseDiagnosticPayload(directEvent->payload.data(), directEvent->payload.size());
        ASSERT_TRUE(parsed.has_value());
        EXPECT_EQ(AStringView(parsed.value().message), AStringView(message));
        EXPECT_EQ(boundedEvent->payload.size(), Core::Telemetry::s_DiagnosticCapturePayloadCapacity);
        EXPECT_EQ(recorder.droppedDiagnosticCount(), 1u);
    }
}

void VerifyTelemetry_DiagnosticObserverCapturesDuringUnwindWithoutAllocating(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    DiagnosticCaptureGuard guard = DiagnosticCaptureGuard(recorder);
    ASSERT_TRUE(guard.installed());
    const ArenaMemoryStats prepared = testArena.arena.memoryStats();
    b8 caught = false;
    native(mut caught){
        struct UnwindMarker{};
        try{
            ScopeExit capture([]()noexcept{
                CaptureDiagnosticEvent(DiagnosticEventRecord{ .event = "warning", .category = "unwind", .message = "cleanup failed", });
            });
            throw UnwindMarker{};
        }
        catch(const UnwindMarker&){
            caught = true;
        }
    }
    const ArenaMemoryStats captured = testArena.arena.memoryStats();
    EXPECT_TRUE(caught);
    EXPECT_EQ(recorder.eventCount(), 1u);
    EXPECT_EQ(recorder.droppedDiagnosticCount(), 0u);
    EXPECT_EQ(captured.allocationCount, prepared.allocationCount);
    EXPECT_EQ(captured.reallocationCount, prepared.reallocationCount);
    native(in recorder){
        const auto* const event = recorder.view().eventAt(0u);
        ASSERT_NE(event, nullptr);
        const auto parsed = Core::Telemetry::ParseDiagnosticPayload(event->payload.data(), event->payload.size());
        ASSERT_TRUE(parsed.has_value());
        EXPECT_EQ(parsed.value().category, "unwind");
    }
}

void VerifyTelemetry_DiagnosticObserverPreservesPublishedRecordsAcrossFlagTogglesAndFiltersDisabledCapture(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    DiagnosticCaptureGuard guard = DiagnosticCaptureGuard(recorder);
    ASSERT_TRUE(guard.installed());
    native(mut testArena, mut recorder, mut guard){
        const DiagnosticEventRecord source{ .event = TelemetryCaptureCasesDetail::s_ErrorEvent, .message = "retained", };
        guard.capture(source);
        ASSERT_EQ(recorder.eventCount(), 1u);
        const auto* const retained = recorder.view().eventAt(0u);
        ASSERT_NE(retained, nullptr);
        const auto prepared = testArena.arena.memoryStats();
        for(u32 iteration = 0u; iteration < 3u; ++iteration){
            recorder.setCaptureOptions(CapturePerfOnly());
            guard.capture(source);
            EXPECT_EQ(recorder.droppedDiagnosticCount(), 0u);
            EXPECT_EQ(recorder.view().eventAt(0u), retained);
            recorder.setCaptureOptions(CaptureAll());
            guard.capture(source);
            EXPECT_EQ(recorder.eventCount(), iteration + 2u);
        }
        const auto toggled = testArena.arena.memoryStats();
        EXPECT_EQ(toggled.allocationCount, prepared.allocationCount);
        EXPECT_EQ(toggled.reallocationCount, prepared.reallocationCount);
        EXPECT_EQ(toggled.deallocationCount, prepared.deallocationCount);
        recorder.setCaptureOptions(CaptureDisabled());
        guard.capture(source);
        EXPECT_EQ(recorder.eventCount(), 0u);
        EXPECT_EQ(recorder.droppedDiagnosticCount(), 0u);
        EXPECT_LT(testArena.arena.memoryStats().usedBytes, prepared.usedBytes);
        recorder.setCaptureOptions(CaptureAll());
        guard.capture(source);
        EXPECT_EQ(recorder.eventCount(), 1u);
    }
}

void VerifyTelemetry_DiagnosticObserverDoesNotGrowPublicationStorageWhenOrdinaryEventsFillIt(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    DiagnosticCaptureGuard guard = DiagnosticCaptureGuard(recorder);
    ASSERT_TRUE(guard.installed());
    native(mut testArena, mut recorder, mut guard){
        for(usize eventIndex = 0u; eventIndex < Core::Telemetry::s_DiagnosticCaptureEventCapacity; ++eventIndex)
            ASSERT_TRUE(recorder.recordBinary(EventKind::PerfFrame, 0u, nullptr, 0u));
        const auto filled = testArena.arena.memoryStats();
        const DiagnosticEventRecord source{ .event = TelemetryCaptureCasesDetail::s_ErrorEvent, .message = "publication full", };
        guard.capture(source);
        EXPECT_EQ(recorder.droppedDiagnosticCount(), 1u);
        EXPECT_EQ(testArena.arena.memoryStats().allocationCount, filled.allocationCount);
        EXPECT_EQ(testArena.arena.memoryStats().reallocationCount, filled.reallocationCount);
        recorder.clear();
        guard.capture(source);
        EXPECT_EQ(recorder.eventCount(), 1u);
    }
}

void VerifyTelemetry_DiagnosticObserverPreservesOrderingAndPayloadLifetimeDuringBuilderReentry(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    DiagnosticCaptureGuard guard = DiagnosticCaptureGuard(recorder);
    ASSERT_TRUE(guard.installed());
    native(mut testArena, mut recorder){
        b8 captureDidNotAllocate = false;
        ASSERT_TRUE(recorder.recordBuiltPayload(EventKind::PerfFrame, 7u, 3u, [&](Core::Telemetry::TelemetryArena&, TelemetryBytes& payload){
            const auto before = testArena.arena.memoryStats();
            CaptureDiagnosticEvent(DiagnosticEventRecord{ .event = TelemetryCaptureCasesDetail::s_ErrorEvent, .message = "builder callback", });
            const auto after = testArena.arena.memoryStats();
            captureDidNotAllocate = before.allocationCount == after.allocationCount && before.reallocationCount == after.reallocationCount;
            payload.push_back(17u);
            return recorder.recordBinary(EventKind::MemoryFrame, 8u, nullptr, 0u);
        }));
        ASSERT_TRUE(captureDidNotAllocate);
        ASSERT_EQ(recorder.eventCount(), 3u);
        const auto events = recorder.view();
        EXPECT_EQ(events.eventAt(0u)->header.kind, EventKind::Diagnostic);
        EXPECT_EQ(events.eventAt(1u)->header.kind, EventKind::MemoryFrame);
        EXPECT_EQ(events.eventAt(2u)->header.kind, EventKind::PerfFrame);
        const auto* const diagnostic = events.eventAt(0u);
        ASSERT_TRUE(recorder.recordBinary(EventKind::PerfFrame, 9u, nullptr, 0u));
        EXPECT_EQ(events.eventAt(0u), diagnostic);
        const auto parsed = Core::Telemetry::ParseDiagnosticPayload(diagnostic->payload.data(), diagnostic->payload.size());
        ASSERT_TRUE(parsed.has_value());
        EXPECT_EQ(parsed.value().message, "builder callback");
    }
}

void VerifyTelemetry_ConcurrentDiagnosticObserversAccountForEveryAdmittedAttempt(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    DiagnosticCaptureGuard guard = DiagnosticCaptureGuard(recorder);
    ASSERT_TRUE(guard.installed());
    const usize s_AttemptsPerThread = 256u;
    const ArenaMemoryStats prepared = testArena.arena.memoryStats();
    native(in s_AttemptsPerThread, mut guard){
        const DiagnosticEventRecord source{ .event = TelemetryCaptureCasesDetail::s_ErrorEvent, .message = "concurrent bounded observer", };
        AtomicFlag start;
        const auto capture = [&]()noexcept{
            while(!start.test(MemoryOrder::acquire))
                start.wait(false, MemoryOrder::acquire);
            for(usize attempt = 0u; attempt < s_AttemptsPerThread; ++attempt)
                guard.capture(source);
        };
        Thread first(capture);
        Thread second(capture);
        start.testAndSet(MemoryOrder::release);
        start.notifyAll();
        first.join();
        second.join();
    }
    const ArenaMemoryStats captured = testArena.arena.memoryStats();
    EXPECT_GT(recorder.eventCount(), 0u);
    EXPECT_LE(recorder.eventCount(), s_DiagnosticCaptureEventCapacity);
    EXPECT_EQ(recorder.eventCount() + recorder.droppedDiagnosticCount(), s_AttemptsPerThread * 2u);
    EXPECT_EQ(captured.allocationCount, prepared.allocationCount);
    EXPECT_EQ(captured.reallocationCount, prepared.reallocationCount);
    const u64 dropped = recorder.droppedDiagnosticCount();
    recorder.setCaptureOptions(CaptureDisabled());
    native(mut guard){
        const DiagnosticEventRecord source{ .event = TelemetryCaptureCasesDetail::s_ErrorEvent, .message = "concurrent bounded observer", };
        guard.capture(source);
    }
    EXPECT_EQ(recorder.droppedDiagnosticCount(), dropped);
    EXPECT_EQ(recorder.eventCount(), 0u);
}

void VerifyTelemetry_DiagnosticCaptureGuardConcurrentLifetimeStress(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    native(mut recorder){
        AtomicFlag captureThreadStarted;
        AtomicFlag stopCaptureThread;
        Thread captureThread([&captureThreadStarted, &stopCaptureThread]()noexcept{
            captureThreadStarted.testAndSet(MemoryOrder::release);
            captureThreadStarted.notifyAll();
            while(!stopCaptureThread.test(MemoryOrder::acquire)){
                CaptureDiagnosticEvent(DiagnosticEventRecord{
                    .event = DiagnosticEventName::s_Error,
                    .category = TelemetryCaptureCasesDetail::s_TelemetryGuardCategory,
                    .message = "capture during destruction",
                });
                YieldThread();
            }
        });

        while(!captureThreadStarted.test(MemoryOrder::acquire))
            captureThreadStarted.wait(false, MemoryOrder::acquire);

        constexpr u32 s_IterationCount = 64u;
        b8 allGuardsInstalled = true;
        b8 allIterationsCaptured = true;
        b8 dropsMonotonic = true;
        usize observedEventCount = 0u;
        u64 previousDroppedCount = 0u;
        for(u32 iteration = 0u; iteration < s_IterationCount; ++iteration){
            recorder.clear();
            {
                DiagnosticCaptureGuard guard(recorder);
                if(!guard.installed()){
                    allGuardsInstalled = false;
                    break;
                }
                constexpr i32 s_CaptureDeadlineMS = 5000;
                const auto deadline = TimerAddMS(TimerNow(), s_CaptureDeadlineMS);
                while(recorder.eventCount() == 0u && TimerNow() < deadline)
                    YieldThread();
            }
            const usize captured = recorder.eventCount();
            if(captured == 0u){
                allIterationsCaptured = false;
                break;
            }
            observedEventCount += captured;
            const u64 dropped = recorder.droppedDiagnosticCount();
            dropsMonotonic = dropsMonotonic && dropped >= previousDroppedCount;
            previousDroppedCount = dropped;
        }

        stopCaptureThread.testAndSet(MemoryOrder::release);
        captureThread.join();
        EXPECT_TRUE(allGuardsInstalled);
        EXPECT_TRUE(allIterationsCaptured);
        EXPECT_TRUE(dropsMonotonic);
        EXPECT_GE(observedEventCount, s_IterationCount);

        {
            DiagnosticCaptureGuard finalGuard(recorder);
            EXPECT_TRUE(finalGuard.installed());
        }

        const usize eventCountAfterFinalDestruction = recorder.eventCount();
        CaptureDiagnosticEvent(DiagnosticEventRecord{
            .event = DiagnosticEventName::s_Error,
            .category = TelemetryCaptureCasesDetail::s_TelemetryGuardCategory,
            .message = "ignored after destruction",
        });
        EXPECT_EQ(recorder.eventCount(), eventCountAfterFinalDestruction);

        const EventView events = recorder.view();
        for(usize eventIndex = 0u; eventIndex < events.eventCount(); ++eventIndex){
            const EventRecord* const event = events.eventAt(eventIndex);
            ASSERT_NE(event, nullptr);
            const auto parsed = Core::Telemetry::ParseDiagnosticPayload(event->payload.data(), event->payload.size());
            ASSERT_TRUE(parsed.has_value());
            EXPECT_EQ(parsed.value().event, DiagnosticEventName::s_Error);
            EXPECT_EQ(parsed.value().category, "telemetry_guard");
            EXPECT_EQ(parsed.value().message, "capture during destruction");
        }
    }
}

void VerifyTelemetry_CaptureScopePreservesForwardedLogsAndMetadataUnderConcurrentChurn(){
    const u32 s_WriterCount = 4u;
    const u32 s_MessagesPerWriter = 384u;
    const u32 s_ExpectedForwardCount = s_WriterCount * s_MessagesPerWriter;
    const u32 s_BaseStreamId = 70u;

    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryCaptureSession session = TelemetryCaptureSession(testArena.arena);
    session.setCaptureOptions(CaptureAll());
    session.setFrameIndex(1u);
    session.setStreamId(s_BaseStreamId + 1u);

    CapturingLogger forwardLogger = CapturingLogger();
    LoggerRegistrationGuard baseRegistration = LoggerRegistrationGuard(forwardLogger, LoggerBreakPolicy::ReportOnly);

    u64 nextFrameIndex = 1u;
    native(in s_BaseStreamId, in s_MessagesPerWriter, mut session, mut nextFrameIndex){
        constexpr u32 kWriters = 4u;
        Latch startGate(kWriters + 1u);
        Atomic<u32> activeWriters{ kWriters };
        Array<Thread, kWriters> writers;
        for(u32 writerIndex = 0u; writerIndex < kWriters; ++writerIndex){
            writers[writerIndex] = Thread([&](){
                startGate.arrive_and_wait();
                for(u32 messageIndex = 0u; messageIndex < s_MessagesPerWriter; ++messageIndex){
                    NWB_LOGGER_ESSENTIAL_INFO(NWB_TEXT("concurrent capture scope text {}"), messageIndex);
                    if((messageIndex & 7u) == 0u)
                        YieldThread();
                }
                activeWriters.fetch_sub(1u, MemoryOrder::release);
            });
        }

        startGate.arrive_and_wait();
        while(activeWriters.load(MemoryOrder::acquire) != 0u){
            session.setFrameIndex(nextFrameIndex);
            session.setStreamId(s_BaseStreamId + static_cast<u32>(nextFrameIndex & 7u));
            {
                CaptureSessionCaptureScope scope(session);
                ++nextFrameIndex;
                session.setFrameIndex(nextFrameIndex);
                session.setStreamId(s_BaseStreamId + static_cast<u32>(nextFrameIndex & 7u));
                YieldThread();
            }
            ++nextFrameIndex;
        }

        for(Thread& writer : writers)
            writer.join();
    }

    EXPECT_EQ(forwardLogger.messageCount(), s_ExpectedForwardCount);
    EXPECT_GT(session.eventCount(), 0u);

    native(in session, in nextFrameIndex, in s_BaseStreamId){
        const EventView events = session.view();
        for(usize eventIndex = 0u; eventIndex < events.eventCount(); ++eventIndex){
            const EventRecord* const event = events.eventAt(eventIndex);
            ASSERT_NE(event, nullptr);
            EXPECT_EQ(event->header.kind, EventKind::TextLog);
            EXPECT_GE(event->header.frameIndex, 1u);
            EXPECT_LE(event->header.frameIndex, nextFrameIndex);
            EXPECT_GE(event->header.streamId, s_BaseStreamId);
            EXPECT_LE(event->header.streamId, s_BaseStreamId + 7u);

            const auto parsed = Core::Telemetry::ParseTextLogPayload(event->payload.data(), event->payload.size());
            ASSERT_TRUE(parsed.has_value());
            EXPECT_EQ(parsed.value().type, LogType::EssentialInfo);
            EXPECT_NE(parsed.value().messageUtf8.find("concurrent capture scope text"), AStringView::npos);
        }
    }
}

void VerifyCpuTaskProfileIntegration_DelayedTaskTimingPreservesExecutionFrameAtLaterPublication(){
    CpuTaskProfileTestArena arena = CpuTaskProfileTestArena();
    PerfSession perf = PerfSession(arena.arena);
    native(mut perf){
        perf.setCaptureOptions(PerfCaptureOptions{ .enabled = true, .cpuTiming = true });
    }
    perf.beginFrame(42u);
    CpuTaskScheduler scheduler = CpuTaskScheduler(0u);
    const Name taskName = s_CpuTaskTestsExplicit;
    const Name scopeName = s_CpuTaskTestsScope;
    const CpuTaskProfileLabel taskLabel = scheduler.registerProfileLabel(taskName);
    const CpuTaskProfileLabel scopeLabel = scheduler.registerProfileLabel(scopeName);
    ASSERT_TRUE(taskLabel.valid());
    ASSERT_TRUE(scopeLabel.valid());
    CpuTaskScope scope = CpuTaskScope(scheduler, scopeLabel);
    scheduler.setProfiling(true, 41u);

    native(in taskLabel, mut scope, mut scheduler){
        const auto taskAdmission = scope.submit([]()noexcept{}, { .profileLabel = taskLabel });
        ASSERT_TRUE(taskAdmission.has_value());
        const CpuTaskHandle task = taskAdmission.value();
        ASSERT_TRUE(task.valid());
        scheduler.wait(task);
    }
    scope.wait();
    ASSERT_GT(scheduler.statistics().profilePendingEvents, 0u);
    CollectCpuTaskProfile(scheduler, perf.cpuTimingSink());
    EXPECT_EQ(scheduler.statistics().profilePendingEvents, 0u);
    perf.publishFrame();

    const TimingView timing = perf.cpuTimingView();
    EXPECT_EQ(timing.stats(taskName).firstSampleFrameIndex, 41u);
    EXPECT_EQ(timing.stats(taskName).lastSampleFrameIndex, 41u);
    EXPECT_EQ(timing.stats(taskName).publishFrameIndex, 42u);

    TelemetryCaptureSession telemetry = TelemetryCaptureSession(arena.arena);
    telemetry.setCaptureOptions(CaptureAll());
    const PerfSessionRecordResult result = telemetry.recordPerfReport(perf.report());
    ASSERT_TRUE(result.ok());
    b8 foundNamedTask = false;
    native(in telemetry, in taskName, mut foundNamedTask){
        const EventView events = telemetry.view();
        for(usize index = 0u; index < events.eventCount(); ++index){
            const EventRecord* event = events.eventAt(index);
            ASSERT_NE(event, nullptr);
            const auto payload = Core::Telemetry::ParsePerfTimingPayload(event->payload.data(), event->payload.size());
            ASSERT_TRUE(payload.has_value());
            if(payload.value().scopeName == taskName){
                foundNamedTask = true;
                EXPECT_EQ(payload.value().stats.firstSampleFrameIndex, 41u);
                EXPECT_EQ(payload.value().stats.publishFrameIndex, 42u);
            }
        }
    }
    EXPECT_TRUE(foundNamedTask);
}

void VerifyCpuTaskProfileIntegration_DisabledTimingSinkDiscardsBufferedSamples(){
    CpuTaskProfileTestArena arena = CpuTaskProfileTestArena();
    TimingRecorder timing = TimingRecorder(arena.arena);
    CpuTaskScheduler scheduler = CpuTaskScheduler(0u);
    scheduler.setProfiling(true, 7u);
    native(mut scheduler){
        const auto cpuTaskAdmission = scheduler.submit([]()noexcept{});
        ASSERT_TRUE(cpuTaskAdmission.has_value());
        ASSERT_TRUE(cpuTaskAdmission.value().valid());
    }
    scheduler.wait();
    ASSERT_GT(scheduler.statistics().profilePendingEvents, 0u);
    CollectCpuTaskProfile(scheduler, timing);
    EXPECT_EQ(scheduler.statistics().profilePendingEvents, 0u);
    EXPECT_EQ(timing.scopeCount(), 0u);
    timing.setEnabled(true);
    native(mut scheduler, mut timing){
        CollectCpuTaskProfile(scheduler, timing);
    }
    timing.publishFrame(8u);
    EXPECT_EQ(timing.scopeCount(), 0u);
}

void VerifyCpuTaskProfileIntegration_CollectorConsumesOnlyItsInitialPendingSnapshot(){
    CpuTaskProfileTestArena arena = CpuTaskProfileTestArena();
    TimingRecorder timing = TimingRecorder(arena.arena);
    timing.setEnabled(true);
    CpuTaskScheduler scheduler = CpuTaskScheduler(0u);
    scheduler.setProfiling(true, 11u);
    native(mut scheduler, mut timing){
        const auto cpuTaskAdmission = scheduler.submit([]()noexcept{});
        ASSERT_TRUE(cpuTaskAdmission.has_value());
        ASSERT_TRUE(cpuTaskAdmission.value().valid());
        scheduler.wait();
        const usize pendingBefore = scheduler.statistics().profilePendingEvents;
        ASSERT_GT(pendingBefore, 0u);
        OwnerThreadTimingSink sink(scheduler, timing, true);
        CollectCpuTaskProfile(scheduler, sink);
        EXPECT_EQ(sink.recordedSamples, pendingBefore);
    }
    EXPECT_GT(scheduler.statistics().profilePendingEvents, 0u);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}

void VerifyCpuTaskProfileIntegration_NativeWorkerSamplesAreRecordedOnTheCollectorThread(){
    CpuTaskProfileTestArena arena = CpuTaskProfileTestArena();
    TimingRecorder timing = TimingRecorder(arena.arena);
    timing.setEnabled(true);
    const Name taskName = s_CpuTaskTestsWorker;
    native(in taskName, mut timing){
        const ThreadId owner = QueryCurrentThreadId();
        ThreadId executionThread;
        CpuTaskSchedulerConfig config;
        config.workerCount = 1u;
        config.heterogeneous = false;
        CpuTaskScheduler scheduler(config);
        const CpuTaskProfileLabel label = scheduler.registerProfileLabel(taskName);
        ASSERT_TRUE(label.valid());
        scheduler.setProfiling(true, 19u);
        const auto taskAdmission = scheduler.submit([&]()noexcept{ executionThread = QueryCurrentThreadId(); }, { .profileLabel = label });
        ASSERT_TRUE(taskAdmission.has_value());
        const CpuTaskHandle task = taskAdmission.value();
        ASSERT_TRUE(task.valid());
        scheduler.wait(task);
        EXPECT_NE(executionThread, owner);
        OwnerThreadTimingSink sink(scheduler, timing);
        CollectCpuTaskProfile(scheduler, sink);
        timing.publishFrame(20u);
        EXPECT_GT(sink.recordedSamples, 0u);
    }
    EXPECT_EQ(timing.stats(taskName).sampleCount, 1u);
    EXPECT_EQ(timing.stats(taskName).firstSampleFrameIndex, 19u);
    EXPECT_EQ(timing.stats(taskName).publishFrameIndex, 20u);
}

void VerifyTelemetry_FrameGraphPayloadPreservesBorrowedLabelsWhenRebuiltInPlace(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    BuildTestFrameGraph(testArena.arena, nodes, edges);
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildFrameGraphPayload(905u, nodes, edges, testArena.scratchArena, payload));
    native(mut testArena, mut nodes, mut edges, mut payload){
        const auto first = Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size());
        ASSERT_TRUE(first.has_value());
        nodes[0u].label = first.value().nodes[0u].label;
        nodes[1u].label = first.value().nodes[1u].label;
        ASSERT_TRUE(BuildFrameGraphPayload(906u, nodes, edges, testArena.scratchArena, payload));
        const auto rebuilt = Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size());
        ASSERT_TRUE(rebuilt.has_value());
        EXPECT_EQ(rebuilt.value().frameIndex, 906u);
        EXPECT_EQ(rebuilt.value().nodes[0u].label, "GBuffer Pass");
        EXPECT_EQ(rebuilt.value().nodes[1u].label, "Albedo Texture");
        nodes[0u].label = rebuilt.value().nodes[0u].label;
        nodes[1u].label = rebuilt.value().nodes[1u].label;
        nodes[0u].kind = FrameGraphNodeKind::Unknown;
        EXPECT_FALSE(BuildFrameGraphPayload(907u, nodes, edges, testArena.scratchArena, payload));
    }
    EXPECT_TRUE(payload.empty());
}

void VerifyTelemetry_FrameGraphPayloadRejectsCorruptedHeaderAfterValidParse(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    BuildTestFrameGraph(testArena.arena, nodes, edges);

    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildFrameGraphPayload(905u, nodes, edges, testArena.scratchArena, payload));
    native(mut testArena, mut payload){
        ASSERT_TRUE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());
        payload[0u] = 0u;
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());
    }
}

void VerifyTelemetry_FrameGraphPayloadRejectsNonCurrentVersions(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    FrameGraphPhysicalQueueRuntimeStatisticsRecords physicalQueueRuntimeStatistics = FrameGraphPhysicalQueueRuntimeStatisticsRecords(testArena.arena);
    FrameGraphPacketSubmissionStatisticsRecords packetSubmissionStatistics = FrameGraphPacketSubmissionStatisticsRecords(testArena.arena);
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);

    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildFrameGraphPayload(907u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    native(mut testArena, mut payload){
        Core::Telemetry::EncodedFrameGraphPayloadHeader header;
        NWB_MEMCPY(&header, sizeof(header), payload.data(), sizeof(header));
        ASSERT_EQ(header.version, Core::Telemetry::s_FrameGraphPayloadVersion);
        ASSERT_GT(header.nodeCount, 0u);
        ASSERT_GT(header.runtimeStatisticsCount, 0u);
        ASSERT_GT(header.physicalQueueRuntimeStatisticsCount, 0u);
        ASSERT_GT(header.packetSubmissionStatisticsCount, 0u);

        const Array<u16, 12> unsupportedVersions = { 0u, 1u, 2u, 3u, 4u, 5u, 6u, 7u, 8u, 9u, static_cast<u16>(Core::Telemetry::s_FrameGraphPayloadVersion + 1u), Limit<u16>::s_Max, };
        for(const u16 version : unsupportedVersions){
            ScopedTestTrace trace(version);
            header.version = Core::Telemetry::s_FrameGraphPayloadVersion;
            NWB_MEMCPY(payload.data(), payload.size(), &header, sizeof(header));
            const auto parsed = Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size());
            ASSERT_TRUE(parsed.has_value());
            ASSERT_FALSE(parsed.value().nodes.empty());
            ASSERT_FALSE(parsed.value().physicalQueueRuntimeStatistics.empty());
            ASSERT_FALSE(parsed.value().packetSubmissionStatistics.empty());

            header.version = version;
            NWB_MEMCPY(payload.data(), payload.size(), &header, sizeof(header));
            EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());
        }
    }
}

void VerifyTelemetry_FrameGraphPayloadRejectsHistoricalEmptyPayloads(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildFrameGraphPayload(907u, nodes, edges, testArena.scratchArena, payload));
    native(mut testArena, mut payload){
        ASSERT_EQ(payload.size(), sizeof(Core::Telemetry::EncodedFrameGraphPayloadHeader));
        Core::Telemetry::EncodedFrameGraphPayloadHeader header;
        NWB_MEMCPY(&header, sizeof(header), payload.data(), sizeof(header));
        const auto parsed = Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size());
        ASSERT_TRUE(parsed.has_value());
        EXPECT_EQ(parsed.value().frameIndex, 907u);

        const Array<usize, 9> historicalHeaderBytes = { 28u, 32u, 36u, 40u, 44u, 44u, 48u, 52u, 52u };
        for(usize versionIndex = 0u; versionIndex < LengthOf(historicalHeaderBytes); ++versionIndex){
            header.version = static_cast<u16>(versionIndex + 1u);
            ScopedTestTrace trace(header.version);
            NWB_MEMCPY(payload.data(), payload.size(), &header, sizeof(header));
            EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), historicalHeaderBytes[versionIndex]).has_value());
        }
    }
}

void VerifyTelemetry_FrameGraphQueueAssignmentPayloadRejectsMalformedRecords(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    BuildTestAssignedFrameGraph(testArena.arena, nodes, edges);

    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildFrameGraphPayload(908u, nodes, edges, testArena.scratchArena, payload));
    native(mut testArena, in nodes, in edges, mut payload){
        const usize assignmentOffset = sizeof(Core::Telemetry::EncodedFrameGraphPayloadHeader)
            + sizeof(Core::Telemetry::EncodedFrameGraphNode) * nodes.size()
            + sizeof(Core::Telemetry::EncodedFrameGraphEdge) * edges.size();
        Core::Telemetry::EncodedFrameGraphQueueAssignment first;
        Core::Telemetry::EncodedFrameGraphQueueAssignment second;
        NWB_MEMCPY(&first, sizeof(first), payload.data() + assignmentOffset, sizeof(first));
        NWB_MEMCPY(&second, sizeof(second), payload.data() + assignmentOffset + sizeof(first), sizeof(second));

        second.nodeIndex = first.nodeIndex;
        NWB_MEMCPY(payload.data() + assignmentOffset + sizeof(first), payload.size() - assignmentOffset - sizeof(first), &second, sizeof(second));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());

        ASSERT_TRUE(BuildFrameGraphPayload(908u, nodes, edges, testArena.scratchArena, payload));
        NWB_MEMCPY(&first, sizeof(first), payload.data() + assignmentOffset, sizeof(first));
        NWB_MEMCPY(&second, sizeof(second), payload.data() + assignmentOffset + sizeof(first), sizeof(second));
        first.nodeIndex = 2u;
        second.nodeIndex = 0u;
        NWB_MEMCPY(payload.data() + assignmentOffset, payload.size() - assignmentOffset, &first, sizeof(first));
        NWB_MEMCPY(payload.data() + assignmentOffset + sizeof(first), payload.size() - assignmentOffset - sizeof(first), &second, sizeof(second));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());

        ASSERT_TRUE(BuildFrameGraphPayload(908u, nodes, edges, testArena.scratchArena, payload));
        NWB_MEMCPY(&first, sizeof(first), payload.data() + assignmentOffset, sizeof(first));
        first.nodeIndex = 1u;
        NWB_MEMCPY(payload.data() + assignmentOffset, payload.size() - assignmentOffset, &first, sizeof(first));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());

        ASSERT_TRUE(BuildFrameGraphPayload(908u, nodes, edges, testArena.scratchArena, payload));
        NWB_MEMCPY(&first, sizeof(first), payload.data() + assignmentOffset, sizeof(first));
        first.modifiers = static_cast<u8>(1u << 7u);
        NWB_MEMCPY(payload.data() + assignmentOffset, payload.size() - assignmentOffset, &first, sizeof(first));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());

        ASSERT_TRUE(BuildFrameGraphPayload(908u, nodes, edges, testArena.scratchArena, payload));
        NWB_MEMCPY(&first, sizeof(first), payload.data() + assignmentOffset, sizeof(first));
        ++first.scoreTotal;
        NWB_MEMCPY(payload.data() + assignmentOffset, payload.size() - assignmentOffset, &first, sizeof(first));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());

        ASSERT_TRUE(BuildFrameGraphPayload(908u, nodes, edges, testArena.scratchArena, payload));
        NWB_MEMCPY(&first, sizeof(first), payload.data() + assignmentOffset, sizeof(first));
        first.acceptedQueue.deviceGeneration = 0u;
        NWB_MEMCPY(payload.data() + assignmentOffset, payload.size() - assignmentOffset, &first, sizeof(first));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());

        ASSERT_TRUE(BuildFrameGraphPayload(908u, nodes, edges, testArena.scratchArena, payload));
        NWB_MEMCPY(&first, sizeof(first), payload.data() + assignmentOffset, sizeof(first));
        first.previousAcceptedQueue.index = Limit<u16>::s_Max;
        NWB_MEMCPY(payload.data() + assignmentOffset, payload.size() - assignmentOffset, &first, sizeof(first));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());
    }
}

void VerifyTelemetry_FrameGraphCompiledTaskPayloadRejectsMalformedRecords(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    BuildTestCompiledFrameGraph(testArena.arena, nodes, edges);

    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildFrameGraphPayload(909u, nodes, edges, testArena.scratchArena, payload));
    native(mut testArena, in nodes, in edges, mut payload){
        const usize compiledTaskOffset = sizeof(Core::Telemetry::EncodedFrameGraphPayloadHeader)
            + sizeof(Core::Telemetry::EncodedFrameGraphNode) * nodes.size()
            + sizeof(Core::Telemetry::EncodedFrameGraphEdge) * edges.size()
            + sizeof(Core::Telemetry::EncodedFrameGraphQueueAssignment) * 2u;
        Core::Telemetry::EncodedFrameGraphCompiledTask first;
        Core::Telemetry::EncodedFrameGraphCompiledTask second;
        NWB_MEMCPY(&first, sizeof(first), payload.data() + compiledTaskOffset, sizeof(first));
        NWB_MEMCPY(&second, sizeof(second), payload.data() + compiledTaskOffset + sizeof(first), sizeof(second));

        second.nodeIndex = first.nodeIndex;
        NWB_MEMCPY(payload.data() + compiledTaskOffset + sizeof(first), payload.size() - compiledTaskOffset - sizeof(first), &second, sizeof(second));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());

        ASSERT_TRUE(BuildFrameGraphPayload(909u, nodes, edges, testArena.scratchArena, payload));
        NWB_MEMCPY(&first, sizeof(first), payload.data() + compiledTaskOffset, sizeof(first));
        first.nodeIndex = 1u;
        NWB_MEMCPY(payload.data() + compiledTaskOffset, payload.size() - compiledTaskOffset, &first, sizeof(first));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());

        ASSERT_TRUE(BuildFrameGraphPayload(909u, nodes, edges, testArena.scratchArena, payload));
        NWB_MEMCPY(&first, sizeof(first), payload.data() + compiledTaskOffset, sizeof(first));
        first.planGeneration = 0u;
        NWB_MEMCPY(payload.data() + compiledTaskOffset, payload.size() - compiledTaskOffset, &first, sizeof(first));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());

        ASSERT_TRUE(BuildFrameGraphPayload(909u, nodes, edges, testArena.scratchArena, payload));
        NWB_MEMCPY(&first, sizeof(first), payload.data() + compiledTaskOffset, sizeof(first));
        first.packetIndex = Limit<u32>::s_Max;
        NWB_MEMCPY(payload.data() + compiledTaskOffset, payload.size() - compiledTaskOffset, &first, sizeof(first));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());

        ASSERT_TRUE(BuildFrameGraphPayload(909u, nodes, edges, testArena.scratchArena, payload));
        NWB_MEMCPY(&first, sizeof(first), payload.data() + compiledTaskOffset, sizeof(first));
        first.packetizationDecision = FrameGraphTaskPacketizationDecision::Unknown;
        NWB_MEMCPY(payload.data() + compiledTaskOffset, payload.size() - compiledTaskOffset, &first, sizeof(first));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());

        ASSERT_TRUE(BuildFrameGraphPayload(909u, nodes, edges, testArena.scratchArena, payload));
        NWB_MEMCPY(&first, sizeof(first), payload.data() + compiledTaskOffset, sizeof(first));
        first.packetizationDecision = FrameGraphTaskPacketizationDecision::Count;
        NWB_MEMCPY(payload.data() + compiledTaskOffset, payload.size() - compiledTaskOffset, &first, sizeof(first));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());

        ASSERT_TRUE(BuildFrameGraphPayload(909u, nodes, edges, testArena.scratchArena, payload));
        NWB_MEMCPY(&first, sizeof(first), payload.data() + compiledTaskOffset, sizeof(first));
        first.reserved[0u] = 1u;
        NWB_MEMCPY(payload.data() + compiledTaskOffset, payload.size() - compiledTaskOffset, &first, sizeof(first));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());
    }
}

void VerifyTelemetry_PacketSubmissionStatisticsRejectInconsistentCountsAndNonfiniteTime(){
    FrameGraphPacketSubmissionStatisticsRecord statistics = FrameGraphPacketSubmissionStatisticsRecord();
    statistics.packetGeneration = 72u;
    statistics.taskCount = 2u;
    statistics.commandListCount = 1u;
    statistics.plannedWaitTokenCount = 4u;
    statistics.sameQueueWaitElisionCount = 1u;
    statistics.timelineWaitCount = 1u;
    statistics.mergedTimelineWaitCount = 1u;
    statistics.inheritedTimelineWaitElisionCount = 1u;
    statistics.submissionSeconds = 0.125;
    statistics.queue.index = 3u;
    statistics.queue.deviceGeneration = 17u;
    statistics.ownerNodeIndex = 0u;
    statistics.packetIndex = 1u;
    statistics.queueClass = FrameGraphQueueClass::Compute;
    statistics.joinsAcceptedQueueFrontier = true;
    statistics.recoverySubmission = true;
    EXPECT_TRUE(IsValidFrameGraphPacketSubmissionStatistics(statistics));

    statistics.joinsAcceptedQueueFrontier = false;
    EXPECT_FALSE(IsValidFrameGraphPacketSubmissionStatistics(statistics));
    statistics.joinsAcceptedQueueFrontier = true;
    ++statistics.timelineWaitCount;
    EXPECT_FALSE(IsValidFrameGraphPacketSubmissionStatistics(statistics));
    --statistics.timelineWaitCount;
    ++statistics.inheritedTimelineWaitElisionCount;
    EXPECT_FALSE(IsValidFrameGraphPacketSubmissionStatistics(statistics));
    statistics.inheritedTimelineWaitElisionCount = u64.max;
    EXPECT_FALSE(IsValidFrameGraphPacketSubmissionStatistics(statistics));
    statistics.inheritedTimelineWaitElisionCount = 1u;
    statistics.commandListCount = 0u;
    EXPECT_FALSE(IsValidFrameGraphPacketSubmissionStatistics(statistics));
    statistics.commandListCount = 1u;
    statistics.submissionSeconds = bit_cast<f64>(0x7FF8000000000000uLL);
    EXPECT_FALSE(IsValidFrameGraphPacketSubmissionStatistics(statistics));
}

void VerifyTelemetry_InheritedWaitStatisticsRejectMalformedCountsAndMismatchedTotals(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    FrameGraphPhysicalQueueRuntimeStatisticsRecords physicalQueueRuntimeStatistics = FrameGraphPhysicalQueueRuntimeStatisticsRecords(testArena.arena);
    FrameGraphPacketSubmissionStatisticsRecords packetSubmissionStatistics = FrameGraphPacketSubmissionStatisticsRecords(testArena.arena);
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);
    ++nodes[0u].runtimeStatistics.submission.plannedWaitTokenCount;
    ++nodes[0u].runtimeStatistics.submission.inheritedTimelineWaitElisionCount;
    ++physicalQueueRuntimeStatistics[0u].statistics.submission.plannedWaitTokenCount;
    ++physicalQueueRuntimeStatistics[0u].statistics.submission.inheritedTimelineWaitElisionCount;
    ++packetSubmissionStatistics[2u].plannedWaitTokenCount;
    ++packetSubmissionStatistics[2u].inheritedTimelineWaitElisionCount;

    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildFrameGraphPayload(921u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    native(mut testArena, mut payload){
        const auto parsed = Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size());
        ASSERT_TRUE(parsed.has_value());
        EXPECT_EQ(parsed.value().nodes[0u].runtimeStatistics.submission.inheritedTimelineWaitElisionCount, 1u);
        EXPECT_EQ(parsed.value().physicalQueueRuntimeStatistics[1u].statistics.submission.inheritedTimelineWaitElisionCount, 1u);
        EXPECT_EQ(parsed.value().packetSubmissionStatistics[1u].inheritedTimelineWaitElisionCount, 1u);

        const usize computePacketOffset = sizeof(Core::Telemetry::EncodedFrameGraphPayloadHeader)
            + sizeof(Core::Telemetry::EncodedFrameGraphNode)
            + sizeof(Core::Telemetry::EncodedFrameGraphRuntimeStatistics)
            + sizeof(Core::Telemetry::EncodedFrameGraphPhysicalQueueRuntimeStatistics) * 2u
            + sizeof(Core::Telemetry::EncodedFrameGraphPacketSubmissionStatistics);
        Core::Telemetry::EncodedFrameGraphPacketSubmissionStatistics encoded;
        NWB_MEMCPY(&encoded, sizeof(encoded), payload.data() + computePacketOffset, sizeof(encoded));
        encoded.inheritedTimelineWaitElisionCount = Limit<u64>::s_Max;
        NWB_MEMCPY(payload.data() + computePacketOffset, payload.size() - computePacketOffset, &encoded, sizeof(encoded));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());
    }

    nodes[0u].runtimeStatistics.submission.inheritedTimelineWaitElisionCount = 0u;
    ++nodes[0u].runtimeStatistics.submission.timelineWaitCount;
    ASSERT_TRUE(IsValidFrameGraphRuntimeStatistics(nodes[0u].runtimeStatistics));
    EXPECT_FALSE(BuildFrameGraphPayload(921u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    EXPECT_TRUE(payload.empty());

    nodes[0u].runtimeStatistics.submission.inheritedTimelineWaitElisionCount = 1u;
    --nodes[0u].runtimeStatistics.submission.timelineWaitCount;
    physicalQueueRuntimeStatistics[0u].statistics.submission.inheritedTimelineWaitElisionCount = 0u;
    ++physicalQueueRuntimeStatistics[0u].statistics.submission.timelineWaitCount;
    ASSERT_TRUE(IsValidFrameGraphPhysicalQueueRuntimeStatistics(physicalQueueRuntimeStatistics[0u].statistics));
    EXPECT_FALSE(BuildFrameGraphPayload(921u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    EXPECT_TRUE(payload.empty());

    physicalQueueRuntimeStatistics.clear();
    packetSubmissionStatistics[2u].inheritedTimelineWaitElisionCount = 0u;
    ++packetSubmissionStatistics[2u].timelineWaitCount;
    ASSERT_TRUE(IsValidFrameGraphPacketSubmissionStatistics(packetSubmissionStatistics[2u]));
    native(mut testArena, in nodes, in edges, in physicalQueueRuntimeStatistics, in packetSubmissionStatistics, mut payload){
        EXPECT_FALSE(BuildFrameGraphPayload(921u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    }
    EXPECT_TRUE(payload.empty());
}

void VerifyTelemetry_PacketSubmissionEncodingIsIndependentOfInputOrder(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    FrameGraphPhysicalQueueRuntimeStatisticsRecords physicalQueueRuntimeStatistics = FrameGraphPhysicalQueueRuntimeStatisticsRecords(testArena.arena);
    FrameGraphPacketSubmissionStatisticsRecords packetSubmissionStatistics = FrameGraphPacketSubmissionStatisticsRecords(testArena.arena);
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);

    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildFrameGraphPayload(918u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    const auto firstPhysicalQueue = physicalQueueRuntimeStatistics[0u];
    physicalQueueRuntimeStatistics[0u] = physicalQueueRuntimeStatistics[1u];
    physicalQueueRuntimeStatistics[1u] = firstPhysicalQueue;
    const FrameGraphPacketSubmissionStatisticsRecord packetZero = packetSubmissionStatistics[1u];
    const FrameGraphPacketSubmissionStatisticsRecord packetOne = packetSubmissionStatistics[2u];
    const FrameGraphPacketSubmissionStatisticsRecord packetTwo = packetSubmissionStatistics[0u];
    packetSubmissionStatistics[0u] = packetZero;
    packetSubmissionStatistics[1u] = packetOne;
    packetSubmissionStatistics[2u] = packetTwo;

    TelemetryBytes reorderedPayload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildFrameGraphPayload(918u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, reorderedPayload));
    ASSERT_EQ(payload.size(), reorderedPayload.size());
    EXPECT_EQ(payload, reorderedPayload);
}

void VerifyTelemetry_FrameGraphPacketSubmissionStatisticsPayloadRejectsMalformedRecords(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    FrameGraphPhysicalQueueRuntimeStatisticsRecords physicalQueueRuntimeStatistics = FrameGraphPhysicalQueueRuntimeStatisticsRecords(testArena.arena);
    FrameGraphPacketSubmissionStatisticsRecords packetSubmissionStatistics = FrameGraphPacketSubmissionStatisticsRecords(testArena.arena);
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);

    packetSubmissionStatistics[0u].joinsAcceptedQueueFrontier = false;
    EXPECT_FALSE(BuildFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);
    packetSubmissionStatistics[1u].packetGeneration = 99u;
    EXPECT_FALSE(BuildFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);
    packetSubmissionStatistics[1u].packetIndex = packetSubmissionStatistics[2u].packetIndex;
    EXPECT_FALSE(BuildFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);
    packetSubmissionStatistics[2u].commandListCount = 1u;
    EXPECT_FALSE(BuildFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);
    packetSubmissionStatistics[1u].submissionSeconds += 0.01;
    EXPECT_FALSE(BuildFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);
    packetSubmissionStatistics[1u].queue.index = 3u;
    packetSubmissionStatistics[1u].queue.deviceGeneration = 17u;
    packetSubmissionStatistics[1u].queueClass = FrameGraphQueueClass::Compute;
    EXPECT_FALSE(BuildFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));

    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);
    native(mut testArena, in nodes, in edges, in physicalQueueRuntimeStatistics, in packetSubmissionStatistics, mut payload){
        ASSERT_TRUE(BuildFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
        const usize packetSubmissionStatisticsOffset = sizeof(Core::Telemetry::EncodedFrameGraphPayloadHeader)
            + sizeof(Core::Telemetry::EncodedFrameGraphNode)
            + sizeof(Core::Telemetry::EncodedFrameGraphRuntimeStatistics)
            + sizeof(Core::Telemetry::EncodedFrameGraphPhysicalQueueRuntimeStatistics) * 2u;
        Core::Telemetry::EncodedFrameGraphPacketSubmissionStatistics encodedStatistics;
        NWB_MEMCPY(&encodedStatistics, sizeof(encodedStatistics), payload.data() + packetSubmissionStatisticsOffset, sizeof(encodedStatistics));
        encodedStatistics.reserved = 1u;
        NWB_MEMCPY(payload.data() + packetSubmissionStatisticsOffset, payload.size() - packetSubmissionStatisticsOffset, &encodedStatistics, sizeof(encodedStatistics));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());

        ASSERT_TRUE(BuildFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
        NWB_MEMCPY(&encodedStatistics, sizeof(encodedStatistics), payload.data() + packetSubmissionStatisticsOffset, sizeof(encodedStatistics));
        encodedStatistics.submissionSeconds += 0.01;
        NWB_MEMCPY(payload.data() + packetSubmissionStatisticsOffset, payload.size() - packetSubmissionStatisticsOffset, &encodedStatistics, sizeof(encodedStatistics));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());

        ASSERT_TRUE(BuildFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
        const usize secondPacketSubmissionStatisticsOffset = packetSubmissionStatisticsOffset + sizeof(Core::Telemetry::EncodedFrameGraphPacketSubmissionStatistics);
        NWB_MEMCPY(&encodedStatistics, sizeof(encodedStatistics), payload.data() + secondPacketSubmissionStatisticsOffset, sizeof(encodedStatistics));
        encodedStatistics.packetIndex = 0u;
        NWB_MEMCPY(payload.data() + secondPacketSubmissionStatisticsOffset, payload.size() - secondPacketSubmissionStatisticsOffset, &encodedStatistics, sizeof(encodedStatistics));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());

        ASSERT_TRUE(BuildFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
        Core::Telemetry::EncodedFrameGraphPayloadHeader header;
        NWB_MEMCPY(&header, sizeof(header), payload.data(), sizeof(header));
        ++header.packetSubmissionStatisticsCount;
        NWB_MEMCPY(payload.data(), payload.size(), &header, sizeof(header));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());

        ASSERT_TRUE(BuildFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
        NWB_MEMCPY(&header, sizeof(header), payload.data(), sizeof(header));
        header.packetSubmissionStatisticsPresent = 0u;
        NWB_MEMCPY(payload.data(), payload.size(), &header, sizeof(header));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());

        ASSERT_TRUE(BuildFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
        NWB_MEMCPY(&header, sizeof(header), payload.data(), sizeof(header));
        header.reservedTail[1u] = 1u;
        NWB_MEMCPY(payload.data(), payload.size(), &header, sizeof(header));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size()).has_value());

        ASSERT_TRUE(BuildFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
        EXPECT_FALSE(Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size() - 1u).has_value());
    }
}

void VerifyTelemetry_PhysicalQueueDecodeShrinkingInputClearsPreviousRecords(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    BuildTestRuntimeFrameGraph(testArena.arena, nodes, edges);
    FrameGraphPhysicalQueueRuntimeStatisticsRecords records = FrameGraphPhysicalQueueRuntimeStatisticsRecords(testArena.arena);
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    native(mut testArena, in nodes, in edges, mut records, mut payload){
        ASSERT_TRUE(BuildFrameGraphPayload(916u, nodes, edges, records, testArena.scratchArena, payload));
        auto parsed = Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size());
        ASSERT_TRUE(parsed.has_value());
        ASSERT_EQ(parsed.value().physicalQueueRuntimeStatistics.size(), 2u);

        records.resize(1u);
        ASSERT_TRUE(BuildFrameGraphPayload(916u, nodes, edges, records, testArena.scratchArena, payload));
        parsed = Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size());
        ASSERT_TRUE(parsed.has_value());
        ASSERT_EQ(parsed.value().physicalQueueRuntimeStatistics.size(), 1u);
        EXPECT_EQ(parsed.value().physicalQueueRuntimeStatistics[0u].statistics.queue.index, 3u);
    }
}

void VerifyTelemetry_FrameGraphPhysicalQueueRuntimeStatisticsPayloadRejectsMalformedRecords(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
