native{
#include <impl/global.adhd.h>

#include <core/graphics/rhi/pipeline.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class AvboitRasterConfiguration final{
public:
    [[nodiscard]] static Core::Format::Enum SelectRendererAvboitAccumColorFormat(Core::Device& device)noexcept;
    [[nodiscard]] static Core::Format::Enum SelectRendererAvboitAccumExtinctionFormat(Core::Device& device)noexcept;
    [[nodiscard]] static Core::Format::Enum SelectRendererAvboitTransmittanceFormat(Core::Device& device)noexcept;
    [[nodiscard]] static Core::Format::Enum SelectRendererAvboitLowRasterFormat(Core::Device& device)noexcept;
    [[nodiscard]] static Core::RenderState BuildRendererAvboitVoxelRenderState()noexcept;
    [[nodiscard]] static Core::RenderState BuildRendererAvboitAccumulateRenderState()noexcept;
    [[nodiscard]] static Core::RenderState BuildRendererAvboitRefractionCaptureRenderState()noexcept;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 AreAvboitTargetFormatsSupported(
    in b8 lowRasterKnown,
    in b8 accumColorKnown,
    in b8 accumExtinctionKnown,
    in b8 transmittanceKnown
){
    return lowRasterKnown && accumColorKnown && accumExtinctionKnown && transmittanceKnown;
}


