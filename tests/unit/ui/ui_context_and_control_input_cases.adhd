namespace __hidden_ui_context_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB;
using namespace NWB::Impl::Ui;

constexpr AStringView s_ActionKey = "action";

[[nodiscard]] inline HitTarget MakeButtonTarget(const Rect& rectangle = { 10.0f, 20.0f, 30.0f, 20.0f })noexcept{
    HitTarget target;
    target.rectangle = rectangle;
    target.clip = { 0.0f, 0.0f, 200.0f, 100.0f };
    target.focusable = true;
    target.activatable = true;
    return target;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiContextTests : public testing::Test{
public:
    UiContextTests()
        : m_arena(Name(NWB::Tests::UiCases::s_UiCaseTestsUiContext))
        , m_context(m_arena)
    {}


public:
    [[nodiscard]] Expected<WidgetState> declareState(const AStringView stableKey, const WidgetKind::Enum kind){
        const auto declared = m_context.declare(stableKey, kind);
        if(!declared)
            return MakeUnexpected(Failure{});
        return **declared;
    }

    [[nodiscard]] Expected<NotNull<WidgetState*>> declareIndex(const usize index){
        Array<char, 32u> key;
        const AStringView formatted = FormatDecimal(index, key);
        if(formatted.empty())
            return MakeUnexpected(Failure{});
        return m_context.declare(formatted, WidgetKind::Button);
    }

    [[nodiscard]] Expected<WidgetState> declareIndexState(const usize index){
        const auto declared = declareIndex(index);
        if(!declared)
            return MakeUnexpected(Failure{});
        return **declared;
    }

    [[nodiscard]] b8 declareCapacityGrowthAndCheckPointerStability(const WidgetState& survivor){
        const auto first = declareIndex(s_WidgetMaxStates);
        if(!first)
            return false;
        const WidgetState firstCopy = **first;
        for(usize index = 1u; index < s_WidgetMaxStates - 1u; ++index){
            if(!declareIndex(s_WidgetMaxStates + index))
                return false;
        }
        const auto current = declareIndex(0u);
        if(!current)
            return false;
        EXPECT_EQ((*current)->declarationGeneration, survivor.declarationGeneration);
        EXPECT_TRUE(m_context.takeActivation(**current, true));
        if(!m_context.addTarget(**current, MakeButtonTarget()))
            return false;
        EXPECT_EQ(m_context.states().find(firstCopy.id), first->get());
        EXPECT_EQ((*first)->declarationGeneration, firstCopy.declarationGeneration);
        return m_context.states().find(firstCopy.id) == first->get();
    }

    [[nodiscard]] Optional<WidgetState> findState(const WidgetId id)const noexcept{
        if(const WidgetState* found = m_context.states().find(id))
            return *found;
        return {};
    }

    [[nodiscard]] Expected<WidgetState> prepare(const u64 generation, const WidgetRoot& root, const WidgetKind::Enum kind = WidgetKind::Button){
        EXPECT_TRUE(m_context.beginFrame(generation));
        EXPECT_TRUE(m_context.beginRoot(root));
        const auto state = m_context.declare(s_ActionKey, kind);
        EXPECT_TRUE(state);
        if(!state)
            return MakeUnexpected(state.error());
        const WidgetState retained = **state;
        EXPECT_TRUE(m_context.addTarget(retained, MakeButtonTarget()));
        EXPECT_TRUE(m_context.endRoot());
        EXPECT_TRUE(m_context.finishFrame());
        if(m_context.failed())
            return MakeUnexpected(Failure{});
        return retained;
    }

    [[nodiscard]] b8 queuePointer(const InputEventType::Enum type, const Point position = { 15.0f, 25.0f }){
        return m_context.input().queue(UiTestSupport::NativeInput({ .position = position, .type = type })).has_value();
    }

    InputRoutingResult click(const Point position = { 15.0f, 25.0f }){
        EXPECT_TRUE(m_context.input().queue(UiTestSupport::NativeInput({ .position = position, .type = InputEventType::PrimaryDown })));
        EXPECT_TRUE(m_context.input().queue(UiTestSupport::NativeInput({ .position = position, .type = InputEventType::PrimaryUp })));
        return m_context.input().process();
    }


public:
    Core::Alloc::GlobalArena m_arena;
    Context m_context;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


