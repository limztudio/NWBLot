void SuiteSelectOpticalVolumes(mut CoincidentSelectionContext context, in Span<CoincidentOpticalVolumeCandidate> candidates){
    context.select(candidates);
}

void SuiteSelectEmptyOpticalVolumes(mut CoincidentSelectionContext context){
    context.selectEmpty();
}

void SuiteSelectSingleOpticalVolume(mut CoincidentSelectionContext context, in CoincidentOpticalVolumeCandidate candidate){
    context.selectSingle(candidate);
}

void SuiteResetOpticalVolumes(mut CoincidentSelectionContext context){
    context.selection.reset();
}

Expected<SuiteGpuGraphResourceSetId> SuiteGatherComputeOutputs(mut ComputeOutputContext context, mut SuiteScratchArena scratch){
    return context.gatherOutputs(scratch);
}

b8 SuiteBuildCsgSnapshot(mut CsgShadowSnapshotContext context, in Span<CsgShadowReceiverInput> receivers){
    return context.build(receivers);
}

b8 SuiteBuildEmptyCsgSnapshot(mut CsgShadowSnapshotContext context){
    return context.buildEmpty();
}

b8 SuiteRegisterCustomCsgShape(mut CsgShadowSnapshotContext context){
    return RegisterCustomCsgShape(context);
}

void SuiteSetCutterTranslation(mut CsgShadowSnapshotContext context, in EntityID cutterEntity, in f32 x, in f32 y, in f32 z){
    context.setCutterTranslation(cutterEntity, x, y, z);
}

void SuiteSetCutterParameters(mut CsgShadowSnapshotContext context, in EntityID cutterEntity, in VectorSingle parameter){
    context.setCutterParameters(cutterEntity, f32x4(parameter));
}

void SuiteBeginLightSpaceCsgGather(mut LightSpaceCsgState state, mut CsgShadowSnapshotContext context, in usize capacity, in b8 hardware){
    BeginLightSpaceCsgGather(state, context.testWorld.world, capacity, hardware);
}

void SuiteAppendIdentityCsgReceiver(mut LightSpaceCsgState state, in EntityID receiver, in MeshRayTracingResourceSnapshot mesh){
    AppendIdentityLightSpaceCsgReceiver(state, receiver, mesh);
}

void SuiteAppendTranslatedXCsgReceiver(mut LightSpaceCsgState state, in EntityID receiver, in f32 x, in MeshRayTracingResourceSnapshot mesh){
    AppendTranslatedXLightSpaceCsgReceiver(state, receiver, x, mesh);
}

b8 SuiteFinishLightSpaceCsgGather(mut CsgShadowSnapshotContext context, mut LightSpaceCsgState state){
    return FinishLightSpaceCsgGather(context.registry, state, context.testWorld.world, context.scratch);
}

void SuiteUpdateInstancePitchAndX(in f32 x, mut InstanceGpuData instance){
    SetSuiteInstancePitchAndX(x, instance);
}

u32 ReadSuiteU32LittleEndian(in Span<u8> bytes, in usize offset){
    return cast<u32>(bytes[offset])
        | (cast<u32>(bytes[offset + 1u]) << 8u)
        | (cast<u32>(bytes[offset + 2u]) << 16u)
        | (cast<u32>(bytes[offset + 3u]) << 24u);
}

Span<u8> AsSuiteByteSpan(in Span<u8> bytes){
    return bytes;
}

Span<u32> AsSuiteU32Span(in Span<u32> words){
    return words;
}

b8 SuiteResolveCsgBoxWorkBounds(
    in CsgShapeRegistry registry,
    in CsgShapeTypeInfo shape,
    in MatrixSingle shapeToWorld,
    in CsgBoxShapeParameters parameters,
    in CsgClipWorkBounds receiver,
    mut CsgClipWorkBounds outWork
){
    return ResolveSuiteCsgBoxWorkBounds(registry, shape, shapeToWorld, parameters, receiver, outWork);
}

