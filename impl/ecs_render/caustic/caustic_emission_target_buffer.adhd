#include <impl/ecs_render/kernel/renderer_format_private.adhd>
#include <impl/ecs_render/caustic/rt_caustics_internal.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CausticEmissionTargetBuffer{
    public KernelBufferHandle buffer = KernelBufferHandle();
    public KernelGpuDescriptorHandle heapHandle = KernelGpuDescriptorHandle();
    public usize capacity = 0u;

    public b8 ensure(mut KernelGraphicsRuntime graphics, in usize targetCount){
        if(HasLiveKernelBuffer(this.buffer) && this.capacity >= targetCount && this.heapHandle.valid()){
            AssertCausticEmissionTargetStorageDescriptor(this.heapHandle);
            return true;
        }
        return EnsureCausticEmissionTargetBufferStorage(graphics, targetCount, this.buffer, this.heapHandle, this.capacity);
    }

    public void releaseDescriptor(mut KernelGraphicsRuntime graphics){
        if(!this.heapHandle.valid())
            return;
        FreeCausticEmissionTargetDescriptor(graphics, this.heapHandle);
        this.heapHandle = KernelGpuDescriptorHandle();
    }

    public void reset(){
        this.buffer.reset();
        this.heapHandle = KernelGpuDescriptorHandle();
        this.capacity = 0u;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

