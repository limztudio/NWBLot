////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/shadow/rt_shadow_internal_types.adhd>
#include <impl/ecs_render/shadow/rt_shadow_light_space_graph.adhd>
#include <impl/ecs_render/shadow/soft_shadow_resolve_dispatch_builder.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_CsgShadowDynamicBoundsLabel = "CSG Shadow Dynamic Bounds";
const StringView s_ShadowVisibilityOpaqueLabel = "Shadow Visibility Opaque";
const StringView s_ShadowOpaqueTemporalMergeLabel = "Shadow Opaque Temporal Merge";
const StringView s_ShadowOpaqueFirstWaveletLabel = "Shadow Opaque First Wavelet";
const StringView s_ShadowOpaqueSoftResolveLabel = "Shadow Opaque Soft Resolve";
const StringView s_ShadowTransparentSoftTraceLabel = "Shadow Transparent Soft Trace";
const StringView s_ShadowCombinedTemporalMergeLabel = "Shadow Combined Temporal Merge";
const StringView s_ShadowTransparentTemporalMergeLabel = "Shadow Transparent Temporal Merge";
const StringView s_ShadowCombinedFirstWaveletLabel = "Shadow Combined First Wavelet";
const StringView s_ShadowTransparentFirstWaveletLabel = "Shadow Transparent First Wavelet";
const StringView s_ShadowTransparentSoftFoldLabel = "Shadow Transparent Soft Fold";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ShouldReadSoftwareTransparentSamplingInSplitTrace(in b8 hardwareTransparentTrace, in b8 lightSpaceReady, in b8 graphOwnsTransparentTemporalMergeEntryStates, in b8 softShadowHistoryReadable){
    return !hardwareTransparentTrace && !lightSpaceReady && graphOwnsTransparentTemporalMergeEntryStates && softShadowHistoryReadable;
}

Name SelectOpaqueFirstWaveletIdentity(in b8 combinedSoftWavelet){
    if(combinedSoftWavelet)
        return s_ShadowPassOpaqueTemporalMerge;
    return s_ShadowPassOpaqueFirstWavelet;
}

StringView SelectOpaqueFirstWaveletLabel(in b8 combinedSoftWavelet){
    if(combinedSoftWavelet)
        return s_ShadowOpaqueTemporalMergeLabel;
    return s_ShadowOpaqueFirstWaveletLabel;
}

Name SelectTransparentTemporalMergeIdentity(in b8 combinedSoftTemporal){
    if(combinedSoftTemporal)
        return s_ShadowPassCombinedTemporalMerge;
    return s_ShadowPassTransparentTemporalMerge;
}

StringView SelectTransparentTemporalMergeLabel(in b8 combinedSoftTemporal){
    if(combinedSoftTemporal)
        return s_ShadowCombinedTemporalMergeLabel;
    return s_ShadowTransparentTemporalMergeLabel;
}

Name SelectTransparentFirstWaveletIdentity(in b8 combinedSoftWavelet){
    if(combinedSoftWavelet)
        return s_ShadowPassCombinedFirstWavelet;
    return s_ShadowPassTransparentFirstWavelet;
}

StringView SelectTransparentFirstWaveletLabel(in b8 combinedSoftWavelet){
    if(combinedSoftWavelet)
        return s_ShadowCombinedFirstWaveletLabel;
    return s_ShadowTransparentFirstWaveletLabel;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


GpuGraphResourceId SelectSoftShadowGraphResource(in b8 firstSelected, in GpuGraphResourceId first, in GpuGraphResourceId second){
    if(firstSelected)
        return first;
    return second;
}

b8 HasSoftShadowGraphResource(in Span<GpuGraphResourceId> resources, in GpuGraphResourceId resource){
    for(in GpuGraphResourceId existing : resources){
        if(existing == resource)
            return true;
    }
    return false;
}

Expected<GpuGraphResourceId> ImportSoftShadowSoftwareBuffer(mut GpuTaskGraph graph, in b8 hardwareTransparentTrace, in BufferHandle buffer, in Name identity, in StringView label){
    if(hardwareTransparentTrace)
        return GpuGraphResourceId();
    return ImportExternalBuffer(graph, buffer, identity, label);
}

[cpp_unwind]
b8 SoftShadowSplitResourceUseBuilder::build(in SoftShadowSplitResourceInputs inputs, mut SoftShadowSplitResourceUses uses){

    in SoftShadowSplitRoute route = inputs.route;
    const b8 hardwareTransparentTrace = inputs.rayTracingPlan.hardwareTransparentTrace;
    const b8 softShadowHistoryReadable = inputs.rayTracingPlan.softShadowHistoryReadable;
    const b8 opaqueHistoryFrontIsA = inputs.rayTracingPlan.historyFrontIsA;

    const auto shadowSoftHalfAResult = ImportExternalTexture(this.m_graph, inputs.targets.shadowSoftHalfA, Name(s_ShadowSoftHalfAName), s_ShadowSoftHalfALabel);
    const auto shadowSoftHalfBResult = ImportExternalTexture(this.m_graph, inputs.targets.shadowSoftHalfB, Name(s_ShadowSoftHalfBName), s_ShadowSoftHalfBLabel);
    const auto shadowSoftGeometryResult = ImportExternalTexture(this.m_graph, inputs.targets.shadowSoftGeometry, Name(s_ShadowSoftGeometryName), s_ShadowSoftGeometryLabel);
    const auto shadowSoftGeometryPreviousResult = ImportExternalTexture(this.m_graph, inputs.targets.shadowSoftGeometryPrev, Name(s_ShadowSoftGeometryPreviousName), s_ShadowSoftGeometryPreviousLabel);
    const auto opaqueHistoryAResult = ImportExternalTexture(this.m_graph, inputs.targets.shadowHistA, Name(s_ShadowHistoryAName), s_ShadowHistoryALabel);
    const auto opaqueHistoryBResult = ImportExternalTexture(this.m_graph, inputs.targets.shadowHistB, Name(s_ShadowHistoryBName), s_ShadowHistoryBLabel);
    const auto opaqueMomentsAResult = ImportExternalTexture(this.m_graph, inputs.targets.shadowMomentsA, Name(s_ShadowMomentsAName), s_ShadowMomentsALabel);
    const auto opaqueMomentsBResult = ImportExternalTexture(this.m_graph, inputs.targets.shadowMomentsB, Name(s_ShadowMomentsBName), s_ShadowMomentsBLabel);
    const auto transparentSoftHalfResult = ImportExternalTexture(this.m_graph, inputs.targets.transparentSoftHalf, Name(s_TransparentSoftHalfName), s_TransparentSoftHalfLabel);
    const auto transparentHistoryAResult = ImportExternalTexture(this.m_graph, inputs.targets.transparentHistA, Name(s_TransparentHistoryAName), s_TransparentHistoryALabel);
    const auto transparentHistoryBResult = ImportExternalTexture(this.m_graph, inputs.targets.transparentHistB, Name(s_TransparentHistoryBName), s_TransparentHistoryBLabel);
    const auto transparentMomentsAResult = ImportExternalTexture(this.m_graph, inputs.targets.transparentMomentsA, Name(s_TransparentMomentsAName), s_TransparentMomentsALabel);
    const auto transparentMomentsBResult = ImportExternalTexture(this.m_graph, inputs.targets.transparentMomentsB, Name(s_TransparentMomentsBName), s_TransparentMomentsBLabel);
    const auto sceneBvhNodesResult = ImportSoftShadowSoftwareBuffer(this.m_graph, hardwareTransparentTrace, inputs.rayTracingResources.sceneBvhNodeBuffer, Name(s_SceneBvhNodesName), s_SceneBvhNodesLabel);
    const auto sceneInstancesResult = ImportSoftShadowSoftwareBuffer(this.m_graph, hardwareTransparentTrace, inputs.rayTracingResources.sceneInstanceBuffer, Name(s_SceneInstancesName), s_SceneInstancesLabel);
    const auto shadowInstanceMaterialsResult = ImportExternalBuffer(this.m_graph, inputs.rayTracingResources.shadowInstanceMaterialBuffer, Name(s_SceneShadowInstanceMaterialName), s_SceneShadowInstanceMaterialLabel);
    const auto shadowTypedMaterialsResult = ImportExternalBuffer(this.m_graph, inputs.rayTracingResources.shadowMaterialTypedBuffer, Name(s_SceneShadowMaterialTypedName), s_SceneShadowMaterialTypedLabel);
    const auto shadowInstancesResult = ImportExternalBuffer(this.m_graph, inputs.rayTracingResources.shadowInstanceBuffer, Name(s_SceneShadowInstancesName), s_SceneShadowInstancesLabel);
    if(
        !shadowSoftHalfAResult.has_value() || !shadowSoftHalfBResult.has_value() || !shadowSoftGeometryResult.has_value() || !shadowSoftGeometryPreviousResult.has_value()
        || !opaqueHistoryAResult.has_value() || !opaqueHistoryBResult.has_value() || !opaqueMomentsAResult.has_value() || !opaqueMomentsBResult.has_value()
        || !transparentSoftHalfResult.has_value() || !transparentHistoryAResult.has_value() || !transparentHistoryBResult.has_value() || !transparentMomentsAResult.has_value() || !transparentMomentsBResult.has_value()
        || ((hardwareTransparentTrace && !inputs.sceneTlas.valid()) || (!hardwareTransparentTrace && (!sceneBvhNodesResult.has_value() || !sceneInstancesResult.has_value())))
        || !shadowInstanceMaterialsResult.has_value() || !shadowTypedMaterialsResult.has_value() || !shadowInstancesResult.has_value()
    ){
        warning("RendererSystem: could not import prepared soft-transparent shadow-fold resources");
        return false;
    }
    const GpuGraphResourceId sceneInstances = sceneInstancesResult.value();
    const GpuGraphResourceId sceneBvhNodes = sceneBvhNodesResult.value();
    const GpuGraphResourceId shadowSoftHalfA = shadowSoftHalfAResult.value();
    const GpuGraphResourceId shadowSoftHalfB = shadowSoftHalfBResult.value();
    const GpuGraphResourceId shadowSoftGeometry = shadowSoftGeometryResult.value();
    const GpuGraphResourceId shadowSoftGeometryPrevious = shadowSoftGeometryPreviousResult.value();
    const GpuGraphResourceId opaqueHistoryA = opaqueHistoryAResult.value();
    const GpuGraphResourceId opaqueHistoryB = opaqueHistoryBResult.value();
    const GpuGraphResourceId opaqueMomentsA = opaqueMomentsAResult.value();
    const GpuGraphResourceId opaqueMomentsB = opaqueMomentsBResult.value();
    const GpuGraphResourceId transparentSoftHalf = transparentSoftHalfResult.value();
    const GpuGraphResourceId transparentHistoryA = transparentHistoryAResult.value();
    const GpuGraphResourceId transparentHistoryB = transparentHistoryBResult.value();
    const GpuGraphResourceId transparentMomentsA = transparentMomentsAResult.value();
    const GpuGraphResourceId transparentMomentsB = transparentMomentsBResult.value();
    const GpuGraphResourceId shadowInstanceMaterials = shadowInstanceMaterialsResult.value();
    const GpuGraphResourceId shadowTypedMaterials = shadowTypedMaterialsResult.value();
    const GpuGraphResourceId shadowInstances = shadowInstancesResult.value();

    uses.opaque.reserve(ResolveShadowTraceGeometryReserveCount(s_SoftShadowOpaqueResourceUseCapacity, route.traceGeometryStatesGraphOwned, inputs.traceGeometryResources.size()));
    uses.opaque.push_back(ReadUse(inputs.worldPosition));
    uses.opaque.push_back(ReadUse(inputs.normal));
    uses.opaque.push_back(ReadUse(inputs.depth, ResourceStates::ShaderResource));
    uses.opaque.push_back(ReadUse(inputs.currentBindlessSlots, ResourceStates::ConstantBuffer));
    uses.opaque.push_back(WriteUse(inputs.shadowVisibility, ResourceStates::UnorderedAccess));
    uses.opaque.push_back(ReadUse(inputs.sceneGeometryDomain));
    uses.opaque.push_back(WriteUse(shadowSoftHalfA, ResourceStates::UnorderedAccess));
    uses.opaque.push_back(WriteUse(shadowSoftGeometry, ResourceStates::UnorderedAccess));
    uses.opaque.push_back(ReadUse(inputs.sceneShading, ResourceStates::ConstantBuffer));
    uses.opaque.push_back(ReadUse(inputs.lights, ResourceStates::ShaderResource));
    if(route.hardwareShadowSupported){
        if(inputs.sceneTlas.valid())
            uses.opaque.push_back(ReadUse(inputs.sceneTlas, ResourceStates::AccelStructRead));
        if(route.hardwareCsgShadow){
            uses.opaque.push_back(ReadUse(shadowInstanceMaterials, ResourceStates::ShaderResource));
            uses.opaque.push_back(ReadUse(shadowTypedMaterials, ResourceStates::ShaderResource));
            uses.opaque.push_back(ReadUse(shadowInstances, ResourceStates::ShaderResource));
            uses.opaque.push_back(ReadUse(inputs.materialContextSlots, ResourceStates::ConstantBuffer));
            if(!route.traceGeometryStatesGraphOwned){
                for(in GpuGraphResourceId resource : inputs.traceGeometryResources)
                    uses.opaque.push_back(ReadUse(resource, ResourceStates::ShaderResource));
            }
        }
    }else{
        uses.opaque.push_back(ReadUse(sceneBvhNodes, ResourceStates::ShaderResource));
        uses.opaque.push_back(ReadUse(sceneInstances, ResourceStates::ShaderResource));
        uses.opaque.push_back(ReadUse(shadowInstanceMaterials, ResourceStates::ShaderResource));
        uses.opaque.push_back(ReadUse(shadowTypedMaterials, ResourceStates::ShaderResource));
        uses.opaque.push_back(ReadUse(shadowInstances, ResourceStates::ShaderResource));
        if(inputs.materialContextSlots.valid())
            uses.opaque.push_back(ReadUse(inputs.materialContextSlots, ResourceStates::ConstantBuffer));
        if(!route.traceGeometryStatesGraphOwned){
            for(in GpuGraphResourceId resource : inputs.traceGeometryResources)
                uses.opaque.push_back(ReadUse(resource, ResourceStates::ShaderResource));
        }
    }

    uses.opaqueFirstWaveletCount = 0u;
    uses.opaqueFirstWavelet[uses.opaqueFirstWaveletCount++] = ReadUse(shadowSoftHalfA, ResourceStates::ShaderResource);
    if(!route.combinedSoftWavelet)
        uses.opaqueFirstWavelet[uses.opaqueFirstWaveletCount++] = WriteUse(shadowSoftHalfB, ResourceStates::UnorderedAccess);
    uses.opaqueFirstWavelet[uses.opaqueFirstWaveletCount++] = ReadUse(shadowSoftGeometry, ResourceStates::ShaderResource);
    if(route.graphOwnsOpaqueTemporalMergeEntryStates){
        const GpuGraphResourceId opaqueHistoryIn = SelectSoftShadowGraphResource(opaqueHistoryFrontIsA, opaqueHistoryA, opaqueHistoryB);
        const GpuGraphResourceId opaqueMomentsIn = SelectSoftShadowGraphResource(opaqueHistoryFrontIsA, opaqueMomentsA, opaqueMomentsB);
        const GpuGraphResourceId opaqueHistoryOut = SelectSoftShadowGraphResource(opaqueHistoryFrontIsA, opaqueHistoryB, opaqueHistoryA);
        const GpuGraphResourceId opaqueMomentsOut = SelectSoftShadowGraphResource(opaqueHistoryFrontIsA, opaqueMomentsB, opaqueMomentsA);
        uses.opaqueFirstWavelet[uses.opaqueFirstWaveletCount++] = ReadUse(inputs.worldPosition, ResourceStates::ShaderResource);
        if(softShadowHistoryReadable){
            uses.opaqueFirstWavelet[uses.opaqueFirstWaveletCount++] = ReadUse(shadowSoftGeometryPrevious, ResourceStates::ShaderResource);
            uses.opaqueFirstWavelet[uses.opaqueFirstWaveletCount++] = ReadUse(opaqueHistoryIn, ResourceStates::ShaderResource);
            uses.opaqueFirstWavelet[uses.opaqueFirstWaveletCount++] = ReadUse(opaqueMomentsIn, ResourceStates::ShaderResource);
        }
        uses.opaqueFirstWavelet[uses.opaqueFirstWaveletCount++] = WriteUse(opaqueHistoryOut, ResourceStates::UnorderedAccess);
        uses.opaqueFirstWavelet[uses.opaqueFirstWaveletCount++] = WriteUse(opaqueMomentsOut, ResourceStates::UnorderedAccess);
    }

    uses.opaqueResolveCount = 0u;
    if(!route.combinedSoftUpsample){
        if(s_ShadowWaveletResolvePassCount == 1u)
            uses.opaqueResolve[uses.opaqueResolveCount++] = ReadUse(shadowSoftHalfB, ResourceStates::ShaderResource);
        else{
            uses.opaqueResolve[uses.opaqueResolveCount++] = ReadWriteUse(shadowSoftHalfA, ResourceStates::UnorderedAccess);
            uses.opaqueResolve[uses.opaqueResolveCount++] = ReadWriteUse(shadowSoftHalfB, ResourceStates::UnorderedAccess);
        }
        uses.opaqueResolve[uses.opaqueResolveCount++] = WriteUse(inputs.shadowVisibility, ResourceStates::UnorderedAccess);
        uses.opaqueResolve[uses.opaqueResolveCount++] = ReadUse(shadowSoftGeometry, ResourceStates::ShaderResource);
        uses.opaqueResolve[uses.opaqueResolveCount++] = ReadUse(inputs.worldPosition, ResourceStates::ShaderResource);
        uses.opaqueResolve[uses.opaqueResolveCount++] = ReadUse(inputs.normal, ResourceStates::ShaderResource);
        uses.opaqueResolve[uses.opaqueResolveCount++] = ReadUse(inputs.depth, ResourceStates::ShaderResource);
        uses.opaqueResolve[uses.opaqueResolveCount++] = ReadUse(inputs.sceneShading, ResourceStates::ConstantBuffer);
    }

    uses.transparentTrace.reserve(ResolveShadowTraceGeometryReserveCount(s_SoftShadowTransparentTraceResourceUseCapacity, route.traceGeometryStatesGraphOwned, inputs.traceGeometryResources.size()));
    uses.transparentTrace.push_back(ReadUse(inputs.worldPosition, ResourceStates::ShaderResource));
    uses.transparentTrace.push_back(ReadUse(inputs.normal, ResourceStates::ShaderResource));
    uses.transparentTrace.push_back(ReadUse(inputs.depth, ResourceStates::ShaderResource));
    uses.transparentTrace.push_back(ReadUse(inputs.currentBindlessSlots, ResourceStates::ConstantBuffer));
    uses.transparentTrace.push_back(ReadUse(inputs.sceneGeometryDomain));
    uses.transparentTrace.push_back(WriteUse(transparentSoftHalf, ResourceStates::UnorderedAccess));
    if(hardwareTransparentTrace){
        for(in GpuTaskResourceUse use : inputs.hardwareSceneReads.uses)
            uses.transparentTrace.push_back(use);
        for(in GpuGraphResourceId scratch : inputs.hardwareTransparentScratch)
            uses.transparentTrace.push_back(ReadWriteUse(scratch, ResourceStates::UnorderedAccess));
    }
    else{
        uses.transparentTrace.push_back(ReadUse(sceneBvhNodes, ResourceStates::ShaderResource));
        uses.transparentTrace.push_back(ReadUse(sceneInstances, ResourceStates::ShaderResource));
        uses.transparentTrace.push_back(ReadUse(shadowInstanceMaterials, ResourceStates::ShaderResource));
        uses.transparentTrace.push_back(ReadUse(shadowTypedMaterials, ResourceStates::ShaderResource));
        uses.transparentTrace.push_back(ReadUse(shadowInstances, ResourceStates::ShaderResource));
        uses.transparentTrace.push_back(ReadUse(inputs.materialContextSlots, ResourceStates::ConstantBuffer));
    }
    uses.transparentTrace.push_back(ReadUse(inputs.sceneShading, ResourceStates::ConstantBuffer));
    uses.transparentTrace.push_back(ReadUse(inputs.lights, ResourceStates::ShaderResource));
    if(!route.traceGeometryStatesGraphOwned){
        for(in GpuGraphResourceId resource : inputs.traceGeometryResources)
            uses.transparentTrace.push_back(ReadUse(resource, ResourceStates::ShaderResource));
    }

    uses.graphOwnsTransparentTemporalMergeEntryStates = inputs.rayTracingPlan.transparentTemporalMergeReady;
    const b8 transparentHistoryFrontIsA = inputs.rayTracingPlan.historyFrontIsA;
    const GpuGraphResourceId transparentHistoryIn = SelectSoftShadowGraphResource(transparentHistoryFrontIsA, transparentHistoryA, transparentHistoryB);
    const GpuGraphResourceId transparentMomentsIn = SelectSoftShadowGraphResource(transparentHistoryFrontIsA, transparentMomentsA, transparentMomentsB);
    const GpuGraphResourceId transparentHistoryOut = SelectSoftShadowGraphResource(transparentHistoryFrontIsA, transparentHistoryB, transparentHistoryA);
    const GpuGraphResourceId transparentMomentsOut = SelectSoftShadowGraphResource(transparentHistoryFrontIsA, transparentMomentsB, transparentMomentsA);
    if(ShouldReadSoftwareTransparentSamplingInSplitTrace(inputs.rayTracingPlan.hardwareTransparentTrace, inputs.rayTracingPlan.lightSpace.ready, uses.graphOwnsTransparentTemporalMergeEntryStates, softShadowHistoryReadable)){
        uses.transparentTrace.push_back(ReadUse(shadowSoftGeometry, ResourceStates::ShaderResource));
        uses.transparentTrace.push_back(ReadUse(shadowSoftGeometryPrevious, ResourceStates::ShaderResource));
        uses.transparentTrace.push_back(ReadUse(transparentMomentsIn, ResourceStates::ShaderResource));
    }
    uses.transparentTemporalMergeCount = 0u;
    uses.transparentFirstWaveletCount = 0u;
    if(uses.graphOwnsTransparentTemporalMergeEntryStates){
        uses.transparentTemporalMerge[uses.transparentTemporalMergeCount++] = ReadUse(transparentSoftHalf, ResourceStates::ShaderResource);
        uses.transparentTemporalMerge[uses.transparentTemporalMergeCount++] = ReadUse(shadowSoftGeometry, ResourceStates::ShaderResource);
        uses.transparentTemporalMerge[uses.transparentTemporalMergeCount++] = ReadUse(inputs.worldPosition, ResourceStates::ShaderResource);
        if(softShadowHistoryReadable){
            uses.transparentTemporalMerge[uses.transparentTemporalMergeCount++] = ReadUse(shadowSoftGeometryPrevious, ResourceStates::ShaderResource);
            uses.transparentTemporalMerge[uses.transparentTemporalMergeCount++] = ReadUse(transparentHistoryIn, ResourceStates::ShaderResource);
            uses.transparentTemporalMerge[uses.transparentTemporalMergeCount++] = ReadUse(transparentMomentsIn, ResourceStates::ShaderResource);
        }
        uses.transparentTemporalMerge[uses.transparentTemporalMergeCount++] = WriteUse(transparentHistoryOut, ResourceStates::UnorderedAccess);
        uses.transparentTemporalMerge[uses.transparentTemporalMergeCount++] = WriteUse(transparentMomentsOut, ResourceStates::UnorderedAccess);
        if(route.combinedSoftTemporal){
            uses.transparentTemporalMerge[uses.transparentTemporalMergeCount++] = ReadUse(shadowSoftHalfA, ResourceStates::ShaderResource);
            if(softShadowHistoryReadable){
                uses.transparentTemporalMerge[uses.transparentTemporalMergeCount++] = ReadUse(SelectSoftShadowGraphResource(opaqueHistoryFrontIsA, opaqueHistoryA, opaqueHistoryB), ResourceStates::ShaderResource);
                uses.transparentTemporalMerge[uses.transparentTemporalMergeCount++] = ReadUse(SelectSoftShadowGraphResource(opaqueHistoryFrontIsA, opaqueMomentsA, opaqueMomentsB), ResourceStates::ShaderResource);
            }
            uses.transparentTemporalMerge[uses.transparentTemporalMergeCount++] = WriteUse(SelectSoftShadowGraphResource(opaqueHistoryFrontIsA, opaqueHistoryB, opaqueHistoryA), ResourceStates::UnorderedAccess);
            uses.transparentTemporalMerge[uses.transparentTemporalMergeCount++] = WriteUse(SelectSoftShadowGraphResource(opaqueHistoryFrontIsA, opaqueMomentsB, opaqueMomentsA), ResourceStates::UnorderedAccess);
        }

        uses.transparentFirstWavelet[uses.transparentFirstWaveletCount++] = ReadUse(transparentHistoryOut, ResourceStates::ShaderResource);
        uses.transparentFirstWavelet[uses.transparentFirstWaveletCount++] = ReadUse(transparentMomentsOut, ResourceStates::ShaderResource);
        uses.transparentFirstWavelet[uses.transparentFirstWaveletCount++] = WriteUse(shadowSoftHalfA, ResourceStates::UnorderedAccess);
        uses.transparentFirstWavelet[uses.transparentFirstWaveletCount++] = ReadUse(shadowSoftGeometry, ResourceStates::ShaderResource);
    }else{
        uses.transparentFirstWavelet[uses.transparentFirstWaveletCount++] = ReadUse(transparentSoftHalf, ResourceStates::ShaderResource);
        uses.transparentFirstWavelet[uses.transparentFirstWaveletCount++] = WriteUse(shadowSoftHalfA, ResourceStates::UnorderedAccess);
        uses.transparentFirstWavelet[uses.transparentFirstWaveletCount++] = ReadUse(shadowSoftGeometry, ResourceStates::ShaderResource);
    }
    if(route.combinedSoftWavelet){
        uses.transparentFirstWavelet[uses.transparentFirstWaveletCount++] = ReadUse(SelectSoftShadowGraphResource(opaqueHistoryFrontIsA, opaqueHistoryB, opaqueHistoryA), ResourceStates::ShaderResource);
        uses.transparentFirstWavelet[uses.transparentFirstWaveletCount++] = ReadUse(SelectSoftShadowGraphResource(opaqueHistoryFrontIsA, opaqueMomentsB, opaqueMomentsA), ResourceStates::ShaderResource);
        uses.transparentFirstWavelet[uses.transparentFirstWaveletCount++] = WriteUse(shadowSoftHalfB, ResourceStates::UnorderedAccess);
    }
    uses.transparentFoldCount = 0u;
    if(route.combinedSoftUpsample)
        uses.transparentFold[uses.transparentFoldCount++] = ReadUse(shadowSoftHalfB, ResourceStates::ShaderResource);
    if(s_ShadowWaveletTransparentResolvePassCount == 1u)
        uses.transparentFold[uses.transparentFoldCount++] = ReadUse(shadowSoftHalfA, ResourceStates::ShaderResource);
    else{
        uses.transparentFold[uses.transparentFoldCount++] = ReadWriteUse(shadowSoftHalfA, ResourceStates::UnorderedAccess);
        uses.transparentFold[uses.transparentFoldCount++] = ReadWriteUse(shadowSoftHalfB, ResourceStates::UnorderedAccess);
    }
    if(route.combinedSoftUpsample)
        uses.transparentFold[uses.transparentFoldCount++] = WriteUse(inputs.shadowVisibility, ResourceStates::UnorderedAccess);
    else
        uses.transparentFold[uses.transparentFoldCount++] = ReadWriteUse(inputs.shadowVisibility, ResourceStates::UnorderedAccess);
    uses.transparentFold[uses.transparentFoldCount++] = ReadUse(shadowSoftGeometry, ResourceStates::ShaderResource);
    uses.transparentFold[uses.transparentFoldCount++] = ReadUse(inputs.worldPosition, ResourceStates::ShaderResource);
    uses.transparentFold[uses.transparentFoldCount++] = ReadUse(inputs.normal, ResourceStates::ShaderResource);
    uses.transparentFold[uses.transparentFoldCount++] = ReadUse(inputs.depth, ResourceStates::ShaderResource);
    uses.transparentFold[uses.transparentFoldCount++] = ReadUse(inputs.sceneShading, ResourceStates::ConstantBuffer);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
b8 SoftShadowSplitTaskChainBuilder::declare(in SoftShadowSplitTaskChainInputs inputs, mut SoftShadowSplitResourceUses uses, mut SoftShadowSplitTasks tasks){

    GpuTaskId shadowTraceDependency = inputs.prefixTask;
    GpuGraphResourceId csgShadowContext;
    if(inputs.rayTracingPlan.lightSpace.ready){
        const auto maps = this.declareLightSpaceShadowMaps(inputs, uses);
        if(!maps.has_value())
            return false;
        shadowTraceDependency = maps.value().shadowTraceDependency;
        csgShadowContext = maps.value().csgShadowContext;
    }

    GpuTaskSchedulingHint tailScheduling;
    tailScheduling.cost = GpuTaskCostHint::Medium;
    tailScheduling.forceSubmissionBoundary = false;
    tailScheduling.allowPacketMerge = true;
    tailScheduling.mergeWithPrevious = true;
    tailScheduling.allowMergeAcrossConsumerFrontier = inputs.route.csgShadow;
    ConfigureComputeEffectRoutingHint(true, tailScheduling);
    if(!this.declareOpaqueTasks(inputs, uses, shadowTraceDependency, tailScheduling, tasks))
        return false;
    return this.declareTransparentTasks(inputs, uses, tailScheduling, csgShadowContext, tasks);
}

[cpp_unwind]
Expected<SoftShadowLightSpaceMaps> SoftShadowSplitTaskChainBuilder::declareLightSpaceShadowMaps(in SoftShadowSplitTaskChainInputs inputs, mut SoftShadowSplitResourceUses uses){

    in SoftShadowSplitRoute route = inputs.route;
    if((inputs.rayTracingPlan.lightSpace.push.csgFlags & s_CsgShadowFlagCurrentReceiverCaps) != 0u){
        const GpuTaskGraphDeclarationReadView declarations(this.m_graph);
        const GpuGraphResourceId receiverView = declarations.findImportedBuffer(inputs.rayTracingPlan.lightSpace.receiverView);
        const GpuGraphResourceId receiverCapState = declarations.findImportedBuffer(inputs.rayTracingPlan.lightSpace.receiverCsgSampleState);
        const GpuGraphResourceId receiverCapDepth = declarations.findImportedTexture(inputs.targets.csgRemovedIntervalDepth);
        const GpuGraphResourceId receiverCapData = declarations.findImportedTexture(inputs.targets.csgRemovedIntervalData);
        const GpuGraphResourceId receiverCapCount = declarations.findImportedTexture(inputs.targets.csgRemovedIntervalCount);
        if(!receiverView.valid() || !receiverCapState.valid() || !receiverCapDepth.valid() || !receiverCapData.valid() || !receiverCapCount.valid()){
            warning("RendererSystem: could not find the current light-space shadow receiver cap resources");
            return MakeUnexpected(Failure());
        }
        const TextureSubresourceSet layers(0u, 1u, 0u, inputs.targets.csgRemovedIntervalLayerCount);
        const Array<GpuTaskResourceUse, 5u> receiverReads(ReadUse(receiverView, ResourceStates::ConstantBuffer),
            ReadUse(receiverCapState, ResourceStates::ConstantBuffer),
            ReadTextureUse(receiverCapDepth, layers, ResourceStates::UnorderedAccess),
            ReadTextureUse(receiverCapData, layers, ResourceStates::UnorderedAccess),
            ReadTextureUse(receiverCapCount, TextureSubresourceSet(0u, 1u, 0u, 1u), ResourceStates::UnorderedAccess));
        for(in GpuTaskResourceUse use : receiverReads){
            uses.opaque.push_back(use);
            uses.transparentTrace.push_back(use);
        }
    }
    Vector<GpuTaskResourceUse> lightSpaceReads;
    lightSpaceReads.reserve(ResolveShadowTraceGeometryReserveCount(s_SoftShadowLightSpaceReadCapacity + inputs.rayTracingPlan.lightSpace.csgDynamicBounds.size(), route.traceGeometryStatesGraphOwned, inputs.traceGeometryResources.size()));
    if(!AppendRayTracingSceneShadowBuffers(inputs.rayTracingResources, this.m_graph, lightSpaceReads))
        return MakeUnexpected(Failure());
    lightSpaceReads.push_back(ReadUse(inputs.materialContextSlots, ResourceStates::ConstantBuffer));
    lightSpaceReads.push_back(ReadUse(inputs.currentBindlessSlots, ResourceStates::ConstantBuffer));
    lightSpaceReads.push_back(ReadUse(inputs.sceneShading, ResourceStates::ConstantBuffer));
    lightSpaceReads.push_back(ReadUse(inputs.lights, ResourceStates::ShaderResource));
    if(!route.traceGeometryStatesGraphOwned){
        for(in GpuGraphResourceId resource : inputs.traceGeometryResources)
            lightSpaceReads.push_back(ReadUse(resource, ResourceStates::ShaderResource));
    }
    Vector<GpuGraphResourceId> csgBoundsResources;
    csgBoundsResources.reserve(inputs.rayTracingPlan.lightSpace.csgDynamicBounds.size());
    for(in BufferHandle buffer : inputs.rayTracingPlan.lightSpace.csgDynamicBounds){
        GpuGraphResourceId resource;
        {
            const GpuTaskGraphDeclarationReadView declarations(this.m_graph);
            resource = declarations.findImportedBuffer(buffer);
        }
        if(!resource.valid()){
            const auto importedResource = ImportExternalBuffer(this.m_graph, buffer, buffer.deref().getCreationDescription().debugName, s_CsgShadowDynamicBoundsLabel);
            if(!importedResource.has_value()){
                warning("RendererSystem: could not import CSG shadow dynamic bounds");
                return MakeUnexpected(Failure());
            }
            resource = importedResource.value();
        }
        if(!resource.valid()){
            warning("RendererSystem: could not import CSG shadow dynamic bounds");
            return MakeUnexpected(Failure());
        }
        if(HasSoftShadowGraphResource(csgBoundsResources, resource))
            continue;
        csgBoundsResources.push_back(resource);
        lightSpaceReads.push_back(ReadUse(resource, ResourceStates::ShaderResource));
        uses.opaque.push_back(ReadUse(resource, ResourceStates::ShaderResource));
        uses.transparentTrace.push_back(ReadUse(resource, ResourceStates::ShaderResource));
    }
    auto mapsResult = DeclareLightSpaceShadowMaps(
        LightSpaceShadowGraphInputs(this.m_graphics, inputs.shadowPrepared, inputs.rayTracingPlan.lightSpace, inputs.prefixTask, lightSpaceReads, inputs.traceResourceSetUses, inputs.stateSources),
        this.m_graph
    );
    if(!mapsResult.has_value()){
        warning("RendererSystem: could not declare light-space shadow maps");
        return MakeUnexpected(Failure());
    }
    in LightSpaceShadowGraph maps = mapsResult.value();
    const Array<GpuGraphResourceId, 3u> mapBuffers(maps.counts, maps.events, maps.views);
    for(in GpuGraphResourceId resource : mapBuffers){
        uses.opaque.push_back(ReadUse(resource, ResourceStates::ShaderResource));
        uses.transparentTrace.push_back(ReadUse(resource, ResourceStates::ShaderResource));
    }
    SoftShadowLightSpaceMaps result;
    if(maps.csgContext.valid()){
        result.csgShadowContext = maps.csgContext;
        uses.opaque.push_back(ReadWriteUse(maps.csgContext, ResourceStates::UnorderedAccess));
        uses.transparentTrace.push_back(ReadWriteUse(maps.csgContext, ResourceStates::UnorderedAccess));
        uses.opaque.push_back(ReadUse(maps.csgOpaqueDepth, ResourceStates::ShaderResource));
        uses.transparentTrace.push_back(ReadUse(maps.csgOpaqueDepth, ResourceStates::ShaderResource));
    }
    const TextureSubresourceSet layers(0u, 1u, 0u, inputs.rayTracingPlan.lightSpace.plan.viewCount);
    uses.opaque.push_back(ReadTextureUse(maps.depth, layers, ResourceStates::ShaderResource));
    uses.transparentTrace.push_back(ReadTextureUse(maps.depth, layers, ResourceStates::ShaderResource));
    result.shadowTraceDependency = maps.ready;
    return result;
}

[cpp_unwind]
b8 SoftShadowSplitTaskChainBuilder::declareOpaqueTasks(
    in SoftShadowSplitTaskChainInputs inputs,
    in SoftShadowSplitResourceUses uses,
    in borrow GpuTaskId shadowTraceDependency,
    in GpuTaskSchedulingHint tailScheduling,
    mut SoftShadowSplitTasks tasks
){
    in SoftShadowSplitRoute route = inputs.route;

    GpuTaskSchedulingHint opaqueScheduling;
    opaqueScheduling.cost = GpuTaskCostHint::Large;
    opaqueScheduling.forceSubmissionBoundary = false;
    opaqueScheduling.allowPacketMerge = true;
    opaqueScheduling.mergeWithPrevious = false;
    ConfigureComputeEffectRoutingHint(false, opaqueScheduling);
    GpuTaskDesc opaqueDesc;
    opaqueDesc
        .setIdentity(Name(s_ShadowPassOpaque))
        .setMarkerLabel(s_ShadowVisibilityOpaqueLabel)
        .setScheduling(opaqueScheduling)
        .setDependency(shadowTraceDependency)
        .setExternalDependencies(inputs.historyWriterDrainDependencies)
        .setExternalStateSources(inputs.stateSources)
        .setResourceUses(uses.opaque)
    ;
    const Array<GpuTaskResourceSetUse, 1u> singleTraceSet(inputs.traceGeometrySetUse);
    if(route.hardwareCsgShadow)
        opaqueDesc.setResourceSetUses(inputs.traceResourceSetUses);
    else if(!route.hardwareShadowSupported && route.traceGeometryStatesGraphOwned)
        opaqueDesc.setResourceSetUses(singleTraceSet);
    const auto opaqueTaskResult = this.m_raytracingSystem.declareShadowVisibilityOpaqueTask(
        this.m_graph, opaqueDesc, inputs.deferredLightingResources, inputs.shadowPrepared, route.hardwareShadowSupported,
        route.graphOwnsOpaqueTemporalMergeEntryStates, Optional<in LightSpaceShadowSnapshot>(inputs.rayTracingPlan.lightSpace), inputs.targets, inputs.timingTicket,
        inputs.asyncTiming, inputs.shadowVisibilityTiming, inputs.opaqueProduced, inputs.opaqueFrameIndex
    );
    if(!opaqueTaskResult.has_value()){
        tasks.opaque = GpuTaskId();
        warning("RendererSystem: could not declare deferred opaque shadow-visibility graph task");
        return false;
    }
    tasks.opaque = opaqueTaskResult.value();

    if(!route.combinedSoftTemporal){
        const Array<GpuTaskId, 1u> opaqueFirstWaveletDependencies(tasks.opaque);
        GpuTaskDesc opaqueFirstWaveletDesc;
        opaqueFirstWaveletDesc
            .setIdentity(SelectOpaqueFirstWaveletIdentity(route.combinedSoftWavelet))
            .setMarkerLabel(SelectOpaqueFirstWaveletLabel(route.combinedSoftWavelet))
            .setScheduling(tailScheduling)
            .setDependencies(opaqueFirstWaveletDependencies)
            .setExternalStateSources(inputs.stateSources)
            .setResourceUses(Span<GpuTaskResourceUse>(uses.opaqueFirstWavelet).first(uses.opaqueFirstWaveletCount))
        ;
        const auto opaqueFirstWaveletTaskResult = this.m_raytracingSystem.declareShadowVisibilityOpaqueFirstWaveletTask(
            this.m_graph, opaqueFirstWaveletDesc, inputs.deferredLightingResources, inputs.opaqueFrameIndex,
            route.hardwareShadowSupported, route.graphOwnsOpaqueTemporalMergeEntryStates, route.combinedSoftUpsample,
            route.combinedSoftWavelet, inputs.targets, inputs.timingTicket, inputs.asyncTiming, inputs.shadowVisibilityTiming,
            inputs.opaqueResolveTiming, inputs.opaqueProduced
        );
        if(!opaqueFirstWaveletTaskResult.has_value()){
            tasks.opaqueFirstWavelet = GpuTaskId();
            warning("RendererSystem: could not declare deferred opaque soft-shadow first-wavelet graph task");
            return false;
        }
        tasks.opaqueFirstWavelet = opaqueFirstWaveletTaskResult.value();
    }

    if(!route.combinedSoftUpsample){
        const Array<GpuTaskId, 1u> opaqueResolveDependencies(tasks.opaqueFirstWavelet);
        GpuTaskDesc opaqueResolveDesc;
        opaqueResolveDesc
            .setIdentity(Name(s_ShadowPassOpaqueSoftResolve))
            .setMarkerLabel(s_ShadowOpaqueSoftResolveLabel)
            .setScheduling(tailScheduling)
            .setDependencies(opaqueResolveDependencies)
            .setResourceUses(Span<GpuTaskResourceUse>(uses.opaqueResolve).first(uses.opaqueResolveCount))
        ;
        const auto opaqueResolveTaskResult = this.m_raytracingSystem.declareShadowVisibilityOpaqueResolveTailTask(
            this.m_graph, opaqueResolveDesc, inputs.deferredLightingResources, inputs.opaqueFrameIndex, route.hardwareShadowSupported,
            inputs.targets, inputs.timingTicket, inputs.asyncTiming, inputs.shadowVisibilityTiming, inputs.opaqueResolveTiming, inputs.opaqueProduced
        );
        if(!opaqueResolveTaskResult.has_value()){
            tasks.opaqueResolve = GpuTaskId();
            warning("RendererSystem: could not declare deferred opaque soft-shadow resolve-tail graph task");
            return false;
        }
        tasks.opaqueResolve = opaqueResolveTaskResult.value();
    }
    return true;
}

[cpp_unwind]
b8 SoftShadowSplitTaskChainBuilder::declareTransparentTasks(
    in SoftShadowSplitTaskChainInputs inputs,
    in SoftShadowSplitResourceUses uses,
    in GpuTaskSchedulingHint tailScheduling,
    in GpuGraphResourceId csgShadowContext,
    mut SoftShadowSplitTasks tasks
){
    in SoftShadowSplitRoute route = inputs.route;

    const GpuTaskId opaqueCompletionTask = SelectOpaqueShadowCompletion(route.combinedSoftTemporal, route.combinedSoftUpsample, tasks.opaque, tasks.opaqueFirstWavelet, tasks.opaqueResolve);
    const Array<GpuTaskId, 1u> traceDependencies(opaqueCompletionTask);
    GpuTaskDesc traceDesc;
    traceDesc
        .setIdentity(Name(s_ShadowPassSoftTransparentTrace))
        .setMarkerLabel(s_ShadowTransparentSoftTraceLabel)
        .setScheduling(tailScheduling)
        .setDependencies(traceDependencies)
        .setExternalStateSources(inputs.stateSources)
        .setResourceUses(uses.transparentTrace)
        .setResourceSetUses(inputs.traceResourceSetUses)
    ;
    const auto transparentTraceTaskResult = this.m_raytracingSystem.declareShadowTransparentSoftTraceTask(
        this.m_graph, traceDesc, inputs.deferredLightingResources, inputs.opaqueProduced, inputs.opaqueFrameIndex,
        Optional<in LightSpaceShadowSnapshot>(inputs.rayTracingPlan.lightSpace), inputs.targets, inputs.timingTicket, inputs.transparentTraceProduced
    );
    if(!transparentTraceTaskResult.has_value()){
        tasks.transparentTrace = GpuTaskId();
        warning("RendererSystem: could not declare deferred transparent soft-shadow trace graph task");
        return false;
    }
    tasks.transparentTrace = transparentTraceTaskResult.value();

    GpuTaskId transparentFirstWaveletDependency = tasks.transparentTrace;
    if(uses.graphOwnsTransparentTemporalMergeEntryStates){
        const Array<GpuTaskId, 1u> transparentTemporalMergeDependencies(transparentFirstWaveletDependency);
        GpuTaskDesc transparentTemporalMergeDesc;
        transparentTemporalMergeDesc
            .setIdentity(SelectTransparentTemporalMergeIdentity(route.combinedSoftTemporal))
            .setMarkerLabel(SelectTransparentTemporalMergeLabel(route.combinedSoftTemporal))
            .setScheduling(tailScheduling)
            .setDependencies(transparentTemporalMergeDependencies)
            .setExternalStateSources(inputs.stateSources)
            .setResourceUses(Span<GpuTaskResourceUse>(uses.transparentTemporalMerge).first(uses.transparentTemporalMergeCount))
        ;
        const auto transparentTemporalMergeTaskResult = this.m_raytracingSystem.declareShadowTransparentSoftTemporalMergeTask(
            this.m_graph, transparentTemporalMergeDesc, inputs.deferredLightingResources, inputs.opaqueProduced, inputs.opaqueFrameIndex,
            true, route.combinedSoftTemporal, route.hardwareShadowSupported, inputs.targets, inputs.timingTicket,
            inputs.transparentResolveTiming, inputs.transparentTraceProduced
        );
        if(!transparentTemporalMergeTaskResult.has_value()){
            tasks.transparentTemporalMerge = GpuTaskId();
            warning("RendererSystem: could not declare deferred transparent soft-shadow temporal-merge graph task");
            return false;
        }
        tasks.transparentTemporalMerge = transparentTemporalMergeTaskResult.value();
        transparentFirstWaveletDependency = tasks.transparentTemporalMerge;
    }

    const Array<GpuTaskId, 1u> transparentFirstWaveletDependencies(transparentFirstWaveletDependency);
    GpuTaskDesc transparentFirstWaveletDesc;
    transparentFirstWaveletDesc
        .setIdentity(SelectTransparentFirstWaveletIdentity(route.combinedSoftWavelet))
        .setMarkerLabel(SelectTransparentFirstWaveletLabel(route.combinedSoftWavelet))
        .setScheduling(tailScheduling)
        .setDependencies(transparentFirstWaveletDependencies)
        .setResourceUses(Span<GpuTaskResourceUse>(uses.transparentFirstWavelet).first(uses.transparentFirstWaveletCount))
    ;
    const auto transparentFirstWaveletTaskResult = this.m_raytracingSystem.declareShadowTransparentSoftFirstWaveletTask(
        this.m_graph, transparentFirstWaveletDesc, inputs.deferredLightingResources, inputs.opaqueProduced, inputs.opaqueFrameIndex,
        true, !uses.graphOwnsTransparentTemporalMergeEntryStates, route.combinedSoftWavelet, inputs.targets, inputs.timingTicket,
        inputs.transparentResolveTiming, inputs.transparentTraceProduced
    );
    if(!transparentFirstWaveletTaskResult.has_value()){
        tasks.transparentFirstWavelet = GpuTaskId();
        warning("RendererSystem: could not declare deferred transparent soft-shadow first-wavelet graph task");
        return false;
    }
    tasks.transparentFirstWavelet = transparentFirstWaveletTaskResult.value();

    const Array<GpuTaskId, 1u> foldDependencies(tasks.transparentFirstWavelet);
    GpuTaskDesc foldDesc;
    foldDesc
        .setIdentity(Name(s_ShadowPassSoftTransparentFold))
        .setMarkerLabel(s_ShadowTransparentSoftFoldLabel)
        .setScheduling(tailScheduling)
        .setDependencies(foldDependencies)
        .setResourceUses(Span<GpuTaskResourceUse>(uses.transparentFold).first(uses.transparentFoldCount))
    ;
    const auto foldTaskResult = this.m_raytracingSystem.declareShadowTransparentSoftFoldTask(
        this.m_graph, foldDesc, inputs.deferredLightingResources, inputs.opaqueProduced, inputs.opaqueFrameIndex,
        route.combinedSoftUpsample, inputs.targets, inputs.timingTicket, inputs.asyncTiming, inputs.shadowVisibilityTiming,
        inputs.transparentResolveTiming, inputs.transparentTraceProduced
    );
    if(!foldTaskResult.has_value()){
        tasks.fold = GpuTaskId();
        warning("RendererSystem: could not declare deferred soft-transparent shadow-fold graph task");
        return false;
    }
    tasks.fold = foldTaskResult.value();
    if(inputs.rayTracingPlan.lightSpace.diagnosticReadback.valid()){
        const auto diagnosticsTaskResult = DeclareLightSpaceShadowDiagnostics(
            LightSpaceShadowGraphInputs(this.m_graphics, inputs.shadowPrepared, inputs.rayTracingPlan.lightSpace, tasks.fold, Span<GpuTaskResourceUse>(), Span<GpuTaskResourceSetUse>(), inputs.stateSources),
            csgShadowContext,
            this.m_graph
        );
        if(!diagnosticsTaskResult.has_value()){
            tasks.diagnostics = GpuTaskId();
            warning("RendererSystem: could not declare CSG shadow diagnostics readback");
            return false;
        }
        tasks.diagnostics = diagnosticsTaskResult.value();
    }
    return true;
}


