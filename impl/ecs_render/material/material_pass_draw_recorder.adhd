////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/material/renderer_draw_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[modular]
class MaterialPassDrawRecorder : NoCopy{
    private mut GraphicsRuntime m_graphics;

    public MaterialPassDrawRecorder(mut GraphicsRuntime graphics){
        this.m_graphics = graphics;
    }

    public b8 materialPassDrawResourcesReady(in MaterialPassMeshResourceSnapshot mesh, in MeshFrameBindingSnapshot frameBindings)const{
        return mesh.valid() && frameBindings.bindingValid();
    }

    public b8 materialPassDrawResourcesReady(in MaterialPassDrawItemsView drawItems, in MeshFrameBindingSnapshot frameBindings){
        return this.meshMaterialPassDrawResourcesReady(drawItems.meshDrawItems, frameBindings)
            && this.indexedMaterialPassDrawResourcesReady(drawItems.indexedDrawItems, frameBindings)
            && this.computeMaterialPassDrawResourcesReady(drawItems.computeDrawItems, frameBindings)
        ;
    }

    public b8 meshMaterialPassDrawResourcesReady(in Span<MaterialPassDrawItem> drawItems, in MeshFrameBindingSnapshot frameBindings);

    public b8 indexedMaterialPassDrawResourcesReady(in Span<MaterialPassDrawItem> drawItems, in MeshFrameBindingSnapshot frameBindings){
        return (drawItems.empty() || frameBindings.bindingValid()) && this.prepareIndexedMaterialPassResourceBindings(drawItems);
    }

    public b8 computeMaterialPassDrawResourcesReady(in Span<MaterialPassDrawItem> drawItems, in MeshFrameBindingSnapshot frameBindings);

    public b8 prepareMaterialPassResourceBindings(in MaterialPassDrawItemsView drawItems){
        return this.prepareMeshMaterialPassResourceBindings(drawItems.meshDrawItems)
            && this.prepareIndexedMaterialPassResourceBindings(drawItems.indexedDrawItems)
            && this.prepareComputeMaterialPassResourceBindings(drawItems.computeDrawItems)
        ;
    }

    public b8 prepareMeshMaterialPassResourceBindings(in Span<MaterialPassDrawItem> drawItems){
        return this.prepareMaterialPassResourceBindingsImpl(drawItems, false);
    }

    public b8 prepareIndexedMaterialPassResourceBindings(in Span<MaterialPassDrawItem> drawItems);

    public b8 prepareComputeMaterialPassResourceBindings(in Span<MaterialPassDrawItem> drawItems){
        return this.prepareMaterialPassResourceBindingsImpl(drawItems, true);
    }

    public void setMaterialPassCommonBufferStates(mut MaterialPassDrawContext context, in MaterialPassMeshResourceSnapshot mesh);
    public b8 setMaterialPassDrawPushConstants(mut MaterialPassDrawContext context, in MaterialPassDrawItem drawItem, in MaterialPassMeshResourceSnapshot mesh);
    public void dispatchComputeMaterialPassDrawItem(mut MaterialPassDrawContext context, in MaterialPassDrawItem drawItem, in MaterialPassMeshResourceSnapshot mesh, in MaterialPassPipelineResourceSnapshot pipelineResources);
    public void drawComputeMaterialPassDrawItem(mut MaterialPassDrawContext context, in MaterialPassDrawItem drawItem, in MaterialPassMeshResourceSnapshot mesh, in MaterialPassPipelineResourceSnapshot pipelineResources);
    public void renderMaterialPassDrawItems(mut MaterialPassDrawContext context, in MaterialPassDrawItemsView drawItems);
    public void renderIndexedMaterialPassDrawItems(mut MaterialPassDrawContext context, in Span<MaterialPassDrawItem> drawItems);
    public void renderMeshMaterialPassDrawItems(mut MaterialPassDrawContext context, in Span<MaterialPassDrawItem> drawItems);
    // Graph-only producer half. The graph owns generated output UAV states; this method records only the dispatch.
    public void generateComputeMaterialPassDrawItems(mut MaterialPassDrawContext context, in Span<MaterialPassDrawItem> drawItems);
    // Graph-only raster half. The graph provides each output Combined; this method records state, heap, push constants, draws.
    public void renderComputeMaterialPassDrawItemsRasterOnly(mut MaterialPassDrawContext context, in Span<MaterialPassDrawItem> drawItems);
    // Per-draw generation and rasterization retain the local UAV-to-vertex/index handoff when outputs alias.
    public void renderComputeMaterialPassDrawItems(mut MaterialPassDrawContext context, in Span<MaterialPassDrawItem> drawItems);
    public b8 prepareMaterialPassResourceBindingsImpl(in Span<MaterialPassDrawItem> drawItems, in b8 computeEmulation);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

