            cfg.subStepCount = 1u;
            cfg.interpolateTransforms = false;
        }

        Entity floorEnt = tw.world.createEntity();
        floorEnt.addComponent<TransformComponent>().position = f32x4(0.0f, -0.5f, 0.0f, 0.0f);
        {
