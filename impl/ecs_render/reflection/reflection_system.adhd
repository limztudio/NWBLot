native{
#include <impl/ecs_render/reflection/frame_parameters.adhd.h>
#include <impl/ecs_render/reflection/statistics_readback.adhd.h>
#include <impl/ecs_render/reflection/postprocess_resources.adhd.h>
#include <impl/ecs_render/reflection/feedback_resources.adhd.h>
#include <impl/ecs_render/reflection/reflection_pipelines.adhd.h>

#include <impl/ecs_render/raytrace/task_graph_scene_resources.adhd.h>
#include <impl/ecs_render/shared/renderer_frame_bindings.adhd.h>

#include <core/alloc/global.h>
#include <core/graphics/rhi/pipeline.h>
#include <core/graphics/gpu_timing.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_CORE_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class GraphicsRuntime;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_CORE_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererShaderSystem;
struct DeferredFrameTargets;

static_assert(sizeof(ReflectionFrameParameters) == 176u);
static_assert(offsetof(ReflectionFrameParameters, opaqueSpecularSlot) == 16u);
static_assert(offsetof(ReflectionFrameParameters, maxRayDistance) == 128u);
static_assert(offsetof(ReflectionFrameParameters, environmentTopR) == 140u);
static_assert(offsetof(ReflectionFrameParameters, environmentBottomR) == 152u);
static_assert(offsetof(ReflectionFrameParameters, screenThickness) == 164u);

struct ReflectionDepthPyramidSnapshot{
    // A native mip chain for u32 extents cannot contain more than 32 levels.
    Core::TextureHandle texture;
    Core::ComputePipelineHandle pipeline;
    Array<ReflectionDepthPyramidMip, s_ReflectionMaxDepthMips> mips{};
    u32 mipCount = 0u;
    u32 sampledSlot = 0u;
    u32 sourceDepthSlot = 0u;


public:
    [[nodiscard]] b8 valid()const noexcept{
        return texture && pipeline && mipCount > 0u && mipCount <= s_ReflectionMaxDepthMips;
    }
};

// Copy handles and slots together before declaration; only parameter values vary per frame.
struct ReflectionFrameSnapshot{
    ReflectionFrameParameters parameters;
    Core::TextureHandle opaqueRadiance;
    Core::TextureHandle glassRadiance;
    Core::BufferHandle queue;
    Core::BufferHandle counters;
    Core::BufferHandle indirectArgs;
    Core::BufferHandle frameParameters;
    Core::ComputePipelineHandle classifyPipeline;
    Core::ComputePipelineHandle buildArgsPipeline;
    Core::ComputePipelineHandle hardwarePipeline;
    ReflectionDepthPyramidSnapshot depthPyramid;
    RayTracingSceneGraphResources scene;
    ReflectionStatisticsReadbackSnapshot statistics;
    ReflectionPostprocessSnapshot postprocess;
    ReflectionFeedbackSnapshot feedback;
    u32 frameParametersSlot = 0u;


public:
    [[nodiscard]] b8 hasHardwareWork()const noexcept{ return parameters.hardwareEnabled != 0u && parameters.maxHardwareRays > 0u; }

    [[nodiscard]] b8 valid()const noexcept{
        return parameters.width > 0u && parameters.height > 0u && opaqueRadiance && glassRadiance && queue && counters && indirectArgs && frameParameters && classifyPipeline && buildArgsPipeline && depthPyramid.valid();
    }
};

struct ReflectionCsgDispatchState{
    ReflectionFrameSnapshot resources;
    Optional<Core::GpuTimingFrameTransaction> timing;


public:
    ReflectionCsgDispatchState(const ReflectionFrameSnapshot& frame, Core::GpuTimingRecorder& recorder)noexcept
        : resources(frame)
    { timing.emplace(recorder); }
};
using ReflectionCsgDispatchControl = RefCounter<ReflectionCsgDispatchState>;
using ReflectionCsgDispatchHandle = RefCountPtr< ReflectionCsgDispatchControl, ArenaRefDeleter<ReflectionCsgDispatchControl, Core::Alloc::GlobalArena> >;

class RendererReflectionSystem final : NoCopy{
public:
    RendererReflectionSystem(Core::Alloc::GlobalArena& arena, Core::GraphicsRuntime& graphics, RendererShaderSystem& shaders)noexcept
        : m_arena(arena)
        , m_graphics(graphics)
        , m_statistics(arena, graphics)
        , m_postprocess(arena, graphics, shaders)
        , m_feedback(arena, graphics)
        , m_csgDispatchStates(arena)
        , m_pipelines(arena, graphics, shaders)
    {}


public:
    // Caller joins submitted work and discards snapshots before teardown.
    void invalidateResources();
    [[nodiscard]] b8 prepareResources(u32 width, u32 height, b8 prepareHardware, b8 prepareCsgHardware, const ReflectionSettings& settings);
    [[nodiscard]] Expected<ReflectionCsgDispatchHandle> acquireCsgDispatchState(const ReflectionFrameSnapshot& resources)noexcept;
    void pollStatistics(){ m_statistics.pollCompleted(); }
    [[nodiscard]] Expected<ReflectionStatistics> tryGetLatestStatistics()const noexcept{ return m_statistics.latestStatistics(); }
    [[nodiscard]] ReflectionFrameSnapshot snapshotFrameResources(
        const DeferredFrameTargets& targets,
        const ECSRenderDetail::MeshViewBufferSnapshot& view,
        const RayTracingSceneGraphResources& scene,
        const ReflectionSettings& settings,
        u32 frameIndex,
        const ReflectionSceneContentStamp& stamp
    )const noexcept;


private:
    void releaseTargets();
    [[nodiscard]] b8 prepareCsgDispatchResources();
    [[nodiscard]] b8 prepareQueue(u32 capacity);
    [[nodiscard]] b8 prepareArguments(u32 capacity, b8 sliced);


private:
    Core::Alloc::GlobalArena& m_arena;
    Core::GraphicsRuntime& m_graphics;
    ReflectionStatisticsReadback m_statistics;
    RendererReflectionPostprocess m_postprocess;
    RendererReflectionFeedback m_feedback;
    ReflectionFrameSnapshot m_resources;
    Vector<ReflectionCsgDispatchHandle, Core::Alloc::GlobalArena> m_csgDispatchStates;
    ReflectionCsgDispatchControl* m_preparedCsgDispatch = nullptr;
    RendererReflectionPipelines m_pipelines;
    Array<Core::GpuDescriptorHandle, s_ReflectionDescriptorCount> m_descriptors{};
    Core::GpuDescriptorHandle m_depthSampledDescriptor;
    Array<Core::GpuDescriptorHandle, s_ReflectionMaxDepthMips> m_depthMipSampledDescriptors{};
    Array<Core::GpuDescriptorHandle, s_ReflectionMaxDepthMips> m_depthMipStorageDescriptors{};
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ImplEcsRenderReflectionReflectionSystemAdhdModule(in u64 value){
    return value != 0u;
}


