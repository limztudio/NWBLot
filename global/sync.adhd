[cpp_name("::AtomicBackOff"), cpp_flags(binary_serializable, brace_init)]
extern class AtomicBackOff{
    b8 boundedPause(...);
    void pause(...);
    void reset(...);
};

[cpp_name("::ConditionVariableAny"), cpp_flags(brace_init)]
extern class ConditionVariableAny;

[cpp_name("::Futex"), cpp_flags(binary_serializable, brace_init)]
extern class Futex{
    void lock(...);
    b8 try_lock(...);
    void unlock(...);
};

[cpp_header("<global/sync.h>"), cpp_name("::FutexGuard")]
extern class FutexGuard;

[cpp_header("<global/sync.h>"), cpp_name("::AcquireFutex")]
extern FutexGuard AcquireFutex(in Futex mutex);

[cpp_name("::MallocMutex"), cpp_flags(binary_serializable, brace_init)]
extern class MallocMutex{
    void lock(...);
    b8 try_lock(...);
    void unlock(...);
};

[cpp_name("::RecursiveMutex"), cpp_flags(binary_serializable, brace_init)]
extern class RecursiveMutex;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_name("::MachinePause")]
extern void MachinePause(in auto a0 = {});

[cpp_name("::YieldThread")]
extern void YieldThread();


