}

class UiListGallery{
    public void paint(mut UiPaintContext context, mut ScratchArena scratchArena, in f32 x, in f32 y){
        if(!context.ui.beginPanel("list_gallery", Rect(x, y, s_OrdinaryGalleryWidth, s_ListGalleryPanelHeight)))
            return;
        const f32 previousFontSize = SetBuilderFontSize(context.ui, s_GalleryFontSize);
        b8 declared = context.ui.label(s_TitleKey, "100000 virtual rows");
        ListOptions options = ListOptions();
        options.height = LayoutSize(LayoutSizePolicy::Fixed, s_ListGalleryListHeight);
        const ListResult result = context.ui.virtualList("rows", this.m_source, this.m_state, options);
        if(result.activated)
            [essential] info("Testbed: custom list selected key={}", this.m_state.selectedKey());
        declared = DeclareSelectedKeyLabel(context.ui, scratchArena, this.m_state.selectedKey()) && result.valid && declared;
        const b8 valid = context.ui.endPanel() && declared;
        RestoreBuilderFontSize(context.ui, previousFontSize);
        if(!valid)
            error("Testbed: custom virtual list declaration failed");
    }

    private UiListSource m_source = UiListSource();
    private ListState m_state = ListState();
}

class UiComboGallery{
    public void paint(mut UiPaintContext context, mut ScratchArena scratchArena, in f32 x, in f32 y){
        if(!context.ui.beginPanel("combo_gallery", Rect(x, y, s_OrdinaryGalleryWidth, s_ComboGalleryPanelHeight)))
            return;
        const f32 previousFontSize = SetBuilderFontSize(context.ui, s_GalleryFontSize);
        b8 declared = context.ui.label(s_TitleKey, "Keyed combo selection");
        ComboOptions options = ComboOptions();
        options.popupHeight = s_ComboGalleryPopupHeight;
        const ComboResult result = context.ui.comboBox(s_ChoiceKey, this.m_source, this.m_state, options);
        if(result.committed)
            [essential] info("Testbed: custom combo selected key={}", this.m_state.selectedKey());
        declared = DeclareSelectedKeyLabel(context.ui, scratchArena, this.m_state.selectedKey()) && result.valid && declared;
        const b8 valid = context.ui.endPanel() && declared;
        RestoreBuilderFontSize(context.ui, previousFontSize);
        if(!valid)
            error("Testbed: custom combo declaration failed");
    }

    private UiListSource m_source = UiListSource();
    private ComboState m_state = ComboState();
}

class UiEditGallery{
    public UiEditGallery(mut GlobalArena arena){
        this.m_text = EditModel(arena);
        this.m_readOnly = EditModel(arena);
        const b8 configured = this.m_text.setText("Edit me: \xED\x95\x9C\xEA\xB8\x80") && this.m_readOnly.setText("Read-only: copy this text");
        [essential] assert(configured, "Testbed edit gallery must have valid initial text");
    }

    public void paint(mut UiPaintContext context, in f32 x, in f32 y){
        if(!context.ui.beginPanel("edit_gallery", Rect(x, y, s_OrdinaryGalleryWidth, s_EditGalleryPanelHeight)))
            return;
        const f32 previousFontSize = SetBuilderFontSize(context.ui, s_GalleryFontSize);
        b8 declared = context.ui.label(s_TitleKey, "Text editing");
        EditBoxOptions options = EditBoxOptions();
        const EditBoxResult text = context.ui.editBox("editable", this.m_text, this.m_textState, options);
        if(text.textChanged)
            [essential] info("Testbed: custom edit text bytes={}", this.m_text.text().size());
        options.readOnly = true;
        const EditBoxResult readOnly = context.ui.editBox(s_ReadOnlyKey, this.m_readOnly, this.m_readOnlyState, options);
        declared = text.valid && readOnly.valid && declared;
        declared = context.ui.label(s_HintKey, "Ctrl+A/C/X/V, undo and redo") && declared;
        const b8 valid = context.ui.endPanel() && declared;
        RestoreBuilderFontSize(context.ui, previousFontSize);
        if(!valid)
            error("Testbed: custom edit widget declaration failed");
    }

    private EditModel m_text;
    private EditModel m_readOnly;
    private EditBoxState m_textState = EditBoxState();
    private EditBoxState m_readOnlyState = EditBoxState();
}

class UiImageGallery{
    public b8 loadAssets(mut GlobalArena arena, in AssetManager assets, in ActiveSceneSubsystems sceneSubsystems){
        return LoadUiGallerySkinImageSource(arena, assets, sceneSubsystems, this.m_source);
    }

    public void paint(mut UiPaintContext context, in f32 x, in f32 y){
        if(!context.ui.beginPanel("image_gallery", Rect(x, y, s_OrdinaryGalleryWidth, s_ImageGalleryPanelHeight)))
            return;
        b8 valid = context.ui.label(s_TitleKey, "Atlas and engine images");
        valid = context.ui.beginRow("samples") && valid;
        ImageOptions sprite = ImageOptions();
        sprite.width = LayoutSize(LayoutSizePolicy::Fixed, s_ImageGallerySpriteSize);
        sprite.height = LayoutSize(LayoutSizePolicy::Fixed, s_ImageGallerySpriteSize);
        valid = context.ui.image("sprite", s_RadioMarkRegion, sprite) && valid;
        ImageOptions slice = sprite;
        slice.width.value = s_ImageGallerySliceWidth;
        slice.tint = ResolveImageGallerySliceTint();
        valid = context.ui.image("slice", s_ButtonNormal, slice) && valid;
        valid = context.ui.image("natural", s_ComboArrow) && valid;
        valid = context.ui.endContainer() && valid;
        ImageOptions texture = ImageOptions();
        texture.width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
        texture.height = LayoutSize(LayoutSizePolicy::Fixed, s_ImageGalleryTextureHeight);
        valid = context.ui.image("engine_texture", this.m_source, texture) && valid;
        valid = context.ui.label(s_HintKey, "Texture, sprite and nine-slice") && valid;
        valid = context.ui.endPanel() && valid;
        if(!valid)
            error("Testbed: custom image declaration failed");
    }

    private SharedImageSource m_source = SharedImageSource();
}

class UiNestedPopupGallery{
    public UiNestedPopupGallery(mut GlobalArena arena){
        this.m_source = UiNestedPopupSource(arena);
        this.m_search = SearchComboState(arena);
        this.m_beforeText = EditModel(arena);
        this.m_afterText = EditModel(arena);
        this.m_childText = EditModel(arena);
        const b8 initialized = this.m_beforeText.setText("Before child") && this.m_afterText.setText("After child") && this.m_childText.setText("Inside child");
        [essential] assert(initialized);
        this.m_combo.select(1u);
        this.m_search.combo().select(1u);
    }

    public void paint(mut UiPaintContext context, in f32 x, in f32 y){
        const f32 previousGap = SetBuilderGap(context.ui, s_NestedPopupCompactGap);
        const f32 previousFontSize = SetBuilderFontSize(context.ui, s_NestedPopupFontSize);
        if(context.ui.beginPanel("nested_popup_gallery", Rect(x, y, s_OrdinaryGalleryWidth, s_NestedPopupPanelHeight))){
            b8 valid = context.ui.label(s_TitleKey, "Nested popup / parent scope");
            if(context.ui.button("open", "Open parent and right child"))
                this.m_parent.open();
            valid = context.ui.label(s_HintKey, "Escape/outside closes the top child") && valid;
            valid = context.ui.endPanel() && valid;
            PopupOptions parent = PopupOptions();
            parent.anchor = ResolveNestedPopupParentAnchorRect(x, y);
            parent.size = Point(s_NestedPopupParentWidth, s_NestedPopupParentHeight);
            if(context.ui.beginPopup("nested_parent", this.m_parent, parent)){
                valid = this.paintParent(context.ui) && valid;
                valid = context.ui.endPopup() && valid;
            }
            if(!valid || context.ui.failed())
                error("Testbed: custom nested popup declaration failed");
        }
        RestoreBuilderFontSize(context.ui, previousFontSize);
        RestoreBuilderGap(context.ui, previousGap);
    }

    private b8 paintParent(mut Builder ui){
        WidgetOptions button = WidgetOptions();
        button.width = LayoutSize(LayoutSizePolicy::Fixed, s_NestedPopupButtonWidth);
        WidgetOptions wide = WidgetOptions();
        wide.width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
        ContainerOptions row = ContainerOptions();
        row.gap = s_NestedPopupCompactGap;
        EditBoxOptions edit = EditBoxOptions();
        ListOptions list = ListOptions();
        list.height = LayoutSize(LayoutSizePolicy::Fixed, s_NestedPopupListHeight);
        if(!ui.label(s_TitleKey, "Parent: controls before and after child") || !ui.beginRow("before", row))
            return false;
        ui.button(s_NestedPopupActionKey, "Before", button);
        const EditBoxResult before = ui.editBox(s_NestedPopupEditKey, this.m_beforeText, this.m_beforeEdit, edit);
        if(!before.valid || !ui.endContainer() || !ui.virtualList("before_list", this.m_source, this.m_beforeList, list).valid)
            return false;
        if(ui.button("open_child", "Open child outside parent clip", wide))
            this.m_child.open();
        if(!this.paintChild(ui) || !ui.beginRow("after", row))
            return false;
        ui.button(s_NestedPopupActionKey, "After", button);
        const EditBoxResult after = ui.editBox(s_NestedPopupEditKey, this.m_afterText, this.m_afterEdit, edit);
        if(!after.valid || !ui.endContainer() || !ui.virtualList("after_list", this.m_source, this.m_afterList, list).valid)
            return false;
        ComboOptions combo = ComboOptions();
        combo.popupHeight = s_NestedPopupComboPopupHeight;
        if(!ui.comboBox("combo", this.m_source, this.m_combo, combo).valid)
            return false;
        SearchComboOptions search = SearchComboOptions();
        search.combo = combo;
        search.combo.popupHeight = s_NestedPopupSearchPopupHeight;
        if(!ui.searchComboBox("search", this.m_source, this.m_search, search).combo.valid)
            return false;
        ui.button(s_NestedPopupMenuAnchorKey, "Right-click / Menu for commands", wide);
        ContextMenuOptions menu = ContextMenuOptions();
        menu.size = Point(s_NestedPopupMenuWidth, s_NestedPopupMenuHeight);
        const ContextMenuResult result = ui.contextMenu(s_CommandsKey, s_NestedPopupMenuAnchorKey, this.m_source, this.m_menu, menu);
        if(result.activated)
            [essential] info("Testbed: nested context command={}", result.key);
        return result.valid;
    }

    private b8 paintChild(mut Builder ui){
        const Rect parent = this.m_parent.placement().bounds;
        PopupOptions options = PopupOptions();
        options.anchor = ResolveNestedPopupChildAnchorRect(parent);
        options.side = PopupPlacementSide::Right;
        options.size = Point(s_NestedPopupChildWidth, s_NestedPopupChildHeight);
        if(!ui.beginPopup("right_child", this.m_child, options))
            return !ui.failed();
        WidgetOptions button = WidgetOptions();
        button.width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
        if(!ui.label(s_TitleKey, "Independent child overlay"))
            return false;
        ui.button(s_NestedPopupActionKey, "Child action", button);
        EditBoxOptions edit = EditBoxOptions();
        const EditBoxResult result = ui.editBox(s_NestedPopupEditKey, this.m_childText, this.m_childEdit, edit);
        if(ui.button("close_branch", "Close ancestor and entire branch", button))
            this.m_parent.close();
        return result.valid && ui.endPopup();
    }

    private UiNestedPopupSource m_source;
    private PopupState m_parent = PopupState();
    private PopupState m_child = PopupState();
    private ListState m_beforeList = ListState();
    private ListState m_afterList = ListState();
    private ComboState m_combo = ComboState();
    private SearchComboState m_search;
    private ContextMenuState m_menu = ContextMenuState();
    private EditModel m_beforeText;
    private EditModel m_afterText;
    private EditModel m_childText;
    private EditBoxState m_beforeEdit = EditBoxState();
    private EditBoxState m_afterEdit = EditBoxState();
    private EditBoxState m_childEdit = EditBoxState();
}

