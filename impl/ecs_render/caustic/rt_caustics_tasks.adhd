[cpp_unwind]
Expected<GpuTaskId> RendererRayTracingSystem::declareCausticResolveUpsampleTask(in GpuTaskDesc desc, in borrow b8 causticProducerDispatched, mut GpuTaskGraph graph, mut DeferredFrameTargets targets){
    return graph.addPayloadTask(desc, CausticResolvePhaseGraphTask(this, targets, causticProducerDispatched, this.causticResolveActivitySnapshot(targets), CausticResolveStage::Upsample, 0u));
}


