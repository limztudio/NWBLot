#include <impl/ecs_ui/toolkit/paint_primitives.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Color ResolveUiSkinColor(in UiSkinPalette palette, in UiSkinColorRole role){
    const UiSkinColor value = palette.colors[cast<usize>(role)];
    Color out;
    out.r = value.r;
    out.g = value.g;
    out.b = value.b;
    out.a = value.a;
    return out;
}

b8 SameTextureImageKey(in ImageSource first, in ImageSource second){
    return first.identity() == second.identity() && first.generation() == second.generation();
}

b8 ValidUiTextureImageSource(in ImageSource source){
    if(source.generation() == 0u || !source.identity().valid())
        return false;
    return
        source.texture().virtualPath() == source.identity().name()
        && cast<u8>(source.texture().dimension()) == 0u && source.texture().depth() == 1u
        && source.texture().width() != 0u && source.texture().height() != 0u
        && !source.texture().mipLevels().empty() && !source.texture().payloadBytes().empty()
        && IsValidTexturePayloadFormat(source.texture().payloadFormat())
        && IsValidTextureAlphaMode(source.texture().alphaMode())
    ;
}

b8 SameSkinBindingKey<TUiSkin, TTexture>(in SkinBindingRecord<TUiSkin, TTexture> lhs, in SkinBindingRecord<TUiSkin, TTexture> rhs){
    return lhs.skin == rhs.skin && lhs.texture == rhs.texture && lhs.generation == rhs.generation;
}

b8 SameSkinBinding<TUiSkin, TTexture>(in SkinBindingRecord<TUiSkin, TTexture> lhs, in SkinBindingRecord<TUiSkin, TTexture> rhs){
    return SameSkinBindingKey(lhs, rhs)
        && lhs.atlasWidth == rhs.atlasWidth
        && lhs.atlasHeight == rhs.atlasHeight
        && lhs.referenceDensity == rhs.referenceDensity;
}

b8 IsValidDisplayMetricsForGpuSubmit(in DisplayMetrics display){
    return
        IsFinite(VectorSingle(display.logicalWidth, display.logicalHeight, display.pixelScaleX, display.pixelScaleY))
        && display.logicalWidth > 0.0f && display.logicalHeight > 0.0f
        && display.pixelScaleX > 0.0f && display.pixelScaleY > 0.0f
    ;
}

b8 ValidDrawCommandGlyphBinding(in DrawCommand command, in usize pageCount){
    if(command.material == PaintMaterial::Glyph)
        return cast<usize>(command.glyphPageIndex) < pageCount && command.sdfPageIndex == 0xffffffffu && command.sdfChannel == 0u;
    if(command.material == PaintMaterial::SdfGlyph)
        return command.glyphPageIndex == 0xffffffffu;
    if(command.material == PaintMaterial::Solid || command.material == PaintMaterial::Skin || command.material == PaintMaterial::Image)
        return command.glyphPageIndex == 0xffffffffu && command.sdfPageIndex == 0xffffffffu && command.sdfChannel == 0u;
    return false;
}

b8 ValidateDrawCommandGlyphBindings(in Span<DrawCommand> commands, in usize pageCount){
    for(in DrawCommand command : commands){
        if(!ValidDrawCommandGlyphBinding(command, pageCount))
            return false;
    }
    return true;
}

b8 ValidDrawCommandImageBinding(in DrawCommand command, in usize imageCount){
    if(command.material == PaintMaterial::Image)
        return cast<usize>(command.textureImageIndex) < imageCount && command.glyphPageIndex == 0xffffffffu && command.sdfPageIndex == 0xffffffffu && command.sdfChannel == 0u;
    return command.textureImageIndex == 0xffffffffu;
}

b8 ValidateDrawCommandImageBindings(in Span<DrawCommand> commands, in usize imageCount){
    for(in DrawCommand command : commands){
        if(!ValidDrawCommandImageBinding(command, imageCount))
            return false;
    }
    return true;
}

b8 ValidDrawCommandSdfBinding(in DrawCommand command, in usize pageCount, in u32 pageChannelCount){
    if(command.material == PaintMaterial::SdfGlyph)
        return cast<usize>(command.sdfPageIndex) < pageCount && command.sdfChannel < pageChannelCount;
    return true;
}

b8 ValidSnapshotImageCounts(in usize glyphPageCount, in usize sdfPageCount, in usize textureImageCount){
    return
        glyphPageCount <= s_PaintMaxImages
        && sdfPageCount <= s_PaintMaxImages
        && textureImageCount <= s_PaintMaxImages
        && glyphPageCount + sdfPageCount + textureImageCount <= s_PaintMaxImages
    ;
}

b8 IsValidPaintUvRect(in Rect uv){
    return
        IsFinite(uv.x) && IsFinite(uv.y) && IsFinite(uv.width) && IsFinite(uv.height)
        && uv.x >= 0.0f && uv.y >= 0.0f && uv.width > 0.0f && uv.height > 0.0f
        && uv.x + uv.width <= 1.0f && uv.y + uv.height <= 1.0f
    ;
}

Insets MaxUiPadding(in Insets lhs, in Insets rhs){
    const VectorSingle first(lhs.left, lhs.top, lhs.right, lhs.bottom);
    const VectorSingle second(rhs.left, rhs.top, rhs.right, rhs.bottom);
    const VectorSingle maximum = Max(first, second);
    Insets out;
    out.left = maximum.x;
    out.top = maximum.y;
    out.right = maximum.z;
    out.bottom = maximum.w;
    return out;
}

Insets MaxUiPadding(in Insets lhs, in UiSkinInsets rhs){
    Insets converted;
    converted.left = rhs.left;
    converted.top = rhs.top;
    converted.right = rhs.right;
    converted.bottom = rhs.bottom;
    return MaxUiPadding(lhs, converted);
}

VectorSingle LoadRect(in Rect rectangle){
    return VectorSingle(rectangle.x, rectangle.y, rectangle.width, rectangle.height);
}

Rect StoreRect(in VectorSingle rectangle){
    return Rect(rectangle.x, rectangle.y, rectangle.z, rectangle.w);
}

b8 HasVisibleUiRectIntersection(in Rect rectangle, in Rect clip){
    return HasVisibleRectIntersectionVec(LoadRect(rectangle), LoadRect(clip));
}

b8 UiRectIntersectionContainsPoint(in Rect rectangle, in Rect clip, in Point pointer){
    const VectorSingle visibleBounds = IntersectRectBoundsVec(LoadRect(rectangle), LoadRect(clip));
    return pointer.x >= visibleBounds.x && pointer.y >= visibleBounds.y && pointer.x < visibleBounds.z && pointer.y < visibleBounds.w;
}

Rect ResolveSkinRegionUv(in UiSkinRect pixels, in u32 atlasWidth, in u32 atlasHeight){
    const f32 width = cast<f32>(atlasWidth);
    const f32 height = cast<f32>(atlasHeight);
    const VectorSingle normalized = VectorSingle(cast<f32>(pixels.x), cast<f32>(pixels.y), cast<f32>(pixels.width), cast<f32>(pixels.height)) / VectorSingle(width, height, width, height);
    Rect uv;
    uv.x = normalized.x;
    uv.y = normalized.y;
    uv.width = normalized.z;
    uv.height = normalized.w;
    return uv;
}

VectorSingle ResolveQuadTextureCoords(in Rect rectangle, in Rect visible, in Rect uv){
    const VectorSingle visibleEnd = VectorSingle(visible.x, visible.y, visible.x, visible.y) + VectorSingle(visible.width, visible.height, visible.width, visible.height);
    const VectorSingle coordinates(visible.x, visible.y, visibleEnd.x, visibleEnd.y);
    const VectorSingle delta = coordinates - VectorSingle(rectangle.x, rectangle.y, rectangle.x, rectangle.y);
    const VectorSingle fraction = delta / VectorSingle(rectangle.width, rectangle.height, rectangle.width, rectangle.height);
    const VectorSingle textureScale(uv.width, uv.height, uv.width, uv.height);
    const VectorSingle textureOrigin(uv.x, uv.y, uv.x, uv.y);
    return fraction * textureScale + textureOrigin;
}

Color PremultiplyPaintColor(in Color color){
    const VectorSingle rgb = VectorSingle(color.r, color.g, color.b, color.b) * color.a;
    Color out;
    out.r = rgb.x;
    out.g = rgb.y;
    out.b = rgb.z;
    out.a = color.a;
    return out;
}

void ResolveNineSliceCoordinates(
    in UiSkinRect pixels,
    in UiSkinSliceInsets borders,
    in Rect rectangle,
    in f32 referenceDensity,
    mut VectorSingle outX,
    mut VectorSingle outY,
    mut VectorSingle outU,
    mut VectorSingle outV
){
    const VectorSingle normalizedBorders = VectorSingle(cast<f32>(borders.left), cast<f32>(borders.right), cast<f32>(borders.top), cast<f32>(borders.bottom)) / VectorSingle(referenceDensity);
    const f32 borderLeft = normalizedBorders.x;
    const f32 borderRight = normalizedBorders.y;
    const f32 borderTop = normalizedBorders.z;
    const f32 borderBottom = normalizedBorders.w;
    const VectorSingle borderExtent = VectorSingle(borderLeft, borderTop, borderLeft, borderTop) + VectorSingle(borderRight, borderBottom, borderRight, borderBottom);
    const f32 borderExtentX = borderExtent.x;
    const f32 borderExtentY = borderExtent.y;
    const VectorSingle rectOrigin(rectangle.x, rectangle.y, rectangle.x, rectangle.y);
    const VectorSingle end = rectOrigin + VectorSingle(rectangle.width, rectangle.height, rectangle.width, rectangle.height);
    const f32 endX = end.x;
    const f32 endY = end.y;
    const VectorSingle first = rectOrigin + VectorSingle(borderLeft, borderTop, borderLeft, borderTop);
    const VectorSingle second = end - VectorSingle(borderRight, borderBottom, borderRight, borderBottom);
    f32 firstX = first.x;
    f32 secondX = second.x;
    if(rectangle.width < borderExtentX){
        // Do not evaluate the division outside this branch.
        firstX = rectangle.x + rectangle.width * (borderLeft / borderExtentX);
        secondX = firstX;
    }
    f32 firstY = first.y;
    f32 secondY = second.y;
    if(rectangle.height < borderExtentY){
        firstY = rectangle.y + rectangle.height * (borderTop / borderExtentY);
        secondY = firstY;
    }
    outX = VectorSingle(rectangle.x, firstX, secondX, endX);
    outY = VectorSingle(rectangle.y, firstY, secondY, endY);
    outU = VectorSingle(
        cast<f32>(pixels.x),
        cast<f32>(pixels.x + borders.left),
        cast<f32>(pixels.x + pixels.width - borders.right),
        cast<f32>(pixels.x + pixels.width)
    );
    outV = VectorSingle(
        cast<f32>(pixels.y),
        cast<f32>(pixels.y + borders.top),
        cast<f32>(pixels.y + pixels.height - borders.bottom),
        cast<f32>(pixels.y + pixels.height)
    );
}

b8 CanAdmitPaintImageBindingCounts(
    in usize existingGlyphCount,
    in usize existingSdfCount,
    in usize existingTextureCount,
    in usize addedGlyphs,
    in usize addedSdf,
    in usize addedTextures
){
    const usize existingCount = existingGlyphCount + existingSdfCount + existingTextureCount;
    return existingCount <= s_PaintMaxImages
        && addedGlyphs + addedSdf + addedTextures <= s_PaintMaxImages - existingCount;
}


