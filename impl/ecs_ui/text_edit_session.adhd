////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "edit_types.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[modular]
class UiTextEditSession : NoCopy{
    private mut ITextInputService m_service;
    private TextInputEvent m_event = TextInputEvent();
    private EditModelSnapshot m_expectedModel;
    private EditModelSnapshot m_publishedModel;
    private UiTextEditOwner m_owner;
    private TextInputSessionToken m_token;
    private u64 m_surroundingRevision = 0u;
    private u64 m_lastSequence = 0u;

    public UiTextEditSession(mut ITextInputService service){
        this.m_service = service;
    }

    public ~UiTextEditSession(){
        if(!this.cancel())
            TerminateInvariant();
    }

    [cpp_unwind] public TextInputAdmission begin(in UiTextEditOwner owner, in TextInputRect caret, mut EditModel model){
        if(!this.m_service.isOwnerThread())
            return TextInputAdmission::WrongThread;
        if(!owner.valid() || model.composition().active)
            return TextInputAdmission::InvalidSession;
        if(this.m_token.valid())
            return TextInputAdmission::Busy;
        this.m_expectedModel.capture(model);
        this.m_publishedModel.captureSurrounding(model);
        TextInputSessionDesc desc;
        desc.caret = caret;
        desc.surrounding = model.text();
        desc.anchorByte = model.anchor();
        desc.caretByte = model.caret();
        const Expected<TextInputSessionToken, TextInputAdmission> result = this.m_service.begin(desc);
        if(!result.has_value()){
            this.m_expectedModel.clear();
            this.m_publishedModel.clear();
            return result.error();
        }
        this.m_token = result.value();
        this.m_owner = owner;
        this.m_lastSequence = 0u;
        this.m_surroundingRevision = this.m_service.surroundingRevision(this.m_token);
        return TextInputAdmission::Accepted;
    }

    [cpp_unwind] public TextInputAdmission refresh(in UiTextEditOwner owner, in EditModel model, in TextInputRect caret){
        return this.syncSession(owner, model, caret, TextInputChangeCause::InputMethod, false);
    }

    [cpp_unwind] public UiTextEditResult drain(in UiTextEditOwner owner, mut EditModel model){
        UiTextEditResult result;
        if(!this.m_service.isOwnerThread()){
            result.status = UiTextEditStatus::WrongThread;
            return result;
        }
        if(!this.m_token.valid())
            return result;
        if(this.m_owner != owner || !this.m_expectedModel.matches(model)){
            const b8 sameOwner = this.m_owner == owner;
            result.status = ResolveStaleUiTextEditSessionStatus(sameOwner, this.cancel());
            return result;
        }
        const u64 initialRevision = model.revision();
        for(usize index = 0u; index <= s_TextInputMaxEvents; ++index){
            const TextInputPollResult poll = this.m_service.poll(this.m_token, this.m_event);
            if(poll == TextInputPollResult::Pending)
                break;
            if(poll != TextInputPollResult::Event){
                if(poll == TextInputPollResult::WrongThread)
                    result.status = UiTextEditStatus::WrongThread;
                else
                    result.status = UiTextEditStatus::Cancelled;
                model.cancelComposition();
                if(!this.cancel())
                    result.status = UiTextEditStatus::NativeFailure;
                break;
            }
            if(this.m_event.token != this.m_token || !ValidateUiTextEditPollSequence(this.m_event.sequence, this.m_lastSequence, index, s_TextInputMaxEvents)){
                result.status = UiTextEditStatus::InvalidEvent;
            }
            else{
                this.m_lastSequence = this.m_event.sequence;
                result.status = ApplyUiTextEditEvent(model, this.m_event, this.m_surroundingRevision, this.m_publishedModel.matchesSurrounding(model));
            }
            if(result.status != UiTextEditStatus::Applied){
                model.cancelComposition();
                if(!this.cancel())
                    result.status = UiTextEditStatus::NativeFailure;
                break;
            }
            ++result.eventsApplied;
            this.m_expectedModel.capture(model);
        }
        result.textChanged = model.revision() != initialRevision;
        if(this.m_token.valid() && !this.m_publishedModel.matchesSurrounding(model)){
            if(this.publishSurrounding(model) != TextInputAdmission::Accepted){
                model.cancelComposition();
                result.status = UiTextEditStatus::NativeFailure;
                if(!this.cancel())
                    TerminateInvariant();
            }
        }
        return result;
    }

    public TextInputPollResult pollOwned(mut TextInputEvent event){
        if(!this.m_service.isOwnerThread())
            return TextInputPollResult::WrongThread;
        if(!this.m_token.valid())
            return TextInputPollResult::InvalidSession;
        return this.m_service.poll(this.m_token, event);
    }

    [cpp_unwind] public TextInputAdmission adoptLocal(in UiTextEditOwner owner, in EditModel model, in TextInputRect caret, in TextInputChangeCause cause){
        return this.syncSession(owner, model, caret, cause, true);
    }

    [cpp_unwind] public TextInputAdmission adoptLocal(in UiTextEditOwner owner, in EditModel model, in TextInputRect caret){
        return this.adoptLocal(owner, model, caret, TextInputChangeCause::Other);
    }

    public b8 end(in UiTextEditOwner owner, mut EditModel model){
        if(!this.m_service.isOwnerThread() || !this.m_token.valid() || this.m_owner != owner)
            return false;
        if(this.m_expectedModel.matches(model))
            model.cancelComposition();
        return this.cancel();
    }

    public b8 cancel(){
        if(!this.m_token.valid())
            return true;
        if(!this.m_service.isOwnerThread())
            return false;
        if(!this.m_service.end(this.m_token) && this.m_service.activeSession() == this.m_token)
            return false;
        this.m_token = TextInputSessionToken();
        this.m_owner = UiTextEditOwner();
        this.m_expectedModel.clear();
        this.m_publishedModel.clear();
        return true;
    }

    public TextInputSessionToken token()const{
        return this.m_token;
    }

    public in UiTextEditOwner owner()const{
        return this.m_owner;
    }

    public u64 surroundingRevision()const{
        if(this.m_token.valid())
            return this.m_surroundingRevision;
        return 0u;
    }

    public b8 matchesPublished(in UiTextEditOwner owner, in EditModel model)const{
        return this.m_token.valid() && this.m_owner == owner && this.m_expectedModel.matches(model) && this.m_publishedModel.matchesSurrounding(model);
    }

    [cpp_unwind] private TextInputAdmission syncSession(in UiTextEditOwner owner, in EditModel model, in TextInputRect caret, in TextInputChangeCause cause, in b8 adoptExpected){
        if(!this.m_service.isOwnerThread())
            return TextInputAdmission::WrongThread;
        b8 sessionValid = false;
        if(adoptExpected)
            sessionValid = this.m_service.activeSession() == this.m_token;
        else
            sessionValid = this.m_expectedModel.matches(model);
        if(!this.m_token.valid() || this.m_owner != owner || !sessionValid)
            return TextInputAdmission::InvalidSession;
        const TextInputAdmission admission = this.m_service.updateCaret(this.m_token, caret);
        if(admission != TextInputAdmission::Accepted)
            return admission;
        if(!this.m_publishedModel.matchesSurrounding(model)){
            const TextInputAdmission publish = this.publishSurrounding(model, cause);
            if(publish != TextInputAdmission::Accepted)
                return publish;
        }
        if(adoptExpected)
            this.m_expectedModel.capture(model);
        return TextInputAdmission::Accepted;
    }

    [cpp_unwind] private TextInputAdmission publishSurrounding(in EditModel model, in TextInputChangeCause cause){
        const TextInputAdmission admission = this.m_service.updateSurrounding(this.m_token, model.text(), model.anchor(), model.caret(), cause);
        if(admission != TextInputAdmission::Accepted)
            return admission;
        this.m_publishedModel.captureSurrounding(model);
        this.m_surroundingRevision = this.m_service.surroundingRevision(this.m_token);
        return TextInputAdmission::Accepted;
    }

    [cpp_unwind] private TextInputAdmission publishSurrounding(in EditModel model){
        return this.publishSurrounding(model, TextInputChangeCause::InputMethod);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


UiTextEditStatus ToUiTextEditAppliedStatus(in b8 applied){
    if(applied)
        return UiTextEditStatus::Applied;
    return UiTextEditStatus::ModelRejected;
}

UiTextEditStatus ResolveStaleUiTextEditSessionStatus(in b8 sameOwner, in b8 cancelledCleanly){
    if(!cancelledCleanly)
        return UiTextEditStatus::NativeFailure;
    if(sameOwner)
        return UiTextEditStatus::StaleModel;
    return UiTextEditStatus::StaleOwner;
}

b8 IsStaleUiTextEditSurroundingRevision(
    in u64 expectedSurroundingRevision,
    in u64 eventSurroundingRevision,
    in b8 matchesPublishedModel
){
    return expectedSurroundingRevision == 0u || eventSurroundingRevision != expectedSurroundingRevision || !matchesPublishedModel;
}

[cpp_unwind] UiTextEditStatus ApplyUiTextEditEvent(
    mut EditModel model,
    in TextInputEvent event,
    in u64 expectedSurroundingRevision,
    in b8 matchesPublishedModel
){
    switch(event.kind){
    case TextInputEventKind::Commit: {
        if(ValidateTextInputUtf8(event.text, s_TextInputMaxEventTextBytes) != TextInputAdmission::Accepted)
            return UiTextEditStatus::InvalidEvent;
        if(event.text.empty())
            return UiTextEditStatus::Applied;
        if(model.textMode() == EditTextMode::Multiline){
            const EditCompositionView composition = model.composition();
            const usize retainedBytes = ComputeUiTextEditRetainedBytes(
                composition,
                model.text().size(),
                model.selectionStart(),
                model.selectionEnd()
            );
            String normalized;
            const Expected<usize, EditTextStatus> status = NormalizeMultilineTextInto(
                StringView(event.text),
                model.limits().maxBytes - retainedBytes,
                normalized
            );
            if(!status.has_value())
                return UiTextEditStatus::ModelRejected;
            if(composition.active)
                return ToUiTextEditAppliedStatus(model.commitComposition(StringView(normalized)));
            return ToUiTextEditAppliedStatus(model.replaceSelection(StringView(normalized)));
        }
        if(model.composition().active)
            return ToUiTextEditAppliedStatus(model.commitComposition(event.text));
        return ToUiTextEditAppliedStatus(model.replaceSelection(event.text));
    }
    case TextInputEventKind::Preedit: {
        if(
            ValidateTextInputUtf8(event.text, s_TextInputMaxEventTextBytes) != TextInputAdmission::Accepted
            || !IsUtf8ScalarBoundary(event.text, event.anchorByte)
            || !IsUtf8ScalarBoundary(event.text, event.caretByte)
        )
            return UiTextEditStatus::InvalidEvent;
        if(event.text.empty()){
            model.cancelComposition();
            return UiTextEditStatus::Applied;
        }
        const b8 wasActive = model.composition().active;
        if(!wasActive && !model.beginComposition())
            return UiTextEditStatus::ModelRejected;
        if(model.updateComposition(event.text, event.anchorByte, event.caretByte))
            return UiTextEditStatus::Applied;
        if(!wasActive)
            model.cancelComposition();
        return UiTextEditStatus::ModelRejected;
    }
    case TextInputEventKind::DeleteSurrounding: {
        if(IsStaleUiTextEditSurroundingRevision(expectedSurroundingRevision, event.surroundingRevision, matchesPublishedModel))
            return UiTextEditStatus::StaleSurrounding;
        if(cast<u8>(event.deletionBasis) >= cast<u8>(TextInputDeletionBasis::Count))
            return UiTextEditStatus::InvalidEvent;
        if(event.deletionBasis == TextInputDeletionBasis::Selection){
            if(
                !ValidateUiTextEditSurroundingDeleteRange(
                    event.deleteBeforeBytes,
                    event.deleteAfterBytes,
                    model.selectionStart(),
                    model.selectionEnd(),
                    model.text().size()
                )
            )
                return UiTextEditStatus::InvalidEvent;
            return ToUiTextEditAppliedStatus(model.eraseAroundSelection(event.deleteBeforeBytes, event.deleteAfterBytes));
        }
        if(model.hasSelection() && (event.deleteBeforeBytes != 0u || event.deleteAfterBytes != 0u))
            return UiTextEditStatus::ModelRejected;
        const usize caret = model.caret();
        if(!ValidateUiTextEditSurroundingDeleteRange(event.deleteBeforeBytes, event.deleteAfterBytes, caret, caret, model.text().size()))
            return UiTextEditStatus::InvalidEvent;
        return ToUiTextEditAppliedStatus(model.eraseSurrounding(event.deleteBeforeBytes, event.deleteAfterBytes));
    }
    case TextInputEventKind::Cancelled:
        model.cancelComposition();
        return UiTextEditStatus::Cancelled;
    default:
        return UiTextEditStatus::InvalidEvent;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

