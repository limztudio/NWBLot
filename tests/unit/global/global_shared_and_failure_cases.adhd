void VerifyPlainOwnerComparisons<T>(){
    T first = T();
    T second = T();
    RequireNothrowExpression(OwnerEqual(first, s_NullOwner));
    RequireNothrowExpression(OwnerGreater(first, second));
    RequireNothrowExpression(OwnerLessEqual(first, second));
    RequireNothrowExpression(OwnerGreaterEqual(first, second));
}

void VerifyComparisonConversions<T>(mut u32 checks, mut b8 firstNull, mut b8 secondNull){
    T first = T();
    T second = T();
    RequireNothrowExpression(RawLess(first, second));
    RequireNothrowExpression(NegatedLess(first, second));
    RequireNothrowExpression(NegatedOwner(first));
    RequireThrowingExpression(OwnerEqual(first, s_NullOwner));
    ExpectUnsignedException(OwnerEqual(first, s_NullOwner));
    RequireThrowingExpression(OwnerGreater(first, second));
    ExpectUnsignedException(OwnerGreater(first, second));
    RequireThrowingExpression(OwnerLessEqual(first, second));
    ExpectUnsignedException(OwnerLessEqual(first, second));
    RequireThrowingExpression(OwnerGreaterEqual(first, second));
    ExpectUnsignedException(OwnerGreaterEqual(first, second));
    RequireThrowingExpression(OwnerGreater(first, s_NullOwner));
    ExpectUnsignedException(OwnerGreater(first, s_NullOwner));
    RequireThrowingExpression(OwnerGreater(s_NullOwner, first));
    ExpectUnsignedException(OwnerGreater(s_NullOwner, first));
    RequireThrowingExpression(OwnerLessEqual(first, s_NullOwner));
    ExpectUnsignedException(OwnerLessEqual(first, s_NullOwner));
    RequireThrowingExpression(OwnerLessEqual(s_NullOwner, first));
    ExpectUnsignedException(OwnerLessEqual(s_NullOwner, first));
    RequireThrowingExpression(OwnerGreaterEqual(first, s_NullOwner));
    ExpectUnsignedException(OwnerGreaterEqual(first, s_NullOwner));
    RequireThrowingExpression(OwnerGreaterEqual(s_NullOwner, first));
    ExpectUnsignedException(OwnerGreaterEqual(s_NullOwner, first));
    checks = 10u;
    firstNull = !HasOwner(first);
    secondNull = !HasOwner(second);
}


