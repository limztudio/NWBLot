void VerifyUiNestedPopupBuilderTests_ChildLayoutDoesNotConsumeParentSpaceAndRestoresItsPopupToken(mut UiNestedPopupBuilderTests self){
    ASSERT_TRUE(self.beginParent(1u));
    const PopupToken parent = self.m_context.popupToken();
    EXPECT_FALSE(self.m_builder.button(s_UiNestedPopupBuilderBeforeKey, "Before", self.controlOptions()));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiNestedPopupContextChildKey, self.m_child, MakeNestedChildPopupOptions()));
    const PopupToken child = self.m_context.popupToken();
    EXPECT_NE(child, parent);
    EXPECT_FALSE(self.m_builder.button(s_UiNestedPopupBuilderApplyKey, "Child", self.controlOptions()));
    ASSERT_TRUE(self.m_builder.endPopup());
    EXPECT_EQ(self.m_context.popupToken(), parent);
    EXPECT_FALSE(self.m_builder.balanced());
    EXPECT_FALSE(self.m_builder.button(s_UiNestedPopupBuilderAfterKey, "After", self.controlOptions()));
    ASSERT_TRUE(self.m_builder.endPopup());
    EXPECT_TRUE(self.m_builder.balanced());
    EXPECT_FALSE(self.m_context.popupToken().valid());
    ASSERT_TRUE(self.finishRoot());
    ASSERT_TRUE(self.m_context.commitFrame(1u));

    const Optional<HitTarget> before = self.findTarget(RequireUiWidgetId(self.parentId(), s_UiNestedPopupBuilderBeforeKey));
    const Optional<HitTarget> after = self.findTarget(RequireUiWidgetId(self.parentId(), s_UiNestedPopupBuilderAfterKey));
    const Optional<HitTarget> apply = self.findTarget(RequireUiWidgetId(self.childId(), s_UiNestedPopupBuilderApplyKey));
    ASSERT_TRUE(before.has_value());
    ASSERT_TRUE(after.has_value());
    ASSERT_TRUE(apply.has_value());
    EXPECT_EQ(before.value().popup, parent);
    EXPECT_EQ(after.value().popup, parent);
    EXPECT_EQ(apply.value().popup, child);
    EXPECT_FLOAT_EQ(after.value().rectangle.x, before.value().rectangle.x);
    EXPECT_FLOAT_EQ(after.value().rectangle.y, before.value().rectangle.y + before.value().rectangle.height + self.m_builder.style().gap);
    EXPECT_GT(apply.value().rectangle.x, self.m_parent.placement().bounds.x + self.m_parent.placement().bounds.width);
    EXPECT_EQ(self.m_context.input().focus(), apply.value().id);
}

void VerifyUiNestedPopupBuilderTests_ChildOpenedInsideARowRestoresTheSameParentContainer(mut UiNestedPopupBuilderTests self){
    ASSERT_TRUE(self.beginParent(1u));
    ContainerOptions rowOptions = ContainerOptions();
    rowOptions.width.policy = LayoutSizePolicy::Fixed;
    rowOptions.width.value = 240.0f;
    rowOptions.height.policy = LayoutSizePolicy::Fixed;
    rowOptions.height.value = 30.0f;
    rowOptions.gap = 5.0f;
    ASSERT_TRUE(self.m_builder.beginRow("row", rowOptions));
    const WidgetId row = RequireUiWidgetId(self.parentId(), "row");
    EXPECT_FALSE(self.m_builder.button(s_UiNestedPopupBuilderBeforeKey, "Before", self.controlOptions(100.0f)));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiNestedPopupContextChildKey, self.m_child, MakeNestedChildPopupOptions()));
    EXPECT_FALSE(self.m_builder.button(s_UiNestedPopupBuilderApplyKey, "Child", self.controlOptions()));
    ASSERT_TRUE(self.m_builder.endPopup());
    EXPECT_EQ(self.m_context.scopeId(), row);
    EXPECT_FALSE(self.m_builder.button(s_UiNestedPopupBuilderAfterKey, "After", self.controlOptions(100.0f)));
    ASSERT_TRUE(self.m_builder.endContainer());
    ASSERT_TRUE(self.m_builder.endPopup());
    ASSERT_TRUE(self.finishRoot());
    ASSERT_TRUE(self.m_context.commitFrame(1u));

    const Optional<HitTarget> before = self.findTarget(RequireUiWidgetId(row, s_UiNestedPopupBuilderBeforeKey));
    const Optional<HitTarget> after = self.findTarget(RequireUiWidgetId(row, s_UiNestedPopupBuilderAfterKey));
    const Optional<HitTarget> apply = self.findTarget(RequireUiWidgetId(RequireUiWidgetId(row, s_UiNestedPopupContextChildKey), s_UiNestedPopupBuilderApplyKey));
    ASSERT_TRUE(before.has_value());
    ASSERT_TRUE(after.has_value());
    ASSERT_TRUE(apply.has_value());
    EXPECT_FLOAT_EQ(after.value().rectangle.x, before.value().rectangle.x + before.value().rectangle.width + rowOptions.gap);
    EXPECT_FLOAT_EQ(after.value().rectangle.y, before.value().rectangle.y);
    EXPECT_EQ(before.value().popup, after.value().popup);
    EXPECT_NE(apply.value().popup, before.value().popup);
}

void VerifyUiNestedPopupBuilderTests_ClosedChildBeginLeavesParentScopeAndFollowingControlsIntact(mut UiNestedPopupBuilderTests self){
    self.m_child.close();
    ASSERT_TRUE(self.beginParent(1u));
    const PopupToken parent = self.m_context.popupToken();
    EXPECT_FALSE(self.m_builder.button(s_UiNestedPopupBuilderBeforeKey, "Before", self.controlOptions()));
    EXPECT_FALSE(self.m_builder.beginPopup(s_UiNestedPopupContextChildKey, self.m_child, MakeNestedChildPopupOptions()));
    EXPECT_FALSE(self.m_context.failed());
    EXPECT_EQ(self.m_context.popupToken(), parent);
    EXPECT_EQ(self.m_context.scopeId(), self.parentId());
    EXPECT_FALSE(self.m_builder.button(s_UiNestedPopupBuilderAfterKey, "After", self.controlOptions()));
    ASSERT_TRUE(self.m_builder.endPopup());
    ASSERT_TRUE(self.finishRoot());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const Optional<HitTarget> after = self.findTarget(RequireUiWidgetId(self.parentId(), s_UiNestedPopupBuilderAfterKey));
    ASSERT_TRUE(after.has_value());
    EXPECT_FALSE(self.hasTarget(self.childId()));
    EXPECT_EQ(after.value().popup, parent);
}

void VerifyUiNestedPopupBuilderTests_ChildPaintEscapesParentClipAndLayersRemainOrdered(mut UiNestedPopupBuilderTests self){
    ASSERT_TRUE(self.prepareButtons(1u));
    const DrawSnapshot snapshot = self.m_paint.freeze();
    ASSERT_FALSE(snapshot.commands().empty());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const Optional<HitTarget> apply = self.findTarget(RequireUiWidgetId(self.childId(), s_UiNestedPopupBuilderApplyKey));
    ASSERT_TRUE(apply.has_value());
    EXPECT_GT(apply.value().clip.x, self.m_parent.placement().bounds.x + self.m_parent.placement().bounds.width);
    EXPECT_LE(apply.value().clip.x, apply.value().rectangle.x);
    EXPECT_LE(apply.value().clip.y, apply.value().rectangle.y);
    // Lanes are clip right, clip bottom, rectangle right, rectangle bottom.
    const VectorSingle edges = VectorSingle(apply.value().clip.x, apply.value().clip.y, apply.value().rectangle.x, apply.value().rectangle.y) + VectorSingle(apply.value().clip.width, apply.value().clip.height, apply.value().rectangle.width, apply.value().rectangle.height);
    EXPECT_GE(edges.x, edges.z);
    EXPECT_GE(edges.y, edges.w);
    const Optional<HitTarget> after = self.findTarget(RequireUiWidgetId(self.parentId(), s_UiNestedPopupBuilderAfterKey));
    ASSERT_TRUE(after.has_value());
    EXPECT_GT(apply.value().layer, after.value().layer);
    const Point applyCenter = CenterUiRect(apply.value().rectangle);
    EXPECT_EQ(self.m_context.input().hitTest(applyCenter), apply.value().id);
    u32 previousLayer = 0u;
    b8 childPainted = false;
    for(in DrawCommand command : snapshot.commands()){
        EXPECT_GE(command.layer, previousLayer);
        previousLayer = command.layer;
        childPainted = childPainted || (command.layer == apply.value().layer);
    }
    EXPECT_TRUE(childPainted);
}

void VerifyUiNestedPopupBuilderTests_ChildActionLeavesBothParentControlsAvailableOnLaterDeclarations(mut UiNestedPopupBuilderTests self){
    ASSERT_TRUE(self.acceptButtons(1u));
    const Optional<HitTarget> apply = self.findTarget(RequireUiWidgetId(self.childId(), s_UiNestedPopupBuilderApplyKey));
    ASSERT_TRUE(apply.has_value());
    const Point applyCenter = CenterUiRect(apply.value().rectangle);
    self.click(applyCenter);
    ASSERT_TRUE(self.acceptButtons(2u));
    EXPECT_TRUE(self.m_childActivated);
    EXPECT_FALSE(self.m_beforeActivated);
    EXPECT_FALSE(self.m_afterActivated);
    self.m_child.close();
    ASSERT_TRUE(self.acceptButtons(3u));
    const Optional<HitTarget> after = self.findTarget(RequireUiWidgetId(self.parentId(), s_UiNestedPopupBuilderAfterKey));
    ASSERT_TRUE(after.has_value());
    EXPECT_FALSE(self.hasTarget(RequireUiWidgetId(self.childId(), s_UiNestedPopupBuilderApplyKey)));
    const Point afterCenter = CenterUiRect(after.value().rectangle);
    self.click(afterCenter);
    ASSERT_TRUE(self.acceptButtons(4u));
    EXPECT_TRUE(self.m_afterActivated);
    EXPECT_FALSE(self.m_beforeActivated);
    EXPECT_TRUE(self.m_parent.isOpen());
}

void VerifyUiNestedPopupBuilderTests_NestedScopeCapacityRejectsTheNextChildWithoutPublishingTheCandidate(mut UiNestedPopupBuilderTests self){
    ASSERT_EQ(s_InputMaxPopups, 8u);
    Array<PopupState, 9u> states = Array<PopupState, 9u>();
    ASSERT_TRUE(self.begin(1u));
    for(usize index = 0u; index < s_InputMaxPopups; ++index){
        states[index].open();
        ASSERT_TRUE(self.m_builder.beginPopup("level", states[index], MakeNestedParentPopupOptions()));
    }
    states[s_InputMaxPopups].open();
    EXPECT_FALSE(self.m_builder.beginPopup("level", states[s_InputMaxPopups], MakeNestedChildPopupOptions()));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(1u));
    EXPECT_TRUE(self.m_context.input().targets().empty());
}

