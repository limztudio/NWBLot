////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_AVBOIT_ACCUMULATE_TRANSMITTANCE_SLANGI
#define NWB_GRAPHICS_AVBOIT_ACCUMULATE_TRANSMITTANCE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


uint nwbAvboitActivePhysicalSliceCount(){
    return clamp(nwbAvboitControl()[NWB_AVBOIT_CONTROL_ACTIVE_PHYSICAL_SLICES], 1u, nwbAvboitPhysicalSliceCount());
}

float nwbAvboitPhysicalSliceFromVirtualSampleSlice(float sampleSlice){
    const uint virtualSliceCount = nwbAvboitVirtualSliceCount();
    const uint activeMax = nwbAvboitActivePhysicalSliceCount() - 1u;
    const float sliceBase = floor(sampleSlice);
    const uint virtualSlice0 = min(uint(sliceBase), virtualSliceCount - 1u);
    const uint virtualSlice1 = min(virtualSlice0 + 1u, virtualSliceCount - 1u);
    const float physicalSlice0 = float(min(nwbAvboitDepthWarp()[virtualSlice0], activeMax));
    if(virtualSlice1 == virtualSlice0)
        return physicalSlice0;
    const float physicalSlice1 = float(min(nwbAvboitDepthWarp()[virtualSlice1], activeMax));
    return lerp(physicalSlice0, physicalSlice1, sampleSlice - sliceBase);
}

half nwbAvboitLinearBiasedTransmittance(float2 fragCoord, float depth){
    const uint virtualSliceCount = nwbAvboitVirtualSliceCount();
    const float virtualSliceMax = max(float(virtualSliceCount) - 1.0, 0.0);
    const float sampleSlice = clamp(depth * float(virtualSliceCount) - nwbAvboitSelfOcclusionSliceBias(), 0.0, virtualSliceMax);
    const float physicalSlice = nwbAvboitPhysicalSliceFromVirtualSampleSlice(sampleSlice);
    const float physicalSliceUv = (physicalSlice + 0.5) / max(float(nwbAvboitPhysicalSliceCount()), 1.0);
    return half(nwbAvboitTransmittanceTexture().Sample(nwbAvboitAccumulationSampler(), float3(nwbAvboitFullUvFromFragCoord(fragCoord), clamp(physicalSliceUv, 0.0, 1.0))).r);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

