class StemExtensionCase{
    public StringView input;
    public StringView stem;
    public StringView extension;

    public StemExtensionCase(in StringView inInput, in StringView inStem, in StringView inExtension){
        this.input = inInput;
        this.stem = inStem;
        this.extension = inExtension;
    }
}

class RelativeAssetPathCase{
    public StringView input;
    public StringView expected;
    public b8 accepted;

    public RelativeAssetPathCase(in StringView inInput, in StringView inExpected, in b8 inAccepted){
        this.input = inInput;
        this.expected = inExpected;
        this.accepted = inAccepted;
    }
}

b8 DeserializeNullAllocatedCodec(in Name virtualPath, in AssetBytes bytes, mut AssetArena arena){
    NullAllocatedCodec codec = NullAllocatedCodec();
    return codec.deserialize(virtualPath, bytes, arena).has_value();
}

b8 BuildRelativeForGraphicsPath(in GraphicsTestPath path, mut ScratchString output){
    return BuildRelativeAssetPathText(path, output);
}

b8 BuildRelativeForScratchPath(in ScratchPath path, mut ScratchString output){
    return BuildRelativeAssetPathText(path, output);
}

Expected<ScratchString> BuildDerivedScratchPath(in GraphicsTestPath assetRoot, in StringView virtualRoot, in GraphicsTestPath source, mut ScratchArena scratchArena){
    return BuildDerivedAssetVirtualPathText(assetRoot, virtualRoot, source, scratchArena, scratchArena);
}

Expected<AssetString> BuildDerivedOwnedFromScratchSource(mut PathFixture fixture, in ScratchPath source, mut ScratchArena scratchArena){
    return BuildDerivedAssetVirtualPathText(fixture.assetRoot, s_ProjectVirtualRoot, source, fixture.arena, scratchArena);
}

b8 CanBuildDerivedVirtualPath(in GraphicsTestPath assetRoot, in StringView virtualRoot, in GraphicsTestPath source, mut ScratchArena scratchArena){
    return BuildDerivedAssetVirtualPath(assetRoot, virtualRoot, source, scratchArena).has_value();
}

b8 VerifyDerivedFixturePath(in PathFixture fixture, mut ScratchArena scratchArena){
    return BuildAndVerifyDerivedAssetPath(fixture, scratchArena);
}

void PrepareFixturePathWorkload(in usize directoryCount, in StringView directoryToken, in usize tokenRepeats, mut PathFixture fixture){
    PrepareAssetPathWorkload(directoryCount, directoryToken, tokenRepeats, fixture);
}

b8 GatherBuiltToOutputHelper(mut TestArena testArena, in GraphicsTestPath builtDir, in GraphicsTestPath outDir, mut ScratchArena scratchArena){
    return GatherBuiltDirectoryToOutput(testArena, builtDir, outDir, scratchArena);
}

Expected<SamplerAsset> LoadCookedSamplerHelper(in GraphicsTestPath outputDirectory, in Name assetName, in usize expectedVolumeFileCount, mut TestArena testArena){
    return LoadCookedSamplerAsset(outputDirectory, assetName, expectedVolumeFileCount, testArena);
}

b8 WriteBuiltManifestHelper(in GraphicsTestPath directory, in AssetVolumePackManifest manifest, mut ScratchArena scratchArena){
    return WriteBuiltAssets(directory, manifest, scratchArena);
}

b8 ReadManifestArtifactPaths(in GraphicsTestPath manifestPath, mut ScratchArena scratchArena, mut AssetTestVector<AssetString> outPaths){
    return ReadAssetInputList(manifestPath, scratchArena, outPaths, true);
}

void CorruptLastManifestEntryHash(mut AssetVolumePackManifest manifest){
    CorruptManifestLastPayloadHash(manifest);
}

void VerifyAssetCodecAdmission_NullClassAllocationDoesNotCallAssetLoad(){
    AssetArena arena(s_AssetCaseTestsAssetCodecNullAllocation);
    AssetBytes bytes(arena);
    NullAllocatedAsset::ResetTracking();
    EXPECT_FALSE(DeserializeNullAllocatedCodec(s_AssetCaseProjectTestsNullAsset, bytes, arena));
    EXPECT_EQ(NullAllocatedAsset::ConstructorCalls(), 0u);
    EXPECT_FALSE(NullAllocatedAsset::LoadCalled());
}

void VerifyAssetConstructorContracts_ImplicitNameBindingCanThrowDespiteNothrowExplicitConversion(){
    AssetArena arena(s_AssetInputNameTestsAssetConstructorImplicitName);
    native(mut arena){
        EXPECT_THROW(ImplicitNameAsset{}, u32);
        EXPECT_THROW(ImplicitNameAsset{Name(s_AssetInputNameProjectTestsNameConversion)}, u32);
        EXPECT_THROW(ImplicitNameCodec{}, u32);
        EXPECT_THROW(ImplicitNameShader{arena}, u32);
        EXPECT_THROW((ImplicitNameShader{arena, Name(s_AssetInputNameProjectTestsShaderNameConversion)}), u32);
        EXPECT_THROW((Impl::ShaderAssetCodec<ImplicitNameShader>{}), u32);
    }
}

void VerifyAssetConstructorContracts_CastIncludesTheCompleteContextualComparisonConversion(){
    ContextualComparisonAsset asset = ContextualComparisonAsset();
    EXPECT_EQ(asset.virtualPath(), Name());
    b8 nullCastReturnsNull = false;
    native(in asset, mut nullCastReturnsNull){
        using namespace NWB::Core::Assets;
        EXPECT_THROW({ EXPECT_EQ(CastAsset<ContextualComparisonAsset>(&asset), &asset); }, u32);
        nullCastReturnsNull = CastAsset<ContextualComparisonAsset>(nullptr) == nullptr;
    }
    EXPECT_TRUE(nullCastReturnsNull);
}

void VerifyAssetPaths_MetadataAssetDeclarationUsesTheCookerNameRegardlessOfDeclarationOrder(){
    AssetArena arena(s_AssetCaseTestsAssetPathMetadataDeclaration);
    MetaDocument document(arena);
    ASSERT_TRUE(document.parse("metadata helper; sampler decoy; texture asset;"));
    ASSERT_TRUE(HasMetaDeclaration(document, s_MetadataAssetVariable));
    EXPECT_EQ(GetMetaDeclarationVariable(document, s_MetadataAssetVariable), "asset");
    EXPECT_EQ(GetMetaDeclarationType(document, s_MetadataAssetVariable), "texture");
    EXPECT_FALSE(IsFirstMetaDeclaration(document, s_MetadataAssetVariable));

    ASSERT_TRUE(document.parse("texture entry;"));
    ASSERT_TRUE(HasMetaDeclaration(document, "entry"));
    EXPECT_FALSE(HasMetaDeclaration(document, s_MetadataAssetVariable));
}

void VerifyAssetPaths_RelativeComponentsPreserveDotsAndCanonicalizeOnlyAsciiText(){
    AssetArena inputArena(s_AssetCaseTestsAssetPathRelativeInputs);
    ScratchArena scratchArena(s_AssetCaseTestsAssetPathRelativeScratch);

    Vector<RelativeAssetPathCase> cases = Vector<RelativeAssetPathCase>();
    cases.reserve(10u);
    cases.push_back(RelativeAssetPathCase("Models//./Hero.LOD0.NWB///", "models/hero.lod0.nwb", true));
    cases.push_back(RelativeAssetPathCase("./.Hidden/../Ignored", ".hidden", false));
    cases.push_back(RelativeAssetPathCase("Dir.Name/.../File.", "dir.name/.../file.", true));
    cases.push_back(RelativeAssetPathCase("", "", false));
    cases.push_back(RelativeAssetPathCase(".", "", false));
    cases.push_back(RelativeAssetPathCase("././", "", false));
    cases.push_back(RelativeAssetPathCase("../After", "", false));
    cases.push_back(RelativeAssetPathCase("Valid/Part/../After", "valid/part", false));
    cases.push_back(RelativeAssetPathCase("Valid/./../After", "valid", false));
    cases.push_back(RelativeAssetPathCase("/Rooted/After", "", false));

    ScratchString output(scratchArena);
    for(in RelativeAssetPathCase testCase : cases){
        const ScopedTestTrace trace(testCase.input);
        output.assign(s_StaleRelativeOutput);
        const GraphicsTestPath path(inputArena, testCase.input);
        EXPECT_EQ(BuildRelativeForGraphicsPath(path, output), testCase.accepted);
        EXPECT_EQ(ViewArenaString(output), testCase.expected);
        const ScratchPath scratchPath(scratchArena, testCase.input);
        EXPECT_EQ(BuildRelativeForScratchPath(scratchPath, output), testCase.accepted);
        EXPECT_EQ(ViewArenaString(output), testCase.expected);
    }
}

void VerifyAssetPaths_RelativeBackslashesFollowHostComponentRulesBeforeCanonicalization(){
    AssetArena inputArena(s_AssetCaseTestsAssetPathSeparatorInputs);
    ScratchArena scratchArena(s_AssetCaseTestsAssetPathSeparatorScratch);
    ScratchString output(scratchArena);
    const GraphicsTestPath path(inputArena, "Prefix/Upper\\Name//./File");
    if(IsWindowsPlatformHost()){
        ASSERT_TRUE(BuildRelativeForGraphicsPath(path, output));
        EXPECT_EQ(ViewArenaString(output), "prefix/upper/name/file");
        const GraphicsTestPath driveRoot(inputArena, "C:\\Root\\File");
        EXPECT_FALSE(BuildRelativeForGraphicsPath(driveRoot, output));
        EXPECT_TRUE(output.empty());
        const GraphicsTestPath driveOnly(inputArena, "C:");
        EXPECT_TRUE(BuildRelativeForGraphicsPath(driveOnly, output));
        EXPECT_EQ(ViewArenaString(output), "c:");
    }
    else{
        EXPECT_FALSE(BuildRelativeForGraphicsPath(path, output));
        EXPECT_EQ(ViewArenaString(output), "prefix");
    }
}

void VerifyAssetPaths_DerivedPathRemovesOnlyFinalExtensionAndPreservesVirtualRootText(){
    PathFixture fixture = PathFixture();
    ScratchArena scratchArena(s_AssetCaseTestsAssetPathDerivedScratch);

    const GraphicsTestPath source = JoinGraphicsPath(fixture.assetRoot, "Models//./Hero.LOD0.NWB");
    const Expected<ScratchString> output = BuildDerivedScratchPath(fixture.assetRoot, "MiXeD/Root", source, scratchArena);
    ASSERT_TRUE(output.has_value());
    EXPECT_EQ(ViewArenaString(output.value()), "MiXeD/Root/models/hero.lod0");

    const GraphicsTestPath hiddenSource = JoinGraphicsPath(fixture.assetRoot, "Folder.Name/.Hidden");
    const Expected<ScratchString> hiddenOutput = BuildDerivedScratchPath(fixture.assetRoot, s_ProjectVirtualRoot, hiddenSource, scratchArena);
    ASSERT_TRUE(hiddenOutput.has_value());
    EXPECT_EQ(ViewArenaString(hiddenOutput.value()), "project/folder.name/.hidden");

    const GraphicsTestPath extensionlessSource = JoinGraphicsPath(fixture.assetRoot, "Folder/NoExtension");
    const Expected<ScratchString> extensionlessOutput = BuildDerivedScratchPath(fixture.assetRoot, "", extensionlessSource, scratchArena);
    ASSERT_TRUE(extensionlessOutput.has_value());
    EXPECT_EQ(ViewArenaString(extensionlessOutput.value()), "/folder/noextension");
}

void VerifyAssetPaths_DerivedOwningTextOutlivesBorrowedScratchSourcePath(){
    PathFixture fixture = PathFixture();
    AssetString retained(fixture.arena);
    {
        ScratchArena scratchArena(s_AssetCaseTestsAssetPathBorrowedSourceScratch);
        const ScratchPath rootCopy(scratchArena, fixture.assetRoot);
        const ScratchPath relative(scratchArena, "Models/Hero.LOD0.NWB");
        const ScratchPath source = rootCopy / relative;
        Expected<AssetString> output = BuildDerivedOwnedFromScratchSource(fixture, source, scratchArena);
        ASSERT_TRUE(output.has_value());
        retained = output.value();
    }
    EXPECT_EQ(ViewArenaString(retained), "project/models/hero.lod0");
}

void VerifyAssetPaths_DerivedPathRejectsOutsideAndEmptyLogicalPaths(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration(logger, s_BreakOnFatal);
    PathFixture fixture = PathFixture();
    ScratchArena scratchArena(s_AssetCaseTestsAssetPathRejectionScratch);

    const GraphicsTestPath outside = JoinGraphicsPath(fixture.assetRoot, "../Elsewhere/Model.NWB");
    EXPECT_FALSE(BuildDerivedScratchPath(fixture.assetRoot, s_ProjectVirtualRoot, outside, scratchArena).has_value());
    EXPECT_FALSE(CanBuildDerivedVirtualPath(fixture.assetRoot, s_ProjectVirtualRoot, outside, scratchArena));
    EXPECT_FALSE(BuildDerivedScratchPath(fixture.assetRoot, s_ProjectVirtualRoot, fixture.assetRoot, scratchArena).has_value());
    EXPECT_FALSE(CanBuildDerivedVirtualPath(fixture.assetRoot, s_ProjectVirtualRoot, fixture.assetRoot, scratchArena));
    EXPECT_EQ(logger.errorCount(), 4u);
}

void VerifyAssetPaths_LongAsciiAndUnicodePathsRemainCorrectAcrossRepeatedCallerArenaUse(){
    for(u32 mode = 0u; mode < 2u; ++mode){
        const b8 unicode = mode == 1u;
        PathFixture fixture = PathFixture();
        StringView directoryToken = "Long_COMPONENT_";
        usize tokenRepeats = 12u;
        if(unicode){
            directoryToken = "ÉTAGE_한글_東京_😀_";
            tokenRepeats = 8u;
        }
        PrepareFixturePathWorkload(8u, directoryToken, tokenRepeats, fixture);
        ScratchArena scratchArena(s_AssetCaseTestsAssetPathRepeatedScratch, 65536u);
        ScratchArenaSentinel sentinel(scratchArena);
        ASSERT_TRUE(sentinel.valid());
        const ArenaMemoryStats retained = scratchArena.memoryStats();
        ArenaMemoryStats warm = ArenaMemoryStats();
        for(usize call = 0u; call < 16u; ++call){
            {
                ScratchString relative(scratchArena);
                ASSERT_TRUE(BuildRelativeForGraphicsPath(fixture.relativePath, relative));
                EXPECT_EQ(ViewArenaString(relative), ViewArenaString(fixture.expectedRelative));
                EXPECT_TRUE(HasTrailingNullTerminator(relative));
            }
            EXPECT_TRUE(VerifyDerivedFixturePath(fixture, scratchArena));
            EXPECT_TRUE(sentinel.intact());
            const ArenaMemoryStats after = scratchArena.memoryStats();
            if(call == 0u)
                warm = after;
            EXPECT_EQ(after.usedBytes, retained.usedBytes);
            EXPECT_EQ(after.reservedBytes, warm.reservedBytes);
        }
        const GraphicsTestPath parentInput = JoinGraphicsPath2(fixture.sourcePath, "..", "Second.LOD1.NWB");
        for(usize call = 0u; call < 16u; ++call){
            {
                const ScratchPath source(scratchArena, parentInput);
                const ScratchPath normal = source.lexicallyNormal();
                const ScratchPath stem = normal.stem();
                const ScratchPath extension = normal.extension();
                EXPECT_EQ(PathToString(stem), "Second.LOD1");
                EXPECT_EQ(PathToString(extension), ".NWB");
            }
            EXPECT_EQ(scratchArena.memoryStats().usedBytes, retained.usedBytes);
        }
        for(usize call = 0u; call < 16u; ++call){
            b8 relativeEmpty = true;
            {
                const ScratchPath source(scratchArena, fixture.relativePath);
                const ScratchPath emptyBase(scratchArena);
                const ScratchPath relative = source.lexicallyRelative(emptyBase);
                relativeEmpty = relative.empty();
            }
            EXPECT_FALSE(relativeEmpty);
            EXPECT_EQ(scratchArena.memoryStats().usedBytes, retained.usedBytes);
        }
        sentinel.release();
    }
}

