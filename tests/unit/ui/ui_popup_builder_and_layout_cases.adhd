void VerifyUiPopupBuilderTests_ReplacementClosedStateImmediatelyFencesPreviousAcceptedPopupEpoch(mut UiPopupBuilderTests self){
    PopupState original = PopupState();
    original.open();
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiPopupBuilderPopupKey, original, MakeUiPopupAnchoredOptions()));
    EXPECT_FALSE(self.m_builder.button(s_UiPopupBuilderApplyKey, "Apply", MakeUiPopupControlOptions()));
    ASSERT_TRUE(self.finishPopup());
    const DrawSnapshot accepted = self.m_paint.freeze();
    EXPECT_FALSE(accepted.commands().empty());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const WidgetId child = self.id(s_UiPopupBuilderApplyKey, s_UiPopupBuilderPopupKey);
    const auto childTarget = self.findTarget(child);
    ASSERT_TRUE(childTarget.has_value());
    self.click(MakeUiPopupPoint(childTarget.value().rectangle.x + 4.0f, childTarget.value().rectangle.y + 4.0f));
    ASSERT_EQ(self.m_context.input().actions().size(), 1u);
    PopupState replacement = PopupState();
    ASSERT_NE(replacement.instanceGeneration(), original.instanceGeneration());
    ASSERT_TRUE(self.begin(2u));
    EXPECT_FALSE(self.m_builder.beginPopup(s_UiPopupBuilderPopupKey, replacement, MakeUiPopupAnchoredOptions()));
    EXPECT_FALSE(self.m_context.failed());
    EXPECT_TRUE(self.m_builder.balanced());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_TRUE(self.m_context.input().actions().empty());
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiPopupPoint(55.0f, 100.0f)).valid());
    EXPECT_TRUE(original.isOpen());
    EXPECT_FALSE(replacement.isOpen());
    ASSERT_TRUE(self.finishRoot());
    const DrawSnapshot closed = self.m_paint.freeze();
    EXPECT_TRUE(closed.commands().empty());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_TRUE(self.m_context.input().targets().empty());
}

void VerifyUiPopupBuilderTests_MissingPopupAndPanelSkinRejectsAdmissionWithoutChangingPreviousPlacement(mut UiPopupBuilderTests self){
    PopupState state = PopupState();
    state.open();
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiPopupBuilderPopupKey, state, MakeUiPopupAnchoredOptions()));
    EXPECT_FALSE(self.m_builder.button(s_UiPopupBuilderApplyKey, "Apply", MakeUiPopupControlOptions()));
    ASSERT_TRUE(self.finishPopup());
    const DrawSnapshot accepted = self.m_paint.freeze();
    EXPECT_FALSE(accepted.commands().empty());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const Rect previous = state.placement().bounds;
    self.configureSkin("panel.normal");
    PopupOptions moved = MakeUiPopupAnchoredOptions();
    moved.anchor = MakeUiPopupRect(300.0f, 300.0f, 80.0f, 24.0f);
    ASSERT_TRUE(self.begin(2u));
    EXPECT_FALSE(self.m_builder.beginPopup(s_UiPopupBuilderPopupKey, state, moved));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_TRUE(self.m_builder.balanced());
    ExpectUiRect(state.placement().bounds, previous);
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    EXPECT_TRUE(self.hasTarget(self.id(s_UiPopupBuilderApplyKey, s_UiPopupBuilderPopupKey)));
}


