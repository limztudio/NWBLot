void VerifySurfelGiQualitySettings_RejectsUnsupportedResolveScales(){
    Array<u32, 5> factors = Array<u32, 5>();
    factors[0u] = 0u;
    factors[1u] = 1u;
    factors[2u] = 3u;
    factors[3u] = 5u;
    factors[4u] = 255u;
    for(in u32 factor : factors){
        SurfelGiQualitySettings settings = SurfelGiQualitySettings();
        settings.resolveResolution = cast<SurfelGiResolveResolutionEnum>(factor);
        EXPECT_FALSE(ValidateSurfelGiQualitySettings(settings));
    }
}

void VerifySurfelGiQualitySettings_OddResizeKeepsEveryFullPixelInsideTheGatherGrid(){
    Array<u32, 2> factors = Array<u32, 2>();
    factors[0u] = 2u;
    factors[1u] = 4u;
    Array<u32, 6> widths = Array<u32, 6>();
    widths[0u] = 1u;
    widths[1u] = 3u;
    widths[2u] = 4u;
    widths[3u] = 5u;
    widths[4u] = 1000u;
    widths[5u] = 1001u;
    Array<u32, 6> heights = Array<u32, 6>();
    heights[0u] = 1u;
    heights[1u] = 3u;
    heights[2u] = 4u;
    heights[3u] = 5u;
    heights[4u] = 700u;
    heights[5u] = 701u;
    for(in u32 factor : factors){
        for(in u32 width : widths){
            for(in u32 height : heights){
                const SurfelGiResolveSize size = MakeSurfelGiResolveSize(width, height, factor);
                ASSERT_GT(size.width, 0u);
                ASSERT_GT(size.height, 0u);
                EXPECT_LT((size.width - 1u) * factor, width);
                EXPECT_LT((size.height - 1u) * factor, height);
                EXPECT_GE(size.width * factor, width);
                EXPECT_GE(size.height * factor, height);
                EXPECT_LT((width - 1u) / factor, size.width);
                EXPECT_LT((height - 1u) / factor, size.height);
            }
        }
    }
}

void VerifySurfelGiQualitySettings_EmptyAndLargestExtentsDoNotWrapTheReducedSize(){
    Array<u32, 2> factors = Array<u32, 2>();
    factors[0u] = 2u;
    factors[1u] = 4u;
    for(in u32 factor : factors){
        const SurfelGiResolveSize empty = MakeSurfelGiResolveSize(0u, 0u, factor);
        EXPECT_EQ(empty.width, 0u);
        EXPECT_EQ(empty.height, 0u);
        const SurfelGiResolveSize largest = MakeSurfelGiResolveSize(u32.max, u32.max, factor);
        EXPECT_GE(cast<u64>(largest.width) * cast<u64>(factor), cast<u64>(u32.max));
        EXPECT_LT(cast<u64>(largest.width - 1u) * cast<u64>(factor), cast<u64>(u32.max));
        EXPECT_EQ(largest.width, largest.height);
    }
}

void VerifySurfelHash_SymmetricHashCollisionAdmitsEachResidentCellOnce(){
    const SurfelHashInt3 negative = SurfelHashInt3(-1, -1, 0);
    const SurfelHashInt3 positive = SurfelHashInt3(1, 1, 0);
    ASSERT_EQ(nwbSurfelHashCell(negative, s_SurfelHashCellCount), nwbSurfelHashCell(positive, s_SurfelHashCellCount));
    Array<Float3U, 2> residents = Array<Float3U, 2>();
    residents[0u] = Float3U(-0.01f, -0.01f, 0.0f);
    residents[1u] = Float3U(0.61f, 0.61f, 0.0f);
    Array<SurfelHashInt3, 2> residentCells = Array<SurfelHashInt3, 2>();
    residentCells[0u] = nwbSurfelCellCoord(residents[0u], s_SurfelCellSize);
    residentCells[1u] = nwbSurfelCellCoord(residents[1u], s_SurfelCellSize);
    Array<u32, 2> bucketVisits = Array<u32, 2>();
    Array<u32, 2> admittedVisits = Array<u32, 2>();
    for(i32 z = -2; z <= 2; ++z){
        for(i32 y = -2; y <= 2; ++y){
            for(i32 x = -2; x <= 2; ++x){
                const SurfelHashInt3 visitedCell = SurfelHashInt3(x, y, z);
                const u32 visitedBucket = nwbSurfelHashCell(visitedCell, s_SurfelHashCellCount);
                for(usize index = 0u; index < 2u; ++index){
                    if(nwbSurfelHashCell(residentCells[index], s_SurfelHashCellCount) != visitedBucket)
                        continue;
                    ++bucketVisits[index];
                    if(nwbSurfelSameCell(residentCells[index], visitedCell))
                        ++admittedVisits[index];
                }
            }
        }
    }
    for(usize index = 0u; index < 2u; ++index){
        EXPECT_GT(bucketVisits[index], 1u);
        EXPECT_EQ(admittedVisits[index], 1u);
    }
}

void VerifySurfelHash_NeighborCellBoundaryPreservesTheNormalizedField(){
    const Float3U before = Float3U(1.2f - 1e-6f, 0.61f, 0.0f);
    const Float3U after = Float3U(1.2f + 1e-6f, 0.61f, 0.0f);
    ASSERT_EQ(nwbSurfelCellCoord(before, s_SurfelCellSize).x, 1);
    ASSERT_EQ(nwbSurfelCellCoord(after, s_SurfelCellSize).x, 2);
    EXPECT_GT(Abs(GatherBoundaryValue(before, false) - GatherBoundaryValue(after, false)), 0.1f);
    EXPECT_NEAR(GatherBoundaryValue(before, true), GatherBoundaryValue(after, true), 1e-5f);
}

void VerifySurfelHash_CollidingDistantCellsRetainUpperCoordinateBits(){
    const SurfelHashInt3 nearCell = SurfelHashInt3(1, -1, 0);
    const SurfelHashInt3 distantCell = SurfelHashInt3(1 + cast<i32>(s_SurfelHashCellCount), -1, 0);
    ASSERT_EQ(nwbSurfelHashCell(nearCell, s_SurfelHashCellCount), nwbSurfelHashCell(distantCell, s_SurfelHashCellCount));
    EXPECT_FALSE(nwbSurfelSameCell(distantCell, nearCell));
    EXPECT_FALSE(nwbSurfelSameCell(nearCell, distantCell));
}

