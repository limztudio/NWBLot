// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_MeshShadowTraceSwParentSuffix = ":shadow_trace_sw_parent";

enum<u8> MeshSwBvhBufferPairState{
    Unused = 0,
    Complete = 1,
    Incomplete = 2,
    kCount
}

MeshSwBvhBufferPairState ClassifyMeshSwBvhBufferPair(in b8 hasNodeBuffer, in b8 hasParentBuffer){
    if(!hasNodeBuffer && !hasParentBuffer)
        return MeshSwBvhBufferPairState::Unused;
    if(hasNodeBuffer && hasParentBuffer)
        return MeshSwBvhBufferPairState::Complete;
    return MeshSwBvhBufferPairState::Incomplete;
}

b8 HasReadyRuntimeMeshletBoundsState(
    in b8 runtimeMesh,
    in u64 runtimeGeometryContentRevision,
    in u32 meshletCount,
    in b8 hasMeshletDescBuffer,
    in b8 hasRuntimeMeshletBoundsBuffer,
    in b8 descriptorStorageReady,
    in b8 boundsStorageReady
){
    return runtimeMesh && runtimeGeometryContentRevision != 0u && meshletCount != 0u && hasMeshletDescBuffer && hasRuntimeMeshletBoundsBuffer && descriptorStorageReady && boundsStorageReady;
}

b8 ShouldFreeUnreferencedSwBvhHandle(in b8 heapInitialized, in b8 handleValid, in b8 matchesRef0, in b8 matchesRef1){
    return heapInitialized && handleValid && !matchesRef0 && !matchesRef1;
}

b8 ShouldFreeUnreferencedSwBvhHandle(in b8 heapInitialized, in b8 handleValid, in b8 matchesRef0, in b8 matchesRef1, in b8 matchesRef2, in b8 matchesRef3){
    return heapInitialized && handleValid && !matchesRef0 && !matchesRef1 && !matchesRef2 && !matchesRef3;
}

usize ReservedRetainedAccelerationBufferCapacity(in usize meshCount, in usize buffersPerMesh){
    return meshCount * buffersPerMesh;
}

b8 MatchesRenderableRuntimeMeshRevisions(
    in b8 runtimeMesh,
    in u64 meshVersion,
    in u64 descVersion,
    in u64 meshContentRevision,
    in u64 descContentRevision,
    in u32 meshPrimitiveIndexCount,
    in u32 descPrimitiveIndexCount
){
    return runtimeMesh && meshVersion == descVersion && meshContentRevision == descContentRevision && meshPrimitiveIndexCount == descPrimitiveIndexCount;
}


