#include <impl/ecs_render/avboit/avboit_frame_targets.adhd>
#include <impl/ecs_render/deferred/deferred_frame_targets.adhd>
#include <impl/ecs_render/refraction/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Name s_RefractionDepthTargetName = "engine/avboit/refraction_depth";
const Name s_RefractionResolveTargetName = "engine/avboit/refraction_resolve";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RefractionTargetBuilder : NoCopy{
    private mut GraphicsRuntime m_graphics;

    public RefractionTargetBuilder(mut GraphicsRuntime graphics){
        this.m_graphics = graphics;
    }

    public b8 createImages(
        mut DeferredFrameTargets createdTargets,
        mut AvboitFrameTargets avboitTargets,
        in Format accumColorFormat,
        in Format accumExtinctionFormat,
        in Color transparentBlack
    );
    public b8 createTileBuffers(in u64 tileCount, mut AvboitFrameTargets avboitTargets);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u64 ComputeRefractionTileListByteSize(in u64 tileCount){
    return tileCount * 4u;
}

void LogFailedRefractionTileBuffers(){
    error("RendererSystem: failed to create refraction tile scheduling buffers");
}


