#include <loader/project_entry.adhd>
#include <loader/runtime_constants.adhd>
#include <impl/ecs_scene/module.adhd>
#include "csg_shadow_probes_and_atlas.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const SmokeMeshRef s_CsgShadowPlaneMesh = "project/meshes/shadow_plane";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena]
class CsgShadowSmokeProjectImpl : IProjectEntryCallbacks{
    public CsgShadowSmokeProjectImpl(mut NotNullUniquePtr<World> world, mut ProjectRuntimeContext context){
        this.m_context = context;
        this.m_world = TakeSmokeWorld(world);
        this.m_timing = CsgCausticTimingProbe(context);
    }

    public ~CsgShadowSmokeProjectImpl(){
        this.destroyWorld();
    }

    public b8 onStartup()override{
        if(!this.m_mode.read(s_CsgCausticSmokeEnabled))
            return false;

        f32 cameraX = 0.0f;
        if(this.m_mode.arm == CsgShadowArm::CameraShift)
            cameraX = 0.3f;

        f32 angularRadius = 0.0f;
        if(this.m_mode.finiteLightSource && !this.m_mode.pointLight)
            angularRadius = 0.005f;
        f32 sourceRadius = 0.0f;
        if(this.m_mode.finiteLightSource && this.m_mode.pointLight)
            sourceRadius = 0.02f;
        b8 enableCaustics = false;
        if(s_CsgCausticSmokeEnabled){
            enableCaustics = !ReadSmokeEnvironmentFlag("NWB_CSG_CAUSTIC_DISABLED");
            StringView photonState = "disabled";
            if(enableCaustics)
                photonState = "enabled";
            [essential] info("CsgCausticSmokeProject: photons {}", photonState);
        }

        mut World world = SmokeWorldRef(this.m_world);
        const EntityID camera = CreateSmokeCamera(0.0f, -s_ShadowSmokeCameraDepth, 0.0f, world);
        [essential] assert(camera.valid(), "CsgShadowSmokeProject: camera creation failed");
        mut TransformComponent cameraTransform = world.entity(camera).getComponent<TransformComponent>();
        cameraTransform.position.x = cameraX;

        const EntityID receiver = CreateTintedStaticMeshEntity(
            s_CsgShadowPlaneMesh,
            s_CsgShadowOpaqueMaterial,
            NameTextAscii(s_ShadowSmokeMaterialInterface),
            VectorSet(1.0f, 1.0f, 1.0f, 1.0f),
            VectorZero(),
            VectorSet(4.0f, 1.0f, 3.0f, 0.0f),
            world
        );
        [essential] assert(receiver.valid(), "CsgShadowSmokeProject: camera/receiver creation failed");
        mut TransformComponent receiverTransform = world.entity(receiver).getComponent<TransformComponent>();
        receiverTransform.rotation = f32x4(QuaternionRotationRollPitchYawFromVector(VectorSingle(-s_HalfPi, 0.0f, 0.0f, 0.0f)));

        EntityID light = s_InvalidEntityId;
        if(this.m_mode.pointLight)
            light = CreatePointLightEntity(world, VectorSingle(0.0f, 0.0f, -12.0f, 0.0f), VectorSingle(1.0f, 1.0f, 1.0f, 1.0f), 1.0f, 30.0f);
        else
            light = CreateDirectionalLightEntity(world, 0.0f, 0.0f, 0.0f, VectorSingle(1.0f, 1.0f, 1.0f, 1.0f), 1.0f);
        [essential] assert(light.valid(), "CsgShadowSmokeProject: light creation failed");
        mut LightComponent lightComponent = world.entity(light).getComponent<LightComponent>();
        lightComponent.angularRadius = angularRadius;
        lightComponent.sourceRadius = sourceRadius;
        lightComponent.enableCaustics = enableCaustics;

        StringView sourceLabel = s_ShadowSmokeHard;
        if(this.m_mode.finiteLightSource)
            sourceLabel = s_ShadowSmokeFinite;
        [essential] info("CsgShadowSmokeProject: light_source={} angular_radius={:.3f} source_radius={:.3f}", sourceLabel, angularRadius, sourceRadius);
        if(!this.m_atlas.create(this.m_mode, s_CsgShadowOpaqueMaterial, world))
            return false;
        const b8 hardware = this.m_context.graphics.queryFeatureSupport(Feature::RayQuery) && this.m_context.graphics.queryFeatureSupport(Feature::RayTracingAccelStruct);

        StringView lightLabel = s_ShadowSmokeDirectional;
        if(this.m_mode.pointLight)
            lightLabel = s_ShadowSmokePoint;
        u32 hwVal = 0u;
        if(hardware)
            hwVal = 1u;
        [essential] info(
            "CsgShadowSmokeProject: atlas arm={} light={} hardware={} camera_x={} caster_z_max=-5 receiver_z=0"
            , cast<u32>(this.m_mode.arm)
            , lightLabel
            , hwVal
            , cast<f64>(cameraX)
        );

        if(!ConfigureSmokeFramebufferCapture(this.m_context, "CsgShadowSmokeProject", s_ShadowSmokeDefaultCaptureFrameCount, this.m_capture))
            return false;

        if(s_CsgCausticSmokeEnabled && !this.configureTiming())
            return false;
        return true;
    }

    public void onShutdown()override{
        if(s_CsgCausticSmokeEnabled && this.m_timingActive)
            this.m_timing.finish();
        this.destroyWorld();
        [essential] info("CsgShadowSmokeProject: shutdown");
    }

    public b8 onUpdate(in f32 delta)override{
        UpdateSmokeFramebufferCapture(this.m_capture);
        ++this.m_update;
        if(this.m_mode.arm == CsgShadowArm::Moved && this.m_update == s_ShadowSmokeMoveUpdate){
            this.m_atlas.moveCutters(SmokeWorldRef(this.m_world));
            [essential] info("CsgShadowSmokeProject: cutters moved at update40");
        }
        const f32 tickDelta = RendererBaselineDelta(delta);
        if(!TickSmokeWorld(tickDelta, SmokeWorldRef(this.m_world)))
            return false;
        if(s_CsgCausticSmokeEnabled && this.m_timingActive && !this.m_timing.update())
            return false;
        return true;
    }

    private b8 configureTiming(){
        const Expected<String> mode = ReadSmokeEnvironmentString("NWB_CSG_CAUSTIC_TIMING_MODE");
        const Expected<String> output = ReadSmokeEnvironmentString("NWB_CSG_CAUSTIC_TIMING_FILE");
        const Expected<String> cpuOutput = ReadSmokeEnvironmentString("NWB_CSG_CAUSTIC_CPU_GPU_FILE");
        const Expected<String> start = ReadSmokeEnvironmentString("NWB_CSG_CAUSTIC_TIMING_START_FILE");
        if(!mode.has_value()){
            if(output.has_value() || cpuOutput.has_value() || start.has_value()){
                error("CsgCausticTiming: mode and explicit output must agree");
                return false;
            }
            return true;
        }
        const StringView modeView = StringView(mode.value());
        const Expected<String> route = ReadSmokeEnvironmentString("NWB_CSG_CAUSTIC_TIMING_ROUTE");
        StringView routeView = "";
        if(route.has_value())
            routeView = StringView(route.value());

        const b8 rayTracing = this.m_context.graphics.queryFeatureSupport(Feature::RayTracingAccelStruct);
        const b8 rayQuery = this.m_context.graphics.queryFeatureSupport(Feature::RayQuery);
        const b8 hasCapture = this.m_capture.valid();
        mut World world = SmokeWorldRef(this.m_world);
        const usize receivers = world.view<StaticCsgMeshComponent>().candidateCount() + world.view<SkinnedCsgMeshComponent>().candidateCount();
        const usize cutters = world.view<CsgCutterComponent>().candidateCount();
        const b8 hasCaptureOrMissingQuit = hasCapture || !SmokeContextHasQuitCallback(this.m_context);

        if(
            (modeView != "performance" && modeView != "diagnostic")
            || (routeView != "hardware" && routeView != "software")
            || !output.has_value()
            || !start.has_value()
            || hasCaptureOrMissingQuit
            || (this.m_mode.arm != CsgShadowArm::Reference && this.m_mode.arm != CsgShadowArm::Cut)
            || this.m_mode.pointLight
            || this.m_mode.finiteLightSource
            || this.m_mode.analyticAtlas
            || this.m_mode.openAtlas
            || ReadSmokeEnvironmentFlag("NWB_CSG_CAUSTIC_DISABLED")
        ){
            error("CsgCausticTiming: requires uncaptured directional hard-light reference/cut boxes and an explicit route");
            return false;
        }

        const b8 hardware = rayTracing && rayQuery;
        if(routeView == "hardware" && !hardware){
            u32 rtVal = 0u;
            if(rayTracing)
                rtVal = 1u;
            u32 rqVal = 0u;
            if(rayQuery)
                rqVal = 1u;
            [essential] info("CsgCausticTiming: hardware unavailable rt_accel={} ray_query={}", rtVal, rqVal);
            this.m_context.requestQuit();
            return true;
        }
        if((routeView == "hardware") != hardware){
            error("CsgCausticTiming: actual route differs from requested acquisition");
            return false;
        }

        usize expectedReceivers = 0u;
        if(this.m_mode.arm == CsgShadowArm::Cut)
            expectedReceivers = 1u;
        if(receivers != expectedReceivers || cutters != receivers){
            error("CsgCausticTiming: fixture receiver/cutter identity differs from selected arm");
            return false;
        }

        StringView armLabel = "reference";
        if(this.m_mode.arm == CsgShadowArm::Cut)
            armLabel = "cut";
        u32 expectedShaderCsg = 0u;
        if(receivers != 0u)
            expectedShaderCsg = 1u;
        [essential] info(
            "CsgCausticTiming: scene arm={} receivers={} cutters={} expected_shader_csg={} camera=960x720 light=directional capture=0"
            , armLabel
            , receivers
            , cutters
            , expectedShaderCsg
        );

        const StringView outputView = StringView(output.value());
        StringView cpuOutputView = "";
        if(cpuOutput.has_value())
            cpuOutputView = StringView(cpuOutput.value());
        const StringView startView = StringView(start.value());
        const b8 diagnostic = modeView == "diagnostic";
        const b8 hasCsg = receivers != 0u;

        if(!this.m_timing.initialize(diagnostic, hasCsg, hardware, outputView, cpuOutputView, startView))
            return false;
        this.m_timing.registerPass();
        this.m_timingActive = true;
        return true;
    }

    private void destroyWorld(){
        this.m_timing.unregisterPass();
        this.m_timingActive = false;
        DestroyCapturedSmokeRenderWorld(this.m_context, this.m_world, this.m_capture);
    }

    private mut ProjectRuntimeContext m_context;
    private NotNullUniquePtr<World> m_world;
    private CsgShadowMode m_mode = CsgShadowMode();
    private CsgShadowAtlas m_atlas = CsgShadowAtlas();
    private UniquePtr<FramebufferCapture> m_capture = UniquePtr<FramebufferCapture>();
    private CsgCausticTimingProbe m_timing;
    private u32 m_update = 0u;
    private b8 m_timingActive = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StringView CsgShadowProjectName(){
    return "CsgShadowSmokeProject";
}

[cpp_unwind]
Expected<NotNullUniquePtr<World>> CreateCsgShadowWorld(mut ProjectRuntimeContext context){
    auto created = CreateSmokeWorld(CsgShadowProjectName(), context);
    if(!created.has_value())
        return MakeUnexpected(Failure());
    mut NotNullUniquePtr<World> world = created.value();
    mut RendererSystem renderer = AddSmokeRenderSystems(SmokeWorldRef(world), context);
    ReflectionSettings reflection = ReflectionSettings();
    reflection.traceMode = ReflectionTraceMode::Disabled;
    [essential] assert(renderer.setReflectionSettings(reflection), "Invalid CSG shadow reflection settings");
    renderer.setRefractionEnabled(false);
    PresentationSettings presentation = PresentationSettings();
    presentation.toneMap = PresentationToneMap::LinearClamp;
    [essential] assert(renderer.setPresentationSettings(presentation), "Invalid CSG shadow presentation settings");
    return TakeSmokeWorld(world);
}

ProjectFrameClientSize GetProjectFrameClientSize(){
    return ProjectFrameClientSize(960, 720);
}

PlatformStringView GetProjectWindowTitle(){
    return PlatformTextLiteral("NWB CSG Shadow Smoke");
}

[cpp_unwind]
UniquePtr<IProjectEntryCallbacks> CreateProjectCallbacks(mut ProjectRuntimeContext context){
    auto world = CreateCsgShadowWorld(context);
    if(!world.has_value())
        return UniquePtr<IProjectEntryCallbacks>();
    mut NotNullUniquePtr<World> owner = world.value();
    return MakeUnique<CsgShadowSmokeProjectImpl>(owner, context);
}


