[cpp_header("<impl/assets/graphics/mesh/binding_slots.h>"), cpp_name("NWB_MESH_BINDING_POSITION")]
extern const u32 s_ShaderMeshBindingPosition;

[cpp_header("<impl/assets/graphics/mesh/binding_slots.h>"), cpp_name("NWB_MESH_BINDING_NORMAL")]
extern const u32 s_ShaderMeshBindingNormal;

[cpp_header("<impl/assets/graphics/mesh/binding_slots.h>"), cpp_name("NWB_MESH_BINDING_TANGENT")]
extern const u32 s_ShaderMeshBindingTangent;

[cpp_header("<impl/assets/graphics/mesh/binding_slots.h>"), cpp_name("NWB_MESH_BINDING_UV0")]
extern const u32 s_ShaderMeshBindingUv0;

[cpp_header("<impl/assets/graphics/mesh/binding_slots.h>"), cpp_name("NWB_MESH_BINDING_COLOR")]
extern const u32 s_ShaderMeshBindingColor;

[cpp_header("<impl/assets/graphics/mesh/binding_slots.h>"), cpp_name("NWB_MESH_BINDING_MESHLET_DESC")]
extern const u32 s_ShaderMeshBindingMeshletDesc;

[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_INSTANCE_CSG_CONTEXT_HEAP_SLOT")]
extern const u32 s_ShaderMeshInstanceCsgContextHeapSlot;

[cpp_header("<impl/assets/graphics/mesh/binding_slots.h>"), cpp_name("NWB_MESH_BINDING_MESHLET_BOUNDS")]
extern const u32 s_ShaderMeshBindingMeshletBounds;

[cpp_header("<impl/assets/graphics/mesh/binding_slots.h>"), cpp_name("NWB_MESH_BINDING_MESHLET_POSITION_REFS")]
extern const u32 s_ShaderMeshBindingMeshletPositionRefs;

[cpp_header("<impl/assets/graphics/mesh/binding_slots.h>"), cpp_name("NWB_MESH_BINDING_MESHLET_ATTRIBUTE_REFS")]
extern const u32 s_ShaderMeshBindingMeshletAttributeRefs;

[cpp_header("<impl/assets/graphics/mesh/binding_slots.h>"), cpp_name("NWB_MESH_BINDING_MESHLET_LOCAL_VERTEX_REFS")]
extern const u32 s_ShaderMeshBindingMeshletLocalVertexRefs;

[cpp_header("<impl/assets/graphics/mesh/binding_slots.h>"), cpp_name("NWB_MESH_BINDING_MESHLET_PRIMITIVE_INDICES")]
extern const u32 s_ShaderMeshBindingMeshletPrimitiveIndices;

[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_INSTANCE_GEOMETRY_SLOT_COUNT")]
extern const u32 s_ShaderMeshInstanceGeometrySlotCount;

[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_INSTANCE_ROTATION_FLOAT_OFFSET")]
extern const u32 s_ShaderMeshInstanceRotationFloatOffset;

[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_INSTANCE_TRANSLATION_FLOAT_OFFSET")]
extern const u32 s_ShaderMeshInstanceTranslationFloatOffset;

[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_INSTANCE_MATERIAL_MUTABLE_BYTE_OFFSET_FLOAT_OFFSET")]
extern const u32 s_ShaderMeshInstanceMaterialMutableByteOffsetFloatOffset;

[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_INSTANCE_SCALE_FLOAT_OFFSET")]
extern const u32 s_ShaderMeshInstanceScaleFloatOffset;

[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_INSTANCE_ENTITY_ID_WORD_OFFSET")]
extern const u32 s_ShaderMeshInstanceEntityIdWordOffset;

[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_INSTANCE_GEOMETRY_SLOT_FLOAT_OFFSET")]
extern const u32 s_ShaderMeshInstanceGeometrySlotFloatOffset;

[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_INSTANCE_FLOAT_COUNT")]
extern const u32 s_ShaderMeshInstanceFloatCount;

static_assert(s_MeshBindingPosition == s_ShaderMeshBindingPosition);
static_assert(s_MeshBindingNormal == s_ShaderMeshBindingNormal);
static_assert(s_MeshBindingTangent == s_ShaderMeshBindingTangent);
static_assert(s_MeshBindingUv0 == s_ShaderMeshBindingUv0);
static_assert(s_MeshBindingColor == s_ShaderMeshBindingColor);
static_assert(s_MeshBindingMeshletDesc == s_ShaderMeshBindingMeshletDesc);
static_assert(s_MeshInstanceCsgContextHeapSlot == s_ShaderMeshInstanceCsgContextHeapSlot);
static_assert(s_MeshBindingMeshletBounds == s_ShaderMeshBindingMeshletBounds);
static_assert(s_MeshBindingMeshletPositionRefs == s_ShaderMeshBindingMeshletPositionRefs);
static_assert(s_MeshBindingMeshletAttributeRefs == s_ShaderMeshBindingMeshletAttributeRefs);
static_assert(s_MeshBindingMeshletLocalVertexRefs == s_ShaderMeshBindingMeshletLocalVertexRefs);
static_assert(s_MeshBindingMeshletPrimitiveIndices == s_ShaderMeshBindingMeshletPrimitiveIndices);
static_assert(s_MeshInstanceGeometrySlotCount == s_ShaderMeshInstanceGeometrySlotCount, "s_MeshInstanceGeometrySlotCount must match NWB_MESH_INSTANCE_GEOMETRY_SLOT_COUNT");
static_assert(offset_of<InstanceGpuData>(rotation) == size_of<f32>() * s_ShaderMeshInstanceRotationFloatOffset, "InstanceGpuData rotation must be first");
static_assert(offset_of<InstanceGpuData>(translation) == size_of<f32>() * s_ShaderMeshInstanceTranslationFloatOffset, "InstanceGpuData translation must follow rotation");
static_assert(offset_of<InstanceGpuData>(translation) + offset_of<f32x3_u32>(w) == size_of<f32>() * s_ShaderMeshInstanceMaterialMutableByteOffsetFloatOffset, "InstanceGpuData mutable offset must pack into translation.w");
static_assert(offset_of<InstanceGpuData>(scale) == size_of<f32>() * s_ShaderMeshInstanceScaleFloatOffset, "InstanceGpuData scale must follow translation payload");
static_assert(offset_of<InstanceGpuData>(scale) + offset_of<f32x3_u32>(w) == size_of<u32>() * s_ShaderMeshInstanceEntityIdWordOffset, "InstanceGpuData full entity identity must follow scale.xyz");
static_assert(offset_of<InstanceGpuData>(geometryHeapSlots) == size_of<f32>() * s_ShaderMeshInstanceGeometrySlotFloatOffset, "InstanceGpuData geometry heap slots must follow the transform payload");
static_assert(size_of<InstanceGpuData>() == size_of<f32>() * s_ShaderMeshInstanceFloatCount, "InstanceGpuData stride must match the mesh shaders");
static_assert(size_of<InstanceGpuData>() == s_InstanceGpuDataByteSize, "InstanceGpuData byte size must match its payload");
static_assert(align_of<InstanceGpuData>() >= align_of<f32x4>(), "InstanceGpuData must stay SIMD-aligned");

void ForEachMeshSourceBindingSlot<BindingHandler>(mut forward BindingHandler handler)noexcept_like(handler(cast<i32>(s_MeshBindingPosition), false)){
    handler(cast<i32>(s_MeshBindingPosition), false);
    handler(cast<i32>(s_MeshBindingNormal), false);
    handler(cast<i32>(s_MeshBindingTangent), false);
    handler(cast<i32>(s_MeshBindingUv0), false);
    handler(cast<i32>(s_MeshBindingColor), false);
    handler(cast<i32>(s_MeshBindingMeshletDesc), false);
    handler(cast<i32>(s_MeshBindingMeshletBounds), true);
    handler(cast<i32>(s_MeshBindingMeshletPositionRefs), true);
    handler(cast<i32>(s_MeshBindingMeshletAttributeRefs), true);
    handler(cast<i32>(s_MeshBindingMeshletLocalVertexRefs), false);
    handler(cast<i32>(s_MeshBindingMeshletPrimitiveIndices), true);
}

type InstanceGpuDataVector = Vector<InstanceGpuData>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[move_only]
class MeshResources{
    public RuntimeMeshBuffers buffers;
    public CsgReceiverCpuBounds csgLocalBounds;
    public Name meshName = s_NameNone;
    public BufferHandle emulationVertexBuffer;
    public ObjectGeometryCacheState objectGeometryCache;
    public BufferHandle triangleIndexBuffer;
    public Vector<u32> solidTriangleWords;
    public BufferHandle runtimeLocalBoundsBuffer;
    public BufferHandle runtimeMeshletLocalBoundsBuffer;
    public BufferHandle attributeBuffer;
    public RayTracingAccelStructHandle blas;
    public GpuDescriptorHandle runtimeMeshletLocalBoundsHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle runtimeLocalBoundsHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle emulationVertexHeapHandle = GpuDescriptorHandleInvalid();
    public Array<GpuDescriptorHandle, s_MeshInstanceGeometrySlotCount> geometryHeapHandles;
    public GpuDescriptorHandle swBvhPositionHeapHandle;
    public GpuDescriptorHandle swBvhTriangleIndexHeapHandle;
    public b8 swBvhBuildAccepted = false;
    public BufferHandle swBvhNodeBuffer;
    public BufferHandle swBvhParentBuffer;
    public GpuDescriptorHandle swBvhNodeHeapHandle;
    public GpuDescriptorHandle swBvhParentHeapHandle;
    public u32 emulationIndexByteOffset = 0u;
    public u32 meshletCount = 0;
    public u32 meshletPrimitiveIndexCount = 0;
    public u32 blasRefitsSinceRebuild = 0u;
    public u32 swBvhRefitsSinceRebuild = 0u;
    public u64 runtimeMeshVersion = 0u;
    public u64 runtimeGeometryContentRevision = 0u;
    public u64 blasGeometryContentRevision = 0u;
    public u64 swBvhGeometryContentRevision = 0u;
    public b8 runtimeMesh = false;
    public b8 dynamicMeshletBoundsFresh = false;
    public b8 dynamicMeshletConesFresh = false;
    public b8 blasBuildPending = false;
    public b8 blasBackingFresh = false;
    public b8 swBvhBuildPending = false;
    public b8 swBvhTopologyBuilt = false;
    public b8 blasBuildAccepted = false;


    public b8 valid()const{
        return this.meshName != s_NameNone && this.buffers.buffersValid() && this.meshletCount > 0u && this.meshletPrimitiveIndexCount > 0u && !this.solidTriangleWords.empty();
    }
}

b8 AcceptObjectGeometryCacheWrite(mut MeshResources mesh, in RuntimeMeshBuffers sourceBuffers, in ObjectGeometryCacheSnapshot expected, in b8 runtimeMesh){
    mut ObjectGeometryCacheState cache = mesh.objectGeometryCache;
    if(!expected.valid() || cache.buffer != expected.buffer)
        return false;
    return MeshGeometryBufferPolicy().acceptObjectCacheContent(
        cache.decoderPipeline == expected.decoderPipeline,
        cache.heapHandle == expected.heapHandle,
        cache.indexByteOffset,
        expected.indexByteOffset,
        cache.indexCount,
        expected.indexCount,
        mesh.runtimeMesh,
        runtimeMesh,
        mesh.runtimeGeometryContentRevision,
        expected.sourceRevision,
        mesh.buffers.sameBuffers(sourceBuffers),
        cache.initialized,
        cache.acceptedContent,
        cache.acceptedContentRevision
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsStorageBufferGeometryHeapHandle(in GpuDescriptorHandle handle){
    return handle.valid() && handle.descriptorClass() == GpuDescriptorClass::StorageBuffer;
}

b8 GeometryHeapHandlesReady(in Array<GpuDescriptorHandle, s_MeshInstanceGeometrySlotCount> geometryHeapHandles){
    return IsStorageBufferGeometryHeapHandle(geometryHeapHandles[s_MeshBindingPosition])
        && IsStorageBufferGeometryHeapHandle(geometryHeapHandles[s_MeshBindingNormal])
        && IsStorageBufferGeometryHeapHandle(geometryHeapHandles[s_MeshBindingTangent])
        && IsStorageBufferGeometryHeapHandle(geometryHeapHandles[s_MeshBindingUv0])
        && IsStorageBufferGeometryHeapHandle(geometryHeapHandles[s_MeshBindingColor])
        && IsStorageBufferGeometryHeapHandle(geometryHeapHandles[s_MeshBindingMeshletDesc])
        && IsStorageBufferGeometryHeapHandle(geometryHeapHandles[s_MeshBindingMeshletBounds])
        && IsStorageBufferGeometryHeapHandle(geometryHeapHandles[s_MeshBindingMeshletPositionRefs])
        && IsStorageBufferGeometryHeapHandle(geometryHeapHandles[s_MeshBindingMeshletAttributeRefs])
        && IsStorageBufferGeometryHeapHandle(geometryHeapHandles[s_MeshBindingMeshletLocalVertexRefs])
        && IsStorageBufferGeometryHeapHandle(geometryHeapHandles[s_MeshBindingMeshletPrimitiveIndices])
    ;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MeshSoftwareBvhParentBuildState{
    public BufferHandle buffer;
    public Name identity;

    public MeshSoftwareBvhParentBuildState(){
        this.identity = s_NameNone;
    }

    public MeshSoftwareBvhParentBuildState(in BufferHandle inBuffer, in Name inIdentity){
        this.buffer = inBuffer;
        this.identity = inIdentity;
    }
}

class MeshBlasGraphState{
    public RayTracingAccelStructHandle blas;
    public Name meshName;
    public b8 backingFresh;
    public b8 nativeBuildsBlas;

    public MeshBlasGraphState(){
        this.meshName = s_NameNone;
        this.backingFresh = false;
        this.nativeBuildsBlas = false;
    }

    public MeshBlasGraphState(in Name inMeshName, in RayTracingAccelStructHandle inBlas, in b8 inBackingFresh, in b8 inNativeBuildsBlas){
        this.meshName = inMeshName;
        this.blas = inBlas;
        this.backingFresh = inBackingFresh;
        this.nativeBuildsBlas = inNativeBuildsBlas;
    }
}

class MeshRayTracingResourceSnapshot{
    public Span<u32> solidTriangleWords;
    public CsgReceiverCpuBounds csgLocalBounds;
    public RayTracingAccelStructHandle blas;
    public BufferHandle positionBuffer;
    public BufferHandle triangleIndexBuffer;
    public BufferHandle attributeBuffer;
    public BufferHandle runtimeLocalBoundsBuffer;
    public BufferHandle meshletDescBuffer;
    public BufferHandle meshletLocalBoundsBuffer;
    public BufferHandle swBvhNodeBuffer;
    public BufferHandle swBvhParentBuffer;
    public u64 runtimeMeshVersion = 0u;
    public u64 runtimeGeometryContentRevision = 0u;
    public u64 blasGeometryContentRevision = 0u;
    public u64 swBvhGeometryContentRevision = 0u;
    public Name meshName = s_NameNone;
    public GpuDescriptorHandle runtimeLocalBoundsHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle meshletDescHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle meshletLocalBoundsHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle swBvhPositionHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle swBvhTriangleIndexHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle swBvhNodeHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle swBvhParentHeapHandle = GpuDescriptorHandleInvalid();
    public u32 meshletCount = 0u;
    public u32 meshletPrimitiveIndexCount = 0u;
    public u32 blasRefitsSinceRebuild = 0u;
    public u32 swBvhRefitsSinceRebuild = 0u;
    public b8 runtimeMesh = false;
    public b8 blasBuildPending = false;
    public b8 blasBackingFresh = false;
    public b8 swBvhBuildPending = false;
    public b8 swBvhTopologyBuilt = false;
    public b8 blasBuildAccepted = false;
    public b8 swBvhBuildAccepted = false;

    public MeshRayTracingResourceSnapshot(){}
}


b8 MatchesMeshRayTracingSnapshotIdentity(in MeshRayTracingResourceSnapshot lhs, in MeshRayTracingResourceSnapshot rhs){
    return
        lhs.meshName == rhs.meshName
        && lhs.positionBuffer == rhs.positionBuffer
        && lhs.triangleIndexBuffer == rhs.triangleIndexBuffer
        && lhs.attributeBuffer == rhs.attributeBuffer
        && lhs.solidTriangleWords.data() == rhs.solidTriangleWords.data()
        && lhs.solidTriangleWords.size() == rhs.solidTriangleWords.size()
        && lhs.runtimeLocalBoundsBuffer == rhs.runtimeLocalBoundsBuffer
        && lhs.runtimeLocalBoundsHeapHandle == rhs.runtimeLocalBoundsHeapHandle
        && lhs.meshletCount == rhs.meshletCount
        && lhs.meshletDescBuffer == rhs.meshletDescBuffer
        && lhs.meshletLocalBoundsBuffer == rhs.meshletLocalBoundsBuffer
        && lhs.meshletDescHeapHandle == rhs.meshletDescHeapHandle
        && lhs.meshletLocalBoundsHeapHandle == rhs.meshletLocalBoundsHeapHandle
        && lhs.swBvhPositionHeapHandle == rhs.swBvhPositionHeapHandle
        && lhs.swBvhTriangleIndexHeapHandle == rhs.swBvhTriangleIndexHeapHandle
        && lhs.meshletPrimitiveIndexCount == rhs.meshletPrimitiveIndexCount
        && lhs.runtimeMesh == rhs.runtimeMesh
        && lhs.runtimeMeshVersion == rhs.runtimeMeshVersion
        && lhs.runtimeGeometryContentRevision == rhs.runtimeGeometryContentRevision
        && lhs.csgLocalBounds.minBounds == rhs.csgLocalBounds.minBounds
        && lhs.csgLocalBounds.maxBounds == rhs.csgLocalBounds.maxBounds
    ;
}

void AppendLightSpaceSceneBuffers(in MeshRayTracingResourceSnapshot meshResources, in b8 includeCsgBuffers, mut Vector<BufferHandle> outBuffers){
    outBuffers.push_back(meshResources.positionBuffer);
    outBuffers.push_back(meshResources.triangleIndexBuffer);
    outBuffers.push_back(meshResources.attributeBuffer);
    if(meshResources.meshletCount != 0u){
        outBuffers.push_back(meshResources.meshletDescBuffer);
        outBuffers.push_back(meshResources.meshletLocalBoundsBuffer);
    }
    if(includeCsgBuffers){
        if(meshResources.runtimeLocalBoundsBuffer.valid())
            outBuffers.push_back(meshResources.runtimeLocalBoundsBuffer);
        if(meshResources.swBvhNodeBuffer.valid())
            outBuffers.push_back(meshResources.swBvhNodeBuffer);
    }
}

ObjectGeometryCacheSnapshot CaptureObjectGeometryCache(in MeshResources mesh){
    in ObjectGeometryCacheState cache = mesh.objectGeometryCache;
    ObjectGeometryCacheSnapshot snapshot;
    snapshot.buffer = cache.buffer;
    snapshot.decoderPipeline = cache.decoderPipeline;
    snapshot.sourceRevision = mesh.runtimeGeometryContentRevision;
    snapshot.heapHandle = cache.heapHandle;
    snapshot.indexByteOffset = cache.indexByteOffset;
    snapshot.indexCount = cache.indexCount;
    snapshot.initialized = cache.initialized;
    snapshot.requiresDecode = MeshGeometryBufferPolicy().requiresObjectCacheDecode(cache.acceptedContent, mesh.runtimeMesh, mesh.runtimeGeometryContentRevision, cache.acceptedContentRevision);
    return snapshot;
}

in BufferHandle MeshSourceBuffer(in MeshResources mesh, in u32 bindingSlot){
    switch(bindingSlot){
    case s_MeshBindingPosition: return mesh.buffers.positionBuffer;
    case s_MeshBindingNormal: return mesh.buffers.normalBuffer;
    case s_MeshBindingTangent: return mesh.buffers.tangentBuffer;
    case s_MeshBindingUv0: return mesh.buffers.uv0Buffer;
    case s_MeshBindingColor: return mesh.buffers.colorBuffer;
    case s_MeshBindingMeshletDesc: return mesh.buffers.meshletDescBuffer;
    case s_MeshBindingMeshletBounds: return mesh.buffers.meshletBoundsBuffer;
    case s_MeshBindingMeshletPositionRefs: return mesh.buffers.meshletPositionRefDeltaBuffer;
    case s_MeshBindingMeshletAttributeRefs: return mesh.buffers.meshletAttributeRefDeltaBuffer;
    case s_MeshBindingMeshletLocalVertexRefs: return mesh.buffers.meshletLocalVertexRefBuffer;
    case s_MeshBindingMeshletPrimitiveIndices: return mesh.buffers.meshletPrimitiveIndexBuffer;
    default:
        assert(false);
        return mesh.buffers.positionBuffer;
    }
}


