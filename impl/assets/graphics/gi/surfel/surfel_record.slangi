#ifndef NWB_GRAPHICS_GI_SURFEL_RECORD_SLANGI
#define NWB_GRAPHICS_GI_SURFEL_RECORD_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Single-writer visible-surface surfel with 2-band RGB SH; must match the 96-byte C++ stride.
struct NwbSurfel{
    float3 position;
    float radius;
    float3 normal;
    uint nextInCell;
    float4 shR;
    float4 shG;
    float4 shB;
    uint sampleCount;
    uint lastSeenFrame;
    uint alive;
    uint pad0;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


