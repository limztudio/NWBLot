#include "benchmark_support.adhd"
#include "pow_packed_single.adhd"
#include <tests/common/test_helpers.adhd>

[cpp_header("<cerrno>"), cpp_name("EDOM")]
extern const i32 s_PowEDOM;

[cpp_header("<cerrno>"), cpp_name("ERANGE")]
extern const i32 s_PowERANGE;

VectorSingle ReferencePow(in VectorSingle x, in VectorSingle y){
    return VectorSingle(Pow(x.x, y.x), Pow(x.y, y.y), Pow(x.z, y.z), Pow(x.w, y.w));
}

const Array<f64, 16> s_LogCoefficients = Array<f64, 16>(
    1.0, 1.0 / 3.0, 1.0 / 5.0, 1.0 / 7.0, 1.0 / 9.0, 1.0 / 11.0, 1.0 / 13.0, 1.0 / 15.0,
    1.0 / 17.0, 1.0 / 19.0, 1.0 / 21.0, 1.0 / 23.0, 1.0 / 25.0, 1.0 / 27.0, 1.0 / 29.0, 1.0 / 31.0
);

const Array<f64, 21> s_InverseFactorials = Array<f64, 21>(
    1.0,
    1.0,
    0.5,
    1.0 / 6.0,
    1.0 / 24.0,
    1.0 / 120.0,
    1.0 / 720.0,
    1.0 / 5040.0,
    1.0 / 40320.0,
    1.0 / 362880.0,
    1.0 / 3628800.0,
    1.0 / 39916800.0,
    1.0 / 479001600.0,
    1.0 / 6227020800.0,
    1.0 / 87178291200.0,
    1.0 / 1307674368000.0,
    1.0 / 20922789888000.0,
    1.0 / 355687428096000.0,
    1.0 / 6402373705728000.0,
    1.0 / 121645100408832000.0,
    1.0 / 2432902008176640000.0
);

VectorSingle PackedDoublePow(in VectorSingle x, in VectorSingle y){
    u32x4 safeBits(0u);
    u32x4 exponentBits(0u);
    u32x4 subnormalMask(0u);
    for(usize lane = 0u; lane < 4u; ++lane){
        const u32 magnitude = SimdGetSingleLaneBits(x, lane) & 0x7fffffffu;
        const u32 power = SimdGetSingleLaneBits(y, lane);
        const b8 ordinary = magnitude != 0u && magnitude < 0x7f800000u && (power & 0x7fffffffu) < 0x7f800000u;
        safeBits[lane] = 0x3f800000u;
        if(ordinary){
            safeBits[lane] = magnitude;
            exponentBits[lane] = power;
        }
        if(safeBits[lane] < 0x00800000u)
            subnormalMask[lane] = u32.max;
    }
    const VectorSingle safeX = VectorSingle(safeBits);
    const VectorSingle subnormal = VectorSingle(subnormalMask);
    const VectorSingle normalized = VectorSelect(safeX, VectorScale(VectorSelect(VectorSingle(1.0f), safeX, subnormal), 0x1p24f), subnormal);
    f64x4 exponents(0.0);
    u32x4 mantissaBits(0u);
    for(usize lane = 0u; lane < 4u; ++lane){
        const u32 bits = SimdGetSingleLaneBits(normalized, lane);
        i32 exponent = cast<i32>(bits >> 23u) - 127;
        if(subnormalMask[lane] != 0u)
            exponent -= 24;
        exponents[lane] = cast<f64>(exponent);
        mantissaBits[lane] = (bits & 0x007fffffu) | 0x3f800000u;
    }
    VectorDouble m = ConvertVectorSingleToDouble(VectorSingle(mantissaBits));
    VectorDouble e = VectorDouble(exponents);
    const VectorDouble upper = VectorDoubleGreater(m, VectorDoubleReplicate(0x1.6a09e667f3bcdp0));
    m = VectorDoubleSelect(m, VectorDoubleScale(m, 0.5), upper);
    e = VectorDoubleAdd(e, VectorDoubleSelect(VectorDoubleZero(), VectorDouble(1.0), upper));
    const VectorDouble z = VectorDoubleDivide(VectorDoubleSubtract(m, VectorDouble(1.0)), VectorDoubleAdd(m, VectorDouble(1.0)));
    const VectorDouble zSquared = VectorDoubleMultiply(z, z);
    VectorDouble logarithm = VectorDoubleReplicate(s_LogCoefficients[15]);
    for(i32 degree = 14; degree >= 0; --degree)
        logarithm = VectorDoubleMultiplyAdd(logarithm, zSquared, VectorDoubleReplicate(s_LogCoefficients[degree]));
    logarithm = VectorDoubleMultiply(VectorDoubleScale(z, 2.0), logarithm);
    const VectorDouble log2 = VectorDoubleAdd(e, VectorDoubleScale(logarithm, 0x1.71547652b82fep0));
    const VectorDouble safeY = ConvertVectorSingleToDouble(VectorSingle(exponentBits));
    const VectorDouble power = VectorDoubleMultiply(log2, safeY);
    const VectorDouble bounded = VectorDoubleMin(VectorDoubleReplicate(129.0), VectorDoubleMax(VectorDoubleReplicate(-151.0), power));
    const VectorDouble integral = VectorDoubleFloor(bounded);
    const VectorDouble remainder = VectorDoubleScale(VectorDoubleSubtract(bounded, integral), 0x1.62e42fefa39efp-1);
    // The series use binary64 lanes so the final binary32 rounding has guard bits.
    VectorDouble exponential = VectorDoubleReplicate(s_InverseFactorials[20]);
    for(i32 degree = 19; degree >= 0; --degree)
        exponential = VectorDoubleMultiplyAdd(exponential, remainder, VectorDoubleReplicate(s_InverseFactorials[degree]));
    u64x4 scaleBits(0u);
    for(usize lane = 0u; lane < 4u; ++lane){
        const i64 exponent = cast<i64>(VectorDoubleGetByIndex(integral, lane));
        scaleBits[lane] = cast<u64>(exponent + 1023) << 52u;
    }
    const VectorSingle positive = ConvertVectorDoubleToSingle(VectorDoubleMultiply(exponential, VectorDouble(scaleBits)));
    u32x4 signs(0u);
    u32x4 specialValues(0u);
    u32x4 specialLanes(0u);
    u32x4 nanLanes(0u);
    u32x4 oneLanes(0u);
    u32x4 nanXBits(0u);
    u32x4 nanYBits(0u);
    b8 domainError = false;
    b8 poleError = false;
    for(usize lane = 0u; lane < 4u; ++lane){
        const u32 xBits = SimdGetSingleLaneBits(x, lane);
        const u32 yBits = SimdGetSingleLaneBits(y, lane);
        const u32 magnitude = xBits & 0x7fffffffu;
        const u32 yMagnitude = yBits & 0x7fffffffu;
        const u32 yExponent = yMagnitude >> 23u;
        u32 shift = 0u;
        if(yExponent < 127u)
            shift = 23u;
        else if(yExponent <= 150u)
            shift = 150u - yExponent;
        const u32 significand = (yMagnitude & 0x007fffffu) | 0x00800000u;
        const b8 integerY = yMagnitude == 0u || yExponent >= 151u || (yExponent >= 127u && (significand & ((1u << shift) - 1u)) == 0u);
        u32 sign = 0u;
        if(integerY && yExponent <= 150u && ((significand >> shift) & 1u) != 0u)
            sign = xBits & 0x80000000u;
        const b8 yNegative = (yBits & 0x80000000u) != 0u;
        signs[lane] = sign;
        if(magnitude == 0u || magnitude == 0x7f800000u){
            specialLanes[lane] = u32.max;
            specialValues[lane] = sign;
            if((magnitude == 0u) == yNegative)
                specialValues[lane] |= 0x7f800000u;
        }
        if((xBits & 0x80000000u) != 0u && magnitude != 0u && magnitude < 0x7f800000u && !integerY){
            domainError = true;
            specialLanes[lane] = u32.max;
            specialValues[lane] = 0x7fc00000u;
        }
        if(yMagnitude == 0x7f800000u){
            specialLanes[lane] = u32.max;
            specialValues[lane] = 0u;
            if(magnitude == 0x3f800000u)
                specialValues[lane] = 0x3f800000u;
            else if((magnitude < 0x3f800000u) == yNegative)
                specialValues[lane] = 0x7f800000u;
        }
        if(magnitude > 0x7f800000u)
            nanXBits[lane] = xBits;
        if(yMagnitude > 0x7f800000u)
            nanYBits[lane] = yBits;
        if(magnitude > 0x7f800000u || yMagnitude > 0x7f800000u)
            nanLanes[lane] = u32.max;
        if(xBits == 0x3f800000u || yMagnitude == 0u)
            oneLanes[lane] = u32.max;
        if(magnitude == 0u && yNegative && yMagnitude <= 0x7f800000u)
            poleError = true;
    }

    const VectorSingle quiet = VectorAdd(VectorSingle(nanXBits), VectorSingle(nanYBits));
    VectorSingle result = VectorSelect(VectorOrInt(positive, VectorSingle(signs)), VectorSingle(specialValues), VectorSingle(specialLanes));
    result = VectorSelect(result, quiet, VectorSingle(nanLanes));
    result = VectorSelect(result, VectorSingle(1.0f), VectorSingle(oneLanes));
    if(domainError)
        WritePowerError(s_PowEDOM);
    else if(poleError || TestFloatingPointExceptions(FE_OVERFLOW | FE_UNDERFLOW) != 0)
        WritePowerError(s_PowERANGE);
    return result;
}

VectorSingle EvaluatePow(in u8 variant, in b8 reference, in VectorSingle x, in VectorSingle y){
    if(reference)
        return ReferencePow(x, y);
    if(variant == 0u)
        return VectorPow(x, y);
    if(variant == 1u)
        return PackedSinglePow(x, y);
    return PackedDoublePow(x, y);
}

b8 ObservePowKernel(in u8 variant, in b8 reference, in VectorSingle x, in VectorSingle y, mut Array<u32, 4> bits,
    mut i32 standardFlags, mut u32 mappedFlags, mut u64 nativeBits, mut i32 storedError){
    WriteRawStatus(0u);
    ClearMappedStatus();
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    WritePowerError(s_SeedPowerError);
    const VectorSingle value = EvaluatePow(variant, reference, x, y);
    storedError = ReadPowerError();
    standardFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    mappedFlags = ReadNativeStatus();
    nativeBits = ReadRawStatus();
    for(usize lane = 0u; lane < 4u; ++lane)
        bits[lane] = SimdGetSingleLaneBits(value, lane);
    return true;
}

[ordered]
class PowQualificationEnvironmentScope : NoCopy{
    private i32 m_error = 0;
    private u64 m_status = 0u;
    private u64 m_control = 0u;
    private Expected<FloatingPointEnvironment> m_environment = MakeUnexpected(Failure());
    private b8 m_restoreControl = false;

    public PowQualificationEnvironmentScope(){ this.capture(false); }
    public PowQualificationEnvironmentScope(in b8 restoreControl){ this.capture(restoreControl); }

    private void capture(in b8 restoreControl){
        this.m_restoreControl = restoreControl;
        this.m_error = ReadPowerError();
        if(restoreControl){
            this.m_status = ReadRawStatus();
            this.m_control = ReadRawControl();
        }
        this.m_environment = HoldFloatingPointExceptions();
        if(!restoreControl)
            this.m_status = ReadRawStatus();
    }

    public b8 available()const{ return this.m_environment.has_value(); }

    public ~PowQualificationEnvironmentScope(){
        if(!this.available())
            return;
        if(!SetFloatingPointEnvironment(this.m_environment.value()))
            TerminateInvariant();
        WriteRawStatus(this.m_status);
        if(this.m_restoreControl)
            WriteRawControl(this.m_control);
        WritePowerError(this.m_error);
    }
}

u32 ObservePowTrap(in u8 variant, in b8 reference, in VectorSingle x, in VectorSingle y){
    u32 initial = 0u;
    u32 control = 0u;
    if(!UpdateControl(initial, 0u, 0u))
        return 1u;
    ClearMappedStatus();
    if(!UpdateControl(control, initial & ~(s_InvalidMask | s_OverflowMask | s_ZeroDivideMask), s_ControlExceptionMask))
        return 2u;
    const u32 code = CatchHardwareException(lambda[in variant, in reference, in x, in y]() -> void{
        const VectorSingle value = EvaluatePow(variant, reference, x, y);
        ObserveValue<u32>(SimdGetSingleLaneBits(value, 0u));
    });
    const u32 flags = ClearMappedStatus();
    if(!UpdateControl(control, initial, s_ControlExceptionMask))
        return 3u;
    WriteBenchmarkStdout(StringFormat("trap exception=0x{:x} flags=0x{:x} mask=0x{:x}\n", code, flags, control & s_ControlExceptionMask));
    return code;
}

class PowTrapEdge{
    public u32 code = 0u;
    public u32 flags = 0u;
    public u32 control = 0u;
    public u32 valueBits = 0u;
    public i32 error = 0;
    public u64 nativeStatus = 0u;
    public u64 nativeControl = 0u;
    public b8 operator==(in PowTrapEdge rhs)const{
        return this.code == rhs.code && this.flags == rhs.flags && this.control == rhs.control && this.valueBits == rhs.valueBits &&
            this.error == rhs.error && this.nativeStatus == rhs.nativeStatus && this.nativeControl == rhs.nativeControl;
    }
}

Expected<PowTrapEdge> ObservePowTrapEdge(in u8 variant, in b8 reference, in VectorSingle x, in VectorSingle y, in u32 enabled){
    u32 initial = 0u;
    u32 control = 0u;
    if(!UpdateControl(initial, 0u, 0u) || !ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return MakeUnexpected(Failure());
    const u64 initialNativeControl = ReadRawControl();
    WriteRawStatus(0u);
    if(!UpdateControl(control, (initial | s_ControlExceptionMask) & ~enabled, s_ControlExceptionMask))
        return MakeUnexpected(Failure());
    WritePowerError(s_SeedPowerError);
    PowTrapEdge edge;
    u32 valueBits = 0u;
    edge.code = CatchHardwareException(lambda[in variant, in reference, in x, in y, mut valueBits]() -> void{
        const VectorSingle value = EvaluatePow(variant, reference, x, y);
        valueBits = ObserveValue<u32>(SimdGetSingleLaneBits(value, 0u));
    });
    edge.error = ReadPowerError();
    edge.valueBits = valueBits;
    edge.nativeStatus = ReadRawStatus();
    edge.nativeControl = ReadRawControl();
    if(!UpdateControl(edge.control, 0u, 0u))
        return MakeUnexpected(Failure());
    edge.flags = ClearMappedStatus();
    if(!UpdateControl(control, initial, s_ControlExceptionMask))
        return MakeUnexpected(Failure());
    WriteRawControl(initialNativeControl);
    return edge;
}

i32 VerifyPowTrapsKernel(in u8 variant){
    if(!s_HasWindowsTraps){
        WriteBenchmarkStdout("trap qualification unavailable on this platform\n");
        return 2;
    }
    const Array<f32x4, 5> bases(f32x4(-1.0f,1.0f,1.0f,1.0f), f32x4(0x1.fffffep127f,1.0f,1.0f,1.0f),
        f32x4(0.0f,1.0f,1.0f,1.0f), f32x4(0x1.fffffep127f,-1.0f,1.0f,1.0f), f32x4(-1.0f,0x1.fffffep127f,1.0f,1.0f));
    const Array<f32x4, 5> powers(f32x4(0.5f,1.0f,1.0f,1.0f), f32x4(2.0f,1.0f,1.0f,1.0f),
        f32x4(-1.0f,1.0f,1.0f,1.0f), f32x4(2.0f,0.5f,1.0f,1.0f), f32x4(0.5f,2.0f,1.0f,1.0f));
    const Array<u32, 3> categories(s_InvalidException, s_OverflowException, s_ZeroDivideException);
    u32 failures = 0u;
    b8 delivered = true;
    for(usize index = 0u; index < bases.size(); ++index){
        WriteBenchmarkStdout(StringFormat("trap case={} reference\n", index));
        const u32 expected = ObservePowTrap(variant, true, VectorSingle(bases[index]), VectorSingle(powers[index]));
        WriteBenchmarkStdout(StringFormat("trap case={} candidate\n", index));
        const u32 actual = ObservePowTrap(variant, false, VectorSingle(bases[index]), VectorSingle(powers[index]));
        if(index < categories.size())
            delivered = delivered && expected == categories[index];
        else
            delivered = delivered && (expected == s_InvalidException || expected == s_OverflowException);
        failures += cast<u32>(expected != actual);
    }
    WriteBenchmarkStdout(StringFormat("trap differences={} distinguishable={}\n", failures, cast<u32>(delivered)));
    if(!delivered)
        return 2;
    return cast<i32>(failures != 0u);
}

i32 VerifyPowTrapEdgesKernel(in u8 variant){
    if(!s_HasWindowsTraps)
        return 2;
    PowQualificationEnvironmentScope guard(true);
    if(!guard.available())
        return 2;
    const Array<u32, 2> denormalModes(s_DenormalSave, s_DenormalFlush);
    const Array<u32, 2> enabledMasks(s_UnderflowMask, s_UnderflowMask | s_InexactMask);
    const Array<f32x4, 3> bases(f32x4(0.5f,1.0f,1.0f,1.0f), f32x4(0.5f,1.0f,1.0f,1.0f), f32x4(VectorSingle(u32x4(1u,0x3f800000u,0x3f800000u,0x3f800000u))));
    const Array<f32x4, 3> powers(f32x4(149.0f,1.0f,1.0f,1.0f), f32x4(127.0f,1.0f,1.0f,1.0f), f32x4(0.0f,1.0f,1.0f,1.0f));
    u32 differences = 0u;
    u32 cases = 0u;
    b8 delivered = true;
    for(usize denormalIndex = 0u; denormalIndex < 1u + cast<usize>(s_HasPowerStatus); ++denormalIndex){
        const u32 denormal = denormalModes[denormalIndex];
        u32 control = 0u;
        if(!UpdateControl(control, denormal, s_ControlDenormalMask) || (control & s_ControlDenormalMask) != denormal)
            return 2;
        for(usize modeIndex = 0u; modeIndex < 4u; ++modeIndex){
            const i32 mode = SimdRoundingModeByIndex(modeIndex);
            if(!SetFloatingPointRoundingMode(mode))
                return 2;
            for(in u32 enabled : enabledMasks){
                for(usize index = 0u; index < bases.size(); ++index){
                    const auto base = VectorSingle(bases[index]);
                    const auto power = VectorSingle(powers[index]);
                    const auto expected = ObservePowTrapEdge(variant, true, base, power, enabled);
                    const auto actual = ObservePowTrapEdge(variant, false, base, power, enabled);
                    if(!expected || !actual)
                        return 2;
                    const PowTrapEdge lhs = expected.value();
                    const PowTrapEdge rhs = actual.value();
                    if(index < 2u && denormal == s_DenormalSave)
                        delivered = delivered && lhs.code == s_UnderflowException;
                    const b8 different = !(lhs == rhs);
                    differences += cast<u32>(different);
                    ++cases;
                    WriteBenchmarkStdout(StringFormat("trap_edge DN={} rounding={} enabled={} case={} expected={}/{}/{}/{}/{}/{}/{} actual={}/{}/{}/{}/{}/{}/{} differs={}\n",
                        denormal, mode, enabled, index, lhs.code, lhs.flags, lhs.control, lhs.error, lhs.nativeStatus, lhs.nativeControl, lhs.valueBits,
                        rhs.code, rhs.flags, rhs.control, rhs.error, rhs.nativeStatus, rhs.nativeControl, rhs.valueBits, cast<u32>(different)));
                }
            }
        }
    }
    WriteBenchmarkStdout(StringFormat("trap edge cases={} differences={} distinguishable={}\n", cases, differences, cast<u32>(delivered)));
    if(!delivered)
        return 2;
    return cast<i32>(differences != 0u);
}

const StringView s_ExceptionalLabel = "exceptional";
const StringView s_RandomLabel = "random";
const StringView s_PositiveFiniteLabel = "positive_finite";
const f32 s_EncodeExponent = 1.0f / 2.4f;
const f32 s_DecodeScale = 1.0f / 1.055f;
const usize s_PowExceptionalCount = 29u;

enum<u8> PowVariant{
    Production = 0u,
    PackedSingle = 1u,
    PackedDouble = 2u,
    kCount = 3u
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class PowFlagsSnapshot{
    public i32 standard = 0;
    public u32 mapped = 0u;
    public u64 nativeBits = 0u;
}

class PowObservation{
    public Array<u32, 4> bits;
    public PowFlagsSnapshot flags = PowFlagsSnapshot();
    public i32 error = 0;
}

class PowCounts{
    public u64 vectors = 0u;
    public u64 bits = 0u;
    public u64 flags = 0u;
    public u64 errors = 0u;
    public u64 quantized = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<PowVariant> ParsePowVariant(in StringView text){
    if(text == "production")
        return PowVariant::Production;
    if(text == "packed_single")
        return PowVariant::PackedSingle;
    if(text == "packed_double")
        return PowVariant::PackedDouble;
    return MakeUnexpected(Failure());
}

b8 EqualPowFlags(in PowFlagsSnapshot lhs, in PowFlagsSnapshot rhs){
    return lhs.standard == rhs.standard && lhs.mapped == rhs.mapped && lhs.nativeBits == rhs.nativeBits;
}

u32 ExceptionalPowBitAt(in usize index){
    switch(index){
    case 0u: return 0u;
    case 1u: return 0x80000000u;
    case 2u: return 1u;
    case 3u: return 0x80000001u;
    case 4u: return 0x007fffffu;
    case 5u: return 0x00800000u;
    case 6u: return 0x80800000u;
    case 7u: return 0x7f7fffffu;
    case 8u: return 0xff7fffffu;
    case 9u: return 0x7f800000u;
    case 10u: return 0xff800000u;
    case 11u: return 0x7fc00123u;
    case 12u: return 0xffc00124u;
    case 13u: return 0x7f800125u;
    case 14u: return 0xff800126u;
    case 15u: return 0x3f800000u;
    case 16u: return 0xbf800000u;
    case 17u: return 0x40000000u;
    case 18u: return 0xc0000000u;
    case 19u: return 0x3f000000u;
    case 20u: return 0xbf000000u;
    case 21u: return 0x40400000u;
    case 22u: return 0xc0400000u;
    case 23u: return 0x4b7fffffu;
    case 24u: return 0x4b800000u;
    case 25u: return 0x4b800001u;
    case 26u: return 0x3eaaaaabu;
    case 27u: return 0x42fe0000u;
    default: return 0xc3160000u;
    }
}

Expected<PowObservation> ObservePow(in u8 variantCode, in b8 useReference, in VectorSingle x, in VectorSingle y){
    PowObservation observation = PowObservation();
    if(!ObservePowKernel(
        variantCode,
        useReference,
        x,
        y,
        observation.bits,
        observation.flags.standard,
        observation.flags.mapped,
        observation.flags.nativeBits,
        observation.error
    ))
        return MakeUnexpected(Failure());
    return observation;
}

VectorSingle EncodePowSrgb(in VectorSingle linear, in u8 variantCode, in b8 useReference){
    const VectorSingle clamped = Saturate(linear);
    const VectorSingle exponent = VectorSingle(s_EncodeExponent, s_EncodeExponent, s_EncodeExponent, s_EncodeExponent);
    const VectorSingle powered = EvaluatePow(variantCode, useReference, clamped, exponent);
    const VectorSingle nonlinear = powered * 1.055f - VectorSingle(0.055f, 0.055f, 0.055f, 0.055f);
    const VectorSingle encoded = VectorSelect(nonlinear, clamped * 12.92f, VectorLessOrEqual(clamped, VectorSingle(0.0031308f)));
    const VectorSingle scaled = Saturate(encoded) * 255.0f + VectorSingle(0.5f, 0.5f, 0.5f, 0.5f);
    return Min(Floor(scaled), VectorSingle(255.0f, 255.0f, 255.0f, 255.0f));
}

b8 ComparePowCase(
    in StringView category,
    in PowVariant variant,
    in VectorSingle x,
    in VectorSingle y,
    in b8 quantize,
    mut PowCounts counts
){
    const u8 variantCode = cast<u8>(variant);
    const Expected<PowObservation> expected = ObservePow(variantCode, true, x, y);
    const Expected<PowObservation> actual = ObservePow(variantCode, false, x, y);
    if(!expected.has_value() || !actual.has_value())
        return false;
    ++counts.vectors;

    const b8 flagsDiffer = !EqualPowFlags(expected.value().flags, actual.value().flags);
    const b8 errorDiffers = expected.value().error != actual.value().error;
    if(flagsDiffer)
        ++counts.flags;
    if(errorDiffers)
        ++counts.errors;

    for(usize lane = 0u; lane < 4u; ++lane){
        const u32 expectedBits = expected.value().bits[lane];
        const u32 actualBits = actual.value().bits[lane];
        if(expectedBits != actualBits){
            if(counts.bits < 4u){
                WriteBenchmarkStdout(StringFormat(
                    "bits category={} lane={} x=0x{:x} y=0x{:x} expected=0x{:x} actual=0x{:x}\n",
                    category,
                    lane,
                    SimdGetSingleLaneBits(x, lane),
                    SimdGetSingleLaneBits(y, lane),
                    expectedBits,
                    actualBits
                ));
            }
            ++counts.bits;
        }
    }
    if(flagsDiffer && counts.flags <= 2u){
        const PowFlagsSnapshot expFlags = expected.value().flags;
        const PowFlagsSnapshot actFlags = actual.value().flags;
        WriteBenchmarkStdout(StringFormat(
            "flags category={} x0=0x{:x} y0=0x{:x} expected={}/{}/{} actual={}/{}/{}\n",
            category,
            SimdGetSingleLaneBits(x, 0u),
            SimdGetSingleLaneBits(y, 0u),
            expFlags.standard,
            expFlags.mapped,
            expFlags.nativeBits,
            actFlags.standard,
            actFlags.mapped,
            actFlags.nativeBits
        ));
    }
    if(errorDiffers && counts.errors <= 2u){
        WriteBenchmarkStdout(StringFormat(
            "errno category={} x0=0x{:x} y0=0x{:x} expected={} actual={}\n",
            category,
            SimdGetSingleLaneBits(x, 0u),
            SimdGetSingleLaneBits(y, 0u),
            expected.value().error,
            actual.value().error
        ));
    }
    if(quantize){
        const VectorSingle expectedQuantized = EncodePowSrgb(x, variantCode, true);
        const VectorSingle actualQuantized = EncodePowSrgb(x, variantCode, false);
        for(usize lane = 0u; lane < 4u; ++lane){
            if(SimdGetSingleLaneBits(expectedQuantized, lane) != SimdGetSingleLaneBits(actualQuantized, lane)){
                if(counts.quantized < 4u){
                    WriteBenchmarkStdout(StringFormat(
                        "quantized category={} lane={} x=0x{:x} expected={} actual={}\n",
                        category,
                        lane,
                        SimdGetSingleLaneBits(x, lane),
                        SimdGetSingleLane(expectedQuantized, lane),
                        SimdGetSingleLane(actualQuantized, lane)
                    ));
                }
                ++counts.quantized;
            }
        }
    }
    return true;
}

void PrintPowCounts(in StringView category, in PowCounts counts){
    WriteBenchmarkStdout(StringFormat(
        "summary category={} vectors={} lanes={} bits={} flags={} errno={} quantized={}\n",
        category,
        counts.vectors,
        counts.vectors * 4u,
        counts.bits,
        counts.flags,
        counts.errors,
        counts.quantized
    ));
}

u64 TotalPowFailures(in PowCounts counts){
    return counts.bits + counts.flags + counts.errors + counts.quantized;
}

u64 VerifyPowVariant(in PowVariant variant){
    u64 failures = 0u;
    const u8 variantCode = cast<u8>(variant);
    const VectorSingle encodeExponent = VectorSingle(s_EncodeExponent, s_EncodeExponent, s_EncodeExponent, s_EncodeExponent);
    const VectorSingle decodeExponent = VectorSingle(2.4f, 2.4f, 2.4f, 2.4f);
    const VectorSingle decodeOffset = VectorSingle(0.055f, 0.055f, 0.055f, 0.055f);

    for(usize modeIndex = 0u; modeIndex < 4u; ++modeIndex){
        const i32 mode = SimdRoundingModeByIndex(modeIndex);
        if(!SetFloatingPointRoundingMode(mode).has_value()){
            ++failures;
            break;
        }
        WriteBenchmarkStdout(StringFormat("rounding={}\n", mode));
        PowCounts exceptional = PowCounts();
        PowCounts random = PowCounts();
        PowCounts positive = PowCounts();
        PowCounts srgb = PowCounts();
        b8 ok = true;

        for(usize xi = 0u; xi < s_PowExceptionalCount && ok; ++xi){
            const u32 xBits = ExceptionalPowBitAt(xi);
            for(usize yi = 0u; yi < s_PowExceptionalCount && ok; ++yi){
                const u32 yBits = ExceptionalPowBitAt(yi);
                for(usize lane = 0u; lane < 4u && ok; ++lane){
                    Array<u32, 4> leftWords;
                    Array<u32, 4> rightWords;
                    for(usize w = 0u; w < 4u; ++w){
                        leftWords[w] = 0x3f800000u;
                        rightWords[w] = 0x3f800000u;
                    }
                    leftWords[lane] = xBits;
                    rightWords[lane] = yBits;
                    const VectorSingle left = VectorSingle(u32x4(leftWords[0], leftWords[1], leftWords[2], leftWords[3]));
                    const VectorSingle right = VectorSingle(u32x4(rightWords[0], rightWords[1], rightWords[2], rightWords[3]));
                    if(!ComparePowCase(s_ExceptionalLabel, variant, left, right, false, exceptional)){
                        ++failures;
                        ok = false;
                    }
                }
            }
        }
        if(!ok)
            break;

        u64 seed = 0x8923409102431291ull;
        for(usize index = 0u; index < 32768u && ok; ++index){
            Array<u32, 4> xWords;
            Array<u32, 4> yWords;
            for(usize lane = 0u; lane < 4u; ++lane){
                xWords[lane] = cast<u32>(NextSeed(seed));
                yWords[lane] = cast<u32>(NextSeed(seed));
            }
            const VectorSingle left = VectorSingle(u32x4(xWords[0], xWords[1], xWords[2], xWords[3]));
            const VectorSingle right = VectorSingle(u32x4(yWords[0], yWords[1], yWords[2], yWords[3]));
            if(!ComparePowCase(s_RandomLabel, variant, left, right, false, random)){
                ++failures;
                ok = false;
            }
        }
        if(!ok)
            break;

        for(usize index = 0u; index < 65536u && ok; ++index){
            Array<u32, 4> xWords;
            Array<u32, 4> yWords;
            for(usize lane = 0u; lane < 4u; ++lane){
                xWords[lane] = 0x00800000u + cast<u32>(NextSeed(seed) % 0x7f000000u);
                yWords[lane] = (0x3c000000u + cast<u32>(NextSeed(seed) % 0x06000000u)) | (cast<u32>(NextSeed(seed)) & 0x80000000u);
            }
            const VectorSingle left = VectorSingle(u32x4(xWords[0], xWords[1], xWords[2], xWords[3]));
            const VectorSingle right = VectorSingle(u32x4(yWords[0], yWords[1], yWords[2], yWords[3]));
            if(!ComparePowCase(s_PositiveFiniteLabel, variant, left, right, false, positive)){
                ++failures;
                ok = false;
            }
        }
        if(!ok)
            break;

        for(u32 first = 0u; first < 65536u && ok; first += 4u){
            const VectorSingle linear = VectorSingle(cast<f32>(first), cast<f32>(first + 1u), cast<f32>(first + 2u), cast<f32>(first + 3u)) * (1.0f / 65535.0f);
            if(!ComparePowCase("srgb_uniform16", variant, linear, encodeExponent, true, srgb)){
                ++failures;
                ok = false;
            }
        }
        if(!ok)
            break;

        for(u32 first = 0u; first < 256u && ok; first += 4u){
            const VectorSingle encoded = VectorSingle(cast<f32>(first), cast<f32>(first + 1u), cast<f32>(first + 2u), cast<f32>(first + 3u)) * (1.0f / 255.0f);
            const VectorSingle base = (encoded + decodeOffset) * s_DecodeScale;
            if(!ComparePowCase("srgb_decode8", variant, base, decodeExponent, false, srgb)){
                ++failures;
                ok = false;
            }
        }
        if(!ok)
            break;

        // Search every 8-bit transition in the actual rounded reference expression.
        for(u32 transition = 1u; transition < 256u && ok; ++transition){
            u32 lower = 0u;
            u32 upper = 0x3f800000u;
            while(lower < upper){
                const u32 midpoint = lower + (upper - lower) / 2u;
                const VectorSingle probe = VectorSingle(u32x4(midpoint, midpoint, midpoint, midpoint));
                if(EncodePowSrgb(probe, variantCode, true).x < cast<f32>(transition))
                    lower = midpoint + 1u;
                else
                    upper = midpoint;
            }
            for(i32 offset = -16; offset <= 16 && ok; ++offset){
                const u32 sampleBits = lower + cast<u32>(offset);
                const VectorSingle linear = VectorSingle(u32x4(sampleBits, sampleBits, sampleBits, sampleBits));
                if(!ComparePowCase("srgb_transition", variant, linear, encodeExponent, true, srgb)){
                    ++failures;
                    ok = false;
                }
            }
        }
        if(!ok)
            break;

        PrintPowCounts(s_ExceptionalLabel, exceptional);
        PrintPowCounts(s_RandomLabel, random);
        PrintPowCounts(s_PositiveFiniteLabel, positive);
        PrintPowCounts("srgb", srgb);
        failures += TotalPowFailures(exceptional);
        failures += TotalPowFailures(random);
        failures += TotalPowFailures(positive);
        failures += TotalPowFailures(srgb);
    }
    return failures;
}

i32 VerifyPowTraps(in PowVariant variant){
    return VerifyPowTrapsKernel(cast<u8>(variant));
}

i32 VerifyPowTrapEdges(in PowVariant variant){
    return VerifyPowTrapEdgesKernel(cast<u8>(variant));
}

i32 RunPowQualificationCli(in Span<StringView> args){
    if(args.size() != 2u && args.size() != 3u){
        WriteBenchmarkStderr("usage: simd_pow_qualification production|packed_single|packed_double [traps]\n");
        return 2;
    }
    const StringView variantText = args[1];
    const Expected<PowVariant> parsedVariant = ParsePowVariant(variantText);
    if(!parsedVariant.has_value())
        return 2;
    const PowVariant variant = parsedVariant.value();

    if(args.size() == 3u){
        if(args[2] != "traps")
            return 2;
        const i32 originalTraps = VerifyPowTraps(variant);
        if(originalTraps == 0)
            return VerifyPowTrapEdges(variant);
        return originalTraps;
    }

    PowQualificationEnvironmentScope environmentScope = PowQualificationEnvironmentScope();
    if(!environmentScope.available())
        return 2;
    WriteBenchmarkStdout(StringFormat("variant={}\n", variantText));
    const u64 failures = VerifyPowVariant(variant);
    u32 admitted = 0u;
    if(failures == 0u)
        admitted = 1u;
    WriteBenchmarkStdout(StringFormat("qualification differences={} admitted={}\n", failures, admitted));
    if(failures == 0u)
        return 0;
    return 1;
}


