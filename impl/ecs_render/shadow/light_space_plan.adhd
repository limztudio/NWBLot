#include <impl/ecs_render/shadow/light_space_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<LightSpacePlan> TryBuildLightSpacePlan(in SoftwareShadowSettings settings, in Span<LightSpaceLightRequest> requests, in u64 maxStorageBufferRange, in u32 drawCount, in b8 csgIntervalDepth){
    LightSpacePlan outPlan;
    const usize requestCount = requests.size();
    if(maxStorageBufferRange == 0u || !ValidateSoftwareShadowSettings(settings) || requestCount > s_SceneShadowSlotCount)
        return makeUnexpected(Failure());
    u32 seenSlots = 0u;
    u64 seenLights = 0u;
    for(usize index = 0u; index < requestCount; ++index){
        const LightSpaceLightRequest request = requests[index];
        if(request.lightIndex >= s_SceneMaxLights || request.shadowSlot >= s_SceneShadowSlotCount || request.type >= s_LightSpaceLightTypeCount)
            return makeUnexpected(Failure());
        const u32 slotBit = 1u << request.shadowSlot;
        const u64 lightBit = 1ull << request.lightIndex;
        if((seenSlots & slotBit) != 0u || (seenLights & lightBit) != 0u)
            return makeUnexpected(Failure());
        seenSlots |= slotBit;
        seenLights |= lightBit;
    }
    if(settings.backend == SoftwareShadowBackend::SoftwareTrace)
        return outPlan;
    for(usize index = 0u; index < requestCount; ++index){
        const LightSpaceLightRequest request = requests[index];
        if(!request.eligible || request.type == s_LightSpaceLightTypeSpot)
            continue;
        if(drawCount == 0u)
            return makeUnexpected(Failure());
        const b8 point = request.type == s_LightSpaceLightTypePoint;
        u32 resolution = settings.directionalResolution;
        u32 viewCount = 1u;
        if(point){
            resolution = settings.pointResolution;
            viewCount = s_PointLightViewCount;
        }
        const u64 pixelsPerView = cast<u64>(resolution) * cast<u64>(resolution);
        const u64 pixels = cast<u64>(outPlan.totalPixels) + pixelsPerView * cast<u64>(viewCount);
        const u32 newViewCount = outPlan.viewCount + viewCount;
        const u32 textureResolution = max(outPlan.textureResolution, resolution);
        const u64 eventBytes = pixels * s_LightSpaceEventsPerTexel * s_LightSpaceEventBytes;
        const u64 countBytes = pixels * s_LightSpacePixelWordBytes;
        // Every D32 array layer uses the largest selected extent, even when its viewport is smaller.
        const u64 depthBytes = cast<u64>(textureResolution) * cast<u64>(textureResolution) * cast<u64>(newViewCount) * s_LightSpacePixelWordBytes;
        const u64 viewBytes = cast<u64>(newViewCount) * s_LightSpaceViewBytes;
        const u64 drawArgumentBytes = cast<u64>(newViewCount) * cast<u64>(drawCount) * s_LightSpaceDrawArgumentBytes;
        u64 extraCountBytes = 0u;
        if(csgIntervalDepth)
            extraCountBytes = countBytes;
        const u64 totalBytes = eventBytes + countBytes + depthBytes + viewBytes + drawArgumentBytes + extraCountBytes;
        if(
            totalBytes > settings.memoryBudgetBytes
            || eventBytes > s_ShadowMaxMemoryBudgetBytes
            || eventBytes > maxStorageBufferRange
            || viewBytes > maxStorageBufferRange
            || drawArgumentBytes > maxStorageBufferRange
            || drawArgumentBytes > s_ShadowMaxMemoryBudgetBytes
        )
            continue;
        ++outPlan.lightCount;
        LightSpaceFlag lightFlags = LightSpaceFlag::Eligible;
        if(point)
            lightFlags |= LightSpaceFlag::Point;
        if(settings.coverage == SoftwareShadowCoverage::FittedVolume)
            lightFlags |= LightSpaceFlag::FittedCoverage;
        if(settings.blockerSearch == SoftwareShadowBlockerSearch::CompactCross5)
            lightFlags |= LightSpaceFlag::CompactBlockers;
        if(settings.blockerSearch == SoftwareShadowBlockerSearch::Center1)
            lightFlags |= LightSpaceFlag::CenterBlocker;
        for(u32 face = 0u; face < viewCount; ++face){
            const u32 viewIndex = outPlan.viewCount + face;
            outPlan.views[viewIndex].map[0] = resolution;
            outPlan.views[viewIndex].map[1] = resolution;
            outPlan.views[viewIndex].map[2] = outPlan.totalPixels + cast<u32>(pixelsPerView) * face;
            outPlan.views[viewIndex].map[3] = viewIndex;
            outPlan.views[viewIndex].light[0] = request.lightIndex;
            outPlan.views[viewIndex].light[1] = request.shadowSlot;
            outPlan.views[viewIndex].light[2] = face;
            outPlan.views[viewIndex].light[3] = cast<u32>(lightFlags);
        }
        outPlan.viewCount = newViewCount;
        outPlan.textureResolution = textureResolution;
        outPlan.totalPixels = cast<u32>(pixels);
        outPlan.eventByteSize = eventBytes;
        outPlan.countByteSize = countBytes;
        outPlan.depthByteSize = depthBytes;
        outPlan.viewByteSize = viewBytes;
        outPlan.drawArgumentByteSize = drawArgumentBytes;
        outPlan.totalByteSize = totalBytes;
    }
    return outPlan;
}

u32 LightSpaceCasterDrawCount(in u32 meshletCount){
    if(meshletCount == 0u)
        return 1u;
    return divideUp(meshletCount, s_LightSpaceMeshletsPerDraw);
}

b8 LightSpaceCasterEligibleForCapturePass(in b8 casterTransparent, in b8 casterCsg, in b8 passTransparent, in u32 indexCount, in u32 csgFlags){
    if((casterTransparent || casterCsg) != passTransparent || indexCount == 0u)
        return false;
    if((csgFlags & s_LightSpaceCsgShadowFlagHwCompose) != 0u && !casterCsg)
        return false;
    return true;
}

u8 ResolveLightSpaceLightRequestType(in f32 lightTypeParam, in b8 hasCsg){
    if(lightTypeParam < s_LightTypeDirectionalMax)
        return s_LightSpaceLightTypeDirectional;
    if(lightTypeParam < s_LightTypePointMax || hasCsg)
        return s_LightSpaceLightTypePoint;
    return s_LightSpaceLightTypeSpot;
}

LightSpaceCsgInstanceGpu BuildLightSpaceCsgInstanceGpu(
    in u32 meshletPrimitiveIndexCount,
    in b8 hasRuntimeBounds,
    in u32 runtimeBoundsSlot,
    in b8 hardware,
    in b8 hasSwBvhNode,
    in u32 swBvhNodeSlot
){
    LightSpaceCsgInstanceGpu instance;
    instance.primitiveCount = meshletPrimitiveIndexCount / s_LightSpaceTriangleCornerCount;
    if(hasRuntimeBounds)
        instance.runtimeBoundsSlot = runtimeBoundsSlot;
    if(!hardware && hasSwBvhNode)
        instance.meshRootSlot = swBvhNodeSlot;
    return instance;
}

LightSpaceCsgContextHeader BuildLightSpaceCsgContextHeader(
    in usize instanceCount,
    in usize rangeBytes,
    in usize cutterBytes,
    in usize cutterCount,
    in usize activeReceiverOffset,
    in u32 activeReceiverCount
){
    LightSpaceCsgContextHeader header;
    header.instanceCount = cast<u32>(instanceCount);
    header.rangeByteOffset = s_LightSpaceCsgRayContextBytes;
    header.cutterByteOffset = cast<u32>(cast<usize>(s_LightSpaceCsgRayContextBytes) + rangeBytes);
    header.cutterCount = cast<u32>(cutterCount);
    header.instanceByteOffset = cast<u32>(cast<usize>(s_LightSpaceCsgRayContextBytes) + rangeBytes + cutterBytes);
    header.activeReceiverByteOffset = cast<u32>(activeReceiverOffset);
    header.activeReceiverCount = activeReceiverCount;
    header.rayFailureFlags = 0u;
    return header;
}

b8 LightSpaceShadowStorageFits(in LightSpacePlan plan, in LightSpaceShadowStorageCapacity capacity){
    return
        plan.viewCount != 0u && plan.textureResolution != 0u
        && plan.countByteSize != 0u && plan.eventByteSize != 0u && plan.viewByteSize != 0u && plan.drawArgumentByteSize != 0u
        && plan.countByteSize <= capacity.countBytes && plan.eventByteSize <= capacity.eventBytes
        && plan.viewByteSize <= capacity.viewBytes && plan.drawArgumentByteSize <= capacity.drawArgumentBytes
        && plan.textureResolution <= capacity.textureResolution
        && plan.viewCount <= capacity.arrayLayers
    ;
}

void LogNewLightSpaceCsgRayFailures(in u32 failureFlags, mut u32 inOutReportedFailures){
    const u32 newFailures = failureFlags & ~inOutReportedFailures;
    inOutReportedFailures |= failureFlags;
    if((newFailures & s_LightSpaceCsgRayFailureUnsupported) != 0u)
        warning("RendererSystem: CSG direct-shadow traversal rejected unsupported receiver or cutter geometry; conservative occlusion retained");
    if((newFailures & s_LightSpaceCsgRayFailureCapacity) != 0u)
        warning("RendererSystem: CSG direct-shadow traversal exceeded closed-crossing or BVH stack capacity (flags=2); conservative occlusion retained");
    if((newFailures & s_LightSpaceCsgRayFailureTopology) != 0u)
        warning("RendererSystem: CSG direct-shadow traversal rejected incomplete or invalid solid topology; conservative occlusion retained");
    if((newFailures & s_LightSpaceCsgRayFailureOpenCapacity) != 0u)
        warning("RendererSystem: CSG direct-shadow traversal exceeded open-surface capacity (flags=16); conservative occlusion retained");
}

b8 HasAnyLightSpaceCsgActiveLight(in b8 hasCsg, in Span<SceneLightGpuData> lights){
    if(!hasCsg)
        return false;
    for(in SceneLightGpuData light : lights){
        if(light.params.z >= 0.0f)
            return true;
    }
    return false;
}

Expected<LightSpacePlan> TryBuildLightSpacePlanForSceneLights(
    in SoftwareShadowSettings baseSettings,
    in Span<SceneLightGpuData> lights,
    in u64 maxStorageBufferRange,
    in u32 drawCount,
    in b8 hasCsg,
    in usize csgContextBytes
){
    const usize lightCount = lights.size();
    if(lightCount > cast<usize>(s_SceneMaxLights))
        return makeUnexpected(Failure());

    Array<LightSpaceLightRequest, s_SceneShadowSlotCount> requests;
    usize requestCount = 0u;
    for(u32 index = 0u; index < cast<u32>(lightCount); ++index){
        const SceneLightGpuData light = lights[cast<usize>(index)];
        if(light.params.z < 0.0f || light.params.z >= cast<f32>(s_SceneShadowSlotCount))
            continue;
        if(requestCount == requests.size())
            return makeUnexpected(Failure());
        LightSpaceLightRequest request;
        request.lightIndex = index;
        request.shadowSlot = cast<u32>(light.params.z);
        request.type = ResolveLightSpaceLightRequestType(light.params.y, hasCsg);
        request.eligible = true;
        requests[requestCount] = request;
        ++requestCount;
    }

    SoftwareShadowSettings settings = baseSettings;
    if(hasCsg){
        settings.backend = SoftwareShadowBackend::Automatic;
        const u64 requiredCsgBytes = cast<u64>(csgContextBytes) + 4ull;
        if(settings.memoryBudgetBytes <= requiredCsgBytes)
            return makeUnexpected(Failure());
        settings.memoryBudgetBytes -= requiredCsgBytes;
    }

    const Span<LightSpaceLightRequest> allRequests = requests;
    const Expected<LightSpacePlan> plan = TryBuildLightSpacePlan(
        settings,
        allRequests.subspan(0u, requestCount),
        maxStorageBufferRange,
        drawCount,
        hasCsg
    );
    if(!plan.has_value() || plan.value().viewCount == 0u)
        return makeUnexpected(Failure());
    return plan.value();
}

u64 UpdateFnv64Float4LittleEndian(in u64 hash, in VectorSingle value){
    u64 outHash = updateFnv64U32(hash, bit_cast<u32>(value.x));
    outHash = updateFnv64U32(outHash, bit_cast<u32>(value.y));
    outHash = updateFnv64U32(outHash, bit_cast<u32>(value.z));
    outHash = updateFnv64U32(outHash, bit_cast<u32>(value.w));
    return outHash;
}

LightSpaceCaptureIdentity BuildLightSpaceCaptureIdentity(
    in u64 sceneIdentity,
    in b8 sceneTrusted,
    in Span<SceneLightGpuData> lights,
    in u32 width,
    in u32 height,
    in LightSpacePlan plan
){
    LightSpaceCaptureIdentity identity;
    identity.scene = sceneIdentity;
    identity.trusted = sceneTrusted;
    identity.lighting = s_Fnv64OffsetBasis;
    const u32 lightCount = cast<u32>(lights.size());
    identity.lighting = updateFnv64U32(identity.lighting, lightCount);
    for(in SceneLightGpuData light : lights){
        identity.lighting = UpdateFnv64Float4LittleEndian(identity.lighting, VectorSingle(light.position));
        identity.lighting = UpdateFnv64Float4LittleEndian(identity.lighting, VectorSingle(light.direction));
        identity.lighting = UpdateFnv64Float4LittleEndian(identity.lighting, VectorSingle(light.colorIntensity));
        identity.lighting = UpdateFnv64Float4LittleEndian(identity.lighting, VectorSingle(light.params));
        identity.lighting = UpdateFnv64Float4LittleEndian(identity.lighting, VectorSingle(light.params2));
    }
    identity.layout = s_Fnv64OffsetBasis;
    identity.layout = updateFnv64U32(identity.layout, width);
    identity.layout = updateFnv64U32(identity.layout, height);
    identity.layout = updateFnv64U32(identity.layout, plan.lightCount);
    identity.layout = updateFnv64U32(identity.layout, plan.viewCount);
    identity.layout = updateFnv64U32(identity.layout, plan.textureResolution);
    identity.layout = updateFnv64U64(identity.layout, plan.drawArgumentByteSize);
    for(u32 view = 0u; view < plan.viewCount; ++view){
        for(usize lane = 0u; lane < 4u; ++lane)
            identity.layout = updateFnv64U32(identity.layout, plan.views[cast<usize>(view)].map[lane]);
        for(usize lane = 0u; lane < 4u; ++lane)
            identity.layout = updateFnv64U32(identity.layout, plan.views[cast<usize>(view)].light[lane]);
    }
    return identity;
}


