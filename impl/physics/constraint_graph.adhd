////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/physics/island.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class GraphColor{
    public Vector<u32> contactIds;

    public void clear(){
        this.contactIds.clear();
    }
}

class ConstraintGraph{
    public Array<GraphColor, s_GraphColorCount> colors;
    public Vector<u32> bodyColorMasks;

    public void clear(){
        for(usize i = 0u; i < s_GraphColorCount; ++i)
            this.colors[i].clear();
        for(usize i = 0u; i < this.bodyColorMasks.size(); ++i)
            this.bodyColorMasks[i] = 0u;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void AddContactToGraph(mut ConstraintGraph graph, in Vector<Body> bodies, mut Contact contact){
    if(contact.colorIndex != s_NullIndex)
        return;

    const u32 bodyIdA = contact.edges[0u].bodyId;
    const u32 bodyIdB = contact.edges[1u].bodyId;
    const b8 staticA = (bodies[bodyIdA].type == BodyType::Static || bodies[bodyIdA].type == BodyType::Kinematic);
    const b8 staticB = (bodies[bodyIdB].type == BodyType::Static || bodies[bodyIdB].type == BodyType::Kinematic);

    u32 maskA = 0u;
    if(!staticA && cast<usize>(bodyIdA) < graph.bodyColorMasks.size())
        maskA = graph.bodyColorMasks[bodyIdA];
    u32 maskB = 0u;
    if(!staticB && cast<usize>(bodyIdB) < graph.bodyColorMasks.size())
        maskB = graph.bodyColorMasks[bodyIdB];
    const u32 used = maskA | maskB;

    usize chosenColor = s_OverflowColorIndex;
    if(!staticA && !staticB){
        const u32 avail = (~used) & 0x000fffffu;
        if(avail != 0u)
            chosenColor = cast<usize>(CountTrailingZeros(avail));
    }
    else{
        u32 avail = (~used) & 0x00700000u;
        if(avail == 0u)
            avail = (~used) & 0x000fffffu;
        if(avail != 0u)
            chosenColor = cast<usize>(CountTrailingZeros(avail));
    }

    mut GraphColor color = graph.colors[chosenColor];
    if(chosenColor != s_OverflowColorIndex){
        const u32 colorBit = 1u << cast<u32>(chosenColor);
        const usize requiredSize = cast<usize>(Max(bodyIdA, bodyIdB)) + 1u;
        if(requiredSize > graph.bodyColorMasks.size())
            graph.bodyColorMasks.resize(requiredSize, 0u);
        if(!staticA)
            graph.bodyColorMasks[bodyIdA] |= colorBit;
        if(!staticB)
            graph.bodyColorMasks[bodyIdB] |= colorBit;
    }

    contact.colorIndex = cast<u32>(chosenColor);
    contact.localIndex = cast<u32>(color.contactIds.size());
    color.contactIds.push_back(contact.contactId);
}

void RemoveContactFromGraph(mut ConstraintGraph graph, in Vector<Body> bodies, mut Vector<Contact> contacts, in u32 contactId){
    mut Contact contact = contacts[contactId];
    const u32 colorIdx = contact.colorIndex;
    if(colorIdx >= s_GraphColorCount)
        return;

    mut GraphColor color = graph.colors[colorIdx];
    const u32 localIdx = contact.localIndex;
    const u32 bodyIdA = contact.edges[0u].bodyId;
    const u32 bodyIdB = contact.edges[1u].bodyId;

    if(localIdx < color.contactIds.size()){
        const u32 lastIdx = cast<u32>(color.contactIds.size() - 1u);
        if(localIdx != lastIdx){
            const u32 movedContactId = color.contactIds[lastIdx];
            color.contactIds[localIdx] = movedContactId;
            contacts[movedContactId].localIndex = localIdx;
        }
        color.contactIds.pop_back();
    }

    if(colorIdx != s_OverflowColorIndex){
        const u32 clearMask = ~(1u << colorIdx);
        if(bodies[bodyIdA].type == BodyType::Dynamic && cast<usize>(bodyIdA) < graph.bodyColorMasks.size())
            graph.bodyColorMasks[bodyIdA] &= clearMask;
        if(bodies[bodyIdB].type == BodyType::Dynamic && cast<usize>(bodyIdB) < graph.bodyColorMasks.size())
            graph.bodyColorMasks[bodyIdB] &= clearMask;
    }

    contact.colorIndex = s_NullIndex;
    contact.localIndex = s_NullIndex;
}

void WakeIslandWithGraph(
    mut ConstraintGraph graph,
    mut Vector<Body> bodies,
    mut Vector<Island> islands,
    mut Vector<SolverSet> sets,
    mut Vector<u32> freeSolverSetIds,
    mut Vector<Contact> contacts,
    in u32 islandId
){
    if(islandId == s_NullIndex || islandId >= islands.size() || !islands[islandId].alive)
        return;
    const u32 oldSetIndex = islands[islandId].setIndex;
    if(oldSetIndex == s_AwakeSetIndex || oldSetIndex < 3u)
        return;

    WakeIslandInSets(bodies, islands, sets, islandId);

    if(oldSetIndex < sets.size() && sets[oldSetIndex].sims.empty() && sets[oldSetIndex].islands.empty())
        freeSolverSetIds.push_back(oldSetIndex);

    in Island island = islands[islandId];
    for(usize i = 0u; i < island.contacts.size(); ++i){
        const u32 cId = island.contacts[i].contactId;
        if(cId < contacts.size()){
            in Contact wokenContact = contacts[cId];
            const b8 isAlive = (wokenContact.flags & cast<u32>(ContactFlags::Alive)) != 0u;
            const b8 isSensor = (wokenContact.flags & cast<u32>(ContactFlags::Sensor)) != 0u;
            if(isAlive && !isSensor && wokenContact.manifold.pointCount() > 0u)
                AddContactToGraph(graph, bodies, contacts[cId]);
        }
    }
}

void WakeBodyWithGraph(
    mut ConstraintGraph graph,
    mut Vector<Body> bodies,
    mut Vector<Island> islands,
    mut Vector<SolverSet> sets,
    mut Vector<u32> freeSolverSetIds,
    mut Vector<Contact> contacts,
    in u32 bodyId
){
    if(bodyId >= bodies.size() || !bodies[bodyId].alive)
        return;
    const u32 setIdx = bodies[bodyId].setIndex;
    if(setIdx == s_StaticSetIndex || setIdx == s_DisabledSetIndex || setIdx == s_AwakeSetIndex)
        return;

    if(bodies[bodyId].islandId != s_NullIndex){
        WakeIslandWithGraph(graph, bodies, islands, sets, freeSolverSetIds, contacts, bodies[bodyId].islandId);
        return;
    }

    WakeBodyWithIsland(bodies, islands, sets, bodyId);
    if(setIdx >= 3u && setIdx < sets.size() && sets[setIdx].sims.empty() && sets[setIdx].islands.empty())
        freeSolverSetIds.push_back(setIdx);
}

u32 MergeIslandsInWorldWithGraph(
    mut ConstraintGraph graph,
    mut Vector<Body> bodies,
    mut Vector<Island> islands,
    mut Vector<u32> freeIslandIds,
    mut Vector<SolverSet> sets,
    mut Vector<u32> freeSolverSetIds,
    mut Vector<Contact> contacts,
    mut Vector<Joint> joints,
    in u32 islandIdA,
    in u32 islandIdB
){
    if(islandIdA != s_NullIndex)
        WakeIslandWithGraph(graph, bodies, islands, sets, freeSolverSetIds, contacts, islandIdA);
    if(islandIdB != s_NullIndex)
        WakeIslandWithGraph(graph, bodies, islands, sets, freeSolverSetIds, contacts, islandIdB);
    return MergeIslandsInWorld(bodies, islands, freeIslandIds, sets, contacts, joints, islandIdA, islandIdB);
}

void LinkContactToIslandWithGraph(
    mut ConstraintGraph graph,
    mut Vector<Body> bodies,
    mut Vector<Island> islands,
    mut Vector<u32> freeIslandIds,
    mut Vector<SolverSet> sets,
    mut Vector<u32> freeSolverSetIds,
    mut Vector<Contact> contacts,
    mut Vector<Joint> joints,
    in u32 contactId
){
    mut Contact contact = contacts[contactId];
    if(contact.islandId != s_NullIndex)
        return;

    const u32 bodyIdA = contact.edges[0u].bodyId;
    const u32 bodyIdB = contact.edges[1u].bodyId;
    WakeBodyWithGraph(graph, bodies, islands, sets, freeSolverSetIds, contacts, bodyIdA);
    WakeBodyWithGraph(graph, bodies, islands, sets, freeSolverSetIds, contacts, bodyIdB);

    const u32 islandA = bodies[bodyIdA].islandId;
    const u32 islandB = bodies[bodyIdB].islandId;

    u32 targetIsland = s_NullIndex;
    if(islandA != s_NullIndex && islandB != s_NullIndex)
        targetIsland = MergeIslandsInWorldWithGraph(graph, bodies, islands, freeIslandIds, sets, freeSolverSetIds, contacts, joints, islandA, islandB);
    else if(islandA != s_NullIndex)
        targetIsland = islandA;
    else if(islandB != s_NullIndex)
        targetIsland = islandB;

    if(targetIsland == s_NullIndex)
        return;

    ContactLink link;
    link.contactId = contactId;
    link.bodyIdA = bodyIdA;
    link.bodyIdB = bodyIdB;

    mut Island island = islands[targetIsland];
    contact.islandId = targetIsland;
    contact.islandIndex = cast<u32>(island.contacts.size());
    island.contacts.push_back(link);
}

void LinkJointToIslandWithGraph(
    mut ConstraintGraph graph,
    mut Vector<Body> bodies,
    mut Vector<Island> islands,
    mut Vector<u32> freeIslandIds,
    mut Vector<SolverSet> sets,
    mut Vector<u32> freeSolverSetIds,
    mut Vector<Contact> contacts,
    mut Vector<Joint> joints,
    in u32 jointId
){
    mut Joint joint = joints[jointId];
    if(joint.islandId != s_NullIndex)
        return;

    const u32 bodyIdA = joint.edges[0u].bodyId;
    const u32 bodyIdB = joint.edges[1u].bodyId;
    WakeBodyWithGraph(graph, bodies, islands, sets, freeSolverSetIds, contacts, bodyIdA);
    WakeBodyWithGraph(graph, bodies, islands, sets, freeSolverSetIds, contacts, bodyIdB);

    const u32 islandA = bodies[bodyIdA].islandId;
    const u32 islandB = bodies[bodyIdB].islandId;

    u32 targetIsland = s_NullIndex;
    if(islandA != s_NullIndex && islandB != s_NullIndex)
        targetIsland = MergeIslandsInWorldWithGraph(graph, bodies, islands, freeIslandIds, sets, freeSolverSetIds, contacts, joints, islandA, islandB);
    else if(islandA != s_NullIndex)
        targetIsland = islandA;
    else if(islandB != s_NullIndex)
        targetIsland = islandB;

    if(targetIsland == s_NullIndex)
        return;

    JointLink link;
    link.jointId = jointId;
    link.bodyIdA = bodyIdA;
    link.bodyIdB = bodyIdB;

    mut Island island = islands[targetIsland];
    joint.islandId = targetIsland;
    joint.islandIndex = cast<u32>(island.joints.size());
    island.joints.push_back(link);
}

void SleepIslandWithGraph(
    mut ConstraintGraph graph,
    mut Vector<Body> bodies,
    mut Vector<Island> islands,
    mut Vector<SolverSet> sets,
    mut Vector<u32> freeSolverSetIds,
    mut Vector<Contact> contacts,
    in u32 islandId
){
    if(islandId == s_NullIndex || islandId >= islands.size() || !islands[islandId].alive)
        return;
    if(islands[islandId].setIndex != s_AwakeSetIndex)
        return;

    u32 sleepSetIndex = s_NullIndex;
    if(!freeSolverSetIds.empty()){
        sleepSetIndex = freeSolverSetIds[freeSolverSetIds.size() - 1u];
        freeSolverSetIds.pop_back();
    }
    else{
        sleepSetIndex = cast<u32>(sets.size());
        SolverSet newSet;
        newSet.setIndex = sleepSetIndex;
        sets.push_back(newSet);
    }

    in Island island = islands[islandId];
    for(usize i = 0u; i < island.contacts.size(); ++i){
        const u32 cId = island.contacts[i].contactId;
        if(cId < contacts.size() && contacts[cId].colorIndex != s_NullIndex)
            RemoveContactFromGraph(graph, bodies, contacts, cId);
    }

    for(usize i = 0u; i < island.bodies.size(); ++i){
        const u32 bodyId = island.bodies[i];
        mut Body body = bodies[bodyId];
        if(body.setIndex != s_AwakeSetIndex || body.localIndex >= sets[s_AwakeSetIndex].sims.size())
            continue;
        BodySim sim = sets[s_AwakeSetIndex].sims[body.localIndex];
        sim.setForce(VectorSingle(0.0f));
        sim.setTorque(VectorSingle(0.0f));
        BodyState emptyState;
        emptyState.setFlags(sim.flags);
        RemoveBodyFromSolverSet(bodies, sets[s_AwakeSetIndex], body.localIndex);
        AddBodyToSolverSet(bodies, sets[sleepSetIndex], sim, emptyState);
    }

    for(usize i = 0u; i < island.bodies.size(); ++i){
        const u32 bodyId = island.bodies[i];
        u32 edgeKey = bodies[bodyId].headContactKey;
        while(edgeKey != s_NullIndex){
            const u32 cId = DecodeContactKeyId(edgeKey);
            const u32 edgeIdx = DecodeContactKeyEdge(edgeKey);
            const u32 nextKey = contacts[cId].edges[edgeIdx].nextKey;
            if(cId < contacts.size() && contacts[cId].colorIndex != s_NullIndex){
                const u32 otherId = contacts[cId].edges[edgeIdx ^ 1u].bodyId;
                const b8 otherAwakeDyn = otherId < bodies.size() && bodies[otherId].alive && bodies[otherId].type == BodyType::Dynamic && bodies[otherId].setIndex == s_AwakeSetIndex;
                if(!otherAwakeDyn)
                    RemoveContactFromGraph(graph, bodies, contacts, cId);
            }
            edgeKey = nextKey;
        }
    }

    const u32 oldLocal = islands[islandId].localIndex;
    if(oldLocal < sets[s_AwakeSetIndex].islands.size()){
        const u32 lastIdx = cast<u32>(sets[s_AwakeSetIndex].islands.size() - 1u);
        if(oldLocal != lastIdx){
            const u32 movedId = sets[s_AwakeSetIndex].islands[lastIdx];
            sets[s_AwakeSetIndex].islands[oldLocal] = movedId;
            islands[movedId].localIndex = oldLocal;
        }
        sets[s_AwakeSetIndex].islands.pop_back();
    }
    islands[islandId].setIndex = sleepSetIndex;
    islands[islandId].localIndex = cast<u32>(sets[sleepSetIndex].islands.size());
    sets[sleepSetIndex].islands.push_back(islandId);
}


