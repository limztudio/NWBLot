constexpr AStringView s_ProjectVirtualRoot = NWB::Tests::AssetsGraphicsFixture::s_ProjectVirtualRoot;
constexpr AStringView s_BuildDirectory = NWB::Tests::AssetsGraphicsFixture::s_BuildDirectory;


