    EXPECT_EQ(missing.selectedKey(), 0u);
    ComboState disabled = ComboState();
    disabled.select(5u);
    source.disabledKey = 5u;
    ASSERT_TRUE(UiComboBehaviorReconcile(disabled, source));
    EXPECT_EQ(disabled.selectedKey(), 0u);
}

void VerifyUiComboBehaviorTests_ReorderPreservesCommittedSelectionAndOpenPreviewCursor(){
    UiComboBehaviorSource source = UiComboBehaviorSource();
    ComboState state = ComboState();
    state.select(4u);
    ASSERT_TRUE(UiComboBehaviorReconcile(state, source));
    UiComboBehaviorOpen(state);
    ASSERT_TRUE(UiComboBehaviorNavigate(source, ControlActionKind::Down, state));
    ASSERT_EQ(state.listState().cursorKey(), 5u);
    source.reversed = true;
    ++source.revisionValue;
    ASSERT_TRUE(UiComboBehaviorReconcile(state, source));
    ASSERT_TRUE(UiComboBehaviorReconcilePreview(state, source));
    EXPECT_EQ(state.selectedKey(), 4u);
    EXPECT_EQ(state.listState().cursorKey(), 5u);
    EXPECT_TRUE(state.isOpen());
}

void VerifyUiComboBehaviorTests_CommittingTheCurrentSelectionIsStillAnActivationAndCloses(){
