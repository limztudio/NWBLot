const Name s_UiLoadFontsArenaName = "impl/ecs_ui/load_fonts";
const usize s_UiLayerPaintReserveQuads = 256u;
const usize s_UiNativeKeySlotCount = 512u;
const f32 s_MaxUiFrameDeltaFloatSeconds = 3.40282346638528859812e+38f;
const f64 s_MaxUiFrameDeltaSeconds = cast<f64>(s_MaxUiFrameDeltaFloatSeconds);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> UiInputOwner{
    Scene = 0u,
    Custom = 1u,
}

enum<u8> UiLayerPresentation{
    Scene,
    Standalone,
}

// Retains CPU update time until a UI paint frame actually begins.
class UiFrameDelta{
    public void add(in f32 deltaSeconds){
        if(!isFinite(deltaSeconds) || deltaSeconds < 0.0f)
            return;
        this.m_pendingSeconds = min(s_MaxUiFrameDeltaSeconds, this.m_pendingSeconds + cast<f64>(deltaSeconds));
    }

    public f32 consume(){
        const f32 elapsed = cast<f32>(this.m_pendingSeconds);
        this.m_pendingSeconds = 0.0;
        return elapsed;
    }

    public void clear(){
        this.m_pendingSeconds = 0.0;
    }

    private f64 m_pendingSeconds = 0.0;
}

class UiLiveRoot{
    public EntityID entity = s_InvalidEntityId;
    public i32 order = 0;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidUiMouseCoordinate(in f64 xpos, in f64 ypos){
    return isFinite(xpos) && isFinite(ypos) && abs(xpos) <= s_MaxUiFrameDeltaSeconds && abs(ypos) <= s_MaxUiFrameDeltaSeconds;
}

b8 ValidUiMouseScroll(in f64 xoffset, in f64 yoffset){
    return isFinite(xoffset) && isFinite(yoffset);
}

usize ResolveUiNativeKeySlot(in i32 key){
    return cast<usize>(key + 1);
}

b8 IsUiLiveRootOrderedBefore(in UiLiveRoot lhs, in UiLiveRoot rhs){
    if(lhs.order != rhs.order)
        return lhs.order < rhs.order;
    return lhs.entity.id < rhs.entity.id;
}

void LogUiInputRoutingOverflows(in b8 activationOverflow, in b8 gestureOverflow){
    if(activationOverflow)
        warning("UiLayerSystem: bounded activation queue is full");
    if(gestureOverflow)
        warning("UiLayerSystem: bounded pointer gesture queue is full");
}

b8 ValidateUiSubsystemFontCount(in usize fontCount, in usize maxFontSources){
    if(fontCount > 0u && fontCount <= maxFontSources)
        return true;

    error("UiLayerSystem: the font stack requires between one and eight font assets");
    return false;
}

void ResolveUiNativeKeyAdmission(
    in u8 storedOwner,
    in b8 routerOwnsKey,
    mut b8 outHeld,
    mut u8 outPreviousOwner,
    mut b8 outCustomOwned
){
    outHeld = storedOwner != 0u;
    if(outHeld){
        outPreviousOwner = storedOwner - 1u;
        outCustomOwned = outPreviousOwner == cast<u8>(UiInputOwner::Custom);
    }
    else{
        outPreviousOwner = cast<u8>(UiInputOwner::Scene);
        outCustomOwned = routerOwnsKey;
    }
}

void FinalizeUiNativeKeyState(
    in b8 isRelease,
    in b8 held,
    in u8 previousOwner,
    in b8 routerClaimsKey,
    mut u8 outStoredOwner,
    mut b8 inOutBlockNativeChars,
    mut b8 outConsumed
){
    u8 owner = previousOwner;
    if(!held){
        if(routerClaimsKey)
            owner = cast<u8>(UiInputOwner::Custom);
        else
            owner = cast<u8>(UiInputOwner::Scene);
    }
    if(isRelease)
        outStoredOwner = 0u;
    else{
        outStoredOwner = owner + 1u;
        inOutBlockNativeChars = owner == cast<u8>(UiInputOwner::Custom);
    }
    outConsumed = owner == cast<u8>(UiInputOwner::Custom);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

