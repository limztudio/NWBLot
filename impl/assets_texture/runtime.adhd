////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_texture/asset.adhd>
#include <impl/assets_texture/texture_binary_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_TextureLoadBinaryContext = "Texture::loadBinary";
const StringView s_TextureValidatePayloadContext = "Texture::validatePayload";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateTextureRuntimePayload(
    in b8 hasValidVirtualPath,
    in Name virtualPath,
    in u8 payloadFormat,
    in u8 dimension,
    in u32 width,
    in u32 height,
    in u32 depth,
    in u8 alphaMode,
    in u8 alphaConstantUnorm8,
    in Span<TextureMipLevel> mipLevels,
    in Span<u8> payloadBytes
){
    if(!hasValidVirtualPath)
        return false;
    return ValidateTextureAssetPayload(
        virtualPath,
        payloadFormat,
        dimension,
        width,
        height,
        depth,
        alphaMode,
        alphaConstantUnorm8,
        mipLevels,
        payloadBytes
    );
}

Expected<usize> TryResolveSeparateAlphaUastcByteOffset(
    in b8 hasSeparateAlpha,
    in Span<TextureMipLevel> mipLevels,
    in usize totalPayloadByteCount
){
    if(!hasSeparateAlpha)
        return MakeUnexpected(Failure());
    const u64 primaryBytes = ComputeTexturePrimaryPayloadByteCount(mipLevels);
    if(primaryBytes > cast<u64>(totalPayloadByteCount))
        return MakeUnexpected(Failure());
    return cast<usize>(primaryBytes);
}

b8 Texture::validatePayload()const{
    return ValidateTextureRuntimePayload(
        this.checkVirtualPath(s_TextureValidatePayloadContext),
        this.virtualPath(),
        cast<u8>(this.m_payloadFormat),
        cast<u8>(this.m_dimension),
        this.m_width,
        this.m_height,
        this.m_depth,
        cast<u8>(this.m_alphaMode),
        this.m_alphaConstantUnorm8,
        this.m_mipLevels,
        this.m_payloadBytes
    );
}

b8 Texture::loadBinary(in Span<u8> binary){
    if(!this.checkVirtualPath(s_TextureLoadBinaryContext))
        return false;

    MipLevelVector mipLevels;
    Vector<u8> payloadBytes;
    u32 width = 0u;
    u32 height = 0u;
    u32 depth = 1u;
    u8 dimensionValue = 0u;
    u8 payloadFormatValue = 0u;
    u8 alphaModeValue = 0u;
    u8 alphaConstantUnorm8 = 0u;
    if(!TextureBinaryCodec().deserialize(
        binary,
        width,
        height,
        depth,
        dimensionValue,
        payloadFormatValue,
        alphaModeValue,
        alphaConstantUnorm8,
        mipLevels,
        payloadBytes
    ))
        return false;

    Texture candidate(this.virtualPath());
    candidate.m_width = width;
    candidate.m_height = height;
    candidate.m_dimension = cast<TexturePayloadDimension>(dimensionValue);
    candidate.m_depth = depth;
    candidate.m_payloadFormat = cast<TexturePayloadFormat>(payloadFormatValue);
    candidate.m_alphaMode = cast<TextureAlphaMode>(alphaModeValue);
    candidate.m_alphaConstantUnorm8 = alphaConstantUnorm8;
    candidate.m_mipLevels = mipLevels;
    candidate.m_payloadBytes = payloadBytes;
    if(!candidate.validatePayload())
        return false;
    this = candidate;
    return true;
}

u64 Texture::primaryPayloadByteCount()const{
    return ComputeTexturePrimaryPayloadByteCount(this.m_mipLevels);
}

Span<u8> Texture::alphaUastcBlocks()const{
    const Expected<usize> offset = TryResolveSeparateAlphaUastcByteOffset(
        this.m_alphaMode == TextureAlphaMode::SeparateUastcLdr4x4,
        this.m_mipLevels,
        this.m_payloadBytes.size()
    );
    if(!offset.has_value())
        return Span<u8>();
    const Span<u8> payloadView = this.m_payloadBytes;
    return payloadView.subspan(offset.value());
}


