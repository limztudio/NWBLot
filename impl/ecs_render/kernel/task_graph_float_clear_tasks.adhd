class FloatTextureClearGraphTask{
    private GpuGraphResourceId m_destination;
    private TextureSubresourceSet m_subresources;
    private Color m_value;

    public FloatTextureClearGraphTask(in GpuGraphResourceId destination, in TextureSubresourceSet subresources, in Color value){
        this.m_destination = destination;
        this.m_subresources = subresources;
        this.m_value = value;
    }

    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements commands;
        commands.alternativeCapabilities = GpuQueueCapability::Graphics | GpuQueueCapability::Compute;
        return commands;
    }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        GpuClearTextureTaskDesc clear;
        clear.destination = this.m_destination;
        clear.subresources = this.m_subresources;
        clear.valueType = GpuClearTextureTaskValueType::Float;
        clear.floatValue = this.m_value;
        return VisitGpuTaskTexture(context.declarations, this.m_destination, lambda[in clear, in context, mut commandList](mut RhiTexture texture) -> b8{
            if(commandList.isRenderPassActive())
                return false;
            if(!CaptureGpuTaskCommandsIfEnabled(context, lambda[in context, in clear](mut GpuCommandIrCapture capture) -> b8{
                return capture.captureClearTexture(context.task, context.packet, context.queue, clear.destination, clear);
            }))
                return false;
            commandList.clearTextureFloat(texture, clear.subresources, clear.floatValue);
            return true;
        });
    }
}


[cpp_unwind]
Expected<GpuTaskId> AddFloatTextureClearTask(
    mut GpuTaskGraph graph,
    in GpuTaskDesc desc,
    in GpuGraphResourceId destination,
    in TextureSubresourceSet subresources,
    in Color value
){
    return graph.addPayloadTask(desc, FloatTextureClearGraphTask(destination, subresources, value));
}


