////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_mesh/payload_validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MeshBinaryCodec{
    private b8 appendStreams(
        in Span<f32x3u> positions,
        in Span<f16x4u> normals,
        in Span<f16x4u> tangents,
        in Span<f32x2u> uv0,
        in Span<f16x4u> colors,
        in Span<MeshletDesc> meshlets,
        in Span<MeshletBounds> meshletBounds,
        in Span<u8> meshletPositionRefDeltas,
        in Span<u8> meshletAttributeRefDeltas,
        in Span<MeshletLocalVertexRef> meshletLocalVertexRefs,
        in Span<u8> meshletPrimitiveIndices,
        in Span<u32> solidTriangleWords,
        mut Vector<u8> outBinary
    )const{
        const MeshBinaryHeader header = MakeMeshBinaryHeader(
            positions.size(),
            normals.size(),
            tangents.size(),
            uv0.size(),
            colors.size(),
            meshlets.size(),
            meshletBounds.size(),
            meshletPositionRefDeltas.size(),
            meshletAttributeRefDeltas.size(),
            meshletLocalVertexRefs.size(),
            meshletPrimitiveIndices.size()
        );
        AppendPOD(outBinary, header);
        return
            AppendBinaryVectorPayload(outBinary, positions).has_value()
            && AppendBinaryVectorPayload(outBinary, normals).has_value()
            && AppendBinaryVectorPayload(outBinary, tangents).has_value()
            && AppendBinaryVectorPayload(outBinary, uv0).has_value()
            && AppendBinaryVectorPayload(outBinary, colors).has_value()
            && AppendBinaryVectorPayload(outBinary, meshlets).has_value()
            && AppendBinaryVectorPayload(outBinary, meshletBounds).has_value()
            && AppendBinaryVectorPayload(outBinary, meshletPositionRefDeltas).has_value()
            && AppendBinaryVectorPayload(outBinary, meshletAttributeRefDeltas).has_value()
            && AppendBinaryVectorPayload(outBinary, meshletLocalVertexRefs).has_value()
            && AppendBinaryVectorPayload(outBinary, meshletPrimitiveIndices).has_value()
            && AppendBinaryVectorPayload(outBinary, solidTriangleWords).has_value()
        ;
    }

    public b8 deserialize(
        in Span<u8> binary,
        mut Vector<f32x3u> outPositions,
        mut Vector<f16x4u> outNormals,
        mut Vector<f16x4u> outTangents,
        mut Vector<f32x2u> outUv0,
        mut Vector<f16x4u> outColors,
        mut Vector<MeshletDesc> outMeshlets,
        mut Vector<MeshletBounds> outMeshletBounds,
        mut Vector<u8> outMeshletPositionRefDeltas,
        mut Vector<u8> outMeshletAttributeRefDeltas,
        mut Vector<MeshletLocalVertexRef> outMeshletLocalVertexRefs,
        mut Vector<u8> outMeshletPrimitiveIndices,
        mut Vector<u32> outSolidTriangleWords
    )const{
        usize cursor = 0u;
        const Expected<MeshBinaryHeader> headerResult = ReadMagicHeaderPayload<MeshBinaryHeader>(binary, s_MeshBinaryMagic, "Mesh::loadBinary", "mesh", cursor);
        if(!headerResult.has_value())
            return false;
        const MeshBinaryHeader header = headerResult.value();
        if(!ValidateMeshBaseHeader(header))
            return false;

        if(
            !ReadVectorPayload(binary, header.positionCount, "Mesh::loadBinary", "positions", cursor, outPositions)
            || !ReadVectorPayload(binary, header.normalCount, "Mesh::loadBinary", "normals", cursor, outNormals)
            || !ReadVectorPayload(binary, header.tangentCount, "Mesh::loadBinary", "tangents", cursor, outTangents)
            || !ReadVectorPayload(binary, header.uv0Count, "Mesh::loadBinary", "uv0", cursor, outUv0)
            || !ReadVectorPayload(binary, header.colorCount, "Mesh::loadBinary", "colors", cursor, outColors)
            || !ReadVectorPayload(binary, header.meshletCount, "Mesh::loadBinary", "meshlets", cursor, outMeshlets)
            || !ReadVectorPayload(binary, header.meshletBoundCount, "Mesh::loadBinary", "meshlet bounds", cursor, outMeshletBounds)
            || !ReadVectorPayload(binary, header.meshletPositionRefDeltaByteCount, "Mesh::loadBinary", "meshlet position ref deltas", cursor, outMeshletPositionRefDeltas)
            || !ReadVectorPayload(binary, header.meshletAttributeRefDeltaByteCount, "Mesh::loadBinary", "meshlet attribute ref deltas", cursor, outMeshletAttributeRefDeltas)
            || !ReadVectorPayload(binary, header.meshletLocalVertexRefCount, "Mesh::loadBinary", "meshlet local vertex refs", cursor, outMeshletLocalVertexRefs)
            || !ReadVectorPayload(binary, header.meshletPrimitiveIndexCount, "Mesh::loadBinary", "meshlet primitive indices", cursor, outMeshletPrimitiveIndices)
            || !ReadVectorPayload(binary, ComputeMeshSolidTriangleWordCount(header.meshletPrimitiveIndexCount), "Mesh::loadBinary", "solid triangle words", cursor, outSolidTriangleWords)
        )
            return false;

        return ReadCompletePayload(binary, cursor, "Mesh::loadBinary");
    }

    public b8 serialize(
        in Span<f32x3u> positions,
        in Span<f16x4u> normals,
        in Span<f16x4u> tangents,
        in Span<f32x2u> uv0,
        in Span<f16x4u> colors,
        in Span<MeshletDesc> meshlets,
        in Span<MeshletBounds> meshletBounds,
        in Span<u8> meshletPositionRefDeltas,
        in Span<u8> meshletAttributeRefDeltas,
        in Span<MeshletLocalVertexRef> meshletLocalVertexRefs,
        in Span<u8> meshletPrimitiveIndices,
        in Span<u32> solidTriangleWords,
        mut Vector<u8> outBinary
    )const{
        usize reserveBytes = s_MeshBinaryHeaderBytes;
        const b8 canReserve =
            AddBinaryRepeatedReserveBytes(reserveBytes, positions.size(), s_MeshPositionElementBytes)
            && AddBinaryRepeatedReserveBytes(reserveBytes, normals.size(), s_MeshHalf4ElementBytes)
            && AddBinaryRepeatedReserveBytes(reserveBytes, tangents.size(), s_MeshHalf4ElementBytes)
            && AddBinaryRepeatedReserveBytes(reserveBytes, uv0.size(), s_MeshUv0ElementBytes)
            && AddBinaryRepeatedReserveBytes(reserveBytes, colors.size(), s_MeshHalf4ElementBytes)
            && AddBinaryRepeatedReserveBytes(reserveBytes, meshlets.size(), s_MeshletDescElementBytes)
            && AddBinaryRepeatedReserveBytes(reserveBytes, meshletBounds.size(), s_MeshletBoundsElementBytes)
            && AddBinaryReserveBytes(reserveBytes, meshletPositionRefDeltas.size())
            && AddBinaryReserveBytes(reserveBytes, meshletAttributeRefDeltas.size())
            && AddBinaryRepeatedReserveBytes(reserveBytes, meshletLocalVertexRefs.size(), s_MeshletLocalVertexRefElementBytes)
            && AddBinaryReserveBytes(reserveBytes, meshletPrimitiveIndices.size())
            && AddBinaryRepeatedReserveBytes(reserveBytes, solidTriangleWords.size(), s_MeshSolidTriangleWordElementBytes)
            && CanStoreValueCount(outBinary, reserveBytes)
        ;
        if(!canReserve){
            error("MeshAssetCodec::serialize failed: mesh payload byte size overflows");
            return false;
        }

        outBinary.clear();
        outBinary.reserve(reserveBytes);
        return this.appendStreams(
            positions,
            normals,
            tangents,
            uv0,
            colors,
            meshlets,
            meshletBounds,
            meshletPositionRefDeltas,
            meshletAttributeRefDeltas,
            meshletLocalVertexRefs,
            meshletPrimitiveIndices,
            solidTriangleWords,
            outBinary
        );
    }
}


