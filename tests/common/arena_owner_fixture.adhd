#include "gtest_macros.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ExpectMemoryStatsEqual(in ArenaMemoryStats expected, in ArenaMemoryStats actual){
    EXPECT_EQ(actual.reservedBytes, expected.reservedBytes);
    EXPECT_EQ(actual.usedBytes, expected.usedBytes);
    EXPECT_EQ(actual.peakUsedBytes, expected.peakUsedBytes);
    EXPECT_EQ(actual.allocationCount, expected.allocationCount);
    EXPECT_EQ(actual.reallocationCount, expected.reallocationCount);
    EXPECT_EQ(actual.deallocationCount, expected.deallocationCount);
}

b8 TryReadOwnerStats(in Name name, in ArenaMemorySource source, mut ArenaMemoryStats outStats){
    ArenaMemoryOwnerCursor owners;
    ArenaMemoryOwnerSnapshot snapshot;
    while(owners.next(snapshot)){
        if(snapshot.ownerName == name && snapshot.source == source){
            outStats = snapshot.stats;
            return true;
        }
    }
    return false;
}

b8 TryReadOwnerStats(in Name name, mut ArenaMemoryStats outStats){
    return TryReadOwnerStats(name, ArenaMemorySource::Arena, outStats);
}

ArenaMemoryStats OwnerStats(in Name name, in ArenaMemorySource source){
    ArenaMemoryStats stats = ArenaMemoryStats();
    TryReadOwnerStats(name, source, stats);
    return stats;
}

ArenaMemoryStats OwnerStats(in Name name){
    return OwnerStats(name, ArenaMemorySource::Arena);
}


