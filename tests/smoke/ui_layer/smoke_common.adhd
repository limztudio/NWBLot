Point MakeSmokePoint(in f32 x, in f32 y){
    Point point();
    point.x = x;
    point.y = y;
    return point;
}

EdgeInsets MakeUniformSmokeInsets(in f32 value){
    EdgeInsets insets();
    insets.left = value;
    insets.top = value;
    insets.right = value;
    insets.bottom = value;
    return insets;
}

WidgetOptions MakeFixedHeightSmokeWidget(in f32 height){
    WidgetOptions options();
    options.height.policy = LayoutSizePolicy::Fixed;
    options.height.value = height;
    return options;
}

WidgetOptions MakeFixedSmokeWidget(in f32 width, in f32 height){
    WidgetOptions options();
    options.width.policy = LayoutSizePolicy::Fixed;
    options.width.value = width;
    options.height.policy = LayoutSizePolicy::Fixed;
    options.height.value = height;
    return options;
}

WidgetOptions MakeFixedEnabledSmokeWidget(in f32 width, in f32 height, in b8 enabled){
    WidgetOptions options = MakeFixedSmokeWidget(width, height);
    options.enabled = enabled;
    return options;
}

WidgetOptions MakeStretchWidthSmokeWidget(in f32 height){
    WidgetOptions options();
    options.width.policy = LayoutSizePolicy::Stretch;
    options.width.value = 1.0f;
    options.height.policy = LayoutSizePolicy::Fixed;
    options.height.value = height;
    return options;
}

// Admit only marker grids whose integer coordinates are exact in FP32.
Array<f32, Count> BuildSmokeMarkerPositions<const usize Count>(in u32 origin, in u32 step){
    const u32 exactIntegerLimit = 16777216u;
    [essential] assert(Count > 0u && step > 0u, "Smoke marker grid requires positive count and step");
    [essential] assert(origin <= exactIntegerLimit && step <= exactIntegerLimit && Count - 1u <= cast<usize>((exactIntegerLimit - origin) / step), "Smoke marker grid exceeds exact FP32 integer limit");

    Array<f32, Count> positions;
    const VectorSingle stepVec(cast<f32>(step));
    const VectorSingle originVec(cast<f32>(origin));
    usize index = 0u;
    while(index < Count){
        usize idx1 = Count - 1u;
        if(index + 1u < Count)
            idx1 = index + 1u;
        usize idx2 = Count - 1u;
        if(index + 2u < Count)
            idx2 = index + 2u;
        usize idx3 = Count - 1u;
        if(index + 3u < Count)
            idx3 = index + 3u;
        const VectorSingle indices(cast<f32>(index), cast<f32>(idx1), cast<f32>(idx2), cast<f32>(idx3));
        const VectorSingle coordinates = indices * stepVec + originVec;
        positions[index] = coordinates.x;
        if(index + 1u < Count)
            positions[index + 1u] = coordinates.y;
        if(index + 2u < Count)
            positions[index + 2u] = coordinates.z;
        if(index + 3u < Count)
            positions[index + 3u] = coordinates.w;
        index += 4u;
    }
    return positions;
}

// Reconstruct a single-line fixture's selection from the canonical geometry for its framebuffer probe.
Rect CaptureEditSelection(mut EditBoxView view, mut TextService text, in EditModel model, in EditBoxPlacement placement, in f32 fontSize){
    [essential] assert(model.textMode() == EditTextMode::SingleLine, "Single-line edit selection capture expected");
    const b8 captured = view.snapshot(model);
    [essential] assert(captured, "Edit box snapshot failed");
    const EditBoxRange range = view.selectionRange();
    if(range.begin == range.end || placement.content.width <= 0.0f || placement.content.height <= 0.0f)
        return Rect();
    b8 shaped = false;
    Rect selection();
    b8 hasSelection = false;
    native(mut view, mut text, in fontSize, in range, in placement, mut shaped, mut selection, mut hasSelection){
        shaped = view.shape(text, { .fontSize = fontSize }) == Impl::Ui::TextLayoutStatus::Success;
        if(shaped){
            const auto candidate = view.caretGeometry().rangeOnLine(range, 0u, placement.caret.width);
            if(candidate.has_value()){
                hasSelection = true;
                selection = *candidate;
            }
        }
    }
    [essential] assert(shaped && hasSelection, "Edit box shaping or selection range query failed");
    if(selection.width > 0.0f){
        const VectorSingle origin = VectorSingle(selection.x, selection.y, 0.0f, 0.0f) + VectorSingle(placement.textOrigin.x, placement.textOrigin.y, 0.0f, 0.0f);
        selection.x = origin.x;
        selection.y = origin.y;
    }
    return selection;
}

Rect CaptureEditSelection(mut GlobalArena arena, mut TextService text, in EditModel model, in EditBoxPlacement placement, in f32 fontSize){
    EditBoxView view(arena);
    return CaptureEditSelection(view, text, model, placement, fontSize);
}

// Compute expected row height from the accepted content extent.
Expected<Rect> SmokeListRowBounds(in ScrollPlacement placement, in u64 index){
    if(placement.rowCount == 0u)
        return MakeUnexpected(Failure());
    const f32 height = cast<f32>(cast<f64>(placement.contentHeight) / cast<f64>(placement.rowCount));
    return CalculateScrollRowBounds(index, placement, height);
}

Rect VisibleSmokeListRow(in ScrollPlacement placement, in u64 index){
    const Expected<Rect> rectangle = SmokeListRowBounds(placement, index);
    if(!rectangle.has_value())
        return Rect();
    const Expected<Rect> visible = TryIntersectUiRects(rectangle.value(), placement.contentClip, UiRectPrecision::PreciseExtents);
    if(visible.has_value())
        return visible.value();
    return Rect();
}

void LogSmokeRect(in StringView tag, in u64 sequence, in StringView name, in Rect rectangle){
    [essential] info(
        "{}: geometry sequence={} {}={},{},{},{}"
        , tag
        , sequence
        , name
        , rectangle.x
        , rectangle.y
        , rectangle.width
        , rectangle.height
    );
}

void LogSmokeRect(in StringView tag, in u32 sequence, in StringView name, in Rect rectangle){
    LogSmokeRect(tag, cast<u64>(sequence), name, rectangle);
}

void ObserveSmokeDisplay(in StringView tag, in DisplayMetrics display, mut DisplayMetrics inOutLastDisplay, mut b8 inOutDisplayChanged){
    if(
        inOutLastDisplay.logicalWidth == display.logicalWidth
        && inOutLastDisplay.logicalHeight == display.logicalHeight
        && inOutLastDisplay.pixelScaleX == display.pixelScaleX
        && inOutLastDisplay.pixelScaleY == display.pixelScaleY
    )
        return;
    inOutLastDisplay = display;
    inOutDisplayChanged = true;
    [essential] info(
        "{}: display logical={}x{} scale={}x{}"
        , tag
        , display.logicalWidth
        , display.logicalHeight
        , display.pixelScaleX
        , display.pixelScaleY
    );
}

b8 SameSmokePlacement(in EditBoxPlacement left, in EditBoxPlacement right){
    return SameSmokeRect(left.bounds, right.bounds) && SameSmokeRect(left.content, right.content) && SameSmokeRect(left.caret, right.caret) && left.scroll == right.scroll;
}

void LogSmokeEditGeometry(in StringView tag, in u32 sequence, in StringView field, in EditBoxPlacement placement, in Rect selection){
    const Rect bounds = placement.bounds;
    const Rect content = placement.content;
    const Rect caret = placement.caret;
    [essential] info(
        "{}: geometry sequence={} field={} bounds={},{},{},{} content={},{},{},{}"
        , tag
        , sequence
        , field
        , bounds.x
        , bounds.y
        , bounds.width
        , bounds.height
        , content.x
        , content.y
        , content.width
        , content.height
    );
    [essential] info(
        "{}: selection sequence={} field={} caret={},{},{},{} selection={},{},{},{} scroll={}"
        , tag
        , sequence
        , field
        , caret.x
        , caret.y
        , caret.width
        , caret.height
        , selection.x
        , selection.y
        , selection.width
        , selection.height
        , placement.scroll
    );
}

PassiveSmokeTargetObservation ObservePassiveSmokeTargets(
    in InputRouter input,
    in u64 parentGeneration,
    in u64 childGeneration,
    in usize beginIndex,
    in usize endIndex,
    in usize excludedA,
    in usize excludedB,
    in usize excludedC,
    mut Span<SnapshotRect> rectangles
){
    PassiveSmokeTargetObservation observation();
    u32 rootButton = 0u;
    for(in HitTarget target : input.targets()){
        u32 code = 0u;
        if(target.activatable && !target.popup.valid() && rootButton < 2u){
            rectangles[rootButton] = target.rectangle;
            code = rootButton + 1u;
            ++rootButton;
        }
        else if(target.activatable && target.popup.instanceGeneration == parentGeneration){
            code = 3u;
        }
        else if(target.activatable && target.popup.instanceGeneration == childGeneration){
            code = 4u;
        }
        if(target.id == input.focus())
            observation.focusCode = code;
        for(usize index = beginIndex; index < endIndex; ++index){
            if(index == excludedA || index == excludedB || index == excludedC || rectangles[index].width == 0.0f)
                continue;
            if(SameSmokeRect(target.rectangle, rectangles[index]))
                ++observation.passiveTargets;
        }
    }
    return observation;
}

PassiveSmokeTargetObservation ObservePassiveSmokeTargets(
    in InputRouter input,
    in u64 parentGeneration,
    in u64 childGeneration,
    in usize beginIndex,
    in usize endIndex,
    in usize excludedIndex,
    mut Span<SnapshotRect> rectangles
){
    return ObservePassiveSmokeTargets(
        input,
        parentGeneration,
        childGeneration,
        beginIndex,
        endIndex,
        excludedIndex,
        excludedIndex,
        excludedIndex,
        rectangles
    );
}

PassiveSmokeSnapshotUpdate EvaluatePassiveSmokeSnapshotChange(
    in b8 stateChanged,
    in DisplayMetrics currentDisplay,
    in DisplayMetrics previousDisplay,
    in Span<SnapshotRect> currentRectangles,
    in Span<SnapshotRect> previousRectangles,
    in u64 previousSequence
){
    const b8 displayChanged = currentDisplay.logicalWidth != previousDisplay.logicalWidth
        || currentDisplay.logicalHeight != previousDisplay.logicalHeight
        || currentDisplay.pixelScaleX != previousDisplay.pixelScaleX
        || currentDisplay.pixelScaleY != previousDisplay.pixelScaleY;
    const b8 changed = stateChanged || !SameSmokeRectSpan(currentRectangles, previousRectangles);
    if(previousSequence != 0u && !changed && !displayChanged)
        return PassiveSmokeSnapshotUpdate();
    PassiveSmokeSnapshotUpdate update();
    update.published = true;
    update.displayChanged = displayChanged;
    return update;
}

PassiveSmokeSnapshotUpdate PublishPassiveSmokeSnapshot(in b8 stateChanged, mut UiImageSnapshot current, mut UiImageSnapshot snapshot){
    const PassiveSmokeSnapshotUpdate update = EvaluatePassiveSmokeSnapshotChange(
        stateChanged,
        current.display,
        snapshot.display,
        current.rectangles,
        snapshot.rectangles,
        snapshot.sequence
    );
    if(update.published){
        current.sequence = snapshot.sequence + 1u;
        snapshot = current;
    }
    return update;
}

PassiveSmokeSnapshotUpdate PublishPassiveSmokeSnapshot(in b8 stateChanged, mut UiProgressSnapshot current, mut UiProgressSnapshot snapshot){
    const PassiveSmokeSnapshotUpdate update = EvaluatePassiveSmokeSnapshotChange(
        stateChanged,
        current.display,
        snapshot.display,
        current.rectangles,
        snapshot.rectangles,
        snapshot.sequence
    );
    if(update.published){
        current.sequence = snapshot.sequence + 1u;
        snapshot = current;
    }
    return update;
}

PassiveSmokeSnapshotUpdate PublishPassiveSmokeSnapshot(in b8 stateChanged, mut UiTextureImageSnapshot current, mut UiTextureImageSnapshot snapshot){
    const PassiveSmokeSnapshotUpdate update = EvaluatePassiveSmokeSnapshotChange(
        stateChanged,
        current.display,
        snapshot.display,
        current.rectangles,
        snapshot.rectangles,
        snapshot.sequence
    );
    if(update.published){
        current.sequence = snapshot.sequence + 1u;
        snapshot = current;
    }
    return update;
}

b8 HandlePassiveSmokeKeyboard(in i32 key, in i32 action, mut b8 phase, mut PopupState parent, mut PopupState child){
    if(key != s_SmokeKeyF4 && key != s_SmokeKeyF5)
        return false;
    if(action != s_SmokeActionPress)
        return true;
    if(key == s_SmokeKeyF4){
        phase = !phase;
    }
    else if(parent.isOpen()){
        child.close();
        parent.close();
    }
    else{
        parent.open();
        child.open();
    }
    return true;
}

void PaintSingleSmokeValueMarkers(in Span<u32> values, in u32 sequence, mut UiPaintContext context){
    const f32 y = context.display.logicalHeight - 20.0f;
    for(usize index = 0u; index <= values.size(); ++index){
        u32 value = sequence;
        if(index < values.size())
            value = values[index];
        const f32 x = cast<f32>(12u + cast<u32>(index) * 20u);
        context.paint.fillRect(Rect(x, y, 14.0f, 12.0f), EncodeSmokeColor(value));
    }
}

void PaintKeyedSmokeValueMarkers(
    in Span<u64> values,
    in u64 sequence,
    in u32 step,
    in u32 width,
    in u32 height,
    in u32 bottomOffset,
    mut UiPaintContext context
){
    const f32 y = context.display.logicalHeight - cast<f32>(bottomOffset);
    const f32 w = cast<f32>(width);
    const f32 h = cast<f32>(height);
    for(usize index = 0u; index <= values.size(); ++index){
        u64 value = sequence;
        if(index < values.size())
            value = values[index];
        for(u32 part = 0u; part < 2u; ++part){
            const usize marker = index * 2u + cast<usize>(part);
            const f32 x = cast<f32>(12u + cast<u32>(marker) * step);
            context.paint.fillRect(Rect(x, y, w, h), EncodeSmokeColor(value >> (part * 12u)));
        }
    }
}

void PaintKeyedSmokeValueMarkersDefault(in Span<u64> values, in u64 sequence, in u32 step, in u32 width, mut UiPaintContext context){
    PaintKeyedSmokeValueMarkers(values, sequence, step, width, 12u, 20u, context);
}

void PaintPassiveSmokeValueMarkers(in Span<u64> values, in u64 sequence, mut UiPaintContext context){
    PaintKeyedSmokeValueMarkers(values, sequence, 12u, 8u, 8u, 18u, context);
}

// Progress, slider, and image snapshots paint one 12-bit marker swatch per value part plus sequence swatches along the bottom edge.
void PaintSmokeValueMarkers(in Span<u64> values, in Span<u64> bits, in u64 sequence, mut UiPaintContext context){
    const f32 y = context.display.logicalHeight - 18.0f;
    u32 marker = 0u;
    for(in u64 value : values){
        for(u32 part = 0u; part < 2u; ++part){
            const f32 x = cast<f32>(12u + marker * 12u);
            context.paint.fillRect(Rect(x, y, 8.0f, 8.0f), EncodeSmokeColor(value >> (part * 12u)));
            ++marker;
        }
    }
    for(in u64 bit : bits){
        for(u32 part = 0u; part < 6u; ++part){
            const f32 x = cast<f32>(12u + marker * 12u);
            context.paint.fillRect(Rect(x, y, 8.0f, 8.0f), EncodeSmokeColor(bit >> (part * 12u)));
            ++marker;
        }
    }
    for(u32 part = 0u; part < 2u; ++part){
        const f32 x = cast<f32>(12u + marker * 12u);
        context.paint.fillRect(Rect(x, y, 8.0f, 8.0f), EncodeSmokeColor(sequence >> (part * 12u)));
        ++marker;
    }
}

void PaintUiLayerSmokeScene(mut UiPaintContext context){
    const VectorSingle extent(context.display.logicalWidth, context.display.logicalHeight, context.display.logicalWidth, context.display.logicalHeight);

    context.paint.fillRect(ScaleSmokeSceneRect(extent, 0.04f, 0.08f, 0.28f, 0.20f), Color(0.0f, 0.0f, 1.0f, 1.0f));
    context.paint.fillRect(ScaleSmokeSceneRect(extent, 0.12f, 0.12f, 0.20f, 0.12f), Color(1.0f, 0.0f, 0.0f, 0.5f));
    context.paint.fillRect(ScaleSmokeSceneRect(extent, 0.34f, 0.08f, 0.16f, 0.20f), Color(1.0f, 0.0f, 0.0f, 0.5f));
    context.paint.fillRect(ScaleSmokeSceneRect(extent, 0.54f, 0.08f, 0.18f, 0.20f), Color(0.25f, 0.25f, 0.25f, 1.0f));
    if(!context.paint.drawRegion(s_UiSmokeNameWhite, ScaleSmokeSceneRect(extent, 0.76f, 0.08f, 0.20f, 0.20f), Color(0.1f, 0.8f, 0.2f, 0.5f))){
        error("UiLayerSmokeProject: white sprite is absent from the default atlas");
        return;
    }

    context.paint.fillRect(ScaleSmokeSceneRect(extent, 0.04f, 0.38f, 0.28f, 0.26f), Color(0.0f, 0.2f, 0.3f, 1.0f));
    context.paint.pushClip(ScaleSmokeSceneRect(extent, 0.10f, 0.44f, 0.16f, 0.12f));
    context.paint.fillRect(ScaleSmokeSceneRect(extent, 0.04f, 0.38f, 0.28f, 0.26f), Color(0.0f, 1.0f, 0.0f, 1.0f));
    context.paint.pushClip(ScaleSmokeSceneRect(extent, 0.14f, 0.42f, 0.16f, 0.16f));
    context.paint.fillRect(ScaleSmokeSceneRect(extent, 0.04f, 0.38f, 0.28f, 0.26f), Color(1.0f, 0.0f, 0.0f, 1.0f));
    if(!context.paint.popClip() || !context.paint.popClip()){
        error("UiLayerSmokeProject: nested clip stack became unbalanced");
        return;
    }

    if(
        !context.paint.drawRegion(s_UiSmokeNamePanelNormal, ScaleSmokeSceneRect(extent, 0.36f, 0.40f, 0.26f, 0.24f))
        || !context.paint.drawRegion(s_UiSmokeNameButtonNormal, ScaleSmokeSceneRect(extent, 0.66f, 0.40f, 0.13f, 0.14f))
        || !context.paint.drawRegion(s_UiSmokeNameButtonHover, ScaleSmokeSceneRect(extent, 0.82f, 0.40f, 0.14f, 0.14f))
    ){
        error("UiLayerSmokeProject: named nine-slice regions are absent from the default atlas");
        return;
    }

    context.paint.fillRect(ScaleSmokeSceneRect(extent, 0.64f, 0.64f, 0.16f, 0.16f), Color(0.0f, 0.1f, 0.2f, 1.0f));
    if(!context.paint.drawRegion(s_UiSmokeNameComboArrow, ScaleSmokeSceneRect(extent, 0.68f, 0.68f, 0.08f, 0.08f)))
        error("UiLayerSmokeProject: combo arrow sprite is absent from the default atlas");
}


