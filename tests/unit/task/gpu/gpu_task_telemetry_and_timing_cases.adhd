using GpuTelemetryResourceStateMask = Core::ResourceStates::Mask;
using GpuTelemetryAssignmentVector = Core::GraphicsVector<Core::GpuTaskQueueAssignment>;
using GpuTelemetryU32Vector = Core::GraphicsVector<u32>;
