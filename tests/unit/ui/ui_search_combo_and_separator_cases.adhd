    native(in self){
        EXPECT_EQ(self.target(self.query()), nullptr);
    }
}

void VerifyUiSearchComboBuilderTests_PlainToSearchSwitchRetiresTheOldPopupAndReopensWithEditorFocus(mut UiSearchComboBuilderTests self){
    self.m_search.combo().select(1u);
    self.m_search.combo().open();
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(10.0f, 10.0f, 320.0f, 280.0f)));
    ASSERT_TRUE(self.m_builder.comboBox(s_UiSearchComboKey, self.m_searchSource, self.m_search.combo(), UiSearchComboFixtureOptions().combo).valid);
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    PopupToken oldPopup = PopupToken();
    u64 oldDeclaration = 0u;
    native(in self, mut oldPopup, mut oldDeclaration){
        ASSERT_NE(self.target(self.list()), nullptr);
        ASSERT_NE(self.target(self.popup()), nullptr);
        ASSERT_NE(self.target(self.id("combo", "panel")), nullptr);
        oldPopup = self.target(self.popup())->popup;
        oldDeclaration = self.target(self.id("combo", "panel"))->declarationGeneration;
    }
    EXPECT_EQ(self.m_context.input().focus(), self.list());
    self.press(UiSearchComboKey::Down);
    ASSERT_TRUE(self.acceptSearch(2u));
    EXPECT_TRUE(self.m_searchResult.combo.closed);
    EXPECT_FALSE(self.m_searchResult.combo.committed);
    EXPECT_FALSE(self.m_search.combo().isOpen());
    EXPECT_EQ(self.m_search.combo().selectedKey(), 1u);
    native(in self, in oldDeclaration){
        ASSERT_NE(self.target(self.id("combo", "panel")), nullptr);
        EXPECT_NE(self.target(self.id("combo", "panel"))->declarationGeneration, oldDeclaration);
        EXPECT_EQ(self.target(self.popup()), nullptr);
    }
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
    ASSERT_TRUE(self.openSearch(3u));
    native(in self, in oldPopup){
        ASSERT_NE(self.target(self.query()), nullptr);
        ASSERT_NE(self.target(self.popup()), nullptr);
        EXPECT_NE(self.target(self.popup())->popup, oldPopup);
    }
    EXPECT_EQ(self.m_context.input().focus(), self.query());
    EXPECT_EQ(self.m_search.combo().listState().cursorKey(), 1u);
}

void VerifyUiSearchComboBuilderTests_SearchToPlainSwitchRetiresTheEditorAndCannotReplayItsQueuedSubmit(mut UiSearchComboBuilderTests self){
    self.m_search.combo().select(1u);
    self.m_search.combo().open();
    ASSERT_TRUE(self.acceptSearch(1u));
    EXPECT_EQ(self.m_context.input().focus(), self.query());
    PopupToken oldPopup = PopupToken();
    native(in self, mut oldPopup){
        ASSERT_NE(self.target(self.popup()), nullptr);
        oldPopup = self.target(self.popup())->popup;
    }
    self.press(UiSearchComboKey::Down);
    self.press(UiSearchComboKey::Enter);
    ASSERT_FALSE(self.m_context.input().controlActions().empty());
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(10.0f, 10.0f, 320.0f, 280.0f)));
    const ComboResult switched = self.m_builder.comboBox(s_UiSearchComboKey, self.m_searchSource, self.m_search.combo(), UiSearchComboFixtureOptions().combo);
    EXPECT_TRUE(switched.valid);
    EXPECT_TRUE(switched.closed);
    EXPECT_FALSE(switched.committed);
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_FALSE(self.m_search.combo().isOpen());
    EXPECT_EQ(self.m_search.combo().selectedKey(), 1u);
    Rect comboRect = Rect();
    native(in self, mut comboRect){
        EXPECT_EQ(self.target(self.query()), nullptr);
        EXPECT_EQ(self.target(self.popup()), nullptr);
        ASSERT_NE(self.target(self.id("combo", "panel")), nullptr);
        comboRect = self.target(self.id("combo", "panel"))->rectangle;
    }
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
    self.click(CenterUiRect(comboRect));
    ASSERT_TRUE(self.begin(3u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(10.0f, 10.0f, 320.0f, 280.0f)));
    const ComboResult reopened = self.m_builder.comboBox(s_UiSearchComboKey, self.m_searchSource, self.m_search.combo(), UiSearchComboFixtureOptions().combo);
    EXPECT_TRUE(reopened.valid);
    EXPECT_TRUE(reopened.opened);
    EXPECT_FALSE(reopened.committed);
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    native(in self, in oldPopup){
        EXPECT_EQ(self.target(self.query()), nullptr);
        ASSERT_NE(self.target(self.popup()), nullptr);
        EXPECT_NE(self.target(self.popup())->popup, oldPopup);
    }
    EXPECT_EQ(self.m_context.input().focus(), self.list());
    EXPECT_EQ(self.m_search.combo().selectedKey(), 1u);
    EXPECT_EQ(self.m_search.combo().listState().cursorKey(), 1u);
}

void VerifyUiSearchComboBuilderTests_CancelledPopupRetiresEditorFocusWhileKeepingQueryAndCommittedKey(mut UiSearchComboBuilderTests self){
    self.m_search.combo().select(1u);
    ASSERT_TRUE(self.m_search.query().setText("First"));
    ASSERT_TRUE(self.acceptSearch(1u));
    ASSERT_TRUE(self.openSearch(2u));
    ASSERT_TRUE(self.acceptSearch(3u));
    ASSERT_TRUE(self.m_search.editorState().focused);
    self.m_host.cancelled = true;
    ASSERT_TRUE(self.acceptSearch(4u));
    EXPECT_TRUE(self.m_searchResult.combo.closed);
    EXPECT_FALSE(self.m_search.combo().isOpen());
    EXPECT_FALSE(self.m_search.editorState().focused);
    EXPECT_EQ(self.m_search.combo().selectedKey(), 1u);
    EXPECT_EQ(self.m_search.query().text(), "First");
    native(in self){
        EXPECT_EQ(self.target(self.query()), nullptr);
    }
}


