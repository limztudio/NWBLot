void BuildTestFrameGraph(mut TelemetryArena arena, mut FrameGraphNodeDescs nodes, mut FrameGraphEdgeDescs edges){
    nodes = FrameGraphNodeDescs(arena);
    edges = FrameGraphEdgeDescs(arena);

    FrameGraphNodeDesc gbufferNode = FrameGraphNodeDesc();
    gbufferNode.name = s_Gbuffer;
    gbufferNode.label = "GBuffer Pass";
    gbufferNode.kind = FrameGraphNodeKind::Pass;
    gbufferNode.flags = 1u;
    nodes.push_back(gbufferNode);

    FrameGraphNodeDesc albedoNode = FrameGraphNodeDesc();
    albedoNode.name = s_Albedo;
    albedoNode.label = "Albedo Texture";
    albedoNode.kind = FrameGraphNodeKind::Resource;
    albedoNode.flags = 0u;
    nodes.push_back(albedoNode);

    FrameGraphNodeDesc lightingNode = FrameGraphNodeDesc();
    lightingNode.name = s_Lighting;
    lightingNode.label = "Lighting Pass";
    lightingNode.kind = FrameGraphNodeKind::Pass;
    lightingNode.flags = 0u;
    nodes.push_back(lightingNode);

    FrameGraphEdgeDesc writeEdge = FrameGraphEdgeDesc();
    writeEdge.fromNodeIndex = 0u;
    writeEdge.toNodeIndex = 1u;
    writeEdge.kind = FrameGraphEdgeKind::Writes;
    edges.push_back(writeEdge);

    FrameGraphEdgeDesc readEdge = FrameGraphEdgeDesc();
    readEdge.fromNodeIndex = 1u;
    readEdge.toNodeIndex = 2u;
    readEdge.kind = FrameGraphEdgeKind::Reads;
    readEdge.flags = 2u;
    edges.push_back(readEdge);
}

FrameGraphQueueAssignment MakeChangedFrameGraphQueueAssignment(){
    FrameGraphQueueAssignment assignment = FrameGraphQueueAssignment();
    assignment.initialQueue.index = 1u;
    assignment.initialQueue.deviceGeneration = 17u;
    assignment.plannedQueue.index = 3u;
    assignment.plannedQueue.deviceGeneration = 17u;
    assignment.acceptedQueue = assignment.plannedQueue;
    assignment.previousAcceptedQueue.index = 2u;
    assignment.previousAcceptedQueue.deviceGeneration = 17u;
    assignment.score.overlap = 7;
    assignment.score.queueLoad = 3;
    assignment.score.incomingCrossings = 2;
    assignment.score.outgoingCrossings = 1;
    assignment.score.ownershipTransfers = 4;
    assignment.score.total = -3;
    assignment.queueClass = FrameGraphQueueClass::Compute;
    assignment.reason = FrameGraphQueueAssignmentReason::Scored;
    assignment.modifiers = FrameGraphQueueAssignmentModifier::All;
    assignment.acceptance = FrameGraphQueueAssignmentAcceptance::Changed;
    assignment.dedicated = true;
    assignment.present = true;
    return assignment;
}

