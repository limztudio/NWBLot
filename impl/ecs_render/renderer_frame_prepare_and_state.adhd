#include <impl/ecs_render/reflection/statistics_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 DoesFrameTargetScaleFactorRequireRecreation(in u32 currentSurfelFactor, in u32 requestedSurfelFactor, in u32 currentShadowFactor, in u32 requestedShadowFactor){
    if(currentSurfelFactor != 0u && currentSurfelFactor != requestedSurfelFactor)
        return true;
    return currentShadowFactor != 0u && currentShadowFactor != requestedShadowFactor;
}

b8 HasFrameTargetScaleFactorMismatch(in u32 currentSurfelFactor, in u32 requestedSurfelFactor, in u32 currentShadowFactor, in u32 requestedShadowFactor){
    return currentSurfelFactor != requestedSurfelFactor || currentShadowFactor != requestedShadowFactor;
}

b8 AreDeferredFrameTargetDimensionsCurrent(in b8 targetsPresent, in u32 targetWidth, in u32 targetHeight, in u32 targetSurfelFactor, in u32 targetShadowFactor, in u32 width, in u32 height, in u32 surfelFactor, in u32 shadowFactor){
    return targetsPresent && targetWidth == width && targetHeight == height && targetSurfelFactor == surfelFactor && targetShadowFactor == shadowFactor;
}

b8 IsReflectionHardwareTraceRequested(in ReflectionTraceMode traceMode){
    return traceMode == ReflectionTraceMode::Hardware || traceMode == ReflectionTraceMode::Hybrid;
}

b8 HasTransparentCsgFrameWork(in b8 hasTransparentStaticWork, in b8 hasTransparentSkinnedWork){
    return hasTransparentStaticWork || hasTransparentSkinnedWork;
}


