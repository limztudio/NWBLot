////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_SamplerBinaryMagic = 0x53414D31u; // SAM1
const u32 s_SamplerBinaryVersion = 1u;
const usize s_SamplerHeaderBinaryByteSize = 64u;
const usize s_SamplerPackedAlignBytes = 1u;
const u32 s_SamplerMaxFilterFlag = 1u;
const u32 s_SamplerMaxAddressMode = 4u;
const u32 s_SamplerMaxReductionType = 1u;

const StringView s_SamplerMetaDiagnosticPrefix = "Sampler meta";
const StringView s_SamplerMinFilterField = "min_filter";
const StringView s_SamplerMagFilterField = "mag_filter";
const StringView s_SamplerMipFilterField = "mip_filter";
const StringView s_SamplerAddressUField = "address_u";
const StringView s_SamplerAddressVField = "address_v";
const StringView s_SamplerAddressWField = "address_w";
const StringView s_SamplerReductionField = "reduction";
const StringView s_SamplerMaxAnisotropyField = "max_anisotropy";
const StringView s_SamplerMipBiasField = "mip_bias";
const StringView s_SamplerFilterNearest = "nearest";
const StringView s_SamplerFilterLinear = "linear";
const StringView s_SamplerFilterHint = "must be 'nearest' or 'linear'";
const StringView s_SamplerAddressClamp = "clamp";
const StringView s_SamplerAddressWrap = "wrap";
const StringView s_SamplerAddressBorder = "border";
const StringView s_SamplerAddressMirror = "mirror";
const StringView s_SamplerAddressMirrorOnce = "mirror_once";
const StringView s_SamplerAddressModeHint = "has an unsupported address mode";
const StringView s_SamplerReductionStandard = "standard";
const StringView s_SamplerReductionComparison = "comparison";
const StringView s_SamplerReductionTypeHint = "has an unsupported reduction type";

[serialize]
class SamplerBinaryHeader{
    public u32 magic = s_SamplerBinaryMagic;
    public u32 version = s_SamplerBinaryVersion;
    public f32 borderColorR = 0.0f;
    public f32 borderColorG = 0.0f;
    public f32 borderColorB = 0.0f;
    public f32 borderColorA = 0.0f;
    public f32 maxAnisotropy = 1.0f;
    public f32 mipBias = 0.0f;
    public u32 minFilter = 1u;
    public u32 magFilter = 1u;
    public u32 mipFilter = 1u;
    public u32 addressU = 0u;
    public u32 addressV = 0u;
    public u32 addressW = 0u;
    public u32 reductionType = 0u;
    public u32 reserved = 0u;
}

SamplerBinaryHeader MakeSamplerBinaryHeader(
    in f32 borderColorR,
    in f32 borderColorG,
    in f32 borderColorB,
    in f32 borderColorA,
    in f32 maxAnisotropy,
    in f32 mipBias,
    in b8 minFilter,
    in b8 magFilter,
    in b8 mipFilter,
    in u32 addressU,
    in u32 addressV,
    in u32 addressW,
    in u32 reductionType
){
    SamplerBinaryHeader header;
    header.borderColorR = borderColorR;
    header.borderColorG = borderColorG;
    header.borderColorB = borderColorB;
    header.borderColorA = borderColorA;
    header.maxAnisotropy = maxAnisotropy;
    header.mipBias = mipBias;
    if(minFilter)
        header.minFilter = 1u;
    else
        header.minFilter = 0u;
    if(magFilter)
        header.magFilter = 1u;
    else
        header.magFilter = 0u;
    if(mipFilter)
        header.mipFilter = 1u;
    else
        header.mipFilter = 0u;
    header.addressU = addressU;
    header.addressV = addressV;
    header.addressW = addressW;
    header.reductionType = reductionType;
    return header;
}

b8 IsValidSamplerBinaryHeader(in SamplerBinaryHeader header){
    return
        header.reserved == 0u
        && header.minFilter <= s_SamplerMaxFilterFlag
        && header.magFilter <= s_SamplerMaxFilterFlag
        && header.mipFilter <= s_SamplerMaxFilterFlag
        && header.addressU <= s_SamplerMaxAddressMode
        && header.addressV <= s_SamplerMaxAddressMode
        && header.addressW <= s_SamplerMaxAddressMode
        && header.reductionType <= s_SamplerMaxReductionType
    ;
}

b8 IsAllowedSamplerMetadataField(in StringView fieldName){
    return
        fieldName == s_SamplerMinFilterField
        || fieldName == s_SamplerMagFilterField
        || fieldName == s_SamplerMipFilterField
        || fieldName == s_SamplerAddressUField
        || fieldName == s_SamplerAddressVField
        || fieldName == s_SamplerAddressWField
        || fieldName == s_SamplerReductionField
        || fieldName == s_SamplerMaxAnisotropyField
        || fieldName == s_SamplerMipBiasField
    ;
}

b8 IsValidSamplerScalarParameters(
    in f32 borderColorR,
    in f32 borderColorG,
    in f32 borderColorB,
    in f32 borderColorA,
    in f32 maxAnisotropy,
    in f32 mipBias
){
    return
        borderColorR == 0.0f
        && borderColorG == 0.0f
        && borderColorB == 0.0f
        && borderColorA == 0.0f
        && isFinite(maxAnisotropy)
        && maxAnisotropy >= 1.0f
        && isFinite(mipBias)
    ;
}

b8 IsValidSamplerAddressModeValue(in u32 addressMode){
    return addressMode <= s_SamplerMaxAddressMode;
}

b8 IsValidSamplerReductionTypeValue(in u32 reductionType){
    return reductionType <= s_SamplerMaxReductionType;
}

b8 IsValidSamplerDescriptionParameters(
    in f32 borderColorR,
    in f32 borderColorG,
    in f32 borderColorB,
    in f32 borderColorA,
    in f32 maxAnisotropy,
    in f32 mipBias,
    in u32 addressU,
    in u32 addressV,
    in u32 addressW,
    in u32 reductionType
){
    return
        IsValidSamplerScalarParameters(
            borderColorR,
            borderColorG,
            borderColorB,
            borderColorA,
            maxAnisotropy,
            mipBias
        )
        && IsValidSamplerAddressModeValue(addressU)
        && IsValidSamplerAddressModeValue(addressV)
        && IsValidSamplerAddressModeValue(addressW)
        && IsValidSamplerReductionTypeValue(reductionType)
    ;
}

b8 ValidateSamplerBinaryHeader(in SamplerBinaryHeader header){
    if(header.version != s_SamplerBinaryVersion){
        error("Sampler::loadBinary failed: unsupported sampler version {}; recook required", header.version);
        return false;
    }
    if(!IsValidSamplerBinaryHeader(header)){
        error("Sampler::loadBinary failed: sampler header contains invalid flags");
        return false;
    }
    return true;
}

b8 ValidateSamplerDescriptionPayload(
    in Name virtualPath,
    in f32 borderColorR,
    in f32 borderColorG,
    in f32 borderColorB,
    in f32 borderColorA,
    in f32 maxAnisotropy,
    in f32 mipBias,
    in u32 addressU,
    in u32 addressV,
    in u32 addressW,
    in u32 reductionType
){
    if(IsValidSamplerDescriptionParameters(
        borderColorR,
        borderColorG,
        borderColorB,
        borderColorA,
        maxAnisotropy,
        mipBias,
        addressU,
        addressV,
        addressW,
        reductionType
    ))
        return true;

    error("Sampler::validatePayload failed: sampler '{}' has an invalid description", virtualPath.resolvedText());
    return false;
}

b8 ValidateSamplerBinaryHeaderAndDescription(in SamplerBinaryHeader header){
    if(!ValidateSamplerBinaryHeader(header))
        return false;
    if(IsValidSamplerDescriptionParameters(
        header.borderColorR,
        header.borderColorG,
        header.borderColorB,
        header.borderColorA,
        header.maxAnisotropy,
        header.mipBias,
        header.addressU,
        header.addressV,
        header.addressW,
        header.reductionType
    ))
        return true;

    error("Sampler::loadBinary failed: sampler description is invalid");
    return false;
}


