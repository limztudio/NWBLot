    public b8 rebuildCsgCollider(in EntityID entity){
        if(!entity.valid() || !this.m_world.alive(entity) || !this.m_world.hasComponent<ColliderComponent>(entity))
            return false;
        const Optional<mut ColliderComponent> colOpt = this.m_world.borrowComponent<ColliderComponent>(entity);
        if(!colOpt.has_value())
            return false;
        const b8 hasAnyPhysicsParents = AnyPhysicsHierarchyActive(this.m_world);
        if(hasAnyPhysicsParents)
            this.m_syncScratch.writeBackPoseCache.clear();
        Vector<EcsGatheredCsgCutter> gatheredCutters;
        GatherActiveEcsCsgCutters(this.m_world, this.m_csgShapeRegistry, gatheredCutters);
        const Span<EcsGatheredCsgCutter> cuttersSpan(gatheredCutters.data(), gatheredCutters.size());
        mut ColliderComponent col = colOpt.value();
        return RebuildSingleEntityCsgCollider(
            entity,
            this.m_assetManager,
            this.m_csgShapeRegistry,
            cuttersSpan,
            hasAnyPhysicsParents,
            true,
            this.m_world,
            col,
            this.m_syncScratch
        );
    }
