NWB_ADHD_GTEST(Global, CollectionSharedHelpersPreserveEdgeCases, VerifyGlobal_CollectionSharedHelpersPreserveEdgeCases)
NWB_ADHD_GTEST(Global, HashSharedHelpersPreserveEdgeCases, VerifyGlobal_HashSharedHelpersPreserveEdgeCases)
NWB_ADHD_GTEST(NoexceptFailureTests, HashResultConversionFailurePreservesCombinedSeed, VerifyNoexceptFailureTests_HashResultConversionFailurePreservesCombinedSeed)
NWB_ADHD_GTEST(NoexceptFailureTests, PlacementAllocationFailurePropagatesThroughCaptureConstructionAndReplacement, VerifyNoexceptFailureTests_PlacementAllocationFailurePropagatesThroughCaptureConstructionAndReplacement)
NWB_ADHD_GTEST(NoexceptFailureTests, ThrowingByteGetterPreservesReadOffset, VerifyNoexceptFailureTests_ThrowingByteGetterPreservesReadOffset)
NWB_ADHD_GTEST(NoexceptFailureTests, PodAddressAndMutableBufferGetterFailuresPropagateBeforeReading, VerifyNoexceptFailureTests_PodAddressAndMutableBufferGetterFailuresPropagateBeforeReading)
NWB_ADHD_GTEST(NoexceptFailureTests, BoundedDiagnosticsNeverInvokeThrowingConversionOrCleanupAdapters, VerifyNoexceptFailureTests_BoundedDiagnosticsNeverInvokeThrowingConversionOrCleanupAdapters)
NWB_ADHD_GTEST(NoexceptFailureTests, CaptureMoveTransportDoesNotReinvokeClassPlacementAllocation, VerifyNoexceptFailureTests_CaptureMoveTransportDoesNotReinvokeClassPlacementAllocation)
NWB_ADHD_GTEST(NoexceptFailureTests, FancyPointerDereferenceAndRawConversionFailuresPreserveBorrowedTarget, VerifyNoexceptFailureTests_FancyPointerDereferenceAndRawConversionFailuresPreserveBorrowedTarget)
NWB_ADHD_GTEST(NoexceptFailureTests, UniqueOwnerComparisonResultConversionUnwindsThroughEveryBooleanWrapper, VerifyNoexceptFailureTests_UniqueOwnerComparisonResultConversionUnwindsThroughEveryBooleanWrapper)
