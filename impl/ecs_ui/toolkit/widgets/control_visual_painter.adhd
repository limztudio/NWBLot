class ControlVisualPainter{
    public b8 paintBasicControlItemVisual(
        mut PaintBuilder paint,
        mut TextService text,
        in UiSkin skin,
        in WidgetKind kind,
        in WidgetStyle style,
        in TextLayout layout,
        in Rect textBounds,
        in Insets padding,
        in f32 checkboxExtent,
        in Rect rectangle,
        in Rect clip,
        in b8 enabled,
        in b8 checked,
        in b8 hover,
        in b8 pressed,
        in b8 focused,
        in b8 interactive
    ){
        paint.pushClip(clip);
        b8 painted = true;
        Point origin = Point(rectangle.x, rectangle.y);
        Rect textClip = rectangle;
        const Point measured = Point(textBounds.width, textBounds.height);
        if(kind == WidgetKind::Separator){
            painted = paint.drawRegion(style.separator, rectangle);
            const b8 sepPopped = paint.popClip();
            return painted && sepPopped;
        }
        if(kind == WidgetKind::Button){
            const Name preferred = ResolveButtonPreferredName(style, enabled, pressed, hover);
            const Expected<UiSkinRegion> skinRegion = TryResolveSelectableStateRegion(skin, preferred, style.button);
            painted = skinRegion.has_value() && paint.drawRegion(skinRegion.value().name, rectangle);
            ResolveButtonTextPlacement(rectangle, padding, measured, textClip, origin);
        }
        else if(kind == WidgetKind::Checkbox){
            const Name preferred = ResolveCheckboxPreferredName(style, enabled, checked, hover);
            const Expected<UiSkinRegion> skinRegion = TryResolveSelectableStateRegion(skin, preferred, style.checkbox);
            Rect square;
            Rect mark;
            ResolveCheckboxPlacement(rectangle, checkboxExtent, style.gap, measured, square, mark, textClip, origin);
            painted = skinRegion.has_value() && paint.drawRegion(skinRegion.value().name, square);
            if(painted && checked && skin.hasRegion(style.checkboxMark)){
                Color tint;
                if(!enabled)
                    tint = Color(1.0f, 1.0f, 1.0f, s_StyleDisabledIconAlpha);
                painted = paint.drawRegion(style.checkboxMark, mark, tint);
            }
        }
        if(painted && focused && enabled && interactive && skin.hasRegion(style.focus))
            painted = paint.drawRegion(style.focus, rectangle);
        origin = ResolveLabelPaintOrigin(Rect(origin.x, origin.y, 0.0f, 0.0f), textBounds);
        paint.pushClip(textClip);
        if(painted){
            Color activeColor = style.disabledText;
            if(enabled)
                activeColor = style.text;
            painted = text.paint(paint, layout, origin, activeColor);
        }
        const b8 textPopped = paint.popClip();
        const b8 popped = paint.popClip();
        return painted && textPopped && popped;
    }

    public b8 paintComboFieldVisual(
        mut PaintBuilder paint,
        mut TextService text,
        in UiSkin skin,
        in ComboStyle comboStyle,
        in WidgetStyle widgetStyle,
        in TextLayout layout,
        in Rect textBounds,
        in Insets padding,
        in f32 arrowExtent,
        in Rect rectangle,
        in Rect clip,
        in b8 enabled,
        in b8 open,
        in b8 focused,
        in b8 hovered
    ){
        const Name name = ResolveComboFieldRegionName(comboStyle, enabled, open, focused, hovered);
        const Expected<UiSkinRegion> field = TryResolveSelectableStateRegion(skin, name, comboStyle.fallback);
        const Expected<UiSkinRegion> arrow = TryResolveSelectableStateRegion(skin, comboStyle.arrow, comboStyle.arrowFallback);
        if(!field.has_value() || !arrow.has_value())
            return false;
        paint.pushClip(clip);
        const b8 fieldPainted = paint.drawRegion(field.value().name, rectangle);
        Rect icon;
        Rect textClip;
        ResolveComboFieldLayout(rectangle, padding, arrowExtent, comboStyle.arrowGap, icon, textClip);
        Color arrowTint;
        if(!enabled)
            arrowTint = Color(1.0f, 1.0f, 1.0f, s_StyleDisabledIconAlpha);
        const b8 arrowPainted = fieldPainted && paint.drawRegion(arrow.value().name, icon, arrowTint);
        paint.pushClip(textClip);
        const Point origin = ResolveCenteredTextOrigin(textClip, 0.0f, textBounds);
        Color activeTextColor = widgetStyle.disabledText;
        if(enabled)
            activeTextColor = widgetStyle.text;
        const b8 textPainted = arrowPainted && text.paint(paint, layout, origin, activeTextColor);
        const b8 textPopped = paint.popClip();
        const b8 focusPainted = textPainted && (!focused || !enabled || !skin.hasRegion(widgetStyle.focus) || paint.drawRegion(widgetStyle.focus, rectangle));
        const b8 popped = paint.popClip();
        return focusPainted && textPopped && popped;
    }

    public b8 paintSliderVisual(
        mut PaintBuilder paint,
        in UiSkin skin,
        in SliderStyle style,
        in SliderPlacement placement,
        in b8 interactive,
        in b8 pressed,
        in b8 hover,
        in b8 focused
    ){
        const Expected<UiSkinRegion> track = TryResolveSelectableStateRegion(skin, style.track, style.trackFallback);
        const Name preferredThumb = ResolveSliderThumbPreferredName(style, interactive, pressed, hover);
        Expected<UiSkinRegion> thumb = TryResolveSelectableStateRegion(skin, preferredThumb, style.normal);
        if(!thumb.has_value())
            thumb = TryResolveSelectableStateRegion(skin, style.normal, style.thumbFallback);
        if(!track.has_value() || !thumb.has_value())
            return false;
        const Color tint = ResolveSliderThumbTint(style, interactive, pressed, hover);
        paint.pushClip(placement.clip);
        Color trackTint = style.disabledTint;
        if(interactive)
            trackTint = Color();
        b8 painted = paint.drawRegion(track.value().name, placement.track, trackTint);
        if(painted)
            painted = paint.drawRegion(thumb.value().name, placement.thumb, tint);
        if(painted && interactive && focused && skin.hasRegion(style.focus))
            painted = paint.drawRegion(style.focus, placement.bounds);
        const b8 popped = paint.popClip();
        return painted && popped;
    }

    public b8 paintRadioGroupChoiceRow(
        mut PaintBuilder paint,
        mut TextService text,
        in UiSkin skin,
        in RadioGroupStyle style,
        in WidgetStyle widgetStyle,
        in RadioGroupMetrics metrics,
        in RadioGroupChoicePlacement row,
        in TextLayout label,
        in Rect textBounds,
        in Name markRegionName,
        in b8 enabled,
        in b8 checked,
        in b8 pressed,
        in b8 hover,
        in b8 focused
    ){
        Name preferred;
        Name fallback;
        ResolveRadioGroupIndicatorNames(style, checked, enabled, pressed, hover, preferred, fallback);
        Expected<UiSkinRegion> indicator = TryResolveSelectableStateRegion(skin, preferred, fallback);
        if(!indicator.has_value())
            indicator = TryResolveSelectableStateRegion(skin, style.normal, style.fallback);
        if(!indicator.has_value())
            return false;
        const Color tint = ResolveRadioGroupChoiceTint(style, enabled, pressed, hover);
        paint.pushClip(row.clip);
        b8 painted = paint.drawRegion(indicator.value().name, row.indicator, tint);
        if(painted && checked)
            painted = paint.drawRegion(markRegionName, row.mark, tint);
        if(painted && focused && skin.hasRegion(style.focus))
            painted = paint.drawRegion(style.focus, row.rectangle);
        const f32 horizontalOffset = Min(row.rectangle.width, row.indicator.width + metrics.gap);
        const Point origin = ResolveCenteredTextOrigin(row.rectangle, horizontalOffset, textBounds);
        paint.pushClip(row.textClip);
        if(painted){
            Color activeTextColor = widgetStyle.disabledText;
            if(enabled)
                activeTextColor = widgetStyle.text;
            painted = text.paint(paint, label, origin, activeTextColor);
        }
        const b8 textPopped = paint.popClip();
        const b8 rowPopped = paint.popClip();
        return painted && textPopped && rowPopped;
    }

    public b8 paintWindowTitleHeader(
        mut PaintBuilder paint,
        mut TextService text,
        in UiSkin skin,
        in WindowState state,
        in WidgetStyle style,
        in WindowMetrics metrics,
        in b8 collapsible,
        in b8 collapseHovered,
        in b8 collapsePressed,
        in b8 collapseFocused,
        in TextLayout titleLayout,
        in Rect titleBounds,
        in Rect header,
        in Rect clip
    ){
        paint.pushClip(clip);
        b8 painted = paint.drawRegion(style.windowTitle, header);
        if(collapsible){
            const Rect collapse = ResolveWindowCollapseBounds(state, metrics);
            if(painted && (collapseHovered || collapsePressed)){
                Name preferredHover = style.buttonHover;
                if(collapsePressed)
                    preferredHover = style.buttonPressed;
                const Expected<UiSkinRegion> hover = TryResolveSelectableStateRegion(skin, preferredHover, style.windowTitle);
                painted = hover.has_value() && paint.drawRegion(hover.value().name, collapse);
            }
            if(painted){
                Color collapseTint = style.text;
                if(state.collapsed)
                    collapseTint = style.disabledText;
                painted = paint.drawRegion(style.windowCollapse, collapse, collapseTint);
            }
            if(painted && collapseFocused && skin.hasRegion(style.focus))
                painted = paint.drawRegion(style.focus, collapse);
        }
        const Rect content = ResolveWindowTitleContentBounds(header, metrics, collapsible, style.gap);
        const Point origin = ResolveCenteredTextOrigin(content, 0.0f, titleBounds);
        paint.pushClip(content);
        if(painted)
            painted = text.paint(paint, titleLayout, origin, style.text);
        const b8 textPopped = paint.popClip();
        const b8 popped = paint.popClip();
        return painted && textPopped && popped;
    }

    public b8 paintWindowResizeCorner(
        mut PaintBuilder paint,
        in UiSkin skin,
        in WidgetStyle style,
        in Rect corner,
        in Rect clip
    ){
        paint.pushClip(clip);
        const Expected<UiSkinRegion> resize = TryResolveSelectableStateRegion(skin, style.windowResize, style.windowResize);
        b8 painted = true;
        if(resize.has_value())
            painted = paint.drawRegion(resize.value().name, corner, style.text);
        else{
            // Skins may supply a resize sprite. The default atlas uses its white sprite for a logical corner grip.
            Rect horizontal;
            Rect vertical;
            ResolveWindowResizeGripBars(corner, horizontal, vertical);
            painted = paint.drawRegion(style.white, horizontal, style.text) && paint.drawRegion(style.white, vertical, style.text);
        }
        const b8 popped = paint.popClip();
        return painted && popped;
    }

    public b8 paintProgressBarRegions(mut PaintBuilder paint, in ProgressStyle style, in ProgressPlacement placement){
        paint.pushClip(placement.clip);
        b8 painted = paint.drawRegion(style.track, placement.bounds, style.trackTint);
        if(painted && placement.fillReveal.width > 0.0f && placement.fillReveal.height > 0.0f){
            paint.pushClip(placement.fillReveal);
            painted = paint.drawRegion(style.fill, placement.fillCanvas, style.fillTint);
            const b8 popped = paint.popClip();
            painted = painted && popped;
        }
        return painted;
    }

    public b8 paintTooltipOverlay(
        mut PaintBuilder paint,
        mut TextService text,
        in u32 layer,
        in Name backgroundName,
        in Rect bounds,
        in Insets padding,
        in TextLayout layout,
        in Rect textBounds,
        in Color textColor
    ){
        if(!paint.beginOverlay(layer))
            return false;
        paint.pushClip(bounds);
        const b8 backgroundPainted = paint.drawRegion(backgroundName, bounds);
        const Rect content = InsetUiRectBounds(bounds, padding);
        paint.pushClip(content);
        b8 painted = false;
        if(backgroundPainted)
            painted = text.paint(paint, layout, Point(content.x - textBounds.x, content.y - textBounds.y), textColor);
        const b8 contentPopped = paint.popClip();
        const b8 popped = paint.popClip();
        const b8 ended = paint.endOverlay();
        return painted && contentPopped && popped && ended;
    }

    public b8 paintListScrollbarVisual(
        mut PaintBuilder paint,
        in UiSkin skin,
        in ListStyle style,
        in ScrollPlacement placement,
        in Rect clip,
        in b8 hover
    ){
        Name preferredThumb = style.thumb;
        if(hover)
            preferredThumb = style.thumbHover;
        const Expected<UiSkinRegion> track = TryResolveSelectableStateRegion(skin, style.track, style.trackFallback);
        const Expected<UiSkinRegion> thumb = TryResolveSelectableStateRegion(skin, preferredThumb, style.thumbFallback);
        if(!track.has_value() || !thumb.has_value())
            return false;
        paint.pushClip(clip);
        const b8 trackPainted = paint.drawRegion(track.value().name, placement.track);
        const b8 thumbPainted = trackPainted && paint.drawRegion(thumb.value().name, placement.thumb);
        const b8 trackPopped = paint.popClip();
        return thumbPainted && trackPopped;
    }

    public b8 paintTextAreaScrollbarAxisVisual(
        mut PaintBuilder paint,
        in UiSkin skin,
        in ScrollbarStyle scrollbarStyle,
        in ScrollbarPlacement bar,
        in b8 enabled,
        in b8 hovered,
        in b8 pressed
    ){
        if(!bar.visible)
            return true;
        const Name thumbName = ResolveScrollbarThumbRegionName(scrollbarStyle, enabled, pressed, hovered);
        const Expected<UiSkinRegion> track = TryResolveSelectableStateRegion(skin, scrollbarStyle.track, scrollbarStyle.trackFallback);
        const Expected<UiSkinRegion> thumb = TryResolveSelectableStateRegion(skin, thumbName, scrollbarStyle.thumbFallback);
        b8 painted = true;
        if(track.has_value())
            painted = paint.drawRegion(track.value().name, bar.track);
        else
            paint.fillRect(bar.track, scrollbarStyle.trackColor);
        if(painted && thumb.has_value())
            painted = paint.drawRegion(thumb.value().name, bar.thumb);
        else if(painted){
            Color thumbColor = scrollbarStyle.disabledColor;
            if(enabled)
                thumbColor = scrollbarStyle.thumbColor;
            paint.fillRect(bar.thumb, thumbColor);
        }
        return painted;
    }

    public b8 paintTextAreaScrollbarsVisual(
        mut PaintBuilder paint,
        in UiSkin skin,
        in ScrollbarStyle scrollbarStyle,
        in ScrollViewportPlacement placement,
        in Rect clip,
        in b8 enabled,
        in b8 horizontalHovered,
        in b8 horizontalPressed,
        in b8 verticalHovered,
        in b8 verticalPressed
    ){
        paint.pushClip(clip);
        b8 painted = this.paintTextAreaScrollbarAxisVisual(paint, skin, scrollbarStyle, placement.horizontal, enabled, horizontalHovered, horizontalPressed)
            && this.paintTextAreaScrollbarAxisVisual(paint, skin, scrollbarStyle, placement.vertical, enabled, verticalHovered, verticalPressed);
        if(painted && placement.corner.width > 0.0f && placement.corner.height > 0.0f){
            const Expected<UiSkinRegion> track = TryResolveSelectableStateRegion(skin, scrollbarStyle.track, scrollbarStyle.trackFallback);
            if(track.has_value())
                painted = paint.drawRegion(track.value().name, placement.corner);
            else
                paint.fillRect(placement.corner, scrollbarStyle.trackColor);
        }
        const b8 popped = paint.popClip();
        return painted && popped;
    }
};


