#include <impl/assets_ui_skin/cook_entry.adhd>
#include <impl/assets_ui_skin/ui_skin_binary_codec.adhd>
#include <impl/assets_ui_skin/validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


UiSkinRegion BuildParsedUiSkinRegion(
    in Name name,
    in UiSkinDrawMode drawMode,
    in Array<u32, 4> rectangleValues,
    in Array<u32, 4> sliceValues,
    in Array<f32, 4> paddingValues,
    in Array<f32, 2> minimumSizeValues
){
    UiSkinRegion region;
    region.name = name;
    region.drawMode = drawMode;
    region.rectangle = UiSkinRect(rectangleValues[0u], rectangleValues[1u], rectangleValues[2u], rectangleValues[3u]);
    region.sliceInsets = UiSkinSliceInsets(sliceValues[0u], sliceValues[1u], sliceValues[2u], sliceValues[3u]);
    region.padding = UiSkinInsets(paddingValues[0u], paddingValues[1u], paddingValues[2u], paddingValues[3u]);
    region.minimumWidth = minimumSizeValues[0u];
    region.minimumHeight = minimumSizeValues[1u];
    return region;
}

b8 IsValidNewUiSkinPaletteRole(in usize role, in b8 alreadySeen){
    return role < cast<usize>(UiSkinColorRole::kCount) && !alreadySeen;
}

UiSkinColor BuildParsedUiSkinPaletteColor(in Array<f32, 4> components){
    return UiSkinColor(components[0u], components[1u], components[2u], components[3u]);
}

b8 IsValidUiSkinToolkitContractOption(in b8 hasToolkitContract, in StringView toolkitContract){
    return !hasToolkitContract || toolkitContract == s_UiSkinWidgetsContract;
}

Expected<u32> ValidateUiSkinU32FieldValue(in Path path, in StringView fieldName, in b8 isInteger, in i64 rawValue){
    if(isInteger && FitsU32(rawValue))
        return cast<u32>(rawValue);

    error("{} '{}': field '{}' must contain integers in the u32 range", s_UiSkinDiagnosticPrefix, path, fieldName);
    return MakeUnexpected(Failure());
}

b8 ValidateUiSkinComponentListLength(
    in Path path,
    in StringView fieldName,
    in b8 isList,
    in usize listSize,
    in usize expectedCount,
    in StringView kindLabel
){
    if(isList && listSize == expectedCount)
        return true;

    error("{} '{}': field '{}' must be a {}-component {} list", s_UiSkinDiagnosticPrefix, path, fieldName, expectedCount, kindLabel);
    return false;
}

b8 ValidateUiSkinPaletteRoleCount(in Path path, in usize count){
    if(count == cast<usize>(UiSkinColorRole::kCount))
        return true;

    error("{} '{}': colors must contain exactly {} named RGBA roles", s_UiSkinDiagnosticPrefix, path, cast<u32>(UiSkinColorRole::kCount));
    return false;
}

b8 ValidateUiSkinNewPaletteRole(in Path path, in StringView name, in usize role, in b8 alreadySeen){
    if(IsValidNewUiSkinPaletteRole(role, alreadySeen))
        return true;

    error("{} '{}': unknown or duplicate palette role '{}'", s_UiSkinDiagnosticPrefix, path, name);
    return false;
}

b8 ValidateUiSkinPaletteChannelList(in Path path, in StringView name, in b8 isValidList){
    if(isValidList)
        return true;

    error("{} '{}': palette role '{}' needs four RGBA components", s_UiSkinDiagnosticPrefix, path, name);
    return false;
}

b8 ValidateUiSkinPaletteChannel(in Path path, in StringView name, in f32 value, in u64 index){
    if(IsValidUiSkinPaletteChannelValue(value, index))
        return true;

    error("{} '{}': palette role '{}' needs RGB in [0, 16] and alpha in [0, 1]", s_UiSkinDiagnosticPrefix, path, name);
    return false;
}

b8 ValidateUiSkinTypographyPresent(in Path path, in b8 present){
    if(present)
        return true;

    error("{} '{}': skins require typography.default_font_size", s_UiSkinDiagnosticPrefix, path);
    return false;
}

b8 ValidateUiSkinDefaultFontSizeValue(in Path path, in f32 defaultFontSize){
    if(IsValidUiSkinDefaultFontSize(defaultFontSize))
        return true;

    error("{} '{}': typography.default_font_size must be in [1/64, 2048]", s_UiSkinDiagnosticPrefix, path);
    return false;
}

b8 ValidateUiSkinToolkitContractValue(in Path path, in b8 hasToolkitContract, in StringView toolkitContract){
    if(IsValidUiSkinToolkitContractOption(hasToolkitContract, toolkitContract))
        return true;

    error("{} '{}': toolkit_contract must be 'widgets'", s_UiSkinDiagnosticPrefix, path);
    return false;
}

b8 ValidateUiSkinRegionsListCount(in Path path, in usize count){
    if(count > cast<usize>(s_UiSkinMaxRegionCount)){
        error("{} '{}': regions exceed schema limit {}", s_UiSkinDiagnosticPrefix, path, s_UiSkinMaxRegionCount);
        return false;
    }
    if(count == 0u){
        error("{} '{}': regions must be nonempty and fit the supported count", s_UiSkinDiagnosticPrefix, path);
        return false;
    }
    return true;
}

Expected<u32> ReadUiSkinU32Value(in Path path, in MetascriptValue value, in StringView fieldName){
    const b8 isInteger = value.isInteger();
    i64 rawValue = 0;
    if(isInteger)
        rawValue = value.asInteger();
    return ValidateUiSkinU32FieldValue(path, fieldName, isInteger, rawValue);
}

Expected<Span<MetascriptValue>> ReadUiSkinListValues(
    in Path path,
    in MetascriptValue object,
    in StringView fieldName,
    in b8 required,
    in usize expectedCount,
    in StringView kindLabel,
    mut b8 outPresent
){
    outPresent = false;
    b8 isList = false;
    Span<MetascriptValue> items = Span<MetascriptValue>();
    if(object.visitField(
        fieldName,
        lambda[mut isList, mut items](in MetascriptValue fieldVal) -> void{
            isList = fieldVal.isList();
            if(isList)
                items = fieldVal.listView();
        }
    )){
        outPresent = true;
        if(!ValidateUiSkinComponentListLength(path, fieldName, isList, items.size(), expectedCount, kindLabel))
            return MakeUnexpected(Failure());
        return items;
    }
    if(required){
        ValidateUiSkinComponentListLength(path, fieldName, false, 0u, expectedCount, kindLabel);
        return MakeUnexpected(Failure());
    }
    return items;
}

Expected<Array<u32, 4>> ReadUiSkinU32Array(in Path path, in MetascriptValue object, in StringView fieldName, in b8 required, in usize count){
    Array<u32, 4> values = Array<u32, 4>();
    b8 present = false;
    const Expected<Span<MetascriptValue>> itemsResult = ReadUiSkinListValues(path, object, fieldName, required, count, "integer", present);
    if(!itemsResult.has_value())
        return MakeUnexpected(Failure());
    if(!present)
        return values;
    const Span<MetascriptValue> items = itemsResult.value();
    for(usize index = 0u; index < count; ++index){
        const Expected<u32> valueResult = ReadUiSkinU32Value(path, items[index], fieldName);
        if(!valueResult.has_value())
            return MakeUnexpected(Failure());
        values[index] = valueResult.value();
    }
    return values;
}

Expected<Array<f32, 4>> ReadUiSkinLogicalArray(in Path path, in MetascriptValue object, in StringView fieldName, in usize count){
    Array<f32, 4> values = Array<f32, 4>();
    b8 present = false;
    const Expected<Span<MetascriptValue>> itemsResult = ReadUiSkinListValues(path, object, fieldName, false, count, "numeric", present);
    if(!itemsResult.has_value())
        return MakeUnexpected(Failure());
    if(!present)
        return values;
    const Span<MetascriptValue> items = itemsResult.value();
    for(usize index = 0u; index < count; ++index){
        const Expected<f32> valueResult = ReadMetadataFiniteF32Value(path, items[index], s_UiSkinDiagnosticPrefix, fieldName);
        if(!valueResult.has_value())
            return MakeUnexpected(Failure());
        values[index] = valueResult.value();
    }
    return values;
}

Expected<UiSkinDrawMode> ParseUiSkinDrawMode(in Path path, in MetascriptValue object){
    if(!object.hasField(s_UiSkinDrawModeField))
        return UiSkinDrawMode::Sprite;
    const Expected<MetadataStringField> text = ReadMetadataStringField(path, object, s_UiSkinDiagnosticPrefix, s_UiSkinDrawModeField, true);
    if(!text.has_value())
        return MakeUnexpected(Failure());
    if(text.value().text == s_UiSkinDrawModeSprite)
        return UiSkinDrawMode::Sprite;
    if(text.value().text == s_UiSkinDrawModeNineSlice)
        return UiSkinDrawMode::NineSlice;
    error("{} '{}': field '{}' {}", s_UiSkinDiagnosticPrefix, path, s_UiSkinDrawModeField, s_UiSkinDrawModeHint);
    return MakeUnexpected(Failure());
}

Expected<UiSkinRegion> ParseUiSkinRegion(in Path path, in MetascriptValue object){
    if(!CheckMetadataAssetMap(path, object, s_UiSkinDiagnosticPrefix))
        return MakeUnexpected(Failure());
    const Expected<UiSkinDrawMode> drawModeResult = ParseUiSkinDrawMode(path, object);
    if(!drawModeResult.has_value())
        return MakeUnexpected(Failure());
    const UiSkinDrawMode drawMode = drawModeResult.value();
    const b8 hasSlice = drawMode == UiSkinDrawMode::NineSlice;
    if(!ValidateMetadataAssetFields(path, object, s_UiSkinDiagnosticPrefix, lambda[in hasSlice](in StringView field) -> b8{
        return IsAllowedUiSkinRegionField(field, hasSlice);
    }))
        return MakeUnexpected(Failure());
    const Expected<Name> nameResult = ReadMetadataNameField(path, object, s_UiSkinDiagnosticPrefix, s_UiSkinNameField, true);
    if(!nameResult.has_value())
        return MakeUnexpected(Failure());
    const Expected<Array<u32, 4>> rectangleResult = ReadUiSkinU32Array(path, object, s_UiSkinRectField, true, cast<usize>(s_UiSkinRectComponentCount));
    if(!rectangleResult.has_value())
        return MakeUnexpected(Failure());
    const Expected<Array<u32, 4>> sliceResult = ReadUiSkinU32Array(path, object, s_UiSkinSliceField, hasSlice, cast<usize>(s_UiSkinSliceComponentCount));
    if(!sliceResult.has_value())
        return MakeUnexpected(Failure());
    const Expected<Array<f32, 4>> paddingResult = ReadUiSkinLogicalArray(path, object, s_UiSkinPaddingField, cast<usize>(s_UiSkinPaddingComponentCount));
    if(!paddingResult.has_value())
        return MakeUnexpected(Failure());
    const Expected<Array<f32, 4>> minimumSizeRawResult = ReadUiSkinLogicalArray(path, object, s_UiSkinMinimumSizeField, cast<usize>(s_UiSkinMinimumSizeComponentCount));
    if(!minimumSizeRawResult.has_value())
        return MakeUnexpected(Failure());
    Array<f32, 2> minimumSizeValues = Array<f32, 2>();
    minimumSizeValues[0u] = minimumSizeRawResult.value()[0u];
    minimumSizeValues[1u] = minimumSizeRawResult.value()[1u];
    return BuildParsedUiSkinRegion(
        nameResult.value(),
        drawMode,
        rectangleResult.value(),
        sliceResult.value(),
        paddingResult.value(),
        minimumSizeValues
    );
}

Expected<UiSkinPalette> ParseUiSkinPalette(in Path path, in MetascriptValue asset){
    UiSkinPalette palette;
    const Expected<Span<MetascriptValue>> colorsResult = ReadMetadataListField(path, asset, s_UiSkinDiagnosticPrefix, s_UiSkinColorsField);
    if(!colorsResult.has_value())
        return MakeUnexpected(Failure());
    const Span<MetascriptValue> colors = colorsResult.value();
    if(!ValidateUiSkinPaletteRoleCount(path, colors.size()))
        return MakeUnexpected(Failure());

    Array<b8, 17> seen = Array<b8, 17>();
    for(usize colorIndex = 0u; colorIndex < colors.size(); ++colorIndex){
        const MetascriptValue value = colors[colorIndex];
        if(
            !CheckMetadataAssetMap(path, value, s_UiSkinDiagnosticPrefix)
            || !ValidateMetadataAssetFields(path, value, s_UiSkinDiagnosticPrefix, lambda[](in StringView field) -> b8{
                return IsAllowedUiSkinPaletteRoleField(field);
            })
        )
            return MakeUnexpected(Failure());
        const Expected<MetadataStringField> nameResultValue = ReadMetadataStringField(path, value, s_UiSkinDiagnosticPrefix, s_UiSkinNameField, true);
        if(!nameResultValue.has_value())
            return MakeUnexpected(Failure());
        const StringView name = nameResultValue.value().text;
        const usize role = cast<usize>(ResolveUiSkinColorRole(name));
        b8 alreadySeen = true;
        if(role < cast<usize>(UiSkinColorRole::kCount))
            alreadySeen = seen[role];
        if(!ValidateUiSkinNewPaletteRole(path, name, role, alreadySeen))
            return MakeUnexpected(Failure());

        b8 isRgbaList = false;
        Span<MetascriptValue> rgbaItems = Span<MetascriptValue>();
        value.visitField(
            s_UiSkinRgbaField,
            lambda[mut isRgbaList, mut rgbaItems](in MetascriptValue fieldVal) -> void{
                if(fieldVal.isList()){
                    rgbaItems = fieldVal.listView();
                    isRgbaList = rgbaItems.size() == cast<usize>(s_UiSkinRgbaComponentCount);
                }
            }
        );
        if(!ValidateUiSkinPaletteChannelList(path, name, isRgbaList))
            return MakeUnexpected(Failure());
        Array<f32, 4> components = Array<f32, 4>();
        for(usize index = 0u; index < cast<usize>(s_UiSkinRgbaComponentCount); ++index){
            const Expected<f32> indexResultValue = ReadMetadataFiniteF32Value(path, rgbaItems[index], s_UiSkinDiagnosticPrefix, s_UiSkinRgbaField);
            if(!indexResultValue.has_value())
                return MakeUnexpected(Failure());
            components[index] = indexResultValue.value();
            if(!ValidateUiSkinPaletteChannel(path, name, components[index], cast<u64>(index)))
                return MakeUnexpected(Failure());
        }
        palette.colors[role] = BuildParsedUiSkinPaletteColor(components);
        seen[role] = true;
    }
    return palette;
}

Expected<UiSkinTypography> ParseUiSkinTypography(in Path path, in MetascriptValue asset){
    UiSkinTypography result;
    b8 typographyOk = true;
    const b8 found = asset.visitField(
        s_UiSkinTypographyField,
        lambda[in path, mut typographyOk, mut result](in MetascriptValue fieldVal) -> void{
            if(
                !CheckMetadataAssetMap(path, fieldVal, s_UiSkinDiagnosticPrefix)
                || !ValidateMetadataAssetFields(path, fieldVal, s_UiSkinDiagnosticPrefix, lambda[](in StringView fieldName) -> b8{
                    return IsAllowedUiSkinTypographyField(fieldName);
                })
            ){
                typographyOk = false;
                return;
            }
            const Expected<f32> defaultFontSizeResult = ReadMetadataFiniteF32Field(path, fieldVal, s_UiSkinDiagnosticPrefix, s_UiSkinDefaultFontSizeField, true);
            if(!defaultFontSizeResult.has_value()){
                typographyOk = false;
                return;
            }
            result.defaultFontSize = defaultFontSizeResult.value();
            typographyOk = ValidateUiSkinDefaultFontSizeValue(path, result.defaultFontSize);
        }
    );
    if(!ValidateUiSkinTypographyPresent(path, found) || !typographyOk)
        return MakeUnexpected(Failure());
    return result;
}

b8 SerializeUiSkinAsset(in UiSkin skin, mut Vector<u8> outBinary){
    if(!skin.validatePayload())
        return false;

    return UiSkinBinaryCodec().serialize(
        skin.texture(),
        skin.atlasWidth(),
        skin.atlasHeight(),
        skin.referenceDensity(),
        skin.regions(),
        skin.palette(),
        skin.typography(),
        outBinary
    );
}

Expected<UiSkin> BuildUiSkinAssetFromCookData(
    in Name virtualPath,
    in AssetRef<Texture> texture,
    in u32 atlasWidth,
    in u32 atlasHeight,
    in f32 referenceDensity,
    in Vector<UiSkinRegion> regions,
    in UiSkinPalette palette,
    in UiSkinTypography typography,
    in b8 completeToolkitSkin
){
    if(!ValidateUiSkinCookRegionCount(regions.size()))
        return MakeUnexpected(Failure());

    UiSkin candidate(virtualPath);
    candidate.setAtlas(texture, atlasWidth, atlasHeight, referenceDensity, regions);
    candidate.setPalette(palette);
    candidate.setTypography(typography);
    if(completeToolkitSkin){
        if(!ValidateUiSkinToolkitContract(candidate))
            return MakeUnexpected(Failure());
    }
    else if(!candidate.validatePayload()){
        return MakeUnexpected(Failure());
    }
    return candidate;
}

b8 ParseUiSkinRegions(in Path path, in MetascriptValue asset, mut Vector<UiSkinRegion> outRegions){
    const Expected<Span<MetascriptValue>> regions = ReadMetadataListField(path, asset, s_UiSkinDiagnosticPrefix, s_UiSkinRegionsField);
    if(!regions.has_value())
        return false;
    if(!ValidateUiSkinRegionsListCount(path, regions.value().size()))
        return false;

    outRegions.clear();
    outRegions.reserve(regions.value().size());
    for(in MetascriptValue value : regions.value()){
        const Expected<UiSkinRegion> regionResult = ParseUiSkinRegion(path, value);
        if(!regionResult.has_value())
            return false;
        outRegions.push_back(regionResult.value());
    }
    return true;
}

Expected<UiSkin> BuildUiSkinAsset(in UiSkinCookEntry entry){
    return BuildUiSkinAssetFromCookData(
        entry.virtualPath,
        entry.texture,
        entry.atlasWidth,
        entry.atlasHeight,
        entry.referenceDensity,
        entry.regions,
        entry.palette,
        entry.typography,
        entry.completeToolkitSkin
    );
}

Expected<UiSkinCookEntry> ParseUiSkinCookMetadata(in Name virtualPath, in Path nwbFilePath, in MetascriptValue asset){
    UiSkinCookEntry parsed;
    if(!CheckMetadataAssetMap(nwbFilePath, asset, s_UiSkinDiagnosticPrefix))
        return MakeUnexpected(Failure());
    if(!AssignCookEntryVirtualPath(virtualPath, nwbFilePath, s_UiSkinDiagnosticPrefix, parsed))
        return MakeUnexpected(Failure());
    if(!ValidateMetadataAssetFields(nwbFilePath, asset, s_UiSkinDiagnosticPrefix, lambda[](in StringView fieldName) -> b8{
        return IsAllowedUiSkinMetadataField(fieldName);
    }))
        return MakeUnexpected(Failure());

    const Expected<UiSkinPalette> paletteResult = ParseUiSkinPalette(nwbFilePath, asset);
    if(!paletteResult.has_value())
        return MakeUnexpected(Failure());
    parsed.palette = paletteResult.value();
    const Expected<UiSkinTypography> typographyResult = ParseUiSkinTypography(nwbFilePath, asset);
    if(!typographyResult.has_value())
        return MakeUnexpected(Failure());
    parsed.typography = typographyResult.value();
    const Expected<AssetRef<Texture>> textureResult = ReadMetadataAssetRefField<Texture>(nwbFilePath, asset, s_UiSkinDiagnosticPrefix, s_UiSkinTextureField, true);
    if(!textureResult.has_value())
        return MakeUnexpected(Failure());
    parsed.texture = textureResult.value();

    const Expected<Array<u32, 4>> extentResult = ReadUiSkinU32Array(nwbFilePath, asset, s_UiSkinAtlasExtentField, true, s_UiSkinAtlasExtentComponentCount);
    if(!extentResult.has_value())
        return MakeUnexpected(Failure());
    parsed.atlasWidth = extentResult.value()[0u];
    parsed.atlasHeight = extentResult.value()[1u];
    const Expected<f32> referenceDensityResult = ReadMetadataFiniteF32Field(nwbFilePath, asset, s_UiSkinDiagnosticPrefix, s_UiSkinReferenceDensityField, true);
    if(!referenceDensityResult.has_value())
        return MakeUnexpected(Failure());
    parsed.referenceDensity = referenceDensityResult.value();

    const Expected<MetadataStringField> toolkitContractResult = ReadMetadataStringField(nwbFilePath, asset, s_UiSkinDiagnosticPrefix, s_UiSkinToolkitContractField, false);
    if(!toolkitContractResult.has_value())
        return MakeUnexpected(Failure());
    const StringView toolkitContract = toolkitContractResult.value().text;
    const b8 hasToolkitContract = toolkitContractResult.value().present;
    if(!ValidateUiSkinToolkitContractValue(nwbFilePath, hasToolkitContract, toolkitContract))
        return MakeUnexpected(Failure());
    parsed.completeToolkitSkin = hasToolkitContract;

    if(!ParseUiSkinRegions(nwbFilePath, asset, parsed.regions))
        return MakeUnexpected(Failure());

    if(!BuildUiSkinAsset(parsed).has_value())
        return MakeUnexpected(Failure());
    return parsed;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<UiSkinCookEntry> ParseUiSkinCookMetadata(in Path root, in StringView virtualRoot, in Path file, in MetascriptDocument document){
    return ParseCookMetadataDocument<UiSkinCookEntry>(root, virtualRoot, file, document, s_UiSkinDiagnosticPrefix, lambda[in file](in Name path, in MetascriptValue value) -> Expected<UiSkinCookEntry>{
        return ParseUiSkinCookMetadata(path, file, value);
    });
}


