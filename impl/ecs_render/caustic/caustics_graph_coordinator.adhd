#include <impl/ecs_render/mesh/mesh_system.adhd>
#include <impl/ecs_render/raytrace/raytracing_system.adhd>
#include <impl/ecs_render/caustic/caustic_resolve_state.adhd>
#include <impl/ecs_render/deferred/deferred_frame_targets.adhd>
#include <impl/ecs_render/raytrace/graph_snapshots.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CausticsGraphContext{
    public mut RendererMeshSystem mesh;
    public mut RendererRayTracingSystem rayTracing;
    public mut GpuTaskGraph graph;
    public mut GpuPersistentResourceStateCache causticsComputeState;
    public mut GpuPersistentResourceStateCache irradianceReturnState;
    public GpuTaskId shadowVisibilityTask;
    public in b8 shadowPrepared;

    public CausticsGraphContext(
        mut RendererMeshSystem mesh,
        mut RendererRayTracingSystem rayTracing,
        mut GpuTaskGraph graph,
        mut GpuPersistentResourceStateCache causticsComputeState,
        mut GpuPersistentResourceStateCache irradianceReturnState,
        in GpuTaskId shadowVisibilityTask,
        in borrow b8 shadowPrepared
    ){
        this.mesh = mesh;
        this.rayTracing = rayTracing;
        this.graph = graph;
        this.causticsComputeState = causticsComputeState;
        this.irradianceReturnState = irradianceReturnState;
        this.shadowVisibilityTask = shadowVisibilityTask;
        this.shadowPrepared = shadowPrepared;
    }
}


[modular]
class CausticsGraphCoordinator : NoCopy{
    public GpuTaskId m_deferredSoftwareCausticsTask;
    // The HW/SW caustic producer shares this clear's packet to preserve timing and acceptance.
    public GpuTaskId m_deferredCausticIrradianceClearTask;
    // The temporal bootstrap is conditional; when present it stays with the selected caustic producer, which commits only on acceptance.
    public GpuTaskId m_deferredCausticAccumulatorBootstrapClearTask;
    // A warm temporal accumulator decays in a mergeable graph task before its selected photon producer.
    public GpuTaskId m_deferredCausticAccumulatorDecayTask;
    // Photon, downsample, resolve prepare, wavelets, upsample, and timing close stay in one packet with compiler-owned handoffs.
    public GpuTaskId m_deferredCausticPhotonTask;
    public GpuTaskId m_deferredCausticGeometryTask;
    public GpuTaskId m_deferredCausticResolvePrepareTask;
    public Array<GpuTaskId, s_CausticResolvePassCount> m_deferredCausticResolveWaveletTasks;
    public GpuTaskId m_deferredCausticResolveUpsampleTask;
    public GpuTaskId m_deferredHardwareCausticsTask;
    public b8 m_deferredCausticProducerDispatched = false;

    public CausticsGraphCoordinator(){}

    public b8 declareDeferredSoftwareCausticsTask(
        in CausticsGraphContext context,
        in b8 hardwareCaustics,
        in DeferredLightingGraphResources deferredLightingResources,
        in RayTracingDeferredGraphResourceSnapshot rayTracingResources,
        in GpuGraphResourceId worldPosition,
        in GpuGraphResourceId depth,
        in GpuGraphResourceId causticIrradiance,
        in GpuGraphResourceId currentBindlessSlots,
        in GpuGraphResourceId sceneShading,
        in GpuGraphResourceId lights,
        in GpuGraphResourceId materialContextSlots,
        in GpuGraphResourceId opticalScene,
        in Span<GpuGraphResourceId> softwareTraceGeometryResources,
        in GpuGraphResourceSetId softwareTraceGeometrySet,
        in GpuGraphResourceSetId traceMaterialSampledTextureSet,
        mut DeferredFrameTargets deferredTargets,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> causticPhotonTiming,
        mut Optional<GpuTimingMeasure> causticResolveTiming
    );

    public void resetDeferredCausticsTaskState(){
        this.m_deferredSoftwareCausticsTask = GpuTaskId();
        this.m_deferredCausticIrradianceClearTask = GpuTaskId();
        this.m_deferredCausticAccumulatorBootstrapClearTask = GpuTaskId();
        this.m_deferredCausticAccumulatorDecayTask = GpuTaskId();
        this.m_deferredCausticPhotonTask = GpuTaskId();
        this.m_deferredCausticGeometryTask = GpuTaskId();
        this.m_deferredCausticResolvePrepareTask = GpuTaskId();
        for(usize index = 0u; index < s_CausticResolvePassCount; ++index)
            this.m_deferredCausticResolveWaveletTasks[index] = GpuTaskId();
        this.m_deferredCausticResolveUpsampleTask = GpuTaskId();
        this.m_deferredHardwareCausticsTask = GpuTaskId();
        this.m_deferredCausticProducerDispatched = false;
    }
}


