void VerifyCpuTaskRangeTests_SingleChunkJoinsAllSubmittedDescendants(){
    u32 callbacks = 0u;
    usize outstandingTasks = 0u;
    native(mut callbacks, mut outstandingTasks){
        using namespace __hidden_cpu_task_range_tests;
        CpuTaskScheduler scheduler(0u);
        EXPECT_TRUE((scheduler.parallelFor(0u, 1u, 1u, [&](usize) {
            ++callbacks;
            const auto cpuTaskAdmission = scheduler.submit([&]() {
                ++callbacks;
                const auto secondCpuTaskAdmission = scheduler.submit([&]()noexcept { ++callbacks; });
                ASSERT_TRUE(secondCpuTaskAdmission);
                if(secondCpuTaskAdmission)
                    ASSERT_TRUE(secondCpuTaskAdmission->valid());
            });
            ASSERT_TRUE(cpuTaskAdmission);
            if(cpuTaskAdmission)
                ASSERT_TRUE(cpuTaskAdmission->valid());
        })));
        outstandingTasks = scheduler.statistics().outstandingTasks;
    }
    EXPECT_EQ(callbacks, 3u);
    EXPECT_EQ(outstandingTasks, 0u);
}

void VerifyCpuTaskRangeTests_SingleChunkKeepsItsCallingWorkersIdentity(){
    native{
        using namespace __hidden_cpu_task_range_tests;
        CpuTaskScheduler scheduler(HomogeneousWorkers(1u));
        const auto cpuTaskAdmission = scheduler.submit([&]() {
            const usize worker = scheduler.currentWorkerIndex();
            const auto affinity = scheduler.currentWorkerAffinity();
            EXPECT_NE(worker, 0u);
            EXPECT_TRUE((scheduler.parallelFor(0u, 1u, 1u, [&](usize) {
                EXPECT_EQ(scheduler.currentWorkerIndex(), worker);
                EXPECT_EQ(scheduler.currentWorkerAffinity(), affinity);
            })));
        });
        ASSERT_TRUE(cpuTaskAdmission);
        const auto task = *cpuTaskAdmission;
        ASSERT_TRUE(task.valid());
        scheduler.wait(task);
    }
}

void VerifyCpuTaskRangeTests_ExternalSingleChunkUsesAWorkerInsteadOfTheProducer(){
    usize worker = 0u;
    native(mut worker){
        using namespace __hidden_cpu_task_range_tests;
        CpuTaskScheduler scheduler(HomogeneousWorkers(1u));
        Atomic<b8> done{ false };
        Thread producer([&]() {
            EXPECT_TRUE((scheduler.parallelFor(0u, 1u, 1u, [&](usize)noexcept { worker = scheduler.currentWorkerIndex(); })));
            done.store(true, MemoryOrder::release);
        });
        PumpUntil(scheduler, done);
        producer.join();
    }
    EXPECT_EQ(worker, 1u);
}

void VerifyCpuTaskRangeTests_ExternalMainThreadRangeWaitsForTheOwner(){
    u32 callbacks = 0u;
    native(mut callbacks){
        using namespace __hidden_cpu_task_range_tests;
        CpuTaskScheduler scheduler(HomogeneousWorkers(1u));
        Atomic<b8> done{ false };
        const ThreadId owner = QueryCurrentThreadId();
        Thread producer([&]() {
            EXPECT_TRUE((scheduler.parallelFor(0u, 1u, 1u, [&](usize) {
                ++callbacks;
                EXPECT_EQ(QueryCurrentThreadId(), owner);
                EXPECT_EQ(scheduler.currentWorkerIndex(), 0u);
            }, { .target = CpuTaskTarget::MainThread })));
            done.store(true, MemoryOrder::release);
        });
        PumpUntil(scheduler, done);
        producer.join();
    }
    EXPECT_EQ(callbacks, 1u);
}

void VerifyCpuTaskRangeTests_InvalidBatchOptionsPublishNoTasks(){
    u32 callbacks = 0u;
    usize outstandingTasks = 0u;
    b8 accepted = true;
    CpuTaskAdmissionErrorEnum err = CpuTaskAdmissionError::Aborting;
    native(mut callbacks, mut outstandingTasks, mut accepted, mut err){
        using namespace __hidden_cpu_task_range_tests;
        CpuTaskScheduler scheduler(0u);
        CpuTaskOptions options;
        options.cost = static_cast<CpuTaskCost::Enum>(255u);
        const auto rejected = scheduler.parallelFor(0u, 128u, 1u, [&](usize)noexcept { ++callbacks; }, options);
        accepted = rejected.has_value();
        if(!rejected)
            err = rejected.error();
        outstandingTasks = scheduler.statistics().outstandingTasks;
    }
    ASSERT_FALSE(accepted);
    EXPECT_EQ(err, CpuTaskAdmissionError::InvalidOptions);
    EXPECT_EQ(callbacks, 0u);
    EXPECT_EQ(outstandingTasks, 0u);
}

void VerifyCpuTaskRangeTests_InlineFailureRetiresSubmittedDescendantsBeforeTerminalHandling(){
    i32 result = 0;
    native(mut result){
        using namespace __hidden_cpu_task_range_tests;
        using RangeFailure = CpuTaskSchedulerTestSupport::InlineRangeFailure;
        struct Retirement{
            u32* count;
            explicit Retirement(u32& counter)noexcept : count(&counter){}
            Retirement(const Retirement&) = delete;
            Retirement(Retirement&& other)noexcept : count(other.count){ other.count = nullptr; }
            ~Retirement()noexcept{
                if(count)
                    ++*count;
            }
        };
        u32 retirements = 0u;
        u32 callbacks = 0u;
        CpuTaskScheduler scheduler(0u);
        result = ::InvokeTerminalEntry<RangeFailure>([&]()->int {
            EXPECT_TRUE((scheduler.parallelFor(0u, 1u, 1u, [&](usize) {
                const auto cpuTaskAdmission = scheduler.submit([&, capture = Retirement(retirements)]() {
                    EXPECT_TRUE(capture.count != nullptr);
                    ++callbacks;
                });
                EXPECT_TRUE(cpuTaskAdmission);
                if(cpuTaskAdmission)
                    EXPECT_TRUE(cpuTaskAdmission->valid());
                throw RangeFailure{ .code = 73 };
            })));
            return 0;
        }, [&](const RangeFailure& failure) {
            EXPECT_EQ(retirements, 1u);
            EXPECT_EQ(callbacks, 0u);
            EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
            return failure.code;
        }, []()noexcept { return -1; });
    }
    EXPECT_EQ(result, 73);
}

