void VerifyUiWindowBehaviorTests_OverflowingMinimumRejectsInitializationWithoutPublishingModel(){
    const f32 largeExtent = bit_cast<f32>(s_UiWheelWindowMaxF32Bits) * 0.75f;
    WindowState state = WindowState();
    state.bounds = Rect(5.0f, 6.0f, 7.0f, 8.0f);
    WindowOptions options = WindowOptions();
    options.initialBounds = Rect(largeExtent, 0.0f, 1.0f, 110.0f);
    WindowMetrics metrics = WindowMetrics();
    metrics.minimumSize = Point(largeExtent, 110.0f);
    EXPECT_FALSE(TryInitializeWindow(options, metrics, state));
    EXPECT_FALSE(state.initialized);
    EXPECT_FLOAT_EQ(state.bounds.x, 5.0f);
    EXPECT_FLOAT_EQ(state.bounds.y, 6.0f);
    EXPECT_FLOAT_EQ(state.bounds.width, 7.0f);
    EXPECT_FLOAT_EQ(state.bounds.height, 8.0f);
}

void VerifyUiWindowBehaviorTests_OverflowingMoveRejectsBoundsAndGestureBaselineAtomically(){
    const f32 largeCoordinate = bit_cast<f32>(s_UiWheelWindowMaxF32Bits) * 0.75f;
    WindowState state = WindowState();
    state.bounds = Rect(20.0f, 30.0f, 200.0f, 140.0f);
    state.initialized = true;
    PointerGesture gesture = PointerGesture();
    gesture.id.target.value = 1u;
    gesture.id.declarationGeneration = 1u;
    gesture.id.layoutGeneration = 1u;
    gesture.id.sequence = 1u;
    gesture.referenceRectangle = Rect(largeCoordinate, 30.0f, 200.0f, 140.0f);
    gesture.position.x = largeCoordinate;
    EXPECT_FALSE(TryApplyWindowMove(gesture, state));
    EXPECT_FLOAT_EQ(state.bounds.x, 20.0f);
    EXPECT_FLOAT_EQ(state.bounds.y, 30.0f);
    EXPECT_EQ(state.moveGesture.id.sequence, 0u);
}

void VerifyUiWindowBehaviorTests_OverflowingResizeRejectsBoundsAndGestureBaselineAtomically(){
    const f32 largeCoordinate = bit_cast<f32>(s_UiWheelWindowMaxF32Bits) * 0.75f;
    WindowState state = WindowState();
    state.bounds = Rect(20.0f, 30.0f, 200.0f, 140.0f);
    state.initialized = true;
    PointerGesture gesture = PointerGesture();
    gesture.id.target.value = 1u;
    gesture.id.declarationGeneration = 1u;
    gesture.id.layoutGeneration = 1u;
    gesture.id.sequence = 1u;
    gesture.referenceRectangle = Rect(0.0f, 30.0f, largeCoordinate, 140.0f);
    gesture.position.x = largeCoordinate;
    EXPECT_FALSE(TryApplyWindowResize(gesture, Point(160.0f, 80.0f), state));
    EXPECT_FLOAT_EQ(state.bounds.width, 200.0f);
    EXPECT_FLOAT_EQ(state.bounds.height, 140.0f);
    EXPECT_EQ(state.resizeGesture.id.sequence, 0u);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyUiWindowSkinTests_ReplacingAtlasChangesMetricsAndBindingsWithoutChangingWidgetIdentity(mut UiWindowSkinTests self){
    WindowState state = WindowState();
    WindowOptions options = WindowOptions();
    options.initialBounds = Rect(30.0f, 40.0f, 240.0f, 150.0f);
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginWindow("window", "Theme", state, options));
    EXPECT_FALSE(self.m_builder.button(s_UiWindowSkinApplyKey, "Apply"));
    ASSERT_TRUE(self.finishWindow());
    const DrawSnapshot first = self.m_paint.freeze();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const auto originalTarget = self.tryTarget(self.id(s_UiWindowSkinApplyKey));
    ASSERT_TRUE(originalTarget.has_value());
    const HitTarget oldTarget = originalTarget.value();
    EXPECT_FLOAT_EQ(oldTarget.rectangle.x, 33.0f);
    EXPECT_FLOAT_EQ(oldTarget.rectangle.y, 78.0f);
    EXPECT_EQ(self.m_context.input().hitTest(Point(40.0f, 86.0f)), oldTarget.id);

    ASSERT_NO_FATAL_FAILURE(self.configureAlternateTheme());
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginWindow("window", "Theme", state, options));
    EXPECT_FALSE(self.m_builder.button(s_UiWindowSkinApplyKey, "Apply"));
    ASSERT_TRUE(self.finishWindow());
    const DrawSnapshot second = self.m_paint.freeze();
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    EXPECT_EQ(self.m_context.input().hitTest(Point(40.0f, 86.0f)), oldTarget.id);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    const auto foundUpdated = self.tryTarget(self.id(s_UiWindowSkinApplyKey));
    ASSERT_TRUE(foundUpdated.has_value());
    const HitTarget updated = foundUpdated.value();
    EXPECT_EQ(updated.id, oldTarget.id);
    EXPECT_EQ(updated.declarationGeneration, oldTarget.declarationGeneration);
    EXPECT_FLOAT_EQ(updated.rectangle.x, 41.0f);
    EXPECT_FLOAT_EQ(updated.rectangle.y, 102.0f);
    EXPECT_FLOAT_EQ(updated.rectangle.width, 120.0f);
    EXPECT_FLOAT_EQ(updated.rectangle.height, 60.0f);
    EXPECT_NE(self.m_context.input().hitTest(Point(40.0f, 86.0f)), updated.id);
    EXPECT_EQ(self.m_context.input().hitTest(Point(55.0f, 115.0f)), updated.id);
    EXPECT_FLOAT_EQ(state.bounds.width, 280.0f);
    EXPECT_FLOAT_EQ(state.bounds.height, 200.0f);
    EXPECT_EQ(first.skinBinding().texture, MakeUiTextureAssetRef("tests/ui/texture"));
    EXPECT_EQ(first.skinBinding().generation, 1u);
    EXPECT_EQ(first.skinBinding().atlasWidth, 128u);
    EXPECT_EQ(second.skinBinding().texture, MakeUiTextureAssetRef("tests/ui/alternate_texture"));
    EXPECT_EQ(second.skinBinding().generation, 2u);
    EXPECT_EQ(second.skinBinding().atlasWidth, 256u);
    EXPECT_FLOAT_EQ(second.skinBinding().referenceDensity, 2.0f);
    ASSERT_FALSE(first.commands().empty());
    ASSERT_FALSE(second.commands().empty());
    const Vertex firstWindow = first.vertices()[first.indices()[first.commands()[0u].firstIndex]];
    const Vertex secondWindow = second.vertices()[second.indices()[second.commands()[0u].firstIndex]];
    EXPECT_FLOAT_EQ(firstWindow.texCoord.x, 0.0f);
    EXPECT_FLOAT_EQ(firstWindow.texCoord.y, 0.0f);
    EXPECT_FLOAT_EQ(secondWindow.texCoord.x, 0.5f);
    EXPECT_FLOAT_EQ(secondWindow.texCoord.y, 0.25f);
}


