[[nodiscard]] inline b8 UiSearchComboReconcileCombo(::NWB::Impl::Ui::ComboState& state, const ::NWB::Impl::Ui::IListDataSource& source){
    return ::NWB::Impl::Ui::ComboBehavior::Reconcile(state, source);
}

[[nodiscard]] inline b8 UiSearchComboFilterState(::NWB::Impl::Ui::SearchComboState& state, ::NWB::Impl::Ui::ISearchableListDataSource& source){
    return ::NWB::Impl::Ui::SearchComboBehavior::Filter(state, source);
}

[[nodiscard]] inline b8 UiSearchComboReconcilePreview(::NWB::Impl::Ui::SearchComboState& state, const ::NWB::Impl::Ui::IListDataSource& source){
    return ::NWB::Impl::Ui::ListBehavior::Reconcile(::NWB::Impl::Ui::ComboBehavior::Preview(state.combo()), source);
}

inline void UiSearchComboSelectPreview(::NWB::Impl::Ui::SearchComboState& state, const u64 keyValue)noexcept{
    ::NWB::Impl::Ui::ComboBehavior::Preview(state.combo()).select(keyValue);
}

[[nodiscard]] inline b8 UiSearchComboScrollPreview(::NWB::Impl::Ui::SearchComboState& state, const f64 offset)noexcept{
    return ::NWB::Impl::Ui::ComboBehavior::Preview(state.combo()).scrollTo(offset);
}

[[nodiscard]] inline SearchComboOptions UiSearchComboFixtureOptions()noexcept{
    return ::NWB::UiSearchComboTests::SearchFixture::Options();
}
