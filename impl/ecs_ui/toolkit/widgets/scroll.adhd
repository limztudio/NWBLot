#include <impl/ecs_ui/toolkit/paint.adhd>
#include <impl/ecs_ui/toolkit/widgets/scroll_viewport_placement.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Hosts own scroll state; its offset and identity contain no retained application or OS references.
class ScrollState : NoCopy{
    private u64 m_instanceGeneration;
    private f64 m_offset = 0.0;

    public ScrollState(){
        this.m_instanceGeneration = AllocateServiceIdentity();
    }

    public u64 instanceGeneration()const{
        return this.m_instanceGeneration;
    }

    public f64 offset()const{
        return this.m_offset;
    }

    public b8 setOffset(in f64 offset){
        const Expected<f64> next = TrySetScrollOffset(offset);
        if(!next.has_value())
            return false;
        this.m_offset = next.value();
        return true;
    }

    public b8 ensureVisible(in f64 start, in f64 end, in f64 viewportHeight){
        const Expected<f64> next = TryEnsureScrollVisible(this.m_offset, start, end, viewportHeight);
        if(!next.has_value())
            return false;
        this.m_offset = next.value();
        return true;
    }

    public b8 scrollBy(in f64 delta, in f64 contentHeight, in f64 viewportHeight){
        const Expected<f64> next = TryScrollByOffset(this.m_offset, delta, contentHeight, viewportHeight);
        if(!next.has_value())
            return false;
        this.m_offset = next.value();
        return true;
    }

    public b8 clamp(in f64 contentHeight, in f64 viewportHeight){
        const Expected<f64> next = TryClampScrollOffset(this.m_offset, contentHeight, viewportHeight);
        if(!next.has_value())
            return false;
        this.m_offset = next.value();
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

