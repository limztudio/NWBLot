inline constexpr MStringView s_SuiteCoreGlobalExportsShadowAndLayoutSource =
    "enum<u8> Format {\r\n"
    "    Custom8 = 0,\r\n"
    "}\r\n"
    "class Color {\r\n"
    "    public f32 luma = 1.0f;\r\n"
    "}\r\n"
    "f32 Viewport(in Color c) {\r\n"
    "    return c.luma;\r\n"
    "}\r\n"
    "[serialize]\r\n"
    "class PackedUnalignedMat {\r\n"
    "    public u8 tag = 1u;\r\n"
    "    public f32x4x4u world = f32x4x4u();\r\n"
    "}\r\n"
    "[serialize]\r\n"
    "class AlignedBoundsPacket {\r\n"
    "    public u8 tag = 1u;\r\n"
    "    public BoundingBox bounds = BoundingBox();\r\n"
    "}\r\n"
    "class CustomInputHandler : IInputEventHandler {\r\n"
    "    public b8 keyboardCharInput(in u32 codePoint, in i32 mods)override {\r\n"
    "        return codePoint != 0u || mods != 0;\r\n"
    "    }\r\n"
    "}\r\n"
    "b8 InspectExports(in IFilesystem fs, in Path entryPath, in Span<u8> rawBytes, in f32x4x4u srcMat, mut f32x4x4u dstMat) {\r\n"
    "    Color localColor;\r\n"
    "    Format localFmt = Format::Custom8;\r\n"
    "    in IFilesystem localFs = fs;\r\n"
    "    DirectoryEntry entry = DirectoryEntry(entryPath);\r\n"
    "    ResourceStates mask = (ResourceStates::ShaderResource | ResourceStates::CopySource) ^ ResourceStates::CopySource;\r\n"
    "    MatrixSingle reg = MatrixSingle(srcMat);\r\n"
    "    dstMat = f32x4x4u(reg);\r\n"
    "    MatrixDecomposition decomp = MatrixDecomposition();\r\n"
    "    Sha1Digest digest = ComputeSha1(rawBytes);\r\n"
    "    usize alignedBytes = PersistentArena::StructureAlignedSize(64u);\r\n"
    "    DescriptorWriteItem emptyWrite = DescriptorWriteItem::None();\r\n"
    "    f32x3x4 joint = MatrixIdentity<f32x3x4>();\r\n"
    "    joint._14 = 2.0f;\r\n"
    "    MatrixSingle ident = MatrixIdentity();\r\n"
    "    f32x4x4 identStore = f32x4x4(ident);\r\n"
    "    return joint._14 == 2.0f && identStore._11 == 1.0f && localFs.mounted() && CanRepresentU64<u32>(cast<u32>(localFmt)) && Viewport(localColor) > 0.0f && mask == ResourceStates::ShaderResource && digest.bytes[0u] <= 255u && Sha1Digest::s_HexTextLength == 40u && BufferRange::s_AllBytes > 0u && alignedBytes >= 64u && emptyWrite.slot == 0u && !entry.path().empty() && IsFinite(decomp.scale.xyz);\r\n"
    "}\r\n";

inline constexpr MStringView s_SuiteHandleDerefRhiAndAssetExportsSource =
    "b8 AcceptMutBuffer(mut Buffer buf) {\r\n"
    "    return buf.getDeviceGeneration() != 0u;\r\n"
    "}\r\n"
    "b8 AcceptMutAsset(mut IAsset asset, mut Framebuffer fb) {\r\n"
    "    return fb.getDescription().colorAttachments.empty() || !asset.name().empty();\r\n"
    "}\r\n"
    "b8 ExerciseHandleRhiAndAssetExports(\r\n"
    "    mut GraphicsRuntime rt,\r\n"
    "    mut CommandList cmd,\r\n"
    "    mut BufferHandle buf,\r\n"
    "    mut TextureHandle tex,\r\n"
    "    mut UniquePtr<IAsset> assetPtr,\r\n"
    "    mut RefCountPtr<IAsset> rcAsset,\r\n"
    "    mut GlobalArena devArena,\r\n"
    "    in Span<u8> indexBytes,\r\n"
    "    mut CookEntryRegistry entryRegistry,\r\n"
    "    in Name vp,\r\n"
    "    in AssetBunchExpandContext bunchCtx\r\n"
    ") {\r\n"
    "    mut Device dev = rt.getDevice();\r\n"
    "    b8 bufOk = buf.valid() && AcceptMutBuffer(buf.deref());\r\n"
    "    DescriptorWriteItem srv = DescriptorWriteItem::TextureSrv(0u, tex.deref());\r\n"
    "    srv.setDimension(TextureDimension::Texture2D);\r\n"
    "    cmd.open();\r\n"
    "    if(IsValidFramebufferPtr(rt.getFramebuffer(0u))){\r\n"
    "        cmd.setResourceStatesForFramebuffer(DerefFramebufferPtr(rt.getFramebuffer(0u)));\r\n"
    "    }\r\n"
    "    cmd.clearState();\r\n"
    "    cmd.close();\r\n"
    "    auto idxRes = DeserializeIndex(devArena, indexBytes);\r\n"
    "    auto bunchRes = ExpandAssetBunchForAssetCook(bunchCtx);\r\n"
    "    b8 assetOk = assetPtr.valid() && rcAsset.valid() && AcceptMutAsset(assetPtr.deref(), DerefFramebufferPtr(rt.getFramebuffer(0u))) && AcceptMutAsset(rcAsset.deref(), DerefFramebufferPtr(rt.getFramebuffer(0u)));\r\n"
    "    return dev.getDeviceGeneration() != 0u && bufOk && srv.slot == 0u && idxRes.hasValue() && bunchRes.hasValue() && entryRegistry.has(vp) && entryRegistry.entryCount() == 0u && assetOk;\r\n"
    "}\r\n";

