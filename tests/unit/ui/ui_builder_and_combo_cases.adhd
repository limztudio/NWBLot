////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Rect MakeUiBuilderRect(in f32 x, in f32 y, in f32 width, in f32 height){
    Rect rect = Rect();
    rect.x = x;
    rect.y = y;
    rect.width = width;
    rect.height = height;
    return rect;
}

Point MakeUiBuilderPoint(in f32 x, in f32 y){
    Point point = Point();
    point.x = x;
    point.y = y;
    return point;
}

WidgetId MakeUiBuilderWidgetId(in u64 value){
    WidgetId id = WidgetId();
    id.value = value;
    return id;
}

InputEvent MakeUiBuilderKeyEvent(in InputEventTypeEnum type, in i32 key, in b8 shift, in b8 repeat){
    InputEvent event = InputEvent();
    event.type = type;
    event.key = key;
    event.shift = shift;
    event.repeat = repeat;
    return event;
}

InputEvent MakeUiBuilderPointerEvent(in InputEventTypeEnum type, in Point position){
    InputEvent event = InputEvent();
    event.type = type;
    event.position = position;
    return event;
}

UiSkinPalette MakeUiBuilderSkinPalette(in f32 offset){
    UiSkinPalette palette = UiSkinPalette();
    for(u32 index = 0u; index < UiSkinColorRole::kCount; ++index){
        const VectorSingle steps = VectorSingle(cast<f32>(index)) * VectorSingle(0.02f, 0.01f, 0.0f, 0.0f) + VectorSingle(offset, 0.5f, 0.0f, 0.0f);
        const VectorSingle channels = VectorSingle(steps.x) + VectorSingle(0.0f, 0.01f, 0.02f, 0.0f);
        UiSkinColor color = UiSkinColor();
        color.r = steps.x;
        color.g = channels.y;
        color.b = channels.z;
        color.a = steps.y;
        palette.colors[index] = color;
    }
    return palette;
}

void ExpectUiBuilderSkinPaletteColor(in Color actual, in UiSkinColor expected){
    EXPECT_FLOAT_EQ(actual.r, expected.r);
    EXPECT_FLOAT_EQ(actual.g, expected.g);
    EXPECT_FLOAT_EQ(actual.b, expected.b);
    EXPECT_FLOAT_EQ(actual.a, expected.a);
}

u32 CountUiBuilderTextShapingGlyphQuads(in DrawSnapshot snapshot){
    u32 count = 0u;
    for(usize index = 0u; index < snapshot.commands().size(); ++index){
        const DrawCommand command = snapshot.commands()[index];
        if(command.material == PaintMaterial::Glyph || command.material == PaintMaterial::SdfGlyph)
            count += command.indexCount / 6u;
    }
    return count;
}

b8 AcceptUiComboBuilderNeighbors(mut UiComboBuilderTests self, in u64 generation){
    if(!self.begin(generation) || !self.m_builder.beginPanel(s_UiComboBuilderPanelKey, MakeUiBuilderRect(10.0f, 10.0f, 320.0f, 240.0f)))
        return false;
    if(self.m_builder.button("before", "Before"))
        return false;
    self.m_result = self.m_builder.comboBox(s_UiComboBuilderKey, self.m_source, self.m_state, MakeUiComboBuilderDefaultOptions());
    if(self.m_builder.button("after", "After"))
        return false;
    return self.m_result.valid && self.finishPanel() && self.m_context.commitFrame(generation);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyUiBuilderSkinPaletteTests_SkinChangeInsidePanelFailsWithoutReplacingActiveStyle(mut UiBuilderSkinPaletteTests self){
    const WidgetStyle defaultStyle = WidgetStyle();
    self.m_builder.style().fontSize = defaultStyle.fontSize;
    const UiSkinPalette first = MakeUiBuilderSkinPalette(0.1f);
    self.m_skin.setPalette(first);
    UiSkinTypography typography = UiSkinTypography();
    typography.defaultFontSize = 20.0f;
    self.m_skin.setTypography(typography);
    self.m_builder.setSkin(self.m_skin);
    ASSERT_FLOAT_EQ(self.m_builder.style().fontSize, 20.0f);

    UiSkin replacement = UiSkin(self.m_arena, s_UiCaseTestsUiReplacementSkin);
    self.configureReplacementSkin(replacement, MakeUiBuilderSkinPalette(0.3f), 22.0f);
    ASSERT_TRUE(replacement.validatePayload());

    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", MakeUiBuilderRect(0.0f, 0.0f, 200.0f, 100.0f)));
    self.m_builder.setSkin(replacement);
    EXPECT_TRUE(self.m_builder.failed());
    EXPECT_FLOAT_EQ(self.m_builder.style().fontSize, 20.0f);
    ExpectUiBuilderSkinPaletteColor(self.m_builder.style().text, first.colors[UiSkinColorRole::TextNormal]);
    EXPECT_FALSE(self.m_builder.endPanel());
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyUiBuilderTests_LabelTextChangesPreserveStableIdAndDeclarationLifetime(mut UiBuilderTests self){
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.label(s_UiBuilderCaptionKey, "A"));
    ASSERT_TRUE(self.finish());
    const DrawSnapshot first = self.m_paint.freeze();
    ASSERT_EQ(first.generation(), 1u);
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const WidgetId caption = self.id(s_UiBuilderCaptionKey);
    const Optional<WidgetState> original = self.findState(caption);
    ASSERT_TRUE(original.has_value());
    const u64 lifetime = original.value().declarationGeneration;
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.label(s_UiBuilderCaptionKey, "A changed caption"));
    ASSERT_TRUE(self.finish());
    const DrawSnapshot second = self.m_paint.freeze();
    const Optional<WidgetState> updated = self.findState(caption);
    ASSERT_TRUE(updated.has_value());
    EXPECT_EQ(updated.value().id, caption);
    EXPECT_EQ(updated.value().declarationGeneration, lifetime);
    EXPECT_GT(second.vertices().size(), first.vertices().size());
    EXPECT_EQ(first.generation(), 1u);
    EXPECT_FALSE(first.glyphPages().empty());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
}

void VerifyUiBuilderTests_CheckboxTogglesOncePerAcceptedActionAcrossRepeatedBuilds(mut UiBuilderTests self){
    b8 checked = false;
    ASSERT_TRUE(self.begin(1u));
    EXPECT_FALSE(self.m_builder.checkbox("enabled", "Enabled", checked));
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const Optional<HitTarget> control = self.findTarget(self.id("enabled"));
    ASSERT_TRUE(control.has_value());
    const VectorSingle centerValue = VectorSingle(control.value().rectangle.x, control.value().rectangle.y, 0.0f, 0.0f) + VectorSingle(4.0f);
    const Point center = MakeUiBuilderPoint(centerValue.x, centerValue.y);
    self.click(center);
    ASSERT_EQ(self.m_context.input().actions().size(), 1u);
    EXPECT_FALSE(self.m_context.input().process().pointerConsumed);
    EXPECT_EQ(self.m_context.input().actions().size(), 1u);
    ASSERT_TRUE(self.begin(2u));
    EXPECT_TRUE(self.m_builder.checkbox("enabled", "Enabled", checked));
    EXPECT_TRUE(checked);
    EXPECT_TRUE(self.m_context.input().actions().empty());
    ASSERT_TRUE(self.finish());
    EXPECT_FALSE(self.m_context.beginFrame(3u));
    EXPECT_FALSE(self.m_context.input().process().pointerConsumed);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    ASSERT_TRUE(self.begin(3u));
    EXPECT_FALSE(self.m_builder.checkbox("enabled", "Enabled", checked));
    EXPECT_TRUE(checked);
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
}

void VerifyUiBuilderTests_ButtonChecksCurrentEnabledValueBeforeTakingPendingActivation(mut UiBuilderTests self){
    ASSERT_TRUE(self.begin(1u));
    EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "Apply"));
    ASSERT_FALSE(self.m_context.failed());
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    Optional<HitTarget> control = self.findTarget(self.id(s_UiBuilderApplyKey));
    ASSERT_TRUE(control.has_value());
    const VectorSingle pointValue = VectorSingle(control.value().rectangle.x, control.value().rectangle.y, 0.0f, 0.0f) + VectorSingle(4.0f);
    const Point point = MakeUiBuilderPoint(pointValue.x, pointValue.y);
    self.click(point);
    ASSERT_EQ(self.m_context.input().actions().size(), 1u);
    ASSERT_TRUE(self.begin(2u));
    WidgetOptions disabled = WidgetOptions();
    disabled.enabled = false;
    EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "Apply", disabled));
    EXPECT_FALSE(self.m_context.failed());
    EXPECT_TRUE(self.m_context.input().actions().empty());
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    control = self.findTarget(self.id(s_UiBuilderApplyKey));
    ASSERT_TRUE(control.has_value());
    EXPECT_FALSE(control.value().enabled);
    EXPECT_FALSE(control.value().focusable);
    EXPECT_FALSE(control.value().activatable);
    EXPECT_NE(self.m_context.input().hitTest(point), control.value().id);
    self.click(point);
    EXPECT_TRUE(self.m_context.input().actions().empty());
    ASSERT_TRUE(self.begin(3u));
    EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "Apply"));
    EXPECT_FALSE(self.m_context.failed());
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    const Optional<HitTarget> enabledControl = self.findTarget(self.id(s_UiBuilderApplyKey));
    ASSERT_TRUE(enabledControl.has_value());
    EXPECT_TRUE(enabledControl.value().enabled);
}

