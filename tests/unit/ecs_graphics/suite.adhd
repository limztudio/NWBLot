CoincidentOpticalVolumeCandidate MakeOpticalCandidate(in u32 entityIndex){
    CoincidentOpticalVolumeCandidate candidate;
    candidate.entity = EntityID(entityIndex, 0u);
    candidate.mesh = SuiteMeshAssetRef("tests/coincident_optical_volumes/mesh");
    candidate.material = SuiteMaterialAssetRef("tests/coincident_optical_volumes/glass");
    return candidate;
}

GpuPhysicalQueueInfo MakeSuiteGraphicsPhysicalQueueInfo(){
    GpuPhysicalQueueInfo queueInfo;
    queueInfo.queueClass = CommandQueue::Graphics;
    return queueInfo;
}

GpuTaskId MakeSuiteGpuTaskId(in u32 generation, in u32 index){
    GpuTaskId id;
    id.generation = generation;
    id.index = index;
    return id;
}

void SetCsgCutterParameters(in VectorSingle parameter, mut CsgCutterComponent cutter){
    const f32x4 stored(parameter);
    const Span<u8> bytes = PodBytes(stored);
    cutter.parameterBytes.resize(bytes.size());
    for(usize i = 0u; i < bytes.size(); ++i)
        cutter.parameterBytes[i] = bytes[i];
}

CsgShadowReceiverInput MakeCsgReceiverInput(in EntityID entity){
    CsgShadowReceiverInput input;
    input.entity = entity;
    input.worldMin = f32x3u(-2.0f, -2.0f, -2.0f);
    input.worldMax = f32x3u(2.0f, 2.0f, 2.0f);
    input.boundsValid = true;
    return input;
}

b8 RegisterCustomCsgShape(mut CsgShadowSnapshotContext context, in Name name){
    CsgShapeTypeDesc desc;
    desc.name = name;
    desc.shaderModule = s_EcsCaseTestsCsgShadowEvaluator;
    desc.shaderModuleInclude = "tests/csg_shadow/evaluator.slangi";
    desc.boundsCallback = lambda[](in MatrixSingle shapeToWorld, in Span<u8> parameters) -> Expected<CsgShapeBounds>{
        if(!parameters.empty())
            return MakeUnexpected(Failure());
        VectorSingle minBounds(0.0f);
        VectorSingle maxBounds(0.0f);
        if(!AabbTransform(shapeToWorld, VectorSingle(-1.0f), VectorSingle(1.0f), minBounds, maxBounds))
            return MakeUnexpected(Failure());
        return CsgShapeBounds(minBounds, maxBounds, true);
    };
    return context.registry.registerShapeType(desc).has_value();
}

b8 RegisterCustomCsgShape(mut CsgShadowSnapshotContext context){ return RegisterCustomCsgShape(context, s_CsgShadowCustomShape); }

