////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SHADOW_RAYQUERY_SLANGI
#define NWB_GRAPHICS_SHADOW_RAYQUERY_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// HW opaque-only occlusion (binary any-hit test; order-independent, no chord). Transparent Beer-Lambert shadows come
// from the software traversal and multiply onto this mask (HW/SW intersectors disagree at grazing chords).


#include "binding_slots.h"
#include "../raytrace/constants.h"
#include "shadow_heap_resources.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The deferred selector itself is a global UniformBuffer heap entry supplied by the dispatch push block.  The opaque
// trace therefore has no local cbuffer even though scene/buffer.slangi still exposes its familiar light helpers.
#ifndef NWB_SHADOW_RQ_DEFERRED_RESOURCES_HEAP_SLOT
#error "shadow RayQuery sources must provide the deferred-resource heap slot expression"
#endif
#define NWB_SCENE_SHADING_HEAP_SLOT NwbHeapDeferredBindlessResources(NWB_SHADOW_RQ_DEFERRED_RESOURCES_HEAP_SLOT).avboitSlots.z
#define NWB_SCENE_LIGHT_LIST_HEAP_SLOT NwbHeapDeferredBindlessResources(NWB_SHADOW_RQ_DEFERRED_RESOURCES_HEAP_SLOT).avboitSlots.w

#include "occlusion.slangi"
#include "../scene/buffer.slangi"
// The soft cone-jitter, shared with the software traversal so the HW opaque path softens IDENTICALLY.
#include "shadow_sampling.slangi"
#include "shadow_ray_setup.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Per light: one HW inline-RayQuery occlusion ray; 0 on first opaque hit else 1 (software tints transparents onto this mask).
// `jitter` cone-jitters inside the source cone (float2(0,0) = hard); zero radius collapses to the axis.
half3 nwbShadowRqLightVisible(const float3 worldPosition, const float3 normal, const NwbSceneLight light, const float2 jitter){
    float3 toLight;
    float tMin;
    float tEnd;
    if(!nwbShadowBuildLightRay(worldPosition, normal, light, jitter, toLight, tMin, tEnd))
        return half3(1.0h, 1.0h, 1.0h);

    RayDesc ray;
    ray.Origin = worldPosition + normal * tMin;
    ray.Direction = toLight;
    ray.TMin = tMin;
    ray.TMax = tEnd;

    // Opaque fast path: non-transparent occluders are FORCE_OPAQUE, so first-hit commit ends traversal with no
    // callbacks/material loads. Transparent candidates are skipped (software tints them); a commit means opaque block.
    RayQuery<RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH> query;
    query.TraceRayInline(NwbHeapAccelStruct(), RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH, NWB_RAY_TRACING_ALL_INSTANCE_MASK, ray);
    // Drain the non-opaque (transparent) candidates without committing any of them; opaque occluders never reach
    // this loop (the intersector commits them and ends the search). The body is intentionally empty.
    while(query.Proceed()){
    }

    return (query.CommittedStatus() == COMMITTED_TRIANGLE_HIT) ? half3(0.0h, 0.0h, 0.0h) : half3(1.0h, 1.0h, 1.0h);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

