class ControlVisualPainter{
    public b8 paintBasicControlItemVisual(
        mut PaintBuilder paint,
        mut TextService text,
        in UiSkin skin,
        in WidgetKind kind,
        in WidgetStyle style,
        in TextLayout layout,
        in Rect textBounds,
        in Insets padding,
        in f32 checkboxExtent,
        in Rect rectangle,
        in Rect clip,
        in b8 enabled,
        in b8 checked,
        in b8 hover,
        in b8 pressed,
        in b8 focused,
        in b8 interactive
    ){
        paint.pushClip(clip);
        b8 painted = true;
        Point origin = Point(rectangle.x, rectangle.y);
        Rect textClip = rectangle;
        const Point measured = Point(textBounds.width, textBounds.height);
        if(kind == WidgetKind::Separator){
            painted = paint.drawRegion(style.separator, rectangle);
            const b8 sepPopped = paint.popClip();
            return painted && sepPopped;
        }
        if(kind == WidgetKind::Button){
            const Name preferred = ResolveButtonPreferredName(style, enabled, pressed || checked, hover);
            painted = paint.drawRegionWithFallback(preferred, style.button, rectangle);
            ResolveButtonTextPlacement(rectangle, padding, measured, textClip, origin);
        }
        else if(kind == WidgetKind::Checkbox){
            const Name preferred = ResolveCheckboxPreferredName(style, enabled, checked, hover);
            Rect square;
            Rect mark;
            ResolveCheckboxPlacement(rectangle, checkboxExtent, style.gap, measured, square, mark, textClip, origin);
            painted = paint.drawRegionWithFallback(preferred, style.checkbox, square);
            if(painted && checked){
                Color tint;
                if(!enabled)
                    tint = Color(1.0f, 1.0f, 1.0f, s_StyleDisabledIconAlpha);
                paint.tryDrawRegion(style.checkboxMark, mark, tint);
            }
        }
        else if(kind == WidgetKind::CollapsibleHeader){
            painted = this.paintCollapsibleHeaderBackplate(paint, style, rectangle, enabled, pressed, hover);
            Rect indicator;
            ResolveCollapsibleHeaderLayout(rectangle, padding, checkboxExtent, style.gap, measured, indicator, textClip, origin);
            if(painted && indicator.width > 0.0f && indicator.height > 0.0f){
                Color iconColor = style.disabledText;
                if(enabled)
                    iconColor = style.text;
                if(!paint.tryDrawRegion(style.headerIndicator, indicator, iconColor)){
                    const f32 insetX = indicator.width * 0.25f;
                    const f32 insetY = indicator.height * 0.25f;
                    const f32 left = indicator.x + insetX;
                    const f32 right = (indicator.x + indicator.width) - insetX;
                    const f32 top = indicator.y + insetY;
                    const f32 bottom = (indicator.y + indicator.height) - insetY;
                    const f32 midX = indicator.x + indicator.width * 0.5f;
                    const f32 midY = indicator.y + indicator.height * 0.5f;
                    if(checked){
                        const f32 dy = (bottom - top) * 0.35f;
                        paint.drawLine(Point(left, midY - dy), Point(midX, midY + dy), 1.5f, iconColor);
                        paint.drawLine(Point(midX, midY + dy), Point(right, midY - dy), 1.5f, iconColor);
                    }
                    else{
                        const f32 dx = (right - left) * 0.35f;
                        paint.drawLine(Point(midX - dx, top), Point(midX + dx, midY), 1.5f, iconColor);
                        paint.drawLine(Point(midX + dx, midY), Point(midX - dx, bottom), 1.5f, iconColor);
                    }
                }
            }
        }
        if(painted && focused && enabled && interactive)
            paint.tryDrawRegion(style.focus, rectangle);
        origin = ResolveLabelPaintOrigin(Rect(origin.x, origin.y, 0.0f, 0.0f), textBounds);
        paint.pushClip(textClip);
        if(painted){
            Color activeColor = style.disabledText;
            if(enabled)
                activeColor = style.text;
            painted = text.paint(paint, layout, origin, activeColor);
        }
        const b8 textPopped = paint.popClip();
        const b8 popped = paint.popClip();
        return painted && textPopped && popped;
    }

    public b8 paintComboFieldVisual(
        mut PaintBuilder paint,
        mut TextService text,
        in UiSkin skin,
        in ComboStyle comboStyle,
        in WidgetStyle widgetStyle,
        in TextLayout layout,
        in Rect textBounds,
        in Insets padding,
        in f32 arrowExtent,
        in Rect rectangle,
        in Rect clip,
        in b8 enabled,
        in b8 open,
        in b8 focused,
        in b8 hovered
    ){
        const Name name = ResolveComboFieldRegionName(comboStyle, enabled, open, focused, hovered);
        const Optional<usize> fieldIdx = paint.resolveRegionIndex(name, comboStyle.fallback);
        const Optional<usize> arrowIdx = paint.resolveRegionIndex(comboStyle.arrow, comboStyle.arrowFallback);
        if(!fieldIdx.has_value() || !arrowIdx.has_value())
            return false;
        paint.pushClip(clip);
        paint.drawRegionByIndex(fieldIdx.value(), rectangle);
        Rect icon;
        Rect textClip;
        ResolveComboFieldLayout(rectangle, padding, arrowExtent, comboStyle.arrowGap, icon, textClip);
        Color arrowTint;
        if(!enabled)
            arrowTint = Color(1.0f, 1.0f, 1.0f, s_StyleDisabledIconAlpha);
        paint.drawRegionByIndex(arrowIdx.value(), icon, arrowTint);
        paint.pushClip(textClip);
        const Point origin = ResolveCenteredTextOrigin(textClip, 0.0f, textBounds);
        Color activeTextColor = widgetStyle.disabledText;
        if(enabled)
            activeTextColor = widgetStyle.text;
        const b8 textPainted = text.paint(paint, layout, origin, activeTextColor);
        const b8 textPopped = paint.popClip();
        if(textPainted && focused && enabled)
            paint.tryDrawRegion(widgetStyle.focus, rectangle);
        const b8 popped = paint.popClip();
        return textPainted && textPopped && popped;
    }

    public b8 paintSliderVisual(
        mut PaintBuilder paint,
        in UiSkin skin,
        in SliderStyle style,
        in SliderPlacement placement,
        in b8 interactive,
        in b8 pressed,
        in b8 hover,
        in b8 focused
    ){
        const Optional<usize> trackIdx = paint.resolveRegionIndex(style.track, style.trackFallback);
        const Name preferredThumb = ResolveSliderThumbPreferredName(style, interactive, pressed, hover);
        Optional<usize> thumbIdx = paint.resolveRegionIndex(preferredThumb, style.normal);
        if(!thumbIdx.has_value() && style.thumbFallback != style.normal)
            thumbIdx = paint.resolveRegionIndex(style.thumbFallback, style.thumbFallback);
        if(!trackIdx.has_value() || !thumbIdx.has_value())
            return false;
        const Color tint = ResolveControlStateTint(style, interactive, pressed, hover);
        paint.pushClip(placement.clip);
        Color trackTint = style.disabledTint;
        if(interactive)
            trackTint = Color();
        paint.drawRegionByIndex(trackIdx.value(), placement.track, trackTint);
        paint.drawRegionByIndex(thumbIdx.value(), placement.thumb, tint);
        if(interactive && focused)
            paint.tryDrawRegion(style.focus, placement.bounds);
        const b8 popped = paint.popClip();
        return popped;
    }

    public b8 paintRadioGroupChoiceRow(
        mut PaintBuilder paint,
        mut TextService text,
        in UiSkin skin,
        in RadioGroupStyle style,
        in WidgetStyle widgetStyle,
        in RadioGroupMetrics metrics,
        in RadioGroupChoicePlacement row,
        in TextLayout label,
        in Rect textBounds,
        in Name markRegionName,
        in b8 enabled,
        in b8 checked,
        in b8 pressed,
        in b8 hover,
        in b8 focused
    ){
        Name preferred;
        Name fallback;
        ResolveRadioGroupIndicatorNames(style, checked, enabled, pressed, hover, preferred, fallback);
        Optional<usize> indicatorIdx = paint.resolveRegionIndex(preferred, fallback);
        if(!indicatorIdx.has_value() && fallback != style.normal)
            indicatorIdx = paint.resolveRegionIndex(style.normal, style.fallback);
        else if(!indicatorIdx.has_value() && style.fallback != fallback)
            indicatorIdx = paint.resolveRegionIndex(style.fallback, style.fallback);
        if(!indicatorIdx.has_value())
            return false;
        const Color tint = ResolveControlStateTint(style, enabled, pressed, hover);
        paint.pushClip(row.clip);
        paint.drawRegionByIndex(indicatorIdx.value(), row.indicator, tint);
        b8 painted = true;
        if(checked)
            painted = paint.drawRegion(markRegionName, row.mark, tint);
        if(painted && focused)
            paint.tryDrawRegion(style.focus, row.rectangle);
        const f32 horizontalOffset = Min(row.rectangle.width, row.indicator.width + metrics.gap);
        const Point origin = ResolveCenteredTextOrigin(row.rectangle, horizontalOffset, textBounds);
        paint.pushClip(row.textClip);
        if(painted){
            Color activeTextColor = widgetStyle.disabledText;
            if(enabled)
                activeTextColor = widgetStyle.text;
            painted = text.paint(paint, label, origin, activeTextColor);
        }
        const b8 textPopped = paint.popClip();
        const b8 rowPopped = paint.popClip();
        return painted && textPopped && rowPopped;
    }

    private b8 paintCollapsibleHeaderBackplate(
        mut PaintBuilder paint,
        in WidgetStyle style,
        in Rect bounds,
        in b8 enabled,
        in b8 pressed,
        in b8 hovered
    )const{
        Name primary = style.header;
        Name secondary = style.windowTitle;
        if(!enabled){
            primary = style.headerDisabled;
            secondary = style.buttonDisabled;
        }
        else if(pressed){
            primary = style.headerPressed;
            secondary = style.buttonPressed;
        }
        else if(hovered){
            primary = style.headerHover;
            secondary = style.buttonHover;
        }
        if(paint.tryDrawRegion(primary, bounds) || paint.tryDrawRegion(secondary, bounds))
            return true;
        return paint.drawRegionWithFallback(style.windowTitle, style.button, bounds);
    }

    private b8 paintWindowTitleButtonBackplate(mut PaintBuilder paint, in WidgetStyle style, in Rect bounds, in b8 hovered, in b8 pressed)const{
        if(!hovered && !pressed)
            return true;
        Name preferred = style.buttonHover;
        if(pressed)
            preferred = style.buttonPressed;
        return paint.drawRegionWithFallback(preferred, style.windowTitle, bounds);
    }

    private b8 paintCloseButtonSymbol(
        mut PaintBuilder paint,
        in WidgetStyle style,
        in Name closeRegion,
        in Rect bounds,
        in Color symbolColor,
        in b8 hovered,
        in b8 pressed
    )const{
        if(!this.paintWindowTitleButtonBackplate(paint, style, bounds, hovered, pressed))
            return false;
        if(!paint.tryDrawRegion(closeRegion, bounds, symbolColor)){
            const f32 insetX = bounds.width * 0.25f;
            const f32 insetY = bounds.height * 0.25f;
            const f32 left = bounds.x + insetX;
            const f32 right = (bounds.x + bounds.width) - insetX;
            const f32 top = bounds.y + insetY;
            const f32 bottom = (bounds.y + bounds.height) - insetY;
            paint.drawLine(Point(left, top), Point(right, bottom), 1.5f, symbolColor);
            paint.drawLine(Point(right, top), Point(left, bottom), 1.5f, symbolColor);
        }
        return true;
    }

    public b8 paintWindowTitleHeader(
        mut PaintBuilder paint,
        mut TextService text,
        in UiSkin skin,
        in WindowState state,
        in WidgetStyle style,
        in WindowMetrics metrics,
        in b8 collapsible,
        in b8 collapseHovered,
        in b8 collapsePressed,
        in b8 collapseFocused,
        in b8 closable,
        in b8 closeHovered,
        in b8 closePressed,
        in b8 closeFocused,
        in TextLayout titleLayout,
        in Rect titleBounds,
        in Rect header,
        in Rect clip
    ){
        paint.pushClip(clip);
        b8 painted = paint.drawRegion(style.windowTitle, header);
        if(collapsible){
            const Rect collapse = ResolveWindowCollapseBounds(state, metrics);
            if(painted)
                painted = this.paintWindowTitleButtonBackplate(paint, style, collapse, collapseHovered, collapsePressed);
            if(painted){
                Color collapseTint = style.text;
                if(state.collapsed)
                    collapseTint = style.disabledText;
                painted = paint.drawRegion(style.windowCollapse, collapse, collapseTint);
            }
            if(painted && collapseFocused)
                paint.tryDrawRegion(style.focus, collapse);
        }
        if(closable){
            const Rect closeRect = ResolveWindowCloseBounds(state, metrics);
            if(painted)
                painted = this.paintCloseButtonSymbol(paint, style, style.windowClose, closeRect, style.text, closeHovered, closePressed);
            if(painted && closeFocused)
                paint.tryDrawRegion(style.focus, closeRect);
        }
        const Rect content = ResolveWindowTitleContentBounds(header, metrics, collapsible, closable, style.gap);
        const Point origin = ResolveCenteredTextOrigin(content, 0.0f, titleBounds);
        paint.pushClip(content);
        if(painted)
            painted = text.paint(paint, titleLayout, origin, style.text);
        const b8 textPopped = paint.popClip();
        const b8 popped = paint.popClip();
        return painted && textPopped && popped;
    }

    public b8 paintWindowResizeCorner(
        mut PaintBuilder paint,
        in UiSkin skin,
        in WidgetStyle style,
        in Rect corner,
        in Rect clip
    ){
        paint.pushClip(clip);
        b8 painted = true;
        if(!paint.tryDrawRegion(style.windowResize, corner, style.text)){
            Rect horizontal;
            Rect vertical;
            ResolveWindowResizeGripBars(corner, horizontal, vertical);
            painted = paint.drawRegion(style.white, horizontal, style.text) && paint.drawRegion(style.white, vertical, style.text);
        }
        const b8 popped = paint.popClip();
        return painted && popped;
    }

    public b8 paintProgressBarRegions(mut PaintBuilder paint, in ProgressStyle style, in ProgressPlacement placement){
        paint.pushClip(placement.clip);
        b8 painted = paint.drawRegion(style.track, placement.bounds, style.trackTint);
        if(painted && placement.fillReveal.width > 0.0f && placement.fillReveal.height > 0.0f){
            paint.pushClip(placement.fillReveal);
            painted = paint.drawRegion(style.fill, placement.fillCanvas, style.fillTint);
            const b8 popped = paint.popClip();
            painted = painted && popped;
        }
        return painted;
    }

    public b8 paintTooltipOverlay(
        mut PaintBuilder paint,
        mut TextService text,
        in u32 layer,
        in Name backgroundName,
        in Rect bounds,
        in Insets padding,
        in TextLayout layout,
        in Rect textBounds,
        in Color textColor
    ){
        if(!paint.beginOverlay(layer))
            return false;
        paint.pushClip(bounds);
        const b8 backgroundPainted = paint.drawRegion(backgroundName, bounds);
        const Rect content = InsetUiRectBounds(bounds, padding);
        paint.pushClip(content);
        b8 painted = false;
        if(backgroundPainted){
            const VectorSingle origin = VectorSingle(content.x, content.y, content.x, content.y) - VectorSingle(textBounds.x, textBounds.y, textBounds.x, textBounds.y);
            painted = text.paint(paint, layout, Point(origin.x, origin.y), textColor);
        }
        const b8 contentPopped = paint.popClip();
        const b8 popped = paint.popClip();
        const b8 ended = paint.endOverlay();
        return painted && contentPopped && popped && ended;
    }

    public b8 paintListScrollbarAxisVisual(
        mut PaintBuilder paint,
        in UiSkin skin,
        in ListStyle style,
        in Rect track,
        in Rect thumb,
        in Rect clip,
        in b8 enabled,
        in b8 pressed,
        in b8 hover
    ){
        Name preferredThumb = style.thumb;
        if(!enabled)
            preferredThumb = style.thumbDisabled;
        else if(pressed)
            preferredThumb = style.thumbPressed;
        else if(hover)
            preferredThumb = style.thumbHover;
        const Optional<usize> trackIdx = paint.resolveRegionIndex(style.track, style.trackFallback);
        const Optional<usize> thumbIdx = paint.resolveRegionIndex(preferredThumb, style.thumbFallback);
        if(!trackIdx.has_value() || !thumbIdx.has_value())
            return false;
        paint.pushClip(clip);
        paint.drawRegionByIndex(trackIdx.value(), track);
        paint.drawRegionByIndex(thumbIdx.value(), thumb);
        const b8 trackPopped = paint.popClip();
        return trackPopped;
    }

    public b8 paintListScrollbarsVisual(
        mut PaintBuilder paint,
        in UiSkin skin,
        in ListStyle style,
        in ScrollViewportPlacement scrollbars,
        in Rect clip,
        in b8 enabled,
        in b8 horizontalPressed,
        in b8 horizontalHover,
        in b8 verticalPressed,
        in b8 verticalHover
    ){
        if(scrollbars.vertical.visible && !this.paintListScrollbarAxisVisual(paint, skin, style, scrollbars.vertical.track, scrollbars.vertical.thumb, clip, enabled, verticalPressed, verticalHover))
            return false;
        if(scrollbars.horizontal.visible && !this.paintListScrollbarAxisVisual(paint, skin, style, scrollbars.horizontal.track, scrollbars.horizontal.thumb, clip, enabled, horizontalPressed, horizontalHover))
            return false;
        if(scrollbars.corner.width > 0.0f && scrollbars.corner.height > 0.0f){
            const Optional<usize> cornerIdx = paint.resolveRegionIndex(style.track, style.trackFallback);
            if(!cornerIdx.has_value())
                return false;
            paint.pushClip(clip);
            paint.drawRegionByIndex(cornerIdx.value(), scrollbars.corner);
            if(!paint.popClip())
                return false;
        }
        return true;
    }

    public b8 paintTextAreaScrollbarAxisVisual(
        mut PaintBuilder paint,
        in UiSkin skin,
        in ScrollbarStyle scrollbarStyle,
        in ScrollbarPlacement bar,
        in b8 enabled,
        in b8 hovered,
        in b8 pressed
    ){
        if(!bar.visible)
            return true;
        const Name thumbName = ResolveScrollbarThumbRegionName(scrollbarStyle, enabled, pressed, hovered);
        if(!paint.drawRegionWithFallback(scrollbarStyle.track, scrollbarStyle.trackFallback, bar.track))
            paint.fillRect(bar.track, scrollbarStyle.trackColor);
        if(!paint.drawRegionWithFallback(thumbName, scrollbarStyle.thumbFallback, bar.thumb)){
            Color thumbColor = scrollbarStyle.disabledColor;
            if(enabled)
                thumbColor = scrollbarStyle.thumbColor;
            paint.fillRect(bar.thumb, thumbColor);
        }
        return true;
    }

    public b8 paintTextAreaScrollbarsVisual(
        mut PaintBuilder paint,
        in UiSkin skin,
        in ScrollbarStyle scrollbarStyle,
        in ScrollViewportPlacement placement,
        in Rect clip,
        in b8 enabled,
        in b8 horizontalHovered,
        in b8 horizontalPressed,
        in b8 verticalHovered,
        in b8 verticalPressed
    ){
        paint.pushClip(clip);
        const b8 painted = this.paintTextAreaScrollbarAxisVisual(paint, skin, scrollbarStyle, placement.horizontal, enabled, horizontalHovered, horizontalPressed)
            && this.paintTextAreaScrollbarAxisVisual(paint, skin, scrollbarStyle, placement.vertical, enabled, verticalHovered, verticalPressed);
        if(painted && placement.corner.width > 0.0f && placement.corner.height > 0.0f){
            if(!paint.drawRegionWithFallback(scrollbarStyle.track, scrollbarStyle.trackFallback, placement.corner))
                paint.fillRect(placement.corner, scrollbarStyle.trackColor);
        }
        const b8 popped = paint.popClip();
        return painted && popped;
    }

    public b8 paintTabBarVisual(
        mut PaintBuilder paint,
        mut TextService text,
        in TabBarStyle style,
        in WidgetStyle widgetStyle,
        in TabBarPlacement placement,
        in Span<TabBarLabelEntry> labels,
        in b8 interactive,
        in b8 focused,
        in u64 cursorKey,
        in WidgetId hoveredId,
        in WidgetId pressedId,
        in WidgetId tabsGroupId,
        in WidgetId closeGroupId
    ){
        if(labels.size() != cast<usize>(placement.count))
            return false;
        paint.pushClip(placement.clip);
        b8 painted = true;
        if(placement.track.width > 0.0f && placement.track.height > 0.0f)
            painted = paint.drawRegionWithFallback(style.track, style.trackFallback, placement.track);
        for(u32 index = 0u; painted && index < placement.count; ++index){
            in TabBarTabPlacement tab = placement.tabs[index];
            in TabBarLabelEntry labelEntry = labels[index];
            if(!labelEntry.text.valid()){
                painted = false;
                break;
            }
            const Expected<WidgetId> partId = TryMakeWidgetPartId(tabsGroupId, tab.key);
            if(!partId.has_value()){
                painted = false;
                break;
            }
            const b8 tabEnabled = interactive && tab.enabled;
            const b8 tabHovered = tabEnabled && hoveredId == partId.value();
            const b8 tabPressed = tabEnabled && pressedId == partId.value();
            Name preferred = style.normal;
            Name stateFallback = style.fallback;
            Color tint;
            if(!tabEnabled){
                preferred = style.disabled;
                stateFallback = widgetStyle.buttonDisabled;
                tint = style.disabledTint;
            }
            else if(tabPressed){
                preferred = style.pressed;
                stateFallback = widgetStyle.buttonPressed;
                tint = style.pressedTint;
            }
            else if(tab.selected){
                preferred = style.active;
                stateFallback = widgetStyle.windowTitle;
            }
            else if(tabHovered){
                preferred = style.hover;
                stateFallback = widgetStyle.buttonHover;
                tint = style.hoverTint;
            }
            paint.pushClip(tab.clip);
            if(!paint.tryDrawRegion(preferred, tab.rectangle, tint) && !paint.tryDrawRegion(stateFallback, tab.rectangle, tint))
                painted = paint.drawRegionWithFallback(style.normal, style.fallback, tab.rectangle, tint);
            if(painted && tab.selected && tab.activeIndicator.width > 0.0f && tab.activeIndicator.height > 0.0f)
                paint.fillRect(tab.activeIndicator, style.indicatorColor);
            if(painted && tabEnabled && focused && tab.key == cursorKey)
                paint.tryDrawRegion(style.focus, tab.rectangle);
            if(painted && tab.textClip.width > 0.0f && tab.textClip.height > 0.0f){
                paint.pushClip(tab.textClip);
                const f32 textInset = Max(0.0f, (tab.textClip.width - labelEntry.bounds.width) * s_RectCenterFraction);
                const Point origin = ResolveCenteredTextOrigin(tab.textClip, textInset, labelEntry.bounds);
                Color activeTextColor = widgetStyle.disabledText;
                if(tabEnabled)
                    activeTextColor = widgetStyle.text;
                painted = text.paint(paint, labelEntry.text.deref(), origin, activeTextColor);
                const b8 textPopped = paint.popClip();
                painted = painted && textPopped;
            }
            if(painted && tab.closable && tab.closeButton.width > 0.0f && tab.closeButton.height > 0.0f){
                const Expected<WidgetId> closePartId = TryMakeWidgetPartId(closeGroupId, tab.key);
                if(!closePartId.has_value())
                    painted = false;
                else{
                    const b8 closeHovered = tabEnabled && hoveredId == closePartId.value();
                    const b8 closePressed = tabEnabled && pressedId == closePartId.value();
                    Color closeColor = widgetStyle.disabledText;
                    if(tabEnabled)
                        closeColor = widgetStyle.text;
                    painted = this.paintCloseButtonSymbol(paint, widgetStyle, style.close, tab.closeButton, closeColor, closeHovered, closePressed);
                }
            }
            const b8 tabPopped = paint.popClip();
            painted = painted && tabPopped;
        }
        const b8 popped = paint.popClip();
        return painted && popped;
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

