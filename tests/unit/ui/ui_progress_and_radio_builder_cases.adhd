void VerifyUiRadioGroupBehaviorTests_DisabledCheckedChoiceIsPreservedWhileCursorMovesForward(){
    UiRadioChoiceSource source = UiRadioChoiceSource();
    source.rows[1u].enabled = false;
    source.rows[2u].enabled = false;
    RadioGroupState state = RadioGroupState();
    state.select(2u);
    RadioGroupResult result = RadioGroupResult();
    const auto choices = ReconcileUiRadioGroupChoices(source, state, result);
    ASSERT_TRUE(choices.has_value());
    EXPECT_EQ(state.selectedKey(), 2u);
    EXPECT_EQ(state.cursorKey(), 4u);
    EXPECT_FALSE(result.selectionChanged);
    EXPECT_FALSE(choices.value().rows[1u].enabled);
}

void VerifyUiRadioGroupBehaviorTests_RevisionReorderPreservesStableKeys(){
    UiRadioChoiceSource source = UiRadioChoiceSource();
    RadioGroupState state = RadioGroupState();
    state.select(3u);
    RadioGroupResult result = RadioGroupResult();
    auto choices = ReconcileUiRadioGroupChoices(source, state, result);
    ASSERT_TRUE(choices.has_value());
    const RadioGroupChoice swapped = source.rows[0u];
    source.rows[0u] = source.rows[2u];
    source.rows[2u] = swapped;
    ++source.revisionValue;
    result = RadioGroupResult();
    choices = ReconcileUiRadioGroupChoices(source, state, result);
    ASSERT_TRUE(choices.has_value());
    EXPECT_EQ(state.selectedKey(), 3u);
    EXPECT_EQ(state.cursorKey(), 3u);
    EXPECT_FALSE(result.selectionChanged);
    EXPECT_EQ(choices.value().rows[0u].key, 3u);
}

void VerifyUiRadioGroupBehaviorTests_RemovedSelectionAndSourceReplacementClearKnownChoices(){
    UiRadioChoiceSource source = UiRadioChoiceSource();
    RadioGroupState state = RadioGroupState();
    state.select(4u);
    RadioGroupResult result = RadioGroupResult();
    auto choices = ReconcileUiRadioGroupChoices(source, state, result);
    ASSERT_TRUE(choices.has_value());
    source.count = 3u;
    ++source.revisionValue;
    result = RadioGroupResult();
    choices = ReconcileUiRadioGroupChoices(source, state, result);
    ASSERT_TRUE(choices.has_value());
    EXPECT_EQ(state.selectedKey(), 0u);
    EXPECT_EQ(state.cursorKey(), 1u);
    EXPECT_TRUE(result.selectionChanged);
    state.select(2u);
    choices = ReconcileUiRadioGroupChoices(source, state, result);
    ASSERT_TRUE(choices.has_value());
    ++source.generation;
    result = RadioGroupResult();
    choices = ReconcileUiRadioGroupChoices(source, state, result);
    ASSERT_TRUE(choices.has_value());
    EXPECT_EQ(state.selectedKey(), 0u);
    EXPECT_EQ(state.cursorKey(), 1u);
    EXPECT_TRUE(result.selectionChanged);
}

void VerifyUiRadioGroupBehaviorTests_ResetAllowsExplicitChoiceOnANewFirstBinding(){
    UiRadioChoiceSource source = UiRadioChoiceSource();
    RadioGroupState state = RadioGroupState();
    RadioGroupResult result = RadioGroupResult();
    auto choices = ReconcileUiRadioGroupChoices(source, state, result);
    ASSERT_TRUE(choices.has_value());
    state.reset();
    state.select(3u);
    ++source.generation;
    choices = ReconcileUiRadioGroupChoices(source, state, result);
    ASSERT_TRUE(choices.has_value());
    EXPECT_EQ(state.selectedKey(), 3u);
}

void VerifyUiRadioGroupBehaviorTests_EmptyAndAllDisabledSourcesAreValidWithoutAutomaticSelection(){
    UiRadioChoiceSource source = UiRadioChoiceSource();
    RadioGroupState state = RadioGroupState();
    RadioGroupResult result = RadioGroupResult();
    source.count = 0u;
    auto choices = ReconcileUiRadioGroupChoices(source, state, result);
    ASSERT_TRUE(choices.has_value());
    EXPECT_TRUE(result.valid);
    EXPECT_EQ(state.selectedKey(), 0u);
    EXPECT_EQ(state.cursorKey(), 0u);
    source.count = 4u;
    for(usize index = 0u; index < 4u; ++index)
        source.rows[index].enabled = false;
    ++source.revisionValue;
    state.select(2u);
    choices = ReconcileUiRadioGroupChoices(source, state, result);
    ASSERT_TRUE(choices.has_value());
    EXPECT_EQ(state.selectedKey(), 2u);
    EXPECT_EQ(state.cursorKey(), 0u);
    result = RadioGroupResult();
    ASSERT_TRUE(ApplyUiRadioGroupAction(choices.value(), RadioGroupOptions(), MakeUiRadioGroupAction(state, ControlActionKind::Submit), state, result));
    EXPECT_FALSE(result.activated);
    EXPECT_FALSE(result.selectionChanged);
}

void VerifyUiRadioGroupBehaviorTests_AllFourArrowsWrapAndSkipDisabledChoices(){
    UiRadioChoiceSource source = UiRadioChoiceSource();
    source.rows[1u].enabled = false;
    source.rows[2u].enabled = false;
    RadioGroupState state = RadioGroupState();
    state.select(1u);
    RadioGroupResult result = RadioGroupResult();
    const auto choices = ReconcileUiRadioGroupChoices(source, state, result);
    ASSERT_TRUE(choices.has_value());
    const u64 input = state.inputGeneration();
    Array<ControlActionKindEnum, 4u> kinds = Array<ControlActionKindEnum, 4u>();
    kinds[0u] = ControlActionKind::Up;
    kinds[1u] = ControlActionKind::Right;
    kinds[2u] = ControlActionKind::Left;
    kinds[3u] = ControlActionKind::Down;
    Array<u64, 4u> expected = Array<u64, 4u>();
    expected[0u] = 4u;
    expected[1u] = 1u;
    expected[2u] = 4u;
    expected[3u] = 1u;
    for(usize index = 0u; index < 4u; ++index){
        result = RadioGroupResult();
        ASSERT_TRUE(ApplyUiRadioGroupAction(choices.value(), RadioGroupOptions(), MakeUiRadioGroupAction(state, kinds[index]), state, result));
        EXPECT_EQ(state.selectedKey(), expected[index]);
        EXPECT_EQ(state.cursorKey(), expected[index]);
        EXPECT_EQ(state.inputGeneration(), input);
        EXPECT_TRUE(result.selectionChanged);
        EXPECT_FALSE(result.activated);
    }
}

void VerifyUiRadioGroupBehaviorTests_HomeEndChooseEnabledEndpoints(){
    UiRadioChoiceSource source = UiRadioChoiceSource();
    source.rows[0u].enabled = false;
    source.rows[3u].enabled = false;
    RadioGroupState state = RadioGroupState();
    RadioGroupResult result = RadioGroupResult();
    const auto choices = ReconcileUiRadioGroupChoices(source, state, result);
    ASSERT_TRUE(choices.has_value());
    ASSERT_TRUE(ApplyUiRadioGroupAction(choices.value(), RadioGroupOptions(), MakeUiRadioGroupAction(state, ControlActionKind::End), state, result));
    EXPECT_EQ(state.selectedKey(), 3u);
    ASSERT_TRUE(ApplyUiRadioGroupAction(choices.value(), RadioGroupOptions(), MakeUiRadioGroupAction(state, ControlActionKind::Home), state, result));
    EXPECT_EQ(state.selectedKey(), 2u);
    EXPECT_FALSE(result.activated);
}

void VerifyUiRadioGroupBehaviorTests_IdenticalNavigationAndIgnoredPageIntentAdvanceRevisionWithoutRetiringInput(){
    UiRadioChoiceSource source = UiRadioChoiceSource();
    source.count = 1u;
    RadioGroupState state = RadioGroupState();
    state.select(1u);
    RadioGroupResult result = RadioGroupResult();
    const auto choices = ReconcileUiRadioGroupChoices(source, state, result);
    ASSERT_TRUE(choices.has_value());
    const RadioGroupSnapshot before = state.snapshot();
    ASSERT_TRUE(ApplyUiRadioGroupAction(choices.value(), RadioGroupOptions(), MakeUiRadioGroupAction(state, ControlActionKind::Down), state, result));
    ASSERT_TRUE(ApplyUiRadioGroupAction(choices.value(), RadioGroupOptions(), MakeUiRadioGroupAction(state, ControlActionKind::PageUp), state, result));
    EXPECT_EQ(state.selectedKey(), 1u);
    EXPECT_EQ(state.inputGeneration(), before.inputGeneration);
    EXPECT_EQ(state.revision(), before.revision + 2u);
    EXPECT_FALSE(result.selectionChanged);
    EXPECT_FALSE(result.activated);
}

void VerifyUiRadioGroupBehaviorTests_RejectedActionsPreserveStateAndResult(){
    UiRadioChoiceSource source = UiRadioChoiceSource();
    source.rows[1u].enabled = false;
    RadioGroupState state = RadioGroupState();
    state.select(1u);
    RadioGroupResult result = RadioGroupResult();
    const auto choices = ReconcileUiRadioGroupChoices(source, state, result);
    ASSERT_TRUE(choices.has_value());
    const RadioGroupSnapshot before = state.snapshot();
    const RadioGroupResult expected = MakeUiRadioGroupResult(true, true, true, true);
    result = expected;
    EXPECT_FALSE(ApplyUiRadioGroupAction(choices.value(), RadioGroupOptions(), MakeUiRadioGroupActionKey(state, ControlActionKind::Activate, 2u), state, result));
    EXPECT_TRUE(state.matches(before));
    ExpectUiRadioGroupResult(result, expected);
    RadioGroupOptions disabled = RadioGroupOptions();
    disabled.enabled = false;
    EXPECT_FALSE(ApplyUiRadioGroupAction(choices.value(), disabled, MakeUiRadioGroupAction(state, ControlActionKind::Down), state, result));
    EXPECT_TRUE(state.matches(before));
    ExpectUiRadioGroupResult(result, expected);
    ControlAction stale = MakeUiRadioGroupAction(state, ControlActionKind::Down);
    ++stale.control.contentRevision;
    EXPECT_FALSE(ApplyUiRadioGroupAction(choices.value(), RadioGroupOptions(), stale, state, result));
    EXPECT_TRUE(state.matches(before));
    ExpectUiRadioGroupResult(result, expected);
}

void VerifyUiRadioGroupBehaviorTests_IdenticalPublicSelectionRejectsCopiedOlderInput(){
    UiRadioChoiceSource source = UiRadioChoiceSource();
    RadioGroupState state = RadioGroupState();
    state.select(2u);
    RadioGroupResult result = RadioGroupResult();
    const auto choices = ReconcileUiRadioGroupChoices(source, state, result);
    ASSERT_TRUE(choices.has_value());
    const ControlAction action = MakeUiRadioGroupAction(state, ControlActionKind::Down);
    state.select(2u);
    const RadioGroupSnapshot before = state.snapshot();
    result = RadioGroupResult();
    EXPECT_FALSE(ApplyUiRadioGroupAction(choices.value(), RadioGroupOptions(), action, state, result));
    EXPECT_TRUE(state.matches(before));
    EXPECT_FALSE(result.valid);
}

void VerifyUiRadioGroupBehaviorTests_FullBoundIsAcceptedAndOversizedSourcePreservesStateAndDiagnostics(){
    UiRadioChoiceSource source = UiRadioChoiceSource();
    source.count = s_RadioGroupMaxChoices;
    RadioGroupState state = RadioGroupState();
    RadioGroupResult result = RadioGroupResult();
    const auto choices = ReconcileUiRadioGroupChoices(source, state, result);
    ASSERT_TRUE(choices.has_value());
    EXPECT_EQ(choices.value().count, s_RadioGroupMaxChoices);
    const RadioGroupSnapshot before = state.snapshot();
    const RadioGroupResult expectedResult = result;
    source.count = s_RadioGroupMaxChoices + 1u;
    source.keyCalls = 0u;
    EXPECT_FALSE(ReconcileUiRadioGroupChoices(source, state, result).has_value());
    EXPECT_TRUE(state.matches(before));
    ExpectUiRadioGroupResult(result, expectedResult);
    EXPECT_EQ(source.keyCalls, 0u);
}

void VerifyUiRadioGroupBehaviorTests_MalformedKeysAndLookupsRejectAtomically(){
    for(u32 mode = 0u; mode < 6u; ++mode){
        UiRadioChoiceSource source = UiRadioChoiceSource();
        RadioGroupState state = RadioGroupState();
        state.select(3u);
        RadioGroupResult result = MakeUiRadioGroupResult(true, true, true, true);
        const RadioGroupSnapshot before = state.snapshot();
        const RadioGroupResult expectedResult = result;
        switch(mode){
        case 0u:
            source.rows[0u].key = 0u;
            break;
        case 1u:
            source.rows[1u].key = source.rows[0u].key;
            break;
        case 2u:
            source.badLookup = true;
            break;
        case 3u:
            source.missingLookup = true;
            break;
        case 4u:
            source.generation = 0u;
            break;
        default:
            source.revisionValue = 0u;
            break;
        }
        EXPECT_FALSE(ReconcileUiRadioGroupChoices(source, state, result).has_value());
        EXPECT_TRUE(state.matches(before));
        ExpectUiRadioGroupResult(result, expectedResult);
    }
}

void VerifyUiRadioGroupBehaviorTests_EverySourceCallbackRejectsStateSelectionAbaBeforeUsingItsResult(){
    Array<UiRadioCallbackPhaseEnum, 6u> phases = Array<UiRadioCallbackPhaseEnum, 6u>();
    phases[0u] = UiRadioCallbackPhase::Generation;
    phases[1u] = UiRadioCallbackPhase::Revision;
    phases[2u] = UiRadioCallbackPhase::Count;
    phases[3u] = UiRadioCallbackPhase::Key;
    phases[4u] = UiRadioCallbackPhase::Lookup;
    phases[5u] = UiRadioCallbackPhase::Enabled;
    for(in UiRadioCallbackPhaseEnum phase : phases){
        UiRadioChoiceSource source = UiRadioChoiceSource();
        RadioGroupState state = RadioGroupState();
        state.select(2u);
        RadioGroupResult result = RadioGroupResult();
        ASSERT_TRUE(ReconcileUiRadioGroupChoices(source, state, result).has_value());
        const RadioGroupSnapshot before = state.snapshot();
        const RadioGroupResult expectedResult = result;
        source.bindState(state);
        source.phase = phase;
        source.mutation = UiRadioCallbackMutation::SelectAba;
        source.armed = true;
        EXPECT_FALSE(ReconcileUiRadioGroupChoices(source, state, result).has_value());
        EXPECT_EQ(state.selectedKey(), before.selectedKey);
        EXPECT_EQ(state.cursorKey(), before.cursorKey);
        EXPECT_EQ(state.revision(), before.revision + 2u);
        EXPECT_NE(state.inputGeneration(), before.inputGeneration);
        ExpectUiRadioGroupResult(result, expectedResult);
    }
}

void VerifyUiRadioGroupBehaviorTests_CallbackIdenticalSelectionAndResetRemainAuthoritativeAfterRejection(){
    Array<UiRadioCallbackMutationEnum, 2u> mutations = Array<UiRadioCallbackMutationEnum, 2u>();
    mutations[0u] = UiRadioCallbackMutation::SelectIdentical;
    mutations[1u] = UiRadioCallbackMutation::Reset;
    for(in UiRadioCallbackMutationEnum mutation : mutations){
        UiRadioChoiceSource source = UiRadioChoiceSource();
        RadioGroupState state = RadioGroupState();
        state.select(2u);
        RadioGroupResult result = RadioGroupResult();
        ASSERT_TRUE(ReconcileUiRadioGroupChoices(source, state, result).has_value());
        const RadioGroupSnapshot before = state.snapshot();
        source.bindState(state);
        source.phase = UiRadioCallbackPhase::Lookup;
        source.mutation = mutation;
        source.armed = true;
        EXPECT_FALSE(ReconcileUiRadioGroupChoices(source, state, result).has_value());
        EXPECT_EQ(state.revision(), before.revision + 1u);
        EXPECT_NE(state.inputGeneration(), before.inputGeneration);
        u64 expectedKey = 2u;
        if(mutation == UiRadioCallbackMutation::Reset)
            expectedKey = 0u;
        EXPECT_EQ(state.selectedKey(), expectedKey);
    }
}

void VerifyUiRadioGroupBehaviorTests_ReentrantBehaviorRejectsTheOuterReconciliationAndLeavesStateUsable(){
    Array<UiRadioCallbackMutationEnum, 2u> mutations = Array<UiRadioCallbackMutationEnum, 2u>();
    mutations[0u] = UiRadioCallbackMutation::Reconcile;
    mutations[1u] = UiRadioCallbackMutation::Apply;
    for(in UiRadioCallbackMutationEnum mutation : mutations){
        UiRadioChoiceSource source = UiRadioChoiceSource();
        RadioGroupState state = RadioGroupState();
        RadioGroupResult result = RadioGroupResult();
        auto choices = ReconcileUiRadioGroupChoices(source, state, result);
        ASSERT_TRUE(choices.has_value());
        const RadioGroupSnapshot before = state.snapshot();
        const RadioGroupResult expectedResult = result;
        source.bindState(state);
        source.borrowedChoices = choices.value();
        source.phase = UiRadioCallbackPhase::Enabled;
        source.mutation = mutation;
        source.armed = true;
        EXPECT_FALSE(ReconcileUiRadioGroupChoices(source, state, result).has_value());
        EXPECT_FALSE(source.nestedSucceeded);
        EXPECT_TRUE(state.matches(before));
        ExpectUiRadioGroupResult(result, expectedResult);
        choices = ReconcileUiRadioGroupChoices(source, state, result);
        ASSERT_TRUE(choices.has_value());
    }
}

void VerifyUiRadioGroupBehaviorTests_SourceMutationDuringChoiceCallbacksRejectsWithoutCommittingState(){
    Array<UiRadioCallbackMutationEnum, 3u> mutations = Array<UiRadioCallbackMutationEnum, 3u>();
    mutations[0u] = UiRadioCallbackMutation::SourceRevision;
    mutations[1u] = UiRadioCallbackMutation::SourceGeneration;
    mutations[2u] = UiRadioCallbackMutation::SourceCount;
    for(in UiRadioCallbackMutationEnum mutation : mutations){
        UiRadioChoiceSource source = UiRadioChoiceSource();
        RadioGroupState state = RadioGroupState();
        RadioGroupResult result = RadioGroupResult();
        ASSERT_TRUE(ReconcileUiRadioGroupChoices(source, state, result).has_value());
        const RadioGroupSnapshot before = state.snapshot();
        const RadioGroupResult expectedResult = result;
        source.phase = UiRadioCallbackPhase::Enabled;
        source.mutation = mutation;
        source.armed = true;
        EXPECT_FALSE(ReconcileUiRadioGroupChoices(source, state, result).has_value());
        EXPECT_TRUE(state.matches(before));
        ExpectUiRadioGroupResult(result, expectedResult);
    }
}

void VerifyUiRadioGroupBehaviorTests_FinalOneShotMetadataMutationIsRejectedBeforeCommit(){
    Array<UiRadioCallbackMutationEnum, 2u> mutations = Array<UiRadioCallbackMutationEnum, 2u>();
    mutations[0u] = UiRadioCallbackMutation::SourceRevision;
    mutations[1u] = UiRadioCallbackMutation::SourceGeneration;
    for(in UiRadioCallbackMutationEnum mutation : mutations){
        UiRadioChoiceSource source = UiRadioChoiceSource();
        RadioGroupState state = RadioGroupState();
        RadioGroupResult result = RadioGroupResult();
        ASSERT_TRUE(ReconcileUiRadioGroupChoices(source, state, result).has_value());
        const RadioGroupSnapshot before = state.snapshot();
        const RadioGroupResult expectedResult = result;
        source.countCalls = 0u;
        source.phase = UiRadioCallbackPhase::Count;
        source.mutation = mutation;
        source.triggerCount = cast<u32>(source.count) * 3u + 3u;
        source.armed = true;
        EXPECT_FALSE(ReconcileUiRadioGroupChoices(source, state, result).has_value());
        EXPECT_FALSE(source.armed);
        EXPECT_TRUE(state.matches(before));
        ExpectUiRadioGroupResult(result, expectedResult);
    }
}

void VerifyUiRadioGroupBehaviorTests_FailedBorrowedGuardStopsAllFurtherSourceCallbacks(){
    UiRadioChoiceSource source = UiRadioChoiceSource();
    RadioGroupState state = RadioGroupState();
    RadioGroupResult result = RadioGroupResult();
    ASSERT_TRUE(ReconcileUiRadioGroupChoices(source, state, result).has_value());
    const RadioGroupSnapshot before = state.snapshot();
    const RadioGroupResult expectedResult = result;
    UiRadioReconcileGate gate = UiRadioReconcileGate();
    source.bindGate(gate);
    source.phase = UiRadioCallbackPhase::Enabled;
    source.mutation = UiRadioCallbackMutation::GuardFailure;
    source.armed = true;
    EXPECT_FALSE(ReconcileUiRadioGroupChoicesGuarded(source, gate, state, result).has_value());
    EXPECT_EQ(source.callbackCalls, source.callbacksAtMutation);
    EXPECT_TRUE(state.matches(before));
    ExpectUiRadioGroupResult(result, expectedResult);
}

void VerifyUiRadioGroupBehaviorTests_BorrowedGuardMutationIsRejectedBeforeTheFirstSourceCall(){
    UiRadioChoiceSource source = UiRadioChoiceSource();
    RadioGroupState state = RadioGroupState();
    state.select(2u);
    const RadioGroupSnapshot before = state.snapshot();
    RadioGroupResult result = RadioGroupResult();
    UiRadioReconcileGate gate = UiRadioReconcileGate();
    gate.bindState(state);
    gate.mutateState = true;
    EXPECT_FALSE(ReconcileUiRadioGroupChoicesGuarded(source, gate, state, result).has_value());
    EXPECT_EQ(source.callbackCalls, 0u);
    EXPECT_EQ(state.selectedKey(), 2u);
    EXPECT_EQ(state.revision(), before.revision + 1u);
    EXPECT_FALSE(state.matches(before));
    EXPECT_FALSE(result.valid);
}


