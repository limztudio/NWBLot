#include <impl/ecs_ui/toolkit/edit/text_normalization.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind] Expected<String, EditTextStatus> NormalizeSingleLineText(in StringView source, in usize maxBytes){
    String candidate;
    const Expected<usize, EditTextStatus> status = NormalizeSingleLineTextInto(source, maxBytes, candidate);
    if(!status.has_value())
        return MakeUnexpected(status.error());
    return candidate;
}

[cpp_unwind] Expected<String, EditTextStatus> NormalizeMultilineText(in StringView source, in usize maxBytes){
    String candidate;
    const Expected<usize, EditTextStatus> status = NormalizeMultilineTextInto(source, maxBytes, candidate);
    if(!status.has_value())
        return MakeUnexpected(status.error());
    return candidate;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

