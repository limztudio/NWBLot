void VerifyUiSelectionDeletionTests_OrderedHostCopiesSelectionBasisAndPreservesBothDirectionalUndoSelections(mut UiSelectionDeletionTests self){
    for(u32 step = 0u; step < 2u; ++step){
        const b8 reverse = step != 0u;
        native(in reverse){
            SCOPED_TRACE(reverse);
        }
        ASSERT_TRUE(self.seed(reverse));
        ASSERT_TRUE(self.activate());
        ASSERT_EQ(self.m_textInput.preedit("IME", 0u, 3u), TextInputAdmission::Accepted);
        self.m_host.collectNative();
        ASSERT_TRUE(self.frame(self.m_model));
        ASSERT_TRUE(self.m_model.composition().active);
        ASSERT_EQ(self.m_textInput.preedit(StringView(), 0u, 0u), TextInputAdmission::Accepted);
        ASSERT_EQ(self.m_textInput.erase(1u, 1u, self.m_textInput.surroundingRevision(self.m_textInput.activeSession()), TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
        ASSERT_EQ(self.m_textInput.commit("X"), TextInputAdmission::Accepted);
        self.m_host.collectNative();
        EXPECT_EQ(self.m_model.text(), "abcDEFghi");
        ASSERT_TRUE(self.frame(self.m_model));
        EXPECT_EQ(self.m_model.text(), "abXhi");
        EXPECT_FALSE(self.m_model.composition().active);
        ASSERT_TRUE(self.m_model.undo());
        EXPECT_EQ(self.m_model.text(), "abDEFhi");
        usize expectedMidAnchor = 2u;
        usize expectedMidCaret = 5u;
        usize expectedInitAnchor = 3u;
        usize expectedInitCaret = 6u;
        if(reverse){
            expectedMidAnchor = 5u;
            expectedMidCaret = 2u;
            expectedInitAnchor = 6u;
            expectedInitCaret = 3u;
        }
        EXPECT_EQ(self.m_model.anchor(), expectedMidAnchor);
        EXPECT_EQ(self.m_model.caret(), expectedMidCaret);
        ASSERT_TRUE(self.m_model.undo());
        EXPECT_EQ(self.m_model.text(), "abcDEFghi");
        EXPECT_EQ(self.m_model.anchor(), expectedInitAnchor);
        EXPECT_EQ(self.m_model.caret(), expectedInitCaret);
        EXPECT_FALSE(self.m_model.canUndo());
    }
}

void VerifyUiSelectionDeletionTests_ReadOnlyPolicyRetiresCollectedSelectionDeletionWithoutChangingCommittedText(mut UiSelectionDeletionTests self){
