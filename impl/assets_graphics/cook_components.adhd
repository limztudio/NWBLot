#include <impl/assets_graphics/components.adhd>
#include <impl/assets_graphics/cook_types.adhd>
#include <impl/assets_material/asset.adhd>
#include <impl/assets_mesh/asset.adhd>
#include <impl/assets_model/asset.adhd>
#include <impl/assets_scene/cook.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_RendererOpticalVolumeCoincidenceChoices = "'independent', 'identical_material', or 'shared_group'";
const StringView s_RendererOpticalBoundaryModeChoices = "'unspecified', 'closed_nested', or 'closed_priority'";

type ModelComponentCookEntry = TypedComponentCookEntry<ModelComponent>;
type MeshComponentCookEntry = TypedComponentCookEntry<MeshComponent>;
type RendererComponentCookEntry = TypedComponentCookEntry<RendererComponent>;

type ModelComponentCodec = TypedComponentAssetCodec<ModelComponentAsset>;
type MeshComponentCodec = TypedComponentAssetCodec<MeshComponentAsset>;
type RendererComponentCodec = TypedComponentAssetCodec<RendererComponentAsset>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateRendererOpticalVolumeGroupUnpadded(in StringView prefix, in Path nwbFilePath, in StringView fieldName, in b8 unpadded){
    if(unpadded)
        return true;

    error("{} '{}': field '{}' must not be empty or padded", prefix, nwbFilePath, fieldName);
    return false;
}

b8 ValidateRendererOpticalVolumeGroupParsedName(in StringView prefix, in Path nwbFilePath, in StringView fieldName, in b8 validName){
    if(validName)
        return true;

    error("{} '{}': field '{}' contains an embedded null", prefix, nwbFilePath, fieldName);
    return false;
}

b8 IsValidRendererOpticalVolumeGroupName(in b8 parsedOk, in Name groupName){
    return parsedOk && groupName != s_NameNone;
}

b8 ReadOptionalRendererVisibleField(in Path nwbFilePath, in MetascriptValue asset, mut b8 inOutVisible){
    return ReadOptionalMetadataBoolField(nwbFilePath, asset, s_RendererComponentDiagnosticPrefix, s_RendererComponentVisibleField, inOutVisible);
}

Expected<Name> ReadOptionalRendererOpticalVolumeGroupField(in Path nwbFilePath, in MetascriptValue asset){
    if(!asset.hasField(s_RendererComponentOpticalVolumeGroupField))
        return s_NameNone;

    const Expected<MetadataStringField> groupField = ReadMetadataStringField(nwbFilePath, asset, s_RendererComponentDiagnosticPrefix, s_RendererComponentOpticalVolumeGroupField, true);
    if(!groupField.has_value())
        return MakeUnexpected(Failure());
    if(!ValidateRendererOpticalVolumeGroupUnpadded(s_RendererComponentDiagnosticPrefix, nwbFilePath, s_RendererComponentOpticalVolumeGroupField, IsUnpaddedRendererOpticalVolumeGroup(groupField.value().text)))
        return MakeUnexpected(Failure());

    const Expected<Optional<Name>, NameTextError> groupName = ToName(groupField.value().text);
    Name resolvedGroup = s_NameNone;
    if(groupName.has_value() && groupName.value().has_value())
        resolvedGroup = groupName.value().value();
    if(!ValidateRendererOpticalVolumeGroupParsedName(s_RendererComponentDiagnosticPrefix, nwbFilePath, s_RendererComponentOpticalVolumeGroupField, IsValidRendererOpticalVolumeGroupName(groupName.has_value(), resolvedGroup)))
        return MakeUnexpected(Failure());

    return resolvedGroup;
}

b8 ReadOptionalRendererPriorityFields(in Path nwbFilePath, in MetascriptValue asset, mut i32 inOutVolumePriority, mut i32 inOutMediumPriority){
    if(!ReadOptionalI32Field(nwbFilePath, asset, s_RendererComponentDiagnosticPrefix, s_RendererComponentOpticalVolumePriorityField, inOutVolumePriority))
        return false;
    return ReadOptionalI32Field(nwbFilePath, asset, s_RendererComponentDiagnosticPrefix, s_RendererComponentOpticalMediumPriorityField, inOutMediumPriority);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<AssetRef<T>> ReadGraphicsComponentReference<T>(in Path file, in MetascriptValue asset, in StringView prefix, in StringView field){
    const Expected<MetadataStringField> text = ReadMetadataStringField(file, asset, prefix, field, true);
    if(!text.has_value())
        return MakeUnexpected(Failure());
    return ParseReservedAssetRefText<T>(file, prefix, field, text.value().text);
}

Expected<AssetRef<T>> ReadSingleGraphicsComponentReference<T, Entry>(
    in Name virtualPath,
    in Path file,
    in MetascriptValue asset,
    in StringView prefix,
    mut Entry entry
){
    if(!CheckMetadataAssetMap(file, asset, prefix) || !AssignCookEntryVirtualPath(virtualPath, file, prefix, entry))
        return MakeUnexpected(Failure());
    if(!ValidateMetadataAssetFields(file, asset, prefix, lambda[](in StringView key) -> b8{ return key == s_GraphicsComponentAssetField; }))
        return MakeUnexpected(Failure());
    return ReadGraphicsComponentReference<T>(file, asset, prefix, s_GraphicsComponentAssetField);
}

Expected<ModelComponentCookEntry> ParseModelComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue value){
    ModelComponentCookEntry entry;
    const Expected<AssetRef<Model>> reference = ReadSingleGraphicsComponentReference<Model, ModelComponentCookEntry>(
        virtualPath, file, value, s_ModelComponentDiagnosticPrefix, entry
    );
    if(!reference.has_value())
        return MakeUnexpected(Failure());
    entry.component.model = reference.value();
    if(!BuildComponentAssetFromEntry<ModelComponentAsset, ModelComponentCookEntry>(entry).has_value())
        return MakeUnexpected(Failure());
    return entry;
}

Expected<MeshComponentCookEntry> ParseMeshComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue value){
    MeshComponentCookEntry entry;
    const Expected<AssetRef<Mesh>> reference = ReadSingleGraphicsComponentReference<Mesh, MeshComponentCookEntry>(
        virtualPath, file, value, s_MeshComponentDiagnosticPrefix, entry
    );
    if(!reference.has_value())
        return MakeUnexpected(Failure());
    entry.component.mesh = reference.value();
    if(!BuildComponentAssetFromEntry<MeshComponentAsset, MeshComponentCookEntry>(entry).has_value())
        return MakeUnexpected(Failure());
    return entry;
}

Expected<OpticalVolumeCoincidence> ReadRendererOpticalVolumeCoincidence(in Path file, in MetascriptValue value){
    if(!value.hasField(s_RendererComponentOpticalVolumeCoincidenceField))
        return OpticalVolumeCoincidence::Independent;
    const Expected<MetadataStringField> field = ReadMetadataStringField(file, value, s_RendererComponentDiagnosticPrefix, s_RendererComponentOpticalVolumeCoincidenceField, true);
    if(!field.has_value())
        return MakeUnexpected(field.error());
    if(field.value().text == s_OpticalVolumeCoincidenceIndependentText)
        return OpticalVolumeCoincidence::Independent;
    if(field.value().text == s_OpticalVolumeCoincidenceIdenticalMaterialText)
        return OpticalVolumeCoincidence::IdenticalMaterial;
    if(field.value().text == s_OpticalVolumeCoincidenceSharedGroupText)
        return OpticalVolumeCoincidence::SharedGroup;
    error("{} '{}': field '{}' {}", s_RendererComponentDiagnosticPrefix, file, s_RendererComponentOpticalVolumeCoincidenceField, s_RendererOpticalVolumeCoincidenceChoices);
    return MakeUnexpected(Failure());
}

Expected<OpticalBoundaryMode> ReadRendererOpticalBoundaryMode(in Path file, in MetascriptValue value){
    if(!value.hasField(s_RendererComponentOpticalBoundaryModeField))
        return OpticalBoundaryMode::Unspecified;
    const Expected<MetadataStringField> field = ReadMetadataStringField(file, value, s_RendererComponentDiagnosticPrefix, s_RendererComponentOpticalBoundaryModeField, true);
    if(!field.has_value())
        return MakeUnexpected(field.error());
    if(field.value().text == s_OpticalBoundaryModeUnspecifiedText)
        return OpticalBoundaryMode::Unspecified;
    if(field.value().text == s_OpticalBoundaryModeClosedNestedText)
        return OpticalBoundaryMode::ClosedNested;
    if(field.value().text == s_OpticalBoundaryModeClosedPriorityText)
        return OpticalBoundaryMode::ClosedPriority;
    error("{} '{}': field '{}' {}", s_RendererComponentDiagnosticPrefix, file, s_RendererComponentOpticalBoundaryModeField, s_RendererOpticalBoundaryModeChoices);
    return MakeUnexpected(Failure());
}

Expected<RendererComponentCookEntry> ParseRendererComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue asset){
    RendererComponentCookEntry entry;
    if(!CheckMetadataAssetMap(file, asset, s_RendererComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_RendererComponentDiagnosticPrefix, entry)
        || !ValidateMetadataAssetFields(file, asset, s_RendererComponentDiagnosticPrefix, IsAllowedRendererComponentMetadataField))
        return MakeUnexpected(Failure());

    const Expected<AssetRef<Material>> material = ReadGraphicsComponentReference<Material>(
        file, asset, s_RendererComponentDiagnosticPrefix, s_RendererComponentMaterialField
    );
    if(!material.has_value())
        return MakeUnexpected(Failure());
    entry.component.material = material.value();
    if(!ReadOptionalRendererVisibleField(file, asset, entry.component.visible))
        return MakeUnexpected(Failure());
    const Expected<OpticalVolumeCoincidence> coincidence = ReadRendererOpticalVolumeCoincidence(file, asset);
    if(!coincidence.has_value())
        return MakeUnexpected(coincidence.error());
    entry.component.opticalVolumeCoincidence = coincidence.value();
    const Expected<Name> opticalVolumeGroup = ReadOptionalRendererOpticalVolumeGroupField(file, asset);
    if(!opticalVolumeGroup.has_value())
        return MakeUnexpected(opticalVolumeGroup.error());
    entry.component.opticalVolumeGroup = opticalVolumeGroup.value();
    const Expected<OpticalBoundaryMode> boundaryMode = ReadRendererOpticalBoundaryMode(file, asset);
    if(!boundaryMode.has_value())
        return MakeUnexpected(boundaryMode.error());
    entry.component.opticalBoundaryMode = boundaryMode.value();
    if(!ReadOptionalRendererPriorityFields(file, asset, entry.component.opticalVolumePriority, entry.component.opticalMediumPriority))
        return MakeUnexpected(Failure());
    if(!BuildComponentAssetFromEntry<RendererComponentAsset, RendererComponentCookEntry>(entry).has_value())
        return MakeUnexpected(Failure());
    return entry;
}


