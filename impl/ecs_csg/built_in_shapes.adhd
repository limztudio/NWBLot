////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_csg/shape_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
class CsgPlaneShapeParameters{
    public f32x4 normalDistance = s_CsgPlaneDefaultNormalDistance;
}

[reflect]
class CsgBoxShapeParameters{
    public f32x4 halfExtents = s_CsgBoxDefaultHalfExtents;
}

[reflect]
class CsgSphereShapeParameters{
    public f32x4 radius = s_CsgSphereDefaultRadius;
}

[reflect]
class CsgCapsuleShapeParameters{
    public f32x4 radiusHalfHeight = s_CsgCapsuleDefaultRadiusHalfHeight;
}

class CsgPlaneShape : ICsgShape{
    public Name shapeTypeName()const override{
        return s_CsgPlaneShapeName;
    }

    public u32 parameterByteSize()const override{
        return s_CsgShapeParameterRegisterBytes;
    }

    public CsgShapeInlineParameters defaultParameters()const override{
        return MakeCsgShapeInlineParameters(VectorSingle(s_CsgPlaneDefaultNormalDistance), VectorSingle(s_CsgZeroShapeParameter));
    }

    public Expected<CsgShapeLocalBounds> computeLocalBounds(in CsgShapeInlineParameters parameters)const override{
        if(!ValidCsgFiniteVector4(VectorSingle(parameters.parameter0)))
            return MakeUnexpected(Failure());
        return MakeCsgUnboundedLocalBounds();
    }

    public f32 evaluateSignedDistance(in VectorSingle shapePosition, in CsgShapeInlineParameters parameters)const override{
        const VectorSingle param0(parameters.parameter0);
        return Dot(shapePosition.xyz, param0.xyz) + param0.w;
    }
}

class CsgBoxShape : ICsgShape{
    public Name shapeTypeName()const override{
        return s_CsgBoxShapeName;
    }

    public u32 parameterByteSize()const override{
        return s_CsgShapeParameterRegisterBytes;
    }

    public CsgShapeInlineParameters defaultParameters()const override{
        return MakeCsgShapeInlineParameters(VectorSingle(s_CsgBoxDefaultHalfExtents), VectorSingle(s_CsgZeroShapeParameter));
    }

    public Expected<CsgShapeLocalBounds> computeLocalBounds(in CsgShapeInlineParameters parameters)const override{
        return MakeCsgSymmetricLocalBounds(VectorSingle(parameters.parameter0));
    }

    public f32 evaluateSignedDistance(in VectorSingle shapePosition, in CsgShapeInlineParameters parameters)const override{
        const VectorSingle halfExtents(parameters.parameter0, s_CsgShapeBoundsW);
        const VectorSingle q = Abs(shapePosition) - halfExtents;
        const f32 outside = Length(Max(q, VectorSingle(s_CsgZeroShapeParameter)).xyz);
        const f32 inside = Min(Min(q.x, Min(q.y, q.z)), 0.0f);
        return outside + inside;
    }
}

class CsgSphereShape : ICsgShape{
    public Name shapeTypeName()const override{
        return s_CsgSphereShapeName;
    }

    public u32 parameterByteSize()const override{
        return s_CsgShapeParameterRegisterBytes;
    }

    public CsgShapeInlineParameters defaultParameters()const override{
        return MakeCsgShapeInlineParameters(VectorSingle(s_CsgSphereDefaultRadius), VectorSingle(s_CsgZeroShapeParameter));
    }

    public Expected<CsgShapeLocalBounds> computeLocalBounds(in CsgShapeInlineParameters parameters)const override{
        const f32 radius = parameters.parameter0.x;
        return MakeCsgSymmetricLocalBounds(VectorSingle(radius, radius, radius, s_CsgShapeBoundsW));
    }

    public f32 evaluateSignedDistance(in VectorSingle shapePosition, in CsgShapeInlineParameters parameters)const override{
        return Length(shapePosition.xyz) - parameters.parameter0.x;
    }
}

class CsgCapsuleShape : ICsgShape{
    public Name shapeTypeName()const override{
        return s_CsgCapsuleShapeName;
    }

    public u32 parameterByteSize()const override{
        return s_CsgShapeParameterRegisterBytes;
    }

    public CsgShapeInlineParameters defaultParameters()const override{
        return MakeCsgShapeInlineParameters(VectorSingle(s_CsgCapsuleDefaultRadiusHalfHeight), VectorSingle(s_CsgZeroShapeParameter));
    }

    public Expected<CsgShapeLocalBounds> computeLocalBounds(in CsgShapeInlineParameters parameters)const override{
        const f32 radius = parameters.parameter0.x;
        const f32 halfHeight = parameters.parameter0.y;
        if(!ValidCsgFinitePositiveScalar(radius) || !ValidCsgFiniteNonNegativeScalar(halfHeight))
            return MakeUnexpected(Failure());

        const f32 yExtent = halfHeight + radius;
        return MakeCsgSymmetricLocalBounds(VectorSingle(radius, yExtent, radius, s_CsgShapeBoundsW));
    }

    public f32 evaluateSignedDistance(in VectorSingle shapePosition, in CsgShapeInlineParameters parameters)const override{
        const f32 halfHeight = parameters.parameter0.y;
        const f32 clampedY = Clamp(shapePosition.y, -halfHeight, halfHeight);
        const VectorSingle delta = shapePosition - VectorSingle(0.0f, clampedY, 0.0f, 0.0f);
        return Length(delta.xyz) - parameters.parameter0.x;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
