void VerifyCrashReportComposerTests_TombstoneStackMovesBeforeDetailsWithoutBorrowingClearedText(){
    LoggerTestArena testArena = LoggerTestArena();
    ComposerScratchHolder scratchHolder = ComposerScratchHolder();
    CrashPackageSummary summary = CrashPackageSummary(testArena.arena);
    summary.triggerMessage = "fault";
    String details = "package=one\n[tombstone_callstack]\nframe-one\n[metadata]\nkey=value\n";

    const String report = CrashReportComposer::BuildOrderedCrashReport(summary, scratchHolder.scratch, details);
    EXPECT_EQ(StringView(report), "fault\n\ncallstack:\nframe-one\n\ndetails:\npackage=one\n[metadata]\nkey=value\n");
}

void VerifyCrashReportComposerTests_EmptyPrimaryStackTakesPrecedenceOverTombstone(){
    LoggerTestArena testArena = LoggerTestArena();
    ComposerScratchHolder scratchHolder = ComposerScratchHolder();
    CrashPackageSummary summary = CrashPackageSummary(testArena.arena);
    String details = "[callstack]\n\n[tombstone_callstack]\nfallback\n";

    const String report = CrashReportComposer::BuildOrderedCrashReport(summary, scratchHolder.scratch, details);
    EXPECT_EQ(StringView(report), "callstack:\n<unavailable>\n\ndetails:\n[tombstone_callstack]\nfallback\n");
}


