#include <impl/ecs_render/avboit/avboit_stage_internal_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class AvboitTargetAllocationBytes{
    public u64 coverageBytes = 0u;
    public u64 depthWarpBytes = 0u;
    public u64 controlBytes = 0u;
    public u64 extinctionBytes = 0u;
    public u64 extinctionOverflowBytes = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


AvboitTargetAllocationBytes ResolveAvboitTargetAllocationBytes(in AvboitTargetLayout layout){
    AvboitTargetAllocationBytes bytes;
    bytes.coverageBytes = layout.coverageWordCount * 4u;
    bytes.depthWarpBytes = layout.depthWarpWordCount * 4u;
    bytes.controlBytes = cast<u64>(s_AvboitControlWordCount) * 4u;
    bytes.extinctionBytes = layout.extinctionWordCount * 4u;
    bytes.extinctionOverflowBytes = layout.pixelCount * 4u;
    return bytes;
}


