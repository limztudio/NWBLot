NWB_BEGIN


namespace Tests::Smoke{


class RendererGatherBenchmarkScene final : NoCopy{
public:
    using Counts = RendererGatherBenchmarkSceneCounts;


public:
    explicit RendererGatherBenchmarkScene(Core::ECS::World& world)noexcept : m_world(world){}
    [[nodiscard]] b8 build(AStringView workload, b8 runtime, Core::Alloc::ScratchArena& scratchArena);
    [[nodiscard]] Counts& counts()noexcept{ return m_counts; }


private:
    [[nodiscard]] b8 createBackdrop();
    [[nodiscard]] b8 createRuntime(u32 index, const Float4& position);


private:
    Core::ECS::World& m_world;
    Counts m_counts;
    b8 m_runtime = false;
};


namespace __hidden_renderer_gather_scene{
constexpr AStringView s_OpaqueWorkload = s_GatherBenchmarkOpaqueWorkload;
constexpr AStringView s_HybridWorkload = s_GatherBenchmarkHybridWorkload;
constexpr AStringView s_UniqueWorkload = s_GatherBenchmarkUniqueWorkload;
constexpr AStringView s_OverridesWorkload = s_GatherBenchmarkOverridesWorkload;
static constexpr SmokeMeshRef s_Mesh("project/meshes/octahedron");
static constexpr SmokeMeshRef s_Plane("project/meshes/shadow_plane");
static constexpr SmokeMaterialRef s_Opaque("project/smoke/reflection/materials/opaque");
static constexpr SmokeMaterialRef s_Glass("project/smoke/gather_benchmark/materials/glass_00");
static constexpr SmokeModelRef s_Model("project/characters/body/model");
static constexpr AStringView s_Interface = s_SmokeSurfaceMaterialInterface;
static constexpr u32 s_ObjectCount = s_GatherBenchmarkObjectCount;
};

using namespace __hidden_renderer_gather_scene;


b8 RendererGatherBenchmarkScene::build(const AStringView workload, const b8 runtime, Core::Alloc::ScratchArena& scratchArena){
    m_runtime = runtime;
    const auto cameraEntity = CreateSmokeCamera(2.6f, 9.0f, 0.0f, m_world);
    if(!cameraEntity.valid())
        return false;
    const auto light = NWB::Impl::Scene::CreateDirectionalLightEntity(m_world, 0.9f, 0.65f, 0.0f, Float4(1.0f, 0.96f, 0.88f), 2.0f);
    m_world.entity(light).getComponent<NWB::Impl::Scene::LightComponent>().enableCaustics = false;
    if(!createBackdrop())
        return false;
    for(u32 index = 0u; index < s_ObjectCount; ++index){
        const SIMDVectorSingle grid = VectorSubtract(VectorSet(static_cast<f32>(index % 8u), static_cast<f32>(index / 8u), 0.0f, 0.0f), VectorSet(3.5f, 0.0f, 0.0f, 0.0f));
        const SIMDVectorSingle spacing = VectorMultiply(grid, VectorSet(0.75f, 0.58f, 0.0f, 0.0f));
        Float4 position;
        StoreFloat(VectorAdd(VectorSet(0.0f, 0.7f, 0.0f, 0.0f), spacing), position);
        if(m_runtime && index % 8u == 0u){
            if(!createRuntime(index, position))
                return false;
            continue;
        }
        const b8 opaque = workload == s_OpaqueWorkload || (workload == s_HybridWorkload && index % 2u == 0u);
        SmokeMeshRef mesh = s_Mesh;
        SmokeMaterialRef material = opaque ? s_Opaque : s_Glass;
        if(workload == s_UniqueWorkload){
            const auto meshPath = StringFormat(scratchArena, "project/smoke/gather_benchmark/meshes/mesh_{:02}", index);
            const auto materialPath = StringFormat(scratchArena, "project/smoke/gather_benchmark/materials/glass_{:02}", index);
            const auto meshReference = SmokeMeshRef::FromText(AStringView(meshPath));
            if(!meshReference)
                return false;
            mesh = *meshReference;
            const auto materialReference = SmokeMaterialRef::FromText(AStringView(materialPath));
            if(!materialReference)
                return false;
            material = *materialReference;
        }
        auto entity = m_world.createEntity();
        auto& transform = entity.addComponent<NWB::Impl::Scene::TransformComponent>();
        transform.position = position;
        transform.scale = Float4(0.43f, 0.43f, 0.43f, 0.0f);
        entity.addComponent<NWB::Impl::MeshComponent>().mesh = mesh;
        auto& component = entity.addComponent<NWB::Impl::RendererComponent>();
        component.material = material;
        if(!opaque){
            component.opticalBoundaryMode = NWB::Impl::OpticalBoundaryMode::ClosedNested;
            ++m_counts.transparentRenderers;
        }
        ++m_counts.renderers;
        if(workload == s_OverridesWorkload){
            entity.addComponent<NWB::Impl::MaterialInstanceComponent>(Name(s_Interface));
            const Float4 tint(0.55f + static_cast<f32>(index) / 256.0f, 0.85f, 1.0f, 1.0f);
            if(!NWB::Impl::SetMaterialMutableHalf4(m_world, entity.id(), Name(s_Interface), "runtime.color_tint", tint))
                return false;
        }
    }
    if(m_runtime)
        SyncSmokeModelRuntimes(m_world);
    return true;
}


b8 RendererGatherBenchmarkScene::createBackdrop(){
    const auto backdrop = CreateTintedStaticMeshEntity(s_Plane, s_Opaque, s_Interface, Float4(0.1f, 0.1f, 0.1f, 1.0f), Float4(0.0f, 2.6f, 2.0f, 0.0f), Float4(5.0f, 1.0f, 3.5f, 0.0f), m_world);
    if(!backdrop.valid())
        return false;
    auto& transform = m_world.entity(backdrop).getComponent<NWB::Impl::Scene::TransformComponent>();
    StoreFloat(QuaternionRotationRollPitchYaw(-s_PIDIV2, 0.0f, 0.0f), transform.rotation);
    const Half4U f0 = MakeHalf4U(0.35f, 0.35f, 0.35f, 0.0f);
    const Half roughness = ConvertFloatToHalf(0.0f);
    if(!NWB::Impl::SetMaterialMutableParameter(m_world, backdrop, Name(s_Interface), "runtime.specular_f0", NWB::Impl::MaterialLayoutFieldType::f16x3, NWB::Impl::PackMaterialInstanceBytes(Span<const Half>(f0.raw, 3u))))
        return false;
    if(!NWB::Impl::SetMaterialMutableParameter(m_world, backdrop, Name(s_Interface), "runtime.perceptual_roughness", NWB::Impl::MaterialLayoutFieldType::f16, NWB::Impl::PackMaterialInstanceValue(roughness)))
        return false;
    ++m_counts.renderers;
    return true;
}

b8 RendererGatherBenchmarkScene::createRuntime(const u32 index, const Float4& position){
    const auto modelResult = CreateTintedModelEntity(s_Model, s_Opaque, s_Interface, Float4(0.9f, 0.45f, 0.2f, 1.0f), position, Float4(0.22f, 0.22f, 0.22f, 0.0f), m_world);
    const auto owner = modelResult.entity;
    if(!owner.valid() || !modelResult.tintApplied)
        return false;
    SyncSmokeModelRuntimes(m_world);
    const auto skeleton = FindSpawnedModelObject(owner, Name(NWB::Tests::Smoke::s_SmokeNameSkeleton), NWB::Impl::ModelObjectKind::Skeleton, m_world);
    if(!skeleton.valid())
        return false;
    auto& pose = m_world.entity(skeleton).getComponent<NWB::Impl::SkeletonPoseComponent>();
    if(pose.localJoints.size() < 2u)
        return false;
    const f32 yaw = (index & 8u) != 0u ? 0.08f : -0.08f;
    StoreFloat(MatrixMultiply(LoadFloat(pose.localJoints[1u]), MatrixRotationRollPitchYaw(0.0f, yaw, 0.0f)), pose.localJoints[1u]);
    ++m_counts.runtimeOwners;
    return true;
}


};


NWB_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_renderer_gather_benchmark{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


constexpr AStringView s_OpaqueWorkload = "opaque";
constexpr AStringView s_HybridWorkload = "hybrid";
constexpr AStringView s_UniqueWorkload = "unique";
constexpr AStringView s_OverridesWorkload = "overrides";
constexpr AStringView s_RuntimeWorkload = "runtime";
constexpr AStringView s_MemoryMode = "memory";

using namespace NWB;
using namespace NWB::Tests::Smoke;

static constexpr f32 s_FixedDelta = s_GatherBenchmarkFixedDelta;
static constexpr u32 s_InFlightRanges = s_GatherBenchmarkInFlightRanges;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TimingPass final : public NWB::Core::IRenderPass{
public:
    explicit TimingPass(NWB::Core::GraphicsRuntime& graphics)noexcept
        : IRenderPass(graphics)
    {}


public:
    [[nodiscard]] b8 prepareQueries(){
        auto& graphics = getGraphics();
        for(const StringView scope : RendererGatherBenchmarkProbe::s_GpuNames){
            if(scope == "render.reflection_depth_pyramid")
                continue;
            const auto scopeName = Name::FromText(scope);
            if(!scopeName)
                return false;
            if(!graphics.gpuTiming().prepareScopeQueries(*scopeName, graphics.getDevice(), s_InFlightRanges))
                return false;
        }
        return true;
    }

    virtual b8 shouldRenderUnfocused()noexcept override{ return true; }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererGatherBenchmarkProjectImpl final : public IProjectEntryCallbacks{
public:
    explicit RendererGatherBenchmarkProjectImpl(ProjectRuntimeContext& context)
        : m_context(context)
        , m_world(CreateSmokeWorldOrDie(FOUNDATION_TEXT("RendererGatherBenchmark"), context))
        , m_scene(*m_world)
        , m_timingPass(context.graphics)
        , m_probe(context.objectArena)
        , m_compilerProbe(context.graphics, context.objectArena)
        , m_workload(context.objectArena)
        , m_output(context.objectArena)
    {}
    virtual ~RendererGatherBenchmarkProjectImpl()noexcept override{ destroyWorld(); }


public:
    virtual b8 onStartup()override{
        NWB::Core::Alloc::ScratchArena scratchArena(NWB::Tests::Smoke::s_SmokeEnvironmentArena);
        auto requestedWorkload = ReadSmokeEnvironmentText(m_context.objectArena, "NWB_GATHER_BENCHMARK_WORKLOAD");
        if(!requestedWorkload)
            return false;
        auto requestedOutput = ReadSmokeEnvironmentText(m_context.objectArena, "NWB_GATHER_BENCHMARK_OUTPUT");
        if(!requestedOutput)
            return false;
        m_workload = Move(*requestedWorkload);
        m_output = Move(*requestedOutput);
        const AStringView workload(m_workload.data(), m_workload.size());
        if(workload != s_OpaqueWorkload && workload != s_HybridWorkload && workload != "shared" && workload != s_UniqueWorkload && workload != s_OverridesWorkload && workload != s_RuntimeWorkload)
            return false;
        const auto mode = ReadSmokeEnvironmentText(scratchArena, "NWB_GATHER_BENCHMARK_MODE");
        if(!mode || (*mode != "timing" && *mode != s_MemoryMode))
            return false;
        m_memoryEnabled = *mode == s_MemoryMode;
        m_runtime = workload == s_RuntimeWorkload;
        if(!m_context.graphics.queryFeatureSupport(NWB::Core::Feature::RayTracingAccelStruct) || !m_context.graphics.queryFeatureSupport(NWB::Core::Feature::RayQuery)){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererGatherBenchmark: hardware ray queries are required"));
            return false;
        }
        if(m_runtime)
            AddSmokeSkinnedRenderSystems(*m_world, m_context);
        else
            AddSmokeRenderSystems(*m_world, m_context);
        NWB::Impl::RendererSystem& renderer = *MakeNotNull(m_world->getSystem<NWB::Impl::RendererSystem>());
        m_worldReady = true;
        NWB::Impl::ReflectionSettings settings;
        settings.traceMode = NWB::Impl::ReflectionTraceMode::Hardware;
        settings.maxHardwareRaysPerFrame = 4096u;
        settings.maxOpticalQueries = 16u;
        settings.temporalEnabled = false;
        settings.spatialFilterEnabled = false;
        settings.screenFeedbackEnabled = false;
        settings.diagnosticsEnabled = false;
        settings.samplingSeed = 0u;
        if(!renderer.setReflectionSettings(settings))
            return false;
        renderer.setRefractionEnabled(true);
        renderer.setRefractionHardwareTracingEnabled(true);
        if(!m_scene.build(workload, m_runtime, scratchArena))
            return false;
        if(!m_timingPass.prepareQueries())
            return false;
        m_context.graphics.addRenderPassToBack(m_timingPass);
        m_timingRegistered = true;
        const auto compilerOutput = ReadSmokeEnvironmentText(scratchArena, "NWB_GATHER_COMPILER_STATISTICS_FILE");
        if(compilerOutput){
            if(!m_compilerProbe.start(AStringView(*compilerOutput), renderer))
                return false;
        }
        NWB::Core::Perf::CaptureOptions capture;
        capture.enabled = true;
        capture.cpuTiming = true;
        capture.gpuTiming = true;
        capture.memory = m_memoryEnabled;
        m_context.setPerfCapture(capture);
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("RendererGatherBenchmark: workload {} mode {} fixed objects 64"), ConvertString(workload), ConvertString(*mode));
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("RendererGatherBenchmark: hardware reflection 4096 queries 16 refraction 1 diagnostics 0 temporal 0 spatial 0 feedback 0"));
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("RendererGatherBenchmark: fixed delta 0.016666667 extent 960x720 async compute requested 1"));
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("RendererGatherBenchmark: vsync {}"), m_context.graphics.isVSyncEnabled() ? 1u : 0u);
        return true;
    }

    virtual void onShutdown()override{
        m_compilerProbe.stop();
        if(!m_compilerProbe.write())
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererGatherBenchmark: compiler statistics diagnostic is incomplete or could not be written"));
        if(!m_probe.write(AStringView(m_output), AStringView(m_workload), m_memoryEnabled, m_scene.counts().renderers, m_scene.counts().runtimeRenderers, m_scene.counts().transparentRenderers, m_scene.counts().runtimeOwners))
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererGatherBenchmark: complete result could not be written; successful frames {}"), m_probe.successfulFrames());
        destroyWorld();
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("RendererGatherBenchmark: shutdown successful frames {}"), m_probe.successfulFrames());
    }

    virtual b8 onUpdate(const f32)override{
        if(!m_probe.poll(m_context.perfSession.report(), m_memoryEnabled)){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererGatherBenchmark: incomplete or mismatched successful CPU frame"));
            return false;
        }
        if(m_probe.finished()){
            m_context.requestQuit();
            return true;
        }
        if(m_probe.successfulFrames() == 64u && !m_actualCountsRead){
            if(!readActualCounts())
                return false;
            m_actualCountsRead = true;
        }
        return TickSmokeWorld(s_FixedDelta, *m_world);
    }


private:
    [[nodiscard]] b8 readActualCounts(){
        NWB::Impl::MeshSystem& meshes = *MakeNotNull(m_world->getSystem<NWB::Impl::MeshSystem>());
        m_scene.counts().renderers = 0u;
        m_scene.counts().runtimeRenderers = 0u;
        auto view = m_world->view<NWB::Impl::RendererComponent>();
        for(auto&& [entity, renderer] : view){
            if(!renderer.visible)
                continue;
            const auto meshResult = meshes.resolveRenderableMeshStatus(entity);
            if(!meshResult)
                continue;
            const auto& mesh = *meshResult;
            ++m_scene.counts().renderers;
            if(mesh.runtime)
                ++m_scene.counts().runtimeRenderers;
        }
        if(m_scene.counts().renderers != 65u || (m_runtime && (m_scene.counts().runtimeRenderers != 8u || m_scene.counts().runtimeOwners != 8u)) || (!m_runtime && m_scene.counts().runtimeRenderers != 0u)){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererGatherBenchmark: actual ready renderer/runtime counts do not match the workload"));
            return false;
        }
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("RendererGatherBenchmark: warmed ready renderers {} runtime {} transparent {}"), m_scene.counts().renderers, m_scene.counts().runtimeRenderers, m_scene.counts().transparentRenderers);
        return true;
    }

    void destroyWorld(){
        m_compilerProbe.stop();
        if(m_timingRegistered){
            m_context.graphics.removeRenderPass(m_timingPass);
            m_timingRegistered = false;
        }
        if(!m_worldReady)
            return;
        if(m_runtime)
            DestroySmokeSkinnedRenderWorld(m_context, m_world);
        else
            DestroySmokeRenderWorld(m_context, m_world);
        m_worldReady = false;
    }


private:
    ProjectRuntimeContext& m_context;
    NotNullUniquePtr<NWB::Core::ECS::World> m_world;
    RendererGatherBenchmarkScene m_scene;
    TimingPass m_timingPass;
    RendererGatherBenchmarkProbe m_probe;
    RendererCompilerStatisticsProbe m_compilerProbe;
    SmokeEnvironmentString m_workload;
    SmokeEnvironmentString m_output;
    b8 m_runtime = false;
    b8 m_memoryEnabled = false;
    b8 m_worldReady = false;
    b8 m_timingRegistered = false;
    b8 m_actualCountsRead = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};

namespace NWB::Tests::Smoke{ using RendererGatherBenchmarkProjectImpl = __hidden_renderer_gather_benchmark::RendererGatherBenchmarkProjectImpl; }

NWB::ProjectFrameClientSize NWB::QueryProjectFrameClientSize(){ return { 960u, 720u }; }

TStringView NWB::QueryProjectWindowTitle()noexcept{ return FOUNDATION_TEXT("NWB Renderer Gather Benchmark"); }

UniquePtr<NWB::IProjectEntryCallbacks> NWB::CreateProjectEntryCallbacks(NWB::ProjectRuntimeContext& context){
    return MakeUnique<NWB::Tests::Smoke::RendererGatherBenchmarkProjectImpl>(context);
}
}


