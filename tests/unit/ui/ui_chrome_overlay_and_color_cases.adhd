class ChromeColorPickerTests : WidgetFixture{
    public ColorPickerState m_state;
    public ColorPickerResult m_result;

    public b8 renderPicker(in u64 generation, in ColorPickerOptions options){
        if(!this.panel(generation, "panel", Rect(10.0f, 10.0f, 300.0f, 340.0f)))
            return false;
        this.m_result = this.m_builder.colorPicker("cp", this.m_state, options);
