[[nodiscard]] FOUNDATION_INLINE b8 HasMetaField(const Core::Metascript::Value& parent, const AStringView name)noexcept{
    return parent.findField(name) != nullptr;
}

[[nodiscard]] FOUNDATION_INLINE const Core::Metascript::Value& GetMetaField(const Core::Metascript::Value& parent, const AStringView name)noexcept{
    return *parent.findField(name);
}

[[nodiscard]] FOUNDATION_INLINE b8 HasMetaVariable(const Core::Metascript::Document& document, const AStringView name)noexcept{
    return document.findVariable(name) != nullptr;
}

[[nodiscard]] FOUNDATION_INLINE const Core::Metascript::Value& GetMetaVariable(const Core::Metascript::Document& document, const AStringView name)noexcept{
    return *document.findVariable(name);
}

[[nodiscard]] FOUNDATION_INLINE b8 HasMetaDeclaration(const Core::Metascript::Document& document, const AStringView name)noexcept{
    return document.findDeclaration(name) != nullptr;
}

[[nodiscard]] FOUNDATION_INLINE AStringView GetMetaDeclarationVariable(const Core::Metascript::Document& document, const AStringView name)noexcept{
    const auto* decl = document.findDeclaration(name);
    return decl != nullptr ? AStringView(decl->variable) : AStringView();
}

[[nodiscard]] FOUNDATION_INLINE AStringView GetMetaDeclarationType(const Core::Metascript::Document& document, const AStringView name)noexcept{
    const auto* decl = document.findDeclaration(name);
    return decl != nullptr ? AStringView(decl->type) : AStringView();
}

[[nodiscard]] FOUNDATION_INLINE b8 IsFirstMetaDeclaration(const Core::Metascript::Document& document, const AStringView name)noexcept{
    const auto* decl = document.findDeclaration(name);
    return decl != nullptr && !document.declarations().empty() && decl == &document.declarations().front();
}

[[nodiscard]] FOUNDATION_INLINE Core::Assets::ExpandedAssetMetadataVector MoveExpandedBunchVector(Core::Assets::ExpandedAssetMetadataVector&& source)noexcept{
    return Move(source);
}

FOUNDATION_INLINE void VerifyOwnedBunchOutput(const Core::Assets::ExpandedAssetMetadataVector& output, const Core::Metascript::Document& document){
    using Core::Metascript::Value;
    ASSERT_EQ(output.size(), 2u);
    EXPECT_EQ(output[0u].virtualPath, Name("project/fixtures/bundle/second"));
    EXPECT_EQ(output[1u].virtualPath, Name(s_ProjectFixturesBundleFirst));
    const Value* const items = output[0u].value.findField(s_BunchItemsField);
    ASSERT_NE(items, nullptr);
    ASSERT_TRUE(items->isList());
    ASSERT_EQ(items->asList().size(), 2u);
    const Value* const label = items->asList()[0u].findField(s_BunchLabel);
    ASSERT_NE(label, nullptr);
    EXPECT_EQ(label->asString(), s_ASeparatelyOwnedMetadataString);
    const Value* const target = items->asList()[1u].findField(s_FieldTarget);
    ASSERT_NE(target, nullptr);
    EXPECT_EQ(target->asString(), s_ProjectFixturesBundleFirst);
    const Value* const first = document.findVariable("first");
    ASSERT_NE(first, nullptr);
    const Value* const sourceTarget = first->findField(s_FieldTarget);
    ASSERT_NE(sourceTarget, nullptr);
    EXPECT_TRUE(sourceTarget->isReference());
    EXPECT_EQ(sourceTarget->asReference(), "second");
    const Value* const sourceLocal = first->findField(s_BunchLocal);
    ASSERT_NE(sourceLocal, nullptr);
    EXPECT_TRUE(sourceLocal->isReference());
    EXPECT_EQ(sourceLocal->asReference(), s_BunchLocal);
}

[[nodiscard]] FOUNDATION_INLINE b8 ParseBunchLookupFixture(const AStringView metadata, const usize unusedDeclarations, BunchFixture& fixture){
    AString<Core::Alloc::ScratchArena> source(fixture.scratchArena);
    source.reserve(unusedDeclarations * 32u + metadata.size());
    for(usize index = 0u; index < unusedDeclarations; ++index)
        source += StringFormat(fixture.scratchArena, "metadata unused_{};\n", index);
    source.append(metadata.data(), metadata.size());
    return fixture.document.parse(AStringView(source));
}

struct ScratchBunchSentinel final : NoCopy{
    Core::Alloc::ScratchArena& arena;
    u8* bytes = nullptr;


public:
    explicit ScratchBunchSentinel(Core::Alloc::ScratchArena& owner)noexcept
        : arena(owner)
        , bytes(static_cast<u8*>(owner.allocate(1u, 32u)))
    {
        if(bytes != nullptr){
            for(usize index = 0u; index < 32u; ++index)
                bytes[index] = static_cast<u8>(index + 73u);
        }
    }
    ~ScratchBunchSentinel()noexcept{
        release();
    }


public:
    [[nodiscard]] b8 valid()const noexcept{ return bytes != nullptr; }

    [[nodiscard]] b8 intact()const noexcept{
        if(bytes == nullptr)
            return false;
        for(usize index = 0u; index < 32u; ++index){
            if(bytes[index] != static_cast<u8>(index + 73u))
                return false;
        }
        return true;
    }

    void release()noexcept{
        if(bytes != nullptr){
            arena.deallocate(bytes, 1u, 32u);
            bytes = nullptr;
        }
    }
};

template<typename BytesT>
[[nodiscard]] FOUNDATION_INLINE Expected<NwbAssetCacheFileHeader> ReadNwbCacheFileHeader(const BytesT& bytes)noexcept{
    usize cursor = 0u;
    return ReadPOD<NwbAssetCacheFileHeader>(Span<const u8>(bytes.data(), bytes.size()), cursor);
}

[[nodiscard]] FOUNDATION_INLINE b8 BuildAndGatherWithExplicitRepoRoot(TestArena& testArena, const Path& root, const Path& assetRoot, const Path& builtDir, const Path& outDir){
    NWB::Core::CpuTaskScheduler cookCpuTaskScheduler(0u);
    NWB::Core::Alloc::ScratchArena scratchArena(s_CodecScratchArena);
    NWB::Pipeline::AssetBuilder::AssetBuildOptions buildOptions(testArena.arena, cookCpuTaskScheduler);
    buildOptions.repoRoot = root;
    buildOptions.outputDirectory = builtDir;
    if(!buildOptions.configuration.assign(s_TestsConfiguration) || !buildOptions.assetType.assign("graphics"))
        return false;
    buildOptions.assetRoots.emplace_back(assetRoot, NWB::Core::Assets::s_ProjectVirtualRoot);
    if(!NWB::Pipeline::AssetBuilder::BuildAssets(buildOptions, scratchArena))
        return false;

    NWB::Pipeline::AssetGatherer::AssetGatherOptions gatherOptions(testArena.arena);
    gatherOptions.inputs.emplace_back(PathToString(testArena.arena, builtDir));
    gatherOptions.outputDirectory = PathToString(testArena.arena, outDir);
    gatherOptions.configuration = s_TestsConfiguration.data();
    return NWB::Pipeline::AssetGatherer::GatherAssets(gatherOptions, scratchArena);
}

[[nodiscard]] FOUNDATION_INLINE b8 GatherBuiltDirectoryToOutput(TestArena& testArena, const Path& builtDir, const Path& outDir, Core::Alloc::ScratchArena& scratchArena){
    NWB::Pipeline::AssetGatherer::AssetGatherOptions options(testArena.arena);
    options.inputs.emplace_back(PathToString(testArena.arena, builtDir));
    options.outputDirectory = PathToString(testArena.arena, outDir);
    options.configuration = s_TestsConfiguration.data();
    return NWB::Pipeline::AssetGatherer::GatherAssets(options, scratchArena);
}

[[nodiscard]] FOUNDATION_INLINE Expected<SamplerAsset> LoadCookedSamplerAsset(const Path& outputDirectory, const Name assetName, const usize expectedVolumeFileCount, TestArena& testArena){
    auto loaded = LoadCookedAsset<NWB::Impl::SamplerAssetCodec>(outputDirectory, assetName, expectedVolumeFileCount, testArena);
    if(!loaded)
        return MakeUnexpected(loaded.error());
    return Move(static_cast<NWB::Impl::Sampler&>(**loaded));
}

