NWB_ADHD_GTEST_F(UiPointerGestureTests, ActiveGestureKeepsOriginalLayoutWhenNewGeometryIsPublished, VerifyUiPointerGestureTests_ActiveGestureKeepsOriginalLayoutWhenNewGeometryIsPublished)
