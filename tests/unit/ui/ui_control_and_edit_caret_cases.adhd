    EXPECT_EQ(byte.value(), 3u);
    byte = self.m_geometry.hitTest(Point(999.0f, 13.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 3u);
    byte = self.m_geometry.hitTest(Point(0.0f, 23.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 4u);
    byte = self.m_geometry.hitTest(Point(999.0f, 23.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 4u);
    byte = self.m_geometry.hitTest(Point(0.0f, 18.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 4u);
    byte = self.m_geometry.hitTest(Point(999.0f, 18.0f));
