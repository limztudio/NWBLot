void VerifyUiNestedPopupContextTests_NestedActivationRestoresExactParentScopeAndLayer(mut UiNestedPopupContextTests self){
    ASSERT_TRUE(self.begin(1u));
    const auto parentResult = self.reserve(s_UiNestedPopupContextParentKey);
    ASSERT_TRUE(parentResult.has_value());
    const UiNestedPopupContextPopupDeclaration parent = parentResult.value();
    EXPECT_FALSE(self.m_context.popupToken().valid());
    ASSERT_TRUE(self.m_context.activatePopupScope(parent.scope.token));
    ASSERT_TRUE(self.publish(parent));
    const auto childResult = self.reserve(s_UiNestedPopupContextChildKey, MakeUiMultilinePopupRect(180.0f, 120.0f, 100.0f, 70.0f));
    ASSERT_TRUE(childResult.has_value());
    const UiNestedPopupContextPopupDeclaration child = childResult.value();
    EXPECT_EQ(child.scope.parent, parent.scope.token);
    EXPECT_EQ(self.m_context.popupToken(), parent.scope.token);
    EXPECT_EQ(self.m_context.popupLayer(), 1u);
    ASSERT_TRUE(self.m_context.activatePopupScope(child.scope.token));
    ASSERT_TRUE(self.publish(child));
    EXPECT_EQ(self.m_context.popupToken(), child.scope.token);
    EXPECT_EQ(self.m_context.popupLayer(), 2u);
    ASSERT_TRUE(self.m_context.endPopupScope(true));
    EXPECT_EQ(self.m_context.popupToken(), parent.scope.token);
    EXPECT_EQ(self.m_context.popupLayer(), 1u);
    ASSERT_TRUE(self.m_context.endPopupScope(true));
    EXPECT_FALSE(self.m_context.popupToken().valid());
    EXPECT_EQ(self.m_context.popupLayer(), 0u);
    ASSERT_TRUE(self.finish());
    EXPECT_FALSE(self.m_context.input().hasPopup());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    EXPECT_EQ(self.m_context.input().focus(), child.action.id);
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiMultilinePopupPoint(185.0f, 125.0f)), child.action.id);
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiMultilinePopupPoint(65.0f, 45.0f)).valid());
}

void VerifyUiNestedPopupContextTests_ReservationOrderControlsLayersAcrossReactivationAndReversePaintOrder(mut UiNestedPopupContextTests self){
    ASSERT_TRUE(self.begin(1u));
    const auto parentResult = self.reserve(s_UiNestedPopupContextParentKey, MakeUiMultilinePopupRect(30.0f, 30.0f, 150.0f, 110.0f));
    ASSERT_TRUE(parentResult.has_value());
    const UiNestedPopupContextPopupDeclaration parent = parentResult.value();
    ASSERT_TRUE(self.m_context.activatePopupScope(parent.scope.token));
    const auto firstResult = self.reserve("first", MakeUiMultilinePopupRect(1.0f, 1.0f, 1.0f, 1.0f));
    ASSERT_TRUE(firstResult.has_value());
    UiNestedPopupContextPopupDeclaration first = firstResult.value();
    const auto secondResult = self.reserve("second", MakeUiMultilinePopupRect(1.0f, 1.0f, 1.0f, 1.0f));
    ASSERT_TRUE(secondResult.has_value());
    UiNestedPopupContextPopupDeclaration second = secondResult.value();
    EXPECT_EQ(self.m_context.popupLayer(first.scope.token), 2u);
    EXPECT_EQ(self.m_context.popupLayer(second.scope.token), 3u);
    ASSERT_TRUE(self.m_context.endPopupScope(true));
    first.scope.bounds = MakeUiMultilinePopupRect(100.0f, 70.0f, 100.0f, 60.0f);
    second.scope.bounds = first.scope.bounds;
    ASSERT_TRUE(self.m_context.updatePopupScope(first.scope.token, first.scope));
    ASSERT_TRUE(self.m_context.updatePopupScope(second.scope.token, second.scope));
    ASSERT_TRUE(self.m_context.activatePopupScope(parent.scope.token));
    ASSERT_TRUE(self.publish(parent));
    ASSERT_TRUE(self.m_context.activatePopupScope(second.scope.token));
    ASSERT_TRUE(self.publish(second));
    ASSERT_TRUE(self.m_context.endPopupScope(true));
    ASSERT_TRUE(self.m_context.activatePopupScope(first.scope.token));
    ASSERT_TRUE(self.publish(first));
    ASSERT_TRUE(self.m_context.endPopupScope(true));
    ASSERT_TRUE(self.m_context.endPopupScope(true));
    EXPECT_EQ(self.m_context.topPopupToken(), second.scope.token);
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const Optional<HitTarget> firstTarget = self.findTarget(first.action.id);
    const Optional<HitTarget> secondTarget = self.findTarget(second.action.id);
    ASSERT_TRUE(firstTarget.has_value());
    ASSERT_TRUE(secondTarget.has_value());
    EXPECT_EQ(firstTarget.value().layer, 2u);
    EXPECT_EQ(secondTarget.value().layer, 3u);
    EXPECT_GT(firstTarget.value().paintOrder, secondTarget.value().paintOrder);
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiMultilinePopupPoint(105.0f, 75.0f)), second.action.id);
    EXPECT_EQ(self.m_context.input().focus(), second.action.id);
}

void VerifyUiNestedPopupContextTests_HiddenAncestorDropsReservedDescendantsAndTheirPublishedTargets(mut UiNestedPopupContextTests self){
    ASSERT_TRUE(self.begin(1u));
    const auto parentResult = self.reserve(s_UiNestedPopupContextParentKey);
    ASSERT_TRUE(parentResult.has_value());
    const UiNestedPopupContextPopupDeclaration parent = parentResult.value();
    ASSERT_TRUE(self.m_context.activatePopupScope(parent.scope.token));
    ASSERT_TRUE(self.publish(parent));
    const auto childResult = self.reserve(s_UiNestedPopupContextChildKey);
    ASSERT_TRUE(childResult.has_value());
    const UiNestedPopupContextPopupDeclaration child = childResult.value();
    ASSERT_TRUE(self.m_context.activatePopupScope(child.scope.token));
    ASSERT_TRUE(self.publish(child));
    const auto deferredResult = self.reserve("deferred");
    ASSERT_TRUE(deferredResult.has_value());
    const UiNestedPopupContextPopupDeclaration deferred = deferredResult.value();
    ASSERT_TRUE(self.m_context.endPopupScope(true));
    ASSERT_TRUE(self.m_context.endPopupScope(false));
    EXPECT_FALSE(self.m_context.hasPopupScope(parent.scope.token));
    EXPECT_FALSE(self.m_context.hasPopupScope(child.scope.token));
    EXPECT_FALSE(self.m_context.hasPopupScope(deferred.scope.token));
    EXPECT_FALSE(self.m_context.topPopupToken().valid());
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_TRUE(self.m_context.input().targets().empty());
}

void VerifyUiNestedPopupContextTests_DiscardingInactiveFamilyPreservesAnUnrelatedTopLevelScopeAndItsLayer(mut UiNestedPopupContextTests self){
    ASSERT_TRUE(self.begin(1u));
    const auto parentResult = self.reserve(s_UiNestedPopupContextParentKey);
    ASSERT_TRUE(parentResult.has_value());
    const UiNestedPopupContextPopupDeclaration parent = parentResult.value();
    ASSERT_TRUE(self.m_context.activatePopupScope(parent.scope.token));
    ASSERT_TRUE(self.publish(parent));
    const auto childResult = self.reserve(s_UiNestedPopupContextChildKey);
    ASSERT_TRUE(childResult.has_value());
    const UiNestedPopupContextPopupDeclaration child = childResult.value();
    ASSERT_TRUE(self.m_context.activatePopupScope(child.scope.token));
    ASSERT_TRUE(self.publish(child));
    ASSERT_TRUE(self.m_context.endPopupScope(true));
    ASSERT_TRUE(self.m_context.endPopupScope(true));
    const auto unrelatedResult = self.reserve("unrelated", MakeUiMultilinePopupRect(240.0f, 170.0f, 100.0f, 70.0f));
    ASSERT_TRUE(unrelatedResult.has_value());
    const UiNestedPopupContextPopupDeclaration unrelated = unrelatedResult.value();
    ASSERT_TRUE(self.m_context.activatePopupScope(unrelated.scope.token));
    ASSERT_TRUE(self.publish(unrelated));
    ASSERT_TRUE(self.m_context.endPopupScope(true));
    self.m_context.discardPopupScope(parent.scope.token);
    self.m_context.discardPopupScope(parent.scope.token);
    EXPECT_FALSE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.hasPopupScope(parent.scope.token));
    EXPECT_FALSE(self.m_context.hasPopupScope(child.scope.token));
    EXPECT_TRUE(self.m_context.hasPopupScope(unrelated.scope.token));
    EXPECT_EQ(self.m_context.popupLayer(unrelated.scope.token), 3u);
    EXPECT_EQ(self.m_context.topPopupToken(), unrelated.scope.token);
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    ASSERT_EQ(self.m_context.input().targets().size(), 2u);
    EXPECT_EQ(self.m_context.input().focus(), unrelated.action.id);
}

void VerifyUiNestedPopupContextTests_DiscardingInactiveChildKeepsItsActiveParentBalanced(mut UiNestedPopupContextTests self){
    ASSERT_TRUE(self.begin(1u));
