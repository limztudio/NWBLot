using GpuCmdIrCompiledGraphReadView = Core::GpuCompiledGraph::ReadView;
using GpuCmdIrValidationErrorEnum = Core::GpuCommandIrStreamValidationError::Enum;
using GpuCmdIrReadStatusEnum = Core::GpuCommandIrStreamReadStatus::Enum;
using GpuCmdIrReplayErrorEnum = Core::GpuCommandIrReplayError::Enum;
using GpuCmdIrWireOpcodeEnum = Core::GpuCommandIrWireOpcode::Enum;
using GpuCmdIrRasterReplayState = Core::GpuCommandIrDetail::RasterReplayState;

struct GpuCmdIrOwnerReleaseProbe{
    u32* releases = nullptr;


public:
    explicit GpuCmdIrOwnerReleaseProbe(u32& value)noexcept
        : releases(&value)
    {}
    GpuCmdIrOwnerReleaseProbe(const GpuCmdIrOwnerReleaseProbe&) = delete;
    GpuCmdIrOwnerReleaseProbe(GpuCmdIrOwnerReleaseProbe&& other)noexcept
        : releases(Exchange(other.releases, nullptr))
    {}
    ~GpuCmdIrOwnerReleaseProbe()noexcept{
        if(releases)
            ++*releases;
    }
};

inline constexpr usize s_GpuCmdIrStreamHeaderBytes = sizeof(Core::GpuCommandIrStreamHeader);
inline constexpr usize s_GpuCmdIrRecordHeaderBytes = sizeof(Core::GpuCommandIrHeader);
inline constexpr usize s_GpuCmdIrCopyBufferRecordBytes = sizeof(Core::GpuCommandIrCopyBufferRecord);
inline constexpr usize s_GpuCmdIrCopyTextureRecordBytes = sizeof(Core::GpuCommandIrCopyTextureRecord);
inline constexpr usize s_GpuCmdIrClearBufferRecordBytes = sizeof(Core::GpuCommandIrClearBufferRecord);
inline constexpr usize s_GpuCmdIrSetGraphicsStateRecordBytes = sizeof(Core::GpuCommandIrSetGraphicsStateRecord);
inline constexpr usize s_GpuCmdIrUploadBufferRecordBytes = sizeof(Core::GpuCommandIrUploadBufferRecord);

inline constexpr usize s_GpuCmdIrHdrMagicOffset = offsetof(Core::GpuCommandIrStreamHeader, magic);
inline constexpr usize s_GpuCmdIrHdrVersionOffset = offsetof(Core::GpuCommandIrStreamHeader, version);
inline constexpr usize s_GpuCmdIrPrefixVersionOffset = offsetof(Core::GpuCommandIrStreamHeaderPrefix, version);
inline constexpr usize s_GpuCmdIrHdrReservedOffset = offsetof(Core::GpuCommandIrStreamHeader, reserved);
inline constexpr usize s_GpuCmdIrHdrCommandBytesOffset = offsetof(Core::GpuCommandIrStreamHeader, commandBytes);
inline constexpr usize s_GpuCmdIrHdrBlobBytesOffset = offsetof(Core::GpuCommandIrStreamHeader, blobBytes);
inline constexpr usize s_GpuCmdIrHdrGraphGenOffset = offsetof(Core::GpuCommandIrStreamHeader, graphGeneration);
inline constexpr usize s_GpuCmdIrHdrPlanGenOffset = offsetof(Core::GpuCommandIrStreamHeader, planGeneration);
inline constexpr usize s_GpuCmdIrHdrRecordCountOffset = offsetof(Core::GpuCommandIrStreamHeader, recordCount);

inline constexpr usize s_GpuCmdIrRecByteSizeOffset = offsetof(Core::GpuCommandIrHeader, byteSize);
inline constexpr usize s_GpuCmdIrRecOpcodeOffset = offsetof(Core::GpuCommandIrHeader, opcode);

inline constexpr usize s_GpuCmdIrPushBlobOffsetOffset = offsetof(Core::GpuCommandIrSetPushConstantsRecord, blobOffsetBytes);
inline constexpr usize s_GpuCmdIrGfxViewportMaxXOffset = offsetof(Core::GpuCommandIrSetGraphicsStateRecord, viewportMaxX);
inline constexpr usize s_GpuCmdIrCopyBufDataSizeOffset = offsetof(Core::GpuCommandIrCopyBufferRecord, dataSizeBytes);
inline constexpr usize s_GpuCmdIrCopyBufSrcResOffset = offsetof(Core::GpuCommandIrCopyBufferRecord, sourceResourceIndex);
inline constexpr usize s_GpuCmdIrCopyBufQueueGenOffset =
    offsetof(Core::GpuCommandIrCopyBufferRecord, context) + offsetof(Core::GpuCommandIrRecordContext, queueDeviceGeneration);
inline constexpr usize s_GpuCmdIrCopyTexDstResOffset = offsetof(Core::GpuCommandIrCopyTextureRecord, destinationResourceIndex);
inline constexpr usize s_GpuCmdIrClearBufDstResOffset = offsetof(Core::GpuCommandIrClearBufferRecord, destinationResourceIndex);
inline constexpr usize s_GpuCmdIrClearTexNumMipsOffset =
    offsetof(Core::GpuCommandIrClearTextureRecord, destinationSubresources) + offsetof(Core::GpuCommandIrTextureSubresourceSet, numMipLevels);
inline constexpr usize s_GpuCmdIrClearTexValueTypeOffset = offsetof(Core::GpuCommandIrClearTextureRecord, clearTextureValueType);
inline constexpr usize s_GpuCmdIrClearTexFlagsOffset = offsetof(Core::GpuCommandIrClearTextureRecord, clearFlags);
inline constexpr usize s_GpuCmdIrClearTexReservedOffset = offsetof(Core::GpuCommandIrClearTextureRecord, reserved);
inline constexpr usize s_GpuCmdIrUploadTexBlobOffsetOffset = offsetof(Core::GpuCommandIrUploadTextureRecord, blobOffsetBytes);
inline constexpr usize s_GpuCmdIrUploadTexBlobSizeOffset = offsetof(Core::GpuCommandIrUploadTextureRecord, blobSizeBytes);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


