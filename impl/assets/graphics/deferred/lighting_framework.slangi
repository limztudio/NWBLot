////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_DEFERRED_LIGHTING_FRAMEWORK_SLANGI
#define NWB_GRAPHICS_DEFERRED_LIGHTING_FRAMEWORK_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Deferred lighting framework: the engine-provided library a deferred lighting shader (engine default or a
// project override) builds on. It exposes the surface inputs the geometry pass packed into the G-buffer
// (base color, normal, world position, the shading-model id + two BXDF params from the alpha channels), the
// scene light list + per-light resolve, and the shadow-visibility accessor. The lighting shader itself owns
// the loop: it loads the surface, dispatches on surface.shadingModel to a (user-authored) BXDF that walks the
// lights, applies per-light visibility, and tonemaps. Nothing here hard-codes a shading model.


#include "binding_slots.h"
#include "bxdf_surface.slangi"
#include "bindless_resources.slangi"
#include "../scene/binding_slots.h"

// The scene shading cbuffer + light list live in the deferred lighting binding set; point scene/buffer.slangi
// (pulled in via scene/lighting.slangi) at those slots before it declares them.
#ifndef NWB_SCENE_SHADING_SET
#define NWB_SCENE_SHADING_SET NWB_DEFERRED_LIGHTING_SET
#endif
#ifndef NWB_SCENE_SHADING_BINDING
#define NWB_SCENE_SHADING_BINDING NWB_DEFERRED_LIGHTING_BINDING_SCENE_SHADING
#endif
#ifndef NWB_SCENE_LIGHT_LIST_SET
#define NWB_SCENE_LIGHT_LIST_SET NWB_DEFERRED_LIGHTING_SET
#endif
#ifndef NWB_SCENE_LIGHT_LIST_BINDING
#define NWB_SCENE_LIGHT_LIST_BINDING NWB_DEFERRED_LIGHTING_BINDING_LIGHT_LIST
#endif
// G-buffer, screen-space shadow/caustic/GI inputs, and the shared sampler are now global-heap entries. The local
// lighting set carries this small target-generation cbuffer plus the scene/light buffers below. Define the scene
// accessors before lighting.slangi so its ordinary local declarations remain available to non-deferred consumers.
[[vk::binding(NWB_DEFERRED_LIGHTING_BINDING_BINDLESS_RESOURCES, NWB_DEFERRED_LIGHTING_SET)]]
ConstantBuffer<NwbDeferredBindlessResources, Std140DataLayout> g_NwbDeferredBindlessResources;

#define NWB_SCENE_SHADOW_VISIBILITY_RESOURCE NwbHeapSampledImage2DArray(g_NwbDeferredBindlessResources.lightingSlots.x)
#define NWB_SCENE_CAUSTIC_IRRADIANCE_RESOURCE NwbHeapSampledImage2D(g_NwbDeferredBindlessResources.lightingSlots.y)
// Brings common/math (nwbSafeNormalize, frame helpers), scene/buffer (g_NwbSceneLights, nwbSceneLightCount,
// g_NwbSceneCameraPosition, nwbSceneResolveLight) and the engine's default BRDF lobe (nwbSceneShadeLight) +
// whole-surface model (nwbSceneApplyLighting). A project BXDF may use or ignore the default model.
#include "../scene/lighting.slangi"

#undef NWB_SCENE_SHADOW_VISIBILITY_RESOURCE
#undef NWB_SCENE_CAUSTIC_IRRADIANCE_RESOURCE


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Resolved surfel-GI indirect irradiance (RGBA16F, screen space): the surfel_resolve_cs COMPUTE pass gathered the
// surfel field once per pixel into this texture (rgb = indirect irradiance, a = 1 where a surfel covered the pixel,
// 0 = none). The lighting reads THIS texture rather than the read-write surfel pool, so the pool stays off the pixel
// shader (compute-only) -- that is what kills the frames-in-flight pool race. Cleared to 0 (a = 0 -> hemiAmbient) when
// no surfel producer ran this frame, so an unbound/disabled GI is a correct hemiAmbient no-op.

// Indirect irradiance for the OPAQUE deferred path: read the resolved surfel texture at THIS pixel; where no surfel
// covered it (a < 0.5) fall back to the hemiAmbient ambient term. The resolve texture is 1:1 with the screen, so use a
// point Load; a bilinear tap would blend the coverage flag + irradiance across the covered/uncovered boundary.
half3 nwbBxdfResolvedIndirect(float2 uv, float3 normalVector){
    uint width;
    uint height;
    NwbHeapSampledImage2D(g_NwbDeferredBindlessResources.lightingSlots.z).GetDimensions(width, height);
    const int2 pixel = int2(uv * float2(width, height));
    const half4 resolved = half4(NwbHeapSampledImage2D(g_NwbDeferredBindlessResources.lightingSlots.z).Load(int3(pixel, 0)));
    return resolved.a > 0.5 ? half3(resolved.rgb) : nwbGiHemiAmbient(normalVector);
}

struct NwbDeferredLightingPixelInput{
    float4 position : SV_Position;
    [[vk::location(NWB_DEFERRED_FULLSCREEN_UV_LOCATION)]] float2 uv : TEXCOORD0;
};

struct NwbDeferredLightingPixelOutput{
    [[vk::location(NWB_DEFERRED_COLOR_TARGET_LOCATION)]] half4 color : SV_Target0;
};

// NwbBxdfSurface (the BXDF parameter type) is shared with the transparent / AVBOIT accumulate path; it lives
// in deferred/bxdf_surface.slangi, included above.


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


float3 nwbDeferredDecodeNormal(half3 value){
    return nwbSafeNormalize(float3(value) * 2.0 - 1.0, float3(0.0, 0.0, 1.0));
}

// Unpack the G-buffer at a fullscreen UV into the surface a BXDF reads.
NwbBxdfSurface nwbBxdfLoadSurface(float2 uv){
    const SamplerState sampler = NwbHeapSampler(g_NwbDeferredBindlessResources.lightingSlots.w);
    const half4 baseColorSample = half4(NwbHeapSampledImage2D(g_NwbDeferredBindlessResources.gbufferSlots.x).Sample(sampler, uv));
    const half4 normalSample = half4(NwbHeapSampledImage2D(g_NwbDeferredBindlessResources.gbufferSlots.y).Sample(sampler, uv));
    const float4 worldSample = NwbHeapSampledImage2D(g_NwbDeferredBindlessResources.gbufferSlots.z).Sample(sampler, uv);
    const float depth = NwbHeapSampledImage2D(g_NwbDeferredBindlessResources.gbufferSlots.w).Sample(sampler, uv).r;

    NwbBxdfSurface surface;
    surface.baseColor = baseColorSample.rgb;
    surface.shadingModel = uint(float(baseColorSample.a) + 0.5);
    surface.normal = nwbDeferredDecodeNormal(normalSample.rgb);
    surface.param0 = normalSample.a;
    surface.worldPosition = worldSample.xyz;
    surface.param1 = half(worldSample.a);
    surface.viewVector = nwbSafeNormalize(g_NwbSceneCameraPosition.xyz - surface.worldPosition, float3(0.0, 0.0, 1.0));
    surface.isBackground = depth >= 0.999999;
    surface.indirectIrradiance = nwbBxdfResolvedIndirect(uv, surface.normal);
    return surface;
}

// Default Reinhard tonemap the engine model uses; a project BXDF may reuse or replace it.
half3 nwbBxdfTonemap(half3 color){
    return color / (color + half3(0.65));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

