#include <impl/assets_scene/component_binary.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidLightComponentParameters(in LightComponent component){
    VectorSingle color = component.color();
    f32 intensity = component.intensity();
    b8 validType =
        component.type == LightType::Directional
        || component.type == LightType::Point
        || component.type == LightType::Spot
    ;
    if(
        !validType
        || !isFinite(color.x) || !isFinite(color.y) || !isFinite(color.z)
        || color.x < 0.0f || color.y < 0.0f || color.z < 0.0f
        || !isFinite(intensity) || intensity <= 0.0f
        || !isFinite(component.range) || component.range <= 0.0f
        || !isFinite(component.angularRadius) || component.angularRadius < 0.0f
        || !isFinite(component.sourceRadius) || component.sourceRadius < 0.0f
    )
        return false;
    return true;
}

b8 IsAllowedTransformComponentField(in StringView fieldName){
    return
        fieldName == s_TransformPositionField
        || fieldName == s_TransformRotationField
        || fieldName == s_TransformRotationEulerField
        || fieldName == s_TransformRotationEulerDegreesField
        || fieldName == s_TransformScaleField
    ;
}

b8 IsAllowedCameraComponentField(in StringView fieldName){
    return
        fieldName == s_CameraVerticalFovDegreesField
        || fieldName == s_CameraVerticalFovRadiansField
        || fieldName == s_CameraNearPlaneField
        || fieldName == s_CameraFarPlaneField
        || fieldName == s_CameraAspectRatioField
    ;
}

b8 IsAllowedLightComponentField(in StringView fieldName){
    return
        fieldName == s_LightTypeField
        || fieldName == s_LightColorField
        || fieldName == s_LightIntensityField
        || fieldName == s_LightRangeField
        || fieldName == s_LightInnerConeCosField
        || fieldName == s_LightOuterConeCosField
        || fieldName == s_LightAngularRadiusField
        || fieldName == s_LightSourceRadiusField
        || fieldName == s_LightEnableCausticsField
    ;
}

Expected<VectorSingle> TryNormalizeTransformQuaternion(in f32 x, in f32 y, in f32 z, in f32 w){
    const VectorSingle rawQuaternion(x, y, z, w);
    const f32 lenSq = lengthSq(rawQuaternion);
    if(!isFinite(lenSq) || lenSq <= s_SceneMinQuaternionLengthSq)
        return makeUnexpected(Failure());

    return normalize(rawQuaternion);
}

b8 IsValidTransformComponentParameters(in TransformComponent component){
    if(
        !isFinite(component.position.x) || !isFinite(component.position.y) || !isFinite(component.position.z)
        || !isFinite(component.rotation.x) || !isFinite(component.rotation.y) || !isFinite(component.rotation.z) || !isFinite(component.rotation.w)
        || !isFinite(component.scale.x) || !isFinite(component.scale.y) || !isFinite(component.scale.z)
    )
        return false;

    const f32 rotationLengthSq = lengthSq(VectorSingle(component.rotation));
    return isFinite(rotationLengthSq) && abs(rotationLengthSq - 1.0f) <= s_TransformRotationUnitLengthSquaredTolerance;
}

b8 ValidateComponentHeaderBinary(in ComponentHeaderBinary header, in Name assetType, in usize remainingBytes){
    if(header.version != s_ComponentVersion){
        error("IComponent::loadBinary failed: unsupported version {}", header.version);
        return false;
    }
    if(header.componentTypeHash != assetType.hash()){
        error("IComponent::loadBinary failed: component binary type does not match '{}'", assetType.resolvedText());
        return false;
    }
    if(header.payloadByteCount > cast<u64>(remainingBytes)){
        error("IComponent::loadBinary failed: truncated component payload");
        return false;
    }
    return true;
}

b8 ValidateTransformComponentAssetPayload(in TransformComponent component, in Name virtualPath){
    if(IsValidTransformComponentParameters(component))
        return true;

    error(
        "TransformComponentAsset::validatePayload failed: transform '{}' must have finite position/scale and unit quaternion rotation"
        , virtualPath.resolvedText()
    );
    return false;
}

b8 ValidateCameraComponentAssetPayload(in CameraComponent component, in Name virtualPath){
    const VectorSingle projection(component.projection);
    const f32 aspectRatio = projection.w;
    const Expected<CameraProjection> builtProjection = TryBuildCameraProjection(
        projection.x,
        projection.y,
        projection.z,
        aspectRatio,
        s_CameraFallbackAspectRatio
    );
    if(
        !isFinite(projection.x) || !isFinite(projection.y) || !isFinite(projection.z) || !isFinite(projection.w)
        || aspectRatio < 0.0f
        || !builtProjection.has_value()
    ){
        error(
            "CameraComponentAsset::validatePayload failed: camera '{}' has invalid projection parameters"
            , virtualPath.resolvedText()
        );
        return false;
    }
    return true;
}

b8 ValidateLightComponentAssetPayload(in LightComponent component, in Name virtualPath){
    if(IsValidLightComponentParameters(component) && IsValidLightCone(component.innerConeCos, component.outerConeCos))
        return true;

    error(
        "LightComponentAsset::validatePayload failed: light '{}' has invalid parameters"
        , virtualPath.resolvedText()
    );
    return false;
}

[serialize]
class SceneAssetEntryBinary{
    public NameHash nicknameHash;
    public NameHash assetHash;
}

const usize s_ComponentHeaderBinaryBytes = 80u;

void PackComponentAssetEnvelope(
    in NameHash componentTypeHash,
    in Span<u8> payload,
    mut Vector<u8> outBinary
){
    const ComponentHeaderBinary header = MakeComponentHeaderBinary(componentTypeHash, cast<u64>(payload.size()));
    outBinary.clear();
    outBinary.reserve(s_ComponentHeaderBinaryBytes + payload.size());
    AppendPOD(outBinary, header);
    for(in u8 b : payload)
        outBinary.push_back(b);
}

Expected<Span<u8>> UnpackComponentAssetEnvelope(
    in Span<u8> binary,
    in Name assetType
){
    usize cursor = 0u;
    const Expected<ComponentHeaderBinary> headerResult = ReadPOD<ComponentHeaderBinary>(binary, cursor);
    if(!headerResult.has_value()){
        error("IComponent::loadBinary failed: malformed header");
        return makeUnexpected(Failure());
    }
    const ComponentHeaderBinary header = headerResult.value();
    if(header.magic != s_ComponentMagic){
        error("IComponent::loadBinary failed: invalid component asset format; recook required");
        return makeUnexpected(Failure());
    }
    if(!ValidateComponentHeaderBinary(header, assetType, binary.size() - cursor))
        return makeUnexpected(Failure());

    const usize payloadByteCount = cast<usize>(header.payloadByteCount);
    const Span<u8> payload = binary.subspan(cursor, payloadByteCount);
    cursor += payloadByteCount;
    if(cursor != binary.size()){
        error("IComponent::loadBinary failed: trailing bytes detected");
        return makeUnexpected(Failure());
    }
    return payload;
}

const usize s_TransformComponentPayloadBinaryBytes = 48u;
const usize s_CameraComponentPayloadBinaryBytes = 16u;
const usize s_LightComponentPayloadBinaryBytes = 40u;

b8 SerializeTransformComponentPayload(in TransformComponent component, mut Vector<u8> outPayload){
    const TransformComponentPayloadBinary binaryPayload = PackTransformComponentPayloadBinary(component);
    outPayload.clear();
    outPayload.reserve(s_TransformComponentPayloadBinaryBytes);
    AppendPOD(outPayload, binaryPayload);
    return true;
}

b8 DeserializeTransformComponentPayload(in Span<u8> payload, mut TransformComponent outComponent){
    usize cursor = 0u;
    const Expected<TransformComponentPayloadBinary> binaryPayload = ReadPOD<TransformComponentPayloadBinary>(payload, cursor);
    if(!binaryPayload.has_value() || cursor != payload.size()){
        error("TransformComponentAsset::loadComponentPayload failed: invalid payload size");
        return false;
    }
    outComponent = UnpackTransformComponentPayloadBinary(binaryPayload.value());
    return true;
}

b8 SerializeCameraComponentPayload(in CameraComponent component, mut Vector<u8> outPayload){
    const CameraComponentPayloadBinary binaryPayload = PackCameraComponentPayloadBinary(component);
    outPayload.clear();
    outPayload.reserve(s_CameraComponentPayloadBinaryBytes);
    AppendPOD(outPayload, binaryPayload);
    return true;
}

b8 DeserializeCameraComponentPayload(in Span<u8> payload, mut CameraComponent outComponent){
    usize cursor = 0u;
    const Expected<CameraComponentPayloadBinary> binaryPayload = ReadPOD<CameraComponentPayloadBinary>(payload, cursor);
    if(!binaryPayload.has_value() || cursor != payload.size()){
        error("CameraComponentAsset::loadComponentPayload failed: invalid payload size");
        return false;
    }
    outComponent = UnpackCameraComponentPayloadBinary(binaryPayload.value());
    return true;
}

b8 SerializeLightComponentPayload(in LightComponent component, mut Vector<u8> outPayload){
    const LightComponentPayloadBinary binaryPayload = PackLightComponentPayloadBinary(component);
    outPayload.clear();
    outPayload.reserve(s_LightComponentPayloadBinaryBytes);
    AppendPOD(outPayload, binaryPayload);
    return true;
}

b8 DeserializeLightComponentPayload(in Span<u8> payload, mut LightComponent outComponent){
    usize cursor = 0u;
    const Expected<LightComponentPayloadBinary> binaryPayload = ReadPOD<LightComponentPayloadBinary>(payload, cursor);
    if(!binaryPayload.has_value() || cursor != payload.size()){
        error("LightComponentAsset::loadComponentPayload failed: invalid payload size");
        return false;
    }
    const Expected<LightComponent> unpacked = UnpackLightComponentPayloadBinary(binaryPayload.value());
    if(!unpacked.has_value()){
        error("LightComponentAsset::loadComponentPayload failed: invalid light flags");
        return false;
    }
    outComponent = unpacked.value();
    return true;
}


