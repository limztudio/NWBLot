    public void overlapAabb(in Aabb3D queryBox, in Filter filter, in b8 hitSensors, in EntityID ignoreEntity, mut Vector<EntityID> outEntities)const{
        outEntities.clear();
        BodyId ignoreBodyId;
        ShapeId ignoreShapeId;
        this.resolveIgnoreEntityTarget(ignoreEntity, ignoreBodyId, ignoreShapeId);
        Vector<ShapeId> rawShapes;
        if(!ignoreShapeId.valid())
            this.m_physicsWorld.overlapAabb(queryBox, filter, hitSensors, ignoreBodyId, rawShapes);
        else
            this.m_physicsWorld.overlapAabb(queryBox, filter, hitSensors, ignoreBodyId, ignoreShapeId, ShapeQueryFilterCallback(lambda[](in ShapeId id) -> b8{ return true; }), rawShapes);
        this.collectUniqueEntitiesFromShapes(rawShapes, outEntities);
    }

