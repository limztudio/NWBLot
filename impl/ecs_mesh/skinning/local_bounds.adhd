#include <impl/global.adhd.h>

#include <core/graphics/gpu_timing.h>
#include <core/task/gpu/task_desc.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_CORE_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class GraphicsRuntime;
struct GpuTaskRecordContext;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_CORE_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct MeshSkinningLocalBoundsTask{
    struct Payload{
        Core::GraphicsRuntime& graphics;
        Core::GpuTimingSubmissionTicket& timingTicket;
        Span<const MeshSkinningLocalBoundsDispatch> dispatches;


    public:
        Payload(Core::GraphicsRuntime& inGraphics, Core::GpuTimingSubmissionTicket& inTimingTicket, const Span<const MeshSkinningLocalBoundsDispatch> inDispatches)noexcept
            : graphics(inGraphics)
            , timingTicket(inTimingTicket)
            , dispatches(inDispatches)
        {}
    };


public:
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements = { Core::GpuQueueCapability::Compute };


public:
    [[nodiscard]] static b8 Record(const Payload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext& context);
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_RuntimeMeshBoundsByteSize = 32u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u64 ComputeMeshletLocalBoundsByteSize(in usize meshletCount, in u64 boundsRecordByteSize){
    return cast<u64>(meshletCount) * boundsRecordByteSize;
}

// Replacement is atomic; no uninitialized bounds become visible through the runtime mesh provider.
b8 CreateMeshSkinningLocalBoundsBuffers(mut GraphicsRuntime graphics, mut MeshSkinningRuntimeInstance instance){
    instance.deformationState.invalidateCurrent();
    if(!ValidateMeshSkinningLocalBoundsMeshletCount(instance.meshlets.size(), s_RuntimeMeshBoundsByteSize))
        return false;

    const Name partialName = DeriveRuntimeResourceName(instance.sourceName, instance.handle.value, instance.editRevision, s_MeshletLocalBoundsSuffix);
    const Name outputName = DeriveRuntimeResourceName(instance.sourceName, instance.handle.value, instance.editRevision, s_LocalBoundsSuffix);
    if(partialName == s_NameNone || outputName == s_NameNone){
        error("MeshSkinningSystem: failed to derive runtime local bounds buffer names");
        return false;
    }

    BufferDesc desc = BufferDesc();
    desc
        .setByteSize(ComputeMeshletLocalBoundsByteSize(instance.meshlets.size(), cast<u64>(s_RuntimeMeshBoundsByteSize)))
        .setCanHaveUAVs(true)
        .setCanHaveRawViews(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setDebugName(partialName)
    ;
    const Expected<BufferHandle> partialsResult = graphics.createBuffer(desc);
    if(!partialsResult.has_value()){
        error("MeshSkinningSystem: failed to create runtime local bounds partials");
        return false;
    }

    desc.setByteSize(cast<u64>(s_RuntimeMeshBoundsByteSize)).setDebugName(outputName);
    const Expected<BufferHandle> outputResult = graphics.createBuffer(desc);
    if(!outputResult.has_value()){
        error("MeshSkinningSystem: failed to create runtime local bounds output");
        return false;
    }

    instance.meshletLocalBoundsBuffer = partialsResult.value();
    instance.localBoundsBuffer = outputResult.value();
    return true;
}


