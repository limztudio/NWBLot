struct CooperativeVectorQueryHarness{
    Tests::TestArena<> arena;
    Core::GraphicsAllocator allocator{ arena.arena };
    Core::CpuTaskScheduler scheduler{ 1u };
    Core::GraphicsBackend::VulkanContext context{ allocator, scheduler };


public:
    CooperativeVectorQueryHarness()noexcept;

    [[nodiscard]] Expected<Core::CooperativeVectorDeviceFeatures> queryEmptyDriverList();
    [[nodiscard]] u32 callCount()const noexcept;
};

[[nodiscard]] VkQueue MakeDummyVkQueue(usize handleValue)noexcept;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


