// C++ interface adapter required because ISearchableListDataSource::filtered() returns const IListDataSource&.
template<typename ResolverT, usize LabelCount, u64 DisabledKey>
class UiFilteredListSource final : public ISearchableListDataSource, NoCopy{
private:
    class View final : public IListDataSource, NoCopy{
    public:
        explicit View(const UiFilteredListSource& source)noexcept
            : m_source(source)
        {}

    public:
        virtual u64 instanceGeneration()const noexcept override{ return s_FilteredInstanceGeneration; }
        virtual u64 revision()const noexcept override{ return m_source.m_state.filteredRevision(); }
        virtual u64 rowCount()const noexcept override{ return m_source.m_state.filteredRowCount(); }
        virtual u64 key(const u64 index)const noexcept override{ return m_source.m_state.filteredKey(index); }
        virtual Expected<u64> indexOf(const u64 keyValue)const noexcept override{ return m_source.m_state.filteredIndexOf(keyValue); }
        virtual Expected<u64> findEnabled(const u64 start, const b8 reverse)const noexcept override{ return m_source.m_state.filteredFindEnabled(start, reverse); }
        virtual StringView text(const u64 index)const noexcept override{ return m_source.m_state.filteredText(index); }
        virtual b8 enabled(const u64 index)const noexcept override{ return m_source.m_state.filteredEnabled(index); }

    private:
        const UiFilteredListSource& m_source;
    };

public:
    explicit UiFilteredListSource(GlobalArena&)noexcept
        : m_view(*this)
    {}

public:
    virtual u64 instanceGeneration()const noexcept override{ return 1u; }
    virtual u64 revision()const noexcept override{ return 1u; }
    virtual u64 rowCount()const noexcept override{ return m_state.rowCount(); }
    virtual u64 key(const u64 index)const noexcept override{ return m_state.key(index); }
    virtual Expected<u64> indexOf(const u64 keyValue)const noexcept override{ return m_state.indexOf(keyValue); }
    virtual Expected<u64> findEnabled(const u64 start, const b8 reverse)const noexcept override{ return m_state.findEnabled(start, reverse); }
    virtual StringView text(const u64 index)const noexcept override{ return m_state.text(index); }
    virtual b8 enabled(const u64 index)const noexcept override{ return m_state.enabled(index); }
    [[nodiscard]] virtual b8 filter(const AStringView query)override{ return m_state.applyFilter(query); }
    [[nodiscard]] virtual const IListDataSource& filtered()const noexcept override{ return m_view; }

private:
    UiFilteredListState<ResolverT, LabelCount, DisabledKey> m_state;
    View m_view;
};

using UiNestedPopupSource = UiFilteredListSource<UiNestedPopupLabelResolver, s_NestedPopupLabelCount, s_NestedPopupDisabledKey>;
using UiSearchComboSource = UiFilteredListSource<UiSearchComboLabelResolver, s_SearchComboLabelCount, s_SearchComboDisabledKey>;
};
}


