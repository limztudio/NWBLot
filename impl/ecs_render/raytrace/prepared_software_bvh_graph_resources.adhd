////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/raytrace/prepared_builds.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class PreparedMeshSwBvhGraphResources{
    public PreparedMeshSwBvhBuild build;
    public GpuGraphResourceId position;
    public GpuGraphResourceId triangleIndex;
    public GpuGraphResourceId node;
    public GpuGraphResourceId parent;
    public GpuGraphResourceId sortKeys;
    public GpuGraphResourceId sortPayload;
    public GpuGraphResourceId visitCounter;
}

type PreparedMeshSwBvhGraphResourceVector = Vector<PreparedMeshSwBvhGraphResources>;


// A missing graph identity rejects the complete returned resource list.
Expected<PreparedMeshSwBvhGraphResourceVector> ResolvePreparedSoftwareBvhGraphResources(in GpuTaskGraph graph, in Span<PreparedMeshSwBvhBuild> builds){
    PreparedMeshSwBvhGraphResourceVector result;
    if(builds.empty())
        return result;
    result.reserve(builds.size());
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    if(!declarations.valid())
        return MakeUnexpected(Failure());
    for(in PreparedMeshSwBvhBuild build : builds){
        PreparedMeshSwBvhGraphResources resources;
        resources.build = build;
        resources.position = declarations.findImportedBuffer(build.positionBuffer);
        resources.triangleIndex = declarations.findImportedBuffer(build.triangleIndexBuffer);
        resources.node = declarations.findImportedBuffer(build.nodeBuffer);
        resources.parent = declarations.findImportedBuffer(build.parentBuffer);
        resources.sortKeys = declarations.findImportedBuffer(build.sortKeysBuffer);
        resources.sortPayload = declarations.findImportedBuffer(build.sortPayloadBuffer);
        resources.visitCounter = declarations.findImportedBuffer(build.visitCounterBuffer);
        if(!resources.position.valid() || !resources.triangleIndex.valid() || !resources.node.valid() || !resources.parent.valid() || !resources.sortKeys.valid() || !resources.sortPayload.valid() || !resources.visitCounter.valid())
            return MakeUnexpected(Failure());
        result.push_back(resources);
    }
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

