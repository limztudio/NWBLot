const StringView s_DiagnosticPrefix = "DependencyComputer";
const Name s_DependencyComputerArena = "pipeline/dependency_computer";
const usize s_InvalidProviderIndex = ~cast<usize>(0u);

Expected<StringView> ExtractParentVirtualPathText(in StringView virtualPathText){
    usize lastSlash = usize.max;
    for(usize index = 0u; index < virtualPathText.size(); ++index){
        if(virtualPathText[index] == cast<u8>('/'))
            lastSlash = index;
    }
    if(lastSlash == usize.max || lastSlash == 0u)
        return MakeUnexpected(Failure());
    return virtualPathText.substr(0u, lastSlash);
}

StringView ResolveDependencyVirtualPathText(in Name virtualPath, in StringView virtualPathTextHint){
    if(!virtualPathTextHint.empty())
        return virtualPathTextHint;
    return virtualPath.resolvedText();
}

b8 RecordDependencyProviderMatch(in Name virtualPath, in usize index, mut usize inOutMatched){
    if(inOutMatched != s_InvalidProviderIndex && inOutMatched != index){
        error("DependencyComputer: multiple physical providers for '{}'", virtualPath.resolvedText());
        return false;
    }
    inOutMatched = index;
    return true;
}

Expected<StringView> TryTrimVirtualPathText(in StringView rawText){
    const StringView trimmed = TrimView(rawText);
    if(trimmed.empty() || trimmed.find('/') >= trimmed.size())
        return MakeUnexpected(Failure());
    return trimmed;
}


