[cpp_header("<tests/unit/metascript/parallel_unwind_probe.h>"), cpp_name("::NWB::Tests::Metascript::ParallelUnwindTracker"), cpp_flags(self_defaulted, no_copy, no_assign)]
extern class ParallelUnwindTracker{
    void completeWork(in u32 seed)const;
    [cpp_flags(unwind)]
    void invokeAfterWorkerStarts(mut Func<void()> callback)const;
    u32 runs()const;
    u32 valueSum()const;
    b8 finished()const;
    b8 postObservedFinished()const;
    b8 preObservedFinished()const;
    u32 postOrder()const;
    u32 preOrder()const;
};

[cpp_header("<tests/unit/metascript/parallel_unwind_probe.h>"), cpp_name("::NWB::Tests::Metascript::ParallelLifetimeProbe"), cpp_flags(no_copy, no_assign)]
extern class ParallelLifetimeProbe;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


interface IUnwindCallback{
    u32 record(mut Func<u32()> callback)const;
}

class CppUnwindCallback : IUnwindCallback{
    public u32 record(mut Func<u32()> callback)const override;
    public void runParallelUnwind(in ParallelUnwindTracker tracker, mut Func<void()> callback)const;
    public b8 ready()const{
        return true;
    }
}

u32 CppUnwindCallback::record(mut Func<u32()> callback)const{
    auto outer = lambda[mut callback]() -> u32{
        auto inner = lambda[mut callback]() -> u32{
            return callback();
        };
        return inner();
    };
    return outer();
}

void CppUnwindCallback::runParallelUnwind(in ParallelUnwindTracker tracker, mut Func<void()> callback)const{
    Vector<u32> preScratch;
    preScratch.push_back(7u);
    ParallelLifetimeProbe preProbe(tracker, false);
    parallel TaskA {
        tracker.completeWork(preScratch[0u]);
    }
    ParallelLifetimeProbe postProbe(tracker, true);
    Vector<u32> postScratch;
    postScratch.push_back(11u);
    tracker.invokeAfterWorkerStarts(callback);
    parallel TaskB : TaskA {
        tracker.completeWork(postScratch[0u]);
    }
    wait(TaskA, TaskB);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

