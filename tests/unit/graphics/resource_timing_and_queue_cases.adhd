    Array<GpuComparableTimestampRange, 2> nearLimitRanges = Array<GpuComparableTimestampRange, 2>();
    nearLimitRanges[0u] = MakeComparableRange(u64.max - 20u, u64.max - 10u, 1.0, MakePhysicalQueue(1u, 4u));
    nearLimitRanges[1u] = MakeComparableRange(u64.max - 15u, u64.max - 5u, 1.0, MakePhysicalQueue(2u, 4u));
    metrics = AggregateEnvelopeMetrics(nearLimitRanges, context);
    ASSERT_TRUE(metrics.has_value());
    EXPECT_EQ(metrics.value().queueOverlapTicks, 5u);
}

