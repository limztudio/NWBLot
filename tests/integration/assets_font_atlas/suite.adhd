const StringView s_LatinAtlasPath = "project/fonts/latin/atlas";
const StringView s_FaceIndexField = "face_index";
const StringView s_UnitsPerEmField = "units_per_em";
const StringView s_ErrEmptyVirtualPath = "FontAtlas::validatePayload failed: virtual path is empty";
const StringView s_ErrPixelHashMismatch = "pixel content hash mismatch";

class InvalidFieldCase{
    public usize m_offset;
    public u32 m_value;

    public InvalidFieldCase(in usize offset, in u32 value){
        this.m_offset = offset;
        this.m_value = value;
    }
};

void WriteLittleU32At(mut AssetBytes bytes, in usize offset, in u32 value){
    bytes[offset] = cast<u8>(value);
    bytes[offset + 1u] = cast<u8>(value >> 8u);
    bytes[offset + 2u] = cast<u8>(value >> 16u);
    bytes[offset + 3u] = cast<u8>(value >> 24u);
}

AssetBytes CopyAtlasBytes(in AssetBytes source, mut AssetArena arena){
    AssetBytes copy(arena);
    copy.resize(source.size());
    for(usize index = 0u; index < source.size(); ++index)
        copy[index] = source[index];
    return copy;
}

FontAtlasPayload MakePayload(mut AtlasTestArena testArena){
    FontAtlasPayload payload(testArena.arena);
    payload.font = AssetRef<Font>(Name(s_BodyFontPath));
    payload.fontSha256 = ComputeSha256("exact source font identity fixture");
    payload.unitsPerEm = 1000u;
    payload.sourceGlyphCount = 5u;
    payload.ascenderUnits = 800.0f;
    payload.descenderUnits = -200.0f;

    payload.groups.emplace_back(testArena.arena);
    mut FontAtlasGroup group = payload.groups.back();
    group.width = 8u;
    group.height = 8u;
    group.pixels.resize(8u * 8u * 4u);
    for(usize index = 0u; index < group.pixels.size(); ++index)
        group.pixels[index] = cast<u8>(index);
    group.sha256 = ComputeSha256(group.pixels);

    for(u32 index = 0u; index < 5u; ++index){
        FontAtlasGlyph glyph = FontAtlasGlyph();
        glyph.glyphId = index;
        glyph.advanceUnits = 400.0f + cast<f32>(index);
        if(index < 4u){
            glyph.channel = index;
            glyph.x = 1u;
            glyph.y = 1u;
            glyph.width = 4u;
            glyph.height = 4u;
            glyph.planeLeft = -10.0f;
            glyph.planeTop = -50.0f;
            glyph.planeRight = 52.5f;
            glyph.planeBottom = 12.5f;
            glyph.drawable = 1u;
        }
        payload.glyphs.push_back(glyph);
    }

    payload.positioningTables.emplace_back(testArena.arena);
    mut FontAtlasPositioningTable table = payload.positioningTables.back();
    table.tag = s_FontAtlasKernTag;
    table.bytes.resize(s_DefaultKernBytes.size());
    for(usize index = 0u; index < s_DefaultKernBytes.size(); ++index)
        table.bytes[index] = s_DefaultKernBytes[index];
    table.sha256 = ComputeSha256(table.bytes);
    return payload;
}

b8 SerializePayloadInto(in FontAtlasPayload payload, mut AssetArena arena, mut ScratchArena scratch, mut AssetBytes outBinary){
    Expected<AssetBytes> result = SerializeFontAtlasPayload(payload, arena, scratch);
    if(!result.has_value())
        return false;
    outBinary = result.value();
    return true;
}

b8 CanSerializePayload(in FontAtlasPayload payload, mut AssetArena arena, mut ScratchArena scratch){
    return SerializeFontAtlasPayload(payload, arena, scratch).has_value();
}

b8 DeserializePayloadInto(in AssetBytes binary, mut AssetArena arena, mut ScratchArena scratch, mut FontAtlasPayload outPayload){
    Expected<FontAtlasPayload> result = DeserializeFontAtlasPayload(binary, arena, scratch);
    if(!result.has_value())
        return false;
    outPayload = result.value();
    return true;
}

b8 CanDeserializePayload(in AssetBytes binary, mut AssetArena arena, mut ScratchArena scratch){
    return DeserializeFontAtlasPayload(binary, arena, scratch).has_value();
}

b8 BuildAtlasInto(in FontAtlasCookEntry entry, mut AssetArena arena, mut ScratchArena scratch, mut FontAtlas outAtlas){
    Expected<FontAtlas> result = BuildFontAtlasAsset(entry, arena, scratch);
    if(!result.has_value())
        return false;
    outAtlas = result.value();
    return true;
}

b8 TryGetAtlasGlyph(in FontAtlas atlas, in u32 glyphId, mut FontAtlasGlyph outGlyph){
    return atlas.tryGlyph(glyphId, outGlyph);
}

b8 CopyDocumentVariable(in MetascriptDocument document, in StringView name, mut MetascriptValue outValue){
    b8 found = false;
    native(in document, in name, mut outValue, mut found){
        if(const MetascriptValue* const variable = document.findVariable(name)){
            outValue = *variable;
            found = true;
        }
    }
    return found;
}

b8 MakeDocumentVariableEmptyMap(mut MetascriptDocument document, in StringView name){
    b8 ok = false;
    native(in name, mut document, mut ok){
        if(MetascriptValue* const variable = document.findVariable(name)){
            variable->makeMap();
            ok = variable->asMap().empty();
        }
    }
    return ok;
}

b8 HasValueField(in MetascriptValue value, in StringView field){
    b8 found = false;
    native(in value, in field, mut found){
        found = value.findField(field) != nullptr;
    }
    return found;
}

Path BundledFontRoot(){
    return Path(s_RepoRoot) / "impl" / "assets" / "ui" / "fonts" / "default";
}

Path ScratchRoot(in StringView subDir){
    return Path(s_RepoRoot) / "__artifacts" / "font_metadata_tests" / subDir;
}

b8 PrepareFiles(in Path directory, mut MetadataTestArena testArena){
    if(!EnsureDirectories(directory).has_value())
        return false;
    AssetBytes bytes(testArena.arena);
    if(!ReadBinaryFile(BundledFontRoot() / s_LatinFontFilename, bytes).has_value())
        return false;
    return WriteBinaryFile(directory / s_LatinFontFilename, bytes);
}

b8 LoadMetadata(mut MetadataTestArena testArena, mut MetascriptDocument document){
    String text = "";
    if(!ReadTextFile(BundledFontRoot() / s_LatinMetadataFilename, text).has_value())
        return false;
    return document.parse(text);
}

void RunBunchMetadataChecks(
    in Path directory,
    in MetascriptDocument document,
    mut AssetArena cookArena,
    mut CookEntryRegistry registry,
    mut CpuTaskScheduler scheduler,
    mut ScratchArena scratchArena,
    mut CookEntryPathHashSet parsedPaths
){
    ASSERT_TRUE(RegisterAutoCollectedCookEntryTypes(registry, scratchArena));
    const Path filePath = directory / s_LatinMetadataFilename;
    const Expected<ExpandedAssetMetadataVector> expandedResult = ExpandAssetBunch(directory, s_FontVirtualRoot, filePath, document, scratchArena);
    ASSERT_TRUE(expandedResult.has_value());
    const ExpandedAssetMetadataVector expanded = expandedResult.value();
    ASSERT_EQ(expanded.size(), 2u);
    CookEntryParseContext parseContext(cookArena, scheduler, scratchArena, parsedPaths);
    const Name atlasAssetType = FontAtlas::AssetTypeName();
    usize atlasIndex = expanded.size();
    for(usize index = 0u; index < expanded.size(); ++index){
        if(expanded[index].assetType == atlasAssetType)
            atlasIndex = index;
    }
    ASSERT_LT(atlasIndex, expanded.size());
    MetascriptValue invalidAtlas(expanded[atlasIndex].value);
    invalidAtlas.field(s_GlyphsField).asList().pop_back();
    EXPECT_FALSE(registry.parseValue(expanded[atlasIndex].assetType, expanded[atlasIndex].virtualPath, filePath, invalidAtlas, parseContext));
    EXPECT_EQ(registry.entryCount(), 0u);
    EXPECT_TRUE(parsedPaths.empty());
    for(usize index = 0u; index < expanded.size(); ++index)
        ASSERT_TRUE(registry.parseValue(expanded[index].assetType, expanded[index].virtualPath, filePath, expanded[index].value, parseContext));
    EXPECT_EQ(registry.entryCount(), 2u);
    EXPECT_FALSE(registry.parseValue(expanded[0u].assetType, expanded[0u].virtualPath, filePath, expanded[0u].value, parseContext));
    EXPECT_EQ(registry.entryCount(), 2u);
}

void VerifyAssetsFontAtlas_EmptyAndPaddingBoundaryDigestsRejectMalformedText(){
    const Expected<Sha256Digest> emptyHash = ParseSha256("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
    ASSERT_TRUE(emptyHash.has_value());
    EXPECT_EQ(ComputeSha256(""), emptyHash.value());
    // A 56-byte input requires a second block for the SHA-256 padding.
    const Expected<Sha256Digest> paddedHash = ParseSha256("248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
    ASSERT_TRUE(paddedHash.has_value());
    const StringView multiBlock = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
    EXPECT_EQ(ComputeSha256(multiBlock), paddedHash.value());
    EXPECT_FALSE(ParseSha256("BA7816BF8F01CFEA414140DE5DAE2223B00361A396177A9CB410FF61F20015AD").has_value());
    EXPECT_FALSE(ParseSha256("ba78").has_value());
}

void VerifyAssetsFontAtlas_EmptyGlyphRetainsAdvanceAndFirstOutOfRangeLookupMissesAfterLoad(){
    AtlasTestArena testArena = AtlasTestArena();
    FontAtlas atlas(testArena.arena, Name(s_BodyFontAtlasPath));
    atlas.setPayload(MakePayload(testArena));
    FontAtlasAssetCodec codec = FontAtlasAssetCodec();
    AssetBytes binary(testArena.arena);
    ASSERT_TRUE(codec.serialize(atlas, binary));
    FontAtlas loaded(testArena.arena, atlas.virtualPath());
    ASSERT_TRUE(loaded.loadBinary(binary));
    EXPECT_EQ(loaded.payload().font.name(), atlas.payload().font.name());
    FontAtlasGlyph glyph4 = FontAtlasGlyph();
    ASSERT_TRUE(TryGetAtlasGlyph(loaded, 4u, glyph4));
    EXPECT_EQ(glyph4.drawable, 0u);
    EXPECT_FLOAT_EQ(glyph4.advanceUnits, 404.0f);
    FontAtlasGlyph glyph5 = FontAtlasGlyph();
    EXPECT_FALSE(TryGetAtlasGlyph(loaded, 5u, glyph5));
}

void VerifyAssetsFontAtlas_BuildOwnsGlyphsGroupsAndPositioningInCallerArena(){
    AtlasTestArena testArena = AtlasTestArena();
    AssetArena resultArena(s_FontAtlasBuiltResult);
    FontAtlasCookEntry entry(testArena.arena);
    entry.payload = MakePayload(testArena);
    entry.virtualPath = Name(s_BodyFontAtlasPath);
    AssetBytes expected(resultArena);
    ASSERT_TRUE(SerializePayloadInto(entry.payload, resultArena, testArena.scratchArena, expected));

    FontAtlas built(resultArena);
    ASSERT_TRUE(BuildAtlasInto(entry, resultArena, testArena.scratchArena, built));
    EXPECT_EQ(built.virtualPath(), entry.virtualPath);
    native(in built, in resultArena){
        const FontAtlasPayload& payload = built.payload();
        EXPECT_EQ(&payload.glyphs.get_allocator().arena(), &resultArena);
        EXPECT_EQ(&payload.groups.get_allocator().arena(), &resultArena);
        EXPECT_EQ(&payload.positioningTables.get_allocator().arena(), &resultArena);
        ASSERT_EQ(payload.groups.size(), 1u);
        ASSERT_EQ(payload.positioningTables.size(), 1u);
        EXPECT_EQ(&payload.groups[0u].pixels.get_allocator().arena(), &resultArena);
        EXPECT_EQ(&payload.positioningTables[0u].bytes.get_allocator().arena(), &resultArena);
    }

    entry.payload.glyphs[0u].advanceUnits = entry.payload.glyphs[0u].advanceUnits + 1.0f;
    entry.payload.groups[0u].pixels[0u] ^= 1u;
    entry.payload.positioningTables[0u].bytes.back() ^= 1u;
    ASSERT_TRUE(built.validatePayload(testArena.scratchArena));
    AssetBytes actual(resultArena);
    ASSERT_TRUE(SerializePayloadInto(built.payload(), resultArena, testArena.scratchArena, actual));
    EXPECT_EQ(actual, expected);
}

void VerifyAssetsFontAtlas_FontIdentityPreservesUpperHashLanesAndRejectsOldVersion(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
    AtlasTestArena testArena = AtlasTestArena();
    FontAtlasPayload payload = MakePayload(testArena);
    NameHash identity = payload.font.name().hash();
    for(u32 lane = s_NameHashLaneCount / 2u; lane < s_NameHashLaneCount; ++lane)
        identity.qwords[lane] ^= 0x9e3779b97f4a7c15ul + cast<u64>(lane);
    payload.font.virtualPath = Name(identity);
    AssetBytes binary(testArena.arena);
    ASSERT_TRUE(SerializePayloadInto(payload, testArena.arena, testArena.scratchArena, binary));
    FontAtlasPayload decoded(testArena.arena);
    ASSERT_TRUE(DeserializePayloadInto(binary, testArena.arena, testArena.scratchArena, decoded));
    EXPECT_EQ(decoded.font.name().hash(), identity);

    FontAtlas atlas(testArena.arena, Name(s_BodyFontAtlasPath));
    atlas.setPayload(payload);
    AssetBytes obsolete = CopyAtlasBytes(binary, testArena.arena);
    WriteLittleU32At(obsolete, 4u, 2u);
    EXPECT_FALSE(atlas.loadBinary(obsolete));
    EXPECT_EQ(atlas.payload().font.name().hash(), identity);
}

void VerifyAssetsFontAtlas_MalformedBinaryDoesNotReplacePreviouslyLoadedAtlas(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    AtlasTestArena testArena = AtlasTestArena();
    const FontAtlasPayload payload = MakePayload(testArena);
    AssetBytes valid(testArena.arena);
    ASSERT_TRUE(SerializePayloadInto(payload, testArena.arena, testArena.scratchArena, valid));
    FontAtlas atlas(testArena.arena, Name(s_BodyFontAtlasPath));
    ASSERT_TRUE(atlas.loadBinary(valid));
    for(usize index = 0u; index < s_CorruptAtlasOffsets.size(); ++index){
        const usize offset = s_CorruptAtlasOffsets[index];
        const ScopedTestTrace trace(offset);
        AssetBytes invalid = CopyAtlasBytes(valid, testArena.arena);
        WriteLittleU32At(invalid, offset, u32.max);
        EXPECT_FALSE(atlas.loadBinary(invalid));
        EXPECT_EQ(atlas.payload().fontSha256, payload.fontSha256);
        EXPECT_EQ(atlas.payload().groups[0u].pixels, payload.groups[0u].pixels);
    }
    AssetBytes legacy = CopyAtlasBytes(valid, testArena.arena);
    WriteLittleU32At(legacy, 4u, 2u);
    EXPECT_FALSE(atlas.loadBinary(legacy));
    EXPECT_EQ(atlas.payload().font.name(), payload.font.name());
    AssetBytes changed = CopyAtlasBytes(valid, testArena.arena);
    changed.back() ^= 1u;
    EXPECT_FALSE(atlas.loadBinary(changed));
    EXPECT_EQ(atlas.payload().groups[0u].pixels, payload.groups[0u].pixels);
    AssetBytes truncated = CopyAtlasBytes(valid, testArena.arena);
    truncated.pop_back();
    EXPECT_FALSE(atlas.loadBinary(truncated));
    AssetBytes trailing = CopyAtlasBytes(valid, testArena.arena);
    trailing.push_back(0u);
    EXPECT_FALSE(atlas.loadBinary(trailing));
}

void VerifyAssetsFontAtlas_CompactNonPowerOfTwoGroupsRejectMissingChannelsAndLostGuards(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    AtlasTestArena testArena = AtlasTestArena();
    for(u32 channelCount = 1u; channelCount <= 4u; ++channelCount){
        const ScopedTestTrace trace(channelCount);
        FontAtlasPayload payload = MakePayload(testArena);
        mut FontAtlasGroup group = payload.groups[0u];
        group.width = 7u;
        group.height = 9u;
        group.channelCount = channelCount;
        group.pixels.resize(cast<usize>(group.width) * group.height * channelCount);
        for(usize index = 0u; index < group.pixels.size(); ++index)
            group.pixels[index] = cast<u8>(index * 17u + channelCount);
        group.sha256 = ComputeSha256(group.pixels);
        payload.sourceGlyphCount = channelCount + 1u;
        payload.glyphs.resize(payload.sourceGlyphCount);
        for(u32 index = 0u; index < channelCount; ++index){
            payload.glyphs[index].x = 2u;
            payload.glyphs[index].y = 4u;
        }
        payload.glyphs[channelCount] = FontAtlasGlyph();
        payload.glyphs[channelCount].glyphId = channelCount;
        AssetBytes binary(testArena.arena);
        ASSERT_TRUE(SerializePayloadInto(payload, testArena.arena, testArena.scratchArena, binary));
        FontAtlasPayload loaded(testArena.arena);
        ASSERT_TRUE(DeserializePayloadInto(binary, testArena.arena, testArena.scratchArena, loaded));
        EXPECT_EQ(loaded.groups[0u].pixels, group.pixels);

        FontAtlasPayload invalid(payload);
        invalid.glyphs[0u].channel = channelCount;
        EXPECT_FALSE(ValidateFontAtlasPayload(invalid, testArena.scratchArena));
        invalid = payload;
        invalid.glyphs[0u].x += 1u;
        // The right exterior guard was removed by cropping.
        EXPECT_FALSE(ValidateFontAtlasPayload(invalid, testArena.scratchArena));
        invalid = payload;
        invalid.glyphs[0u].y += 1u;
        // The lower exterior guard was removed by cropping.
        EXPECT_FALSE(ValidateFontAtlasPayload(invalid, testArena.scratchArena));
        invalid = payload;
        invalid.groups[0u].pixels.push_back(0u);
        invalid.groups[0u].sha256 = ComputeSha256(invalid.groups[0u].pixels);
        EXPECT_FALSE(CanSerializePayload(invalid, testArena.arena, testArena.scratchArena));
    }
}

void VerifyAssetsFontAtlas_UnsupportedVersionsAndCompactGroupHeadersAreRejected(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    AtlasTestArena testArena = AtlasTestArena();
    const FontAtlasPayload payload = MakePayload(testArena);
    AssetBytes binary(testArena.arena);
    ASSERT_TRUE(SerializePayloadInto(payload, testArena.arena, testArena.scratchArena, binary));
    FontAtlasPayload loaded(testArena.arena);
    ASSERT_TRUE(DeserializePayloadInto(binary, testArena.arena, testArena.scratchArena, loaded));

    const usize groupOffset = s_FontAtlasBinaryHeaderBytes + payload.glyphs.size() * s_FontAtlasBinaryGlyphBytes;
    Vector<InvalidFieldCase> invalidFields = Vector<InvalidFieldCase>();
    invalidFields.reserve(12u);
    invalidFields.push_back(InvalidFieldCase(4u, 1u));
    invalidFields.push_back(InvalidFieldCase(4u, 0u));
    invalidFields.push_back(InvalidFieldCase(4u, 2u));
    invalidFields.push_back(InvalidFieldCase(4u, s_FontAtlasBinaryVersion + 1u));
    invalidFields.push_back(InvalidFieldCase(groupOffset, u32.max));
    invalidFields.push_back(InvalidFieldCase(groupOffset + 4u, u32.max));
    invalidFields.push_back(InvalidFieldCase(groupOffset + 8u, 0u));
    invalidFields.push_back(InvalidFieldCase(groupOffset + 8u, 5u));
    invalidFields.push_back(InvalidFieldCase(groupOffset + 8u, u32.max));
    invalidFields.push_back(InvalidFieldCase(groupOffset + 12u, 0u));
    invalidFields.push_back(InvalidFieldCase(groupOffset + 12u, 255u));
    invalidFields.push_back(InvalidFieldCase(groupOffset + 12u, 257u));

    for(usize index = 0u; index < invalidFields.size(); ++index){
        const usize offset = invalidFields[index].m_offset;
        const u32 value = invalidFields[index].m_value;
        const ScopedTestTrace trace(offset);
        AssetBytes invalid = CopyAtlasBytes(binary, testArena.arena);
        WriteLittleU32At(invalid, offset, value);
        EXPECT_FALSE(CanDeserializePayload(invalid, testArena.arena, testArena.scratchArena));
    }

    FontAtlasPayload invalid(payload);
    invalid.groups[0u].channelCount = 0u;
    EXPECT_FALSE(ValidateFontAtlasPayload(invalid, testArena.scratchArena));
    invalid.groups[0u].channelCount = 5u;
    EXPECT_FALSE(ValidateFontAtlasPayload(invalid, testArena.scratchArena));
    invalid.groups[0u].channelCount = u32.max;
    invalid.groups[0u].width = u32.max;
    invalid.groups[0u].height = u32.max;
    EXPECT_FALSE(ValidateFontAtlasPayload(invalid, testArena.scratchArena));
}

void VerifyAssetsFontAtlas_CodecRejectsUnnamedOrCorruptAtlasWithoutReplacingOutput(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    AtlasTestArena testArena = AtlasTestArena();
    FontAtlasAssetCodec codec = FontAtlasAssetCodec();
    AssetBytes binary(testArena.arena);
    binary.assign(3u, 42u);
    const AssetBytes expected = CopyAtlasBytes(binary, testArena.arena);
    FontAtlas unnamed(testArena.arena);
    unnamed.setPayload(MakePayload(testArena));
    EXPECT_FALSE(codec.serialize(unnamed, binary));
    EXPECT_EQ(binary, expected);
    EXPECT_TRUE(SawCapturedError(logger, s_ErrEmptyVirtualPath));

    FontAtlas corrupt(testArena.arena, Name(s_BodyFontAtlasPath));
    FontAtlasPayload payload = MakePayload(testArena);
    payload.groups[0u].pixels[0u] ^= 1u;
    corrupt.setPayload(payload);
    EXPECT_FALSE(codec.serialize(corrupt, binary));
    EXPECT_EQ(binary, expected);
    EXPECT_TRUE(SawCapturedError(logger, s_ErrPixelHashMismatch));
}

void VerifyAssetsFontAtlas_InvalidHashAndGeometryAreRejectedBySerialization(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    AtlasTestArena testArena = AtlasTestArena();
    const FontAtlasPayload original = MakePayload(testArena);
    FontAtlasPayload candidate(original);
    candidate.groups[0u].pixels[0u] ^= 1u;
    EXPECT_FALSE(CanSerializePayload(candidate, testArena.arena, testArena.scratchArena));
    candidate = original;
    candidate.glyphs[0u].channel = 4u;
    EXPECT_FALSE(ValidateFontAtlasPayload(candidate, testArena.scratchArena));
    candidate = original;
    candidate.glyphs[0u].x = u32.max;
    EXPECT_FALSE(ValidateFontAtlasPayload(candidate, testArena.scratchArena));
    candidate = original;
    candidate.glyphs[0u].planeRight = candidate.glyphs[0u].planeRight + 1.0f;
    EXPECT_FALSE(ValidateFontAtlasPayload(candidate, testArena.scratchArena));
    candidate = original;
    candidate.glyphs[0u].advanceUnits = s_InfinityF32;
    EXPECT_FALSE(ValidateFontAtlasPayload(candidate, testArena.scratchArena));
    candidate = original;
    candidate.glyphs[1u].channel = 0u;
    EXPECT_FALSE(ValidateFontAtlasPayload(candidate, testArena.scratchArena));
    candidate = original;
    candidate.glyphs[4u].x = 1u;
    EXPECT_FALSE(ValidateFontAtlasPayload(candidate, testArena.scratchArena));
}

void VerifyAssetsFontAtlas_GuardedRegionsRejectSameChannelOverlapAndAllowIndependentChannels(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    AtlasTestArena testArena = AtlasTestArena();
    FontAtlasPayload payload = MakePayload(testArena);
    ASSERT_TRUE(ValidateFontAtlasPayload(payload, testArena.scratchArena));
    mut FontAtlasGroup group = payload.groups[0u];
    group.width = 16u;
    group.pixels.resize(16u * 8u * 4u, 0u);
    group.sha256 = ComputeSha256(group.pixels);
    mut FontAtlasGlyph second = payload.glyphs[1u];
    second.channel = 0u;
    second.x = 7u;
    ASSERT_TRUE(ValidateFontAtlasPayload(payload, testArena.scratchArena));
    second.x = 6u;
    // Bitmaps are disjoint, but the one-texel guards overlap.
    EXPECT_FALSE(ValidateFontAtlasPayload(payload, testArena.scratchArena));
    second.x = 4u;
    EXPECT_FALSE(ValidateFontAtlasPayload(payload, testArena.scratchArena));
    second.channel = 1u;
    EXPECT_TRUE(ValidateFontAtlasPayload(payload, testArena.scratchArena));
}

void VerifyAssetsFontAtlas_GuardedOverlapReusesCallerScratchAcrossGroupsAndRejectedChannels(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    AtlasTestArena testArena = AtlasTestArena();
    FontAtlasPayload payload = MakePayload(testArena);
    payload.groups.push_back(FontAtlasGroup(payload.groups.front()));
    payload.glyphs[2u].group = 1u;
    payload.glyphs[3u].group = 1u;
    ASSERT_TRUE(ValidateFontAtlasPayload(payload, testArena.scratchArena));
    const ArenaMemoryStats warm = testArena.scratchArena.memoryStats();
    for(usize iteration = 0u; iteration < 16u; ++iteration){
        const b8 valid = iteration % 2u == 0u;
        u32 channel = 2u;
        if(valid)
            channel = 3u;
        payload.glyphs[3u].channel = channel;
        EXPECT_EQ(ValidateFontAtlasPayload(payload, testArena.scratchArena), valid);
        const ArenaMemoryStats current = testArena.scratchArena.memoryStats();
        EXPECT_EQ(current.usedBytes, warm.usedBytes);
        EXPECT_EQ(current.reservedBytes, warm.reservedBytes);
    }
    EXPECT_EQ(logger.errorCount(), 8u);
}

void VerifyAssetsFontAtlas_PaddedPlaneSizeMustMatchBitmapExtentAtTheDeclaredBakeSize(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    AtlasTestArena testArena = AtlasTestArena();
    const FontAtlasPayload original = MakePayload(testArena);
    ASSERT_TRUE(ValidateFontAtlasPayload(original, testArena.scratchArena));
    FontAtlasPayload candidate(original);
    candidate.glyphs[0u].planeRight = candidate.glyphs[0u].planeRight + 1.0f;
    EXPECT_FALSE(ValidateFontAtlasPayload(candidate, testArena.scratchArena));
    candidate = original;
    candidate.glyphs[0u].planeBottom = candidate.glyphs[0u].planeBottom + 1.0f;
    EXPECT_FALSE(ValidateFontAtlasPayload(candidate, testArena.scratchArena));
    candidate = original;
    candidate.bakePpem *= 2u;
    EXPECT_FALSE(ValidateFontAtlasPayload(candidate, testArena.scratchArena));
    for(usize index = 0u; index < candidate.glyphs.size(); ++index){
        if(candidate.glyphs[index].drawable == 0u)
            continue;
        const VectorSingle planeEnd = VectorSingle(candidate.glyphs[index].planeLeft, candidate.glyphs[index].planeTop, 0.0f, 0.0f) + VectorSingle(31.25f);
        candidate.glyphs[index].planeRight = planeEnd.x;
        candidate.glyphs[index].planeBottom = planeEnd.y;
    }
    EXPECT_TRUE(ValidateFontAtlasPayload(candidate, testArena.scratchArena));
}

void VerifyAssetsFontAtlas_RejectsIncompleteOrDuplicateGlyphPolicyAndUnsupportedLimits(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    AtlasTestArena testArena = AtlasTestArena();
    const FontAtlasPayload original = MakePayload(testArena);
    FontAtlasPayload candidate(original);
    candidate.glyphs.pop_back();
    EXPECT_FALSE(ValidateFontAtlasPayload(candidate, testArena.scratchArena));
    candidate = original;
    candidate.glyphs[1u].glyphId = 0u;
    EXPECT_FALSE(ValidateFontAtlasPayload(candidate, testArena.scratchArena));
    candidate = original;
    candidate.bakePpem = 15u;
    EXPECT_FALSE(ValidateFontAtlasPayload(candidate, testArena.scratchArena));
    candidate = original;
    candidate.spreadPixels = 33u;
    EXPECT_FALSE(ValidateFontAtlasPayload(candidate, testArena.scratchArena));
    candidate = original;
    candidate.groups[0u].width = 2049u;
    EXPECT_FALSE(ValidateFontAtlasPayload(candidate, testArena.scratchArena));
    candidate = original;
    candidate.fontSha256 = Sha256Digest();
    EXPECT_FALSE(ValidateFontAtlasPayload(candidate, testArena.scratchArena));
}

void VerifyAssetsFontAtlas_OriginalSourcePositioningSetAndBytesMustMatchTheShapingFont(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    AtlasTestArena testArena = AtlasTestArena();
    Font font(testArena.arena, Name(s_BodyFontPath));
    FontAtlasPayload payload = MakePayload(testArena);
    const Path sourcePath = BundledFontRoot() / s_LatinFontFilename;
    const Expected<AssetBytes, StringView> bytesResult = ReadBundledFontBytes(sourcePath, testArena.arena);
    ASSERT_TRUE(bytesResult.has_value());
    AssetBytes loadedFontBytes = CopyAtlasBytes(bytesResult.value(), testArena.arena);
    font.setFontBytes(loadedFontBytes);
    ASSERT_TRUE(font.validatePayload());
    payload.fontSha256 = ComputeSha256(font.fontBytes());
    payload.positioningTables.clear();
    const Expected<FontSfntDirectory> directoryResult = ReadFontSfntDirectory(font.fontBytes());
    ASSERT_TRUE(directoryResult.has_value());
    const FontSfntDirectory directory = directoryResult.value();

    for(u16 index = 0u; index < directory.tableCount(); ++index){
        const Expected<FontSfntTable> sourceTableResult = directory.table(index);
        ASSERT_TRUE(sourceTableResult.has_value());
        const FontSfntTable sourceTable = sourceTableResult.value();
        const Span<u8> tableBytes = sourceTable.bytes;

        if(sourceTable.tag == s_FontSfntHeadTag){
            const Expected<u16> unitsPerEmResult = ReadU16BigEndian(tableBytes, 18u);
            ASSERT_TRUE(unitsPerEmResult.has_value());
            payload.unitsPerEm = unitsPerEmResult.value();
        }
        if(sourceTable.tag == s_FontSfntMaxpTag){
            const Expected<u16> glyphCountResult = ReadU16BigEndian(tableBytes, 4u);
            ASSERT_TRUE(glyphCountResult.has_value());
            payload.sourceGlyphCount = glyphCountResult.value();
        }
        if(sourceTable.tag == s_FontAtlasKernTag || sourceTable.tag == s_FontAtlasGposTag || sourceTable.tag == s_FontAtlasGdefTag){
            payload.positioningTables.emplace_back(testArena.arena);
            mut FontAtlasPositioningTable table = payload.positioningTables.back();
            table.tag = sourceTable.tag;
            table.bytes.resize(tableBytes.size());
            for(usize byteIndex = 0u; byteIndex < tableBytes.size(); ++byteIndex)
                table.bytes[byteIndex] = tableBytes[byteIndex];
            table.sha256 = ComputeSha256(table.bytes);
        }
    }
    ASSERT_FALSE(payload.positioningTables.empty());
    ASSERT_TRUE(ValidateFontAtlasSourceMatch(payload, font));
    payload.positioningTables[0u].bytes.back() ^= 1u;
    EXPECT_FALSE(ValidateFontAtlasSourceMatch(payload, font));
    payload.positioningTables[0u].bytes.back() ^= 1u;
    payload.positioningTables.pop_back();
    EXPECT_FALSE(ValidateFontAtlasSourceMatch(payload, font));
    payload.font.virtualPath = s_FontAtlasDifferentFont;
    EXPECT_FALSE(ValidateFontAtlasSourceMatch(payload, font));
}

void VerifyAssetsFontMetadata_BunchRejectsInvalidAndDuplicateChildrenWithoutPublication(){
