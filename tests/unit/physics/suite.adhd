            floorCol.shapeType = ShapeType::Hull;
            floorCol.isBox = true;
            floorCol.halfExtents = f32x4(40.0f, 0.5f, 40.0f, 0.0f);
        }

        Entity ragEnt = tw.world.createEntity();
        ragEnt.addComponent<TransformComponent>().position = f32x4(-6.0f, 5.0f, 0.0f, 0.0f);
        {
            mut RagdollComponent rc = ragEnt.addComponent<RagdollComponent>();
            rc.enableSelfCollision = false;
            RagdollBoneDef b0;
            b0.parentIndex = s_NullIndex;
            b0.shapeType = RagdollBoneShapeType::Sphere;
            b0.sphere = MakeSphereShape(VectorSingle(0.0f), 0.25f).value();
            b0.bodyDef.position = f32x4(0.0f, 1.5f, 0.0f, 0.0f);
            RagdollBoneDef b1;
            b1.parentIndex = 0u;
            b1.shapeType = RagdollBoneShapeType::Sphere;
            b1.sphere = MakeSphereShape(VectorSingle(0.0f), 0.2f).value();
            b1.bodyDef.position = f32x4(0.0f, 2.1f, 0.0f, 0.0f);
            b1.jointAnchorWorld = f32x4(0.0f, 1.8f, 0.0f, 0.0f);
            rc.bones.push_back(b0);
            rc.bones.push_back(b1);
        }

        Entity chEnt = tw.world.createEntity();
        {
            mut TransformComponent chXf = chEnt.addComponent<TransformComponent>();
            chXf.position = f32x4(0.0f, 1.35f, 0.0f, 0.0f);
            chXf.scale = f32x4(2.0f, 1.5f, 2.5f, 0.0f);
        }
        chEnt.addComponent<RigidBodyComponent>().type = BodyType::Dynamic;
        {
            mut ColliderComponent chCol = chEnt.addComponent<ColliderComponent>();
            chCol.shapeType = ShapeType::Hull;
            chCol.isBox = true;
        }
        Entity wheelEnt = tw.world.createEntity();
        wheelEnt.addComponent<TransformComponent>();
        physSys.registerNamedEntity(Name("w0"), wheelEnt.id());
        {
            mut VehicleComponent vc = chEnt.addComponent<VehicleComponent>();
            vc.engine.torqueCurvePoints.push_back(f32x2u(900.0f, 300.0f));
            vc.engine.torqueCurvePoints.push_back(f32x2u(4000.0f, 450.0f));
            VehicleWheelDef w0;
            w0.attachmentPoint = f32x4(0.0f, -0.3f, 0.5f, 0.0f);
            w0.wheelRadius = 0.35f;
            w0.suspensionRestLength = 0.3f;
            w0.suspensionMaxTravel = 0.2f;
            w0.wheelWidth = 0.2f;
            vc.wheels.push_back(w0);
            vc.wheelEntityNames.push_back(Name("w0"));
            vc.input.throttle = 0.8f;
        }

        Entity proxyKinEnt = tw.world.createEntity();
        proxyKinEnt.addComponent<TransformComponent>().position = f32x4(8.0f, 3.0f, 0.0f, 0.0f);
        {
            mut RigidBodyComponent proxyKinRb = proxyKinEnt.addComponent<RigidBodyComponent>();
            proxyKinRb.type = BodyType::Kinematic;
            proxyKinRb.gravityScale = 0.0f;
        }
        proxyKinEnt.addComponent<ColliderComponent>().shapeType = ShapeType::Sphere;
        physSys.registerNamedEntity(Name("artKin"), proxyKinEnt.id());

        Entity proxyStatEnt = tw.world.createEntity();
        proxyStatEnt.addComponent<TransformComponent>().position = f32x4(8.0f, 4.0f, 0.0f, 0.0f);
        proxyStatEnt.addComponent<ColliderComponent>().shapeType = ShapeType::Sphere;
        physSys.registerNamedEntity(Name("artStat"), proxyStatEnt.id());

        Entity artEnt = tw.world.createEntity();
        {
            mut TransformComponent artXf = artEnt.addComponent<TransformComponent>();
            artXf.position = f32x4(8.0f, 4.0f, 0.0f, 0.0f);
            artXf.scale = f32x4(2.0f, 2.0f, 2.0f, 0.0f);
        }
        {
            mut ArticulationComponent ac = artEnt.addComponent<ArticulationComponent>();
            ac.enableSelfCollision = true;
            ac.enableSleep = false;
            ArticulationLinkDef l0;
            l0.parentIndex = s_NullIndex;
            ArticulationLinkDef l1;
            l1.parentIndex = 0u;
            l1.jointType = ArticulationJointType::Revolute;
            l1.jointToChild = Transform3D(VectorSingle(0.0f, -0.5f, 0.0f, 0.0f), QuaternionIdentity());
            l1.enableDrive = true;
            l1.driveStiffness = 50.0f;
            l1.driveDamping = 5.0f;
            l1.driveTargetPos = 0.4f;
            ac.links.push_back(l0);
            ac.links.push_back(l1);
            ac.proxyEntityNames.push_back(Name("artStat"));
            ac.proxyEntityNames.push_back(Name("artKin"));
            ArticulationLoopConstraint loopC;
            loopC.linkIndexA = 0u;
            loopC.linkIndexB = 1u;
            loopC.enabled = false;
            ac.loopConstraints.push_back(loopC);
        }

        Entity charEnt = tw.world.createEntity();
        {
            mut TransformComponent charXf = charEnt.addComponent<TransformComponent>();
            charXf.position = f32x4(-12.0f, 1.8f, 0.0f, 0.0f);
            charXf.scale = f32x4(2.0f, 2.0f, 2.0f, 0.0f);
        }
        {
            mut ColliderComponent charSelfCol = charEnt.addComponent<ColliderComponent>();
            charSelfCol.shapeType = ShapeType::Sphere;
            charSelfCol.radius = 0.3f;
