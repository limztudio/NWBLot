////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace Tests::Smoke{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ReflectionSmokeConfiguration final{
public:
    [[nodiscard]] static b8 ReadFlag(AStringView name, Core::Alloc::ScratchArena& scratchArena, b8& value);
    [[nodiscard]] b8 configure(Impl::RendererSystem& renderer, Core::GraphicsRuntime& graphics, b8 extendedCase, b8 feedbackCase, b8 opticalCase, b8 furnace, b8 opticalTir, Core::Alloc::ScratchArena& scratchArena);
    [[nodiscard]] Impl::ReflectionSettings& settings()noexcept{ return m_settings; }
    [[nodiscard]] const Impl::ReflectionSettings& settings()const noexcept{ return m_settings; }
    [[nodiscard]] u32 targetSamples()const noexcept{ return m_targetSamples; }
    [[nodiscard]] u32 postResetSamples()const noexcept{ return m_postResetSamples; }
    [[nodiscard]] u32 requestedSeed()const noexcept{ return m_requestedSeed; }
    [[nodiscard]] f32 authoredRoughness()const noexcept{ return m_authoredRoughness; }
    [[nodiscard]] b8 feedbackCapture()const noexcept{ return m_feedbackCapture; }
    [[nodiscard]] b8 freshFinalState()const noexcept{ return m_freshFinalState; }


private:
    [[nodiscard]] static b8 ReadU32(AStringView name, u32 minimum, u32 maximum, Core::Alloc::ScratchArena& scratchArena, u32& value);


private:
    Impl::ReflectionSettings m_settings;
    u32 m_targetSamples = 16u;
    u32 m_postResetSamples = 1u;
    u32 m_requestedSeed = 0u;
    f32 m_authoredRoughness = 0.f;
    b8 m_feedbackCapture = false;
    b8 m_freshFinalState = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_END


