type ReflectionCounterArray = Array<u32, s_ReflectionReadbackCounterCount>;
type RefractionCounterArray = Array<u32, s_RefractionReadbackCounterCount>;
type ReflectionPendingEntry = Expected<StatisticsPendingReadback>;
type ReflectionTraceModeEnum = ReflectionTraceMode;
type ReflectionDebugViewEnum = ReflectionDebugView;
type RenderableMeshStatusResult = Expected<RenderableMeshDesc, RenderableMeshResolution>;
type SceneLightSpan = Span<SceneLightGpuData>;
type PruneMeshAssetRef = AssetRef<Mesh>;


