#include <impl/ecs_render/material/pipeline_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_Texture2dAssetKindLabel = "Texture2D";
const StringView s_SamplerAssetKindLabel = "sampler";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void LogMaterialResourceLoadFailed(in Name materialName, in StringView resourceKindLabel, in Name assetName){
    error(
        "RendererSystem: material '{}' failed to load {} asset '{}'"
        , materialName.resolvedText()
        , resourceKindLabel
        , assetName.resolvedText()
    );
}

void LogEmptyRendererMaterial(){
    error("RendererSystem: renderer material is empty");
}

void LogMaterialResourceDescriptorHeapMissing(){
    error("RendererSystem: cannot resolve material resources without an initialized descriptor heap");
}

void LogIncompatibleTexture2dDimension(in Name assetPath){
    error("RendererSystem: Texture2D asset '{}' has an incompatible texture dimension", assetPath.resolvedText());
}


