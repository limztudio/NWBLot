Expected<Optional<Name>> ResolveDeferredGraphQueueInternalIdleScope(in b8 queueValid, in u32 queueIndex){
    if(!queueValid)
        return Optional<Name>();

    CompactString scopeText = CompactString("render.deferred_graph.queue_");
    AppendUnsignedU64Text(scopeText, cast<u64>(queueIndex));
    if(!scopeText.append(".internal_idle"))
        return MakeUnexpected(Failure());
    const Expected<Name> parsedScope = ParseName(scopeText.view());
    if(!parsedScope.has_value())
        return MakeUnexpected(parsedScope.error());
    return Optional<Name>(parsedScope.value());
}


