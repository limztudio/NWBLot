void VerifyEcsGraphics_RaySceneSnapshotDoesNotTreatMissingResourcesAsHardwareAvailability(){
    RayTracingSceneGraphResources resources = RayTracingSceneGraphResources();
    resources.hardwareAvailable = true;
    EXPECT_FALSE(resources.valid());
}

void VerifyEcsGraphics_RaySceneGraphReadsMissingResourcesRetainScratchArena(){
    const RayTracingSceneGraphResources resources = RayTracingSceneGraphResources();
    RaySceneGraphReadsContext context = RaySceneGraphReadsContext();
    const ArenaMemoryStats scratchBefore = context.scratchMemoryStats();
    const b8 hasReads = TryImportRaySceneGraphReads(resources, context);
    const ArenaMemoryStats scratchAfter = context.scratchMemoryStats();

    EXPECT_FALSE(hasReads);
    EXPECT_EQ(scratchAfter.usedBytes, scratchBefore.usedBytes);
    EXPECT_EQ(scratchAfter.reservedBytes, scratchBefore.reservedBytes);
    EXPECT_EQ(scratchAfter.allocationCount, scratchBefore.allocationCount);
    EXPECT_EQ(scratchAfter.reallocationCount, scratchBefore.reallocationCount);
    EXPECT_EQ(scratchAfter.deallocationCount, scratchBefore.deallocationCount);
    const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(context.graph);
    ASSERT_TRUE(view.valid());
    EXPECT_EQ(view.resourceCount(), 0u);
}

void VerifyRayTracingSceneIdentityTests_UntrustedScenesNeverPublishTrustedContentAndAbsentCsgIsIgnored(){
    const RayTracingSceneIdentityBuilder builder = RayTracingSceneIdentityBuilder();
    const RayTracingSceneContentStamp complete = builder.buildSoftwareContentStamp(7u, 11u, 13u, false, 17u, true, true);
    const RayTracingSceneContentStamp ignored = builder.buildSoftwareContentStamp(7u, 11u, 13u, false, 19u, true, true);
    const RayTracingSceneContentStamp incomplete = builder.buildSoftwareContentStamp(7u, 11u, 13u, false, 17u, true, false);
    const RayTracingSceneContentStamp dynamic = builder.buildSoftwareContentStamp(7u, 11u, 13u, false, 17u, false, true);
    const RayTracingSceneContentStamp csg = builder.buildSoftwareContentStamp(7u, 11u, 13u, true, 17u, true, true);

    EXPECT_TRUE(complete.trusted);
    EXPECT_EQ(complete.geometry, 7u);
    EXPECT_EQ(complete.material, ignored.material);
    EXPECT_FALSE(incomplete.trusted);
    EXPECT_FALSE(dynamic.trusted);
    EXPECT_NE(complete.material, csg.material);
}

void VerifySceneBvhUploadPolicy_StaleReuseAndUnacceptedUploadCannotPublishCacheIdentity(){
    const SceneBvhUploadPolicy policy = SceneBvhUploadPolicy();
    u64 acceptedHash = 41u;
    b8 acceptedValid = true;
    EXPECT_FALSE(policy.publishAcceptedUpload(false, true, true, 99u, acceptedHash, acceptedValid));
    EXPECT_EQ(acceptedHash, 41u);
    EXPECT_TRUE(acceptedValid);
    EXPECT_FALSE(policy.publishAcceptedUpload(true, false, true, 99u, acceptedHash, acceptedValid));
    EXPECT_EQ(acceptedHash, 41u);
    EXPECT_TRUE(acceptedValid);
    EXPECT_FALSE(policy.snapshotAccepted(false, true, false, 41u, 41u, 3u, 3u));
    EXPECT_FALSE(policy.snapshotAccepted(false, true, true, 41u, 42u, 3u, 3u));
    EXPECT_FALSE(policy.snapshotAccepted(false, true, true, 41u, 41u, 3u, 4u));
    EXPECT_FALSE(policy.snapshotAccepted(false, false, true, 41u, 41u, 3u, 3u));
    EXPECT_TRUE(policy.snapshotAccepted(false, true, true, 41u, 41u, 3u, 3u));
    EXPECT_TRUE(policy.snapshotAccepted(true, false, false, 41u, 42u, 3u, 4u));
    EXPECT_TRUE(policy.publishAcceptedUpload(true, true, false, 99u, acceptedHash, acceptedValid));
    EXPECT_EQ(acceptedHash, 41u);
    EXPECT_FALSE(acceptedValid);
}

void VerifyRayTracingBuildPolicy_StaleTlasCompletionCannotPublishTheOldSceneOrClearFreshBacking(){
    const RayTracingBuildPolicy policy = RayTracingBuildPolicy();
    u64 cachedHash = 41u;
    b8 cacheValid = true;
    b8 backingFresh = true;
    policy.publishConfirmedSceneTlasBuild(false, true, 99u, cachedHash, cacheValid, backingFresh);
    EXPECT_EQ(cachedHash, 41u);
    EXPECT_FALSE(cacheValid);
    EXPECT_TRUE(backingFresh);
    policy.publishConfirmedSceneTlasBuild(true, true, 99u, cachedHash, cacheValid, backingFresh);
    EXPECT_EQ(cachedHash, 99u);
    EXPECT_TRUE(cacheValid);
    EXPECT_FALSE(backingFresh);
    policy.publishConfirmedSceneTlasBuild(true, false, 111u, cachedHash, cacheValid, backingFresh);
    EXPECT_EQ(cachedHash, 99u);
    EXPECT_FALSE(cacheValid);
    EXPECT_FALSE(backingFresh);
}

void VerifyRefractiveBoundsIsolation_TouchingTheCertifiedMarginIsNotIsolated(){
    const RefractiveBoundsIsolation policy = RefractiveBoundsIsolation();
    Array<RayTracingInstanceWorldBounds, 2> bounds = Array<RayTracingInstanceWorldBounds, 2>();
    bounds[0u].minimum = f32x3u(0.0f, 0.0f, 0.0f);
    bounds[0u].maximum = f32x3u(1.0f, 1.0f, 1.0f);
    bounds[1u].minimum = f32x3u(1.0f + s_RefractionCertifiedBoundsMargin, 0.0f, 0.0f);
    bounds[1u].maximum = f32x3u(2.0f, 1.0f, 1.0f);
    EXPECT_FALSE(policy.isIsolated(bounds, 0u));
    EXPECT_FALSE(policy.isIsolated(bounds, 2u));
    bounds[1u].minimum.x = 1.0f + s_RefractionCertifiedBoundsMargin * 2.0f;
    EXPECT_TRUE(policy.isIsolated(bounds, 0u));
}


