////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SHADOW_HEAP_RESOURCES_SLANGI
#define NWB_GRAPHICS_SHADOW_HEAP_RESOURCES_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Shared heap aliases for shadow producers, denoise, temporal merge. Globals; typed views per shader only.


#include "../bindless/bindless_heap.slangi"
#include "../deferred/bindless_resources.slangi"
#include "../raytrace/material_context_slots.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Receiver geometry stores validity as 0 or 1 in its w lane; taps above this value are valid.
#define NWB_SHADOW_GEOMETRY_VALID_THRESHOLD 0.5h


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#pragma warning(push)
#pragma warning(disable: 39001) // Deliberate typed view of the global StorageBuffer descriptor table.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWStructuredBuffer<uint, Std430DataLayout> g_NwbHeapShadowWritableUintBuffers[];
#pragma warning(pop)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


RWStructuredBuffer<uint, Std430DataLayout> nwbHeapShadowWritableUintBuffer(const uint slot){
    return g_NwbHeapShadowWritableUintBuffers[slot];
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

