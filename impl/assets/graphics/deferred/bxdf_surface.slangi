#ifndef NWB_GRAPHICS_DEFERRED_BXDF_SURFACE_SLANGI
#define NWB_GRAPHICS_DEFERRED_BXDF_SURFACE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Shared BXDF input: deferred unpacks from G-buffer, AVBOIT builds from the surface hook; both feed nwbDeferredDispatchBxdf.
// param0/1 are the material-packed alpha channels; shadingModel selects the BXDF. Linear radiance when required.
struct NwbBxdfSurface{
    half3  baseColor;
    float3 normal;          // world space, normalized
    float3 worldPosition;
    float3 viewVector;      // normalized, surface -> observer; ray effects supply the reflected viewing direction
    uint   shadingModel;
    half   param0;
    half   param1;
    bool   isBackground;    // no geometry at this pixel (sky); lighting shaders pass the base color through
    // Indirect diffuse irradiance for this surface. The deferred path fills it from the resolved surfel-GI
    // irradiance texture, while disabled/transparent paths receive the hemiAmbient fallback. Materials decide how
    // to consume it (lambert adds albedo*irradiance; toon may quantize).
    half3  indirectIrradiance;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

