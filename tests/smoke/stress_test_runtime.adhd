[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if defined(NWB_ASYNC_SHADOW_M4_BENCHMARK)
#include <core/graphics/backend_selection/backend.h>
#endif

namespace NWB::Tests::Smoke{
[[nodiscard]] NWB_INLINE AStringView StressTestProjectName()noexcept{
    return "StressTestSmokeProject";
}

[[nodiscard]] NWB_INLINE AStringView StressCpuTimingOwnerName()noexcept{
    return "stress";
}

#if defined(NWB_ASYNC_SHADOW_M4_BENCHMARK)
inline constexpr b8 s_StressAsyncShadowM4Benchmark = true;
#else
inline constexpr b8 s_StressAsyncShadowM4Benchmark = false;
#endif

#if defined(NWB_SMOKE_DISABLE_ASYNC_COMPUTE)
inline constexpr b8 s_StressAsyncComputeRequested = false;
#else
inline constexpr b8 s_StressAsyncComputeRequested = true;
#endif

#if defined(NWB_HARDWARE_SHADOW_BOUNDARY_BENCHMARK)
inline constexpr b8 s_StressHardwareShadowBenchmark = true;
#else
inline constexpr b8 s_StressHardwareShadowBenchmark = false;
#endif

#if defined(NWB_ASYNC_SHADOW_M4_BENCHMARK) || defined(NWB_HARDWARE_SHADOW_BOUNDARY_BENCHMARK)
inline constexpr b8 s_StressContinuousBenchmarkRendering = true;
#else
inline constexpr b8 s_StressContinuousBenchmarkRendering = false;
#endif
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f64 s_StressTimingWarmupSeconds = 5.0;
const f64 s_StressDefaultWarmupSeconds = 0.25;
const f64 s_StressTimingMeasurementSeconds = 30.0;
const f32 s_StressMaxM4FreezeFrame = 1000000.0f;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class StressM4QueueEntry{
    public u16 index = u16.max;
    public u16 deviceGeneration = 0u;

    public b8 valid()const{
        return this.index != u16.max && this.deviceGeneration != 0u;
    }

    public b8 matches(in StressM4QueueEntry other)const{
        return this.index == other.index && this.deviceGeneration == other.deviceGeneration;
    }
}

class StressM4QueueInfoSnapshot{
    public StressM4QueueEntry id = StressM4QueueEntry();
    public b8 present = false;
    public b8 dedicated = false;
    public b8 computeSupported = false;
    public b8 graphicsSupported = false;
}

class StressTestSmokeProjectImpl : IProjectEntryCallbacks{
    public StressTestSmokeProjectImpl(mut ProjectRuntimeContext context){
        this.m_context = context;
        this.m_world = CreateStressTestWorldOrDie(context);
        this.m_timingRenderPass = AvboitTimingRenderPass(context.graphics);
        this.m_timingEnabled = StressTimingEnabled();
        this.m_fpsProbe = PresentationFpsProbe(StressFpsWarmupSeconds(StressTimingEnabled()), StressFpsMeasurementSeconds(StressTimingEnabled()));
        this.m_cpuTimingProbe = SmokeCpuGpuTimingProbe(StressCpuTimingOwnerName());
        this.m_gpuPassTimingProbe = GpuPassTimingProbe(StressTestProjectName());
        this.m_m4PixelCaptureFreezeFrame = ResolveStressM4PixelCaptureFreezeFrame();
        this.m_cpuDiagnosticsEnabled = ReadSmokeEnvironmentFlag("NWB_STRESS_CPU_DIAGNOSTICS");
        this.m_reflectionDiagnosticsEnabled = ReadSmokeEnvironmentFlag("NWB_STRESS_REFLECTION_DIAGNOSTICS");
    }

    public ~StressTestSmokeProjectImpl(){
        this.m_context.input.removeHandler(this.m_arrowYawInput);
        this.m_timingRenderPass.stop();
        this.destroyWorld();
    }

    public b8 onStartup()override{
        if(!ValidateStressM4QueueTopology(this.m_context))
            return false;

        if(s_StressAsyncShadowM4Benchmark){
            const Expected<String> snapshotPath = ReadSmokeEnvironmentString("NWB_STRESS_FRAME_GRAPH_FILE");
            if(snapshotPath.has_value())
                this.m_frameGraphSnapshotPath = snapshotPath.value();
            else
                this.m_frameGraphSnapshotPath.clear();
            if(!this.m_frameGraphSnapshotPath.empty() && (this.m_timingEnabled || this.m_m4PixelCaptureFreezeFrame == 0u)){
                error("StressTestSmokeProject: frame graph snapshot requires pixel freeze and excludes presentation measurement");
                return false;
            }
        }

        const Expected<u32> charactersPerClass = ReadStressCharactersPerClass();
        if(!charactersPerClass.has_value())
            return false;
        this.m_charactersPerClass = charactersPerClass.value();

        ReflectionSettings reflectionSettings = ReflectionSettings();
        reflectionSettings.diagnosticsEnabled = this.m_reflectionDiagnosticsEnabled;
        if(!ApplyReflectionQualitySmokeSettings(reflectionSettings, SmokeRendererSystemRef(SmokeWorldRef(this.m_world))))
            return false;
        if(this.m_reflectionDiagnosticsEnabled)
            [essential] info("StressTestSmokeProject: reflection diagnostics enabled");

        String cpuTimingPath = String();
        const Expected<String> cpuTimingEnv = ReadSmokeEnvironmentString("NWB_STRESS_CPU_TIMING_FILE");
        if(cpuTimingEnv.has_value())
            cpuTimingPath = cpuTimingEnv.value();
        if(!this.m_cpuTimingProbe.initialize(this.m_cpuDiagnosticsEnabled, this.m_timingEnabled, StringView(cpuTimingPath)))
            return false;

        PerfCaptureOptions capture = SmokePerfGpuTimingOnly();
        capture.cpuTiming = this.m_cpuDiagnosticsEnabled;
        this.m_context.setPerfCapture(capture);
        const b8 hasQuitCallback = SmokeContextHasQuitCallback(this.m_context);
        if(this.m_timingEnabled && (this.m_m4PixelCaptureFreezeFrame != 0u || RendererBaselineCaptureFreezeFrame() != 0u || !hasQuitCallback)){
            error("StressTestSmokeProject: timing requires continuous submissions and a quit callback");
            return false;
        }
        if((this.m_timingEnabled || s_StressContinuousBenchmarkRendering) && !this.m_timingRenderPass.start(true))
            return false;
        if(this.m_timingEnabled){
            this.m_pacingRing.reset();
            [essential] info("StressTestSmokeProject: presentation timing warmup_seconds=5 measure_seconds=30 clock=steady accepted_native_present=1");
            u32 meshletsFlag = 0u;
            if(this.m_context.graphics.queryFeatureSupport(Feature::Meshlets))
                meshletsFlag = 1u;
            u32 rayQueryFlag = 0u;
            if(this.m_context.graphics.queryFeatureSupport(Feature::RayQuery))
                rayQueryFlag = 1u;
            u32 rayPipelineFlag = 0u;
            if(this.m_context.graphics.queryFeatureSupport(Feature::RayTracingPipeline))
                rayPipelineFlag = 1u;
            u32 accelStructFlag = 0u;
            if(this.m_context.graphics.queryFeatureSupport(Feature::RayTracingAccelStruct))
                accelStructFlag = 1u;
            [essential] info(
                "StressTestSmokeProject: device capability meshlets={} rayquery={} raypipeline={} accelstruct={} wavelanes={} renderer={}"
                , meshletsFlag
                , rayQueryFlag
                , rayPipelineFlag
                , accelStructFlag
                , this.m_context.graphics.queryWaveLaneCount()
                , this.m_context.graphics.getRendererString()
            );
        }

        this.m_context.input.addHandlerToBack(this.m_arrowYawInput);

        const u32 charsPerClass = this.m_charactersPerClass;
        const b8 comparison = charsPerClass == s_StressComparisonCharactersPerClass;
        const b8 opaqueOnly = StressHardwareShadowOpaqueBaseline();
        return this.m_scene.initialize(this.m_context, SmokeWorldRef(this.m_world), charsPerClass, comparison, opaqueOnly);
    }

    public void onShutdown()override{
        this.m_context.graphics.setFrameSubmissionSuspended(false);
        this.m_context.input.removeHandler(this.m_arrowYawInput);
        this.m_timingRenderPass.stop();
        if(this.m_timingEnabled && !this.m_timingComplete)
            error("StressTestSmokeProject: presentation measurement incomplete");
        this.destroyWorld();
        [essential] info("StressTestSmokeProject: shutdown");
    }

    public b8 onUpdate(in f32 delta)override{
        if(this.m_m4PixelCaptureFreezeFrame != 0u && this.m_m4RenderedFrameCount >= this.m_m4PixelCaptureFreezeFrame){
            if(!this.m_m4PixelCapturePaused){
                if(s_StressAsyncShadowM4Benchmark && !this.m_frameGraphSnapshotPath.empty()){
                    const u64 renderedFrames = cast<u64>(this.m_m4RenderedFrameCount);
                    if(!CaptureStressFrameGraphSnapshot(StringView(this.m_frameGraphSnapshotPath), renderedFrames, this.m_context))
                        return false;
                }
                this.m_context.graphics.setFrameSubmissionSuspended(true);
                this.m_m4PixelCapturePaused = true;
                [essential] info("StressTestSmokeProject: M4 pixel capture ready after {} rendered frames; render submission suspended", this.m_m4RenderedFrameCount);
            }
            return true;
        }

        const u32 baselineCaptureFreezeFrame = RendererBaselineCaptureFreezeFrame();
        if(baselineCaptureFreezeFrame != 0u && this.m_m4RenderedFrameCount >= baselineCaptureFreezeFrame){
            if(!this.m_rendererBaselineCapturePaused){
                this.m_context.graphics.setFrameSubmissionSuspended(true);
                this.m_rendererBaselineCapturePaused = true;
                [essential] info("StressTestSmokeProject: renderer baseline capture ready after {} rendered frames; render submission suspended", this.m_m4RenderedFrameCount);
            }
            return true;
        }

        const f32 fixedDelta = RendererBaselineFixedDelta();
        f32 safeDelta = 0.0f;
        if(fixedDelta > 0.0f)
            safeDelta = fixedDelta;
        else if(IsFinite(delta))
            safeDelta = Max(delta, 0.0f);

        if(!this.samplePresentationFps())
            return false;
        this.m_gpuPassTimingProbe.recordFrame(safeDelta, this.m_context.gpuTimingView());
        const f32 frozen = StressFrozenYaw();
        this.m_yaw.update(safeDelta, frozen, frozen >= 0.0f, this.m_arrowYawInput, s_StressManualYawSpeed, s_StressSpinSpeed, s_StressMaxSpinDelta);

        const f32 currentYaw = this.m_yaw.yaw();
        if(!this.m_scene.update(currentYaw, SmokeWorldRef(this.m_world)))
            return false;

        SetSmokeYawWindowTitle(currentYaw, this.m_yaw.manualControl(), s_StressTwoPi, this.m_context);

        if(!TickSmokeWorld(safeDelta, SmokeWorldRef(this.m_world)))
            return false;

        this.reportReflectionStatistics();
        ++this.m_m4RenderedFrameCount;
        return true;
    }

    private void destroyWorld(){
        DestroySmokeSkinnedRenderWorld(this.m_context, this.m_world);
    }

    private void reportReflectionStatistics(){
        if(!this.m_reflectionDiagnosticsEnabled)
            return;
        const Expected<ReflectionStatistics> statisticsResult = SmokeRendererSystemRef(SmokeWorldRef(this.m_world)).tryGetLatestReflectionStatistics();
        if(!statisticsResult.has_value())
            return;
        const ReflectionStatistics statistics = statisticsResult.value();
        if(statistics.sequence == this.m_reflectionStatisticsSequence && statistics.generation == this.m_reflectionStatisticsGeneration)
            return;
        this.m_reflectionStatisticsSequence = statistics.sequence;
        this.m_reflectionStatisticsGeneration = statistics.generation;
        u32 hardwareReadyFlag = 0u;
        if(statistics.hardwareReady)
            hardwareReadyFlag = 1u;
        u32 opticalTransportFlag = 0u;
        if(statistics.opticalTransportEnabled)
            opticalTransportFlag = 1u;
        [essential] info(
            "StressReflectionStatistics: sequence={} generation={} frame={} graphics_frame={} hardware_ready={} transport_enabled={} candidates={} hardware_rays={} exterior_eligible_rays={} query_budget_units={} physical_queries={} bootstrap_events={} transparent_paths={} unsupported_paths={} screen_attempts={} screen_hits={} screen_returns={} screen_iterations={} screen_limit_misses={}"
            , statistics.sequence
            , statistics.generation
            , statistics.frameIndex
            , statistics.graphicsFrameIndex
            , hardwareReadyFlag
            , opticalTransportFlag
            , statistics.candidates
            , statistics.hardwareRays
            , statistics.exteriorEligibleRays
            , statistics.queryBudgetUnits
            , statistics.physicalQueries
            , statistics.bootstrapEvents
            , statistics.transparentPaths
            , statistics.unsupportedPaths
            , statistics.screenAttempts
            , statistics.screenHits
            , statistics.screenReturns
            , statistics.screenIterations
            , statistics.screenLimitMisses
        );
    }

    private b8 samplePresentationFps(){
        const u64 successfulPresentations = this.m_context.graphics.getSuccessfulPresentationCount();
        const Timer observationTime = TimerNow();
        this.m_pacingRing.record(successfulPresentations, observationTime);
        const PresentationFpsStatus status = this.m_fpsProbe.observe(successfulPresentations, observationTime);
        if(status == PresentationFpsStatus::Invalid){
            error("StressTestSmokeProject: presentation measurement invalid counter or clock");
            return false;
        }
        const b8 measurementComplete = status == PresentationFpsStatus::Complete;
        if(!this.m_cpuTimingProbe.observe(this.m_context.perfSession, this.m_fpsProbe, successfulPresentations, measurementComplete))
            return false;
        if(status == PresentationFpsStatus::Waiting)
            return true;

        const PresentationFpsSample interval = this.m_fpsProbe.interval();
        [essential] info(
            "StressTestSmokeProject: presentation fps avg={} presentations={} seconds={} first={} last={}"
            , interval.averageFps()
            , interval.presentations()
            , interval.wallSeconds
            , interval.firstPresentationCount
            , interval.lastPresentationCount
        );
        if(status == PresentationFpsStatus::Complete){
            const PresentationFpsSample total = this.m_fpsProbe.total();
            const PresentationPacingSummary pacingSummary = this.m_pacingRing.summarize();
            [essential] info(
                "StressTestSmokeProject: presentation pacing samples={} p50ms={} p95ms={} maxms={} stalls50ms={}"
                , pacingSummary.samples
                , pacingSummary.p50Ms
                , pacingSummary.p95Ms
                , pacingSummary.maxMs
                , pacingSummary.stallsOver50Ms
            );
            this.m_timingComplete = true;
            [essential] info(
                "StressTestSmokeProject: presentation measurement complete fps={} presentations={} seconds={} first={} last={}"
                , total.averageFps()
                , total.presentations()
                , total.wallSeconds
                , total.firstPresentationCount
                , total.lastPresentationCount
            );
            RequestSmokeQuit(this.m_context);
        }
        return true;
    }

    private mut ProjectRuntimeContext m_context;
    private NotNullUniquePtr<World> m_world;
    private StressCrowdScene m_scene = StressCrowdScene();
    private AvboitTimingRenderPass m_timingRenderPass;
    private PresentationFpsProbe m_fpsProbe;
    private PresentationPacingRing m_pacingRing = PresentationPacingRing();
    private SmokeCpuGpuTimingProbe m_cpuTimingProbe;
    private GpuPassTimingProbe m_gpuPassTimingProbe;
    private ArrowYawInputHandler m_arrowYawInput = ArrowYawInputHandler();
    private String m_frameGraphSnapshotPath = String();
    private u64 m_reflectionStatisticsSequence = 0u;
    private u64 m_reflectionStatisticsGeneration = 0u;
    private YawSpinController m_yaw = YawSpinController();
    private u32 m_charactersPerClass = s_StressDefaultCharactersPerClass;
    private u32 m_m4PixelCaptureFreezeFrame;
    private u32 m_m4RenderedFrameCount = 0u;
    private b8 m_timingEnabled;
    private b8 m_cpuDiagnosticsEnabled;
    private b8 m_reflectionDiagnosticsEnabled;
    private b8 m_timingComplete = false;
    private b8 m_m4PixelCapturePaused = false;
    private b8 m_rendererBaselineCapturePaused = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NotNullUniquePtr<World> CreateStressTestWorldOrDie(mut ProjectRuntimeContext context){
    SmokeRenderQualitySettings settings = SmokeRenderQualitySettings();
    settings.shadow.transparentSampling = TransparentShadowSampling::TemporalOne;
    settings.shadow.receiverResolution = ShadowReceiverResolution::Quarter;
    settings.surfelGi.resolveResolution = SurfelGiResolveResolution::Quarter;
    settings.softwareShadow.blockerSearch = SoftwareShadowBlockerSearch::Center1;
    settings.softwareShadow.coverage = SoftwareShadowCoverage::FittedVolume;
    settings.softwareShadow.captureCadence = SoftwareShadowCaptureCadence::ReuseTwoFrames;
    if(context.graphics.queryFeatureSupport(Feature::RayQuery))
        settings.caustic.photonGridDivisor = 2u;
    else
        settings.caustic.photonGridDivisor = 4u;
    return CreateSmokeSkinnedRenderWorldOrDie(StressTestProjectName(), settings, context);
}

b8 StressTimingEnabled(){
    return ReadSmokeEnvironmentFlag("NWB_STRESS_SMOKE_TIMING");
}

f64 StressFpsWarmupSeconds(in b8 timingEnabled){
    if(timingEnabled)
        return s_StressTimingWarmupSeconds;
    return s_StressDefaultWarmupSeconds;
}

f64 StressFpsMeasurementSeconds(in b8 timingEnabled){
    if(timingEnabled)
        return s_StressTimingMeasurementSeconds;
    return 0.0;
}

u32 ParseStressM4PixelCaptureFreezeFrame(){
    const Expected<f32> configuredFrame = ReadSmokeEnvironmentF32("NWB_M4_PIXEL_CAPTURE_FREEZE_FRAME");
    if(!configuredFrame.has_value() || !IsFinite(configuredFrame.value()) || configuredFrame.value() < 1.0f)
        return 0u;
    return cast<u32>(Min(configuredFrame.value(), s_StressMaxM4FreezeFrame));
}

u32 ResolveStressM4PixelCaptureFreezeFrame(){
    if(!s_StressAsyncShadowM4Benchmark)
        return 0u;
    return ParseStressM4PixelCaptureFreezeFrame();
}

b8 StressHardwareShadowOpaqueBaseline(){
    if(!s_StressHardwareShadowBenchmark)
        return false;
    return ReadSmokeEnvironmentFlag("NWB_HARDWARE_SHADOW_BOUNDARY_OPAQUE_BASELINE");
}

Expected<u32> ReadStressCharactersPerClass(){
    const Expected<Optional<String>, ErrorCode> value = ReadEnvironmentVariable("NWB_STRESS_CHARACTERS_PER_CLASS");
    if(!value.has_value()){
        const String errorText = StringFormat("{}", value.error().message());
        error("StressTestSmokeProject: failed to read workload environment: {}", errorText);
        return MakeUnexpected(Failure());
    }
    const Optional<String> candidate = value.value();
    if(!candidate.has_value())
        return s_StressDefaultCharactersPerClass;
    const StringView view = StringView(candidate.value());
    if(view == "5")
        return s_StressComparisonCharactersPerClass;
    if(view != "10"){
        error("StressTestSmokeProject: characters per class must be exactly 5 or 10");
        return MakeUnexpected(Failure());
    }
    return s_StressDefaultCharactersPerClass;
}

f32 StressFrozenYaw(){
    return ReadSmokeFrozenYawCached("NWB_STRESS_TEST_SPIN_ANGLE");
}

b8 ValidateStressM4QueueTopology(mut ProjectRuntimeContext context){
    if(!s_StressAsyncShadowM4Benchmark)
        return true;

    StressM4QueueEntry graphicsQueue = StressM4QueueEntry();
    StressM4QueueEntry computeQueue = StressM4QueueEntry();
    StressM4QueueInfoSnapshot graphicsInfo = StressM4QueueInfoSnapshot();
    StressM4QueueInfoSnapshot computeInfo = StressM4QueueInfoSnapshot();
    Vector<StressM4QueueEntry> queues;
    u16 deviceGeneration = 0u;
    b8 hasTopology = false;
    native(
        mut context,
        mut graphicsQueue,
        mut computeQueue,
        mut graphicsInfo,
        mut computeInfo,
        mut queues,
        mut deviceGeneration,
        mut hasTopology
    ){
#if defined(NWB_ASYNC_SHADOW_M4_BENCHMARK)
        const auto& device = context.graphics.getDevice();
        const auto rawGraphicsQueue = device.getPrimaryPhysicalQueue(Core::CommandQueue::Graphics);
        const auto rawComputeQueue = device.getPrimaryPhysicalQueue(Core::CommandQueue::Compute);
        graphicsQueue.index = rawGraphicsQueue.index;
        graphicsQueue.deviceGeneration = rawGraphicsQueue.deviceGeneration;
        computeQueue.index = rawComputeQueue.index;
        computeQueue.deviceGeneration = rawComputeQueue.deviceGeneration;
        if(const auto* const info = device.getPhysicalQueueInfo(rawGraphicsQueue)){
            graphicsInfo.present = true;
            graphicsInfo.id.index = info->id.index;
            graphicsInfo.id.deviceGeneration = info->id.deviceGeneration;
        }
        if(const auto* const info = device.getPhysicalQueueInfo(rawComputeQueue)){
            computeInfo.present = true;
            computeInfo.id.index = info->id.index;
            computeInfo.id.deviceGeneration = info->id.deviceGeneration;
            computeInfo.dedicated = info->dedicated;
            computeInfo.computeSupported = (info->capabilities & Core::GpuQueueCapability::Compute) != Core::GpuQueueCapability::None;
            computeInfo.graphicsSupported = (info->capabilities & Core::GpuQueueCapability::Graphics) != Core::GpuQueueCapability::None;
        }
        const auto topology = device.getPhysicalQueueTopology();
        deviceGeneration = device.getDeviceGeneration();
        hasTopology = topology.queues != nullptr && topology.queueCount != 0u;
        if(hasTopology){
            queues.reserve(topology.queueCount);
            for(usize queueIndex = 0u; queueIndex < topology.queueCount; ++queueIndex){
                StressM4QueueEntry entry;
                entry.index = topology.queues[queueIndex].id.index;
                entry.deviceGeneration = topology.queues[queueIndex].id.deviceGeneration;
                queues.push_back(entry);
            }
        }
#else
        (void)context;
        (void)graphicsQueue;
        (void)computeQueue;
        (void)graphicsInfo;
        (void)computeInfo;
        (void)queues;
        (void)deviceGeneration;
        (void)hasTopology;
#endif
    }

    b8 graphicsRegistered = false;
    b8 computeRegistered = false;
    b8 topologyValid = hasTopology && !queues.empty();
    if(topologyValid){
        for(in StressM4QueueEntry queue : queues){
            topologyValid = topologyValid && queue.valid() && queue.deviceGeneration == deviceGeneration;
            graphicsRegistered = graphicsRegistered || queue.matches(graphicsQueue);
            computeRegistered = computeRegistered || queue.matches(computeQueue);
        }
    }

    const StressM4QueueEntry defaultInvalidQueue = StressM4QueueEntry();
    b8 computeQueueValid = false;
    if(computeQueue.valid()){
        computeQueueValid = computeInfo.present
            && computeInfo.id.matches(computeQueue)
            && computeRegistered
            && computeQueue.deviceGeneration == deviceGeneration;
    }
    else{
        computeQueueValid = computeQueue.matches(defaultInvalidQueue) && !computeInfo.present;
    }

    if(
        !topologyValid
        || !graphicsQueue.valid()
        || graphicsQueue.deviceGeneration != deviceGeneration
        || !graphicsInfo.present
        || !graphicsInfo.id.matches(graphicsQueue)
        || !graphicsRegistered
        || !computeQueueValid
    ){
        error("StressTestSmokeProject: M4 selected queue topology is invalid");
        return false;
    }

    const b8 computeDedicated = computeInfo.present && computeInfo.dedicated;
    const b8 computeSupported = computeInfo.present && computeInfo.computeSupported;
    const b8 computeGraphics = computeInfo.present && computeInfo.graphicsSupported;
    const b8 asyncEffective = s_StressAsyncComputeRequested
        && !computeQueue.matches(graphicsQueue)
        && computeDedicated
        && computeSupported
        && !computeGraphics;

    u32 asyncRequestedFlag = 0u;
    if(s_StressAsyncComputeRequested)
        asyncRequestedFlag = 1u;
    u32 asyncEffectiveFlag = 0u;
    if(asyncEffective)
        asyncEffectiveFlag = 1u;
    u32 computeDedicatedFlag = 0u;
    if(computeDedicated)
        computeDedicatedFlag = 1u;
    u32 computeSupportedFlag = 0u;
    if(computeSupported)
        computeSupportedFlag = 1u;
    u32 computeGraphicsFlag = 0u;
    if(computeGraphics)
        computeGraphicsFlag = 1u;

    [essential] info(
        "StressTestSmokeProject: M4 async compute requested={} effective={} graphicsQueue={}:{} computeQueue={}:{} computeDedicated={} computeSupported={} computeGraphics={}"
        , asyncRequestedFlag
        , asyncEffectiveFlag
        , graphicsQueue.index
        , graphicsQueue.deviceGeneration
        , computeQueue.index
        , computeQueue.deviceGeneration
        , computeDedicatedFlag
        , computeSupportedFlag
        , computeGraphicsFlag
    );
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB::ProjectFrameClientSize NWB::QueryProjectFrameClientSize(){
    return { 1280, 900 };
}

TStringView NWB::QueryProjectWindowTitle()noexcept{
#if defined(NWB_HARDWARE_SHADOW_BOUNDARY_BENCHMARK)
    return NWB_TEXT("NWB Hardware Shadow Boundary Benchmark");
#elif defined(NWB_ASYNC_SHADOW_M4_BENCHMARK)
    return NWB_TEXT("NWB Async Shadow M4 Benchmark");
#else
    return NWB_TEXT("NWB Stress Test Smoke");
#endif
}

UniquePtr<NWB::IProjectEntryCallbacks> NWB::CreateProjectEntryCallbacks(NWB::ProjectRuntimeContext& context){
    return MakeUnique<NWB::Tests::Smoke::StressTestSmokeProjectImpl>(context);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


