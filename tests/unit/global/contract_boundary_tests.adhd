NWB_ADHD_GTEST(GlobalContractBoundaries, SignedAdditionClampsNegativeOverflowToTheLowerBound, VerifyGlobalContractBoundaries_SignedAdditionClampsNegativeOverflowToTheLowerBound)
NWB_ADHD_GTEST(GlobalContractBoundaries, AlignmentOverflowKeepsTheLastRepresentableAlignedSize, VerifyGlobalContractBoundaries_AlignmentOverflowKeepsTheLastRepresentableAlignedSize)
NWB_ADHD_GTEST(GlobalContractBoundaries, CommonAlignmentRejectsZeroAndChecksOverflowAfterReducingSharedFactors, VerifyGlobalContractBoundaries_CommonAlignmentRejectsZeroAndChecksOverflowAfterReducingSharedFactors)
NWB_ADHD_GTEST(GlobalContractBoundaries, DecimalPrefixStopsAtMalformedSuffixAndPreservesUnsignedWrap, VerifyGlobalContractBoundaries_DecimalPrefixStopsAtMalformedSuffixAndPreservesUnsignedWrap)
NWB_ADHD_GTEST(GlobalContractBoundaries, WideHashCombinationRetainsHighBitsAndWraparound, VerifyGlobalContractBoundaries_WideHashCombinationRetainsHighBitsAndWraparound)
NWB_ADHD_GTEST(GlobalContractBoundaries, Utf8OffsetRejectsMalformedPrefixesWithoutReadingTheSuffix, VerifyGlobalContractBoundaries_Utf8OffsetRejectsMalformedPrefixesWithoutReadingTheSuffix)
NWB_ADHD_GTEST(GlobalContractBoundaries, FixedIndexMapCollisionWrapAndCapacityFailurePreserveExistingEntries, VerifyGlobalContractBoundaries_FixedIndexMapCollisionWrapAndCapacityFailurePreserveExistingEntries)
NWB_ADHD_GTEST(GlobalContractBoundaries, ThrowingNotNullConversionPropagatesAndPreservesThePriorPointer, VerifyGlobalContractBoundaries_ThrowingNotNullConversionPropagatesAndPreservesThePriorPointer)
NWB_ADHD_GTEST(GlobalContractBoundaries, ConvertingCopyFromAConstReferenceOwnerRetainsItsValueDeleterAndLifetime, VerifyGlobalContractBoundaries_ConvertingCopyFromAConstReferenceOwnerRetainsItsValueDeleterAndLifetime)

