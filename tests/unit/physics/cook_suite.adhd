////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void AppendBe16Bytes(mut Vector<u8> dst, in u16 val){
    dst.push_back(cast<u8>((val >> 8u) & 0xFFu));
    dst.push_back(cast<u8>(val & 0xFFu));
}

void AppendLe16Bytes(mut Vector<u8> dst, in u16 val){
    dst.push_back(cast<u8>(val & 0xFFu));
    dst.push_back(cast<u8>((val >> 8u) & 0xFFu));
}

void AppendBe32Bytes(mut Vector<u8> dst, in u32 val){
    dst.push_back(cast<u8>((val >> 24u) & 0xFFu));
    dst.push_back(cast<u8>((val >> 16u) & 0xFFu));
    dst.push_back(cast<u8>((val >> 8u) & 0xFFu));
    dst.push_back(cast<u8>(val & 0xFFu));
}

void AppendLe32Bytes(mut Vector<u8> dst, in u32 val){
    dst.push_back(cast<u8>(val & 0xFFu));
    dst.push_back(cast<u8>((val >> 8u) & 0xFFu));
    dst.push_back(cast<u8>((val >> 16u) & 0xFFu));
    dst.push_back(cast<u8>((val >> 24u) & 0xFFu));
}

void AppendLeF32Bytes(mut Vector<u8> dst, in f32 val){
    AppendLe32Bytes(dst, bit_cast<u32>(val));
}

u32 ComputeCrc32Bytes(in Span<u8> data){
    u32 crc = 0xFFFFFFFFu;
    for(usize i = 0u; i < data.size(); ++i){
        crc ^= cast<u32>(data[i]);
        for(u32 b = 0u; b < 8u; ++b){
            if((crc & 1u) != 0u)
                crc = (crc >> 1u) ^ 0xEDB88320u;
            else
                crc >>= 1u;
        }
    }
    return crc ^ 0xFFFFFFFFu;
}

u32 ComputeAdler32Bytes(in Span<u8> data){
    u32 s1 = 1u;
    u32 s2 = 0u;
    for(usize i = 0u; i < data.size(); ++i){
        s1 = (s1 + cast<u32>(data[i])) % 65521u;
        s2 = (s2 + s1) % 65521u;
    }
    return (s2 << 16u) | s1;
}

void AppendPngChunkBytes(mut Vector<u8> out, in StringView chunkTag, in Span<u8> payload){
    AppendBe32Bytes(out, cast<u32>(payload.size()));
    Vector<u8> crcBuf;
    crcBuf.reserve(4u + payload.size());
    for(usize i = 0u; i < 4u; ++i)
        crcBuf.push_back(cast<u8>(chunkTag[i]));
    for(usize i = 0u; i < payload.size(); ++i)
        crcBuf.push_back(payload[i]);
    for(usize i = 0u; i < crcBuf.size(); ++i)
        out.push_back(crcBuf[i]);
    AppendBe32Bytes(out, ComputeCrc32Bytes(Span<u8>(crcBuf.data(), crcBuf.size())));
}

b8 WriteTestGray16Png(in Path filePath, in u32 width, in u32 height, in Span<u16> pixels){
    if(pixels.size() != cast<usize>(width) * cast<usize>(height))
        return false;
    Vector<u8> png;
    png.push_back(0x89u);
    png.push_back(0x50u);
    png.push_back(0x4Eu);
    png.push_back(0x47u);
    png.push_back(0x0Du);
    png.push_back(0x0Au);
    png.push_back(0x1Au);
    png.push_back(0x0Au);

    Vector<u8> ihdr;
    AppendBe32Bytes(ihdr, width);
    AppendBe32Bytes(ihdr, height);
    ihdr.push_back(16u);
    ihdr.push_back(0u);
    ihdr.push_back(0u);
    ihdr.push_back(0u);
    ihdr.push_back(0u);
    AppendPngChunkBytes(png, "IHDR", Span<u8>(ihdr.data(), ihdr.size()));

    Vector<u8> rawScanlines;
    rawScanlines.reserve(cast<usize>(height) * (1u + cast<usize>(width) * 2u));
    for(u32 y = 0u; y < height; ++y){
        rawScanlines.push_back(0u);
        for(u32 x = 0u; x < width; ++x)
            AppendBe16Bytes(rawScanlines, pixels[cast<usize>(y) * cast<usize>(width) + cast<usize>(x)]);
    }

    const u16 rawLen = cast<u16>(rawScanlines.size());
    const u16 invRawLen = rawLen ^ 0xFFFFu;
    Vector<u8> idat;
    idat.push_back(0x78u);
    idat.push_back(0x01u);
    idat.push_back(0x01u);
    AppendLe16Bytes(idat, rawLen);
    AppendLe16Bytes(idat, invRawLen);
    for(usize i = 0u; i < rawScanlines.size(); ++i)
        idat.push_back(rawScanlines[i]);
    AppendBe32Bytes(idat, ComputeAdler32Bytes(Span<u8>(rawScanlines.data(), rawScanlines.size())));
    AppendPngChunkBytes(png, "IDAT", Span<u8>(idat.data(), idat.size()));

    Vector<u8> empty;
    AppendPngChunkBytes(png, "IEND", Span<u8>(empty.data(), 0u));
    return WriteBinaryFile(filePath, png);
}

b8 WriteTestTetrahedronGlb(in Path filePath){
    const StringView jsonRaw =
        "{\"asset\":{\"version\":\"2.0\"},\"buffers\":[{\"byteLength\":72}],\"bufferViews\":[{\"buffer\":0,\"byteOffset\":0,\"byteLength\":48},{\"buffer\":0,\"byteOffset\":48,\"byteLength\":24}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":4,\"type\":\"VEC3\"},{\"bufferView\":1,\"componentType\":5123,\"count\":12,\"type\":\"SCALAR\"}],\"meshes\":[{\"primitives\":[{\"attributes\":{\"POSITION\":0},\"indices\":1}]}]}";
    usize jsonLen = jsonRaw.size();
    while((jsonLen % 4u) != 0u)
        ++jsonLen;

    const u32 binLen = 72u;
    const u32 totalLen = 12u + 8u + cast<u32>(jsonLen) + 8u + binLen;

    Vector<u8> glb;
    glb.reserve(totalLen);
    AppendLe32Bytes(glb, 0x46546C67u);
    AppendLe32Bytes(glb, 2u);
    AppendLe32Bytes(glb, totalLen);

    AppendLe32Bytes(glb, cast<u32>(jsonLen));
    AppendLe32Bytes(glb, 0x4E4F534Au);
    for(usize i = 0u; i < jsonRaw.size(); ++i)
        glb.push_back(cast<u8>(jsonRaw[i]));
    for(usize i = jsonRaw.size(); i < jsonLen; ++i)
        glb.push_back(cast<u8>(' '));

    AppendLe32Bytes(glb, binLen);
    AppendLe32Bytes(glb, 0x004E4942u);
    AppendLeF32Bytes(glb, 0.0f); AppendLeF32Bytes(glb, 0.0f); AppendLeF32Bytes(glb, 0.0f);
    AppendLeF32Bytes(glb, 2.0f); AppendLeF32Bytes(glb, 0.0f); AppendLeF32Bytes(glb, 0.0f);
    AppendLeF32Bytes(glb, 0.0f); AppendLeF32Bytes(glb, 2.0f); AppendLeF32Bytes(glb, 0.0f);
    AppendLeF32Bytes(glb, 0.0f); AppendLeF32Bytes(glb, 0.0f); AppendLeF32Bytes(glb, 2.0f);
    AppendLe16Bytes(glb, 0u); AppendLe16Bytes(glb, 2u); AppendLe16Bytes(glb, 1u);
    AppendLe16Bytes(glb, 0u); AppendLe16Bytes(glb, 1u); AppendLe16Bytes(glb, 3u);
    AppendLe16Bytes(glb, 1u); AppendLe16Bytes(glb, 2u); AppendLe16Bytes(glb, 3u);
    AppendLe16Bytes(glb, 2u); AppendLe16Bytes(glb, 0u); AppendLe16Bytes(glb, 3u);
    return WriteBinaryFile(filePath, glb);
}

b8 ParseAssetValueFromScript(
    in StringView scriptText,
    mut HeapStorage testArena,
    mut MetascriptDocument outDoc,
    mut MetascriptValue outValue
){
    if(!outDoc.parse(scriptText))
        return false;
    const Optional<in MetascriptValue> optVal = outDoc.borrowVariable("asset");
    if(!optVal.has_value())
        return false;
    outValue = MetascriptValue(optVal.value());
    return true;
}


