    float4 centerATwistMass;
    float4 centerBTwistImpulse;
    float4 softnessTangent00;
    float4 tangentMassFriction;
    float4 tangentVelRollMaxLever;
    float4 rollingImpulsePad;
    float4 normalImpulses;
    float4 normalMasses;
    NwbPhysicsGpuContactPoint points[NWB_PHYSICS_MAX_MANIFOLD_POINTS];
};

struct NwbPhysicsGpuJointConstraint{
    uint4 indicesTypeFlags;
    float4 params0;
    float4 qA0;
    float4 qB0;
    float4 rA0InvMassA;
    float4 rB0InvMassB;
    float4 baseCenterDeltaMaxMotor;
    float4 localAxisALowerLimit;
    float4 localAxisBUpperLimit;
    float4 referenceRotation;
    float4 linearOffsetMaxTorque;
    float4 linearSoftnessMotorSpeed;
    float4 angularSoftnessSwingLimit;
    float4 suspensionSoftness;
    float4 linearImpulse;
    float4 angularImpulse;
    float4 limitImpulses;
};


