void VerifyAllocatorPropagation_SelfAssignmentPreservesArenaBinding(){
    const Name owner = s_GlobalArenaCaseAllocatorPropagationSelfAssignment;
    b8 regularPreserved = false;
    b8 cacheAlignedPreserved = false;
    b8 defaultPreserved = false;
    native(in owner, mut regularPreserved, mut cacheAlignedPreserved, mut defaultPreserved){
        using namespace __hidden_allocator_propagation_tests;
        regularPreserved = CheckAllocatorSelfAssignment<ContainerDetail::ArenaAllocator<u32, GlobalArena>>(owner);
        cacheAlignedPreserved = CheckAllocatorSelfAssignment<ContainerDetail::ArenaCacheAlignedAllocator<u32, GlobalArena>>(owner);
        defaultPreserved = CheckAllocatorSelfAssignment<DefaultAllocator<u32>>(owner);
    }
    EXPECT_TRUE(regularPreserved);
    EXPECT_TRUE(cacheAlignedPreserved);
    EXPECT_TRUE(defaultPreserved);
}

void VerifyAllocatorPropagation_VectorMoveTransfersStorageAndItsDeallocationOwner(){
    Array<b8, 2> flags = Array<b8, 2>();
    flags[0u] = false;
    flags[1u] = true;
    u32 executedCases = 0u;
    for(in b8 foreignArena : flags){
        native(in foreignArena, mut executedCases){
            using namespace __hidden_allocator_propagation_tests;
            VerifyVectorMove<::Vector<u32, GlobalArena>>(foreignArena);
            VerifyVectorMove<DefaultVector<u32, GlobalArena, DefaultOwner>>(foreignArena);
            executedCases += 2u;
        }
    }
    EXPECT_EQ(executedCases, 4u);
}

void VerifyAllocatorPropagation_CacheAlignedVectorMoveTransfersStorageAndItsDeallocationOwner(){
    Array<b8, 2> flags = Array<b8, 2>();
    flags[0u] = false;
    flags[1u] = true;
    Array<usize, 3> targetSizes = Array<usize, 3>();
    targetSizes[0u] = 0u;
    targetSizes[1u] = 1u;
    targetSizes[2u] = 65u;
    u32 executedCases = 0u;
    for(in b8 foreignArena : flags){
        for(in usize targetSize : targetSizes){
            native(in foreignArena, in targetSize, mut executedCases){
                using namespace __hidden_allocator_propagation_tests;
                VerifyVectorMove<::ParallelVector<u32, GlobalArena>>(foreignArena, targetSize);
                ++executedCases;
            }
        }
    }
    EXPECT_EQ(executedCases, 6u);
}

void VerifyAllocatorPropagation_CacheAlignedVectorMoveConstructionPreservesExplicitArenaOwnership(){
    Array<b8, 2> flags = Array<b8, 2>();
    flags[0u] = false;
    flags[1u] = true;
    for(in b8 explicitAllocator : flags){
        for(in b8 foreignArena : flags){
            const Name sourceOwner = s_GlobalArenaCaseAllocatorPropagationParallelConstructSource;
            const Name targetOwner = s_GlobalArenaCaseAllocatorPropagationParallelConstructTarget;
            ArenaMemoryStats sourceStats = ArenaMemoryStats();
            ArenaMemoryStats targetStats = ArenaMemoryStats();
            native(in explicitAllocator, in foreignArena, in sourceOwner, in targetOwner, mut sourceStats, mut targetStats){
                using NWB::Core::Alloc::GlobalArena;
                GlobalArena sourceArena{ sourceOwner };
                GlobalArena targetArena{ targetOwner };
                using Values = ::ParallelVector<u32, GlobalArena>;
                {
                    Values source{ sourceArena };
                    for(u32 index = 0u; index < 128u; ++index)
                        source.push_back(index);
                    const NotNull<const u32*> firstElement = MakeNotNull(&source[0u]);
                    GlobalArena& destinationArena = explicitAllocator && foreignArena ? targetArena : sourceArena;
                    Values target = explicitAllocator ? Values(Move(source), destinationArena) : Values(Move(source));
                    EXPECT_EQ(target.get_allocator().arenaPtr(), &destinationArena);
                    ASSERT_EQ(target.size(), 128u);
                    EXPECT_EQ(&target[0u] == firstElement.get(), &destinationArena == &sourceArena);
                    for(u32 index = 0u; index < 128u; ++index)
                        EXPECT_EQ(target[index], index);
                    source.clear();
                    source.push_back(7u);
                    EXPECT_EQ(source[0u], 7u);
                    target.push_back(128u);
                    EXPECT_EQ(target[128u], 128u);
                }
                sourceStats = sourceArena.memoryStats();
                targetStats = targetArena.memoryStats();
            }
            EXPECT_EQ(sourceStats.usedBytes, 0u);
            EXPECT_EQ(sourceStats.reservedBytes, 0u);
            EXPECT_EQ(targetStats.usedBytes, 0u);
            EXPECT_EQ(targetStats.reservedBytes, 0u);
            EXPECT_EQ(sourceStats.allocationCount, sourceStats.deallocationCount);
            EXPECT_EQ(targetStats.allocationCount, targetStats.deallocationCount);
        }
    }
}

