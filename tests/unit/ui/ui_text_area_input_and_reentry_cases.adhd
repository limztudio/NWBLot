void VerifyUiTextAreaLoanTests_LaterSiblingStateScrollABARetiresAnAlreadyPaintedEndedChild(mut UiTextAreaLoanTests self){
    ASSERT_TRUE(self.acceptBaseline());
    const UiTextAreaAcceptedInput16 before = self.accepted();
    UiTextAreaMutationSource source = UiTextAreaMutationSource();
    ListState list = ListState();
    PopupState sibling = PopupState();
    self.m_parent.open();
    self.m_child.open();
    sibling.open();
    ASSERT_TRUE(self.beginParent(2u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiTextAreaChildPopupKey, self.m_child, UiTextAreaLargeLoanChildOptions()));
    ASSERT_TRUE(self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, UiTextAreaLoanOptions()).valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    ASSERT_TRUE(self.m_builder.beginPopup("sibling", sibling, UiTextAreaLargeLoanChildOptions()));
    ASSERT_TRUE(self.m_builder.virtualList("list", source, list, UiTextAreaLargeLoanListOptions()).valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    Point scroll = Point();
    u64 revision = 0u;
    EditNavigationSnapshot navigation = EditNavigationSnapshot();
    source.rowHook = lambda[mut self, mut scroll, mut revision, mut navigation]() -> void{
        scroll = self.m_state.scroll();
        revision = self.m_state.revision();
        navigation = self.m_state.navigation().snapshot();
        const VectorSingle moved = VectorSingle(scroll.x, scroll.y, 0.0f, 0.0f) + VectorSingle(13.0f, 17.0f, 0.0f, 0.0f);
        EXPECT_TRUE(self.m_state.scrollTo(Point(moved.x, moved.y)));
        EXPECT_TRUE(self.m_state.scrollTo(scroll));
    };
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_EQ(source.rowMutations, 1u);
    EXPECT_EQ(self.m_host.publishes, 1u);
    EXPECT_EQ(self.m_state.revision(), revision + 2u);
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, scroll.x);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, scroll.y);
    EXPECT_TRUE(self.m_state.navigation().matches(navigation));
    self.expectRejected(before);
}

void VerifyUiTextAreaLoanTests_FinalMetadataScrollIntentRejectsAfterParentAndChildPaint(mut UiTextAreaLoanTests self){
    ASSERT_TRUE(self.acceptBaseline());
    const UiTextAreaAcceptedInput16 before = self.accepted();
    UiTextAreaMutationSource parentSource = UiTextAreaMutationSource(4301u);
    UiTextAreaMutationSource childSource = UiTextAreaMutationSource(4302u);
    ListState parentList = ListState();
    ListState childList = ListState();
    self.m_parent.open();
    self.m_child.open();
    ASSERT_TRUE(self.beginParent(2u));
    ASSERT_TRUE(self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, UiTextAreaLoanOptions()).valid);
    ASSERT_TRUE(self.m_builder.virtualList("list", parentSource, parentList, UiTextAreaLargeLoanListOptions()).valid);
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiTextAreaChildPopupKey, self.m_child, UiTextAreaLargeLoanChildOptions()));
    ASSERT_TRUE(self.m_builder.virtualList("list", childSource, childList, UiTextAreaLargeLoanListOptions()).valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    usize publicationsAtMutation = 0u;
    u64 revision = 0u;
    childSource.armParentMetadata(parentSource);
    childSource.metadataToArm = lambda[mut self, mut publicationsAtMutation, mut revision]() -> void{
        publicationsAtMutation = self.m_host.publishes;
        revision = self.m_state.revision();
        EXPECT_TRUE(self.m_state.scrollTo(self.m_state.scroll()));
    };
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_EQ(childSource.arms, 1u);
    EXPECT_EQ(parentSource.metadataMutations, 1u);
    EXPECT_GT(childSource.textCalls, 0u);
    EXPECT_EQ(publicationsAtMutation, 1u);
    EXPECT_EQ(self.m_host.publishes, 1u);
    EXPECT_GT(self.m_state.revision(), revision);
    self.expectRejected(before);
}

void VerifyUiTextAreaLoanTests_ReopenedAncestorSuppressesItsOldAreaAndSourceCallbacks(mut UiTextAreaLoanTests self){
    ASSERT_TRUE(self.acceptBaseline());
    UiTextAreaMutationSource source = UiTextAreaMutationSource();
    ListState list = ListState();
    self.m_parent.open();
    self.m_child.open();
    ASSERT_TRUE(self.beginParent(2u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiTextAreaChildPopupKey, self.m_child, UiTextAreaLargeLoanChildOptions()));
    ASSERT_TRUE(self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, UiTextAreaLoanOptions()).valid);
    ASSERT_TRUE(self.m_builder.virtualList("list", source, list, UiTextAreaLargeLoanListOptions()).valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    source.resetAllCounters();
    source.rowHook = lambda[]() -> void{
        EXPECT_TRUE(false);
    };
    const usize loans = self.m_host.loans;
    self.m_parent.close();
    self.m_parent.open();
    ASSERT_TRUE(self.m_model.setText("external\nreplacement"));
    ASSERT_TRUE(self.m_state.scrollTo(Point(13.0f, 17.0f)));
    ASSERT_TRUE(self.m_builder.endPopup());
    ASSERT_TRUE(self.finishRoot());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_host.loans, loans);
    EXPECT_EQ(self.m_host.publishes, 0u);
    EXPECT_EQ(source.metadataCalls, 0u);
    EXPECT_EQ(source.textCalls, 0u);
    EXPECT_EQ(source.rowMutations, 0u);
    EXPECT_EQ(self.m_model.text(), "external\nreplacement");
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 13.0f);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 17.0f);
}

void VerifyUiTextAreaLoanTests_SuccessfulOuterEndReleasesLoansBeforeMutationAndNextFrameReuse(mut UiTextAreaLoanTests self){
    ASSERT_TRUE(self.acceptBaseline());
    self.m_parent.open();
    self.m_child.open();
    ASSERT_TRUE(self.beginParent(2u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiTextAreaChildPopupKey, self.m_child, UiTextAreaLargeLoanChildOptions()));
    ASSERT_TRUE(self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, UiTextAreaLoanOptions()).valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    EXPECT_EQ(self.m_host.publishes, 0u);
    ASSERT_TRUE(self.m_builder.endPopup());
    ASSERT_EQ(self.m_host.publications.size(), 1u);
    EXPECT_EQ(UiTextAreaPublicationText(self.m_host.publications[0u]), "alpha\nbeta");
    const EditBoxPlacement oldPlacement = self.m_host.publications[0u].placement;
    ASSERT_TRUE(self.m_model.setText("external\nreplacement"));
    ASSERT_TRUE(self.m_state.scrollTo(Point(6.0f, 7.0f)));
    const u64 revision = self.m_state.revision();
    EXPECT_EQ(UiTextAreaPublicationText(self.m_host.publications[0u]), "alpha\nbeta");
    ExpectUiRect(self.m_host.publications[0u].placement.bounds, oldPlacement.bounds);
    ASSERT_TRUE(self.finishRoot());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    ASSERT_TRUE(self.beginParent(3u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiTextAreaChildPopupKey, self.m_child, UiTextAreaLargeLoanChildOptions()));
    ASSERT_TRUE(self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, UiTextAreaLoanOptions()).valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    ASSERT_TRUE(self.m_builder.endPopup());
    ASSERT_TRUE(self.finishRoot());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_EQ(self.m_host.loans, 2u);
    EXPECT_EQ(self.m_host.publishes, 2u);
    ASSERT_EQ(self.m_host.publications.size(), 2u);
    EXPECT_EQ(UiTextAreaPublicationText(self.m_host.publications[1u]), "external\nreplacement");
    EXPECT_EQ(UiTextAreaPublicationText(self.m_host.publications[0u]), "alpha\nbeta");
    EXPECT_EQ(self.m_state.revision(), revision);
}


