////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ReflectionSampleBase{
    public u32 x = 0u;
    public u32 y = 0u;
}

// Precompute two Sobol dimensions per frame; scrambling stays in the shader.
ReflectionSampleBase ComputeReflectionSampleBase(in u32 sampleIndex){
    ReflectionSampleBase base;
    u32 remaining = sampleIndex;
    const u32 sampleBitCount = 32u;
    const u32 sampleDirectionHighBit = 0x80000000u;
    u32 direction = sampleDirectionHighBit;
    // x reverses index bits; y uses the Sobol generator (see pbr-book).
    for(u32 bit = 0u; bit < sampleBitCount; ++bit){
        const u32 selected = remaining & 1u;
        base.x = (base.x << 1u) | selected;
        if(selected != 0u)
            base.y ^= direction;
        remaining >>= 1u;
        direction ^= direction >> 1u;
    }
    return base;
}


