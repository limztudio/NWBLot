#include <impl/ecs_ui/toolkit/input/input.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class InputHoverState{
    public void setTarget(in Span<HitTarget> targets, in Span<TargetLookup> lookup, in Span<PopupRecord> popups, in b8 hasHovered, in HitTarget hovered){
        SetRouterHoverTarget(targets, lookup, popups, hasHovered, hovered, this.activityGeneration, this.identity, this.target);
    }

    public void advanceActivity(){
        AdvanceRouterHoverActivity(this.activityGeneration);
    }

    public void clearTarget(){
        ClearRouterHoverTarget(this.target, this.identity);
    }

    public void forgetSource(){
        ForgetRouterHoverSource(this.activityGeneration, this.target, this.identity, this.known, this.source);
    }

    public u64 activityGeneration = 1u;
    public WidgetId target;
    public HoverIdentity identity;
    public Point position;
    public InputSource source;
    public b8 known = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

