Vector<u8> MakeImageTextureBinary(in u8 seed){
    Vector<u8> bytes;
    bytes.reserve(s_TextureHeaderBinaryBytes + 2u * s_TextureMipLevelBinaryBytes + 32u);
    AppendPOD(bytes, s_TextureBinaryMagic);
    AppendPOD(bytes, s_TextureBinaryVersion);
    AppendPOD(bytes, cast<u32>(TexturePayloadDimension::Texture2D));
    AppendPOD(bytes, 2u);
    AppendPOD(bytes, 1u);
    AppendPOD(bytes, 1u);
    AppendPOD(bytes, 2u);
    AppendPOD(bytes, cast<u32>(TextureAlphaMode::EmbeddedLdr) | (255u << s_TextureAlphaInfoConstantShift));
    AppendPOD(bytes, cast<u32>(TexturePayloadFormat::UastcLdr4x4));
    AppendPOD(bytes, cast<u64>(32u));
    for(u32 mip = 0u; mip < 2u; ++mip){
        AppendPOD(bytes, 2u - mip);
        AppendPOD(bytes, 1u);
        AppendPOD(bytes, 1u);
        AppendPOD(bytes, 1u);
        AppendPOD(bytes, 1u);
        AppendPOD(bytes, 0u);
        AppendPOD(bytes, cast<u64>(16u * mip));
        AppendPOD(bytes, cast<u64>(16u));
    }
    for(usize i = 0u; i < 32u; ++i)
        bytes.push_back(cast<u8>(seed + i));
    return bytes;
}

b8 UiGpuValAllImageBindings(in DrawSnapshot snapshot){
    return ValidateGpuGlyphPages(snapshot) && ValidateGpuSdfPages(snapshot) && ValidateGpuTextureImages(snapshot);
}

void UiGpuValSetCommandTextureIndex(mut DrawSnapshot snapshot, in usize commandIndex, in u32 imageIndex){
    DrawSnapshotFaultFixture access;
    access.command(snapshot, commandIndex).textureImageIndex = imageIndex;
}

void UiGpuValResetFirstTexture(mut DrawSnapshot snapshot){
    DrawSnapshotFaultFixture access;
    access.images(snapshot)[0u].reset();
}

void UiGpuValAppendTexture(mut DrawSnapshot snapshot, in SharedImageSource image){
    DrawSnapshotFaultFixture access;
    access.images(snapshot).push_back(image);
}

void UiGpuValSetCommand(mut DrawSnapshot snapshot, in usize index, in DrawCommand command){
    DrawSnapshotFaultFixture access;
    mut DrawCommand destination = access.command(snapshot, index);
    destination = command;
}

void UiGpuValSetFirstCommandUnknownMaterial(mut DrawSnapshot snapshot){
    DrawSnapshotFaultFixture access;
    mut DrawCommand command = access.command(snapshot, 0u);
    command.material = cast<PaintMaterial>(u8.max);
    command.textureImageIndex = u32.max;
}

Expected<DrawSnapshot> UiGpuValBuildMaxBudgetSnapshot(mut PaintImageFixture self, in b8 extraImage){
    Vector<SharedGlyphPage> glyphs;
    for(usize i = 0u; i < s_PaintMaxImages - 2u; ++i){
        const auto result = self.makeGlyph(100u + i);
        if(!result.has_value() || !result.value().valid())
            return MakeUnexpected(Failure());
        glyphs.push_back(result.value());
    }
    const auto sdf = self.makeSdf();
    const auto image = self.makeImage();
    if(!sdf.has_value() || !sdf.value().valid() || !image.has_value() || !image.value().valid())
        return MakeUnexpected(Failure());
    const Array<SharedSdfAtlasPage, 1u> pages(sdf.value());
    const Array<SharedImageSource, 1u> images(image.value());
    if(!self.m_builder.prepareImages(glyphs, pages, images))
        return MakeUnexpected(Failure());
    const Rect rectangle(2.0f, 3.0f, 16.0f, 8.0f);
    const Rect uv(0.0f, 0.0f, 1.0f, 1.0f);
    if(!extraImage && (!self.m_builder.drawGlyph(glyphs[0u], rectangle, uv) || !self.m_builder.drawSdfGlyph(sdf.value(), 2u, rectangle, uv)))
        return MakeUnexpected(Failure());
    if(!self.m_builder.drawImage(image.value(), rectangle))
        return MakeUnexpected(Failure());
    DrawSnapshot snapshot = self.m_builder.freeze();
    if(extraImage){
        const auto addition = self.makeImage("tests/ui/overflow_gpu_image", 73u);
        if(!addition.has_value() || !addition.value().valid())
            return MakeUnexpected(Failure());
        UiGpuValAppendTexture(snapshot, addition.value());
    }
    return snapshot;
}

Expected<SharedImageSource> UiGpuValPrepareSingleGlyphSdfAndImage(mut PaintImageFixture self){
    const auto image = self.makeImage();
    const auto glyph = self.makeGlyph();
    const auto sdf = self.makeSdf();
    if(!image.has_value() || !image.value().valid() || !glyph.has_value() || !glyph.value().valid() || !sdf.has_value() || !sdf.value().valid())
        return MakeUnexpected(Failure());
    const SharedImageSource outImage = image.value();
    const Array<SharedGlyphPage, 1u> glyphs(glyph.value());
    const Array<SharedSdfAtlasPage, 1u> pages(sdf.value());
    const Array<SharedImageSource, 1u> images(outImage);
    if(!self.m_builder.prepareImages(glyphs, pages, images))
        return MakeUnexpected(Failure());
    return outImage;
}

void UiImageLoaderExpectPayload(in SharedImageSource image, in u8 value){
    in Texture texture = image.deref().texture();
    ASSERT_EQ(texture.payloadBytes().size(), 32u);
    for(usize i = 0u; i < texture.payloadBytes().size(); ++i)
        EXPECT_EQ(texture.payloadBytes()[i], cast<u8>(value + i));
}

void UiImageSourceExpectCopy(in Texture original, in SharedImageSource source){
    in Texture copied = source.deref().texture();
    ASSERT_EQ(copied.mipLevels().size(), original.mipLevels().size());
    ASSERT_EQ(copied.payloadBytes().size(), original.payloadBytes().size());
    EXPECT_NE(TestDataAddress(copied.mipLevels()), TestDataAddress(original.mipLevels()));
    EXPECT_NE(TestDataAddress(copied.payloadBytes()), TestDataAddress(original.payloadBytes()));
    EXPECT_EQ(copied.payloadBytes(), original.payloadBytes());
    EXPECT_TRUE(copied.validatePayload());
}

b8 UiSameTextureAddress(in SharedImageSource first, in SharedImageSource second){
    return TestValueAddress<Texture>(first.deref().texture()) == TestValueAddress<Texture>(second.deref().texture());
}

b8 UiDistinctLoadedTextureStorage(in SharedImageSource first, in SharedImageSource second){
    return TestDataAddress(first.deref().texture().payloadBytes()) != TestDataAddress(second.deref().texture().payloadBytes())
        && TestDataAddress(first.deref().texture().mipLevels()) != TestDataAddress(second.deref().texture().mipLevels());
}

UiSkinRegion MakeUiImageLayoutSprite(){
    UiSkinRegion region = UiSkinRegion();
    region.name = s_UiCaseImageTest;
    region.rectangle.x = 10u;
    region.rectangle.y = 20u;
    region.rectangle.width = 200u;
    region.rectangle.height = 100u;
    return region;
}

void ExpectUiImageLayoutMetrics(in ImageMetrics actual, in f32 expectedWidth, in f32 expectedHeight){
    EXPECT_EQ(bit_cast<u32>(actual.contentSize.x), bit_cast<u32>(expectedWidth));
    EXPECT_EQ(bit_cast<u32>(actual.contentSize.y), bit_cast<u32>(expectedHeight));
}

void VerifyGpuTextureImageValidationFixture_SameIdentityDistinctGenerationsRemainValidImageBindings(mut GpuTextureImageValidationFixture self){
    const Expected<SharedImageSource> firstResult = self.makeImage(s_UiGpuVersionedImagePath, 37u);
    ASSERT_TRUE(firstResult.has_value());
    const SharedImageSource first = firstResult.value();
    const Expected<SharedImageSource> secondResult = self.makeImage(s_UiGpuVersionedImagePath, 73u);
    ASSERT_TRUE(secondResult.has_value());
    const SharedImageSource second = secondResult.value();
    ASSERT_TRUE(first.valid() && second.valid());
    ASSERT_EQ(ImageSourceIdentity(first), ImageSourceIdentity(second));
    ASSERT_NE(ImageSourceGeneration(first), ImageSourceGeneration(second));
    const Rect rectangle = Rect(2.0f, 3.0f, 16.0f, 8.0f);
    ASSERT_TRUE(self.m_builder.drawImage(first, rectangle));
    ASSERT_TRUE(self.m_builder.drawImage(second, rectangle));
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.textureImages().size(), 2u);
    ASSERT_EQ(snapshot.commands().size(), 2u);
    EXPECT_TRUE(ValidateGpuGlyphPages(snapshot));
    EXPECT_TRUE(ValidateGpuSdfPages(snapshot));
    EXPECT_TRUE(ValidateGpuTextureImages(snapshot));
}

void VerifyGpuTextureImageValidationFixture_ImageIndexMustAddressAnOwnedTextureSource(mut GpuTextureImageValidationFixture self){
    const Expected<SharedImageSource> imageResult = self.makeImage();
    ASSERT_TRUE(imageResult.has_value());
    const SharedImageSource image = imageResult.value();
    ASSERT_TRUE(image.valid());
    ASSERT_TRUE(self.m_builder.drawImage(image, Rect(2.0f, 3.0f, 16.0f, 8.0f)));
    DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.commands().size(), 1u);
    Array<u32, 2u> invalidIndices = Array<u32, 2u>();
    invalidIndices[0u] = 1u;
    invalidIndices[1u] = u32.max;
    for(in u32 index : invalidIndices){
        UiGpuValSetCommandTextureIndex(snapshot, 0u, index);
        EXPECT_FALSE(ValidateGpuTextureImages(snapshot));
        EXPECT_FALSE(UiGpuValAllImageBindings(snapshot));
    }
    UiGpuValSetCommandTextureIndex(snapshot, 0u, 0u);
    EXPECT_TRUE(UiGpuValAllImageBindings(snapshot));
}

void VerifyGpuTextureImageValidationFixture_NullTextureSourceRejectsTheSnapshot(mut GpuTextureImageValidationFixture self){
    const Expected<SharedImageSource> imageResult = self.makeImage();
    ASSERT_TRUE(imageResult.has_value());
    const SharedImageSource image = imageResult.value();
    ASSERT_TRUE(image.valid());
    ASSERT_TRUE(self.m_builder.drawImage(image, Rect(2.0f, 3.0f, 16.0f, 8.0f)));
    DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.textureImages().size(), 1u);
    UiGpuValResetFirstTexture(snapshot);
    EXPECT_FALSE(ValidateGpuTextureImages(snapshot));
    EXPECT_FALSE(UiGpuValAllImageBindings(snapshot));
}

void VerifyGpuTextureImageValidationFixture_DuplicateSourceGenerationRejectsTheSnapshot(mut GpuTextureImageValidationFixture self){
    const Expected<SharedImageSource> imageResult = self.makeImage();
    ASSERT_TRUE(imageResult.has_value());
    const SharedImageSource image = imageResult.value();
    ASSERT_TRUE(image.valid());
    ASSERT_TRUE(self.m_builder.drawImage(image, Rect(2.0f, 3.0f, 16.0f, 8.0f)));
    DrawSnapshot snapshot = self.m_builder.freeze();
    UiGpuValAppendTexture(snapshot, image);
    ASSERT_EQ(snapshot.textureImages().size(), 2u);
    ASSERT_EQ(ImageSourceGeneration(snapshot.textureImages()[0u]), ImageSourceGeneration(snapshot.textureImages()[1u]));
    EXPECT_FALSE(ValidateGpuTextureImages(snapshot));
    EXPECT_FALSE(UiGpuValAllImageBindings(snapshot));
}

void VerifyGpuTextureImageValidationFixture_TextureBindingCountOverflowRejectsEveryValidator(mut GpuTextureImageValidationFixture self){
    const Expected<SharedImageSource> firstResult = self.makeImage();
    ASSERT_TRUE(firstResult.has_value());
    const SharedImageSource first = firstResult.value();
    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(self.m_builder.drawImage(first, Rect(2.0f, 3.0f, 16.0f, 8.0f)));
    DrawSnapshot snapshot = self.m_builder.freeze();
    for(usize index = 1u; index <= s_PaintMaxImages; ++index){
        const Expected<SharedImageSource> additionResult = self.makeImage(s_UiGpuOverflowImagePath, cast<u8>(index));
        ASSERT_TRUE(additionResult.has_value());
        ASSERT_TRUE(additionResult.value().valid());
        UiGpuValAppendTexture(snapshot, additionResult.value());
    }
    ASSERT_EQ(snapshot.textureImages().size(), s_PaintMaxImages + 1u);
    EXPECT_TRUE(snapshot.glyphPages().empty());
    EXPECT_TRUE(snapshot.sdfPages().empty());
    EXPECT_FALSE(ValidateGpuGlyphPages(snapshot));
    EXPECT_FALSE(ValidateGpuSdfPages(snapshot));
    EXPECT_FALSE(ValidateGpuTextureImages(snapshot));
}

void VerifyGpuTextureImageValidationFixture_SharedImageBudgetAcceptsMixedSourcesAtCapacity(mut GpuTextureImageValidationFixture self){
    const Expected<DrawSnapshot> snapshotResult = UiGpuValBuildMaxBudgetSnapshot(self, false);
    ASSERT_TRUE(snapshotResult.has_value());
    in DrawSnapshot snapshot = snapshotResult.value();
    ASSERT_EQ(snapshot.glyphPages().size() + snapshot.sdfPages().size() + snapshot.textureImages().size(), s_PaintMaxImages);
    EXPECT_TRUE(ValidateGpuGlyphPages(snapshot));
    EXPECT_TRUE(ValidateGpuSdfPages(snapshot));
    EXPECT_TRUE(ValidateGpuTextureImages(snapshot));
}

void VerifyGpuTextureImageValidationFixture_SharedImageBudgetOverflowIncludesEveryImageKind(mut GpuTextureImageValidationFixture self){
    const Expected<DrawSnapshot> snapshotResult = UiGpuValBuildMaxBudgetSnapshot(self, true);
    ASSERT_TRUE(snapshotResult.has_value());
    in DrawSnapshot snapshot = snapshotResult.value();
    ASSERT_EQ(snapshot.glyphPages().size(), s_PaintMaxImages - 2u);
    ASSERT_EQ(snapshot.sdfPages().size(), 1u);
    ASSERT_EQ(snapshot.textureImages().size(), 2u);
    EXPECT_FALSE(ValidateGpuGlyphPages(snapshot));
    EXPECT_FALSE(ValidateGpuSdfPages(snapshot));
    EXPECT_FALSE(ValidateGpuTextureImages(snapshot));
}

void VerifyGpuTextureImageValidationFixture_NonImageCommandsCannotReferenceTextureBindings(mut GpuTextureImageValidationFixture self){
    const Expected<SharedImageSource> imageResult = self.makeImage();
    const Expected<SharedGlyphPage> glyphResult = self.makeGlyph();
    const Expected<SharedSdfAtlasPage> sdfResult = self.makeSdf();
    ASSERT_TRUE(imageResult.has_value());
    ASSERT_TRUE(glyphResult.has_value());
    ASSERT_TRUE(sdfResult.has_value());
    const SharedImageSource image = imageResult.value();
    const SharedGlyphPage glyph = glyphResult.value();
    const SharedSdfAtlasPage sdf = sdfResult.value();
    ASSERT_TRUE(image.valid() && glyph.valid() && sdf.valid());
    const Rect rectangle = Rect(2.0f, 3.0f, 16.0f, 8.0f);
    const Rect uv = Rect(0.0f, 0.0f, 1.0f, 1.0f);
    self.m_builder.fillRect(rectangle);
    ASSERT_TRUE(self.m_builder.drawRegion(s_UiInputNameSprite, rectangle));
    ASSERT_TRUE(self.m_builder.drawGlyph(glyph, rectangle, uv));
    ASSERT_TRUE(self.m_builder.drawSdfGlyph(sdf, 3u, rectangle, uv));
    ASSERT_TRUE(self.m_builder.drawImage(image, rectangle));
    DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.commands().size(), 5u);
    ASSERT_TRUE(UiGpuValAllImageBindings(snapshot));
    usize nonImageCount = 0u;
    for(usize index = 0u; index < snapshot.commands().size(); ++index){
        if(snapshot.commands()[index].material == PaintMaterial::Image)
            continue;
        ++nonImageCount;
        UiGpuValSetCommandTextureIndex(snapshot, index, 0u);
        EXPECT_FALSE(ValidateGpuTextureImages(snapshot));
        EXPECT_FALSE(UiGpuValAllImageBindings(snapshot));
        UiGpuValSetCommandTextureIndex(snapshot, index, u32.max);
    }
    EXPECT_EQ(nonImageCount, 4u);
    EXPECT_TRUE(UiGpuValAllImageBindings(snapshot));
}

void VerifyGpuTextureImageValidationFixture_ImageCommandRejectsGlyphAndSdfMetadata(mut GpuTextureImageValidationFixture self){
    const Expected<SharedImageSource> imageResult = UiGpuValPrepareSingleGlyphSdfAndImage(self);
    ASSERT_TRUE(imageResult.has_value());
    in SharedImageSource image = imageResult.value();
    ASSERT_TRUE(self.m_builder.drawImage(image, Rect(2.0f, 3.0f, 16.0f, 8.0f)));
    DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.commands().size(), 1u);
    const DrawCommand original = snapshot.commands()[0u];
    for(u32 contamination = 0u; contamination < 3u; ++contamination){
        DrawCommand mutated = original;
        if(contamination == 0u)
            mutated.glyphPageIndex = 0u;
        else if(contamination == 1u)
            mutated.sdfPageIndex = 0u;
        else
            mutated.sdfChannel = 1u;
        UiGpuValSetCommand(snapshot, 0u, mutated);
        EXPECT_FALSE(ValidateGpuTextureImages(snapshot));
        EXPECT_FALSE(ValidateGpuGlyphPages(snapshot));
        EXPECT_FALSE(UiGpuValAllImageBindings(snapshot));
    }
    UiGpuValSetCommand(snapshot, 0u, original);
    EXPECT_TRUE(UiGpuValAllImageBindings(snapshot));
}

void VerifyGpuTextureImageValidationFixture_UnknownMaterialRejectsCombinedImageValidation(mut GpuTextureImageValidationFixture self){
    const Expected<SharedImageSource> imageResult = self.makeImage();
    ASSERT_TRUE(imageResult.has_value());
    ASSERT_TRUE(imageResult.value().valid());
    ASSERT_TRUE(self.m_builder.drawImage(imageResult.value(), Rect(2.0f, 3.0f, 16.0f, 8.0f)));
    DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.commands().size(), 1u);
    UiGpuValSetFirstCommandUnknownMaterial(snapshot);
    EXPECT_FALSE(ValidateGpuGlyphPages(snapshot));
    EXPECT_FALSE(UiGpuValAllImageBindings(snapshot));
}

void VerifyHorizontalNavigationFixture_CapabilityRemovalRetiresHorizontalIntentionsWhileVerticalHoldSurvives(mut HorizontalNavigationFixture self){
    ASSERT_TRUE(self.publish());
    self.focusTarget();
    EXPECT_TRUE(self.keyDown(Key::Left).commandConsumed);
    EXPECT_TRUE(self.keyDown(Key::Up).commandConsumed);
    self.press(Key::Right);
    ASSERT_EQ(self.m_router.controlActions().size(), 3u);
    self.m_targets[0u].horizontalNavigation = false;
    ASSERT_TRUE(self.publish());
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    ASSERT_EQ(self.m_router.controlActions().size(), 1u);
    EXPECT_EQ(self.m_router.controlActions()[0u].kind, ControlActionKind::Up);
    EXPECT_TRUE(self.keyDown(Key::Left, true).commandConsumed);
    EXPECT_TRUE(self.keyDown(Key::Up, true).commandConsumed);
    ASSERT_EQ(self.m_router.controlActions().size(), 2u);
    const Expected<ControlAction> actionResult1 = self.take();
    ASSERT_TRUE(actionResult1.has_value());
    EXPECT_EQ(actionResult1.value().kind, ControlActionKind::Up);
    const Expected<ControlAction> actionResult2 = self.take();
    ASSERT_TRUE(actionResult2.has_value());
    EXPECT_EQ(actionResult2.value().kind, ControlActionKind::Up);
    self.m_targets[0u].horizontalNavigation = true;
    ASSERT_TRUE(self.publish());
    EXPECT_TRUE(self.keyDown(Key::Left, true).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.keyDown(Key::Up, true).commandConsumed);
    const Expected<ControlAction> actionResult3 = self.take();
    ASSERT_TRUE(actionResult3.has_value());
    EXPECT_EQ(actionResult3.value().kind, ControlActionKind::Up);
    EXPECT_TRUE(self.keyUp(Key::Left).commandConsumed);
    EXPECT_TRUE(self.keyUp(Key::Up).commandConsumed);
    self.press(Key::Left);
    const Expected<ControlAction> actionResult4 = self.take();
    ASSERT_TRUE(actionResult4.has_value());
    EXPECT_EQ(actionResult4.value().kind, ControlActionKind::Left);
}

