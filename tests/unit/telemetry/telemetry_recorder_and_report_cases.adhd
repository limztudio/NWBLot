MemorySnapshot RecorderReport_MakeCounterSnapshot(in Name scopeName, in u64 counter, in u64 frame){
    MemorySnapshot snapshot = MemorySnapshot();
    snapshot.scopeName = scopeName;
    snapshot.frameIndex = frame;
    snapshot.reservedBytes = counter;
    snapshot.usedBytes = counter;
    snapshot.peakUsedBytes = counter;
    snapshot.allocationCount = counter;
    snapshot.reallocationCount = counter;
    snapshot.deallocationCount = counter;
    return snapshot;
}

MemoryDifferenceCase RecorderReport_MakeDiffCase(in u64 current, in u64 previous, in i64 expected){
    MemoryDifferenceCase item = MemoryDifferenceCase();
    item.current = current;
    item.previous = previous;
    item.expected = expected;
    return item;
}

MemoryDeltaCase RecorderReport_MakeDeltaCase(in i64 first, in i64 second, in i64 expected, in b8 valid){
    MemoryDeltaCase item = MemoryDeltaCase();
    item.first = first;
    item.second = second;
    item.expected = expected;
    item.valid = valid;
    return item;
}

b8 RecorderReport_BuildPerfMemoryPayload(in Name scopeName, in StringView scopeText, in MemorySnapshot snapshot, in MemoryDelta delta, mut TelemetryBytes payload){
    return BuildPerfMemoryPayload(scopeName, scopeText, snapshot, delta, payload);
}

b8 RecorderReport_BuildPerfTimingPayload(in PerfTimingSourceEnum source, in Name scopeName, in StringView scopeText, in TimingStats stats, mut TelemetryBytes payload){
    return BuildPerfTimingPayload(source, scopeName, scopeText, stats, payload);
}

void VerifyTelemetry_PerfMemoryPayloadRejectsInvalidInput(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    const Name scopeName = Name(s_TelemetryMemoryProjectArena);
    MemorySnapshot snapshot = MakeTestMemorySnapshot(scopeName);
    MemoryDelta delta = MakeTestMemoryDelta();

    EXPECT_FALSE(RecorderReport_BuildPerfMemoryPayload(s_NameNone, s_TelemetryProjectArenaText, snapshot, delta, payload));
    EXPECT_FALSE(RecorderReport_BuildPerfMemoryPayload(scopeName, "", snapshot, delta, payload));

    snapshot.scopeName = s_TelemetryCaseMemoryOtherArena;
    EXPECT_FALSE(RecorderReport_BuildPerfMemoryPayload(scopeName, s_TelemetryProjectArenaText, snapshot, delta, payload));

    snapshot = MakeTestMemorySnapshot(scopeName);
    delta.currentFrameIndex = 99u;
    EXPECT_FALSE(RecorderReport_BuildPerfMemoryPayload(scopeName, s_TelemetryProjectArenaText, snapshot, delta, payload));
}

void VerifyTelemetry_MemoryDifferencePreservesSignedLimitsAndLargeUnsignedCounters(){
    const u64 s_MaxSigned = cast<u64>(i64.max);
    const u64 s_MinMagnitude = s_MaxSigned + 1u;
    Array<MemoryDifferenceCase, 10> cases = Array<MemoryDifferenceCase, 10>();
    cases[0u] = RecorderReport_MakeDiffCase(0u, 0u, 0);
    cases[1u] = RecorderReport_MakeDiffCase(s_MaxSigned, 0u, i64.max);
    cases[2u] = RecorderReport_MakeDiffCase(0u, s_MaxSigned, -i64.max);
    cases[3u] = RecorderReport_MakeDiffCase(0u, s_MinMagnitude, i64.min);
    cases[4u] = RecorderReport_MakeDiffCase(s_MinMagnitude - 1u, s_MinMagnitude, -1);
    cases[5u] = RecorderReport_MakeDiffCase(s_MinMagnitude + 5u, s_MinMagnitude - 5u, 10);
    cases[6u] = RecorderReport_MakeDiffCase(s_MinMagnitude - 5u, s_MinMagnitude + 5u, -10);
    cases[7u] = RecorderReport_MakeDiffCase(u64.max, u64.max - 17u, 17);
    cases[8u] = RecorderReport_MakeDiffCase(u64.max - 17u, u64.max, -17);
    cases[9u] = RecorderReport_MakeDiffCase(0u, 128u, -128);

    const Name scopeName = Name(s_TelemetryMemoryProjectArena);
    for(in MemoryDifferenceCase test : cases){
        ScopedTestTrace traceCurrent = ScopedTestTrace(test.current);
        ScopedTestTrace tracePrevious = ScopedTestTrace(test.previous);
        const MemoryDelta delta = Difference(RecorderReport_MakeCounterSnapshot(scopeName, test.current, 2u), RecorderReport_MakeCounterSnapshot(scopeName, test.previous, 1u));
        ASSERT_TRUE(delta.valid());
        EXPECT_EQ(delta.previousFrameIndex, 1u);
        EXPECT_EQ(delta.currentFrameIndex, 2u);
        EXPECT_EQ(delta.reservedBytes, test.expected);
        EXPECT_EQ(delta.usedBytes, test.expected);
        EXPECT_EQ(delta.peakUsedBytes, test.expected);
        EXPECT_EQ(delta.allocationCount, test.expected);
        EXPECT_EQ(delta.reallocationCount, test.expected);
        EXPECT_EQ(delta.deallocationCount, test.expected);
    }
}

void VerifyTelemetry_MemoryDifferenceOmitsUnrepresentableCountersFromTelemetry(){
    TelemetryTestArena testArena = TelemetryTestArena();
    const Name scopeName = Name(s_TelemetryMemoryProjectArena);
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    native(in scopeName, mut payload){
        using CounterField = u64 MemorySnapshot::*;
        constexpr Array<CounterField, 6> s_Fields = {
            &MemorySnapshot::reservedBytes,
            &MemorySnapshot::usedBytes,
            &MemorySnapshot::peakUsedBytes,
            &MemorySnapshot::allocationCount,
            &MemorySnapshot::reallocationCount,
            &MemorySnapshot::deallocationCount,
        };
        constexpr u64 s_MinMagnitude = static_cast<u64>(Limit<i64>::s_Max) + 1u;
        constexpr Array<MemoryUnrepresentableCase, 4> s_Cases = {{
            { .current = s_MinMagnitude, .previous = 0u },
            { .current = 0u, .previous = s_MinMagnitude + 1u },
            { .current = Limit<u64>::s_Max, .previous = 0u },
            { .current = 0u, .previous = Limit<u64>::s_Max },
        }};
        for(const CounterField field : s_Fields){
            for(const MemoryUnrepresentableCase& test : s_Cases){
                ScopedTestTrace traceCurrent(test.current);
                ScopedTestTrace tracePrevious(test.previous);
                MemorySnapshot previous;
                previous.scopeName = scopeName;
                previous.frameIndex = 1u;
                previous.*field = test.previous;
                MemorySnapshot current;
                current.scopeName = scopeName;
                current.frameIndex = 2u;
                current.*field = test.current;
                const auto delta = Difference(current, previous);
                EXPECT_FALSE(delta.valid());
                ASSERT_TRUE(BuildPerfMemoryPayload(scopeName, s_TelemetryProjectArenaText, current, delta, payload));
                const auto parsed = Core::Telemetry::ParsePerfMemoryPayload(payload.data(), payload.size());
                ASSERT_TRUE(parsed.has_value());
                EXPECT_FALSE(parsed.value().delta.valid());
                EXPECT_EQ(parsed.value().snapshot.*field, test.current);
                EXPECT_EQ(parsed.value().snapshot.frameIndex, 2u);
            }
        }
    }
}

void VerifyTelemetry_MemoryReportMarksUnrepresentableTotalsWithoutChangingIndividualRecords(){
    Array<MemoryDeltaCase, 6> cases = Array<MemoryDeltaCase, 6>();
    cases[0u] = RecorderReport_MakeDeltaCase(i64.max, 1, 0, false);
    cases[1u] = RecorderReport_MakeDeltaCase(i64.min, -1, 0, false);
    cases[2u] = RecorderReport_MakeDeltaCase(i64.max - 1, 1, i64.max, true);
    cases[3u] = RecorderReport_MakeDeltaCase(i64.min + 1, -1, i64.min, true);
    cases[4u] = RecorderReport_MakeDeltaCase(i64.max, -i64.max, 0, true);
    cases[5u] = RecorderReport_MakeDeltaCase(i64.min, i64.max, -1, true);

    TelemetryTestArena testArena = TelemetryTestArena();
    const Name scopeName = Name(s_TelemetryMemoryProjectArena);
    for(in MemoryDeltaCase test : cases){
        ScopedTestTrace traceFirst = ScopedTestTrace(test.first);
        ScopedTestTrace traceSecond = ScopedTestTrace(test.second);
        TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
        recorder.setCaptureOptions(CapturePerfOnly());
        MemorySnapshot snapshot = MakeTestMemorySnapshot(scopeName);
        MemoryDelta delta = MakeTestMemoryDelta();
        delta.usedBytes = test.first;
        ASSERT_TRUE(RecordPerfMemory(recorder, scopeName, s_TelemetryProjectArenaText, snapshot, delta));
        ++snapshot.frameIndex;
        ++delta.previousFrameIndex;
        ++delta.currentFrameIndex;
        delta.usedBytes = test.second;
        ASSERT_TRUE(RecordPerfMemory(recorder, scopeName, s_TelemetryProjectArenaText, snapshot, delta));

        native(mut testArena, mut recorder, in scopeName, mut snapshot, mut delta, in test){
            const auto report = BuildTelemetryReport(recorder.view(), testArena.arena, testArena.scratchArena);
            ASSERT_TRUE(report.has_value());
            EXPECT_EQ(report.value().summary.parseFailureCount, 0u);
            EXPECT_EQ(report.value().summary.memoryEventCount, 2u);
            const auto& summary = report.value().summary.memorySources[MemorySource::ExplicitScope];
            EXPECT_EQ(summary.eventCount, 2u);
            EXPECT_EQ(summary.maxUsedBytes, snapshot.usedBytes);
            EXPECT_EQ(summary.totalUsedDeltaValid, test.valid);
            const AStringView json(report.value().json);
            if(test.valid){
                EXPECT_EQ(summary.totalUsedDeltaBytes, test.expected);
                const auto expected = StringFormat(testArena.arena, "\"totalUsedDeltaBytes\": {}", test.expected);
                EXPECT_NE(json.find(AStringView(expected)), AStringView::npos);
                EXPECT_EQ(json.find("\"totalUsedDeltaBytes\": null"), AStringView::npos);
            }
            else{
                EXPECT_NE(json.find("\"totalUsedDeltaBytes\": null"), AStringView::npos);
                ++snapshot.frameIndex;
                ++delta.previousFrameIndex;
                ++delta.currentFrameIndex;
                delta.usedBytes = -test.second;
                ASSERT_TRUE(RecordPerfMemory(recorder, scopeName, s_TelemetryProjectArenaText, snapshot, delta));
                const auto continued = BuildTelemetryReport(recorder.view(), testArena.arena, testArena.scratchArena);
                ASSERT_TRUE(continued.has_value());
                EXPECT_FALSE(continued.value().summary.memorySources[MemorySource::ExplicitScope].totalUsedDeltaValid);
                EXPECT_EQ(continued.value().summary.memoryEventCount, 3u);
            }
            for(const i64 value : { test.first, test.second }){
                const auto expected = StringFormat(testArena.arena, "\"usedBytes\": {}", value);
                EXPECT_NE(json.find(AStringView(expected)), AStringView::npos);
            }

            recorder.clear();
            delta.usedBytes = 0;
            ASSERT_TRUE(RecordPerfMemory(recorder, scopeName, s_TelemetryProjectArenaText, snapshot, delta));
            const auto reset = BuildTelemetryReport(recorder.view(), testArena.arena, testArena.scratchArena);
            ASSERT_TRUE(reset.has_value());
            EXPECT_TRUE(reset.value().summary.memorySources[MemorySource::ExplicitScope].totalUsedDeltaValid);
            EXPECT_EQ(reset.value().summary.memorySources[MemorySource::ExplicitScope].totalUsedDeltaBytes, 0);
        }
    }
}

void VerifyTelemetry_PerfTimingPayloadRejectsNonCurrentVersionsAndCorruptMagicAfterValidParse(){
    TelemetryTestArena testArena = TelemetryTestArena();
    const Name scopeName = Name(s_RendererFrame);
    const TimingStats stats = MakeTestTimingStats();

    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(RecorderReport_BuildPerfTimingPayload(PerfTimingSource::Gpu, scopeName, s_RendererFrameText, stats, payload));
    native(in scopeName, mut payload){
        ASSERT_TRUE(Core::Telemetry::ParsePerfTimingPayload(payload.data(), payload.size()).has_value());
        const TelemetryBytes current = payload;
        const Array<u16, 3> unsupportedVersions = { 0u, static_cast<u16>(Core::Telemetry::s_PerfTimingPayloadVersion + 1u), Limit<u16>::s_Max };
        for(const u16 version : unsupportedVersions){
            ScopedTestTrace trace(version);
            usize cursor = 0u;
            const auto readHeader = ReadPOD<Core::Telemetry::EncodedPerfTimingPayloadHeader>(current, cursor);
            ASSERT_TRUE(readHeader.has_value());
            Core::Telemetry::EncodedPerfTimingPayloadHeader header = readHeader.value();
            header.version = version;
            NWB_MEMCPY(payload.data(), payload.size(), &header, sizeof(header));
            EXPECT_FALSE(Core::Telemetry::ParsePerfTimingPayload(payload.data(), payload.size()).has_value());
            const auto parsed = Core::Telemetry::ParsePerfTimingPayload(current.data(), current.size());
            ASSERT_TRUE(parsed.has_value());
            EXPECT_EQ(parsed.value().scopeName, scopeName);
        }
        payload = current;
        payload[0u] = 0u;
        EXPECT_FALSE(Core::Telemetry::ParsePerfTimingPayload(payload.data(), payload.size()).has_value());
    }
}

void VerifyTelemetry_PerfPayloadBuildersPreserveAliasedScopeText(){
    TelemetryTestArena testArena = TelemetryTestArena();
    const Name scopeName = Name(s_RendererFrame);
    const TimingStats stats = MakeTestTimingStats();
    const MemorySnapshot snapshot = MakeTestMemorySnapshot(scopeName);
    const MemoryDelta delta = MakeTestMemoryDelta();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    native(in scopeName, in stats, in snapshot, in delta, mut payload){
        constexpr AStringView s_Text = "borrowed scope inside output";
        const auto seed = [&](){
            payload.clear();
            payload.reserve(512u);
            payload.resize(s_Text.size());
            NWB_MEMCPY(payload.data(), payload.size(), s_Text.data(), s_Text.size());
            return AStringView(reinterpret_cast<const char*>(payload.data()), payload.size());
        };

        ASSERT_TRUE(BuildPerfTimingPayload(PerfTimingSource::Cpu, scopeName, seed(), stats, payload));
        const auto timing = Core::Telemetry::ParsePerfTimingPayload(payload.data(), payload.size());
        ASSERT_TRUE(timing.has_value());
        EXPECT_EQ(timing.value().scopeText, s_Text);

        ASSERT_TRUE(BuildPerfMemoryPayload(scopeName, seed(), snapshot, delta, payload));
        const auto memory = Core::Telemetry::ParsePerfMemoryPayload(payload.data(), payload.size());
        ASSERT_TRUE(memory.has_value());
        EXPECT_EQ(memory.value().scopeText, s_Text);

        ASSERT_TRUE(BuildPerfTimingPayload(PerfTimingSource::Cpu, scopeName, memory.value().scopeText.substr(9u), stats, payload));
        const auto converted = Core::Telemetry::ParsePerfTimingPayload(payload.data(), payload.size());
        ASSERT_TRUE(converted.has_value());
        EXPECT_EQ(converted.value().scopeText, "scope inside output");
        ASSERT_TRUE(BuildPerfMemoryPayload(scopeName, converted.value().scopeText, snapshot, delta, payload));
        const auto expanded = Core::Telemetry::ParsePerfMemoryPayload(payload.data(), payload.size());
        ASSERT_TRUE(expanded.has_value());
        EXPECT_EQ(expanded.value().scopeText, "scope inside output");
    }
}

void VerifyTelemetry_PerfTimingPayloadRejectsInvalidInput(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    TimingStats stats = MakeTestTimingStats();

    EXPECT_FALSE(RecorderReport_BuildPerfTimingPayload(PerfTimingSource::Unknown, Name(s_RendererFrame), s_RendererFrameText, stats, payload));
    stats.sampleCount = 0u;
    EXPECT_FALSE(RecorderReport_BuildPerfTimingPayload(PerfTimingSource::Cpu, Name(s_RendererFrame), s_RendererFrameText, stats, payload));
}

void VerifyTelemetry_PerfTimingRejectsNonfiniteDurationsAtBuildAndWireAdmission(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    TelemetryBytes current = TelemetryBytes(testArena.arena);
    const Name scopeName = Name(s_RendererFrame);
    const TimingStats validStats = MakeTestTimingStats();
    ASSERT_TRUE(RecorderReport_BuildPerfTimingPayload(PerfTimingSource::Cpu, scopeName, s_RendererFrameText, validStats, current));
    native(in scopeName, in validStats, in current, mut payload){
        using TimingField = f64 TimingStats::*;
        using WireField = f64 Core::Telemetry::EncodedPerfTimingPayloadHeader::*;
        constexpr Array<TimingField, 4u> s_Fields = { &TimingStats::seconds, &TimingStats::minSeconds, &TimingStats::maxSeconds, &TimingStats::lastSeconds };
        constexpr Array<WireField, 4> s_WireFields = {
            &Core::Telemetry::EncodedPerfTimingPayloadHeader::seconds,
            &Core::Telemetry::EncodedPerfTimingPayloadHeader::minSeconds,
            &Core::Telemetry::EncodedPerfTimingPayloadHeader::maxSeconds,
            &Core::Telemetry::EncodedPerfTimingPayloadHeader::lastSeconds,
        };
        constexpr Array<u64, 3> s_NonfiniteBits = { 0x7FF0000000000000uLL, 0xFFF0000000000000uLL, 0x7FF8000000000001uLL };
        for(usize field = 0u; field < s_Fields.size(); ++field){
            for(const u64 bits : s_NonfiniteBits){
                ScopedTestTrace traceField(field);
                ScopedTestTrace traceBits(bits);
                TimingStats invalid = validStats;
                invalid.*s_Fields[field] = BitCast<f64>(bits);
                EXPECT_FALSE(BuildPerfTimingPayload(PerfTimingSource::Cpu, scopeName, s_RendererFrameText, invalid, payload));
                payload = current;
                usize cursor = 0u;
                const auto readHeader = ReadPOD<Core::Telemetry::EncodedPerfTimingPayloadHeader>(current, cursor);
                ASSERT_TRUE(readHeader.has_value());
                auto header = readHeader.value();
                header.*s_WireFields[field] = BitCast<f64>(bits);
                NWB_MEMCPY(payload.data(), payload.size(), &header, sizeof(header));
                EXPECT_FALSE(Core::Telemetry::ParsePerfTimingPayload(payload.data(), payload.size()).has_value());
                const auto recovered = Core::Telemetry::ParsePerfTimingPayload(current.data(), current.size());
                ASSERT_TRUE(recovered.has_value());
                EXPECT_EQ(recovered.value().stats.seconds, validStats.seconds);
            }
        }
    }
}

TimingScopeId RecorderReport_MakeTimingScopeId(in u32 index, in u32 generation){
    TimingScopeId scope = TimingScopeId();
    scope.index = index;
    scope.generation = generation;
    return scope;
}

void VerifyTelemetry_GenericScopeHelpersPreserveBorrowedPointerValuesAndImplicitNameFailures(){
    GenericScopeRecord record = GenericScopeRecord();
    record.name = s_TelemetryCasePerfGenericScope;
    record.generation = 3u;
    const TimingScopeId scope = RecorderReport_MakeTimingScopeId(0u, 3u);
    const TimingScopeId wrongGeneration = RecorderReport_MakeTimingScopeId(0u, 4u);
    const TimingScopeId wrongIndex = RecorderReport_MakeTimingScopeId(1u, 3u);

    usize recordAddress = 0u;
    usize foundAddress = 1u;
    usize wrongGenerationAddress = 1u;
    usize wrongIndexAddress = 1u;
    Name resolvedName = s_NameNone;
    native(mut record, in scope, in wrongGeneration, in wrongIndex, mut recordAddress, mut foundAddress, mut wrongGenerationAddress, mut wrongIndexAddress, mut resolvedName){
        using TelemetryRecorderReportDetail::BorrowedScopePointer;
        using TelemetryRecorderReportDetail::ThrowingScopeRecord;

        recordAddress = reinterpret_cast<usize>(&record);
        const Array<BorrowedScopePointer, 1u> ownerStorage{ BorrowedScopePointer{ &record } };
        const Span<const BorrowedScopePointer> owners(ownerStorage);
        static_assert(IsSame_V<decltype(FindNamedScope<TimingScopeId>(owners, scope)), GenericScopeRecord*>);
        static_assert(noexcept(FindNamedScope<TimingScopeId>(owners, scope)));
        foundAddress = reinterpret_cast<usize>(FindNamedScope<TimingScopeId>(owners, scope));
        wrongGenerationAddress = reinterpret_cast<usize>(FindNamedScope<TimingScopeId>(owners, wrongGeneration));
        wrongIndexAddress = reinterpret_cast<usize>(FindNamedScope<TimingScopeId>(owners, wrongIndex));

        const Array<NotNull<GenericScopeRecord*>, 1u> recordStorage{ MakeNotNull(&record) };
        const Span<const NotNull<GenericScopeRecord*>> records(recordStorage);
        static_assert(noexcept(ScopeNameAt(records, 0u)));
        resolvedName = ScopeNameAt(records, 0u);

        ThrowingScopeRecord throwing{};
        const Array<NotNull<ThrowingScopeRecord*>, 1u> throwingRecordStorage{ MakeNotNull(&throwing) };
        const Span<const NotNull<ThrowingScopeRecord*>> throwingRecords(throwingRecordStorage);
        static_assert(noexcept(Name(throwing.name)));
        static_assert(!noexcept(DeclVal<void(*)(Name)noexcept>()(throwing.name)));
        static_assert(!noexcept(ScopeNameAt(throwingRecords, 0u)));
        EXPECT_THROW({ const Name value = ScopeNameAt(throwingRecords, 0u); EXPECT_EQ(value, s_NameNone); }, u32);
    }

    EXPECT_EQ(foundAddress, recordAddress);
    EXPECT_EQ(wrongGenerationAddress, 0u);
    EXPECT_EQ(wrongIndexAddress, 0u);
    EXPECT_EQ(resolvedName, record.name);
}

void VerifyTelemetry_PerfTimingViewRejectsIndexAtScopeCount(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TimingRecorder cpuTiming = TimingRecorder(testArena.arena);
    cpuTiming.setEnabled(true);
    const Expected<TimingScopeId> scopeResult = cpuTiming.registerScope(s_TelemetryCasePerfCpuUpdate);
    ASSERT_TRUE(scopeResult.has_value());
    const TimingScopeId scope = scopeResult.value();
    cpuTiming.recordSample(scope, 0.010, 100u);
    cpuTiming.publishFrame(101u);
    const TimingView view = TimingView(cpuTiming);

    ASSERT_EQ(view.scopeCount(), 1u);
    EXPECT_FALSE(view.scopeAt(view.scopeCount()).valid());
}

void VerifyTelemetry_RecorderFiltersOwnsCallerPayloadAndRejectsEndIndex(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureFrameGraphOnly());
    native(mut recorder){
        const Array<u8, 2> perfPayload = { 1u, 2u };
        EXPECT_FALSE(recorder.recordBinary(EventKind::PerfFrame, 12u, perfPayload.data(), sizeof(perfPayload)));
        EXPECT_EQ(recorder.eventCount(), 0u);

        Array<u8, 3> frameGraphPayload = { 4u, 5u, 6u };
        EXPECT_TRUE(recorder.recordBinary(EventKind::FrameGraphFrame, 13u, frameGraphPayload.data(), sizeof(frameGraphPayload), 7u));
        frameGraphPayload[0u] = 99u;

        const EventView view = recorder.view();
        EXPECT_EQ(view.eventCount(), 1u);
        const EventRecord* record = view.eventAt(0u);
        ASSERT_NE(record, nullptr);
        EXPECT_EQ(record->payload.size(), 3u);
        EXPECT_EQ(record->payload[0u], 4u);
        EXPECT_EQ(view.eventAt(1u), nullptr);
    }
}

void VerifyTelemetry_EventCodecRejectsInvalidInput(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes encoded = TelemetryBytes(testArena.arena);
    native(mut testArena, mut encoded){
        EventHeader invalidKindHeader;
        invalidKindHeader.kind = EventKind::Unknown;
        invalidKindHeader.payloadBytes = 0u;
        EXPECT_FALSE(Core::Telemetry::EncodeEvent(invalidKindHeader, nullptr, 0u, encoded));

        const u8 payload = 5u;
        EventHeader validHeader;
        validHeader.kind = EventKind::PerfFrame;
        validHeader.payloadBytes = sizeof(payload);
        EXPECT_FALSE(Core::Telemetry::EncodeEvent(validHeader, nullptr, sizeof(payload), encoded));

        validHeader.payloadBytes = 0u;
        EXPECT_TRUE(Core::Telemetry::EncodeEvent(validHeader, nullptr, 0u, encoded));
        encoded[0u] = 0u;

        auto result = Core::Telemetry::DecodeEvent(testArena.arena, encoded.data(), encoded.size());
        ASSERT_FALSE(result.has_value());
        EXPECT_EQ(result.error().status, DecodeStatus::InvalidHeader);

        result = Core::Telemetry::DecodeEvent(testArena.arena, encoded.data(), sizeof(Core::Telemetry::EncodedEventHeader) - 1u);
        ASSERT_FALSE(result.has_value());
        EXPECT_EQ(result.error().status, DecodeStatus::TruncatedHeader);
    }
}

void VerifyTelemetry_EventCodecReportsTruncatedPayload(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes encoded = TelemetryBytes(testArena.arena);
    native(mut testArena, mut encoded){
        const Array<u8, 3> payload = { 1u, 2u, 3u };
        EventHeader header;
        header.kind = EventKind::PerfFrame;
        header.payloadBytes = sizeof(payload);
        EXPECT_TRUE(Core::Telemetry::EncodeEvent(header, payload.data(), sizeof(payload), encoded));

        const auto result = Core::Telemetry::DecodeEvent(testArena.arena, encoded.data(), encoded.size() - 1u);
        ASSERT_FALSE(result.has_value());
        EXPECT_EQ(result.error().status, DecodeStatus::TruncatedPayload);
    }
}

void VerifyTelemetry_EventCodecPreservesAliasedPayloadAcrossCapacityGrowthAndSubranges(){
    TelemetryTestArena testArena = TelemetryTestArena();
    native(mut testArena){
        constexpr Array<u8, 5> s_Expected = { 17u, 29u, 43u, 71u, 113u };
        const Array<usize, 2> prefixes = { 0u, sizeof(Core::Telemetry::EncodedEventHeader) + 3u };
        for(const usize prefix : prefixes){
            for(const b8 spareCapacity : { false, true }){
                ScopedTestTrace tracePrefix(prefix);
                ScopedTestTrace traceCapacity(spareCapacity);
                EventRecord event(testArena.arena);
                event.header.kind = EventKind::PerfFrame;
                event.header.payloadBytes = sizeof(s_Expected);
                event.payload.resize(prefix + sizeof(s_Expected));
                NWB_MEMCPY(event.payload.data() + prefix, sizeof(s_Expected), s_Expected.data(), sizeof(s_Expected));
                if(spareCapacity)
                    event.payload.reserve(event.payload.size() + sizeof(Core::Telemetry::EncodedEventHeader));
                if(prefix == 0u){
                    if(!spareCapacity)
                        ASSERT_LT(event.payload.capacity(), event.payload.size() + sizeof(Core::Telemetry::EncodedEventHeader));
                    ASSERT_TRUE(Core::Telemetry::EncodeEvent(event, event.payload));
                }
                else
                    ASSERT_TRUE(Core::Telemetry::EncodeEvent(event.header, event.payload.data() + prefix, sizeof(s_Expected), event.payload));

                const auto decoded = Core::Telemetry::DecodeEvent(testArena.arena, event.payload.data(), event.payload.size());
                ASSERT_TRUE(decoded.has_value());
                ASSERT_EQ(decoded.value().event.payload.size(), sizeof(s_Expected));
                EXPECT_EQ(NWB_MEMCMP(decoded.value().event.payload.data(), s_Expected.data(), sizeof(s_Expected)), 0);
            }
        }
    }
}

void VerifyTelemetry_EventStreamCodecHandlesEmptyStreams(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    TelemetryBytes encoded = TelemetryBytes(testArena.arena);
    TelemetryRecorder decoded = TelemetryRecorder(testArena.arena);
    native(mut testArena, in recorder, mut encoded, mut decoded){
        EXPECT_TRUE(Core::Telemetry::EncodeEventStream(recorder.view(), encoded));
        EXPECT_EQ(encoded.size(), sizeof(Core::Telemetry::EncodedStreamHeader));

        const auto result = Core::Telemetry::DecodeEventStream(encoded.data(), encoded.size(), testArena.arena, decoded);
        ASSERT_TRUE(result.has_value());
        EXPECT_EQ(result.value(), encoded.size());
    }
    EXPECT_EQ(decoded.eventCount(), 0u);
}

void VerifyTelemetry_EventStreamCanDecodeBytesBorrowedFromDestinationRecorder(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder source = TelemetryRecorder(testArena.arena);
    source.setCaptureOptions(CaptureAll());
    TelemetryBytes encoded = TelemetryBytes(testArena.arena);
    native(mut testArena, mut source, mut encoded){
        const Array<u8, 2u> first = { 7u, 8u };
        const Array<u8, 2u> second = { 9u, 10u };
        ASSERT_TRUE(source.recordBinary(EventKind::PerfFrame, 1u, first.data(), first.size()));
        ASSERT_TRUE(source.recordBinary(EventKind::PerfFrame, 2u, second.data(), second.size()));
        ASSERT_TRUE(Core::Telemetry::EncodeEventStream(source.view(), encoded));

        TelemetryBytes wrapped(testArena.arena);
        wrapped.resize(encoded.size() + 3u);
        NWB_MEMCPY(wrapped.data() + 3u, encoded.size(), encoded.data(), encoded.size());
        for(const b8 captureEnabled : { false, true }){
            ScopedTestTrace trace(captureEnabled);
            TelemetryRecorder destination(testArena.arena);
            if(captureEnabled)
                destination.setCaptureOptions(CaptureAll());
            EventHeader envelope;
            envelope.kind = EventKind::PerfFrame;
            envelope.payloadBytes = wrapped.size();
            ASSERT_TRUE(destination.append(envelope, wrapped.data(), wrapped.size()));
            const EventRecord* borrowed = destination.view().eventAt(0u);
            ASSERT_NE(borrowed, nullptr);
            ASSERT_TRUE(Core::Telemetry::DecodeEventStream(borrowed->payload.data() + 3u, encoded.size(), testArena.arena, destination).has_value());
            ASSERT_EQ(destination.eventCount(), 2u);
            const EventRecord* decoded = destination.view().eventAt(1u);
            ASSERT_NE(decoded, nullptr);
            ASSERT_EQ(decoded->payload.size(), second.size());
            EXPECT_EQ(decoded->payload[0u], second[0u]);
            EXPECT_EQ(decoded->payload[1u], second[1u]);
        }
    }
}

void VerifyTelemetry_EventStreamCodecRejectsInvalidInput(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CapturePerfOnly());
    TelemetryBytes encoded = TelemetryBytes(testArena.arena);
    TelemetryRecorder decoded = TelemetryRecorder(testArena.arena);
    native(mut testArena, mut recorder, mut encoded, mut decoded){
        const Array<u8, 2> payload = { 7u, 8u };
        EXPECT_TRUE(recorder.recordBinary(EventKind::PerfFrame, 1u, payload.data(), sizeof(payload)));
        EXPECT_TRUE(Core::Telemetry::EncodeEventStream(recorder.view(), encoded));

        auto result = Core::Telemetry::DecodeEventStream(encoded.data(), sizeof(Core::Telemetry::EncodedStreamHeader) - 1u, testArena.arena, decoded);
        ASSERT_FALSE(result.has_value());
        EXPECT_EQ(result.error().status, DecodeStatus::TruncatedHeader);

        TelemetryBytes corrupted(testArena.arena);
        corrupted = encoded;
        corrupted[0u] = 0u;
        result = Core::Telemetry::DecodeEventStream(corrupted.data(), corrupted.size(), testArena.arena, decoded);
        ASSERT_FALSE(result.has_value());
        EXPECT_EQ(result.error().status, DecodeStatus::InvalidHeader);

        result = Core::Telemetry::DecodeEventStream(encoded.data(), encoded.size() - 1u, testArena.arena, decoded);
        ASSERT_FALSE(result.has_value());
        EXPECT_EQ(result.error().status, DecodeStatus::TruncatedPayload);

        corrupted = encoded;
        Core::Telemetry::EncodedStreamHeader streamHeader;
        NWB_MEMCPY(&streamHeader, sizeof(streamHeader), corrupted.data(), sizeof(streamHeader));
        streamHeader.eventCount = 0u;
        NWB_MEMCPY(corrupted.data(), corrupted.size(), &streamHeader, sizeof(streamHeader));
        result = Core::Telemetry::DecodeEventStream(corrupted.data(), corrupted.size(), testArena.arena, decoded);
        ASSERT_FALSE(result.has_value());
        EXPECT_EQ(result.error().status, DecodeStatus::InvalidHeader);
    }
}

void VerifyTelemetry_EventCodecRejectsNonCurrentVersionsAndRecovers(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes encoded = TelemetryBytes(testArena.arena);
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    native(mut testArena, mut encoded, mut recorder){
        const Array<u8, 2> payload = { 7u, 8u };
        EventHeader header;
        header.kind = EventKind::PerfFrame;
        header.payloadBytes = sizeof(payload);
        ASSERT_TRUE(Core::Telemetry::EncodeEvent(header, payload.data(), sizeof(payload), encoded));
        const TelemetryBytes current = encoded;

        const Array<u16, 3> unsupportedVersions = { 0u, static_cast<u16>(Core::Telemetry::s_TelemetryFormatVersion + 1u), Limit<u16>::s_Max, };
        for(const u16 version : unsupportedVersions){
            ScopedTestTrace trace(version);
            header.version = version;
            EXPECT_FALSE(Core::Telemetry::EncodeEvent(header, payload.data(), sizeof(payload), encoded));
            EXPECT_EQ(encoded, current);
            EXPECT_FALSE(recorder.append(header, payload.data(), sizeof(payload)));
            EXPECT_EQ(recorder.eventCount(), 0u);

            usize cursor = 0u;
            const auto readEncodedHeader = ReadPOD<Core::Telemetry::EncodedEventHeader>(current, cursor);
            ASSERT_TRUE(readEncodedHeader.has_value());
            Core::Telemetry::EncodedEventHeader encodedHeader = readEncodedHeader.value();
            encodedHeader.version = version;
            NWB_MEMCPY(encoded.data(), encoded.size(), &encodedHeader, sizeof(encodedHeader));
            auto decoded = Core::Telemetry::DecodeEvent(testArena.arena, encoded.data(), encoded.size());
            ASSERT_FALSE(decoded.has_value());
            EXPECT_EQ(decoded.error().status, DecodeStatus::InvalidHeader);
            encoded = current;
            decoded = Core::Telemetry::DecodeEvent(testArena.arena, current.data(), current.size());
            ASSERT_TRUE(decoded.has_value());
            ASSERT_EQ(decoded.value().event.payload.size(), sizeof(payload));
            EXPECT_EQ(decoded.value().event.payload[0u], payload[0u]);
        }
        header.version = Core::Telemetry::s_TelemetryFormatVersion;
        ASSERT_TRUE(recorder.append(header, payload.data(), sizeof(payload)));
    }
    EXPECT_EQ(recorder.eventCount(), 1u);
}

void VerifyTelemetry_EventStreamRejectsNonCurrentStreamAndNestedEventVersionsAndRecovers(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CapturePerfOnly());
    TelemetryBytes encoded = TelemetryBytes(testArena.arena);
    TelemetryRecorder decoded = TelemetryRecorder(testArena.arena);
    native(mut testArena, mut recorder, mut encoded, mut decoded){
        const Array<u8, 2> payload = { 7u, 8u };
        ASSERT_TRUE(recorder.recordBinary(EventKind::PerfFrame, 1u, payload.data(), sizeof(payload)));
        ASSERT_TRUE(Core::Telemetry::EncodeEventStream(recorder.view(), encoded));
        const TelemetryBytes current = encoded;

        const Array<u16, 3> unsupportedVersions = { 0u, static_cast<u16>(Core::Telemetry::s_TelemetryFormatVersion + 1u), Limit<u16>::s_Max, };
        for(const u16 version : unsupportedVersions){
            ScopedTestTrace trace(version);
            usize cursor = 0u;
            const auto readStreamHeader = ReadPOD<Core::Telemetry::EncodedStreamHeader>(current, cursor);
            ASSERT_TRUE(readStreamHeader.has_value());
            Core::Telemetry::EncodedStreamHeader streamHeader = readStreamHeader.value();
            streamHeader.version = version;
            NWB_MEMCPY(encoded.data(), encoded.size(), &streamHeader, sizeof(streamHeader));
            const auto invalidStream = Core::Telemetry::DecodeEventStream(encoded.data(), encoded.size(), testArena.arena, decoded);
            ASSERT_FALSE(invalidStream.has_value());
            EXPECT_EQ(invalidStream.error().status, DecodeStatus::InvalidHeader);
            EXPECT_EQ(decoded.eventCount(), 0u);

            encoded = current;
            const auto readEventHeader = ReadPOD<Core::Telemetry::EncodedEventHeader>(current, cursor);
            ASSERT_TRUE(readEventHeader.has_value());
            Core::Telemetry::EncodedEventHeader eventHeader = readEventHeader.value();
            eventHeader.version = version;
            NWB_MEMCPY(encoded.data() + sizeof(streamHeader), encoded.size() - sizeof(streamHeader), &eventHeader, sizeof(eventHeader));
            const auto invalidEvent = Core::Telemetry::DecodeEventStream(encoded.data(), encoded.size(), testArena.arena, decoded);
            ASSERT_FALSE(invalidEvent.has_value());
            EXPECT_EQ(invalidEvent.error().status, DecodeStatus::InvalidHeader);
            EXPECT_EQ(decoded.eventCount(), 0u);
            encoded = current;
            ASSERT_TRUE(Core::Telemetry::DecodeEventStream(current.data(), current.size(), testArena.arena, decoded).has_value());
            ASSERT_EQ(decoded.eventCount(), 1u);
            const EventRecord* record = decoded.view().eventAt(0u);
            ASSERT_NE(record, nullptr);
            EXPECT_EQ(record->payload.size(), sizeof(payload));
        }
    }
}

void VerifyTelemetry_DiagnosticPayloadRejectsNonCurrentVersionsAndRecovers(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes encoded = TelemetryBytes(testArena.arena);
    native(mut testArena, mut encoded){
        DiagnosticEventRecord record;
        record.event = "assert";
        record.message = "retained diagnostic";
        ASSERT_TRUE(Core::Telemetry::BuildDiagnosticPayload(record, testArena.arena, encoded));
        const TelemetryBytes current = encoded;
        const Array<u16, 3> unsupportedVersions = { 0u, static_cast<u16>(Core::Telemetry::s_DiagnosticPayloadVersion + 1u), Limit<u16>::s_Max, };
        for(const u16 version : unsupportedVersions){
            ScopedTestTrace trace(version);
            ASSERT_TRUE(Core::Telemetry::ParseDiagnosticPayload(current.data(), current.size()).has_value());
            usize cursor = 0u;
            const auto readHeader = ReadPOD<Core::Telemetry::EncodedDiagnosticPayloadHeader>(current, cursor);
            ASSERT_TRUE(readHeader.has_value());
            Core::Telemetry::EncodedDiagnosticPayloadHeader header = readHeader.value();
            header.version = version;
            NWB_MEMCPY(encoded.data(), encoded.size(), &header, sizeof(header));
            EXPECT_FALSE(Core::Telemetry::ParseDiagnosticPayload(encoded.data(), encoded.size()).has_value());
            const auto parsed = Core::Telemetry::ParseDiagnosticPayload(current.data(), current.size());
            ASSERT_TRUE(parsed.has_value());
            EXPECT_EQ(AStringView(parsed.value().message), record.message);
        }
    }
}

void VerifyTelemetry_RecorderAcceptsConcurrentRecords(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());

    const u32 s_ThreadCount = 4u;
    const u32 s_EventsPerThread = 64u;
    native(mut recorder){
        constexpr u32 kThreads = 4u;
        constexpr u32 kEventsPerThread = 64u;
        Array<Thread, kThreads> threads;
        for(u32 threadIndex = 0u; threadIndex < kThreads; ++threadIndex){
            threads[threadIndex] = Thread([&recorder, threadIndex](){
                for(u32 eventIndex = 0u; eventIndex < kEventsPerThread; ++eventIndex){
                    if(!RecordTextLog(recorder, LogType::Info, NWB_TEXT("concurrent telemetry record"), eventIndex, threadIndex))
                        return;
                }
            });
        }
        for(Thread& thread : threads)
            thread.join();
    }

    EXPECT_EQ(recorder.eventCount(), s_ThreadCount * s_EventsPerThread);
}

void VerifyTelemetry_RecorderDisableReleasesClearedAndEmptyPayloadStorage(){
    TelemetryTestArena testArena = TelemetryTestArena();
    const ArenaMemoryStats initial = testArena.arena.memoryStats();
    {
        TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
        recorder.setCaptureOptions(CapturePerfOnly());
        ASSERT_TRUE(RecordFilledPayload(recorder, 256u, 11u));
        recorder.clear();
        const ArenaMemoryStats warmed = testArena.arena.memoryStats();

        ASSERT_TRUE(RecordFilledPayload(recorder, 0u, 0u));
        native(in recorder){
            EXPECT_TRUE(recorder.view().eventAt(0u)->payload.empty());
        }
        recorder.clear();
        recorder.setCaptureOptions(CaptureDisabled());
        EXPECT_LT(testArena.arena.memoryStats().usedBytes, warmed.usedBytes);
    }
    const ArenaMemoryStats after = testArena.arena.memoryStats();
    EXPECT_EQ(after.usedBytes, initial.usedBytes);
    EXPECT_EQ(after.reservedBytes, initial.reservedBytes);
}

void VerifyTelemetry_RecorderBuilderCanClearAndReenterWhileItsPayloadIsLeased(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CapturePerfOnly());
    ASSERT_TRUE(RecordFilledPayload(recorder, 256u, 3u));
    native(in testArena, mut recorder){
        ASSERT_TRUE(recorder.recordBuiltPayload(EventKind::PerfFrame, 2u, 7u, [&](Core::Telemetry::TelemetryArena& arena, TelemetryBytes& payload){
            EXPECT_EQ(&arena, &testArena.arena);
            EXPECT_TRUE(payload.empty());
            payload.resize(128u, 42u);
            const u8* const leasedData = payload.data();
            recorder.clear();
            EXPECT_TRUE(recorder.captureOptions().perfEnabled());
            EXPECT_EQ(recorder.eventCount(), 0u);
            const b8 nested = recorder.recordBinary(EventKind::PerfFrame, 1u, payload.data(), payload.size(), 5u);
            EXPECT_TRUE(nested);
            EXPECT_EQ(payload.data(), leasedData);
            for(const u8 value : payload)
                EXPECT_EQ(value, 42u);
            return nested;
        }));
        ASSERT_EQ(recorder.eventCount(), 2u);
        const auto* nested = recorder.view().eventAt(0u);
        const auto* outer = recorder.view().eventAt(1u);
        ASSERT_NE(nested, nullptr);
        ASSERT_NE(outer, nullptr);
        EXPECT_EQ(nested->header.streamId, 5u);
        EXPECT_EQ(outer->header.streamId, 7u);
        EXPECT_NE(nested->payload.data(), outer->payload.data());
        ASSERT_EQ(nested->payload.size(), 128u);
        ASSERT_EQ(outer->payload.size(), 128u);
        EXPECT_EQ(NWB_MEMCMP(nested->payload.data(), outer->payload.data(), 128u), 0);
    }
}

void VerifyTelemetry_RecorderDisableDuringBuildRejectsPublicationAndReleasesLease(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CapturePerfOnly());
    const ArenaMemoryStats before = testArena.arena.memoryStats();
    native(mut recorder){
        EXPECT_FALSE(recorder.recordBuiltPayload(EventKind::PerfFrame, 1u, 0u, [&](Core::Telemetry::TelemetryArena&, TelemetryBytes& payload){
            payload.resize(256u, 19u);
            recorder.setCaptureOptions(CaptureDisabled());
            EXPECT_EQ(payload.front(), 19u);
            payload.back() = 37u;
            EXPECT_EQ(payload.back(), 37u);
            return true;
        }));
    }
    EXPECT_EQ(recorder.eventCount(), 0u);
    const ArenaMemoryStats disabled = testArena.arena.memoryStats();
    EXPECT_EQ(disabled.usedBytes, before.usedBytes);
    b8 builderCalled = false;
    native(mut recorder, mut builderCalled){
        EXPECT_FALSE(recorder.recordBuiltPayload(EventKind::PerfFrame, 2u, 0u, [&](Core::Telemetry::TelemetryArena&, TelemetryBytes&)noexcept{
            builderCalled = true;
            return true;
        }));
    }
    EXPECT_FALSE(builderCalled);
    EXPECT_EQ(testArena.arena.memoryStats().allocationCount, disabled.allocationCount);
    recorder.setCaptureOptions(CapturePerfOnly());
    native(mut recorder){
        EXPECT_TRUE(RecordFilledPayload(recorder, 64u, 23u));
    }
}

void VerifyTelemetry_RecorderPublicationUsesCaptureOptionsAtBuilderCompletion(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CapturePerfOnly());
    native(mut recorder){
        ASSERT_TRUE(recorder.recordBuiltPayload(EventKind::PerfFrame, 1u, 0u, [&](Core::Telemetry::TelemetryArena&, TelemetryBytes& payload){
            payload.resize(64u, 71u);
            recorder.setCaptureOptions(CaptureDisabled());
            recorder.setCaptureOptions(CapturePerfOnly());
            return true;
        }));
        ASSERT_EQ(recorder.eventCount(), 1u);
        EXPECT_EQ(recorder.view().eventAt(0u)->payload.back(), 71u);
        EXPECT_FALSE(recorder.recordBuiltPayload(EventKind::PerfFrame, 2u, 0u, [&](Core::Telemetry::TelemetryArena&, TelemetryBytes& payload){
            payload.resize(64u, 29u);
            recorder.setCaptureOptions(CaptureFrameGraphOnly());
            return true;
        }));
    }
    EXPECT_EQ(recorder.eventCount(), 1u);
}

void VerifyTelemetry_RecorderFailedAndThrowingBuildersRecycleWithoutAllocations(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CapturePerfOnly());
    ASSERT_TRUE(RecordFilledPayload(recorder, 256u, 13u));
    recorder.clear();
    const ArenaMemoryStats warmed = testArena.arena.memoryStats();
    native(mut recorder){
        using TelemetryRecorderReportDetail::PayloadBuildFailure;
        EXPECT_FALSE(recorder.recordBuiltPayload(EventKind::PerfFrame, 1u, 0u, [](Core::Telemetry::TelemetryArena&, TelemetryBytes& payload){
            payload.resize(128u, 31u);
            return false;
        }));
        EXPECT_THROW(EXPECT_TRUE(recorder.recordBuiltPayload(EventKind::PerfFrame, 2u, 0u, [](Core::Telemetry::TelemetryArena&, TelemetryBytes& payload)->b8{
            payload.resize(128u, 47u);
            throw PayloadBuildFailure{};
        })), PayloadBuildFailure);
    }
    EXPECT_EQ(recorder.eventCount(), 0u);
    ASSERT_TRUE(RecordFilledPayload(recorder, 64u, 59u));
    recorder.clear();
    const ArenaMemoryStats after = testArena.arena.memoryStats();
    EXPECT_EQ(after.allocationCount, warmed.allocationCount);
    EXPECT_EQ(after.reallocationCount, warmed.reallocationCount);
    EXPECT_EQ(after.deallocationCount, warmed.deallocationCount);
    EXPECT_EQ(after.usedBytes, warmed.usedBytes);
}

void VerifyTelemetry_RecorderActiveEventAliasesRemainStableAcrossStorageGrowth(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CapturePerfOnly());
    native(mut testArena, mut recorder){
        const Array<u8, 4> bytes = { 3u, 7u, 11u, 19u };
        ASSERT_TRUE(recorder.recordBinary(EventKind::PerfFrame, 5u, bytes.data(), sizeof(bytes)));
        const auto* source = recorder.view().eventAt(0u);
        ASSERT_NE(source, nullptr);
        const u8* const sourceData = source->payload.data();
        for(u32 index = 0u; index < 128u; ++index){
            ASSERT_TRUE(recorder.append(source->header, source->payload.data(), source->payload.size()));
            ASSERT_TRUE(recorder.recordBinary(EventKind::PerfFrame, index, sourceData, sizeof(bytes)));
            TelemetryBytes ownedPayload(testArena.arena);
            ownedPayload.assign(source->payload.begin(), source->payload.end());
            const u8* const movedData = ownedPayload.data();
            ASSERT_TRUE(recorder.append(source->header, Move(ownedPayload)));
            EXPECT_EQ(recorder.view().eventAt(recorder.eventCount() - 1u)->payload.data(), movedData);
            EXPECT_TRUE(ownedPayload.empty());
            EXPECT_EQ(recorder.view().eventAt(0u), source);
            EXPECT_EQ(source->payload.data(), sourceData);
        }
        ASSERT_EQ(recorder.eventCount(), 385u);
        for(usize index = 0u; index < recorder.eventCount(); ++index){
            const auto* event = recorder.view().eventAt(index);
            ASSERT_NE(event, nullptr);
            ASSERT_EQ(event->payload.size(), sizeof(bytes));
            EXPECT_EQ(NWB_MEMCMP(event->payload.data(), bytes.data(), sizeof(bytes)), 0);
        }
    }
}

void VerifyTelemetry_RecorderReusedSlotsKeepForeignPayloadsIndependentAndMoveOwnedPayloads(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CapturePerfOnly());
    ASSERT_TRUE(RecordFilledPayload(recorder, 256u, 17u));
    recorder.clear();
    native(mut testArena, mut recorder){
        {
            TelemetryTestArena foreignArena;
            TelemetryBytes foreignPayload(foreignArena.arena);
            foreignPayload.resize(64u, 41u);
            const u8* const sourceData = foreignPayload.data();
            ASSERT_TRUE(recorder.recordPayload(EventKind::PerfFrame, 1u, Move(foreignPayload)));
            const auto* event = recorder.view().eventAt(0u);
            ASSERT_NE(event, nullptr);
            EXPECT_NE(event->payload.data(), sourceData);
            EXPECT_EQ(foreignPayload.data(), sourceData);
            ASSERT_EQ(foreignPayload.size(), 64u);
            foreignPayload.front() = 99u;
            EXPECT_EQ(event->payload.front(), 41u);
        }
        EXPECT_EQ(recorder.view().eventAt(0u)->payload.back(), 41u);
        recorder.clear();
        TelemetryBytes ownedPayload(testArena.arena);
        ownedPayload.resize(128u, 67u);
        const u8* const ownedData = ownedPayload.data();
        ASSERT_TRUE(recorder.recordPayload(EventKind::PerfFrame, 2u, Move(ownedPayload)));
        EXPECT_EQ(recorder.view().eventAt(0u)->payload.data(), ownedData);
        EXPECT_TRUE(ownedPayload.empty());
        recorder.clear();
        ASSERT_TRUE(recorder.recordBinary(EventKind::PerfFrame, 3u, nullptr, 0u));
        EXPECT_TRUE(recorder.view().eventAt(0u)->payload.empty());
    }
}

void VerifyTelemetry_RecorderRejectsInvalidInputsWithoutConsumingPayloadsOrReusedSlots(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    ASSERT_TRUE(RecordFilledPayload(recorder, 256u, 5u));
    recorder.clear();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    payload.resize(64u, 17u);
    const ArenaMemoryStats before = testArena.arena.memoryStats();
    native(mut recorder, mut payload, in before, in testArena){
        const u8* const payloadData = payload.data();
        const Array<EventKind::Enum, 2> invalidKinds = { EventKind::Unknown, static_cast<EventKind::Enum>(0xffffu), };
        b8 builderCalled = false;
        for(const auto kind : invalidKinds){
            EXPECT_FALSE(recorder.recordBuiltPayload(kind, 1u, 0u, [&](Core::Telemetry::TelemetryArena&, TelemetryBytes&)noexcept{ builderCalled = true; return true; }));
            EventHeader header;
            header.kind = kind;
            header.payloadBytes = payload.size();
            EXPECT_FALSE(recorder.append(header, Move(payload)));
            EXPECT_FALSE(recorder.append(header, payload.data(), payload.size()));
        }
        EventHeader header;
        header.kind = EventKind::PerfFrame;
        header.payloadBytes = payload.size();
        header.magic = 0u;
        EXPECT_FALSE(recorder.append(header, Move(payload)));
        header.magic = Core::Telemetry::s_EventMagic;
        EXPECT_FALSE(recorder.append(header, nullptr, payload.size()));
        ++header.payloadBytes;
        EXPECT_FALSE(recorder.append(header, Move(payload)));
        EXPECT_FALSE(builderCalled);
        EXPECT_EQ(recorder.eventCount(), 0u);
        EXPECT_EQ(payload.data(), payloadData);
        EXPECT_EQ(payload.size(), 64u);
        EXPECT_EQ(testArena.arena.memoryStats().allocationCount, before.allocationCount);
        ASSERT_TRUE(RecordFilledPayload(recorder, 64u, 23u));
        EXPECT_EQ(testArena.arena.memoryStats().allocationCount, before.allocationCount);
    }
}

void VerifyTelemetry_RecorderBuilderForeignMovesKeepOwnershipWithinEachArena(){
    TelemetryTestArena testArena = TelemetryTestArena();
    const ArenaMemoryStats initial = testArena.arena.memoryStats();
    native(mut testArena){
        TelemetryRecorder recorder(testArena.arena);
        recorder.setCaptureOptions(CapturePerfOnly());
        ASSERT_TRUE(RecordFilledPayload(recorder, 256u, 7u));
        recorder.clear();
        {
            TelemetryTestArena foreignArena;
            const ArenaMemoryStats foreignInitial = foreignArena.arena.memoryStats();
            {
                TelemetryBytes foreignPayload(foreignArena.arena);
                foreignPayload.resize(64u, 83u);
                ASSERT_TRUE(recorder.recordBuiltPayload(EventKind::PerfFrame, 3u, 0u, [&](Core::Telemetry::TelemetryArena&, TelemetryBytes& payload)noexcept{
                    payload = Move(foreignPayload);
                    return true;
                }));
            }
            EXPECT_EQ(foreignArena.arena.memoryStats().usedBytes, foreignInitial.usedBytes);
        }
        ASSERT_EQ(recorder.eventCount(), 1u);
        const auto* event = recorder.view().eventAt(0u);
        ASSERT_NE(event, nullptr);
        EXPECT_EQ(event->payload.get_allocator().arenaPtr(), &testArena.arena);
        ASSERT_EQ(event->payload.size(), 64u);
        EXPECT_EQ(event->payload.front(), 83u);
        EXPECT_EQ(event->payload.back(), 83u);
        recorder.clear();
        ASSERT_TRUE(RecordFilledPayload(recorder, 64u, 29u));
    }
    EXPECT_EQ(testArena.arena.memoryStats().usedBytes, initial.usedBytes);
}

void VerifyTelemetry_RecorderExplicitForeignBuilderStorageIsCopiedOrReleasedOnEveryExit(){
    TelemetryTestArena testArena = TelemetryTestArena();
    const ArenaMemoryStats initial = testArena.arena.memoryStats();
    native(mut testArena){
        using Payload = TelemetryBytes;
        using TelemetryRecorderReportDetail::PayloadBuildFailure;
        TelemetryRecorder recorder(testArena.arena);
        recorder.setCaptureOptions(CapturePerfOnly());
        for(u32 outcome = 0u; outcome < 4u; ++outcome){
            recorder.setCaptureOptions(CapturePerfOnly());
            recorder.clear();
            {
                TelemetryTestArena foreignArena;
                const ArenaMemoryStats foreignInitial = foreignArena.arena.memoryStats();
                {
                    Payload foreignPayload(foreignArena.arena);
                    foreignPayload.resize(64u, 37u);
                    const auto buildPayload = [&](Core::Telemetry::TelemetryArena&, Payload& payload)->b8{
                        // Explicit move construction replaces allocator identity, independently of assignment policy.
                        payload.~Payload();
                        new(&payload) Payload(Move(foreignPayload));
                        EXPECT_EQ(payload.get_allocator().arenaPtr(), &foreignArena.arena);
                        if(outcome == 2u)
                            throw PayloadBuildFailure{};
                        if(outcome == 3u)
                            recorder.setCaptureOptions(CaptureDisabled());
                        return outcome != 1u;
                    };
                    if(outcome == 2u)
                        EXPECT_THROW(EXPECT_TRUE(recorder.recordBuiltPayload(EventKind::PerfFrame, 1u, 0u, buildPayload)), PayloadBuildFailure);
                    else
                        EXPECT_EQ(recorder.recordBuiltPayload(EventKind::PerfFrame, 1u, 0u, buildPayload), outcome == 0u);
                }
                EXPECT_EQ(foreignArena.arena.memoryStats().usedBytes, foreignInitial.usedBytes);
            }
            ASSERT_EQ(recorder.eventCount(), outcome == 0u ? 1u : 0u);
            if(outcome == 0u){
                const auto* event = recorder.view().eventAt(0u);
                ASSERT_NE(event, nullptr);
                EXPECT_EQ(event->payload.get_allocator().arenaPtr(), &testArena.arena);
                ASSERT_EQ(event->payload.size(), 64u);
                EXPECT_EQ(event->payload.front(), 37u);
                EXPECT_EQ(event->payload.back(), 37u);
            }
        }
        recorder.setCaptureOptions(CapturePerfOnly());
        ASSERT_TRUE(RecordFilledPayload(recorder, 64u, 59u));
    }
    EXPECT_EQ(testArena.arena.memoryStats().usedBytes, initial.usedBytes);
}

