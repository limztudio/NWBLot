[cpp_header("<core/task/cpu/profiling.h>"), cpp_name("::NWB::Core::CpuTaskProfileKind::Enum")]
extern enum CpuTaskProfileKind : u8{
    QueueDelay,
    Execution,
    HandleJoin,
    ScopeJoin,
    SchedulerJoin,
    WorkerIdle
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<core/task/cpu/profiling.h>"), cpp_name("::NWB::Core::CpuTaskProfileEvent")]
extern class CpuTaskProfileEvent{
    CpuTaskHandle task;
    Name label;
    u64 durationNanoseconds;
    u64 frameIndex;
    u64 captureEpoch;
    usize workerIndex;
    CpuTaskProfileKind kind;
    CpuAffinity affinity;
};


