void VerifyUiWindowTests_MissingResizeFallbackRejectsAdmissionBeforeChangingHostState(mut UiWindowTests self){
    WindowState state = WindowState();
    state.bounds = Rect(5.0f, 6.0f, 7.0f, 8.0f);
    self.configureSkin("white");
    ASSERT_TRUE(self.begin(1u));
    EXPECT_FALSE(self.m_builder.beginWindow("window", "Skin", state));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(state.initialized);
    EXPECT_FLOAT_EQ(state.bounds.x, 5.0f);
    EXPECT_FLOAT_EQ(state.bounds.y, 6.0f);
    EXPECT_FLOAT_EQ(state.bounds.width, 7.0f);
    EXPECT_FLOAT_EQ(state.bounds.height, 8.0f);
    EXPECT_FALSE(self.m_context.finishFrame());
}

void VerifyUiWindowTests_MissingRequiredSkinKeepsPreviousAcceptedTargets(mut UiWindowTests self){
    WindowState state = WindowState();
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginWindow("window", "Skin", state));
    ASSERT_TRUE(self.finishWindow());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    self.configureSkin("window.title");
    ASSERT_TRUE(self.begin(2u));
    EXPECT_FALSE(self.m_builder.beginWindow("window", "Skin", state));
    EXPECT_TRUE(state.initialized);
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    EXPECT_TRUE(self.hasTarget(self.id("@window.title")));
}

void VerifyUiWindowTests_InvalidOptionsAndWrongEndRejectCandidatePublication(mut UiWindowTests self){
    WindowState state = WindowState();
    WindowOptions options = WindowOptions();
    options.minimumSize.x = bit_cast<f32>(s_UiWheelWindowQuietNaNF32Bits);
    ASSERT_TRUE(self.begin(1u));
    EXPECT_FALSE(self.m_builder.beginWindow("window", "Invalid", state, options));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
    self.m_context.abandonFrame();
    self.m_builder.reset();
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginWindow("window", "Invalid", state));
    EXPECT_TRUE(state.initialized);
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
}


