native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "project.adhd.h"

Expected<UniquePtr<Testbed::World>> Testbed::CreateInitialProjectWorld(ProjectRuntimeContext& context){
    static constexpr TStringView s_WorldAllocFailed = NWB_TEXT("CreateInitialProjectWorld failed: ECS world allocation failed");
    static constexpr TStringView s_ResolverNull = NWB_TEXT("CreateInitialProjectWorld failed: shader path resolver callback is null");

    UniquePtr<World> world = MakeUnique<World>(context.objectArena, context.cpuTasks);
    if(!world){
        NWB_LOGGER_FATAL(s_WorldAllocFailed);
        return MakeUnexpected(Failure());
    }
    if(!context.shaderPathResolver){
        NWB_LOGGER_FATAL(s_ResolverNull);
        return MakeUnexpected(Failure());
    }

    auto& meshSystem = world->addSystem<MeshSystem>(*world);
    auto& rendererSystem = world->addSystem<RendererSystem>(*world, context.graphics, context.assetManager, context.shaderPathResolver);
    world->addSystem<ModelSystem>(*world, context.assetManager, NWB::Impl::CreateModelObjectRendererHooks());
    auto& meshSkinningSystem = world->addSystem<MeshSkinningSystem>(*world, context.graphics, context.assetManager, meshSystem, context.shaderPathResolver);
    auto& uiLayerSystem = world->addSystem<UiLayerSystem>(
        *world,
        context.graphics,
        context.input,
        context.clipboard,
        context.textInput,
        context.assetManager,
        context.shaderPathResolver,
        NWB::Core::Assets::AssetRef<UiSkin>{},
        UiLayerPresentation::Scene
    );
    context.graphics.addRenderPassToBack(meshSkinningSystem);
    context.graphics.addRenderPassToBack(rendererSystem);
    context.graphics.addRenderPassToBack(uiLayerSystem);
    context.frameGraphRegistry.registerContributor(rendererSystem);
    return world;
}

NotNullUniquePtr<Testbed::World> Testbed::CreateInitialWorldOrDie(ProjectRuntimeContext& context){
    auto world = CreateInitialProjectWorld(context);
    if(!world){
        NWB_LOGGER_FATAL(NWB_TEXT("ProjectTestbed initialization failed: CreateInitialProjectWorld returned false"));
        throw RuntimeException(s_InitWorldFailedNarrow.data());
    }
    return MakeNotNullUnique(Move(*world));
}

void Testbed::DestroyInitialProjectWorld(ProjectRuntimeContext& context, NotNullUniquePtr<World>& worldHandle){
    UniquePtr<World>& world = worldHandle.owner();
    if(!world)
        return;

    MeshSkinningSystem& meshSkinningSystem = *MakeNotNull(world->getSystem<MeshSkinningSystem>());
    RendererSystem& rendererSystem = *MakeNotNull(world->getSystem<RendererSystem>());
    UiLayerSystem& uiLayerSystem = *MakeNotNull(world->getSystem<UiLayerSystem>());

    context.frameGraphRegistry.unregisterContributor(rendererSystem);
    context.graphics.removeRenderPass(meshSkinningSystem);
    context.graphics.removeRenderPass(rendererSystem);
    context.graphics.removeRenderPass(uiLayerSystem);

    const b8 deviceIdle = context.graphics.waitForIdle();
    NWB_FATAL_ASSERT_MSG(deviceIdle || context.graphics.isDeviceLost(), NWB_TEXT("Project-world destruction requires either a completed device join or terminal device loss"));

    world->clear();
    world.reset();
}

void Testbed::BindActiveSceneSubsystemsToWorld(NotNullUniquePtr<World>& world, const ActiveSceneSubsystems& sceneSubsystems){
    if(auto* const rendererSystem = world->getSystem<RendererSystem>())
        rendererSystem->setActiveSceneSubsystems(&sceneSubsystems);
    if(auto* const meshSkinningSystem = world->getSystem<MeshSkinningSystem>())
        meshSkinningSystem->setActiveSceneSubsystems(&sceneSubsystems);
    if(auto* const uiLayerSystem = world->getSystem<UiLayerSystem>())
        uiLayerSystem->setActiveSceneSubsystems(&sceneSubsystems);
}

b8 Testbed::CreateStartupCameraAndLights(NotNullUniquePtr<World>& world){
    return CreateStartupCameraAndLightsOnWorld(*world);
}

void Testbed::SyncWorldModelRuntimes(NotNullUniquePtr<World>& world){
    ModelSystem& modelSystem = *MakeNotNull(world->getSystem<ModelSystem>());
    modelSystem.syncModelRuntimes();
}

b8 Testbed::TickProjectWorld(NotNullUniquePtr<World>& world, const f32 safeDelta){
    const Expected<void, CpuTaskAdmissionErrorCode> updated = world->tick(safeDelta);
    if(!updated.has_value()){
        LogProjectWorldTickRejected(static_cast<u32>(updated.error()));
        return false;
    }
    return true;
}

b8 Testbed::WantsUiKeyboard(const NotNullUniquePtr<World>& world){
    return MakeNotNull(world->getSystem<UiLayerSystem>())->wantsKeyboard();
}

b8 Testbed::WantsUiPointer(const NotNullUniquePtr<World>& world){
    return MakeNotNull(world->getSystem<UiLayerSystem>())->wantsPointer();
}

void Testbed::ApplyFlyCameraInputToMainCamera(
    NotNullUniquePtr<World>& world,
    const SIMDVectorSingle moveAxes,
    const b8 boosted,
    const SIMDVectorSingle mouseDelta,
    const f32 deltaSeconds
){
    ApplyFlyCameraInputToWorld(*world, moveAxes, boosted, mouseDelta, deltaSeconds);
}

b8 Testbed::InstantiateSceneSubsystemsEntities(const ActiveSceneSubsystems& sceneSubsystems, NotNullUniquePtr<World>& world){
    return sceneSubsystems.instantiateEntities(*world);
}

Testbed::AssetRef<Testbed::Texture> Testbed::ResolveUiGallerySkinTextureRef(const AssetManager& assets, const ActiveSceneSubsystems& sceneSubsystems){
    const UiSubsystem* const uiSubsystem = sceneSubsystems.findSubsystem<UiSubsystem>();
    if(uiSubsystem && uiSubsystem->basicSkin.valid()){
        auto skin = assets.loadTypedSync<UiSkin>(uiSubsystem->basicSkin.name(), NWB_TEXT("UiImageGallery"));
        if(skin)
            return (*skin)->texture();
    }
    return AssetRef<Texture>{};
}

StringView Testbed::FormatVirtualListRowLabel(const u64 rowKey, const Array<u8, 32u>& labelStorage)noexcept{
    if(rowKey == 0u)
        return "";
    auto& mutableStorage = const_cast<Array<u8, 32u>&>(labelStorage);
    const usize length = WriteVirtualListRowLabelBytes(rowKey, mutableStorage);
    return StringView(reinterpret_cast<const char*>(mutableStorage.data()), length);
}

NWB::ProjectFrameClientSize NWB::QueryProjectFrameClientSize(){
    return { s_DefaultProjectFrameClientWidth, s_DefaultProjectFrameClientHeight };
}

TStringView NWB::QueryProjectWindowTitle()noexcept{
    return Testbed::s_WindowTitle;
}

b8 NWB::ConfigureProjectRuntime(ProjectStartupContext& context)noexcept{
    Core::GraphicsRuntime& graphics = context.graphics;
    return graphics.setBindlessHeapAbi(Impl::AssetsGraphicsBindless::MakeGpuDescriptorHeapAbi()) && graphics.setHDR10OutputEnabled(true);
}

UniquePtr<NWB::IProjectEntryCallbacks> NWB::CreateProjectEntryCallbacks(NWB::ProjectRuntimeContext& context){
    return MakeUnique<Testbed::Project>(context);
}


