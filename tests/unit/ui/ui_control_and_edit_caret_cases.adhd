    self.expectRange(MakeUiEditCaretRange(1u, 7u), 1u, MakeUiControlCaretRect(0.0f, 12.0f, 11.0f, 12.0f));
    self.expectRange(MakeUiEditCaretRange(1u, 7u), 2u, MakeUiControlCaretRect(0.0f, 24.0f, 10.0f, 12.0f));
}

void VerifyEditCaretRangeFixture_SelectingOnlyLfPaintsItsPrecedingLineCap(mut EditCaretFixture self){
