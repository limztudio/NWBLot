            && ReserveGpuTimingScope(graphics, Name("render.shadow.light_space_map_opaque"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.shadow.light_space_map_transparent"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.shadow.light_space_fallback_opaque"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.shadow.light_space_fallback_transparent"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.shadow_opaque_trace"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.shadow_geometry_downsample"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.shadow_opaque_temporal"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.shadow_combined_temporal"), s_GpuTimingQueriesPerRange)
