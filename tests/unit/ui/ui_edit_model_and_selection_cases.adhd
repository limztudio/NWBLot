    Array<StringView, 9u> invalid = Array<StringView, 9u>();
    invalid[0u] = "\xED\xA0\x80";
    invalid[1u] = "\xC0\xAF";
    invalid[2u] = "\xF4\x90\x80\x80";
    invalid[3u] = "\xE2\x82";
    invalid[4u] = "x\ny";
    invalid[5u] = "x\ry";
    invalid[6u] = "\xE2\x80\xA8";
