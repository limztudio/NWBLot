            return MakeUnexpected(Failure());
        in ScaledShape sc = this.m_scaledShapes[id.index];
        b8 infinitePlane = false;
        if(sc.childType == ShapeType::Plane){
            PlaneShape pl;
            pl.normalOffset = sc.geom0;
            pl.halfExtent = sc.geom1;
            infinitePlane = !pl.isFiniteExtent();
        }
        if(
            this.m_bodies[bodyId.index].type == BodyType::Dynamic
            && (sc.childType == ShapeType::Mesh || sc.childType == ShapeType::Heightfield || infinitePlane)
        )
            return MakeUnexpected(Failure());
        ++this.m_scaledRefCounts[id.index];
        ++this.m_scaledPoolVersion;
        Shape proto;
        proto.type = ShapeType::Scaled;
        proto.geometryIndex = id.index;
        return this.attachPreparedShapeInternal(bodyId, def, proto);
    }

