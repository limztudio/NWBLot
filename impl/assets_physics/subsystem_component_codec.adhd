    public f32 maxHandbrakeTorque = 4000.0f;
    public f32 frictionMultiplier = 1.0f;
    public f32 loadSensitivity = 0.0f;
    public f32 nominalWheelLoad = 4000.0f;
    public f32 rollingResistanceCoeff = 0.015f;
    public f32 longitudinalStiffness = 12.0f;
    public f32 lateralStiffness = 10.0f;
    public f32 pacejkaShapeC = 1.35f;
    public f32 pacejkaCurvatureE = 0.0f;
    public f32 antiRollStiffness = 8000.0f;
    public i32 antiRollPairIndex = -1;
    public i32 axleIndex = -1;
    public u8 flags = 0u;
    public u8 reserved0 = 0u;
    public u16 reserved1 = 0u;
    public u64 reserved2 = 0u;
}

