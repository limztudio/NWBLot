NWB_ADHD_GTEST(X11TextInputDispatchFence, RetirementWithoutNativeStackCanReleaseImmediately, VerifyX11TextInputDispatchFence_RetirementWithoutNativeStackCanReleaseImmediately)

NWB_ADHD_GTEST(X11FilteredKeyHistory, ForwardedPressAndReleaseCannotReplayAfterThePhysicalRelease, VerifyX11FilteredKeyHistory_ForwardedPressAndReleaseCannotReplayAfterThePhysicalRelease)
NWB_ADHD_GTEST(X11FilteredKeyHistory, NewRepeatsAdvanceWithoutRevivingOlderForwardedPresses, VerifyX11FilteredKeyHistory_NewRepeatsAdvanceWithoutRevivingOlderForwardedPresses)
NWB_ADHD_GTEST(X11FilteredKeyHistory, CoalescedAutorepeatReleaseCannotClearTheLaterRepeatedPress, VerifyX11FilteredKeyHistory_CoalescedAutorepeatReleaseCannotClearTheLaterRepeatedPress)
NWB_ADHD_GTEST(X11FilteredKeyHistory, ZeroTimeSyntheticCyclesStayDistinctFromTheirForwardedCopies, VerifyX11FilteredKeyHistory_ZeroTimeSyntheticCyclesStayDistinctFromTheirForwardedCopies)
