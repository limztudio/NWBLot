[cpp_name("::AtomicBackOff")]
extern class AtomicBackOff{
    b8 boundedPause(...);
    void pause(...);
    void reset(...);
};

[cpp_name("::ConditionVariableAny")]
extern class ConditionVariableAny;

[cpp_name("::Futex")]
extern class Futex{
    void lock(...);
    b8 try_lock(...);
    void unlock(...);
};

[cpp_header("<global/sync.h>"), cpp_name("::FutexGuard")]
extern class FutexGuard;

[cpp_header("<global/sync.h>"), cpp_name("::AcquireFutex")]
extern FutexGuard AcquireFutex(in Futex mutex);

[cpp_name("::MallocMutex")]
extern class MallocMutex{
    void lock(...);
    b8 try_lock(...);
    void unlock(...);
};

[cpp_name("::RecursiveMutex")]
extern class RecursiveMutex;


