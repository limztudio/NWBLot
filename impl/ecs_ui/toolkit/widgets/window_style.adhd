////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/widgets/style.adhd>
#include <impl/ecs_ui/toolkit/input/input.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_WindowResizeGripMaximumThickness = 2.0f;
const f32 s_WindowResizeGripThicknessFraction = 0.125f;
const f32 s_WindowResizeGripStartFraction = 0.25f;
const f32 s_WindowResizeGripLengthFraction = 0.75f;

// Gesture baselines stay in the host model; frozen draw snapshots never borrow WindowState.
class WindowGestureState{
    public InputActionId id;
    public Rect initialBounds;
}

class WindowState{
    public Rect bounds;
    public WindowGestureState moveGesture;
    public WindowGestureState resizeGesture;
    public b8 initialized = false;
    public b8 collapsed = false;
}

const Rect s_WindowDefaultBounds = Rect(20.0f, 20.0f, 360.0f, 280.0f);
const Point s_WindowDefaultMinimumSize = Point(160.0f, 80.0f);

class WindowOptions{
    public Rect initialBounds = s_WindowDefaultBounds;
    public Point minimumSize = s_WindowDefaultMinimumSize;
    public LayoutDirection direction = LayoutDirection::Column;
    public b8 contentWidthFirstUse = false;
    public b8 contentHeightFirstUse = false;
    public b8 movable = true;
    public b8 resizable = true;
    public b8 collapsible = true;
}

class WindowMetrics{
    public Insets contentPadding;
    public Insets titlePadding;
    public Point minimumSize;
    public f32 titleHeight = 0.0f;
    public f32 collapseExtent = 0.0f;
    public f32 resizeExtent = 0.0f;
}

Rect ResolveVisibleWindowBounds(in WindowState state, in WindowMetrics metrics){
    Rect bounds = state.bounds;
    if(state.collapsed){
        bounds.height = metrics.titleHeight;
    }
    return bounds;
}

Rect ResolveWindowContentBounds(in WindowState state, in WindowMetrics metrics){
    return Rect(
        state.bounds.x,
        state.bounds.y + metrics.titleHeight,
        state.bounds.width,
        max(0.0f, state.bounds.height - metrics.titleHeight)
    );
}

Rect ResolveWindowCollapseBounds(in WindowState state, in WindowMetrics metrics){
    const f32 x = state.bounds.x + metrics.titlePadding.left;
    const f32 availableHeight = ((metrics.titleHeight - metrics.titlePadding.top) - metrics.titlePadding.bottom) - metrics.collapseExtent;
    const f32 y = (state.bounds.y + metrics.titlePadding.top) + max(0.0f, availableHeight * 0.5f);
    return Rect(x, y, metrics.collapseExtent, metrics.collapseExtent);
}

Rect ResolveWindowResizeBounds(in WindowState state, in WindowMetrics metrics){
    const f32 extent = min(metrics.resizeExtent, min(state.bounds.width, state.bounds.height - metrics.titleHeight));
    const f32 endX = state.bounds.x + state.bounds.width;
    const f32 endY = state.bounds.y + state.bounds.height;
    return Rect(endX - extent, endY - extent, extent, extent);
}

void ResolveWindowResizeGripBars(in Rect corner, mut Rect outHorizontal, mut Rect outVertical){
    const f32 thickness = min(s_WindowResizeGripMaximumThickness, corner.width * s_WindowResizeGripThicknessFraction);
    const f32x4 cornerSize(corner.width, corner.height, corner.width, corner.height);
    const f32x4 scaledSize = cornerSize * f32x4(
        s_WindowResizeGripStartFraction,
        s_WindowResizeGripStartFraction,
        s_WindowResizeGripLengthFraction,
        s_WindowResizeGripLengthFraction
    );
    const f32x4 ends = (cornerSize * f32x4(s_WindowResizeGripStartFraction, 1.0f, 1.0f, s_WindowResizeGripStartFraction))
        + f32x4(corner.x, corner.y, corner.x, corner.y);
    const f32x4 origins = ends - f32x4(0.0f, thickness, thickness, 0.0f);
    outHorizontal = Rect(origins.x, origins.y, scaledSize.z, thickness);
    outVertical = Rect(origins.z, origins.w, thickness, scaledSize.w);
}

Expected<WindowMetrics> TryMeasureWindow(in UiSkinRegion frame, in UiSkinRegion title, in f32 collapseExtent, in f32 resizeExtent, in WidgetStyle style, in WindowOptions options, in Point titleSize, in f32 density){
    if(
        !isFinite(style.windowCollapseExtent) || style.windowCollapseExtent <= 0.0f
        || !isFinite(style.windowResizeExtent) || style.windowResizeExtent <= 0.0f
        || !isFinite(style.gap) || style.gap < 0.0f
        || !isFinite(density) || density <= 0.0f
        || !IsValidUiExtent(options.minimumSize)
    )
        return makeUnexpected(Failure());
    WindowMetrics metrics;
    metrics.contentPadding = Insets(frame.padding.left, frame.padding.top, frame.padding.right, frame.padding.bottom);
    metrics.titlePadding = Insets(title.padding.left, title.padding.top, title.padding.right, title.padding.bottom);
    metrics.collapseExtent = collapseExtent;
    metrics.resizeExtent = resizeExtent;
    const f32 titleContentX = titleSize.x;
    const f32 titleContentY = max(titleSize.y, metrics.collapseExtent);
    const f32 titlePaddedX = (titleContentX + metrics.titlePadding.left) + metrics.titlePadding.right;
    const f32 titlePaddedY = (titleContentY + metrics.titlePadding.top) + metrics.titlePadding.bottom;
    metrics.titleHeight = max(title.minimumHeight, titlePaddedY);
    f32 collapseWidth = 0.0f;
    if(options.collapsible)
        collapseWidth = metrics.collapseExtent + style.gap;
    const f32 titleMinX = max(title.minimumWidth, titlePaddedX + collapseWidth);
    const f32 contentMinY = (metrics.titleHeight + metrics.contentPadding.top) + metrics.contentPadding.bottom;
    const f32 minX = max(options.minimumSize.x, max(frame.minimumWidth, titleMinX));
    const f32 minY = max(options.minimumSize.y, max(frame.minimumHeight, contentMinY));
    metrics.minimumSize = Point(minX, minY);
    if(!isFinite(metrics.titleHeight) || !isFinite(metrics.minimumSize.x) || !isFinite(metrics.minimumSize.y) || metrics.titleHeight <= 0.0f || metrics.minimumSize.x <= 0.0f || metrics.minimumSize.y <= 0.0f)
        return makeUnexpected(Failure());
    return metrics;
}

Expected<f64x4> TryLoadWindowPointerDisplacement(in PointerGesture gesture){
    if(
        !gesture.id.valid()
        || !isFinite(gesture.origin.x) || !isFinite(gesture.origin.y)
        || !isFinite(gesture.position.x) || !isFinite(gesture.position.y)
        || !IsValidUiRect(gesture.referenceRectangle)
        || gesture.referenceRectangle.width <= 0.0f || gesture.referenceRectangle.height <= 0.0f
        || gesture.state > PointerGestureState::Completed
    )
        return makeUnexpected(Failure());
    return f64x4(
        cast<f64>(gesture.position.x) - cast<f64>(gesture.origin.x),
        cast<f64>(gesture.position.y) - cast<f64>(gesture.origin.y),
        0.0,
        0.0
    );
}

b8 TryInitializeWindow(in WindowOptions options, in WindowMetrics metrics, mut WindowState state){
    if(
        !IsValidUiRect(options.initialBounds)
        || options.direction > LayoutDirection::Column || options.direction == LayoutDirection::Leaf
        || !IsValidUiExtent(options.minimumSize)
        || !isFinite(metrics.minimumSize.x) || metrics.minimumSize.x <= 0.0f
        || !isFinite(metrics.minimumSize.y) || metrics.minimumSize.y <= 0.0f
    )
        return false;
    WindowState candidate = state;
    if(!candidate.initialized){
        candidate.bounds = options.initialBounds;
        candidate.moveGesture = WindowGestureState();
        candidate.resizeGesture = WindowGestureState();
    }
    if(!IsValidUiRect(candidate.bounds))
        return false;
    candidate.bounds.width = max(candidate.bounds.width, metrics.minimumSize.x);
    candidate.bounds.height = max(candidate.bounds.height, metrics.minimumSize.y);
    candidate.initialized = true;
    if(!IsValidUiRect(candidate.bounds))
        return false;
    state = candidate;
    return true;
}

b8 TryApplyWindowMove(in PointerGesture gesture, mut WindowState state){
    const Expected<f64x4> displacement = TryLoadWindowPointerDisplacement(gesture);
    if(!displacement.has_value())
        return false;
    WindowGestureState movement = state.moveGesture;
    if(movement.id != gesture.id){
        movement.id = gesture.id;
        movement.initialBounds = gesture.referenceRectangle;
    }
    const f64 left = cast<f64>(movement.initialBounds.x) + displacement.value().x;
    const f64 top = cast<f64>(movement.initialBounds.y) + displacement.value().y;
    if(abs(left) > s_UiMaxFloatF64 || abs(top) > s_UiMaxFloatF64)
        return false;
    Rect candidate = state.bounds;
    candidate.x = cast<f32>(left);
    candidate.y = cast<f32>(top);
    if(!IsValidUiRect(candidate))
        return false;
    state.bounds = candidate;
    state.moveGesture = movement;
    return true;
}

b8 TryApplyWindowResize(in PointerGesture gesture, in Point minimumSize, mut WindowState state){
    const Expected<f64x4> displacement = TryLoadWindowPointerDisplacement(gesture);
    if(!displacement.has_value() || !isFinite(minimumSize.x) || minimumSize.x <= 0.0f || !isFinite(minimumSize.y) || minimumSize.y <= 0.0f)
        return false;
    WindowGestureState resizing = state.resizeGesture;
    if(resizing.id != gesture.id){
        resizing.id = gesture.id;
        resizing.initialBounds = gesture.referenceRectangle;
    }
    const f64 width = max(cast<f64>(minimumSize.x), cast<f64>(resizing.initialBounds.width) + displacement.value().x);
    const f64 height = max(cast<f64>(minimumSize.y), cast<f64>(resizing.initialBounds.height) + displacement.value().y);
    if(width > s_UiMaxFloatF64 || height > s_UiMaxFloatF64)
        return false;
    Rect candidate = state.bounds;
    candidate.width = cast<f32>(width);
    candidate.height = cast<f32>(height);
    if(!IsValidUiRect(candidate))
        return false;
    state.bounds = candidate;
    state.resizeGesture = resizing;
    return true;
}

b8 TryConstrainWindow(in DisplayMetrics display, in f32 titleHeight, mut WindowState state){
    if(!isFinite(display.logicalWidth) || display.logicalWidth <= 0.0f || !isFinite(display.logicalHeight) || display.logicalHeight <= 0.0f || !isFinite(titleHeight) || titleHeight <= 0.0f || !IsValidUiRect(state.bounds))
        return false;
    f32 height = state.bounds.height;
    if(state.collapsed)
        height = titleHeight;
    const f32 maxX = max(0.0f, display.logicalWidth - state.bounds.width);
    const f32 maxY = max(0.0f, display.logicalHeight - height);
    state.bounds.x = clamp(state.bounds.x, 0.0f, maxX);
    state.bounds.y = clamp(state.bounds.y, 0.0f, maxY);
    return true;
}

Expected<WindowMetrics> MeasureWindow(in UiSkinRegion frame, in UiSkinRegion title, in UiSkinRegion collapse, in UiSkinRegion resize, in WidgetStyle style, in WindowOptions options, in Point titleSize, in f32 density){
    if(
        !isFinite(style.windowCollapseExtent) || style.windowCollapseExtent <= 0.0f
        || !isFinite(style.windowResizeExtent) || style.windowResizeExtent <= 0.0f
        || !isFinite(style.gap) || style.gap < 0.0f
        || !isFinite(density) || density <= 0.0f
        || !IsValidUiExtent(options.minimumSize)
    )
        return makeUnexpected(Failure());
    f32 collapseExtent = 0.0f;
    if(options.collapsible)
        collapseExtent = ResolveUiSkinSquareExtent(style.windowCollapseExtent, collapse, density);
    const f32 resizeExtent = ResolveUiSkinSquareExtent(style.windowResizeExtent, resize, density);
    return TryMeasureWindow(frame, title, collapseExtent, resizeExtent, style, options, titleSize, density);
}

Rect ResolveWindowTitleContentBounds(in Rect header, in WindowMetrics metrics, in b8 collapsible, in f32 gap){
    f32 collapseReservation = 0.0f;
    if(collapsible)
        collapseReservation = metrics.collapseExtent + gap;
    const Insets padding(metrics.titlePadding.left + collapseReservation, metrics.titlePadding.top, metrics.titlePadding.right, metrics.titlePadding.bottom);
    return InsetUiRectBounds(header, padding);

}


