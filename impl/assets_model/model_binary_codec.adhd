#include <impl/assets_model/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ReadUnpackedModelObjects<BinaryT, ObjectT>(
    in Span<u8> binary,
    mut usize cursor,
    in u64 rawCount,
    in usize binaryStrideBytes,
    in StringView label,
    in Func<16u, ObjectT(in BinaryT)> unpackFn,
    mut Vector<ObjectT> outObjects
){
    if(rawCount > cast<u64>(usize.max / binaryStrideBytes)){
        error("Model::loadBinary failed: '{}' payload byte size overflows", label);
        return false;
    }
    const usize count = cast<usize>(rawCount);
    if(!CanReadBytes(binary, cursor, count * binaryStrideBytes) || !CanStoreValueCount(outObjects, count)){
        error("Model::loadBinary failed: malformed '{}' payload", label);
        return false;
    }
    outObjects.clear();
    outObjects.reserve(count);
    for(usize i = 0u; i < count; ++i){
        const Expected<BinaryT> item = ReadPOD<BinaryT>(binary, cursor);
        if(!item.has_value())
            return false;
        outObjects.push_back(unpackFn(item.value()));
    }
    return true;
}

class ModelBinaryCodec{
    private b8 isValidHeader(in ModelHeaderBinary header)const{
        return header.padding0 == 0u;
    }

    private b8 validateHeader(in ModelHeaderBinary header)const{
        if(this.isValidHeader(header))
            return true;

        error("Model::loadBinary failed: reserved header fields must be zero");
        return false;
    }

    public b8 serialize(
        in Span<ModelSkeletonObject> skeletonObjects,
        in Span<ModelStaticMeshObject> staticMeshObjects,
        in Span<ModelSkinnedMeshObject> skinnedMeshObjects,
        mut Vector<u8> outBinary
    )const{
        usize reserveBytes = s_ModelHeaderBinaryBytes;
        const b8 canReserve =
            AddBinaryRepeatedReserveBytes(reserveBytes, skeletonObjects.size(), s_ModelSkeletonObjectBinaryBytes)
            && AddBinaryRepeatedReserveBytes(reserveBytes, staticMeshObjects.size(), s_ModelStaticMeshObjectBinaryBytes)
            && AddBinaryRepeatedReserveBytes(reserveBytes, skinnedMeshObjects.size(), s_ModelSkinnedMeshObjectBinaryBytes)
            && CanStoreValueCount(outBinary, reserveBytes)
        ;
        if(!canReserve){
            error("ModelAssetCodec::serialize failed: model payload byte size overflows");
            return false;
        }

        outBinary.clear();
        outBinary.reserve(reserveBytes);

        const ModelHeaderBinary header = MakeModelHeaderBinary(
            cast<u64>(skeletonObjects.size()),
            cast<u64>(staticMeshObjects.size()),
            cast<u64>(skinnedMeshObjects.size())
        );
        AppendPOD(outBinary, header);
        for(in ModelSkeletonObject object : skeletonObjects)
            AppendPOD(outBinary, PackModelSkeletonObjectBinary(object));
        for(in ModelStaticMeshObject object : staticMeshObjects)
            AppendPOD(outBinary, PackModelStaticMeshObjectBinary(object));
        for(in ModelSkinnedMeshObject object : skinnedMeshObjects)
            AppendPOD(outBinary, PackModelSkinnedMeshObjectBinary(object));
        return true;
    }

    public b8 deserialize(
        in Span<u8> binary,
        mut Vector<ModelSkeletonObject> outSkeletonObjects,
        mut Vector<ModelStaticMeshObject> outStaticMeshObjects,
        mut Vector<ModelSkinnedMeshObject> outSkinnedMeshObjects
    )const{
        usize cursor = 0u;
        const Expected<ModelHeaderBinary> headerResult = ReadMagicHeaderPayload<ModelHeaderBinary>(
            binary,
            s_ModelBinaryMagic,
            "Model::loadBinary",
            "model",
            cursor
        );
        if(!headerResult.has_value())
            return false;
        const ModelHeaderBinary header = headerResult.value();
        if(!this.validateHeader(header))
            return false;

        if(!ReadUnpackedModelObjects<ModelSkeletonObjectBinary, ModelSkeletonObject>(
            binary,
            cursor,
            header.skeletonObjectCount,
            s_ModelSkeletonObjectBinaryBytes,
            "skeleton objects",
            lambda[](in ModelSkeletonObjectBinary item) -> ModelSkeletonObject{ return UnpackModelSkeletonObjectBinary(item); },
            outSkeletonObjects
        ))
            return false;
        if(!ReadUnpackedModelObjects<ModelStaticMeshObjectBinary, ModelStaticMeshObject>(
            binary,
            cursor,
            header.staticMeshObjectCount,
            s_ModelStaticMeshObjectBinaryBytes,
            "static mesh objects",
            lambda[](in ModelStaticMeshObjectBinary item) -> ModelStaticMeshObject{ return UnpackModelStaticMeshObjectBinary(item); },
            outStaticMeshObjects
        ))
            return false;
        if(!ReadUnpackedModelObjects<ModelSkinnedMeshObjectBinary, ModelSkinnedMeshObject>(
            binary,
            cursor,
            header.skinnedMeshObjectCount,
            s_ModelSkinnedMeshObjectBinaryBytes,
            "skinned mesh objects",
            lambda[](in ModelSkinnedMeshObjectBinary item) -> ModelSkinnedMeshObject{ return UnpackModelSkinnedMeshObjectBinary(item); },
            outSkinnedMeshObjects
        ))
            return false;

        return ReadCompletePayload(binary, cursor, "Model::loadBinary");
    }
}


