void VerifyUiSelectionEpochTests_OrderedHostRejectsCollectedNativeTextAfterAcceptedIdenticalSelection(mut UiSelectionEpochTests self){
    self.hostRejected(EpochMutation::SameSelection);
}

void VerifyUiSelectionEpochTests_OrderedHostRejectsCollectedNativeTextAfterCompositionRoundTrip(mut UiSelectionEpochTests self){
    self.hostRejected(EpochMutation::CompositionRoundTrip);
}

void VerifyUiSelectionEpochTests_OrderedHostRetiresOldNativeTextAndKeepsTheApplicationReplacementSelection(mut UiSelectionEpochTests self){
    ASSERT_TRUE(self.seedSelection());
    ASSERT_TRUE(self.activate());
    const TextInputSessionToken token = self.m_textInput.activeSession();
    ASSERT_EQ(self.m_textInput.commit("late"), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    ASSERT_TRUE(self.m_model.setSelection(3u, 0u));
    const u64 selectionGeneration = self.m_model.selectionGeneration();
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "abcd");
    EXPECT_EQ(self.m_model.anchor(), 3u);
    EXPECT_EQ(self.m_model.caret(), 0u);
    EXPECT_EQ(self.m_model.selectionGeneration(), selectionGeneration);
    EXPECT_FALSE(self.m_model.canUndo());
    EXPECT_EQ(self.m_textInput.emitCommit(token, "later"), TextInputAdmission::InvalidSession);
    ASSERT_EQ(self.m_textInput.commit("fresh"), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "freshd");
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "abcd");
    EXPECT_EQ(self.m_model.anchor(), 3u);
    EXPECT_EQ(self.m_model.caret(), 0u);
}

void VerifyUiSkinSelectionTests_FailedCustomFallsBackToDefaultAndRevalidatesOnlyDefault(){
    u32 customCalls = 0u;
    u32 defaultCalls = 0u;
    native(mut customCalls, mut defaultCalls){
        using namespace __hidden_ui_skin_selection_tests;
        const Core::Assets::AssetRef<UiSkin> custom{ s_MissingSkinPath };
        UiSkinSelectionState selection = MakeUiSkinSelectionState(custom);
        const auto bind = [&](const Core::Assets::AssetRef<UiSkin>& ref){
            if(ref == custom){
                ++customCalls;
                return false;
            }
            EXPECT_EQ(ref, s_DefaultUiSkinRef);
            ++defaultCalls;
            return true;
        };
        EXPECT_EQ(EnsureUiSkinSelection(selection, s_DefaultUiSkinRef, bind), UiSkinSelectionResult::DefaultFallback);
        EXPECT_EQ(selection.selected, s_DefaultUiSkinRef);
        EXPECT_EQ(EnsureUiSkinSelection(selection, s_DefaultUiSkinRef, bind), UiSkinSelectionResult::Selected);
    }
    EXPECT_EQ(customCalls, 1u);
    EXPECT_EQ(defaultCalls, 2u);
}

void VerifyUiSkinSelectionTests_FailedDefaultLeavesSelectionUncommittedForRetry(){
    u32 calls = 0u;
    native(mut calls){
        using namespace __hidden_ui_skin_selection_tests;
        const Core::Assets::AssetRef<UiSkin> custom{ s_MissingSkinPath };
        UiSkinSelectionState selection = MakeUiSkinSelectionState(custom);
        const auto reject = [&](const Core::Assets::AssetRef<UiSkin>&)noexcept{ ++calls; return false; };
        EXPECT_EQ(EnsureUiSkinSelection(selection, s_DefaultUiSkinRef, reject), UiSkinSelectionResult::Failed);
        EXPECT_FALSE(selection.selected.valid());
        EXPECT_EQ(calls, 2u);
        const auto acceptCustom = [&](const Core::Assets::AssetRef<UiSkin>& ref)noexcept{ return ref == custom; };
        EXPECT_EQ(EnsureUiSkinSelection(selection, s_DefaultUiSkinRef, acceptCustom), UiSkinSelectionResult::Selected);
        EXPECT_EQ(selection.selected, custom);
    }
    EXPECT_EQ(calls, 2u);
}

void VerifyUiSkinSelectionTests_FailedRevalidationPreservesPreviouslySelectedCustom(){
    u32 calls = 0u;
    native(mut calls){
        using namespace __hidden_ui_skin_selection_tests;
        const Core::Assets::AssetRef<UiSkin> custom{ s_CustomSkinPath };
        UiSkinSelectionState selection = MakeUiSkinSelectionState(custom);
        const auto acceptCustom = [&](const Core::Assets::AssetRef<UiSkin>& ref)noexcept{ return ref == custom; };
        EXPECT_EQ(EnsureUiSkinSelection(selection, s_DefaultUiSkinRef, acceptCustom), UiSkinSelectionResult::Selected);
        EXPECT_EQ(
            EnsureUiSkinSelection(selection, s_DefaultUiSkinRef, [&](const Core::Assets::AssetRef<UiSkin>& ref){
                ++calls;
                EXPECT_EQ(ref, custom);
                return false;
            }),
            UiSkinSelectionResult::Failed
        );
        EXPECT_EQ(selection.selected, custom);
    }
    EXPECT_EQ(calls, 1u);
}

void VerifyUiTextEditOwned_PollCopiesEventsWithoutApplyingAndOwnedCommitSurvivesNativeCancellation(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    UiEditModel model = UiEditModel(arena.arena);
    UiTextEditSession session = UiTextEditSession(arena.arena, service);
    TextInputEvent event = TextInputEvent(arena.arena);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("base"));
    ASSERT_EQ(session.begin(s_OwnedTestOwner, s_OwnedTestCaret, model), TextInputAdmission::Accepted);
    const TextInputSessionToken oldToken = session.token();
    String source = String(" copied");
    ASSERT_EQ(service.commit(StringView(source)), TextInputAdmission::Accepted);
    source.assign("changed");
    ASSERT_EQ(session.pollOwned(event), TextInputPollResult::Event);
    EXPECT_EQ(event.token, oldToken);
    EXPECT_EQ(StringView(event.text), " copied");
    EXPECT_EQ(model.text(), "base");
    EXPECT_TRUE(session.matchesPublished(s_OwnedTestOwner, model));
    ASSERT_TRUE(session.cancel());
    EXPECT_FALSE(session.token().valid());
    EXPECT_FALSE(service.activeSession().valid());
    EXPECT_EQ(session.pollOwned(event), TextInputPollResult::InvalidSession);
    ASSERT_EQ(ApplyUiTextEditEvent(model, event, 0u, false), UiTextEditStatus::Applied);
    EXPECT_EQ(model.text(), "base copied");
}

void VerifyUiTextEditOwned_TrustedLocalAdoptionRecoversAfterStrictRefreshRejectsChangedModel(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    UiEditModel model = UiEditModel(arena.arena);
    UiTextEditSession session = UiTextEditSession(arena.arena, service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("base"));
    ASSERT_EQ(session.begin(s_OwnedTestOwner, s_OwnedTestCaret, model), TextInputAdmission::Accepted);
    const u64 oldSurrounding = session.surroundingRevision();
    ASSERT_TRUE(model.replaceSelection(" local"));
    EXPECT_FALSE(session.matchesPublished(s_OwnedTestOwner, model));
    EXPECT_EQ(session.refresh(s_OwnedTestOwner, model, s_OwnedTestCaret), TextInputAdmission::InvalidSession);
    ASSERT_EQ(session.adoptLocal(s_OwnedTestOwner, model, s_OwnedTestCaret), TextInputAdmission::Accepted);
    EXPECT_GT(session.surroundingRevision(), oldSurrounding);
    EXPECT_TRUE(session.matchesPublished(s_OwnedTestOwner, model));
    ASSERT_EQ(service.commit(" native"), TextInputAdmission::Accepted);
    ASSERT_EQ(session.drain(s_OwnedTestOwner, model).status, UiTextEditStatus::Applied);
    EXPECT_EQ(model.text(), "base local native");
}

void VerifyUiTextEditOwned_CancelWithoutModelLeavesTransientCompositionForTheNextSynchronousLend(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    UiEditModel model = UiEditModel(arena.arena);
    UiTextEditSession session = UiTextEditSession(arena.arena, service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("base"));
    ASSERT_EQ(session.begin(s_OwnedTestOwner, s_OwnedTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.preedit("draft", 0u, 5u, false), TextInputAdmission::Accepted);
    ASSERT_EQ(session.drain(s_OwnedTestOwner, model).status, UiTextEditStatus::Applied);
    ASSERT_TRUE(session.cancel());
    EXPECT_TRUE(model.composition().active);
    EXPECT_EQ(model.text(), "base");
    EXPECT_EQ(session.adoptLocal(s_OwnedTestOwner, model, s_OwnedTestCaret), TextInputAdmission::InvalidSession);
    model.cancelComposition();
    ASSERT_EQ(session.begin(s_OwnedTestOwner, s_OwnedTestCaret, model), TextInputAdmission::Accepted);
}

void VerifyUiTextEditOwned_CopiedSurroundingDeletionRequiresPublishedRevisionAndGraphemeAlignedRange(){
    TestArena arena = TestArena();
    UiEditModel model = UiEditModel(arena.arena);
    TextInputEvent event = TextInputEvent(arena.arena);
    ASSERT_TRUE(model.setText("a\xCC\x81z"));
    event.kind = TextInputEventKind::DeleteSurrounding;
    event.surroundingRevision = 7u;
    event.deleteBeforeBytes = 1u;
    EXPECT_EQ(ApplyUiTextEditEvent(model, event, 8u, true), UiTextEditStatus::StaleSurrounding);
    EXPECT_EQ(ApplyUiTextEditEvent(model, event, 7u, false), UiTextEditStatus::StaleSurrounding);
    EXPECT_EQ(model.text(), "a\xCC\x81z");
    event.deleteBeforeBytes = 2u;
    EXPECT_EQ(ApplyUiTextEditEvent(model, event, 7u, true), UiTextEditStatus::ModelRejected);
    EXPECT_EQ(model.text(), "a\xCC\x81z");
    event.deleteBeforeBytes = 5u;
    EXPECT_EQ(ApplyUiTextEditEvent(model, event, 7u, true), UiTextEditStatus::InvalidEvent);
    event.deleteBeforeBytes = 1u;
    EXPECT_EQ(ApplyUiTextEditEvent(model, event, 7u, true), UiTextEditStatus::Applied);
    EXPECT_EQ(model.text(), "a\xCC\x81");
}

void VerifyUiTextEditOwned_MalformedCopiedEventsAndRejectedPreeditPreserveCommittedState(){
    TestArena arena = TestArena();
    UiEditLimits limits = UiEditLimits();
    limits.maxBytes = 4u;
    UiEditModel model = UiEditModel(arena.arena, limits);
    TextInputEvent event = TextInputEvent(arena.arena);
    ASSERT_TRUE(model.setText("base"));
    event.kind = TextInputEventKind::Preedit;
    event.text.assign("\xED\x95\x9C");
    event.anchorByte = 1u;
    event.caretByte = 3u;
    EXPECT_EQ(ApplyUiTextEditEvent(model, event, 0u, false), UiTextEditStatus::InvalidEvent);
    EXPECT_FALSE(model.composition().active);
    event.anchorByte = 0u;
    EXPECT_EQ(ApplyUiTextEditEvent(model, event, 0u, false), UiTextEditStatus::ModelRejected);
    EXPECT_FALSE(model.composition().active);
    event.kind = TextInputEventKind::Commit;
    event.text.assign("\xC0\xAF");
    EXPECT_EQ(ApplyUiTextEditEvent(model, event, 0u, false), UiTextEditStatus::InvalidEvent);
    EXPECT_EQ(model.text(), "base");
    ASSERT_TRUE(model.beginComposition());
    event.kind = TextInputEventKind::Cancelled;
    EXPECT_EQ(ApplyUiTextEditEvent(model, event, 0u, false), UiTextEditStatus::Cancelled);
    EXPECT_FALSE(model.composition().active);
}

