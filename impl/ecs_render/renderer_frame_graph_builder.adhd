#include <impl/ecs_render/deferred/opaque_upload_chain_builder.adhd.h>
#include <impl/ecs_render/csg/opaque_csg_interval_clear_builder.adhd.h>
#include <impl/ecs_render/deferred/opaque_gbuffer_material_resources.adhd.h>
