}

[component_asset("renderer_component")]
class RendererComponentAsset{
    public RendererComponent component;
}

[serialize]
class SingleAssetRefComponentPayloadBinary{
    public NameHash assetHash;
}

[serialize]
class RendererComponentPayloadBinary{
    public NameHash materialHash;
    public NameHash opticalVolumeGroupHash;
    public i32 opticalVolumePriority = 0;
    public i32 opticalMediumPriority = 0;
    public u8 visible = 1u;
    public u8 opticalVolumeCoincidence = 0u;
    public u8 opticalBoundaryMode = 0u;
    public u8 reserved0 = 0u;
    public u32 reserved1 = 0u;
}

RendererComponentPayloadBinary PackRendererComponentPayloadBinary(in RendererComponent component){
    RendererComponentPayloadBinary binaryPayload;
    binaryPayload.materialHash = component.material.name().hash();
    binaryPayload.opticalVolumeGroupHash = component.opticalVolumeGroup.hash();
    binaryPayload.opticalVolumePriority = component.opticalVolumePriority;
    binaryPayload.opticalMediumPriority = component.opticalMediumPriority;
    if(component.visible)
        binaryPayload.visible = 1u;
    else
        binaryPayload.visible = 0u;
    binaryPayload.opticalVolumeCoincidence = cast<u8>(component.opticalVolumeCoincidence);
    binaryPayload.opticalBoundaryMode = cast<u8>(component.opticalBoundaryMode);
    binaryPayload.reserved0 = 0u;
    binaryPayload.reserved1 = 0u;
    return binaryPayload;
}

Expected<RendererComponent> UnpackRendererComponentPayloadBinary(in RendererComponentPayloadBinary binaryPayload){
    if(
        binaryPayload.visible > 1u
        || binaryPayload.opticalVolumeCoincidence > cast<u8>(OpticalVolumeCoincidence::SharedGroup)
        || binaryPayload.opticalBoundaryMode > cast<u8>(OpticalBoundaryMode::ClosedPriority)
        || binaryPayload.reserved0 != 0u
        || binaryPayload.reserved1 != 0u
    )
        return makeUnexpected(Failure());
    RendererComponent outComponent;
    outComponent.material.virtualPath = Name(binaryPayload.materialHash);
    outComponent.opticalVolumeGroup = Name(binaryPayload.opticalVolumeGroupHash);
    outComponent.visible = binaryPayload.visible != 0u;
    outComponent.opticalVolumeCoincidence = cast<OpticalVolumeCoincidence>(binaryPayload.opticalVolumeCoincidence);
    outComponent.opticalVolumePriority = binaryPayload.opticalVolumePriority;
    outComponent.opticalBoundaryMode = cast<OpticalBoundaryMode>(binaryPayload.opticalBoundaryMode);
    outComponent.opticalMediumPriority = binaryPayload.opticalMediumPriority;
    return outComponent;
}

b8 IsValidRendererComponentOpticalConfig(in RendererComponent component){
    return
        cast<u8>(component.opticalVolumeCoincidence) <= cast<u8>(OpticalVolumeCoincidence::SharedGroup)
        && cast<u8>(component.opticalBoundaryMode) <= cast<u8>(OpticalBoundaryMode::ClosedPriority)
    ;
}

SingleAssetRefComponentPayloadBinary PackSingleAssetRefComponentPayloadBinary(in Name assetName){
    SingleAssetRefComponentPayloadBinary binaryPayload;
    binaryPayload.assetHash = assetName.hash();
    return binaryPayload;
}

b8 IsAllowedRendererComponentMetadataField(in StringView field){
    return
        field == s_RendererComponentMaterialField
        || field == s_RendererComponentVisibleField
        || field == s_RendererComponentOpticalVolumeCoincidenceField
        || field == s_RendererComponentOpticalVolumeGroupField
        || field == s_RendererComponentOpticalVolumePriorityField
        || field == s_RendererComponentOpticalBoundaryModeField
        || field == s_RendererComponentOpticalMediumPriorityField
    ;
}

u64 BuildShaderVariantCookKeyHash(in NameHash virtualPathHash, in u64 sourceChecksum, in u64 bytecodeChecksum){
    u64 hash = s_ShaderFnv64OffsetBasis;
    hash = UpdateShaderFnv64U32(hash, s_ShaderVariantCookKeyVersion);
    hash = UpdateShaderFnv64NameHash(hash, virtualPathHash);
    hash = UpdateShaderFnv64U64(hash, sourceChecksum);
    hash = UpdateShaderFnv64U64(hash, bytecodeChecksum);
    return hash;
}

class ShaderStageKey{
    public Name shaderName;
    public Name stageName;

    public ShaderStageKey(){
        this.shaderName = s_NameNone;
        this.stageName = s_NameNone;
    }

    public ShaderStageKey(in Name inShaderName, in Name inStageName){
        this.shaderName = inShaderName;
        this.stageName = inStageName;
    }

    public b8 operator==(in ShaderStageKey rhs)const{
        return this.shaderName == rhs.shaderName && this.stageName == rhs.stageName;
    }

    public usize hash()const{
        usize seed = hashValue(this.shaderName);
        return hashCombineValue(seed, this.stageName);
    }
}

