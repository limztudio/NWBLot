#include <impl/ecs_render/raytrace/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RayTracingInstanceWorldBounds{
    public f32x3u minimum(0.0f, 0.0f, 0.0f);
    public f32x3u maximum(0.0f, 0.0f, 0.0f);
}


class RefractiveBoundsIsolation{
    public b8 isIsolated(in Span<RayTracingInstanceWorldBounds> instanceWorldBounds, in usize targetIndex)const{
        if(targetIndex >= instanceWorldBounds.size())
            return false;

        const RayTracingInstanceWorldBounds targetBounds = instanceWorldBounds[targetIndex];
        const VectorSingle margin(s_RefractionCertifiedBoundsMargin);
        const VectorSingle expandedMin = VectorSingle(targetBounds.minimum) - margin;
        const VectorSingle expandedMax = VectorSingle(targetBounds.maximum) + margin;
        for(usize index = 0u; index < instanceWorldBounds.size(); ++index){
            if(index == targetIndex)
                continue;
            const RayTracingInstanceWorldBounds otherBounds = instanceWorldBounds[index];
            const b8 separated =
                expandedMax.x < otherBounds.minimum.x || otherBounds.maximum.x < expandedMin.x
                || expandedMax.y < otherBounds.minimum.y || otherBounds.maximum.y < expandedMin.y
                || expandedMax.z < otherBounds.minimum.z || otherBounds.maximum.z < expandedMin.z
            ;
            if(!separated)
                return false;
        }
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

