#include "style.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RadioGroupStyle{
    public Name normal = Name("radio.normal");
    public Name hover = Name("radio.hover");
    public Name pressed = Name("radio.pressed");
    public Name checked = Name("radio.checked");
    public Name disabled = Name("radio.disabled");
    public Name mark = Name("radio.mark");
    public Name fallback = Name("checkbox.normal");
    public Name checkedFallback = Name("checkbox.checked");
    public Name markFallback = Name("checkbox.mark");
    public Name focus = Name("focus.overlay");
    public Color hoverTint = s_StyleHoverTint;
    public Color pressedTint = s_StylePressedTint;
    public Color disabledTint = s_StyleDisabledTint;
    public Insets padding = Insets(s_StyleSpacingSmall, s_StyleSpacingSmall, s_StyleSpacingSmall, s_StyleSpacingSmall);
    public f32 rowGap = s_StyleSpacingSmall;
    public f32 indicatorExtent = s_StyleControlExtent;
    public f32 gap = s_StyleSpacingMedium;
    // Fraction of the indicator extent inset on each side of its checked mark.
    public f32 markInset = s_StyleMarkInset;
}

const u32 s_RadioGroupMaxChoices = 64u;
const u32 s_RadioGroupStampFencePassCount = 2u;
const f32 s_RadioGroupMaxMarkInset = 0.5f;
const f64 s_RadioGroupMaxMarkInsetF64 = 0.5;

class RadioGroupOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public b8 enabled = true;
}

class RadioGroupResult{
    public b8 valid = false;
    public b8 selectionChanged = false;
    public b8 activated = false;
    public b8 focused = false;
}

class RadioGroupChoice{
    public u64 key = 0u;
    public b8 enabled = false;
}

class RadioGroupChoices{
    public Array<RadioGroupChoice, s_RadioGroupMaxChoices> rows;
    public u64 sourceGeneration = 0u;
    public u64 sourceRevision = 0u;
    public u32 count = 0u;
}

class RadioGroupSnapshot{
    public b8 operator==(in RadioGroupSnapshot rhs)const{
        return this.instanceGeneration == rhs.instanceGeneration
            && this.inputGeneration == rhs.inputGeneration
            && this.revision == rhs.revision
            && this.selectedKey == rhs.selectedKey
            && this.cursorKey == rhs.cursorKey
            && this.sourceGeneration == rhs.sourceGeneration
            && this.sourceRevision == rhs.sourceRevision;
    }

    public b8 operator!=(in RadioGroupSnapshot rhs)const{
        return this.instanceGeneration != rhs.instanceGeneration
            || this.inputGeneration != rhs.inputGeneration
            || this.revision != rhs.revision
            || this.selectedKey != rhs.selectedKey
            || this.cursorKey != rhs.cursorKey
            || this.sourceGeneration != rhs.sourceGeneration
            || this.sourceRevision != rhs.sourceRevision;
    }

    public u64 instanceGeneration = 0u;
    public u64 inputGeneration = 0u;
    public u64 revision = 0u;
    public u64 selectedKey = 0u;
    public u64 cursorKey = 0u;
    public u64 sourceGeneration = 0u;
    public u64 sourceRevision = 0u;
}

class RadioGroupMetrics{
    public f32 rowHeight = 0.0f;
    public f32 indicatorExtent = s_StyleControlExtent;
    public f32 gap = s_StyleSpacingMedium;
    public f32 rowGap = s_StyleSpacingSmall;
    public f32 markInset = s_StyleMarkInset;
    public Insets padding;
    // Complete intrinsic group size, including its outer padding.
    public Point contentSize;
    public u32 count = 0u;
}

class RadioGroupChoicePlacement{
    public u64 key = 0u;
    public b8 enabled = false;
    public Rect rectangle;
    public Rect clip;
    public Rect indicator;
    public Rect mark;
    public Rect textClip;
}

class RadioGroupPlacement{
    public Rect bounds;
    public Rect clip;
    public Rect content;
    public Array<RadioGroupChoicePlacement, s_RadioGroupMaxChoices> rows;
    public u32 count = 0u;
}

b8 IsValidRadioGroupChoices(in RadioGroupChoices choices){
    if(choices.sourceGeneration == 0u || choices.sourceRevision == 0u || choices.count > s_RadioGroupMaxChoices){
        return false;
    }
    for(u32 index = 0u; index < choices.count; ++index){
        if(choices.rows[index].key == 0u){
            return false;
        }
        for(u32 previous = 0u; previous < index; ++previous){
            if(choices.rows[previous].key == choices.rows[index].key){
                return false;
            }
        }
    }
    return true;
}

b8 TryFindRadioGroupChoice(in RadioGroupChoices choices, in u64 key, mut u32 outIndex){
    if(key == 0u){
        return false;
    }
    for(u32 candidate = 0u; candidate < choices.count; ++candidate){
        if(choices.rows[candidate].key == key){
            outIndex = candidate;
            return true;
        }
    }
    return false;
}

u64 FindEnabledRadioGroupChoice(in RadioGroupChoices choices, in u32 start, in b8 reverse){
    if(choices.count == 0u || start >= choices.count){
        return 0u;
    }
    u32 index = start;
    for(u32 visited = 0u; visited < choices.count; ++visited){
        if(choices.rows[index].enabled){
            return choices.rows[index].key;
        }
        if(reverse){
            if(index == 0u){
                index = choices.count - 1u;
            }
            else{
                index = index - 1u;
            }
        }
        else{
            if(index + 1u == choices.count){
                index = 0u;
            }
            else{
                index = index + 1u;
            }
        }
    }
    return 0u;
}

b8 IsValidRadioGroupOptions(in RadioGroupOptions options){
    return options.enabled && IsValidLayoutSize(options.width);
}

u64 ResolveRadioGroupNavigationTarget(in RadioGroupChoices choices, in u64 cursor, in ControlActionKind kind){
    if(choices.count == 0u){
        return 0u;
    }
    if(kind == ControlActionKind::Home){
        return FindEnabledRadioGroupChoice(choices, 0u, false);
    }
    if(kind == ControlActionKind::End){
        return FindEnabledRadioGroupChoice(choices, choices.count - 1u, true);
    }
    const b8 reverse = kind == ControlActionKind::Up || kind == ControlActionKind::Left;
    u32 current = 0u;
    if(!TryFindRadioGroupChoice(choices, cursor, current)){
        u32 fallbackStart = 0u;
        if(reverse){
            fallbackStart = choices.count - 1u;
        }
        return FindEnabledRadioGroupChoice(choices, fallbackStart, reverse);
    }
    u32 start = 0u;
    if(reverse){
        if(current == 0u){
            start = choices.count - 1u;
        }
        else{
            start = current - 1u;
        }
    }
    else{
        if(current + 1u == choices.count){
            start = 0u;
        }
        else{
            start = current + 1u;
        }
    }
    return FindEnabledRadioGroupChoice(choices, start, reverse);
}

void ApplySkinPaletteToRadioGroupStyle(in UiSkinPalette palette, mut RadioGroupStyle style){
    style.hoverTint = ResolveUiSkinColor(palette, UiSkinColorRole::ControlHoverTint);
    style.pressedTint = ResolveUiSkinColor(palette, UiSkinColorRole::ControlPressedTint);
    style.disabledTint = ResolveUiSkinColor(palette, UiSkinColorRole::ControlDisabledTint);
}

b8 IsValidRadioGroupMetrics(in RadioGroupMetrics metrics){
    if(
        metrics.count > s_RadioGroupMaxChoices
        || !IsValidUiPadding(metrics.padding)
        || !isFinite(metrics.rowHeight) || metrics.rowHeight <= 0.0f
        || !isFinite(metrics.indicatorExtent) || metrics.indicatorExtent <= 0.0f
        || metrics.indicatorExtent > metrics.rowHeight
        || !isFinite(metrics.gap) || metrics.gap < 0.0f
        || !isFinite(metrics.rowGap) || metrics.rowGap < 0.0f
        || !IsValidUiExtent(metrics.contentSize)
        || !isFinite(metrics.markInset) || metrics.markInset < 0.0f || cast<f64>(metrics.markInset) > s_RadioGroupMaxMarkInsetF64
    )
        return false;
    const f64 padW = cast<f64>(metrics.padding.left) + cast<f64>(metrics.padding.right);
    const f64 padH = cast<f64>(metrics.padding.top) + cast<f64>(metrics.padding.bottom);
    u32 gapCount = 0u;
    if(metrics.count != 0u)
        gapCount = metrics.count - 1u;
    const f64 rowsH = cast<f64>(metrics.count) * cast<f64>(metrics.rowHeight) + cast<f64>(gapCount) * cast<f64>(metrics.rowGap);
    f64 labelW = 0.0;
    if(metrics.count != 0u)
        labelW = cast<f64>(metrics.indicatorExtent) + cast<f64>(metrics.gap);
    const f64 minimumWidth = padW + labelW;
    const f64 height = padH + rowsH;
    return height <= s_UiMaxFloatF64
        && cast<f64>(metrics.contentSize.y) == cast<f64>(cast<f32>(height))
        && minimumWidth <= s_UiMaxFloatF64
        && cast<f64>(metrics.contentSize.x) >= cast<f64>(cast<f32>(minimumWidth));
}

b8 TryMeasureRadioGroup(in u32 count, in Point maximumLabel, in RadioGroupOptions options, in RadioGroupStyle style, mut RadioGroupMetrics outMetrics){
    outMetrics = RadioGroupMetrics();
    if(
        count > s_RadioGroupMaxChoices
        || !IsValidUiExtent(maximumLabel)
        || !IsValidUiPadding(style.padding)
        || !IsValidLayoutSize(options.width)
        || !isFinite(style.indicatorExtent) || style.indicatorExtent <= 0.0f
        || !isFinite(style.gap) || style.gap < 0.0f
        || !isFinite(style.rowGap) || style.rowGap < 0.0f
        || !isFinite(style.markInset) || style.markInset < 0.0f || style.markInset > s_RadioGroupMaxMarkInset
        || !IsValidUiColor(style.hoverTint) || !IsValidUiColor(style.pressedTint) || !IsValidUiColor(style.disabledTint)
    )
        return false;
    RadioGroupMetrics candidate;
    candidate.rowHeight = max(maximumLabel.y, style.indicatorExtent);
    candidate.indicatorExtent = style.indicatorExtent;
    candidate.gap = style.gap;
    candidate.rowGap = style.rowGap;
    candidate.markInset = style.markInset;
    candidate.padding = style.padding;
    candidate.count = count;
    const f64 padW = cast<f64>(style.padding.left) + cast<f64>(style.padding.right);
    const f64 padH = cast<f64>(style.padding.top) + cast<f64>(style.padding.bottom);
    u32 gapCount = 0u;
    if(count != 0u)
        gapCount = count - 1u;
    const f64 rowsH = cast<f64>(count) * cast<f64>(candidate.rowHeight) + cast<f64>(gapCount) * cast<f64>(style.rowGap);
    f64 labelW = 0.0;
    if(count != 0u)
        labelW = (cast<f64>(style.indicatorExtent) + cast<f64>(style.gap)) + cast<f64>(maximumLabel.x);
    const f64 width = padW + labelW;
    const f64 height = padH + rowsH;
    if(!isFinite(width) || width > s_UiMaxFloatF64 || !isFinite(height) || height > s_UiMaxFloatF64)
        return false;
    candidate.contentSize = Point(cast<f32>(width), cast<f32>(height));
    if(!IsValidRadioGroupMetrics(candidate))
        return false;
    outMetrics = candidate;
    return true;
}

b8 TryPlaceRadioGroup(in Rect bounds, in Rect clip, in RadioGroupChoices choices, in RadioGroupMetrics metrics, mut RadioGroupPlacement outPlacement){
    outPlacement = RadioGroupPlacement();
    if(!IsValidUiRect(bounds) || !IsValidUiRect(clip) || !IsValidRadioGroupMetrics(metrics) || choices.count != metrics.count)
        return false;
    RadioGroupPlacement candidate;
    candidate.bounds = bounds;
    candidate.count = choices.count;
    if(!TryIntersectUiRects(bounds, clip, UiRectPrecision::PreciseExtents, candidate.clip))
        return false;
    const f64x4 insetRect = ComputeInsetUiRectBounds(bounds, metrics.padding);
    if(!TryMakeUiRect(insetRect.x, insetRect.y, insetRect.z, insetRect.w, UiRectPrecision::PreciseExtents, candidate.content))
        return false;
    const f64 contentX = insetRect.x;
    const f64 contentY = insetRect.y;
    const f64 contentW = insetRect.z;
    const f64 indicatorExtentScalar = min(cast<f64>(metrics.indicatorExtent), contentW);
    const f64 labelOffset = min(contentW, indicatorExtentScalar + cast<f64>(metrics.gap));
    const f64 markInsetScalar = indicatorExtentScalar * cast<f64>(metrics.markInset);
    const f64 rowHeightScalar = cast<f64>(metrics.rowHeight);
    for(u32 index = 0u; index < candidate.count; ++index){
        if(choices.rows[index].key == 0u)
            return false;
        for(u32 previous = 0u; previous < index; ++previous){
            if(choices.rows[previous].key == choices.rows[index].key)
                return false;
        }
        RadioGroupChoicePlacement row;
        row.key = choices.rows[index].key;
        row.enabled = choices.rows[index].enabled;
        const f64 rowOffset = cast<f64>(index) * (rowHeightScalar + cast<f64>(metrics.rowGap));
        const f64 rowOriginScalar = contentY + rowOffset;
        const f64 indicatorSpace = rowHeightScalar - indicatorExtentScalar;
        const f64 indicatorYScalar = rowOriginScalar + (indicatorSpace * 0.5);
        if(!TryMakeUiRect(contentX, rowOriginScalar, contentW, rowHeightScalar, UiRectPrecision::PreciseExtents, row.rectangle))
            return false;
        if(!TryIntersectUiRects(row.rectangle, candidate.clip, UiRectPrecision::PreciseExtents, row.clip))
            return false;
        if(!TryMakeUiRect(contentX, indicatorYScalar, indicatorExtentScalar, indicatorExtentScalar, UiRectPrecision::PreciseExtents, row.indicator))
            return false;
        const f64 markX = contentX + markInsetScalar;
        const f64 markY = indicatorYScalar + markInsetScalar;
        const f64 markExtent = indicatorExtentScalar - cast<f64>(s_CheckmarkInsetSides) * markInsetScalar;
        if(!TryMakeUiRect(markX, markY, markExtent, markExtent, UiRectPrecision::PreciseExtents, row.mark))
            return false;
        Rect labelRect;
        if(!TryMakeUiRect(contentX + labelOffset, rowOriginScalar, contentW - labelOffset, rowHeightScalar, UiRectPrecision::PreciseExtents, labelRect))
            return false;
        if(!TryIntersectUiRects(labelRect, row.clip, UiRectPrecision::PreciseExtents, row.textClip))
            return false;
        candidate.rows[index] = row;
    }
    outPlacement = candidate;
    return true;
}

Expected<RadioGroupMetrics> MeasureRadioGroup(in u32 count, in Point maximumLabel, in RadioGroupOptions options, in RadioGroupStyle style){
    RadioGroupMetrics candidate;
    if(!TryMeasureRadioGroup(count, maximumLabel, options, style, candidate))
        return makeUnexpected(Failure());
    return candidate;
}

Expected<RadioGroupPlacement> PlaceRadioGroup(in Rect bounds, in Rect clip, in RadioGroupChoices choices, in RadioGroupMetrics metrics){
    RadioGroupPlacement candidate;
    if(!TryPlaceRadioGroup(bounds, clip, choices, metrics, candidate))
        return makeUnexpected(Failure());
    return candidate;
}

void ReconcileRadioGroupSelectionAndCursor(
    in RadioGroupSnapshot snapshot,
    in RadioGroupChoices candidate,
    mut u64 outSelected,
    mut u64 outCursor
){
    const b8 replacement = snapshot.sourceGeneration != 0u && snapshot.sourceGeneration != candidate.sourceGeneration;
    u64 selected = snapshot.selectedKey;
    u64 cursor = snapshot.cursorKey;
    if(replacement){
        selected = 0u;
        cursor = 0u;
    }
    u32 selectedIndex = 0u;
    if(!TryFindRadioGroupChoice(candidate, selected, selectedIndex))
        selected = 0u;
    u32 cursorIndex = 0u;
    if(!TryFindRadioGroupChoice(candidate, cursor, cursorIndex))
        cursor = FindEnabledRadioGroupChoice(candidate, 0u, false);
    else if(!candidate.rows[cursorIndex].enabled){
        u32 nextStart = cursorIndex + 1u;
        if(nextStart == candidate.count)
            nextStart = 0u;
        cursor = FindEnabledRadioGroupChoice(candidate, nextStart, false);
    }
    outSelected = selected;
    outCursor = cursor;
}

b8 TryApplyRadioGroupControlAction(
    in RadioGroupChoices choices,
    in RadioGroupOptions options,
    in ControlAction action,
    in ControlToken stateToken,
    in u64 currentSelected,
    in u64 currentCursor,
    mut u64 outSelected,
    mut u64 outCursor,
    mut RadioGroupResult inOutResult
){
    outSelected = currentSelected;
    outCursor = currentCursor;
    if(
        !IsValidRadioGroupOptions(options) || !IsValidRadioGroupChoices(choices)
        || !stateToken.valid() || stateToken != action.control
        || choices.sourceGeneration != stateToken.contentGeneration || choices.sourceRevision != stateToken.contentRevision
    )
        return false;
    u64 candidate = 0u;
    b8 activate = false;
    switch(action.kind){
    case ControlActionKind::Up:
    case ControlActionKind::Down:
    case ControlActionKind::Left:
    case ControlActionKind::Right:
    case ControlActionKind::Home:
    case ControlActionKind::End:
        candidate = ResolveRadioGroupNavigationTarget(choices, currentCursor, action.kind);
        break;
    case ControlActionKind::Submit:
    case ControlActionKind::Activate:{
        candidate = currentCursor;
        if(action.kind == ControlActionKind::Activate)
            candidate = action.value;
        u32 index = 0u;
        if(!TryFindRadioGroupChoice(choices, candidate, index) || !choices.rows[index].enabled){
            if(action.kind == ControlActionKind::Activate)
                return false;
            candidate = 0u;
        }
        activate = candidate != 0u;
        break;
    }
    case ControlActionKind::Wheel:
    case ControlActionKind::PageUp:
    case ControlActionKind::PageDown:
        break;
    default:
        return false;
    }
    RadioGroupResult candidateResult = inOutResult;
    candidateResult.valid = true;
    if(candidate != 0u){
        candidateResult.selectionChanged = candidateResult.selectionChanged || currentSelected != candidate;
        candidateResult.activated = candidateResult.activated || activate;
        outSelected = candidate;
        outCursor = candidate;
    }
    inOutResult = candidateResult;
    return true;
}


