enum<u8> RayTraceReadTokenStatus{
    Retired = 0u,
    Pending = 1u,
    kCount
}

b8 ShouldAdvanceRayTraceReadToken(in b8 previousValid, in b8 matchesQueue, in u64 tokenValue, in u64 previousValue){
    return !previousValid || !matchesQueue || tokenValue > previousValue;
}

RayTraceReadTokenStatus ClassifyRayTraceReadTokenStatus(
    in b8 matchesQueueIdentity,
    in b8 hasCompletedValue,
    in u64 completedValue,
    in u64 tokenValue
){
    if(!matchesQueueIdentity)
        return RayTraceReadTokenStatus::Retired;
    if(hasCompletedValue && completedValue >= tokenValue)
        return RayTraceReadTokenStatus::Retired;
    return RayTraceReadTokenStatus::Pending;
}


