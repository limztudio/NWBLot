type ReadbackQueueToken = QueueSubmissionToken;
type AvboitGeometryResourceSetId = GpuGraphResourceSetId;
type AvboitGraphResourceId = GpuGraphResourceId;
type AvboitGraphTaskId = GpuTaskId;
type CausticGraphTaskId = GpuTaskId;
type CausticGraphResourceId = GpuGraphResourceId;
type CausticLabelView = StringView;
type CausticStageShaderHandle = ShaderHandle;
type CausticStagePipelineHandle = ComputePipelineHandle;
type CsgGraphTaskId = GpuTaskId;
type CsgGraphResourceSetId = GpuGraphResourceSetId;
type DeferredTailGpuTaskId = GpuTaskId;
type DeferredGraphResourceId = GpuGraphResourceId;
