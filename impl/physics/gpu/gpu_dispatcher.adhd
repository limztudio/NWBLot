    public PhysicsGpuDispatcher(){
        this.m_graphics = Optional<mut GraphicsRuntime>();
        this.m_assetManager = Optional<mut AssetManager>();
        this.m_shaderPathResolver = ShaderArchivePathResolver();
        this.m_activeSceneSubsystems = ActiveSceneSubsystemsRef();
    }

    public PhysicsGpuDispatcher(
        mut GraphicsRuntime graphics,
        mut AssetManager assetManager,
        in ShaderArchivePathResolver shaderPathResolver
    ){
        this.m_graphics = Optional<mut GraphicsRuntime>(graphics);
        this.m_assetManager = Optional<mut AssetManager>(assetManager);
        this.m_shaderPathResolver = shaderPathResolver;
        this.m_activeSceneSubsystems = ActiveSceneSubsystemsRef();
    }

    public ~PhysicsGpuDispatcher(){
        this.invalidateResources();
    }

    public void attachRuntime(
        mut GraphicsRuntime graphics,
        mut AssetManager assetManager,
        in ShaderArchivePathResolver shaderPathResolver
    ){
        this.invalidateResources();
        this.m_graphics = Optional<mut GraphicsRuntime>(graphics);
        this.m_assetManager = Optional<mut AssetManager>(assetManager);
        this.m_shaderPathResolver = shaderPathResolver;
    }

    public void setActiveSceneSubsystems(in ActiveSceneSubsystemsRef subsystems){
        this.m_activeSceneSubsystems = subsystems;
    }

    public b8 isReady()const{
        return this.m_graphics.has_value() && this.m_assetManager.has_value() && this.m_pipelinesReady;
    }

    private Name resolveShaderAssetName(in u32 shaderIndex)const{
        if(!this.m_activeSceneSubsystems.has_value())
            return s_NameNone;
        const auto sub = this.m_activeSceneSubsystems.value().findSubsystem<PhysicsSubsystem>();
        if(!sub.has_value())
            return s_NameNone;
        in PhysicsSubsystem phys = sub.value();
        if(shaderIndex == 0u)
            return phys.broadphaseAabbCs.name();
        if(shaderIndex == 1u)
            return phys.narrowphaseCs.name();
        if(shaderIndex == 2u)
            return phys.solverIntegrateVelocitiesCs.name();
        if(shaderIndex == 3u)
            return phys.solverContactsCs.name();
        if(shaderIndex == 4u)
            return phys.solverIntegratePositionsCs.name();
        if(shaderIndex == 5u)
            return phys.solverFinalizeBodiesCs.name();
        if(shaderIndex == 6u)
            return phys.solverJointsCs.name();
        if(shaderIndex == 7u)
            return phys.solverIslandsCs.name();
        if(shaderIndex == 8u)
            return phys.solverJointIslandsCs.name();
        if(shaderIndex == 9u)
            return phys.lbvhBroadphaseCs.name();
        if(shaderIndex == 10u)
            return phys.gpuResidentStepCs.name();
        if(shaderIndex == 11u)
            return phys.spatialQueryCs.name();
        if(shaderIndex == 12u)
            return phys.exportRenderTransformsCs.name();
        if(shaderIndex == 13u)
            return phys.gpuResidentContactPrepCs.name();
        return phys.gpuSubsystemsCs.name();
    }

    private void resetStaticGeomSlotCaches(){
        this.m_staticGeomValid = false;
        this.m_cachedHullData.clear();
        this.m_cachedMeshNodes.clear();
        this.m_cachedMeshTris.clear();
        this.m_cachedHullValid.clear();
        this.m_cachedHullGen.clear();
        this.m_cachedHullOffset.clear();
        this.m_cachedHullMeta.clear();
        this.m_cachedHullVec4Count.clear();
        this.m_cachedMeshValid.clear();
        this.m_cachedMeshGen.clear();
        this.m_cachedMeshNodeBase.clear();
        this.m_cachedMeshTriBase.clear();
        this.m_cachedMeshNodeVec4Count.clear();
        this.m_cachedMeshTriVec4Count.clear();
        this.m_cachedHfValid.clear();
        this.m_cachedHfGen.clear();
        this.m_cachedHfOffset.clear();
        this.m_cachedHfMeta.clear();
        this.m_cachedHfVec4Count.clear();
        this.m_deadHullVec4Count = 0u;
        this.m_deadMeshNodeVec4Count = 0u;
        this.m_deadMeshTriVec4Count = 0u;
        this.m_hullUploadedCount = 0u;
        this.m_meshNodeUploadedCount = 0u;
        this.m_meshTriUploadedCount = 0u;
    }

    private void resetToiPackScratch(in usize bodyCount, in usize shapeCount, in usize totalPairCount){
        this.m_toiBodyToSlotScratch.clear();
        this.m_toiBodyToSlotScratch.resize(bodyCount, s_NullIndex);
        this.m_toiShapeToSlotScratch.clear();
        this.m_toiShapeToSlotScratch.resize(shapeCount, s_NullIndex);
        this.m_gpuSimsScratch.clear();
        this.m_gpuShapesScratch.clear();
        this.m_toiPairsScratch.clear();
        this.m_toiPairsScratch.reserve(totalPairCount);
    }

    private void packToiShapeSlot(in PhysicsWorld world, in u32 sId, in u32 bId){
        if(this.m_toiShapeToSlotScratch[sId] != s_NullIndex)
            return;
        this.m_toiShapeToSlotScratch[sId] = cast<u32>(this.m_gpuShapesScratch.size());
        u32 off = 0u;
        u32 meta = 0u;
        if(sId < this.m_shapeDataOffset.size()){
            off = this.m_shapeDataOffset[sId];
            meta = this.m_shapeDataMeta[sId];
        }
        in Shape sh = world.m_shapes[sId];
        VectorSingle localMin(0.0f);
        VectorSingle localMax(0.0f);
        ComputeShapeLocalAabbCachedValues(sh, world.m_hullShapes, world.m_hullLocalAabbs, world.m_meshShapes, world.m_heightfieldShapes, world.m_compoundShapes, world.m_scaledShapes, world.m_chainShapes, world.m_sdfShapes, localMin, localMax);
        this.m_gpuShapesScratch.push_back(PackGpuShapeProxyWithLocalBounds(sh, world.m_bodies[bId], world.m_hullShapes, world.m_meshShapes, world.m_heightfieldShapes, localMin, localMax, this.m_toiBodyToSlotScratch[bId], sId, s_MaxAabbMargin, off, meta, 0u));
    }

    private void packToiShapePairAndPush(in PhysicsWorld world, in u32 sIdA, in u32 sIdB, in u32 bIdA, in u32 bIdB){
        this.packToiShapeSlot(world, sIdA, bIdA);
        this.packToiShapeSlot(world, sIdB, bIdB);
        GpuPhysicsBroadphasePair pairOut;
        pairOut.indices = u32x4(this.m_toiShapeToSlotScratch[sIdA], this.m_toiShapeToSlotScratch[sIdB], this.m_toiBodyToSlotScratch[bIdA], this.m_toiBodyToSlotScratch[bIdB]);
        this.m_toiPairsScratch.push_back(pairOut);
    }

    private b8 copySlotToReadbackAndSync(
        mut GraphicsRuntime graphics,
        mut Device device,
        in Name rbName,
        in u32 elementStride,
        in u32 elementCount,
        mut PhysicsGpuBufferSlot slot
    ){
        if(elementCount == 0u)
            return true;
        if(!this.ensureComputeReadbackBuffer(graphics, device, rbName, elementStride, elementCount, slot))
            return false;
        if(!this.ensureComputeCommandList(device))
            return false;
        mut CommandList commands = this.m_computeCommandLists[this.m_computeCmdCursor].deref();
        commands.open();
        commands.setEnableAutomaticBarriers(false);
        commands.setBufferState(slot.buffer.deref(), ResourceStates::CopySource);
        commands.setBufferState(slot.readback.deref(), ResourceStates::CopyDest);
        commands.commitBarriers();
        commands.copyBuffer(slot.readback.deref(), 0u, slot.buffer.deref(), 0u, cast<u64>(elementCount) * cast<u64>(elementStride));
        commands.setBufferState(slot.buffer.deref(), ResourceStates::UnorderedAccess);
        commands.commitBarriers();
        const auto token = this.submitComputeCommandList(device, commands, !commands.commandRecordingFailed());
        if(!token.has_value())
            return false;
        return this.waitForLastCompute(device);
    }

    private b8 ensureToiDispatchBuffersAndBuildGroup(
        mut GraphicsRuntime graphics,
        mut Device device,
        mut GpuDescriptorHeap heap,
        in u32 toiBodyCount,
        in u32 toiShapeCount,
        in u32 toiPairCount,
        in u32 bulletMetaCount,
        in b8 needManifoldReadback,
        mut PhysicsGpuBufferGroup outToiBufs
    ){
        if(!this.ensureComputeStorageBuffer(graphics, device, heap, Name("physics/gpu/toi_body_sims"), s_GpuBodySimBytes, toiBodyCount, false, false, this.m_toiBodySimSlot))
            return false;
        if(!this.ensureComputeStorageBuffer(graphics, device, heap, Name("physics/gpu/toi_shapes"), s_GpuShapeProxyBytes, toiShapeCount, false, false, this.m_toiShapeSlot))
            return false;
        if(!this.ensureComputeStorageBuffer(graphics, device, heap, Name("physics/gpu/toi_pairs"), s_GpuBroadphasePairBytes, toiPairCount, false, false, this.m_toiPairSlot))
            return false;
        if(!this.ensureComputeStorageBuffer(graphics, device, heap, Name("physics/gpu/toi_manifolds"), s_GpuNarrowphaseManifoldBytes, toiPairCount, false, false, this.m_toiManifoldSlot))
            return false;
        if(needManifoldReadback){
            if(!this.ensureComputeReadbackBuffer(graphics, device, Name("physics/gpu/toi_manifolds_rb"), s_GpuNarrowphaseManifoldBytes, toiPairCount, this.m_toiManifoldSlot))
                return false;
        }
        if(bulletMetaCount > 0u){
            if(!this.ensureComputeStorageBuffer(graphics, device, heap, Name("physics/gpu/res_bullet_meta"), cast<u32>(size_of<u32x4>()), bulletMetaCount, false, false, this.m_resBulletMetaSlot))
                return false;
        }

        outToiBufs.bodySimBuffer = this.m_toiBodySimSlot.buffer;
        outToiBufs.shapeBuffer = this.m_toiShapeSlot.buffer;
        outToiBufs.pairBuffer = this.m_toiPairSlot.buffer;
        outToiBufs.hullVertexBuffer = this.m_hullVertexSlot.buffer;
        outToiBufs.meshNodeBuffer = this.m_meshNodeSlot.buffer;
        outToiBufs.meshTriBuffer = this.m_meshTriSlot.buffer;
        outToiBufs.manifoldBuffer = this.m_toiManifoldSlot.buffer;
        if(needManifoldReadback)
            outToiBufs.manifoldReadback = this.m_toiManifoldSlot.readback;
        outToiBufs.slots0 = u32x4(
            this.m_toiBodySimSlot.descriptor.slot(),
            this.m_meshNodeSlot.descriptor.slot(),
            this.m_toiShapeSlot.descriptor.slot(),
            this.m_meshTriSlot.descriptor.slot()
        );
        outToiBufs.slots1 = u32x4(
            this.m_toiPairSlot.descriptor.slot(),
            s_NullIndex,
            s_NullIndex,
            s_NullIndex
        );
        outToiBufs.slots2 = u32x4(
            s_NullIndex,
            this.m_hullVertexSlot.descriptor.slot(),
            this.m_toiManifoldSlot.descriptor.slot(),
            s_NullIndex
        );
        return true;
    }

    private b8 retryCollisionDispatchAndReadback(
        mut PhysicsWorld world,
        mut Device device,
        mut GpuDescriptorHeap heap,
        in PhysicsGpuBufferGroup colBufs,
        in u32 staticBodyCount,
        in u32 awakeBodyOffset,
        in u32 staticShapeCount,
        in u32 awakeShapeOffset,
        in u32 awakeShapeCount,
        in u32 shapeCount,
        in u32 maxPairs,
        in u32 gridTableSize,
        in f32 invCellSize,
        in b8 useLbvh,
        in u32 lbvhPaddedCount,
        in VectorSingle lbvhSceneMin,
        in VectorSingle lbvhInvExtent,
        in b8 hasComplexShapes,
        in b8 secondAttempt,
        mut u32 outRawPairCount,
        mut b8 outBufferOverflow
    ){
        outBufferOverflow = false;
        const Timer tSubmitStart = TimerNow();
        const auto token = this.submitCollisionAsync(
            device,
            heap,
            colBufs,
            Span<GpuPhysicsBodyPose>(),
            Span<GpuPhysicsBodyPose>(),
            Span<GpuPhysicsBodyPose>(),
            Span<GpuPhysicsShapeProxy>(),
            Span<GpuPhysicsShapeProxy>(),
            Span<GpuPhysicsShapeProxy>(),
            Span<f32x4>(),
            Span<f32x4>(),
            Span<f32x4>(),
            Span<u32>(),
            0u,
            0u,
            0u,
            staticBodyCount,
            awakeBodyOffset,
            staticShapeCount,
            awakeShapeOffset,
            awakeShapeCount,
            shapeCount,
            0u,
            0u,
            maxPairs,
            gridTableSize,
            invCellSize,
            useLbvh,
            lbvhPaddedCount,
            lbvhSceneMin,
            lbvhInvExtent,
            false,
            hasComplexShapes,
            secondAttempt
        );
        if(!token.has_value())
            return false;
        const f32 dispatchMs = DurationInMS<f32>(TimerNow(), tSubmitStart);
        world.m_lastStats.gpuDispatchMs += dispatchMs;
        b8 stackOverflow = false;
        const Timer tReadStart = TimerNow();
        const Expected<u32> pairCountRes = this.readbackCollisionResults(device, token.value(), maxPairs, this.m_gpuManifoldsScratch, stackOverflow, outBufferOverflow);
        const f32 readMs = DurationInMS<f32>(TimerNow(), tReadStart);
        world.m_lastStats.gpuReadbackMs += readMs;
        world.m_lastStats.broadphaseMs += dispatchMs + readMs;
        if(!pairCountRes.has_value() || stackOverflow)
            return false;
        outRawPairCount = pairCountRes.value();
        return true;
    }

    private b8 recordAndSubmitRenderTransformExport(
        mut GraphicsRuntime graphics,
        mut Device device,
        mut GpuDescriptorHeap heap,
        in u32 totalActive,
        mut BufferHandle targetBuffer,
        in u32 targetUavSlot,
        in u32 exportMode,
        in u32 instanceStrideFloat4,
        in b8 waitCompletion,
        mut QueueSubmissionToken outToken
    ){
        if(!this.ensureExportRenderTransformsPipeline())
            return false;
        b8 needUploadBindings = false;
        b8 needUploadPoses = false;
        if(!this.ensureRenderExportBuffersAndFlags(graphics, device, heap, totalActive, needUploadBindings, needUploadPoses))
            return false;
        if(!this.ensureComputeCommandList(device))
            return false;
        PendingRecordingLease heapLease = heap.acquirePendingRecordingLease();
        if(!heapLease.valid())
            return false;

        const usize ringIdx = this.m_exportRingIndex;
        in PhysicsGpuBufferSlot activeBindSlot = this.m_renderBindingSlots[ringIdx];
        in PhysicsGpuBufferSlot activePoseSlot = this.m_exportPoseSlots[ringIdx];
        mut CommandList commands = this.m_computeCommandLists[this.m_computeCmdCursor].deref();
        commands.open();
        commands.setEnableAutomaticBarriers(false);
        u32 poseDescSlot = s_NullIndex;
        if(activePoseSlot.hasValidUav())
            poseDescSlot = activePoseSlot.descriptor.slot();
        u32 resOutDesc = s_NullIndex;
        u32 resSimDesc = s_NullIndex;
        if(this.m_bodyOutSlot.hasValidUav())
            resOutDesc = this.m_bodyOutSlot.descriptor.slot();
        if(this.m_solverBodySimSlot.hasValidUav())
            resSimDesc = this.m_solverBodySimSlot.descriptor.slot();

        const PhysicsExportRenderTransformsTask task(
            heap,
            this.m_exportRenderTransformsPipeline,
            activeBindSlot.buffer,
            targetBuffer,
            activePoseSlot.buffer,
            Span<GpuPhysicsRenderTransformBinding>(this.m_exportResBindingsScratch),
            Span<GpuPhysicsRenderTransformBinding>(this.m_exportPoseBindingsScratch),
            Span<GpuPhysicsBodyPose>(this.m_exportPosesScratch),
            activeBindSlot.descriptor.slot(),
            resOutDesc,
            resSimDesc,
            this.m_gpuResidentBodyCount,
            poseDescSlot,
            cast<u32>(this.m_exportPosesScratch.size()),
            targetUavSlot,
            exportMode,
            instanceStrideFloat4,
            needUploadBindings,
            needUploadPoses
        );
        const b8 recorded = task.recordCommands(commands);
        const auto token = this.submitComputeCommandList(device, commands, recorded);
        if(!token.has_value())
            return false;
        if(waitCompletion){
            if(!this.waitForLastCompute(device))
                return false;
        }
        else{
            outToken = token.value();
        }
        this.commitRenderExportCaches(needUploadBindings, needUploadPoses);
        return true;
    }

