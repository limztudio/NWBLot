void BuildPhysicsCookEntryIndexMap<T>(in Span<T> entries, mut HashMap<Name, usize> outMap){
    outMap.reserve(entries.size());
    for(usize i = 0u; i < entries.size(); ++i)
        outMap.insert_or_assign(entries[i].virtualPath, i);
}

b8 CheckScenePhysicsEntityName(
    in Name scenePath,
    in Name componentPath,
    in StringView fieldName,
    in Name targetName,
    in HashSet<NameHash> sceneEntityNames
){
    if(targetName == s_NameNone)
        return true;
    if(sceneEntityNames.find(targetName.hash()) != sceneEntityNames.end())
        return true;
    error(
        "Physics scene validation '{}': component '{}' field '{}' references unknown entity '{}'",
        scenePath.resolvedText(),
        componentPath.resolvedText(),
        fieldName,
        targetName.resolvedText()
    );
    return false;
}

b8 CheckScenePhysicsEntityNameList(
    in Name scenePath,
    in Name componentPath,
    in StringView fieldName,
    in Vector<Name> targetNames,
    in HashSet<NameHash> sceneEntityNames
){
    b8 allValid = true;
    for(usize i = 0u; i < targetNames.size(); ++i){
        if(!CheckScenePhysicsEntityName(scenePath, componentPath, fieldName, targetNames[i], sceneEntityNames))
            allValid = false;
    }
    return allValid;
}

b8 CheckSceneJointEntryEntityNames(
    in Name scenePath,
    in Name componentPath,
    in JointEntry joint,
    in HashSet<NameHash> sceneEntityNames
){
    b8 allValid = true;
    if(!CheckScenePhysicsEntityName(scenePath, componentPath, "body_entity_a", joint.bodyEntityNameA, sceneEntityNames))
        allValid = false;
    if(!CheckScenePhysicsEntityName(scenePath, componentPath, "body_entity_b", joint.bodyEntityNameB, sceneEntityNames))
        allValid = false;
    if(!CheckScenePhysicsEntityName(scenePath, componentPath, "reference_joint_entity_a", joint.referenceJointEntityNameA, sceneEntityNames))
        allValid = false;
    if(!CheckScenePhysicsEntityName(scenePath, componentPath, "reference_joint_entity_b", joint.referenceJointEntityNameB, sceneEntityNames))
        allValid = false;
    return allValid;
}

b8 ValidateScenePhysicsEntityReferencesWithCache(
    in Span<SceneCookEntry> scenes,
    in Span<EntityCookEntry> entities,
    in Span<RigidBodyComponentCookEntry> rigidBodies,
    in Span<ColliderComponentCookEntry> colliders,
    in Span<JointComponentCookEntry> joints,
    in Span<PhysicsParentComponentCookEntry> parents,
    in Span<VehicleComponentCookEntry> vehicles,
    in Span<RagdollComponentCookEntry> ragdolls,
    in Span<ArticulationComponentCookEntry> articulations,
    in Span<SoftBodyComponentCookEntry> softBodies,
    in Span<Name> cachedVirtualPaths,
    in b8 allowPartialEntityTable
){
    if(scenes.empty())
        return true;

    HashMap<Name, usize> entityMap;
    HashMap<Name, usize> rigidBodyMap;
    HashMap<Name, usize> colliderMap;
    HashMap<Name, usize> jointMap;
    HashMap<Name, usize> parentMap;
    HashMap<Name, usize> vehicleMap;
    HashMap<Name, usize> ragdollMap;
    HashMap<Name, usize> articulationMap;
    HashMap<Name, usize> softBodyMap;

    BuildPhysicsCookEntryIndexMap<EntityCookEntry>(entities, entityMap);
    BuildPhysicsCookEntryIndexMap<RigidBodyComponentCookEntry>(rigidBodies, rigidBodyMap);
    BuildPhysicsCookEntryIndexMap<ColliderComponentCookEntry>(colliders, colliderMap);
    BuildPhysicsCookEntryIndexMap<JointComponentCookEntry>(joints, jointMap);
    BuildPhysicsCookEntryIndexMap<PhysicsParentComponentCookEntry>(parents, parentMap);
    BuildPhysicsCookEntryIndexMap<VehicleComponentCookEntry>(vehicles, vehicleMap);
    BuildPhysicsCookEntryIndexMap<RagdollComponentCookEntry>(ragdolls, ragdollMap);
    BuildPhysicsCookEntryIndexMap<ArticulationComponentCookEntry>(articulations, articulationMap);
    BuildPhysicsCookEntryIndexMap<SoftBodyComponentCookEntry>(softBodies, softBodyMap);

    HashSet<NameHash> cachedPathSet;
    if(allowPartialEntityTable && !cachedVirtualPaths.empty()){
        cachedPathSet.reserve(cachedVirtualPaths.size());
        for(usize ci = 0u; ci < cachedVirtualPaths.size(); ++ci)
            cachedPathSet.insert(cachedVirtualPaths[ci].hash());
    }

    b8 allValid = true;
    for(usize sceneIdx = 0u; sceneIdx < scenes.size(); ++sceneIdx){
        in SceneCookEntry scene = scenes[sceneIdx];
        HashSet<NameHash> sceneEntityNames;
        Vector<usize> sceneEntityIndices;
        sceneEntityNames.reserve(scene.entities.size() * 2u);
        sceneEntityIndices.reserve(scene.entities.size());
        b8 skipScene = false;

        for(usize entRefIdx = 0u; entRefIdx < scene.entities.size(); ++entRefIdx){
            in EntityRef entRef = scene.entities[entRefIdx];
            const auto entIt = entityMap.find(entRef.name());
            if(entIt == entityMap.end()){
                if(allowPartialEntityTable){
                    skipScene = true;
                    break;
                }
                error("Physics scene validation '{}': references unknown entity '{}'", scene.virtualPath.resolvedText(), entRef.name().resolvedText());
                allValid = false;
                continue;
            }
            const usize ei = entIt.value();
            sceneEntityIndices.push_back(ei);
            in EntityCookEntry ent = entities[ei];
            if(ent.name != s_NameNone)
                sceneEntityNames.insert(ent.name.hash());
            for(usize ci = 0u; ci < ent.components.size(); ++ci){
                const Name compPath = ent.components[ci].name();
                if(allowPartialEntityTable && !cachedPathSet.empty() && cachedPathSet.find(compPath.hash()) != cachedPathSet.end()){
                    skipScene = true;
                    break;
                }
                const auto rbIt = rigidBodyMap.find(compPath);
                if(rbIt != rigidBodyMap.end()){
                    in RigidBodyComponent rb = rigidBodies[rbIt.value()].component;
                    if(rb.entityTag != s_NameNone)
                        sceneEntityNames.insert(rb.entityTag.hash());
                }
                const auto colIt = colliderMap.find(compPath);
                if(colIt != colliderMap.end()){
                    in ColliderComponent col = colliders[colIt.value()].component;
                    if(col.entityTag != s_NameNone)
                        sceneEntityNames.insert(col.entityTag.hash());
                }
            }
            if(skipScene)
                break;
        }
        if(skipScene)
            continue;

        for(usize si = 0u; si < sceneEntityIndices.size(); ++si){
            in EntityCookEntry ent = entities[sceneEntityIndices[si]];
            for(usize ci = 0u; ci < ent.components.size(); ++ci){
                const Name compPath = ent.components[ci].name();

                const auto jIt = jointMap.find(compPath);
                if(jIt != jointMap.end()){
                    in JointComponent jc = joints[jIt.value()].component;
                    if(!CheckSceneJointEntryEntityNames(scene.virtualPath, compPath, jc.primaryJoint, sceneEntityNames))
                        allValid = false;
                    for(usize ji = 0u; ji < jc.extraJoints.size(); ++ji){
                        if(!CheckSceneJointEntryEntityNames(scene.virtualPath, compPath, jc.extraJoints[ji], sceneEntityNames))
                            allValid = false;
                    }
                }

                const auto pIt = parentMap.find(compPath);
                if(pIt != parentMap.end()){
                    in PhysicsParentComponent pc = parents[pIt.value()].component;
                    if(!CheckScenePhysicsEntityName(scene.virtualPath, compPath, "parent_entity_name", pc.parentEntityName, sceneEntityNames))
                        allValid = false;
                }

                const auto vIt = vehicleMap.find(compPath);
                if(vIt != vehicleMap.end()){
                    in VehicleComponent vc = vehicles[vIt.value()].component;
                    if(!CheckScenePhysicsEntityNameList(scene.virtualPath, compPath, "wheel_entity_names", vc.wheelEntityNames, sceneEntityNames))
                        allValid = false;
                    if(!CheckScenePhysicsEntityName(scene.virtualPath, compPath, "skeleton_entity_name", vc.skeletonEntityName, sceneEntityNames))
                        allValid = false;
                    if(!CheckScenePhysicsEntityName(scene.virtualPath, compPath, "trailer_entity_name", vc.trailerEntityName, sceneEntityNames))
                        allValid = false;
                }

                const auto rIt = ragdollMap.find(compPath);
                if(rIt != ragdollMap.end()){
                    in RagdollComponent rc = ragdolls[rIt.value()].component;
                    if(!CheckScenePhysicsEntityNameList(scene.virtualPath, compPath, "bone_entity_names", rc.boneEntityNames, sceneEntityNames))
                        allValid = false;
                    if(!CheckScenePhysicsEntityName(scene.virtualPath, compPath, "skeleton_entity_name", rc.skeletonEntityName, sceneEntityNames))
                        allValid = false;
                }

                const auto aIt = articulationMap.find(compPath);
                if(aIt != articulationMap.end()){
                    in ArticulationComponent ac = articulations[aIt.value()].component;
                    if(!CheckScenePhysicsEntityNameList(scene.virtualPath, compPath, "proxy_entity_names", ac.proxyEntityNames, sceneEntityNames))
                        allValid = false;
                    if(!CheckScenePhysicsEntityNameList(scene.virtualPath, compPath, "link_entity_names", ac.linkEntityNames, sceneEntityNames))
                        allValid = false;
                    if(!CheckScenePhysicsEntityName(scene.virtualPath, compPath, "skeleton_entity_name", ac.skeletonEntityName, sceneEntityNames))
                        allValid = false;
                }

                const auto sbIt = softBodyMap.find(compPath);
                if(sbIt != softBodyMap.end()){
                    in SoftBodyComponent sbc = softBodies[sbIt.value()].component;
                    if(!CheckScenePhysicsEntityNameList(scene.virtualPath, compPath, "attachment_body_entity_names", sbc.attachmentBodyEntityNames, sceneEntityNames))
                        allValid = false;
                }
            }
        }
    }
    return allValid;
}

b8 ValidateScenePhysicsEntityReferences(
    in Span<SceneCookEntry> scenes,
    in Span<EntityCookEntry> entities,
    in Span<RigidBodyComponentCookEntry> rigidBodies,
    in Span<ColliderComponentCookEntry> colliders,
    in Span<JointComponentCookEntry> joints,
    in Span<PhysicsParentComponentCookEntry> parents,
    in Span<VehicleComponentCookEntry> vehicles,
    in Span<RagdollComponentCookEntry> ragdolls,
    in Span<ArticulationComponentCookEntry> articulations,
    in Span<SoftBodyComponentCookEntry> softBodies,
    in b8 allowPartialEntityTable
){
    return ValidateScenePhysicsEntityReferencesWithCache(
        scenes,
        entities,
        rigidBodies,
        colliders,
        joints,
        parents,
        vehicles,
        ragdolls,
        articulations,
        softBodies,
        Span<Name>(),
        allowPartialEntityTable
    );
}


