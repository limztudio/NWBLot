[cook_entry("component", s_PhysicsWorldConfigComponentDiagnosticPrefix, ParsePhysicsWorldConfigComponentCookMetadata, document_and_value, log_failure, PhysicsWorldConfigComponentCodec)]
Expected<PhysicsWorldConfigComponentAsset> CookPhysicsWorldConfigComponentVolumeEntry(in PhysicsWorldConfigComponentCookEntry entry){
    return BuildComponentAssetFromEntry<PhysicsWorldConfigComponentAsset, PhysicsWorldConfigComponentCookEntry>(entry);
}

b8 ExtractPhysicsWorldConfigComponentDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    const Expected<PhysicsWorldConfigComponentCookEntry> entry = ReadCookDependencyEntry<PhysicsWorldConfigComponentCookEntry>(context, s_PhysicsWorldConfigComponentDiagnosticPrefix, ParsePhysicsWorldConfigComponentCookMetadata);
    if(!entry.has_value())
        return false;
    in AssetRef<CollisionLayerMatrixAsset> matrixAsset = entry.value().component.collisionLayerMatrixAsset;
    if(matrixAsset.valid() && !collector.addAssetDependency(matrixAsset.name(), CollisionLayerMatrixAsset::AssetTypeName()))
        return false;
    return true;
}

