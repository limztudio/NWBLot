class MaterialPolicyRejectionCase{
    public StringView m_metaText;
    public StringView m_diagnostic;

    public MaterialPolicyRejectionCase(in StringView metaText, in StringView diagnostic){
        this.m_metaText = metaText;
        this.m_diagnostic = diagnostic;
    }
}

class MeshIndexDiagnosticCase{
    public StringView m_indices;
    public StringView m_diagnostic;

    public MeshIndexDiagnosticCase(in StringView indices, in StringView diagnostic){
        this.m_indices = indices;
        this.m_diagnostic = diagnostic;
    }
}

class ObjectGeometryCase{
    public StringView m_shaderType;
    public StringView m_fields;
    public b8 m_accepted;

    public ObjectGeometryCase(in StringView shaderType, in StringView fields, in b8 accepted){
        this.m_shaderType = shaderType;
        this.m_fields = fields;
        this.m_accepted = accepted;
    }
}

b8 CookAndLoadSmokeMeshInto(in StringView assetFilename, in Name assetName, in CookCase cookCase, mut TestArena testArena, mut MeshAsset outMesh){
    const b8 cooked = CookSmokeAssetMeta("meshes", assetFilename, cookCase, testArena);
    EXPECT_TRUE(cooked);
    if(!cooked)
        return false;
    Expected<MeshAsset> loaded = LoadCookedMeshAsset(testArena, cookCase.outputDirectory, assetName, 1u);
    if(!loaded.has_value())
        return false;
    outMesh = loaded.value();
    return true;
}

TestAString BuildMeshIndexMeta(in StringView indexList){
    const usize indexFieldOffset = s_MinimalMeshMeta.find("asset.indices");
    TestAString meta = TestAString();
    meta.append(s_MinimalMeshMeta.substr(0u, indexFieldOffset));
    meta.append("asset.indices = ");
    AppendTestMeta(indexList, meta);
    meta.append(";\n");
    return meta;
}

void ExpectMeshCookFailure(in StringView metaText, in StringView caseName, mut TestArena testArena){
    const Expected<CookCase> cookCase = PrepareCookCase(testArena, caseName);
    ASSERT_TRUE(cookCase.has_value());
    const CookCase prepared = cookCase.value();
    EXPECT_FALSE(CookSingleMeshMeta(metaText, prepared, testArena));
    EXPECT_TRUE(RemoveAllIfExists(prepared.root));
}

void ExpectMaterialBindParseFailure(in StringView bindText, in StringView caseName, in StringView expectedError, mut TestArena testArena, mut ScratchArena scratchArena){
    const ScopedTestTrace trace(caseName);
    const Expected<GraphicsTestPath> invalidRootResult = PrepareCaseRoot(testArena, caseName);
    ASSERT_TRUE(invalidRootResult.has_value());
    const GraphicsTestPath invalidRoot = invalidRootResult.value();
    {
        CapturingLogger failureLogger = CapturingLogger();
        LoggerRegistrationGuard failureLoggerGuard(failureLogger, s_ReportOnly);

        EXPECT_FALSE(ParseTestMaterialBindFromText(bindText, invalidRoot, testArena, scratchArena).has_value());
        EXPECT_TRUE(SawCapturedError(failureLogger, expectedError));
    }
    EXPECT_TRUE(RemoveAllIfExists(invalidRoot));
}

void VerifyAssetsGraphics_ResourceParameterCandidateRejectsExpressionsButPreservesBytes(){
    EXPECT_FALSE(IsMaterialResourceParameterCandidate(""));
    EXPECT_FALSE(IsMaterialResourceParameterCandidate("project/value("));
    EXPECT_FALSE(IsMaterialResourceParameterCandidate("project/value)"));
    EXPECT_TRUE(IsMaterialResourceParameterCandidate("project/value"));
    EXPECT_TRUE(IsMaterialResourceParameterCandidate(EmbeddedNulMaterialResourceCandidate()));
}

void VerifyAssetsGraphics_MaterialCookAdmissionRejectsMissingInputsAndCountOverflow(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
    EXPECT_FALSE(ValidateMaterialBindIncludePath("", "source.bind"));
    EXPECT_TRUE(SawCapturedError(logger, "virtual path is empty for 'source.bind'"));
    EXPECT_FALSE(ValidateDeferredBxdfSource("project/material", ""));
    const usize maxU32 = cast<usize>(u32.max);
    EXPECT_TRUE(ValidateDeferredBxdfCount(maxU32));
    EXPECT_TRUE(ValidateMaterialSurfaceCount(maxU32));
    u32 expectedErrors = 4u;
    if(usize.max > maxU32){
        EXPECT_FALSE(ValidateDeferredBxdfCount(maxU32 + 1u));
        EXPECT_FALSE(ValidateMaterialSurfaceCount(maxU32 + 1u));
        expectedErrors += 2u;
    }
    EXPECT_TRUE(ValidateGeneratedMaterialMeshShader(0u, s_NameNone));
    EXPECT_FALSE(ValidateGeneratedMaterialMeshShader(1u, s_NameNone));
    EXPECT_FALSE(ValidateTransparentMaterialInterface("project/material", "", "occupancy"));
    EXPECT_FALSE(IsMaterialOpticalStageCombinationValid(true, false, true, false));
    EXPECT_FALSE(IsMaterialOpticalStageCombinationValid(true, false, false, true));
    EXPECT_TRUE(IsMaterialOpticalStageCombinationValid(true, false, false, false));
    EXPECT_TRUE(IsMaterialOpticalStageCombinationValid(false, false, true, true));
    EXPECT_EQ(logger.errorCount(), expectedErrors);
}

void VerifyAssetsGraphics_MaterialKeyHashPreservesHighBytesAndPathSeparators(){
    const StringView backslashKey = "Ab\\C/\xC3\xA9";
    const StringView slashKey = "Ab/C/\xC3\xA9";
    EXPECT_EQ(ComputeFnv64AsciiLowerText(backslashKey), 0xff4be59fee952354ull);
    EXPECT_EQ(ComputeFnv64AsciiLowerText(slashKey), 0x6c9a1f221edbde7dull);
    const u32x4 packed = PackF32x3MaterialTypedValueMeta(backslashKey);
    const u32 expectedValueType = MaterialParamF32ValueTypeId();
    EXPECT_EQ(packed.x, 0xee952354u);
    EXPECT_EQ(packed.y, 0xff4be59fu);
    EXPECT_EQ(packed.z, expectedValueType);
    EXPECT_EQ(packed.w, 3u);
}

void VerifyAssetsGraphics_DuplicateMaterialBindIdentityIsRejectedBeforeMaterialMutation(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_MaterialScratchArena);

    MaterialBindEntryVector bindEntries(testArena.arena);
    for(usize index = 0u; index < 2u; ++index)
        AppendDuplicateBindTestEntry(testArena, s_ProjectMaterialInterfacesTestSurface, bindEntries);

    MaterialShaderCookEntryVector materialEntries(testArena.arena);
    AppendMaterialInterfaceTestEntry(testArena, s_ProjectMaterialInterfacesTestSurface, 0xF091u, 0x2Au, materialEntries);

    EXPECT_FALSE(ValidateTestMaterialCookInterfaces(bindEntries, materialEntries, scratchArena));
    EXPECT_TRUE(SawCapturedError(logger, "Material bind interface 'project/material_interfaces/test_surface' is duplicated"));
    EXPECT_EQ(materialEntries[0u].typedLayoutHash, 0xF091u);
    ASSERT_EQ(materialEntries[0u].typedBlockBytes.size(), 1u);
    EXPECT_EQ(materialEntries[0u].typedBlockBytes[0u], 0x2Au);
}

void VerifyAssetsGraphics_MaterialBindSchemaValidation(){
    native{
        const Array<AStringView, 8u> expectedSymbols = {
            "NWB_MATERIAL_BIND_INTERFACE_HASH_0", "NWB_MATERIAL_BIND_INTERFACE_HASH_1",
            "NWB_MATERIAL_BIND_INTERFACE_HASH_2", "NWB_MATERIAL_BIND_INTERFACE_HASH_3",
            "NWB_MATERIAL_BIND_INTERFACE_HASH_4", "NWB_MATERIAL_BIND_INTERFACE_HASH_5",
            "NWB_MATERIAL_BIND_INTERFACE_HASH_6", "NWB_MATERIAL_BIND_INTERFACE_HASH_7",
        };
        for(u32 lane = 0u; lane < s_NameHashLaneCount; ++lane)
            EXPECT_EQ(::NWB::Impl::MaterialBindInterfaceHashSymbol(lane), expectedSymbols[lane]);
    }
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_MaterialScratchArena);

    ExpectMaterialBindParseFailure(s_UnknownBlockClassMaterialBindSource, "material_bind_unknown_block_class", "unsupported attribute 'material_project'", testArena, scratchArena);
    ExpectMaterialBindParseFailure(s_UnsupportedFieldTypeMaterialBindSource, "material_bind_unsupported_field_type", "unsupported type 'double'", testArena, scratchArena);
    ExpectMaterialBindParseFailure(s_InvalidDefaultMaterialBindSource, "material_bind_invalid_default", "attribute 'default' requires one non-empty string argument", testArena, scratchArena);
    ExpectMaterialBindParseFailure(s_MissingDefaultMaterialBindSource, "material_bind_missing_default", "must declare a default attribute", testArena, scratchArena);
    ExpectMaterialBindParseFailure(s_ResourceAttributeMaterialBindSource, "material_bind_resource_attribute", "has unsupported attribute 'texture_asset'", testArena, scratchArena);

    Vector<StringView> resourceTypes = Vector<StringView>();
    resourceTypes.reserve(2u);
    resourceTypes.push_back("texture2d");
    resourceTypes.push_back("sampler");
    for(in StringView resourceType : resourceTypes){
        TestAString retiredFixtureBind = TestAString();
        retiredFixtureBind.append("[material_constant] struct NwbResourceMaterial{ [fixture(\"builtin/material_fixture/checker_rgba8\")] ");
        retiredFixtureBind.append(resourceType);
        retiredFixtureBind.append(" resource; }; NwbResourceMaterial surface;");
        ExpectMaterialBindParseFailure(ViewTestString(retiredFixtureBind), resourceType, "has unsupported attribute 'fixture'", testArena, scratchArena);
    }

    ExpectMaterialBindParseFailure(s_DuplicateInstanceMaterialBindSource, "material_bind_duplicate_instance", "duplicate variable declaration", testArena, scratchArena);
    ExpectMaterialBindParseFailure(s_InitializedInstanceMaterialBindSource, "material_bind_initialized_instance", "instance 'surface' must not have an initializer or assignments", testArena, scratchArena);

    const StringView validStruct = "[material_constant] struct Surface { [default(\"float(0.5)\")] float roughness; };\n";
    ExpectMaterialBindParseFailure(validStruct, "material_bind_missing_instance", "instance declarations must not be empty", testArena, scratchArena);

    TestAString unknownInstance = TestAString();
    unknownInstance.append(validStruct);
    unknownInstance.append("Unknown surface;");
    ExpectMaterialBindParseFailure(ViewTestString(unknownInstance), "material_bind_unknown_instance_type", "instance 'surface' references unknown struct type 'Unknown'", testArena, scratchArena);

    TestAString assignedInstance = TestAString();
    assignedInstance.append(validStruct);
    assignedInstance.append("Surface surface; surface.roughness = 0.5;");
    ExpectMaterialBindParseFailure(ViewTestString(assignedInstance), "material_bind_assigned_instance", "instance 'surface' must not have an initializer or assignments", testArena, scratchArena);

    const Expected<GraphicsTestPath> float1DefaultRootResult = PrepareCaseRoot(testArena, "material_bind_float1_default");
    ASSERT_TRUE(float1DefaultRootResult.has_value());
    const GraphicsTestPath float1DefaultRoot = float1DefaultRootResult.value();
    MaterialBindEntry float1DefaultEntry(testArena.arena);
    {
        Expected<MaterialBindEntry> parsedFloat1 = ParseTestMaterialBindFromText(s_Float1DefaultMaterialBindSource, float1DefaultRoot, testArena, scratchArena);
        ASSERT_TRUE(parsedFloat1.has_value());
        float1DefaultEntry = parsedFloat1.value();
    }
    SetMaterialBindEntryVirtualPath(float1DefaultEntry, s_ProjectMaterialInterfacesTestSurface);
    {
        const ScopedTestTrace trace("material_bind_float1_default_include");
        CapturingLogger failureLogger = CapturingLogger();
        LoggerRegistrationGuard failureLoggerGuard(failureLogger, s_ReportOnly);

        EXPECT_FALSE(CanBuildMaterialBindIncludeSource(float1DefaultEntry, testArena, scratchArena));
        EXPECT_TRUE(SawCapturedError(failureLogger, "default 'float1(1.0)'"));
    }

    const Name cacheInterface(s_ProjectMaterialInterfacesTestSurface);
    MaterialBindTypedLayoutCache layoutCache(testArena.arena);
    {
        const ScopedTestTrace trace("material_bind_float1_default_cache");
        CapturingLogger failureLogger = CapturingLogger();
        LoggerRegistrationGuard failureLoggerGuard(failureLogger, s_ReportOnly);

        EXPECT_FALSE(CanFindOrBuildMaterialBindTypedLayout(cacheInterface, float1DefaultEntry, scratchArena, layoutCache));
        EXPECT_TRUE(SawCapturedError(failureLogger, "default 'float1(1.0)'"));
    }
    EXPECT_TRUE(layoutCache.entries.empty());
    EXPECT_TRUE(layoutCache.lookup.empty());

    const Expected<GraphicsTestPath> validCacheRootResult = PrepareCaseRoot(testArena, "material_bind_cache_valid_after_failed_layout");
    ASSERT_TRUE(validCacheRootResult.has_value());
    const GraphicsTestPath validCacheRoot = validCacheRootResult.value();
    MaterialBindEntry validCacheEntry(testArena.arena);
    {
        Expected<MaterialBindEntry> parsedValid = ParseTestMaterialBindFromText(s_MinimalMaterialBindSource, validCacheRoot, testArena, scratchArena);
        ASSERT_TRUE(parsedValid.has_value());
        validCacheEntry = parsedValid.value();
    }
    SetMaterialBindEntryVirtualPath(validCacheEntry, s_ProjectMaterialInterfacesTestSurface);
    ASSERT_TRUE(CanFindOrBuildMaterialBindTypedLayout(cacheInterface, validCacheEntry, scratchArena, layoutCache));
    EXPECT_EQ(layoutCache.entries.size(), 1u);
    EXPECT_EQ(layoutCache.lookup.size(), 1u);
    EXPECT_EQ(logger.errorCount(), 0u);

    EXPECT_TRUE(RemoveAllIfExists(float1DefaultRoot));
    EXPECT_TRUE(RemoveAllIfExists(validCacheRoot));
}

void VerifyAssetsGraphics_MaterialBindEngineAndProjectResourceValidation(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    EXPECT_FALSE(IsSupportedMaterialResourceReference(s_MaterialResourceSampledImage2D, "builtin/textures/checker"));
