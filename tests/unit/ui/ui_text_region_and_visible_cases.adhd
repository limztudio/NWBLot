    scales[0u] = 1.0f;
    scales[1u] = 1.25f;
    scales[2u] = 1.5f;
    scales[3u] = 2.0f;
    for(usize index = 0u; index < samples.size(); ++index){
        for(usize sizeIndex = 0u; sizeIndex < fontSizes.size(); ++sizeIndex){
            const f32 fontSize = fontSizes[sizeIndex];
            for(usize scaleIndex = 0u; scaleIndex < scales.size(); ++scaleIndex){
                const f32 scale = scales[scaleIndex];
                ASSERT_NO_FATAL_FAILURE(self.checkContentButtonRow("Next", samples[index], fontSize, scale, generation));
                ++generation;
            }
        }
    }
}

void VerifyUiTextRegionTests_NaturalEditHeightKeepsCombiningAndFallbackInkOutsideLogicalLineMetrics(mut UiTextRegionTests self){
    ASSERT_NO_FATAL_FAILURE(self.useDefaultButtonPadding());
    ASSERT_TRUE(self.installKoreanFallback());
    self.m_builder.style().fontSize = 16.0f;
    self.m_builder.editStyle().padding = Insets(8.0f, 8.0f, 8.0f, 8.0f);
    Array<StringView, 2u> samples;
    samples[0u] = s_UiTextRegionPaddedStackedAccentSample;
    samples[1u] = "A\xCC\x81\xCC\x81 g\xCC\xA3 \xED\x95\x9C\xEA\xB8\x80 ";
    Array<f32, 4u> scales;
    scales[0u] = 1.0f;
    scales[1u] = 1.25f;
    scales[2u] = 1.5f;
    scales[3u] = 2.0f;
    u64 generation = 1u;
    for(usize sampleIndex = 0u; sampleIndex < samples.size(); ++sampleIndex){
        const StringView sample = samples[sampleIndex];
        for(usize scaleIndex = 0u; scaleIndex < scales.size(); ++scaleIndex){
            const f32 scale = scales[scaleIndex];
            const DisplayMetrics display = DisplayMetrics(800.0f, 600.0f, scale, scale);
            EditModel model = EditModel(self.m_arena);
            ASSERT_TRUE(model.setText(sample));
            EditBoxState state = EditBoxState();
            auto layout = self.m_text.layout(MakeUiTextRegionShapeRequest(sample, 16.0f));
            ASSERT_TRUE(layout.has_value());
            const auto measured = self.m_text.measure(layout.value(), display);
            ASSERT_TRUE(measured.has_value());
            ASSERT_TRUE(self.begin(generation, display));
            ASSERT_TRUE(self.m_builder.beginPanel(s_UiTextRegionPanelKey, Rect(10.0f, 20.0f, 740.0f, 200.0f)));
            EditBoxOptions options = EditBoxOptions();
            options.width = LayoutSize(LayoutSizePolicy::Fixed, 300.0f);
            ASSERT_TRUE(self.m_builder.editBox("edit", model, state, options).valid);
            EXPECT_EQ(model.text(), sample);
            ASSERT_TRUE(self.finishPanel());
            const DrawSnapshot actual = self.m_paint.freeze();
            ASSERT_TRUE(self.m_context.commitFrame(generation));
            EXPECT_FLOAT_EQ(state.placement.bounds.height, Max(32.0f, measured.value().height + 8.0f + 8.0f));
            EXPECT_FLOAT_EQ(state.placement.scroll, 0.0f);
            const f32 inkTop = state.placement.textOrigin.y + measured.value().y;
            const f32 contentBottom = state.placement.content.y + state.placement.content.height;
            EXPECT_GE(inkTop, state.placement.content.y - 0.0001f);
            EXPECT_LE(inkTop + measured.value().height, contentBottom + 0.0001f);
            PaintBuilder reference = PaintBuilder(self.m_arena);
            reference.begin(display, generation, 1u, MakeUiSkinAssetRef(s_TestSkinPath), self.m_skin);
            ++generation;
            ASSERT_TRUE(self.m_text.paint(reference, layout.value(), state.placement.textOrigin, self.m_builder.editStyle().text));
            const auto expectedCoverage = UiTextRegionGlyphCoverageArea(reference.freeze());
            const auto actualCoverage = UiTextRegionGlyphCoverageArea(actual);
            ASSERT_TRUE(expectedCoverage.has_value());
            ASSERT_TRUE(actualCoverage.has_value());
            ASSERT_GT(expectedCoverage.value(), 0.0);
            EXPECT_NEAR(actualCoverage.value(), expectedCoverage.value(), Max(0.00001, expectedCoverage.value() * 0.000002));
        }
    }
}

void VerifyUiTextRegionTests_IntrinsicListAndComboRowsPreserveActualMarksFallbackAndMultilineCoverage(mut UiTextRegionTests self){
    ASSERT_TRUE(self.installKoreanFallback());
    UiTextRegionIntrinsicRowSource source = UiTextRegionIntrinsicRowSource();
    source.count = 3u;
    source.ordinaryText = "A\xCC\x81\xCC\x81 g\xCC\xA3 gjpqy";
    source.specialText = "\xED\x95\x9C\xEA\xB8\x80 Next\nA\xCC\x81\xCC\x81 g\xCC\xA3";
    ListState list = ListState();
    ComboState combo = ComboState();
    u64 generation = 1u;
    Array<b8, 2u> popups;
    popups[0u] = false;
    popups[1u] = true;
    Array<f32, 3u> fontSizes;
    fontSizes[0u] = 12.0f;
    fontSizes[1u] = 16.0f;
    fontSizes[2u] = 22.0f;
    Array<Point, 5u> scales;
    scales[0u] = Point(1.0f, 1.0f);
    scales[1u] = Point(1.25f, 1.25f);
    scales[2u] = Point(1.5f, 1.5f);
    scales[3u] = Point(2.0f, 2.0f);
    scales[4u] = Point(1.25f, 1.5f);
    for(usize popupIndex = 0u; popupIndex < popups.size(); ++popupIndex){
        const b8 popup = popups[popupIndex];
        for(usize sizeIndex = 0u; sizeIndex < fontSizes.size(); ++sizeIndex){
            const f32 fontSize = fontSizes[sizeIndex];
            for(usize scaleIndex = 0u; scaleIndex < scales.size(); ++scaleIndex){
                const Point scale = scales[scaleIndex];
                ASSERT_NO_FATAL_FAILURE(self.checkIntrinsicRowCoverage(popup, fontSize, DisplayMetrics(800.0f, 600.0f, scale.x, scale.y), generation, source, list, combo));
                ++generation;
            }
        }
    }
    EXPECT_EQ(source.count, 3u);
    EXPECT_GT(list.placement().endRow, list.placement().firstRow);
    EXPECT_TRUE(combo.isOpen());
}

void VerifyUiTextRegionTests_IntrinsicRowsShrinkAfterSourceFontSizeAndResolvedStyleChanges(mut UiTextRegionTests self){
    UiTextRegionIntrinsicRowSource source = UiTextRegionIntrinsicRowSource();
    source.count = 3u;
    source.specialText = s_UiTextRegionMultilineAccentText;
    ListState list = ListState();
    ComboState combo = ComboState();
    const DisplayMetrics display = DisplayMetrics(800.0f, 600.0f, 1.0f, 1.0f);
    u64 generation = 1u;
    Array<b8, 2u> popups;
    popups[0u] = false;
    popups[1u] = true;
    for(usize popupIndex = 0u; popupIndex < popups.size(); ++popupIndex){
        const b8 popup = popups[popupIndex];
        source.specialText = s_UiTextRegionMultilineAccentText;
        ++source.contentRevision;
        self.m_builder.listStyle().row.padding = Insets(8.0f, 16.0f, 8.0f, 18.0f);
        ASSERT_NO_FATAL_FAILURE(self.checkIntrinsicRowCoverage(popup, 22.0f, display, generation, source, list, combo));
        ++generation;
        ASSERT_NO_FATAL_FAILURE(self.checkIntrinsicRowCoverage(popup, 12.0f, display, generation, source, list, combo));
        ++generation;
        self.m_builder.listStyle().row.padding = Insets(8.0f, 4.0f, 8.0f, 4.0f);
        ASSERT_NO_FATAL_FAILURE(self.checkIntrinsicRowCoverage(popup, 12.0f, display, generation, source, list, combo));
        ++generation;
        source.specialText = s_UiTextRegionOrdinaryRowText;
        ++source.contentRevision;
        ASSERT_NO_FATAL_FAILURE(self.checkIntrinsicRowCoverage(popup, 12.0f, display, generation, source, list, combo));
        ++generation;
        source.specialText = s_UiTextRegionStackedAccentText;
        ++source.generation;
        ASSERT_NO_FATAL_FAILURE(self.checkIntrinsicRowCoverage(popup, 16.0f, display, generation, source, list, combo));
        ++generation;
    }
    EXPECT_EQ(source.count, 3u);
    EXPECT_GT(list.placement().endRow, list.placement().firstRow);
    EXPECT_TRUE(combo.isOpen());
}

void VerifyUiTextRegionTests_SelectableMetricsUseEveryStatePaddingAndMinimumWithoutHoverMovement(mut UiTextRegionTests self){
    ASSERT_NO_FATAL_FAILURE(self.useAsymmetricSelectableButtons());
    const SelectableStyle style = SelectableStyle();
    const auto metrics = MeasureSelectable(self.m_skin, style);
    ASSERT_TRUE(metrics.has_value());
    EXPECT_FLOAT_EQ(metrics.value().padding.left, 9.0f);
    EXPECT_FLOAT_EQ(metrics.value().padding.top, 11.0f);
    EXPECT_FLOAT_EQ(metrics.value().padding.right, 13.0f);
    EXPECT_FLOAT_EQ(metrics.value().padding.bottom, 15.0f);
    EXPECT_FLOAT_EQ(metrics.value().minimum.x, 100.0f);
    EXPECT_FLOAT_EQ(metrics.value().minimum.y, 55.0f);
    const auto layout = self.m_text.layout(MakeUiTextRegionShapeRequest("Agjpqy", 16.0f));
    ASSERT_TRUE(layout.has_value());
    const auto textBounds = self.m_text.measure(layout.value(), DisplayMetrics(800.0f, 600.0f, 1.0f, 1.0f));
    ASSERT_TRUE(textBounds.has_value());
    Array<SelectablePaintFlags, 4u> flagCases;
    flagCases[0u] = SelectablePaintFlags();
    flagCases[1u] = MakeUiSelectablePaintFlags(true, false, true, false);
    flagCases[2u] = MakeUiSelectablePaintFlags(true, true, false, false);
    flagCases[3u] = MakeUiSelectablePaintFlags(false, false, false, false);
    Vector<Vertex> baseline = Vector<Vertex>();
    u64 generation = 1u;
    for(usize flagIndex = 0u; flagIndex < flagCases.size(); ++flagIndex){
        const SelectablePaintFlags flags = flagCases[flagIndex];
        self.m_paint.begin(DisplayMetrics(800.0f, 600.0f, 1.0f, 1.0f), generation, self.m_skinGeneration, MakeUiSkinAssetRef(s_TestSkinPath), self.m_skin);
        ++generation;
        ASSERT_TRUE(PaintSelectable(self.m_paint, self.m_text, self.m_skin, layout.value(), textBounds.value(), metrics.value().padding, Rect(20.0f, 30.0f, 180.0f, 70.0f), Rect(0.0f, 0.0f, 800.0f, 600.0f), style, flags, Color(), Color()));
        const DrawSnapshot snapshot = self.m_paint.freeze();
        ExpectUiTextGlyphRegion(snapshot, Rect(29.0f, 41.0f, 158.0f, 44.0f));
        Vector<Vertex> glyphs = Vector<Vertex>();
        CopyGlyphVertices(snapshot, glyphs);
        if(baseline.empty()){
            baseline.reserve(glyphs.size());
            for(usize index = 0u; index < glyphs.size(); ++index)
                baseline.push_back(glyphs[index]);
        }
        ASSERT_EQ(glyphs.size(), baseline.size());
        for(usize index = 0u; index < glyphs.size(); ++index){
            EXPECT_FLOAT_EQ(glyphs[index].position.x, baseline[index].position.x);
            EXPECT_FLOAT_EQ(glyphs[index].position.y, baseline[index].position.y);
            EXPECT_FLOAT_EQ(glyphs[index].texCoord.x, baseline[index].texCoord.x);
            EXPECT_FLOAT_EQ(glyphs[index].texCoord.y, baseline[index].texCoord.y);
        }
    }
}

void VerifyTextVisibleBakedTests_PaddedSdfPlaneIntersectingClipSurvivesWhenShapingOutlineIsOutside(mut TextVisibleBakedTests self){
    ASSERT_TRUE(self.installBaked("A"));
    ASSERT_EQ(self.m_layout.glyphs().size(), 1u);
    const PlacedGlyph glyph = self.m_layout.glyphs()[0u];
    ASSERT_TRUE(FontFaceHasBakedAtlas(glyph.face));
    ASSERT_GT(glyph.ink.width, 0.0f);
    ASSERT_GT(glyph.ink.height, 0.0f);
    const Point origin = Point(40.0f, 40.0f);
    const Rect outline = ComputePlacedGlyphOutlineRect(glyph, origin);
    const Rect plane = UiTextVisibleBakedRect(glyph, origin);
    const f32 clipX = outline.x - 4.0f;
    const f32 clipY = outline.height * 0.5f + outline.y;
    const Rect clip = Rect(clipX, clipY, 2.0f, 1.0f);
    // Lanes are clip right, clip bottom, plane right, plane bottom.
    const VectorSingle ends = VectorSingle(clip.x, clip.y, plane.x, plane.y) + VectorSingle(clip.width, clip.height, plane.width, plane.height);
    ASSERT_LT(ends.x, outline.x);
    ASSERT_GE(clip.x, plane.x);
    ASSERT_GE(clip.y, plane.y);
    ASSERT_LE(ends.x, ends.z);
    ASSERT_LE(ends.y, ends.w);
    self.beginPaint(1u);
    self.m_paint.pushClip(clip);
    ASSERT_TRUE(self.m_text.paint(self.m_paint, self.m_layout, origin));
    ASSERT_TRUE(self.m_paint.popClip());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    EXPECT_TRUE(snapshot.glyphPages().empty());
    ASSERT_EQ(snapshot.sdfPages().size(), 1u);
    const FontAtlasGlyph record = FontFaceBakedGlyph(glyph.face, glyph.glyphId);
    EXPECT_EQ(snapshot.sdfPages()[0u], FontFaceBakedPage(glyph.face, record.group));
    ASSERT_EQ(snapshot.commands().size(), 1u);
    ExpectUiRect(snapshot.commands()[0u].clip, clip);
    ASSERT_EQ(snapshot.vertices().size(), 4u);
    EXPECT_EQ(snapshot.indices().size(), 6u);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].position.x, clip.x);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].position.y, clip.y);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].position.x, ends.x);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].position.y, ends.y);
}

void VerifyTextVisibleBakedTests_EmptyClipAndZeroAlphaAdmitNoBakedImagesOrGeometry(mut TextVisibleBakedTests self){
    ASSERT_TRUE(self.installBaked("A\nB\nC"));
    ASSERT_EQ(self.m_baked.payload().groups.size(), 3u);
    for(u64 scenario = 0u; scenario < 2u; ++scenario){
        self.beginPaint(scenario + 1u);
        f32 clipWidth = 100.0f;
        f32 alpha = 0.0f;
        if(scenario == 0u){
            clipWidth = 0.0f;
            alpha = 1.0f;
        }
        self.m_paint.pushClip(Rect(20.0f, 20.0f, clipWidth, 100.0f));
        const Color color = Color(0.7f, 0.2f, 0.5f, alpha);
        ASSERT_TRUE(self.m_text.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f), color));
        ASSERT_TRUE(self.m_paint.popClip());
        const DrawSnapshot snapshot = self.m_paint.freeze();
        EXPECT_TRUE(snapshot.glyphPages().empty());
        EXPECT_TRUE(snapshot.sdfPages().empty());
        EXPECT_TRUE(snapshot.vertices().empty());
        EXPECT_TRUE(snapshot.indices().empty());
        EXPECT_TRUE(snapshot.commands().empty());
    }
}

void VerifyTextVisibleBakedTests_SixtyThreePriorImagesLeaveOneSlotForOnlyTheVisibleBakedGroup(mut TextVisibleBakedTests self){
    ASSERT_TRUE(self.installBaked("A\nB\nC"));
    ASSERT_EQ(self.m_layout.glyphs().size(), 3u);
    ASSERT_EQ(self.m_baked.payload().groups.size(), 3u);
    const Point origin = Point(20.0f, 20.0f);
    const Rect clip = UiTextVisibleBakedOutlineCenterClip(self.m_layout.glyphs()[0u], origin);
    const f32 clipBottom = clip.y + clip.height;
    for(usize index = 1u; index < self.m_layout.glyphs().size(); ++index)
        ASSERT_GT(UiTextVisibleBakedRect(self.m_layout.glyphs()[index], origin).y, clipBottom);
    Vector<SharedGlyphPage> prior = Vector<SharedGlyphPage>();
    prior.reserve(s_PaintMaxImages - 1u);
    for(usize index = 0u; index < s_PaintMaxImages - 1u; ++index){
        const auto pageCreationResult = self.makePage(1000u + index);
        ASSERT_TRUE(pageCreationResult.has_value());
        const SharedGlyphPage page = pageCreationResult.value();
        ASSERT_TRUE(cast<b8>(page));
        prior.push_back(page);
    }
    self.beginPaint(1u);
    ASSERT_TRUE(self.m_paint.prepareGlyphPages(prior));
    self.m_paint.pushClip(clip);
    ASSERT_TRUE(self.m_text.paint(self.m_paint, self.m_layout, origin));
    ASSERT_TRUE(self.m_paint.popClip());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    ASSERT_EQ(snapshot.glyphPages().size(), prior.size());
    for(usize index = 0u; index < prior.size(); ++index)
        EXPECT_EQ(snapshot.glyphPages()[index], prior[index]);
    ASSERT_EQ(snapshot.sdfPages().size(), 1u);
    const PlacedGlyph visible = self.m_layout.glyphs()[0u];
    const FontAtlasGlyph record = FontFaceBakedGlyph(visible.face, visible.glyphId);
    EXPECT_EQ(snapshot.sdfPages()[0u], FontFaceBakedPage(visible.face, record.group));
    EXPECT_EQ(snapshot.glyphPages().size() + snapshot.sdfPages().size(), s_PaintMaxImages);
    ASSERT_EQ(snapshot.commands().size(), 1u);
    EXPECT_EQ(snapshot.vertices().size(), 4u);
    EXPECT_EQ(snapshot.indices().size(), 6u);
}

void VerifyTextVisibleBakedTests_FullyOutsideBakedGroupsRemainAbsentUntilALaterVisiblePaint(mut TextVisibleBakedTests self){
    ASSERT_TRUE(self.installBaked("A\nB\nC"));
    ASSERT_EQ(self.m_layout.glyphs().size(), 3u);
    self.beginPaint(1u);
    self.m_paint.pushClip(Rect(700.0f, 500.0f, 2.0f, 2.0f));
    ASSERT_TRUE(self.m_text.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f)));
    ASSERT_TRUE(self.m_paint.popClip());
    const DrawSnapshot hidden = self.m_paint.freeze();
    EXPECT_TRUE(hidden.glyphPages().empty());
    EXPECT_TRUE(hidden.sdfPages().empty());
    EXPECT_TRUE(hidden.vertices().empty());
    EXPECT_TRUE(hidden.indices().empty());
    EXPECT_TRUE(hidden.commands().empty());
    self.beginPaint(2u);
    ASSERT_TRUE(self.m_text.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f)));
    const DrawSnapshot revealed = self.m_paint.freeze();
    EXPECT_TRUE(revealed.glyphPages().empty());
    ASSERT_EQ(revealed.sdfPages().size(), 3u);
    ASSERT_EQ(revealed.commands().size(), 3u);
    for(usize index = 0u; index < self.m_layout.glyphs().size(); ++index){
        const PlacedGlyph glyph = self.m_layout.glyphs()[index];
        const FontAtlasGlyph record = FontFaceBakedGlyph(glyph.face, glyph.glyphId);
        EXPECT_EQ(revealed.sdfPages()[index], FontFaceBakedPage(glyph.face, record.group));
    }
    EXPECT_EQ(revealed.vertices().size(), 12u);
    EXPECT_EQ(revealed.indices().size(), 18u);
    EXPECT_TRUE(hidden.sdfPages().empty());
}

void VerifyTextVisibleBakedTests_VisibleMixedCapacityFailurePreservesPriorPageVersionBindingsAndGeometry(mut TextVisibleBakedTests self){
    ASSERT_TRUE(self.installBaked("A"));
    ASSERT_TRUE(self.applyLayout(MakeUiTextRegionShapeRequest("\xED\x95\x9C", 32.0f)));
    ASSERT_EQ(self.m_layout.glyphs().size(), 1u);
    ASSERT_FALSE(FontFaceHasBakedAtlas(self.m_layout.glyphs()[0u].face));
    const u32 warmGlyph = self.m_layout.glyphs()[0u].glyphId;
    self.beginPaint(1u);
    ASSERT_TRUE(self.m_text.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f)));
    const DrawSnapshot warm = self.m_paint.freeze();
    ASSERT_EQ(warm.glyphPages().size(), 1u);
    ASSERT_TRUE(warm.sdfPages().empty());
    const SharedGlyphPage oldPage = warm.glyphPages()[0u];
    Vector<SharedGlyphPage> prior = Vector<SharedGlyphPage>();
    prior.reserve(s_PaintMaxImages);
    prior.push_back(oldPage);
    for(usize index = 1u; index < s_PaintMaxImages; ++index){
        const auto pageCreationResult = self.makePage(2000u + index);
        ASSERT_TRUE(pageCreationResult.has_value());
        const SharedGlyphPage page = pageCreationResult.value();
        ASSERT_TRUE(cast<b8>(page));
        prior.push_back(page);
    }
    ASSERT_TRUE(self.applyLayout(MakeUiTextRegionShapeRequest("\352\270\200A", 32.0f)));
    ASSERT_EQ(self.m_layout.glyphs().size(), 2u);
    ASSERT_NE(self.m_layout.glyphs()[0u].glyphId, warmGlyph);
    ASSERT_FALSE(FontFaceHasBakedAtlas(self.m_layout.glyphs()[0u].face));
    ASSERT_TRUE(FontFaceHasBakedAtlas(self.m_layout.glyphs()[1u].face));
    self.beginPaint(2u);
    ASSERT_TRUE(self.m_paint.prepareGlyphPages(prior));
    self.m_paint.fillRect(Rect(2.0f, 3.0f, 5.0f, 7.0f), Color(0.6f, 0.3f, 0.2f, 0.5f));
    ASSERT_TRUE(self.m_paint.drawGlyph(oldPage, Rect(12.0f, 13.0f, 5.0f, 7.0f), Rect(0.0f, 0.0f, 0.25f, 0.25f)));
    PaintBuilder reference = PaintBuilder(self.m_arena);
    reference.begin(DisplayMetrics(800.0f, 600.0f, 1.0f, 1.0f), 2u, 1u, MakeUiSkinAssetRef(s_TestSkinPath), self.m_skin);
    ASSERT_TRUE(reference.prepareGlyphPages(prior));
    reference.fillRect(Rect(2.0f, 3.0f, 5.0f, 7.0f), Color(0.6f, 0.3f, 0.2f, 0.5f));
    ASSERT_TRUE(reference.drawGlyph(oldPage, Rect(12.0f, 13.0f, 5.0f, 7.0f), Rect(0.0f, 0.0f, 0.25f, 0.25f)));
    const DrawSnapshot expected = reference.freeze();
    EXPECT_FALSE(self.m_text.paint(self.m_paint, self.m_layout, Point(80.0f, 80.0f)));
    const DrawSnapshot rejected = self.m_paint.freeze();
    ExpectUiTextVisibleSamePaint(rejected, expected);
    EXPECT_TRUE(rejected.sdfPages().empty());
    ASSERT_EQ(rejected.glyphPages().size(), s_PaintMaxImages);
    EXPECT_EQ(rejected.glyphPages()[0u], oldPage);
    EXPECT_EQ(GlyphPageBindingOf(rejected.glyphPages()[0u]).generation, GlyphPageBindingOf(oldPage).generation);
    ASSERT_TRUE(self.applyLayout(MakeUiTextRegionShapeRequest("\xEA\xB8\x80", 32.0f)));
    self.beginPaint(3u);
    ASSERT_TRUE(self.m_text.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f)));
    const DrawSnapshot upgraded = self.m_paint.freeze();
    ASSERT_EQ(upgraded.glyphPages().size(), 1u);
    EXPECT_EQ(GlyphPageBindingOf(upgraded.glyphPages()[0u]).atlasIdentity, GlyphPageBindingOf(oldPage).atlasIdentity);
    EXPECT_GT(GlyphPageBindingOf(upgraded.glyphPages()[0u]).generation, GlyphPageBindingOf(oldPage).generation);
    EXPECT_NE(upgraded.glyphPages()[0u], oldPage);
    EXPECT_TRUE(upgraded.sdfPages().empty());
}


