////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RayTraceSceneQueryReadinessPolicy{
    public b8 canPrepareSceneQuery(
        in b8 hardwareSupported,
        in b8 traceResourcesPreflighted,
        in b8 rayQuerySupported,
        in b8 heapInitialized,
        in b8 heapHasAccelStructLayout,
        in b8 hasTlas,
        in b8 tlasHeapHandleValid,
        in b8 hasInstanceMaterialBuffer,
        in b8 hasMaterialTypedBuffer,
        in b8 hasInstanceBuffer,
        in b8 hasMaterialContextSlotsBuffer
    )const{
        return hardwareSupported && traceResourcesPreflighted && rayQuerySupported && heapInitialized && heapHasAccelStructLayout
            && hasTlas && tlasHeapHandleValid && hasInstanceMaterialBuffer && hasMaterialTypedBuffer && hasInstanceBuffer && hasMaterialContextSlotsBuffer;
    }

    public b8 canPublishHardwareSceneGraphResources(in b8 hardwareSupported, in b8 traceResourcesPreflighted, in b8 materialContextSlotsValid)const{
        return hardwareSupported && traceResourcesPreflighted && materialContextSlotsValid;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u64 PackRayTraceSlotsPair(in u32 lo, in u32 hi){
    return cast<u64>(lo) | (cast<u64>(hi) << 32u);
}

RayTraceMaterialContextSlots PackRayTraceMaterialContextSlots(in u32 sceneBvhNodes, in u32 sceneInstances, in u32 instanceMaterial, in u32 materialTyped, in u32 meshInstances, in b8 opticalValid, in u32 opticalSlot, in u32 opticalInstanceCount, in b8 hasCsgContext, in u32 csgContextSlot){
    RayTraceMaterialContextSlots slots;
    slots.sceneBvhNodes = sceneBvhNodes;
    slots.sceneInstances = sceneInstances;
    slots.instanceMaterial = instanceMaterial;
    slots.materialTyped = materialTyped;
    slots.meshInstances = meshInstances;
    if(opticalValid){
        slots.opticalScene = opticalSlot;
        slots.opticalInstanceCount = opticalInstanceCount;
    }
    if(hasCsgContext)
        slots.csgContext = csgContextSlot;
    return slots;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<u32> ResolveRayTraceStorageSlot(in BufferHandle buffer, in GpuDescriptorHandle handle){
    if(!buffer.valid())
        return 0u;
    if(!IsDescriptorClass(handle, GpuDescriptorClass::StorageBuffer))
        return MakeUnexpected(Failure());
    return handle.slot();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RendererRayTracingSystem::prepareSceneQueryResources(){
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    if(!RayTraceSceneQueryReadinessPolicy().canPrepareSceneQuery(
        this.m_shadowVisibilityHardwareSupported, this.m_shadowVisibilityTraceResourcesPreflighted, this.m_graphics.queryFeatureSupport(Feature::RayQuery),
        heap.isInitialized(), heap.hasAccelStructLayout(), this.m_rayTracingState.sceneBvh.m_tlas.valid(), this.m_rayTracingState.sceneBvh.m_tlasHeapHandle.valid(),
        this.m_rayTracingState.shadow.m_shadowInstanceMaterialBuffer.valid(), this.m_rayTracingState.shadow.m_shadowMaterialTypedBuffer.valid(),
        this.m_rayTracingState.shadow.m_shadowInstanceBuffer.valid(), this.m_rayTracingState.sceneBvh.m_rayTraceMaterialContextSlotsBuffer.valid()
    ))
        return false;
    RayTraceMaterialResources materials(this.m_graphics, this.m_rayTracingState.sceneBvh, this.m_rayTracingState.shadow);
    return materials.ensureRayTraceMaterialContextSlotsHeapHandle();
}

RayTracingSceneGraphResources RendererRayTracingSystem::snapshotSceneGraphResources()const{
    in RendererRayTracingState state = this.m_rayTracingState;
    RayTracingSceneGraphResources resources;
    if(this.m_shadowVisibilityResourcesPreflighted && this.m_shadowVisibilityTraceResourcesPreflighted){
        resources.contentStamp = this.m_preparedSceneContentStamp;
        if(this.m_shadowVisibilityHardwareSupported)
            resources.opticalScene = this.m_hardwareOpticalScene.snapshot();
        else
            resources.opticalScene = this.m_softwareOpticalScene.snapshot();
    }
    if(!RayTraceSceneQueryReadinessPolicy().canPublishHardwareSceneGraphResources(this.m_shadowVisibilityHardwareSupported, this.m_shadowVisibilityTraceResourcesPreflighted, state.sceneBvh.m_rayTraceMaterialContextSlotsHeapHandle.valid()))
        return resources;
    resources.sceneTlas = state.sceneBvh.m_tlas;
    resources.tlasHeapHandle = state.sceneBvh.m_tlasHeapHandle;
    resources.materialContextSlotsBuffer = state.sceneBvh.m_rayTraceMaterialContextSlotsBuffer;
    resources.instanceMaterialBuffer = state.shadow.m_shadowInstanceMaterialBuffer;
    resources.materialTypedBuffer = state.shadow.m_shadowMaterialTypedBuffer;
    resources.instanceBuffer = state.shadow.m_shadowInstanceBuffer;
    if(this.m_lightSpaceShadow.m_csg.snapshot.hasCsg){
        resources.csgTraceContextBuffer = state.sceneBvh.m_csgTraceContextBuffer;
        resources.csgTraceBoundsBuffers = Span<BufferHandle>(this.m_lightSpaceShadow.m_csg.dynamicBounds);
    }
    resources.materialContextSlotsHeapSlot = state.sceneBvh.m_rayTraceMaterialContextSlotsHeapHandle.slot();
    resources.hardwareAvailable = true;
    return resources;
}

Expected<RayTraceMaterialContextSlots> RendererRayTracingSystem::snapshotRayTraceMaterialContextSlots(){
    if(!this.m_rayTracingState.sceneBvh.m_rayTraceMaterialContextSlotsBuffer.valid() || !this.m_rayTracingState.sceneBvh.m_rayTraceMaterialContextSlotsHeapHandle.valid()
        || this.m_rayTracingState.sceneBvh.m_rayTraceMaterialContextSlotsHeapHandle.descriptorClass() != GpuDescriptorClass::UniformBuffer)
        return MakeUnexpected(Failure());

    const auto sceneBvhNodes = ResolveRayTraceStorageSlot(this.m_rayTracingState.sceneBvh.m_sceneBvhNodeBuffer, this.m_rayTracingState.sceneBvh.m_sceneBvhNodeHeapHandle);
    if(!sceneBvhNodes.has_value()){
        error("RendererSystem: ray-trace material-context heap registration is incomplete");
        return MakeUnexpected(Failure());
    }
    const auto sceneInstances = ResolveRayTraceStorageSlot(this.m_rayTracingState.sceneBvh.m_sceneInstanceBuffer, this.m_rayTracingState.sceneBvh.m_sceneInstanceHeapHandle);
    if(!sceneInstances.has_value()){
        error("RendererSystem: ray-trace material-context heap registration is incomplete");
        return MakeUnexpected(Failure());
    }
    const auto instanceMaterial = ResolveRayTraceStorageSlot(this.m_rayTracingState.shadow.m_shadowInstanceMaterialBuffer, this.m_rayTracingState.shadow.m_shadowInstanceMaterialHeapHandle);
    if(!instanceMaterial.has_value()){
        error("RendererSystem: ray-trace material-context heap registration is incomplete");
        return MakeUnexpected(Failure());
    }
    const auto materialTyped = ResolveRayTraceStorageSlot(this.m_rayTracingState.shadow.m_shadowMaterialTypedBuffer, this.m_rayTracingState.shadow.m_shadowMaterialTypedHeapHandle);
    if(!materialTyped.has_value()){
        error("RendererSystem: ray-trace material-context heap registration is incomplete");
        return MakeUnexpected(Failure());
    }
    const auto meshInstances = ResolveRayTraceStorageSlot(this.m_rayTracingState.shadow.m_shadowInstanceBuffer, this.m_rayTracingState.shadow.m_shadowInstanceHeapHandle);
    if(!meshInstances.has_value()){
        error("RendererSystem: ray-trace material-context heap registration is incomplete");
        return MakeUnexpected(Failure());
    }

    RayTracingOpticalSceneSnapshot opticalScene;
    if(this.m_shadowVisibilityHardwareSupported)
        opticalScene = this.m_hardwareOpticalScene.snapshot();
    else
        opticalScene = this.m_softwareOpticalScene.snapshot();
    const b8 opticalValid = opticalScene.valid();
    u32 opticalSlot = 0u;
    u32 opticalInstanceCount = 0u;
    if(opticalValid){
        opticalSlot = opticalScene.descriptor.slot();
        opticalInstanceCount = opticalScene.upload.deref().instanceCount;
    }

    const b8 hasCsgContext = this.m_shadowVisibilityTraceResourcesPreflighted && this.m_lightSpaceShadow.m_csg.snapshot.hasCsg;
    u32 csgContextSlot = 0u;
    if(hasCsgContext){
        const auto csgContext = ResolveRayTraceStorageSlot(this.m_rayTracingState.sceneBvh.m_csgTraceContextBuffer, this.m_rayTracingState.sceneBvh.m_csgTraceContextHeapHandle);
        if(!csgContext.has_value() || !this.m_rayTracingState.sceneBvh.m_csgTraceContextBuffer.valid()){
            error("RendererSystem: current CSG ray context is unavailable");
            return MakeUnexpected(Failure());
        }
        csgContextSlot = csgContext.value();
    }

    return PackRayTraceMaterialContextSlots(sceneBvhNodes.value(), sceneInstances.value(), instanceMaterial.value(), materialTyped.value(), meshInstances.value(), opticalValid, opticalSlot, opticalInstanceCount, hasCsgContext, csgContextSlot);
}

b8 RendererRayTracingSystem::rayTraceMaterialContextSlotsUploadNeeded(
    in RayTraceMaterialContextSlots slots,
    in usize bufferIdentity,
    mut u64 outWord0,
    mut u64 outWord1,
    mut u64 outWord2,
    mut u64 outWord3
)const{
    outWord0 = PackRayTraceSlotsPair(slots.sceneBvhNodes, slots.sceneInstances);
    outWord1 = PackRayTraceSlotsPair(slots.instanceMaterial, slots.materialTyped);
    outWord2 = PackRayTraceSlotsPair(slots.meshInstances, slots.opticalScene);
    outWord3 = PackRayTraceSlotsPair(slots.opticalInstanceCount, slots.csgContext);

    in RtSceneBvhState sceneBvh = this.m_rayTracingState.sceneBvh;
    if(
        bufferIdentity != 0u
        && sceneBvh.m_acceptedRayTraceMaterialContextSlotsValid
        && sceneBvh.m_acceptedRayTraceMaterialContextSlotsBufferIdentity == bufferIdentity
        && sceneBvh.m_acceptedRayTraceMaterialContextSlotsWord0 == outWord0
        && sceneBvh.m_acceptedRayTraceMaterialContextSlotsWord1 == outWord1
        && sceneBvh.m_acceptedRayTraceMaterialContextSlotsWord2 == outWord2
        && sceneBvh.m_acceptedRayTraceMaterialContextSlotsWord3 == outWord3
    )
        return false;
    return true;
}

void RendererRayTracingSystem::confirmPreparedRayTraceMaterialContextSlotsUpload(
    in u64 word0,
    in u64 word1,
    in u64 word2,
    in u64 word3,
    in usize bufferIdentity
){
    if(
        bufferIdentity == 0u
        || !this.m_rayTracingState.sceneBvh.m_rayTraceMaterialContextSlotsBuffer.valid()
        || this.m_rayTracingState.sceneBvh.m_rayTraceMaterialContextSlotsBuffer.identity() != bufferIdentity
    )
        return;
    this.m_rayTracingState.sceneBvh.m_acceptedRayTraceMaterialContextSlotsWord0 = word0;
    this.m_rayTracingState.sceneBvh.m_acceptedRayTraceMaterialContextSlotsWord1 = word1;
    this.m_rayTracingState.sceneBvh.m_acceptedRayTraceMaterialContextSlotsWord2 = word2;
    this.m_rayTracingState.sceneBvh.m_acceptedRayTraceMaterialContextSlotsWord3 = word3;
    this.m_rayTracingState.sceneBvh.m_acceptedRayTraceMaterialContextSlotsBufferIdentity = bufferIdentity;
    this.m_rayTracingState.sceneBvh.m_acceptedRayTraceMaterialContextSlotsValid = true;
}

void RayTraceMaterialResources::releaseRayTraceMaterialContextHeapHandles(){
    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(heap.isInitialized()){
        heap.free(this.m_scene.m_sceneBvhNodeHeapHandle);
        heap.free(this.m_scene.m_sceneInstanceHeapHandle);
        heap.free(this.m_scene.m_sceneInstanceUavHeapHandle);
        heap.free(this.m_shadow.m_shadowInstanceMaterialHeapHandle);
        heap.free(this.m_shadow.m_shadowMaterialTypedHeapHandle);
        heap.free(this.m_shadow.m_shadowInstanceHeapHandle);
        heap.free(this.m_shadow.m_shadowInstanceUavHeapHandle);
        heap.free(this.m_scene.m_rayTraceMaterialContextSlotsHeapHandle);
        RetireDescriptor(heap, this.m_scene.m_csgTraceContextHeapHandle);
        RetireDescriptor(heap, this.m_scene.m_csgTraceContextUavHeapHandle);
        heap.free(this.m_shadow.m_swShadowEdgeCounterHeapHandle);
        heap.free(this.m_shadow.m_swShadowEdgeListHeapHandle);
        heap.free(this.m_shadow.m_swShadowIndirectArgsHeapHandle);
    }
    this.m_scene.m_sceneBvhNodeHeapHandle = GpuDescriptorHandleInvalid();
    this.m_scene.m_sceneInstanceHeapHandle = GpuDescriptorHandleInvalid();
    this.m_scene.m_sceneInstanceUavHeapHandle = GpuDescriptorHandleInvalid();
    this.m_shadow.m_shadowInstanceMaterialHeapHandle = GpuDescriptorHandleInvalid();
    this.m_shadow.m_shadowMaterialTypedHeapHandle = GpuDescriptorHandleInvalid();
    this.m_shadow.m_shadowInstanceHeapHandle = GpuDescriptorHandleInvalid();
    this.m_shadow.m_shadowInstanceUavHeapHandle = GpuDescriptorHandleInvalid();
    this.m_scene.m_rayTraceMaterialContextSlotsHeapHandle = GpuDescriptorHandleInvalid();
    this.m_scene.m_csgTraceContextHeapHandle = GpuDescriptorHandleInvalid();
    this.m_scene.m_csgTraceContextUavHeapHandle = GpuDescriptorHandleInvalid();
    this.m_shadow.m_swShadowEdgeCounterHeapHandle = GpuDescriptorHandleInvalid();
    this.m_shadow.m_swShadowEdgeListHeapHandle = GpuDescriptorHandleInvalid();
    this.m_shadow.m_swShadowIndirectArgsHeapHandle = GpuDescriptorHandleInvalid();
}

b8 RayTraceMaterialResources::ensureRayTraceMaterialContextSlotsBuffer(){
    if(this.m_scene.m_rayTraceMaterialContextSlotsBuffer.valid())
        return true;

    BufferDesc slotsBufferDesc;
    slotsBufferDesc.setByteSize(size_of<RayTraceMaterialContextSlots>()).setIsConstantBuffer(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setDebugName(Name(s_RenderNameRaytraceMaterialContextSlots)).enableAutomaticStateTracking(ResourceStates::Common);
    auto rayTraceMaterialContextSlotsBufferResult = this.m_graphics.createBuffer(slotsBufferDesc);
    if(rayTraceMaterialContextSlotsBufferResult.has_value()){
        this.m_scene.m_rayTraceMaterialContextSlotsBuffer = rayTraceMaterialContextSlotsBufferResult.value();
        this.m_scene.m_acceptedRayTraceMaterialContextSlotsValid = false;
    }
    else{
        this.m_scene.m_rayTraceMaterialContextSlotsBuffer.reset();
        this.m_scene.m_acceptedRayTraceMaterialContextSlotsValid = false;
    }
    if(!rayTraceMaterialContextSlotsBufferResult.has_value()){
        error("RendererSystem: failed to create ray-trace material-context slot buffer");
        return false;
    }
    return true;
}

b8 RayTraceMaterialResources::ensureRayTraceMaterialContextSlotsHeapHandle(){
    if(!this.ensureRayTraceMaterialContextSlotsBuffer())
        return false;

    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized() || !EnsureHeapBuffer(GpuDescriptorClass::UniformBuffer, false, heap, this.m_scene.m_rayTraceMaterialContextSlotsBuffer.deref(), this.m_scene.m_rayTraceMaterialContextSlotsHeapHandle)){
        error("RendererSystem: failed to register ray-trace material-context selector in the descriptor heap");
        return false;
    }
    return true;
}

b8 RayTraceMaterialResources::ensureRayTraceStorageHeapHandle(mut Buffer buffer, mut GpuDescriptorHandle handle, in b8 writable){
    if(handle.valid())
        return true;

    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        error("RendererSystem: ray-trace material context requires the initialized global descriptor heap");
        return false;
    }

    if(!EnsureHeapBuffer(GpuDescriptorClass::StorageBuffer, writable, heap, buffer, handle)){
        error("RendererSystem: failed to register ray-trace material context buffer in the descriptor heap");
        return false;
    }
    return true;
}

b8 RayTraceMaterialResources::replaceRayTraceStorageHeapHandle(mut Buffer buffer, mut GpuDescriptorHandle handle, in b8 writable){
    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        error("RendererSystem: ray-trace material context requires the initialized global descriptor heap");
        return false;
    }

    if(!ReplaceHeapBuffer(GpuDescriptorClass::StorageBuffer, writable, heap, buffer, handle)){
        error("RendererSystem: failed to replace ray-trace material-context heap descriptor");
        return false;
    }
    return true;
}

b8 RayTraceMaterialResources::ensureRayTraceMaterialContextHeapHandle(mut Buffer buffer, mut GpuDescriptorHandle handle){
    return this.ensureRayTraceStorageHeapHandle(buffer, handle, false);
}

b8 RayTraceMaterialResources::replaceRayTraceMaterialContextHeapHandle(mut Buffer buffer, mut GpuDescriptorHandle handle){
    return this.replaceRayTraceStorageHeapHandle(buffer, handle, false);
}

b8 RayTraceMaterialResources::ensureWritableRayTraceMaterialContextHeapHandle(mut Buffer buffer, mut GpuDescriptorHandle handle){
    return this.ensureRayTraceStorageHeapHandle(buffer, handle, true);
}

b8 RayTraceMaterialResources::replaceWritableRayTraceMaterialContextHeapHandle(mut Buffer buffer, mut GpuDescriptorHandle handle){
    return this.replaceRayTraceStorageHeapHandle(buffer, handle, true);
}


