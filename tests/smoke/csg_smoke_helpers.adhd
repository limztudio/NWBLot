void AddStaticCsgMeshReceiver(in EntityID entity, in Name receiverGroup, in b8 affectOpaquePass, in b8 affectTransparentPass, mut World world){
    mut StaticCsgMeshComponent receiver = world.entity(entity).addComponent<StaticCsgMeshComponent>();
    receiver.receiverGroup = receiverGroup;
    receiver.affectOpaquePass = affectOpaquePass;
    receiver.affectTransparentPass = affectTransparentPass;
}

void AddSkinnedCsgMeshReceiver(in EntityID entity, in Name receiverGroup, in b8 affectOpaquePass, in b8 affectTransparentPass, mut World world){
    mut SkinnedCsgMeshComponent receiver = world.entity(entity).addComponent<SkinnedCsgMeshComponent>();
    receiver.receiverGroup = receiverGroup;
    receiver.affectOpaquePass = affectOpaquePass;
    receiver.affectTransparentPass = affectTransparentPass;
}

void AssignCsgCutterTransform(in VectorSingle center, in VectorSingle rotation, mut CsgCutterComponent cutter){
    MatrixSingle worldToShape = MatrixSingle();
    MatrixSingle shapeToWorld = MatrixSingle();
    ComputeCsgCutterTransforms(center, rotation, worldToShape, shapeToWorld);
    cutter.worldToShape = f32x3x4(worldToShape);
    cutter.shapeToWorld = f32x3x4(shapeToWorld);
}

void AssignCsgCutterMatrix(in MatrixSingle shapeToWorld, mut CsgCutterComponent cutter){
    cutter.worldToShape = f32x3x4(Inverse(shapeToWorld));
    cutter.shapeToWorld = f32x3x4(shapeToWorld);
}

b8 SetSmokeCsgCutterTransform(in EntityID cutterEntity, in VectorSingle center, in VectorSingle rotation, mut World world){
    if(!world.hasComponent<CsgCutterComponent>(cutterEntity))
        return false;
    mut CsgCutterComponent cutter = world.entity(cutterEntity).getComponent<CsgCutterComponent>();
    AssignCsgCutterTransform(center, rotation, cutter);
    return true;
}

b8 SetSmokeCsgCutterMatrix(in EntityID cutterEntity, in MatrixSingle shapeToWorld, mut World world){
    if(!world.hasComponent<CsgCutterComponent>(cutterEntity))
        return false;
    mut CsgCutterComponent cutter = world.entity(cutterEntity).getComponent<CsgCutterComponent>();
    AssignCsgCutterMatrix(shapeToWorld, cutter);
    return true;
}

void SetSmokeCsgCutterActive(in EntityID cutterEntity, in b8 active, mut World world){
    mut CsgCutterComponent cutter = world.entity(cutterEntity).getComponent<CsgCutterComponent>();
    cutter.active = active;
}


