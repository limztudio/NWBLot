void VerifyUiNestedPopupTriggerTests_NestedComboRejectsDisabledRowWithoutActivatingUserAncestors(mut UiNestedPopupTriggerTests self){
    ASSERT_TRUE(self.acceptChildCombo(1u));
    const Optional<HitTarget> fieldTarget = self.findTarget(self.fieldId());
    ASSERT_TRUE(fieldTarget.has_value());
    EXPECT_FALSE(self.hasTarget(self.rowsId()));
    self.click(CenterUiRect(fieldTarget.value().rectangle));
    ASSERT_TRUE(self.acceptChildCombo(2u));
    EXPECT_FALSE(self.m_result.committed);
    EXPECT_TRUE(self.m_state.isOpen());
    ASSERT_TRUE(self.hasTarget(self.rowsId()));
    const Optional<HitTarget> row3Target = self.findTarget(self.comboRow(3u));
    ASSERT_TRUE(row3Target.has_value());
    EXPECT_FALSE(row3Target.value().enabled);
    self.click(CenterUiRect(row3Target.value().rectangle));
    ASSERT_TRUE(self.acceptChildCombo(3u));
    EXPECT_FALSE(self.m_result.committed);
    EXPECT_TRUE(self.m_state.isOpen());
    EXPECT_EQ(self.m_state.selectedKey(), 0u);

    const Optional<HitTarget> row4Target = self.findTarget(self.comboRow(4u));
    ASSERT_TRUE(row4Target.has_value());
    self.click(CenterUiRect(row4Target.value().rectangle));
    ASSERT_TRUE(self.acceptChildCombo(4u));
    EXPECT_TRUE(self.m_result.committed);
    EXPECT_TRUE(self.m_result.selectionChanged);
    EXPECT_TRUE(self.m_result.closed);
    EXPECT_EQ(self.m_state.selectedKey(), 4u);
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_FALSE(self.hasTarget(self.rowsId()));
    self.expectUserParentsOpen();
}

void VerifyUiNestedPopupTriggerTests_NestedMenuSkipsDisabledCommandsWithoutActivatingUserAncestors(mut UiNestedPopupTriggerTests self){
    ASSERT_TRUE(self.acceptChildMenu(1u));
    const Optional<HitTarget> anchorTarget = self.findTarget(self.anchorId());
    ASSERT_TRUE(anchorTarget.has_value());
    const Point point = CenterUiRect(anchorTarget.value().rectangle);
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerPointEvent(InputEventType::SecondaryDown, point)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerPointEvent(InputEventType::SecondaryUp, point)).pointerConsumed);
    ASSERT_TRUE(self.acceptChildMenu(2u));
    EXPECT_TRUE(self.m_menuResult.opened);
    EXPECT_FALSE(self.m_anchorActivated);
    EXPECT_TRUE(self.m_menu.isOpen());
    ASSERT_TRUE(self.hasTarget(self.menuRows()));
    self.press(CoreKey::Down);
    self.press(CoreKey::Down);
    ASSERT_TRUE(self.acceptChildMenu(3u));
    EXPECT_EQ(self.m_menu.cursorKey(), 4u);
    EXPECT_FALSE(self.m_menuResult.activated);
    self.press(CoreKey::Enter);
    ASSERT_TRUE(self.acceptChildMenu(4u));
    EXPECT_TRUE(self.m_menuResult.activated);
    EXPECT_EQ(self.m_menuResult.key, 4u);
    EXPECT_TRUE(self.m_menuResult.closed);
    EXPECT_FALSE(self.m_menu.isOpen());
    EXPECT_FALSE(self.m_anchorActivated);
    EXPECT_FALSE(self.hasTarget(self.menuRows()));
    self.expectUserParentsOpen();
}


