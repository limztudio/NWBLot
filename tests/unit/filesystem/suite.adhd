    replacement[1u] = 9u;

    ASSERT_TRUE(WriteBinaryFile(firstOutput, firstOld));
    ASSERT_TRUE(WriteBinaryFile(secondOutput, secondOld));
    ASSERT_TRUE(WriteBinaryFile(firstStaged, replacement));

    native(in stagedPaths, mut self, mut scratchArena){
        ThrowingPublishLogger throwingLogger(self.m_logger.arena());
        LoggerRegistrationGuard throwingLoggerGuard(throwingLogger, LoggerBreakPolicy::ReportOnly);
        EXPECT_THROW({ const b8 published = PublishStagedVolume(stagedPaths, self.m_directory, self.m_desc.volumeName.view(), 3u, scratchArena); EXPECT_FALSE(published); }, i32);
