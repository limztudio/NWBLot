    public Expected<f32> tryGetJointAngle(in JointId jointId)const{
        if(!this.isValidJoint(jointId))
            return MakeUnexpected(Failure());
        in Joint j = this.m_joints[jointId.index];
        in Body bA = this.m_bodies[j.edges[0u].bodyId];
        in Body bB = this.m_bodies[j.edges[1u].bodyId];
        const VectorSingle qA = VectorSingle(this.m_solverSets[bA.setIndex].sims[bA.localIndex].transform.rotation);
        const VectorSingle qB = VectorSingle(this.m_solverSets[bB.setIndex].sims[bB.localIndex].transform.rotation);
        const VectorSingle qTarget = SafeNormalizeQuat(QuaternionMultiply(qA, VectorSingle(j.referenceRotation)));
        VectorSingle qErr = SafeNormalizeQuat(QuaternionMultiply(qB, QuaternionConjugate(qTarget)));
        if(qErr.w < 0.0f)
            qErr = -qErr;
        const VectorSingle axis = SafeNormalizeVec3(Vector3Rotate(j.localAxisA(), qA), VectorSingle(0.0f, 1.0f, 0.0f, 0.0f));
        const f32 projSin = Vector3Dot(VectorSingle(qErr.x, qErr.y, qErr.z, 0.0f), axis).x;
        return 2.0f * ATan2(projSin, qErr.w);
    }

    public Expected<f32> tryGetJointTranslation(in JointId jointId)const{
        if(!this.isValidJoint(jointId))
            return MakeUnexpected(Failure());
        in Joint j = this.m_joints[jointId.index];
        in Body bA = this.m_bodies[j.edges[0u].bodyId];
        in Body bB = this.m_bodies[j.edges[1u].bodyId];
        in Transform3D xfA = this.m_solverSets[bA.setIndex].sims[bA.localIndex].transform;
        in Transform3D xfB = this.m_solverSets[bB.setIndex].sims[bB.localIndex].transform;
        const VectorSingle pA = TransformPoint(xfA, j.localAnchorA());
        const VectorSingle pB = TransformPoint(xfB, j.localAnchorB());
        const VectorSingle delta(pB - pA, 0.0f);
        if(j.type == JointType::Distance)
            return Vector3Length(delta).x;
        const VectorSingle axisA = SafeNormalizeVec3(Vector3Rotate(j.localAxisA(), VectorSingle(xfA.rotation)), VectorSingle(0.0f, 1.0f, 0.0f, 0.0f));
        return Vector3Dot(delta, axisA).x;
    }

