////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_AvboitIntegrationProbeWidth = 7u;
const u32 s_AvboitIntegrationProbeHeight = 3u;
const u32 s_AvboitIntegrationProbePixelCount = s_AvboitIntegrationProbeWidth * s_AvboitIntegrationProbeHeight;
const u32 s_AvboitIntegrationProbeSliceCount = 17u;
const u32 s_AvboitIntegrationSlicesPerWord = 4u;
const u32 s_AvboitIntegrationByteBits = 8u;
const u32 s_AvboitIntegrationProbeWordCount = 5u * s_AvboitIntegrationProbePixelCount;
const u32 s_AvboitIntegrationProbePhaseCount = 5u;
const u32 s_AvboitIntegrationProbeFixedScale = 16u;
const u32 s_AvboitOverflowInvalid = 0xffffffffu;

const u32 s_RefractionTileProbeSentinel = 0xa573d91bu;
const u32 s_RefractionTileProbePhaseCount = 6u;
const u32 s_RefractionTileProbeGuardWords = 8u;
const u32 s_RefractionTileProbeHeaderWords = 6u;
const u32 s_RefractionTileProbeArgumentBytes = 32u;
const u32 s_RefractionTileProbeArgumentWords = 8u + s_RefractionTileProbeGuardWords;
const u32 s_RefractionTileProbePixelCount = s_RefractionTileProbeWidth * s_RefractionTileProbeHeight;
const u32 s_RefractionTileProbeQueueWords = s_RefractionTileProbeTileCount + s_RefractionTileProbeGuardWords;
const u32 s_RefractionTileProbeVisitWords = s_RefractionTileProbeHeaderWords + s_RefractionTileProbeTileCount + s_RefractionTileProbePixelCount + s_RefractionTileProbeGuardWords;
const u32 s_RefractionTileProbeReadbackWords = s_RefractionTileProbeArgumentWords + s_RefractionTileProbeQueueWords + s_RefractionTileProbeVisitWords;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class AvboitIntegrationPhaseState{
    public Array<u32, s_AvboitIntegrationProbeWordCount> words;
    public Array<u32, s_AvboitIntegrationProbePixelCount> overflowSlices;
    public u32 activeSlices = s_AvboitIntegrationProbeSliceCount;

    public void setExtinction(in u32 pixel, in u32 slice, in u32 value){
        const u32 wordIndex = (slice / s_AvboitIntegrationSlicesPerWord) * s_AvboitIntegrationProbePixelCount + pixel;
        const u32 shift = (slice % s_AvboitIntegrationSlicesPerWord) * s_AvboitIntegrationByteBits;
        this.words[wordIndex] |= value << shift;
    }

    public void prepare(in u32 phase){
        for(u32 i = 0u; i < s_AvboitIntegrationProbeWordCount; ++i)
            this.words[i] = 0u;
        for(u32 i = 0u; i < s_AvboitIntegrationProbePixelCount; ++i)
            this.overflowSlices[i] = s_AvboitOverflowInvalid;

        u32 active = s_AvboitIntegrationProbeSliceCount;
        if(phase == 3u)
            active = 5u;
        else if(phase == 4u)
            active = 1u;
        this.activeSlices = active;

        for(u32 pixel = 0u; pixel < s_AvboitIntegrationProbePixelCount; ++pixel){
            if(phase == 0u){
                this.setExtinction(pixel, 0u, 255u);
                this.setExtinction(pixel, 1u, 255u);
                continue;
            }
            if(phase == 1u)
                continue;

            const u32 bucket = pixel % 7u;
            if(bucket == 1u){
                u32 targetSlice = active - 1u;
                if(active > 12u)
                    targetSlice = 12u;
                this.setExtinction(pixel, targetSlice, 16u);
            }
            else if(bucket == 2u){
                this.setExtinction(pixel, 0u, 255u);
                this.setExtinction(pixel, 1u, 255u);
            }
            else if(bucket == 3u){
                this.overflowSlices[pixel] = 0u;
            }
            else if(bucket == 4u){
                this.overflowSlices[pixel] = active - 1u;
            }
            else if(bucket == 5u){
                const u32 rounded = ((active + 3u) / 4u) * 4u - 1u;
                this.setExtinction(pixel, Min(rounded, s_AvboitIntegrationProbeSliceCount - 1u), 255u);
            }
            else if(bucket == 6u){
                this.setExtinction(pixel, active - 1u, 16u);
            }
        }
    }
}

b8 VerifyAvboitIntegrationSliceValues(
    in AvboitIntegrationPhaseState state,
    in u32 phase,
    in u32 slice,
    in Span<f32> observedPixels,
    in Span<f32> expectedPixels,
    mut Array<u32, s_AvboitIntegrationProbePixelCount> extinctionFixed
){
    for(u32 pixel = 0u; pixel < s_AvboitIntegrationProbePixelCount; ++pixel){
        const f32 expected = expectedPixels[pixel];
        const f32 actual = observedPixels[pixel];
        b8 mismatch = !IsFinite(actual);
        if(!mismatch){
            if(extinctionFixed[pixel] == 0u)
                mismatch = actual != 1.0f;
            else
                mismatch = Abs(actual - expected) > Max(0.0000002f, expected * 0.002f);
        }
        if(mismatch){
            error(
                "AvboitIntegrationProbe: mismatch phase {} pixel {} slice {} expected {} observed {}"
                , phase
                , pixel
                , slice
                , expected
                , actual
            );
            return false;
        }
        if(slice < state.activeSlices){
            if(slice >= state.overflowSlices[pixel]){
                extinctionFixed[pixel] = 16u * s_AvboitIntegrationProbeFixedScale;
            }
            else{
                const u32 packed = state.words[(slice / 4u) * s_AvboitIntegrationProbePixelCount + pixel];
                const u32 byteVal = (packed >> ((slice % 4u) * 8u)) & 255u;
                extinctionFixed[pixel] = Min(extinctionFixed[pixel] + byteVal, 16u * s_AvboitIntegrationProbeFixedScale);
            }
        }
    }
    return true;
}

b8 RunAvboitIntegrationProbe(in ActiveSceneSubsystems sceneSubsystems, mut ProjectRuntimeContext context){
    AvboitIntegrationPhaseState phaseState = AvboitIntegrationPhaseState();
    b8 ok = false;
    native(in sceneSubsystems, mut context, mut phaseState, mut ok){
        const Name probeName = Name(s_SmokeNameAvboitIntegrationProbe);
        auto& graphics = context.graphics;
        auto& device = graphics.getDevice();
        auto& heap = device.getDescriptorHeap();
        Core::ShaderHandle shader;
        const Impl::TransparentSubsystem* const transparentSubsystem = sceneSubsystems.findSubsystem<Impl::TransparentSubsystem>();
        const auto integrateShaderRef = transparentSubsystem ? transparentSubsystem->avboitIntegrateCs : Core::Assets::AssetRef<Impl::ComputeShader>{};
        if(
            !integrateShaderRef.valid()
            || !Impl::ShaderAssetLoader::Load<Impl::ComputeShader>(integrateShaderRef.name(), Core::ShaderArchive::s_DefaultVariant, probeName, NWB_TEXT("AvboitIntegrationProbe"), graphics, context.assetManager, context.shaderPathResolver, nullptr, shader)
        )
            return false;
        Core::BindingLayoutDesc layoutDesc(context.objectArena);
        layoutDesc.setVisibility(Core::ShaderType::Compute).addItem(Core::BindingLayoutItem::PushConstants(0u, NWB_AVBOIT_PUSH_CONSTANT_BYTE_SIZE));
        const auto layout = device.createBindingLayout(layoutDesc);
        if(!layout)
            return false;
        Core::ComputePipelineDesc pipelineDesc;
        pipelineDesc.setComputeShader(shader).addBindingLayout(*layout).addBindingLayout(heap.getResourceLayout()).addBindingLayout(heap.getSamplerLayout());
        const auto pipeline = device.createComputePipeline(pipelineDesc);
        if(!pipeline)
            return false;
        const auto createBuffer = [&graphics](const Name name, const u32 byteSize, const b8 constant){
            Core::BufferDesc desc;
            desc.setDebugName(name).setByteSize(byteSize).setStructStride(sizeof(u32)).setCanHaveUAVs(!constant).setIsConstantBuffer(constant).enableAutomaticStateTracking(constant ? Core::ResourceStates::ConstantBuffer : Core::ResourceStates::CopyDest);
            return graphics.createBuffer(desc);
        };
        const auto extinction = createBuffer(Name(s_SmokeNameAvboitIntegrationExtinction), s_AvboitIntWordCount * sizeof(u32), false);
        const auto overflow = createBuffer(Name(s_SmokeNameAvboitIntegrationOverflow), s_AvboitIntPixelCount * sizeof(u32), false);
        const auto control = createBuffer(Name(s_SmokeNameAvboitIntegrationControl), NWB_AVBOIT_CONTROL_WORD_COUNT * sizeof(u32), false);
        Core::TextureDesc textureDesc;
        textureDesc.setWidth(s_AvboitIntWidth)
            .setHeight(s_AvboitIntHeight)
            .setDepth(s_AvboitIntSliceCount)
            .setDimension(Core::TextureDimension::Texture3D)
            .setFormat(NWB_AVBOIT_TRANSMITTANCE_CORE_FORMAT)
            .setIsUAV(true)
            .setName(probeName)
            .setInitialState(Core::ResourceStates::CopyDest)
            .setKeepInitialState(true)
        ;
        const auto volume = graphics.createTexture(textureDesc);
        const auto readback = device.createStagingTexture(textureDesc, Core::CpuAccessMode::Read);
        if(!extinction || !overflow || !control || !volume || !readback)
            return false;
        Core::BufferHandle slotBuffer;
        Array<Core::GpuDescriptorHandle, 5u> descriptors{};
        Core::GpuDescriptorRetirementGuard retire(heap, descriptors);
        const Array<Core::BufferHandle, 3u> buffers{ *extinction, *overflow, *control };
        for(u32 index = 0u; index < buffers.size(); ++index){
            const auto descriptor = heap.allocate(Core::GpuDescriptorClass::StorageBuffer);
            if(!descriptor)
                return false;
            descriptors[index] = *descriptor;
            if(!heap.write(*descriptor, Core::DescriptorWriteItem::StructuredBufferUav(0u, buffers[index].get())))
                return false;
        }
        const auto storage = heap.allocate(Core::GpuDescriptorClass::StorageImage);
        if(!storage)
            return false;
        descriptors[3] = *storage;
        if(!heap.write(*storage, Core::DescriptorWriteItem::TextureUav(0u, volume->get(), textureDesc.format, Core::TextureSubresourceSet{}, Core::TextureDimension::Texture3D)))
            return false;
        Impl::DeferredBindlessResourceSlots slots;
        slots.avboitExtinction = descriptors[0].slot();
        slots.avboitExtinctionOverflow = descriptors[1].slot();
        slots.avboitControl = descriptors[2].slot();
        slots.avboitTransmittanceStorage = descriptors[3].slot();
        Core::GraphicsStandaloneService::BufferSetupDesc setup;
        setup.bufferDesc.setDebugName(Name(s_SmokeNameAvboitIntegrationSlots)).setByteSize(sizeof(slots)).setIsConstantBuffer(true).enableAutomaticStateTracking(Core::ResourceStates::ConstantBuffer);
        setup.data = &slots;
        setup.dataSize = sizeof(slots);
        setup.queue = Core::CommandQueue::Graphics;
        const auto slotBufferResult = graphics.standaloneGraph().setupBuffer(setup);
        if(!slotBufferResult)
            return false;
        slotBuffer = *slotBufferResult;
        const auto uniform = heap.allocate(Core::GpuDescriptorClass::UniformBuffer);
        if(!uniform)
            return false;
        descriptors[4] = *uniform;
        if(!heap.write(*uniform, Core::DescriptorWriteItem::ConstantBuffer(0u, slotBuffer.get())))
            return false;
        TStringView stage = NWB_TEXT("phase preparation");
        AvboitIntegrationProbeTask::Payload payload{ *extinction, *overflow, *control, slotBuffer, *volume, *readback, *pipeline, heap, stage };
        payload.push.frame[0] = s_AvboitIntWidth * 4u;
        payload.push.frame[1] = s_AvboitIntHeight * 4u;
        payload.push.frame[2] = s_AvboitIntWidth;
        payload.push.frame[3] = s_AvboitIntHeight;
        payload.push.volume[1] = s_AvboitIntSliceCount;
        payload.push.volume[2] = s_AvboitIntWordCount;
        payload.push.params.raw[NWB_AVBOIT_PUSH_PARAMS_EXTINCTION_FIXED_SCALE] = static_cast<f32>(s_AvboitIntegrationProbeFixedScale);
        payload.push.heapSlots[0] = uniform->slot();
        for(u32 phase = 0u; phase < s_AvboitIntegrationProbePhaseCount; ++phase){
            phaseState.prepare(phase);
            payload.volumeInitialState = phase == 0u ? Core::ResourceStates::Unknown : Core::ResourceStates::CopyDest;
            payload.words = phaseState.words;
            payload.overflowSlices = phaseState.overflowSlices;
            payload.controlWords.fill(0u);
            payload.controlWords[NWB_AVBOIT_CONTROL_ACTIVE_PHYSICAL_SLICES] = phaseState.activeSlices;
            const auto token = graphics.standaloneGraph().submitStandaloneTaskGraph(&payload, DeclareAvboitIntegrationProbe);
            if(!token){
                NWB_LOGGER_ERROR(NWB_TEXT("AvboitIntegrationProbe: phase {} standalone graph rejected at {}"), phase, stage);
                return false;
            }
            if(!device.waitForSubmissionToken(*token)){
                NWB_LOGGER_ERROR(NWB_TEXT("AvboitIntegrationProbe: phase {} submission completion wait failed"), phase);
                return false;
            }
            Array<u32, s_AvboitIntPixelCount> extinctionFixed{};
            for(u32 slice = 0u; slice < s_AvboitIntSliceCount; ++slice){
                const auto mapping = device.mapStagingTexture(*payload.readback, Core::TextureSlice{}.setOrigin(0u, 0u, slice).setSize(s_AvboitIntWidth, s_AvboitIntHeight, 1u), Core::CpuAccessMode::Read);
                if(!mapping){
                    NWB_LOGGER_ERROR(NWB_TEXT("AvboitIntegrationProbe: phase {} volume readback comparison failed"), phase);
                    return false;
                }
                ScopeExit unmap([&]()noexcept{ device.unmapStagingTexture(*payload.readback); });
                if(!mapping->data || mapping->rowPitch < s_AvboitIntWidth * sizeof(Half)){
                    NWB_LOGGER_ERROR(NWB_TEXT("AvboitIntegrationProbe: phase {} volume readback comparison failed"), phase);
                    return false;
                }
                Array<f32, s_AvboitIntPixelCount> observedPixels{};
                Array<f32, s_AvboitIntPixelCount> expectedPixels{};
                for(u32 pixel = 0u; pixel < s_AvboitIntPixelCount; ++pixel){
                    Half observed;
                    NWB_MEMCPY(&observed, sizeof(observed), static_cast<const u8*>(mapping->data) + (pixel / s_AvboitIntWidth) * mapping->rowPitch + (pixel % s_AvboitIntWidth) * sizeof(Half), sizeof(observed));
                    const f32 exponent = -static_cast<f32>(extinctionFixed[pixel]) / static_cast<f32>(s_AvboitIntegrationProbeFixedScale);
                    expectedPixels[pixel] = ConvertHalfToFloat(ConvertFloatToHalf(Exp(exponent)));
                    observedPixels[pixel] = ConvertHalfToFloat(observed);
                }
                if(!VerifyAvboitIntegrationSliceValues(phaseState, phase, slice, Span<const f32>(observedPixels.data(), observedPixels.size()), Span<const f32>(expectedPixels.data(), expectedPixels.size()), extinctionFixed)){
                    NWB_LOGGER_ERROR(NWB_TEXT("AvboitIntegrationProbe: phase {} volume readback comparison failed"), phase);
                    return false;
                }
            }
        }
        ok = true;
    }
    if(ok)
        [essential] info("AvboitIntegrationProbe: passed 5 phases with empty, late, partial, saturation, wrapped overflow and active-to-empty clear checks");
    return ok;
}

void BuildRefractionProbeReversedTiles(mut Vector<u32> outTiles){
    outTiles.resize(s_RefractionTileProbeQueueWords, s_RefractionTileProbeSentinel);
    for(u32 tile = 0u; tile < s_RefractionTileProbeTileCount; ++tile)
        outTiles[tile] = s_RefractionTileProbeTileCount - 1u - tile;
}

b8 VerifyRefractionTileProbeReadback(
    in u32 phase,
    in Span<u32> words,
    in u64 argBytes,
    in u64 queueBytes,
    in u64 visitBytes,
    in u64 readbackBytes
){
    const u32 count = ExpectedRefractionProbeTileCount(phase);
    const b8 dense = count == s_RefractionTileProbeTileCount;
    u32 compactX = Min(count, s_RefractionTileProbeMaxGroupCountX);
    u32 compactY = Max(1u, (count + s_RefractionTileProbeMaxGroupCountX - 1u) / s_RefractionTileProbeMaxGroupCountX);
    u32 denseX = 0u;
    u32 denseY = 1u;
    if(dense){
        compactX = 0u;
        compactY = 1u;
        denseX = s_RefractionTileProbeTilesX;
        denseY = s_RefractionTileProbeTilesY;
    }

    Array<u32, 8u> expectedArguments;
    expectedArguments[0u] = compactX;
    expectedArguments[1u] = compactY;
    expectedArguments[2u] = 1u;
    expectedArguments[3u] = count;
    expectedArguments[4u] = denseX;
    expectedArguments[5u] = denseY;
    expectedArguments[6u] = 1u;
    expectedArguments[7u] = 0u;

    for(u32 word = 0u; word < s_RefractionTileProbeArgumentWords; ++word){
        u32 expected = s_RefractionTileProbeSentinel;
        if(word < 8u)
            expected = expectedArguments[word];
        if(words[word] != expected){
            error(
                "RefractionTileProbe: phase {} argument word {} expected {} observed {}"
                , phase
                , word
                , expected
                , words[word]
            );
            return false;
        }
    }

    Vector<u8> seen;
    seen.resize(s_RefractionTileProbeTileCount, 0u);
    const u32 queueBase = s_RefractionTileProbeArgumentWords;
    for(u32 index = 0u; index < count; ++index){
        const u32 tile = words[queueBase + index];
        if(tile >= s_RefractionTileProbeTileCount || !IsRefractionProbeTileActive(phase, tile) || seen[tile] != 0u){
            error(
                "RefractionTileProbe: phase {} invalid or duplicate queue tile {} at {}"
                , phase
                , tile
                , index
            );
            return false;
        }
        seen[tile] = 1u;
    }

    const u32 visitBase = queueBase + s_RefractionTileProbeQueueWords;
    for(u32 index = count; index < s_RefractionTileProbeQueueWords; ++index){
        const u32 tile = words[queueBase + index];
        if(tile != s_RefractionTileProbeSentinel){
            [essential] info(
                "RefractionTileProbe: readback layout argument_bytes={} queue_bytes={} visit_bytes={} readback_bytes={} expected_queue_words={} queue_offset={} visit_offset={}"
                , argBytes
                , queueBytes
                , visitBytes
                , readbackBytes
                , s_RefractionTileProbeQueueWords
                , cast<u64>(s_RefractionTileProbeArgumentWords) * 4u
                , cast<u64>(visitBase) * 4u
            );
            u32 neighborStart = 0u;
            if(count > 4u)
                neighborStart = count - 4u;
            const u32 neighborEnd = Min(count + s_RefractionTileProbeGuardWords, s_RefractionTileProbeQueueWords);
            for(u32 neighbor = neighborStart; neighbor < neighborEnd; ++neighbor)
                [essential] info("RefractionTileProbe: queue[{}]=0x{:08x}", neighbor, words[queueBase + neighbor]);
            [essential] info(
                "RefractionTileProbe: counters groups={} tails={} errors={} edge_lanes={}"
                , words[visitBase + 0u]
                , words[visitBase + 1u]
                , words[visitBase + 2u]
                , words[visitBase + 3u]
            );
            error(
                "RefractionTileProbe: phase {} queue tail overwritten at {} expected 0x{:08x} observed 0x{:08x}"
                , phase
                , index
                , s_RefractionTileProbeSentinel
                , tile
            );
            return false;
        }
    }

    u32 pixelCount = 0u;
    for(u32 tile = 0u; tile < s_RefractionTileProbeTileCount; ++tile){
        u32 expected = 0u;
        if(IsRefractionProbeTileActive(phase, tile))
            expected = 1u;
        const u32 visitVal = words[visitBase + s_RefractionTileProbeHeaderWords + tile];
        if(cast<u32>(seen[tile]) != expected || visitVal != expected){
            error(
                "RefractionTileProbe: phase {} queue/resolve tile {} expected {} queue {} visits {}"
                , phase
                , tile
                , expected
                , seen[tile]
                , visitVal
            );
            return false;
        }
        const u32 width = Min(s_RefractionTileProbeGroupSize, s_RefractionTileProbeWidth - (tile % s_RefractionTileProbeTilesX) * s_RefractionTileProbeGroupSize);
        const u32 height = Min(s_RefractionTileProbeGroupSize, s_RefractionTileProbeHeight - (tile / s_RefractionTileProbeTilesX) * s_RefractionTileProbeGroupSize);
        pixelCount += width * height * expected;
    }

    const u32 compactGroups = compactX * compactY;
    const u32 denseGroups = denseX * denseY;
    const u32 groups = compactGroups + denseGroups;
    Array<u32, s_RefractionTileProbeHeaderWords> expectedHeader;
    expectedHeader[0u] = groups;
    expectedHeader[1u] = groups - count;
    expectedHeader[2u] = 0u;
    expectedHeader[3u] = count * s_RefractionTileProbeGroupSize * s_RefractionTileProbeGroupSize - pixelCount;
    expectedHeader[4u] = compactGroups;
    expectedHeader[5u] = denseGroups;

    for(u32 word = 0u; word < s_RefractionTileProbeHeaderWords; ++word){
        if(words[visitBase + word] != expectedHeader[word]){
            error(
                "RefractionTileProbe: phase {} counter {} expected {} observed {}"
                , phase
                , word
                , expectedHeader[word]
                , words[visitBase + word]
            );
            return false;
        }
    }

    const u32 pixelVisitBase = visitBase + s_RefractionTileProbeHeaderWords + s_RefractionTileProbeTileCount;
    for(u32 pixel = 0u; pixel < s_RefractionTileProbePixelCount; ++pixel){
        const u32 tile = ((pixel / s_RefractionTileProbeWidth) / s_RefractionTileProbeGroupSize) * s_RefractionTileProbeTilesX + (pixel % s_RefractionTileProbeWidth) / s_RefractionTileProbeGroupSize;
        const u32 actual = words[pixelVisitBase + pixel];
        if(actual != cast<u32>(seen[tile])){
            error(
                "RefractionTileProbe: phase {} pixel {} expected {} observed {}"
                , phase
                , pixel
                , seen[tile]
                , actual
            );
            return false;
        }
    }

    for(u32 word = s_RefractionTileProbeVisitWords - s_RefractionTileProbeGuardWords; word < s_RefractionTileProbeVisitWords; ++word){
        if(words[visitBase + word] != s_RefractionTileProbeSentinel){
            error("RefractionTileProbe: phase {} visit guard overwritten at {}", phase, word);
            return false;
        }
    }

    [essential] info(
        "RefractionTileProbe: phase {} active_tiles={} compact={}x{} dense={}x{} pixels={} tail_groups={} edge_lanes={} argument_bytes={}"
        , phase
        , count
        , compactX
        , compactY
        , denseX
        , denseY
        , pixelCount
        , expectedHeader[1u]
        , expectedHeader[3u]
        , s_RefractionTileProbeArgumentBytes
    );
    return true;
}

b8 RunRefractionTileProbe(in ActiveSceneSubsystems sceneSubsystems, mut ProjectRuntimeContext context){
    Vector<u32> reversedTiles;
    BuildRefractionProbeReversedTiles(reversedTiles);

    b8 ok = false;
    native(in sceneSubsystems, in reversedTiles, mut context, mut ok){
        const Name probeName = Name(s_SmokeNameRefractionTileProbe);
        const Name verifyShaderName = Name(s_SmokeNameRefractionTileProbeCs);
        auto& graphics = context.graphics;
        auto& device = graphics.getDevice();
        auto& heap = device.getDescriptorHeap();
        Core::ShaderHandle classifyShader;
        Core::ShaderHandle finalizeShader;
        Core::ShaderHandle verifyCompactShader;
        Core::ShaderHandle verifyDenseShader;
        const Impl::RefractiveSubsystem* const refractiveSubsystem = sceneSubsystems.findSubsystem<Impl::RefractiveSubsystem>();
        const auto classifyShaderRef = refractiveSubsystem ? refractiveSubsystem->refractionClassifyTilesCs : Core::Assets::AssetRef<Impl::ComputeShader>{};
        const auto finalizeShaderRef = refractiveSubsystem ? refractiveSubsystem->refractionFinalizeTilesCs : Core::Assets::AssetRef<Impl::ComputeShader>{};
        const auto verifyShaderRef = sceneSubsystems.findSceneAsset<Impl::ComputeShader>(verifyShaderName);
        if(!classifyShaderRef.valid() || !finalizeShaderRef.valid() || !verifyShaderRef.valid())
            return false;
        const auto loadProbeShader = [&](const Name& shaderName, const AStringView variantName, Core::ShaderHandle& outShader){
            return Impl::ShaderAssetLoader::Load<Impl::ComputeShader>(shaderName, variantName, probeName, NWB_TEXT("RefractionTileProbe"), graphics, context.assetManager, context.shaderPathResolver, nullptr, outShader);
        };
        if(
            !loadProbeShader(classifyShaderRef.name(), Core::ShaderArchive::s_DefaultVariant, classifyShader)
            || !loadProbeShader(finalizeShaderRef.name(), Core::ShaderArchive::s_DefaultVariant, finalizeShader)
            || !loadProbeShader(verifyShaderRef.name(), AStringView("NWB_REFRACTION_DENSE_GRID=0"), verifyCompactShader)
            || !loadProbeShader(verifyShaderRef.name(), AStringView("NWB_REFRACTION_DENSE_GRID=1"), verifyDenseShader)
        )
            return false;
        Core::BindingLayoutDesc layoutDesc(context.objectArena);
        layoutDesc.setVisibility(Core::ShaderType::Compute).addItem(Core::BindingLayoutItem::PushConstants(0u, sizeof(RefractionTileProbePushConstants)));
        const auto layout = device.createBindingLayout(layoutDesc);
        if(!layout)
            return false;
        Core::ComputePipelineDesc classifyDesc;
        classifyDesc.setComputeShader(classifyShader).addBindingLayout(*layout).addBindingLayout(heap.getResourceLayout()).addBindingLayout(heap.getSamplerLayout());
        Core::ComputePipelineDesc finalizeDesc;
        finalizeDesc.setComputeShader(finalizeShader).addBindingLayout(*layout).addBindingLayout(heap.getResourceLayout()).addBindingLayout(heap.getSamplerLayout());
        Core::ComputePipelineDesc verifyCompactDesc;
        verifyCompactDesc.setComputeShader(verifyCompactShader).addBindingLayout(*layout).addBindingLayout(heap.getResourceLayout()).addBindingLayout(heap.getSamplerLayout());
        Core::ComputePipelineDesc verifyDenseDesc;
        verifyDenseDesc.setComputeShader(verifyDenseShader).addBindingLayout(*layout).addBindingLayout(heap.getResourceLayout()).addBindingLayout(heap.getSamplerLayout());
        const auto classify = device.createComputePipeline(classifyDesc);
        const auto finalize = device.createComputePipeline(finalizeDesc);
        const auto verifyCompact = device.createComputePipeline(verifyCompactDesc);
        const auto verifyDense = device.createComputePipeline(verifyDenseDesc);
        const auto createBuffer = [&graphics](const Name name, const u32 words, const b8 indirect, const b8 readback){
            Core::BufferDesc desc;
            desc.setDebugName(name).setByteSize(static_cast<u64>(words) * sizeof(u32)).setStructStride(sizeof(u32)).setCanHaveUAVs(!readback).setCanHaveRawViews(!readback).setIsDrawIndirectArgs(indirect);
            desc.setCpuAccess(readback ? Core::CpuAccessMode::Read : Core::CpuAccessMode::None).enableAutomaticStateTracking(Core::ResourceStates::CopyDest);
            return graphics.createBuffer(desc);
        };
        Core::GraphicsStandaloneService::BufferSetupDesc reversedSetup;
        reversedSetup.bufferDesc.setDebugName(Name(s_SmokeNameRefractionTileProbeReversedQueue)).setByteSize(static_cast<u64>(s_RefTileQueueWords) * sizeof(u32)).setStructStride(sizeof(u32));
        reversedSetup.bufferDesc.setCanHaveUAVs(true).setCanHaveRawViews(true).enableAutomaticStateTracking(Core::ResourceStates::ShaderResource);
        reversedSetup.data = reversedTiles.data();
        reversedSetup.dataSize = static_cast<u64>(s_RefTileQueueWords) * sizeof(u32);
        reversedSetup.queue = Core::CommandQueue::Graphics;
        const auto reversedQueue = graphics.standaloneGraph().setupBuffer(reversedSetup);
        const auto queue = createBuffer(Name(s_SmokeNameRefractionTileProbeQueue), s_RefTileQueueWords, false, false);
        const auto arguments = createBuffer(Name(s_SmokeNameRefractionTileProbeArguments), s_RefTileArgumentWords, true, false);
        const auto visits = createBuffer(Name(s_SmokeNameRefractionTileProbeVisits), s_RefTileVisitWords, false, false);
        const auto readback = createBuffer(Name(s_SmokeNameRefractionTileProbeReadback), s_RefTileReadbackWords, false, true);
        Core::TextureDesc depthDesc;
        depthDesc.setWidth(s_RefractionTileProbeWidth).setHeight(s_RefractionTileProbeHeight).setFormat(Core::Format::R32_FLOAT).setName(probeName).setInitialState(Core::ResourceStates::CopyDest).setKeepInitialState(true);
        const auto depth = graphics.createTexture(depthDesc);
        if(!classify || !finalize || !verifyCompact || !verifyDense || !queue || !reversedQueue || !arguments || !visits || !readback || !depth)
            return false;
        Core::BufferHandle slotsBuffer;
        Array<Core::GpuDescriptorHandle, 6u> descriptors{};
        Core::GpuDescriptorRetirementGuard retire(heap, descriptors);
        const Array<Core::BufferHandle, 4u> storageBuffers{ *queue, *arguments, *visits, *reversedQueue };
        for(u32 index = 0u; index < storageBuffers.size(); ++index){
            const auto descriptor = heap.allocate(Core::GpuDescriptorClass::StorageBuffer);
            if(!descriptor)
                return false;
            descriptors[index] = *descriptor;
            if(!heap.write(*descriptor, Core::DescriptorWriteItem::RawBufferUav(0u, storageBuffers[index].get())))
                return false;
        }
        const auto sampled = heap.allocate(Core::GpuDescriptorClass::SampledImage);
        if(!sampled)
            return false;
        descriptors[4] = *sampled;
        if(!heap.write(*sampled, Core::DescriptorWriteItem::TextureSrv(0u, depth->get(), depthDesc.format, Core::TextureSubresourceSet{}, Core::TextureDimension::Texture2D)))
            return false;
        Impl::DeferredBindlessResourceSlots slots;
        slots.refractionDepth = sampled->slot();
        Core::GraphicsStandaloneService::BufferSetupDesc setup;
        setup.bufferDesc.setDebugName(Name(s_SmokeNameRefractionTileProbeSlots)).setByteSize(sizeof(slots)).setIsConstantBuffer(true).enableAutomaticStateTracking(Core::ResourceStates::ConstantBuffer);
        setup.data = &slots;
        setup.dataSize = sizeof(slots);
        setup.queue = Core::CommandQueue::Graphics;
        const auto uploadedSlots = graphics.standaloneGraph().setupBuffer(setup);
        if(!uploadedSlots)
            return false;
        slotsBuffer = *uploadedSlots;
        const auto uniform = heap.allocate(Core::GpuDescriptorClass::UniformBuffer);
        if(!uniform)
            return false;
        descriptors[5] = *uniform;
        if(!heap.write(*uniform, Core::DescriptorWriteItem::ConstantBuffer(0u, slotsBuffer.get())))
            return false;
        TStringView stage = NWB_TEXT("probe initialization");
        RefractionTileProbeTask::Payload payload{ *depth, *queue, *reversedQueue, *arguments, *visits, slotsBuffer, *readback, *classify, *finalize, *verifyCompact, *verifyDense, heap, stage, {} };
        payload.denseTileListSlot = descriptors[3].slot();
        payload.push.width = s_RefractionTileProbeWidth;
        payload.push.height = s_RefractionTileProbeHeight;
        payload.push.deferredResourcesHeapSlot = uniform->slot();
        payload.push.tileListSlot = descriptors[0].slot();
        payload.push.tileArgumentsSlot = descriptors[1].slot();
        payload.push.materialContextSlotsHeapSlot = descriptors[2].slot();
        const u64 argBytes = payload.arguments->getCreationDescription().byteSize;
        const u64 queueBytes = payload.queue->getCreationDescription().byteSize;
        const u64 visitBytes = payload.visits->getCreationDescription().byteSize;
        const u64 readbackBytes = payload.readback->getCreationDescription().byteSize;
        for(u32 phase = 0u; phase < s_RefractionTileProbePhaseCount; ++phase){
            payload.phase = phase;
            const auto token = graphics.standaloneGraph().submitStandaloneTaskGraph(&payload, DeclareRefractionTileProbe);
            if(!token){
                NWB_LOGGER_ERROR(NWB_TEXT("RefractionTileProbe: phase {} standalone graph rejected at {}"), phase, stage);
                return false;
            }
            if(!device.waitForSubmissionToken(*token)){
                NWB_LOGGER_ERROR(NWB_TEXT("RefractionTileProbe: phase {} completion wait failed"), phase);
                return false;
            }
            const auto mapping = device.mapBuffer(*payload.readback, Core::CpuAccessMode::Read);
            if(!mapping || !*mapping)
                return false;
            ScopeExit unmap([&]()noexcept{ device.unmapBuffer(*payload.readback); });
            const Span<const u32> mappedWords(static_cast<const u32*>(*mapping), s_RefTileReadbackWords);
            if(!VerifyRefractionTileProbeReadback(phase, mappedWords, argBytes, queueBytes, visitBytes, readbackBytes))
                return false;
        }
        ok = true;
    }
    if(ok){
        [essential] info(
            "RefractionTileProbe: passed 6 phases at 2049x2049 with 66049 tiles, production finalizer, specialized dense/compact mapping, all 32 argument bytes, all-but-one sparse boundary, queue uniqueness, 65535/65536 boundary, indirect Y tail, 25190406 pixel checks and guards"
        );
    }
    return ok;
}


