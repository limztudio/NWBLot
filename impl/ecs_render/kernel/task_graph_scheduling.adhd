namespace RendererTaskGraphDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Large graph-owned compute effects may use an auxiliary physical queue only when the device-wide same-class policy is enabled.
// Keep each successor on its first transport: one semantic packet while the compiler owns inter-packet waits.
// Cross-family routing stays separately disabled here until an effect-specific ownership/performance decision promotes it.
void EnableSameFamilyComputeEffectRouting(Core::GpuTaskSchedulingHint& scheduling, const b8 preserveDirectDependency = true)noexcept;

// Cross-family routes stay second opt-in. The compiler checks resources against sharing contracts and lowers paired barriers.
inline void EnableCrossFamilyComputeEffectRouting(Core::GpuTaskSchedulingHint& scheduling)noexcept{
    scheduling.allowCrossFamilySameClassQueueRouting = true;
}

[[nodiscard]] constexpr Core::GpuTaskCommandRequirements SharedComputeEmulationCommandRequirements(const b8 generatePhase)noexcept{
    return { generatePhase ? Core::GpuQueueCapability::Compute : Core::GpuQueueCapability::Graphics };
}

template<typename Payload>
struct SharedComputeEmulationPhaseTaskCommandRequirementsBase{
public:
    [[nodiscard]] static constexpr Core::GpuTaskCommandRequirements CommandRequirements(const Payload& payload)noexcept{
        return SharedComputeEmulationCommandRequirements(payload.phase == SharedComputeEmulationPhase::Generate);
    }
};

// Shared alternating generate/raster compute-emulation chain scheduling: keep the full chain in one packet so a single list owns timing and handoff.
// Occupancy, extinction, and accumulation share this policy and differ only in their downstream consumers.
[[nodiscard]] Core::GpuTaskSchedulingHint SharedComputeEmulationChainScheduling()noexcept;

// Shared phase descriptors retain one ordered recording group while the compiler selects its compatible physical queue.
void MakeSharedComputeEmulationPhaseTaskDesc(
    const Name identity,
    const AStringView markerLabel,
    const Core::GpuTaskId& dependency,
    const Span<const Core::GpuTaskResourceUse> resourceUses,
    const Span<const Core::GpuTaskResourceSetUse> resourceSetUses,
    Core::GpuTaskDesc& desc
)noexcept;

#define NWB_DEFINE_SHARED_COMPUTE_EMULATION_PHASE_TABLES(phaseIdPrefix, phaseLabelPrefix) \
    const Array<Name, 10u> sharedPhaseIdentities = { \
        Name(phaseIdPrefix ".shared_compute_emulation_generate_a"), \
        Name(phaseIdPrefix ".shared_compute_emulation_raster_a"), \
        Name(phaseIdPrefix ".shared_compute_emulation_generate_b"), \
        Name(phaseIdPrefix ".shared_compute_emulation_raster_b"), \
        Name(phaseIdPrefix ".shared_compute_emulation_generate_c"), \
        Name(phaseIdPrefix ".shared_compute_emulation_raster_c"), \
        Name(phaseIdPrefix ".shared_compute_emulation_generate_d"), \
        Name(phaseIdPrefix ".shared_compute_emulation_raster_d"), \
        Name(phaseIdPrefix ".shared_compute_emulation_generate_e"), \
        Name(phaseIdPrefix ".shared_compute_emulation_raster_e"), \
    }; \
    const Array<AStringView, 10u> sharedPhaseMarkers = { \
        phaseLabelPrefix " Shared Compute Emulation Generate A", \
        phaseLabelPrefix " Shared Compute Emulation Raster A", \
        phaseLabelPrefix " Shared Compute Emulation Generate B", \
        phaseLabelPrefix " Shared Compute Emulation Raster B", \
        phaseLabelPrefix " Shared Compute Emulation Generate C", \
        phaseLabelPrefix " Shared Compute Emulation Raster C", \
        phaseLabelPrefix " Shared Compute Emulation Generate D", \
        phaseLabelPrefix " Shared Compute Emulation Raster D", \
        phaseLabelPrefix " Shared Compute Emulation Generate E", \
        phaseLabelPrefix " Shared Compute Emulation Raster E", \
    }


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


