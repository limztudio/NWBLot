////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/global.adhd>
#include <impl/assets_texture/validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u8 s_TextureOpaqueAlphaUnorm8 = 255u;

type MipLevelVector = Vector<TextureMipLevel>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena, asset("texture")]
class Texture{
    private u32 m_width = 0u;
    private u32 m_height = 0u;
    private u32 m_depth = 1u;

    private TexturePayloadDimension m_dimension = TexturePayloadDimension::Texture2D;
    private TexturePayloadFormat m_payloadFormat = TexturePayloadFormat::UastcLdr4x4;
    private TextureAlphaMode m_alphaMode = TextureAlphaMode::Opaque;
    private u8 m_alphaConstantUnorm8 = s_TextureOpaqueAlphaUnorm8;

    private MipLevelVector m_mipLevels;
    private Vector<u8> m_payloadBytes;

    public b8 validatePayload()const;
    public b8 loadBinary(in Span<u8> binary);

    // Cooked RGB values use the engine's linear working space; alpha is linear coverage.
    public void setPayload(
        in u32 width,
        in u32 height,
        in MipLevelVector mipLevels,
        in Vector<u8> payloadBytes,
        in TexturePayloadDimension dimension,
        in u32 depth,
        in TexturePayloadFormat payloadFormat,
        in TextureAlphaMode alphaMode,
        in u8 alphaConstantUnorm8
    ){
        this.m_width = width;
        this.m_height = height;
        this.m_dimension = dimension;
        this.m_depth = depth;
        this.m_payloadFormat = payloadFormat;
        this.m_alphaMode = alphaMode;
        this.m_alphaConstantUnorm8 = alphaConstantUnorm8;
        this.m_mipLevels = mipLevels;
        this.m_payloadBytes = payloadBytes;
    }

    public u32 width()const{ return this.m_width; }
    public u32 height()const{ return this.m_height; }
    public TexturePayloadDimension dimension()const{ return this.m_dimension; }
    public u32 depth()const{ return this.m_depth; }
    public TexturePayloadFormat payloadFormat()const{ return this.m_payloadFormat; }
    public TextureAlphaMode alphaMode()const{ return this.m_alphaMode; }
    public u8 alphaConstantUnorm8()const{ return this.m_alphaConstantUnorm8; }
    public in MipLevelVector mipLevels()const{ return this.m_mipLevels; }
    public in Vector<u8> payloadBytes()const{ return this.m_payloadBytes; }
    public u64 primaryPayloadByteCount()const;
    public Span<u8> alphaUastcBlocks()const;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
