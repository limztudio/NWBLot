using namespace NWB;

struct ShadowPacketPlan{
    Tests::TestArena<> testArena;
    Core::GpuTaskGraph graph;
    Core::GpuCompiledGraph compiledGraph;
    Impl::PreparedShadowVisibilityTasks tasks;


public:
    ShadowPacketPlan()
        : graph(testArena.arena)
        , compiledGraph(testArena.arena)
    {}


public:
    [[nodiscard]] b8 build(
        b8 combinedUpsample,
        b8 temporalMerge,
        u32 splitStage = Limit<u32>::s_Max,
        b8 combinedWavelet = false,
        b8 combinedTemporal = false,
        b8 diagnostics = false
    );

    [[nodiscard]] b8 sharesPacket(const Impl::PreparedShadowVisibilityTasks& candidate)const{
        const Core::GpuCompiledGraph::ReadView plan(compiledGraph);
        return Impl::PreparedShadowVisibilityTasksSharePacket(plan, candidate);
    }
};

[[nodiscard]] inline Core::GpuTaskId MakeGpuTaskId(const u32 generation, const u32 index)noexcept{
    return Core::GpuTaskId{ .generation = generation, .index = index };
}

[[nodiscard]] inline Impl::RayTracingSceneContentStamp MakeRtSceneStamp(const u64 geometry, const u64 material, const b8 trusted)noexcept{
    return Impl::RayTracingSceneContentStamp{ geometry, material, trusted };
}

[[nodiscard]] inline Core::QueueSubmissionToken MakeQueueToken(const u64 value, const u16 physicalQueueIndex, const u16 deviceGeneration, const Core::CommandQueue::Enum queue)noexcept{
    return Core::QueueSubmissionToken{ .value = value, .physicalQueueIndex = physicalQueueIndex, .deviceGeneration = deviceGeneration, .queue = queue };
}

[[nodiscard]] inline Core::GpuTaskTimingFeedbackPolicy MakeFeedbackPolicy(
    const f64 minimumAbsoluteBenefitSeconds,
    const f64 minimumRelativeBenefit,
    const u32 minimumFramesBetweenSwitches,
    const u32 minimumSampleCount,
    const u32 calibrationIntervalFrames,
    const b8 enabled
)noexcept{
    return Core::GpuTaskTimingFeedbackPolicy{
        .minimumAbsoluteBenefitSeconds = minimumAbsoluteBenefitSeconds,
        .minimumRelativeBenefit = minimumRelativeBenefit,
        .minimumFramesBetweenSwitches = minimumFramesBetweenSwitches,
        .minimumSampleCount = minimumSampleCount,
        .calibrationIntervalFrames = calibrationIntervalFrames,
        .enabled = enabled,
    };
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


