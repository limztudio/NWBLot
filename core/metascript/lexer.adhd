extern const StringView s_IncludePopMarker;
[cpp_header("<core/metascript/lexer.h>"), cpp_name("::NWB::Core::Metascript::s_IncludePushMarker")]
extern const StringView s_IncludePushMarker;
[cpp_header("<core/metascript/lexer.h>"), cpp_name("::NWB::Core::Metascript::s_MaxSavedIncludeDepth")]
extern const usize s_MaxSavedIncludeDepth;
[cpp_header("<core/metascript/lexer.h>"), cpp_name("::NWB::Core::Metascript::TokenType::s_TokenTypeIdentifierBase")]
extern const u8 s_TokenTypeIdentifierBase;


