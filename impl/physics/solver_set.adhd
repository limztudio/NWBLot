    public f32 invMassScaleB = 1.0f;
    public f32 invInertiaScaleA = 1.0f;
    public f32 invInertiaScaleB = 1.0f;
    public f32 limitRestitution = 0.0f;
    public f32 limitHertz = 0.0f;
    public f32 limitDampingRatio = 1.0f;
    public f32 projectionLinearTolerance = 0.1f;
    public f32 projectionAngularTolerance = 0.1f;
    public f32 ratio = 1.0f;
    public f32 breakForce = 0.0f;
    public f32 breakTorque = 0.0f;
    public u16 generation = 0u;
    public JointType type = JointType::Distance;
