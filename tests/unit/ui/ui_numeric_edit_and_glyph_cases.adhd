    ASSERT_TRUE(self.m_builder.beginPopup("child", self.m_child, MakeLargeLoanChildPopupOptions()));
    ASSERT_TRUE(self.m_builder.integerEdit(s_UiNumericEditIntegerKey, self.m_integer, self.m_integerState).edit.valid);
    ASSERT_TRUE(self.m_builder.virtualList("list", source, list, MakeLargeLoanListOptions()).valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    const usize loans = self.m_host.loans;
    source.resetCounters();
    source.armTextModel(self.m_integer);
    self.m_parent.close();
    ASSERT_TRUE(self.m_integer.setValue(42));
    ASSERT_TRUE(self.m_builder.endPopup());
    ASSERT_TRUE(self.finishRoot());
    EXPECT_EQ(self.m_host.loans, loans);
    EXPECT_EQ(self.m_host.publishes, 0u);
    EXPECT_EQ(source.textCalls.value(), 0u);
    EXPECT_FALSE(source.mutationApplied.value());
    EXPECT_EQ(self.m_integer.value(), 42);
}

void VerifyUiNumericEditLoanTests_SuccessfulEndReleasesNumericLoansBeforeApplicationMutation(mut UiNumericEditLoanTests self){
