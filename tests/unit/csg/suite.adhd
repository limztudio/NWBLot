Name TestProjectSlabShape::shapeTypeName()const noexcept{
    return Name(Tests::CsgCases::s_CsgInputNameProjectCsgSlab);
}

u32 TestProjectSlabShape::parameterByteSize()const noexcept{
    return Impl::s_CsgShapeParameterRegisterBytes;
}

Impl::CsgShapeInlineParameters TestProjectSlabShape::defaultParameters()const noexcept{
    return Impl::MakeCsgShapeInlineParameters(VectorSet(0.5f, 1.0f, 1.0f, 0.0f), LoadFloat(Impl::s_CsgZeroShapeParameter));
}

Expected<Impl::CsgShapeLocalBounds> TestProjectSlabShape::computeLocalBounds(const Impl::CsgShapeInlineParameters& parameters)const noexcept{
    return Impl::MakeCsgSymmetricLocalBounds(LoadFloat(parameters.parameter0));
}

f32 TestProjectSlabShape::evaluateSignedDistance(const SIMDVectorSingle shapePosition, const Impl::CsgShapeInlineParameters& parameters)const noexcept{
    return VectorGetX(shapePosition) + parameters.parameter0.x;
}

Name OversizedProjectShape::shapeTypeName()const noexcept{
    return Name(Tests::CsgCases::s_CsgInputNameProjectCsgOversized);
}

u32 OversizedProjectShape::parameterByteSize()const noexcept{
    return static_cast<u32>(Impl::s_CsgShapeInlineParameterMaxBytes) + 1u;
}

Impl::CsgShapeInlineParameters OversizedProjectShape::defaultParameters()const noexcept{
    return {};
}

Expected<Impl::CsgShapeLocalBounds> OversizedProjectShape::computeLocalBounds(const Impl::CsgShapeInlineParameters&)const noexcept{
    return MakeUnexpected(Failure{});
}

f32 OversizedProjectShape::evaluateSignedDistance(const SIMDVectorSingle, const Impl::CsgShapeInlineParameters&)const noexcept{
    return 0.0f;
}

b8 TestCsgReceiverVisible(
    [[maybe_unused]] Core::ECS::World& world,
    const Core::ECS::EntityID entity,
    [[maybe_unused]] const Impl::CsgReceiverKind::Enum receiverKind,
    [[maybe_unused]] const Impl::CsgReceiverComponent& receiver,
    void* userData
)noexcept{
    const auto* filter = static_cast<const TestCsgVisibilityFilter*>(userData);
    return !filter || entity != filter->hiddenEntity;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


