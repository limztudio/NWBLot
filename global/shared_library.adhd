[cpp_header("<global/shared_library.h>"), cpp_name("::SharedLibrary")]
extern class SharedLibrary{
    void close(...);
    b8 isOpen(...)const;
};

[cpp_header("<global/shared_library.h>"), cpp_name("::SharedLibraryFailure")]
extern class SharedLibraryFailure{
    ErrorCode code;
    DiagnosticEventText detail;
    b8 detailTruncated;
};


