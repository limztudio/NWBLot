GpuQueueCapability CombineQueueCapabilities(in GpuQueueCapability first, in GpuQueueCapability second, in GpuQueueCapability third){
    return cast<GpuQueueCapability>(cast<u8>(first) | cast<u8>(second) | cast<u8>(third));
}

GpuQueueCapability MaskOutQueueCapability(in GpuQueueCapability mask, in GpuQueueCapability excluded){
    return cast<GpuQueueCapability>(cast<u8>(mask) & ~cast<u8>(excluded));
}

Span<T> PrefixSpan<T>(in Span<T> items, in usize count){ return items.subspan(0u, count); }

Span<T> SubSpan<T>(in Span<T> items, in usize offset, in usize count){ return items.subspan(offset, count); }

Span<GpuTaskId> MakeNullTaskSpan(in usize count){ return TestArrayData<GpuTaskId>().declaredSpan(count); }

GpuDescriptorHandle MakeSampledImageDescriptor(in u32 index){ return GpuDescriptorHandleMake(GpuDescriptorClass::SampledImage, index); }

GpuTaskGraphQueueAssignmentOptions MakeQueueAssignmentOptionsWithLoads(in Span<GpuTaskQueueLoad> loads){
