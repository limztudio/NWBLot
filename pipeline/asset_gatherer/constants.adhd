const StringView s_DefaultGatherConfig = "default";
const Name s_AssetGathererArena = "pipeline/asset_gatherer";

b8 AreGatheredAssetPayloadsIdentical(in Span<u8> lhs, in Span<u8> rhs){
    if(lhs.size() != rhs.size())
        return false;
    for(usize i = 0u; i < lhs.size(); ++i){
        if(lhs[i] != rhs[i])
            return false;
    }
    return true;
}


