class MaterialPassGatherer final : NoCopy{
public:
    MaterialPassGatherer(RendererMaterialSystem& system, Core::ECS::World& world, RendererMeshSystem& meshSystem, RendererCsgSystem& csgSystem, CsgShapeRegistry& csgShapeRegistry, const RendererOpticalVolumeSelection& opticalVolumes)noexcept
        : m_system(system), m_world(world), m_meshSystem(meshSystem), m_csgSystem(csgSystem), m_csgShapeRegistry(csgShapeRegistry), m_opticalVolumes(opticalVolumes)
    {}


public:
    void gather(
        Core::Framebuffer* framebuffer,
        const MaterialPipelinePass::Enum pass,
        const b8 transparent,
        const CsgFrameState& csgFrameState,
        const RendererResourceLookupMode::Enum lookupMode,
        const MeshViewGpuData* const csgWorkRegionMeshViewState,
        MaterialPassDrawItemPartitions& drawItems,
        InstanceGpuDataVector& instanceData,
        CsgFrameGpuData& csgFrameData,
    #if defined(NWB_DEBUG)
        ECSRenderDetail::MaterialTypedInstanceRangeVector& materialTypedRanges,
    #endif
        MaterialTypedByteDataVector& materialTypedBytes
    );


private:
    RendererMaterialSystem& m_system;
    Core::ECS::World& m_world;
    RendererMeshSystem& m_meshSystem;
    RendererCsgSystem& m_csgSystem;
    CsgShapeRegistry& m_csgShapeRegistry;
    const RendererOpticalVolumeSelection& m_opticalVolumes;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MaterialTypedStager final : NoCopy{
public:
    MaterialTypedStager(RendererMaterialSystem& system, Core::ECS::World& world, RendererResourceLookupMode::Enum lookupMode, MaterialTypedByteDataVector& bytes, usize capacity);


public:
    [[nodiscard]] Expected<MaterialTypedByteRange> constant(const MaterialSurfaceInfo& materialInfo);
    [[nodiscard]] Expected<MaterialTypedByteRange> mutableInstance(Core::ECS::EntityID entity, const MaterialSurfaceInfo& materialInfo);


private:
    [[nodiscard]] Expected<MaterialTypedByteRange> defaultMutable(const MaterialSurfaceInfo& materialInfo);
    using RangeMap = HashMap<MaterialTypedByteRangeKey, MaterialTypedByteRangeCache, Core::Alloc::ScratchArena, ECSRenderDetail::MaterialTypedByteRangeKeyHasher, EqualTo<MaterialTypedByteRangeKey>>;


private:
    RendererMaterialSystem& m_system;
    Core::ECS::World& m_world;
    RendererResourceLookupMode::Enum m_lookupMode;
    MaterialTypedByteDataVector& m_bytes;
    RangeMap m_ranges;
    ECSRenderDetail::MaterialTypedByteContentRangeMap m_mutableRanges;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct MaterialPipelineBuildInputs{
    RendererMaterialSystem& system;
    RendererShaderSystem& shaderSystem;
    RendererMaterialState& materialState;
    MaterialPipelineResources& resources;
    const MaterialSurfaceInfo& materialInfo;
    const MaterialPipelineKey& pipelineKey;
    Core::Framebuffer& framebuffer;
    Core::Device& device;
    Core::GpuDescriptorHeap& heap;
    const Core::RenderState& renderState;
    const Core::BindingLayoutHandle& materialPassBindingLayout;
    const Name& materialKey;
    Name sharedMeshShaderAssetName;
    Name passPixelShaderName;
    Name passPixelShaderDebugName;
    AStringView pixelShaderVariant;
    AStringView meshShaderVariant;
    AStringView avboitCsgShaderVariant;
    MaterialPipelinePass::Enum pass;
    b8 avboitCsgClipPipeline;
};

class MaterialPipelineBuilder final : NoCopy{
public:
    explicit MaterialPipelineBuilder(const MaterialPipelineBuildInputs& inputs)noexcept : m_inputs(inputs){}


public:
    [[nodiscard]] b8 buildMesh();
    [[nodiscard]] b8 buildIndexed();
    [[nodiscard]] b8 buildCompute();


private:
    [[nodiscard]] b8 loadPassPixelShader();


private:
    const MaterialPipelineBuildInputs& m_inputs;
};


