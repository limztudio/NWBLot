    for(const auto& event : events){
        EXPECT_TRUE(send(event).commandConsumed);
        EXPECT_FALSE(take());
        EXPECT_TRUE(release(Core::Key::F10).commandConsumed);
    }
    EXPECT_TRUE(m_router.actions().empty());
    EXPECT_TRUE(m_router.controlActions().empty());
}

