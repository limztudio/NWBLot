void VerifyUiTextRegionTests_ContentRowsPreserveDescendersStackedAccentsMultilineAndKoreanFallbackCoverage(mut UiTextRegionTests self){
    ASSERT_NO_FATAL_FAILURE(self.useDefaultButtonPadding());
