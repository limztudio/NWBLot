#include <impl/ecs_render/reflection/types.adhd>
#include <impl/ecs_render/reflection/feedback.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ReflectionFeedbackSnapshot{
    public ReflectionFeedbackControlHandle control;
    public ReflectionFeedbackPlan plan;
    public ReflectionFeedbackExtent extent;
    public ReflectionFeedbackBinding current;
    public ReflectionFeedbackBinding previous;

    public b8 valid()const{
        return this.control.valid() && (!this.plan.eligible || (this.extent.valid() && this.current.valid() && this.previous.valid()));
    }
}

[modular]
class RendererReflectionFeedback : NoCopy{
    private SharedPool m_versions = SharedPool();
    private mut GraphicsRuntime m_graphics;
    private ReflectionFeedbackControlHandle m_control;
    private Array<ReflectionFeedbackBinding, s_ReflectionFeedbackBankCount> m_banks;
    private ReflectionFeedbackExtent m_extent;
    private u16 m_deviceGeneration = 0u;

    public RendererReflectionFeedback(mut GraphicsRuntime graphics){ this.m_graphics = graphics; }
    [cpp_unwind]
    public void invalidateResources();
    [cpp_unwind]
    public b8 prepareResources(in u32 width, in u32 height, in ReflectionSettings settings, in b8 enabled);
    public ReflectionFeedbackSnapshot snapshot(in ReflectionSceneContentStamp stamp, in ReflectionSettings settings, in b8 enabled, in u64 graphicsFrameIndex)const;
    [cpp_unwind]
    private void releaseBuffers();
    [cpp_unwind]
    private Expected<ReflectionFeedbackBinding> prepareBank(in u32 byteCount, in Name name);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

