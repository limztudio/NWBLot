b8 WriteMaterialBindShaderProbe(mut TestArena testArena, in GraphicsTestPath root, in StringView assetType, in StringView metadataName, in StringView sourceName, in StringView source){
    const Path includes = GetGraphicsTestRepoRoot(testArena) / s_EngineDirectory / s_AssetsDirectory / s_GraphicsDirectory;
    String metadata;
    GraphicsStringAppendFormat(metadata, "{} asset;\n\nasset.entry_point = \"main\";\nasset.include_roots = [\"{}\"];\n", assetType, PathToString(includes));
    if(!WriteTextFile(root / s_ShadersDirectory / metadataName, metadata))
        return false;
    return WriteTextFile(root / s_ShadersDirectory / sourceName, source);
}

b8 WriteMaterialBindIntegrationAssetsWithPixel(mut TestArena testArena, in GraphicsTestPath assetRoot, in StringView bindText, in StringView materialText, in StringView pixelSourceText){
    if(!WriteTextFile(assetRoot / s_MaterialInterfacesDirectory / s_SurfaceBindFilename, bindText))
        return false;
    if(!WriteMaterialBindShaderProbe(testArena, assetRoot, "mesh_shader", "material_mesh.nwb", "material_mesh.slang", s_MaterialBindMeshSource))
        return false;
    if(!WriteMaterialBindShaderProbe(testArena, assetRoot, "pixel_shader", "material_ps.nwb", "material_ps.slang", pixelSourceText))
        return false;
    if(!WriteTextFile(assetRoot / s_ShadersDirectory / "material_bxdf.bxdf", s_MaterialBindBxdfSource))
        return false;
    return WriteTextFile(assetRoot / "materials" / "test_material.nwb", materialText);
}

b8 WriteMaterialBindDiscoveryMetadata(in GraphicsTestPath assetRoot){
    if(!WriteTextFile(assetRoot / s_MaterialInterfacesDirectory / "bind_discovery.nwb", "include asset;\r\n\r\nasset.defines = { \"NWB_TEST_MATERIAL_BIND_DISCOVERY\": [\"1\"] };\r\n"))
        return false;
    return WriteTextFile(
        assetRoot / s_MaterialInterfacesDirectory / "bind_discovery.slangi",
        "// limztudio@gmail.com\r\n////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////\r\n\r\n\r\n#ifndef NWB_TEST_MATERIAL_BIND_DISCOVERY_SLANGI\r\n#define NWB_TEST_MATERIAL_BIND_DISCOVERY_SLANGI\r\n\r\n\r\n////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////\r\n\r\n\r\n#endif\r\n\r\n\r\n////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////\r\n\r\n"
    );
}

b8 CookMinimalMeshWithMaterialBind(in StringView bindText, in CookCase cookCase, mut TestArena testArena){
    const GraphicsTestPath assetRoot = cookCase.root / s_AssetsDirectory;
    if(!WriteMaterialBindDiscoveryMetadata(assetRoot) || !WriteTextFile(assetRoot / s_MeshesDirectory / "minimal_mesh.nwb", s_MinimalMeshMeta))
        return false;
    if(!WriteTextFile(assetRoot / s_MaterialInterfacesDirectory / s_SurfaceBindFilename, bindText))
