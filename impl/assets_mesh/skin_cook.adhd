#include <impl/assets_mesh/cook_types.adhd>
#include <impl/assets_mesh/skin_asset.adhd>
#include <impl/assets_mesh/skin_binary_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateSkinCookInverseBindMatrix(in MatrixSingle matrix, in StringView filePathText, in usize matrixIndex){
    if(IsValidSkinInverseBindMatrix(matrix))
        return true;

    error(
        "Skin meta '{}': inverse_bind_matrices[{}] is not a finite invertible affine matrix"
        , filePathText
        , matrixIndex
    );
    return false;
}

b8 ValidateSkinCookInverseBindMatricesNonEmpty(in usize matrixCount, in StringView filePathText){
    if(matrixCount != 0u)
        return true;

    error("Skin meta '{}': '{}' must not be empty", filePathText, s_SkinInverseBindMatricesField);
    return false;
}

b8 SerializeSkinBinaryPayload(
    in NameHash meshNameHash,
    in NameHash skeletonNameHash,
    in Span<SkinInfluence4> influences,
    in Span<SkeletonJointMatrix> inverseBindMatrices,
    mut Vector<u8> outBinary
){
    SkinBinaryCodec codec;
    return codec.serialize(meshNameHash, skeletonNameHash, influences, inverseBindMatrices, outBinary);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SkinCookEntry{
    public Name virtualPath = s_NameNone;
    public AssetRef<Mesh> mesh;
    public AssetRef<Skeleton> skeleton;
    public Vector<SkinInfluence4> influences;
    public Vector<SkeletonJointMatrix> inverseBindMatrices;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ParseSkinInfluenceMetadataEntry(
    in Path nwbFilePath,
    in MetascriptValue influenceValue,
    in StringView metaKind,
    in StringView ownerPrefix,
    in usize influenceIndex,
    in b8 normalizeWeights,
    mut Vector<SkinInfluence4> outInfluences
){
    if(!influenceValue.isMap()){
        if(ownerPrefix.empty())
            error("{} meta '{}': influences[{}] must be a map", metaKind, nwbFilePath, influenceIndex);
        else
            error("{} meta '{}': '{}.influences[{}]' must be a map", metaKind, nwbFilePath, ownerPrefix, influenceIndex);
        return false;
    }

    if(normalizeWeights){
        if(!ValidateMetadataAssetFields(nwbFilePath, influenceValue, s_SkinInfluenceDiagnosticPrefix, lambda[](in StringView fieldName) -> b8{
            return IsAllowedSkinInfluenceMetadataField(fieldName);
        }))
            return false;
    }

    b8 foundJoints = false;
    b8 jointsIsList = false;
    Span<MetascriptValue> jointList = Span<MetascriptValue>();
    influenceValue.visitField(
        s_SkinJointsField,
        lambda[mut foundJoints, mut jointsIsList, mut jointList](in MetascriptValue value) -> void{
            foundJoints = true;
            jointsIsList = value.isList();
            if(jointsIsList)
                jointList = value.listView();
        }
    );

    b8 foundWeights = false;
    b8 weightsIsList = false;
    Span<MetascriptValue> weightList = Span<MetascriptValue>();
    influenceValue.visitField(
        s_SkinWeightsField,
        lambda[mut foundWeights, mut weightsIsList, mut weightList](in MetascriptValue value) -> void{
            foundWeights = true;
            weightsIsList = value.isList();
            if(weightsIsList)
                weightList = value.listView();
        }
    );

    if(!foundJoints || !foundWeights){
        error("{} meta '{}': influences[{}] requires 'joints' and 'weights'", metaKind, nwbFilePath, influenceIndex);
        return false;
    }
    if(!jointsIsList || jointList.size() != cast<usize>(s_SkinInfluenceJointCount)){
        error("{} meta '{}': '{}' must be a {}-component {} list", metaKind, nwbFilePath, s_SkinJointsField, s_SkinInfluenceJointCount, s_SkinIntegerListValueKind);
        return false;
    }
    if(!weightsIsList || weightList.size() != cast<usize>(s_SkinInfluenceJointCount)){
        error("{} meta '{}': '{}' must be a {}-component {} list", metaKind, nwbFilePath, s_SkinWeightsField, s_SkinInfluenceJointCount, s_SkinNumericListValueKind);
        return false;
    }

    SkinInfluence4 influence;
    Array<f32, 4> parsedWeights = Array<f32, 4>();
    for(usize componentIndex = 0u; componentIndex < cast<usize>(s_SkinInfluenceJointCount); ++componentIndex){
        const MetascriptValue jointValue = jointList[componentIndex];
        f64 jointNumericValue = 0.0;
        const b8 jointIsNumeric = jointValue.isNumeric();
        if(jointIsNumeric)
            jointNumericValue = jointValue.toDouble();
        const Expected<u16> parsedJoint = TryValidateSkinInfluenceJointIndex(jointIsNumeric, jointNumericValue);
        if(!parsedJoint.has_value()){
            error("{} meta '{}': '{}[{}]' must be a u16 integer", metaKind, nwbFilePath, s_SkinJointsField, componentIndex);
            return false;
        }
        const MetascriptValue weightValue = weightList[componentIndex];
        f64 weightNumericValue = 0.0;
        const b8 weightIsNumeric = weightValue.isNumeric();
        if(weightIsNumeric)
            weightNumericValue = weightValue.toDouble();
        const Expected<f32, MetadataF32ValueFailure> parsedWeight = ValidateMetadataFiniteF32Number(weightIsNumeric, weightNumericValue);
        if(!parsedWeight.has_value()){
            error("{} meta '{}': '{}[{}]' is non-finite or outside f32 range", metaKind, nwbFilePath, s_SkinWeightsField, componentIndex);
            return false;
        }
        influence.joint[componentIndex] = parsedJoint.value();
        parsedWeights[componentIndex] = parsedWeight.value();
    }

    const f32x4u packedWeights = f32x4u(parsedWeights[0u], parsedWeights[1u], parsedWeights[2u], parsedWeights[3u]);
    if(normalizeWeights){
        const Expected<f32x4u, SkinInfluenceWeightFailure> normalizedWeights = TryNormalizeSkinInfluenceWeights(packedWeights);
        if(!normalizedWeights.has_value()){
            const StringView reason = ResolveSkinInfluenceWeightFailureReason(normalizedWeights.error());
            if(!reason.empty())
                error("{} meta '{}': influences[{}].weights {}", metaKind, nwbFilePath, influenceIndex, reason);
            return false;
        }
        influence.weight = normalizedWeights.value();
    }
    else
        influence.weight = packedWeights;

    outInfluences.push_back(influence);
    return true;
}

b8 ParseSkinInfluenceMetadataInto(
    in Path nwbFilePath,
    in MetascriptValue skinAsset,
    in StringView metaKind,
    in StringView ownerPrefix,
    in b8 normalizeWeights,
    mut Vector<SkinInfluence4> outInfluences
){
    outInfluences.clear();
    b8 listValid = false;
    Span<MetascriptValue> list = Span<MetascriptValue>();
    skinAsset.visitField(
        s_SkinInfluencesField,
        lambda[mut listValid, mut list](in MetascriptValue value) -> void{
            listValid = value.isList();
            if(listValid)
                list = value.listView();
        }
    );
    if(!listValid){
        error("{} meta '{}': field '{}' must be a list", metaKind, nwbFilePath, s_SkinInfluencesField);
        return false;
    }

    outInfluences.reserve(list.size());
    for(usize influenceIndex = 0u; influenceIndex < list.size(); ++influenceIndex){
        if(!ParseSkinInfluenceMetadataEntry(nwbFilePath, list[influenceIndex], metaKind, ownerPrefix, influenceIndex, normalizeWeights, outInfluences))
            return false;
    }

    if(outInfluences.empty()){
        error("{} meta '{}': '{}' must not be empty", metaKind, nwbFilePath, s_SkinInfluencesField);
        return false;
    }
    return true;
}


