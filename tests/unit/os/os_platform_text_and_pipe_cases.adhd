void VerifyX11ClipboardFixture_PropertyAbsenceAndRetiredWindowPreserveDifferentNativeResults(mut X11ClipboardFixture self){
    b8 createdOk = false;
    b8 retiredNonZero = false;
    b8 absentOk = false;
    u64 absentType = 1u;
    usize absentCount = 1u;
    b8 destroyedOk = false;
    b8 failedHasValue = true;
    u8 failedErrorCode = 0u;
    u8 expectedBadWindow = 1u;
    native(mut self, mut createdOk, mut retiredNonZero, mut absentOk, mut absentType, mut absentCount, mut destroyedOk, mut failedHasValue, mut failedErrorCode, mut expectedBadWindow){
#if defined(FOUNDATION_PLATFORM_LINUX)
        expectedBadWindow = static_cast<u8>(BadWindow);
        Window retired = 0u;
        {
            NWB::Core::X11CheckedOperation created(*self.m_displays[0]);
            retired = XCreateSimpleWindow(self.m_displays[0], DefaultRootWindow(self.m_displays[0]), 0, 0, 1, 1, 0, 0, 0);
            createdOk = created.succeeded();
            retiredNonZero = retired != 0u;
        }
        if(createdOk && retiredNonZero){
            const auto absent = NWB::Core::ReadX11Property(*self.m_displays[0], retired, XA_STRING, false, 16u);
            absentOk = absent.has_value();
            if(absent){
                absentType = static_cast<u64>(absent->type);
                absentCount = absent->count;
            }
            {
                NWB::Core::X11CheckedOperation destroyed(*self.m_displays[0]);
                XDestroyWindow(self.m_displays[0], retired);
                destroyedOk = destroyed.succeeded();
            }
            const auto failed = NWB::Core::ReadX11Property(*self.m_displays[0], retired, XA_STRING, false, 16u);
            failedHasValue = failed.has_value();
            if(!failed)
                failedErrorCode = failed.error().errorCode;
        }
#endif
    }
    ASSERT_TRUE(createdOk);
    ASSERT_TRUE(retiredNonZero);
    ASSERT_TRUE(absentOk);
    EXPECT_EQ(absentType, 0u);
    EXPECT_EQ(absentCount, 0u);
    ASSERT_TRUE(destroyedOk);
    ASSERT_FALSE(failedHasValue);
    EXPECT_EQ(failedErrorCode, expectedBadWindow);
}

void VerifyX11ClipboardFixture_WritingPrimarySelectionDoesNotOverwriteClipboardUtf8(mut X11ClipboardFixture self){
    const StringView clipboard = "clipboard \xec\x95\x88\xeb\x85\x95 \xf0\x9f\x99\x82";
    const StringView primary = "primary caf\xc3\xa9";
    ASSERT_TRUE(self.canReadPrimarySelection());
    ASSERT_TRUE(self.writeText(0u, ClipboardChannel::Clipboard, clipboard));
    ASSERT_TRUE(self.writeText(0u, ClipboardChannel::PrimarySelection, primary));

    StandaloneClipboardCompletion out = StandaloneClipboardCompletion();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> clipAdmission = self.requestRead(1u, ClipboardChannel::Clipboard);
    ASSERT_TRUE(clipAdmission.has_value());
    ASSERT_TRUE(self.awaitServiceCompletion(1u, clipAdmission.value(), out.completion));
    ASSERT_EQ(out.completion.status, ClipboardStatus::Success);
    EXPECT_EQ(out.completion.text, clipboard);

    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> primaryAdmission = self.requestRead(1u, ClipboardChannel::PrimarySelection);
    ASSERT_TRUE(primaryAdmission.has_value());
    ASSERT_TRUE(self.awaitServiceCompletion(1u, primaryAdmission.value(), out.completion));
    ASSERT_EQ(out.completion.status, ClipboardStatus::Success);
    EXPECT_EQ(out.completion.text, primary);
}

void VerifyX11ClipboardFixture_IncrementalReadRetainsSnapshotAfterOwnerLosesSelection(mut X11ClipboardFixture self){
    ClipboardPipeContext scratchCtx = ClipboardPipeContext();
    FillGlobalString(scratchCtx.input, 200000u, 0x78u);
    ReplaceGlobalString(scratchCtx.input, 65534u, 1u, "\xf0\x9f\x99\x82");
    const StringView originalView = ViewGlobalString(scratchCtx.input);
    ASSERT_TRUE(self.writeText(0u, ClipboardChannel::Clipboard, originalView));
    self.m_sawSelectionRequest = false;

    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> tokenAdmission = self.requestRead(1u, ClipboardChannel::Clipboard);
    ASSERT_TRUE(tokenAdmission.has_value());
    const ClipboardRequestToken token = tokenAdmission.value();
    ASSERT_TRUE(self.waitForSelectionRequest());
    ASSERT_TRUE(self.m_sawSelectionRequest);

    u64 replacementWindow = 0u;
    b8 ownerReplaced = false;
    native(mut self, mut replacementWindow, mut ownerReplaced){
#if defined(FOUNDATION_PLATFORM_LINUX)
        using namespace __hidden_os_platform_cases_support;
        const Window replacement = XCreateSimpleWindow(self.m_displays[1], DefaultRootWindow(self.m_displays[1]), 0, 0, 1, 1, 0, 0, 0);
        replacementWindow = static_cast<u64>(replacement);
        if(replacement != 0u){
            const Atom clipboard = XInternAtom(self.m_displays[1], s_ClipboardAtomName.data(), False);
            XSetSelectionOwner(self.m_displays[1], clipboard, replacement, CurrentTime);
            XSync(self.m_displays[1], False);
            ownerReplaced = XGetSelectionOwner(self.m_displays[1], clipboard) == replacement;
        }
#endif
    }
    ASSERT_NE(replacementWindow, 0u);
    ASSERT_TRUE(ownerReplaced);

    StandaloneClipboardCompletion out = StandaloneClipboardCompletion();
    ASSERT_TRUE(self.awaitServiceCompletion(1u, token, out.completion));
    EXPECT_EQ(out.completion.status, ClipboardStatus::Success);
    EXPECT_EQ(out.completion.text, originalView);

    native(mut self, in replacementWindow){
#if defined(FOUNDATION_PLATFORM_LINUX)
        XDestroyWindow(self.m_displays[1], static_cast<Window>(replacementWindow));
        XSync(self.m_displays[1], False);
#endif
    }
}

void VerifyX11ClipboardFixture_CancelledRequestWindowCannotCompleteFreshRequest(mut X11ClipboardFixture self){
    ASSERT_TRUE(self.writeText(0u, ClipboardChannel::Clipboard, "first"));
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> cancelledAdmission = self.requestRead(1u, ClipboardChannel::Clipboard);
    ASSERT_TRUE(cancelledAdmission.has_value());
    const ClipboardRequestToken cancelled = cancelledAdmission.value();
    ASSERT_TRUE(self.pumpService(1u));
    ASSERT_TRUE(self.cancelService(1u, cancelled));
    ASSERT_TRUE(self.writeText(0u, ClipboardChannel::Clipboard, "after cancellation"));

    StandaloneClipboardCompletion out = StandaloneClipboardCompletion();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> freshAdmission = self.requestRead(1u, ClipboardChannel::Clipboard);
    ASSERT_TRUE(freshAdmission.has_value());
    ASSERT_TRUE(self.awaitServiceCompletion(1u, freshAdmission.value(), out.completion));
    EXPECT_EQ(out.completion.status, ClipboardStatus::Success);
    EXPECT_EQ(out.completion.text, "after cancellation");
    EXPECT_EQ(self.pollService(1u, cancelled, out.completion), ClipboardPollResult::InvalidRequest);
}

void VerifyX11ClipboardFixture_QueuedOwnershipLossCannotClearNewlyReacquiredText(mut X11ClipboardFixture self){
    ASSERT_TRUE(self.writeText(0u, ClipboardChannel::Clipboard, "before ownership loss"));

    u64 temporaryWindow = 0u;
    b8 temporaryOwned = false;
    b8 queuedLoss = false;
    b8 selectionMatched = false;
    StandaloneClipboardCompletion out = StandaloneClipboardCompletion();

    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> writeAdmission = self.requestWrite(0u, ClipboardChannel::Clipboard, "after reacquisition");
    ASSERT_TRUE(writeAdmission.has_value());
    const ClipboardRequestToken writeToken = writeAdmission.value();
    ASSERT_TRUE(writeToken.valid());

    b8 reacquiredOk = false;
    b8 ownerMovedAway = false;
    b8 lossDispatched = false;
    native(mut self, in writeToken, mut out, mut temporaryWindow, mut temporaryOwned, mut queuedLoss, mut selectionMatched, mut reacquiredOk, mut ownerMovedAway, mut lossDispatched){
#if defined(FOUNDATION_PLATFORM_LINUX)
        using namespace __hidden_os_platform_cases_support;
        const Atom clipboard = XInternAtom(self.m_displays[1], s_ClipboardAtomName.data(), False);
        const Window temporaryOwner = XCreateSimpleWindow(self.m_displays[1], DefaultRootWindow(self.m_displays[1]), 0, 0, 1, 1, 0, 0, 0);
        temporaryWindow = static_cast<u64>(temporaryOwner);
        if(temporaryOwner != 0u){
            XSetSelectionOwner(self.m_displays[1], clipboard, temporaryOwner, CurrentTime);
            XSync(self.m_displays[1], False);
            temporaryOwned = XGetSelectionOwner(self.m_displays[1], clipboard) == temporaryOwner;
        }
        XEvent ownershipLoss{};
        if(temporaryOwned){
            const Timer lossDeadline = TimerAddMS(TimerNow(), s_SelectionChangeTimeoutMS);
            while(!queuedLoss && TimerNow() < lossDeadline){
                queuedLoss = XCheckTypedEvent(self.m_displays[0], SelectionClear, &ownershipLoss) != False;
                if(!queuedLoss)
                    SleepMS(s_PollIntervalMS);
            }
            selectionMatched = ownershipLoss.xselectionclear.selection == clipboard;
        }
        if(queuedLoss && selectionMatched){
            reacquiredOk = self.awaitCompletion(writeToken, *self.m_services[0], out.completion) && out.completion.status == NWB::Core::ClipboardStatus::Success;
            ownerMovedAway = XGetSelectionOwner(self.m_displays[1], clipboard) != temporaryOwner;
            lossDispatched = NWB::Core::DispatchX11ClipboardEvent(*self.m_services[0], ownershipLoss);
        }
#endif
    }
    ASSERT_NE(temporaryWindow, 0u);
    ASSERT_TRUE(temporaryOwned);
    ASSERT_TRUE(queuedLoss);
    ASSERT_TRUE(selectionMatched);
    ASSERT_TRUE(reacquiredOk);
    ASSERT_TRUE(ownerMovedAway);
    ASSERT_TRUE(lossDispatched);
    ASSERT_TRUE(self.pumpAll());

    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> readAdmission = self.requestRead(1u, ClipboardChannel::Clipboard);
    ASSERT_TRUE(readAdmission.has_value());
    ASSERT_TRUE(self.awaitServiceCompletion(1u, readAdmission.value(), out.completion));
    EXPECT_EQ(out.completion.status, ClipboardStatus::Success);
    EXPECT_EQ(out.completion.text, "after reacquisition");

    native(mut self, in temporaryWindow){
#if defined(FOUNDATION_PLATFORM_LINUX)
        XDestroyWindow(self.m_displays[1], static_cast<Window>(temporaryWindow));
        XSync(self.m_displays[1], False);
#endif
    }
}


