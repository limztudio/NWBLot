void VerifyUiEditModelTests_SelectionRejectsInteriorScalarAndGraphemeOffsets(mut UiEditModelTests self){
    ASSERT_TRUE(self.m_model.setText("a\xCC\x81z"));
    ASSERT_TRUE(self.m_model.setSelection(0u, 3u));
    EXPECT_EQ(self.m_model.selectedText(), "a\xCC\x81");
    EXPECT_FALSE(self.m_model.setSelection(1u, 3u));
    EXPECT_FALSE(self.m_model.setSelection(2u, 3u));
    EXPECT_FALSE(self.m_model.setSelection(0u, 5u));
    EXPECT_EQ(self.m_model.anchor(), 0u);
    EXPECT_EQ(self.m_model.caret(), 3u);
}

void VerifyUiEditModelTests_MovementAndDeletionPreserveWholeCombiningGraphemes(mut UiEditModelTests self){
    ASSERT_TRUE(self.m_model.setText("a\xCC\x81z"));
    ASSERT_TRUE(self.m_model.move(EditMove::Home));
    ASSERT_TRUE(self.m_model.move(EditMove::Right));
    EXPECT_EQ(self.m_model.caret(), 3u);
    ASSERT_TRUE(self.m_model.backspace());
    EXPECT_EQ(self.m_model.text(), "z");
    EXPECT_EQ(self.m_model.caret(), 0u);
    ASSERT_TRUE(self.m_model.eraseForward());
    EXPECT_TRUE(self.m_model.text().empty());
    const u64 revision = self.m_model.revision();
    ASSERT_TRUE(self.m_model.backspace());
    ASSERT_TRUE(self.m_model.eraseForward());
    EXPECT_EQ(self.m_model.revision(), revision);
}

void VerifyUiEditModelTests_DevanagariConjunctAndKoreanJamoAreSingleEditableGraphemes(mut UiEditModelTests self){
    const StringView conjunct = "\xE0\xA4\x95\xE0\xA5\x8D\xE0\xA4\xB7";
    ASSERT_TRUE(self.m_model.setText(conjunct));
    ASSERT_EQ(self.m_model.graphemeBoundaries().size(), 2u);
    ASSERT_TRUE(self.m_model.backspace());
    EXPECT_TRUE(self.m_model.text().empty());
    const StringView jamo = "\xE1\x84\x80\xE1\x85\xA1\xE1\x86\xA8";
    ASSERT_TRUE(self.m_model.setText(jamo));
    ASSERT_TRUE(self.m_model.move(EditMove::Home));
    ASSERT_TRUE(self.m_model.eraseForward());
    EXPECT_TRUE(self.m_model.text().empty());
}

void VerifyUiEditModelTests_ReplacementCopiesAliasedCommittedText(mut UiEditModelTests self){
    ASSERT_TRUE(self.m_model.setText("abc"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 2u));
    ASSERT_TRUE(self.m_model.replaceSelection(self.m_model.text()));
    EXPECT_EQ(self.m_model.text(), "aabcc");
    EXPECT_EQ(self.m_model.caret(), 4u);
}

void VerifyUiEditModelTests_InsertionMayMergeClustersAndCaretUsesFollowingValidBoundary(mut UiEditModelTests self){
    ASSERT_TRUE(self.m_model.setText("a"));
    ASSERT_TRUE(self.m_model.replaceSelection("\xCC\x81"));
    EXPECT_EQ(self.m_model.text(), "a\xCC\x81");
    EXPECT_EQ(self.m_model.caret(), 3u);
    EXPECT_EQ(self.m_model.graphemeBoundaries().size(), 2u);
    ASSERT_TRUE(self.m_model.setText("\xCC\x81"));
    ASSERT_TRUE(self.m_model.move(EditMove::Home));
    ASSERT_TRUE(self.m_model.replaceSelection("a"));
    EXPECT_EQ(self.m_model.caret(), 3u);
    ASSERT_TRUE(self.m_model.backspace());
    EXPECT_TRUE(self.m_model.text().empty());
}

void VerifyUiEditModelTests_InvalidUtf8AndMultilineValuesPreserveAllCommittedState(mut UiEditModelTests self){
    ASSERT_TRUE(self.m_model.setText("ab"));
    ASSERT_TRUE(self.m_model.replaceSelection("c"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 2u));
    const u64 revision = self.m_model.revision();
    Array<StringView, 9u> invalid = Array<StringView, 9u>();
    invalid[0u] = "\xED\xA0\x80";
    invalid[1u] = "\xC0\xAF";
    invalid[2u] = "\xF4\x90\x80\x80";
    invalid[3u] = "\xE2\x82";
    invalid[4u] = "x\ny";
    invalid[5u] = "x\ry";
    invalid[6u] = "\xE2\x80\xA8";
    invalid[7u] = "\xE2\x80\xA9";
    invalid[8u] = StringView("a\0b", 3u);
    for(in StringView value : invalid){
        EXPECT_FALSE(self.m_model.setText(value));
        EXPECT_FALSE(self.m_model.replaceSelection(value));
        EXPECT_EQ(self.m_model.text(), "abc");
        EXPECT_EQ(self.m_model.anchor(), 1u);
        EXPECT_EQ(self.m_model.caret(), 2u);
        EXPECT_EQ(self.m_model.revision(), revision);
        EXPECT_TRUE(self.m_model.canUndo());
    }
}

void VerifyUiEditModelTests_ByteLimitFailureIsAtomicAndEmptyLimitAcceptsOnlyEmptyText(mut UiEditModelTests self){
    EditModel limited = EditModel(MakeUiEditLimits(3u, 2u, 12u));
    ASSERT_TRUE(limited.setText("ab"));
    const u64 revision = limited.revision();
    EXPECT_FALSE(limited.replaceSelection("cd"));
    EXPECT_FALSE(limited.setText("abcd"));
    EXPECT_EQ(limited.text(), "ab");
    EXPECT_EQ(limited.caret(), 2u);
    EXPECT_EQ(limited.revision(), revision);
    EXPECT_FALSE(limited.canUndo());
    EditModel empty = EditModel(MakeUiEditLimits(0u, 0u, 0u));
    EXPECT_TRUE(empty.setText(""));
    EXPECT_TRUE(empty.replaceSelection(""));
    EXPECT_FALSE(empty.replaceSelection("a"));
}

void VerifyUiEditModelTests_WordRangeRejectsInteriorGraphemeAndKeepsHardLinesSeparate(mut UiEditModelTests self){
    const Expected<EditWordRange> empty = self.m_model.wordRangeAt(0u);
    ASSERT_TRUE(empty.has_value());
    EXPECT_EQ(empty.value().begin, 0u);
    EXPECT_EQ(empty.value().end, 0u);
    ASSERT_TRUE(self.m_model.setText("a\314\201b,  z"));
    EXPECT_FALSE(self.m_model.wordRangeAt(1u).has_value());
    Expected<EditWordRange> range = self.m_model.wordRangeAt(3u);
    ASSERT_TRUE(range.has_value());
    EXPECT_EQ(range.value().begin, 0u);
    EXPECT_EQ(range.value().end, 4u);
    EditModel multiline = EditModel(EditLimits(), EditTextMode::Multiline);
    ASSERT_TRUE(multiline.setText("ab\ncd"));
    range = multiline.wordRangeAt(2u);
    ASSERT_TRUE(range.has_value());
    EXPECT_EQ(range.value().begin, 2u);
    EXPECT_EQ(range.value().end, 3u);
    range = multiline.wordRangeAt(3u);
    ASSERT_TRUE(range.has_value());
    EXPECT_EQ(range.value().begin, 3u);
    EXPECT_EQ(range.value().end, 5u);
}

void VerifyUiEditModelTests_ExternalValueResetsSelectionHistoryAndComposition(mut UiEditModelTests self){
    ASSERT_TRUE(self.m_model.setText("abc"));
    ASSERT_TRUE(self.m_model.replaceSelection("d"));
    ASSERT_TRUE(self.m_model.selectAll());
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("x", 0u, 1u));
    ASSERT_TRUE(self.m_model.setText("reset"));
    EXPECT_EQ(self.m_model.text(), "reset");
    EXPECT_EQ(self.m_model.caret(), 5u);
    EXPECT_FALSE(self.m_model.hasSelection());
    EXPECT_FALSE(self.m_model.composition().active);
    EXPECT_FALSE(self.m_model.canUndo());
}


