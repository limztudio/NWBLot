// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/raytrace/raytrace_internal.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MeshSwBvhBuildPlanDecision{
    public u32 primitiveCount = 0u;
    public u32 refitsBeforeBuild = 0u;
    public u32 refitsAfterBuild = 0u;
    public b8 firstBuild = false;
    public b8 performRefit = false;
}

class PreparedMeshSwBvhPlanPolicy{
    public b8 matchesCoreRevisionState(
        in Name meshName,
        in Name buildMeshName,
        in b8 runtimeMesh,
        in b8 buildRuntimeMesh,
        in u64 runtimeMeshVersion,
        in u64 buildRuntimeMeshVersion,
        in u64 geometryContentRevision,
        in u64 buildGeometryContentRevision,
        in u64 acceptedGeometryContentRevision,
        in u64 buildAcceptedGeometryContentRevision,
        in u32 refitsSinceRebuild,
        in u32 buildRefitsBeforeBuild,
        in b8 buildPending,
        in b8 expectedBuildPending
    )const{
        return meshName == buildMeshName
            && runtimeMesh == buildRuntimeMesh
            && runtimeMeshVersion == buildRuntimeMeshVersion
            && geometryContentRevision == buildGeometryContentRevision
            && acceptedGeometryContentRevision == buildAcceptedGeometryContentRevision
            && refitsSinceRebuild == buildRefitsBeforeBuild
            && buildPending == expectedBuildPending;
    }

    public b8 matchesFirstBuildFlag(in b8 swBvhTopologyBuilt, in b8 swBvhBuildAccepted, in b8 expectedFirstBuild)const{
        const b8 currentFirstBuild = !swBvhTopologyBuilt || !swBvhBuildAccepted;
        return currentFirstBuild == expectedFirstBuild;
    }

    public b8 matchesBackingByteSizes(
        in usize positionBytes,
        in usize expectedPositionBytes,
        in usize indexBytes,
        in usize expectedIndexBytes,
        in usize nodeBytes,
        in usize expectedNodeBytes,
        in usize parentBytes,
        in usize expectedParentBytes,
        in usize sortKeysBytes,
        in usize expectedSortKeysBytes,
        in usize sortPayloadBytes,
        in usize expectedSortPayloadBytes,
        in usize visitCounterBytes,
        in usize expectedVisitCounterBytes
    )const{
        return positionBytes == expectedPositionBytes
            && indexBytes == expectedIndexBytes
            && nodeBytes == expectedNodeBytes
            && parentBytes == expectedParentBytes
            && sortKeysBytes == expectedSortKeysBytes
            && sortPayloadBytes == expectedSortPayloadBytes
            && visitCounterBytes == expectedVisitCounterBytes;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


MeshSwBvhBuildPlanDecision ResolveMeshSwBvhBuildPlanDecision(in u32 primitiveIndexCount, in b8 runtimeMesh, in b8 swBvhTopologyBuilt, in b8 swBvhBuildAccepted, in u32 swBvhRefitsSinceRebuild){
    MeshSwBvhBuildPlanDecision decision;
    decision.primitiveCount = ComputeMeshTrianglePrimitiveCount(primitiveIndexCount);
    decision.firstBuild = !swBvhTopologyBuilt || !swBvhBuildAccepted;
    decision.performRefit = ShouldRefitRuntimeMeshAcceleration(runtimeMesh, decision.firstBuild, swBvhRefitsSinceRebuild, decision.primitiveCount);
    decision.refitsBeforeBuild = swBvhRefitsSinceRebuild;
    decision.refitsAfterBuild = AdvanceAccelerationRefitCount(decision.performRefit, swBvhRefitsSinceRebuild);
    return decision;
}


