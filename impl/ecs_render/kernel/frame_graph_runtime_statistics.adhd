#include <impl/ecs_render/kernel/task_timing_telemetry_labels.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_name("::NWB::Core::GpuTaskTelemetryDetail::TranslateQueueClass"), cpp_header("<core/task/gpu/telemetry_queue_class.h>")]
extern Expected<FrameGraphQueueClass> TranslateQueueClass(in CommandQueue queueClass);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanBuildFrameGraphRuntimeStatistics(in b8 statisticsValid, in u64 captureFrameIndex, in u64 sourceFrameIndex){
    return statisticsValid && captureFrameIndex == sourceFrameIndex;
}

b8 HasMatchingPhysicalQueueTelemetryEpochs(
    in u64 compileGraphGeneration,
    in u64 recordingGraphGeneration,
    in u64 submissionGraphGeneration,
    in u64 compilePlanGeneration,
    in u64 recordingPlanGeneration,
    in u64 submissionPlanGeneration,
    in u64 recordingAttemptGeneration,
    in u64 submissionAttemptGeneration,
    in u16 compileDeviceGeneration,
    in u16 recordingDeviceGeneration,
    in u16 submissionDeviceGeneration
){
    return
        compileGraphGeneration == recordingGraphGeneration
        && compileGraphGeneration == submissionGraphGeneration
        && compilePlanGeneration == recordingPlanGeneration
        && compilePlanGeneration == submissionPlanGeneration
        && recordingAttemptGeneration == submissionAttemptGeneration
        && compileDeviceGeneration == recordingDeviceGeneration
        && compileDeviceGeneration == submissionDeviceGeneration
    ;
}

Result TranslateFrameGraphSubmissionStatistics<Result, Statistics>(in Statistics submissionStatistics){
    Result result = Result();
    result.acceptedPacketCount = cast<u64>(submissionStatistics.acceptedPacketCount);
    result.acceptedTaskCount = cast<u64>(submissionStatistics.acceptedTaskCount);
    result.rejectedPacketCount = cast<u64>(submissionStatistics.rejectedPacketCount);
    result.rejectedTaskCount = cast<u64>(submissionStatistics.rejectedTaskCount);
    result.nativeSubmissionCount = cast<u64>(submissionStatistics.nativeSubmissionCount);
    result.rejectedSubmissionCount = cast<u64>(submissionStatistics.rejectedSubmissionCount);
    result.nativeCommandListCount = cast<u64>(submissionStatistics.nativeCommandListCount);
    result.plannedWaitTokenCount = cast<u64>(submissionStatistics.plannedWaitTokenCount);
    result.sameQueueWaitElisionCount = cast<u64>(submissionStatistics.sameQueueWaitElisionCount);
    result.timelineWaitCount = cast<u64>(submissionStatistics.timelineWaitCount);
    result.mergedTimelineWaitCount = cast<u64>(submissionStatistics.mergedTimelineWaitCount);
    result.inheritedTimelineWaitElisionCount = cast<u64>(submissionStatistics.inheritedTimelineWaitElisionCount);
    result.acceptedFrontierSubmissionCount = cast<u64>(submissionStatistics.acceptedFrontierSubmissionCount);
    result.recoverySubmissionCount = cast<u64>(submissionStatistics.recoverySubmissionCount);
    result.submissionSeconds = submissionStatistics.submissionSeconds;
    return result;
}

Result TranslateFrameGraphRecordingStatistics<Result, Statistics>(in Statistics recordingStatistics){
    Result result = Result();
    result.packetCount = cast<u64>(recordingStatistics.packetCount);
    result.taskCount = cast<u64>(recordingStatistics.taskCount);
    result.commandListCount = cast<u64>(recordingStatistics.commandListCount);
    result.barrierCount = cast<u64>(recordingStatistics.barrierCount);
    result.workerRoutedPacketCount = cast<u64>(recordingStatistics.workerRoutedPacketCount);
    result.parallelPacketCount = cast<u64>(recordingStatistics.parallelPacketCount);
    result.commandListAcquisitionSeconds = recordingStatistics.commandListAcquisitionSeconds;
    result.graphBarrierRecordingSeconds = recordingStatistics.graphBarrierRecordingSeconds;
    result.taskRecordSeconds = recordingStatistics.taskRecordSeconds;
    result.recordingSeconds = recordingStatistics.recordingSeconds;
    return result;
}

FrameGraphRuntimeStatistics BuildFrameGraphRuntimeStatistics(in GpuTaskGraphRuntimeStatistics statistics, in u64 captureFrameIndex, in u64 sourceFrameIndex){
    if(!CanBuildFrameGraphRuntimeStatistics(statistics.valid(), captureFrameIndex, sourceFrameIndex))
        return FrameGraphRuntimeStatistics();

    in GpuTaskGraphCompileStatistics compileStatistics = statistics.compile;
    in GpuTaskGraphRecordingStatistics recordingStatistics = statistics.recording;
    FrameGraphRuntimeStatistics result = FrameGraphRuntimeStatistics();
    result.graphGeneration = compileStatistics.graphGeneration;
    result.planGeneration = compileStatistics.planGeneration;
    result.recordingAttemptGeneration = recordingStatistics.recordingAttemptGeneration;
    result.compile.taskCount = cast<u64>(compileStatistics.taskCount);
    result.compile.resourceCount = cast<u64>(compileStatistics.resourceCount);
    result.compile.resourceVersionCount = cast<u64>(compileStatistics.resourceVersionCount);
    result.compile.resourceVersionEdgeCount = cast<u64>(compileStatistics.resourceVersionEdgeCount);
    result.compile.resourceUseCount = cast<u64>(compileStatistics.resourceUseCount);
    result.compile.explicitDependencyCount = cast<u64>(compileStatistics.explicitDependencyCount);
    result.compile.inferredDependencyCount = cast<u64>(compileStatistics.inferredDependencyCount);
    result.compile.packetCount = cast<u64>(compileStatistics.packetCount);
    result.compile.packetDependencyCount = cast<u64>(compileStatistics.packetDependencyCount);
    result.compile.mergedTaskCount = cast<u64>(compileStatistics.mergedTaskCount);
    result.compile.transitionBarrierCount = cast<u64>(compileStatistics.transitionBarrierCount);
    result.compile.uavBarrierCount = cast<u64>(compileStatistics.uavBarrierCount);
    result.compile.ownershipReleaseBarrierCount = cast<u64>(compileStatistics.ownershipReleaseBarrierCount);
    result.compile.ownershipAcquireBarrierCount = cast<u64>(compileStatistics.ownershipAcquireBarrierCount);
    result.compile.stateExportBarrierCount = cast<u64>(compileStatistics.stateExportBarrierCount);
    result.compile.logicalOwnershipTransferCount = cast<u64>(compileStatistics.logicalOwnershipTransferCount);
    result.compile.logicalOwnershipTransferSignatureCount = cast<u64>(compileStatistics.logicalOwnershipTransferSignatureCount);
    result.compile.repeatedOwnershipTransferSignatureCount = cast<u64>(compileStatistics.repeatedOwnershipTransferSignatureCount);
    result.compile.concurrentSharingCouldAvoidTransferCount = cast<u64>(compileStatistics.concurrentSharingCouldAvoidTransferCount);
    result.compile.concurrentSharingAdviceResourceCount = cast<u64>(compileStatistics.concurrentSharingAdviceResourceCount);
    result.compile.logicalOwnershipTransferInternalCount = cast<u64>(compileStatistics.logicalOwnershipTransferCountByRoute[GpuOwnershipTransferRoute::Internal]);
    result.compile.logicalOwnershipTransferExternalImportCount = cast<u64>(compileStatistics.logicalOwnershipTransferCountByRoute[GpuOwnershipTransferRoute::ExternalImport]);
    result.compile.logicalOwnershipTransferExternalExportCount = cast<u64>(compileStatistics.logicalOwnershipTransferCountByRoute[GpuOwnershipTransferRoute::ExternalExport]);
    result.compile.resourceSetCount = cast<u64>(compileStatistics.resourceSetCount);
    result.compile.resourceSetMemberCount = cast<u64>(compileStatistics.resourceSetMemberCount);
    result.compile.directResourceUseCount = cast<u64>(compileStatistics.directResourceUseCount);
    result.compile.declaredResourceSetUseCount = cast<u64>(compileStatistics.declaredResourceSetUseCount);
    result.compile.expandedResourceSetMemberUseCount = cast<u64>(compileStatistics.expandedResourceSetMemberUseCount);
    result.compile.payloadObjectCount = cast<u64>(compileStatistics.payloadObjectCount);
    result.compile.payloadObjectBytes = cast<u64>(compileStatistics.payloadObjectBytes);
    result.compile.uploadBlobCount = cast<u64>(compileStatistics.uploadBlobCount);
    result.compile.uploadBlobBytes = cast<u64>(compileStatistics.uploadBlobBytes);
    result.compile.declarationSeconds = compileStatistics.declarationSeconds;
    result.compile.analysisSeconds = compileStatistics.analysisSeconds;
    result.compile.validationSeconds = compileStatistics.validationSeconds;
    result.compile.dependencyAnalysisSeconds = compileStatistics.dependencyAnalysisSeconds;
    result.compile.hazardAnalysisSeconds = compileStatistics.hazardAnalysisSeconds;
    result.compile.topologicalOrderSeconds = compileStatistics.topologicalOrderSeconds;
    result.compile.queueAssignmentSeconds = compileStatistics.queueAssignmentSeconds;
    result.compile.planningSeconds = compileStatistics.planningSeconds;
    result.compile.packetizationSeconds = compileStatistics.packetizationSeconds;
    result.compile.resourceStatePlanningSeconds = compileStatistics.resourceStatePlanningSeconds;
    result.compile.packetDependencyPlanningSeconds = compileStatistics.packetDependencyPlanningSeconds;
    result.compile.totalSeconds = compileStatistics.totalSeconds;
    result.recording = TranslateFrameGraphRecordingStatistics<FrameGraphRecordingRuntimeStatistics, GpuTaskGraphRecordingStatistics>(recordingStatistics);
    result.recording.recordingElapsedSeconds = recordingStatistics.recordingElapsedSeconds;
    result.recording.readyFrontierElapsedSeconds = recordingStatistics.readyFrontierElapsedSeconds;
    result.recording.readyFrontierWorkerBusySeconds = recordingStatistics.readyFrontierWorkerBusySeconds;
    result.recording.readyFrontierWorkerCapacitySeconds = recordingStatistics.readyFrontierWorkerCapacitySeconds;
    result.submission = TranslateFrameGraphSubmissionStatistics<FrameGraphSubmissionRuntimeStatistics, GpuTaskGraphSubmissionStatistics>(statistics.submission);
    result.deviceGeneration = compileStatistics.deviceGeneration;
    result.present = true;
    if(!IsValidFrameGraphRuntimeStatistics(result))
        return FrameGraphRuntimeStatistics();
    return result;
}

FrameGraphPacketSubmissionStatisticsRecord BuildFrameGraphPacketSubmissionStatistics(in GpuTaskGraphPacketSubmissionStatistics statistics, in u32 ownerNodeIndex){
    if(!CanBuildPacketSubmissionTelemetry(statistics.valid(), ownerNodeIndex))
        return FrameGraphPacketSubmissionStatisticsRecord();

    const auto queueClass = TranslateQueueClass(statistics.queueClass);
    if(!queueClass.has_value())
        return FrameGraphPacketSubmissionStatisticsRecord();

    FrameGraphPacketSubmissionStatisticsRecord result = FrameGraphPacketSubmissionStatisticsRecord();
    result.packetGeneration = statistics.packet.generation;
    result.taskCount = cast<u64>(statistics.taskCount);
    result.commandListCount = cast<u64>(statistics.nativeCommandListCount);
    result.plannedWaitTokenCount = cast<u64>(statistics.plannedWaitTokenCount);
    result.sameQueueWaitElisionCount = cast<u64>(statistics.sameQueueWaitElisionCount);
    result.timelineWaitCount = cast<u64>(statistics.timelineWaitCount);
    result.mergedTimelineWaitCount = cast<u64>(statistics.mergedTimelineWaitCount);
    result.inheritedTimelineWaitElisionCount = cast<u64>(statistics.inheritedTimelineWaitElisionCount);
    result.submissionSeconds = statistics.submissionSeconds;
    result.ownerNodeIndex = ownerNodeIndex;
    result.packetIndex = statistics.packet.index;
    result.joinsAcceptedQueueFrontier = statistics.joinsAcceptedQueueFrontier;
    result.recoverySubmission = statistics.isRecoverySubmission;
    result.queue.index = statistics.queue.index;
    result.queue.deviceGeneration = statistics.queue.deviceGeneration;
    result.queueClass = queueClass.value();
    if(!IsValidFrameGraphPacketSubmissionStatistics(result))
        return FrameGraphPacketSubmissionStatisticsRecord();
    return result;
}

FrameGraphPhysicalQueueRuntimeStatistics BuildFrameGraphPhysicalQueueRuntimeStatistics(
    in GpuTaskGraphPhysicalQueueCompileStatistics compileStatistics,
    in GpuTaskGraphPhysicalQueueRecordingStatistics recordingStatistics,
    in GpuTaskGraphPhysicalQueueSubmissionStatistics submissionStatistics
){
    if(!compileStatistics.valid() || !recordingStatistics.valid() || !submissionStatistics.valid())
        return FrameGraphPhysicalQueueRuntimeStatistics();
    if(!HasMatchingPhysicalQueueTelemetryEpochs(
        compileStatistics.graphGeneration, recordingStatistics.graphGeneration, submissionStatistics.graphGeneration,
        compileStatistics.planGeneration, recordingStatistics.planGeneration, submissionStatistics.planGeneration,
        recordingStatistics.recordingAttemptGeneration, submissionStatistics.recordingAttemptGeneration,
        compileStatistics.deviceGeneration, recordingStatistics.deviceGeneration, submissionStatistics.deviceGeneration
    ))
        return FrameGraphPhysicalQueueRuntimeStatistics();
    if(compileStatistics.queue != recordingStatistics.queue || compileStatistics.queue != submissionStatistics.queue
        || compileStatistics.queueClass != recordingStatistics.queueClass || compileStatistics.queueClass != submissionStatistics.queueClass)
        return FrameGraphPhysicalQueueRuntimeStatistics();

    const auto queueClass = TranslateQueueClass(compileStatistics.queueClass);
    if(!queueClass.has_value())
        return FrameGraphPhysicalQueueRuntimeStatistics();

    FrameGraphPhysicalQueueRuntimeStatistics result = FrameGraphPhysicalQueueRuntimeStatistics();
    result.graphGeneration = compileStatistics.graphGeneration;
    result.planGeneration = compileStatistics.planGeneration;
    result.recordingAttemptGeneration = recordingStatistics.recordingAttemptGeneration;
    result.queue.index = compileStatistics.queue.index;
    result.queue.deviceGeneration = compileStatistics.queue.deviceGeneration;
    result.deviceGeneration = compileStatistics.deviceGeneration;
    result.queueClass = queueClass.value();
    result.compile.taskCount = cast<u64>(compileStatistics.taskCount);
    result.compile.packetCount = cast<u64>(compileStatistics.packetCount);
    result.compile.mergedTaskCount = cast<u64>(compileStatistics.mergedTaskCount);
    result.compile.prologueBarrierCount = cast<u64>(compileStatistics.prologueBarrierCount);
    result.compile.epilogueBarrierCount = cast<u64>(compileStatistics.epilogueBarrierCount);
    result.compile.ownershipReleaseBarrierCount = cast<u64>(compileStatistics.ownershipReleaseBarrierCount);
    result.compile.ownershipAcquireBarrierCount = cast<u64>(compileStatistics.ownershipAcquireBarrierCount);
    result.compile.incomingLogicalOwnershipTransferCount = cast<u64>(compileStatistics.incomingLogicalOwnershipTransferCount);
    result.compile.outgoingLogicalOwnershipTransferCount = cast<u64>(compileStatistics.outgoingLogicalOwnershipTransferCount);
    result.compile.incomingLogicalOwnershipTransferSignatureCount = cast<u64>(compileStatistics.incomingLogicalOwnershipTransferSignatureCount);
    result.compile.outgoingLogicalOwnershipTransferSignatureCount = cast<u64>(compileStatistics.outgoingLogicalOwnershipTransferSignatureCount);
    result.compile.incomingRepeatedOwnershipTransferSignatureCount = cast<u64>(compileStatistics.incomingRepeatedOwnershipTransferSignatureCount);
    result.compile.outgoingRepeatedOwnershipTransferSignatureCount = cast<u64>(compileStatistics.outgoingRepeatedOwnershipTransferSignatureCount);
    result.compile.concurrentSharingAdviceResourceCount = cast<u64>(compileStatistics.concurrentSharingAdviceResourceCount);
    result.recording = TranslateFrameGraphRecordingStatistics<FrameGraphPhysicalQueueRecordingRuntimeStatistics, GpuTaskGraphPhysicalQueueRecordingStatistics>(recordingStatistics);
    result.submission = TranslateFrameGraphSubmissionStatistics<FrameGraphPhysicalQueueSubmissionRuntimeStatistics, GpuTaskGraphPhysicalQueueSubmissionStatistics>(submissionStatistics);
    if(!IsValidFrameGraphPhysicalQueueRuntimeStatistics(result))
        return FrameGraphPhysicalQueueRuntimeStatistics();
    return result;
}


