void VerifyUiSearchComboBehaviorTests_QueryChangeRetiresPreviewAndScrollWithoutChangingCommittedSelection(mut UiSearchComboBehaviorTests self){
    self.m_state.combo().select(5u);
    ASSERT_TRUE(ReconcileComboState(self.m_state.combo(), self.m_source));
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    ASSERT_TRUE(UiSearchComboReconcilePreview(self.m_state, self.m_source.filtered()));
    UiSearchComboSelectPreview(self.m_state, 10u);
    ASSERT_TRUE(UiSearchComboScrollPreview(self.m_state, 96.0));
    const u64 previewGeneration = self.m_state.combo().listState().inputGeneration();
    ASSERT_TRUE(self.m_state.query().setText("tail"));
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    EXPECT_EQ(self.m_state.combo().selectedKey(), 5u);
    EXPECT_NE(self.m_state.combo().listState().inputGeneration(), previewGeneration);
    EXPECT_DOUBLE_EQ(self.m_state.combo().listState().scrollOffset(), 0.0);
    ASSERT_TRUE(UiSearchComboReconcilePreview(self.m_state, self.m_source.filtered()));
    EXPECT_EQ(self.m_state.combo().listState().selectedKey(), 0u);
    EXPECT_EQ(self.m_state.combo().listState().cursorKey(), 0u);
    EXPECT_EQ(self.m_state.combo().selectedKey(), 5u);
    EXPECT_EQ(self.m_source.filterCalls, 2u);
}

void VerifyUiSearchComboBehaviorTests_NoResultsPreserveTheFullSourceSelectionAndOpenPopup(mut UiSearchComboBehaviorTests self){
    self.m_state.combo().select(5u);
    ASSERT_TRUE(ReconcileComboState(self.m_state.combo(), self.m_source));
    self.m_state.combo().open();
    ASSERT_TRUE(self.m_state.query().setText("none"));
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    ASSERT_TRUE(UiSearchComboReconcilePreview(self.m_state, self.m_source.filtered()));
    EXPECT_EQ(self.m_state.combo().selectedKey(), 5u);
    EXPECT_TRUE(self.m_state.combo().isOpen());
    EXPECT_EQ(self.m_state.combo().listState().cursorKey(), 0u);
    EXPECT_EQ(self.m_source.view.count, 0u);
}

void VerifyUiSearchComboBehaviorTests_FullSourceRevisionChangeRebuildsAndRetiresPreviewWithSameQuery(mut UiSearchComboBehaviorTests self){
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    UiSearchComboSelectPreview(self.m_state, 8u);
    ASSERT_TRUE(UiSearchComboScrollPreview(self.m_state, 96.0));
    const u64 inputGeneration = self.m_state.combo().listState().inputGeneration();
    ++self.m_source.revisionValue;
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    EXPECT_EQ(self.m_source.filterCalls, 2u);
    EXPECT_EQ(self.m_source.rebuilds, 2u);
    EXPECT_NE(self.m_state.combo().listState().inputGeneration(), inputGeneration);
    EXPECT_EQ(self.m_state.combo().listState().cursorKey(), self.m_state.combo().selectedKey());
    EXPECT_DOUBLE_EQ(self.m_state.combo().listState().scrollOffset(), 0.0);
}

void VerifyUiSearchComboBehaviorTests_FullDatasetShrinkRebuildsAStaleLargerView(mut UiSearchComboBehaviorTests self){
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    ASSERT_EQ(self.m_source.view.count, 100000u);
    self.m_source.count = 10u;
    ++self.m_source.revisionValue;
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    EXPECT_EQ(self.m_source.view.count, 10u);
    EXPECT_EQ(self.m_source.filterCalls, 2u);
}

void VerifyUiSearchComboBehaviorTests_FullSourceReplacementRebuildsWithoutHoldingAnySourcePointer(mut UiSearchComboBehaviorTests self){
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    UiSearchComboBehaviorSource replacement = UiSearchComboBehaviorSource(self.m_state);
    replacement.generation = 72u;
    replacement.count = 12u;
    ASSERT_TRUE(FilterSearchCombo(self.m_state, replacement));
    EXPECT_EQ(replacement.filterCalls, 1u);
    EXPECT_EQ(replacement.view.count, 12u);
    EXPECT_EQ(self.m_source.filterCalls, 1u);
}

void VerifyUiSearchComboBehaviorTests_SameTextApplicationAssignmentFencesPreviewWithoutRebuildingSource(mut UiSearchComboBehaviorTests self){
    ASSERT_TRUE(self.m_state.query().setText("tail"));
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    const u64 previewGeneration = self.m_state.combo().listState().inputGeneration();
    ASSERT_TRUE(self.m_state.query().setText("tail"));
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    EXPECT_NE(self.m_state.combo().listState().inputGeneration(), previewGeneration);
    EXPECT_EQ(self.m_source.filterCalls, 1u);
    EXPECT_EQ(self.m_source.rebuilds, 1u);
}

void VerifyUiSearchComboBehaviorTests_SelectionAndPreeditUpdatesDoNotFilterOrResetPreview(mut UiSearchComboBehaviorTests self){
    ASSERT_TRUE(self.m_state.query().setText("all"));
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    const u64 previewGeneration = self.m_state.combo().listState().inputGeneration();
    ASSERT_TRUE(self.m_state.query().selectAll());
    ASSERT_TRUE(self.m_state.query().beginComposition());
    ASSERT_TRUE(self.m_state.query().updateComposition("tail", 0u, 4u));
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    EXPECT_EQ(self.m_source.queryView(), "all");
    EXPECT_EQ(self.m_state.combo().listState().inputGeneration(), previewGeneration);
    EXPECT_EQ(self.m_source.filterCalls, 1u);
    self.m_state.query().cancelComposition();
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    EXPECT_EQ(self.m_source.filterCalls, 1u);
}

void VerifyUiSearchComboBehaviorTests_OnlyCommittedImeTextChangesTheFilteredQuery(mut UiSearchComboBehaviorTests self){
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    ASSERT_TRUE(self.m_state.query().beginComposition());
    ASSERT_TRUE(self.m_state.query().updateComposition("tail", 0u, 4u));
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    EXPECT_EQ(self.m_source.filterCalls, 1u);
    ASSERT_TRUE(self.m_state.query().commitComposition("tail"));
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    EXPECT_EQ(self.m_source.filterCalls, 2u);
    EXPECT_EQ(self.m_source.queryView(), "tail");
    EXPECT_EQ(self.m_source.view.count, 3u);
}

void VerifyUiSearchComboBehaviorTests_IndependentViewInvalidationReassertsTheCachedQuery(mut UiSearchComboBehaviorTests self){
    ASSERT_TRUE(self.m_state.query().setText("tail"));
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    const u64 previewGeneration = self.m_state.combo().listState().inputGeneration();
    ++self.m_source.view.revisionValue;
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    EXPECT_EQ(self.m_source.filterCalls, 2u);
    EXPECT_EQ(self.m_source.rebuilds, 1u);
    EXPECT_NE(self.m_state.combo().listState().inputGeneration(), previewGeneration);
}

void VerifyUiSearchComboBehaviorTests_FailedFilterDoesNotPublishCacheOrResetPreviewAndCanRetry(mut UiSearchComboBehaviorTests self){
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    UiSearchComboSelectPreview(self.m_state, 8u);
    ASSERT_TRUE(UiSearchComboScrollPreview(self.m_state, 96.0));
    const u64 previewGeneration = self.m_state.combo().listState().inputGeneration();
    ASSERT_TRUE(self.m_state.query().setText("tail"));
    self.m_source.failFilter = true;
    EXPECT_FALSE(FilterSearchCombo(self.m_state, self.m_source));
    EXPECT_EQ(self.m_state.combo().listState().inputGeneration(), previewGeneration);
    EXPECT_EQ(self.m_state.combo().listState().cursorKey(), 8u);
    EXPECT_DOUBLE_EQ(self.m_state.combo().listState().scrollOffset(), 96.0);
    self.m_source.failFilter = false;
    ASSERT_TRUE(FilterSearchCombo(self.m_state, self.m_source));
    EXPECT_EQ(self.m_source.filterCalls, 3u);
    EXPECT_EQ(self.m_source.view.count, 3u);
}

void VerifyUiSearchComboBehaviorTests_InvalidFullIdentityRejectsWithoutCallingFilter(mut UiSearchComboBehaviorTests self){
    self.m_source.generation = 0u;
    EXPECT_FALSE(FilterSearchCombo(self.m_state, self.m_source));
    self.m_source.generation = 71u;
    self.m_source.revisionValue = 0u;
    EXPECT_FALSE(FilterSearchCombo(self.m_state, self.m_source));
    EXPECT_EQ(self.m_source.filterCalls, 0u);
}

void VerifyUiSearchComboBehaviorTests_FilterMayNotChangeFullGenerationRevisionOrCount(mut UiSearchComboBehaviorTests self){
    for(u32 change = 0u; change < 3u; ++change){
        SearchComboState state = SearchComboState();
        UiSearchComboBehaviorSource source = UiSearchComboBehaviorSource(state);
        state.combo().select(5u);
        const u64 previewGeneration = state.combo().listState().inputGeneration();
        source.changeFullGeneration = change == 0u;
        source.changeFullRevision = change == 1u;
        source.changeFullCount = change == 2u;
        EXPECT_FALSE(FilterSearchCombo(state, source));
        EXPECT_EQ(state.combo().selectedKey(), 5u);
        EXPECT_EQ(state.combo().listState().inputGeneration(), previewGeneration);
    }
}

void VerifyUiSearchComboBehaviorTests_ResultingViewMustHaveValidIdentityAndBeBoundedByTheFullDataset(mut UiSearchComboBehaviorTests self){
    self.m_source.invalidViewIdentity = true;
