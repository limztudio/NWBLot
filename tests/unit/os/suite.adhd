void VerifyClipboardText_Utf8RejectsMalformedUnicodeAndEmbeddedNull(){
    EXPECT_EQ(ValidateClipboardUtf8Text(StringView()), ClipboardStatus::Success);
    EXPECT_EQ(ValidateClipboardUtf8Text("\xF4\x8F\xBF\xBF"), ClipboardStatus::Success);
    FixedVector<StringView, 7> invalid = FixedVector<StringView, 7>();
    invalid.push_back("\x80");
    invalid.push_back("\xC0\xAF");
    invalid.push_back("\xE0\x80\xAF");
    invalid.push_back("\xED\xA0\x80");
    invalid.push_back("\xF4\x90\x80\x80");
    invalid.push_back("\xF0\x9F");
    invalid.push_back(StringView("before\0after", 12u));
    for(in StringView text : invalid){
        EXPECT_EQ(ValidateClipboardUtf8Text(text), ClipboardStatus::InvalidText);
    }
}

void VerifyClipboardText_IncrementalChunksCanSplitUnicodeUntilFinalValidation(){
    ClipboardTextTestContext ctx = ClipboardTextTestContext();
    EXPECT_EQ(ctx.accumulator.appendBytes("\xED"), ClipboardStatus::Success);
    EXPECT_EQ(ValidateClipboardUtf8Text(ViewGlobalString(ctx.accumulator.text())), ClipboardStatus::InvalidText);
    EXPECT_EQ(ctx.accumulator.appendBytes("\x95\x9C\xF0\x9F"), ClipboardStatus::Success);
    EXPECT_EQ(ValidateClipboardUtf8Text(ViewGlobalString(ctx.accumulator.text())), ClipboardStatus::InvalidText);
    EXPECT_EQ(ctx.accumulator.appendBytes("\x98\x80"), ClipboardStatus::Success);
    EXPECT_EQ(ValidateClipboardUtf8Text(ViewGlobalString(ctx.accumulator.text())), ClipboardStatus::Success);
    EXPECT_EQ(ctx.accumulator.text(), "\xED\x95\x9C\xF0\x9F\x98\x80");
}

void VerifyClipboardText_IncrementalFailuresDiscardBytesAndRemainStickyUntilClear(){
    ClipboardTextTestContext ctx = ClipboardTextTestContext();
    ASSERT_EQ(ctx.accumulator.appendBytes("prefix"), ClipboardStatus::Success);
    EXPECT_EQ(ctx.accumulator.appendBytes(StringView("a\0b", 3u)), ClipboardStatus::InvalidText);
    EXPECT_TRUE(ctx.accumulator.text().empty());
    EXPECT_EQ(ctx.accumulator.appendBytes("ignored"), ClipboardStatus::InvalidText);
    EXPECT_TRUE(ctx.accumulator.text().empty());
    ctx.accumulator.clear();
    EXPECT_EQ(ctx.accumulator.appendBytes("fresh"), ClipboardStatus::Success);
    EXPECT_EQ(ctx.accumulator.text(), "fresh");
}

void VerifyClipboardText_ByteLimitIsInclusiveAndBoundsIncrementalAccumulation(){
    ClipboardTextTestContext ctx = ClipboardTextTestContext();
    FillGlobalString(ctx.first, s_ClipboardMaxTextBytes, 0x78u);
    EXPECT_EQ(ValidateClipboardUtf8Text(ViewGlobalString(ctx.first)), ClipboardStatus::Success);
    ASSERT_EQ(ctx.accumulator.appendBytes(ViewGlobalString(ctx.first)), ClipboardStatus::Success);
    EXPECT_EQ(ctx.accumulator.text().size(), s_ClipboardMaxTextBytes);
    EXPECT_EQ(ctx.accumulator.appendBytes("x"), ClipboardStatus::TooLarge);
    EXPECT_TRUE(ctx.accumulator.text().empty());
    EXPECT_EQ(ctx.accumulator.appendBytes("ignored"), ClipboardStatus::TooLarge);
    AppendByteGlobalString(ctx.first, 0x78u);
    EXPECT_EQ(ValidateClipboardUtf8Text(ViewGlobalString(ctx.first)), ClipboardStatus::TooLarge);
    ctx.accumulator.clear();
    EXPECT_EQ(ctx.accumulator.appendBytes("fresh"), ClipboardStatus::Success);
}

void VerifyClipboardText_Latin1UpperByteBoundsAndUnsupportedUnicodeClearOutput(){
    ClipboardTextTestContext ctx = ClipboardTextTestContext();
    const StringView source = StringView("\x80\xFF", 2u);
    ASSERT_EQ(DecodeClipboardLatin1(source, ctx.first), ClipboardStatus::Success);
    EXPECT_EQ(ctx.first, "\xC2\x80\xC3\xBF");
    ASSERT_EQ(EncodeClipboardLatin1(ViewGlobalString(ctx.first), ctx.second), ClipboardStatus::Success);
    EXPECT_EQ(ctx.second, source);
    EXPECT_EQ(EncodeClipboardLatin1(StringView("\xC4\x80\xFF", 3u), ctx.second), ClipboardStatus::InvalidText);
    EXPECT_TRUE(ctx.second.empty());
    EXPECT_EQ(EncodeClipboardLatin1("\xE2\x98\x83", ctx.second), ClipboardStatus::Unsupported);
    EXPECT_TRUE(ctx.second.empty());
    EXPECT_EQ(DecodeClipboardLatin1(StringView("a\0b", 3u), ctx.first), ClipboardStatus::InvalidText);
    EXPECT_TRUE(ctx.first.empty());
}

void VerifyClipboardText_Latin1ConversionAcceptsAliasedOutputAndSubviews(){
    ClipboardTextTestContext ctx = ClipboardTextTestContext();
    AssignGlobalString(ctx.first, StringView("\x80\xFF", 2u));
    ASSERT_EQ(DecodeClipboardLatin1(ViewGlobalString(ctx.first), ctx.first), ClipboardStatus::Success);
    EXPECT_EQ(ctx.first, "\xC2\x80\xC3\xBF");
    ASSERT_EQ(EncodeClipboardLatin1(ViewGlobalString(ctx.first), ctx.first), ClipboardStatus::Success);
    EXPECT_EQ(ViewGlobalString(ctx.first), StringView("\x80\xFF", 2u));

    AssignGlobalString(ctx.first, "prefix\xC2\x80");
    const StringView suffix = ViewGlobalString(ctx.first).substr(6u);
    ASSERT_EQ(EncodeClipboardLatin1(suffix, ctx.first), ClipboardStatus::Success);
    EXPECT_EQ(ViewGlobalString(ctx.first), StringView("\x80", 1u));
}

void VerifyClipboardText_Latin1ExpansionCannotExceedUtf8ByteLimit(){
    ClipboardTextTestContext ctx = ClipboardTextTestContext();
    FillGlobalString(ctx.first, s_ClipboardMaxTextBytes / 2u + 1u, 0xFFu);
    AssignGlobalString(ctx.second, "stale bytes");
    EXPECT_EQ(DecodeClipboardLatin1(ViewGlobalString(ctx.first), ctx.second), ClipboardStatus::TooLarge);
    EXPECT_TRUE(ctx.second.empty());
}


