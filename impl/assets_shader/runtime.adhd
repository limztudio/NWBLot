#include <impl/assets_shader/shader_types.adhd>
#include <impl/assets_shader/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateResolvedSpirvEntryPoint(
    in b8 resolved,
    in StringView entryPoint,
    in Name assetType
){
    if(resolved)
        return true;

    error(
        "IShader::loadBinaryForStage failed: entry point '{}' does not match asset type '{}' or SPIR-V is malformed",
        entryPoint,
        assetType.resolvedText()
    );
    return false;
}

b8 LoadShaderBinaryForStage(
    in IShader shaderAsset,
    in Span<u8> binary,
    in ShaderType shaderType,
    mut String outEntryPoint,
    mut Vector<u8> outBytecode
){
    if(!shaderAsset.checkVirtualPath("IShader::loadBinaryForStage"))
        return false;

    const Expected<AssetPayloadView, AssetPayloadDecodeFailure> payload = DecodeAssetPayload(binary);
    if(!payload.has_value()){
        ReportShaderAssetPayloadDecodeFailure(payload.error());
        return false;
    }

    const Expected<StringView, SpirvEntryPointLookupResult> lookupResult = ResolveSpirvEntryPointName(
        payload.value().bytecode,
        payload.value().entryPoint,
        ShaderType::ToMask(shaderType)
    );
    if(!ValidateResolvedSpirvEntryPoint(lookupResult.has_value(), payload.value().entryPoint, shaderAsset.assetType()))
        return false;

    CommitDecodedShaderAssetPayload(payload.value().entryPoint, payload.value().bytecode, outEntryPoint, outBytecode);
    return true;
}

b8 VertexShader::loadBinary(in Span<u8> binary){
    return LoadShaderBinaryForStage(this, binary, ShaderType::VertexStage, this.m_entryPoint, this.m_bytecode);
}

b8 HullShader::loadBinary(in Span<u8> binary){
    return LoadShaderBinaryForStage(this, binary, ShaderType::HullStage, this.m_entryPoint, this.m_bytecode);
}

b8 DomainShader::loadBinary(in Span<u8> binary){
    return LoadShaderBinaryForStage(this, binary, ShaderType::DomainStage, this.m_entryPoint, this.m_bytecode);
}

b8 GeometryShader::loadBinary(in Span<u8> binary){
