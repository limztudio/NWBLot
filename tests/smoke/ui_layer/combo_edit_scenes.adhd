    private b8 m_primaryFocused = false;
    private b8 m_secondaryFocused = false;
    private b8 m_readOnly = false;
    private b8 m_visible = true;
    private b8 m_displayChanged = false;

    public UiEditSmokeScene(mut GlobalArena arena);

    public b8 paint(mut UiPaintContext context);
