#include "renderer_gather_benchmark_scene_and_runtime.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererGatherBenchmarkProject : IProjectEntryCallbacks{
    public RendererGatherBenchmarkProject(mut ProjectRuntimeContext context){
        this.m_impl = RendererGatherBenchmarkProjectImpl(context);
    }

    public b8 onStartup()override{
        return this.m_impl.onStartup();
    }

    public void onShutdown()override{
        this.m_impl.onShutdown();
    }

    public b8 onUpdate(in f32 delta)override{
        return this.m_impl.onUpdate(delta);
    }

    private RendererGatherBenchmarkProjectImpl m_impl;
}


