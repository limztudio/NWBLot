}

void VerifyAdhdCompiler_RejectsUncapturedOrConstThisLambdaMutationsDuplicateSwitchDefaultsAndBodylessOolMethods(){
    AdhdTestArena arena = AdhdTestArena();
    ExpectCompileFails(arena, s_SimdSpecUncapturedThisInLambdaSource, "impl/sim/bad_this_cap.adhd");
    ExpectCompileFails(arena, s_SimdSpecMutateInThisLambdaSource, "impl/sim/bad_in_this.adhd");
    ExpectCompileFails(arena, s_SimdSpecDuplicateDefaultSwitchSource, "impl/sim/bad_dup_default.adhd");
    ExpectCompileFails(arena, "class Box {\r\n    public void run();\r\n}\r\nvoid Box::run();\r\n", "impl/sim/bad_ool.adhd");
}

void VerifyAdhdCompiler_RejectsOutOfBoundsSwizzleAndWrongBuiltinArity(){
    AdhdTestArena arena = AdhdTestArena();
    ExpectCompileFails(arena, "void BadSwizzle() {\r\n    f32x3_i32 v(1.0f, 2.0f, 3.0f, 4);\r\n    f32x3_i32 s = v.xyzw;\r\n}\r\n", "impl/sim/bad_mixed_swizzle.adhd");
    ExpectCompileFails(arena, "f32 BadDot(in VectorSingle a) {\r\n    return Dot(a);\r\n}\r\n", "impl/sim/bad_builtin_arity.adhd");
}

void VerifyAdhdCompiler_LowerBoundRejectsNonUsizeSpanArguments(){
    AdhdTestArena arena = AdhdTestArena();
    CompileResult valid = CompileResult(arena.arena);
    ASSERT_TRUE(Compile("usize F(in Span<usize> b){ return LowerBoundIndex(b.subspan(0u, b.size()), 0u); }", "valid.adhd", arena.arena, valid));
    const StringView validHdr = GeneratedHeaderView(valid);
    const StringView validSrc = GeneratedSourceView(valid);
    EXPECT_TRUE(validHdr.find("::LowerBoundIndex(") != usize.max || validSrc.find("::LowerBoundIndex(") != usize.max);

    ExpectCompileFailsWithMessage(arena, "usize F(){ return LowerBoundIndex(3u, 0u); }", "invalid.adhd", "built-in function argument must be Span<usize>");
    ExpectCompileFailsWithMessage(arena, "usize F(in Span<u32> b){ return LowerBoundIndex(b, 0u); }", "invalid.adhd", "built-in function argument must be Span<usize>");
}

void VerifyAdhdCompiler_ByteBuiltinsCheckContainerTypesAndAlignmentUsesSize(){
    AdhdTestArena arena = AdhdTestArena();
    CompileResult valid = CompileResult(arena.arena);
    const StringView s_Valid = "Expected<usize> Align(in usize value){ return AlignUpChecked(value, 4u); }\nvoid Store(in f32 value, mut FixedVector<u8, 8u> bytes){ WriteF32LittleEndianAt(value, 0u, bytes); }\n";
    ASSERT_TRUE(Compile(s_Valid, "byte_builtins.adhd", arena.arena, valid));
    const StringView validHdr = GeneratedHeaderView(valid);
    const StringView validSrc = GeneratedSourceView(valid);
    EXPECT_TRUE(validHdr.find("::AlignUpCheckedSize(") != usize.max || validSrc.find("::AlignUpCheckedSize(") != usize.max);

    ExpectCompileFails(arena, "u32 F(in Span<u32> b){ return ReadPartialU32LittleEndian(b, 0u); }", "bad_byte_builtins.adhd");
    ExpectCompileFails(arena, "void F(in f32 v, mut FixedVector<u32, 8u> b){ WriteF32LittleEndianAt(v, 0u, b); }", "bad_byte_builtins.adhd");
    ExpectCompileFails(arena, "void F(in f32 v, in FixedVector<u8, 8u> b){ WriteF32LittleEndianAt(v, 0u, b); }", "bad_byte_builtins.adhd");
}

void VerifyAdhdCompiler_NumericGrammarAndBoundBuiltinsCheckArguments(){
    AdhdTestArena arena = AdhdTestArena();
    CompileResult valid = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(s_SimdSpecNumericGrammarValidSource, "numeric_builtins.adhd", arena.arena, valid));
    const StringView source = GeneratedSourceView(valid);
    const StringView header = GeneratedHeaderView(valid);
    EXPECT_NE(header.find("#include <global/binary_big_endian.h>"), usize.max);
    EXPECT_NE(header.find("#include <global/binary_little_endian.h>"), usize.max);
    EXPECT_NE(header.find("#include <global/numeric_range.h>"), usize.max);
    for(in StringView token : s_SimdSpecNumericExpectedTokens)
        EXPECT_TRUE(source.find(token) != usize.max || header.find(token) != usize.max);
    for(in StringView text : s_SimdSpecNumericInvalidSources)
        ExpectCompileFails(arena, text, "bad_numeric_builtins.adhd");
}

void VerifyAdhdCompiler_RawSimdHashKeepsRegisterAndMutableSeed(){
    AdhdTestArena arena = AdhdTestArena();
    CompileResult valid = CompileResult(arena.arena);
    ASSERT_TRUE(Compile("void F(in VectorSingle v, mut usize seed){ HashCombineF32x4(v, seed); } b8 Eq(in VectorSingle a, in VectorSingle b){ return EqualF32x4Bits(a, b); }", "hash.adhd", arena.arena, valid));
    const StringView header = GeneratedHeaderView(valid);
    const StringView source = GeneratedSourceView(valid);
    StringView generated = header;
    if(source.find("::HashCombineF32x4(") != usize.max)
        generated = source;
    EXPECT_NE(generated.find("::HashCombineF32x4(v, seed)"), usize.max);
    EXPECT_EQ(generated.find("::LoadFloat("), usize.max);

    ExpectCompileFails(arena, "void F(in VectorSingle v){ HashCombineF32x4(v, 1u); }", "bad_hash.adhd");
    ExpectCompileFails(arena, "void F(in VectorSingle v, in usize seed){ HashCombineF32x4(v, seed); }", "bad_hash.adhd");
    ExpectCompileFails(arena, "void F(in VectorDouble v, mut usize seed){ HashCombineF32x4(v, seed); }", "bad_hash.adhd");

    CompileResult shadowed = CompileResult(arena.arena);
    ASSERT_TRUE(Compile("void HashCombineF32x4(in u32 v, mut usize seed){ seed = cast<usize>(v); } void F(in u32 v, mut usize seed){ HashCombineF32x4(v, seed); }", "shadow_hash.adhd", arena.arena, shadowed));
}

void VerifyAdhdCompiler_RectangleIntrinsicsKeepRegistersAndRejectWrongTypes(){
    AdhdTestArena arena = AdhdTestArena();
    CompileResult valid = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(s_SimdSpecRectValidSource, "rect.adhd", arena.arena, valid));
    const StringView source = GeneratedSourceView(valid);
    const StringView header = GeneratedHeaderView(valid);
    StringView generated = header;
    if(source.find("::IntersectRectValuePreservingExtent(") != usize.max)
        generated = source;
    EXPECT_NE(generated.find("::IntersectRectBoundsValue("), usize.max);
    EXPECT_NE(generated.find("::IntersectRectValuePreservingExtent("), usize.max);
    EXPECT_EQ(generated.find("::LoadFloat("), usize.max);
    EXPECT_TRUE(source.find("::HasVisibleRectIntersection(") != usize.max || header.find("::HasVisibleRectIntersection(") != usize.max);
    EXPECT_TRUE(source.find("::InsetRectValuePreservingExtent(") != usize.max || header.find("::InsetRectValuePreservingExtent(") != usize.max);

    for(in StringView text : s_SimdSpecRectInvalidSources)
        ExpectCompileFailsWithMessage(arena, text, "invalid_rect.adhd", "built-in function argument must be VectorSingle");
    for(in StringView text : s_SimdSpecRectMutationSources)
        ExpectCompileFailsWithMessage(arena, text, "mut_rect.adhd", "cannot mutate or pass temporary rvalue return value to a 'mut' target");

    CompileResult shadowed = CompileResult(arena.arena);
    const StringView s_Shadow = "VectorSingle IntersectRectVec(in VectorSingle a, in VectorSingle b){ return a; } VectorSingle F(in VectorSingle a, in VectorSingle b){ return IntersectRectVec(a, b); }";
    ASSERT_TRUE(Compile(s_Shadow, "shadow_rect.adhd", arena.arena, shadowed));
    EXPECT_EQ(GeneratedHeaderView(shadowed).find("::IntersectRectValuePreservingExtent("), usize.max);
    EXPECT_EQ(GeneratedSourceView(shadowed).find("::IntersectRectValuePreservingExtent("), usize.max);
}

void VerifyAdhdCompiler_RejectsTemplateBoundViolationsAndInterfaceDowncasts(){
    AdhdTestArena arena = AdhdTestArena();
    ExpectCompileFails(arena, s_SimdSpecInvalidBoundArgSource, "impl/bad_bound.adhd");
    ExpectCompileFails(arena, s_SimdSpecDowncastInterfaceSource, "impl/bad_downcast.adhd");
}

void VerifyAdhdCompiler_RejectsNonConstMethodCallsOnInParameters(){
    AdhdTestArena arena = AdhdTestArena();
    ExpectCompileFails(arena, s_SimdSpecConstViolationSource, "impl/bad_const.adhd");
}

void VerifyAdhdCompiler_RejectsUnboundedMethodCallsCStyleArraysRawCppIncludesAndByValueInterfaces(){
    AdhdTestArena arena = AdhdTestArena();
    ExpectCompileFails(arena, "void BadUnbounded<T>(mut T comp) {\r\n    comp.step(1.0f);\r\n}\r\n", "impl/bad_unbounded.adhd");
    ExpectCompileFails(arena, "void BadArray() {\r\n    i32 values[4] = 0;\r\n}\r\n", "impl/bad_array.adhd");
    ExpectCompileFails(arena, "#include <vector>\r\nvoid Nop() {}\r\n", "impl/bad_inc.adhd");
    ExpectCompileFails(arena, s_SimdSpecByValueInterfaceVarSource, "impl/bad_val_iface.adhd");
    ExpectCompileFails(arena, s_SimdSpecMismatchedOverrideConstSource, "impl/bad_override_sig.adhd");
}

void VerifyAdhdCompiler_OmitsIncludedDeclarationsFromGeneratedOutputAndRejectsInvalidEnumOperatorsAndControlFlow(){
    AdhdTestArena arena = AdhdTestArena();
    MockIncludeResolver resolver = MockIncludeResolver();

    CompileResult splitRes = CompileResult(arena.arena);
    ASSERT_TRUE(CompileWithResolver(s_SimdSpecSplitImplSource, "impl/service/shared_service_impl.adhd", resolver, arena.arena, splitRes));
    const StringView hdrView = GeneratedHeaderView(splitRes);
    const StringView cppView = GeneratedSourceView(splitRes);
    EXPECT_NE(hdrView.find("#include \"shared_service.adhd.h\""), usize.max);
    EXPECT_EQ(hdrView.find("class SharedService final"), usize.max);
    EXPECT_EQ(cppView.find("SharedService::reflectedFieldCount"), usize.max);

    ExpectCompileFails(arena, "enum<u8> Mode {\r\n    Idle = 0,\r\n    Active = 1,\r\n}\r\nMode BadBitwise() {\r\n    return Mode::Idle | Mode::Active;\r\n}\r\n", "impl/bad_enum_bitwise.adhd");
    ExpectCompileFails(arena, "class Mask {\r\n    public u32 bits = 0;\r\n    public Mask operator~(in Mask other)const {\r\n        return Mask();\r\n    }\r\n}\r\n", "impl/bad_op_arity.adhd");
    ExpectCompileFails(arena, "interface IBatch {\r\n    void process(in Span<i32> items);\r\n}\r\nclass BadBatch : IBatch {\r\n    public void process(in Span<f32> items) override {}\r\n}\r\n", "impl/bad_tpl_override.adhd");
    ExpectCompileFails(arena, "class DupClass {\r\n    public u32 value = 0;\r\n    private u32 value = 1;\r\n}\r\n", "impl/dup_field.adhd");
    ExpectCompileFails(arena, "class KnownClass {\r\n    public u32 count = 0;\r\n    public u32 readBad()const {\r\n        return this.missingField;\r\n    }\r\n}\r\n", "impl/unknown_this.adhd");
    ExpectCompileFails(arena, "interface IFactory {\r\n    IFactory cloneSelf();\r\n}\r\n", "impl/bad_iface_ret.adhd");
    ExpectCompileFails(arena, "class Pair<T, U> {\r\n    public T first = 0;\r\n    public U second = 0;\r\n}\r\nvoid BadPairUse() {\r\n    Pair<u8> p;\r\n}\r\n", "impl/bad_tpl_arity.adhd");
    ExpectCompileFails(arena, "enum<u8> DupMode {\r\n    Alpha,\r\n    Alpha\r\n}\r\n", "impl/dup_enum.adhd");
    ExpectCompileFails(arena, "void BadScope(in u32 x) {\r\n    u32 x = 1u;\r\n}\r\n", "impl/dup_local.adhd");
    ExpectCompileFails(arena, "void BadBreak() {\r\n    break;\r\n}\r\n", "impl/bad_break.adhd");
    ExpectCompileFails(arena, "u32 BadParReturn() {\r\n    parallel_for (u32 i = 0u; i < 4u; ++i) {\r\n        return i;\r\n    }\r\n    return 0u;\r\n}\r\n", "impl/bad_par_ret.adhd");
    ExpectCompileFails(arena, "void BadVoidRet() {\r\n    return 42;\r\n}\r\n", "impl/bad_void_ret.adhd");
}

void VerifyAdhdCompiler_PopsIncludeScopesAndOmitsTransitiveHeaderReemission(){
    AdhdTestArena arena = AdhdTestArena();
    TransitiveSplitResolver resolver = TransitiveSplitResolver();
    CompileResult res = CompileResult(arena.arena);
    ASSERT_TRUE(CompileWithResolver(s_SimdSpecTransitiveImplSource, "impl/split_impl.adhd", resolver, arena.arena, res));

    EXPECT_EQ(resolver.popCount, 2u);
    ASSERT_EQ(UnitIncludedAdhdFileCount(res), 1u);
    EXPECT_EQ(UnitIncludedAdhdFileView(res, 0u), "split_decl.adhd");
    ASSERT_EQ(UnitResolvedIncludedFileCount(res), 2u);
    EXPECT_EQ(UnitResolvedIncludedFileView(res, 0u), "/abs/split_decl.adhd");
    EXPECT_EQ(UnitResolvedIncludedFileView(res, 1u), "/abs/sub/leaf.adhd");

    const StringView hdrView = GeneratedHeaderView(res);
    EXPECT_NE(hdrView.find("#include \"split_decl.adhd.h\""), usize.max);
    EXPECT_EQ(hdrView.find("#include \"sub/leaf.adhd.h\""), usize.max);
}

void VerifyAdhdCompiler_KeepsDynamicLaneIndicesDynamicWhileFoldingConstantIndices(){
    AdhdTestArena arena = AdhdTestArena();
    CompileResult result = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(s_SimdSpecLaneIndexEdgesSource, "impl/sim/lane_index_edges.adhd", arena.arena, result));
    const StringView generated = GeneratedSourceView(result);
    EXPECT_NE(generated.find("::VectorSetZ("), usize.max);
    EXPECT_NE(generated.find("::VectorSetByIndex("), usize.max);
    EXPECT_NE(generated.find("::VectorGetZ("), usize.max);
    EXPECT_NE(generated.find("::VectorGetByIndex("), usize.max);
}


