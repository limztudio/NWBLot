namespace NWB::Tests::Smoke{
inline constexpr AStringView s_CsgSkinnedProjectName = "CsgSkinnedVisibleSmokeProject";

using CsgSkinnedModelRef = Core::Assets::AssetRef<Impl::Model>;
using CsgSkinnedMaterialRef = Core::Assets::AssetRef<Impl::Material>;

inline constexpr CsgSkinnedModelRef s_CsgSkinnedModel{"project/characters/body/model"};
#if defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER)
inline constexpr CsgSkinnedMaterialRef s_CsgSkinnedReceiverMaterial{"project/smoke/transparent_multi/materials/shared"};
#else
inline constexpr CsgSkinnedMaterialRef s_CsgSkinnedReceiverMaterial{"project/smoke/csg_visible/materials/solid"};
#endif
inline constexpr Name s_CsgSkinnedReceiverGroup = s_SmokeNameProjectSmokeCsgSkinnedVisibleFemaleReceiver;
inline constexpr Name s_CsgSkinnedCutterAnchorBoneName = s_SmokeNameHip;
inline constexpr f32 s_CsgSkinnedCameraDistance = 1.75f;
inline constexpr f32 s_CsgSkinnedCameraHeight = 0.92f;
inline constexpr f32 s_CsgSkinnedDefaultDirectionalLightPitch = -0.62f;
inline constexpr f32 s_CsgSkinnedDefaultDirectionalLightYaw = 0.54f;
inline constexpr f32 s_CsgSkinnedDefaultDirectionalLightIntensity = 3.0f;
inline constexpr f32 s_CsgSkinnedCutterAnimationSpeed = 0.18f;
inline constexpr f32 s_CsgSkinnedReceiverYawSpeed = 0.92f;
inline constexpr f32 s_CsgSkinnedMaxAnimationDelta = s_SmokeSpinMaxDelta;
inline constexpr f32 s_CsgSkinnedInitialAnimationTime = s_PIDIV2 / s_CsgSkinnedReceiverYawSpeed;
inline constexpr u16 s_CsgSkinnedFrameClientWidth = 1280u;
inline constexpr u16 s_CsgSkinnedFrameClientHeight = 900u;
#if defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER)
inline constexpr f32 s_CsgSkinnedTransparentReceiverAlpha = 0.44f;
#endif
inline constexpr f32 s_CsgSkinnedReceiverOffsetX = 0.48f;
inline constexpr f32 s_CsgSkinnedCutterGentleRollSpeed = 0.18f;
inline constexpr f32 s_CsgSkinnedCutterAnchorFallbackY = 0.90f;
#if defined(NWB_CSG_SKINNED_VISIBLE_SPHERE_CUTTER)
inline constexpr f32 s_CsgSkinnedSphereCutterRadius = 0.18f;
#else
inline constexpr f32 s_CsgSkinnedCapsuleCutterRadius = 0.105f;
inline constexpr f32 s_CsgSkinnedCapsuleCutterHalfHeight = 0.27f;
#endif
inline constexpr Float4 s_CsgSkinnedPlainReceiverTint = Float4(0.86f, 0.88f, 0.90f, 1.0f);
inline constexpr Float4 s_CsgSkinnedCsgReceiverTint = Float4(0.85f, 0.72f, 1.0f, 1.0f);
inline constexpr Float4 s_CsgSkinnedWarmDirectionalLightColor = Float4(1.0f, 0.96f, 0.88f);

[[nodiscard]] NWB_INLINE AStringView CsgSkinnedVisibleFpsLabel()noexcept{
#if defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER) && defined(NWB_CSG_SKINNED_VISIBLE_SPHERE_CUTTER)
    return "CsgSkinnedTransparentSphereVisibleSmokeProject";
#elif defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER)
    return "CsgSkinnedTransparentVisibleSmokeProject";
#elif defined(NWB_CSG_SKINNED_VISIBLE_SPHERE_CUTTER)
    return "CsgSkinnedSphereVisibleSmokeProject";
#else
    return s_CsgSkinnedProjectName;
#endif
}

[[nodiscard]] NWB_INLINE f32 CsgSkinnedReceiverAlpha()noexcept{
#if defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER)
    return s_CsgSkinnedTransparentReceiverAlpha;
#else
    return 1.0f;
#endif
}

#if defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER)
inline constexpr b8 s_CsgSkinnedTransparentReceiver = true;
#else
inline constexpr b8 s_CsgSkinnedTransparentReceiver = false;
#endif
namespace ModelObjectKind = Impl::ModelObjectKind;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


VectorSingle BuildCsgSkinnedReceiverRotation(in f32 animationTime){
    return QuaternionRotationRollPitchYawFromVector(VectorSingle(0.0f, animationTime, 0.0f, 0.0f) * s_CsgSkinnedReceiverYawSpeed);
}

VectorSingle BuildCsgSkinnedReceiverPosition(){
    return VectorSingle(s_CsgSkinnedReceiverOffsetX, 0.0f, 0.0f, 0.0f);
}

VectorSingle BuildCsgSkinnedCutterLocalRotation(in f32 animationTime){
    const VectorSingle horizontalCapsule = QuaternionRotationRollPitchYawFromVector(VectorSingle(s_PIDIV2, s_PIDIV2, 0.0f, 0.0f));
    const VectorSingle gentleRoll = QuaternionRotationRollPitchYawFromVector(VectorSingle(0.0f, animationTime, 0.0f, 0.0f) * s_CsgSkinnedCutterGentleRollSpeed);
    return QuaternionNormalize(QuaternionMultiply(horizontalCapsule, gentleRoll));
}

VectorSingle BuildCsgSkinnedCutterWorldCenter(in VectorSingle cutterLocalCenter, in VectorSingle receiverRotation){
    return BuildCsgSkinnedReceiverPosition() + Vector3Rotate(cutterLocalCenter, receiverRotation);
}

VectorSingle BuildCsgSkinnedCutterWorldRotation(in f32 animationTime, in VectorSingle receiverRotation){
    return QuaternionNormalize(QuaternionMultiply(receiverRotation, BuildCsgSkinnedCutterLocalRotation(animationTime)));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CsgSkinnedVisibleSmokeProject : IProjectEntryCallbacks{
    public CsgSkinnedVisibleSmokeProject(mut ProjectRuntimeContext context){
        this.m_context = context;
        this.m_world = CreateSmokeSkinnedRenderWorldOrDie(s_CsgSkinnedProjectName, SmokeRenderQualitySettings(), context);
        this.m_fpsProbe = FpsProbe(CsgSkinnedVisibleFpsLabel());
    }

    public ~CsgSkinnedVisibleSmokeProject(){
        this.destroyWorld();
    }

    public b8 onStartup()override{
        native{
            auto activeCameraEntity = this->m_world->createEntity();
            auto& activeCamera = activeCameraEntity.addComponent<Impl::Scene::ActiveCameraComponent>();
            activeCamera.camera = Impl::Scene::CreateSceneCameraEntity(*this->m_world, Float4(0.0f, s_CsgSkinnedCameraHeight, -s_CsgSkinnedCameraDistance, 0.0f));
            const auto directionalLight = Impl::Scene::CreateDirectionalLightEntity(*this->m_world, s_CsgSkinnedDefaultDirectionalLightPitch, s_CsgSkinnedDefaultDirectionalLightYaw, 0.0f, s_CsgSkinnedWarmDirectionalLightColor, s_CsgSkinnedDefaultDirectionalLightIntensity);

#if defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER)
            if(auto* light = this->m_world->tryGetComponent<Impl::Scene::LightComponent>(directionalLight))
                light->enableCaustics = false;
#endif

            this->createReceiver();
            SyncSmokeModelRuntimes(*this->m_world);
            const b8 receiverReady = this->installCsgReceiverOnSpawnedModelObject();
            const SIMDVectorSingle cutterLocalCenter = this->loadCutterAnchorLocalCenter();
            StoreFloat(cutterLocalCenter, this->m_cutterLocalCenter);
            this->createCutter(cutterLocalCenter);
            NWB_FATAL_ASSERT_MSG(
                activeCamera.camera.valid() && directionalLight.valid()
                    && this->m_plainReceiver.valid()
                    && this->m_receiver.valid()
                    && this->m_receiverObject.valid()
                    && this->m_cutter.valid(),
                NWB_TEXT("CsgSkinnedVisibleSmokeProject failed to create all scene entities")
            );
            NWB_FATAL_ASSERT_MSG(receiverReady, NWB_TEXT("CsgSkinnedVisibleSmokeProject failed to bind CSG receiver to spawned model object"));

#if defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER) && defined(NWB_CSG_SKINNED_VISIBLE_SPHERE_CUTTER)
            NWB_LOGGER_ESSENTIAL_INFO(NWB_TEXT("CsgSkinnedVisibleSmokeProject: transparent skinned CSG receiver scene with sphere cutter and non-CSG control created"));
#elif defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER)
            NWB_LOGGER_ESSENTIAL_INFO(NWB_TEXT("CsgSkinnedVisibleSmokeProject: transparent skinned CSG receiver scene with non-CSG control created"));
#elif defined(NWB_CSG_SKINNED_VISIBLE_SPHERE_CUTTER)
            NWB_LOGGER_ESSENTIAL_INFO(NWB_TEXT("CsgSkinnedVisibleSmokeProject: skinned CSG receiver scene with sphere cutter and non-CSG control created"));
#else
            NWB_LOGGER_ESSENTIAL_INFO(NWB_TEXT("CsgSkinnedVisibleSmokeProject: skinned CSG receiver scene with non-CSG control created"));
#endif
        }
        return true;
    }

    public void onShutdown()override{
        this.m_context.graphics.setFrameSubmissionSuspended(false);
        this.destroyWorld();
        [essential] info("CsgSkinnedVisibleSmokeProject: shutdown");
    }

    public b8 onUpdate(in f32 delta)override{
        const u32 captureFreezeFrame = RendererBaselineCaptureFreezeFrame();
        if(captureFreezeFrame != 0u && this.m_rendererBaselineRenderedFrameCount >= captureFreezeFrame){
            if(!this.m_rendererBaselineCapturePaused){
                // Freeze the animated pose at the target frame for baseline capture.
                this.m_context.graphics.setFrameSubmissionSuspended(true);
                this.m_rendererBaselineCapturePaused = true;
                [essential] info("CsgSkinnedVisibleSmokeProject: renderer baseline capture ready after {} rendered frames; render submission suspended", this.m_rendererBaselineRenderedFrameCount);
            }
            return true;
        }

        const f32 fixedDelta = RendererBaselineFixedDelta();
        f32 safeDelta = 0.0f;
        if(fixedDelta > 0.0f)
            safeDelta = fixedDelta;
        else if(IsFinite(delta))
            safeDelta = Max(delta, 0.0f);
        this.m_fpsProbe.recordFrame(safeDelta);
        this.m_animationTime = Min(safeDelta, s_CsgSkinnedMaxAnimationDelta) * s_CsgSkinnedCutterAnimationSpeed + this.m_animationTime;

        const VectorSingle receiverRotation = BuildCsgSkinnedReceiverRotation(this.m_animationTime);
        this.updateSceneTransforms(receiverRotation, LoadFloat(this.m_cutterLocalCenter));
        if(!TickSmokeWorld(safeDelta, SmokeWorldRef(this.m_world)))
            return false;
        ++this.m_rendererBaselineRenderedFrameCount;
        return true;
    }

    private void destroyWorld(){
        DestroySmokeSkinnedRenderWorld(this.m_context, this.m_world);
    }

    private EntityID createSkinnedReceiverInstance(in VectorSingle position, in VectorSingle colorTint){
        const SmokeTintedModelEntityResult modelResult = CreateTintedModelEntity(
            s_CsgSkinnedModel,
            s_CsgSkinnedReceiverMaterial,
            NameTextAscii(s_SmokeSurfaceMaterialInterface),
            colorTint,
            position,
            VectorSingle(1.0f, 1.0f, 1.0f, 0.0f),
            SmokeWorldRef(this.m_world)
        );
        if(!modelResult.tintApplied)
            error("CsgSkinnedVisibleSmokeProject: failed to set receiver material tint");
        return modelResult.entity;
    }

    private b8 installCsgReceiverOnSpawnedModelObject(){
        this.m_receiverObject = FindSpawnedModelObject(this.m_receiver, s_SmokeNameMesh, ModelObjectKind::SkinnedMesh, SmokeWorldRef(this.m_world));
        if(!this.m_receiverObject.valid()){
            error("CsgSkinnedVisibleSmokeProject: failed to find spawned receiver model object");
            return false;
        }
        AddSkinnedCsgMeshReceiver(
            this.m_receiverObject,
            s_CsgSkinnedReceiverGroup,
            !s_CsgSkinnedTransparentReceiver,
            s_CsgSkinnedTransparentReceiver,
            SmokeWorldRef(this.m_world)
        );
        return true;
    }

    private void createReceiver(){
        const f32 alpha = CsgSkinnedReceiverAlpha();
        this.m_plainReceiver = this.createSkinnedReceiverInstance(VectorSingle(-s_CsgSkinnedReceiverOffsetX, 0.0f, 0.0f, 0.0f), VectorSingle(s_CsgSkinnedPlainReceiverTint.x, s_CsgSkinnedPlainReceiverTint.y, s_CsgSkinnedPlainReceiverTint.z, alpha));
        this.m_receiver = this.createSkinnedReceiverInstance(VectorSingle(s_CsgSkinnedReceiverOffsetX, 0.0f, 0.0f, 0.0f), VectorSingle(s_CsgSkinnedCsgReceiverTint.x, s_CsgSkinnedCsgReceiverTint.y, s_CsgSkinnedCsgReceiverTint.z, alpha));
    }

    private VectorSingle loadCutterAnchorLocalCenter()const{
        VectorSingle result = 0.0f;
        native(mut result){
            const SIMDVectorSingle fallback = VectorSet(0.0f, s_CsgSkinnedCutterAnchorFallbackY, 0.0f, 0.0f);
            result = fallback;
            const auto modelAsset = this->m_context->assetManager.loadSync(Impl::Model::AssetTypeName(), s_CsgSkinnedModel.name());
            if(!modelAsset){
                NWB_LOGGER_ERROR(NWB_TEXT("CsgSkinnedVisibleSmokeProject: failed to load model for cutter anchor"));
            }
            else{
                NWB_ASSERT(*modelAsset);
                const auto* model = Core::Assets::CastAsset<Impl::Model>(modelAsset->get());
                if(model && !model->skeletonObjects().empty()){
                    const auto skeletonAsset = this->m_context->assetManager.loadSync(Impl::Skeleton::AssetTypeName(), model->skeletonObjects().front().skeleton.name());
                    if(!skeletonAsset){
                        NWB_LOGGER_ERROR(NWB_TEXT("CsgSkinnedVisibleSmokeProject: failed to load skeleton for cutter anchor"));
                    }
                    else{
                        NWB_ASSERT(*skeletonAsset);
                        const auto* skeleton = Core::Assets::CastAsset<Impl::Skeleton>(skeletonAsset->get());
                        if(skeleton){
                            const u32 jointCount = skeleton->jointCount();
                            const u32 anchorIndex = skeleton->findJointIndex(s_CsgSkinnedCutterAnchorBoneName);
                            if(anchorIndex == Impl::s_SkeletonInvalidJointIndex || anchorIndex >= jointCount){
                                NWB_LOGGER_ERROR(NWB_TEXT("CsgSkinnedVisibleSmokeProject: skeleton has no '{}' bone for cutter anchor"), ConvertString(s_CsgSkinnedCutterAnchorBoneName.resolvedText()));
                            }
                            else{
                                SIMDMatrix boneToModel = LoadFloat(skeleton->joints()[anchorIndex].localBindPose);
                                for(u32 parentIndex = skeleton->joints()[anchorIndex].parentIndex; parentIndex != Impl::s_SkeletonInvalidJointIndex && parentIndex < jointCount; parentIndex = skeleton->joints()[parentIndex].parentIndex)
                                    boneToModel = MatrixMultiply(LoadFloat(skeleton->joints()[parentIndex].localBindPose), boneToModel);
                                // Bone origin in model space is the matrix translation column.
                                result = VectorMergeX(VectorSplatW(boneToModel.v[0]), VectorSplatW(boneToModel.v[1]), VectorSplatW(boneToModel.v[2]), VectorZero());
                            }
                        }
                    }
                }
            }
        }
        return result;
    }

    private void createCutter(in VectorSingle cutterLocalCenter){
        native(in cutterLocalCenter){
            auto entity = this->m_world->createEntity();
            auto& cutter = entity.addComponent<Impl::CsgCutterComponent>();
            cutter.receiverGroup = s_CsgSkinnedReceiverGroup;
#if defined(NWB_CSG_SKINNED_VISIBLE_SPHERE_CUTTER)
            cutter.shapeType = Name(Impl::s_CsgSphereShapeName);
            Impl::CsgSphereShapeParameters parameters;
            parameters.radius = Float4(s_CsgSkinnedSphereCutterRadius, 0.0f, 0.0f, 0.0f);
#else
            cutter.shapeType = Name(Impl::s_CsgCapsuleShapeName);
            Impl::CsgCapsuleShapeParameters parameters;
            parameters.radiusHalfHeight = Float4(s_CsgSkinnedCapsuleCutterRadius, s_CsgSkinnedCapsuleCutterHalfHeight, 0.0f, 0.0f);
#endif
            AssignCsgCutterParameters(parameters, cutter);
            const SIMDVectorSingle receiverRotation = BuildCsgSkinnedReceiverRotation(0.0f);
            AssignCsgCutterTransform(BuildCsgSkinnedCutterWorldCenter(cutterLocalCenter, receiverRotation), BuildCsgSkinnedCutterWorldRotation(0.0f, receiverRotation), cutter);
            this->m_cutter = entity.id();
        }
    }

    private void updateSceneTransforms(in VectorSingle receiverRotation, in VectorSingle cutterLocalCenter){
        const f32x4 storedReceiverRotation = f32x4(receiverRotation);
        const VectorSingle cutterCenter = BuildCsgSkinnedCutterWorldCenter(cutterLocalCenter, receiverRotation);
        const VectorSingle cutterRotation = BuildCsgSkinnedCutterWorldRotation(this.m_animationTime, receiverRotation);
        native(
            in plainReceiver = this.m_plainReceiver,
            in csgReceiver = this.m_receiver,
            in cutterEntity = this.m_cutter,
            in storedReceiverRotation,
            in cutterCenter,
            in cutterRotation,
            mut world = this.m_world
        ){
            for(const Core::ECS::EntityID entity : { plainReceiver, csgReceiver }){
                if(auto* transform = world->tryGetComponent<Impl::Scene::TransformComponent>(entity))
                    transform->rotation = storedReceiverRotation;
            }
            if(auto* cutter = world->tryGetComponent<Impl::CsgCutterComponent>(cutterEntity))
                AssignCsgCutterTransform(cutterCenter, cutterRotation, *cutter);
        }
    }

    private Float4 m_cutterLocalCenter = Float4(0.0f, s_CsgSkinnedCutterAnchorFallbackY, 0.0f, 0.0f);
    private mut ProjectRuntimeContext m_context;
    private NotNullUniquePtr<World> m_world;
    private FpsProbe m_fpsProbe;
    private EntityID m_plainReceiver = s_InvalidEntityId;
    private EntityID m_receiver = s_InvalidEntityId;
    private EntityID m_receiverObject = s_InvalidEntityId;
    private EntityID m_cutter = s_InvalidEntityId;
    private f32 m_animationTime = s_CsgSkinnedInitialAnimationTime;
    private u32 m_rendererBaselineRenderedFrameCount = 0u;
    private b8 m_rendererBaselineCapturePaused = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB::ProjectFrameClientSize NWB::QueryProjectFrameClientSize(){
    return { NWB::Tests::Smoke::s_CsgSkinnedFrameClientWidth, NWB::Tests::Smoke::s_CsgSkinnedFrameClientHeight };
}

TStringView NWB::QueryProjectWindowTitle()noexcept{
#if defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER) && defined(NWB_CSG_SKINNED_VISIBLE_SPHERE_CUTTER)
    return NWB_TEXT("NWB Transparent Skinned Sphere CSG Smoke");
#elif defined(NWB_CSG_SKINNED_VISIBLE_TRANSPARENT_RECEIVER)
    return NWB_TEXT("NWB Transparent Skinned CSG Smoke");
#elif defined(NWB_CSG_SKINNED_VISIBLE_SPHERE_CUTTER)
    return NWB_TEXT("NWB Skinned Sphere CSG Smoke");
#else
    return NWB_TEXT("NWB Skinned CSG Smoke");
#endif
}

UniquePtr<NWB::IProjectEntryCallbacks> NWB::CreateProjectEntryCallbacks(NWB::ProjectRuntimeContext& context){
    return MakeUnique<NWB::Tests::Smoke::CsgSkinnedVisibleSmokeProject>(context);
}


