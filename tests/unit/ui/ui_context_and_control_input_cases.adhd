    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_TRUE(self.m_context.input().actions().empty());
}

void VerifyUiContextTests_StaleStateCannotConsumeAReplacementActionOrConsumeOutsideAnActiveBuild(mut UiContextTests self){
    const Expected<WidgetState> originalResult = self.prepare(1u, MakeUiContextRoot(131u, 1u));
    ASSERT_TRUE(originalResult.has_value());
    const WidgetState original = originalResult.value();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const Expected<WidgetState> changedResult = self.prepare(2u, original.root, WidgetKind::Checkbox);
    ASSERT_TRUE(changedResult.has_value());
    const WidgetState changed = changedResult.value();
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_TRUE(self.click().pointerConsumed);
    ASSERT_EQ(self.m_context.input().actions().size(), 1u);
    EXPECT_FALSE(self.m_context.takeActivation(changed, true));
    EXPECT_EQ(self.m_context.input().actions().size(), 1u);
    ASSERT_TRUE(self.m_context.beginFrame(3u));
    ASSERT_TRUE(self.m_context.beginRoot(original.root));
    const Expected<WidgetState> current = self.declareState(s_UiContextActionKey, WidgetKind::Checkbox);
    ASSERT_TRUE(current.has_value());
    EXPECT_FALSE(self.m_context.takeActivation(original, true));
    EXPECT_EQ(self.m_context.input().actions().size(), 1u);
    WidgetState staleLifetime = original;
    staleLifetime.lastSeenFrame = 3u;
    staleLifetime.kind = WidgetKind::Checkbox;
    EXPECT_FALSE(self.m_context.takeActivation(staleLifetime, true));
    EXPECT_EQ(self.m_context.input().actions().size(), 1u);
    WidgetState wrongRoot = current.value();
    ++wrongRoot.root.generation;
    EXPECT_FALSE(self.m_context.takeActivation(wrongRoot, true));
    EXPECT_EQ(self.m_context.input().actions().size(), 1u);
    EXPECT_TRUE(self.m_context.takeActivation(current.value(), true));
    EXPECT_TRUE(self.m_context.input().actions().empty());
    ASSERT_TRUE(self.m_context.addTarget(current.value(), MakeUiContextButtonTarget()));
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
}

void VerifyUiContextTests_TargetAdmissionRejectsForeignRootPriorFrameAndReplacedLifetimeSnapshots(mut UiContextTests self){
    const Expected<WidgetState> originalResult = self.prepare(1u, MakeUiContextRoot(141u, 1u));
    ASSERT_TRUE(originalResult.has_value());
    const WidgetState original = originalResult.value();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    ASSERT_TRUE(self.m_context.beginFrame(2u));
    ASSERT_TRUE(self.m_context.beginRoot(MakeUiContextRoot(142u, 1u)));
    EXPECT_FALSE(self.m_context.addTarget(original, MakeUiContextButtonTarget()));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
    self.m_context.abandonFrame();
    ASSERT_TRUE(self.m_context.beginFrame(3u));
    ASSERT_TRUE(self.m_context.beginRoot(original.root));
    EXPECT_FALSE(self.m_context.addTarget(original, MakeUiContextButtonTarget()));
    EXPECT_TRUE(self.m_context.failed());
    self.m_context.abandonFrame();
    ASSERT_TRUE(self.m_context.beginFrame(4u));
    ASSERT_TRUE(self.m_context.beginRoot(original.root));
    const Expected<WidgetState> current = self.declareState(s_UiContextActionKey, WidgetKind::Checkbox);
    ASSERT_TRUE(current.has_value());
    EXPECT_GT(current.value().declarationGeneration, original.declarationGeneration);
    WidgetState staleLifetime = original;
    staleLifetime.lastSeenFrame = 4u;
    staleLifetime.kind = WidgetKind::Checkbox;
    EXPECT_FALSE(self.m_context.addTarget(staleLifetime, MakeUiContextButtonTarget()));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(4u));
}

void VerifyUiContextTests_DenseReorderedDeclarationsKeepLifetimesAcrossRetirement(mut UiContextTests self){
    const u32 count = 2048u;
    const WidgetRoot root = MakeUiContextRoot(151u, 1u);

    ASSERT_TRUE(self.m_context.beginFrame(1u));
    ASSERT_TRUE(self.m_context.beginRoot(root));
    u64 retainedGeneration = 0u;
    u64 removedGeneration = 0u;
    for(u32 index = 0u; index < count; ++index){
        const Expected<WidgetState> state = self.declareIndexState(index);
        ASSERT_TRUE(state.has_value());
        ASSERT_TRUE(self.m_context.addTarget(state.value(), MakeUiContextButtonTarget()));
        EXPECT_FALSE(self.m_context.takeActivation(state.value(), true));
        if(index == 0u)
            retainedGeneration = state.value().declarationGeneration;
        if(index == 1u)
            removedGeneration = state.value().declarationGeneration;
    }
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(1u));

    ASSERT_TRUE(self.m_context.beginFrame(2u));
    ASSERT_TRUE(self.m_context.beginRoot(root));
    for(u32 remaining = count; remaining > 0u; --remaining){
        const u32 index = remaining - 1u;
        if((index & 1u) != 0u)
            continue;
        const Expected<WidgetState> state = self.declareIndexState(index);
        ASSERT_TRUE(state.has_value());
        ASSERT_TRUE(self.m_context.addTarget(state.value(), MakeUiContextButtonTarget()));
        EXPECT_FALSE(self.m_context.takeActivation(state.value(), true));
        if(index == 0u)
            EXPECT_EQ(state.value().declarationGeneration, retainedGeneration);
    }
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    ASSERT_EQ(self.m_context.states().entries().size(), count / 2u);

    ASSERT_TRUE(self.m_context.beginFrame(3u));
    ASSERT_TRUE(self.m_context.beginRoot(root));
    for(u32 index = 0u; index < count; ++index){
        const Expected<WidgetState> state = self.declareIndexState(index);
        ASSERT_TRUE(state.has_value());
        ASSERT_TRUE(self.m_context.addTarget(state.value(), MakeUiContextButtonTarget()));
        EXPECT_FALSE(self.m_context.takeActivation(state.value(), true));
        if(index == 0u)
            EXPECT_EQ(state.value().declarationGeneration, retainedGeneration);
        if(index == 1u)
            EXPECT_GT(state.value().declarationGeneration, removedGeneration);
    }
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_EQ(self.m_context.states().entries().size(), count);
}

void VerifyUiContextTests_CapacityReplacementPreservesSurvivorLifetimesAndDeclarationPointers(mut UiContextTests self){
    const WidgetRoot root = MakeUiContextRoot(161u, 1u);
    ASSERT_TRUE(self.m_context.beginFrame(1u));
    ASSERT_TRUE(self.m_context.beginRoot(root));
    WidgetState survivor = WidgetState();
    WidgetState omitted = WidgetState();
    for(usize index = 0u; index < s_WidgetMaxStates; ++index){
        const Expected<WidgetState> state = self.declareIndexState(index);
        ASSERT_TRUE(state.has_value());
        if(index == 0u)
            survivor = state.value();
        else if(index == 1u)
            omitted = state.value();
    }
    ASSERT_TRUE(self.m_context.addTarget(survivor, MakeUiContextButtonTarget()));
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    ASSERT_TRUE(self.click().pointerConsumed);

    ASSERT_TRUE(self.m_context.beginFrame(2u));
    ASSERT_TRUE(self.m_context.beginRoot(root));
    ASSERT_TRUE(self.declareCapacityGrowthAndCheckPointerStability(survivor));
    EXPECT_EQ(self.m_context.states().entries().size(), s_WidgetMaxStates * 2u - 1u);
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.states().entries().size(), s_WidgetMaxStates);
    EXPECT_FALSE(self.findState(omitted.id).has_value());
    const Optional<WidgetState> foundSurvivor = self.findState(survivor.id);
    ASSERT_TRUE(foundSurvivor.has_value());
    EXPECT_EQ(foundSurvivor.value().declarationGeneration, survivor.declarationGeneration);

    ASSERT_TRUE(self.m_context.beginFrame(3u));
    ASSERT_TRUE(self.m_context.beginRoot(root));
    for(usize index = 0u; index < s_WidgetMaxStates; ++index)
        ASSERT_TRUE(self.declareIndexState(cast<usize>(s_WidgetMaxStates * 2u) + index).has_value());
    EXPECT_EQ(self.m_context.states().entries().size(), s_WidgetMaxStates * 2u);
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_EQ(self.m_context.states().entries().size(), s_WidgetMaxStates);
    EXPECT_FALSE(self.findState(survivor.id).has_value());
}

void VerifyUiContextTests_RetiringAPassiveLabelPreservesLiveInputBeforeAndAfterPublication(mut UiContextTests self){
    const WidgetRoot root = MakeUiContextRoot(181u, 1u);
    ASSERT_TRUE(self.m_context.beginFrame(1u));
    ASSERT_TRUE(self.m_context.beginRoot(root));
    Expected<WidgetState> action = self.declareState(s_UiContextActionKey, WidgetKind::Button);
    ASSERT_TRUE(action.has_value());
    const WidgetState retained = action.value();
    ASSERT_TRUE(self.m_context.addTarget(retained, MakeUiContextButtonTarget()));
    const Expected<WidgetState> label = self.declareState("label", WidgetKind::Label);
    ASSERT_TRUE(label.has_value());
    const WidgetId omitted = label.value().id;
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    ASSERT_TRUE(self.click().pointerConsumed);
    ASSERT_TRUE(self.queuePointer(InputEventType::PrimaryDown));
    ASSERT_TRUE(self.m_context.input().process().pointerConsumed);
    const u64 hoverActivity = self.m_context.input().hoverActivityGeneration();
    ASSERT_EQ(self.m_context.input().actions().size(), 1u);
    const u64 actionSequence = self.m_context.input().actions()[0u].id.sequence;

    ASSERT_TRUE(self.m_context.beginFrame(2u));
    ASSERT_TRUE(self.m_context.beginRoot(root));
    action = self.declareState(s_UiContextActionKey, WidgetKind::Button);
    ASSERT_TRUE(action.has_value());
    ASSERT_TRUE(self.m_context.addTarget(action.value(), MakeUiContextButtonTarget()));
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    EXPECT_FALSE(self.findState(omitted).has_value());
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    EXPECT_EQ(self.m_context.input().focus(), retained.id);
    EXPECT_EQ(self.m_context.input().capture(), retained.id);
    EXPECT_EQ(self.m_context.input().hover(), retained.id);
    EXPECT_EQ(self.m_context.input().hoverActivityGeneration(), hoverActivity);
    ASSERT_EQ(self.m_context.input().actions().size(), 1u);
    EXPECT_EQ(self.m_context.input().actions()[0u].id.sequence, actionSequence);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().focus(), retained.id);
    EXPECT_EQ(self.m_context.input().capture(), retained.id);
    EXPECT_EQ(self.m_context.input().hoverActivityGeneration(), hoverActivity);
    EXPECT_TRUE(self.m_context.input().consumeActivation(retained.id));
    EXPECT_FALSE(self.m_context.input().consumeActivation(retained.id));
    ASSERT_TRUE(self.queuePointer(InputEventType::PrimaryUp));
    EXPECT_TRUE(self.m_context.input().process().pointerConsumed);
    EXPECT_TRUE(self.m_context.input().consumeActivation(retained.id));
    EXPECT_FALSE(self.m_context.input().consumeActivation(retained.id));
}

void VerifyUiContextTests_RepeatedCapacityFailuresRetireOmittedStatesAndAllowRetry(mut UiContextTests self){
    const WidgetRoot root = MakeUiContextRoot(171u, 1u);
    WidgetState retained = WidgetState();
    const usize maxStates = cast<usize>(s_WidgetMaxStates);
    for(usize attempt = 0u; attempt < 3u; ++attempt){
        ASSERT_TRUE(self.m_context.beginFrame(cast<u64>(attempt + 1u)));
        ASSERT_TRUE(self.m_context.beginRoot(root));
        const Expected<WidgetState> first = self.declareIndexState(0u);
        ASSERT_TRUE(first.has_value());
        if(attempt != 0u)
            EXPECT_EQ(first.value().declarationGeneration, retained.declarationGeneration);
        retained = first.value();
        for(usize index = 1u; index < maxStates; ++index)
            ASSERT_TRUE(self.declareIndexState(attempt * maxStates + index).has_value());
        EXPECT_FALSE(self.declareIndexState((attempt + 1u) * maxStates).has_value());
        EXPECT_TRUE(self.m_context.failed());
        EXPECT_FALSE(self.m_context.endRoot());
        EXPECT_FALSE(self.m_context.finishFrame());
        self.m_context.abandonFrame();
        EXPECT_EQ(self.m_context.states().entries().size(), s_WidgetMaxStates);
        const Optional<WidgetState> foundRetained = self.findState(retained.id);
        ASSERT_TRUE(foundRetained.has_value());
        EXPECT_EQ(foundRetained.value().declarationGeneration, retained.declarationGeneration);
    }
    ASSERT_TRUE(self.m_context.beginFrame(4u));
    ASSERT_TRUE(self.m_context.beginRoot(root));
    const Expected<WidgetState> first = self.declareIndexState(0u);
    ASSERT_TRUE(first.has_value());
    EXPECT_EQ(first.value().declarationGeneration, retained.declarationGeneration);
    for(usize index = 1u; index < maxStates; ++index)
        ASSERT_TRUE(self.declareIndexState(maxStates * 3u + index).has_value());
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(4u));
    EXPECT_EQ(self.m_context.states().entries().size(), s_WidgetMaxStates);
}


