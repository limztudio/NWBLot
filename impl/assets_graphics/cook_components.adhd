    if(!skeletonEntityName.has_value())
        return MakeUnexpected(Failure());
    entry.component.skeletonEntityName = skeletonEntityName.value();
    if(!BuildComponentAssetFromEntry<SkinnedMeshBindingComponentAsset, SkinnedMeshBindingComponentCookEntry>(entry).has_value())
        return MakeUnexpected(Failure());
    return entry;
}

b8 ReadCsgReceiverComponentCookData(
    in Name virtualPath,
    in Path file,
    in MetascriptValue asset,
    in StringView prefix,
    mut Name outVirtualPath,
    mut CsgReceiverComponent outComponent
){
    if(!ValidateOptionalSceneMetadataMap(file, asset, prefix))
        return false;
    TypedComponentCookEntry<CsgReceiverComponent> tempEntry;
    if(!AssignCookEntryVirtualPath(virtualPath, file, prefix, tempEntry))
        return false;
    outVirtualPath = tempEntry.virtualPath;
    if(!asset.isMap())
        return true;
    if(!ValidateMetadataAssetFields(file, asset, prefix, IsAllowedCsgReceiverComponentMetadataField))
        return false;
    const Expected<Name> receiverGroup = ReadUnpaddedNameField(file, asset, prefix, s_CsgReceiverGroupField, false);
    if(!receiverGroup.has_value())
        return false;
    outComponent.receiverGroup = receiverGroup.value();
    if(!ReadOptionalMetadataBoolField(file, asset, prefix, s_CsgReceiverEnabledField, outComponent.enabled))
        return false;
    if(!ReadOptionalMetadataBoolField(file, asset, prefix, s_CsgReceiverAffectOpaquePassField, outComponent.affectOpaquePass))
        return false;
    return ReadOptionalMetadataBoolField(file, asset, prefix, s_CsgReceiverAffectTransparentPassField, outComponent.affectTransparentPass);
}

Expected<CsgReceiverComponentCookEntry> ParseCsgReceiverComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue asset){
    CsgReceiverComponentCookEntry entry;
    if(!ReadCsgReceiverComponentCookData(virtualPath, file, asset, s_CsgReceiverComponentDiagnosticPrefix, entry.virtualPath, entry.component))
        return MakeUnexpected(Failure());
    if(!BuildComponentAssetFromEntry<CsgReceiverComponentAsset, CsgReceiverComponentCookEntry>(entry).has_value())
        return MakeUnexpected(Failure());
    return entry;
}

Expected<TypedComponentCookEntry<CsgMeshReceiverComponent<Kind>>> ParseCsgMeshReceiverComponentCookMetadata<AssetT : IComponent, const u8 Kind>(
    in Name virtualPath,
    in Path file,
    in MetascriptValue asset,
    in StringView prefix
){
    TypedComponentCookEntry<CsgMeshReceiverComponent<Kind>> entry;
    CsgReceiverComponent receiver;
    if(!ReadCsgReceiverComponentCookData(virtualPath, file, asset, prefix, entry.virtualPath, receiver))
        return MakeUnexpected(Failure());
    AssignCsgMeshReceiverFromBase<Kind>(receiver, entry.component);
    if(!BuildComponentAssetFromEntry<AssetT, TypedComponentCookEntry<CsgMeshReceiverComponent<Kind>>>(entry).has_value())
        return MakeUnexpected(Failure());
    return entry;
}

Expected<StaticCsgMeshComponentCookEntry> ParseStaticCsgMeshComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue asset){
    return ParseCsgMeshReceiverComponentCookMetadata<StaticCsgMeshComponentAsset, 0u>(
        virtualPath, file, asset, s_StaticCsgMeshComponentDiagnosticPrefix
    );
}

Expected<SkinnedCsgMeshComponentCookEntry> ParseSkinnedCsgMeshComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue asset){
    return ParseCsgMeshReceiverComponentCookMetadata<SkinnedCsgMeshComponentAsset, 1u>(
        virtualPath, file, asset, s_SkinnedCsgMeshComponentDiagnosticPrefix
    );
}

Expected<CsgCutterComponentCookEntry> ParseCsgCutterComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue asset){
    CsgCutterComponentCookEntry entry;
    if(!CheckMetadataAssetMap(file, asset, s_CsgCutterComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_CsgCutterComponentDiagnosticPrefix, entry)
        || !ValidateMetadataAssetFields(file, asset, s_CsgCutterComponentDiagnosticPrefix, IsAllowedCsgCutterComponentMetadataField))
        return MakeUnexpected(Failure());

    const Expected<Name> receiverGroup = ReadUnpaddedNameField(file, asset, s_CsgCutterComponentDiagnosticPrefix, s_CsgReceiverGroupField, false);
    if(!receiverGroup.has_value())
        return MakeUnexpected(Failure());
    entry.component.receiverGroup = receiverGroup.value();

    const Expected<Name> shapeType = ReadUnpaddedNameField(file, asset, s_CsgCutterComponentDiagnosticPrefix, s_CsgCutterShapeTypeField, true);
    if(!shapeType.has_value())
        return MakeUnexpected(Failure());
    entry.component.shapeType = shapeType.value();

    MatrixSingle worldToShape = MatrixSingle(entry.component.worldToShape);
    if(!ReadOptionalAffineMatrix3x4Field(file, asset, s_CsgCutterComponentDiagnosticPrefix, s_CsgCutterWorldToShapeField, worldToShape))
        return MakeUnexpected(Failure());
    entry.component.worldToShape = f32x3x4(worldToShape);
    MatrixSingle shapeToWorld = MatrixSingle(entry.component.shapeToWorld);
    if(!ReadOptionalAffineMatrix3x4Field(file, asset, s_CsgCutterComponentDiagnosticPrefix, s_CsgCutterShapeToWorldField, shapeToWorld))
        return MakeUnexpected(Failure());
    entry.component.shapeToWorld = f32x3x4(shapeToWorld);
    if(!ReadOptionalByteListField(file, asset, s_CsgCutterComponentDiagnosticPrefix, s_CsgCutterParameterBytesField, entry.component.parameterBytes))
        return MakeUnexpected(Failure());
    if(!ReadOptionalMetadataBoolField(file, asset, s_CsgCutterComponentDiagnosticPrefix, s_CsgCutterActiveField, entry.component.active))
        return MakeUnexpected(Failure());
    if(!ReadOptionalMetadataBoolField(file, asset, s_CsgCutterComponentDiagnosticPrefix, s_CsgCutterSyncFromTransformField, entry.component.syncFromTransform))
        return MakeUnexpected(Failure());
    if(!BuildComponentAssetFromEntry<CsgCutterComponentAsset, CsgCutterComponentCookEntry>(entry).has_value())
        return MakeUnexpected(Failure());
    return entry;
}


