const usize s_GpuTimingTimestampEventsPerEnvelope = 2u;
const usize s_GpuTimingMinOverlappingQueueCount = 2u;


class GpuPacketEnvelopeMetrics{
    public f64 secondsPerTick = 0.0;
    // Union length with accepted work in flight on at least two physical queues.
    public u64 queueOverlapTicks = 0u;
}


class GpuTimestampEvent{
    public u64 ticks = 0u;
    public b8 begins = false;
}


