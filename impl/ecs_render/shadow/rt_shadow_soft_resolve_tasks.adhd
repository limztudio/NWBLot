class ShadowVisibilityOpaqueGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut GraphicsRuntime m_graphics;
    private mut DeferredFrameTargets m_targets;
    private DeferredLightingGraphResources m_deferredLightingResources;
    private b8 m_hardwareShadowSupported;
    private b8 m_graphOwnsOpaqueTemporalMergeEntryStates;
    private FrozenLightSpaceShadowHandle m_lightSpace;
    private mut GpuTimingSubmissionTicket m_timingTicket;
    private mut Optional<GpuTimingMeasure> m_asyncTiming;
    private mut Optional<GpuTimingMeasure> m_shadowVisibilityTiming;
    private in b8 m_prepared;
    private mut b8 m_opaqueProduced;
    private mut u32 m_opaqueFrameIndex;

    public ShadowVisibilityOpaqueGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut GraphicsRuntime graphics,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources deferredLightingResources,
        in b8 hardwareShadowSupported,
        in b8 graphOwnsOpaqueTemporalMergeEntryStates,
        in FrozenLightSpaceShadowHandle lightSpace,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming,
        mut Optional<GpuTimingMeasure> shadowVisibilityTiming,
        in borrow b8 prepared,
        mut b8 opaqueProduced,
        mut u32 opaqueFrameIndex
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_graphics = graphics;
        this.m_targets = targets;
        this.m_deferredLightingResources = deferredLightingResources;
        this.m_hardwareShadowSupported = hardwareShadowSupported;
        this.m_graphOwnsOpaqueTemporalMergeEntryStates = graphOwnsOpaqueTemporalMergeEntryStates;
        this.m_lightSpace = lightSpace;
        this.m_timingTicket = timingTicket;
        this.m_asyncTiming = asyncTiming;
        this.m_shadowVisibilityTiming = shadowVisibilityTiming;
        this.m_prepared = prepared;
        this.m_opaqueProduced = opaqueProduced;
        this.m_opaqueFrameIndex = opaqueFrameIndex;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute | GpuQueueCapability::Transfer); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_deferredLightingResources.valid())
            return false;

        const Optional<GpuPhysicalQueueInfo> queue = context.compiledPlan.findQueueInfo(context.queue);
        if(!queue.has_value())
            return false;

        this.m_opaqueProduced = false;
        this.m_opaqueFrameIndex = 0u;
        if(this.m_shadowVisibilityTiming.has_value()){
            this.m_shadowVisibilityTiming.value().discardTiming();
            this.m_shadowVisibilityTiming.reset();
        }
        if(this.m_asyncTiming.has_value()){
            this.m_asyncTiming.value().discardTiming();
            this.m_asyncTiming.reset();
        }

        GpuTimingTicketRecordingScope timingRecording(this.m_timingTicket);
        if(queue.value().queueClass == CommandQueue::Compute)
            this.m_asyncTiming.emplace(this.m_graphics.gpuTiming(), s_TimingScopeAsyncShadow, this.m_graphics.getDevice(), commandList);
        this.m_shadowVisibilityTiming.emplace(this.m_graphics.gpuTiming(), s_TimingScopeShadowVisibility, this.m_graphics.getDevice(), commandList);

        b8 opaqueRecorded = false;
        if(this.m_prepared){
            Optional<in LightSpaceShadowSnapshot> lightSpaceOpt;
            if(this.m_lightSpace.valid())
                lightSpaceOpt = Optional<in LightSpaceShadowSnapshot>(this.m_lightSpace.deref().snapshot);
            Expected<u32> opaqueFrame = MakeUnexpected(Failure());
            if(this.m_hardwareShadowSupported)
                opaqueFrame = this.m_raytracingSystem.renderShadowVisibilityOpaque(commandList, this.m_targets, this.m_deferredLightingResources, this.m_graphOwnsOpaqueTemporalMergeEntryStates, lightSpaceOpt);
            else
                opaqueFrame = this.m_raytracingSystem.renderGpuBvhShadowVisibilityOpaque(commandList, this.m_targets, this.m_deferredLightingResources, this.m_graphOwnsOpaqueTemporalMergeEntryStates, lightSpaceOpt);
            opaqueRecorded = opaqueFrame.has_value();
            if(opaqueFrame.has_value())
                this.m_opaqueFrameIndex = opaqueFrame.value();
        }
        if(!opaqueRecorded){
            warning("RendererSystem: split opaque soft-shadow producer failed; retaining all-lit visibility");
            this.m_raytracingSystem.clearShadowVisibility(commandList, this.m_targets);
            commandList.setTextureState(this.m_targets.shadowVisibility.deref(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
            commandList.commitBarriers();
            this.m_shadowVisibilityTiming.value().discardTiming();
            this.m_shadowVisibilityTiming.reset();
            if(this.m_asyncTiming.has_value()){
                this.m_asyncTiming.value().discardTiming();
                this.m_asyncTiming.reset();
            }
            return true;
        }

        this.m_opaqueProduced = true;
        const b8 visibilityMarkerFinished = FinishSplitGpuTimingMarker(this.m_shadowVisibilityTiming);
        b8 asyncMarkerFinished = true;
        if(this.m_asyncTiming.has_value())
            asyncMarkerFinished = FinishSplitGpuTimingMarker(this.m_asyncTiming);
        if(!asyncMarkerFinished || !visibilityMarkerFinished){
            DiscardGpuTimingMeasure(this.m_asyncTiming);
            DiscardGpuTimingMeasure(this.m_shadowVisibilityTiming);
            return false;
        }
        return true;
    }

    public void discarded(){
        this.m_opaqueProduced = false;
        DiscardGpuTimingMeasure(this.m_shadowVisibilityTiming);
        DiscardGpuTimingMeasure(this.m_asyncTiming);
    }
}

class ShadowVisibilityOpaqueFirstWaveletGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut GraphicsRuntime m_graphics;
    private mut DeferredFrameTargets m_targets;
    private DeferredLightingGraphResources m_deferredLightingResources;
    private mut GpuTimingSubmissionTicket m_timingTicket;
    private mut Optional<GpuTimingMeasure> m_asyncTiming;
    private mut Optional<GpuTimingMeasure> m_shadowVisibilityTiming;
    private mut Optional<GpuTimingMeasure> m_opaqueResolveTiming;
    private mut b8 m_opaqueProduced;
    private in u32 m_opaqueFrameIndex;
    private b8 m_hardwareShadowSupported;
    private b8 m_graphOwnsOpaqueTemporalMergeEntryStates;
    private b8 m_deferUpsample;
    private b8 m_deferWavelet;

    public ShadowVisibilityOpaqueFirstWaveletGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut GraphicsRuntime graphics,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources deferredLightingResources,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming,
        mut Optional<GpuTimingMeasure> shadowVisibilityTiming,
        mut Optional<GpuTimingMeasure> opaqueResolveTiming,
        mut b8 opaqueProduced,
        in borrow u32 opaqueFrameIndex,
        in b8 hardwareShadowSupported,
        in b8 graphOwnsOpaqueTemporalMergeEntryStates,
        in b8 deferUpsample,
        in b8 deferWavelet
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_graphics = graphics;
        this.m_targets = targets;
        this.m_deferredLightingResources = deferredLightingResources;
        this.m_timingTicket = timingTicket;
        this.m_asyncTiming = asyncTiming;
        this.m_shadowVisibilityTiming = shadowVisibilityTiming;
        this.m_opaqueResolveTiming = opaqueResolveTiming;
        this.m_opaqueProduced = opaqueProduced;
        this.m_opaqueFrameIndex = opaqueFrameIndex;
        this.m_hardwareShadowSupported = hardwareShadowSupported;
        this.m_graphOwnsOpaqueTemporalMergeEntryStates = graphOwnsOpaqueTemporalMergeEntryStates;
        this.m_deferUpsample = deferUpsample;
        this.m_deferWavelet = deferWavelet;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_deferredLightingResources.valid())
            return false;
        if(!this.m_opaqueProduced)
            return true;

        GpuTimingTicketRecordingScope timingRecording(this.m_timingTicket);
        if(this.m_opaqueResolveTiming.has_value()){
            this.m_opaqueResolveTiming.value().discardTiming();
            this.m_opaqueResolveTiming.reset();
        }
        this.m_opaqueResolveTiming.emplace(this.m_graphics.gpuTiming(), s_TimingScopeShadowOpaqueResolve, this.m_graphics.getDevice(), commandList);
        if(this.m_raytracingSystem.renderSoftOpaqueShadowResolvePhase(
            commandList,
            this.m_targets,
            this.m_deferredLightingResources,
            this.m_opaqueFrameIndex,
            this.m_hardwareShadowSupported,
            this.m_graphOwnsOpaqueTemporalMergeEntryStates,
            ResolveSoftShadowOpaqueFirstWaveletPhase(this.m_deferWavelet)
        )){
            if(this.m_deferUpsample){
                this.m_opaqueResolveTiming.value().finishTiming(commandList);
                this.m_opaqueResolveTiming.reset();
                return true;
            }
            return FinishSplitGpuTimingMarker(this.m_opaqueResolveTiming);
        }

        warning("RendererSystem: split opaque soft-shadow first wavelet failed; retaining all-lit visibility");
        RecoverOpaqueSoftShadowAllLit(this.m_raytracingSystem, this.m_targets, this.m_opaqueProduced, this.m_asyncTiming, this.m_shadowVisibilityTiming, this.m_opaqueResolveTiming, commandList);
        return true;
    }

    public void discarded(){
        this.m_opaqueProduced = false;
        DiscardGpuTimingMeasure(this.m_asyncTiming);
        DiscardGpuTimingMeasure(this.m_shadowVisibilityTiming);
        DiscardGpuTimingMeasure(this.m_opaqueResolveTiming);
    }
}

class ShadowVisibilityOpaqueResolveTailGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut DeferredFrameTargets m_targets;
    private DeferredLightingGraphResources m_deferredLightingResources;
    private mut GpuTimingSubmissionTicket m_timingTicket;
    private mut Optional<GpuTimingMeasure> m_asyncTiming;
    private mut Optional<GpuTimingMeasure> m_shadowVisibilityTiming;
    private mut Optional<GpuTimingMeasure> m_opaqueResolveTiming;
    private mut b8 m_opaqueProduced;
    private in u32 m_opaqueFrameIndex;
    private b8 m_hardwareShadowSupported;

    public ShadowVisibilityOpaqueResolveTailGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources deferredLightingResources,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming,
        mut Optional<GpuTimingMeasure> shadowVisibilityTiming,
        mut Optional<GpuTimingMeasure> opaqueResolveTiming,
        mut b8 opaqueProduced,
        in borrow u32 opaqueFrameIndex,
        in b8 hardwareShadowSupported
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_targets = targets;
        this.m_deferredLightingResources = deferredLightingResources;
        this.m_timingTicket = timingTicket;
        this.m_asyncTiming = asyncTiming;
        this.m_shadowVisibilityTiming = shadowVisibilityTiming;
        this.m_opaqueResolveTiming = opaqueResolveTiming;
        this.m_opaqueProduced = opaqueProduced;
        this.m_opaqueFrameIndex = opaqueFrameIndex;
        this.m_hardwareShadowSupported = hardwareShadowSupported;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_deferredLightingResources.valid())
            return false;
        if(!this.m_opaqueProduced)
            return true;
        if(!this.m_opaqueResolveTiming.has_value())
            return false;

        GpuTimingTicketRecordingScope timingRecording(this.m_timingTicket);
        if(this.m_raytracingSystem.renderSoftOpaqueShadowResolveTail(commandList, this.m_targets, this.m_deferredLightingResources, this.m_opaqueFrameIndex, this.m_hardwareShadowSupported)){
            this.m_opaqueResolveTiming.value().finishTiming(commandList);
            this.m_opaqueResolveTiming.reset();
            return true;
        }

        warning("RendererSystem: split opaque soft-shadow resolve tail failed; retaining all-lit visibility");
        RecoverOpaqueSoftShadowAllLit(this.m_raytracingSystem, this.m_targets, this.m_opaqueProduced, this.m_asyncTiming, this.m_shadowVisibilityTiming, this.m_opaqueResolveTiming, commandList);
        return true;
    }

    public void discarded(){
        this.m_opaqueProduced = false;
        DiscardGpuTimingMeasure(this.m_asyncTiming);
        DiscardGpuTimingMeasure(this.m_shadowVisibilityTiming);
        DiscardGpuTimingMeasure(this.m_opaqueResolveTiming);
    }
}

class ShadowTransparentSoftTraceGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut DeferredFrameTargets m_targets;
    private DeferredLightingGraphResources m_deferredLightingResources;
    private FrozenLightSpaceShadowHandle m_lightSpace;
    private mut GpuTimingSubmissionTicket m_timingTicket;
    private in b8 m_opaqueProduced;
    private in u32 m_opaqueFrameIndex;
    private mut b8 m_transparentTraceProduced;

    public ShadowTransparentSoftTraceGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources deferredLightingResources,
        in FrozenLightSpaceShadowHandle lightSpace,
        mut GpuTimingSubmissionTicket timingTicket,
        in borrow b8 opaqueProduced,
        in borrow u32 opaqueFrameIndex,
        mut b8 transparentTraceProduced
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_targets = targets;
        this.m_deferredLightingResources = deferredLightingResources;
        this.m_lightSpace = lightSpace;
        this.m_timingTicket = timingTicket;
        this.m_opaqueProduced = opaqueProduced;
        this.m_opaqueFrameIndex = opaqueFrameIndex;
        this.m_transparentTraceProduced = transparentTraceProduced;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute | GpuQueueCapability::Transfer); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_deferredLightingResources.valid())
            return false;

        this.m_transparentTraceProduced = false;
        if(!this.m_opaqueProduced)
            return true;

        GpuTimingTicketRecordingScope timingRecording(this.m_timingTicket);
        Optional<in LightSpaceShadowSnapshot> lightSpaceOpt;
        if(this.m_lightSpace.valid())
            lightSpaceOpt = Optional<in LightSpaceShadowSnapshot>(this.m_lightSpace.deref().snapshot);
        if(!this.m_raytracingSystem.renderSoftTransparentShadowTrace(commandList, this.m_targets, this.m_deferredLightingResources, this.m_opaqueFrameIndex, true, lightSpaceOpt)){
            warning("RendererSystem: split transparent soft-shadow trace could not record; preserving opaque visibility");
            return true;
        }
        this.m_transparentTraceProduced = true;
        return true;
    }

    public void discarded(){
        this.m_transparentTraceProduced = false;

    }
}

class ShadowTransparentSoftTemporalMergeGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut GraphicsRuntime m_graphics;
    private mut DeferredFrameTargets m_targets;
    private DeferredLightingGraphResources m_deferredLightingResources;
    private mut GpuTimingSubmissionTicket m_timingTicket;
    private mut Optional<GpuTimingMeasure> m_transparentResolveTiming;
    private in b8 m_opaqueProduced;
    private mut b8 m_transparentTraceProduced;
    private in u32 m_opaqueFrameIndex;
    private b8 m_graphOwnsTransparentTemporalMergeEntryStates;
    private b8 m_combinedTemporal;
    private b8 m_hardwareShadowSupported;

    public ShadowTransparentSoftTemporalMergeGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut GraphicsRuntime graphics,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources deferredLightingResources,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> transparentResolveTiming,
        in borrow b8 opaqueProduced,
        mut b8 transparentTraceProduced,
        in borrow u32 opaqueFrameIndex,
        in b8 graphOwnsTransparentTemporalMergeEntryStates,
        in b8 combinedTemporal,
        in b8 hardwareShadowSupported
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_graphics = graphics;
        this.m_targets = targets;
        this.m_deferredLightingResources = deferredLightingResources;
        this.m_timingTicket = timingTicket;
        this.m_transparentResolveTiming = transparentResolveTiming;
        this.m_opaqueProduced = opaqueProduced;
        this.m_transparentTraceProduced = transparentTraceProduced;
        this.m_opaqueFrameIndex = opaqueFrameIndex;
        this.m_graphOwnsTransparentTemporalMergeEntryStates = graphOwnsTransparentTemporalMergeEntryStates;
        this.m_combinedTemporal = combinedTemporal;
        this.m_hardwareShadowSupported = hardwareShadowSupported;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    private b8 recoverOpaqueTemporal(mut CommandList commandList)const{
        if(!this.m_combinedTemporal)
            return true;
        return this.m_raytracingSystem.renderSoftOpaqueShadowResolvePhase(commandList, this.m_targets, this.m_deferredLightingResources, this.m_opaqueFrameIndex, this.m_hardwareShadowSupported, true, SoftShadowOpaqueResolvePhase::TemporalOnly);
    }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_deferredLightingResources.valid())
            return false;
        if(!this.m_opaqueProduced)
            return true;

        GpuTimingTicketRecordingScope timingRecording(this.m_timingTicket);
        if(!this.m_transparentTraceProduced)
            return this.recoverOpaqueTemporal(commandList);
        if(this.m_transparentResolveTiming.has_value()){
            this.m_transparentResolveTiming.value().discardTiming();
            this.m_transparentResolveTiming.reset();
        }
        this.m_transparentResolveTiming.emplace(this.m_graphics.gpuTiming(), s_TimingScopeShadowTransparentResolve, this.m_graphics.getDevice(), commandList);
        b8 merged = false;
        if(this.m_combinedTemporal)
            merged = this.m_raytracingSystem.renderSoftShadowCombinedTemporalMerge(commandList, this.m_targets);
        else
            merged = this.m_raytracingSystem.renderSoftTransparentShadowTemporalMerge(commandList, this.m_targets, this.m_deferredLightingResources, this.m_opaqueFrameIndex, this.m_graphOwnsTransparentTemporalMergeEntryStates);
        if(merged)
            return FinishSplitGpuTimingMarker(this.m_transparentResolveTiming);

        warning("RendererSystem: split transparent soft-shadow temporal merge failed; preserving opaque visibility");
        this.m_transparentTraceProduced = false;
        this.m_transparentResolveTiming.value().discardTiming();
        this.m_transparentResolveTiming.reset();
        return this.recoverOpaqueTemporal(commandList);
    }

    public void discarded(){
        this.m_transparentTraceProduced = false;
        DiscardGpuTimingMeasure(this.m_transparentResolveTiming);
    }
}

class ShadowTransparentSoftFirstWaveletGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut GraphicsRuntime m_graphics;
    private mut DeferredFrameTargets m_targets;
    private DeferredLightingGraphResources m_deferredLightingResources;
    private mut GpuTimingSubmissionTicket m_timingTicket;
    private mut Optional<GpuTimingMeasure> m_transparentResolveTiming;
    private in b8 m_opaqueProduced;
    private mut b8 m_transparentTraceProduced;
    private in u32 m_opaqueFrameIndex;
    private b8 m_graphOwnsTransparentWaveletInputBoundary;
    private b8 m_startsTransparentResolveTiming;
    private b8 m_combinedWavelet;

    public ShadowTransparentSoftFirstWaveletGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut GraphicsRuntime graphics,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources deferredLightingResources,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> transparentResolveTiming,
        in borrow b8 opaqueProduced,
        mut b8 transparentTraceProduced,
        in borrow u32 opaqueFrameIndex,
        in b8 graphOwnsTransparentWaveletInputBoundary,
        in b8 startsTransparentResolveTiming,
        in b8 combinedWavelet
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_graphics = graphics;
        this.m_targets = targets;
        this.m_deferredLightingResources = deferredLightingResources;
        this.m_timingTicket = timingTicket;
        this.m_transparentResolveTiming = transparentResolveTiming;
        this.m_opaqueProduced = opaqueProduced;
        this.m_transparentTraceProduced = transparentTraceProduced;
        this.m_opaqueFrameIndex = opaqueFrameIndex;
        this.m_graphOwnsTransparentWaveletInputBoundary = graphOwnsTransparentWaveletInputBoundary;
        this.m_startsTransparentResolveTiming = startsTransparentResolveTiming;
        this.m_combinedWavelet = combinedWavelet;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_deferredLightingResources.valid())
            return false;
        if(!this.m_opaqueProduced)
            return true;
        if(this.m_combinedWavelet){
            GpuTimingTicketRecordingScope timingRecording(this.m_timingTicket);
            if(this.m_transparentTraceProduced && this.m_transparentResolveTiming.has_value()){
                if(this.m_raytracingSystem.renderSoftShadowCombinedWavelet(commandList, this.m_targets))
                    return true;
            }
            this.m_transparentTraceProduced = false;
            DiscardGpuTimingMeasure(this.m_transparentResolveTiming);
            return this.m_raytracingSystem.renderSoftOpaqueShadowResolvePhase(commandList, this.m_targets, this.m_deferredLightingResources, this.m_opaqueFrameIndex, true, true, SoftShadowOpaqueResolvePhase::WaveletOnly);
        }
        if(!this.m_transparentTraceProduced)
            return true;

        GpuTimingTicketRecordingScope timingRecording(this.m_timingTicket);
        if(this.m_startsTransparentResolveTiming){
            if(this.m_transparentResolveTiming.has_value()){
                this.m_transparentResolveTiming.value().discardTiming();
                this.m_transparentResolveTiming.reset();
            }
            this.m_transparentResolveTiming.emplace(this.m_graphics.gpuTiming(), s_TimingScopeShadowTransparentResolve, this.m_graphics.getDevice(), commandList);
        }
        else if(!this.m_transparentResolveTiming.has_value()){
            warning("RendererSystem: split transparent soft-shadow wavelet lost its temporal timing envelope; preserving opaque visibility");
            this.m_transparentTraceProduced = false;
            return true;
        }

        if(this.m_raytracingSystem.renderSoftTransparentShadowFirstWavelet(commandList, this.m_targets, this.m_deferredLightingResources, this.m_opaqueFrameIndex, this.m_graphOwnsTransparentWaveletInputBoundary)){
            if(this.m_startsTransparentResolveTiming && !FinishSplitGpuTimingMarker(this.m_transparentResolveTiming))
                return false;
            return true;
        }

        warning("RendererSystem: split transparent soft-shadow first wavelet failed; preserving opaque visibility");
        this.m_transparentTraceProduced = false;
        if(this.m_transparentResolveTiming.has_value()){
            this.m_transparentResolveTiming.value().discardTiming();
            this.m_transparentResolveTiming.reset();
        }
        return true;
    }

    public void discarded(){
        this.m_transparentTraceProduced = false;
        DiscardGpuTimingMeasure(this.m_transparentResolveTiming);
    }
}

class ShadowTransparentSoftFoldGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut DeferredFrameTargets m_targets;
    private DeferredLightingGraphResources m_deferredLightingResources;
    private mut GpuTimingSubmissionTicket m_timingTicket;
    private mut Optional<GpuTimingMeasure> m_asyncTiming;
    private mut Optional<GpuTimingMeasure> m_shadowVisibilityTiming;
    private mut Optional<GpuTimingMeasure> m_transparentResolveTiming;
    private in b8 m_opaqueProduced;
    private mut b8 m_transparentTraceProduced;
    private in u32 m_opaqueFrameIndex;
    private b8 m_combinedUpsample;

    public ShadowTransparentSoftFoldGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources deferredLightingResources,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming,
        mut Optional<GpuTimingMeasure> shadowVisibilityTiming,
        mut Optional<GpuTimingMeasure> transparentResolveTiming,
        in borrow b8 opaqueProduced,
        mut b8 transparentTraceProduced,
        in borrow u32 opaqueFrameIndex,
        in b8 combinedUpsample
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_targets = targets;
        this.m_deferredLightingResources = deferredLightingResources;
        this.m_timingTicket = timingTicket;
        this.m_asyncTiming = asyncTiming;
        this.m_shadowVisibilityTiming = shadowVisibilityTiming;
        this.m_transparentResolveTiming = transparentResolveTiming;
        this.m_opaqueProduced = opaqueProduced;
        this.m_transparentTraceProduced = transparentTraceProduced;
        this.m_opaqueFrameIndex = opaqueFrameIndex;
        this.m_combinedUpsample = combinedUpsample;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_deferredLightingResources.valid())
            return false;

        const Optional<GpuPhysicalQueueInfo> queue = context.compiledPlan.findQueueInfo(context.queue);
        if(!queue.has_value())
            return false;
        if(!this.m_opaqueProduced)
            return true;
        if(!this.m_shadowVisibilityTiming.has_value() || (queue.value().queueClass == CommandQueue::Compute && !this.m_asyncTiming.has_value()))
            return false;

        GpuTimingTicketRecordingScope timingRecording(this.m_timingTicket);
        if(this.m_transparentTraceProduced){
            if(!this.m_transparentResolveTiming.has_value())
                return false;
            b8 resolved = false;
            if(this.m_combinedUpsample)
                resolved = this.m_raytracingSystem.renderSoftShadowTerminalUpsample(commandList, this.m_targets, this.m_deferredLightingResources, true);
            else
                resolved = this.m_raytracingSystem.renderSoftTransparentShadowFold(commandList, this.m_targets, this.m_deferredLightingResources, this.m_opaqueFrameIndex);
            if(resolved){
                this.m_transparentResolveTiming.value().finishTiming(commandList);
                this.m_transparentResolveTiming.reset();
            }
            else{
                warning("RendererSystem: split transparent soft-shadow resolve failed; preserving opaque visibility");
                this.m_transparentTraceProduced = false;
                this.m_transparentResolveTiming.value().discardTiming();
                this.m_transparentResolveTiming.reset();
            }
        }else{
            if(this.m_transparentResolveTiming.has_value()){
                this.m_transparentResolveTiming.value().discardTiming();
                this.m_transparentResolveTiming.reset();
            }
            warning("RendererSystem: split transparent soft-shadow trace or first wavelet failed; preserving opaque visibility");
        }

        if(ShouldPublishDeferredOpaqueFallbackUpsample(this.m_combinedUpsample, this.m_transparentTraceProduced)){
            if(!this.m_raytracingSystem.renderSoftShadowTerminalUpsample(commandList, this.m_targets, this.m_deferredLightingResources, false))
                return false;
        }

        this.m_shadowVisibilityTiming.value().finishTiming(commandList);
        this.m_shadowVisibilityTiming.reset();
        if(this.m_asyncTiming.has_value()){
            this.m_asyncTiming.value().finishTiming(commandList);
            this.m_asyncTiming.reset();
        }
        return true;
    }

    public void discarded(){
        this.m_transparentTraceProduced = false;
        DiscardGpuTimingMeasure(this.m_asyncTiming);
        DiscardGpuTimingMeasure(this.m_shadowVisibilityTiming);
        DiscardGpuTimingMeasure(this.m_transparentResolveTiming);
        this.m_raytracingSystem.discardSoftShadowTemporalHistory();
    }
}

class ShadowVisibilityGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut GraphicsRuntime m_graphics;
    private mut DeferredFrameTargets m_targets;
    private DeferredLightingGraphResources m_deferredLightingResources;
    private mut GpuTimingSubmissionTicket m_timingTicket;
    private in b8 m_prepared;
    private GraphOwnedAdaptiveShadowPlan m_graphOwnedAdaptivePlan;
    private b8 m_hardwareShadowSupported;

    public ShadowVisibilityGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut GraphicsRuntime graphics,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources deferredLightingResources,
        mut GpuTimingSubmissionTicket timingTicket,
        in borrow b8 prepared,
        in GraphOwnedAdaptiveShadowPlan graphOwnedAdaptivePlan,
        in b8 hardwareShadowSupported
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_graphics = graphics;
        this.m_targets = targets;
        this.m_deferredLightingResources = deferredLightingResources;
        this.m_timingTicket = timingTicket;
        this.m_prepared = prepared;
        this.m_graphOwnedAdaptivePlan = graphOwnedAdaptivePlan;
        this.m_hardwareShadowSupported = hardwareShadowSupported;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute | GpuQueueCapability::Transfer); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_deferredLightingResources.valid())
            return false;

        Optional<in GraphOwnedAdaptiveShadowPlan> graphOwnedAdaptivePlan;
        if(this.m_graphOwnedAdaptivePlan.enabled)
            graphOwnedAdaptivePlan = Optional<in GraphOwnedAdaptiveShadowPlan>(this.m_graphOwnedAdaptivePlan);

        const Optional<GpuPhysicalQueueInfo> queue = context.compiledPlan.findQueueInfo(context.queue);
        if(!queue.has_value())
            return false;

        GpuTimingTicketRecordingScope timingRecording(this.m_timingTicket);
        Optional<GpuTimingMeasure> asyncTiming;
        if(queue.value().queueClass == CommandQueue::Compute)
            asyncTiming.emplace(this.m_graphics.gpuTiming(), s_TimingScopeAsyncShadow, this.m_graphics.getDevice(), commandList);

        b8 shadowVisibilityWritten = false;
        if(this.m_prepared && this.m_hardwareShadowSupported){
            shadowVisibilityWritten = this.m_raytracingSystem.renderShadowVisibility(commandList, this.m_targets, this.m_deferredLightingResources).has_value();
            if(!shadowVisibilityWritten)
                warning("RendererSystem: ray-traced shadow visibility pass failed");
        }
        else if(this.m_prepared)
            shadowVisibilityWritten = this.m_raytracingSystem.renderGpuBvhShadowVisibility(commandList, this.m_targets, this.m_deferredLightingResources, false, false, false, graphOwnedAdaptivePlan).has_value();

        if(asyncTiming.has_value()){
            asyncTiming.value().finishTiming(commandList);
            asyncTiming.reset();
        }
        return true;
    }

    public void discarded(){
        this.m_raytracingSystem.discardSoftShadowTemporalHistory();

    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


SoftShadowOpaqueResolvePhase ResolveSoftShadowOpaqueFirstWaveletPhase(in b8 deferWavelet){
    if(deferWavelet)
        return SoftShadowOpaqueResolvePhase::TemporalOnly;
    return SoftShadowOpaqueResolvePhase::TemporalAndWavelet;
}

b8 ShouldPublishDeferredOpaqueFallbackUpsample(in b8 combinedUpsample, in b8 transparentTraceProduced){
    return combinedUpsample && !transparentTraceProduced;
}

void RecoverOpaqueSoftShadowAllLit(
    mut RendererRayTracingSystem raytracingSystem,
    mut DeferredFrameTargets targets,
    mut b8 opaqueProduced,
    mut Optional<GpuTimingMeasure> asyncTiming,
    mut Optional<GpuTimingMeasure> shadowVisibilityTiming,
    mut Optional<GpuTimingMeasure> opaqueResolveTiming,
    mut CommandList commandList
){
    raytracingSystem.clearShadowVisibility(commandList, targets);
    commandList.setTextureState(targets.shadowVisibility.deref(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
    commandList.commitBarriers();
    opaqueProduced = false;
    if(asyncTiming.has_value()){
        asyncTiming.value().discardTiming();
        asyncTiming.reset();
    }
    if(shadowVisibilityTiming.has_value()){
        shadowVisibilityTiming.value().discardTiming();
        shadowVisibilityTiming.reset();
    }
    opaqueResolveTiming.value().discardTiming();
    opaqueResolveTiming.reset();
}

Expected<GpuTaskId> RendererRayTracingSystem::declareShadowVisibilityTask(
    mut GpuTaskGraph graph,
    in GpuTaskDesc desc,
    in DeferredLightingGraphResources deferredLightingResources,
    in borrow b8 prepared,
    in b8 hardwareShadowSupported,
    in GraphOwnedAdaptiveShadowPlan graphOwnedAdaptivePlan,
    mut DeferredFrameTargets targets,
    mut GpuTimingSubmissionTicket timingTicket
){
    return graph.addPayloadTask(desc, ShadowVisibilityGraphTask(
        this,
        this.m_graphics,
        targets,
        deferredLightingResources,
        timingTicket,
        prepared,
        graphOwnedAdaptivePlan,
        hardwareShadowSupported
    ));
}

