void VerifyEditCaretFixture_UnreadyGeometryRejectsEveryQuery(mut EditCaretFixture self){
    EXPECT_FALSE(self.m_geometry.caretRect(0u).has_value());
    EXPECT_FALSE(self.m_geometry.hitTest(Point()).has_value());
    EXPECT_FALSE(self.m_geometry.verticalTarget(0u, true, 0.0f).has_value());
    EXPECT_FALSE(self.m_geometry.rangeOnLine(EditBoxRange(), 0u, 1.0f).has_value());
}

void VerifyEditCaretFixture_HardLinesRetainEmptyAndTrailingLineStops(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("ab\n\nc\n"));
    ASSERT_EQ(self.m_geometry.lines().size(), 4u);
    ASSERT_EQ(self.m_geometry.caretStops().size(), 7u);
    Array<usize, 4u> begin = Array<usize, 4u>();
    begin[0u] = 0u;
    begin[1u] = 3u;
    begin[2u] = 4u;
    begin[3u] = 6u;
    Array<usize, 4u> end = Array<usize, 4u>();
    end[0u] = 2u;
    end[1u] = 3u;
    end[2u] = 5u;
    end[3u] = 6u;
    Array<usize, 4u> breakEnd = Array<usize, 4u>();
    breakEnd[0u] = 3u;
    breakEnd[1u] = 4u;
    breakEnd[2u] = 6u;
    breakEnd[3u] = 6u;
    Array<u32, 4u> first = Array<u32, 4u>();
    first[0u] = 0u;
    first[1u] = 3u;
    first[2u] = 4u;
    first[3u] = 6u;
    Array<u32, 4u> count = Array<u32, 4u>();
    count[0u] = 3u;
    count[1u] = 1u;
    count[2u] = 2u;
    count[3u] = 1u;
    for(u32 index = 0u; index < 4u; ++index){
        const EditCaretLine line = self.m_geometry.lines()[index];
        EXPECT_EQ(line.byteBegin, begin[index]);
        EXPECT_EQ(line.byteEnd, end[index]);
        EXPECT_EQ(line.breakEnd, breakEnd[index]);
        EXPECT_EQ(line.firstStop, first[index]);
        EXPECT_EQ(line.stopCount, count[index]);
    }
    self.expectCaret(2u, 20.0f, 0.0f);
    self.expectCaret(3u, 0.0f, 12.0f);
    self.expectCaret(4u, 0.0f, 24.0f);
    self.expectCaret(5u, 10.0f, 24.0f);
    self.expectCaret(6u, 0.0f, 36.0f);
}

void VerifyEditCaretFixture_LineBreakCaretBelongsToItsPrecedingLineAndFollowingByteStartsTheNext(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("ab\ncd"));
    self.expectCaret(2u, 20.0f, 0.0f);
    self.expectCaret(3u, 0.0f, 12.0f);
    self.expectCaret(5u, 20.0f, 12.0f);
    EXPECT_EQ(self.m_geometry.caretStops()[2u].lineIndex, 0u);
    EXPECT_EQ(self.m_geometry.caretStops()[3u].lineIndex, 1u);
}

void VerifyEditCaretFixture_MultilineHitTestingChoosesYBeforeXAndKeepsExactMidpointTies(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("ab\n\nc\n"));
    Expected<usize> byte = self.m_geometry.hitTest(MakeUiControlCaretPoint(5.0f, 0.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 0u);
    byte = self.m_geometry.hitTest(MakeUiControlCaretPoint(5.01f, 0.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 1u);
    byte = self.m_geometry.hitTest(MakeUiControlCaretPoint(100.0f, 12.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 3u);
    byte = self.m_geometry.hitTest(MakeUiControlCaretPoint(5.0f, 24.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 4u);
    byte = self.m_geometry.hitTest(MakeUiControlCaretPoint(5.01f, 24.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 5u);
    byte = self.m_geometry.hitTest(MakeUiControlCaretPoint(-100.0f, -100.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 0u);
    byte = self.m_geometry.hitTest(MakeUiControlCaretPoint(100.0f, 100.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 6u);
}

void VerifyEditCaretFixture_SingleLineLigatureInterpolationAndTieBehaviorRemainUnchanged(mut EditCaretFixture self){
