inline constexpr Name s_UtilityArena = "utilities/fbx_to_nwb/utility";

using UtilityString = DefaultAString<Core::Alloc::GlobalArena, QueryUtilityGlobalArena<s_UtilityArena>>;
using ScratchPath = ::Path<Core::Alloc::ScratchArena>;
using ScratchString = ::AString<Core::Alloc::ScratchArena>;
using ScratchStringStream = ::AStringStream<Core::Alloc::ScratchArena>;

template<typename T>
using UtilityVector = DefaultVector<T, Core::Alloc::GlobalArena, QueryUtilityGlobalArena<s_UtilityArena>>;

template<typename T>
using UtilityScratchVector = ::Vector<T, Core::Alloc::ScratchArena>;

template<typename K, typename V, typename Hash = Hasher<K>, typename Equal = EqualTo<K>>
using UtilityScratchMap = ::HashMap<K, V, Core::Alloc::ScratchArena, Hash, Equal>;

using ScratchU32Vector = UtilityScratchVector<u32>;


