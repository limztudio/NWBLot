b8 ExtractRagdollComponentDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    const Expected<PhysicsRagdollDepEntry> entryRes = ReadCookDependencyEntry<PhysicsRagdollDepEntry>(context, s_RagdollComponentDiagnosticPrefix, ParseRagdollDepEntry);
    if(!entryRes.has_value())
        return false;
    in PhysicsRagdollDepEntry dep = entryRes.value();
    if(dep.skeletonAsset.valid() && !collector.addAssetDependency(dep.skeletonAsset.name(), Skeleton::AssetTypeName()))
        return false;
    if(dep.ragdollAsset.valid() && !collector.addAssetDependency(dep.ragdollAsset.name(), RagdollAsset::AssetTypeName()))
        return false;
    if(dep.materialAsset.valid() && !collector.addAssetDependency(dep.materialAsset.name(), PhysicsMaterialAsset::AssetTypeName()))
        return false;
    for(usize i = 0u; i < dep.boneMaterialAssets.size(); ++i){
        if(!collector.addAssetDependency(dep.boneMaterialAssets[i].name(), PhysicsMaterialAsset::AssetTypeName()))
            return false;
    }
    return CollectSourceFileDepsFromValue(context.nwbFilePath, s_RagdollComponentDiagnosticPrefix, context.asset, collector);
}

