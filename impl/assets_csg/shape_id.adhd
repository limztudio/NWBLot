// Cooked-asset ABI shared by the CSG cooker and the runtime registry.
type CsgShapeTypeId = u32;

const CsgShapeTypeId s_InvalidCsgShapeTypeId = 0u;
const u32 s_CsgShapeHashFoldShiftBits = 32u;

// Built-in cutter names shared by cooker, registry, and CPU rebuild; one copy, no drift.
const Name s_CsgPlaneShapeName = "engine/csg/plane";
const Name s_CsgBoxShapeName = "engine/csg/box";
const Name s_CsgSphereShapeName = "engine/csg/sphere";
const Name s_CsgCapsuleShapeName = "engine/csg/capsule";

const StringView s_DefaultGeneratedIncludeDirectory = "engine/csg/generated";
const StringView s_GeneratedIncludeCacheDirectory = "csg_modules";

const StringView s_CsgShapeField = "shape";
const StringView s_CsgModuleField = "module";
const StringView s_CsgModuleIncludeField = "module_include";
const StringView s_CsgEvalField = "eval";
const StringView s_CsgSlangIncludeExtension = ".slangi";
const StringView s_CsgShapeMetaDiagnosticPrefix = "CSG shape meta";
const StringView s_CsgShapeIncludeGenerationLabel = "CSG shape include generation";
const StringView s_CsgBuiltInModuleIncludeFileName = "built_in.slangi";
const StringView s_CsgEmptyGeneratedModule = "// Generated by the asset cook; no CSG shape assets were discovered.\n";

b8 IsAllowedCsgShapeAssetField(in StringView fieldName){
    return fieldName == s_CsgShapeField || fieldName == s_CsgModuleField || fieldName == s_CsgModuleIncludeField || fieldName == s_CsgEvalField;
}

// Keep the dispatch ID a deterministic Name-hash projection, not an insertion ordinal.
Expected<CsgShapeTypeId> TryResolveCsgShapeTypeIdFromName(in Name shapeName){
    if(shapeName == s_NameNone)
        return makeUnexpected(Failure());

    // HashValue returns usize and would make the cooked ID host-dependent.
    const u64 foldedHash = foldNameHash64(shapeName.hash());

    const CsgShapeTypeId typeId = cast<CsgShapeTypeId>(foldedHash ^ (foldedHash >> s_CsgShapeHashFoldShiftBits));
    if(typeId != s_InvalidCsgShapeTypeId)
        return typeId;
    return u32.max;
}

b8 IsBeforeCsgShapeCookName(in Name lhs, in Name rhs){
    return lhs.resolvedText() < rhs.resolvedText();
}

b8 ResolveAndCheckCsgShapeTypeIdCollision(
    in usize index,
    in Name shapeName,
    mut HashMap<CsgShapeTypeId, Name> inOutShapeIdNames,
    mut CsgShapeTypeId outShapeTypeId
){
    if(index >= cast<usize>(u32.max)){
        error("CSG shape cook: too many CSG shape assets");
        return false;
    }

    const Expected<CsgShapeTypeId> shapeTypeIdResult = TryResolveCsgShapeTypeIdFromName(shapeName);
    if(!shapeTypeIdResult.has_value()){
        error("CSG shape cook: shape '{}' has an invalid canonical GPU id", shapeName.resolvedText());
        return false;
    }
    const CsgShapeTypeId shapeTypeId = shapeTypeIdResult.value();

    if(inOutShapeIdNames.contains(shapeTypeId)){
        const Name existingShape = inOutShapeIdNames.at(shapeTypeId);
        error("CSG shape cook: shapes '{}' and '{}' collide on canonical GPU id {}", existingShape.resolvedText(), shapeName.resolvedText(), shapeTypeId);
        return false;
    }
    inOutShapeIdNames.try_emplace(shapeTypeId, shapeName);
    outShapeTypeId = shapeTypeId;
    return true;
}


