#include <impl/assets_shader/asset.adhd>
#include <impl/ecs_render/shader/shader_system.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 EnsurePushConstantBindingLayout(
    mut Device device,
    in u32 pushConstantBytes,
    in ShaderTypeMask visibility,
    mut BindingLayoutHandle inOutLayout
){
    if(inOutLayout.valid())
        return true;

    BindingLayoutDesc desc = BindingLayoutDesc();
    desc.setVisibility(visibility);
    desc.addItem(BindingLayoutItemPushConstants(0u, pushConstantBytes));
    const Expected<BindingLayoutHandle> layoutResult = device.createBindingLayout(desc);
    if(layoutResult.has_value()){
        inOutLayout = layoutResult.value();
        return true;
    }
    inOutLayout.reset();
    return false;
}

Expected<ComputePipelineHandle> CreateHeapComputePipeline(
    mut Device device,
    in ShaderHandle shader,
    in BindingLayoutHandle bindingLayout,
    in b8 includeAccelStruct
){
    in GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized() || (includeAccelStruct && !heap.hasAccelStructLayout()))
        return MakeUnexpected(Failure());

    ComputePipelineDesc desc = ComputePipelineDesc();
    desc.setComputeShader(shader).addBindingLayout(bindingLayout).addBindingLayout(heap.getResourceLayout()).addBindingLayout(heap.getSamplerLayout());
    if(includeAccelStruct)
        desc.addBindingLayout(heap.getAccelStructLayout());
    return device.createComputePipeline(desc);
}

b8 EnsurePushConstantComputePipeline<SubsystemT>(
    mut Device device,
    mut RendererShaderSystem shaderSystem,
    in SubsystemAssetSelector<SubsystemT, ComputeShader> selector,
    in StringView variantName,
    in Name debugName,
    in u32 pushConstantBytes,
    in b8 includeAccelStruct,
    mut BindingLayoutHandle inOutLayout,
    mut ShaderHandle inOutShader,
    mut ComputePipelineHandle inOutPipeline
){
    if(inOutPipeline.valid())
        return true;

    in GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized() || (includeAccelStruct && !heap.hasAccelStructLayout()))
        return false;
    if(!EnsurePushConstantBindingLayout(device, pushConstantBytes, ShaderTypeMask::Compute, inOutLayout))
        return false;
    if(!shaderSystem.loadShader<ComputeShader, SubsystemT>(selector, variantName, debugName, inOutShader))
        return false;
    const Expected<ComputePipelineHandle> pipelineResult = CreateHeapComputePipeline(device, inOutShader, inOutLayout, includeAccelStruct);
    if(!pipelineResult.has_value()){
        inOutPipeline.reset();
        return false;
    }
    inOutPipeline = pipelineResult.value();
    return true;
}


