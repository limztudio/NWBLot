    private b8 validateShapeDef(in ShapeDef def)const{
        if(
            !IsFinite(VectorSingle(def.density, def.material.friction, def.material.staticFriction, def.material.restitution))
            || !IsFinite(VectorSingle(def.material.rollingResistance, def.material.tangentSpeed, 0.0f, 0.0f))
            || !IsFinite(VectorSingle(def.material.surfaceVelocity))
            || !IsFinite(VectorSingle(def.material.anisotropicFriction))
            || !IsFinite(VectorSingle(def.material.frictionDirection).xyz)
            || def.density < 0.0f
            || def.material.friction < 0.0f
            || def.material.restitution < 0.0f
            || def.material.rollingResistance < 0.0f
            || def.material.anisotropicFriction.x < 0.0f
            || def.material.anisotropicFriction.y < 0.0f
            || def.material.anisotropicFriction.z < 0.0f
        )
            return false;
        if(!IsValidPositionVec3(VectorSingle(def.localTransform.position)) || !IsFinite(VectorSingle(def.localTransform.rotation)))
            return false;
        if(Vector4LengthSq(VectorSingle(def.localTransform.rotation)).x <= s_NormalizeEpsilonSq)
            return false;
        return true;
    }

    private Expected<ShapeId> attachPreparedShapeInternal(in BodyId bodyId, in ShapeDef def, in Shape proto){
        if(!this.isValidBody(bodyId) || !this.validateShapeDef(def))
            return MakeUnexpected(Failure());

        u32 shapeIdx = s_NullIndex;
        if(!this.m_freeShapeIds.empty()){
            shapeIdx = this.m_freeShapeIds[this.m_freeShapeIds.size() - 1u];
            this.m_freeShapeIds.pop_back();
        }
        else{
            shapeIdx = cast<u32>(this.m_shapes.size());
            this.m_shapes.push_back(Shape());
        }

        mut Shape shape = this.m_shapes[shapeIdx];
        u16 nextGen = shape.generation + 1u;
        if(nextGen == 0u)
            nextGen = 1u;

        shape = Shape();
        shape.generation = nextGen;
        shape.id = shapeIdx;
        shape.bodyId = bodyId.index;
        shape.type = proto.type;
        shape.geom0 = proto.geom0;
        shape.geom1 = proto.geom1;
        shape.geometryIndex = proto.geometryIndex;
        shape.localTransform = Transform3D(VectorSingle(def.localTransform.position), SafeNormalizeQuat(VectorSingle(def.localTransform.rotation)));
        shape.material = def.material;
        shape.filter = def.filter;
        shape.density = def.density;
        shape.setFlag(ShapeFlags::IsSensor, def.isSensor);
        shape.setFlag(ShapeFlags::EnableContactEvents, def.enableContactEvents);
        shape.setFlag(ShapeFlags::EnableHitEvents, def.enableHitEvents);
        shape.setFlag(ShapeFlags::EnableSensorEvents, def.enableSensorEvents);
        shape.setFlag(ShapeFlags::EnablePreSolveEvents, def.enablePreSolveEvents);
        shape.setFlag(ShapeFlags::EnablePostSolveEvents, def.enablePostSolveEvents);
        shape.setFlag(ShapeFlags::Alive, true);
        shape.setFlag(ShapeFlags::HasLocalTransform, !IsIdentityTransform(shape.localTransform));
        shape.userData = def.userData;
        if(def.enableHitEvents)
            ++this.m_hitEventShapeCount;
        if(def.isSensor && def.enableSensorEvents)
            ++this.m_sensorEventShapeCount;

        mut Body body = this.m_bodies[bodyId.index];
        shape.nextShapeId = body.headShapeId;
        body.headShapeId = shapeIdx;
        ++body.shapeCount;

        in BodySim bodySim = this.m_solverSets[body.setIndex].sims[body.localIndex];
        VectorSingle boxMin(0.0f);
        VectorSingle boxMax(0.0f);
        ComputeShapeWorldAabbValues(shape, VectorSingle(bodySim.transform.position), VectorSingle(bodySim.transform.rotation), this.m_hullShapes, this.m_meshShapes, this.m_heightfieldShapes, this.m_compoundShapes, this.m_scaledShapes, this.m_chainShapes, this.m_sdfShapes, boxMin, boxMax);
        shape.aabb = Aabb3D(boxMin, boxMax);

        if(body.setIndex != s_DisabledSetIndex){
            u32 proxyKey = s_NullIndex;
            this.m_broadPhase.createProxyWithFlags(
                body.type,
                shape.aabb,
                shape.filter.categoryBits,
                this.computeShapeTreeNodeFlags(shape),
                shapeIdx,
                true,
                proxyKey
            );
            shape.proxyKey = proxyKey;

            if(def.invokeContactCreation){
                this.ensureCpuBroadphaseSynced();
                const Aabb3D queryBox = shape.aabb;
                for(usize t = 0u; t < s_TreeCount; ++t){
                    this.m_broadPhase.trees[t].queryAabb(
                        queryBox,
                        0xffffffffu,
                        lambda[mut this, in shapeIdx](in u32 proxyId, in u32 otherShapeIdx) -> b8{
                            if(otherShapeIdx != shapeIdx)
                                this.createContactInternal(shapeIdx, otherShapeIdx);
                            return true;
                        }
                    );
                }
            }
            if(this.m_bodies[bodyId.index].type != BodyType::Dynamic)
                this.wakeOverlappingSleepingBodies(shape.aabb, bodyId.index);
        }

        if(def.updateBodyMass)
            this.updateBodyMassInternal(bodyId.index);
        else
            this.markBodyMassDirty(bodyId.index);

        if(
            shape.type == ShapeType::Hull
            || shape.type == ShapeType::Mesh
            || shape.type == ShapeType::Heightfield
            || shape.type == ShapeType::Compound
            || shape.type == ShapeType::Scaled
            || shape.type == ShapeType::Chain
            || shape.type == ShapeType::Sdf
        )
            ++this.m_geomDataStamp;
        this.markSetTopologyDirty(this.m_bodies[bodyId.index].setIndex);
        return this.makeShapeId(shapeIdx);
    }

    public Expected<ShapeId> createSphereShape(in BodyId bodyId, in ShapeDef def, in SphereShape sphere){
        if(!this.isValidBody(bodyId) || !this.validateShapeDef(def))
            return MakeUnexpected(Failure());
        if(!IsValidPositionVec3(sphere.center()) || !IsFinite(VectorSingle(sphere.radius())) || sphere.radius() <= 0.0f)
            return MakeUnexpected(Failure());
        Shape proto;
        proto.type = ShapeType::Sphere;
        proto.setSphere(sphere);
        return this.attachPreparedShapeInternal(bodyId, def, proto);
    }

    public Expected<ShapeId> createCapsuleShape(in BodyId bodyId, in ShapeDef def, in CapsuleShape capsule){
        if(!this.isValidBody(bodyId) || !this.validateShapeDef(def))
            return MakeUnexpected(Failure());
        const VectorSingle c1 = capsule.center1();
        const VectorSingle c2 = capsule.center2Vec();
        if(!IsValidPositionVec3(c1) || !IsValidPositionVec3(c2) || !IsFinite(VectorSingle(capsule.radius())) || capsule.radius() <= 0.0f)
            return MakeUnexpected(Failure());
        const f32 lenSq = Vector3LengthSq(VectorSingle(c2 - c1, 0.0f)).x;
        if(!IsFinite(VectorSingle(lenSq)) || lenSq < s_MinCapsuleLength * s_MinCapsuleLength)
            return MakeUnexpected(Failure());
        Shape proto;
        proto.type = ShapeType::Capsule;
        proto.setCapsule(capsule);
        return this.attachPreparedShapeInternal(bodyId, def, proto);
    }

