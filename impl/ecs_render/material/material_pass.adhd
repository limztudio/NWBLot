////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/material/material_internal.adhd>
#include <impl/ecs_render/material/material_pass_draw_recorder.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>
#include <impl/ecs_render/shared/frame_push_constants.adhd>
#include <impl/ecs_render/shared/renderer_push_constants_private.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_MeshEmulationVertexBufferIndex = 0u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsRejectedReusedEmulationOutputHandoff(
    in b8 emulationOutputReused,
    in b8 emulationOutputEntryStateGraphOwned,
    in b8 csgEmulationOutputEntryStateGraphOwned
){
    return emulationOutputReused && (!emulationOutputEntryStateGraphOwned || csgEmulationOutputEntryStateGraphOwned);
}

b8 UsesSplitEmulationTiming(
    in b8 emulationOutputEntryStateGraphOwned,
    in b8 csgEmulationOutputEntryStateGraphOwned,
    in b8 emulationOutputReused
){
    return (emulationOutputEntryStateGraphOwned || csgEmulationOutputEntryStateGraphOwned) && !emulationOutputReused;
}

u32 ApplyConservativeGeometryScissorFlag(in u32 dispatchFlags, in b8 conservativeGeometryScissor){
    if(conservativeGeometryScissor)
        return dispatchFlags & ~s_MeshDispatchFlagScissorCull;
    return dispatchFlags;
}

u32 ComputeObjectGeometryDecodeGroupCount(in u32 meshletCount){
    return Max(meshletCount, 1u);
}

b8 CanPrepareMaterialPassTargets(in b8 hasFramebuffer, in MaterialPipelinePass pass, in b8 avboitTargetsValid){
    if(!hasFramebuffer)
        return false;
    if(MaterialPipelinePassUsesRendererAvboit(pass) && !avboitTargetsValid)
        return false;
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MaterialPassDrawRecorder::meshMaterialPassDrawResourcesReady(in Span<MaterialPassDrawItem> drawItems, in MeshFrameBindingSnapshot frameBindings){
    for(in MaterialPassDrawItem drawItem : drawItems){
        if(!this.materialPassDrawResourcesReady(drawItem.meshResources, frameBindings) || !drawItem.pipelineResources.meshletPipeline.valid())
            return false;
    }
    return true;
}

b8 MaterialPassDrawRecorder::computeMaterialPassDrawResourcesReady(in Span<MaterialPassDrawItem> drawItems, in MeshFrameBindingSnapshot frameBindings){
    if(drawItems.empty())
        return true;

    for(in MaterialPassDrawItem drawItem : drawItems){
        in MaterialPassMeshResourceSnapshot mesh = drawItem.meshResources;
        in MaterialPassPipelineResourceSnapshot pipelineResources = drawItem.pipelineResources;
        if(
            !this.materialPassDrawResourcesReady(mesh, frameBindings)
            || !pipelineResources.computePipeline.valid()
            || !pipelineResources.emulationPipeline.valid()
            || !mesh.emulationVertexHeapHandle.valid()
            || !mesh.emulationVertexBuffer.valid()
            || !IsValidIndexedEmulationByteOffset(pipelineResources.indexedGeometryOutput, mesh.emulationIndexByteOffset)
        )
            return false;
    }
    return true;
}

void MaterialPassDrawRecorder::setMaterialPassCommonBufferStates(mut MaterialPassDrawContext context, in MaterialPassMeshResourceSnapshot mesh){
    if(!context.materialGeometryStatesGraphOwned){
        ForEachMaterialPassMeshSourceBuffer(mesh, lambda[mut context](in BufferHandle buffer) -> void{
            context.commandList.setBufferState(buffer.deref(), ResourceStates::ShaderResource);
        });
    }
    if(!context.materialFrameStatesGraphOwned){
        assert(context.frameBindings.bindingValid());
        context.commandList.setBufferState(context.frameBindings.instanceBuffer.deref(), ResourceStates::ShaderResource);
        context.commandList.setBufferState(context.frameBindings.meshView.buffer.deref(), ResourceStates::ConstantBuffer);
        context.commandList.setBufferState(context.frameBindings.materialTypedBuffer.deref(), ResourceStates::ShaderResource);
    }
}

b8 MaterialPassDrawRecorder::setMaterialPassDrawPushConstants(mut MaterialPassDrawContext context, in MaterialPassDrawItem drawItem, in MaterialPassMeshResourceSnapshot mesh){
    const u32 dispatchFlags = ResolveMaterialPassDrawDispatchFlags(
        mesh.runtimeMesh,
        mesh.dynamicMeshletBoundsFresh,
        mesh.dynamicMeshletConesFresh,
        context.pass,
        drawItem.pipelineKey.twoSided,
        drawItem.meshletConeCullScaleSafe,
        drawItem.pipelineKey.csgMode,
        drawItem.shadingModelId
    );
    const MaterialPipelineCsgBindingUse csgBindingUse = MaterialPipelineResolveCsgBindingUse(drawItem.pipelineKey.csgMode, context.pass);
    u32 csgContextHeapSlot = 0u;
    if(csgBindingUse.clip){
        if(!context.csgResources.has_value())
            return false;
        const Expected<u32> resolvedClipContext = context.csgResources.value().findClipContextHeapSlot();
        assert(resolvedClipContext.has_value());
        if(!resolvedClipContext.has_value())
            return false;
        csgContextHeapSlot = resolvedClipContext.value();
    }
    MeshFrameHeapSlots frameHeapSlots = ResolveMeshFrameHeapSlots(context.frameBindings);
    if(MaterialPipelinePassUsesRendererAvboit(context.pass)){
        SetTransparentDrawPushConstants(
            context.commandList,
            mesh.meshletCount,
            drawItem.instanceIndex,
            drawItem.materialConstantByteOffset,
            context.viewportState,
            context.avboitTargets.value(),
            frameHeapSlots,
            dispatchFlags,
            this.m_graphics.isHDR10OutputActive(),
            csgContextHeapSlot,
            context.pass == MaterialPipelinePass::AvboitRefractionCapture
        );
        return true;
    }

    // Pixel-only CSG variants reuse the unused generated-vertex lane as the context selector; geometry reads it per instance.
    frameHeapSlots.generatedVertex = csgContextHeapSlot;

    SetShaderDrivenPushConstants(context.commandList, mesh.meshletCount, drawItem.instanceIndex, drawItem.materialConstantByteOffset, context.viewportState, frameHeapSlots, dispatchFlags);
    return true;
}

void MaterialPassDrawRecorder::dispatchComputeMaterialPassDrawItem(mut MaterialPassDrawContext context, in MaterialPassDrawItem drawItem, in MaterialPassMeshResourceSnapshot mesh, in MaterialPassPipelineResourceSnapshot pipelineResources){
    ComputeState computeState;
    computeState.setPipeline(pipelineResources.computePipeline.deref());
    // Set 0 contains only the compute push range; the unified generated vertex/index UAV uses one global heap selector.

    context.commandList.setComputeState(computeState);
    this.m_graphics.getDevice().getDescriptorHeap().bindCompute(context.commandList, pipelineResources.computePipeline.deref());

    const MeshFrameHeapSlots frameHeapSlots = ResolveMeshFrameHeapSlots(context.frameBindings, mesh.emulationVertexHeapHandle.slot());
    ShaderDrivenPushConstants pushConstants = BuildShaderDrivenPushConstants(
        mesh.meshletCount,
        drawItem.instanceIndex,
        drawItem.materialConstantByteOffset,
        context.viewportState,
        frameHeapSlots,
        ResolveMaterialPassDrawDispatchFlags(
            mesh.runtimeMesh,
            mesh.dynamicMeshletBoundsFresh,
            mesh.dynamicMeshletConesFresh,
            context.pass,
            drawItem.pipelineKey.twoSided,
            drawItem.meshletConeCullScaleSafe,
            drawItem.pipelineKey.csgMode,
            drawItem.shadingModelId
        )
    );
    if(context.conservativeGeometryScissor)
        assert(pipelineResources.sharedGeometryComputeProgram);
    pushConstants.dispatchFlags = ApplyConservativeGeometryScissorFlag(pushConstants.dispatchFlags, context.conservativeGeometryScissor);
    if(pipelineResources.indexedGeometryOutput){
        assert(mesh.emulationIndexByteOffset != 0u);
        MeshComputePushConstants computePush;
        computePush.mesh = pushConstants;
        computePush.generatedIndexByteOffset = mesh.emulationIndexByteOffset;
        context.commandList.setPushConstants(computePush);
    }
    else
        context.commandList.setPushConstants(pushConstants);
    {
        GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeMeshDispatch, this.m_graphics.getDevice(), context.commandList);

        context.commandList.dispatch(mesh.meshletCount, 1u, 1u);
    }
}

void MaterialPassDrawRecorder::drawComputeMaterialPassDrawItem(mut MaterialPassDrawContext context, in MaterialPassDrawItem drawItem, in MaterialPassMeshResourceSnapshot mesh, in MaterialPassPipelineResourceSnapshot pipelineResources){
    GraphicsState graphicsState;
    graphicsState.setPipeline(pipelineResources.emulationPipeline.deref());
    graphicsState.setFramebuffer(context.framebuffer.deref());
    graphicsState.setViewport(context.viewportState);
    VertexBufferBinding vertexBinding;
    vertexBinding.setBuffer(mesh.emulationVertexBuffer.deref());
    vertexBinding.setSlot(s_MeshEmulationVertexBufferIndex);
    vertexBinding.setOffset(0u);
    graphicsState.addVertexBuffer(vertexBinding);
    if(pipelineResources.indexedGeometryOutput){
        assert(mesh.emulationIndexByteOffset != 0u);
        IndexBufferBinding indexBinding;
        indexBinding.setBuffer(mesh.emulationVertexBuffer.deref());
        indexBinding.setFormat(Format::R32_UINT);
        indexBinding.setOffset(mesh.emulationIndexByteOffset);
        graphicsState.setIndexBuffer(indexBinding);
    }

    context.commandList.setGraphicsState(graphicsState);
    this.m_graphics.getDevice().getDescriptorHeap().bindGraphics(context.commandList, pipelineResources.emulationPipeline.deref());

    if(!this.setMaterialPassDrawPushConstants(context, drawItem, mesh))
        return;

    DrawArguments drawArgs;
    drawArgs.setVertexCount(mesh.meshletPrimitiveIndexCount);
    {
        GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeRaster, this.m_graphics.getDevice(), context.commandList);

        if(pipelineResources.indexedGeometryOutput)
            context.commandList.drawIndexed(drawArgs);
        else
            context.commandList.draw(drawArgs);
    }
}

void MaterialPassDrawRecorder::renderMaterialPassDrawItems(mut MaterialPassDrawContext context, in MaterialPassDrawItemsView drawItems){
    this.renderMeshMaterialPassDrawItems(context, drawItems.meshDrawItems);
    this.renderIndexedMaterialPassDrawItems(context, drawItems.indexedDrawItems);
    if(context.emulationOutputEntryStateGraphOwned)
        this.renderComputeMaterialPassDrawItemsRasterOnly(context, drawItems.computeDrawItems);
    else
        this.renderComputeMaterialPassDrawItems(context, drawItems.computeDrawItems);
}

void MaterialPassDrawRecorder::renderMeshMaterialPassDrawItems(mut MaterialPassDrawContext context, in Span<MaterialPassDrawItem> drawItems){
    for(in MaterialPassDrawItem drawItem : drawItems){
        in MaterialPassMeshResourceSnapshot mesh = drawItem.meshResources;
        in MaterialPassPipelineResourceSnapshot pipelineResources = drawItem.pipelineResources;
        assert(this.materialPassDrawResourcesReady(mesh, context.frameBindings));
        assert(pipelineResources.meshletPipeline.valid());
        this.setMaterialPassCommonBufferStates(context, mesh);

        MeshletState meshletState;
        meshletState.setPipeline(pipelineResources.meshletPipeline.deref());
        meshletState.setFramebuffer(context.framebuffer.deref());
        meshletState.setViewport(context.viewportState);

        context.commandList.setMeshletState(meshletState);
        // Geometry streams are heap-backed for every raster material pass (opaque and AVBOIT alike).
        this.m_graphics.getDevice().getDescriptorHeap().bindGraphics(context.commandList, pipelineResources.meshletPipeline.deref());

        if(!this.setMaterialPassDrawPushConstants(context, drawItem, mesh))
            continue;
        {
            GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeMeshDispatch, this.m_graphics.getDevice(), context.commandList);

            context.commandList.dispatchMesh(mesh.meshletCount, 1u, 1u);
        }
    }
}

void MaterialPassDrawRecorder::generateComputeMaterialPassDrawItems(mut MaterialPassDrawContext context, in Span<MaterialPassDrawItem> drawItems){
    if(drawItems.empty())
        return;
    // No local output transition here. A graph producer must have declared every selected buffer as a UAV first.
    assert(context.emulationOutputEntryStateGraphOwned);
    assert(context.frameBindings.meshView.buffer.valid());

    for(in MaterialPassDrawItem drawItem : drawItems){
        in MaterialPassMeshResourceSnapshot mesh = drawItem.meshResources;
        in MaterialPassPipelineResourceSnapshot pipelineResources = drawItem.pipelineResources;
        assert(this.materialPassDrawResourcesReady(mesh, context.frameBindings));
        assert(pipelineResources.computePipeline.valid());
        assert(mesh.emulationVertexHeapHandle.valid());
        assert(mesh.emulationVertexBuffer.valid());
        this.setMaterialPassCommonBufferStates(context, mesh);
        this.dispatchComputeMaterialPassDrawItem(context, drawItem, mesh, pipelineResources);
    }
}

void MaterialPassDrawRecorder::renderComputeMaterialPassDrawItemsRasterOnly(mut MaterialPassDrawContext context, in Span<MaterialPassDrawItem> drawItems){
    if(drawItems.empty())
        return;
    // This half has no local output transition. The graph declares each unified generated buffer for vertex and index reads.
    assert(context.emulationOutputEntryStateGraphOwned);
    assert(context.frameBindings.meshView.buffer.valid());

    for(in MaterialPassDrawItem drawItem : drawItems){
        in MaterialPassMeshResourceSnapshot mesh = drawItem.meshResources;
        in MaterialPassPipelineResourceSnapshot pipelineResources = drawItem.pipelineResources;
        assert(this.materialPassDrawResourcesReady(mesh, context.frameBindings));
        assert(pipelineResources.emulationPipeline.valid());
        assert(mesh.emulationVertexBuffer.valid());
        this.setMaterialPassCommonBufferStates(context, mesh);
        this.drawComputeMaterialPassDrawItem(context, drawItem, mesh, pipelineResources);
    }
}

void MaterialPassDrawRecorder::renderComputeMaterialPassDrawItems(mut MaterialPassDrawContext context, in Span<MaterialPassDrawItem> drawItems){
    if(drawItems.empty())
        return;
    assert(!context.emulationOutputEntryStateGraphOwned);
    assert(context.frameBindings.meshView.buffer.valid());

    for(in MaterialPassDrawItem drawItem : drawItems){
        in MaterialPassMeshResourceSnapshot mesh = drawItem.meshResources;
        in MaterialPassPipelineResourceSnapshot pipelineResources = drawItem.pipelineResources;
        assert(this.materialPassDrawResourcesReady(mesh, context.frameBindings));
        assert(pipelineResources.computePipeline.valid());
        assert(pipelineResources.emulationPipeline.valid());
        assert(mesh.emulationVertexHeapHandle.valid());
        assert(mesh.emulationVertexBuffer.valid());

        this.setMaterialPassCommonBufferStates(context, mesh);
        context.commandList.setBufferState(mesh.emulationVertexBuffer.deref(), ResourceStates::UnorderedAccess);
        // Compute-emulation runs the same heap-backed mesh runtime before the generated vertex buffer reaches the ordinary graphics raster stage.
        this.dispatchComputeMaterialPassDrawItem(context, drawItem, mesh, pipelineResources);

        context.commandList.setBufferState(mesh.emulationVertexBuffer.deref(), s_ObjectGeometryRasterState);
        this.drawComputeMaterialPassDrawItem(context, drawItem, mesh, pipelineResources);
    }
}

b8 MaterialPassDrawRecorder::prepareIndexedMaterialPassResourceBindings(in Span<MaterialPassDrawItem> drawItems){
    for(in MaterialPassDrawItem draw : drawItems){
        in ObjectGeometryCacheSnapshot cache = draw.meshResources.objectGeometryCache;
        if(!draw.meshResources.valid() || !draw.pipelineResources.indexedPipeline.valid() || !cache.valid() || cache.decoderPipeline != draw.pipelineResources.objectGeometryDecodePipeline)
            return false;
    }
    return true;
}

void MaterialPassDrawRecorder::renderIndexedMaterialPassDrawItems(mut MaterialPassDrawContext context, in Span<MaterialPassDrawItem> drawItems){
    if(drawItems.empty())
        return;
    assert(context.materialGeometryStatesGraphOwned);
    assert(this.indexedMaterialPassDrawResourcesReady(drawItems, context.frameBindings));
    for(in MaterialPassDrawItem drawItem : drawItems){
        in MaterialPassMeshResourceSnapshot mesh = drawItem.meshResources;
        in ObjectGeometryCacheSnapshot cache = mesh.objectGeometryCache;
        in GraphicsPipelineHandle pipeline = drawItem.pipelineResources.indexedPipeline;
        this.setMaterialPassCommonBufferStates(context, mesh);
        GraphicsState state;
        state.setPipeline(pipeline.deref());
        state.setFramebuffer(context.framebuffer.deref());
        state.setViewport(context.viewportState);
        VertexBufferBinding vertexBinding;
        vertexBinding.setBuffer(cache.buffer.deref());
        vertexBinding.setSlot(s_MeshEmulationVertexBufferIndex);
        vertexBinding.setOffset(0u);
        state.addVertexBuffer(vertexBinding);
        IndexBufferBinding indexBinding;
        indexBinding.setBuffer(cache.buffer.deref());
        indexBinding.setFormat(Format::R32_UINT);
        indexBinding.setOffset(cache.indexByteOffset);
        state.setIndexBuffer(indexBinding);
        context.commandList.setGraphicsState(state);
        this.m_graphics.getDevice().getDescriptorHeap().bindGraphics(context.commandList, pipeline.deref());
        if(!this.setMaterialPassDrawPushConstants(context, drawItem, mesh))
            continue;
        DrawArguments arguments;
        arguments.setVertexCount(cache.indexCount);
        {
            GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeRaster, this.m_graphics.getDevice(), context.commandList);

            context.commandList.drawIndexed(arguments);
        }
    }
}

b8 MaterialPassDrawRecorder::prepareMaterialPassResourceBindingsImpl(in Span<MaterialPassDrawItem> drawItems, in b8 computeEmulation){
    if(drawItems.empty())
        return true;

    b8 ready = true;
    for(in MaterialPassDrawItem drawItem : drawItems){
        if(!ready)
            break;

        in MaterialPassMeshResourceSnapshot mesh = drawItem.meshResources;
        in MaterialPassPipelineResourceSnapshot pipelineResources = drawItem.pipelineResources;

        if(!computeEmulation){
            ready = pipelineResources.meshletPipeline.valid() && mesh.valid();
            continue;
        }

        ready = pipelineResources.computePipeline.valid()
            && pipelineResources.emulationPipeline.valid()
            && mesh.valid()
            && mesh.emulationVertexBuffer.valid()
            && mesh.emulationVertexHeapHandle.valid()
            && mesh.emulationVertexHeapHandle.descriptorClass() == GpuDescriptorClass::StorageBuffer
            && IsValidIndexedEmulationByteOffset(pipelineResources.indexedGeometryOutput, mesh.emulationIndexByteOffset)
        ;
    }
    return ready;
}


