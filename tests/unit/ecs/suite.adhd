using PublicationVelocityComponent = ::__hidden_publication_failure_tests::PublicationVelocityComponent;

extern thread_local b8 s_EcsCallerThread;

class CountingSystem final : public NWB::Core::ECS::ISystem{
public:
    explicit CountingSystem(NWB::Core::Alloc::GlobalArena& arena)
        : NWB::Core::ECS::ISystem(arena)
    {
        writeAccess<PositionComponent>();
    }


public:
    virtual void prepare(NWB::Core::ECS::World& world)noexcept override;
    [[nodiscard]] virtual Expected<void, NWB::Core::CpuTaskAdmissionError::Enum> update(NWB::Core::ECS::World& world, f32 delta)noexcept override;


public:
    u32 prepares = 0u;
    u32 updates = 0u;
    f32 lastDelta = 0.0f;
};

class ScheduledSystem final : public NWB::Core::ECS::ISystem{
public:
    ScheduledSystem(NWB::Core::Alloc::GlobalArena& arena, InitializerList<NWB::Core::ECS::ComponentAccess> accesses, Function<void()> update, NWB::Core::CpuTaskOptions options = {})
        : NWB::Core::ECS::ISystem(arena)
        , m_update(Move(update))
        , m_options(options)
    {
        for(const auto& access : accesses)
            registerAccess(access.typeId, access.mode);
    }


public:
    [[nodiscard]] virtual Expected<void, NWB::Core::CpuTaskAdmissionError::Enum> update(NWB::Core::ECS::World& world, f32 delta)override;
    [[nodiscard]] virtual NWB::Core::CpuTaskOptions taskOptions()const noexcept override{ return m_options; }


private:
    Function<void()> m_update;
    NWB::Core::CpuTaskOptions m_options;
};

class RejectingRangeSystem final : public NWB::Core::ECS::ISystem{
public:
    explicit RejectingRangeSystem(NWB::Core::Alloc::GlobalArena& arena)
        : NWB::Core::ECS::ISystem(arena)
    {
        writeAccess<PositionComponent>();
    }


public:
    [[nodiscard]] virtual Expected<void, NWB::Core::CpuTaskAdmissionError::Enum> update(NWB::Core::ECS::World& world, f32 delta)override;


public:
    u32 callbacks = 0u;
};

struct AddressTrapComponent{
public:
    mutable u32 addressCalls = 0u;


public:
    [[nodiscard]] AddressTrapComponent* operator&(){ ++addressCalls; throw 37u; }

    [[nodiscard]] const AddressTrapComponent* operator&()const{ ++addressCalls; throw 41u; }
};

struct alignas(32) OverAlignedComponent{
    Array<u8, 32> value{};
};

template<usize... Is>
inline Array<usize, sizeof...(Is)> RegisterPoolSlotTypes(IndexSequence<Is...>)noexcept{
    return { NWB::Core::ECS::ComponentType<PoolSlotComponent<Is>>()... };
}

struct MoveOnlyMessage{
    u32 value = 0u;


public:
    explicit MoveOnlyMessage(u32 v)noexcept
        : value(v)
    {}
    MoveOnlyMessage(const MoveOnlyMessage&) = delete;
    MoveOnlyMessage(MoveOnlyMessage&& rhs)noexcept
        : value(rhs.value)
    {
        rhs.value = 0u;
    }


public:
    MoveOnlyMessage& operator=(const MoveOnlyMessage&) = delete;

    MoveOnlyMessage& operator=(MoveOnlyMessage&& rhs)noexcept{
        if(this != &rhs){
            value = rhs.value;
            rhs.value = 0u;
        }
        return *this;
    }
};

struct ThrowingConstructionComponent{
    u32 value;


public:
    ThrowingConstructionComponent(b8 reject, u32 valueArg)
        : value(valueArg)
    {
        if(reject)
            throw 61u;
    }
};

struct ThrowingMoveAssignmentComponent{
    b8& rejectMove;
    u32 value;


public:
    ThrowingMoveAssignmentComponent(b8& rejectMoveArg, u32 valueArg)noexcept
        : rejectMove(rejectMoveArg)
        , value(valueArg)
    {}
    ThrowingMoveAssignmentComponent(const ThrowingMoveAssignmentComponent&) = delete;
    ThrowingMoveAssignmentComponent(ThrowingMoveAssignmentComponent&&)noexcept = default;


public:
    ThrowingMoveAssignmentComponent& operator=(const ThrowingMoveAssignmentComponent&) = delete;

    ThrowingMoveAssignmentComponent& operator=(ThrowingMoveAssignmentComponent&& rhs){
        if(rejectMove)
            throw 67u;
        value = rhs.value;
        return *this;
    }
};

struct ThrowingMoveMessage{
    b8& rejectMove;
    u32& moveAttempts;
    u32& destructions;


public:
    ThrowingMoveMessage(b8& rejectMoveArg, u32& moveAttemptsArg, u32& destructionsArg)noexcept
        : rejectMove(rejectMoveArg)
        , moveAttempts(moveAttemptsArg)
        , destructions(destructionsArg)
    {}
    ThrowingMoveMessage(const ThrowingMoveMessage&) = delete;
    ThrowingMoveMessage(ThrowingMoveMessage&& rhs)
        : rejectMove(rhs.rejectMove)
        , moveAttempts(rhs.moveAttempts)
        , destructions(rhs.destructions)
    {
        ++moveAttempts;
        if(rejectMove)
            throw 73u;
    }
    ~ThrowingMoveMessage()noexcept{ ++destructions; }


public:
    ThrowingMoveMessage& operator=(const ThrowingMoveMessage&) = delete;

    ThrowingMoveMessage& operator=(ThrowingMoveMessage&&) = delete;
};

template<b8 IsProvider>
class LifetimeSystem final : public NWB::Core::ECS::ISystem{
public:
    LifetimeSystem(NWB::Core::Alloc::GlobalArena& arena, SystemLifetimeState& state)noexcept
        : NWB::Core::ECS::ISystem(arena)
        , m_state(state)
    {
        if constexpr(IsProvider)
            m_state.providerAlive = true;
    }
    virtual ~LifetimeSystem()noexcept override{
        if constexpr(IsProvider)
            m_state.providerAlive = false;
        else
            m_state.borrowerObservedProvider = m_state.providerAlive;
        m_state.destructionOrder[m_state.destructionCount++] = IsProvider ? 1u : 2u;
    }


public:
    [[nodiscard]] virtual Expected<void, NWB::Core::CpuTaskAdmissionError::Enum> update([[maybe_unused]] NWB::Core::ECS::World& world, [[maybe_unused]] f32 delta)noexcept override{
        return {};
    }


private:
    SystemLifetimeState& m_state;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


