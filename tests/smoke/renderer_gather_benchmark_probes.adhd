#include <impl/ecs_render/module.adhd>
#include "scene_types.adhd"
#include "presentation_types.adhd"
#include "smoke_cpu_gpu_timing_probe.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type PerfSessionReport = SessionReport;
const usize s_CompilerStatisticsProbeCapacity = 1024;
const u32 s_GatherBenchmarkWarmupFrames = 96u;
const u32 s_GatherBenchmarkSampleFrames = 256u;
const u32 s_GatherBenchmarkDrainFrames = 32u;
const u32 s_GatherBenchmarkCpuScopeCount = 8u;
const u32 s_GatherBenchmarkGpuScopeCount = 18u;
const u32 s_GatherBenchmarkArenaScopeCount = 3u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererCompilerSample{
    public GpuTaskGraphCompileStatistics compile;
    public u64 sourceFrame = 0u;
    public u64 recordingAttempt = 0u;
    public usize acceptedPackets = 0u;
    public usize acceptedTasks = 0u;
    public usize rejectedPackets = 0u;
    public usize rejectedTasks = 0u;
    public b8 valid = false;
}

[arena]
class RendererCompilerStatisticsProbe : IRenderPass{
    private Vector<RendererCompilerSample> m_samples;
    private String m_output;
    private Optional<mut RendererSystem> m_renderer;
    private u64 m_attempts = 0u;
    private b8 m_enabled = false;
    private b8 m_registered = false;

    public RendererCompilerStatisticsProbe(mut GraphicsRuntime graphics){}
    public ~RendererCompilerStatisticsProbe(){ this.stop(); }

    public b8 start(in StringView path, mut RendererSystem renderer){
        if(this.m_enabled || path.empty())
            return false;
        this.m_output.assign(path);
        this.m_samples.reserve(s_CompilerStatisticsProbeCapacity);
        this.m_renderer = Optional<mut RendererSystem>(renderer);
        this.getGraphics().addRenderPassToBack(this);
        this.m_registered = true;
        this.m_enabled = true;
        return true;
    }

    public void stop(){
        if(this.m_registered){
            this.getGraphics().removeRenderPass(this);
            this.m_registered = false;
        }
        this.m_renderer.reset();
    }

    private StringView sampleStatus(in usize index)const{
        in RendererCompilerSample sample = this.m_samples[index];
        if(index != 0u && sample.sourceFrame <= this.m_samples[index - 1u].sourceFrame)
            return "non_monotonic_frame";
        if(!sample.valid)
            return "invalid_snapshot";
        for(usize previous = 0u; previous < index; ++previous){
            in RendererCompilerSample prior = this.m_samples[previous];
            if(prior.valid && prior.compile.graphGeneration == sample.compile.graphGeneration
                && prior.compile.planGeneration == sample.compile.planGeneration && prior.compile.deviceGeneration == sample.compile.deviceGeneration)
                return "duplicate_plan";
        }
        const Array<f64, 12u> durations = CompileDurations(sample.compile);
        for(usize i = 0u; i < durations.size(); ++i){
            if(!IsFinite(VectorDouble(durations[i])) || durations[i] < 0.0)
                return "invalid_duration";
        }
        return "valid";
    }

    public b8 write()const{
        if(!this.m_enabled)
            return true;
        if(this.m_registered)
            return false;
        String output;
        StringAppendFormat(output, "{{\"type\":\"compiler_statistics_configuration\",\"schema\":1,\"capacity\":{}}}\n", s_CompilerStatisticsProbeCapacity);
        usize invalid = 0u;
        for(usize index = 0u; index < this.m_samples.size(); ++index){
            in RendererCompilerSample sample = this.m_samples[index];
            const StringView status = this.sampleStatus(index);
            StringAppendFormat(output, "{{\"type\":\"compiler_statistics\",\"sequence\":{},\"source_frame\":{},\"status\":\"{}\"", index, sample.sourceFrame, status);
            if(status == "valid"){
                in GpuTaskGraphCompileStatistics stats = sample.compile;
                StringAppendFormat(output, ",\"identity\":{{\"graph_generation\":{},\"plan_generation\":{},\"device_generation\":{},\"recording_attempt_generation\":{}}},\"seconds\":{{",
                    stats.graphGeneration, stats.planGeneration, stats.deviceGeneration, sample.recordingAttempt);
                StringAppendFormat(output, "\"declaration\":{:.17g},\"analysis\":{:.17g},\"validation\":{:.17g}", stats.declarationSeconds, stats.analysisSeconds, stats.validationSeconds);
                StringAppendFormat(output, ",\"dependency_analysis\":{:.17g},\"hazard_analysis\":{:.17g},\"topological_order\":{:.17g}", stats.dependencyAnalysisSeconds, stats.hazardAnalysisSeconds, stats.topologicalOrderSeconds);
                StringAppendFormat(output, ",\"queue_assignment\":{:.17g},\"planning\":{:.17g},\"total\":{:.17g}", stats.queueAssignmentSeconds, stats.planningSeconds, stats.totalSeconds);
                StringAppendFormat(output, ",\"packetization\":{:.17g},\"resource_state_planning\":{:.17g},\"packet_dependency_planning\":{:.17g}", stats.packetizationSeconds, stats.resourceStatePlanningSeconds, stats.packetDependencyPlanningSeconds);
                output.append("},\"counts\":{");
                StringAppendFormat(output, "\"task\":{},\"resource\":{},\"resource_use\":{}", stats.taskCount, stats.resourceCount, stats.resourceUseCount);
                StringAppendFormat(output, ",\"resource_version\":{},\"resource_version_edge\":{},\"explicit_dependency\":{}", stats.resourceVersionCount, stats.resourceVersionEdgeCount, stats.explicitDependencyCount);
                StringAppendFormat(output, ",\"inferred_dependency\":{},\"external_dependency\":{},\"packet\":{}", stats.inferredDependencyCount, stats.externalDependencyCount, stats.packetCount);
                StringAppendFormat(output, ",\"packet_dependency\":{},\"packet_external_dependency\":{},\"cross_queue_packet_dependency\":{}", stats.packetDependencyCount, stats.packetExternalDependencyCount, stats.crossQueuePacketDependencyCount);
                StringAppendFormat(output, ",\"prologue_state_seed\":{},\"prologue_barrier\":{},\"epilogue_barrier\":{}", stats.prologueStateSeedCount, stats.prologueBarrierCount, stats.epilogueBarrierCount);
                StringAppendFormat(output, ",\"state_export_barrier\":{},\"resource_set\":{},\"direct_resource_use\":{}", stats.stateExportBarrierCount, stats.resourceSetCount, stats.directResourceUseCount);
                StringAppendFormat(output, ",\"expanded_resource_set_member_use\":{}", stats.expandedResourceSetMemberUseCount);
                StringAppendFormat(output, "}},\"submission\":{{\"accepted_packets\":{},\"accepted_tasks\":{},\"rejected_packets\":{},\"rejected_tasks\":{}}}",
                    sample.acceptedPackets, sample.acceptedTasks, sample.rejectedPackets, sample.rejectedTasks);
            }
            else{
                ++invalid;
            }
            output.append("}\n");
        }
        const u64 overflow = this.m_attempts - this.m_samples.size();
        const b8 complete = !this.m_samples.empty() && overflow == 0u;
        StringAppendFormat(output, "{{\"type\":\"compiler_statistics_complete\",\"attempts\":{},\"stored\":{},\"overflow\":{},\"invalid\":{},\"complete\":{}}}\n",
            this.m_attempts, this.m_samples.size(), overflow, invalid, complete);
        return WritePlatformTextFile(Path(this.m_output), output, false) == FileWriteStatus::Success && complete;
    }

    public b8 shouldRenderUnfocused()override{ return true; }

    public void render(in FramebufferPtr framebuffer)override{
        if(!this.m_renderer.has_value())
            return;
        ++this.m_attempts;
        if(this.m_samples.size() == s_CompilerStatisticsProbeCapacity)
            return;
        RendererCompilerSample sample;
        sample.sourceFrame = this.getGraphics().getFrameIndex();
        const auto statistics = this.m_renderer.value().deferredTaskGraphRuntimeStatistics();
        sample.valid = statistics.valid() && statistics.compile.deviceGeneration != 0u;
        if(sample.valid){
            sample.compile = statistics.compile;
            sample.recordingAttempt = statistics.recording.recordingAttemptGeneration;
            sample.acceptedPackets = statistics.submission.acceptedPacketCount;
            sample.acceptedTasks = statistics.submission.acceptedTaskCount;
            sample.rejectedPackets = statistics.submission.rejectedPacketCount;
            sample.rejectedTasks = statistics.submission.rejectedTaskCount;
        }
        this.m_samples.push_back(sample);
    }
}

class RendererGatherCpuSample{
    public Array<MemorySnapshot, s_GatherBenchmarkArenaScopeCount> memory;
    public Array<f64, s_GatherBenchmarkCpuScopeCount> milliseconds;
    public u64 sourceFrame = 0u;
    public u64 publishFrame = 0u;
}

class RendererGatherGpuSample{
    public RendererGatherGpuSample(){
        this.timing = TimingStats();
        this.scope = 0u;
    }

    public RendererGatherGpuSample(in TimingStats stats, in u32 scopeIndex){
        this.timing = stats;
        this.scope = scopeIndex;
    }

    public TimingStats timing;
    public u32 scope;
}

class RendererGatherBenchmarkProbe{
    public RendererGatherBenchmarkProbe(){
        this.m_cpu.reserve(s_GatherBenchmarkSampleFrames);
        this.m_gpu.reserve((s_GatherBenchmarkWarmupFrames + s_GatherBenchmarkSampleFrames + s_GatherBenchmarkDrainFrames) * s_GatherBenchmarkGpuScopeCount);
    }

    public b8 poll(in PerfSessionReport report, in b8 memoryEnabled){
        const Expected<Name, NameTextError> frameScopeName = NameFromText(GatherBenchmarkCpuScopeName(0u));
        if(!frameScopeName.has_value())
            return false;
        const TimingStats frame = report.cpuTiming.stats(frameScopeName.value());
        if(!frame.valid() || (this.m_hasPublication && frame.publishFrameIndex == this.m_lastPublish))
            return true;
        if((this.m_hasPublication && frame.publishFrameIndex < this.m_lastPublish) || frame.sampleCount != 1u || frame.firstSampleFrameIndex != frame.lastSampleFrameIndex)
            return false;

        const TimingStats failedPreparation = report.cpuTiming.stats(s_PresentationTimingNamePrepareResourcesFailed);
        if(failedPreparation.valid() && failedPreparation.publishFrameIndex == frame.publishFrameIndex)
            return false;

        const TimingStats preamble = report.cpuTiming.stats(s_PresentationTimingNameFramePreamble);
        if((!preamble.valid() || preamble.publishFrameIndex != frame.publishFrameIndex) && this.m_successfulFrames == 0u)
            return true;

        const u64 publishFrame = frame.publishFrameIndex;
        const u64 sourceFrame = frame.firstSampleFrameIndex;

        RendererGatherCpuSample sample = RendererGatherCpuSample();
        sample.sourceFrame = sourceFrame;
        sample.publishFrame = publishFrame;
        for(u32 scope = 0u; scope < s_GatherBenchmarkCpuScopeCount; ++scope){
            const Expected<Name, NameTextError> scopeName = NameFromText(GatherBenchmarkCpuScopeName(scope));
            if(!scopeName.has_value())
                return false;
            const TimingStats timing = report.cpuTiming.stats(scopeName.value());
            if(
                !timing.valid()
                || timing.sampleCount != 1u
                || timing.publishFrameIndex != publishFrame
                || timing.firstSampleFrameIndex != sourceFrame
                || timing.lastSampleFrameIndex != sourceFrame
            )
                return false;
            sample.milliseconds[scope] = timing.seconds;
        }

        u32 cpuScope = 0u;
        while(cpuScope + 1u < s_GatherBenchmarkCpuScopeCount){
            const VectorDouble ms = VectorDouble(sample.milliseconds[cpuScope], sample.milliseconds[cpuScope + 1u], 0.0, 0.0) * s_PresentationPacingMsPerSecond;
            sample.milliseconds[cpuScope] = ms.x;
            sample.milliseconds[cpuScope + 1u] = ms.y;
            cpuScope += 2u;
        }
        if(cpuScope < s_GatherBenchmarkCpuScopeCount)
            sample.milliseconds[cpuScope] = sample.milliseconds[cpuScope] * s_PresentationPacingMsPerSecond;

        if(memoryEnabled){
            for(u32 arenaIndex = 0u; arenaIndex < s_GatherBenchmarkArenaScopeCount; ++arenaIndex){
                const Expected<Name, NameTextError> arenaName = NameFromText(GatherBenchmarkArenaScopeName(arenaIndex));
                if(!arenaName.has_value())
                    return false;
                const MemorySnapshot current = report.memory.snapshot(arenaName.value(), MemorySource::Arena);
                if(current.valid() && current.frameIndex != publishFrame)
                    return false;
                sample.memory[arenaIndex] = current;
            }
        }

        for(u32 gpuScope = 0u; gpuScope < s_GatherBenchmarkGpuScopeCount; ++gpuScope){
            const Expected<Name, NameTextError> gpuScopeName = NameFromText(GatherBenchmarkGpuScopeName(gpuScope));
            if(!gpuScopeName.has_value())
                return false;
            const b8 hadPub = this.m_hasGpuPublication[gpuScope];
            const u64 prevPub = this.m_gpuPublish[gpuScope];
            const TimingStats gpuTiming = report.gpuTiming.stats(gpuScopeName.value());
            if(gpuTiming.valid() && (!hadPub || gpuTiming.publishFrameIndex != prevPub)){
                if(hadPub && gpuTiming.publishFrameIndex < prevPub)
                    return false;
                this.m_hasGpuPublication[gpuScope] = true;
                this.m_gpuPublish[gpuScope] = gpuTiming.publishFrameIndex;
                this.m_gpu.push_back(RendererGatherGpuSample(gpuTiming, gpuScope));
            }
        }

        this.m_lastPublish = publishFrame;
        this.m_hasPublication = true;
        ++this.m_successfulFrames;
        if(this.m_successfulFrames == s_GatherBenchmarkWarmupFrames)
            this.m_memoryBaseline = sample.memory;
        if(this.m_successfulFrames > s_GatherBenchmarkWarmupFrames && this.m_cpu.size() < s_GatherBenchmarkSampleFrames)
            this.m_cpu.push_back(sample);
        return true;
    }

    public b8 finished()const{
        return this.m_successfulFrames >= s_GatherBenchmarkWarmupFrames + s_GatherBenchmarkSampleFrames + s_GatherBenchmarkDrainFrames;
    }

    public u32 successfulFrames()const{
        return this.m_successfulFrames;
    }

    public b8 write(
        in StringView path,
        in StringView workload,
        in b8 memoryEnabled,
        in u32 renderers,
        in u32 runtimeRenderers,
        in u32 transparentRenderers,
        in u32 runtimeOwners
    )const{
        const b8 complete = this.finished() && this.m_cpu.size() == s_GatherBenchmarkSampleFrames;
        StringView modeText = "timing";
        if(memoryEnabled)
            modeText = "memory";
        String out = String();
        out.reserve(65536u);
        StringAppendFormat(
            out,
            "{{\"type\":\"configuration\",\"schema\":2,\"workload\":\"{}\",\"mode\":\"{}\",\"width\":960,\"height\":720,\"warmup\":{},\"samples\":{},\"drain\":{},\"successful_frames\":{},\"renderers\":{},\"runtime_renderers\":{},\"transparent_renderers\":{},\"runtime_owners\":{},\"reflection_mode\":\"hardware\",\"hardware_budget\":4096,\"optical_queries\":16,\"temporal\":false,\"spatial\":false,\"feedback\":false,\"diagnostics\":false,\"fixed_delta_seconds\":0.016666667,\"sampling_seed\":0,\"refraction\":true}}\n",
            workload,
            modeText,
            s_GatherBenchmarkWarmupFrames,
            s_GatherBenchmarkSampleFrames,
            s_GatherBenchmarkDrainFrames,
            this.m_successfulFrames,
            renderers,
            runtimeRenderers,
            transparentRenderers,
            runtimeOwners
        );
        if(memoryEnabled){
            out.append("{\"type\":\"memory_baseline\",\"arenas\":");
            AppendGatherBenchmarkMemory(Span<MemorySnapshot>(this.m_memoryBaseline), out);
            out.append("}\n");
        }
        for(in RendererGatherCpuSample sample : this.m_cpu){
            StringAppendFormat(out, "{{\"type\":\"cpu\",\"source_frame\":{},\"publish_frame\":{},\"scopes_ms\":{{", sample.sourceFrame, sample.publishFrame);
            for(u32 scope = 0u; scope < s_GatherBenchmarkCpuScopeCount; ++scope){
                if(scope != 0u)
                    out.push_back(',');
                StringAppendFormat(out, "\"{}\":{:.9f}", GatherBenchmarkCpuScopeName(scope), sample.milliseconds[scope]);
            }
            out.push_back('}');
            if(memoryEnabled){
                out.append(",\"arenas\":");
                AppendGatherBenchmarkMemory(Span<MemorySnapshot>(sample.memory), out);
            }
            out.append("}\n");
        }
        for(usize index = 0u; index < this.m_gpu.size(); index += 2u){
            const usize count = Min(cast<usize>(2u), this.m_gpu.size() - index);
            f64 secondSeconds = 0.0;
            if(count > 1u)
                secondSeconds = this.m_gpu[index + 1u].timing.seconds;
            const VectorDouble milliseconds = VectorDouble(this.m_gpu[index].timing.seconds, secondSeconds, 0.0, 0.0) * s_PresentationPacingMsPerSecond;
            for(usize lane = 0u; lane < count; ++lane){
                const RendererGatherGpuSample sample = this.m_gpu[index + lane];
                f64 totalMs = milliseconds.x;
                if(lane != 0u)
                    totalMs = milliseconds.y;
                StringAppendFormat(
                    out,
                    "{{\"type\":\"gpu\",\"scope\":\"{}\",\"publish_frame\":{},\"first_source_frame\":{},\"last_source_frame\":{},\"total_ms\":{:.9f},\"samples\":{}}}\n",
                    GatherBenchmarkGpuScopeName(sample.scope),
                    sample.timing.publishFrameIndex,
                    sample.timing.firstSampleFrameIndex,
                    sample.timing.lastSampleFrameIndex,
                    totalMs,
                    sample.timing.sampleCount
                );
            }
        }
        if(complete)
            out.append("{\"type\":\"complete\"}\n");
        const Expected<b8> written = WriteTextFile(Path(path), out);
        return written.has_value() && written.value() && complete;
    }

    private Array<MemorySnapshot, s_GatherBenchmarkArenaScopeCount> m_memoryBaseline;
    private Array<u64, s_GatherBenchmarkGpuScopeCount> m_gpuPublish;
    private Vector<RendererGatherCpuSample> m_cpu;
    private Vector<RendererGatherGpuSample> m_gpu;
    private Array<b8, s_GatherBenchmarkGpuScopeCount> m_hasGpuPublication;
    private u64 m_lastPublish = 0u;
    private u32 m_successfulFrames = 0u;
    private b8 m_hasPublication = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Array<f64, 12u> CompileDurations(in GpuTaskGraphCompileStatistics stats){
    return Array<f64, 12u>(
        stats.declarationSeconds,
        stats.analysisSeconds,
        stats.validationSeconds,
        stats.dependencyAnalysisSeconds,
        stats.hazardAnalysisSeconds,
        stats.topologicalOrderSeconds,
        stats.queueAssignmentSeconds,
        stats.planningSeconds,
        stats.totalSeconds,
        stats.packetizationSeconds,
        stats.resourceStatePlanningSeconds,
        stats.packetDependencyPlanningSeconds
    );
}

StringView GatherBenchmarkCpuScopeName(in u32 scope){
    switch(scope){
    case 0u: return "graphics.frame";
    case 1u: return "graphics.frame_preamble";
    case 2u: return "graphics.prepare_resources";
    case 3u: return "graphics.render_passes";
    case 4u: return "graphics.render";
    case 5u: return "frame.project_update";
    case 6u: return "graphics.present";
    }
    return "graphics.begin_frame";
}

StringView GatherBenchmarkGpuScopeName(in u32 scope){
    switch(scope){
    case 0u: return "render.frame";
    case 1u: return "render.opaque_regular";
    case 2u: return "render.shadow_visibility";
    case 3u: return "render.deferred_lighting";
    case 4u: return "render.deferred_composite";
    case 5u: return "render.deferred_present";
    case 6u: return "render.avboit_clear";
    case 7u: return "render.avboit_occupancy";
    case 8u: return "render.avboit_depth_warp";
    case 9u: return "render.avboit_extinction";
    case 10u: return "render.avboit_integration";
    case 11u: return "render.avboit_accumulate";
    case 12u: return "render.reflection_classify";
    case 13u: return "render.reflection_build_args";
    case 14u: return "render.reflection_hardware";
    case 15u: return "render.reflection_depth_pyramid";
    case 16u: return "render.reflection_temporal";
    }
    return "render.reflection_spatial";
}

StringView GatherBenchmarkArenaScopeName(in u32 scope){
    switch(scope){
    case 0u: return "impl/ecs_render/prepare";
    case 1u: return "impl/ecs_render/render";
    }
    return "impl/ecs_render/task_graph";
}

void AppendGatherBenchmarkMemory(in Span<MemorySnapshot> snapshots, mut String out){
    out.push_back('{');
    for(u32 scope = 0u; scope < s_GatherBenchmarkArenaScopeCount; ++scope){
        if(scope != 0u)
            out.push_back(',');
        const MemorySnapshot snapshot = snapshots[scope];
        StringView presentText = "false";
        if(snapshot.valid())
            presentText = "true";
        StringAppendFormat(
            out,
            "\"{}\":{{\"present\":{},\"frame\":{},\"reserved\":{},\"used\":{},\"historical_arena_peak\":{},\"allocations\":{},\"reallocations\":{},\"deallocations\":{}}}",
            GatherBenchmarkArenaScopeName(scope),
            presentText,
            snapshot.frameIndex,
            snapshot.reservedBytes,
            snapshot.usedBytes,
            snapshot.peakUsedBytes,
            snapshot.allocationCount,
            snapshot.reallocationCount,
            snapshot.deallocationCount
        );
    }
    out.push_back('}');
}


