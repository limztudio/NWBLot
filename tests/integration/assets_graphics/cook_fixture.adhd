b8 MeshAssetHasPositionNormal(in Mesh mesh, in usize meshletIndex, in f32 posX, in f32 posY, in f32 posZ, in f32 normX, in f32 normY, in f32 normZ, in f32 normW){
    const MeshletDesc meshlet = mesh.meshlets()[meshletIndex];
    for(u32 i = 0u; i < MeshletVertexCount(meshlet); ++i){
        const MeshletLocalVertexRef local = mesh.meshletLocalVertexRefs()[meshlet.localVertexOffset + i];
        const auto positionRef = TryDecodeMeshletPositionRef(mesh.meshletPositionRefDeltas(), meshlet, local.localDeformedPosition, false);
        const auto attributeRef = TryDecodeMeshletAttributeRef(mesh.meshletAttributeRefDeltas(), meshlet, local.localAttribute);
        if(!positionRef.has_value() || !attributeRef.has_value())
            return false;
        const f32x3u position = mesh.positionStream()[positionRef.value().position];
        const f32x4u normal = LoadHalf4U(mesh.normalStream()[attributeRef.value().normal]);
        if(position.x == posX && position.y == posY && position.z == posZ && normal.x == normX && normal.y == normY && normal.z == normZ && normal.w == normW)
            return true;
    }
    return false;
}

