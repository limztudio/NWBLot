class PaintSlotFixture{
    public EcsTestWorld ecs;
    public FakeClipboard clipboard;
    public FakeTextInput textInput;
    public FakeCursor cursor;
    public FakeAccessibility accessibility;
    public Context uiContext;
    public PaintBuilder paint;
    public TextService text;
    public DisplayMetrics display;
    public Builder builder;
    public UiPaintContext context;

    public PaintSlotFixture(){
        this.clipboard = FakeClipboard(this.ecs.arena);
        this.textInput = FakeTextInput(this.ecs.arena);
        this.cursor = FakeCursor(this.ecs.arena);
        this.accessibility = FakeAccessibility(this.ecs.arena);
        this.builder = Builder(this.uiContext, this.paint, this.text);
        this.context = UiPaintContext(this.ecs.world, this.clipboard, this.textInput, this.cursor, this.accessibility, this.paint, this.text, this.display, this.builder);
    }
}

[arena, system("ui_unwind_probe")]
class UiUnwindProbeSystem{
    public b8 failUpdate;
    public u32 updates = 0u;

    public UiUnwindProbeSystem(in b8 failUpdate){
        this.failUpdate = failUpdate;
        this.writeAccess<UiPaintComponent>();
    }

    public CpuTaskOptions taskOptions()const override{
        CpuTaskOptions options = CpuTaskOptions();
        options.target = CpuTaskTarget::MainThread;
        return options;
    }

    [cpp_unwind] public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta)override{
        ++this.updates;
        if(this.failUpdate){
            TriggerProbeOom();
        }
        return Expected<void, CpuTaskAdmissionError>();
    }
}

[arena, system("ui_unwind_dependent")]
class UiUnwindDependentSystem{
    public u32 updates = 0u;

    public UiUnwindDependentSystem(){
        this.writeAccess<UiPaintComponent>();
    }

    public CpuTaskOptions taskOptions()const override{
        CpuTaskOptions options = CpuTaskOptions();
        options.target = CpuTaskTarget::MainThread;
        return options;
    }

    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta)override{
        ++this.updates;
        return Expected<void, CpuTaskAdmissionError>();
    }
}


UiTextEditOwner MakeSessionTestOwner(in u64 widget, in u64 declaration, in u64 model){
    UiTextEditOwner owner();
    owner.widget.value = widget;
    owner.declarationGeneration = declaration;
    owner.modelGeneration = model;
    return owner;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


UiTextEditOwner MakeSelectionDeletionOwner(in u64 modelGeneration){
    UiTextEditOwner owner = UiTextEditOwner();
    owner.widget.value = 371u;
    owner.declarationGeneration = 3u;
    owner.modelGeneration = modelGeneration;
    return owner;
}

UiTextEditOwner MakeReplacedSessionOwner(in u64 modelGeneration){
    UiTextEditOwner owner = UiTextEditOwner();
    owner.widget = MakeSessionTestOwner(17u, 1u, 1u).widget;
    owner.declarationGeneration = MakeSessionTestOwner(17u, 1u, 1u).declarationGeneration;
    owner.modelGeneration = modelGeneration;
    return owner;
}


[cpp_unwind]
void VerifyPaintSlot_ClearAndRemoveReaddDoNotRestoreTheRunningCallback(){
    PaintSlotFixture fixture = PaintSlotFixture();
    auto entity = fixture.ecs.world.createEntity();
    const auto id = entity.id();
    UiPaintCallback clearComponent = lambda[in id](mut UiPaintContext ctx) -> void{
        ctx.world.entity(id).getComponent<UiPaintComponent>().paint.reset();
    };
    entity.addComponent<UiPaintComponent>().paint.setCallback(clearComponent);
    entity.getComponent<UiPaintComponent>().paint.invoke(fixture.context);
    EXPECT_FALSE(entity.getComponent<UiPaintComponent>().paint.callable());

    UiPaintCallback replaceComponent = lambda[in id](mut UiPaintContext ctx) -> void{
        auto current = ctx.world.entity(id);
        current.removeComponent<UiPaintComponent>();
        current.addComponent<UiPaintComponent>();
    };
    entity.getComponent<UiPaintComponent>().paint.setCallback(replaceComponent);
    entity.getComponent<UiPaintComponent>().paint.invoke(fixture.context);
    EXPECT_FALSE(entity.getComponent<UiPaintComponent>().paint.callable());

    UiPaintCallback replaceAndThrow = lambda[in id](mut UiPaintContext ctx) -> void{
        auto current = ctx.world.entity(id);
        current.removeComponent<UiPaintComponent>();
        current.addComponent<UiPaintComponent>();
        ThrowTestException<i32>(42);
    };
    entity.getComponent<UiPaintComponent>().paint.setCallback(replaceAndThrow);
    EXPECT_TRUE(ThrowsException<i32>(lambda[mut entity, mut fixture]() -> void{ entity.getComponent<UiPaintComponent>().paint.invoke(fixture.context); }));
    EXPECT_FALSE(entity.getComponent<UiPaintComponent>().paint.callable());
}

void VerifyPaintSlot_ReplacementAndRelocationKeepTheCurrentOwner(){
    PaintSlotFixture fixture = PaintSlotFixture();
    auto first = fixture.ecs.world.createEntity();
    first.addComponent<UiPaintComponent>();
    auto second = fixture.ecs.world.createEntity();
    const EntityID firstId = first.id();
    const EntityID secondId = second.id();
    i32 observed = 0;
    UiPaintCallback removeFirst = lambda[in firstId, mut observed](mut UiPaintContext ctx) -> void{
        ++observed;
        if(observed == 1){
            ctx.world.entity(firstId).removeComponent<UiPaintComponent>();
        }
    };
    second.addComponent<UiPaintComponent>().paint.setCallback(removeFirst);
    second.getComponent<UiPaintComponent>().paint.invoke(fixture.context);
    fixture.ecs.world.entity(secondId).getComponent<UiPaintComponent>().paint.invoke(fixture.context);
    EXPECT_EQ(observed, 2);

    UiPaintCallback replaceCallback = lambda[in secondId, mut observed](mut UiPaintContext ctx) -> void{
        UiPaintCallback observeReplacement = lambda[mut observed](mut UiPaintContext unused) -> void{
            observed = 17;
        };
        ctx.world.entity(secondId).getComponent<UiPaintComponent>().paint.setCallback(observeReplacement);
    };
    fixture.ecs.world.entity(secondId).getComponent<UiPaintComponent>().paint.setCallback(replaceCallback);
    fixture.ecs.world.entity(secondId).getComponent<UiPaintComponent>().paint.invoke(fixture.context);
    fixture.ecs.world.entity(secondId).getComponent<UiPaintComponent>().paint.invoke(fixture.context);
    EXPECT_EQ(observed, 17);
}

void VerifyPaintSlot_VectorGrowthAndExplicitMovePreserveMutableCaptures(){
    PaintSlotFixture fixture = PaintSlotFixture();
    auto entity = fixture.ecs.world.createEntity();
    const EntityID id = entity.id();
    i32 observed = 0;
    UiPaintCallback growStorage = lambda[mut observed](mut UiPaintContext ctx) -> void{
        ++observed;
        if(observed == 1){
            for(u32 i = 0u; i < 128u; ++i){
                ctx.world.createEntity().addComponent<UiPaintComponent>();
            }
        }
    };
    entity.addComponent<UiPaintComponent>().paint.setCallback(growStorage);
    entity.getComponent<UiPaintComponent>().paint.invoke(fixture.context);
    fixture.ecs.world.entity(id).getComponent<UiPaintComponent>().paint.invoke(fixture.context);
    EXPECT_EQ(observed, 2);

    observed = 0;
    UiPaintSlot first = UiPaintSlot();
    UiPaintSlot second = UiPaintSlot();
    UiPaintCallback moveSlot = lambda[mut first, mut second, mut observed](mut UiPaintContext unused) -> void{
        ++observed;
        if(observed == 1)
            TestMoveAssign<UiPaintSlot>(second, first);
    };
    first.setCallback(moveSlot);
    first.invoke(fixture.context);
    EXPECT_FALSE(first.callable());
    ASSERT_TRUE(second.callable());
    second.invoke(fixture.context);
    EXPECT_EQ(observed, 2);
}

[cpp_unwind]
void VerifyPaintSlot_ExceptionRestoresCallbackWhenItStillHasAnOwner(){
    PaintSlotFixture fixture = PaintSlotFixture();
    UiPaintSlot slot = UiPaintSlot();
    i32 calls = 0;
    UiPaintCallback throwOnCall = lambda[mut calls](mut UiPaintContext unused) -> void{ ++calls; ThrowTestException<i32>(42); };
    slot.setCallback(throwOnCall);
    EXPECT_TRUE(ThrowsException<i32>(lambda[mut slot, mut fixture]() -> void{ slot.invoke(fixture.context); }));
    ASSERT_TRUE(slot.callable());
    EXPECT_TRUE(ThrowsException<i32>(lambda[mut slot, mut fixture]() -> void{ slot.invoke(fixture.context); }));
    EXPECT_EQ(calls, 2);
}

[cpp_unwind]
void VerifyPaintSlot_NestedReplacementAndExceptionDoNotRestoreTheDisplacedCallback(){
    PaintSlotFixture fixture = PaintSlotFixture();
    UiPaintSlot slot = UiPaintSlot();
    i32 calls = 0;
    UiPaintCallback replaceAndThrow = lambda[mut slot, mut calls](mut UiPaintContext ctx) -> void{
        UiPaintCallback incrementCalls = lambda[mut calls](mut UiPaintContext unused) -> void{ ++calls; };
        slot.setCallback(incrementCalls);
        slot.invoke(ctx);
        ThrowTestException<i32>(42);
    };
    slot.setCallback(replaceAndThrow);
    EXPECT_TRUE(ThrowsException<i32>(lambda[mut slot, mut fixture]() -> void{ slot.invoke(fixture.context); }));
    ASSERT_TRUE(slot.callable());
    slot.invoke(fixture.context);
    EXPECT_EQ(calls, 2);

    UiPaintCallback clearAndThrow = lambda[mut slot](mut UiPaintContext unused) -> void{ slot.reset(); ThrowTestException<i32>(42); };
    slot.setCallback(clearAndThrow);
    EXPECT_TRUE(ThrowsException<i32>(lambda[mut slot, mut fixture]() -> void{ slot.invoke(fixture.context); }));
    EXPECT_FALSE(slot.callable());
}

void VerifyPaintSlot_RunningCallbackRemainsVisibleUntilCleared(){
    PaintSlotFixture fixture = PaintSlotFixture();
    UiPaintSlot slot = UiPaintSlot();
    b8 visibleDuringCall = false;
    b8 visibleAfterClear = true;
    b8 callableDuringCall = true;
    UiPaintCallback checkVisibility = lambda[mut slot, mut visibleDuringCall, mut visibleAfterClear, mut callableDuringCall](mut UiPaintContext ctx) -> void{
        visibleDuringCall = slot.present();
        callableDuringCall = slot.callable();
        if(slot.callable()){
            slot.invoke(ctx);
        }
        slot.reset();
        visibleAfterClear = slot.present();
    };
    slot.setCallback(checkVisibility);
    slot.invoke(fixture.context);
    EXPECT_TRUE(visibleDuringCall);
    EXPECT_FALSE(callableDuringCall);
    EXPECT_FALSE(visibleAfterClear);
    EXPECT_FALSE(slot.callable());
}

void VerifyPaintSlot_MoveConstructionTransfersTheActiveLease(){
    PaintSlotFixture fixture = PaintSlotFixture();
    UiPaintSlot first = UiPaintSlot();
    TestValueSlot<UiPaintSlot> second();
    Optional<mut UiPaintSlot> moved();
    i32 calls = 0;
    UiPaintCallback moveConstructSlot = lambda[mut first, mut second, mut moved, mut calls](mut UiPaintContext unused) -> void{
        ++calls;
        if(calls == 1)
            moved = Optional<mut UiPaintSlot>(second.take(first));
    };
    first.setCallback(moveConstructSlot);
    first.invoke(fixture.context);
    EXPECT_FALSE(first.callable());
    ASSERT_TRUE(moved.has_value());
    ASSERT_TRUE(moved.value().callable());
    moved.value().invoke(fixture.context);
    EXPECT_EQ(calls, 2);
}

void VerifyUiSkinSelectionTests_FailedCustomFallsBackToDefaultAndRevalidatesOnlyDefault(){
    u32 customCalls = 0u;
    u32 defaultCalls = 0u;
    UiSkinSelectionState selection = MakeUiSkinSelectionState(s_MissingUiSkinRef);
    auto bind = lambda[mut customCalls, mut defaultCalls](in AssetRef<UiSkin> ref) -> b8{
        if(ref == s_MissingUiSkinRef){
            ++customCalls;
            return false;
        }
        EXPECT_EQ(ref, s_DefaultUiSkinRef);
        ++defaultCalls;
        return true;
    };
    EXPECT_EQ(EnsureUiSkinSelection(selection, s_DefaultUiSkinRef, bind), UiSkinSelectionResult::DefaultFallback);
    EXPECT_EQ(selection.selected, s_DefaultUiSkinRef);
    EXPECT_EQ(EnsureUiSkinSelection(selection, s_DefaultUiSkinRef, bind), UiSkinSelectionResult::Selected);
    EXPECT_EQ(customCalls, 1u);
    EXPECT_EQ(defaultCalls, 2u);
}

void VerifyUiSkinSelectionTests_FailedDefaultLeavesSelectionUncommittedForRetry(){
    u32 calls = 0u;
    UiSkinSelectionState selection = MakeUiSkinSelectionState(s_MissingUiSkinRef);
    auto reject = lambda[mut calls](in AssetRef<UiSkin> unused) -> b8{
        ++calls;
        return false;
    };
    EXPECT_EQ(EnsureUiSkinSelection(selection, s_DefaultUiSkinRef, reject), UiSkinSelectionResult::Failed);
    EXPECT_FALSE(selection.selected.valid());
    EXPECT_EQ(calls, 2u);
    auto acceptCustom = lambda[](in AssetRef<UiSkin> ref) -> b8{
        return ref == s_MissingUiSkinRef;
    };
    EXPECT_EQ(EnsureUiSkinSelection(selection, s_DefaultUiSkinRef, acceptCustom), UiSkinSelectionResult::Selected);
    EXPECT_EQ(selection.selected, s_MissingUiSkinRef);
    EXPECT_EQ(calls, 2u);
}

void VerifyUiSkinSelectionTests_FailedRevalidationPreservesPreviouslySelectedCustom(){
    u32 calls = 0u;
    UiSkinSelectionState selection = MakeUiSkinSelectionState(s_CustomUiSkinRef);
    auto acceptCustom = lambda[](in AssetRef<UiSkin> ref) -> b8{
        return ref == s_CustomUiSkinRef;
    };
    EXPECT_EQ(EnsureUiSkinSelection(selection, s_DefaultUiSkinRef, acceptCustom), UiSkinSelectionResult::Selected);
    auto rejectRevalidation = lambda[mut calls](in AssetRef<UiSkin> ref) -> b8{
        ++calls;
        EXPECT_EQ(ref, s_CustomUiSkinRef);
        return false;
    };
    EXPECT_EQ(EnsureUiSkinSelection(selection, s_DefaultUiSkinRef, rejectRevalidation), UiSkinSelectionResult::Failed);
    EXPECT_EQ(selection.selected, s_CustomUiSkinRef);
    EXPECT_EQ(calls, 1u);
}

void VerifyUiTextEditOwned_PollCopiesEventsWithoutApplyingAndOwnedCommitSurvivesNativeCancellation(){
    HeapStorage arena = HeapStorage();
    FakeTextInput service = FakeTextInput(arena);
    EditModel model = EditModel();
    UiTextEditSession session = UiTextEditSession(service);
    TextInputEvent event = TextInputEvent();
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("base"));
    ASSERT_EQ(session.begin(MakeSessionTestOwner(61u, 1u, 2u), s_OwnedTestCaret, model), TextInputAdmission::Accepted);
    const TextInputSessionToken oldToken = session.token();
    String source = String(" copied");
    ASSERT_EQ(service.commit(StringView(source)), TextInputAdmission::Accepted);
    source.assign("changed");
    ASSERT_EQ(session.pollOwned(event), TextInputPollResult::Event);
    EXPECT_EQ(event.token, oldToken);
    EXPECT_EQ(StringView(event.text), " copied");
    EXPECT_EQ(model.text(), "base");
    EXPECT_TRUE(session.matchesPublished(MakeSessionTestOwner(61u, 1u, 2u), model));
    ASSERT_TRUE(session.cancel());
    EXPECT_FALSE(session.token().valid());
    EXPECT_FALSE(service.activeSession().valid());
    EXPECT_EQ(session.pollOwned(event), TextInputPollResult::InvalidSession);
    ASSERT_EQ(ApplyUiTextEditEvent(model, event, 0u, false), UiTextEditStatus::Applied);
    EXPECT_EQ(model.text(), "base copied");
}

void VerifyUiTextEditOwned_TrustedLocalAdoptionRecoversAfterStrictRefreshRejectsChangedModel(){
    HeapStorage arena = HeapStorage();
    FakeTextInput service = FakeTextInput(arena);
    EditModel model = EditModel();
    UiTextEditSession session = UiTextEditSession(service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("base"));
    ASSERT_EQ(session.begin(MakeSessionTestOwner(61u, 1u, 2u), s_OwnedTestCaret, model), TextInputAdmission::Accepted);
    const u64 oldSurrounding = session.surroundingRevision();
    ASSERT_TRUE(model.replaceSelection(" local"));
    EXPECT_FALSE(session.matchesPublished(MakeSessionTestOwner(61u, 1u, 2u), model));
    EXPECT_EQ(session.refresh(MakeSessionTestOwner(61u, 1u, 2u), model, s_OwnedTestCaret), TextInputAdmission::InvalidSession);
    ASSERT_EQ(session.adoptLocal(MakeSessionTestOwner(61u, 1u, 2u), model, s_OwnedTestCaret), TextInputAdmission::Accepted);
    EXPECT_GT(session.surroundingRevision(), oldSurrounding);
    EXPECT_TRUE(session.matchesPublished(MakeSessionTestOwner(61u, 1u, 2u), model));
    ASSERT_EQ(service.commit(" native"), TextInputAdmission::Accepted);
    ASSERT_EQ(session.drain(MakeSessionTestOwner(61u, 1u, 2u), model).status, UiTextEditStatus::Applied);
    EXPECT_EQ(model.text(), "base local native");
}

void VerifyUiTextEditOwned_CancelWithoutModelLeavesTransientCompositionForTheNextSynchronousLend(){
    HeapStorage arena = HeapStorage();
    FakeTextInput service = FakeTextInput(arena);
    EditModel model = EditModel();
    UiTextEditSession session = UiTextEditSession(service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("base"));
    ASSERT_EQ(session.begin(MakeSessionTestOwner(61u, 1u, 2u), s_OwnedTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.preedit("draft", 0u, 5u, false), TextInputAdmission::Accepted);
    ASSERT_EQ(session.drain(MakeSessionTestOwner(61u, 1u, 2u), model).status, UiTextEditStatus::Applied);
    ASSERT_TRUE(session.cancel());
    EXPECT_TRUE(model.composition().active);
    EXPECT_EQ(model.text(), "base");
    EXPECT_EQ(session.adoptLocal(MakeSessionTestOwner(61u, 1u, 2u), model, s_OwnedTestCaret), TextInputAdmission::InvalidSession);
    model.cancelComposition();
    ASSERT_EQ(session.begin(MakeSessionTestOwner(61u, 1u, 2u), s_OwnedTestCaret, model), TextInputAdmission::Accepted);
}

void VerifyUiTextEditOwned_CopiedSurroundingDeletionRequiresPublishedRevisionAndGraphemeAlignedRange(){
    HeapStorage arena = HeapStorage();
    EditModel model = EditModel();
    TextInputEvent event = TextInputEvent();
    ASSERT_TRUE(model.setText("a\xCC\x81z"));
    event.kind = TextInputEventKind::DeleteSurrounding;
    event.surroundingRevision = 7u;
    event.deleteBeforeBytes = 1u;
    EXPECT_EQ(ApplyUiTextEditEvent(model, event, 8u, true), UiTextEditStatus::StaleSurrounding);
    EXPECT_EQ(ApplyUiTextEditEvent(model, event, 7u, false), UiTextEditStatus::StaleSurrounding);
    EXPECT_EQ(model.text(), "a\xCC\x81z");
    event.deleteBeforeBytes = 2u;
    EXPECT_EQ(ApplyUiTextEditEvent(model, event, 7u, true), UiTextEditStatus::ModelRejected);
    EXPECT_EQ(model.text(), "a\xCC\x81z");
    event.deleteBeforeBytes = 5u;
    EXPECT_EQ(ApplyUiTextEditEvent(model, event, 7u, true), UiTextEditStatus::InvalidEvent);
    event.deleteBeforeBytes = 1u;
    EXPECT_EQ(ApplyUiTextEditEvent(model, event, 7u, true), UiTextEditStatus::Applied);
    EXPECT_EQ(model.text(), "a\xCC\x81");
}

void VerifyUiTextEditOwned_MalformedCopiedEventsAndRejectedPreeditPreserveCommittedState(){
    HeapStorage arena = HeapStorage();
    EditLimits limits = EditLimits();
    limits.maxBytes = 4u;
    EditModel model = EditModel(limits);
    TextInputEvent event = TextInputEvent();
    ASSERT_TRUE(model.setText("base"));
    event.kind = TextInputEventKind::Preedit;
    event.text.assign("\xED\x95\x9C");
    event.anchorByte = 1u;
    event.caretByte = 3u;
    EXPECT_EQ(ApplyUiTextEditEvent(model, event, 0u, false), UiTextEditStatus::InvalidEvent);
    EXPECT_FALSE(model.composition().active);
    event.anchorByte = 0u;
    EXPECT_EQ(ApplyUiTextEditEvent(model, event, 0u, false), UiTextEditStatus::ModelRejected);
    EXPECT_FALSE(model.composition().active);
    event.kind = TextInputEventKind::Commit;
    event.text.assign("\xC0\xAF");
    EXPECT_EQ(ApplyUiTextEditEvent(model, event, 0u, false), UiTextEditStatus::InvalidEvent);
    EXPECT_EQ(model.text(), "base");
    ASSERT_TRUE(model.beginComposition());
    event.kind = TextInputEventKind::Cancelled;
    EXPECT_EQ(ApplyUiTextEditEvent(model, event, 0u, false), UiTextEditStatus::Cancelled);
    EXPECT_FALSE(model.composition().active);
}

void VerifyUiTextEditOwned_IdenticalExternalResetFencesOldEventsAndPublishedDeletionContext(){
    HeapStorage arena = HeapStorage();
    FakeTextInput service = FakeTextInput(arena);
    EditModel model = EditModel();
    UiTextEditSession session = UiTextEditSession(service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("base"));
    ASSERT_EQ(session.begin(MakeSessionTestOwner(61u, 1u, 2u), s_OwnedTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.commit("old"), TextInputAdmission::Accepted);
    const u64 revision = model.revision();
    ASSERT_TRUE(model.setText("base"));
    EXPECT_EQ(model.revision(), revision);
    EXPECT_FALSE(session.matchesPublished(MakeSessionTestOwner(61u, 1u, 2u), model));
    EXPECT_EQ(session.refresh(MakeSessionTestOwner(61u, 1u, 2u), model, s_OwnedTestCaret), TextInputAdmission::InvalidSession);
    EXPECT_EQ(session.drain(MakeSessionTestOwner(61u, 1u, 2u), model).status, UiTextEditStatus::StaleModel);
    EXPECT_EQ(model.text(), "base");
}

void VerifyUiTextEditOwned_OwnedCollectionAdoptionAndCancellationRejectAnotherThread(){
    HeapStorage arena = HeapStorage();
    FakeTextInput service = FakeTextInput(arena);
    EditModel model = EditModel();
    UiTextEditSession session = UiTextEditSession(service);
    TextInputEvent event = TextInputEvent();
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_EQ(session.begin(MakeSessionTestOwner(61u, 1u, 2u), s_OwnedTestCaret, model), TextInputAdmission::Accepted);
    b8 cancelled = true;
    TextInputPollResultEnum poll = TextInputPollResult::Pending;
    TextInputAdmissionEnum adopt = TextInputAdmission::Accepted;
    Thread other = Thread(lambda[mut session, mut event, mut model, mut poll, mut adopt, mut cancelled]() -> void{
        poll = session.pollOwned(event);
        adopt = session.adoptLocal(MakeSessionTestOwner(61u, 1u, 2u), model, s_OwnedTestCaret);
        cancelled = session.cancel();
    });
    other.join();
    EXPECT_EQ(poll, TextInputPollResult::WrongThread);
    EXPECT_EQ(adopt, TextInputAdmission::WrongThread);
    EXPECT_FALSE(cancelled);
    EXPECT_TRUE(session.token().valid());
    EXPECT_TRUE(session.cancel());
}

void VerifyEcsUiUnwind_SystemUpdateAllocationFailureUnwindsAndDrainsCleanly(){
    EcsTestWorld ecs = EcsTestWorld();
    UiUnwindProbeSystem probe = UiUnwindProbeSystem(true);
    UiUnwindDependentSystem dependent = UiUnwindDependentSystem();
    SystemScheduler scheduler(ecs.arena);
    scheduler.addSystem(probe);
    scheduler.addSystem(dependent);
    EXPECT_TRUE(ExecuteSchedulerExpectingOom(scheduler, ecs.world));
    EXPECT_EQ(probe.updates, 1u);
    EXPECT_EQ(dependent.updates, 0u);
    EXPECT_EQ(ecs.taskScheduler.statistics().outstandingTasks, 0u);
    const auto postDrain = scheduler.execute(ecs.world, 0.016f);
    ASSERT_FALSE(postDrain.has_value());
    EXPECT_EQ(postDrain.error(), CpuTaskAdmissionError::Aborting);
}

void VerifyEcsUiUnwind_HostSessionAndClipboardAllocationFailurePreserveState(){
    PaintSlotFixture fixture = PaintSlotFixture();
    ASSERT_TRUE(fixture.textInput.setFocused(true));
    fixture.clipboard.delayed = true;
    EXPECT_TRUE(VerifyUiEditBoxHostEditOom(fixture.textInput, fixture.clipboard));
    EXPECT_TRUE(VerifyUiTextEditSessionOom(fixture.textInput));
    EXPECT_TRUE(VerifyUiEditClipboardControllerOom(fixture.clipboard));
}

class BridgeGamepadHandler : IInputEventHandler{
    private mut GamepadNavigationAdapter m_adapter;
    private mut Context m_context;
    public u32 m_buttonEvents = 0u;
    public u32 m_axisEvents = 0u;

    public BridgeGamepadHandler(mut GamepadNavigationAdapter adapter, mut Context context){
        this.m_adapter = adapter;
        this.m_context = context;
    }

    [cpp_unwind]
    public void gamepadConnectionUpdate(in u32 gamepadIndex, in b8 connected)override{
        this.m_adapter.onConnection(gamepadIndex, connected, this.m_context.input());
    }

    [cpp_unwind]
    public b8 gamepadButtonUpdate(in u32 gamepadIndex, in i32 button, in i32 action)override{
        ++this.m_buttonEvents;
        return this.m_adapter.onButton(gamepadIndex, button, action, this.m_context.input());
    }

    [cpp_unwind]
    public b8 gamepadAxisUpdate(in u32 gamepadIndex, in i32 axis, in f32 value)override{
        ++this.m_axisEvents;
        return this.m_adapter.onAxis(gamepadIndex, axis, value, this.m_context.input());
    }
}

void AddBridgeGamepadHandlerToBack(mut InputDispatcher dispatcher, mut BridgeGamepadHandler handler){
    dispatcher.addHandlerToBack(handler);
}

void RemoveBridgeGamepadHandler(mut InputDispatcher dispatcher, mut BridgeGamepadHandler handler){
    dispatcher.removeHandler(handler);
}

void VerifyEcsUiBridge_PaintContextCursorAccessibilityAndGamepadForwarding(){
    PaintSlotFixture fixture = PaintSlotFixture();
    EXPECT_EQ(MapPointerCursorToCoreCursor(PointerCursor::Default), CursorShape::Default);
    EXPECT_EQ(MapPointerCursorToCoreCursor(PointerCursor::TextInput), CursorShape::TextInput);
    EXPECT_EQ(MapPointerCursorToCoreCursor(PointerCursor::Grabbing), CursorShape::Grabbing);
    EXPECT_EQ(MapPointerCursorToCoreCursor(PointerCursor::Hidden), CursorShape::Hidden);

    EXPECT_TRUE(fixture.context.cursor.setCursor(CursorShape::Hand));
    EXPECT_TRUE(fixture.context.cursor.setCursor(CursorShape::Hand));
    EXPECT_TRUE(fixture.context.cursor.setCursor(CursorShape::ResizeEW));
    EXPECT_EQ(fixture.cursor.historyCount, 2u);
    EXPECT_EQ(fixture.cursor.history[0u], CursorShape::Hand);
    EXPECT_EQ(fixture.cursor.history[1u], CursorShape::ResizeEW);

    WidgetRoot testRoot;
    testRoot.value = 91u;
    ASSERT_TRUE(fixture.uiContext.beginFrame(1u));
    ASSERT_TRUE(fixture.uiContext.beginRoot(testRoot));
    const auto btnDecl = fixture.uiContext.declare("btn", WidgetKind::Button);
    const auto nextDecl = fixture.uiContext.declare("next", WidgetKind::Button);
    ASSERT_TRUE(btnDecl.has_value());
    ASSERT_TRUE(nextDecl.has_value());

    HitTarget btnTarget;
    btnTarget.rectangle = Rect(10.0f, 10.0f, 80.0f, 30.0f);
    btnTarget.clip = Rect(0.0f, 0.0f, 400.0f, 200.0f);
    btnTarget.focusable = true;
    btnTarget.activatable = true;
    ASSERT_TRUE(fixture.uiContext.addTarget(btnDecl.value(), btnTarget));

    HitTarget nextTarget;
    nextTarget.rectangle = Rect(120.0f, 10.0f, 80.0f, 30.0f);
    nextTarget.clip = Rect(0.0f, 0.0f, 400.0f, 200.0f);
    nextTarget.focusable = true;
    nextTarget.activatable = true;
    ASSERT_TRUE(fixture.uiContext.addTarget(nextDecl.value(), nextTarget));

    AccessibleNodeDesc btnNode;
    btnNode.id = btnDecl.value().id;
    btnNode.role = AccessibilityRole::Button;
    btnNode.stateBits = s_AccessibilityStateEnabled | s_AccessibilityStateFocusable;
    btnNode.actionBits = s_AccessibilityActionInvoke | s_AccessibilityActionFocus;
    btnNode.bounds = btnTarget.rectangle;
    btnNode.name = "First";
    ASSERT_TRUE(fixture.uiContext.addAccessibleNode(btnNode));
    ASSERT_TRUE(fixture.uiContext.announce("Loaded", AccessibilityLiveMode::Polite));
    ASSERT_TRUE(fixture.uiContext.endRoot());
    ASSERT_TRUE(fixture.uiContext.finishFrame());
    ASSERT_TRUE(fixture.uiContext.commitFrame(1u));

    in AccessibleTree tree = fixture.uiContext.accessibility();
    ASSERT_TRUE(fixture.context.accessibility.publishTree(
        Span<AccessibilityNodeData>(tree.nodes()),
        tree.textStorage(),
        tree.focusedId().value,
        tree.generation(),
        fixture.display.pixelScaleX,
        fixture.display.pixelScaleY
    ));
    EXPECT_TRUE(fixture.context.accessibility.announce(tree.announcementText(tree.announcementAt(0u)), AccessibilityLiveMode::Polite));
    EXPECT_EQ(fixture.accessibility.lastVersion, 1u);
    EXPECT_EQ(fixture.accessibility.lastNodeCount, 1u);
    ASSERT_EQ(fixture.accessibility.announcements.size(), 1u);
    EXPECT_EQ(StringView(fixture.accessibility.announcements[0u]), "Loaded");

    ASSERT_TRUE(fixture.accessibility.pushAction(btnDecl.value().id.value, AccessibilityActionKind::Invoke, 0.0));
    AccessibilityActionEvent action;
    ASSERT_TRUE(fixture.context.accessibility.pollAction(action));
    EXPECT_TRUE(fixture.uiContext.applyAccessibleAction(action));
    EXPECT_EQ(fixture.uiContext.input().focus(), btnDecl.value().id);

    GamepadNavigationAdapter pad;
    InputDispatcher dispatcher = InputDispatcher();
    BridgeGamepadHandler handler(pad, fixture.uiContext);
    AddBridgeGamepadHandlerToBack(dispatcher, handler);
    dispatcher.gamepadConnectionUpdate(0u, true);
    dispatcher.gamepadButtonUpdate(0u, cast<i32>(GamepadButton::DPadRight), s_InputActionPress);
    EXPECT_EQ(fixture.uiContext.input().focus(), nextDecl.value().id);
    dispatcher.gamepadButtonUpdate(0u, cast<i32>(GamepadButton::DPadRight), s_InputActionReleaseBase);
    dispatcher.gamepadAxisUpdate(0u, cast<i32>(GamepadAxis::LeftX), -0.90f);
    EXPECT_EQ(fixture.uiContext.input().focus(), btnDecl.value().id);
    RemoveBridgeGamepadHandler(dispatcher, handler);
    EXPECT_EQ(handler.m_buttonEvents, 2u);
    EXPECT_EQ(handler.m_axisEvents, 1u);
}


