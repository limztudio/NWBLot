[arena]
class GpuProbeDescriptors{
    private mut GraphicsRuntime m_graphics;
    private Vector<GpuDescriptorHandle> m_descriptors;

    public GpuProbeDescriptors(mut GraphicsRuntime graphics){
        this.m_graphics = graphics;
    }

    [cpp_unwind]
    public ~GpuProbeDescriptors(){
        if(!this.m_graphics.waitForIdle())
            TerminateInvariant();
        mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
        for(in GpuDescriptorHandle descriptor : this.m_descriptors){
            if(descriptor.valid())
                heap.free(descriptor);
        }
    }

    public void retain(in GpuDescriptorHandle descriptor){
        this.m_descriptors.push_back(descriptor);
    }
}

b8 LoadGpuProbePipeline(
    mut ProjectRuntimeContext context,
    in Name shaderName,
    in StringView variant,
    in Name debugName,
    in StringView owner,
    in u32 pushBytes,
    mut ComputePipelineHandle outPipeline
){
    ShaderHandle shader;
    if(!Load<ComputeShader, ShaderArchivePathResolver>(shaderName, variant, debugName, owner,
        context.graphics, context.assetManager, context.shaderPathResolver, Optional<Name>(), shader))
        return false;
    mut Device device = context.graphics.getDevice();
    BindingLayoutHandle layout;
    return EnsurePushConstantBindingLayout(device, pushBytes, ShaderTypeMask::Compute, layout)
        && CreateHeapComputePipeline(device, shader, layout, false, outPipeline);
}

class ProbeBufferImport{
    public BufferHandle buffer;
    public StringView label;
    public ResourceStates state;
    public GpuTaskResourceAccess access;

    public ProbeBufferImport(in BufferHandle buffer, in StringView label, in ResourceStates state, in GpuTaskResourceAccess access){
        this.buffer = buffer;
        this.label = label;
        this.state = state;
        this.access = access;
    }

    [cpp_unwind]
    public Expected<GpuTaskResourceUse> importUse(mut GpuTaskGraph graph)const{
        GpuGraphResourceDesc desc;
        desc.setIdentity(this.buffer.deref().getCreationDescription().debugName).setMarkerLabel(this.label).setType(GpuGraphResourceType::Buffer)
            .setInitialState(this.state).setExternalFinalState(this.state);
        const auto resource = graph.importBuffer(this.buffer, desc);
        if(!resource.has_value())
            return MakeUnexpected(Failure());
        GpuTaskResourceUse use;
        use.resource = resource.value();
        use.requiredState = this.state;
        use.access = this.access;
        return use;
    }
}

[cpp_unwind]
b8 ImportProbeBufferUses(mut GpuTaskGraph graph, in Span<ProbeBufferImport> buffers, mut Span<GpuTaskResourceUse> uses){
    if(uses.size() < buffers.size())
        return false;
    for(usize i = 0u; i < buffers.size(); ++i){
        const auto use = buffers[i].importUse(graph);
        if(!use.has_value())
            return false;
        uses[i] = use.value();
    }
    return true;
}

Expected<BufferHandle> CreateGpuProbeWordBuffer(mut GraphicsRuntime graphics, in Name name, in u64 wordCount, in b8 raw, in b8 indirect, in b8 readback){
    BufferDesc desc;
    desc.setDebugName(name).setByteSize(wordCount * size_of<u32>()).setStructStride(size_of<u32>()).setCanHaveUAVs(!readback)
        .setCanHaveRawViews(raw && !readback).setIsDrawIndirectArgs(indirect).enableAutomaticStateTracking(ResourceStates::CopyDest);
    if(readback)
        desc.setCpuAccess(CpuAccessMode::Read);
    return graphics.createBuffer(desc);
}

GpuTaskCommandRequirements ComputeTransferProbeCommands(){
    GpuTaskCommandRequirements commands;
    commands.requiredCapabilities = GpuQueueCapability::Compute | GpuQueueCapability::Transfer;
    commands.requiresPrimaryGraphicsQueue = true;
    return commands;
}


