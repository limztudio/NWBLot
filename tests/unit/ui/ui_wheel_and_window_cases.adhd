using namespace NWB;
using namespace NWB::Impl::Ui;


class UiWheelInputTests : public testing::Test{
public:
    UiWheelInputTests()
        : m_arena(Name(NWB::Tests::UiCases::s_UiCaseTestsUiWheelInput))
        , m_router(m_arena)
    {
        m_targets[0u] = ::__hidden_ui_glyph_sdf_tests::MakeUiWheelHost();
        m_targets[1u] = ::__hidden_ui_glyph_sdf_tests::MakeUiWheelPart(m_targets[0u]);
    }


public:
    [[nodiscard]] InputRoutingResult wheel(f64 deltaX, f64 deltaY, Point position = { 10.0f, 10.0f });
    [[nodiscard]] b8 queuePointer(const Point& position, InputEventType::Enum type);


public:
    Core::Alloc::GlobalArena m_arena;
    InputRouter m_router;
    Array<HitTarget, 2u> m_targets;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


