namespace UiHorizontalNavigationTests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


HitTarget Part(const HitTarget& host)noexcept{
    return ::__hidden_ui_glyph_sdf_tests::MakeHorizontalNavigationPart(host);
}

PopupScope Popup(const HitTarget& owner, const u64 openGeneration)noexcept{
    return ::__hidden_ui_glyph_sdf_tests::MakeHorizontalNavigationPopup(owner, openGeneration);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


HorizontalNavigationFixture::HorizontalNavigationFixture()
    : RouterTestFixture(Name(NWB::Tests::UiCases::s_UiCaseTestsUiHorizontalNavigation))
{
    for(usize index = 0u; index < 2u; ++index){
        HitTarget& host = m_targets[index];
        host.id = { index + 1u };
        host.declarationGeneration = 7u;
        host.rectangle = { static_cast<f32>(index) * 140.0f, 0.0f, 100.0f, 100.0f };
        host.clip = { 0.0f, 0.0f, 300.0f, 200.0f };
        host.focusable = true;
        host.control = { 11u + index, 21u, 31u };
        host.navigable = true;
        host.horizontalNavigation = true;
        host.pageRows = 4u;
    }
    HitTarget& editor = m_targets[2u];
    editor.id = { 3u };
    editor.declarationGeneration = 9u;
    editor.rectangle = { 0.0f, 120.0f, 120.0f, 24.0f };
    editor.clip = m_targets[0u].clip;
    editor.focusable = true;
    editor.textEditable = true;
    editor.control = { 101u, 102u, 103u };
}

InputRoutingResult HorizontalNavigationFixture::keyDown(const Core::Key::Enum key, const b8 repeat){
    return send({ .key = key, .type = InputEventType::KeyDown, .repeat = repeat });
}

InputRoutingResult HorizontalNavigationFixture::keyUp(const Core::Key::Enum key){
    return send({ .key = key, .type = InputEventType::KeyUp });
}

void HorizontalNavigationFixture::press(const Core::Key::Enum key){
    EXPECT_TRUE(keyDown(key).commandConsumed);
    EXPECT_TRUE(keyUp(key).commandConsumed);
}

void HorizontalNavigationFixture::focusTarget(const usize index){
    const Rect& rectangle = m_targets[index].rectangle;
    const Point point{ rectangle.x + 10.0f, rectangle.y + 10.0f };
    EXPECT_TRUE(send({ .position = point, .type = InputEventType::PrimaryDown }).pointerConsumed);
    EXPECT_TRUE(send({ .position = point, .type = InputEventType::PrimaryUp }).pointerConsumed);
    EXPECT_EQ(m_router.focus(), m_targets[index].id);
}

b8 HorizontalNavigationFixture::publish(const usize count, const Span<const PopupScope> popups){
    const u64 generation = m_generation + 1u;
    if(!m_router.commitTargets(Span<const HitTarget>(m_targets.data(), count), generation, popups))
        return false;
    m_generation = generation;
    return true;
}

Expected<ControlAction> HorizontalNavigationFixture::take(const usize index)noexcept{
    const HitTarget& host = m_targets[index];
    return m_router.consumeControlAction(host.id, host.declarationGeneration, host.control);
}

void HorizontalNavigationFixture::bindEditor(const usize hostIndex)noexcept{
    const HitTarget& host = m_targets[hostIndex];
    HitTarget& editor = m_targets[2u];
    editor.commandOwner = host.id;
    editor.commandOwnerDeclarationGeneration = host.declarationGeneration;
    editor.commandControl = host.control;
    editor.popup = host.popup;
    editor.layer = host.layer;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace UiMultilineViewTests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ExpectPlacement(const EditBoxPlacement& actual, const EditBoxPlacement& expected){
    ::__hidden_ui_glyph_sdf_tests::ExpectUiEditBoxPlacement(actual, expected);
}

void CollectSolidRects(const DrawSnapshot& snapshot, const Color& color, PaintVector<Rect>& output){
    output.clear();
    for(const DrawCommand& command : snapshot.commands()){
        if(command.material != PaintMaterial::Solid)
            continue;
        for(u32 index = command.firstIndex; index + 5u < command.firstIndex + command.indexCount; index += 6u){
            const Vertex& first = snapshot.vertices()[snapshot.indices()[index]];
            if(first.color.r != color.r || first.color.g != color.g || first.color.b != color.b || first.color.a != color.a)
                continue;
            const Vertex& opposite = snapshot.vertices()[snapshot.indices()[index + 2u]];
            output.push_back({ first.position.x, first.position.y, opposite.position.x - first.position.x, opposite.position.y - first.position.y });
        }
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


MultilineViewFixture::MultilineViewFixture()
    : m_arena(Name(NWB::Tests::UiCases::s_UiCaseTestsUiWidgetsMultilineView))
    , m_model(m_arena, {}, EditTextMode::Multiline)
    , m_shaper(m_arena)
    , m_layoutBuilder(m_arena, m_shaper)
    , m_view(m_arena)
    , m_font(m_arena, Name(s_MultilineViewFontPath))
    , m_text(m_arena)
    , m_skin(m_arena, Name(s_MultilineViewSkinPath))
    , m_paint(m_arena)
{
    UiSkin::RegionVector regions(m_arena);
    m_skin.setAtlas(Core::Assets::AssetRef<Texture>("tests/ui/widgets/multiline_view/texture"), 4u, 4u, 1.0f, Move(regions));
}

b8 MultilineViewFixture::shapeView(){
    if(!m_view.snapshot(m_model))
        return false;
    auto layout = m_layoutBuilder.layout({ m_view.displayText() });
    return layout && m_view.adoptLayout(Move(*layout));
}

b8 MultilineViewFixture::place(const f32 width, const f32 height, const Point previousScroll)noexcept{
    const auto placement = m_view.arrange({ 10.0f, 20.0f, width, height }, {}, s_MultilineViewViewport, previousScroll);
    if(!placement)
        return false;
    m_placement = *placement;
    return true;
}

b8 MultilineViewFixture::loadFont(){
    Core::Alloc::ScratchArena fontScratchArena(s_FontScratchArenaName);
    return InstallLatinFixtureFont(fontScratchArena, m_arena, m_font, m_text);
}

Expected<DrawSnapshot> MultilineViewFixture::paintView(const EditBoxStyle& style, const EditBoxPaintFlags& flags){
    m_paint.begin({ s_MultilineViewViewport.width, s_MultilineViewViewport.height, 1.0f, 1.0f }, 1u, 1u, Core::Assets::AssetRef<UiSkin>(s_MultilineViewSkinPath), m_skin);
    if(!m_view.paint(m_text, m_paint, m_skin, m_placement, style, flags))
        return MakeUnexpected(Failure{});
    EXPECT_FALSE(m_paint.popClip());
    return m_paint.freeze();
}


