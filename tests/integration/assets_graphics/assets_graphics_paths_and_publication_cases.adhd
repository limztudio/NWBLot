[cpp_unwind]
b8 PublishImmutableGraphicsBytes(in GraphicsTestPath destination, in u8 fill, mut Latch ready, in Latch start){
    ScratchStorage storage(s_CodecScratchArena);
    TestValueSlot<ScratchPath> pathSlot;
    mut ScratchPath path = pathSlot.constructIn(storage, destination);
    TestValueSlot<PublicationBuffer> bytesSlot;
    mut PublicationBuffer bytes = bytesSlot.constructIn(storage);
    TestValueSlot<PublicationBuffer> existingSlot;
    mut PublicationBuffer existing = existingSlot.constructIn(storage);
    bytes.resize(1024u * 1024u, fill);
    ready.count_down();
    start.wait();
    return WritePublication(path, bytes, false, existing);
}

void VerifyAssetsGraphics_ConcurrentImmutablePublicationPreservesTheWinner(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    TestArena testArena = TestArena();
    const GraphicsTestPath root = GetGraphicsTestCaseRoot(testArena, "immutable_publication_race");
    ASSERT_TRUE(PrepareCleanDirectory(root));
    const GraphicsTestPath destination = JoinGraphicsPath(root, "shared.nwba");
    b8 firstWon = false;
    b8 secondWon = false;
    Latch ready(2);
    Latch start(1);
    JoiningThread first(lambda[in destination, mut ready, mut start, mut firstWon]() -> void{
        firstWon = PublishImmutableGraphicsBytes(destination, 1u, ready, start);
    });
    JoiningThread second(lambda[in destination, mut ready, mut start, mut secondWon]() -> void{
        secondWon = PublishImmutableGraphicsBytes(destination, 2u, ready, start);
    });
    ready.wait();
    start.count_down();
    first.join();
    second.join();
    ASSERT_NE(firstWon, secondWon);
    AssetBytes stored(testArena.arena);
    ASSERT_TRUE(GraphicsReadBinaryFile(destination, stored).has_value());
    ASSERT_EQ(stored.size(), 1024u * 1024u);
    u8 expected = 2u;
    if(firstWon)
        expected = 1u;
    for(in u8 byte : stored)
        ASSERT_EQ(byte, expected);
    EXPECT_TRUE(GraphicsRemoveAllIfExists(root));
}

void VerifyAssetsGraphics_DeferredWriteOwnsScratchBytesBeforeCallerMutation(){
    TestArena testArena = TestArena();
    const GraphicsTestPath root = GetGraphicsTestCaseRoot(testArena, "volume_scratch_bytes");
    const b8 prepared = PrepareCleanDirectory(root);
    EXPECT_TRUE(prepared);

    if(prepared){
        VolumeMountDesc mount(testArena.arena);
        ASSERT_TRUE(mount.volumeName.assign("scratch_test"));
        mount.segmentSize = 64ul * 1024ul;
        mount.metadataSize = 4ul * 1024ul;
        mount.mountDirectory = root / "volume";
        mount.createIfMissing = true;
        mount.usage = VolumeUsage::CookWrite;
        auto mounted = CreateVolumeFilesystem(testArena.arena, mount);
        EXPECT_TRUE(mounted.has_value());
        if(mounted.has_value()){
            mut IFilesystem filesystem = mounted.value().deref();
            Vector<u8> payload;
            payload.reserve(4u);
            for(u8 byte = 1u; byte <= 4u; ++byte)
                payload.push_back(byte);
            const Name path = s_ProjectTestsScratchPayload;
            const b8 pushed = filesystem.writeFileDeferred(path, payload);
            EXPECT_TRUE(pushed);
            if(pushed){
                payload[0u] = 99u;
                const b8 flushed = filesystem.flush();
                EXPECT_TRUE(flushed);
                if(flushed){
                    Vector<u8> readback;
                    const b8 loaded = filesystem.readFile(path, readback);
                    EXPECT_TRUE(loaded);
                    if(loaded){
                        ASSERT_EQ(readback.size(), 4u);
                        EXPECT_EQ(readback[0u], 1u);
                    }
                }
            }
        }
    }

    EXPECT_TRUE(GraphicsRemoveAllIfExists(root));
}

void VerifyAssetsGraphics_SharedCodecPayloadsKeepDistinctVirtualPathsUnderLongBuildDirectories(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    TestArena testArena = TestArena();
    const Expected<CookCase> cookCase = PrepareCookCase(testArena, "shared_codec_payloads");
    ASSERT_TRUE(cookCase.has_value());
    const CookCase prepared = cookCase.value();
    const GraphicsTestPath root = prepared.root;
    const GraphicsTestPath outputDirectory = prepared.outputDirectory;
    const GraphicsTestPath assetRoot = JoinGraphicsPath(root, s_AssetsDirectory);
    ASSERT_TRUE(WriteGraphicsFixtureText(JoinGraphicsPath2(assetRoot, "samplers", "first.nwb"), s_LinearWrapSamplerMetadata));
    ASSERT_TRUE(WriteGraphicsFixtureText(JoinGraphicsPath2(assetRoot, "samplers", "second.nwb"), s_LinearWrapSamplerMetadata));

    const usize rootTextLength = GraphicsPathUtf8ByteCount(root);
    ASSERT_LT(rootTextLength, 199u);
    AssetString directoryName(testArena.arena);
    directoryName.append(199u - rootTextLength, 98u);
    const GraphicsTestPath builtDirectory = JoinGraphicsPath(root, StringView(directoryName));
    ASSERT_EQ(GraphicsPathUtf8ByteCount(builtDirectory), 200u);
    ASSERT_TRUE(BuildSingleAssetRoot(testArena, root, builtDirectory, assetRoot, 2u));

    ASSERT_TRUE(GatherBuiltDirectoryToOutput(testArena, builtDirectory, outputDirectory));

    Array<Name, 2> virtualPaths = Array<Name, 2>();
    virtualPaths[0u] = Name(s_FirstSamplerPath);
    virtualPaths[1u] = Name(s_SecondSamplerPath);
    for(in Name virtualPath : virtualPaths){
        const Expected<SamplerAsset> asset = LoadCookedSamplerAsset(outputDirectory, virtualPath, 2u, testArena);
        ASSERT_TRUE(asset.has_value());
        EXPECT_EQ(asset.value().virtualPath(), virtualPath);
    }
    EXPECT_EQ(logger.errorCount(), 0u);
    EXPECT_TRUE(GraphicsRemoveAllIfExists(root));
}

void VerifyAssetsGraphics_FailedReorderedSharedPayloadBuildPreservesPublishedVirtualPaths(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    TestArena testArena = TestArena();
    GraphicsScratchArena scratch = GraphicsScratchArena(s_CodecScratchArena);

    const Expected<CookCase> cookCase = PrepareCookCase(testArena, "failed_reordered_shared_payloads");
    ASSERT_TRUE(cookCase.has_value());
    const CookCase prepared = cookCase.value();
    const GraphicsTestPath root = prepared.root;
    const GraphicsTestPath publishedDirectory = JoinGraphicsPath(root, "published");
    const GraphicsTestPath manifestPath = JoinGraphicsPath(publishedDirectory, s_BuiltAssetManifestFilename);
    const Name firstPath(s_FirstSamplerPath);
    const Name secondPath(s_SecondSamplerPath);

    TestValueSlot<SamplerAsset> samplerAssetStorage;
    mut SamplerAsset samplerAsset = samplerAssetStorage.constructIn(testArena, firstPath);
    SamplerDesc samplerDesc = SamplerDesc();
    samplerDesc.borderColor = SamplerColor(0.0f);
    samplerAsset.setDescription(samplerDesc);
    const SamplerAssetCodec samplerCodec = SamplerAssetCodec();
    AssetBytes samplerPayload(testArena.arena);
    ASSERT_TRUE(samplerCodec.serialize(samplerAsset, GraphicsCodecBytes(samplerPayload)));

    AssetVolumePackManifest initial(testArena.arena);
    ASSERT_TRUE(ReserveGraphicsManifest(2u, initial));
    ASSERT_TRUE(AppendTestCookPayload(firstPath, samplerPayload, initial, s_SharedCookKeyHash));
    ASSERT_TRUE(AppendTestCookPayload(secondPath, samplerPayload, initial, s_SharedCookKeyHash));
    ASSERT_TRUE(WriteBuiltManifestHelper(publishedDirectory, initial, scratch));

    AssetBytes originalList(testArena.arena);
    ASSERT_TRUE(GraphicsReadBinaryFile(manifestPath, originalList).has_value());
    AssetTestVector<AssetString> originalArtifactPaths(testArena.arena);
    ASSERT_TRUE(ReadManifestArtifactPaths(manifestPath, scratch, originalArtifactPaths));
    ASSERT_EQ(originalArtifactPaths.size(), 2u);
    AssetTestVector<AssetBytes> originalArtifactBytes(testArena.arena);
    originalArtifactBytes.reserve(originalArtifactPaths.size());
    for(usize index = 0u; index < originalArtifactPaths.size(); ++index){
        AssetBytes artifactData(testArena.arena);
        const GraphicsTestPath artifactFile(testArena.arena, StringView(originalArtifactPaths[index]));
        ASSERT_TRUE(GraphicsReadBinaryFile(artifactFile, artifactData).has_value());
        originalArtifactBytes.push_back(artifactData);
    }

    AssetVolumePackManifest reordered(testArena.arena);
    ASSERT_TRUE(ReserveGraphicsManifest(3u, reordered));
    ASSERT_TRUE(AppendTestCookPayload(secondPath, samplerPayload, reordered, s_SharedCookKeyHash));
    ASSERT_TRUE(AppendTestCookPayload(firstPath, samplerPayload, reordered, s_SharedCookKeyHash));
    ASSERT_TRUE(AppendTestCookPayload(s_AssetInputNameProjectSamplersFailing, samplerPayload, reordered, s_SharedCookKeyHash));
    CorruptManifestLastPayloadHash(reordered);
    EXPECT_FALSE(WriteBuiltManifestHelper(publishedDirectory, reordered, scratch));
    EXPECT_TRUE(SawCapturedError(logger, "invalid payload identity"));

    AssetBytes retainedList(testArena.arena);
    ASSERT_TRUE(GraphicsReadBinaryFile(manifestPath, retainedList).has_value());
    EXPECT_EQ(retainedList, originalList);
    AssetBytes retainedArtifactBytes(testArena.arena);
    for(usize index = 0u; index < originalArtifactPaths.size(); ++index){
        const GraphicsTestPath artifactFile(testArena.arena, StringView(originalArtifactPaths[index]));
        ASSERT_TRUE(GraphicsReadBinaryFile(artifactFile, retainedArtifactBytes).has_value());
        EXPECT_EQ(retainedArtifactBytes, originalArtifactBytes[index]);
    }

    ASSERT_TRUE(GatherBuiltDirectoryToOutput(testArena, publishedDirectory, prepared.outputDirectory));
    Array<Name, 2> virtualPaths = Array<Name, 2>();
    virtualPaths[0u] = firstPath;
    virtualPaths[1u] = secondPath;
    for(in Name virtualPath : virtualPaths){
        const Expected<SamplerAsset> asset = LoadCookedSamplerAsset(prepared.outputDirectory, virtualPath, 2u, testArena);
        ASSERT_TRUE(asset.has_value());
        EXPECT_EQ(asset.value().virtualPath(), virtualPath);
    }
    EXPECT_EQ(logger.errorCount(), 1u);
    EXPECT_TRUE(GraphicsRemoveAllIfExists(root));
}

Name ProbeAssetType(in IAssetCodec codec){ return codec.assetType(); }

void VerifyAssetsGraphics_AssetRegistrySupportsReentrantDeserializeAndDrainsBeforeUnregister(){
    HeapStorage arena;
    TestAtomic<b8> entered(false);
    TestAtomic<b8> release(false);
    TestAtomic<b8> destroyedWhileActive(false);
    TestAtomic<b8> unregisterFinished(false);
    TestAtomic<b8> inFlight(false);
    TestValueSlot<AssetRegistry> registrySlot;
    mut AssetRegistry registry = registrySlot.constructIn(arena);
    ASSERT_TRUE(registry.registerCodec(MakeUnique<LeafProbe>(s_ProbeLeafAsset)));
    ASSERT_TRUE(registry.registerCodec(MakeUnique<BlockingProbe>(s_ProbeParentAsset, registry, s_ProbeLeafAsset, entered, release, destroyedWhileActive, inFlight)));

    Expected<UniquePtr<IAsset>> result = MakeUnexpected(Failure());
    JoiningThread deserialize(lambda[mut registry, mut result]() -> void{
        result = registry.deserializeAsset(s_ProbeParentAsset, s_AssetCaseProjectProbeParent, Span<u8>());
    });
    while(!entered.load(MemoryOrder::seq_cst))
        YieldThread();

    b8 unregistered = false;
    JoiningThread unregister(lambda[mut registry, mut unregistered, mut unregisterFinished]() -> void{
        unregistered = registry.unregisterCodec(s_ProbeParentAsset);
        unregisterFinished.store(true, MemoryOrder::seq_cst);
    });
    for(u32 spin = 0u; spin < 64u; ++spin)
        YieldThread();
    EXPECT_FALSE(unregisterFinished.load(MemoryOrder::seq_cst));
    release.store(true, MemoryOrder::seq_cst);
    deserialize.join();
    unregister.join();

    ASSERT_TRUE(result.has_value());
    ASSERT_TRUE(result.value());
    EXPECT_EQ(result.value().deref().assetType(), s_ProbeParentAsset);
    EXPECT_TRUE(unregistered);
    EXPECT_TRUE(unregisterFinished.load(MemoryOrder::seq_cst));
    EXPECT_FALSE(destroyedWhileActive.load(MemoryOrder::seq_cst));
}

void VerifyAssetsGraphics_NativePathViewReclaimsScratchAfterUnicodeConversion(){
    ScratchStorage scratch(s_CodecScratchArena, 65536u);
    const usize baseline = scratch.memoryStats().usedBytes;
    const PlatformStringView source = PlatformTextLiteral("long-native-path/0123456789/0123456789/0123456789/한글");
    const StringView expected = "long-native-path/0123456789/0123456789/0123456789/한글";
    if(s_WideNativeChars && s_NativeCharSize == 2u){
        const Array<u32, 1u> units(0xd800u);
        const NativeUnits malformed = NativeUnits(Span<u32>(units));
        EXPECT_TRUE(CanonicalGraphicsNativeText(malformed.view(), "?", scratch));
    }
    const PlatformStringView genericSource = PlatformTextLiteral("long-native-path\\0123456789\\0123456789\\0123456789\\한글");
    StringView genericExpected = "long-native-path\\0123456789\\0123456789\\0123456789\\한글";
    if(IsWindowsPlatformHost())
        genericExpected = expected;
    for(usize i = 0u; i < 16u; ++i){
        {
            TestValueSlot<PathScratchString> slot;
            mut PathScratchString converted = slot.constructIn(scratch);
            EXPECT_EQ(GraphicsNativeText(source, converted), expected);
        }
        EXPECT_EQ(scratch.memoryStats().usedBytes, baseline);
        {
            TestValueSlot<PathScratchString> slot;
            mut PathScratchString converted = slot.constructIn(scratch);
            EXPECT_EQ(GraphicsGenericNativeText(genericSource, converted), genericExpected);
        }
        EXPECT_EQ(scratch.memoryStats().usedBytes, baseline);
    }
}

