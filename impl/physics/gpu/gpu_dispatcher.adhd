    public PhysicsGpuDispatcher(){
        this.m_graphics = Optional<mut GraphicsRuntime>();
        this.m_assetManager = Optional<mut AssetManager>();
        this.m_shaderPathResolver = ShaderArchivePathResolver();
        this.m_activeSceneSubsystems = ActiveSceneSubsystemsRef();
    }

    public PhysicsGpuDispatcher(
        mut GraphicsRuntime graphics,
        mut AssetManager assetManager,
        in ShaderArchivePathResolver shaderPathResolver
    ){
        this.m_graphics = Optional<mut GraphicsRuntime>(graphics);
        this.m_assetManager = Optional<mut AssetManager>(assetManager);
        this.m_shaderPathResolver = shaderPathResolver;
        this.m_activeSceneSubsystems = ActiveSceneSubsystemsRef();
    }

    public ~PhysicsGpuDispatcher(){
        this.invalidateResources();
    }

    public void attachRuntime(
        mut GraphicsRuntime graphics,
        mut AssetManager assetManager,
        in ShaderArchivePathResolver shaderPathResolver
    ){
        this.invalidateResources();
        this.m_graphics = Optional<mut GraphicsRuntime>(graphics);
        this.m_assetManager = Optional<mut AssetManager>(assetManager);
        this.m_shaderPathResolver = shaderPathResolver;
    }

    public void setActiveSceneSubsystems(in ActiveSceneSubsystemsRef subsystems){
        this.m_activeSceneSubsystems = subsystems;
    }

    public b8 isReady()const{
        return this.m_graphics.has_value() && this.m_assetManager.has_value() && this.m_pipelinesReady;
    }

    private Name resolveShaderAssetName(in u32 shaderIndex)const{
        if(!this.m_activeSceneSubsystems.has_value())
            return s_NameNone;
        const auto sub = this.m_activeSceneSubsystems.value().findSubsystem<PhysicsSubsystem>();
        if(!sub.has_value())
            return s_NameNone;
        in PhysicsSubsystem phys = sub.value();
        if(shaderIndex == 0u)
            return phys.broadphaseAabbCs.name();
        if(shaderIndex == 1u)
            return phys.narrowphaseCs.name();
        if(shaderIndex == 2u)
            return phys.solverIntegrateVelocitiesCs.name();
        if(shaderIndex == 3u)
            return phys.solverContactsCs.name();
        if(shaderIndex == 4u)
            return phys.solverIntegratePositionsCs.name();
        if(shaderIndex == 5u)
            return phys.solverFinalizeBodiesCs.name();
        if(shaderIndex == 6u)
            return phys.solverJointsCs.name();
        if(shaderIndex == 7u)
            return phys.solverIslandsCs.name();
        return phys.solverJointIslandsCs.name();
    }

    public void invalidateResources(){
        if(!this.m_graphics.has_value())
            return;

        mut GraphicsRuntime graphics = this.m_graphics.value();
        const b8 drained = graphics.waitForIdle();
        if(!drained)
            warning("PhysicsGpuDispatcher: waitForIdle returned false during invalidateResources");

        mut GpuDescriptorHeap heap = graphics.getDevice().getDescriptorHeap();
        ReleasePhysicsGpuBufferSlot(heap, this.m_bodySimSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_bodyStateSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_shapeSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_shapeAabbSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_pairSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_counterSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_indirectArgsSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_gridSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_largeListSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_hullVertexSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_meshNodeSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_meshTriSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_manifoldSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_constraintSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_jointConstraintSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_bodyOutSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_contactImpulseOutSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_jointImpulseOutSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_islandSliceSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_solverBodySimSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_rollingMassSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_toiBodySimSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_toiShapeSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_toiPairSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_toiManifoldSlot);
        this.m_computeCommandList.reset();
        this.m_computeQueue = GpuPhysicalQueueId();
        this.m_lastComputeToken = QueueSubmissionToken();

        this.m_cachedWorldIndex = 0u;
        this.m_cachedWorldGeneration = 0u;
        this.m_cachedTopologyVersion = 0u;
        this.m_staticGeomValid = false;
        this.m_staticGeomDirtyUpload = true;
        this.m_cachedHullData.clear();
        this.m_cachedMeshNodes.clear();
        this.m_cachedMeshTris.clear();
        this.m_shapeDataOffset.clear();
        this.m_shapeDataMeta.clear();
        this.m_seenContactsStampScratch.clear();
        this.m_stepStamp = 0u;
        this.m_manifoldContactIdsScratch.clear();
        this.m_manifoldSwappedScratch.clear();
        this.m_contactTransitionFlagsScratch.clear();
        this.m_resolvedManifoldsScratch.clear();
        this.m_staleIdsScratch.clear();
        this.m_contactRestFlagsScratch.clear();
        this.m_gpuRollingMassScratch.clear();
        this.m_flatGpuJointsScratch.clear();
        for(usize jc = 0u; jc < s_GpuJointColorCount; ++jc)
            this.m_jointColorBucketsScratch[jc].clear();
        this.m_bodyJointColorMaskScratch.clear();
        this.m_hitFlagsScratch.clear();
        this.m_partitionScratch.resetForStep();
        for(usize cc = 0u; cc < s_GraphColorCount; ++cc)
            this.m_cpuColorConstraintsScratch[cc].clear();
        this.m_cpuJointConstraintsScratch.clear();
        this.m_brokenJointIdsScratch.clear();
        this.m_sharedKinAwakeIndicesScratch.clear();
        this.m_sharedKinPreSimsScratch.clear();
        this.m_sharedKinPreStatesScratch.clear();
        this.m_cpuFallbackPreSimsScratch.clear();
        this.m_cpuFallbackPreStatesScratch.clear();
        this.m_toiBulletAwakeIndicesScratch.clear();
        this.m_toiBulletBodyIdsScratch.clear();
        this.m_gpuColPosesScratch.clear();
        this.m_staticPoseCacheValid = false;
        this.m_staticBodyGpuValid = false;
        this.m_staticShapeGpuValid = false;
        this.m_cachedStaticPoses.clear();
        this.m_cachedStaticShapes.clear();
        this.m_sleepingPoseCacheValid = false;
        this.m_sleepingBodyGpuValid = false;
        this.m_sleepingShapeGpuValid = false;
        this.m_cachedSleepingPoses.clear();
        this.m_cachedSleepingShapes.clear();
        this.m_prevAwakeBodyIdsScratch.clear();
        this.m_prevAwakeBodyStampScratch.clear();
        this.m_prevAwakeBodyStamp = 0u;
        this.m_parStaleContactFlagsScratch.clear();
        this.m_hadEnlargedFlagsScratch.clear();
        this.m_staleCheckStampScratch.clear();
        this.m_staleCheckStamp = 0u;
        this.m_awakeShapeCacheValid = false;
        this.m_awakeShapeGpuValid = false;
        this.m_cachedAwakeShapes.clear();
        this.m_toiBulletSweepMinScratch.clear();
        this.m_toiBulletSweepMaxScratch.clear();
        this.m_toiPairBulletIdxScratch.clear();
        this.m_toiPairShapeAScratch.clear();
        this.m_toiPairShapeBScratch.clear();
        this.m_toiBodyToSlotScratch.clear();
        this.m_toiShapeToSlotScratch.clear();
        this.m_toiPairsScratch.clear();
        this.m_awakeShapeCountsScratch.clear();
        this.m_awakeShapeOffsetsScratch.clear();
        this.m_awakeSweepMarginsScratch.clear();
        this.m_awakeBodyExtentAccumScratch.clear();
        this.m_awakeBodyExtentCountScratch.clear();
        this.m_awakeBodyHasComplexScratch.clear();

        this.m_broadphasePipeline.reset();
        this.m_narrowphasePrimPipeline.reset();
        this.m_narrowphaseComplexPipeline.reset();
        this.m_bulletToiPipeline.reset();
        this.m_integrateVelPipeline.reset();
        this.m_contactsPipeline.reset();
        this.m_jointsPipeline.reset();
        this.m_integratePosPipeline.reset();
        this.m_finalizePipeline.reset();
        this.m_islandsPipeline.reset();
        this.m_jointIslandsPipeline.reset();

        this.m_broadphaseShader.reset();
        this.m_narrowphasePrimShader.reset();
        this.m_narrowphaseComplexShader.reset();
        this.m_bulletToiShader.reset();
        this.m_integrateVelShader.reset();
        this.m_contactsShader.reset();
        this.m_jointsShader.reset();
        this.m_integratePosShader.reset();
        this.m_finalizeShader.reset();
        this.m_islandsShader.reset();
        this.m_jointIslandsShader.reset();

        this.m_bindingLayout.reset();
        this.m_lastBroadphasePairCount = 0u;
        this.m_deviceGeneration = 0u;
        this.m_pipelinesReady = false;
    }

    [cpp_unwind]
    public b8 validateResources(){
        if(!this.m_graphics.has_value() || !this.m_assetManager.has_value())
            return false;

        mut GraphicsRuntime graphics = this.m_graphics.value();
        mut Device device = graphics.getDevice();
        in GpuDescriptorHeap heap = device.getDescriptorHeap();
        if(!heap.isInitialized())
            return false;

        const u16 generation = device.getDeviceGeneration();
        if(this.m_deviceGeneration != 0u && this.m_deviceGeneration != generation)
            this.invalidateResources();
        this.m_deviceGeneration = generation;

        if(this.m_pipelinesReady)
            return true;

        if(!this.m_activeSceneSubsystems.has_value())
            return false;

        if(!this.m_bindingLayout.valid()){
            BindingLayoutDesc desc;
            desc.setVisibility(ShaderTypeMask::Compute);
            desc.addItem(BindingLayoutItemPushConstants(0u, s_GpuPushConstantsBytes));
            const Expected<BindingLayoutHandle> layoutRes = device.createBindingLayout(desc);
            if(!layoutRes.has_value())
                return false;
            this.m_bindingLayout = layoutRes.value();
        }

        mut AssetManager assets = this.m_assetManager.value();
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(0u), s_PhysicsShaderDefaultVariant, Name("physics/broadphase_aabb_cs"), this.m_broadphaseShader, this.m_broadphasePipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(1u), s_PhysicsShaderNpPrimVariant, Name("physics/narrowphase_cs_prim"), this.m_narrowphasePrimShader, this.m_narrowphasePrimPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(1u), s_PhysicsShaderNpComplexVariant, Name("physics/narrowphase_cs_complex"), this.m_narrowphaseComplexShader, this.m_narrowphaseComplexPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(1u), s_PhysicsShaderNpBulletToiVariant, Name("physics/narrowphase_cs_toi"), this.m_bulletToiShader, this.m_bulletToiPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(2u), s_PhysicsShaderDefaultVariant, Name("physics/solver_integrate_velocities_cs"), this.m_integrateVelShader, this.m_integrateVelPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(3u), s_PhysicsShaderDefaultVariant, Name("physics/solver_contacts_cs"), this.m_contactsShader, this.m_contactsPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(4u), s_PhysicsShaderDefaultVariant, Name("physics/solver_integrate_positions_cs"), this.m_integratePosShader, this.m_integratePosPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(5u), s_PhysicsShaderDefaultVariant, Name("physics/solver_finalize_bodies_cs"), this.m_finalizeShader, this.m_finalizePipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(6u), s_PhysicsShaderDefaultVariant, Name("physics/solver_joints_cs"), this.m_jointsShader, this.m_jointsPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(7u), s_PhysicsShaderDefaultVariant, Name("physics/solver_islands_cs"), this.m_islandsShader, this.m_islandsPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(8u), s_PhysicsShaderDefaultVariant, Name("physics/solver_joint_islands_cs"), this.m_jointIslandsShader, this.m_jointIslandsPipeline))
            return false;

        this.m_pipelinesReady = true;
        return true;
    }

    [cpp_unwind]
    private b8 ensureComputeCommandList(mut Device device){
        if(this.m_lastComputeToken.valid()){
            if(!device.waitForSubmissionToken(this.m_lastComputeToken))
                return false;
            this.m_lastComputeToken = QueueSubmissionToken();
        }
        if(this.m_computeCommandList.valid() && this.m_computeQueue.valid())
            return true;

        GpuPhysicalQueueId q = device.getPrimaryPhysicalQueue(CommandQueue::Compute);
        CommandQueue qt = CommandQueue::Compute;
        if(!q.valid()){
            q = device.getPrimaryPhysicalQueue(CommandQueue::Graphics);
            qt = CommandQueue::Graphics;
        }
        if(!q.valid())
            return false;

        CommandListParameters params;
        params.setQueueType(qt).setPhysicalQueue(q);
        const auto clRes = device.createCommandList(params);
        if(!clRes.has_value() || !clRes.value().valid())
            return false;

        this.m_computeCommandList = clRes.value();
        this.m_computeQueue = q;
        return true;
    }

    [cpp_unwind]
    private Expected<QueueSubmissionToken> submitComputeCommandList(
        mut Device device,
        mut CommandList commands,
        in b8 recorded
    ){
        commands.setEnableAutomaticBarriers(true);
        commands.close();
        if(!recorded || commands.commandRecordingFailed())
            return MakeUnexpected(Failure());

        QueueSubmissionDesc submitDesc;
        const auto receipt = device.executeCommandLists(commands, this.m_computeQueue, submitDesc);
        if(!receipt.has_value() || !receipt.value().token.valid())
            return MakeUnexpected(Failure());

        this.m_lastComputeToken = receipt.value().token;
        return receipt.value().token;
    }

    [cpp_unwind]
    private Expected<QueueSubmissionToken> submitCollisionAsync(
        mut Device device,
        mut GpuDescriptorHeap heap,
        in PhysicsGpuBufferGroup bufGroup,
        in Span<GpuPhysicsBodyPose> staticPoses,
        in Span<GpuPhysicsBodyPose> sleepingPoses,
        in Span<GpuPhysicsBodyPose> awakePoses,
        in Span<GpuPhysicsShapeProxy> staticShapes,
        in Span<GpuPhysicsShapeProxy> sleepingShapes,
        in Span<GpuPhysicsShapeProxy> awakeShapes,
        in Span<f32x4> hullVertices,
        in Span<f32x4> meshNodes,
        in Span<f32x4> meshTris,
        in u32 staticBodyCount,
        in u32 awakeBodyOffset,
        in u32 staticShapeCount,
        in u32 awakeShapeOffset,
        in u32 awakeShapeCount,
        in u32 shapeCount,
        in u32 updateAabbOffset,
        in u32 updateAabbCount,
        in u32 maxPairs,
        in f32 invCellSize,
        in b8 uploadStaticGeom,
        in b8 hasComplexShapes
    ){
        if(!this.ensureComputeCommandList(device))
            return MakeUnexpected(Failure());
        PendingRecordingLease heapLease = heap.acquirePendingRecordingLease();
        if(!heapLease.valid())
            return MakeUnexpected(Failure());

        mut CommandList commands = this.m_computeCommandList.deref();
        commands.open();
        commands.setEnableAutomaticBarriers(false);
        const PhysicsCollisionTask task(
            heap,
            bufGroup,
            this.m_broadphasePipeline,
            this.m_narrowphasePrimPipeline,
            this.m_narrowphaseComplexPipeline,
            staticPoses,
            sleepingPoses,
            awakePoses,
            staticShapes,
            sleepingShapes,
            awakeShapes,
            hullVertices,
            meshNodes,
            meshTris,
            staticBodyCount,
            awakeBodyOffset,
            staticShapeCount,
            awakeShapeOffset,
            awakeShapeCount,
            shapeCount,
            updateAabbOffset,
            updateAabbCount,
            maxPairs,
            invCellSize,
            uploadStaticGeom,
            hasComplexShapes
        );
        const b8 recorded = task.recordCommands(commands);
        return this.submitComputeCommandList(device, commands, recorded);
    }

    [cpp_unwind]
    private Expected<QueueSubmissionToken> submitBulletToiAsync(
        mut Device device,
