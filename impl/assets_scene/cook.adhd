[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if defined(NWB_COOK)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_scene/asset.adhd.h>

#include <core/alloc/scratch.h>
#include <core/assets/cook_dependency_registry.h>
#include <core/assets/cook_entry_registry.h>
#include <core/assets/cook_metadata.h>
#include <core/metascript/parser.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


template<typename ComponentT>
struct TypedComponentCookEntry{
    Name virtualPath = s_NameNone;
    ComponentT component;


public:
    explicit TypedComponentCookEntry(Core::Assets::AssetArena&)noexcept{}
};

using TransformComponentCookEntry = TypedComponentCookEntry<Scene::TransformComponent>;
using CameraComponentCookEntry = TypedComponentCookEntry<Scene::CameraComponent>;
using LightComponentCookEntry = TypedComponentCookEntry<Scene::LightComponent>;

struct EntityCookEntry{
    Name virtualPath = s_NameNone;
    EntityAsset::ComponentRefVector components;


public:
    explicit EntityCookEntry(Core::Assets::AssetArena& arena)noexcept
        : components(arena)
    {}
};

struct ProjectCookEntry{
    Name virtualPath = s_NameNone;
    ProjectAsset::SceneRef startScene;


public:
    explicit ProjectCookEntry(Core::Assets::AssetArena&)noexcept{}
};

struct SceneCookEntry{
    Name virtualPath = s_NameNone;
    SceneAsset::SubsystemRefVector subsystems;
    SceneAsset::EntityRefVector entities;
    SceneAsset::AssetMap assets;


public:
    explicit SceneCookEntry(Core::Assets::AssetArena& arena)noexcept
        : subsystems(arena)
        , entities(arena)
        , assets(0, Hasher<Name>(), EqualTo<Name>(), arena)
    {}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace SceneAssetCook{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


template<typename AssetT, typename EntryT>
[[nodiscard]] FOUNDATION_INLINE Expected<AssetT> BuildComponentAssetFromEntry(const EntryT& entry, Core::Assets::AssetArena& arena){
    AssetT asset(arena, entry.virtualPath);
    asset.component = entry.component;
    if(!asset.validatePayload())
        return MakeUnexpected(Failure{});
    return asset;
}

template<
    typename EntryT,
    typename AssetT,
    Core::Assets::ParseMetadataValueFn<EntryT> ParseValFn,
    const AStringView& DiagnosticPrefix,
    typename CodecT = TypedComponentAssetCodec<AssetT>
>
[[nodiscard]] FOUNDATION_INLINE b8 RegisterComponentCookEntry(Core::Assets::CookEntryRegistry& registry){
    return Core::Assets::RegisterDocumentValueCookEntry<EntryT, AssetT, CodecT>(
        s_ComponentAssetKindLabel,
        [](const Path& assetRoot, const AStringView virtualRoot, const Path& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::CookEntryParseContext& context){
            return Core::Assets::ParseCookMetadataDocument<EntryT, ParseValFn>(assetRoot, virtualRoot, nwbFilePath, doc, DiagnosticPrefix, context.cookArena, context.scratchArena);
        },
        [](const Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::CookEntryParseContext& context){
            return ParseValFn(virtualPath, nwbFilePath, asset, context.cookArena, context.scratchArena);
        },
        [](EntryT& entry, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena&){
            return BuildComponentAssetFromEntry<AssetT>(entry, arena);
        },
        true,
        registry
    );
}

template<typename EntryT, Core::Assets::ParseMetadataValueFn<EntryT> ParseValFn, const AStringView& DiagnosticPrefix>
[[nodiscard]] FOUNDATION_INLINE b8 ExtractLeafComponentDependencies(const Core::Assets::CookDependencyItemContext& context, Core::Assets::ICookDependencyCollector&){
    return Core::Assets::ParseCookDependencyEntry<EntryT, ParseValFn>(context, DiagnosticPrefix).has_value();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SceneComponentMetadataParser final{
public:
    [[nodiscard]] static Expected<TransformComponentCookEntry> ParseTransform(Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
    [[nodiscard]] static Expected<CameraComponentCookEntry> ParseCamera(Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
    [[nodiscard]] static Expected<LightComponentCookEntry> ParseLight(Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
};

[[nodiscard]] Expected<EntityCookEntry> ParseEntityCookMetadata(Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<EntityAsset> BuildEntityAsset(EntityCookEntry& entry, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);

[[nodiscard]] Expected<ProjectCookEntry> ParseProjectCookMetadata(Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<ProjectAsset> BuildProjectAsset(ProjectCookEntry& entry, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena&);

[[nodiscard]] Expected<SceneCookEntry> ParseSceneCookMetadata(Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<SceneAsset> BuildSceneAsset(SceneCookEntry& entry, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateRequiredSceneMetadataField(
    in b8 hasField,
    in StringView diagnosticPrefix,
    in StringView filePathText,
    in StringView fieldName
){
    if(hasField)
        return true;

    error("{} '{}': field '{}' is required", diagnosticPrefix, filePathText, fieldName);
    return false;
}

b8 ValidateSceneAssetsFieldIsMap(in b8 isMap, in StringView filePathText){
    if(isMap)
        return true;

    error("{} '{}': field '{}' must be a map", s_SceneDiagnosticPrefix, filePathText, s_SceneAssetsField);
    return false;
}

b8 ValidateSceneAssetNicknameSyntax(in StringView nicknameView, in StringView filePathText){
    if(IsValidSceneAssetNicknameText(nicknameView))
        return true;

    error("{} '{}': asset nickname '{}' must not be empty or padded", s_SceneDiagnosticPrefix, filePathText, nicknameView);
    return false;
}

b8 ValidateSceneAssetNicknameResolved(in b8 hasValidName, in StringView nicknameView, in StringView filePathText){
    if(hasValidName)
        return true;

    error("{} '{}': asset nickname '{}' contains an embedded null", s_SceneDiagnosticPrefix, filePathText, nicknameView);
    return false;
}

b8 ValidateSceneAssetNicknameUnique(in b8 inserted, in StringView nicknameView, in StringView filePathText){
    if(inserted)
        return true;

    error("{} '{}': duplicate asset nickname '{}'", s_SceneDiagnosticPrefix, filePathText, nicknameView);
    return false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if defined(NWB_COOK)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <core/assets/polymorphic_asset_codec.h>
#include <core/assets/reserved_asset_ref_parser.h>

#include <global/simd/vector.h>
#include <global/simplemath.h>
#include <global/text_utils.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_scene_cook_components{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace Core::Metascript;
using namespace SceneAssetCook;

[[nodiscard]] static b8 CheckOptionalMetadataAssetMap(const Path& nwbFilePath, const Value& asset, const AStringView diagnosticPrefix, Core::Alloc::ScratchArena& scratchArena){
    if(asset.isNull() || asset.isMap())
        return true;
    return Core::Assets::AssetPathsDetail::ValidateWithNativeText(nwbFilePath.native(), scratchArena, [&](const AStringView filePathText){ return ValidateOptionalSceneMetadataMap(false, diagnosticPrefix, filePathText); });
}

[[nodiscard]] static Expected<Float4> ParseFloat3Field(const Path& nwbFilePath, const AStringView diagnosticPrefix, const Value& listValue, const AStringView fieldLabel, Core::Alloc::ScratchArena& scratchArena){
    const usize count = listValue.isList() ? listValue.asList().size() : 0u;
    if((!listValue.isList() || count != s_SceneFloat3ComponentCount) && !Core::Assets::AssetPathsDetail::ValidateWithNativeText(nwbFilePath.native(), scratchArena, [&](const AStringView filePathText){ return ValidateSceneFloatListArity(listValue.isList(), count, s_SceneFloat3ComponentCount, diagnosticPrefix, filePathText, fieldLabel); }))
        return MakeUnexpected(Failure{});

    const auto& items = listValue.asList();
    const auto x = Core::Assets::ReadMetadataFiniteF32Value(nwbFilePath, items[0], diagnosticPrefix, fieldLabel);
    const auto y = Core::Assets::ReadMetadataFiniteF32Value(nwbFilePath, items[1], diagnosticPrefix, fieldLabel);
    const auto z = Core::Assets::ReadMetadataFiniteF32Value(nwbFilePath, items[2], diagnosticPrefix, fieldLabel);
    if(!x || !y || !z)
        return MakeUnexpected(Failure{});
    return MakeSceneMetadataFloat3(*x, *y, *z);
}

[[nodiscard]] static Expected<Float4> ParseQuaternionField(const Path& nwbFilePath, const AStringView diagnosticPrefix, const Value& listValue, const AStringView fieldLabel, Core::Alloc::ScratchArena& scratchArena){
    const usize count = listValue.isList() ? listValue.asList().size() : 0u;
    if((!listValue.isList() || count != s_SceneQuaternionComponentCount) && !Core::Assets::AssetPathsDetail::ValidateWithNativeText(nwbFilePath.native(), scratchArena, [&](const AStringView filePathText){ return ValidateSceneFloatListArity(listValue.isList(), count, s_SceneQuaternionComponentCount, diagnosticPrefix, filePathText, fieldLabel); }))
        return MakeUnexpected(Failure{});

    const auto& items = listValue.asList();
    const auto x = Core::Assets::ReadMetadataFiniteF32Value(nwbFilePath, items[0], diagnosticPrefix, fieldLabel);
    const auto y = Core::Assets::ReadMetadataFiniteF32Value(nwbFilePath, items[1], diagnosticPrefix, fieldLabel);
    const auto z = Core::Assets::ReadMetadataFiniteF32Value(nwbFilePath, items[2], diagnosticPrefix, fieldLabel);
    const auto w = Core::Assets::ReadMetadataFiniteF32Value(nwbFilePath, items[3], diagnosticPrefix, fieldLabel);
    if(!x || !y || !z || !w)
        return MakeUnexpected(Failure{});

    const auto normalized = TryNormalizeTransformQuaternion(*x, *y, *z, *w);
    if(!normalized){
        AString<Core::Alloc::ScratchArena> convertedFilePathText(scratchArena);
        return ResolveTransformMetadataQuaternion(*x, *y, *z, *w, diagnosticPrefix, Core::Assets::AssetPathsDetail::NativeTextView(nwbFilePath.native(), convertedFilePathText), fieldLabel);
    }
    Float4 result{};
    StoreFloat(normalized.value().value, result);
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_scene_cook_metadata{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace Core::Metascript;

[[nodiscard]] static Expected<SceneAsset::AssetMap> ParseAssetsMap(const Path& nwbFilePath, const Value& mapValue, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    if(!mapValue.isMap() && !Core::Assets::AssetPathsDetail::ValidateWithNativeText(nwbFilePath.native(), scratchArena, [&](const AStringView filePathText){ return ValidateSceneAssetsFieldIsMap(false, filePathText); }))
        return MakeUnexpected(Failure{});

    const auto& map = mapValue.asMap();
    SceneAsset::AssetMap assets(0, Hasher<Name>(), EqualTo<Name>(), arena);
    assets.reserve(map.size());
    for(const auto& [nicknameKey, assetValue] : map){
        const AStringView nicknameView(nicknameKey.data(), nicknameKey.size());
        if(!IsValidSceneAssetNicknameText(nicknameView) && !Core::Assets::AssetPathsDetail::ValidateWithNativeText(nwbFilePath.native(), scratchArena, [&](const AStringView filePathText){ return ValidateSceneAssetNicknameSyntax(nicknameView, filePathText); }))
            return MakeUnexpected(Failure{});
        const auto nickname = Name::FromText(nicknameView);
        if((!nickname.has_value() || !static_cast<b8>(*nickname)) && !Core::Assets::AssetPathsDetail::ValidateWithNativeText(nwbFilePath.native(), scratchArena, [&](const AStringView filePathText){ return ValidateSceneAssetNicknameResolved(false, nicknameView, filePathText); }))
            return MakeUnexpected(Failure{});
        const auto parsedRef = Core::Assets::ReservedAssetRefParser::ParseValue<Core::Assets::IAsset>(nwbFilePath, s_SceneDiagnosticPrefix, nicknameView, assetValue, "entries must be strings", scratchArena);
        if(!parsedRef)
            return MakeUnexpected(Failure{});
        const b8 inserted = assets.emplace(*nickname, *parsedRef).second;
        if(!inserted && !Core::Assets::AssetPathsDetail::ValidateWithNativeText(nwbFilePath.native(), scratchArena, [&](const AStringView filePathText){ return ValidateSceneAssetNicknameUnique(false, nicknameView, filePathText); }))
            return MakeUnexpected(Failure{});
    }
    return assets;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 EntityAssetCodec::serialize(const Core::Assets::IAsset& asset, Core::Assets::AssetBytes& outBinary)const{
    if(!checkSerializeAssetType(asset, s_EntitySerializeContext))
        return false;

    const EntityAsset& entity = *MakeNotNull(checked_cast<const EntityAsset*>(&asset));
    Core::Alloc::ScratchArena scratchArena(s_EntitySerializeArena);
    if(!entity.validatePayload(scratchArena))
        return false;

    return SceneAssetBinaryCodec().serializeEntity(Span<const EntityAsset::ComponentRef>(entity.components()), outBinary);
}

b8 ProjectAssetCodec::serialize(const Core::Assets::IAsset& asset, Core::Assets::AssetBytes& outBinary)const{
    if(!checkSerializeAssetType(asset, s_ProjectSerializeContext))
        return false;

    const ProjectAsset& project = *MakeNotNull(checked_cast<const ProjectAsset*>(&asset));
    if(!project.validatePayload())
        return false;

    return SceneAssetBinaryCodec().serializeProject(project.startScene().name().hash(), outBinary);
}

b8 SceneAssetCodec::serialize(const Core::Assets::IAsset& asset, Core::Assets::AssetBytes& outBinary)const{
    if(!checkSerializeAssetType(asset, s_SceneSerializeContext))
        return false;

    const SceneAsset& scene = *MakeNotNull(checked_cast<const SceneAsset*>(&asset));
    Core::Alloc::ScratchArena scratchArena(s_SceneSerializeArena);
    if(!scene.validatePayload(scratchArena))
        return false;

    return SceneAssetBinaryCodec().serializeScene(
        Span<const SceneAsset::SubsystemRef>(scene.subsystems()),
        Span<const SceneAsset::EntityRef>(scene.entities()),
        scene.assets(),
        outBinary
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ComponentAssetCodec::serialize(const Core::Assets::IAsset& asset, Core::Assets::AssetBytes& outBinary)const{
    return Core::Assets::PolymorphicAssetCodec::SerializePolymorphicAsset<IComponent, &ComponentAssetSerialization::Serialize>(asset, s_ComponentSerializeContext, outBinary);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace ComponentAssetSerialization{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 Serialize(const IComponent& component, Core::Assets::AssetBytes& outBinary){
    if(!component.validatePayload())
        return false;

    auto& assetArena = outBinary.get_allocator().arena();
    Vector<u8, ::ArenaBase> payload(assetArena);
    if(!component.serializeComponentPayload(payload))
        return false;

    ComponentAssetBinaryCodec().packEnvelope(component.assetType().hash(), payload, outBinary);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<TransformComponentCookEntry> SceneComponentMetadataParser::ParseTransform(const Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    using namespace __hidden_scene_cook_components;


    TransformComponentCookEntry entry(arena);
    if(!CheckOptionalMetadataAssetMap(nwbFilePath, asset, s_TransformDiagnosticPrefix, scratchArena))
        return MakeUnexpected(Failure{});
    if(!Core::Assets::AssignCookEntryVirtualPath(virtualPath, nwbFilePath, s_TransformDiagnosticPrefix, entry))
        return MakeUnexpected(Failure{});

    if(asset.isMap()){
        if(!Core::Assets::ValidateMetadataAssetFields(nwbFilePath, asset, s_TransformDiagnosticPrefix, &IsAllowedTransformComponentField))
            return MakeUnexpected(Failure{});

        if(const Core::Metascript::Value* positionValue = asset.findField(s_TransformPositionField)){
            const auto position = ParseFloat3Field(nwbFilePath, s_TransformDiagnosticPrefix, *positionValue, s_TransformPositionField, scratchArena);
            if(!position)
                return MakeUnexpected(Failure{});
            entry.component.position = *position;
        }

        const Core::Metascript::Value* const rotationValue = asset.findField(s_TransformRotationField);
        const Core::Metascript::Value* const eulerValue = asset.findField(s_TransformRotationEulerField);
        const Core::Metascript::Value* const eulerDegreesValue = asset.findField(s_TransformRotationEulerDegreesField);
        const usize rotationFieldCount = CountTransformRotationFields(rotationValue != nullptr, eulerValue != nullptr, eulerDegreesValue != nullptr);
        if(rotationFieldCount > 1u && !Core::Assets::AssetPathsDetail::ValidateWithNativeText(nwbFilePath.native(), scratchArena, [&](const AStringView filePathText){ return ValidateTransformSingleRotationField(rotationFieldCount, filePathText); }))
            return MakeUnexpected(Failure{});
        if(rotationValue){
            const auto rotation = ParseQuaternionField(nwbFilePath, s_TransformDiagnosticPrefix, *rotationValue, s_TransformRotationField, scratchArena);
            if(!rotation)
                return MakeUnexpected(Failure{});
            entry.component.rotation = *rotation;
        }
        else if(eulerValue){
            const auto eulerRadians = ParseFloat3Field(nwbFilePath, s_TransformDiagnosticPrefix, *eulerValue, s_TransformRotationEulerField, scratchArena);
            if(!eulerRadians)
                return MakeUnexpected(Failure{});
            entry.component.rotation = BuildTransformEulerRadiansQuaternion(LoadFloat(*eulerRadians));
        }
        else if(eulerDegreesValue){
            const auto eulerDegrees = ParseFloat3Field(nwbFilePath, s_TransformDiagnosticPrefix, *eulerDegreesValue, s_TransformRotationEulerDegreesField, scratchArena);
            if(!eulerDegrees)
                return MakeUnexpected(Failure{});
            entry.component.rotation = BuildTransformEulerDegreesQuaternion(LoadFloat(*eulerDegrees));
        }

        if(const Core::Metascript::Value* scaleValue = asset.findField(s_TransformScaleField)){
            const auto scale = ParseFloat3Field(nwbFilePath, s_TransformDiagnosticPrefix, *scaleValue, s_TransformScaleField, scratchArena);
            if(!scale)
                return MakeUnexpected(Failure{});
            entry.component.scale = *scale;
        }
    }

    if(!BuildComponentAssetFromEntry<TransformComponentAsset>(entry, arena))
        return MakeUnexpected(Failure{});

    return entry;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<CameraComponentCookEntry> SceneComponentMetadataParser::ParseCamera(const Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    using namespace __hidden_scene_cook_components;


    CameraComponentCookEntry entry(arena);
    if(!CheckOptionalMetadataAssetMap(nwbFilePath, asset, s_CameraDiagnosticPrefix, scratchArena))
        return MakeUnexpected(Failure{});
    if(!Core::Assets::AssignCookEntryVirtualPath(virtualPath, nwbFilePath, s_CameraDiagnosticPrefix, entry))
        return MakeUnexpected(Failure{});

    if(asset.isMap()){
        if(!Core::Assets::ValidateMetadataAssetFields(nwbFilePath, asset, s_CameraDiagnosticPrefix, &IsAllowedCameraComponentField))
            return MakeUnexpected(Failure{});

        const Core::Metascript::Value* const fovDegreesValue = asset.findField(s_CameraVerticalFovDegreesField);
        const Core::Metascript::Value* const fovRadiansValue = asset.findField(s_CameraVerticalFovRadiansField);
        if(fovDegreesValue && fovRadiansValue && !Core::Assets::AssetPathsDetail::ValidateWithNativeText(nwbFilePath.native(), scratchArena, [&](const AStringView filePathText){ return ValidateCameraSingleFovField(true, true, filePathText); }))
            return MakeUnexpected(Failure{});
        if(fovDegreesValue){
            const auto fovDegrees = Core::Assets::ReadMetadataFiniteF32Value(nwbFilePath, *fovDegreesValue, s_CameraDiagnosticPrefix, s_CameraVerticalFovDegreesField);
            if(!fovDegrees)
                return MakeUnexpected(Failure{});
            entry.component.setVerticalFovRadians(ConvertSceneDegreesToRadians(*fovDegrees));
        }
        else if(fovRadiansValue){
            const auto fovRadians = Core::Assets::ReadMetadataFiniteF32Value(nwbFilePath, *fovRadiansValue, s_CameraDiagnosticPrefix, s_CameraVerticalFovRadiansField);
            if(!fovRadians)
                return MakeUnexpected(Failure{});
            entry.component.setVerticalFovRadians(*fovRadians);
        }

        f32 nearPlane = entry.component.nearPlane();
        f32 farPlane = entry.component.farPlane();
        f32 aspectRatio = entry.component.aspectRatio();
        if(
            !Core::Assets::ReadOptionalFiniteF32Field(nwbFilePath, asset, s_CameraDiagnosticPrefix, s_CameraNearPlaneField, nearPlane)
            || !Core::Assets::ReadOptionalFiniteF32Field(nwbFilePath, asset, s_CameraDiagnosticPrefix, s_CameraFarPlaneField, farPlane)
            || !Core::Assets::ReadOptionalFiniteF32Field(nwbFilePath, asset, s_CameraDiagnosticPrefix, s_CameraAspectRatioField, aspectRatio)
        )
            return MakeUnexpected(Failure{});
        entry.component.setNearPlane(nearPlane);
        entry.component.setFarPlane(farPlane);
        entry.component.setAspectRatio(aspectRatio);
    }

    if(!BuildComponentAssetFromEntry<CameraComponentAsset>(entry, arena))
        return MakeUnexpected(Failure{});

    return entry;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<LightComponentCookEntry> SceneComponentMetadataParser::ParseLight(const Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    using namespace __hidden_scene_cook_components;


    LightComponentCookEntry entry(arena);
    if(!CheckOptionalMetadataAssetMap(nwbFilePath, asset, s_LightDiagnosticPrefix, scratchArena))
        return MakeUnexpected(Failure{});
    if(!Core::Assets::AssignCookEntryVirtualPath(virtualPath, nwbFilePath, s_LightDiagnosticPrefix, entry))
        return MakeUnexpected(Failure{});

    if(asset.isMap()){
        if(!Core::Assets::ValidateMetadataAssetFields(nwbFilePath, asset, s_LightDiagnosticPrefix, &IsAllowedLightComponentField))
            return MakeUnexpected(Failure{});

        if(asset.findField(s_LightTypeField)){
            static constexpr Array<::NamedEnumCase<Scene::LightType::Enum>, 3u> s_LightTypeCases = {{
                { s_LightTypeDirectional, Scene::LightType::Directional },
                { s_LightTypePoint, Scene::LightType::Point },
                { s_LightTypeSpot, Scene::LightType::Spot },
            }};
            const auto parsedType = Core::Assets::ParseNamedMetadataEnumField<Scene::LightType::Enum>(
                nwbFilePath,
                asset,
                s_LightDiagnosticPrefix,
                s_LightTypeField,
                Span<const ::NamedEnumCase<Scene::LightType::Enum>>(s_LightTypeCases.data(), s_LightTypeCases.size()),
                s_LightTypeHint
            );
            if(!parsedType)
                return MakeUnexpected(Failure{});
            entry.component.type = *parsedType;
        }

        if(const Core::Metascript::Value* colorValue = asset.findField(s_LightColorField)){
            const auto color = ParseFloat3Field(nwbFilePath, s_LightDiagnosticPrefix, *colorValue, s_LightColorField, scratchArena);
            if(!color)
                return MakeUnexpected(Failure{});
            entry.component.setColor(LoadFloat(*color));
        }

        f32 intensity = entry.component.intensity();
        if(
            !Core::Assets::ReadOptionalFiniteF32Field(nwbFilePath, asset, s_LightDiagnosticPrefix, s_LightIntensityField, intensity)
            || !Core::Assets::ReadOptionalFiniteF32Field(nwbFilePath, asset, s_LightDiagnosticPrefix, s_LightRangeField, entry.component.range)
            || !Core::Assets::ReadOptionalFiniteF32Field(nwbFilePath, asset, s_LightDiagnosticPrefix, s_LightInnerConeCosField, entry.component.innerConeCos)
            || !Core::Assets::ReadOptionalFiniteF32Field(nwbFilePath, asset, s_LightDiagnosticPrefix, s_LightOuterConeCosField, entry.component.outerConeCos)
            || !Core::Assets::ReadOptionalFiniteF32Field(nwbFilePath, asset, s_LightDiagnosticPrefix, s_LightAngularRadiusField, entry.component.angularRadius)
            || !Core::Assets::ReadOptionalFiniteF32Field(nwbFilePath, asset, s_LightDiagnosticPrefix, s_LightSourceRadiusField, entry.component.sourceRadius)
        )
            return MakeUnexpected(Failure{});
        entry.component.setIntensity(intensity);

        if(const Core::Metascript::Value* enableCausticsValue = asset.findField(s_LightEnableCausticsField)){
            const auto enableCaustics = Core::Assets::ParseMetadataBoolField(nwbFilePath, s_LightDiagnosticPrefix, *enableCausticsValue, s_LightEnableCausticsField);
            if(!enableCaustics)
                return MakeUnexpected(Failure{});
            entry.component.enableCaustics = *enableCaustics;
        }
    }

    if(!BuildComponentAssetFromEntry<LightComponentAsset>(entry, arena))
        return MakeUnexpected(Failure{});

    return entry;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<EntityCookEntry> ParseEntityCookMetadata(const Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    using namespace __hidden_scene_cook_metadata;

    EntityCookEntry entry(arena);
    if(!Core::Assets::CheckMetadataAssetMap(nwbFilePath, asset, s_EntityDiagnosticPrefix))
        return MakeUnexpected(Failure{});
    if(!Core::Assets::AssignCookEntryVirtualPath(virtualPath, nwbFilePath, s_EntityDiagnosticPrefix, entry))
        return MakeUnexpected(Failure{});
    if(!Core::Assets::ValidateMetadataAssetFields(nwbFilePath, asset, s_EntityDiagnosticPrefix, &IsAllowedEntityAssetField))
        return MakeUnexpected(Failure{});

    const Core::Metascript::Value* componentsValue = asset.findField(s_EntityComponentsField);
    if(!componentsValue && !Core::Assets::AssetPathsDetail::ValidateWithNativeText(nwbFilePath.native(), scratchArena, [&](const AStringView filePathText){ return ValidateRequiredSceneMetadataField(false, s_EntityDiagnosticPrefix, filePathText, s_EntityComponentsField); }))
        return MakeUnexpected(Failure{});
    auto components = Core::Assets::ReservedAssetRefParser::ParseList<IComponent>(nwbFilePath, s_EntityDiagnosticPrefix, *componentsValue, s_EntityComponentsField, arena, scratchArena);
    if(!components)
        return MakeUnexpected(Failure{});

    EntityAsset candidate(arena, entry.virtualPath);
    candidate.setComponents(Move(*components));
    if(!candidate.validatePayload(scratchArena))
        return MakeUnexpected(Failure{});
    entry.components = candidate.takeComponents(arena);

    return entry;
}

Expected<EntityAsset> BuildEntityAsset(EntityCookEntry& entry, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    EntityAsset asset(arena, entry.virtualPath);
    asset.setComponents(Move(entry.components));
    if(!asset.validatePayload(scratchArena))
        return MakeUnexpected(Failure{});
    return asset;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<ProjectCookEntry> ParseProjectCookMetadata(const Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    using namespace __hidden_scene_cook_metadata;

    ProjectCookEntry entry(arena);
    if(!Core::Assets::CheckMetadataAssetMap(nwbFilePath, asset, s_ProjectDiagnosticPrefix))
        return MakeUnexpected(Failure{});
    if(!Core::Assets::AssignCookEntryVirtualPath(virtualPath, nwbFilePath, s_ProjectDiagnosticPrefix, entry))
        return MakeUnexpected(Failure{});
    if(!Core::Assets::ValidateMetadataAssetFields(nwbFilePath, asset, s_ProjectDiagnosticPrefix, &IsAllowedProjectAssetField))
        return MakeUnexpected(Failure{});

    const auto startSceneField = Core::Assets::ReadMetadataStringField(nwbFilePath, asset, s_ProjectDiagnosticPrefix, s_SceneStartSceneField, true);
    if(!startSceneField)
        return MakeUnexpected(Failure{});
    const auto startSceneRef = Core::Assets::ReservedAssetRefParser::ParseText<SceneAsset>(nwbFilePath, s_ProjectDiagnosticPrefix, s_SceneStartSceneField, startSceneField->text, scratchArena);
    if(!startSceneRef)
        return MakeUnexpected(Failure{});
    entry.startScene = *startSceneRef;

    ProjectAsset candidate(arena, entry.virtualPath);
    candidate.setStartScene(entry.startScene);
    if(!candidate.validatePayload())
        return MakeUnexpected(Failure{});

    return entry;
}

Expected<ProjectAsset> BuildProjectAsset(ProjectCookEntry& entry, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena&){
    ProjectAsset asset(arena, entry.virtualPath);
    asset.setStartScene(entry.startScene);
    if(!asset.validatePayload())
        return MakeUnexpected(Failure{});
    return asset;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<SceneCookEntry> ParseSceneCookMetadata(const Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    using namespace __hidden_scene_cook_metadata;

    SceneCookEntry entry(arena);
    if(!Core::Assets::CheckMetadataAssetMap(nwbFilePath, asset, s_SceneDiagnosticPrefix))
        return MakeUnexpected(Failure{});
    if(!Core::Assets::AssignCookEntryVirtualPath(virtualPath, nwbFilePath, s_SceneDiagnosticPrefix, entry))
        return MakeUnexpected(Failure{});
    if(!Core::Assets::ValidateMetadataAssetFields(nwbFilePath, asset, s_SceneDiagnosticPrefix, &IsAllowedSceneAssetField))
        return MakeUnexpected(Failure{});

    const Core::Metascript::Value* subsystemsValue = asset.findField(s_SceneSubsystemsField);
    if(!subsystemsValue && !Core::Assets::AssetPathsDetail::ValidateWithNativeText(nwbFilePath.native(), scratchArena, [&](const AStringView filePathText){ return ValidateRequiredSceneMetadataField(false, s_SceneDiagnosticPrefix, filePathText, s_SceneSubsystemsField); }))
        return MakeUnexpected(Failure{});
    auto subsystems = Core::Assets::ReservedAssetRefParser::ParseList<ISubsystem>(nwbFilePath, s_SceneDiagnosticPrefix, *subsystemsValue, s_SceneSubsystemsField, arena, scratchArena);
    if(!subsystems)
        return MakeUnexpected(Failure{});
    DeduplicateSubsystemRefs(*subsystems);
    entry.subsystems.assign(subsystems->begin(), subsystems->end());

    if(const Core::Metascript::Value* entitiesValue = asset.findField(s_SceneEntitiesField)){
        auto entities = Core::Assets::ReservedAssetRefParser::ParseList<EntityAsset>(nwbFilePath, s_SceneDiagnosticPrefix, *entitiesValue, s_SceneEntitiesField, arena, scratchArena);
        if(!entities)
            return MakeUnexpected(Failure{});
        entry.entities.assign(entities->begin(), entities->end());
    }

    if(const Core::Metascript::Value* assetsValue = asset.findField(s_SceneAssetsField)){
        auto assets = ParseAssetsMap(nwbFilePath, *assetsValue, arena, scratchArena);
        if(!assets)
            return MakeUnexpected(Failure{});
        entry.assets = Move(*assets);
    }

    SceneAsset candidate(arena, entry.virtualPath);
    candidate.setContents(Move(entry.subsystems), Move(entry.assets), Move(entry.entities));
    if(!candidate.validatePayload(scratchArena))
        return MakeUnexpected(Failure{});
    candidate.takeContents(entry.subsystems, entry.assets, entry.entities);

    return entry;
}

Expected<SceneAsset> BuildSceneAsset(SceneCookEntry& entry, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    SceneAsset asset(arena, entry.virtualPath);
    asset.setContents(Move(entry.subsystems), Move(entry.assets), Move(entry.entities));
    if(!asset.validatePayload(scratchArena))
        return MakeUnexpected(Failure{});
    return asset;
}


