            this.m_physicsWorld.overlapAabb(queryBox, filter, hitSensors, ignoreBodyId, rawShapes);
        else
            this.m_physicsWorld.overlapAabb(queryBox, filter, hitSensors, ignoreBodyId, ignoreShapeId, ShapeQueryFilterCallback(lambda[](in ShapeId id) -> b8{ return true; }), rawShapes);
