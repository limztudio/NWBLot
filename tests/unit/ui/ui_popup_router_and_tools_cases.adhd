class PopupToolsCaseFixture : public PopupToolsFixture{
public:
    [[nodiscard]] b8 hasTarget(const WidgetId widget)const noexcept{
        return target(widget) != nullptr;
    }

    [[nodiscard]] Expected<HitTarget> findTarget(const WidgetId widget)const noexcept{
        const HitTarget* hit = target(widget);
        if(!hit)
            return MakeUnexpected(Failure{});
        return *hit;
    }

    [[nodiscard]] b8 hasMenuHost()const noexcept{
        return menuHost() != nullptr;
    }

    [[nodiscard]] Expected<HitTarget> findMenuHost()const noexcept{
        const HitTarget* hit = menuHost();
        if(!hit)
            return MakeUnexpected(Failure{});
        return *hit;
    }

    [[nodiscard]] Expected<HitTarget> findMenuRow(const u64 key)const noexcept{
        const HitTarget* hit = menuRow(key);
        if(!hit)
            return MakeUnexpected(Failure{});
        return *hit;
    }

    void armCloseMenuOnText()noexcept{
        m_source.closeOnText = &m_menu;
    }

    void armResetTooltipOnText()noexcept{
        m_source.resetTooltipOnText = &m_tooltip;
    }

    void armSelectListOnText(ListState& list, const u64 key)noexcept{
        m_source.selectListOnText = &list;
        m_source.selectListKey = key;
    }

    [[nodiscard]] b8 hasSelectListOnText()const noexcept{
        return m_source.selectListOnText != nullptr;
    }

    [[nodiscard]] b8 hasCloseComboOnRevision()const noexcept{
        return m_source.closeComboOnRevision != nullptr;
    }
};


