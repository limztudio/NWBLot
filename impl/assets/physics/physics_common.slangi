[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWStructuredBuffer<NwbPhysicsGpuBroadphasePair, Std430DataLayout> g_NwbPhysicsBroadphasePairBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWStructuredBuffer<NwbPhysicsGpuNarrowphaseManifold, Std430DataLayout> g_NwbPhysicsNarrowphaseManifoldBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWStructuredBuffer<NwbPhysicsGpuContactConstraint, Std430DataLayout> g_NwbPhysicsContactConstraintBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWStructuredBuffer<NwbPhysicsGpuJointConstraint, Std430DataLayout> g_NwbPhysicsJointConstraintBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWStructuredBuffer<NwbPhysicsGpuBodyOut, Std430DataLayout> g_NwbPhysicsBodyOutBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWStructuredBuffer<NwbPhysicsGpuContactImpulseOut, Std430DataLayout> g_NwbPhysicsContactImpulseOutBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWStructuredBuffer<NwbPhysicsGpuJointImpulseOut, Std430DataLayout> g_NwbPhysicsJointImpulseOutBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWStructuredBuffer<NwbPhysicsGpuIslandSlice, Std430DataLayout> g_NwbPhysicsIslandSliceBuffers[];
#pragma warning(pop)


