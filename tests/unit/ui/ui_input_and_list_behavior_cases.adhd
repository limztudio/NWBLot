void VerifyUiInputTests_TabOrderWrapsInBothDirectionsAndSkipsDisabledOrInvisibleTargets(mut UiInputTests self){
    Array<HitTarget, 5u> targets = Array<HitTarget, 5u>();
    targets[0u] = MakeUiInputTarget(1u);
    targets[1u] = MakeUiInputTarget(2u);
    targets[2u] = MakeUiInputTarget(3u);
    targets[3u] = MakeUiInputTarget(4u);
    targets[4u] = MakeUiInputTarget(5u);
    targets[1u].enabled = false;
    targets[2u].focusable = false;
    targets[3u].clip = Rect(90.0f, 90.0f, 10.0f, 10.0f);
    targets[0u].paintOrder = 100u;
    targets[4u].paintOrder = 0u;
    ASSERT_TRUE(self.commitSpan(targets, 1u));
    self.tab();
    EXPECT_EQ(self.m_router.focus().value, 1u);
    self.tab();
    EXPECT_EQ(self.m_router.focus().value, 5u);
    self.tab();
    EXPECT_EQ(self.m_router.focus().value, 1u);
    self.tab(true);
    EXPECT_EQ(self.m_router.focus().value, 5u);
    self.tab(true);
    EXPECT_EQ(self.m_router.focus().value, 1u);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Escape, false)).commandConsumed);
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, CoreKey::Escape, false)).commandConsumed);
    self.tab(true);
    EXPECT_EQ(self.m_router.focus().value, 5u);
    ASSERT_TRUE(self.commitEmpty(2u));
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Tab, false)).commandConsumed);
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyUp, CoreKey::Tab, false)).commandConsumed);
}

void VerifyUiInputTests_KeyboardActivationIgnoresNativeRepeatsAndDuplicateDowns(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    self.tab();
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Enter, false)).commandConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.m_router.pressed(target.id));
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Enter, true)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Enter, false)).commandConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.process().commandConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, CoreKey::Enter, false)).commandConsumed);
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_EQ(self.m_router.actions()[0u].origin, InputActionSource::Command);
    EXPECT_FALSE(self.m_router.pressed(target.id));
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Enter, false)).commandConsumed);
    EXPECT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, CoreKey::Enter, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Space, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, CoreKey::Space, false)).commandConsumed);
    EXPECT_EQ(self.m_router.actions().size(), 3u);
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Space, true)).commandConsumed);
    EXPECT_EQ(self.m_router.actions().size(), 3u);
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyUp, CoreKey::Space, false)).commandConsumed);
    ASSERT_TRUE(self.commitEmpty(2u));
    EXPECT_TRUE(self.m_router.actions().empty());
}

void VerifyUiInputTests_HeldUiKeysKeepReleaseOwnershipAfterFocusedTargetRemoval(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    self.tab();
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Space, false)).commandConsumed);
    ASSERT_TRUE(self.commitEmpty(2u));
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_TRUE(self.m_router.actions().empty());
    const InputRoutingResult repeated = self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Space, true));
    EXPECT_TRUE(repeated.commandConsumed);
    EXPECT_TRUE(repeated.wantsCommands);
    EXPECT_TRUE(self.m_router.actions().empty());
    const InputRoutingResult released = self.send(MakeUiInputKey(InputEventType::KeyUp, CoreKey::Space, false));
    EXPECT_TRUE(released.commandConsumed);
    EXPECT_FALSE(released.wantsCommands);
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Space, false)).commandConsumed);
}

void VerifyUiInputTests_ClearingKeyboardFocusPreservesAcceptedActionsCaptureAndHeldReleaseOwnership(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    self.click();
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Space, false)).commandConsumed);
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_TRUE(self.m_router.ownsKey(CoreKey::Space));
    EXPECT_FALSE(self.m_router.ownsKey(CoreKey::Unknown));
    EXPECT_FALSE(self.m_router.ownsKey(CoreKey::Menu + 1));
    self.m_router.clearFocus();
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_TRUE(self.m_router.ownsKey(CoreKey::Space));
    EXPECT_EQ(self.m_router.capture().value, 1u);
    EXPECT_TRUE(self.m_router.primaryDown());
    EXPECT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, CoreKey::Space, false)).commandConsumed);
    EXPECT_FALSE(self.m_router.ownsKey(CoreKey::Space));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    ASSERT_EQ(self.m_router.actions().size(), 2u);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
}

void VerifyUiInputTests_NativeFocusTerminationAndResetDoNotReuseActionSequences(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    self.click();
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    const u64 firstSequence = self.m_router.actions()[0u].id.sequence;
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Space, false)).commandConsumed);
    const InputRoutingResult lost = self.send(MakeUiInputBareEvent(InputEventType::FocusLost));
    EXPECT_TRUE(lost.pointerConsumed);
    EXPECT_TRUE(lost.commandConsumed);
    EXPECT_TRUE(lost.wantsPointer);
    EXPECT_TRUE(lost.wantsCommands);
    EXPECT_FALSE(lost.hover.valid());
    EXPECT_FALSE(lost.focus.valid());
    EXPECT_FALSE(lost.capture.valid());
    EXPECT_TRUE(self.m_router.primaryDown());
    EXPECT_TRUE(self.m_router.ownsKey(CoreKey::Space));
    EXPECT_TRUE(self.m_router.actions().empty());
    self.m_router.cancelDeviceInput(0u);
    EXPECT_FALSE(self.m_router.primaryDown());
    EXPECT_FALSE(self.m_router.ownsKey(CoreKey::Space));
    EXPECT_FALSE(self.m_router.wantsPointer());
    EXPECT_FALSE(self.m_router.wantsCommands());
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyUp, CoreKey::Space, false)).commandConsumed);
    EXPECT_FALSE(self.send(MakeUiInputPointerAt(InputEventType::PrimaryUp, Point(90.0f, 90.0f))).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    ASSERT_TRUE(self.queueNative(MakeUiInputPointer(InputEventType::PrimaryDown)));
    self.m_router.reset();
    EXPECT_EQ(self.m_router.layoutGeneration(), 0u);
    EXPECT_TRUE(self.m_router.targets().empty());
    EXPECT_FALSE(self.m_router.process().pointerConsumed);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    EXPECT_FALSE(self.send(MakeUiInputPointerAt(InputEventType::PrimaryUp, Point(90.0f, 90.0f))).pointerConsumed);
    self.send(MakeUiInputBareEvent(InputEventType::FocusGained));
    self.click();
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_GT(self.m_router.actions()[0u].id.sequence, firstSequence);
}

void VerifyUiInputTests_EventsUseCommittedTargetsAndScenePressCannotTransferToNewLayout(mut UiInputTests self){
    const HitTarget oldTarget = MakeUiInputTarget(1u);
    HitTarget nextTarget = MakeUiInputTargetAt(2u, Rect(40.0f, 10.0f, 20.0f, 20.0f));
    ASSERT_TRUE(self.commitSingle(oldTarget, 1u));
    EXPECT_FALSE(self.m_router.hitTest(Point(45.0f, 15.0f)).valid());
    EXPECT_FALSE(self.send(MakeUiInputPointerAt(InputEventType::PrimaryDown, Point(45.0f, 15.0f))).pointerConsumed);
    ASSERT_TRUE(self.commitSingle(nextTarget, 2u));
    EXPECT_EQ(self.m_router.hitTest(Point(45.0f, 15.0f)).value, 2u);
    EXPECT_FALSE(self.send(MakeUiInputPointerAt(InputEventType::PrimaryUp, Point(45.0f, 15.0f))).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    self.click(Point(45.0f, 15.0f));
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_EQ(self.m_router.actions()[0u].id.target.value, 2u);
    EXPECT_EQ(self.m_router.actions()[0u].id.layoutGeneration, 2u);
    nextTarget.rectangle.x = 60.0f;
    ASSERT_TRUE(self.commitSingle(nextTarget, 3u));
    EXPECT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_TRUE(self.m_router.consumeActivation(nextTarget.id));
}

void VerifyUiInputTests_InvalidTargetPublicationPreservesAcceptedLayoutCaptureAndFocus(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    Array<HitTarget, 2u> invalid = Array<HitTarget, 2u>();
    invalid[0u] = MakeUiInputTarget(2u);
    invalid[1u] = MakeUiInputTarget(2u);
    EXPECT_FALSE(self.commitSpan(invalid, 2u));
    invalid[1u].id.value = 3u;
    invalid[1u].rectangle.width = -1.0f;
    EXPECT_FALSE(self.commitSpan(invalid, 2u));
    invalid[1u].rectangle.width = UiInputLayoutInfinityF32();
    EXPECT_FALSE(self.commitSpan(invalid, 2u));
    invalid[1u].rectangle = Rect(0.0f, 0.0f, 1.0f, 1.0f);
    invalid[1u].declarationGeneration = 0u;
    EXPECT_FALSE(self.commitSpan(invalid, 2u));
    invalid[1u].declarationGeneration = 1u;
    invalid[1u].id.value = 0u;
    EXPECT_FALSE(self.commitSpan(invalid, 2u));
    EXPECT_FALSE(self.commitOverflowSingle(target, s_InputMaxTargets + 1u, 2u));
    EXPECT_FALSE(self.commitSingle(target, 0u));
    EXPECT_FALSE(self.commitSingle(target, 1u));
    EXPECT_EQ(self.m_router.layoutGeneration(), 1u);
    ASSERT_EQ(self.m_router.targets().size(), 1u);
    EXPECT_EQ(self.m_router.focus().value, 1u);
    EXPECT_EQ(self.m_router.capture().value, 1u);
    EXPECT_EQ(self.m_router.hitTest(Point(15.0f, 15.0f)).value, 1u);
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
}

void VerifyUiInputTests_TargetAndEventLimitsRejectOverflowAndAllowSubsequentProcessing(mut UiInputTests self){
    Vector<HitTarget> targets = Vector<HitTarget>();
    targets.reserve(s_InputMaxTargets);
    for(usize index = 0u; index < s_InputMaxTargets; ++index){
        targets.push_back(MakeUiInputTarget(cast<u64>(index) + 1u));
    }
    ASSERT_TRUE(self.commitSpan(targets, 1u));
    EXPECT_FALSE(self.commitOverflowSpan(targets, 2u));
    EXPECT_EQ(self.m_router.targets().size(), s_InputMaxTargets);
    for(usize index = 0u; index < s_InputMaxEvents; ++index){
        ASSERT_TRUE(self.queueNative(MakeUiInputPointer(InputEventType::PointerMove)));
    }
    EXPECT_FALSE(self.queueNative(MakeUiInputPointer(InputEventType::PointerMove)));
    EXPECT_TRUE(self.m_router.process().pointerConsumed);
    EXPECT_EQ(self.m_router.hover().value, s_InputMaxTargets);
    EXPECT_FALSE(self.queueNative(MakeUiInputPointerAt(InputEventType::PointerMove, Point(UiInputLayoutQuietNaNF32(), 1.0f))));
    EXPECT_FALSE(self.queueNative(MakeUiInputBareEvent(bit_cast<InputEventTypeEnum>(u8(255u)))));
    EXPECT_FALSE(self.queueNative(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Unknown, false)));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PointerMove)).pointerConsumed);
}

void VerifyUiInputTests_ActionLimitReportsOverflowWithoutReplayingDroppedInput(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    self.tab();
    for(usize index = 0u; index < s_InputMaxActions; ++index){
        const InputRoutingResult activated = self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Enter, false));
        EXPECT_TRUE(activated.commandConsumed);
        EXPECT_FALSE(activated.activationOverflow);
        EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, CoreKey::Enter, false)).commandConsumed);
    }
    ASSERT_EQ(self.m_router.actions().size(), s_InputMaxActions);
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Enter, false)).activationOverflow);
    const InputRoutingResult overflow = self.send(MakeUiInputKey(InputEventType::KeyUp, CoreKey::Enter, false));
    EXPECT_TRUE(overflow.commandConsumed);
    EXPECT_TRUE(overflow.activationOverflow);
    EXPECT_EQ(self.m_router.actions().size(), s_InputMaxActions);
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyUp, CoreKey::Enter, false)).commandConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.m_router.process().activationOverflow);
    EXPECT_EQ(self.m_router.actions().size(), s_InputMaxActions - 1u);
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Enter, false)).activationOverflow);
    EXPECT_EQ(self.m_router.actions().size(), s_InputMaxActions - 1u);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, CoreKey::Enter, false)).commandConsumed);
    EXPECT_EQ(self.m_router.actions().size(), s_InputMaxActions);
}

void VerifyUiInputTests_EscapeCancelsPointerPressEvenWhenATextEditorKeepsFocus(mut UiInputTests self){
    HitTarget target = MakeUiInputTarget(1u);
    target.textEditable = true;
    ASSERT_TRUE(self.commitSingle(target, 1u));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.m_router.pressed(target.id));
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Escape, false)).commandConsumed);
    EXPECT_EQ(self.m_router.focus(), target.id);
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_FALSE(self.m_router.pressed(target.id));
    EXPECT_TRUE(self.m_router.primaryDown());
    EXPECT_TRUE(self.send(MakeUiInputPointerAt(InputEventType::PointerMove, Point(90.0f, 90.0f))).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, CoreKey::Escape, false)).commandConsumed);
    self.click();
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
}

void VerifyUiInputTests_NativeCaptureLossTerminatesPointerOwnershipWithoutSubmitting(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiInputBareEvent(InputEventType::PointerCaptureLost)).pointerConsumed);
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_FALSE(self.m_router.primaryDown());
    EXPECT_FALSE(self.m_router.wantsPointer());
    EXPECT_FALSE(self.send(MakeUiInputPointerAt(InputEventType::PrimaryUp, Point(150.0f, 150.0f))).pointerConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.send(MakeUiInputPointerAt(InputEventType::PrimaryUp, Point(150.0f, 150.0f))).pointerConsumed);
}

void VerifyUiInputTests_NativeCaptureTerminationAdmitsFreshClicksWithoutCancellingCompletedActionsOrKeys(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    self.click();
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Space, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiInputBareEvent(InputEventType::PointerCaptureLost)).pointerConsumed);
    EXPECT_FALSE(self.m_router.primaryDown());
    EXPECT_FALSE(self.m_router.secondaryDown());
    EXPECT_TRUE(self.m_router.ownsKey(CoreKey::Space));
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    self.click();
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, CoreKey::Space, false)).commandConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
}

void VerifyUiInputTests_NativeFocusTerminationDropsMissingNativeReleasesButPreservesControllerOwnership(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Space, false)).commandConsumed);
    InputEvent controller = InputEvent();
    controller.type = InputEventType::CommandDown;
    controller.source = InputSource(7u, 3u);
    controller.command = InputCommand::Activate;
    EXPECT_TRUE(self.send(controller).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiInputBareEvent(InputEventType::FocusLost)).commandConsumed);
    self.m_router.cancelDeviceInput(0u);
    EXPECT_FALSE(self.m_router.primaryDown());
    EXPECT_FALSE(self.m_router.ownsKey(CoreKey::Space));
    EXPECT_TRUE(self.m_router.ownsSource(controller.source));
    EXPECT_TRUE(self.m_router.actions().empty());
    self.send(MakeUiInputBareEvent(InputEventType::FocusGained));
    self.click();
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Space, false)).commandConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, CoreKey::Space, false)).commandConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    controller.type = InputEventType::CommandUp;
    controller.command = InputCommand::None;
    EXPECT_TRUE(self.send(controller).commandConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.m_router.ownsSource(controller.source));
}


