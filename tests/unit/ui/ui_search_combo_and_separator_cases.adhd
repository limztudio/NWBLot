    EXPECT_EQ(self.m_state.query().externalRevision(), externalRevision);
    EXPECT_EQ(self.m_state.query().anchor(), 0u);
    EXPECT_EQ(self.m_state.query().caret(), 4u);
    EXPECT_EQ(self.m_state.combo().listState().inputGeneration(), previewGeneration);
}

void VerifyUiSearchComboBehaviorTests_CompositionBeginCancelCycleCannotRestoreAnOldFilterLoan(mut UiSearchComboBehaviorTests self){
    ASSERT_TRUE(self.m_state.query().setText("tail"));
    const u64 compositionGeneration = self.m_state.query().compositionGeneration();
    const u64 previewGeneration = self.m_state.combo().listState().inputGeneration();
    self.m_source.onFilter = UiSearchComboBehaviorMutation::CompositionCycle;
