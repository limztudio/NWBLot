void VerifyUiPopupToolsBuilderTests_InvalidTooltipSizeRejectsBeforeScopeEnd(mut UiPopupToolsBuilderTests self){
    self.m_tooltipOptions.maximumWidth = bit_cast<f32>(0x7fc00000u);
    EXPECT_FALSE(self.declareTools(1u, true, false));
    EXPECT_TRUE(self.m_context.failed());
}

void VerifyUiPopupToolsBuilderTests_OneTooltipStateCannotOwnTwoAttachmentsInTheSameFrame(mut UiPopupToolsBuilderTests self){
    ASSERT_TRUE(self.declareTools(1u, true, false));
    EXPECT_FALSE(self.m_builder.button("second", "Second", self.m_anchorOptions));
    EXPECT_FALSE(self.m_builder.tooltip("other", "second", "Other help", self.m_tooltip, self.m_tooltipOptions));
    EXPECT_TRUE(self.m_context.failed());
}

void VerifyUiPopupToolsBuilderTests_ExplicitTooltipResetBeforeScopeEndRejectsItsBorrowedCandidate(mut UiPopupToolsBuilderTests self){
    ASSERT_TRUE(self.acceptTools(1u, true, false));
    ASSERT_TRUE(self.declareTools(2u, true, false));
    const u64 revision = self.m_tooltip.revision();
    self.m_tooltip.reset();
    EXPECT_GT(self.m_tooltip.revision(), revision);
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    EXPECT_FALSE(self.m_tooltip.visible());
}

void VerifyUiPopupToolsBuilderTests_SecondaryTriggerUsesOnlyTheExactlyAcceptedAnchorLayout(mut UiPopupToolsBuilderTests self){
    ASSERT_TRUE(self.prepareTools(1u, false));
    EXPECT_FALSE(self.send(MakeUiPopupRouterPointerEvent(InputEventType::SecondaryDown, 30.0f, 30.0f)).pointerConsumed);
    EXPECT_FALSE(self.send(MakeUiPopupRouterPointerEvent(InputEventType::SecondaryUp, 30.0f, 30.0f)).pointerConsumed);
    EXPECT_FALSE(self.m_menu.isOpen());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    ASSERT_TRUE(self.openBySecondary(2u));
    EXPECT_TRUE(self.m_menuResult.opened);
    EXPECT_FALSE(self.m_menuResult.activated);
    EXPECT_FALSE(self.m_anchorActivated);
    EXPECT_TRUE(self.m_context.input().hasPopup());
    ASSERT_TRUE(self.hasMenuHost());
}

void VerifyUiPopupToolsBuilderTests_EscapeBeforeSecondaryReleaseCancelsThePendingContextMenu(mut UiPopupToolsBuilderTests self){
    ASSERT_TRUE(self.acceptTools(1u, false));
    ASSERT_TRUE(self.moveToAnchor());
    const Point point = self.m_context.input().pointerPosition();
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointEvent(InputEventType::SecondaryDown, point)).pointerConsumed);
    ASSERT_TRUE(self.acceptTools(2u, false));
    EXPECT_FALSE(self.m_menu.isOpen());
    EXPECT_FALSE(self.m_menuResult.opened);
    self.press(Key::Escape);
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointEvent(InputEventType::SecondaryUp, point)).pointerConsumed);
    ASSERT_TRUE(self.acceptTools(3u, false));
    EXPECT_FALSE(self.m_menu.isOpen());
    EXPECT_FALSE(self.m_menuResult.opened);
    EXPECT_FALSE(self.m_menuResult.activated);
    EXPECT_FALSE(self.m_anchorActivated);
    self.secondaryClick(point);
    ASSERT_TRUE(self.acceptTools(4u, false));
    EXPECT_TRUE(self.m_menu.isOpen());
    EXPECT_TRUE(self.m_menuResult.opened);
}

void VerifyUiPopupToolsBuilderTests_OrdinaryPrimaryActivationDoesNotOpenAnAttachedContextMenu(mut UiPopupToolsBuilderTests self){
    ASSERT_TRUE(self.acceptTools(1u, false));
    ASSERT_TRUE(self.moveToAnchor());
    self.click(self.m_context.input().pointerPosition());
    ASSERT_TRUE(self.acceptTools(2u, false));
    EXPECT_TRUE(self.m_anchorActivated);
    EXPECT_FALSE(self.m_menuResult.opened);
    EXPECT_FALSE(self.m_menu.isOpen());
}

void VerifyUiPopupToolsBuilderTests_KeyboardPreviewSkipsDisabledCommandsAndEnterCommitsItsStableKey(mut UiPopupToolsBuilderTests self){
    ASSERT_TRUE(self.acceptTools(1u, false));
    ASSERT_TRUE(self.openBySecondary(2u));
    self.press(Key::Down);
    self.press(Key::Down);
    ASSERT_TRUE(self.acceptTools(3u, false));
    EXPECT_EQ(self.m_menu.cursorKey(), 4u);
    EXPECT_FALSE(self.m_menuResult.activated);
    self.press(Key::Enter);
    ASSERT_TRUE(self.acceptTools(4u, false));
    EXPECT_TRUE(self.m_menuResult.activated);
    EXPECT_EQ(self.m_menuResult.key, 4u);
    EXPECT_TRUE(self.m_menuResult.closed);
    EXPECT_FALSE(self.m_menu.isOpen());
    EXPECT_FALSE(self.m_context.input().hasPopup());
}

void VerifyUiPopupToolsBuilderTests_PointerReleaseCommitsOnlyAnEnabledCommand(mut UiPopupToolsBuilderTests self){
    ASSERT_TRUE(self.acceptTools(1u, false));
    ASSERT_TRUE(self.openBySecondary(2u));
    const auto disabled = self.findMenuRow(3u);
    ASSERT_TRUE(disabled.has_value());
    EXPECT_FALSE(disabled.value().enabled);
    self.click(CenterUiRect(disabled.value().rectangle));
    ASSERT_TRUE(self.acceptTools(3u, false));
    EXPECT_FALSE(self.m_menuResult.activated);
    ASSERT_TRUE(self.m_menu.isOpen());
    const auto enabled = self.findMenuRow(5u);
    ASSERT_TRUE(enabled.has_value());
    self.click(CenterUiRect(enabled.value().rectangle));
    ASSERT_TRUE(self.acceptTools(4u, false));
    EXPECT_TRUE(self.m_menuResult.activated);
    EXPECT_EQ(self.m_menuResult.key, 5u);
    EXPECT_FALSE(self.m_menu.isOpen());
}

void VerifyUiPopupToolsBuilderTests_OutsideClickCancelsAndConsumesTheCompletePointerSequence(mut UiPopupToolsBuilderTests self){
    ASSERT_TRUE(self.acceptTools(1u, false));
    ASSERT_TRUE(self.openBySecondary(2u));
