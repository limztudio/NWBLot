NWB_BEGIN
namespace UiNumericEditTests{
NWB_INLINE EditBoxResult NumericHost::editActions(const WidgetState&, const EditBoxOptions& options, const PopupToken& popup, EditModel& draft, IEditActionSink& sink){
    ++loans;
    lastPopup = popup;
    EditBoxResult result;
    result.valid = true;
    result.focused = options.enabled && focused;
    const u64 revision = draft.revision();
    const usize anchor = draft.anchor();
    const usize caret = draft.caret();
    for(const auto& event : m_events){
        if(!::__hidden_ui_glyph_sdf_tests::ApplyNumericHostEvent(event, options, draft, sink, result))
            break;
    }
    m_events.clear();
    if(onLoanInteger)
        mutationApplied = onLoanInteger->setValue(mutationValue);
    if(resetBuilder)
        resetBuilder->reset();
    result.textChanged = revision != draft.revision();
    result.selectionChanged = anchor != draft.anchor() || caret != draft.caret();
    return result;
}
};
namespace UiNumericTests{
NWB_INLINE void ExpectRejected(const NumericEditResult& result, const b8 restored){
    ::__hidden_ui_glyph_sdf_tests::ExpectNumericEditRejected(result, restored);
}
};
namespace UiPopupToolsTests{
NWB_INLINE StringView PopupToolsSource::text(const u64 index)const noexcept{
    if(changeRevisionOnText){
        changeRevisionOnText = false;
        ++contentRevision;
    }
    if(closeOnText){
        ContextMenuState& state = *MakeNotNull(Exchange(closeOnText, nullptr));
        state.close();
    }
    if(resetTooltipOnText){
        TooltipState& state = *MakeNotNull(Exchange(resetTooltipOnText, nullptr));
        state.reset();
    }
    if(selectListOnText){
        ListState& state = *MakeNotNull(Exchange(selectListOnText, nullptr));
        state.select(selectListKey);
    }
    return ::__hidden_ui_glyph_sdf_tests::FormatPopupToolsRowLabel(count, index);
}
NWB_INLINE void PopupToolsFixture::SetUp(){ ::__hidden_ui_glyph_sdf_tests::SetUpPopupToolsFixture(*this); }
NWB_INLINE b8 PopupToolsFixture::declareTools(const u64 generation, const b8 tooltip, const b8 menu, const Rect& bounds){
    return ::__hidden_ui_glyph_sdf_tests::DeclarePopupToolsFixture(*this, generation, tooltip, menu, bounds);
}
NWB_INLINE b8 PopupToolsFixture::acceptPopupTooltip(const u64 generation){ return ::__hidden_ui_glyph_sdf_tests::AcceptPopupTooltipFixture(*this, generation); }
NWB_INLINE b8 PopupToolsFixture::moveToAnchor(const AStringView parent){ return ::__hidden_ui_glyph_sdf_tests::MovePopupToolsToAnchor(*this, parent); }
NWB_INLINE void PopupToolsFixture::secondaryClick(const Point& point){ ::__hidden_ui_glyph_sdf_tests::SecondaryClickPopupTools(*this, point); }
NWB_INLINE b8 PopupToolsFixture::openBySecondary(const u64 generation){ return ::__hidden_ui_glyph_sdf_tests::OpenPopupToolsBySecondary(*this, generation); }
};
NWB_END


