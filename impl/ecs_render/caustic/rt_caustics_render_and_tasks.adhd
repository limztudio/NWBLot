enum<u8> CausticWaveletVariantKind{
    Generic = 0u,
    StepOne = 1u,
    StepTwo = 2u,
    Direct = 3u,
    kCount
}

b8 IsCausticPrepareOutputHalfB(in u32 resolvePassCount){
    return (resolvePassCount % 2u) == 0u;
}

b8 IsCausticWaveletInputHalfB(in u32 resolvePassCount, in u32 passIndex){
    return ((resolvePassCount + passIndex) % 2u) == 0u;
}

u32 ResolveCausticWaveletStepWidth(in u32 passIndex){
    return 1u << passIndex;
}

CausticWaveletVariantKind ClassifyCausticWaveletStepWidth(in u32 stepWidth, in u32 ldsMaxStep){
    if(stepWidth == s_CausticWaveletStepOneWidth)
        return CausticWaveletVariantKind::StepOne;
    if(stepWidth == s_CausticWaveletStepTwoWidth)
        return CausticWaveletVariantKind::StepTwo;
    if(stepWidth > ldsMaxStep)
        return CausticWaveletVariantKind::Direct;
    return CausticWaveletVariantKind::Generic;
}

u32 ComputeCausticHalfTargetExtent(in u32 extent){
    return DivideUpWrappingU32(extent, 2u);
}

u32 ComputeCausticFullDispatchGroups(in u32 extent){
    return DivideUp(extent, s_CausticResolveGroupSize);
}


