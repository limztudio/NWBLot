namespace NWB::Tests::CpuTaskSuite{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB::Core;
using TestSchedulerConfig = CpuTaskSchedulerTestSupport::TestSchedulerConfig;
using CpuTaskSchedulerTestSupport::ExitTestProcess;
using CpuTaskSchedulerTestSupport::HomogeneousWorkers;
using CpuTaskSchedulerTestSupport::s_ProfilingPollIntervalMS;
using CpuTaskSchedulerTestSupport::s_CompletionTimeoutMS;
using CpuTaskSchedulerTestSupport::s_CpuProfilingNameTestsCpuScope;
using CpuTaskSchedulerTestSupport::s_CpuProfilingNameTestsCpuTask;
