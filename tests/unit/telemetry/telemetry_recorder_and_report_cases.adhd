MemorySnapshot RecorderReport_MakeCounterSnapshot(in Name scopeName, in u64 counter, in u64 frame){
    MemorySnapshot snapshot = MemorySnapshot();
    snapshot.scopeName = scopeName;
    snapshot.frameIndex = frame;
    snapshot.reservedBytes = counter;
    snapshot.usedBytes = counter;
    snapshot.peakUsedBytes = counter;
    snapshot.allocationCount = counter;
    snapshot.reallocationCount = counter;
    snapshot.deallocationCount = counter;
    return snapshot;
}

MemoryDifferenceCase RecorderReport_MakeDiffCase(in u64 current, in u64 previous, in i64 expected){
    MemoryDifferenceCase item = MemoryDifferenceCase();
    item.current = current;
    item.previous = previous;
    item.expected = expected;
    return item;
}

MemoryUnrepresentableCase RecorderReport_MakeUnrepresentableCase(in u64 current, in u64 previous){
    MemoryUnrepresentableCase item = MemoryUnrepresentableCase();
    item.current = current;
    item.previous = previous;
    return item;
}

MemoryDeltaCase RecorderReport_MakeDeltaCase(in i64 first, in i64 second, in i64 expected, in b8 valid){
    MemoryDeltaCase item = MemoryDeltaCase();
    item.first = first;
    item.second = second;
    item.expected = expected;
    item.valid = valid;
    return item;
}

void RecorderReport_SetSnapshotCounterByField(mut MemorySnapshot snapshot, in usize fieldIndex, in u64 value){
    switch(fieldIndex){
    case 0u:
        snapshot.reservedBytes = value;
        break;
    case 1u:
        snapshot.usedBytes = value;
        break;
    case 2u:
        snapshot.peakUsedBytes = value;
        break;
    case 3u:
        snapshot.allocationCount = value;
        break;
    case 4u:
        snapshot.reallocationCount = value;
        break;
    case 5u:
        snapshot.deallocationCount = value;
        break;
    default:
        break;
    }
}

u64 RecorderReport_GetSnapshotCounterByField(in MemorySnapshot snapshot, in usize fieldIndex){
    switch(fieldIndex){
    case 0u:
        return snapshot.reservedBytes;
    case 1u:
        return snapshot.usedBytes;
    case 2u:
        return snapshot.peakUsedBytes;
    case 3u:
        return snapshot.allocationCount;
    case 4u:
        return snapshot.reallocationCount;
    case 5u:
        return snapshot.deallocationCount;
    default:
        return 0u;
    }
}

void RecorderReport_SetTimingField(mut TimingStats stats, in usize fieldIndex, in f64 value){
    switch(fieldIndex){
    case 0u:
        stats.seconds = value;
        break;
    case 1u:
        stats.minSeconds = value;
        break;
    case 2u:
        stats.maxSeconds = value;
        break;
    case 3u:
        stats.lastSeconds = value;
        break;
    default:
        break;
    }
}

void RecorderReport_SetEncodedTimingField(mut EncodedPerfTimingPayloadHeader header, in usize fieldIndex, in f64 value){
    switch(fieldIndex){
    case 0u:
        header.seconds = value;
        break;
    case 1u:
        header.minSeconds = value;
        break;
    case 2u:
        header.maxSeconds = value;
        break;
    case 3u:
        header.lastSeconds = value;
        break;
    default:
        break;
    }
}

b8 RecorderReport_RecordBuiltFilledPayload(mut TelemetryRecorder recorder, in usize byteCount, in u8 value){
    b8 recorded = false;
    native(mut recorder, in byteCount, in value, mut recorded){
        recorded = recorder.recordBuiltPayload(EventKind::PerfFrame, 1u, 0u, [byteCount, value](TelemetryArena&, TelemetryBytes& payload){
            EXPECT_TRUE(payload.empty());
            payload.resize(byteCount, value);
            return true;
        });
    }
    return recorded;
}

StringView RecorderReport_SeedAliasedText(in StringView text, mut TelemetryBytes payload){
    StringView aliased = "";
    native(in text, mut payload, mut aliased){
        payload.clear();
        payload.reserve(512u);
        payload.resize(text.size());
        NWB_MEMCPY(payload.data(), payload.size(), text.data(), text.size());
        aliased = AStringView(reinterpret_cast<const char*>(payload.data()), payload.size());
    }
    return aliased;
}

void CheckTextLogPayload(in TelemetryBytes payload, in Span<u8> expected){
    ASSERT_EQ(payload.size(), s_EncodedTextLogPayloadHeaderByteSize + expected.size());
    EncodedTextLogPayloadHeader header = EncodedTextLogPayloadHeader();
    ReadTelemetryPod(payload, 0u, header);
    EXPECT_EQ(header.messageBytes, expected.size());
    for(usize index = 0u; index < expected.size(); ++index)
        EXPECT_EQ(payload[s_EncodedTextLogPayloadHeaderByteSize + index], expected[index]);
}

void CheckTextLogPayload(in TelemetryBytes payload){
    ASSERT_EQ(payload.size(), s_EncodedTextLogPayloadHeaderByteSize);
    EncodedTextLogPayloadHeader header = EncodedTextLogPayloadHeader();
    ReadTelemetryPod(payload, 0u, header);
    EXPECT_EQ(header.messageBytes, 0u);
}

void RunConcurrentReset(in b8 disableCapture){
    const usize s_WorkerCount = 4u;
    TelemetryTestArena testArena = TelemetryTestArena();
    const ArenaMemoryStats initial = testArena.arena.memoryStats();
    {
        TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
        recorder.setCaptureOptions(CapturePerfOnly());
        usize acceptedCount = 0u;
        usize damagedPayloadCount = 0u;
        b8 markerRecorded = false;
        native(in disableCapture, mut recorder, mut acceptedCount, mut damagedPayloadCount, mut markerRecorded){
            constexpr usize kWorkerCount = 4u;
            Atomic<usize> accepted{ 0u };
            Atomic<usize> damagedPayloads{ 0u };
            Latch payloadsReady(kWorkerCount);
            Latch releasePayloads(1u);
            Array<Thread, kWorkerCount> workers;
            for(usize index = 0u; index < kWorkerCount; ++index){
                workers[index] = Thread([&, index](){
                    b8 enteredBuilder = false;
                    const b8 recorded = recorder.recordBuiltPayload(EventKind::PerfFrame, 42u, static_cast<u32>(index), [&](TelemetryArena&, TelemetryBytes& payload){
                        enteredBuilder = true;
                        payload.resize(256u, static_cast<u8>(index + 1u));
                        payloadsReady.count_down();
                        releasePayloads.wait();
                        for(const u8 value : payload){
                            if(value != index + 1u){
                                damagedPayloads.fetch_add(1u, MemoryOrder::relaxed);
                                break;
                            }
                        }
                        return true;
                    });
                    if(!enteredBuilder)
                        payloadsReady.count_down();
                    if(recorded)
                        accepted.fetch_add(1u, MemoryOrder::relaxed);
                });
            }
            payloadsReady.wait();
            recorder.clear();
            const u8 marker = 99u;
            markerRecorded = recorder.recordBinary(EventKind::PerfFrame, 7u, &marker, sizeof(marker), 99u);
            if(disableCapture)
                recorder.setCaptureOptions(CaptureDisabled());
            releasePayloads.count_down();
            for(Thread& worker : workers)
                worker.join();
            acceptedCount = accepted.load(MemoryOrder::relaxed);
            damagedPayloadCount = damagedPayloads.load(MemoryOrder::relaxed);
        }

        EXPECT_TRUE(markerRecorded);
        EXPECT_EQ(damagedPayloadCount, 0u);
        usize expectedAccepted = s_WorkerCount;
        usize expectedEvents = s_WorkerCount + 1u;
        if(disableCapture){
            expectedAccepted = 0u;
            expectedEvents = 0u;
        }
        EXPECT_EQ(acceptedCount, expectedAccepted);
        EXPECT_EQ(recorder.eventCount(), expectedEvents);
        if(!disableCapture){
            Array<b8, 4> seen = Array<b8, 4>();
            for(usize index = 1u; index < recorder.eventCount(); ++index){
                const Expected<EventHeader> header = ReadEventHeaderAt(recorder.view(), index);
                ASSERT_TRUE(header.has_value());
                const u32 streamId = header.value().streamId;
                ASSERT_LT(streamId, s_WorkerCount);
                EXPECT_FALSE(seen[streamId]);
                seen[streamId] = true;
                const Expected<usize> payloadSize = EventPayloadSizeAt(recorder.view(), index);
                const Expected<u8> payloadFront = EventPayloadFrontAt(recorder.view(), index);
                const Expected<u8> payloadBack = EventPayloadBackAt(recorder.view(), index);
                ASSERT_TRUE(payloadSize.has_value());
                ASSERT_TRUE(payloadFront.has_value());
                ASSERT_TRUE(payloadBack.has_value());
                ASSERT_EQ(payloadSize.value(), 256u);
                EXPECT_EQ(payloadFront.value(), cast<u8>(streamId + 1u));
                EXPECT_EQ(payloadBack.value(), cast<u8>(streamId + 1u));
            }
            for(in b8 recorded : seen)
                EXPECT_TRUE(recorded);
        }
    }
    const ArenaMemoryStats after = testArena.arena.memoryStats();
    EXPECT_EQ(after.usedBytes, initial.usedBytes);
    EXPECT_EQ(after.reservedBytes, initial.reservedBytes);
}

void VerifyTelemetry_PerfMemoryPayloadRejectsInvalidInput(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    const Name scopeName = Name(s_TelemetryMemoryProjectArena);
    MemorySnapshot snapshot = MakeTestMemorySnapshot(scopeName);
    MemoryDelta delta = MakeTestMemoryDelta();

    EXPECT_FALSE(BuildTestPerfMemoryPayload(s_NameNone, s_TelemetryProjectArenaText, snapshot, delta, payload));
    EXPECT_FALSE(BuildTestPerfMemoryPayload(scopeName, "", snapshot, delta, payload));

    snapshot.scopeName = s_TelemetryCaseMemoryOtherArena;
    EXPECT_FALSE(BuildTestPerfMemoryPayload(scopeName, s_TelemetryProjectArenaText, snapshot, delta, payload));

    snapshot = MakeTestMemorySnapshot(scopeName);
    delta.currentFrameIndex = 99u;
    EXPECT_FALSE(BuildTestPerfMemoryPayload(scopeName, s_TelemetryProjectArenaText, snapshot, delta, payload));
}

void VerifyTelemetry_MemoryDifferencePreservesSignedLimitsAndLargeUnsignedCounters(){
    const u64 s_MaxSigned = cast<u64>(i64.max);
    const u64 s_MinMagnitude = s_MaxSigned + 1u;
    Array<MemoryDifferenceCase, 10> cases = Array<MemoryDifferenceCase, 10>();
    cases[0u] = RecorderReport_MakeDiffCase(0u, 0u, 0);
    cases[1u] = RecorderReport_MakeDiffCase(s_MaxSigned, 0u, i64.max);
    cases[2u] = RecorderReport_MakeDiffCase(0u, s_MaxSigned, -i64.max);
    cases[3u] = RecorderReport_MakeDiffCase(0u, s_MinMagnitude, i64.min);
    cases[4u] = RecorderReport_MakeDiffCase(s_MinMagnitude - 1u, s_MinMagnitude, -1);
    cases[5u] = RecorderReport_MakeDiffCase(s_MinMagnitude + 5u, s_MinMagnitude - 5u, 10);
    cases[6u] = RecorderReport_MakeDiffCase(s_MinMagnitude - 5u, s_MinMagnitude + 5u, -10);
    cases[7u] = RecorderReport_MakeDiffCase(u64.max, u64.max - 17u, 17);
    cases[8u] = RecorderReport_MakeDiffCase(u64.max - 17u, u64.max, -17);
    cases[9u] = RecorderReport_MakeDiffCase(0u, 128u, -128);

    const Name scopeName = Name(s_TelemetryMemoryProjectArena);
    for(in MemoryDifferenceCase test : cases){
        ScopedTestTrace traceCurrent = ScopedTestTrace(test.current);
        ScopedTestTrace tracePrevious = ScopedTestTrace(test.previous);
        const MemoryDelta delta = Difference(RecorderReport_MakeCounterSnapshot(scopeName, test.current, 2u), RecorderReport_MakeCounterSnapshot(scopeName, test.previous, 1u));
        ASSERT_TRUE(delta.valid());
        EXPECT_EQ(delta.previousFrameIndex, 1u);
        EXPECT_EQ(delta.currentFrameIndex, 2u);
        EXPECT_EQ(delta.reservedBytes, test.expected);
        EXPECT_EQ(delta.usedBytes, test.expected);
        EXPECT_EQ(delta.peakUsedBytes, test.expected);
        EXPECT_EQ(delta.allocationCount, test.expected);
        EXPECT_EQ(delta.reallocationCount, test.expected);
        EXPECT_EQ(delta.deallocationCount, test.expected);
    }
}

void VerifyTelemetry_MemoryDifferenceOmitsUnrepresentableCountersFromTelemetry(){
    TelemetryTestArena testArena = TelemetryTestArena();
    const Name scopeName = Name(s_TelemetryMemoryProjectArena);
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    const u64 s_MinMagnitude = cast<u64>(i64.max) + 1u;
    Array<MemoryUnrepresentableCase, 4> cases = Array<MemoryUnrepresentableCase, 4>();
    cases[0u] = RecorderReport_MakeUnrepresentableCase(s_MinMagnitude, 0u);
    cases[1u] = RecorderReport_MakeUnrepresentableCase(0u, s_MinMagnitude + 1u);
    cases[2u] = RecorderReport_MakeUnrepresentableCase(u64.max, 0u);
    cases[3u] = RecorderReport_MakeUnrepresentableCase(0u, u64.max);

    for(usize fieldIndex = 0u; fieldIndex < 6u; ++fieldIndex){
        for(in MemoryUnrepresentableCase test : cases){
            ScopedTestTrace traceCurrent = ScopedTestTrace(test.current);
            ScopedTestTrace tracePrevious = ScopedTestTrace(test.previous);
            MemorySnapshot previous = MemorySnapshot();
            previous.scopeName = scopeName;
            previous.frameIndex = 1u;
            RecorderReport_SetSnapshotCounterByField(previous, fieldIndex, test.previous);
            MemorySnapshot current = MemorySnapshot();
            current.scopeName = scopeName;
            current.frameIndex = 2u;
            RecorderReport_SetSnapshotCounterByField(current, fieldIndex, test.current);
            const MemoryDelta delta = Difference(current, previous);
            EXPECT_FALSE(delta.valid());
            ASSERT_TRUE(BuildTestPerfMemoryPayload(scopeName, s_TelemetryProjectArenaText, current, delta, payload));
            const Expected<PerfMemoryPayload> parsed = ParsePerfMemoryBytes(payload);
            ASSERT_TRUE(parsed.has_value());
            EXPECT_FALSE(parsed.value().delta.valid());
            EXPECT_EQ(RecorderReport_GetSnapshotCounterByField(parsed.value().snapshot, fieldIndex), test.current);
            EXPECT_EQ(parsed.value().snapshot.frameIndex, 2u);
        }
    }
}

void VerifyTelemetry_MemoryReportMarksUnrepresentableTotalsWithoutChangingIndividualRecords(){
    Array<MemoryDeltaCase, 6> cases = Array<MemoryDeltaCase, 6>();
    cases[0u] = RecorderReport_MakeDeltaCase(i64.max, 1, 0, false);
    cases[1u] = RecorderReport_MakeDeltaCase(i64.min, -1, 0, false);
    cases[2u] = RecorderReport_MakeDeltaCase(i64.max - 1, 1, i64.max, true);
    cases[3u] = RecorderReport_MakeDeltaCase(i64.min + 1, -1, i64.min, true);
    cases[4u] = RecorderReport_MakeDeltaCase(i64.max, -i64.max, 0, true);
    cases[5u] = RecorderReport_MakeDeltaCase(i64.min, i64.max, -1, true);

    TelemetryTestArena testArena = TelemetryTestArena();
    const Name scopeName = Name(s_TelemetryMemoryProjectArena);
    for(in MemoryDeltaCase test : cases){
        ScopedTestTrace traceFirst = ScopedTestTrace(test.first);
        ScopedTestTrace traceSecond = ScopedTestTrace(test.second);
        TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
        recorder.setCaptureOptions(CapturePerfOnly());
        MemorySnapshot snapshot = MakeTestMemorySnapshot(scopeName);
        MemoryDelta delta = MakeTestMemoryDelta();
        delta.usedBytes = test.first;
        ASSERT_TRUE(RecordTestPerfMemory(recorder, scopeName, s_TelemetryProjectArenaText, snapshot, delta));
        ++snapshot.frameIndex;
        ++delta.previousFrameIndex;
        ++delta.currentFrameIndex;
        delta.usedBytes = test.second;
        ASSERT_TRUE(RecordTestPerfMemory(recorder, scopeName, s_TelemetryProjectArenaText, snapshot, delta));

        const Expected<TelemetryReport> report = BuildTestTelemetryReport(recorder.view(), testArena.arena, testArena.scratchArena);
        ASSERT_TRUE(report.has_value());
        EXPECT_EQ(report.value().summary.parseFailureCount, 0u);
        EXPECT_EQ(report.value().summary.memoryEventCount, 2u);
        const TelemetryMemorySummary summary = report.value().summary.memorySources[MemorySource::ExplicitScope];
        EXPECT_EQ(summary.eventCount, 2u);
        EXPECT_EQ(summary.maxUsedBytes, snapshot.usedBytes);
        EXPECT_EQ(summary.totalUsedDeltaValid, test.valid);
        const StringView json = ReportJsonView(report.value());
        if(test.valid){
            EXPECT_EQ(summary.totalUsedDeltaBytes, test.expected);
            const String expected = StringFormat("\"totalUsedDeltaBytes\": {}", test.expected);
            EXPECT_NE(json.find(StringView(expected)), usize.max);
            EXPECT_EQ(json.find("\"totalUsedDeltaBytes\": null"), usize.max);
        }
        else{
            EXPECT_NE(json.find("\"totalUsedDeltaBytes\": null"), usize.max);
            ++snapshot.frameIndex;
            ++delta.previousFrameIndex;
            ++delta.currentFrameIndex;
            delta.usedBytes = -test.second;
            ASSERT_TRUE(RecordTestPerfMemory(recorder, scopeName, s_TelemetryProjectArenaText, snapshot, delta));
            const Expected<TelemetryReport> continued = BuildTestTelemetryReport(recorder.view(), testArena.arena, testArena.scratchArena);
            ASSERT_TRUE(continued.has_value());
            EXPECT_FALSE(continued.value().summary.memorySources[MemorySource::ExplicitScope].totalUsedDeltaValid);
            EXPECT_EQ(continued.value().summary.memoryEventCount, 3u);
        }
        Array<i64, 2> deltaValues = Array<i64, 2>();
        deltaValues[0u] = test.first;
        deltaValues[1u] = test.second;
        for(in i64 value : deltaValues){
            const String expected = StringFormat("\"usedBytes\": {}", value);
            EXPECT_NE(json.find(StringView(expected)), usize.max);
        }

        recorder.clear();
        delta.usedBytes = 0;
        ASSERT_TRUE(RecordTestPerfMemory(recorder, scopeName, s_TelemetryProjectArenaText, snapshot, delta));
        const Expected<TelemetryReport> reset = BuildTestTelemetryReport(recorder.view(), testArena.arena, testArena.scratchArena);
        ASSERT_TRUE(reset.has_value());
        EXPECT_TRUE(reset.value().summary.memorySources[MemorySource::ExplicitScope].totalUsedDeltaValid);
        EXPECT_EQ(reset.value().summary.memorySources[MemorySource::ExplicitScope].totalUsedDeltaBytes, 0);
    }
}

void VerifyTelemetry_PerfTimingPayloadRejectsNonCurrentVersionsAndCorruptMagicAfterValidParse(){
    TelemetryTestArena testArena = TelemetryTestArena();
    const Name scopeName = Name(s_RendererFrame);
    const TimingStats stats = MakeTestTimingStats();

    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildTestPerfTimingPayload(PerfTimingSource::Gpu, scopeName, s_RendererFrameText, stats, payload));
    ASSERT_TRUE(ParsePerfTimingBytes(payload).has_value());
    TelemetryBytes current = TelemetryBytes(testArena.arena);
    CopyTelemetryBytes(payload, current);

    Array<u16, 3> unsupportedVersions = Array<u16, 3>();
    unsupportedVersions[0u] = 0u;
    unsupportedVersions[1u] = cast<u16>(s_PerfTimingPayloadVersion + 1u);
    unsupportedVersions[2u] = u16.max;
    for(in u16 version : unsupportedVersions){
        ScopedTestTrace trace = ScopedTestTrace(version);
        EncodedPerfTimingPayloadHeader header = EncodedPerfTimingPayloadHeader();
        ReadTelemetryPod(current, 0u, header);
        header.version = version;
        WriteTelemetryPod(payload, 0u, header);
        EXPECT_FALSE(ParsePerfTimingBytes(payload).has_value());
        const Expected<PerfTimingPayload> parsed = ParsePerfTimingBytes(current);
        ASSERT_TRUE(parsed.has_value());
        EXPECT_EQ(parsed.value().scopeName, scopeName);
    }
    CopyTelemetryBytes(current, payload);
    payload[0u] = 0u;
    EXPECT_FALSE(ParsePerfTimingBytes(payload).has_value());
}

void VerifyTelemetry_PerfPayloadBuildersPreserveAliasedScopeText(){
    TelemetryTestArena testArena = TelemetryTestArena();
    const Name scopeName = Name(s_RendererFrame);
    const TimingStats stats = MakeTestTimingStats();
    const MemorySnapshot snapshot = MakeTestMemorySnapshot(scopeName);
    const MemoryDelta delta = MakeTestMemoryDelta();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    const StringView s_Text = "borrowed scope inside output";

    const StringView timingSeed = RecorderReport_SeedAliasedText(s_Text, payload);
    ASSERT_TRUE(BuildTestPerfTimingPayload(PerfTimingSource::Cpu, scopeName, timingSeed, stats, payload));
    const Expected<PerfTimingPayload> timing = ParsePerfTimingBytes(payload);
    ASSERT_TRUE(timing.has_value());
    EXPECT_EQ(timing.value().scopeText, s_Text);

    const StringView memorySeed = RecorderReport_SeedAliasedText(s_Text, payload);
    ASSERT_TRUE(BuildTestPerfMemoryPayload(scopeName, memorySeed, snapshot, delta, payload));
    const Expected<PerfMemoryPayload> memory = ParsePerfMemoryBytes(payload);
    ASSERT_TRUE(memory.has_value());
    EXPECT_EQ(memory.value().scopeText, s_Text);

    ASSERT_TRUE(BuildTestPerfTimingPayload(PerfTimingSource::Cpu, scopeName, memory.value().scopeText.substr(9u), stats, payload));
    const Expected<PerfTimingPayload> converted = ParsePerfTimingBytes(payload);
    ASSERT_TRUE(converted.has_value());
    EXPECT_EQ(converted.value().scopeText, "scope inside output");
    ASSERT_TRUE(BuildTestPerfMemoryPayload(scopeName, converted.value().scopeText, snapshot, delta, payload));
    const Expected<PerfMemoryPayload> expanded = ParsePerfMemoryBytes(payload);
    ASSERT_TRUE(expanded.has_value());
    EXPECT_EQ(expanded.value().scopeText, "scope inside output");
}

void VerifyTelemetry_PerfTimingPayloadRejectsInvalidInput(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    TimingStats stats = MakeTestTimingStats();

    EXPECT_FALSE(BuildTestPerfTimingPayload(PerfTimingSource::Unknown, Name(s_RendererFrame), s_RendererFrameText, stats, payload));
    stats.sampleCount = 0u;
    EXPECT_FALSE(BuildTestPerfTimingPayload(PerfTimingSource::Cpu, Name(s_RendererFrame), s_RendererFrameText, stats, payload));
}

void VerifyTelemetry_PerfTimingRejectsNonfiniteDurationsAtBuildAndWireAdmission(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    TelemetryBytes current = TelemetryBytes(testArena.arena);
    const Name scopeName = Name(s_RendererFrame);
    const TimingStats validStats = MakeTestTimingStats();
    ASSERT_TRUE(BuildTestPerfTimingPayload(PerfTimingSource::Cpu, scopeName, s_RendererFrameText, validStats, current));

    Array<u64, 3> nonfiniteBits = Array<u64, 3>();
    nonfiniteBits[0u] = 0x7FF0000000000000uLL;
    nonfiniteBits[1u] = 0xFFF0000000000000uLL;
    nonfiniteBits[2u] = 0x7FF8000000000001uLL;
    for(usize fieldIndex = 0u; fieldIndex < 4u; ++fieldIndex){
        for(in u64 bits : nonfiniteBits){
            ScopedTestTrace traceField = ScopedTestTrace(fieldIndex);
            ScopedTestTrace traceBits = ScopedTestTrace(bits);
            const f64 invalidValue = bit_cast<f64>(bits);
            TimingStats invalid = validStats;
            RecorderReport_SetTimingField(invalid, fieldIndex, invalidValue);
            EXPECT_FALSE(BuildTestPerfTimingPayload(PerfTimingSource::Cpu, scopeName, s_RendererFrameText, invalid, payload));

            CopyTelemetryBytes(current, payload);
            EncodedPerfTimingPayloadHeader header = EncodedPerfTimingPayloadHeader();
            ReadTelemetryPod(current, 0u, header);
            RecorderReport_SetEncodedTimingField(header, fieldIndex, invalidValue);
            WriteTelemetryPod(payload, 0u, header);
            EXPECT_FALSE(ParsePerfTimingBytes(payload).has_value());
            const Expected<PerfTimingPayload> recovered = ParsePerfTimingBytes(current);
            ASSERT_TRUE(recovered.has_value());
            EXPECT_EQ(recovered.value().stats.seconds, validStats.seconds);
        }
    }
}

TimingScopeId RecorderReport_MakeTimingScopeId(in u32 index, in u32 generation){
    TimingScopeId scope = TimingScopeId();
    scope.index = index;
    scope.generation = generation;
    return scope;
}

void VerifyTelemetry_GenericScopeHelpersPreserveBorrowedPointerValuesAndImplicitNameFailures(){
    GenericScopeRecord record = GenericScopeRecord();
    record.name = s_TelemetryCasePerfGenericScope;
    record.generation = 3u;
    const TimingScopeId scope = RecorderReport_MakeTimingScopeId(0u, 3u);
    const TimingScopeId wrongGeneration = RecorderReport_MakeTimingScopeId(0u, 4u);
    const TimingScopeId wrongIndex = RecorderReport_MakeTimingScopeId(1u, 3u);

    usize recordAddress = 0u;
    usize foundAddress = 1u;
    usize wrongGenerationAddress = 1u;
    usize wrongIndexAddress = 1u;
    Name resolvedName = s_NameNone;
    native(mut record, in scope, in wrongGeneration, in wrongIndex, mut recordAddress, mut foundAddress, mut wrongGenerationAddress, mut wrongIndexAddress, mut resolvedName){
        recordAddress = reinterpret_cast<usize>(&record);
        const Array<BorrowedScopePointer, 1u> ownerStorage{ BorrowedScopePointer{ &record } };
        const Span<const BorrowedScopePointer> owners(ownerStorage);
        static_assert(IsSame_V<decltype(FindNamedScope<TimingScopeId>(owners, scope)), GenericScopeRecord*>);
        static_assert(noexcept(FindNamedScope<TimingScopeId>(owners, scope)));
        foundAddress = reinterpret_cast<usize>(FindNamedScope<TimingScopeId>(owners, scope));
        wrongGenerationAddress = reinterpret_cast<usize>(FindNamedScope<TimingScopeId>(owners, wrongGeneration));
        wrongIndexAddress = reinterpret_cast<usize>(FindNamedScope<TimingScopeId>(owners, wrongIndex));

        const Array<NotNull<GenericScopeRecord*>, 1u> recordStorage{ MakeNotNull(&record) };
        const Span<const NotNull<GenericScopeRecord*>> records(recordStorage);
        static_assert(noexcept(ScopeNameAt(records, 0u)));
        resolvedName = ScopeNameAt(records, 0u);

        ThrowingScopeRecord throwing{};
        const Array<NotNull<ThrowingScopeRecord*>, 1u> throwingRecordStorage{ MakeNotNull(&throwing) };
        const Span<const NotNull<ThrowingScopeRecord*>> throwingRecords(throwingRecordStorage);
        static_assert(noexcept(Name(throwing.name)));
        static_assert(!noexcept(DeclVal<void(*)(Name)noexcept>()(throwing.name)));
        static_assert(!noexcept(ScopeNameAt(throwingRecords, 0u)));
        EXPECT_THROW({ const Name value = ScopeNameAt(throwingRecords, 0u); EXPECT_EQ(value, s_NameNone); }, u32);
    }

    EXPECT_EQ(foundAddress, recordAddress);
    EXPECT_EQ(wrongGenerationAddress, 0u);
    EXPECT_EQ(wrongIndexAddress, 0u);
    EXPECT_EQ(resolvedName, record.name);
}

void VerifyTelemetry_PerfTimingViewRejectsIndexAtScopeCount(){
    TelemetryTestArena testArena = TelemetryTestArena();
