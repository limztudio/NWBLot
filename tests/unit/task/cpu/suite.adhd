void VerifyCpuTaskSchedulerTests_NestedLargeFanInAcceptsIndependentPredecessorsAndDuplicateEdges(){
    const usize fanIn = 1024u;
    const usize chainLength = 1024u;
    u32 predecessors = 0u;
    u32 continuations = 0u;
    u32 childInvocations = 0u;
    usize outstandingTasks = 0u;
    native(in fanIn, in chainLength, mut predecessors, mut continuations, mut childInvocations, mut outstandingTasks){
        using namespace __hidden_cpu_task_fanin_tests;
        DeadlineGuard deadline(false, s_TestTimeoutMS);
        Alloc::ScratchArena scratchArena("CpuTaskSchedulerTests.NestedLargeFanIn");
        Vector<CpuTaskHandle, Alloc::ScratchArena> prerequisites(fanIn + 2u, CpuTaskHandle{}, scratchArena);
        CpuTaskScheduler scheduler(0u);
        const auto cpuTaskAdmission = scheduler.submit([&]() {
            const auto secondCpuTaskAdmission = scheduler.submit([&]() {
                EXPECT_EQ(predecessors, fanIn);
                ++childInvocations;
            }, {}, prerequisites.data(), prerequisites.size());
            ASSERT_TRUE(secondCpuTaskAdmission);
            if(secondCpuTaskAdmission)
                ASSERT_TRUE(secondCpuTaskAdmission->valid());
        });
        ASSERT_TRUE(cpuTaskAdmission);
        const auto root = *cpuTaskAdmission;
        ASSERT_TRUE(root.valid());
        auto tail = root;
        for(usize index = 0u; index < chainLength; ++index){
            const auto thirdCpuTaskAdmission = scheduler.submit([&]() {
                EXPECT_EQ(childInvocations, 1u);
                ++continuations;
            }, tail);
            ASSERT_TRUE(thirdCpuTaskAdmission);
            tail = *thirdCpuTaskAdmission;
            ASSERT_TRUE(tail.valid());
        }
        for(usize index = 0u; index < fanIn; ++index){
            const auto prerequisiteTaskAdmission = scheduler.submit([&]()noexcept { ++predecessors; });
            ASSERT_TRUE(prerequisiteTaskAdmission);
            prerequisites[index] = *prerequisiteTaskAdmission;
            ASSERT_TRUE(prerequisites[index].valid());
        }
        prerequisites[fanIn] = prerequisites.front();
        scheduler.wait();
        outstandingTasks = scheduler.statistics().outstandingTasks;
    }
    EXPECT_EQ(predecessors, cast<u32>(fanIn));
    EXPECT_EQ(continuations, cast<u32>(chainLength));
    EXPECT_EQ(childInvocations, 1u);
    EXPECT_EQ(outstandingTasks, 0u);
}

void VerifyCpuTaskSchedulerTests_NestedLargeFanInRejectsACycleAtTheEndOfTheDependencyList(){
    const usize fanIn = 1024u;
    u32 invocations = 0u;
    b8 rejected = false;
    usize outstandingTasks = 0u;
    native(in fanIn, mut invocations, mut rejected, mut outstandingTasks){
        using namespace __hidden_cpu_task_fanin_tests;
        DeadlineGuard deadline(false, s_TestTimeoutMS);
        Alloc::ScratchArena scratchArena("CpuTaskSchedulerTests.NestedCyclicFanIn");
        Vector<CpuTaskHandle, Alloc::ScratchArena> prerequisites(fanIn + 1u, CpuTaskHandle{}, scratchArena);
        CpuTaskScheduler scheduler(0u);
        const auto cpuTaskAdmission = scheduler.submit([&]() {
            const auto secondCpuTaskAdmission = scheduler.submit([&]()noexcept { ++invocations; }, {}, prerequisites.data(), prerequisites.size());
            rejected = !secondCpuTaskAdmission || !secondCpuTaskAdmission->valid();
            ++invocations;
        });
        ASSERT_TRUE(cpuTaskAdmission);
        auto tail = *cpuTaskAdmission;
        ASSERT_TRUE(tail.valid());
        for(usize index = 0u; index < fanIn; ++index){
            const auto tailTaskAdmission = scheduler.submit([&]()noexcept { ++invocations; }, tail);
            ASSERT_TRUE(tailTaskAdmission);
            tail = *tailTaskAdmission;
            ASSERT_TRUE(tail.valid());
        }
        prerequisites.back() = tail;
        for(usize index = 0u; index < fanIn; ++index){
            const auto prerequisiteTaskAdmission = scheduler.submit([&]()noexcept { ++invocations; });
            ASSERT_TRUE(prerequisiteTaskAdmission);
            prerequisites[index] = *prerequisiteTaskAdmission;
            ASSERT_TRUE(prerequisites[index].valid());
        }
        scheduler.wait();
        outstandingTasks = scheduler.statistics().outstandingTasks;
    }
    EXPECT_TRUE(rejected);
    EXPECT_EQ(invocations, cast<u32>(fanIn * 2u + 1u));
    EXPECT_EQ(outstandingTasks, 0u);
}

void VerifyCpuTaskSchedulerTests_NestedDependencyAcceptsARetiredGenerationInTheAncestorsSlot(){
    b8 accepted = false;
    b8 invoked = false;
    CpuTaskHandle completed = CpuTaskHandle();
    CpuTaskHandle parent = CpuTaskHandle();
    usize outstandingTasks = 0u;
    native(mut accepted, mut invoked, mut completed, mut parent, mut outstandingTasks){
        using namespace __hidden_cpu_task_fanin_tests;
        DeadlineGuard deadline(false, s_TestTimeoutMS);
        CpuTaskScheduler scheduler(0u);
        const auto completedTaskAdmission = scheduler.submit([]()noexcept {});
        ASSERT_TRUE(completedTaskAdmission);
        completed = *completedTaskAdmission;
        ASSERT_TRUE(completed.valid());
        scheduler.wait(completed);
        const auto cpuTaskAdmission = scheduler.submit([&]() {
            const auto secondCpuTaskAdmission = scheduler.submit([&]()noexcept { invoked = true; }, completed);
            accepted = secondCpuTaskAdmission.has_value() && secondCpuTaskAdmission->valid();
        });
        ASSERT_TRUE(cpuTaskAdmission);
        parent = *cpuTaskAdmission;
        ASSERT_TRUE(parent.valid());
        scheduler.wait();
        outstandingTasks = scheduler.statistics().outstandingTasks;
    }
    EXPECT_EQ(parent.index, completed.index);
    EXPECT_NE(parent.generation, completed.generation);
    EXPECT_TRUE(accepted);
    EXPECT_TRUE(invoked);
    EXPECT_EQ(outstandingTasks, 0u);
}

