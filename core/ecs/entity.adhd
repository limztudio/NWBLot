[cpp_header("<core/ecs/entity.h>"), cpp_name("::NWB::Core::ECS::Entity"), cpp_flags(small_value, binary_serializable, no_assign)]
extern class Entity{
    T addComponent<T>(...);
    b8 alive(...)const;
    void destroy(...);
    T getComponent<T>(...)const;
    b8 hasComponent(...)const;
    EntityID id(...)const;
    void removeComponent(...);
};

[cpp_name("::NWB::Core::ECS::EntityManager")]
extern class EntityManager{
    b8 alive(...)const;
    void clear(...);
    usize count(...)const;
    EntityID create(...);
    void destroy(...);
};


