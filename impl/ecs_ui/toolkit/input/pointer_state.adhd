#include <impl/ecs_ui/toolkit/input/command_state.adhd>
#include <impl/ecs_ui/toolkit/input/popup_state.adhd>
#include <impl/ecs_ui/toolkit/input/target_table.adhd>
#include <impl/ecs_ui/toolkit/input/input.adhd>
#include <impl/ecs_ui/toolkit/input/router_pointer_source_admission.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class InputPointerState : NoCopy{
    public void reserveSources(){
        this.m_pointerSources.reserve(s_InputSourceReserve);
    }

    public void reserveGestures(){
        this.m_pointerGestures.reserve(s_InputMaxPointerGestures);
    }

    public b8 accepts(in InputSource source)const{
        return AcceptsRouterPointerSource(this.m_activePointerSource, this.m_pointerSources, source);
    }

    public b8 owns(in InputSource source, in PointerIntent intent)const{
        return OwnsRouterPointerSource(this.m_pointerSources, source, intent);
    }

    public b8 wants(in b8 hasPopup, in WidgetId hover)const{
        return WantsRouterPointer(this.m_pointerSources, hasPopup, hover);
    }

    public InputPointerRouteEffects routePrimary(
        in InputEvent event,
        in b8 hasHit,
        in HitTarget hit,
        in InputTargetTable targets,
        in InputPopupState popups,
        mut InputCommandState commands,
        mut Vector<InputAction> actions,
        mut Vector<ControlAction> controlActions,
        mut Vector<WindowPressRecord> windowPresses,
        mut u64 nextActionSequence,
        mut InputRoutingResult result
    ){
        return RouteRouterPrimaryWithEffects(
            targets.targets(),
            targets.lookup(),
            event,
            hasHit,
            hit,
            this.m_secondaryDown,
            this.m_secondarySequenceConsumed,
            targets.generation(),
            this.m_activePointerSource,
            this.m_interactionPosition,
            popups.records(),
            popups.canAppendDismissal(),
            commands.records(),
            actions,
            controlActions,
            this.m_pointerGestures,
            windowPresses,
            this.m_activeGestureSequence,
            nextActionSequence,
            this.m_primaryDown,
            this.m_pointerSubmitArmed,
            this.m_pointerSequenceConsumed,
            commands.focus(),
            commands.declaration(),
            commands.control(),
            this.m_capture,
            this.m_capturePopup,
            this.m_captureDeclaration,
            this.m_captureControl,
            result
        );
    }

    public InputPointerRouteEffects routeSecondary(
        in InputEvent event,
        in b8 hasHit,
        in HitTarget hit,
        in InputTargetTable targets,
        in InputPopupState popups,
        in b8 windowFocused,
        mut Vector<ContextMenuAction> contextMenuActions,
        mut Vector<WindowPressRecord> windowPresses,
        mut u64 nextActionSequence,
        mut InputRoutingResult result
    ){
        return RouteRouterSecondaryWithEffects(
            targets.targets(),
            targets.lookup(),
            windowFocused,
            targets.generation(),
            event,
            hasHit,
            hit,
            this.m_primaryDown,
            this.m_pointerSequenceConsumed,
            popups.records(),
            popups.canAppendDismissal(),
            contextMenuActions,
            windowPresses,
            nextActionSequence,
            this.m_secondaryDown,
            this.m_secondarySequenceConsumed,
            this.m_secondaryOwner,
            this.m_secondaryPosition,
            result
        );
    }

    public void routeWheel(
        in InputEvent event,
        in b8 hasHit,
        in HitTarget hit,
        in InputTargetTable targets,
        in InputPopupState popups,
        mut Vector<ControlAction> controlActions,
        mut u64 nextActionSequence,
        mut InputRoutingResult result
    ){
        RouteRouterWheel(
            targets.targets(),
            targets.lookup(),
            popups.records(),
            event,
            hasHit,
            hit,
            this.m_primaryDown,
            this.m_pointerSequenceConsumed,
            this.m_secondaryDown,
            this.m_secondarySequenceConsumed,
            targets.generation(),
            controlActions,
            nextActionSequence,
            result
        );
    }

    public mut PointerSourceTable sources(){
        return this.m_pointerSources;
    }

    public in PointerSourceTable sources()const{
        return this.m_pointerSources;
    }

    public mut Vector<PointerGestureRecord> gestures(){
        return this.m_pointerGestures;
    }

    public in Vector<PointerGestureRecord> gestures()const{
        return this.m_pointerGestures;
    }

    public mut u64 gestureSequence(){
        return this.m_activeGestureSequence;
    }

    public in u64 gestureSequence()const{
        return this.m_activeGestureSequence;
    }

    public mut WidgetId capture(){
        return this.m_capture;
    }

    public in WidgetId capture()const{
        return this.m_capture;
    }

    public mut PopupToken capturePopup(){
        return this.m_capturePopup;
    }

    public in PopupToken capturePopup()const{
        return this.m_capturePopup;
    }

    public mut ControlToken captureControl(){
        return this.m_captureControl;
    }

    public in ControlToken captureControl()const{
        return this.m_captureControl;
    }

    public mut u64 captureDeclaration(){
        return this.m_captureDeclaration;
    }

    public in u64 captureDeclaration()const{
        return this.m_captureDeclaration;
    }

    public mut TargetOwner secondaryOwner(){
        return this.m_secondaryOwner;
    }

    public in TargetOwner secondaryOwner()const{
        return this.m_secondaryOwner;
    }

    public mut Point interactionPosition(){
        return this.m_interactionPosition;
    }

    public in Point interactionPosition()const{
        return this.m_interactionPosition;
    }

    public mut Point secondaryPosition(){
        return this.m_secondaryPosition;
    }

    public in Point secondaryPosition()const{
        return this.m_secondaryPosition;
    }

    public mut InputSource activeSource(){
        return this.m_activePointerSource;
    }

    public in InputSource activeSource()const{
        return this.m_activePointerSource;
    }

    public mut b8 primaryDown(){
        return this.m_primaryDown;
    }

    public in b8 primaryDown()const{
        return this.m_primaryDown;
    }

    public mut b8 primaryConsumed(){
        return this.m_pointerSequenceConsumed;
    }

    public in b8 primaryConsumed()const{
        return this.m_pointerSequenceConsumed;
    }

    public mut b8 submitArmed(){
        return this.m_pointerSubmitArmed;
    }

    public in b8 submitArmed()const{
        return this.m_pointerSubmitArmed;
    }

    public mut b8 secondaryDown(){
        return this.m_secondaryDown;
    }

    public in b8 secondaryDown()const{
        return this.m_secondaryDown;
    }

    public mut b8 secondaryConsumed(){
        return this.m_secondarySequenceConsumed;
    }

    public in b8 secondaryConsumed()const{
        return this.m_secondarySequenceConsumed;
    }

    private PointerSourceTable m_pointerSources;
    private Vector<PointerGestureRecord> m_pointerGestures;
    private u64 m_activeGestureSequence = 0u;
    private WidgetId m_capture;
    private PopupToken m_capturePopup;
    private ControlToken m_captureControl;
    private u64 m_captureDeclaration = 0u;
    private TargetOwner m_secondaryOwner;
    private Point m_interactionPosition;
    private Point m_secondaryPosition;
    private InputSource m_activePointerSource;
    private b8 m_primaryDown = false;
    private b8 m_pointerSequenceConsumed = false;
    private b8 m_pointerSubmitArmed = false;
    private b8 m_secondaryDown = false;
    private b8 m_secondarySequenceConsumed = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

