void VerifyUiPaintGlyphTests_ClipTrimsGlyphGeometryAndUv(mut UiPaintGlyphTests self){
    auto pageCreationResult = self.makeGlyphPage();
    ASSERT_TRUE(pageCreationResult.has_value());
    SharedGlyphPage page = SharedGlyphPage();
    TakeUiPaintGlyphPage(page, pageCreationResult);
    ASSERT_TRUE(UiPaintGlyphHasPage(page));
    self.m_builder.pushClip(MakeUiPaintGlyphRect(10.0f, 5.0f, 20.0f, 10.0f));
    ASSERT_TRUE(self.m_builder.drawGlyph(
        page,
        MakeUiPaintGlyphRect(0.0f, 0.0f, 40.0f, 20.0f),
        MakeUiPaintGlyphRect(0.125f, 0.25f, 0.5f, 0.5f),
        MakeUiPaintGlyphColor(0.8f, 0.4f, 0.2f, 0.5f)
    ));
    ASSERT_TRUE(self.m_builder.popClip());
    ExpectClippedPaintTextQuad(self.m_builder.freeze());
}

void VerifyUiPaintGlyphTests_BatchesOnlyAdjacentGlyphsWithMatchingPageMaterialAndClip(mut UiPaintGlyphTests self){
    auto firstCreationResult = self.makeGlyphPage();
    ASSERT_TRUE(firstCreationResult.has_value());
    SharedGlyphPage first = SharedGlyphPage();
    TakeUiPaintGlyphPage(first, firstCreationResult);
    auto secondCreationResult = self.makeGlyphPage(s_UiPaintGlyphDefaultAtlasIdentity, 1u, 1u);
    ASSERT_TRUE(secondCreationResult.has_value());
    SharedGlyphPage second = SharedGlyphPage();
    TakeUiPaintGlyphPage(second, secondCreationResult);
    ASSERT_TRUE(UiPaintGlyphHasPage(first));
    ASSERT_TRUE(UiPaintGlyphHasPage(second));
    const Rect rectangle = MakeUiPaintGlyphRect(1.0f, 1.0f, 4.0f, 4.0f);
    const Rect uv = MakeUiPaintGlyphRect(0.0f, 0.0f, 0.5f, 0.5f);
    ASSERT_TRUE(self.m_builder.drawGlyph(first, rectangle, uv));
    ASSERT_TRUE(self.m_builder.drawGlyph(first, rectangle, uv, MakeUiPaintGlyphColor(0.5f, 0.25f, 1.0f, 0.5f)));
    ASSERT_TRUE(self.m_builder.drawGlyph(second, rectangle, uv));
    ASSERT_TRUE(self.m_builder.drawGlyph(first, rectangle, uv));
    self.m_builder.fillRect(rectangle);
    ASSERT_TRUE(self.m_builder.drawGlyph(first, rectangle, uv));
    ASSERT_TRUE(self.m_builder.drawRegion(Name(s_UiInputNameSprite), rectangle));
    ASSERT_TRUE(self.m_builder.drawGlyph(first, rectangle, uv));
    self.m_builder.pushClip(MakeUiPaintGlyphRect(0.0f, 0.0f, 20.0f, 20.0f));
    ASSERT_TRUE(self.m_builder.drawGlyph(first, rectangle, uv));
    ASSERT_TRUE(self.m_builder.popClip());
    ASSERT_TRUE(self.m_builder.drawGlyph(first, rectangle, uv));
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.glyphPages().size(), 2u);
    ASSERT_EQ(snapshot.commands().size(), 9u);
    ASSERT_EQ(snapshot.vertices().size(), 40u);
    ASSERT_EQ(snapshot.indices().size(), 60u);
    EXPECT_EQ(snapshot.commands()[0u].indexCount, 12u);
    EXPECT_EQ(snapshot.commands()[1u].glyphPageIndex, 1u);
    EXPECT_EQ(snapshot.commands()[2u].glyphPageIndex, 0u);
    EXPECT_EQ(snapshot.commands()[3u].material, PaintMaterial::Solid);
    EXPECT_EQ(snapshot.commands()[3u].glyphPageIndex, u32.max);
    EXPECT_EQ(snapshot.commands()[5u].material, PaintMaterial::Skin);
    EXPECT_EQ(snapshot.commands()[5u].glyphPageIndex, u32.max);
    for(usize index = 1u; index < snapshot.commands().size(); ++index){
        EXPECT_EQ(snapshot.commands()[index].firstIndex, cast<u32>((index + 1u) * 6u));
        EXPECT_EQ(snapshot.commands()[index].indexCount, 6u);
    }
    EXPECT_FLOAT_EQ(snapshot.commands()[6u].clip.width, 100.0f);
    EXPECT_FLOAT_EQ(snapshot.commands()[7u].clip.width, 20.0f);
    EXPECT_FLOAT_EQ(snapshot.commands()[8u].clip.width, 100.0f);
}

void VerifyUiPaintGlyphTests_NewerAppendOnlyPageUpgradesBindingWithoutMovingEarlierGlyphUvs(mut UiPaintGlyphTests self){
    auto originalCreationResult = self.makeGlyphPage();
    ASSERT_TRUE(originalCreationResult.has_value());
    SharedGlyphPage original = SharedGlyphPage();
    TakeUiPaintGlyphPage(original, originalCreationResult);
    auto appendedCreationResult = self.makeGlyphPage(s_UiPaintGlyphDefaultAtlasIdentity, 2u);
    ASSERT_TRUE(appendedCreationResult.has_value());
    SharedGlyphPage appended = SharedGlyphPage();
    TakeUiPaintGlyphPage(appended, appendedCreationResult);
    ASSERT_TRUE(UiPaintGlyphHasPage(original));
    ASSERT_TRUE(UiPaintGlyphHasPage(appended));
    const Rect earlierUv = MakeUiPaintGlyphRect(0.0f, 0.0f, 0.25f, 0.25f);
    ASSERT_TRUE(self.m_builder.drawGlyph(original, MakeUiPaintGlyphRect(1.0f, 1.0f, 4.0f, 4.0f), earlierUv));
    ASSERT_TRUE(self.prepareSingleGlyphPage(appended));
    ASSERT_TRUE(self.m_builder.drawGlyph(appended, MakeUiPaintGlyphRect(6.0f, 1.0f, 4.0f, 4.0f), MakeUiPaintGlyphRect(0.5f, 0.5f, 0.25f, 0.25f)));
    // A later caller retaining the old page must neither downgrade the binding nor split the compatible batch.
    ASSERT_TRUE(self.m_builder.drawGlyph(original, MakeUiPaintGlyphRect(11.0f, 1.0f, 4.0f, 4.0f), earlierUv));
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.glyphPages().size(), 1u);
    ASSERT_EQ(snapshot.commands().size(), 1u);
    ASSERT_EQ(snapshot.vertices().size(), 12u);
    EXPECT_EQ(snapshot.commands()[0u].indexCount, 18u);
    EXPECT_EQ(snapshot.commands()[0u].glyphPageIndex, 0u);
    EXPECT_EQ(UiPaintGlyphPageAddress(snapshot.glyphPages()[0u]), UiPaintGlyphPageAddress(appended));
    EXPECT_EQ(UiPaintGlyphPageGeneration(snapshot.glyphPages()[0u]), 2u);
    EXPECT_EQ(UiPaintGlyphPagePixel(snapshot.glyphPages()[0u], 0u), UiPaintGlyphPagePixel(original, 0u));
    EXPECT_EQ(UiPaintGlyphPagePixel(snapshot.glyphPages()[0u], 32u), 192u);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].texCoord.x, 0.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].texCoord.y, 0.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].texCoord.x, 0.25f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].texCoord.y, 0.25f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[4u].texCoord.x, 0.5f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[4u].texCoord.y, 0.5f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[8u].texCoord.x, 0.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[10u].texCoord.x, 0.25f);
}

void VerifyUiPaintGlyphTests_FrozenSnapshotRetainsOldCoverageAfterBuilderReuseAndPageRelease(mut UiPaintGlyphTests self){
    auto originalCreationResult = self.makeGlyphPage();
    ASSERT_TRUE(originalCreationResult.has_value());
    SharedGlyphPage original = SharedGlyphPage();
    TakeUiPaintGlyphPage(original, originalCreationResult);
    ASSERT_TRUE(UiPaintGlyphHasPage(original));
    ASSERT_TRUE(self.m_builder.drawGlyph(original, MakeUiPaintGlyphRect(1.0f, 1.0f, 4.0f, 4.0f), MakeUiPaintGlyphRect(0.0f, 0.0f, 0.25f, 0.25f)));
    const DrawSnapshot first = self.m_builder.freeze();
    original.reset();
    self.begin(8u);
    auto appendedCreationResult = self.makeGlyphPage(s_UiPaintGlyphDefaultAtlasIdentity, 2u);
    ASSERT_TRUE(appendedCreationResult.has_value());
    SharedGlyphPage appended = SharedGlyphPage();
    TakeUiPaintGlyphPage(appended, appendedCreationResult);
    ASSERT_TRUE(UiPaintGlyphHasPage(appended));
    ASSERT_TRUE(self.m_builder.drawGlyph(appended, MakeUiPaintGlyphRect(6.0f, 1.0f, 4.0f, 4.0f), MakeUiPaintGlyphRect(0.5f, 0.5f, 0.25f, 0.25f)));
    const DrawSnapshot second = self.m_builder.freeze();
    appended.reset();
    self.begin(9u);
    ASSERT_EQ(first.glyphPages().size(), 1u);
    ASSERT_EQ(second.glyphPages().size(), 1u);
    EXPECT_EQ(UiPaintGlyphPageGeneration(first.glyphPages()[0u]), 1u);
    EXPECT_EQ(UiPaintGlyphPageGeneration(second.glyphPages()[0u]), 2u);
    EXPECT_NE(UiPaintGlyphPageAddress(first.glyphPages()[0u]), UiPaintGlyphPageAddress(second.glyphPages()[0u]));
    EXPECT_EQ(UiPaintGlyphPagePixel(first.glyphPages()[0u], 0u), 64u);
    EXPECT_EQ(UiPaintGlyphPagePixel(first.glyphPages()[0u], 32u), 0u);
    EXPECT_EQ(UiPaintGlyphPagePixel(second.glyphPages()[0u], 0u), 64u);
    EXPECT_EQ(UiPaintGlyphPagePixel(second.glyphPages()[0u], 32u), 192u);
    EXPECT_FLOAT_EQ(first.vertices()[0u].texCoord.x, 0.0f);
    EXPECT_FLOAT_EQ(second.vertices()[0u].texCoord.x, 0.5f);
}

void VerifyUiPaintGlyphTests_RejectedPageAdmissionAtCapacityPreservesBindingsAndGeometry(mut UiPaintGlyphTests self){
    ASSERT_EQ(s_PaintMaxImages, 64u);
    FixedVector<SharedGlyphPage, 64u> pages = FixedVector<SharedGlyphPage, 64u>();
    for(usize index = 0u; index < s_PaintMaxImages; ++index){
        auto pageCreationResult = self.makeGlyphPage(100u + index);
        ASSERT_TRUE(pageCreationResult.has_value());
        SharedGlyphPage page = SharedGlyphPage();
        TakeUiPaintGlyphPage(page, pageCreationResult);
        ASSERT_TRUE(UiPaintGlyphHasPage(page));
        pages.push_back(page);
    }
    ASSERT_TRUE(self.m_builder.drawGlyph(pages[0u], MakeUiPaintGlyphRect(2.0f, 3.0f, 4.0f, 5.0f), MakeUiPaintGlyphRect(0.125f, 0.25f, 0.5f, 0.5f)));
    ASSERT_TRUE(self.m_builder.prepareGlyphPages(pages));
    auto upgradeCreationResult = self.makeGlyphPage(100u, 2u);
    ASSERT_TRUE(upgradeCreationResult.has_value());
    SharedGlyphPage upgrade = SharedGlyphPage();
    TakeUiPaintGlyphPage(upgrade, upgradeCreationResult);
    auto overflowCreationResult = self.makeGlyphPage(1000u);
    ASSERT_TRUE(overflowCreationResult.has_value());
    SharedGlyphPage overflow = SharedGlyphPage();
    TakeUiPaintGlyphPage(overflow, overflowCreationResult);
    ASSERT_TRUE(UiPaintGlyphHasPage(upgrade));
    ASSERT_TRUE(UiPaintGlyphHasPage(overflow));
    Array<SharedGlyphPage, 2u> candidates = Array<SharedGlyphPage, 2u>();
    candidates[0u] = upgrade;
    candidates[1u] = overflow;
    EXPECT_FALSE(self.m_builder.prepareGlyphPages(candidates));
    EXPECT_FALSE(self.m_builder.drawGlyph(overflow, MakeUiPaintGlyphRect(10.0f, 10.0f, 4.0f, 4.0f), MakeUiPaintGlyphRect(0.0f, 0.0f, 0.5f, 0.5f)));
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.glyphPages().size(), s_PaintMaxImages);
    for(usize index = 0u; index < pages.size(); ++index)
        EXPECT_EQ(UiPaintGlyphPageAddress(snapshot.glyphPages()[index]), UiPaintGlyphPageAddress(pages[index]));
    EXPECT_EQ(UiPaintGlyphPageGeneration(snapshot.glyphPages()[0u]), 1u);
    EXPECT_EQ(UiPaintGlyphPagePixel(snapshot.glyphPages()[0u], 32u), 0u);
    ASSERT_EQ(snapshot.vertices().size(), 4u);
    ASSERT_EQ(snapshot.indices().size(), 6u);
    ASSERT_EQ(snapshot.commands().size(), 1u);
    EXPECT_EQ(snapshot.commands()[0u].firstIndex, 0u);
    EXPECT_EQ(snapshot.commands()[0u].indexCount, 6u);
    EXPECT_EQ(snapshot.commands()[0u].glyphPageIndex, 0u);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].position.x, 2.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].position.y, 3.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].position.x, 6.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].position.y, 8.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].texCoord.x, 0.125f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].texCoord.y, 0.75f);
}


