void VerifyUiListBehaviorTests_EmptySourceClearsKeysAndNavigationAndSubmitAreValidNoOps(){
    UiListBehaviorRangeSource source = UiListBehaviorRangeSource();
    source.count = 0u;
    ListState state = ListState();
    state.select(5u);
    ASSERT_TRUE(UiListBehaviorReconcile(state, source));
    EXPECT_EQ(state.selectedKey(), 0u);
    EXPECT_EQ(state.cursorKey(), 0u);
    ListResult result = ListResult();
    ASSERT_TRUE(UiListBehaviorApply(source, ListOptions(), MakeUiListBehaviorAction(state, source, ControlActionKind::Down), state, result));
    ASSERT_TRUE(UiListBehaviorApply(source, ListOptions(), MakeUiListBehaviorAction(state, source, ControlActionKind::Submit), state, result));
    EXPECT_TRUE(result.valid);
    EXPECT_FALSE(result.selectionChanged);
    EXPECT_FALSE(result.activated);
    EXPECT_EQ(source.findCalls, 0u);
    EXPECT_EQ(source.lookupCalls, 0u);
}

void VerifyUiListBehaviorTests_HundredThousandRowsSkipALargeDisabledRangeWithBoundedSourceCalls(){
    UiListBehaviorRangeSource source = UiListBehaviorRangeSource();
    source.count = 100000u;
    source.disabledBegin = 49999u;
    source.disabledEnd = 99999u;
    ListState state = ListState();
    state.select(49999u);
    ASSERT_TRUE(UiListBehaviorReconcile(state, source));
    source.clearCalls();
    ListResult result = ListResult();
    ASSERT_TRUE(UiListBehaviorApply(source, ListOptions(), MakeUiListBehaviorAction(state, source, ControlActionKind::Down), state, result));
    EXPECT_EQ(state.selectedKey(), 100000u);
    EXPECT_EQ(state.cursorKey(), 100000u);
    EXPECT_EQ(source.findCalls, 1u);
    EXPECT_LE(source.lookupCalls, 2u);
    EXPECT_LE(source.keyCalls, 3u);
    EXPECT_LE(source.enabledCalls, 2u);
    ASSERT_TRUE(UiListBehaviorApply(source, ListOptions(), MakeUiListBehaviorAction(state, source, ControlActionKind::Up), state, result));
    EXPECT_EQ(state.cursorKey(), 49999u);
    EXPECT_TRUE(result.selectionChanged);
    EXPECT_FALSE(result.activated);
}

void VerifyUiListBehaviorTests_HomeEndAndBoundaryNavigationNeverWrap(){
    UiListBehaviorRangeSource source = UiListBehaviorRangeSource();
    ListState state = ListState();
    ASSERT_TRUE(UiListBehaviorReconcile(state, source));
    ListResult result = ListResult();
    ASSERT_TRUE(UiListBehaviorApply(source, ListOptions(), MakeUiListBehaviorAction(state, source, ControlActionKind::Home), state, result));
    ASSERT_TRUE(UiListBehaviorApply(source, ListOptions(), MakeUiListBehaviorAction(state, source, ControlActionKind::Up), state, result));
    EXPECT_EQ(state.cursorKey(), 1u);
    ASSERT_TRUE(UiListBehaviorApply(source, ListOptions(), MakeUiListBehaviorAction(state, source, ControlActionKind::End), state, result));
    ASSERT_TRUE(UiListBehaviorApply(source, ListOptions(), MakeUiListBehaviorAction(state, source, ControlActionKind::Down), state, result));
    EXPECT_EQ(state.cursorKey(), 10u);
    EXPECT_FALSE(result.activated);
}

void VerifyUiListBehaviorTests_PageNavigationUsesAcceptedRowsAndSaturatesWithoutIntegerOverflow(){
    UiListBehaviorRangeSource source = UiListBehaviorRangeSource();
