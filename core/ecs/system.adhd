[cpp_header("<core/ecs/system.h>"), cpp_name("::NWB::Core::ECS::AccessMode::Enum")]
extern enum AccessMode : u8{
    Read,
    Write
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<core/ecs/system.h>"), cpp_name("::NWB::Core::ECS::ComponentAccess"), cpp_flags(self_defaulted, small_value, binary_serializable, brace_init)]
extern class ComponentAccess{
    usize typeId;
    AccessMode mode;
};

[cpp_header("<core/ecs/system.h>"), cpp_name("::NWB::Core::ECS::ISystem"), cpp_flags(no_copy, no_assign, abstract, polymorphic_base)]
extern class ISystem{
    Span<ComponentAccess> accesses(...)const;
    void prepare(...);
    void readAccess(...);
    void registerAccess(...);
    Name systemType(...)const;
    CpuTaskOptions taskOptions(...)const;
    Expected<void, CpuTaskAdmissionError> update(...);
    void writeAccess(...);
};

[cpp_header("<core/ecs/system.h>"), cpp_name("::NWB::Core::ECS::SystemScheduler"), cpp_flags(no_assign)]
extern class SystemScheduler{
    void addSystem(...);
    void clear(...);
    Expected<void, CpuTaskAdmissionError> execute(...);
    void rebuild(...);
    void removeSystem(...);
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

