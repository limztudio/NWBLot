void VerifyAssetPaths_DerivedPathRejectsOutsideAndEmptyLogicalPaths(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration(logger, LoggerBreakPolicy::BreakOnFatal);
    PathFixture fixture = PathFixture();
    GraphicsScratchArena scratch = GraphicsScratchArena(s_AssetCaseTestsAssetPathRejectionScratch);

    const GraphicsTestPath outside = JoinGraphicsPath(fixture.assetRoot, "../Elsewhere/Model.NWB");
    EXPECT_FALSE(BuildDerivedScratchPath(fixture.assetRoot, s_ProjectVirtualRoot, outside, scratch).has_value());
    EXPECT_FALSE(CanBuildDerivedVirtualPath(fixture.assetRoot, s_ProjectVirtualRoot, outside, scratch));
    EXPECT_FALSE(BuildDerivedScratchPath(fixture.assetRoot, s_ProjectVirtualRoot, fixture.assetRoot, scratch).has_value());
    EXPECT_FALSE(CanBuildDerivedVirtualPath(fixture.assetRoot, s_ProjectVirtualRoot, fixture.assetRoot, scratch));
    EXPECT_EQ(logger.errorCount(), 4u);
}

void VerifyAssetPaths_LongAsciiAndUnicodePathsRemainCorrectAcrossRepeatedCallerArenaUse(){
    for(u32 mode = 0u; mode < 2u; ++mode){
        const b8 unicode = mode == 1u;
        PathFixture fixture = PathFixture();
        StringView directoryToken = "Long_COMPONENT_";
        usize tokenRepeats = 12u;
        if(unicode){
            directoryToken = "ÉTAGE_한글_東京_😀_";
            tokenRepeats = 8u;
        }
        PrepareAssetPathWorkload(8u, directoryToken, tokenRepeats, fixture);
        GraphicsScratchArena scratch = GraphicsScratchArena(s_AssetCaseTestsAssetPathRepeatedScratch, 65536u);
        ScratchPattern sentinel(scratch, 64u, 91u);
        ASSERT_TRUE(sentinel.valid());
        const ArenaMemoryStats retained = scratch.arena.memoryStats();
        ArenaMemoryStats warm = ArenaMemoryStats();
        for(usize call = 0u; call < 16u; ++call){
            {
                ScratchString relative(scratch.arena);
                ASSERT_TRUE(WriteGraphicsRelativePath(fixture.relativePath, relative));
                EXPECT_EQ(StringView(relative), StringView(fixture.expectedRelative));
                EXPECT_TRUE(GraphicsStringByte(relative, relative.size()) == 0u);
            }
            EXPECT_TRUE(VerifyDerivedFixturePath(fixture, scratch));
            EXPECT_TRUE(sentinel.intact());
            const ArenaMemoryStats after = scratch.arena.memoryStats();
            if(call == 0u)
                warm = after;
            EXPECT_EQ(after.usedBytes, retained.usedBytes);
            EXPECT_EQ(after.reservedBytes, warm.reservedBytes);
        }
        const GraphicsTestPath parentInput = JoinGraphicsPath2(fixture.sourcePath, "..", "Second.LOD1.NWB");
        for(usize call = 0u; call < 16u; ++call){
            {
                const ScratchPath source(scratch.arena, parentInput);
                const ScratchPath normal = source.lexicallyNormal();
                const ScratchPath stem = normal.stem();
                const ScratchPath extension = normal.extension();
                EXPECT_EQ(PathToString(stem), "Second.LOD1");
                EXPECT_EQ(PathToString(extension), ".NWB");
            }
            EXPECT_EQ(scratch.arena.memoryStats().usedBytes, retained.usedBytes);
        }
        for(usize call = 0u; call < 16u; ++call){
            b8 relativeEmpty = true;
            {
                const ScratchPath source(scratch.arena, fixture.relativePath);
                const ScratchPath emptyBase(scratch.arena);
                const ScratchPath relative = source.lexicallyRelative(emptyBase);
                relativeEmpty = relative.empty();
            }
            EXPECT_FALSE(relativeEmpty);
            EXPECT_EQ(scratch.arena.memoryStats().usedBytes, retained.usedBytes);
        }
        sentinel.release();
    }
}

