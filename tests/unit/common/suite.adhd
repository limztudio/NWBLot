namespace NameSymbols = Core::Common::NameSymbols;
using Arena = Core::Alloc::GlobalArena;

template<typename CharT>
[[nodiscard]] FOUNDATION_INLINE BasicString<CharT, Arena> CopyAsciiText(Arena& arena, const AStringView source){
    BasicString<CharT, Arena> text(arena);
    text.reserve(source.size());
    for(const char ch : source)
        text.push_back(static_cast<CharT>(ch));
    return text;
}

class CallbackUnregisterLogger final : public Core::Common::ILogger{
public:
    CallbackUnregisterLogger(
        Core::Common::LogArena& arena,
        Optional<Core::Common::LoggerRegistrationGuard>& guardSlot,
        Latch& bothEnteredGate,
        AtomicFlag& unregistrationStarted,
        Atomic<b8>& peerStillInCallback,
        Atomic<b8>& unregistrationReturnedWhilePeerActive,
        Atomic<u32>& callbackCount
    )noexcept
        : m_arena(arena)
        , m_guardSlot(guardSlot)
        , m_bothEnteredGate(bothEnteredGate)
        , m_unregistrationStarted(unregistrationStarted)
        , m_peerStillInCallback(peerStillInCallback)
        , m_unregistrationReturnedWhilePeerActive(unregistrationReturnedWhilePeerActive)
        , m_callbackCount(callbackCount)
    {}


public:
    virtual Core::Common::LogArena& arena()noexcept override{ return m_arena; }

    virtual void enqueue(Core::Common::LogString&& str, Core::Common::LogType::Enum type = Core::Common::LogType::Info)override{
        handle(TStringView(str), type);
    }

    virtual void enqueue(const Core::Common::LogString& str, Core::Common::LogType::Enum type = Core::Common::LogType::Info)override{
        handle(TStringView(str), type);
    }


private:
    void handle(TStringView text, Core::Common::LogType::Enum);


private:
    Core::Common::LogArena& m_arena;
    Optional<Core::Common::LoggerRegistrationGuard>& m_guardSlot;
    Latch& m_bothEnteredGate;
    AtomicFlag& m_unregistrationStarted;
    Atomic<b8>& m_peerStillInCallback;
    Atomic<b8>& m_unregistrationReturnedWhilePeerActive;
    Atomic<u32>& m_callbackCount;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


