b8 DeclareSelectedKeyLabel(mut Builder ui, mut ScratchArena scratchArena, in u64 selectedKey){
    const String text = StringFormat(s_SelectedTextFormat, selectedKey);
    return ui.label(s_SelectedKey, StringView(text));
}

b8 DeclareCommittedNumericLabel(mut Builder ui, mut ScratchArena scratchArena, in i64 integerValue, in f64 floatValue){
    const String text = StringFormat("Committed: {} / {}", integerValue, floatValue);
    return ui.label("committed", StringView(text));
}

b8 DeclarePopupToolsStatusLabel(mut Builder ui, mut ScratchArena scratchArena, in u64 commandKey, in u32 anchorClicks){
    const String text = StringFormat("Command: {} / Clicks: {}", commandKey, anchorClicks);
    return ui.label(s_SelectedKey, StringView(text));
}

b8 DeclareProgressPercentLabel(mut Builder ui, mut ScratchArena scratchArena, in f64 percent){
    const String text = StringFormat("Completed: {:.0f}%", percent);
    return ui.label("value", StringView(text));
}

b8 DeclareGallerySectionLabel(mut Builder ui, mut ScratchArena scratchArena, in u32 sectionNumber, in u32 sectionCount, in StringView sectionName){
    const String text = StringFormat("UI samples {}/{}: {}", sectionNumber, sectionCount, sectionName);
    return ui.label("section", StringView(text));
}

b8 DeclareCounterLabel(mut Builder ui, mut ScratchArena scratchArena, in u32 count){
    const String text = StringFormat("Count: {}", count);
    return ui.label("count", StringView(text));
}

usize WriteVirtualListRowLabelBytes(in u64 rowKey, mut Array<u8, s_VirtualListLabelCapacity> outLabel){
    if(rowKey == 0u)
        return 0u;
    outLabel[0u] = 82u;
    outLabel[1u] = 111u;
    outLabel[2u] = 119u;
    outLabel[3u] = 32u;
    Array<u8, s_VirtualListMaxDecimalDigits> digits;
    usize digitCount = 0u;
    u64 remaining = rowKey;
    while(remaining > 0u && digitCount < s_VirtualListMaxDecimalDigits){
        digits[digitCount] = cast<u8>(48u + (remaining % 10u));
        remaining /= 10u;
        ++digitCount;
    }
    for(usize offset = 0u; offset < digitCount; ++offset)
        outLabel[s_VirtualListRowPrefixLength + offset] = digits[(digitCount - 1u) - offset];
    return s_VirtualListRowPrefixLength + digitCount;
}

StringView FormatVirtualListRowLabel(in u64 rowKey, in Array<u8, s_VirtualListLabelCapacity> labelStorage){
    if(rowKey == 0u)
        return "";
    StringView result = "";
    native(in rowKey, in labelStorage, mut result){
        auto& mutableStorage = const_cast<Array<u8, s_VirtualListLabelCapacity>&>(labelStorage);
        const usize length = WriteVirtualListRowLabelBytes(rowKey, mutableStorage);
        result = StringView(reinterpret_cast<const char*>(mutableStorage.data()), length);
    }
    return result;
}

b8 LoadUiGallerySkinImageSource(mut GlobalArena arena, in AssetManager assets, in ActiveSceneSubsystems sceneSubsystems, mut SharedImageSource outSource){
    AssetRef<Texture> textureRef = AssetRef<Texture>();
    native(in assets, in sceneSubsystems, mut textureRef){
        const UiSubsystem* const uiSubsystem = sceneSubsystems.findSubsystem<UiSubsystem>();
        if(uiSubsystem && uiSubsystem->basicSkin.valid()){
            auto skin = assets.loadTypedSync<UiSkin>(uiSubsystem->basicSkin.name(), NWB_TEXT("UiImageGallery"));
            if(skin)
                textureRef = (*skin)->texture();
        }
    }
    if(!textureRef.valid())
        return false;
    Expected<SharedImageSource> source = LoadImageSource(arena, assets, textureRef);
    if(!source.has_value())
        return false;
    outSource = source.value();
    return true;
}


