void VerifyUiWindowBehaviorTests_PairedGeometryPreservesSignedZeroAndFloatingPointExceptions(){
    const auto original = HoldFloatingPointExceptions();
    ASSERT_TRUE(original.has_value());
    FloatingPointEnvironmentGuard restore = FloatingPointEnvironmentGuard(original.value());
    ASSERT_TRUE(SetFloatingPointRoundingMode(FE_TONEAREST).has_value());
    const f32 negativeZero = bit_cast<f32>(s_F32SignBitMask);
    const f32 infinity = bit_cast<f32>(s_F32InfinityBits);
    ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT).has_value());
    const Point measured = ResolvePaddedIntrinsicSize(Point(infinity, negativeZero), Insets(-infinity, negativeZero, 0.0f, negativeZero), Point(0.0f, negativeZero));
    const i32 invalidExceptions = TestFloatingPointExceptions(FE_INVALID | FE_DIVBYZERO | FE_OVERFLOW);
    EXPECT_TRUE(IsNaN(measured.x));
    EXPECT_TRUE(SignBit(measured.y));
    EXPECT_EQ(invalidExceptions, FE_INVALID);
    WindowState state;
    state.bounds = Rect(f32.max, negativeZero, f32.max, negativeZero);
    WindowMetrics metrics;
    metrics.resizeExtent = negativeZero;
    ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT).has_value());
    const Rect corner = ResolveWindowResizeBounds(state, metrics);
    const i32 overflowExceptions = TestFloatingPointExceptions(FE_INVALID | FE_DIVBYZERO | FE_OVERFLOW);
    EXPECT_FALSE(IsFinite(VectorSingle(corner.x)));
    EXPECT_FALSE(SignBit(corner.y));
    EXPECT_EQ(overflowExceptions, FE_OVERFLOW);
}

NWB_ADHD_GTEST(UiWindowBehaviorTests, PairedGeometryPreservesSignedZeroAndFloatingPointExceptions, VerifyUiWindowBehaviorTests_PairedGeometryPreservesSignedZeroAndFloatingPointExceptions)


