[friend(ShadowMaterialContextPreparer, RefractionRenderer)]
class RendererRayTracingSystem : NoCopy{
    private mut World m_world;
    private mut GraphicsRuntime m_graphics;
    private mut RendererShaderSystem m_shaderSystem;
    private mut RendererMeshSystem m_meshSystem;
    private mut RendererMaterialSystem m_materialSystem;
    private mut RendererRayTracingState m_rayTracingState;
    private in RendererOpticalVolumeSelection m_opticalVolumes;
    private in CsgShapeRegistry m_csgShapeRegistry;
    private RayTracingOpticalSceneResources m_hardwareOpticalScene;
    private RayTracingOpticalSceneResources m_softwareOpticalScene;
    private SoftwareSceneRefitResources m_sceneSwBvhRefit;
    private LightSpaceShadowState m_lightSpaceShadow;
    private RefractionRenderer m_refraction;
    private SoftwareSceneRefitHandle m_preparedSceneSwBvhRefit;
    private PreparedShadowTraceGeometryBufferVector m_preparedShadowTraceGeometryBuffers;
    private Vector<BufferHandle> m_acceptedShadowTraceGeometryBuffers;
    private Vector<TextureHandle> m_preparedShadowTraceMaterialSampledTextures;
    private Vector<u8> m_preparedCausticEmissionTargetBytes;
    private PreparedShadowMaterialContext m_preparedShadowMaterialContext;
    private PreparedSceneBvhUpload m_preparedSceneBvh;
    private PreparedSceneTlasBuild m_preparedSceneTlas;
    private PreparedSceneSwBvhTraversal m_preparedSceneSwBvhTraversal;
    private Vector<PreparedMeshBlasBuild> m_preparedMeshBlasBuilds;
    private u64 m_pendingBlasStaticSkipped = 0u;
    private u64 m_blasLedgerStaticSkipped = 0u;
    private u64 m_blasLedgerFirstBuilds = 0u;
    private u64 m_blasLedgerRefits = 0u;
    private u64 m_blasLedgerRebuilds = 0u;
    private u64 m_blasLedgerUploadedBytes = 0u;
    private Vector<PreparedMeshSwBvhBuild> m_preparedMeshSwBvhBuilds;
    private Optional<mut DeferredFrameTargets> m_shadowVisibilityPreparedTargets;
    private RayTracingSceneContentStamp m_preparedSceneContentStamp;
    private CausticQualitySettings m_causticQualitySettings;
    private ShadowQualitySettings m_shadowQualitySettings;
    private b8 m_temporalOneShadowSamplingLogged = false;
    private b8 m_preparedMeshBlasBuildsReady = false;
    private b8 m_preparedMeshSwBvhBuildsReady = false;
    private b8 m_preparedMeshSwBvhBuildPlanFrozen = false;
    private b8 m_shadowVisibilityResourcesPreflighted = false;
    private b8 m_shadowVisibilityHardwareSupported = false;
    private b8 m_opticalCausticReaderAdmitted = false;
    private u32 m_unsupportedCausticVolumeCount = 0u;
    private u64 m_unsupportedCausticVolumeHash = 0u;
    private u64 m_reportedUnsupportedCausticVolumeHash = 0u;
    private u32 m_firstUnsupportedCausticVolumeEntity = 0u;
    private b8 m_unsupportedCausticVolumeReported = false;
    private b8 m_shadowVisibilityTraceResourcesPreflighted = false;
    private b8 m_shadowVisibilityBackendPipelinePreflighted = false;
    private RayTracingSceneGatherScratch m_sceneGatherScratch;
    private Optional<mut IGpuTaskGraphInstanceTransformPatchContributor> m_instanceTransformPatchContributor;
    private Vector<u32> m_preparedShadowInstanceEntityIds;
    private Vector<u32> m_preparedSceneBvhInstanceEntityIds;

    public RendererRayTracingSystem(
        mut World world,
        mut GraphicsRuntime graphics,
        mut RendererShaderSystem shaderSystem,
        mut RendererMeshSystem meshSystem,
        mut RendererMaterialSystem materialSystem,
        mut RendererRayTracingState rayTracingState,
        in RendererOpticalVolumeSelection opticalVolumes,
        in CsgShapeRegistry csgShapeRegistry
    ){
        this.m_world = world;
        this.m_graphics = graphics;
        this.m_shaderSystem = shaderSystem;
        this.m_meshSystem = meshSystem;
        this.m_materialSystem = materialSystem;
        this.m_rayTracingState = rayTracingState;
        this.m_opticalVolumes = opticalVolumes;
        this.m_csgShapeRegistry = csgShapeRegistry;
        this.m_hardwareOpticalScene = RayTracingOpticalSceneResources(graphics, Name(s_RayOpticalSceneHardware));
        this.m_softwareOpticalScene = RayTracingOpticalSceneResources(graphics, Name(s_RayOpticalSceneSoftware));
        this.m_sceneSwBvhRefit = SoftwareSceneRefitResources(graphics);
        this.m_refraction = RefractionRenderer(this, graphics);
    }

    public mut GraphicsRuntime graphics(){ return this.m_graphics; }
    public void setInstanceTransformPatchContributor(in Optional<mut IGpuTaskGraphInstanceTransformPatchContributor> contributor){ this.m_instanceTransformPatchContributor = contributor; }

    public void invalidateResources();
    public void releaseSceneTlasHeapHandle();

    public RayTracingLightingClassificationInput snapshotLightingClassificationInput()const;
    public void publishPreparedLightingClassification(in RayTracingLightingClassification classification, in Span<SceneLightGpuData> lights);
    public RayTracingFrameCpuStateSnapshot captureFrameCpuState()const;
    public void restoreShadowPacketCpuState(in RayTracingFrameCpuStateSnapshot snapshot);
    public void restoreCausticPacketCpuState(in RayTracingFrameCpuStateSnapshot snapshot);
    public void restoreSurfelGiPacketCpuState(in RayTracingFrameCpuStateSnapshot snapshot);
    public void restorePreparedLightingCpuState(in RayTracingFrameCpuStateSnapshot snapshot);

    public RayTracingShadowPreparationResourceSnapshot snapshotShadowPreparationResources()const;
    public RayTracingDeferredGraphResourceSnapshot snapshotDeferredGraphResources()const;
    public b8 prepareSceneQueryResources();
    public RayTracingSceneGraphResources snapshotSceneGraphResources()const;
    public RayTracingSurfelPersistentResourceSnapshot snapshotSurfelPersistentResources()const;
    public RayTracingShadowVisibilityGraphPlanSnapshot snapshotShadowVisibilityGraphPlan(in b8 hardwareShadowSupported)const;
    public b8 surfelCountReadbackSubmissionMatches(in QueueSubmissionToken submissionToken)const;
    public void confirmSurfelCountReadbackSubmission(in QueueSubmissionToken submissionToken);

    public b8 setCausticQualitySettings(in CausticQualitySettings settings);
    public b8 setSoftwareShadowSettings(in SoftwareShadowSettings settings);
    public b8 setShadowQualitySettings(in ShadowQualitySettings settings);
    public u32 requestedShadowReceiverFactor()const{ return RequestedShadowReceiverResolutionFactor(this.m_shadowQualitySettings.receiverResolution); }
    public in LightSpaceShadowSnapshot lightSpaceShadowSnapshotRef()const{ return this.m_lightSpaceShadow.m_snapshot; }
    public FrozenLightSpaceShadowHandle frozenLightSpaceShadowSnapshot()const{ return this.m_lightSpaceShadow.m_frozenSnapshot; }
    public PreflightedSceneLightsView preflightedSceneLights()const;
    public void acceptLightSpaceShadowCapture(in LightSpaceCaptureTicket ticket, in b8 prepared);
    public void invalidateLightSpaceShadowCapture(){ this.m_lightSpaceShadow.m_captureHistory.invalidate(); }

    public void logCapabilityOnce();

    public mut RefractionRenderer refraction(){ return this.m_refraction; }
    public in RefractionRenderer refraction()const{ return this.m_refraction; }
    public void setRefractionHardwareTracingEnabled(in b8 enabled){ this.m_rayTracingState.m_refraction.m_refractionHardwareTracingEnabled = enabled; }

    public b8 preflightShadowVisibilityResources(mut DeferredFrameTargets targets);
    public Expected<b8> recordPreflightShadowVisibilityResources(
        mut CommandList commandList,
        mut DeferredFrameTargets targets,
        in b8 sceneTlasBuildGraphOwned,
        in b8 meshBlasBuildsGraphOwned,
        in b8 meshBlasGeometryBuildInputStatesGraphOwned,
        in b8 meshSwBvhBuildsGraphOwned,
        in b8 preparedMeshSwBvhBuildsRecordedByGraph
    );
    public b8 shadowVisibilityResourcesPreflighted()const{ return this.m_shadowVisibilityResourcesPreflighted; }

    public b8 shadowVisibilityHardwareSupported()const{ return this.m_shadowVisibilityHardwareSupported; }
    public b8 shadowVisibilitySoftwareResourcesPreflighted()const{
        return IsShadowVisibilitySoftwareResourcesPreflighted(this.m_shadowVisibilityTraceResourcesPreflighted, this.m_shadowVisibilityHardwareSupported);
    }
    public void discardPreflightShadowVisibilityResources();
    public b8 freezePreparedShadowTraceGeometryBuffers();
    public Span<PreparedShadowTraceGeometryBuffer> preparedShadowTraceGeometryBuffers()const{ return Span<PreparedShadowTraceGeometryBuffer>(this.m_preparedShadowTraceGeometryBuffers); }

    public Span<TextureHandle> preparedShadowTraceMaterialSampledTextures()const{ return Span<TextureHandle>(this.m_preparedShadowTraceMaterialSampledTextures); }
    public Span<BufferHandle> acceptedShadowTraceGeometryBuffers()const{ return Span<BufferHandle>(this.m_acceptedShadowTraceGeometryBuffers); }
    public void confirmPreparedShadowTraceGeometryNormalization();
    public void invalidatePreparedShadowTraceGeometryBuffers();

    public void releaseCausticEmissionTargetHeapHandle();
    public b8 createCausticTargets(mut DeferredFrameTargets targets);
    public b8 createSurfelTargets(mut DeferredFrameTargets targets);
    public Expected<RayTraceMaterialContextSlots> snapshotRayTraceMaterialContextSlots();
    public b8 rayTraceMaterialContextSlotsUploadNeeded(in RayTraceMaterialContextSlots slots, in usize bufferIdentity, mut u64 outWord0, mut u64 outWord1, mut u64 outWord2, mut u64 outWord3)const;
    public void confirmPreparedRayTraceMaterialContextSlotsUpload(in u64 word0, in u64 word1, in u64 word2, in u64 word3, in usize bufferIdentity);
    public Expected<Optional<GpuUploadBlobId>> retainPreparedCsgTraceContextUpload(mut GpuTaskGraph graph, mut u64 outHash, mut usize outByteSize, mut usize outBufferIdentity)const;
    public void confirmPreparedCsgTraceContextUpload(in u64 hash, in usize byteSize, in usize bufferIdentity);
    public b8 prepareCausticOpticalReadTracking(in MeshViewBufferSnapshot meshView);
    public void confirmRayTraceContextReadSubmission(in QueueSubmissionToken token);
    public Expected<Optional<GpuUploadBlobId>> retainPreparedCausticEmissionTargetUpload(mut GpuTaskGraph graph, mut u64 outHash, mut usize outByteSize, mut usize outBufferIdentity)const;
    public void confirmPreparedCausticEmissionTargetUpload(in u64 hash, in usize byteSize, in usize bufferIdentity);
    public Expected<Optional<GpuUploadBlobId>> retainPreparedSurfelFrameConstantsUpload(mut GpuTaskGraph graph, in DeferredFrameTargets targets)const;
    public Expected<PreparedShadowMaterialContextUploads> retainPreparedShadowMaterialContextUploads(mut GpuTaskGraph graph)const{
        return this.m_preparedShadowMaterialContext.retainUploads(this.m_rayTracingState, graph);
    }
    public void confirmPreparedShadowMaterialContextUploads();
    public Expected<PreparedSceneBvhUploads> retainPreparedSceneBvhUploads(mut GpuTaskGraph graph)const{
        return this.m_preparedSceneBvh.retainUploads(this.m_rayTracingState, graph);
    }
    public void confirmPreparedSceneBvhUploads();
    public b8 preparedSceneTlasBuildReady()const{ return this.m_preparedSceneTlas.ready(); }
    public b8 preparedSceneTlasUsesInstanceBuffer()const{ return this.m_preparedSceneTlas.useInstanceBuffer(); }
    public Expected<Optional<GpuUploadBlobId>> retainPreparedSceneTlasUpload(mut GpuTaskGraph graph)const{
        return this.m_preparedSceneTlas.retainUpload(this.m_rayTracingState, graph);
    }
    public GpuDescriptorHandle preparedSceneTlasInstanceUavHeapHandle()const{ return this.m_preparedSceneTlas.instanceUavHeapHandle(); }
    public Span<u32> preparedSceneTlasInstanceEntityIds()const{ return this.m_preparedSceneTlas.instanceEntityIds(); }
    public GpuDescriptorHandle shadowInstanceUavHeapHandle()const{ return this.m_rayTracingState.shadow.m_shadowInstanceUavHeapHandle; }
    public Span<u32> preparedShadowInstanceEntityIds()const{ return Span<u32>(this.m_preparedShadowInstanceEntityIds); }
    public GpuDescriptorHandle sceneInstanceUavHeapHandle()const{ return this.m_rayTracingState.sceneBvh.m_sceneInstanceUavHeapHandle; }
    public Span<u32> preparedSceneBvhInstanceEntityIds()const{ return Span<u32>(this.m_preparedSceneBvhInstanceEntityIds); }
    public GpuDescriptorHandle csgTraceContextUavHeapHandle()const{ return this.m_rayTracingState.sceneBvh.m_csgTraceContextUavHeapHandle; }
    public Span<u32> preparedCsgCutterEntityIds()const{ return Span<u32>(this.m_lightSpaceShadow.m_csg.snapshot.cutterEntityIds); }
    public Span<u32> preparedCsgInstanceEntityIds()const{ return Span<u32>(this.m_lightSpaceShadow.m_csg.instanceEntityIds); }
    public u32 preparedCsgCutterByteOffset()const{ return this.m_lightSpaceShadow.m_csg.cutterByteOffset; }
    public u32 preparedCsgInstanceByteOffset()const{ return this.m_lightSpaceShadow.m_csg.instanceByteOffset; }
    public ResourceStates sceneTlasBackingInitialState()const;
    public void confirmPreparedSceneTlasBuild(){ this.m_preparedSceneTlas.confirm(this.m_rayTracingState); }
    public b8 preparedMeshBlasBuildsReady()const{ return this.m_preparedMeshBlasBuildsReady; }

    public Span<PreparedMeshBlasBuild> preparedMeshBlasBuilds()const{ return Span<PreparedMeshBlasBuild>(this.m_preparedMeshBlasBuilds); }
