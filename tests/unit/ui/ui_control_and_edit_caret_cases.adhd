void VerifyEditCaretRangeFixture_NonintersectingAndCollapsedRangesReturnEmptyRectangles(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("abc\nx\nyz"));
    self.expectRange(MakeUiEditCaretRange(6u, 8u), 0u, Rect());
    self.expectRange(MakeUiEditCaretRange(6u, 8u), 1u, Rect());
    self.expectRange(MakeUiEditCaretRange(0u, 1u), 2u, Rect());
    for(u32 line = 0u; line < self.m_geometry.lines().size(); ++line)
        self.expectRange(MakeUiEditCaretRange(0u, 0u), line, Rect());
