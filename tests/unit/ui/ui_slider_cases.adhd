namespace __hidden_ui_slider_popup_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB;
using namespace NWB::Impl::Ui;
using namespace NWB::UiSliderTests;

class UiSliderPopupTests : public SliderFixture{
public:
    virtual void SetUp()override{
        SliderFixture::SetUp();
        ASSERT_TRUE(m_childState.setValue(0.5));
        m_parent.open();
        m_child.open();
    }

    [[nodiscard]] b8 beginParent(const u64 generation){
        return begin(generation) && m_builder.beginPopup(s_ParentPopupKey, m_parent, UiWidgetTests::NestedParentOptions()) && m_builder.slider(s_SliderKey, m_state, Options());
    }

    [[nodiscard]] b8 beginChild(){
        return m_builder.beginPopup(s_ChildPopupKey, m_child, UiWidgetTests::NestedChildOptions()) && m_builder.slider(s_SliderKey, m_childState, Options());
    }

    [[nodiscard]] b8 declareFamily(const u64 generation){
        return beginParent(generation) && beginChild() && m_builder.endPopup();
    }

    [[nodiscard]] b8 finishParent(){
        return m_builder.endPopup() && m_context.endRoot() && m_context.finishFrame();
    }

    [[nodiscard]] b8 acceptFamily(const u64 generation){
        return declareFamily(generation) && finishParent() && m_context.commitFrame(generation);
    }


public:
    PopupState m_parent;
    PopupState m_child;
    SliderState m_childState;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


