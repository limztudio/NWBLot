////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_csg/components.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
enum<u8> CsgReceiverKind{
    Static,
    Skinned
}

[reflect]
enum<u8> CsgReceiverPass{
    Opaque,
    Transparent
}

[reflect]
class CsgReceiverDrawState{
    public u32 firstCutter = 0u;
    // cutterCount lets render CSG iterate the lookup range directly, skipping receiver/group resolve.
    public u32 cutterCount = 0u;
    public CsgReceiverKind receiverKind = CsgReceiverKind::Static;
    public b8 active = false;
}

[reflect]
class CsgFrameState{
    public b8 empty()const{
        return !this.hasAnyWork;
    }

    public u32 receiverCount = 0u;
    public u32 cutterCount = 0u;
    public b8 hasAnyWork = false;
    public b8 hasOpaqueStaticWork = false;
    public b8 hasOpaqueSkinnedWork = false;
    public b8 hasTransparentStaticWork = false;
    public b8 hasTransparentSkinnedWork = false;
}

[reflect]
class CsgFrameCutterRange{
    public u32 firstCutter = 0u;
    public u32 cutterCount = 0u;
}

[reflect]
class CsgFrameCutterRangeEntry{
    public CsgFrameCutterRange range;
    public u32 writtenCount = 0u;
}

[reflect]
class CsgResolvedReceiver{
    public CsgReceiverComponent receiver;
    public CsgReceiverKind receiverKind = CsgReceiverKind::Static;
}

b8 IsActiveCsgCutter(in CsgCutterComponent cutter){
    return cutter.active && cutter.shapeType != s_NameNone;
}

b8 IsCsgReceiverPassEnabled(in CsgReceiverComponent receiver, in CsgReceiverPass receiverPass){
    switch(receiverPass){
    case CsgReceiverPass::Opaque:
        return receiver.affectOpaquePass;
    case CsgReceiverPass::Transparent:
        return receiver.affectTransparentPass;
    default:
        return false;
    }
}

CsgReceiverDrawState MakeCsgReceiverDrawState(in CsgReceiverKind receiverKind, in CsgFrameCutterRange range){
    CsgReceiverDrawState out;
    out.firstCutter = range.firstCutter;
    out.cutterCount = range.cutterCount;
    out.receiverKind = receiverKind;
    out.active = range.cutterCount != 0u;
    return out;
}

CsgResolvedReceiver MakeCsgResolvedReceiver(in CsgReceiverComponent receiver, in CsgReceiverKind receiverKind){
    CsgResolvedReceiver out;
    out.receiver = receiver;
    out.receiverKind = receiverKind;
    return out;
}

void AddCsgFrameReceiverWork(in CsgReceiverKind receiverKind, in b8 opaqueWork, in b8 transparentWork, in u32 cutterCount, mut CsgFrameState inOutState){
    inOutState.receiverCount = AddSaturating<u32>(inOutState.receiverCount, 1u);
    inOutState.cutterCount = AddSaturating<u32>(inOutState.cutterCount, cutterCount);

    if(receiverKind == CsgReceiverKind::Static){
        inOutState.hasOpaqueStaticWork = inOutState.hasOpaqueStaticWork || opaqueWork;
        inOutState.hasTransparentStaticWork = inOutState.hasTransparentStaticWork || transparentWork;
    }
    else{
        inOutState.hasOpaqueSkinnedWork = inOutState.hasOpaqueSkinnedWork || opaqueWork;
        inOutState.hasTransparentSkinnedWork = inOutState.hasTransparentSkinnedWork || transparentWork;
    }
}

void FinalizeCsgFrameState(mut CsgFrameState inOutState){
    inOutState.hasAnyWork = inOutState.hasOpaqueStaticWork || inOutState.hasOpaqueSkinnedWork || inOutState.hasTransparentStaticWork || inOutState.hasTransparentSkinnedWork;
}

b8 IsValidCsgReceiverDrawRange(in CsgReceiverDrawState drawState, in usize totalCutterCount){
    const usize firstCutter = cast<usize>(drawState.firstCutter);
    const usize cutterCount = cast<usize>(drawState.cutterCount);
    return firstCutter <= totalCutterCount && cutterCount <= totalCutterCount - firstCutter;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

