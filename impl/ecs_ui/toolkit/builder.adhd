    private DialogStyle m_dialogStyle;
    private MenuBarStyle m_menuBarStyle;
    private ToastStyle m_toastStyle;
    private ColorPickerStyle m_colorPickerStyle;
    private DragDropStyle m_dragDropStyle;
    private HyperlinkStyle m_hyperlinkStyle;
    private PlotStyle m_plotStyle;
    private DockSpaceStyle m_dockSpaceStyle;
    private Optional<mut IEditBoxHost> m_editHost;
    private Vector<WidgetStyle> m_itemStyles;
    private Vector<SelectableStyle> m_itemSelectableStyles;
    private HashMap<u64, u32> m_editBoxCacheIndex;
    private Vector<CachedEditBoxView> m_editBoxCacheEntries;
    private u64 m_lastSkinStyleVersion = 0u;
    private u64 m_metricsCacheSkinVersion = 0u;
    private Point m_cachedButtonMinSize;
    private Insets m_cachedButtonPadding;
    private f32 m_cachedCheckboxExtent = 0.0f;
    private SelectableMetrics m_cachedSelectableMetrics;
    private Point m_cachedEditMinSize;
    private Insets m_cachedEditPadding;
    private f32 m_deltaSeconds = 0.0f;
    private b8 m_pointerBusy = false;
    private b8 m_declaring = false;
    private b8 m_finalizing = false;
    private b8 m_customPaletteStyleDirty = true;
    private b8 m_widgetStyleDirty = true;
    private b8 m_selectableStyleDirty = true;
    private b8 m_buttonMetricsCached = false;
    private b8 m_buttonMetricsValid = false;
    private b8 m_checkboxExtentCached = false;
    private b8 m_checkboxExtentValid = false;
    private b8 m_selectableMetricsCached = false;
    private b8 m_selectableMetricsValid = false;
    private PointerCursor m_pendingCursor = PointerCursor::Default;
    private WidgetId m_pendingFocusUp;
    private WidgetId m_pendingFocusDown;
    private WidgetId m_pendingFocusLeft;
    private WidgetId m_pendingFocusRight;
    private AccessibleOverride m_pendingAccessibleOverride;
    private HashSet<u64> m_announcedToastIds;
    private b8 m_hasPendingCursor = false;
    private b8 m_hasPendingFocusNeighbors = false;
    private b8 m_editMinSizeCached = false;
    private b8 m_editPaddingCached = false;

    [cpp_unwind]
    public Builder(mut Context context, mut PaintBuilder paint, mut TextService text){
        this.m_context = context;
        this.m_paint = paint;
        this.m_text = text;
        this.m_textLanguage.assign(s_TextDefaultLanguage);
        this.m_scope = Optional<mut BuilderScopeFrame>(this.m_scopeFrame);
    }

    public void setEditHost(mut IEditBoxHost host){
        if(this.declarationBlocked())
            this.m_context.fail();
        else
            this.m_editHost = Optional<mut IEditBoxHost>(host);
    }

    public void clearEditHost(){
        if(this.declarationBlocked())
            this.m_context.fail();
        else
            this.m_editHost.reset();
    }

    private BuilderEditBoxFrame makeEditBoxFrame()const{ return BuilderEditBoxFrame(); }

    private u32 currentItemStyleIndex(){
        if(this.m_widgetStyleDirty || this.m_itemStyles.empty()){
            this.m_itemStyles.push_back(this.m_style);
            this.m_widgetStyleDirty = false;
        }
        return cast<u32>(this.m_itemStyles.size() - 1u);
    }

    private u32 currentSelectableStyleIndex(){
        if(this.m_selectableStyleDirty || this.m_itemSelectableStyles.empty()){
            this.m_itemSelectableStyles.push_back(this.m_listStyle.row);
            this.m_selectableStyleDirty = false;
        }
        return cast<u32>(this.m_itemSelectableStyles.size() - 1u);
    }

    private in WidgetStyle itemWidgetStyle(in BuilderItem item)const{ return this.m_itemStyles[item.styleIndex]; }

    private in SelectableStyle itemSelectableStyle(in BuilderItem item)const{ return this.m_itemSelectableStyles[item.selectableStyleIndex]; }

    private in EditBoxView editViewForFrame(in BuilderEditBoxFrame frame)const{
        return this.m_editBoxCacheEntries[frame.editViewCache].view;
    }

    [owner_result]
    private BuilderListFrame makeListFrame()const{ return BuilderListFrame(); }

    private BuilderTooltipFrame makeTooltipFrame()const{ return BuilderTooltipFrame(); }

    [owner_result]
    private RadioGroupFrame makeRadioGroupFrame(in borrow IListDataSource source, mut RadioGroupState state)const{
        return RadioGroupFrame(source, state);
    }

    private void checkStyleAccess(){
        if(this.declarationBlocked())
            this.m_context.fail();
    }

