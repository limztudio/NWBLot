void ExpectBalancedStorage(in ArenaMemoryStats before, in ArenaMemoryStats after){
    EXPECT_EQ(after.usedBytes, before.usedBytes);
    EXPECT_EQ(after.reservedBytes, before.reservedBytes);
    EXPECT_EQ(after.allocationCount - before.allocationCount, after.deallocationCount - before.deallocationCount);
}

[cpp_unwind]
void VerifyConstructionFailure<S, Factory>(mut S storage, in usize failAt, in Factory factory){
    ConstructionState state;
    state.failAt = failAt;
    ActiveProbe<S> active(storage, state);
    const ArenaMemoryStats before = ConstructionStats(storage);
    ExpectConstructionFailure(factory(state));
    const ArenaMemoryStats after = ConstructionStats(storage);
    EXPECT_EQ(state.constructors, failAt);
    EXPECT_EQ(state.completed, failAt - 1u);
    EXPECT_EQ(state.destructors, failAt - 1u);
    EXPECT_EQ(state.liveMembers, 0u);
    EXPECT_EQ(state.memberDestructors, failAt);
    EXPECT_TRUE(state.aligned);
    for(usize index = 0u; index < state.destructors; ++index)
        EXPECT_EQ(state.destructionOrder[index], failAt - 1u - index);
    EXPECT_GT(after.allocationCount, before.allocationCount);
    ExpectBalancedStorage(before, after);
}

void VerifyPolymorphicAllocationIdentity<S>(mut S storage){
    const ArenaMemoryStats before = ConstructionStats(storage);
    PolymorphicAllocationState state;
    {
        auto concrete = GenericObject<PolyConcreteKind>(storage, state);
        ASSERT_TRUE(ProbePresent(concrete));
        EXPECT_TRUE(AdjustedBase(concrete));
        auto intermediate = MoveProbeOwner<PolyMiddleKind, S>(concrete);
        auto base = MoveProbeOwner<PolyBaseKind, S>(intermediate);
        auto cv = MoveProbeOwner<ConstPolyBaseKind, S>(base);
        auto restored = ReleaseWithDeleter(cv);
    }
    EXPECT_EQ(state.paddingDestructors, 1u);
    EXPECT_EQ(state.baseDestructors, 1u);
    EXPECT_EQ(state.concreteDestructors, 1u);
    const ArenaMemoryStats after = ConstructionStats(storage);
    EXPECT_EQ(after.usedBytes, before.usedBytes);
    EXPECT_EQ(after.allocationCount - before.allocationCount, after.deallocationCount - before.deallocationCount);
}

void VerifyScalarOwnerReentry<S>(mut S oldStorage, mut S newStorage){
    const ArenaMemoryStats oldBefore = ConstructionStats(oldStorage);
    const ArenaMemoryStats newBefore = ConstructionStats(newStorage);
    PolymorphicAllocationState oldState;
    PolymorphicAllocationState newState;
    ProbeOwner<PolyBaseKind, S> sink;
    auto replacement = GenericObject<PolyBaseKind>(newStorage, newState);
    ProbeOwner<PolyBaseKind, S> slot;
    ScalarRebinding<S> binding(slot, replacement, sink);
    SetReentry(oldState, binding);
    auto concrete = GenericObject<PolyConcreteKind>(oldStorage, oldState);
    ASSERT_TRUE(ProbePresent(concrete) && ProbePresent(replacement));
    EXPECT_TRUE(AdjustedBase(concrete));
    TransferProbe(slot, concrete);
    slot.reset();
    EXPECT_FALSE(ProbePresent(slot));
    EXPECT_FALSE(ProbePresent(replacement));
    EXPECT_TRUE(ProbePresent(sink));
    EXPECT_EQ(oldState.concreteDestructors, 1u);
    EXPECT_EQ(ConstructionStats(oldStorage).usedBytes, oldBefore.usedBytes);
    sink.reset();
    EXPECT_EQ(newState.baseDestructors, 1u);
    EXPECT_EQ(ConstructionStats(newStorage).usedBytes, newBefore.usedBytes);
}

void VerifyArrayOwnerReentry<S, const usize Empty>(mut S oldStorage, mut S newStorage){
    const ArenaMemoryStats oldBefore = ConstructionStats(oldStorage);
    const ArenaMemoryStats newBefore = ConstructionStats(newStorage);
    usize oldDestroyed = 0u;
    usize newDestroyed = 0u;
    {
        ReentryArrayStorage<S, Empty> oldMemory(oldStorage, 2u);
        ASSERT_TRUE(oldMemory.available());
        ReentryArrayStorage<S, Empty> newMemory(newStorage, 1u);
        ASSERT_TRUE(newMemory.available());
        ArrayProbeOwner<S, Empty> sink;
        auto replacement = newMemory.constructOne(newDestroyed);
        ArrayProbeOwner<S, Empty> slot;
        ArrayRebinding<S, Empty> binding(slot, replacement, sink);
        auto pair = oldMemory.constructPair(oldDestroyed, binding);
        TransferProbe(slot, pair);
        slot.reset();
        EXPECT_FALSE(ProbePresent(slot));
        EXPECT_FALSE(ProbePresent(replacement));
        EXPECT_TRUE(ProbePresent(sink));
        EXPECT_EQ(oldDestroyed, 2u);
        sink.reset();
        EXPECT_EQ(newDestroyed, 1u);
    }
    EXPECT_EQ(ConstructionStats(oldStorage).usedBytes, oldBefore.usedBytes);
    EXPECT_EQ(ConstructionStats(newStorage).usedBytes, newBefore.usedBytes);
}


