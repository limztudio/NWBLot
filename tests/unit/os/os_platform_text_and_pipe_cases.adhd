void VerifyWin32TextInputFixture_ImeContextVisibilityTracksSessionAfterActivationAndPreservesOtherFlags(mut Win32TextInputFixture self){
    native(mut self){
#if defined(NWB_PLATFORM_WINDOWS)
        ASSERT_TRUE(self.m_service->end(self.m_token));
        const isize flags = static_cast<isize>(ISC_SHOWUICOMPOSITIONWINDOW | ISC_SHOWUICANDIDATEWINDOW | (ISC_SHOWUICANDIDATEWINDOW << 2u) | (1u << 20u));
        const usize before = self.m_contextForwardCount;
        const LRESULT inactiveResult = SendMessageW(self.m_window, WM_IME_SETCONTEXT, TRUE, static_cast<LPARAM>(flags));
        EXPECT_EQ(self.m_contextForwardCount, before + 1u);
        EXPECT_EQ(self.m_lastContextForwardedFlags, flags);
        EXPECT_EQ(inactiveResult, self.m_lastContextDefaultResult);

        const auto begun = self.m_service->begin({});
        ASSERT_TRUE(begun);
        self.m_token = *begun;
        EXPECT_EQ(self.m_contextForwardCount, before + 2u);
        EXPECT_EQ(self.m_lastContextForwardedFlags, flags & ~static_cast<isize>(ISC_SHOWUICOMPOSITIONWINDOW));
        const LRESULT activeResult = SendMessageW(self.m_window, WM_IME_SETCONTEXT, TRUE, static_cast<LPARAM>(flags));
        EXPECT_EQ(self.m_contextForwardCount, before + 3u);
        EXPECT_EQ(self.m_lastContextForwardedFlags, flags & ~static_cast<isize>(ISC_SHOWUICOMPOSITIONWINDOW));
        EXPECT_EQ(activeResult, self.m_lastContextDefaultResult);
        ASSERT_TRUE(self.m_service->end(self.m_token));
        EXPECT_EQ(self.m_contextForwardCount, before + 4u);
        EXPECT_EQ(self.m_lastContextForwardedFlags, flags);
#else
        (void)self;
#endif
    }
}

void VerifyWin32TextInputFixture_ImeContextReplayNeverReactivatesAfterFocusLossOrNativeDeactivation(mut Win32TextInputFixture self){
    native(mut self){
#if defined(NWB_PLATFORM_WINDOWS)
        ASSERT_TRUE(self.m_service->end(self.m_token));
        const isize flags = static_cast<isize>(ISC_SHOWUICOMPOSITIONWINDOW | ISC_SHOWUICANDIDATEWINDOW | (1u << 20u));
        SendMessageW(self.m_window, WM_IME_SETCONTEXT, TRUE, static_cast<LPARAM>(flags));
        const auto begun = self.m_service->begin({});
        ASSERT_TRUE(begun);
        self.m_token = *begun;
        const usize beforeFocusLoss = self.m_contextForwardCount;
        ASSERT_TRUE(self.m_service->setFocused(false));
        EXPECT_EQ(self.m_contextForwardCount, beforeFocusLoss);
        const LRESULT deactivationResult = SendMessageW(self.m_window, WM_IME_SETCONTEXT, FALSE, static_cast<LPARAM>(flags));
        EXPECT_EQ(self.m_contextForwardCount, beforeFocusLoss + 1u);
        EXPECT_EQ(self.m_lastContextForwardedFlags, flags);
        EXPECT_EQ(deactivationResult, self.m_lastContextDefaultResult);

        ASSERT_TRUE(self.m_service->setFocused(true));
        const auto second = self.m_service->begin({});
        ASSERT_TRUE(second);
        self.m_token = *second;
        EXPECT_EQ(self.m_contextForwardCount, beforeFocusLoss + 1u);
        ASSERT_TRUE(self.m_service->end(self.m_token));
        EXPECT_EQ(self.m_contextForwardCount, beforeFocusLoss + 1u);
#else
        (void)self;
#endif
    }
}

void VerifyWin32TextInputFixture_ReentrantFocusCancellationRestoresNativeImeVisibilityAndKeepsCancelEvent(mut Win32TextInputFixture self){
    native(mut self){
#if defined(NWB_PLATFORM_WINDOWS)
        ASSERT_TRUE(self.m_service->end(self.m_token));
        const isize flags = static_cast<isize>(ISC_SHOWUICOMPOSITIONWINDOW | ISC_SHOWUICANDIDATEWINDOW | (1u << 20u));
        SendMessageW(self.m_window, WM_IME_SETCONTEXT, TRUE, static_cast<LPARAM>(flags));
        const usize before = self.m_contextForwardCount;
        self.m_cancelOnNextContextForward = true;
        const auto begun = self.m_service->begin({});
        ASSERT_FALSE(begun);
        EXPECT_EQ(begun.error(), TextInputAdmission::Unavailable);
        EXPECT_FALSE(begun.has_value());
        EXPECT_FALSE(self.m_cancelOnNextContextForward);
        EXPECT_TRUE(self.m_contextFocusLossSucceeded);
        EXPECT_TRUE(self.m_contextFocusRestoreSucceeded);
        EXPECT_TRUE(self.m_cancelledDuringContextToken.valid());
        EXPECT_EQ(self.m_contextForwardCount, before + 2u);
        EXPECT_EQ(self.m_lastContextForwardedFlags, flags);

        TextInputEvent event(self.m_arena.arena);
        ASSERT_EQ(self.m_service->poll(self.m_cancelledDuringContextToken, event), TextInputPollResult::Event);
        EXPECT_EQ(event.kind, TextInputEventKind::Cancelled);
        EXPECT_EQ(event.cancelReason, TextInputCancelReason::FocusLost);
        EXPECT_EQ(self.m_service->poll(self.m_cancelledDuringContextToken, event), TextInputPollResult::InvalidSession);
        EXPECT_EQ(self.m_sceneCharacterCount, 0u);
#else
        (void)self;
#endif
    }
}

