#include "skinned_caustic_runtime.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SkinnedCausticSmokeProject : IProjectEntryCallbacks{
    public SkinnedCausticSmokeProject(mut ProjectRuntimeContext context){
        this.m_impl = SkinnedCausticSmokeProjectImpl(context);
    }

    public b8 onStartup()override{
        return this.m_impl.onStartup();
    }

    public void onShutdown()override{
        this.m_impl.onShutdown();
    }

    public b8 onUpdate(in f32 delta)override{
        return this.m_impl.onUpdate(delta);
    }

    private SkinnedCausticSmokeProjectImpl m_impl;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
