#include "types.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_model/system.adhd.h>

#include <core/ecs/entity.h>

#include <global/optional.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using World = Core::ECS::World;
using Entity = Core::ECS::Entity;

void ApplyModelObjectRenderer(Core::ECS::EntityID owner, const Core::Assets::AssetRef<Material>& material, World& world, Entity& entity)noexcept;

[[nodiscard]] NWB_INLINE Optional<RendererComponent> TryGetOwnerRendererComponent(const World& world, const Core::ECS::EntityID owner)noexcept{
    if(const RendererComponent* const ownerRenderer = world.tryGetComponent<RendererComponent>(owner))
        return *ownerRenderer;
    return {};
}

NWB_INLINE void CopyOwnerMaterialInstanceIfPresent(const World& world, const Core::ECS::EntityID owner, MaterialInstanceComponent& outMaterialInstance){
    if(const MaterialInstanceComponent* const ownerMaterialInstance = world.tryGetComponent<MaterialInstanceComponent>(owner))
        CopyModelObjectMaterialInstance(*ownerMaterialInstance, outMaterialInstance);
}

[[nodiscard]] NWB_INLINE ModelObjectRendererHooks CreateModelObjectRendererHooks()noexcept{
    static const Array<Core::ECS::ComponentAccess, 2> s_Accesses = {{
        { Core::ECS::ComponentType<RendererComponent>(), Core::ECS::AccessMode::Write },
        { Core::ECS::ComponentType<MaterialInstanceComponent>(), Core::ECS::AccessMode::Write },
    }};
    return ModelObjectRendererHooks{ &ApplyModelObjectRenderer, Span<const Core::ECS::ComponentAccess>(s_Accesses.data(), s_Accesses.size()) };
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ApplyModelObjectRenderer(in EntityID owner, in AssetRef<Material> material, mut World world, mut Entity entity){
    const Optional<RendererComponent> ownerRenderer = TryGetOwnerRendererComponent(world, owner);
    RendererComponent fallbackRenderer = RendererComponent();
    if(ownerRenderer.has_value())
        fallbackRenderer = ownerRenderer.value();
    const Expected<RendererComponent> resolvedRenderer = TryResolveModelObjectRendererComponent(
        material,
        ownerRenderer.has_value(),
        fallbackRenderer
    );
    if(!resolvedRenderer.has_value())
        return;

    mut RendererComponent renderer = entity.addComponent<RendererComponent>();
    renderer = resolvedRenderer.value();

    mut MaterialInstanceComponent materialInstance = entity.addComponent<MaterialInstanceComponent>();
    CopyOwnerMaterialInstanceIfPresent(world, owner, materialInstance);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

