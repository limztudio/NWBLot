////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_skeleton/joint_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
enum<u32> SkeletonSkinningMode{
    LinearBlend = 0u,
    DualQuaternion = 1u
}

b8 ValidSkeletonSkinningMode(in u32 mode){
    return mode == cast<u32>(SkeletonSkinningMode::LinearBlend) || mode == cast<u32>(SkeletonSkinningMode::DualQuaternion);
}

const f32 s_SkeletonAffineEpsilon = 0.000001f;
const f32 s_SkeletonJointDeterminantEpsilon = 0.000000000001f;
const f32 s_SkeletonRigidJointEpsilon = 0.001f;

[reflect]
class SkeletonJointPaletteComponent{
    public Vector<SkeletonJointMatrix> joints;
    public u32 skinningMode = cast<u32>(SkeletonSkinningMode::LinearBlend);
}

[reflect]
class SkeletonPoseComponent{
    public Vector<u32> parentJoints;
    public Vector<SkeletonJointMatrix> localJoints;
    public u32 skinningMode = cast<u32>(SkeletonSkinningMode::LinearBlend);
}

b8 HasSkeletonPoseData(in SkeletonPoseComponent pose){
    return !pose.localJoints.empty() || !pose.parentJoints.empty();
}

b8 ValidSkeletonPoseTopology(in SkeletonPoseComponent pose){
    if(!ValidSkeletonSkinningMode(pose.skinningMode))
        return false;
    const usize jointCount = pose.localJoints.size();
    if(jointCount == 0u || pose.parentJoints.size() != jointCount || jointCount > 0xffffffffu)
        return false;
    for(usize jointIndex = 0u; jointIndex < jointCount; ++jointIndex){
        const u32 parentJoint = pose.parentJoints[jointIndex];
        if(parentJoint != s_SkeletonInvalidJointIndex && cast<usize>(parentJoint) >= jointIndex)
            return false;
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

