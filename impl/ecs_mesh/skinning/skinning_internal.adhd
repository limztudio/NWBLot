class MeshSkinningFrameResourceImports : NoCopy{
    private mut MeshSkinningSystem m_system;
    private mut GpuTaskGraph m_graph;

    public MeshSkinningFrameResourceImports(mut MeshSkinningSystem system, mut GpuTaskGraph graph){
        this.m_system = system;
        this.m_graph = graph;
    }

    public b8 import(in MeshSkinningRuntimeInstance instance, in MeshSkinningRuntimeResources resources, mut MeshSkinningGraphDispatchPlan plan){
        const b8 hasActiveSkin = plan.hasActiveSkin;
        const b8 copiesRestStreams = plan.copiedRestStreams;
        const b8 updatesMeshletBounds = plan.updatesMeshletBounds;

        const Expected<GpuGraphResourceId> bindlessResourceSlotsResourceResult = this.importBuffer(plan.bindlessResourceSlotsBuffer, s_BindlessSlotsLabel);
        Expected<GpuGraphResourceId> restPositionResourceResult = MakeUnexpected(Failure());
        Expected<GpuGraphResourceId> restNormalResourceResult = MakeUnexpected(Failure());
        Expected<GpuGraphResourceId> restTangentResourceResult = MakeUnexpected(Failure());
        Expected<GpuGraphResourceId> skinnedPositionResourceResult = MakeUnexpected(Failure());
        Expected<GpuGraphResourceId> skinnedNormalResourceResult = MakeUnexpected(Failure());
        Expected<GpuGraphResourceId> skinnedTangentResourceResult = MakeUnexpected(Failure());
        Expected<GpuGraphResourceId> meshletDescResourceResult = MakeUnexpected(Failure());
        Expected<GpuGraphResourceId> meshletPositionRefDeltaResourceResult = MakeUnexpected(Failure());
        Expected<GpuGraphResourceId> meshletLocalVertexRefResourceResult = MakeUnexpected(Failure());
        Expected<GpuGraphResourceId> meshletPrimitiveIndexResourceResult = MakeUnexpected(Failure());
        Expected<GpuGraphResourceId> meshletBoundsResourceResult = MakeUnexpected(Failure());
        Expected<GpuGraphResourceId> meshletLocalBoundsResourceResult = MakeUnexpected(Failure());
        Expected<GpuGraphResourceId> localBoundsResourceResult = MakeUnexpected(Failure());
        Expected<GpuGraphResourceId> meshletAttributeRefDeltaResourceResult = MakeUnexpected(Failure());
        Expected<GpuGraphResourceId> attributeSkinResourceResult = MakeUnexpected(Failure());
        Expected<GpuGraphResourceId> skinResourceResult = MakeUnexpected(Failure());
        Expected<GpuGraphResourceId> jointPaletteResourceResult = MakeUnexpected(Failure());
        Expected<GpuGraphResourceId> attributeResourceResult = MakeUnexpected(Failure());

        if(hasActiveSkin || copiesRestStreams){
            restPositionResourceResult = this.importBuffer(instance.restPositionBuffer, s_RestPositionsLabel);
            restNormalResourceResult = this.importBuffer(instance.restNormalBuffer, s_RestNormalsLabel);
            restTangentResourceResult = this.importBuffer(instance.restTangentBuffer, s_RestTangentsLabel);
            skinnedPositionResourceResult = this.importBuffer(instance.skinnedPositionBuffer, s_SkinnedPositionsLabel);
            skinnedNormalResourceResult = this.importBuffer(instance.skinnedNormalBuffer, s_SkinnedNormalsLabel);
            skinnedTangentResourceResult = this.importBuffer(instance.skinnedTangentBuffer, s_SkinnedTangentsLabel);
        }
        if(updatesMeshletBounds){
            this.importBufferIfNeeded(skinnedPositionResourceResult, instance.skinnedPositionBuffer, s_SkinnedPositionsLabel);
            meshletDescResourceResult = this.importBuffer(instance.meshletDescBuffer, s_MeshletDescriptorsLabel);
            meshletPositionRefDeltaResourceResult = this.importBuffer(instance.meshletPositionRefDeltaBuffer, s_MeshletPositionDeltasLabel);
            meshletLocalVertexRefResourceResult = this.importBuffer(instance.meshletLocalVertexRefBuffer, s_MeshletLocalVertexRefsLabel);
            meshletPrimitiveIndexResourceResult = this.importBuffer(instance.meshletPrimitiveIndexBuffer, s_MeshletPrimitiveIndicesLabel);
            meshletBoundsResourceResult = this.importBuffer(instance.meshletBoundsBuffer, s_MeshletBoundsLabel);
            meshletLocalBoundsResourceResult = this.importBuffer(instance.meshletLocalBoundsBuffer, s_MeshletLocalBoundsLabel);
            localBoundsResourceResult = this.importBuffer(instance.localBoundsBuffer, s_LocalBoundsLabel);
        }
        if(hasActiveSkin){
            meshletAttributeRefDeltaResourceResult = this.importBuffer(instance.meshletAttributeRefDeltaBuffer, s_MeshletAttributeDeltasLabel);
            attributeSkinResourceResult = this.importBuffer(instance.attributeSkinBuffer, s_AttributeSkinsLabel);
            skinResourceResult = this.importBuffer(resources.skinBuffer, s_SkinningInfluencesLabel);
            jointPaletteResourceResult = this.importBuffer(resources.jointPaletteBuffer, s_SkinningJointPaletteLabel);
        }
        if(plan.repacksNormals){
            this.importBufferIfNeeded(skinnedNormalResourceResult, instance.skinnedNormalBuffer, s_SkinnedNormalsLabel);
            this.importBufferIfNeeded(meshletDescResourceResult, instance.meshletDescBuffer, s_MeshletDescriptorsLabel);
            this.importBufferIfNeeded(meshletPrimitiveIndexResourceResult, instance.meshletPrimitiveIndexBuffer, s_MeshletPrimitiveIndicesLabel);
            this.importBufferIfNeeded(meshletAttributeRefDeltaResourceResult, instance.meshletAttributeRefDeltaBuffer, s_MeshletAttributeDeltasLabel);
            this.importBufferIfNeeded(meshletLocalVertexRefResourceResult, instance.meshletLocalVertexRefBuffer, s_MeshletLocalVertexRefsLabel);
            attributeResourceResult = this.importBuffer(instance.attributeBuffer, s_RayTraceAttributesLabel);
        }

        const Expected<GpuGraphPipelineId> boundsPipelineResult = this.importComputePipeline(this.m_system.m_boundsComputePipeline, s_GraphBoundsPipelineName, s_BoundsPipelineLabel);
        const Expected<GpuGraphPipelineId> localBoundsPipelineResult = this.importComputePipeline(this.m_system.m_localBoundsComputePipeline, s_GraphLocalBoundsPipelineName, s_LocalBoundsPipelineLabel);
        Expected<GpuGraphPipelineId> skinningPipelineResult = MakeUnexpected(Failure());
        if(hasActiveSkin)
            skinningPipelineResult = this.importComputePipeline(this.m_system.m_skinningComputePipeline, s_GraphSkinningPipelineName, s_SkinningPipelineLabel);
        Expected<GpuGraphPipelineId> repackPipelineResult = MakeUnexpected(Failure());
        if(plan.repacksNormals)
            repackPipelineResult = this.importComputePipeline(this.m_system.m_repackComputePipeline, s_GraphRepackPipelineName, s_RepackPipelineLabel);

        if(!ValidateMeshSkinningGraphResourceImports(
            bindlessResourceSlotsResourceResult.has_value(),
            skinnedPositionResourceResult.has_value(),
            meshletDescResourceResult.has_value(),
            meshletPositionRefDeltaResourceResult.has_value(),
            meshletLocalVertexRefResourceResult.has_value(),
            meshletPrimitiveIndexResourceResult.has_value(),
            meshletBoundsResourceResult.has_value(),
            boundsPipelineResult.has_value(),
            meshletLocalBoundsResourceResult.has_value(),
            localBoundsResourceResult.has_value(),
            localBoundsPipelineResult.has_value(),
            hasActiveSkin,
            copiesRestStreams,
            plan.repacksNormals,
            restPositionResourceResult.has_value(),
            restNormalResourceResult.has_value(),
            restTangentResourceResult.has_value(),
            skinnedNormalResourceResult.has_value(),
            skinnedTangentResourceResult.has_value(),
            meshletAttributeRefDeltaResourceResult.has_value(),
            attributeSkinResourceResult.has_value(),
            skinResourceResult.has_value(),
            jointPaletteResourceResult.has_value(),
            skinningPipelineResult.has_value(),
            attributeResourceResult.has_value(),
            repackPipelineResult.has_value()
        )){
            error("MeshSkinningSystem: runtime mesh '{}' has no graph-importable dispatch resource", instance.handle.value);
            return false;
        }

        this.assignResource(bindlessResourceSlotsResourceResult, plan.bindlessResourceSlotsResource);
        this.assignResource(restPositionResourceResult, plan.restPositionResource);
        this.assignResource(restNormalResourceResult, plan.restNormalResource);
        this.assignResource(restTangentResourceResult, plan.restTangentResource);
        this.assignResource(skinnedPositionResourceResult, plan.skinnedPositionResource);
        this.assignResource(skinnedNormalResourceResult, plan.skinnedNormalResource);
        this.assignResource(skinnedTangentResourceResult, plan.skinnedTangentResource);
        this.assignResource(meshletDescResourceResult, plan.meshletDescResource);
        this.assignResource(meshletPositionRefDeltaResourceResult, plan.meshletPositionRefDeltaResource);
        this.assignResource(meshletLocalVertexRefResourceResult, plan.meshletLocalVertexRefResource);
        this.assignResource(meshletPrimitiveIndexResourceResult, plan.meshletPrimitiveIndexResource);
        this.assignResource(meshletBoundsResourceResult, plan.meshletBoundsResource);
        this.assignResource(meshletLocalBoundsResourceResult, plan.meshletLocalBoundsResource);
        this.assignResource(localBoundsResourceResult, plan.localBoundsResource);
        this.assignResource(meshletAttributeRefDeltaResourceResult, plan.meshletAttributeRefDeltaResource);
        this.assignResource(attributeSkinResourceResult, plan.attributeSkinResource);
        this.assignResource(skinResourceResult, plan.skinResource);
        this.assignResource(jointPaletteResourceResult, plan.jointPaletteResource);
        this.assignResource(attributeResourceResult, plan.attributeResource);
        this.assignPipeline(boundsPipelineResult, plan.boundsPipeline);
        this.assignPipeline(localBoundsPipelineResult, plan.localBoundsPipeline);
        this.assignPipeline(skinningPipelineResult, plan.skinningPipeline);
        this.assignPipeline(repackPipelineResult, plan.repackPipeline);
        return true;
    }

    private void importBufferIfNeeded(mut Expected<GpuGraphResourceId> slot, in BufferHandle buffer, in StringView label){
        if(!slot.has_value())
            slot = this.importBuffer(buffer, label);
    }

    private void assignResource(in Expected<GpuGraphResourceId> result, mut GpuGraphResourceId outResource){
        if(result.has_value())
            outResource = result.value();
    }

    private void assignPipeline(in Expected<GpuGraphPipelineId> result, mut GpuGraphPipelineId outPipeline){
        if(result.has_value())
            outPipeline = result.value();
    }

    private Expected<GpuGraphResourceId> importBuffer(in BufferHandle buffer, in StringView label){
        if(!buffer.valid())
            return MakeUnexpected(Failure());
        in BufferDesc description = buffer.deref().getCreationDescription();
        if(description.debugName == s_NameNone)
            return MakeUnexpected(Failure());
        GpuGraphResourceDesc desc = GpuGraphResourceDesc();
        desc
            .setIdentity(description.debugName)
            .setMarkerLabel(label)
            .setType(GpuGraphResourceType::Buffer)
            .setInitialState(description.initialState)
            .setQueueSharing(description.queueSharing)
        ;
        return this.m_graph.importBuffer(buffer, desc);
    }

    private Expected<GpuGraphPipelineId> importComputePipeline(in ComputePipelineHandle pipeline, in Name identity, in StringView label){
        GpuGraphPipelineDesc desc = GpuGraphPipelineDesc();
        desc.setIdentity(identity).setMarkerLabel(label).setType(GpuGraphPipelineType::Compute);
        return this.m_graph.importComputePipeline(pipeline, desc);
    }
}

[cpp_name("::NWB::Impl::MeshSkinningGraphDispatchPlanVector")]
extern class MeshSkinningGraphDispatchPlanVector;

// Per-mesh declarations of one skinning frame: the immutable dispatch plan plus its selector upload, rest-to-skinned copy, and joint-palette upload.
// Every declared transfer chains on one serial dependency that the frame's deformation task then follows.
[modular]
class MeshSkinningFramePlanBuilder : NoCopy{
    private mut MeshSkinningSystem m_system;
    private mut GpuTaskGraph m_graph;
    private mut MeshSkinningGraphDispatchPlanVector m_plans;
    private GpuTaskId m_terminalTask;

    public MeshSkinningFramePlanBuilder(
        mut MeshSkinningSystem system,
        mut GpuTaskGraph graph,
        mut MeshSkinningGraphDispatchPlanVector plans
    ){
        this.m_system = system;
        this.m_graph = graph;
        this.m_plans = plans;
    }

    // False only for a frame-fatal declaration failure; meshes without a ready pose or dirty bounds are skipped.
    public b8 declare(in EntityID entity, mut SkinnedMeshBindingComponent binding);

    public GpuTaskId terminalTask()const{
        return this.m_terminalTask;
    }

    private b8 declareUploadTask(
        in MeshSkinningRuntimeInstance instance,
        in StringView identitySuffix,
        in StringView markerLabel,
        in Span<u8> data,
        in usize dataAlignment,
        in GpuGraphResourceId destination,
        in ResourceStates finalState,
        in StringView retainErrorLabel,
        in StringView declareErrorLabel
    );
    private b8 declareBindlessSlotsUpload(in MeshSkinningRuntimeInstance instance, in MeshSkinningRuntimeResources resources, mut MeshSkinningGraphDispatchPlan plan);
    private b8 declareRestToSkinnedCopy(in MeshSkinningRuntimeInstance instance, in MeshSkinningGraphDispatchPlan plan);
    private b8 declareJointPaletteUpload(in MeshSkinningRuntimeInstance instance, in Span<SkeletonJointMatrix> jointPaletteUpload, in MeshSkinningGraphDispatchPlan plan);
}


