#include "style.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The default key step is one hundredth of the range.
const f64 s_SliderDefaultKeyStepDivisor = 100.0;
const u32 s_SliderPageStepCount = 10u;

class SliderStyle{
    public Name track = Name("slider.track");
    public Name normal = Name("slider.thumb.normal");
    public Name hover = Name("slider.thumb.hover");
    public Name pressed = Name("slider.thumb.pressed");
    public Name disabled = Name("slider.thumb.disabled");
    public Name trackFallback = Name("scrollbar.track");
    public Name thumbFallback = Name("scrollbar.thumb.normal");
    public Name focus = Name("focus.overlay");
    public Color hoverTint = s_StyleHoverTint;
    public Color pressedTint = s_StylePressedTint;
    public Color disabledTint = s_StyleDisabledTint;
    public Insets padding = Insets(s_StyleSpacingSmall, s_StyleSpacingSmall, s_StyleSpacingSmall, s_StyleSpacingSmall);
    public Point thumbExtent = Point(s_StyleControlExtent, s_StyleControlExtent);
    public f32 trackHeight = s_StyleSliderTrackHeight;
}

class SliderOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public f32 height = s_StyleControlHeight;
    public b8 enabled = true;
    public f64 minimum = 0.0;
    public f64 maximum = 1.0;
    // Zero chooses one hundredth of the range, with a representable fallback for tiny spans.
    public f64 keyStep = 0.0;
}

class SliderResult{
    public b8 valid = false;
    public b8 valueChanged = false;
    public b8 focused = false;
    public b8 dragging = false;
}

class SliderSnapshot{
    public b8 operator==(in SliderSnapshot rhs)const{
        return this.instanceGeneration == rhs.instanceGeneration
            && this.inputGeneration == rhs.inputGeneration
            && this.revision == rhs.revision
            && this.admissionGeneration == rhs.admissionGeneration
            && this.valueBits == rhs.valueBits
            && this.press == rhs.press
            && this.pressMoved == rhs.pressMoved;
    }

    public b8 operator!=(in SliderSnapshot rhs)const{
        return this.instanceGeneration != rhs.instanceGeneration
            || this.inputGeneration != rhs.inputGeneration
            || this.revision != rhs.revision
            || this.admissionGeneration != rhs.admissionGeneration
            || this.valueBits != rhs.valueBits
            || this.press != rhs.press
            || this.pressMoved != rhs.pressMoved;
    }

    public u64 instanceGeneration = 0u;
    public u64 inputGeneration = 0u;
    public u64 revision = 0u;
    public u64 admissionGeneration = 0u;
    public u64 valueBits = 0u;
    public InputActionId press;
    public b8 pressMoved = false;
}

class SliderMetrics{
    public Insets padding;
    public Point thumbExtent = Point(s_StyleControlExtent, s_StyleControlExtent);
    public f32 trackHeight = s_StyleSliderTrackHeight;
    public Point contentSize;
}

class SliderPlacement{
    public Rect bounds;
    public Rect clip;
    public Rect travelBounds;
    public Rect track;
    public Rect centerTravel;
    public Rect thumb;
    public Point thumbExtent;
}

b8 SameSliderPlacementGeometry(in SliderPlacement lhs, in SliderPlacement rhs){
    return EqualUiRect(lhs.bounds, rhs.bounds)
        && EqualUiRect(lhs.clip, rhs.clip)
        && EqualUiRect(lhs.travelBounds, rhs.travelBounds)
        && EqualUiRect(lhs.track, rhs.track)
        && EqualUiRect(lhs.centerTravel, rhs.centerTravel)
        && bit_cast<u32>(lhs.thumbExtent.x) == bit_cast<u32>(rhs.thumbExtent.x)
        && bit_cast<u32>(lhs.thumbExtent.y) == bit_cast<u32>(rhs.thumbExtent.y);
}

b8 IsValidSliderRange(in f64 minimum, in f64 maximum){
    return isFinite(minimum) && isFinite(maximum) && minimum <= maximum;
}

b8 IsValidSliderPlacement(in SliderPlacement placement){
    return IsPreciseUiRect(placement.bounds)
        && IsPreciseUiRect(placement.clip)
        && IsPreciseUiRect(placement.travelBounds)
        && IsPreciseUiRect(placement.track)
        && IsPreciseUiRect(placement.centerTravel)
        && IsPreciseUiRect(placement.thumb)
        && IsValidUiExtent(placement.thumbExtent)
        && placement.thumbExtent.x == placement.thumb.width
        && placement.thumbExtent.y == placement.thumb.height
        && placement.thumbExtent.x <= placement.travelBounds.width
        && placement.thumbExtent.y <= placement.travelBounds.height
        && placement.centerTravel.width <= placement.travelBounds.width
        && placement.centerTravel.height <= placement.travelBounds.height
        && placement.track.width <= placement.travelBounds.width
        && placement.track.height <= placement.travelBounds.height;
}

b8 IsValidSliderGesture(in PointerGesture gesture){
    return gesture.id.valid()
        && gesture.updateSequence != 0u
        && gesture.state <= PointerGestureState::Completed
        && isFinite(gesture.origin.x)
        && isFinite(gesture.origin.y)
        && isFinite(gesture.position.x)
        && isFinite(gesture.position.y)
        && IsPreciseUiRect(gesture.targetRectangle)
        && IsPreciseUiRect(gesture.referenceRectangle);
}

b8 IsValidSliderOptions(in SliderOptions options){
    return IsValidSliderRange(options.minimum, options.maximum)
        && isFinite(options.keyStep)
        && options.keyStep >= 0.0
        && IsValidLayoutSize(options.width)
        && isFinite(options.height)
        && options.height >= 0.0f;
}

void ApplySkinPaletteToSliderStyle(in UiSkinPalette palette, mut SliderStyle style){
    style.hoverTint = ResolveUiSkinColor(palette, UiSkinColorRole::ControlHoverTint);
    style.pressedTint = ResolveUiSkinColor(palette, UiSkinColorRole::ControlPressedTint);
    style.disabledTint = ResolveUiSkinColor(palette, UiSkinColorRole::ControlDisabledTint);
}

b8 IsValidSliderMetrics(in SliderMetrics metrics){
    if(
        !IsValidUiPadding(metrics.padding)
        || !isFinite(metrics.thumbExtent.x) || metrics.thumbExtent.x <= 0.0f
        || !isFinite(metrics.thumbExtent.y) || metrics.thumbExtent.y <= 0.0f
        || !isFinite(metrics.trackHeight) || metrics.trackHeight <= 0.0f
        || !IsValidUiExtent(metrics.contentSize)
    )
        return false;
    const f64 padW = cast<f64>(metrics.padding.left) + cast<f64>(metrics.padding.right);
    const f64 padH = cast<f64>(metrics.padding.top) + cast<f64>(metrics.padding.bottom);
    const f64 width = padW + cast<f64>(metrics.thumbExtent.x);
    const f64 height = padH + max(cast<f64>(metrics.thumbExtent.y), cast<f64>(metrics.trackHeight));
    return width <= s_UiMaxFloatF64
        && height <= s_UiMaxFloatF64
        && cast<f64>(metrics.contentSize.x) >= cast<f64>(cast<f32>(width))
        && cast<f64>(metrics.contentSize.y) >= cast<f64>(cast<f32>(height));
}

Expected<SliderMetrics> TryMeasureSlider(in SliderOptions options, in SliderStyle style){
    if(
        !IsValidSliderOptions(options)
        || !IsValidUiPadding(style.padding)
        || !isFinite(style.thumbExtent.x) || style.thumbExtent.x <= 0.0f
        || !isFinite(style.thumbExtent.y) || style.thumbExtent.y <= 0.0f
        || !isFinite(style.trackHeight) || style.trackHeight <= 0.0f
        || !IsValidUiColor(style.hoverTint) || !IsValidUiColor(style.pressedTint) || !IsValidUiColor(style.disabledTint)
    )
        return makeUnexpected(Failure());
    SliderMetrics candidate;
    candidate.padding = style.padding;
    candidate.thumbExtent = style.thumbExtent;
    candidate.trackHeight = style.trackHeight;
    const f64 padW = cast<f64>(style.padding.left) + cast<f64>(style.padding.right);
    const f64 padH = cast<f64>(style.padding.top) + cast<f64>(style.padding.bottom);
    const f64 width = padW + cast<f64>(style.thumbExtent.x);
    const f64 intrinsicH = padH + max(cast<f64>(style.thumbExtent.y), cast<f64>(style.trackHeight));
    const f64 height = max(intrinsicH, cast<f64>(options.height));
    if(!isFinite(width) || width > s_UiMaxFloatF64 || !isFinite(height) || height > s_UiMaxFloatF64)
        return makeUnexpected(Failure());
    candidate.contentSize = Point(cast<f32>(width), cast<f32>(height));
    if(!IsValidSliderMetrics(candidate))
        return makeUnexpected(Failure());
    return candidate;
}

Expected<SliderPlacement> TryPlaceSlider(in Rect bounds, in Rect clip, in SliderMetrics metrics, in f64 normalized){
    if(!IsPreciseUiRect(bounds) || !IsPreciseUiRect(clip) || !IsValidSliderMetrics(metrics) || !isFinite(normalized) || normalized < 0.0 || normalized > 1.0)
        return makeUnexpected(Failure());
    SliderPlacement candidate;
    candidate.bounds = bounds;
    const Expected<Rect> clipped = TryIntersectUiRects(bounds, clip, UiRectPrecision::PreciseExtents);
    if(!clipped.has_value())
        return makeUnexpected(Failure());
    candidate.clip = clipped.value();
    const VectorDouble insetRect = ComputeInsetUiRectBounds(bounds, metrics.padding);
    const f64 x = insetRect.x;
    const f64 y = insetRect.y;
    const f64 w = insetRect.z;
    const f64 h = insetRect.w;
    const f64 thumbW = min(cast<f64>(metrics.thumbExtent.x), max(0.0, w));
    const f64 thumbH = min(cast<f64>(metrics.thumbExtent.y), max(0.0, h));
    const f64 trackH = min(cast<f64>(metrics.trackHeight), h);
    const f64 travelW = w - thumbW;
    const f64 centerStartX = x + thumbW * 0.5;
    const f64 thumbCenterX = x + travelW * normalized;
    f64 thumbX = thumbCenterX;
    if(normalized == 0.0)
        thumbX = x;
    else if(normalized == 1.0)
        thumbX = x + travelW;
    const Expected<Rect> travelBounds = TryMakeUiRect(x, y, w, h, UiRectPrecision::PreciseExtents);
    if(!travelBounds.has_value())
        return makeUnexpected(Failure());
    candidate.travelBounds = travelBounds.value();
    const Expected<Rect> centerTravel = TryMakeUiRect(centerStartX, y, travelW, h, UiRectPrecision::PreciseExtents);
    if(!centerTravel.has_value())
        return makeUnexpected(Failure());
    candidate.centerTravel = centerTravel.value();
    const f64 trackY = y + (h - trackH) * 0.5;
    const f64 thumbY = y + (h - thumbH) * 0.5;
    const Expected<Rect> track = TryMakeUiRect(centerStartX, trackY, travelW, trackH, UiRectPrecision::PreciseExtents);
    if(!track.has_value())
        return makeUnexpected(Failure());
    candidate.track = track.value();
    const Expected<Rect> thumb = TryMakeUiRect(thumbX, thumbY, thumbW, thumbH, UiRectPrecision::PreciseExtents);
    if(!thumb.has_value())
        return makeUnexpected(Failure());
    candidate.thumb = thumb.value();
    candidate.thumbExtent = Point(cast<f32>(thumbW), cast<f32>(thumbH));
    return candidate;
}

f64 ResolveSliderKeyStep(in f64 minimum, in f64 maximum, in f64 configuredStep){
    if(configuredStep > 0.0)
        return configuredStep;
    const f64 span = maximum - minimum;
    if(isFinite(span)){
        const f64 step = span / s_SliderDefaultKeyStepDivisor;
        if(step == 0.0)
            return span;
        return step;
    }
    return (maximum / s_SliderDefaultKeyStepDivisor) - (minimum / s_SliderDefaultKeyStepDivisor);
}


Expected<f64> TryStepSliderValue(in f64 currentValue, in SliderOptions options, in ControlActionKind kind){
    f64 step = 0.0;
    f64 value = currentValue;
    switch(kind){
    case ControlActionKind::Left:
    case ControlActionKind::Down:
        step = ResolveSliderKeyStep(options.minimum, options.maximum, options.keyStep);
        value = stepF64Bounded(value, options.minimum, options.maximum, step, false);
        break;
    case ControlActionKind::Right:
    case ControlActionKind::Up:
        step = ResolveSliderKeyStep(options.minimum, options.maximum, options.keyStep);
        value = stepF64Bounded(value, options.minimum, options.maximum, step, true);
        break;
    case ControlActionKind::PageDown:
    case ControlActionKind::PageUp:
        step = ResolveSliderKeyStep(options.minimum, options.maximum, options.keyStep);
        for(u32 index = 0u; index < s_SliderPageStepCount; ++index)
            value = stepF64Bounded(value, options.minimum, options.maximum, step, kind == ControlActionKind::PageUp);
        break;
    case ControlActionKind::Home:
        value = options.minimum;
        break;
    case ControlActionKind::End:
        value = options.maximum;
        break;
    default:
        return currentValue;
    }
    if(!isFinite(value))
        return makeUnexpected(Failure());
    return value;
}



Expected<f64> TryComputeSliderSeekValue(in SliderOptions options, in PointerGesture gesture){
    const f64 normalizedValue = (cast<f64>(gesture.position.x) - cast<f64>(gesture.referenceRectangle.x)) / cast<f64>(gesture.referenceRectangle.width);
    f64 normalized = 0.0;
    if(normalizedValue > 0.0)
        normalized = min(1.0, normalizedValue);
    return interpolateFiniteRange(options.minimum, options.maximum, normalized);
}

b8 TryComputeSliderDragValue(in f64 currentValue, in f64 baseline, in SliderOptions options, in PointerGesture gesture, in b8 previouslyMoved, mut f64 outValue, mut b8 outMoved){
    outValue = currentValue;
    outMoved = previouslyMoved;
    const f64 travel = cast<f64>(gesture.referenceRectangle.width) - cast<f64>(gesture.targetRectangle.width);
    const f64 delta = cast<f64>(gesture.position.x) - cast<f64>(gesture.origin.x);
    if(delta == 0.0){
        if(previouslyMoved)
            outValue = baseline;
        return true;
    }
    const Expected<f64> normalized = normalizeFiniteRange(options.minimum, options.maximum, baseline);
    if(!normalized.has_value())
        return false;
    const f64 normalizedValue = normalized.value() + delta / travel;
    f64 dragged = 0.0;
    if(normalizedValue > 0.0)
        dragged = min(1.0, normalizedValue);
    const Expected<f64> interpolated = interpolateFiniteRange(options.minimum, options.maximum, dragged);
    if(!interpolated.has_value())
        return false;
    outValue = interpolated.value();
    outMoved = true;
    return true;
}

Expected<SliderMetrics> MeasureSlider(in SliderOptions options, in SliderStyle style){
    return TryMeasureSlider(options, style);
}

Expected<SliderPlacement> PlaceSlider(in Rect bounds, in Rect clip, in SliderMetrics metrics, in f64 normalized){
    return TryPlaceSlider(bounds, clip, metrics, normalized);
}



b8 SameSliderOptionsValues(in f64 stateMin, in f64 stateMax, in f64 stateStep, in b8 stateEnabled, in SliderOptions options){
    return bit_cast<u64>(stateMin) == bit_cast<u64>(options.minimum)
        && bit_cast<u64>(stateMax) == bit_cast<u64>(options.maximum)
        && bit_cast<u64>(stateStep) == bit_cast<u64>(options.keyStep)
        && stateEnabled == options.enabled;
}

Expected<b8> TryEvaluateSliderAdmission(
    in b8 admitted,
    in f64 stateMin,
    in f64 stateMax,
    in f64 stateStep,
    in b8 stateEnabled,
    in SliderPlacement stateAdmission,
    in SliderOptions options,
    in SliderPlacement placement
){
    if(!IsValidSliderOptions(options) || !IsValidSliderPlacement(placement))
        return makeUnexpected(Failure());
    return !admitted
        || !SameSliderOptionsValues(stateMin, stateMax, stateStep, stateEnabled, options)
        || !SameSliderPlacementGeometry(stateAdmission, placement);
}

b8 TryApplySliderControlAction(
    in b8 admitted,
    in f64 stateMin,
    in f64 stateMax,
    in f64 stateStep,
    in b8 stateEnabled,
    in ControlToken stateToken,
    in f64 currentValue,
    in SliderOptions options,
    in ControlAction action,
    mut f64 outValue,
    mut b8 outAdvanceRevision,
    mut SliderResult inOutResult
){
    outValue = currentValue;
    outAdvanceRevision = false;
    if(
        !IsValidSliderOptions(options) || !admitted || !action.id.valid() || action.control != stateToken
        || !SameSliderOptionsValues(stateMin, stateMax, stateStep, stateEnabled, options) || action.kind > ControlActionKind::Right
    )
        return false;
    SliderResult accepted = inOutResult;
    accepted.valid = true;
    if(!options.enabled || options.minimum == options.maximum){
        accepted.dragging = false;
        inOutResult = accepted;
        return true;
    }
    if(
        action.kind != ControlActionKind::Left && action.kind != ControlActionKind::Down
        && action.kind != ControlActionKind::Right && action.kind != ControlActionKind::Up
        && action.kind != ControlActionKind::PageDown && action.kind != ControlActionKind::PageUp
        && action.kind != ControlActionKind::Home && action.kind != ControlActionKind::End
    ){
        inOutResult = accepted;
        return true;
    }
    const Expected<f64> value = TryStepSliderValue(currentValue, options, action.kind);
    if(!value.has_value())
        return false;
    accepted.valueChanged = accepted.valueChanged || bit_cast<u64>(currentValue) != bit_cast<u64>(value.value());
    outValue = value.value();
    outAdvanceRevision = true;
    inOutResult = accepted;
    return true;
}

b8 TrySeekSliderPointerGesture(
    in b8 admitted,
    in f64 stateMin,
    in f64 stateMax,
    in f64 stateStep,
    in b8 stateEnabled,
    in ControlToken stateToken,
    in SliderPlacement stateAdmission,
    in f64 currentValue,
    in SliderOptions options,
    in PointerGesture gesture,
    mut f64 outValue,
    mut InputActionId outPress,
    mut b8 outAdvanceRevision,
    mut SliderResult inOutResult
){
    outValue = currentValue;
    outPress = InputActionId();
    outAdvanceRevision = false;
    if(
        !IsValidSliderOptions(options) || !admitted || !IsValidSliderGesture(gesture) || gesture.control != stateToken
        || !SameSliderOptionsValues(stateMin, stateMax, stateStep, stateEnabled, options)
        || !EqualUiRect(gesture.referenceRectangle, stateAdmission.centerTravel)
    )
        return false;
    SliderResult accepted = inOutResult;
    accepted.valid = true;
    if(!options.enabled || options.minimum == options.maximum || gesture.referenceRectangle.width <= 0.0f){
        accepted.dragging = false;
        inOutResult = accepted;
        return true;
    }
    const Expected<f64> value = TryComputeSliderSeekValue(options, gesture);
    if(!value.has_value())
        return false;
    accepted.valueChanged = accepted.valueChanged || bit_cast<u64>(currentValue) != bit_cast<u64>(value.value());
    accepted.dragging = gesture.state == PointerGestureState::Active;
    outValue = value.value();
    if(accepted.dragging)
        outPress = gesture.id;
    outAdvanceRevision = true;
    inOutResult = accepted;
    return true;
}

b8 TryDragSliderPointerGesture(
    in b8 admitted,
    in f64 stateMin,
    in f64 stateMax,
    in f64 stateStep,
    in b8 stateEnabled,
    in ControlToken stateToken,
    in SliderPlacement stateAdmission,
    in f64 currentValue,
    in InputActionId currentPress,
    in b8 currentPressMoved,
    in SliderOptions options,
    in PointerGesture gesture,
    mut f64 outValue,
    mut InputActionId outPress,
    mut b8 outPressMoved,
    mut b8 outAdvanceRevision,
    mut SliderResult inOutResult
){
    outValue = currentValue;
    outPress = currentPress;
    outPressMoved = currentPressMoved;
    outAdvanceRevision = false;
    const f64 baseline = bit_cast<f64>(gesture.value);
    if(
        !IsValidSliderOptions(options) || !admitted || !IsValidSliderGesture(gesture) || gesture.control != stateToken
        || !SameSliderOptionsValues(stateMin, stateMax, stateStep, stateEnabled, options)
        || !EqualUiRect(gesture.referenceRectangle, stateAdmission.travelBounds)
        || gesture.targetRectangle.width != stateAdmission.thumbExtent.x
        || gesture.targetRectangle.height != stateAdmission.thumbExtent.y || !isFinite(baseline)
    )
        return false;
    SliderResult accepted = inOutResult;
    accepted.valid = true;
    const f64 travel = cast<f64>(gesture.referenceRectangle.width) - cast<f64>(gesture.targetRectangle.width);
    if(!options.enabled || options.minimum == options.maximum || travel <= 0.0){
        accepted.dragging = false;
        inOutResult = accepted;
        return true;
    }
    b8 moved = currentPress == gesture.id && currentPressMoved;
    f64 value = currentValue;
    if(!TryComputeSliderDragValue(currentValue, baseline, options, gesture, moved, value, moved))
        return false;
    accepted.valueChanged = accepted.valueChanged || bit_cast<u64>(currentValue) != bit_cast<u64>(value);
    accepted.dragging = gesture.state == PointerGestureState::Active;
    outValue = value;
    outPress = InputActionId();
    if(accepted.dragging)
        outPress = gesture.id;
    outPressMoved = accepted.dragging && moved;
    outAdvanceRevision = true;
    inOutResult = accepted;
    return true;
}

Expected<f32> TryResolveSliderTrackContentWidth(in SliderMetrics metrics, in f32 trackMinimumWidth){
    const f64 width = cast<f64>(metrics.padding.left) + cast<f64>(metrics.padding.right) + cast<f64>(metrics.thumbExtent.x) + cast<f64>(trackMinimumWidth);
    if(!isFinite(width) || width > s_UiMaxFloatF64)
        return makeUnexpected(Failure());
    return max(metrics.contentSize.x, cast<f32>(width));
}

b8 IsSliderPlacementInteractive(in SliderOptions options, in SliderPlacement placement){
    return options.enabled
        && options.minimum != options.maximum
        && placement.centerTravel.width > 0.0f
        && placement.thumb.width > 0.0f
        && placement.thumb.height > 0.0f
        && placement.clip.width > 0.0f
        && placement.clip.height > 0.0f;
}

Color ResolveSliderThumbTint(in SliderStyle style, in b8 interactive, in b8 pressed, in b8 hover){
    if(!interactive)
        return style.disabledTint;
    if(pressed)
        return style.pressedTint;
    if(hover)
        return style.hoverTint;
    return Color();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

