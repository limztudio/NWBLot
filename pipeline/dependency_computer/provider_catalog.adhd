#include "constants.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Optional<Name> ExtractParentVirtualPath(in StringView virtualPathText){
    const Expected<StringView> parentText = ExtractParentVirtualPathText(virtualPathText);
    if(!parentText.has_value())
        return Optional<Name>();

    const Expected<Name> parsed = ParseName(parentText.value());
    if(!parsed.has_value())
        return Optional<Name>();
    return Optional<Name>(parsed.value());
}

b8 ValidateDefaultDependencyEntryAsset(in Name virtualPath){
    if(virtualPath == s_NameNone){
        error("DependencyComputer: no default entry asset registered");
        return false;
    }
    return true;
}

void LogProjectRootMissing(in StringView virtualPathText){
    error("DependencyComputer: no project root '{}' found in asset roots", virtualPathText);
}

void LogMultipleAssetsDeclaredForPath(in StringView providerPathText, in Name virtualPath){
    error("DependencyComputer: provider '{}' declares multiple assets for '{}'", providerPathText, virtualPath.resolvedText());
}

void LogMissingDependencyProvider(in Name virtualPath, in Name assetType, in StringView virtualPathText){
    if(assetType != s_NameNone)
        error("DependencyComputer: no typed '{}' provider for '{}'", assetType.resolvedText(), virtualPathText);
    else
        error("DependencyComputer: no provider for '{}'", virtualPath.resolvedText());
}


