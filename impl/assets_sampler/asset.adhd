////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_sampler/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_SamplerValidatePayloadContext = "Sampler::validatePayload";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidSamplerDescription(in SamplerDesc description){
    return IsValidSamplerDescriptionParameters(
        description.borderColor.r,
        description.borderColor.g,
        description.borderColor.b,
        description.borderColor.a,
        description.maxAnisotropy,
        description.mipBias,
        cast<u32>(description.addressU),
        cast<u32>(description.addressV),
        cast<u32>(description.addressW),
        cast<u32>(description.reductionType)
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[asset("sampler")]
class Sampler{
    private SamplerDesc m_description;


    public b8 validatePayload()const;
    public b8 loadBinary(in Span<u8> binary);

    public void setDescription(in SamplerDesc description){
        this.m_description = description;
    }

    public in SamplerDesc description()const{
        return this.m_description;
    }
}


