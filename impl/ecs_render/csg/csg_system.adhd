#include <impl/ecs_csg/shape_registry.adhd>
#include <impl/ecs_render/material/material_surface_lookup.adhd>
#include <impl/ecs_render/mesh/mesh_system.adhd>
#include <impl/ecs_csg/frame_state.adhd>
#include <impl/ecs_scene/component_types.adhd>
#include <impl/ecs_render/csg/clip_bounds.adhd>
#include <impl/ecs_render/csg/csg_graph_resource_snapshot.adhd>
#include <impl/ecs_render/csg/renderer_csg_state.adhd>
#include <impl/ecs_render/csg/renderer_csg_types.adhd>
#include <impl/ecs_render/deferred/deferred_frame_targets.adhd>
#include <impl/ecs_render/mesh/instance_gpu_data.adhd>
#include <impl/ecs_render/shader/shader_system.adhd>
#include <impl/ecs_render/shared/renderer_frame_bindings.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[modular]
class RendererCsgSystem : NoCopy{
    private mut World m_world;
    private mut GraphicsRuntime m_graphics;
    private mut CsgShapeRegistry m_csgShapeRegistry;
    private mut RendererCsgState m_csgState;
    private mut RendererShaderSystem m_shaderSystem;
    private mut RendererMeshSystem m_meshSystem;

    public RendererCsgSystem(
        mut World world,
        mut GraphicsRuntime graphics,
        mut CsgShapeRegistry csgShapeRegistry,
        mut RendererCsgState csgState,
        mut RendererShaderSystem shaderSystem,
        mut RendererMeshSystem meshSystem
    ){
        this.m_world = world;
        this.m_graphics = graphics;
        this.m_csgShapeRegistry = csgShapeRegistry;
        this.m_csgState = csgState;
        this.m_shaderSystem = shaderSystem;
        this.m_meshSystem = meshSystem;
    }

    public void invalidateResources(){
        this.releaseCsgClipContextHeapHandles();
        this.m_csgState.invalidateResources();
    }

    [cpp_unwind]
    public CsgFrameState buildFrameState(mut IMaterialSurfaceLookup materialSurfaceLookup);
    public b8 createCsgClipResources();
    public b8 createCsgPeelTargets(mut DeferredFrameTargets targets);
    public b8 createCsgIntervalPeelResources(mut DeferredFrameTargets targets, in b8 capFillRequired);
    public b8 createCsgIntervalSampleResources(mut DeferredFrameTargets targets);
    public b8 prepareRefractionIntervalCapResources(in DeferredFrameTargets targets);
    public void dispatchCsgIntervalPeels(
        mut CommandList commandList,
        mut DeferredFrameTargets targets,
        in CsgFrameGpuDataView csgFrameData,
        in CsgGraphResourceSnapshot csgResources,
        in MeshFrameBindingSnapshot frameBindings
    );
    public void dispatchCsgReceiverSpanBuild(mut CommandList commandList, mut DeferredFrameTargets targets, in CsgFrameGpuDataView csgFrameData, in CsgGraphResourceSnapshot csgResources);
    public void dispatchCsgIntervalCombine(mut CommandList commandList, mut DeferredFrameTargets targets, in CsgFrameGpuDataView csgFrameData, in CsgGraphResourceSnapshot csgResources);
    public void renderCsgIntervalCaps(mut CommandList commandList, mut DeferredFrameTargets targets, in CsgFrameGpuDataView csgFrameData, in CsgGraphResourceSnapshot csgResources);
    public void renderRefractionIntervalCaps(mut CommandList commandList, in DeferredFrameTargets targets, in CsgGraphResourceSnapshot csgResources, in Rect workRect, in Span<u32> receiverIndices);
    public b8 createCsgIntervalSampleStateBuffer();
    public b8 reserveCsgReceiverRangeBufferCapacity(in usize rangeCount);
    public b8 reserveCsgCutterBufferCapacity(in usize cutterCount);
    public b8 prepareCsgFrameResources(in usize receiverRangeCount, in usize cutterCount);
    public CsgGraphResourceSnapshot csgGraphResourceSnapshot(in b8 retainRefractionCapPipeline)const;
    public Expected<CsgClipContextSlots> prepareCsgClipContextSlotData(
        in DeferredFrameTargets targets,
        in CsgFrameGpuDataView csgFrameData,
        in CsgGraphResourceSnapshot csgResources,
        in MeshFrameBindingSnapshot frameBindings
    )const;
    public Expected<CsgIntervalSampleStateGpuData> prepareCsgIntervalSampleStateData(
        in DeferredFrameTargets targets,
        in CsgFrameGpuDataView csgFrameData,
        in CsgGraphResourceSnapshot csgResources,
        in MeshFrameBindingSnapshot frameBindings
    )const;
    public Expected<CsgReceiverClipDrawInfo> resolveCsgReceiverClipDrawInfo(
        in CsgFrameReceiverLookup receiverLookup,
        in CsgReceiverDrawState receiverDrawState,
        in CsgReceiverCpuBounds receiverBounds
    )const;
    public Expected<CsgReceiverClipDrawInfo> resolveCsgReceiverClipDrawInfo(
        in CsgFrameReceiverLookup receiverLookup,
        in CsgReceiverDrawState receiverDrawState,
        in CsgReceiverCpuBounds receiverBounds,
        in TransformComponent transform
    )const;
    public Expected<CsgReceiverRangeGpuData> appendCsgReceiverClipData(
        in CsgFrameReceiverLookup receiverLookup,
        in CsgReceiverDrawState receiverDrawState,
        in CsgReceiverCpuBounds receiverBounds,
        in u32 frameWidth,
        in u32 frameHeight,
        mut CsgFrameGpuData csgFrameData
    )const;
    public Expected<CsgReceiverRangeGpuData> appendCsgReceiverClipData(
        in CsgFrameReceiverLookup receiverLookup,
        in CsgReceiverDrawState receiverDrawState,
        in CsgReceiverCpuBounds receiverBounds,
        in TransformComponent transform,
        in u32 frameWidth,
        in u32 frameHeight,
        mut CsgFrameGpuData csgFrameData
    )const;
    public Expected<CsgReceiverRangeGpuData> appendCsgReceiverClipData(
        in CsgFrameReceiverLookup receiverLookup,
        in CsgReceiverDrawState receiverDrawState,
        in CsgReceiverCpuBounds receiverBounds,
        in u32 frameWidth,
        in u32 frameHeight,
        in MeshViewGpuData csgWorkRegionMeshViewState,
        mut CsgFrameGpuData csgFrameData
    )const;
    public Expected<CsgReceiverRangeGpuData> appendCsgReceiverClipData(
        in CsgFrameReceiverLookup receiverLookup,
        in CsgReceiverDrawState receiverDrawState,
        in CsgReceiverCpuBounds receiverBounds,
        in TransformComponent transform,
        in u32 frameWidth,
        in u32 frameHeight,
        in MeshViewGpuData csgWorkRegionMeshViewState,
        mut CsgFrameGpuData csgFrameData
    )const;

    private void releaseCsgClipContextHeapHandles();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

