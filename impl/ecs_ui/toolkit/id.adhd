// Stable keys of widget parts; builder, paint, and input code must derive the same ids.
const StringView s_WidgetPartPopup = "popup";
const StringView s_WidgetPartRows = "rows";
const StringView s_WidgetPartQuery = "query";
const StringView s_WidgetPartChoices = "choices";
const StringView s_WidgetPartScrollbar = "scrollbar";
const StringView s_WidgetPartTrack = "track";
const StringView s_WidgetPartThumb = "thumb";
const StringView s_WidgetPartScrollHorizontalThumb = "scroll.x.thumb";
const StringView s_WidgetPartScrollVerticalThumb = "scroll.y.thumb";
const StringView s_WidgetPartScrollHorizontalBefore = "scroll.x.before";
const StringView s_WidgetPartScrollVerticalBefore = "scroll.y.before";
const StringView s_WidgetPartScrollHorizontalAfter = "scroll.x.after";
const StringView s_WidgetPartScrollVerticalAfter = "scroll.y.after";
const StringView s_WidgetPartScrollCorner = "scroll.corner";
const StringView s_WindowChromeTitleKey = "@window.title";
const StringView s_WindowChromeCollapseKey = "@window.collapse";
const StringView s_WindowChromeResizeKey = "@window.resize";

const u64 s_WidgetMaxStates = 4096u;
const usize s_WidgetStateRetainedCapacity = 8192u;
const usize s_WidgetFrameReserve = 16u;
const usize s_ContextMaxScopeDepth = 64u;
const usize s_SmallStateClaims = 32u;
const u64 s_WidgetFnv64OffsetBasis = 14695981039346656037ull;
const u64 s_WidgetFnv64Prime = 1099511628211ull;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class WidgetId{
    public b8 operator==(in WidgetId rhs)const{
        return this.value == rhs.value;
    }

    public b8 operator!=(in WidgetId rhs)const{
        return this.value != rhs.value;
    }

    public b8 valid()const{
        return this.value != 0u;
    }

    public u64 value = 0u;
}

// Root identity comes from the host; include its lifetime generation rather than iteration order or an address.
class WidgetRoot{
    public b8 operator==(in WidgetRoot rhs)const{
        return this.value == rhs.value && this.generation == rhs.generation;
    }

    public b8 operator!=(in WidgetRoot rhs)const{
        return this.value != rhs.value || this.generation != rhs.generation;
    }

    public u64 value = 0u;
    public u64 generation = 1u;
}

enum<u8> WidgetKind{
    Panel,
    Container,
    Label,
    Button,
    Checkbox,
    Window,
    Separator,
    EditBox,
    Popup,
    Selectable,
    VirtualList,
    ComboBox,
    SearchComboBox,
    Tooltip,
    ContextMenu,
    TextArea,
    RadioGroup,
    Slider,
    Progress,
    Image,
}

class WidgetState{
    public WidgetState(){
        this.id = WidgetId();
        this.root = WidgetRoot();
        this.declarationGeneration = 0u;
        this.lastSeenFrame = 0u;
        this.kind = WidgetKind::Panel;
    }

    public WidgetState(in WidgetId id, in WidgetRoot root, in u64 declarationGeneration, in u64 lastSeenFrame, in WidgetKind kind){
        this.id = id;
        this.root = root;
        this.declarationGeneration = declarationGeneration;
        this.lastSeenFrame = lastSeenFrame;
        this.kind = kind;
    }

    public WidgetId id;
    public WidgetRoot root;
    public u64 declarationGeneration;
    public u64 lastSeenFrame;
    public WidgetKind kind;
}

class ContextStateClaim{
    public b8 operator==(in ContextStateClaim rhs)const{
        return this.instanceGeneration == rhs.instanceGeneration && this.kind == rhs.kind;
    }

    public b8 operator!=(in ContextStateClaim rhs)const{
        return this.instanceGeneration != rhs.instanceGeneration || this.kind != rhs.kind;
    }

    public u64 instanceGeneration = 0u;
    public WidgetKind kind = WidgetKind::Panel;
}

usize ContextStateClaimHash(in ContextStateClaim claim){
    const usize seed = hashValue(claim.instanceGeneration);
    return hashCombineValue(seed, cast<u8>(claim.kind));
}

u64 UpdateWidgetFnv64Byte(in u64 hash, in u8 byteValue){
    return (hash ^ cast<u64>(byteValue)) * s_WidgetFnv64Prime;
}

u64 UpdateWidgetFnv64U64LittleEndian(in u64 hash, in u64 value){
    u64 result = hash;
    for(u32 byteIndex = 0u; byteIndex < 8u; ++byteIndex){
        const u8 byteValue = cast<u8>((value >> (byteIndex * 8u)) & 0xffull);
        result = UpdateWidgetFnv64Byte(result, byteValue);
    }
    return result;
}

Expected<WidgetId> TryMakeRootId(in WidgetRoot root){
    if(root.generation == 0u)
        return makeUnexpected(Failure());
    u64 hash = UpdateWidgetFnv64U64LittleEndian(s_WidgetFnv64OffsetBasis, root.value);
    hash = UpdateWidgetFnv64U64LittleEndian(hash, root.generation);
    WidgetId outId;
    if(hash == 0u)
        outId.value = 1u;
    else
        outId.value = hash;
    return outId;
}

Expected<WidgetId> TryMakeWidgetPartId(in WidgetId parent, in u64 stableKey){
    if(!parent.valid() || stableKey == 0u)
        return makeUnexpected(Failure());
    u64 hash = UpdateWidgetFnv64U64LittleEndian(s_WidgetFnv64OffsetBasis, parent.value);
    hash = UpdateWidgetFnv64U64LittleEndian(hash, 0u);
    hash = UpdateWidgetFnv64U64LittleEndian(hash, stableKey);
    WidgetId outId;
    if(hash == 0u)
        outId.value = 1u;
    else
        outId.value = hash;
    return outId;
}

Expected<WidgetId> TryMakeWidgetId(in WidgetId parent, in StringView stableKey){
    if(!parent.valid() || stableKey.empty())
        return makeUnexpected(Failure());
    u64 hash = UpdateWidgetFnv64U64LittleEndian(s_WidgetFnv64OffsetBasis, parent.value);
    hash = UpdateWidgetFnv64U64LittleEndian(hash, cast<u64>(stableKey.size()));
    for(usize i = 0u; i < stableKey.size(); ++i)
        hash = UpdateWidgetFnv64Byte(hash, cast<u8>(stableKey[i]));
    WidgetId outId;
    if(hash == 0u)
        outId.value = 1u;
    else
        outId.value = hash;
    return outId;
}

b8 ValidateWidgetStateTouchRequest(in WidgetId id, in WidgetRoot root, in WidgetKind kind, in u64 frameGeneration){
    return id.valid() && root.generation != 0u && frameGeneration != 0u && cast<u8>(kind) <= cast<u8>(WidgetKind::Image);
}

b8 CanTouchExistingWidgetState(in WidgetState entry, in WidgetRoot root, in u64 frameGeneration){
    return entry.root == root && entry.lastSeenFrame != frameGeneration;
}


