void VerifyCpuTaskSchedulerTests_JoiningTheScopeThatContainsTheCurrentTaskIsRejected(){
    const TestSchedulerConfig config = HomogeneousWorkers(1u);
    EXPECT_DEATH(ExecuteCurrentScopeJoinDeath(config), "");
}

u32 ExecuteDirectParentDependencyRejection(){
    DeadlineGuard deadline(false, s_TestTimeoutMS);
    CpuTaskScheduler scheduler(0u);
    CpuTaskHandle parent = CpuTaskHandle();
    b8 rejected = false;
    const auto cpuTaskAdmission = scheduler.submit(lambda[mut scheduler, mut parent, mut rejected]() -> void{
        const auto child = scheduler.submit(lambda[]() -> void{}, parent);
        rejected = !child.has_value();
    });
    if(!cpuTaskAdmission.has_value()){
        return 2u;
    }
    parent = cpuTaskAdmission.value();
    scheduler.pumpMainThread();
    if(!rejected){
        return 1u;
    }
    scheduler.wait(parent);
    if(scheduler.statistics().outstandingTasks != 0u){
        return 2u;
    }
    return 0u;
}

void VerifyCpuTaskSchedulerTests_ChildCannotDependDirectlyOnItsStructuredParent(){
    const i32 expectedExitCode = 0;
    EXPECT_EXIT(ExitTestProcess(ExecuteDirectParentDependencyRejection()), testing::ExitedWithCode(expectedExitCode), "");
}

u32 ExecuteTransitiveParentDependencyRejection(in u32 chainDepth){
    DeadlineGuard deadline(false, s_TestTimeoutMS);
    CpuTaskScheduler scheduler(0u);
    CpuTaskHandle dependent = CpuTaskHandle();
    b8 rejected = false;
    u32 continuations = 0u;
    const auto cpuTaskAdmission = scheduler.submit(lambda[mut scheduler, mut dependent, mut rejected]() -> void{
        const auto child = scheduler.submit(lambda[]() -> void{}, dependent);
        rejected = !child.has_value();
    });
    if(!cpuTaskAdmission.has_value()){
        return 2u;
    }
    dependent = cpuTaskAdmission.value();
    for(u32 depth = 0u; depth < chainDepth; ++depth){
        const auto dependentTaskAdmission = scheduler.submit(lambda[mut continuations]() -> void{
            ++continuations;
        }, dependent);
        if(!dependentTaskAdmission.has_value()){
            return 2u;
        }
        dependent = dependentTaskAdmission.value();
    }
    scheduler.pumpMainThread();
    if(!rejected){
        return 1u;
    }
    scheduler.wait(dependent);
    if(continuations != chainDepth || scheduler.statistics().outstandingTasks != 0u){
        return 2u;
    }
    return 0u;
}

void VerifyCpuTaskSchedulerTests_ChildCannotDependOnATransitiveDependentOfItsStructuredParent(){
    const u32 chainDepth = 3u;
    const i32 expectedExitCode = 0;
    EXPECT_EXIT(ExitTestProcess(ExecuteTransitiveParentDependencyRejection(chainDepth)), testing::ExitedWithCode(expectedExitCode), "");
}

void ExecuteCrossWorkerAncestorScopeJoinDeath(in TestSchedulerConfig config){
    DeadlineGuard deadline(true, s_TestTimeoutMS);
    TaskGate parentGate = TaskGate();
    CpuTaskScheduler scheduler(config);
    CpuTaskScope scope(scheduler);
    Atomic<usize> parentWorker(0u);
    native(mut scheduler, mut scope, mut parentGate, mut parentWorker){
        const auto cpuTaskAdmission = scope.submit([&]() {
            parentWorker.store(scheduler.currentWorkerIndex(), MemoryOrder::release);
            const auto secondCpuTaskAdmission = scheduler.submit([&]() {
                if(!WaitUntil(parentGate.entered, s_GateTimeoutMS) || scheduler.currentWorkerIndex() == parentWorker.load(MemoryOrder::acquire))
                    ExitTestProcess(0u);
                scope.wait();
            });
            EXPECT_TRUE(secondCpuTaskAdmission);
            if(secondCpuTaskAdmission)
                EXPECT_TRUE(secondCpuTaskAdmission->valid());
            parentGate.block();
        });
        EXPECT_TRUE(cpuTaskAdmission);
        if(cpuTaskAdmission)
            EXPECT_TRUE(cpuTaskAdmission->valid());
    }
    scheduler.wait();
}

void VerifyCpuTaskSchedulerTests_DescendantOnAnotherWorkerCannotJoinItsAncestorsScope(){
    const TestSchedulerConfig config = HomogeneousWorkers(2u);
    EXPECT_DEATH(ExecuteCrossWorkerAncestorScopeJoinDeath(config), "");
}

void ExecuteIndependentDependentWaitDeath(in TestSchedulerConfig config){
    DeadlineGuard deadline(true, s_TestTimeoutMS);
    TaskGate start = TaskGate();
    CpuTaskScheduler scheduler(config);
    CpuTaskHandle running = CpuTaskHandle();
    CpuTaskHandle dependent = CpuTaskHandle();
    native(mut scheduler, mut start, mut running, mut dependent){
        const auto runningTaskAdmission = scheduler.submit([&]() { start.block(); scheduler.wait(dependent); });
        if(!runningTaskAdmission)
            ExitTestProcess(0u);
        running = *runningTaskAdmission;
    }
    const auto dependentTaskAdmission = scheduler.submit(lambda[]() -> void{}, running);
    if(!dependentTaskAdmission.has_value()){
        ExitTestProcess(0u);
    }
    dependent = dependentTaskAdmission.value();
    start.open();
    scheduler.wait();
}

void VerifyCpuTaskSchedulerTests_WorkerCannotWaitForAnIndependentlySubmittedDependent(){
    const TestSchedulerConfig config = HomogeneousWorkers(1u);
    EXPECT_DEATH(ExecuteIndependentDependentWaitDeath(config), "");
}

void ExecuteTransitiveDependentWaitDeath(in TestSchedulerConfig config, in u32 chainDepth){
    DeadlineGuard deadline(true, s_TestTimeoutMS);
    TaskGate start = TaskGate();
    CpuTaskScheduler scheduler(config);
    CpuTaskHandle dependent = CpuTaskHandle();
    native(mut scheduler, mut start, mut dependent){
        const auto cpuTaskAdmission = scheduler.submit([&]() {
            start.block();
            const auto secondCpuTaskAdmission = scheduler.submit([&]() { scheduler.wait(dependent); });
            EXPECT_TRUE(secondCpuTaskAdmission);
            if(secondCpuTaskAdmission)
                EXPECT_TRUE(secondCpuTaskAdmission->valid());
        });
        if(!cpuTaskAdmission)
            ExitTestProcess(0u);
        dependent = *cpuTaskAdmission;
    }
    for(u32 depth = 0u; depth < chainDepth; ++depth){
        const auto dependentTaskAdmission = scheduler.submit(lambda[]() -> void{}, dependent);
        if(!dependentTaskAdmission.has_value()){
            ExitTestProcess(0u);
        }
        dependent = dependentTaskAdmission.value();
    }
    start.open();
    scheduler.wait();
}

void VerifyCpuTaskSchedulerTests_DescendantCannotWaitForTransitiveDependentsOfItsAncestor(){
    const TestSchedulerConfig config = HomogeneousWorkers(1u);
    const u32 chainDepth = 3u;
    EXPECT_DEATH(ExecuteTransitiveDependentWaitDeath(config, chainDepth), "");
}


