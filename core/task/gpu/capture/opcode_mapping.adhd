////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{
#include <core/task/gpu/capture/command_ir.h>
namespace NWB::Core{
using CommandIrBuiltinOpcode = GpuCommandIrOpcode::Enum;
using CommandIrWireOpcode = GpuCommandIrWireOpcode::Enum;
constexpr CommandIrBuiltinOpcode s_CommandIrBuiltinCopyBuffer = GpuCommandIrOpcode::CopyBuffer;
constexpr CommandIrWireOpcode s_CommandIrWireCopyBuffer = GpuCommandIrWireOpcode::CopyBuffer;
constexpr CommandIrBuiltinOpcode s_CommandIrBuiltinCopyTexture = GpuCommandIrOpcode::CopyTexture;
constexpr CommandIrWireOpcode s_CommandIrWireCopyTexture = GpuCommandIrWireOpcode::CopyTexture;
constexpr CommandIrBuiltinOpcode s_CommandIrBuiltinClearBuffer = GpuCommandIrOpcode::ClearBuffer;
constexpr CommandIrWireOpcode s_CommandIrWireClearBuffer = GpuCommandIrWireOpcode::ClearBuffer;
constexpr CommandIrBuiltinOpcode s_CommandIrBuiltinClearTexture = GpuCommandIrOpcode::ClearTexture;
constexpr CommandIrWireOpcode s_CommandIrWireClearTexture = GpuCommandIrWireOpcode::ClearTexture;
constexpr CommandIrBuiltinOpcode s_CommandIrBuiltinClearTextureRectUInt = GpuCommandIrOpcode::ClearTextureRectUInt;
constexpr CommandIrWireOpcode s_CommandIrWireClearTextureRectUInt = GpuCommandIrWireOpcode::ClearTextureRectUInt;
constexpr CommandIrBuiltinOpcode s_CommandIrBuiltinUploadBuffer = GpuCommandIrOpcode::UploadBuffer;
constexpr CommandIrWireOpcode s_CommandIrWireUploadBuffer = GpuCommandIrWireOpcode::UploadBuffer;
constexpr CommandIrBuiltinOpcode s_CommandIrBuiltinUploadTexture = GpuCommandIrOpcode::UploadTexture;
constexpr CommandIrWireOpcode s_CommandIrWireUploadTexture = GpuCommandIrWireOpcode::UploadTexture;
constexpr CommandIrWireOpcode s_CommandIrWireCount = GpuCommandIrWireOpcode::Count;
};
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


CommandIrWireOpcode MapGpuCommandIrBuiltinWireOpcode(in CommandIrBuiltinOpcode opcode){
    switch(opcode){
    case s_CommandIrBuiltinCopyBuffer: return s_CommandIrWireCopyBuffer;
    case s_CommandIrBuiltinCopyTexture: return s_CommandIrWireCopyTexture;
    case s_CommandIrBuiltinClearBuffer: return s_CommandIrWireClearBuffer;
    case s_CommandIrBuiltinClearTexture: return s_CommandIrWireClearTexture;
    case s_CommandIrBuiltinClearTextureRectUInt: return s_CommandIrWireClearTextureRectUInt;
    case s_CommandIrBuiltinUploadBuffer: return s_CommandIrWireUploadBuffer;
    case s_CommandIrBuiltinUploadTexture: return s_CommandIrWireUploadTexture;
    default: return s_CommandIrWireCount;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

