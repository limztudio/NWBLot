#include <impl/assets_graphics/refractive_subsystem.adhd>
#include <impl/ecs_render/caustic/caustic_activity_resources.adhd>
#include <impl/ecs_render/caustic/caustic_emission_target_buffer.adhd>
#include <impl/ecs_render/caustic/rt_caustics_internal.adhd>
#include <impl/ecs_render/caustic/settings.adhd>
#include <impl/ecs_render/kernel/compute_pipeline_utils.adhd>
#include <impl/ecs_render/kernel/descriptor_register_utils.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_CausticHwMaxPayloadBytes = 8u;
const Name s_CausticSwPhotonShaderDebugName = "ECSRender_SwCausticPhotons";
const Name s_CausticResolveShaderDebugName = "ECSRender_CausticResolve";
const Name s_CausticGeometryDownsampleShaderDebugName = "ECSRender_CausticGeometryDownsample";
const Name s_CausticAccumulatorDecayShaderDebugName = "ECSRender_CausticAccumulatorDecay";
const Name s_CausticHwRaygenShaderDebugName = "ECSRender_CausticHwRaygen";
const Name s_CausticHwMissShaderDebugName = "ECSRender_CausticHwMiss";
const Name s_CausticHwClosestHitShaderDebugName = "ECSRender_CausticHwClosestHit";

StringView SelectRayTracingCsgVariant(in b8 hasCsg){
    if(hasCsg)
        return s_RayTracingCsgEnabledVariant;
    return s_RayTracingCsgDisabledVariant;
}

b8 AreAllCausticResolveStagePipelinesReady(
    in b8 hasPrepare,
    in b8 hasWavelet,
    in b8 hasStepOne,
    in b8 hasStepTwo,
    in b8 hasDirect,
    in b8 hasUpsample
){
    return hasPrepare && hasWavelet && hasStepOne && hasStepTwo && hasDirect && hasUpsample;
}

b8 MatchesCausticResolveActivityExtent(in u32 activityHalfWidth, in u32 activityHalfHeight, in u32 targetWidth, in u32 targetHeight){
    if(targetWidth == 0u || targetHeight == 0u)
        return false;
    return activityHalfWidth == DivideUp(targetWidth, s_CausticResolveDownscaleFactor) && activityHalfHeight == DivideUp(targetHeight, s_CausticResolveDownscaleFactor);
}

u32 ComputeCausticHalfTargetExtent(in u32 extent){
    return DivideUpWrappingU32(extent, 2u);
}

b8 EnsureSwCausticPipelineVariant(
    in b8 csg,
    mut GlobalArena arena,
    mut Device device,
    mut RendererShaderSystem shaderSystem,
    mut BindingLayoutHandle inOutLayout,
    mut ShaderHandle inOutShader,
    mut ComputePipelineHandle inOutPipeline,
    mut b8 inOutFailed
){
    if(inOutPipeline.valid())
        return true;
    if(inOutFailed)
        return false;

    if(!EnsurePushConstantComputePipeline<RefractiveSubsystem>(
        arena,
        device,
        shaderSystem,
        lambda[](in RefractiveSubsystem s) -> AssetRef<ComputeShader>{ return s.causticPhotonSwCs; },
        SelectRayTracingCsgVariant(csg),
        s_CausticSwPhotonShaderDebugName,
        sizeof(CausticPhotonPushConstants),
        false,
        inOutLayout,
        inOutShader,
        inOutPipeline
    )){
        error("RendererSystem: failed to create software caustic compute pipeline");
        inOutFailed = true;
        return false;
    }
    return true;
}

b8 EnsureCausticResolveStagePipeline(
    in StringView variant,
    in BindingLayoutHandle bindingLayout,
    mut Device device,
    mut RendererShaderSystem shaderSystem,
    mut CausticResolveStageState stage
){
    if(stage.m_pipeline.valid())
        return true;
    if(
        !shaderSystem.loadShader<ComputeShader, RefractiveSubsystem>(lambda[](in RefractiveSubsystem s) -> AssetRef<ComputeShader>{ return s.causticResolveCs; }, variant, s_CausticResolveShaderDebugName, stage.m_shader)
        || !CreateHeapComputePipeline(device, stage.m_shader, bindingLayout, false, stage.m_pipeline)
    ){
        error("RendererSystem: failed to create specialized caustic resolve pipeline");
        return false;
    }
    return true;
}

b8 EnsureCausticRtPipelineVariant(
    in b8 csg,
    mut GlobalArena arena,
    mut GraphicsRuntime graphics,
    mut RendererShaderSystem shaderSystem,
    mut BindingLayoutHandle inOutBindingLayout,
    mut RayTracingPipelineHandle cachedPipeline,
    mut RayTracingShaderTableHandle cachedTable,
    mut b8 failed
){
    if(cachedPipeline.valid() && cachedTable.valid())
        return true;
    if(cachedPipeline.valid() || cachedTable.valid()){
        error("RendererSystem: RT caustic pipeline and shader table cache is inconsistent");
        cachedPipeline.reset();
        cachedTable.reset();
        failed = true;
        return false;
    }
    if(failed)
        return false;
    if(!graphics.queryFeatureSupport(Feature::RayTracingPipeline)){
        failed = true;
        return false;
    }

    mut Device device = graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized() || !heap.hasAccelStructLayout()){
        error("RendererSystem: hardware caustics require the descriptor-buffer TLAS heap layout");
        failed = true;
        return false;
    }

    if(!EnsurePushConstantBindingLayout(arena, device, sizeof(CausticPhotonPushConstants), ShaderTypeMask::AllRayTracing, inOutBindingLayout)){
        error("RendererSystem: failed to create hardware caustic binding layout");
        failed = true;
        return false;
    }

    ShaderHandle raygenShader;
    ShaderHandle missShader;
    ShaderHandle closestHitShader;
    if(
        !shaderSystem.loadShader<RayGenerationShader, RefractiveSubsystem>(lambda[](in RefractiveSubsystem s) -> AssetRef<RayGenerationShader>{ return s.causticPhotonHwRaygen; }, SelectRayTracingCsgVariant(csg), s_CausticHwRaygenShaderDebugName, raygenShader)
        || !shaderSystem.loadShader<MissShader, RefractiveSubsystem>(lambda[](in RefractiveSubsystem s) -> AssetRef<MissShader>{ return s.causticPhotonHwMiss; }, s_ShaderArchiveDefaultVariant, s_CausticHwMissShaderDebugName, missShader)
        || !shaderSystem.loadShader<ClosestHitShader, RefractiveSubsystem>(lambda[](in RefractiveSubsystem s) -> AssetRef<ClosestHitShader>{ return s.causticPhotonHwChit; }, s_ShaderArchiveDefaultVariant, s_CausticHwClosestHitShaderDebugName, closestHitShader)
    ){
        failed = true;
        return false;
    }

    RayTracingPipelineDesc pipelineDesc = RayTracingPipelineDesc(arena);
    // The iterative bounce loop needs no shader recursion.
    pipelineDesc.setMaxPayloadSize(s_CausticHwMaxPayloadBytes);
    pipelineDesc.setMaxRecursionDepth(1u);
    pipelineDesc.addBindingLayout(inOutBindingLayout);
    // Preserve global resource, sampler, and TLAS heap sets.
    pipelineDesc.addBindingLayout(heap.getResourceLayout());
    pipelineDesc.addBindingLayout(heap.getSamplerLayout());
    pipelineDesc.addBindingLayout(heap.getAccelStructLayout());

    RayTracingPipelineShaderDesc raygenDesc;
    raygenDesc.setShader(raygenShader).setExportName(s_CausticHwRaygenExportName);
    pipelineDesc.addShader(raygenDesc);

    RayTracingPipelineShaderDesc missDesc;
    missDesc.setShader(missShader).setExportName(s_CausticHwMissExportName);
    pipelineDesc.addShader(missDesc);

    RayTracingPipelineHitGroupDesc hitGroupDesc;
    hitGroupDesc.setClosestHitShader(closestHitShader).setExportName(s_CausticHwHitGroupExportName);
    pipelineDesc.addHitGroup(hitGroupDesc);

    const Expected<RayTracingPipelineHandle> pipelineResult = device.createRayTracingPipeline(pipelineDesc);
    if(!pipelineResult.has_value()){
        error("RendererSystem: failed to create RT caustic pipeline");
        failed = true;
        return false;
    }
    RayTracingPipelineHandle pipeline = pipelineResult.value();

    const Expected<RayTracingShaderTableHandle> shaderTableResult = pipeline.deref().createShaderTable();
    if(!shaderTableResult.has_value()){
        error("RendererSystem: failed to create RT caustic shader table");
        failed = true;
        return false;
    }
    RayTracingShaderTableHandle shaderTable = shaderTableResult.value();
    mut RayTracingShaderTable tableRef = shaderTable.deref();
    b8 shaderTablePopulated = tableRef.setRayGenerationShader(s_CausticHwRaygenExportName);
    if(shaderTablePopulated){
        const Expected<u32> missIndex = tableRef.addMissShader(s_CausticHwMissExportName);
        shaderTablePopulated = missIndex.has_value() && missIndex.value() == 0u;
    }
    if(shaderTablePopulated){
        const Expected<u32> hitIndex = tableRef.addHitGroup(s_CausticHwHitGroupExportName);
        shaderTablePopulated = hitIndex.has_value() && hitIndex.value() == 0u;
    }
    if(!shaderTablePopulated){
        error("RendererSystem: failed to populate RT caustic shader table");
        failed = true;
        return false;
    }

    cachedPipeline = pipeline;
    cachedTable = shaderTable;

    [essential]
    info("RendererSystem: created RT caustic pipeline + shader table");
    return true;
}

b8 CausticPipelineSet::ensureSwCausticPipeline(){
    if(this.m_hasCsg)
        return EnsureSwCausticPipelineVariant(true, this.m_arena, this.m_graphics.getDevice(), this.m_shaderSystem, this.m_caustic.m_swCausticBindingLayout, this.m_caustic.m_swCausticCsgShader, this.m_caustic.m_swCausticCsgPipeline, this.m_caustic.m_swCausticCsgPipelineFailed);
    return EnsureSwCausticPipelineVariant(false, this.m_arena, this.m_graphics.getDevice(), this.m_shaderSystem, this.m_caustic.m_swCausticBindingLayout, this.m_caustic.m_swCausticShader, this.m_caustic.m_swCausticPipeline, this.m_caustic.m_swCausticPipelineFailed);
}

b8 CausticPipelineSet::ensureCausticResolvePipeline(){
    mut CausticResolveState resolve = this.m_caustic.m_causticResolve;
    if(AreAllCausticResolveStagePipelinesReady(
        resolve.m_prepare.m_pipeline.valid(),
        resolve.m_wavelet.m_pipeline.valid(),
        resolve.m_waveletStepOne.m_pipeline.valid(),
        resolve.m_waveletStepTwo.m_pipeline.valid(),
        resolve.m_waveletDirect.m_pipeline.valid(),
        resolve.m_upsample.m_pipeline.valid()
    ))
        return true;
    if(resolve.m_failed)
        return false;

    mut Device device = this.m_graphics.getDevice();
    if(!device.getDescriptorHeap().isInitialized() || !EnsurePushConstantBindingLayout(this.m_arena, device, sizeof(CausticResolvePushConstants), ShaderTypeMask::Compute, resolve.m_bindingLayout)){
        error("RendererSystem: failed to create caustic resolve binding layout");
        resolve.m_failed = true;
        return false;
    }

    if(
        !EnsureCausticResolveStagePipeline(s_CausticResolvePrepareVariant, resolve.m_bindingLayout, device, this.m_shaderSystem, resolve.m_prepare)
        || !EnsureCausticResolveStagePipeline(s_CausticResolveWaveletVariant, resolve.m_bindingLayout, device, this.m_shaderSystem, resolve.m_wavelet)
        || !EnsureCausticResolveStagePipeline(s_CausticResolveWaveletStepOneVariant, resolve.m_bindingLayout, device, this.m_shaderSystem, resolve.m_waveletStepOne)
        || !EnsureCausticResolveStagePipeline(s_CausticResolveWaveletStepTwoVariant, resolve.m_bindingLayout, device, this.m_shaderSystem, resolve.m_waveletStepTwo)
        || !EnsureCausticResolveStagePipeline(s_CausticResolveWaveletDirectVariant, resolve.m_bindingLayout, device, this.m_shaderSystem, resolve.m_waveletDirect)
        || !EnsureCausticResolveStagePipeline(s_CausticResolveUpsampleVariant, resolve.m_bindingLayout, device, this.m_shaderSystem, resolve.m_upsample)
    ){
        resolve.m_failed = true;
        return false;
    }
    return true;
}

b8 CausticPipelineSet::ensureCausticGeometryDownsamplePipeline(){
    if(this.m_caustic.m_causticGeometryDownsamplePipeline.valid())
        return true;
    if(this.m_caustic.m_causticGeometryDownsamplePipelineFailed)
        return false;

    if(!EnsurePushConstantComputePipeline<RefractiveSubsystem>(
        this.m_arena,
        this.m_graphics.getDevice(),
        this.m_shaderSystem,
        lambda[](in RefractiveSubsystem s) -> AssetRef<ComputeShader>{ return s.causticGeometryDownsampleCs; },
        s_ShaderArchiveDefaultVariant,
        s_CausticGeometryDownsampleShaderDebugName,
        sizeof(CausticGeometryDownsamplePushConstants),
        false,
        this.m_caustic.m_causticGeometryDownsampleBindingLayout,
        this.m_caustic.m_causticGeometryDownsampleShader,
        this.m_caustic.m_causticGeometryDownsamplePipeline
    )){
        error("RendererSystem: failed to create caustic geometry downsample compute pipeline");
        this.m_caustic.m_causticGeometryDownsamplePipelineFailed = true;
        return false;
    }
    return true;
}

b8 CausticPipelineSet::ensureCausticAccumulatorDecayPipeline(){
    if(this.m_caustic.m_causticAccumulatorDecayPipeline.valid())
        return true;
    if(this.m_caustic.m_causticAccumulatorDecayPipelineFailed)
        return false;

    if(!EnsurePushConstantComputePipeline<RefractiveSubsystem>(
        this.m_arena,
        this.m_graphics.getDevice(),
        this.m_shaderSystem,
        lambda[](in RefractiveSubsystem s) -> AssetRef<ComputeShader>{ return s.causticAccumulatorDecayCs; },
        s_ShaderArchiveDefaultVariant,
        s_CausticAccumulatorDecayShaderDebugName,
        sizeof(CausticAccumulatorDecayPushConstants),
        false,
        this.m_caustic.m_causticAccumulatorDecayBindingLayout,
        this.m_caustic.m_causticAccumulatorDecayShader,
        this.m_caustic.m_causticAccumulatorDecayPipeline
    )){
        error("RendererSystem: failed to create caustic accumulator decay compute pipeline");
        this.m_caustic.m_causticAccumulatorDecayPipelineFailed = true;
        return false;
    }
    return true;
}

b8 CausticPipelineSet::ensureCausticRtPipeline(){
    if(this.m_hasCsg)
        return EnsureCausticRtPipelineVariant(true, this.m_arena, this.m_graphics, this.m_shaderSystem, this.m_caustic.m_hwCausticBindingLayout, this.m_caustic.m_hwCausticCsgPipeline, this.m_caustic.m_hwCausticCsgShaderTable, this.m_caustic.m_hwCausticCsgPipelineFailed);
    return EnsureCausticRtPipelineVariant(false, this.m_arena, this.m_graphics, this.m_shaderSystem, this.m_caustic.m_hwCausticBindingLayout, this.m_caustic.m_hwCausticPipeline, this.m_caustic.m_hwCausticShaderTable, this.m_caustic.m_hwCausticPipelineFailed);
}

b8 CausticActivityResources::prepareCausticResolveActivity(in u32 halfWidth, in u32 halfHeight){
    if(this.m_activity.valid() && this.m_activity.halfWidth == halfWidth && this.m_activity.halfHeight == halfHeight)
        return true;
    this.releaseCausticResolveActivity();
    const Expected<CausticResolveActivityLayout> layout = TryResolveCausticActivityLayout(halfWidth, halfHeight);
    if(!layout.has_value())
        return false;
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    if(!heap.isInitialized())
        return false;
    for(u32 index = 0u; index < LengthOf(this.m_activity.buffers); ++index){
        BufferDesc desc;
        desc.setByteSize(layout.value().bufferByteSize)
            .setCanHaveRawViews(true)
            .setCanHaveUAVs(true)
            .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
            .enableAutomaticStateTracking(ResourceStates::Common)
            .setDebugName(CausticResolveActivityBufferName(index));
        const Expected<BufferHandle> bufferResult = this.m_graphics.createBuffer(desc);
        if(!bufferResult.has_value()){
            this.releaseCausticResolveActivity();
            return false;
        }
        this.m_activity.buffers[index] = bufferResult.value();
        if(!AssignDescriptor(heap, GpuDescriptorClass::StorageBuffer, DescriptorWriteItemRawBufferUav(0u, this.m_activity.buffers[index].deref()), this.m_activity.descriptors[index])){
            this.releaseCausticResolveActivity();
            return false;
        }
    }
    this.m_activity.halfWidth = halfWidth;
    this.m_activity.halfHeight = halfHeight;
    return true;
}

void CausticActivityResources::releaseCausticResolveActivity(){
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    if(heap.isInitialized()){
        for(in GpuDescriptorHandle descriptor : this.m_activity.descriptors){
            if(descriptor.valid())
                heap.free(descriptor);
        }
    }
    this.m_activity = CausticResolveActivitySnapshot();
}


