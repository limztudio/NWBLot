////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_skeleton/joint_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Joint/weight pairs per influence record. Keeps CPU and GPU forms in lockstep.
const u32 s_SkinInfluenceJointCount = 4u;
const u32 s_SkinBinaryMagic = 0x534B4E31u; // SKN1
const u32 s_MeshBinaryMagic = 0x4D534837u; // MSH7
const usize s_MeshPackedAlignBytes = 1u;
const f32 s_SkinValidationEpsilon = 0.000001f;
const f32 s_SkinWeightSumEpsilon = 0.001f;

[serialize]
class SkinInfluence4{
    public Array<u16, s_SkinInfluenceJointCount> joint;
    public f32x4u weight(0.0f);
}

[serialize]
class SkinHeaderBinary{
    public u32 magic = s_SkinBinaryMagic;
    public u32 padding0 = 0u;
    public NameHash meshNameHash;
    public NameHash skeletonNameHash;
    public u64 influenceCount = 0u;
    public u64 inverseBindMatrixCount = 0u;
}

[serialize]
class MeshBinaryHeader{
    public u32 magic = s_MeshBinaryMagic;
    public u32 meshClass = 0u;
    public u64 positionCount = 0u;
    public u64 normalCount = 0u;
    public u64 tangentCount = 0u;
    public u64 uv0Count = 0u;
    public u64 colorCount = 0u;
    public u64 skinCount = 0u;
    public u64 skeletonJointCount = 0u;
    public u64 inverseBindMatrixCount = 0u;
    public u64 meshletCount = 0u;
    public u64 meshletBoundCount = 0u;
    public u64 meshletPositionRefDeltaByteCount = 0u;
    public u64 meshletAttributeRefDeltaByteCount = 0u;
    public u64 meshletLocalVertexRefCount = 0u;
    public u64 meshletPrimitiveIndexCount = 0u;
}

b8 ValidSkinInfluenceWeights(in f32x4u weights){
    for(usize i = 0u; i < 4u; ++i){
        const f32 w = weights[i];
        if(!isFinite(w) || w < 0.0f){
            return false;
        }
    }
    const f32 sum = weights[0u] + weights[1u] + weights[2u] + weights[3u];
    return isFinite(sum) && abs(sum - 1.0f) <= s_SkinWeightSumEpsilon;
}

b8 SkinInfluenceFitsSkeleton(in SkinInfluence4 skin, in u32 skeletonJointCount){
    if(skeletonJointCount == 0u){
        return true;
    }
    for(u32 influenceIndex = 0u; influenceIndex < s_SkinInfluenceJointCount; ++influenceIndex){
        const u32 joint = cast<u32>(skin.joint[influenceIndex]);
        if(joint >= skeletonJointCount){
            return false;
        }
    }
    return true;
}

b8 ValidInverseBindMatrixCount(in usize inverseBindMatrixCount, in u32 skeletonJointCount){
    if(inverseBindMatrixCount == 0u){
        return true;
    }
    return skeletonJointCount != 0u && inverseBindMatrixCount == cast<usize>(skeletonJointCount);
}


