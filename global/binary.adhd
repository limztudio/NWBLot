[cpp_header("<global/binary.h>"), cpp_name("::BinaryByteView"), cpp_flags(self_defaulted, brace_init)]
extern class BinaryByteView{
    usize byteCount;
    u8 operator[](in usize index)const;
    b8 empty()const;
    usize size()const;
    b8 hasData()const;
    Span<u8> span()const;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<global/binary.h>"), cpp_name("::BinaryByteView::FromBytes")]
extern BinaryByteView BinaryViewFromBytes(in Span<u8> bytes);


[cpp_name("::BinaryVectorPayloadFailure::Enum")]
extern enum BinaryVectorPayloadFailure : u8{
    CountOverflow,
    SourceTruncated,
    OutputOverflow
};


