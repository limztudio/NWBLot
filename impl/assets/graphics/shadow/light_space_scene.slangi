////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SHADOW_LIGHT_SPACE_SCENE_SLANGI
#define NWB_GRAPHICS_SHADOW_LIGHT_SPACE_SCENE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "light_space_resources.slangi"
#include "csg_shadow_resources.slangi"
#include "shadow_heap_resources.slangi"
#define g_NwbSwShadowMaterialContextSlots NwbHeapShadowMaterialContextSlots(g_NwbLightSpacePush.materialContextSlot)
#include "sw_shadow_geometry.slangi"

uint nwbMeshFrameMaterialTypedHeapSlot(){ return g_NwbSwShadowMaterialContextSlots.sceneSlots.w; }
uint nwbMeshFrameInstanceHeapSlot(){ return g_NwbSwShadowMaterialContextSlots.materialSlots.x; }
uint nwbMeshFrameViewHeapSlot(){ return 0u; }
#include "../bindless/bindless_heap_mesh.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NwbRtInstanceMaterial nwbLightSpaceMaterial(const uint instance){
    return NwbHeapRtInstanceMaterials(g_NwbSwShadowMaterialContextSlots.sceneSlots.z)[instance];
}

NwbSwBvhInstance nwbLightSpaceInstance(const uint instance){
    if(nwbCsgShadowEnabled())
        return nwbCsgShadowInstance(instance);
    return NwbHeapSwShadowSceneInstances(g_NwbSwShadowMaterialContextSlots.sceneSlots.y)[instance];
}

NwbBvhNode nwbLightSpaceMeshRoot(const uint instance){
    if(nwbCsgShadowEnabled())
        return nwbCsgShadowRoot(instance);
    return NwbHeapBvhNodes(nwbLightSpaceMaterial(instance).nodeSlot)[0u];
}

NwbBvhNode nwbLightSpaceSceneRoot(){
    if(!nwbCsgShadowEnabled())
        return NwbHeapBvhNodes(g_NwbLightSpacePush.sceneRootSlot)[0u];
    NwbBvhNode scene = (NwbBvhNode)0;
    scene.aabbMin = float3(asfloat(0x7f7fffffu));
    scene.aabbMax = -scene.aabbMin;
    for(uint index = 0u; index < g_NwbLightSpacePush.instanceCount; ++index){
        if(nwbCsgShadowHardwareCompose() && !nwbCsgShadowReceiver(index))
            continue;
        const NwbBvhNode root = nwbLightSpaceMeshRoot(index);
        if(!all(isfinite(root.aabbMin)) || !all(isfinite(root.aabbMax)) || any(root.aabbMin > root.aabbMax)){
            scene.aabbMin = float3(asfloat(0x7fc00000u));
            return scene;
        }
        const NwbMeshInstanceData transform = NwbHeapMeshInstances(nwbMeshFrameInstanceHeapSlot())[nwbLightSpaceMaterial(index).meshInstanceIndex];
        for(uint corner = 0u; corner < 8u; ++corner){
            const float3 local = float3((corner & 1u) != 0u ? root.aabbMax.x : root.aabbMin.x,
                (corner & 2u) != 0u ? root.aabbMax.y : root.aabbMin.y, (corner & 4u) != 0u ? root.aabbMax.z : root.aabbMin.z);
            const float3 world = nwbRotateVectorByQuaternion(local * transform.scale.xyz, transform.rotation) + transform.translation;
            if(!all(isfinite(world))){
                scene.aabbMin = float3(asfloat(0x7fc00000u));
                return scene;
            }
            scene.aabbMin = min(scene.aabbMin, world);
            scene.aabbMax = max(scene.aabbMax, world);
        }
    }
    return scene;
}

float3 nwbLightSpaceWorldPosition(const float3 local, const uint instance){
    const NwbMeshInstanceData transform = NwbHeapMeshInstances(nwbMeshFrameInstanceHeapSlot())[nwbLightSpaceMaterial(instance).meshInstanceIndex];
    return nwbRotateVectorByQuaternion(local * transform.scale.xyz, transform.rotation) + transform.translation;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

