#include <impl/assets_scene/components.adhd>
#include <impl/ecs_mesh/components.adhd>
#include <impl/ecs_model/components.adhd>
#include <impl/ecs_render/components.adhd>
#include <impl/ecs_render/material/pipeline_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena, asset("model_component")]
class ModelComponentAsset : IComponent{
    public ModelComponent component;

    public b8 loadBinary(in Span<u8> binary)override;
    public b8 loadComponentPayload(in Span<u8> payload)override;
    public b8 validatePayload()const override;
    public void applyToEntity(mut Entity entity)const override{
        entity.addComponent<ModelComponent>() = this.component;
    }
    public b8 serializeComponentPayload(mut Vector<u8> outPayload)const override;
}

[arena, asset("mesh_component")]
class MeshComponentAsset : IComponent{
    public MeshComponent component;

    public b8 loadBinary(in Span<u8> binary)override;
    public b8 loadComponentPayload(in Span<u8> payload)override;
    public b8 validatePayload()const override;
    public void applyToEntity(mut Entity entity)const override{
        entity.addComponent<MeshComponent>() = this.component;
    }
    public b8 serializeComponentPayload(mut Vector<u8> outPayload)const override;
}

[arena, asset("renderer_component")]
class RendererComponentAsset : IComponent{
    public RendererComponent component;

    public b8 loadBinary(in Span<u8> binary)override;
    public b8 loadComponentPayload(in Span<u8> payload)override;
    public b8 validatePayload()const override;
    public void applyToEntity(mut Entity entity)const override{
        entity.addComponent<RendererComponent>() = this.component;
    }
    public b8 serializeComponentPayload(mut Vector<u8> outPayload)const override;
}

[serialize]
class SingleAssetRefComponentPayloadBinary{
    public NameHash assetHash;
}

[serialize]
class RendererComponentPayloadBinary{
    public NameHash materialHash;
    public NameHash opticalVolumeGroupHash;
    public i32 opticalVolumePriority = 0;
    public i32 opticalMediumPriority = 0;
    public u8 visible = 1u;
    public u8 opticalVolumeCoincidence = 0u;
    public u8 opticalBoundaryMode = 0u;
    public u8 reserved0 = 0u;
    public u32 reserved1 = 0u;
}


