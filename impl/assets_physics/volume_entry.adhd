b8 ReadOptionalColliderDepRef<T>(
    in Path file,
    in MetascriptValue mapVal,
    in StringView key,
    mut AssetRef<T> outRef
){
    const Optional<in MetascriptValue> fieldOpt = mapVal.borrowField(key);
    if(!fieldOpt.has_value())
        return true;
    const Expected<StringView> refText = ReadPhysicsStringValue(file, fieldOpt.value(), s_ColliderComponentDiagnosticPrefix, key);
    if(!refText.has_value())
        return false;
    const Expected<AssetRef<T>> parsed = ParseReservedAssetRefText<T>(file, s_ColliderComponentDiagnosticPrefix, key, refText.value());
    if(!parsed.has_value())
        return false;
    outRef = parsed.value();
    return true;
}

Expected<PhysicsColliderDepEntry> ParseColliderDepEntry(in Name virtualPath, in Path file, in MetascriptValue value){
    PhysicsColliderDepEntry entry;
    if(!ValidateOptionalSceneMetadataMap(file, value, s_ColliderComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_ColliderComponentDiagnosticPrefix, entry))
        return MakeUnexpected(Failure());
    if(!value.isMap())
        return entry;
    if(
        !ReadOptionalColliderDepRef<Mesh>(file, value, "mesh_asset", entry.meshAsset)
        || !ReadOptionalColliderDepRef<PhysicsMaterialAsset>(file, value, "material_asset", entry.materialAsset)
        || !ReadOptionalColliderDepRef<ConvexHullAsset>(file, value, "convex_hull_asset", entry.convexHullAsset)
        || !ReadOptionalColliderDepRef<CompoundHullAsset>(file, value, "compound_hull_asset", entry.compoundHullAsset)
        || !ReadOptionalColliderDepRef<CollisionMeshAsset>(file, value, "collision_mesh_asset", entry.collisionMeshAsset)
        || !ReadOptionalColliderDepRef<HeightfieldAsset>(file, value, "heightfield_asset", entry.heightfieldAsset)
    )
        return MakeUnexpected(Failure());
    const Optional<in MetascriptValue> extraOpt = value.borrowField("extra_shapes");
    if(extraOpt.has_value()){
        if(!extraOpt.value().isList()){
            error("{} '{}': field 'extra_shapes' must be a list of collider maps", s_ColliderComponentDiagnosticPrefix, PathToString(file));
            return MakeUnexpected(Failure());
        }
        const Span<MetascriptValue> items = extraOpt.value().listView();
        for(usize i = 0u; i < items.size(); ++i){
            in MetascriptValue item = items[i];
            if(!item.isMap()){
                error("{} '{}': 'extra_shapes[{}]' must be a map", s_ColliderComponentDiagnosticPrefix, PathToString(file), i);
                return MakeUnexpected(Failure());
            }
            AssetRef<Mesh> extraMesh;
            AssetRef<PhysicsMaterialAsset> extraMat;
            AssetRef<ConvexHullAsset> extraHull;
            AssetRef<CompoundHullAsset> extraCompoundHull;
            AssetRef<CollisionMeshAsset> extraCollisionMesh;
            AssetRef<HeightfieldAsset> extraHeightfield;
            if(
                !ReadOptionalColliderDepRef<Mesh>(file, item, "mesh_asset", extraMesh)
                || !ReadOptionalColliderDepRef<PhysicsMaterialAsset>(file, item, "material_asset", extraMat)
                || !ReadOptionalColliderDepRef<ConvexHullAsset>(file, item, "convex_hull_asset", extraHull)
                || !ReadOptionalColliderDepRef<CompoundHullAsset>(file, item, "compound_hull_asset", extraCompoundHull)
                || !ReadOptionalColliderDepRef<CollisionMeshAsset>(file, item, "collision_mesh_asset", extraCollisionMesh)
                || !ReadOptionalColliderDepRef<HeightfieldAsset>(file, item, "heightfield_asset", extraHeightfield)
            )
                return MakeUnexpected(Failure());
            if(extraMesh.valid())
                entry.extraMeshAssets.push_back(extraMesh);
            if(extraMat.valid())
                entry.extraMaterialAssets.push_back(extraMat);
            if(extraHull.valid())
                entry.extraConvexHullAssets.push_back(extraHull);
            if(extraCompoundHull.valid())
                entry.extraCompoundHullAssets.push_back(extraCompoundHull);
            if(extraCollisionMesh.valid())
                entry.extraCollisionMeshAssets.push_back(extraCollisionMesh);
            if(extraHeightfield.valid())
                entry.extraHeightfieldAssets.push_back(extraHeightfield);
        }
    }
    return entry;
}

Expected<PhysicsWorldConfigDepEntry> ParsePhysicsWorldConfigDepEntry(in Name virtualPath, in Path file, in MetascriptValue value){
    PhysicsWorldConfigDepEntry entry;
    if(!ValidateOptionalSceneMetadataMap(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_PhysicsWorldConfigComponentDiagnosticPrefix, entry))
        return MakeUnexpected(Failure());
    if(!value.isMap())
        return entry;
    const Optional<in MetascriptValue> fieldOpt = value.borrowField("collision_layer_matrix_asset");
    if(fieldOpt.has_value()){
        const Expected<StringView> refText = ReadPhysicsStringValue(file, fieldOpt.value(), s_PhysicsWorldConfigComponentDiagnosticPrefix, "collision_layer_matrix_asset");
        if(!refText.has_value())
            return MakeUnexpected(Failure());
        const Expected<AssetRef<CollisionLayerMatrixAsset>> parsed = ParseReservedAssetRefText<CollisionLayerMatrixAsset>(
            file,
            s_PhysicsWorldConfigComponentDiagnosticPrefix,
            "collision_layer_matrix_asset",
            refText.value()
        );
        if(!parsed.has_value())
            return MakeUnexpected(Failure());
        entry.collisionLayerMatrixAsset = parsed.value();
    }
    return entry;
}

[cook_entry("component", s_RigidBodyComponentDiagnosticPrefix, ParseRigidBodyComponentCookMetadata, document_and_value, log_failure, RigidBodyComponentCodec)]
