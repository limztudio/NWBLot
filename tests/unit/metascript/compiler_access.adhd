[cpp_header("<tests/unit/metascript/compiler_access.h>"), cpp_name("::NWB::Core::Metascript::MString")]
extern class MString{
    usize size()const;
    b8 empty()const;
    void append(...);
    void assign(...);
    void push_back(...);
    usize find(...)const;
};

[cpp_header("<tests/unit/metascript/compiler_access.h>"), cpp_name("::NWB::Core::Metascript::MetaArena"), cpp_flags(no_copy, no_assign)]
