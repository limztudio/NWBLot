////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_csg/shape_id.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_CsgGeneratedIncludePathSeparator = "/";
const StringView s_CsgEvalShapeIdDefineName = "NWB_CSG_EVAL_SHAPE_ID";
const StringView s_CsgDefineDirective = "#define ";
const StringView s_CsgUnsignedLiteralLineEnd = "u\n";
const StringView s_CsgIncludeDirective = "#include \"";
const StringView s_CsgIncludeDirectiveEnd = "\"\n";
const StringView s_CsgUndefDirective = "#undef ";
const StringView s_CsgUndefDirectiveEnd = "\n\n";
const StringView s_CsgFixedShapeSourceTemplate = "#define  u\n#include \"\"\n#undef \n\n";
const StringView s_CsgModuleSourceHeader = "// Generated by the asset cook from csg_shape assets.\n\n";
const usize s_CsgUsizeDecimalDigitCount = 20u;
const usize s_FixedShapeSourceBytes = s_CsgFixedShapeSourceTemplate.size() + 2u * s_CsgEvalShapeIdDefineName.size() + s_CsgUsizeDecimalDigitCount;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CsgShapeModuleSource{
    public Expected<String> buildDefaultPath(in Name shaderModule, in StringView safeModuleName){
        if(shaderModule == s_NameNone || safeModuleName.empty())
            return makeUnexpected(Failure());

        String include = "";
        include.reserve(s_DefaultGeneratedIncludeDirectory.size() + s_CsgGeneratedIncludePathSeparator.size() + safeModuleName.size() + s_CsgSlangIncludeExtension.size());
        include += s_DefaultGeneratedIncludeDirectory;
        include += s_CsgGeneratedIncludePathSeparator;
        include += safeModuleName;
        include += s_CsgSlangIncludeExtension;
        return include;
    }

    public void begin(mut String outSource){
        outSource.clear();
        outSource.append(s_CsgModuleSourceHeader);
    }

    public void appendEval(in CsgShapeTypeId shapeTypeId, in StringView evalInclude, mut String inOutSource){
        inOutSource.append(s_CsgDefineDirective);
        inOutSource.append(s_CsgEvalShapeIdDefineName);
        inOutSource.push_back(' ');
        this.appendDecimal(shapeTypeId, inOutSource);
        inOutSource.append(s_CsgUnsignedLiteralLineEnd);
        inOutSource.append(s_CsgIncludeDirective);
        inOutSource.append(evalInclude);
        inOutSource.append(s_CsgIncludeDirectiveEnd);
        inOutSource.append(s_CsgUndefDirective);
        inOutSource.append(s_CsgEvalShapeIdDefineName);
        inOutSource.append(s_CsgUndefDirectiveEnd);
    }

    private void appendDecimal(in u32 value, mut String inOutText){
        if(value == 0u){
            inOutText.push_back('0');
            return;
        }
        FixedVector<u8, 10u> digits;
        u32 remaining = value;
        while(remaining > 0u){
            digits.push_back(cast<u8>(remaining % 10u));
            remaining = remaining / 10u;
        }
        for(usize index = digits.size(); index > 0u; --index)
            inOutText.push_back(cast<i8>(48u + cast<u32>(digits[index - 1u])));
    }
}

b8 ValidateCsgModuleIncludeConsistency(
    in Name shaderModule,
    in StringView expectedModuleInclude,
    in StringView entryModuleInclude
){
    if(entryModuleInclude == expectedModuleInclude)
        return true;

    error(
        "CSG shape include generation: module '{}' uses multiple generated include paths ('{}' and '{}')",
        shaderModule.resolvedText(),
        expectedModuleInclude,
        entryModuleInclude
    );
    return false;
}


