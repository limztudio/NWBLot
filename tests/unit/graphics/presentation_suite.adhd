AcquiredBackBuffer MakeAcquisition(in u64 value, in u32 imageIndex){
    AcquiredBackBuffer acquired = AcquiredBackBuffer();
    acquired.availabilityCompletion.value = value;
    acquired.availabilityCompletion.physicalQueueIndex = 3u;
    acquired.availabilityCompletion.deviceGeneration = 5u;
    acquired.availabilityCompletion.queue = CommandQueue::Graphics;
    acquired.nativeInitialState = ResourceStates::Present;
    acquired.index = imageIndex;
    return acquired;
}

AcquiredBackBuffer MakeAcquisition(){
    return MakeAcquisition(17u, 2u);
}

void VerifyCooperativeVectorFeatureQuery_EmptyDriverPropertyListDoesNotReadOrPublishFormats(){
    CooperativeVectorQueryHarness harness = CooperativeVectorQueryHarness();
    const Expected<CooperativeVectorDeviceFeatures> result = harness.queryEmptyDriverList();
    ASSERT_TRUE(result.has_value());
    EXPECT_EQ(harness.callCount(), 1u);
    EXPECT_TRUE(result.value().matMulFormats.empty());
    EXPECT_FALSE(result.value().trainingFloat16);
    EXPECT_FALSE(result.value().trainingFloat32);
}

void VerifyCooperativeVectorMatrixPolicy_RejectsTightMisalignedAndOverflowingStrides(){
    const Expected<StandardMatrixLayout> layout = CooperativeVectorMatrixPolicy::StandardLayoutSize(4u, 2u, 3u, CooperativeVectorMatrixLayout::RowMajor, 0u);
    ASSERT_TRUE(layout.has_value());
    EXPECT_EQ(layout.value().stride, 16u);
    EXPECT_EQ(layout.value().byteSize, 28u);
    EXPECT_FALSE(CooperativeVectorMatrixPolicy::StandardLayoutSize(4u, 2u, 3u, CooperativeVectorMatrixLayout::RowMajor, 12u).has_value());
    EXPECT_FALSE(CooperativeVectorMatrixPolicy::StandardLayoutSize(4u, 2u, 3u, CooperativeVectorMatrixLayout::RowMajor, 14u).has_value());
    EXPECT_FALSE(CooperativeVectorMatrixPolicy::StandardLayoutSize(usize.max, 2u, 3u, CooperativeVectorMatrixLayout::RowMajor, 0u).has_value());
    EXPECT_TRUE(CooperativeVectorMatrixPolicy::IsTypeConversionSupported(VK_COMPONENT_TYPE_FLOAT32_KHR, VK_COMPONENT_TYPE_FLOAT16_KHR));
    EXPECT_FALSE(CooperativeVectorMatrixPolicy::IsTypeConversionSupported(VK_COMPONENT_TYPE_FLOAT_E4M3_NV, VK_COMPONENT_TYPE_BFLOAT16_KHR));
}

void VerifyCooperativeVectorMatrixStride_FailsClosedForInvalidOrDriverOptimalInputs(){
    const Expected<usize> inferencingStride = GetCooperativeVectorOptimalMatrixStride(CooperativeVectorDataType::Float32, CooperativeVectorMatrixLayout::InferencingOptimal, 2u, 2u);
    ASSERT_TRUE(inferencingStride.has_value());
    EXPECT_EQ(inferencingStride.value(), 0u);
    const Expected<usize> trainingStride = GetCooperativeVectorOptimalMatrixStride(CooperativeVectorDataType::Float32, CooperativeVectorMatrixLayout::TrainingOptimal, 2u, 2u);
    ASSERT_TRUE(trainingStride.has_value());
    EXPECT_EQ(trainingStride.value(), 0u);
    EXPECT_FALSE(GetCooperativeVectorOptimalMatrixStride(CooperativeVectorDataType::Float32, CooperativeVectorMatrixLayout::RowMajor, 0u, 2u).has_value());
    EXPECT_FALSE(GetCooperativeVectorOptimalMatrixStride(CooperativeVectorDataType::Float32, CooperativeVectorMatrixLayout::ColumnMajor, 2u, 0u).has_value());
    EXPECT_FALSE(GetCooperativeVectorOptimalMatrixStride(cast<CooperativeVectorDataTypeEnum>(u8.max), CooperativeVectorMatrixLayout::RowMajor, 2u, 2u).has_value());
    EXPECT_FALSE(GetCooperativeVectorOptimalMatrixStride(CooperativeVectorDataType::Float32, cast<CooperativeVectorMatrixLayoutEnum>(u8.max), 2u, 2u).has_value());
}

void VerifyCooperativeVectorMatrixStride_DoesNotWrapLargestPublicDimension(){
    const Expected<usize> stride = GetCooperativeVectorOptimalMatrixStride(CooperativeVectorDataType::Float64, CooperativeVectorMatrixLayout::RowMajor, 1u, u32.max);
    if(usize.max > cast<usize>(u32.max)){
        ASSERT_TRUE(stride.has_value());
        const usize expectedColumns = cast<usize>(u32.max) + 1u;
        EXPECT_EQ(stride.value(), expectedColumns * 8u);
    }
    else
        EXPECT_FALSE(stride.has_value());
}

void VerifyDeviceCreationPolicy_SurfacePolicyKeepsFallbackOrderAndRejectsMissingAlpha(){
    Array<VkPresentModeKHR, 2> modes = Array<VkPresentModeKHR, 2>();
    modes[0u] = VK_PRESENT_MODE_MAILBOX_KHR;
    modes[1u] = VK_PRESENT_MODE_FIFO_KHR;
    const Expected<VkPresentModeKHR> mode = SwapChainSurfacePolicy::SelectPresentMode(modes, false);
    ASSERT_TRUE(mode.has_value());
    EXPECT_EQ(mode.value(), VK_PRESENT_MODE_FIFO_KHR);
    const Span<VkPresentModeKHR> emptyModes = Span<VkPresentModeKHR>();
    EXPECT_FALSE(SwapChainSurfacePolicy::SelectPresentMode(emptyModes, false).has_value());

    Array<VkSurfaceFormatKHR, 1> formats = Array<VkSurfaceFormatKHR, 1>();
    formats[0u].format = VK_FORMAT_UNDEFINED;
    formats[0u].colorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
    const Expected<SwapChainSurfaceFormatSelection> format = SwapChainSurfacePolicy::SelectFormat(formats, Format::RGBA8_UNORM_SRGB, true);
    ASSERT_TRUE(format.has_value());
    EXPECT_EQ(format.value().surfaceFormat.format, VK_FORMAT_R8G8B8A8_SRGB);
    EXPECT_EQ(format.value().outputMode, SwapChainOutputMode::SDR);

    VkSurfaceCapabilitiesKHR caps = VkSurfaceCapabilitiesKHR();
    caps.currentExtent.width = u32.max;
    caps.currentExtent.height = u32.max;
    caps.minImageExtent.width = 100u;
    caps.minImageExtent.height = 200u;
    caps.maxImageExtent.width = 500u;
    caps.maxImageExtent.height = 600u;
    caps.minImageCount = 2u;
    caps.maxImageCount = 3u;
    const VkExtent2D extent = SwapChainSurfacePolicy::ResolveExtent(caps, 1u, 900u);
    EXPECT_EQ(extent.width, 100u);
    EXPECT_EQ(extent.height, 600u);
    EXPECT_EQ(SwapChainSurfacePolicy::ImageCount(caps, 5u), 3u);
    EXPECT_FALSE(SwapChainSurfacePolicy::SelectCompositeAlpha(caps).has_value());
    caps.supportedCompositeAlpha = cast<VkCompositeAlphaFlagsKHR>(VK_COMPOSITE_ALPHA_POST_MULTIPLIED_BIT_KHR) | cast<VkCompositeAlphaFlagsKHR>(VK_COMPOSITE_ALPHA_INHERIT_BIT_KHR);
    const Expected<VkCompositeAlphaFlagBitsKHR> alpha = SwapChainSurfacePolicy::SelectCompositeAlpha(caps);
    ASSERT_TRUE(alpha.has_value());
    EXPECT_EQ(alpha.value(), VK_COMPOSITE_ALPHA_POST_MULTIPLIED_BIT_KHR);
}

void VerifyDeviceCreationPolicy_QueueRegistrationRejectsBoundaryAndDuplicateIdentity(){
    const NativeQueueState nativeQueue = NativeQueueState(MakeDummyVkQueue(1u), 4u, 2u);
    VulkanPhysicalQueueDesc desc = VulkanPhysicalQueueDesc();
    desc.queueClass = CommandQueue::Graphics;
    desc.capabilities = GpuQueueCapability::Graphics | GpuQueueCapability::Transfer;
    desc.timestampValidBits = 35u;
    PrimaryQueueFlags primaries = PrimaryQueueFlags();
    const Span<GpuPhysicalQueueInfo> emptyExisting = Span<GpuPhysicalQueueInfo>();
    EXPECT_EQ(PhysicalQueueRegistrationPolicy::Validate(desc, nativeQueue, emptyExisting, primaries), PhysicalQueueRegistrationResult::Invalid);
    desc.timestampValidBits = 36u;
    EXPECT_EQ(PhysicalQueueRegistrationPolicy::Validate(desc, nativeQueue, emptyExisting, primaries), PhysicalQueueRegistrationResult::Valid);
    Array<GpuPhysicalQueueInfo, 1> existing = Array<GpuPhysicalQueueInfo, 1>();
    existing[0u].familyIndex = 4u;
    existing[0u].queueIndex = 2u;
    EXPECT_EQ(PhysicalQueueRegistrationPolicy::Validate(desc, nativeQueue, existing, primaries), PhysicalQueueRegistrationResult::DuplicateQueue);
    desc.primaryForClass = true;
    primaries[cast<usize>(CommandQueue::Graphics)] = true;
    EXPECT_EQ(PhysicalQueueRegistrationPolicy::Validate(desc, nativeQueue, emptyExisting, primaries), PhysicalQueueRegistrationResult::DuplicatePrimary);
}

void VerifyDeviceCreationPolicy_QueueSharingUsesFirstDistinctFamilyAndHandlesMissingPrimary(){
    const u32 missing = u32.max;
    Array<GpuPhysicalQueueInfo, 5> queues = Array<GpuPhysicalQueueInfo, 5>();
    queues[0u].queueClass = CommandQueue::Graphics;
    queues[0u].familyIndex = 4u;
    queues[1u].queueClass = CommandQueue::Graphics;
    queues[1u].familyIndex = 7u;
    queues[2u].queueClass = CommandQueue::Graphics;
    queues[2u].familyIndex = 8u;
    queues[3u].queueClass = CommandQueue::Compute;
    queues[3u].familyIndex = 4u;
    queues[4u].queueClass = CommandQueue::Transfer;
    queues[4u].familyIndex = 9u;
    const SharedQueueFamilies shared = PhysicalQueueSharingPolicy::Resolve(queues, 4u, 4u, 9u);
    EXPECT_EQ(shared.graphics, 4);
    EXPECT_EQ(shared.auxiliaryGraphics, 7);
    EXPECT_EQ(shared.auxiliaryCompute, -1);
    EXPECT_FALSE(shared.asyncComputeLaneEnabled);
    EXPECT_TRUE(shared.transferQueueEnabled);
    const SharedQueueFamilies missingGraphics = PhysicalQueueSharingPolicy::Resolve(queues, missing, 4u, 4u);
    EXPECT_EQ(missingGraphics.graphics, -1);
    EXPECT_EQ(missingGraphics.auxiliaryGraphics, -1);
    EXPECT_FALSE(missingGraphics.asyncComputeLaneEnabled);
    EXPECT_FALSE(missingGraphics.transferQueueEnabled);
}

void VerifyDeviceCreationPolicy_CanonicalQueuesRejectAliasedHandlesAndOutOfRangeIndices(){
    Array<VkQueueFamilyProperties, 1> families = Array<VkQueueFamilyProperties, 1>();
    families[0u].queueCount = 2u;
    Array<VulkanNativeQueueDesc, 2> queues = Array<VulkanNativeQueueDesc, 2>();
    queues[0u].queue = MakeDummyVkQueue(1u);
    queues[0u].familyIndex = 0u;
    queues[0u].queueIndex = 0u;
    queues[1u].queue = MakeDummyVkQueue(2u);
    queues[1u].familyIndex = 0u;
    queues[1u].queueIndex = 1u;
    EXPECT_EQ(PhysicalQueueRegistrationPolicy::ValidateCanonical(queues, families), PhysicalQueueRegistrationResult::Valid);
    queues[1u].queue = queues[0u].queue;
    EXPECT_EQ(PhysicalQueueRegistrationPolicy::ValidateCanonical(queues, families), PhysicalQueueRegistrationResult::DuplicateQueue);
    queues[1u].queue = MakeDummyVkQueue(2u);
    queues[1u].queueIndex = 2u;
    EXPECT_EQ(PhysicalQueueRegistrationPolicy::ValidateCanonical(queues, families), PhysicalQueueRegistrationResult::Invalid);
}

void VerifyDeviceCreationPolicy_QueuePlanKeepsCrossFamilyOrderAndStablePriorities(){
    Array<u32, 4> expectedCounts = Array<u32, 4>();
    expectedCounts[0u] = 3u;
    expectedCounts[1u] = 1u;
    expectedCounts[2u] = 2u;
    expectedCounts[3u] = 1u;
    native(in expectedCounts){
        using Plan = Core::GraphicsBackend::VulkanQueueRequestPlan;
        Core::Alloc::ScratchArena scratch(NWB::Tests::s_TestArena);
        Vector<VkQueueFamilyProperties, Core::Alloc::ScratchArena> families(scratch);
        families.resize(4u);
        for(usize index = 0u; index < 4u; ++index)
            families[index].queueCount = expectedCounts[index];
        NWB::Tests::TestArena<> arena;
        Core::DeviceCreationParameters params(arena.arena);
        params.enableSameClassMultiQueue = true;
        params.headlessDevice = false;
        const Plan::Input input{
            .deviceParams = params,
            .physicalQueueFamilies = families,
            .graphicsQueueFamily = 0,
            .secondaryGraphicsQueueFamily = 1,
            .presentQueueFamily = 1,
            .schedulerComputeQueueFamily = 2,
            .secondaryComputeQueueFamily = -1,
            .transferQueueFamily = 3,
            .secondaryTransferQueueFamily = -1,
            .createCrossFamilySecondaryGraphicsQueue = true,
            .createComputeQueue = true,
            .createCrossFamilySecondaryComputeQueue = false,
            .createDedicatedTransferQueue = true,
            .createCrossFamilySecondaryTransferQueue = false,
        };
        const Plan plan(scratch, input);
        const auto& requests = plan.sameClassQueueRequests();
        ASSERT_EQ(requests.size(), 4u);
        EXPECT_EQ(requests[0].family, 1);
        EXPECT_EQ(requests[0].queueIndex, 0u);
        EXPECT_EQ(requests[1].family, 0);
        EXPECT_EQ(requests[1].queueIndex, 1u);
        EXPECT_EQ(requests[2].family, 0);
        EXPECT_EQ(requests[2].queueIndex, 2u);
        EXPECT_EQ(requests[3].family, 2);
        EXPECT_EQ(requests[3].queueIndex, 1u);
        const auto& queues = plan.queueDescriptions();
        ASSERT_EQ(queues.size(), 4u);
        for(u32 i = 0u; i < 4u; ++i){
            EXPECT_EQ(queues[i].queueFamilyIndex, i);
            EXPECT_EQ(queues[i].queueCount, expectedCounts[i]);
            EXPECT_EQ(queues[i].pQueuePriorities, queues[0].pQueuePriorities);
            for(u32 j = 0u; j < queues[i].queueCount; ++j)
                EXPECT_EQ(queues[i].pQueuePriorities[j], 1.0f);
        }
    }
}

void VerifyDeviceCreationPolicy_RejectsUnknownHardwareRayTracingPolicy(){
    EXPECT_FALSE(IsValidHardwareRayTracingPolicy(cast<HardwareRayTracingPolicyEnum>(255u)));
}

void VerifyPresentationReceipt_RejectedAttemptCannotBeQualifiedByALaterDifferentSuccessfulFrame(){
    const AcquiredBackBuffer rejected = MakeAcquisition(17u, 2u);
    const AcquiredBackBuffer accepted = MakeAcquisition(18u, 3u);
    PresentationReceipt receipt = PresentationReceipt();
    receipt.record(rejected, false);
    EXPECT_EQ(receipt.status(rejected), PresentationReceiptStatus::Rejected);
    EXPECT_EQ(receipt.status(accepted), PresentationReceiptStatus::Pending);
    receipt.record(accepted, true);
    EXPECT_EQ(receipt.status(accepted), PresentationReceiptStatus::Accepted);
    EXPECT_EQ(receipt.status(rejected), PresentationReceiptStatus::Pending);
}

void VerifyPresentationReceipt_ImageReuseRequiresItsNewAcquisitionTimelineIdentity(){
    const AcquiredBackBuffer first = MakeAcquisition(17u, 2u);
    const AcquiredBackBuffer reused = MakeAcquisition(18u, 2u);
    PresentationReceipt receipt = PresentationReceipt();
    receipt.record(first, true);
    EXPECT_EQ(receipt.status(first), PresentationReceiptStatus::Accepted);
    EXPECT_EQ(receipt.status(reused), PresentationReceiptStatus::Pending);
    receipt.record(reused, false);
    EXPECT_EQ(receipt.status(reused), PresentationReceiptStatus::Rejected);
    EXPECT_EQ(receipt.status(first), PresentationReceiptStatus::Pending);
}

void VerifyPresentationReceipt_EqualTimelineValuesOnDifferentQueuesDevicesOrImagesDoNotMatch(){
    const AcquiredBackBuffer acquired = MakeAcquisition();
    PresentationReceipt receipt = PresentationReceipt();
    receipt.record(acquired, true);
    Array<AcquiredBackBuffer, 5> variants = Array<AcquiredBackBuffer, 5>();
    for(mut AcquiredBackBuffer variant : variants)
        variant = acquired;
    ++variants[0u].availabilityCompletion.physicalQueueIndex;
    ++variants[1u].availabilityCompletion.deviceGeneration;
    variants[2u].availabilityCompletion.queue = CommandQueue::Compute;
    ++variants[3u].index;
    variants[4u].nativeInitialState = ResourceStates::Unknown;
    for(in AcquiredBackBuffer variant : variants)
        EXPECT_EQ(receipt.status(variant), PresentationReceiptStatus::Pending);
    EXPECT_EQ(receipt.status(acquired), PresentationReceiptStatus::Accepted);
}

void VerifyPresentationReceipt_InvalidTokensAndImageStatesNeverPublishEvidence(){
    const AcquiredBackBuffer acquired = MakeAcquisition();
    Array<AcquiredBackBuffer, 7> variants = Array<AcquiredBackBuffer, 7>();
    for(mut AcquiredBackBuffer variant : variants)
        variant = acquired;
    variants[0u].availabilityCompletion.value = 0u;
    variants[1u].availabilityCompletion.physicalQueueIndex = u16.max;
    variants[2u].availabilityCompletion.deviceGeneration = 0u;
    variants[3u].availabilityCompletion.queue = CommandQueue::kCount;
    variants[4u].index = u32.max;
    variants[5u].nativeInitialState = ResourceStates::ShaderResource;
    variants[6u] = AcquiredBackBuffer();
    PresentationReceipt receipt = PresentationReceipt();
    for(in AcquiredBackBuffer variant : variants){
        receipt.record(acquired, true);
        EXPECT_EQ(receipt.status(variant), PresentationReceiptStatus::Pending);
        receipt.record(variant, true);
        EXPECT_FALSE(receipt.valid());
        EXPECT_EQ(receipt.status(variant), PresentationReceiptStatus::Pending);
        EXPECT_EQ(receipt.status(acquired), PresentationReceiptStatus::Pending);
    }
}

void VerifyPresentationReceipt_UnknownInitialStateIsAValidDistinctAcquisitionState(){
    AcquiredBackBuffer acquired = MakeAcquisition();
    acquired.nativeInitialState = ResourceStates::Unknown;
    PresentationReceipt receipt = PresentationReceipt();
    receipt.record(acquired, true);
    ASSERT_TRUE(receipt.valid());
    EXPECT_EQ(receipt.status(acquired), PresentationReceiptStatus::Accepted);
    acquired.nativeInitialState = ResourceStates::Present;
    EXPECT_EQ(receipt.status(acquired), PresentationReceiptStatus::Pending);
}

void VerifyPresentationReceipt_ResetAtLifetimeBoundaryRemovesEarlierAcquisitionEvidence(){
    const AcquiredBackBuffer acquired = MakeAcquisition();
    PresentationReceipt receipt = PresentationReceipt();
    receipt.record(acquired, true);
    ASSERT_EQ(receipt.status(acquired), PresentationReceiptStatus::Accepted);
    receipt.reset();
    EXPECT_FALSE(receipt.valid());
    EXPECT_EQ(receipt.status(acquired), PresentationReceiptStatus::Pending);
    receipt.record(acquired, false);
    ASSERT_EQ(receipt.status(acquired), PresentationReceiptStatus::Rejected);
    receipt.reset();
    EXPECT_FALSE(receipt.valid());
    EXPECT_EQ(receipt.status(acquired), PresentationReceiptStatus::Pending);
}


