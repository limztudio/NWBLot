    EXPECT_EQ(self.m_state.combo().listState().inputGeneration(), previewGeneration);
}

void VerifyUiSearchComboBehaviorTests_ReentrantComboSelectionAndPopupChangesRemainAuthoritative(mut UiSearchComboBehaviorTests self){
    Array<UiSearchComboBehaviorMutationEnum, 3u> mutations;
    mutations[0u] = UiSearchComboBehaviorMutation::Selection;
    mutations[1u] = UiSearchComboBehaviorMutation::Open;
    mutations[2u] = UiSearchComboBehaviorMutation::Close;
    for(in UiSearchComboBehaviorMutationEnum mutation : mutations){
        SearchComboState state = SearchComboState(self.m_arena);
        UiSearchComboBehaviorSource source = UiSearchComboBehaviorSource(self.m_arena, state);
        state.combo().select(5u);
        state.combo().open();
        const u64 inputGeneration = state.combo().inputGeneration();
        source.onFilter = mutation;
        EXPECT_FALSE(UiSearchComboFilterState(state, source));
        EXPECT_NE(state.combo().inputGeneration(), inputGeneration);
        u64 expectedSelected = 5u;
        if(mutation == UiSearchComboBehaviorMutation::Selection)
            expectedSelected = 8u;
        EXPECT_EQ(state.combo().selectedKey(), expectedSelected);
        EXPECT_EQ(state.combo().isOpen(), mutation == UiSearchComboBehaviorMutation::Open);
    }
}

void VerifyUiSearchComboBehaviorTests_ReentrantPreviewScrollCannotBeOverwrittenByFilterReset(mut UiSearchComboBehaviorTests self){
