#include <impl/ecs_render/reflection/settings.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


ReflectionFeedbackPlan ResolveReflectionFeedbackPlan(
    in ReflectionSceneContentStamp stamp,
    in ReflectionSettings settings,
    in b8 enabled,
    in u64 graphicsFrameIndex,
    in ReflectionSceneContentStamp previousStamp,
    in ReflectionSettings previousSettings,
    in u64 generation,
    in u64 sequence,
    in u64 acceptedSequence,
    in u64 epoch,
    in u64 startGraphicsFrame,
    in u32 nextProbeIndex,
    in u32 acceptedBank,
    in b8 previousEnabled,
    in b8 previousEligible,
    in b8 previousHardwareReady,
    in b8 resourcesChanged,
    in b8 quarantined
){
    ReflectionFeedbackPlan result;
    result.stamp = stamp;
    result.settings = settings;
    result.generation = generation;
    result.sequence = sequence;
    result.acceptedSequence = acceptedSequence;
    result.graphicsFrameIndex = graphicsFrameIndex;
    result.enabled = enabled;
    result.previousHardwareReady = previousHardwareReady;
    result.quarantined = quarantined;
    if(quarantined)
        result.resetReason = ReflectionFeedbackResetReason::InvalidAcceptance;
    else if(acceptedSequence == 0u){
        if(resourcesChanged)
            result.resetReason = ReflectionFeedbackResetReason::ResourcesChanged;
        else
            result.resetReason = ReflectionFeedbackResetReason::FirstObservation;
    }
    else if(enabled != previousEnabled || !SameReflectionTraceSettings(settings, previousSettings))
        result.resetReason = ReflectionFeedbackResetReason::SettingsChanged;
    else if(!stamp.matchesScene(previousStamp))
        result.resetReason = ReflectionFeedbackResetReason::SceneChanged;
    else if(stamp.view != previousStamp.view)
        result.resetReason = ReflectionFeedbackResetReason::ViewChanged;
    result.reset = result.resetReason != ReflectionFeedbackResetReason::None;
    if(result.reset)
        result.epoch = epoch + 1u;
    else
        result.epoch = epoch;
    if(result.reset)
        result.startGraphicsFrame = graphicsFrameIndex;
    else
        result.startGraphicsFrame = startGraphicsFrame;
    if(result.reset)
        result.probeIndex = 0u;
    else
        result.probeIndex = nextProbeIndex;
    result.eligible = !quarantined && enabled && stamp.trusted && settings.traceMode == ReflectionTraceMode::Hybrid && settings.maxHardwareRaysPerFrame > 0u;
    result.reused = result.eligible && previousEligible && !result.reset;
    result.previousBank = acceptedBank;
    // Never overwrite the accepted bank.
    if(acceptedSequence != 0u)
        result.currentBank = 1u - acceptedBank;
    else
        result.currentBank = 0u;
    if(!quarantined && result.reset && (!enabled || settings.traceMode != ReflectionTraceMode::Hybrid || settings.maxHardwareRaysPerFrame == 0u))
        result.resetReason = ReflectionFeedbackResetReason::Disabled;
    else if(!quarantined && result.reset && !stamp.trusted)
        result.resetReason = ReflectionFeedbackResetReason::UntrustedScene;
    return result;
}

ReflectionFeedbackOutcome ResolveReflectionFeedbackOutcome(in ReflectionFeedbackPlan plan, in b8 hardwareReady){
    const b8 hardwareChanged = !plan.reset && plan.acceptedSequence != 0u && plan.previousHardwareReady != hardwareReady;
    ReflectionFeedbackOutcome result;
    if(hardwareChanged){
        result.epoch = plan.epoch + 1u;
        result.startGraphicsFrame = plan.graphicsFrameIndex;
        result.probeIndex = 0u;
    }
    else{
        result.epoch = plan.epoch;
        result.startGraphicsFrame = plan.startGraphicsFrame;
        result.probeIndex = plan.probeIndex;
    }
    result.eligible = plan.eligible && hardwareReady;
    result.reused = result.eligible && plan.reused && !hardwareChanged;
    result.reset = plan.reset || hardwareChanged;
    if(hardwareChanged)
        result.resetReason = ReflectionFeedbackResetReason::HardwareChanged;
    else
        result.resetReason = plan.resetReason;
    return result;
}

b8 CanReserveReflectionFeedbackPlan(
    in b8 quarantined,
    in u16 deviceGeneration,
    in u64 reservedSequence,
    in u64 currentGeneration,
    in u64 currentAcceptedSequence,
    in ReflectionFeedbackPlan plan
){
    return !quarantined
        && deviceGeneration != 0u
        && reservedSequence == 0u
        && plan.generation == currentGeneration
        && plan.sequence > currentAcceptedSequence
        && plan.acceptedSequence == currentAcceptedSequence;
}

void ApplyAcceptedReflectionFeedbackPlan(
    in ReflectionFeedbackPlan plan,
    in b8 hardwareReady,
    mut ReflectionSceneContentStamp outStamp,
    mut ReflectionSettings outSettings,
    mut u64 outAcceptedSequence,
    mut u64 outEpoch,
    mut u64 outStartGraphicsFrame,
    mut u32 outNextProbeIndex,
    mut u32 inOutAcceptedBank,
    mut b8 outEnabled,
    mut b8 outEligible,
    mut b8 outHardwareReady,
    mut b8 outResourcesChanged
){
    const ReflectionFeedbackOutcome outcome = ResolveReflectionFeedbackOutcome(plan, hardwareReady);
    outStamp = plan.stamp;
    outSettings = plan.settings;
    outAcceptedSequence = plan.sequence;
    outEpoch = outcome.epoch;
    outStartGraphicsFrame = outcome.startGraphicsFrame;
    if(outcome.eligible){
        outNextProbeIndex = outcome.probeIndex + 1u;
        inOutAcceptedBank = plan.currentBank;
    }
    else
        outNextProbeIndex = 0u;
    outEnabled = plan.enabled;
    outEligible = outcome.eligible;
    outHardwareReady = hardwareReady;
    outResourcesChanged = false;
}

void ApplyReflectionStatisticsFeedbackOutcome(
    in ReflectionFeedbackOutcome feedback,
    mut ReflectionStatistics inOutMetadata
){
    inOutMetadata.feedbackEpoch = feedback.epoch;
    inOutMetadata.feedbackStartGraphicsFrame = feedback.startGraphicsFrame;
    inOutMetadata.feedbackProbeIndex = feedback.probeIndex;
    inOutMetadata.feedbackEnabled = feedback.eligible;
    inOutMetadata.feedbackReused = feedback.reused;
    inOutMetadata.feedbackReset = feedback.reset;
    inOutMetadata.feedbackResetReason = feedback.resetReason;
}


