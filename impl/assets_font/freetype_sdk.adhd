[cpp_header("<impl/assets_font/freetype_sdk.h>"), cpp_name("::NWB::FontSdk::FreeTypeBitmapView"), cpp_flags(self_defaulted, borrow_view)]
extern class FreeTypeBitmapView{
    Span<u8> pixels;
    u32 width;
    u32 rows;
    i32 pitch;
    i32 left;
    i32 top;
    b8 grayscale;
    b8 colorBgra;
};

[cpp_header("<impl/assets_font/freetype_sdk.h>"), cpp_name("::NWB::FontSdk::FreeTypeFaceVisitResult"), cpp_flags(self_defaulted)]
extern class FreeTypeFaceVisitResult{
    i32 openError;
    i32 closeError;
};

[cpp_header("<impl/assets_font/freetype_sdk.h>"), cpp_name("FT_LOAD_NO_SCALE")]
extern const i32 s_FreeTypeLoadNoScale;

[cpp_header("<impl/assets_font/freetype_sdk.h>"), cpp_name("FT_LOAD_NO_HINTING")]
extern const i32 s_FreeTypeLoadNoHinting;

[cpp_header("<impl/assets_font/freetype_sdk.h>"), cpp_name("FT_LOAD_NO_BITMAP")]
extern const i32 s_FreeTypeLoadNoBitmap;

[cpp_header("<impl/assets_font/freetype_sdk.h>"), cpp_name("FT_LOAD_COLOR")]
extern const i32 s_FreeTypeLoadColor;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets_font/freetype_sdk.h>"), cpp_name("::NWB::FontSdk::FreeTypeFaceView"), cpp_flags(no_copy, no_assign, abstract)]
extern class FreeTypeFaceView{
    i64 faceCount()const;
    i64 glyphCount()const;
    u32 unitsPerEm()const;
    b8 isSfnt()const;
    b8 isScalable()const;
    b8 hasColor()const;
    i32 strikeCount()const;
    i32 selectBestStrike(in u32 pixelSize, mut u32 outStrikePpem)const;
    b8 hasMultipleMasters()const;
    i32 selectUnicodeCharmap();
    i32 setPixelSizes(in u32 width, in u32 height);
    i32 loadGlyph(in u32 glyph, in i32 flags);
    i32 renderNormal();
    b8 hasOutline()const;
    i32 outlinePointCount()const;
    FreeTypeBitmapView bitmap()const;
};

[cpp_header("<impl/assets_font/freetype_sdk.h>"), cpp_name("::NWB::FontSdk::FreeTypeLibrary"), cpp_flags(arena_first_ctor, no_copy, no_assign)]
extern class FreeTypeLibrary{
    i32 createLibrary();
    void addDefaultModules();
    FreeTypeFaceVisitResult visitMemoryFace(in Span<u8> bytes, in i64 index, in Func<64u, void(mut FreeTypeFaceView)> visitor);
    i32 closeLibrary();
};


