    const MaterialInstanceMutableCache& cache,
    const Core::ECS::EntityID entity,
    const MaterialSurfaceInfo& surface
)noexcept{
    return cache.find(entity, surface, nullptr);
}

[[nodiscard]] NWB_INLINE Expected<Span<const u8>> PrepareMutableCacheWithInstance(
    MaterialInstanceMutableCache& cache,
    Tests::EcsTestWorld& context,
    const Core::ECS::EntityID entity,
    const MaterialSurfaceInfo& surface,
    const MaterialInstanceComponent& instance
){
    return cache.prepare(context.world, entity, surface, &instance);
}

[[nodiscard]] NWB_INLINE b8 ApplyMaterialInstanceOverridesToPrefix(
    const MaterialInstanceOverrideApplier& applier,
    const u32 entityId,
    const Name materialName,
    const Name interfaceName,
    const MaterialTypedLayoutBlock& block,
    const MaterialTypedLayoutField& field,
    const MaterialInstanceComponent& instance,
    Array<u8, 8>& bytes,
    const usize byteCount
){
    const Span<const MaterialTypedLayoutBlock> blocks(&block, 1u);
    const Span<const MaterialTypedLayoutField> fields(&field, 1u);
    const Span<u8> destination(bytes.data(), byteCount);
    return applier.apply(entityId, materialName, interfaceName, blocks, fields, instance, destination);
}

struct MaterialConstantRangeTestContext{
    using RangeMap = ECSRenderDetail::MaterialTypedConstantRangeMap;

    Core::Alloc::ScratchArena scratchArena{ s_ScratchArena };
    ::Vector<u8, Core::Alloc::ScratchArena> uploadBytes{ scratchArena };
    RangeMap ranges{ 0, RangeMap::hasher(), RangeMap::key_equal(), scratchArena };


public:
    MaterialConstantRangeTestContext(){
        ranges.reserve(3u);
    }


public:
    [[nodiscard]] Expected<MaterialTypedByteRange> findOrAppend(const Name material, const u64 layoutHash, const Span<const u8> constants){
        return ECSRenderDetail::FindOrAppendMaterialConstantTypedByteRange(material, layoutHash, constants, uploadBytes, ranges);
    }

    [[nodiscard]] usize uploadSize()const noexcept{ return uploadBytes.size(); }
    [[nodiscard]] usize rangeCount()const noexcept{ return ranges.size(); }

    void verifyStoredRanges(const Name material, const Name otherMaterial, const Span<const u8> constants)const{
        for(const auto& [key, range] : ranges){
            EXPECT_TRUE(key.materialName == material || key.materialName == otherMaterial);
            ASSERT_EQ(range.byteCount, constants.size());
            ASSERT_LE(static_cast<usize>(range.byteOffset) + static_cast<usize>(range.byteCount), uploadBytes.size());
            EXPECT_EQ(NWB_MEMCMP(uploadBytes.data() + range.byteOffset, constants.data(), constants.size()), 0);
        }
    }
};

struct MaterialTypedByteRangeTestContext{
    using ByteKey = ECSRenderDetail::MaterialTypedByteContentKey;
    using ByteLookup = MaterialTypedByteContentLookup;
    using ByteRange = MaterialTypedByteRange;
    using RangeMap = ECSRenderDetail::MaterialTypedByteContentRangeMap;

    Core::Alloc::ScratchArena scratchArena{ s_ScratchArena };
    ::Vector<u8, Core::Alloc::ScratchArena> uploadBytes{ scratchArena };
    RangeMap ranges{ 0u, RangeMap::hasher(), RangeMap::key_equal(), scratchArena };


public:
    void reserveStorage(const usize byteCapacity, const usize rangeCapacity){
        uploadBytes.reserve(byteCapacity);
        ranges.reserve(rangeCapacity);
    }

    [[nodiscard]] Expected<ByteRange> findOrAppend(const Span<const u8> bytes){
        return ECSRenderDetail::FindOrAppendMaterialTypedByteRange(bytes, uploadBytes, ranges);
    }

    [[nodiscard]] Expected<ByteRange> appendSelfAliasedUploadBytes(){
        const Span<const u8> aliasedBytes(uploadBytes.data(), uploadBytes.size());
        return ECSRenderDetail::FindOrAppendMaterialTypedByteRange(aliasedBytes, uploadBytes, ranges);
    }

    [[nodiscard]] ArenaMemoryStats memoryStats()const noexcept{ return scratchArena.memoryStats(); }
    [[nodiscard]] usize uploadSize()const noexcept{ return uploadBytes.size(); }
    [[nodiscard]] usize uploadCapacity()const noexcept{ return uploadBytes.capacity(); }
    [[nodiscard]] usize rangeCount()const noexcept{ return ranges.size(); }

    [[nodiscard]] b8 emplaceOwnedKey(const u64 hash, const Span<const u8> bytes, const u32 byteOffset, const u32 byteCount){
        ByteRange range;
        range.byteOffset = byteOffset;
        range.byteCount = byteCount;
        const ByteLookup lookup(hash, bytes);
        return ranges.emplace(ByteKey(scratchArena, lookup), range).second;
    }

    [[nodiscard]] Optional<ByteRange> findByLookup(const u64 hash, const Span<const u8> bytes)const{
        const ByteLookup lookup(hash, bytes);
        const auto found = ranges.find(lookup);
        if(found == ranges.end())
            return Optional<ByteRange>{};
        return found.value();
    }

    void fillUploadPattern(const usize expectedSize, Array<u8, 32>& outExpected){
        uploadBytes.reserve(expectedSize);
        uploadBytes.resize(uploadBytes.capacity());
        for(usize index = 0u; index < uploadBytes.size(); ++index){
            uploadBytes[index] = static_cast<u8>((index * 31u) & 255u);
            if(index < outExpected.size())
                outExpected[index] = uploadBytes[index];
        }
    }

    [[nodiscard]] b8 rangeMatchesUpload(const ByteRange& range, const Span<const u8> expected)const noexcept{
        if(static_cast<usize>(range.byteOffset) + expected.size() > uploadBytes.size())
            return false;
        return NWB_MEMCMP(uploadBytes.data() + range.byteOffset, expected.data(), expected.size()) == 0;
    }

    void invertUploadPrefix(const usize count)noexcept{
        for(usize index = 0u; index < count && index < uploadBytes.size(); ++index)
            uploadBytes[index] ^= 255u;
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


