NWB_FBX_TO_NWB_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(sizeof(MeshSkinInfluence) == sizeof(u16) * Impl::s_SkinInfluenceJointCount + sizeof(Float4U));
static_assert(alignof(MeshSkinInfluence) <= alignof(f32));
static_assert(IsTriviallyCopyable_V<MeshSkinInfluence>);

struct MeshSkinInfluenceEqual{
public:
    b8 operator()(const MeshSkinInfluence& lhs, const MeshSkinInfluence& rhs)const noexcept;
};

// Unaligned affine storage crosses the importer's persistent/SIMD boundary through LoadFloat()/StoreFloat().
using JointMatrix = Float34U;
static_assert(sizeof(JointMatrix) == sizeof(f32) * Impl::s_SkeletonJointMatrixFloatCount);
static_assert(alignof(JointMatrix) == alignof(f32));
static_assert(IsTriviallyCopyable_V<JointMatrix>);
static_assert(IsTriviallyCopyable_V<SourceVertexRef>);
static_assert(IsTriviallyCopyable_V<SourceTriangleCorner>);

struct SourceMeshStreams{
    UtilityVector<Vec3> positions;
    UtilityVector<Vec3> normals;
    UtilityVector<Vec4> tangents;
    UtilityVector<Vec2> uv0;
    UtilityVector<Vec4> colors;
    UtilityVector<MeshSkinInfluence> skin;
    UtilityVector<SourceVertexRef> vertexRefs;
    UtilityVector<u32> indices;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct MeshBuildResult{
    SourceMeshStreams mesh;
    UtilityVector<ufbx_node*> skeletonJoints;
    UtilityVector<JointMatrix> skeletonBindPoseMatrices;
    UtilityVector<JointMatrix> inverseBindMatrices;
    b8 sawVertexColors = false;
    b8 sawVertexUvs = false;
    SourceTangentReport tangentReport;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct ImportOptions{
    UtilityString inputPath;
    UtilityString outputPath;
    UtilityString assetType = UtilityString(s_DefaultOutputAssetTypeText);
    UtilityString virtualRoot = UtilityString(s_DefaultVirtualRootText);
    UtilityString meshSelector = UtilityString(s_DefaultMeshSelectorText);
    UtilityString normalMode = UtilityString(s_DefaultNormalModeText);
    UtilityString defaultColorText = UtilityString(s_DefaultColorText);
    f64 scale = s_DefaultImportScale;
    f64 triangleAreaLengthSquaredEpsilon = s_DefaultTriangleAreaLengthSquaredEpsilon;
    b8 preserveSpace = false;
    b8 includeHidden = false;
    b8 bakeTransforms = true;
    b8 importColors = true;
    b8 flipWinding = false;
    b8 separateAssets = false;
    b8 refreshNwb = false;
    b8 forceOverwrite = false;
    b8 acceptDefaults = false;
    b8 listMeshes = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct MeshInstance{
    ufbx_node* node = nullptr;
    ufbx_mesh* mesh = nullptr;
    usize index = 0u;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct SceneHandle : NoCopy{
public:
    ufbx_scene* scene = nullptr;


public:
    SceneHandle()noexcept = default;
    SceneHandle(SceneHandle&& other)noexcept
        : scene(Exchange(other.scene, nullptr))
    {}
    ~SceneHandle()noexcept;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] constexpr AStringView UfbxStringView(const ufbx_string value)noexcept{
    return (value.data && value.length != 0u) ? AStringView(value.data, value.length) : AStringView{};
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace FbxSkinDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct ExportContext{
    UtilityVector<ufbx_node*> joints;
    UtilityVector<JointMatrix> bindPoseMatrices;
    UtilityVector<JointMatrix> inverseBindMatrices;
    UtilityScratchMap<NotNull<ufbx_node*>, u16> jointLookup;


public:
    explicit ExportContext(Core::Alloc::ScratchArena& scratchArena)
        : jointLookup(scratchArena)
    {}
};

Expected<::Vector<u16, Core::Alloc::ScratchArena>> BuildClusterJointMap(const MeshInstance& instance, const ImportOptions& options, const ufbx_skin_deformer& skin, Core::Alloc::ScratchArena& scratchArena, ExportContext& inOutContext);

Expected<MeshSkinInfluence> LoadInfluence(const ufbx_skin_deformer& skin, Span<const u16> clusterJoints, u32 logicalVertex);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace AssetWriterSkeletonDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct SkeletonOutputData{
    UtilityVector<ufbx_node*> joints;
    UtilityVector<JointMatrix> bindPoseMatrices;
    UtilityVector<JointMatrix> inverseBindMatrices;
    UtilityVector<u16> oldToNewJointIndices;
};

struct PositionAlignedSkinnedMesh{
    SourceMeshStreams mesh;
    UtilityVector<MeshSkinInfluence> skin;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] ScratchString NodeName(const ufbx_node* node, usize fallbackIndex, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<SkeletonOutputData> BuildSkeletonOutputData(Span<ufbx_node* const> joints, Span<const JointMatrix> bindPoseMatrices, Span<const JointMatrix> inverseBindMatrices, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<PositionAlignedSkinnedMesh> BuildPositionAlignedSkinnedMesh(const SourceMeshStreams& sourceMesh, Core::Alloc::ScratchArena& scratchArena);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<SceneHandle> LoadScene(const ImportOptions& options, Core::Alloc::ScratchArena& scratchArena);
UtilityVector<MeshInstance> CollectMeshInstances(const ufbx_scene& scene, b8 includeHidden);
void PrintMeshInstances(Span<const MeshInstance> instances, Core::Alloc::ScratchArena& scratchArena);
Expected<UtilityVector<usize>> SelectMeshInstances(Span<const MeshInstance> instances, AStringView selector);
Expected<MeshBuildResult> BuildMesh(
    Span<const MeshInstance> instances,
    Span<const usize> selection,
    const ImportOptions& options,
    b8 wantsSkinning,
    const Vec4& defaultColor,
    Core::Alloc::ScratchArena& scratchArena
);

[[nodiscard]] Expected<SourceMeshCanonicalizeReport> RefreshNwbMeshAsset(const ScratchPath& inputPath, const ScratchPath& outputPath, Core::Alloc::ScratchArena& scratchArena);

b8 WriteNwbAsset(
    const ScratchPath& outputPath,
    const SourceMeshStreams& mesh,
    AStringView assetTypeText,
    AStringView virtualRoot,
    b8 separateAssets,
    Span<ufbx_node* const> skeletonJoints,
    Span<const JointMatrix> skeletonBindPoseMatrices,
    Span<const JointMatrix> inverseBindMatrices,
    Core::Alloc::ScratchArena& scratchArena
);

i32 Run(i32 argc, char** argv, Core::Alloc::ScratchArena& scratchArena, b8& prompted);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_FBX_TO_NWB_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


SourceMeshStreamCounts CountSourceMeshStreams(in SourceMeshStreams mesh){
    return MakeSourceMeshStreamCounts(
        mesh.positions.size(),
        mesh.normals.size(),
        mesh.tangents.size(),
        mesh.uv0.size(),
        mesh.colors.size(),
        mesh.skin.size(),
        mesh.vertexRefs.size(),
        mesh.indices.size()
    );
}

void ReserveSourceMeshStreamsCapacity(in usize estimatedTriangleCorners, in b8 wantsSkinning, mut SourceMeshStreams outMesh){
    outMesh.positions.reserve(estimatedTriangleCorners);
    outMesh.normals.reserve(estimatedTriangleCorners);
    outMesh.uv0.reserve(estimatedTriangleCorners);
    outMesh.colors.reserve(estimatedTriangleCorners);
    outMesh.tangents.reserve(estimatedTriangleCorners);
    outMesh.indices.reserve(estimatedTriangleCorners);
    outMesh.vertexRefs.reserve(estimatedTriangleCorners);
    if(wantsSkinning)
        outMesh.skin.reserve(estimatedTriangleCorners);
}


