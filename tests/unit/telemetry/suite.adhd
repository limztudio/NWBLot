template<typename PodT>
FOUNDATION_INLINE void ReadTelemetryPod(const TelemetryBytes& payload, const usize byteOffset, PodT& outValue)noexcept{
    FOUNDATION_MEMCPY(&outValue, sizeof(outValue), payload.data() + byteOffset, sizeof(outValue));
}

template<typename PodT>
FOUNDATION_INLINE void WriteTelemetryPod(TelemetryBytes& payload, const usize byteOffset, const PodT& value)noexcept{
    FOUNDATION_MEMCPY(payload.data() + byteOffset, payload.size() - byteOffset, &value, sizeof(value));
}

[[nodiscard]] FOUNDATION_INLINE b8 RecordBinarySpan(
    TelemetryRecorder& recorder,
    const EventKindEnum kind,
    const u64 frameIndex,
    const Span<const u8> payload,
    const usize byteCount,
    const u32 streamId
){
    return recorder.recordBinary(kind, frameIndex, payload.data(), byteCount, streamId);
}

[[nodiscard]] FOUNDATION_INLINE b8 RecordMovedPayloadImpl(
    TelemetryRecorder& recorder,
    const EventKindEnum kind,
    const u64 frameIndex,
    TelemetryBytes& payload,
    const u32 streamId
){
    return recorder.recordPayload(kind, frameIndex, Move(payload), streamId);
}

[[nodiscard]] FOUNDATION_INLINE Optional<EventHeader> EventHeaderAtOpt(const EventView& events, const usize eventIndex)noexcept{
    if(const EventRecord* const event = events.eventAt(eventIndex))
        return event->header;
    return {};
}

[[nodiscard]] FOUNDATION_INLINE usize EventRecordAddressAtValue(const EventView& events, const usize eventIndex)noexcept{
    if(const EventRecord* const event = events.eventAt(eventIndex))
        return reinterpret_cast<usize>(event);
    return 0u;
}

[[nodiscard]] FOUNDATION_INLINE Optional<usize> EventPayloadCapacityAtOpt(const EventView& events, const usize eventIndex)noexcept{
    if(const EventRecord* const event = events.eventAt(eventIndex))
        return event->payload.capacity();
    return {};
}

[[nodiscard]] FOUNDATION_INLINE Optional<Span<const u8>> EventPayloadSpanAtOpt(const EventView& events, const usize eventIndex)noexcept{
    if(const EventRecord* const event = events.eventAt(eventIndex))
        return Span<const u8>(event->payload.data(), event->payload.size());
    return {};
}

[[nodiscard]] FOUNDATION_INLINE Expected<PerfMemoryPayload> ParsePerfMemorySpan(const Span<const u8> payload, const usize byteCount){
