const StringView s_SoftBodyAssetOwnerName = "SoftBodyMeshSystem";
const Name s_SoftBodyFallbackName = "soft_body";
const Name s_SoftBodyUploadName = "soft_body_upload";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SoftBodyRuntimeMeshGpuBuffers{
    public Name meshKey = s_NameNone;
    public u64 uploadedEditRevision = 0u;
    public BufferHandle positionBuffer;
    public BufferHandle normalBuffer;
    public BufferHandle tangentBuffer;
    public BufferHandle uv0Buffer;
    public BufferHandle colorBuffer;
    public BufferHandle meshletDescBuffer;
    public BufferHandle meshletBoundsBuffer;
    public BufferHandle meshletPositionRefDeltaBuffer;
    public BufferHandle meshletAttributeRefDeltaBuffer;
    public BufferHandle meshletLocalVertexRefBuffer;
    public BufferHandle meshletPrimitiveIndexBuffer;
    public BufferHandle triangleIndexBuffer;
    public BufferHandle attributeBuffer;
    public BufferHandle meshletLocalBoundsBuffer;
    public BufferHandle localBoundsBuffer;
    public GpuDescriptorHandle positionUav;
    public GpuDescriptorHandle normalUav;
    public GpuDescriptorHandle tangentUav;
    public GpuDescriptorHandle attributeUav;
    public GpuDescriptorHandle meshletBoundsUav;
    public GpuDescriptorHandle meshletLocalBoundsUav;
    public GpuDescriptorHandle localBoundsUav;

    public void reset(){
        this.meshKey = s_NameNone;
        this.uploadedEditRevision = 0u;
        this.positionBuffer.reset();
        this.normalBuffer.reset();
        this.tangentBuffer.reset();
        this.uv0Buffer.reset();
        this.colorBuffer.reset();
        this.meshletDescBuffer.reset();
        this.meshletBoundsBuffer.reset();
        this.meshletPositionRefDeltaBuffer.reset();
        this.meshletAttributeRefDeltaBuffer.reset();
        this.meshletLocalVertexRefBuffer.reset();
        this.meshletPrimitiveIndexBuffer.reset();
        this.triangleIndexBuffer.reset();
        this.attributeBuffer.reset();
        this.meshletLocalBoundsBuffer.reset();
        this.localBoundsBuffer.reset();
        this.positionUav = GpuDescriptorHandleInvalid();
        this.normalUav = GpuDescriptorHandleInvalid();
        this.tangentUav = GpuDescriptorHandleInvalid();
        this.attributeUav = GpuDescriptorHandleInvalid();
        this.meshletBoundsUav = GpuDescriptorHandleInvalid();
        this.meshletLocalBoundsUav = GpuDescriptorHandleInvalid();
        this.localBoundsUav = GpuDescriptorHandleInvalid();
    }

    public b8 hasValidUavs()const{
        return this.positionUav.valid()
            && this.normalUav.valid()
            && this.tangentUav.valid()
            && this.attributeUav.valid()
            && this.meshletBoundsUav.valid()
            && this.meshletLocalBoundsUav.valid()
            && this.localBoundsUav.valid();
    }

    public void releaseUavs(mut GraphicsRuntime graphics){
        mut GpuDescriptorHeap heap = graphics.getDevice().getDescriptorHeap();
        if(heap.isInitialized()){
            if(this.positionUav.valid())
                heap.free(this.positionUav);
            if(this.normalUav.valid())
                heap.free(this.normalUav);
            if(this.tangentUav.valid())
                heap.free(this.tangentUav);
            if(this.attributeUav.valid())
                heap.free(this.attributeUav);
            if(this.meshletBoundsUav.valid())
                heap.free(this.meshletBoundsUav);
            if(this.meshletLocalBoundsUav.valid())
                heap.free(this.meshletLocalBoundsUav);
            if(this.localBoundsUav.valid())
                heap.free(this.localBoundsUav);
        }
        this.positionUav = GpuDescriptorHandleInvalid();
        this.normalUav = GpuDescriptorHandleInvalid();
        this.tangentUav = GpuDescriptorHandleInvalid();
        this.attributeUav = GpuDescriptorHandleInvalid();
        this.meshletBoundsUav = GpuDescriptorHandleInvalid();
        this.meshletLocalBoundsUav = GpuDescriptorHandleInvalid();
        this.localBoundsUav = GpuDescriptorHandleInvalid();
    }

    public b8 valid()const{
        return this.meshKey != s_NameNone
            && this.positionBuffer.valid()
            && this.normalBuffer.valid()
            && this.tangentBuffer.valid()
            && this.uv0Buffer.valid()
            && this.colorBuffer.valid()
            && this.meshletDescBuffer.valid()
            && this.meshletBoundsBuffer.valid()
            && this.meshletPositionRefDeltaBuffer.valid()
            && this.meshletAttributeRefDeltaBuffer.valid()
            && this.meshletLocalVertexRefBuffer.valid()
            && this.meshletPrimitiveIndexBuffer.valid()
            && this.triangleIndexBuffer.valid()
            && this.attributeBuffer.valid()
            && this.meshletLocalBoundsBuffer.valid()
            && this.localBoundsBuffer.valid();
    }
}

class SoftBodyGpuDeformOverride{
    public BufferHandle positionBuffer;
    public BufferHandle normalBuffer;
    public BufferHandle tangentBuffer;
    public BufferHandle meshletBoundsBuffer;
    public BufferHandle meshletLocalBoundsBuffer;
    public BufferHandle localBoundsBuffer;
    public BufferHandle attributeBuffer;
    public RuntimeMeshLocalBounds localBounds;
    public QueueSubmissionToken computeCompletionToken;
    public u64 contentRevision = 0u;
    public b8 active = false;
}

class SoftBodyRuntimeMeshEntry{
    public EntityID entity = s_InvalidEntityId;
    public SoftBodyRuntimeMeshCpuState cpu;
    public SoftBodyRuntimeMeshGpuBuffers gpu;
    public u64 lastDeformSignature = 0u;
    public b8 pendingTopologyUpload = false;
    public b8 pendingDeformUpload = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u64 ComputeSoftBodyDeformSignature(in SoftBody sb, in TransformComponent xf){
    usize h = HashValue(sb.particles.size());
    h = HashCombineValue(h, sb.topologyVersion);
    h = HashCombineValue(h, sb.deformVersion);
    u32 bakedFlag = 0u;
    if(sb.isWorldSpaceBaked())
        bakedFlag = 1u;
    h = HashCombineValue(h, bakedFlag);
    if(sb.isWorldSpaceBaked()){
        h = HashCombineValue(h, BitCast<u32>(xf.position.x));
        h = HashCombineValue(h, BitCast<u32>(xf.position.y));
        h = HashCombineValue(h, BitCast<u32>(xf.position.z));
        h = HashCombineValue(h, BitCast<u32>(xf.rotation.x));
        h = HashCombineValue(h, BitCast<u32>(xf.rotation.y));
        h = HashCombineValue(h, BitCast<u32>(xf.rotation.z));
        h = HashCombineValue(h, BitCast<u32>(xf.rotation.w));
        h = HashCombineValue(h, BitCast<u32>(xf.scale.x));
        h = HashCombineValue(h, BitCast<u32>(xf.scale.y));
        h = HashCombineValue(h, BitCast<u32>(xf.scale.z));
    }
    return cast<u64>(h);
}

TransformComponent ResolveSoftBodyEntityWorldTransform(
    in World world,
    in EntityID entity,
    mut Vector<LocalTransformComponent> localChainScratch,
    mut Vector<u8> inheritScaleScratch
){
    TransformComponent outXf;
    localChainScratch.clear();
    inheritScaleScratch.clear();

    if(!entity.valid() || !world.alive(entity))
        return outXf;

    Array<EntityID, 32u> visited;
    u32 visitedCount = 0u;
    EntityID cur = entity;
    b8 hasHierarchy = false;
    TransformComponent rootXf;
    for(u32 depth = 0u; depth < 32u; ++depth){
        if(!world.hasComponent<LocalTransformComponent>(cur)){
            if(world.hasComponent<TransformComponent>(cur))
                rootXf = world.getComponent<TransformComponent>(cur);
            break;
        }
        EntityID parentEnt = s_InvalidEntityId;
        b8 inheritScale = true;
        if(world.hasComponent<PhysicsParentComponent>(cur)){
            in PhysicsParentComponent pp = world.getComponent<PhysicsParentComponent>(cur);
            parentEnt = pp.parent;
            inheritScale = pp.inheritScale;
        }
        else if(world.hasComponent<SceneParentComponent>(cur)){
            in SceneParentComponent sp = world.getComponent<SceneParentComponent>(cur);
            parentEnt = sp.parent;
            inheritScale = sp.inheritScale;
        }
        else{
            if(world.hasComponent<TransformComponent>(cur))
                rootXf = world.getComponent<TransformComponent>(cur);
            break;
        }
        b8 cyclic = !parentEnt.valid() || parentEnt == cur || !world.alive(parentEnt);
        if(!cyclic){
            for(u32 vi = 0u; vi < visitedCount; ++vi){
                if(visited[vi] == parentEnt){
                    cyclic = true;
                    break;
                }
            }
        }
        if(cyclic){
            if(world.hasComponent<TransformComponent>(cur))
                rootXf = world.getComponent<TransformComponent>(cur);
            break;
        }
        visited[visitedCount] = cur;
        ++visitedCount;
        in LocalTransformComponent lxf = world.getComponent<LocalTransformComponent>(cur);
        localChainScratch.push_back(lxf);
        u8 inh = 0u;
        if(inheritScale)
            inh = 1u;
        inheritScaleScratch.push_back(inh);
        hasHierarchy = true;
        cur = parentEnt;
    }

    if(!hasHierarchy){
        if(world.hasComponent<TransformComponent>(entity))
            return world.getComponent<TransformComponent>(entity);
        return outXf;
    }

    rootXf.rotation = f32x4(SafeNormalizeSceneQuaternion(VectorSingle(rootXf.rotation)));
    for(usize idx = localChainScratch.size(); idx > 0u; --idx){
        TransformComponent composed;
        ComposeSceneWorldTransformNormalizedParent(rootXf, localChainScratch[idx - 1u], inheritScaleScratch[idx - 1u] != 0u, composed);
        rootXf = composed;
    }
    return rootXf;
}

Expected<BufferHandle, BufferSetupFailure> CreateSoftBodyRuntimeBuffer(
    mut GraphicsRuntime graphics,
    in Name baseName,
    in u64 entityId,
    in u32 editRevision,
    in StringView suffix,
    in u64 byteSize,
    in u32 structStride,
    in b8 canHaveUavs,
    in b8 canHaveRawViews,
    in b8 isIndexBuffer,
    in b8 accelStructBuildInput
){
    return CreateRuntimeMeshBuffer(
        graphics,
        DeriveRuntimeResourceName(baseName, entityId, editRevision, suffix),
        byteSize,
        structStride,
        BufferFlags(canHaveUavs, canHaveRawViews, accelStructBuildInput, ResourceQueueSharing::GraphicsAndAsyncCompute, isIndexBuffer)
    );
}

b8 AllocateSoftBodyStorageUav(
    mut GpuDescriptorHeap heap,
    in DescriptorWriteItem item,
    mut GpuDescriptorHandle outHandle
){
    const Expected<GpuDescriptorHandle> handle = heap.allocate(GpuDescriptorClass::StorageBuffer);
    if(!handle.has_value())
        return false;
    GpuDescriptorRetirementGuard retireHandle(heap, handle.value());
    if(!heap.write(handle.value(), item))
        return false;
    retireHandle.release();
    outHandle = handle.value();
    return true;
}

b8 CreateSoftBodyEntryGpuBuffers(
    mut GraphicsRuntime graphics,
    in EntityID entity,
    in Name baseName,
    in SoftBodyRuntimeMeshCpuState cpu,
    mut SoftBodyRuntimeMeshGpuBuffers outGpu
){
    outGpu.reset();
    if(!cpu.topologyValid || cpu.meshlets.empty() || cpu.positions.empty())
        return false;

    const u32 rev = cast<u32>(cpu.editRevision);
    const Name meshKey = DeriveRuntimeResourceName(baseName, entity.id, rev, "soft_body_mesh");
    if(meshKey == s_NameNone)
        return false;

    const Expected<usize> posDeltaBytes = TryComputePaddedRawByteCount(cpu.meshletPositionRefDeltas.size());
    const Expected<usize> attrDeltaBytes = TryComputePaddedRawByteCount(cpu.meshletAttributeRefDeltas.size());
    const Expected<usize> primBytes = TryComputePaddedRawByteCount(cpu.meshletPrimitiveIndices.size());
    if(!posDeltaBytes.has_value() || !attrDeltaBytes.has_value() || !primBytes.has_value())
        return false;

    const b8 rtSupported = graphics.queryFeatureSupport(Feature::RayTracingAccelStruct);

    const Expected<BufferHandle, BufferSetupFailure> localBoundsRes = CreateSoftBodyRuntimeBuffer(graphics, baseName, entity.id, rev, s_LocalBoundsSuffix, cast<u64>(s_RuntimeMeshBoundsByteSize), 0u, true, true, false, false);
    const Expected<BufferHandle, BufferSetupFailure> meshletLocalBoundsRes = CreateSoftBodyRuntimeBuffer(graphics, baseName, entity.id, rev, s_MeshletLocalBoundsSuffix, cast<u64>(cpu.meshletLocalBounds.size()) * cast<u64>(s_RuntimeMeshBoundsByteSize), 0u, true, true, false, false);
    const Expected<BufferHandle, BufferSetupFailure> posRes = CreateSoftBodyRuntimeBuffer(graphics, baseName, entity.id, rev, s_SkinnedPositionsSuffix, cast<u64>(cpu.positions.size()) * cast<u64>(size_of<f32x3u>()), cast<u32>(size_of<f32x3u>()), true, true, false, rtSupported);
    const Expected<BufferHandle, BufferSetupFailure> normRes = CreateSoftBodyRuntimeBuffer(graphics, baseName, entity.id, rev, s_SkinnedNormalsSuffix, cast<u64>(cpu.normals.size()) * cast<u64>(size_of<f16x4u>()), cast<u32>(size_of<f16x4u>()), true, false, false, false);
    const Expected<BufferHandle, BufferSetupFailure> tanRes = CreateSoftBodyRuntimeBuffer(graphics, baseName, entity.id, rev, s_SkinnedTangentsSuffix, cast<u64>(cpu.tangents.size()) * cast<u64>(size_of<f16x4u>()), cast<u32>(size_of<f16x4u>()), true, false, false, false);
    const Expected<BufferHandle, BufferSetupFailure> uvRes = CreateSoftBodyRuntimeBuffer(graphics, baseName, entity.id, rev, s_Uv0Suffix, cast<u64>(cpu.uv0.size()) * cast<u64>(size_of<f32x2u>()), cast<u32>(size_of<f32x2u>()), false, false, false, false);
    const Expected<BufferHandle, BufferSetupFailure> colRes = CreateSoftBodyRuntimeBuffer(graphics, baseName, entity.id, rev, s_ColorsSuffix, cast<u64>(cpu.colors.size()) * cast<u64>(size_of<f16x4u>()), cast<u32>(size_of<f16x4u>()), false, false, false, false);
    const Expected<BufferHandle, BufferSetupFailure> meshletRes = CreateSoftBodyRuntimeBuffer(graphics, baseName, entity.id, rev, s_MeshletsSuffix, cast<u64>(cpu.meshlets.size()) * cast<u64>(size_of<MeshletDesc>()), cast<u32>(size_of<MeshletDesc>()), false, false, false, false);
    const Expected<BufferHandle, BufferSetupFailure> boundsRes = CreateSoftBodyRuntimeBuffer(graphics, baseName, entity.id, rev, s_MeshletBoundsSuffix, cast<u64>(cpu.meshletBounds.size()) * cast<u64>(size_of<MeshletBounds>()), cast<u32>(size_of<MeshletBounds>()), true, true, false, false);
    const Expected<BufferHandle, BufferSetupFailure> posDeltaRes = CreateSoftBodyRuntimeBuffer(graphics, baseName, entity.id, rev, s_MeshletPositionRefDeltasSuffix, cast<u64>(posDeltaBytes.value()), cast<u32>(size_of<u8>()), false, true, false, false);
    const Expected<BufferHandle, BufferSetupFailure> attrDeltaRes = CreateSoftBodyRuntimeBuffer(graphics, baseName, entity.id, rev, s_MeshletAttributeRefDeltasSuffix, cast<u64>(attrDeltaBytes.value()), cast<u32>(size_of<u8>()), false, true, false, false);
    const Expected<BufferHandle, BufferSetupFailure> localVertRes = CreateSoftBodyRuntimeBuffer(graphics, baseName, entity.id, rev, s_MeshletLocalVertexRefsSuffix, cast<u64>(cpu.meshletLocalVertexRefs.size()) * cast<u64>(size_of<MeshletLocalVertexRef>()), cast<u32>(size_of<MeshletLocalVertexRef>()), false, false, false, false);
    const Expected<BufferHandle, BufferSetupFailure> primRes = CreateSoftBodyRuntimeBuffer(graphics, baseName, entity.id, rev, s_MeshletPrimitiveIndicesSuffix, cast<u64>(primBytes.value()), cast<u32>(size_of<u8>()), false, true, false, false);
    const Expected<BufferHandle, BufferSetupFailure> triIdxRes = CreateSoftBodyRuntimeBuffer(graphics, baseName, entity.id, rev, s_RtTriangleIndicesBufferName, cast<u64>(cpu.triangleIndices.size()) * cast<u64>(size_of<u32>()), cast<u32>(size_of<u32>()), false, true, true, rtSupported);
    const Expected<BufferHandle, BufferSetupFailure> triAttrRes = CreateSoftBodyRuntimeBuffer(graphics, baseName, entity.id, rev, s_RtTriangleAttributesBufferName, cast<u64>(cpu.triangleAttributes.size()) * cast<u64>(size_of<AttribGpu>()), cast<u32>(size_of<AttribGpu>()), true, true, false, false);

    if(
        !localBoundsRes.has_value()
        || !meshletLocalBoundsRes.has_value()
        || !posRes.has_value()
        || !normRes.has_value()
        || !tanRes.has_value()
        || !uvRes.has_value()
        || !colRes.has_value()
        || !meshletRes.has_value()
        || !boundsRes.has_value()
        || !posDeltaRes.has_value()
        || !attrDeltaRes.has_value()
        || !localVertRes.has_value()
        || !primRes.has_value()
        || !triIdxRes.has_value()
        || !triAttrRes.has_value()
    )
        return false;

    outGpu.meshKey = meshKey;
    outGpu.uploadedEditRevision = cpu.editRevision;
    outGpu.localBoundsBuffer = localBoundsRes.value();
    outGpu.meshletLocalBoundsBuffer = meshletLocalBoundsRes.value();
    outGpu.positionBuffer = posRes.value();
    outGpu.normalBuffer = normRes.value();
    outGpu.tangentBuffer = tanRes.value();
    outGpu.uv0Buffer = uvRes.value();
    outGpu.colorBuffer = colRes.value();
    outGpu.meshletDescBuffer = meshletRes.value();
    outGpu.meshletBoundsBuffer = boundsRes.value();
    outGpu.meshletPositionRefDeltaBuffer = posDeltaRes.value();
    outGpu.meshletAttributeRefDeltaBuffer = attrDeltaRes.value();
    outGpu.meshletLocalVertexRefBuffer = localVertRes.value();
    outGpu.meshletPrimitiveIndexBuffer = primRes.value();
    outGpu.triangleIndexBuffer = triIdxRes.value();
    outGpu.attributeBuffer = triAttrRes.value();

    mut GpuDescriptorHeap heap = graphics.getDevice().getDescriptorHeap();
    if(!heap.isInitialized()){
        outGpu.reset();
        return false;
    }
    const b8 uavOk =
        AllocateSoftBodyStorageUav(heap, DescriptorWriteItemStructuredBufferUav(0u, outGpu.positionBuffer.deref()), outGpu.positionUav)
        && AllocateSoftBodyStorageUav(heap, DescriptorWriteItemStructuredBufferUav(0u, outGpu.normalBuffer.deref()), outGpu.normalUav)
        && AllocateSoftBodyStorageUav(heap, DescriptorWriteItemStructuredBufferUav(0u, outGpu.tangentBuffer.deref()), outGpu.tangentUav)
        && AllocateSoftBodyStorageUav(heap, DescriptorWriteItemRawBufferUav(0u, outGpu.attributeBuffer.deref()), outGpu.attributeUav)
        && AllocateSoftBodyStorageUav(heap, DescriptorWriteItemRawBufferUav(0u, outGpu.meshletBoundsBuffer.deref()), outGpu.meshletBoundsUav)
        && AllocateSoftBodyStorageUav(heap, DescriptorWriteItemRawBufferUav(0u, outGpu.meshletLocalBoundsBuffer.deref()), outGpu.meshletLocalBoundsUav)
        && AllocateSoftBodyStorageUav(heap, DescriptorWriteItemRawBufferUav(0u, outGpu.localBoundsBuffer.deref()), outGpu.localBoundsUav);
    if(!uavOk){
        outGpu.releaseUavs(graphics);
        outGpu.reset();
        return false;
    }
    return true;
}

b8 DeclareSoftBodyDynamicUploads(
    mut GpuTaskGraph graph,
    in SoftBodyRuntimeMeshEntry entry,
    mut Vector<GpuTaskId> outTasks
){
    b8 ok = DeclareRuntimeMeshBatchBufferUploadBlob(graph, entry.gpu.localBoundsBuffer, s_LocalBoundsSuffix, graph.copyUploadValue<RuntimeMeshLocalBounds>(entry.cpu.localBounds), outTasks);
    ok = ok && DeclareRuntimeMeshBatchTypedUpload<RuntimeMeshLocalBounds>(graph, entry.gpu.meshletLocalBoundsBuffer, s_MeshletLocalBoundsSuffix, Span<RuntimeMeshLocalBounds>(entry.cpu.meshletLocalBounds), outTasks);
    ok = ok && DeclareRuntimeMeshBatchTypedUpload<f32x3u>(graph, entry.gpu.positionBuffer, s_RuntimeCacheSkinnedPositionLabel, Span<f32x3u>(entry.cpu.positions), outTasks);
    ok = ok && DeclareRuntimeMeshBatchTypedUpload<f16x4u>(graph, entry.gpu.normalBuffer, s_RuntimeCacheSkinnedNormalLabel, Span<f16x4u>(entry.cpu.normals), outTasks);
    ok = ok && DeclareRuntimeMeshBatchTypedUpload<f16x4u>(graph, entry.gpu.tangentBuffer, s_RuntimeCacheSkinnedTangentLabel, Span<f16x4u>(entry.cpu.tangents), outTasks);
    ok = ok && DeclareRuntimeMeshBatchTypedUpload<MeshletBounds>(graph, entry.gpu.meshletBoundsBuffer, s_RuntimeCacheMeshletBoundsLabel, Span<MeshletBounds>(entry.cpu.meshletBounds), outTasks);
    ok = ok && DeclareRuntimeMeshBatchTypedUpload<AttribGpu>(graph, entry.gpu.attributeBuffer, s_RuntimeCacheRtTriangleAttributeLabel, Span<AttribGpu>(entry.cpu.triangleAttributes), outTasks);
    return ok;
}

b8 DeclareSoftBodyTopologyUploads(
    mut GpuTaskGraph graph,
    in SoftBodyRuntimeMeshEntry entry,
    mut Vector<GpuTaskId> outTasks
){
    b8 ok = DeclareRuntimeMeshBatchTypedUpload<f32x2u>(graph, entry.gpu.uv0Buffer, s_RuntimeCacheUv0Label, Span<f32x2u>(entry.cpu.uv0), outTasks);
    ok = ok && DeclareRuntimeMeshBatchTypedUpload<f16x4u>(graph, entry.gpu.colorBuffer, s_RuntimeCacheColorLabel, Span<f16x4u>(entry.cpu.colors), outTasks);
    ok = ok && DeclareRuntimeMeshBatchTypedUpload<MeshletDesc>(graph, entry.gpu.meshletDescBuffer, s_RuntimeCacheMeshletDescriptorLabel, Span<MeshletDesc>(entry.cpu.meshlets), outTasks);
    ok = ok && DeclareRuntimeMeshBatchPaddedRawUpload(graph, entry.gpu.meshletPositionRefDeltaBuffer, s_RuntimeCacheMeshletPositionRefDeltaLabel, Span<u8>(entry.cpu.meshletPositionRefDeltas), outTasks);
    ok = ok && DeclareRuntimeMeshBatchPaddedRawUpload(graph, entry.gpu.meshletAttributeRefDeltaBuffer, s_RuntimeCacheMeshletAttributeRefDeltaLabel, Span<u8>(entry.cpu.meshletAttributeRefDeltas), outTasks);
    ok = ok && DeclareRuntimeMeshBatchTypedUpload<MeshletLocalVertexRef>(graph, entry.gpu.meshletLocalVertexRefBuffer, s_RuntimeCacheMeshletLocalVertexRefLabel, Span<MeshletLocalVertexRef>(entry.cpu.meshletLocalVertexRefs), outTasks);
    ok = ok && DeclareRuntimeMeshBatchPaddedRawUpload(graph, entry.gpu.meshletPrimitiveIndexBuffer, s_RuntimeCacheMeshletPrimitiveIndexLabel, Span<u8>(entry.cpu.meshletPrimitiveIndices), outTasks);
    ok = ok && DeclareRuntimeMeshBatchTypedUpload<u32>(graph, entry.gpu.triangleIndexBuffer, s_RuntimeCacheRtTriangleIndexLabel, Span<u32>(entry.cpu.triangleIndices), outTasks);
    ok = ok && DeclareSoftBodyDynamicUploads(graph, entry, outTasks);
    return ok;
}

RuntimeMeshDesc BuildSoftBodyRuntimeMeshDesc(
    in SoftBodyRuntimeMeshEntry entry,
    in b8 hasGpuOverride,
    in SoftBodyGpuDeformOverride gpuOverride
){
    RuntimeMeshDesc desc;
    desc.meshKey = entry.gpu.meshKey;
    desc.version = entry.cpu.editRevision;
    desc.entity = entry.entity;
    desc.geometryContentRevision = entry.cpu.contentRevision;
    desc.localBoundsBuffer = entry.gpu.localBoundsBuffer;
    desc.meshletLocalBoundsBuffer = entry.gpu.meshletLocalBoundsBuffer;
    desc.buffers.positionBuffer = entry.gpu.positionBuffer;
    desc.buffers.normalBuffer = entry.gpu.normalBuffer;
    desc.buffers.tangentBuffer = entry.gpu.tangentBuffer;
    desc.buffers.uv0Buffer = entry.gpu.uv0Buffer;
    desc.buffers.colorBuffer = entry.gpu.colorBuffer;
    desc.buffers.meshletDescBuffer = entry.gpu.meshletDescBuffer;
    desc.buffers.meshletBoundsBuffer = entry.gpu.meshletBoundsBuffer;
    desc.buffers.meshletPositionRefDeltaBuffer = entry.gpu.meshletPositionRefDeltaBuffer;
    desc.buffers.meshletAttributeRefDeltaBuffer = entry.gpu.meshletAttributeRefDeltaBuffer;
    desc.buffers.meshletLocalVertexRefBuffer = entry.gpu.meshletLocalVertexRefBuffer;
    desc.buffers.meshletPrimitiveIndexBuffer = entry.gpu.meshletPrimitiveIndexBuffer;
    desc.triangleIndexBuffer = entry.gpu.triangleIndexBuffer;
    desc.attributeBuffer = entry.gpu.attributeBuffer;
    desc.solidTriangleWords = Span<u32>(entry.cpu.solidTriangleWords);
    desc.localBounds = entry.cpu.localBounds;
    desc.meshletCount = cast<u32>(entry.cpu.meshlets.size());
    desc.meshletPrimitiveIndexCount = cast<u32>(entry.cpu.meshletPrimitiveIndices.size());
    desc.dynamicMeshletBoundsFresh = true;
    desc.dynamicMeshletConesFresh = true;

    if(hasGpuOverride && gpuOverride.active){
        if(gpuOverride.positionBuffer.valid())
            desc.buffers.positionBuffer = gpuOverride.positionBuffer;
        if(gpuOverride.normalBuffer.valid())
            desc.buffers.normalBuffer = gpuOverride.normalBuffer;
        if(gpuOverride.tangentBuffer.valid())
            desc.buffers.tangentBuffer = gpuOverride.tangentBuffer;
        if(gpuOverride.meshletBoundsBuffer.valid())
            desc.buffers.meshletBoundsBuffer = gpuOverride.meshletBoundsBuffer;
        if(gpuOverride.meshletLocalBoundsBuffer.valid())
            desc.meshletLocalBoundsBuffer = gpuOverride.meshletLocalBoundsBuffer;
        if(gpuOverride.localBoundsBuffer.valid())
            desc.localBoundsBuffer = gpuOverride.localBoundsBuffer;
        if(gpuOverride.attributeBuffer.valid())
            desc.attributeBuffer = gpuOverride.attributeBuffer;
        if(gpuOverride.localBounds.valid())
            desc.localBounds = gpuOverride.localBounds;
        if(gpuOverride.contentRevision > desc.geometryContentRevision)
            desc.geometryContentRevision = gpuOverride.contentRevision;
    }

    return desc;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[system("soft_body_mesh")]
class SoftBodyMeshSystem : IRenderPass, IRuntimeMeshProvider{
    private mut World m_world;
    private mut GraphicsRuntime m_graphics;
    private mut AssetManager m_assetManager;
    private mut IRuntimeMeshRegistry m_runtimeMeshRegistry;
    private HashMap<EntityID, SoftBodyRuntimeMeshEntry> m_entries;
    private HashMap<EntityID, SoftBodyGpuDeformOverride> m_gpuOverrides;
    private HashMap<Name, SoftBodyCachedSourceMesh> m_sourceMeshCache;
    private Array<Vector<SoftBodyRuntimeMeshGpuBuffers>, 3u> m_retiredGpuBuffers;
    private u32 m_retiredRingSlot = 0u;
    private b8 m_syncedInUpdate = false;
    private Vector<LocalTransformComponent> m_localChainScratch;
    private Vector<u8> m_inheritScaleScratch;
    private Vector<EntityID> m_staleEntities;
    private Vector<GpuTaskId> m_uploadTasksScratch;
    private u64 m_uploadBatchSequence = 0u;

    public SoftBodyMeshSystem(
        mut World world,
        mut GraphicsRuntime graphics,
        mut AssetManager assetManager,
        mut IRuntimeMeshRegistry runtimeMeshRegistry
    ){
        this.m_world = world;
        this.m_graphics = graphics;
        this.m_assetManager = assetManager;
        this.m_runtimeMeshRegistry = runtimeMeshRegistry;
        this.readAccess<SoftBodyComponent>();
        this.readAccess<MeshComponent>();
        this.readAccess<TransformComponent>();
        this.readAccess<LocalTransformComponent>();
        this.readAccess<PhysicsParentComponent>();
        this.readAccess<SceneParentComponent>();
        this.readAccess<SceneEntityNameComponent>();
        runtimeMeshRegistry.registerRuntimeMeshProvider(this);
    }

    public ~SoftBodyMeshSystem(){
        this.invalidateResources();
        this.m_runtimeMeshRegistry.unregisterRuntimeMeshProvider(this);
    }

    public void clearGpuDeformOverride(in EntityID entity){
        if(!entity.valid())
            return;
        this.m_gpuOverrides.erase(entity);
    }

    public b8 tryBuildGpuDeformTarget(
        in EntityID entity,
        in TransformComponent worldTransform,
        in b8 worldSpaceBaked,
        mut SoftBodyGpuDeformTarget outTarget
    ){
        if(!entity.valid())
            return false;
        const auto found = this.m_entries.find(entity);
        if(found == this.m_entries.end())
            return false;
        mut SoftBodyRuntimeMeshEntry entry = found.value();
        if(!entry.cpu.topologyValid || entry.cpu.emptySurfaceSentinel || entry.pendingTopologyUpload || !entry.gpu.valid() || !entry.gpu.hasValidUavs())
            return false;

        outTarget = SoftBodyGpuDeformTarget();
        outTarget.topologyKey = entry.cpu.gpuTopologyKey;
        outTarget.renderVertexCount = cast<u32>(entry.cpu.positions.size());
        outTarget.cornerCount = cast<u32>(entry.cpu.triangleIndices.size());
        outTarget.meshletCount = cast<u32>(entry.cpu.meshlets.size());
        outTarget.useCage = entry.cpu.gpuUseCage;
        outTarget.hasUv0 = (entry.cpu.gpuUv0Padded.size() == entry.cpu.positions.size());
        f32 bakedFlag = 0.0f;
        if(worldSpaceBaked)
            bakedFlag = 1.0f;
        outTarget.worldPosFlag = f32x4(worldTransform.position.x, worldTransform.position.y, worldTransform.position.z, bakedFlag);
        outTarget.worldRot = f32x4(SafeNormalizeQuat(VectorSingle(worldTransform.rotation)));
        outTarget.invScale = f32x4(ComputeSoftBodyInverseScale(worldTransform), 0.0f);
        outTarget.vertToParticle = Span<u32>(entry.cpu.gpuVertToParticle);
        outTarget.cageParticleIndices = Span<u32x4>(entry.cpu.gpuCageParticleIndices);
        outTarget.cageBaryWeights = Span<f32x4>(entry.cpu.gpuCageBaryWeights);
        outTarget.renderTriIndices = Span<u32>(entry.cpu.triangleIndices);
        outTarget.vertTriRange = Span<u32>(entry.cpu.gpuVertTriRange);
        outTarget.vertTriList = Span<u32>(entry.cpu.gpuVertTriList);
        outTarget.uv0Padded = Span<f32x4>(entry.cpu.gpuUv0Padded);
        outTarget.meshletMeta = Span<u32x4>(entry.cpu.gpuMeshletMeta);
        outTarget.meshletVertList = Span<u32>(entry.cpu.gpuMeshletVertList);
        outTarget.meshletTriList = Span<u32>(entry.cpu.gpuMeshletTriList);
        outTarget.positionBuffer = entry.gpu.positionBuffer;
        outTarget.normalBuffer = entry.gpu.normalBuffer;
        outTarget.tangentBuffer = entry.gpu.tangentBuffer;
        outTarget.attributeBuffer = entry.gpu.attributeBuffer;
        outTarget.meshletBoundsBuffer = entry.gpu.meshletBoundsBuffer;
        outTarget.meshletLocalBoundsBuffer = entry.gpu.meshletLocalBoundsBuffer;
        outTarget.localBoundsBuffer = entry.gpu.localBoundsBuffer;
        outTarget.positionUavSlot = entry.gpu.positionUav.slot();
        outTarget.normalUavSlot = entry.gpu.normalUav.slot();
        outTarget.tangentUavSlot = entry.gpu.tangentUav.slot();
        outTarget.attributeUavSlot = entry.gpu.attributeUav.slot();
        outTarget.meshletBoundsUavSlot = entry.gpu.meshletBoundsUav.slot();
        outTarget.meshletLocalBoundsUavSlot = entry.gpu.meshletLocalBoundsUav.slot();
        outTarget.localBoundsUavSlot = entry.gpu.localBoundsUav.slot();
        return true;
    }

    public void markGpuDeformed(
        in EntityID entity,
        in SoftBody sb,
        in TransformComponent worldTransform,
        in RuntimeMeshLocalBounds localBounds,
        in QueueSubmissionToken computeCompletionToken
    ){
        if(!entity.valid())
            return;
        const auto found = this.m_entries.find(entity);
        if(found == this.m_entries.end())
            return;
        mut SoftBodyRuntimeMeshEntry entry = found.value();
        if(!entry.gpu.valid())
            return;

        u64 maxRev = entry.cpu.contentRevision;
        const auto prevIt = this.m_gpuOverrides.find(entity);
        if(prevIt != this.m_gpuOverrides.end() && prevIt.value().contentRevision > maxRev)
            maxRev = prevIt.value().contentRevision;
        u64 nextRev = maxRev + 1u;
        if(nextRev == 0u)
            nextRev = 1u;
        entry.cpu.contentRevision = nextRev;
        SoftBodyGpuDeformOverride ov;
        ov.positionBuffer = entry.gpu.positionBuffer;
        ov.normalBuffer = entry.gpu.normalBuffer;
        ov.tangentBuffer = entry.gpu.tangentBuffer;
        ov.meshletBoundsBuffer = entry.gpu.meshletBoundsBuffer;
        ov.meshletLocalBoundsBuffer = entry.gpu.meshletLocalBoundsBuffer;
        ov.localBoundsBuffer = entry.gpu.localBoundsBuffer;
        ov.attributeBuffer = entry.gpu.attributeBuffer;
        ov.localBounds = localBounds;
        ov.computeCompletionToken = computeCompletionToken;
        ov.contentRevision = nextRev;
        ov.active = true;
        this.m_gpuOverrides.insert_or_assign(entity, ov);
        entry.cpu.localBounds = localBounds;
        entry.lastDeformSignature = ComputeSoftBodyDeformSignature(sb, worldTransform);
        entry.pendingDeformUpload = false;
    }

    private void retireGpuBuffers(mut SoftBodyRuntimeMeshGpuBuffers gpu){
        if(gpu.meshKey != s_NameNone){
            this.m_retiredGpuBuffers[this.m_retiredRingSlot].push_back(gpu);
            gpu.reset();
        }
        else{
            gpu.releaseUavs(this.m_graphics);
        }
    }

    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta)override{
        this.syncEntities();
        this.m_syncedInUpdate = true;
        return Expected<void, CpuTaskAdmissionError>();
    }

    public b8 prepareResources(in FramebufferPtr framebuffer)override{
        this.m_retiredRingSlot = (this.m_retiredRingSlot + 1u) % 3u;
        mut Vector<SoftBodyRuntimeMeshGpuBuffers> retiredSlot = this.m_retiredGpuBuffers[this.m_retiredRingSlot];
        for(usize ri = 0u; ri < retiredSlot.size(); ++ri)
            retiredSlot[ri].releaseUavs(this.m_graphics);
        retiredSlot.clear();
        if(!this.m_syncedInUpdate)
            this.syncEntities();
        this.m_syncedInUpdate = false;
        if(!this.m_gpuOverrides.empty()){
            mut Device device = this.m_graphics.getDevice();
            const GpuPhysicalQueueId graphicsQueue = device.getPrimaryPhysicalQueue(CommandQueue::Graphics);
            const u16 activeDevGen = device.getDeviceGeneration();
            QueueSubmissionToken latestCrossQueueToken;
            for(auto it = this.m_gpuOverrides.begin(); it != this.m_gpuOverrides.end(); ++it){
                mut SoftBodyGpuDeformOverride ov = it.value();
                const QueueSubmissionToken tok = ov.computeCompletionToken;
                ov.computeCompletionToken = QueueSubmissionToken();
                if(!ov.active || !tok.valid())
                    continue;
                if(tok.deviceGeneration != activeDevGen || tok.matchesPhysicalQueue(graphicsQueue.index, graphicsQueue.deviceGeneration))
                    continue;
                if(!latestCrossQueueToken.valid() || tok.value > latestCrossQueueToken.value)
                    latestCrossQueueToken = tok;
            }
            if(latestCrossQueueToken.valid()){
                if(!device.waitForSubmissionToken(latestCrossQueueToken))
                    return false;
            }
        }
        return this.uploadPendingBatches();
    }

    public void render(in FramebufferPtr framebuffer)override{
        if(!this.uploadPendingBatches())
            warning("SoftBodyMeshSystem: skipped runtime mesh upload because standalone graph submission failed");
    }

    public void invalidateResources()override{
        for(auto it = this.m_entries.begin(); it != this.m_entries.end(); ++it)
            it.value().gpu.releaseUavs(this.m_graphics);
        this.m_entries.clear();
        this.m_gpuOverrides.clear();
        this.m_sourceMeshCache.clear();
        for(usize s = 0u; s < 3u; ++s){
            for(usize ri = 0u; ri < this.m_retiredGpuBuffers[s].size(); ++ri)
                this.m_retiredGpuBuffers[s][ri].releaseUavs(this.m_graphics);
            this.m_retiredGpuBuffers[s].clear();
        }
        this.m_retiredRingSlot = 0u;
        this.m_syncedInUpdate = false;
        this.m_staleEntities.clear();
    }

    public Expected<RuntimeMeshDesc> resolveRuntimeMesh(in EntityID entity)override{
        const auto found = this.m_entries.find(entity);
        if(found == this.m_entries.end())
            return MakeUnexpected(Failure());

        if(!found.value().cpu.topologyValid || !found.value().gpu.valid())
            return MakeUnexpected(Failure());

        b8 hasOverride = false;
        SoftBodyGpuDeformOverride overrideData;
        const auto ovIt = this.m_gpuOverrides.find(entity);
        if(ovIt != this.m_gpuOverrides.end()){
            hasOverride = true;
            overrideData = ovIt.value();
        }
        const RuntimeMeshDesc desc = BuildSoftBodyRuntimeMeshDesc(found.value(), hasOverride, overrideData);
        if(!desc.valid())
            return MakeUnexpected(Failure());
        return desc;
    }

    public b8 hasRuntimeMeshBinding(in EntityID entity)const override{
        if(!this.m_world.hasComponent<SoftBodyComponent>(entity))
            return false;
        in SoftBodyComponent sbComp = this.m_world.getComponent<SoftBodyComponent>(entity);
        return sbComp.enabled && !sbComp.softBody.particles.empty();
    }

    public void markLiveRuntimeMeshes(mut RuntimeMeshRequestSet requests)override{
        for(auto it = this.m_entries.begin(); it != this.m_entries.end(); ++it){
            if(requests.complete())
                return;
            if(it.value().cpu.topologyValid && it.value().gpu.valid())
                requests.markLive(it.value().gpu.meshKey, it.value().cpu.editRevision);
        }
    }

    private Name resolveEntityBaseName(in EntityID entity, in Name sourceMeshName)const{
        if(this.m_world.hasComponent<SceneEntityNameComponent>(entity)){
            in SceneEntityNameComponent nameComp = this.m_world.getComponent<SceneEntityNameComponent>(entity);
            if(nameComp.name != s_NameNone)
                return nameComp.name;
        }
        if(sourceMeshName != s_NameNone)
            return sourceMeshName;
        return s_SoftBodyFallbackName;
    }

    private void syncSingleEntity(in EntityID entity, in SoftBodyComponent sbComp){
        if(!sbComp.enabled || sbComp.softBody.particles.empty())
            return;

        Name sourceMeshName = s_NameNone;
        if(this.m_world.hasComponent<MeshComponent>(entity)){
            in MeshComponent meshComp = this.m_world.getComponent<MeshComponent>(entity);
            if(meshComp.mesh.valid())
                sourceMeshName = meshComp.mesh.name();
        }

        mut SoftBodyRuntimeMeshEntry entry = this.m_entries[entity];
        entry.entity = entity;

        b8 hasGpuPosOverride = false;
        const auto ovCheck = this.m_gpuOverrides.find(entity);
        if(ovCheck != this.m_gpuOverrides.end())
            hasGpuPosOverride = ovCheck.value().active && ovCheck.value().positionBuffer.valid();

        const b8 worldBaked = sbComp.softBody.isWorldSpaceBaked();
        TransformComponent xf;
        if(worldBaked)
            xf = ResolveSoftBodyEntityWorldTransform(this.m_world, entity, this.m_localChainScratch, this.m_inheritScaleScratch);

        const u64 deformSignature = ComputeSoftBodyDeformSignature(sbComp.softBody, xf);
        if(entry.cpu.needsTopologyRebuild(sbComp.softBody, xf, sourceMeshName)){
            this.m_gpuOverrides.erase(entity);
            b8 rebuilt = false;
            if(sourceMeshName != s_NameNone){
                const auto cacheIt = this.m_sourceMeshCache.find(sourceMeshName);
                if(cacheIt != this.m_sourceMeshCache.end()){
                    rebuilt = entry.cpu.rebuildTopologyFromCachedSource(sbComp.softBody, xf, cacheIt.value(), sourceMeshName);
                }
                else{
                    auto loadedAsset = LoadTypedAssetSync<Mesh>(this.m_assetManager, sourceMeshName, s_SoftBodyAssetOwnerName);
                    if(loadedAsset.has_value()){
                        SoftBodyCachedSourceMesh cachedSrc;
                        ExtractSoftBodyCachedSourceMesh(loadedAsset.value().deref(), cachedSrc);
                        if(!cachedSrc.positions.empty()){
                            this.m_sourceMeshCache.insert_or_assign(sourceMeshName, cachedSrc);
                            rebuilt = entry.cpu.rebuildTopologyFromCachedSource(sbComp.softBody, xf, cachedSrc, sourceMeshName);
                        }
                        else{
                            rebuilt = entry.cpu.rebuildTopology(sbComp.softBody, xf, sourceMeshName);
                        }
                    }
                    else{
                        rebuilt = entry.cpu.rebuildTopology(sbComp.softBody, xf, sourceMeshName);
                    }
                }
            }
            else{
                rebuilt = entry.cpu.rebuildTopology(sbComp.softBody, xf, s_NameNone);
            }

            if(!rebuilt){
                this.retireGpuBuffers(entry.gpu);
                entry.cpu.reset();
                entry.gpu.reset();
                entry.pendingTopologyUpload = false;
                entry.pendingDeformUpload = false;
                return;
            }

            this.retireGpuBuffers(entry.gpu);
            const Name baseName = this.resolveEntityBaseName(entity, sourceMeshName);
            if(!CreateSoftBodyEntryGpuBuffers(this.m_graphics, entity, baseName, entry.cpu, entry.gpu)){
                entry.gpu.reset();
                entry.pendingTopologyUpload = false;
                entry.pendingDeformUpload = false;
                return;
            }

            entry.lastDeformSignature = deformSignature;
            entry.pendingTopologyUpload = true;
            entry.pendingDeformUpload = false;
            return;
        }

        if(hasGpuPosOverride){
            if(entry.gpu.valid() && deformSignature == entry.lastDeformSignature)
                return;
            this.m_gpuOverrides.erase(entity);
            hasGpuPosOverride = false;
        }

        if(!hasGpuPosOverride && (deformSignature != entry.lastDeformSignature || !entry.gpu.valid())){
            if(entry.cpu.updateDeformation(sbComp.softBody, xf)){
                entry.lastDeformSignature = deformSignature;
                if(!entry.gpu.valid() || entry.gpu.uploadedEditRevision != entry.cpu.editRevision){
                    this.retireGpuBuffers(entry.gpu);
                    const Name baseName = this.resolveEntityBaseName(entity, sourceMeshName);
                    if(CreateSoftBodyEntryGpuBuffers(this.m_graphics, entity, baseName, entry.cpu, entry.gpu)){
                        entry.pendingTopologyUpload = true;
                        entry.pendingDeformUpload = false;
                    }
                }
                else if(!entry.pendingTopologyUpload){
                    entry.pendingDeformUpload = true;
                }
            }
        }
    }

    private void syncEntities(){
        this.m_staleEntities.clear();
        for(auto it = this.m_entries.begin(); it != this.m_entries.end(); ++it){
            const EntityID entity = it.key();
            if(!this.hasRuntimeMeshBinding(entity))
                this.m_staleEntities.push_back(entity);
        }
        for(usize i = 0u; i < this.m_staleEntities.size(); ++i){
            const EntityID staleEnt = this.m_staleEntities[i];
            const auto foundStale = this.m_entries.find(staleEnt);
            if(foundStale != this.m_entries.end())
                this.retireGpuBuffers(foundStale.value().gpu);
            this.m_entries.erase(staleEnt);
            this.m_gpuOverrides.erase(staleEnt);
        }
        this.m_staleEntities.clear();

        for(in auto row : this.m_world.view<SoftBodyComponent>())
            this.syncSingleEntity(Get<0>(row), Get<1>(row));
    }

    private b8 uploadPendingBatches(){
        b8 hasPending = false;
        for(auto it = this.m_entries.begin(); it != this.m_entries.end(); ++it){
            if(!it.value().cpu.topologyValid || !it.value().gpu.valid())
                continue;
            if(it.value().pendingTopologyUpload || it.value().pendingDeformUpload){
                hasPending = true;
                break;
            }
        }
        if(!hasPending)
            return true;

        ++this.m_uploadBatchSequence;
        const Name batchReadyName = DeriveRuntimeResourceName(s_SoftBodyUploadName, this.m_uploadBatchSequence, 0u, "batch_ready");
        if(batchReadyName == s_NameNone)
            return false;

        in HashMap<EntityID, SoftBodyRuntimeMeshEntry> entriesRef = this.m_entries;
        mut Vector<GpuTaskId> uploadTasksScratch = this.m_uploadTasksScratch;
        const GpuPhysicalQueueId graphicsQueue = this.m_graphics.getDevice().getPrimaryPhysicalQueue(CommandQueue::Graphics);
        const Expected<QueueSubmissionToken> uploaded = this.m_graphics.standaloneGraph().submitStandaloneTaskGraph(
            lambda[in entriesRef, in batchReadyName, mut uploadTasksScratch](mut GpuTaskGraph graph) -> Expected<GpuTaskId>{
                uploadTasksScratch.clear();
                uploadTasksScratch.reserve(entriesRef.size() * 15u);

                for(auto it = entriesRef.begin(); it != entriesRef.end(); ++it){
                    if(!it.value().cpu.topologyValid || !it.value().gpu.valid())
                        continue;

                    if(it.value().pendingTopologyUpload){
                        if(!DeclareSoftBodyTopologyUploads(graph, it.value(), uploadTasksScratch))
                            return MakeUnexpected(Failure());
                    }
                    else if(it.value().pendingDeformUpload){
                        if(!DeclareSoftBodyDynamicUploads(graph, it.value(), uploadTasksScratch))
                            return MakeUnexpected(Failure());
                    }
                }

                if(uploadTasksScratch.empty())
                    return MakeUnexpected(Failure());

                GpuTaskDesc readyDesc = GpuTaskDesc();
                readyDesc
                    .setIdentity(batchReadyName)
                    .setMarkerLabel("SoftBody Runtime Batch Upload Ready")
                    .setDependencies(Span<GpuTaskId>(uploadTasksScratch))
                ;
                RuntimeMeshBatchUploadReadyTask readyTask;
                return graph.addPayloadTask(readyDesc, readyTask);
            },
            graphicsQueue
        );
        if(!uploaded.has_value() || !uploaded.value().valid())
            return false;

        for(auto it = this.m_entries.begin(); it != this.m_entries.end(); ++it){
            it.value().pendingTopologyUpload = false;
            it.value().pendingDeformUpload = false;
        }
        return true;
    }
}


