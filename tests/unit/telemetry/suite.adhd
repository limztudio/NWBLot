void CopyTelemetryBytes(in TelemetryBytes src, mut TelemetryBytes dst){
    dst.resize(src.size(), 0u);
    for(usize i = 0u; i < src.size(); ++i)
        dst[i] = src[i];
}

b8 RecordBinaryBytes(mut TelemetryRecorder recorder, in EventKindEnum kind, in u64 frameIndex, in TelemetryBytes payload, in usize byteCount, in u32 streamId){
    return RecordBinarySpan(recorder, kind, frameIndex, payload, byteCount, streamId);
}

b8 RecordBinaryBytes(mut TelemetryRecorder recorder, in EventKindEnum kind, in u64 frameIndex, in TelemetryBytes payload, in u32 streamId){
    return RecordBinaryBytes(recorder, kind, frameIndex, payload, payload.size(), streamId);
}

b8 RecordBinaryBytes(mut TelemetryRecorder recorder, in EventKindEnum kind, in u64 frameIndex, in TelemetryBytes payload){
    return RecordBinaryBytes(recorder, kind, frameIndex, payload, payload.size(), 0u);
}

b8 RecordFilledPayload(mut TelemetryRecorder recorder, in EventKindEnum kind, in u64 frameIndex, in usize byteCount, in u8 fillValue, in u32 streamId){
    TelemetryBytes payload = TelemetryBytes(recorder.arena());
    payload.resize(byteCount, fillValue);
    return RecordBinaryBytes(recorder, kind, frameIndex, payload, byteCount, streamId);
}

b8 RecordMovedPayload(mut TelemetryRecorder recorder, in EventKindEnum kind, in u64 frameIndex, mut TelemetryBytes payload, in u32 streamId){
    return RecordMovedPayloadImpl(recorder, kind, frameIndex, payload, streamId);
}

b8 RecordMovedPayload(mut TelemetryRecorder recorder, in EventKindEnum kind, in u64 frameIndex, mut TelemetryBytes payload){
    return RecordMovedPayload(recorder, kind, frameIndex, payload, 0u);
}

Expected<EventHeader> ReadEventHeaderAt(in EventView events, in usize eventIndex){
    const Optional<EventHeader> header = EventHeaderAtOpt(events, eventIndex);
    if(!header.has_value())
        return MakeUnexpected(Failure());
    return header.value();
}

usize EventRecordAddressAt(in EventView events, in usize eventIndex){
    return EventRecordAddressAtValue(events, eventIndex);
}

Expected<usize> EventPayloadSizeAt(in EventView events, in usize eventIndex){
    const Optional<Span<u8>> payload = EventPayloadSpanAtOpt(events, eventIndex);
    if(!payload.has_value())
        return MakeUnexpected(Failure());
    return payload.value().size();
}

Expected<usize> EventPayloadCapacityAt(in EventView events, in usize eventIndex){
    const Optional<usize> cap = EventPayloadCapacityAtOpt(events, eventIndex);
    if(!cap.has_value())
        return MakeUnexpected(Failure());
    return cap.value();
}

Expected<u8> EventPayloadFrontAt(in EventView events, in usize eventIndex){
    const Optional<Span<u8>> payload = EventPayloadSpanAtOpt(events, eventIndex);
    if(!payload.has_value() || payload.value().empty())
        return MakeUnexpected(Failure());
    return payload.value()[0u];
}

Expected<u8> EventPayloadBackAt(in EventView events, in usize eventIndex){
    const Optional<Span<u8>> payload = EventPayloadSpanAtOpt(events, eventIndex);
    if(!payload.has_value() || payload.value().empty())
        return MakeUnexpected(Failure());
    const Span<u8> bytes = payload.value();
    return bytes[bytes.size() - 1u];
}

