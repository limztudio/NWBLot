    public b8 setJointLinearOffset(in JointId jointId, in VectorSingle linearOffset){
        if(!this.isValidJoint(jointId) || !IsFinite(linearOffset.xyz))
            return false;
        this.m_joints[jointId.index].setLinearOffset(linearOffset);
        ++this.m_jointTopologyVersion;
        this.wakeJointBodies(jointId.index);
        return true;
