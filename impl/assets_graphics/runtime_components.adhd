const StringView s_ModelComponentLoadPayloadContext = "ModelComponentAsset::loadComponentPayload";
const StringView s_ModelComponentValidatePayloadContext = "ModelComponentAsset::validatePayload";
const StringView s_ModelComponentKindLabel = "model_component";
const StringView s_MeshComponentLoadPayloadContext = "MeshComponentAsset::loadComponentPayload";
const StringView s_MeshComponentValidatePayloadContext = "MeshComponentAsset::validatePayload";
const StringView s_MeshComponentKindLabel = "mesh_component";

const StringView s_SkinnedMeshBindingValidatePayloadContext = "SkinnedMeshBindingComponentAsset::validatePayload";
const StringView s_SkinnedMeshBindingKindLabel = "skinned_mesh_binding_component";
const StringView s_CsgReceiverLoadPayloadContext = "CsgReceiverComponentAsset::loadComponentPayload";
const StringView s_StaticCsgMeshLoadPayloadContext = "StaticCsgMeshComponentAsset::loadComponentPayload";
const StringView s_SkinnedCsgMeshLoadPayloadContext = "SkinnedCsgMeshComponentAsset::loadComponentPayload";

b8 LoadGraphicsComponentAssetBinary<AssetT : IComponent>(in Name virtualPath, in Span<u8> binary, mut AssetT target){
    AssetT candidate(virtualPath);
    if(!ComponentAssetBinaryCodec().loadBinary(binary, candidate))
        return false;
    target.component = candidate.component;
    return true;
}

b8 DeserializeCsgMeshReceiverPayload<const u8 Kind>(
    in Span<u8> payload,
    in StringView context,
    mut CsgMeshReceiverComponent<Kind> outComponent
){
    const Expected<CsgReceiverComponent> resolved = GraphicsComponentBinaryCodec().deserializeCsgReceiver(payload, context);
    if(!resolved.has_value())
        return false;
    AssignCsgMeshReceiverFromBase<Kind>(resolved.value(), outComponent);
    return true;
}

b8 ValidateSingleAssetRefComponentPayload(
    in IComponent componentAsset,
    in b8 validAssetRef,
    in StringView context,
    in StringView kindLabel
){
    if(!componentAsset.checkVirtualPath(context))
        return false;
    return GraphicsComponentBinaryCodec().validateAssetRef(validAssetRef, componentAsset.virtualPath(), context, kindLabel);
}

b8 ModelComponentAsset::loadBinary(in Span<u8> binary){
    ModelComponentAsset candidate(this.virtualPath());
    if(!ComponentAssetBinaryCodec().loadBinary(binary, candidate))
        return false;
    this.component = candidate.component;
    return true;
}

b8 ModelComponentAsset::loadComponentPayload(in Span<u8> payload){
    const Expected<Name> virtualPath = GraphicsComponentBinaryCodec().deserializeAssetRef(payload, s_ModelComponentLoadPayloadContext);
    if(!virtualPath.has_value())
        return false;
    this.component.model.virtualPath = virtualPath.value();
    return true;
}

b8 ModelComponentAsset::validatePayload()const{
    return ValidateSingleAssetRefComponentPayload(this, this.component.model.valid(), s_ModelComponentValidatePayloadContext, s_ModelComponentKindLabel);
}

b8 ModelComponentAsset::serializeComponentPayload(mut Vector<u8> outPayload)const{
    return GraphicsComponentBinaryCodec().serializeAssetRef(this.component.model.name(), outPayload);
}

b8 ModelComponentAsset::appendValidatedComponentPayload(mut Vector<u8> outBinary)const{
    return GraphicsComponentBinaryCodec().appendAssetRef(this.component.model.name(), outBinary);
}

b8 MeshComponentAsset::loadBinary(in Span<u8> binary){
    MeshComponentAsset candidate(this.virtualPath());
    if(!ComponentAssetBinaryCodec().loadBinary(binary, candidate))
