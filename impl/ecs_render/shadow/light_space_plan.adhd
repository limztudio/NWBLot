#include <impl/ecs_render/csg/cutter_gpu_data.adhd>
#include <impl/ecs_render/raytrace/types.adhd>
#include <impl/ecs_render/shadow/light_space_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<LightSpacePlan> TryBuildLightSpacePlan(in SoftwareShadowSettings settings, in Span<LightSpaceLightRequest> requests, in u64 maxStorageBufferRange, in u32 drawCount, in b8 csgIntervalDepth){
    LightSpacePlan outPlan;
    const usize requestCount = requests.size();
    if(maxStorageBufferRange == 0u || !ValidateSoftwareShadowSettings(settings) || requestCount > s_SceneShadowSlotCount)
        return makeUnexpected(Failure());
    u32 seenSlots = 0u;
    u64 seenLights = 0u;
    for(usize index = 0u; index < requestCount; ++index){
        const LightSpaceLightRequest request = requests[index];
        if(request.lightIndex >= s_SceneMaxLights || request.shadowSlot >= s_SceneShadowSlotCount || request.type >= s_LightSpaceLightTypeCount)
            return makeUnexpected(Failure());
        const u32 slotBit = 1u << request.shadowSlot;
        const u64 lightBit = 1ull << request.lightIndex;
        if((seenSlots & slotBit) != 0u || (seenLights & lightBit) != 0u)
            return makeUnexpected(Failure());
        seenSlots |= slotBit;
        seenLights |= lightBit;
    }
    if(settings.backend == SoftwareShadowBackend::SoftwareTrace)
        return outPlan;
    for(usize index = 0u; index < requestCount; ++index){
        const LightSpaceLightRequest request = requests[index];
        if(!request.eligible || request.type == s_LightSpaceLightTypeSpot)
            continue;
        if(drawCount == 0u)
            return makeUnexpected(Failure());
        const b8 point = request.type == s_LightSpaceLightTypePoint;
        u32 resolution = settings.directionalResolution;
        u32 viewCount = 1u;
        if(point){
            resolution = settings.pointResolution;
            viewCount = s_PointLightViewCount;
        }
        const u64 pixelsPerView = cast<u64>(resolution) * cast<u64>(resolution);
        const u64 pixels = cast<u64>(outPlan.totalPixels) + pixelsPerView * cast<u64>(viewCount);
        const u32 newViewCount = outPlan.viewCount + viewCount;
        const u32 textureResolution = max(outPlan.textureResolution, resolution);
        const u64 eventBytes = pixels * s_LightSpaceEventsPerTexel * s_LightSpaceEventBytes;
        const u64 countBytes = pixels * s_LightSpacePixelWordBytes;
        // Every D32 array layer uses the largest selected extent, even when its viewport is smaller.
        const u64 depthBytes = cast<u64>(textureResolution) * cast<u64>(textureResolution) * cast<u64>(newViewCount) * s_LightSpacePixelWordBytes;
        const u64 viewBytes = cast<u64>(newViewCount) * s_LightSpaceViewBytes;
        const u64 drawArgumentBytes = cast<u64>(newViewCount) * cast<u64>(drawCount) * s_LightSpaceDrawArgumentBytes;
        u64 extraCountBytes = 0u;
        if(csgIntervalDepth)
            extraCountBytes = countBytes;
        const u64 totalBytes = eventBytes + countBytes + depthBytes + viewBytes + drawArgumentBytes + extraCountBytes;
        if(
            totalBytes > settings.memoryBudgetBytes
            || eventBytes > s_ShadowMaxMemoryBudgetBytes
            || eventBytes > maxStorageBufferRange
            || viewBytes > maxStorageBufferRange
            || drawArgumentBytes > maxStorageBufferRange
            || drawArgumentBytes > s_ShadowMaxMemoryBudgetBytes
        )
            continue;
        ++outPlan.lightCount;
        LightSpaceFlag lightFlags = LightSpaceFlag::Eligible;
        if(point)
            lightFlags |= LightSpaceFlag::Point;
        if(settings.coverage == SoftwareShadowCoverage::FittedVolume)
            lightFlags |= LightSpaceFlag::FittedCoverage;
        if(settings.blockerSearch == SoftwareShadowBlockerSearch::CompactCross5)
            lightFlags |= LightSpaceFlag::CompactBlockers;
        if(settings.blockerSearch == SoftwareShadowBlockerSearch::Center1)
            lightFlags |= LightSpaceFlag::CenterBlocker;
        for(u32 face = 0u; face < viewCount; ++face){
            const u32 viewIndex = outPlan.viewCount + face;
            outPlan.views[viewIndex].map[0] = resolution;
            outPlan.views[viewIndex].map[1] = resolution;
            outPlan.views[viewIndex].map[2] = outPlan.totalPixels + cast<u32>(pixelsPerView) * face;
            outPlan.views[viewIndex].map[3] = viewIndex;
            outPlan.views[viewIndex].light[0] = request.lightIndex;
            outPlan.views[viewIndex].light[1] = request.shadowSlot;
            outPlan.views[viewIndex].light[2] = face;
            outPlan.views[viewIndex].light[3] = cast<u32>(lightFlags);
        }
        outPlan.viewCount = newViewCount;
        outPlan.textureResolution = textureResolution;
        outPlan.totalPixels = cast<u32>(pixels);
        outPlan.eventByteSize = eventBytes;
        outPlan.countByteSize = countBytes;
        outPlan.depthByteSize = depthBytes;
        outPlan.viewByteSize = viewBytes;
        outPlan.drawArgumentByteSize = drawArgumentBytes;
        outPlan.totalByteSize = totalBytes;
    }
    return outPlan;
}

u32 LightSpaceCasterDrawCount(in u32 meshletCount){
    if(meshletCount == 0u)
        return 1u;
    return divideUp(meshletCount, s_LightSpaceMeshletsPerDraw);
}

b8 LightSpaceCasterEligibleForCapturePass(in b8 casterTransparent, in b8 casterCsg, in b8 passTransparent, in u32 indexCount, in u32 csgFlags){
    if((casterTransparent || casterCsg) != passTransparent || indexCount == 0u)
        return false;
    if((csgFlags & s_LightSpaceCsgShadowFlagHwCompose) != 0u && !casterCsg)
        return false;
    return true;
}

u8 ResolveLightSpaceLightRequestType(in f32 lightTypeParam, in b8 hasCsg){
    if(lightTypeParam < s_LightTypeDirectionalMax)
        return s_LightSpaceLightTypeDirectional;
    if(lightTypeParam < s_LightTypePointMax || hasCsg)
        return s_LightSpaceLightTypePoint;
    return s_LightSpaceLightTypeSpot;
}

LightSpaceCsgInstanceGpu BuildLightSpaceCsgInstanceGpu(
    in MatrixSingle worldToObject,
    in VectorSingle localMin,
    in VectorSingle localMax,
    in u32 meshletPrimitiveIndexCount,
    in b8 hasRuntimeBounds,
    in u32 runtimeBoundsSlot,
    in b8 hardware,
    in b8 hasSwBvhNode,
    in u32 swBvhNodeSlot
){
    LightSpaceCsgInstanceGpu instance;
    instance.worldToObject = f32x3x4(worldToObject);
    instance.primitiveCount = meshletPrimitiveIndexCount / s_LightSpaceTriangleCornerCount;
    if(hasRuntimeBounds)
        instance.runtimeBoundsSlot = runtimeBoundsSlot;
    if(!hardware && hasSwBvhNode)
        instance.meshRootSlot = swBvhNodeSlot;
    instance.localMin = f32x4(localMin);
    instance.localMax = f32x4(localMax);
    return instance;
}

void UpdateLightSpaceCsgReceiverCaptureGeometryIdentity(
    in EntityID entity,
    in b8 transparent,
    in Name meshName,
    in u64 positionBufferId,
    in u64 triangleIndexBufferId,
    in u64 attributeBufferId,
    in u32 meshletCount,
    in u64 meshletDescBufferId,
    in u64 meshletLocalBoundsBufferId,
    in u32 meshletDescHeapHandle,
    in u32 meshletLocalBoundsHeapHandle,
    in u64 runtimeLocalBoundsBufferId,
    in u32 runtimeLocalBoundsHeapHandle,
    in u64 swBvhNodeBufferId,
    in u32 swBvhNodeHeapHandle,
    in u32 meshletPrimitiveIndexCount,
    in u64 runtimeMeshVersion,
    in u64 runtimeGeometryContentRevision,
    in b8 runtimeMesh,
    mut u64 inOutCaptureGeometryIdentity,
    mut b8 inOutCaptureGeometryTrusted
){
    u64 hash = updateFnv64U32(inOutCaptureGeometryIdentity, entity.id);
    hash = UpdateFnv64BoolValue(hash, transparent);
    hash = updateFnv64NameHash(hash, meshName.hash());
    hash = updateFnv64U64(hash, positionBufferId);
    hash = updateFnv64U64(hash, triangleIndexBufferId);
    hash = updateFnv64U64(hash, attributeBufferId);
    hash = updateFnv64U32(hash, meshletCount);
    hash = updateFnv64U64(hash, meshletDescBufferId);
    hash = updateFnv64U64(hash, meshletLocalBoundsBufferId);
    hash = updateFnv64U32(hash, meshletDescHeapHandle);
    hash = updateFnv64U32(hash, meshletLocalBoundsHeapHandle);
    hash = updateFnv64U64(hash, runtimeLocalBoundsBufferId);
    hash = updateFnv64U32(hash, runtimeLocalBoundsHeapHandle);
    hash = updateFnv64U64(hash, swBvhNodeBufferId);
    hash = updateFnv64U32(hash, swBvhNodeHeapHandle);
    hash = updateFnv64U32(hash, meshletPrimitiveIndexCount);
    hash = updateFnv64U64(hash, runtimeMeshVersion);
    hash = updateFnv64U64(hash, runtimeGeometryContentRevision);
    hash = UpdateFnv64BoolValue(hash, runtimeMesh);
    inOutCaptureGeometryIdentity = hash;
    if(runtimeMesh && runtimeGeometryContentRevision == 0u)
        inOutCaptureGeometryTrusted = false;
}

void AppendLightSpaceCsgU32(in u32 value, mut Vector<u8> outBinary){
    outBinary.push_back(cast<u8>(value & 0xffu));
    outBinary.push_back(cast<u8>((value >> 8u) & 0xffu));
    outBinary.push_back(cast<u8>((value >> 16u) & 0xffu));
    outBinary.push_back(cast<u8>((value >> 24u) & 0xffu));
}

void AppendLightSpaceCsgF32(in f32 value, mut Vector<u8> outBinary){
    AppendLightSpaceCsgU32(bit_cast<u32>(value), outBinary);
}

void AppendLightSpaceCsgVector4(in VectorSingle value, mut Vector<u8> outBinary){
    AppendLightSpaceCsgF32(value.x, outBinary);
    AppendLightSpaceCsgF32(value.y, outBinary);
    AppendLightSpaceCsgF32(value.z, outBinary);
    AppendLightSpaceCsgF32(value.w, outBinary);
}

void AppendLightSpaceCsgMatrix34(in MatrixSingle value, mut Vector<u8> outBinary){
    AppendLightSpaceCsgVector4(value[0u], outBinary);
    AppendLightSpaceCsgVector4(value[1u], outBinary);
    AppendLightSpaceCsgVector4(value[2u], outBinary);
}

void AppendLightSpaceCsgHeader(in LightSpaceCsgContextHeader header, mut Vector<u8> outBinary){
    AppendLightSpaceCsgU32(header.instanceCount, outBinary);
    AppendLightSpaceCsgU32(header.rangeByteOffset, outBinary);
    AppendLightSpaceCsgU32(header.cutterByteOffset, outBinary);
    AppendLightSpaceCsgU32(header.cutterCount, outBinary);
    AppendLightSpaceCsgU32(header.instanceByteOffset, outBinary);
    AppendLightSpaceCsgU32(header.activeReceiverByteOffset, outBinary);
    AppendLightSpaceCsgU32(header.activeReceiverCount, outBinary);
    AppendLightSpaceCsgU32(header.rayFailureFlags, outBinary);
}

void AppendLightSpaceCsgReceiverRange(in CsgShadowReceiverRangeGpu range, in u32 solidTriangleWordOffset, mut Vector<u8> outBinary){
    AppendLightSpaceCsgU32(range.firstCutter, outBinary);
    AppendLightSpaceCsgU32(range.cutterCount, outBinary);
    AppendLightSpaceCsgU32(range.flags, outBinary);
    AppendLightSpaceCsgU32(solidTriangleWordOffset, outBinary);
}

void AppendLightSpaceCsgCutter(in CsgCutterGpuData cutter, mut Vector<u8> outBinary){
    AppendLightSpaceCsgU32(cutter.shapeType, outBinary);
    AppendLightSpaceCsgF32(cutter.worldToShapeScaleBound, outBinary);
    AppendLightSpaceCsgU32(cutter.padding0, outBinary);
    AppendLightSpaceCsgU32(cutter.padding1, outBinary);
    AppendLightSpaceCsgMatrix34(MatrixSingle(cutter.worldToShape), outBinary);
    AppendLightSpaceCsgVector4(VectorSingle(cutter.parameter0), outBinary);
    AppendLightSpaceCsgVector4(VectorSingle(cutter.parameter1), outBinary);
}

void AppendLightSpaceCsgInstance(in LightSpaceCsgInstanceGpu instance, mut Vector<u8> outBinary){
    AppendLightSpaceCsgMatrix34(MatrixSingle(instance.worldToObject), outBinary);
    AppendLightSpaceCsgU32(instance.runtimeBoundsSlot, outBinary);
    AppendLightSpaceCsgU32(instance.primitiveCount, outBinary);
    AppendLightSpaceCsgU32(instance.meshRootSlot, outBinary);
    AppendLightSpaceCsgU32(instance.padding, outBinary);
    AppendLightSpaceCsgVector4(VectorSingle(instance.localMin), outBinary);
    AppendLightSpaceCsgVector4(VectorSingle(instance.localMax), outBinary);
}

b8 PackLightSpaceCsgContextBytes(
    in Span<CsgShadowReceiverRangeGpu> receiverRanges,
    in Span<CsgCutterGpuData> cutters,
    in Span<LightSpaceCsgInstanceGpu> instances,
    in Span<Span<u32>> solidTriangleMasks,
    mut Vector<u8> outBytes
){
    if(receiverRanges.size() != instances.size() || solidTriangleMasks.size() != instances.size())
        return false;

    const usize rangeBytes = receiverRanges.size() * 16u;
    const usize cutterBytes = cutters.size() * 96u;
    const usize instanceBytes = instances.size() * 96u;
    u32 activeReceiverCount = 0u;
    for(in CsgShadowReceiverRangeGpu range : receiverRanges){
        if((range.flags & s_CsgRayReceiverActive) != 0u)
            ++activeReceiverCount;
    }
    const usize activeReceiverBytes = cast<usize>(activeReceiverCount) * 4u;
    const usize activeReceiverOffset = cast<usize>(s_LightSpaceCsgRayContextBytes) + rangeBytes + cutterBytes + instanceBytes;
    usize totalBytes = activeReceiverOffset + activeReceiverBytes;
    if(totalBytes > cast<usize>(u32.max))
        return false;
    const usize membershipOffset = totalBytes;
    for(usize index = 0u; index < instances.size(); ++index){
        if((receiverRanges[index].flags & s_CsgRayReceiverActive) == 0u)
            continue;
        const Span<u32> words = solidTriangleMasks[index];
        const u32 requiredWords = divideUpWrappingU32(instances[index].primitiveCount, 32u);
        const usize wordBytes = words.size() * 4u;
        if(words.size() != cast<usize>(requiredWords) || words.empty() || wordBytes > cast<usize>(u32.max) - totalBytes){
            error("RendererSystem: CSG receiver has no valid cooked solid topology or exceeds ray context capacity");
            return false;
        }
        totalBytes += wordBytes;
    }

    outBytes.clear();
    outBytes.reserve(totalBytes);
    const LightSpaceCsgContextHeader header = BuildLightSpaceCsgContextHeader(
        instances.size(),
        rangeBytes,
        cutterBytes,
        cutters.size(),
        activeReceiverOffset,
        activeReceiverCount
    );
    AppendLightSpaceCsgHeader(header, outBytes);

    usize maskOffset = membershipOffset;
    for(usize index = 0u; index < receiverRanges.size(); ++index){
        const CsgShadowReceiverRangeGpu range = receiverRanges[index];
        u32 wordOffset = range.solidTriangleWordOffset;
        if((range.flags & s_CsgRayReceiverActive) != 0u){
            wordOffset = cast<u32>(maskOffset);
            maskOffset += solidTriangleMasks[index].size() * 4u;
        }
        AppendLightSpaceCsgReceiverRange(range, wordOffset, outBytes);
    }
    for(in CsgCutterGpuData cutter : cutters)
        AppendLightSpaceCsgCutter(cutter, outBytes);
    for(in LightSpaceCsgInstanceGpu instance : instances)
        AppendLightSpaceCsgInstance(instance, outBytes);
    for(u32 index = 0u; index < cast<u32>(receiverRanges.size()); ++index){
        if((receiverRanges[cast<usize>(index)].flags & s_CsgRayReceiverActive) != 0u)
            AppendLightSpaceCsgU32(index, outBytes);
    }
    for(usize index = 0u; index < receiverRanges.size(); ++index){
        if((receiverRanges[index].flags & s_CsgRayReceiverActive) == 0u)
            continue;
        for(in u32 word : solidTriangleMasks[index])
            AppendLightSpaceCsgU32(word, outBytes);
    }
    return true;
}

LightSpaceCsgContextHeader BuildLightSpaceCsgContextHeader(
    in usize instanceCount,
    in usize rangeBytes,
    in usize cutterBytes,
    in usize cutterCount,
    in usize activeReceiverOffset,
    in u32 activeReceiverCount
){
    LightSpaceCsgContextHeader header;
    header.instanceCount = cast<u32>(instanceCount);
    header.rangeByteOffset = s_LightSpaceCsgRayContextBytes;
    header.cutterByteOffset = cast<u32>(cast<usize>(s_LightSpaceCsgRayContextBytes) + rangeBytes);
    header.cutterCount = cast<u32>(cutterCount);
    header.instanceByteOffset = cast<u32>(cast<usize>(s_LightSpaceCsgRayContextBytes) + rangeBytes + cutterBytes);
    header.activeReceiverByteOffset = cast<u32>(activeReceiverOffset);
    header.activeReceiverCount = activeReceiverCount;
    header.rayFailureFlags = 0u;
    return header;
}

b8 LightSpaceShadowStorageFits(in LightSpacePlan plan, in LightSpaceShadowStorageCapacity capacity){
    return
        plan.viewCount != 0u && plan.textureResolution != 0u
        && plan.countByteSize != 0u && plan.eventByteSize != 0u && plan.viewByteSize != 0u && plan.drawArgumentByteSize != 0u
        && plan.countByteSize <= capacity.countBytes && plan.eventByteSize <= capacity.eventBytes
        && plan.viewByteSize <= capacity.viewBytes && plan.drawArgumentByteSize <= capacity.drawArgumentBytes
        && plan.textureResolution <= capacity.textureResolution
        && plan.viewCount <= capacity.arrayLayers
    ;
}

void LogNewLightSpaceCsgRayFailures(in u32 failureFlags, mut u32 inOutReportedFailures){
    const u32 newFailures = failureFlags & ~inOutReportedFailures;
    inOutReportedFailures |= failureFlags;
    if((newFailures & s_LightSpaceCsgRayFailureUnsupported) != 0u)
        warning("RendererSystem: CSG direct-shadow traversal rejected unsupported receiver or cutter geometry; conservative occlusion retained");
    if((newFailures & s_LightSpaceCsgRayFailureCapacity) != 0u)
        warning("RendererSystem: CSG direct-shadow traversal exceeded closed-crossing or BVH stack capacity (flags=2); conservative occlusion retained");
    if((newFailures & s_LightSpaceCsgRayFailureTopology) != 0u)
        warning("RendererSystem: CSG direct-shadow traversal rejected incomplete or invalid solid topology; conservative occlusion retained");
    if((newFailures & s_LightSpaceCsgRayFailureOpenCapacity) != 0u)
        warning("RendererSystem: CSG direct-shadow traversal exceeded open-surface capacity (flags=16); conservative occlusion retained");
}

b8 HasAnyLightSpaceCsgActiveLight(in b8 hasCsg, in Span<SceneLightGpuData> lights){
    if(!hasCsg)
        return false;
    for(in SceneLightGpuData light : lights){
        if(light.params.z >= 0.0f)
            return true;
    }
    return false;
}

Expected<LightSpacePlan> TryBuildLightSpacePlanForSceneLights(
    in SoftwareShadowSettings baseSettings,
    in Span<SceneLightGpuData> lights,
    in u64 maxStorageBufferRange,
    in u32 drawCount,
    in b8 hasCsg,
    in usize csgContextBytes
){
    const usize lightCount = lights.size();
    if(lightCount > cast<usize>(s_SceneMaxLights))
        return makeUnexpected(Failure());

    Array<LightSpaceLightRequest, s_SceneShadowSlotCount> requests;
    usize requestCount = 0u;
    for(u32 index = 0u; index < cast<u32>(lightCount); ++index){
        const SceneLightGpuData light = lights[cast<usize>(index)];
        if(light.params.z < 0.0f || light.params.z >= cast<f32>(s_SceneShadowSlotCount))
            continue;
        if(requestCount == requests.size())
            return makeUnexpected(Failure());
        LightSpaceLightRequest request;
        request.lightIndex = index;
        request.shadowSlot = cast<u32>(light.params.z);
        request.type = ResolveLightSpaceLightRequestType(light.params.y, hasCsg);
        request.eligible = true;
        requests[requestCount] = request;
        ++requestCount;
    }

    SoftwareShadowSettings settings = baseSettings;
    if(hasCsg){
        settings.backend = SoftwareShadowBackend::Automatic;
        const u64 requiredCsgBytes = cast<u64>(csgContextBytes) + 4ull;
        if(settings.memoryBudgetBytes <= requiredCsgBytes)
            return makeUnexpected(Failure());
        settings.memoryBudgetBytes -= requiredCsgBytes;
    }

    const Span<LightSpaceLightRequest> allRequests = requests;
    const Expected<LightSpacePlan> plan = TryBuildLightSpacePlan(
        settings,
        allRequests.subspan(0u, requestCount),
        maxStorageBufferRange,
        drawCount,
        hasCsg
    );
    if(!plan.has_value() || plan.value().viewCount == 0u)
        return makeUnexpected(Failure());
    return plan.value();
}

u64 UpdateFnv64Float4LittleEndian(in u64 hash, in VectorSingle value){
    u64 outHash = updateFnv64U32(hash, bit_cast<u32>(value.x));
    outHash = updateFnv64U32(outHash, bit_cast<u32>(value.y));
    outHash = updateFnv64U32(outHash, bit_cast<u32>(value.z));
    outHash = updateFnv64U32(outHash, bit_cast<u32>(value.w));
    return outHash;
}

LightSpaceCaptureIdentity BuildLightSpaceCaptureIdentity(
    in u64 sceneIdentity,
    in b8 sceneTrusted,
    in Span<SceneLightGpuData> lights,
    in u32 width,
    in u32 height,
    in LightSpacePlan plan
){
    LightSpaceCaptureIdentity identity;
    identity.scene = sceneIdentity;
    identity.trusted = sceneTrusted;
    identity.lighting = s_Fnv64OffsetBasis;
    const u32 lightCount = cast<u32>(lights.size());
    identity.lighting = updateFnv64U32(identity.lighting, lightCount);
    for(in SceneLightGpuData light : lights){
        identity.lighting = UpdateFnv64Float4LittleEndian(identity.lighting, VectorSingle(light.position));
        identity.lighting = UpdateFnv64Float4LittleEndian(identity.lighting, VectorSingle(light.direction));
        identity.lighting = UpdateFnv64Float4LittleEndian(identity.lighting, VectorSingle(light.colorIntensity));
        identity.lighting = UpdateFnv64Float4LittleEndian(identity.lighting, VectorSingle(light.params));
        identity.lighting = UpdateFnv64Float4LittleEndian(identity.lighting, VectorSingle(light.params2));
    }
    identity.layout = s_Fnv64OffsetBasis;
    identity.layout = updateFnv64U32(identity.layout, width);
    identity.layout = updateFnv64U32(identity.layout, height);
    identity.layout = updateFnv64U32(identity.layout, plan.lightCount);
    identity.layout = updateFnv64U32(identity.layout, plan.viewCount);
    identity.layout = updateFnv64U32(identity.layout, plan.textureResolution);
    identity.layout = updateFnv64U64(identity.layout, plan.drawArgumentByteSize);
    for(u32 view = 0u; view < plan.viewCount; ++view){
        for(usize lane = 0u; lane < 4u; ++lane)
            identity.layout = updateFnv64U32(identity.layout, plan.views[cast<usize>(view)].map[lane]);
        for(usize lane = 0u; lane < 4u; ++lane)
            identity.layout = updateFnv64U32(identity.layout, plan.views[cast<usize>(view)].light[lane]);
    }
    return identity;
}

u64 BuildLightSpaceCsgBaseCaptureIdentity(
    in u64 captureGeometryIdentity,
    in u64 snapshotContentIdentity,
    in Span<NwbRtInstanceMaterialGpu> materials,
    in Span<InstanceGpuData> instances,
    in Span<u8> materialBytes,
    in usize textureCount
){
    const usize instanceCount = instances.size();
    u64 identity = updateFnv64U64(captureGeometryIdentity, snapshotContentIdentity);
    identity = updateFnv64U64(identity, cast<u64>(instanceCount));
    for(usize index = 0u; index < instanceCount; ++index){
        const NwbRtInstanceMaterialGpu mat = materials[index];
        identity = updateFnv64U32(identity, mat.surfaceDispatchId);
        identity = updateFnv64U32(identity, mat.flags);
        identity = updateFnv64U32(identity, mat.shadingModelId);
        identity = updateFnv64U32(identity, mat.materialConstantByteOffset);
        identity = updateFnv64U32(identity, mat.meshInstanceIndex);
        identity = updateFnv64U32(identity, mat.indexSlot);
        identity = updateFnv64U32(identity, mat.attributeSlot);
        identity = updateFnv64U32(identity, mat.positionSlot);
        identity = updateFnv64U32(identity, mat.nodeSlot);
        const InstanceGpuData inst = instances[index];
        identity = updateFnv64U32(identity, bit_cast<u32>(inst.translation.w));
        for(usize slotIndex = 0u; slotIndex < inst.geometryHeapSlots.size(); ++slotIndex)
            identity = updateFnv64U32(identity, inst.geometryHeapSlots[slotIndex]);
    }
    identity = UpdateFnv64ByteSpan(identity, materialBytes);
    return updateFnv64U64(identity, cast<u64>(textureCount));
}

void UpdateLightSpaceCsgInstancesIdentity(
    in Span<LightSpaceCsgInstanceGpu> instances,
    mut u64 inOutIdentity
){
    const u64 instanceBytes = cast<u64>(instances.size()) * 96ul;
    inOutIdentity = updateFnv64U64(inOutIdentity, instanceBytes);
    for(in LightSpaceCsgInstanceGpu inst : instances){
        inOutIdentity = UpdateFnv64Matrix34Bits(inOutIdentity, MatrixSingle(inst.worldToObject));
        inOutIdentity = updateFnv64U32(inOutIdentity, inst.runtimeBoundsSlot);
        inOutIdentity = updateFnv64U32(inOutIdentity, inst.primitiveCount);
        inOutIdentity = updateFnv64U32(inOutIdentity, inst.meshRootSlot);
        inOutIdentity = updateFnv64U32(inOutIdentity, inst.padding);
        inOutIdentity = UpdateFnv64Vector4Bits(inOutIdentity, VectorSingle(inst.localMin));
        inOutIdentity = UpdateFnv64Vector4Bits(inOutIdentity, VectorSingle(inst.localMax));
    }
}

void LogLightSpaceCsgUnsupportedLimitationsIfNeeded(
    in Span<CsgShadowReceiverRangeGpu> receiverRanges,
    mut b8 inOutLimitationLogged
){
    if(inOutLimitationLogged)
        return;
    for(in CsgShadowReceiverRangeGpu range : receiverRanges){
        if((range.flags & s_CsgRayReceiverUnsupported) == 0u)
            continue;
        inOutLimitationLogged = true;
        warning("RendererSystem: unsupported or over-budget CSG cutters retain conservative shadows and suppress GI bounce radiance");
        break;
    }
}

void PopulatePreparedLightSpaceShadowPush(
    in u32 viewSlot,
    in u32 materialContextSlot,
    in u32 countsSlot,
    in u32 eventsSlot,
    in u32 depthSlot,
    in u32 instanceCount,
    in u32 captureDrawCount,
    in u32 width,
    in u32 receiverFactor,
    in u32 height,
    in u32 deferredResourcesSlot,
    in u32 sceneRootSlot,
    in b8 hasCsg,
    in b8 hardwareSupported,
    in b8 hasOrdinaryTransparent,
    in u32 csgContextSlot,
    in u32 csgOpaqueDepthSlot,
    in u32 viewCount,
    in u32 outputSlot,
    mut LightSpaceShadowPush outPush
){
    outPush.viewSlot = viewSlot;
    outPush.materialContextSlot = materialContextSlot;
    outPush.countsSlot = countsSlot;
    outPush.eventsSlot = eventsSlot;
    outPush.depthSlot = depthSlot;
    outPush.instanceCount = instanceCount;
    outPush.captureDrawCount = captureDrawCount;
    outPush.width = width;
    outPush.receiverFactor = receiverFactor;
    outPush.height = height;
    outPush.deferredResourcesSlot = deferredResourcesSlot;
    outPush.sceneRootSlot = sceneRootSlot;
    outPush.csgFlags = 0u;
    if(hasCsg){
        outPush.csgFlags = s_LightSpaceCsgShadowFlagEnabled;
        if(hardwareSupported)
            outPush.csgFlags |= s_LightSpaceCsgShadowFlagHwCompose;
        if(!hasOrdinaryTransparent)
            outPush.csgFlags |= s_LightSpaceCsgShadowFlagNoOrdinaryTransparent;
        outPush.csgContextSlot = csgContextSlot;
        outPush.csgOpaqueDepthSlot = csgOpaqueDepthSlot;
    }
    outPush.viewCount = viewCount;
    outPush.outputSlot = outputSlot;
}


