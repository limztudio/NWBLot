class UiPopupGallery{
    public void trigger(mut Builder ui){
        WidgetOptions options = WidgetOptions();
        options.width = LayoutSize(LayoutSizePolicy::Fixed, s_PopupMenuButtonWidth);
        if(ui.button("menu", "Menu", options))
            this.m_popup.open();
    }

    public void paint(mut UiPaintContext context, in f32 x, in f32 y){
        PopupOptions options = PopupOptions();
        options.anchor = ResolvePopupGalleryAnchorRect(x, y);
        options.size = Point(s_PopupGalleryWidth, s_PopupGalleryHeight);
        if(!context.ui.beginPopup("gallery_menu", this.m_popup, options))
            return;
        const f32 previousFontSize = SetBuilderFontSize(context.ui, s_GalleryFontSize);
        WidgetOptions row = WidgetOptions();
        row.width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
        const StringView caption = ResolvePopupGalleryCaption(this.m_choice);
        const b8 declared = context.ui.label(s_TitleKey, caption);
        if(context.ui.button("first", "First choice", row)){
            this.m_choice = s_PopupFirstChoice;
            if(!this.m_keepOpen)
                this.m_popup.close();
        }
        if(context.ui.button("second", "Second choice", row)){
            this.m_choice = s_PopupSecondChoice;
            if(!this.m_keepOpen)
                this.m_popup.close();
        }
        if(context.ui.checkbox("keep_open", "Keep open on selection", this.m_keepOpen, row))
            [essential] info("Testbed: popup keep open={}", this.m_keepOpen);
        const b8 valid = context.ui.endPopup() && declared;
        RestoreBuilderFontSize(context.ui, previousFontSize);
        if(!valid)
            error("Testbed: custom popup declaration failed");
    }

    private PopupState m_popup = PopupState();
    private u32 m_choice = 0u;
    private b8 m_keepOpen = false;
}

