NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct UiSkinCookEntry{
    Core::Assets::AssetArena& arena;
    UiSkin::RegionVector regions;
    Core::Assets::AssetRef<Texture> texture;
    Name virtualPath = s_NameNone;
    u32 atlasWidth = 0u;
    u32 atlasHeight = 0u;
    f32 referenceDensity = 1.0f;
    b8 completeToolkitSkin = false;
    UiSkinPalette palette;
    UiSkinTypography typography;


public:
    explicit UiSkinCookEntry(Core::Assets::AssetArena& memoryArena)noexcept
        : arena(memoryArena)
        , regions(memoryArena)
    {}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] Expected<UiSkinCookEntry> ParseUiSkinCookMetadata(Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<UiSkinCookEntry> ParseUiSkinCookMetadata(const Path& assetRoot, AStringView virtualRoot, const Path& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);

template<typename FileArenaT>
    requires (!IsSame_V<FileArenaT, Core::Alloc::GlobalArena>)
[[nodiscard]] FOUNDATION_INLINE Expected<UiSkinCookEntry> ParseUiSkinCookMetadata(const Name virtualPath, const ::Path<FileArenaT>& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    return ParseUiSkinCookMetadata(virtualPath, Path(arena, nwbFilePath), asset, arena, scratchArena);
}

template<typename RootArenaT, typename FileArenaT>
    requires (!IsSame_V<RootArenaT, Core::Alloc::GlobalArena> || !IsSame_V<FileArenaT, Core::Alloc::GlobalArena>)
[[nodiscard]] FOUNDATION_INLINE Expected<UiSkinCookEntry> ParseUiSkinCookMetadata(const ::Path<RootArenaT>& assetRoot, const AStringView virtualRoot, const ::Path<FileArenaT>& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    return ParseUiSkinCookMetadata(Path(arena, assetRoot), virtualRoot, Path(arena, nwbFilePath), doc, arena, scratchArena);
}
[[nodiscard]] Expected<UiSkin> BuildUiSkinAsset(const UiSkinCookEntry& entry, Core::Assets::AssetArena& arena);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type UiSkinPaletteSeenArray = Array<b8, s_UiSkinPaletteColorCount>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiSkinCookHeader{
    public AssetRef<Texture> texture = AssetRef<Texture>();
    public Name virtualPath = s_NameNone;
    public u32 atlasWidth = 0u;
    public u32 atlasHeight = 0u;
    public f32 referenceDensity = 1.0f;
    public b8 completeToolkitSkin = false;
    public UiSkinPalette palette = UiSkinPalette();
    public UiSkinTypography typography = UiSkinTypography();
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<u32> ReadUiSkinU32Value(in Path path, in MetascriptValue value, in StringView fieldName){
    if(value.isInteger()){
        const i64 rawValue = value.asInteger();
        if(FitsU32(rawValue))
            return cast<u32>(rawValue);
    }

    error("{} '{}': field '{}' must contain integers in the u32 range", s_UiSkinDiagnosticPrefix, PathToString(path), fieldName);
    return MakeUnexpected(Failure());
}

Expected<Span<MetascriptValue>> ReadUiSkinComponentList(
    in Path path,
    in MetascriptValue object,
    in StringView fieldName,
    in b8 required,
    in usize expectedCount,
    in StringView kindLabel
){
    b8 found = false;
    b8 isList = false;
    Span<MetascriptValue> listValues = Span<MetascriptValue>();
    object.visitField(fieldName, lambda[mut found, mut isList, mut listValues](in MetascriptValue value) -> void{
        found = true;
        if(value.isList()){
            isList = true;
            listValues = value.listView();
        }
    });
    if(!found && !required)
        return Span<MetascriptValue>();
    if(!isList || listValues.size() != expectedCount){
        error("{} '{}': field '{}' must be a {}-component {} list", s_UiSkinDiagnosticPrefix, PathToString(path), fieldName, expectedCount, kindLabel);
        return MakeUnexpected(Failure());
    }
    return listValues;
}

Expected<Array<u32, 4>> ReadUiSkinU32Components(in Path path, in MetascriptValue object, in StringView fieldName, in b8 required, in usize componentCount){
    Array<u32, 4> values = Array<u32, 4>();
    const Expected<Span<MetascriptValue>> listResult = ReadUiSkinComponentList(path, object, fieldName, required, componentCount, "integer");
    if(!listResult.has_value())
        return MakeUnexpected(Failure());

    in Span<MetascriptValue> items = listResult.value();
    for(usize index = 0u; index < items.size(); ++index){
        const Expected<u32> valueResult = ReadUiSkinU32Value(path, items[index], fieldName);
        if(!valueResult.has_value())
            return MakeUnexpected(Failure());
        values[index] = valueResult.value();
    }
    return values;
}

Expected<Array<f32, 4>> ReadUiSkinLogicalComponents(in Path path, in MetascriptValue object, in StringView fieldName, in usize componentCount){
    Array<f32, 4> values = Array<f32, 4>();
    const Expected<Span<MetascriptValue>> listResult = ReadUiSkinComponentList(path, object, fieldName, false, componentCount, "numeric");
    if(!listResult.has_value())
        return MakeUnexpected(Failure());

    in Span<MetascriptValue> items = listResult.value();
    for(usize index = 0u; index < items.size(); ++index){
        const Expected<f32> valueResult = ReadMetadataFiniteF32Value(path, items[index], s_UiSkinDiagnosticPrefix, fieldName);
        if(!valueResult.has_value())
            return MakeUnexpected(Failure());
        values[index] = valueResult.value();
    }
    return values;
}

Expected<UiSkinDrawMode> ParseUiSkinDrawModeField(in Path path, in MetascriptValue object){
    if(!object.hasField(s_UiSkinDrawModeField))
        return UiSkinDrawMode::Sprite;

    const Expected<MetadataStringField> field = ReadMetadataStringField(path, object, s_UiSkinDiagnosticPrefix, s_UiSkinDrawModeField, true);
    if(!field.has_value())
        return MakeUnexpected(Failure());

    in StringView text = field.value().text;
    if(text == s_UiSkinDrawModeSprite)
        return UiSkinDrawMode::Sprite;
    if(text == s_UiSkinDrawModeNineSlice)
        return UiSkinDrawMode::NineSlice;

    error("{} '{}': field '{}' {}", s_UiSkinDiagnosticPrefix, PathToString(path), s_UiSkinDrawModeField, s_UiSkinDrawModeHint);
    return MakeUnexpected(Failure());
}

Expected<UiSkinRegion> ParseUiSkinRegion(in Path path, in MetascriptValue object){
    if(!CheckMetadataAssetMap(path, object, s_UiSkinDiagnosticPrefix))
        return MakeUnexpected(Failure());

    const Expected<UiSkinDrawMode> drawModeResult = ParseUiSkinDrawModeField(path, object);
    if(!drawModeResult.has_value())
        return MakeUnexpected(Failure());
    const UiSkinDrawMode drawMode = drawModeResult.value();
    const b8 hasSlice = drawMode == UiSkinDrawMode::NineSlice;

    if(!ValidateMetadataAssetFields(path, object, s_UiSkinDiagnosticPrefix, lambda[in hasSlice](in StringView field) -> b8{
        return IsAllowedUiSkinRegionField(field, hasSlice);
    }))
        return MakeUnexpected(Failure());

    const Expected<Name> nameResult = ReadMetadataNameField(path, object, s_UiSkinDiagnosticPrefix, s_UiSkinNameField, true);
    if(!nameResult.has_value())
        return MakeUnexpected(Failure());

    const Expected<Array<u32, 4>> rectangleResult = ReadUiSkinU32Components(path, object, s_UiSkinRectField, true, cast<usize>(s_UiSkinRectComponentCount));
    if(!rectangleResult.has_value())
        return MakeUnexpected(Failure());

    const Expected<Array<u32, 4>> sliceResult = ReadUiSkinU32Components(path, object, s_UiSkinSliceField, hasSlice, cast<usize>(s_UiSkinSliceComponentCount));
    if(!sliceResult.has_value())
        return MakeUnexpected(Failure());

    const Expected<Array<f32, 4>> paddingResult = ReadUiSkinLogicalComponents(path, object, s_UiSkinPaddingField, cast<usize>(s_UiSkinPaddingComponentCount));
    if(!paddingResult.has_value())
        return MakeUnexpected(Failure());

    const Expected<Array<f32, 4>> minimumSizeResult = ReadUiSkinLogicalComponents(path, object, s_UiSkinMinimumSizeField, cast<usize>(s_UiSkinMinimumSizeComponentCount));
    if(!minimumSizeResult.has_value())
        return MakeUnexpected(Failure());

    in Array<u32, 4> rect = rectangleResult.value();
    in Array<u32, 4> slice = sliceResult.value();
    in Array<f32, 4> padding = paddingResult.value();
    in Array<f32, 4> minimumSize = minimumSizeResult.value();

    UiSkinRegion region = UiSkinRegion();
    region.name = nameResult.value();
    region.drawMode = drawMode;
    region.rectangle = UiSkinRect(rect[0u], rect[1u], rect[2u], rect[3u]);
    region.sliceInsets = UiSkinSliceInsets(slice[0u], slice[1u], slice[2u], slice[3u]);
    region.padding = UiSkinInsets(padding[0u], padding[1u], padding[2u], padding[3u]);
    region.minimumWidth = minimumSize[0u];
    region.minimumHeight = minimumSize[1u];
    return region;
}

Expected<UiSkinPalette> ParseUiSkinPalette(in Path path, in MetascriptValue asset){
    UiSkinPalette palette = UiSkinPalette();

    const Expected<Span<MetascriptValue>> colorsResult = ReadMetadataListField(path, asset, s_UiSkinDiagnosticPrefix, s_UiSkinColorsField);
    if(!colorsResult.has_value())
        return MakeUnexpected(colorsResult.error());

    in Span<MetascriptValue> colors = colorsResult.value();
    if(colors.size() != cast<usize>(UiSkinColorRole::kCount)){
        error("{} '{}': colors must contain exactly {} named RGBA roles", s_UiSkinDiagnosticPrefix, PathToString(path), cast<u32>(UiSkinColorRole::kCount));
        return MakeUnexpected(Failure());
    }

    UiSkinPaletteSeenArray seen = UiSkinPaletteSeenArray();
    for(in MetascriptValue value : colors){
        if(!CheckMetadataAssetMap(path, value, s_UiSkinDiagnosticPrefix) || !ValidateMetadataAssetFields(path, value, s_UiSkinDiagnosticPrefix, lambda[](in StringView field) -> b8{
            return IsAllowedUiSkinPaletteRoleField(field);
        }))
            return MakeUnexpected(Failure());

        const Expected<MetadataStringField> nameResult = ReadMetadataStringField(path, value, s_UiSkinDiagnosticPrefix, s_UiSkinNameField, true);
        if(!nameResult.has_value())
            return MakeUnexpected(Failure());

        in StringView name = nameResult.value().text;
        const u64 roleValue = ResolveUiSkinColorRole(name);
        if(roleValue >= cast<u64>(UiSkinColorRole::kCount) || seen[cast<usize>(roleValue)]){
            error("{} '{}': unknown or duplicate palette role '{}'", s_UiSkinDiagnosticPrefix, PathToString(path), name);
            return MakeUnexpected(Failure());
        }
        const usize role = cast<usize>(roleValue);

        b8 hasRgbaList = false;
        Span<MetascriptValue> rgbaItems = Span<MetascriptValue>();
        value.visitField(s_UiSkinRgbaField, lambda[mut hasRgbaList, mut rgbaItems](in MetascriptValue field) -> void{
            if(field.isList()){
                rgbaItems = field.listView();
                hasRgbaList = rgbaItems.size() == cast<usize>(s_UiSkinRgbaComponentCount);
            }
        });
        if(!hasRgbaList){
            error("{} '{}': palette role '{}' needs four RGBA components", s_UiSkinDiagnosticPrefix, PathToString(path), name);
            return MakeUnexpected(Failure());
        }

        Array<f32, 4> components = Array<f32, 4>();
        for(usize index = 0u; index < rgbaItems.size(); ++index){
            const Expected<f32> channelResult = ReadMetadataFiniteF32Value(path, rgbaItems[index], s_UiSkinDiagnosticPrefix, s_UiSkinRgbaField);
            if(!channelResult.has_value())
                return MakeUnexpected(Failure());
            const f32 channel = channelResult.value();
            if(!IsValidUiSkinPaletteChannelValue(channel, cast<u64>(index))){
                error("{} '{}': palette role '{}' needs RGB in [0, 16] and alpha in [0, 1]", s_UiSkinDiagnosticPrefix, PathToString(path), name);
                return MakeUnexpected(Failure());
            }
            components[index] = channel;
        }
        palette.colors[role] = UiSkinColor(components[0u], components[1u], components[2u], components[3u]);
        seen[role] = true;
    }
    return palette;
}

Expected<UiSkinTypography> ParseUiSkinTypography(in Path path, in MetascriptValue asset){
    if(!asset.hasField(s_UiSkinTypographyField)){
        error("{} '{}': skins require typography.default_font_size", s_UiSkinDiagnosticPrefix, PathToString(path));
        return MakeUnexpected(Failure());
    }

    UiSkinTypography typography = UiSkinTypography();
    b8 parsedOk = false;
    asset.visitField(s_UiSkinTypographyField, lambda[in path, mut typography, mut parsedOk](in MetascriptValue section) -> void{
        if(!CheckMetadataAssetMap(path, section, s_UiSkinDiagnosticPrefix) || !ValidateMetadataAssetFields(path, section, s_UiSkinDiagnosticPrefix, lambda[](in StringView field) -> b8{
            return IsAllowedUiSkinTypographyField(field);
        }))
            return;

        const Expected<f32> defaultFontSizeResult = ReadMetadataFiniteF32Field(path, section, s_UiSkinDiagnosticPrefix, s_UiSkinDefaultFontSizeField, true);
        if(!defaultFontSizeResult.has_value())
            return;
        typography.defaultFontSize = defaultFontSizeResult.value();
        if(!IsValidUiSkinDefaultFontSize(typography.defaultFontSize)){
            error("{} '{}': typography.default_font_size must be in [1/64, 2048]", s_UiSkinDiagnosticPrefix, PathToString(path));
            return;
        }
        parsedOk = true;
    });
    if(!parsedOk)
        return MakeUnexpected(Failure());
    return typography;
}

Expected<UiSkinCookHeader> ParseUiSkinCookHeader(in Name virtualPath, in Path nwbFilePath, in MetascriptValue asset){
    UiSkinCookHeader header = UiSkinCookHeader();
    if(!CheckMetadataAssetMap(nwbFilePath, asset, s_UiSkinDiagnosticPrefix))
        return MakeUnexpected(Failure());
    if(!AssignCookEntryVirtualPath(virtualPath, nwbFilePath, s_UiSkinDiagnosticPrefix, header))
        return MakeUnexpected(Failure());
    if(!ValidateMetadataAssetFields(nwbFilePath, asset, s_UiSkinDiagnosticPrefix, lambda[](in StringView field) -> b8{
        return IsAllowedUiSkinMetadataField(field);
    }))
        return MakeUnexpected(Failure());

    const Expected<UiSkinPalette> paletteResult = ParseUiSkinPalette(nwbFilePath, asset);
    if(!paletteResult.has_value())
        return MakeUnexpected(Failure());
    header.palette = paletteResult.value();

    const Expected<UiSkinTypography> typographyResult = ParseUiSkinTypography(nwbFilePath, asset);
    if(!typographyResult.has_value())
        return MakeUnexpected(Failure());
    header.typography = typographyResult.value();

    const Expected<AssetRef<Texture>> textureResult = ReadMetadataAssetRefField<Texture>(nwbFilePath, asset, s_UiSkinDiagnosticPrefix, s_UiSkinTextureField, true);
    if(!textureResult.has_value())
        return MakeUnexpected(Failure());
    header.texture = textureResult.value();

    const Expected<Array<u32, 4>> extentResult = ReadUiSkinU32Components(nwbFilePath, asset, s_UiSkinAtlasExtentField, true, cast<usize>(s_UiSkinAtlasExtentComponentCount));
    if(!extentResult.has_value())
        return MakeUnexpected(Failure());
    in Array<u32, 4> extent = extentResult.value();
    header.atlasWidth = extent[0u];
    header.atlasHeight = extent[1u];

    const Expected<f32> referenceDensityResult = ReadMetadataFiniteF32Field(nwbFilePath, asset, s_UiSkinDiagnosticPrefix, s_UiSkinReferenceDensityField, true);
    if(!referenceDensityResult.has_value())
        return MakeUnexpected(Failure());
    header.referenceDensity = referenceDensityResult.value();

    const Expected<MetadataStringField> toolkitContractResult = ReadMetadataStringField(nwbFilePath, asset, s_UiSkinDiagnosticPrefix, s_UiSkinToolkitContractField, false);
    if(!toolkitContractResult.has_value())
        return MakeUnexpected(Failure());
    const b8 hasToolkitContract = toolkitContractResult.value().present;
    if(hasToolkitContract && toolkitContractResult.value().text != s_UiSkinWidgetsContract){
        error("{} '{}': toolkit_contract must be 'widgets'", s_UiSkinDiagnosticPrefix, PathToString(nwbFilePath));
        return MakeUnexpected(Failure());
    }
    header.completeToolkitSkin = hasToolkitContract;
    return header;
}

Expected<Span<MetascriptValue>> ReadUiSkinRegionsMetadata(in Path nwbFilePath, in MetascriptValue asset){
    const Expected<Span<MetascriptValue>> regionsResult = ReadMetadataListField(nwbFilePath, asset, s_UiSkinDiagnosticPrefix, s_UiSkinRegionsField);
    if(!regionsResult.has_value())
        return MakeUnexpected(regionsResult.error());

    in Span<MetascriptValue> regions = regionsResult.value();
    if(regions.size() > cast<usize>(s_UiSkinMaxRegionCount)){
        error("{} '{}': regions exceed schema limit {}", s_UiSkinDiagnosticPrefix, PathToString(nwbFilePath), s_UiSkinMaxRegionCount);
        return MakeUnexpected(Failure());
    }
    if(regions.empty()){
        error("{} '{}': regions must be nonempty and fit the supported count", s_UiSkinDiagnosticPrefix, PathToString(nwbFilePath));
        return MakeUnexpected(Failure());
    }
    return regions;
}


