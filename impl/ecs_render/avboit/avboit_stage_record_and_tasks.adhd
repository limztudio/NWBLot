#include <impl/ecs_render/kernel/task_timing_telemetry_labels.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_AvboitAccumulationFinalizeLabel = "AVBOIT Accumulation Finalize";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class AvboitPreRecordPolicy{
    public b8 shouldRenderTransparentCsgIntervals(in b8 hasTransparentRenderers, in b8 transparentCsgStreamsUploaded)const{
        return hasTransparentRenderers && transparentCsgStreamsUploaded;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 AvboitPreGraphTaskPayload::record(mut CommandList commandList, in GpuTaskRecordContext context)const{
    // A CSG upload without its frozen stream would detach clears and consumers.
    if(!CanRecordAvboitPrePass(this.transparentCsgStreamsUploaded, this.transparentCsgSnapshot.captured))
        return false;

    GpuTimingTicketRecordingScope timingRecording(this.timingTicket);
    if(AvboitPreRecordPolicy().shouldRenderTransparentCsgIntervals(this.hasTransparentRenderers, this.transparentCsgStreamsUploaded)){
        this.avboitSystem.renderAvboitTransparentCsgIntervals(
            commandList,
            this.targets,
            this.transparentCsgSnapshot.receiverSurfaceDrawItemsView(),
            this.transparentCsgSnapshot.csgFrameDataView(),
            this.csgResources,
            this.frameBindings,
            this.transparentCsgSnapshot.instanceCount,
            this.transparentCsgSnapshot.materialTypedByteCount,
            this.transparentCsgMaterialGeometryStatesGraphOwned,
            this.transparentCsgIntervalsTiming
        );
    }
    return true;
}

b8 AreAvboitDepthWarpResourcesValid(in b8 coverageValid, in b8 depthWarpValid, in b8 controlValid, in b8 currentBindlessSlotsValid){
    return coverageValid && depthWarpValid && controlValid && currentBindlessSlotsValid;
}

b8 AreAvboitIntegrationResourcesValid(in b8 extinctionTaskValid, in b8 extinctionValid, in b8 controlValid, in b8 extinctionOverflowValid, in b8 transmittanceValid, in b8 currentBindlessSlotsValid){
    return extinctionTaskValid && extinctionValid && controlValid && extinctionOverflowValid && transmittanceValid && currentBindlessSlotsValid;
}

GpuTaskSchedulingHint BuildAvboitComputeEffectSchedulingHint(){
    GpuTaskSchedulingHint scheduling;
    scheduling.cost = GpuTaskCostHint::Medium;
    scheduling.forceSubmissionBoundary = false;
    scheduling.allowPacketMerge = true;
    scheduling.mergeWithPrevious = true;
    scheduling.allowMergeAcrossConsumerFrontier = true;
    // Keep each effect in one recording packet while the compiler chooses its queue.
    ConfigureComputeEffectRoutingHint(true, scheduling);
    // Accepted samples use the queue class and exact transport chosen by this compile.
    scheduling.allowTimingFeedbackRouting = true;
    scheduling.allowCrossClassTimingFeedbackRouting = true;
    return scheduling;
}

GpuTaskTimingMetadata BuildAvboitComputeStageTimingMetadata(in AvboitFrameTargets targets){
    GpuTaskTimingMetadata metadata;
    metadata.resolutionClass = ResolveAvboitTimingResolutionClass(targets.lowWidth, targets.lowHeight);
    return metadata;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/avboit/avboit_upload_and_emulation.adhd>

const usize s_AvboitEmulationResourceUseCapacity = s_AvboitEmulationBaseCount + s_AvboitEmulationPlanUseCount;

[cpp_unwind]
b8 DeclareAvboitRasterRecordPhase(mut GpuTaskGraph graph, mut GraphicsRuntime graphics, mut RendererMaterialSystem materialSystem,
    in MeshFrameBindingSnapshot frameBindings, mut ObjectGeometryCacheGraph objectGeometry, in AvboitRasterRecordInputs inputs, in GpuTaskId initialRasterDependency,
    in Span<GpuTaskResourceUse> baseResourceUses, in AvboitRasterRecordPhaseDesc phaseDesc, mut AvboitRasterPassTaskPayload rasterPayload,
    mut AvboitComputeEmulationTaskPayload computeEmulationPayload, in AvboitRasterRecordStageOutputs stageOutputs){
    const b8 generatedGeometryReused = inputs.upload.reusedGeometryProducer.valid();
    if((generatedGeometryReused || inputs.upload.producesReusableGeometry) && (!inputs.upload.regularComputeEmulationPlanCaptured || inputs.upload.csgComputeEmulationPlanCaptured || inputs.upload.sharedComputeEmulationPlanCaptured))
        return false;
    rasterPayload.generatedGeometryReused = generatedGeometryReused;
    stageOutputs.reusedGeometryProducer = inputs.upload.reusedGeometryProducer;

    const b8 streamsUploaded = inputs.upload.streamsUploaded || rasterPayload.streamsUploaded;
    const b8 hasCsgIntervalReads = inputs.upload.csgStreamsUploaded;
    assert(!hasCsgIntervalReads || (rasterPayload.phasePrepared && rasterPayload.snapshot.captured));
    rasterPayload.materialFrameStatesGraphOwned = streamsUploaded;
    rasterPayload.materialGeometryStatesGraphOwned = streamsUploaded && rasterPayload.materialGeometryStatesGraphOwned;

    AvboitComputeEmulationOutputs emulationOutputs;
    if(!PrepareAvboitEmulationOutputs(graph, inputs.upload, phaseDesc, rasterPayload, computeEmulationPayload, inputs.computeEmulationTiming, emulationOutputs))
        return false;
    const auto computeEmulationOutputSet = emulationOutputs.computeEmulationOutputSet;
    const b8 computeEmulationOutputStatesGraphOwned = emulationOutputs.computeEmulationOutputStatesGraphOwned;
    const auto sharedComputeEmulationOutput = emulationOutputs.sharedComputeEmulationOutput;
    const b8 sharedComputeEmulationOutputStatesGraphOwned = emulationOutputs.sharedComputeEmulationOutputStatesGraphOwned;

    const BufferRange instanceRange = BufferRange(0u, rasterPayload.snapshot.instanceCount * size_of<InstanceGpuData>());
    const BufferRange materialTypedRange = BufferRange(0u, rasterPayload.snapshot.materialTypedByteCount);
    const BufferRange receiverRange = BufferRange(0u, rasterPayload.snapshot.csgFrameDataView().receiverRanges.size() * size_of<CsgReceiverRangeGpuData>());
    const BufferRange cutterRange = BufferRange(0u, rasterPayload.snapshot.csgFrameDataView().cutters.size() * size_of<CsgCutterGpuData>());

    Vector<GpuTaskResourceUse> resourceUses;
    usize capacity = phaseDesc.resourceBaseCapacity;
    if(streamsUploaded)
        capacity += s_AvboitStreamUseCount;
    if(hasCsgIntervalReads)
        capacity += s_AvboitCsgIntervalUseCount;
    resourceUses.reserve(capacity);
    for(in GpuTaskResourceUse use : baseResourceUses)
        resourceUses.push_back(use);
    if(streamsUploaded){
        resourceUses.push_back(ReadUse(inputs.resources.meshView, ResourceStates::ConstantBuffer));
        resourceUses.push_back(ReadBufferUse(inputs.resources.materialInstances, instanceRange));
        resourceUses.push_back(ReadBufferUse(inputs.resources.materialTyped, materialTypedRange));
        if(inputs.upload.csgStreamsUploaded){
            resourceUses.push_back(ReadBufferUse(inputs.resources.csgReceiverRanges, receiverRange));
            resourceUses.push_back(ReadBufferUse(inputs.resources.csgCutters, cutterRange));
            resourceUses.push_back(ReadUse(inputs.resources.csgClipContextSlots, ResourceStates::ConstantBuffer));
            resourceUses.push_back(ReadUse(inputs.resources.csgIntervalSampleState, ResourceStates::ConstantBuffer));
        }
    }
    if(hasCsgIntervalReads){
        resourceUses.push_back(ReadTextureUse(inputs.resources.csgRemovedIntervalDepth, inputs.resources.csgRemovedIntervalSubresources, ResourceStates::UnorderedAccess));
        resourceUses.push_back(ReadTextureUse(inputs.resources.csgRemovedIntervalCapNormal, inputs.resources.csgRemovedIntervalSubresources, ResourceStates::UnorderedAccess));
        resourceUses.push_back(ReadTextureUse(inputs.resources.csgRemovedIntervalData, inputs.resources.csgRemovedIntervalSubresources, ResourceStates::UnorderedAccess));
        resourceUses.push_back(ReadTextureUse(inputs.resources.csgRemovedIntervalCount, inputs.resources.csgRemovedIntervalCountSubresources, ResourceStates::UnorderedAccess));
    }
    const GpuTaskResourceSetUse materialGeometrySetUse = MakeResourceSetUse(inputs.upload.materialGeometrySet, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
    const GpuTaskResourceSetUse materialSampledTextureSetUse = MakeResourceSetUse(inputs.upload.materialSampledTextureSet, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
    const GpuTaskResourceSetUse computeEmulationOutputUavSetUse = MakeResourceSetUse(computeEmulationOutputSet, ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write);
    const GpuTaskResourceSetUse computeEmulationOutputVertexBufferSetUse = MakeResourceSetUse(computeEmulationOutputSet, s_ObjectGeometryRasterState, GpuTaskResourceAccess::Read);
    FixedVector<GpuTaskResourceSetUse, s_AvboitMaterialResourceSetUseCapacity> materialResourceSetUses;
    if(rasterPayload.materialGeometryStatesGraphOwned)
        materialResourceSetUses.push_back(materialGeometrySetUse);
    if(inputs.upload.materialSampledTextureSet.valid())
        materialResourceSetUses.push_back(materialSampledTextureSetUse);
    if(computeEmulationOutputStatesGraphOwned)
        materialResourceSetUses.push_back(computeEmulationOutputVertexBufferSetUse);
    resourceUses.push_back(ReadUse(inputs.resources.currentBindlessSlots, ResourceStates::ConstantBuffer));
    resourceUses.push_back(ReadUse(inputs.resources.avboitMaterialDomain));
    resourceUses.push_back(ReadUse(inputs.resources.avboitCsgDomain));

    // Keep the final upload as stream anchor; replacing it hides a broken producer handoff.
    if(streamsUploaded)
        stageOutputs.streamTask = inputs.upload.uploadTask;
    GpuTaskId rasterDependency = initialRasterDependency;
    if(streamsUploaded && !objectGeometry.prepare(rasterPayload.snapshot.regular.indexedDrawItems, frameBindings, rasterDependency, resourceUses, GraphicsPrefixTimingTicket(inputs.timingTicket), Optional<in GraphicsPrefixTimingTicket>()))
        return false;
    if(streamsUploaded && !objectGeometry.prepare(rasterPayload.snapshot.csg.indexedDrawItems, frameBindings, rasterDependency, resourceUses, GraphicsPrefixTimingTicket(inputs.timingTicket), Optional<in GraphicsPrefixTimingTicket>()))
        return false;

    GpuTaskSchedulingHint rasterScheduling;
    rasterScheduling.cost = GpuTaskCostHint::Large;
    rasterScheduling.forceSubmissionBoundary = false;
    rasterScheduling.allowPacketMerge = true;
    rasterScheduling.mergeWithPrevious = true;
    rasterScheduling.allowMergeAcrossConsumerFrontier = true;

    if(computeEmulationOutputStatesGraphOwned && !generatedGeometryReused){
        computeEmulationPayload.conservativeGeometryScissor = inputs.upload.producesReusableGeometry;
        computeEmulationPayload.instanceCount = rasterPayload.snapshot.instanceCount;
        computeEmulationPayload.materialTypedByteCount = rasterPayload.snapshot.materialTypedByteCount;
        computeEmulationPayload.materialDrawBuffersUploaded = streamsUploaded;
        computeEmulationPayload.csgFrameBuffersUploaded = inputs.upload.csgStreamsUploaded;
        computeEmulationPayload.materialFrameStatesGraphOwned = rasterPayload.materialFrameStatesGraphOwned;
        computeEmulationPayload.materialGeometryStatesGraphOwned = rasterPayload.materialGeometryStatesGraphOwned;

        FixedVector<GpuTaskResourceUse, s_AvboitEmulationResourceUseCapacity> computeEmulationResourceUses;
        computeEmulationResourceUses.push_back(ReadUse(inputs.resources.meshView, ResourceStates::ConstantBuffer));
        computeEmulationResourceUses.push_back(ReadBufferUse(inputs.resources.materialInstances, instanceRange));
        computeEmulationResourceUses.push_back(ReadBufferUse(inputs.resources.materialTyped, materialTypedRange));
        computeEmulationResourceUses.push_back(ReadUse(inputs.resources.currentBindlessSlots, ResourceStates::ConstantBuffer));
        if(inputs.upload.csgComputeEmulationPlanCaptured){
            computeEmulationResourceUses.push_back(ReadBufferUse(inputs.resources.csgReceiverRanges, receiverRange));
            computeEmulationResourceUses.push_back(ReadBufferUse(inputs.resources.csgCutters, cutterRange));
            computeEmulationResourceUses.push_back(ReadUse(inputs.resources.csgClipContextSlots, ResourceStates::ConstantBuffer));
            computeEmulationResourceUses.push_back(ReadUse(inputs.resources.csgIntervalSampleState, ResourceStates::ConstantBuffer));
            computeEmulationResourceUses.push_back(ReadTextureUse(inputs.resources.csgRemovedIntervalDepth, inputs.resources.csgRemovedIntervalSubresources, ResourceStates::UnorderedAccess));
            computeEmulationResourceUses.push_back(ReadTextureUse(inputs.resources.csgRemovedIntervalCapNormal, inputs.resources.csgRemovedIntervalSubresources, ResourceStates::UnorderedAccess));
            computeEmulationResourceUses.push_back(ReadTextureUse(inputs.resources.csgRemovedIntervalData, inputs.resources.csgRemovedIntervalSubresources, ResourceStates::UnorderedAccess));
            computeEmulationResourceUses.push_back(ReadTextureUse(inputs.resources.csgRemovedIntervalCount, inputs.resources.csgRemovedIntervalCountSubresources, ResourceStates::UnorderedAccess));
        }
        FixedVector<GpuTaskResourceSetUse, s_AvboitComputeEmulationResourceSetUseCapacity> computeEmulationResourceSetUses;
        computeEmulationResourceSetUses.push_back(materialGeometrySetUse);
        if(inputs.upload.materialSampledTextureSet.valid())
            computeEmulationResourceSetUses.push_back(materialSampledTextureSetUse);
        computeEmulationResourceSetUses.push_back(computeEmulationOutputUavSetUse);

        GpuTaskSchedulingHint computeEmulationScheduling;
        computeEmulationScheduling.cost = GpuTaskCostHint::Medium;
        computeEmulationScheduling.forceSubmissionBoundary = false;
        computeEmulationScheduling.allowPacketMerge = true;
        computeEmulationScheduling.mergeWithPrevious = true;
        computeEmulationScheduling.allowMergeAcrossConsumerFrontier = true;
        GpuTaskDesc computeEmulationDesc;
        if(inputs.upload.csgComputeEmulationPlanCaptured)
            computeEmulationDesc.setIdentity(phaseDesc.csgComputeEmulationIdentity).setMarkerLabel(phaseDesc.csgComputeEmulationLabel);
        else
            computeEmulationDesc.setIdentity(phaseDesc.regularComputeEmulationIdentity).setMarkerLabel(phaseDesc.regularComputeEmulationLabel);
        computeEmulationDesc
            .setScheduling(computeEmulationScheduling)
            .setDependency(rasterDependency)
            .setResourceUses(computeEmulationResourceUses)
            .setResourceSetUses(computeEmulationResourceSetUses)
        ;
        const auto computeEmulationTaskResult = graph.addPreparedPayloadTask(computeEmulationDesc, computeEmulationPayload);
        if(!computeEmulationTaskResult.has_value()){
            stageOutputs.computeEmulationTask = GpuTaskId();
            warning("RendererSystem: could not declare AVBOIT compute-emulation producer");
            return false;
        }
        stageOutputs.computeEmulationTask = computeEmulationTaskResult.value();
        rasterDependency = stageOutputs.computeEmulationTask;
        rasterScheduling.allowMergeAcrossConsumerFrontier = true;
    }

    if(sharedComputeEmulationOutputStatesGraphOwned){
        const Array<GpuTaskResourceUse, 5u> sharedGenerateResourceUses(
        ReadUse(inputs.resources.meshView, ResourceStates::ConstantBuffer),
            ReadBufferUse(inputs.resources.materialInstances, instanceRange),
            ReadBufferUse(inputs.resources.materialTyped, materialTypedRange),
            ReadUse(inputs.resources.currentBindlessSlots, ResourceStates::ConstantBuffer),
            WriteUse(sharedComputeEmulationOutput, ResourceStates::UnorderedAccess)
    );

        Vector<GpuTaskResourceUse> sharedRasterResourceUses;
        sharedRasterResourceUses.reserve(resourceUses.size() + 1u);
        for(in GpuTaskResourceUse use : resourceUses)
            sharedRasterResourceUses.push_back(use);
        sharedRasterResourceUses.push_back(ReadUse(sharedComputeEmulationOutput, s_ObjectGeometryRasterState));

        const usize sharedPhaseCount = SharedComputeEmulationPhaseCountForDrawCount(inputs.upload.sharedComputeEmulationPlan.drawCount);
        assert(IsSupportedSharedComputeEmulationDrawCount(inputs.upload.sharedComputeEmulationPlan.drawCount));
        assert(sharedPhaseCount <= phaseDesc.sharedPhaseIdentities.size());
        assert(sharedPhaseCount <= phaseDesc.sharedPhaseLabels.size());
        assert(sharedPhaseCount <= LengthOf(stageOutputs.sharedComputeEmulationTasks));
        GpuTaskId sharedDependency = rasterDependency;
        const Span<GpuTaskResourceSetUse> materialResourceSetUseSpan = materialResourceSetUses;
        for(usize phaseIndex = 0u; phaseIndex < sharedPhaseCount; ++phaseIndex){
            const b8 isRasterPhase = phaseIndex % s_SharedComputeEmulationPhasesPerDraw != 0u;
            GpuTaskDesc desc;
            Span<GpuTaskResourceUse> phaseUses = sharedGenerateResourceUses;
            if(isRasterPhase)
                phaseUses = sharedRasterResourceUses;
            MakeSharedComputeEmulationPhaseTaskDesc(
                phaseDesc.sharedPhaseIdentities[phaseIndex],
                phaseDesc.sharedPhaseLabels[phaseIndex],
                sharedDependency,
                phaseUses,
                materialResourceSetUseSpan,
                desc
            );
            AvboitSharedComputeEmulationTaskPayload payload(graphics, materialSystem, inputs.targets, inputs.timingTicket, inputs.computeEmulationTiming, rasterPayload.pass);
            payload.frameBindings = frameBindings;
            payload.plan = inputs.upload.sharedComputeEmulationPlan;
            payload.drawIndex = phaseIndex / s_SharedComputeEmulationPhasesPerDraw;
            payload.instanceCount = inputs.upload.sharedComputeEmulationInstanceCount;
            payload.materialTypedByteCount = inputs.upload.sharedComputeEmulationMaterialTypedByteCount;
            payload.materialDrawBuffersUploaded = streamsUploaded;
            payload.materialFrameStatesGraphOwned = rasterPayload.materialFrameStatesGraphOwned;
            payload.materialGeometryStatesGraphOwned = rasterPayload.materialGeometryStatesGraphOwned;
            payload.beginTiming = phaseIndex == 0u;
            payload.finishTiming = phaseIndex + 1u == sharedPhaseCount;
            payload.phase = SharedComputeEmulationPhase::Generate;
            if(isRasterPhase)
                payload.phase = SharedComputeEmulationPhase::Raster;
            const auto sharedTaskResult = graph.addPreparedPayloadTask(desc, payload);
            if(!sharedTaskResult.has_value()){
                stageOutputs.sharedComputeEmulationTasks[phaseIndex] = GpuTaskId();
                warning("RendererSystem: could not declare AVBOIT shared compute-emulation phase");
                return false;
            }
            stageOutputs.sharedComputeEmulationTasks[phaseIndex] = sharedTaskResult.value();
            sharedDependency = stageOutputs.sharedComputeEmulationTasks[phaseIndex];
        }
        stageOutputs.sharedComputeEmulationTaskCount = sharedPhaseCount;
        stageOutputs.rasterTask = sharedDependency;
        return true;
    }

    FixedVector<GpuTaskId, 2u> rasterDependencies;
    rasterDependencies.push_back(rasterDependency);
    if(generatedGeometryReused && inputs.upload.reusedGeometryProducer != rasterDependency)
        rasterDependencies.push_back(inputs.upload.reusedGeometryProducer);
    GpuTaskDesc rasterDesc;
    rasterDesc
        .setIdentity(phaseDesc.rasterIdentity)
        .setMarkerLabel(phaseDesc.rasterLabel)
        .setScheduling(rasterScheduling)
        .setDependencies(rasterDependencies)
        .setResourceUses(resourceUses)
        .setResourceSetUses(materialResourceSetUses)
    ;
    const auto rasterTaskResult = graph.addPreparedPayloadTask(rasterDesc, rasterPayload);
    if(!rasterTaskResult.has_value()){
        stageOutputs.rasterTask = GpuTaskId();
        warning("RendererSystem: could not declare deferred AVBOIT raster graph task");
        return false;
    }
    stageOutputs.rasterTask = rasterTaskResult.value();
    return true;
}

[cpp_unwind]
b8 DeclareAvboitOccupancyRecord(mut GpuTaskGraph graph, mut GraphicsRuntime graphics, mut RendererMaterialSystem materialSystem, mut RendererAvboitSystem avboitSystem,
    in MeshFrameBindingSnapshot frameBindings, mut ObjectGeometryCacheGraph objectGeometry, in AvboitRasterRecordInputs inputs,
    mut AvboitRasterPassTaskPayload occupancyPayload, mut AvboitComputeEmulationTaskPayload computeEmulationPayload){
    if(!AvboitStageRecordDependencyPolicy().canDeclareRasterRecordPhase(inputs.predecessor.valid(), inputs.upload.uploadTask.valid()))
        return false;

    const Array<GpuTaskResourceUse, 7u> baseResourceUses(
        ReadUse(inputs.resources.albedo),
        ReadUse(inputs.resources.normal, ResourceStates::ShaderResource),
        ReadUse(inputs.resources.worldPosition, ResourceStates::ShaderResource),
        ReadUse(inputs.resources.depth),
        ReadUse(inputs.resources.refractionInstance),
        ReadWriteUse(inputs.resources.avboitLowRaster, ResourceStates::RenderTarget),
        ReadWriteUse(inputs.resources.avboitCoverage, ResourceStates::UnorderedAccess)
    );
    const SharedComputeEmulationPhaseTable sharedPhases = AvboitOccupancySharedComputeEmulationPhases();

    AvboitRasterRecordPhaseDesc phaseDesc;
    phaseDesc.regularOutputSetLabel = "AVBOIT Occupancy Compute Emulation Outputs";
    phaseDesc.csgOutputSetLabel = "AVBOIT Occupancy CSG Compute Emulation Outputs";
    phaseDesc.sharedOutputLabel = "AVBOIT Occupancy Shared Compute Emulation Output";
    phaseDesc.regularComputeEmulationLabel = "AVBOIT Occupancy Compute Emulation";
    phaseDesc.csgComputeEmulationLabel = "AVBOIT Occupancy CSG Compute Emulation";
    phaseDesc.regularOutputSetIdentity = Name("render.avboit.occupancy.compute_emulation.outputs");
    phaseDesc.csgOutputSetIdentity = Name("render.avboit.occupancy.csg_compute_emulation.outputs");
    phaseDesc.regularComputeEmulationIdentity = Name("render.avboit.occupancy.compute_emulation");
    phaseDesc.csgComputeEmulationIdentity = Name("render.avboit.occupancy.csg_compute_emulation");
    phaseDesc.sharedPhaseIdentities = sharedPhases.identities;
    phaseDesc.sharedPhaseLabels = sharedPhases.markers;
    phaseDesc.rasterIdentity = Name(s_RenderIdentityRenderAvboitPre);
    phaseDesc.rasterLabel = "AVBOIT Pre";
    phaseDesc.resourceBaseCapacity = s_AvboitOccupancyResourceBaseCount;
    mut RendererAvboitTaskGraphStageState stage = avboitSystem.taskGraphStage();
    return DeclareAvboitRasterRecordPhase(
        graph,
        graphics,
        materialSystem,
        frameBindings,
        objectGeometry,
        inputs,
        inputs.predecessor,
        baseResourceUses,
        phaseDesc,
        occupancyPayload,
        computeEmulationPayload,
        AvboitRasterRecordStageOutputs(stage.m_occupancyReusedGeometryProducer, stage.m_occupancyStreamTask, stage.m_occupancyComputeEmulationTask, stage.m_occupancySharedComputeEmulationTasks,
            stage.m_occupancySharedComputeEmulationTaskCount, stage.m_occupancyTask));
}

[cpp_unwind]
b8 DeclareAvboitExtinctionRecord(mut GpuTaskGraph graph, mut GraphicsRuntime graphics, mut RendererMaterialSystem materialSystem, mut RendererAvboitSystem avboitSystem,
    in MeshFrameBindingSnapshot frameBindings, mut ObjectGeometryCacheGraph objectGeometry, in AvboitRasterRecordInputs inputs,
    mut AvboitRasterPassTaskPayload extinctionPayload, mut AvboitComputeEmulationTaskPayload computeEmulationPayload){
    if(!AvboitStageRecordDependencyPolicy().canDeclareRasterRecordPhase(inputs.predecessor.valid(), inputs.upload.uploadTask.valid()))
        return false;

    const Array<GpuTaskResourceUse, 10u> baseResourceUses(
        ReadUse(inputs.resources.albedo),
        ReadUse(inputs.resources.refractionInstance),
        ReadUse(inputs.resources.normal, ResourceStates::ShaderResource),
        ReadUse(inputs.resources.worldPosition, ResourceStates::ShaderResource),
        ReadUse(inputs.resources.depth),
        ReadWriteUse(inputs.resources.avboitLowRaster, ResourceStates::RenderTarget),
        ReadUse(inputs.resources.avboitDepthWarp),
        ReadUse(inputs.resources.avboitControl),
        ReadWriteUse(inputs.resources.avboitExtinction, ResourceStates::UnorderedAccess),
        ReadWriteUse(inputs.resources.avboitExtinctionOverflow, ResourceStates::UnorderedAccess)
    );
    const SharedComputeEmulationPhaseTable sharedPhases = AvboitExtinctionSharedComputeEmulationPhases();

    AvboitRasterRecordPhaseDesc phaseDesc;
    phaseDesc.regularOutputSetLabel = "AVBOIT Extinction Compute Emulation Outputs";
    phaseDesc.csgOutputSetLabel = "AVBOIT Extinction CSG Compute Emulation Outputs";
    phaseDesc.sharedOutputLabel = "AVBOIT Extinction Shared Compute Emulation Output";
    phaseDesc.regularComputeEmulationLabel = "AVBOIT Extinction Compute Emulation";
    phaseDesc.csgComputeEmulationLabel = "AVBOIT Extinction CSG Compute Emulation";
    phaseDesc.regularOutputSetIdentity = Name("render.avboit.extinction.compute_emulation.outputs");
    phaseDesc.csgOutputSetIdentity = Name("render.avboit.extinction.csg_compute_emulation.outputs");
    phaseDesc.regularComputeEmulationIdentity = Name("render.avboit.extinction.compute_emulation");
    phaseDesc.csgComputeEmulationIdentity = Name("render.avboit.extinction.csg_compute_emulation");
    phaseDesc.sharedPhaseIdentities = sharedPhases.identities;
    phaseDesc.sharedPhaseLabels = sharedPhases.markers;
    phaseDesc.rasterIdentity = Name(s_AvboitExtinctionName);
    phaseDesc.rasterLabel = s_AvboitExtinctionLabel;
    phaseDesc.resourceBaseCapacity = s_AvboitResourceBaseCount;
    mut RendererAvboitTaskGraphStageState stage = avboitSystem.taskGraphStage();
    return DeclareAvboitRasterRecordPhase(
        graph,
        graphics,
        materialSystem,
        frameBindings,
        objectGeometry,
        inputs,
        inputs.upload.uploadTask,
        baseResourceUses,
        phaseDesc,
        extinctionPayload,
        computeEmulationPayload,
        AvboitRasterRecordStageOutputs(stage.m_extinctionReusedGeometryProducer, stage.m_extinctionStreamTask, stage.m_extinctionComputeEmulationTask, stage.m_extinctionSharedComputeEmulationTasks,
            stage.m_extinctionSharedComputeEmulationTaskCount, stage.m_extinctionTask));
}

[cpp_unwind]
b8 DeclareAvboitAccumulationRecord(mut GpuTaskGraph graph, mut GraphicsRuntime graphics, mut RendererMaterialSystem materialSystem, mut RendererAvboitSystem avboitSystem,
    in MeshFrameBindingSnapshot frameBindings, mut ObjectGeometryCacheGraph objectGeometry, in AvboitRasterRecordInputs inputs,
    mut AvboitRasterPassTaskPayload accumulationPayload, mut AvboitComputeEmulationTaskPayload computeEmulationPayload){
    if(!AvboitStageRecordDependencyPolicy().canDeclareRasterRecordPhase(inputs.predecessor.valid(), inputs.upload.uploadTask.valid()))
        return false;

    const Array<GpuTaskResourceUse, 13u> baseResourceUses(
        ReadUse(inputs.resources.albedo),
        ReadUse(inputs.resources.normal, ResourceStates::ShaderResource),
        ReadUse(inputs.resources.worldPosition, ResourceStates::ShaderResource),
        ReadUse(inputs.resources.depth, ResourceStates::DepthRead),
        ReadUse(inputs.resources.avboitTransmittance),
        ReadUse(inputs.resources.avboitDepthWarp),
        ReadUse(inputs.resources.avboitControl),
        ReadUse(inputs.resources.refractionInstance),
        ReadUse(inputs.resources.refractionDepth),
        ReadWriteUse(inputs.resources.avboitForegroundColor, ResourceStates::RenderTarget),
        ReadWriteUse(inputs.resources.avboitForegroundExtinction, ResourceStates::RenderTarget),
        ReadWriteUse(inputs.resources.avboitAccumColor, ResourceStates::RenderTarget),
        ReadWriteUse(inputs.resources.avboitAccumExtinction, ResourceStates::RenderTarget)
    );
    const SharedComputeEmulationPhaseTable sharedPhases = AvboitAccumulationSharedComputeEmulationPhases();

    AvboitRasterRecordPhaseDesc phaseDesc;
    phaseDesc.regularOutputSetLabel = "AVBOIT Accumulation Compute Emulation Outputs";
    phaseDesc.csgOutputSetLabel = "AVBOIT Accumulation CSG Compute Emulation Outputs";
    phaseDesc.sharedOutputLabel = "AVBOIT Accumulation Shared Compute Emulation Output";
    phaseDesc.regularComputeEmulationLabel = "AVBOIT Accumulation Compute Emulation";
    phaseDesc.csgComputeEmulationLabel = "AVBOIT Accumulation CSG Compute Emulation";
    phaseDesc.regularOutputSetIdentity = Name("render.avboit.accumulation.compute_emulation.outputs");
    phaseDesc.csgOutputSetIdentity = Name("render.avboit.accumulation.csg_compute_emulation.outputs");
    phaseDesc.regularComputeEmulationIdentity = Name("render.avboit.accumulation.compute_emulation");
    phaseDesc.csgComputeEmulationIdentity = Name("render.avboit.accumulation.csg_compute_emulation");
    phaseDesc.sharedPhaseIdentities = sharedPhases.identities;
    phaseDesc.sharedPhaseLabels = sharedPhases.markers;
    phaseDesc.rasterIdentity = Name(s_RenderIdentityRenderAvboitAccumulation);
    phaseDesc.rasterLabel = "AVBOIT Accumulation";
    phaseDesc.resourceBaseCapacity = s_AvboitResourceBaseCount;
    mut RendererAvboitTaskGraphStageState stage = avboitSystem.taskGraphStage();
    if(!DeclareAvboitRasterRecordPhase(
        graph,
        graphics,
        materialSystem,
        frameBindings,
        objectGeometry,
        inputs,
        inputs.upload.uploadTask,
        baseResourceUses,
        phaseDesc,
        accumulationPayload,
        computeEmulationPayload,
        AvboitRasterRecordStageOutputs(stage.m_accumulationReusedGeometryProducer, stage.m_accumulationStreamTask, stage.m_accumulationComputeEmulationTask, stage.m_accumulationSharedComputeEmulationTasks,
            stage.m_accumulationSharedComputeEmulationTaskCount, stage.m_accumulationTask)))
        return false;

    const Array<GpuTaskResourceUse, 5u> accumulationFinalizeResourceUses(
        ReadUse(inputs.resources.avboitAccumColor, ResourceStates::ShaderResource),
        ReadUse(inputs.resources.avboitForegroundColor),
        ReadUse(inputs.resources.avboitForegroundExtinction),
        ReadUse(inputs.resources.avboitAccumExtinction, ResourceStates::ShaderResource),
        ReadUse(inputs.resources.depth, ResourceStates::ShaderResource)
    );
    GpuTaskSchedulingHint accumulationFinalizeScheduling;
    accumulationFinalizeScheduling.cost = GpuTaskCostHint::Tiny;
    accumulationFinalizeScheduling.forceSubmissionBoundary = false;
    accumulationFinalizeScheduling.allowPacketMerge = true;
    accumulationFinalizeScheduling.mergeWithPrevious = true;
    // Finalizer is Accumulation's tail; retain its timing/acceptance packet before Lighting.
    accumulationFinalizeScheduling.allowMergeAcrossConsumerFrontier = true;
    GpuTaskDesc accumulationFinalizeDesc;
    accumulationFinalizeDesc
        .setIdentity(s_RenderIdentityRenderAvboitAccumulationFinalize)
        .setMarkerLabel(s_AvboitAccumulationFinalizeLabel)
        .setScheduling(accumulationFinalizeScheduling)
        .setDependency(stage.m_accumulationTask)
        .setResourceUses(accumulationFinalizeResourceUses)
    ;
    const auto accumulationFinalizeTaskResult = graph.addPayloadTask(accumulationFinalizeDesc, BarrierOnlyGraphTask());
    if(!accumulationFinalizeTaskResult.has_value()){
        stage.m_accumulationFinalizeTask = GpuTaskId();
        warning("RendererSystem: could not declare AVBOIT accumulation finalizer graph task");
        return false;
    }
    stage.m_accumulationFinalizeTask = accumulationFinalizeTaskResult.value();
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<AvboitDepthWarpStageResult> AvboitComputeEffectChainBuilder::declareDepthWarp(mut AvboitDepthWarpStageInputs inputs){
    if(!inputs.occupancyTask.valid())
        return MakeUnexpected(Failure());
    AvboitDepthWarpStageResult result;
    result.completionTask = inputs.occupancyTask;
    if(!inputs.hasTransparentRenderers)
        return result;
    if(!AreAvboitDepthWarpResourcesValid(inputs.coverage.valid(), inputs.depthWarp.valid(), inputs.control.valid(), inputs.currentBindlessSlots.valid()))
        return MakeUnexpected(Failure());

    const Array<GpuTaskResourceUse, 4u> uses = Array<GpuTaskResourceUse, 4u>(
        ReadUse(inputs.coverage, ResourceStates::UnorderedAccess),
        ReadWriteUse(inputs.depthWarp, ResourceStates::UnorderedAccess),
        ReadWriteUse(inputs.control, ResourceStates::UnorderedAccess),
        ReadUse(inputs.currentBindlessSlots, ResourceStates::ConstantBuffer)
    );
    GpuTaskDesc desc;
    desc.setIdentity(Name(s_AvboitDepthWarpName)).setMarkerLabel(s_AvboitDepthWarpLabel)
        .setScheduling(BuildAvboitComputeEffectSchedulingHint()).setTiming(BuildAvboitComputeStageTimingMetadata(inputs.targets))
        .setDependency(inputs.occupancyTask).setResourceUses(uses);
    const auto task = this.m_graph.addPayloadTask(desc, AvboitComputeEffectGraphTask(this.m_avboitSystem, inputs.targets, inputs.depthWarpTimingTicket,
        Optional<mut RendererTaskTimingFeedback>(inputs.timingFeedback), Optional<in GpuTimingScopeDefinition>(s_TimingScopeAvboitDepthWarp), AvboitComputeEffect::DepthWarp));
    if(!task.has_value()){
        this.m_avboitSystem.taskGraphStage().m_depthWarpTask = GpuTaskId();
        warning("RendererSystem: could not declare deferred AVBOIT depth-warp graph task");
        return MakeUnexpected(Failure());
    }
    this.m_avboitSystem.taskGraphStage().m_depthWarpTask = task.value();
    result.completionTask = task.value();
    return result;
}

b8 AvboitComputeEffectChainBuilder::declareIntegration(mut AvboitIntegrationStageInputs inputs){
    if(!AreAvboitIntegrationResourcesValid(inputs.extinctionTask.valid(), inputs.extinction.valid(), inputs.control.valid(), inputs.extinctionOverflow.valid(),
        inputs.transmittance.valid(), inputs.currentBindlessSlots.valid()))
        return false;
    const Array<GpuTaskResourceUse, 5u> uses = Array<GpuTaskResourceUse, 5u>(
        ReadUse(inputs.extinction), ReadUse(inputs.control), ReadUse(inputs.extinctionOverflow),
        ReadWriteUse(inputs.transmittance, ResourceStates::UnorderedAccess), ReadUse(inputs.currentBindlessSlots, ResourceStates::ConstantBuffer)
    );
    GpuTaskDesc desc;
    desc.setIdentity(Name(s_RenderIdentityRenderAvboitIntegration)).setMarkerLabel(s_AvboitIntegrationLabel)
        .setScheduling(BuildAvboitComputeEffectSchedulingHint()).setTiming(BuildAvboitComputeStageTimingMetadata(inputs.targets))
        .setDependency(inputs.extinctionTask).setResourceUses(uses);
    const auto task = this.m_graph.addPayloadTask(desc, AvboitComputeEffectGraphTask(this.m_avboitSystem, inputs.targets, inputs.integrationTimingTicket,
        Optional<mut RendererTaskTimingFeedback>(inputs.timingFeedback), Optional<in GpuTimingScopeDefinition>(s_TimingScopeAvboitIntegration), AvboitComputeEffect::Integration));
    if(!task.has_value()){
        this.m_avboitSystem.taskGraphStage().m_integrationTask = GpuTaskId();
        warning("RendererSystem: could not declare deferred AVBOIT integration graph task");
        return false;
    }
    this.m_avboitSystem.taskGraphStage().m_integrationTask = task.value();
    return true;
}


