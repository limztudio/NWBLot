Expected<PhysicsMaterialCookEntry> ParsePhysicsMaterialCookMetadata(in Path root, in StringView virtualRoot, in Path file, in MetascriptDocument document){
    return ParseCookMetadataDocument<PhysicsMaterialCookEntry>(root, virtualRoot, file, document, s_PhysicsMaterialDiagnosticPrefix, lambda[in file](in Name path, in MetascriptValue value) -> Expected<PhysicsMaterialCookEntry>{
        return ParsePhysicsMaterialCookMetadata(path, file, value);
    });
}

Expected<PhysicsMaterialAsset> BuildPhysicsMaterialAsset(in PhysicsMaterialCookEntry entry){
    PhysicsMaterialAsset asset(entry.virtualPath);
    asset.setMaterial(entry.material);
    if(!asset.validatePayload())
        return MakeUnexpected(Failure());
    return asset;
}

