////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Same-host tooling format; magic/version reject incompatible layouts.
const u32 s_GpuCommandIrStreamMagic = 0x4E574349u; // NWCI
const u16 s_GpuCommandIrStreamVersion = 5u;


const usize s_GpuCommandIrStreamHeaderPrefixByteSize = 8u;
const usize s_GpuCommandIrStreamHeaderByteSize = 48u;
const usize s_GpuCommandIrHeaderByteSize = 4u;
const usize s_GpuCommandIrRecordContextByteSize = 12u;
const usize s_GpuCommandIrTextureSliceByteSize = 32u;
const usize s_GpuCommandIrTextureSubresourceSetByteSize = 16u;
const usize s_GpuCommandIrRectByteSize = 16u;
const usize s_GpuCommandIrCopyBufferRecordByteSize = 48u;
const usize s_GpuCommandIrCopyTextureRecordByteSize = 88u;
const usize s_GpuCommandIrClearBufferRecordByteSize = 24u;
const usize s_GpuCommandIrClearTextureRecordByteSize = 92u;
const usize s_GpuCommandIrClearTextureRectUIntRecordByteSize = 68u;
const usize s_GpuCommandIrUploadBufferRecordByteSize = 56u;
const usize s_GpuCommandIrUploadTextureRecordByteSize = 96u;
const usize s_CommandIrPackedAlignBytes = 1u;
const usize s_GpuCommandIrGraphicsStateRecordBytes = 112u;
const usize s_GpuCommandIrDrawRecordBytes = 36u;
const u8 s_GpuCommandIrOpcodeCopyBufferBaseValue = 0u;
const u8 s_GpuCommandIrClearTextureFlagNoneBaseValue = 0u;


[serialize]
class GpuCommandIrTextureSubresourceSet{
    public u32 baseMipLevel = 0u;
    public u32 numMipLevels = 1u;
    public u32 baseArraySlice = 0u;
    public u32 numArraySlices = 1u;
}


[serialize]
class GpuCommandIrRect{
    public i32 minX = 0;
    public i32 maxX = 0;
    public i32 minY = 0;
    public i32 maxY = 0;
}


[serialize]
class GpuCommandIrFloatColor{
    public f32 r = 0.0f;
    public f32 g = 0.0f;
    public f32 b = 0.0f;
    public f32 a = 0.0f;
}


[serialize]
class GpuCommandIrUIntColor{
    public u32 r = 0u;
    public u32 g = 0u;
    public u32 b = 0u;
    public u32 a = 0u;
}


[serialize]
class GpuCommandIrIntColor{
    public i32 r = 0;
    public i32 g = 0;
    public i32 b = 0;
    public i32 a = 0;
}


[serialize]
class GpuCommandIrStreamHeaderPrefix{
    public u32 magic = s_GpuCommandIrStreamMagic;
    public u16 version = s_GpuCommandIrStreamVersion;
    public u16 reserved = 0u;
}


// Graph and packet handles use distinct generations.
[serialize]
class GpuCommandIrStreamHeader{
    public u32 magic = s_GpuCommandIrStreamMagic;
    public u16 version = s_GpuCommandIrStreamVersion;
    public u16 reserved = 0u;
    public u64 graphGeneration = 0u;
    public u64 planGeneration = 0u;
    public u64 recordCount = 0u;
    public u64 commandBytes = 0u;
    public u64 blobBytes = 0u;
}


// Records target the header generations; queue generation stays command-local.
[serialize]
class GpuCommandIrRecordContext{
    public u32 taskIndex = s_MaxU32;
    public u32 packetIndex = s_MaxU32;
    public u16 queueIndex = s_MaxU16;
    public u16 queueDeviceGeneration = 0u;
}


[serialize]
class GpuCommandIrTextureSlice{
    public u32 x = 0u;
    public u32 y = 0u;
    public u32 z = 0u;
    public u32 width = s_MaxU32;
    public u32 height = s_MaxU32;
    public u32 depth = s_MaxU32;
    public u32 mipLevel = 0u;
    public u32 arraySlice = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

