Expected<void> DeferredBindlessDescriptorRegistrar::registerCausticResolveTargets(){
    Expected<GpuDescriptorHandle> descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage2DArrayUint, this.m_targets.causticAccumulator, this.m_targets.causticAccumulatorFormat, s_CausticAccumulatorSubresources, TextureDimension::Texture2DArray);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.causticAccumulator = descriptor.value();
    descriptor = RegisterStorageTexture(this.m_heap, this.m_targets.causticAccumulator, this.m_targets.causticAccumulatorFormat, TextureDimension::Texture2DArray);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.causticAccumulatorStorage = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.causticHistory, this.m_targets.causticHistoryFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
