class StatisticsTestControl<TState>{
    public HeapStorage arena;
    public SharedPool versions;
    public Shared<TState> control;
    public StatisticsTestControl(){
        this.arena = HeapStorage(s_EcsGraphicsCaseTestsStatistics);
        this.versions = this.arena.makeValue<SharedPool>();
        const auto created = this.versions.make<TState>(cast<u16>(1u));
        if(!created.has_value()){
            ADD_FAILURE();
            return;
        }
        this.control = created.value();
    }
}

class ReflectionStatisticsLeaseTask{
    public ReflectionStatisticsReservation reservation;
    public ReflectionStatisticsLeaseTask(in ReflectionStatisticsControlHandle control, in ReflectionStatistics metadata){ this.reservation = StatisticsReservation<ReflectionStatistics, ReflectionStatisticsOutcome>(control, metadata); }
    public void discarded(){ this.reservation.discard(); }
}

class ReflectionFeedbackLeaseTask{
    public ReflectionFeedbackReservation reservation;
    public ReflectionFeedbackLeaseTask(in ReflectionFeedbackControlHandle control, in ReflectionFeedbackPlan metadata){ this.reservation = ReflectionFeedbackReservation(control, metadata); }
    public void discarded(){ this.reservation.discard(); }
}

class ReflectionHistoryLeaseTask{
    public ReflectionHistoryReservation reservation;
    public ReflectionHistoryLeaseTask(in ReflectionHistoryControlHandle control, in ReflectionHistoryPlan metadata){ this.reservation = ReflectionHistoryReservation(control, metadata); }
    public void discarded(){ this.reservation.discard(); }
}

class ReflectionStatsDestructorLeaseTask{ public ReflectionStatisticsReservation reservation;
    public ReflectionStatsDestructorLeaseTask(in ReflectionStatisticsControlHandle control, in ReflectionStatistics metadata){ this.reservation = StatisticsReservation<ReflectionStatistics, ReflectionStatisticsOutcome>(control, metadata); } }

class RayTracingGraphTestContext<StateT>{
    public StatisticsTestControl<StateT> inner;
    public GpuTaskGraph graph;

    public RayTracingGraphTestContext(){
        this.inner = StatisticsTestControl<StateT>();
        this.graph = GpuTaskGraph(this.inner.arena);
    }

    public Expected<GpuTaskId> addLeaseTask<TaskT, MetadataT>(in GpuTaskDesc desc, in MetadataT metadata){
        TaskT task(this.inner.control, metadata);
        return this.graph.addPayloadTask(desc, task);
    }
}

class PruneContext{
    public EcsTestWorld testWorld;
    public mut MeshSystem meshSystem;
    public PruneContext(){
        this.testWorld = EcsTestWorld();
        this.meshSystem = this.testWorld.world.addSystem<MeshSystem>(this.testWorld.world);
    }
    public EntityID addMeshEntity(){
        auto entity = this.testWorld.world.createEntity();
        entity.addComponent<MeshComponent>();
        return entity.id();
    }
    public void setMeshAsset(in EntityID entity, in StringView path){
        const auto parsed = NameFromText(path);
        mut MeshComponent mesh = this.testWorld.world.entity(entity).getComponent<MeshComponent>();
        mesh.mesh = PruneMeshAssetRef(parsed.value_or(s_NameNone));
    }
    public EntityID addSkinnedEntity(){
        auto entity = this.testWorld.world.createEntity();
        entity.addComponent<SkinnedMeshBindingComponent>();
        return entity.id();
    }
}

class RuntimeMeshPruningContext{
    public ScratchStorage scratch;
    public RuntimeMeshRequestSet requests;
    [cpp_unwind]
    public RuntimeMeshPruningContext(in usize capacityHint){
        this.scratch = ScratchStorage(s_EcsGraphicsCaseTestsRuntimeMeshPruningRequestScratch);
        this.requests = this.scratch.makeValue<RuntimeMeshRequestSet>(capacityHint);
    }
}

static_assert(size_of<ReflectionCounterArray>() == s_ReflectionReadbackCounterBytes);


