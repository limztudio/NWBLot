////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_material/bind_types.adhd>

native{
#include <global/simd/convert.h>
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_MaterialTypedValueRecordWordCount = 8u;
const usize s_MaterialCompactStringMaxLength = 254u;
const StringView s_MaterialParameterKeySeparator = ".";
const u64 s_MaterialParameterKeyHashLowWordMask = 0xFFFFFFFFul;
const u32 s_MaterialParameterKeyHashHighWordBitShift = 32u;
const StringView s_MaterialBoolTrueTextToken = "true";
const StringView s_MaterialBoolTrueNumberToken = "1";
const StringView s_MaterialBoolFalseTextToken = "false";
const StringView s_MaterialBoolFalseNumberToken = "0";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MaterialBindStorageByteSizes{
    public u32 constantBytes = 0u;
    public u32 mutableBytes = 0u;
}

class MaterialTypedValueData{
    public u32x4 meta(0u, 0u, 0u, 0u);
    public u32x4 data(0u, 0u, 0u, 0u);
}

class MaterialParameterCall{
    public StringView typeText = "";
    public StringView arguments = "";
}

class MaterialParameterTokens{
    public Array<StringView, 4> values;
    public u32 count = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<MaterialParameterCall> SplitMaterialParameterCall(in StringView text){
    const StringView trimmed = trimView(text);
    usize openParen = trimmed.size();
    for(usize i = 0u; i < trimmed.size(); ++i){
        if(trimmed[i] == '('){
            openParen = i;
            break;
        }
    }
    if(openParen >= trimmed.size() || trimmed.empty() || trimmed[trimmed.size() - 1u] != ')')
        return makeUnexpected(Failure());

    const StringView typeText = trimView(trimmed.substr(0u, openParen));
    const StringView arguments = trimView(trimmed.substr(openParen + 1u, trimmed.size() - openParen - 2u));
    if(typeText.empty() || arguments.empty())
        return makeUnexpected(Failure());
    MaterialParameterCall outCall;
    outCall.typeText = typeText;
    outCall.arguments = arguments;
    return outCall;
}

Expected<MaterialParameterTokens> SplitMaterialParameterTokens(in StringView text){
    MaterialParameterTokens outTokens;
    usize cursor = 0u;
    while(true){
        const Expected<StringView> token = readCommaOrSpaceDelimitedToken(text, cursor);
        if(!token.has_value())
            break;
        if(outTokens.count >= s_MaterialTypedValueComponentCount)
            return makeUnexpected(Failure());
        outTokens.values[cast<usize>(outTokens.count)] = token.value();
        ++outTokens.count;
    }
    if(outTokens.count == 0u)
        return makeUnexpected(Failure());
    return outTokens;
}

u32x4u MaterialTypedValueToLayoutValue(in MaterialTypedValueData parameter){
    return u32x4u(parameter.data.x, parameter.data.y, parameter.data.z, parameter.data.w);
}

Expected<CompactString> BuildMaterialBindParameterKey(in StringView instanceName, in StringView fieldName){
    if(
        instanceName.size() > s_MaterialCompactStringMaxLength
        || fieldName.size() > s_MaterialCompactStringMaxLength - instanceName.size()
        || instanceName.size() + fieldName.size() + s_MaterialParameterKeySeparator.size() > s_MaterialCompactStringMaxLength
        || hasEmbeddedNull(instanceName)
        || hasEmbeddedNull(fieldName)
    )
        return makeUnexpected(Failure());

    CompactString outKey;
    if(
        !outKey.assign(instanceName)
        || !outKey.append(s_MaterialParameterKeySeparator)
        || !outKey.append(fieldName)
    )
        return makeUnexpected(Failure());
    return outKey;
}

u32x4 PackMaterialTypedValueMeta(in StringView key, in MaterialParameterType type){
    const u64 keyHash = computeFnv64AsciiLowerText(key);
    return u32x4(
        cast<u32>(keyHash & s_MaterialParameterKeyHashLowWordMask),
        cast<u32>(keyHash >> s_MaterialParameterKeyHashHighWordBitShift),
        cast<u32>(type.valueType),
        type.componentCount
    );
}

Expected<u32> TryParseMaterialBoolToken(in StringView token){
    if(token == s_MaterialBoolTrueTextToken || token == s_MaterialBoolTrueNumberToken)
        return 1u;
    if(token == s_MaterialBoolFalseTextToken || token == s_MaterialBoolFalseNumberToken)
        return 0u;
    return makeUnexpected(Failure());
}

Expected<f32> ParseMaterialParameterF32Token(in StringView token){
    const Expected<f64> parsed = parseF64(token);
    if(!parsed.has_value() || !isFinite(parsed.value()))
        return makeUnexpected(Failure());
    if(parsed.value() < cast<f64>(f32.min) || parsed.value() > cast<f64>(f32.max))
        return makeUnexpected(Failure());
    return cast<f32>(parsed.value());
}

Expected<u32> ParseMaterialParameterSignedToken(in StringView token, in i64 minValue, in i64 maxValue, in u32 storageMask){
    const Expected<i64> parsed = parseI64(token);
    if(!parsed.has_value())
        return makeUnexpected(Failure());
    if(parsed.value() < minValue || parsed.value() > maxValue)
        return makeUnexpected(Failure());
    return cast<u32>(cast<u64>(parsed.value()) & cast<u64>(storageMask));
}

Expected<u32> ParseMaterialParameterUnsignedToken(in StringView token, in u64 maxValue){
    const Expected<u64> parsed = parseU64(token);
    if(!parsed.has_value() || parsed.value() > maxValue)
        return makeUnexpected(Failure());
    return cast<u32>(parsed.value());
}

StringView NormalizeMaterialParameterNumericToken(in StringView token, in MaterialParameterValueType type){
    if(type == MaterialParameterValueType::f32)
        return stripMatchingTrailingByte(token, cast<u8>('f'), cast<u8>('F'));
    if(type == MaterialParameterValueType::f16){
        const StringView stripped = stripMatchingTrailingByte(token, cast<u8>('h'), cast<u8>('H'));
        if(stripped == token)
            return stripMatchingTrailingByte(token, cast<u8>('f'), cast<u8>('F'));
        return stripped;
    }
    if(type == MaterialParameterValueType::u8 || type == MaterialParameterValueType::u16 || type == MaterialParameterValueType::u32)
        return stripMatchingTrailingByte(token, cast<u8>('u'), cast<u8>('U'));
    return token;
}

Expected<u32> ParseMaterialParameterNonHalfToken(in StringView token, in MaterialParameterValueType type){
    const StringView numericToken = NormalizeMaterialParameterNumericToken(token, type);
    switch(type){
    case MaterialParameterValueType::b8:
        return TryParseMaterialBoolToken(token);
    case MaterialParameterValueType::i8:
        return ParseMaterialParameterSignedToken(numericToken, cast<i64>(i8.min), cast<i64>(i8.max), cast<u32>(u8.max));
    case MaterialParameterValueType::u8:
        return ParseMaterialParameterUnsignedToken(numericToken, cast<u64>(u8.max));
    case MaterialParameterValueType::i16:
        return ParseMaterialParameterSignedToken(numericToken, cast<i64>(i16.min), cast<i64>(i16.max), cast<u32>(u16.max));
    case MaterialParameterValueType::u16:
        return ParseMaterialParameterUnsignedToken(numericToken, cast<u64>(u16.max));
    case MaterialParameterValueType::i32:
        return ParseMaterialParameterSignedToken(numericToken, cast<i64>(i32.min), cast<i64>(i32.max), u32.max);
    case MaterialParameterValueType::u32:
        return ParseMaterialParameterUnsignedToken(numericToken, cast<u64>(u32.max));
    case MaterialParameterValueType::f32:{
        const Expected<f32> converted = ParseMaterialParameterF32Token(numericToken);
        if(!converted.has_value())
            return makeUnexpected(Failure());
        return bit_cast<u32>(converted.value());
    }
    default:
        return makeUnexpected(Failure());
    }
}

Expected<MaterialTypedValueData> StoreMaterialTypedValueComponent(in MaterialParameterValueType valueType, in u32 componentIndex, in u32 value, in MaterialTypedValueData parameter){
    if(componentIndex >= s_MaterialTypedValueComponentCount)
        return makeUnexpected(Failure());

    MaterialTypedValueData outParameter = parameter;
    switch(valueType){
    case MaterialParameterValueType::b8:
    case MaterialParameterValueType::i8:
    case MaterialParameterValueType::u8:{
        u32 byteVal = value & 0xffu;
        if(valueType == MaterialParameterValueType::b8){
            if(value != 0u)
                byteVal = 1u;
            else
                byteVal = 0u;
        }
        const u32 shift = componentIndex * 8u;
        const u32 mask = ~(0xffu << shift);
        outParameter.data.x = (outParameter.data.x & mask) | (byteVal << shift);
        return outParameter;
    }
    case MaterialParameterValueType::i16:
    case MaterialParameterValueType::u16:
    case MaterialParameterValueType::f16:{
        const u32 halfVal = value & 0xffffu;
        const u32 shift = (componentIndex & 1u) * 16u;
        const u32 mask = ~(0xffffu << shift);
        if(componentIndex < 2u)
            outParameter.data.x = (outParameter.data.x & mask) | (halfVal << shift);
        else
            outParameter.data.y = (outParameter.data.y & mask) | (halfVal << shift);
        return outParameter;
    }
    default:
        if(componentIndex == 0u)
            outParameter.data.x = value;
        else if(componentIndex == 1u)
            outParameter.data.y = value;
        else if(componentIndex == 2u)
            outParameter.data.z = value;
        else
            outParameter.data.w = value;
        return outParameter;
    }
}

Expected<MaterialTypedValueData> ParseMaterialTypedValue(in StringView key, in StringView value){
    MaterialTypedValueData parameter;
    if(key.empty() || key.size() > s_MaterialCompactStringMaxLength || value.empty() || value.size() > s_MaterialCompactStringMaxLength)
        return makeUnexpected(Failure());

    const Expected<MaterialParameterCall> call = SplitMaterialParameterCall(trimView(value));
    if(!call.has_value())
        return makeUnexpected(Failure());
    const Expected<MaterialParameterType> type = TryParseMaterialParameterTypeText(call.value().typeText);
    if(!type.has_value())
        return makeUnexpected(Failure());
    const Expected<MaterialParameterTokens> tokens = SplitMaterialParameterTokens(call.value().arguments);
    if(!tokens.has_value() || tokens.value().count != type.value().componentCount)
        return makeUnexpected(Failure());

    for(u32 i = 0u; i < tokens.value().count; ++i){
        Expected<u32> parsedValue = makeUnexpected(Failure());
        if(type.value().valueType == MaterialParameterValueType::f16){
            const StringView numericToken = NormalizeMaterialParameterNumericToken(tokens.value().values[cast<usize>(i)], type.value().valueType);
            const Expected<f32> converted = ParseMaterialParameterF32Token(numericToken);
            if(converted.has_value()){
                const f32 f32Val = converted.value();
                u32 halfBits = 0u;
                native(in f32Val, mut halfBits){
                    halfBits = static_cast<u32>(::ConvertFloatToHalf(f32Val));
                }
                parsedValue = halfBits;
            }
        }
        else{
            parsedValue = ParseMaterialParameterNonHalfToken(tokens.value().values[cast<usize>(i)], type.value().valueType);
        }
        if(!parsedValue.has_value())
            return makeUnexpected(Failure());
        const Expected<MaterialTypedValueData> storedParameter = StoreMaterialTypedValueComponent(type.value().valueType, i, parsedValue.value(), parameter);
        if(!storedParameter.has_value())
            return makeUnexpected(Failure());
        parameter = storedParameter.value();
    }

    parameter.meta = PackMaterialTypedValueMeta(key, type.value());
    return parameter;
}

void CopyMaterialBindTypedLayoutDefaults(
    in u64 layoutHash,
    in Span<MaterialTypedLayoutBlock> typedLayoutBlocks,
    in Span<MaterialTypedLayoutField> typedLayoutFields,
    in Span<u8> typedBlockBytes,
    mut u64 outLayoutHash,
    mut Vector<MaterialTypedLayoutBlock> outBlocks,
    mut Vector<MaterialTypedLayoutField> outFields,
    mut Vector<u8> outBlockBytes
){
    outLayoutHash = layoutHash;
    outBlocks.clear();
    outBlocks.reserve(typedLayoutBlocks.size());
    for(in MaterialTypedLayoutBlock block : typedLayoutBlocks)
        outBlocks.push_back(block);
    outFields.clear();
    outFields.reserve(typedLayoutFields.size());
    for(in MaterialTypedLayoutField field : typedLayoutFields)
        outFields.push_back(field);
    outBlockBytes.clear();
    outBlockBytes.reserve(typedBlockBytes.size());
    for(in u8 byteValue : typedBlockBytes)
        outBlockBytes.push_back(byteValue);
}

Expected<MaterialBindStorageByteSizes> TryComputeMaterialBindStorageByteSizes(in Span<MaterialTypedLayoutBlock> blocks){
    MaterialBindStorageByteSizes outSizes;
    for(usize i = 0u; i < blocks.size(); ++i){
        const MaterialTypedLayoutBlock block = blocks[i];
        if(block.blockClass == MaterialBlockClass::MaterialConstant){
            if(block.byteSize > 0xFFFFFFFFu - outSizes.constantBytes)
                return makeUnexpected(Failure());
            outSizes.constantBytes += block.byteSize;
        }
        else if(block.blockClass == MaterialBlockClass::MaterialMutable){
            if(block.byteSize > 0xFFFFFFFFu - outSizes.mutableBytes)
                return makeUnexpected(Failure());
            outSizes.mutableBytes += block.byteSize;
        }
        else
            return makeUnexpected(Failure());
    }
    return outSizes;
}

u32 ComputeMaterialBindBlockStorageByteBegin(in Span<MaterialTypedLayoutBlock> blocks, in u32 blockIndex){
    u32 byteBegin = 0u;
    const MaterialBlockClass blockClass = blocks[cast<usize>(blockIndex)].blockClass;
    for(u32 currentBlockIndex = 0u; currentBlockIndex < blockIndex; ++currentBlockIndex){
        const MaterialTypedLayoutBlock block = blocks[cast<usize>(currentBlockIndex)];
        if(block.blockClass != blockClass)
            continue;
        byteBegin += block.byteSize;
    }
    return byteBegin;
}


