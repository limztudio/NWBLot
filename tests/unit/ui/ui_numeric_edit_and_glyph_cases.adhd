void VerifyUiNumericEditBuilderTests_AHostWithoutOrderedActionsRejectsTypedEditors(mut UiNumericEditBuilderTests self){
    UiNumericEditBuilderPlainHost host = UiNumericEditBuilderPlainHost();
    self.usePlainHost(host);
    ASSERT_TRUE(self.beginNumeric(1u));
    const auto result = self.m_builder.integerEdit(s_UiNumericEditIntegerKey, self.m_integer, self.m_integerState);
    EXPECT_FALSE(result.edit.valid);
    EXPECT_FALSE(result.numeric.valid);
    EXPECT_EQ(host.edits, 0u);
    EXPECT_TRUE(self.m_context.failed());
}

void VerifyUiNumericEditBuilderTests_SubmitCommitsAtItsPositionBeforeLaterText(mut UiNumericEditBuilderTests self){
    self.useHost();
    self.m_host.replace("42");
    self.m_host.key(CoreKey::Enter);
    self.m_host.text("7");
    ASSERT_TRUE(self.beginNumeric(1u));
    const auto result = self.m_builder.integerEdit(s_UiNumericEditIntegerKey, self.m_integer, self.m_integerState);
    ASSERT_TRUE(result.edit.valid && result.numeric.valid);
    EXPECT_TRUE(result.edit.submitted && result.edit.textChanged);
    EXPECT_TRUE(result.numeric.committed && result.numeric.valueChanged);
    EXPECT_FALSE(result.numeric.cancelled || result.numeric.rejected);
    EXPECT_EQ(self.m_integer.value(), 42);
    EXPECT_EQ(self.m_integer.draft().text(), "427");
    EXPECT_TRUE(self.m_integer.dirty());
    ASSERT_TRUE(self.acceptNumeric());
    EXPECT_EQ(StringView(self.m_host.displayed.data(), self.m_host.displayed.size()), "427");
    EXPECT_EQ(self.m_host.loans, 1u);
    EXPECT_EQ(self.m_host.ordinaryLoans, 0u);
}

void VerifyUiNumericEditBuilderTests_SubmitThenCancelAggregatesActionsAndDropsRetiredText(mut UiNumericEditBuilderTests self){
    self.useHost();
    self.m_host.replace("42");
    self.m_host.key(CoreKey::Enter);
    self.m_host.text("7");
    self.m_host.key(CoreKey::Escape);
    self.m_host.text("9");
    ASSERT_TRUE(self.beginNumeric(1u));
    const auto result = self.m_builder.integerEdit(s_UiNumericEditIntegerKey, self.m_integer, self.m_integerState);
    ASSERT_TRUE(result.edit.valid && result.numeric.valid);
    EXPECT_TRUE(result.edit.submitted && result.edit.cancelled);
    EXPECT_TRUE(result.numeric.committed && result.numeric.cancelled && result.numeric.restored);
    EXPECT_FALSE(result.edit.focused);
    EXPECT_EQ(self.m_integer.value(), 42);
    EXPECT_EQ(self.m_integer.draft().text(), "42");
    EXPECT_FALSE(self.m_integer.dirty());
    ASSERT_TRUE(self.acceptNumeric());
}

void VerifyUiNumericEditBuilderTests_IncompleteSubmitRetainsDraftAndReportsRejection(mut UiNumericEditBuilderTests self){
    self.useHost();
    ASSERT_TRUE(self.m_integer.setValue(12));
    self.m_host.replace("-");
    self.m_host.key(CoreKey::Enter);
    ASSERT_TRUE(self.beginNumeric(1u));
    const auto result = self.m_builder.integerEdit(s_UiNumericEditIntegerKey, self.m_integer, self.m_integerState);
    ASSERT_TRUE(result.edit.valid && result.numeric.valid);
    EXPECT_TRUE(result.edit.submitted && result.numeric.rejected);
    EXPECT_FALSE(result.numeric.committed || result.numeric.restored);
    EXPECT_EQ(self.m_integer.value(), 12);
    EXPECT_EQ(self.m_integer.status(), NumericParseStatus::Incomplete);
    EXPECT_EQ(self.m_integer.draft().text(), "-");
    ASSERT_TRUE(self.acceptNumeric());
}

void VerifyUiNumericEditBuilderTests_InvalidBlurRestoresCurrentCommittedValueBeforeSnapshot(mut UiNumericEditBuilderTests self){
    self.useHost();
    ASSERT_TRUE(self.m_integer.setValue(12));
    self.m_host.replace("invalid");
    self.m_host.action(EditAction::Blur);
    ASSERT_TRUE(self.beginNumeric(1u));
    const auto result = self.m_builder.integerEdit(s_UiNumericEditIntegerKey, self.m_integer, self.m_integerState);
    ASSERT_TRUE(result.edit.valid && result.numeric.valid);
    EXPECT_TRUE(result.numeric.rejected && result.numeric.restored);
    EXPECT_FALSE(result.numeric.committed || result.numeric.cancelled);
    EXPECT_EQ(self.m_integer.value(), 12);
    EXPECT_EQ(self.m_integer.draft().text(), "12");
    ASSERT_TRUE(self.acceptNumeric());
    EXPECT_EQ(StringView(self.m_host.displayed.data(), self.m_host.displayed.size()), "12");
}

void VerifyUiNumericEditBuilderTests_FloatClampUsesTheBoundsOfTheOrderedAction(mut UiNumericEditBuilderTests self){
    self.useHost();
    self.m_host.replace("12.5");
    self.m_host.key(CoreKey::Enter);
    FloatEditOptions options = FloatEditOptions();
    options.bounds = MakeUiNumericFloatBounds(-10.0, 10.0, NumericBoundsPolicy::Clamp);
    ASSERT_TRUE(self.beginNumeric(1u));
    const auto result = self.m_builder.floatEdit(s_UiNumericEditDecimalKey, self.m_float, self.m_floatState, options);
    ASSERT_TRUE(result.edit.valid && result.numeric.valid);
    EXPECT_TRUE(result.numeric.committed && result.numeric.valueChanged && result.numeric.clamped);
    EXPECT_FALSE(result.numeric.rejected || result.numeric.restored);
    EXPECT_DOUBLE_EQ(self.m_float.value(), 10.0);
    EXPECT_EQ(self.m_float.draft().text(), "10");
    ASSERT_TRUE(self.acceptNumeric());
}

void VerifyUiNumericEditBuilderTests_BoundsPolicyChangePreservesDraftUntilTheNextAction(mut UiNumericEditBuilderTests self){
    self.useHost();
    ASSERT_TRUE(self.m_integer.setDraft("42"));
    ASSERT_TRUE(self.beginNumeric(1u));
    ASSERT_TRUE(self.m_builder.integerEdit(s_UiNumericEditIntegerKey, self.m_integer, self.m_integerState).edit.valid);
    ASSERT_TRUE(self.acceptNumeric());
    IntegerEditOptions options = IntegerEditOptions();
    options.bounds = MakeUiNumericIntegerBounds(-10, 10, NumericBoundsPolicy::Clamp);
    ASSERT_TRUE(self.beginNumeric(2u));
    const auto unchanged = self.m_builder.integerEdit(s_UiNumericEditIntegerKey, self.m_integer, self.m_integerState, options);
    ASSERT_TRUE(unchanged.edit.valid && unchanged.numeric.valid);
    EXPECT_FALSE(unchanged.numeric.committed || unchanged.numeric.restored || unchanged.numeric.clamped);
    EXPECT_EQ(self.m_integer.value(), 0);
    EXPECT_EQ(self.m_integer.draft().text(), "42");
    ASSERT_TRUE(self.acceptNumeric());
    self.m_host.key(CoreKey::Enter);
    ASSERT_TRUE(self.beginNumeric(3u));
    const auto committed = self.m_builder.integerEdit(s_UiNumericEditIntegerKey, self.m_integer, self.m_integerState, options);
    ASSERT_TRUE(committed.edit.valid && committed.numeric.valid);
    EXPECT_TRUE(committed.numeric.committed && committed.numeric.clamped);
    EXPECT_EQ(self.m_integer.value(), 10);
    EXPECT_EQ(self.m_integer.draft().text(), "10");
    ASSERT_TRUE(self.acceptNumeric());
}

void VerifyUiNumericEditBuilderTests_ReadOnlySubmitDoesNotCommitOrAdvanceNumericRevision(mut UiNumericEditBuilderTests self){
    self.useHost();
    ASSERT_TRUE(self.m_integer.setValue(12));
    ASSERT_TRUE(self.m_integer.setDraft("42"));
    const u64 revision = self.m_integer.revision();
    self.m_host.key(CoreKey::Enter);
    IntegerEditOptions options = IntegerEditOptions();
    options.edit.readOnly = true;
    ASSERT_TRUE(self.beginNumeric(1u));
    const auto result = self.m_builder.integerEdit(s_UiNumericEditIntegerKey, self.m_integer, self.m_integerState, options);
    ASSERT_TRUE(result.edit.valid && result.numeric.valid);
    EXPECT_TRUE(result.edit.submitted);
    EXPECT_FALSE(result.numeric.committed || result.numeric.cancelled || result.numeric.restored);
    EXPECT_EQ(self.m_integer.revision(), revision);
    EXPECT_EQ(self.m_integer.value(), 12);
    EXPECT_EQ(self.m_integer.draft().text(), "42");
    ASSERT_TRUE(self.acceptNumeric());
}

void VerifyUiNumericEditBuilderTests_ReadOnlyBlurRestoresWithoutACommitOrUserCancel(mut UiNumericEditBuilderTests self){
    self.useHost();
