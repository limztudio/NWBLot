using namespace NWB;
using namespace NWB::Impl::Ui;

inline constexpr AStringView s_EmbeddedNulShort("a\0b", 3u);
inline constexpr AStringView s_EmbeddedNulTail("prefix\r\n\0tail", 13u);
inline constexpr AStringView s_EmbeddedNulBorrowed("prefix a\r\nb\0tail", 16u);

struct AsciiSandwich{
    Array<char, 3u> bytes{};

    [[nodiscard]] AStringView view()const noexcept{
        return AStringView(bytes.data(), bytes.size());
    }
};

struct C1Sandwich{
    Array<char, 4u> bytes{};

    [[nodiscard]] AStringView view()const noexcept{
        return AStringView(bytes.data(), bytes.size());
    }
};

[[nodiscard]] FOUNDATION_INLINE AsciiSandwich MakeAsciiSandwich(const u32 scalar)noexcept{
    return { { 'a', static_cast<char>(scalar), 'b' } };
}

[[nodiscard]] FOUNDATION_INLINE C1Sandwich MakeC1Sandwich(const u32 leadByte, const u32 scalar)noexcept{
    return { { 'a', static_cast<char>(leadByte), static_cast<char>(scalar), 'b' } };
}


