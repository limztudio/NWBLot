void VerifyUiContextMenuInputTests_ResetDropsPendingTriggersAndKeepsActionSequencesMonotonic(mut UiContextMenuInputTests self){
    const HitTarget target = MakeUiContextMenuTarget(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 1u));
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryUp)).pointerConsumed);
    const Expected<ContextMenuAction> firstResult = self.take();
    ASSERT_TRUE(firstResult.has_value());
    const ContextMenuAction first = firstResult.value();
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown)).pointerConsumed);
    self.m_router.reset();
    EXPECT_TRUE(self.m_router.secondaryDown());
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 1u));
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryUp)).pointerConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryUp)).pointerConsumed);
    const Expected<ContextMenuAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_GT(actionResult.value().id.sequence, first.id.sequence);
}

void VerifyUiContextMenuInputTests_ContextTriggerQueueReportsOverflowOnReleaseWithoutReplayingTheHold(mut UiContextMenuInputTests self){
    const HitTarget target = MakeUiContextMenuTarget(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 1u));
    self.focus();
    for(usize index = 0u; index < s_InputMaxContextMenuActions; ++index){
        EXPECT_FALSE(self.send(MakeUiContextMenuKey(CoreKey::Menu)).activationOverflow);
        const InputRoutingResult released = self.release(CoreKey::Menu);
        EXPECT_TRUE(released.commandConsumed);
        EXPECT_FALSE(released.activationOverflow);
    }
    EXPECT_FALSE(self.send(MakeUiContextMenuKey(CoreKey::Menu)).activationOverflow);
    const InputRoutingResult overflow = self.release(CoreKey::Menu);
    EXPECT_TRUE(overflow.commandConsumed);
    EXPECT_TRUE(overflow.activationOverflow);
    usize count = 0u;
    u64 sequence = 0u;
    for(usize guard = 0u; guard <= s_InputMaxContextMenuActions; ++guard){
        const Expected<ContextMenuAction> pendingAction = self.take();
        if(!pendingAction.has_value())
            break;
        const ContextMenuAction action = pendingAction.value();
        EXPECT_GT(action.id.sequence, sequence);
        sequence = action.id.sequence;
        ++count;
    }
    EXPECT_EQ(count, s_InputMaxContextMenuActions);
    EXPECT_FALSE(self.send(MakeUiContextMenuKey(CoreKey::Menu, false, false, false, true)).activationOverflow);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_FALSE(self.release(CoreKey::Menu).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiContextMenuKey(CoreKey::Menu)).commandConsumed);
    EXPECT_TRUE(self.release(CoreKey::Menu).commandConsumed);
    ASSERT_TRUE(self.take().has_value());
}

void VerifyUiContextMenuInputTests_SecondaryInputRejectsNonfiniteCoordinatesAndNewKeyBoundsRemainValidated(mut UiContextMenuInputTests self){
    EXPECT_FALSE(self.queueNative(MakeUiContextMenuPointer(InputEventType::SecondaryDown, MakeUiContextPoint(UiContextMenuQuietNaNF32(), 1.0f))));
    EXPECT_FALSE(self.queueNative(MakeUiContextMenuPointer(InputEventType::SecondaryUp, MakeUiContextPoint(1.0f, UiContextMenuInfinityF32()))));
    const CoreKeyEnum outOfBounds = MakeUiContextMenuOutOfBoundsKey();
    EXPECT_FALSE(self.queueNative(MakeUiContextMenuKey(outOfBounds)));
    EXPECT_FALSE(self.m_router.ownsKey(outOfBounds));
    EXPECT_TRUE(self.queueNative(MakeUiContextMenuKey(CoreKey::Menu)));
    EXPECT_TRUE(self.queueNative(MakeUiContextMenuKey(CoreKey::F10, true)));
    EXPECT_FALSE(self.m_router.process().commandConsumed);
}

void VerifyUiContextMenuInputTests_EscapeCancelsHeldPointerAndMenuIntentsWithoutLeakingTheirReleases(mut UiContextMenuInputTests self){
    const HitTarget target = MakeUiContextMenuTarget(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 1u));
    self.focus();
    EXPECT_TRUE(self.send(MakeUiContextMenuKey(CoreKey::Menu)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown)).pointerConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiContextMenuKey(CoreKey::Escape)).commandConsumed);
    EXPECT_TRUE(self.release(CoreKey::Escape).commandConsumed);
    EXPECT_TRUE(self.m_router.ownsKey(CoreKey::Menu));
    EXPECT_TRUE(self.m_router.secondaryDown());
    EXPECT_TRUE(self.send(MakeUiContextMenuKey(CoreKey::Menu, false, false, false, true)).commandConsumed);
    EXPECT_TRUE(self.release(CoreKey::Menu).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryUp)).pointerConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.m_router.controlActions().empty());
    self.focus();
    EXPECT_TRUE(self.send(MakeUiContextMenuKey(CoreKey::Menu)).commandConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.release(CoreKey::Menu).commandConsumed);
    const Expected<ContextMenuAction> keyboard = self.take();
    ASSERT_TRUE(keyboard.has_value());
    EXPECT_EQ(keyboard.value().origin, InputActionSource::Command);
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown)).pointerConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryUp)).pointerConsumed);
    const Expected<ContextMenuAction> pointer = self.take();
    ASSERT_TRUE(pointer.has_value());
    EXPECT_EQ(pointer.value().origin, InputActionSource::Pointer);
    EXPECT_GT(pointer.value().id.sequence, keyboard.value().id.sequence);
    EXPECT_FALSE(self.take().has_value());
}

void VerifyUiContextMenuInputTests_FocusTransferAwayAndBackCannotReviveTheOriginalHeldMenuIntent(mut UiContextMenuInputTests self){
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = MakeUiContextMenuTarget(1u);
    targets[1u] = MakeUiContextMenuTargetAt(2u, MakeUiContextRect(70.0f, 10.0f, 40.0f, 20.0f));
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u));
    self.focus();
    ASSERT_EQ(self.m_router.focus(), targets[0u].id);
    EXPECT_TRUE(self.send(MakeUiContextMenuKey(CoreKey::Menu)).commandConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiContextMenuKey(CoreKey::Tab)).commandConsumed);
    EXPECT_TRUE(self.release(CoreKey::Tab).commandConsumed);
    EXPECT_EQ(self.m_router.focus(), targets[1u].id);
    EXPECT_TRUE(self.send(MakeUiContextMenuKey(CoreKey::Tab, true)).commandConsumed);
    EXPECT_TRUE(self.release(CoreKey::Tab).commandConsumed);
    EXPECT_EQ(self.m_router.focus(), targets[0u].id);
    EXPECT_TRUE(self.release(CoreKey::Menu).commandConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_FALSE(self.take(2u).has_value());
    EXPECT_TRUE(self.send(MakeUiContextMenuKey(CoreKey::Menu)).commandConsumed);
    EXPECT_TRUE(self.release(CoreKey::Menu).commandConsumed);
    ASSERT_TRUE(self.take().has_value());
    EXPECT_FALSE(self.take().has_value());
}


