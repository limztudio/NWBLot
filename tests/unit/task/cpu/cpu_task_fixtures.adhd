// Watchdog and capture probes shared by the CPU scheduler suites.
namespace CpuTaskSchedulerTestSupport{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB::Core;


[[noreturn]] FOUNDATION_INLINE void ExitTestProcess(const u32 code)noexcept{
    std::_Exit(static_cast<int>(code));
}


class DeadlineGuard final{
public:
    explicit DeadlineGuard(const b8 deathTest = false, const u32 timeoutMS = s_TestTimeoutMS)
        : m_watchdog([deathTest, timeoutMS](const StopToken& stop)noexcept {
            const Timer begin = TimerNow();
            while(!stop.stop_requested()){
                if(DurationInMS<u64>(TimerNow(), begin) >= timeoutMS){
                    // A timeout must fail a death test instead of being mistaken for the expected invariant rejection.
                    if(deathTest)
                        ExitTestProcess(0u);
                    TerminateInvariant();
                }
                SleepMS(s_PollIntervalMS);
            }
        })
    {}
    ~DeadlineGuard()noexcept = default;


private:
    JoiningThread m_watchdog;
};


struct LifetimeProbe{
    Atomic<u32>* retirements;
    u32 value;


public:
    explicit LifetimeProbe(Atomic<u32>& counter, const u32 payload = 0u)noexcept
        : retirements(&counter)
        , value(payload)
    {}
    LifetimeProbe(const LifetimeProbe&) = delete;
    LifetimeProbe(LifetimeProbe&& other)noexcept
        : retirements(other.retirements)
        , value(other.value)
    {
        other.retirements = nullptr;
    }
    ~LifetimeProbe()noexcept{
        if(retirements)
            retirements->fetch_add(1u, MemoryOrder::release);
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


