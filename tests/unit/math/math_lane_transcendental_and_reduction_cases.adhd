FOUNDATION_NOINLINE b8 BaselineCompareDouble3(SIMDVectorDouble left, SIMDVectorDouble right)noexcept;

template<b8 Integer, u32 Dimension>
FOUNDATION_NOINLINE b8 CompareDouble(SIMDVectorDouble left, SIMDVectorDouble right)noexcept{
#pragma STDC FENV_ACCESS ON
    if constexpr(Integer){
        if constexpr(Dimension == 3u)
            return VectorDouble3EqualInt(left, right);
        else
            return VectorDouble4EqualInt(left, right);
    }
    else{
        if constexpr(Dimension == 3u)
            return VectorDouble3Equal(left, right);
        else
            return VectorDouble4Equal(left, right);
    }
}

template<b8 Integer>
FOUNDATION_NOINLINE b8 CompareSingle(SIMDVectorSingle left, SIMDVectorSingle right)noexcept{
#pragma STDC FENV_ACCESS ON
    if constexpr(Integer)
        return Vector4EqualInt(left, right);
    else
        return Vector4Equal(left, right);
}

FOUNDATION_NOINLINE u32 ExtractMask(SIMDVectorDouble value)noexcept;

namespace Reduction{
enum Enum : u32{
    Dot2 = 0u,
    Dot3 = 1u,
    Dot4 = 2u,
    Sum = 3u
};
};

template<Reduction::Enum Kind>
FOUNDATION_NOINLINE SIMDVectorDouble OriginalReduction(SIMDVectorDouble lhs, SIMDVectorDouble rhs)noexcept{
#pragma STDC FENV_ACCESS ON
    if constexpr(Kind == Reduction::Dot2){
        lhs = VectorDoubleAndInt(lhs, s_DoubleSIMDMaskXY);
        rhs = VectorDoubleAndInt(rhs, s_DoubleSIMDMaskXY);
    }
    else if constexpr(Kind == Reduction::Dot3){
        lhs = VectorDoubleAndInt(lhs, s_DoubleSIMDMask3);
        rhs = VectorDoubleAndInt(rhs, s_DoubleSIMDMask3);
    }
    const SIMDVectorDouble values = Kind == Reduction::Sum ? lhs : VectorDoubleMultiply(lhs, rhs);
    SIMDVectorDouble result = VectorDoubleAdd(VectorDoubleSplatX(values), VectorDoubleSplatY(values));
    if constexpr(Kind == Reduction::Dot2)
        return result;
    result = VectorDoubleAdd(result, VectorDoubleSplatZ(values));
    if constexpr(Kind == Reduction::Dot3)
        return result;
    return VectorDoubleAdd(result, VectorDoubleSplatW(values));
}

template<Reduction::Enum Kind>
FOUNDATION_NOINLINE SIMDVectorDouble CurrentReduction(SIMDVectorDouble lhs, SIMDVectorDouble rhs)noexcept{
#pragma STDC FENV_ACCESS ON
    if constexpr(Kind == Reduction::Dot2)
        return VectorDouble2Dot(lhs, rhs);
    else if constexpr(Kind == Reduction::Dot3)
        return VectorDouble3Dot(lhs, rhs);
    else if constexpr(Kind == Reduction::Dot4)
        return VectorDouble4Dot(lhs, rhs);
    else
        return VectorDoubleSum(lhs);
}

template<Reduction::Enum Kind>
[[nodiscard]] b8 ObserveReductionKind(SIMDVectorDouble input, SIMDVectorDouble multiplier, SIMDVectorDouble& outExpected, i32& outExpectedFlags, SIMDVectorDouble& outActual, i32& outActualFlags)noexcept{
#pragma STDC FENV_ACCESS ON
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    outExpected = OriginalReduction<Kind>(input, multiplier);
    outExpectedFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    outActual = CurrentReduction<Kind>(input, multiplier);
    outActualFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    return true;
}

[[nodiscard]] FOUNDATION_INLINE b8 ObserveReductionByIndex(const u32 kindIndex, const SIMDVectorDouble input, const SIMDVectorDouble multiplier, SIMDVectorDouble& outExpected, i32& outExpectedFlags, SIMDVectorDouble& outActual, i32& outActualFlags)noexcept{
    switch(kindIndex){
    case 0u: return ObserveReductionKind<Reduction::Dot2>(input, multiplier, outExpected, outExpectedFlags, outActual, outActualFlags);
    case 1u: return ObserveReductionKind<Reduction::Dot3>(input, multiplier, outExpected, outExpectedFlags, outActual, outActualFlags);
    case 2u: return ObserveReductionKind<Reduction::Dot4>(input, multiplier, outExpected, outExpectedFlags, outActual, outActualFlags);
    default: return ObserveReductionKind<Reduction::Sum>(input, multiplier, outExpected, outExpectedFlags, outActual, outActualFlags);
    }
}

template<u32 Dimension>
FOUNDATION_NOINLINE SIMDVectorDouble OriginalReciprocalLength(SIMDVectorDouble value)noexcept{
#pragma STDC FENV_ACCESS ON
    if constexpr(Dimension == 2u)
        return VectorDoubleReciprocalSqrt(VectorDouble2LengthSq(value));
    else if constexpr(Dimension == 3u)
        return VectorDoubleReciprocalSqrt(VectorDouble3LengthSq(value));
    else
        return VectorDoubleReciprocalSqrt(VectorDouble4LengthSq(value));
}

template<u32 Dimension, b8 Estimate>
FOUNDATION_NOINLINE SIMDVectorDouble CurrentReciprocalLength(SIMDVectorDouble value)noexcept{
#pragma STDC FENV_ACCESS ON
    if constexpr(Dimension == 2u){
        if constexpr(Estimate)
            return VectorDouble2ReciprocalLengthEst(value);
        else
            return VectorDouble2ReciprocalLength(value);
    }
    else if constexpr(Dimension == 3u){
        if constexpr(Estimate)
            return VectorDouble3ReciprocalLengthEst(value);
        else
            return VectorDouble3ReciprocalLength(value);
    }
    else{
        if constexpr(Estimate)
            return VectorDouble4ReciprocalLengthEst(value);
        else
            return VectorDouble4ReciprocalLength(value);
    }
}

template<u32 Dimension>
[[nodiscard]] b8 ObserveReciprocalLengthDim(SIMDVectorDouble input, SIMDVectorDouble& outExpected, i32& outExpectedFlags, SIMDVectorDouble& outActual, i32& outActualFlags, SIMDVectorDouble& outEstimate, i32& outEstimateFlags)noexcept{
#pragma STDC FENV_ACCESS ON
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    outExpected = OriginalReciprocalLength<Dimension>(input);
    outExpectedFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    outActual = CurrentReciprocalLength<Dimension, false>(input);
    outActualFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    outEstimate = CurrentReciprocalLength<Dimension, true>(input);
    outEstimateFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    return true;
}

[[nodiscard]] FOUNDATION_INLINE b8 ObserveReciprocalLengthByDim(const u32 dimension, const SIMDVectorDouble input, SIMDVectorDouble& outExpected, i32& outExpectedFlags, SIMDVectorDouble& outActual, i32& outActualFlags, SIMDVectorDouble& outEstimate, i32& outEstimateFlags)noexcept{
    switch(dimension){
    case 2u: return ObserveReciprocalLengthDim<2u>(input, outExpected, outExpectedFlags, outActual, outActualFlags, outEstimate, outEstimateFlags);
    case 3u: return ObserveReciprocalLengthDim<3u>(input, outExpected, outExpectedFlags, outActual, outActualFlags, outEstimate, outEstimateFlags);
    default: return ObserveReciprocalLengthDim<4u>(input, outExpected, outExpectedFlags, outActual, outActualFlags, outEstimate, outEstimateFlags);
    }
}

struct PackedDot3ForkResult{
    i32 childPid = -1;
    i32 waitedPid = -1;
    b8 exitedNormally = false;
    i32 exitStatus = -1;
};

#if defined(FOUNDATION_PLATFORM_LINUX) && defined(FOUNDATION_HAS_AVX2)
void TrapPriorityHandler(i32 signalNumber, siginfo_t* information, void* context)noexcept;
#endif

[[nodiscard]] PackedDot3ForkResult RunPackedDot3InvalidPriorityForkChild()noexcept;


