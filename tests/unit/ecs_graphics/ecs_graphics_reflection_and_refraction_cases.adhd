    settings.environmentBottom.z = bit_cast<f32>(0x7F800000u);
    EXPECT_FALSE(ValidateReflectionSettings(settings));
}

void VerifyReflectionSettings_ReflectionHardwareWorkRequiresAnEnabledRouteAndPositiveRayBudget(){
    ReflectionFrameSnapshot snapshot = ReflectionFrameSnapshot();
    snapshot.parameters.hardwareEnabled = 1u;
    snapshot.parameters.maxHardwareRays = 0u;
    EXPECT_FALSE(snapshot.hasHardwareWork());
    snapshot.parameters.maxHardwareRays = 1u;
    EXPECT_TRUE(snapshot.hasHardwareWork());
    snapshot.parameters.hardwareEnabled = 0u;
    EXPECT_FALSE(snapshot.hasHardwareWork());
}

void VerifyReflectionStatistics_RingSkipsWhenThreeReservationsAreOutstanding(){
    RayTracingGraphTestContext<ReflectionStatisticsState> context;
    ASSERT_TRUE(context.inner.control.valid());
    mut ReflectionStatisticsState state = context.inner.control.deref();
    const StatisticsReservationKey first = state.reserve(MakeReflectionStatisticsMetadata());
    const StatisticsReservationKey second = state.reserve(MakeReflectionStatisticsMetadata());
    const StatisticsReservationKey third = state.reserve(MakeReflectionStatisticsMetadata());
    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(second.valid());
    ASSERT_TRUE(third.valid());
    EXPECT_NE(first.slot, second.slot);
    EXPECT_NE(second.slot, third.slot);
    EXPECT_FALSE(state.reserve(MakeReflectionStatisticsMetadata()).valid());
}

void VerifyReflectionStatistics_DiscardedReservationCanBeReusedWithoutStaleCallbackMutation(){
    RayTracingGraphTestContext<ReflectionStatisticsState> context;
    ASSERT_TRUE(context.inner.control.valid());
    mut ReflectionStatisticsState state = context.inner.control.deref();
    const StatisticsReservationKey previous = state.reserve(MakeReflectionStatisticsMetadata());
    state.discard(previous);
    const StatisticsReservationKey current = state.reserve(MakeReflectionStatisticsMetadataAt(10u));
    ASSERT_EQ(previous.slot, current.slot);
    ASSERT_GT(current.sequence, previous.sequence);
    state.discard(previous);
    state.accept(previous, Token(), true);
    state.accept(current, Token(21u), false);
    const ReflectionPendingEntry pending = state.pending(current.slot);
    ASSERT_TRUE(pending.has_value());
    EXPECT_EQ(pending.value().key.sequence, current.sequence);
    EXPECT_EQ(pending.value().token.value, 21u);
}

void VerifyReflectionStatistics_PublishesFrozenMetadataAndNonzeroCountersOnlyAtCompletion(){
    Array<b8, 2> variants = Array<b8, 2>();
    variants[0u] = false;
    variants[1u] = true;
    const ReflectionCounterArray counters = MakeSampleReflectionCounters();
    for(in b8 csgHardwareEnabled : variants){
        RayTracingGraphTestContext<ReflectionStatisticsState> context;
        ASSERT_TRUE(context.inner.control.valid());
        mut ReflectionStatisticsState state = context.inner.control.deref();
        ReflectionStatistics metadata = MakeReflectionStatisticsMetadata();
        metadata.csgHardwareEnabled = csgHardwareEnabled;
        const StatisticsReservationKey key = state.reserve(metadata);
        metadata.frameIndex = 500u;
        metadata.width = 1u;
        metadata.csgHardwareEnabled = !csgHardwareEnabled;
        state.accept(key, Token(), true);
        state.discard(key);
        EXPECT_FALSE(state.tryGetLatestStatistics().has_value());
        state.complete(key, Token(), counters);
        const Expected<ReflectionStatistics> statistics = state.tryGetLatestStatistics();
        ASSERT_TRUE(statistics.has_value());

        EXPECT_EQ(statistics.value().frameIndex, 9u);
        EXPECT_EQ(statistics.value().width, 320u);
        EXPECT_EQ(statistics.value().csgHardwareEnabled, csgHardwareEnabled);
        EXPECT_EQ(statistics.value().queryBudgetUnits, 98u);
        u32 expectedQueries = 98u;
        if(csgHardwareEnabled)
            expectedQueries = 31u;
        EXPECT_EQ(statistics.value().physicalQueries, expectedQueries);
        EXPECT_EQ(statistics.value().candidates, 100u);
    }
}

void VerifyReflectionStatistics_FeedbackEpochSurvivesAcceptedInputMutation(){
    RayTracingGraphTestContext<ReflectionStatisticsState> context;
    ASSERT_TRUE(context.inner.control.valid());
    mut ReflectionStatisticsState state = context.inner.control.deref();
    ReflectionStatistics metadata = MakeReflectionStatisticsMetadata();
    metadata.feedbackRequested = true;
    metadata.feedbackSequence = 12u;
    metadata.schedulingCounterValid = true;
    const StatisticsReservationKey key = state.reserve(metadata);
    ReflectionFeedbackOutcome feedback = ReflectionFeedbackOutcome();
    feedback.epoch = 4u;
    feedback.startGraphicsFrame = 90u;
    feedback.probeIndex = 7u;
    feedback.eligible = true;
    feedback.reused = true;
    ReflectionStatisticsOutcome outcome;
    outcome.feedback = feedback;
    state.accept(key, Token(), true, outcome);
    feedback.epoch = 999u;
    const ReflectionCounterArray counters = ReflectionCounterArray();
    state.complete(key, Token(), counters);
    const Expected<ReflectionStatistics> statistics = state.tryGetLatestStatistics();
    ASSERT_TRUE(statistics.has_value());
    EXPECT_EQ(statistics.value().feedbackEpoch, 4u);
}

void VerifyReflectionStatistics_OlderCompletionsCannotReplaceNewerPublishedWork(){
    RayTracingGraphTestContext<ReflectionStatisticsState> context;
    ASSERT_TRUE(context.inner.control.valid());
    mut ReflectionStatisticsState state = context.inner.control.deref();
    const StatisticsReservationKey older = state.reserve(MakeReflectionStatisticsMetadataAt(10u));
    const StatisticsReservationKey newer = state.reserve(MakeReflectionStatisticsMetadataAt(11u));
    state.accept(older, Token(20u), true);
    state.accept(newer, Token(21u), false);
    const ReflectionCounterArray counters = ReflectionCounterArray();
    state.complete(newer, Token(21u), counters);
    state.complete(older, Token(20u), counters);
    const Expected<ReflectionStatistics> statistics = state.tryGetLatestStatistics();
    ASSERT_TRUE(statistics.has_value());
    EXPECT_EQ(statistics.value().sequence, newer.sequence);
    EXPECT_EQ(statistics.value().frameIndex, 11u);
    EXPECT_FALSE(statistics.value().hardwareReady);
    EXPECT_EQ(state.reserve(MakeReflectionStatisticsMetadata()).slot, older.slot);
}

void VerifyReflectionStatistics_CompletionRequiresExactAcceptedPhysicalToken(){
    RayTracingGraphTestContext<ReflectionStatisticsState> context;
    ASSERT_TRUE(context.inner.control.valid());
    mut ReflectionStatisticsState state = context.inner.control.deref();
    const StatisticsReservationKey key = state.reserve(MakeReflectionStatisticsMetadata());
    state.accept(key, Token(), true);
    const ReflectionCounterArray counters = ReflectionCounterArray();
    QueueSubmissionToken wrong = Token();
    wrong.physicalQueueIndex = 1u;
    state.complete(key, wrong, counters);
    wrong = Token();
    wrong.deviceGeneration = 8u;
    state.complete(key, wrong, counters);
    state.complete(key, Token(19u), counters);
    EXPECT_FALSE(state.tryGetLatestStatistics().has_value());
    state.complete(key, Token(), counters);
    const Expected<ReflectionStatistics> statistics = state.tryGetLatestStatistics();
    ASSERT_TRUE(statistics.has_value());
}

void VerifyReflectionStatistics_ResetRejectsOldCallbacksAndClearsPublication(){
    RayTracingGraphTestContext<ReflectionStatisticsState> context;
    ASSERT_TRUE(context.inner.control.valid());
    mut ReflectionStatisticsState state = context.inner.control.deref();
    const StatisticsReservationKey previous = state.reserve(MakeReflectionStatisticsMetadata());
    state.accept(previous, Token(), true);
    const ReflectionCounterArray counters = ReflectionCounterArray();
    state.complete(previous, Token(), counters);
    state.reset(8u);
    EXPECT_FALSE(state.tryGetLatestStatistics().has_value());
    const StatisticsReservationKey current = state.reserve(MakeReflectionStatisticsMetadataAt(12u));
    EXPECT_GT(current.generation, previous.generation);
    state.accept(previous, Token(), true);
    state.discard(previous);
    state.complete(previous, Token(), counters);
    QueueSubmissionToken next = Token(1u);
    next.deviceGeneration = 8u;
    state.accept(current, next, false);
    state.complete(current, next, counters);
    const Expected<ReflectionStatistics> statistics = state.tryGetLatestStatistics();
    ASSERT_TRUE(statistics.has_value());
    EXPECT_EQ(statistics.value().frameIndex, 12u);
    EXPECT_EQ(statistics.value().acceptedToken.deviceGeneration, 8u);
}

void VerifyReflectionStatistics_FailedMappingRetiresSlotWithoutPublishingZeros(){
    RayTracingGraphTestContext<ReflectionStatisticsState> context;
    ASSERT_TRUE(context.inner.control.valid());
    mut ReflectionStatisticsState state = context.inner.control.deref();
    const StatisticsReservationKey key = state.reserve(MakeReflectionStatisticsMetadata());
    state.accept(key, Token(), true);
    state.complete(key, Token(), Span<u32>());
    EXPECT_FALSE(state.tryGetLatestStatistics().has_value());
    EXPECT_EQ(state.reserve(MakeReflectionStatisticsMetadata()).slot, key.slot);
}

void VerifyReflectionStatistics_InvalidAcceptedTokenQuarantinesSlotUntilReset(){
    RayTracingGraphTestContext<ReflectionStatisticsState> context;
    ASSERT_TRUE(context.inner.control.valid());
    mut ReflectionStatisticsState state = context.inner.control.deref();
    const StatisticsReservationKey key = state.reserve(MakeReflectionStatisticsMetadata());
    state.accept(key, QueueSubmissionToken(), true);
    state.discard(key);
    EXPECT_FALSE(state.pending(key.slot).has_value());
    EXPECT_FALSE(state.pending(s_StatisticsReadbackSlotCount).has_value());
    EXPECT_FALSE(state.pending(u32.max).has_value());
    EXPECT_NE(state.reserve(MakeReflectionStatisticsMetadata()).slot, key.slot);
    state.reset(7u);
    EXPECT_EQ(state.reserve(MakeReflectionStatisticsMetadata()).slot, key.slot);
}

void VerifyReflectionStatistics_MovingLeaseTransfersOwnershipAndReclaimsAssignmentDestination(){
    RayTracingGraphTestContext<ReflectionStatisticsState> context;
    ASSERT_TRUE(context.inner.control.valid());
    mut ReflectionStatisticsState state = context.inner.control.deref();
    {
        ReflectionStatisticsReservation first(context.inner.control, MakeReflectionStatisticsMetadata());
        const u32 firstSlot = first.slotIndex();
        TestValueSlot<ReflectionStatisticsReservation> secondStorage;
        mut ReflectionStatisticsReservation second = secondStorage.take(first);
        EXPECT_FALSE(first.valid());
        EXPECT_EQ(second.slotIndex(), firstSlot);
        ReflectionStatisticsReservation third(context.inner.control, MakeReflectionStatisticsMetadata());
        const u32 replacedSlot = third.slotIndex();
        TestMoveAssign<ReflectionStatisticsReservation>(third, second);
        EXPECT_FALSE(second.valid());
        EXPECT_EQ(third.slotIndex(), firstSlot);
        EXPECT_EQ(state.reserve(MakeReflectionStatisticsMetadata()).slot, replacedSlot);
    }
}

void VerifyReflectionStatistics_AcceptedLeaseRemainsInFlightAfterPayloadDestruction(){
    RayTracingGraphTestContext<ReflectionStatisticsState> context;
    ASSERT_TRUE(context.inner.control.valid());
    mut ReflectionStatisticsState state = context.inner.control.deref();
    u32 index = 0u;
    {
        ReflectionStatisticsReservation lease(context.inner.control, MakeReflectionStatisticsMetadata());
        index = lease.slotIndex();
        lease.acceptReservation(Token(), true);
    }
    EXPECT_NE(state.reserve(MakeReflectionStatisticsMetadata()).slot, index);
    const ReflectionPendingEntry pending = state.pending(index);
    ASSERT_TRUE(pending.has_value());
    const ReflectionCounterArray counters = ReflectionCounterArray();
    state.complete(pending.value().key, pending.value().token, counters);
    EXPECT_EQ(state.reserve(MakeReflectionStatisticsMetadata()).slot, index);
}

void VerifyReflectionStatistics_RejectedGraphRegistrationAndGraphResetReleaseUnacceptedLeases(){
    RayTracingGraphTestContext<ReflectionStatisticsState> context;
    ASSERT_TRUE(context.inner.control.valid());
    mut ReflectionStatisticsState state = context.inner.control.deref();
    EXPECT_FALSE(context.addLeaseTask<ReflectionStatisticsLeaseTask, ReflectionStatistics>(GpuTaskDesc(), MakeReflectionStatisticsMetadata()).has_value());
    EXPECT_EQ(state.reserve(MakeReflectionStatisticsMetadata()).slot, 0u);
    state.reset(1u);
    {
        const Expected<GpuTaskId> gpuTaskAdmission = context.addLeaseTask<ReflectionStatisticsLeaseTask, ReflectionStatistics>(MakeReflectionStatisticsTaskDesc(), MakeReflectionStatisticsMetadata());
        ASSERT_TRUE(gpuTaskAdmission.has_value());
        ASSERT_TRUE(gpuTaskAdmission.value().valid());
    }
    context.graph.reset();
    EXPECT_EQ(state.reserve(MakeReflectionStatisticsMetadata()).slot, 0u);
}

void VerifyReflectionStatistics_PayloadDestructionReclaimsLeaseWithoutDiscardCallback(){
    RayTracingGraphTestContext<ReflectionStatisticsState> context;
