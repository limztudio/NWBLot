#include <impl/ecs_render/optics/graph_types.adhd>
#include <impl/ecs_render/kernel/task_graph_resource_utils.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[move_only]
class OpticalUploadTask{
    private BufferHandle m_destination;
    private GpuUploadBlobId m_source;
    private RayTracingOpticalSceneUploadHandle m_upload;
    private RayTracingOpticalUploadReservation m_reservation;
    private GpuPhysicalQueueId m_queue;

    public OpticalUploadTask(in BufferHandle destination, in RayTracingOpticalSceneUploadHandle upload, in RayTracingOpticalUploadControlHandle control, in RayTracingOpticalUploadPlan plan){
        this.m_destination = destination;
        this.m_upload = upload;
        this.m_reservation = RayTracingOpticalUploadReservation(control, plan);
        this.m_queue = plan.queue;
    }

    public b8 reserved()const{ return this.m_reservation.valid(); }

    public void setSource(in GpuUploadBlobId source){ this.m_source = source; }

    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements commands;
        commands.requiredCapabilities = GpuQueueCapability::Transfer;
        commands.requiresPrimaryGraphicsQueue = true;
        return commands;
    }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        const auto bytes = context.declarations.uploadBlobData(this.m_source);
        if(!bytes.has_value() || !this.m_upload.valid())
            return false;
        if(!ValidOpticalUploadRecordState(
            this.m_destination.valid(), true, true, bytes.value().size(), this.m_upload.deref().bytes.size(),
            this.m_reservation.valid(), context.commandIrCapture, context.queue == this.m_queue
        ))
            return false;
        commandList.endRenderPass();
        const BufferRange range = BufferRange(0u, bytes.value().size());
        commandList.setBufferState(this.m_destination.deref(), ResourceStates::CopyDest, false, range);
        commandList.commitBarriers();
        if(!commandList.tryWriteBuffer(this.m_destination.deref(), bytes.value().span(), 0u))
            return false;
        commandList.setBufferState(this.m_destination.deref(), ResourceStates::Common, false, range);
        commandList.commitBarriers();
        return true;
    }

    public void accepted(in QueueSubmissionToken token){
        if(!this.m_reservation.accept(token))
            LogInvalidAcceptedOpticalUploadProvenance();
    }

    public void discarded(){
        this.m_reservation.discard();
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidOpticalUploadRecordState(
    in b8 hasDestination,
    in b8 hasUpload,
    in b8 hasBytes,
    in usize blobByteSize,
    in usize uploadByteSize,
    in b8 reservationValid,
    in b8 commandIrCapture,
    in b8 matchesQueue
){
    return
        hasDestination
        && hasUpload
        && hasBytes
        && blobByteSize != 0u
        && blobByteSize == uploadByteSize
        && reservationValid
        && !commandIrCapture
        && matchesQueue
    ;
}

void LogInvalidAcceptedOpticalUploadProvenance(){
    error("Ray optical scene: accepted upload has invalid residency provenance");
}

Expected<RayTracingOpticalSceneGraphBuffer> ImportOpticalSceneUpload(in RayTracingOpticalSceneSnapshot resources, in borrow GpuTaskId priorReadersDrained, mut GpuTaskGraph graph){
    if(!resources.valid())
        return MakeUnexpected(Failure());
    BufferHandle uploadBuffer = resources.buffer;
    if(resources.uploadBuffer.valid())
        uploadBuffer = resources.uploadBuffer;
    in BufferDesc bufferDesc = uploadBuffer.deref().getCreationDescription();
    const usize byteSize = resources.upload.deref().bytes.size();
    if(
        !bufferDesc.debugName || !OpticalUploadByteSizeFits(byteSize, bufferDesc.byteSize, size_of<u32>())
        || bufferDesc.isVolatile || !bufferDesc.keepInitialState || bufferDesc.initialState != ResourceStates::Common
        || uploadBuffer.deref().resolveTaskGraphImportInitialState() != ResourceStates::Common
    )
        return MakeUnexpected(Failure());

    const RayTracingOpticalUploadPlan plan = resources.uploadState.deref().plan(resources.upload);
    if(!plan.valid() || plan.buffer.identity() != uploadBuffer.identity())
        return MakeUnexpected(Failure());
    OpticalUploadTask task(uploadBuffer, resources.upload, resources.uploadState, plan);
    if(!plan.reused && !task.reserved())
        return MakeUnexpected(Failure());

    GpuGraphResourceDesc resourceDesc = BufferResourceDesc(bufferDesc.debugName, "Ray Optical Scene Buffer");
    resourceDesc.setInitialState(ResourceStates::Common).setExternalFinalState(ResourceStates::Common);
    if(plan.acceptedToken.valid()){
        GpuExternalCompletionDesc readyDesc;
        readyDesc.setIdentity(Name(s_RenderNameRenderRaytraceOpticalSceneReady)).setMarkerLabel("Ray Optical Scene Ready").setToken(plan.acceptedToken);
        const auto readyResult = graph.importExternalCompletion(readyDesc);
        if(!readyResult.has_value())
            return MakeUnexpected(Failure());
        const GpuExternalCompletionId ready = readyResult.value();
        resourceDesc.setInitialAvailabilityCompletion(ready);
    }
    RayTracingOpticalSceneGraphBuffer result;
    const auto resourceResult = graph.importBuffer(uploadBuffer, resourceDesc);
    if(!resourceResult.has_value())
        return MakeUnexpected(Failure());
    result.resource = resourceResult.value();
    result.reused = plan.reused;
    if(result.reused)
        return result;

    const auto blobResult = graph.copyUploadBytes<u32>(Span<u8>(resources.upload.deref().bytes));
    if(!blobResult.has_value())
        return MakeUnexpected(Failure());
    const GpuUploadBlobId blob = blobResult.value();
    Array<GpuTaskResourceUse, 2u> uses;
    uses[0u] = WriteUse(result.resource, ResourceStates::CopyDest);
    uses[1u] = WriteUse(result.resource, ResourceStates::Common);
    uses[0u].range.bufferRange = BufferRange(0u, byteSize);
    uses[1u].range.bufferRange = BufferRange(0u, byteSize);
    GpuTaskSchedulingHint scheduling;
    scheduling.cost = GpuTaskCostHint::Tiny;
    scheduling.forceSubmissionBoundary = false;
    scheduling.allowPacketMerge = true;
    scheduling.mergeWithPrevious = true;
    scheduling.allowMergeAcrossConsumerFrontier = true;
    GpuTaskDesc desc;
    desc
        .setIdentity(Name(s_RenderNameRenderRaytraceOpticalSceneUpload))
        .setMarkerLabel("Ray Optical Scene Upload")
        .setScheduling(scheduling)
        .setResourceUses(Span<GpuTaskResourceUse>(uses))
    ;
    if(priorReadersDrained.valid())
        desc.setDependency(priorReadersDrained);
    task.setSource(blob);
    const auto uploadTaskResult = graph.addPreparedPayloadTask(desc, task);
    if(!uploadTaskResult.has_value())
        return MakeUnexpected(uploadTaskResult.error());
    result.uploadTask = uploadTaskResult.value();
    if(!result.valid())
        return MakeUnexpected(Failure());
    return result;
}


