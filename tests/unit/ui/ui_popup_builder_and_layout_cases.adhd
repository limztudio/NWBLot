const StringView s_UiPopupBuilderPopupKey = "popup";
const StringView s_UiPopupBuilderApplyKey = "apply";
const StringView s_UiPopupBuilderCloseKey = "close";
const StringView s_UiPopupBuilderLaterKey = "later";
const StringView s_UiPopupContextBaseKey = "base";
const StringView s_UiPopupContextPopupKey = "popup";
const StringView s_UiPopupContextChildKey = "child";

Point MakeUiPopupPoint(in f32 x, in f32 y){
    Point point = Point();
    point.x = x;
    point.y = y;
    return point;
}

Rect MakeUiPopupRect(in f32 x, in f32 y, in f32 width, in f32 height){
    Rect rect = Rect();
    rect.x = x;
    rect.y = y;
    rect.width = width;
    rect.height = height;
    return rect;
}

DisplayMetrics MakeUiPopupDisplay(in f32 logicalWidth, in f32 logicalHeight, in f32 pixelScaleX, in f32 pixelScaleY){
    DisplayMetrics metrics = DisplayMetrics();
    metrics.logicalWidth = logicalWidth;
    metrics.logicalHeight = logicalHeight;
    metrics.pixelScaleX = pixelScaleX;
    metrics.pixelScaleY = pixelScaleY;
    return metrics;
}

PopupOptions MakeUiPopupAnchoredOptions(){
    PopupOptions options = PopupOptions();
    options.anchor = MakeUiPopupRect(40.0f, 60.0f, 80.0f, 24.0f);
    options.size.x = 220.0f;
    options.size.y = 160.0f;
    return options;
}

WidgetOptions MakeUiPopupControlOptionsSized(in f32 width, in f32 height){
    WidgetOptions options = WidgetOptions();
    options.width.policy = LayoutSizePolicy::Fixed;
    options.width.value = width;
    options.height.policy = LayoutSizePolicy::Fixed;
    options.height.value = height;
    return options;
}

WidgetOptions MakeUiPopupControlOptions(){
    return MakeUiPopupControlOptionsSized(120.0f, 30.0f);
}

InputEvent MakeUiPopupBareEvent(in InputEventTypeEnum type){
    InputEvent event = InputEvent();
    event.type = type;
    return event;
}

InputEvent MakeUiPopupKeyEvent(in InputEventTypeEnum type, in KeyEnum key){
    InputEvent event = InputEvent();
    event.type = type;
    event.key = key;
    return event;
}

void ExpectUiPopupLayoutPlacementRejected(in PopupOptions options, in DisplayMetrics display){
    EXPECT_FALSE(PlacePopup(options, display).has_value());
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyUiPopupBuilderTests_ModalBackdropAndBodyRenderAboveAPanelDeclaredByALaterRoot(mut UiPopupBuilderTests self){
    PopupState state = PopupState();
    state.open();
    PopupOptions options = MakeUiPopupAnchoredOptions();
    options.modal = true;
    options.side = PopupPlacementSide::Center;
    options.size.x = 180.0f;
    options.size.y = 120.0f;
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiPopupBuilderPopupKey, state, options));
    EXPECT_FALSE(self.m_builder.button(s_UiPopupBuilderApplyKey, "Apply", MakeUiPopupControlOptions()));
    ASSERT_TRUE(self.m_builder.endPopup());
    ASSERT_TRUE(self.m_context.endRoot());
    WidgetRoot laterRoot = WidgetRoot();
    laterRoot.value = 87u;
    laterRoot.generation = 1u;
    ASSERT_TRUE(self.m_context.beginRoot(laterRoot));
    ASSERT_TRUE(self.m_builder.beginPanel("later", MakeUiPopupRect(0.0f, 0.0f, 800.0f, 600.0f)));
    EXPECT_FALSE(self.m_builder.button(s_UiPopupBuilderApplyKey, "Later", MakeUiPopupControlOptions()));
    ASSERT_TRUE(self.m_builder.endPanel());
    ASSERT_TRUE(self.finishRoot());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    ASSERT_GE(snapshot.commands().size(), 4u);
    usize firstOverlay = snapshot.commands().size();
    for(usize index = 0u; index < snapshot.commands().size(); ++index){
        if(snapshot.commands()[index].layer == 1u && firstOverlay == snapshot.commands().size())
            firstOverlay = index;
        if(firstOverlay != snapshot.commands().size())
            EXPECT_EQ(snapshot.commands()[index].layer, 1u);
        else
            EXPECT_EQ(snapshot.commands()[index].layer, 0u);
    }
    ASSERT_GT(firstOverlay, 0u);
    ASSERT_LT(firstOverlay, snapshot.commands().size());
    const DrawCommand backdrop = snapshot.commands()[firstOverlay];
    EXPECT_EQ(backdrop.material, PaintMaterial::Solid);
    EXPECT_EQ(backdrop.firstIndex, 0u);
    EXPECT_EQ(backdrop.indexCount, 6u);
    EXPECT_GT(snapshot.commands()[0u].firstIndex, backdrop.firstIndex);
    ExpectUiRect(backdrop.clip, MakeUiPopupRect(0.0f, 0.0f, 800.0f, 600.0f));
    const Vertex first = snapshot.vertices()[snapshot.indices()[backdrop.firstIndex]];
    const Vertex opposite = snapshot.vertices()[snapshot.indices()[backdrop.firstIndex + 2u]];
    EXPECT_FLOAT_EQ(first.position.x, 0.0f);
    EXPECT_FLOAT_EQ(first.position.y, 0.0f);
    EXPECT_FLOAT_EQ(opposite.position.x, 800.0f);
    EXPECT_FLOAT_EQ(opposite.position.y, 600.0f);
    EXPECT_FLOAT_EQ(first.color.a, self.m_builder.popupStyle().backdrop.a);
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const WidgetId child = self.id(s_UiPopupBuilderApplyKey, s_UiPopupBuilderPopupKey);
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiPopupPoint(325.0f, 255.0f)), child);
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiPopupPoint(10.0f, 10.0f)).valid());
    EXPECT_TRUE(self.m_context.input().wouldConsumePointer(MakeUiPopupPoint(10.0f, 10.0f)));
}

void VerifyUiPopupBuilderTests_ClosingFromTheBodySkipsBackdropBodyPaintAndCandidateTargets(mut UiPopupBuilderTests self){
    PopupState state = PopupState();
    state.open();
    PopupOptions options = MakeUiPopupAnchoredOptions();
    options.modal = true;
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiPopupBuilderPopupKey, state, options));
    EXPECT_FALSE(self.m_builder.button(s_UiPopupBuilderCloseKey, "Close", MakeUiPopupControlOptions()));
    ASSERT_TRUE(self.finishPopup());
    const DrawSnapshot first = self.m_paint.freeze();
    EXPECT_FALSE(first.commands().empty());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const WidgetId closeId = self.id(s_UiPopupBuilderCloseKey, s_UiPopupBuilderPopupKey);
    const auto closeTarget = self.findTarget(closeId);
    ASSERT_TRUE(closeTarget.has_value());
    self.click(MakeUiPopupPoint(closeTarget.value().rectangle.x + 4.0f, closeTarget.value().rectangle.y + 4.0f));
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiPopupBuilderPopupKey, state, options));
    EXPECT_TRUE(self.m_builder.button(s_UiPopupBuilderCloseKey, "Close", MakeUiPopupControlOptions()));
    state.close();
    ASSERT_TRUE(self.m_builder.endPopup());
    EXPECT_TRUE(self.m_builder.balanced());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_TRUE(self.m_context.input().actions().empty());
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiPopupPoint(55.0f, 100.0f)).valid());
    ASSERT_TRUE(self.m_builder.beginPanel("base", MakeUiPopupRect(0.0f, 0.0f, 100.0f, 80.0f)));
    EXPECT_FALSE(self.m_builder.button(s_UiPopupBuilderApplyKey, "Base", MakeUiPopupControlOptionsSized(80.0f, 24.0f)));
    ASSERT_TRUE(self.m_builder.endPanel());
    ASSERT_TRUE(self.finishRoot());
    const DrawSnapshot closed = self.m_paint.freeze();
    ASSERT_FALSE(closed.commands().empty());
    for(in DrawCommand command : closed.commands()){
        EXPECT_EQ(command.layer, 0u);
        EXPECT_NE(command.material, PaintMaterial::Solid);
    }
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_FALSE(self.hasTarget(self.ownerId()));
    EXPECT_FALSE(self.hasTarget(closeId));
    EXPECT_TRUE(self.hasTarget(self.id(s_UiPopupBuilderApplyKey, "base")));
}

void VerifyUiPopupBuilderTests_ClosingAfterTheFirstQueuedButtonPreventsLaterQueuedActionsInTheSameBody(mut UiPopupBuilderTests self){
    PopupState state = PopupState();
    state.open();
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiPopupBuilderPopupKey, state, MakeUiPopupAnchoredOptions()));
    EXPECT_FALSE(self.m_builder.button(s_UiPopupBuilderCloseKey, "Close", MakeUiPopupControlOptions()));
    EXPECT_FALSE(self.m_builder.button(s_UiPopupBuilderLaterKey, "Later", MakeUiPopupControlOptions()));
    ASSERT_TRUE(self.finishPopup());
    const DrawSnapshot first = self.m_paint.freeze();
    EXPECT_FALSE(first.commands().empty());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const auto closeTarget = self.findTarget(self.id(s_UiPopupBuilderCloseKey, s_UiPopupBuilderPopupKey));
    const auto laterTarget = self.findTarget(self.id(s_UiPopupBuilderLaterKey, s_UiPopupBuilderPopupKey));
    ASSERT_TRUE(closeTarget.has_value());
    ASSERT_TRUE(laterTarget.has_value());
    self.click(MakeUiPopupPoint(closeTarget.value().rectangle.x + 4.0f, closeTarget.value().rectangle.y + 4.0f));
    self.click(MakeUiPopupPoint(laterTarget.value().rectangle.x + 4.0f, laterTarget.value().rectangle.y + 4.0f));
    ASSERT_EQ(self.m_context.input().actions().size(), 2u);
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiPopupBuilderPopupKey, state, MakeUiPopupAnchoredOptions()));
    ASSERT_TRUE(self.m_builder.button(s_UiPopupBuilderCloseKey, "Close", MakeUiPopupControlOptions()));
    state.close();
    EXPECT_FALSE(self.m_builder.button(s_UiPopupBuilderLaterKey, "Later", MakeUiPopupControlOptions()));
    EXPECT_TRUE(self.m_context.input().actions().empty());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    ASSERT_TRUE(self.finishPopup());
    const DrawSnapshot closed = self.m_paint.freeze();
    EXPECT_TRUE(closed.commands().empty());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_TRUE(self.m_context.input().targets().empty());
}

void VerifyUiPopupBuilderTests_EditBoxAfterBodyCloseDoesNotLendItsModelOrChangeHostState(mut UiPopupBuilderTests self){
    PopupState state = PopupState();
    state.open();
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiPopupBuilderPopupKey, state, MakeUiPopupAnchoredOptions()));
    EXPECT_FALSE(self.m_builder.button(s_UiPopupBuilderCloseKey, "Close", MakeUiPopupControlOptions()));
    ASSERT_TRUE(self.finishPopup());
    const DrawSnapshot first = self.m_paint.freeze();
    EXPECT_FALSE(first.commands().empty());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const auto closeTarget = self.findTarget(self.id(s_UiPopupBuilderCloseKey, s_UiPopupBuilderPopupKey));
    ASSERT_TRUE(closeTarget.has_value());
    self.click(MakeUiPopupPoint(closeTarget.value().rectangle.x + 4.0f, closeTarget.value().rectangle.y + 4.0f));
    EditModel model = EditModel(self.m_arena);
    ASSERT_TRUE(model.setText("kept"));
    ASSERT_TRUE(model.setSelection(1u, 3u));
    const u64 revision = model.revision();
    const u64 externalRevision = model.externalRevision();
    EditBoxState editState = EditBoxState();
    editState.scroll = 17.0f;
    editState.caretElapsed = 0.25f;
    UiPopupCountingEditHost host = UiPopupCountingEditHost();
    self.useEditHost(host);
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiPopupBuilderPopupKey, state, MakeUiPopupAnchoredOptions()));
    ASSERT_TRUE(self.m_builder.button(s_UiPopupBuilderCloseKey, "Close", MakeUiPopupControlOptions()));
    state.close();
    const EditBoxResult result = self.m_builder.editBox("edit", model, editState);
    EXPECT_TRUE(result.valid);
    EXPECT_FALSE(result.textChanged);
    EXPECT_FALSE(result.selectionChanged);
    EXPECT_FALSE(result.focused);
    EXPECT_EQ(host.loans, 0u);
    EXPECT_EQ(host.publications, 0u);
    EXPECT_EQ(model.text(), "kept");
    EXPECT_EQ(model.revision(), revision);
    EXPECT_EQ(model.externalRevision(), externalRevision);
    EXPECT_EQ(model.anchor(), 1u);
    EXPECT_EQ(model.caret(), 3u);
    EXPECT_FALSE(model.canUndo());
    EXPECT_FLOAT_EQ(editState.scroll, 17.0f);
    EXPECT_FLOAT_EQ(editState.caretElapsed, 0.25f);
    EXPECT_EQ(editState.modelGeneration, 0u);
    ASSERT_TRUE(self.finishPopup());
    const DrawSnapshot closed = self.m_paint.freeze();
    EXPECT_TRUE(closed.commands().empty());
    EXPECT_EQ(host.loans, 0u);
    EXPECT_EQ(host.publications, 0u);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_FALSE(self.hasTarget(self.id("edit", s_UiPopupBuilderPopupKey)));
    self.clearEditHost();
}

void VerifyUiPopupBuilderTests_CloseAndReopenInTheBodySkipsOldEpochPaintAndActionsUntilTheNextFrame(mut UiPopupBuilderTests self){
    PopupState state = PopupState();
    state.open();
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiPopupBuilderPopupKey, state, MakeUiPopupAnchoredOptions()));
    EXPECT_FALSE(self.m_builder.button(s_UiPopupBuilderCloseKey, "Close", MakeUiPopupControlOptions()));
    EXPECT_FALSE(self.m_builder.button(s_UiPopupBuilderLaterKey, "Later", MakeUiPopupControlOptions()));
    ASSERT_TRUE(self.finishPopup());
    const DrawSnapshot first = self.m_paint.freeze();
    EXPECT_FALSE(first.commands().empty());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const auto ownerTarget = self.findTarget(self.ownerId());
    ASSERT_TRUE(ownerTarget.has_value());
    const PopupToken oldToken = ownerTarget.value().popup;
    const auto closeTarget = self.findTarget(self.id(s_UiPopupBuilderCloseKey, s_UiPopupBuilderPopupKey));
    const auto laterTarget = self.findTarget(self.id(s_UiPopupBuilderLaterKey, s_UiPopupBuilderPopupKey));
    ASSERT_TRUE(closeTarget.has_value());
    ASSERT_TRUE(laterTarget.has_value());
    self.click(MakeUiPopupPoint(closeTarget.value().rectangle.x + 4.0f, closeTarget.value().rectangle.y + 4.0f));
    self.click(MakeUiPopupPoint(laterTarget.value().rectangle.x + 4.0f, laterTarget.value().rectangle.y + 4.0f));
    ASSERT_EQ(self.m_context.input().actions().size(), 2u);
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiPopupBuilderPopupKey, state, MakeUiPopupAnchoredOptions()));
    ASSERT_TRUE(self.m_builder.button(s_UiPopupBuilderCloseKey, "Close", MakeUiPopupControlOptions()));
    state.close();
    state.open();
    EXPECT_GT(state.openGeneration(), oldToken.openGeneration);
    EXPECT_FALSE(self.m_builder.button(s_UiPopupBuilderLaterKey, "Later", MakeUiPopupControlOptions()));
    EXPECT_TRUE(self.m_context.input().actions().empty());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    ASSERT_TRUE(self.finishPopup());
    EXPECT_TRUE(state.isOpen());
    const DrawSnapshot reopening = self.m_paint.freeze();
    EXPECT_TRUE(reopening.commands().empty());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_TRUE(self.m_context.input().targets().empty());
    ASSERT_TRUE(self.begin(3u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiPopupBuilderPopupKey, state, MakeUiPopupAnchoredOptions()));
    EXPECT_FALSE(self.m_builder.button(s_UiPopupBuilderCloseKey, "Close", MakeUiPopupControlOptions()));
    EXPECT_FALSE(self.m_builder.button(s_UiPopupBuilderLaterKey, "Later", MakeUiPopupControlOptions()));
    ASSERT_TRUE(self.finishPopup());
    const DrawSnapshot reopened = self.m_paint.freeze();
    EXPECT_FALSE(reopened.commands().empty());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    const auto reopenedOwnerTarget = self.findTarget(self.ownerId());
    ASSERT_TRUE(reopenedOwnerTarget.has_value());
    EXPECT_EQ(reopenedOwnerTarget.value().popup.instanceGeneration, oldToken.instanceGeneration);
    EXPECT_EQ(reopenedOwnerTarget.value().popup.openGeneration, state.openGeneration());
    EXPECT_TRUE(self.m_context.input().actions().empty());
    const auto reopenedLater = self.findTarget(self.id(s_UiPopupBuilderLaterKey, s_UiPopupBuilderPopupKey));
    ASSERT_TRUE(reopenedLater.has_value());
    self.click(MakeUiPopupPoint(reopenedLater.value().rectangle.x + 4.0f, reopenedLater.value().rectangle.y + 4.0f));
    ASSERT_TRUE(self.begin(4u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiPopupBuilderPopupKey, state, MakeUiPopupAnchoredOptions()));
    EXPECT_FALSE(self.m_builder.button(s_UiPopupBuilderCloseKey, "Close", MakeUiPopupControlOptions()));
    EXPECT_TRUE(self.m_builder.button(s_UiPopupBuilderLaterKey, "Later", MakeUiPopupControlOptions()));
    ASSERT_TRUE(self.finishPopup());
    const DrawSnapshot active = self.m_paint.freeze();
    EXPECT_FALSE(active.commands().empty());
    ASSERT_TRUE(self.m_context.commitFrame(4u));
}

