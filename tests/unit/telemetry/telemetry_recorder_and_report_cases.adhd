void VerifyTelemetry_RecorderFiltersOwnsCallerPayloadAndRejectsEndIndex(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureFrameGraphOnly());

    TelemetryBytes perfPayload = TelemetryBytes(testArena.arena);
    perfPayload.push_back(1u);
    perfPayload.push_back(2u);
    EXPECT_FALSE(RecordBinaryBytes(recorder, EventKind::PerfFrame, 12u, perfPayload));
    EXPECT_EQ(recorder.eventCount(), 0u);

    TelemetryBytes frameGraphPayload = TelemetryBytes(testArena.arena);
    frameGraphPayload.push_back(4u);
    frameGraphPayload.push_back(5u);
    frameGraphPayload.push_back(6u);
    EXPECT_TRUE(RecordBinaryBytes(recorder, EventKind::FrameGraphFrame, 13u, frameGraphPayload, 7u));
    frameGraphPayload[0u] = 99u;

