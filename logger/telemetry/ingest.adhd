////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <logger/telemetry/report.adhd>
#include <logger/telemetry/report_types.adhd>
#include <logger/telemetry/report_values.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <core/telemetry/codec.h>

#include <global/filesystem/operations.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_LOG_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct TelemetryIngestConfig{
    Path storageDirectory;


public:
    explicit TelemetryIngestConfig(LogArena& arena)noexcept
        : storageDirectory(arena)
    {}
};

struct TelemetryIngestResult{
    LogString message;
    Path rawPath;
    Path jsonPath;
    Path perfCsvPath;
    Path graphPath;
    Core::Common::LogType::Enum type = Core::Common::LogType::Info;
    b8 storedRaw = false;
    b8 wroteJson = false;
    b8 wrotePerfCsv = false;
    b8 wroteGraph = false;
    b8 rawStagingRetained = false;
    ErrorCode rawCleanupError;
    Core::Telemetry::DecodeResult decode;
    TelemetryReportSummary summary;


public:
    explicit TelemetryIngestResult(LogArena& arena)noexcept
        : message(arena)
        , rawPath(arena)
        , jsonPath(arena)
        , perfCsvPath(arena)
        , graphPath(arena)
    {}


public:
    [[nodiscard]] b8 ok()const noexcept{
        return storedRaw && !rawCleanupError && decode.ok() && wroteJson && wrotePerfCsv && summary.parseFailureCount == 0u;
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] TelemetryIngestResult ProcessTelemetryUpload(LogArena& arena, const void* bytes, usize byteCount, const TelemetryIngestConfig& config);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_LOG_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_TelemetryEmptyUploadErrorText = "Telemetry upload is empty";
const StringView s_TelemetryStorageDirectoryErrorText = "Telemetry upload could not create storage directories";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 HasTelemetryParseFailures(in u64 parseFailureCount){
    return parseFailureCount != 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <logger/common.h>

#include <core/alloc/scratch.h>

#include <global/binary.h>
#include <global/filesystem/exclusive_publication.h>
#include <global/filesystem/executable_paths.h>
#include <global/process.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_LOG_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_telemetry_ingest{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using ScratchPath = ::Path<Core::Alloc::ScratchArena>;

static Atomic<u64> s_TelemetryUploadCounter{ 1u };


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] ScratchPath MakeTelemetryUploadStem(Core::Alloc::ScratchArena& arena){
    const auto timeResult = GetLocalTime();
    if(!timeResult)
        NWB_LOGGER_WARNING(FOUNDATION_TEXT("Failed to read local time for telemetry upload name"));
    const LocalTime localTime = timeResult ? *timeResult : LocalTime{};

    const u64 counter = s_TelemetryUploadCounter.fetch_add(1u, MemoryOrder::relaxed);
    const auto fileName = StringFormat(
        arena,
        FOUNDATION_TEXT("telemetry_{:04}{:02}{:02}_{:02}{:02}{:02}_{}_{}"),
        localTime.tm_year + s_LocalTimeYearBase,
        localTime.tm_mon + s_LocalTimeMonthBase,
        localTime.tm_mday,
        localTime.tm_hour,
        localTime.tm_min,
        localTime.tm_sec,
        CurrentProcessId(),
        counter
    );

    return ScratchPath(arena, fileName);
}

void SetResultMessage(TelemetryIngestResult& result, AStringView message, const Core::Common::LogType::Enum type){
    result.message = ConvertString(result.message.get_allocator().arena(), message);
    result.type = type;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


TelemetryIngestResult ProcessTelemetryUpload(LogArena& arena, const void* const bytes, const usize byteCount, const TelemetryIngestConfig& config){
    TelemetryIngestResult result(arena);
    if(!bytes || byteCount == 0u){
        __hidden_telemetry_ingest::SetResultMessage(result, s_TelemetryEmptyUploadErrorText, Core::Common::LogType::Error);
        return result;
    }

    Core::Alloc::ScratchArena scratchArena{Name(s_LogTelemetryArenaNameLoggerTelemetryReport)};
    const auto storageDirectory = ExecutablePaths(scratchArena).storageDirectory(config.storageDirectory, s_LogTelemetryIngestStorageDirectoryName);
    const auto rawDirectory = storageDirectory / s_LogTelemetryIngestRawDirectoryName;
    const auto reportDirectory = storageDirectory / s_LogTelemetryIngestReportDirectoryName;
    if(!EnsureDirectories(rawDirectory) || !EnsureDirectories(reportDirectory)){
        __hidden_telemetry_ingest::SetResultMessage(result, s_TelemetryStorageDirectoryErrorText, Core::Common::LogType::Error);
        return result;
    }

    const auto uploadStem = __hidden_telemetry_ingest::MakeTelemetryUploadStem(scratchArena);
    result.rawPath = rawDirectory / uploadStem;
    result.rawPath.replaceExtension(s_LogTelemetryIngestRawStreamFileExtension);
    result.jsonPath = reportDirectory / uploadStem;
    result.jsonPath.replaceExtension(s_LogTelemetryIngestJsonFileExtension);
    result.perfCsvPath = reportDirectory / uploadStem;
    result.perfCsvPath.replaceExtension(s_LogTelemetryIngestPerfCsvFileExtension);
    result.graphPath = reportDirectory / uploadStem;
    result.graphPath.replaceExtension(s_LogTelemetryIngestGraphFileExtension);

    const auto rawPublication = PublishNewFileDurable(result.rawPath, BinaryByteView{ static_cast<const u8*>(bytes), byteCount });
    result.storedRaw = rawPublication.published;
    if(rawPublication.error && !rawPublication.published){
        result.message = StringFormat(arena, FOUNDATION_TEXT("Telemetry raw publication failed: raw='{}' staging_retained={} error={}"), PathToString<tchar>(result.rawPath), rawPublication.stagingRetained, rawPublication.error.value());
        result.type = Core::Common::LogType::Error;
        return result;
    }
    result.rawCleanupError = rawPublication.error;
    result.rawStagingRetained = rawPublication.stagingRetained;

    Core::Telemetry::Recorder recorder(arena);
    const auto decoded = Core::Telemetry::DecodeEventStream(bytes, byteCount, arena, recorder);
    result.decode = decoded ? Core::Telemetry::DecodeResult{ *decoded, Core::Telemetry::DecodeStatus::Ok } : decoded.error();
    if(!result.decode.ok()){
        result.message = StringFormat(arena, FOUNDATION_TEXT("Telemetry upload stored but decode failed: raw='{}' bytes_read={} status={}"), PathToString<tchar>(result.rawPath), result.decode.bytesRead, static_cast<u32>(result.decode.status));
        result.type = Core::Common::LogType::Error;
        return result;
    }

    auto report = BuildTelemetryReport(recorder.view(), arena, scratchArena);
    if(!report){
        result.message = StringFormat(arena, FOUNDATION_TEXT("Telemetry upload stored but report build failed: raw='{}'"), PathToString<tchar>(result.rawPath));
        result.type = Core::Common::LogType::Error;
        return result;
    }

    result.summary = report->summary;
    const auto jsonPublication = PublishNewFileDurable(result.jsonPath, BinaryByteView{ reinterpret_cast<const u8*>(report->json.data()), report->json.size() });
    const auto csvPublication = PublishNewFileDurable(result.perfCsvPath, BinaryByteView{ reinterpret_cast<const u8*>(report->perfCsv.data()), report->perfCsv.size() });
    FilePublicationResult graphPublication;
    if(!report->graph.empty())
        graphPublication = PublishNewFileDurable(result.graphPath, BinaryByteView{ reinterpret_cast<const u8*>(report->graph.data()), report->graph.size() });
    result.wroteJson = jsonPublication.published;
    result.wrotePerfCsv = csvPublication.published;
    result.wroteGraph = graphPublication.published;
    if(jsonPublication.error || csvPublication.error || graphPublication.error){
        result.message = StringFormat(arena, FOUNDATION_TEXT("Telemetry report publication failed: raw='{}' json='{}' error={} csv='{}' error={} graph='{}' error={}"), PathToString<tchar>(result.rawPath), PathToString<tchar>(result.jsonPath), jsonPublication.error.value(), PathToString<tchar>(result.perfCsvPath), csvPublication.error.value(), PathToString<tchar>(result.graphPath), graphPublication.error.value());
        result.type = Core::Common::LogType::Error;
        return result;
    }

    result.message = StringFormat(
        arena,
        FOUNDATION_TEXT("Telemetry upload processed: events={} parse_failures={} raw='{}' json='{}' csv='{}'"),
        result.summary.eventCount,
        result.summary.parseFailureCount,
        PathToString<tchar>(result.rawPath),
        PathToString<tchar>(result.jsonPath),
        PathToString<tchar>(result.perfCsvPath)
    );
    result.type = !HasTelemetryParseFailures(result.summary.parseFailureCount) ? Core::Common::LogType::EssentialInfo : Core::Common::LogType::Warning;
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_LOG_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

