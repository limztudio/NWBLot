#include <impl/assets_model/asset.adhd>
#include <impl/assets_model/model_binary_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 DeserializeModelBinaryPayload(
    in Span<u8> binary,
    mut Vector<ModelSkeletonObject> outSkeletonObjects,
    mut Vector<ModelStaticMeshObject> outStaticMeshObjects,
    mut Vector<ModelSkinnedMeshObject> outSkinnedMeshObjects
){
    ModelBinaryCodec codec;
    return codec.deserialize(binary, outSkeletonObjects, outStaticMeshObjects, outSkinnedMeshObjects);
}

b8 Model::validatePayload()const{
    if(!this.checkVirtualPath("Model::validatePayload"))
        return false;

    return ValidateModelPayloadObjects(this.m_skeletonObjects, this.m_staticMeshObjects, this.m_skinnedMeshObjects);
}

b8 Model::validatePayload(mut ScratchArena scratchArena)const{
    return this.validatePayload();
}

b8 Model::loadBinary(in Span<u8> binary){
    Model candidate(this.virtualPath());
    if(!DeserializeModelBinaryPayload(binary, candidate.m_skeletonObjects, candidate.m_staticMeshObjects, candidate.m_skinnedMeshObjects) || !candidate.validatePayload())
        return false;
    this = candidate;
    return true;
}


