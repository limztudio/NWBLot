[cpp_name("::ProcessSignal::Enum")]
extern enum ProcessSignal : u32{
    Abort,
    Interrupt,
    Terminate
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<global/process.h>"), cpp_name("::SetSignalHandler")]
extern b8 SetSignalHandler(in ProcessSignal signalValue, in auto handler);

[cpp_name("::CurrentProcessId")]
extern u32 CurrentProcessId();


[cpp_header("<global/process.h>"), cpp_name("::NextProcessSequence")]
extern u64 NextProcessSequence();


