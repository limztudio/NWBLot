static_assert(size_of<RendererCsgState>() == s_RendererCsgStateByteSize, "RendererCsgState should keep its compact CPU-only layout");

u32 CountFrameReceiverCutters(
    in RendererCsgSystem system,
    in CsgFrameReceiverLookup lookup,
    mut World world,
    in EntityID entity,
    in CsgResolvedReceiver resolved,
    in b8 transparent,
    in CsgReceiverCpuBounds bounds,
    in CsgReceiverPass pass
){
    if(!ShouldEvaluateCsgPassCutters(transparent, resolved.receiver.affectOpaquePass, resolved.receiver.affectTransparentPass, pass))
        return 0u;
    const auto draw = lookup.resolveReceiverDrawState(entity, pass);
    if(!draw.has_value() || draw.value().receiverKind != resolved.receiverKind)
        return 0u;
    Expected<CsgReceiverClipDrawInfo> clip = MakeUnexpected(Failure());
    const Optional<mut TransformComponent> borrowedTransform = world.borrowComponent<TransformComponent>(entity);
    if(borrowedTransform.has_value())
        clip = system.resolveCsgReceiverClipDrawInfo(lookup, draw.value(), bounds, borrowedTransform.value());
    else
        clip = system.resolveCsgReceiverClipDrawInfo(lookup, draw.value(), bounds);
    if(!clip.has_value())
        return 0u;
    return clip.value().cutterCount;
}

void CacheCsgFrameState(
    mut RendererCsgState cache,
    in Expected<CsgFrameStateCacheSignature> signature,
    in CsgFrameState state,
    in b8 cacheable
){
    cache.m_frameStateCacheValid = cacheable;
    if(cacheable){
        cache.m_frameStateCacheSignature = signature.value();
        cache.m_frameStateCache = state;
    }
}

[cpp_unwind]
CsgFrameState RendererCsgSystem::buildFrameState(mut IMaterialSurfaceLookup materialSurfaceLookup){
    const Optional<mut MeshSystem> meshSystem = this.m_world.borrowSystem<MeshSystem>();
    Expected<CsgFrameStateCacheSignature> signature = MakeUnexpected(Failure());
    if(meshSystem.has_value())
        signature = BuildCsgFrameCacheSignature(this.m_world, this.m_csgShapeRegistry, meshSystem.value());
    b8 cacheable = signature.has_value();
    if(cacheable && this.m_csgState.m_frameStateCacheValid && this.m_csgState.m_frameStateCacheSignature == signature.value())
        return this.m_csgState.m_frameStateCache;

    CsgFrameState state;
    CsgFrameReceiverLookup lookup(this.m_world);
    if(lookup.empty() || !meshSystem.has_value()){
        CacheCsgFrameState(this.m_csgState, signature, state, cacheable);
        return state;
    }
    lookup.precomputeCutters(this.m_csgShapeRegistry);
    for(in auto row : this.m_world.view<RendererComponent>()){
        if(!Get<1>(row).visible)
            continue;
        const EntityID entity = Get<0>(row);
        const auto receiver = ResolveCsgReceiverComponent(this.m_world, entity);
        if(!receiver.has_value() || !receiver.value().receiver.enabled)
            continue;

        const auto resolved = meshSystem.value().resolveRenderableMeshStatus(entity);
        if(!resolved.has_value()){
            cacheable = false;
            continue;
        }
        Expected<mut MeshResources> mesh = MakeUnexpected(Failure());
        if(resolved.value().runtime){
            cacheable = false;
            mesh = this.m_meshSystem.createRuntimeMeshResources(resolved.value().runtimeMesh);
        }
        else
            mesh = this.m_meshSystem.createMeshResources(resolved.value().mesh);
        if(!mesh.has_value()){
            cacheable = false;
            continue;
        }
        const auto material = materialSurfaceLookup.findMaterialSurfaceInfo(Get<1>(row).material);
        if(!material.has_value()){
            cacheable = false;
            continue;
        }
        const CsgReceiverPassWorkSummary work = SummarizeCsgReceiverPassWork(
            CountFrameReceiverCutters(this, lookup, this.m_world, entity, receiver.value(), material.value().transparent, mesh.value().csgLocalBounds, CsgReceiverPass::Opaque),
            CountFrameReceiverCutters(this, lookup, this.m_world, entity, receiver.value(), material.value().transparent, mesh.value().csgLocalBounds, CsgReceiverPass::Transparent)
        );
        if(work.anyWork())
            AddCsgFrameReceiverWork(receiver.value().receiverKind, work.opaqueWork, work.transparentWork, work.maxCutterCount, state);
    }
    FinalizeCsgFrameState(state);
    CacheCsgFrameState(this.m_csgState, signature, state, cacheable);
    return state;
}


