void VerifyMetadataRegistryPublication_DefaultDependencyEntryOwnsItsPathText(){
    AssetArena arena(s_AssetCaseTestsMetadataRegistryDependencyPath);
    ScratchArena scratchArena(s_AssetCaseTestsMetadataRegistryDependencyPathScratch);
    native(mut arena, mut scratchArena){
        using namespace NWB::Core::Assets;
        CookDependencyRegistry registry(arena);
        ScratchString text("project/example", scratchArena);
        ASSERT_TRUE(registry.registerDefaultEntryAsset(Name(s_AssetInputNameProjectExample), Name(s_AssetInputNameExample), AStringView(text)));
        text.assign("project/changed");
        EXPECT_EQ(registry.defaultEntryAsset().virtualPathText, "project/example");
        const AStringView stored = registry.defaultEntryAsset().virtualPathText;
        ASSERT_TRUE(registry.registerDefaultEntryAsset(Name(s_AssetInputNameProjectExample), Name(s_AssetInputNameExample), stored));
        EXPECT_EQ(registry.defaultEntryAsset().virtualPathText, "project/example");
