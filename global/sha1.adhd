[cpp_header("<global/sha1.h>"), cpp_name("::Sha1Digest")]
extern class Sha1Digest{
    Array<u8, 20u> bytes;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<global/sha1.h>"), cpp_name("::AppendSha1Hex")]
extern void AppendSha1Hex(in Sha1Digest digest, mut auto output);

[cpp_header("<global/sha1.h>"), cpp_name("::ComputeSha1")]
extern Sha1Digest ComputeSha1(in auto a0);

[cpp_header("<global/sha1.h>"), cpp_name("::ComputeSha1Text")]
extern Sha1Digest ComputeSha1Text(in StringView a0);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<global/sha1.h>"), cpp_name("::Sha1Digest::s_ByteCount")]
extern const u32 s_Sha1DigestByteCount;
[cpp_header("<global/sha1.h>"), cpp_name("::Sha1Digest::s_HexTextLength")]
extern const u32 s_Sha1DigestHexTextLength;


