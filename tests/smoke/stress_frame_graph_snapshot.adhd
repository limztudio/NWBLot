class StressFrameGraphSnapshotWriter{
    public String format(in FrameGraphPayload payload, in u64 graphicsFrame, in u64 completedFrames)const{
        String out = StringFormat(
            "{{\n\"type\":\"stress_frame_graph_snapshot\",\"source_frame\":{},\"graphics_frame_at_capture\":{},\"completed_frames\":{},\"diagnostic_only\":true,\"compiled_state_seed_ids_available\":false,\"compiler_extra_dependency_ids_available\":false,\"edge_scope\":\"public_analysis_edges\",\n\"nodes\":[\n",
            payload.frameIndex,
            graphicsFrame,
            completedFrames
        );
        for(usize index = 0u; index < payload.nodes.size(); ++index){
            const FrameGraphNodePayload node = payload.nodes[index];
            if(index != 0u)
                out.append(",\n");
            StringAppendFormat(out, "{{\"index\":{},\"name\":", index);
            this.appendJsonText(node.name.resolvedText(), out);
            out.append(",\"label\":");
            this.appendJsonText(node.label, out);
            StringAppendFormat(out, ",\"kind\":{},\"flags\":{}", cast<u32>(node.kind), cast<u32>(node.flags));
            if(node.compiledTask.present){
                StringAppendFormat(
                    out,
                    ",\"plan_generation\":{},\"packet_index\":{},\"packetization_decision\":{}",
                    node.compiledTask.planGeneration,
                    node.compiledTask.packetIndex,
                    cast<u32>(node.compiledTask.packetizationDecision)
                );
            }
            if(node.queueAssignment.present){
                out.append(",\"queue_class\":");
                this.appendJsonText(this.queueClassLabel(node.queueAssignment.queueClass), out);
                out.append(",\"planned_queue\":");
                this.appendQueue(node.queueAssignment.plannedQueue, out);
                out.append(",\"accepted_queue\":");
                this.appendQueue(node.queueAssignment.acceptedQueue, out);
                StringView dedicatedText = "false";
                if(node.queueAssignment.dedicated)
                    dedicatedText = "true";
                StringAppendFormat(
                    out,
                    ",\"dedicated\":{},\"assignment_reason\":{},\"assignment_modifiers\":{}",
                    dedicatedText,
                    cast<u32>(node.queueAssignment.reason),
                    cast<u32>(node.queueAssignment.modifiers)
                );
            }
            if(node.runtimeStatistics.present){
                const FrameGraphRuntimeStatistics statistics = node.runtimeStatistics;
                StringAppendFormat(
                    out,
                    ",\"runtime\":{{\"graph_generation\":{},\"plan_generation\":{},\"recording_attempt_generation\":{},\"tasks\":{},\"packets\":{},\"packet_dependencies\":{},\"transitions\":{},\"accepted_packets\":{},\"accepted_tasks\":{},\"rejected_packets\":{},\"rejected_tasks\":{},\"rejected_native_submissions\":{},\"recovery_submissions\":{},\"planned_waits\":{},\"same_queue_elisions\":{},\"timeline_waits\":{},\"merged_timeline_waits\":{},\"inherited_timeline_wait_elisions\":{}}}",
                    statistics.graphGeneration,
                    statistics.planGeneration,
                    statistics.recordingAttemptGeneration,
                    statistics.compile.taskCount,
                    statistics.compile.packetCount,
                    statistics.compile.packetDependencyCount,
                    statistics.compile.transitionBarrierCount,
                    statistics.submission.acceptedPacketCount,
                    statistics.submission.acceptedTaskCount,
                    statistics.submission.rejectedPacketCount,
                    statistics.submission.rejectedTaskCount,
                    statistics.submission.rejectedSubmissionCount,
                    statistics.submission.recoverySubmissionCount,
                    statistics.submission.plannedWaitTokenCount,
                    statistics.submission.sameQueueWaitElisionCount,
                    statistics.submission.timelineWaitCount,
                    statistics.submission.mergedTimelineWaitCount,
                    statistics.submission.inheritedTimelineWaitElisionCount
                );
            }
            out.push_back('}');
        }
        out.append("\n],\n\"edges\":[\n");
        for(usize index = 0u; index < payload.edges.size(); ++index){
            const FrameGraphEdgePayload edge = payload.edges[index];
            if(index != 0u)
                out.append(",\n");
            StringAppendFormat(
                out,
                "{{\"from\":{},\"to\":{},\"kind\":{},\"flags\":{}}}",
                edge.fromNodeIndex,
                edge.toNodeIndex,
                cast<u32>(edge.kind),
                cast<u32>(edge.flags)
            );
        }
        out.append("\n],\n\"physical_queues\":[\n");
        for(usize index = 0u; index < payload.physicalQueueRuntimeStatistics.size(); ++index){
            const FrameGraphPhysicalQueueRuntimeStatisticsRecord record = payload.physicalQueueRuntimeStatistics[index];
            const FrameGraphPhysicalQueueRuntimeStatistics statistics = record.statistics;
            if(index != 0u)
                out.append(",\n");
            StringAppendFormat(out, "{{\"owner_node\":{},\"queue\":", record.ownerNodeIndex);
            this.appendQueue(statistics.queue, out);
            out.append(",\"queue_class\":");
            this.appendJsonText(this.queueClassLabel(statistics.queueClass), out);
            StringAppendFormat(
                out,
                ",\"tasks\":{},\"packets\":{},\"prologue_barriers\":{},\"epilogue_barriers\":{},\"accepted_packets\":{},\"planned_waits\":{},\"same_queue_elisions\":{},\"timeline_waits\":{},\"merged_timeline_waits\":{},\"inherited_timeline_wait_elisions\":{}}}",
                statistics.compile.taskCount,
                statistics.compile.packetCount,
                statistics.compile.prologueBarrierCount,
                statistics.compile.epilogueBarrierCount,
                statistics.submission.acceptedPacketCount,
                statistics.submission.plannedWaitTokenCount,
                statistics.submission.sameQueueWaitElisionCount,
                statistics.submission.timelineWaitCount,
                statistics.submission.mergedTimelineWaitCount,
                statistics.submission.inheritedTimelineWaitElisionCount
            );
        }
        out.append("\n],\n\"packets\":[\n");
        for(usize index = 0u; index < payload.packetSubmissionStatistics.size(); ++index){
            const FrameGraphPacketSubmissionStatisticsRecord packet = payload.packetSubmissionStatistics[index];
            if(index != 0u)
                out.append(",\n");
            StringAppendFormat(
                out,
                "{{\"owner_node\":{},\"plan_generation\":{},\"packet_index\":{},\"queue\":",
                packet.ownerNodeIndex,
                packet.packetGeneration,
                packet.packetIndex
            );
            this.appendQueue(packet.queue, out);
            out.append(",\"queue_class\":");
            this.appendJsonText(this.queueClassLabel(packet.queueClass), out);
            StringView frontierText = "false";
            if(packet.joinsAcceptedQueueFrontier)
                frontierText = "true";
            StringView recoveryText = "false";
            if(packet.recoverySubmission)
                recoveryText = "true";
            StringAppendFormat(
                out,
                ",\"tasks\":{},\"command_lists\":{},\"planned_waits\":{},\"same_queue_elisions\":{},\"timeline_waits\":{},\"merged_timeline_waits\":{},\"inherited_timeline_wait_elisions\":{},\"joins_accepted_frontier\":{},\"recovery\":{},\"submission_seconds\":{:.17g}}}",
                packet.taskCount,
                packet.commandListCount,
                packet.plannedWaitTokenCount,
                packet.sameQueueWaitElisionCount,
                packet.timelineWaitCount,
                packet.mergedTimelineWaitCount,
                packet.inheritedTimelineWaitElisionCount,
                frontierText,
                recoveryText,
                packet.submissionSeconds
            );
        }
        out.append("\n]\n}\n");
        return out;
    }

    private void appendJsonText(in StringView text, mut String out)const{
        out.push_back('"');
        for(usize i = 0u; i < text.size(); ++i){
            const u8 code = cast<u8>(text[i]);
            if(code == 34u){
                out.append("\\\"");
            }
            else if(code == 92u){
                out.append("\\\\");
            }
            else if(code == 10u){
                out.append("\\n");
            }
            else if(code == 13u){
                out.append("\\r");
            }
            else if(code == 9u){
                out.append("\\t");
            }
            else if(code < s_StressSnapshotJsonControlCharLimit){
                out.append("\\u00");
                out.push_back(s_StressSnapshotHexDigits[cast<usize>(code >> s_StressSnapshotNibbleBits)]);
                out.push_back(s_StressSnapshotHexDigits[cast<usize>(code & s_StressSnapshotNibbleMask)]);
            }
            else{
                out.push_back(text[i]);
            }
        }
        out.push_back('"');
    }

    private StringView queueClassLabel(in FrameGraphQueueClassEnum queueClass)const{
        if(queueClass == FrameGraphQueueClass::Graphics)
            return "Graphics";
        if(queueClass == FrameGraphQueueClass::Compute)
            return "Compute";
        if(queueClass == FrameGraphQueueClass::Transfer)
            return "Transfer";
        return "Unknown";
    }

    private void appendQueue(in FrameGraphPhysicalQueueId queue, mut String out)const{
        if(!queue.valid()){
            out.append("null");
            return;
        }
        StringAppendFormat(out, "{{\"index\":{},\"device_generation\":{}}}", queue.index, queue.deviceGeneration);
    }
}

b8 ValidateStressFrameGraphSnapshot(in FrameGraphPayload payload, in u64 sourceFrame){
    if(payload.frameIndex != sourceFrame || payload.nodes.empty() || payload.edges.empty() || !payload.packetSubmissionStatisticsPresent || payload.packetSubmissionStatistics.empty() || payload.physicalQueueRuntimeStatistics.empty()){
        usize runtimeOwners = 0u;
        usize compiledTasks = 0u;
        for(usize i = 0u; i < payload.nodes.size(); ++i){
            if(payload.nodes[i].runtimeStatistics.present)
                ++runtimeOwners;
            if(payload.nodes[i].compiledTask.present)
                ++compiledTasks;
        }
        [essential] info(
            "StressFrameGraphSnapshot: invalid payload source_frame={} payload_frame={} nodes={} edges={} runtime_owners={} compiled_tasks={} packet_statistics_present={} packets={} physical_queues={}"
            , sourceFrame, payload.frameIndex, payload.nodes.size(), payload.edges.size(), runtimeOwners, compiledTasks, payload.packetSubmissionStatisticsPresent, payload.packetSubmissionStatistics.size(), payload.physicalQueueRuntimeStatistics.size()
        );
        return false;
    }
    usize runtimeOwnerCount = 0u;
    u64 planGeneration = 0u;
    u64 expectedTaskCount = 0u;
    for(usize i = 0u; i < payload.nodes.size(); ++i){
        if(!payload.nodes[i].runtimeStatistics.present)
            continue;
        ++runtimeOwnerCount;
        const FrameGraphRuntimeStatistics statistics = payload.nodes[i].runtimeStatistics;
        if(statistics.planGeneration == 0u || statistics.compile.taskCount == 0u || statistics.compile.packetCount == 0u || statistics.submission.acceptedPacketCount == 0u || !ValidateNormalFrameSnapshotCompletion(payload, statistics)){
            [essential] info(
                "StressFrameGraphSnapshot: invalid normal completion graph={} plan={} attempt={} tasks={} packets={} rejected_packets={} rejected_tasks={} rejected_submissions={} recovery_submissions={} accepted_packets={} accepted_tasks={}"
                , statistics.graphGeneration, statistics.planGeneration, statistics.recordingAttemptGeneration, statistics.compile.taskCount, statistics.compile.packetCount
                , statistics.submission.rejectedPacketCount, statistics.submission.rejectedTaskCount, statistics.submission.rejectedSubmissionCount, statistics.submission.recoverySubmissionCount
                , statistics.submission.acceptedPacketCount, statistics.submission.acceptedTaskCount
            );
            return false;
        }
        planGeneration = statistics.planGeneration;
        expectedTaskCount = statistics.compile.taskCount;
    }
    if(runtimeOwnerCount != 1u){
        [essential] info(
            "StressFrameGraphSnapshot: runtime owner count expected=1 observed={} source_frame={} nodes={} packets={} physical_queues={}"
            , runtimeOwnerCount, sourceFrame, payload.nodes.size(), payload.packetSubmissionStatistics.size(), payload.physicalQueueRuntimeStatistics.size()
        );
        return false;
    }
    usize compiledTaskCount = 0u;
    for(usize i = 0u; i < payload.nodes.size(); ++i){
        if(!payload.nodes[i].compiledTask.present)
            continue;
        if(payload.nodes[i].compiledTask.planGeneration != planGeneration){
            [essential] info("StressFrameGraphSnapshot: compiled task plan expected={} observed={} packet_index={}", planGeneration, payload.nodes[i].compiledTask.planGeneration, payload.nodes[i].compiledTask.packetIndex);
            return false;
        }
        ++compiledTaskCount;
    }
    if(compiledTaskCount != expectedTaskCount){
        [essential] info("StressFrameGraphSnapshot: compiled task count expected={} observed={} plan={}", expectedTaskCount, compiledTaskCount, planGeneration);
        return false;
    }
    for(usize i = 0u; i < payload.packetSubmissionStatistics.size(); ++i){
        const FrameGraphPacketSubmissionStatisticsRecord packet = payload.packetSubmissionStatistics[i];
        if(packet.packetGeneration != planGeneration || !packet.queue.valid() || packet.taskCount == 0u){
            [essential] info(
                "StressFrameGraphSnapshot: invalid packet expected_plan={} observed_plan={} packet_index={} queue_index={} queue_generation={} tasks={}"
                , planGeneration, packet.packetGeneration, packet.packetIndex, packet.queue.index, packet.queue.deviceGeneration, packet.taskCount
            );
            return false;
        }
    }
    for(usize i = 0u; i < payload.physicalQueueRuntimeStatistics.size(); ++i){
        const FrameGraphPhysicalQueueRuntimeStatisticsRecord queue = payload.physicalQueueRuntimeStatistics[i];
        if(queue.statistics.planGeneration != planGeneration || !queue.statistics.queue.valid()){
            [essential] info(
                "StressFrameGraphSnapshot: invalid physical queue expected_plan={} observed_plan={} queue_index={} queue_generation={}"
                , planGeneration, queue.statistics.planGeneration, queue.statistics.queue.index, queue.statistics.queue.deviceGeneration
            );
            return false;
        }
    }
    return true;
}

// Captures the pixel-freeze frame snapshot through public telemetry.
b8 CaptureStressFrameGraphSnapshot(in StringView outputPath, in u64 completedFrames, mut ProjectRuntimeContext context){
    const u64 graphicsFrame = context.graphics.getFrameIndex();
    if(outputPath.empty() || completedFrames == 0u || graphicsFrame == 0u){
        error("StressFrameGraphSnapshot: no completed frame or output path");
        return false;
    }
    // Capture the completed frame before runFrame advances the frame index.
    const u64 sourceFrame = graphicsFrame - 1u;
    Vector<u8> encodedBytes;
    String snapshotJson = String();
    usize nodeCount = 0u;
    usize edgeCount = 0u;
    usize packetCount = 0u;
    u32 failureReason = 0u;
    usize failedPayloadBytes = 0u;
    native(
        in sourceFrame,
        in graphicsFrame,
        in completedFrames,
        mut context,
        mut encodedBytes,
        mut snapshotJson,
        mut nodeCount,
        mut edgeCount,
        mut packetCount,
        mut failureReason,
        mut failedPayloadBytes
    ){
        Core::Telemetry::TelemetryArena arena{Name(NWB::Tests::Smoke::s_SmokeNameTestsSmokeFrameGraphSnapshot)};
        Core::Telemetry::CaptureSession session(arena);
        session.setCaptureOptions(Core::Telemetry::CaptureOptions::FrameGraphOnly());
        session.setFrameIndex(sourceFrame);
        if(!context.frameGraphRegistry.record(session) || session.eventCount() != 1u){
            failureReason = 1u;
        }
        else{
            const auto* const event = session.view().eventAt(0u);
            if(!event || event->header.kind != Core::Telemetry::EventKind::FrameGraphFrame || event->header.frameIndex != sourceFrame){
                failureReason = 2u;
            }
            else{
                Core::Alloc::ScratchArena scratchArena{Name(NWB::Tests::Smoke::s_SmokeNameTestsSmokeFrameGraphSnapshotScratch)};
                const auto payload = Core::Telemetry::ParseFrameGraphPayload(arena, scratchArena, event->payload.data(), event->payload.size());
                if(!payload){
                    failureReason = 3u;
                    failedPayloadBytes = event->payload.size();
                }
                else if(!ValidateStressFrameGraphSnapshot(*payload, sourceFrame)){
                    failureReason = 2u;
                }
                else{
                    Core::Telemetry::TelemetryBytes encoded(arena);
                    if(!Core::Telemetry::EncodeEventStream(session.view(), encoded)){
                        failureReason = 4u;
                    }
                    else{
                        encodedBytes.assign(encoded.begin(), encoded.end());
                        snapshotJson = StressFrameGraphSnapshotWriter().format(*payload, graphicsFrame, completedFrames);
                        nodeCount = payload->nodes.size();
                        edgeCount = payload->edges.size();
                        packetCount = payload->packetSubmissionStatistics.size();
                    }
                }
            }
        }
    }
    if(failureReason == 1u){
        error("StressFrameGraphSnapshot: public frame graph capture failed");
        return false;
    }
    if(failureReason == 2u){
        error("StressFrameGraphSnapshot: missing runtime data or inconsistent completed-frame identity");
        return false;
    }
    if(failureReason == 3u){
        error("StressFrameGraphSnapshot: frame graph payload parse failed source_frame={} payload_bytes={}", sourceFrame, failedPayloadBytes);
        return false;
    }
    if(failureReason == 4u){
        error("StressFrameGraphSnapshot: event stream encoding failed");
        return false;
    }
    const String binaryPathText = StringFormat("{}.nwbs", outputPath);
    if(!WriteBinaryFile(Path(StringView(binaryPathText)), encodedBytes)){
        error("StressFrameGraphSnapshot: encoded stream output failed");
        return false;
    }
    if(!WriteTextFile(Path(outputPath), StringView(snapshotJson))){
        error("StressFrameGraphSnapshot: readable snapshot output failed");
        return false;
    }
    [essential] info(
        "StressFrameGraphSnapshot: complete source_frame={} completed_frames={} nodes={} edges={} packets={}",
        sourceFrame,
        completedFrames,
        nodeCount,
        edgeCount,
        packetCount
    );
    return true;
}


