class UiPopupRouterTests : RouterTestFixture{


    public b8 install(in PopupScope scope, in u64 generation){
        const auto targets = MakeUiPopupRouterTargets(scope);
        return this.m_router.commitTargets(targets, generation, MakeUiSinglePopupScopeArray(scope));
    }
    public b8 commitWithScope(in Span<HitTarget> targets, in u64 generation, in PopupScope scope){
        return this.m_router.commitTargets(targets, generation, MakeUiSinglePopupScopeArray(scope));
    }
    public b8 commitCountWithScope(in Span<HitTarget> targets, in usize count, in u64 generation, in PopupScope scope){
        return this.m_router.commitTargets(targets.subspan(0u, count), generation, MakeUiSinglePopupScopeArray(scope));
    }
    public b8 commitSingle(in HitTarget target, in u64 generation){
        return this.m_router.commitTargets(MakeUiSingleHitTargetArray(target), generation);
    }
    public void focusBase(){
        const auto targets = MakeUiPopupRouterBaseTargets();
        ASSERT_TRUE(this.m_router.commitTargets(targets, 1u));
        this.key(Key::Tab);
        ASSERT_EQ(this.m_router.focus().value, 1u);
    }
}


[extensible]
class PopupToolsCaseFixture : PopupToolsFixture{


    public b8 hasMenuHost()const{
        return this.menuHost().has_value();
    }
    public Expected<HitTarget> findMenuHost()const{
        const auto hit = this.menuHost();
        if(!hit.has_value())
            return MakeUnexpected(Failure());
        return hit.value();
    }
    public Expected<HitTarget> findMenuRow(in u64 key)const{
        const auto hit = this.menuRow(key);
        if(!hit.has_value())
            return MakeUnexpected(Failure());
        return hit.value();
    }
    public void armCloseMenuOnText(){
        this.m_source.closeOnText.value() = Optional<mut ContextMenuState>(this.m_menu);
    }
    public void armResetTooltipOnText(){
        this.m_source.resetTooltipOnText.value() = Optional<mut TooltipState>(this.m_tooltip);
    }
    public void armSelectListOnText(mut ListState list, in u64 key){
        this.m_source.selectListOnText.value() = Optional<mut ListState>(list);
        this.m_source.selectListKey = key;
    }
    public b8 hasSelectListOnText()const{
        return this.m_source.selectListOnText.value().has_value();
    }
    public b8 hasCloseComboOnRevision()const{
        return this.m_source.closeComboOnRevision.value().has_value();
    }
}


