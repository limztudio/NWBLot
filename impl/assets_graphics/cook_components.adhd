Expected<AssetRef<T>> ReadGraphicsComponentReference<T>(in Path file, in MetascriptValue asset, in StringView prefix, in StringView field){
    const Expected<MetadataStringField> text = ReadMetadataStringField(file, asset, prefix, field, true);
    if(!text.has_value())
        return MakeUnexpected(Failure());
    return ParseReservedAssetRefText<T>(file, prefix, field, text.value().text);
}

Expected<AssetRef<T>> ReadSingleGraphicsComponentReference<T, Entry>(
    in Name virtualPath,
    in Path file,
    in MetascriptValue asset,
    in StringView prefix,
    mut Entry entry
){
    if(!CheckMetadataAssetMap(file, asset, prefix) || !AssignCookEntryVirtualPath(virtualPath, file, prefix, entry))
        return MakeUnexpected(Failure());
    if(!ValidateMetadataAssetFields(file, asset, prefix, lambda[](in StringView key) -> b8{ return key == s_GraphicsComponentAssetField; }))
        return MakeUnexpected(Failure());
    return ReadGraphicsComponentReference<T>(file, asset, prefix, s_GraphicsComponentAssetField);
}

Expected<ModelComponentCookEntry> ParseModelComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue value){
    ModelComponentCookEntry entry;
    const Expected<AssetRef<Model>> reference = ReadSingleGraphicsComponentReference<Model, ModelComponentCookEntry>(
        virtualPath, file, value, s_ModelComponentDiagnosticPrefix, entry
    );
    if(!reference.has_value())
        return MakeUnexpected(Failure());
    entry.component.model = reference.value();
    if(!BuildComponentAssetFromEntry<ModelComponentAsset, ModelComponentCookEntry>(entry).has_value())
        return MakeUnexpected(Failure());
    return entry;
}

Expected<MeshComponentCookEntry> ParseMeshComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue value){
    MeshComponentCookEntry entry;
    const Expected<AssetRef<Mesh>> reference = ReadSingleGraphicsComponentReference<Mesh, MeshComponentCookEntry>(
        virtualPath, file, value, s_MeshComponentDiagnosticPrefix, entry
    );
    if(!reference.has_value())
        return MakeUnexpected(Failure());
    entry.component.mesh = reference.value();
    if(!BuildComponentAssetFromEntry<MeshComponentAsset, MeshComponentCookEntry>(entry).has_value())
        return MakeUnexpected(Failure());
    return entry;
}

Expected<OpticalVolumeCoincidence> ReadRendererOpticalVolumeCoincidence(in Path file, in MetascriptValue value){
    if(!value.hasField(s_RendererComponentOpticalVolumeCoincidenceField))
        return OpticalVolumeCoincidence::Independent;
    const Expected<MetadataStringField> field = ReadMetadataStringField(file, value, s_RendererComponentDiagnosticPrefix, s_RendererComponentOpticalVolumeCoincidenceField, true);
    if(!field.has_value())
        return MakeUnexpected(field.error());
    if(field.value().text == s_OpticalVolumeCoincidenceIndependentText)
        return OpticalVolumeCoincidence::Independent;
    if(field.value().text == s_OpticalVolumeCoincidenceIdenticalMaterialText)
        return OpticalVolumeCoincidence::IdenticalMaterial;
    if(field.value().text == s_OpticalVolumeCoincidenceSharedGroupText)
        return OpticalVolumeCoincidence::SharedGroup;
    error("{} '{}': field '{}' {}", s_RendererComponentDiagnosticPrefix, file, s_RendererComponentOpticalVolumeCoincidenceField, s_RendererOpticalVolumeCoincidenceChoices);
    return MakeUnexpected(Failure());
}

Expected<OpticalBoundaryMode> ReadRendererOpticalBoundaryMode(in Path file, in MetascriptValue value){
    if(!value.hasField(s_RendererComponentOpticalBoundaryModeField))
        return OpticalBoundaryMode::Unspecified;
    const Expected<MetadataStringField> field = ReadMetadataStringField(file, value, s_RendererComponentDiagnosticPrefix, s_RendererComponentOpticalBoundaryModeField, true);
    if(!field.has_value())
        return MakeUnexpected(field.error());
    if(field.value().text == s_OpticalBoundaryModeUnspecifiedText)
        return OpticalBoundaryMode::Unspecified;
    if(field.value().text == s_OpticalBoundaryModeClosedNestedText)
        return OpticalBoundaryMode::ClosedNested;
    if(field.value().text == s_OpticalBoundaryModeClosedPriorityText)
        return OpticalBoundaryMode::ClosedPriority;
    error("{} '{}': field '{}' {}", s_RendererComponentDiagnosticPrefix, file, s_RendererComponentOpticalBoundaryModeField, s_RendererOpticalBoundaryModeChoices);
    return MakeUnexpected(Failure());
}

Expected<RendererComponentCookEntry> ParseRendererComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue asset){
    RendererComponentCookEntry entry;
    if(!CheckMetadataAssetMap(file, asset, s_RendererComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_RendererComponentDiagnosticPrefix, entry)
        || !ValidateMetadataAssetFields(file, asset, s_RendererComponentDiagnosticPrefix, IsAllowedRendererComponentMetadataField))
        return MakeUnexpected(Failure());

    const Expected<AssetRef<Material>> material = ReadGraphicsComponentReference<Material>(
        file, asset, s_RendererComponentDiagnosticPrefix, s_RendererComponentMaterialField
    );
    if(!material.has_value())
        return MakeUnexpected(Failure());
    entry.component.material = material.value();
    if(!ReadOptionalRendererVisibleField(file, asset, entry.component.visible))
        return MakeUnexpected(Failure());
    const Expected<OpticalVolumeCoincidence> coincidence = ReadRendererOpticalVolumeCoincidence(file, asset);
    if(!coincidence.has_value())
        return MakeUnexpected(coincidence.error());
    entry.component.opticalVolumeCoincidence = coincidence.value();
    const Expected<Name> opticalVolumeGroup = ReadOptionalRendererOpticalVolumeGroupField(file, asset);
    if(!opticalVolumeGroup.has_value())
        return MakeUnexpected(opticalVolumeGroup.error());
    entry.component.opticalVolumeGroup = opticalVolumeGroup.value();
    const Expected<OpticalBoundaryMode> boundaryMode = ReadRendererOpticalBoundaryMode(file, asset);
    if(!boundaryMode.has_value())
        return MakeUnexpected(boundaryMode.error());
    entry.component.opticalBoundaryMode = boundaryMode.value();
    if(!ReadOptionalRendererPriorityFields(file, asset, entry.component.opticalVolumePriority, entry.component.opticalMediumPriority))
        return MakeUnexpected(Failure());
    if(!BuildComponentAssetFromEntry<RendererComponentAsset, RendererComponentCookEntry>(entry).has_value())
        return MakeUnexpected(Failure());
    return entry;
}

Expected<Name> ReadUnpaddedNameField(
    in Path file,
    in MetascriptValue asset,
    in StringView prefix,
    in StringView field,
    in b8 required
){
    const Expected<MetadataStringField> rawField = ReadMetadataStringField(file, asset, prefix, field, required);
    if(!rawField.has_value())
        return MakeUnexpected(Failure());
    if(!rawField.value().present)
        return s_NameNone;
    const StringView trimmed = TrimView(rawField.value().text);
    if(trimmed.empty() || trimmed != rawField.value().text){
        error("{} '{}': field '{}' must not be empty or padded", prefix, file, field);
        return MakeUnexpected(Failure());
    }
    const Expected<Name> parsed = ParseName(trimmed);
    if(!parsed.has_value() || parsed.value() == s_NameNone){
        error("{} '{}': field '{}' is invalid", prefix, file, field);
        return MakeUnexpected(Failure());
    }
    return parsed.value();
}

b8 LessMaterialInstanceParameter(in MaterialInstanceParameter lhs, in MaterialInstanceParameter rhs){
    return lhs.parameterName < rhs.parameterName;
}

b8 ReadOptionalSkeletonSkinningModeField(in Path file, in MetascriptValue asset, in StringView prefix, mut u32 inOutMode){
    if(!asset.hasField(s_SkeletonSkinningModeField))
        return true;
    const Expected<MetadataStringField> field = ReadMetadataStringField(file, asset, prefix, s_SkeletonSkinningModeField, true);
    if(!field.has_value())
        return false;
    if(field.value().text == s_SkeletonSkinningModeLinearBlendText){
        inOutMode = cast<u32>(SkeletonSkinningMode::LinearBlend);
        return true;
    }
    if(field.value().text == s_SkeletonSkinningModeDualQuaternionText){
        inOutMode = cast<u32>(SkeletonSkinningMode::DualQuaternion);
        return true;
    }
    error("{} '{}': field '{}' must be 'linear_blend' or 'dual_quaternion'", prefix, file, s_SkeletonSkinningModeField);
    return false;
}

Expected<f32x3x4> ReadMetadataAffineMatrix3x4Value(
    in Path file,
    in MetascriptValue value,
    in StringView prefix,
    in StringView field
){
    if(!value.isList() || value.listView().size() != 12u){
        error("{} '{}': field '{}' entries must be 12-element numeric lists", prefix, file, field);
        return MakeUnexpected(Failure());
    }
    Array<f32, 12> elements = Array<f32, 12>();
    const Span<MetascriptValue> items = value.listView();
    for(usize i = 0u; i < 12u; ++i){
        const Expected<f32> element = ReadMetadataFiniteF32Value(file, items[i], prefix, field);
        if(!element.has_value())
            return MakeUnexpected(Failure());
        elements[i] = element.value();
    }
    return f32x3x4(
        elements[0u], elements[1u], elements[2u], elements[3u],
        elements[4u], elements[5u], elements[6u], elements[7u],
        elements[8u], elements[9u], elements[10u], elements[11u]
    );
}

b8 ReadOptionalAffineMatrix3x4Field(
    in Path file,
    in MetascriptValue asset,
    in StringView prefix,
    in StringView field,
    mut MatrixSingle inOutMatrix
){
    const Optional<in MetascriptValue> fieldVal = asset.borrowField(field);
    if(!fieldVal.has_value())
        return true;
    const Expected<f32x3x4> parsed = ReadMetadataAffineMatrix3x4Value(file, fieldVal.value(), prefix, field);
    if(!parsed.has_value())
        return false;
    inOutMatrix = MatrixSingle(parsed.value());
    return true;
}

b8 ReadOptionalMatrix3x4ListField(
    in Path file,
    in MetascriptValue asset,
    in StringView prefix,
    in StringView field,
    mut Vector<SkeletonJointMatrix> outMatrices
){
    if(!asset.hasField(field))
        return true;
    const Expected<Span<MetascriptValue>> listResult = ReadMetadataListField(file, asset, prefix, field);
    if(!listResult.has_value())
        return false;
    const Span<MetascriptValue> items = listResult.value();
    if(items.size() > cast<usize>(u32.max)){
        error("{} '{}': field '{}' count overflows", prefix, file, field);
        return false;
    }
    outMatrices.clear();
    outMatrices.reserve(items.size());
    for(in MetascriptValue item : items){
        const Expected<f32x3x4> matrix = ReadMetadataAffineMatrix3x4Value(file, item, prefix, field);
        if(!matrix.has_value() || !IsFiniteSkeletonJointMatrix(MatrixSingle(matrix.value())))
            return false;
        outMatrices.push_back(matrix.value());
    }
    return true;
}

b8 ReadOptionalParentJointListField(
    in Path file,
    in MetascriptValue asset,
    in StringView prefix,
    in StringView field,
    mut Vector<u32> outParentJoints
){
    if(!asset.hasField(field))
        return true;
    const Expected<Span<MetascriptValue>> listResult = ReadMetadataListField(file, asset, prefix, field);
    if(!listResult.has_value())
        return false;
    const Span<MetascriptValue> items = listResult.value();
    if(items.size() > cast<usize>(u32.max)){
        error("{} '{}': field '{}' count overflows", prefix, file, field);
        return false;
    }
    outParentJoints.clear();
    outParentJoints.reserve(items.size());
    for(in MetascriptValue item : items){
        if(!item.isInteger()){
            error("{} '{}': field '{}' entries must be integers", prefix, file, field);
            return false;
        }
        const i64 val = item.asInteger();
        if(val == -1 || val == cast<i64>(s_SkeletonInvalidJointIndex))
            outParentJoints.push_back(s_SkeletonInvalidJointIndex);
        else if(val >= 0 && val < cast<i64>(s_SkeletonInvalidJointIndex))
            outParentJoints.push_back(cast<u32>(val));
        else{
            error("{} '{}': field '{}' entry {} is out of range", prefix, file, field, val);
            return false;
        }
    }
    return true;
}

b8 ReadOptionalByteListField(
    in Path file,
    in MetascriptValue asset,
    in StringView prefix,
    in StringView field,
    mut Vector<u8> outBytes
){
    if(!asset.hasField(field))
        return true;
    const Expected<Span<MetascriptValue>> listResult = ReadMetadataListField(file, asset, prefix, field);
    if(!listResult.has_value())
        return false;
    const Span<MetascriptValue> items = listResult.value();
    if(items.size() > cast<usize>(u32.max)){
        error("{} '{}': field '{}' byte count overflows", prefix, file, field);
        return false;
    }
    outBytes.clear();
    outBytes.reserve(items.size());
    for(in MetascriptValue item : items){
        if(!item.isInteger()){
            error("{} '{}': field '{}' entries must be integers", prefix, file, field);
            return false;
        }
        const i64 val = item.asInteger();
        if(val < 0 || val > 255){
            error("{} '{}': field '{}' byte {} out of range [0, 255]", prefix, file, field, val);
            return false;
        }
        outBytes.push_back(cast<u8>(val));
    }
    return true;
}

Expected<MaterialInstanceComponentCookEntry> ParseMaterialInstanceComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue asset){
    MaterialInstanceComponentCookEntry entry;
    if(!CheckMetadataAssetMap(file, asset, s_MaterialInstanceComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_MaterialInstanceComponentDiagnosticPrefix, entry)
        || !ValidateMetadataAssetFields(file, asset, s_MaterialInstanceComponentDiagnosticPrefix, IsAllowedMaterialInstanceComponentMetadataField))
        return MakeUnexpected(Failure());

    const Expected<Name> materialInterface = ReadUnpaddedNameField(
        file, asset, s_MaterialInstanceComponentDiagnosticPrefix, s_MaterialInstanceInterfaceField, true
    );
    if(!materialInterface.has_value())
        return MakeUnexpected(Failure());
    entry.component.materialInterface = materialInterface.value();

    const Optional<in MetascriptValue> overridesField = asset.borrowField(s_MaterialInstanceOverridesField);
    if(overridesField.has_value()){
        if(!overridesField.value().isMap()){
            error("{} '{}': field '{}' must be a map", s_MaterialInstanceComponentDiagnosticPrefix, file, s_MaterialInstanceOverridesField);
            return MakeUnexpected(Failure());
        }
        const String fileText = PathToString(file);
        const StringView fileTextRef = fileText;
        if(!overridesField.value().forEachMapEntry(lambda[in fileTextRef, mut entry](in StringView paramKey, in MetascriptValue paramValue) -> b8{
            const StringView trimmedKey = TrimView(paramKey);
            if(trimmedKey.empty() || trimmedKey != paramKey){
                error("{} '{}': override key '{}' must not be empty or padded", s_MaterialInstanceComponentDiagnosticPrefix, fileTextRef, paramKey);
                return false;
            }
            const usize dotIndex = trimmedKey.find('.');
            if(dotIndex == 0u || dotIndex + 1u >= trimmedKey.size() || trimmedKey.find('.', dotIndex + 1u) < trimmedKey.size()){
                error("{} '{}': override key '{}' must use block.field form", s_MaterialInstanceComponentDiagnosticPrefix, fileTextRef, paramKey);
                return false;
            }
            const Expected<Name> paramName = ParseName(trimmedKey);
            const Expected<Name> blockName = ParseName(trimmedKey.substr(0u, dotIndex));
            const Expected<Name> fieldName = ParseName(trimmedKey.substr(dotIndex + 1u));
            if(!paramName.has_value() || paramName.value() == s_NameNone || !blockName.has_value() || blockName.value() == s_NameNone || !fieldName.has_value() || fieldName.value() == s_NameNone){
                error("{} '{}': override key '{}' is invalid", s_MaterialInstanceComponentDiagnosticPrefix, fileTextRef, paramKey);
                return false;
            }
            if(!paramValue.isString()){
                error("{} '{}': override '{}' value must be a typed value string", s_MaterialInstanceComponentDiagnosticPrefix, fileTextRef, paramKey);
                return false;
            }
            const Expected<MaterialTypedValueData> typed = ParseMaterialTypedValue(trimmedKey, TrimView(paramValue.asString()));
            if(!typed.has_value()){
                error("{} '{}': override '{}' has invalid typed value '{}'", s_MaterialInstanceComponentDiagnosticPrefix, fileTextRef, paramKey, paramValue.asString());
                return false;
            }
            const MaterialLayoutFieldType fieldType = MaterialLayoutFieldTypeFromParameterType(
                cast<MaterialParameterValueType>(typed.value().meta.z),
                typed.value().meta.w
            );
            if(!IsMaterialLayoutNumericFieldType(fieldType)){
                error("{} '{}': override '{}' must have a numeric field type", s_MaterialInstanceComponentDiagnosticPrefix, fileTextRef, paramKey);
                return false;
            }
            MaterialInstanceParameter param;
            param.parameterName = paramName.value();
            param.blockName = blockName.value();
            param.fieldName = fieldName.value();
            param.fieldType = fieldType;
            param.value = MaterialTypedValueToLayoutValue(typed.value());
            entry.component.overrides.push_back(param);
            return true;
        }))
            return MakeUnexpected(Failure());

        if(entry.component.overrides.size() > 1u)
            SortSequence<MaterialInstanceParameter>(entry.component.overrides, LessMaterialInstanceParameter);
        if(!entry.component.overrides.empty())
            entry.component.revision = 1u;
    }

    if(!BuildComponentAssetFromEntry<MaterialInstanceComponentAsset, MaterialInstanceComponentCookEntry>(entry).has_value())
        return MakeUnexpected(Failure());
    return entry;
}

Expected<SkeletonJointPaletteComponentCookEntry> ParseSkeletonJointPaletteComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue asset){
    SkeletonJointPaletteComponentCookEntry entry;
    if(!CheckMetadataAssetMap(file, asset, s_SkeletonJointPaletteComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_SkeletonJointPaletteComponentDiagnosticPrefix, entry)
        || !ValidateMetadataAssetFields(file, asset, s_SkeletonJointPaletteComponentDiagnosticPrefix, IsAllowedSkeletonJointPaletteComponentMetadataField))
        return MakeUnexpected(Failure());

    if(!ReadOptionalSkeletonSkinningModeField(file, asset, s_SkeletonJointPaletteComponentDiagnosticPrefix, entry.component.skinningMode))
        return MakeUnexpected(Failure());
    if(!ReadOptionalMatrix3x4ListField(file, asset, s_SkeletonJointPaletteComponentDiagnosticPrefix, s_SkeletonJointPaletteJointsField, entry.component.joints))
        return MakeUnexpected(Failure());
    if(!BuildComponentAssetFromEntry<SkeletonJointPaletteComponentAsset, SkeletonJointPaletteComponentCookEntry>(entry).has_value())
        return MakeUnexpected(Failure());
    return entry;
}

Expected<SkeletonPoseComponentCookEntry> ParseSkeletonPoseComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue asset){
    SkeletonPoseComponentCookEntry entry;
    if(!CheckMetadataAssetMap(file, asset, s_SkeletonPoseComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_SkeletonPoseComponentDiagnosticPrefix, entry)
        || !ValidateMetadataAssetFields(file, asset, s_SkeletonPoseComponentDiagnosticPrefix, IsAllowedSkeletonPoseComponentMetadataField))
        return MakeUnexpected(Failure());

    if(!ReadOptionalSkeletonSkinningModeField(file, asset, s_SkeletonPoseComponentDiagnosticPrefix, entry.component.skinningMode))
        return MakeUnexpected(Failure());
    if(!ReadOptionalParentJointListField(file, asset, s_SkeletonPoseComponentDiagnosticPrefix, s_SkeletonPoseParentJointsField, entry.component.parentJoints))
        return MakeUnexpected(Failure());
    if(!ReadOptionalMatrix3x4ListField(file, asset, s_SkeletonPoseComponentDiagnosticPrefix, s_SkeletonPoseLocalJointsField, entry.component.localJoints))
        return MakeUnexpected(Failure());
    if(!BuildComponentAssetFromEntry<SkeletonPoseComponentAsset, SkeletonPoseComponentCookEntry>(entry).has_value())
        return MakeUnexpected(Failure());
    return entry;
}

Expected<SkinnedMeshBindingComponentCookEntry> ParseSkinnedMeshBindingComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue asset){
    SkinnedMeshBindingComponentCookEntry entry;
    if(!CheckMetadataAssetMap(file, asset, s_SkinnedMeshBindingComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_SkinnedMeshBindingComponentDiagnosticPrefix, entry)
        || !ValidateMetadataAssetFields(file, asset, s_SkinnedMeshBindingComponentDiagnosticPrefix, IsAllowedSkinnedMeshBindingComponentMetadataField))
        return MakeUnexpected(Failure());

    const Expected<AssetRef<Skin>> skinRef = ReadGraphicsComponentReference<Skin>(
        file, asset, s_SkinnedMeshBindingComponentDiagnosticPrefix, s_SkinnedMeshBindingSkinField
    );
    if(!skinRef.has_value())
        return MakeUnexpected(Failure());
    entry.component.skin = skinRef.value();

    const Expected<Name> skeletonEntityName = ReadUnpaddedNameField(
        file, asset, s_SkinnedMeshBindingComponentDiagnosticPrefix, s_SkinnedMeshBindingSkeletonEntityNameField, false
