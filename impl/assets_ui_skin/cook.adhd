[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if defined(NWB_COOK)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_ui_skin/asset.adhd.h>

#include <core/alloc/scratch.h>
#include <core/metascript/parser.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct UiSkinCookEntry{
    Core::Assets::AssetArena& arena;
    UiSkin::RegionVector regions;
    Core::Assets::AssetRef<Texture> texture;
    Name virtualPath = s_NameNone;
    u32 atlasWidth = 0u;
    u32 atlasHeight = 0u;
    f32 referenceDensity = 1.0f;
    b8 completeToolkitSkin = false;
    UiSkinPalette palette;
    UiSkinTypography typography;


public:
    explicit UiSkinCookEntry(Core::Assets::AssetArena& memoryArena)noexcept
        : arena(memoryArena)
        , regions(memoryArena)
    {}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] Expected<UiSkinCookEntry> ParseUiSkinCookMetadata(Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<UiSkinCookEntry> ParseUiSkinCookMetadata(const Path& assetRoot, AStringView virtualRoot, const Path& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);

template<typename FileArenaT>
    requires (!IsSame_V<FileArenaT, Core::Alloc::GlobalArena>)
[[nodiscard]] NWB_INLINE Expected<UiSkinCookEntry> ParseUiSkinCookMetadata(const Name virtualPath, const ::Path<FileArenaT>& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    return ParseUiSkinCookMetadata(virtualPath, Path(arena, nwbFilePath), asset, arena, scratchArena);
}

template<typename RootArenaT, typename FileArenaT>
    requires (!IsSame_V<RootArenaT, Core::Alloc::GlobalArena> || !IsSame_V<FileArenaT, Core::Alloc::GlobalArena>)
[[nodiscard]] NWB_INLINE Expected<UiSkinCookEntry> ParseUiSkinCookMetadata(const ::Path<RootArenaT>& assetRoot, const AStringView virtualRoot, const ::Path<FileArenaT>& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    return ParseUiSkinCookMetadata(Path(arena, assetRoot), virtualRoot, Path(arena, nwbFilePath), doc, arena, scratchArena);
}
[[nodiscard]] Expected<UiSkin> BuildUiSkinAsset(const UiSkinCookEntry& entry, Core::Assets::AssetArena& arena);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


UiSkinRegion BuildParsedUiSkinRegion(
    in Name name,
    in UiSkinDrawMode drawMode,
    in Array<u32, 4> rectangleValues,
    in Array<u32, 4> sliceValues,
    in Array<f32, 4> paddingValues,
    in Array<f32, 2> minimumSizeValues
){
    UiSkinRegion region;
    region.name = name;
    region.drawMode = drawMode;
    region.rectangle = UiSkinRect(rectangleValues[0u], rectangleValues[1u], rectangleValues[2u], rectangleValues[3u]);
    region.sliceInsets = UiSkinSliceInsets(sliceValues[0u], sliceValues[1u], sliceValues[2u], sliceValues[3u]);
    region.padding = UiSkinInsets(paddingValues[0u], paddingValues[1u], paddingValues[2u], paddingValues[3u]);
    region.minimumWidth = minimumSizeValues[0u];
    region.minimumHeight = minimumSizeValues[1u];
    return region;
}

b8 IsValidNewUiSkinPaletteRole(in usize role, in b8 alreadySeen){
    return role < cast<usize>(UiSkinColorRole::kCount) && !alreadySeen;
}

UiSkinColor BuildParsedUiSkinPaletteColor(in Array<f32, 4> components){
    return UiSkinColor(components[0u], components[1u], components[2u], components[3u]);
}

b8 IsValidUiSkinToolkitContractOption(in b8 hasToolkitContract, in StringView toolkitContract){
    return !hasToolkitContract || toolkitContract == s_UiSkinWidgetsContract;
}

Expected<u32> ValidateUiSkinU32FieldValue(in Path path, in StringView fieldName, in b8 isInteger, in i64 rawValue){
    if(isInteger && FitsU32(rawValue))
        return cast<u32>(rawValue);

    error("{} '{}': field '{}' must contain integers in the u32 range", s_UiSkinDiagnosticPrefix, PathToString(path), fieldName);
    return MakeUnexpected(Failure());
}

b8 ValidateUiSkinComponentListLength(
    in Path path,
    in StringView fieldName,
    in b8 isList,
    in usize listSize,
    in usize expectedCount,
    in StringView kindLabel
){
    if(isList && listSize == expectedCount)
        return true;

    error("{} '{}': field '{}' must be a {}-component {} list", s_UiSkinDiagnosticPrefix, PathToString(path), fieldName, expectedCount, kindLabel);
    return false;
}

b8 ValidateUiSkinPaletteRoleCount(in Path path, in usize count){
    if(count == cast<usize>(UiSkinColorRole::kCount))
        return true;

    error("{} '{}': colors must contain exactly {} named RGBA roles", s_UiSkinDiagnosticPrefix, PathToString(path), cast<u32>(UiSkinColorRole::kCount));
    return false;
}

b8 ValidateUiSkinNewPaletteRole(in Path path, in StringView name, in usize role, in b8 alreadySeen){
    if(IsValidNewUiSkinPaletteRole(role, alreadySeen))
        return true;

    error("{} '{}': unknown or duplicate palette role '{}'", s_UiSkinDiagnosticPrefix, PathToString(path), name);
    return false;
}

b8 ValidateUiSkinPaletteChannelList(in Path path, in StringView name, in b8 isValidList){
    if(isValidList)
        return true;

    error("{} '{}': palette role '{}' needs four RGBA components", s_UiSkinDiagnosticPrefix, PathToString(path), name);
    return false;
}

b8 ValidateUiSkinPaletteChannel(in Path path, in StringView name, in f32 value, in u64 index){
    if(IsValidUiSkinPaletteChannelValue(value, index))
        return true;

    error("{} '{}': palette role '{}' needs RGB in [0, 16] and alpha in [0, 1]", s_UiSkinDiagnosticPrefix, PathToString(path), name);
    return false;
}

b8 ValidateUiSkinTypographyPresent(in Path path, in b8 present){
    if(present)
        return true;

    error("{} '{}': skins require typography.default_font_size", s_UiSkinDiagnosticPrefix, PathToString(path));
    return false;
}

b8 ValidateUiSkinDefaultFontSizeValue(in Path path, in f32 defaultFontSize){
    if(IsValidUiSkinDefaultFontSize(defaultFontSize))
        return true;

    error("{} '{}': typography.default_font_size must be in [1/64, 2048]", s_UiSkinDiagnosticPrefix, PathToString(path));
    return false;
}

b8 ValidateUiSkinToolkitContractValue(in Path path, in b8 hasToolkitContract, in StringView toolkitContract){
    if(IsValidUiSkinToolkitContractOption(hasToolkitContract, toolkitContract))
        return true;

    error("{} '{}': toolkit_contract must be 'widgets'", s_UiSkinDiagnosticPrefix, PathToString(path));
    return false;
}

b8 ValidateUiSkinRegionsListCount(in Path path, in usize count){
    if(count > cast<usize>(s_UiSkinMaxRegionCount)){
        error("{} '{}': regions exceed schema limit {}", s_UiSkinDiagnosticPrefix, PathToString(path), s_UiSkinMaxRegionCount);
        return false;
    }
    if(count == 0u){
        error("{} '{}': regions must be nonempty and fit the supported count", s_UiSkinDiagnosticPrefix, PathToString(path));
        return false;
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if defined(NWB_COOK)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_ui_skin/ui_skin_binary_codec.adhd.h>

#include <core/assets/cook_metadata.h>
#include <core/common/log.h>

#include <global/binary.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_ui_skin_cook_metadata{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace Core::Metascript;

static constexpr Array<::NamedEnumCase<UiSkinDrawMode::Enum>, 2u> s_DrawModeCases = {
    ::NamedEnumCase<UiSkinDrawMode::Enum>{ s_UiSkinDrawModeSprite, UiSkinDrawMode::Sprite },
    ::NamedEnumCase<UiSkinDrawMode::Enum>{ s_UiSkinDrawModeNineSlice, UiSkinDrawMode::NineSlice },
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] static Expected<u32> ReadU32Value(const Path& path, const Value& value, const AStringView fieldName){
    const b8 isInteger = value.isInteger();
    return ValidateUiSkinU32FieldValue(path, fieldName, isInteger, isInteger ? value.asInteger() : 0);
}

template<usize Count>
[[nodiscard]] static Expected<Array<u32, Count>> ReadU32List(const Path& path, const Value& object, const AStringView fieldName, const b8 required){
    Array<u32, Count> values{};

    const Value* field = object.findField(fieldName);
    if(!field && !required)
        return values;
    const b8 isList = field != nullptr && field->isList();
    if(!ValidateUiSkinComponentListLength(path, fieldName, isList, isList ? field->asList().size() : 0u, Count, "integer"))
        return MakeUnexpected(Failure{});
    for(usize index = 0u; index < Count; ++index){
        auto valueResult = ReadU32Value(path, field->asList()[index], fieldName);
        if(!valueResult)
            return MakeUnexpected(Failure{});
        values[index] = *valueResult;
    }
    return values;
}

template<usize Count>
[[nodiscard]] static Expected<Array<f32, Count>> ReadLogicalList(const Path& path, const Value& object, const AStringView fieldName){
    Array<f32, Count> values{};

    const Value* field = object.findField(fieldName);
    if(!field)
        return values;
    const b8 isList = field->isList();
    if(!ValidateUiSkinComponentListLength(path, fieldName, isList, isList ? field->asList().size() : 0u, Count, "numeric"))
        return MakeUnexpected(Failure{});
    for(usize index = 0u; index < Count; ++index){
        auto indexResult = Core::Assets::ReadMetadataFiniteF32Value(path, field->asList()[index], s_UiSkinDiagnosticPrefix, fieldName);
        if(!indexResult)
            return MakeUnexpected(Failure{});
        values[index] = *indexResult;
    }
    return values;
}

[[nodiscard]] static Expected<UiSkinRegion> ParseRegion(const Path& path, const Value& object){
    UiSkinDrawMode::Enum drawMode = UiSkinDrawMode::Sprite;

    if(!Core::Assets::CheckMetadataAssetMap(path, object, s_UiSkinDiagnosticPrefix))
        return MakeUnexpected(Failure{});
    if(object.findField(s_UiSkinDrawModeField)){
        auto drawModeResult = Core::Assets::ParseNamedMetadataEnumField<UiSkinDrawMode::Enum>(path, object, s_UiSkinDiagnosticPrefix, s_UiSkinDrawModeField, s_DrawModeCases, s_UiSkinDrawModeHint);
        if(!drawModeResult)
            return MakeUnexpected(Failure{});
        drawMode = *drawModeResult;
    }

    if(!Core::Assets::ValidateMetadataAssetFields(path, object, s_UiSkinDiagnosticPrefix, [hasSlice = drawMode == UiSkinDrawMode::NineSlice](const AStringView field)noexcept{
        return IsAllowedUiSkinRegionField(field, hasSlice);
    }))
        return MakeUnexpected(Failure{});
    auto nameResult = Core::Assets::ReadMetadataNameField(path, object, s_UiSkinDiagnosticPrefix, s_UiSkinNameField, true);
    if(!nameResult)
        return MakeUnexpected(Failure{});

    auto rectangleResult = ReadU32List<s_UiSkinRectComponentCount>(path, object, s_UiSkinRectField, true);
    if(!rectangleResult)
        return MakeUnexpected(Failure{});
    auto sliceResult = ReadU32List<s_UiSkinSliceComponentCount>(path, object, s_UiSkinSliceField, drawMode == UiSkinDrawMode::NineSlice);
    if(!sliceResult)
        return MakeUnexpected(Failure{});
    auto paddingResult = ReadLogicalList<s_UiSkinPaddingComponentCount>(path, object, s_UiSkinPaddingField);
    if(!paddingResult)
        return MakeUnexpected(Failure{});
    auto minimumSizeResult = ReadLogicalList<s_UiSkinMinimumSizeComponentCount>(path, object, s_UiSkinMinimumSizeField);
    if(!minimumSizeResult)
        return MakeUnexpected(Failure{});

    return BuildParsedUiSkinRegion(*nameResult, drawMode, *rectangleResult, *sliceResult, *paddingResult, *minimumSizeResult);
}

[[nodiscard]] static Expected<UiSkinPalette> ParsePalette(const Path& path, const Value& asset){
    UiSkinPalette palette{};

    const auto colors = Core::Assets::FindMetadataListField(path, asset, s_UiSkinDiagnosticPrefix, s_UiSkinColorsField);
    if(!colors)
        return MakeUnexpected(colors.error());
    if(!ValidateUiSkinPaletteRoleCount(path, (*colors)->asList().size()))
        return MakeUnexpected(Failure{});

    Array<b8, UiSkinColorRole::kCount> seen{};
    for(const Value& value : (*colors)->asList()){
        if(!Core::Assets::CheckMetadataAssetMap(path, value, s_UiSkinDiagnosticPrefix) || !Core::Assets::ValidateMetadataAssetFields(path, value, s_UiSkinDiagnosticPrefix, &IsAllowedUiSkinPaletteRoleField))
            return MakeUnexpected(Failure{});
        auto nameResultValue = Core::Assets::ReadMetadataStringField(path, value, s_UiSkinDiagnosticPrefix, s_UiSkinNameField, true);
        if(!nameResultValue)
            return MakeUnexpected(Failure{});
        const AStringView name = nameResultValue->text;
        const usize role = ResolveUiSkinColorRole(name);
        if(!ValidateUiSkinNewPaletteRole(path, name, role, role < UiSkinColorRole::kCount ? seen[role] : true))
            return MakeUnexpected(Failure{});
        const Value* rgba = value.findField(s_UiSkinRgbaField);
        if(!ValidateUiSkinPaletteChannelList(path, name, rgba != nullptr && rgba->isList() && rgba->asList().size() == s_UiSkinRgbaComponentCount))
            return MakeUnexpected(Failure{});
        Array<f32, s_UiSkinRgbaComponentCount> components{};
        for(usize index = 0u; index < s_UiSkinRgbaComponentCount; ++index){
            auto indexResultValue = Core::Assets::ReadMetadataFiniteF32Value(path, rgba->asList()[index], s_UiSkinDiagnosticPrefix, s_UiSkinRgbaField);
            if(!indexResultValue)
                return MakeUnexpected(Failure{});
            components[index] = *indexResultValue;
            if(!ValidateUiSkinPaletteChannel(path, name, components[index], index))
                return MakeUnexpected(Failure{});
        }
        palette.colors[role] = BuildParsedUiSkinPaletteColor(components);
        seen[role] = true;
    }
    return palette;
}

[[nodiscard]] static Expected<UiSkinTypography> ParseTypography(const Path& path, const Value& asset){
    UiSkinTypography typographyResult{};

    const Value* typography = asset.findField(s_UiSkinTypographyField);
    if(!ValidateUiSkinTypographyPresent(path, typography != nullptr))
        return MakeUnexpected(Failure{});
    if(!Core::Assets::CheckMetadataAssetMap(path, *typography, s_UiSkinDiagnosticPrefix) || !Core::Assets::ValidateMetadataAssetFields(path, *typography, s_UiSkinDiagnosticPrefix, &IsAllowedUiSkinTypographyField))
        return MakeUnexpected(Failure{});
    auto defaultFontSizeResult = Core::Assets::ReadMetadataFiniteF32Field(path, *typography, s_UiSkinDiagnosticPrefix, s_UiSkinDefaultFontSizeField, true);
    if(!defaultFontSizeResult)
        return MakeUnexpected(Failure{});
    typographyResult.defaultFontSize = *defaultFontSizeResult;
    if(!ValidateUiSkinDefaultFontSizeValue(path, typographyResult.defaultFontSize))
        return MakeUnexpected(Failure{});
    return typographyResult;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 UiSkinAssetCodec::serialize(const Core::Assets::IAsset& asset, Core::Assets::AssetBytes& outBinary)const{
    if(!checkSerializeAssetType(asset, NWB_TEXT("UiSkinAssetCodec::serialize")))
        return false;
    const UiSkin& skin = *MakeNotNull(checked_cast<const UiSkin*>(&asset));
    if(!skin.validatePayload())
        return false;

    return UiSkinBinaryCodec().serialize(
        skin.texture(),
        skin.atlasWidth(),
        skin.atlasHeight(),
        skin.referenceDensity(),
        skin.regions(),
        skin.palette(),
        skin.typography(),
        outBinary
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<UiSkin> BuildUiSkinAsset(const UiSkinCookEntry& entry, Core::Assets::AssetArena& arena){
    if(!ValidateUiSkinCookRegionCount(entry.regions.size()))
        return MakeUnexpected(Failure{});
    UiSkin candidate(arena, entry.virtualPath);
    UiSkin::RegionVector regions(entry.regions.begin(), entry.regions.end(), arena);
    candidate.setAtlas(entry.texture, entry.atlasWidth, entry.atlasHeight, entry.referenceDensity, Move(regions));
    candidate.setPalette(entry.palette);
    candidate.setTypography(entry.typography);
    if(entry.completeToolkitSkin ? !ValidateUiSkinToolkitContract(candidate) : !candidate.validatePayload())
        return MakeUnexpected(Failure{});
    return candidate;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<UiSkinCookEntry> ParseUiSkinCookMetadata(const Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena&){
    using namespace __hidden_ui_skin_cook_metadata;

    UiSkinCookEntry parsed(arena);
    if(!Core::Assets::CheckMetadataAssetMap(nwbFilePath, asset, s_UiSkinDiagnosticPrefix))
        return MakeUnexpected(Failure{});
    if(!Core::Assets::AssignCookEntryVirtualPath(virtualPath, nwbFilePath, s_UiSkinDiagnosticPrefix, parsed))
        return MakeUnexpected(Failure{});
    if(!Core::Assets::ValidateMetadataAssetFields(nwbFilePath, asset, s_UiSkinDiagnosticPrefix, &IsAllowedUiSkinMetadataField))
        return MakeUnexpected(Failure{});

    auto paletteResult = ParsePalette(nwbFilePath, asset);
    if(!paletteResult)
        return MakeUnexpected(Failure{});
    parsed.palette = *paletteResult;
    auto typographyResult = ParseTypography(nwbFilePath, asset);
    if(!typographyResult)
        return MakeUnexpected(Failure{});
    parsed.typography = *typographyResult;
    auto textureResult = Core::Assets::ReadMetadataAssetRefField<Texture>(nwbFilePath, asset, s_UiSkinDiagnosticPrefix, s_UiSkinTextureField, true);
    if(!textureResult)
        return MakeUnexpected(Failure{});
    parsed.texture = *textureResult;

    auto extentResult = ReadU32List<s_UiSkinAtlasExtentComponentCount>(nwbFilePath, asset, s_UiSkinAtlasExtentField, true);
    if(!extentResult)
        return MakeUnexpected(Failure{});
    parsed.atlasWidth = (*extentResult)[0u];
    parsed.atlasHeight = (*extentResult)[1u];
    auto referenceDensityResult = Core::Assets::ReadMetadataFiniteF32Field(nwbFilePath, asset, s_UiSkinDiagnosticPrefix, s_UiSkinReferenceDensityField, true);
    if(!referenceDensityResult)
        return MakeUnexpected(Failure{});
    parsed.referenceDensity = *referenceDensityResult;

    auto toolkitContractResult = Core::Assets::ReadMetadataStringField(nwbFilePath, asset, s_UiSkinDiagnosticPrefix, s_UiSkinToolkitContractField, false);
    if(!toolkitContractResult)
        return MakeUnexpected(Failure{});
    const AStringView toolkitContract = toolkitContractResult->text;
    const b8 hasToolkitContract = toolkitContractResult->present;
    if(!ValidateUiSkinToolkitContractValue(nwbFilePath, hasToolkitContract, toolkitContract))
        return MakeUnexpected(Failure{});
    parsed.completeToolkitSkin = hasToolkitContract;

    const auto regions = Core::Assets::FindMetadataListField(nwbFilePath, asset, s_UiSkinDiagnosticPrefix, s_UiSkinRegionsField);
    if(!regions)
        return MakeUnexpected(regions.error());
    if(!ValidateUiSkinRegionsListCount(nwbFilePath, (*regions)->asList().size()))
        return MakeUnexpected(Failure{});
    parsed.regions.reserve((*regions)->asList().size());
    for(const Value& value : (*regions)->asList()){
        auto regionResult = ParseRegion(nwbFilePath, value);
        if(!regionResult)
            return MakeUnexpected(Failure{});
        parsed.regions.push_back(*regionResult);
    }

    if(!BuildUiSkinAsset(parsed, arena))
        return MakeUnexpected(Failure{});
    return parsed;
}

Expected<UiSkinCookEntry> ParseUiSkinCookMetadata(const Path& assetRoot, const AStringView virtualRoot, const Path& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    return Core::Assets::ParseCookMetadataDocument<UiSkinCookEntry, &ParseUiSkinCookMetadata>(assetRoot, virtualRoot, nwbFilePath, doc, s_UiSkinDiagnosticPrefix, arena, scratchArena);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

