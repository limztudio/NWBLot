////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_AvboitDepthWarpGuardWords = 4u;
const u32 s_AvboitDepthWarpBatchSize = 64u;
const u32 s_AvboitDepthWarpSentinel = 0xa5f07c39u;
const u32 s_AvboitDepthWarpWarpWords = s_AvboitMaxVirtualCount + s_AvboitDepthWarpGuardWords;
const u32 s_AvboitDepthWarpControlWords = s_AvboitControlWordCount + s_AvboitDepthWarpGuardWords;
const u32 s_AvboitDepthWarpResultWords = s_AvboitDepthWarpWarpWords + s_AvboitDepthWarpControlWords;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Array<u32, 4u> BuildAvboitDepthWarpFrameDims(in u32 ordinal){
    Array<u32, 4u> dims;
    dims[0u] = 1000u + ordinal % 997u;
    dims[1u] = 300u + ordinal % 251u;
    dims[2u] = (dims[0u] + 2u) / 3u;
    dims[3u] = (dims[1u] + 3u) / 4u;
    return dims;
}

b8 VerifyDepthWarpProbeCaseWords(in AvboitDepthWarpCase probe, in u32 ordinal, in Span<u32> resultWords){
    const Array<u32, 4u> frameDims = BuildAvboitDepthWarpFrameDims(ordinal);
    const AvboitDepthWarpResult oracle = BuildAvboitDepthWarpOracle(probe, frameDims);
    for(u32 word = 0u; word < s_AvboitDepthWarpResultWords; ++word){
        u32 expected = s_AvboitDepthWarpSentinel;
        if(word < probe.virtualCount)
            expected = oracle.warp[word];
        else if(word >= s_AvboitDepthWarpWarpWords && word < s_AvboitDepthWarpWarpWords + s_AvboitControlWordCount)
            expected = oracle.control[word - s_AvboitDepthWarpWarpWords];
        if(resultWords[word] != expected){
            error(
                "AvboitDepthWarpProbe: mismatch case {} scenario {} virtual {} physical {} word {} expected {} observed {}"
                , ordinal
                , probe.scenario
                , probe.virtualCount
                , probe.physicalCount
                , word
                , expected
                , resultWords[word]
            );
            return false;
        }
    }
    return true;
}

b8 InitializeDepthWarpProbeProject(
    mut ProjectRuntimeContext context,
    mut ActiveSceneSubsystems sceneSubsystems,
    mut GlobalProbeCaseVector cases,
    mut ShaderHandle outShader,
    mut BindingLayoutHandle outPushLayout,
    mut ComputePipelineHandle outPipeline,
    mut BufferHandle outCoverage,
    mut BufferHandle outWarp,
    mut BufferHandle outControl,
    mut BufferHandle outSlots,
    mut BufferHandle outReadback,
    mut DescriptorHandleArray4 outDescriptors,
    mut DepthWarpUnfocusedPass unfocusedPass,
    mut b8 outUnfocusedPassRegistered
){
    Vector<AvboitDepthWarpCase> builtCases;
    BuildAvboitDepthWarpCases(builtCases);
    if(builtCases.size() != cast<usize>(s_AvboitTotalCaseCount)){
        error("AvboitDepthWarpProbe: case manifest count mismatch {}", builtCases.size());
        return false;
    }

    b8 initialized = false;
    native(
        in builtCases,
        mut context,
        mut sceneSubsystems,
        mut cases,
        mut outShader,
        mut outPushLayout,
        mut outPipeline,
        mut outCoverage,
        mut outWarp,
        mut outControl,
        mut outSlots,
        mut outReadback,
        mut outDescriptors,
        mut unfocusedPass,
        mut initialized
    ){
        cases.assign(builtCases.begin(), builtCases.end());
        auto& graphics = context.graphics;
        auto& device = graphics.getDevice();
        auto& heap = device.getDescriptorHeap();
        if(!heap.isInitialized()){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("AvboitDepthWarpProbe: bindless heap is unavailable"));
            return false;
        }
        if(!sceneSubsystems.loadProjectStartScene(context.assetManager))
            return false;
        const Impl::TransparentSubsystem* const transparentSubsystem = sceneSubsystems.findSubsystem<Impl::TransparentSubsystem>();
        const auto depthWarpShaderRef = transparentSubsystem ? transparentSubsystem->avboitDepthWarpCs : Core::Assets::AssetRef<Impl::ComputeShader>{};
        if(!depthWarpShaderRef.valid())
            return false;
        if(!Impl::ShaderAssetLoader::Load<Impl::ComputeShader>(
            depthWarpShaderRef.name(),
            Core::ShaderArchive::s_DefaultVariant,
            Name(s_SmokeNameAvboitDepthWarpProbe),
            FOUNDATION_TEXT("AvboitDepthWarpProbe"),
            graphics,
            context.assetManager,
            context.shaderPathResolver,
            nullptr,
            outShader
        ))
            return false;
        Core::BindingLayoutDesc layoutDesc(context.objectArena);
        layoutDesc.setVisibility(Core::ShaderType::Compute).addItem(Core::BindingLayoutItem::PushConstants(0u, NWB_AVBOIT_PUSH_CONSTANT_BYTE_SIZE));
        auto pushLayoutResult = device.createBindingLayout(layoutDesc);
        if(!pushLayoutResult){
            outPushLayout.reset();
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("AvboitDepthWarpProbe: push layout creation failed"));
            return false;
        }
        outPushLayout = Move(*pushLayoutResult);
        Core::ComputePipelineDesc pipelineDesc;
        pipelineDesc.setComputeShader(outShader).addBindingLayout(outPushLayout).addBindingLayout(heap.getResourceLayout()).addBindingLayout(heap.getSamplerLayout());
        auto pipelineResult = device.createComputePipeline(pipelineDesc);
        outPipeline = pipelineResult ? Move(*pipelineResult) : Core::ComputePipelineHandle{};
        auto coverageResult = CreateDepthWarpProbeBuffer(Name(s_SmokeNameDepthWarpProbeCoverage), s_AvboitCoverageWords, false, graphics);
        outCoverage = coverageResult ? Move(*coverageResult) : Core::BufferHandle{};
        auto warpResult = CreateDepthWarpProbeBuffer(Name(s_SmokeNameDepthWarpProbeWarp), s_AvboitDepthWarpWarpWords, false, graphics);
        outWarp = warpResult ? Move(*warpResult) : Core::BufferHandle{};
        auto controlResult = CreateDepthWarpProbeBuffer(Name(s_SmokeNameDepthWarpProbeControl), s_AvboitDepthWarpControlWords, false, graphics);
        outControl = controlResult ? Move(*controlResult) : Core::BufferHandle{};
        auto readbackResult = CreateDepthWarpProbeBuffer(Name(s_SmokeNameDepthWarpProbeReadback), s_AvboitDepthWarpBatchSize * s_AvboitDepthWarpResultWords, true, graphics);
        outReadback = readbackResult ? Move(*readbackResult) : Core::BufferHandle{};
        if(!pipelineResult || !coverageResult || !warpResult || !controlResult || !readbackResult){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("AvboitDepthWarpProbe: pipeline or buffer creation failed"));
            return false;
        }
        const Array<Core::BufferHandle, 3u> buffers{ outCoverage, outWarp, outControl };
        for(u32 index = 0u; index < buffers.size(); ++index){
            const Expected<Core::GpuDescriptorHandle> descriptor = heap.allocate(Core::GpuDescriptorClass::StorageBuffer);
            if(descriptor)
                outDescriptors[index] = *descriptor;
            if(!descriptor || !heap.write(outDescriptors[index], Core::DescriptorWriteItem::StructuredBufferUav(0u, buffers[index].get()))){
                NWB_LOGGER_ERROR(FOUNDATION_TEXT("AvboitDepthWarpProbe: storage descriptor setup failed at index {}"), index);
                return false;
            }
        }
        Impl::DeferredBindlessResourceSlots slots;
        slots.avboitCoverage = outDescriptors[0].slot();
        slots.avboitDepthWarp = outDescriptors[1].slot();
        slots.avboitControl = outDescriptors[2].slot();
        Core::GraphicsStandaloneService::BufferSetupDesc slotsDesc;
        slotsDesc.bufferDesc.setDebugName(Name(s_SmokeNameDepthWarpProbeSlots)).setByteSize(sizeof(slots)).setIsConstantBuffer(true).enableAutomaticStateTracking(Core::ResourceStates::ConstantBuffer);
        slotsDesc.data = &slots;
        slotsDesc.dataSize = sizeof(slots);
        slotsDesc.queue = Core::CommandQueue::Graphics;
        auto slotsResult = graphics.standaloneGraph().setupBuffer(slotsDesc);
        outSlots = slotsResult ? Move(*slotsResult) : Core::BufferHandle{};
        const Expected<Core::GpuDescriptorHandle> slotsDescriptor = heap.allocate(Core::GpuDescriptorClass::UniformBuffer);
        if(slotsDescriptor)
            outDescriptors[3] = *slotsDescriptor;
        if(!slotsResult || !slotsDescriptor || !heap.write(outDescriptors[3], Core::DescriptorWriteItem::ConstantBuffer(0u, outSlots.get()))){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("AvboitDepthWarpProbe: slot payload setup failed"));
            return false;
        }
        context.graphics.addRenderPassToBack(unfocusedPass);
        initialized = true;
    }
    if(!initialized)
        return false;

    [essential] info(
        "AvboitDepthWarpProbe: manifest boundary={} exhaustive={} randomized={} total={} seed=0x6b47c2d1"
        , s_AvboitBoundaryCaseCount
        , s_AvboitExhaustiveCaseCount
        , s_AvboitRandomCaseCount
        , s_AvboitTotalCaseCount
    );
    outUnfocusedPassRegistered = true;
    return true;
}

b8 CompareDepthWarpProbeBatch(mut ProjectRuntimeContext context, in BufferHandle readback, in ProbeBatchTaskPayload payload){
    b8 passed = true;
    native(mut context, in readback, in payload, mut passed){
        auto& device = context.graphics.getDevice();
        const Expected<void*> mappedResult = device.mapBuffer(*readback, Core::CpuAccessMode::Read);
        if(!mappedResult){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("AvboitDepthWarpProbe: readback mapping failed at case {}"), payload.firstCase);
            return false;
        }
        ScopeExit unmap([&]()noexcept{ device.unmapBuffer(*readback); });
        const auto mapped = MakeNotNull(static_cast<const u32*>(*mappedResult));
        for(u32 index = 0u; passed && index < payload.caseCount; ++index){
            const Span<const u32> caseWords(mapped.get() + index * s_AvboitDepthWarpResultWords, s_AvboitDepthWarpResultWords);
            passed = VerifyDepthWarpProbeCaseWords(payload.cases[index], payload.firstCase + index, caseWords);
        }
    }
    return passed;
}

b8 RunDepthWarpProbeProjectUpdate(
    mut ProjectRuntimeContext context,
    in ActiveSceneSubsystems sceneSubsystems,
    in GlobalProbeCaseVector cases,
    in BufferHandle coverage,
    in BufferHandle warp,
    in BufferHandle control,
    in BufferHandle slots,
    in BufferHandle readback,
    in ComputePipelineHandle pipeline,
    in DescriptorHandleArray4 descriptors,
    mut b8 outCompleted
){
    b8 batchesOk = false;
    native(
        mut context,
        in cases,
        in coverage,
        in warp,
        in control,
        in slots,
        in readback,
        in pipeline,
        in descriptors,
        mut batchesOk
    ){
        DepthWarpProbeBatchTask::Payload payload{ coverage, warp, control, slots, readback, pipeline, context.graphics.getDevice().getDescriptorHeap(), nullptr, 0u, 0u, descriptors[3].slot() };
        for(u32 firstCase = 0u; firstCase < cases.size(); firstCase += s_AvboitDepthWarpBatchSize){
            payload.cases = cases.data() + firstCase;
            payload.firstCase = firstCase;
            payload.caseCount = Min(s_AvboitDepthWarpBatchSize, static_cast<u32>(cases.size()) - firstCase);
            const auto token = context.graphics.standaloneGraph().submitStandaloneTaskGraph(&payload, DeclareDepthWarpBatch);
            if(!token){
                NWB_LOGGER_ERROR(FOUNDATION_TEXT("AvboitDepthWarpProbe: batch submission failed at case {}"), firstCase);
                return false;
            }
            if(!context.graphics.getDevice().waitForSubmissionToken(*token)){
                NWB_LOGGER_ERROR(FOUNDATION_TEXT("AvboitDepthWarpProbe: batch completion wait failed at case {}"), firstCase);
                return false;
            }
            if(!CompareDepthWarpProbeBatch(context, readback, payload))
                return false;
        }
        batchesOk = true;
    }
    if(!batchesOk)
        return false;
    if(!RunAvboitIntegrationProbe(sceneSubsystems, context) || !RunRefractionTileProbe(sceneSubsystems, context))
        return false;
    outCompleted = true;
    [essential] info("AvboitDepthWarpProbe: passed {} cases with full LUT/control comparison and sentinel tails", s_AvboitTotalCaseCount);
    context.requestQuit();
    return true;
}

void FreeDepthWarpProbeDescriptors(mut ProjectRuntimeContext context, mut DescriptorHandleArray4 descriptors){
    native(mut context, mut descriptors){
        auto& heap = context.graphics.getDevice().getDescriptorHeap();
        for(auto& descriptor : descriptors){
            if(descriptor.valid()){
                heap.free(descriptor);
                descriptor = Core::GpuDescriptorHandle::Invalid();
            }
        }
    }
}


