void ExerciseMessageProgressesWhileTelemetryBacklogRemains(mut ShutdownCaptureServer server, in u16 port){
    LogClientHolder holder = LogClientHolder();
    ServerFirstRequestReleaseGuard releaseGate = ServerFirstRequestReleaseGuard(server);
    const String url = StringFormat("http://127.0.0.1:{}", port);
    ASSERT_TRUE(holder.client.init(StringView(url)));
    Array<u8, 1> telemetry = Array<u8, 1>();
    telemetry[0] = 1u;
    ASSERT_TRUE(EnqueueClientTelemetry(holder.client, Span<u8>(telemetry)));
    for(u32 attempt = 0u; attempt < 500u && !server.processingFirstRequest(); ++attempt)
        SleepMS(1u);
    ASSERT_TRUE(server.processingFirstRequest());
    for(u32 index = 0u; index < 3u; ++index)
        ASSERT_TRUE(EnqueueClientTelemetry(holder.client, Span<u8>(telemetry)));
    EnqueueClientAscii(holder.client, "queued message");
    server.releaseFirstRequest();
    releaseGate.release();
    for(u32 attempt = 0u; attempt < 500u && server.requestCount() < 2u; ++attempt)
        SleepMS(10u);
    ASSERT_GE(server.requestCount(), 2u);
    EXPECT_TRUE(server.requestWasTelemetry(0u));
    EXPECT_FALSE(server.requestWasTelemetry(1u));
}

void VerifyLogClientShutdown_MessageProgressesWhileTelemetryBacklogRemains(){
    ShutdownCaptureServer server = ShutdownCaptureServer(s_HttpOk, false, true);
    u16 port = 0u;
    ASSERT_TRUE(server.start(port));
    ExerciseMessageProgressesWhileTelemetryBacklogRemains(server, port);
}

void ExerciseTelemetryProgressesWhileMessageBacklogRemains(mut ShutdownCaptureServer server, in u16 port){
    LogClientHolder holder = LogClientHolder();
    ServerFirstRequestReleaseGuard releaseGate = ServerFirstRequestReleaseGuard(server);
    const String url = StringFormat("http://127.0.0.1:{}", port);
    ASSERT_TRUE(holder.client.init(StringView(url)));
    EnqueueClientAscii(holder.client, "first message");
    for(u32 attempt = 0u; attempt < 500u && !server.processingFirstRequest(); ++attempt)
        SleepMS(1u);
    ASSERT_TRUE(server.processingFirstRequest());
    for(u32 index = 0u; index < 3u; ++index)
        EnqueueClientAscii(holder.client, "queued message");
    Array<u8, 1> telemetry = Array<u8, 1>();
    telemetry[0] = 1u;
    ASSERT_TRUE(EnqueueClientTelemetry(holder.client, Span<u8>(telemetry)));
    server.releaseFirstRequest();
    releaseGate.release();
    for(u32 attempt = 0u; attempt < 500u && server.requestCount() < 2u; ++attempt)
        SleepMS(10u);
    ASSERT_GE(server.requestCount(), 2u);
    EXPECT_FALSE(server.requestWasTelemetry(0u));
    EXPECT_TRUE(server.requestWasTelemetry(1u));
}

void VerifyLogClientShutdown_TelemetryProgressesWhileMessageBacklogRemains(){
    ShutdownCaptureServer server = ShutdownCaptureServer(s_HttpOk, false, true);
    u16 port = 0u;
    ASSERT_TRUE(server.start(port));
    ExerciseTelemetryProgressesWhileMessageBacklogRemains(server, port);
}

void ExerciseRetriesRejectedPayloadClient(mut ShutdownCaptureServer server, in u16 port){
    LogClientHolder holder = LogClientHolder();
    const String url = StringFormat("http://127.0.0.1:{}", port);
    ASSERT_TRUE(holder.client.init(StringView(url)));
    EnqueueClientAscii(holder.client, "first payload");
    EnqueueClientAscii(holder.client, "second payload");
    for(u32 attempt = 0u; attempt < 500u && server.requestCount() < 3u; ++attempt)
        SleepMS(10u);
    EXPECT_EQ(server.requestCount(), 3u);
}

void VerifyLogClientShutdown_RetriesRejectedPayloadBeforeSendingNextMessage(){
    ShutdownCaptureServer server = ShutdownCaptureServer(s_HttpServiceUnavailable);
    u16 port = 0u;
    ASSERT_TRUE(server.start(port));
    ExerciseRetriesRejectedPayloadClient(server, port);
    EXPECT_TRUE(server.firstPayloadRetried());
}

void VerifyLogClientShutdown_ShutdownInterruptsBackoffAfterRepeatedTemporaryFailures(){
    ShutdownCaptureServer server = ShutdownCaptureServer(s_HttpServiceUnavailable, true);
    u16 port = 0u;
    ASSERT_TRUE(server.start(port));
    String stderrText = "";
    Timer stopStarted = TimerNow();
    native(mut server, in port, mut stderrText, mut stopStarted){
        testing::internal::CaptureStderr();
        {
            LogClient client;
            const AString<Log::LogArena> url = StringFormat(client.arena(), "http://127.0.0.1:{}", port);
            const b8 initialized = client.init(AStringView(url.data(), url.size()));
            EXPECT_TRUE(initialized);
            if(initialized){
                EnqueueClientAscii(client, "retry payload");
                for(u32 attempt = 0u; attempt < 1200u && server.requestCount() < 7u; ++attempt)
                    SleepMS(10u);
                EXPECT_GE(server.requestCount(), 7u);
                SleepMS(50u);
            }
            stopStarted = TimerNow();
        }
        const auto captured = testing::internal::GetCapturedStderr();
        stderrText.assign(captured.data(), captured.size());
    }
    EXPECT_TRUE(Contains(StringView(stderrText), "stopped with an unsent payload"));
    EXPECT_LT(TimerNow(), TimerAddMS(stopStarted, 3000));
}

void VerifyLogClientShutdown_TransportFailureIsVisibleWithoutDiagnosticCallback(){
    const StringView invalidUrl = "http://[invalid";
    const u32 waitMilliseconds = 500u;
    b8 initialized = false;
    String stderrText = "";
    native(in invalidUrl, in waitMilliseconds, mut initialized, mut stderrText){
        testing::internal::CaptureStderr();
        {
            LogClient client;
            initialized = client.init(invalidUrl);
            if(initialized){
                EnqueueClientAscii(client, "unsent payload");
                SleepMS(waitMilliseconds);
            }
        }
        const auto captured = testing::internal::GetCapturedStderr();
        stderrText.assign(captured.data(), captured.size());
    }
    EXPECT_TRUE(initialized);
    EXPECT_TRUE(Contains(StringView(stderrText), "[ERROR] Log client: sending payload failed"));
    EXPECT_TRUE(Contains(StringView(stderrText), "stopped with an unsent payload"));
}

void ExercisePermanentBadRequestClient(mut ShutdownCaptureServer server, in u16 port){
    LogClientHolder holder = LogClientHolder();
    const String url = StringFormat("http://127.0.0.1:{}", port);
    ASSERT_TRUE(holder.client.init(StringView(url)));
    EnqueueClientAscii(holder.client, "rejected payload");
    EnqueueClientAscii(holder.client, "later payload");
    for(u32 attempt = 0u; attempt < 500u && server.requestCount() < 2u; ++attempt)
        SleepMS(10u);
    EXPECT_EQ(server.requestCount(), 2u);
    EXPECT_EQ(holder.client.rejectedPayloadCount(), 1u);
}

void VerifyLogClientShutdown_PermanentBadRequestDoesNotBlockLaterMessages(){
    ShutdownCaptureServer server = ShutdownCaptureServer(s_HttpBadRequest);
    u16 port = 0u;
    ASSERT_TRUE(server.start(port));
    ExercisePermanentBadRequestClient(server, port);
    EXPECT_EQ(server.requestCount(), 2u);
    EXPECT_FALSE(server.firstPayloadRetried());
}

void ExerciseOversizedMessageClient(mut ShutdownCaptureServer server, in u16 port){
    LogClientHolder holder = LogClientHolder();
    const String url = StringFormat("http://127.0.0.1:{}", port);
    ASSERT_TRUE(holder.client.init(StringView(url)));
    native(mut holder){
        Log::LogString message(holder.client.arena());
        message.resize(Log::s_MaxLogMessageUploadBytes / sizeof(tchar) + 1u, static_cast<tchar>('x'));
        holder.client.enqueue(TStringView(message.data(), message.size()));
    }
    EnqueueClientAscii(holder.client, "later payload");
    for(u32 attempt = 0u; attempt < 500u && server.requestCount() < 2u; ++attempt)
        SleepMS(10u);
    EXPECT_EQ(server.requestCount(), 2u);
    EXPECT_EQ(holder.client.rejectedPayloadCount(), 1u);
}

void VerifyLogClientShutdown_OversizedMessageDoesNotBlockLaterMessages(){
    ShutdownCaptureServer server = ShutdownCaptureServer();
    u16 port = 0u;
    ASSERT_TRUE(server.start(port));
    ExerciseOversizedMessageClient(server, port);
    EXPECT_GT(server.firstPayloadSize(), 0u);
    EXPECT_LT(server.firstPayloadSize(), 1024u);
    EXPECT_FALSE(server.firstPayloadRetried());
}

void VerifyLogClientShutdown_OversizedTelemetryIsRejectedBeforeReadingItsBuffer(){
    LogClientHolder holder = LogClientHolder();
    native(mut holder){
        const u8 byte = 0u;
        EXPECT_FALSE(holder.client.enqueueTelemetry(&byte, Log::s_MaxTelemetryUploadBytes + 1u));
    }
    EXPECT_EQ(holder.client.rejectedPayloadCount(), 1u);
}

void EnqueueShutdownMessages(in u16 port){
    LogClientHolder holder = LogClientHolder();
    const String url = StringFormat("http://127.0.0.1:{}", port);
    ASSERT_TRUE(holder.client.init(StringView(url)));

    for(u32 messageIndex = 0u; messageIndex < s_ShutdownMessageCount; ++messageIndex){
        const String payload = StringFormat("Log client shutdown payload {}", messageIndex);
        EnqueueClientAscii(holder.client, StringView(payload));
    }
}

void VerifyLogClientShutdown_DrainsEveryQueuedMessageAfterStopBegins(){
    ShutdownCaptureServer server = ShutdownCaptureServer();
    u16 port = 0u;
    ASSERT_TRUE(server.start(port));
    EnqueueShutdownMessages(port);
    EXPECT_EQ(server.requestCount(), s_ShutdownMessageCount);
}


