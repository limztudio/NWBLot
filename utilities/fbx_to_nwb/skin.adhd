f64 ComputeFbxInverseScale(in f64 scale){
    return s_UniformScaleNumerator / scale;
}

b8 ReachedSkinInfluenceJointLimit(in u32 writtenInfluenceCount){
    return writtenInfluenceCount == cast<u32>(s_SkinInfluenceJointCount);
}


