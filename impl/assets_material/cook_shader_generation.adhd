#include <impl/assets_material/bind_source_emitter.adhd>
#include <impl/assets_material/cook_entry.adhd>
#include <impl/assets_material/shadow_surface_source_builder.adhd>
#include <impl/assets_material/material_shadow_dispatch.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<String> BuildMaterialBindIncludeVirtualPath(in StringView virtualPath, in StringView source){
    if(!ValidateMaterialBindIncludePath(virtualPath, source))
        return MakeUnexpected(Failure());

    String includePath(virtualPath);
    includePath += s_MaterialBindSourceExtensionText;
    return includePath;
}

Expected<String> BuildMaterialBindIncludeSourceFromData(
    in StringView source,
    in StringView virtualPath,
    in Span<MaterialBindStruct> structs,
    in Span<MaterialBindInstance> instances
){
    String outSource;
    MaterialBindSourceEmitter emitter;
    if(!emitter.buildMaterialBindIncludeSourceFromData(source, virtualPath, structs, instances, outSource))
        return MakeUnexpected(Failure());
    return outSource;
}

b8 WriteDeferredBxdfDispatchIncludeFile(in Path includeRoot, in Span<StringView> sourceById){
    const String source = BuildDeferredBxdfDispatchModuleSource(sourceById);
    const Path outputPath = includeRoot / s_DeferredBxdfModuleSubPath;
    const Path parentPath = outputPath.parentPath();
    const auto ensureDirectoriesResult = EnsureDirectories(parentPath);
    if(!ensureDirectoriesResult.has_value()){
        error("Deferred bxdf dispatch: failed to create generated include parent '{}' (error {})", parentPath, ensureDirectoriesResult.error().value());
        return false;
    }
    if(!WriteTextFile(outputPath, source)){
        error("Deferred bxdf dispatch: failed to write generated include '{}'", outputPath);
        return false;
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<String> BuildMaterialBindIncludeSource(in MaterialBindEntry entry){
    return BuildMaterialBindIncludeSourceFromData(entry.source, entry.virtualPath, entry.structs, entry.instances);
}

Expected<Path> EmitMaterialBindIncludes(in Path cache, in StringView configuration, in Span<MaterialBindEntry> entries){
    const Path root = cache / configuration / s_MaterialBindGeneratedIncludeCacheDirectoryText;
    if(!PrepareGeneratedIncludeRoot(root, s_MaterialBindIncludeGenerationLabel))
        return MakeUnexpected(Failure());
    HashSet<String> seen;
    seen.reserve(entries.size());
    for(in MaterialBindEntry entry : entries){
        const Expected<String> includePath = BuildMaterialBindIncludeVirtualPath(entry.virtualPath, entry.source);
        if(!includePath.has_value())
            return MakeUnexpected(Failure());
        if(!seen.insert(includePath.value()).second){
            error("Material bind include generation: duplicate material bind include path '{}'", includePath.value());
            return MakeUnexpected(Failure());
        }
        const Expected<String> source = BuildMaterialBindIncludeSource(entry);
        if(!source.has_value())
            return MakeUnexpected(Failure());
        const Path output = root / includePath.value();
        const Expected<void, ErrorCode> created = EnsureDirectories(output.parentPath());
        if(!created.has_value()){
            error("Material bind include generation: failed to create generated include parent '{}': {}", output.parentPath(), ErrorCodeMessage(created.error()));
            return MakeUnexpected(Failure());
        }
        if(!WriteTextFile(output, source.value())){
            error("Material bind include generation: failed to write generated include '{}'", output);
            return MakeUnexpected(Failure());
        }
    }
    return root;
}

b8 AssignMaterialShadingModelIds(mut Span<MaterialCookEntry> entries){
    Vector<StringView> sources;
    sources.reserve(entries.size());
    for(in MaterialCookEntry entry : entries){
        if(!ValidateDeferredBxdfSource(entry.virtualPath, entry.bxdfSource))
            return false;
        sources.push_back(StringView(entry.bxdfSource));
    }
    SortUniqueSequence<StringView>(sources);
    if(!ValidateDeferredBxdfCount(sources.size()))
        return false;
    for(mut MaterialCookEntry entry : entries){
        const usize index = LowerBoundValueIndex<StringView>(sources, StringView(entry.bxdfSource));
        assert(index < sources.size() && sources[index] == entry.bxdfSource);
        entry.shadingModelId = cast<u32>(index);
    }
    Vector<StringView> surfaces;
    surfaces.reserve(entries.size());
    for(in MaterialCookEntry entry : entries){
        if(!entry.surfaceSource.empty())
            surfaces.push_back(StringView(entry.surfaceSource));
    }
    SortUniqueSequence<StringView>(surfaces);
    if(!ValidateMaterialSurfaceCount(surfaces.size()))
        return false;
    for(mut MaterialCookEntry entry : entries){
        if(entry.surfaceSource.empty()){
            entry.surfaceDispatchId = s_NoSurfaceDispatchId;
            continue;
        }
        const usize index = LowerBoundValueIndex<StringView>(surfaces, StringView(entry.surfaceSource));
        assert(index < surfaces.size() && surfaces[index] == entry.surfaceSource);
        entry.surfaceDispatchId = cast<u32>(index);
    }
    return true;
}

Expected<Path> EmitDeferredBxdfDispatchModule(in Path cache, in StringView configuration, in Span<MaterialCookEntry> entries){
    const Path root = cache / configuration / s_DeferredBxdfIncludeSubDir;
    if(!PrepareGeneratedIncludeRoot(root, s_DeferredBxdfDispatchGenerationLabel))
        return MakeUnexpected(Failure());
    usize slots = 0u;
    for(in MaterialCookEntry entry : entries){
        if(!entry.bxdfSource.empty())
            slots = Max(slots, ResolveDispatchSlotTableCapacity(true, entry.shadingModelId));
    }
    Vector<StringView> sources;
    sources.resize(slots);
    for(in MaterialCookEntry entry : entries){
        if(entry.bxdfSource.empty())
            continue;
        if(!ValidateUniqueDeferredBxdfSlot(entry.shadingModelId, sources[entry.shadingModelId], entry.bxdfSource))
            return MakeUnexpected(Failure());
        sources[entry.shadingModelId] = entry.bxdfSource;
    }
    if(!WriteDeferredBxdfDispatchIncludeFile(root, sources))
        return MakeUnexpected(Failure());
    return root;
}

Expected<Path> EmitShadowSurfaceDispatch(in Path cache, in StringView configuration, in Span<MaterialBindEntry> binds, in Span<MaterialCookEntry> entries){
    const Path root = cache / configuration / s_ShadowSurfaceIncludeSubDir;
    if(!PrepareGeneratedIncludeRoot(root, s_ShadowSurfaceDispatchGenerationLabel))
        return MakeUnexpected(Failure());
    usize slots = 0u;
    for(in MaterialCookEntry entry : entries){
        if(!entry.surfaceSource.empty())
            slots = Max(slots, ResolveDispatchSlotTableCapacity(true, entry.surfaceDispatchId));
    }
    Vector<StringView> surfaces;
    Vector<StringView> interfaces;
    surfaces.resize(slots);
    interfaces.resize(slots);
    for(in MaterialCookEntry entry : entries){
        if(entry.surfaceSource.empty())
            continue;
        const u32 id = entry.surfaceDispatchId;
        if(!ValidateUniqueShadowSurfaceDispatchSlot(id, surfaces[id], entry.surfaceSource, interfaces[id], entry.materialInterface))
            return MakeUnexpected(Failure());
        surfaces[id] = entry.surfaceSource;
        interfaces[id] = entry.materialInterface;
    }
    const Expected<MaterialBindInterfaceLookup> bindLookup = BuildMaterialBindInterfaceLookup(binds);
    if(!bindLookup.has_value())
        return MakeUnexpected(Failure());
    Vector<usize> bindById;
    Vector<u32> namespaceById;
    bindById.resize(slots);
    namespaceById.resize(slots);
    HashMap<Name, u32> namespaces;
    namespaces.reserve(binds.size());
    for(usize id = 0u; id < slots; ++id){
        if(surfaces[id].empty())
            continue;
        const Expected<Name> name = ReadMaterialCookName(interfaces[id]);
        if(!name.has_value() || !bindLookup.value().contains(name.value())){
            error("Shadow surface dispatch: model id {} references unknown material interface '{}'", id, interfaces[id]);
            return MakeUnexpected(Failure());
        }
        bindById[id] = bindLookup.value().at(name.value());
        if(namespaces.contains(name.value()))
            namespaceById[id] = namespaces.at(name.value());
        else{
            namespaceById[id] = cast<u32>(id);
            if(!namespaces.emplace(name.value(), cast<u32>(id)).second){
                assert(false);
                return MakeUnexpected(Failure());
            }
        }
    }
    ShadowSurfaceSourceBuilder builder;
    String source(s_ShadowSurfaceDispatchHeader);
    HashSet<String> symbols;
    Vector<String> aliases;
    for(usize id = 0u; id < slots; ++id){
        if(surfaces[id].empty())
            continue;
        const String bindNamespace = builder.buildBindNamespace(namespaceById[id]);
        if(namespaceById[id] == cast<u32>(id))
            builder.appendNamespaceInclude(bindNamespace, interfaces[id], source);
        in MaterialBindEntry bind = binds[bindById[id]];
        if(!builder.appendBindAliases(bind.virtualPath, bind.structs, bind.instances, bindNamespace, aliases, symbols, source))
            return MakeUnexpected(Failure());
        builder.appendInputDefines(source);
        builder.appendHookInclude(cast<u32>(id), surfaces[id], source);
        builder.appendInputUndefines(source);
        builder.appendBindAliasUndefines(aliases, source);
    }
    builder.appendDispatchFunction(surfaces, source);
    if(!WriteShadowSurfaceGeneratedIncludeFile(root / s_ShadowSurfaceModuleSubPath, source))
        return MakeUnexpected(Failure());
    return root;
}


