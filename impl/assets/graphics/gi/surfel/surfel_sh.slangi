////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_GI_SURFEL_SH_SLANGI
#define NWB_GRAPHICS_GI_SURFEL_SH_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../constants.h"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#define NWB_SURFEL_SH_Y00_SCALE 0.2820947918
#define NWB_SURFEL_SH_Y1_SCALE 0.4886025119
#define NWB_SURFEL_SH_L1_COSINE_RECONSTRUCTION_SCALE (2.0 / 3.0)

half4 nwbSurfelShBasis(const half3 dir){
    return half4(
        half(NWB_SURFEL_SH_Y00_SCALE),
        half(NWB_SURFEL_SH_Y1_SCALE) * dir.y,
        half(NWB_SURFEL_SH_Y1_SCALE) * dir.z,
        half(NWB_SURFEL_SH_Y1_SCALE) * dir.x
    );
}

half4 nwbSurfelShReconstructionBasis(const half3 dir){
    const half y1 = half(NWB_SURFEL_SH_Y1_SCALE * NWB_SURFEL_SH_L1_COSINE_RECONSTRUCTION_SCALE);
    return half4(
        half(NWB_SURFEL_SH_Y00_SCALE),
        y1 * dir.y,
        y1 * dir.z,
        y1 * dir.x
    );
}

half3 nwbSurfelShReconstructWithScaledBasis(const half4 shR, const half4 shG, const half4 shB, const half4 scaledBasis){
    return half3(max(dot(shR, scaledBasis), half(0.0h)), max(dot(shG, scaledBasis), half(0.0h)), max(dot(shB, scaledBasis), half(0.0h)));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

