const u64 s_ReflectionCpuTimingPrepPresentations = 64u;
const u32 s_ReflectionCpuTimingMinPositiveIntervals = 11u;
const u64 s_ReflectionMaxU32Value = 4294967295u;
const u32 s_ReflectionDefaultCaptureFrameCount = 16u;

const StringView s_ReflectionSmokeCaseEnv = "NWB_REFLECTION_SMOKE_CASE";
const StringView s_ReflectionCapturePathEnv = "NWB_SMOKE_FRAMEBUFFER_CAPTURE_PATH";
const StringView s_ReflectionOffscreenCase = "offscreen";
const StringView s_ReflectionRoughCase = "rough";
const StringView s_ReflectionOnscreenMovedCase = "onscreen_moved";
const StringView s_ReflectionBoundaryCase = "boundary";
const StringView s_ReflectionFloorCase = "floor";
const StringView s_ReflectionMovedCase = "moved";
const StringView s_ReflectionOpaqueGlassCase = "opaque_glass";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ReflectionCpuTimingProbe{
    public ReflectionCpuTimingProbe(mut ProjectRuntimeContext context){
        this.m_context = context;
        this.m_publications = SmokeCpuGpuTimingProbe(ReflectionCpuTimingOwnerLabel());
    }

    public b8 initialize(in StringView caseName){
        b8 hasQuitCallback = false;
        native(in ctx = this.m_context, mut hasQuitCallback){
            hasQuitCallback = static_cast<b8>(ctx.requestQuit);
        }
        if((caseName != "optical_csg_cap" && caseName != "optical_csg_reference") || !hasQuitCallback){
            error("ReflectionCpuTiming: requires the cap or matched slab fixture and a quit callback");
            return false;
        }
        const Expected<String> outputPath = ReadSmokeEnvironmentString("NWB_REFLECTION_CPU_GPU_TIMING_FILE");
        StringView outputPathView = "";
        if(outputPath.has_value())
            outputPathView = StringView(outputPath.value());
        if(!this.m_publications.initialize(true, true, outputPathView))
            return false;
        [essential] info(
            "ReflectionCpuTiming: configured case={} preparation_presentations=64 warmup_seconds=5 minimum_seconds=30 minimum_presentations=100 minimum_positive_intervals=11 diagnostic_only=1"
            , caseName
        );
        return true;
    }

    public b8 initialize(in StringView caseName, mut ScratchArena scratchArena){
        return this.initialize(caseName);
    }

    public b8 update(){
        if(this.m_complete)
            return true;
        const u64 presentations = this.m_context.graphics.getSuccessfulPresentationCount();
        const u64 sourceFrame = this.m_context.perfSession.frameIndex();
        Timer now = Timer();
        native(mut now){
            now = TimerNow();
        }
        if(!this.m_prepared){
            if(presentations < s_ReflectionCpuTimingPrepPresentations)
                return true;
            this.m_prepared = true;
            this.m_preparationBegin = now;
            [essential] info("ReflectionCpuTiming: preparation complete presentations={} source_frame={}", presentations, sourceFrame);
        }

        const PresentationFpsStatus status = this.m_presentation.observe(presentations, now);
        if(status == PresentationFpsStatus::Invalid){
            error("ReflectionCpuTiming: presentation counter or steady clock regressed");
            return false;
        }
        if(this.m_presentation.measurementStarted() && !this.m_measuring){
            this.m_measuring = true;
            this.m_intervalSourceFrame = sourceFrame;
            f64 warmupSeconds = 0.0;
            native(in now, in prepBegin = this.m_preparationBegin, mut warmupSeconds){
                warmupSeconds = DurationInSeconds<f64>(now, prepBegin);
            }
            [essential] info(
                "ReflectionCpuTiming: measurement begin presentations={} source_frame={} warmup_seconds={}"
                , presentations
                , sourceFrame
                , warmupSeconds
            );
        }

        if(!this.m_publications.observe(this.m_context.perfSession, this.m_presentation, presentations, false))
            return false;
        if(status != PresentationFpsStatus::Interval)
            return true;

        const PresentationFpsSample interval = this.m_presentation.interval();
        if(interval.presentations() > 0u)
            ++this.m_positiveIntervals;
        [essential] info(
            "ReflectionCpuTiming: interval presentations={} seconds={} first={} last={} first_source={} end_source={}"
            , interval.presentations()
            , interval.wallSeconds
            , interval.firstPresentationCount
            , interval.lastPresentationCount
            , this.m_intervalSourceFrame
            , sourceFrame
        );
        this.m_intervalSourceFrame = sourceFrame;

        const PresentationFpsSample total = this.m_presentation.total();
        if(
            total.wallSeconds < s_SmokeProbeMinimumMeasurementSeconds
            || total.presentations() < s_SmokeProbeMinimumPresentations
            || this.m_positiveIntervals < s_ReflectionCpuTimingMinPositiveIntervals
            || !this.m_publications.hasCompletedGpuSamples(ReflectionFrameGpuTimingScope(), s_SmokeProbeMinimumPresentations)
            || !this.m_publications.hasCompletedGpuSamples(ReflectionHardwareGpuTimingScope(), s_SmokeProbeMinimumPresentations)
        )
            return true;

        if(!this.m_publications.observe(this.m_context.perfSession, this.m_presentation, presentations, true))
            return false;
        this.m_complete = true;
        [essential] info(
            "ReflectionCpuTiming: measurement complete presentations={} seconds={} first={} last={} positive_intervals={} end_source={} diagnostic_only=1"
            , total.presentations()
            , total.wallSeconds
            , total.firstPresentationCount
            , total.lastPresentationCount
            , this.m_positiveIntervals
            , sourceFrame
        );
        this.m_context.requestQuit();
        return true;
    }

    public void finish(){
        if(!this.m_complete)
            error("ReflectionCpuTiming: shutdown before the diagnostic measurement completed");
    }

    private SmokeCpuGpuTimingProbe m_publications;
    private PresentationFpsProbe m_presentation = PresentationFpsProbe(5.0);
    private mut ProjectRuntimeContext m_context;
    private Timer m_preparationBegin = Timer();
    private u64 m_intervalSourceFrame = 0u;
    private u32 m_positiveIntervals = 0u;
    private b8 m_prepared = false;
    private b8 m_measuring = false;
    private b8 m_complete = false;
}

b8 ReadReflectionSmokeFlag(in StringView name, mut b8 value){
    const Expected<String> text = ReadSmokeEnvironmentString(name);
    if(!text.has_value())
        return true;
    const StringView view = StringView(text.value());
    if(view == "0")
        value = false;
    else if(view == "1")
        value = true;
    else{
        error("ReflectionSmokeProjectImpl: {} must be 0 or 1", name);
        return false;
    }
    return true;
}

b8 ReadReflectionSmokeU32(in StringView name, in u32 minimum, in u32 maximum, mut u32 value){
    const Expected<String> text = ReadSmokeEnvironmentString(name);
    if(!text.has_value())
        return true;
    const Expected<u64> parsed = ParseU64(StringView(text.value()));
    if(!parsed.has_value() || parsed.value() < cast<u64>(minimum) || parsed.value() > cast<u64>(maximum)){
        error("ReflectionSmokeProjectImpl: {} must be in [{}, {}]", name, minimum, maximum);
        return false;
    }
    value = cast<u32>(parsed.value());
    return true;
}

class ReflectionSmokeConfiguration{
    public b8 configure(
        mut RendererSystem renderer,
        mut GraphicsRuntime graphics,
        in b8 extendedCase,
        in b8 feedbackCase,
        in b8 opticalCase,
        in b8 furnace,
        in b8 opticalTir
    ){
        this.settingsData.environmentTop = f32x3u(0.0f, 0.0f, 0.0f);
        this.settingsData.environmentBottom = f32x3u(0.0f, 0.0f, 0.0f);
        this.settingsData.maxHardwareRaysPerFrame = 2u * 960u * 720u;
        this.settingsData.diagnosticsEnabled = true;
        this.settingsData.temporalEnabled = extendedCase && !opticalCase && !feedbackCase;
        this.settingsData.spatialFilterEnabled = false;
        native(mut settings = this.settingsData){
            settings.traceMode = Impl::ReflectionTraceMode::Hardware;
        }
        this.m_targetSamples = 16u;
        if(extendedCase && !opticalCase)
            this.m_targetSamples = 64u;

        b8 diagnosticsEnabled = this.settingsData.diagnosticsEnabled;
        b8 screenFeedbackEnabled = this.settingsData.screenFeedbackEnabled;
        b8 temporalEnabled = this.settingsData.temporalEnabled;
        b8 spatialFilterEnabled = this.settingsData.spatialFilterEnabled;
        u32 maxOpticalQueries = this.settingsData.maxOpticalQueries;
        u32 screenMaxSteps = this.settingsData.screenMaxSteps;
        if(
            !ReadReflectionSmokeFlag("NWB_REFLECTION_SMOKE_DIAGNOSTICS", diagnosticsEnabled)
            || !ReadReflectionSmokeFlag("NWB_REFLECTION_SMOKE_FEEDBACK", screenFeedbackEnabled)
            || !ReadReflectionSmokeFlag("NWB_REFLECTION_SMOKE_FEEDBACK_CAPTURE", this.m_feedbackCapture)
            || !ReadReflectionSmokeFlag("NWB_REFLECTION_SMOKE_TEMPORAL", temporalEnabled)
            || !ReadReflectionSmokeFlag("NWB_REFLECTION_SMOKE_SPATIAL", spatialFilterEnabled)
            || !ReadReflectionSmokeFlag("NWB_REFLECTION_SMOKE_FINAL_STATE", this.m_freshFinalState)
            || !ReadReflectionSmokeU32("NWB_REFLECTION_SMOKE_HISTORY_SAMPLES", 1u, 256u, this.m_targetSamples)
            || !ReadReflectionSmokeU32("NWB_REFLECTION_SMOKE_POST_RESET_SAMPLES", 1u, 256u, this.m_postResetSamples)
            || !ReadReflectionSmokeU32("NWB_REFLECTION_SMOKE_SEED", 0u, ~cast<u32>(0u), this.m_requestedSeed)
            || !ReadReflectionSmokeU32("NWB_REFLECTION_SMOKE_OPTICAL_QUERIES", 1u, 16u, maxOpticalQueries)
            || !ReadReflectionSmokeU32("NWB_REFLECTION_SMOKE_SCREEN_STEPS", 1u, 256u, screenMaxSteps)
        )
            return false;

        this.settingsData.diagnosticsEnabled = diagnosticsEnabled;
        this.settingsData.screenFeedbackEnabled = screenFeedbackEnabled;
        this.settingsData.temporalEnabled = temporalEnabled;
        this.settingsData.spatialFilterEnabled = spatialFilterEnabled;
        this.settingsData.maxOpticalQueries = maxOpticalQueries;
        this.settingsData.screenMaxSteps = screenMaxSteps;
        this.settingsData.temporalMaxSamples = this.m_targetSamples;
        if(this.m_freshFinalState)
            this.settingsData.samplingSeed = this.m_requestedSeed + 1u;
        else
            this.settingsData.samplingSeed = this.m_requestedSeed;

        if(extendedCase && !feedbackCase){
            this.m_authoredRoughness = 0.4f;
            const Expected<String> roughnessText = ReadSmokeEnvironmentString("NWB_REFLECTION_SMOKE_ROUGHNESS");
            if(roughnessText.has_value()){
                const Expected<f32> roughness = ParseF32FromChars(StringView(roughnessText.value()));
                if(!roughness.has_value() || !IsFinite(roughness.value()) || roughness.value() < 0.0f || roughness.value() > 1.0f)
                    return false;
                this.m_authoredRoughness = roughness.value();
            }
            PresentationSettings presentation = PresentationSettings();
            presentation.shoulder = 1.0f;
            if(!renderer.setPresentationSettings(presentation))
                return false;
        }

        if(furnace || opticalTir){
            this.settingsData.environmentTop = f32x3u(1.0f, 1.0f, 1.0f);
            this.settingsData.environmentBottom = f32x3u(1.0f, 1.0f, 1.0f);
            this.settingsData.roughnessCutoff = 1.0f;
        }

        const Expected<String> budgetText = ReadSmokeEnvironmentString("NWB_REFLECTION_SMOKE_RAY_BUDGET");
        if(budgetText.has_value()){
            const Expected<u64> parsed = ParseU64(StringView(budgetText.value()));
            if(!parsed.has_value() || parsed.value() > s_ReflectionMaxU32Value){
                error("ReflectionSmokeProjectImpl: ray budget must be a nonnegative u32");
                return false;
            }
            this.settingsData.maxHardwareRaysPerFrame = cast<u32>(parsed.value());
        }

        const Expected<String> routeText = ReadSmokeEnvironmentString("NWB_REFLECTION_SMOKE_MODE");
        StringView route = s_ReflectionSmokeHardwareRoute;
        if(routeText.has_value())
            route = StringView(routeText.value());
        b8 validRoute = true;
        native(in route, mut settings = this.settingsData, mut validRoute){
            if(route == "disabled")
                settings.traceMode = Impl::ReflectionTraceMode::Disabled;
            else if(route == "screen")
                settings.traceMode = Impl::ReflectionTraceMode::ScreenSpace;
            else if(route == "hybrid")
                settings.traceMode = Impl::ReflectionTraceMode::Hybrid;
            else if(route != s_ReflectionSmokeHardwareRoute)
                validRoute = false;
        }
        if(!validRoute){
            error("ReflectionSmokeProjectImpl: unknown reflection mode '{}'", route);
            return false;
        }

        const Expected<String> debugText = ReadSmokeEnvironmentString("NWB_REFLECTION_SMOKE_DEBUG");
        if(debugText.has_value()){
            const StringView debugView = StringView(debugText.value());
            b8 validDebug = true;
            native(in debugView, mut settings = this.settingsData, mut validDebug){
                if(debugView == "source")
                    settings.debugView = Impl::ReflectionDebugView::TraceSource;
                else if(debugView == "confidence")
                    settings.debugView = Impl::ReflectionDebugView::Confidence;
                else if(debugView != "none")
                    validDebug = false;
            }
            if(!validDebug){
                error("ReflectionSmokeProjectImpl: unknown debug view '{}'", debugView);
                return false;
            }
        }

        if(!renderer.setReflectionSettings(this.settingsData))
            return false;

        u32 feedbackVal = 0u;
        if(this.settingsData.screenFeedbackEnabled)
            feedbackVal = 1u;
        [essential] info("ReflectionSmokeProjectImpl: screen feedback {}", feedbackVal);
        [essential] info("ReflectionSmokeProjectImpl: screen steps {}", this.settingsData.screenMaxSteps);
        renderer.setRefractionEnabled(true);
        renderer.setRefractionHardwareTracingEnabled(true);

        b8 hardwareAvailable = false;
        native(in graphics, mut hardwareAvailable){
            hardwareAvailable = graphics.queryFeatureSupport(Core::Feature::RayTracingAccelStruct)
                && graphics.queryFeatureSupport(Core::Feature::RayQuery);
        }
        StringView hwStatus = "unavailable";
        if(hardwareAvailable)
            hwStatus = "available";
        [essential] info("ReflectionSmokeProjectImpl: hardware {}", hwStatus);
        [essential] info("ReflectionSmokeProjectImpl: reflection mode {}", route);
        [essential] info("ReflectionSmokeProjectImpl: hardware ray budget {}", this.settingsData.maxHardwareRaysPerFrame);
        if(opticalCase)
            [essential] info("ReflectionSmokeProjectImpl: optical query limit {}", this.settingsData.maxOpticalQueries);
        return true;
    }

    public ReflectionSettings settings()const{ return this.settingsData; }
    public u32 targetSamples()const{ return this.m_targetSamples; }
    public u32 postResetSamples()const{ return this.m_postResetSamples; }
    public u32 requestedSeed()const{ return this.m_requestedSeed; }
    public f32 authoredRoughness()const{ return this.m_authoredRoughness; }
    public b8 feedbackCapture()const{ return this.m_feedbackCapture; }
    public b8 freshFinalState()const{ return this.m_freshFinalState; }

    public ReflectionSettings settingsData = ReflectionSettings();
    private u32 m_targetSamples = 16u;
    private u32 m_postResetSamples = 1u;
    private u32 m_requestedSeed = 0u;
    private f32 m_authoredRoughness = 0.0f;
    private b8 m_feedbackCapture = false;
    private b8 m_freshFinalState = false;
}

// Observes completed reflection history and timing without owning renderer resources.
class ReflectionSpatialOwnerProbe{
    public ReflectionSpatialOwnerProbe(mut ProjectRuntimeContext context, mut RendererSystem renderer){
        this.m_context = context;
        this.m_renderer = renderer;
        this.m_radii[0u] = 1u;
        this.m_radii[1u] = 3u;
        this.m_radii[2u] = 2u;
        this.m_radii[3u] = 1u;
    }

    public b8 configure(in StringView selection, mut ReflectionSettings settings){
        if(selection == "fresh1")
            this.m_radii[0u] = 1u;
        else if(selection == "fresh2")
            this.m_radii[0u] = 2u;
        else if(selection == "fresh3")
            this.m_radii[0u] = 3u;
        else if(selection == "sequence3")
            this.m_lastPhase = 1u;
        else if(selection == "sequence2")
            this.m_lastPhase = 2u;
        else if(selection == "sequence1")
            this.m_lastPhase = 3u;
        else{
            error("ReflectionSpatialOwner: unknown selection");
            return false;
        }

        b8 isHardwareMode = false;
        native(in settings, mut isHardwareMode){
            isHardwareMode = settings.traceMode == Impl::ReflectionTraceMode::Hardware;
        }
        if(
            !isHardwareMode
            || !settings.diagnosticsEnabled
            || !settings.temporalEnabled
            || settings.temporalMaxSamples != 1u
            || !settings.spatialFilterEnabled
            || settings.screenFeedbackEnabled
        ){
            error("ReflectionSpatialOwner: requires hardware, diagnostics, spatial, temporal cap1 and feedback off");
            return false;
        }
        settings.spatialRadius = this.m_radii[0u];
        settings.samplingSeed = 99u;
        [essential] info(
            "ReflectionSpatialOwner: selection={} initial_radius={} final_radius={} phases={}"
            , selection
            , this.m_radii[0u]
            , this.m_radii[this.m_lastPhase]
            , this.m_lastPhase + 1u
        );
        return true;
    }

    public b8 update(in ReflectionStatistics statistics, in TimingView timing, mut ReflectionSettings settings){
        if(!this.observeTiming(timing))
            return false;
        if(this.m_finalReset || statistics.sequence == 0u || !statistics.hardwareReady || !statistics.historyEligible)
            return true;
        if(!this.m_started){
            if(statistics.frameIndex < 3u)
                return true;
            return this.beginPhase(settings);
        }

        const u32 phaseSeed = 101u + this.m_phase;
        if(
            statistics.samplingSeed != phaseSeed
            || statistics.historyStartGraphicsFrame != this.m_phaseSource
            || statistics.historySampleCount != 1u
            || statistics.sampleIndex < 2u
            || !this.m_phaseWork.valid()
            || statistics.graphicsFrameIndex < this.m_phaseWork.lastSampleFrameIndex
        )
            return true;

        [essential] info(
            "ReflectionSpatialOwnerWarm: index={} sequence={} generation={} graphics_frame={} epoch={} start_graphics_frame={} sample_index={} seed={} work_publish={} work_first={} work_last={} work_samples={}"
            , this.m_phase
            , statistics.sequence
            , statistics.generation
            , statistics.graphicsFrameIndex
            , statistics.historyEpoch
            , statistics.historyStartGraphicsFrame
            , statistics.sampleIndex
            , statistics.samplingSeed
            , this.m_phaseWork.publishFrameIndex
            , this.m_phaseWork.firstSampleFrameIndex
            , this.m_phaseWork.lastSampleFrameIndex
            , this.m_phaseWork.sampleCount
        );
        if(this.m_phase < this.m_lastPhase){
            ++this.m_phase;
            return this.beginPhase(settings);
        }

        settings.samplingSeed = 0u;
        if(!this.m_renderer.setReflectionSettings(settings)){
            error("ReflectionSpatialOwner: final seed reset rejected");
            return false;
        }
        this.m_finalSource = this.m_context.graphics.getFrameIndex();
        this.m_finalReset = true;
        [essential] info("ReflectionSpatialOwnerCapture: radius={} graphics_frame={} seed=0", settings.spatialRadius, this.m_finalSource);
        return true;
    }

    public b8 shouldCapture(in u64 graphicsFrame)const{
        return this.m_finalReset && graphicsFrame == this.m_finalSource;
    }

    public b8 canFinish(in ReflectionStatistics statistics, in u64 capturedSource)const{
        return this.m_finalReset
            && capturedSource == this.m_finalSource
            && this.m_captureWork.valid()
            && statistics.hardwareReady
            && statistics.historyEligible
            && statistics.samplingSeed == 0u
            && statistics.historyStartGraphicsFrame == this.m_finalSource
            && statistics.graphicsFrameIndex >= Max(capturedSource, this.m_captureWork.lastSampleFrameIndex);
    }

    private b8 observeTiming(in TimingView timing){
        const TimingStats work = timing.stats(ReflectionSpatialGpuTimingScope());
        if(!work.valid() || (this.m_hasPublication && work.publishFrameIndex == this.m_lastPublish))
            return true;
        if(
            (this.m_hasPublication && work.publishFrameIndex < this.m_lastPublish)
            || work.firstSampleFrameIndex > work.lastSampleFrameIndex
            || work.sampleCount > work.lastSampleFrameIndex - work.firstSampleFrameIndex + 1u
            || !IsFinite(work.seconds)
            || work.seconds < 0.0
        ){
            error("ReflectionSpatialOwner: invalid completed spatial window");
            return false;
        }
        this.m_hasPublication = true;
        this.m_lastPublish = work.publishFrameIndex;
        [essential] info(
            "ReflectionSpatialOwnerWork: publish={} first={} last={} samples={}"
            , work.publishFrameIndex
            , work.firstSampleFrameIndex
            , work.lastSampleFrameIndex
            , work.sampleCount
        );
        if(this.m_started && !this.m_finalReset && !this.m_phaseWork.valid() && work.firstSampleFrameIndex >= this.m_phaseSource)
            this.m_phaseWork = work;
        // Require one completed spatial timing range per source frame in the window.
        if(
            this.m_finalReset
            && work.firstSampleFrameIndex <= this.m_finalSource
            && work.lastSampleFrameIndex >= this.m_finalSource
            && work.sampleCount == work.lastSampleFrameIndex - work.firstSampleFrameIndex + 1u
        )
            this.m_captureWork = work;
        return true;
    }

    private b8 beginPhase(mut ReflectionSettings settings){
        settings.spatialRadius = this.m_radii[this.m_phase];
        settings.samplingSeed = 101u + this.m_phase;
        if(!this.m_renderer.setReflectionSettings(settings)){
            error("ReflectionSpatialOwner: radius transition rejected");
            return false;
        }
        this.m_phaseSource = this.m_context.graphics.getFrameIndex();
        this.m_phaseWork = TimingStats();
        this.m_started = true;
        [essential] info(
            "ReflectionSpatialOwnerPhase: index={} radius={} seed={} graphics_frame={}"
            , this.m_phase
            , settings.spatialRadius
            , settings.samplingSeed
            , this.m_phaseSource
        );
        return true;
    }

    private TimingStats m_phaseWork = TimingStats();
    private TimingStats m_captureWork = TimingStats();
    private Array<u32, 4u> m_radii;
    private mut ProjectRuntimeContext m_context;
    private mut RendererSystem m_renderer;
    private u64 m_phaseSource = ~cast<u64>(0u);
    private u64 m_finalSource = ~cast<u64>(0u);
    private u64 m_lastPublish = 0u;
    private u32 m_phase = 0u;
    private u32 m_lastPhase = 0u;
    private b8 m_started = false;
    private b8 m_finalReset = false;
    private b8 m_hasPublication = false;
}

class ReflectionStatisticsReporter{
    public b8 poll(mut RendererSystem renderer){
        const Expected<ReflectionStatistics> statisticsResult = renderer.tryGetLatestReflectionStatistics();
        if(!statisticsResult.has_value())
            return false;
        const ReflectionStatistics statistics = statisticsResult.value();
        if(statistics.sequence == this.m_statisticsSequence && statistics.generation == this.m_statisticsGeneration)
            return false;
        this.m_statisticsSequence = statistics.sequence;
        this.m_statisticsGeneration = statistics.generation;
        this.m_latestStatistics = statistics;
        this.m_feedbackObservedBypass = this.m_feedbackObservedBypass || statistics.feedbackBypassedPixels > 0u;

        u32 traceModeVal = 0u;
        u32 tokenQueueVal = 0u;
        u64 tokenValue = 0u;
        u32 physicalQueueIndex = 0u;
        u64 deviceGeneration = 0u;
        u32 historyResetReasonVal = 0u;
        u32 feedbackResetReasonVal = 0u;
        native(
            in statistics,
            mut traceModeVal,
            mut tokenQueueVal,
            mut tokenValue,
            mut physicalQueueIndex,
            mut deviceGeneration,
            mut historyResetReasonVal,
            mut feedbackResetReasonVal
        ){
            traceModeVal = static_cast<u32>(statistics.traceMode);
            tokenQueueVal = static_cast<u32>(statistics.acceptedToken.queue);
            tokenValue = statistics.acceptedToken.value;
            physicalQueueIndex = statistics.acceptedToken.physicalQueueIndex;
            deviceGeneration = statistics.acceptedToken.deviceGeneration;
            historyResetReasonVal = static_cast<u32>(statistics.historyResetReason);
            feedbackResetReasonVal = static_cast<u32>(statistics.feedbackResetReason);
        }

        u32 hwReqVal = 0u;
        if(statistics.hardwareRequested)
            hwReqVal = 1u;
        u32 hwAvailVal = 0u;
        if(statistics.hardwareAvailable)
            hwAvailVal = 1u;
        u32 hwReadyVal = 0u;
        if(statistics.hardwareReady)
            hwReadyVal = 1u;

        [essential] info(
            "ReflectionSmokeStatistics: sequence={} generation={} frame={} mode={} width={} height={} requested_budget={} effective_budget={} queue_capacity={} hardware_requested={} hardware_available={} hardware_ready={} token_queue={} token_value={} physical_queue={} device_generation={} candidates={} hardware_rays={} hardware_hits={} opaque_pixels={} glass_pixels={} fallback_pixels={} screen_attempts={} screen_hits={}"
            , statistics.sequence
            , statistics.generation
            , statistics.frameIndex
            , traceModeVal
            , statistics.width
            , statistics.height
            , statistics.requestedHardwareBudget
            , statistics.effectiveHardwareBudget
            , statistics.queueCapacity
            , hwReqVal
            , hwAvailVal
            , hwReadyVal
            , tokenQueueVal
            , tokenValue
            , physicalQueueIndex
            , deviceGeneration
            , statistics.candidates
            , statistics.hardwareRays
            , statistics.hardwareHits
            , statistics.opaquePixels
            , statistics.glassPixels
            , statistics.fallbackPixels
            , statistics.screenAttempts
            , statistics.screenHits
        );

        u32 histEligibleVal = 0u;
        if(statistics.historyEligible)
            histEligibleVal = 1u;
        u32 histReusedVal = 0u;
        if(statistics.historyReused)
            histReusedVal = 1u;
        u32 histResetVal = 0u;
        if(statistics.historyReset)
            histResetVal = 1u;

        [essential] info(
            "ReflectionSmokeHistory: sequence={} generation={} graphics_frame={} epoch={} start_graphics_frame={} count={} sample_index={} seed={} eligible={} reused={} reset={} reason={}"
            , statistics.sequence
            , statistics.generation
            , statistics.graphicsFrameIndex
            , statistics.historyEpoch
            , statistics.historyStartGraphicsFrame
            , statistics.historySampleCount
            , statistics.sampleIndex
            , statistics.samplingSeed
            , histEligibleVal
            , histReusedVal
            , histResetVal
            , historyResetReasonVal
        );

        u32 optEnabledVal = 0u;
        if(statistics.opticalTransportEnabled)
            optEnabledVal = 1u;
        [essential] info(
            "ReflectionSmokeOptics: sequence={} generation={} max_queries={} query_budget_units={} physical_queries={} bootstrap_events={} transparent_paths={} unsupported_paths={} limited_paths={} ambiguous_paths={} tir_events={} medium_overflow_paths={} transport_enabled={}"
            , statistics.sequence
            , statistics.generation
            , statistics.maxOpticalQueries
            , statistics.queryBudgetUnits
            , statistics.physicalQueries
            , statistics.bootstrapEvents
            , statistics.transparentPaths
            , statistics.unsupportedPaths
            , statistics.limitedPaths
            , statistics.ambiguousPaths
            , statistics.tirEvents
            , statistics.mediumOverflowPaths
            , optEnabledVal
        );

        u32 fbReqVal = 0u;
        if(statistics.feedbackRequested)
            fbReqVal = 1u;
        u32 fbEnabledVal = 0u;
        if(statistics.feedbackEnabled)
            fbEnabledVal = 1u;
        u32 fbReusedVal = 0u;
        if(statistics.feedbackReused)
            fbReusedVal = 1u;
        u32 fbResetVal = 0u;
        if(statistics.feedbackReset)
            fbResetVal = 1u;
        u32 schedValidVal = 0u;
        if(statistics.schedulingCounterValid)
            schedValidVal = 1u;

        [essential] info(
            "ReflectionSmokeFeedback: sequence={} generation={} graphics_frame={} feedback_sequence={} epoch={} start_graphics_frame={} probe_index={} requested={} enabled={} reused={} reset={} reason={} scheduling_valid={} potential_receivers={} screen_returns={} bypassed_pixels={} probe_tiles={} screen_iterations={} screen_limit_misses={}"
            , statistics.sequence
            , statistics.generation
            , statistics.graphicsFrameIndex
            , statistics.feedbackSequence
            , statistics.feedbackEpoch
            , statistics.feedbackStartGraphicsFrame
            , statistics.feedbackProbeIndex
            , fbReqVal
            , fbEnabledVal
            , fbReusedVal
            , fbResetVal
            , feedbackResetReasonVal
            , schedValidVal
            , statistics.potentialReceivers
            , statistics.screenReturns
            , statistics.feedbackBypassedPixels
            , statistics.feedbackProbeTiles
            , statistics.screenIterations
            , statistics.screenLimitMisses
        );
        return true;
    }

    public ReflectionStatistics latest()const{ return this.m_latestStatistics; }
    public b8 feedbackObservedBypass()const{ return this.m_feedbackObservedBypass; }

    private ReflectionStatistics m_latestStatistics = ReflectionStatistics();
    private u64 m_statisticsSequence = 0u;
    private u64 m_statisticsGeneration = 0u;
    private b8 m_feedbackObservedBypass = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ReflectionSmokeProjectImpl : IProjectEntryCallbacks{
    public ReflectionSmokeProjectImpl(mut ProjectRuntimeContext context){
        this.m_context = context;
        this.m_world = CreateReflectionSmokeWorldOrDie(context);
        this.m_timingRenderPass = ReflectionTimingRenderPass(context.graphics);
        this.m_fpsProbe = FpsProbe(ReflectionSmokeProjectName());
        this.m_gpuPassTimingProbe = GpuPassTimingProbe(ReflectionSmokeProjectName());
    }

    public ~ReflectionSmokeProjectImpl(){
        this.destroyWorld();
    }

    public b8 onStartup()override{
        const Expected<String> caseText = ReadSmokeEnvironmentString(s_ReflectionSmokeCaseEnv);
        StringView caseName = s_ReflectionOffscreenCase;
        if(caseText.has_value())
            caseName = StringView(caseText.value());

        this.m_feedbackCase = caseName.starts_with("feedback_");
        this.m_opticalCase = caseName.starts_with("optical_");
        this.m_csgOpticalCase = caseName.starts_with("optical_csg_") && caseName != "optical_csg_reference";
        this.m_extendedCase = this.m_feedbackCase
            || this.m_opticalCase
            || caseName.starts_with(s_ReflectionRoughCase)
            || caseName.starts_with("temporal_");
        this.m_opticalTir = caseName == "optical_tir";
        this.m_furnace = caseName == "rough_furnace";
        this.m_glassRoughnessCase = caseName == "rough_glass";

        b8 configured = false;
        native(
            in ext = this.m_extendedCase,
            in fb = this.m_feedbackCase,
            in opt = this.m_opticalCase,
            in furn = this.m_furnace,
            in tir = this.m_opticalTir,
            mut cfg = this.m_configuration,
            mut world = this.m_world,
            mut ctx = this.m_context,
            mut configured
        ){
            auto& renderer = *MakeNotNull(world->getSystem<Impl::RendererSystem>());
            configured = cfg.configure(renderer, ctx.graphics, ext, fb, opt, furn, tir);
        }
        if(!configured)
            return false;

        b8 cpuDiagnostics = false;
        if(!ReadReflectionSmokeFlag("NWB_REFLECTION_SMOKE_CPU_DIAGNOSTICS", cpuDiagnostics))
            return false;
        const Expected<String> cpuTimingPath = ReadSmokeEnvironmentString("NWB_REFLECTION_CPU_GPU_TIMING_FILE");
        if(cpuTimingPath.has_value() != cpuDiagnostics){
            error("ReflectionCpuTiming: diagnostic request and explicit output path must agree");
            return false;
        }
        if(cpuDiagnostics){
            const ReflectionSettings curSettings = this.m_configuration.settings();
            b8 isHardwareMode = false;
            native(in curSettings, mut isHardwareMode){
                isHardwareMode = curSettings.traceMode == Impl::ReflectionTraceMode::Hardware;
            }
            if(
                curSettings.diagnosticsEnabled
                || curSettings.temporalEnabled
                || curSettings.spatialFilterEnabled
                || curSettings.screenFeedbackEnabled
                || !isHardwareMode
                || ReadSmokeEnvironmentString(s_ReflectionCapturePathEnv).has_value()
            ){
                error("ReflectionCpuTiming: requires raw hardware reflection without capture or path diagnostics");
                return false;
            }
            b8 cpuInitOk = false;
            native(in caseName, mut ctx = this.m_context, mut probe = this.m_cpuTimingProbe, mut cpuInitOk){
                probe = MakeUnique<ReflectionCpuTimingProbe>(ctx);
                cpuInitOk = probe && probe->initialize(caseName);
            }
            if(!cpuInitOk)
                return false;
        }

        const Expected<String> spatialOwnerSelection = ReadSmokeEnvironmentString("NWB_REFLECTION_SMOKE_SPATIAL_OWNER");
        if(spatialOwnerSelection.has_value()){
            if(caseName != s_ReflectionRoughCase || this.m_configuration.authoredRoughness() != 0.4f){
                error("ReflectionSpatialOwner: requires the unchanged roughness0.4 scene");
                return false;
            }
            const StringView selectionView = StringView(spatialOwnerSelection.value());
            b8 spatialOk = false;
            native(
                in selectionView,
                mut ctx = this.m_context,
                mut world = this.m_world,
                mut cfg = this.m_configuration,
                mut probe = this.m_spatialOwnerProbe,
                mut spatialOk
            ){
                auto& renderer = *MakeNotNull(world->getSystem<Impl::RendererSystem>());
                probe = MakeUnique<ReflectionSpatialOwnerProbe>(ctx, renderer);
                spatialOk = probe && probe->configure(selectionView, cfg.settingsData) && renderer.setReflectionSettings(cfg.settingsData);
            }
            if(!spatialOk)
                return false;
        }

        const b8 screenCase = caseName == "onscreen"
            || caseName == s_ReflectionOnscreenMovedCase
            || caseName == s_ReflectionBoundaryCase
            || caseName == s_ReflectionFloorCase;
        if(
            caseName != s_ReflectionOffscreenCase
            && caseName != s_ReflectionMovedCase
            && caseName != s_ReflectionOpaqueGlassCase
            && !screenCase
            && !this.m_extendedCase
        ){
            error("ReflectionSmokeProjectImpl: unknown case '{}'", caseName);
            return false;
        }

        u32 extentWidth = 960u;
        u32 extentHeight = 720u;
        EntityID cameraId = s_InvalidEntityId;
        EntityID lightId = s_InvalidEntityId;
        native(
            in optCase = this.m_opticalCase,
            mut world = this.m_world,
            mut extentWidth,
            mut extentHeight,
            mut cameraId,
            mut lightId
        ){
            cameraId = CreateSmokeCamera(1.4f, 6.0f, 0.0f, *world);
            auto& camera = world->entity(cameraId).getComponent<Impl::Scene::CameraComponent>();
            camera.setVerticalFovRadians(s_ReflectionPi / 3.0f);
            const auto extent = QueryProjectFrameClientSize();
            extentWidth = extent.width;
            extentHeight = extent.height;
            camera.setAspectRatio(static_cast<f32>(extent.width) / static_cast<f32>(extent.height));
            lightId = Impl::Scene::CreateDirectionalLightEntity(*world, 0.6f, 0.4f, 0.0f, Float4(1.0f, 1.0f, 1.0f, 1.0f), 1.0f);
            NWB_FATAL_ASSERT_MSG(cameraId.valid() && lightId.valid(), NWB_TEXT("ReflectionSmokeProject: camera/light creation failed"));
            if(optCase)
                world->entity(lightId).getComponent<Impl::Scene::LightComponent>().enableCaustics = false;
        }
        this.m_csgSliceRayCapacity = Min(this.m_configuration.settings().maxHardwareRaysPerFrame, 2u * extentWidth * extentHeight);

        if(this.m_feedbackCase){
            b8 fbCreated = false;
            const b8 freshFinal = this.m_configuration.freshFinalState();
            native(in caseName, in freshFinal, mut world = this.m_world, mut fbScene = this.m_feedbackScene, mut fbCreated){
                fbScene = MakeUnique<ReflectionFeedbackScene>(*world);
                fbCreated = fbScene && fbScene->create(caseName, freshFinal);
            }
            if(!fbCreated)
                return false;
        }
        else if(caseName == "optical_csg_context_transition"){
            b8 csgProbeCreated = false;
            native(
                in rayCap = this.m_csgSliceRayCapacity,
                mut ctx = this.m_context,
                mut world = this.m_world,
                mut csgProbe = this.m_csgContextProbe,
                mut csgProbeCreated
            ){
                auto& renderer = *MakeNotNull(world->getSystem<Impl::RendererSystem>());
                csgProbe = MakeUnique<ReflectionCsgContextProbe>(rayCap, ctx, *world, renderer);
                csgProbeCreated = csgProbe && csgProbe->create();
            }
            if(!csgProbeCreated)
                return false;
        }
        else if(this.m_opticalCase){
            b8 optCreated = false;
            native(in caseName, mut world = this.m_world, mut optCreated){
                optCreated = CreateReflectionOpticalScene(caseName, *world);
            }
            if(!optCreated)
                return false;
        }
        else if(this.m_extendedCase && !this.m_glassRoughnessCase){
            const f32 authoredRough = this.m_configuration.authoredRoughness();
            const b8 freshFinal = this.m_configuration.freshFinalState();
            b8 roughCreated = false;
            b8 roughMutation = false;
            b8 roughDeforming = false;
            native(
                in cameraId,
                in lightId,
                in authoredRough,
                in caseName,
                in freshFinal,
                mut ctx = this.m_context,
                mut world = this.m_world,
                mut roughScene = this.m_roughnessScene,
                mut roughCreated,
                mut roughMutation,
                mut roughDeforming
            ){
                roughScene = MakeUnique<ReflectionRoughnessScene>(cameraId, lightId, authoredRough, ctx, *world);
                roughCreated = roughScene && roughScene->create(caseName, freshFinal);
                if(roughCreated){
                    roughMutation = roughScene->mutationCase();
                    roughDeforming = roughScene->deforming();
                }
            }
            if(!roughCreated)
                return false;
            if(
                roughMutation
                && !roughDeforming
                && this.m_configuration.settings().temporalEnabled
                && (this.m_configuration.targetSamples() < 32u || this.m_configuration.postResetSamples() > this.m_configuration.targetSamples())
            ){
                error("ReflectionSmokeProject: mutation history cap must cover warm-up and post-reset samples");
                return false;
            }
        }
        else{
            const b8 opaqueGlass = caseName == s_ReflectionOpaqueGlassCase || this.m_glassRoughnessCase;
            const b8 floorCase = caseName == s_ReflectionFloorCase;
            const b8 onscreenMoved = caseName == s_ReflectionOnscreenMovedCase;
            const b8 boundary = caseName == s_ReflectionBoundaryCase;
            const b8 moved = caseName == s_ReflectionMovedCase;
            const f32 authoredRough = this.m_configuration.authoredRoughness();
            native(
                in glassRough = this.m_glassRoughnessCase,
                in authoredRough,
                in opaqueGlass,
                in floorCase,
                in screenCase,
                in onscreenMoved,
                in boundary,
                in moved,
                mut world = this.m_world
            ){
                ReflectionReferenceScene referenceScene(*world, glassRough, authoredRough);
                if(opaqueGlass)
                    referenceScene.createOpaqueGlassScene();
                else if(floorCase)
                    referenceScene.createFloorMirrorScene();
                else if(screenCase)
                    referenceScene.createOnscreenMirrorScene(onscreenMoved, boundary);
                else
                    referenceScene.createMirrorScene(moved);
            }
        }

        if(!this.configureFramebufferCapture())
            return false;

        b8 hasSpatialProbe = false;
        b8 hasCapture = false;
        b8 hasCpuProbe = false;
        native(
            in spatialProbe = this.m_spatialOwnerProbe,
            in capture = this.m_framebufferCapture,
            in cpuProbe = this.m_cpuTimingProbe,
            mut hasSpatialProbe,
            mut hasCapture,
            mut hasCpuProbe
        ){
            hasSpatialProbe = static_cast<b8>(spatialProbe);
            hasCapture = static_cast<b8>(capture);
            hasCpuProbe = static_cast<b8>(cpuProbe);
        }
        if(hasSpatialProbe && !hasCapture){
            error("ReflectionSpatialOwner: application framebuffer capture is required");
            return false;
        }

        if(ReadSmokeEnvironmentFlag("NWB_REFLECTION_SMOKE_TIMING") || hasSpatialProbe || hasCpuProbe){
            b8 queriesPrepared = false;
            native(
                in hasCpuProbe,
                in extentWidth,
                in extentHeight,
                mut ctx = this.m_context,
                mut pass = this.m_timingRenderPass,
                mut queriesPrepared
            ){
                auto captureOptions = Core::Perf::CaptureOptions::GpuTimingOnly();
                captureOptions.cpuTiming = hasCpuProbe;
                ctx.setPerfCapture(captureOptions);
                queriesPrepared = pass.prepareQueries(extentWidth, extentHeight);
                if(queriesPrepared)
                    ctx.graphics.addRenderPassToBack(pass);
            }
            if(!queriesPrepared)
                return false;
            this.m_timingRenderPassRegistered = true;
            [essential] info("ReflectionSmokeProject: timing render unfocused 1");
        }

        [essential] info("ReflectionSmokeProject: case {} created", caseName);
        return true;
    }

    public void onShutdown()override{
        native(mut cpuProbe = this.m_cpuTimingProbe){
            if(cpuProbe)
                cpuProbe->finish();
        }
        this.destroyWorld();
        [essential] info("ReflectionSmokeProject: shutdown");
    }

    public b8 onUpdate(in f32 delta)override{
        b8 hasCpuProbe = false;
        b8 probesOk = true;
        const ReflectionStatistics latestBefore = this.m_statisticsReporter.latest();
        native(
            in latestBefore,
            mut ctx = this.m_context,
            mut cfg = this.m_configuration,
            mut cpuProbe = this.m_cpuTimingProbe,
            mut csgProbe = this.m_csgContextProbe,
            mut capture = this.m_framebufferCapture,
            mut spatialProbe = this.m_spatialOwnerProbe,
            mut hasCpuProbe,
            mut probesOk
        ){
            hasCpuProbe = static_cast<b8>(cpuProbe);
            if(cpuProbe && !cpuProbe->update())
                probesOk = false;
            else if(csgProbe && !csgProbe->sampleSynchronizedFrame(latestBefore))
                probesOk = false;
            else{
                if(capture)
                    capture->update();
                if(spatialProbe && !spatialProbe->update(latestBefore, ctx.gpuTimingView(), cfg.settingsData))
                    probesOk = false;
            }
        }
        if(!probesOk)
            return false;

        this.reportCsgSlicePackets();
        this.updateRoughnessScene();
        this.updateFeedbackScene();
        if(!hasCpuProbe){
            this.m_fpsProbe.recordFrame(delta);
            this.m_gpuPassTimingProbe.recordFrame(delta, this.m_context.gpuTimingView());
        }

        const f32 fixedDelta = RendererBaselineFixedDelta();
        f32 tickDelta = delta;
        if(fixedDelta > 0.0f)
            tickDelta = fixedDelta;
        b8 ticked = false;
        native(in tickDelta, mut world = this.m_world, mut ticked){
            ticked = TickSmokeWorld(tickDelta, *world);
        }
        if(!ticked)
            return false;
        this.reportReflectionStatistics();
        return true;
    }

    public b8 shouldCapture(in u64 graphicsFrame)const{
        b8 hasSpatial = false;
        b8 spatialShould = false;
        b8 fbMutCase = false;
        b8 roughMutCase = false;
        b8 roughDeforming = false;
        native(
            in graphicsFrame,
            in spatialProbe = this.m_spatialOwnerProbe,
            in fbScene = this.m_feedbackScene,
            in roughScene = this.m_roughnessScene,
            mut hasSpatial,
            mut spatialShould,
            mut fbMutCase,
            mut roughMutCase,
            mut roughDeforming
        ){
            if(spatialProbe){
                hasSpatial = true;
                spatialShould = spatialProbe->shouldCapture(graphicsFrame);
            }
            if(fbScene)
                fbMutCase = fbScene->mutationCase();
            if(roughScene){
                roughMutCase = roughScene->mutationCase();
                roughDeforming = roughScene->deforming();
            }
        }

        if(hasSpatial)
            return spatialShould;
        if(fbMutCase)
            return this.m_mutationApplied && graphicsFrame == this.m_mutationGraphicsFrame;
        const ReflectionStatistics latest = this.m_statisticsReporter.latest();
        if(this.m_configuration.feedbackCapture())
            return latest.feedbackSequence >= this.m_configuration.targetSamples();
        if(roughMutCase){
            if(!this.m_mutationApplied)
                return false;
            if(this.m_configuration.postResetSamples() == 1u)
                return graphicsFrame == this.m_mutationGraphicsFrame;
            return latest.historyStartGraphicsFrame == this.m_mutationGraphicsFrame
                && latest.historySampleCount >= this.m_configuration.postResetSamples();
        }
        if(this.m_configuration.settings().temporalEnabled && !roughDeforming)
            return latest.historySampleCount >= this.m_configuration.targetSamples();
        return latest.frameIndex >= Max(this.m_configuration.targetSamples(), 3u);
    }

    private void updateRoughnessScene(){
        const ReflectionStatistics latest = this.m_statisticsReporter.latest();
        if(this.m_mutationApplied || latest.sequence == 0u)
            return;

        b8 activeMutCase = false;
        b8 deforming = false;
        native(in roughScene = this.m_roughnessScene, mut activeMutCase, mut deforming){
            if(roughScene && roughScene->mutationCase()){
                activeMutCase = true;
                deforming = roughScene->deforming();
            }
        }
        if(!activeMutCase)
            return;

        b8 warmed = latest.historySampleCount >= 32u;
        if(deforming || !this.m_configuration.settings().temporalEnabled)
            warmed = latest.frameIndex >= 32u;
        if(!warmed)
            return;

        this.m_mutationGraphicsFrame = this.m_context.graphics.getFrameIndex();
        if(this.m_configuration.freshFinalState()){
            this.m_configuration.settingsData.samplingSeed = this.m_configuration.requestedSeed();
            b8 resetOk = false;
            native(in settings = this.m_configuration.settingsData, mut world = this.m_world, mut resetOk){
                auto& renderer = *MakeNotNull(world->getSystem<Impl::RendererSystem>());
                resetOk = renderer.setReflectionSettings(settings);
            }
            [essential] assert(resetOk, "ReflectionSmokeProject: fresh seed reset failed");
        }
        else{
            b8 mutOk = false;
            native(mut roughScene = this.m_roughnessScene, mut mutOk){
                mutOk = roughScene->applyMutation();
            }
            [essential] assert(mutOk, "ReflectionSmokeProject: scene mutation failed");
        }
        this.m_mutationApplied = true;
        u32 freshVal = 0u;
        if(this.m_configuration.freshFinalState())
            freshVal = 1u;
        [essential] info(
            "ReflectionSmokeMutation: graphics_frame={} fresh_final={} seed={}"
            , this.m_mutationGraphicsFrame
            , freshVal
            , this.m_configuration.requestedSeed()
        );
    }

    private void updateFeedbackScene(){
        if(this.m_mutationApplied)
            return;
        b8 activeMutCase = false;
        native(in fbScene = this.m_feedbackScene, mut activeMutCase){
            activeMutCase = fbScene && fbScene->mutationCase();
        }
        if(!activeMutCase)
            return;

        const ReflectionStatistics latest = this.m_statisticsReporter.latest();
        if(
            latest.feedbackSequence < this.m_configuration.targetSamples()
            || (!this.m_configuration.freshFinalState() && !this.m_statisticsReporter.feedbackObservedBypass())
        )
            return;

        this.m_mutationGraphicsFrame = this.m_context.graphics.getFrameIndex();
        if(this.m_configuration.freshFinalState()){
            this.m_configuration.settingsData.samplingSeed = this.m_configuration.requestedSeed();
            b8 resetOk = false;
            native(in settings = this.m_configuration.settingsData, mut world = this.m_world, mut resetOk){
                auto& renderer = *MakeNotNull(world->getSystem<Impl::RendererSystem>());
                resetOk = renderer.setReflectionSettings(settings);
            }
            [essential] assert(resetOk, "ReflectionSmokeProject: fresh feedback reset failed");
        }
        else{
            b8 mutOk = false;
            native(mut fbScene = this.m_feedbackScene, mut mutOk){
                mutOk = fbScene->applyMutation();
            }
            [essential] assert(mutOk, "ReflectionSmokeProject: feedback mutation failed");
        }
        this.m_mutationApplied = true;
        u32 freshVal = 0u;
        if(this.m_configuration.freshFinalState())
            freshVal = 1u;
        [essential] info("ReflectionSmokeFeedbackMutation: graphics_frame={} fresh_final={}", this.m_mutationGraphicsFrame, freshVal);
    }

    private void reportCsgSlicePackets(){
        if(!this.m_csgOpticalCase || !this.m_configuration.settings().diagnosticsEnabled)
            return;
        b8 hasCsgProbe = false;
        native(in csgProbe = this.m_csgContextProbe, mut hasCsgProbe){
            hasCsgProbe = static_cast<b8>(csgProbe);
        }
        if(hasCsgProbe)
            return;
        const u64 frame = this.m_context.graphics.getFrameIndex();
        if(frame < 3u || frame - 1u == this.m_slicePacketSourceFrame)
            return;
        this.m_slicePacketSourceFrame = frame - 1u;
        native(
            in rayCap = this.m_csgSliceRayCapacity,
            in srcFrame = this.m_slicePacketSourceFrame,
            mut ctx = this.m_context,
            mut world = this.m_world
        ){
            auto& renderer = *MakeNotNull(world->getSystem<Impl::RendererSystem>());
            ReportReflectionSlicePackets(rayCap, srcFrame, true, ctx, renderer);
        }
    }

    private void reportReflectionStatistics(){
        b8 polled = false;
        native(mut reporter = this.m_statisticsReporter, mut world = this.m_world, mut polled){
            auto& renderer = *MakeNotNull(world->getSystem<Impl::RendererSystem>());
            polled = reporter.poll(renderer);
        }
        if(!polled)
            return;
        if(!this.m_extendedCase && !this.m_configuration.feedbackCapture())
            return;

        const ReflectionStatistics statistics = this.m_statisticsReporter.latest();
        native(
            in statistics,
            in spatialProbe = this.m_spatialOwnerProbe,
            mut capture = this.m_framebufferCapture
        ){
            if(
                capture
                && capture->captureReady()
                && statistics.graphicsFrameIndex >= capture->capturedGraphicsFrameIndex()
                && (!spatialProbe || spatialProbe->canFinish(statistics, capture->capturedGraphicsFrameIndex()))
            )
                capture->finish();
        }
    }

    private b8 configureFramebufferCapture(){
        b8 hasCsgProbe = false;
        native(in csgProbe = this.m_csgContextProbe, mut hasCsgProbe){
            hasCsgProbe = static_cast<b8>(csgProbe);
        }
        if(hasCsgProbe)
            return true;

        FramebufferCaptureOptions options = FramebufferCaptureOptions();
        if(this.m_extendedCase || this.m_configuration.feedbackCapture()){
            if(!this.m_configuration.settings().diagnosticsEnabled){
                // Timing-only extended scenes do not request completed-state capture.
                if(ReadSmokeEnvironmentString(s_ReflectionCapturePathEnv).has_value()){
                    error("ReflectionSmokeProject: controlled completed-state capture requires diagnostics");
                    return false;
                }
            }
            native(mut options){
                options.quitWhenReady = false;
                options.predicateContext = this;
                options.shouldCapture = +[](void* const owner, const u64 graphicsFrame)noexcept -> b8{
                    return MakeNotNull(static_cast<ReflectionSmokeProjectImpl*>(owner))->shouldCapture(graphicsFrame);
                };
            }
        }
        SmokeCaptureFactory captureFactory = SmokeCaptureFactory(this.m_context);
        Expected<UniquePtr<FramebufferCapture>> capture = captureFactory.configure(
            ReflectionSmokeProjectName(),
            s_ReflectionDefaultCaptureFrameCount,
            options
        );
        if(!capture.has_value())
            return false;
        native(mut dstCapture = this.m_framebufferCapture, mut capture){
            dstCapture = Move(*capture);
        }
        return true;
    }

    private void destroyWorld(){
        native(mut csgProbe = this.m_csgContextProbe){
            csgProbe.reset();
        }
        if(this.m_timingRenderPassRegistered){
            this.m_context.graphics.removeRenderPass(this.m_timingRenderPass);
            this.m_timingRenderPassRegistered = false;
        }
        b8 skinnedWorld = false;
        native(in world = this.m_world, mut skinnedWorld){
            skinnedWorld = world.owner() && world->getSystem<Impl::MeshSkinningSystem>() != nullptr;
        }
        if(skinnedWorld)
            DestroySmokeSkinnedRenderWorld(this.m_context, this.m_world);
        else
            DestroySmokeRenderWorld(this.m_context, this.m_world);

        native(mut capture = this.m_framebufferCapture, mut spatialProbe = this.m_spatialOwnerProbe){
            if(capture){
                capture->stop();
                capture.reset();
            }
            spatialProbe.reset();
        }
    }

    private mut ProjectRuntimeContext m_context;
    private NotNullUniquePtr<World> m_world;
    private ReflectionTimingRenderPass m_timingRenderPass;
    private UniquePtr<FramebufferCapture> m_framebufferCapture = UniquePtr<FramebufferCapture>();
    private FpsProbe m_fpsProbe;
    private GpuPassTimingProbe m_gpuPassTimingProbe;
    private ReflectionStatisticsReporter m_statisticsReporter = ReflectionStatisticsReporter();
    private ReflectionSmokeConfiguration m_configuration = ReflectionSmokeConfiguration();
    private UniquePtr<ReflectionRoughnessScene> m_roughnessScene = UniquePtr<ReflectionRoughnessScene>();
    private UniquePtr<ReflectionFeedbackScene> m_feedbackScene = UniquePtr<ReflectionFeedbackScene>();
    private UniquePtr<ReflectionSpatialOwnerProbe> m_spatialOwnerProbe = UniquePtr<ReflectionSpatialOwnerProbe>();
    private UniquePtr<ReflectionCsgContextProbe> m_csgContextProbe = UniquePtr<ReflectionCsgContextProbe>();
    private UniquePtr<ReflectionCpuTimingProbe> m_cpuTimingProbe = UniquePtr<ReflectionCpuTimingProbe>();
    private u64 m_slicePacketSourceFrame = ~cast<u64>(0u);
    private u64 m_mutationGraphicsFrame = ~cast<u64>(0u);
    private u32 m_csgSliceRayCapacity = 0u;
    private b8 m_extendedCase = false;
    private b8 m_feedbackCase = false;
    private b8 m_opticalCase = false;
    private b8 m_csgOpticalCase = false;
    private b8 m_opticalTir = false;
    private b8 m_furnace = false;
    private b8 m_glassRoughnessCase = false;
    private b8 m_mutationApplied = false;
    private b8 m_timingRenderPassRegistered = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{
NWB::ProjectFrameClientSize NWB::QueryProjectFrameClientSize(){
    NWB::Core::Alloc::ScratchArena arena(Tests::Smoke::s_SmokeEnvironmentArena);
    const auto extent = Tests::Smoke::ReadSmokeEnvironmentText(arena, "NWB_REFLECTION_SMOKE_EXTENT");
    if(!extent || *extent == "native")
        return { 960, 720 };
    NWB_FATAL_ASSERT_MSG(*extent == "npot", NWB_TEXT("ReflectionSmokeProject: extent must be native or npot"));
    return { 953, 713 };
}

TStringView NWB::QueryProjectWindowTitle()noexcept{
    return NWB_TEXT("NWB Reflection Smoke");
}

UniquePtr<NWB::IProjectEntryCallbacks> NWB::CreateProjectEntryCallbacks(NWB::ProjectRuntimeContext& context){
    return MakeUnique<NWB::Tests::Smoke::ReflectionSmokeProjectImpl>(context);
}
}


