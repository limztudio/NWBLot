////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/csg/format_private.adhd>
#include <impl/ecs_render/csg/types.adhd>
#include <impl/ecs_render/deferred/deferred_system.adhd>
#include <impl/ecs_render/deferred/format_private.adhd>
#include <impl/ecs_render/kernel/renderer_constants_private.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Format s_CsgCapNormalCoreFormat = Format::RGBA16_FLOAT;
const Format s_CsgIntervalDepthCoreFormat = Format::RGBA32_FLOAT;
const Format s_CsgIntervalIdCoreFormat = Format::R32_UINT;
const Format s_CsgReceiverEventDataCoreFormat = Format::RGBA32_UINT;
const Format s_CsgReceiverEventCountCoreFormat = Format::R32_UINT;
const Format s_CsgReceiverSpanDataCoreFormat = Format::RGBA32_UINT;
const Format s_CsgReceiverSpanCountCoreFormat = Format::RG32_UINT;
const Format s_CsgRemovedIntervalDepthCoreFormat = Format::RGBA32_FLOAT;
const Format s_CsgRemovedIntervalCapNormalCoreFormat = Format::RGBA16_FLOAT;
const Format s_CsgRemovedIntervalDataCoreFormat = Format::RGBA32_UINT;
const Format s_CsgRemovedIntervalCountCoreFormat = Format::RG32_UINT;
const usize s_MeshGbufferBaseColorLocation = 0u;
const usize s_MeshGbufferNormalLocation = 1u;
const usize s_MeshGbufferWorldPositionLocation = 2u;
const usize s_MeshGbufferSpecularRoughnessLocation = 3u;
const usize s_MeshGbufferTargetCount = 4u;
const Name s_DeferredAlbedoTargetName = "engine/deferred/gbuffer_albedo";
const Name s_DeferredNormalTargetName = "engine/deferred/gbuffer_normal";
const Name s_DeferredWorldPositionTargetName = "engine/deferred/gbuffer_world_position";
const Name s_DeferredSpecularRoughnessTargetName = "engine/deferred/gbuffer_specular_roughness";
const Name s_DeferredOpaqueColorTargetName = "engine/deferred/opaque_color";
const Name s_DeferredCompositeColorTargetName = "engine/deferred/composite_color";
const Name s_DeferredDepthTargetName = "engine/deferred/depth";

b8 CreateDeferredTargetTexture(
    in u32 width,
    in u32 height,
    in Format format,
    in b8 isUav,
    in b8 useClearValue,
    in Color clearValue,
    in Name textureName,
    in StringView errorMessage,
    mut GraphicsRuntime graphics,
    mut TextureHandle outTexture
){
    TextureDesc desc;
    desc
        .setWidth(width)
        .setHeight(height)
        .setFormat(format)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setName(textureName)
    ;
    if(isUav){
        desc
            .setIsUAV(true)
            .setInitialState(ResourceStates::Common)
            .setKeepInitialState(true)
        ;
    }
    else{
        desc.setIsRenderTarget(true);
    }
    if(useClearValue)
        desc.setClearValue(clearValue);
    const Expected<TextureHandle> result = graphics.createTexture(desc);
    if(!result.has_value()){
        outTexture.reset();
        error(errorMessage);
        return false;
    }
    outTexture = result.value();
    return true;
}


b8 ValidDeferredTargetExtent(in u32 width, in u32 height){
    return width > 0u && height > 0u;
}

b8 AllDeferredTargetFormatsKnown(in b8 gbufferFormatsKnown, in b8 csgPeelFormatsKnown, in b8 csgStorageFormatsKnown){
    return gbufferFormatsKnown && csgPeelFormatsKnown && csgStorageFormatsKnown;
}

void LogUnsupportedDeferredTargetFormats(){
    error("RendererSystem: failed to find supported deferred framebuffer formats");
}

void LogLaggedLightingHistoryHeapMissing(){
    error("RendererSystem: lagged lighting history requires the global descriptor heap");
}

b8 RendererDeferredSystem::setPresentationSettings(in PresentationSettings settings){
    if(!ValidatePresentationSettings(settings))
        return false;
    this.m_deferredState.m_presentationSettings = settings;
    return true;
}

b8 RendererDeferredSystem::createDeferredFrameTargetResources(mut DeferredFrameTargets targets, mut RhiSampler avboitLinearSampler){
    if(!this.createDeferredBindlessFrameResources(targets, avboitLinearSampler))
        return false;
    if(this.createLaggedLightingHistoryResources(targets))
        return true;
    this.resetDeferredBindlessFrameResources(targets);
    return false;
}

void RendererDeferredSystem::resetDeferredFrameTargets(mut DeferredFrameTargets targets){
    this.resetLaggedLightingHistoryResources(targets);
    this.resetDeferredBindlessFrameResources(targets);
    targets.framebuffer.reset();

    targets.albedo.reset();
    targets.normal.reset();
    targets.worldPosition.reset();
    targets.specularRoughness.reset();
    ResetCsgIntervalTargets(targets);
    targets.opaqueColor.reset();
    targets.compositeColor.reset();
    targets.depth.reset();
    targets.shadowVisibility.reset();

    targets = DeferredFrameTargets();
}

void RendererDeferredSystem::resetLaggedLightingHistoryResources(mut DeferredFrameTargets targets){
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    if(heap.isInitialized()){
        heap.free(targets.laggedLightingHistory.slotsBufferDescriptor);
        heap.free(targets.laggedLightingHistory.shadowVisibilityDescriptor);
        heap.free(targets.laggedLightingHistory.causticIrradianceDescriptor);
        heap.free(targets.laggedLightingHistory.surfelIrradianceDescriptor);
    }

    targets.laggedLightingHistory = DeferredLaggedLightingHistoryResources();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<DeferredFrameTargets> RendererDeferredSystem::createDeferredFrameTargets(in u32 width, in u32 height){
    if(!ValidDeferredTargetExtent(width, height))
        return MakeUnexpected(Failure());

    mut Device device = this.m_graphics.getDevice();
    const Format albedoFormat = SelectGBufferAlbedoFormat(device);
    const Format normalFormat = SelectGBufferAlbedoFormat(device);
    const Format worldPositionFormat = SelectGBufferAlbedoFormat(device);
    const Format opaqueColorFormat = SelectDeferredOpaqueColorFormat(device);
    const Format depthFormat = SelectGBufferDepthFormat(device);
    const Format csgCapNormalFormat = SelectCsgFormat(s_CsgCapNormalCoreFormat, s_CsgPeelFormatSupport, device);
    const Format csgIntervalDepthFormat = SelectCsgFormat(s_CsgIntervalDepthCoreFormat, s_CsgPeelFormatSupport, device);
    const Format csgIntervalIdFormat = SelectCsgFormat(s_CsgIntervalIdCoreFormat, s_CsgPeelFormatSupport, device);
    const Format csgReceiverEventDataFormat = SelectCsgFormat(s_CsgReceiverEventDataCoreFormat, s_CsgStorageFormatSupport, device);
    const Format csgReceiverEventCountFormat = SelectCsgFormat(s_CsgReceiverEventCountCoreFormat, s_CsgStorageFormatSupport, device);
    const Format csgReceiverSpanDataFormat = SelectCsgFormat(s_CsgReceiverSpanDataCoreFormat, s_CsgStorageFormatSupport, device);
    const Format csgReceiverSpanCountFormat = SelectCsgFormat(s_CsgReceiverSpanCountCoreFormat, s_CsgStorageFormatSupport, device);
    const Format csgRemovedIntervalDepthFormat = SelectCsgFormat(s_CsgRemovedIntervalDepthCoreFormat, s_CsgStorageFormatSupport, device);
    const Format csgRemovedIntervalCapNormalFormat = SelectCsgFormat(s_CsgRemovedIntervalCapNormalCoreFormat, s_CsgStorageFormatSupport, device);
    const Format csgRemovedIntervalDataFormat = SelectCsgFormat(s_CsgRemovedIntervalDataCoreFormat, s_CsgStorageFormatSupport, device);
    const Format csgRemovedIntervalCountFormat = SelectCsgFormat(s_CsgRemovedIntervalCountCoreFormat, s_CsgStorageFormatSupport, device);
    const b8 gbufferFormatsKnown =
        albedoFormat != Format::UNKNOWN
        && normalFormat != Format::UNKNOWN
        && worldPositionFormat != Format::UNKNOWN
        && opaqueColorFormat != Format::UNKNOWN
        && depthFormat != Format::UNKNOWN
    ;
    const b8 csgPeelFormatsKnown =
        csgCapNormalFormat != Format::UNKNOWN
        && csgIntervalDepthFormat != Format::UNKNOWN
        && csgIntervalIdFormat != Format::UNKNOWN
    ;
    const b8 csgStorageFormatsKnown =
        csgReceiverEventDataFormat != Format::UNKNOWN
        && csgReceiverEventCountFormat != Format::UNKNOWN
        && csgReceiverSpanDataFormat != Format::UNKNOWN
        && csgReceiverSpanCountFormat != Format::UNKNOWN
        && csgRemovedIntervalDepthFormat != Format::UNKNOWN
        && csgRemovedIntervalCapNormalFormat != Format::UNKNOWN
        && csgRemovedIntervalDataFormat != Format::UNKNOWN
        && csgRemovedIntervalCountFormat != Format::UNKNOWN
    ;
    if(!AllDeferredTargetFormatsKnown(gbufferFormatsKnown, csgPeelFormatsKnown, csgStorageFormatsKnown)){
        LogUnsupportedDeferredTargetFormats();
        return MakeUnexpected(Failure());
    }
    if(!this.createDeferredLightingResources())
        return MakeUnexpected(Failure());
    if(!this.createDeferredCompositeResources())
        return MakeUnexpected(Failure());

    this.m_deferredState.m_lightingPipeline.reset();
    this.m_deferredState.m_compositeComputePipeline.reset();
    this.m_deferredState.m_presentPipeline.reset();

    DeferredFrameTargets createdTargets;
    createdTargets.width = width;
    createdTargets.height = height;
    createdTargets.albedoFormat = albedoFormat;
    createdTargets.normalFormat = normalFormat;
    createdTargets.worldPositionFormat = worldPositionFormat;
    createdTargets.specularRoughnessFormat = worldPositionFormat;
    createdTargets.opaqueColorFormat = opaqueColorFormat;
    createdTargets.compositeColorFormat = opaqueColorFormat;
    createdTargets.depthFormat = depthFormat;
    createdTargets.csgCapNormalFormat = csgCapNormalFormat;
    createdTargets.csgIntervalDepthFormat = csgIntervalDepthFormat;
    createdTargets.csgIntervalIdFormat = csgIntervalIdFormat;
    createdTargets.csgReceiverEventDataFormat = csgReceiverEventDataFormat;
    createdTargets.csgReceiverEventCountFormat = csgReceiverEventCountFormat;
    createdTargets.csgReceiverSpanDataFormat = csgReceiverSpanDataFormat;
    createdTargets.csgReceiverSpanCountFormat = csgReceiverSpanCountFormat;
    createdTargets.csgRemovedIntervalDepthFormat = csgRemovedIntervalDepthFormat;
    createdTargets.csgRemovedIntervalCapNormalFormat = csgRemovedIntervalCapNormalFormat;
    createdTargets.csgRemovedIntervalDataFormat = csgRemovedIntervalDataFormat;
    createdTargets.csgRemovedIntervalCountFormat = csgRemovedIntervalCountFormat;
    createdTargets.csgPeelLayerCount = s_CsgPeelLayerCount;
    createdTargets.csgReceiverEventLayerCount = s_CsgReceiverEventLayerCount;
    createdTargets.csgReceiverSpanLayerCount = s_CsgReceiverSpanLayerCount;
    createdTargets.csgRemovedIntervalLayerCount = s_CsgRemovedIntervalLayerCount;

    // AsyncCompute lighting samples every G-buffer attachment after Graphics AVBOIT; keep their sharing concurrent.
    if(!CreateDeferredTargetTexture(createdTargets.width, createdTargets.height, createdTargets.albedoFormat, false, true, s_ClearColor, s_DeferredAlbedoTargetName, "RendererSystem: failed to create deferred albedo target", this.m_graphics, createdTargets.albedo))
        return MakeUnexpected(Failure());
    if(!CreateDeferredTargetTexture(createdTargets.width, createdTargets.height, createdTargets.normalFormat, false, true, s_GBufferNormalClearColor, s_DeferredNormalTargetName, "RendererSystem: failed to create deferred normal target", this.m_graphics, createdTargets.normal))
        return MakeUnexpected(Failure());
    if(!CreateDeferredTargetTexture(createdTargets.width, createdTargets.height, createdTargets.worldPositionFormat, false, true, s_GBufferWorldPositionClearColor, s_DeferredWorldPositionTargetName, "RendererSystem: failed to create deferred world-position target", this.m_graphics, createdTargets.worldPosition))
        return MakeUnexpected(Failure());
    if(!CreateDeferredTargetTexture(createdTargets.width, createdTargets.height, createdTargets.specularRoughnessFormat, false, true, s_GBufferSpecularRoughnessClearColor, s_DeferredSpecularRoughnessTargetName, "RendererSystem: failed to create deferred specular/roughness target", this.m_graphics, createdTargets.specularRoughness))
        return MakeUnexpected(Failure());
    if(!CreateDeferredTargetTexture(createdTargets.width, createdTargets.height, createdTargets.opaqueColorFormat, true, true, s_ClearColor, s_DeferredOpaqueColorTargetName, "RendererSystem: failed to create deferred opaque color target", this.m_graphics, createdTargets.opaqueColor))
        return MakeUnexpected(Failure());
    if(!CreateDeferredTargetTexture(createdTargets.width, createdTargets.height, createdTargets.compositeColorFormat, true, true, s_ClearColor, s_DeferredCompositeColorTargetName, "RendererSystem: failed to create deferred composite color target", this.m_graphics, createdTargets.compositeColor))
        return MakeUnexpected(Failure());
    if(!CreateDeferredTargetTexture(createdTargets.width, createdTargets.height, createdTargets.depthFormat, false, false, s_ClearColor, s_DeferredDepthTargetName, "RendererSystem: failed to create deferred depth target", this.m_graphics, createdTargets.depth))
        return MakeUnexpected(Failure());

    Array<FramebufferAttachment, s_MeshGbufferTargetCount> gbufferAttachments;
    gbufferAttachments[s_MeshGbufferBaseColorLocation].setTexture(createdTargets.albedo.deref()).setSubresources(s_FramebufferSubresources);
    gbufferAttachments[s_MeshGbufferNormalLocation].setTexture(createdTargets.normal.deref()).setSubresources(s_FramebufferSubresources);
    gbufferAttachments[s_MeshGbufferWorldPositionLocation].setTexture(createdTargets.worldPosition.deref()).setSubresources(s_FramebufferSubresources);
    gbufferAttachments[s_MeshGbufferSpecularRoughnessLocation].setTexture(createdTargets.specularRoughness.deref()).setSubresources(s_FramebufferSubresources);
    FramebufferDesc framebufferDesc;
    for(in FramebufferAttachment attachment : gbufferAttachments)
        framebufferDesc.addColorAttachment(attachment);
    framebufferDesc.setDepthAttachment(createdTargets.depth.deref(), s_FramebufferSubresources);
    const Expected<FramebufferHandle> framebufferResult = device.createFramebuffer(framebufferDesc);
    if(!framebufferResult.has_value()){
        createdTargets.framebuffer.reset();
        error("RendererSystem: failed to create deferred framebuffer");
        return MakeUnexpected(Failure());
    }
    createdTargets.framebuffer = framebufferResult.value();

    return createdTargets;
}


