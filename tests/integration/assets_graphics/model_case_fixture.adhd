const StringView s_ModelMetaMeshObjectField = "mesh_0";
const StringView s_SharedModelPath = "tests/model_cook_metadata/shared";
const StringView s_UnknownModelPath = "tests/model_cook_metadata/unknown";
const StringView s_StaticMeshesField = "static_meshes";
const StringView s_PropObjectField = "prop";
const StringView s_ModelMetaMeshField = "mesh";
const StringView s_ModelMetaSkeletonField = "skeleton";
const StringView s_ModelMetaSkinnedMeshesField = "skinned_meshes";
const StringView s_ModelMetaMeshVirtualPath = "tests/model_cook_metadata/mesh";
const StringView s_ModelMetaRigA = "rig_a";
const StringView s_ModelMetaRigB = "rig_b";
const StringView s_ModelPayloadProp = "prop";
const StringView s_ModelPayloadReplacementRig = "replacement_rig";
const StringView s_TestsModelPayloadMesh = "tests/model_payload/mesh";
const StringView s_SkeletonJointLeft = "left";
const StringView s_SkeletonJointRoot = "root";
const StringView s_SkeletonJointRight = "right";


[cpp_header("<tests/integration/assets_graphics/cook_tool_sdk.h>"), cpp_name("::NWB::Tests::GraphicsCookToolSdk::Bytes")]
extern GraphicsOwnedBytes NewGraphicsBytes(mut HeapStorage storage);
