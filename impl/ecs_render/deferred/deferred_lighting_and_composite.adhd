const usize s_DeferredSceneMaxLights = 64u;
const u32 s_DeferredLightingGroupSize = 8u;
const u32 s_DeferredCompositeGroupSize = 8u;
const Name s_DeferredLightingShaderDebugName = "ECSRender_DeferredLightingCS";
const Name s_DeferredCompositeShaderDebugName = "ECSRender_DeferredCompositeCS";
const Name s_DeferredPresentShaderDebugName = "ECSRender_DeferredPresentPS";

b8 EnsureDeferredBuffer(
    in BufferDesc desc,
    in StringView errorMessage,
    mut GraphicsRuntime graphics,
    mut BufferHandle outBuffer
){
    if(outBuffer.valid())
        return true;

    const Expected<BufferHandle> result = graphics.createBuffer(desc);
    if(!result.has_value()){
        outBuffer.reset();
        error(errorMessage);
        return false;
    }
    outBuffer = result.value();
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u32 ComputeDeferredDispatchGroupCount(in u32 extent, in u32 groupSize){
    return DivideUpWrapping(extent, groupSize);
}

u64 ComputeSceneLightBufferByteSize(in usize recordByteSize, in usize maxLights){
    return cast<u64>(recordByteSize * maxLights);
}

b8 CanRenderDeferredLightingWithHistory(in b8 useLaggedLightingHistory, in b8 laggedHistoryValid){
    return !useLaggedLightingHistory || laggedHistoryValid;
}

u32 SelectDeferredPresentOutputLayerSlot(in b8 valid, in u32 slot, in u32 invalidSlot){
    if(valid)
        return slot;
    return invalidSlot;
}

void RendererDeferredSystem::confirmSceneShadingBufferUploads(
    in Span<SceneLightGpuData> lights,
    in b8 lightUploadRequired,
    in SceneShadingGpuData sceneShadingState,
    in b8 sceneShadingUploadRequired
){
    SceneShadingUploadTracker().confirm(
        lights,
        lightUploadRequired,
        sceneShadingState,
        sceneShadingUploadRequired,
        this.m_deferredState.m_lightGpuData,
        this.m_deferredState.m_lightGpuDataCount,
        this.m_deferredState.m_lightGpuDataValid,
        this.m_deferredState.m_sceneShadingGpuData,
        this.m_deferredState.m_sceneShadingGpuDataValid
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RendererDeferredSystem::createDeferredLightingResources(){
    mut Device device = this.m_graphics.getDevice();
    if(!device.getDescriptorHeap().isInitialized()){
        error("RendererSystem: deferred lighting requires the global descriptor heap");
        return false;
    }

    BufferDesc sceneShadingBufferDesc;
    sceneShadingBufferDesc
        .setByteSize(sizeof(SceneShadingGpuData))
        .setIsConstantBuffer(true)
        .setDebugName(s_SceneShadingBufferName)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;
    if(!EnsureDeferredBuffer(sceneShadingBufferDesc, "RendererSystem: failed to create scene shading buffer", this.m_graphics, this.m_deferredState.m_sceneShadingBuffer))
        return false;

    BufferDesc lightBufferDesc;
    lightBufferDesc
        .setByteSize(ComputeSceneLightBufferByteSize(sizeof(SceneLightGpuData), s_DeferredSceneMaxLights))
        .setStructStride(sizeof(SceneLightGpuData))
        .setDebugName(s_SceneLightBufferName)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;
    if(!EnsureDeferredBuffer(lightBufferDesc, "RendererSystem: failed to create scene light buffer", this.m_graphics, this.m_deferredState.m_lightBuffer))
        return false;

    if(!EnsurePushConstantBindingLayout(device, sizeof(DeferredLightingPushConstants), ShaderTypeMask::Compute, this.m_deferredState.m_lightingBindingLayout)){
        error("RendererSystem: failed to create deferred lighting binding layout");
        return false;
    }

    if(!CreateClampSampler(false, device, this.m_deferredState.m_sampler)){
        error("RendererSystem: failed to create deferred lighting sampler");
        return false;
    }

    if(!this.m_shaderSystem.loadShader<ComputeShader, DeferredSubsystem>(lambda[](in DeferredSubsystem s) -> AssetRef<ComputeShader>{ return s.lightingCs; }, s_ShaderArchiveDefaultVariant, s_DeferredLightingShaderDebugName, this.m_deferredState.m_lightingComputeShader))
        return false;

    return true;
}

b8 RendererDeferredSystem::createDeferredLightingPipeline(){
    if(!this.createDeferredLightingResources())
        return false;

    if(this.m_deferredState.m_lightingPipeline.valid())
        return true;

    if(!CreateHeapComputePipeline(this.m_graphics.getDevice(), this.m_deferredState.m_lightingComputeShader, this.m_deferredState.m_lightingBindingLayout, false, this.m_deferredState.m_lightingPipeline)){
        error("RendererSystem: failed to create deferred lighting pipeline");
        return false;
    }

    return true;
}

b8 RendererDeferredSystem::renderDeferredLighting(mut CommandList commandList, mut DeferredFrameTargets targets, in b8 useLaggedLightingHistory){
    assert(this.m_deferredState.m_lightingPipeline.valid());

    if(!CanRenderDeferredLightingWithHistory(useLaggedLightingHistory, targets.laggedLightingHistory.valid()))
        return false;

    GpuDescriptorHandle resourceSlots = targets.bindless.slotsBufferDescriptor;
    if(useLaggedLightingHistory)
        resourceSlots = targets.laggedLightingHistory.slotsBufferDescriptor;

    GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeDeferredLighting, this.m_graphics.getDevice(), commandList);

    ComputeState computeState;
    computeState.setPipeline(this.m_deferredState.m_lightingPipeline.deref());
    commandList.setComputeState(computeState);
    this.m_graphics.getDevice().getDescriptorHeap().bindCompute(commandList, this.m_deferredState.m_lightingPipeline.deref());
    const DeferredLightingPushConstants pushConstants = ResolveDeferredLightingPushConstants(resourceSlots.slot(), this.m_graphics.isHDR10OutputActive());
    commandList.setPushConstants(pushConstants);

    const u32 groupCountX = ComputeDeferredDispatchGroupCount(targets.width, s_DeferredLightingGroupSize);
    const u32 groupCountY = ComputeDeferredDispatchGroupCount(targets.height, s_DeferredLightingGroupSize);
    commandList.dispatch(groupCountX, groupCountY, 1u);
    return true;
}

b8 RendererDeferredSystem::createDeferredCompositeResources(){
    mut Device device = this.m_graphics.getDevice();
    if(!device.getDescriptorHeap().isInitialized()){
        error("RendererSystem: deferred compositing requires the global descriptor heap");
        return false;
    }

    if(!EnsurePushConstantBindingLayout(device, sizeof(DeferredCompositePushConstants), ShaderTypeMask::Compute, this.m_deferredState.m_compositeComputeBindingLayout)){
        error("RendererSystem: failed to create deferred composite-compute binding layout");
        return false;
    }

    if(!EnsurePushConstantBindingLayout(device, sizeof(DeferredPresentPushConstants), ShaderTypeMask::Pixel, this.m_deferredState.m_presentBindingLayout)){
        error("RendererSystem: failed to create deferred presentation binding layout");
        return false;
    }

    if(!CreateClampSampler(false, device, this.m_deferredState.m_sampler)){
        error("RendererSystem: failed to create deferred composite sampler");
        return false;
    }

    if(!this.m_shaderSystem.loadShader<ComputeShader, DeferredSubsystem>(lambda[](in DeferredSubsystem s) -> AssetRef<ComputeShader>{ return s.compositeCs; }, s_ShaderArchiveDefaultVariant, s_DeferredCompositeShaderDebugName, this.m_deferredState.m_compositeComputeShader))
        return false;

    if(!this.m_shaderSystem.loadDeferredCompositeVertexShader())
        return false;

    if(!this.m_shaderSystem.loadShader<PixelShader, DeferredSubsystem>(lambda[](in DeferredSubsystem s) -> AssetRef<PixelShader>{ return s.compositePs; }, s_ShaderArchiveDefaultVariant, s_DeferredPresentShaderDebugName, this.m_deferredState.m_presentPixelShader))
        return false;

    return true;
}

b8 RendererDeferredSystem::createDeferredCompositePipeline(){
    if(!this.createDeferredCompositeResources())
        return false;

    if(this.m_deferredState.m_compositeComputePipeline.valid())
        return true;

    if(!CreateHeapComputePipeline(this.m_graphics.getDevice(), this.m_deferredState.m_compositeComputeShader, this.m_deferredState.m_compositeComputeBindingLayout, false, this.m_deferredState.m_compositeComputePipeline)){
        error("RendererSystem: failed to create deferred composite-compute pipeline");
        return false;
    }

    return true;
}

b8 RendererDeferredSystem::createDeferredPresentPipeline(mut Framebuffer presentationFramebuffer){
    if(!this.createDeferredCompositeResources())
        return false;

    const FramebufferInfo framebufferInfo = FramebufferInfo(presentationFramebuffer.getFramebufferInfo());
    if(this.m_deferredState.m_presentPipeline.valid() && this.m_deferredState.m_presentPipeline.deref().getFramebufferInfo() == framebufferInfo)
        return true;

    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    GraphicsPipelineDesc pipelineDesc;
    pipelineDesc
        .setVertexShader(this.m_shaderSystem.deferredCompositeVertexShader())
        .setPixelShader(this.m_deferredState.m_presentPixelShader)
        .setRenderState(BuildCompositeRenderState())
        .addBindingLayout(this.m_deferredState.m_presentBindingLayout)
        .addBindingLayout(heap.getResourceLayout())
        .addBindingLayout(heap.getSamplerLayout())
    ;

    const Expected<GraphicsPipelineHandle> presentPipelineResult = device.createGraphicsPipeline(pipelineDesc, framebufferInfo);
    if(!presentPipelineResult.has_value()){
        this.m_deferredState.m_presentPipeline.reset();
        error("RendererSystem: failed to create deferred presentation pipeline");
        return false;
    }
    this.m_deferredState.m_presentPipeline = presentPipelineResult.value();

    return true;
}

b8 RendererDeferredSystem::renderDeferredComposite(mut CommandList commandList, mut DeferredFrameTargets targets, in ReflectionCompositeInputs reflectionInputs){
    assert(this.m_deferredState.m_compositeComputePipeline.valid());

    GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeDeferredComposite, this.m_graphics.getDevice(), commandList);

    ComputeState computeState;
    computeState.setPipeline(this.m_deferredState.m_compositeComputePipeline.deref());
    commandList.setComputeState(computeState);
    this.m_graphics.getDevice().getDescriptorHeap().bindCompute(commandList, this.m_deferredState.m_compositeComputePipeline.deref());
    const DeferredCompositePushConstants pushConstants = ResolveDeferredCompositePushConstants(
        targets.bindless.slotsBufferDescriptor.slot(),
        targets.avboit.refractionFramebuffer.valid(),
        reflectionInputs
    );
    commandList.setPushConstants(pushConstants);
    const u32 groupCountX = ComputeDeferredDispatchGroupCount(targets.width, s_DeferredCompositeGroupSize);
    const u32 groupCountY = ComputeDeferredDispatchGroupCount(targets.height, s_DeferredCompositeGroupSize);
    commandList.dispatch(groupCountX, groupCountY, 1u);
    return true;
}

b8 RendererDeferredSystem::renderDeferredPresent(mut CommandList commandList, mut DeferredFrameTargets targets, in AcquiredPresentationFrame presentationFrame, in GpuDescriptorHandle outputLayerImage){
    assert(presentationFrame.valid());
    assert(this.m_deferredState.m_presentPipeline.valid());
    mut Framebuffer presentationFramebuffer = presentationFrame.framebuffer.deref();
    assert(
        presentationFramebuffer.getDescription().colorAttachments.size() == 1u
        && this.m_deferredState.m_presentPipeline.deref().getFramebufferInfo() == FramebufferInfo(presentationFramebuffer.getFramebufferInfo())
    );

    GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeDeferredPresent, this.m_graphics.getDevice(), commandList);

    RenderPassParameters renderPassParameters;
    renderPassParameters.colorAttachmentActions[0u].loadAction = RenderPassLoadAction::Discard;
    renderPassParameters.colorAttachmentActions[0u].storeAction = RenderPassStoreAction::Store;
    commandList.beginRenderPass(presentationFramebuffer, renderPassParameters);
    if(!commandList.isRenderPassActive())
        return false;

    ViewportState viewportState;
    viewportState.addViewportAndScissorRect(presentationFramebuffer.getFramebufferInfo().getViewport());

    GraphicsState graphicsState;
    graphicsState.setPipeline(this.m_deferredState.m_presentPipeline.deref());
    graphicsState.setFramebuffer(presentationFramebuffer);
    graphicsState.setViewport(viewportState);

    commandList.setGraphicsState(graphicsState);
    this.m_graphics.getDevice().getDescriptorHeap().bindGraphics(commandList, this.m_deferredState.m_presentPipeline.deref());
    const DeferredPresentPushConstants pushConstants = ResolveDeferredPresentPushConstants(
        targets.bindless.slotsBufferDescriptor.slot(),
        this.m_graphics.isHDR10OutputActive(),
        this.m_deferredState.m_presentationSettings,
        SelectDeferredPresentOutputLayerSlot(outputLayerImage.valid(), outputLayerImage.slot(), s_DeferredInvalidHeapSlot)
    );
    commandList.setPushConstants(pushConstants);

    DrawArguments drawArgs;
    drawArgs.setVertexCount(s_FullscreenTriangleVertexCount);
    commandList.draw(drawArgs);
    commandList.endRenderPass();
    return !commandList.isRenderPassActive();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets/graphics/deferred/binding_slots.h>"), cpp_name("NWB_DEFERRED_LIGHTING_GROUP_SIZE")]
extern const u32 s_ShaderDeferredLightingGroupSize;

[cpp_header("<impl/assets/graphics/deferred/binding_slots.h>"), cpp_name("NWB_DEFERRED_COMPOSITE_GROUP_SIZE")]
extern const u32 s_ShaderDeferredCompositeGroupSize;

static_assert(s_DeferredSceneMaxLights == s_ShaderMaxSceneLights);
static_assert(s_DeferredLightingGroupSize == s_ShaderDeferredLightingGroupSize);
static_assert(s_DeferredCompositeGroupSize == s_ShaderDeferredCompositeGroupSize);
static_assert(size_of<DeferredLightingPushConstants>() == size_of<u32>() * 2u);
static_assert(size_of<DeferredCompositePushConstants>() == size_of<u32>() * 5u);
static_assert(size_of<DeferredPresentPushConstants>() == size_of<u32>() * 6u);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


RayTracingLightingClassification ClassifyDeferredSceneLights(in Span<f32> importance, in u32 refractiveInstanceCount, mut Span<SceneLightGpuData> lights, in u32 lightCount){
    auto activeLights = lights.subspan(0u, lightCount);
    RayTracingLightingClassification classification;
    classification.causticLightCount = ResolveCausticLights(importance, refractiveInstanceCount, activeLights);
    classification.softShadowSlotMask = ResolveSoftShadowSlotMask(activeLights);
    return classification;
}

SceneShadingBufferUploads RendererDeferredSystem::prepareSceneShadingBufferUploads(in f32 fallbackAspectRatio, in RayTracingLightingClassificationInput rayTracingInput, in PreflightedSceneLightsView preflightedLights)const{
    assert(this.m_deferredState.m_sceneShadingBuffer.valid());
    assert(this.m_deferredState.m_lightBuffer.valid());
    SceneShadingBufferUploads uploads;
    Array<f32, s_DeferredSceneMaxLights> causticLightImportance;
    if(preflightedLights.valid && preflightedLights.lights.size() <= uploads.lightData.size() && preflightedLights.causticImportance.size() == preflightedLights.lights.size()){
        uploads.lightCount = cast<u32>(preflightedLights.lights.size());
        for(usize i = 0u; i < preflightedLights.lights.size(); ++i){
            uploads.lightData[i] = preflightedLights.lights[i];
            causticLightImportance[i] = preflightedLights.causticImportance[i];
        }
    }
    else
        uploads.lightCount = ResolveSceneLights(this.m_world, uploads.lightData, causticLightImportance);
    const Span<SceneLightGpuData> lights(uploads.lightData.data(), uploads.lightCount);
    const Span<f32> importance(causticLightImportance.data(), uploads.lightCount);
    uploads.lightingClassification = ClassifyDeferredSceneLights(importance, rayTracingInput.refractiveInstanceCount, uploads.lightData, uploads.lightCount);
    uploads.lightUploadRequired = SceneShadingUploadTracker().lightUploadRequired(this.m_deferredState.m_lightGpuDataValid,
        this.m_deferredState.m_lightGpuDataCount, this.m_deferredState.m_lightGpuData, lights);
    uploads.sceneShadingState = ResolveSceneShadingState(fallbackAspectRatio, uploads.lightCount, this.m_world);
    uploads.sceneShadingUploadRequired = SceneShadingUploadTracker().shadingUploadRequired(this.m_deferredState.m_sceneShadingGpuDataValid,
        this.m_deferredState.m_sceneShadingGpuData, uploads.sceneShadingState);
    return uploads;
}

class DeferredLightingGraphTask{
    private mut RendererDeferredSystem m_system;
    private mut DeferredFrameTargets m_targets;
    private mut GpuTimingSubmissionTicket m_timingTicket;
    private b8 m_useLaggedLightingHistory;

    public DeferredLightingGraphTask(mut RendererDeferredSystem system, mut DeferredFrameTargets targets, mut GpuTimingSubmissionTicket timingTicket, in b8 useLaggedLightingHistory){
        this.m_system = system;
        this.m_targets = targets;
        this.m_timingTicket = timingTicket;
        this.m_useLaggedLightingHistory = useLaggedLightingHistory;
    }
    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }
    [cpp_unwind]
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const{
        GpuTimingTicketRecordingScope recording(this.m_timingTicket);
        return this.m_system.renderDeferredLighting(commands, this.m_targets, this.m_useLaggedLightingHistory);
    }
}

Expected<GpuTaskId> RendererDeferredSystem::declareDeferredLightingTask(
    mut GpuTaskGraph graph,
    in GpuTaskDesc desc,
    in b8 useLaggedLightingHistory,
    mut DeferredFrameTargets targets,
    mut GpuTimingSubmissionTicket timingTicket
){
    return graph.addPayloadTask(desc, DeferredLightingGraphTask(this, targets, timingTicket, useLaggedLightingHistory));
}


class DeferredCompositeGraphTask{
    private mut RendererDeferredSystem m_system;
    private mut DeferredFrameTargets m_targets;
    private mut GpuTimingSubmissionTicket m_timingTicket;
    private ReflectionCompositeInputs m_reflectionInputs;

    public DeferredCompositeGraphTask(mut RendererDeferredSystem system, mut DeferredFrameTargets targets, mut GpuTimingSubmissionTicket timingTicket, in ReflectionCompositeInputs reflectionInputs){
        this.m_system = system;
        this.m_targets = targets;
        this.m_timingTicket = timingTicket;
        this.m_reflectionInputs = reflectionInputs;
    }
    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }
    [cpp_unwind]
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const{
        GpuTimingTicketRecordingScope recording(this.m_timingTicket);
        return this.m_system.renderDeferredComposite(commands, this.m_targets, this.m_reflectionInputs);
    }
}

Expected<GpuTaskId> RendererDeferredSystem::declareDeferredCompositeTask(
    mut GpuTaskGraph graph,
    in GpuTaskDesc desc,
    in ReflectionCompositeInputs reflectionInputs,
    mut DeferredFrameTargets targets,
    mut GpuTimingSubmissionTicket timingTicket
){
    return graph.addPayloadTask(desc, DeferredCompositeGraphTask(this, targets, timingTicket, reflectionInputs));
}


