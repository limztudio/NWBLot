#include <impl/ecs_render/reflection/reflection_postprocess_and_pipelines.adhd>
#include <impl/ecs_render/reflection/reflection_system.adhd>
#include <impl/ecs_render/kernel/descriptor_register_utils.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u64 s_ReflectionRayQueueElementBytes = 4u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u32 ReflectionDepthPyramidTimingQueryCount(in u32 queriesPerRange, in u32 maxDepthMips){
    return queriesPerRange * maxDepthMips;
}

u64 ReflectionRayQueueByteSize(in u32 capacity){
    return cast<u64>(capacity) * s_ReflectionRayQueueElementBytes;
}

u64 ReflectionRayQueueBufferByteSize(in u32 capacity){
    return ReflectionRayQueueByteSize(capacity) * 2u;
}

u64 ReflectionIndirectArgumentsByteSize(in u32 argumentCount, in u32 argumentStrideBytes){
    return cast<u64>(argumentCount) * cast<u64>(argumentStrideBytes);
}

b8 ReflectionRequiresOpticalTransport(in b8 boundsComplete, in u32 transparentCount){
    return !boundsComplete || transparentCount != 0u;
}

b8 IsReflectionCsgHardwareWorkRequested(in b8 prepareCsgHardware, in u32 maxHardwareRaysPerFrame, in b8 hardwareOrHybridTraceMode){
    return prepareCsgHardware && maxHardwareRaysPerFrame > 0u && hardwareOrHybridTraceMode;
}

b8 HasPreparedReflectionQueueCapacity(in b8 hasQueueBuffer, in u32 currentCapacity, in u32 requiredCapacity){
    return hasQueueBuffer && currentCapacity >= requiredCapacity;
}

b8 HasPreparedReflectionIndirectArgsCapacity(in b8 hasIndirectArgsBuffer, in u64 currentByteSize, in u64 requiredByteSize){
    return hasIndirectArgsBuffer && currentByteSize >= requiredByteSize;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
void RendererReflectionSystem::invalidateResources(){
    this.m_preparedCsgDispatch.reset();
    this.m_csgDispatchStates.clear();
    this.m_statistics.resetReadbackBuffers();
    this.releaseTargets();
    this.m_pipelines.invalidate(this.m_resources);
}

[cpp_unwind]
b8 RendererReflectionSystem::prepareResources(in u32 width, in u32 height, in b8 prepareHardware, in b8 prepareCsgHardware, in ReflectionSettings settings){
    const Expected<u32> capacityResult = TryResolveReflectionQueueCapacity(width, height, settings.maxHardwareRaysPerFrame);
    if(!capacityResult.has_value())
        return false;
    const u32 capacity = capacityResult.value();
    const b8 traceHardware = settings.traceMode == ReflectionTraceMode::Hardware || settings.traceMode == ReflectionTraceMode::Hybrid;
    const b8 hardwareWork = IsReflectionCsgHardwareWorkRequested(prepareHardware, settings.maxHardwareRaysPerFrame, traceHardware);
    const b8 csgHardwareWork = IsReflectionCsgHardwareWorkRequested(prepareCsgHardware, settings.maxHardwareRaysPerFrame, traceHardware);
    if((hardwareWork || csgHardwareWork) && !this.prepareCsgDispatchResources())
        return false;
    if(
        this.m_resources.valid() && this.m_resources.parameters.width == width && this.m_resources.parameters.height == height
        && (!prepareHardware || (this.m_resources.hardwarePipeline && this.m_pipelines.plainHardwarePipeline() && this.m_pipelines.unspecifiedHardwarePipeline() && this.m_pipelines.fastHardwarePipeline() && this.m_pipelines.buildOpticalArgsPipeline()))
        && (!csgHardwareWork || (this.m_pipelines.csgBuildArgsPipeline().valid() && this.m_pipelines.csgHardwarePipeline().valid() && this.m_pipelines.csgPlainHardwarePipeline().valid() && this.m_pipelines.csgUnspecifiedHardwarePipeline().valid()))
    )
        return
            this.prepareQueue(capacity) && this.prepareArguments(capacity, csgHardwareWork && this.m_pipelines.csgBuildArgsPipeline().valid())
            && this.m_statistics.prepareResources()
            && this.m_postprocess.prepareResources(width, height, settings)
            && this.m_feedback.prepareResources(width, height, settings, settings.screenFeedbackEnabled)
        ;
    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized() || !this.m_pipelines.prepare(prepareHardware, csgHardwareWork, this.m_resources))
        return false;
    const Array<Name, 3u> scopes(s_TimingScopeReflectionClassify.identity, s_TimingScopeReflectionBuildArgs.identity, s_TimingScopeReflectionHardware.identity);
    for(in Name scope : scopes){
        if(!this.m_graphics.gpuTiming().prepareScopeQueries(scope, device, s_ReflectionGpuTimingQueriesPerRange))
            return false;
    }
    if(!this.m_graphics.gpuTiming().prepareScopeQueries(s_TimingScopeReflectionDepthPyramid.identity, device, ReflectionDepthPyramidTimingQueryCount(s_ReflectionGpuTimingQueriesPerRange, s_ReflectionMaxDepthMips)))
        return false;
    if(this.m_resources.valid() && this.m_resources.parameters.width == width && this.m_resources.parameters.height == height)
        return
            this.prepareQueue(capacity) && this.prepareArguments(capacity, csgHardwareWork && this.m_pipelines.csgBuildArgsPipeline().valid())
            && this.m_statistics.prepareResources()
            && this.m_postprocess.prepareResources(width, height, settings)
            && this.m_feedback.prepareResources(width, height, settings, settings.screenFeedbackEnabled)
        ;
    this.releaseTargets();

    auto createOutput = lambda[mut this, in width, in height](in Name name) -> Expected<TextureHandle>{
        TextureDesc desc;
        desc.setWidth(width).setHeight(height).setFormat(Format::RGBA16_FLOAT).setIsUAV(true).setName(name).setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setInitialState(ResourceStates::Common).setKeepInitialState(true);
        return this.m_graphics.createTexture(desc);
    };
    auto createBuffer = lambda[mut this](in Name name, in u64 byteSize, in b8 uniform, in b8 indirect) -> Expected<BufferHandle>{
        BufferDesc desc;
        desc
            .setByteSize(byteSize)
            .setIsConstantBuffer(uniform)
            .setCanHaveUAVs(!uniform)
            .setCanHaveRawViews(!uniform)
            .setIsDrawIndirectArgs(indirect)
            .setDebugName(name)
            .setQueueSharing(ResourceQueueSharing::GraphicsAsyncComputeAndTransfer)
            .enableAutomaticStateTracking(ResourceStates::Common)
        ;
        return this.m_graphics.createBuffer(desc);
    };
    auto opaqueRadianceResult = createOutput(s_ReflectionOpaqueRadianceName);
    if(opaqueRadianceResult.has_value())
        this.m_resources.opaqueRadiance = opaqueRadianceResult.value();
    else
        this.m_resources.opaqueRadiance.reset();
    auto glassRadianceResult = createOutput(s_ReflectionGlassRadianceName);
    if(glassRadianceResult.has_value())
        this.m_resources.glassRadiance = glassRadianceResult.value();
    else
        this.m_resources.glassRadiance.reset();
    auto queueResult = createBuffer(s_ReflectionRayQueueBufferName, ReflectionRayQueueBufferByteSize(capacity), false, false);
    if(queueResult.has_value())
        this.m_resources.queue = queueResult.value();
    else
        this.m_resources.queue.reset();
    auto countersResult = createBuffer(s_ReflectionCountersBufferName, s_ReflectionCounterBufferBytes, false, false);
    if(countersResult.has_value())
        this.m_resources.counters = countersResult.value();
    else
        this.m_resources.counters.reset();
    const u32 argumentCount = ResolveReflectionIndirectArgumentCount(capacity, csgHardwareWork && this.m_pipelines.csgBuildArgsPipeline().valid());
    auto indirectArgsResult = createBuffer(s_ReflectionIndirectArgsBufferName, ReflectionIndirectArgumentsByteSize(argumentCount, s_ReflectionIndirectArgumentBytes), false, true);
    if(indirectArgsResult.has_value())
        this.m_resources.indirectArgs = indirectArgsResult.value();
    else
        this.m_resources.indirectArgs.reset();
    auto frameParametersResult = createBuffer(s_ReflectionFrameParametersBufferName, sizeof(ReflectionFrameParameters), true, false);
    if(frameParametersResult.has_value())
        this.m_resources.frameParameters = frameParametersResult.value();
    else
        this.m_resources.frameParameters.reset();
    mut ReflectionDepthPyramidSnapshot depthPyramid = this.m_resources.depthPyramid;
    depthPyramid.mipCount = BuildReflectionDepthPyramidMips(width, height, depthPyramid.mips);
    const FormatSupport depthSupport = FormatSupport::Texture | FormatSupport::ShaderUavStore;
    Format depthFormat = Format::RG32_FLOAT;
    if((device.queryFormatSupport(depthFormat) & depthSupport) != depthSupport)
        depthFormat = Format::RGBA32_FLOAT;
    if((device.queryFormatSupport(depthFormat) & depthSupport) != depthSupport){
        this.releaseTargets();
        return false;
    }
    TextureDesc depthDesc;
    depthDesc
        .setWidth(width)
        .setHeight(height)
        .setMipLevels(depthPyramid.mipCount)
        .setFormat(depthFormat)
        .setIsUAV(true)
        .setName(s_ReflectionDepthPyramidName)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setInitialState(ResourceStates::Common)
        .setKeepInitialState(true)
    ;
    auto textureResult = this.m_graphics.createTexture(depthDesc);
    if(textureResult.has_value())
        depthPyramid.texture = textureResult.value();
    else
        depthPyramid.texture.reset();
    if(!opaqueRadianceResult.has_value() || !glassRadianceResult.has_value() || !queueResult.has_value() || !countersResult.has_value() || !indirectArgsResult.has_value() || !frameParametersResult.has_value() || !textureResult.has_value()){
        this.releaseTargets();
        return false;
    }

    auto registerDescriptor = lambda[mut heap](mut GpuDescriptorHandle descriptor, in GpuDescriptorClass descriptorClass, in DescriptorWriteItem item) -> b8{
        return AssignDescriptor(heap, descriptorClass, item, descriptor);
    };
    if(
        !registerDescriptor(this.m_descriptors[ReflectionDescriptorIndex::OpaqueSampled], GpuDescriptorClass::SampledImage, DescriptorWriteItemTextureSrv(0u, this.m_resources.opaqueRadiance.deref()))
        || !registerDescriptor(this.m_descriptors[ReflectionDescriptorIndex::OpaqueStorage], GpuDescriptorClass::StorageImage, DescriptorWriteItemTextureUav(0u, this.m_resources.opaqueRadiance.deref()))
        || !registerDescriptor(this.m_descriptors[ReflectionDescriptorIndex::GlassSampled], GpuDescriptorClass::SampledImage, DescriptorWriteItemTextureSrv(0u, this.m_resources.glassRadiance.deref()))
        || !registerDescriptor(this.m_descriptors[ReflectionDescriptorIndex::GlassStorage], GpuDescriptorClass::StorageImage, DescriptorWriteItemTextureUav(0u, this.m_resources.glassRadiance.deref()))
        || !registerDescriptor(this.m_descriptors[ReflectionDescriptorIndex::Queue], GpuDescriptorClass::StorageBuffer, DescriptorWriteItemRawBufferUav(0u, this.m_resources.queue.deref()))
        || !registerDescriptor(this.m_descriptors[ReflectionDescriptorIndex::Counters], GpuDescriptorClass::StorageBuffer, DescriptorWriteItemRawBufferUav(0u, this.m_resources.counters.deref()))
        || !registerDescriptor(this.m_descriptors[ReflectionDescriptorIndex::Args], GpuDescriptorClass::StorageBuffer, DescriptorWriteItemRawBufferUav(0u, this.m_resources.indirectArgs.deref()))
        || !registerDescriptor(this.m_descriptors[ReflectionDescriptorIndex::Parameters], GpuDescriptorClass::UniformBuffer, DescriptorWriteItemConstantBuffer(0u, this.m_resources.frameParameters.deref()))
    ){
        this.releaseTargets();
        return false;
    }
    if(!registerDescriptor(this.m_depthSampledDescriptor, GpuDescriptorClass::SampledImage, DescriptorWriteItemTextureSrv(0u, depthPyramid.texture.deref()))){
        this.releaseTargets();
        return false;
    }
    depthPyramid.sampledSlot = this.m_depthSampledDescriptor.slot();
    for(u32 mipIndex = 0u; mipIndex < depthPyramid.mipCount; ++mipIndex){
        const TextureSubresourceSet subresources(mipIndex, 1u, 0u, 1u);
        if(
            !registerDescriptor(this.m_depthMipSampledDescriptors[mipIndex], GpuDescriptorClass::SampledImage, DescriptorWriteItemTextureSrv(0u, depthPyramid.texture.deref(), depthFormat, subresources))
            || !registerDescriptor(this.m_depthMipStorageDescriptors[mipIndex], GpuDescriptorClass::StorageImage, DescriptorWriteItemTextureUav(0u, depthPyramid.texture.deref(), depthFormat, subresources))
        ){
            this.releaseTargets();
            return false;
        }
        depthPyramid.mips[mipIndex].sampledSlot = this.m_depthMipSampledDescriptors[mipIndex].slot();
        depthPyramid.mips[mipIndex].storageSlot = this.m_depthMipStorageDescriptors[mipIndex].slot();
    }
    PopulateReflectionPreparedFrameParameters(
        width,
        height,
        capacity,
        this.m_descriptors[ReflectionDescriptorIndex::OpaqueStorage].slot(),
        this.m_descriptors[ReflectionDescriptorIndex::GlassStorage].slot(),
        this.m_descriptors[ReflectionDescriptorIndex::OpaqueSampled].slot(),
        this.m_descriptors[ReflectionDescriptorIndex::GlassSampled].slot(),
        this.m_descriptors[ReflectionDescriptorIndex::Queue].slot(),
        this.m_descriptors[ReflectionDescriptorIndex::Counters].slot(),
        this.m_descriptors[ReflectionDescriptorIndex::Args].slot(),
        depthPyramid.sampledSlot,
        depthPyramid.mipCount,
        this.m_resources.parameters
    );
    this.m_resources.frameParametersSlot = this.m_descriptors[ReflectionDescriptorIndex::Parameters].slot();
    return this.m_statistics.prepareResources() && this.m_postprocess.prepareResources(width, height, settings) && this.m_feedback.prepareResources(width, height, settings, settings.screenFeedbackEnabled);
}

Expected<ReflectionCsgDispatchHandle> RendererReflectionSystem::acquireCsgDispatchState(in ReflectionFrameSnapshot resources){
    if(!resources.hasHardwareWork() || (!resources.scene.csgTraceContextBuffer.valid() && !resources.usesSplitOpticalHardware()))
        return ReflectionCsgDispatchHandle();
    if(!this.m_preparedCsgDispatch.has_value())
        return MakeUnexpected(Failure());
    in ReflectionCsgDispatchHandle owner = this.m_csgDispatchStates[this.m_preparedCsgDispatch.value()];
    if(owner.referenceCount() != 1u)
        return MakeUnexpected(Failure());
    AtomicThreadFence(MemoryOrder::acquire);
    owner.deref().resources = resources;
    return owner;
}

ReflectionFrameSnapshot RendererReflectionSystem::snapshotFrameResources(
    in DeferredFrameTargets targets,
    in MeshViewBufferSnapshot view,
    in RayTracingSceneGraphResources scene,
    in ReflectionSettings settings,
    in u32 frameIndex,
    in ReflectionSceneContentStamp stamp
)const{
    if(
        !this.m_resources.valid() || !view.bindingValid() || !ValidateReflectionSettings(settings)
        || targets.width != this.m_resources.parameters.width || targets.height != this.m_resources.parameters.height
        || !targets.bindless.slotsBufferDescriptor.valid() || !targets.bindless.gbufferSpecularRoughness.valid()
        || !targets.bindless.refractionSpecularRoughness.valid()
        || !targets.bindless.gbufferDepth.valid()
    )
        return ReflectionFrameSnapshot();
    ReflectionFrameSnapshot snapshot = this.m_resources;
    const b8 opticalTransport = ReflectionRequiresOpticalTransport(scene.opticalScene.boundsComplete, scene.opticalScene.transparentCount);
    if(scene.valid()){
        const b8 csg = scene.csgTraceContextBuffer.valid();
        if(!opticalTransport){
            if(csg)
                snapshot.hardwarePipeline = this.m_pipelines.csgPlainHardwarePipeline();
            else
                snapshot.hardwarePipeline = this.m_pipelines.plainHardwarePipeline();
        }
        else if(scene.opticalScene.unspecifiedBoundariesOnly){
            if(csg)
                snapshot.hardwarePipeline = this.m_pipelines.csgUnspecifiedHardwarePipeline();
            else
                snapshot.hardwarePipeline = this.m_pipelines.unspecifiedHardwarePipeline();
        }
        else if(csg)
            snapshot.hardwarePipeline = this.m_pipelines.csgHardwarePipeline();
        else{
            snapshot.fastHardwarePipeline = this.m_pipelines.fastHardwarePipeline();
            snapshot.buildOpticalArgsPipeline = this.m_pipelines.buildOpticalArgsPipeline();
        }
    }
    const ReflectionRadianceBinding base(this.m_resources.opaqueRadiance, this.m_resources.parameters.opaqueRadianceSlot, this.m_resources.parameters.opaqueOutputSlot);
    snapshot.postprocess = this.m_postprocess.snapshot(base, stamp, settings, this.m_graphics.getFrameIndex());
    if(!snapshot.postprocess.control.valid() || !snapshot.postprocess.current.texture.valid())
        return ReflectionFrameSnapshot();
    snapshot.feedback = this.m_feedback.snapshot(stamp, settings, settings.screenFeedbackEnabled, this.m_graphics.getFrameIndex());
    if(!snapshot.feedback.valid())
        return ReflectionFrameSnapshot();
    snapshot.opaqueRadiance = snapshot.postprocess.current.texture;
    mut ReflectionFrameParameters parameters = snapshot.parameters;
    const b8 hardwareRequested = settings.traceMode == ReflectionTraceMode::Hardware || settings.traceMode == ReflectionTraceMode::Hybrid;
    u32 previousFeedbackSlot = 0u;
    u32 currentFeedbackSlot = 0u;
    if(snapshot.feedback.previous.valid())
        previousFeedbackSlot = snapshot.feedback.previous.descriptor.slot();
    if(snapshot.feedback.current.valid())
        currentFeedbackSlot = snapshot.feedback.current.descriptor.slot();
    PopulateReflectionSnapshotFrameParameters(
        settings,
        scene.valid() && snapshot.hardwarePipeline.valid(),
        targets.bindless.gbufferSpecularRoughness.slot(),
        targets.bindless.refractionSpecularRoughness.slot(),
        snapshot.postprocess.history.sampleIndex,
        snapshot.postprocess.current.storageSlot,
        snapshot.postprocess.current.sampledSlot,
        snapshot.postprocess.spatial.sampledSlot,
        snapshot.postprocess.spatialEnabled,
        targets.bindless.slotsBufferDescriptor.slot(),
        view.heapHandle.slot(),
        scene.materialContextSlotsHeapSlot,
        snapshot.feedback.plan.probeIndex,
        previousFeedbackSlot,
        currentFeedbackSlot,
        parameters
    );
    if(parameters.hardwareEnabled != 0u && parameters.maxHardwareRays > 0u){
        if(scene.csgTraceContextBuffer.valid()){
            const u32 argumentCount = ResolveReflectionIndirectArgumentCount(parameters.maxHardwareRays, true);
            if(!this.m_pipelines.csgBuildArgsPipeline().valid() || snapshot.indirectArgs.deref().getCreationDescription().byteSize < ReflectionIndirectArgumentsByteSize(argumentCount, s_ReflectionIndirectArgumentBytes))
                return ReflectionFrameSnapshot();
            snapshot.buildArgsPipeline = this.m_pipelines.csgBuildArgsPipeline();
        }
        else if(snapshot.usesSplitOpticalHardware() && snapshot.indirectArgs.deref().getCreationDescription().byteSize < ReflectionIndirectArgumentsByteSize(2u, s_ReflectionIndirectArgumentBytes))
            return ReflectionFrameSnapshot();
    }
    snapshot.postprocess.deferredResourcesSlot = parameters.deferredResourcesSlot;
    snapshot.postprocess.opaqueSpecularSlot = parameters.opaqueSpecularSlot;
    snapshot.postprocess.viewSlot = parameters.viewSlot;
    snapshot.depthPyramid.sourceDepthSlot = targets.bindless.gbufferDepth.slot();
    if(parameters.hardwareEnabled != 0u)
        snapshot.scene = scene;
    if(settings.diagnosticsEnabled){
        snapshot.statistics = this.m_statistics.snapshot(MakeReflectionStatisticsMetadata(
            settings,
            parameters,
            frameIndex,
            this.m_graphics.getFrameIndex(),
            scene.csgTraceContextBuffer.valid(),
            opticalTransport,
            hardwareRequested,
            scene.valid() && snapshot.hardwarePipeline.valid()
        ));
    }
    return snapshot;
}


[cpp_unwind]
void RendererReflectionSystem::releaseTargets(){
    this.m_postprocess.invalidateResources();
    this.m_feedback.invalidateResources();
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    for(mut GpuDescriptorHandle descriptor : this.m_descriptors)
        RetireDescriptor(heap, descriptor);
    RetireDescriptor(heap, this.m_depthSampledDescriptor);
    for(mut GpuDescriptorHandle descriptor : this.m_depthMipSampledDescriptors)
        RetireDescriptor(heap, descriptor);
    for(mut GpuDescriptorHandle descriptor : this.m_depthMipStorageDescriptors)
        RetireDescriptor(heap, descriptor);
    this.m_resources.opaqueRadiance.reset();
    this.m_resources.glassRadiance.reset();
    this.m_resources.queue.reset();
    this.m_resources.counters.reset();
    this.m_resources.indirectArgs.reset();
    this.m_resources.frameParameters.reset();
    this.m_resources.parameters = ReflectionFrameParameters();
    this.m_resources.frameParametersSlot = 0u;
    this.m_resources.scene = RayTracingSceneGraphResources();
    this.m_resources.statistics = ReflectionStatisticsReadbackSnapshot();
    this.m_resources.postprocess = ReflectionPostprocessSnapshot();
    this.m_resources.feedback = ReflectionFeedbackSnapshot();
    this.m_resources.depthPyramid.texture.reset();
    this.m_resources.depthPyramid.mipCount = 0u;
    this.m_resources.depthPyramid.sampledSlot = 0u;
    this.m_resources.depthPyramid.sourceDepthSlot = 0u;
    for(mut ReflectionDepthPyramidMip mip : this.m_resources.depthPyramid.mips)
        mip = ReflectionDepthPyramidMip();
}

[cpp_unwind]
b8 RendererReflectionSystem::prepareCsgDispatchResources(){
    this.m_preparedCsgDispatch.reset();
    for(usize index = 0u; index < this.m_csgDispatchStates.size(); ++index){
        in ReflectionCsgDispatchHandle owner = this.m_csgDispatchStates[index];
        if(owner.referenceCount() != 1u)
            continue;
        AtomicThreadFence(MemoryOrder::acquire);
        owner.deref().timing.value().discard();
        owner.deref().timing.emplace(this.m_graphics.gpuTiming());
        owner.deref().resources = ReflectionFrameSnapshot();
        this.m_preparedCsgDispatch = index;
        return true;
    }
    const auto created = this.m_versions.make<ReflectionCsgDispatchState>(this.m_graphics.gpuTiming());
    if(!created.has_value())
        return false;
    this.m_csgDispatchStates.push_back(created.value());
    this.m_preparedCsgDispatch = this.m_csgDispatchStates.size() - 1u;
    return true;
}

[cpp_unwind]
b8 RendererReflectionSystem::prepareQueue(in u32 capacity){
    if(HasPreparedReflectionQueueCapacity(this.m_resources.queue.valid(), this.m_resources.parameters.queueCapacity, capacity))
        return true;
    BufferDesc desc;
    desc
        .setByteSize(ReflectionRayQueueBufferByteSize(capacity))
        .setCanHaveUAVs(true)
        .setCanHaveRawViews(true)
        .setDebugName(s_ReflectionRayQueueBufferName)
        .setQueueSharing(ResourceQueueSharing::GraphicsAsyncComputeAndTransfer)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;
    auto queueResult = this.m_graphics.createBuffer(desc);
    if(!queueResult.has_value())
        return false;
    BufferHandle queue = queueResult.value();
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    if(!ReplaceDescriptor(heap, GpuDescriptorClass::StorageBuffer, DescriptorWriteItemRawBufferUav(0u, queue.deref()), this.m_descriptors[ReflectionDescriptorIndex::Queue]))
        return false;
    this.m_resources.queue = queue;
    this.m_resources.parameters.queueCapacity = capacity;
    this.m_resources.parameters.queueSlot = this.m_descriptors[ReflectionDescriptorIndex::Queue].slot();
    return true;
}

[cpp_unwind]
b8 RendererReflectionSystem::prepareArguments(in u32 capacity, in b8 sliced){
    const u32 argumentCount = ResolveReflectionIndirectArgumentCount(capacity, sliced);
    const u64 byteSize = ReflectionIndirectArgumentsByteSize(argumentCount, s_ReflectionIndirectArgumentBytes);
    u64 currentByteSize = 0u;
    if(this.m_resources.indirectArgs.valid())
        currentByteSize = this.m_resources.indirectArgs.deref().getCreationDescription().byteSize;
    if(HasPreparedReflectionIndirectArgsCapacity(this.m_resources.indirectArgs.valid(), currentByteSize, byteSize))
        return true;
    BufferDesc desc;
    desc
        .setByteSize(byteSize)
        .setCanHaveUAVs(true)
        .setCanHaveRawViews(true)
        .setIsDrawIndirectArgs(true)
        .setDebugName(s_ReflectionIndirectArgsBufferName)
        .setQueueSharing(ResourceQueueSharing::GraphicsAsyncComputeAndTransfer)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;
    auto argumentsResult = this.m_graphics.createBuffer(desc);
    if(!argumentsResult.has_value())
        return false;
    BufferHandle arguments = argumentsResult.value();
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    if(!ReplaceDescriptor(heap, GpuDescriptorClass::StorageBuffer, DescriptorWriteItemRawBufferUav(0u, arguments.deref()), this.m_descriptors[ReflectionDescriptorIndex::Args]))
        return false;
    this.m_resources.indirectArgs = arguments;
    this.m_resources.parameters.argsSlot = this.m_descriptors[ReflectionDescriptorIndex::Args].slot();
    return true;
}


