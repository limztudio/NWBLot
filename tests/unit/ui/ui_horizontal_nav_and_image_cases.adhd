void VerifyImageLoaderTests_RealCodecLoadRetainsExactTextureAfterTemporaryAssetAndBinaryAreGone(mut ImageLoaderTests self){
    const Expected<SharedImageSource> imageResult = LoadImageSource(self.m_pool, self.assets(), self.m_identity);
    ASSERT_TRUE(imageResult.has_value());
    const SharedImageSource image = imageResult.value();
    ASSERT_TRUE(image.valid());
    EXPECT_TRUE(self.payloadDisjointFromSource(image));
    self.zeroAndClearBinary();
    UiImageLoaderExpectPayload(image, 3u);
    EXPECT_TRUE(ImageSourceTexture(image).validatePayload());
}

void VerifyImageLoaderTests_EmptyReferenceFailsBeforeReadingTheBinarySource(mut ImageLoaderTests self){
    EXPECT_FALSE(LoadImageSource(self.m_pool, self.assets(), AssetRef<Texture>()).has_value());
    EXPECT_EQ(self.m_source.m_readCount.value(), 0u);
    EXPECT_TRUE(self.sawError("texture asset reference is empty"));
}

void VerifyImageLoaderTests_MissingPathAndFailedBinaryReadReturnNoSource(mut ImageLoaderTests self){
    const AssetRef<Texture> missing = AssetRef<Texture>("tests/ui/image_loader/missing");
    EXPECT_FALSE(LoadImageSource(self.m_pool, self.assets(), missing).has_value());
    EXPECT_EQ(self.m_source.m_readCount.value(), 1u);
    self.m_source.m_available = false;
    EXPECT_FALSE(LoadImageSource(self.m_pool, self.assets(), self.m_identity).has_value());
    EXPECT_EQ(self.m_source.m_readCount.value(), 2u);
    EXPECT_TRUE(self.sawError("failed to read binary"));
}

void VerifyImageLoaderTests_MissingTextureCodecFailsAfterReadingAValidBinary(mut ImageLoaderTests self){
    ASSERT_TRUE(self.unregisterTextureCodec());
    EXPECT_FALSE(LoadImageSource(self.m_pool, self.assets(), self.m_identity).has_value());
    EXPECT_EQ(self.m_source.m_readCount.value(), 1u);
    EXPECT_TRUE(self.sawError("failed to deserialize"));
}

void VerifyImageLoaderTests_RealTextureCodecRejectsWrongMagicTruncationAndTrailingBytes(mut ImageLoaderTests self){
    self.flipFirstBinaryByte();
    EXPECT_FALSE(LoadImageSource(self.m_pool, self.assets(), self.m_identity).has_value());
    self.rebuildBinary(3u);
    self.m_source.m_binary.pop_back();
    EXPECT_FALSE(LoadImageSource(self.m_pool, self.assets(), self.m_identity).has_value());
    self.rebuildBinary(3u);
    self.m_source.m_binary.push_back(0u);
    EXPECT_FALSE(LoadImageSource(self.m_pool, self.assets(), self.m_identity).has_value());
    EXPECT_EQ(self.m_source.m_readCount.value(), 3u);
    EXPECT_TRUE(self.sawError("invalid texture asset format"));
    EXPECT_TRUE(self.sawError("texture payload is truncated"));
    EXPECT_TRUE(self.sawError("trailing bytes detected"));
}

void VerifyImageLoaderTests_CodecReturningARealDifferentAssetTypeIsRejectedByTheTypedManager(mut ImageLoaderTests self){
    ASSERT_TRUE(self.registerMisdirectedCodec(true));
    EXPECT_FALSE(LoadImageSource(self.m_pool, self.assets(), self.m_identity).has_value());
    EXPECT_EQ(self.m_source.m_readCount.value(), 1u);
    EXPECT_TRUE(self.sawError("is not a texture"));
}

void VerifyImageLoaderTests_CodecReturningAValidTextureAtAnotherIdentityIsRejected(mut ImageLoaderTests self){
    ASSERT_TRUE(self.registerMisdirectedCodec(false));
    EXPECT_FALSE(LoadImageSource(self.m_pool, self.assets(), self.m_identity).has_value());
    EXPECT_EQ(self.m_source.m_readCount.value(), 1u);
    EXPECT_TRUE(self.sawError("loaded texture identity does not match"));
}

void VerifyImageLoaderTests_RepeatedLoadsOfIdenticalBytesOwnDistinctFreshVersions(mut ImageLoaderTests self){
    const Expected<SharedImageSource> firstResult = LoadImageSource(self.m_pool, self.assets(), self.m_identity);
    ASSERT_TRUE(firstResult.has_value());
    const SharedImageSource first = firstResult.value();
    const Expected<SharedImageSource> secondResult = LoadImageSource(self.m_pool, self.assets(), self.m_identity);
    ASSERT_TRUE(secondResult.has_value());
    const SharedImageSource second = secondResult.value();
    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(second.valid());
    EXPECT_EQ(ImageSourceIdentity(first), ImageSourceIdentity(second));
    EXPECT_FALSE((first == second));
    EXPECT_NE(ImageSourceGeneration(first), ImageSourceGeneration(second));
    EXPECT_TRUE(UiDistinctLoadedTextureStorage(first, second));
    UiImageLoaderExpectPayload(first, 3u);
    UiImageLoaderExpectPayload(second, 3u);
    EXPECT_EQ(self.m_source.m_readCount.value(), 2u);
}

void VerifyImageLoaderTests_FailedReplacementPreservesRetainedSourceAndLaterSuccessPublishesAFreshVersion(mut ImageLoaderTests self){
    const Expected<SharedImageSource> currentResult = LoadImageSource(self.m_pool, self.assets(), self.m_identity);
    ASSERT_TRUE(currentResult.has_value());
    SharedImageSource current = currentResult.value();
    ASSERT_TRUE(current.valid());
    const SharedImageSource retained = current;
    const u64 oldGeneration = ImageSourceGeneration(retained);

    self.m_source.m_binary.pop_back();
    Expected<SharedImageSource> replacement = LoadImageSource(self.m_pool, self.assets(), self.m_identity);
    EXPECT_FALSE(replacement.has_value());
    if(replacement.has_value())
        current = replacement.value();
    EXPECT_TRUE((current == retained));
    EXPECT_EQ(ImageSourceGeneration(current), oldGeneration);
    UiImageLoaderExpectPayload(current, 3u);

    self.rebuildBinary(67u);
    replacement = LoadImageSource(self.m_pool, self.assets(), self.m_identity);
    ASSERT_TRUE(replacement.has_value());
    current = replacement.value();
    EXPECT_EQ(ImageSourceIdentity(current), ImageSourceIdentity(retained));
    EXPECT_FALSE((current == retained));
    EXPECT_NE(ImageSourceGeneration(current), oldGeneration);
    EXPECT_EQ(ImageSourceGeneration(retained), oldGeneration);
    self.m_source.m_binary.clear();
    UiImageLoaderExpectPayload(current, 67u);
    UiImageLoaderExpectPayload(retained, 3u);
    EXPECT_EQ(self.m_source.m_readCount.value(), 3u);
}

void VerifyUiImageSourceTests_NonPowerOfTwoMipsKeepPaddedBlockAndPayloadBounds(mut UiImageSourceTests self){
    TestValueSlot<Texture> textureSlot;
    mut Texture texture = textureSlot.constructIn(self.m_inputArena, s_UiCaseTestsUiImagePaint);
    ASSERT_TRUE(self.prepareDefault(texture));
    ASSERT_TRUE(texture.validatePayload());
    const Expected<SharedImageSource> sourceResult = MakeImageSource(self.m_pool, texture);
    ASSERT_TRUE(sourceResult.has_value());
    const SharedImageSource source = sourceResult.value();
    ASSERT_TRUE(source.valid());
    const Span<TextureMipLevel> mips = ImageSourceTexture(source).mipLevels();
    ASSERT_EQ(mips.size(), 4u);
    EXPECT_EQ(mips[0u].width, 9u);
    EXPECT_EQ(mips[0u].height, 5u);
    EXPECT_EQ(mips[0u].blockCountX, 3u);
    EXPECT_EQ(mips[0u].blockCountY, 2u);
    EXPECT_EQ(mips[0u].sizeBytes, 96u);
    EXPECT_EQ(mips[1u].width, 4u);
    EXPECT_EQ(mips[1u].height, 2u);
    EXPECT_EQ(mips[1u].offsetBytes, 96u);
    EXPECT_EQ(mips[2u].offsetBytes, 112u);
    EXPECT_EQ(mips[3u].offsetBytes, 128u);
    EXPECT_EQ(ImageSourceTexture(source).payloadBytes().size(), 144u);
}

void VerifyUiImageSourceTests_RetainedSourceOutlivesCallerReplacementTextureAndItsArena(mut UiImageSourceTests self){
    SharedImageSource source = SharedImageSource();
    {
        HeapStorage callerArena = HeapStorage(s_UiCaseTestsUiImageSourceTemporary);
        TestValueSlot<Texture> textureSlot;
        mut Texture texture = textureSlot.constructIn(callerArena, s_UiCaseTestsUiImageTemporary);
        ASSERT_TRUE(self.prepareDefault(texture));
        const Expected<SharedImageSource> sourceReplacement = MakeImageSource(self.m_pool, texture);
        ASSERT_TRUE(sourceReplacement.has_value());
        source = sourceReplacement.value();
        ASSERT_TRUE(source.valid());
        UiImageSourceExpectCopy(texture, source);
        UiImageSourceTextureDescription replacement = UiImageSourceTextureDescription();
        replacement.width = 1u;
        replacement.height = 1u;
        replacement.alphaMode = TextureAlphaMode::Opaque;
        replacement.seed = 91u;
        ASSERT_TRUE(self.prepareCustom(texture, replacement));
        EXPECT_EQ(texture.payloadBytes().size(), 16u);
        EXPECT_EQ(ImageSourceTexture(source).payloadBytes().size(), 144u);
        EXPECT_EQ(ImageSourceTexture(source).width(), 9u);
    }
    const AssetRef<Texture> sourceIdentity = ImageSourceIdentity(source);
    EXPECT_EQ(sourceIdentity.name(), s_UiImageSourceTempExpectedName);
    EXPECT_EQ(ImageSourceTexture(source).height(), 5u);
    EXPECT_EQ(ImageSourceTexture(source).alphaMode(), TextureAlphaMode::EmbeddedLdr);
    ASSERT_EQ(ImageSourceTexture(source).payloadBytes().size(), 144u);
    for(usize index = 0u; index < ImageSourceTexture(source).payloadBytes().size(); ++index)
        EXPECT_EQ(ImageSourceTexture(source).payloadBytes()[index], cast<u8>(37u + index * 17u));
    EXPECT_TRUE(ImageSourceTexture(source).validatePayload());
}

void VerifyUiImageSourceTests_IdenticalLoadsAndSamePathReplacementReceiveFreshGenerations(mut UiImageSourceTests self){
    TestValueSlot<Texture> textureSlot;
    mut Texture texture = textureSlot.constructIn(self.m_inputArena, s_UiCaseTestsUiImageSharedPath);
    ASSERT_TRUE(self.prepareDefault(texture));
    const Expected<SharedImageSource> originalResult = MakeImageSource(self.m_pool, texture);
    ASSERT_TRUE(originalResult.has_value());
    const SharedImageSource original = originalResult.value();
    const Expected<SharedImageSource> identicalResult = MakeImageSource(self.m_pool, texture);
    ASSERT_TRUE(identicalResult.has_value());
    const SharedImageSource identical = identicalResult.value();
    ASSERT_TRUE(original.valid());
    ASSERT_TRUE(identical.valid());
    EXPECT_EQ(ImageSourceIdentity(original), ImageSourceIdentity(identical));
    EXPECT_NE(ImageSourceGeneration(original), ImageSourceGeneration(identical));
    EXPECT_FALSE(UiSameTextureAddress(original, identical));
    UiImageSourceTextureDescription changed = UiImageSourceTextureDescription();
    changed.seed = 149u;
    ASSERT_TRUE(self.prepareCustom(texture, changed));
    const Expected<SharedImageSource> replacementResult = MakeImageSource(self.m_pool, texture);
    ASSERT_TRUE(replacementResult.has_value());
    const SharedImageSource replacement = replacementResult.value();
    ASSERT_TRUE(replacement.valid());
    EXPECT_EQ(ImageSourceIdentity(replacement), ImageSourceIdentity(original));
    EXPECT_NE(ImageSourceGeneration(replacement), ImageSourceGeneration(original));
    EXPECT_NE(ImageSourceGeneration(replacement), ImageSourceGeneration(identical));
    EXPECT_EQ(ImageSourceTexture(replacement).payloadBytes()[0u], 149u);
    EXPECT_EQ(ImageSourceTexture(original).payloadBytes()[0u], 37u);
    EXPECT_EQ(ImageSourceTexture(identical).payloadBytes(), ImageSourceTexture(original).payloadBytes());
}

void VerifyUiImageSourceTests_CopiedSharedHandleRetainsTheSameImmutableVersionAfterOriginalRelease(mut UiImageSourceTests self){
    TestValueSlot<Texture> textureSlot;
    mut Texture texture = textureSlot.constructIn(self.m_inputArena, s_UiCaseTestsUiImageRetained);
    ASSERT_TRUE(self.prepareDefault(texture));
    const Expected<SharedImageSource> originalResult = MakeImageSource(self.m_pool, texture);
    ASSERT_TRUE(originalResult.has_value());
    SharedImageSource original = originalResult.value();
    ASSERT_TRUE(original.valid());
    const u64 generation = ImageSourceGeneration(original);
    const SharedImageSource retained = original;
    EXPECT_TRUE((retained == original));
    original.reset();
    ASSERT_TRUE(retained.valid());
    EXPECT_EQ(ImageSourceGeneration(retained), generation);
    EXPECT_EQ(ImageSourceTexture(retained).payloadBytes()[143u], cast<u8>(37u + 143u * 17u));
    EXPECT_TRUE(ImageSourceTexture(retained).validatePayload());
}

void VerifyUiImageSourceTests_SeparateHdrAlphaOwnsTheCompleteTrailingPayloadStream(mut UiImageSourceTests self){
    UiImageSourceTextureDescription description = UiImageSourceTextureDescription();
    description.format = TexturePayloadFormat::UastcHdr4x4;
    description.alphaMode = TextureAlphaMode::SeparateUastcLdr4x4;
    TestValueSlot<Texture> textureSlot;
    mut Texture texture = textureSlot.constructIn(self.m_inputArena, s_UiCaseTestsUiImageHdr);
    ASSERT_TRUE(self.prepareCustom(texture, description));
    ASSERT_TRUE(texture.validatePayload());
    const Expected<SharedImageSource> sourceResult = MakeImageSource(self.m_pool, texture);
    ASSERT_TRUE(sourceResult.has_value());
    ASSERT_TRUE(sourceResult.value().valid());
    self.expectSeparateHdrAlphaStream(texture, sourceResult.value());
}

void VerifyUiImageSourceTests_RejectsValidCubeAndVolumeAssetsRatherThanFlatteningTheirSlices(mut UiImageSourceTests self){
    Array<TextureDimensionEnum, 2u> dimensions = Array<TextureDimensionEnum, 2u>();
    dimensions[0u] = TexturePayloadDimension::TextureCube;
    dimensions[1u] = TexturePayloadDimension::Texture3D;
    for(in TextureDimensionEnum dimension : dimensions){
        UiImageSourceTextureDescription description = UiImageSourceTextureDescription();
        description.dimension = dimension;
        if(dimension == TexturePayloadDimension::TextureCube)
            description.height = 9u;
        else
            description.height = 5u;
        if(dimension == TexturePayloadDimension::Texture3D)
            description.depth = 4u;
        else
            description.depth = 1u;
        TestValueSlot<Texture> textureSlot;
        mut Texture texture = textureSlot.constructIn(self.m_inputArena, s_UiCaseTestsUiImageSpatial);
        ASSERT_TRUE(self.prepareCustom(texture, description));
        ASSERT_TRUE(texture.validatePayload());
        EXPECT_FALSE(MakeImageSource(self.m_pool, texture).has_value());
    }
}

void VerifyUiImageSourceTests_RejectsMissingAssetIdentityAndEmptyTexturePayload(mut UiImageSourceTests self){
    TestValueSlot<Texture> unnamedSlot;
    mut Texture unnamed = unnamedSlot.constructIn(self.m_inputArena);
    ASSERT_TRUE(self.prepareDefault(unnamed));
    EXPECT_FALSE(MakeImageSource(self.m_pool, unnamed).has_value());
    TestValueSlot<Texture> emptySlot;
    mut Texture empty = emptySlot.constructIn(self.m_inputArena, s_UiFixtureNameTestsUiImageEmpty);
    EXPECT_FALSE(MakeImageSource(self.m_pool, empty).has_value());
    TestValueSlot<Texture> textureSlot;
    mut Texture texture = textureSlot.constructIn(self.m_inputArena, s_UiFixtureNameTestsUiImageNoBytes);
    ASSERT_TRUE(self.prepareDefault(texture));
    self.installEmptyBytesKeepMips(texture);
    EXPECT_FALSE(MakeImageSource(self.m_pool, texture).has_value());
}

