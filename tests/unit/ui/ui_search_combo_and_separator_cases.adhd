void VerifyUiSearchComboBehaviorTests_SameQueryCallbackAssignmentStillInvalidatesTheFilterLoan(mut UiSearchComboBehaviorTests self){
    ASSERT_TRUE(self.m_state.query().setText("tail"));
    const u64 externalRevision = self.m_state.query().externalRevision();
    const u64 previewGeneration = self.m_state.combo().listState().inputGeneration();
    self.m_source.onFilter = UiSearchComboBehaviorMutation::SameQuery;
    EXPECT_FALSE(UiSearchComboFilterState(self.m_state, self.m_source));
    EXPECT_GT(self.m_state.query().externalRevision(), externalRevision);
    EXPECT_EQ(self.m_state.query().text(), "tail");
    EXPECT_EQ(self.m_state.combo().listState().inputGeneration(), previewGeneration);
}

void VerifyUiSearchComboBehaviorTests_CompositionCallbacksInvalidateTheLoanWithoutChangingCommittedQuery(mut UiSearchComboBehaviorTests self){
    Array<UiSearchComboBehaviorMutationEnum, 3u> mutations;
    mutations[0u] = UiSearchComboBehaviorMutation::CompositionBegin;
    mutations[1u] = UiSearchComboBehaviorMutation::CompositionUpdate;
    mutations[2u] = UiSearchComboBehaviorMutation::CompositionCancel;
    for(in UiSearchComboBehaviorMutationEnum mutation : mutations){
        SearchComboState state = SearchComboState(self.m_arena);
        UiSearchComboBehaviorSource source = UiSearchComboBehaviorSource(self.m_arena, state);
        ASSERT_TRUE(state.query().setText("tail"));
        if(mutation != UiSearchComboBehaviorMutation::CompositionBegin)
            ASSERT_TRUE(state.query().beginComposition());
        const u64 revision = state.query().revision();
        const u64 externalRevision = state.query().externalRevision();
        const u64 compositionGeneration = state.query().compositionGeneration();
        const u64 previewGeneration = state.combo().listState().inputGeneration();
        source.onFilter = mutation;
        EXPECT_FALSE(UiSearchComboFilterState(state, source));
        EXPECT_EQ(state.query().text(), "tail");
        EXPECT_EQ(state.query().revision(), revision);
        EXPECT_EQ(state.query().externalRevision(), externalRevision);
        EXPECT_NE(state.query().compositionGeneration(), compositionGeneration);
        EXPECT_EQ(state.combo().listState().inputGeneration(), previewGeneration);
        EXPECT_EQ(state.query().composition().active, mutation != UiSearchComboBehaviorMutation::CompositionCancel);
    }
}

void VerifyUiSearchComboBehaviorTests_ReentrantQuerySelectionRejectsTheLoanAndKeepsTheCallbackSelection(mut UiSearchComboBehaviorTests self){
