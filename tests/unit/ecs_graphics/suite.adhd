    candidates[2u].rotation = f32x4(0.0f, 0.6f, 0.0f, 0.8f);
    candidates[3u].rotation = f32x4(0.0f, 0.0f, 0.6f, 0.8f);
    candidates[4u].rotation = f32x4(0.6f, 0.0f, 0.0f, -0.8f);
