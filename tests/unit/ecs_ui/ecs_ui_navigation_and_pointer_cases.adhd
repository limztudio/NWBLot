void VerifyUiFrameDeltaTests_InvalidUpdatesDoNotEraseRetainedTime(){
    UiFrameDelta delta = UiFrameDelta();
    delta.add(0.25f);
    delta.add(-3.0f);
    delta.add(bit_cast<f32>(0x7fc00000u));
    delta.add(bit_cast<f32>(0x7f800000u));
    delta.add(bit_cast<f32>(0xff800000u));
    EXPECT_FLOAT_EQ(delta.consume(), 0.25f);
}

void VerifyUiFrameDeltaTests_LongStallSaturatesAtPaintDeltaLimit(){
    UiFrameDelta delta = UiFrameDelta();
    delta.add(f32.max);
    delta.add(f32.max);
    EXPECT_EQ(delta.consume(), f32.max);
    EXPECT_FLOAT_EQ(delta.consume(), 0.0f);
}

UiTextEditOwner MakeMultilineOwner(in u64 widgetValue, in u64 modelGeneration){
    UiTextEditOwner owner = UiTextEditOwner();
    owner.widget.value = widgetValue;
    owner.declarationGeneration = 1u;
    owner.modelGeneration = modelGeneration;
    return owner;
}

TextInputRect MakeMultilineCaret(){
    TextInputRect caret = TextInputRect();
    caret.x = 30;
    caret.y = 40;
    caret.width = 1;
    caret.height = 18;
    return caret;
}

void VerifyUiMultilineClipboardTests_NormalizedCapacityFailurePreservesSelectionAndHistory(mut UiMultilineClipboardTests self){
    EditLimits limits = EditLimits();
    limits.maxBytes = 6u;
    EditModel model = EditModel(limits, EditTextMode::Multiline);
    UiEditClipboardController controller = UiEditClipboardController(self.m_clipboard);
    const UiTextEditOwner owner = MakeMultilineOwner(51u, model.instanceGeneration());
    ASSERT_TRUE(model.setText("a\nb"));
    ASSERT_TRUE(model.setSelection(1u, 2u));
    const u64 revision = model.revision();
    const u64 selection = model.selectionGeneration();
    self.m_clipboard.delayed = true;
    ASSERT_EQ(controller.request(owner, model, EditClipboardAction::Paste).status, UiEditClipboardStatus::Pending);
    ASSERT_TRUE(self.m_clipboard.pump());
    ASSERT_TRUE(self.m_clipboard.deliver(controller.token(), ClipboardStatus::Success, "x\r\ny\r\nz"));
    EXPECT_EQ(controller.drain(owner, model).status, UiEditClipboardStatus::TooLarge);
    EXPECT_EQ(model.text(), "a\nb");
    EXPECT_EQ(model.anchor(), 1u);
    EXPECT_EQ(model.caret(), 2u);
    EXPECT_EQ(model.revision(), revision);
    EXPECT_EQ(model.selectionGeneration(), selection);
    EXPECT_FALSE(model.canUndo());
}

void VerifyUiMultilineClipboardTests_UnsupportedControlsRejectBeforeReplacement(mut UiMultilineClipboardTests self){
    EditModel model = EditModel(EditLimits(), EditTextMode::Multiline);
    UiEditClipboardController controller = UiEditClipboardController(self.m_clipboard);
    const UiTextEditOwner owner = MakeMultilineOwner(51u, model.instanceGeneration());
    ASSERT_TRUE(model.setText("a\nb"));
    ASSERT_TRUE(model.selectAll());
    const u64 selection = model.selectionGeneration();
    self.m_clipboard.delayed = true;
    ASSERT_EQ(controller.request(owner, model, EditClipboardAction::Paste).status, UiEditClipboardStatus::Pending);
    ASSERT_TRUE(self.m_clipboard.pump());
    ASSERT_TRUE(self.m_clipboard.deliver(controller.token(), ClipboardStatus::Success, "x\x01y"));
    EXPECT_EQ(controller.drain(owner, model).status, UiEditClipboardStatus::InvalidText);
    EXPECT_EQ(model.text(), "a\nb");
    EXPECT_EQ(model.anchor(), 0u);
    EXPECT_EQ(model.caret(), 3u);
    EXPECT_EQ(model.selectionGeneration(), selection);
    EXPECT_FALSE(model.canUndo());
}

void VerifyUiMultilineNativeTests_NoncanonicalPreeditRejectsRatherThanChangingNativeOffsets(mut UiMultilineNativeTests self){
    EditModel model = EditModel(EditLimits(), EditTextMode::Multiline);
    UiTextEditSession session = UiTextEditSession(self.m_textInput);
    const UiTextEditOwner owner = MakeMultilineOwner(81u, model.instanceGeneration());
    ASSERT_TRUE(model.setText("a\nb"));
    const u64 selection = model.selectionGeneration();
    ASSERT_EQ(session.begin(owner, MakeMultilineCaret(), model), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.preedit("x\r\ny", 1u, 4u), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(owner, model).status, UiTextEditStatus::ModelRejected);
    EXPECT_EQ(model.text(), "a\nb");
    EXPECT_EQ(model.selectionGeneration(), selection);
    EXPECT_FALSE(model.composition().active);
    EXPECT_FALSE(session.token().valid());
}

void VerifyUiMultilineNativeTests_LaterOversizedCommitPreservesEarlierAcceptedNativeEdit(mut UiMultilineNativeTests self){
    EditLimits limits = EditLimits();
    limits.maxBytes = 6u;
    EditModel model = EditModel(limits, EditTextMode::Multiline);
    UiTextEditSession session = UiTextEditSession(self.m_textInput);
    const UiTextEditOwner owner = MakeMultilineOwner(81u, model.instanceGeneration());
    ASSERT_TRUE(model.setText("a\nb"));
    ASSERT_EQ(session.begin(owner, MakeMultilineCaret(), model), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.commit("x"), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.commit("y\r\nzz"), TextInputAdmission::Accepted);
    const UiTextEditResult result = session.drain(owner, model);
    EXPECT_EQ(result.status, UiTextEditStatus::ModelRejected);
    EXPECT_EQ(result.eventsApplied, 1u);
    EXPECT_EQ(model.text(), "a\nbx");
    EXPECT_FALSE(session.token().valid());
    ASSERT_TRUE(model.undo());
    EXPECT_EQ(model.text(), "a\nb");
    EXPECT_FALSE(model.canUndo());
}


