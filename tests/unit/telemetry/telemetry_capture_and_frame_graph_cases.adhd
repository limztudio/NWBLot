void VerifyTelemetry_FrameGraphPayloadRejectsNonCurrentVersions(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    FrameGraphPhysicalQueueRuntimeStatisticsRecords physicalQueueRuntimeStatistics = FrameGraphPhysicalQueueRuntimeStatisticsRecords(testArena.arena);
    FrameGraphPacketSubmissionStatisticsRecords packetSubmissionStatistics = FrameGraphPacketSubmissionStatisticsRecords(testArena.arena);
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);

    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildTestFrameGraphPayload(907u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    EncodedFrameGraphPayloadHeader header = EncodedFrameGraphPayloadHeader();
    ReadTelemetryPod(payload, 0u, header);
    ASSERT_EQ(header.version, s_FrameGraphPayloadVersion);
    ASSERT_GT(header.nodeCount, 0u);
    ASSERT_GT(header.runtimeStatisticsCount, 0u);
    ASSERT_GT(header.physicalQueueRuntimeStatisticsCount, 0u);
    ASSERT_GT(header.packetSubmissionStatisticsCount, 0u);

    Array<u16, 12> unsupportedVersions = Array<u16, 12>();
    for(usize idx = 0u; idx < 10u; ++idx)
        unsupportedVersions[idx] = cast<u16>(idx);
    unsupportedVersions[10u] = cast<u16>(s_FrameGraphPayloadVersion + 1u);
    unsupportedVersions[11u] = u16.max;
    for(in u16 version : unsupportedVersions){
        ScopedTestTrace trace = ScopedTestTrace(version);
        header.version = s_FrameGraphPayloadVersion;
        WriteTelemetryPod(payload, 0u, header);
        const Expected<FrameGraphPayload> parsed = ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload);
        ASSERT_TRUE(parsed.has_value());
        ASSERT_FALSE(parsed.value().nodes.empty());
        ASSERT_FALSE(parsed.value().physicalQueueRuntimeStatistics.empty());
        ASSERT_FALSE(parsed.value().packetSubmissionStatistics.empty());

        header.version = version;
        WriteTelemetryPod(payload, 0u, header);
        EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());
    }
}

void VerifyTelemetry_FrameGraphPayloadRejectsHistoricalEmptyPayloads(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildTestFrameGraphPayload(907u, nodes, edges, testArena.scratchArena, payload));
    ASSERT_EQ(payload.size(), s_EncodedFrameGraphPayloadHeaderByteSize);
    EncodedFrameGraphPayloadHeader header = EncodedFrameGraphPayloadHeader();
    ReadTelemetryPod(payload, 0u, header);
    const Expected<FrameGraphPayload> parsed = ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload);
    ASSERT_TRUE(parsed.has_value());
    EXPECT_EQ(parsed.value().frameIndex, 907u);

    Array<usize, 9> historicalHeaderBytes = Array<usize, 9>();
    historicalHeaderBytes[0u] = 28u;
    historicalHeaderBytes[1u] = 32u;
    historicalHeaderBytes[2u] = 36u;
    historicalHeaderBytes[3u] = 40u;
    historicalHeaderBytes[4u] = 44u;
    historicalHeaderBytes[5u] = 44u;
    historicalHeaderBytes[6u] = 48u;
    historicalHeaderBytes[7u] = 52u;
    historicalHeaderBytes[8u] = 52u;
    for(usize versionIndex = 0u; versionIndex < historicalHeaderBytes.size(); ++versionIndex){
        header.version = cast<u16>(versionIndex + 1u);
        ScopedTestTrace trace = ScopedTestTrace(header.version);
        WriteTelemetryPod(payload, 0u, header);
        EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload, historicalHeaderBytes[versionIndex]).has_value());
    }
}

void VerifyTelemetry_FrameGraphQueueAssignmentPayloadRejectsMalformedRecords(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    BuildTestAssignedFrameGraph(testArena.arena, nodes, edges);

    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildTestFrameGraphPayload(908u, nodes, edges, testArena.scratchArena, payload));
    const usize assignmentOffset = s_EncodedFrameGraphPayloadHeaderByteSize
        + s_EncodedFrameGraphNodeByteSize * nodes.size()
        + s_EncodedFrameGraphEdgeByteSize * edges.size();
    const usize secondAssignmentOffset = assignmentOffset + s_EncodedFrameGraphQueueAssignmentByteSize;
    EncodedFrameGraphQueueAssignment first = EncodedFrameGraphQueueAssignment();
    EncodedFrameGraphQueueAssignment second = EncodedFrameGraphQueueAssignment();
    ReadTelemetryPod(payload, assignmentOffset, first);
    ReadTelemetryPod(payload, secondAssignmentOffset, second);

    second.nodeIndex = first.nodeIndex;
    WriteTelemetryPod(payload, secondAssignmentOffset, second);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(908u, nodes, edges, testArena.scratchArena, payload));
    ReadTelemetryPod(payload, assignmentOffset, first);
    ReadTelemetryPod(payload, secondAssignmentOffset, second);
    first.nodeIndex = 2u;
    second.nodeIndex = 0u;
    WriteTelemetryPod(payload, assignmentOffset, first);
    WriteTelemetryPod(payload, secondAssignmentOffset, second);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(908u, nodes, edges, testArena.scratchArena, payload));
    ReadTelemetryPod(payload, assignmentOffset, first);
    first.nodeIndex = 1u;
    WriteTelemetryPod(payload, assignmentOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(908u, nodes, edges, testArena.scratchArena, payload));
    ReadTelemetryPod(payload, assignmentOffset, first);
    first.modifiers = cast<u8>(1u << 7u);
    WriteTelemetryPod(payload, assignmentOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(908u, nodes, edges, testArena.scratchArena, payload));
    ReadTelemetryPod(payload, assignmentOffset, first);
    ++first.scoreTotal;
    WriteTelemetryPod(payload, assignmentOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(908u, nodes, edges, testArena.scratchArena, payload));
    ReadTelemetryPod(payload, assignmentOffset, first);
    first.acceptedQueue.deviceGeneration = 0u;
    WriteTelemetryPod(payload, assignmentOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(908u, nodes, edges, testArena.scratchArena, payload));
    ReadTelemetryPod(payload, assignmentOffset, first);
    first.previousAcceptedQueue.index = u16.max;
    WriteTelemetryPod(payload, assignmentOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());
}

void VerifyTelemetry_FrameGraphCompiledTaskPayloadRejectsMalformedRecords(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    BuildTestCompiledFrameGraph(testArena.arena, nodes, edges);

    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildTestFrameGraphPayload(909u, nodes, edges, testArena.scratchArena, payload));
    const usize compiledTaskOffset = s_EncodedFrameGraphPayloadHeaderByteSize
        + s_EncodedFrameGraphNodeByteSize * nodes.size()
        + s_EncodedFrameGraphEdgeByteSize * edges.size()
        + s_EncodedFrameGraphQueueAssignmentByteSize * 2u;
    const usize secondCompiledTaskOffset = compiledTaskOffset + s_EncodedFrameGraphCompiledTaskByteSize;
    EncodedFrameGraphCompiledTask first = EncodedFrameGraphCompiledTask();
    EncodedFrameGraphCompiledTask second = EncodedFrameGraphCompiledTask();
    ReadTelemetryPod(payload, compiledTaskOffset, first);
    ReadTelemetryPod(payload, secondCompiledTaskOffset, second);

    second.nodeIndex = first.nodeIndex;
    WriteTelemetryPod(payload, secondCompiledTaskOffset, second);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(909u, nodes, edges, testArena.scratchArena, payload));
    ReadTelemetryPod(payload, compiledTaskOffset, first);
    first.nodeIndex = 1u;
    WriteTelemetryPod(payload, compiledTaskOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(909u, nodes, edges, testArena.scratchArena, payload));
    ReadTelemetryPod(payload, compiledTaskOffset, first);
    first.planGeneration = 0u;
    WriteTelemetryPod(payload, compiledTaskOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(909u, nodes, edges, testArena.scratchArena, payload));
    ReadTelemetryPod(payload, compiledTaskOffset, first);
    first.packetIndex = u32.max;
    WriteTelemetryPod(payload, compiledTaskOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(909u, nodes, edges, testArena.scratchArena, payload));
    ReadTelemetryPod(payload, compiledTaskOffset, first);
    first.packetizationDecision = FrameGraphTaskPacketizationDecision::Unknown;
    WriteTelemetryPod(payload, compiledTaskOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(909u, nodes, edges, testArena.scratchArena, payload));
    ReadTelemetryPod(payload, compiledTaskOffset, first);
    first.packetizationDecision = FrameGraphTaskPacketizationDecision::Count;
    WriteTelemetryPod(payload, compiledTaskOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(909u, nodes, edges, testArena.scratchArena, payload));
    ReadTelemetryPod(payload, compiledTaskOffset, first);
    first.reserved[0u] = 1u;
    WriteTelemetryPod(payload, compiledTaskOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());
}

void VerifyTelemetry_PacketSubmissionStatisticsRejectInconsistentCountsAndNonfiniteTime(){
    FrameGraphPacketSubmissionStatisticsRecord statistics = FrameGraphPacketSubmissionStatisticsRecord();
    statistics.packetGeneration = 72u;
    statistics.taskCount = 2u;
    statistics.commandListCount = 1u;
    statistics.plannedWaitTokenCount = 4u;
    statistics.sameQueueWaitElisionCount = 1u;
    statistics.timelineWaitCount = 1u;
    statistics.mergedTimelineWaitCount = 1u;
    statistics.inheritedTimelineWaitElisionCount = 1u;
    statistics.submissionSeconds = 0.125;
    statistics.queue.index = 3u;
    statistics.queue.deviceGeneration = 17u;
    statistics.ownerNodeIndex = 0u;
    statistics.packetIndex = 1u;
    statistics.queueClass = FrameGraphQueueClass::Compute;
    statistics.joinsAcceptedQueueFrontier = true;
    statistics.recoverySubmission = true;
    EXPECT_TRUE(IsValidFrameGraphPacketSubmissionStatistics(statistics));

    statistics.joinsAcceptedQueueFrontier = false;
    EXPECT_FALSE(IsValidFrameGraphPacketSubmissionStatistics(statistics));
    statistics.joinsAcceptedQueueFrontier = true;
    ++statistics.timelineWaitCount;
    EXPECT_FALSE(IsValidFrameGraphPacketSubmissionStatistics(statistics));
    --statistics.timelineWaitCount;
    ++statistics.inheritedTimelineWaitElisionCount;
    EXPECT_FALSE(IsValidFrameGraphPacketSubmissionStatistics(statistics));
    statistics.inheritedTimelineWaitElisionCount = u64.max;
    EXPECT_FALSE(IsValidFrameGraphPacketSubmissionStatistics(statistics));
    statistics.inheritedTimelineWaitElisionCount = 1u;
    statistics.commandListCount = 0u;
    EXPECT_FALSE(IsValidFrameGraphPacketSubmissionStatistics(statistics));
    statistics.commandListCount = 1u;
    statistics.submissionSeconds = bit_cast<f64>(0x7FF8000000000000uLL);
    EXPECT_FALSE(IsValidFrameGraphPacketSubmissionStatistics(statistics));
}

void VerifyTelemetry_InheritedWaitStatisticsRejectMalformedCountsAndMismatchedTotals(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    FrameGraphPhysicalQueueRuntimeStatisticsRecords physicalQueueRuntimeStatistics = FrameGraphPhysicalQueueRuntimeStatisticsRecords(testArena.arena);
    FrameGraphPacketSubmissionStatisticsRecords packetSubmissionStatistics = FrameGraphPacketSubmissionStatisticsRecords(testArena.arena);
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);
    ++nodes[0u].runtimeStatistics.submission.plannedWaitTokenCount;
    ++nodes[0u].runtimeStatistics.submission.inheritedTimelineWaitElisionCount;
    ++physicalQueueRuntimeStatistics[0u].statistics.submission.plannedWaitTokenCount;
    ++physicalQueueRuntimeStatistics[0u].statistics.submission.inheritedTimelineWaitElisionCount;
    ++packetSubmissionStatistics[2u].plannedWaitTokenCount;
    ++packetSubmissionStatistics[2u].inheritedTimelineWaitElisionCount;

    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildTestFrameGraphPayload(921u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    const Expected<FrameGraphPayload> parsed = ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload);
    ASSERT_TRUE(parsed.has_value());
    EXPECT_EQ(parsed.value().nodes[0u].runtimeStatistics.submission.inheritedTimelineWaitElisionCount, 1u);
    EXPECT_EQ(parsed.value().physicalQueueRuntimeStatistics[1u].statistics.submission.inheritedTimelineWaitElisionCount, 1u);
    EXPECT_EQ(parsed.value().packetSubmissionStatistics[1u].inheritedTimelineWaitElisionCount, 1u);

    const usize computePacketOffset = s_EncodedFrameGraphPayloadHeaderByteSize
        + s_EncodedFrameGraphNodeByteSize
        + s_EncodedFrameGraphRuntimeStatisticsByteSize
        + s_EncodedFrameGraphPhysicalQueueRuntimeStatisticsByteSize * 2u
        + s_EncodedFrameGraphPacketSubmissionStatisticsByteSize;
    EncodedFrameGraphPacketSubmissionStatistics encoded = EncodedFrameGraphPacketSubmissionStatistics();
    ReadTelemetryPod(payload, computePacketOffset, encoded);
    encoded.inheritedTimelineWaitElisionCount = u64.max;
    WriteTelemetryPod(payload, computePacketOffset, encoded);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    nodes[0u].runtimeStatistics.submission.inheritedTimelineWaitElisionCount = 0u;
    ++nodes[0u].runtimeStatistics.submission.timelineWaitCount;
    ASSERT_TRUE(IsValidFrameGraphRuntimeStatistics(nodes[0u].runtimeStatistics));
    EXPECT_FALSE(BuildTestFrameGraphPayload(921u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    EXPECT_TRUE(payload.empty());

    nodes[0u].runtimeStatistics.submission.inheritedTimelineWaitElisionCount = 1u;
    --nodes[0u].runtimeStatistics.submission.timelineWaitCount;
    physicalQueueRuntimeStatistics[0u].statistics.submission.inheritedTimelineWaitElisionCount = 0u;
    ++physicalQueueRuntimeStatistics[0u].statistics.submission.timelineWaitCount;
    ASSERT_TRUE(IsValidFrameGraphPhysicalQueueRuntimeStatistics(physicalQueueRuntimeStatistics[0u].statistics));
    EXPECT_FALSE(BuildTestFrameGraphPayload(921u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    EXPECT_TRUE(payload.empty());

    physicalQueueRuntimeStatistics.clear();
    packetSubmissionStatistics[2u].inheritedTimelineWaitElisionCount = 0u;
    ++packetSubmissionStatistics[2u].timelineWaitCount;
    ASSERT_TRUE(IsValidFrameGraphPacketSubmissionStatistics(packetSubmissionStatistics[2u]));
    EXPECT_FALSE(BuildTestFrameGraphPayload(921u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    EXPECT_TRUE(payload.empty());
}

void VerifyTelemetry_PacketSubmissionEncodingIsIndependentOfInputOrder(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    FrameGraphPhysicalQueueRuntimeStatisticsRecords physicalQueueRuntimeStatistics = FrameGraphPhysicalQueueRuntimeStatisticsRecords(testArena.arena);
    FrameGraphPacketSubmissionStatisticsRecords packetSubmissionStatistics = FrameGraphPacketSubmissionStatisticsRecords(testArena.arena);
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);

    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildTestFrameGraphPayload(918u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    const FrameGraphPhysicalQueueRuntimeStatisticsRecord firstPhysicalQueue = physicalQueueRuntimeStatistics[0u];
    physicalQueueRuntimeStatistics[0u] = physicalQueueRuntimeStatistics[1u];
    physicalQueueRuntimeStatistics[1u] = firstPhysicalQueue;
    const FrameGraphPacketSubmissionStatisticsRecord packetZero = packetSubmissionStatistics[1u];
    const FrameGraphPacketSubmissionStatisticsRecord packetOne = packetSubmissionStatistics[2u];
    const FrameGraphPacketSubmissionStatisticsRecord packetTwo = packetSubmissionStatistics[0u];
    packetSubmissionStatistics[0u] = packetZero;
    packetSubmissionStatistics[1u] = packetOne;
    packetSubmissionStatistics[2u] = packetTwo;

    TelemetryBytes reorderedPayload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildTestFrameGraphPayload(918u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, reorderedPayload));
    ASSERT_EQ(payload.size(), reorderedPayload.size());
    EXPECT_EQ(payload, reorderedPayload);
}

void VerifyTelemetry_FrameGraphPacketSubmissionStatisticsPayloadRejectsMalformedRecords(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    FrameGraphPhysicalQueueRuntimeStatisticsRecords physicalQueueRuntimeStatistics = FrameGraphPhysicalQueueRuntimeStatisticsRecords(testArena.arena);
    FrameGraphPacketSubmissionStatisticsRecords packetSubmissionStatistics = FrameGraphPacketSubmissionStatisticsRecords(testArena.arena);
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);

    packetSubmissionStatistics[0u].joinsAcceptedQueueFrontier = false;
    EXPECT_FALSE(BuildTestFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);
    packetSubmissionStatistics[1u].packetGeneration = 99u;
    EXPECT_FALSE(BuildTestFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);
    packetSubmissionStatistics[1u].packetIndex = packetSubmissionStatistics[2u].packetIndex;
    EXPECT_FALSE(BuildTestFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);
    packetSubmissionStatistics[2u].commandListCount = 1u;
    EXPECT_FALSE(BuildTestFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);
    packetSubmissionStatistics[1u].submissionSeconds += 0.01;
    EXPECT_FALSE(BuildTestFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);
    packetSubmissionStatistics[1u].queue.index = 3u;
    packetSubmissionStatistics[1u].queue.deviceGeneration = 17u;
    packetSubmissionStatistics[1u].queueClass = FrameGraphQueueClass::Compute;
    EXPECT_FALSE(BuildTestFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));

    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);
    ASSERT_TRUE(BuildTestFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    const usize packetSubmissionStatisticsOffset = s_EncodedFrameGraphPayloadHeaderByteSize
        + s_EncodedFrameGraphNodeByteSize
        + s_EncodedFrameGraphRuntimeStatisticsByteSize
        + s_EncodedFrameGraphPhysicalQueueRuntimeStatisticsByteSize * 2u;
    EncodedFrameGraphPacketSubmissionStatistics encodedStatistics = EncodedFrameGraphPacketSubmissionStatistics();
    ReadTelemetryPod(payload, packetSubmissionStatisticsOffset, encodedStatistics);
    encodedStatistics.reserved = 1u;
    WriteTelemetryPod(payload, packetSubmissionStatisticsOffset, encodedStatistics);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    ReadTelemetryPod(payload, packetSubmissionStatisticsOffset, encodedStatistics);
    encodedStatistics.submissionSeconds += 0.01;
    WriteTelemetryPod(payload, packetSubmissionStatisticsOffset, encodedStatistics);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    const usize secondPacketSubmissionStatisticsOffset = packetSubmissionStatisticsOffset + s_EncodedFrameGraphPacketSubmissionStatisticsByteSize;
    ReadTelemetryPod(payload, secondPacketSubmissionStatisticsOffset, encodedStatistics);
    encodedStatistics.packetIndex = 0u;
    WriteTelemetryPod(payload, secondPacketSubmissionStatisticsOffset, encodedStatistics);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    EncodedFrameGraphPayloadHeader header = EncodedFrameGraphPayloadHeader();
    ReadTelemetryPod(payload, 0u, header);
    ++header.packetSubmissionStatisticsCount;
    WriteTelemetryPod(payload, 0u, header);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    ReadTelemetryPod(payload, 0u, header);
    header.packetSubmissionStatisticsPresent = 0u;
    WriteTelemetryPod(payload, 0u, header);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    ReadTelemetryPod(payload, 0u, header);
    header.reservedTail[1u] = 1u;
    WriteTelemetryPod(payload, 0u, header);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(920u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, testArena.scratchArena, payload));
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload, payload.size() - 1u).has_value());
}

void VerifyTelemetry_PhysicalQueueDecodeShrinkingInputClearsPreviousRecords(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    BuildTestRuntimeFrameGraph(testArena.arena, nodes, edges);
    FrameGraphPhysicalQueueRuntimeStatisticsRecords records = FrameGraphPhysicalQueueRuntimeStatisticsRecords(testArena.arena);
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    TelemetryBytes payload = TelemetryBytes(testArena.arena);

    ASSERT_TRUE(BuildTestFrameGraphPayload(916u, nodes, edges, records, testArena.scratchArena, payload));
    Expected<FrameGraphPayload> parsed = ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload);
    ASSERT_TRUE(parsed.has_value());
    ASSERT_EQ(parsed.value().physicalQueueRuntimeStatistics.size(), 2u);

    records.resize(1u);
    ASSERT_TRUE(BuildTestFrameGraphPayload(916u, nodes, edges, records, testArena.scratchArena, payload));
    parsed = ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload);
    ASSERT_TRUE(parsed.has_value());
    ASSERT_EQ(parsed.value().physicalQueueRuntimeStatistics.size(), 1u);
    EXPECT_EQ(parsed.value().physicalQueueRuntimeStatistics[0u].statistics.queue.index, 3u);
}

void VerifyTelemetry_FrameGraphPhysicalQueueRuntimeStatisticsPayloadRejectsMalformedRecords(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    BuildTestRuntimeFrameGraph(testArena.arena, nodes, edges);
    FrameGraphPhysicalQueueRuntimeStatisticsRecords records = FrameGraphPhysicalQueueRuntimeStatisticsRecords(testArena.arena);
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    TelemetryBytes payload = TelemetryBytes(testArena.arena);

    records[0u].statistics.graphGeneration = 99u;
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    records[0u].ownerNodeIndex = 1u;
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    records[0u].statistics.queue.deviceGeneration = 18u;
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    records[0u].statistics.queueClass = FrameGraphQueueClass::Unknown;
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    records[0u].statistics.recording.recordingSeconds = -1.0;
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    records[0u].statistics.submission.submissionSeconds = bit_cast<f64>(0x7FF8000000000000uLL);
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    records[0u].statistics.submission.recoverySubmissionCount = records[0u].statistics.submission.acceptedFrontierSubmissionCount + 1u;
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    ++records[0u].statistics.submission.recoverySubmissionCount;
    EXPECT_TRUE(IsValidFrameGraphPhysicalQueueRuntimeStatistics(records[0u].statistics));
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    ++records[0u].statistics.compile.mergedTaskCount;
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    ++records[0u].statistics.submission.timelineWaitCount;
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    records[0u].statistics.compile.taskCount = 79u;
    records[0u].statistics.compile.packetCount = 78u;
    records[0u].statistics.compile.mergedTaskCount = 1u;
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    records[0u].statistics.recording.recordingSeconds = 0.017;
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    records[0u].statistics.compile.taskCount = 29u;
    records[0u].statistics.compile.mergedTaskCount = 2u;
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    ++records[0u].statistics.submission.plannedWaitTokenCount;
    ++records[0u].statistics.submission.timelineWaitCount;
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    records[0u].statistics.compile.epilogueBarrierCount = 4u;
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    records[0u].statistics.recording.barrierCount = 12u;
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    records[0u].statistics.recording.taskCount = 13u;
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    records[0u].statistics.submission.acceptedTaskCount = 13u;
    records[0u].statistics.submission.rejectedPacketCount = 14u;
    records[0u].statistics.submission.rejectedTaskCount = 15u;
    records[0u].statistics.submission.rejectedSubmissionCount = 14u;
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    records[0u].statistics.compile.incomingLogicalOwnershipTransferSignatureCount = 0u;
    records[0u].statistics.compile.outgoingLogicalOwnershipTransferSignatureCount = 0u;
    records[0u].statistics.compile.incomingRepeatedOwnershipTransferSignatureCount = 0u;
    records[0u].statistics.compile.outgoingRepeatedOwnershipTransferSignatureCount = 0u;
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    records.push_back(records[0u]);
    EXPECT_FALSE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));

    BuildTestPhysicalQueueRuntimeStatistics(testArena.arena, records);
    ASSERT_TRUE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    const usize statisticsOffset = s_EncodedFrameGraphPayloadHeaderByteSize
        + s_EncodedFrameGraphNodeByteSize * nodes.size()
        + s_EncodedFrameGraphEdgeByteSize * edges.size()
        + s_EncodedFrameGraphQueueAssignmentByteSize * 2u
        + s_EncodedFrameGraphCompiledTaskByteSize * 2u
        + s_EncodedFrameGraphRuntimeStatisticsByteSize * 2u;
    for(usize mutationIndex = 0u; mutationIndex < s_EncodedPhysicalQueueMutationCount; ++mutationIndex){
        ScopedTestTrace trace = ScopedTestTrace(mutationIndex);
        ASSERT_TRUE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
        EncodedFrameGraphPhysicalQueueRuntimeStatistics encodedStatistics = EncodedFrameGraphPhysicalQueueRuntimeStatistics();
        ReadTelemetryPod(payload, statisticsOffset, encodedStatistics);
        ApplyEncodedPhysicalQueueMutation(mutationIndex, encodedStatistics);
        WriteTelemetryPod(payload, statisticsOffset, encodedStatistics);
        EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());
    }

    ASSERT_TRUE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    const usize secondStatisticsOffset = statisticsOffset + s_EncodedFrameGraphPhysicalQueueRuntimeStatisticsByteSize;
    EncodedFrameGraphPhysicalQueueRuntimeStatistics encodedStatistics = EncodedFrameGraphPhysicalQueueRuntimeStatistics();
    ReadTelemetryPod(payload, secondStatisticsOffset, encodedStatistics);
    encodedStatistics.queue.index = 1u;
    WriteTelemetryPod(payload, secondStatisticsOffset, encodedStatistics);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    EncodedFrameGraphPayloadHeader header = EncodedFrameGraphPayloadHeader();
    ReadTelemetryPod(payload, 0u, header);
    ++header.physicalQueueRuntimeStatisticsCount;
    WriteTelemetryPod(payload, 0u, header);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(BuildTestFrameGraphPayload(917u, nodes, edges, records, testArena.scratchArena, payload));
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload, payload.size() - 1u).has_value());
}


