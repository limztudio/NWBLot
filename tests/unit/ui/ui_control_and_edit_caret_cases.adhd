class UiControlInputTests : RouterTestFixture{
    public Array<HitTarget, 3u> m_targets;

    public UiControlInputTests(){
        this.m_targets[0u] = MakeUiControlInputHost(1u, 0.0f);
        this.m_targets[1u] = MakeControlInputPart(this.m_targets[0u], 2u, Rect(0.0f, 0.0f, 80.0f, 20.0f), 100000u);
        this.m_targets[2u] = MakeControlInputPart(this.m_targets[0u], 3u, Rect(90.0f, 20.0f, 10.0f, 20.0f), 0u);
        this.m_targets[2u].activatable = false;
        this.m_targets[2u].pointerGesture = true;
        this.m_targets[2u].gestureReference = Rect(90.0f, 0.0f, 10.0f, 100.0f);
        this.m_targets[2u].gestureMaximum = this.m_targets[0u].gestureMaximum;
    }
    public InputRoutingResult wheel(){ return this.wheel(-1.0); }
    public InputRoutingResult wheel(in f64 delta){ return this.wheel(delta, Point(10.0f, 10.0f)); }
    public InputRoutingResult wheel(in f64 delta, in Point position){
        InputEvent event = Pointer(InputEventType::PointerWheel, position);
        event.scrollY = delta;
        return this.send(event);
    }
    public void focus(){
        EXPECT_TRUE(this.send(Key(InputEventType::KeyDown, Key::Tab)).commandConsumed);
        EXPECT_TRUE(this.send(Key(InputEventType::KeyUp, Key::Tab)).commandConsumed);
    }
    public void revise(){
        for(mut HitTarget target : this.m_targets)
            ++target.control.contentRevision;
    }
    public b8 queueNative(in InputEvent event){
        return this.m_router.queue(NativeInput(event)).has_value();
    }
    public Expected<ControlAction> take(){
        return this.m_router.consumeControlAction(this.m_targets[0u].id, this.m_targets[0u].declarationGeneration, this.m_targets[0u].control);
    }
}

[ordered]
class EditBoxLayoutTests{
    public EditModel m_model;
    public FixtureShaper m_shaper;
    public TextLayoutBuilder m_builder;
    public EditBoxView m_view;
    public EditBoxPlacement m_placement;

    public EditBoxLayoutTests(){ this.m_builder = TextLayoutBuilder(this.m_shaper); }
    public b8 shapeView(){
        return ShapeEditBoxView(this.m_model, this.m_view, this.m_builder);
    }
    public b8 tryAdoptBuiltLayout(in StringView text){ return this.tryAdoptBuiltLayout(text, TextDirection::LeftToRight); }
    public b8 tryAdoptBuiltLayout(in StringView text, in TextDirection direction){
        ShapeRequest request;
        request.text = text;
        request.direction = direction;
        auto layout = this.m_builder.layout(request);
        EXPECT_TRUE(layout.has_value());
        return layout.has_value() && this.m_view.adoptLayout(layout.value());
    }
    public void moveViewTo(mut EditBoxView destination){ TestMoveAssign<EditBoxView>(destination, this.m_view); }
    public void configureSkin(mut UiSkin skin){ this.configureSkin(skin, false); }
    public void configureSkin(mut UiSkin skin, in b8 includeButtonRegion){
        Vector<UiSkinRegion> regions;
        if(includeButtonRegion)
            regions.push_back(UiSkinRegion(Name(s_UiCaseNameButtonNormal), UiSkinRect(0u, 0u, 4u, 4u), UiSkinSliceInsets(), UiSkinInsets()));
        skin.setAtlas(AssetRef<Texture>("tests/ui/edit_box/texture"), 4u, 4u, 1.0f, regions);
    }
    public void beginSkinPaint(mut PaintBuilder paint, in UiSkin skin, in u64 generation){ this.beginSkinPaint(paint, skin, generation, 200.0f); }
    public void beginSkinPaint(mut PaintBuilder paint, in UiSkin skin, in u64 generation, in f32 width){ this.beginSkinPaint(paint, skin, generation, width, 100.0f); }
    public void beginSkinPaint(mut PaintBuilder paint, in UiSkin skin, in u64 generation, in f32 width, in f32 height){ this.beginSkinPaint(paint, skin, generation, width, height, 1.0f); }
    public void beginSkinPaint(mut PaintBuilder paint, in UiSkin skin, in u64 generation, in f32 width, in f32 height, in f32 scale){
        paint.begin(DisplayMetrics(width, height, scale, scale), generation, 1u, AssetRef<UiSkin>("tests/ui/edit_box/skin"), skin);
    }
    public b8 installBundledLatinFont(mut Font font, mut TextService service){
        if(!LoadBundledFixtureFont("latin.font", font))
            return false;
        const Array<FontSource, 1u> sources(FontSource(AssetRef<Font>("tests/ui/edit_box/font"), font, 1u));
        return service.setFonts(sources);
    }
    public b8 place(){ return this.place(100.0f); }
    public b8 place(in f32 width){ return this.place(width, 0.0f); }
    public b8 place(in f32 width, in f32 scroll){
        const auto placement = this.m_view.arrange(Rect(10.0f, 20.0f, width, 20.0f), Insets(), Rect(0.0f, 0.0f, 500.0f, 500.0f), Point(scroll, 0.0f), 1.0f, true);
        if(!placement.has_value())
            return false;
        this.m_placement = placement.value();
        return true;
    }
    public Expected<Rect> rangeRect(in EditBoxRange range)const{
        auto rect = this.m_view.caretGeometry().rangeOnLine(range, 0u, this.m_placement.caret.width);
        if(!rect.has_value())
            return MakeUnexpected(Failure());
        const VectorSingle origin = VectorSingle(rect.value().x, rect.value().y, 0.0f, 0.0f) + VectorSingle(this.m_placement.textOrigin.x, this.m_placement.textOrigin.y, 0.0f, 0.0f);
        rect.value().x = origin.x;
        rect.value().y = origin.y;
        return rect;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


HitTarget MakeControlInputPart(in HitTarget host, in u64 id, in Rect rectangle, in u64 value){
    HitTarget target;
    target.id = WidgetId(id);
    target.rectangle = rectangle;
    target.clip = host.clip;
    target.declarationGeneration = host.declarationGeneration;
    target.paintOrder = 1u;
    target.control = host.control;
    target.owner = host.id;
    target.ownerDeclarationGeneration = host.declarationGeneration;
    target.value = value;
    target.activatable = true;
    return target;
}

b8 UiEditCaretAdoptMismatchedSource(mut EditCaretFixture self){
    auto layout = self.layout("new");
    if(!layout.has_value() || !self.identityMapping("new"))
        return false;
    mut TextLayout candidate = layout.value();
    const b8 adopted = self.m_geometry.adoptLayout(candidate, "wrong", self.m_mapping, 3u, EditTextMode::SingleLine, Span<usize>());
    EXPECT_FALSE(adopted);
    EXPECT_EQ(candidate.utf8(), "new");
    return !adopted && candidate.utf8() == "new";
}

b8 UiEditCaretAdoptBuiltLayout(mut EditCaretFixture self, in StringView layoutText, in StringView sourceText, in usize committedBytes, in EditTextMode mode){
    return UiEditCaretAdoptBuiltLayout(self, layoutText, sourceText, committedBytes, mode, TextDirection::LeftToRight);
}

b8 UiEditCaretAdoptBuiltLayout(mut EditCaretFixture self, in StringView layoutText, in StringView sourceText, in usize committedBytes, in EditTextMode mode, in TextDirection direction){
    auto candidate = self.layout(layoutText, direction);
    EXPECT_TRUE(candidate.has_value());
    return candidate.has_value() && self.m_geometry.adoptLayout(candidate.value(), sourceText, self.m_mapping, committedBytes, mode, Span<usize>());
}

b8 UiEditCaretAdoptNonfinitePlacement(mut EditCaretFixture self){
    auto layout = self.layout("ab");
    EXPECT_TRUE(layout.has_value());
    if(!layout.has_value())
        return false;
    mut TextLayout malformed = layout.value();
    EXPECT_EQ(malformed.glyphs().size(), 2u);
    if(malformed.glyphs().size() != 2u)
        return false;
    TextLayoutFaultFixture faults;
    faults.invalidateGlyphPosition(malformed);
    return self.identityMapping("ab") && self.m_geometry.adoptLayout(malformed, "ab", self.m_mapping, 2u, EditTextMode::SingleLine, Span<usize>());
}

b8 UiEditCaretAdoptMutatedLineRecord(mut EditCaretFixture self, in u32 mutation){
    auto layout = self.layout("a\nb");
    EXPECT_TRUE(layout.has_value());
    if(!layout.has_value())
        return false;
    mut TextLayout malformed = layout.value();
    TextLayoutFaultFixture faults;
    faults.invalidateLineRecord(malformed, mutation);
    return self.m_geometry.adoptLayout(malformed, "a\nb", self.m_mapping, 3u, EditTextMode::Multiline, Span<usize>());
}

EditBoxRange MakeUiEditCaretRange(in usize begin, in usize end){
    EditBoxRange range = EditBoxRange();
    range.begin = begin;
    range.end = end;
    return range;
}

EditCaretMapping MakeUiEditCaretMapping(in usize committedByte, in usize displayByte){
    EditCaretMapping mapping = EditCaretMapping();
    mapping.committedByte = committedByte;
    mapping.displayByte = displayByte;
    return mapping;
}

HitTarget MakeUiControlInputHost(in u64 id, in f32 x){
    HitTarget target = HitTarget();
    target.id.value = id;
    target.declarationGeneration = 7u;
    target.rectangle = Rect(x, 0.0f, 100.0f, 100.0f);
    target.clip = Rect(0.0f, 0.0f, 300.0f, 200.0f);
    target.focusable = true;
    target.control.instanceGeneration = 11u;
    target.control.contentGeneration = 21u;
    target.control.contentRevision = 31u;
    target.navigable = true;
    target.scrollable = true;
    target.scrollStep = 72.0;
    target.pageRows = 4u;
    target.gestureMaximum = 2399900.0;
    return target;
}

void VerifyUiControlInputTests_AcceptedWheelOwnsItsStepAfterCallerTargetMutation(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 5u, Span<PopupScope>(), u64.max));
    EXPECT_TRUE(self.wheel(-0.25).pointerConsumed);
    EXPECT_FALSE(self.m_router.focus().valid());
    self.m_targets[0u].scrollStep = 120.0;
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    const ControlAction action = actionResult.value();
    EXPECT_DOUBLE_EQ(action.delta, -0.25);
    EXPECT_DOUBLE_EQ(action.step, 72.0);
    EXPECT_TRUE(self.m_router.actions().empty());
}

void VerifyUiControlInputTests_OverlappingUnrelatedControlBlocksUnderlyingWheelRouting(mut UiControlInputTests self){
    HitTarget cover = MakeUiControlInputHost(4u, 0.0f);
    cover.paintOrder = 10u;
    cover.control = ControlToken();
    cover.navigable = false;
    cover.scrollable = false;
    Array<HitTarget, 4u> targets = Array<HitTarget, 4u>();
    targets[0u] = self.m_targets[0u];
    targets[1u] = self.m_targets[1u];
    targets[2u] = self.m_targets[2u];
    targets[3u] = cover;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u, Span<PopupScope>(), u64.max));
    EXPECT_TRUE(self.wheel().pointerConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
}

void VerifyUiControlInputTests_HorizontalOnlyWheelIsConsumedWithoutVerticalMutation(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    InputEvent event = Pointer(InputEventType::PointerWheel);
    event.scrollX = 2.0;
    EXPECT_TRUE(self.send(event).pointerConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    event.position = Point(200.0f, 180.0f);
    EXPECT_FALSE(self.send(event).pointerConsumed);
}

void VerifyUiControlInputTests_SceneHeldPrimarySequenceCannotStartScrollingWhenPointerCrossesList(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    EXPECT_FALSE(self.send(Pointer(InputEventType::PrimaryDown, Point(200.0f, 180.0f))).pointerConsumed);
    EXPECT_FALSE(self.wheel().pointerConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_FALSE(self.send(Pointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_TRUE(self.wheel().pointerConsumed);
}

void VerifyUiControlInputTests_NavigationCopiesAcceptedPageSizeAndSubmissionDoesNotRepeat(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    self.focus();
    self.m_targets[0u].pageRows = 30u;
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::PageDown)).commandConsumed);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::PageDown, true)).commandConsumed);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::PageDown)).commandConsumed);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Enter)).commandConsumed);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Enter, true)).commandConsumed);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::Enter)).commandConsumed);
    const Expected<ControlAction> actionResult1 = self.take();
    ASSERT_TRUE(actionResult1.has_value());
    EXPECT_EQ(actionResult1.value().kind, ControlActionKind::PageDown);
    EXPECT_EQ(actionResult1.value().pageRows, 4u);
    const Expected<ControlAction> actionResult2 = self.take();
    ASSERT_TRUE(actionResult2.has_value());
    EXPECT_EQ(actionResult2.value().kind, ControlActionKind::PageDown);
    const Expected<ControlAction> actionResult3 = self.take();
    ASSERT_TRUE(actionResult3.has_value());
    EXPECT_EQ(actionResult3.value().kind, ControlActionKind::Submit);
    EXPECT_FALSE(self.take().has_value());
}

void VerifyUiControlInputTests_HeldNavigationCannotRetargetAnotherFocusedList(mut UiControlInputTests self){
    const HitTarget second = MakeUiControlInputHost(4u, 140.0f);
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = self.m_targets[0u];
    targets[1u] = second;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u, Span<PopupScope>(), u64.max));
    self.focus();
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Down)).commandConsumed);
    ASSERT_TRUE(self.take().has_value());
    self.focus();
    EXPECT_EQ(self.m_router.focus(), second.id);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Down, true)).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::Down)).commandConsumed);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Down)).commandConsumed);
    const Expected<ControlAction> actionResult2 = self.m_router.consumeControlAction(second.id, second.declarationGeneration, second.control);
    ASSERT_TRUE(actionResult2.has_value());
    EXPECT_EQ(actionResult2.value().kind, ControlActionKind::Down);
}

void VerifyUiControlInputTests_ReplacedContentFencesCaptureActionsAndFocusUntilAcceptance(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    self.click();
    EXPECT_TRUE(self.wheel().pointerConsumed);
    EXPECT_TRUE(self.send(Pointer(InputEventType::PrimaryDown)).pointerConsumed);
    const usize pending = self.m_router.controlActions().size();
    ASSERT_GT(pending, 0u);
    ASSERT_EQ(self.m_router.capture(), self.m_targets[1u].id);
    self.m_router.fenceControl(self.m_targets[0u].id, self.m_targets[0u].declarationGeneration, self.m_targets[0u].control);
    EXPECT_EQ(self.m_router.capture(), self.m_targets[1u].id);
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_EQ(self.m_router.controlActions().size(), pending);
    self.revise();
    self.m_router.fenceControl(self.m_targets[0u].id, self.m_targets[0u].declarationGeneration, self.m_targets[0u].control);
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.send(Pointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u, Span<PopupScope>(), u64.max));
    self.click();
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_EQ(actionResult.value().control.contentRevision, 32u);
}

void VerifyUiControlInputTests_CommitOfNewEpochRejectsOldPressWithoutLeakingItsRelease(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    EXPECT_TRUE(self.send(Pointer(InputEventType::PrimaryDown)).pointerConsumed);
    self.revise();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u, Span<PopupScope>(), u64.max));
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.send(Pointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
}

void VerifyUiControlInputTests_ReplacedRowDeclarationRejectsItsQueuedClickWhileHostWheelSurvives(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    self.click();
    EXPECT_TRUE(self.wheel().pointerConsumed);
    ++self.m_targets[1u].declarationGeneration;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u, Span<PopupScope>(), u64.max));
    const Expected<ControlAction> actionResult1 = self.take();
    ASSERT_TRUE(actionResult1.has_value());
    EXPECT_EQ(actionResult1.value().kind, ControlActionKind::Wheel);
    EXPECT_FALSE(self.take().has_value());
    self.click();
    const Expected<ControlAction> actionResult2 = self.take();
    ASSERT_TRUE(actionResult2.has_value());
    EXPECT_EQ(actionResult2.value().kind, ControlActionKind::Activate);
    EXPECT_EQ(actionResult2.value().sourceDeclarationGeneration, self.m_targets[1u].declarationGeneration);
    EXPECT_FALSE(self.take().has_value());
}

void VerifyUiControlInputTests_RemovedRowRejectsItsQueuedStableValueWhileHostWheelSurvives(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    self.click();
    EXPECT_TRUE(self.wheel().pointerConsumed);
    self.m_router.invalidateTarget(self.m_targets[1u].id);
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_EQ(actionResult.value().kind, ControlActionKind::Wheel);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_EQ(self.m_router.targets().size(), 2u);
}

void VerifyUiControlInputTests_HostRetirementRemovesPartsAndGesturesButPreservesHeldOwnership(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    self.click();
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Down)).commandConsumed);
    EXPECT_TRUE(self.send(Pointer(InputEventType::PrimaryDown, Point(95.0f, 25.0f))).pointerConsumed);
    self.m_router.invalidateTarget(self.m_targets[0u].id);
    EXPECT_TRUE(self.m_router.targets().empty());
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_FALSE(self.m_router.consumePointerGesture(self.m_targets[2u].id, 7u).has_value());
    EXPECT_TRUE(self.send(Pointer(InputEventType::PrimaryUp, Point(95.0f, 25.0f))).pointerConsumed);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::Down)).commandConsumed);
}

void VerifyUiControlInputTests_ThumbGestureRetainsAcceptedTrackAndMaximumAcrossResize(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    EXPECT_TRUE(self.send(Pointer(InputEventType::PrimaryDown, Point(95.0f, 25.0f))).pointerConsumed);
    const Expected<PointerGesture> gestureResult1 = self.m_router.consumePointerGesture(self.m_targets[2u].id, 7u);
    ASSERT_TRUE(gestureResult1.has_value());
    PointerGesture gesture = gestureResult1.value();
    EXPECT_EQ(gesture.control, self.m_targets[0u].control);
    EXPECT_DOUBLE_EQ(gesture.maximum, 2399900.0);
    EXPECT_FLOAT_EQ(gesture.referenceRectangle.height, 100.0f);
    self.m_targets[2u].gestureMaximum = 1000.0;
    self.m_targets[2u].gestureReference.height = 150.0f;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u, Span<PopupScope>(), u64.max));
    EXPECT_TRUE(self.send(Pointer(InputEventType::PointerMove, Point(95.0f, 50.0f))).pointerConsumed);
    const Expected<PointerGesture> gestureResult2 = self.m_router.consumePointerGesture(self.m_targets[2u].id, 7u);
    ASSERT_TRUE(gestureResult2.has_value());
    gesture = gestureResult2.value();
    EXPECT_DOUBLE_EQ(gesture.maximum, 2399900.0);
    EXPECT_FLOAT_EQ(gesture.referenceRectangle.height, 100.0f);
    EXPECT_EQ(gesture.id.layoutGeneration, 1u);
}

void VerifyUiControlInputTests_ChangedThumbEpochRejectsAQueuedCompletedGesture(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    EXPECT_TRUE(self.send(Pointer(InputEventType::PrimaryDown, Point(95.0f, 25.0f))).pointerConsumed);
    EXPECT_TRUE(self.send(Pointer(InputEventType::PrimaryUp, Point(95.0f, 30.0f))).pointerConsumed);
    self.revise();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u, Span<PopupScope>(), u64.max));
    EXPECT_FALSE(self.m_router.consumePointerGesture(self.m_targets[2u].id, 7u).has_value());
}

void VerifyUiControlInputTests_FocusHintRestoresReplacedHostOnlyAtMatchingAcceptance(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    self.focus();
    self.revise();
    self.m_targets[0u].focusOnCommit = true;
    self.m_router.fenceControl(self.m_targets[0u].id, 7u, self.m_targets[0u].control);
    EXPECT_FALSE(self.m_router.focus().valid());
    const Vector<PopupScope> noPopups = Vector<PopupScope>();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u, noPopups, self.m_router.focusLossGeneration()));
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
}

void VerifyUiControlInputTests_FocusHintCannotStealAnotherFocusOrSurviveDelayedFocusLoss(mut UiControlInputTests self){
    const HitTarget second = MakeUiControlInputHost(4u, 140.0f);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(second), 1u, Span<PopupScope>(), u64.max));
    self.click(Point(150.0f, 30.0f));
    self.m_targets[0u].focusOnCommit = true;
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = self.m_targets[0u];
    targets[1u] = second;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 2u, Span<PopupScope>(), u64.max));
    EXPECT_EQ(self.m_router.focus(), second.id);
    const u64 preparedFocusLoss = self.m_router.focusLossGeneration();
    InputEvent focusLost = InputEvent();
    focusLost.type = InputEventType::FocusLost;
    EXPECT_TRUE(self.send(focusLost).commandConsumed);
    InputEvent focusGained = InputEvent();
    focusGained.type = InputEventType::FocusGained;
    EXPECT_FALSE(self.send(focusGained).commandConsumed);
    const Vector<PopupScope> noPopups = Vector<PopupScope>();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 3u, noPopups, preparedFocusLoss));
    EXPECT_FALSE(self.m_router.focus().valid());
}

void VerifyUiControlInputTests_RepeatedNavigationDoesNotJumpToAcceptedReplacementEpoch(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    self.focus();
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Down)).commandConsumed);
    self.revise();
    self.m_targets[0u].focusOnCommit = true;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u, Span<PopupScope>(), u64.max));
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Down, true)).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::Down)).commandConsumed);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Down)).commandConsumed);
    ASSERT_TRUE(self.take().has_value());
}

void VerifyUiControlInputTests_InvalidOwnerReferencesRejectAtomicPublicationAndPreserveActions(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    self.click();
    ++self.m_targets[1u].ownerDeclarationGeneration;
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 2u, Span<PopupScope>(), u64.max));
    EXPECT_EQ(self.m_router.layoutGeneration(), 1u);
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    ASSERT_TRUE(self.take().has_value());
}

void VerifyUiControlInputTests_MalformedControlMetadataRejectsPublicationBeforeChangingFocus(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    self.focus();
    const HitTarget host = self.m_targets[0u];
    self.m_targets[0u].control.contentRevision = 0u;
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 2u, Span<PopupScope>(), u64.max));
    self.m_targets[0u] = host;
    self.m_targets[0u].scrollStep = bit_cast<f64>(cast<u64>(0x7ff8000000000000u));
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 2u, Span<PopupScope>(), u64.max));
    self.m_targets[0u] = host;
    self.m_targets[0u].pageRows = 0u;
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 2u, Span<PopupScope>(), u64.max));
    self.m_targets[0u] = host;
    self.m_targets[0u].gestureMaximum = -1.0;
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 2u, Span<PopupScope>(), u64.max));
    EXPECT_EQ(self.m_router.focus(), host.id);
    EXPECT_EQ(self.m_router.layoutGeneration(), 1u);
}

void VerifyUiControlInputTests_MissingDisabledOrFocusablePartOwnerIsRejected(mut UiControlInputTests self){
    EXPECT_FALSE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(self.m_targets[1u]), 1u, Span<PopupScope>(), u64.max));
    self.m_targets[0u].enabled = false;
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    self.m_targets[0u].enabled = true;
    self.m_targets[1u].focusable = true;
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    self.m_targets[1u].focusable = false;
    ++self.m_targets[1u].control.instanceGeneration;
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    EXPECT_TRUE(self.m_router.targets().empty());
}

void VerifyUiControlInputTests_InvalidWheelCoordinatesAndDeltasNeverReachAcceptedActions(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    InputEvent event = Pointer(InputEventType::PointerWheel);
    event.scrollY = bit_cast<f64>(cast<u64>(0x7ff8000000000000u));
    EXPECT_FALSE(self.queueNative(event));
    event.scrollY = -1.0;
    event.scrollX = bit_cast<f64>(cast<u64>(0x7ff0000000000000u));
    EXPECT_FALSE(self.queueNative(event));
    event.scrollX = 0.0;
    event.position.x = bit_cast<f32>(0x7fc00000u);
    EXPECT_FALSE(self.queueNative(event));
    EXPECT_TRUE(self.m_router.controlActions().empty());
}

void VerifyUiControlInputTests_BoundedControlActionsUseOneSharedSequenceAndOverflowOncePerProcess(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    for(usize index = 0u; index < s_InputMaxControlActions; ++index)
        EXPECT_FALSE(self.wheel().activationOverflow);
    EXPECT_TRUE(self.wheel().activationOverflow);
    EXPECT_EQ(self.m_router.controlActions().size(), s_InputMaxControlActions);
    EXPECT_FALSE(self.m_router.process().activationOverflow);
    u64 previousSequence = 0u;
    for(usize index = 0u; index < s_InputMaxControlActions; ++index){
        const Expected<ControlAction> actionResult1 = self.take();
        ASSERT_TRUE(actionResult1.has_value());
        EXPECT_GT(actionResult1.value().id.sequence, previousSequence);
        previousSequence = actionResult1.value().id.sequence;
    }
    EXPECT_FALSE(self.take().has_value());
    EXPECT_FALSE(self.wheel().activationOverflow);
    const Expected<ControlAction> actionResult2 = self.take();
    ASSERT_TRUE(actionResult2.has_value());
    EXPECT_GT(actionResult2.value().id.sequence, previousSequence);
}

void VerifyUiControlInputTests_FocusLossCancelsActionsAndResetDoesNotRestartTheirSequence(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    EXPECT_TRUE(self.wheel().pointerConsumed);
    const u64 previousSequence = self.m_router.controlActions()[0u].id.sequence;
    self.focus();
    InputEvent focusLost = InputEvent();
    focusLost.type = InputEventType::FocusLost;
    EXPECT_TRUE(self.send(focusLost).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    self.m_router.reset();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    EXPECT_TRUE(self.wheel().pointerConsumed);
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_GT(actionResult.value().id.sequence, previousSequence);
}

void VerifyUiControlInputTests_AcceptedPopupMaskOwnsWheelAndListFocusAboveLowerHosts(mut UiControlInputTests self){
    PopupScope popup = PopupScope();
    popup.token.widget.value = 10u;
    popup.token.declarationGeneration = 5u;
    popup.token.instanceGeneration = 6u;
    popup.token.openGeneration = 7u;
    popup.bounds = Rect(140.0f, 0.0f, 100.0f, 100.0f);
    popup.viewport = self.m_targets[0u].clip;
    popup.layer = 1u;
    HitTarget barrier = HitTarget();
    barrier.id = popup.token.widget;
    barrier.declarationGeneration = popup.token.declarationGeneration;
    barrier.rectangle = popup.bounds;
    barrier.clip = popup.viewport;
    barrier.popup = popup.token;
    barrier.layer = popup.layer;
    HitTarget upper = MakeUiControlInputHost(4u, 140.0f);
    upper.popup = popup.token;
    upper.layer = popup.layer;
    upper.paintOrder = 1u;
    Array<HitTarget, 3u> targets = Array<HitTarget, 3u>();
    targets[0u] = self.m_targets[0u];
    targets[1u] = barrier;
    targets[2u] = upper;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u, MakeUiSinglePopupScopeArray(popup), u64.max));
    EXPECT_EQ(self.m_router.focus(), upper.id);
    EXPECT_TRUE(self.wheel().pointerConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.wheel(-1.0, Point(150.0f, 20.0f)).pointerConsumed);
    const Expected<ControlAction> actionResult = self.m_router.consumeControlAction(upper.id, upper.declarationGeneration, upper.control);
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_EQ(actionResult.value().popup, popup.token);
    EXPECT_EQ(actionResult.value().kind, ControlActionKind::Wheel);
}

void VerifyUiControlInputTests_ClosingPopupBlocksFocusHintAndHeldNavigationCannotReachReopenedScope(mut UiControlInputTests self){
    PopupScope popup = PopupScope();
    popup.token.widget.value = 10u;
    popup.token.declarationGeneration = 5u;
    popup.token.instanceGeneration = 6u;
    popup.token.openGeneration = 7u;
    popup.bounds = Rect(140.0f, 0.0f, 100.0f, 100.0f);
    popup.viewport = self.m_targets[0u].clip;
    popup.layer = 1u;
    HitTarget barrier = HitTarget();
    barrier.id = popup.token.widget;
    barrier.declarationGeneration = popup.token.declarationGeneration;
    barrier.rectangle = popup.bounds;
    barrier.clip = popup.viewport;
    barrier.popup = popup.token;
    barrier.layer = popup.layer;
    HitTarget upper = MakeUiControlInputHost(4u, 140.0f);
    upper.popup = popup.token;
    upper.layer = popup.layer;
    upper.paintOrder = 1u;
    self.m_targets[0u].focusOnCommit = true;
    Array<HitTarget, 3u> targets = Array<HitTarget, 3u>();
    targets[0u] = self.m_targets[0u];
    targets[1u] = barrier;
    targets[2u] = upper;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u, MakeUiSinglePopupScopeArray(popup), u64.max));
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Down)).commandConsumed);
    self.m_router.closePopup(popup.token);
    ASSERT_TRUE(self.m_router.commitTargets(targets, 2u, MakeUiSinglePopupScopeArray(popup), u64.max));
    EXPECT_FALSE(self.m_router.focus().valid());
    ++popup.token.openGeneration;
    targets[1u].popup = popup.token;
    targets[2u].popup = popup.token;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 3u, MakeUiSinglePopupScopeArray(popup), u64.max));
    EXPECT_EQ(self.m_router.focus(), upper.id);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Down, true)).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::Down)).commandConsumed);
}

void VerifyUiControlInputTests_ActivationAlsoFencesItsCopiedControlEpoch(mut UiControlInputTests self){
    HitTarget target = MakeUiControlInputHost(1u, 0.0f);
    target.navigable = false;
    target.scrollable = false;
    target.activatable = true;
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(target), 1u, Span<PopupScope>(), u64.max));
    self.click();
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_EQ(self.m_router.actions()[0u].control, target.control);
    ++target.control.instanceGeneration;
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(target), 2u, Span<PopupScope>(), u64.max));
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
}

void VerifyUiControlInputTests_ControlActivationAndGestureActionsShareOneMonotonicSequence(mut UiControlInputTests self){
    HitTarget button = MakeUiControlInputHost(4u, 140.0f);
    button.control = ControlToken();
    button.navigable = false;
    button.scrollable = false;
    button.activatable = true;
    Array<HitTarget, 4u> targets = Array<HitTarget, 4u>();
    targets[0u] = self.m_targets[0u];
    targets[1u] = self.m_targets[1u];
    targets[2u] = self.m_targets[2u];
    targets[3u] = button;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u, Span<PopupScope>(), u64.max));
    self.click(Point(150.0f, 10.0f));
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    const u64 activationSequence = self.m_router.actions()[0u].id.sequence;
    EXPECT_TRUE(self.wheel().pointerConsumed);
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_GT(actionResult.value().id.sequence, activationSequence);
    const u64 wheelSequence = actionResult.value().id.sequence;
    EXPECT_TRUE(self.send(Pointer(InputEventType::PrimaryDown, Point(95.0f, 25.0f))).pointerConsumed);
    const Expected<PointerGesture> gestureResult = self.m_router.consumePointerGesture(self.m_targets[2u].id, 7u);
    ASSERT_TRUE(gestureResult.has_value());
    EXPECT_GT(gestureResult.value().id.sequence, wheelSequence);
}

void VerifyUiControlInputTests_NativeUnfocusedAcceptanceCannotApplyAControlFocusHint(mut UiControlInputTests self){
    InputEvent focusLost = InputEvent();
    focusLost.type = InputEventType::FocusLost;
    EXPECT_FALSE(self.send(focusLost).commandConsumed);
    self.m_targets[0u].focusOnCommit = true;
    const Vector<PopupScope> noPopups = Vector<PopupScope>();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, noPopups, self.m_router.focusLossGeneration()));
    EXPECT_FALSE(self.m_router.focus().valid());
}

void VerifyUiControlInputTests_RetiredHeldKeyOwnerCannotReviveWhenItsOriginalTokenReturns(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    self.focus();
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Down)).commandConsumed);
    const ControlToken original = self.m_targets[0u].control;
    self.revise();
    self.m_targets[0u].focusOnCommit = true;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u, Span<PopupScope>(), u64.max));
    for(mut HitTarget target : self.m_targets)
        target.control = original;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 3u, Span<PopupScope>(), u64.max));
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Down, true)).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::Down)).commandConsumed);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Down)).commandConsumed);
    ASSERT_TRUE(self.take().has_value());
}

void VerifyUiControlInputTests_GestureUpdateSequenceOrdersLatestMotionAfterAnInterveningWheel(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    EXPECT_TRUE(self.send(Pointer(InputEventType::PrimaryDown, Point(95.0f, 25.0f))).pointerConsumed);
    const Expected<PointerGesture> initialResult = self.m_router.consumePointerGesture(self.m_targets[2u].id, 7u);
    ASSERT_TRUE(initialResult.has_value());
    const PointerGesture initial = initialResult.value();
    EXPECT_EQ(initial.updateSequence, initial.id.sequence);
    EXPECT_TRUE(self.wheel(1.0, Point(95.0f, 25.0f)).pointerConsumed);
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    const ControlAction action = actionResult.value();
    EXPECT_GT(action.id.sequence, initial.updateSequence);
    EXPECT_TRUE(self.send(Pointer(InputEventType::PointerMove, Point(95.0f, 70.0f))).pointerConsumed);
    const Expected<PointerGesture> movedResult = self.m_router.consumePointerGesture(self.m_targets[2u].id, 7u);
    ASSERT_TRUE(movedResult.has_value());
    const PointerGesture moved = movedResult.value();
    EXPECT_EQ(moved.id.sequence, initial.id.sequence);
    EXPECT_GT(moved.updateSequence, action.id.sequence);
    EXPECT_TRUE(self.send(Pointer(InputEventType::PrimaryUp, Point(95.0f, 70.0f))).pointerConsumed);
    const Expected<PointerGesture> completedResult = self.m_router.consumePointerGesture(self.m_targets[2u].id, 7u);
    ASSERT_TRUE(completedResult.has_value());
    const PointerGesture completed = completedResult.value();
    EXPECT_GT(completed.updateSequence, moved.updateSequence);
    EXPECT_EQ(completed.id.sequence, initial.id.sequence);
    EXPECT_EQ(completed.state, PointerGestureState::Completed);
}

void VerifyUiControlInputTests_EscapeAndControlRebindingCancelHeldSubmitWithoutReleaseLeakage(mut UiControlInputTests self){
    self.m_targets[0u].focusOnCommit = true;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u, Span<PopupScope>(), u64.max));
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Enter)).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Escape)).commandConsumed);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::Escape)).commandConsumed);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::Enter)).commandConsumed);
    EXPECT_FALSE(self.take().has_value());
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u, Span<PopupScope>(), u64.max));
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Enter)).commandConsumed);
    const ControlToken original = self.m_targets[0u].control;
    self.revise();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 3u, Span<PopupScope>(), u64.max));
    for(mut HitTarget target : self.m_targets)
        target.control = original;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 4u, Span<PopupScope>(), u64.max));
    EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::Enter)).commandConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Enter)).commandConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::Enter)).commandConsumed);
    const Expected<ControlAction> action = self.take();
    ASSERT_TRUE(action.has_value());
    EXPECT_EQ(action.value().kind, ControlActionKind::Submit);
}

void VerifyEditBoxLayoutTests_LigaturesExposeEachGraphemeCaretAndPartialSelection(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.setText("ffi"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 2u));
    ASSERT_TRUE(self.shapeView());
    ASSERT_EQ(self.m_view.layout().clusters().size(), 1u);
    ASSERT_EQ(self.m_view.caretStops().size(), 4u);
    for(usize index = 0u; index < 4u; ++index){
        EXPECT_EQ(self.m_view.caretStops()[index].committedByte, index);
        EXPECT_FLOAT_EQ(self.m_view.caretStops()[index].x, cast<f32>(index) * 10.0f);
    }
    ASSERT_TRUE(self.place());
    EXPECT_FLOAT_EQ(self.m_placement.caret.x, 30.0f);
    const Expected<Rect> selection = self.rangeRect(self.m_view.selectionRange());
    ASSERT_TRUE(selection.has_value());
    EXPECT_FLOAT_EQ(selection.value().x, 20.0f);
    EXPECT_FLOAT_EQ(selection.value().width, 10.0f);
    Expected<usize> hit = self.m_view.hitTest(Point(21.0f, 24.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 1u);
    hit = self.m_view.hitTest(Point(27.0f, 24.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 2u);
}

void VerifyEditBoxLayoutTests_CombiningAndDecomposedHangulHitsStayOnWholeGraphemes(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.setText("A\314\201B"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    ASSERT_EQ(self.m_view.caretStops().size(), 3u);
    EXPECT_EQ(self.m_view.caretStops()[1u].committedByte, 3u);
    Expected<usize> hit = self.m_view.hitTest(Point(14.9f, 24.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 0u);
    hit = self.m_view.hitTest(Point(15.1f, 24.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 3u);
    ASSERT_TRUE(self.m_model.setText("\xe1\x84\x92\xe1\x85\xa1\xe1\x86\xab"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    ASSERT_EQ(self.m_view.caretStops().size(), 2u);
    EXPECT_EQ(self.m_view.caretStops()[1u].committedByte, 9u);
    hit = self.m_view.hitTest(Point(17.0f, 24.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 9u);
}

void VerifyEditBoxLayoutTests_PreeditReplacesOnlyTheDisplayAndOwnsItsSelectionAndUnderline(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.setText("ABC"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 2u));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("\xed\x95\x9c\xea\xb8\x80", 0u, 3u, Span<EditPreeditClause>()));
    ASSERT_TRUE(self.shapeView());
    EXPECT_EQ(self.m_model.text(), "ABC");
    EXPECT_EQ(self.m_view.displayText(), "A\355\225\234\352\270\200C");
    EXPECT_EQ(self.m_view.preeditRange().begin, 1u);
    EXPECT_EQ(self.m_view.preeditRange().end, 7u);
    EXPECT_EQ(self.m_view.displayCaret(), 4u);
    EXPECT_EQ(self.m_view.selectionRange().begin, 1u);
    EXPECT_EQ(self.m_view.selectionRange().end, 4u);
    ASSERT_EQ(self.m_view.caretStops().size(), 4u);
    EXPECT_EQ(self.m_view.caretStops()[2u].committedByte, 2u);
    EXPECT_EQ(self.m_view.caretStops()[2u].displayByte, 7u);
    ASSERT_TRUE(self.place());
    const Expected<Rect> selection = self.rangeRect(self.m_view.selectionRange());
    ASSERT_TRUE(selection.has_value());
    const Expected<Rect> preedit = self.rangeRect(self.m_view.preeditRange());
    ASSERT_TRUE(preedit.has_value());
    EXPECT_FLOAT_EQ(selection.value().x, 20.0f);
    EXPECT_FLOAT_EQ(selection.value().width, 10.0f);
    EXPECT_FLOAT_EQ(preedit.value().x, 20.0f);
    EXPECT_FLOAT_EQ(preedit.value().width, 20.0f);
    const VectorSingle caretW(self.m_placement.caret.width);
    const VectorSingle preeditH(preedit.value().height);
    EXPECT_FLOAT_EQ(VectorSelect(preeditH, caretW, VectorLess(caretW, preeditH)).x, 1.0f);
    const Expected<usize> hit = self.m_view.hitTest(Point(39.0f, 24.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 2u);
    self.m_model.cancelComposition();
    ASSERT_TRUE(self.m_model.setText("changed"));
    EXPECT_EQ(self.m_view.displayText(), "A\355\225\234\352\270\200C");
    EXPECT_TRUE(self.m_view.composing());
}

void VerifyEditBoxLayoutTests_NativePreeditCaretCanAddressScalarEdgesInsideOneGrapheme(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("\xe1\x84\x92\xe1\x85\xa1\xe1\x86\xab", 3u, 6u, Span<EditPreeditClause>()));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    EXPECT_FLOAT_EQ(self.m_placement.caret.x, 18.0f);
    const Expected<Rect> selection = self.rangeRect(self.m_view.selectionRange());
    ASSERT_TRUE(selection.has_value());
    const Expected<Rect> preedit = self.rangeRect(self.m_view.preeditRange());
    ASSERT_TRUE(preedit.has_value());
    EXPECT_FLOAT_EQ(selection.value().x, 14.0f);
    EXPECT_FLOAT_EQ(selection.value().width, 4.0f);
    EXPECT_FLOAT_EQ(preedit.value().width, 12.0f);
    ASSERT_EQ(self.m_view.caretStops().size(), 2u);
    EXPECT_EQ(self.m_view.caretStops()[0u].committedByte, 0u);
    EXPECT_EQ(self.m_view.caretStops()[1u].committedByte, 0u);
}

void VerifyEditBoxLayoutTests_HorizontalScrollFollowsCaretAndClampsWhenTextShrinks(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.setText("abcdef"));
    ASSERT_TRUE(self.shapeView());
    const Expected<EditBoxPlacement> arranged = self.m_view.arrange(
        Rect(10.0f, 20.0f, 26.0f, 20.0f),
        Insets(3.0f, 0.0f, 3.0f, 0.0f),
        Rect(0.0f, 0.0f, 500.0f, 500.0f),
        Point(), 1.0f, true
    );
    ASSERT_TRUE(arranged.has_value());
    self.m_placement = arranged.value();
    EXPECT_FLOAT_EQ(self.m_placement.content.x, 13.0f);
    EXPECT_FLOAT_EQ(self.m_placement.content.width, 20.0f);
    EXPECT_FLOAT_EQ(self.m_placement.scroll, 41.0f);
    EXPECT_FLOAT_EQ(self.m_placement.caret.x + self.m_placement.caret.width, 33.0f);
    ASSERT_TRUE(self.m_model.move(EditMove::Home));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place(20.0f, 41.0f));
    EXPECT_FLOAT_EQ(self.m_placement.scroll, 0.0f);
    EXPECT_FLOAT_EQ(self.m_placement.caret.x, 10.0f);
    ASSERT_TRUE(self.m_model.setText("A"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place(20.0f, 41.0f));
    EXPECT_FLOAT_EQ(self.m_placement.scroll, 0.0f);
}

void VerifyEditBoxLayoutTests_PlacementIntersectsFrameAndContentClipsAndRejectsInvalidInputs(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.setText("abc"));
    ASSERT_TRUE(self.shapeView());
    const Expected<EditBoxPlacement> arranged = self.m_view.arrange(
        Rect(10.0f, 20.0f, 100.0f, 30.0f),
        Insets(8.0f, 4.0f, 8.0f, 4.0f),
        Rect(30.0f, 22.0f, 20.0f, 40.0f),
        Point(), 1.0f, true
    );
    ASSERT_TRUE(arranged.has_value());
    self.m_placement = arranged.value();
    EXPECT_FLOAT_EQ(self.m_placement.frameClip.x, 30.0f);
    EXPECT_FLOAT_EQ(self.m_placement.frameClip.y, 22.0f);
    EXPECT_FLOAT_EQ(self.m_placement.frameClip.height, 28.0f);
    EXPECT_FLOAT_EQ(self.m_placement.clip.y, 24.0f);
    EXPECT_FLOAT_EQ(self.m_placement.clip.height, 22.0f);
    EXPECT_FALSE(self.m_view.arrange(Rect(0.0f, 0.0f, -1.0f, 20.0f), Insets(), Rect(), Point(), 1.0f, true).has_value());
    EXPECT_FALSE(self.m_view.arrange(Rect(0.0f, 0.0f, 20.0f, 20.0f), Insets(-1.0f, 0.0f, 0.0f, 0.0f), Rect(), Point(), 1.0f, true).has_value());
    EXPECT_FALSE(self.m_view.arrange(Rect(0.0f, 0.0f, 20.0f, 20.0f), Insets(), Rect(), Point(bit_cast<f32>(0x7fc00000u), 0.0f), 1.0f, true).has_value());
    EXPECT_FALSE(self.m_view.hitTest(Point(bit_cast<f32>(0x7fc00000u), 0.0f), self.m_placement).has_value());
}

void VerifyEditBoxLayoutTests_MismatchedAndRtlLayoutsPreserveTheAdmittedGeometry(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.setText("abc"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    const f32 oldCaret = self.m_placement.caret.x;
    EXPECT_FALSE(self.tryAdoptBuiltLayout("other"));
    EXPECT_EQ(self.m_view.layout().utf8(), "abc");
    ShapeRequest request = ShapeRequest();
    request.text = "abc";
    request.direction = cast<TextDirection>(99u);
    TextService service = TextService();
    EXPECT_EQ(self.m_view.shape(service, request), TextLayoutStatus::InvalidParameters);
    EXPECT_EQ(self.m_view.layout().utf8(), "abc");
    ASSERT_TRUE(self.tryAdoptBuiltLayout("abc", TextDirection::RightToLeft));
    ASSERT_TRUE(self.place());
    EXPECT_NE(self.m_placement.caret.x, oldCaret);
}

void VerifyEditBoxLayoutTests_SnapshotOwnsModelBytesAndReshapingRejectsUnsupportedSingleLineControls(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.setText("owned"));
    ASSERT_TRUE(self.shapeView());
    const u64 revision = self.m_view.revision();
    ASSERT_TRUE(self.m_model.setText("replacement"));
    EXPECT_EQ(self.m_view.displayText(), "owned");
    EXPECT_EQ(self.m_view.layout().utf8(), "owned");
    EXPECT_EQ(self.m_view.revision(), revision);
    EditBoxView moved = EditBoxView();
    self.moveViewTo(moved);
    EXPECT_EQ(moved.displayText(), "owned");
    EXPECT_EQ(moved.layout().utf8(), "owned");
    EXPECT_TRUE(moved.ready());
    ASSERT_TRUE(self.m_model.setText("A\tB"));
    ASSERT_TRUE(moved.snapshot(self.m_model));
    EXPECT_FALSE(moved.ready());
    TextService service = TextService();
    EXPECT_EQ(moved.shape(service, ShapeRequest()), TextLayoutStatus::FontFailure);
    ASSERT_TRUE(self.m_model.setText("A\x01B"));
    ASSERT_TRUE(moved.snapshot(self.m_model));
    EXPECT_FALSE(moved.ready());
    EXPECT_EQ(moved.shape(service, ShapeRequest()), TextLayoutStatus::UnsupportedControl);
    EXPECT_FALSE(moved.arrange(Rect(), Insets(), Rect(), Point(), 1.0f, true).has_value());
}

void VerifyEditBoxLayoutTests_EmptyTextKeepsOneCaretAndCanPaintWithoutAFontOrEditSkinRegion(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    ASSERT_EQ(self.m_view.caretStops().size(), 1u);
    EXPECT_FLOAT_EQ(self.m_placement.caret.x, 10.0f);
    EXPECT_FLOAT_EQ(self.m_placement.caret.height, 12.0f);
    UiSkin skin = UiSkin(s_UiEditBoxSkinAssetName);
    self.configureSkin(skin);
    PaintBuilder paint = PaintBuilder();
    TextService service = TextService();
    EditBoxPaintFlags flags = EditBoxPaintFlags();
    flags.focused = true;
    flags.caretVisible = false;
    const EditBoxStyle style = EditBoxStyle();
    self.beginSkinPaint(paint, skin, 1u);
    ASSERT_TRUE(self.m_view.paint(service, paint, skin, self.m_placement, style, flags, Optional<in TextLayout>()));
    EXPECT_EQ(paint.freeze().vertices().size(), 4u);
    flags.caretVisible = true;
    self.beginSkinPaint(paint, skin, 2u);
    ASSERT_TRUE(self.m_view.paint(service, paint, skin, self.m_placement, style, flags, Optional<in TextLayout>()));
    EXPECT_EQ(paint.freeze().vertices().size(), 8u);
    flags.readOnly = true;
    self.beginSkinPaint(paint, skin, 3u);
    ASSERT_TRUE(self.m_view.paint(service, paint, skin, self.m_placement, style, flags, Optional<in TextLayout>()));
    EXPECT_EQ(paint.freeze().vertices().size(), 4u);
}

void VerifyEditBoxLayoutTests_EmptySelectionRejectsInvalidCaretWidthsAndRestoresClippingWithoutADrawnCaret(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    UiSkin skin = UiSkin(s_UiEditBoxSkinAssetName);
    self.configureSkin(skin);
    PaintBuilder paint = PaintBuilder();
    TextService service = TextService();
    EditBoxPaintFlags flags = EditBoxPaintFlags();
    flags.focused = true;
    flags.caretVisible = false;
    const EditBoxStyle style = EditBoxStyle();
    u64 generation = 0u;
    Array<f32, 3u> widths = Array<f32, 3u>();
    widths[0u] = -1.0f;
    widths[1u] = bit_cast<f32>(0x7fc00000u);
    widths[2u] = bit_cast<f32>(0x7f800000u);
    for(in f32 width : widths){
        EditBoxPlacement placement = self.m_placement;
        placement.caret.width = width;
        ++generation;
        self.beginSkinPaint(paint, skin, generation);
        EXPECT_FALSE(self.m_view.paint(service, paint, skin, placement, style, flags, Optional<in TextLayout>()));
        EXPECT_FALSE(paint.popClip());
        EXPECT_EQ(paint.freeze().vertices().size(), 4u);
    }
}

void VerifyEditBoxLayoutTests_EmptyPreeditSelectionStillPaintsItsUnderlineAndRestoresClipping(mut EditBoxLayoutTests self){
    Font font = Font(s_UiEditBoxFontAssetName);
    TextService service = TextService();
    ASSERT_TRUE(self.installBundledLatinFont(font, service));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("IME", 3u, 3u, Span<EditPreeditClause>()));
    ASSERT_TRUE(self.m_view.snapshot(self.m_model));
    ASSERT_EQ(self.m_view.shape(service, ShapeRequest()), TextLayoutStatus::Success);
    ASSERT_EQ(self.m_view.selectionRange().begin, self.m_view.selectionRange().end);
    const Expected<EditBoxPlacement> placement = self.m_view.arrange(
        Rect(10.0f, 20.0f, 180.0f, 80.0f),
        Insets(),
        Rect(0.0f, 0.0f, 200.0f, 120.0f),
        Point(), 1.0f, true
    );
    ASSERT_TRUE(placement.has_value());
    UiSkin skin = UiSkin(s_UiEditBoxSkinAssetName);
    self.configureSkin(skin);
    PaintBuilder paint = PaintBuilder();
    EditBoxStyle style = EditBoxStyle();
    style.preedit.r = 0.0f;
    style.preedit.g = 1.0f;
    style.preedit.b = 0.0f;
    style.preedit.a = 1.0f;
    EditBoxPaintFlags flags = EditBoxPaintFlags();
    flags.focused = true;
    flags.preeditCaretVisible = false;
    self.beginSkinPaint(paint, skin, 1u, 200.0f, 120.0f);
    ASSERT_TRUE(self.m_view.paint(service, paint, skin, placement.value(), style, flags, Optional<in TextLayout>()));
    EXPECT_FALSE(paint.popClip());
    const DrawSnapshot snapshot = paint.freeze();
    usize underlineVertices = 0u;
    for(usize index = 0u; index < snapshot.vertices().size(); ++index){
        const Vertex vertex = snapshot.vertices()[index];
        if(vertex.color.r == 0.0f && vertex.color.g == 1.0f && vertex.color.b == 0.0f && vertex.color.a == 1.0f)
            ++underlineVertices;
    }
    EXPECT_EQ(underlineVertices, 4u);
}

void VerifyEditBoxLayoutTests_PaintingRestoresClipStackAndBoundsVerticesAcrossDisplayScales(mut EditBoxLayoutTests self){
    Font font = Font(s_UiEditBoxFontAssetName);
    TextService service = TextService();
    ASSERT_TRUE(self.installBundledLatinFont(font, service));
    ASSERT_TRUE(self.m_model.setText("ffi"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 2u));
    ASSERT_TRUE(self.m_view.snapshot(self.m_model));
    ASSERT_EQ(self.m_view.shape(service, ShapeRequest()), TextLayoutStatus::Success);
    ASSERT_TRUE(self.place());
    UiSkin skin = UiSkin(s_UiEditBoxSkinAssetName);
    self.configureSkin(skin, true);
    PaintBuilder paint = PaintBuilder();
    EditBoxPaintFlags flags = EditBoxPaintFlags();
    flags.focused = true;
    const EditBoxStyle style = EditBoxStyle();
    Array<f32, 2u> scales = Array<f32, 2u>();
    scales[0u] = 1.0f;
    scales[1u] = 2.0f;
    for(in f32 scale : scales){
        self.beginSkinPaint(paint, skin, cast<u64>(scale), 200.0f, 100.0f, scale);
        ASSERT_TRUE(self.m_view.paint(service, paint, skin, self.m_placement, style, flags, Optional<in TextLayout>()));
        EXPECT_FALSE(paint.popClip());
        const DrawSnapshot snapshot = paint.freeze();
        ASSERT_FALSE(snapshot.glyphPages().empty());
        ASSERT_FALSE(snapshot.vertices().empty());
        const f32 boundsRight = self.m_placement.bounds.x + self.m_placement.bounds.width;
        for(usize index = 0u; index < snapshot.vertices().size(); ++index){
            const Vertex vertex = snapshot.vertices()[index];
            EXPECT_GE(vertex.position.x, self.m_placement.bounds.x);
            EXPECT_LE(vertex.position.x, boundsRight);
        }
    }
}

void VerifyEditBoxLayoutTests_NegativeZeroScrollClampsToPositiveZero(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.setText("abcdef"));
    ASSERT_TRUE(self.m_model.move(EditMove::Home));
    ASSERT_TRUE(self.shapeView());
    Array<b8, 2u> revealChoices = Array<b8, 2u>();
    revealChoices[0u] = false;
    revealChoices[1u] = true;
    for(in b8 revealCaret : revealChoices){
        const Expected<EditBoxPlacement> placement = self.m_view.arrange(
            Rect(10.0f, 20.0f, 26.0f, 20.0f),
            Insets(),
            Rect(0.0f, 0.0f, 500.0f, 500.0f),
            Point(-0.0f, -0.0f),
            1.0f,
            revealCaret
        );
        ASSERT_TRUE(placement.has_value());
        EXPECT_FLOAT_EQ(placement.value().scroll, 0.0f);
        EXPECT_FALSE(SignBit(placement.value().scroll));
    }
}

void VerifyEditCaretFixture_UnreadyGeometryRejectsEveryQuery(mut EditCaretFixture self){
    EXPECT_FALSE(self.m_geometry.caretRect(0u).has_value());
    EXPECT_FALSE(self.m_geometry.hitTest(Point()).has_value());
    EXPECT_FALSE(self.m_geometry.verticalTarget(0u, true, 0.0f).has_value());
    EXPECT_FALSE(self.m_geometry.rangeOnLine(EditBoxRange(), 0u, 1.0f).has_value());
}

void VerifyEditCaretFixture_HardLinesRetainEmptyAndTrailingLineStops(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("ab\n\nc\n"));
    ASSERT_EQ(self.m_geometry.lines().size(), 4u);
    ASSERT_EQ(self.m_geometry.caretStops().size(), 7u);
    Array<usize, 4u> begin = Array<usize, 4u>();
    begin[0u] = 0u;
    begin[1u] = 3u;
    begin[2u] = 4u;
    begin[3u] = 6u;
    Array<usize, 4u> end = Array<usize, 4u>();
    end[0u] = 2u;
    end[1u] = 3u;
    end[2u] = 5u;
    end[3u] = 6u;
    Array<usize, 4u> breakEnd = Array<usize, 4u>();
    breakEnd[0u] = 3u;
    breakEnd[1u] = 4u;
    breakEnd[2u] = 6u;
    breakEnd[3u] = 6u;
    Array<u32, 4u> first = Array<u32, 4u>();
    first[0u] = 0u;
    first[1u] = 3u;
    first[2u] = 4u;
    first[3u] = 6u;
    Array<u32, 4u> count = Array<u32, 4u>();
    count[0u] = 3u;
    count[1u] = 1u;
    count[2u] = 2u;
    count[3u] = 1u;
    for(u32 index = 0u; index < 4u; ++index){
        const EditCaretLine line = self.m_geometry.lines()[index];
        EXPECT_EQ(line.byteBegin, begin[index]);
        EXPECT_EQ(line.byteEnd, end[index]);
        EXPECT_EQ(line.breakEnd, breakEnd[index]);
        EXPECT_EQ(line.firstStop, first[index]);
        EXPECT_EQ(line.stopCount, count[index]);
    }
    self.expectCaret(2u, 20.0f, 0.0f);
    self.expectCaret(3u, 0.0f, 12.0f);
    self.expectCaret(4u, 0.0f, 24.0f);
    self.expectCaret(5u, 10.0f, 24.0f);
    self.expectCaret(6u, 0.0f, 36.0f);
}

void VerifyEditCaretFixture_LineBreakCaretBelongsToItsPrecedingLineAndFollowingByteStartsTheNext(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("ab\ncd"));
    self.expectCaret(2u, 20.0f, 0.0f);
    self.expectCaret(3u, 0.0f, 12.0f);
    self.expectCaret(5u, 20.0f, 12.0f);
    EXPECT_EQ(self.m_geometry.caretStops()[2u].lineIndex, 0u);
    EXPECT_EQ(self.m_geometry.caretStops()[3u].lineIndex, 1u);
}

void VerifyEditCaretFixture_MultilineHitTestingChoosesYBeforeXAndKeepsExactMidpointTies(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("ab\n\nc\n"));
    Expected<usize> byte = self.m_geometry.hitTest(Point(5.0f, 0.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 0u);
    byte = self.m_geometry.hitTest(Point(5.01f, 0.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 1u);
    byte = self.m_geometry.hitTest(Point(100.0f, 12.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 3u);
    byte = self.m_geometry.hitTest(Point(5.0f, 24.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 4u);
    byte = self.m_geometry.hitTest(Point(5.01f, 24.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 5u);
    byte = self.m_geometry.hitTest(Point(-100.0f, -100.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 0u);
    byte = self.m_geometry.hitTest(Point(100.0f, 100.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 6u);
}

void VerifyEditCaretFixture_SingleLineLigatureInterpolationAndTieBehaviorRemainUnchanged(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("ffi", EditTextMode::SingleLine));
    ASSERT_EQ(self.m_geometry.layout().clusters().size(), 1u);
    ASSERT_EQ(self.m_geometry.caretStops().size(), 4u);
    Expected<usize> byte = self.m_geometry.hitTest(Point(15.0f, -999.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 1u);
    byte = self.m_geometry.hitTest(Point(15.01f, 999.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 2u);
}

void VerifyEditCaretFixture_CombiningHitsStayOnGraphemesWhileScalarCaretQueriesRemainAvailable(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("A\314\201B", EditTextMode::SingleLine));
    ASSERT_EQ(self.m_geometry.caretStops().size(), 3u);
    EXPECT_EQ(self.m_geometry.caretStops()[1u].committedByte, 3u);
    self.expectCaret(1u, 5.0f, 0.0f);
    self.expectCaret(3u, 10.0f, 0.0f);
    Expected<usize> byte = self.m_geometry.hitTest(Point(5.0f, 0.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 0u);
    byte = self.m_geometry.hitTest(Point(5.01f, 0.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 3u);
    EXPECT_FALSE(self.m_geometry.caretRect(2u).has_value());
}

void VerifyEditCaretFixture_CollapsedPreeditRetainsBothMappedEdgesAndHangulScalarInterpolation(mut EditCaretFixture self){
    self.m_mapping.push_back(MakeUiEditCaretMapping(0u, 0u));
    self.m_mapping.push_back(MakeUiEditCaretMapping(0u, 9u));
    ASSERT_TRUE(self.adopt("\xe1\x84\x92\xe1\x85\xa1\xe1\x86\xab", 0u, EditTextMode::SingleLine));
    ASSERT_EQ(self.m_geometry.caretStops().size(), 2u);
    EXPECT_EQ(self.m_geometry.caretStops()[0u].committedByte, 0u);
    EXPECT_EQ(self.m_geometry.caretStops()[1u].committedByte, 0u);
    EXPECT_EQ(self.m_geometry.caretStops()[0u].displayByte, 0u);
    EXPECT_EQ(self.m_geometry.caretStops()[1u].displayByte, 9u);
    self.expectCaret(3u, 4.0f, 0.0f);
    self.expectCaret(6u, 8.0f, 0.0f);
    const Expected<usize> byte = self.m_geometry.hitTest(Point(11.0f, 0.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 0u);
}

void VerifyEditCaretFixture_PreeditOnlyLinesFallBackToTheClosestCommittedReplacementEdge(mut EditCaretFixture self){
    self.m_mapping.push_back(MakeUiEditCaretMapping(0u, 0u));
    self.m_mapping.push_back(MakeUiEditCaretMapping(2u, 4u));
    ASSERT_TRUE(self.adopt("A\n\nZ", 2u));
    ASSERT_EQ(self.m_geometry.lines().size(), 3u);
    EXPECT_EQ(self.m_geometry.lines()[1u].stopCount, 0u);
    EXPECT_EQ(self.m_geometry.lines()[1u].firstStop, 1u);
    Expected<usize> byte = self.m_geometry.hitTest(Point(100.0f, 13.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 0u);
    byte = self.m_geometry.hitTest(Point(-100.0f, 23.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 2u);
    byte = self.m_geometry.hitTest(Point(0.0f, 18.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 0u);
    byte = self.m_geometry.hitTest(Point(10.0f, 18.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 2u);
}

void VerifyEditCaretFixture_PreeditOnlyFallbackCannotSelectUnrelatedCommittedSuffixOrPrefixStops(mut EditCaretFixture self){
    self.m_mapping.push_back(MakeUiEditCaretMapping(0u, 0u));
    self.m_mapping.push_back(MakeUiEditCaretMapping(1u, 1u));
    self.m_mapping.push_back(MakeUiEditCaretMapping(2u, 2u));
    self.m_mapping.push_back(MakeUiEditCaretMapping(3u, 3u));
    self.m_mapping.push_back(MakeUiEditCaretMapping(4u, 8u));
    self.m_mapping.push_back(MakeUiEditCaretMapping(5u, 9u));
    self.m_mapping.push_back(MakeUiEditCaretMapping(6u, 10u));
