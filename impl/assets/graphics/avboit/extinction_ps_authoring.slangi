#ifndef NWB_GRAPHICS_AVBOIT_EXTINCTION_PS_AUTHORING_SLANGI
#define NWB_GRAPHICS_AVBOIT_EXTINCTION_PS_AUTHORING_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// AVBOIT-extinction authoring: engine owns entry + splat math; alpha comes from the shared surface hook
// (surface.renderCoverage), so all passes agree. Minimal alpha-only context (no scene/lighting/BXDF).


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "material_alpha_context_authoring.slangi"

#include "material_alpha_authoring.slangi"
#include "extinction_splat.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void main(NwbAvboitMaterialAlphaPixelInput input){
    half alpha;
    if(!nwbAvboitLoadAcceptedMaterialAlpha(input, alpha))
        discard;

    const uint2 lowPixel = nwbAvboitLowPixelFromLowFragCoord(input.position.xy);
    const float extinction = nwbAvboitExtinctionFromAlpha(alpha);
    nwbAvboitSplatExtinctionFromDepth(lowPixel, input.position.z, extinction);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#undef g_NwbDeferredBindlessResources


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

