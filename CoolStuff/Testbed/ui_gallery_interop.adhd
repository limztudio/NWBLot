b8 DeclareSelectedKeyLabel(mut Builder ui, mut ScratchArena scratchArena, in u64 selectedKey){
    b8 declared = false;
    native(mut ui, mut scratchArena, in selectedKey, mut declared){
        const auto text = StringFormat(scratchArena, s_SelectedTextFormat, selectedKey);
        declared = ui.label(s_SelectedKey, { text.data(), text.size() });
    }
    return declared;
}

