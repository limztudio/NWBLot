void VerifyUiListBuilderSelectionTests_InitialProgrammaticSelectionSurvivesAndEndNavigatesToVisibleLastKey(mut UiListBuilderTests self){
    self.m_state.select(50000u);
    ASSERT_TRUE(self.accept(1u));
    EXPECT_EQ(self.m_state.selectedKey(), 50000u);
    ASSERT_TRUE(FindUiListBuilderTarget(self, self.row(50000u)).has_value());
    self.press(CoreKey::Tab);
    self.press(CoreKey::End);
    ASSERT_TRUE(self.prepare(2u));
    EXPECT_EQ(self.m_state.selectedKey(), 100000u);
    EXPECT_DOUBLE_EQ(self.m_state.scrollOffset(), self.m_state.placement().maxOffset);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    ASSERT_TRUE(FindUiListBuilderTarget(self, self.row(100000u)).has_value());
    EXPECT_LE(self.m_source.textCalls, 12u);
}

void VerifyUiListBuilderSelectionTests_UnseenTallCursorIsMeasuredBeforeRevealAndFailedRevisionRefreshRetainsTheRequest(mut UiListBuilderTests self){
    self.m_source.specialIndex = self.m_source.count - 1u;
    self.m_state.select(1u);
    ListOptions options = MakeUiListBuilderDefaultOptions();
    options.selectOnNavigate = false;
    ASSERT_TRUE(self.accept(1u, options));
    const Optional<HitTarget> firstRowOpt = FindUiListBuilderTarget(self, self.row(1u));
    ASSERT_TRUE(firstRowOpt.has_value());
    const f32 initialHeight = firstRowOpt.value().rectangle.height;
    self.press(CoreKey::Tab);
    ASSERT_EQ(self.m_context.input().focus(), self.id(s_UiListCaseListKey, s_UiListCasePanelKey));
    self.press(CoreKey::End);
    self.m_source.textCalls = 0u;
    ASSERT_TRUE(self.accept(2u, options));
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_EQ(self.m_state.cursorKey(), self.m_source.count);
    Optional<HitTarget> cursorOpt = FindUiListBuilderTarget(self, self.row(self.m_source.count));
    ASSERT_TRUE(cursorOpt.has_value());
    HitTarget cursor = cursorOpt.value();
    EXPECT_GT(cursor.rectangle.height, initialHeight);
    EXPECT_GE(cursor.rectangle.y, cursor.clip.y);
    const VectorSingle cursorBottom = VectorSingle(cursor.rectangle.y, cursor.clip.y, 0.0f, 0.0f) + VectorSingle(cursor.rectangle.height, cursor.clip.height, 0.0f, 0.0f);
    EXPECT_LE(cursorBottom.x, cursorBottom.y);
    EXPECT_DOUBLE_EQ(self.m_state.scrollOffset(), self.m_state.placement().maxOffset);
    EXPECT_LE(self.m_source.textCalls, 8u);
    ASSERT_TRUE(self.m_state.scrollTo(0.0));
    ASSERT_TRUE(self.accept(3u, options));
    EXPECT_DOUBLE_EQ(self.m_state.scrollOffset(), 0.0);
    EXPECT_EQ(self.m_state.cursorKey(), self.m_source.count);
    EXPECT_FALSE(FindUiListBuilderTarget(self, self.row(self.m_source.count)).has_value());
    ++self.m_source.contentRevision;
    const f32 fontSize = self.m_builder.style().fontSize;
    self.m_builder.style().fontSize = UiListMultilineQuietNaNF32();
    EXPECT_FALSE(self.prepare(4u, options));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_EQ(self.m_state.cursorKey(), self.m_source.count);
    self.m_context.abandonFrame();
    self.m_builder.reset();
    self.m_builder.style().fontSize = fontSize;
    ASSERT_TRUE(self.accept(5u, options));
    cursorOpt = FindUiListBuilderTarget(self, self.row(self.m_source.count));
    ASSERT_TRUE(cursorOpt.has_value());
    cursor = cursorOpt.value();
    EXPECT_GE(cursor.rectangle.y, cursor.clip.y);
    const VectorSingle restoredBottom = VectorSingle(cursor.rectangle.y, cursor.clip.y, 0.0f, 0.0f) + VectorSingle(cursor.rectangle.height, cursor.clip.height, 0.0f, 0.0f);
    EXPECT_LE(restoredBottom.x, restoredBottom.y);
    EXPECT_DOUBLE_EQ(self.m_state.scrollOffset(), self.m_state.placement().maxOffset);
}

void VerifyUiListBuilderSelectionTests_ReorderPreservesSelectionByKeyAndRemovalClearsIt(mut UiListBuilderTests self){
    self.m_state.select(50000u);
    ASSERT_TRUE(self.accept(1u));
    self.m_source.reverse = true;
    ++self.m_source.contentRevision;
    ASSERT_TRUE(self.prepare(2u));
    EXPECT_FALSE(self.m_result.selectionChanged);
    EXPECT_EQ(self.m_state.selectedKey(), 50000u);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    ASSERT_TRUE(FindUiListBuilderTarget(self, self.row(50000u)).has_value());
    self.m_source.removed = 50000u;
    --self.m_source.count;
    ++self.m_source.contentRevision;
    ASSERT_TRUE(self.prepare(3u));
    EXPECT_TRUE(self.m_result.selectionChanged);
    EXPECT_EQ(self.m_state.selectedKey(), 0u);
    EXPECT_EQ(self.m_state.cursorKey(), 0u);
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_FALSE(FindUiListBuilderTarget(self, self.row(50000u)).has_value());
}

void VerifyUiListBuilderSelectionTests_ProgrammaticSameSelectionFencesQueuedActivationAndWheel(mut UiListBuilderTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    const Optional<HitTarget> secondRowOpt = FindUiListBuilderTarget(self, self.row(2u));
    ASSERT_TRUE(secondRowOpt.has_value());
    self.click(UiListBuilderCenter(secondRowOpt.value().rectangle));
    ASSERT_TRUE(self.wheel());
    const u64 inputGeneration = self.m_state.inputGeneration();
    self.m_state.select(1u);
    EXPECT_NE(self.m_state.inputGeneration(), inputGeneration);
    ASSERT_TRUE(self.prepare(2u));
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_FALSE(self.m_result.selectionChanged);
    EXPECT_FALSE(self.m_result.activated);
    EXPECT_DOUBLE_EQ(self.m_state.scrollOffset(), 0.0);
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiListCaseListKey, s_UiListCasePanelKey));
}

void VerifyUiListBuilderSelectionTests_SourceRevisionFencesHeldCaptureAndRestoresHostFocusAtAcceptance(mut UiListBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    const Optional<HitTarget> firstRowOpt = FindUiListBuilderTarget(self, self.row(1u));
    ASSERT_TRUE(firstRowOpt.has_value());
    const Point point = UiListBuilderCenter(firstRowOpt.value().rectangle);
    EXPECT_TRUE(self.send(MakeUiListPointerAt(InputEventType::PrimaryDown, point)).pointerConsumed);
    ++self.m_source.contentRevision;
    ASSERT_TRUE(self.prepare(2u));
    EXPECT_FALSE(self.m_context.input().capture().valid());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_TRUE(self.send(MakeUiListPointerAt(InputEventType::PrimaryUp, point)).pointerConsumed);
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiListCaseListKey, s_UiListCasePanelKey));
    ASSERT_TRUE(self.prepare(3u));
    EXPECT_FALSE(self.m_result.activated);
    EXPECT_EQ(self.m_state.selectedKey(), 0u);
}

void VerifyUiListBuilderSelectionTests_EscapeBeforeReleaseCancelsRowSelectionAndHostSubmission(mut UiListBuilderTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    const Optional<HitTarget> secondRowOpt = FindUiListBuilderTarget(self, self.row(2u));
    ASSERT_TRUE(secondRowOpt.has_value());
    const Point point = UiListBuilderCenter(secondRowOpt.value().rectangle);
    EXPECT_TRUE(self.send(MakeUiListPointerAt(InputEventType::PrimaryDown, point)).pointerConsumed);
    ASSERT_TRUE(self.accept(2u));
    EXPECT_FALSE(self.m_result.activated);
    self.press(CoreKey::Escape);
    EXPECT_TRUE(self.send(MakeUiListPointerAt(InputEventType::PrimaryUp, point)).pointerConsumed);
    ASSERT_TRUE(self.accept(3u));
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_FALSE(self.m_result.activated);
    EXPECT_FALSE(self.m_result.selectionChanged);
    self.press(CoreKey::Tab);
    ASSERT_EQ(self.m_context.input().focus(), self.id(s_UiListCaseListKey, s_UiListCasePanelKey));
    EXPECT_TRUE(self.send(MakeUiListKeyEvent(InputEventType::KeyDown, CoreKey::Enter)).commandConsumed);
    ASSERT_TRUE(self.accept(4u));
    EXPECT_FALSE(self.m_result.activated);
    self.press(CoreKey::Escape);
    EXPECT_TRUE(self.send(MakeUiListKeyEvent(InputEventType::KeyUp, CoreKey::Enter)).commandConsumed);
    ASSERT_TRUE(self.accept(5u));
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_FALSE(self.m_result.activated);
    self.press(CoreKey::Tab);
    ASSERT_EQ(self.m_context.input().focus(), self.id(s_UiListCaseListKey, s_UiListCasePanelKey));
    self.press(CoreKey::Enter);
    ASSERT_TRUE(self.accept(6u));
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_TRUE(self.m_result.activated);
}

void VerifyUiListBuilderSelectionTests_DatasetReplacementWhileSubmitIsHeldCannotSubmitOnRelease(mut UiListBuilderTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    self.press(CoreKey::Tab);
    EXPECT_TRUE(self.send(MakeUiListKeyEvent(InputEventType::KeyDown, CoreKey::Enter)).commandConsumed);
    ++self.m_source.contentRevision;
    ASSERT_TRUE(self.accept(2u));
    EXPECT_FALSE(self.m_result.activated);
    EXPECT_TRUE(self.send(MakeUiListKeyEvent(InputEventType::KeyUp, CoreKey::Enter)).commandConsumed);
    ASSERT_TRUE(self.accept(3u));
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_FALSE(self.m_result.activated);
    self.press(CoreKey::Enter);
    ASSERT_TRUE(self.accept(4u));
    EXPECT_TRUE(self.m_result.activated);
}

void VerifyUiListBuilderSelectionTests_HeldNavigationCannotMutateAnAcceptedReorderedDataset(mut UiListBuilderTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    self.press(CoreKey::Tab);
    InputEvent event = InputEvent();
    event.type = InputEventType::KeyDown;
    event.key = CoreKey::Down;
    EXPECT_TRUE(self.send(event).commandConsumed);
    self.m_source.reverse = true;
    ++self.m_source.contentRevision;
    ASSERT_TRUE(self.prepare(2u));
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    event.repeat = true;
    EXPECT_TRUE(self.send(event).commandConsumed);
    ASSERT_TRUE(self.prepare(3u));
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_FALSE(self.m_result.selectionChanged);
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    event.type = InputEventType::KeyUp;
    EXPECT_TRUE(self.send(event).commandConsumed);
}

void VerifyUiListBuilderSelectionTests_ReplacementSourceResetsSelectionAndScroll(mut UiListBuilderTests self){
    self.m_state.select(60000u);
    ASSERT_TRUE(self.accept(1u));
    ASSERT_GT(self.m_state.scrollOffset(), 0.0);
    ++self.m_source.generation;
    ASSERT_TRUE(self.prepare(2u));
    EXPECT_EQ(self.m_state.selectedKey(), 0u);
    EXPECT_EQ(self.m_state.cursorKey(), 0u);
    EXPECT_DOUBLE_EQ(self.m_state.scrollOffset(), 0.0);
    EXPECT_TRUE(self.m_result.selectionChanged);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_TRUE(FindUiListBuilderTarget(self, self.row(1u)).has_value());
}

void VerifyUiListBuilderSelectionTests_ReplacementStateRejectsOldActivationEvenForTheSameSourceAndHost(mut UiListBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    const Optional<HitTarget> secondRowOpt = FindUiListBuilderTarget(self, self.row(2u));
    ASSERT_TRUE(secondRowOpt.has_value());
    self.click(UiListBuilderCenter(secondRowOpt.value().rectangle));
    ListState replacement = ListState();
    ASSERT_TRUE(self.prepareSource(2u, self.m_source, replacement));
    EXPECT_FALSE(self.m_result.activated);
    EXPECT_EQ(replacement.selectedKey(), 0u);
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    const Optional<HitTarget> hostOpt = FindUiListBuilderTarget(self, self.id(s_UiListCaseListKey, s_UiListCasePanelKey));
    ASSERT_TRUE(hostOpt.has_value());
    EXPECT_EQ(hostOpt.value().control.instanceGeneration, replacement.inputGeneration());
}

void VerifyUiListBuilderSelectionTests_DisabledAndOmittedListsRetirePartsWithoutBorrowingQueuedActions(mut UiListBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    const Optional<HitTarget> secondRowOpt = FindUiListBuilderTarget(self, self.row(2u));
    ASSERT_TRUE(secondRowOpt.has_value());
    self.click(UiListBuilderCenter(secondRowOpt.value().rectangle));
    ListOptions disabled = MakeUiListBuilderDefaultOptions();
    disabled.enabled = false;
    ASSERT_TRUE(self.prepare(2u, disabled));
    EXPECT_FALSE(self.m_result.activated);
    EXPECT_EQ(self.m_state.selectedKey(), 0u);
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().targets().size(), 2u);
    const Optional<HitTarget> hostOpt = FindUiListBuilderTarget(self, self.id(s_UiListCaseListKey, s_UiListCasePanelKey));
    ASSERT_TRUE(hostOpt.has_value());
    EXPECT_FALSE(hostOpt.value().enabled);
    ASSERT_TRUE(self.begin(3u));
    ASSERT_TRUE(self.m_builder.beginPanel(s_UiListCasePanelKey, Rect(10.0f, 10.0f, 320.0f, 260.0f)));
    ASSERT_TRUE(self.finishPanel());
    EXPECT_FALSE(FindUiListBuilderTarget(self, self.id(s_UiListCaseListKey, s_UiListCasePanelKey)).has_value());
    EXPECT_EQ(self.m_context.states().entries().size(), 1u);
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_EQ(self.m_context.input().targets().size(), 1u);
}

void VerifyUiListBuilderSelectionTests_SourceRevisionChangedDuringScopeRejectsTheDeferredLoan(mut UiListBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPanel(s_UiListCasePanelKey, Rect(10.0f, 10.0f, 320.0f, 260.0f)));
    const ListResult result = self.m_builder.virtualList(s_UiListCaseListKey, self.m_source, self.m_state, MakeUiListBuilderDefaultOptions());
    ASSERT_TRUE(result.valid);
    ++self.m_source.contentRevision;
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    EXPECT_FALSE(self.m_context.ready());
}

void VerifyUiListBuilderSelectionTests_ContentPreflightRowsCannotHideAChangedSourceBeforePaint(mut UiListBuilderTests self){
    ListOptions options = MakeUiListBuilderDefaultOptions();
    options.height = LayoutSize(LayoutSizePolicy::Content, 0.0f);
    ASSERT_TRUE(self.accept(1u, options));
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPanel(s_UiListCasePanelKey, Rect(10.0f, 10.0f, 320.0f, 260.0f)));
    self.m_source.textCalls = 0u;
    ASSERT_TRUE(self.m_builder.virtualList(s_UiListCaseListKey, self.m_source, self.m_state, options).valid);
    ASSERT_GT(self.m_source.textCalls, 0u);
    ++self.m_source.contentRevision;
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    EXPECT_FALSE(self.m_context.ready());
}

void VerifyUiListBuilderSelectionTests_DuplicateOrMalformedVisibleKeysRejectTheFrame(mut UiListBuilderTests self){
    self.m_source.duplicate = true;
    EXPECT_FALSE(self.prepare(1u));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_TRUE(self.m_context.input().targets().empty());
    self.m_context.abandonFrame();
    self.m_builder.reset();
    self.m_source.duplicate = false;
    self.m_source.malformedLookup = true;
    EXPECT_FALSE(self.prepare(2u));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_TRUE(self.m_context.input().targets().empty());
}

void VerifyUiListBuilderSelectionTests_EmptyDatasetBuildsOnlyItsHostAndProvidesOneKeyboardStop(mut UiListBuilderTests self){
    self.m_source.count = 0u;
    ASSERT_TRUE(self.accept(1u));
    EXPECT_EQ(self.m_source.textCalls, 0u);
    EXPECT_EQ(self.m_context.input().targets().size(), 2u);
    EXPECT_FALSE(self.m_state.placement().scrollbarVisible);
    self.press(CoreKey::Tab);
    self.press(CoreKey::Down);
