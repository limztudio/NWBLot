    EXPECT_FALSE(ValidateReflectionSettings(settings));
    settings.screenEdgeFade = 0.26f;
    EXPECT_FALSE(ValidateReflectionSettings(settings));
    settings.screenEdgeFade = 0.0f;
    EXPECT_TRUE(ValidateReflectionSettings(settings));
}

void VerifyReflectionSettings_RejectsInvalidMaterialThresholdsModesAndEnvironmentRadiance(){
    ReflectionSettings settings = ReflectionSettings();
