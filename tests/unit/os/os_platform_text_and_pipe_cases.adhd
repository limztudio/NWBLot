[cpp_header("<core/os/linux/x11/text_input_dispatch.h>"), cpp_name("::NWB::Core::X11TextInputDispatchFence"), cpp_flags(self_defaulted)]
extern class X11TextInputDispatchFence{
    void enter();
    b8 leave();
    b8 retire();
    void released();
};

[cpp_header("<core/os/linux/x11/text_input_key_history.h>"), cpp_name("::NWB::Core::X11FilteredKeyHistory"), cpp_flags(self_defaulted)]
extern class X11FilteredKeyHistory{
    void synchronizeSession(in TextInputSessionToken token);
    void recordFiltered(in u32 keycode, in b8 released, in u32 timestamp, in u32 serial, in u64 receivedAt);
    b8 isForwardedDuplicate(in u32 keycode, in b8 released, in u32 timestamp, in u32 serial, in b8 sent, in u64 receivedAt)const;
    b8 isRetiredDuplicate(in u32 keycode, in b8 released, in u32 timestamp, in u32 serial, in b8 sent, in u64 receivedAt)const;
    void reset();
};

[cpp_header("<core/os/linux/x11/text_input_preedit.h>"), cpp_name("::NWB::Core::X11PreeditBuffer"), cpp_flags(no_copy)]
extern class X11PreeditBuffer{
    StringView text()const;
    usize caretByte()const;
    Span<TextInputPreeditClause> clauses()const;
    void clear();
    b8 replace(in usize start, in usize count, in StringView insertion, in usize caret);
    b8 replace(in usize start, in usize count, in StringView insertion, in usize caret, in Span<TextInputPreeditClauseStyle> styles);
    b8 updateFeedback(in usize start, in usize count, in Span<TextInputPreeditClauseStyle> styles, in usize caret);
    b8 moveCaret(in usize character);
    usize moveCaretToEnd();
};

