class UiPointerHitPopupHarness final : NoCopy{
public:
    UiPointerHitPopupHarness()
        : m_arena(Name(NWB::Tests::UiCases::s_UiCaseTestsUiPointerHitPopup))
        , router(m_arena)
    {}

    [[nodiscard]] b8 commitWithPopup(const Span<const HitTarget> targets, const u64 generation, const PopupScope& scope){
        return router.commitTargets(targets, generation, Span(&scope, 1u));
    }

    [[nodiscard]] b8 commitSingle(const HitTarget& target, const u64 generation){
        return router.commitTargets(Span(&target, 1u), generation);
    }


public:
    Core::Alloc::GlobalArena m_arena;
    InputRouter router;
};


