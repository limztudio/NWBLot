[cpp_name("::NWB::Impl::RendererShaderSystem")]
extern class RendererShaderSystem;
[cpp_name("::NWB::Impl::RtShadowState"), cpp_header("<impl/ecs_render/shadow/rt_shadow_state.adhd.h>")]
extern class RtShadowState;
[cpp_name("::NWB::Impl::RtSoftShadowState"), cpp_header("<impl/ecs_render/shadow/rt_shadow_state.adhd.h>")]
extern class RtSoftShadowState;


[modular]
class ShadowPipelineSet : NoCopy{
    private mut GlobalArena m_arena;
    private mut GraphicsRuntime m_graphics;
    private mut RendererShaderSystem m_shaderSystem;
    private mut RtShadowState m_shadow;
    private mut RtSoftShadowState m_softShadow;

    public ShadowPipelineSet(mut GlobalArena arena, mut GraphicsRuntime graphics, mut RendererShaderSystem shaderSystem, mut RtShadowState shadow, mut RtSoftShadowState softShadow){
        this.m_arena = arena;
        this.m_graphics = graphics;
        this.m_shaderSystem = shaderSystem;
        this.m_shadow = shadow;
        this.m_softShadow = softShadow;
    }

    public b8 ensureShadowPipeline();
    public b8 ensureShadowSoftPipeline();
    public b8 ensureSwShadowPipeline();
    public b8 ensureSoftShadowResolvePipeline();
    public b8 ensureShadowGeometryDownsamplePipeline();
    public b8 ensureSoftTransparentResolvePipeline();
    public b8 ensureShadowReprojectMergePipeline();
    public void prepareSoftCombinedResolvePipelines();

    private b8 ensureSoftwareTransparentSamplingPipeline();
    private b8 ensureSoftCombinedUpsamplePipeline();
    private b8 ensureSoftCombinedWaveletPipeline();
    private b8 ensureSoftCombinedTemporalPipeline();
}


