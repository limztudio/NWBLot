////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type MaterialGeometryHeapHandles = Array<GpuDescriptorHandle, s_MeshInstanceGeometrySlotCount>;
type MaterialPassMeshBufferVisitor = Func<64u, void(in BufferHandle)>;
type AvboitGeometryDrawSets = Span<MaterialPassDrawItemsView>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MaterialPassDrawContext{
    public mut CommandList commandList;
    public ViewportState viewportState;
    public MeshFrameBindingSnapshot frameBindings;
    public MaterialPipelinePass pass;
    public b8 materialFrameStatesGraphOwned;
    public b8 materialGeometryStatesGraphOwned;
    public b8 emulationOutputEntryStateGraphOwned;
    public FramebufferHandle framebuffer;
    public Optional<AvboitFrameTargets> avboitTargets;
    public Optional<CsgGraphResourceSnapshot> csgResources;
    public b8 conservativeGeometryScissor = false;

    public MaterialPassDrawContext(
        mut CommandList inCommandList,
        in ViewportState inViewportState,
        in MeshFrameBindingSnapshot inFrameBindings,
        in MaterialPipelinePass inPass,
        in b8 inMaterialFrameStatesGraphOwned,
        in b8 inMaterialGeometryStatesGraphOwned,
        in b8 inEmulationOutputEntryStateGraphOwned
    ){
        this.commandList = inCommandList;
        this.viewportState = inViewportState;
        this.frameBindings = inFrameBindings;
        this.pass = inPass;
        this.materialFrameStatesGraphOwned = inMaterialFrameStatesGraphOwned;
        this.materialGeometryStatesGraphOwned = inMaterialGeometryStatesGraphOwned;
        this.emulationOutputEntryStateGraphOwned = inEmulationOutputEntryStateGraphOwned;
    }

    public mut MaterialPassDrawContext setFramebuffer(in FramebufferHandle value){
        this.framebuffer = value;
        return this;
    }

    public mut MaterialPassDrawContext setAvboitTargets(in AvboitFrameTargets value){
        this.avboitTargets = value;
        return this;
    }

    public mut MaterialPassDrawContext setCsgResources(in CsgGraphResourceSnapshot value){
        this.csgResources = value;
        return this;
    }

    public mut MaterialPassDrawContext setConservativeGeometryScissor(in b8 value){
        this.conservativeGeometryScissor = value;
        return this;
    }
}

class MaterialPassMeshResourceSnapshot{
    public RuntimeMeshBuffers sourceBuffers;
    public MaterialGeometryHeapHandles geometryHeapHandles;
    public BufferHandle emulationVertexBuffer;
    public ObjectGeometryCacheSnapshot objectGeometryCache;
    public GpuDescriptorHandle emulationVertexHeapHandle = GpuDescriptorHandleInvalid();
    public u32 emulationIndexByteOffset = 0u;
    public u32 meshletCount = 0u;
    public u32 meshletPrimitiveIndexCount = 0u;
    public b8 runtimeMesh = false;
    public b8 dynamicMeshletBoundsFresh = false;
    public b8 dynamicMeshletConesFresh = false;

    public MaterialPassMeshResourceSnapshot(){
        this.sourceBuffers = RuntimeMeshBuffers();
        this.geometryHeapHandles = MaterialGeometryHeapHandles();
    }

    public b8 valid()const{
        return this.sourceBuffers.buffersValid() && GeometryHeapHandlesReady(this.geometryHeapHandles) && this.meshletCount > 0u && this.meshletPrimitiveIndexCount > 0u;
    }
}

class MaterialPassPipelineResourceSnapshot{
    public GraphicsPipelineHandle indexedPipeline;
    public GraphicsPipelineHandle emulationPipeline;
    public MeshletPipelineHandle meshletPipeline;
    public ComputePipelineHandle computePipeline;
    public ComputePipelineHandle objectGeometryDecodePipeline;
    public b8 sharedGeometryComputeProgram = false;
    public b8 indexedGeometryOutput = false;
}

class MaterialPassDrawItem{
    public Name meshKey = s_NameNone;
    public MaterialPipelineKey pipelineKey;
    public Shared<MaterialPassMeshResourceSnapshot> meshResources;
    public Shared<MaterialPassPipelineResourceSnapshot> pipelineResources;
    public u32 instanceIndex = 0u;
    public u32 materialConstantByteOffset = 0u;
    public u32 shadingModelId = 0u;
    public b8 meshletConeCullScaleSafe = false;

    public MaterialPassDrawItem(){
        this.pipelineKey = MaterialPipelineKey();
    }

    public in MaterialPassMeshResourceSnapshot mesh()const{
        return this.meshResources.deref();
    }

    public in MaterialPassPipelineResourceSnapshot pipeline()const{
        return this.pipelineResources.deref();
    }
}

class MaterialInstanceMutableCacheEntry{
    public Name materialName = s_NameNone;
    public Name materialInterface = s_NameNone;
    public u64 typedLayoutHash = 0u;
    public u64 revision = 0u;
    public Vector<u8> mutableTypedBytes;
}

class MaterialPassDrawItems{
    public Vector<MaterialPassDrawItem> meshDrawItems;
    public Vector<MaterialPassDrawItem> indexedDrawItems;
    public Vector<MaterialPassDrawItem> computeDrawItems;

    public b8 empty()const{
        return this.meshDrawItems.empty() && this.indexedDrawItems.empty() && this.computeDrawItems.empty();
    }

    public void clear(){
        this.meshDrawItems.clear();
        this.indexedDrawItems.clear();
        this.computeDrawItems.clear();
    }

    public void reserve(in usize capacity){
        this.meshDrawItems.reserve(capacity);
        this.indexedDrawItems.reserve(capacity);
        this.computeDrawItems.reserve(capacity);
    }

    public void reserveForPath(in b8 meshSupported, in usize capacity){
        if(meshSupported)
            this.meshDrawItems.reserve(capacity);
        else
            this.indexedDrawItems.reserve(capacity);
    }
}

class MaterialPassDrawItemsView{
    public Span<MaterialPassDrawItem> meshDrawItems;
    public Span<MaterialPassDrawItem> indexedDrawItems;
    public Span<MaterialPassDrawItem> computeDrawItems;

    public MaterialPassDrawItemsView(){
    }

    public MaterialPassDrawItemsView(in Span<MaterialPassDrawItem> inMeshDrawItems, in Span<MaterialPassDrawItem> inIndexedDrawItems, in Span<MaterialPassDrawItem> inComputeDrawItems){
        this.meshDrawItems = inMeshDrawItems;
        this.indexedDrawItems = inIndexedDrawItems;
        this.computeDrawItems = inComputeDrawItems;
    }

    public MaterialPassDrawItemsView(in MaterialPassDrawItems drawItems){
        this.meshDrawItems = drawItems.meshDrawItems;
        this.indexedDrawItems = drawItems.indexedDrawItems;
        this.computeDrawItems = drawItems.computeDrawItems;
    }

    public b8 empty()const{
        return this.meshDrawItems.empty() && this.indexedDrawItems.empty() && this.computeDrawItems.empty();
    }
}

class MaterialPassDrawItemPartitions{
    public MaterialPassDrawItems regular;
    public MaterialPassDrawItems csg;
    public MaterialPassDrawItems csgReceiverSurface;

    public b8 empty()const{
        return this.regular.empty() && this.csg.empty() && this.csgReceiverSurface.empty();
    }

    public void clear(){
        this.regular.clear();
        this.csg.clear();
        this.csgReceiverSurface.clear();
    }

    public void reserve(in usize capacity){
        this.regular.reserve(capacity);
        this.csg.reserve(capacity);
        this.csgReceiverSurface.reserve(capacity);
    }

    public void reserveForPath(in b8 meshSupported, in usize regularCapacity, in usize csgCapacity, in usize receiverSurfaceCapacity){
        if(regularCapacity > 0u)
            this.regular.reserveForPath(meshSupported, regularCapacity);
        if(csgCapacity > 0u)
            this.csg.reserveForPath(meshSupported, csgCapacity);
        if(receiverSurfaceCapacity > 0u)
            this.csgReceiverSurface.reserveForPath(meshSupported, receiverSurfaceCapacity);
    }
}

class MaterialPassDrawItemPartitionsView{
    public MaterialPassDrawItemsView regular;
    public MaterialPassDrawItemsView csg;
    public MaterialPassDrawItemsView csgReceiverSurface;

    public MaterialPassDrawItemPartitionsView(){
    }

    public MaterialPassDrawItemPartitionsView(in MaterialPassDrawItemsView inRegular, in MaterialPassDrawItemsView inCsg){
        this.regular = inRegular;
        this.csg = inCsg;
    }

    public MaterialPassDrawItemPartitionsView(in MaterialPassDrawItemsView inRegular, in MaterialPassDrawItemsView inCsg, in MaterialPassDrawItemsView inCsgReceiverSurface){
        this.regular = inRegular;
        this.csg = inCsg;
        this.csgReceiverSurface = inCsgReceiverSurface;
    }

    public MaterialPassDrawItemPartitionsView(in MaterialPassDrawItemPartitions partitions){
        this.regular = partitions.regular;
        this.csg = partitions.csg;
        this.csgReceiverSurface = partitions.csgReceiverSurface;
    }

    public b8 empty()const{
        return this.regular.empty() && this.csg.empty() && this.csgReceiverSurface.empty();
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ForEachMaterialPassMeshSourceBuffer(in MaterialPassMeshResourceSnapshot mesh, in MaterialPassMeshBufferVisitor handler){
    handler(mesh.sourceBuffers.positionBuffer);
    handler(mesh.sourceBuffers.normalBuffer);
    handler(mesh.sourceBuffers.tangentBuffer);
    handler(mesh.sourceBuffers.uv0Buffer);
    handler(mesh.sourceBuffers.colorBuffer);
    handler(mesh.sourceBuffers.meshletDescBuffer);
    handler(mesh.sourceBuffers.meshletBoundsBuffer);
    handler(mesh.sourceBuffers.meshletPositionRefDeltaBuffer);
    handler(mesh.sourceBuffers.meshletAttributeRefDeltaBuffer);
    handler(mesh.sourceBuffers.meshletLocalVertexRefBuffer);
    handler(mesh.sourceBuffers.meshletPrimitiveIndexBuffer);
}

b8 MatchesRetainedGeneratedGeometryOutputs(
    in b8 captured,
    in Span<MaterialPassDrawItem> drawItems,
    in Span<BufferHandle> outputBuffers,
    in Span<GeneratedGeometryOutputLayout> outputLayouts,
    in Span<u32> outputHeapSlots
){
    if(!captured || outputBuffers.size() != drawItems.size() || outputLayouts.size() != drawItems.size() || outputHeapSlots.size() != drawItems.size())
        return false;
    for(usize drawIndex = 0u; drawIndex < drawItems.size(); ++drawIndex){
        in MaterialPassMeshResourceSnapshot mesh = drawItems[drawIndex].mesh();
        if(
            !mesh.emulationVertexBuffer.valid()
            || !mesh.emulationVertexHeapHandle.valid()
            || mesh.emulationVertexBuffer != outputBuffers[drawIndex]
            || !outputLayouts[drawIndex].matches(mesh.emulationIndexByteOffset, drawItems[drawIndex].pipeline().indexedGeometryOutput)
            || mesh.emulationVertexHeapHandle.slot() != outputHeapSlots[drawIndex]
        )
            return false;
    }
    return true;
}

b8 CompareMaterialPassDrawItems(in MaterialPassDrawItem lhs, in MaterialPassDrawItem rhs){
    if(lhs.pipelineKey.material != rhs.pipelineKey.material){
        const usize lhsHash = HashValue(lhs.pipelineKey.material);
        const usize rhsHash = HashValue(rhs.pipelineKey.material);
        if(lhsHash != rhsHash)
            return lhsHash < rhsHash;
        return lhs.pipelineKey.material.resolvedText() < rhs.pipelineKey.material.resolvedText();
    }
    if(lhs.pipelineKey.twoSided != rhs.pipelineKey.twoSided)
        return !lhs.pipelineKey.twoSided && rhs.pipelineKey.twoSided;
    const u8 lhsCsg = cast<u8>(lhs.pipelineKey.csgMode);
    const u8 rhsCsg = cast<u8>(rhs.pipelineKey.csgMode);
    if(lhsCsg != rhsCsg)
        return lhsCsg < rhsCsg;
    if(lhs.pipelineKey.csgEvaluatorVariant != rhs.pipelineKey.csgEvaluatorVariant){
        const usize lhsHash = HashValue(lhs.pipelineKey.csgEvaluatorVariant);
        const usize rhsHash = HashValue(rhs.pipelineKey.csgEvaluatorVariant);
        if(lhsHash != rhsHash)
            return lhsHash < rhsHash;
        return lhs.pipelineKey.csgEvaluatorVariant.resolvedText() < rhs.pipelineKey.csgEvaluatorVariant.resolvedText();
    }
    if(lhs.pipelineKey.csgShapeRegistryRevision != rhs.pipelineKey.csgShapeRegistryRevision)
        return lhs.pipelineKey.csgShapeRegistryRevision < rhs.pipelineKey.csgShapeRegistryRevision;
    if(lhs.meshKey != rhs.meshKey){
        const usize lhsHash = HashValue(lhs.meshKey);
        const usize rhsHash = HashValue(rhs.meshKey);
        if(lhsHash != rhsHash)
            return lhsHash < rhsHash;
        return lhs.meshKey.resolvedText() < rhs.meshKey.resolvedText();
    }
    return lhs.instanceIndex < rhs.instanceIndex;
}

void SortMaterialPassDrawItemList(mut Vector<MaterialPassDrawItem> draws){
    if(draws.size() <= 1u)
        return;
    SortSequence<MaterialPassDrawItem>(draws, lambda[](in MaterialPassDrawItem lhs, in MaterialPassDrawItem rhs) -> b8{
        return CompareMaterialPassDrawItems(lhs, rhs);
    });
}

void SortMaterialPassDrawItems(mut MaterialPassDrawItems draws){
    SortMaterialPassDrawItemList(draws.meshDrawItems);
    SortMaterialPassDrawItemList(draws.indexedDrawItems);
    SortMaterialPassDrawItemList(draws.computeDrawItems);
}

void SortMaterialPassDrawItemPartitions(mut MaterialPassDrawItemPartitions partitions){
    SortMaterialPassDrawItems(partitions.regular);
    SortMaterialPassDrawItems(partitions.csg);
    SortMaterialPassDrawItems(partitions.csgReceiverSurface);
}


