#include <impl/ecs_render/execute/frame_execute_timing_state.adhd>
#include <impl/ecs_render/execute/types.adhd>
#include <impl/ecs_render/avboit/task_graph_stage.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class DeferredFrameTopologyResult{
    public Array<GpuTaskId, s_GraphicsPrefixTimingTaskCount> graphicsPrefixTimingTasks;
    public usize graphicsPrefixUniquePacketCount = 0u;
    public RendererAvboitTaskGraphValidation avboitValidation;
    public GpuTaskId terminalPresentationTask;
    public Optional<GpuPhysicalQueueInfo> surfelGiCounterReadbackQueue;
    public Optional<GpuPhysicalQueueInfo> laggedLightingHistoryQueue;
}

class DeferredFrameTopologyValidator : NoCopy{
    private in RendererFramePipeline m_pipeline;

    public DeferredFrameTopologyValidator(in RendererFramePipeline pipeline){
        this.m_pipeline = pipeline;
    }

    public Expected<DeferredFrameTopologyResult> validate(
        in GpuCompiledGraphReadView deferredCompiledPlan,
        in GpuTaskGraphDeclarationReadView deferredTaskGraphView,
        mut FrameExecuteTimingState timing,
        in GpuPhysicalQueueId primaryGraphicsQueue,
        in b8 deferredGraphScheduled,
        in b8 captureLaggedLightingHistory,
        in b8 hardwareShadowSupported,
        in b8 hasOpaqueCsgFrameWork,
        in b8 hasTransparentRenderers,
        in b8 clearAvboitTargets,
        in b8 laggedAsyncLightingSchedule,
        in b8 laggedLightingHistoryWriterWaitPending,
        in b8 surfelCounterReadbackCompletionValid
    )const;
}


