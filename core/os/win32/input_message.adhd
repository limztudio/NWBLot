const usize s_Win32MessageRepeatCountMask = 0xffffu;

u32 Win32MessageRepeatCount(in isize flags){
    const u32 count = cast<u32>(cast<usize>(flags) & s_Win32MessageRepeatCountMask);
    if(count == 0u)
        return 1u;
    return count;
}


