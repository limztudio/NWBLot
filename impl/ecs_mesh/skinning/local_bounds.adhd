#include <impl/ecs_mesh/skinning/graph_dispatch_plan.adhd>
#include <impl/ecs_mesh/skinning/runtime_instance.adhd>
#include <impl/ecs_mesh/skinning/timing_names.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MeshSkinningLocalBoundsTask{
    private mut GraphicsRuntime m_graphics;
    private mut GpuTimingSubmissionTicket m_ticket;
    private Span<MeshSkinningLocalBoundsDispatch> m_dispatches;

    public MeshSkinningLocalBoundsTask(mut GraphicsRuntime graphics, mut GpuTimingSubmissionTicket ticket, in Span<MeshSkinningLocalBoundsDispatch> dispatches){
        this.m_graphics = graphics;
        this.m_ticket = ticket;
        this.m_dispatches = dispatches;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    [cpp_unwind]
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const{
        if(this.m_dispatches.empty() || !this.m_graphics.getDevice().getDescriptorHeap().isInitialized())
            return false;
        GpuTimingTicketRecordingScope recording(this.m_ticket);
        GpuGraphPipelineId boundPipeline;
        GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeMeshSkinningLocalBounds, this.m_graphics.getDevice(), commands);
        for(in MeshSkinningLocalBoundsDispatch plan : this.m_dispatches){
            const Optional<mut ComputePipeline> pipeline = context.declarations.borrowComputePipeline(plan.localBoundsPipeline);
            if(!pipeline.has_value() || !context.declarations.borrowBuffer(plan.bindlessResourceSlotsResource).has_value()
                || !context.declarations.borrowBuffer(plan.meshletLocalBoundsResource).has_value() || !context.declarations.borrowBuffer(plan.localBoundsResource).has_value())
                return false;
            if(plan.localBoundsPipeline != boundPipeline){
                ComputeState state;
                state.setPipeline(pipeline.value());
                commands.setComputeState(state);
                this.m_graphics.getDevice().getDescriptorHeap().bindCompute(commands, pipeline.value());
                boundPipeline = plan.localBoundsPipeline;
            }
            const MeshletBoundsPushConstants push = MakeMeshletBoundsPushConstants(plan.meshletCount, plan.bindlessResourceSlots);
            commands.setPushConstants(push);
            commands.dispatch(1u, 1u, 1u);
        }
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u64 ComputeMeshletLocalBoundsByteSize(in usize meshletCount, in u64 boundsRecordByteSize){
    return cast<u64>(meshletCount) * boundsRecordByteSize;
}

b8 CreateMeshSkinningLocalBoundsBuffers(mut GraphicsRuntime graphics, mut MeshSkinningRuntimeInstance instance){
    instance.deformationState.invalidateCurrent();
    if(!ValidateMeshSkinningLocalBoundsMeshletCount(instance.meshlets.size(), s_RuntimeMeshBoundsByteSize))
        return false;

    const Name partialName = DeriveRuntimeResourceName(instance.sourceName, instance.handle.value, instance.editRevision, s_MeshletLocalBoundsSuffix);
    const Name outputName = DeriveRuntimeResourceName(instance.sourceName, instance.handle.value, instance.editRevision, s_LocalBoundsSuffix);
    if(partialName == s_NameNone || outputName == s_NameNone){
        error("MeshSkinningSystem: failed to derive runtime local bounds buffer names");
        return false;
    }

    BufferDesc desc = BufferDesc();
    desc
        .setByteSize(ComputeMeshletLocalBoundsByteSize(instance.meshlets.size(), cast<u64>(s_RuntimeMeshBoundsByteSize)))
        .setCanHaveUAVs(true)
        .setCanHaveRawViews(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setDebugName(partialName)
    ;
    const Expected<BufferHandle> partialsResult = graphics.createBuffer(desc);
    if(!partialsResult.has_value()){
        error("MeshSkinningSystem: failed to create runtime local bounds partials");
        return false;
    }

    desc.setByteSize(cast<u64>(s_RuntimeMeshBoundsByteSize)).setDebugName(outputName);
    const Expected<BufferHandle> outputResult = graphics.createBuffer(desc);
    if(!outputResult.has_value()){
        error("MeshSkinningSystem: failed to create runtime local bounds output");
        return false;
    }

    instance.meshletLocalBoundsBuffer = partialsResult.value();
    instance.localBoundsBuffer = outputResult.value();
    return true;
}


