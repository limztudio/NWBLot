#include "style.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_RadioGroupStampFencePassCount = 2u;
const f32 s_RadioGroupMaxMarkInset = 0.5f;
const f64 s_RadioGroupMaxMarkInsetF64 = 0.5;
const Name s_RadioNormalRegionName = "radio.normal";
const Name s_RadioHoverRegionName = "radio.hover";
const Name s_RadioPressedRegionName = "radio.pressed";
const Name s_RadioCheckedRegionName = "radio.checked";
const Name s_RadioDisabledRegionName = "radio.disabled";
const Name s_RadioMarkRegionName = "radio.mark";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> RadioGroupOrientation{
    Vertical,
    Horizontal,
    Grid,
    kCount,
}

class RadioGroupStyle{
    public Name normal = s_RadioNormalRegionName;
    public Name hover = s_RadioHoverRegionName;
    public Name pressed = s_RadioPressedRegionName;
    public Name checked = s_RadioCheckedRegionName;
    public Name disabled = s_RadioDisabledRegionName;
    public Name mark = s_RadioMarkRegionName;
    public Name fallback = s_StyleCheckboxNormalRegionName;
    public Name checkedFallback = s_StyleCheckboxCheckedRegionName;
    public Name markFallback = s_StyleCheckboxMarkRegionName;
    public Name focus = s_StyleFocusOverlayRegionName;
    public Color hoverTint = s_StyleHoverTint;
    public Color pressedTint = s_StylePressedTint;
    public Color disabledTint = s_StyleDisabledTint;
    public Insets padding = Insets(s_StyleSpacingSmall, s_StyleSpacingSmall, s_StyleSpacingSmall, s_StyleSpacingSmall);
    public f32 rowGap = s_StyleSpacingSmall;
    public f32 columnGap = s_StyleSpacingMedium;
    public f32 indicatorExtent = s_StyleControlExtent;
    public f32 gap = s_StyleSpacingMedium;
    public f32 markInset = s_StyleMarkInset;
}

class RadioGroupOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public RadioGroupOrientation orientation = RadioGroupOrientation::Vertical;
    public u32 columns = 1u;
    public b8 enabled = true;
    public LayoutItemOptions layout;
}

class RadioGroupResult{
    public b8 valid = false;
    public b8 selectionChanged = false;
    public b8 activated = false;
    public b8 focused = false;
}

class RadioGroupChoice{
    public u64 key = 0u;
    public b8 enabled = false;
}

class RadioGroupChoices{
    public Vector<RadioGroupChoice> rows;
    public u64 sourceGeneration = 0u;
    public u64 sourceRevision = 0u;
    public u32 count = 0u;
}

class RadioGroupSnapshot{
    public b8 operator==(in RadioGroupSnapshot rhs)const{
        return this.instanceGeneration == rhs.instanceGeneration
            && this.inputGeneration == rhs.inputGeneration
            && this.revision == rhs.revision
            && this.selectedKey == rhs.selectedKey
            && this.cursorKey == rhs.cursorKey
            && this.sourceGeneration == rhs.sourceGeneration
            && this.sourceRevision == rhs.sourceRevision;
    }

    public b8 operator!=(in RadioGroupSnapshot rhs)const{
        return this.instanceGeneration != rhs.instanceGeneration
            || this.inputGeneration != rhs.inputGeneration
            || this.revision != rhs.revision
            || this.selectedKey != rhs.selectedKey
            || this.cursorKey != rhs.cursorKey
            || this.sourceGeneration != rhs.sourceGeneration
            || this.sourceRevision != rhs.sourceRevision;
    }

    public u64 instanceGeneration = 0u;
    public u64 inputGeneration = 0u;
    public u64 revision = 0u;
    public u64 selectedKey = 0u;
    public u64 cursorKey = 0u;
    public u64 sourceGeneration = 0u;
    public u64 sourceRevision = 0u;
}

class RadioGroupMetrics{
    public RadioGroupOrientation orientation = RadioGroupOrientation::Vertical;
    public f32 rowHeight = 0.0f;
    public f32 indicatorExtent = s_StyleControlExtent;
    public f32 gap = s_StyleSpacingMedium;
    public f32 rowGap = s_StyleSpacingSmall;
    public f32 columnGap = s_StyleSpacingMedium;
    public f32 cellWidth = 0.0f;
    public f32 markInset = s_StyleMarkInset;
    public Insets padding;
    public Point contentSize;
    public u32 count = 0u;
    public u32 columns = 1u;
    public u32 rowCount = 0u;
}

class RadioGroupChoicePlacement{
    public u64 key = 0u;
    public b8 enabled = false;
    public Rect rectangle;
    public Rect clip;
    public Rect indicator;
    public Rect mark;
    public Rect textClip;
}

class RadioGroupPlacement{
    public Rect bounds;
    public Rect clip;
    public Rect content;
    public Vector<RadioGroupChoicePlacement> rows;
    public u32 count = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidRadioGroupChoices(in RadioGroupChoices choices){
    if(choices.sourceGeneration == 0u || choices.sourceRevision == 0u || choices.rows.size() != cast<usize>(choices.count)){
        return false;
    }
    if(choices.count <= 16u){
        for(u32 index = 0u; index < choices.count; ++index){
            const u64 key = choices.rows[index].key;
            if(key == 0u)
                return false;
            for(u32 previous = 0u; previous < index; ++previous){
                if(choices.rows[previous].key == key)
                    return false;
            }
        }
        return true;
    }
    HashSet<u64> seen;
    seen.reserve(cast<usize>(choices.count));
    for(u32 index = 0u; index < choices.count; ++index){
        const u64 key = choices.rows[index].key;
        if(key == 0u || seen.find(key) != seen.end())
            return false;
        seen.insert(key);
    }
    return true;
}

Expected<u32> TryFindRadioGroupChoice(in RadioGroupChoices choices, in u64 key){
    if(key == 0u || choices.rows.size() != cast<usize>(choices.count)){
        return MakeUnexpected(Failure());
    }
    for(u32 candidate = 0u; candidate < choices.count; ++candidate){
        if(choices.rows[candidate].key == key){
            return candidate;
        }
    }
    return MakeUnexpected(Failure());
}

u64 FindEnabledRadioGroupChoice(in RadioGroupChoices choices, in u32 start, in b8 reverse){
    if(choices.count == 0u || choices.rows.size() != cast<usize>(choices.count) || start >= choices.count){
        return 0u;
    }
    u32 index = start;
    for(u32 visited = 0u; visited < choices.count; ++visited){
        if(choices.rows[index].enabled){
            return choices.rows[index].key;
        }
        if(reverse){
            if(index == 0u){
                index = choices.count - 1u;
            }
            else{
                index = index - 1u;
            }
        }
        else{
            if(index + 1u == choices.count){
                index = 0u;
            }
            else{
                index = index + 1u;
            }
        }
    }
    return 0u;
}

b8 IsValidRadioGroupOptions(in RadioGroupOptions options){
    return options.enabled
        && IsValidLayoutSize(options.width)
        && options.orientation < RadioGroupOrientation::kCount
        && options.columns >= 1u;
}

u64 ResolveRadioGroupNavigationTarget(
    in RadioGroupChoices choices,
    in u64 cursor,
    in ControlActionKind kind,
    in RadioGroupOrientation orientation,
    in u32 columns
){
    if(choices.count == 0u || choices.rows.size() != cast<usize>(choices.count)){
        return 0u;
    }
    if(kind == ControlActionKind::Home){
        return FindEnabledRadioGroupChoice(choices, 0u, false);
    }
    if(kind == ControlActionKind::End){
        return FindEnabledRadioGroupChoice(choices, choices.count - 1u, true);
    }
    const b8 reverse = kind == ControlActionKind::Up || kind == ControlActionKind::Left;
    const Expected<u32> current = TryFindRadioGroupChoice(choices, cursor);
    if(!current.has_value()){
        u32 fallbackStart = 0u;
        if(reverse){
            fallbackStart = choices.count - 1u;
        }
        return FindEnabledRadioGroupChoice(choices, fallbackStart, reverse);
    }
    if(orientation == RadioGroupOrientation::Grid && columns > 1u && (kind == ControlActionKind::Up || kind == ControlActionKind::Down)){
        const u32 curIdx = current.value();
        const u32 col = curIdx % columns;
        const u32 rowsInCol = 1u + ((choices.count - 1u - col) / columns);
        const u32 lastInCol = col + (rowsInCol - 1u) * columns;
        u32 idx = curIdx;
        for(u32 visited = 0u; visited < rowsInCol; ++visited){
            if(kind == ControlActionKind::Up){
                if(idx < columns)
                    idx = lastInCol;
                else
                    idx = idx - columns;
            }
            else{
                if(idx + columns >= choices.count)
                    idx = col;
                else
                    idx = idx + columns;
            }
            if(choices.rows[idx].enabled)
                return choices.rows[idx].key;
        }
    }
    u32 start = 0u;
    if(reverse){
        if(current.value() == 0u){
            start = choices.count - 1u;
        }
        else{
            start = current.value() - 1u;
        }
    }
    else{
        if(current.value() + 1u == choices.count){
            start = 0u;
        }
        else{
            start = current.value() + 1u;
        }
    }
    return FindEnabledRadioGroupChoice(choices, start, reverse);
}



