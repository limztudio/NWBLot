native{
namespace NWB::Impl{
using Ui::DisplayMetrics;
namespace EditClipboardAction = Ui::EditClipboardAction;
using Ui::EditBoxCaretStop;
using Ui::EditBoxPlacement;
using Ui::EditCaretLine;
using Ui::EditCompositionView;
namespace EditTextMode = Ui::EditTextMode;
using Ui::HitEditCaretGeometry;
using Ui::Point;
using Ui::PopupToken;
using Ui::Rect;
using Ui::TryHitEditWordCaretGeometry;
using Ui::WidgetId;
}
}


const usize s_UiEditBoxMaxEntries = 256u;

enum<u8> UiEditBoxEventKind{
    Command,
    Character,
    Native,
    Selection,
    PastePrimary,
    Blur,
    Focus,
}

enum<u8> UiTextEditStatus{
    Idle,
    Applied,
    Cancelled,
    StaleOwner,
    StaleModel,
    StaleSurrounding,
    InvalidEvent,
    ModelRejected,
    NativeFailure,
    WrongThread,
}

class UiTextEditResult{
    public UiTextEditStatus status = UiTextEditStatus::Idle;
    public b8 textChanged = false;
    public usize eventsApplied = 0u;
}

enum<u8> UiEditClickKind{
    Caret,
    Word,
}

// The host advances the corresponding generation when a declaration or its backing model is replaced.
class UiTextEditOwner{
    public b8 operator==(in UiTextEditOwner rhs)const{
        return this.widget == rhs.widget && this.declarationGeneration == rhs.declarationGeneration && this.modelGeneration == rhs.modelGeneration;
    }

    public b8 operator!=(in UiTextEditOwner rhs)const{
        return this.widget != rhs.widget || this.declarationGeneration != rhs.declarationGeneration || this.modelGeneration != rhs.modelGeneration;
    }

    public b8 valid()const{
        return this.widget.valid() && this.declarationGeneration != 0u && this.modelGeneration != 0u;
    }

    public WidgetId widget;
    public u64 declarationGeneration = 0u;
    public u64 modelGeneration = 0u;
}

const u64 s_UiDoubleClickMaxIntervalMs = 500u;
const f64 s_UiDoubleClickMaxDistanceSquared = 16.0;
const u8 s_UiDoubleClickCount = 2u;

// Editor-local policy: a released second press within 500 ms and four logical units selects a word run.
class UiEditClickTracker{
    public void cancel(){
        this.m_owner = UiTextEditOwner();
        this.m_popup = PopupToken();
        this.m_position = Point();
        this.m_revision = 0u;
        this.m_externalRevision = 0u;
        this.m_pressTimestampMs = 0u;
        this.m_clickCount = 0u;
        this.m_down = false;
        this.m_released = false;
    }

    public UiEditClickKind press(in UiTextEditOwner owner, in PopupToken popup, in u64 revision, in u64 externalRevision, in Point position, in u64 timestampMs, in b8 shift){
        if(!owner.valid() || timestampMs == 0u || shift || !isFinite(position.x) || !isFinite(position.y)){
            this.cancel();
            return UiEditClickKind::Caret;
        }
        const f64x2 delta = f64x2(cast<f64>(position.x), cast<f64>(position.y)) - f64x2(cast<f64>(this.m_position.x), cast<f64>(this.m_position.y));
        const f64 distanceSquared = lengthSq(delta);
        const b8 second = this.m_released && this.m_clickCount == 1u && owner == this.m_owner && popup == this.m_popup
            && revision == this.m_revision && externalRevision == this.m_externalRevision
            && timestampMs >= this.m_pressTimestampMs && timestampMs - this.m_pressTimestampMs <= s_UiDoubleClickMaxIntervalMs
            && distanceSquared <= s_UiDoubleClickMaxDistanceSquared;
        this.m_owner = owner;
        this.m_popup = popup;
        this.m_position = position;
        this.m_revision = revision;
        this.m_externalRevision = externalRevision;
        this.m_pressTimestampMs = timestampMs;
        if(second)
            this.m_clickCount = s_UiDoubleClickCount;
        else
            this.m_clickCount = 1u;
        this.m_down = true;
        this.m_released = false;
        if(second)
            return UiEditClickKind::Word;
        return UiEditClickKind::Caret;
    }

    public void move(in Point position){
        if(!this.m_down)
            return;
        if(!isFinite(position.x) || !isFinite(position.y)){
            this.cancel();
            return;
        }
        const f64x2 delta = f64x2(cast<f64>(position.x), cast<f64>(position.y)) - f64x2(cast<f64>(this.m_position.x), cast<f64>(this.m_position.y));
        const f64 distanceSquared = lengthSq(delta);
        if(distanceSquared > s_UiDoubleClickMaxDistanceSquared)
            this.cancel();
    }

    public void release(in UiTextEditOwner owner){
        if(this.m_down && this.m_owner == owner){
            this.m_down = false;
            this.m_released = true;
        }
        else
            this.cancel();
    }

    public void retainFocus(in UiTextEditOwner owner){
        if(this.m_clickCount != 0u && (!owner.valid() || owner != this.m_owner))
            this.cancel();
    }

    private UiTextEditOwner m_owner;
    private PopupToken m_popup;
    private Point m_position;
    private u64 m_revision = 0u;
    private u64 m_externalRevision = 0u;
    private u64 m_pressTimestampMs = 0u;
    private u8 m_clickCount = 0u;
    private b8 m_down = false;
    private b8 m_released = false;
}

i32x4 ResolveUiEditNativeCaretBounds(in Rect caret, in DisplayMetrics display){
    const f32x4 physical = f32x4(caret.x, caret.y, caret.width, caret.height) * f32x4(display.pixelScaleX, display.pixelScaleY, display.pixelScaleX, display.pixelScaleY);
    const f32x4 origin = floor(f32x4(physical.x, physical.y, 0.0f, 0.0f));
    const f32x4 size = ceil(f32x4(physical.z, physical.w, 0.0f, 0.0f));
    const f64 minI32 = cast<f64>(i32.min);
    const f64 maxI32 = cast<f64>(i32.max);
    const f64x4 coordinate = clamp(f64x4(cast<f64>(origin.x), cast<f64>(origin.y), cast<f64>(size.x), cast<f64>(size.y)), minI32, maxI32);
    return i32x4(cast<i32>(coordinate.x), cast<i32>(coordinate.y), max(1, cast<i32>(coordinate.z)), max(1, cast<i32>(coordinate.w)));
}

Expected<Point> ResolveLocalUiEditTextPosition(
    in u64 generation,
    in Span<EditBoxCaretStop> stops,
    in Span<EditCaretLine> lines,
    in u64 geometryModelGeneration,
    in PopupToken geometryPopup,
    in EditTextMode textMode,
    in EditBoxPlacement placement,
    in UiTextEditOwner owner,
    in PopupToken popup,
    in Point position
){
    if(
        generation == 0u || stops.empty() || lines.empty()
        || geometryModelGeneration != owner.modelGeneration || geometryPopup != popup
        || (textMode != EditTextMode::SingleLine && textMode != EditTextMode::Multiline)
        || (textMode == EditTextMode::SingleLine && lines.size() != 1u)
    )
        return makeUnexpected(Failure());
    return Point(position.x - placement.textOrigin.x, position.y - placement.textOrigin.y);
}

Expected<usize> HitUiEditBoxGeometry(
    in u64 generation,
    in Span<EditBoxCaretStop> stops,
    in Span<EditCaretLine> lines,
    in u64 geometryModelGeneration,
    in PopupToken geometryPopup,
    in EditTextMode textMode,
    in EditBoxPlacement placement,
    in UiTextEditOwner owner,
    in PopupToken popup,
    in Point position
){
    const Expected<Point> local = ResolveLocalUiEditTextPosition(
        generation,
        stops,
        lines,
        geometryModelGeneration,
        geometryPopup,
        textMode,
        placement,
        owner,
        popup,
        position
    );
    if(!local.has_value())
        return makeUnexpected(Failure());
    return HitEditCaretGeometry(lines, stops, local.value());
}

Expected<usize> HitUiEditBoxWordGeometry(
    in u64 generation,
    in Span<EditBoxCaretStop> stops,
    in Span<EditCaretLine> lines,
    in u64 geometryModelGeneration,
    in PopupToken geometryPopup,
    in EditTextMode textMode,
    in EditBoxPlacement placement,
    in UiTextEditOwner owner,
    in PopupToken popup,
    in Point position
){
    const Expected<Point> local = ResolveLocalUiEditTextPosition(
        generation,
        stops,
        lines,
        geometryModelGeneration,
        geometryPopup,
        textMode,
        placement,
        owner,
        popup,
        position
    );
    if(!local.has_value())
        return makeUnexpected(Failure());
    usize committedByte = 0u;
    if(!TryHitEditWordCaretGeometry(lines, stops, local.value(), committedByte))
        return makeUnexpected(Failure());
    return committedByte;
}

usize ComputeUiTextEditRetainedBytes(in EditCompositionView composition, in usize textLength, in usize selectionStart, in usize selectionEnd){
    usize replaced = selectionEnd - selectionStart;
    if(composition.active)
        replaced = composition.replacementEnd - composition.replacementStart;
    return textLength - replaced;
}

b8 ValidateUiTextEditSurroundingDeleteRange(in usize deleteBeforeBytes, in usize deleteAfterBytes, in usize startOffset, in usize endOffset, in usize textLength){
    return deleteBeforeBytes <= startOffset && deleteAfterBytes <= textLength - endOffset;
}

b8 ValidateUiTextEditPollSequence(in u64 eventSequence, in u64 lastSequence, in usize eventIndex, in usize maxEvents){
    return eventSequence > lastSequence && eventIndex < maxEvents;
}

b8 ValidateUiEditClipboardActionMode(
    in EditClipboardAction action,
    in b8 readOnly,
    in b8 compositionActive,
    in b8 hasSelection,
    mut b8 outReads,
    mut UiEditClipboardStatus outStatus
){
    outReads = false;
    outStatus = UiEditClipboardStatus::Idle;
    if(action == EditClipboardAction::None || cast<u8>(action) > cast<u8>(EditClipboardAction::PublishSelection)){
        outStatus = UiEditClipboardStatus::InvalidAction;
        return false;
    }
    outReads = action == EditClipboardAction::Paste;
    const b8 mutates = outReads || action == EditClipboardAction::Cut;
    if(readOnly && mutates){
        outStatus = UiEditClipboardStatus::ReadOnly;
        return false;
    }
    if(compositionActive){
        outStatus = UiEditClipboardStatus::CompositionActive;
        return false;
    }
    if(!outReads && !hasSelection){
        outStatus = UiEditClipboardStatus::NoSelection;
        return false;
    }
    return true;
}


