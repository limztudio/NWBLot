    public b8 setBodyEnabled(in EntityID entity, in b8 enabled){
        const auto found = this.m_entityRecords.find(entity);
        if(found == this.m_entityRecords.end() || found.value().attachedToParentBody || !found.value().bodyId.valid())
            return false;
        const BodyId bodyId = found.value().bodyId;
        if(!this.m_physicsWorld.setBodyEnabled(bodyId, enabled))
            return false;
        ClearStaticBodyPoseCacheIfMatches(bodyId, this.m_syncScratch.staticBodyPoseCache);
        if(this.m_world.alive(entity)){
            const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
            if(rbOpt.has_value()){
                rbOpt.value().isEnabled = enabled;
                SyncRigidBodyVelocityAndAwakeDirect(this.m_physicsWorld, bodyId.index, rbOpt.value());
            }
        }
        return true;
    }

    public b8 setBodyType(in EntityID entity, in BodyType newType){
        const auto found = this.m_entityRecords.find(entity);
        if(found == this.m_entityRecords.end() || found.value().attachedToParentBody || !found.value().bodyId.valid())
            return false;
        const BodyId bodyId = found.value().bodyId;
        if(!this.m_physicsWorld.setBodyType(bodyId, newType))
            return false;
        ClearStaticBodyPoseCacheIfMatches(bodyId, this.m_syncScratch.staticBodyPoseCache);
        if(newType != BodyType::Static){
            const Expected<Transform3D> curXf = this.m_physicsWorld.tryGetBodyTransform(bodyId);
            if(curXf.has_value())
                SetBodyTransformSnapshotBoth(bodyId, curXf.value(), this.m_bodyTransformSnapshots, this.m_bodyTransformSnapshotMeta);
        }
        if(this.m_world.alive(entity)){
            const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
            if(rbOpt.has_value()){
                rbOpt.value().type = newType;
                SyncRigidBodyVelocityAndAwakeDirect(this.m_physicsWorld, bodyId.index, rbOpt.value());
            }
        }
        return true;
    }

    public b8 setBodyTransform(in EntityID entity, in VectorSingle position, in VectorSingle rotation){
        const auto found = this.m_entityRecords.find(entity);
        if(found == this.m_entityRecords.end() || found.value().attachedToParentBody || !found.value().bodyId.valid())
            return false;
        const BodyId bodyId = found.value().bodyId;
        if(!this.m_physicsWorld.setBodyTransform(bodyId, position, rotation))
            return false;
        if(this.m_physicsWorld.m_bodies[bodyId.index].type == BodyType::Static)
            MarkStaticBodyMoved(bodyId, this.m_syncScratch.movedStaticBodyFlags, this.m_syncScratch.movedStaticBodyIndices);
        const Transform3D normXf(position, SafeNormalizeQuat(rotation));
        SetBodySyncedPose(bodyId, normXf, this.m_syncScratch.bodySyncedPoses);
        SetBodyTransformSnapshotBoth(bodyId, normXf, this.m_bodyTransformSnapshots, this.m_bodyTransformSnapshotMeta);
        ClearStaticBodyPoseCacheIfMatches(bodyId, this.m_syncScratch.staticBodyPoseCache);
        if(this.m_world.alive(entity)){
            if(this.m_hasAnyPhysicsParents)
                this.m_syncScratch.writeBackPoseCache.clear();
            WriteWorldPoseBackToEntityTransform(entity, normXf, this.m_hasAnyPhysicsParents, this.m_world, this.m_syncScratch.writeBackPoseCache);
            this.syncEcsRigidBodyRuntimeState(entity, bodyId);
        }
        return true;
    }

