void VerifyUiPopupContextTests_PendingOpenPreservesBaseFocusAndRoutingUntilExactAcceptance(mut UiPopupContextTests self){
    const auto baseResult = self.focusBase();
    ASSERT_TRUE(baseResult.has_value());
    const UiPopupFrame base = baseResult.value();
    const auto candidateResult = self.prepare(2u, true);
    ASSERT_TRUE(candidateResult.has_value());
    const UiPopupFrame candidate = candidateResult.value();
    ASSERT_TRUE(candidate.child.id.valid());
    EXPECT_TRUE(self.m_context.ready());
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_EQ(self.m_context.input().focus(), base.base.id);
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiPopupPoint(15.0f, 15.0f)), base.base.id);
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiPopupPoint(115.0f, 55.0f)).valid());
    EXPECT_FALSE(self.m_context.input().wouldConsumePointer(MakeUiPopupPoint(350.0f, 250.0f)));
    EXPECT_FALSE(self.m_context.commitFrame(3u));
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_EQ(self.m_context.input().focus(), base.base.id);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_TRUE(self.m_context.input().hasPopup());
    EXPECT_EQ(self.m_context.input().focus(), candidate.child.id);
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiPopupPoint(115.0f, 55.0f)), candidate.child.id);
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiPopupPoint(15.0f, 15.0f)).valid());
    EXPECT_TRUE(self.m_context.input().wouldConsumePointer(MakeUiPopupPoint(350.0f, 250.0f)));
}

void VerifyUiPopupContextTests_PendingGeometryKeepsAcceptedHitBoundsAndChildFocus(mut UiPopupContextTests self){
    const auto originalResult = self.prepare(1u, true);
    ASSERT_TRUE(originalResult.has_value());
    const UiPopupFrame original = originalResult.value();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const auto candidateResult = self.prepare(2u, true, MakeUiPopupRect(200.0f, 160.0f, 160.0f, 100.0f));
    ASSERT_TRUE(candidateResult.has_value());
    const UiPopupFrame candidate = candidateResult.value();
    EXPECT_EQ(candidate.child.id, original.child.id);
    EXPECT_EQ(candidate.child.declarationGeneration, original.child.declarationGeneration);
    EXPECT_EQ(self.m_context.input().focus(), original.child.id);
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiPopupPoint(115.0f, 55.0f)), original.child.id);
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiPopupPoint(215.0f, 175.0f)).valid());
    EXPECT_FALSE(self.m_context.commitFrame(1u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().focus(), original.child.id);
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiPopupPoint(115.0f, 55.0f)).valid());
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiPopupPoint(215.0f, 175.0f)), candidate.child.id);
}

void VerifyUiPopupContextTests_ScopeOmissionRetainsLiveAcceptedDeclarationsUntilCommitThenRestoresFocus(mut UiPopupContextTests self){
    const auto baseResult = self.focusBase();
    ASSERT_TRUE(baseResult.has_value());
    const UiPopupFrame base = baseResult.value();
    const auto openedResult = self.prepare(2u, true);
    ASSERT_TRUE(openedResult.has_value());
    const UiPopupFrame opened = openedResult.value();
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().focus(), opened.child.id);
    const auto closedResult = self.prepare(3u, false, opened.scope.bounds, true);
    ASSERT_TRUE(closedResult.has_value());
    const UiPopupFrame closed = closedResult.value();
    EXPECT_EQ(closed.child.id, opened.child.id);
    EXPECT_EQ(closed.child.declarationGeneration, opened.child.declarationGeneration);
    EXPECT_TRUE(self.m_context.input().hasPopup());
    EXPECT_EQ(self.m_context.input().focus(), opened.child.id);
    EXPECT_TRUE(self.m_context.input().wouldConsumePointer(MakeUiPopupPoint(350.0f, 250.0f)));
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiPopupPoint(15.0f, 15.0f)).valid());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_EQ(self.m_context.input().focus(), base.base.id);
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiPopupPoint(15.0f, 15.0f)), base.base.id);
    EXPECT_FALSE(self.m_context.input().wouldConsumePointer(MakeUiPopupPoint(350.0f, 250.0f)));
}

void VerifyUiPopupContextTests_RemovingPopupDeclarationImmediatelyRetiresAcceptedScopeAndActions(mut UiPopupContextTests self){
    const auto originalResult = self.prepare(1u, true);
    ASSERT_TRUE(originalResult.has_value());
    const UiPopupFrame original = originalResult.value();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    self.click(MakeUiPopupPoint(115.0f, 55.0f));
    ASSERT_EQ(self.m_context.input().actions().size(), 1u);
    ASSERT_TRUE(self.begin(2u));
    const auto baseResult = self.button(s_UiPopupContextBaseKey, MakeUiPopupRect(10.0f, 10.0f, 60.0f, 24.0f));
    ASSERT_TRUE(baseResult.has_value());
    const WidgetState base = baseResult.value();
    ASSERT_TRUE(self.finish());
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_TRUE(self.m_context.input().actions().empty());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiPopupPoint(115.0f, 55.0f)).valid());
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiPopupPoint(15.0f, 15.0f)), base.id);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    const auto recreatedResult = self.prepare(3u, true);
    ASSERT_TRUE(recreatedResult.has_value());
    const UiPopupFrame recreated = recreatedResult.value();
    EXPECT_EQ(recreated.popup.id, original.popup.id);
    EXPECT_GT(recreated.popup.declarationGeneration, original.popup.declarationGeneration);
    EXPECT_GT(recreated.child.declarationGeneration, original.child.declarationGeneration);
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_TRUE(self.m_context.input().actions().empty());
}

void VerifyUiPopupContextTests_RootRetirementRemovesAcceptedAndPendingPopupOwnershipImmediately(mut UiPopupContextTests self){
    const auto originalResult = self.prepare(1u, true);
    ASSERT_TRUE(originalResult.has_value());
    const UiPopupFrame original = originalResult.value();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    self.click(MakeUiPopupPoint(115.0f, 55.0f));
    ASSERT_EQ(self.m_context.input().actions().size(), 1u);
    const auto pendingResult = self.prepare(2u, true);
    ASSERT_TRUE(pendingResult.has_value());
    const UiPopupFrame pending = pendingResult.value();
    EXPECT_EQ(pending.popup.id, original.popup.id);
    self.clearRetainedRoots();
    EXPECT_TRUE(self.m_context.states().entries().empty());
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_FALSE(self.m_context.input().capture().valid());
    EXPECT_TRUE(self.m_context.input().actions().empty());
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiPopupPoint(115.0f, 55.0f)).valid());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_TRUE(self.m_context.input().targets().empty());
    EXPECT_FALSE(self.m_context.input().hasPopup());
}

void VerifyUiPopupContextTests_ReopeningSameWidgetCannotBorrowAnActivationFromItsPreviousOpenEpoch(mut UiPopupContextTests self){
    const auto originalResult = self.prepare(1u, true);
    ASSERT_TRUE(originalResult.has_value());
    const UiPopupFrame original = originalResult.value();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    self.click(MakeUiPopupPoint(115.0f, 55.0f));
    ASSERT_EQ(self.m_context.input().actions().size(), 1u);
    ASSERT_TRUE(self.begin(2u));
    const auto baseResult = self.button(s_UiPopupContextBaseKey, MakeUiPopupRect(10.0f, 10.0f, 60.0f, 24.0f));
    ASSERT_TRUE(baseResult.has_value());
    const WidgetState base = baseResult.value();
    EXPECT_EQ(base.id, original.base.id);
    const auto ownerResult = self.declare(s_UiPopupContextPopupKey, WidgetKind::Popup);
    ASSERT_TRUE(ownerResult.has_value());
    const WidgetState owner = ownerResult.value();
    EXPECT_EQ(owner.id, original.popup.id);
    EXPECT_EQ(owner.declarationGeneration, original.popup.declarationGeneration);
    const PopupScope reopened = self.scope(owner, original.scope.bounds, 1u, 2u);
    ASSERT_TRUE(self.m_context.beginPopupScope(owner, reopened));
    self.addOwner(owner, reopened);
    ASSERT_TRUE(self.m_context.pushScope(s_UiPopupContextPopupKey));
    const auto childResult = self.button(s_UiPopupContextChildKey, MakeUiPopupRect(110.0f, 50.0f, 60.0f, 24.0f));
    ASSERT_TRUE(childResult.has_value());
    const WidgetState child = childResult.value();
    EXPECT_EQ(child.id, original.child.id);
    EXPECT_EQ(child.declarationGeneration, original.child.declarationGeneration);
    EXPECT_FALSE(self.m_context.takeActivation(child, true));
    ASSERT_TRUE(self.m_context.popScope());
    ASSERT_TRUE(self.m_context.endPopupScope(true));
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_TRUE(self.m_context.input().actions().empty());
    self.click(MakeUiPopupPoint(115.0f, 55.0f));
    ASSERT_TRUE(self.begin(3u));
    const auto freshBaseResult = self.button(s_UiPopupContextBaseKey, MakeUiPopupRect(10.0f, 10.0f, 60.0f, 24.0f));
    ASSERT_TRUE(freshBaseResult.has_value());
    const WidgetState freshBase = freshBaseResult.value();
    EXPECT_EQ(freshBase.id, original.base.id);
    const auto freshOwnerResult = self.declare(s_UiPopupContextPopupKey, WidgetKind::Popup);
    ASSERT_TRUE(freshOwnerResult.has_value());
    const WidgetState freshOwner = freshOwnerResult.value();
    const PopupScope current = self.scope(freshOwner, original.scope.bounds, 1u, 2u);
    ASSERT_TRUE(self.m_context.beginPopupScope(freshOwner, current));
    self.addOwner(freshOwner, current);
    ASSERT_TRUE(self.m_context.pushScope(s_UiPopupContextPopupKey));
    const auto freshChildResult = self.button(s_UiPopupContextChildKey, MakeUiPopupRect(110.0f, 50.0f, 60.0f, 24.0f));
    ASSERT_TRUE(freshChildResult.has_value());
    const WidgetState freshChild = freshChildResult.value();
    EXPECT_TRUE(self.m_context.takeActivation(freshChild, true));
    EXPECT_FALSE(self.m_context.takeActivation(freshChild, true));
    ASSERT_TRUE(self.m_context.popScope());
    ASSERT_TRUE(self.m_context.endPopupScope(true));
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
}

void VerifyUiPopupContextTests_TargetsInSequentialScopesReceiveDistinctLayersThenRestoreBaseLayer(mut UiPopupContextTests self){
    ASSERT_TRUE(self.begin(1u));
    const auto baseResult = self.declare(s_UiPopupContextBaseKey, WidgetKind::Button);
    ASSERT_TRUE(baseResult.has_value());
    const WidgetState base = baseResult.value();
    HitTarget spoofed = HitTarget();
    spoofed.rectangle = MakeUiPopupRect(10.0f, 10.0f, 60.0f, 24.0f);
    spoofed.clip = MakeUiPopupRect(0.0f, 0.0f, 400.0f, 300.0f);
    spoofed.focusable = true;
    spoofed.activatable = true;
    spoofed.popup.widget.value = 999u;
    spoofed.popup.declarationGeneration = 7u;
    spoofed.popup.instanceGeneration = 8u;
    spoofed.popup.openGeneration = 9u;
    spoofed.layer = 99u;
    ASSERT_TRUE(self.m_context.addTarget(base, spoofed));
    EXPECT_EQ(self.m_context.popupLayer(), 0u);
    const auto firstOwnerResult = self.declare("first", WidgetKind::Popup);
    ASSERT_TRUE(firstOwnerResult.has_value());
    const WidgetState firstOwner = firstOwnerResult.value();
    const PopupScope first = self.scope(firstOwner);
    ASSERT_TRUE(self.m_context.beginPopupScope(firstOwner, first));
    EXPECT_EQ(self.m_context.popupLayer(), 1u);
    self.addOwner(firstOwner, first);
    ASSERT_TRUE(self.m_context.pushScope("first"));
    const auto firstChildResult = self.button(s_UiPopupContextChildKey, MakeUiPopupRect(110.0f, 50.0f, 60.0f, 24.0f));
    ASSERT_TRUE(firstChildResult.has_value());
    const WidgetState firstChild = firstChildResult.value();
    ASSERT_TRUE(self.m_context.popScope());
    ASSERT_TRUE(self.m_context.endPopupScope(true));
    EXPECT_EQ(self.m_context.popupLayer(), 0u);
    const auto secondOwnerResult = self.declare("second", WidgetKind::Popup);
    ASSERT_TRUE(secondOwnerResult.has_value());
    const WidgetState secondOwner = secondOwnerResult.value();
    const PopupScope second = self.scope(secondOwner, MakeUiPopupRect(200.0f, 120.0f, 160.0f, 100.0f));
    ASSERT_TRUE(self.m_context.beginPopupScope(secondOwner, second));
    EXPECT_EQ(self.m_context.popupLayer(), 2u);
    self.addOwner(secondOwner, second);
    ASSERT_TRUE(self.m_context.pushScope("second"));
    const auto secondChildResult = self.button(s_UiPopupContextChildKey, MakeUiPopupRect(210.0f, 130.0f, 60.0f, 24.0f));
    ASSERT_TRUE(secondChildResult.has_value());
    const WidgetState secondChild = secondChildResult.value();
    ASSERT_TRUE(self.m_context.popScope());
    ASSERT_TRUE(self.m_context.endPopupScope(true));
    EXPECT_EQ(self.m_context.popupLayer(), 0u);
    const auto tailResult = self.button("tail", MakeUiPopupRect(80.0f, 10.0f, 60.0f, 24.0f));
    ASSERT_TRUE(tailResult.has_value());
    const WidgetState tail = tailResult.value();
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const auto baseHit = self.findTarget(base.id);
    const auto firstOwnerHit = self.findTarget(firstOwner.id);
    const auto firstChildHit = self.findTarget(firstChild.id);
    const auto secondOwnerHit = self.findTarget(secondOwner.id);
    const auto secondChildHit = self.findTarget(secondChild.id);
    const auto tailHit = self.findTarget(tail.id);
    ASSERT_TRUE(baseHit.has_value());
    ASSERT_TRUE(firstOwnerHit.has_value());
    ASSERT_TRUE(firstChildHit.has_value());
    ASSERT_TRUE(secondOwnerHit.has_value());
    ASSERT_TRUE(secondChildHit.has_value());
    ASSERT_TRUE(tailHit.has_value());
    EXPECT_FALSE(baseHit.value().popup.valid());
    EXPECT_EQ(baseHit.value().layer, 0u);
    EXPECT_TRUE(firstOwnerHit.value().popup == first.token);
    EXPECT_TRUE(firstChildHit.value().popup == first.token);
    EXPECT_EQ(firstOwnerHit.value().layer, 1u);
    EXPECT_EQ(firstChildHit.value().layer, 1u);
    EXPECT_TRUE(secondOwnerHit.value().popup == second.token);
    EXPECT_TRUE(secondChildHit.value().popup == second.token);
    EXPECT_EQ(secondOwnerHit.value().layer, 2u);
    EXPECT_EQ(secondChildHit.value().layer, 2u);
    EXPECT_FALSE(tailHit.value().popup.valid());
    EXPECT_EQ(tailHit.value().layer, 0u);
    EXPECT_EQ(self.m_context.input().focus(), secondChild.id);
}

void VerifyUiPopupContextTests_NestedScopeWithoutItsParentTokenPoisonsCandidateWithoutPublishingIt(mut UiPopupContextTests self){
    const auto acceptedResult = self.focusBase();
    ASSERT_TRUE(acceptedResult.has_value());
    const UiPopupFrame accepted = acceptedResult.value();
    ASSERT_TRUE(self.begin(2u));
    const auto ownerResult = self.declare(s_UiPopupContextPopupKey, WidgetKind::Popup);
    ASSERT_TRUE(ownerResult.has_value());
    const WidgetState owner = ownerResult.value();
    const PopupScope popup = self.scope(owner);
    ASSERT_TRUE(self.m_context.beginPopupScope(owner, popup));
    const auto nestedOwnerResult = self.declare("nested", WidgetKind::Popup);
    ASSERT_TRUE(nestedOwnerResult.has_value());
    const WidgetState nestedOwner = nestedOwnerResult.value();
    EXPECT_FALSE(self.m_context.beginPopupScope(nestedOwner, self.scope(nestedOwner)));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    EXPECT_EQ(self.m_context.input().focus(), accepted.base.id);
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiPopupPoint(15.0f, 15.0f)), accepted.base.id);
}

void VerifyUiPopupContextTests_UnbalancedPopupScopeCannotPublishItsCandidate(mut UiPopupContextTests self){
    const auto acceptedResult = self.focusBase();
    ASSERT_TRUE(acceptedResult.has_value());
    const UiPopupFrame accepted = acceptedResult.value();
    ASSERT_TRUE(self.begin(2u));
    const auto unbalancedOwnerResult = self.declare(s_UiPopupContextPopupKey, WidgetKind::Popup);
    ASSERT_TRUE(unbalancedOwnerResult.has_value());
    const WidgetState unbalancedOwner = unbalancedOwnerResult.value();
    ASSERT_TRUE(self.m_context.beginPopupScope(unbalancedOwner, self.scope(unbalancedOwner)));
    EXPECT_FALSE(self.m_context.endRoot());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    EXPECT_EQ(self.m_context.input().focus(), accepted.base.id);
}

void VerifyUiPopupContextTests_CapacityRejectsNinthScopeBeforePublishingAnyCandidate(mut UiPopupContextTests self){
    const auto acceptedResult = self.focusBase();
    ASSERT_TRUE(acceptedResult.has_value());
    const UiPopupFrame accepted = acceptedResult.value();
    ASSERT_TRUE(self.begin(2u));
    Array<StringView, 8u> keys = Array<StringView, 8u>();
    keys[0u] = "popup0";
    keys[1u] = "popup1";
    keys[2u] = "popup2";
    keys[3u] = "popup3";
    keys[4u] = "popup4";
    keys[5u] = "popup5";
    keys[6u] = "popup6";
    keys[7u] = "popup7";
    for(usize index = 0u; index < s_InputMaxPopups; ++index){
        const auto ownerResult = self.declare(keys[index], WidgetKind::Popup);
        ASSERT_TRUE(ownerResult.has_value());
        const WidgetState owner = ownerResult.value();
        const PopupScope popup = self.scope(owner);
        ASSERT_TRUE(self.m_context.beginPopupScope(owner, popup));
        EXPECT_EQ(self.m_context.popupLayer(), cast<u32>(index + 1u));
        self.addOwner(owner, popup);
        ASSERT_TRUE(self.m_context.endPopupScope(true));
    }
    const auto overflowResult = self.declare("popup8", WidgetKind::Popup);
    ASSERT_TRUE(overflowResult.has_value());
    const WidgetState overflow = overflowResult.value();
    EXPECT_FALSE(self.m_context.beginPopupScope(overflow, self.scope(overflow)));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_EQ(self.m_context.input().focus(), accepted.base.id);
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
}

void VerifyUiPopupContextTests_DuplicateOwnerOrMismatchedTokenCannotPublishAScope(mut UiPopupContextTests self){
    const auto acceptedResult = self.focusBase();
    ASSERT_TRUE(acceptedResult.has_value());
    const UiPopupFrame accepted = acceptedResult.value();
    ASSERT_TRUE(self.begin(2u));
    const auto ownerResult = self.declare(s_UiPopupContextPopupKey, WidgetKind::Popup);
    ASSERT_TRUE(ownerResult.has_value());
    const WidgetState owner = ownerResult.value();
    const PopupScope popup = self.scope(owner);
    ASSERT_TRUE(self.m_context.beginPopupScope(owner, popup));
    self.addOwner(owner, popup);
    ASSERT_TRUE(self.m_context.endPopupScope(true));
    EXPECT_FALSE(self.m_context.beginPopupScope(owner, popup));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().focus(), accepted.base.id);
    EXPECT_FALSE(self.m_context.input().hasPopup());
    self.m_context.abandonFrame();
    ASSERT_TRUE(self.begin(3u));
    const auto currentResult = self.declare(s_UiPopupContextPopupKey, WidgetKind::Popup);
    ASSERT_TRUE(currentResult.has_value());
    const WidgetState current = currentResult.value();
    PopupScope stale = self.scope(current);
    ++stale.token.declarationGeneration;
    EXPECT_FALSE(self.m_context.beginPopupScope(current, stale));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(3u));
}

void VerifyUiPopupContextTests_AutofocusDisabledChangesFocusOnlyAtAcceptanceAndTabEntersPopup(mut UiPopupContextTests self){
    const auto acceptedResult = self.focusBase();
    ASSERT_TRUE(acceptedResult.has_value());
    const UiPopupFrame accepted = acceptedResult.value();
    const auto candidateResult = self.prepare(2u, true, MakeUiPopupRect(100.0f, 40.0f, 160.0f, 100.0f), false, false);
    ASSERT_TRUE(candidateResult.has_value());
    const UiPopupFrame candidate = candidateResult.value();
    EXPECT_EQ(self.m_context.input().focus(), accepted.base.id);
    EXPECT_FALSE(self.m_context.input().hasPopup());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_TRUE(self.m_context.input().hasPopup());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_TRUE(self.m_context.input().wantsCommands());
    EXPECT_TRUE(self.send(MakeUiPopupKeyEvent(InputEventType::KeyDown, Key::Tab)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiPopupKeyEvent(InputEventType::KeyUp, Key::Tab)).commandConsumed);
    EXPECT_EQ(self.m_context.input().focus(), candidate.child.id);
}

void VerifyUiPopupContextTests_MissingOwnerTargetRejectsCommitWithoutReplacingAcceptedFocusOrLayout(mut UiPopupContextTests self){
    const auto acceptedResult = self.focusBase();
    ASSERT_TRUE(acceptedResult.has_value());
    const UiPopupFrame accepted = acceptedResult.value();
    ASSERT_TRUE(self.begin(2u));
    const auto baseResult = self.button(s_UiPopupContextBaseKey, MakeUiPopupRect(10.0f, 10.0f, 60.0f, 24.0f));
    ASSERT_TRUE(baseResult.has_value());
    const WidgetState base = baseResult.value();
    EXPECT_EQ(base.id, accepted.base.id);
    const auto ownerResult = self.declare(s_UiPopupContextPopupKey, WidgetKind::Popup);
    ASSERT_TRUE(ownerResult.has_value());
    const WidgetState owner = ownerResult.value();
    ASSERT_TRUE(self.m_context.beginPopupScope(owner, self.scope(owner)));
    ASSERT_TRUE(self.m_context.pushScope(s_UiPopupContextPopupKey));
    const auto childResult = self.button(s_UiPopupContextChildKey, MakeUiPopupRect(110.0f, 50.0f, 60.0f, 24.0f));
    ASSERT_TRUE(childResult.has_value());
    const WidgetState child = childResult.value();
    EXPECT_TRUE(child.id.valid());
    ASSERT_TRUE(self.m_context.popScope());
    ASSERT_TRUE(self.m_context.endPopupScope(true));
    ASSERT_TRUE(self.finish());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_TRUE(self.m_context.ready());
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    EXPECT_EQ(self.m_context.input().focus(), accepted.base.id);
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiPopupPoint(15.0f, 15.0f)), accepted.base.id);
    EXPECT_FALSE(self.m_context.input().wouldConsumePointer(MakeUiPopupPoint(350.0f, 250.0f)));
}

void VerifyUiPopupContextTests_FocusLossFencesPreparedOpenBeforeItsFirstAcceptance(mut UiPopupContextTests self){
    const auto baseResult = self.focusBase();
    ASSERT_TRUE(baseResult.has_value());
    const UiPopupFrame base = baseResult.value();
    const auto candidateResult = self.prepare(2u, true);
    ASSERT_TRUE(candidateResult.has_value());
    const UiPopupFrame candidate = candidateResult.value();
    EXPECT_EQ(self.m_context.input().focus(), base.base.id);
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_TRUE(self.send(MakeUiPopupBareEvent(InputEventType::FocusLost)).commandConsumed);
    EXPECT_FALSE(self.m_context.input().focus().valid());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 2u);
    EXPECT_TRUE(self.m_context.input().hasPopup());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiPopupPoint(115.0f, 55.0f)).valid());
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiPopupPoint(15.0f, 15.0f)).valid());
    EXPECT_TRUE(self.m_context.input().actions().empty());
    const auto reasonResult = self.m_context.input().consumePopupDismissal(candidate.scope.token);
    ASSERT_TRUE(reasonResult.has_value());
    EXPECT_EQ(reasonResult.value(), PopupDismissReason::FocusLost);
    EXPECT_FALSE(self.m_context.input().consumePopupDismissal(candidate.scope.token).has_value());
}

void VerifyUiPopupContextTests_FocusLossFencesPreparedHigherPopupAboveAcceptedLowerScope(mut UiPopupContextTests self){
    const auto originalResult = self.prepare(1u, true);
    ASSERT_TRUE(originalResult.has_value());
    const UiPopupFrame original = originalResult.value();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    ASSERT_EQ(self.m_context.input().focus(), original.child.id);
    const auto candidateResult = self.prepareStack(2u);
    ASSERT_TRUE(candidateResult.has_value());
    const UiPopupStack candidate = candidateResult.value();
    EXPECT_TRUE(candidate.lower.scope.token == original.scope.token);
    EXPECT_EQ(self.m_context.input().focus(), original.child.id);
    EXPECT_TRUE(self.send(MakeUiPopupBareEvent(InputEventType::FocusLost)).commandConsumed);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiPopupPoint(115.0f, 55.0f)).valid());
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiPopupPoint(215.0f, 135.0f)).valid());
    EXPECT_TRUE(self.m_context.input().actions().empty());
    const auto lowerResult = self.m_context.input().consumePopupDismissal(candidate.lower.scope.token);
    ASSERT_TRUE(lowerResult.has_value());
    const auto higherResult = self.m_context.input().consumePopupDismissal(candidate.higher.scope.token);
    ASSERT_TRUE(higherResult.has_value());
    EXPECT_EQ(lowerResult.value(), PopupDismissReason::FocusLost);
    EXPECT_EQ(higherResult.value(), PopupDismissReason::FocusLost);
    EXPECT_FALSE(self.m_context.input().consumePopupDismissal(candidate.lower.scope.token).has_value());
    EXPECT_FALSE(self.m_context.input().consumePopupDismissal(candidate.higher.scope.token).has_value());
}

void VerifyUiPopupContextTests_NativeFocusGainCannotReviveCandidatePreparedBeforeFocusLoss(mut UiPopupContextTests self){
    const auto baseResult = self.focusBase();
    ASSERT_TRUE(baseResult.has_value());
    const UiPopupFrame base = baseResult.value();
    const auto candidateResult = self.prepare(2u, true);
    ASSERT_TRUE(candidateResult.has_value());
    const UiPopupFrame candidate = candidateResult.value();
    EXPECT_EQ(self.m_context.input().focus(), base.base.id);
    EXPECT_TRUE(self.send(MakeUiPopupBareEvent(InputEventType::FocusLost)).commandConsumed);
    EXPECT_FALSE(self.send(MakeUiPopupBareEvent(InputEventType::FocusGained)).focus.valid());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiPopupPoint(115.0f, 55.0f)).valid());
    const auto reasonResult = self.m_context.input().consumePopupDismissal(candidate.scope.token);
    ASSERT_TRUE(reasonResult.has_value());
    EXPECT_EQ(reasonResult.value(), PopupDismissReason::FocusLost);
    EXPECT_TRUE(self.m_context.input().actions().empty());
}

void VerifyUiPopupContextTests_FreshPopupPreparedAfterNativeFocusGainMayAutofocus(mut UiPopupContextTests self){
    const auto baseResult = self.focusBase();
    ASSERT_TRUE(baseResult.has_value());
    const UiPopupFrame base = baseResult.value();
    EXPECT_TRUE(self.send(MakeUiPopupBareEvent(InputEventType::FocusLost)).commandConsumed);
    EXPECT_FALSE(self.send(MakeUiPopupBareEvent(InputEventType::FocusGained)).focus.valid());
    const auto freshResult = self.prepare(2u, true);
    ASSERT_TRUE(freshResult.has_value());
    const UiPopupFrame fresh = freshResult.value();
    EXPECT_EQ(fresh.base.id, base.base.id);
    EXPECT_FALSE(self.m_context.input().focus().valid());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().focus(), fresh.child.id);
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiPopupPoint(115.0f, 55.0f)), fresh.child.id);
    EXPECT_FALSE(self.m_context.input().consumePopupDismissal(fresh.scope.token).has_value());
    self.click(MakeUiPopupPoint(115.0f, 55.0f));
    EXPECT_EQ(self.m_context.input().actions().size(), 1u);
}

void VerifyUiPopupContextTests_NativeFocusGainNeverRestoresAlreadyClosingScopes(mut UiPopupContextTests self){
    const auto baseResult = self.focusBase();
    ASSERT_TRUE(baseResult.has_value());
    const UiPopupFrame base = baseResult.value();
    const auto originalResult = self.prepare(2u, true);
    ASSERT_TRUE(originalResult.has_value());
    const UiPopupFrame original = originalResult.value();
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    ASSERT_EQ(self.m_context.input().focus(), original.child.id);
    EXPECT_TRUE(self.send(MakeUiPopupBareEvent(InputEventType::FocusLost)).commandConsumed);
    EXPECT_FALSE(self.send(MakeUiPopupBareEvent(InputEventType::FocusGained)).focus.valid());
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiPopupPoint(115.0f, 55.0f)).valid());
    const auto retainedResult = self.prepare(3u, true);
    ASSERT_TRUE(retainedResult.has_value());
    const UiPopupFrame retained = retainedResult.value();
    EXPECT_TRUE(retained.scope.token == original.scope.token);
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiPopupPoint(115.0f, 55.0f)).valid());
    const auto reasonResult = self.m_context.input().consumePopupDismissal(original.scope.token);
    ASSERT_TRUE(reasonResult.has_value());
    EXPECT_EQ(reasonResult.value(), PopupDismissReason::FocusLost);
    const auto closedResult = self.prepare(4u, false, original.scope.bounds, true);
    ASSERT_TRUE(closedResult.has_value());
    const UiPopupFrame closed = closedResult.value();
    EXPECT_EQ(closed.base.id, base.base.id);
    ASSERT_TRUE(self.m_context.commitFrame(4u));
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_FALSE(self.send(MakeUiPopupBareEvent(InputEventType::FocusGained)).focus.valid());
}


