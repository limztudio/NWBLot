[cpp_unwind]
b8 RendererFramePipeline::validateResources(in u32 width, in u32 height, in u32 sampleCount){
    this.m_raytracingSystem.logCapabilityOnce();
    if(width == 0 || height == 0)
        return true;

    if(!this.m_activeSceneSubsystems.has_value()){
        if(!this.m_defaultSceneSubsystems.loadProjectStartScene(this.m_assetManager))
            return false;
        this.m_activeSceneSubsystems = Optional<in ActiveSceneSubsystems>(this.m_defaultSceneSubsystems);
        this.m_shaderSystem.setActiveSceneSubsystems(this.m_activeSceneSubsystems);
    }
    if(!this.m_activeSceneSubsystems.value().hasSubsystem<RendererSubsystem>()){
        error("RendererSystem: active scene does not include required subsystem 'renderer_subsystem'");
        return false;
    }

    const u32 surfelResolveFactor = cast<u32>(this.m_surfelGiQualitySettings.resolveResolution);
    const u32 shadowReceiverFactor = this.m_raytracingSystem.requestedShadowReceiverFactor();
    if(DoesFrameTargetScaleFactorRequireRecreation(this.m_frameTargets.surfelResolveFactor, surfelResolveFactor, this.m_frameTargets.shadowReceiverFactor, shadowReceiverFactor)){
        if(!this.m_graphics.waitForIdle())
            return false;
        this.invalidateResources();
    }

    RendererGpuTimingScopeReservations timingScopes;
    if(!timingScopes.prepare(this.m_graphics))
        warning("RendererSystem: GPU timing scope preparation failed; timing samples may be skipped");

    b8 targetsReady = AreDeferredFrameTargetDimensionsCurrent(
        this.m_frameTargets.valid(), this.m_frameTargets.width, this.m_frameTargets.height,
        this.m_frameTargets.surfelResolveFactor, this.m_frameTargets.shadowReceiverFactor, width, height, surfelResolveFactor, shadowReceiverFactor
    );
    if(!targetsReady){
        this.resetTargetGenerationStateHandoffs();
        this.resetLaggedLightingHistoryTracking();
        this.resetFrameTargets();
        this.m_materialSystem.invalidateRendererPipelines();

        DeferredFrameTargetBuilder targetBuilder(this.m_graphics, this.m_rayTracingState, this.m_deferredSystem, this.m_avboitSystem, this.m_csgSystem, this.m_raytracingSystem);
        auto createdTargetsResult = targetBuilder.build(width, height, shadowReceiverFactor, surfelResolveFactor);
        if(!createdTargetsResult.has_value())
            return false;
        this.commitFrameTargets(createdTargetsResult.value());
        targetsReady = this.m_deferredSystem.createDeferredLightingPipeline()
            && this.m_deferredSystem.createDeferredCompositePipeline()
            && this.m_deferredSystem.createDeferredDebugLinePipelines(this.m_frameTargets.compositeDebugFramebuffer.deref())
        ;
        if(!targetsReady)
            this.resetFrameTargets();
    }
    if(!targetsReady || !this.m_frameTargets.valid())
        return false;

    const FramebufferPtr presentationFramebuffer = this.m_graphics.getFramebuffer(0u);
    if(IsValidFramebufferPtr(presentationFramebuffer)){
        if(!this.m_deferredSystem.createDeferredPresentPipeline(DerefFramebufferPtr(presentationFramebuffer)))
            return false;
    }

    if(!this.m_reflectionSystem.prepareResources(width, height, this.m_graphics.queryFeatureSupport(Feature::RayQuery), false, this.m_reflectionSettings))
        return false;

    if(!this.m_materialSystem.prepareMaterialPassBindingLayout())
        return false;

    if(this.isTransparentFeatureEnabled() && !this.m_avboitSystem.createAvboitPipelines())
        return false;

    if(!this.m_meshSystem.createMeshViewBuffer())
        return false;

    if(this.isCsgFeatureEnabled()){
        if(!this.m_csgSystem.createCsgIntervalPeelResources(this.m_frameTargets, true))
            return false;
    }
    else{
        if(!this.m_csgSystem.createCsgClipResources())
            return false;
    }

    return true;
}

[cpp_unwind]
void RendererFramePipeline::invalidateResources(){
    this.m_opticalVolumes.reset();
    this.m_deferredTaskTimingFeedback.reset();
    this.m_deferredLightingTaskGraphQueueAssignmentTelemetry.reset();
    this.m_preparedCsgFrameState = CsgFrameState();
    this.m_preparedCsgFrameStateValid = false;
    this.m_preparedHasTransparentRenderers = false;
    this.m_preparedRefractionActive = false;
    this.m_preparedRefractionResources = RayTracingRefractionGraphResources();
    this.m_shadowPrepareGraph.m_shadowPreparationOutcome.resourcesValid = false;
    this.m_shadowPrepareGraph.m_shadowPreparationOutcome.ready = false;
    this.m_shadowPrepareGraph.resetShadowPrepareTaskState();
    this.m_preparedTaskGraphPresentationContributor.reset();
    this.m_preparedTaskGraphOutputLayerContributor.reset();
    this.resetFrameTaskState();
    [essential] assert(this.m_deferredLightingRecordedGraph.releaseCommandListCache(), "renderer resource invalidation requires idle command-list caches");
    this.resetInvalidatedResourceStateHandoffs();
    this.resetLaggedLightingHistoryTracking();
    this.m_frameRenderRecoveryFailed = false;
    this.m_reflectionSystem.invalidateResources();
    this.m_raytracingSystem.invalidateResources();
    this.resetFrameTargets();
    this.m_avboitSystem.invalidateResources();
    this.m_shaderSystem.invalidateResources();
    this.m_meshSystem.invalidateResources();
    this.m_materialSystem.invalidateResources();
    this.m_csgSystem.invalidateResources();
    this.m_deferredSystem.invalidateResources();
}

void RendererFramePipeline::update(mut World world, in f32 delta){}

[cpp_unwind]
b8 RendererFramePipeline::prepareResources(in FramebufferPtr framebuffer){
    this.m_shadowPrepareGraph.m_shadowPreparationOutcome.resourcesValid = false;
    this.m_shadowPrepareGraph.m_shadowPreparationOutcome.ready = false;
    this.m_preparedHasTransparentRenderers = false;
    this.m_preparedRefractionActive = false;
    this.m_preparedRefractionResources = RayTracingRefractionGraphResources();
    this.m_preparedTaskGraphPresentationContributor.reset();
    this.m_preparedTaskGraphOutputLayerContributor.reset();

    if(!IsValidFramebufferPtr(framebuffer))
        return false;

    const AcquiredPresentationFrame presentationFrame = this.m_graphics.acquiredPresentationFrame();
    in FramebufferDesc presentationFramebufferDesc = DerefFramebufferPtr(framebuffer).getDescription();
    if(!presentationFrame.valid() || presentationFrame.framebuffer.get() != framebuffer || presentationFramebufferDesc.colorAttachments.size() != 1u || !presentationFramebufferDesc.colorAttachments[0u].hasTexture(presentationFrame.backBuffer.texture.deref())){
        [essential] warning("RendererSystem: presentation preparation did not match the acquired frame; requesting recreation");
        this.m_graphics.requestDeviceRecreation();
        return false;
    }

    if(HasFrameTargetScaleFactorMismatch(this.m_frameTargets.surfelResolveFactor, cast<u32>(this.m_surfelGiQualitySettings.resolveResolution), this.m_frameTargets.shadowReceiverFactor, this.m_raytracingSystem.requestedShadowReceiverFactor())){
        in TextureDesc presentationDesc = presentationFrame.backBuffer.texture.deref().getDescription();
        if(!this.validateResources(presentationDesc.width, presentationDesc.height, presentationDesc.sampleCount))
            return false;
    }

    this.m_meshSystem.pruneRuntimeMeshResources();
    const b8 hasVisibleTransparentRenderers = this.m_materialSystem.prepareVisibleMaterialSurfaceInfos();
    this.m_preparedHasTransparentRenderers = this.isTransparentFeatureEnabled() && hasVisibleTransparentRenderers;
    this.m_materialSystem.prepareVisibleMaterialInstanceMutableCache();
    this.m_preparedCsgFrameState = CsgFrameState();
    this.m_preparedCsgFrameStateValid = false;

    if(!this.m_frameTargets.valid())
        return true;
    mut DeferredFrameTargets deferredTargets = this.m_frameTargets;

    this.m_reflectionSystem.pollStatistics();
    this.m_raytracingSystem.refraction().pollRefractionStatistics();
    if(this.m_preparedHasTransparentRenderers)
        this.m_opticalVolumes.prepare(this.m_world, this.m_materialSystem);
    else
        this.m_opticalVolumes.reset();
    if(this.isCsgFeatureEnabled() && HasCsgFrameCandidates(this.m_world))
        this.m_preparedCsgFrameState = this.m_csgSystem.buildFrameState(this.m_materialSystem);
    this.m_preparedCsgFrameStateValid = true;
    const b8 hasCsgFrameWork = !this.m_preparedCsgFrameState.empty();
    const b8 rayQuerySupported = this.m_graphics.queryFeatureSupport(Feature::RayQuery);
    if(!this.m_reflectionSystem.prepareResources(deferredTargets.width, deferredTargets.height, rayQuerySupported, hasCsgFrameWork && rayQuerySupported, this.m_reflectionSettings))
        return false;

    if(hasCsgFrameWork && !deferredTargets.csgIntervalTargetsValid())
        return false;

    usize csgReceiverRangeCount = 0u;
    if(hasCsgFrameWork)
        csgReceiverRangeCount = this.m_world.view<RendererComponent>().candidateCount();

    this.m_materialSystem.beginPreparedFrameCache();
    f32 meshViewAspectRatio = s_CameraFallbackAspectRatio;
    if(deferredTargets.framebuffer.valid()){
        in FramebufferInfoEx meshViewFramebufferInfo = deferredTargets.framebuffer.deref().getFramebufferInfo();
        if(meshViewFramebufferInfo.width != 0u && meshViewFramebufferInfo.height != 0u)
            meshViewAspectRatio = cast<f32>(meshViewFramebufferInfo.width) / cast<f32>(meshViewFramebufferInfo.height);
    }
    const MeshViewGpuData preparedMeshView = this.m_meshSystem.resolveMeshViewState(meshViewAspectRatio);
    const Optional<in MeshViewGpuData> preparedMeshViewOpt(preparedMeshView);

    if(!this.m_materialSystem.prepareMaterialPassResources(deferredTargets.framebuffer, MaterialPipelinePass::Opaque, false, this.m_preparedCsgFrameState, preparedMeshViewOpt))
        return false;

    if(this.m_preparedHasTransparentRenderers && !this.m_avboitSystem.prepareAvboitPassResources(this.m_preparedCsgFrameState, deferredTargets, preparedMeshViewOpt))
        return false;

    const MaterialPassBufferSnapshot materialBuffers = this.m_materialSystem.materialPassBufferSnapshot();
    if(materialBuffers.valid() && !this.m_meshSystem.prepareMeshFrameBindings(materialBuffers))
        return false;
    if(hasCsgFrameWork && !materialBuffers.valid())
        return false;

    if(hasCsgFrameWork && !this.m_csgSystem.prepareCsgFrameResources(csgReceiverRangeCount, cast<usize>(this.m_preparedCsgFrameState.cutterCount)))
        return false;

    this.m_raytracingSystem.discardSurfelResourceInitialization();
    if(!this.m_raytracingSystem.preflightShadowVisibilityResources(deferredTargets)){
        this.m_shadowPrepareGraph.m_shadowPreparationOutcome.resourcesValid = false;
        this.m_shadowPrepareGraph.m_shadowPreparationOutcome.ready = false;
        this.m_raytracingSystem.discardPreflightShadowVisibilityResources();
        return false;
    }
    this.m_shadowPrepareGraph.m_shadowPreparationOutcome.resourcesValid = true;
    this.m_preparedReflectionSceneAvailable = IsReflectionHardwareTraceRequested(this.m_reflectionSettings.traceMode) && this.m_raytracingSystem.prepareSceneQueryResources();
    ++this.m_reflectionFrameIndex;

    const b8 opticalCaptureRequested = this.m_preparedHasTransparentRenderers && (this.m_refractionEnabled || this.m_reflectionSettings.traceMode != ReflectionTraceMode::Disabled);
    this.m_preparedRefractionActive = opticalCaptureRequested && this.m_raytracingSystem.refraction().prepareRefractionResources();
    const b8 hasTransparentCsgFrameWork = HasTransparentCsgFrameWork(this.m_preparedCsgFrameState.hasTransparentStaticWork, this.m_preparedCsgFrameState.hasTransparentSkinnedWork);
    if(this.m_preparedRefractionActive && hasTransparentCsgFrameWork && !this.m_csgSystem.prepareRefractionIntervalCapResources(deferredTargets))
        return false;
    this.m_preparedRefractionResources = this.m_raytracingSystem.refraction().snapshotRefractionGraphResources(deferredTargets.width, deferredTargets.height, this.m_reflectionFrameIndex);
    this.m_preparedRefractionResources.refractionEnabled = this.m_refractionEnabled;
    if(!this.m_refractionEnabled){
        this.m_preparedRefractionResources.pipeline = this.m_preparedRefractionResources.screenFallbackPipeline;
        this.m_preparedRefractionResources.densePipeline = this.m_preparedRefractionResources.denseScreenFallbackPipeline;
        this.m_preparedRefractionResources.usesHardwareTrace = false;
        this.m_preparedRefractionResources.tlasHeapHandle = GpuDescriptorHandle::Invalid();
    }

    const auto outputLayerContributor = this.m_graphics.borrowTaskGraphOutputLayerContributor();
    if(outputLayerContributor.has_value()){
        if(outputLayerContributor.value().prepareTaskGraphOutputLayer(presentationFrame))
            this.m_preparedTaskGraphOutputLayerContributor = outputLayerContributor;
        else if(this.m_graphics.isDeviceRecreationRequested()){
            [essential] warning("RendererSystem: output layer requested recreation during preparation");
            return false;
        }
        else
            warning("RendererSystem: output layer preparation failed; rendering scene output without its layer");
    }

    const auto presentationContributor = this.m_graphics.borrowTaskGraphPresentationContributor();
    if(presentationContributor.has_value()){
        if(presentationContributor.value().prepareTaskGraphPresentation(presentationFrame))
            this.m_preparedTaskGraphPresentationContributor = presentationContributor;
        else if(this.m_graphics.isDeviceRecreationRequested()){
            [essential] warning("RendererSystem: presentation contributor requested recreation during preparation");
            return false;
        }
        else
            warning("RendererSystem: presentation contributor preparation failed; rendering scene output without its overlay");
    }

    if(this.m_instanceTransformPatchContributor.has_value()){
        if(!this.m_instanceTransformPatchContributor.value().prepareInstanceTransformPatches()){
            warning("RendererSystem: instance transform patch contributor preparation failed");
            return false;
        }
    }

    return true;
}

void RendererFramePipeline::setActiveSceneSubsystems(in ActiveSceneSubsystemsRef subsystems){
    this.m_activeSceneSubsystems = subsystems;
    this.m_shaderSystem.setActiveSceneSubsystems(subsystems);
}

void RendererFramePipeline::setInstanceTransformPatchContributor(in Optional<mut IGpuTaskGraphInstanceTransformPatchContributor> contributor){
    this.m_instanceTransformPatchContributor = contributor;
    this.m_raytracingSystem.setInstanceTransformPatchContributor(contributor);
}

void RendererFramePipeline::setDebugLineProvider(in Optional<mut IDebugLineProvider> provider){
    this.m_debugLineProvider = provider;
}

b8 RendererFramePipeline::setSurfelGiQualitySettings(in SurfelGiQualitySettings settings){
    if(!ValidateSurfelGiQualitySettings(settings))
        return false;
    this.m_surfelGiQualitySettings = settings;
    return true;
}

b8 RendererFramePipeline::setReflectionSettings(in ReflectionSettings settings){
    if(!ValidateReflectionSettings(settings))
        return false;
    this.m_reflectionSettings = settings;
    return true;
}

void RendererFramePipeline::setFrameLaggedAsyncLightingEnabled(in b8 enabled){
    if(this.m_frameLaggedAsyncLightingEnabled == enabled)
        return;
    this.m_laggedLightingCurrentFrameAcceptancePending = this.m_frameLaggedAsyncLightingEnabled && !enabled;
    if(this.m_frameLaggedAsyncLightingEnabled && !enabled && this.m_laggedLightingHistorySubmissionToken.valid()){
        this.m_laggedLightingHistoryWriterDrainToken = this.m_laggedLightingHistorySubmissionToken;
        this.m_laggedLightingHistoryWriterDrainGeneration = this.m_laggedLightingHistoryGeneration;
    }
    this.m_frameLaggedAsyncLightingEnabled = enabled;
    this.m_laggedLightingReport = LaggedLightingReport::Unreported;
    this.m_laggedLightingReportGeneration = 0u;
    this.resetLaggedLightingHistoryReadTracking();
}

[cpp_unwind]
void RendererFramePipeline::commitFrameTargets(mut DeferredFrameTargets targets){
    this.m_frameTargets = targets;

    DeferredFrameDiagnostics diagnostics;
    diagnostics.logCommittedDeferredFrameTargets(
        this.m_frameTargets.width,
        this.m_frameTargets.height,
        GetFormatInfo(this.m_frameTargets.albedoFormat).getName(),
        GetFormatInfo(this.m_frameTargets.normalFormat).getName(),
        GetFormatInfo(this.m_frameTargets.worldPositionFormat).getName(),
        GetFormatInfo(this.m_frameTargets.opaqueColorFormat).getName(),
        GetFormatInfo(this.m_frameTargets.compositeColorFormat).getName(),
        GetFormatInfo(this.m_frameTargets.depthFormat).getName(),
        GetFormatInfo(this.m_frameTargets.shadowVisibilityFormat).getName(),
        this.m_frameTargets.csgPeelLayerCount,
        GetFormatInfo(this.m_frameTargets.csgCapNormalFormat).getName(),
        GetFormatInfo(this.m_frameTargets.csgIntervalDepthFormat).getName(),
        GetFormatInfo(this.m_frameTargets.csgIntervalIdFormat).getName(),
        this.m_frameTargets.csgReceiverEventLayerCount,
        GetFormatInfo(this.m_frameTargets.csgReceiverEventDataFormat).getName(),
        GetFormatInfo(this.m_frameTargets.csgReceiverEventCountFormat).getName(),
        this.m_frameTargets.csgReceiverSpanLayerCount,
        GetFormatInfo(this.m_frameTargets.csgReceiverSpanDataFormat).getName(),
        GetFormatInfo(this.m_frameTargets.csgReceiverSpanCountFormat).getName(),
        this.m_frameTargets.csgRemovedIntervalLayerCount,
        GetFormatInfo(this.m_frameTargets.csgRemovedIntervalDepthFormat).getName(),
        GetFormatInfo(this.m_frameTargets.csgRemovedIntervalCapNormalFormat).getName(),
        GetFormatInfo(this.m_frameTargets.csgRemovedIntervalDataFormat).getName(),
        GetFormatInfo(this.m_frameTargets.csgRemovedIntervalCountFormat).getName(),
        GetFormatInfo(this.m_frameTargets.avboit.accumColorFormat).getName(),
        GetFormatInfo(this.m_frameTargets.avboit.accumExtinctionFormat).getName(),
        GetFormatInfo(this.m_frameTargets.avboit.transmittanceFormat).getName()
    );
}

[cpp_unwind]
void RendererFramePipeline::resetFrameTargets(){
    this.m_avboitSystem.resetAvboitFrameTargets(this.m_frameTargets.avboit);
    this.m_deferredSystem.resetDeferredFrameTargets(this.m_frameTargets);
}

[cpp_unwind]
void RendererFramePipeline::resetDeferredTaskGraphRuntime(){
    {
        GpuCompiledGraphReadView planAccess(this.m_deferredLightingCompiledGraph);
        if(planAccess.valid()){
            const u64 recordingAttemptGeneration = this.m_deferredLightingRecordedGraph.recordingAttemptGeneration();
            if(recordingAttemptGeneration != 0u && !this.m_deferredLightingSubmissionTransaction.discardUnaccepted(this.m_deferredLightingTaskGraph, this.m_deferredLightingCompiledGraph, recordingAttemptGeneration))
                [essential] assert(false, "renderer task-graph reset must resolve every unaccepted packet");
            this.m_deferredLightingSubmissionTransaction.reset(this.m_deferredLightingCompiledGraph);
            this.m_deferredLightingRecordedGraph.reset(this.m_deferredLightingCompiledGraph);
        }
    }

    this.m_deferredLightingTaskGraph.reset();
    this.m_deferredFrameTimingBeginTask = GpuTaskId();
    this.m_deferredLightingTaskGraphAnalysis.reset();
    this.m_deferredLightingTaskGraphQueueAssignments.reset();
    this.m_deferredLightingCompiledGraph.reset();
    this.m_deferredLightingTaskGraphDeclarationSeconds = 0.0;
    this.m_deferredLightingTaskGraphDeclared = false;
    this.m_deferredLightingTaskGraphScheduled = false;
}

[cpp_unwind]
void RendererFramePipeline::resetFrameTaskState(){
    this.resetDeferredFrameTaskIdsAndFlags();
    this.resetDeferredTaskGraphRuntime();
}

void RendererFramePipeline::resetDeferredFrameTaskIdsAndFlags(){
    this.m_shadowPrepareGraph.resetShadowPrepareUploadTaskState();
    this.m_deferredLaggedLightingHistorySlotsUploadTask = GpuTaskId();
    this.m_graphicsPrefixGraph.m_graphicsPrefixMeshViewSetupTask = GpuTaskId();
    this.m_graphicsPrefixGraph.m_graphicsPrefixSceneShadingSetupTask = GpuTaskId();
    this.m_graphicsPrefixGraph.m_graphicsPrefixDeferredClearTask = GpuTaskId();
    this.m_graphicsPrefixGraph.resetGraphicsPrefixTaskState();
    this.m_graphicsPrefixGraph.m_graphicsPrefixMeshViewSetupReady = false;
    this.m_graphicsPrefixGraph.m_graphicsPrefixSceneShadingSetupReady = false;
    this.resetSharedDeferredFrameTaskState();
    this.m_deferredFrameRecoveryArmed = false;
    this.m_deferredFrameRecoveryRetiresTiming = false;
    this.m_deferredPresentationOverlayRequired = false;
}

void RendererFramePipeline::resetSharedDeferredFrameTaskState(){
    this.m_shadowVisibilityGraph.m_deferredShadowVisibilityOpaqueTask = GpuTaskId();
    this.m_shadowVisibilityGraph.m_deferredShadowVisibilityOpaqueFirstWaveletTask = GpuTaskId();
    this.m_shadowVisibilityGraph.m_deferredShadowVisibilityOpaqueResolveTask = GpuTaskId();
    this.m_shadowVisibilityGraph.m_deferredShadowVisibilityTransparentTraceTask = GpuTaskId();
    this.m_shadowVisibilityGraph.m_deferredShadowVisibilityTransparentTemporalMergeTask = GpuTaskId();
    this.m_shadowVisibilityGraph.m_deferredShadowVisibilityTransparentFirstWaveletTask = GpuTaskId();
    this.m_shadowVisibilityGraph.m_deferredShadowVisibilityDiagnosticsTask = GpuTaskId();
    this.m_shadowVisibilityGraph.m_deferredShadowVisibilityAdaptiveCounterClearTask = GpuTaskId();
    this.m_shadowVisibilityGraph.m_deferredShadowVisibilityAllLitClearTask = GpuTaskId();
    this.m_shadowVisibilityGraph.m_deferredShadowVisibilityTask = GpuTaskId();
    this.m_causticsGraph.resetDeferredCausticsTaskState();
    this.m_surfelGiGraph.m_deferredSurfelGiPreparationTask = GpuTaskId();
    this.m_surfelGiGraph.m_deferredSurfelGiInitializationLifecycleTask = GpuTaskId();
    this.m_surfelGiGraph.m_deferredSurfelGiSnapshotCopyTask = GpuTaskId();
    this.m_surfelGiGraph.m_deferredSurfelGiIrradianceClearTask = GpuTaskId();
    this.m_surfelGiGraph.m_deferredSurfelGiAgeFreeTask = GpuTaskId();
    this.m_surfelGiGraph.m_deferredSurfelGiCellHeadClearTask = GpuTaskId();
    this.m_surfelGiGraph.m_deferredSurfelGiHashBuildTask = GpuTaskId();
    this.m_surfelGiGraph.m_deferredSurfelGiSpawnTask = GpuTaskId();
    this.m_surfelGiGraph.m_deferredSurfelGiTraceBuildArgsTask = GpuTaskId();
    this.m_surfelGiGraph.m_deferredSurfelGiTraceTask = GpuTaskId();
    this.m_surfelGiGraph.m_deferredSurfelGiResolveTask = GpuTaskId();
    this.m_surfelGiGraph.m_deferredSurfelGiTask = GpuTaskId();
    this.m_surfelGiGraph.m_deferredSurfelGiCounterReadbackTask = GpuTaskId();
    this.m_causticsGraph.m_deferredHardwareCausticsTask = GpuTaskId();
    this.m_avboitSystem.resetTaskGraphStage();
    this.m_deferredLightingTask = GpuTaskId();
    this.m_deferredCompositeTask = GpuTaskId();
    this.m_deferredPresentationOverlayTask = GpuTaskId();
    this.m_deferredPresentTask = GpuTaskId();
    this.m_deferredFrameTimingEndTask = GpuTaskId();
    this.m_deferredLaggedLightingHistoryTask = GpuTaskId();
    this.m_deferredFrameRecoveryTask = GpuTaskId();
    this.m_deferredSurfelGiCounterReadbackCompletion = GpuExternalCompletionId();
    this.m_deferredLightingHistoryReadReadyCompletion = GpuExternalCompletionId();
    this.m_deferredLightingHistoryWriterDrainCompletion = GpuExternalCompletionId();
}

void RendererFramePipeline::resetTargetGenerationStateHandoffs(){
    this.m_raytracingSystem.invalidateLightSpaceShadowCapture();
    this.m_shadowComputePersistentState.reset();
    this.m_shadowVisibilityReturnState.reset();
    this.m_causticsComputePersistentState.reset();
    this.m_hardwareCausticAccumulatorPersistentState.reset();
    this.m_causticIrradianceReturnState.reset();
    this.m_surfelGiComputePersistentState.reset();
    this.m_surfelGiCounterPersistentState.reset();
    this.m_surfelIrradianceReturnState.reset();
}

void RendererFramePipeline::resetInvalidatedResourceStateHandoffs(){
    this.resetTargetGenerationStateHandoffs();
    this.m_shadowPreparePersistentState.reset();
}

void RendererFramePipeline::invalidateLaggedLightingHistoryWriterDrain(){
    this.m_laggedLightingHistoryWriterDrainToken = QueueSubmissionToken();
    this.m_laggedLightingHistoryWriterDrainGeneration = 0u;
}

void RendererFramePipeline::resetLaggedLightingHistoryReadTracking(){
    this.invalidateLaggedLightingHistorySubmission();
    this.m_laggedLightingHistoryGeneration = 0u;
}

void RendererFramePipeline::resetLaggedLightingHistoryTracking(){
    this.resetLaggedLightingHistoryReadTracking();
    this.invalidateLaggedLightingHistoryWriterDrain();
}

[cpp_unwind]
void RendererFramePipeline::reportLaggedLightingTransition(in LaggedLightingReport report, in u64 targetGeneration){
    DeferredFrameDiagnostics diagnostics;
    diagnostics.reportLaggedLightingTransitionIfNeeded(report, targetGeneration, this.m_laggedLightingReport, this.m_laggedLightingReportGeneration);
}


