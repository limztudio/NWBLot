////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type UiPaintCallback = Func<64u, void(mut UiPaintContext)>;

[reflect]
class UiPaintComponent{
    [transient]
    public UiPaintCallback paint;
    public b8 visible = true;
    public i32 order = 0;
}

const usize s_UiClipboardMaxPublications = 16u;
const usize s_UiEditBoxMaxEntries = 256u;
const usize s_UiNativeKeySlotCount = 512u;

enum<u8> UiLayerPresentation{
    Scene,
    Standalone,
}

enum<u8> UiEditBoxEventKind{
    Command,
    Character,
    Native,
    Selection,
    PastePrimary,
    Blur,
    Focus,
}

enum<u8> UiSkinSelectionResult{
    Failed,
    Selected,
    DefaultFallback,
}

enum<u8> UiSkinChangeResult{
    Deferred,
    Applied,
    Failed,
}

enum<u8> UiTextEditStatus{
    Idle,
    Applied,
    Cancelled,
    StaleOwner,
    StaleModel,
    StaleSurrounding,
    InvalidEvent,
    ModelRejected,
    NativeFailure,
    WrongThread,
}

class UiTextEditResult{
    public UiTextEditStatus status = UiTextEditStatus::Idle;
    public b8 textChanged = false;
    public usize eventsApplied = 0u;
}

enum<u8> UiClipboardPublicationStatus{
    Idle,
    Pending,
    Published,
    Unsupported,
    InvalidText,
    TooLarge,
    NativeFailure,
    WrongThread,
    QueueFull,
}

class UiClipboardPublicationResult{
    public UiClipboardPublicationStatus status = UiClipboardPublicationStatus::Idle;
    public usize published = 0u;
    public usize failed = 0u;
}

enum<u8> UiEditClipboardStatus{
    Idle,
    Pending,
    Applied,
    Published,
    Cancelled,
    StaleOwner,
    StaleModel,
    InvalidOwner,
    InvalidAction,
    ReadOnly,
    NoSelection,
    Unsupported,
    CompositionActive,
    InvalidText,
    TooLarge,
    ModelRejected,
    NativeFailure,
    WrongThread,
    QueueFull,
}

class UiEditClipboardResult{
    public UiEditClipboardStatus status = UiEditClipboardStatus::Idle;
    public b8 textChanged = false;
    public b8 selectionChanged = false;
}


