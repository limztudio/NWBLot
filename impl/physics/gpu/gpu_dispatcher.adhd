const StringView s_PhysicsShaderDefaultVariant = "default";
const StringView s_PhysicsShaderNpPrimVariant = "NWB_PHYSICS_NP_PROFILE=0";
const StringView s_PhysicsShaderNpComplexVariant = "NWB_PHYSICS_NP_PROFILE=1";
const StringView s_PhysicsShaderNpBulletToiVariant = "NWB_PHYSICS_NP_PROFILE=2";
const StringView s_PhysicsShaderNpMeshVariant = "NWB_PHYSICS_NP_PROFILE=3";
const StringView s_PhysicsShaderNpTerrainVariant = "NWB_PHYSICS_NP_PROFILE=4";
const StringView s_PhysicsShaderContactsDefaultVariant = "NWB_PHYSICS_ENABLE_BLOCK_SOLVER=0";
const StringView s_PhysicsShaderContactsBlockVariant = "NWB_PHYSICS_ENABLE_BLOCK_SOLVER=1";
const StringView s_PhysicsShaderIslandSmallVariant = "NWB_PHYSICS_ENABLE_BLOCK_SOLVER=0;NWB_PHYSICS_ISLAND_TIER=0";
const StringView s_PhysicsShaderIslandLargeVariant = "NWB_PHYSICS_ENABLE_BLOCK_SOLVER=0;NWB_PHYSICS_ISLAND_TIER=1";
const StringView s_PhysicsShaderIslandSmallBlockVariant = "NWB_PHYSICS_ENABLE_BLOCK_SOLVER=1;NWB_PHYSICS_ISLAND_TIER=0";
const StringView s_PhysicsShaderIslandLargeBlockVariant = "NWB_PHYSICS_ENABLE_BLOCK_SOLVER=1;NWB_PHYSICS_ISLAND_TIER=1";
const StringView s_PhysicsShaderJointIslandMixVariant = "NWB_PHYSICS_JOINT_ISLAND_MODE=0";
const StringView s_PhysicsShaderJointIslandOnlyVariant = "NWB_PHYSICS_JOINT_ISLAND_MODE=1";
const StringView s_PhysicsShaderJointIslandMixBlockVariant = "NWB_PHYSICS_JOINT_ISLAND_MODE=2";
const StringView s_PhysicsShaderQuerySimpleVariant = "NWB_PHYSICS_QUERY_PROFILE=0";
const StringView s_PhysicsShaderQueryMeshVariant = "NWB_PHYSICS_QUERY_PROFILE=1";
const StringView s_PhysicsShaderQueryShapeVariant = "NWB_PHYSICS_QUERY_PROFILE=2";
const StringView s_PhysicsShaderResStepVariant = "NWB_PHYSICS_RES_STEP_PROFILE=0";
const StringView s_PhysicsShaderResToiVariant = "NWB_PHYSICS_RES_STEP_PROFILE=1";
const StringView s_PhysicsShaderSubsysEnvVariant = "NWB_PHYSICS_SUBSYS_PROFILE=0";
const StringView s_PhysicsShaderSubsysSoftXpbdVariant = "NWB_PHYSICS_SUBSYS_PROFILE=1";
const StringView s_PhysicsShaderSubsysSoftCollideVariant = "NWB_PHYSICS_SUBSYS_PROFILE=2";
const StringView s_PhysicsShaderSubsysSoftDeformVariant = "NWB_PHYSICS_SUBSYS_PROFILE=3";
const usize s_GpuIslandJointColorCount = cast<usize>(s_ShaderGpuIslandJointColorCount);
const usize s_GpuIslandJointOverflowColorIndex = cast<usize>(s_ShaderGpuIslandJointOverflowColorIndex);
const usize s_SoftBodyGpuCacheSlotCount = 16u;
const usize s_PhysicsGpuExportRingSlots = 3u;
const usize s_PhysicsGpuComputeCmdRingSlots = 8u;


