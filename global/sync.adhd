[cpp_name("::Futex"), cpp_flags(self_defaulted, binary_serializable, brace_init, no_copy, no_assign)]
extern class Futex{
    void lock(...);
    b8 try_lock(...);
    void unlock(...);
};

[cpp_name("::MallocMutex"), cpp_flags(self_defaulted, binary_serializable, brace_init, no_copy, no_assign)]
extern class MallocMutex{
    void lock(...);
    b8 try_lock(...);
    void unlock(...);
};

[cpp_name("::RecursiveMutex"), cpp_flags(self_defaulted, binary_serializable, brace_init, no_copy, no_assign)]
