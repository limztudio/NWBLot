    public void overlapPoint(in VectorSingle worldPoint, in Filter filter, in b8 hitSensors, in BodyId ignoreBodyId, mut Vector<EntityID> outEntities)const{
        outEntities.clear();
        Vector<ShapeId> rawShapes;
        this.m_physicsWorld.overlapPoint(worldPoint, filter, hitSensors, ignoreBodyId, rawShapes);
        this.collectUniqueEntitiesFromShapes(rawShapes, outEntities);
