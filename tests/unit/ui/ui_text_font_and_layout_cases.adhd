void VerifyTextGlyphVisibilityTests_AnisotropicPhysicalScaleRetainsSnappedNativeFringeAsCandidate(){
    PlacedGlyph glyph = PlacedGlyph();
    glyph.position = Point(10.32f, 20.0f);
