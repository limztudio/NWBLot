[[nodiscard]] FOUNDATION_INLINE b8 TryReadSmokeCameraProjection(
    const Core::ECS::EntityID entity,
    Core::ECS::World& world,
    f32& outVerticalFov,
    f32& outNearPlane,
    f32& outFarPlane,
    f32& outAspectRatio
)noexcept{
