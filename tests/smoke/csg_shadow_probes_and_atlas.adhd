////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_CsgCausticGpuScopeCount = 6;
const usize s_CsgCausticCpuScopeCount = 5;
const usize s_CsgCausticMaxIntervals = 2048;
const usize s_CsgCausticMaxNativeEndpoints = 131072;
const u64 s_CsgCausticPreparationPresentations = 64;
const u32 s_CsgCausticMinimumPositiveIntervals = 11u;

class CsgCausticTimingRecord{
    public TimingStats stats = TimingStats();
    public u64 observation = 0;
    public u32 scope = 0u;
}

class CsgCausticTimingNativeEndpoint{
    public Timer timestamp = Timer();
    public u64 source = 0;
    public u64 presentations = 0;
    public u32 completeMask = 0u;
    public u32 positiveMask = 0u;
    public u32 beginMask = 0u;
    public u32 endMask = 0u;
}

class CsgCausticTimingInterval{
    public PresentationFpsSample presentation;
    public u64 firstSource = 0;
    public u64 endSource = 0;
}


