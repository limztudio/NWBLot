namespace __hidden_ui_pointer_gesture_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB;
using namespace NWB::Impl::Ui;

constexpr AStringView s_TitleKey = "title";

[[nodiscard]] inline HitTarget GestureTarget(const u64 value = 1u)noexcept{
    HitTarget target;
    target.id = { value };
    target.rectangle = { 10.0f, 20.0f, 80.0f, 30.0f };
    target.clip = { 0.0f, 0.0f, 200.0f, 200.0f };
    target.pointerGesture = true;
    return target;
}

[[nodiscard]] inline InputEvent PointerEvent(const InputEventType::Enum type, const Point& position = { 15.0f, 25.0f })noexcept{
    return { .position = position, .type = type };
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiPointerGestureTests : public UiTestSupport::RouterTestFixture{
public:
    UiPointerGestureTests()
        : RouterTestFixture(Name(NWB::Tests::UiCases::s_UiCaseTestsUiPointerGesture))
        , m_context(m_arena)
    {}


public:
    [[nodiscard]] b8 commitSingle(const HitTarget& target, const u64 generation){
        return m_router.commitTargets(Span(&target, 1u), generation);
    }

    InputRoutingResult sendToContext(const InputEvent& event){
        EXPECT_TRUE(m_context.input().queue(UiTestSupport::NativeInput(event)));
        return m_context.input().process();
    }

    void complete(const Point& position = { 45.0f, 55.0f }){
        EXPECT_TRUE(send(PointerEvent(InputEventType::PrimaryDown)).pointerConsumed);
        EXPECT_TRUE(send(PointerEvent(InputEventType::PointerMove, position)).pointerConsumed);
        EXPECT_TRUE(send(PointerEvent(InputEventType::PrimaryUp, position)).pointerConsumed);
    }

    [[nodiscard]] Expected<WidgetState> declarePanel(){
        const auto state = m_context.declare(s_TitleKey, WidgetKind::Panel);
        if(!state)
            return MakeUnexpected(state.error());
        return **state;
    }

    void clearRetainedRoots(){
        m_context.retainRoots({});
    }

    [[nodiscard]] Expected<WidgetState> prepare(const u64 generation, const WidgetRoot& root = { 91u, 1u }){
        EXPECT_TRUE(m_context.beginFrame(generation));
        EXPECT_TRUE(m_context.beginRoot(root));
        const auto state = m_context.declare(s_TitleKey, WidgetKind::Panel);
        EXPECT_TRUE(state);
        if(!state)
            return MakeUnexpected(state.error());
        const WidgetState snapshot = **state;
        EXPECT_TRUE(m_context.addTarget(snapshot, GestureTarget()));
        EXPECT_TRUE(m_context.endRoot());
        EXPECT_TRUE(m_context.finishFrame());
        if(m_context.failed())
            return MakeUnexpected(Failure{});
        return snapshot;
    }


public:
    Context m_context;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


