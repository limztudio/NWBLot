#include <impl/assets_mesh/cook_types.adhd>
#include <impl/assets_mesh/skin_binary_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateSkinCookInverseBindMatrix(in MatrixSingle matrix, in StringView filePathText, in usize matrixIndex){
    if(IsValidSkinInverseBindMatrix(matrix))
        return true;

    error(
        "Skin meta '{}': inverse_bind_matrices[{}] is not a finite invertible affine matrix",
        filePathText,
        matrixIndex
    );
    return false;
}

b8 ValidateSkinCookInverseBindMatricesNonEmpty(in usize matrixCount, in StringView filePathText){
    if(matrixCount != 0u)
        return true;

    error("Skin meta '{}': '{}' must not be empty", filePathText, s_SkinInverseBindMatricesField);
    return false;
}

b8 SerializeSkinBinaryPayload(
    in NameHash meshNameHash,
    in NameHash skeletonNameHash,
    in Span<SkinInfluence4> influences,
    in Span<SkeletonJointMatrix> inverseBindMatrices,
    mut Vector<u8> outBinary
){
    SkinBinaryCodec codec;
    return codec.serialize(meshNameHash, skeletonNameHash, influences, inverseBindMatrices, outBinary);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

