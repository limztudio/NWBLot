////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_CSG_EVENT_DIAGNOSTIC_INPUTS_SLANGI
#define NWB_CSG_EVENT_DIAGNOSTIC_INPUTS_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "csg/constants.h"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The independent event-data, event-order and event-count diagnostics share only framebuffer bounds and input addressing, leaving their validation/color policy local.
bool nwbCsgDiagnosticEventBounds(const int2 pixel, out uint eventDataSlot, out uint eventLayers){
    eventDataSlot = g_NwbDeferredBindlessResources.csgPeelSlots.w;
    uint width;
    uint height;
    nwbHeapStorageImage2DArrayUint4(eventDataSlot).GetDimensions(width, height, eventLayers);
    return !any(pixel < 0) && !any(uint2(pixel) >= uint2(width, height));
}

float nwbCsgDiagnosticSpanState(const int2 pixel){
    const uint spanCountSlot = g_NwbDeferredBindlessResources.csgSpanSlots.z;
    const uint2 spanCounts = nwbHeapStorageImage2DArrayUint2(spanCountSlot).Load(int3(pixel, 0));
    return spanCounts.x > 0u ? 1.0 : float(spanCounts.y) / 33.0;
}

bool nwbCsgDiagnosticReceiverIndex(const int2 pixel, out uint receiverIndex){
    const uint peelIdSlot = g_NwbDeferredBindlessResources.csgPeelSlots.z;
    uint peelWidth;
    uint peelHeight;
    uint peelLayers;
    nwbHeapStorageImage2DArrayUint(peelIdSlot).GetDimensions(peelWidth, peelHeight, peelLayers);
    receiverIndex = NWB_CSG_INVALID_RECEIVER_INDEX;
    if(any(uint2(pixel) >= uint2(peelWidth, peelHeight)))
        return false;
    uint selectedPeelId = 0u;
    [unroll] for(uint layer = 0u; layer < NWB_CSG_PEEL_LAYER_COUNT; ++layer){
        if(layer >= peelLayers)
            break;
        selectedPeelId = nwbHeapStorageImage2DArrayUint(peelIdSlot).Load(int3(pixel, int(layer)));
        if(selectedPeelId != 0u)
            break;
    }
    const uint receiverBits = selectedPeelId & NWB_CSG_RECEIVER_INDEX_MASK;
    receiverIndex = receiverBits == 0u ? NWB_CSG_INVALID_RECEIVER_INDEX : receiverBits - 1u;
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

