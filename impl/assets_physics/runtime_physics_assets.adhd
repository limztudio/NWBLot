////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_physics/physics_asset_binary_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 PhysicsMaterialAsset::validatePayload()const{
    if(!this.checkVirtualPath("PhysicsMaterialAsset::validatePayload"))
        return false;
    return PhysicsAssetBinaryCodec().validatePhysicsMaterial(this.m_material, this.virtualPath());
}

b8 PhysicsMaterialAsset::loadBinary(in Span<u8> binary){
    if(!this.checkVirtualPath("PhysicsMaterialAsset::loadBinary"))
        return false;
    Expected<SurfaceMaterial> decoded = PhysicsAssetBinaryCodec().deserializePhysicsMaterial(binary);
    if(!decoded.has_value())
        return false;
    this.m_material = decoded.value();
    return true;
}

