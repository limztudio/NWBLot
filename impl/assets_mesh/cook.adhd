////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize ComputeMeshletParallelCandidateReserve(in u32 workerThreadCount){
    return (cast<usize>(workerThreadCount) + 1u) * s_MeshletDisconnectedCandidateParallelOversubscription;
}

b8 ValidateBuiltMeshletsNonEmpty(in usize meshletCount, in StringView metaKind, in StringView filePathText){
    if(meshletCount != 0u)
        return true;

    error("{} meta '{}': meshlet build produced no meshlets", metaKind, filePathText);
    return false;
}

b8 ValidateSkinCookInverseBindMatrix(in MatrixSingle matrix, in StringView filePathText, in usize matrixIndex){
    if(IsValidSkinInverseBindMatrix(matrix))
        return true;

    error(
        "Skin meta '{}': inverse_bind_matrices[{}] is not a finite invertible affine matrix"
        , filePathText
        , matrixIndex
    );
    return false;
}

b8 ValidateSkinCookInverseBindMatricesNonEmpty(in usize matrixCount, in StringView filePathText){
    if(matrixCount != 0u)
        return true;

    error("Skin meta '{}': '{}' must not be empty", filePathText, s_SkinInverseBindMatricesField);
    return false;
}

b8 SerializeMeshBinaryPayload(
    in Span<f32x3u> positions,
    in Span<f16x4u> normals,
    in Span<f16x4u> tangents,
    in Span<f32x2u> uv0,
    in Span<f16x4u> colors,
    in Span<MeshletDesc> meshlets,
    in Span<MeshletBounds> meshletBounds,
    in Span<u8> meshletPositionRefDeltas,
    in Span<u8> meshletAttributeRefDeltas,
    in Span<MeshletLocalVertexRef> meshletLocalVertexRefs,
    in Span<u8> meshletPrimitiveIndices,
    in Span<u32> solidTriangleWords,
    mut Vector<u8> outBinary
){
    MeshBinaryCodec codec;
    return codec.serialize(
        positions,
        normals,
        tangents,
        uv0,
        colors,
        meshlets,
        meshletBounds,
        meshletPositionRefDeltas,
        meshletAttributeRefDeltas,
        meshletLocalVertexRefs,
        meshletPrimitiveIndices,
        solidTriangleWords,
        outBinary
    );
}

b8 SerializeSkinBinaryPayload(
    in NameHash meshNameHash,
    in NameHash skeletonNameHash,
    in Span<SkinInfluence4> influences,
    in Span<SkeletonJointMatrix> inverseBindMatrices,
    mut Vector<u8> outBinary
){
    SkinBinaryCodec codec;
    return codec.serialize(meshNameHash, skeletonNameHash, influences, inverseBindMatrices, outBinary);
}


