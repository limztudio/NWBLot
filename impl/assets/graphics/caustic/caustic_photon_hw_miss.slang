#define NWB_BINDLESS_TLAS 1

#include "caustic_hw_common.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Clear hit even when raygen seeds the payload, so an escaped segment always drops its photon.
[shader("miss")]
void main(inout NwbCausticHwPayload payload){
    payload.hit = 0u;
}


