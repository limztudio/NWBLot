#include <impl/ecs_render/reflection/frame_graph_reflection_resolve.adhd>
#include <impl/ecs_render/reflection/frame_parameters.adhd>
#include <impl/ecs_render/reflection/reflection_postprocess_graph_tasks.adhd>
#include <impl/ecs_render/reflection/settings.adhd>
#include <impl/ecs_render/reflection/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_ReflectionSurfaceReadCount = 9u;

b8 ReflectionUsesSlicedCsgPushConstants(in b8 hasCsgTraceContextBuffer, in b8 isHardwareStage, in b8 isBuildArgsStage){
    return hasCsgTraceContextBuffer && (isHardwareStage || isBuildArgsStage);
}

u32 ReflectionCsgSliceRayOffset(in u32 slice, in u32 raysPerSlice){
    return slice * raysPerSlice;
}

u32 ReflectionCsgSliceIndirectByteOffset(in u32 slice, in u32 argumentStrideBytes){
    return slice * argumentStrideBytes;
}

b8 IsFinalReflectionCsgHardwareSlice(in u32 slice, in u32 sliceCount){
    return slice + 1u == sliceCount;
}

b8 ReflectionTraceModeUsesScreenInputs(in u32 traceMode, in u32 screenMode, in u32 hybridMode){
    return traceMode == screenMode || traceMode == hybridMode;
}

b8 ShouldWriteReflectionFeedback(in b8 feedbackReserved, in b8 feedbackEligible, in u32 hardwareEnabled){
    return feedbackReserved && feedbackEligible && hardwareEnabled != 0u;
}

u64 ReflectionFeedbackEntryByteCount(in u32 totalByteCount, in u64 headerBytes){
    return cast<u64>(totalByteCount) - headerBytes;
}

ReflectionDispatchStage ResolveReflectionFeedbackPublicationStage(in b8 hasHardwareWork){
    if(hasHardwareWork)
        return ReflectionDispatchStage::BuildArgs;
    return ReflectionDispatchStage::Classify;
}

b8 IsReflectionHardwareSceneReady(in u32 hardwareEnabled, in b8 hardwarePreparationReady){
    return hardwareEnabled != 0u && hardwarePreparationReady;
}

b8 IsReflectionHardwareDispatchActive(in u32 hardwareEnabled, in u32 maxHardwareRays, in b8 hardwarePreparationReady){
    return hardwareEnabled != 0u && maxHardwareRays > 0u && hardwarePreparationReady;
}

u32 ResolveReflectionHardwareRayCapacity(in u32 maxHardwareRays, in u32 queueCapacity){
    return Min(maxHardwareRays, queueCapacity);
}

b8 IsTrustedReflectionContentStamp(in b8 sceneStampTrusted, in b8 csgEmpty, in b8 useLaggedLightingHistory){
    return sceneStampTrusted && csgEmpty && !useLaggedLightingHistory;
}

ReflectionSceneContentStamp ResolveReflectionSceneContentStamp(in ReflectionSceneContentStamp baseStamp, in u64 geometryStamp, in u64 materialStamp, in b8 sceneStampTrusted, in b8 csgEmpty, in b8 useLaggedLightingHistory){
    ReflectionSceneContentStamp stamp = baseStamp;
    stamp.geometry = geometryStamp;
    stamp.material = materialStamp;
    // CSG evaluation and lagged screen lighting do not have a matching content stamp for this first history policy.
    stamp.trusted = IsTrustedReflectionContentStamp(sceneStampTrusted, csgEmpty, useLaggedLightingHistory);
    return stamp;
}

ReflectionCompositeInputs MakeReflectionCompositeInputs(in u32 opaqueRadianceSlot, in u32 glassRadianceSlot, in ReflectionDebugView debugView){
    ReflectionCompositeInputs inputs;
    inputs.opaqueRadianceSlot = opaqueRadianceSlot;
    inputs.glassRadianceSlot = glassRadianceSlot;
    inputs.debugView = debugView;
    return inputs;
}

void LogReflectionConfirmTimingBeginFailed(){
    warning("Reflection: failed to confirm accepted hardware timing begin");
}

void LogReflectionConfirmTimingEndFailed(){
    warning("Reflection: failed to confirm accepted hardware timing end");
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ReflectionParametersUploadTask{
    private BufferHandle m_buffer;
    private ReflectionFrameParameters m_parameters;
    private ReflectionHistoryPlan m_history;
    private ReflectionFeedbackPlan m_feedback;
    private b8 m_feedbackReserved;
    private in b8 m_hardwarePreparationReady;

    public ReflectionParametersUploadTask(
        in BufferHandle buffer,
        in ReflectionFrameParameters parameters,
        in ReflectionHistoryPlan history,
        in ReflectionFeedbackPlan feedback,
        in b8 feedbackReserved,
        in borrow b8 hardwarePreparationReady
    ){
        this.m_buffer = buffer;
        this.m_parameters = parameters;
        this.m_history = history;
        this.m_feedback = feedback;
        this.m_feedbackReserved = feedbackReserved;
        this.m_hardwarePreparationReady = hardwarePreparationReady;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Transfer); }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        const b8 hardwareReady = this.m_hardwarePreparationReady;
        const ReflectionFrameParameters parameters = ResolveReflectionUploadFrameParameters(this.m_parameters, this.m_history, this.m_feedback, this.m_feedbackReserved, hardwareReady);
        commandList.writeBuffer(this.m_buffer.deref(), parameters);
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(size_of<ReflectionCsgDispatchPushConstants>() == s_ReflectionShaderCsgPushBytes, "CSG reflection push constants must match the shader");

in ComputePipelineHandle ReflectionDispatchPipeline(in borrow ReflectionFrameSnapshot resources, in ReflectionDispatchStage stage){
    if(stage == ReflectionDispatchStage::Hardware)
        return resources.hardwarePipeline;
    if(stage == ReflectionDispatchStage::Classify)
        return resources.classifyPipeline;
    return resources.buildArgsPipeline;
}

GpuTimingScopeDefinition ReflectionDispatchTiming(in ReflectionDispatchStage stage){
    if(stage == ReflectionDispatchStage::Hardware)
        return s_TimingScopeReflectionHardware;
    if(stage == ReflectionDispatchStage::Classify)
        return s_TimingScopeReflectionClassify;
    return s_TimingScopeReflectionBuildArgs;
}

[move_only]
class ReflectionDispatchTask{
    private mut GraphicsRuntime graphics;
    private mut RendererRayTracingSystem raytracingSystem;
    private ReflectionFrameSnapshot resources;
    private ReflectionDispatchStage stage;
    public ReflectionFeedbackReservation feedbackReservation;
    private in b8 hardwarePreparationReady;
    private mut b8 hardwareDispatchLogged;
    private mut b8 fallbackDispatchLogged;

    public ReflectionDispatchTask(mut GraphicsRuntime graphics, in ReflectionGraphInputs inputs, in ReflectionFrameSnapshot resources, in ReflectionDispatchStage stage){
        this.graphics = graphics;
        this.raytracingSystem = inputs.raytracingSystem;
        this.resources = resources;
        this.stage = stage;
        this.hardwarePreparationReady = inputs.hardwarePreparationReady;
        this.hardwareDispatchLogged = inputs.hardwareDispatchLogged;
        this.fallbackDispatchLogged = inputs.fallbackDispatchLogged;
    }
    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        in ReflectionFrameSnapshot resources = this.resources;
        const b8 hardware = this.stage == ReflectionDispatchStage::Hardware;
        if(hardware && !this.hardwarePreparationReady)
            return true;
        in ComputePipelineHandle pipeline = ReflectionDispatchPipeline(resources, this.stage);
        if(!pipeline.valid() || (hardware && !resources.scene.valid()))
            return false;
        commandList.endRenderPass();
        ComputeState state;
        state.setPipeline(pipeline.deref());
        GpuDescriptorHandle tlas = GpuDescriptorHandleInvalid();
        if(hardware){
            state.setIndirectParams(resources.indirectArgs.deref());
            tlas = resources.scene.tlasHeapHandle;
        }
        commandList.setComputeState(state);
        this.graphics.getDevice().getDescriptorHeap().bindCompute(commandList, pipeline.deref(), tlas);
        if(ReflectionUsesSlicedCsgPushConstants(resources.scene.csgTraceContextBuffer.valid(), hardware, this.stage == ReflectionDispatchStage::BuildArgs))
            commandList.setPushConstants(MakeReflectionCsgDispatchPushConstants(resources.frameParametersSlot, 0u));
        else
            commandList.setPushConstants(resources.frameParametersSlot);
        const GpuTimingScopeDefinition scope = ReflectionDispatchTiming(this.stage);
        GpuTimingMeasure timing(this.graphics.gpuTiming(), scope, this.graphics.getDevice(), commandList);
        if(hardware)
            commandList.dispatchIndirect(0u);
        else if(this.stage == ReflectionDispatchStage::BuildArgs)
            commandList.dispatch(1u, 1u, 1u);
        else
            commandList.dispatch(DivideUpWrapping(resources.parameters.width, s_ReflectionShaderClassifyGroupSize), DivideUpWrapping(resources.parameters.height, s_ReflectionShaderClassifyGroupSize), 1u);
        return true;
    }

    [cpp_unwind]
    public void accepted(in QueueSubmissionToken token){
        const b8 hardware = IsReflectionHardwareDispatchActive(this.resources.parameters.hardwareEnabled, this.resources.parameters.maxHardwareRays, this.hardwarePreparationReady);
        this.feedbackReservation.accept(token, IsReflectionHardwareSceneReady(this.resources.parameters.hardwareEnabled, this.hardwarePreparationReady));
        if(this.stage == ReflectionDispatchStage::Hardware && hardware){
            if(this.resources.scene.csgTraceContextBuffer.valid())
                this.raytracingSystem.confirmRayTraceContextReadSubmission(token);
            LogHardwareReflectionResolveIfNeeded(this.hardwareDispatchLogged);
        }
        else if(this.stage == ReflectionDispatchStage::Classify && !hardware)
            LogFallbackReflectionResolveIfNeeded(this.resources.parameters.traceMode, this.fallbackDispatchLogged);
    }
    public void discarded(){ this.feedbackReservation.discard(); }
}

class ReflectionCsgHardwareSliceTask{
    private mut GraphicsRuntime graphics;
    private mut RendererRayTracingSystem raytracingSystem;
    private ReflectionCsgDispatchHandle dispatch;
    private u32 slice;
    private u32 sliceCount;
    private in b8 hardwarePreparationReady;
    private mut b8 hardwareDispatchLogged;

    public ReflectionCsgHardwareSliceTask(mut GraphicsRuntime graphics, in ReflectionGraphInputs inputs, in ReflectionCsgDispatchHandle dispatch, in u32 slice, in u32 sliceCount){
        this.graphics = graphics;
        this.raytracingSystem = inputs.raytracingSystem;
        this.dispatch = dispatch;
        this.slice = slice;
        this.sliceCount = sliceCount;
        this.hardwarePreparationReady = inputs.hardwarePreparationReady;
        this.hardwareDispatchLogged = inputs.hardwareDispatchLogged;
    }
    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements commands;
        commands.requiredCapabilities = GpuQueueCapability::Compute;
        commands.requiresPrimaryGraphicsQueue = true;
        return commands;
    }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.hardwarePreparationReady)
            return true;
        if(!this.dispatch.valid() || this.slice >= this.sliceCount)
            return false;
        in ReflectionFrameSnapshot resources = this.dispatch.deref().resources;
        if(!resources.hardwarePipeline.valid() || !resources.scene.valid())
            return false;
        commandList.endRenderPass();
        ComputeState state;
        state.setPipeline(resources.hardwarePipeline.deref()).setIndirectParams(resources.indirectArgs.deref());
        commandList.setComputeState(state);
        this.graphics.getDevice().getDescriptorHeap().bindCompute(commandList, resources.hardwarePipeline.deref(), resources.scene.tlasHeapHandle);
        commandList.setPushConstants(MakeReflectionCsgDispatchPushConstants(resources.frameParametersSlot, ReflectionCsgSliceRayOffset(this.slice, s_ReflectionTraceSliceRays)));
        mut GpuTimingFrameTransaction timing = this.dispatch.deref().timing.value();
        if(this.slice == 0u && !timing.begin(s_TimingScopeReflectionHardware, this.graphics.getDevice(), commandList))
            return false;
        commandList.dispatchIndirect(ReflectionCsgSliceIndirectByteOffset(this.slice, s_ReflectionIndirectArgumentBytes));
        if(IsFinalReflectionCsgHardwareSlice(this.slice, this.sliceCount))
            return timing.recordEnd(commandList);
        return true;
    }
    [cpp_unwind]
    public void accepted(in QueueSubmissionToken token){
        if(!this.hardwarePreparationReady)
            return;
        // An accepted prefix already reads the frozen context when a later packet fails.
        this.raytracingSystem.confirmRayTraceContextReadSubmission(token);
        mut GpuTimingFrameTransaction timing = this.dispatch.deref().timing.value();
        if(this.slice == 0u && !timing.confirmBeginSubmission(token)){
            LogReflectionConfirmTimingBeginFailed();
            timing.discard();
        }
        if(IsFinalReflectionCsgHardwareSlice(this.slice, this.sliceCount) && !timing.confirmEndSubmission(token, true)){
            LogReflectionConfirmTimingEndFailed();
            timing.discard();
        }
        LogHardwareReflectionResolveIfNeeded(this.hardwareDispatchLogged);
    }
    public void discarded(){
        if(this.dispatch.valid())
            this.dispatch.deref().timing.value().discard();
    }
}

void SetReflectionSurfaceReads(mut Vector<GpuTaskResourceUse> uses, in ReflectionGraphInputs inputs, in GpuGraphResourceId frameParameters){
    uses.clear();
    for(in GpuTaskResourceUse use : inputs.surfaceReads)
        uses.push_back(use);
    uses.push_back(ReadUse(frameParameters, ResourceStates::ConstantBuffer));
}

[cpp_unwind]
b8 AddReflectionDispatch(
    mut GpuTaskGraph graph,
    mut GraphicsRuntime graphics,
    in ReflectionGraphInputs inputs,
    in ReflectionFrameSnapshot resources,
    in Span<GpuTaskResourceUse> uses,
    in Name identity,
    in StringView label,
    in ReflectionDispatchStage stage,
    in ReflectionDispatchStage feedbackPublicationStage,
    mut ReflectionFeedbackReservation feedback,
    mut GpuTaskId dependency
){
    GpuTaskDesc desc = ReflectionTaskDesc(identity, label, dependency);
    desc.setResourceUses(uses).setTiming(ReflectionPacketTiming());
    if(stage == ReflectionDispatchStage::Hardware)
        desc.setResourceSetUses(inputs.hardwareSetReads);
    ReflectionDispatchTask task(graphics, inputs, resources, stage);
    if(stage == feedbackPublicationStage)
        MoveInto<ReflectionFeedbackReservation>(task.feedbackReservation, feedback);
    const auto added = graph.addPreparedPayloadTask(desc, task);
    if(!added.has_value()){
        dependency = GpuTaskId();
        return false;
    }
    dependency = added.value();
    return true;
}

[cpp_unwind]
Expected<ReflectionGraphResult> DeclareReflectionTasks(
    in ReflectionFrameSnapshot resources,
    in ReflectionGraphInputs inputs,
    in GpuTaskId initialDependency,
    mut GpuTaskGraph graph,
    mut GraphicsRuntime graphics,
    mut RendererReflectionSystem reflectionSystem
){
    GpuTaskId dependency = initialDependency;
    if(!resources.valid() || inputs.surfaceReads.empty())
        return MakeUnexpected(Failure());
    const b8 screen = ReflectionTraceModeUsesScreenInputs(resources.parameters.traceMode, s_ReflectionShaderModeScreen, s_ReflectionShaderModeHybrid);
    if(screen && (!inputs.opaqueDepth.valid() || !inputs.opaqueColor.valid()))
        return MakeUnexpected(Failure());
    ReflectionFeedbackReservation feedbackReservation(resources.feedback.control, resources.feedback.plan);
    const b8 feedbackReserved = feedbackReservation.valid();
    const b8 feedbackWrites = ShouldWriteReflectionFeedback(feedbackReserved, resources.feedback.plan.eligible, resources.parameters.hardwareEnabled);
    const b8 buildArguments = resources.hasHardwareWork();
    const ReflectionDispatchStage feedbackPublicationStage = ResolveReflectionFeedbackPublicationStage(buildArguments);
    // A stale feedback lease disables this optimization; rendering remains available.
    GpuGraphResourceId feedbackCurrent;
    GpuGraphResourceId feedbackPrevious;
    if(feedbackWrites){
        const auto feedbackCurrentResult = FindOrImportBuffer(graph, resources.feedback.current.buffer, s_ReflectionBufferLabel);
        Expected<GpuGraphResourceId> feedbackPreviousResult = MakeUnexpected(Failure());
        if(resources.feedback.plan.reused)
            feedbackPreviousResult = FindOrImportBuffer(graph, resources.feedback.previous.buffer, s_ReflectionBufferLabel);
        if(!feedbackCurrentResult.has_value() || (resources.feedback.plan.reused && !feedbackPreviousResult.has_value()))
            return MakeUnexpected(Failure());
        feedbackCurrent = feedbackCurrentResult.value();
        if(resources.feedback.plan.reused)
            feedbackPrevious = feedbackPreviousResult.value();
    }
    ReflectionGraphResult result;
    const auto opaqueRadianceResult = ImportReflectionTexture(graph, resources.opaqueRadiance);
    const auto glassRadianceResult = ImportReflectionTexture(graph, resources.glassRadiance);
    const auto frameParametersResult = FindOrImportBuffer(graph, resources.frameParameters, s_ReflectionBufferLabel);
    const auto countersResult = FindOrImportBuffer(graph, resources.counters, s_ReflectionBufferLabel);
    const auto queueResult = FindOrImportBuffer(graph, resources.queue, s_ReflectionBufferLabel);
    const auto argsResult = FindOrImportBuffer(graph, resources.indirectArgs, s_ReflectionBufferLabel);
    if(!opaqueRadianceResult.has_value() || !glassRadianceResult.has_value() || !frameParametersResult.has_value() || !countersResult.has_value() || !queueResult.has_value() || !argsResult.has_value())
        return MakeUnexpected(Failure());
    result.opaqueRadiance = opaqueRadianceResult.value();
    result.glassRadiance = glassRadianceResult.value();
    result.frameParameters = frameParametersResult.value();
    result.counters = countersResult.value();
    const GpuGraphResourceId queue = queueResult.value();
    const GpuGraphResourceId args = argsResult.value();

    GpuTaskDesc desc = ReflectionTaskDesc(s_ReflectionParametersUploadTaskName, s_ReflectionParametersUploadTaskLabel, dependency);
    const Array<GpuTaskResourceUse, 1u> parameterWrite(WriteUse(result.frameParameters, ResourceStates::CopyDest));
    desc.setResourceUses(parameterWrite);
    const auto dependencyResult = graph.addPayloadTask(desc, ReflectionParametersUploadTask(
        resources.frameParameters, resources.parameters, resources.postprocess.history, resources.feedback.plan, feedbackReserved, inputs.hardwarePreparationReady
    ));
    if(!dependencyResult.has_value())
        return MakeUnexpected(Failure());
    dependency = dependencyResult.value();

    desc = ReflectionTaskDesc(s_ReflectionClearCountersTaskName, s_ReflectionClearCountersTaskLabel, dependency);
    GpuClearBufferTaskDesc clear;
    clear.destination = result.counters;
    clear.clearValue = 0u;
    const auto dependencyResult2 = graph.addClearBufferTask(desc, clear);
    if(!dependencyResult2.has_value())
        return MakeUnexpected(Failure());
    dependency = dependencyResult2.value();

    GpuGraphResourceId depthPyramid;
    if(screen){
        const auto depthPyramidTaskResult = DeclareReflectionDepthPyramidTasks(resources.depthPyramid, inputs.opaqueDepth, dependency, graph, graphics, depthPyramid);
        if(!depthPyramidTaskResult.has_value())
            return MakeUnexpected(Failure());
        dependency = depthPyramidTaskResult.value();
    }

    Vector<GpuTaskResourceUse> uses;
    uses.reserve(inputs.surfaceReads.size() + inputs.hardwareReads.size() + s_ReflectionUseCapacity);
    SetReflectionSurfaceReads(uses, inputs, result.frameParameters);
    if(screen){
        uses.push_back(ReadTextureUse(depthPyramid, TextureSubresourceSet(0u, resources.depthPyramid.mipCount, 0u, 1u)));
        uses.push_back(ReadUse(inputs.opaqueColor));
    }
    if(feedbackWrites){
        GpuTaskResourceUse entryWrite = WriteUse(feedbackCurrent, ResourceStates::UnorderedAccess);
        entryWrite.range.bufferRange = BufferRange(s_ReflectionFeedbackHeaderBytes, ReflectionFeedbackEntryByteCount(resources.feedback.extent.byteCount, s_ReflectionFeedbackHeaderBytes));
        uses.push_back(entryWrite);
        if(feedbackPrevious.valid())
            uses.push_back(ReadUse(feedbackPrevious));
    }
    uses.push_back(WriteUse(result.opaqueRadiance, ResourceStates::UnorderedAccess));
    uses.push_back(WriteUse(result.glassRadiance, ResourceStates::UnorderedAccess));
    uses.push_back(WriteUse(queue, ResourceStates::UnorderedAccess));
    uses.push_back(ReadWriteUse(result.counters, ResourceStates::UnorderedAccess));
    if(!AddReflectionDispatch(graph, graphics, inputs, resources, Span<GpuTaskResourceUse>(uses), s_ReflectionClassifyTaskName, s_ReflectionClassifyTaskLabel, ReflectionDispatchStage::Classify, feedbackPublicationStage, feedbackReservation, dependency))
        return MakeUnexpected(Failure());

    if(buildArguments){
        uses.clear();
        uses.push_back(ReadUse(result.frameParameters, ResourceStates::ConstantBuffer));
        uses.push_back(ReadUse(result.counters));
        uses.push_back(WriteUse(args, ResourceStates::UnorderedAccess));
        if(feedbackWrites){
            GpuTaskResourceUse headerWrite = WriteUse(feedbackCurrent, ResourceStates::UnorderedAccess);
            headerWrite.range.bufferRange = BufferRange(0u, s_ReflectionFeedbackHeaderBytes);
            uses.push_back(headerWrite);
        }
        if(!AddReflectionDispatch(graph, graphics, inputs, resources, Span<GpuTaskResourceUse>(uses), s_ReflectionBuildArgsTaskName, s_ReflectionBuildArgsTaskLabel, ReflectionDispatchStage::BuildArgs, feedbackPublicationStage, feedbackReservation, dependency))
            return MakeUnexpected(Failure());
        if(!resources.hardwarePipeline.valid() || !resources.scene.valid() || inputs.hardwareReads.empty())
            return MakeUnexpected(Failure());
        SetReflectionSurfaceReads(uses, inputs, result.frameParameters);
        for(in GpuTaskResourceUse use : inputs.hardwareReads)
            uses.push_back(use);
        uses.push_back(ReadUse(queue));
        uses.push_back(ReadUse(args, ResourceStates::IndirectArgument));
        uses.push_back(ReadWriteUse(result.counters, ResourceStates::UnorderedAccess));
        uses.push_back(ReadWriteUse(result.opaqueRadiance, ResourceStates::UnorderedAccess));
        uses.push_back(ReadWriteUse(result.glassRadiance, ResourceStates::UnorderedAccess));
        if(resources.scene.csgTraceContextBuffer.valid()){
            const auto dispatchResult = reflectionSystem.acquireCsgDispatchState(resources);
            if(!dispatchResult.has_value())
                return MakeUnexpected(dispatchResult.error());
            in ReflectionCsgDispatchHandle dispatch = dispatchResult.value();
            if(!dispatch.valid())
                return MakeUnexpected(Failure());
            const u32 rayCapacity = ResolveReflectionHardwareRayCapacity(resources.parameters.maxHardwareRays, resources.parameters.queueCapacity);
            const u32 sliceCount = ResolveReflectionIndirectArgumentCount(rayCapacity, true);
            // Separate native packets let the driver retire bounded work; shared UAV state also orders CPU recording.
            for(u32 slice = 0u; slice < sliceCount; ++slice){
                const auto sliceIdentity = ReflectionCsgHardwareSliceIdentity(slice);
                if(!sliceIdentity.has_value()){
                    error("RendererReflectionSystem: failed to format CSG hardware slice identity {}", slice);
                    return MakeUnexpected(Failure());
                }
                GpuTaskDesc sliceDesc = ReflectionTaskDesc(sliceIdentity.value(), s_ReflectionHardwareResolveTaskLabel, dependency);
                GpuTaskSchedulingHint scheduling;
                scheduling.forceSubmissionBoundary = true;
                scheduling.allowPacketMerge = false;
                sliceDesc.setScheduling(scheduling).setResourceUses(uses);
                sliceDesc.setResourceSetUses(inputs.hardwareSetReads);
                sliceDesc.setTiming(ReflectionPacketTiming());
                const auto dependencyResult4 = graph.addPayloadTask(sliceDesc, ReflectionCsgHardwareSliceTask(graphics, inputs, dispatch, slice, sliceCount));
                if(!dependencyResult4.has_value())
                    return MakeUnexpected(Failure());
                dependency = dependencyResult4.value();
            }
        }
        else if(!AddReflectionDispatch(graph, graphics, inputs, resources, Span<GpuTaskResourceUse>(uses), s_ReflectionHardwareTaskName, s_ReflectionHardwareResolveTaskLabel, ReflectionDispatchStage::Hardware,
            feedbackPublicationStage, feedbackReservation, dependency))
            return MakeUnexpected(Failure());
    }

    const auto dependencyResult5 = DeclareReflectionPostprocessTasks(resources, inputs, dependency, graph, graphics, result);
    if(!dependencyResult5.has_value())
        return MakeUnexpected(Failure());
    dependency = dependencyResult5.value();

    const auto completionResult = DeclareReflectionStatisticsAndFinalizeTasks(resources, inputs, feedbackReserved, dependency, graph, result);
    if(!completionResult.has_value())
        return MakeUnexpected(completionResult.error());
    result.completion = completionResult.value();
    return result;
}


[cpp_unwind]
Expected<FrameGraphReflectionResolveResult> FrameGraphReflectionResolve::declare(in FrameGraphReflectionResolveInputs inputs, mut RayTracingSceneGraphReads sceneReads){
    FrameGraphReflectionResolveResult result;
    in RayTracingSceneGraphResources sceneResources = inputs.sceneResources;
    in ReflectionSettings reflectionSettings = inputs.reflectionSettings;
    const ReflectionSceneContentStamp reflectionContentStamp = ResolveReflectionSceneContentStamp(
        inputs.contentStamp,
        sceneResources.contentStamp.geometry,
        sceneResources.contentStamp.material,
        sceneResources.contentStamp.trusted,
        inputs.csgFrameState.empty(),
        inputs.useLaggedLightingHistory
    );
    RayTracingSceneGraphResources reflectionScene;
    if(inputs.reflectionSceneAvailable)
        reflectionScene = sceneResources;
    const ReflectionFrameSnapshot reflectionResources = this.m_reflectionSystem.snapshotFrameResources(
        inputs.targets,
        inputs.meshViewSnapshot,
        reflectionScene,
        reflectionSettings,
        inputs.reflectionFrameIndex,
        reflectionContentStamp
    );
    if(!reflectionResources.valid())
        return MakeUnexpected(Failure());
    if(!sceneReads.valid() && reflectionResources.hasHardwareWork()){
        auto sceneReadsResult = ImportRayTracingSceneGraphReads( sceneResources, this.m_raytracingSystem.sceneTlasBackingInitialState(), inputs.traceContextUploadTask, this.m_graph);
        if(!sceneReadsResult.has_value()){
            sceneReads = RayTracingSceneGraphReads();
            return MakeUnexpected(Failure());
        }
        sceneReads = sceneReadsResult.value();
    }
    const Array<GpuTaskResourceUse, s_ReflectionSurfaceReadCount> reflectionSurfaceReads(
        ReadUse(inputs.specularRoughness),
        ReadUse(inputs.refractionSpecularRoughness),
        ReadUse(inputs.normal),
        ReadUse(inputs.depth),
        ReadUse(inputs.worldPosition),
        ReadUse(inputs.refractionDepth),
        ReadUse(inputs.refractionNormalIor),
        ReadUse(inputs.meshView, ResourceStates::ConstantBuffer),
        ReadUse(inputs.currentBindlessSlots, ResourceStates::ConstantBuffer)
    );
    Vector<GpuTaskResourceUse> reflectionHardwareReads;
    // Scene shading and lights follow the scene reads.
    reflectionHardwareReads.reserve(sceneReads.uses.size() + sceneReads.csgUses.size() + s_ReflectionExtraHardwareReadCapacity);
    if(sceneReads.valid()){
        for(in GpuTaskResourceUse read : sceneReads.uses)
            reflectionHardwareReads.push_back(read);
        for(in GpuTaskResourceUse read : sceneReads.csgUses)
            reflectionHardwareReads.push_back(read);
        reflectionHardwareReads.push_back(ReadUse(inputs.sceneShading, ResourceStates::ConstantBuffer));
        reflectionHardwareReads.push_back(ReadUse(inputs.lights));
    }
    const TraceResourceSetUses reflectionSets = MakeTraceResourceSetUses(inputs.hardwareTraceGeometrySet, inputs.traceMaterialSampledTextureSet);
    ReflectionGraphInputs reflectionInputs(this.m_raytracingSystem, inputs.hardwarePreparationReady, inputs.hardwareDispatchLogged, inputs.fallbackDispatchLogged);
    reflectionInputs.opaqueDepth = inputs.depth;
    reflectionInputs.opaqueColor = inputs.opaqueColor;
    reflectionInputs.surfaceReads = Span<GpuTaskResourceUse>(reflectionSurfaceReads);
    reflectionInputs.hardwareReads = Span<GpuTaskResourceUse>(reflectionHardwareReads);
    reflectionInputs.hardwareSetReads = Span<GpuTaskResourceSetUse>(reflectionSets.uses).first(reflectionSets.useCount);
    auto reflectionGraphResult = DeclareReflectionTasks(reflectionResources, reflectionInputs, inputs.lightingTask, this.m_graph, this.m_graphics, this.m_reflectionSystem);
    if(!reflectionGraphResult.has_value())
        return MakeUnexpected(Failure());
    result.reflectionGraph = reflectionGraphResult.value();
    result.reflectionCompositeInputs = MakeReflectionCompositeInputs(reflectionResources.parameters.opaqueRadianceSlot, reflectionResources.parameters.glassRadianceSlot, reflectionSettings.debugView);
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

