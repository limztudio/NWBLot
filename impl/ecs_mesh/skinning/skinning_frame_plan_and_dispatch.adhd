// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SkinningFramePlanFlags{
    public b8 hasActiveSkin = false;
    public b8 copiesRestStreams = false;
    public b8 updatesMeshletBounds = false;
    public b8 repacksNormals = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


EntityID ResolveSkinningSkeletonEntity(in EntityID fallbackEntity, in EntityID skeletonEntity){
    if(skeletonEntity.valid())
        return skeletonEntity;
    return fallbackEntity;
}

b8 ShouldRepackSkinnedMeshNormals(in b8 hasActiveSkin, in b8 copiesRestStreams, in b8 hasAttributeBuffer){
    return (hasActiveSkin || copiesRestStreams) && hasAttributeBuffer;
}

SkinningFramePlanFlags BuildSkinningFramePlanFlags(in b8 hasActiveSkin, in u64 deformationContentRevision, in b8 hasAttributeBuffer){
    SkinningFramePlanFlags out;
    out.updatesMeshletBounds = deformationContentRevision == 0u;
    if(!out.updatesMeshletBounds)
        return out;
    out.hasActiveSkin = hasActiveSkin;
    out.copiesRestStreams = !hasActiveSkin;
    out.repacksNormals = ShouldRepackSkinnedMeshNormals(hasActiveSkin, out.copiesRestStreams, hasAttributeBuffer);
    return out;
}

b8 CanConfirmGraphOwnedSkinningDispatch(
    in b8 updatesMeshletBounds,
    in b8 hasLocalBoundsResource,
    in b8 hasMeshletLocalBoundsResource,
    in u32 resourcesEditRevision,
    in u32 commitEditRevision,
    in b8 buffersMatch,
    in b8 slotsBufferMatch,
    in b8 slotsDescriptorMatch,
    in b8 slotsPayloadMatch
){
    return
        updatesMeshletBounds
        && hasLocalBoundsResource
        && hasMeshletLocalBoundsResource
        && resourcesEditRevision == commitEditRevision
        && buffersMatch
        && slotsBufferMatch
        && slotsDescriptorMatch
        && slotsPayloadMatch
    ;
}

b8 ValidateFramePlanDispatchState(
    in u64 handleValue,
    in b8 hasBindlessResourceSlotsBuffer,
    in b8 hasValidResourceSlotsDescriptor,
    in b8 hasBoundsPipelines,
    in b8 hasActiveSkin,
    in b8 hasActiveSkinResourcesAndPipeline,
    in b8 repacksNormals,
    in b8 hasRepackPipeline
){
    if(!hasBindlessResourceSlotsBuffer || !hasValidResourceSlotsDescriptor || !hasBoundsPipelines){
        error("MeshSkinningSystem: runtime mesh '{}' has incomplete graph-owned dispatch state", handleValue);
        return false;
    }
    if(hasActiveSkin && !hasActiveSkinResourcesAndPipeline){
        error("MeshSkinningSystem: active runtime mesh '{}' has no graph-owned skinning pipeline or payload", handleValue);
        return false;
    }
    if(repacksNormals && !hasRepackPipeline){
        error("MeshSkinningSystem: runtime mesh '{}' requires a missing normal-repack pipeline", handleValue);
        return false;
    }
    return true;
}


