[asset("component")]
interface IComponent{
    b8 loadBinary(in Span<u8> binary);
    b8 loadComponentPayload(in Span<u8> payload);
    b8 validatePayload()const;
    void applyToEntity(mut Entity entity)const;
    b8 serializeComponentPayload(mut Vector<u8> outPayload)const;
}


