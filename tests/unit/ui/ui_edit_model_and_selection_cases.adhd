void VerifyUiEditCompositionTests_InvalidSurroundingByteRangesPreserveCompositionAndZeroDeletePreservesSelection(mut UiEditCompositionTests self){
    ASSERT_TRUE(self.m_model.setText("a\xCC\x81z"));
