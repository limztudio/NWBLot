#include <core/graphics/rhi/command.h>
namespace NWB::Impl{
using ReadbackQueueToken = Core::QueueSubmissionToken;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class StatisticsPendingReadback{
    public StatisticsReservationKey key;
    public ReadbackQueueToken token;

    public StatisticsPendingReadback(){
        this.key = StatisticsReservationKey();
        this.token = ReadbackQueueToken();
    }

    public StatisticsPendingReadback(in StatisticsReservationKey key, in ReadbackQueueToken token){
        this.key = key;
        this.token = token;
    }
}


