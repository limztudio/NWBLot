#include <impl/ecs_ui/toolkit/builder.adhd>
#include <impl/ecs_ui/toolkit/paint.adhd>
#include <impl/ecs_ui/toolkit/text/service.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiPaintContext{
    public mut World world;
    public mut IClipboardService clipboard;
    public mut ITextInputService textInput;
    public mut PaintBuilder paint;
    public mut TextService text;
    public in DisplayMetrics display;
    public mut Builder ui;
    public EntityID entity = s_InvalidEntityId;
    public f32 deltaSeconds = 0.0f;

    public UiPaintContext(mut World world, mut IClipboardService clipboard, mut ITextInputService textInput, mut PaintBuilder paint, mut TextService text, in DisplayMetrics display, mut Builder ui){
        this.world = world;
        this.clipboard = clipboard;
        this.textInput = textInput;
        this.paint = paint;
        this.text = text;
        this.display = display;
        this.ui = ui;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

