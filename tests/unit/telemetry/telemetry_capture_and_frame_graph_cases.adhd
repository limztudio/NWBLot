u32 g_ExistingDiagnosticCallbackCount = 0u;

FOUNDATION_INLINE void ExistingDiagnosticCallback(const DiagnosticEventRecord&)noexcept{
    ++g_ExistingDiagnosticCallbackCount;
}

class OwnerThreadTimingSink final : public Core::Perf::TimingSink{
public:
    OwnerThreadTimingSink(Core::CpuTaskScheduler& scheduler, Core::Perf::TimingRecorder& recorder, const b8 injectTasks = false)noexcept
        : m_scheduler(scheduler)
        , m_recorder(recorder)
        , m_owner(QueryCurrentThreadId())
        , m_injectTasks(injectTasks)
    {}


public:
    [[nodiscard]] virtual b8 enabled()const noexcept override{ return m_recorder.enabled(); }

    [[nodiscard]] virtual Expected<Core::Perf::TimingScopeId> registerScope(const Name& name)override{
        EXPECT_EQ(QueryCurrentThreadId(), m_owner);
        return m_recorder.registerScope(name);
    }

    virtual void recordSample(const Core::Perf::TimingScopeId scope, const f64 seconds, const u64 frameIndex)override{
        EXPECT_EQ(QueryCurrentThreadId(), m_owner);
        ++recordedSamples;
        m_recorder.recordSample(scope, seconds, frameIndex);
        if(m_injectTasks && m_injectionBudget != 0u){
            --m_injectionBudget;
            const auto taskAdmission = m_scheduler.submit([]()noexcept{});
            ASSERT_TRUE(taskAdmission);
            const Core::CpuTaskHandle task = *taskAdmission;
            ASSERT_TRUE(task.valid());
            m_scheduler.wait(task);
        }
    }

    virtual void publishFrame(const u64 frameIndex)override{
        EXPECT_EQ(QueryCurrentThreadId(), m_owner);
        m_recorder.publishFrame(frameIndex);
    }


public:
    usize recordedSamples = 0u;


private:
    Core::CpuTaskScheduler& m_scheduler;
    Core::Perf::TimingRecorder& m_recorder;
    ThreadId m_owner;
    b8 m_injectTasks;
    usize m_injectionBudget = 64u;
};

struct CpuTaskProfileIntegrationArenaTag{};
