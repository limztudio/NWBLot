Array<f32x4, 4> MakeF32x4Array4(in VectorSingle a, in VectorSingle b, in VectorSingle c, in VectorSingle d){
    Array<f32x4, 4> values = Array<f32x4, 4>();
    values[0u] = f32x4(a);
    values[1u] = f32x4(b);
    values[2u] = f32x4(c);
    values[3u] = f32x4(d);
    return values;
}

Array<f64x4, 4> MakeF64x4Array4(in VectorDouble a, in VectorDouble b, in VectorDouble c, in VectorDouble d){
    Array<f64x4, 4> values = Array<f64x4, 4>();
    values[0u] = f64x4(a);
    values[1u] = f64x4(b);
    values[2u] = f64x4(c);
    values[3u] = f64x4(d);
    return values;
}


