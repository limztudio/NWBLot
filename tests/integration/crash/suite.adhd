namespace NWB::Tests::CrashCases{

Core::Crash::CrashDetail::PlatformKind::Enum CurrentCrashPlatformKind()noexcept{
#if defined(FOUNDATION_PLATFORM_WINDOWS)
    return Core::Crash::CrashDetail::PlatformKind::Windows;
#elif defined(FOUNDATION_PLATFORM_ANDROID)
    return Core::Crash::CrashDetail::PlatformKind::Android;
#elif defined(FOUNDATION_PLATFORM_LINUX)
    return Core::Crash::CrashDetail::PlatformKind::Linux;
#else
    return Core::Crash::CrashDetail::PlatformKind::Unknown;
#endif
}

#if defined(FOUNDATION_PLATFORM_WINDOWS) || (defined(FOUNDATION_PLATFORM_LINUX) && !defined(FOUNDATION_PLATFORM_ANDROID))
u32 s_NativeLifecycleDiagnostics = 0u;
u32 s_UnlockedLifecycleDiagnostics = 0u;
Array<char, 192u> s_LastLifecycleDiagnostic = {};
Array<char, 32u> s_LastLifecycleOperation = {};

void ObserveNativeLifecycle(const DiagnosticEventRecord& record)noexcept{
    if(record.category != AStringView("crash_native_lifecycle"))
        return;
    ++s_NativeLifecycleDiagnostics;
    CopyFixedBuffer(s_LastLifecycleDiagnostic, record.message);
    CopyFixedBuffer(s_LastLifecycleOperation, record.expression);
    if(Core::Crash::CrashDetail::g_State.mutex.try_lock()){
        ++s_UnlockedLifecycleDiagnostics;
        Core::Crash::CrashDetail::g_State.mutex.unlock();
    }
}
#endif

u32 s_UploadDiagnostics = 0u;
Array<char, 64u> s_LastUploadOperation = {};
Array<char, 192u> s_LastUploadDiagnostic = {};

void ObserveUploadDiagnostic(const DiagnosticEventRecord& record)noexcept{
    if(record.category != AStringView("crash_package_upload"))
        return;
    ++s_UploadDiagnostics;
    CopyFixedBuffer(s_LastUploadOperation, record.expression);
    CopyFixedBuffer(s_LastUploadDiagnostic, record.message);
}

CrashArchiveUpload::CrashArchiveUpload()
    : m_arena(s_ArchiveFixtureArena)
    , m_root(m_arena)
{}

void CrashArchiveUpload::SetUp(){
    const auto executableDirectory = ExecutablePaths(m_arena).directory();
    ASSERT_TRUE(executableDirectory);
    const AStringView testName(::testing::UnitTest::GetInstance()->current_test_info()->name());
    m_root = *executableDirectory / "crashes" / "test_storage" / testName;
    m_rootReady = true;
    ASSERT_TRUE(RemoveAllIfExists(m_root));
    ASSERT_TRUE(EnsureDirectories(m_root));
}

void CrashArchiveUpload::TearDown(){
    if(m_rootReady)
        EXPECT_TRUE(RemoveAllIfExists(m_root));
}

};

