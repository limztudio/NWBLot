#include <tests/common/gtest_macros.adhd>
#include <tests/unit/task/gpu/case_types.adhd>
#include <tests/unit/task/gpu/gpu_task_fixture_compile.adhd>
#include <tests/unit/task/gpu/gpu_task_fixture_lifecycle.adhd>
#include <tests/unit/task/gpu/gpu_task_fixture_resource_version.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TransferOwnershipPair{
    public GpuGraphResourceId texture = GpuGraphResourceId();
    public GpuTaskId producer = GpuTaskId();
    public GpuTaskId consumer = GpuTaskId();
}

class ExternalFinalReadPair{
    public GpuGraphResourceId resource = GpuGraphResourceId();
    public GpuTaskId earlierReader = GpuTaskId();
    public GpuTaskId finalizingReader = GpuTaskId();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<TransferOwnershipPair> AddTransferOwnershipPair(mut GpuTaskGraph graph, in ResourceQueueSharingMask queueSharing){
    const Expected<GpuGraphResourceId> textureResult = AddTextureMetadata(
        graph,
        Name(s_GpuCaseTaskGraphTransferOwnershipTexture),
        "Transfer Ownership Texture",
        ResourceStates::Common,
        queueSharing
    );
    if(!textureResult.has_value())
        return MakeUnexpected(Failure());

    const GpuGraphResourceId texture = textureResult.value();

    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.cost = GpuTaskCostHint::Medium;
    scheduling.forceSubmissionBoundary = true;
    scheduling.allowPacketMerge = false;

    Array<GpuTaskResourceUse, 1> producerUses = Array<GpuTaskResourceUse, 1>();
    producerUses[0u].resource = texture;
    producerUses[0u].requiredState = ResourceStates::CopySource;
    producerUses[0u].access = GpuTaskResourceAccess::Write;

    Array<GpuTaskResourceUse, 1> consumerUses = Array<GpuTaskResourceUse, 1>();
    consumerUses[0u].resource = texture;
    consumerUses[0u].requiredState = ResourceStates::CopySource;
    consumerUses[0u].access = GpuTaskResourceAccess::Read;

    GpuTaskDesc producerDesc = GpuTaskDesc();
    producerDesc.setIdentity(Name(s_GpuCaseTaskGraphTransferOwnershipProducer));
    producerDesc.setMarkerLabel("Transfer Ownership Producer");
    producerDesc.setScheduling(scheduling);
    producerDesc.setResourceUses(producerUses);

    GpuTaskDesc consumerDesc = GpuTaskDesc();
    consumerDesc.setIdentity(Name(s_GpuCaseTaskGraphTransferOwnershipConsumer));
    consumerDesc.setMarkerLabel("Transfer Ownership Consumer");
    consumerDesc.setScheduling(scheduling);
    consumerDesc.setResourceUses(consumerUses);

    GpuTaskCommandRequirements transferCommands = GpuTaskCommandRequirements();
    transferCommands.requiredCapabilities = GpuQueueCapability::Transfer;

    const Expected<GpuTaskId> producer = graph.addTask(producerDesc, GraphicsCommands());
    const Expected<GpuTaskId> consumer = graph.addTask(consumerDesc, transferCommands);
    if(!producer.has_value() || !consumer.has_value())
        return MakeUnexpected(Failure());

    TransferOwnershipPair out = TransferOwnershipPair();
    out.texture = texture;
    out.producer = producer.value();
    out.consumer = consumer.value();
    return out;
}

Expected<ExternalFinalReadPair> AddExternalFinalReadPair(
    mut GpuTaskGraph graph,
    in GpuGraphResourceTypeEnum resourceType,
    in GpuTaskResourceRange earlierRange,
    in GpuTaskResourceRange finalizingRange,
    in ResourceStatesMask readState,
    in ResourceStatesMask externalFinalState,
    in ResourceQueueSharingMask queueSharing,
    in b8 samePacket,
    in b8 finalizerDependsOnEarlier,
    in GpuPhysicalQueueId externalFinalReleaseDestinationQueue
){
    GpuGraphResourceDesc resourceDesc = GpuGraphResourceDesc();
    resourceDesc.setIdentity(Name(s_GpuCaseTaskGraphExternalFinalReadPairResource));
    resourceDesc.setMarkerLabel("External Final Read Pair Resource");
    resourceDesc.setType(resourceType);
    resourceDesc.setInitialState(readState);
    resourceDesc.setExternalFinalState(externalFinalState);
    resourceDesc.setExternalFinalReleaseDestinationQueue(externalFinalReleaseDestinationQueue);
    resourceDesc.setQueueSharing(queueSharing);
    const Expected<GpuGraphResourceId> resourceResult = graph.importResource(resourceDesc);
    if(!resourceResult.has_value())
        return MakeUnexpected(Failure());

    const GpuGraphResourceId resource = resourceResult.value();

    const GpuTaskCommandRequirements graphicsCommands = GraphicsCommands();
    const GpuTaskCommandRequirements computeCommands = ComputeCommands();
    GpuTaskSchedulingHint earlierScheduling = GpuTaskSchedulingHint();
    earlierScheduling.forceSubmissionBoundary = !samePacket;
    earlierScheduling.allowPacketMerge = samePacket;
    GpuTaskSchedulingHint finalizingScheduling = earlierScheduling;
    finalizingScheduling.mergeWithPrevious = samePacket;

    Array<GpuTaskResourceUse, 1> earlierUses = Array<GpuTaskResourceUse, 1>();
    earlierUses[0u].resource = resource;
    earlierUses[0u].range = earlierRange;
    earlierUses[0u].requiredState = readState;
    earlierUses[0u].access = GpuTaskResourceAccess::Read;

    GpuTaskDesc earlierDesc = GpuTaskDesc();
    earlierDesc.setIdentity(Name(s_GpuCaseTaskGraphExternalFinalEarlierReader));
    earlierDesc.setMarkerLabel("External Final Earlier Reader");
    earlierDesc.setScheduling(earlierScheduling);
    earlierDesc.setResourceUses(earlierUses);
    const Expected<GpuTaskId> earlierReaderResult = graph.addTask(earlierDesc, graphicsCommands);
    if(!earlierReaderResult.has_value())
        return MakeUnexpected(Failure());

    const GpuTaskId earlierReader = earlierReaderResult.value();

    Array<GpuTaskResourceUse, 1> finalizingUses = Array<GpuTaskResourceUse, 1>();
    finalizingUses[0u].resource = resource;
    finalizingUses[0u].range = finalizingRange;
    finalizingUses[0u].requiredState = readState;
    finalizingUses[0u].access = GpuTaskResourceAccess::Read;
    finalizingUses[0u].hasIndependentStateSource = !samePacket;

    GpuTaskDesc finalizingDesc = GpuTaskDesc();
    finalizingDesc.setIdentity(Name(s_GpuCaseTaskGraphExternalFinalTerminalReader));
    finalizingDesc.setMarkerLabel("External Final Terminal Reader");
    finalizingDesc.setScheduling(finalizingScheduling);
    if(finalizerDependsOnEarlier){
        Array<GpuTaskId, 1> deps = Array<GpuTaskId, 1>();
        deps[0u] = earlierReader;
        finalizingDesc.setDependencies(deps);
    }
    finalizingDesc.setResourceUses(finalizingUses);

    GpuTaskCommandRequirements finalizerCommands = computeCommands;
    if(samePacket)
        finalizerCommands = graphicsCommands;
    const Expected<GpuTaskId> finalizingReader = graph.addTask(finalizingDesc, finalizerCommands);
    if(!finalizingReader.has_value())
        return MakeUnexpected(Failure());

    ExternalFinalReadPair out = ExternalFinalReadPair();
    out.resource = resource;
    out.earlierReader = earlierReader;
    out.finalizingReader = finalizingReader.value();
    return out;
}


