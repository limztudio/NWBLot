void VerifyEditCaretRangeFixture_ScalarPreeditRangesCanCrossLinesInsideDisplayGraphemes(mut EditCaretFixture self){
    self.m_mapping.push_back(MakeUiEditCaretMapping(0u, 0u));
    self.m_mapping.push_back(MakeUiEditCaretMapping(0u, 5u));
    ASSERT_TRUE(self.adopt("e\xcc\x81\nZ", 0u));
    self.expectRange(MakeUiEditCaretRange(1u, 5u), 0u, MakeUiControlCaretRect(5.0f, 0.0f, 6.0f, 12.0f));
    self.expectRange(MakeUiEditCaretRange(1u, 5u), 1u, MakeUiControlCaretRect(0.0f, 12.0f, 10.0f, 12.0f));
    self.expectRange(MakeUiEditCaretRange(0u, 1u), 0u, MakeUiControlCaretRect(0.0f, 0.0f, 5.0f, 12.0f));
}

void VerifyEditCaretRangeFixture_BreakCapWidthIsAppliedOnlyToSelectedLfBytes(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("ab\nc"));
    self.expectRange(MakeUiEditCaretRange(0u, 3u), 0u, MakeUiControlCaretRect(0.0f, 0.0f, 20.0f, 12.0f), 0.0f);
    self.expectRange(MakeUiEditCaretRange(0u, 3u), 0u, MakeUiControlCaretRect(0.0f, 0.0f, 20.5f, 12.0f), 0.5f);
    self.expectRange(MakeUiEditCaretRange(1u, 2u), 0u, MakeUiControlCaretRect(10.0f, 0.0f, 10.0f, 12.0f), 100.0f);
    self.expectRange(MakeUiEditCaretRange(3u, 4u), 1u, MakeUiControlCaretRect(0.0f, 12.0f, 10.0f, 12.0f), 100.0f);
}

void VerifyEditCaretRangeFixture_InvalidRangeEndpointsAndLineIndicesRejectQueries(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("e\xcc\x81\nx"));
    Array<EditBoxRange, 4u> invalid = Array<EditBoxRange, 4u>();
    invalid[0u] = MakeUiEditCaretRange(3u, 1u);
    invalid[1u] = MakeUiEditCaretRange(0u, 6u);
    invalid[2u] = MakeUiEditCaretRange(2u, 3u);
    invalid[3u] = MakeUiEditCaretRange(1u, 2u);
    for(in EditBoxRange range : invalid)
        EXPECT_FALSE(self.m_geometry.rangeOnLine(range, 0u, 1.0f).has_value());
    EXPECT_FALSE(self.m_geometry.rangeOnLine(MakeUiEditCaretRange(0u, 1u), 2u, 1.0f).has_value());
}

void VerifyEditCaretRangeFixture_InvalidBreakCapsRejectEvenCollapsedRanges(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("ab\nc"));
    Array<f32, 4u> invalid = Array<f32, 4u>();
    invalid[0u] = -1.0f;
    invalid[1u] = UiControlCaretQuietNaNF32();
    invalid[2u] = UiControlCaretInfinityF32();
    invalid[3u] = -UiControlCaretInfinityF32();
    for(in f32 cap : invalid){
        EXPECT_FALSE(self.m_geometry.rangeOnLine(MakeUiEditCaretRange(0u, 3u), 0u, cap).has_value());
        EXPECT_FALSE(self.m_geometry.rangeOnLine(MakeUiEditCaretRange(1u, 1u), 0u, cap).has_value());
    }
}

void VerifyEditCaretRangeFixture_OverflowingSelectedBreakWidthRejectsQuery(mut EditCaretFixture self){
    self.m_shaper.scalarAdvance = f32.max;
    ASSERT_TRUE(self.adoptText("a\n"));
    EXPECT_FALSE(self.m_geometry.rangeOnLine(MakeUiEditCaretRange(0u, 2u), 0u, f32.max).has_value());
    self.expectRange(MakeUiEditCaretRange(0u, 1u), 0u, MakeUiControlCaretRect(0.0f, 0.0f, f32.max, 12.0f));
}


