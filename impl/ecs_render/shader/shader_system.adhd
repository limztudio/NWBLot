////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


inline constexpr AStringView s_RendererAssetOwnerName = "RendererSystem";

using RendererShaderPathResolveCallback = Function< Expected<Name>(const Name& shaderName, AStringView variantName, const Name& stageName) >;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] FOUNDATION_INLINE ActiveSceneSubsystemsConstPtr NullActiveSceneSubsystems()noexcept{
    return nullptr;
}

template<typename SubsystemT, typename TAsset, typename SelectorF>
[[nodiscard]] FOUNDATION_INLINE Name ResolveActiveSubsystemAsset(const ActiveSceneSubsystemsConstPtr subsystems, const SelectorF& selector)noexcept{
    const SubsystemT* const subsystem = subsystems ? subsystems->findSubsystem<SubsystemT>() : nullptr;
    if(!subsystem)
        return s_NameNone;
    const Core::Assets::AssetRef<TAsset>& ref = selector(*subsystem);
    return ref.valid() ? ref.name() : s_NameNone;
}

template<typename TShader>
    requires(IsBaseOf_V<IShader, TShader> && Core::ShaderType::IsValid(ShaderAssetTypes::s_StageForShader<TShader>))
[[nodiscard]] FOUNDATION_INLINE b8 LoadRendererShader(
    const Name& shaderAssetName,
    const AStringView variantName,
    const Name& debugName,
    Core::GraphicsRuntime& graphics,
    Core::Assets::AssetManager& assetManager,
    RendererShaderPathResolveCallback& shaderPathResolver,
    Core::ShaderHandle& outShader
){
    static_assert(Core::ShaderType::IsValid(ShaderAssetTypes::s_StageForShader<TShader>));
    return ShaderAssetLoader::Load<TShader>(shaderAssetName, variantName, debugName, s_RendererAssetOwnerName, graphics, assetManager, shaderPathResolver, nullptr, outShader);
}

template<typename TShader>
    requires(IsBaseOf_V<IShader, TShader> && Core::ShaderType::IsValid(ShaderAssetTypes::s_StageForShader<TShader>))
[[nodiscard]] FOUNDATION_INLINE b8 LoadRendererShaderWithStage(
    const Name& shaderAssetName,
    const AStringView variantName,
    const Name& debugName,
    Core::GraphicsRuntime& graphics,
    Core::Assets::AssetManager& assetManager,
    RendererShaderPathResolveCallback& shaderPathResolver,
    const Name& archiveStageName,
    Core::ShaderHandle& outShader
){
    static_assert(Core::ShaderType::IsValid(ShaderAssetTypes::s_StageForShader<TShader>));
    return ShaderAssetLoader::Load<TShader>(shaderAssetName, variantName, debugName, s_RendererAssetOwnerName, graphics, assetManager, shaderPathResolver, &archiveStageName, outShader);
}

[[nodiscard]] FOUNDATION_INLINE b8 HasRendererShaderArchiveStage(
    RendererShaderPathResolveCallback& shaderPathResolver,
    const Name& shaderAssetName,
    const AStringView variantName,
    const Name& stageName
){
    return shaderPathResolver(shaderAssetName, variantName, stageName).has_value();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_ShaderArchiveDefaultVariant = "default";

type SubsystemAssetSelector<SubsystemT, TAsset> = Func<64u, AssetRef<TAsset>(in SubsystemT)>;


class RendererShaderSystem : NoCopy{
    private mut GraphicsRuntime m_graphics;
    private mut AssetManager m_assetManager;
    private mut RendererShaderPathResolveCallback m_shaderPathResolver;
    private ActiveSceneSubsystemsConstPtr m_activeSceneSubsystems = NullActiveSceneSubsystems();
    private ShaderHandle m_deferredCompositeVertexShader;

    public RendererShaderSystem(mut GraphicsRuntime graphics, mut AssetManager assetManager, mut RendererShaderPathResolveCallback shaderPathResolver){
        this.m_graphics = graphics;
        this.m_assetManager = assetManager;
        this.m_shaderPathResolver = shaderPathResolver;
    }

    public void setActiveSceneSubsystems(in ActiveSceneSubsystemsConstPtr subsystems){
        this.m_activeSceneSubsystems = subsystems;
    }

    public Name resolveSubsystemAsset<SubsystemT, TAsset>(in SubsystemAssetSelector<SubsystemT, TAsset> selector)const{
        return ResolveActiveSubsystemAsset<SubsystemT, TAsset>(this.m_activeSceneSubsystems, selector);
    }

    public void invalidateResources(){
        this.m_deferredCompositeVertexShader.reset();
    }

    public b8 loadShader<TShader, SubsystemT>(
        in SubsystemAssetSelector<SubsystemT, TShader> selector,
        in StringView variantName,
        in Name debugName,
        mut ShaderHandle outShader
    ){
        const Name resolvedShaderName = this.resolveSubsystemAsset<SubsystemT, TShader>(selector);
        if(!resolvedShaderName)
            return false;
        return this.loadShader<TShader>(resolvedShaderName, variantName, debugName, outShader);
    }

    public b8 loadShader<TShader, SubsystemT>(
        in SubsystemAssetSelector<SubsystemT, TShader> selector,
        in StringView variantName,
        in Name debugName,
        in Name archiveStageName,
        mut ShaderHandle outShader
    ){
        const Name resolvedShaderName = this.resolveSubsystemAsset<SubsystemT, TShader>(selector);
        if(!resolvedShaderName)
            return false;
        return this.loadShader<TShader>(resolvedShaderName, variantName, debugName, archiveStageName, outShader);
    }

    public b8 loadShader<TShader>(
        in Name shaderAssetName,
        in StringView variantName,
        in Name debugName,
        mut ShaderHandle outShader
    ){
        return LoadRendererShader<TShader>(shaderAssetName, variantName, debugName, this.m_graphics, this.m_assetManager, this.m_shaderPathResolver, outShader);
    }

    public b8 loadShader<TShader>(
        in Name shaderAssetName,
        in StringView variantName,
        in Name debugName,
        in Name archiveStageName,
        mut ShaderHandle outShader
    ){
        return LoadRendererShaderWithStage<TShader>(shaderAssetName, variantName, debugName, this.m_graphics, this.m_assetManager, this.m_shaderPathResolver, archiveStageName, outShader);
    }

    public b8 hasShaderArchiveStage(in Name shaderAssetName, in StringView variantName, in Name stageName)const{
        return HasRendererShaderArchiveStage(this.m_shaderPathResolver, shaderAssetName, variantName, stageName);
    }

    public b8 loadDeferredCompositeVertexShader(){
        return this.loadShader<VertexShader, DeferredSubsystem>(
            lambda[](in DeferredSubsystem sub) -> AssetRef<VertexShader>{ return sub.compositeVs; },
            s_ShaderArchiveDefaultVariant,
            Name("ECSRender_DeferredCompositeVS"),
            this.m_deferredCompositeVertexShader
        );
    }

    public in ShaderHandle deferredCompositeVertexShader()const{
        return this.m_deferredCompositeVertexShader;
    }
}


