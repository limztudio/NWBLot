////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/widgets/style.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type ImageFrame = ImageFrameRecord<SharedImageSource>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Content dimensions use atlas reference density for named regions and logical texel extent for engine sources.
class ImageOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Content, 0.0f);
    public LayoutSize height = LayoutSize(LayoutSizePolicy::Content, 0.0f);
    public Color tint;
}

class ImageMetrics{
    public Point contentSize;
}

class ImagePlacement{
    public Rect bounds;
    public Rect clip;
}

class ImageFrameRecord<TImage>{
    public Name region;
    // Null selects the atlas-region path; engine frames own the immutable source through deferred paint.
    public TImage source;
    public ImageOptions options;
    public ImageMetrics metrics;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<ImageMetrics> TryMeasureRegionImage(in ImageOptions options, in UiSkinRegion region, in f32 density){
    ImageMetrics outMetrics;
    if(!IsValidLayoutSize(options.width) || !IsValidLayoutSize(options.height) || !IsValidUiColor(options.tint) || !isFinite(density) || density <= 0.0f)
        return makeUnexpected(Failure());
    const Expected<VectorDouble> sliceExtents = TryLoadUiSkinSliceExtents(region);
    if(!sliceExtents.has_value())
        return makeUnexpected(Failure());
    const f64 pixelW = max(cast<f64>(region.rectangle.width), sliceExtents.value().x);
    const f64 pixelH = max(cast<f64>(region.rectangle.height), sliceExtents.value().y);
    const f64 densityF64 = cast<f64>(density);
    const Expected<VectorSingle> minimum = TryLoadUiSkinMinimumSize(region, VectorDouble(pixelW, pixelH, 0.0, 0.0), VectorDouble(densityF64, densityF64, densityF64, densityF64));
    if(!minimum.has_value())
        return makeUnexpected(Failure());
    outMetrics.contentSize = Point(minimum.value().x, minimum.value().y);
    return outMetrics;
}

Expected<ImagePlacement> TryPlaceImage(in Rect bounds, in Rect clip){
    ImagePlacement outPlacement;
    if(!IsBoundedUiRect(bounds) || !IsBoundedUiRect(clip))
        return makeUnexpected(Failure());
    const Expected<Rect> intersection = TryIntersectUiRects(bounds, clip, UiRectPrecision::EmptyPaint);
    if(!intersection.has_value())
        return makeUnexpected(Failure());
    outPlacement.bounds = bounds;
    outPlacement.clip = intersection.value();
    return outPlacement;
}

// Natural atlas extent uses reference density and logical minima; region padding does not inset images.
Expected<ImageMetrics> MeasureImage(in ImageOptions options, in UiSkinRegion region, in f32 density){
    return TryMeasureRegionImage(options, region, density);
}

// Engine images use one logical unit per texel without atlas density, slices or control padding.
Expected<ImageMetrics> MeasureImage(in ImageOptions options, in ImageSource source){
    if(!IsValidLayoutSize(options.width) || !IsValidLayoutSize(options.height) || !IsValidUiColor(options.tint))
        return makeUnexpected(Failure());
    // The immutable source factory admitted its complete static 2D payload before this per-frame measurement.
    ImageMetrics metrics;
    metrics.contentSize = Point(cast<f32>(source.texture().width()), cast<f32>(source.texture().height()));
    return metrics;
}

// Empty visibility remains a valid placement.
Expected<ImagePlacement> PlaceImage(in Rect bounds, in Rect clip){
    return TryPlaceImage(bounds, clip);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

