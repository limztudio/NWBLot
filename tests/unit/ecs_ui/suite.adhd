    ASSERT_TRUE(navigationFrame());
    EXPECT_TRUE(m_result.cancelled);
    EXPECT_TRUE(m_result.focused);
    EXPECT_EQ(m_navigationModel.text(), "abcdef\nx\nabcdef");
