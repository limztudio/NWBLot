////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Optional benchmark-only root. Homogeneous glass keeps source gathering active; overrides change only authored tint.
static const half NWB_SMOKE_GATHER_BENCHMARK_GLASS_TINT_MIN = 0.01h;
static const half NWB_SMOKE_GATHER_BENCHMARK_GLASS_IOR = 1.5h;
static const half NWB_SMOKE_GATHER_BENCHMARK_GLASS_COVERAGE = 0.2h;
static const half NWB_SMOKE_GATHER_BENCHMARK_GLASS_SPECULAR_F0 = 0.04h;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NwbMeshSurface nwbMaterialSurface(){
    const NwbMeshInstanceData instance = nwbMeshLoadInstance();
    const NwbSmokeSurfaceMaterial surface = nwbMaterialBindLoadSurface(instance);
    const NwbSmokeRuntimeMaterial runtime = nwbMaterialBindLoadRuntime(instance);
    const half3 tint = clamp((surface.base_color * runtime.color_tint).rgb, half3(NWB_SMOKE_GATHER_BENCHMARK_GLASS_TINT_MIN), half3(1.0h));
    NwbMeshSurface result = nwbMakeGlassSurface(tint, inNormal, NWB_SMOKE_GATHER_BENCHMARK_GLASS_IOR, tint, NWB_SMOKE_GATHER_BENCHMARK_GLASS_COVERAGE);
    nwbSetMeshSurfaceReflection(result, half3(NWB_SMOKE_GATHER_BENCHMARK_GLASS_SPECULAR_F0), half(0.0h));
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

