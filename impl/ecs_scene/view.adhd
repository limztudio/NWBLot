#include <impl/ecs_scene/components.adhd>
#include <impl/ecs_scene/view_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


MatrixSingle LoadEntityTransformMatrix(in World world, in EntityID entity){
    if(world.hasComponent<TransformComponent>(entity))
        return LoadTransformMatrix(world.getComponent<TransformComponent>(entity));
    return MatrixIdentity();
}


