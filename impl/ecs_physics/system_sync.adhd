    public MeshGeometryId geometryId;
}

class EcsPhysicsAssetCache{
    public HashMap<Name, SurfaceMaterial> materialCache;
    public HashMap<Name, Vector<EcsCachedHullGeometry>> hullGeometries;
    public HashMap<Name, Vector<EcsCachedMeshGeometry>> meshGeometries;
}

void ReleaseEcsPhysicsAssetCache(mut EcsPhysicsAssetCache cache, mut PhysicsWorld physicsWorld, in b8 destroyGeometries){
    if(destroyGeometries){
        for(in auto kv : cache.hullGeometries){
            in Vector<EcsCachedHullGeometry> list = kv.second;
            for(usize i = 0u; i < list.size(); ++i){
                if(physicsWorld.isHullGeometryValid(list[i].geometryId))
                    physicsWorld.destroyHullGeometry(list[i].geometryId);
            }
        }
        for(in auto kv : cache.meshGeometries){
            in Vector<EcsCachedMeshGeometry> list = kv.second;
            for(usize i = 0u; i < list.size(); ++i){
                if(physicsWorld.isMeshGeometryValid(list[i].geometryId))
                    physicsWorld.destroyMeshGeometry(list[i].geometryId);
            }
        }
    }
    cache.materialCache.clear();
    cache.hullGeometries.clear();
    cache.meshGeometries.clear();
}

b8 EcsF32x3BitEqual(in VectorSingle a, in VectorSingle b){
    return a.x == b.x && a.y == b.y && a.z == b.z;
}

b8 EcsF32x4BitEqual(in VectorSingle a, in VectorSingle b){
    return a.x == b.x && a.y == b.y && a.z == b.z && a.w == b.w;
}

