class UiSelectionDeletionTests : public UiEditBoxHostTests{};

class UiSelectionEpochTests : public UiEditBoxHostTests{};

class UiPopupInputTests : public testing::Test{
public:
    static constexpr AStringView s_PopupKey = "popup";
    static constexpr AStringView s_EditKey = "edit";
    static constexpr AStringView s_ChildKey = "child";

    UiPopupInputTests()
        : m_arena(Name(NWB::Tests::UiCases::s_EcsUiPopupInput))
        , m_context(m_arena), m_textInput(m_arena), m_clipboard(m_arena, true)
        , m_host(m_arena, m_context, m_textInput, m_clipboard)
        , m_baseModel(m_arena), m_popupModel(m_arena), m_childModel(m_arena)
        , m_shaper(m_arena), m_layoutBuilder(m_arena, m_shaper)
    {}

    virtual void SetUp()override{
        ASSERT_TRUE(m_textInput.setFocused(true));
        ASSERT_TRUE(m_baseModel.setText("base"));
        ASSERT_TRUE(m_popupModel.setText(s_PopupKey));
        ASSERT_TRUE(m_childModel.setText(s_ChildKey));
    }

    Alloc::GlobalArena m_arena;
    Ui::Context m_context;
    FakeTextInput m_textInput;
    FakeClipboard m_clipboard;
    UiEditBoxHost m_host;
    Ui::EditModel m_baseModel;
    Ui::EditModel m_popupModel;
    Ui::EditModel m_childModel;
    Tests::UiFixtureText::FixtureShaper m_shaper;
    Ui::TextLayoutBuilder m_layoutBuilder;
    Ui::PopupState m_popupState;
    Ui::PopupState m_childState;
    Ui::PopupToken m_childToken;
    Ui::PopupToken m_nestedParentToken;
    Ui::WidgetState m_childWidget;
    Ui::PopupToken m_token;
    Ui::WidgetState m_baseWidget;
    Ui::WidgetState m_popupWidget;
    u64 m_generation = 0u;
    const Ui::Rect m_viewport{ 0.0f, 0.0f, 500.0f, 200.0f };
    Ui::EditBoxResult m_childResult;
    Ui::EditBoxResult m_popupResult;
};

using UiEditClipboardActionEnum = NWB::Impl::Ui::EditClipboardAction::Enum;
using UiPopupScope = NWB::Impl::Ui::PopupScope;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> DeletionMutation{
    SelectionRoundTrip,
    TextUndoRoundTrip,
    ExternalReset
}

enum<u8> EpochMutation{
    SelectionRoundTrip,
    SameSelection,
    CompositionRoundTrip
}

UiTextEditOwner SelectionDeletionTestOwner(in UiSelectionDeletionTests self){
    return MakeSelectionDeletionOwner(self.m_model.instanceGeneration());
}

UiTextEditOwner SelectionEpochTestOwner(in UiSelectionEpochTests self){
    UiTextEditOwner owner = UiTextEditOwner();
    owner.widget.value = 271u;
    owner.declarationGeneration = 3u;
    owner.modelGeneration = self.m_model.instanceGeneration();
    return owner;
}


UiInputEvent MakeEcsUiFocusLostEvent(){
    UiInputEvent event = UiInputEvent();
    event.type = UiInputEventType::FocusLost;
    return event;
}

UiInputEvent MakeEcsUiFocusGainedEvent(){
    UiInputEvent event = UiInputEvent();
    event.type = UiInputEventType::FocusGained;
    return event;
}

UiPopupToken MakeEcsUiPopupToken(in UiWidgetState owner, in u64 instanceGen, in u64 openGen){
    UiPopupToken token = UiPopupToken();
    token.widget = owner.id;
    token.declarationGeneration = owner.declarationGeneration;
    token.instanceGeneration = instanceGen;
    token.openGeneration = openGen;
    return token;
}

b8 DeclareEcsUiPopupEdit(mut UiPopupInputTests self, in StringView key, in UiRect bounds, mut UiEditModel model, mut UiWidgetState outWidget, mut UiEditBoxResult outResult){
    outWidget = UiWidgetState();
    outResult = UiEditBoxResult();
    if(!DeclareEcsUiWidget(self.m_context, key, UiWidgetKind::EditBox, outWidget)){
        return false;
    }
    const UiEditBoxOptions options = UiEditBoxOptions();
    outResult = self.m_host.edit(outWidget, options, model);
    UiEditBoxView view = UiEditBoxView(self.m_arena);
    if(!outResult.valid || !PrepareEcsUiEditView(model, self.m_layoutBuilder, view)){
        return false;
    }
    const UiEditBoxStyle style = UiEditBoxStyle();
    const auto placement = view.arrange(bounds, style.padding, self.m_viewport, UiPoint());
    if(!placement || !self.m_host.publish(outWidget, view, placement.value(), options)){
        return false;
    }
    UiHitTarget target = UiHitTarget();
    target.rectangle = bounds;
    target.clip = self.m_viewport;
    target.focusable = true;
    target.pointerGesture = true;
    target.textEditable = true;
    return self.m_context.addTarget(outWidget, target);
}

b8 BeginEcsUiPopupPreparedFrame(mut UiPopupInputTests self){
    ++self.m_generation;
    if(!self.m_context.beginFrame(self.m_generation)){
        return false;
    }
    UiDisplayMetrics metrics = UiDisplayMetrics();
    metrics.logicalWidth = self.m_viewport.width;
    metrics.logicalHeight = self.m_viewport.height;
    metrics.pixelScaleX = 1.0f;
    metrics.pixelScaleY = 1.0f;
    self.m_host.beginFrame(self.m_generation, metrics);
    UiWidgetRoot rootSurface = UiWidgetRoot();
    rootSurface.value = 17u;
    rootSurface.generation = 1u;
    return self.m_context.beginRoot(rootSurface);
}

b8 BeginEcsUiPopupBaseFrame(mut UiPopupInputTests self){
    if(!BeginEcsUiPopupPreparedFrame(self)){
        return false;
    }
    UiEditBoxResult unusedResult = UiEditBoxResult();
    return DeclareEcsUiPopupEdit(self, "base", MakeEcsUiRect(10.0f, 20.0f, 180.0f, 30.0f), self.m_baseModel, self.m_baseWidget, unusedResult);
}

b8 EndEcsUiPopupPreparedFrame(mut UiPopupInputTests self){
    if(!self.m_context.endRoot() || !self.m_context.finishFrame()){
        return false;
    }
    self.m_host.finishFrame();
    return true;
}

b8 PrepareEcsUiPopupFrame(mut UiPopupInputTests self){
    if(!BeginEcsUiPopupBaseFrame(self)){
        return false;
    }
    UiWidgetState owner = UiWidgetState();
    if(!DeclareEcsUiWidget(self.m_context, UiPopupInputTests::s_PopupKey, UiWidgetKind::Popup, owner)){
        return false;
    }
    self.m_token = MakeEcsUiPopupToken(owner, self.m_popupState.instanceGeneration(), self.m_popupState.openGeneration());
    self.m_context.input().fencePopup(self.m_token);
    if(self.m_context.input().consumePopupDismissal(self.m_token)){
        self.m_popupState.close();
    }
    if(self.m_popupState.isOpen()){
        UiPopupScope scope = UiPopupScope();
        scope.token = self.m_token;
        scope.bounds = MakeEcsUiRect(230.0f, 40.0f, 240.0f, 100.0f);
        scope.viewport = self.m_viewport;
        if(!self.m_context.beginPopupScope(owner, scope) || !self.m_context.pushScope(UiPopupInputTests::s_PopupKey)){
            return false;
        }
        UiHitTarget barrier = UiHitTarget();
        barrier.rectangle = scope.bounds;
        barrier.clip = self.m_viewport;
        if(!self.m_context.addTarget(owner, barrier)){
            return false;
        }
        if(!DeclareEcsUiPopupEdit(self, UiPopupInputTests::s_EditKey, MakeEcsUiRect(250.0f, 60.0f, 180.0f, 30.0f), self.m_popupModel, self.m_popupWidget, self.m_popupResult)){
            return false;
        }
        if(!self.m_context.popScope() || !self.m_context.endPopupScope(true)){
            return false;
        }
    }
    else{
        self.m_context.input().closePopup(self.m_token);
    }
    return EndEcsUiPopupPreparedFrame(self);
}

b8 PrepareEcsUiDeferredPopupFrame(mut UiPopupInputTests self){
    if(!BeginEcsUiPopupPreparedFrame(self)){
        return false;
    }
    UiWidgetState popup = UiWidgetState();
    if(!DeclareEcsUiWidget(self.m_context, UiPopupInputTests::s_PopupKey, UiWidgetKind::Popup, popup)){
        return false;
    }
    self.m_token = MakeEcsUiPopupToken(popup, self.m_popupState.instanceGeneration(), self.m_popupState.openGeneration());
    self.m_context.input().fencePopup(self.m_token);
    if(self.m_popupState.isOpen()){
        if(!DeclareEcsUiPartWidget(self.m_context, popup, UiPopupInputTests::s_EditKey, UiWidgetKind::EditBox, self.m_popupWidget)){
            return false;
        }
        const UiEditBoxOptions options = UiEditBoxOptions();
        self.m_popupResult = self.m_host.editInPopup(self.m_popupWidget, options, self.m_token, self.m_popupModel);
        if(!self.m_popupResult.valid || self.m_context.popupToken().valid()){
            return false;
        }
        UiEditBoxView view = UiEditBoxView(self.m_arena);
        if(!PrepareEcsUiEditView(self.m_popupModel, self.m_layoutBuilder, view)){
            return false;
        }
        const UiEditBoxStyle style = UiEditBoxStyle();
        const auto placement = view.arrange(MakeEcsUiRect(250.0f, 60.0f, 180.0f, 30.0f), style.padding, self.m_viewport, UiPoint());
        if(!placement){
            return false;
        }
        UiPopupScope scope = UiPopupScope();
        scope.token = self.m_token;
        scope.bounds = MakeEcsUiRect(230.0f, 40.0f, 240.0f, 100.0f);
        scope.viewport = self.m_viewport;
        if(!self.m_context.beginPopupScope(popup, scope) || !self.m_host.publish(self.m_popupWidget, view, placement.value(), options)){
            return false;
        }
        UiHitTarget barrier = UiHitTarget();
        barrier.rectangle = scope.bounds;
        barrier.clip = self.m_viewport;
        if(!self.m_context.addTarget(popup, barrier)){
            return false;
        }
        UiHitTarget target = UiHitTarget();
        target.rectangle = placement.value().bounds;
        target.clip = self.m_viewport;
        target.focusable = true;
        target.textEditable = true;
        if(!self.m_context.addTarget(self.m_popupWidget, target) || !self.m_context.endPopupScope(true)){
            return false;
        }
    }
    else{
        self.m_context.input().closePopup(self.m_token);
    }
    return EndEcsUiPopupPreparedFrame(self);
}

b8 PrepareEcsUiNestedPopupFrame(mut UiPopupInputTests self){
    if(!BeginEcsUiPopupBaseFrame(self)){
        return false;
    }
    UiWidgetState parent = UiWidgetState();
    if(!DeclareEcsUiWidget(self.m_context, UiPopupInputTests::s_PopupKey, UiWidgetKind::Popup, parent)){
        return false;
    }
    self.m_token = MakeEcsUiPopupToken(parent, self.m_popupState.instanceGeneration(), self.m_popupState.openGeneration());
    self.m_context.input().fencePopup(self.m_token);
    if(self.m_context.input().consumePopupDismissal(self.m_token)){
        self.m_popupState.close();
    }
    if(self.m_nestedParentToken.valid() && self.m_nestedParentToken != self.m_token){
        self.m_childState.close();
    }
    self.m_nestedParentToken = self.m_token;
    if(self.m_popupState.isOpen()){
        UiPopupScope scope = UiPopupScope();
        scope.token = self.m_token;
        scope.bounds = MakeEcsUiRect(230.0f, 40.0f, 240.0f, 100.0f);
        scope.viewport = self.m_viewport;
        if(!self.m_context.beginPopupScope(parent, scope) || !self.m_context.pushScope(UiPopupInputTests::s_PopupKey)){
            return false;
        }
        UiHitTarget barrier = UiHitTarget();
        barrier.rectangle = scope.bounds;
        barrier.clip = self.m_viewport;
        if(!self.m_context.addTarget(parent, barrier)){
            return false;
        }
        if(!DeclareEcsUiPopupEdit(self, UiPopupInputTests::s_EditKey, MakeEcsUiRect(250.0f, 60.0f, 180.0f, 30.0f), self.m_popupModel, self.m_popupWidget, self.m_popupResult)){
            return false;
        }
        UiWidgetState child = UiWidgetState();
        if(!DeclareEcsUiWidget(self.m_context, UiPopupInputTests::s_ChildKey, UiWidgetKind::Popup, child)){
            return false;
        }
        self.m_childToken = MakeEcsUiPopupToken(child, self.m_childState.instanceGeneration(), self.m_childState.openGeneration());
        self.m_context.input().fencePopup(self.m_childToken);
        if(self.m_context.input().consumePopupDismissal(self.m_childToken)){
            self.m_childState.close();
        }
        if(self.m_childState.isOpen()){
            scope.token = self.m_childToken;
            scope.parent = self.m_token;
            scope.bounds = MakeEcsUiRect(60.0f, 80.0f, 240.0f, 100.0f);
            if(!self.m_context.beginPopupScope(child, scope) || !self.m_context.pushScope(UiPopupInputTests::s_ChildKey)){
                return false;
            }
            barrier.rectangle = scope.bounds;
            if(!self.m_context.addTarget(child, barrier)){
                return false;
            }
            if(!DeclareEcsUiPopupEdit(self, UiPopupInputTests::s_EditKey, MakeEcsUiRect(80.0f, 100.0f, 180.0f, 30.0f), self.m_childModel, self.m_childWidget, self.m_childResult)){
                return false;
            }
            if(!self.m_context.popScope() || !self.m_context.endPopupScope(true)){
                return false;
            }
        }
        else{
            self.m_context.input().closePopup(self.m_childToken);
        }
        if(!self.m_context.popScope() || !self.m_context.endPopupScope(true)){
            return false;
        }
    }
    else{
        self.m_context.input().closePopup(self.m_token);
    }
    return EndEcsUiPopupPreparedFrame(self);
}

b8 CommitEcsUiPopupFrame(mut UiPopupInputTests self){
    if(!self.m_context.commitFrame(self.m_generation)){
        return false;
    }
    self.m_host.commitFrame(self.m_generation);
    return true;
}

UiInputRoutingResult DispatchEcsUiPopupEvent(mut UiPopupInputTests self, in UiInputEvent event){
    self.m_host.collectNative();
    const UiWidgetId previousCapture = self.m_context.input().capture();
    const auto normalized = self.m_context.input().queue(NativeInput(event));
    EXPECT_TRUE(cast<b8>(normalized));
    if(!normalized){
        return UiInputRoutingResult();
    }
    const b8 submit = self.m_host.prepareSubmit(normalized.value());
    const UiInputRoutingResult result = self.m_context.input().process();
    self.m_host.input(normalized.value(), previousCapture, submit);
    return result;
}

b8 FrameEcsUiPopup(mut UiPopupInputTests self){
    return PrepareEcsUiPopupFrame(self) && CommitEcsUiPopupFrame(self);
}

b8 NestedFrameEcsUiPopup(mut UiPopupInputTests self){
    return PrepareEcsUiNestedPopupFrame(self) && CommitEcsUiPopupFrame(self);
}

void DispatchEcsUiPopupKey(mut UiPopupInputTests self, in KeyEnum value, in b8 control){
    UiInputEvent down = UiInputEvent();
    down.key = value;
    down.type = UiInputEventType::KeyDown;
    down.control = control;
    EXPECT_TRUE(DispatchEcsUiPopupEvent(self, down).commandConsumed);
    UiInputEvent up = UiInputEvent();
    up.key = value;
    up.type = UiInputEventType::KeyUp;
    up.control = control;
    EXPECT_TRUE(DispatchEcsUiPopupEvent(self, up).commandConsumed);
}

void DispatchEcsUiPopupKey(mut UiPopupInputTests self, in KeyEnum value){
    DispatchEcsUiPopupKey(self, value, false);
}

void FocusEcsUiPopupBase(mut UiPopupInputTests self){
    ASSERT_TRUE(FrameEcsUiPopup(self));
    DispatchEcsUiPopupKey(self, Key::Tab, false);
    ASSERT_EQ(self.m_context.input().focus(), self.m_baseWidget.id);
    ASSERT_TRUE(FrameEcsUiPopup(self));
    ASSERT_TRUE(self.m_textInput.activeSession().valid());
    ASSERT_EQ(self.m_textInput.surroundingText(), "base");
}

void FocusEcsUiPopupEditor(mut UiPopupInputTests self){
    FocusEcsUiPopupBase(self);
    self.m_popupState.open();
    ASSERT_TRUE(FrameEcsUiPopup(self));
    ASSERT_EQ(self.m_context.input().focus(), self.m_popupWidget.id);
    ASSERT_TRUE(FrameEcsUiPopup(self));
    ASSERT_TRUE(self.m_textInput.activeSession().valid());
    ASSERT_EQ(self.m_textInput.surroundingText(), UiPopupInputTests::s_PopupKey);
}

b8 SeedSelectionDeletion(mut UiSelectionDeletionTests self, in b8 reverse){
    if(!self.m_model.setText("abcDEFghi")){
        return false;
    }
    if(reverse){
        return self.m_model.setSelection(6u, 3u);
    }
    return self.m_model.setSelection(3u, 6u);
}

b8 MutateSelectionDeletion(mut UiSelectionDeletionTests self, in DeletionMutation mutation){
    const usize anchor = self.m_model.anchor();
    const usize caret = self.m_model.caret();
    if(mutation == DeletionMutation::SelectionRoundTrip){
        return self.m_model.setSelection(0u, 0u) && self.m_model.setSelection(anchor, caret);
    }
    if(mutation == DeletionMutation::TextUndoRoundTrip){
        return self.m_model.replaceSelection("XYZ") && self.m_model.undo();
    }
    if(mutation == DeletionMutation::ExternalReset){
        return self.m_model.setText("abcDEFghi") && self.m_model.setSelection(anchor, caret);
    }
    return false;
}

void ExpectSelectionDeletionBaseline(in UiSelectionDeletionTests self, in u64 revision, in u64 externalRevision, in u64 selectionGeneration){
    EXPECT_EQ(self.m_model.text(), "abcDEFghi");
    EXPECT_EQ(self.m_model.anchor(), 3u);
    EXPECT_EQ(self.m_model.caret(), 6u);
    EXPECT_EQ(self.m_model.revision(), revision);
    EXPECT_EQ(self.m_model.externalRevision(), externalRevision);
    EXPECT_EQ(self.m_model.selectionGeneration(), selectionGeneration);
    EXPECT_FALSE(self.m_model.composition().active);
}

void VerifySelectionDeletionSessionOrder(mut UiSelectionDeletionTests self, in b8 reverse){
    ASSERT_TRUE(SeedSelectionDeletion(self, reverse));
    UiTextEditSession session = UiTextEditSession(self.m_arena, self.m_textInput);
    ASSERT_EQ(session.begin(SelectionDeletionTestOwner(self), s_SelectionDeletionCaret, self.m_model), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.preedit("IME", 0u, 3u), TextInputAdmission::Accepted);
    ASSERT_EQ(session.drain(SelectionDeletionTestOwner(self), self.m_model).status, UiTextEditStatus::Applied);
    ASSERT_TRUE(self.m_model.composition().active);
    EXPECT_FALSE(self.m_model.canUndo());
    const u64 surrounding = session.surroundingRevision();
    ASSERT_EQ(self.m_textInput.preedit(StringView(), 0u, 0u), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.erase(1u, 1u, surrounding, TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.commit("X"), TextInputAdmission::Accepted);
    const UiTextEditResult result = session.drain(SelectionDeletionTestOwner(self), self.m_model);
    EXPECT_EQ(result.status, UiTextEditStatus::Applied);
    EXPECT_EQ(result.eventsApplied, 3u);
    EXPECT_EQ(self.m_model.text(), "abXhi");
    EXPECT_EQ(self.m_model.anchor(), 3u);
    EXPECT_EQ(self.m_model.caret(), 3u);
    EXPECT_FALSE(self.m_model.composition().active);
    ASSERT_TRUE(session.end(SelectionDeletionTestOwner(self), self.m_model));
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "abDEFhi");
    usize expectedMidAnchor = 2u;
    usize expectedMidCaret = 5u;
    usize expectedInitAnchor = 3u;
    usize expectedInitCaret = 6u;
    if(reverse){
        expectedMidAnchor = 5u;
        expectedMidCaret = 2u;
        expectedInitAnchor = 6u;
        expectedInitCaret = 3u;
    }
    EXPECT_EQ(self.m_model.anchor(), expectedMidAnchor);
    EXPECT_EQ(self.m_model.caret(), expectedMidCaret);
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "abcDEFghi");
    EXPECT_EQ(self.m_model.anchor(), expectedInitAnchor);
    EXPECT_EQ(self.m_model.caret(), expectedInitCaret);
    EXPECT_FALSE(self.m_model.canUndo());
}

void VerifySelectionDeletionSessionRejected(mut UiSelectionDeletionTests self, in DeletionMutation mutation){
    ASSERT_TRUE(SeedSelectionDeletion(self, false));
    UiTextEditSession session = UiTextEditSession(self.m_arena, self.m_textInput);
    ASSERT_EQ(session.begin(SelectionDeletionTestOwner(self), s_SelectionDeletionCaret, self.m_model), TextInputAdmission::Accepted);
    const TextInputSessionToken token = session.token();
    ASSERT_EQ(self.m_textInput.erase(1u, 1u, self.m_textInput.surroundingRevision(self.m_textInput.activeSession()), TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.commit("late"), TextInputAdmission::Accepted);
    ASSERT_TRUE(MutateSelectionDeletion(self, mutation));
    const u64 revision = self.m_model.revision();
    const u64 externalRevision = self.m_model.externalRevision();
    const u64 selectionGeneration = self.m_model.selectionGeneration();
    const u64 compositionGeneration = self.m_model.compositionGeneration();
    const b8 canUndo = self.m_model.canUndo();
    const b8 canRedo = self.m_model.canRedo();
    EXPECT_FALSE(session.matchesPublished(SelectionDeletionTestOwner(self), self.m_model));
    const UiTextEditResult result = session.drain(SelectionDeletionTestOwner(self), self.m_model);
    EXPECT_EQ(result.status, UiTextEditStatus::StaleModel);
    EXPECT_EQ(result.eventsApplied, 0u);
    EXPECT_FALSE(result.textChanged);
    ExpectSelectionDeletionBaseline(self, revision, externalRevision, selectionGeneration);
    EXPECT_EQ(self.m_model.compositionGeneration(), compositionGeneration);
    EXPECT_EQ(self.m_model.canUndo(), canUndo);
    EXPECT_EQ(self.m_model.canRedo(), canRedo);
    EXPECT_FALSE(session.token().valid());
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.m_textInput.emitCommit(token, "later"), TextInputAdmission::InvalidSession);
}

void VerifySelectionDeletionHostRejected(mut UiSelectionDeletionTests self, in DeletionMutation mutation){
    ASSERT_TRUE(SeedSelectionDeletion(self, false));
    ASSERT_TRUE(self.activate());
    const TextInputSessionToken token = self.m_textInput.activeSession();
    ASSERT_EQ(self.m_textInput.erase(1u, 1u, self.m_textInput.surroundingRevision(self.m_textInput.activeSession()), TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.commit("late"), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    ASSERT_TRUE(MutateSelectionDeletion(self, mutation));
    const u64 revision = self.m_model.revision();
    const u64 externalRevision = self.m_model.externalRevision();
    const u64 selectionGeneration = self.m_model.selectionGeneration();
    const b8 canUndo = self.m_model.canUndo();
    const b8 canRedo = self.m_model.canRedo();
    ASSERT_TRUE(self.frame(self.m_model));
    ExpectSelectionDeletionBaseline(self, revision, externalRevision, selectionGeneration);
    EXPECT_FALSE(self.m_result.textChanged);
    EXPECT_FALSE(self.m_result.selectionChanged);
    EXPECT_EQ(self.m_model.canUndo(), canUndo);
    EXPECT_EQ(self.m_model.canRedo(), canRedo);
    EXPECT_NE(self.m_textInput.activeSession(), token);
    EXPECT_EQ(self.m_textInput.emitCommit(token, "later"), TextInputAdmission::InvalidSession);
}

b8 SeedSelectionEpoch(mut UiSelectionEpochTests self){
    return self.m_model.setText("abcd") && self.m_model.setSelection(1u, 3u);
}

b8 MutateSelectionEpoch(mut UiSelectionEpochTests self, in EpochMutation mutation){
    const usize anchor = self.m_model.anchor();
    const usize caret = self.m_model.caret();
    if(mutation == EpochMutation::SelectionRoundTrip){
        return self.m_model.setSelection(0u, 0u) && self.m_model.setSelection(anchor, caret);
    }
    if(mutation == EpochMutation::SameSelection){
        return self.m_model.setSelection(anchor, caret);
    }
    if(!self.m_model.beginComposition() || !self.m_model.updateComposition("IME", 0u, 3u)){
        return false;
    }
    self.m_model.cancelComposition();
    return true;
}

void ExpectSelectionEpochPreserved(in UiSelectionEpochTests self, in u64 revision, in u64 externalRevision){
    EXPECT_EQ(self.m_model.text(), "abcd");
    EXPECT_EQ(self.m_model.revision(), revision);
    EXPECT_EQ(self.m_model.externalRevision(), externalRevision);
    EXPECT_EQ(self.m_model.anchor(), 1u);
    EXPECT_EQ(self.m_model.caret(), 3u);
    EXPECT_FALSE(self.m_model.composition().active);
    EXPECT_FALSE(self.m_model.canUndo());
}

void VerifySelectionEpochClipboardActionRejected(mut UiSelectionEpochTests self, in EpochMutation mutation, in UiEditClipboardActionEnum action){
    const ScopedTestTrace trace = ScopedTestTrace(action);
    ASSERT_TRUE(SeedSelectionEpoch(self));
    UiEditClipboardController controller = UiEditClipboardController(self.m_arena, self.m_clipboard);
    ASSERT_EQ(controller.request(SelectionEpochTestOwner(self), self.m_model, action).status, UiEditClipboardStatus::Pending);
    ASSERT_TRUE(self.m_clipboard.pump());
    const ClipboardRequestToken token = controller.token();
    ASSERT_EQ(self.m_clipboard.startedToken, token);
    const u64 revision = self.m_model.revision();
    const u64 externalRevision = self.m_model.externalRevision();
    ASSERT_TRUE(MutateSelectionEpoch(self, mutation));
    ASSERT_TRUE(self.m_clipboard.deliver(token, ClipboardStatus::Success, "replacement"));
    const UiEditClipboardResult result = controller.drain(SelectionEpochTestOwner(self), self.m_model);
    EXPECT_EQ(result.status, UiEditClipboardStatus::StaleModel);
    EXPECT_FALSE(result.textChanged);
    EXPECT_FALSE(result.selectionChanged);
    EXPECT_FALSE(controller.pending());
    ExpectSelectionEpochPreserved(self, revision, externalRevision);
    EXPECT_FALSE(self.m_clipboard.deliver(token, ClipboardStatus::Success, "later"));
}

void VerifySelectionEpochClipboardRejected(mut UiSelectionEpochTests self, in EpochMutation mutation){
    self.m_clipboard.delayed = true;
    VerifySelectionEpochClipboardActionRejected(self, mutation, UiEditClipboardAction::Cut);
    VerifySelectionEpochClipboardActionRejected(self, mutation, UiEditClipboardAction::Paste);
}

void VerifySelectionEpochSessionRejected(mut UiSelectionEpochTests self, in EpochMutation mutation, in b8 refresh){
    ASSERT_TRUE(SeedSelectionEpoch(self));
    UiTextEditSession session = UiTextEditSession(self.m_arena, self.m_textInput);
    ASSERT_EQ(session.begin(SelectionEpochTestOwner(self), s_SessionTestCaret, self.m_model), TextInputAdmission::Accepted);
    const TextInputSessionToken token = session.token();
    const u64 surrounding = session.surroundingRevision();
    const u64 revision = self.m_model.revision();
    const u64 externalRevision = self.m_model.externalRevision();
    ASSERT_TRUE(session.matchesPublished(SelectionEpochTestOwner(self), self.m_model));
    ASSERT_EQ(self.m_textInput.commit("late"), TextInputAdmission::Accepted);
    ASSERT_TRUE(MutateSelectionEpoch(self, mutation));
    EXPECT_FALSE(session.matchesPublished(SelectionEpochTestOwner(self), self.m_model));
    if(refresh){
        TextInputRect nextCaret = TextInputRect();
        nextCaret.x = 400;
        nextCaret.y = 320;
        nextCaret.width = 2;
        nextCaret.height = 20;
        EXPECT_EQ(session.refresh(SelectionEpochTestOwner(self), self.m_model, nextCaret), TextInputAdmission::InvalidSession);
        EXPECT_EQ(self.m_textInput.caretRect().x, s_SessionTestCaret.x);
        EXPECT_EQ(self.m_textInput.caretRect().y, s_SessionTestCaret.y);
        EXPECT_EQ(session.surroundingRevision(), surrounding);
        EXPECT_EQ(session.token(), token);
    }
    const UiTextEditResult result = session.drain(SelectionEpochTestOwner(self), self.m_model);
    EXPECT_EQ(result.status, UiTextEditStatus::StaleModel);
    EXPECT_EQ(result.eventsApplied, 0u);
    EXPECT_FALSE(result.textChanged);
    EXPECT_FALSE(session.token().valid());
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.m_textInput.emitCommit(token, "later"), TextInputAdmission::InvalidSession);
    ExpectSelectionEpochPreserved(self, revision, externalRevision);
}

void VerifySelectionEpochHostRejected(mut UiSelectionEpochTests self, in EpochMutation mutation){
    ASSERT_TRUE(SeedSelectionEpoch(self));
    ASSERT_TRUE(self.activate());
    const TextInputSessionToken token = self.m_textInput.activeSession();
    const u64 revision = self.m_model.revision();
    const u64 externalRevision = self.m_model.externalRevision();
    ASSERT_EQ(self.m_textInput.commit("late"), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    ASSERT_TRUE(MutateSelectionEpoch(self, mutation));
    const u64 selectionGeneration = self.m_model.selectionGeneration();
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_FALSE(self.m_result.textChanged);
    EXPECT_FALSE(self.m_result.selectionChanged);
    EXPECT_EQ(self.m_model.selectionGeneration(), selectionGeneration);
    ExpectSelectionEpochPreserved(self, revision, externalRevision);
    EXPECT_EQ(self.m_textInput.emitCommit(token, "later"), TextInputAdmission::InvalidSession);
    EXPECT_NE(self.m_textInput.activeSession(), token);
}


