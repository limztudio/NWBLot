[cpp_header("<core/task/gpu/output_layer_contributor.h>"), cpp_name("::NWB::Core::GpuTaskGraphOutputLayer")]
extern class GpuTaskGraphOutputLayer{
    GpuTaskId readyTask;
    GpuGraphResourceId color;
    GpuGraphResourceVersionId colorVersion;
    GpuDescriptorHandle sampledImage;
    u64 frameGeneration;
    b8 validShape(...)const;
};

[cpp_header("<core/task/gpu/output_layer_contributor.h>"), cpp_name("::NWB::Core::IGpuTaskGraphOutputLayerContributor")]
extern class IGpuTaskGraphOutputLayerContributor{
    void acceptTaskGraphOutputLayer(in u64 generation, in QueueSubmissionToken submissionToken);
    Expected<GpuTaskGraphOutputLayer> declareTaskGraphOutputLayer(mut GpuTaskGraph graph);
    b8 prepareTaskGraphOutputLayer(in AcquiredPresentationFrame frame);
};


