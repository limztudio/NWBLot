void VerifyUiEditNavigationStateTests_IndependentOwnersCannotReviveEachOthersCopiedIntent(){
    EditNavigationState first = EditNavigationState();
    EditNavigationState second = EditNavigationState();
    EXPECT_FALSE(second.matches(first.snapshot()));
    ASSERT_TRUE(first.setPreferredX(40.0f));
    ASSERT_TRUE(second.setPreferredX(40.0f));
    EXPECT_FALSE(second.matches(first.snapshot()));
}

void VerifyUiEditNavigationStateTests_IdenticalPreferredColumnRetiresAnEarlierBorrow(){
    EditNavigationState state = EditNavigationState();
    ASSERT_TRUE(state.setPreferredX(40.0f));
    const EditNavigationSnapshot accepted = state.snapshot();
    ASSERT_TRUE(state.setPreferredX(40.0f));
    EXPECT_GT(state.generation(), accepted.generation);
    EXPECT_FALSE(state.matches(accepted));
    EXPECT_TRUE(state.hasPreferredX());
    EXPECT_FLOAT_EQ(state.preferredX(), 40.0f);
}

void VerifyUiEditNavigationStateTests_ColumnAwayAndBackCannotReviveAnEarlierBorrow(){
    EditNavigationState state = EditNavigationState();
    ASSERT_TRUE(state.setPreferredX(20.0f));
    const EditNavigationSnapshot accepted = state.snapshot();
    ASSERT_TRUE(state.setPreferredX(30.0f));
    ASSERT_TRUE(state.setPreferredX(20.0f));
    EXPECT_FALSE(state.matches(accepted));
}

void VerifyUiEditNavigationStateTests_ResetRetiresBothValidAndAlreadyEmptyIntent(){
    EditNavigationState state = EditNavigationState();
    ASSERT_TRUE(state.setPreferredX(60.0f));
    const EditNavigationSnapshot preferred = state.snapshot();
    state.reset();
    EXPECT_FALSE(state.matches(preferred));
    EXPECT_FALSE(state.hasPreferredX());
    const EditNavigationSnapshot empty = state.snapshot();
    state.reset();
    EXPECT_FALSE(state.matches(empty));
    EXPECT_GT(state.generation(), empty.generation);
}

void VerifyUiEditNavigationStateTests_NonfiniteColumnsRejectWithoutRetiringAcceptedIntent(){
    EditNavigationState state = EditNavigationState();
    ASSERT_TRUE(state.setPreferredX(25.0f));
    const EditNavigationSnapshot accepted = state.snapshot();
    Array<f32, 3u> invalid = Array<f32, 3u>();
    invalid[0u] = bit_cast<f32>(0x7f800000u);
    invalid[1u] = bit_cast<f32>(0xff800000u);
    invalid[2u] = bit_cast<f32>(0x7fc00000u);
    for(in f32 value : invalid){
        EXPECT_FALSE(state.setPreferredX(value));
        EXPECT_TRUE(state.matches(accepted));
    }
}

void VerifyUiEditNavigationStateTests_SnapshotValueChangesAreRejectedEvenAtTheSameGeneration(){
    EditNavigationState state = EditNavigationState();
    ASSERT_TRUE(state.setPreferredX(25.0f));
    EditNavigationSnapshot copied = state.snapshot();
    copied.preferredX = 26.0f;
    EXPECT_FALSE(state.matches(copied));
    copied = state.snapshot();
    copied.valid = false;
    EXPECT_FALSE(state.matches(copied));
}

void VerifyUiEditNavigationStateTests_FiniteExtremeColumnsRemainFiniteAuthoritativeIntent(){
    EditNavigationState state = EditNavigationState();
    ASSERT_TRUE(state.setPreferredX(f32.max));
    EXPECT_EQ(state.preferredX(), f32.max);
    ASSERT_TRUE(state.setPreferredX(-f32.max));
    EXPECT_EQ(state.preferredX(), -f32.max);
    EXPECT_TRUE(state.matches(state.snapshot()));
}

void VerifyUiEditNavigationStateTests_OsModifiersAndUnrelatedIntentsRejectNavigation(){
    GlobalArena arena = GlobalArena(s_UiCaseTestsUiEditNavigation);
    InputBindings bindings = InputBindings(arena);
    Array<InputKeyBinding, 8u> chords = Array<InputKeyBinding, 8u>();
    chords[0u] = MakeUiEditKeyChord(CoreKey::Up, CoreInputModifier::Control);
    chords[1u] = MakeUiEditKeyChord(CoreKey::Down, CoreInputModifier::Alt);
    chords[2u] = MakeUiEditKeyChord(CoreKey::PageUp, CoreInputModifier::Control | CoreInputModifier::Shift);
    chords[3u] = MakeUiEditKeyChord(CoreKey::PageDown, CoreInputModifier::Shift | CoreInputModifier::Alt);
    chords[4u] = MakeUiEditKeyChord(CoreKey::Unknown, 0);
    chords[5u] = MakeUiEditKeyChord(CoreKey::Enter, 0);
    chords[6u] = MakeUiEditKeyChord(CoreKey::Left, 0);
    chords[7u] = MakeUiEditKeyChord(MakeUiEditOutOfBoundsKeyCode(), 0);
    for(in InputKeyBinding chord : chords)
        EXPECT_FALSE(TryTranslateEditNavigation(bindings.resolve(chord.key, chord.modifiers)).has_value());

    Array<InputCommandIntent, 6u> rejected = Array<InputCommandIntent, 6u>();
    rejected[0u] = MakeUiEditCommandIntent(InputCommand::Up, true, false);
    rejected[1u] = MakeUiEditCommandIntent(InputCommand::Down, false, false);
    rejected[2u] = MakeUiEditCommandIntent(InputCommand::PageUp, false, false);
    rejected[3u] = MakeUiEditCommandIntent(InputCommand::PageDown, true, false);
    rejected[4u] = MakeUiEditCommandIntent(InputCommand::FocusNext, false, true);
    rejected[5u] = MakeUiEditCommandIntent(MakeUiEditInvalidInputCommand(), true, true);
    for(in InputCommandIntent intent : rejected)
        EXPECT_FALSE(TryTranslateEditNavigation(intent).has_value());
    UiKeepEditArenaAlive(arena);
}


