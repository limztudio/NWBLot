class MeshCookEntry{
    public Name virtualPath = s_NameNone;
    public Vector<f32x3u> positions;
    public Vector<f16x4u> normals;
    public Vector<f16x4u> tangents;
    public Vector<f32x2u> uv0;
    public Vector<f16x4u> colors;
    public Vector<MeshVertexRef> vertexRefs;
    public Vector<MeshletDesc> meshlets;
    public Vector<MeshletBounds> meshletBounds;
    public Vector<MeshletPositionStreamRef> meshletPositionStreamRefs;
    public Vector<MeshletAttributeStreamRef> meshletAttributeStreamRefs;
    public Vector<u8> meshletPositionRefDeltas;
    public Vector<u8> meshletAttributeRefDeltas;
    public Vector<MeshletLocalVertexRef> meshletLocalVertexRefs;
    public Vector<u8> meshletPrimitiveIndices;
}

b8 SerializeMeshBinaryPayload(
    in Span<f32x3u> positions,
    in Span<f16x4u> normals,
    in Span<f16x4u> tangents,
    in Span<f32x2u> uv0,
    in Span<f16x4u> colors,
    in Span<MeshletDesc> meshlets,
    in Span<MeshletBounds> meshletBounds,
    in Span<u8> meshletPositionRefDeltas,
    in Span<u8> meshletAttributeRefDeltas,
    in Span<MeshletLocalVertexRef> meshletLocalVertexRefs,
    in Span<u8> meshletPrimitiveIndices,
    in Span<u32> solidTriangleWords,
    mut Vector<u8> outBinary
){
    MeshBinaryCodec codec;
    return codec.serialize(
        positions,
        normals,
        tangents,
        uv0,
        colors,
        meshlets,
        meshletBounds,
        meshletPositionRefDeltas,
        meshletAttributeRefDeltas,
        meshletLocalVertexRefs,
        meshletPrimitiveIndices,
        solidTriangleWords,
        outBinary
    );
}

Expected<Vector<SkeletonJointMatrix>> ParseSkinCookInverseBindMatrices(in Path nwbFilePath, in MetascriptValue asset){
    Vector<SkeletonJointMatrix> values;

    const Expected<Span<MetascriptValue>> matrices = ReadMetadataListField(nwbFilePath, asset, s_SkinMetaDiagnosticPrefix, s_SkinInverseBindMatricesField);
    if(!matrices.has_value())
        return MakeUnexpected(Failure());

    const Span<MetascriptValue> matrixList = matrices.value();
    values.reserve(matrixList.size());
    const String filePathText = PathToString(nwbFilePath);
    for(usize matrixIndex = 0u; matrixIndex < matrixList.size(); ++matrixIndex){
        const Expected<SkeletonJointMatrix> matrix = ParseSkeletonJointMatrix(nwbFilePath, matrixList[matrixIndex], s_SkinMetaKind, s_SkinInverseBindMatricesField);
        if(!matrix.has_value())
            return MakeUnexpected(Failure());

        if(!ValidateSkinCookInverseBindMatrix(MatrixSingle(matrix.value()), filePathText, matrixIndex))
            return MakeUnexpected(Failure());
        values.push_back(matrix.value());
    }

    if(!ValidateSkinCookInverseBindMatricesNonEmpty(values.size(), filePathText))
        return MakeUnexpected(Failure());
    return values;
}

b8 ValidateSkinCookInfluenceJointIndexBounds(in Path nwbFilePath, in usize jointCount, in Span<SkinInfluence4> influences){
    b8 invalid = jointCount > cast<usize>(u16.max) + 1u;
    if(!invalid){
        for(in SkinInfluence4 influence : influences){
            if(TryFindOutOfRangeSkinInfluenceJoint(influence, cast<u32>(jointCount)).has_value()){
                invalid = true;
                break;
            }
        }
    }
    if(!invalid)
        return true;

    const String filePathText = PathToString(nwbFilePath);
    return ValidateSkinCookInfluenceJointIndices(filePathText, jointCount, influences);
}

Expected<Skin> BuildSkinAssetFromPayload(
    in Name virtualPath,
    in AssetRef<Mesh> mesh,
    in AssetRef<Skeleton> skeleton,
    in Vector<SkinInfluence4> influences,
    in Vector<SkeletonJointMatrix> inverseBindMatrices
){
    Skin asset(virtualPath);
    asset.setMesh(mesh);
    asset.setSkeleton(skeleton);
    asset.setPayload(influences, inverseBindMatrices);
    if(!asset.validatePayload())
        return MakeUnexpected(Failure());
    return asset;
}

[asset_writer]
b8 SerializeMeshAsset(in Mesh mesh, mut Vector<u8> outBinary){
    if(!mesh.validatePayload())
        return false;

    return SerializeMeshBinaryPayload(
        mesh.positionStream(),
        mesh.normalStream(),
        mesh.tangentStream(),
        mesh.uv0Stream(),
        mesh.colorStream(),
        mesh.meshlets(),
        mesh.meshletBounds(),
        mesh.meshletPositionRefDeltas(),
        mesh.meshletAttributeRefDeltas(),
        mesh.meshletLocalVertexRefs(),
        mesh.meshletPrimitiveIndices(),
        mesh.solidTriangleWords(),
        outBinary
    );
}

[asset_writer]
b8 SerializeSkinAsset(in Skin skin, mut Vector<u8> outBinary){
    if(!skin.validatePayload())
        return false;

    return SerializeSkinBinaryPayload(
        skin.mesh().name().hash(),
        skin.skeleton().name().hash(),
        skin.influences(),
        skin.inverseBindMatrices(),
        outBinary
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<SkinCookEntry> ParseSkinCookMetadata(in Name virtualPath, in Path file, in MetascriptValue value){
    SkinCookEntry entry;
    if(!CheckMetadataAssetMap(file, value, s_SkinMetaDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_SkinMetaDiagnosticPrefix, entry)
        || !ValidateMetadataAssetFields(file, value, s_SkinMetaDiagnosticPrefix, lambda[](in StringView field) -> b8{
            return IsAllowedSkinMetadataField(field);
        }))
        return MakeUnexpected(Failure());

    const Expected<AssetRef<Mesh>> mesh = ReadMetadataAssetRefField<Mesh>(file, value, s_SkinMetaDiagnosticPrefix, s_SkinMetaMeshField, true);
    if(!mesh.has_value())
        return MakeUnexpected(Failure());
    entry.mesh = mesh.value();
    const Expected<AssetRef<Skeleton>> skeleton = ReadMetadataAssetRefField<Skeleton>(file, value, s_SkinMetaDiagnosticPrefix, s_SkinMetaSkeletonField, true);
    if(!skeleton.has_value())
        return MakeUnexpected(Failure());
    entry.skeleton = skeleton.value();
    if(!ParseSkinInfluenceMetadataInto(file, value, s_SkinMetaKind, "", true, entry.influences))
        return MakeUnexpected(Failure());
    const Expected<Vector<SkeletonJointMatrix>> matrices = ParseSkinCookInverseBindMatrices(file, value);
    if(!matrices.has_value())
        return MakeUnexpected(Failure());
    entry.inverseBindMatrices = matrices.value();
    if(!ValidateSkinCookInfluenceJointIndexBounds(file, entry.inverseBindMatrices.size(), entry.influences))
        return MakeUnexpected(Failure());
    return entry;
}

Expected<SkinCookEntry> ParseSkinCookMetadata(in Path root, in StringView virtualRoot, in Path file, in MetascriptDocument document){
    return ParseCookMetadataDocument<SkinCookEntry>(root, virtualRoot, file, document, s_SkinMetaDiagnosticPrefix, lambda[in file](in Name path, in MetascriptValue value) -> Expected<SkinCookEntry>{
        return ParseSkinCookMetadata(path, file, value);
    });
}

Expected<Skin> BuildSkinAsset(in SkinCookEntry entry){
    return BuildSkinAssetFromPayload(entry.virtualPath, entry.mesh, entry.skeleton, entry.influences, entry.inverseBindMatrices);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
b8 BuildSourceMeshStreams(in Path file, in MetascriptValue value, in b8 parallelEnabled, in u32 workers, mut MeshCookEntry entry){
    SourceMeshStreams streams;
    if(!ReadCommonSourceMeshStreams(file, value, streams))
        return false;
    CopySourceMeshStreamsToCookStreams(
        streams.positions, streams.normals, streams.tangents, streams.uv0, streams.colors, streams.vertexRefs,
        entry.positions, entry.normals, entry.tangents, entry.uv0, entry.colors, entry.vertexRefs
    );
    return BuildCookMeshlets(
        file, streams.indices, parallelEnabled, workers,
        entry.positions, entry.normals, entry.tangents, entry.uv0, entry.colors, entry.vertexRefs,
        entry.meshlets, entry.meshletBounds, entry.meshletPositionStreamRefs, entry.meshletAttributeStreamRefs,
        entry.meshletLocalVertexRefs, entry.meshletPrimitiveIndices
    );
}

[cpp_unwind]
Expected<MeshCookEntry> ReadMeshSourceValue(in Name virtualPath, in Path file, in MetascriptValue value, in b8 parallelEnabled, in u32 workers){
    MeshCookEntry entry;
    if(!CheckMetadataAssetMap(file, value, s_MeshMetaText)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_MeshMetaText, entry)
        || !ValidateMetadataAssetFields(file, value, s_MeshMetaText, IsAllowedMeshAssetField))
        return MakeUnexpected(Failure());
    if(!BuildSourceMeshStreams(file, value, parallelEnabled, workers, entry))
        return MakeUnexpected(Failure());
    return entry;
}

[cpp_unwind]
Expected<MeshCookEntry> ParseMeshCookMetadata(in Name virtualPath, in Path file, in MetascriptValue value, in CpuTaskScheduler scheduler){
    return ReadMeshSourceValue(virtualPath, file, value, scheduler.isParallelEnabled(), scheduler.workerThreadCount());
}

[cpp_unwind]
Expected<MeshCookEntry> ParseMeshCookMetadata(in Path root, in StringView virtualRoot, in Path file, in MetascriptDocument doc, in CpuTaskScheduler scheduler){
    const b8 parallelEnabled = scheduler.isParallelEnabled();
    const u32 workers = scheduler.workerThreadCount();
    return ParseCookMetadataDocument<MeshCookEntry>(root, virtualRoot, file, doc, s_MeshMetaText, lambda[in file, in parallelEnabled, in workers](in Name path, in MetascriptValue value) -> Expected<MeshCookEntry>{
        return ReadMeshSourceValue(path, file, value, parallelEnabled, workers);
    });
}

b8 BuildMeshSolidWords(in MeshCookEntry entry, mut Vector<u32> solidWords){
    const Expected<Vector<u32>> indices = BuildMeshletTriangleIndices(entry.meshlets, entry.meshletLocalVertexRefs, entry.meshletPositionRefDeltas, entry.meshletPrimitiveIndices, entry.positions.size());
    return indices.has_value() && BuildSolidTriangleWordsInto(entry.positions, indices.value(), solidWords);
}

[cpp_unwind]
Expected<Mesh> BuildMeshAsset(mut MeshCookEntry entry){
    if(!ReorderMeshStreamsByMeshletTraversal(
        entry.virtualPath, entry.meshlets, entry.positions, entry.normals, entry.tangents, entry.uv0, entry.colors,
        entry.meshletPositionStreamRefs, entry.meshletAttributeStreamRefs
    ))
        return MakeUnexpected(Failure());
    const Name path = entry.virtualPath;
    if(!EncodeMeshletRefDeltas(entry.meshletPositionStreamRefs, entry.meshletAttributeStreamRefs, false, lambda[in path](in usize index, in auto reason) -> b8{
        error("{} '{}': meshlet {} {}", s_MeshMetaText, path.resolvedText(), index, reason);
        return false;
    }, entry.meshlets, entry.meshletPositionRefDeltas, entry.meshletAttributeRefDeltas))
        return MakeUnexpected(Failure());
    Vector<u32> solidWords;
    if(!BuildMeshSolidWords(entry, solidWords))
        return MakeUnexpected(Failure());
    Mesh asset(path);
    asset.setPayload(entry.positions, entry.normals, entry.tangents, entry.uv0, entry.colors, entry.meshlets, entry.meshletBounds,
        entry.meshletPositionRefDeltas, entry.meshletAttributeRefDeltas, entry.meshletLocalVertexRefs, entry.meshletPrimitiveIndices, solidWords);
    if(!asset.validatePayload())
        return MakeUnexpected(Failure());
    return asset;
}


