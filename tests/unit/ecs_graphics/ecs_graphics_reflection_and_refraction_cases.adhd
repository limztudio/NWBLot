#define EXPECT_TRUE(...) native{ EXPECT_TRUE(...) }
#define EXPECT_FALSE(...) native{ EXPECT_FALSE(...) }
#define EXPECT_EQ(...) native{ EXPECT_EQ(...) }

b8 EcsGraphicsReflectionAndRefractionCasesReady(in u64 value){
    return value != 0u;
}

native{
#include <tests/unit/ecs_graphics/suite.adhd.h>


#include <tests/unit/ecs_graphics/name_cases.adhd.h>

