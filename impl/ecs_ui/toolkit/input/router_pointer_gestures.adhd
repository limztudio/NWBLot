void AppendRouterPointerGesture(
    in HitTarget target,
    in u64 layoutGeneration,
    in InputSource activePointerSource,
    in Point interactionPosition,
    mut Vector<PointerGestureRecord> pointerGestures,
    mut u64 outActiveGestureSequence,
    mut u64 inoutNextActionSequence,
    mut InputRoutingResult inoutResult
){
    outActiveGestureSequence = 0u;
    if(pointerGestures.size() == s_InputMaxPointerGestures || inoutNextActionSequence == 0u){
        inoutResult.gestureOverflow = true;
        return;
    }
    PointerGesture gesture;
    gesture.id.target = target.id;
    gesture.id.declarationGeneration = target.declarationGeneration;
    gesture.id.layoutGeneration = layoutGeneration;
    gesture.id.sequence = inoutNextActionSequence;
    gesture.inputSource = activePointerSource;
    gesture.origin = interactionPosition;
    gesture.position = interactionPosition;
    gesture.targetRectangle = target.rectangle;
    if(target.gestureReference.width > 0.0f)
        gesture.referenceRectangle = target.gestureReference;
    else
        gesture.referenceRectangle = target.rectangle;
    gesture.popup = target.popup;
    gesture.control = target.control;
    gesture.maximum = target.gestureMaximum;
    gesture.updateSequence = inoutNextActionSequence;
    gesture.value = target.value;
    pointerGestures.push_back(PointerGestureRecord(gesture, true));
    outActiveGestureSequence = inoutNextActionSequence;
    ++inoutNextActionSequence;
}

b8 TryUpdateRouterPointerGesture(
    in Point position,
    in b8 completed,
    mut Vector<PointerGestureRecord> pointerGestures,
    mut u64 inOutActiveGestureSequence,
    mut u64 inOutNextActionSequence
){
    if(inOutActiveGestureSequence == 0u)
        return true;
    for(usize index = 0u; index < pointerGestures.size(); ++index){
        PointerGestureRecord record = pointerGestures[index];
        if(record.gesture.id.sequence != inOutActiveGestureSequence)
            continue;
        if(completed || record.gesture.position.x != position.x || record.gesture.position.y != position.y){
            if(inOutNextActionSequence == 0u)
                return false;
            record.gesture.position = position;
            if(completed)
                record.gesture.state = PointerGestureState::Completed;
            else
                record.gesture.state = PointerGestureState::Active;
            record.gesture.updateSequence = inOutNextActionSequence;
            ++inOutNextActionSequence;
            record.pendingUpdate = true;
            pointerGestures[index] = record;
        }
        break;
    }
    if(completed)
        inOutActiveGestureSequence = 0u;
    return true;
}

void AppendRouterActivation(
    in HitTarget target,
    in u64 layoutGeneration,
    in InputActionSource origin,
    in InputSource inputSource,
    mut Vector<InputAction> actions,
    mut u64 inOutNextActionSequence,
    mut InputRoutingResult inOutResult
){
    if(actions.size() == s_InputMaxActions || inOutNextActionSequence == 0u){
        inOutResult.activationOverflow = true;
        return;
    }
    InputAction action;
    action.id.target = target.id;
    action.id.declarationGeneration = target.declarationGeneration;
    action.id.layoutGeneration = layoutGeneration;
    action.id.sequence = inOutNextActionSequence;
    action.origin = origin;
    action.popup = target.popup;
    action.control = target.control;
    action.inputSource = inputSource;
    actions.push_back(action);
    ++inOutNextActionSequence;
}

void AppendRouterContextMenu(
    in HitTarget target,
    in u64 layoutGeneration,
    in Point position,
    in InputActionSource origin,
    in InputSource inputSource,
    mut Vector<ContextMenuAction> contextMenuActions,
    mut u64 inOutNextActionSequence,
    mut InputRoutingResult inOutResult
){
    if(contextMenuActions.size() == s_InputMaxContextMenuActions || inOutNextActionSequence == 0u){
        inOutResult.activationOverflow = true;
        return;
    }
    ContextMenuAction action;
    action.id.target = target.id;
    action.id.declarationGeneration = target.declarationGeneration;
    action.id.layoutGeneration = layoutGeneration;
    action.id.sequence = inOutNextActionSequence;
    action.popup = target.popup;
    action.control = target.control;
    action.position = position;
    action.origin = origin;
    action.inputSource = inputSource;
    contextMenuActions.push_back(action);
    ++inOutNextActionSequence;
}

void AssignRouterFocus(
    in HitTarget target,
    mut Vector<CommandSource> commandSources,
    mut WidgetId inOutFocus,
    mut u64 inOutFocusDeclaration,
    mut ControlToken inOutFocusControl
){
    if(inOutFocus != target.id || inOutFocusDeclaration != target.declarationGeneration || inOutFocusControl != target.control)
        RetireRouterCommandFocus(commandSources);
    inOutFocus = target.id;
    inOutFocusDeclaration = target.declarationGeneration;
    inOutFocusControl = target.control;
}

b8 IsCurrentRouterContextMenuOwner(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in b8 windowFocused,
    in TargetOwner owner
){
    if(!windowFocused || owner.declarationGeneration == 0u)
        return false;
    const Expected<usize> targetIndex = FindTargetIndexInTable(targets, lookup, owner.target, owner.declarationGeneration);
    if(!targetIndex.has_value())
        return false;
    const HitTarget target = targets[targetIndex.value()];
    return
        target.contextMenu
        && IsRouterTargetInteractive(targets, lookup, popups, target)
        && target.popup == owner.popup
        && target.control == owner.control
    ;
}

b8 AcceptsRouterPointerSource(
    in InputSource activePointerSource,
    in Span<PointerSource> pointerSources,
    in InputSource source
){
    if(!source.valid() || (activePointerSource.valid() && activePointerSource != source))
        return false;
    for(in PointerSource held : pointerSources){
        if(held.source == source && held.inert)
            return false;
    }
    return true;
}

b8 WantsRouterPointer(in Span<PointerSource> pointerSources, in b8 hasPopup, in WidgetId hover){
    if(!pointerSources.empty()){
        for(in PointerSource held : pointerSources){
            if(held.consumed)
                return true;
        }
        return false;
    }
    return hasPopup || hover.valid();
}

Expected<InputEvent> TryResolveRouterPointerEvent(
    in InputEvent event,
    mut Vector<PointerBinding> pointerBindings
){
    if(!IsPointerInputEventType(event.type))
        return event;
    if(!event.source.valid() || !isFinite(event.position.x) || !isFinite(event.position.y))
        return makeUnexpected(Failure());
    if(event.type == InputEventType::PointerWheel && (!isFinite(event.scrollX) || !isFinite(event.scrollY)))
        return makeUnexpected(Failure());
    InputEvent resolved = event;
    const b8 press = event.type == InputEventType::PrimaryDown || event.type == InputEventType::SecondaryDown;
    const b8 release = event.type == InputEventType::PrimaryUp || event.type == InputEventType::SecondaryUp;
    PointerIntent intent = PointerIntent::Activate;
    if(event.type == InputEventType::SecondaryDown || event.type == InputEventType::SecondaryUp)
        intent = PointerIntent::ContextMenu;
    usize heldIndex = pointerBindings.size();
    usize contactIndex = pointerBindings.size();
    for(usize index = 0u; index < pointerBindings.size(); ++index){
        if(pointerBindings[index].source == event.source){
            if(contactIndex == pointerBindings.size())
                contactIndex = index;
            if(pointerBindings[index].intent == intent && heldIndex == pointerBindings.size())
                heldIndex = index;
        }
    }
    if(contactIndex != pointerBindings.size())
        resolved.hoverCapable = pointerBindings[contactIndex].hoverCapable;
    if(press){
        if(heldIndex == pointerBindings.size()){
            if(pointerBindings.size() == s_InputMaxSources)
                return makeUnexpected(Failure());
            pointerBindings.push_back(PointerBinding(event.source, intent, resolved.hoverCapable));
        }
        else
            resolved.repeat = true;
    }
    else if(release && heldIndex != pointerBindings.size()){
        for(usize moveIndex = heldIndex + 1u; moveIndex < pointerBindings.size(); ++moveIndex)
            pointerBindings[moveIndex - 1u] = pointerBindings[moveIndex];
        pointerBindings.pop_back();
    }
    else if(event.type == InputEventType::PointerCaptureLost){
        usize keptBindings = 0u;
        for(usize index = 0u; index < pointerBindings.size(); ++index){
            if(pointerBindings[index].source != event.source){
                if(keptBindings != index)
                    pointerBindings[keptBindings] = pointerBindings[index];
                ++keptBindings;
            }
        }
        pointerBindings.resize(keptBindings);
    }
    return resolved;
}

void CancelRouterPointerPress(
    mut Vector<PointerGestureRecord> pointerGestures,
    mut u64 inOutActiveGestureSequence,
    mut b8 outPointerSubmitArmed,
    mut TargetOwner outSecondaryOwner,
    mut WidgetId outCapture,
    mut PopupToken outCapturePopup,
    mut u64 outCaptureDeclaration,
    mut ControlToken outCaptureControl
){
    outPointerSubmitArmed = false;
    outSecondaryOwner = TargetOwner();
    for(usize index = 0u; index < pointerGestures.size(); ++index){
        if(pointerGestures[index].gesture.id.sequence == inOutActiveGestureSequence){
            for(usize moveIndex = index + 1u; moveIndex < pointerGestures.size(); ++moveIndex)
                pointerGestures[moveIndex - 1u] = pointerGestures[moveIndex];
            pointerGestures.pop_back();
            break;
        }
    }
    inOutActiveGestureSequence = 0u;
    outCapture = WidgetId();
    outCapturePopup = PopupToken();
    outCaptureDeclaration = 0u;
    outCaptureControl = ControlToken();
}

Expected<usize> FindRouterHitTargetIndex(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in Point position
){
    if(!isFinite(position.x) || !isFinite(position.y))
        return makeUnexpected(Failure());
    b8 hasFound = false;
    usize foundIndex = 0u;
    HitTarget foundTarget;
    for(usize index = 0u; index < targets.size(); ++index){
        const HitTarget target = targets[index];
        if(!UiRectContainsPoint(target.rectangle, position) || !UiRectContainsPoint(target.clip, position) || !IsRouterTargetInteractive(targets, lookup, popups, target))
            continue;
        if(!hasFound || target.layer > foundTarget.layer || (target.layer == foundTarget.layer && target.paintOrder >= foundTarget.paintOrder)){
            hasFound = true;
            foundIndex = index;
            foundTarget = target;
        }
    }
    if(!hasFound)
        return makeUnexpected(Failure());
    return foundIndex;
}

b8 TryConsumeRouterActivation(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in WidgetId id,
    mut Vector<InputAction> actions
){
    const Expected<usize> targetIndex = FindTargetIndexInTable(targets, lookup, id, 0u);
    if(!targetIndex.has_value())
        return false;
    const HitTarget target = targets[targetIndex.value()];
    if(!IsRouterTargetInteractive(targets, lookup, popups, target) || !target.activatable)
        return false;
    for(usize index = 0u; index < actions.size(); ++index){
        const InputAction candidate = actions[index];
        if(candidate.id.target == id && candidate.id.declarationGeneration == target.declarationGeneration && candidate.popup == target.popup && candidate.control == target.control){
            for(usize moveIndex = index + 1u; moveIndex < actions.size(); ++moveIndex)
                actions[moveIndex - 1u] = actions[moveIndex];
            actions.pop_back();
            return true;
        }
    }
    return false;
}

Expected<ContextMenuAction> TryConsumeRouterContextMenu(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in b8 windowFocused,
    in WidgetId id,
    in u64 declarationGeneration,
    mut Vector<ContextMenuAction> contextMenuActions
){
    const Expected<usize> targetIndex = FindTargetIndexInTable(targets, lookup, id, declarationGeneration);
    if(declarationGeneration == 0u || !windowFocused || !targetIndex.has_value())
        return makeUnexpected(Failure());
    const HitTarget target = targets[targetIndex.value()];
    if(!target.contextMenu || !IsRouterTargetInteractive(targets, lookup, popups, target))
        return makeUnexpected(Failure());
    for(usize index = 0u; index < contextMenuActions.size(); ++index){
        const ContextMenuAction candidate = contextMenuActions[index];
        if(candidate.id.target != id || candidate.id.declarationGeneration != declarationGeneration || candidate.popup != target.popup || candidate.control != target.control)
            continue;
        for(usize moveIndex = index + 1u; moveIndex < contextMenuActions.size(); ++moveIndex)
            contextMenuActions[moveIndex - 1u] = contextMenuActions[moveIndex];
        contextMenuActions.pop_back();
        return candidate;
    }
    return makeUnexpected(Failure());
}

Expected<PointerGesture> TryConsumeRouterPointerGesture(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in WidgetId id,
    in u64 declarationGeneration,
    mut Vector<PointerGestureRecord> pointerGestures
){
    const Expected<usize> targetIndex = FindTargetIndexInTable(targets, lookup, id, declarationGeneration);
    if(declarationGeneration == 0u || !targetIndex.has_value())
        return makeUnexpected(Failure());
    const HitTarget target = targets[targetIndex.value()];
    if(!IsRouterTargetInteractive(targets, lookup, popups, target) || !target.pointerGesture)
        return makeUnexpected(Failure());
    for(usize index = 0u; index < pointerGestures.size(); ++index){
        PointerGestureRecord record = pointerGestures[index];
        if(record.gesture.id.target != id || record.gesture.id.declarationGeneration != declarationGeneration || !record.pendingUpdate || record.gesture.popup != target.popup || record.gesture.control != target.control)
            continue;
        const PointerGesture gesture = record.gesture;
        if(record.gesture.state == PointerGestureState::Completed){
            for(usize moveIndex = index + 1u; moveIndex < pointerGestures.size(); ++moveIndex)
                pointerGestures[moveIndex - 1u] = pointerGestures[moveIndex];
            pointerGestures.pop_back();
        }
        else{
            record.pendingUpdate = false;
            pointerGestures[index] = record;
        }
        return gesture;
    }
    return makeUnexpected(Failure());
}

void ReconcileRouterPointerGestures(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    mut Vector<PointerGestureRecord> pointerGestures,
    mut u64 inOutActiveGestureSequence
){
    usize keptGestures = 0u;
    for(usize index = 0u; index < pointerGestures.size(); ++index){
        const PointerGesture gesture = pointerGestures[index].gesture;
        const Expected<usize> targetIndex = FindTargetIndexInTable(targets, lookup, gesture.id.target, gesture.id.declarationGeneration);
        b8 valid = false;
        if(targetIndex.has_value()){
            const HitTarget target = targets[targetIndex.value()];
            valid = IsRouterTargetInteractive(targets, lookup, popups, target)
                && target.pointerGesture
                && gesture.popup == target.popup
                && gesture.control == target.control;
        }
        if(!valid){
            if(gesture.id.sequence == inOutActiveGestureSequence)
                inOutActiveGestureSequence = 0u;
        }
        else{
            if(keptGestures != index)
                pointerGestures[keptGestures] = pointerGestures[index];
            ++keptGestures;
        }
    }
    pointerGestures.resize(keptGestures);
}

void ReconcileRouterContextMenus(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in b8 windowFocused,
    mut Vector<ContextMenuAction> contextMenuActions,
    mut TargetOwner inOutSecondaryOwner,
    mut Vector<CommandSource> commandSources
){
    usize keptMenus = 0u;
    for(usize index = 0u; index < contextMenuActions.size(); ++index){
        const ContextMenuAction action = contextMenuActions[index];
        const TargetOwner owner(action.id.target, action.id.declarationGeneration, action.popup, action.control);
        if(IsCurrentRouterContextMenuOwner(targets, lookup, popups, windowFocused, owner)){
            if(keptMenus != index)
                contextMenuActions[keptMenus] = action;
            ++keptMenus;
        }
    }
    contextMenuActions.resize(keptMenus);
    if(!IsCurrentRouterContextMenuOwner(targets, lookup, popups, windowFocused, inOutSecondaryOwner))
        inOutSecondaryOwner = TargetOwner();
    for(usize index = 0u; index < commandSources.size(); ++index){
        CommandSource source = commandSources[index];
        if(source.contextArmed && !IsCurrentRouterContextMenuOwner(targets, lookup, popups, windowFocused, source.focusOwner)){
            source.contextArmed = false;
            commandSources[index] = source;
        }
    }
}


