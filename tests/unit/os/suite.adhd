void VerifyTextInput_QueuedPayloadKeepsItsDestinationArenaWhenMoved(){
    HeapStorage destination = HeapStorage(Name("tests/os/queued_text"));
    TestValueSlot<TextInputEvent> queuedSlot;
    mut TextInputEvent queued = queuedSlot.constructIn(destination);
    {
        ScratchStorage transient = ScratchStorage(Name("tests/os/incoming_text"));
        TestValueSlot<TextInputEvent> incomingSlot;
        mut TextInputEvent incoming = incomingSlot.constructIn(transient);
        incoming.text.assign(1024u, 'a');
        incoming.sequence = 9u;
        incoming.kind = TextInputEventKind::Preedit;
        incoming.caretVisible = false;
        TestMoveAssign<TextInputEvent>(queued, incoming);
        EXPECT_TRUE(TestUsesStorage(queued.text, destination));
    }
    const usize payload = TestDataAddress(queued.text);
    TestValueSlot<TextInputEvent> deliveredSlot;
    mut TextInputEvent delivered = deliveredSlot.takeIn(destination, queued);
    EXPECT_EQ(TestDataAddress(delivered.text), payload);
    EXPECT_EQ(delivered.text.size(), 1024u);
    EXPECT_EQ(delivered.text.back(), 'a');
    EXPECT_EQ(delivered.sequence, 9u);
    EXPECT_EQ(delivered.kind, TextInputEventKind::Preedit);
    EXPECT_FALSE(delivered.caretVisible);
}

NWB_ADHD_GTEST(TextInput, QueuedPayloadKeepsItsDestinationArenaWhenMoved, VerifyTextInput_QueuedPayloadKeepsItsDestinationArenaWhenMoved)


