void VerifyModalDialog_CenterBackdropCloseEscOutsideAndInvalid(mut ChromeModalDialogTests self){
    DialogOptions opts;
    opts.size = Point(320.0f, 180.0f);
    opts.closable = true;
    opts.dismissOutside = false;
    opts.dismissCancel = true;

    self.m_dialog.open();
    ASSERT_TRUE(self.renderFrame(1u, opts));
    EXPECT_TRUE(self.m_dialog.isOpen());
    EXPECT_FALSE(self.m_dialog.wasClosedByUser());
    EXPECT_NEAR(self.m_dialog.placement().bounds.x, 240.0f, 1.0f);
    EXPECT_NEAR(self.m_dialog.placement().bounds.y, 210.0f, 1.0f);

    const Point behindPt = self.bgButtonCenter();
    InputEvent behindClick;
    behindClick.position = behindPt;
    behindClick.type = InputEventType::PrimaryDown;
    self.send(behindClick);
    behindClick.type = InputEventType::PrimaryUp;
    self.send(behindClick);
    ASSERT_TRUE(self.renderFrame(2u, opts));
    EXPECT_EQ(self.m_bgClicks, 0u);
    EXPECT_TRUE(self.m_dialog.isOpen());

    self.click(self.closeButtonCenter());
    ASSERT_TRUE(self.renderFrame(3u, opts));
    EXPECT_FALSE(self.m_dialog.isOpen());
    EXPECT_TRUE(self.m_dialog.wasClosedByUser());

    ASSERT_TRUE(self.renderFrame(4u, opts));
    EXPECT_FALSE(self.m_dialog.wasClosedByUser());

    self.m_dialog.open();
    ASSERT_TRUE(self.renderFrame(5u, opts));
    self.press(Key::Escape);
    ASSERT_TRUE(self.renderFrame(6u, opts));
    EXPECT_FALSE(self.m_dialog.isOpen());
    EXPECT_TRUE(self.m_dialog.wasClosedByUser());

    DialogOptions lockedOpts = opts;
    lockedOpts.dismissCancel = false;
    lockedOpts.dismissOutside = true;
    self.m_dialog.open();
    ASSERT_TRUE(self.renderFrame(7u, lockedOpts));
    InputEvent escEvt;
    escEvt.type = InputEventType::KeyDown;
    escEvt.key = Key::Escape;
    self.send(escEvt);
    escEvt.type = InputEventType::KeyUp;
    self.send(escEvt);
    ASSERT_TRUE(self.renderFrame(8u, lockedOpts));
    EXPECT_TRUE(self.m_dialog.isOpen());

    InputEvent outsideClick;
    outsideClick.position = Point(5.0f, 5.0f);
    outsideClick.type = InputEventType::PrimaryDown;
    self.send(outsideClick);
    outsideClick.type = InputEventType::PrimaryUp;
    self.send(outsideClick);
    ASSERT_TRUE(self.renderFrame(9u, lockedOpts));
    EXPECT_FALSE(self.m_dialog.isOpen());
    EXPECT_TRUE(self.m_dialog.wasClosedByUser());

    DialogOptions invalidOpts;
    invalidOpts.size = Point(0.0f, 100.0f);
    EXPECT_FALSE(IsValidDialogOptions(invalidOpts));
}

void VerifyMenuBar_DropdownHoverSwitchActivateKeyboardAndValidation(mut ChromeMenuBarTests self){
    Vector<MenuBarMenu> menus;
    self.buildDefaultMenus(menus);
    MenuBarOptions opts;

    Vector<MenuBarMenu> invalidMenus = menus;
    invalidMenus[1u].key = 1u;
    EXPECT_FALSE(IsValidMenuBarMenus(Span<MenuBarMenu>(invalidMenus)));
    invalidMenus[1u].key = 0u;
    EXPECT_FALSE(IsValidMenuBarMenus(Span<MenuBarMenu>(invalidMenus)));

    ASSERT_TRUE(self.renderBar(1u, Span<MenuBarMenu>(menus), opts));
    EXPECT_TRUE(self.m_result.valid);
    EXPECT_EQ(self.m_result.openMenuKey, 0u);

    const Point fileCenter = self.menuItemCenter(1u);
    const Point editCenter = self.menuItemCenter(2u);
    const Point helpCenter = self.menuItemCenter(3u);
    const auto offRoot = TryMakeWidgetId(self.menuBarId(), s_WidgetPartMenuItem).value();
    EXPECT_FALSE(self.hasTarget(TryMakeWidgetPartId(offRoot, 4u).value()));

    self.click(fileCenter);
    ASSERT_TRUE(self.renderBar(2u, Span<MenuBarMenu>(menus), opts));
    EXPECT_TRUE(self.m_state.isOpen());
    EXPECT_EQ(self.m_result.openMenuKey, 1u);
    EXPECT_GE(self.m_state.m_popup.placement().bounds.y, fileCenter.y);

    InputEvent moveToEdit;
    moveToEdit.type = InputEventType::PointerMove;
    moveToEdit.position = editCenter;
    self.send(moveToEdit);
    ASSERT_TRUE(self.renderBar(3u, Span<MenuBarMenu>(menus), opts));
    EXPECT_TRUE(self.m_state.isOpen());
    EXPECT_EQ(self.m_result.openMenuKey, 2u);

    self.click(self.dropdownRowCenter(201u));
    ASSERT_TRUE(self.renderBar(4u, Span<MenuBarMenu>(menus), opts));
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_TRUE(self.m_result.activated);
    EXPECT_EQ(self.m_result.menuKey, 2u);
    EXPECT_EQ(self.m_result.itemKey, 201u);

    self.click(helpCenter);
    ASSERT_TRUE(self.renderBar(5u, Span<MenuBarMenu>(menus), opts));
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_TRUE(self.m_result.activated);
    EXPECT_EQ(self.m_result.menuKey, 3u);
    EXPECT_EQ(self.m_result.itemKey, 0u);

    self.press(Key::Left);
    ASSERT_TRUE(self.renderBar(6u, Span<MenuBarMenu>(menus), opts));
    self.press(Key::Down);
    ASSERT_TRUE(self.renderBar(7u, Span<MenuBarMenu>(menus), opts));
    EXPECT_TRUE(self.m_state.isOpen());
    EXPECT_EQ(self.m_result.openMenuKey, 2u);

    self.press(Key::Escape);
    ASSERT_TRUE(self.renderBar(8u, Span<MenuBarMenu>(menus), opts));
    EXPECT_FALSE(self.m_state.isOpen());
}

void VerifyToolbarAndStatusBar_AutoSeparatorToggleStateAndFixedHeight(mut ChromeToolbarStatusTests self){
    ASSERT_TRUE(self.renderFrame(1u));
    EXPECT_FALSE(self.m_bold);

    const WidgetId rowTbId = self.id("row_tb", "panel");
    const WidgetId colTbId = self.id("col_tb", "panel");
    const auto saveTgt = self.tryTarget(RequireUiWidgetId(rowTbId, "save"));
    const auto boldTgt = self.tryTarget(RequireUiWidgetId(rowTbId, "bold"));
    const auto v1Tgt = self.tryTarget(RequireUiWidgetId(colTbId, "vbtn"));
    const auto v2Tgt = self.tryTarget(RequireUiWidgetId(colTbId, "vbtn2"));
    ASSERT_TRUE(saveTgt.has_value());
    ASSERT_TRUE(boldTgt.has_value());
    ASSERT_TRUE(v1Tgt.has_value());
    ASSERT_TRUE(v2Tgt.has_value());
    EXPECT_GT(boldTgt.value().rectangle.x - (saveTgt.value().rectangle.x + saveTgt.value().rectangle.width), 8.0f);
    EXPECT_GT(v2Tgt.value().rectangle.y - (v1Tgt.value().rectangle.y + v1Tgt.value().rectangle.height), 8.0f);

    Vector<Vertex> glyphs;
    CopyGlyphVertices(self.m_paint.freeze(), glyphs);
    EXPECT_FALSE(glyphs.empty());

    const Point savePt = self.widgetCenter("save", "row_tb");
    const Point boldPt = self.widgetCenter("bold", "row_tb");
    self.click(savePt);
    ASSERT_TRUE(self.renderFrame(2u));
    EXPECT_EQ(self.m_saveClicks, 1u);

    self.click(boldPt);
    ASSERT_TRUE(self.renderFrame(3u));
    EXPECT_TRUE(self.m_bold);

    self.click(boldPt);
    ASSERT_TRUE(self.renderFrame(4u));
    EXPECT_FALSE(self.m_bold);
}

void VerifyToastStack_MaxVisiblePauseOnHoverManualDismissAndPersistent(mut ChromeToastTests self){
    ToastOptions opts;
    opts.corner = ToastCorner::BottomRight;
    opts.maxVisible = 2u;
    opts.pauseOnHover = true;

    const u64 id1 = self.m_state.push("Build", "Started", ToastSeverity::Info, 2.0f);
    const u64 id2 = self.m_state.push("Test", "Running", ToastSeverity::Success, 2.0f);
    const u64 id3 = self.m_state.push("Warn", "Cache cold", ToastSeverity::Warning, 3.0f);
    const u64 id4 = self.m_state.push("Keep", "Pinned", ToastSeverity::Error, 0.0f);
    EXPECT_NE(id1, 0u);
    EXPECT_NE(id4, 0u);

    ASSERT_TRUE(self.renderToasts(1u, 0.0f, opts));
    EXPECT_TRUE(self.m_result.valid);
    EXPECT_EQ(self.m_result.activeCount, 4u);
    ASSERT_EQ(self.m_state.m_visibleIds.size(), 2u);
    EXPECT_EQ(self.m_state.m_visibleIds[0u], id1);
    EXPECT_EQ(self.m_state.m_visibleIds[1u], id2);
    EXPECT_GT(self.m_state.m_visibleRects[0u].x, 400.0f);
    EXPECT_GT(self.m_state.m_visibleRects[0u].y, 300.0f);

    InputEvent hoverId1;
    hoverId1.type = InputEventType::PointerMove;
    hoverId1.position = CenterUiRect(self.m_state.m_visibleRects[0u]);
    self.send(hoverId1);
    ASSERT_TRUE(self.renderToasts(2u, 2.5f, opts));
    EXPECT_EQ(self.m_result.dismissedCount, 1u);
    EXPECT_EQ(self.m_result.lastDismissedId, id2);
    EXPECT_EQ(self.m_result.activeCount, 3u);
    ASSERT_EQ(self.m_state.m_visibleIds.size(), 2u);
    EXPECT_EQ(self.m_state.m_visibleIds[0u], id1);
    EXPECT_EQ(self.m_state.m_visibleIds[1u], id3);

    self.click(self.closeCenter(id1));
    ASSERT_TRUE(self.renderToasts(3u, 0.0f, opts));
    EXPECT_EQ(self.m_result.dismissedCount, 1u);
    EXPECT_EQ(self.m_result.lastDismissedId, id1);
    EXPECT_EQ(self.m_result.activeCount, 2u);

    InputEvent moveAway;
    moveAway.type = InputEventType::PointerMove;
    moveAway.position = Point(5.0f, 5.0f);
    self.send(moveAway);
    ASSERT_TRUE(self.renderToasts(4u, 5.0f, opts));
    EXPECT_EQ(self.m_result.dismissedCount, 1u);
    EXPECT_EQ(self.m_result.lastDismissedId, id3);
    EXPECT_EQ(self.m_result.activeCount, 1u);
    ASSERT_EQ(self.m_state.m_visibleIds.size(), 1u);
    EXPECT_EQ(self.m_state.m_visibleIds[0u], id4);
}

void VerifyColorPicker_ConversionsHexDragAndKeyboard(mut ChromeColorPickerTests self){
    Array<ColorHsv, 6u> sectorHsvs;
    for(usize si = 0u; si < 6u; ++si){
        sectorHsvs[si].h = cast<f32>(si) * 60.0f + 15.0f;
        sectorHsvs[si].s = 0.75f;
        sectorHsvs[si].v = 0.85f;
        sectorHsvs[si].a = 0.6f;
        const Color rgb = HsvToRgb(sectorHsvs[si]);
        const ColorHsv back = RgbToHsv(rgb);
        EXPECT_NEAR(back.h, sectorHsvs[si].h, 0.5f);
        EXPECT_NEAR(back.s, sectorHsvs[si].s, 0.01f);
        EXPECT_NEAR(back.v, sectorHsvs[si].v, 0.01f);
        EXPECT_NEAR(back.a, sectorHsvs[si].a, 0.01f);
    }

    String hexOut;
    EXPECT_TRUE(FormatColorHex(Color(1.0f, 0.5f, 0.0f, 1.0f), false, hexOut));
    EXPECT_EQ(StringView(hexOut), "#FF8000");
    EXPECT_TRUE(FormatColorHex(Color(1.0f, 0.0f, 0.0f, 0.5f), true, hexOut));
    EXPECT_EQ(StringView(hexOut), "#FF000080");

    const auto parsedShort = TryParseColorHex("#3af");
    ASSERT_TRUE(parsedShort.has_value());
    EXPECT_NEAR(parsedShort.value().r, 0.2f, 0.01f);
    EXPECT_NEAR(parsedShort.value().g, 0.666f, 0.01f);
    EXPECT_NEAR(parsedShort.value().b, 1.0f, 0.01f);

    const auto parsedFull = TryParseColorHex("#11223344");
    ASSERT_TRUE(parsedFull.has_value());
    EXPECT_NEAR(parsedFull.value().a, 68.0f / 255.0f, 0.01f);
    EXPECT_FALSE(TryParseColorHex("#ZZZ").has_value());
    EXPECT_FALSE(TryParseColorHex("12345").has_value());

    ColorPickerOptions opts;
    opts.showAlpha = true;
    ASSERT_TRUE(self.renderPicker(1u, opts));
    EXPECT_TRUE(self.m_result.valid);

    const Point svMid = self.partPoint(s_WidgetPartColorSv, 0.5f, 0.5f);
    const Point svOverBottom = Point(svMid.x + 500.0f, svMid.y + 500.0f);
    self.drag(svMid, svOverBottom);
    ASSERT_TRUE(self.renderPicker(2u, opts));
    EXPECT_TRUE(self.m_result.changed);
    EXPECT_NEAR(self.m_state.hsv().s, 1.0f, 0.01f);
    EXPECT_NEAR(self.m_state.hsv().v, 0.0f, 0.01f);

    const Point svOverTop = Point(svMid.x + 500.0f, svMid.y - 500.0f);
    self.drag(svMid, svOverTop);
    ASSERT_TRUE(self.renderPicker(3u, opts));
    EXPECT_TRUE(self.m_result.changed);
    EXPECT_NEAR(self.m_state.hsv().s, 1.0f, 0.01f);
    EXPECT_NEAR(self.m_state.hsv().v, 1.0f, 0.01f);

    const Point hueStart = self.partPoint(s_WidgetPartColorHue, 0.1f, 0.5f);
    const Point hueThird = self.partPoint(s_WidgetPartColorHue, 1.0f / 3.0f, 0.5f);
    self.drag(hueStart, hueThird);
    ASSERT_TRUE(self.renderPicker(4u, opts));
    EXPECT_NEAR(self.m_state.hsv().h, 120.0f, 3.0f);
    EXPECT_NEAR(self.m_state.color().g, 1.0f, 0.05f);

    const Point alphaStart = self.partPoint(s_WidgetPartColorAlpha, 0.8f, 0.5f);
    const Point alphaHalf = self.partPoint(s_WidgetPartColorAlpha, 0.5f, 0.5f);
    self.drag(alphaStart, alphaHalf);
    ASSERT_TRUE(self.renderPicker(5u, opts));
    EXPECT_NEAR(self.m_state.hsv().a, 0.5f, 0.03f);

    const f32 prevH = self.m_state.hsv().h;
    self.click(self.partPoint(s_WidgetPartColorSv, 0.8f, 0.2f));
    ASSERT_TRUE(self.renderPicker(6u, opts));
    self.press(Key::Right, false, true);
    ASSERT_TRUE(self.renderPicker(7u, opts));
    EXPECT_NEAR(self.m_state.hsv().h, WrapHueDegrees(prevH + 15.0f), 0.5f);

    self.press(Key::Down);
    ASSERT_TRUE(self.renderPicker(8u, opts));
    EXPECT_LT(self.m_state.hsv().v, 0.9f);

    ColorPickerOptions noAlphaOpts = opts;
    noAlphaOpts.showAlpha = false;
    ASSERT_TRUE(self.renderPicker(9u, noAlphaOpts));
    EXPECT_FALSE(self.hasTarget(TryMakeWidgetId(self.pickerId(), s_WidgetPartColorAlpha).value()));

    ColorPickerOptions disabledOpts = opts;
    disabledOpts.enabled = false;
    const Color frozenColor = self.m_state.color();
    ASSERT_TRUE(self.renderPicker(10u, disabledOpts));
    EXPECT_NEAR(self.m_state.color().r, frozenColor.r, 0.001f);
}


