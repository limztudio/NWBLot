[cpp_header("<core/metascript/lexer.h>"), cpp_name("::NWB::Core::Metascript::TokenType::Enum")]
extern enum MetascriptTokenType : u8{
    Identifier,
    IntegerLiteral,
    DoubleLiteral,
    FloatLiteral,
    StringLiteral,
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    PlusEqual,
    MinusEqual,
    StarEqual,
    SlashEqual,
    PercentEqual,
    PlusPlus,
    MinusMinus,
    Arrow,
    Equal,
    EqualEqual,
    BangEqual,
    Less,
    LessEqual,
    Greater,
    GreaterEqual,
    Ampersand,
    AmpersandEqual,
    AmpersandAmpersand,
    Pipe,
    PipeEqual,
    PipePipe,
    Caret,
    CaretEqual,
    Tilde,
    Bang,
    Question,
    LessLess,
    LessLessEqual,
    GreaterGreater,
    GreaterGreaterEqual,
    Semicolon,
    Dot,
    Comma,
    Colon,
    ColonColon,
    Hash,
    LeftBracket,
    RightBracket,
    LeftBrace,
    RightBrace,
    LeftParen,
    RightParen,
    EndOfFile,
    Error
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<core/metascript/lexer.h>"), cpp_name("::NWB::Core::Metascript::Lexer")]
extern class MetascriptLexer{
    MetascriptToken next(...);
};

[cpp_header("<core/metascript/lexer.h>"), cpp_name("::NWB::Core::Metascript::Token")]
extern class MetascriptToken{
    StringView text;
    MetascriptTokenType type;
    u32 line;
    u32 column;
};


