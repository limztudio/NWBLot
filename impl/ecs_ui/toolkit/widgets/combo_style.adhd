#include "list_style.adhd"
#include <impl/ecs_ui/toolkit/id.adhd>
#include <impl/ecs_ui/toolkit/edit/text_normalization.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_ComboArrowExtent = 20.0f;
const f32 s_SearchComboQueryHeight = 36.0f;

class ComboStyle{
    public Name normal = Name("combo.normal");
    public Name hover = Name("combo.hover");
    public Name open = Name("combo.open");
    public Name focused = Name("combo.focused");
    public Name disabled = Name("combo.disabled");
    public Name fallback = Name("button.normal");
    public Name arrow = Name("combo.arrow");
    public Name arrowFallback = Name("window.collapse");
    public Insets padding = Insets(s_StyleSpacingMedium, s_StyleFieldPaddingY, s_StyleSpacingMedium, s_StyleFieldPaddingY);
    public f32 arrowExtent = s_ComboArrowExtent;
    public f32 arrowGap = s_StyleSpacingMedium;
}

class ComboOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public LayoutSize height;
    public f32 popupHeight = s_ListDefaultHeight;
    public f32 wheelRows = s_StyleScrollWheelStep;
    public b8 enabled = true;
    public StringView placeholder = "Select...";
}

class ComboResult{
    public b8 valid = false;
    public b8 selectionChanged = false;
    public b8 committed = false;
    public b8 opened = false;
    public b8 closed = false;
    public b8 focused = false;
}

class SearchComboOptions{
    public ComboOptions combo;
    public f32 queryHeight = s_SearchComboQueryHeight;
    public f32 queryGap = s_StyleSpacingSmall;
}

class SearchComboResult{
    public ComboResult combo;
    public b8 queryChanged = false;
}

class SearchComboSourceSnapshot{
    public SearchComboSourceSnapshot(){
        this.generation = 0u;
        this.revision = 0u;
        this.count = 0u;
    }

    public SearchComboSourceSnapshot(in u64 inGeneration, in u64 inRevision, in u64 inCount){
        this.generation = inGeneration;
        this.revision = inRevision;
        this.count = inCount;
    }

    public u64 generation;
    public u64 revision;
    public u64 count;
}

Expected<b8> TryBindComboOwner(in WidgetId owner, in u64 declarationGeneration, mut WidgetId inOutOwner, mut u64 inOutOwnerDeclaration){
    if(!owner.valid() || declarationGeneration == 0u)
        return makeUnexpected(Failure());
    const b8 shouldClose = inOutOwner.valid() && (inOutOwner != owner || inOutOwnerDeclaration != declarationGeneration);
    inOutOwner = owner;
    inOutOwnerDeclaration = declarationGeneration;
    return shouldClose;
}

b8 EvaluateSearchComboRebuildNeed(
    in b8 filterValid,
    in u64 stateSourceGeneration,
    in u64 stateSourceRevision,
    in u64 stateSourceCount,
    in SearchComboSourceSnapshot full,
    in u64 stateViewGeneration,
    in u64 stateViewRevision,
    in u64 stateViewCount,
    in SearchComboSourceSnapshot previous,
    in StringView cachedQuery,
    in StringView currentQuery
){
    const b8 fullChanged = !filterValid || stateSourceGeneration != full.generation || stateSourceRevision != full.revision || stateSourceCount != full.count;
    const b8 viewChanged = !filterValid || stateViewGeneration != previous.generation || stateViewRevision != previous.revision || stateViewCount != previous.count;
    const b8 queryChanged = !filterValid || cachedQuery != currentQuery;
    return fullChanged || viewChanged || queryChanged;
}

b8 ValidateSearchComboFilteredSnapshot(in SearchComboSourceSnapshot full, in SearchComboSourceSnapshot filtered){
    return filtered.generation != 0u && filtered.revision != 0u && filtered.count <= full.count;
}

b8 ShouldResetSearchComboPreviewOnFilter(
    in b8 rebuild,
    in b8 filterValid,
    in u64 stateQueryGeneration,
    in u64 stateQueryExternalRevision,
    in TextAreaModelStamp query
){
    const b8 externalQueryChange = filterValid && (stateQueryGeneration != query.instanceGeneration || stateQueryExternalRevision != query.externalRevision);
    return rebuild || externalQueryChange;
}

Name ResolveComboFieldRegionName(in ComboStyle style, in b8 enabled, in b8 open, in b8 focused, in b8 hovered){
    if(!enabled)
        return style.disabled;
    if(open)
        return style.open;
    if(focused)
        return style.focused;
    if(hovered)
        return style.hover;
    return style.normal;
}

void ResolveComboFieldLayout(in Rect bounds, in Insets padding, in f32 arrowExtent, in f32 arrowGap, mut Rect outIcon, mut Rect outTextClip){
    const Rect content = InsetUiRectBounds(bounds, padding);
    const f32 extent = min(arrowExtent, min(content.width, content.height));
    const f32 iconOffsetY = max(0.0f, (content.height - extent) * s_RectCenterFraction);
    outIcon = Rect(((bounds.x + bounds.width) - padding.right) - extent, (bounds.y + padding.top) + iconOffsetY, extent, extent);
    const f32 textX = bounds.x + padding.left;
    const f32 textY = bounds.y + padding.top;
    const f32 textWidth = max(0.0f, (outIcon.x - arrowGap) - textX);
    outTextClip = Rect(textX, textY, textWidth, content.height);
}

b8 IsValidComboDeclarationOptions(in ComboOptions options, in ComboStyle style){
    return
        isFinite(options.popupHeight) && options.popupHeight > 0.0f
        && isFinite(options.wheelRows) && options.wheelRows > 0.0f
        && isFinite(style.arrowExtent) && style.arrowExtent > 0.0f
        && isFinite(style.arrowGap) && style.arrowGap >= 0.0f
    ;
}

Point ComputeComboFieldIntrinsicSize(in Point minimumSize, in Point measured, in f32 arrowExtent, in f32 arrowGap, in Insets padding){
    const f32 paddedWidth = ((measured.x + arrowExtent) + arrowGap) + padding.left + padding.right;
    const f32 paddedHeight = max(measured.y, arrowExtent) + padding.top + padding.bottom;
    return Point(max(minimumSize.x, paddedWidth), max(minimumSize.y, paddedHeight));
}

b8 IsValidSearchComboDeclarationOptions(in SearchComboOptions options){
    return isFinite(options.queryHeight) && options.queryHeight > 0.0f && isFinite(options.queryGap) && options.queryGap >= 0.0f;
}

Rect ResolveComboQueryBoxAndAdvanceContent(in f32 measuredHeight, in f32 queryHeight, in f32 queryGap, mut Rect inOutContentRect){
    Rect queryRect = inOutContentRect;
    queryRect.height = min(max(queryHeight, measuredHeight), inOutContentRect.height);
    const f32 extent = min(inOutContentRect.height, queryRect.height + queryGap);
    inOutContentRect.y += extent;
    inOutContentRect.height -= extent;
    return queryRect;
}


