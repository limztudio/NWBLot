StringView FormatVirtualListRowLabel(in u64 rowKey, in Array<u8, s_VirtualListLabelCapacity> labelStorage){
    if(rowKey == 0u)
        return "";
    StringView result = "";
    native(in rowKey, in labelStorage, mut result){
        char* const label = reinterpret_cast<char*>(const_cast<u8*>(labelStorage.data()));
        label[0] = 'R';
        label[1] = 'o';
        label[2] = 'w';
        label[3] = ' ';
        Array<char, s_VirtualListMaxDecimalDigits> digits{};
        const AStringView formatted = FormatDecimal(static_cast<usize>(rowKey), digits);
        for(usize offset = 0u; offset < formatted.size(); ++offset)
            label[s_VirtualListRowPrefixLength + offset] = formatted[offset];
        result = StringView(label, s_VirtualListRowPrefixLength + formatted.size());
    }
    return result;
}

b8 LoadUiGallerySkinImageSource(mut GlobalArena arena, in AssetManager assets, in ActiveSceneSubsystems sceneSubsystems, mut SharedImageSource outSource){
    b8 loaded = false;
    native(mut arena, in assets, in sceneSubsystems, mut outSource, mut loaded){
        const UiSubsystem* const uiSubsystem = sceneSubsystems.findSubsystem<UiSubsystem>();
        if(uiSubsystem && uiSubsystem->basicSkin.valid()){
            auto skin = assets.loadTypedSync<UiSkin>(uiSubsystem->basicSkin.name(), NWB_TEXT("UiImageGallery"));
            if(skin){
                auto source = LoadImageSource(arena, assets, (*skin)->texture());
                if(source){
                    outSource = Move(*source);
                    loaded = true;
                }
            }
        }
    }
    return loaded;
}


