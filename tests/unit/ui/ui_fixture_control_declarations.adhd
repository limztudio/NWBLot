namespace UiRadioGroupTests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace Impl;
using namespace Impl::Ui;
using namespace UiWidgetTests;

inline constexpr AStringView s_RadioPanelKey = "panel";
inline constexpr AStringView s_RadioGroupKey = "radio";

namespace RadioCallbackSite{
    enum Enum : u8{ None, Instance, Revision, Count, Key, Text, Enabled };
};

namespace RadioMutation = ::__hidden_ui_glyph_sdf_tests::UiFixtureRadioMutation;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Radio group source with expiring label views and reentrant callback hooks.
class RadioSource final : public IListDataSource{
public:
    virtual ~RadioSource()noexcept override = default;


public:
    [[nodiscard]] virtual u64 instanceGeneration()const override{ callback(RadioCallbackSite::Instance); return m_generation; }
    [[nodiscard]] virtual u64 revision()const override{ callback(RadioCallbackSite::Revision); return m_contentRevision; }
    [[nodiscard]] virtual u64 rowCount()const override{ callback(RadioCallbackSite::Count); return rawCount(); }
    [[nodiscard]] virtual u64 key(const u64 index)const override{ callback(RadioCallbackSite::Key); return rawKey(index); }
    [[nodiscard]] virtual Expected<u64> indexOf(u64 value)const noexcept override;
    [[nodiscard]] virtual Expected<u64> findEnabled(u64 start, b8 reverse)const noexcept override;
    [[nodiscard]] virtual StringView text(u64 index)const override;
    [[nodiscard]] virtual b8 enabled(const u64 index)const override{
        callback(RadioCallbackSite::Enabled);
        return index < rawCount() && !m_allDisabled && rawKey(index) != m_disabled;
    }
    void resetCounters()const noexcept;
    void armSelection(RadioGroupState& state, const RadioCallbackSite::Enum site, const u64 keyValue, const b8 awayAndBack = false)noexcept{
        m_state = &state;
        m_selected = keyValue;
        m_site = site;
        m_mutation = awayAndBack ? RadioMutation::SelectAwayBack : RadioMutation::Select;
    }
    void armSource(const RadioCallbackSite::Enum site, const b8 replacement = false)noexcept{
        m_site = site;
        m_mutation = replacement ? RadioMutation::Replacement : RadioMutation::Revision;
    }
    void armReentry(Builder& builder, const RadioCallbackSite::Enum site, const b8 panel = false)noexcept{
        m_builder = &builder;
        m_site = site;
        m_mutation = panel ? RadioMutation::PanelBuilder : RadioMutation::ResetBuilder;
    }
    void armClose(PopupState& popup, const RadioCallbackSite::Enum site)noexcept{
        m_popup = &popup;
        m_site = site;
        m_mutation = RadioMutation::ClosePopup;
    }


private:
    [[nodiscard]] u64 rawCount()const noexcept;
    [[nodiscard]] u64 rawKey(u64 index)const noexcept;
    void callback(RadioCallbackSite::Enum site)const;


public:
    mutable u64 m_generation = 1801u;
    mutable u64 m_contentRevision = 1u;
    u64 m_count = 5u;
    u64 m_removed = 0u;
    u64 m_disabled = 30u;
    mutable u64 m_calls = 0u;
    mutable u64 m_textCalls = 0u;
    mutable u64 m_mutations = 0u;
    mutable u64 m_callbacksAfterMutation = 0u;
    b8 m_reverse = false;
    b8 m_duplicate = false;
    b8 m_allDisabled = false;
    mutable b8 m_beginAccepted = false;
    mutable b8 m_endAccepted = false;
    u64 m_selected = 0u;
    mutable Array<char, 4u> m_label{};


private:
    RadioGroupState* m_state = nullptr;
    Builder* m_builder = nullptr;
    PopupState* m_popup = nullptr;
    mutable RadioCallbackSite::Enum m_site = RadioCallbackSite::None;
    RadioMutation::Enum m_mutation = RadioMutation::None;
};

class RadioGroupFixture : public WidgetFixture{
public:
    using WidgetFixture::press;


public:
    void setUpWidgetBase(){ WidgetFixture::SetUp(); }
    virtual void SetUp()override;
    void configureRadioSkin(const b8 fallbackOnly = false){
        configureSkin();
        UiSkin::RegionVector regions(m_arena);
        regions.assign(m_skin.regions().begin(), m_skin.regions().end());
        constexpr Array<StringView, 6> s_Names{ "radio.normal", "radio.checked", "radio.mark", "checkbox.normal", "checkbox.checked", "checkbox.mark" };
        for(u32 index = 0u; index < 6u; ++index){
            if(fallbackOnly && index < 3u)
                continue;
            UiSkinRegion region;
            const auto regionName = Name::FromText(s_Names[index]);
            ASSERT_TRUE(regionName);
            region.name = *regionName;
            region.rectangle = { 88u + index * 8u, 0u, 8u, 8u };
            if(index % 3u != 2u){
                region.minimumWidth = 24.0f;
                region.minimumHeight = 24.0f;
            }
            regions.push_back(Move(region));
        }
        m_skin.setAtlas(Core::Assets::AssetRef<Texture>("tests/ui/texture"), 144u, 16u, 1.0f, Move(regions));
    }
    [[nodiscard]] b8 declare(u64 generation, const RadioGroupOptions& options = {}, const Rect& bounds = { 10.0f, 10.0f, 340.0f, 320.0f });
    [[nodiscard]] b8 declareSource(u64 generation, const IListDataSource& source, RadioGroupState& state, const RadioGroupOptions& options = {}, const Rect& bounds = { 10.0f, 10.0f, 340.0f, 320.0f });
    [[nodiscard]] b8 prepare(u64 generation, const RadioGroupOptions& options = {}, const Rect& bounds = { 10.0f, 10.0f, 340.0f, 320.0f });
    [[nodiscard]] b8 accept(u64 generation, const RadioGroupOptions& options = {}, const Rect& bounds = { 10.0f, 10.0f, 340.0f, 320.0f });
    [[nodiscard]] WidgetId host()const;
    [[nodiscard]] const RadioGroupChoicePlacement* choice(const u64 keyValue, const RadioGroupState& state)const noexcept{
        const RadioGroupPlacement& placement = state.placement();
        for(u32 index = 0u; index < placement.count; ++index){
            if(placement.rows[index].key == keyValue)
                return &placement.rows[index];
        }
        return nullptr;
    }
    [[nodiscard]] b8 hasChoice(const u64 keyValue, const RadioGroupState& state)const noexcept{ return choice(keyValue, state) != nullptr; }
    [[nodiscard]] Expected<RadioGroupChoicePlacement> tryChoice(u64 keyValue, const RadioGroupState& state)const noexcept;
    [[nodiscard]] Point choicePoint(u64 keyValue)const noexcept;
    [[nodiscard]] AcceptedInputState<128u> accepted()const noexcept{ return CaptureAcceptedInput<128u>(m_context.input()); }
    void expectAccepted(const AcceptedInputState<128u>& saved, const b8 focus = true, const b8 popupScopes = true)const{
        ExpectAcceptedInput(m_context.input(), saved, false, focus, popupScopes, true);
    }
    [[nodiscard]] usize regionQuads(const DrawSnapshot& snapshot, const Name& name)const noexcept;


public:
    RadioSource m_source;
    RadioGroupState m_state;
    RadioGroupResult m_result;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


