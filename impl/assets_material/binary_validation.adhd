#include <impl/assets_material/layout_validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


MaterialTypedLayoutBlock UnpackMaterialTypedLayoutBlockBinary(in MaterialTypedLayoutBlockBinary blockBinary){
    MaterialTypedLayoutBlock block;
    block.blockName = Name(blockBinary.blockNameHash);
    block.blockClass = cast<MaterialBlockClass>(blockBinary.blockClass);
    block.fieldBegin = blockBinary.fieldBegin;
    block.fieldCount = blockBinary.fieldCount;
    block.byteSize = blockBinary.byteSize;
    return block;
}

MaterialTypedLayoutField UnpackMaterialTypedLayoutFieldBinary(in MaterialTypedLayoutFieldBinary fieldBinary){
    MaterialTypedLayoutField field;
    field.fieldName = Name(fieldBinary.fieldNameHash);
    field.fieldType = cast<MaterialLayoutFieldType>(fieldBinary.fieldType);
    field.offset = fieldBinary.offset;
    field.defaultValue = fieldBinary.defaultValue;
    return field;
}

b8 TryAssignMaterialResourceReferenceAsset(in MaterialResourceKind resourceKind, in Name resourceName, mut MaterialResourceReference reference){
    switch(resourceKind){
        case MaterialResourceKind::SampledImage2D:
            reference.textureAsset.virtualPath = resourceName;
            return true;
        case MaterialResourceKind::Sampler:
            reference.samplerAsset.virtualPath = resourceName;
            return true;
        default:
            return false;
    }
}

Expected<MaterialResourceReference> TryUnpackMaterialResourceReferenceBinary(in MaterialResourceReferenceBinary resourceReferenceBinary){
    const MaterialResourceKind resourceKind = cast<MaterialResourceKind>(resourceReferenceBinary.resourceKind);
    const Name resourceName = Name(resourceReferenceBinary.resourceNameHash);
    if(!IsValidSerializedMaterialResourceReference(resourceKind, resourceName))
        return makeUnexpected(Failure());

    MaterialResourceReference outReference;
    outReference.blockName = Name(resourceReferenceBinary.blockNameHash);
    outReference.fieldName = Name(resourceReferenceBinary.fieldNameHash);
    outReference.resourceKind = resourceKind;
    outReference.constantByteOffset = resourceReferenceBinary.constantByteOffset;
    if(!TryAssignMaterialResourceReferenceAsset(resourceKind, resourceName, outReference))
        return makeUnexpected(Failure());
    return outReference;
}

b8 TryUnpackMaterialFlags(in u32 materialFlags, mut b8 outTransparent, mut b8 outTwoSided, mut b8 outRefractive){
    if((materialFlags & ~cast<u32>(MaterialFlag::All)) != 0u)
        return false;
    outTransparent = (materialFlags & cast<u32>(MaterialFlag::Transparent)) != 0u;
    outTwoSided = (materialFlags & cast<u32>(MaterialFlag::TwoSided)) != 0u;
    outRefractive = (materialFlags & cast<u32>(MaterialFlag::Refractive)) != 0u;
    return true;
}

// Transparent materials need all three pass shaders; opaque materials carry none.
b8 HasValidMaterialAvboitPixelShaderContract(
    in b8 transparent,
    in AssetRef<PixelShader> accumulatePixelShader,
    in AssetRef<PixelShader> occupancyPixelShader,
    in AssetRef<PixelShader> extinctionPixelShader
){
    if(transparent)
        return accumulatePixelShader.valid() && occupancyPixelShader.valid() && extinctionPixelShader.valid();

    return !accumulatePixelShader.valid() && !occupancyPixelShader.valid() && !extinctionPixelShader.valid();
}

b8 ValidateMaterialBinaryShaderCount(
    in u32 shaderCount,
    in u32 maxShaderTypeCount,
    in usize remainingBytes,
    in usize shaderEntryBytes
){
    if(shaderCount == 0u){
        error("Material::loadBinary failed: material has no shader stages");
        return false;
    }
    if(shaderCount > maxShaderTypeCount){
        error("Material::loadBinary failed: shader count exceeds supported shader stage count");
        return false;
    }
    if(cast<usize>(shaderCount) > remainingBytes / shaderEntryBytes){
        error("Material::loadBinary failed: shader count exceeds available data");
        return false;
    }
    return true;
}

b8 ValidateMaterialBinaryFlags(
    in u32 materialFlags,
    mut b8 outTransparent,
    mut b8 outTwoSided,
    mut b8 outRefractive
){
    if(TryUnpackMaterialFlags(materialFlags, outTransparent, outTwoSided, outRefractive))
        return true;

    error("Material::loadBinary failed: material flags contain unsupported bits {}", materialFlags);
    return false;
}

b8 ValidateMaterialBinaryAvboitPresenceFlag(in StringView passLabel, in u32 hasShader){
    if(hasShader <= 1u)
        return true;

    error("Material::loadBinary failed: invalid AVBOIT {} pixel shader presence flag {}", passLabel, hasShader);
    return false;
}

b8 ValidateMaterialBinaryAvboitShaderRef(in StringView passLabel, in b8 isValidRef){
    if(isValidRef)
        return true;

    error("Material::loadBinary failed: AVBOIT {} pixel shader name is empty", passLabel);
    return false;
}


