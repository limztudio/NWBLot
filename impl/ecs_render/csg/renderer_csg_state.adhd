////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_csg/frame_types.adhd>
#include <impl/ecs_render/csg/work_region.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererCsgState : NoCopy{
    // CSG layouts are push-only; resources use the global heap.
    public BindingLayoutHandle m_clipBindingLayout = BindingLayoutHandle();
    public BindingLayoutHandle m_intervalPeelBindingLayout = BindingLayoutHandle();
    public BindingLayoutHandle m_receiverSpanBuildBindingLayout = BindingLayoutHandle();
    public BindingLayoutHandle m_intervalCombineBindingLayout = BindingLayoutHandle();
    public ShaderHandle m_intervalPeelComputeShader = ShaderHandle();
    public ShaderHandle m_receiverSpanBuildComputeShader = ShaderHandle();
    public ShaderHandle m_intervalCombineComputeShader = ShaderHandle();
    public ShaderHandle m_intervalCapFillPixelShader = ShaderHandle();
    public ShaderHandle m_refractionCapFillPixelShader = ShaderHandle();
    public ComputePipelineHandle m_intervalPeelPipeline = ComputePipelineHandle();
    public ComputePipelineHandle m_receiverSpanBuildPipeline = ComputePipelineHandle();
    public ComputePipelineHandle m_intervalCombinePipeline = ComputePipelineHandle();
    public GraphicsPipelineHandle m_intervalCapFillPipeline = GraphicsPipelineHandle();
    public GraphicsPipelineHandle m_refractionCapFillPipeline = GraphicsPipelineHandle();
    public BufferHandle m_receiverRangeBuffer = BufferHandle();
    public BufferHandle m_cutterBuffer = BufferHandle();
    public BufferHandle m_clipContextSlotsBuffer = BufferHandle();
    public BufferHandle m_intervalSampleStateBuffer = BufferHandle();
    public CsgFrameStateCacheSignature m_frameStateCacheSignature = CsgFrameStateCacheSignature();
    public CsgFrameState m_frameStateCache = CsgFrameState();
    public usize m_receiverRangeBufferCapacity = 0u;
    public usize m_cutterBufferCapacity = 0u;
    public GpuDescriptorHandle m_receiverRangeBufferHeapHandle = GpuDescriptorHandle();
    public GpuDescriptorHandle m_cutterBufferHeapHandle = GpuDescriptorHandle();
    public GpuDescriptorHandle m_clipContextSlotsHeapHandle = GpuDescriptorHandle();
    public GpuDescriptorHandle m_intervalSampleStateHeapHandle = GpuDescriptorHandle();
    public b8 m_frameStateCacheValid = false;

    public void invalidateResources(){
        this.m_clipBindingLayout.reset();
        this.m_intervalPeelBindingLayout.reset();
        this.m_receiverSpanBuildBindingLayout.reset();
        this.m_intervalCombineBindingLayout.reset();
        this.m_intervalPeelComputeShader.reset();
        this.m_receiverSpanBuildComputeShader.reset();
        this.m_intervalCombineComputeShader.reset();
        this.m_intervalCapFillPixelShader.reset();
        this.m_refractionCapFillPixelShader.reset();
        this.m_intervalPeelPipeline.reset();
        this.m_receiverSpanBuildPipeline.reset();
        this.m_intervalCombinePipeline.reset();
        this.m_intervalCapFillPipeline.reset();
        this.m_refractionCapFillPipeline.reset();
        this.m_receiverRangeBuffer.reset();
        this.m_cutterBuffer.reset();
        this.m_clipContextSlotsBuffer.reset();
        this.m_receiverRangeBufferHeapHandle = GpuDescriptorHandle();
        this.m_cutterBufferHeapHandle = GpuDescriptorHandle();
        this.m_clipContextSlotsHeapHandle = GpuDescriptorHandle();
        this.m_intervalSampleStateBuffer.reset();
        this.m_intervalSampleStateHeapHandle = GpuDescriptorHandle();
        this.m_frameStateCacheSignature = CsgFrameStateCacheSignature();
        this.m_frameStateCache = CsgFrameState();
        this.m_receiverRangeBufferCapacity = 0u;
        this.m_cutterBufferCapacity = 0u;
        this.m_frameStateCacheValid = false;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

