[modular]
class GraphicsPrefixTimingResolver : NoCopy{
    private in RendererFramePipeline m_pipeline;

    public GraphicsPrefixTimingResolver(in RendererFramePipeline pipeline){
        this.m_pipeline = pipeline;
    }

    public void resolve(
        in GpuCompiledGraphReadView compiledPlan,
        in Span<GraphicsPrefixTimingTicket> ownedTickets,
        mut Span<GraphicsPrefixTimingTicket> timingTickets,
        mut Span<GpuTaskId> timingTasks,
        mut b8 asyncSpansOnePacket,
        mut GraphicsPrefixTimingResolutionResult outResult
    )const;
}

class SurfelCausticsMergeValidationResult{
    public Optional<GpuPhysicalQueueInfo> hardwareCausticsQueue;
    public Optional<GpuPhysicalQueueInfo> surfelGiQueue;
    public Optional<GpuPhysicalQueueInfo> surfelGiPreparationQueue;
    public Optional<GpuPhysicalQueueInfo> surfelGiSnapshotCopyQueue;
    public Optional<GpuPhysicalQueueInfo> surfelGiCounterReadbackQueue;
    public b8 surfelGiOutputClearMergedIntoGiPacket = false;
    public b8 surfelGiPreparedPrefixMergedIntoGiPacket = false;
    public b8 surfelGiInitializationLifecycleMergedIntoPreparationPacket = false;
    public b8 causticPhotonMergedIntoCausticsPacket = false;
    public b8 causticGeometryMergedIntoCausticsPacket = false;
    public b8 causticResolvePrepareMergedIntoCausticsPacket = false;
    public b8 causticResolveWaveletsMergedIntoCausticsPacket = false;
    public b8 causticResolveUpsampleMergedIntoCausticsPacket = false;
    public b8 causticIrradianceClearMergedIntoCausticsPacket = false;
    public b8 causticAccumulatorBootstrapClearMergedIntoCausticsPacket = false;
    public b8 causticAccumulatorDecayMergedIntoCausticsPacket = false;
    public b8 surfelGiSnapshotCopyAndTimingPacketsAreDistinct = false;
    public b8 surfelCounterReadbackFollowsPresentation = false;
    public b8 laggedLightingHistoryFollowsPresentation = false;
}

[modular]
class OpaqueEmulationMergeValidator : NoCopy{
    private in RendererFramePipeline m_pipeline;

    public OpaqueEmulationMergeValidator(in RendererFramePipeline pipeline){
        this.m_pipeline = pipeline;
    }

    private b8 sharedPhasesMerge(in GpuCompiledGraphReadView compiledPlan, in Optional<GpuPhysicalQueueInfo> opaqueSharedComputeEmulationQueue)const;

    private b8 intervalSampleMerges(in GpuCompiledGraphReadView compiledPlan, in Optional<GpuPhysicalQueueInfo> opaqueCsgIntervalSampleComputeEmulationQueue)const;

    public void validate(
        in GpuCompiledGraphReadView compiledPlan,
        in Span<GpuTaskId> timingTasks,
        in b8 timingBindingsValid,
        in b8 hasOpaqueCsgFrameWork,
        mut OpaqueEmulationMergeValidationResult outResult
    )const;
}

[modular]
class SurfelCausticsMergeValidator : NoCopy{
    private in RendererFramePipeline m_pipeline;

    public SurfelCausticsMergeValidator(in RendererFramePipeline pipeline){
        this.m_pipeline = pipeline;
    }

    public void validate(
        in GpuCompiledGraphReadView compiledPlan,
        in GpuTaskId causticsTask,
        in GpuTaskId terminalPresentationTask,
        in b8 captureLaggedLightingHistory,
        mut SurfelCausticsMergeValidationResult outResult
    )const;
}


