}

void VerifyGpuPacketEnvelopeMetrics_RejectsInvalidOrIncomparableInputAndClearsOutputs(){
    PacketMetricsScratchContext context = PacketMetricsScratchContext(s_GpuTimingCasePacketMetricsRejection);
    Array<GpuComparableTimestampRange, 2> validRanges = Array<GpuComparableTimestampRange, 2>();
    validRanges[0u] = MakeComparableRange(0u, 10u, 1.0, MakePhysicalQueue(0u, 3u));
    validRanges[1u] = MakeComparableRange(5u, 15u, 1.0, MakePhysicalQueue(1u, 3u));

    const Span<GpuComparableTimestampRange> emptySpan = Span<GpuComparableTimestampRange>();
    ExpectEnvelopeMetricsRejected(emptySpan, context);
    const Span<GpuComparableTimestampRange> validSpan = validRanges;
    ExpectEnvelopeMetricsRejected(validSpan.subspan(0u, 0u), context);

    Array<GpuComparableTimestampRange, 2> invalidRanges = Array<GpuComparableTimestampRange, 2>();
    invalidRanges[0u] = validRanges[0u];
    invalidRanges[1u] = validRanges[1u];
    invalidRanges[0u].beginTicks = 11u;
    ExpectEnvelopeMetricsRejected(invalidRanges, context);

    invalidRanges[0u] = validRanges[0u];
    invalidRanges[0u].physicalQueue = GpuPhysicalQueueId();
    ExpectEnvelopeMetricsRejected(invalidRanges, context);

    invalidRanges[0u] = validRanges[0u];
    invalidRanges[0u].secondsPerTick = bit_cast<f64>(s_F64InfinityBits);
    ExpectEnvelopeMetricsRejected(invalidRanges, context);

    invalidRanges[0u].secondsPerTick = bit_cast<f64>(s_F64QuietNanBits);
    ExpectEnvelopeMetricsRejected(invalidRanges, context);

    invalidRanges[0u].secondsPerTick = 0.0;
    ExpectEnvelopeMetricsRejected(invalidRanges, context);

    invalidRanges[0u] = validRanges[0u];
    invalidRanges[1u].secondsPerTick = 0.5;
    ExpectEnvelopeMetricsRejected(invalidRanges, context);

    invalidRanges[1u] = validRanges[1u];
    invalidRanges[1u].physicalQueue.deviceGeneration = 4u;
    ExpectEnvelopeMetricsRejected(invalidRanges, context);
}

void VerifyGpuTimingSampleSubscriptions_ScopedDemandsReplaceAtomicallyAndRemainSubscriptionIsolated(){
    RecorderPairContext context = RecorderPairContext();
    mut GpuTimingRecorder recorder = context.firstRecorder;
    GpuTimingSubscriptionCapture firstCapture = GpuTimingSubscriptionCapture();
    GpuTimingSubscriptionCapture secondCapture = GpuTimingSubscriptionCapture();
    const Name firstScope = s_GpuTimingNameTestsGpuTimingFeedbackFirst;
    const Name sharedScope = s_GpuTimingNameTestsGpuTimingFeedbackShared;
    const Name secondScope = s_GpuTimingNameTestsGpuTimingFeedbackSecond;
    const Name metricFirstInput = s_GpuTimingNameTestsGpuTimingFeedbackMetricFirstInput;
    const Name metricSecondInput = s_GpuTimingNameTestsGpuTimingFeedbackMetricSecondInput;
    const Name metricAlternateFirstInput = s_GpuTimingNameTestsGpuTimingFeedbackMetricAlternateFirstInput;
    const Name metricAlternateSecondInput = s_GpuTimingNameTestsGpuTimingFeedbackMetricAlternateSecondInput;
    const Name metricOutput = s_GpuTimingNameTestsGpuTimingFeedbackMetricOutput;
    Array<Name, 2> firstScopes = Array<Name, 2>();
    firstScopes[0u] = firstScope;
    firstScopes[1u] = sharedScope;
    Array<Name, 2> secondScopes = Array<Name, 2>();
    secondScopes[0u] = sharedScope;
    secondScopes[1u] = secondScope;
    Array<Name, 2> invalidScopes = Array<Name, 2>();
    invalidScopes[0u] = firstScope;
    invalidScopes[1u] = s_NameNone;
    Array<Name, 2> duplicateScopes = Array<Name, 2>();
    duplicateScopes[0u] = firstScope;
    duplicateScopes[1u] = firstScope;
    Array<Name, 1> singleFirstScope = Array<Name, 1>();
    singleFirstScope[0u] = firstScope;
    Array<Name, 1> singleSecondScope = Array<Name, 1>();
    singleSecondScope[0u] = secondScope;
    Array<Name, 1> singleMetricOutput = Array<Name, 1>();
    singleMetricOutput[0u] = metricOutput;

    Expected<GpuTimingSampleSubscription> firstResult = MakeUnexpected(Failure());
    Expected<GpuTimingSampleSubscription> secondResult = MakeUnexpected(Failure());
    native(mut recorder, mut firstCapture, mut secondCapture, mut firstResult, mut secondResult){
        firstResult = recorder.subscribeSampleListener(MakeSubscriptionListener(firstCapture));
        secondResult = recorder.subscribeSampleListener(MakeSubscriptionListener(secondCapture));
    }
    ASSERT_TRUE(firstResult.has_value());
    const GpuTimingSampleSubscription first = firstResult.value();
    ASSERT_TRUE(secondResult.has_value());
    const GpuTimingSampleSubscription second = secondResult.value();

    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(second.valid());
    native(mut recorder, in first){
        static_assert(noexcept(recorder.unsubscribeSampleListener(first)));
    }
    EXPECT_NE(first, second);
    EXPECT_FALSE(recorder.collectionActive());
    ASSERT_TRUE(recorder.setFeedbackCollectionScopes(first, firstScopes));
    ASSERT_TRUE(recorder.setFeedbackCollectionScopes(first, firstScopes));
    EXPECT_TRUE(recorder.collectionActive());
    EXPECT_FALSE(recorder.setFeedbackCollectionScopes(first, invalidScopes));
    EXPECT_TRUE(recorder.collectionActive());
    EXPECT_FALSE(recorder.setFeedbackCollectionScopes(first, duplicateScopes));
    EXPECT_TRUE(recorder.collectionActive());
    EXPECT_FALSE(recorder.prepareOverlapMetric(metricFirstInput, metricSecondInput, firstScope));
    ASSERT_TRUE(recorder.prepareOverlapMetric(metricFirstInput, metricSecondInput, metricOutput));
    EXPECT_FALSE(recorder.setFeedbackCollectionScopes(first, singleMetricOutput));
    EXPECT_TRUE(recorder.collectionActive());
    EXPECT_FALSE(recorder.prepareOverlapMetric(metricAlternateFirstInput, metricAlternateSecondInput, firstScope));
    ASSERT_TRUE(recorder.setFeedbackCollectionScopes(second, secondScopes));
    ASSERT_TRUE(recorder.setFeedbackCollectionScopes(first, singleFirstScope));
    ASSERT_TRUE(recorder.clearFeedbackCollectionScopes(first));
    EXPECT_TRUE(recorder.collectionActive());

    ASSERT_TRUE(recorder.setFeedbackCollectionScopes(first, singleFirstScope));
    recorder.unsubscribeSampleListener(second);
    EXPECT_TRUE(recorder.collectionActive());
    EXPECT_FALSE(recorder.setFeedbackCollectionScopes(second, singleSecondScope));
    EXPECT_FALSE(recorder.clearFeedbackCollectionScopes(second));

    ASSERT_TRUE(recorder.clearFeedbackCollectionScopes(first));
    EXPECT_FALSE(recorder.collectionActive());
    EXPECT_TRUE(recorder.clearFeedbackCollectionScopes(first));

    recorder.unsubscribeSampleListener(first);
    EXPECT_FALSE(recorder.setFeedbackCollectionScopes(first, singleFirstScope));
    EXPECT_FALSE(recorder.clearFeedbackCollectionScopes(first));
}

void VerifyGpuTimingSampleAttribution_IssuesUniqueProcessIdentitiesAcrossRecorderResetAndRecreation(){
    RecorderPairContext context = RecorderPairContext();

    const Expected<GpuTimingSampleAttribution> firstResult = context.firstRecorder.allocateSampleAttribution();
    ASSERT_TRUE(firstResult.has_value());
    const GpuTimingSampleAttribution first = firstResult.value();
    const Expected<GpuTimingSampleAttribution> secondResult = context.firstRecorder.allocateSampleAttribution();
    ASSERT_TRUE(secondResult.has_value());
    const GpuTimingSampleAttribution second = secondResult.value();
    const Expected<GpuTimingSampleAttribution> recreatedResult = context.secondRecorder.allocateSampleAttribution();
    ASSERT_TRUE(recreatedResult.has_value());
    const GpuTimingSampleAttribution recreated = recreatedResult.value();
    context.firstRecorder.resetQueries();
    const Expected<GpuTimingSampleAttribution> afterResetResult = context.firstRecorder.allocateSampleAttribution();
    ASSERT_TRUE(afterResetResult.has_value());
    const GpuTimingSampleAttribution afterReset = afterResetResult.value();

    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(second.valid());
    ASSERT_TRUE(recreated.valid());
    ASSERT_TRUE(afterReset.valid());
    EXPECT_NE(first, second);
    EXPECT_NE(first, recreated);
    EXPECT_NE(first, afterReset);
    EXPECT_NE(second, recreated);
    EXPECT_NE(second, afterReset);
    EXPECT_NE(recreated, afterReset);
}

void VerifyTimerQueryResult_MasksHighBitsAndWrapsPartialWidth(){
    const TimerQueryResult result = MakeTimerQueryResult(0x1fau, 0x105u, 0.5, MakePhysicalQueue(1u, 3u), 8u, true);
    ASSERT_TRUE(result.valid());
    EXPECT_EQ(result.timestampMask(), 0xffu);
    EXPECT_EQ(result.maskedBeginTicks(), 0xfau);
    EXPECT_EQ(result.durationTicks(), 11u);
    EXPECT_DOUBLE_EQ(result.durationSeconds(), 5.5);
    EXPECT_FALSE(result.hasComparableRange());
}

void VerifyTimerQueryResult_WrapsFullWidthWithoutShiftingBySixtyFour(){
    const TimerQueryResult result = MakeTimerQueryResult(u64.max - 3u, 5u, 1.0, MakePhysicalQueue(1u, 3u), 64u, true);
    ASSERT_TRUE(result.valid());
    EXPECT_EQ(result.durationTicks(), 9u);
    EXPECT_DOUBLE_EQ(result.durationSeconds(), 9.0);
    EXPECT_FALSE(result.hasComparableRange());
}

void VerifyTimerQueryResult_RetainsNearFullWidthDurationWithoutPublishingAbsoluteRange(){
    const u64 highBit = cast<u64>(1u) << 63u;
    const TimerQueryResult result = MakeTimerQueryResult(highBit - 3u, 2u, 0.5, MakePhysicalQueue(1u, 3u), 63u, true);
    ASSERT_TRUE(result.valid());
    EXPECT_EQ(result.durationTicks(), 5u);
    EXPECT_DOUBLE_EQ(result.durationSeconds(), 2.5);
    EXPECT_FALSE(result.hasComparableRange());
}

void VerifyTimerQueryResult_ComparableRangeRequiresCapabilityAndPhysicalQueue(){
    TimerQueryResult result = MakeTimerQueryResult(10u, 20u, 1.0, MakePhysicalQueue(1u, 3u), 64u, false);
    ASSERT_TRUE(result.valid());
    EXPECT_FALSE(result.hasComparableRange());

    result.comparableAcrossSubmissions = true;
    result.physicalQueue = GpuPhysicalQueueId();
    EXPECT_FALSE(result.hasComparableRange());

    result.physicalQueue = MakePhysicalQueue(1u, 3u);
    EXPECT_TRUE(result.hasComparableRange());
}

void VerifyTimerQueryResult_RejectsUnknownOrOutOfRangeWidths(){
    TimerQueryResult result = MakeTimerQueryResult(10u, 20u, 1.0, GpuPhysicalQueueId(), 0u, false);
    EXPECT_FALSE(result.valid());
    EXPECT_EQ(result.timestampMask(), 0u);
    EXPECT_EQ(result.durationTicks(), 0u);
    EXPECT_DOUBLE_EQ(result.durationSeconds(), 0.0);

    result.timestampValidBits = 65u;
    EXPECT_FALSE(result.valid());
    EXPECT_EQ(result.timestampMask(), 0u);

    result.timestampValidBits = 64u;
    result.secondsPerTick = 0.0;
    EXPECT_FALSE(result.valid());
    EXPECT_FALSE(result.hasComparableRange());
}

void VerifyGpuComparableTimestampRange_IntersectsRawTicksBeforeFloatingPointConversion(){
    const GpuComparableTimestampRange first = MakeComparableRange(s_GpuTimingLargeTick, s_GpuTimingLargeTick + 5u, 0.25, MakePhysicalQueue(0u, 7u));
    const GpuComparableTimestampRange second = MakeComparableRange(s_GpuTimingLargeTick + 4u, s_GpuTimingLargeTick + 8u, 0.25, MakePhysicalQueue(3u, 7u));

    const Expected<u64> overlapTicks = TryComputeGpuTimestampOverlap(first, second);
    ASSERT_TRUE(overlapTicks.has_value());
    EXPECT_EQ(overlapTicks.value(), 1u);

    GpuComparableTimestampRange disjoint = second;
    disjoint.beginTicks = first.endTicks;
    disjoint.endTicks = first.endTicks + 2u;
    const Expected<u64> disjointOverlap = TryComputeGpuTimestampOverlap(first, disjoint);
    ASSERT_TRUE(disjointOverlap.has_value());
    EXPECT_EQ(disjointOverlap.value(), 0u);

    GpuComparableTimestampRange recreatedDevice = second;
    recreatedDevice.physicalQueue.deviceGeneration = 8u;
    EXPECT_FALSE(TryComputeGpuTimestampOverlap(first, recreatedDevice).has_value());

    GpuComparableTimestampRange mismatchedPeriod = second;
    mismatchedPeriod.secondsPerTick = 0.5;
    EXPECT_FALSE(TryComputeGpuTimestampOverlap(first, mismatchedPeriod).has_value());

    GpuComparableTimestampRange infinitePeriod = second;
    infinitePeriod.secondsPerTick = bit_cast<f64>(s_F64InfinityBits);
    EXPECT_FALSE(infinitePeriod.valid());
    EXPECT_FALSE(TryComputeGpuTimestampOverlap(first, infinitePeriod).has_value());
}

void VerifyGpuTimingOverlapRegistration_IsCanonicalIdempotentAndRejectsMetricRoleConflicts(){
    TimingMetricContext context = TimingMetricContext();
    const Name firstScope = s_GpuTimingNameTestsTimingOverlapFirst;
    const Name secondScope = s_GpuTimingNameTestsTimingOverlapSecond;
    const Name thirdScope = s_GpuTimingNameTestsTimingOverlapThird;
    const Name fourthScope = s_GpuTimingNameTestsTimingOverlapFourth;
    const Name outputScope = s_GpuTimingNameTestsTimingOverlapOutput;
    const Name alternateOutputScope = s_GpuTimingNameTestsTimingOverlapAlternateOutput;

    EXPECT_FALSE(context.correlator.prepareOverlapMetric(s_NameNone, secondScope, outputScope));
    EXPECT_FALSE(context.correlator.prepareOverlapMetric(firstScope, s_NameNone, outputScope));
    EXPECT_FALSE(context.correlator.prepareOverlapMetric(firstScope, secondScope, s_NameNone));
    EXPECT_FALSE(context.correlator.prepareOverlapMetric(firstScope, firstScope, outputScope));
    EXPECT_FALSE(context.correlator.prepareOverlapMetric(firstScope, secondScope, firstScope));
    EXPECT_FALSE(context.correlator.prepareOverlapMetric(firstScope, secondScope, secondScope));
    EXPECT_EQ(context.timing.scopeCount(), 0u);

    ASSERT_TRUE(context.correlator.prepareOverlapMetric(firstScope, secondScope, outputScope));
    EXPECT_EQ(context.timing.scopeCount(), 1u);
    EXPECT_TRUE(context.correlator.prepareOverlapMetric(secondScope, firstScope, outputScope));
    EXPECT_EQ(context.timing.scopeCount(), 1u);

    EXPECT_FALSE(context.correlator.prepareOverlapMetric(firstScope, secondScope, alternateOutputScope));
    EXPECT_FALSE(context.correlator.prepareOverlapMetric(secondScope, firstScope, alternateOutputScope));
    EXPECT_FALSE(context.correlator.prepareOverlapMetric(thirdScope, fourthScope, outputScope));
    EXPECT_FALSE(context.correlator.prepareOverlapMetric(outputScope, thirdScope, alternateOutputScope));
    EXPECT_FALSE(context.correlator.prepareOverlapMetric(thirdScope, fourthScope, firstScope));
    EXPECT_EQ(context.timing.scopeCount(), 1u);

    EXPECT_TRUE(context.correlator.prepareOverlapMetric(firstScope, thirdScope, alternateOutputScope));
    EXPECT_EQ(context.timing.scopeCount(), 2u);
}

void VerifyGpuTimingOverlapRegistration_ReversedDuplicatePublishesOneSample(){
    TimingMetricContext context = TimingMetricContext();
    context.timing.setEnabled(true);
    const Name firstScope = s_GpuTimingNameTestsTimingOverlapSampleFirst;
    const Name secondScope = s_GpuTimingNameTestsTimingOverlapSampleSecond;
    const Name outputScope = s_GpuTimingNameTestsTimingOverlapSampleOutput;
    const GpuComparableTimestampRange firstRange = MakeComparableRange(10u, 20u, 0.25, MakePhysicalQueue(0u, 3u));
    const GpuComparableTimestampRange secondRange = MakeComparableRange(18u, 30u, 0.25, MakePhysicalQueue(1u, 3u));
    GpuTimingSinkSampleVector performanceSamples = GpuTimingSinkSampleVector(context.scratchArena);

    ASSERT_TRUE(context.correlator.prepareOverlapMetric(firstScope, secondScope, outputScope));
    ASSERT_TRUE(context.correlator.prepareOverlapMetric(secondScope, firstScope, outputScope));
    RecordCorrelatorTimestampRange(context.correlator, firstScope, 41u, firstRange, context.scratchArena, performanceSamples);
    EXPECT_TRUE(performanceSamples.empty());
    RecordCorrelatorTimestampRange(context.correlator, secondScope, 41u, secondRange, context.scratchArena, performanceSamples);
    ASSERT_EQ(performanceSamples.size(), 1u);
    const GpuTimingSinkSample publishedSample = performanceSamples.front();
    const TimingScopeId outputScopeId = context.timing.scopeAt(0u);
    EXPECT_EQ(publishedSample.scope.index, outputScopeId.index);
    EXPECT_EQ(publishedSample.scope.generation, outputScopeId.generation);
    EXPECT_DOUBLE_EQ(publishedSample.durationSeconds, 0.5);
    EXPECT_EQ(publishedSample.sourceFrameIndex, 41u);

    performanceSamples.clear();
    RecordCorrelatorTimestampRange(context.correlator, secondScope, 41u, secondRange, context.scratchArena, performanceSamples);
    EXPECT_TRUE(performanceSamples.empty());
    context.timing.recordSample(publishedSample.scope, publishedSample.durationSeconds, publishedSample.sourceFrameIndex);
    context.timing.publishFrame(42u);

    const TimingStats stats = context.timing.stats(outputScope);
    ASSERT_EQ(stats.sampleCount, 1u);
    EXPECT_DOUBLE_EQ(stats.seconds, 0.5);
    EXPECT_EQ(stats.firstSampleFrameIndex, 41u);
    EXPECT_EQ(stats.lastSampleFrameIndex, 41u);
}

void VerifyGpuTimingOverlapRegistration_CatchUpBatchBoundsSourceFramesAndPreservesLastArrivalDuration(){
    TimingMetricContext context = TimingMetricContext();
    context.timing.setEnabled(true);
    const Name firstScope = s_GpuTimingNameTestsTimingOverlapCatchUpFirst;
    const Name secondScope = s_GpuTimingNameTestsTimingOverlapCatchUpSecond;
    const Name outputScope = s_GpuTimingNameTestsTimingOverlapCatchUpOutput;
    const GpuComparableTimestampRange firstRange = MakeComparableRange(10u, 30u, 0.25, MakePhysicalQueue(0u, 3u));
    const GpuComparableTimestampRange newerRange = MakeComparableRange(18u, 34u, 0.25, MakePhysicalQueue(1u, 3u));
    GpuComparableTimestampRange olderRange = newerRange;
    olderRange.beginTicks = 26u;
    GpuTimingSinkSampleVector samples = GpuTimingSinkSampleVector(context.scratchArena);
    ASSERT_TRUE(context.correlator.prepareOverlapMetric(firstScope, secondScope, outputScope));
    RecordCorrelatorTimestampRange(context.correlator, firstScope, 50u, firstRange, context.scratchArena, samples);
    RecordCorrelatorTimestampRange(context.correlator, firstScope, 51u, firstRange, context.scratchArena, samples);
    RecordCorrelatorTimestampRange(context.correlator, secondScope, 51u, newerRange, context.scratchArena, samples);
    RecordCorrelatorTimestampRange(context.correlator, secondScope, 50u, olderRange, context.scratchArena, samples);
    ASSERT_EQ(samples.size(), 2u);
    EXPECT_EQ(samples[0u].sourceFrameIndex, 51u);
    EXPECT_EQ(samples[1u].sourceFrameIndex, 50u);
    EXPECT_DOUBLE_EQ(samples[0u].durationSeconds, 3.0);
    EXPECT_DOUBLE_EQ(samples[1u].durationSeconds, 1.0);
    for(in GpuTimingSinkSample sample : samples)
        context.timing.recordSample(sample.scope, sample.durationSeconds, sample.sourceFrameIndex);
    context.timing.publishFrame(52u);

    const TimingStats stats = context.timing.stats(outputScope);
    ASSERT_EQ(stats.sampleCount, 2u);
    EXPECT_EQ(stats.publishFrameIndex, 52u);
    EXPECT_EQ(stats.firstSampleFrameIndex, 50u);
    EXPECT_EQ(stats.lastSampleFrameIndex, 51u);
    EXPECT_DOUBLE_EQ(stats.seconds, 4.0);
    EXPECT_DOUBLE_EQ(stats.minSeconds, 1.0);
    EXPECT_DOUBLE_EQ(stats.maxSeconds, 3.0);
    EXPECT_DOUBLE_EQ(stats.lastSeconds, 1.0);
}

void VerifyGpuTimingOverlapRegistration_DiscardPreservesRegistrationAndResetClearsIt(){
    TimingMetricContext context = TimingMetricContext();
    context.timing.setEnabled(true);
    const Name firstScope = s_GpuTimingNameTestsTimingOverlapLifecycleFirst;
    const Name secondScope = s_GpuTimingNameTestsTimingOverlapLifecycleSecond;
    const Name resetFirstScope = s_GpuTimingNameTestsTimingOverlapLifecycleResetFirst;
    const Name resetSecondScope = s_GpuTimingNameTestsTimingOverlapLifecycleResetSecond;
    const Name outputScope = s_GpuTimingNameTestsTimingOverlapLifecycleOutput;
    const GpuComparableTimestampRange firstRange = MakeComparableRange(10u, 20u, 0.25, MakePhysicalQueue(0u, 3u));
    const GpuComparableTimestampRange secondRange = MakeComparableRange(18u, 30u, 0.25, MakePhysicalQueue(1u, 3u));

    ASSERT_TRUE(context.correlator.prepareOverlapMetric(firstScope, secondScope, outputScope));
    RecordAndPublishTimestampRange(firstScope, 51u, firstRange, context);
    context.correlator.discardPendingRanges();
    RecordAndPublishTimestampRange(secondScope, 51u, secondRange, context);
    context.timing.publishFrame(52u);
    EXPECT_FALSE(context.timing.stats(outputScope).valid());

    RecordAndPublishTimestampRange(firstScope, 53u, firstRange, context);
    RecordAndPublishTimestampRange(secondScope, 53u, secondRange, context);
    context.timing.publishFrame(54u);
    const TimingStats afterDiscard = context.timing.stats(outputScope);
    ASSERT_EQ(afterDiscard.sampleCount, 1u);
    EXPECT_DOUBLE_EQ(afterDiscard.seconds, 0.5);
    EXPECT_EQ(afterDiscard.firstSampleFrameIndex, 53u);
    EXPECT_EQ(afterDiscard.lastSampleFrameIndex, 53u);

    RecordAndPublishTimestampRange(firstScope, 55u, firstRange, context);
    context.correlator.reset();
    RecordAndPublishTimestampRange(secondScope, 55u, secondRange, context);
    context.timing.publishFrame(56u);
    EXPECT_FALSE(context.timing.stats(outputScope).valid());

    ASSERT_TRUE(context.correlator.prepareOverlapMetric(resetFirstScope, resetSecondScope, outputScope));
    RecordAndPublishTimestampRange(resetFirstScope, 57u, firstRange, context);
    RecordAndPublishTimestampRange(resetSecondScope, 57u, secondRange, context);
    context.timing.publishFrame(58u);
    const TimingStats afterReset = context.timing.stats(outputScope);
    ASSERT_EQ(afterReset.sampleCount, 1u);
    EXPECT_DOUBLE_EQ(afterReset.seconds, 0.5);
    EXPECT_EQ(afterReset.firstSampleFrameIndex, 57u);
    EXPECT_EQ(afterReset.lastSampleFrameIndex, 57u);
}

void VerifyGpuTimingPacketEnvelopeMetrics_PublishesCompleteOutOfOrderEnvelopeByPhysicalQueue(){
    TimingMetricContext context = TimingMetricContext();
    context.timing.setEnabled(true);
    const Name firstScope = s_GpuTimingNameTestsTimingEnvelopeFirst;
    const Name secondScope = s_GpuTimingNameTestsTimingEnvelopeSecond;
    const Name thirdScope = s_GpuTimingNameTestsTimingEnvelopeThird;
    const Name overlapScope = s_GpuTimingNameTestsTimingEnvelopeQueueOverlap;
    const Name firstQueueIdleScope = s_GpuTimingNameTestsTimingEnvelopeQueue0InternalIdle;
    const Name secondQueueIdleScope = s_GpuTimingNameTestsTimingEnvelopeQueue1InternalIdle;
    const GpuPhysicalQueueId firstQueue = MakePhysicalQueue(0u, 7u);
    const GpuPhysicalQueueId secondQueue = MakePhysicalQueue(1u, 7u);
    Array<GpuPacketEnvelopeMetricScope, 3> scopes = Array<GpuPacketEnvelopeMetricScope, 3>();
    scopes[0u] = MakeEnvelopeScope(firstScope, firstQueue);
    scopes[1u] = MakeEnvelopeScope(secondScope, secondQueue);
    scopes[2u] = MakeEnvelopeScope(thirdScope, firstQueue);
    Array<GpuPacketEnvelopeMetricQueueOutput, 2> outputs = Array<GpuPacketEnvelopeMetricQueueOutput, 2>();
    outputs[0u] = MakeEnvelopeOutput(firstQueue, firstQueueIdleScope);
    outputs[1u] = MakeEnvelopeOutput(secondQueue, secondQueueIdleScope);

    ASSERT_TRUE(context.correlator.preparePacketEnvelopeMetrics(73u, scopes, overlapScope, outputs));
    EXPECT_TRUE(context.correlator.preparePacketEnvelopeMetrics(73u, scopes, overlapScope, outputs));
    RecordAndPublishTimestampRange(thirdScope, 73u, MakeComparableRange(15u, 20u, 0.25, firstQueue), context);
    RecordAndPublishTimestampRange(firstScope, 73u, MakeComparableRange(0u, 10u, 0.25, firstQueue), context);
    context.timing.publishFrame(74u);
    EXPECT_FALSE(context.timing.stats(overlapScope).valid());

    RecordAndPublishTimestampRange(secondScope, 73u, MakeComparableRange(5u, 18u, 0.25, secondQueue), context);
    context.timing.publishFrame(75u);

    const TimingStats overlap = context.timing.stats(overlapScope);
    const TimingStats firstQueueIdle = context.timing.stats(firstQueueIdleScope);
    const TimingStats secondQueueIdle = context.timing.stats(secondQueueIdleScope);
    ASSERT_EQ(overlap.sampleCount, 1u);
    ASSERT_EQ(firstQueueIdle.sampleCount, 1u);
    ASSERT_EQ(secondQueueIdle.sampleCount, 1u);
    EXPECT_DOUBLE_EQ(overlap.seconds, 2.0);
    EXPECT_DOUBLE_EQ(firstQueueIdle.seconds, 1.25);
    EXPECT_DOUBLE_EQ(secondQueueIdle.seconds, 0.0);
    EXPECT_EQ(overlap.firstSampleFrameIndex, 73u);
    EXPECT_EQ(overlap.lastSampleFrameIndex, 73u);

    RecordAndPublishTimestampRange(thirdScope, 73u, MakeComparableRange(15u, 20u, 0.25, firstQueue), context);
    RecordAndPublishTimestampRange(firstScope, 73u, MakeComparableRange(0u, 10u, 0.25, firstQueue), context);
    RecordAndPublishTimestampRange(secondScope, 73u, MakeComparableRange(5u, 18u, 0.25, secondQueue), context);
    context.timing.publishFrame(76u);
    EXPECT_FALSE(context.timing.stats(overlapScope).valid());
    EXPECT_FALSE(context.timing.stats(firstQueueIdleScope).valid());
    EXPECT_FALSE(context.timing.stats(secondQueueIdleScope).valid());
}

void VerifyGpuTimingPacketEnvelopeMetrics_RejectsOutputRoleAndPhysicalQueueCollisions(){
    TimingMetricContext context = TimingMetricContext();
    const Name firstScope = s_GpuTimingNameTestsTimingEnvelopeRoleFirst;
    const Name secondScope = s_GpuTimingNameTestsTimingEnvelopeRoleSecond;
    const Name overlapScope = s_GpuTimingNameTestsTimingEnvelopeRoleOverlap;
    const Name alternateOverlapScope = s_GpuTimingNameTestsTimingEnvelopeRoleAlternateOverlap;
    const Name firstQueueIdleScope = s_GpuTimingNameTestsTimingEnvelopeRoleQueue0Idle;
    const Name secondQueueIdleScope = s_GpuTimingNameTestsTimingEnvelopeRoleQueue1Idle;
    const Name alternateFirstQueueIdleScope = s_GpuTimingNameTestsTimingEnvelopeRoleAlternateQueue0Idle;
    const Name alternateSecondQueueIdleScope = s_GpuTimingNameTestsTimingEnvelopeRoleAlternateQueue1Idle;
    const GpuPhysicalQueueId firstQueue = MakePhysicalQueue(0u, 9u);
    const GpuPhysicalQueueId secondQueue = MakePhysicalQueue(1u, 9u);
    Array<GpuPacketEnvelopeMetricScope, 2> scopes = Array<GpuPacketEnvelopeMetricScope, 2>();
    scopes[0u] = MakeEnvelopeScope(firstScope, firstQueue);
    scopes[1u] = MakeEnvelopeScope(secondScope, secondQueue);
    Array<GpuPacketEnvelopeMetricQueueOutput, 2> outputs = Array<GpuPacketEnvelopeMetricQueueOutput, 2>();
    outputs[0u] = MakeEnvelopeOutput(firstQueue, firstQueueIdleScope);
    outputs[1u] = MakeEnvelopeOutput(secondQueue, secondQueueIdleScope);
    ASSERT_TRUE(context.correlator.preparePacketEnvelopeMetrics(80u, scopes, overlapScope, outputs));

    Array<GpuPacketEnvelopeMetricQueueOutput, 2> overlapAsIdleOutputs = Array<GpuPacketEnvelopeMetricQueueOutput, 2>();
    overlapAsIdleOutputs[0u] = MakeEnvelopeOutput(firstQueue, overlapScope);
    overlapAsIdleOutputs[1u] = MakeEnvelopeOutput(secondQueue, alternateSecondQueueIdleScope);
    EXPECT_FALSE(context.correlator.preparePacketEnvelopeMetrics(81u, scopes, alternateOverlapScope, overlapAsIdleOutputs));

    Array<GpuPacketEnvelopeMetricQueueOutput, 2> alternateOutputs = Array<GpuPacketEnvelopeMetricQueueOutput, 2>();
    alternateOutputs[0u] = MakeEnvelopeOutput(firstQueue, alternateFirstQueueIdleScope);
    alternateOutputs[1u] = MakeEnvelopeOutput(secondQueue, alternateSecondQueueIdleScope);
    EXPECT_FALSE(context.correlator.preparePacketEnvelopeMetrics(81u, scopes, firstQueueIdleScope, alternateOutputs));

    Array<GpuPacketEnvelopeMetricQueueOutput, 2> remappedOutputs = Array<GpuPacketEnvelopeMetricQueueOutput, 2>();
    remappedOutputs[0u] = MakeEnvelopeOutput(firstQueue, alternateFirstQueueIdleScope);
    remappedOutputs[1u] = MakeEnvelopeOutput(secondQueue, firstQueueIdleScope);
    EXPECT_FALSE(context.correlator.preparePacketEnvelopeMetrics(81u, scopes, alternateOverlapScope, remappedOutputs));
    EXPECT_EQ(context.timing.scopeCount(), 3u);
}

void VerifyGpuTimingPacketEnvelopeMetrics_RetainsSuccessfulOutputRolesWhenSinkRegistrationFails(){
    FailOnceTimingContext context = FailOnceTimingContext(2u);
    const Name firstScope = s_GpuTimingNameTestsTimingEnvelopeFailureFirst;
    const Name secondScope = s_GpuTimingNameTestsTimingEnvelopeFailureSecond;
    const Name retryFirstScope = s_GpuTimingNameTestsTimingEnvelopeFailureRetryFirst;
    const Name retrySecondScope = s_GpuTimingNameTestsTimingEnvelopeFailureRetrySecond;
    const Name overlapScope = s_GpuTimingNameTestsTimingEnvelopeFailureOverlap;
    const Name firstQueueIdleScope = s_GpuTimingNameTestsTimingEnvelopeFailureQueue0Idle;
    const Name secondQueueIdleScope = s_GpuTimingNameTestsTimingEnvelopeFailureQueue1Idle;
    const Name alternateSecondQueueIdleScope = s_GpuTimingNameTestsTimingEnvelopeFailureAlternateQueue1Idle;
    const GpuPhysicalQueueId firstQueue = MakePhysicalQueue(0u, 13u);
    const GpuPhysicalQueueId secondQueue = MakePhysicalQueue(1u, 13u);
    Array<GpuPacketEnvelopeMetricScope, 2> scopes = Array<GpuPacketEnvelopeMetricScope, 2>();
    scopes[0u] = MakeEnvelopeScope(firstScope, firstQueue);
    scopes[1u] = MakeEnvelopeScope(secondScope, secondQueue);
    Array<GpuPacketEnvelopeMetricQueueOutput, 2> outputs = Array<GpuPacketEnvelopeMetricQueueOutput, 2>();
    outputs[0u] = MakeEnvelopeOutput(firstQueue, firstQueueIdleScope);
    outputs[1u] = MakeEnvelopeOutput(secondQueue, secondQueueIdleScope);
    Array<GpuPacketEnvelopeMetricQueueOutput, 2> retryOutputs = Array<GpuPacketEnvelopeMetricQueueOutput, 2>();
    retryOutputs[0u] = MakeEnvelopeOutput(firstQueue, firstQueueIdleScope);
    retryOutputs[1u] = MakeEnvelopeOutput(secondQueue, alternateSecondQueueIdleScope);

    EXPECT_FALSE(context.correlator.preparePacketEnvelopeMetrics(90u, scopes, overlapScope, outputs));
    EXPECT_FALSE(context.correlator.prepareOverlapMetric(retryFirstScope, retrySecondScope, overlapScope));
    EXPECT_FALSE(context.correlator.prepareOverlapMetric(retryFirstScope, retrySecondScope, firstQueueIdleScope));
    ASSERT_TRUE(context.correlator.prepareOverlapMetric(retryFirstScope, retrySecondScope, secondQueueIdleScope));
    EXPECT_TRUE(context.correlator.preparePacketEnvelopeMetrics(90u, scopes, overlapScope, retryOutputs));
}

void VerifyGpuTimingPacketEnvelopeMetrics_IsolatesFramesRejectsWrongQueuesPrunesIncompleteFramesAndResetsState(){
    TimingMetricContext context = TimingMetricContext();
    context.timing.setEnabled(true);
    const Name firstScope = s_GpuTimingNameTestsTimingEnvelopeIsolationFirst;
    const Name secondScope = s_GpuTimingNameTestsTimingEnvelopeIsolationSecond;
    const Name overlapScope = s_GpuTimingNameTestsTimingEnvelopeIsolationOverlap;
    const Name firstQueueIdleScope = s_GpuTimingNameTestsTimingEnvelopeIsolationQueue0Idle;
    const Name secondQueueIdleScope = s_GpuTimingNameTestsTimingEnvelopeIsolationQueue1Idle;
    const Name resetFirstOutputScope = s_GpuTimingNameTestsTimingEnvelopeIsolationResetFirstOutput;
    const Name resetSecondInputScope = s_GpuTimingNameTestsTimingEnvelopeIsolationResetSecondInput;
    const Name resetSecondOutputScope = s_GpuTimingNameTestsTimingEnvelopeIsolationResetSecondOutput;
    const GpuPhysicalQueueId firstQueue = MakePhysicalQueue(0u, 11u);
    const GpuPhysicalQueueId secondQueue = MakePhysicalQueue(1u, 11u);
    Array<GpuPacketEnvelopeMetricScope, 2> scopes = Array<GpuPacketEnvelopeMetricScope, 2>();
    scopes[0u] = MakeEnvelopeScope(firstScope, firstQueue);
    scopes[1u] = MakeEnvelopeScope(secondScope, secondQueue);
    Array<GpuPacketEnvelopeMetricQueueOutput, 2> outputs = Array<GpuPacketEnvelopeMetricQueueOutput, 2>();
    outputs[0u] = MakeEnvelopeOutput(firstQueue, firstQueueIdleScope);
    outputs[1u] = MakeEnvelopeOutput(secondQueue, secondQueueIdleScope);
    ASSERT_TRUE(context.correlator.preparePacketEnvelopeMetrics(50u, scopes, overlapScope, outputs));
    ASSERT_TRUE(context.correlator.preparePacketEnvelopeMetrics(51u, scopes, overlapScope, outputs));

    const GpuComparableTimestampRange firstRange = MakeComparableRange(2u, 8u, 0.5, firstQueue);
    const GpuComparableTimestampRange secondRange = MakeComparableRange(4u, 10u, 0.5, secondQueue);
    RecordAndPublishTimestampRange(firstScope, 50u, firstRange, context);
    RecordAndPublishTimestampRange(secondScope, 51u, secondRange, context);
    RecordAndPublishTimestampRange(firstScope, 51u, secondRange, context);
    context.timing.publishFrame(52u);
    EXPECT_FALSE(context.timing.stats(overlapScope).valid());

    RecordAndPublishTimestampRange(firstScope, 51u, firstRange, context);
    context.timing.publishFrame(53u);
    const TimingStats frameFiftyOne = context.timing.stats(overlapScope);
    ASSERT_EQ(frameFiftyOne.sampleCount, 1u);
    EXPECT_DOUBLE_EQ(frameFiftyOne.seconds, 2.0);
    EXPECT_EQ(frameFiftyOne.firstSampleFrameIndex, 51u);

    RecordAndPublishTimestampRange(secondScope, 50u, secondRange, context);
    context.timing.publishFrame(54u);
    const TimingStats frameFifty = context.timing.stats(overlapScope);
    ASSERT_EQ(frameFifty.sampleCount, 1u);
    EXPECT_DOUBLE_EQ(frameFifty.seconds, 2.0);
    EXPECT_EQ(frameFifty.firstSampleFrameIndex, 50u);
    EXPECT_EQ(frameFifty.lastSampleFrameIndex, 50u);

    ASSERT_TRUE(context.correlator.preparePacketEnvelopeMetrics(55u, scopes, overlapScope, outputs));
    RecordAndPublishTimestampRange(firstScope, 55u, firstRange, context);
    context.correlator.discardPendingRanges();
    RecordAndPublishTimestampRange(secondScope, 55u, secondRange, context);
    context.timing.publishFrame(56u);
    EXPECT_FALSE(context.timing.stats(overlapScope).valid());
    EXPECT_FALSE(context.timing.stats(firstQueueIdleScope).valid());
    EXPECT_FALSE(context.timing.stats(secondQueueIdleScope).valid());
    EXPECT_FALSE(context.correlator.prepareOverlapMetric(resetFirstOutputScope, resetSecondInputScope, overlapScope));
    EXPECT_FALSE(context.correlator.prepareOverlapMetric(resetFirstOutputScope, resetSecondInputScope, firstQueueIdleScope));
    EXPECT_FALSE(context.correlator.prepareOverlapMetric(resetFirstOutputScope, resetSecondInputScope, secondQueueIdleScope));

    ASSERT_TRUE(context.correlator.preparePacketEnvelopeMetrics(57u, scopes, overlapScope, outputs));
    RecordAndPublishTimestampRange(firstScope, 57u, firstRange, context);
    RecordAndPublishTimestampRange(secondScope, 57u, secondRange, context);
    context.timing.publishFrame(58u);
    const TimingStats afterDiscard = context.timing.stats(overlapScope);
    ASSERT_EQ(afterDiscard.sampleCount, 1u);
    EXPECT_EQ(afterDiscard.firstSampleFrameIndex, 57u);
    EXPECT_EQ(afterDiscard.lastSampleFrameIndex, 57u);

    ASSERT_TRUE(context.correlator.preparePacketEnvelopeMetrics(60u, scopes, overlapScope, outputs));
    RecordAndPublishTimestampRange(firstScope, 60u, firstRange, context);
    ASSERT_TRUE(context.correlator.preparePacketEnvelopeMetrics(1000u, scopes, overlapScope, outputs));
    RecordAndPublishTimestampRange(secondScope, 60u, secondRange, context);
    context.timing.publishFrame(1001u);
    EXPECT_FALSE(context.timing.stats(overlapScope).valid());
    EXPECT_FALSE(context.timing.stats(firstQueueIdleScope).valid());
    EXPECT_FALSE(context.timing.stats(secondQueueIdleScope).valid());

    RecordAndPublishTimestampRange(firstScope, 1000u, firstRange, context);
    context.correlator.reset();
    RecordAndPublishTimestampRange(secondScope, 1000u, secondRange, context);
    context.timing.publishFrame(1002u);
    EXPECT_FALSE(context.timing.stats(overlapScope).valid());
    EXPECT_FALSE(context.timing.stats(firstQueueIdleScope).valid());
    EXPECT_FALSE(context.timing.stats(secondQueueIdleScope).valid());

    ASSERT_TRUE(context.correlator.prepareOverlapMetric(overlapScope, firstQueueIdleScope, resetFirstOutputScope));
    ASSERT_TRUE(context.correlator.prepareOverlapMetric(secondQueueIdleScope, resetSecondInputScope, resetSecondOutputScope));
}

void VerifyVulkanViewportPolicy_FractionalBoundsAreRoundedOutAndNegativeScissorsAreRejected(){
    const Viewport viewport = Viewport(1.2f, 10.2f, 2.1f, 8.7f, 0.0f, 1.0f);
    const Expected<VkRect2D> rect = VulkanViewportPolicy::BuildImplicitScissor(viewport);
    ASSERT_TRUE(rect.has_value());
    EXPECT_EQ(rect.value().offset.x, 1);
    EXPECT_EQ(rect.value().offset.y, 2);
    EXPECT_EQ(rect.value().extent.width, 10u);
    EXPECT_EQ(rect.value().extent.height, 7u);
    EXPECT_FALSE(VulkanViewportPolicy::BuildImplicitScissor(Viewport(-0.1f, 10.0f, 0.0f, 8.0f, 0.0f, 1.0f)).has_value());
}

void VerifyResourceQueueSharing_RejectsEveryUnknownSharingBit(){
    const u32 maxValidValue = cast<u32>(ResourceQueueSharing::GraphicsAsyncComputeAndTransfer);
    const u32 maxByteValue = cast<u32>(u8.max);
    for(u32 rawValue = maxValidValue; rawValue <= maxByteValue; ++rawValue){
        ScopedTestTrace trace(rawValue);
        const ResourceQueueSharingMask sharing = cast<ResourceQueueSharingMask>(cast<u8>(rawValue));
        EXPECT_EQ(ResourceQueueSharing::IsValid(sharing), rawValue <= maxValidValue);
    }
}


