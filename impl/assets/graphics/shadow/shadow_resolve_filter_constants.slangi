////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SHADOW_RESOLVE_FILTER_CONSTANTS_SLANGI
#define NWB_GRAPHICS_SHADOW_RESOLVE_FILTER_CONSTANTS_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#define NWB_SHADOW_RESOLVE_NORMAL_POWER 8.0
#define NWB_SHADOW_RESOLVE_WAVELET_DIST_FRAC 0.02
#define NWB_SHADOW_RESOLVE_VARIANCE_MIN_HISTORY 4.0
#define NWB_SHADOW_RESOLVE_SCALAR_SIGMA_SCALE 1.0
#define NWB_SHADOW_RESOLVE_RGB_SIGMA_SCALE 0.20
#define NWB_SHADOW_RESOLVE_SIGMA_BASE 4.0
#define NWB_SHADOW_RESOLVE_SIGMA_EPS_BASE 0.05
#define NWB_SHADOW_RESOLVE_SIGMA_DISTANCE_MIN 1e-3
// The kernel reaches this many taps to each side of the center; the tile halo covers both sides.
#define NWB_SHADOW_RESOLVE_KERNEL_RADIUS 2
#define NWB_SHADOW_RESOLVE_KERNEL_HALO (2 * NWB_SHADOW_RESOLVE_KERNEL_RADIUS)
#define NWB_SHADOW_RESOLVE_KERNEL_SIDE (NWB_SHADOW_RESOLVE_KERNEL_HALO + 1)
#define NWB_SHADOW_RESOLVE_KERNEL_WEIGHT_DENOMINATOR 16.0h
#define NWB_SHADOW_RESOLVE_KERNEL_WEIGHT_OUTER 1.0h
#define NWB_SHADOW_RESOLVE_KERNEL_WEIGHT_INNER 4.0h
#define NWB_SHADOW_RESOLVE_KERNEL_WEIGHT_CENTER 6.0h
#define NWB_SHADOW_RESOLVE_BSPLINE_CENTER_BASE 0.75h

// 5x5 B-spline a-trous kernel shared by independent and fused visibility filters.
static const half NWB_SHADOW_RESOLVE_KERNEL[NWB_SHADOW_RESOLVE_KERNEL_SIDE] = {
    half(NWB_SHADOW_RESOLVE_KERNEL_WEIGHT_OUTER / NWB_SHADOW_RESOLVE_KERNEL_WEIGHT_DENOMINATOR),
    half(NWB_SHADOW_RESOLVE_KERNEL_WEIGHT_INNER / NWB_SHADOW_RESOLVE_KERNEL_WEIGHT_DENOMINATOR),
    half(NWB_SHADOW_RESOLVE_KERNEL_WEIGHT_CENTER / NWB_SHADOW_RESOLVE_KERNEL_WEIGHT_DENOMINATOR),
    half(NWB_SHADOW_RESOLVE_KERNEL_WEIGHT_INNER / NWB_SHADOW_RESOLVE_KERNEL_WEIGHT_DENOMINATOR),
    half(NWB_SHADOW_RESOLVE_KERNEL_WEIGHT_OUTER / NWB_SHADOW_RESOLVE_KERNEL_WEIGHT_DENOMINATOR)
};

struct NwbShadowResolvePushConstants{
    // Must match ShadowResolvePushConstants in C++; resource slots select global heap views.
    uint width;
    uint height;
    uint halfWidth;
    uint halfHeight;
    uint stepWidth;
    uint stage;
    uint lightSlotStart;
    uint lightSlotCount;
    uint momentsValid; // May sample temporal moments only when nonzero.
    uint upsampleFold; // 0 overwrites opaque visibility; 1 multiplies transparent visibility and leaves background unchanged.
    uint geometrySlot;
    uint depthSlot;
    uint worldPositionSlot;
    uint normalSlot;
    uint inputColorSlot;
    uint momentsSlot;
    uint outputStorageSlot;
    uint visibilityStorageSlot;
    uint sceneShadingSlot;
    uint opaqueInputColorSlot; // Combined upsample reads the opaque half-resolution input from this slot.
    uint receiverFactor;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

