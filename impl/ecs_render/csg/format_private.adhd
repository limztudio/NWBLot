#include <impl/ecs_render/kernel/renderer_format_private.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const KernelFormatSupportMask s_CsgStorageFormatSupport = s_KernelFormatSupportTexture | s_KernelFormatSupportShaderUavStore;
const KernelFormatSupportMask s_CsgPeelFormatSupport = s_CsgStorageFormatSupport | s_KernelFormatSupportRenderTarget;

KernelFormat SelectCsgFormat(
    in KernelFormat candidate,
    in KernelFormatSupportMask requiredSupport,
    mut KernelDevice device
){
    Array<KernelFormat, 1u> candidates;
    candidates[0u] = candidate;
    return SelectKernelSupportedFormat(device, candidates, requiredSupport);
}


