////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<Optional<Name>> ResolveDeferredGraphQueueInternalIdleScope(in b8 queueValid, in u32 queueIndex){
    if(!queueValid)
        return Optional<Name>();

    const String scopeText = StringFormat("render.deferred_graph.queue_{}.internal_idle", queueIndex);
    const Expected<Name> parsedScope = ParseName(scopeText);
    if(!parsedScope.has_value())
        return MakeUnexpected(parsedScope.error());
    return Optional<Name>(parsedScope.value());
}


