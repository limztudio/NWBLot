}

void VerifyUiEditActionHostTests_ActivePreeditOwnsEnterAndFirstEscapeBeforeNumericCancel(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    ASSERT_EQ(self.m_textInput.preedit("가", 3u, 3u), TextInputAdmission::Accepted);
    ASSERT_TRUE(self.key(Key::Enter));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_TRUE(self.m_model.composition().active);
    EXPECT_FALSE(self.m_result.submitted);
    EXPECT_TRUE(self.m_actions.records.empty());
    ASSERT_TRUE(self.key(Key::Escape));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_FALSE(self.m_model.composition().active);
    EXPECT_FALSE(self.m_result.cancelled);
    EXPECT_TRUE(self.m_result.focused);
    EXPECT_TRUE(self.m_actions.records.empty());
    ASSERT_TRUE(self.key(Key::Escape));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_TRUE(self.m_result.cancelled);
    EXPECT_FALSE(self.m_result.focused);
    ASSERT_EQ(self.m_actions.records.size(), 1u);
    EXPECT_EQ(self.m_actions.records[0u].action, UiEditAction::Cancel);
}

void VerifyUiEditActionHostTests_FailedSubmitStopsLaterEventsAndKeepsPreviouslyAcceptedTargets(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    const u64 accepted = self.m_context.input().layoutGeneration();
