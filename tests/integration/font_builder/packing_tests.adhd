void Append16(in u16 value, mut AssetBytes bytes){
    bytes.push_back(cast<u8>(value >> 8u));
    bytes.push_back(cast<u8>(value));
}

void Append32(in u32 value, mut AssetBytes bytes){
    Append16(cast<u16>(value >> 16u), bytes);
    Append16(cast<u16>(value), bytes);
}

FontAtlasPositioningTable ClassPairFixture(mut AssetArena arena){
    FontAtlasPositioningTable table(arena);
    table.tag = s_FontAtlasGposTag;
    Append32(0x00010000u, table.bytes);
    Append16(10u, table.bytes);
    Append16(12u, table.bytes);
    Append16(26u, table.bytes);
    Append16(0u, table.bytes);
    Append16(1u, table.bytes);
    Append32(0x6b65726eu, table.bytes);
    Append16(8u, table.bytes);
    Append16(0u, table.bytes);
    Append16(1u, table.bytes);
    Append16(0u, table.bytes);
    Append16(1u, table.bytes);
    Append16(4u, table.bytes);
    Append16(2u, table.bytes);
    Append16(0u, table.bytes);
    Append16(1u, table.bytes);
    Append16(8u, table.bytes);
    Append16(2u, table.bytes);
    Append16(24u, table.bytes);
    Append16(4u, table.bytes);
    Append16(0u, table.bytes);
    Append16(30u, table.bytes);
    Append16(38u, table.bytes);
    Append16(2u, table.bytes);
    Append16(2u, table.bytes);
    Append16(0u, table.bytes);
    Append16(0u, table.bytes);
    Append16(cast<u16>(-20), table.bytes);
    Append16(cast<u16>(-40), table.bytes);
    Append16(1u, table.bytes);
    Append16(1u, table.bytes);
    Append16(1u, table.bytes);
    Append16(1u, table.bytes);
    Append16(1u, table.bytes);
    Append16(1u, table.bytes);
    Append16(1u, table.bytes);
    Append16(1u, table.bytes);
    Append16(2u, table.bytes);
    Append16(1u, table.bytes);
    Append16(1u, table.bytes);
    return table;
}

void VerifyFontAtlasPacking_RejectsInvalidBakeBoundsAndMissingPaths(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
    AssetArena arena(Name(s_FontBakeNameTestsFontAtlasOptions));
    BakeOptions options(arena);
    options.source = StringView("font.ttf");
    options.output = StringView("font.nwb");
    options.ppem = s_FontAtlasMinBakePpem - 1u;
    EXPECT_FALSE(ValidateOptions(options));
    options.ppem = s_FontAtlasMinBakePpem;
    options.source = StringView();
    EXPECT_FALSE(ValidateOptions(options));
    options.source = StringView("font.ttf");
    options.output = StringView();
    EXPECT_FALSE(ValidateOptions(options));
    EXPECT_EQ(logger.errorCount(), 3u);
    EXPECT_EQ(ComputeBakePixelCapacity(2048u, 8u), cast<u64>(128u) * 1024u * 1024u);
}

void VerifyFontAtlasPacking_TightRectanglesAndAllChannelCountsPreserveGuardedPixels(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    AssetArena arena(Name(s_FontBakeNameTestsFontAtlasPacking));
    ScratchArena scratch(Name(s_FontBakeNameTestsFontAtlasPackingScratch));
    BakeOptions options(arena);
    options.extent = 32u;
    options.maxGroups = 2u;
    for(u32 tailChannels = 1u; tailChannels <= 4u; ++tailChannels){
        RasterGlyphs glyphs(arena);
        for(u32 index = 0u; index < 4u + tailChannels; ++index){
            glyphs.emplace_back(arena);
            mut RasterGlyph glyph = glyphs.back();
            glyph.record.glyphId = index;
            glyph.record.drawable = 1u;
            glyph.record.width = 28u;
            glyph.record.height = 29u;
            glyph.pixels.resize(28u * 29u, cast<u8>((index + 1u) * 17u));
        }
        FontAtlasPayload payload(arena);
        ASSERT_TRUE(PackGlyphs(options, glyphs, scratch, payload));
        ASSERT_EQ(payload.groups.size(), 2u);
        EXPECT_EQ(payload.groups[0u].channelCount, 4u);
        EXPECT_EQ(payload.groups[1u].channelCount, tailChannels);
        for(usize groupIndex = 0u; groupIndex < payload.groups.size(); ++groupIndex){
            in FontAtlasGroup group = payload.groups[groupIndex];
            EXPECT_EQ(group.width, 30u);
            EXPECT_EQ(group.height, 31u);
            EXPECT_EQ(group.pixels.size(), 30u * 31u * group.channelCount);
        }
        for(u32 index = 0u; index < glyphs.size(); ++index){
            in FontAtlasGlyph glyph = payload.glyphs[index];
            EXPECT_EQ(glyph.group, index / 4u);
            EXPECT_EQ(glyph.channel, index % 4u);
            EXPECT_EQ(glyph.x, 1u);
            EXPECT_EQ(glyph.y, 1u);
            in FontAtlasGroup group = payload.groups[glyph.group];
            for(u32 y = 0u; y < group.height; ++y){
                for(u32 x = 0u; x < group.width; ++x){
                    const b8 guard = x == 0u || y == 0u || x + 1u == group.width || y + 1u == group.height;
                    u8 expected = cast<u8>((index + 1u) * 17u);
                    if(guard)
                        expected = 0u;
                    EXPECT_EQ(group.pixels[(y * group.width + x) * group.channelCount + glyph.channel], expected);
                }
            }
        }
    }
}

void VerifyFontAtlasPacking_RejectsCapacityWithoutDroppingGlyphs(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    AssetArena arena(Name(s_FontBakeNameTestsFontAtlasCapacity));
    ScratchArena scratch(Name(s_FontBakeNameTestsFontAtlasCapacityScratch));
    BakeOptions options(arena);
    options.extent = 32u;
    options.maxGroups = 1u;
    RasterGlyphs glyphs(arena);
    for(u32 index = 0u; index < 5u; ++index){
        glyphs.emplace_back(arena);
        mut RasterGlyph glyph = glyphs.back();
        glyph.record.glyphId = index;
        glyph.record.drawable = 1u;
        glyph.record.width = 28u;
        glyph.record.height = 28u;
        glyph.pixels.resize(28u * 28u, 128u);
    }
    FontAtlasPayload payload(arena);
    EXPECT_FALSE(PackGlyphs(options, glyphs, scratch, payload));
}

void VerifyFontAtlasPositioning_LegacyPairsStayBoundedAndSorted(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    AssetArena arena(Name(s_FontBakeNameTestsFontAtlasKern));
    FontAtlasPositioningTable table(arena);
    table.tag = s_FontAtlasKernTag;
    Append16(0u, table.bytes);
    Append16(1u, table.bytes);
    Append16(0u, table.bytes);
    Append16(20u, table.bytes);
    Append16(1u, table.bytes);
    Append16(1u, table.bytes);
    Append16(6u, table.bytes);
    Append16(0u, table.bytes);
    Append16(0u, table.bytes);
    Append16(1u, table.bytes);
    Append16(2u, table.bytes);
    Append16(cast<u16>(-40), table.bytes);
    EXPECT_TRUE(ValidateFontAtlasPositioningTableBytes(table.tag, table.bytes, 3u));
    EXPECT_FALSE(ValidateFontAtlasPositioningTableBytes(table.tag, table.bytes, 2u));
    table.bytes.pop_back();
    EXPECT_FALSE(ValidateFontAtlasPositioningTableBytes(table.tag, table.bytes, 3u));
}

void VerifyFontAtlasPositioning_GposClassZeroAndExplicitClassMatrixPreserved(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    AssetArena arena(Name(s_FontBakeNameTestsFontAtlasGpos));
    FontAtlasPositioningTable table = ClassPairFixture(arena);
    ASSERT_EQ(table.bytes.size(), 84u);
    EXPECT_TRUE(ValidateFontAtlasPositioningTableBytes(table.tag, table.bytes, 3u));
    table.bytes[75u] = 2u;
    EXPECT_FALSE(ValidateFontAtlasPositioningTableBytes(table.tag, table.bytes, 3u));
    table.bytes[75u] = 1u;
    table.bytes[53u] = 255u;
    EXPECT_FALSE(ValidateFontAtlasPositioningTableBytes(table.tag, table.bytes, 3u));
}

void VerifyFontAtlasPositioning_TruncatedGdefMarkGlyphSetsAreRejected(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    AssetArena arena(Name(s_FontBakeNameTestsFontAtlasGdefTruncated));
    FontAtlasPositioningTable table(arena);
    table.tag = s_FontAtlasGdefTag;
    for(u16 minor = 2u; minor <= 3u; ++minor){
        table.bytes.clear();
        Append16(1u, table.bytes);
        Append16(minor, table.bytes);
        for(u32 field = 0u; field < 4u; ++field)
            Append16(0u, table.bytes);
        Append16(0xffffu, table.bytes);
        if(minor == 3u)
            Append32(0u, table.bytes);
        EXPECT_FALSE(ValidateFontAtlasPositioningTableBytes(table.tag, table.bytes, 3u));
    }
}

void VerifyFontAtlasPositioning_MalformedTopOffsetsAndExtensionTypeRejected(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    AssetArena arena(Name(s_FontBakeNameTestsFontAtlasGposMalformed));
    FontAtlasPositioningTable table = ClassPairFixture(arena);
    table.bytes[8u] = 255u;
    EXPECT_FALSE(ValidateFontAtlasPositioningTableBytes(table.tag, table.bytes, 3u));
    table = ClassPairFixture(arena);
    table.bytes[31u] = 9u;
    EXPECT_FALSE(ValidateFontAtlasPositioningTableBytes(table.tag, table.bytes, 3u));
}

void VerifyFontAtlasPositioning_PairSetDeviceOffsetsUseImmediateParent(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    AssetArena arena(Name(s_FontBakeNameTestsFontAtlasGposDevice));
    FontAtlasPositioningTable table = ClassPairFixture(arena);
    table.bytes.resize(38u);
    Append16(1u, table.bytes);
    Append16(28u, table.bytes);
    Append16(0x0044u, table.bytes);
    Append16(0u, table.bytes);
    Append16(1u, table.bytes);
    Append16(12u, table.bytes);
    Append16(1u, table.bytes);
    Append16(2u, table.bytes);
    Append16(cast<u16>(-40), table.bytes);
    Append16(8u, table.bytes);
    Append16(8u, table.bytes);
    Append16(10u, table.bytes);
    Append16(1u, table.bytes);
    Append16(0u, table.bytes);
    Append16(1u, table.bytes);
    Append16(1u, table.bytes);
    Append16(1u, table.bytes);
    ASSERT_EQ(table.bytes.size(), 72u);
    EXPECT_TRUE(ValidateFontAtlasPositioningTableBytes(table.tag, table.bytes, 3u));
    table.bytes[57u] = 24u;
    EXPECT_FALSE(ValidateFontAtlasPositioningTableBytes(table.tag, table.bytes, 3u));
}

NWB_ADHD_GTEST(FontAtlasPacking, RejectsInvalidBakeBoundsAndMissingPaths, VerifyFontAtlasPacking_RejectsInvalidBakeBoundsAndMissingPaths)
NWB_ADHD_GTEST(FontAtlasPacking, TightRectanglesAndAllChannelCountsPreserveGuardedPixels, VerifyFontAtlasPacking_TightRectanglesAndAllChannelCountsPreserveGuardedPixels)
NWB_ADHD_GTEST(FontAtlasPacking, RejectsCapacityWithoutDroppingGlyphs, VerifyFontAtlasPacking_RejectsCapacityWithoutDroppingGlyphs)
NWB_ADHD_GTEST(FontAtlasPositioning, LegacyPairsStayBoundedAndSorted, VerifyFontAtlasPositioning_LegacyPairsStayBoundedAndSorted)
NWB_ADHD_GTEST(FontAtlasPositioning, GposClassZeroAndExplicitClassMatrixPreserved, VerifyFontAtlasPositioning_GposClassZeroAndExplicitClassMatrixPreserved)
NWB_ADHD_GTEST(FontAtlasPositioning, TruncatedGdefMarkGlyphSetsAreRejected, VerifyFontAtlasPositioning_TruncatedGdefMarkGlyphSetsAreRejected)
NWB_ADHD_GTEST(FontAtlasPositioning, MalformedTopOffsetsAndExtensionTypeRejected, VerifyFontAtlasPositioning_MalformedTopOffsetsAndExtensionTypeRejected)
NWB_ADHD_GTEST(FontAtlasPositioning, PairSetDeviceOffsetsUseImmediateParent, VerifyFontAtlasPositioning_PairSetDeviceOffsetsUseImmediateParent)


