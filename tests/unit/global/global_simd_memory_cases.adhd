#include <tests/common/gtest_macros.adhd>
#include <tests/common/simd_memory_guard_fixture.adhd>
#include <tests/common/test_context.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_BufferBytes = 9216u;
const usize s_GuardBytes = 64u;
const u8 s_Poison = 0xA5u;
const Array<b8, 2u> s_Directions = Array<b8, 2u>(false, true);
const Array<usize, 34u> s_Lengths = Array<usize, 34u>(
    0u, 1u, 2u, 3u, 7u, 8u, 9u, 15u, 16u, 17u, 31u, 32u, 33u, 47u, 48u, 49u, 63u, 64u,
    65u, 127u, 128u, 129u, 255u, 256u, 257u, 511u, 512u, 513u, 4095u, 4096u, 4097u, 8191u, 8192u, 8193u
);

[layout(64)]
class AlignedBytes<const usize Count>{
    public Array<u8, Count> bytes;
}

[layout(16)]
class AlignedPacket{
    public Array<u64, 4u> raw = Array<u64, 4u>();
}

u64 PacketLaneBits(in usize packetIndex, in usize laneIndex){
    return 0xDEADBEEF80000000ull ^ (cast<u64>(packetIndex + 1u) << 32u) ^ (cast<u64>(laneIndex + 1u) * 0x01020304ull);
}

usize AppendedIndex(in usize index, in usize initialSize){
    if(index < initialSize)
        return index;
    return 3u + index - initialSize;
}

usize EdgeOffset(in b8 atEnd, in usize offset){
    if(atEnd)
        return offset;
    return 0u;
}

void TryRejectedCopy(in ByteAddress destination, in usize capacity, in ByteAddress source, in usize count){
    if(!SetSignalHandler(ProcessSignal::Abort, ExitOnAbort))
        ExitImmediately(s_SIMDMemoryHandlerFailureExitCode);
    CopyTestBytes(destination, capacity, source, count);
    ExitImmediately(s_SIMDMemoryReturnedExitCode);
}

void ExpectRejectedCopy(in ByteAddress destination, in usize capacity, in ByteAddress source, in usize count){
    EXPECT_EXIT(TryRejectedCopy(destination, capacity, source, count), ExitedWithCode(s_SIMDMemoryAbortExitCode), "");
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifySIMDMemory_AlignedCacheLineOffsetsAndVectorBoundaryTailsPreserveExactRanges(){
    usize testedCombinations = 0u;
    usize rangeMismatches = 0u;
    b8 sourceUnmodified = false;
    AlignedBytes<s_BufferBytes> sourceBuffer = AlignedBytes<s_BufferBytes>();
    mut Array<u8, s_BufferBytes> source = sourceBuffer.bytes;
    AlignedBytes<s_BufferBytes> destinationBuffer = AlignedBytes<s_BufferBytes>();
    mut Array<u8, s_BufferBytes> destination = destinationBuffer.bytes;
    Array<u8, s_BufferBytes> expected;
    Array<u8, s_BufferBytes> original;
    for(usize index = 0u; index < s_BufferBytes; ++index)
        source[index] = original[index] = PatternByte(index);

    for(in usize count : s_Lengths){
        for(usize sourceOffset = 0u; sourceOffset < 128u; sourceOffset += s_SIMDMemoryCopyAlignment){
            for(usize destinationOffset = 0u; destinationOffset < 128u; destinationOffset += s_SIMDMemoryCopyAlignment){
                FillTestBytes(WritableBytesStart(destination), s_Poison, destination.size());
                FillTestBytes(WritableBytesStart(expected), s_Poison, expected.size());
                const usize sourceStart = s_GuardBytes + sourceOffset;
                const usize destinationStart = s_GuardBytes + destinationOffset;
                for(usize index = 0u; index < count; ++index)
                    expected[destinationStart + index] = original[sourceStart + index];
                const usize runtimeCount = ObserveValue<usize>(count);
                MacroCopyTestBytes(GuardAddress(WritableBytesStart(destination), destinationStart), count, GuardAddress(WritableBytesStart(source), sourceStart), runtimeCount);
                ++testedCombinations;
                if(!BytesMatch(Span<u8>(destination), Span<u8>(expected))){
                    ++rangeMismatches;
                    ScopedTestTrace countTrace(count);
                    ScopedTestTrace sourceOffsetTrace(sourceOffset);
                    ScopedTestTrace destinationOffsetTrace(destinationOffset);
                    ADD_FAILURE();
                }
            }
        }
    }
    sourceUnmodified = BytesMatch(Span<u8>(source), Span<u8>(original));
    EXPECT_EQ(testedCombinations, 34u * 8u * 8u);
    EXPECT_EQ(rangeMismatches, 0u);
    EXPECT_TRUE(sourceUnmodified);
}

void VerifySIMDMemory_AlignedVectorAliasedAppendReallocationAndOverlappingAssignmentPreserveRawPackets(){
    usize initialSize = 0u;
    usize appendedSize = 0u;
    usize appendedCapacity = 0u;
    b8 reallocated = false;
    usize appendMismatches = 0u;
    usize assignedSize = 0u;
    usize assignMismatches = 0u;

    Vector<AlignedPacket> packets = Vector<AlignedPacket>();
    packets.reserve(32u);
    initialSize = packets.capacity();
    packets.resize(initialSize);
    for(usize packetIndex = 0u; packetIndex < initialSize; ++packetIndex){
        for(usize laneIndex = 0u; laneIndex < packets[packetIndex].raw.size(); ++laneIndex)
            packets[packetIndex].raw[laneIndex] = PacketLaneBits(packetIndex, laneIndex);
    }

    const usize oldAddress = ObjectAddressKey(packets[0u]);
    const Span<AlignedPacket> appended = Span<AlignedPacket>(packets).subspan(3u, 16u);
    AppendTriviallyCopyableVector(packets, appended);
    appendedSize = packets.size();
    appendedCapacity = packets.capacity();
    reallocated = ObjectAddressKey(packets[0u]) != oldAddress;
    for(usize packetIndex = 0u; packetIndex < packets.size(); ++packetIndex){
        const usize originalIndex = AppendedIndex(packetIndex, initialSize);
        for(usize laneIndex = 0u; laneIndex < packets[packetIndex].raw.size(); ++laneIndex){
            if(packets[packetIndex].raw[laneIndex] != PacketLaneBits(originalIndex, laneIndex)){
                ++appendMismatches;
                ScopedTestTrace packetIndexTrace(packetIndex);
                ScopedTestTrace laneIndexTrace(laneIndex);
                ADD_FAILURE();
            }
        }
    }

    const usize middleOffset = initialSize - 8u;
    const Span<AlignedPacket> assignedMiddle = Span<AlignedPacket>(packets).subspan(middleOffset, 16u);
    AssignTriviallyCopyableVector(packets, assignedMiddle);
    assignedSize = packets.size();
    for(usize packetIndex = 0u; packetIndex < packets.size(); ++packetIndex){
        const usize priorIndex = middleOffset + packetIndex;
        const usize originalIndex = AppendedIndex(priorIndex, initialSize);
        for(usize laneIndex = 0u; laneIndex < packets[packetIndex].raw.size(); ++laneIndex){
            if(packets[packetIndex].raw[laneIndex] != PacketLaneBits(originalIndex, laneIndex)){
                ++assignMismatches;
                ScopedTestTrace packetIndexTrace(packetIndex);
                ScopedTestTrace laneIndexTrace(laneIndex);
                ADD_FAILURE();
            }
        }
    }

    ASSERT_EQ(appendedSize, initialSize + 16u);
    EXPECT_GT(appendedCapacity, initialSize);
    EXPECT_TRUE(reallocated);
    EXPECT_EQ(appendMismatches, 0u);
    ASSERT_EQ(assignedSize, 16u);
    EXPECT_EQ(assignMismatches, 0u);
}

void VerifySIMDMemory_AdjacentRangesInOneLiveByteArrayAreAcceptedWithoutClobberingGuards(){
    Array<usize, 7> adjacentLengths = Array<usize, 7>();
    adjacentLengths[0u] = 16u;
    adjacentLengths[1u] = 32u;
    adjacentLengths[2u] = 48u;
    adjacentLengths[3u] = 64u;
    adjacentLengths[4u] = 128u;
    adjacentLengths[5u] = 256u;
    adjacentLengths[6u] = 4096u;
    Array<b8, 2> directions = Array<b8, 2>();
    directions[0u] = false;
    directions[1u] = true;

    for(in usize count : adjacentLengths){
        for(in b8 destinationFirst : directions){
            b8 matched = false;
            AlignedBytes<s_BufferBytes> bytesBuffer = AlignedBytes<s_BufferBytes>();
            mut Array<u8, s_BufferBytes> bytes = bytesBuffer.bytes;
            Array<u8, s_BufferBytes> expected;
            for(usize index = 0u; index < s_BufferBytes; ++index)
                bytes[index] = expected[index] = PatternByte(index);
            const usize destinationStart = s_GuardBytes + EdgeOffset(!destinationFirst, count);
            const usize sourceStart = s_GuardBytes + EdgeOffset(destinationFirst, count);
            for(usize index = 0u; index < count; ++index)
                expected[destinationStart + index] = PatternByte(sourceStart + index);
            const usize runtimeCount = ObserveValue<usize>(count);
            CopyTestBytes(GuardAddress(WritableBytesStart(bytes), destinationStart), count, GuardAddress(WritableBytesStart(bytes), sourceStart), runtimeCount);
            matched = BytesMatch(Span<u8>(bytes), Span<u8>(expected));
            EXPECT_TRUE(matched);
        }
    }
}

void VerifySIMDMemory_ProtectedPageEdgesRejectOverreadsUnderreadsAndOutOfRangeStores(){
    b8 supported = false;
    b8 guardsAllocated = false;
    usize sourceAccessible = 0u;
    usize destinationAccessible = 0u;
    usize maxTestLength = 0u;
    usize mismatchCount = 0u;
    usize sourceMutationCount = 0u;

    supported = s_HasVirtualPages;
    maxTestLength = s_Lengths[s_Lengths.size() - 1u];
    GuardedBytes source = GuardedBytes();
    GuardedBytes destination = GuardedBytes();
    guardsAllocated = HasByteAddress(source.data) && HasByteAddress(destination.data);
    sourceAccessible = source.accessibleBytes;
    destinationAccessible = destination.accessibleBytes;
    if(guardsAllocated && sourceAccessible == destinationAccessible && sourceAccessible >= maxTestLength){
        for(usize index = 0u; index < source.accessibleBytes; ++index)
            StoreByte(source.data, index, PatternByte(index));

        for(usize lengthIndex = 1u; lengthIndex <= s_Lengths.size(); ++lengthIndex){
            usize count = source.accessibleBytes;
            if(lengthIndex < s_Lengths.size())
                count = s_Lengths[lengthIndex];
            for(in b8 sourceAtEnd : s_Directions){
                for(in b8 destinationAtEnd : s_Directions){
                    FillTestBytes(destination.data, s_Poison, destination.accessibleBytes);
                    const usize sourceStart = EdgeOffset(sourceAtEnd, (source.accessibleBytes - count) & ~(s_SIMDMemoryCopyAlignment - 1u));
                    const usize destinationStart = EdgeOffset(destinationAtEnd, (destination.accessibleBytes - count) & ~(s_SIMDMemoryCopyAlignment - 1u));
                    const usize runtimeCount = ObserveValue<usize>(count);
                    CopyTestBytes(GuardAddress(destination.data, destinationStart), count, GuardAddress(source.data, sourceStart), runtimeCount);
                    for(usize index = 0u; index < destination.accessibleBytes; ++index){
                        u8 expected = s_Poison;
                        if(index >= destinationStart && index - destinationStart < count)
                            expected = PatternByte(sourceStart + index - destinationStart);
                        if(LoadByte(destination.data, index) != expected){
                            ++mismatchCount;
                            ScopedTestTrace countTrace(count);
                            ScopedTestTrace sourceAtEndTrace(sourceAtEnd);
                            ScopedTestTrace destinationAtEndTrace(destinationAtEnd);
                            ScopedTestTrace indexTrace(index);
                            ADD_FAILURE();
                        }
                    }
                }
            }
        }
        for(usize index = 0u; index < source.accessibleBytes; ++index){
            if(LoadByte(source.data, index) != PatternByte(index)){
                ++sourceMutationCount;
                ScopedTestTrace indexTrace(index);
                ADD_FAILURE();
            }
        }
    }

    if(!supported){
        GTEST_SKIP();
        return;
    }

    ASSERT_TRUE(guardsAllocated);
    ASSERT_EQ(sourceAccessible, destinationAccessible);
    ASSERT_GE(sourceAccessible, maxTestLength);
    EXPECT_EQ(mismatchCount, 0u);
    EXPECT_EQ(sourceMutationCount, 0u);
}

void VerifySIMDMemory_ZeroLengthAllowsNullOnePastAndInaccessiblePointersWithoutAccess(){
    b8 guardsAllocated = true;
    Array<u8, 3> observedBytes = Array<u8, 3>();
    AlignedBytes<3u> bytesBuffer = AlignedBytes<3u>();
    mut Array<u8, 3u> bytes = bytesBuffer.bytes;
    bytes = Array<u8, 3u>(0x12u, 0x34u, 0x56u);
    const usize zero = ObserveValue<usize>(0u);
    CopyTestBytes(ByteAddress(), 0u, ByteAddress(), zero);
    MacroCopyTestBytes(GuardAddress(WritableBytesStart(bytes), bytes.size()), 0u, ByteAddress(), zero);
    CopyTestBytes(ByteAddress(), usize.max, GuardAddress(WritableBytesStart(bytes), bytes.size()), zero);
    CopyTestBytes(WritableBytesStart(bytes), 0u, WritableBytesStart(bytes), zero);
    GuardedBytes guarded = GuardedBytes();
    guardsAllocated = !s_HasVirtualPages || HasByteAddress(guarded.data);
    if(s_HasVirtualPages && guardsAllocated){
        MacroCopyTestBytes(guarded.mapping, 0u, GuardAddress(guarded.data, guarded.accessibleBytes), zero);
        CopyTestBytes(GuardAddress(guarded.data, guarded.accessibleBytes), usize.max, guarded.mapping, zero);
        CopyTestBytes(GuardAddress(guarded.mapping, 1u), 0u, GuardAddress(guarded.data, guarded.accessibleBytes + 8u), zero);
    }
    observedBytes[0u] = bytes[0u];
    observedBytes[1u] = bytes[1u];
    observedBytes[2u] = bytes[2u];
    ASSERT_TRUE(guardsAllocated);
    EXPECT_EQ(observedBytes[0u], 0x12u);
    EXPECT_EQ(observedBytes[1u], 0x34u);
    EXPECT_EQ(observedBytes[2u], 0x56u);
}

void VerifySIMDMemory_InvalidCapacityNullAlignmentHugeCountsAndOverlapAbortBeforeRangeAccess(){
    b8 supported = false;
    b8 guardsAllocated = false;
    usize unalignedOffsetCount = 0u;
    supported = s_HasVirtualPages;
    GuardedBytes guarded = GuardedBytes();
    guardsAllocated = HasByteAddress(guarded.data);
    if(guardsAllocated){
        const ByteAddress inaccessible = guarded.lowerGuard;
        const ByteAddress upperGuard = guarded.upperGuard;
        ExpectRejectedCopy(inaccessible, 0u, upperGuard, 1u);
        ExpectRejectedCopy(inaccessible, 15u, upperGuard, 16u);
        ExpectRejectedCopy(inaccessible, 1u, upperGuard, usize.max);
        ExpectRejectedCopy(inaccessible, usize.max, upperGuard, usize.max);
        ExpectRejectedCopy(ByteAddress(), 1u, upperGuard, 1u);
        ExpectRejectedCopy(inaccessible, 1u, ByteAddress(), 1u);
        ExpectRejectedCopy(inaccessible, 32u, inaccessible, 32u);
        ExpectRejectedCopy(GuardAddress(inaccessible, 16u), 32u, inaccessible, 32u);
        ExpectRejectedCopy(inaccessible, 32u, GuardAddress(inaccessible, 16u), 32u);
        for(usize offset = 1u; offset < 32u; ++offset){
            if(offset % s_SIMDMemoryCopyAlignment == 0u)
                continue;
            ++unalignedOffsetCount;
            ExpectRejectedCopy(GuardAddress(inaccessible, offset), 16u, upperGuard, 16u);
            ExpectRejectedCopy(inaccessible, 16u, GuardAddress(upperGuard, offset), 16u);
        }
        ExpectRejectedCopy(GuardAddress(inaccessible, 8u), 16u, GuardAddress(upperGuard, 8u), 16u);
    }

    if(!supported){
        GTEST_SKIP();
        return;
    }

    ASSERT_TRUE(guardsAllocated);
    EXPECT_EQ(unalignedOffsetCount, 30u);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_ADHD_GTEST(SIMDMemory, AlignedCacheLineOffsetsAndVectorBoundaryTailsPreserveExactRanges, VerifySIMDMemory_AlignedCacheLineOffsetsAndVectorBoundaryTailsPreserveExactRanges)
NWB_ADHD_GTEST(SIMDMemory, AlignedVectorAliasedAppendReallocationAndOverlappingAssignmentPreserveRawPackets, VerifySIMDMemory_AlignedVectorAliasedAppendReallocationAndOverlappingAssignmentPreserveRawPackets)
NWB_ADHD_GTEST(SIMDMemory, AdjacentRangesInOneLiveByteArrayAreAcceptedWithoutClobberingGuards, VerifySIMDMemory_AdjacentRangesInOneLiveByteArrayAreAcceptedWithoutClobberingGuards)
NWB_ADHD_GTEST(SIMDMemory, ProtectedPageEdgesRejectOverreadsUnderreadsAndOutOfRangeStores, VerifySIMDMemory_ProtectedPageEdgesRejectOverreadsUnderreadsAndOutOfRangeStores)
NWB_ADHD_GTEST(SIMDMemory, ZeroLengthAllowsNullOnePastAndInaccessiblePointersWithoutAccess, VerifySIMDMemory_ZeroLengthAllowsNullOnePastAndInaccessiblePointersWithoutAccess)
NWB_ADHD_GTEST(SIMDMemory, InvalidCapacityNullAlignmentHugeCountsAndOverlapAbortBeforeRangeAccess, VerifySIMDMemory_InvalidCapacityNullAlignmentHugeCountsAndOverlapAbortBeforeRangeAccess)


