#include "validation.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ReportPaintClipRecordingOff(){
    error("PaintSystem: paint clip pushed while recording is off");
}

void ReportPaintClipPopRecordingOff(){
    error("PaintSystem: paint clip popped while recording is off");
}

void ReportPaintQuadRecordingOff(){
    error("PaintSystem: paint quad emitted while recording is off");
}

void ReportPaintQuadInvalidColor(){
    error("PaintSystem: paint quad color is invalid");
}

void ReportPaintLineRecordingOff(){
    error("PaintSystem: paint line emitted while recording is off");
}

void ReportPaintLineInvalidColor(){
    error("PaintSystem: paint line color is invalid");
}

void ReservePaintSnapshot(
    in usize quadCount,
    in usize clipDepth,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut Vector<PaintClipEntry> clips
){
    if(quadCount > cast<usize>(u32.max / s_PaintQuadIndexCount) || clipDepth == usize.max){
        assert(false);
        return;
    }
    vertices.reserve(quadCount * cast<usize>(s_PaintQuadVertexCount));
    indices.reserve(quadCount * cast<usize>(s_PaintQuadIndexCount));
    commands.reserve(quadCount);
    clips.reserve(clipDepth + 1u);
}

PaintClipEntry ComputeIntersectedPaintClipEntry(in PaintClipEntry parent, in Rect clip, in b8 validateParent){
    PaintClipEntry next;
    if(parent.rect.width < 0.0f || parent.rect.height < 0.0f || clip.width < 0.0f || clip.height < 0.0f)
        return next;
    const f32 clipRight = clip.x + clip.width;
    const f32 clipBottom = clip.y + clip.height;
    if(!IsFinite(clip.x) || !IsFinite(clip.y) || !IsFinite(clipRight) || !IsFinite(clipBottom))
        return next;
    if(validateParent && (!IsFinite(parent.right) || !IsFinite(parent.bottom)))
        return next;
    f32 x0 = clip.x;
    if(parent.rect.x > x0)
        x0 = parent.rect.x;
    f32 y0 = clip.y;
    if(parent.rect.y > y0)
        y0 = parent.rect.y;
    f32 x1 = clipRight;
    if(parent.right < x1)
        x1 = parent.right;
    f32 y1 = clipBottom;
    if(parent.bottom < y1)
        y1 = parent.bottom;
    f32 w = x1 - x0;
    f32 h = y1 - y0;
    if(!(w > 0.0f))
        w = 0.0f;
    if(!(h > 0.0f))
        h = 0.0f;
    if(IsFinite(w) && IsFinite(h)){
        next.rect = Rect(x0, y0, w, h);
        next.right = x0 + w;
        next.bottom = y0 + h;
    }
    return next;
}

void PushPaintClip(in b8 recording, in Rect clip, mut Vector<PaintClipEntry> clips){
    if(!recording){
        ReportPaintClipRecordingOff();
        return;
    }
    clips.push_back(ComputeIntersectedPaintClipEntry(clips.back(), clip, true));
}

void PushPaintClipValidatedParent(in b8 recording, in Rect clip, mut Vector<PaintClipEntry> clips){
    if(!recording){
        ReportPaintClipRecordingOff();
        return;
    }
    clips.push_back(ComputeIntersectedPaintClipEntry(clips.back(), clip, false));
}

b8 PopPaintClip(
    in b8 recording,
    in usize overlayDepth,
    in Array<PaintOverlayFrame, s_PaintMaxOverlayDepth> overlays,
    mut Vector<PaintClipEntry> clips
){
    if(!recording){
        ReportPaintClipPopRecordingOff();
        return false;
    }
    if(clips.size() <= 1u || (overlayDepth != 0u && clips.size() <= overlays[overlayDepth - 1u].clipDepth + 1u))
        return false;
    clips.pop_back();
    return true;
}

b8 BeginPaintOverlay(
    in b8 recording,
    in u32 layer,
    in DisplayMetrics display,
    mut Array<PaintOverlayFrame, s_PaintMaxOverlayDepth> overlays,
    mut usize inOutOverlayDepth,
    mut u32 inOutLayer,
    mut Vector<PaintClipEntry> clips
){
    if(!recording || layer == 0u || inOutOverlayDepth == s_PaintMaxOverlayDepth)
        return false;
    PaintOverlayFrame frame;
    frame.clipDepth = clips.size();
    frame.layer = inOutLayer;
    overlays[inOutOverlayDepth] = frame;
    ++inOutOverlayDepth;
    PaintClipEntry rootClip;
    rootClip.rect = Rect(0.0f, 0.0f, display.logicalWidth, display.logicalHeight);
    rootClip.right = display.logicalWidth;
    rootClip.bottom = display.logicalHeight;
    clips.push_back(rootClip);
    inOutLayer = layer;
    return true;
}

b8 EndPaintOverlay(
    in b8 recording,
    in Array<PaintOverlayFrame, s_PaintMaxOverlayDepth> overlays,
    mut usize inOutOverlayDepth,
    mut u32 outLayer,
    mut Vector<PaintClipEntry> clips
){
    if(!recording || inOutOverlayDepth == 0u || clips.size() != overlays[inOutOverlayDepth - 1u].clipDepth + 1u)
        return false;
    clips.pop_back();
    --inOutOverlayDepth;
    outLayer = overlays[inOutOverlayDepth].layer;
    return true;
}

void EmitPaintQuadImpl(
    in b8 recording,
    in b8 clipValidated,
    in PaintClipEntry clipEntry,
    in Rect rectangle,
    in Rect uv,
    in Color color,
    in PaintMaterial material,
    in u32 layer,
    in u32 glyphPageIndex,
    in u32 sdfPageIndex,
    in u32 sdfChannel,
    in u32 textureImageIndex,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered,
    mut b8 inOutCommandsStrictlyDescending
){
    if(!recording){
        ReportPaintQuadRecordingOff();
        return;
    }
    if(!IsFinite(color.r) || !IsFinite(color.g) || !IsFinite(color.b) || !IsFinite(color.a) || color.a < 0.0f || color.a > 1.0f){
        ReportPaintQuadInvalidColor();
        return;
    }
    if(!(rectangle.width > 0.0f) || !(rectangle.height > 0.0f) || !(clipEntry.rect.width > 0.0f) || !(clipEntry.rect.height > 0.0f))
        return;
    const f32 rectRight = rectangle.x + rectangle.width;
    const f32 rectBottom = rectangle.y + rectangle.height;
    if(!IsFinite(rectRight) || !IsFinite(rectBottom))
        return;
    if(!clipValidated && (!IsFinite(clipEntry.right) || !IsFinite(clipEntry.bottom)))
        return;
    f32 x0 = rectangle.x;
    if(clipEntry.rect.x > x0)
        x0 = clipEntry.rect.x;
    f32 y0 = rectangle.y;
    if(clipEntry.rect.y > y0)
        y0 = clipEntry.rect.y;
    f32 x1 = rectRight;
    if(clipEntry.right < x1)
        x1 = clipEntry.right;
    f32 y1 = rectBottom;
    if(clipEntry.bottom < y1)
        y1 = clipEntry.bottom;
    const f32 visW = x1 - x0;
    const f32 visH = y1 - y0;
    if(!(visW > 0.0f) || !(visH > 0.0f) || !IsFinite(visW) || !IsFinite(visH) || color.a <= 0.0f)
        return;
    const f32 visEndX = x0 + visW;
    const f32 visEndY = y0 + visH;
    if(!IsFinite(visEndX) || !IsFinite(visEndY))
        return;
    if(vertices.size() > cast<usize>(u32.max - s_PaintQuadVertexCount) || indices.size() > cast<usize>(u32.max - s_PaintQuadIndexCount)){
        assert(false);
        return;
    }
    f32 left = 0.0f;
    f32 top = 0.0f;
    f32 right = 0.0f;
    f32 bottom = 0.0f;
    if(material != PaintMaterial::Solid && (uv.width != 0.0f || uv.height != 0.0f || uv.x != 0.0f || uv.y != 0.0f)){
        if(x0 == rectangle.x && y0 == rectangle.y && visW == rectangle.width && visH == rectangle.height && visEndX == rectRight && visEndY == rectBottom){
            left = uv.x;
            top = uv.y;
            right = uv.x + uv.width;
            bottom = uv.y + uv.height;
        }
        else{
            left = (x0 - rectangle.x) / rectangle.width * uv.width + uv.x;
            top = (y0 - rectangle.y) / rectangle.height * uv.height + uv.y;
            right = (visEndX - rectangle.x) / rectangle.width * uv.width + uv.x;
            bottom = (visEndY - rectangle.y) / rectangle.height * uv.height + uv.y;
        }
    }
    Color premultiplied = color;
    if(color.a != 1.0f)
        premultiplied = Color(color.r * color.a, color.g * color.a, color.b * color.a, color.a);
    const u32 vertexBase = cast<u32>(vertices.size());
    const u32 firstIndex = cast<u32>(indices.size());
    vertices.push_back(Vertex(Point(x0, y0), Point(left, top), premultiplied));
    vertices.push_back(Vertex(Point(visEndX, y0), Point(right, top), premultiplied));
    vertices.push_back(Vertex(Point(visEndX, visEndY), Point(right, bottom), premultiplied));
    vertices.push_back(Vertex(Point(x0, visEndY), Point(left, bottom), premultiplied));
    indices.push_back(vertexBase);
    indices.push_back(vertexBase + 1u);
    indices.push_back(vertexBase + 2u);
    indices.push_back(vertexBase);
    indices.push_back(vertexBase + 2u);
    indices.push_back(vertexBase + 3u);
    if(!commands.empty()){
        const usize lastIndex = commands.size() - 1u;
        in DrawCommand previous = commands[lastIndex];
        if(
            previous.layer == layer && previous.material == material && previous.glyphPageIndex == glyphPageIndex
            && previous.sdfPageIndex == sdfPageIndex && previous.sdfChannel == sdfChannel
            && previous.textureImageIndex == textureImageIndex
            && EqualUiRect(previous.clip, clipEntry.rect)
        ){
            commands[lastIndex].indexCount += s_PaintQuadIndexCount;
            return;
        }
        if(previous.layer > layer)
            inOutCommandsOrdered = false;
        else
            inOutCommandsStrictlyDescending = false;
    }
    DrawCommand command;
    command.firstIndex = firstIndex;
    command.indexCount = s_PaintQuadIndexCount;
    command.clip = clipEntry.rect;
    command.material = material;
    command.glyphPageIndex = glyphPageIndex;
    command.sdfPageIndex = sdfPageIndex;
    command.sdfChannel = sdfChannel;
    command.layer = layer;
    command.textureImageIndex = textureImageIndex;
    commands.push_back(command);
}

void EmitPaintQuad(
    in b8 recording,
    in PaintClipEntry clip,
    in Rect rectangle,
    in Rect uv,
    in Color color,
    in PaintMaterial material,
    in u32 layer,
    in u32 glyphPageIndex,
    in u32 sdfPageIndex,
    in u32 sdfChannel,
    in u32 textureImageIndex,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered,
    mut b8 inOutCommandsStrictlyDescending
){
    EmitPaintQuadImpl(
        recording, false, clip, rectangle, uv, color, material, layer,
        glyphPageIndex, sdfPageIndex, sdfChannel, textureImageIndex,
        vertices, indices, commands, inOutCommandsOrdered, inOutCommandsStrictlyDescending
    );
}

void EmitPaintQuadValidated(
    in b8 recording,
    in PaintClipEntry clip,
    in Rect rectangle,
    in Rect uv,
    in Color color,
    in PaintMaterial material,
    in u32 layer,
    in u32 glyphPageIndex,
    in u32 sdfPageIndex,
    in u32 sdfChannel,
    in u32 textureImageIndex,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered,
    mut b8 inOutCommandsStrictlyDescending
){
    EmitPaintQuadImpl(
        recording, true, clip, rectangle, uv, color, material, layer,
        glyphPageIndex, sdfPageIndex, sdfChannel, textureImageIndex,
        vertices, indices, commands, inOutCommandsOrdered, inOutCommandsStrictlyDescending
    );
}

void EmitPaintOpaqueWhiteRectValidated(
    in b8 recording,
    in PaintClipEntry clipEntry,
    in Rect rectangle,
    in u32 layer,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered,
    mut b8 inOutCommandsStrictlyDescending
){
    if(!recording){
        ReportPaintQuadRecordingOff();
        return;
    }
    if(!(rectangle.width > 0.0f) || !(rectangle.height > 0.0f) || !(clipEntry.rect.width > 0.0f) || !(clipEntry.rect.height > 0.0f))
        return;
    const f32 rectRight = rectangle.x + rectangle.width;
    const f32 rectBottom = rectangle.y + rectangle.height;
    if(!IsFinite(rectRight) || !IsFinite(rectBottom))
        return;
    f32 x0 = rectangle.x;
    if(clipEntry.rect.x > x0)
        x0 = clipEntry.rect.x;
    f32 y0 = rectangle.y;
    if(clipEntry.rect.y > y0)
        y0 = clipEntry.rect.y;
    f32 x1 = rectRight;
    if(clipEntry.right < x1)
        x1 = clipEntry.right;
    f32 y1 = rectBottom;
    if(clipEntry.bottom < y1)
        y1 = clipEntry.bottom;
    const f32 visW = x1 - x0;
    const f32 visH = y1 - y0;
    if(!(visW > 0.0f) || !(visH > 0.0f) || !IsFinite(visW) || !IsFinite(visH))
        return;
    if(vertices.size() > cast<usize>(u32.max - s_PaintQuadVertexCount) || indices.size() > cast<usize>(u32.max - s_PaintQuadIndexCount)){
        assert(false);
        return;
    }
    const Color opaqueWhite = Color();
    const u32 vertexBase = cast<u32>(vertices.size());
    const u32 firstIndex = cast<u32>(indices.size());
    vertices.push_back(Vertex(Point(x0, y0), Point(0.0f, 0.0f), opaqueWhite));
    vertices.push_back(Vertex(Point(x1, y0), Point(0.0f, 0.0f), opaqueWhite));
    vertices.push_back(Vertex(Point(x1, y1), Point(0.0f, 0.0f), opaqueWhite));
    vertices.push_back(Vertex(Point(x0, y1), Point(0.0f, 0.0f), opaqueWhite));
    indices.push_back(vertexBase);
    indices.push_back(vertexBase + 1u);
    indices.push_back(vertexBase + 2u);
    indices.push_back(vertexBase);
    indices.push_back(vertexBase + 2u);
    indices.push_back(vertexBase + 3u);
    if(!commands.empty()){
        const usize lastIndex = commands.size() - 1u;
        in DrawCommand previous = commands[lastIndex];
        if(previous.layer == layer && previous.material == PaintMaterial::Solid && EqualUiRect(previous.clip, clipEntry.rect)){
            commands[lastIndex].indexCount += s_PaintQuadIndexCount;
            return;
        }
        if(previous.layer > layer)
            inOutCommandsOrdered = false;
        else
            inOutCommandsStrictlyDescending = false;
    }
    DrawCommand command;
    command.firstIndex = firstIndex;
    command.indexCount = s_PaintQuadIndexCount;
    command.clip = clipEntry.rect;
    command.material = PaintMaterial::Solid;
    command.glyphPageIndex = u32.max;
    command.sdfPageIndex = u32.max;
    command.sdfChannel = 0u;
    command.layer = layer;
    command.textureImageIndex = u32.max;
    commands.push_back(command);
}

void EmitPaintSolidQuadValidated(
    in b8 recording,
    in PaintClipEntry clipEntry,
    in Rect rectangle,
    in Color color,
    in u32 layer,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered,
    mut b8 inOutCommandsStrictlyDescending
){
    if(!recording){
        ReportPaintQuadRecordingOff();
        return;
    }
    if(!IsFinite(color.r) || !IsFinite(color.g) || !IsFinite(color.b) || !IsFinite(color.a) || color.a < 0.0f || color.a > 1.0f){
        ReportPaintQuadInvalidColor();
        return;
    }
    if(!(rectangle.width > 0.0f) || !(rectangle.height > 0.0f) || !(clipEntry.rect.width > 0.0f) || !(clipEntry.rect.height > 0.0f) || color.a <= 0.0f)
        return;
    const f32 rectRight = rectangle.x + rectangle.width;
    const f32 rectBottom = rectangle.y + rectangle.height;
    if(!IsFinite(rectRight) || !IsFinite(rectBottom))
        return;
    f32 x0 = rectangle.x;
    if(clipEntry.rect.x > x0)
        x0 = clipEntry.rect.x;
    f32 y0 = rectangle.y;
    if(clipEntry.rect.y > y0)
        y0 = clipEntry.rect.y;
    f32 x1 = rectRight;
    if(clipEntry.right < x1)
        x1 = clipEntry.right;
    f32 y1 = rectBottom;
    if(clipEntry.bottom < y1)
        y1 = clipEntry.bottom;
    const f32 visW = x1 - x0;
    const f32 visH = y1 - y0;
    if(!(visW > 0.0f) || !(visH > 0.0f) || !IsFinite(visW) || !IsFinite(visH))
        return;
    if(vertices.size() > cast<usize>(u32.max - s_PaintQuadVertexCount) || indices.size() > cast<usize>(u32.max - s_PaintQuadIndexCount)){
        assert(false);
        return;
    }
    Color premultiplied = color;
    if(color.a != 1.0f)
        premultiplied = Color(color.r * color.a, color.g * color.a, color.b * color.a, color.a);
    const u32 vertexBase = cast<u32>(vertices.size());
    const u32 firstIndex = cast<u32>(indices.size());
    vertices.push_back(Vertex(Point(x0, y0), Point(0.0f, 0.0f), premultiplied));
    vertices.push_back(Vertex(Point(x1, y0), Point(0.0f, 0.0f), premultiplied));
    vertices.push_back(Vertex(Point(x1, y1), Point(0.0f, 0.0f), premultiplied));
    vertices.push_back(Vertex(Point(x0, y1), Point(0.0f, 0.0f), premultiplied));
    indices.push_back(vertexBase);
    indices.push_back(vertexBase + 1u);
    indices.push_back(vertexBase + 2u);
    indices.push_back(vertexBase);
    indices.push_back(vertexBase + 2u);
    indices.push_back(vertexBase + 3u);
    if(!commands.empty()){
        const usize lastIndex = commands.size() - 1u;
        in DrawCommand previous = commands[lastIndex];
        if(previous.layer == layer && previous.material == PaintMaterial::Solid && EqualUiRect(previous.clip, clipEntry.rect)){
            commands[lastIndex].indexCount += s_PaintQuadIndexCount;
            return;
        }
        if(previous.layer > layer)
            inOutCommandsOrdered = false;
        else
            inOutCommandsStrictlyDescending = false;
    }
    DrawCommand command;
    command.firstIndex = firstIndex;
    command.indexCount = s_PaintQuadIndexCount;
    command.clip = clipEntry.rect;
    command.material = PaintMaterial::Solid;
    command.glyphPageIndex = u32.max;
    command.sdfPageIndex = u32.max;
    command.sdfChannel = 0u;
    command.layer = layer;
    command.textureImageIndex = u32.max;
    commands.push_back(command);
}

void EmitPaintLine(
    in b8 recording,
    in Rect clip,
    in Point start,
    in Point end,
    in f32 thickness,
    in Color color,
    in u32 layer,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered,
    mut b8 inOutCommandsStrictlyDescending
){
    if(!recording){
        ReportPaintLineRecordingOff();
        return;
    }
    if(!IsFinite(color.r) || !IsFinite(color.g) || !IsFinite(color.b) || !IsFinite(color.a) || color.a < 0.0f || color.a > 1.0f){
        ReportPaintLineInvalidColor();
        return;
    }
    if(!(clip.width > 0.0f) || !(clip.height > 0.0f) || color.a <= 0.0f || !IsFinite(thickness) || thickness <= 0.0f)
        return;
    const f32 clipEndX = clip.x + clip.width;
    const f32 clipEndY = clip.y + clip.height;
    if(!IsFinite(clipEndX) || !IsFinite(clipEndY))
        return;
    if(!IsFinite(start.x) || !IsFinite(start.y) || !IsFinite(end.x) || !IsFinite(end.y))
        return;

    const f32 dx = end.x - start.x;
    const f32 dy = end.y - start.y;
    const f32 lenSq = dx * dx + dy * dy;
    if(!IsFinite(lenSq) || lenSq <= 1.0e-8f)
        return;

    const f32 halfW = 0.5f * thickness;
    const f32 invLen = 1.0f / Sqrt(lenSq);
    const f32 nx = -dy * invLen * halfW;
    const f32 ny = dx * invLen * halfW;
    const f32 absNx = Abs(nx);
    const f32 absNy = Abs(ny);
    const f32 minX = Min(start.x, end.x) - absNx;
    const f32 maxX = Max(start.x, end.x) + absNx;
    const f32 minY = Min(start.y, end.y) - absNy;
    const f32 maxY = Max(start.y, end.y) + absNy;
    if(maxX <= clip.x || maxY <= clip.y || minX >= clipEndX || minY >= clipEndY)
        return;

    if(vertices.size() > cast<usize>(u32.max - s_PaintQuadVertexCount) || indices.size() > cast<usize>(u32.max - s_PaintQuadIndexCount)){
        assert(false);
        return;
    }

    Color premultiplied = color;
    if(color.a != 1.0f)
        premultiplied = Color(color.r * color.a, color.g * color.a, color.b * color.a, color.a);
    const u32 vertexBase = cast<u32>(vertices.size());
    const u32 firstIndex = cast<u32>(indices.size());
    vertices.push_back(Vertex(Point(start.x + nx, start.y + ny), Point(0.0f, 0.0f), premultiplied));
    vertices.push_back(Vertex(Point(end.x + nx, end.y + ny), Point(0.0f, 0.0f), premultiplied));
    vertices.push_back(Vertex(Point(end.x - nx, end.y - ny), Point(0.0f, 0.0f), premultiplied));
    vertices.push_back(Vertex(Point(start.x - nx, start.y - ny), Point(0.0f, 0.0f), premultiplied));
    indices.push_back(vertexBase);
    indices.push_back(vertexBase + 1u);
    indices.push_back(vertexBase + 2u);
    indices.push_back(vertexBase);
    indices.push_back(vertexBase + 2u);
    indices.push_back(vertexBase + 3u);

    if(!commands.empty()){
        const usize lastIndex = commands.size() - 1u;
        in DrawCommand previous = commands[lastIndex];
        if(previous.layer == layer && previous.material == PaintMaterial::Solid && EqualUiRect(previous.clip, clip)){
            commands[lastIndex].indexCount += s_PaintQuadIndexCount;
            return;
        }
        if(previous.layer > layer)
            inOutCommandsOrdered = false;
        else
            inOutCommandsStrictlyDescending = false;
    }

    DrawCommand command;
    command.firstIndex = firstIndex;
    command.indexCount = s_PaintQuadIndexCount;
    command.clip = clip;
    command.material = PaintMaterial::Solid;
    command.glyphPageIndex = u32.max;
    command.sdfPageIndex = u32.max;
    command.sdfChannel = 0u;
    command.layer = layer;
    command.textureImageIndex = u32.max;
    commands.push_back(command);
}

void EmitPaintLineBatch(
    in b8 recording,
    in Rect clip,
    in Span<PaintLineSegment> lines,
    in f32 thickness,
    in u32 layer,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered,
    mut b8 inOutCommandsStrictlyDescending
){
    if(!recording){
        ReportPaintLineRecordingOff();
        return;
    }
    if(lines.empty())
        return;
    const f32 clipEndX = clip.x + clip.width;
    const f32 clipEndY = clip.y + clip.height;
    if(!(clip.width > 0.0f) || !(clip.height > 0.0f) || !IsFinite(thickness) || thickness <= 0.0f || !IsFinite(clipEndX) || !IsFinite(clipEndY)){
        for(usize li = 0u; li < lines.size(); ++li){
            in Color color = lines[li].color;
            if(!IsFinite(color.r) || !IsFinite(color.g) || !IsFinite(color.b) || !IsFinite(color.a) || color.a < 0.0f || color.a > 1.0f)
                ReportPaintLineInvalidColor();
        }
        return;
    }

    const usize maxQuadVertsAvail = (cast<usize>(u32.max) - vertices.size()) / cast<usize>(s_PaintQuadVertexCount);
    const usize maxQuadIndicesAvail = (cast<usize>(u32.max) - indices.size()) / cast<usize>(s_PaintQuadIndexCount);
    const usize reserveLines = Min(lines.size(), Min(maxQuadVertsAvail, maxQuadIndicesAvail));
    if(reserveLines > 0u){
        vertices.reserve(vertices.size() + reserveLines * cast<usize>(s_PaintQuadVertexCount));
        indices.reserve(indices.size() + reserveLines * cast<usize>(s_PaintQuadIndexCount));
    }

    const f32 halfW = 0.5f * thickness;
    const u32 firstBatchIndex = cast<u32>(indices.size());
    const usize maxVertsSafe = cast<usize>(u32.max - s_PaintQuadVertexCount);
    const usize maxIndicesSafe = cast<usize>(u32.max - s_PaintQuadIndexCount);
    u32 emittedIndices = 0u;

    for(usize li = 0u; li < lines.size(); ++li){
        in PaintLineSegment seg = lines[li];
        in Color color = seg.color;
        if(!IsFinite(VectorSingle(color.r, color.g, color.b, color.a)) || color.a < 0.0f || color.a > 1.0f){
            ReportPaintLineInvalidColor();
            continue;
        }
        if(color.a <= 0.0f)
            continue;
        in Point start = seg.start;
        in Point end = seg.end;
        if(!IsFinite(VectorSingle(start.x, start.y, end.x, end.y)))
            continue;

        const f32 segMinX = Min(start.x, end.x);
        const f32 segMaxX = Max(start.x, end.x);
        const f32 segMinY = Min(start.y, end.y);
        const f32 segMaxY = Max(start.y, end.y);
        if(segMaxX + halfW <= clip.x || segMaxY + halfW <= clip.y || segMinX - halfW >= clipEndX || segMinY - halfW >= clipEndY)
            continue;

        const f32 dx = end.x - start.x;
        const f32 dy = end.y - start.y;
        const f32 lenSq = dx * dx + dy * dy;
        if(!IsFinite(lenSq) || lenSq <= 1.0e-8f)
            continue;

        const f32 scale = Rsqrt(VectorSingle(lenSq)).x * halfW;
        const f32 nx = -dy * scale;
        const f32 ny = dx * scale;
        const f32 absNx = Abs(nx);
        const f32 absNy = Abs(ny);
        const f32 minX = segMinX - absNx;
        const f32 maxX = segMaxX + absNx;
        const f32 minY = segMinY - absNy;
        const f32 maxY = segMaxY + absNy;
        if(maxX <= clip.x || maxY <= clip.y || minX >= clipEndX || minY >= clipEndY)
            continue;

        if(vertices.size() > maxVertsSafe || indices.size() > maxIndicesSafe){
            assert(false);
            break;
        }

        Color premultiplied = color;
        if(color.a != 1.0f)
            premultiplied = Color(color.r * color.a, color.g * color.a, color.b * color.a, color.a);
        const u32 vertexBase = cast<u32>(vertices.size());
        vertices.push_back(Vertex(Point(start.x + nx, start.y + ny), Point(0.0f, 0.0f), premultiplied));
        vertices.push_back(Vertex(Point(end.x + nx, end.y + ny), Point(0.0f, 0.0f), premultiplied));
        vertices.push_back(Vertex(Point(end.x - nx, end.y - ny), Point(0.0f, 0.0f), premultiplied));
        vertices.push_back(Vertex(Point(start.x - nx, start.y - ny), Point(0.0f, 0.0f), premultiplied));
        indices.push_back(vertexBase);
        indices.push_back(vertexBase + 1u);
        indices.push_back(vertexBase + 2u);
        indices.push_back(vertexBase);
        indices.push_back(vertexBase + 2u);
        indices.push_back(vertexBase + 3u);
        emittedIndices += s_PaintQuadIndexCount;
    }

    if(emittedIndices == 0u)
        return;

    if(!commands.empty()){
        const usize lastIndex = commands.size() - 1u;
        in DrawCommand previous = commands[lastIndex];
        if(previous.layer == layer && previous.material == PaintMaterial::Solid && EqualUiRect(previous.clip, clip)){
            commands[lastIndex].indexCount += emittedIndices;
            return;
        }
        if(previous.layer > layer)
            inOutCommandsOrdered = false;
        else
            inOutCommandsStrictlyDescending = false;
    }

    DrawCommand command;
    command.firstIndex = firstBatchIndex;
    command.indexCount = emittedIndices;
    command.clip = clip;
    command.material = PaintMaterial::Solid;
    command.glyphPageIndex = u32.max;
    command.sdfPageIndex = u32.max;
    command.sdfChannel = 0u;
    command.layer = layer;
    command.textureImageIndex = u32.max;
    commands.push_back(command);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

