usize LowerBoundEditClusterByEnd(in Span<TextCluster> clusters, in usize beginIndex, in usize endIndex, in usize byte){
    usize first = beginIndex;
    usize count = endIndex - beginIndex;
    while(count > 0u){
        const usize step = count / 2u;
        const usize mid = first + step;
        if(cast<usize>(clusters[mid].byteEnd) < byte){
            first = mid + 1u;
            count -= step + 1u;
        }
        else{
            count = step;
        }
    }
    return first;
}

u32 LineForEditCaretByte(in Span<TextLine> lines, in usize byte){
    usize first = 0u;
    usize count = lines.size();
    while(count > 0u){
        const usize step = count / 2u;
        const usize mid = first + step;
        if(cast<usize>(lines[mid].byteBegin) <= byte){
            first = mid + 1u;
            count -= step + 1u;
        }
        else{
            count = step;
        }
    }
    return cast<u32>(first - 1u);
}

b8 ValidateEditCaretLayout(
    in StringView text,
    in Span<TextLine> lines,
    in Span<TextCluster> clusters,
    in usize glyphCount,
    in Point measure,
    in Rect ink,
    in EditTextMode mode
){
    if(
        lines.empty() || lines.size() > s_TextMaxBytes + 1u || clusters.size() > s_TextMaxBytes
        || glyphCount > s_TextMaxBytes || (mode == EditTextMode::SingleLine && lines.size() != 1u)
        || !IsFinite(measure.x) || !IsFinite(measure.y) || measure.x < 0.0f || measure.y <= 0.0f
        || !IsFinite(ink.x) || !IsFinite(ink.y) || !IsFinite(ink.width) || !IsFinite(ink.height)
        || ink.width < 0.0f || ink.height < 0.0f
    )
        return false;
    usize previousBreak = 0u;
    usize nextCluster = 0u;
    usize nextGlyph = 0u;
    f32 previousBottom = 0.0f;
    f32 maximumAdvance = 0.0f;
    for(usize lineIndex = 0u; lineIndex < lines.size(); ++lineIndex){
        const TextLine line = lines[lineIndex];
        const usize lineByteBegin = cast<usize>(line.byteBegin);
        const usize lineByteEnd = cast<usize>(line.byteEnd);
        const usize lineBreakEnd = cast<usize>(line.breakEnd);
        const usize lineFirstCluster = cast<usize>(line.firstCluster);
        const usize lineFirstGlyph = cast<usize>(line.firstGlyph);
        const usize lineClusterCount = cast<usize>(line.clusterCount);
        const usize lineGlyphCount = cast<usize>(line.glyphCount);
        if(
            lineByteBegin != previousBreak || lineByteEnd < lineByteBegin || lineBreakEnd < lineByteEnd
            || lineBreakEnd > text.size() || lineFirstCluster != nextCluster || lineFirstGlyph != nextGlyph
            || lineClusterCount > clusters.size() - nextCluster || lineGlyphCount > glyphCount - nextGlyph
            || !IsFinite(line.top) || !IsFinite(line.height) || !IsFinite(line.advance) || !IsFinite(line.baseline)
            || line.top != previousBottom || line.height <= 0.0f || line.advance < 0.0f
        )
            return false;
        const f32 bottom = line.top + line.height;
        if(!IsFinite(bottom) || line.baseline < line.top || line.baseline > bottom)
            return false;
        for(usize byte = lineByteBegin; byte < lineByteEnd; ++byte){
            if(text[byte] == '\n')
                return false;
        }
        const b8 lastLine = lineIndex + 1u == lines.size();
        if(lastLine){
            if(lineByteEnd != text.size() || lineBreakEnd != lineByteEnd)
                return false;
        }
        else if(lineByteEnd == text.size() || text[lineByteEnd] != '\n' || lineBreakEnd != lineByteEnd + 1u)
            return false;
        usize coveredByte = lineByteBegin;
        const usize glyphEnd = nextGlyph + lineGlyphCount;
        const usize clusterEnd = nextCluster + lineClusterCount;
        f32 previousX = 0.0f;
        while(nextCluster < clusterEnd){
            const TextCluster cluster = clusters[nextCluster];
            const usize clusterByteBegin = cast<usize>(cluster.byteBegin);
            const usize clusterByteEnd = cast<usize>(cluster.byteEnd);
            const usize clusterFirstGlyph = cast<usize>(cluster.firstGlyph);
            const usize clusterGlyphCount = cast<usize>(cluster.glyphCount);
            if(
                cast<usize>(cluster.lineIndex) != lineIndex || clusterByteBegin != coveredByte
                || clusterByteEnd <= clusterByteBegin || clusterByteEnd > lineByteEnd
                || !IsUtf8ScalarBoundary(text, clusterByteBegin)
                || !IsUtf8ScalarBoundary(text, clusterByteEnd)
                || clusterFirstGlyph != nextGlyph || clusterGlyphCount == 0u || clusterGlyphCount > glyphEnd - nextGlyph
                || !IsFinite(cluster.leadingX) || !IsFinite(cluster.trailingX)
                || cluster.leadingX != previousX || cluster.trailingX < cluster.leadingX || cluster.trailingX > line.advance
            )
                return false;
            nextGlyph += clusterGlyphCount;
            coveredByte = clusterByteEnd;
            previousX = cluster.trailingX;
            ++nextCluster;
        }
        if(coveredByte != lineByteEnd || nextGlyph != glyphEnd || previousX != line.advance)
            return false;
        previousBreak = lineBreakEnd;
        previousBottom = bottom;
        maximumAdvance = Max(maximumAdvance, line.advance);
    }
    return nextCluster == clusters.size() && nextGlyph == glyphCount && measure.x == maximumAdvance && measure.y == previousBottom;
}

b8 IsValidEditCaretClusterGlyph(in u32 glyphByteBegin, in u32 glyphByteEnd, in Point glyphPosition, in TextCluster cluster){
    return glyphByteBegin == cluster.byteBegin && glyphByteEnd == cluster.byteEnd && IsFinite(glyphPosition.x) && IsFinite(glyphPosition.y);
}

b8 ValidateEditCaretAdoptionRequest(
    in StringView layoutText,
    in f32 layoutFontSize,
    in Span<TextLine> lines,
    in Span<TextCluster> clusters,
    in usize glyphCount,
    in Point measure,
    in Rect ink,
    in StringView expectedText,
    in Span<EditCaretMapping> mapping,
    in usize committedBytes,
    in EditTextMode mode
){
    if(
        layoutText != expectedText || (mode != EditTextMode::SingleLine && mode != EditTextMode::Multiline)
        || expectedText.size() > s_TextMaxBytes || committedBytes > s_TextMaxBytes
        || mapping.empty() || mapping.size() > committedBytes + s_EditCaretMaxExtraMappingStops
        || mapping[0u].committedByte != 0u || mapping[0u].displayByte != 0u
        || mapping[mapping.size() - 1u].committedByte != committedBytes || mapping[mapping.size() - 1u].displayByte != expectedText.size()
    )
        return false;
    if(mode == EditTextMode::Multiline && !ValidateMultilineText(expectedText))
        return false;
    ShapeRequest request;
    request.text = expectedText;
    request.fontSize = layoutFontSize;
    return ValidateTextRequest(request, mode == EditTextMode::Multiline) == TextLayoutStatus::Success
        && ValidateEditCaretLayout(layoutText, lines, clusters, glyphCount, measure, ink, mode);
}


