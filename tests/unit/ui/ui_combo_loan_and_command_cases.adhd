const StringView s_UiComboLoanPanelKey = "panel";
const StringView s_UiComboLoanKey = "combo";
const StringView s_UiComboLoanSecondKey = "other";
const StringView s_UiContextClaimSliderKey = "slider";
const StringView s_UiContextClaimListKey = "list";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Rect MakeUiComboLoanRect(in f32 x, in f32 y, in f32 width, in f32 height){
    Rect rect = Rect();
    rect.x = x;
    rect.y = y;
    rect.width = width;
    rect.height = height;
    return rect;
}

Point MakeUiComboLoanPoint(in f32 x, in f32 y){
    Point point = Point();
    point.x = x;
    point.y = y;
    return point;
}

InputSource MakeUiCommandInputSource(in u64 device, in u64 control){
    InputSource source = InputSource();
    source.device = device;
    source.control = control;
    return source;
}

HitTarget MakeUiCommandInputTarget(in u64 id){
    HitTarget target = HitTarget();
    target.id.value = id;
    target.rectangle = MakeUiComboLoanRect(0.0f, 0.0f, 80.0f, 40.0f);
    target.clip = MakeUiComboLoanRect(0.0f, 0.0f, 200.0f, 100.0f);
    target.declarationGeneration = 7u;
    target.focusable = true;
    target.activatable = true;
    target.focusOnCommit = true;
    return target;
}

HitTarget MakeUiCommandInputControl(in u64 id){
    HitTarget target = MakeUiCommandInputTarget(id);
    target.navigable = true;
    target.horizontalNavigation = true;
    target.control.instanceGeneration = 11u;
    target.control.contentGeneration = 21u;
    target.control.contentRevision = 31u;
    return target;
}

InputEvent MakeUiCommandInputCommand(in InputEventTypeEnum type, in InputSource source, in InputCommandEnum command, in b8 repeat){
    InputEvent event = InputEvent();
    event.type = type;
    event.source = source;
    event.command = command;
    event.repeat = repeat;
    return event;
}

InputEvent MakeUiCommandInputKey(in InputEventTypeEnum type, in b8 shift, in b8 repeat){
    InputEvent event = InputEvent();
    event.type = type;
    event.key = CoreKey::W;
    event.shift = shift;
    event.repeat = repeat;
    return event;
}

Array<HitTarget, 1u> MakeUiSingleHitTargetArray(in HitTarget target){
    Array<HitTarget, 1u> targets = Array<HitTarget, 1u>();
    targets[0u] = target;
    return targets;
}

Array<InputKeyBinding, 1u> MakeUiSingleKeyBindingArray(in InputKeyBinding binding){
    Array<InputKeyBinding, 1u> bindings = Array<InputKeyBinding, 1u>();
    bindings[0u] = binding;
    return bindings;
}

Array<PopupScope, 1u> MakeUiSinglePopupScopeArray(in PopupScope scope){
    Array<PopupScope, 1u> scopes = Array<PopupScope, 1u>();
    scopes[0u] = scope;
    return scopes;
}

b8 DeclareUiComboLoanPair(mut UiComboLoanTests self, in u64 generation, in IListDataSource secondSource, mut ComboState secondState){
    if(!self.begin(generation) || !self.m_builder.beginPanel(s_UiComboLoanPanelKey, MakeUiComboLoanRect(10.0f, 10.0f, 320.0f, 240.0f)))
        return false;
    const ComboOptions options = MakeUiComboLoanDefaultOptions();
    return self.m_builder.comboBox(s_UiComboLoanKey, self.m_source, self.m_state, options).valid
        && self.m_builder.comboBox(s_UiComboLoanSecondKey, secondSource, secondState, options).valid;
}


