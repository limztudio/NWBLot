#include <impl/ecs_render/shadow/light_space_shadow.adhd>
#include <impl/ecs_render/raytrace/raytracing_scene_identity_builder.adhd>
#include <impl/ecs_render/raytrace/rt_private.adhd>
#include <impl/ecs_render/raytrace/rt_swbvh_helpers.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets/graphics/shadow/light_space_constants.h>"), cpp_name("NWB_LIGHT_SPACE_EVENT_INSTANCE_MASK")]
extern const u32 s_SharedLightSpaceEventInstanceMask;

usize ResolveLightSpaceSceneBufferReserveCount(in usize capacity, in b8 csgGathering){
    if(csgGathering)
        return capacity * s_SceneBuffersPerCsgCandidate;
    return capacity * s_SceneBuffersPerCandidate;
}

u32 ResolveLightSpaceMeshletSlot(in u32 meshletCount, in u32 heapSlot){
    if(meshletCount != 0u)
        return heapSlot;
    return 0u;
}

b8 IsValidSoftwareLightSpaceCasterIndexBuffer(in u64 indexCount, in b8 hasIndexBuffer, in b8 isIndexBufferUsage, in u64 bufferByteSize){
    return indexCount != 0u && indexCount <= cast<u64>(u32.max) && hasIndexBuffer && isIndexBufferUsage && bufferByteSize >= indexCount * 4ull;
}

b8 UsesLightSpaceCaptureReuseCadence(in SoftwareShadowCaptureCadence cadence){
    return cadence == SoftwareShadowCaptureCadence::ReuseOneFrame || cadence == SoftwareShadowCaptureCadence::ReuseTwoFrames;
}

class LightSpaceShadowSceneGather : NoCopy{
    private mut LightSpaceShadowState m_state;
    private in CsgShapeRegistry m_registry;
    private mut World m_world;
    private Vector<LightSpaceShadowCaster> m_softwareCasters;
    private u64 m_captureSceneIdentity = s_Fnv64OffsetBasis;
    private b8 m_captureSceneTrusted = true;

    public LightSpaceShadowSceneGather(mut LightSpaceShadowState state, in CsgShapeRegistry registry, mut World world){
        this.m_state = state;
        this.m_registry = registry;
        this.m_world = world;
    }

    public void begin(in usize capacity, in b8 hardware){
        BeginLightSpaceCsgGather(this.m_state.m_csg, this.m_world, capacity, hardware);
        if(!hardware)
            this.m_state.m_sceneBuffers.reserve(ResolveLightSpaceSceneBufferReserveCount(capacity, this.m_state.m_csg.gathering));
    }

    public void reserveSoftwareCasters(in usize capacity){
        this.m_softwareCasters.reserve(capacity);
    }

    public void appendSoftwareReceiver(
        in EntityID entity,
        in b8 transparent,
        in MatrixSingle objectToWorld,
        in MatrixSingle worldToObject,
        in VectorSingle localMin,
        in VectorSingle localMax,
        in VectorSingle precomputedWorldMin,
        in VectorSingle precomputedWorldMax,
        in MeshRayTracingResourceSnapshot mesh
    ){
        AppendLightSpaceSceneBuffers(mesh, this.m_state.m_csg.gathering, this.m_state.m_sceneBuffers);
        if(this.m_state.m_csg.gathering)
            AppendLightSpaceCsgReceiverWithBounds(this.m_state.m_csg, entity, transparent, objectToWorld, worldToObject, localMin, localMax, true, precomputedWorldMin, precomputedWorldMax, mesh);
    }

    public void appendSoftwareReceiver(
        in EntityID entity,
        in b8 transparent,
        in MatrixSingle objectToWorld,
        in MatrixSingle worldToObject,
        in VectorSingle localMin,
        in VectorSingle localMax,
        in MeshRayTracingResourceSnapshot mesh
    ){
        AppendLightSpaceSceneBuffers(mesh, this.m_state.m_csg.gathering, this.m_state.m_sceneBuffers);
        if(this.m_state.m_csg.gathering)
            AppendLightSpaceCsgReceiver(this.m_state.m_csg, entity, transparent, objectToWorld, worldToObject, localMin, localMax, mesh);
    }

    public void appendSoftwareCaster(in MeshRayTracingResourceSnapshot mesh){
        LightSpaceShadowCaster caster;
        caster.triangleIndexBuffer = mesh.triangleIndexBuffer;
        caster.meshletDescBuffer = mesh.meshletDescBuffer;
        caster.meshletBoundsBuffer = mesh.meshletLocalBoundsBuffer;
        caster.meshletCount = mesh.meshletCount;
        caster.meshletDescSlot = ResolveLightSpaceMeshletSlot(mesh.meshletCount, mesh.meshletDescHeapHandle.slot());
        caster.meshletBoundsSlot = ResolveLightSpaceMeshletSlot(mesh.meshletCount, mesh.meshletLocalBoundsHeapHandle.slot());
        this.m_softwareCasters.push_back(caster);
    }

    public void appendHardwareReceiver(
        in EntityID entity,
        in b8 transparent,
        in u32 instanceIndex,
        in MatrixSingle objectToWorld,
        in VectorSingle localMin,
        in VectorSingle localMax,
        in MeshRayTracingResourceSnapshot mesh
    ){
        if(!this.m_state.m_csg.gathering)
            return;
        const MatrixSingle worldToObject = Inverse(objectToWorld);
        AppendLightSpaceCsgReceiver(this.m_state.m_csg, entity, transparent, objectToWorld, worldToObject, localMin, localMax, mesh);
        LightSpaceShadowCaster caster;
        caster.triangleIndexBuffer = mesh.triangleIndexBuffer;
        caster.meshletDescBuffer = mesh.meshletDescBuffer;
        caster.meshletBoundsBuffer = mesh.meshletLocalBoundsBuffer;
        caster.instanceIndex = instanceIndex;
        caster.indexCount = mesh.meshletPrimitiveIndexCount;
        caster.meshletCount = mesh.meshletCount;
        caster.meshletDescSlot = ResolveLightSpaceMeshletSlot(mesh.meshletCount, mesh.meshletDescHeapHandle.slot());
        caster.meshletBoundsSlot = ResolveLightSpaceMeshletSlot(mesh.meshletCount, mesh.meshletLocalBoundsHeapHandle.slot());
        caster.transparent = transparent;
        caster.csg = false;
        this.m_state.m_casters.push_back(caster);
        AppendLightSpaceSceneBuffers(mesh, true, this.m_state.m_sceneBuffers);
    }

    public b8 finishSoftware(in Span<SceneSwBvhInstanceGpu> instances, mut Span<NwbRtInstanceMaterialGpu> materials, in b8 contentComplete){
        if(!FinishLightSpaceCsgGather(this.m_registry, this.m_state.m_csg, this.m_world))
            return false;
        in CsgShadowSnapshot csg = this.m_state.m_csg.snapshot;
        const u32 instanceCount = cast<u32>(instances.size());
        this.m_state.m_sceneEligible = contentComplete && instanceCount <= s_SharedLightSpaceEventInstanceMask;
        this.m_state.m_casters.clear();
        this.m_state.m_casters.reserve(instanceCount);
        for(u32 index = 0u; index < instanceCount; ++index){
            const u64 indexCount = cast<u64>(instances[index].primitiveCount) * s_RayTracingTriangleIndexCount;
            mut LightSpaceShadowCaster caster = this.m_softwareCasters[index];
            in BufferHandle indexBuffer = caster.triangleIndexBuffer;
            b8 isIndexBuffer = false;
            u64 bytes = 0u;
            if(indexBuffer){
                isIndexBuffer = indexBuffer.deref().getCreationDescription().isIndexBuffer;
                bytes = indexBuffer.deref().getCreationDescription().byteSize;
            }
            if(!IsValidSoftwareLightSpaceCasterIndexBuffer(
                indexCount,
                cast<b8>(indexBuffer),
                isIndexBuffer,
                bytes
            ))
                this.m_state.m_sceneEligible = false;
            const b8 csgReceiver = csg.hasCsg && (csg.receiverRanges[index].flags & s_CsgRayReceiverActive) != 0u;
            if(csgReceiver)
                materials[index].flags |= s_ShaderRtInstanceMaterialFlagCsgShadow;
            caster.instanceIndex = index;
            caster.indexCount = cast<u32>(indexCount);
            caster.transparent = (materials[index].flags & RtInstanceMaterialFlag::Transparent) != 0u;
            caster.csg = csgReceiver;
            this.m_state.m_casters.push_back(caster);
        }
        return true;
    }

    public b8 finishHardware(mut Span<RayTracingInstanceDesc> instances, mut Span<NwbRtInstanceMaterialGpu> materials, in b8 contentComplete, mut b8 sceneHasTransparentOccluder){
        if(!FinishLightSpaceCsgGather(this.m_registry, this.m_state.m_csg, this.m_world))
            return false;
        in CsgShadowSnapshot csg = this.m_state.m_csg.snapshot;
        if(csg.hasCsg){
            if(csg.receiverRanges.size() != instances.size())
                return false;
            for(u32 index = 0u; index < cast<u32>(instances.size()); ++index){
                if((csg.receiverRanges[index].flags & s_CsgRayReceiverActive) == 0u)
                    continue;
                const b8 transparent = (materials[index].flags & RtInstanceMaterialFlag::Transparent) != 0u;
                instances[index].setInstanceMask(ResolveRayTracingCsgInstanceMask(transparent));
                materials[index].flags |= s_ShaderRtInstanceMaterialFlagCsgShadow;
                this.m_state.m_casters[index].csg = true;
            }
            sceneHasTransparentOccluder = true;
        }
        this.m_state.m_sceneEligible = csg.hasCsg && contentComplete;
        if(!csg.hasCsg){
            this.m_state.m_casters.clear();
            this.m_state.m_sceneBuffers.clear();
        }
        return true;
    }

    public void appendSoftwareCaptureIdentity(
        in EntityID entity,
        in b8 runtimeMesh,
        in MeshRayTracingResourceSnapshot mesh,
        in NwbRtInstanceMaterialGpu material,
        in InstanceGpuData instance,
        in RayTracingOpticalInstanceGpu opticalInstance
    ){
        Fnv64AppendValue(this.m_captureSceneIdentity, entity.id);
        Fnv64AppendValue(this.m_captureSceneIdentity, mesh.positionBuffer.get());
        Fnv64AppendValue(this.m_captureSceneIdentity, mesh.triangleIndexBuffer.get());
        Fnv64AppendValue(this.m_captureSceneIdentity, mesh.attributeBuffer.get());
        Fnv64AppendValue(this.m_captureSceneIdentity, mesh.meshletCount);
        Fnv64AppendValue(this.m_captureSceneIdentity, mesh.meshletDescBuffer.get());
        Fnv64AppendValue(this.m_captureSceneIdentity, mesh.meshletLocalBoundsBuffer.get());
        Fnv64AppendValue(this.m_captureSceneIdentity, mesh.meshletDescHeapHandle.value);
        Fnv64AppendValue(this.m_captureSceneIdentity, mesh.meshletLocalBoundsHeapHandle.value);
        RayTracingSceneIdentityBuilder().updateSoftwareCapture(
            mesh.meshletPrimitiveIndexCount,
            mesh.runtimeMeshVersion,
            mesh.runtimeGeometryContentRevision,
            material,
            instance.translation.w,
            instance.geometryHeapSlots,
            opticalInstance,
            this.m_captureSceneIdentity
        );
        if(runtimeMesh && mesh.runtimeGeometryContentRevision == 0u)
            this.m_captureSceneTrusted = false;
    }

    public void publishSoftwareCaptureIdentity(
        in u32 instanceCount,
        in Span<NwbRtInstanceMaterialGpu> materials,
        in Span<InstanceGpuData> instances,
        in usize materialByteCount,
        in u64 materialTypedHash,
        in Span<TextureHandle> textures,
        in b8 contentComplete
    ){
        this.m_state.m_sceneTextures.assign(textures.begin(), textures.end());
        in CsgShadowSnapshot csg = this.m_state.m_csg.snapshot;
        if(csg.hasCsg && UsesLightSpaceCaptureReuseCadence(this.m_state.m_settings.captureCadence)){
            this.m_state.m_captureSceneIdentity = BuildLightSpaceCsgCaptureIdentityWithMaterialHash(this.m_state.m_csg, materials, instances, materialByteCount, materialTypedHash, textures);
            this.m_state.m_captureSceneTrusted = this.m_state.m_csg.captureGeometryTrusted && contentComplete;
            return;
        }
        RayTracingSceneIdentityBuilder().appendMaterialBytesHash(instanceCount, materialByteCount, materialTypedHash, this.m_captureSceneIdentity);
        for(in TextureHandle texture : textures)
            Fnv64AppendValue(this.m_captureSceneIdentity, texture.get());
        if(csg.hasCsg)
            Fnv64AppendValue(this.m_captureSceneIdentity, csg.identity);
        this.m_state.m_captureSceneIdentity = this.m_captureSceneIdentity;
        this.m_state.m_captureSceneTrusted = this.m_captureSceneTrusted && contentComplete;
    }

    public void publishHardwareCaptureIdentity(
        in u64 materialHash,
        in u64 tlasHash,
        in b8 staticScene,
        in b8 contentComplete,
        in Span<NwbRtInstanceMaterialGpu> materials,
        in Span<InstanceGpuData> instances,
        in usize materialByteCount,
        in u64 materialTypedHash,
        in Span<TextureHandle> textures
    ){
        in CsgShadowSnapshot csg = this.m_state.m_csg.snapshot;
        if(!csg.hasCsg)
            return;
        this.m_state.m_sceneTextures.assign(textures.begin(), textures.end());
        if(UsesLightSpaceCaptureReuseCadence(this.m_state.m_settings.captureCadence)){
            this.m_state.m_captureSceneIdentity = BuildLightSpaceCsgCaptureIdentityWithMaterialHash(this.m_state.m_csg, materials, instances, materialByteCount, materialTypedHash, textures);
            this.m_state.m_captureSceneTrusted = this.m_state.m_csg.captureGeometryTrusted && contentComplete;
            return;
        }
        u64 captureIdentity = materialHash;
        Fnv64AppendValue(captureIdentity, tlasHash);
        Fnv64AppendValue(captureIdentity, csg.identity);
        for(in BufferHandle buffer : this.m_state.m_sceneBuffers)
            Fnv64AppendValue(captureIdentity, buffer.get());
        for(in LightSpaceShadowCaster caster : this.m_state.m_casters)
            RayTracingSceneIdentityBuilder().updateHardwareCaster(caster.meshletCount, caster.meshletDescSlot, caster.meshletBoundsSlot, captureIdentity);
        this.m_state.m_captureSceneIdentity = captureIdentity;
        this.m_state.m_captureSceneTrusted = staticScene && contentComplete;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

