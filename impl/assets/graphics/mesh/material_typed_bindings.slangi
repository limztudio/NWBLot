#ifndef NWB_GRAPHICS_MESH_MATERIAL_TYPED_BINDINGS_SLANGI
#define NWB_GRAPHICS_MESH_MATERIAL_TYPED_BINDINGS_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "binding_slots.h"
#include "runtime_constants.h"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The per-instance data + typed material-constant buffer are shared by the mesh stage (runtime.slangi) and pixel
// stage (via gbuffer_io.slangi).  They are descriptor-heap-only renderer resources.
struct NwbMeshInstanceData{
    float4 rotation;
    float3 translation;
    uint materialMutableByteOffset;
    float4 scale;
    // Indexed by NWB_MESH_BINDING_* ABI position. Binding 6 stores CSG's UniformBuffer context selector while typed
    // material words use the frame heap lane; preserve these positions to avoid renumbering source streams.
    uint geometryHeapSlots[NWB_MESH_INSTANCE_GEOMETRY_SLOT_COUNT];
};

#define g_NwbMaterialTypedWords NwbHeapMeshMaterialTypedWords(nwbMeshFrameMaterialTypedHeapSlot())
#define g_NwbMeshInstances NwbHeapMeshInstances(nwbMeshFrameInstanceHeapSlot())


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

