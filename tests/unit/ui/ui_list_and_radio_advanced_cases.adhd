////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class AdvancedListSource : IListDataSource{
    public Vector<u64> m_keys;
    public Vector<b8> m_enabled;
    public u64 m_generation = 911u;
    public u64 m_revision = 1u;
    public u64 m_longTextIndex = 0xffffffffffffffffu;
    public b8 m_wideAll = false;
    public TestObserved<String> m_temporary;
    public TestObserved<u64> m_textCalls;

    public void initRange(in u64 count){
        this.m_keys.clear();
        this.m_enabled.clear();
        this.m_keys.reserve(cast<usize>(count));
        this.m_enabled.reserve(cast<usize>(count));
        for(u64 index = 0u; index < count; ++index){
            this.m_keys.push_back(index + 1u);
            this.m_enabled.push_back(true);
        }
    }

    public u64 instanceGeneration()const override{ return this.m_generation; }
    public u64 revision()const override{ return this.m_revision; }
    public u64 rowCount()const override{ return cast<u64>(this.m_keys.size()); }
    public u64 key(in u64 index)const override{
        if(index >= this.m_keys.size())
            return 0u;
        return this.m_keys[cast<usize>(index)];
    }
    public Expected<u64> indexOf(in u64 value)const override{
        for(usize index = 0u; index < this.m_keys.size(); ++index){
            if(this.m_keys[index] == value)
                return cast<u64>(index);
        }
        return MakeUnexpected(Failure());
    }
    public Expected<u64> findEnabled(in u64 start, in b8 backwards)const override{
        if(this.m_keys.empty() || start >= this.m_keys.size())
            return MakeUnexpected(Failure());
        usize index = cast<usize>(start);
        for(usize visited = 0u; visited < this.m_keys.size(); ++visited){
            if(this.m_enabled[index])
                return cast<u64>(index);
            if(backwards){
                if(index == 0u)
                    return MakeUnexpected(Failure());
                --index;
            }
            else{
                if(index + 1u == this.m_keys.size())
                    return MakeUnexpected(Failure());
                ++index;
            }
        }
        return MakeUnexpected(Failure());
    }
    public StringView text(in u64 index)const override{
        ++this.m_textCalls.value();
        mut String buffer = this.m_temporary.value();
        if(this.m_wideAll || index == this.m_longTextIndex){
            buffer.assign("WideHorizontalScrollRowLabelContent_ABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789_Tail");
            return StringView(buffer);
        }
        buffer.assign("Row");
        return StringView(buffer);
    }
    public b8 enabled(in u64 index)const override{
        return index < this.m_enabled.size() && this.m_enabled[cast<usize>(index)];
    }
}

class VariableRowHeightProvider : IListRowHeightProvider{
    public u64 m_revision = 1u;
    public Vector<f32> m_heights;
    public b8 m_emitZero = false;
    public b8 m_emitNaN = false;

    public u64 rowHeightRevision()const override{ return this.m_revision; }
    public f32 rowHeight(in u64 index, in f32 defaultRowHeight)const override{
        if(this.m_emitNaN)
            return bit_cast<f32>(0x7fc00000u);
        if(this.m_emitZero)
            return 0.0f;
        if(index < this.m_heights.size())
            return this.m_heights[cast<usize>(index)];
        return defaultRowHeight;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type UiAdvancedListTests = UiListBuilderTests;
type UiAdvancedRadioTests = RadioGroupFixture;

void TapUiModifiedKey(mut WidgetFixture self, in KeyEnum keyValue, in b8 shift, in b8 control){
    InputEvent down = InputEvent();
    down.type = InputEventType::KeyDown;
    down.key = keyValue;
    down.shift = shift;
    down.control = control;
    EXPECT_TRUE(self.send(down).commandConsumed);
    InputEvent up = InputEvent();
    up.type = InputEventType::KeyUp;
    up.key = keyValue;
    up.shift = shift;
    up.control = control;
    EXPECT_TRUE(self.send(up).commandConsumed);
}

void ModifiedInputClick(mut WidgetFixture self, in Point pos, in b8 shift, in b8 control){
    InputEvent down = InputEvent();
    down.type = InputEventType::PrimaryDown;
    down.position = pos;
    down.shift = shift;
    down.extend = shift;
    down.control = control;
    EXPECT_TRUE(self.send(down).pointerConsumed);
    InputEvent up = InputEvent();
    up.type = InputEventType::PrimaryUp;
    up.position = pos;
    up.shift = shift;
    up.extend = shift;
    up.control = control;
    EXPECT_TRUE(self.send(up).pointerConsumed);
}

void RawModifiedPointerClick(mut WidgetFixture self, in Point pos, in b8 extend, in b8 toggle){
    PointerInput down = PointerInput();
    down.source = s_NativePointerSource;
    down.phase = PointerPhase::Press;
    down.intent = PointerIntent::Activate;
    down.position = pos;
    down.hoverCapable = true;
    down.extend = extend;
    down.toggle = toggle;
    ASSERT_TRUE(self.m_context.input().queuePointer(down).has_value());
    EXPECT_TRUE(self.m_context.input().process().pointerConsumed);

    PointerInput up = down;
    up.phase = PointerPhase::Release;
    ASSERT_TRUE(self.m_context.input().queuePointer(up).has_value());
    EXPECT_TRUE(self.m_context.input().process().pointerConsumed);
}

Point AdvancedRowCenter(in UiListBuilderTests self, in u64 keyValue){
    const Expected<HitTarget> found = self.tryTarget(self.row(keyValue));
    EXPECT_TRUE(found.has_value());
    if(!found.has_value())
        return Point();
    return CenterUiRect(found.value().rectangle);
}

RadioGroupChoices MakeAdvancedRadioChoices(in u32 count, in u64 disabledKey){
    RadioGroupChoices choices = RadioGroupChoices();
    choices.sourceGeneration = 101u;
    choices.sourceRevision = 1u;
    choices.count = count;
    choices.rows.resize(cast<usize>(count));
    for(u32 index = 0u; index < count; ++index){
        RadioGroupChoice row = RadioGroupChoice();
        row.key = cast<u64>(index + 1u);
        row.enabled = row.key != disabledKey;
        choices.rows[index] = row;
    }
    return choices;
}


