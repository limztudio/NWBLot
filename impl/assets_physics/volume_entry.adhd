b8 RegisterPhysicsComponentCookDependencies(mut CookDependencyRegistry registry){
    return registry.registerType(RigidBodyComponentAsset::AssetTypeName(), ExtractRigidBodyComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(ColliderComponentAsset::AssetTypeName(), ExtractColliderComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(JointComponentAsset::AssetTypeName(), ExtractJointComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(PhysicsWorldConfigComponentAsset::AssetTypeName(), ExtractPhysicsWorldConfigComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(PhysicsParentComponentAsset::AssetTypeName(), ExtractPhysicsParentComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(CharacterControllerComponentAsset::AssetTypeName(), ExtractCharacterControllerComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(VehicleComponentAsset::AssetTypeName(), ExtractVehicleComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(RagdollComponentAsset::AssetTypeName(), ExtractRagdollComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(FluidVolumeComponentAsset::AssetTypeName(), ExtractFluidVolumeComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(ForceFieldComponentAsset::AssetTypeName(), ExtractForceFieldComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(ArticulationComponentAsset::AssetTypeName(), ExtractArticulationComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(SoftBodyComponentAsset::AssetTypeName(), ExtractSoftBodyComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(FractureComponentAsset::AssetTypeName(), ExtractFractureComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(GpuRenderTransformExportComponentAsset::AssetTypeName(), ExtractGpuRenderTransformExportComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(PhysicsMaterialAsset::AssetTypeName(), ExtractPhysicsMaterialDependencies)
        && registry.registerType(CollisionLayerMatrixAsset::AssetTypeName(), ExtractCollisionLayerMatrixDependencies)
        && registry.registerType(ConvexHullAsset::AssetTypeName(), ExtractConvexHullDependencies)
        && registry.registerType(CompoundHullAsset::AssetTypeName(), ExtractCompoundHullDependencies)
        && registry.registerType(CollisionMeshAsset::AssetTypeName(), ExtractCollisionMeshDependencies)
        && registry.registerType(HeightfieldAsset::AssetTypeName(), ExtractHeightfieldDependencies)
        && registry.registerType(SdfAsset::AssetTypeName(), ExtractSdfDependencies)
        && registry.registerType(ChainShapeAsset::AssetTypeName(), ExtractChainShapeDependencies)
        && registry.registerType(CompoundShapeAsset::AssetTypeName(), ExtractCompoundShapeDependencies)
        && registry.registerType(FractureAsset::AssetTypeName(), ExtractFractureDependencies)
        && registry.registerType(SoftBodyAsset::AssetTypeName(), ExtractSoftBodyDependencies)
        && registry.registerType(RagdollAsset::AssetTypeName(), ExtractRagdollDependencies)
        && registry.registerType(ArticulationAsset::AssetTypeName(), ExtractArticulationDependencies)
        && registry.registerType(VehicleAsset::AssetTypeName(), ExtractVehicleDependencies);
}


