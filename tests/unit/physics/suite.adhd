NWB_ADHD_GTEST(PhysicsEdgeCases, GenerationalHandleInvalidationAndReuse, VerifyPhysicsEdgeCases_GenerationalHandleInvalidationAndReuse)
NWB_ADHD_GTEST(PhysicsEdgeCases, DegenerateAndInvalidGeometryRejection, VerifyPhysicsEdgeCases_DegenerateAndInvalidGeometryRejection)
NWB_ADHD_GTEST(PhysicsEdgeCases, BoxStackStabilityAndSleeping, VerifyPhysicsEdgeCases_BoxStackStabilityAndSleeping)
NWB_ADHD_GTEST(PhysicsEdgeCases, IslandSplitOnContactBreak, VerifyPhysicsEdgeCases_IslandSplitOnContactBreak)
NWB_ADHD_GTEST(PhysicsEdgeCases, ConstraintGraphOverflowColor23, VerifyPhysicsEdgeCases_ConstraintGraphOverflowColor23)
NWB_ADHD_GTEST(PhysicsEdgeCases, SpeculativeContactAndFastImpact, VerifyPhysicsEdgeCases_SpeculativeContactAndFastImpact)
NWB_ADHD_GTEST(PhysicsEdgeCases, RayCastAndShapeCastEdgeCases, VerifyPhysicsEdgeCases_RayCastAndShapeCastEdgeCases)
NWB_ADHD_GTEST(PhysicsEdgeCases, GpuLayoutAndEcsCpuFallbackContract, VerifyPhysicsEdgeCases_GpuLayoutAndEcsCpuFallbackContract)


