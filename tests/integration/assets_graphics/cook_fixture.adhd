Expected<RendererComponent> LoadCookedRendererComponent(mut TestArena testArena, in GraphicsTestPath outputDirectory, in Name virtualPath, in usize expectedVolumeFileCount){
    auto loaded = LoadCookedAsset<ComponentAssetCodec>(outputDirectory, virtualPath, expectedVolumeFileCount, testArena);
    if(!loaded.has_value() || !loaded.value())
        return MakeUnexpected(Failure());
    in IAsset value = loaded.value().deref();
    EXPECT_EQ(value.assetType(), DescribeAssetType<RendererComponentAsset>().name);
    const Optional<in RendererComponentAsset> renderer = BorrowTypedAsset<RendererComponentAsset>(value);
    if(!renderer.has_value())
        return MakeUnexpected(Failure());
    return renderer.value().component;
}

void InsertEvaluatorDefine(mut ShaderDefineMap defines, in StringView name, in Span<StringView> values){
    ShaderDefineEntry definition;
    for(in StringView value : values)
