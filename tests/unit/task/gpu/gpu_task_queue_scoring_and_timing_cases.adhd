using GpuScoringTestArena = ::NWB::Tests::TestArena<struct TaskGraphQueueScoringTestsTag>;
using GpuScoringCompiledGraphReadView = Core::GpuCompiledGraph::ReadView;
using GpuScoringCostHintEnum = Core::GpuTaskCostHint::Enum;
using GpuScoringResourceTypeEnum = Core::GpuGraphResourceType::Enum;
using GpuScoringSchedulingReachability = Core::GpuTaskGraphCompilerDetail::GpuTaskSchedulingReachability;
using GpuScoringData = Core::GpuTaskGraphCompilerDetail::GpuTaskQueueScoringData;
using GpuScoringExclusions = Core::GpuTaskGraphCompilerDetail::GpuTaskQueueScoreExclusions;
using GpuScoringAssignmentVector = Core::GraphicsVector<Core::GpuTaskQueueAssignment>;
using GpuScoringU32Vector = Core::GraphicsVector<u32>;
using GpuScoringTrackedState = Core::GpuTaskGraphCompilerDetail::TrackedCompiledResourceState;
using GpuScoringStateFragment = Core::GpuTaskGraphCompilerDetail::TrackedResourceStateFragment;
using GpuScoringStateHistory = Core::GpuTaskGraphCompilerDetail::TrackedResourceStateHistory;
using GpuScoringTrackedStates = Vector<Core::GpuTaskGraphCompilerDetail::TrackedCompiledResourceState, Core::Alloc::ScratchArena>;
using GpuScoringStateFragments = Vector<Core::GpuTaskGraphCompilerDetail::TrackedResourceStateFragment, Core::Alloc::ScratchArena>;
using GpuScoringRequestedRanges = Vector<Core::GpuTaskResourceRange, Core::Alloc::ScratchArena>;

inline constexpr u64 s_GpuScoringAllBytes = Core::BufferRange::s_AllBytes;
inline constexpr u32 s_GpuScoringAllMipLevels = Core::TextureSubresourceSet::s_AllMipLevels;
inline constexpr u32 s_GpuScoringAllArraySlices = Core::TextureSubresourceSet::s_AllArraySlices;
inline constexpr Core::GpuTaskTimingPolicy::Enum s_GpuScoringInvalidTimingPolicy = static_cast<Core::GpuTaskTimingPolicy::Enum>(Core::GpuTaskTimingPolicy::Count);

[[nodiscard]] inline Core::GpuPhysicalQueueTopology MakeGpuScoringTopology(const Span<const Core::GpuPhysicalQueueInfo> queues)noexcept{
    return Core::GpuPhysicalQueueTopology{ .queues = queues.data(), .queueCount = queues.size() };
}

[[nodiscard]] inline Span<const Core::GpuTaskId> MakeGpuScoringTaskPrefixSpan(const Span<const Core::GpuTaskId> tasks, const usize count)noexcept{
    return Span<const Core::GpuTaskId>(tasks.data(), count);
}

inline void SetGpuScoringExternalQueueLoads(Core::GpuTaskGraphQueueAssignmentOptions& options, const Span<const Core::GpuTaskQueueLoad> loads)noexcept{
    options.queueLoads = loads.data();
    options.queueLoadCount = loads.size();
}

inline void SetGpuScoringTimingHistory(Core::GpuTaskGraphQueueAssignmentOptions& options, const Core::GpuTaskTimingHistorySnapshot& snapshot)noexcept{
    options.timingHistory = &snapshot;
}

struct GpuScoringContext{
public:
    Core::GpuTaskGraphCompilerDetail::GpuTaskSchedulingReachability reachability;
    b8 reachabilityValid = false;
    Core::GpuTaskGraphCompilerDetail::GpuTaskQueueScoringData scoringData;


public:
    GpuScoringContext(
        const Core::GpuTaskGraph::DeclarationReadView& declarations,
        const Core::GpuTaskGraphAnalysis& analysis,
        const Core::GpuTaskGraphQueueAssignmentOptions& options,
        Core::Alloc::ScratchArena& scratchArena
    )
        : reachability(scratchArena)
        , reachabilityValid(Core::GpuTaskGraphCompilerDetail::BuildGpuTaskSchedulingReachability(declarations, analysis, reachability))
        , scoringData(
            declarations,
            analysis,
            reachability,
            options,
            scratchArena
        )
    {}
};

[[nodiscard]] inline Core::GpuQueueAssignmentScore BuildGpuScoringScore(
    const Core::GpuTaskGraph::DeclarationReadView& declarations,
    const Core::GpuTaskGraphAnalysis& analysis,
    const GpuScoringAssignmentVector& assignments,
    const GpuScoringU32Vector& assignmentIndices,
    const Core::GpuPhysicalQueueTopology& topology,
    const GpuScoringSchedulingReachability& reachability,
    const GpuScoringData& scoringData,
    const Core::GpuTaskGraphTaskView& task,
    const Core::GpuPhysicalQueueInfo& candidate,
    const GpuScoringExclusions& exclusions
)noexcept{
    return Core::GpuTaskGraphCompilerDetail::BuildQueueAssignmentScore(
        declarations,
        analysis,
        assignments,
        assignmentIndices,
        topology,
        reachability,
        scoringData,
        task,
        candidate,
        exclusions
    );
}

[[nodiscard]] inline b8 CollectGpuScoringLatestFragments(
    const GpuScoringTrackedStates& states,
    const GpuScoringStateHistory& history,
    const Core::GpuTaskGraphResourceView& resource,
    const GpuScoringRequestedRanges& requested,
    Core::Alloc::ScratchArena& scratchArena,
    GpuScoringStateFragments& fragments
){
    return Core::GpuTaskGraphCompilerDetail::CollectLatestResourceStateFragments(states, history, resource, requested, scratchArena, fragments);
}

[[nodiscard]] inline b8 CollectGpuScoringTerminalFragments(
    const GpuScoringTrackedStates& states,
    const GpuScoringStateHistory& history,
    const Core::GpuTaskGraphResourceView& resource,
    Core::Alloc::ScratchArena& scratchArena,
    GpuScoringStateFragments& fragments
){
    return Core::GpuTaskGraphCompilerDetail::CollectTerminalResourceStateFragments(states, history, resource, scratchArena, fragments);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_END
}


