#include <impl/assets_csg/asset.adhd>
#include <impl/assets_csg/cook.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ExtractCsgShapeDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    in CookDependencyItemContext contextRef = context;
    return context.visitDocument(lambda[in contextRef](in MetascriptDocument doc) -> b8{
        return ParseCsgShapeCookMetadata(contextRef.nwbFilePath, doc).has_value();
    });
}

b8 RegisterCsgShapeCookDependency(mut CookDependencyRegistry registry){
    return registry.registerType(CsgShape::AssetTypeName(), ExtractCsgShapeDependencies);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

