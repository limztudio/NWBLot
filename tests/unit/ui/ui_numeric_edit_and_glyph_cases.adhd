void VerifyUiNumericSelectionEpochTests_LaterSourceRejectsIntegerSelectionRoundTripWithUnchangedDraftAndTypedValue(mut UiNumericSelectionEpochTests self){
    self.useHost();
    ASSERT_TRUE(self.m_integer.setValue(42));
    UiNumericSelectionEpochSource source = UiNumericSelectionEpochSource();
    ListState list = ListState();
    ASSERT_TRUE(self.beginNumeric(1u));
    ASSERT_TRUE(self.m_builder.integerEdit(s_UiNumericEditIntegerKey, self.m_integer, self.m_integerState).edit.valid);
    ASSERT_TRUE(self.m_builder.virtualList("list", source, list, MakeLargeLoanListOptions()).valid);
    const u64 numericRevision = self.m_integer.revision();
    const u64 draftRevision = self.m_integer.draft().revision();
    const u64 externalRevision = self.m_integer.draft().externalRevision();
    const u64 selectionGeneration = self.m_integer.draft().selectionGeneration();
    source.armTextDraft(self.m_integer.lendDraft());
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(source.mutationApplied);
    EXPECT_GT(source.textCalls, 0u);
    EXPECT_EQ(self.m_host.publishes, 1u);
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_EQ(self.m_integer.value(), 42);
    EXPECT_EQ(self.m_integer.revision(), numericRevision);
    EXPECT_EQ(self.m_integer.draft().text(), "42");
    EXPECT_EQ(self.m_integer.draft().revision(), draftRevision);
    EXPECT_EQ(self.m_integer.draft().externalRevision(), externalRevision);
    EXPECT_EQ(self.m_integer.draft().anchor(), 2u);
    EXPECT_EQ(self.m_integer.draft().caret(), 2u);
    EXPECT_GT(self.m_integer.draft().selectionGeneration(), selectionGeneration);
}

void VerifyUiNumericSelectionEpochTests_LaterSourceRejectsFloatSelectionRoundTripWithUnchangedDraftAndTypedValue(mut UiNumericSelectionEpochTests self){
    self.useHost();
    ASSERT_TRUE(self.m_float.setValue(1.25));
    UiNumericSelectionEpochSource source = UiNumericSelectionEpochSource();
    ListState list = ListState();
    ASSERT_TRUE(self.beginNumeric(1u));
    ASSERT_TRUE(self.m_builder.floatEdit(s_UiNumericEditDecimalKey, self.m_float, self.m_floatState).edit.valid);
    ASSERT_TRUE(self.m_builder.virtualList("list", source, list, MakeLargeLoanListOptions()).valid);
    const u64 numericRevision = self.m_float.revision();
    const u64 draftRevision = self.m_float.draft().revision();
    const u64 selectionGeneration = self.m_float.draft().selectionGeneration();
    source.armTextDraft(self.m_float.lendDraft());
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(source.mutationApplied);
    EXPECT_EQ(self.m_host.publishes, 1u);
    EXPECT_DOUBLE_EQ(self.m_float.value(), 1.25);
    EXPECT_EQ(self.m_float.revision(), numericRevision);
    EXPECT_EQ(self.m_float.draft().text(), "1.25");
    EXPECT_EQ(self.m_float.draft().revision(), draftRevision);
    EXPECT_EQ(self.m_float.draft().anchor(), 4u);
    EXPECT_EQ(self.m_float.draft().caret(), 4u);
    EXPECT_GT(self.m_float.draft().selectionGeneration(), selectionGeneration);
}

