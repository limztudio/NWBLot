#include "benchmark_support.adhd"

native{
namespace SimdOptimizationBenchmark{
namespace ReplicatedKernels{

inline constexpr Array<b8, 21> s_ProductionCandidate = {
    true, true, true, true, true, true, true, true, true, false, false, false, true, true, true, false, false, false, false, false, false,
};

NWB_INLINE SIMDVectorDouble ReplicatedACos(const SIMDVectorDouble value)noexcept{
    return VectorDoubleReplicate(ACos(VectorDoubleGetX(value)));
}

NWB_INLINE SIMDVectorDouble ReplicatedSin(const SIMDVectorDouble value)noexcept{
    return VectorDoubleReplicate(Sin(VectorDoubleGetX(value)));
}

NWB_INLINE SIMDVectorDouble ReplicatedATan2(const SIMDVectorDouble y, const SIMDVectorDouble x)noexcept{
    return VectorDoubleReplicate(ATan2(VectorDoubleGetX(y), VectorDoubleGetX(x)));
}

template<u32 Dimension>
NWB_INLINE SIMDVectorDouble Dot(const SIMDVectorDouble lhs, const SIMDVectorDouble rhs)noexcept{
    if constexpr(Dimension == 2u)
        return VectorDouble2Dot(lhs, rhs);
    else if constexpr(Dimension == 3u)
        return VectorDouble3Dot(lhs, rhs);
    else
        return VectorDouble4Dot(lhs, rhs);
}

template<u32 Dimension>
NWB_INLINE SIMDVectorDouble ReciprocalLength(const SIMDVectorDouble value)noexcept{
    return VectorDoubleReciprocalSqrt(Dot<Dimension>(value, value));
}

template<u32 Dimension, b8 Vectors, b8 Candidate>
NWB_INLINE SIMDVectorDouble Angle(const SIMDVectorDouble lhs, const SIMDVectorDouble rhs)noexcept{
    SIMDVectorDouble cosine = Dot<Dimension>(lhs, rhs);
    if constexpr(Vectors)
        cosine = VectorDoubleMultiply(cosine, VectorDoubleMultiply(ReciprocalLength<Dimension>(lhs), ReciprocalLength<Dimension>(rhs)));
    cosine = VectorDoubleClamp(cosine, s_DoubleSIMDNegativeOne, s_DoubleSIMDOne);
    if constexpr(Candidate)
        return ReplicatedACos(cosine);
    else
        return VectorDoubleACos(cosine);
}

template<b8 Candidate>
NWB_INLINE SIMDVectorDouble QuaternionLn(const SIMDVectorDouble value)noexcept{
    const SIMDVectorDouble bound = VectorDoubleReplicate(1.0 - SIMDQuaternionDoubleDetail::s_DoubleQuaternionInterpolationEpsilon);
    const SIMDVectorDouble w = VectorDoubleSplatW(value), xyz = VectorDoubleAndInt(value, s_DoubleSIMDMask3);
    const SIMDVectorDouble control = VectorDoubleInBounds(w, bound);
    const SIMDVectorDouble theta = Candidate ? ReplicatedACos(w) : VectorDoubleACos(w);
    const SIMDVectorDouble sine = Candidate ? ReplicatedSin(theta) : VectorDoubleSin(theta);
    return VectorDoubleSelect(xyz, VectorDoubleMultiply(xyz, VectorDoubleDivide(theta, sine)), control);
}

template<b8 Candidate>
NWB_INLINE SIMDVectorDouble QuaternionExp(const SIMDVectorDouble value)noexcept{
    const SIMDVectorDouble theta = VectorDouble3Length(value);
    SIMDVectorDouble sine{}, cosine{};
    if constexpr(Candidate)
        SIMDVectorDoubleDetail::SinCosReplicated(sine, cosine, theta);
    else
        VectorDoubleSinCos(sine, cosine, theta);
    const SIMDVectorDouble scale = VectorDoubleDivide(sine, theta);
    SIMDVectorDouble result = VectorDoubleMultiply(value, scale);
    result = VectorDoubleSelect(result, value, VectorDoubleNearEqual(theta, VectorDoubleZero(), s_DoubleSIMDEpsilon));
    return VectorDoubleSelect(cosine, result, s_DoubleSIMDSelect1110);
}

template<b8 Candidate>
NWB_INLINE SIMDVectorDouble QuaternionSlerp(const SIMDVectorDouble lhs, const SIMDVectorDouble rhs)noexcept{
    const SIMDVectorDouble t = VectorDoubleReplicate(0.375);
    const SIMDVectorDouble bound = VectorDoubleReplicate(1.0 - SIMDQuaternionDoubleDetail::s_DoubleQuaternionInterpolationEpsilon);
    SIMDVectorDouble cosine = QuaternionDoubleDot(lhs, rhs);
    SIMDVectorDouble control = VectorDoubleLess(cosine, VectorDoubleZero());
    const SIMDVectorDouble sign = VectorDoubleSelect(s_DoubleSIMDOne, s_DoubleSIMDNegativeOne, control);
    cosine = VectorDoubleMultiply(cosine, sign);
    control = VectorDoubleLess(cosine, bound);
    const SIMDVectorDouble sine = VectorDoubleSqrt(VectorDoubleNegativeMultiplySubtract(cosine, cosine, s_DoubleSIMDOne));
    const SIMDVectorDouble omega = Candidate ? ReplicatedATan2(sine, cosine) : VectorDoubleATan2(sine, cosine);
    SIMDVectorDouble signMask = VectorDoubleSplatSignMask();
    SIMDVectorDouble weights = VectorDoubleShiftLeft(t, VectorDoubleZero(), 2u);
    signMask = VectorDoubleShiftLeft(signMask, VectorDoubleZero(), 3u);
    weights = VectorDoubleXorInt(weights, signMask);
    weights = VectorDoubleAdd(s_DoubleSIMDIdentityR0, weights);
    // Nonuniform weighted arguments use the four-lane sine path.
    SIMDVectorDouble firstWeight = VectorDoubleMultiply(weights, omega);
    firstWeight = VectorDoubleSin(firstWeight);
    firstWeight = VectorDoubleMultiply(firstWeight, VectorDoubleReciprocal(sine));
    firstWeight = VectorDoubleSelect(weights, firstWeight, control);
    const SIMDVectorDouble secondWeight = VectorDoubleMultiply(VectorDoubleSplatY(firstWeight), sign);
    firstWeight = VectorDoubleSplatX(firstWeight);
    return VectorDoubleMultiplyAdd(rhs, secondWeight, VectorDoubleMultiply(lhs, firstWeight));
}

template<u32 Dimension, b8 Reciprocal, b8 Candidate>
NWB_INLINE SIMDVectorDouble Length(const SIMDVectorDouble value)noexcept{
#if defined(NWB_HAS_SSE2)
    if constexpr(Candidate){
        const __m128d input = SIMDVectorDoubleDetail::GetLow(Dot<Dimension>(value, value));
        __m128d root = _mm_sqrt_sd(input, input);
        if constexpr(Reciprocal)
            root = _mm_div_sd(_mm_set_sd(1.0), root);
        const __m128d result = _mm_unpacklo_pd(root, root);
        return SIMDVectorDoubleDetail::FromPairs(result, result);
    }
    else
#endif
    if constexpr(Reciprocal)
        return ReciprocalLength<Dimension>(value);
    else{
        if constexpr(Dimension == 2u)
            return VectorDouble2Length(value);
        else if constexpr(Dimension == 3u)
            return VectorDouble3Length(value);
        else
            return VectorDouble4Length(value);
    }
}

template<u32 Dimension, b8 Clamp, b8 Candidate>
NWB_INLINE SIMDVectorDouble ControlledLength(const SIMDVectorDouble value, const SIMDVectorDouble fallback)noexcept{
    const SIMDVectorDouble lengthSquared = Dot<Dimension>(value, value);
    const auto reciprocalLength = [&]()noexcept{
#if defined(NWB_HAS_SSE2) && !defined(NWB_HAS_AVX)
        if constexpr(Candidate)
            return SIMDVectorDoubleDetail::ReciprocalSqrtReplicated(lengthSquared);
        else
#endif
            return VectorDoubleReciprocalSqrt(lengthSquared);
    };
    const SIMDVectorDouble mask = Dimension == 2u ? SIMDVectorDouble(s_DoubleSIMDMaskXY) : Dimension == 3u ? SIMDVectorDouble(s_DoubleSIMDMask3) : VectorDoubleTrueInt();
    if constexpr(Clamp){
        const SIMDVectorDouble reciprocal = reciprocalLength();
        const SIMDVectorDouble minimum = VectorDoubleReplicate(0.5), maximum = VectorDoubleReplicate(2.0);
        const SIMDVectorDouble infinite = VectorDoubleEqualInt(lengthSquared, s_DoubleSIMDInfinity), zero = VectorDoubleEqual(lengthSquared, VectorDoubleZero());
        const SIMDVectorDouble select = VectorDoubleEqualInt(infinite, zero);
        SIMDVectorDouble normal = VectorDoubleMultiply(value, reciprocal), length = VectorDoubleMultiply(lengthSquared, reciprocal);
        length = VectorDoubleSelect(lengthSquared, length, select);
        normal = VectorDoubleSelect(lengthSquared, normal, select);
        const SIMDVectorDouble above = VectorDoubleGreater(length, maximum), below = VectorDoubleLess(length, minimum);
        SIMDVectorDouble clamped = VectorDoubleSelect(length, maximum, above);
        clamped = VectorDoubleSelect(clamped, minimum, below);
        const SIMDVectorDouble result = VectorDoubleMultiply(normal, clamped);
        return VectorDoubleAndInt(VectorDoubleSelect(result, value, VectorDoubleEqualInt(above, below)), mask);
    }
    else{
        const SIMDVectorDouble finiteLength = VectorDoubleEqualInt(VectorDoubleOrInt(VectorDoubleIsNaN(lengthSquared), VectorDoubleIsInfinite(lengthSquared)), VectorDoubleFalseInt());
        const SIMDVectorDouble validLength = VectorDoubleAndInt(VectorDoubleGreater(lengthSquared, VectorDoubleZero()), finiteLength);
        const SIMDVectorDouble reciprocal = reciprocalLength();
        const SIMDVectorDouble normalized = VectorDoubleAndInt(VectorDoubleMultiply(value, reciprocal), mask);
        const SIMDVectorDouble validNormalized = VectorDoubleEqualInt(VectorDoubleOrInt(VectorDoubleIsNaN(normalized), VectorDoubleIsInfinite(normalized)), VectorDoubleFalseInt());
        return VectorDoubleSelect(VectorDoubleAndInt(fallback, mask), normalized, VectorDoubleAndInt(validLength, validNormalized));
    }
}

template<u32 KindIndex, b8 Estimate = false>
NWB_INLINE SIMDVectorDouble ProductionValue(const SIMDVectorDouble lhs, const SIMDVectorDouble rhs)noexcept{
    if constexpr(KindIndex == 0u)
        return QuaternionDoubleLn(lhs);
    else if constexpr(KindIndex == 1u)
        return QuaternionDoubleExp(lhs);
    else if constexpr(KindIndex == 2u){
        if constexpr(Estimate)
            return VectorDouble2AngleBetweenNormalsEst(lhs, rhs);
        else
            return VectorDouble2AngleBetweenNormals(lhs, rhs);
    }
    else if constexpr(KindIndex == 3u){
        if constexpr(Estimate)
            return VectorDouble3AngleBetweenNormalsEst(lhs, rhs);
        else
            return VectorDouble3AngleBetweenNormals(lhs, rhs);
    }
    else if constexpr(KindIndex == 4u){
        if constexpr(Estimate)
            return VectorDouble4AngleBetweenNormalsEst(lhs, rhs);
        else
            return VectorDouble4AngleBetweenNormals(lhs, rhs);
    }
    else if constexpr(KindIndex == 5u)
        return VectorDouble2AngleBetweenVectors(lhs, rhs);
    else if constexpr(KindIndex == 6u)
        return VectorDouble3AngleBetweenVectors(lhs, rhs);
    else if constexpr(KindIndex == 7u)
        return VectorDouble4AngleBetweenVectors(lhs, rhs);
    else if constexpr(KindIndex == 8u)
        return QuaternionDoubleSlerp(lhs, rhs, 0.375);
    else if constexpr(KindIndex == 9u)
        return VectorDouble2Length(lhs);
    else if constexpr(KindIndex == 10u)
        return VectorDouble3Length(lhs);
    else if constexpr(KindIndex == 11u)
        return VectorDouble4Length(lhs);
    else if constexpr(KindIndex == 12u)
        return VectorDouble2ReciprocalLength(lhs);
    else if constexpr(KindIndex == 13u)
        return VectorDouble3ReciprocalLength(lhs);
    else if constexpr(KindIndex == 14u)
        return VectorDouble4ReciprocalLength(lhs);
    else if constexpr(KindIndex == 15u)
        return VectorDouble2NormalizeOr(lhs, rhs, 0.0);
    else if constexpr(KindIndex == 16u)
        return VectorDouble3NormalizeOr(lhs, rhs, 0.0);
    else if constexpr(KindIndex == 17u)
        return VectorDouble4NormalizeOr(lhs, rhs, 0.0);
    else if constexpr(KindIndex == 18u)
        return VectorDouble2ClampLength(lhs, 0.5, 2.0);
    else if constexpr(KindIndex == 19u)
        return VectorDouble3ClampLength(lhs, 0.5, 2.0);
    else
        return VectorDouble4ClampLength(lhs, 0.5, 2.0);
}

template<u32 KindIndex, b8 Estimate = false>
NWB_NOINLINE SIMDVectorDouble Production(const SIMDVectorDouble lhs, const SIMDVectorDouble rhs)noexcept{
#pragma STDC FENV_ACCESS ON
    return ProductionValue<KindIndex, Estimate>(lhs, rhs);
}

template<u32 KindIndex, b8 Candidate>
NWB_INLINE SIMDVectorDouble Reduce(const SIMDVectorDouble lhs, const SIMDVectorDouble rhs)noexcept{
    if constexpr(Candidate && s_ProductionCandidate[KindIndex])
        return ProductionValue<KindIndex>(lhs, rhs);
    else if constexpr(KindIndex == 0u)
        return QuaternionLn<Candidate>(lhs);
    else if constexpr(KindIndex == 1u)
        return QuaternionExp<Candidate>(lhs);
    else if constexpr(KindIndex == 2u)
        return Angle<2u, false, Candidate>(lhs, rhs);
    else if constexpr(KindIndex == 3u)
        return Angle<3u, false, Candidate>(lhs, rhs);
    else if constexpr(KindIndex == 4u)
        return Angle<4u, false, Candidate>(lhs, rhs);
    else if constexpr(KindIndex == 5u)
        return Angle<2u, true, Candidate>(lhs, rhs);
    else if constexpr(KindIndex == 6u)
        return Angle<3u, true, Candidate>(lhs, rhs);
    else if constexpr(KindIndex == 7u)
        return Angle<4u, true, Candidate>(lhs, rhs);
    else if constexpr(KindIndex == 8u)
        return QuaternionSlerp<Candidate>(lhs, rhs);
    else if constexpr(KindIndex == 9u)
        return Length<2u, false, Candidate>(lhs);
    else if constexpr(KindIndex == 10u)
        return Length<3u, false, Candidate>(lhs);
    else if constexpr(KindIndex == 11u)
        return Length<4u, false, Candidate>(lhs);
    else if constexpr(KindIndex == 12u)
        return Length<2u, true, Candidate>(lhs);
    else if constexpr(KindIndex == 13u)
        return Length<3u, true, Candidate>(lhs);
    else if constexpr(KindIndex == 14u)
        return Length<4u, true, Candidate>(lhs);
    else if constexpr(KindIndex == 15u)
        return ControlledLength<2u, false, Candidate>(lhs, rhs);
    else if constexpr(KindIndex == 16u)
        return ControlledLength<3u, false, Candidate>(lhs, rhs);
    else if constexpr(KindIndex == 17u)
        return ControlledLength<4u, false, Candidate>(lhs, rhs);
    else if constexpr(KindIndex == 18u)
        return ControlledLength<2u, true, Candidate>(lhs, rhs);
    else if constexpr(KindIndex == 19u)
        return ControlledLength<3u, true, Candidate>(lhs, rhs);
    else
        return ControlledLength<4u, true, Candidate>(lhs, rhs);
}

template<u32 KindIndex, b8 Candidate>
NWB_NOINLINE SIMDVectorDouble Evaluate(const SIMDVectorDouble lhs, const SIMDVectorDouble rhs)noexcept{
#pragma STDC FENV_ACCESS ON
    if constexpr(Candidate && s_ProductionCandidate[KindIndex])
        return Production<KindIndex>(lhs, rhs);
    else
        return Reduce<KindIndex, Candidate>(lhs, rhs);
}

template<u32 KindIndex, b8 Candidate, typename DatasetT>
NWB_NOINLINE SIMDVectorDouble RunWorkload(const DatasetT& data, const usize dataCount, const usize iterations)noexcept{
    return ThroughputWorkload<4u>(
        data, dataCount, iterations,
        [](const SIMDVectorDouble lhs, const SIMDVectorDouble rhs)noexcept{ return Reduce<KindIndex, Candidate>(lhs, rhs); });
}

}
};
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u32> ReplicatedOperation{
    Ln = 0u,
    Exp = 1u,
    Normals2 = 2u,
    Normals3 = 3u,
    Normals4 = 4u,
    Vectors2 = 5u,
    Vectors3 = 6u,
    Vectors4 = 7u,
    Slerp = 8u,
    Length2 = 9u,
    Length3 = 10u,
    Length4 = 11u,
    Reciprocal2 = 12u,
    Reciprocal3 = 13u,
    Reciprocal4 = 14u,
    Normalize2 = 15u,
    Normalize3 = 16u,
    Normalize4 = 17u,
    Clamp2 = 18u,
    Clamp3 = 19u,
    Clamp4 = 20u,
    kCount = 21u
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StringView ReplicatedOperationName(in u32 kindIndex){
    switch(kindIndex){
    case 0u: return "ln";
    case 1u: return "exp";
    case 2u: return "normals2";
    case 3u: return "normals3";
    case 4u: return "normals4";
    case 5u: return "vectors2";
    case 6u: return "vectors3";
    case 7u: return "vectors4";
    case 8u: return "slerp";
    case 9u: return "length2";
    case 10u: return "length3";
    case 11u: return "length4";
    case 12u: return "reciprocal2";
    case 13u: return "reciprocal3";
    case 14u: return "reciprocal4";
    case 15u: return "normalize2";
    case 16u: return "normalize3";
    case 17u: return "normalize4";
    case 18u: return "clamp2";
    case 19u: return "clamp3";
    case 20u: return "clamp4";
    default: return "";
    }
}

// Switch only accepted candidates to production after their implementations are applied.
b8 IsReplicatedProductionCandidate(in u32 kindIndex){
    return kindIndex <= 8u || (kindIndex >= 12u && kindIndex <= 14u);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ReplicatedEvaluator<const u32 KindIndex, const b8 Candidate> : IDoubleBinaryEvaluator{
    public VectorDouble evaluate(in VectorDouble lhs, in VectorDouble rhs)const override{
        VectorDouble result = VectorDouble(0.0, 0.0, 0.0, 0.0);
        native(in lhs, in rhs, mut result){
            result = ReplicatedKernels::Evaluate<KindIndex, Candidate>(lhs, rhs);
        }
        return result;
    }
}

class ReplicatedProductionEvaluator<const u32 KindIndex, const b8 Estimate> : IDoubleBinaryEvaluator{
    public VectorDouble evaluate(in VectorDouble lhs, in VectorDouble rhs)const override{
        VectorDouble result = VectorDouble(0.0, 0.0, 0.0, 0.0);
        native(in lhs, in rhs, mut result){
            result = ReplicatedKernels::Production<KindIndex, Estimate>(lhs, rhs);
        }
        return result;
    }
}

class ReplicatedAdditionalCheck<const u32 KindIndex> : IAdditionalReductionCheck{
    public b8 check(
        in VectorDouble lhs,
        in VectorDouble rhs,
        in Observation expected,
        in Observation actual,
        in usize index,
        mut u32 failures
    )const override{
        const Expected<Observation> production = ObserveBinary(ReplicatedProductionEvaluator<KindIndex, false>(), lhs, rhs);
        if(!production.has_value())
            return false;

        b8 matches = false;
        if(IsReplicatedProductionCandidate(KindIndex))
            matches = EqualObservation(actual, production.value());
        else
            matches = EqualObservation(expected, production.value());

        if(!matches){
            ++failures;
            if(failures <= 3u){
                const StringView opName = ReplicatedOperationName(KindIndex);
                native(in opName, in index){
                    NWB_COUT << "production mismatch operation=" << opName << " case=" << index << '\n';
                }
            }
        }

        if(KindIndex >= 2u && KindIndex <= 4u){
            const Expected<Observation> estimate = ObserveBinary(ReplicatedProductionEvaluator<KindIndex, true>(), lhs, rhs);
            if(!estimate.has_value())
                return false;
            b8 estimateMatches = false;
            if(IsReplicatedProductionCandidate(KindIndex))
                estimateMatches = EqualObservation(actual, estimate.value());
            else
                estimateMatches = EqualObservation(expected, estimate.value());
            if(!estimateMatches)
                ++failures;
        }
        return true;
    }
}

class ReplicatedWorkloadRunner<const u32 KindIndex, const b8 Candidate> : IDoubleWorkloadRunner{
    private in Dataset m_data;
    private usize m_iterations;

    public ReplicatedWorkloadRunner(in Dataset data, in usize iterations){
        this.m_data = data;
        this.m_iterations = iterations;
    }

    public VectorDouble run()const override{
        VectorDouble result = VectorDouble(0.0, 0.0, 0.0, 0.0);
        in Dataset data = this.m_data;
        const usize iterations = this.m_iterations;
        native(in data, in iterations, mut result){
            result = ReplicatedKernels::RunWorkload<KindIndex, Candidate>(data, s_DataCount, iterations);
        }
        return result;
    }
}

u32 VerifyReplicatedReduction<const u32 KindIndex>(mut u64 seed){
    return VerifyReductionCases(
        ReplicatedOperationName(KindIndex),
        ReplicatedEvaluator<KindIndex, false>(),
        ReplicatedEvaluator<KindIndex, true>(),
        ReplicatedAdditionalCheck<KindIndex>(),
        seed
    );
}

class ReplicatedRoundingVerifier : IRoundingModeVerifier{
    public u32 verify(mut u64 seed)const override{
        u32 failures = 0u;
        failures += VerifyReplicatedReduction<0u>(seed);
        failures += VerifyReplicatedReduction<1u>(seed);
        failures += VerifyReplicatedReduction<2u>(seed);
        failures += VerifyReplicatedReduction<3u>(seed);
        failures += VerifyReplicatedReduction<4u>(seed);
        failures += VerifyReplicatedReduction<5u>(seed);
        failures += VerifyReplicatedReduction<6u>(seed);
        failures += VerifyReplicatedReduction<7u>(seed);
        failures += VerifyReplicatedReduction<8u>(seed);
        failures += VerifyReplicatedReduction<9u>(seed);
        failures += VerifyReplicatedReduction<10u>(seed);
        failures += VerifyReplicatedReduction<11u>(seed);
        failures += VerifyReplicatedReduction<12u>(seed);
        failures += VerifyReplicatedReduction<13u>(seed);
        failures += VerifyReplicatedReduction<14u>(seed);
        failures += VerifyReplicatedReduction<15u>(seed);
        failures += VerifyReplicatedReduction<16u>(seed);
        failures += VerifyReplicatedReduction<17u>(seed);
        failures += VerifyReplicatedReduction<18u>(seed);
        failures += VerifyReplicatedReduction<19u>(seed);
        failures += VerifyReplicatedReduction<20u>(seed);
        return failures;
    }
}

u32 VerifyReplicatedBenchmark(){
    const VerificationSweep verification = VerifyRoundingModes(ReplicatedRoundingVerifier());
    if(!verification.environmentAvailable)
        return verification.failures;
    const u32 failures = verification.failures;
    native(in failures){
        NWB_COUT << "verification failures=" << failures << " vector_cases=1376256\n";
    }
    return failures;
}

void NormalizeReplicatedDataset(in StringView opName, mut Dataset data){
    for(usize index = 0u; index < s_DataCount; ++index){
        mut f64x4 leftSlot = data.left[index];
        mut f64x4 rightSlot = data.right[index];
        if(opName == "normals2"){
            native(mut leftSlot, mut rightSlot){
                StoreDouble(VectorDouble2Normalize(LoadDouble(leftSlot)), leftSlot);
                StoreDouble(VectorDouble2Normalize(LoadDouble(rightSlot)), rightSlot);
            }
        }
        else if(opName == "normals3"){
            native(mut leftSlot, mut rightSlot){
                StoreDouble(VectorDouble3Normalize(LoadDouble(leftSlot)), leftSlot);
                StoreDouble(VectorDouble3Normalize(LoadDouble(rightSlot)), rightSlot);
            }
        }
        else if(opName == "normals4" || opName == "ln" || opName == "slerp"){
            native(mut leftSlot, mut rightSlot){
                StoreDouble(VectorDouble4Normalize(LoadDouble(leftSlot)), leftSlot);
                StoreDouble(VectorDouble4Normalize(LoadDouble(rightSlot)), rightSlot);
            }
        }
    }
}

void RunReplicatedVariant<const u32 KindIndex>(in Dataset data, in b8 candidate, in usize iterations, in b8 latency){
    const usize operations = iterations * 4u;
    SelectVariant(
        ReplicatedOperationName(KindIndex),
        candidate,
        latency,
        operations,
        ReplicatedWorkloadRunner<KindIndex, true>(data, iterations),
        ReplicatedWorkloadRunner<KindIndex, false>(data, iterations)
    );
}

i32 RunReplicatedBenchmarkCli(in Span<StringView> args){
    native(){
        NWB_COUT.precision(17);
    }
    if(args.size() == 2u && args[1] == "--verify"){
        if(VerifyReplicatedBenchmark() == 0u)
            return 0;
        return 1;
    }
    if(args.size() != 6u || args[1] != "--measure"){
        native(){
            NWB_CERR << "usage: replicated_benchmark --verify | --measure operation baseline|candidate iterations throughput\n";
        }
        return 2;
    }
    const Expected<MeasureOptions> options = ParseMeasureOptions(args[3], args[4], args[5], usize.max / 4u, false);
    if(!options.has_value())
        return 2;
    const b8 candidate = options.value().candidate;
    const b8 latency = options.value().latency;
    const usize iterations = options.value().iterations;

    Dataset data = Dataset();
    InitializeDataset(s_InitialSeed, data);
    NormalizeReplicatedDataset(args[2], data);

    const u32 count = cast<u32>(ReplicatedOperation::kCount);
    for(u32 index = 0u; index < count; ++index){
        if(args[2] != ReplicatedOperationName(index))
            continue;
        switch(index){
        case 0u: RunReplicatedVariant<0u>(data, candidate, iterations, latency); break;
        case 1u: RunReplicatedVariant<1u>(data, candidate, iterations, latency); break;
        case 2u: RunReplicatedVariant<2u>(data, candidate, iterations, latency); break;
        case 3u: RunReplicatedVariant<3u>(data, candidate, iterations, latency); break;
        case 4u: RunReplicatedVariant<4u>(data, candidate, iterations, latency); break;
        case 5u: RunReplicatedVariant<5u>(data, candidate, iterations, latency); break;
        case 6u: RunReplicatedVariant<6u>(data, candidate, iterations, latency); break;
        case 7u: RunReplicatedVariant<7u>(data, candidate, iterations, latency); break;
        case 8u: RunReplicatedVariant<8u>(data, candidate, iterations, latency); break;
        case 9u: RunReplicatedVariant<9u>(data, candidate, iterations, latency); break;
        case 10u: RunReplicatedVariant<10u>(data, candidate, iterations, latency); break;
        case 11u: RunReplicatedVariant<11u>(data, candidate, iterations, latency); break;
        case 12u: RunReplicatedVariant<12u>(data, candidate, iterations, latency); break;
        case 13u: RunReplicatedVariant<13u>(data, candidate, iterations, latency); break;
        case 14u: RunReplicatedVariant<14u>(data, candidate, iterations, latency); break;
        case 15u: RunReplicatedVariant<15u>(data, candidate, iterations, latency); break;
        case 16u: RunReplicatedVariant<16u>(data, candidate, iterations, latency); break;
        case 17u: RunReplicatedVariant<17u>(data, candidate, iterations, latency); break;
        case 18u: RunReplicatedVariant<18u>(data, candidate, iterations, latency); break;
        case 19u: RunReplicatedVariant<19u>(data, candidate, iterations, latency); break;
        case 20u: RunReplicatedVariant<20u>(data, candidate, iterations, latency); break;
        default: return 2;
        }
        return 0;
    }
    return 2;
}

native{
int main(const int argc, const char* const* argv){
    if(argc <= 0)
        return 2;
    Array<StringView, 8> args{};
    const usize count = Min(static_cast<usize>(argc), args.size());
    for(usize index = 0u; index < count; ++index)
        args[index] = StringView(argv[index]);
    return SimdOptimizationBenchmark::RunReplicatedBenchmarkCli(Span<const StringView>(args.data(), count));
}
}


