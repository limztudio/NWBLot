const Name s_MeshEmulationVsDebugName = "ECSRender_MeshEmulationVS";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsRejectedReusedEmulationOutputHandoff(
    in b8 emulationOutputReused,
    in b8 emulationOutputEntryStateGraphOwned,
    in b8 csgEmulationOutputEntryStateGraphOwned
){
    return emulationOutputReused && (!emulationOutputEntryStateGraphOwned || csgEmulationOutputEntryStateGraphOwned);
}

b8 UsesSplitEmulationTiming(
    in b8 emulationOutputEntryStateGraphOwned,
    in b8 csgEmulationOutputEntryStateGraphOwned,
    in b8 emulationOutputReused
){
    return (emulationOutputEntryStateGraphOwned || csgEmulationOutputEntryStateGraphOwned) && !emulationOutputReused;
}

u32 ApplyConservativeGeometryScissorFlag(in u32 dispatchFlags, in b8 conservativeGeometryScissor){
    if(conservativeGeometryScissor)
        return dispatchFlags & ~s_MeshDispatchFlagScissorCull;
    return dispatchFlags;
}

b8 IsValidIndexedEmulationByteOffset(in b8 indexedGeometryOutput, in u32 emulationIndexByteOffset){
    return !indexedGeometryOutput || emulationIndexByteOffset != 0u;
}

b8 IsCsgReceiverSurfacePassActive(in b8 csgClipActive, in MaterialPipelinePass pass){
    return csgClipActive && (pass == MaterialPipelinePass::Opaque || pass == MaterialPipelinePass::CsgReceiverSurface);
}

u32 ComputeObjectGeometryDecodeGroupCount(in u32 meshletCount){
    return Max(meshletCount, 1u);
}

b8 ValidateInstanceBufferAddressableCapacity(in usize capacity, in usize instanceStrideBytes){
    if(capacity <= usize.max / instanceStrideBytes)
        return true;

    error("RendererSystem: instance buffer capacity overflows addressable memory");
    return false;
}

Expected<usize> ValidateAndAlignMaterialTypedByteRequest(in usize byteCount, in usize wordByteSize){
    usize requiredByteCount = Max(byteCount, wordByteSize);
    auto alignedByteCount = AlignUpChecked(requiredByteCount, wordByteSize);
    if(!alignedByteCount.has_value()){
        error("RendererSystem: material typed buffer request overflows alignment");
        return MakeUnexpected(Failure());
    }
    if(alignedByteCount.value() > cast<usize>(u32.max)){
        error("RendererSystem: material typed buffer request exceeds u32 byte-offset limits");
        return MakeUnexpected(Failure());
    }
    return alignedByteCount.value();
}


