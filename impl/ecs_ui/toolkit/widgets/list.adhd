#include <impl/ecs_ui/toolkit/widgets/list_navigation.adhd>
#include <impl/ecs_ui/toolkit/input/input.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Keys are nonzero and unique within an instance. Lookups must avoid scanning the complete dataset per frame.
interface IListDataSource{
    u64 instanceGeneration()const;
    u64 revision()const;
    u64 rowCount()const;
    u64 key(in u64 index)const;
    Expected<u64> indexOf(in u64 key)const;
    // Inclusive search from start in the requested direction. Failure means no enabled row remains.
    Expected<u64> findEnabled(in u64 start, in b8 reverse)const;
    // Text may be temporary until the next source call. The list shapes or copies it first.
    StringView text(in u64 index)const;
    b8 enabled(in u64 index)const;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<ListKeyResolution> ResolveListKey(in IListDataSource source, in u64 count, in u64 key){
    if(key == 0u || count == 0u)
        return ListKeyResolution();
    const Expected<u64> index = source.indexOf(key);
    if(!index.has_value())
        return ListKeyResolution();
    if(index.value() >= count || source.key(index.value()) != key)
        return MakeUnexpected(Failure());
    return ListKeyResolution(index.value(), source.enabled(index.value()));
}

b8 MatchesListSource(in IListDataSource source, in u64 generation, in u64 revision){
    return generation != 0u && revision != 0u && source.instanceGeneration() == generation && source.revision() == revision;
}

b8 MatchesListSource(in IListDataSource source, in u64 generation, in u64 revision, in u64 count){
    return MatchesListSource(source, generation, revision) && source.rowCount() == count;
}

Expected<u64> FindListCursor(in IListDataSource source, in u64 count, in u64 cursor, in ControlAction action){
    if(count == 0u)
        return 0u;
    const Expected<ListKeyResolution> current = ResolveListKey(source, count, cursor);
    if(!current.has_value())
        return MakeUnexpected(current.error());
    const b8 reverse = IsReverseListControlAction(action.kind);
    const u64 start = ResolveListNavigationStartIndex(count, current.value(), action);
    const Expected<u64> index = source.findEnabled(start, reverse);
    if(!index.has_value())
        return 0u;
    if(!ValidateListEnabledSearchIndex(index.value(), count, start, reverse))
        return MakeUnexpected(Failure());
    const u64 key = source.key(index.value());
    if(key == 0u)
        return MakeUnexpected(Failure());
    const Expected<ListKeyResolution> resolved = ResolveListKey(source, count, key);
    if(!resolved.has_value() || !resolved.value().present || resolved.value().index != index.value())
        return MakeUnexpected(Failure());
    return key;
}

b8 ReconcileListState(mut ListState state, in IListDataSource source){
    const u64 inputGeneration = state.m_inputGeneration;
    const u64 generation = source.instanceGeneration();
    const u64 revision = source.revision();
    if(generation == 0u || revision == 0u)
        return false;
    const b8 replacement = state.m_sourceGeneration != 0u && state.m_sourceGeneration != generation;
    u64 selected = 0u;
    u64 cursor = 0u;
    if(!replacement){
        selected = state.m_selected;
        cursor = state.m_cursor;
    }
    const u64 count = source.rowCount();
    const Expected<ListKeyResolution> selectedResolution = ResolveListKey(source, count, selected);
    if(!selectedResolution.has_value())
        return false;
    b8 cursorPresent = selectedResolution.value().present;
    if(cursor != selected){
        const Expected<ListKeyResolution> cursorResolution = ResolveListKey(source, count, cursor);
        if(!cursorResolution.has_value())
            return false;
        cursorPresent = cursorResolution.value().present;
    }
    if(!MatchesListSource(source, generation, revision) || state.m_inputGeneration != inputGeneration)
        return false;
    if(replacement && !state.m_scroll.setOffset(0.0))
        return false;
    CommitListReconcileState(
        generation,
        revision,
        selectedResolution.value().present,
        cursorPresent,
        selected,
        cursor,
        state.m_selected,
        state.m_cursor,
        state.m_ensureCursor,
        state.m_sourceGeneration,
        state.m_sourceRevision
    );
    return true;
}

b8 ApplyListControlAction(in IListDataSource source, in ListOptions options, in ControlAction action, mut ListState state, mut ListResult result){
    const u64 inputGeneration = state.m_inputGeneration;
    ControlToken token;
    token.instanceGeneration = inputGeneration;
    token.contentGeneration = state.m_sourceGeneration;
    token.contentRevision = state.m_sourceRevision;
    if(
        !ValidateListControlActionHeader(options, token, action)
        || !MatchesListSource(source, token.contentGeneration, token.contentRevision)
        || state.m_inputGeneration != inputGeneration
    )
        return false;
    if(action.kind == ControlActionKind::Wheel){
        const Expected<f64> offset = TryComputeListWheelOffset(state.m_scroll.offset(), action.delta, action.step, action.maximum);
        if(!offset.has_value() || state.m_inputGeneration != inputGeneration || !state.m_scroll.setOffset(offset.value()))
            return false;
        state.m_ensureCursor = false;
        result.valid = true;
        return true;
    }
    const u64 count = source.rowCount();
    u64 candidate = 0u;
    const b8 activate = action.kind == ControlActionKind::Activate || action.kind == ControlActionKind::Submit;
    if(activate){
        candidate = state.m_cursor;
        if(action.kind == ControlActionKind::Activate)
            candidate = action.value;
        const Expected<ListKeyResolution> resolved = ResolveListKey(source, count, candidate);
        if(!resolved.has_value())
            return false;
        if(!resolved.value().present){
            if(action.kind == ControlActionKind::Activate)
                return false;
            candidate = 0u;
        }
    }
    else{
        const Expected<u64> cursor = FindListCursor(source, count, state.m_cursor, action);
        if(!cursor.has_value())
            return false;
        candidate = cursor.value();
    }
    if(!MatchesListSource(source, token.contentGeneration, token.contentRevision) || state.m_inputGeneration != inputGeneration)
        return false;
    ApplyListCandidateSelection(options, activate, candidate, state.m_selected, state.m_cursor, state.m_ensureCursor, result);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

