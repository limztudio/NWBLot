interface IUiSmokeScene{
    b8 paint(mut UiPaintContext context);
}

interface IUiSmokeInputScene : IUiSmokeScene{
    b8 keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods);
}


StringView FormatSmokeRowLabel(in u64 rowKey, mut CompactString label){
    if(rowKey == 0u)
        return "";
    label.assign("Row ");
    AppendUnsignedDecimal(label, rowKey);
    return label.view();
}


class UiListSmokeSource : IListDataSource, NoCopy{
    private UiListSmokeSourceState m_storage;
    private mut UiListSmokeSourceState m_state;
    private CompactString m_buffer;
    private mut CompactString m_label;

    public UiListSmokeSource(){
        this.m_state = this.m_storage;
        this.m_label = this.m_buffer;
    }

    public u64 instanceGeneration()const override{ return this.m_state.instanceGeneration(); }
    public u64 revision()const override{ return this.m_state.revision(); }
    public u64 rowCount()const override{ return this.m_state.rowCount(); }
    public u64 key(in u64 index)const override{ return this.m_state.key(index); }
    public Expected<u64> indexOf(in u64 keyValue)const override{ return this.m_state.indexOf(keyValue); }
    public Expected<u64> findEnabled(in u64 start, in b8 reverse)const override{ return this.m_state.findEnabled(start, reverse); }
    public StringView text(in u64 index)const override{ return FormatSmokeRowLabel(this.m_state.readRowKey(index), this.m_label); }
    public b8 enabled(in u64 index)const override{ return this.m_state.enabled(index); }
    public void reverse(){ this.m_state.reverse(); }
    public void remove(in u64 keyValue){ this.m_state.remove(keyValue); }
    public void beginFrame(){ this.m_state.beginFrame(); }
    public b8 reversed()const{ return this.m_state.reversed(); }
    public u64 removedKey()const{ return this.m_state.removedKey(); }
    public u32 labelReads()const{ return this.m_state.labelReads(); }
}


