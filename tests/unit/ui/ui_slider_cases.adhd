void VerifyUiSliderPopupTests_AncestorClosureBeforePaintSuppressesCallbacksAndRetiresTheOldChildDrag(mut UiSliderPopupTests self){
    ASSERT_TRUE(self.acceptFamily(1u));
    const Point origin = CenterUiRect(self.m_childState.placement().thumb);
    const Point moved = Point(origin.x + 60.0f, origin.y);
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(origin, InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(moved, InputEventType::PointerMove)).pointerConsumed);
    ASSERT_TRUE(self.beginParent(2u));
    ASSERT_TRUE(self.beginChild());
    self.m_laterSource.clearCounters();
    ASSERT_TRUE(self.sibling());
    self.m_parent.close();
    ASSERT_TRUE(self.m_builder.endPopup());
    ASSERT_TRUE(self.finishParent());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_laterSource.m_calls, 0u);
    EXPECT_DOUBLE_EQ(self.m_childState.value(), 0.5);
    EXPECT_FALSE(self.m_childState.result().valid);
    EXPECT_EQ(self.m_context.input().popupCount(), 0u);
    EXPECT_FALSE(self.m_context.input().capture().valid());
    self.m_parent.open();
    ASSERT_TRUE(self.beginParent(3u));
    EXPECT_FALSE(self.m_builder.beginPopup(s_UiSliderChildPopupKey, self.m_child, MakeNestedChildPopupOptions()));
    EXPECT_FALSE(self.m_child.isOpen());
    ASSERT_TRUE(self.finishParent());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    self.m_child.open();
    ASSERT_TRUE(self.acceptFamily(4u));
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(moved, InputEventType::PrimaryUp)).pointerConsumed);
    ASSERT_TRUE(self.acceptFamily(5u));
    EXPECT_DOUBLE_EQ(self.m_childState.value(), 0.5);
    EXPECT_FALSE(self.m_childState.result().valueChanged);
    EXPECT_FALSE(self.m_childState.result().dragging);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyUiSliderStateTests_IdenticalFinitePublicValuesRetireCopiedInputAndAdvanceRevision(){
    SliderState state = SliderState();
    ASSERT_TRUE(state.setValue(2.0));
    const SliderSnapshot before = state.snapshot();
    ASSERT_TRUE(state.setValue(2.0));
    EXPECT_EQ(state.value(), 2.0);
    EXPECT_EQ(state.instanceGeneration(), before.instanceGeneration);
    EXPECT_NE(state.inputGeneration(), before.inputGeneration);
    EXPECT_EQ(state.revision(), before.revision + 1u);
    EXPECT_EQ(state.admissionGeneration(), before.admissionGeneration);
    EXPECT_FALSE(state.matches(before));
}

void VerifyUiSliderStateTests_PublicValuesPreserveSignedZeroBitsAndRetireIdenticalSignedZeroIntents(){
    SliderState state = SliderState();
    const f64 negZero = bit_cast<f64>(s_UiSliderNegZeroF64Bits);
    ASSERT_TRUE(state.setValue(negZero));
    const SliderSnapshot negative = state.snapshot();
    EXPECT_EQ(negative.valueBits, s_UiSliderNegZeroF64Bits);
    ASSERT_TRUE(state.setValue(negZero));
    EXPECT_EQ(bit_cast<u64>(state.value()), negative.valueBits);
    EXPECT_NE(state.inputGeneration(), negative.inputGeneration);
    ASSERT_TRUE(state.setValue(0.0));
    EXPECT_EQ(bit_cast<u64>(state.value()), 0u);
    EXPECT_EQ(state.revision(), negative.revision + 2u);
}

void VerifyUiSliderStateTests_ValueAwayAndBackCannotRestoreTheOldSnapshot(){
    SliderState state = SliderState();
    ASSERT_TRUE(state.setValue(2.0));
    const SliderSnapshot before = state.snapshot();
    ASSERT_TRUE(state.setValue(3.0));
    ASSERT_TRUE(state.setValue(2.0));
    EXPECT_EQ(bit_cast<u64>(state.value()), before.valueBits);
    EXPECT_NE(state.inputGeneration(), before.inputGeneration);
    EXPECT_EQ(state.revision(), before.revision + 2u);
    EXPECT_FALSE(state.matches(before));
}

void VerifyUiSliderStateTests_NonfinitePublicValuesAreRejectedAtomically(){
    SliderState state = SliderState();
    ASSERT_TRUE(state.setValue(bit_cast<f64>(s_UiSliderNegZeroF64Bits)));
    const SliderSnapshot before = state.snapshot();
    Array<f64, 3u> invalids;
    invalids[0u] = bit_cast<f64>(s_UiSliderQuietNaNF64Bits);
    invalids[1u] = bit_cast<f64>(s_UiSliderPosInfF64Bits);
    invalids[2u] = bit_cast<f64>(s_UiSliderNegInfF64Bits);
    for(in f64 invalid : invalids){
        EXPECT_FALSE(state.setValue(invalid));
        EXPECT_TRUE(state.matches(before));
    }
}


