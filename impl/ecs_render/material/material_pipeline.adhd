[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/material/generated_geometry_validation.adhd.h>
#include <impl/ecs_render/material/material_internal.adhd.h>
#include <impl/ecs_render/material/material_system.adhd.h>
#include <impl/ecs_render/material/renderer_material_state.adhd.h>
#include <impl/ecs_render/material/renderer_render_state_private.adhd.h>
#include <impl/ecs_render/material/task_graph_compute_emulation_plan.adhd.h>
#include <impl/ecs_render/material/task_graph_opaque_compute_emulation_plan.adhd.h>
#include <impl/ecs_render/avboit/avboit_raster_configuration.adhd.h>
#include <impl/ecs_render/kernel/compute_pipeline_utils.adhd.h>
#include <impl/ecs_render/shader/shader_system.adhd.h>
#include <impl/assets_graphics/csg_subsystem.adhd.h>
#include <impl/assets_graphics/mesh_subsystem.adhd.h>
#include <impl/assets_shader/asset.adhd.h>
#include <impl/ecs_csg/shape_registry.adhd.h>

#include <core/common/log.h>
#include <core/graphics/backend_selection.h>
#include <core/graphics/runtime/runtime.h>
#include <core/graphics/shader_archive.h>
#include <core/graphics/shader_stage_names.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_material_pipeline{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] Expected<Core::GraphicsString> ResolveCsgProjectEvaluatorModuleInclude(Core::GraphicsArena& arena, const CsgShapeRegistry& shapeRegistry, const Name& evaluatorVariant){
    if(!evaluatorVariant)
        return Core::GraphicsString(arena);
    auto moduleInclude = shapeRegistry.findShaderModuleInclude(evaluatorVariant, arena);
    if(!moduleInclude || moduleInclude->empty())
        return MakeUnexpected(Failure{});
    return moduleInclude;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<NotNull<MaterialPipelineResources*>> RendererMaterialSystem::createRendererPipeline(const MaterialSurfaceInfo& materialInfo, const MaterialPipelineKey& pipelineKey, Core::Framebuffer& framebuffer){
    const Name& materialKey = materialInfo.materialName;
    const MaterialPipelinePass::Enum pass = pipelineKey.pass;
    FOUNDATION_ASSERT(materialKey);

    auto [it, inserted] = m_materialState.m_pipelines.try_emplace(pipelineKey);
    MaterialPipelineResources& resources = it.value();
    if(resources.ready())
        return MakeNotNull(&resources);

    auto removeFailedEntry = [&]()noexcept{
        if(inserted)
            m_materialState.m_pipelines.erase(it);
    };
    auto failMaterialPipeline = [&]()noexcept{
        removeFailedEntry();
        return MakeUnexpected(Failure{});
    };

    FOUNDATION_ASSERT(!materialInfo.shaderVariant.empty());
    const AStringView shaderVariant(materialInfo.shaderVariant.data(), materialInfo.shaderVariant.size());
    Core::GraphicsString csgShaderVariant(m_arena);
    Core::GraphicsString avboitCsgShaderVariant(m_arena);
    const MaterialPipelineCsgBindingUse csgBindingUse = MaterialPipelineResolveCsgBindingUse(pipelineKey.csgMode, pass);
    const b8 csgClipPipeline = csgBindingUse.clip;
    const b8 avboitCsgClipPipeline = csgBindingUse.avboitClip;
    Core::GraphicsString csgProjectEvaluatorModuleAssignment(m_arena);
    AStringView materialProjectEvaluatorModuleAssignmentToAdd;
    AStringView avboitProjectEvaluatorModuleAssignmentToAdd;
    if(csgClipPipeline){
        const auto csgProjectEvaluatorModuleInclude = __hidden_material_pipeline::ResolveCsgProjectEvaluatorModuleInclude(m_arena, m_csgShapeRegistry, pipelineKey.csgEvaluatorVariant);
        if(!csgProjectEvaluatorModuleInclude){
            LogCsgEvaluatorModuleResolveFailed(materialKey);
            return failMaterialPipeline();
        }
        csgProjectEvaluatorModuleAssignment.assign(AStringView(CsgShaderVariantBuilder().buildEvaluatorAssignment(m_arena, AStringView(*csgProjectEvaluatorModuleInclude))));
        if(!csgProjectEvaluatorModuleAssignment.empty()){
            const Expected<AStringView> existingEvaluatorModuleAssignment = CsgShaderVariantBuilder().findDefineAssignment(shaderVariant, s_CsgProjectEvaluatorModuleDefineName, Core::ShaderArchive::s_DefaultVariant);
            if(existingEvaluatorModuleAssignment && !ValidateMaterialEvaluatorModuleMatch(*existingEvaluatorModuleAssignment, AStringView(csgProjectEvaluatorModuleAssignment), materialKey))
                return failMaterialPipeline();
            if(!existingEvaluatorModuleAssignment)
                materialProjectEvaluatorModuleAssignmentToAdd = csgProjectEvaluatorModuleAssignment;
            avboitProjectEvaluatorModuleAssignmentToAdd = csgProjectEvaluatorModuleAssignment;
        }
    }
    if(csgClipPipeline && !avboitCsgClipPipeline){
        auto variant = CsgShaderVariantBuilder().buildVariant(m_arena, shaderVariant, Core::ShaderArchive::s_DefaultVariant, materialProjectEvaluatorModuleAssignmentToAdd);
        if(!variant){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: failed to build CSG shader variant for material '{}'"), ConvertString(materialKey.resolvedText()));
            return failMaterialPipeline();
        }
        csgShaderVariant.assign(AStringView(*variant));
    }

    if(avboitCsgClipPipeline){
        auto variant = CsgShaderVariantBuilder().buildVariant(m_arena, shaderVariant, Core::ShaderArchive::s_DefaultVariant, materialProjectEvaluatorModuleAssignmentToAdd);
        if(!variant){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: failed to build AVBOIT CSG mesh shader variant for material '{}'"), ConvertString(materialKey.resolvedText()));
            return failMaterialPipeline();
        }
        csgShaderVariant.assign(AStringView(*variant));
    }

    if(avboitCsgClipPipeline){
        auto variant = CsgShaderVariantBuilder().buildVariant(m_arena, Core::ShaderArchive::s_DefaultVariant, Core::ShaderArchive::s_DefaultVariant, avboitProjectEvaluatorModuleAssignmentToAdd);
        if(!variant){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: failed to build AVBOIT CSG pixel shader variant for material '{}'"), ConvertString(materialKey.resolvedText()));
            return failMaterialPipeline();
        }
        avboitCsgShaderVariant.assign(AStringView(*variant));
    }
    const AStringView pixelShaderVariant = SelectMaterialPassPixelShaderVariant(csgClipPipeline, avboitCsgClipPipeline, AStringView(csgShaderVariant), shaderVariant);
    const AStringView meshShaderVariant = SelectMaterialPassMeshShaderVariant(csgClipPipeline, AStringView(csgShaderVariant), shaderVariant);

    const Name sharedMeshShaderAssetName = m_shaderSystem.resolveSubsystemAsset<MeshSubsystem, MeshShader>(SubsystemAssetSelector<MeshSubsystem, MeshShader>([](const MeshSubsystem& s){ return s.sharedMs; }));
    const Name objectVertexShaderAssetName = m_shaderSystem.resolveSubsystemAsset<MeshSubsystem, VertexShader>(SubsystemAssetSelector<MeshSubsystem, VertexShader>([](const MeshSubsystem& s){ return s.objectVs; }));
    const b8 sharedObjectGeometry = UsesSharedMaterialMeshShader(sharedMeshShaderAssetName, materialInfo.meshShader, shaderVariant, Core::ShaderArchive::s_DefaultVariant);

    Name passPixelShaderName = s_NameNone;
    Name passPixelShaderDebugName = s_InvalidPassPixelShaderDebugName;
    MaterialPipelineAvboitPixelShaderSelection avboitPixelShaderSelection;
    if(MaterialPipelinePassUsesRendererAvboit(pass)){
        avboitPixelShaderSelection = SelectAvboitPixelShader(
            pass,
            materialInfo.avboitOccupancyPixelShader,
            materialInfo.avboitExtinctionPixelShader,
            materialInfo.avboitAccumulatePixelShader
        );
        FOUNDATION_ASSERT(!materialInfo.transparent || avboitPixelShaderSelection.materialDriven());
    }
    switch(pass){
    case MaterialPipelinePass::Opaque:
    case MaterialPipelinePass::CsgReceiverSurface:
        break;
    case MaterialPipelinePass::AvboitOccupancy:
    case MaterialPipelinePass::AvboitExtinction:
    case MaterialPipelinePass::AvboitAccumulate:
    case MaterialPipelinePass::AvboitRefractionCapture:
        passPixelShaderName = avboitPixelShaderSelection.shaderName();
        passPixelShaderDebugName = avboitPixelShaderSelection.debugName;
        break;
    default:
        break;
    }

    auto& device = m_graphics.getDevice();
    const Core::RenderState renderState = BuildRenderStateForPass(pass, pipelineKey.twoSided);
    Core::GpuDescriptorHeap& heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: material geometry pipeline requires the global descriptor heap"));
        return failMaterialPipeline();
    }
    const auto materialPassBindingLayout = prepareMaterialPassBindingLayout();
    if(!materialPassBindingLayout)
        return failMaterialPipeline();

    const MaterialPipelineBuildInputs buildInputs{
        .system = *this,
        .shaderSystem = m_shaderSystem,
        .materialState = m_materialState,
        .resources = resources,
        .materialInfo = materialInfo,
        .pipelineKey = pipelineKey,
        .framebuffer = framebuffer,
        .device = device,
        .heap = heap,
        .renderState = renderState,
        .materialPassBindingLayout = *materialPassBindingLayout,
        .materialKey = materialKey,
        .sharedMeshShaderAssetName = sharedMeshShaderAssetName,
        .passPixelShaderName = passPixelShaderName,
        .passPixelShaderDebugName = passPixelShaderDebugName,
        .pixelShaderVariant = pixelShaderVariant,
        .meshShaderVariant = meshShaderVariant,
        .avboitCsgShaderVariant = AStringView(avboitCsgShaderVariant),
        .pass = pass,
        .avboitCsgClipPipeline = avboitCsgClipPipeline,
    };
    MaterialPipelineBuilder pipelineBuilder(buildInputs);

    const b8 meshSupported = m_graphics.queryFeatureSupport(Core::Feature::Meshlets);
    // Surface info admission already requires the mesh shader and the opaque pixel shader.
    FOUNDATION_ASSERT(pass != MaterialPipelinePass::Opaque || materialInfo.pixelShader.valid());
    FOUNDATION_ASSERT(materialInfo.meshShader.valid());

    if(meshSupported){
        if(!pipelineBuilder.buildMesh()){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: failed to create the required mesh rendering path for material '{}' on a mesh-capable device"), ConvertString(materialKey.resolvedText()));
            return failMaterialPipeline();
        }

        logMaterialRenderPathDecision(materialKey, resources.renderPath, meshSupported);
        return MakeNotNull(&resources);
    }

    const b8 hasVertexArchiveStage = objectVertexShaderAssetName
        && m_shaderSystem.hasShaderArchiveStage(objectVertexShaderAssetName, Core::ShaderArchive::s_DefaultVariant, Core::ShaderStageNames::ArchiveStageNameFromShaderType(Core::ShaderType::VertexStage))
    ;
    if(CanBuildIndexedObjectGeometryPipeline(sharedObjectGeometry, objectVertexShaderAssetName, hasVertexArchiveStage)){
        if(!pipelineBuilder.buildIndexed())
            return failMaterialPipeline();
    }
    else if(!pipelineBuilder.buildCompute()){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: failed to create compute-emulation rendering path for material '{}' from its mesh shader"), ConvertString(materialKey.resolvedText()));
        return failMaterialPipeline();
    }

    logMaterialRenderPathDecision(materialKey, resources.renderPath, meshSupported);
    return MakeNotNull(&resources);
}

Expected<NotNull<MaterialPipelineResources*>> RendererMaterialSystem::findRendererPipeline(const MaterialPipelineKey& pipelineKey)noexcept{
    const auto foundPipeline = m_materialState.m_pipelines.find(pipelineKey);
    if(foundPipeline == m_materialState.m_pipelines.end())
        return MakeUnexpected(Failure{});

    MaterialPipelineResources& resources = foundPipeline.value();
    if(!resources.ready())
        return MakeUnexpected(Failure{});

    return MakeNotNull(&resources);
}

void RendererMaterialSystem::invalidateRendererPipelines()noexcept{
    m_materialState.m_pipelines.clear();
    m_materialState.m_objectGeometryDecodeShader.reset();
    m_materialState.m_objectGeometryDecodePipeline.reset();
    m_materialState.m_objectGeometryInputLayout.reset();
}

void RendererMaterialSystem::logMaterialRenderPathDecision(const Name& materialKey, const RenderPath::Enum renderPath, const b8 meshSupported){
    auto [it, inserted] = m_materialState.m_loggedMaterialPaths.try_emplace(materialKey, renderPath);
    if(!inserted){
        if(it.value() == renderPath)
            return;
        it.value() = renderPath;
    }

    LogMaterialRenderPathDecision(materialKey, renderPath, meshSupported);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MaterialPipelineBuilder::loadPassPixelShader()noexcept{
    const MaterialPipelineBuildInputs& inputs = *m_inputs;
    if(inputs.pass == MaterialPipelinePass::Opaque)
        return inputs.shaderSystem.loadShader<PixelShader>(inputs.materialInfo.pixelShader.name(), inputs.pixelShaderVariant, s_RendererPsDebugName, inputs.resources.pixelShader);
    if(inputs.pass == MaterialPipelinePass::CsgReceiverSurface)
        return inputs.shaderSystem.loadShader<PixelShader, CsgSubsystem>(SubsystemAssetSelector<CsgSubsystem, PixelShader>([](const CsgSubsystem& s){ return s.receiverSurfacePs; }), Core::ShaderArchive::s_DefaultVariant, s_CsgReceiverSurfacePsDebugName, inputs.resources.pixelShader);
    if(inputs.avboitCsgClipPipeline)
        return inputs.shaderSystem.loadShader<PixelShader>(inputs.passPixelShaderName, AStringView(inputs.avboitCsgShaderVariant), inputs.passPixelShaderDebugName, inputs.resources.pixelShader);
    // AVBOIT pixel shaders are generated per material with its binding/surface contract; load the resolved pass shader at its default variant.
    return inputs.shaderSystem.loadShader<PixelShader>(inputs.passPixelShaderName, Core::ShaderArchive::s_DefaultVariant, inputs.passPixelShaderDebugName, inputs.resources.pixelShader);
}

b8 MaterialPipelineBuilder::buildMesh()noexcept{
    const MaterialPipelineBuildInputs& inputs = *m_inputs;
    if(!inputs.shaderSystem.loadShader<MeshShader>(inputs.materialInfo.meshShader.name(), inputs.meshShaderVariant, s_RendererMeshDebugName, inputs.resources.meshShader))
        return false;
    if(!loadPassPixelShader())
        return false;

    Core::MeshletPipelineDesc pipelineDesc;
    pipelineDesc.setMeshShader(inputs.resources.meshShader);
    pipelineDesc.setPixelShader(inputs.resources.pixelShader);
    pipelineDesc.setRenderState(inputs.renderState);
    // Set 0 is the shared push-only range; all CSG and AVBOIT resources are selected through the global heap.
    pipelineDesc.addBindingLayout(inputs.materialPassBindingLayout);
    // Keep both fixed heap layouts in every mesh pipeline; samplers are frozen surface.
    pipelineDesc.addBindingLayout(inputs.heap.getResourceLayout()).addBindingLayout(inputs.heap.getSamplerLayout());

    auto meshletPipelineResult = inputs.device.createMeshletPipeline(pipelineDesc, inputs.framebuffer.getFramebufferInfo());
    if(meshletPipelineResult)
        inputs.resources.meshletPipeline = Move(*meshletPipelineResult);
    else
        inputs.resources.meshletPipeline.reset();
    if(!meshletPipelineResult){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: failed to create meshlet pipeline for material '{}'"), ConvertString(inputs.materialKey.resolvedText()));
        return false;
    }

    inputs.resources.renderPath = RenderPath::MeshShader;
    return true;
}

b8 MaterialPipelineBuilder::buildIndexed()noexcept{
    const MaterialPipelineBuildInputs& inputs = *m_inputs;
    if(!inputs.system.createObjectGeometryPipelineResources(inputs.resources))
        return false;
    if(!loadPassPixelShader())
        return false;
    Core::GraphicsPipelineDesc desc;
    desc
        .setInputLayout(inputs.materialState.m_objectGeometryInputLayout)
        .setVertexShader(inputs.resources.objectGeometryVertexShader)
        .setPixelShader(inputs.resources.pixelShader)
        .setRenderState(inputs.renderState)
        .addBindingLayout(inputs.materialPassBindingLayout)
        .addBindingLayout(inputs.heap.getResourceLayout())
        .addBindingLayout(inputs.heap.getSamplerLayout())
    ;
    auto indexedPipelineResult = inputs.device.createGraphicsPipeline(desc, inputs.framebuffer.getFramebufferInfo());
    if(indexedPipelineResult)
        inputs.resources.indexedPipeline = Move(*indexedPipelineResult);
    else
        inputs.resources.indexedPipeline.reset();
    if(!indexedPipelineResult){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: failed to create indexed object geometry pipeline for material '{}'"), ConvertString(inputs.materialKey.resolvedText()));
        return false;
    }
    inputs.resources.renderPath = RenderPath::VertexIndexed;
    return true;
}

b8 MaterialPipelineBuilder::buildCompute()noexcept{
    const MaterialPipelineBuildInputs& inputs = *m_inputs;
    if(!inputs.system.createComputeEmulationResources())
        return false;
    FOUNDATION_ASSERT(inputs.materialState.m_computeBindingLayout);
    FOUNDATION_ASSERT(inputs.materialState.m_emulationVertexShader);
    FOUNDATION_ASSERT(inputs.materialState.m_emulationInputLayout);
    const Name& meshComputeArchiveStageName = ShaderBinaryPayload::s_MeshComputeArchiveStageName;
    if(!inputs.shaderSystem.loadShader<ComputeShader>(inputs.materialInfo.meshShader.name(), inputs.meshShaderVariant, s_RendererCsDebugName, meshComputeArchiveStageName, inputs.resources.computeShader))
        return false;
    if(!loadPassPixelShader())
        return false;
    // The compute-emulation mesh stage shares the mesh-shader source-stream runtime, so it needs the persistent tables too.
    if(!CreateHeapComputePipeline(inputs.device, inputs.resources.computeShader, inputs.materialState.m_computeBindingLayout, false, inputs.resources.computePipeline)){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: failed to create compute pipeline for material '{}'"), ConvertString(inputs.materialKey.resolvedText()));
        return false;
    }

    Core::GraphicsPipelineDesc emulationDesc;
    emulationDesc.setInputLayout(inputs.materialState.m_emulationInputLayout);
    emulationDesc.setVertexShader(inputs.materialState.m_emulationVertexShader);
    emulationDesc.setPixelShader(inputs.resources.pixelShader);
    emulationDesc.setRenderState(inputs.renderState);
    emulationDesc.addBindingLayout(inputs.materialPassBindingLayout);
    emulationDesc.addBindingLayout(inputs.heap.getResourceLayout()).addBindingLayout(inputs.heap.getSamplerLayout());
    auto emulationPipelineResult = inputs.device.createGraphicsPipeline(emulationDesc, inputs.framebuffer.getFramebufferInfo());
    if(emulationPipelineResult)
        inputs.resources.emulationPipeline = Move(*emulationPipelineResult);
    else
        inputs.resources.emulationPipeline.reset();
    if(!emulationPipelineResult){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: failed to create emulation graphics pipeline for material '{}'"), ConvertString(inputs.materialKey.resolvedText()));
        inputs.resources.computePipeline.reset();
        return false;
    }

    inputs.resources.renderPath = RenderPath::ComputeEmulation;
    // The shared mesh_compute program is independent of authored materials.
    inputs.resources.sharedGeometryComputeProgram = IsSharedComputeEmulationProgram(
        inputs.pipelineKey.csgMode,
        inputs.sharedMeshShaderAssetName,
        inputs.materialInfo.meshShader,
        inputs.meshShaderVariant,
        Core::ShaderArchive::s_DefaultVariant
    );
    inputs.resources.indexedGeometryOutput = inputs.resources.sharedGeometryComputeProgram;
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace ECSRenderDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MatchesRetainedGeneratedGeometryOutputs(
    const b8 captured,
    const Span<const MaterialPassDrawItem> drawItems,
    const Span<const Core::BufferHandle> outputBuffers,
    const Span<const GeneratedGeometryOutputLayout> outputLayouts,
    const Span<const u32> outputHeapSlots
)noexcept{
    if(!captured || outputBuffers.size() != drawItems.size() || outputLayouts.size() != drawItems.size() || outputHeapSlots.size() != drawItems.size())
        return false;
    for(usize drawIndex = 0u; drawIndex < drawItems.size(); ++drawIndex){
        const MaterialPassMeshResourceSnapshot& mesh = drawItems[drawIndex].meshResources;
        if(
            !mesh.emulationVertexBuffer
            || !mesh.emulationVertexHeapHandle.valid()
            || mesh.emulationVertexBuffer.get() != outputBuffers[drawIndex].get()
            || !outputLayouts[drawIndex].matches(mesh.emulationIndexByteOffset, drawItems[drawIndex].pipelineResources.indexedGeometryOutput)
            || mesh.emulationVertexHeapHandle.slot() != outputHeapSlots[drawIndex]
        )
            return false;
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void AliasFreeComputeEmulationGraphPlan::reset()noexcept{
    drawItems.clear();
    outputBuffers.clear();
    outputLayouts.clear();
    outputHeapSlots.clear();
    captured = false;
}

b8 AliasFreeComputeEmulationGraphPlan::capture(const MaterialPassDrawItemsView& sourceDrawItems, Core::Alloc::ScratchArena& scratchArena){
    reset();
    if(sourceDrawItems.computeDrawItems.empty())
        return false;

    if(!CaptureAliasFreeGeneratedGeometryDraws(sourceDrawItems, [](const MaterialPipelineCsgMode::Enum mode)noexcept{ return mode == MaterialPipelineCsgMode::None; }, *this, scratchArena)){
        reset();
        return false;
    }
    captured = IsAliasFreeCaptureCountConsistent(drawItems.size(), outputBuffers.size(), outputHeapSlots.size());
    return captured;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void OpaqueRegularComputeEmulationGraphPlan::reset()noexcept{
    meshDrawItems.clear();
    indexedDrawItems.clear();
    AliasFreeComputeEmulationGraphPlan::reset();
}

b8 OpaqueRegularComputeEmulationGraphPlan::capture(const MaterialPassDrawItemsView& sourceDrawItems, Core::Alloc::ScratchArena& scratchArena){
    reset();
    if(sourceDrawItems.computeDrawItems.empty())
        return false;

    meshDrawItems.reserve(sourceDrawItems.meshDrawItems.size());
    meshDrawItems.assign(sourceDrawItems.meshDrawItems.begin(), sourceDrawItems.meshDrawItems.end());
    indexedDrawItems.reserve(sourceDrawItems.indexedDrawItems.size());
    indexedDrawItems.assign(sourceDrawItems.indexedDrawItems.begin(), sourceDrawItems.indexedDrawItems.end());
    if(!AliasFreeComputeEmulationGraphPlan::capture(sourceDrawItems, scratchArena)){
        reset();
        return false;
    }
    return captured;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


