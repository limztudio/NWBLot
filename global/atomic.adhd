[cpp_name("::AtomicSignalFence")]
extern void AtomicSignalFence(in auto a0);

[cpp_name("::AtomicThreadFence")]
extern void AtomicThreadFence(in auto a0);

[cpp_name("::DecrementAtomicOrTerminate")]
extern u64 DecrementAtomicOrTerminate(mut auto a0);

[cpp_name("::UpdateAtomicMaxRelaxed")]
extern void UpdateAtomicMaxRelaxed(mut auto a0, in auto a1);


