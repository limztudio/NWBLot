////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <logger/server/crash_values.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsAndroidTombstoneFrameLine(in StringView trimmedLine){
    if(trimmedLine.size() < s_CrashSymbolicateAndroidAndroidTombstoneFrameMinimumTextLength)
        return false;
    if(trimmedLine.front() != 35u)
        return false;
    return trimmedLine.find(s_CrashSymbolicateAndroidTombstoneProgramCounterToken) < trimmedLine.size();
}

StringView SelectAndroidTombstoneStatusLine(in b8 hasFrames){
    if(hasFrames)
        return s_CrashSymbolicateAndroidAndroidTombstoneParsedStatus;
    return s_CrashSymbolicateAndroidAndroidTombstoneUndecodedStatus;
}

StringView SelectAndroidTombstoneDetailLine(in b8 hasFrames){
    if(hasFrames)
        return s_CrashSymbolicateAndroidAndroidTombstoneFramesDetail;
    return s_CrashSymbolicateAndroidAndroidTombstoneNoFramesDetail;
}

void AppendParsedAndroidTombstoneReport(in b8 tombstonePresent, in StringView tombstoneText, mut String outReport){
    if(!tombstonePresent || tombstoneText.empty()){
        outReport.append(s_CrashSymbolicateAndroidAndroidTombstoneMissingReport);
        return;
    }

    String frames;
    frames.reserve(tombstoneText.size() + 1u);
    usize cursor = 0u;
    while(true){
        const Expected<StringView> line = NextTextLine(tombstoneText, cursor);
        if(!line.has_value())
            break;
        const StringView trimmed = TrimLeftView(line.value());
        if(!IsAndroidTombstoneFrameLine(trimmed))
            continue;

        frames.append(trimmed);
        frames.append("\n");
    }

    const b8 hasFrames = !frames.empty();
    outReport.append(SelectAndroidTombstoneStatusLine(hasFrames));
    outReport.append(s_CrashSymbolicateAndroidAndroidTombstoneResolverLine);
    outReport.append(s_CrashSymbolicateAndroidAndroidTombstonePresentLine);
    outReport.append(SelectAndroidTombstoneDetailLine(hasFrames));

    if(hasFrames){
        outReport.append(s_CrashSymbolicateAndroidTombstoneCallstackSectionHeader);
        outReport.append(frames);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

