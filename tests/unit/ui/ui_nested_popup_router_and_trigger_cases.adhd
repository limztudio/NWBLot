Rect MakeUiNestedPopupRouterRect(in f32 x, in f32 y, in f32 width, in f32 height){
    Rect rect = Rect();
    rect.x = x;
    rect.y = y;
    rect.width = width;
    rect.height = height;
    return rect;
}

Point MakeUiNestedPopupRouterPoint(in f32 x, in f32 y){
    Point point = Point();
    point.x = x;
    point.y = y;
    return point;
}

WidgetId MakeUiNestedPopupRouterWidgetId(in u64 value){
    WidgetId id = WidgetId();
    id.value = value;
    return id;
}

PopupToken MakeUiNestedPopupRouterToken(in u64 widgetValue, in u64 declarationGeneration, in u64 instanceGeneration, in u64 openGeneration){
    PopupToken token = PopupToken();
    token.widget = MakeUiNestedPopupRouterWidgetId(widgetValue);
    token.declarationGeneration = declarationGeneration;
    token.instanceGeneration = instanceGeneration;
    token.openGeneration = openGeneration;
    return token;
}

ControlToken MakeUiNestedPopupRouterControlToken(in u64 instanceGeneration, in u64 contentGeneration, in u64 contentRevision){
    ControlToken token = ControlToken();
    token.instanceGeneration = instanceGeneration;
    token.contentGeneration = contentGeneration;
    token.contentRevision = contentRevision;
    return token;
}

InputEvent MakeUiNestedPopupRouterPointerEvent(in InputEventTypeEnum eventType, in f32 x, in f32 y){
    InputEvent event = InputEvent();
    event.type = eventType;
    event.position.x = x;
    event.position.y = y;
    return event;
}

InputEvent MakeUiNestedPopupRouterPointerPointEvent(in InputEventTypeEnum eventType, in Point position){
    InputEvent event = InputEvent();
    event.type = eventType;
    event.position = position;
    return event;
}

InputEvent MakeUiNestedPopupRouterKeyEvent(in InputEventTypeEnum eventType, in CoreKeyEnum key, in b8 repeat){
    InputEvent event = InputEvent();
    event.type = eventType;
    event.key = key;
    event.repeat = repeat;
    return event;
}

InputEvent MakeUiNestedPopupRouterFocusEvent(in InputEventTypeEnum eventType){
    InputEvent event = InputEvent();
    event.type = eventType;
    return event;
}


