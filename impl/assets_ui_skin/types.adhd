const u32 s_UiSkinMaxRegionCount = 4096u;
const f32 s_UiSkinPaletteRgbMax = 16.0f;
const f32 s_UiSkinDefaultFontSize = 16.0f;
const f32 s_UiSkinMinDefaultFontSizeScale = 64.0f;
const f32 s_UiSkinMinDefaultFontSize = 1.0f / s_UiSkinMinDefaultFontSizeScale;
const f32 s_UiSkinMaxDefaultFontSize = 2048.0f;
const u32 s_UiSkinBinaryMagic = 0x55495331u; // UIS1
const u32 s_UiSkinBinaryVersion = 3u;
const u32 s_UiSkinPaletteColorCount = 17u;

