namespace NWB::Tests::Smoke{
#if defined(NWB_HARDWARE_SHADOW_BOUNDARY_BENCHMARK)
inline constexpr b8 s_StressHardwareShadowBoundaryBenchmark = true;
#else
inline constexpr b8 s_StressHardwareShadowBoundaryBenchmark = false;
#endif
};


