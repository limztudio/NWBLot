UiRect MakeEcsUiRect(in f32 x, in f32 y, in f32 width, in f32 height){
    UiRect rect = UiRect();
    rect.x = x;
    rect.y = y;
    rect.width = width;
    rect.height = height;
    return rect;
}

UiPoint MakeEcsUiPoint(in f32 x, in f32 y){
    UiPoint point = UiPoint();
    point.x = x;
    point.y = y;
    return point;
}

UiInputSource MakeEcsUiInputSource(in u32 device, in u32 control){
    UiInputSource source = UiInputSource();
    source.device = device;
    source.control = control;
    return source;
}


