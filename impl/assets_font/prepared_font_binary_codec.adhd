////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_font/sfnt_directory.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{
#include <global/sha256.h>
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class PreparedFontBinaryCodec{
    private b8 validHeaderInputs(in usize fontByteCount, in u32 faceIndex, in usize groupCount)const{
        return
            fontByteCount > 0u
            && fontByteCount <= cast<usize>(s_FontMaxSourceBytes)
            && faceIndex == 0u
            && groupCount > 0u
            && groupCount <= cast<usize>(s_PreparedFontMaxGroupCount)
        ;
    }

    private b8 validHeader(in u32 magic, in u32 version, in u32 faceIndex, in u32 flags)const{
        return
            magic == s_PreparedFontMagic
            && version == s_PreparedFontVersion
            && faceIndex == 0u
            && flags == 0u
        ;
    }

    public Expected<u64> expectedPayloadBytes(in usize fontByteCount, in usize groupCount, in u64 pixelByteCount)const{
        if(
            fontByteCount == 0u
            || fontByteCount > cast<usize>(s_FontMaxSourceBytes)
            || groupCount == 0u
            || groupCount > cast<usize>(s_PreparedFontMaxGroupCount)
            || pixelByteCount > s_PreparedFontMaxPixelBytes
        )
            return MakeUnexpected(Failure());
        return
            cast<u64>(s_PreparedFontHeaderBytes)
            + cast<u64>(groupCount) * cast<u64>(s_PreparedFontGroupHeaderBytes)
            + cast<u64>(fontByteCount)
            + pixelByteCount
        ;
    }

    private Expected<u32> imageByteCount(in u32 width, in u32 height, in u32 channels)const{
        if(width == 0u || width > s_PreparedFontMaxSide || height == 0u || height > s_PreparedFontMaxSide || channels == 0u || channels > s_PreparedFontMaxChannelCount)
            return MakeUnexpected(Failure());
        return width * height * channels;
    }

    public Expected<u64, StringView> validateSerializeInputs(
        in usize sfntByteCount,
        in b8 hasSfntData,
        in u32 faceIndex,
        in Span<PreparedFontImageView> groups
    )const{
        if(!hasSfntData || !this.validHeaderInputs(sfntByteCount, faceIndex, groups.size())){
            error("Prepared font serialization: invalid font bytes, face index, or image group count");
            return MakeUnexpected(s_PreparedFontInvalidSerializeInputReason);
        }

        u64 pixelByteCount = 0u;
        for(usize index = 0u; index < groups.size(); ++index){
            const PreparedFontImageView group = groups[index];
            const Expected<u32> expectedBytes = this.imageByteCount(group.width, group.height, group.channelCount);
            if(
                !expectedBytes.has_value()
                || group.pixels.empty()
                || group.pixels.size() != cast<usize>(expectedBytes.value())
                || cast<u64>(expectedBytes.value()) > s_PreparedFontMaxPixelBytes - pixelByteCount
            ){
                error("Prepared font serialization: image group {} has invalid dimensions, channels, or pixel bytes", index);
                return MakeUnexpected(s_PreparedFontInvalidSerializeGroupReason);
            }
            pixelByteCount += cast<u64>(expectedBytes.value());
        }
        const Expected<u64> expectedPayloadBytes = this.expectedPayloadBytes(sfntByteCount, groups.size(), pixelByteCount);
        if(!expectedPayloadBytes.has_value()){
            error("Prepared font serialization: invalid font bytes, face index, or image group count");
            return MakeUnexpected(s_PreparedFontInvalidSerializeInputReason);
        }
        return expectedPayloadBytes.value();
    }

    private void appendSha256(in Span<u8> sourceBytes, mut Vector<u8> outBinary)const{
        native(in sourceBytes, mut outBinary){
            const Sha256Digest digest = ComputeSha256({ sourceBytes.data(), sourceBytes.size() });
            outBinary.insert(outBinary.end(), digest.bytes, digest.bytes + sizeof(digest.bytes));
        }
    }

    public void appendSourceBinary(
        in Span<u8> sfnt,
        in u32 faceIndex,
        in Span<PreparedFontImageView> groups,
        in u64 expectedPayloadBytes,
        mut Vector<u8> outBinary
    )const{
        outBinary.clear();
        outBinary.reserve(cast<usize>(expectedPayloadBytes));
        AppendU32LittleEndian(outBinary, s_PreparedFontMagic);
        AppendU32LittleEndian(outBinary, s_PreparedFontVersion);
        AppendU32LittleEndian(outBinary, faceIndex);
        AppendU32LittleEndian(outBinary, cast<u32>(sfnt.size()));
        AppendU32LittleEndian(outBinary, cast<u32>(groups.size()));
        AppendU32LittleEndian(outBinary, 0u);
        this.appendSha256(sfnt, outBinary);

        for(usize index = 0u; index < groups.size(); ++index){
            const PreparedFontImageView group = groups[index];
            AppendU32LittleEndian(outBinary, group.width);
            AppendU32LittleEndian(outBinary, group.height);
            AppendU32LittleEndian(outBinary, group.channelCount);
            AppendU32LittleEndian(outBinary, cast<u32>(group.pixels.size()));
            this.appendSha256(group.pixels, outBinary);
        }
        for(in u8 byteValue : sfnt)
            outBinary.push_back(byteValue);
        for(usize index = 0u; index < groups.size(); ++index){
            const Span<u8> pixels = groups[index].pixels;
            for(in u8 byteValue : pixels)
                outBinary.push_back(byteValue);
        }
    }

    public Expected<b8, StringView> decodeHeader(
        in Span<u8> headerBytes,
        mut u32 outFaceIndex,
        mut u32 outFontByteCount,
        mut u32 outGroupCount
    )const{
        usize cursor = 0u;
        const Expected<u32> magic = ReadU32LittleEndian(headerBytes, cursor);
        const Expected<u32> version = ReadU32LittleEndian(headerBytes, cursor);
        const Expected<u32> faceIndex = ReadU32LittleEndian(headerBytes, cursor);
        const Expected<u32> fontByteCount = ReadU32LittleEndian(headerBytes, cursor);
        const Expected<u32> groupCount = ReadU32LittleEndian(headerBytes, cursor);
        const Expected<u32> flags = ReadU32LittleEndian(headerBytes, cursor);
        if(!magic.has_value() || !version.has_value() || !faceIndex.has_value() || !fontByteCount.has_value() || !groupCount.has_value() || !flags.has_value())
            return MakeUnexpected(s_PreparedFontHeaderTruncatedReason);
        if(!this.validHeader(magic.value(), version.value(), faceIndex.value(), flags.value()))
            return MakeUnexpected(s_PreparedFontUnsupportedHeaderReason);
        if(!this.validHeaderInputs(cast<usize>(fontByteCount.value()), faceIndex.value(), cast<usize>(groupCount.value())))
            return MakeUnexpected(s_PreparedFontCountsOutOfBoundsReason);

        outFaceIndex = faceIndex.value();
        outFontByteCount = fontByteCount.value();
        outGroupCount = groupCount.value();
        return true;
    }

    public Expected<b8, StringView> decodeGroupHeader(
        in Span<u8> groupHeaderBytes,
        mut u64 inOutPixelByteCount,
        mut u32 outWidth,
        mut u32 outHeight,
        mut u32 outChannelCount,
        mut u32 outByteCount
    )const{
        usize cursor = 0u;
        const Expected<u32> width = ReadU32LittleEndian(groupHeaderBytes, cursor);
        const Expected<u32> height = ReadU32LittleEndian(groupHeaderBytes, cursor);
        const Expected<u32> channelCount = ReadU32LittleEndian(groupHeaderBytes, cursor);
        const Expected<u32> byteCount = ReadU32LittleEndian(groupHeaderBytes, cursor);
        if(!width.has_value() || !height.has_value() || !channelCount.has_value() || !byteCount.has_value())
            return MakeUnexpected(s_PreparedFontImageDirectoryTruncatedReason);

        const Expected<u32> expectedBytes = this.imageByteCount(width.value(), height.value(), channelCount.value());
        if(
            !expectedBytes.has_value()
            || byteCount.value() != expectedBytes.value()
            || cast<u64>(expectedBytes.value()) > s_PreparedFontMaxPixelBytes - inOutPixelByteCount
        )
            return MakeUnexpected(s_PreparedFontInvalidImageGroupReason);

        inOutPixelByteCount += cast<u64>(expectedBytes.value());
        outWidth = width.value();
        outHeight = height.value();
        outChannelCount = channelCount.value();
        outByteCount = expectedBytes.value();
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

