#include <tests/common/gtest_macros.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_MathMatrixAffineEpsilon = 0.000001f;
const f32 s_MathMatrixDeterminantEpsilon = 0.000000000001f;
const f32 s_MathMatrixRigidEpsilon = 0.001f;
const f32 s_SingleDirectionEpsilon = 0.00001f;
const f64 s_DoubleDirectionEpsilon = 0.00000000000002;

class EqualityObservation{
    public b8 equal = false;
    public i32 flags = 0;
    public u32 rawFlags = 0u;
}

void ExpectSingleDirectionNear(in VectorSingle actual, in VectorSingle expected){
    EXPECT_NEAR(actual.x, expected.x, s_SingleDirectionEpsilon);
    EXPECT_NEAR(actual.y, expected.y, s_SingleDirectionEpsilon);
    EXPECT_NEAR(actual.z, expected.z, s_SingleDirectionEpsilon);
}

void ExpectDoubleDirectionNear(in VectorDouble actual, in VectorDouble expected){
    EXPECT_NEAR(actual.x, expected.x, s_DoubleDirectionEpsilon);
    EXPECT_NEAR(actual.y, expected.y, s_DoubleDirectionEpsilon);
    EXPECT_NEAR(actual.z, expected.z, s_DoubleDirectionEpsilon);
}


