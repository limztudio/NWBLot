////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_CSG_INTERVAL_SAMPLE_STATE_SLANGI
#define NWB_GRAPHICS_CSG_INTERVAL_SAMPLE_STATE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../bindless/bindless_heap.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct NwbCsgIntervalSampleState{
    uint4 workRect;
    uint4 resourceSlots; // x selects the shared mesh view; the remaining words preserve the std140 lane.
};

#pragma warning(push)
#pragma warning(disable: 39001) // The interval sample state is a typed uniform-table alias.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_UNIFORM_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
ConstantBuffer<NwbCsgIntervalSampleState, Std140DataLayout> g_NwbHeapCsgIntervalSampleStates[];
#pragma warning(pop)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


ConstantBuffer<NwbCsgIntervalSampleState, Std140DataLayout> nwbHeapCsgIntervalSampleState(const uint slot){
    return g_NwbHeapCsgIntervalSampleStates[slot];
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

