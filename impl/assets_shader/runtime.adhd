#include <impl/assets_shader/asset.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type ShaderAssetRegistration<T> = AssetCodecRegistration<ShaderAssetCodec<T>>;

register_asset VertexShader using ShaderAssetRegistration<VertexShader>;
register_asset HullShader using ShaderAssetRegistration<HullShader>;
register_asset DomainShader using ShaderAssetRegistration<DomainShader>;
register_asset GeometryShader using ShaderAssetRegistration<GeometryShader>;
register_asset PixelShader using ShaderAssetRegistration<PixelShader>;
register_asset ComputeShader using ShaderAssetRegistration<ComputeShader>;
register_asset AmplificationShader using ShaderAssetRegistration<AmplificationShader>;
register_asset MeshShader using ShaderAssetRegistration<MeshShader>;
register_asset RayGenerationShader using ShaderAssetRegistration<RayGenerationShader>;
register_asset AnyHitShader using ShaderAssetRegistration<AnyHitShader>;
register_asset ClosestHitShader using ShaderAssetRegistration<ClosestHitShader>;
register_asset MissShader using ShaderAssetRegistration<MissShader>;
register_asset IntersectionShader using ShaderAssetRegistration<IntersectionShader>;
register_asset CallableShader using ShaderAssetRegistration<CallableShader>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

