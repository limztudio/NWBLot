const StringView s_MountedDirectory = "mounted";
const StringView s_RelocatedDirectory = "relocated";
const StringView s_HeldFileSuffix = ".held";

void VerifyFilesystemVolumeTest_SegmentProbePreservesInspectionErrors(mut FilesystemVolumeTest self){
    native(mut self){
        const auto missing = VolumeSegmentExists(self.m_directory, self.m_desc.volumeName.view());
        ASSERT_TRUE(missing);
        EXPECT_FALSE(*missing);

#if defined(NWB_PLATFORM_WINDOWS)
        const DiskPath invalidPath(self.m_arena, "invalid|volume");
#else
        TString<GlobalArena> longName(self.m_arena);
        longName.resize(40000u, static_cast<tchar>('a'));
        const DiskPath invalidPath(self.m_arena, longName);
#endif
        const auto inspection = IsDirectory(invalidPath);
        ASSERT_FALSE(inspection);
        const auto failedProbe = VolumeSegmentExists(invalidPath, self.m_desc.volumeName.view());
        ASSERT_FALSE(failedProbe);
        EXPECT_EQ(failedProbe.error(), inspection.error());

        auto filesystem = CreateFilesystem(self.m_arena, self.m_desc);
        ASSERT_TRUE(filesystem);
        const auto present = VolumeSegmentExists(self.m_directory, self.m_desc.volumeName.view());
        ASSERT_TRUE(present);
        EXPECT_TRUE(*present);
        ASSERT_TRUE((*filesystem)->unmount());
    }
}

void VerifyFilesystemVolumeTest_SegmentCreatedAfterMountIsNotTruncated(mut FilesystemVolumeTest self){
    VolumeFileSystem filesystem(self.m_arena);
    ASSERT_TRUE(filesystem.mount(self.m_desc));
    ScratchArena scratchArena(s_FilesystemNameTestsFilesystem);

    native(mut self, mut filesystem, mut scratchArena){
        const DiskPath unexpected = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 1u);
        const Array<u8, 4u> sentinel{ 7u, 8u, 9u, 10u };
        ASSERT_TRUE(WriteBinaryFile(unexpected, sentinel));
        Vector<u8, ScratchArena> payload(5000u, 5u, scratchArena);
        EXPECT_FALSE(filesystem.writeFile(s_FilesystemNameProjectTestsPayload, payload));
        Vector<u8, ScratchArena> loaded(scratchArena);
        ASSERT_TRUE(ReadBinaryFile(unexpected, loaded));
        ASSERT_EQ(loaded.size(), sentinel.size());
        EXPECT_EQ(NWB_MEMCMP(loaded.data(), sentinel.data(), sentinel.size()), 0);
    }

    EXPECT_FALSE(filesystem.fileExists(s_FilesystemNameProjectTestsPayload));
    ASSERT_TRUE(filesystem.unmount());
}

void VerifyFilesystemVolumeTest_FailedMultiSegmentGrowthKeepsTrimmedVolumeMountable(mut FilesystemVolumeTest self){
    VolumeFileSystem filesystem(self.m_arena);
    ASSERT_TRUE(filesystem.mount(self.m_desc));
    ScratchArena scratchArena(s_FilesystemNameTestsFilesystem);

    native(mut self, mut filesystem, mut scratchArena){
        const Array<u8, 3u> payload{ 1u, 2u, 3u };
        ASSERT_TRUE(filesystem.writeFile(s_FilesystemNameProjectTestsPayload, payload));
        ASSERT_TRUE(filesystem.flush());
        const DiskPath first = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 0u);
        const auto trimmedSize = FileSize(first);
        ASSERT_TRUE(trimmedSize);
        ASSERT_LT(*trimmedSize, self.m_desc.segmentSize);
        const DiskPath collision = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 2u);
        const Array<u8, 2u> sentinel{ 7u, 8u };
        ASSERT_TRUE(WriteBinaryFile(collision, sentinel));
        Vector<u8, ScratchArena> large(9000u, 5u, scratchArena);
        EXPECT_FALSE(filesystem.writeFile(s_FilesystemNameProjectTestsLargeGrowth, large));
        Vector<u8, ScratchArena> loaded(scratchArena);
        ASSERT_TRUE(ReadBinaryFile(collision, loaded));
        ASSERT_EQ(loaded.size(), sentinel.size());
        EXPECT_EQ(NWB_MEMCMP(loaded.data(), sentinel.data(), sentinel.size()), 0);
        ASSERT_TRUE(RemoveFile(collision));
        ASSERT_TRUE(filesystem.unmount());
        ASSERT_TRUE(filesystem.mount(self.m_desc));
        ASSERT_TRUE(filesystem.readFile(s_FilesystemNameProjectTestsPayload, loaded));
        ASSERT_EQ(loaded.size(), payload.size());
        EXPECT_EQ(NWB_MEMCMP(loaded.data(), payload.data(), payload.size()), 0);
    }

    EXPECT_FALSE(filesystem.fileExists(s_FilesystemNameProjectTestsLargeGrowth));
    ASSERT_TRUE(filesystem.unmount());
}

void VerifyFilesystemVolumeTest_GrowthDoesNotPadOverExternallyTruncatedLiveData(mut FilesystemVolumeTest self){
    VolumeFileSystem filesystem(self.m_arena);
    ASSERT_TRUE(filesystem.mount(self.m_desc));
    ScratchArena scratchArena(s_FilesystemNameTestsFilesystem);
    const u64 truncatedSize = self.m_desc.metadataSize + 1u;

    native(in truncatedSize, mut self, mut filesystem, mut scratchArena){
        const Array<u8, 8u> payload{ 1u, 2u, 3u, 4u, 5u, 6u, 7u, 8u };
        ASSERT_TRUE(filesystem.writeFile(s_FilesystemNameProjectTestsPayload, payload));
        const DiskPath first = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 0u);
        ASSERT_TRUE(ResizeFile(first, truncatedSize));
        Vector<u8, ScratchArena> large(5000u, 5u, scratchArena);
        EXPECT_FALSE(filesystem.writeFile(s_FilesystemInputNameProjectTestsNewGrowth, large));
        const auto size = FileSize(first);
        ASSERT_TRUE(size);
        EXPECT_EQ(*size, truncatedSize);
    }

    ASSERT_TRUE(filesystem.unmount());
}

void VerifyFilesystemVolumeTest_GrowthAtSegmentLimitDoesNotExpandTrimmedFile(mut FilesystemVolumeTest self){
    self.m_desc.maxSegments = 1u;
    VolumeFileSystem filesystem(self.m_arena);
    ASSERT_TRUE(filesystem.mount(self.m_desc));
    ScratchArena scratchArena(s_FilesystemNameTestsFilesystem);

    native(mut self, mut filesystem, mut scratchArena){
        const Array<u8, 3u> payload{ 1u, 2u, 3u };
        ASSERT_TRUE(filesystem.writeFile(s_FilesystemNameProjectTestsPayload, payload));
        ASSERT_TRUE(filesystem.flush());
        const DiskPath first = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 0u);
        const auto before = FileSize(first);
        ASSERT_TRUE(before);
        Vector<u8, ScratchArena> large(5000u, 5u, scratchArena);
        EXPECT_FALSE(filesystem.writeFile(s_FilesystemInputNameProjectTestsLimitedGrowth, large));
        const auto after = FileSize(first);
        ASSERT_TRUE(after);
        EXPECT_EQ(*after, *before);
    }

    ASSERT_TRUE(filesystem.unmount());
}

void VerifyFilesystemVolumeTest_ReadsAcrossSegmentsAndSeeksAtBoundaries(mut FilesystemVolumeTest self){
    ScratchArena scratchArena(s_FilesystemNameTestsFilesystem);
    native(mut self, mut scratchArena){
        auto filesystemResult = CreateFilesystem(self.m_arena, self.m_desc);
        ASSERT_TRUE(filesystemResult);
        auto filesystem = Move(*filesystemResult);
        Vector<u8, ScratchArena> payload(scratchArena);
        payload.resize(10000);
        for(usize i = 0; i < payload.size(); ++i)
            payload[i] = static_cast<u8>(i % 251u);
        ASSERT_TRUE(filesystem->writeFileDeferred(s_FilesystemNameProjectTestsPayload, payload));
        ASSERT_TRUE(filesystem->flush());

        const auto opened = filesystem->openFile(s_FilesystemNameProjectTestsPayload);
        ASSERT_TRUE(opened);
        FileCursor cursor = *opened;
        ASSERT_TRUE(filesystem->seekFile(cursor, 3570, FileSeekOrigin::Begin));
        Array<u8, 64> buffer{};
        auto bytesRead = filesystem->readFile(cursor, buffer.data(), buffer.size());
        ASSERT_TRUE(bytesRead);
        ASSERT_EQ(*bytesRead, buffer.size());
        EXPECT_EQ(NWB_MEMCMP(buffer.data(), payload.data() + 3570, *bytesRead), 0);
        EXPECT_EQ(cursor.offset, 3634u);
        ASSERT_TRUE(filesystem->seekFile(cursor, -10, FileSeekOrigin::End));
        bytesRead = filesystem->readFile(cursor, buffer.data(), buffer.size());
        ASSERT_TRUE(bytesRead);
        EXPECT_EQ(*bytesRead, 10u);
        EXPECT_EQ(NWB_MEMCMP(buffer.data(), payload.data() + 9990, *bytesRead), 0);
        bytesRead = filesystem->readFile(cursor, buffer.data(), buffer.size());
        ASSERT_TRUE(bytesRead);
        EXPECT_EQ(*bytesRead, 0u);
        EXPECT_EQ(cursor.offset, 10000u);
        EXPECT_FALSE(filesystem->seekFile(cursor, 1, FileSeekOrigin::Current));
        EXPECT_FALSE(filesystem->seekFile(cursor, -10001, FileSeekOrigin::End));
        EXPECT_FALSE(filesystem->seekFile(cursor, Limit<i64>::s_Min, FileSeekOrigin::Current));
        EXPECT_FALSE(filesystem->seekFile(cursor, Limit<i64>::s_Max, FileSeekOrigin::Current));
        EXPECT_FALSE(filesystem->seekFile(cursor, 0, static_cast<FileSeekOrigin::Enum>(255)));
        EXPECT_EQ(cursor.offset, 10000u);
        filesystem->closeFile(cursor);
        EXPECT_FALSE(filesystem->readFile(cursor, buffer.data(), buffer.size()));
        ASSERT_TRUE(filesystem->unmount());
    }
}

void VerifyFilesystemVolumeTest_DeferredWritesSurviveUnmountAndReadOnlyMount(mut FilesystemVolumeTest self){
    native(mut self){
        auto filesystemResult = CreateFilesystem(self.m_arena, self.m_desc);
        ASSERT_TRUE(filesystemResult);
        auto filesystem = Move(*filesystemResult);
        Array<u8, 4> payload{ 1u, 3u, 5u, 7u };
        ASSERT_TRUE(filesystem->writeFileDeferred(s_FilesystemNameProjectTestsPayload, payload));
        payload[0] = 99u;
        ASSERT_TRUE(filesystem->unmount());
        self.m_desc.createIfMissing = false;
        self.m_desc.usage = VolumeUsage::RuntimeReadOnly;
        ASSERT_TRUE(filesystem->mount(self.m_desc));
        VolumeBytes loaded(self.m_arena);
        ASSERT_TRUE(filesystem->readFile(s_FilesystemNameProjectTestsPayload, loaded));
        ASSERT_EQ(loaded.size(), 4u);
        EXPECT_EQ(loaded[0], 1u);
        EXPECT_FALSE(filesystem->writeFile(s_FilesystemNameProjectTestsPayload, payload));
        EXPECT_FALSE(filesystem->removeFile(s_FilesystemNameProjectTestsPayload));
        ASSERT_TRUE(filesystem->unmount());
    }
}

void VerifyFilesystemVolumeTest_FailedUnmountRetainsPendingWritesForExplicitRetry(mut FilesystemVolumeTest self){
    native(mut self){
        self.m_desc.mountDirectory = self.m_directory / s_MountedDirectory;
        const DiskPath relocated = self.m_directory / s_RelocatedDirectory;
        auto filesystemResult = CreateFilesystem(self.m_arena, self.m_desc);
        ASSERT_TRUE(filesystemResult);
        auto filesystem = Move(*filesystemResult);
        Array<u8, 4u> payload{ 1u, 3u, 5u, 7u };
        ASSERT_TRUE(filesystem->writeFileDeferred(s_FilesystemNameProjectTestsPayload, payload));
        payload[0u] = 99u;

        ASSERT_TRUE(RenamePath(self.m_desc.mountDirectory, relocated));
        EXPECT_FALSE(filesystem->unmount());
        EXPECT_TRUE(filesystem->mounted());
        EXPECT_TRUE(filesystem->writable());
        EXPECT_TRUE(filesystem->fileExists(s_FilesystemNameProjectTestsPayload));
        ASSERT_TRUE(RenamePath(relocated, self.m_desc.mountDirectory));
        ASSERT_TRUE(filesystem->unmount());

        self.m_desc.createIfMissing = false;
        self.m_desc.usage = VolumeUsage::RuntimeReadOnly;
        ASSERT_TRUE(filesystem->mount(self.m_desc));
        VolumeBytes loaded(self.m_arena);
        ASSERT_TRUE(filesystem->readFile(s_FilesystemNameProjectTestsPayload, loaded));
        ASSERT_EQ(loaded.size(), payload.size());
        EXPECT_EQ(loaded[0u], 1u);
        EXPECT_EQ(loaded[1u], 3u);
        EXPECT_EQ(loaded[2u], 5u);
        EXPECT_EQ(loaded[3u], 7u);
        ASSERT_TRUE(filesystem->unmount());
    }
}

void VerifyFilesystemVolumeTest_ExplicitFlushSurvivesResourceOnlyDestructionWithoutPersistenceRetry(mut FilesystemVolumeTest self){
    native(mut self){
        static_assert(IsNothrowDestructible_V<VolumeFileSystem>);
        self.m_desc.mountDirectory = self.m_directory / s_MountedDirectory;
        const DiskPath relocated = self.m_directory / s_RelocatedDirectory;
        auto filesystemResult = CreateFilesystem(self.m_arena, self.m_desc);
        ASSERT_TRUE(filesystemResult);
        auto filesystem = Move(*filesystemResult);
        const Array<u8, 3u> payload{ 4u, 5u, 6u };
        ASSERT_TRUE(filesystem->writeFileDeferred(s_FilesystemNameProjectTestsPayload, payload));
        ASSERT_TRUE(filesystem->flush());

        ASSERT_TRUE(RenamePath(self.m_desc.mountDirectory, relocated));
        const u32 messageCount = self.m_logger.messageCount();
        filesystem.reset();
        EXPECT_EQ(self.m_logger.messageCount(), messageCount);
        ASSERT_TRUE(RenamePath(relocated, self.m_desc.mountDirectory));

        self.m_desc.createIfMissing = false;
        self.m_desc.usage = VolumeUsage::RuntimeReadOnly;
        auto reopened = CreateFilesystem(self.m_arena, self.m_desc);
        ASSERT_TRUE(reopened);
        VolumeBytes loaded(self.m_arena);
        ASSERT_TRUE((*reopened)->readFile(s_FilesystemNameProjectTestsPayload, loaded));
        ASSERT_EQ(loaded.size(), payload.size());
        EXPECT_EQ(NWB_MEMCMP(loaded.data(), payload.data(), loaded.size()), 0);
        ASSERT_TRUE((*reopened)->unmount());
    }
}

