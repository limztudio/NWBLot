    public b8 isCompoundGeometryValid(in CompoundGeometryId id)const{
        return id.valid()
            && id.worldIndex == this.m_worldIndex
            && id.index < this.m_compoundShapes.size()
            && id.index < this.m_compoundGenerations.size()
            && id.index < this.m_compoundOwnedByUser.size()
