[cpp_header("<loader/project_entry.h>"), cpp_name("::NWB::ProjectStartupContext")]
extern class ProjectStartupContext{
    GraphicsRuntime graphics;
    GlobalAllocator objectArena;
    FilesystemFactory filesystemFactory;
};

[cpp_header("<loader/project_entry.h>"), cpp_name("::NWB::ProjectRuntimeContext")]
extern class ProjectRuntimeContext{
    GraphicsRuntime graphics;
    InputDispatcher input;
    IClipboardService clipboard;
    ITextInputService textInput;
    ICursorService cursor;
    IAccessibilityService accessibility;
    GlobalAllocator objectArena;
    CpuTaskScheduler cpuTasks;
    GpuTaskScheduler gpuTasks;
    CpuTaskScope tasks;
    AssetManager assetManager;
    IFilesystem filesystem;
    FrameGraphRegistry frameGraphRegistry;
    Session perfSession;
    ShaderArchivePathResolver shaderPathResolver;
    Func<void()> requestQuit;
    void setTelemetryCapture(in TelemetryCaptureOptions options);
    b8 flushTelemetryUpload(in b8 clearAfterUpload = false);
    void setPerfCapture(in PerfCaptureOptions options);
    TimingView gpuTimingView()const;
};

[cpp_header("<loader/project_entry.h>"), cpp_name("::NWB::IProjectEntryCallbacks"), cpp_flags(brace_init)]
extern class IProjectEntryCallbacks{
    b8 onStartup();
    void onShutdown();
    b8 onUpdate(in f32 delta);
};


