#include <tests/common/floating_point_environment_guard.adhd>
#include <tests/common/gtest_macros.adhd>
#include <tests/common/test_helpers.adhd>
#include <tests/common/test_context.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[move_only]
class ScopedHeldFloatingPointEnvironment{
    private Expected<FloatingPointEnvironment> m_original = HoldFloatingPointExceptions();
    private b8 m_active = true;

    public ~ScopedHeldFloatingPointEnvironment(){
        if(this.m_active && this.m_original.has_value() && !SetFloatingPointEnvironment(this.m_original.value()).has_value())
            TerminateInvariant();
    }

    public b8 valid()const{ return this.m_original.has_value(); }

    public b8 restoreNow(){
        if(!this.m_original.has_value() || !SetFloatingPointEnvironment(this.m_original.value()).has_value())
            return false;
        this.m_active = false;
        return true;
    }
}

const Array<i32, 4u> s_FloatingPointRoundingModes = Array<i32, 4u>(FE_TONEAREST, FE_DOWNWARD, FE_UPWARD, FE_TOWARDZERO);
const Array<i32, 3u> s_DirectedRoundingModes = Array<i32, 3u>(FE_DOWNWARD, FE_UPWARD, FE_TOWARDZERO);
const i32 s_FeAllExcept = FE_ALL_EXCEPT;
const i32 s_FeInvalid = FE_INVALID;
const i32 s_FeOverflow = FE_OVERFLOW;
const i32 s_FeDivByZero = FE_DIVBYZERO;
const i32 s_FeInexact = FE_INEXACT;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_MathMatrixAffineEpsilon = 0.000001f;
const f32 s_MathMatrixDeterminantEpsilon = 0.000000000001f;
const f32 s_MathMatrixRigidEpsilon = 0.001f;
const f32 s_SingleDirectionEpsilon = 0.00001f;
const f64 s_DoubleDirectionEpsilon = 0.00000000000002;

const u32 s_F32InfinityBits = 0x7f800000u;
const u32 s_F32NegInfinityBits = 0xff800000u;
const u32 s_F32QuietNanBits = 0x7fc00000u;
const u32 s_F32NegZeroBits = 0x80000000u;

const u64 s_F64InfinityBits = 0x7ff0000000000000u;
const u64 s_F64NegInfinityBits = 0xfff0000000000000u;
const u64 s_F64QuietNanBits = 0x7ff8000000000000u;
const u64 s_F64NegZeroBits = 0x8000000000000000u;
const u64 s_F64MaxBits = 0x7fefffffffffffffu;

class EqualityObservation{
    public b8 equal = false;
    public i32 flags = 0;
    public u32 rawFlags = 0u;
}

void ExpectSingleDirectionNear(in VectorSingle actual, in VectorSingle expected){
    EXPECT_NEAR(actual.x, expected.x, s_SingleDirectionEpsilon);
    EXPECT_NEAR(actual.y, expected.y, s_SingleDirectionEpsilon);
    EXPECT_NEAR(actual.z, expected.z, s_SingleDirectionEpsilon);
}

void ExpectDoubleDirectionNear(in VectorDouble actual, in VectorDouble expected){
    EXPECT_NEAR(actual.x, expected.x, s_DoubleDirectionEpsilon);
    EXPECT_NEAR(actual.y, expected.y, s_DoubleDirectionEpsilon);
    EXPECT_NEAR(actual.z, expected.z, s_DoubleDirectionEpsilon);
}

VectorSingle MakeVolatileSingleBits(in u32 x, in u32 y, in u32 z, in u32 w){
    return VectorSetInt(ObserveValue<u32>(x), ObserveValue<u32>(y), ObserveValue<u32>(z), ObserveValue<u32>(w));
}

VectorDouble MakeVolatileDoubleBits(in u64 x, in u64 y, in u64 z, in u64 w){
    return VectorDoubleSetInt(ObserveValue<u64>(x), ObserveValue<u64>(y), ObserveValue<u64>(z), ObserveValue<u64>(w));
}

VectorSingle MakeVolatileSingleFloats(in f32 x, in f32 y, in f32 z, in f32 w){
    return VectorSingle(ObserveValue<f32>(x), ObserveValue<f32>(y), ObserveValue<f32>(z), ObserveValue<f32>(w));
}

VectorDouble MakeVolatileDoubleFloats(in f64 x, in f64 y, in f64 z, in f64 w){
    return VectorDouble(ObserveValue<f64>(x), ObserveValue<f64>(y), ObserveValue<f64>(z), ObserveValue<f64>(w));
}

u32 GetSingleLaneBits(in VectorSingle vec, in usize lane){
    return VectorGetIntByIndex(vec, lane);
}

u64 GetDoubleLaneBits(in VectorDouble vec, in usize lane){
    return VectorDoubleGetIntByIndex(vec, lane);
}

f32 GetSingleLaneFloat(in VectorSingle vec, in usize lane){
    return VectorGetByIndex(vec, lane);
}

f64 GetDoubleLaneFloat(in VectorDouble vec, in usize lane){
    return vec[lane];
}

Array<u32, 4> MakeU32Array4(in u32 x, in u32 y, in u32 z, in u32 w){
    Array<u32, 4> values = Array<u32, 4>();
    values[0u] = x;
    values[1u] = y;
    values[2u] = z;
    values[3u] = w;
    return values;
}

Array<u64, 4> MakeU64Array4(in u64 x, in u64 y, in u64 z, in u64 w){
    Array<u64, 4> values = Array<u64, 4>();
    values[0u] = x;
    values[1u] = y;
    values[2u] = z;
    values[3u] = w;
    return values;
}

