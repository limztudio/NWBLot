[arena, asset("rigid_body_component")]
class RigidBodyComponentAsset : IComponent{
    public RigidBodyComponent component;

    public b8 loadBinary(in Span<u8> binary)override;
    public b8 loadComponentPayload(in Span<u8> payload)override;
    public b8 validatePayload()const override;
    public void applyToEntity(mut Entity entity)const override{
        mut RigidBodyComponent dst = entity.addComponent<RigidBodyComponent>();
        dst = this.component;
        dst.dirty = true;
        dst.runtimeBodyId = BodyId();
    }
    public b8 serializeComponentPayload(mut Vector<u8> outPayload)const override;
    public b8 appendValidatedComponentPayload(mut Vector<u8> outBinary)const override;
}

[arena, asset("collider_component")]
class ColliderComponentAsset : IComponent{
    public ColliderComponent component;

    public b8 loadBinary(in Span<u8> binary)override;
    public b8 loadComponentPayload(in Span<u8> payload)override;
    public b8 validatePayload()const override;
    public void applyToEntity(mut Entity entity)const override{
        mut ColliderComponent dst = entity.addComponent<ColliderComponent>();
        dst = this.component;
        dst.dirty = true;
        dst.runtimeShapeId = ShapeId();
        dst.runtimeExtraShapeIds.clear();
        dst.boundBodyId = BodyId();
    }
    public b8 serializeComponentPayload(mut Vector<u8> outPayload)const override;
    public b8 appendValidatedComponentPayload(mut Vector<u8> outBinary)const override;
}

[arena, asset("joint_component")]
class JointComponentAsset : IComponent{
    public JointComponent component;

    public b8 loadBinary(in Span<u8> binary)override;
    public b8 loadComponentPayload(in Span<u8> payload)override;
    public b8 validatePayload()const override;
    public void applyToEntity(mut Entity entity)const override{
        mut JointComponent dst = entity.addComponent<JointComponent>();
        dst = this.component;
        dst.dirty = true;
        dst.runtimeJointId = JointId();
        dst.boundBodyIdA = BodyId();
        dst.boundBodyIdB = BodyId();
        dst.runtimeExtraJointIds.clear();
        dst.boundExtraBodyIdAs.clear();
        dst.boundExtraBodyIdBs.clear();
        dst.primaryJoint.bodyEntityA = s_InvalidEntityId;
        dst.primaryJoint.bodyEntityB = s_InvalidEntityId;
        for(usize i = 0u; i < dst.extraJoints.size(); ++i){
            dst.extraJoints[i].bodyEntityA = s_InvalidEntityId;
            dst.extraJoints[i].bodyEntityB = s_InvalidEntityId;
        }
    }
    public b8 serializeComponentPayload(mut Vector<u8> outPayload)const override;
    public b8 appendValidatedComponentPayload(mut Vector<u8> outBinary)const override;
}

