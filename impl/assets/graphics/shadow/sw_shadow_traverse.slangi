#ifndef NWB_GRAPHICS_SHADOW_SW_SHADOW_TRAVERSE_SLANGI
#define NWB_GRAPHICS_SHADOW_SW_SHADOW_TRAVERSE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "sw_binding_slots.h"
#include "../bvh/constants.h"

// Each tracing pass chooses its occluder class at compile time.
#ifndef NWB_SW_SHADOW_OCCLUDER
#error "each software-shadow trace pass must #define NWB_SW_SHADOW_OCCLUDER before including sw_shadow_traverse.slangi"
#endif

uint nwbMeshFrameMaterialTypedHeapSlot(){
    return g_NwbSwShadowMaterialContextSlots.sceneSlots.w;
}
uint nwbMeshFrameInstanceHeapSlot(){
    return g_NwbSwShadowMaterialContextSlots.materialSlots.x;
}
uint nwbMeshFrameViewHeapSlot(){
    return 0u;
}
#include "../bindless/bindless_heap_mesh.slangi"

#include "sw_shadow_intersect.slangi"
#include "sw_shadow_geometry.slangi"

// (nwbShadowDispatchSurface), which routes by shadowTransmittanceModelId to return each occluder's optical params.
#include "shadow_surface.slangi"
#include "shadow/generated/transmittance_dispatch.slangi"

#include "shadow_integrate.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#define NWB_SW_SHADOW_TRANSMITTANCE_EPSILON 1e-3

uint nwbSwShadowInstanceCount(){
    return g_NwbSwShadowPush.instanceCount;
}


// Per-instance traversal accumulates transparent crossings and stops on opaque hits.
void nwbSwShadowInstanceOccluded(const uint instanceIndex, const float3 worldOrigin, const float3 worldDirection, const float tMin, const float tMax, inout NwbShadowVisibilityAccumulator acc){
    const NwbSwBvhInstance instance = NwbHeapSwShadowSceneInstances(g_NwbSwShadowMaterialContextSlots.sceneSlots.y)[instanceIndex];
    const NwbRtInstanceMaterial material = NwbHeapRtInstanceMaterials(g_NwbSwShadowMaterialContextSlots.sceneSlots.z)[instanceIndex];
    const bool transparent = (material.flags & NWB_RT_INSTANCE_MATERIAL_FLAG_TRANSPARENT) != 0u;
    // Compile-time class filter avoids runtime traversal branching.
#if NWB_SW_SHADOW_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_OPAQUE
    if(transparent)
        return;
#elif NWB_SW_SHADOW_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_TRANSPARENT
    if(!transparent)
        return;
#endif
    // Per-mesh heap indices are non-uniform and must be decorated at every access.
    const float3 origin = nwbSwBvhTransformPoint(instance, worldOrigin);
    const float3 direction = nwbSwBvhTransformVector(instance, worldDirection);
    const float3 invDir = nwbSwShadowSafeInvDir(direction);

    // Near-first traversal defers only far children for early exits.
    //
    // Crossing integration is order-independent; never narrow tMax for transparent occluders.
    uint stack[NWB_SW_SHADOW_MESH_STACK_SIZE];
    uint stackPointer = 0u;
    uint nodeIndex = 0u; // per-mesh root

    // Child nodes are prevalidated by parent ranking; test only the root at loop entry.
    {
        const NwbBvhNode root = NwbHeapBvhNodes(material.nodeSlot)[nodeIndex];
        if(!nwbSwShadowRayAabb(origin, invDir, tMin, tMax, root.aabbMin, root.aabbMax))
            return; // whole mesh missed: no occluder
    }

    while(true){
        const NwbBvhNode node = NwbHeapBvhNodes(material.nodeSlot)[nodeIndex];

        if(nwbBvhNodeIsLeaf(node)){
            const uint triangle = nwbBvhLeafPrimitive(node);
            const uint indexBase = triangle * NWB_RAYTRACE_TRIANGLE_CORNER_COUNT;
            const uint3 indices = NwbHeapRawBuffer(material.indexSlot).Load3(indexBase * NWB_RAYTRACE_INDEX_STRIDE_BYTES);
            const float3 v0 = asfloat(NwbHeapRawBuffer(material.positionSlot).Load3(indices.x * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
            const float3 v1 = asfloat(NwbHeapRawBuffer(material.positionSlot).Load3(indices.y * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
            const float3 v2 = asfloat(NwbHeapRawBuffer(material.positionSlot).Load3(indices.z * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
            const NwbSwShadowTriangleHit triangleHit = nwbSwShadowRayTriangle(origin, direction, tMin, tMax, v0, v1, v2);
            if(triangleHit.hit){
                if(!transparent){
                    acc.transmittance = half3(0.0h, 0.0h, 0.0h);
                    return;
                }
                const uint attributeBase = triangle * NWB_RAYTRACE_TRIANGLE_CORNER_COUNT;
                const NwbRayTraceVertexAttrib a0 = nwbSwShadowLoadVertexAttrib(material.attributeSlot, attributeBase);
                const NwbRayTraceVertexAttrib a1 = nwbSwShadowLoadVertexAttrib(material.attributeSlot, attributeBase + 1u);
                const NwbRayTraceVertexAttrib a2 = nwbSwShadowLoadVertexAttrib(material.attributeSlot, attributeBase + 2u);
                const float smoothNormalWeight = nwbShadowSmoothNormalWeight(float3(a0.normal), float3(a1.normal), float3(a2.normal));

                const float3 objectNormal = float3(a0.normal) * triangleHit.w + float3(a1.normal) * triangleHit.u + float3(a2.normal) * triangleHit.v;

                NwbShadowHit hit;
                hit.meshInstanceIndex = material.meshInstanceIndex;
                hit.shadowTransmittanceModelId = material.shadowTransmittanceModelId;
                hit.materialConstantByteOffset = material.materialConstantByteOffset;
                hit.uv0 = a0.uv0 * triangleHit.w + a1.uv0 * triangleHit.u + a2.uv0 * triangleHit.v;
                hit.worldNormal = nwbSwShadowTransformNormal(instance, objectNormal);
                hit.worldPosition = worldOrigin + worldDirection * triangleHit.t;
                hit.rayDirection = worldDirection;

                const NwbMeshSurface surface = nwbShadowDispatchSurface(material.shadowTransmittanceModelId, hit);
                const float3 geometricNormal = cross(v1 - v0, v2 - v0);
                nwbShadowIntegrateCrossing(acc, instanceIndex, surface.refractionIor, surface.shadowAbsorptionTint, geometricNormal, objectNormal, smoothNormalWeight, direction, triangleHit.t);
                // Stop once transmittance is effectively opaque.
                if(max(max(acc.transmittance.x, acc.transmittance.y), acc.transmittance.z) < NWB_SW_SHADOW_TRANSMITTANCE_EPSILON)
                    return;
            }
            if(stackPointer == 0u)
                return;
            nodeIndex = stack[--stackPointer];
        }
        else{
            const uint left = node.leftChild;
            const uint right = nwbBvhNodeRightChildIndex(node);
            const NwbBvhNode leftNode = NwbHeapBvhNodes(material.nodeSlot)[left];
            const NwbBvhNode rightNode = NwbHeapBvhNodes(material.nodeSlot)[right];
            const float tLeft = nwbSwShadowRayAabbEntryT(origin, invDir, tMin, tMax, leftNode.aabbMin, leftNode.aabbMax);
            const float tRight = nwbSwShadowRayAabbEntryT(origin, invDir, tMin, tMax, rightNode.aabbMin, rightNode.aabbMax);
            const bool leftMiss = (tLeft >= NWB_SW_SHADOW_AABB_MISS);
            const bool rightMiss = (tRight >= NWB_SW_SHADOW_AABB_MISS);

            if(leftMiss && rightMiss){
                if(stackPointer == 0u)
                    return;
                nodeIndex = stack[--stackPointer];
                continue;
            }
            const uint nearChild = (tLeft <= tRight) ? left : right;
            const uint farChild  = (tLeft <= tRight) ? right : left;
            const bool farMiss   = (tLeft <= tRight) ? rightMiss : leftMiss;

            if(farMiss){
                nodeIndex = nearChild;
                continue;
            }

            // Conservatively block light rather than skip an over-deep subtree.
            if((stackPointer + 1u) >= NWB_SW_SHADOW_MESH_STACK_SIZE){
                acc.transmittance = half3(0.0h, 0.0h, 0.0h);
                return;
            }
            stack[stackPointer++] = farChild; // defer; descend the near child inline next iteration
            nodeIndex = nearChild;
        }
    }
}

// Scene traversal refines candidate instances through mesh BVHs.
void nwbSwShadowOccluded(const float3 origin, const float3 direction, const float tMin, const float tMax, inout NwbShadowVisibilityAccumulator acc){
    if(nwbSwShadowInstanceCount() == 0u)
        return;

    const float3 invDir = nwbSwShadowSafeInvDir(direction);

    // Near-first scene traversal preserves early exits.
    uint stack[NWB_SW_SHADOW_SCENE_STACK_SIZE];
    uint stackPointer = 0u;
    uint nodeIndex = 0u; // root

    {
        const NwbBvhNode root = NwbHeapBvhNodes(g_NwbSwShadowMaterialContextSlots.sceneSlots.x)[nodeIndex];
#if NWB_SW_SHADOW_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_TRANSPARENT
        if(!nwbBvhNodeContainsTransparentOccluder(root))
            return; // every scene leaf is opaque, so this compile-time transparent pass has no work
#endif
        if(!nwbSwShadowRayAabb(origin, invDir, tMin, tMax, root.aabbMin, root.aabbMax))
            return; // whole scene missed
    }

    while(true){
        const NwbBvhNode node = NwbHeapBvhNodes(g_NwbSwShadowMaterialContextSlots.sceneSlots.x)[nodeIndex];

        if(nwbBvhNodeIsLeaf(node)){
            nwbSwShadowInstanceOccluded(nwbBvhLeafPrimitive(node), origin, direction, tMin, tMax, acc);
            if(max(max(acc.transmittance.x, acc.transmittance.y), acc.transmittance.z) < NWB_SW_SHADOW_TRANSMITTANCE_EPSILON)
                return;
            if(stackPointer == 0u)
                return;
            nodeIndex = stack[--stackPointer];
        }
        else{
            const uint left = node.leftChild;
            const uint right = nwbBvhNodeRightChildIndex(node);
            const NwbBvhNode leftNode = NwbHeapBvhNodes(g_NwbSwShadowMaterialContextSlots.sceneSlots.x)[left];
            const NwbBvhNode rightNode = NwbHeapBvhNodes(g_NwbSwShadowMaterialContextSlots.sceneSlots.x)[right];
#if NWB_SW_SHADOW_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_TRANSPARENT
            // Prune opaque-only subtrees for transparent-only traces.
            const bool leftTransparent = nwbBvhNodeContainsTransparentOccluder(leftNode);
            const bool rightTransparent = nwbBvhNodeContainsTransparentOccluder(rightNode);
#endif
            const float tLeft =
#if NWB_SW_SHADOW_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_TRANSPARENT
                leftTransparent
                    ? nwbSwShadowRayAabbEntryT(origin, invDir, tMin, tMax, leftNode.aabbMin, leftNode.aabbMax)
                    : NWB_SW_SHADOW_AABB_MISS
#else
                nwbSwShadowRayAabbEntryT(origin, invDir, tMin, tMax, leftNode.aabbMin, leftNode.aabbMax)
#endif
            ;
            const float tRight =
#if NWB_SW_SHADOW_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_TRANSPARENT
                rightTransparent
                    ? nwbSwShadowRayAabbEntryT(origin, invDir, tMin, tMax, rightNode.aabbMin, rightNode.aabbMax)
                    : NWB_SW_SHADOW_AABB_MISS
#else
                nwbSwShadowRayAabbEntryT(origin, invDir, tMin, tMax, rightNode.aabbMin, rightNode.aabbMax)
#endif
            ;
            const bool leftMiss = (tLeft >= NWB_SW_SHADOW_AABB_MISS);
            const bool rightMiss = (tRight >= NWB_SW_SHADOW_AABB_MISS);

            if(leftMiss && rightMiss){
                if(stackPointer == 0u)
                    return;
                nodeIndex = stack[--stackPointer];
                continue;
            }
            const uint nearChild = (tLeft <= tRight) ? left : right;
            const uint farChild  = (tLeft <= tRight) ? right : left;
            const bool farMiss   = (tLeft <= tRight) ? rightMiss : leftMiss;

            if(farMiss){
                nodeIndex = nearChild;
                continue;
            }

            // Conservatively block light rather than skip an over-deep subtree.
            if((stackPointer + 1u) >= NWB_SW_SHADOW_SCENE_STACK_SIZE){
                acc.transmittance = half3(0.0h, 0.0h, 0.0h);
                return;
            }
            stack[stackPointer++] = farChild;
            nodeIndex = nearChild;
        }
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

