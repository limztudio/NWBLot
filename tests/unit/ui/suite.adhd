namespace __hidden_ui_combo_builder_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB;
using namespace NWB::Impl::Ui;
using namespace NWB::UiComboTests;

class UiComboBuilderTests : public ComboFixture{};

// Source fixture that breaks stable-key lookup on the post-selection label read.
class LabelLookupSource final : public ComboSource{
public:
    [[nodiscard]] virtual Expected<u64> indexOf(const u64 key)const noexcept override{
        auto found = ComboSource::indexOf(key);
        if(found && lookupCalls >= 4u)
            *found = (*found + 1u) % count;
        return found;
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


TEST_F(UiComboBuilderTests, SiblingComboFieldsPaintTheirOwnDeclarationStyles){
    m_source.count = 0u;
    ComboState secondState;
    ASSERT_TRUE(begin(1u));
    ASSERT_TRUE(m_builder.beginPanel(s_ComboPanelKey, { 10.0f, 10.0f, 320.0f, 240.0f }));
    m_builder.comboStyle().normal = Name(NWB::Tests::UiCases::s_UiCaseNameButtonNormal);
    ASSERT_TRUE(m_builder.comboBox("first", m_source, m_state, Options()).valid);
    m_builder.comboStyle().normal = Name(NWB::Tests::UiCases::s_UiCaseButtonHover);
    ASSERT_TRUE(m_builder.comboBox("second", m_source, secondState, Options()).valid);
    ASSERT_TRUE(finishPanel());
    const DrawSnapshot snapshot = m_paint.freeze();
    const auto first = skinQuad(snapshot, 6u);
    ASSERT_TRUE(first);
    const auto second = skinQuad(snapshot, 7u);
    ASSERT_TRUE(second);
    EXPECT_LT(first->y, second->y);
}

TEST_F(UiComboBuilderTests, TabExitsAnExplicitlyOpenedComboRelativeToItsFieldWithoutCommittingPreview){
    m_source.count = 4u;
    m_state.select(1u);
    const auto acceptNeighbors = [this](const u64 generation){
        if(!begin(generation) || !m_builder.beginPanel(s_ComboPanelKey, { 10.0f, 10.0f, 320.0f, 240.0f }))
            return false;
        if(m_builder.button("before", "Before"))
            return false;
        m_result = m_builder.comboBox(s_ComboKey, m_source, m_state, Options());
        if(m_builder.button("after", "After"))
            return false;
        return m_result.valid && finishPanel() && m_context.commitFrame(generation);
    };
    m_state.open();
    ASSERT_TRUE(acceptNeighbors(1u));
    ASSERT_EQ(m_context.input().focus(), list());
    press(Core::Key::Down);
    ASSERT_TRUE(acceptNeighbors(2u));
    ASSERT_EQ(m_state.listState().cursorKey(), 2u);
    press(Core::Key::Tab);
    ASSERT_TRUE(acceptNeighbors(3u));
    EXPECT_TRUE(m_result.closed);
    EXPECT_FALSE(m_result.committed);
    EXPECT_EQ(m_state.selectedKey(), 1u);
    EXPECT_EQ(m_state.listState().cursorKey(), 1u);
    EXPECT_EQ(m_context.input().focus(), id("after", s_ComboPanelKey));
    m_state.open();
    ASSERT_TRUE(acceptNeighbors(4u));
    ASSERT_EQ(m_context.input().focus(), list());
    const InputEvent reverseDown{ .position = {}, .key = Core::Key::Tab, .type = InputEventType::KeyDown, .shift = true };
    const InputEvent reverseUp{ .position = {}, .key = Core::Key::Tab, .type = InputEventType::KeyUp, .shift = true };
    EXPECT_TRUE(send(reverseDown).commandConsumed);
    EXPECT_TRUE(send(reverseUp).commandConsumed);
    ASSERT_TRUE(acceptNeighbors(5u));
    EXPECT_TRUE(m_result.closed);
    EXPECT_EQ(m_state.selectedKey(), 1u);
    EXPECT_EQ(m_context.input().focus(), id("before", s_ComboPanelKey));
}

TEST_F(UiComboBuilderTests, TabExitsAnEmptyComboWithoutASelectionOrActivation){
    m_source.count = 0u;
    ASSERT_TRUE(accept(1u));
    ASSERT_TRUE(openByPointer(2u));
    ASSERT_EQ(m_state.selectedKey(), 0u);
    press(Core::Key::Tab);
    ASSERT_TRUE(accept(3u));
    EXPECT_TRUE(m_result.closed);
    EXPECT_FALSE(m_result.committed);
    EXPECT_FALSE(m_result.selectionChanged);
    EXPECT_EQ(m_state.selectedKey(), 0u);
    EXPECT_EQ(m_state.listState().cursorKey(), 0u);
    EXPECT_EQ(m_context.input().focus(), id(s_ComboKey, s_ComboPanelKey));
}

TEST_F(UiComboBuilderTests, OutsideDismissalConsumesTheWholePointerSequence){
    m_state.select(1u);
    ASSERT_TRUE(accept(1u));
    ASSERT_TRUE(openByPointer(2u));
    EXPECT_TRUE(send({ .position = { 790.0f, 590.0f } , .type = InputEventType::PrimaryDown}).pointerConsumed);
    EXPECT_TRUE(send({ .position = { 790.0f, 590.0f } , .type = InputEventType::PrimaryUp}).pointerConsumed);
    EXPECT_TRUE(m_context.input().actions().empty());
    ASSERT_TRUE(accept(3u));
    EXPECT_TRUE(m_result.closed);
    EXPECT_FALSE(m_result.committed);
    EXPECT_FALSE(m_result.selectionChanged);
    EXPECT_EQ(m_state.selectedKey(), 1u);
    EXPECT_FALSE(m_state.isOpen());
}

TEST_F(UiComboBuilderTests, HeldOpeningSubmitWaitsForReleaseBeforeTransferringFocus){
    m_state.select(1u);
    ASSERT_TRUE(accept(1u));
    press(Core::Key::Tab);
    InputEvent event;
    event.type = InputEventType::KeyDown;
    event.key = Core::Key::Enter;
    EXPECT_TRUE(send(event).commandConsumed);
    ASSERT_TRUE(accept(2u));
    EXPECT_FALSE(m_state.isOpen());
    EXPECT_FALSE(m_result.opened);
    EXPECT_EQ(m_context.input().focus(), id(s_ComboKey, s_ComboPanelKey));
    event.repeat = true;
    EXPECT_TRUE(send(event).commandConsumed);
    ASSERT_TRUE(prepare(3u));
    EXPECT_FALSE(m_state.isOpen());
    EXPECT_FALSE(m_result.committed);
    EXPECT_EQ(m_state.selectedKey(), 1u);
    ASSERT_TRUE(m_context.commitFrame(3u));
    event.type = InputEventType::KeyUp;
    event.repeat = false;
    EXPECT_TRUE(send(event).commandConsumed);
    ASSERT_TRUE(accept(4u));
    EXPECT_TRUE(m_state.isOpen());
    EXPECT_TRUE(m_result.opened);
    EXPECT_FALSE(m_result.committed);
    EXPECT_EQ(m_context.input().focus(), list());
    press(Core::Key::Enter);
    ASSERT_TRUE(accept(5u));
    EXPECT_TRUE(m_result.committed);
    EXPECT_FALSE(m_result.selectionChanged);
    EXPECT_FALSE(m_state.isOpen());
}

TEST_F(UiComboBuilderTests, EscapeBeforeReleaseCancelsFieldOpeningAndPopupSubmission){
    m_source.count = 4u;
    m_state.select(1u);
    ASSERT_TRUE(accept(1u));
    press(Core::Key::Tab);
    EXPECT_TRUE(send({ .key = Core::Key::Enter , .type = InputEventType::KeyDown }).commandConsumed);
    ASSERT_TRUE(accept(2u));
    EXPECT_FALSE(m_state.isOpen());
    press(Core::Key::Escape);
    EXPECT_TRUE(send({ .key = Core::Key::Enter , .type = InputEventType::KeyUp }).commandConsumed);
    ASSERT_TRUE(accept(3u));
    EXPECT_FALSE(m_state.isOpen());
    EXPECT_FALSE(m_result.opened);
    EXPECT_FALSE(m_result.committed);
    EXPECT_EQ(m_state.selectedKey(), 1u);
    press(Core::Key::Tab);
