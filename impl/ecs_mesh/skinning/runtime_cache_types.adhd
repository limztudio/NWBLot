#include <impl/ecs_mesh/runtime/types.adhd>
#include <impl/ecs_skeleton/components.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_SkinJointWordCount = 2u;
const u32 s_SkinJointBits = 16u;
const usize s_SkinRestPositionElementBytes = 12u;
const usize s_SkinRestNormalElementBytes = 8u;
const usize s_SkinRestTangentElementBytes = 8u;
const StringView s_SkinnedDrawSuffix = "skinned_draw";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SkinnedRuntimeMeshIdentity{
    public Name meshKey = s_NameNone;
    public u64 version = 0u;
}

[serialize, reflect]
class MeshSkinningRestToSkinnedCopyByteCounts{
    public usize positionBytes = 0u;
    public usize normalBytes = 0u;
    public usize tangentBytes = 0u;
}

class MeshletRefTotalCounts{
    public usize positionRefCount = 0u;
    public usize attributeRefCount = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Array<u32, 2u> PackSkinInfluenceJoints(in SkinInfluence4 sourceSkin){
    Array<u32, 2u> packed;
    for(u32 wordIndex = 0u; wordIndex < s_SkinJointWordCount; ++wordIndex){
        const u32 influenceIndex = wordIndex * 2u;
        packed[wordIndex] = cast<u32>(sourceSkin.joint[influenceIndex]) | (cast<u32>(sourceSkin.joint[influenceIndex + 1u]) << s_SkinJointBits);
    }
    return packed;
}

Expected<MeshSkinningRestToSkinnedCopyByteCounts> TryResolveMeshSkinningRestToSkinnedCopyByteCounts(in usize positionCount, in usize normalCount, in usize tangentCount){
    if(positionCount == 0u || normalCount == 0u || tangentCount == 0u)
        return MakeUnexpected(Failure());
    const usize positionBytes = positionCount * s_SkinRestPositionElementBytes;
    if(positionBytes / s_SkinRestPositionElementBytes != positionCount)
        return MakeUnexpected(Failure());
    const usize normalBytes = normalCount * s_SkinRestNormalElementBytes;
    if(normalBytes / s_SkinRestNormalElementBytes != normalCount)
        return MakeUnexpected(Failure());
    const usize tangentBytes = tangentCount * s_SkinRestTangentElementBytes;
    if(tangentBytes / s_SkinRestTangentElementBytes != tangentCount)
        return MakeUnexpected(Failure());
    MeshSkinningRestToSkinnedCopyByteCounts outCounts;
    outCounts.positionBytes = positionBytes;
    outCounts.normalBytes = normalBytes;
    outCounts.tangentBytes = tangentBytes;
    return outCounts;
}

Expected<SkinnedRuntimeMeshIdentity> TryResolveSkinnedRuntimeMeshIdentity(
    in EntityID entity,
    in RuntimeMeshHandle runtimeMesh,
    in EntityID instanceEntity,
    in RuntimeMeshDirtyFlag dirtyFlags,
    in Name sourceName,
    in u64 handleValue,
    in u32 editRevision
){
    if(!runtimeMesh.valid() || instanceEntity != entity)
        return MakeUnexpected(Failure());
    if((dirtyFlags & (RuntimeMeshDirtyFlag::SkinningInputDirty | RuntimeMeshDirtyFlag::MeshletBoundsDirty)) != RuntimeMeshDirtyFlag::None)
        return MakeUnexpected(Failure());
    const Name meshKey = DeriveRuntimeResourceName(sourceName, handleValue, editRevision, s_SkinnedDrawSuffix);
    if(meshKey == s_NameNone)
        return MakeUnexpected(Failure());
    SkinnedRuntimeMeshIdentity outIdentity;
    outIdentity.meshKey = meshKey;
    outIdentity.version = cast<u64>(editRevision);
    return outIdentity;
}

b8 CanBuildMeshSkinningInfluences(in u32 skeletonJointCount, in usize skinSize){
    return skeletonJointCount > 0u && skeletonJointCount <= cast<u32>(u16.max) + 1u && skinSize <= cast<usize>(u32.max);
}

b8 CanResolveGpuJointPalette(in b8 hasActiveSkin, in usize payloadSkinInfluenceCount, in usize instanceSkinSize, in usize jointCount, in usize payloadJointMatrixCount){
    return
        hasActiveSkin
        && payloadSkinInfluenceCount == instanceSkinSize
        && jointCount > 0u
        && jointCount <= cast<usize>(u16.max) + 1u
        && payloadJointMatrixCount >= jointCount
    ;
}

b8 HasCompleteSplitMeshSkinningPayload(
    in usize restPositionCount,
    in usize restNormalCount,
    in usize restTangentCount,
    in usize uv0Count,
    in usize colorCount,
    in usize skinCount,
    in usize meshletCount,
    in usize meshletBoundsCount,
    in usize meshletPositionRefDeltaCount,
    in usize meshletAttributeRefDeltaCount,
    in usize meshletLocalVertexRefCount,
    in usize meshletPrimitiveIndexCount,
    in u32 meshletPositionRefCount,
    in u32 meshletAttributeRefCount,
    in usize attributeSkinCount
){
    return
        restPositionCount != 0u
        && restNormalCount != 0u
        && restTangentCount == restNormalCount
        && uv0Count != 0u
        && colorCount != 0u
        && skinCount != 0u
        && meshletCount != 0u
        && meshletBoundsCount == meshletCount
        && meshletPositionRefDeltaCount != 0u
        && meshletAttributeRefDeltaCount != 0u
        && meshletLocalVertexRefCount != 0u
        && meshletPrimitiveIndexCount != 0u
        && meshletPositionRefCount > 0u
        && meshletAttributeRefCount > 0u
        && attributeSkinCount == cast<usize>(meshletAttributeRefCount)
    ;
}


