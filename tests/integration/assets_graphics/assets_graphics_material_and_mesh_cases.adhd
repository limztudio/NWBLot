    EXPECT_TRUE(IsSupportedMaterialResourceReference(s_MaterialResourceSampler, s_EngineSamplersLinearClampPath));
    EXPECT_EQ(logger.errorCount(), 0u);
}

void VerifyAssetsGraphics_MaterialBindCookRejectsMalformedParametersAndInterfaceMismatch(){
    if(AssetsGraphicsTestConfigurationName() != "fin")
        return;

    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_ReportOnly);
    TestArena testArena = TestArena();

    Vector<StringView> integrationCaseNames = Vector<StringView>();
    integrationCaseNames.reserve(6u);
    integrationCaseNames.push_back("material_bind_unknown_interface_parameter");
    integrationCaseNames.push_back("material_bind_flat_interface_parameter");
    integrationCaseNames.push_back("material_bind_untyped_material_parameter");
    integrationCaseNames.push_back("material_bind_vector_alias_material_parameter");
    integrationCaseNames.push_back("material_bind_unsupported_material_field");
    integrationCaseNames.push_back("material_bind_incomplete_block_scoped");

    Vector<StringView> integrationDiagnostics = Vector<StringView>();
    integrationDiagnostics.reserve(6u);
    integrationDiagnostics.push_back("parameter 'surface.missing' is not declared by interface");
    integrationDiagnostics.push_back("interface parameter 'runtime.fade_alpha' must be declared inside a block map");
    integrationDiagnostics.push_back("has invalid value '0.25, 0.5, 0.75, 1.0'");
    integrationDiagnostics.push_back("has invalid value 'vec4(0.25, 0.5, 0.75, 1.0)'");
    integrationDiagnostics.push_back("unsupported asset field 'compiler'");
    integrationDiagnostics.push_back("typed parameter 'runtime.fade_alpha' is not declared by interface");

    for(usize caseIndex = 0u; caseIndex < integrationCaseNames.size(); ++caseIndex){
        const Expected<CookCase> cookCase = PrepareCookCase(testArena, integrationCaseNames[caseIndex]);
        ASSERT_TRUE(cookCase.has_value());
        const CookCase prepared = cookCase.value();

        StringView bindSource = s_MinimalMaterialBindSource;
        StringView materialMeta = s_UnknownInterfaceParameterMaterialMeta;
        switch(caseIndex){
        case 0u: materialMeta = s_UnknownInterfaceParameterMaterialMeta; break;
        case 1u: materialMeta = s_FlatInterfaceParameterMaterialMeta; break;
        case 2u: materialMeta = s_UntypedMaterialParameterMeta; break;
        case 3u: materialMeta = s_VectorAliasMaterialParameterMeta; break;
        case 4u: materialMeta = s_UnsupportedMaterialFieldMeta; break;
        case 5u:
            bindSource = s_SurfaceOnlyMaterialBindSource;
            materialMeta = s_BlockScopedMaterialMeta;
            break;
        default: break;
        }
        const b8 cooked = CookMaterialBindIntegration(bindSource, materialMeta, prepared, testArena);
        EXPECT_FALSE(cooked);
        EXPECT_TRUE(SawCapturedError(logger, integrationDiagnostics[caseIndex]));
        EXPECT_TRUE(RemoveAllIfExists(prepared.root));
    }

    const Expected<CookCase> interfaceShaderMismatchCookCase = PrepareCookCase(testArena, "material_bind_interface_without_bind_shader");
    ASSERT_TRUE(interfaceShaderMismatchCookCase.has_value());
    const CookCase shaderMismatchCase = interfaceShaderMismatchCookCase.value();
    const GraphicsTestPath shaderMismatchAssetRoot = JoinGraphicsPath(shaderMismatchCase.root, s_AssetsDirectory);
    const b8 wroteUnboundAssets = WriteMaterialBindIntegrationAssetsWithPixel(
        testArena,
        shaderMismatchAssetRoot,
        s_MinimalMaterialBindSource,
        s_BlockScopedMaterialMeta,
        UnboundMaterialShaderProbeText()
    );
    const b8 cookedUnbound = CookSingleAssetRoot(testArena, shaderMismatchCase.root, shaderMismatchCase.outputDirectory, shaderMismatchAssetRoot);
    EXPECT_TRUE(wroteUnboundAssets);
    EXPECT_FALSE(cookedUnbound);
    EXPECT_TRUE(SawCapturedError(logger, "does not include a generated material bind"));
    EXPECT_TRUE(RemoveAllIfExists(shaderMismatchCase.root));

    const Expected<CookCase> interfaceIdentityMismatchCookCase = PrepareCookCase(testArena, "material_bind_interface_identity_mismatch");
    ASSERT_TRUE(interfaceIdentityMismatchCookCase.has_value());
    const CookCase identityMismatchCase = interfaceIdentityMismatchCookCase.value();
    const GraphicsTestPath identityAssetRoot = JoinGraphicsPath(identityMismatchCase.root, s_AssetsDirectory);
    const b8 wroteIdentityAssets = WriteMaterialBindIntegrationAssetsWithPixel(
        testArena,
        identityAssetRoot,
        s_MinimalMaterialBindSource,
        s_BlockScopedMaterialMeta,
        s_OtherMaterialBindShaderProbeSource
    );
    const b8 wroteOtherBind = WriteTextFile(JoinGraphicsPath2(identityAssetRoot, s_MaterialInterfacesDirectory, "other_surface.bind"), s_MinimalMaterialBindSource);
    const b8 cookedIdentity = CookSingleAssetRoot(testArena, identityMismatchCase.root, identityMismatchCase.outputDirectory, identityAssetRoot);
    EXPECT_TRUE(wroteIdentityAssets);
    EXPECT_TRUE(wroteOtherBind);
    EXPECT_FALSE(cookedIdentity);
    EXPECT_TRUE(SawCapturedError(logger, "includes generated material bind interface 'project/material_interfaces/other_surface'"));
    EXPECT_TRUE(RemoveAllIfExists(identityMismatchCase.root));
}

void VerifyAssetsGraphics_ShadowSurfaceDispatchIsolatesOverlappingBindApis(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    const Expected<CookCase> cookCase = PrepareCookCase(testArena, "shadow_transmittance_dispatch_overlapping_bind_apis");
    ASSERT_TRUE(cookCase.has_value());
    const CookCase prepared = cookCase.value();

    const GraphicsTestPath assetRoot = JoinGraphicsPath(prepared.root, s_AssetsDirectory);
    const b8 assetsWritten =
        WriteTextFile(JoinGraphicsPath2(assetRoot, s_MaterialInterfacesDirectory, "shadow_dispatch_first.bind"), s_ShadowDispatchFirstMaterialBindSource)
        && WriteTextFile(JoinGraphicsPath2(assetRoot, s_MaterialInterfacesDirectory, "shadow_dispatch_second.bind"), s_ShadowDispatchSecondMaterialBindSource)
        && WriteTextFile(JoinGraphicsPath2(assetRoot, s_ShadersDirectory, "shadow_dispatch_shared_surface_helper.slangi"), s_ShadowDispatchSharedSurfaceHelperSource)
        && WriteTextFile(JoinGraphicsPath2(assetRoot, s_ShadersDirectory, "shadow_dispatch_first.surface"), s_ShadowDispatchFirstMaterialSurfaceSource)
        && WriteTextFile(JoinGraphicsPath2(assetRoot, s_ShadersDirectory, "shadow_dispatch_second.surface"), s_ShadowDispatchSecondMaterialSurfaceSource)
        && WriteTextFile(JoinGraphicsPath2(assetRoot, s_ShadersDirectory, "shadow_dispatch.bxdf"), s_MaterialBindBxdfSource)
        && WriteTextFile(JoinGraphicsPath2(assetRoot, s_MaterialsDirectory, "shadow_dispatch_first.nwb"), s_ShadowDispatchFirstMaterialMeta)
        && WriteTextFile(JoinGraphicsPath2(assetRoot, s_MaterialsDirectory, "shadow_dispatch_second.nwb"), s_ShadowDispatchSecondMaterialMeta)
    ;
    ASSERT_TRUE(assetsWritten);

    const GraphicsTestPath engineAssetRoot = JoinGraphicsPath2(GetGraphicsTestRepoRoot(testArena), "impl", s_AssetsDirectory);
    const b8 cooked = CookTwoAssetRoots(testArena, prepared.root, prepared.outputDirectory, engineAssetRoot, assetRoot);
    EXPECT_TRUE(cooked);
    EXPECT_EQ(logger.errorCount(), 0u);
    EXPECT_TRUE(RemoveAllIfExists(prepared.root));
}

void VerifyAssetsGraphics_MaterialRejectsMissingInterfaceCookIntegration(){
    if(AssetsGraphicsTestConfigurationName() != "fin")
        return;

    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_ReportOnly);
    TestArena testArena = TestArena();
    const Expected<CookCase> cookCase = PrepareCookCase(testArena, "material_missing_interface_rejection");
    ASSERT_TRUE(cookCase.has_value());
    const CookCase prepared = cookCase.value();

    const GraphicsTestPath assetRoot = JoinGraphicsPath(prepared.root, s_AssetsDirectory);
    const b8 wroteAssets = WriteMaterialBindIntegrationAssetsWithPixel(
        testArena,
        assetRoot,
        s_MinimalMaterialBindSource,
        s_MissingInterfaceMaterialMeta,
        UnboundMaterialShaderProbeText()
