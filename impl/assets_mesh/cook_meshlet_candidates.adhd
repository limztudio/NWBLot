#include <impl/assets_mesh/cook_meshlet_triangles.adhd>
#include <impl/assets_mesh/cook_meshlet_scoring.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize ComputeMeshletParallelCandidateReserve(in u32 workerThreadCount){
    return (cast<usize>(workerThreadCount) + 1u) * s_MeshletDisconnectedCandidateParallelOversubscription;
}

b8 CanSearchDisconnectedMeshletCandidatesParallel(in b8 isParallelEnabled, in usize searchCount){
    return isParallelEnabled && searchCount >= s_MeshletDisconnectedCandidateParallelThreshold;
}

Expected<MeshletFrontierCandidate> FindBestDisconnectedMeshletCandidate(
    in Span<MeshletTriangleData> triangles,
    in Span<MeshletTriangleCalculation> triangleCalculations,
    in Span<u8> visitedTriangles,
    in usize searchOffset,
    in Span<u32> triangleIndices,
    in MeshletScoreState scoreState,
    in MeshletDesc meshlet,
    in Span<u32> localVertexRefs,
    in b8 isParallelEnabled,
    in u32 workerThreadCount,
    mut Vector<MeshletCandidateSearchResult> parallelCandidates
){
    const usize triangleCount = triangles.size();
    if(searchOffset >= triangleCount)
        return MakeUnexpected(Failure());

    const usize searchCount = triangleCount - searchOffset;
    if(!CanSearchDisconnectedMeshletCandidatesParallel(isParallelEnabled, searchCount)){
        return FindBestDisconnectedMeshletCandidateRangeFromPrecompute(
            triangles,
            triangleCalculations,
            visitedTriangles,
            searchOffset,
            triangleCount,
            triangleIndices,
            scoreState,
            meshlet,
            localVertexRefs
        );
    }

    const usize chunkCount = ResolveMeshletDisconnectedCandidateChunkCount(searchCount, workerThreadCount);
    parallelCandidates.clear();
    parallelCandidates.resize(chunkCount);

    parallel_for(usize chunkIndex = 0u; chunkIndex < chunkCount; ++chunkIndex){
        usize chunkBegin = 0u;
        usize chunkEnd = 0u;
        ResolveMeshletDisconnectedCandidateChunkRange(searchOffset, searchCount, chunkCount, chunkIndex, chunkBegin, chunkEnd);

        MeshletCandidateSearchResult result;
        const Expected<MeshletFrontierCandidate> foundCandidate = FindBestDisconnectedMeshletCandidateRangeFromPrecompute(
            triangles,
            triangleCalculations,
            visitedTriangles,
            chunkBegin,
            chunkEnd,
            triangleIndices,
            scoreState,
            meshlet,
            localVertexRefs
        );
        result.found = foundCandidate.has_value();
        if(foundCandidate.has_value())
            result.candidate = foundCandidate.value();
        parallelCandidates[chunkIndex] = result;
    }

    return SelectBestMeshletCandidateFromResults(parallelCandidates);
}


