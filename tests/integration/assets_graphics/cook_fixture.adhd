void ExpectNoShaderCompilerWorkDirectories(in GraphicsTestPath cache){
    const Path root(cache);
    const auto entries = RecursiveDirectoryIteratorCreate(root);
    ASSERT_TRUE(entries.has_value());
    for(in DirectoryEntry entry : entries.value()){
        const String name = PathToString(entry.path().filenameView());
        ScopedTestTrace trace(name);
        EXPECT_FALSE(StringView(name).starts_with(".nwb_shader_"));
    }
}

Expected<GraphicsTestPath> FindSingleShaderBytecodeCachePath(in GraphicsTestPath cache, mut TestArena storage){
    const Path root(cache);
    const auto entries = RecursiveDirectoryIteratorCreate(root);
    EXPECT_TRUE(entries.has_value());
    if(!entries.has_value())
        return MakeUnexpected(Failure());
    Path found;
    usize count = 0u;
    for(in DirectoryEntry entry : entries.value()){
        const auto regular = entry.isRegularFile();
        EXPECT_TRUE(regular.has_value());
        if(!regular.has_value())
            return MakeUnexpected(Failure());
        if(regular.value() && entry.path().extensionView() == PlatformTextLiteral(".spv")){
            found = entry.path();
            ++count;
        }
    }
    EXPECT_EQ(count, 1u);
    if(count != 1u)
        return MakeUnexpected(Failure());
    return OwnGraphicsPath(storage, found);
}

class GatherMergeCount{
    public usize calls = 0u;
}

class GatherBytesMerge{
    public b8 merge(in Name name, in BinaryByteView bytes, mut BinaryUpdateContext context){
        mut GatherMergeCount counter = TestProcessValue<GatherMergeCount>();
        ++counter.calls;
        mut HeapStorageVector<u8> output = TestGatherOutput(context);
        for(in u8 byte : bytes.span())
            output.push_back(byte);
        return true;
    }
}

