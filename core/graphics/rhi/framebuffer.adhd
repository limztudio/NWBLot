[cpp_header("<core/graphics/rhi/framebuffer.h>"), cpp_name("::NWB::Core::FramebufferAttachment")]
extern class FramebufferAttachment{
    TextureSubresourceSet subresources;
    Format format;
    b8 isReadOnly;
    FramebufferAttachment setArraySlice(...);
    FramebufferAttachment setFormat(...);
    FramebufferAttachment setIsReadOnly(...);
    FramebufferAttachment setMipLevel(...);
    FramebufferAttachment setSubresources(...);
    b8 hasTexture(in RhiTexture value)const;
    b8 valid(...)const;
    FramebufferAttachment setTexture(...);
};

[cpp_header("<core/graphics/rhi/framebuffer.h>"), cpp_name("::NWB::Core::FramebufferDesc")]
extern class FramebufferDesc{
    FramebufferAttachment depthAttachment;
    FramebufferAttachment shadingRateAttachment;
    FixedVector<FramebufferAttachment, 8> colorAttachments;
    FramebufferDesc addColorAttachment(...);
    FramebufferDesc setDepthAttachment(...);
};

[cpp_header("<core/graphics/rhi/framebuffer.h>"), cpp_name("::NWB::Core::FramebufferHandle")]
extern class FramebufferHandle{
    FramebufferPtr get()const;
    b8 valid(...)const;
    u32 reset(...);
    mut Framebuffer deref(...)const;
};

[cpp_header("<core/graphics/rhi/framebuffer.h>"), cpp_name("::NWB::Core::FramebufferInfo")]
extern class FramebufferInfo{
    u32 sampleCount;
    u32 sampleQuality;
    Format depthFormat;
    FixedVector<Format, 8> colorFormats;
    FramebufferInfo addColorFormat(...);
    FramebufferInfo setDepthFormat(...);
};

[cpp_header("<core/graphics/rhi/framebuffer.h>"), cpp_name("::NWB::Core::FramebufferInfoEx")]
extern class FramebufferInfoEx{
    u32 width;
    u32 height;
    u32 arraySize;
    FixedVector<Format, 8> colorFormats;
    u32 sampleCount;
    u32 sampleQuality;
    Format depthFormat;
    Viewport getViewport(...)const;
    FramebufferInfoEx setArraySize(...);
    FramebufferInfoEx setHeight(...);
    FramebufferInfoEx setWidth(...);
    FramebufferInfo addColorFormat(...);
    FramebufferInfo setDepthFormat(...);
};


