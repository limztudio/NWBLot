}

void VerifyUiPopupRouterTests_InsertingLowerBeneathRetainedTopKeepsTopFocusAndTheOriginalBaseRestoreTarget(mut UiPopupRouterTests self){
    self.focusBase();
    const PopupScope higher = MakeUiPopupRouterScopeLayer(200u, 5u);
    ASSERT_TRUE(self.install(higher, 2u));
    self.key(Key::Tab);
    ASSERT_EQ(self.m_router.focus().value, 202u);
    const PopupScope lower = MakeUiPopupRouterScope();
    const Array<HitTarget, 5u> lowerTargets = MakeUiPopupRouterTargets(lower);
    Array<HitTarget, 8u> targets = Array<HitTarget, 8u>();
    targets[0u] = lowerTargets[0u];
    targets[1u] = lowerTargets[1u];
    targets[2u] = lowerTargets[2u];
    targets[3u] = lowerTargets[3u];
    targets[4u] = lowerTargets[4u];
    targets[5u] = MakeUiPopupRouterBarrier(higher);
    targets[6u] = MakeUiPopupRouterChild(higher, 201u, Rect(50.0f, 50.0f, 30.0f, 20.0f), 11u);
    targets[7u] = MakeUiPopupRouterChild(higher, 202u, Rect(90.0f, 50.0f, 30.0f, 20.0f), 12u);
    Array<PopupScope, 2u> scopes = Array<PopupScope, 2u>();
    scopes[0u] = lower;
    scopes[1u] = higher;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 3u, scopes));
    EXPECT_EQ(self.m_router.focus().value, 202u);
    self.m_router.closePopup(higher.token);
    ASSERT_TRUE(self.install(lower, 4u));
    EXPECT_EQ(self.m_router.focus().value, 101u);
    self.m_router.closePopup(lower.token);
    const Array<HitTarget, 2u> base = MakeUiPopupRouterBaseTargets();
    ASSERT_TRUE(self.m_router.commitTargets(base, 5u));
    EXPECT_FALSE(self.m_router.hasPopup());
    EXPECT_EQ(self.m_router.focus().value, 1u);
}

void VerifyUiPopupRouterTests_FocusLossDismissesAllScopesWithoutRestoringUnderlyingFocus(mut UiPopupRouterTests self){
    self.focusBase();
    const PopupScope lower = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(lower, 2u));
    const PopupScope higher = MakeUiPopupRouterScopeLayer(200u, 5u);
    const Array<HitTarget, 7u> targets = MakeUiPopupRouterTwoLayerTargets(lower, higher);
    Array<PopupScope, 2u> scopes = Array<PopupScope, 2u>();
    scopes[0u] = lower;
    scopes[1u] = higher;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 3u, scopes));
    EXPECT_TRUE(self.send(MakeUiBareInputEvent(InputEventType::FocusLost)).commandConsumed);
    EXPECT_FALSE(self.m_router.focus().valid());
    const auto reasonResult1 = self.m_router.consumePopupDismissal(lower.token);
    ASSERT_TRUE(reasonResult1.has_value());
    EXPECT_EQ(reasonResult1.value(), PopupDismissReason::FocusLost);
    const auto reasonResult2 = self.m_router.consumePopupDismissal(higher.token);
    ASSERT_TRUE(reasonResult2.has_value());
    EXPECT_EQ(reasonResult2.value(), PopupDismissReason::FocusLost);
    const Array<HitTarget, 2u> base = MakeUiPopupRouterBaseTargets();
    ASSERT_TRUE(self.m_router.commitTargets(base, 4u));
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.hasPopup());
}

void VerifyUiPopupRouterTests_FocusLossWhileAlreadyClosingStillSuppressesSavedFocusRestoration(mut UiPopupRouterTests self){
    self.focusBase();
    const PopupScope scope = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(scope, 2u));
    self.key(Key::Escape);
    EXPECT_TRUE(self.m_router.hasPopup());
    EXPECT_TRUE(self.send(MakeUiBareInputEvent(InputEventType::FocusLost)).commandConsumed);
    const Array<HitTarget, 2u> base = MakeUiPopupRouterBaseTargets();
    ASSERT_TRUE(self.m_router.commitTargets(base, 3u));
    EXPECT_FALSE(self.m_router.hasPopup());
    EXPECT_FALSE(self.m_router.focus().valid());
}

void VerifyUiPopupRouterTests_InvalidatingPopupOwnerRetiresItsScopeActionsAndHeldCaptureImmediately(mut UiPopupRouterTests self){
    const PopupScope scope = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(scope, 7u));
    self.click(Point(55.0f, 55.0f));
    EXPECT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PrimaryDown, Point(55.0f, 55.0f))).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiRepeatedKeyEvent(InputEventType::KeyDown, Key::Space, false)).commandConsumed);
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    self.m_router.invalidateTarget(scope.token.widget);
    EXPECT_FALSE(self.m_router.hasPopup());
    EXPECT_EQ(self.m_router.layoutGeneration(), 7u);
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.hitTest(Point(55.0f, 55.0f)).valid());
    EXPECT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PrimaryUp, Point(55.0f, 55.0f))).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiRepeatedKeyEvent(InputEventType::KeyUp, Key::Space, false)).commandConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(WidgetId(101u)));
}

void VerifyUiPopupRouterTests_InvalidScopeDescriptionsRejectAtomicallyWithoutChangingAcceptedInteraction(mut UiPopupRouterTests self){
    const PopupScope scope = MakeUiPopupRouterScope();
    const Array<HitTarget, 5u> targets = MakeUiPopupRouterTargets(scope);
    ASSERT_TRUE(self.install(scope, 1u));
    self.key(Key::Enter);
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PrimaryDown, Point(55.0f, 55.0f))).pointerConsumed);
    Array<PopupScope, 10u> invalid = Array<PopupScope, 10u>();
    for(mut PopupScope candidate : invalid)
        candidate = scope;
    invalid[0u].token.widget = WidgetId();
    invalid[1u].token.declarationGeneration = 0u;
    invalid[2u].token.instanceGeneration = 0u;
    invalid[3u].token.openGeneration = 0u;
    invalid[4u].layer = 0u;
    invalid[5u].bounds.width = 0.0f;
    invalid[6u].viewport.height = 0.0f;
    invalid[7u].bounds.x = bit_cast<f32>(0x7fc00000u);
    invalid[8u].bounds.x = -1.0f;
    invalid[9u].bounds.height = -1.0f;
    for(in PopupScope candidate : invalid){
        EXPECT_FALSE(self.commitWithScope(targets, 2u, candidate));
        EXPECT_EQ(self.m_router.layoutGeneration(), 1u);
        EXPECT_TRUE(self.m_router.hasPopup());
        EXPECT_EQ(self.m_router.focus().value, 101u);
        EXPECT_EQ(self.m_router.capture().value, 101u);
        EXPECT_EQ(self.m_router.hitTest(Point(55.0f, 55.0f)).value, 101u);
        EXPECT_EQ(self.m_router.actions().size(), 1u);
    }
    EXPECT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PrimaryUp, Point(55.0f, 55.0f))).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(WidgetId(101u)));
}

void VerifyUiPopupRouterTests_MissingOwnersDuplicateScopesAndMismatchedScopedTargetsRejectAtomically(mut UiPopupRouterTests self){
    const PopupScope scope = MakeUiPopupRouterScope();
    const Array<HitTarget, 5u> accepted = MakeUiPopupRouterTargets(scope);
    ASSERT_TRUE(self.install(scope, 1u));
    Array<PopupScope, 2u> duplicate = Array<PopupScope, 2u>();
    duplicate[0u] = scope;
    duplicate[1u] = scope;
    EXPECT_FALSE(self.m_router.commitTargets(accepted, 2u, duplicate));
    EXPECT_FALSE(self.m_router.commitTargets(accepted, 2u));
    for(usize mismatch = 0u; mismatch < 7u; ++mismatch){
        Array<HitTarget, 5u> invalid = accepted;
        switch(mismatch){
        case 0u:
            ++invalid[3u].popup.openGeneration;
            break;
        case 1u:
            ++invalid[3u].layer;
            break;
        case 2u:
            invalid[0u].layer = 1u;
            break;
        case 3u:
            invalid[0u].popup.widget = scope.token.widget;
            break;
        case 4u:
            invalid[2u].id = WidgetId(150u);
            break;
        case 5u:
            ++invalid[2u].declarationGeneration;
            break;
        default:
            invalid[2u].popup = PopupToken();
            break;
        }
        EXPECT_FALSE(self.commitWithScope(invalid, 2u, scope));
        EXPECT_EQ(self.m_router.layoutGeneration(), 1u);
        EXPECT_EQ(self.m_router.focus().value, 101u);
        EXPECT_EQ(self.m_router.hitTest(Point(55.0f, 55.0f)).value, 101u);
    }
    Array<HitTarget, 5u> invalid = accepted;
    invalid[4u] = invalid[2u];
    EXPECT_FALSE(self.commitWithScope(invalid, 2u, scope));
    EXPECT_TRUE(self.install(scope, 2u));
}

void VerifyUiPopupRouterTests_PopupCountBoundRejectsWithoutReplacingTheAcceptedScope(mut UiPopupRouterTests self){
    const PopupScope scope = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(scope, 1u));
    Array<PopupScope, 9u> overflow = Array<PopupScope, 9u>();
    ASSERT_EQ(overflow.size(), s_InputMaxPopups + 1u);
    for(usize index = 0u; index < overflow.size(); ++index)
        overflow[index] = MakeUiPopupRouterScopeLayer(200u + index, cast<u32>(index + 1u));
    const Array<HitTarget, 5u> targets = MakeUiPopupRouterTargets(scope);
    EXPECT_FALSE(self.m_router.commitTargets(targets, 2u, overflow));
    EXPECT_EQ(self.m_router.layoutGeneration(), 1u);
    EXPECT_EQ(self.m_router.focus().value, 101u);
    EXPECT_TRUE(self.m_router.hasPopup());
}

void VerifyUiPopupRouterTests_ResetDropsOwnedScopesDismissalsAndInteractionBeforeLayoutReuse(mut UiPopupRouterTests self){
    const PopupScope scope = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(scope, 7u));
    self.key(Key::Escape);
    self.m_router.reset();
    EXPECT_FALSE(self.m_router.hasPopup());
    EXPECT_FALSE(self.m_router.wantsCommands());
    EXPECT_FALSE(self.m_router.wantsPointer());
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_EQ(self.m_router.layoutGeneration(), 0u);
    EXPECT_FALSE(self.m_router.consumePopupDismissal(scope.token).has_value());
    const Array<HitTarget, 2u> base = MakeUiPopupRouterBaseTargets();
    ASSERT_TRUE(self.m_router.commitTargets(base, 1u));
    EXPECT_EQ(self.m_router.hitTest(Point(15.0f, 15.0f)).value, 1u);
}


