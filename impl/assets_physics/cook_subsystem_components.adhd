b8 ParseSoftBodyAttachmentMap(in Path file, in MetascriptValue mapVal, mut SoftBodyAttachment outAttach){
    return mapVal.forEachMapEntry(lambda[in file, mut outAttach](in StringView key, in MetascriptValue fieldVal) -> b8{
        if(key == "particle_index") return ReadPhysicsU32Value(file, fieldVal, s_SoftBodyComponentDiagnosticPrefix, key, outAttach.particleIndex);
        if(key == "local_anchor"){
            const Expected<VectorSingle> v = DecodePhysicsFloat3Value(file, fieldVal, s_SoftBodyComponentDiagnosticPrefix, key);
