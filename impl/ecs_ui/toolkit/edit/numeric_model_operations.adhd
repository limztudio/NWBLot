////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "model.adhd"
#include "numeric_types.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class NumericEditDraft : NoCopy{
    private EditModel m_model;
    private String m_accepted;
    private u64 m_revision = 1u;

    public NumericEditDraft(){
        this.m_model = EditModel(MakeNumericDraftLimits());
        this.m_accepted.reserve(s_NumericEditMaxBytes);
    }

    public in EditModel model()const{ return this.m_model; }

    public mut EditModel lend(){ return this.m_model; }

    public b8 dirty()const{ return this.m_model.text() != StringView(this.m_accepted); }

    public u64 revision()const{ return this.m_revision; }

    public b8 setText(in StringView text){
        return FinalizeNumericDraftTextUpdate(this.m_model.setText(text), this.m_revision);
    }

    public Expected<b8, ErrorCode> canonicalize(in StringView formatted){
        const b8 changed = HasCanonicalDraftChanged(formatted, this.m_model.text());
        const b8 updated = this.m_model.setText(formatted);
        return FinalizeCanonicalNumericDraft(formatted, changed, updated, this.m_accepted);
    }

    public void advance(){ AdvanceNonWrappingRevision(this.m_revision); }

    public NumericEditResult restore(in Expected<b8, ErrorCode> restored, in b8 cancelled){
        NumericEditResult result;
        if(restored.has_value()){
            result.restored = restored.value();
            result.valid = true;
            result.cancelled = cancelled;
            this.advance();
        }
        return result;
    }

    public NumericEditResult commit(
        in b8 canonical,
        in b8 accepted,
        in b8 clamped,
        in b8 changed,
        in Expected<b8, ErrorCode> canonicalized
    ){
        NumericEditResult result;
        if(canonical || clamped){
            if(!canonicalized.has_value())
                return result;
            result.restored = !accepted && canonicalized.value();
        }
        else if(accepted){
            const StringView currentText = this.m_model.text();
            this.m_accepted.reserve(currentText.size());
            if(currentText.empty())
                this.m_accepted.clear();
            else
                this.m_accepted.assign(currentText);
        }
        result.valid = true;
        result.committed = accepted;
        result.rejected = !accepted;
        result.valueChanged = accepted && changed;
        result.clamped = clamped;
        this.advance();
        return result;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


EditLimits MakeNumericDraftLimits(){
    EditLimits limits;
    limits.maxBytes = s_NumericEditMaxBytes;
    limits.maxHistoryRecords = s_NumericEditMaxHistoryRecords;
    limits.maxHistoryBytes = s_NumericEditMaxBytes * s_NumericEditHistoryBytesFactor;
    return limits;
}

Expected<void, ErrorCode> FormatNumericEditValueInto(in i64 value, mut CompactString outText){
    return FormatI64Into(value, outText);
}

Expected<void, ErrorCode> FormatNumericEditValueInto(in f64 value, mut CompactString outText){
    return FormatF64Into(value, outText);
}

b8 ValidateNumericEditBounds(in IntegerBounds bounds){
    return ValidateIntegerBounds(bounds);
}

b8 ValidateNumericEditBounds(in FloatBounds bounds){
    return ValidateFloatBounds(bounds);
}

b8 HasNumericEditValueChanged(in i64 candidate, in i64 value){
    return HasIntegerEditValueChanged(candidate, value);
}

b8 HasNumericEditValueChanged(in f64 candidate, in f64 value){
    return HasFloatEditBitsChanged(candidate, value);
}

Expected<b8, ErrorCode> CanonicalizeNumericEditDraft<ValueT>(in ValueT value, mut NumericEditDraft inOutDraft){
    CompactString text;
    const Expected<void, ErrorCode> formatted = FormatNumericEditValueInto(value, text);
    if(!formatted.has_value())
        return MakeUnexpected(formatted.error());
    return inOutDraft.canonicalize(text.view());
}

NumericEditResult CommitNumericEdit<ValueT, BoundsT>(
    in BoundsT bounds,
    in Expected<ValueT, NumericParseStatus> parsed,
    in b8 canonical,
    mut NumericEditDraft inOutDraft,
    mut ValueT inOutValue
){
    if(!ValidateNumericEditBounds(bounds))
        return NumericEditResult();
    const b8 outside = parsed.has_value() && IsNumericValueOutOfRange(parsed.value(), bounds);
    const b8 clamped = outside && bounds.policy == NumericBoundsPolicy::Clamp;
    const b8 accepted = parsed.has_value() && (!outside || clamped);
    ValueT candidate = inOutValue;
    if(accepted){
        candidate = parsed.value();
        if(clamped)
            candidate = ClampNumericValueToBounds(candidate, bounds);
    }
    const b8 changed = HasNumericEditValueChanged(candidate, inOutValue);
    Expected<b8, ErrorCode> canonicalized = false;
    if(canonical || clamped)
        canonicalized = CanonicalizeNumericEditDraft(candidate, inOutDraft);
    const NumericEditResult result = inOutDraft.commit(canonical, accepted, clamped, changed, canonicalized);
    if(result.committed)
        inOutValue = candidate;
    return result;
}

NumericEditResult ApplyNumericEditModelAction<ValueT, BoundsT>(
    in BoundsT bounds,
    in Expected<ValueT, NumericParseStatus> parsed,
    in EditAction action,
    in b8 readOnly,
    mut NumericEditDraft inOutDraft,
    mut ValueT inOutValue
){
    NumericEditResult result;
    if(action == EditAction::Submit){
        if(readOnly)
            result.valid = true;
        else
            result = CommitNumericEdit(bounds, parsed, false, inOutDraft, inOutValue);
    }
    else if(action == EditAction::Cancel)
        result = inOutDraft.restore(CanonicalizeNumericEditDraft(inOutValue, inOutDraft), true);
    else if(action == EditAction::Blur && !readOnly)
        result = CommitNumericEdit(bounds, parsed, true, inOutDraft, inOutValue);
    else if(action == EditAction::Abandon || action == EditAction::Blur)
        result = inOutDraft.restore(CanonicalizeNumericEditDraft(inOutValue, inOutDraft), false);
    return result;
}


