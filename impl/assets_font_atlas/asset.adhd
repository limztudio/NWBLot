////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_font_atlas/payload_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena, asset("font_atlas")]
class FontAtlas{
    private FontAtlasPayload m_payload;

    public b8 loadBinary(in Span<u8> binary);
    public b8 validatePayload(mut ScratchArena scratchArena)const;
    public void setPayload(in FontAtlasPayload payload){
        this.m_payload = payload;
    }

    public in FontAtlasPayload payload()const{ return this.m_payload; }

    public b8 tryGlyph(in u32 glyphId, mut FontAtlasGlyph outGlyph)const{
        if(cast<usize>(glyphId) >= this.m_payload.glyphs.size())
            return false;
        outGlyph = this.m_payload.glyphs[glyphId];
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

