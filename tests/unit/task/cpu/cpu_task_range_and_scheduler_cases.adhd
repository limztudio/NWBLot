void VerifyCpuTaskSchedulerTests_QueuedPrioritiesRunCriticalThenNormalThenBackgroundAfterOccupiedWorkerReleases(){
    DeadlineGuard deadline(false, s_TestTimeoutMS);
    TaskGate occupied = TaskGate();
    const TestSchedulerConfig config = HomogeneousWorkers(1u);
    CpuTaskScheduler scheduler(config);
    ScopeExit releaseWorker(lambda[mut occupied]() -> void{
        occupied.open();
    });
    const auto cpuTaskAdmission = scheduler.submit(lambda[mut occupied]() -> void{
        occupied.block();
    });
    EXPECT_TRUE(cpuTaskAdmission.has_value());
    if(cpuTaskAdmission.has_value()){
        EXPECT_TRUE(cpuTaskAdmission.value().valid());
    }
    EXPECT_TRUE(WaitUntil(occupied.entered, s_GateTimeoutMS));
    Atomic<u32> cursor(0u);
    Array<u32, 3> order = Array<u32, 3>();
    Array<CpuTaskPriorityEnum, 3> priorities = Array<CpuTaskPriorityEnum, 3>();
    priorities[0u] = CpuTaskPriority::Background;
    priorities[1u] = CpuTaskPriority::Normal;
    priorities[2u] = CpuTaskPriority::Critical;
    for(u32 index = 0u; index < 3u; ++index){
        CpuTaskOptions options = CpuTaskOptions();
        options.priority = priorities[index];
        const auto secondCpuTaskAdmission = scheduler.submit(lambda[mut order, mut cursor, in index]() -> void{
            order[cursor.fetch_add(1u, MemoryOrder::relaxed)] = index;
        }, options);
        EXPECT_TRUE(secondCpuTaskAdmission.has_value());
        if(secondCpuTaskAdmission.has_value()){
            EXPECT_TRUE(secondCpuTaskAdmission.value().valid());
        }
    }
    occupied.open();
    scheduler.wait();
    EXPECT_FALSE(occupied.expired.load(MemoryOrder::acquire));
    EXPECT_EQ(cursor.load(MemoryOrder::acquire), 3u);
    EXPECT_EQ(order[0u], 2u);
    EXPECT_EQ(order[1u], 1u);
    EXPECT_EQ(order[2u], 0u);
}

void VerifyCpuTaskSchedulerTests_CanceledScopeSkipsQueuedBodiesAndTheirDependentsAndRetiresCaptures(){
    DeadlineGuard deadline(false, s_TestTimeoutMS);
    Atomic<u32> retired(0u);
    u32 invoked = 0u;
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope scope(scheduler);
    CpuTaskHandle dependent = CpuTaskHandle();
    native(mut scope, mut scheduler, mut invoked, mut retired, mut dependent){
        const auto predecessorTaskAdmission = scope.submit([&invoked, capture = LifetimeProbe(retired, 1u)]()noexcept { invoked += capture.value; });
        ASSERT_TRUE(predecessorTaskAdmission);
        const auto predecessor = *predecessorTaskAdmission;
        const auto dependentTaskAdmission = scheduler.submit([&invoked, capture = LifetimeProbe(retired, 2u)]()noexcept { invoked += capture.value; }, predecessor);
        ASSERT_TRUE(dependentTaskAdmission);
        dependent = *dependentTaskAdmission;
    }
    scope.cancel();
    const auto cpuTaskAdmission = scope.submit(lambda[mut invoked]() -> void{
        ++invoked;
    });
    EXPECT_FALSE(cpuTaskAdmission.has_value());
    scheduler.wait(dependent);
    scope.wait();
    const auto stats = scheduler.statistics();
    EXPECT_EQ(invoked, 0u);
    EXPECT_EQ(retired.load(MemoryOrder::acquire), 2u);
    EXPECT_EQ(stats.canceledTasks, 2u);
    EXPECT_EQ(stats.completedTasks, 0u);
}

void VerifyCpuTaskSchedulerTests_CancelingAnActiveParentPreventsFutureDescendantsAndContinuations(){
    DeadlineGuard deadline(false, s_TestTimeoutMS);
    TaskGate parentGate = TaskGate();
    const TestSchedulerConfig config = HomogeneousWorkers(1u);
    CpuTaskScheduler scheduler(config);
    CpuTaskScope scope(scheduler);
    ScopeExit releaseParent(lambda[mut parentGate]() -> void{
        parentGate.open();
    });
    Atomic<u32> childInvocations(0u);
    Atomic<u32> continuationInvocations(0u);
    Atomic<b8> childRejected(false);
    const auto cpuTaskAdmission = scope.submit(lambda[mut parentGate, mut scheduler, mut childInvocations, mut childRejected]() -> void{
        parentGate.block();
        const auto secondCpuTaskAdmission = scheduler.submit(lambda[mut childInvocations]() -> void{
            childInvocations.fetch_add(1u, MemoryOrder::relaxed);
        });
        if(!secondCpuTaskAdmission.has_value() || !secondCpuTaskAdmission.value().valid()){
            childRejected.store(true, MemoryOrder::release);
        }
    });
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    const CpuTaskHandle parent = cpuTaskAdmission.value();
    EXPECT_TRUE(WaitUntil(parentGate.entered, s_GateTimeoutMS));
    const auto continuationTaskAdmission = scheduler.submit(lambda[mut continuationInvocations]() -> void{
        continuationInvocations.fetch_add(1u, MemoryOrder::relaxed);
    }, parent);
    ASSERT_TRUE(continuationTaskAdmission.has_value());
    const CpuTaskHandle continuation = continuationTaskAdmission.value();
    scope.cancel();
    parentGate.open();
    scheduler.wait(continuation);
    scope.wait();
    const auto stats = scheduler.statistics();
    EXPECT_FALSE(parentGate.expired.load(MemoryOrder::acquire));
    EXPECT_EQ(childInvocations.load(MemoryOrder::acquire), 0u);
    EXPECT_EQ(continuationInvocations.load(MemoryOrder::acquire), 0u);
    EXPECT_GE(stats.canceledTasks, 2u);
    EXPECT_EQ(stats.outstandingTasks, 0u);
}

void VerifyCpuTaskSchedulerTests_HeavyWorkUsesTheOtherClassWhileItsPreferredWorkerIsOccupied(){
    const u32 requestedWorkers = 2u;
    DeadlineGuard deadline(false, s_TestTimeoutMS);
    TaskGate preferredGate = TaskGate();
    TaskGate spillGate = TaskGate();
    CpuTaskScheduler scheduler(requestedWorkers);
    ScopeExit releaseWorkers(lambda[mut preferredGate, mut spillGate]() -> void{
        preferredGate.open();
        spillGate.open();
    });
    const auto workers = scheduler.statistics();
    if(workers.performanceWorkers == 0u || workers.efficiencyWorkers == 0u){
        GTEST_SKIP();
        return;
    }
    CpuAffinityEnum preferredAffinity = CpuAffinity::Any;
    CpuAffinityEnum spillAffinity = CpuAffinity::Any;
    const auto cpuTaskAdmission = scheduler.submit(lambda[mut scheduler, mut preferredAffinity, mut preferredGate]() -> void{
        preferredAffinity = scheduler.currentWorkerAffinity();
        preferredGate.block();
    });
    EXPECT_TRUE(cpuTaskAdmission.has_value());
    if(cpuTaskAdmission.has_value()){
        EXPECT_TRUE(cpuTaskAdmission.value().valid());
    }
    const b8 preferredEntered = WaitUntil(preferredGate.entered, s_GateTimeoutMS);
    const auto secondCpuTaskAdmission = scheduler.submit(lambda[mut scheduler, mut spillAffinity, mut spillGate]() -> void{
        spillAffinity = scheduler.currentWorkerAffinity();
        spillGate.block();
    });
    EXPECT_TRUE(secondCpuTaskAdmission.has_value());
    if(secondCpuTaskAdmission.has_value()){
        EXPECT_TRUE(secondCpuTaskAdmission.value().valid());
    }
    const b8 spillEntered = WaitUntil(spillGate.entered, s_GateTimeoutMS);
    preferredGate.open();
    spillGate.open();
    scheduler.wait();
    const auto finalStats = scheduler.statistics();
    EXPECT_TRUE(preferredEntered);
    EXPECT_TRUE(spillEntered);
    EXPECT_FALSE(preferredGate.expired.load(MemoryOrder::acquire));
    EXPECT_FALSE(spillGate.expired.load(MemoryOrder::acquire));
    EXPECT_EQ(preferredAffinity, CpuAffinity::Performance);
    EXPECT_EQ(spillAffinity, CpuAffinity::Efficiency);
    EXPECT_GT(finalStats.performanceTasks, 0u);
    EXPECT_GT(finalStats.efficiencyTasks, 0u);
}

void VerifyCpuTaskSchedulerTests_CanceledScopeSkipsBothDirectParallelRangeOverloads(){
    u32 invocations = 0u;
    DeadlineGuard deadline(false, s_TestTimeoutMS);
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope scope(scheduler);
    scope.cancel();
    const auto firstRange = scope.parallelFor(0u, 17u, lambda[mut invocations](in usize index) -> void{
        ++invocations;
    });
    EXPECT_TRUE(firstRange.has_value());
    const auto secondRange = scope.parallelFor(4u, 25u, 3u, lambda[mut invocations](in usize index) -> void{
        ++invocations;
    });
    EXPECT_TRUE(secondRange.has_value());
    scope.wait();
    EXPECT_EQ(invocations, 0u);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}


