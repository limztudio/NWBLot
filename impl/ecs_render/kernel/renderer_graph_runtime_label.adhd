#include <impl/ecs_render/kernel/task_timing_telemetry_labels.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererGraphRuntimeLabel{
    public b8 append(
        in GpuTaskGraphRuntimeStatistics deferredRuntimeStatistics,
        in GpuPhysicalQueueTopology runtimeQueueTopology,
        in Span<FrameGraphPhysicalQueueRuntimeStatistics> physicalQueueRuntimeStatistics,
        in GpuCompiledGraphReadView deferredCompiledPlan,
        in GpuRecordedGraph recordedGraph,
        mut Device device,
        mut String label
    )const{
        if(deferredRuntimeStatistics.valid()){
            AppendGraphSummaryTelemetry(
                deferredRuntimeStatistics.compile,
                deferredRuntimeStatistics.recording,
                deferredRuntimeStatistics.submission,
                label
            );

            const Span<GpuPhysicalQueueInfo> runtimeQueues = runtimeQueueTopology.queueSpan();
            for(usize queueIndex = 0u; queueIndex < physicalQueueRuntimeStatistics.size(); ++queueIndex){
                if(!AppendPhysicalQueueRuntimeTelemetryEntry(
                    runtimeQueues[queueIndex],
                    physicalQueueRuntimeStatistics[queueIndex],
                    physicalQueueRuntimeStatistics[queueIndex].submission,
                    physicalQueueRuntimeStatistics[queueIndex].compile,
                    physicalQueueRuntimeStatistics[queueIndex].recording,
                    deferredCompiledPlan,
                    recordedGraph,
                    device,
                    label
                ))
                    return false;
            }

            const Span<GpuCompiledOwnershipTransfer> logicalOwnershipTransfers = deferredCompiledPlan.logicalOwnershipTransferSpan();
            for(usize transferIndex = 0u; transferIndex < logicalOwnershipTransfers.size(); ++transferIndex)
                AppendLogicalOwnershipTransferTelemetryEntry(transferIndex, logicalOwnershipTransfers[transferIndex], label);
        }
        else
            label += s_RendererFrameTitle;
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

