b8 UiListSmokeScene::paint(mut UiPaintContext context){
    ObserveSmokeDisplay(s_UiListSmokeTag, context.display, this.m_lastDisplay, this.m_displayChanged);
    this.m_source.beginFrame();
    this.m_focused = false;
    context.ui.style().fontSize = 12.0f;
    context.ui.style().gap = 8.0f;
    context.ui.listStyle().padding = MakeUniformSmokeInsets(8.0f);
    if(!context.ui.beginPanel("list_fixture", Rect(24.0f, 24.0f, 400.0f, 340.0f)))
        return false;
    const WidgetOptions title = MakeFixedHeightSmokeWidget(24.0f);
    if(!context.ui.label("title", "100000 keyed rows: row5 disabled", title))
        return false;
    if(this.m_visible){
        ListOptions options();
        options.height.policy = LayoutSizePolicy::Fixed;
        options.height.value = 240.0f;
        const ListResult result = context.ui.virtualList("rows", this.m_source, this.m_state, options);
        if(!result.valid)
            return false;
        this.m_focused = result.focused;
        if(result.activated)
            ++this.m_commits;
    }
    else{
        const WidgetOptions spacer = MakeFixedHeightSmokeWidget(240.0f);
        if(!context.ui.label("omitted_rows", "Rows omitted", spacer))
            return false;
    }
    const WidgetOptions counter = MakeFixedSmokeWidget(140.0f, 36.0f);
    if(context.ui.button("underlying", "Outside counter", counter))
        ++this.m_underlying;
    if(!context.ui.endPanel())
        return false;
    this.observeState();
    const Array<u64, 12u> markerValues = this.values();
    PaintKeyedSmokeValueMarkersDefault(markerValues, cast<u64>(this.m_sequence), 20u, 14u, context);
    return true;
}

b8 UiListSmokeScene::keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods){
    if(key != s_SmokeKeyF5 && key != s_SmokeKeyF6 && key != s_SmokeKeyF7)
        return false;
    if(action == s_SmokeActionPress){
        if(key == s_SmokeKeyF5)
            this.m_source.reverse();
        else if(key == s_SmokeKeyF6)
            this.m_source.remove(this.m_state.selectedKey());
        else
            this.m_visible = !this.m_visible;
    }
    return true;
}

Array<u64, 12u> UiListSmokeScene::values()const{
    const ScrollPlacement placement = this.m_state.placement();
    Array<u64, 12u> out;
    out[0u] = this.m_state.selectedKey();
    out[1u] = this.m_state.cursorKey();
    out[2u] = this.m_source.rowCount();
    out[3u] = placement.firstRow;
    out[4u] = placement.endRow;
    out[5u] = cast<u64>(this.m_source.labelReads());
    out[6u] = cast<u64>(this.m_focused);
    out[7u] = cast<u64>(this.m_source.reversed());
    out[8u] = this.m_source.removedKey();
    out[9u] = cast<u64>(this.m_visible);
    out[10u] = cast<u64>(this.m_commits);
    out[11u] = cast<u64>(this.m_underlying);
    return out;
}

Rect UiListSmokeScene::selectedRow()const{
    const ScrollPlacement placement = this.m_state.placement();
    if(!this.m_visible)
        return Rect();
    const Expected<u64> index = this.m_source.indexOf(this.m_state.selectedKey());
    if(!index.has_value() || index.value() < placement.firstRow || index.value() >= placement.endRow)
        return Rect();
    const Expected<Rect> rectangle = SmokeListRowBounds(placement, index.value());
    if(!rectangle.has_value())
        return Rect();
    return rectangle.value();
}

void UiListSmokeScene::observeState(){
    const Array<u64, 12u> current = this.values();
    const ScrollPlacement placement = this.m_state.placement();
    if(
        this.m_sequence != 0u
        && !this.m_displayChanged
        && SameSmokeU64Span(current, this.m_lastValues)
        && placement.offset == this.m_lastPlacement.offset
        && placement.contentHeight == this.m_lastPlacement.contentHeight
        && SameSmokeRect(placement.bounds, this.m_lastPlacement.bounds)
        && SameSmokeRect(placement.thumb, this.m_lastPlacement.thumb)
    )
        return;
    ++this.m_sequence;
    this.m_lastValues = current;
    this.m_lastPlacement = placement;
    this.m_displayChanged = false;
    [essential] info(
        "UiListSmoke: state sequence={} values={},{},{},{},{},{},{},{},{},{},{},{}"
        , this.m_sequence
        , current[0u]
        , current[1u]
        , current[2u]
        , current[3u]
        , current[4u]
        , current[5u]
        , current[6u]
        , current[7u]
        , current[8u]
        , current[9u]
        , current[10u]
        , current[11u]
    );
    LogSmokeRect(s_UiListSmokeTag, this.m_sequence, "list", placement.bounds);
    LogSmokeRect(s_UiListSmokeTag, this.m_sequence, "viewport", placement.viewport);
    const Expected<Rect> first = SmokeListRowBounds(placement, placement.firstRow);
    Rect firstRect();
    if(first.has_value())
        firstRect = first.value();
    LogSmokeRect(s_UiListSmokeTag, this.m_sequence, "first_row", firstRect);
    LogSmokeRect(s_UiListSmokeTag, this.m_sequence, "track", placement.track);
    LogSmokeRect(s_UiListSmokeTag, this.m_sequence, "thumb", placement.thumb);
    LogSmokeRect(s_UiListSmokeTag, this.m_sequence, "selected_row", this.selectedRow());
    LogSmokeRect(s_UiListSmokeTag, this.m_sequence, "counter", Rect(32.0f, 312.0f, 140.0f, 36.0f));
}


