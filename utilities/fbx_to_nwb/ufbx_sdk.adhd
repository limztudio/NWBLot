[cpp_header("<ufbx.h>"), cpp_name("::ufbx_vec2"), cpp_flags(binary_serializable, brace_init)]
extern class UfbxVec2{
    f64 x;
    f64 y;
};

[cpp_header("<ufbx.h>"), cpp_name("::ufbx_vec3"), cpp_flags(binary_serializable, brace_init)]
extern class UfbxVec3{
    f64 x;
    f64 y;
    f64 z;
};

[cpp_header("<ufbx.h>"), cpp_name("::ufbx_vec4"), cpp_flags(binary_serializable, brace_init)]
extern class UfbxVec4{
    f64 x;
    f64 y;
    f64 z;
    f64 w;
};

[cpp_header("<ufbx.h>"), cpp_name("::ufbx_matrix"), cpp_flags(binary_serializable, brace_init)]
extern class UfbxMatrix{
    f64 m00;
    f64 m01;
    f64 m02;
    f64 m03;
    f64 m10;
    f64 m11;
    f64 m12;
    f64 m13;
    f64 m20;
    f64 m21;
    f64 m22;
    f64 m23;
};

[cpp_header("<ufbx.h>"), cpp_name("::ufbx_face"), cpp_flags(binary_serializable, brace_init)]
extern class UfbxFace{
    u32 num_indices;
};

[cpp_header("<ufbx.h>"), cpp_name("::ufbx_skin_vertex"), cpp_flags(binary_serializable, brace_init)]
extern class UfbxSkinVertex{
    u32 weight_begin;
    u32 num_weights;
};

[cpp_header("<ufbx.h>"), cpp_name("::ufbx_skin_weight"), cpp_flags(binary_serializable, brace_init)]
extern class UfbxSkinWeight{
    u32 cluster_index;
    f64 weight;
};

[cpp_header("<utilities/fbx_to_nwb/ufbx_sdk.h>"), cpp_name("::NWB::FbxToNwb::Ufbx::Node"), cpp_flags(small_value, brace_init)]
extern class UfbxNode{
    b8 valid()const;
    usize identity()const;
    StringView name()const;
    UfbxNode parent()const;
    b8 visible()const;
    in UfbxMatrix geometryToWorld()const;
};

[cpp_header("<utilities/fbx_to_nwb/ufbx_sdk.h>"), cpp_name("::NWB::FbxToNwb::Ufbx::Cluster"), cpp_flags(small_value, brace_init)]
extern class UfbxCluster{
    b8 valid()const;
    UfbxNode bone()const;
    in UfbxMatrix geometryToBone()const;
};

[cpp_header("<utilities/fbx_to_nwb/ufbx_sdk.h>"), cpp_name("::NWB::FbxToNwb::Ufbx::Skin"), cpp_flags(small_value, brace_init)]
extern class UfbxSkin{
    b8 valid()const;
    usize clusterCount()const;
    usize vertexCount()const;
    usize weightCount()const;
    UfbxCluster cluster(in usize index)const;
    UfbxSkinVertex vertex(in usize index)const;
    UfbxSkinWeight weight(in usize index)const;
};

[cpp_header("<utilities/fbx_to_nwb/ufbx_sdk.h>"), cpp_name("::NWB::FbxToNwb::Ufbx::Mesh"), cpp_flags(small_value, brace_init)]
extern class UfbxMesh{
    b8 valid()const;
    StringView name()const;
    usize triangleCount()const;
    usize maxFaceTriangles()const;
    usize cornerCount()const;
    usize faceCount()const;
    usize vertexCount()const;
    usize skinCount()const;
    UfbxSkin skin(in usize index)const;
    u32 vertexIndex(in usize corner)const;
    UfbxFace face(in usize index)const;
    u32 triangulate(mut Span<u32> indices, in UfbxFace face)const;
    b8 skinnedIsLocal()const;
    b8 hasPosition()const;
    UfbxVec3 position(in u32 corner)const;
    UfbxVec3 skinnedPosition(in u32 corner)const;
    b8 hasNormal()const;
    UfbxVec3 normal(in u32 corner)const;
    UfbxVec3 skinnedNormal(in u32 corner)const;
    b8 hasTangent()const;
    UfbxVec3 tangent(in u32 corner)const;
    b8 hasBitangent()const;
    UfbxVec3 bitangent(in u32 corner)const;
    b8 hasUv()const;
    UfbxVec2 uv(in u32 corner)const;
    b8 hasColor()const;
    UfbxVec4 color(in u32 corner)const;
};

[cpp_header("<ufbx.h>"), cpp_name("::ufbx_coordinate_axes"), cpp_flags(binary_serializable, brace_init)]
extern class UfbxAxes{
    UfbxAxis right;
    UfbxAxis up;
    UfbxAxis front;
};

[cpp_header("<ufbx.h>"), cpp_name("::ufbx_error"), cpp_flags(binary_serializable, brace_init)]
extern class UfbxError{
};

[cpp_header("<ufbx.h>"), cpp_name("::ufbx_load_opts"), cpp_flags(binary_serializable, brace_init)]
extern class UfbxLoadOptions{
    b8 load_external_files;
    b8 ignore_missing_external_files;
    b8 generate_missing_normals;
    b8 normalize_normals;
    b8 clean_skin_weights;
    b8 evaluate_skinning;
    b8 evaluate_caches;
    UfbxGeometryTransformHandling geometry_transform_handling;
    UfbxAxes target_axes;
    f64 target_unit_meters;
};

[cpp_header("<ufbx.h>"), cpp_name("::ufbx_coordinate_axis")]
extern enum UfbxAxis : u32{
    UFBX_COORDINATE_AXIS_POSITIVE_X,
    UFBX_COORDINATE_AXIS_POSITIVE_Y,
    UFBX_COORDINATE_AXIS_POSITIVE_Z,
};

[cpp_header("<ufbx.h>"), cpp_name("::ufbx_geometry_transform_handling")]
extern enum UfbxGeometryTransformHandling : u32{
    UFBX_GEOMETRY_TRANSFORM_HANDLING_PRESERVE,
};

[cpp_header("<utilities/fbx_to_nwb/ufbx_sdk.h>"), cpp_name("::NWB::FbxToNwb::Ufbx::Document")]
extern class UfbxDocument{
    b8 load(in StringView path, in UfbxLoadOptions options, mut UfbxError error);
    usize nodeCount()const;
    UfbxNode node(in usize index)const;
};

[cpp_header("<utilities/fbx_to_nwb/ufbx_sdk.h>"), cpp_name("::NWB::FbxToNwb::Ufbx::NodeMesh")]
extern UfbxMesh UfbxNodeMesh(in UfbxNode node);

[cpp_header("<utilities/fbx_to_nwb/ufbx_sdk.h>"), cpp_name("::NWB::FbxToNwb::Ufbx::FormatError")]
extern void FormatUfbxError(in UfbxError error, mut Span<u8> buffer, mut String text);

[cpp_header("<utilities/fbx_to_nwb/ufbx_sdk.h>"), cpp_name("::NWB::FbxToNwb::Ufbx::Invert")]
extern UfbxMatrix InvertUfbxMatrix(in UfbxMatrix matrix);

[cpp_header("<utilities/fbx_to_nwb/ufbx_sdk.h>"), cpp_name("::NWB::FbxToNwb::Ufbx::Multiply")]
extern UfbxMatrix MultiplyUfbxMatrices(in UfbxMatrix a, in UfbxMatrix b);

[cpp_header("<utilities/fbx_to_nwb/ufbx_sdk.h>"), cpp_name("::NWB::FbxToNwb::Ufbx::ForNormals")]
extern UfbxMatrix UfbxNormalMatrix(in UfbxMatrix matrix);

[cpp_header("<utilities/fbx_to_nwb/ufbx_sdk.h>"), cpp_name("::NWB::FbxToNwb::Ufbx::Determinant")]
extern f64 UfbxDeterminant(in UfbxMatrix matrix);

[cpp_header("<utilities/fbx_to_nwb/ufbx_sdk.h>"), cpp_name("::NWB::FbxToNwb::Ufbx::TransformPosition")]
extern UfbxVec3 UfbxTransformPosition(in UfbxMatrix matrix, in UfbxVec3 x);

[cpp_header("<utilities/fbx_to_nwb/ufbx_sdk.h>"), cpp_name("::NWB::FbxToNwb::Ufbx::TransformDirection")]
extern UfbxVec3 UfbxTransformDirection(in UfbxMatrix matrix, in UfbxVec3 x);


