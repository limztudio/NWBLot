////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "radio_group_style.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ResolveRadioGroupGridCounts(in u32 count, in RadioGroupOrientation orientation, in u32 columns, mut u32 outCols, mut u32 outRows){
    if(count == 0u){
        if(orientation == RadioGroupOrientation::Grid)
            outCols = columns;
        else
            outCols = 1u;
        outRows = 0u;
        return;
    }
    if(orientation == RadioGroupOrientation::Horizontal){
        outCols = count;
        outRows = 1u;
        return;
    }
    if(orientation == RadioGroupOrientation::Grid){
        outCols = columns;
        outRows = (count - 1u) / columns + 1u;
        return;
    }
    outCols = 1u;
    outRows = count;
}

b8 IsValidRadioGroupMetrics(in RadioGroupMetrics metrics){
    if(
        metrics.orientation >= RadioGroupOrientation::kCount
        || metrics.columns < 1u
        || !IsValidUiPadding(metrics.padding)
        || !IsFinite(VectorSingle(metrics.rowHeight, metrics.indicatorExtent, metrics.gap, metrics.rowGap))
        || !IsFinite(VectorSingle(metrics.columnGap, metrics.cellWidth, metrics.markInset, 0.0f))
        || metrics.rowHeight <= 0.0f
        || metrics.indicatorExtent <= 0.0f
        || metrics.indicatorExtent > metrics.rowHeight
        || metrics.gap < 0.0f
        || metrics.rowGap < 0.0f
        || metrics.columnGap < 0.0f
        || metrics.cellWidth < 0.0f
        || !IsValidUiExtent(metrics.contentSize)
        || metrics.markInset < 0.0f || cast<f64>(metrics.markInset) > s_RadioGroupMaxMarkInsetF64
    )
        return false;
    u32 expectedCols = 1u;
    u32 expectedRows = 0u;
    ResolveRadioGroupGridCounts(metrics.count, metrics.orientation, metrics.columns, expectedCols, expectedRows);
    if(metrics.columns != expectedCols || metrics.rowCount != expectedRows)
        return false;
    const VectorDouble paddingSize = VectorDouble(cast<f64>(metrics.padding.left), cast<f64>(metrics.padding.top), cast<f64>(metrics.padding.left), cast<f64>(metrics.padding.top)) + VectorDouble(cast<f64>(metrics.padding.right), cast<f64>(metrics.padding.bottom), cast<f64>(metrics.padding.right), cast<f64>(metrics.padding.bottom));
    u32 rowGapCount = 0u;
    if(expectedRows > 0u)
        rowGapCount = expectedRows - 1u;
    u32 colGapCount = 0u;
    if(expectedCols > 0u)
        colGapCount = expectedCols - 1u;
    const f64 rowsH = cast<f64>(expectedRows) * cast<f64>(metrics.rowHeight) + cast<f64>(rowGapCount) * cast<f64>(metrics.rowGap);
    f64 gridMinW = 0.0;
    if(metrics.count != 0u){
        const f64 minCellW = cast<f64>(metrics.indicatorExtent) + cast<f64>(metrics.gap);
        if(cast<f64>(metrics.cellWidth) < cast<f64>(cast<f32>(minCellW)))
            return false;
        gridMinW = cast<f64>(expectedCols) * minCellW + cast<f64>(colGapCount) * cast<f64>(metrics.columnGap);
    }
    const VectorDouble size = paddingSize + VectorDouble(gridMinW, rowsH, gridMinW, rowsH);
    const f64 minimumWidth = size.x;
    const f64 height = size.y;
    return height <= s_UiMaxFloatF64
        && cast<f64>(metrics.contentSize.y) == cast<f64>(cast<f32>(height))
        && minimumWidth <= s_UiMaxFloatF64
        && cast<f64>(metrics.contentSize.x) >= cast<f64>(cast<f32>(minimumWidth));
}

Expected<RadioGroupMetrics> MeasureRadioGroup(in u32 count, in Point maximumLabel, in RadioGroupOptions options, in RadioGroupStyle style){
    if(
        options.orientation >= RadioGroupOrientation::kCount
        || options.columns < 1u
        || !IsValidUiExtent(maximumLabel)
        || !IsValidUiPadding(style.padding)
        || !IsValidLayoutSize(options.width)
        || !IsFinite(VectorSingle(style.indicatorExtent, style.gap, style.rowGap, style.columnGap))
        || !IsFinite(VectorSingle(style.markInset))
        || style.indicatorExtent <= 0.0f
        || style.gap < 0.0f
        || style.rowGap < 0.0f
        || style.columnGap < 0.0f
        || style.markInset < 0.0f || style.markInset > s_RadioGroupMaxMarkInset
        || !IsValidUiColor(style.hoverTint) || !IsValidUiColor(style.pressedTint) || !IsValidUiColor(style.disabledTint)
    )
        return MakeUnexpected(Failure());
    u32 cols = 1u;
    u32 rows = 0u;
    ResolveRadioGroupGridCounts(count, options.orientation, options.columns, cols, rows);
    RadioGroupMetrics candidate;
    candidate.orientation = options.orientation;
    candidate.rowHeight = Max(maximumLabel.y, style.indicatorExtent);
    candidate.indicatorExtent = style.indicatorExtent;
    candidate.gap = style.gap;
    candidate.rowGap = style.rowGap;
    candidate.columnGap = style.columnGap;
    candidate.markInset = style.markInset;
    candidate.padding = style.padding;
    candidate.count = count;
    candidate.columns = cols;
    candidate.rowCount = rows;
    const VectorDouble paddingSize = VectorDouble(cast<f64>(style.padding.left), cast<f64>(style.padding.top), cast<f64>(style.padding.left), cast<f64>(style.padding.top)) + VectorDouble(cast<f64>(style.padding.right), cast<f64>(style.padding.bottom), cast<f64>(style.padding.right), cast<f64>(style.padding.bottom));
    u32 rowGapCount = 0u;
    if(rows > 0u)
        rowGapCount = rows - 1u;
    u32 colGapCount = 0u;
    if(cols > 0u)
        colGapCount = cols - 1u;
    const f64 rowsH = cast<f64>(rows) * cast<f64>(candidate.rowHeight) + cast<f64>(rowGapCount) * cast<f64>(style.rowGap);
    f64 gridW = 0.0;
    if(count != 0u){
        const f64 cellW = (cast<f64>(style.indicatorExtent) + cast<f64>(style.gap)) + cast<f64>(maximumLabel.x);
        if(!IsFinite(VectorDouble(cellW)) || cellW > s_UiMaxFloatF64)
            return MakeUnexpected(Failure());
        candidate.cellWidth = cast<f32>(cellW);
        gridW = cast<f64>(cols) * cellW + cast<f64>(colGapCount) * cast<f64>(style.columnGap);
    }
    const VectorDouble size = paddingSize + VectorDouble(gridW, rowsH, gridW, rowsH);
    const f64 width = size.x;
    const f64 height = size.y;
    if(!IsFinite(size.xy) || width > s_UiMaxFloatF64 || height > s_UiMaxFloatF64)
        return MakeUnexpected(Failure());
    candidate.contentSize = Point(cast<f32>(width), cast<f32>(height));
    if(!IsValidRadioGroupMetrics(candidate))
        return MakeUnexpected(Failure());
    return candidate;
}

b8 IsUniqueRadioGroupChoiceKey(in RadioGroupChoices choices, in u32 index, in u64 key){
    if(key == 0u)
        return false;
    for(u32 previous = 0u; previous < index; ++previous){
        if(choices.rows[previous].key == key)
            return false;
    }
    return true;
}

b8 IsRadioGroupInteractive(in RadioGroupChoices choices, in RadioGroupOptions options){
    if(!options.enabled)
        return false;
    for(u32 index = 0u; index < choices.count; ++index){
        if(choices.rows[index].enabled)
            return true;
    }
    return false;
}


