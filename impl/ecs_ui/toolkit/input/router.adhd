#include <impl/ecs_ui/toolkit/id.adhd>
#include <impl/ecs_ui/toolkit/input/admission.adhd>
#include <impl/ecs_ui/toolkit/input/command_state.adhd>
#include <impl/ecs_ui/toolkit/input/hover_state.adhd>
#include <impl/ecs_ui/toolkit/input/input.adhd>
#include <impl/ecs_ui/toolkit/input/pointer_state.adhd>
#include <impl/ecs_ui/toolkit/input/popup_state.adhd>
#include <impl/ecs_ui/toolkit/input/router_pointer_source_admission.adhd>
#include <impl/ecs_ui/toolkit/input/target_table.adhd>
#include <impl/ecs_ui/toolkit/layout/validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type InputVector<T> = Vector<T>;

b8 IsCommandInputEventType(in InputEventType type){
    return type == InputEventType::CommandDown || type == InputEventType::CommandUp;
}

void ApplyRouterFocusLostEvent(
    in b8 hasActivePopup,
    in WidgetId capture,
    in b8 primaryConsumed,
    in b8 secondaryConsumed,
    in b8 wantsCommands,
    mut u64 inOutFocusLossGeneration,
    mut b8 outWindowFocused,
    mut InputRoutingResult inOutResult
){
    AdvanceNonWrappingRevision(inOutFocusLossGeneration);
    outWindowFocused = false;
    if(hasActivePopup || capture.valid() || primaryConsumed || secondaryConsumed)
        inOutResult.pointerConsumed = true;
    if(wantsCommands)
        inOutResult.commandConsumed = true;
}

void FinalizeRouterProcessResult(
    in b8 wantsPointer,
    in b8 wantsCommands,
    in WidgetId hover,
    in WidgetId focus,
    in WidgetId capture,
    mut InputRoutingResult inOutResult
){
    inOutResult.wantsPointer = wantsPointer;
    inOutResult.wantsCommands = wantsCommands;
    inOutResult.hover = hover;
    inOutResult.focus = focus;
    inOutResult.capture = capture;
}

b8 MatchesInputDeviceSource(in InputSource source, in u64 device){
    return source.valid() && source.device == device;
}

b8 WouldConsumeIdlePointer(in b8 hasActivePopup, in WidgetId capture, in WidgetId hoveredTarget){
    return hasActivePopup || capture.valid() || hoveredTarget.valid();
}

InputSource MakeKeyboardInputSource(in i32 key){
    return InputSource(0u, cast<u64>(key) + 1u);
}

b8 CanCheckPointerSubmitPressedTarget(in b8 primaryDown, in b8 submitArmed, in WidgetId capture, in WidgetId targetId){
    return primaryDown && submitArmed && capture == targetId;
}

void AccumulateTerminatedPointerSourceResult(
    in b8 ownsActivate,
    in b8 ownsContextMenu,
    in InputSource activeSource,
    in InputSource eventSource,
    mut InputRoutingResult inOutResult
){
    if(ownsActivate || ownsContextMenu)
        inOutResult.pointerConsumed = true;
    if(activeSource == eventSource)
        inOutResult.pointerRouted = true;
}

b8 IsSecondaryButtonInputEventType(in InputEventType type){
    return type == InputEventType::SecondaryDown || type == InputEventType::SecondaryUp;
}

b8 IsPointerButtonReleaseEventType(in InputEventType type){
    return type == InputEventType::PrimaryUp || type == InputEventType::SecondaryUp;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class InputRouter : NoCopy{
    private InputAdmission m_admission;
    private InputCommandState m_commandSources;
    private InputPointerState m_pointerState;
    private InputTargetTable m_targetTable;
    private InputVector<InputAction> m_actions;
    private InputVector<ControlAction> m_controlActions;
    private InputVector<ContextMenuAction> m_contextMenuActions;
    private InputPopupState m_popupState;
    private InputHoverState m_hoverState;
    private u64 m_focusLossGeneration = 0u;
    private u64 m_nextActionSequence = 1u;
    private b8 m_windowFocused = true;

    [cpp_unwind]
    public InputRouter(){
        this.m_commandSources.reserve();
        this.m_pointerState.reserveSources();
        this.m_actions.reserve(s_InputMaxActions);
        this.m_controlActions.reserve(s_InputMaxControlActions);
        this.m_contextMenuActions.reserve(s_InputMaxContextMenuActions);
        this.m_pointerState.reserveGestures();
    }
    [cpp_unwind]
    public Expected<InputEvent> queue(in InputEvent event){ return this.m_admission.queue(event); }
    [cpp_unwind]
    public Expected<InputEvent> queuePointer(in PointerInput input){ return this.m_admission.queuePointer(input); }
    [cpp_unwind]
    public b8 setBindings(in Span<InputKeyBinding> bindings){ return this.m_admission.setBindings(bindings); }
    [cpp_unwind]
    public void restoreDefaultBindings(){ this.m_admission.restoreDefaultBindings(); }
    public in InputBindings bindings()const{ return this.m_admission.bindings(); }
    [cpp_unwind]
    public InputRoutingResult process(){
        InputRoutingResult result;
        for(in InputEvent event : this.m_admission.events()){
            if(IsPointerInputEventType(event.type))
                this.routePointerSource(event, result);
            else if(IsCommandInputEventType(event.type))
                this.routeCommand(event, result);
            else if(event.type == InputEventType::FocusLost){
                ApplyRouterFocusLostEvent(
                    this.hasPopup(),
                    this.m_pointerState.capture(),
                    this.m_pointerState.primaryConsumed(),
                    this.m_pointerState.secondaryConsumed(),
                    this.wantsCommands(),
                    this.m_focusLossGeneration,
                    this.m_windowFocused,
                    result
                );
                this.m_popupState.cancelFocus();
                this.cancelInteraction();
            }
            else if(event.type == InputEventType::FocusGained)
                this.m_windowFocused = true;
        }
        this.m_admission.clear();
        FinalizeRouterProcessResult(
            this.wantsPointer(),
            this.wantsCommands(),
            this.m_hoverState.target,
            this.m_commandSources.focus(),
            this.m_pointerState.capture(),
            result
        );
        return result;
    }
    [cpp_unwind]
    public b8 commitTargets(in Span<HitTarget> targets, in u64 layoutGeneration){
        return this.commitTargets(targets, layoutGeneration, Span<PopupScope>(), u64.max);
    }
    [cpp_unwind]
    public b8 commitTargets(in Span<HitTarget> targets, in u64 layoutGeneration, in Span<PopupScope> popups){
        return this.commitTargets(targets, layoutGeneration, popups, u64.max);
    }
    [cpp_unwind]
    public b8 commitTargets(in Span<HitTarget> targets, in u64 layoutGeneration, in Span<PopupScope> popups, in u64 expectedFocusLossGeneration){
        if(!this.m_targetTable.canPublish(targets.size(), layoutGeneration))
            return false;
        if(!this.stagePopups(popups) || !this.m_targetTable.publish(targets, this.m_popupState.staged(), layoutGeneration))
            return false;
        this.installPopups(expectedFocusLossGeneration);
        this.reconcileTargets();
        ApplyRouterFocusOnCommit(
            this.m_targetTable.targets(),
            this.m_targetTable.lookup(),
            this.m_popupState.records(),
            this.m_windowFocused,
            this.m_focusLossGeneration,
            expectedFocusLossGeneration,
            this.m_commandSources.focus(),
            this.m_commandSources.declaration(),
            this.m_commandSources.control()
        );
        return true;
    }
    public Expected<PopupDismissReason> consumePopupDismissal(in PopupToken token){
        return this.m_popupState.consumeDismissal(token);
    }
    [cpp_unwind]
    public b8 dismissPopup(in PopupDismissReason reason){
        if(!this.m_popupState.dismiss(reason))
            return false;
        this.reconcileTargets();
        return true;
    }
    public void closePopup(in PopupToken token){
        this.m_popupState.close(token);
        this.reconcileTargets();
    }
    public void fencePopup(in PopupToken token){
        this.m_popupState.fence(token);
        this.reconcileTargets();
    }
    public b8 hasPopup()const{ return !this.m_popupState.records().empty(); }
    public usize popupCount()const{ return this.m_popupState.records().size(); }
    public Optional<in PopupScope> popupScope(in PopupToken token)const{
        const Expected<usize> scopeIndex = FindRouterPopupScopeIndex(this.m_popupState.records(), token);
        if(!scopeIndex.has_value())
            return Optional<in PopupScope>();
        return Optional<in PopupScope>(this.m_popupState.records()[scopeIndex.value()].scope);
    }
    public Optional<in HitTarget> findTarget(in WidgetId id)const{ return this.findTarget(id, 0u); }
    public Optional<in HitTarget> findTarget(in WidgetId id, in u64 declarationGeneration)const{
        const Expected<usize> index = this.m_targetTable.findIndex(id, declarationGeneration);
        if(!index.has_value())
            return Optional<in HitTarget>();
        return Optional<in HitTarget>(this.m_targetTable.targets()[index.value()]);
    }
    public Expected<HitTarget> tryFindTarget(in WidgetId id)const{ return this.tryFindTarget(id, 0u); }
    public Expected<HitTarget> tryFindTarget(in WidgetId id, in u64 declarationGeneration)const{
        const Optional<in HitTarget> target = this.findTarget(id, declarationGeneration);
        if(target.has_value())
            return target.value();
        return MakeUnexpected(Failure());
    }
    public PopupToken topPopupToken()const{
        if(this.m_popupState.records().empty())
            return PopupToken();
        return this.m_popupState.records().back().scope.token;
    }
    public u64 focusLossGeneration()const{ return this.m_focusLossGeneration; }
    [cpp_unwind]
    public void invalidateTarget(in WidgetId id){
        this.retirePopup(id);
        if(!this.m_targetTable.invalidate(id))
            return;
        this.reconcileTargets();
    }
    [cpp_unwind]
    public void invalidateTargets(in Span<WidgetId> ids){
        if(ids.empty())
            return;
        if(ids.size() == 1u){
            this.invalidateTarget(ids[0u]);
            return;
        }
        if(!this.m_popupState.records().empty()){
            for(usize index = ids.size(); index > 0u; --index){
                in WidgetId id = ids[index - 1u];
                b8 matchesPopup = false;
                for(in PopupRecord popup : this.m_popupState.records()){
                    if(popup.scope.token.widget == id){
                        matchesPopup = true;
                        break;
                    }
                }
                if(matchesPopup)
                    this.retirePopup(id);
                if(this.m_popupState.records().empty())
                    break;
            }
        }
        if(this.m_targetTable.invalidateBatch(ids))
            this.reconcileTargets();
    }
    public void clearFocus(){
        this.m_commandSources.clearFocus();
    }
    public void reset(){
        this.retireQueuedReleases();
        this.m_admission.clear();
        this.m_targetTable.reset();
        this.m_popupState.reset();
        this.cancelInteraction();
    }
    public void cancelDeviceInput(in u64 device){
        if(MatchesInputDeviceSource(this.m_pointerState.activeSource(), device))
            this.terminatePointerSource(this.m_pointerState.activeSource());
        this.m_admission.cancelDevice(device, this.m_pointerState.sources(), this.m_commandSources.records());
        if(MatchesInputDeviceSource(this.m_hoverState.source, device))
            this.m_hoverState.forgetSource();
    }
    public b8 consumeActivation(in WidgetId id){
        return TryConsumeRouterActivation(this.m_targetTable.targets(), this.m_targetTable.lookup(), this.m_popupState.records(), id, this.m_actions);
    }
    public Expected<ContextMenuAction> consumeContextMenu(in WidgetId id, in u64 declarationGeneration){
        return TryConsumeRouterContextMenu(this.m_targetTable.targets(), this.m_targetTable.lookup(), this.m_popupState.records(), this.m_windowFocused, id, declarationGeneration, this.m_contextMenuActions);
    }
    public Expected<ControlAction> consumeControlAction(in WidgetId host, in u64 declarationGeneration, in ControlToken token){
        return TryConsumeRouterControlAction(this.m_targetTable.targets(), this.m_targetTable.lookup(), this.m_popupState.records(), host, declarationGeneration, token, this.m_controlActions);
    }
    public void fenceControl(in WidgetId host, in u64 declarationGeneration, in ControlToken token){
        if(this.m_targetTable.fenceControl(host, declarationGeneration, token))
            this.reconcileTargets();
    }
    public Expected<PointerGesture> consumePointerGesture(in WidgetId id, in u64 declarationGeneration){
        return TryConsumeRouterPointerGesture(this.m_targetTable.targets(), this.m_targetTable.lookup(), this.m_popupState.records(), id, declarationGeneration, this.m_pointerState.gestures());
    }
    public WidgetId hitTest(in Point position)const{
        const Optional<in HitTarget> target = this.findHitTarget(position);
        if(target.has_value())
            return target.value().id;
        return WidgetId();
    }
    public b8 wouldConsumePointer(in Point position)const{
        if(this.m_pointerState.primaryDown())
            return this.m_pointerState.primaryConsumed();
        if(this.m_pointerState.secondaryDown())
            return this.m_pointerState.secondaryConsumed();
        return WouldConsumeIdlePointer(this.hasPopup(), this.m_pointerState.capture(), this.hitTest(position));
    }
    public u64 layoutGeneration()const{ return this.m_targetTable.generation(); }
    public in Vector<HitTarget> targets()const{ return this.m_targetTable.targets(); }
    public in InputVector<InputAction> actions()const{ return this.m_actions; }
    public in InputVector<ControlAction> controlActions()const{ return this.m_controlActions; }
    public WidgetId hover()const{ return this.m_hoverState.target; }
    public u64 hoverActivityGeneration()const{ return this.m_hoverState.activityGeneration; }
    public WidgetId focus()const{ return this.m_commandSources.focus(); }
    public WidgetId capture()const{ return this.m_pointerState.capture(); }
    public InputSource activePointerSource()const{ return this.m_pointerState.activeSource(); }
    public b8 acceptsPointerSource(in InputSource source)const{
        return this.m_pointerState.accepts(source);
    }
    public b8 ownsPointerSource(in InputSource source)const{ return this.ownsPointerSource(source, PointerIntent::Activate); }
    public b8 ownsPointerSource(in InputSource source, in PointerIntent intent)const{
        return this.m_pointerState.owns(source, intent);
    }
    public b8 primaryDown()const{ return this.m_pointerState.primaryDown(); }
    public b8 secondaryDown()const{ return this.m_pointerState.secondaryDown(); }
    public b8 pointerKnown()const{ return this.m_hoverState.known; }
    public in Point pointerPosition()const{ return this.m_hoverState.position; }
    public b8 windowFocused()const{ return this.m_windowFocused; }
    public b8 wantsPointer()const{
        return this.m_pointerState.wants(this.hasPopup(), this.m_hoverState.target);
    }
    public b8 wantsCommands()const{
        return this.m_commandSources.wants(this.m_popupState.records());
    }
    public b8 ownsKey(in i32 key)const{
        return IsValidInputKeyCode(key) && this.ownsSource(MakeKeyboardInputSource(key));
    }
    public b8 ownsSource(in InputSource source)const{
        return this.m_commandSources.owns(source);
    }
    public b8 canEditCommand(in InputEvent event)const{
        return this.m_commandSources.canEdit(this.m_targetTable.targets(), this.m_targetTable.lookup(), this.m_popupState.records(), this.m_windowFocused, event);
    }
    public b8 canSubmitCommand(in InputEvent event)const{
        return this.m_commandSources.canSubmit(this.m_targetTable.targets(), this.m_targetTable.lookup(), this.m_popupState.records(), this.m_windowFocused, event);
    }
    public void cancelSubmitCommands(in WidgetId id){
        this.m_commandSources.cancelSubmit(id);
    }
    public b8 pressed(in WidgetId id)const{
        if(CanCheckPointerSubmitPressedTarget(this.m_pointerState.primaryDown(), this.m_pointerState.submitArmed(), this.m_pointerState.capture(), id) && this.hitTest(this.m_pointerState.interactionPosition()) == id)
            return true;
        return this.m_commandSources.isPressed(this.m_targetTable.targets(), this.m_targetTable.lookup(), this.m_popupState.records(), this.m_windowFocused, id);
    }
    private void retireQueuedReleases(){
        b8 unfinishedHoverSource = false;
        RetireRouterQueuedReleases(
            this.m_admission.events(),
            this.m_hoverState.source,
            this.m_commandSources.records(),
            this.m_pointerState.sources(),
            this.m_pointerState.gestures(),
            this.m_pointerState.gestureSequence(),
            this.m_pointerState.submitArmed(),
            this.m_pointerState.secondaryOwner(),
            this.m_pointerState.capture(),
            this.m_pointerState.capturePopup(),
            this.m_pointerState.captureDeclaration(),
            this.m_pointerState.captureControl(),
            this.m_pointerState.primaryDown(),
            this.m_pointerState.primaryConsumed(),
            this.m_pointerState.secondaryDown(),
            this.m_pointerState.secondaryConsumed(),
            this.m_pointerState.activeSource(),
            unfinishedHoverSource
        );
        if(unfinishedHoverSource)
            this.m_hoverState.forgetSource();
    }
    [cpp_unwind]
    private void routePointerSource(in InputEvent event, mut InputRoutingResult result){
        if(event.type == InputEventType::PointerCaptureLost){
            AccumulateTerminatedPointerSourceResult(
                this.ownsPointerSource(event.source, PointerIntent::Activate),
                this.ownsPointerSource(event.source, PointerIntent::ContextMenu),
                this.m_pointerState.activeSource(),
                event.source,
                result
            );
            this.terminatePointerSource(event.source);
            return;
        }
        if(event.type == InputEventType::PointerLeave){
            AccumulateTerminatedPointerSourceResult(
                this.ownsPointerSource(event.source, PointerIntent::Activate),
                this.ownsPointerSource(event.source, PointerIntent::ContextMenu),
                this.m_pointerState.activeSource(),
                event.source,
                result
            );
            if(this.m_hoverState.source == event.source)
                this.m_hoverState.forgetSource();
            return;
        }
        b8 hasHit = false;
        HitTarget hit;
        usize heldIndex = this.m_pointerState.sources().size();
        b8 advanceHover = false;
        this.m_targetTable.prepareSpatialIndex();
        const b8 shouldRoute = RouterPointerSourceAdmission().admitEvent(
            this.m_targetTable.targets(),
            this.m_targetTable.lookup(),
            this.m_popupState.records(),
            this.m_targetTable.spatialIndex(),
            event,
            this.m_pointerState.primaryDown(),
            this.m_pointerState.primaryConsumed(),
            this.m_pointerState.secondaryConsumed(),
            this.m_hoverState.position,
            this.m_hoverState.known,
            this.m_hoverState.source,
            this.m_hoverState.identity,
            this.m_hoverState.target,
            this.m_pointerState.sources(),
            this.m_pointerState.activeSource(),
            this.m_pointerState.interactionPosition(),
            result,
            hasHit,
            hit,
            heldIndex,
            advanceHover
        );
        if(advanceHover)
            this.m_hoverState.advanceActivity();
        if(!shouldRoute)
            return;
        if(IsSecondaryButtonInputEventType(event.type))
            this.routeSecondary(event, hasHit, hit, result);
        else if(event.type == InputEventType::PointerWheel)
            this.routeWheel(event, hasHit, hit, result);
        else
            this.routePointer(event, hasHit, hit, result);
        if(IsPointerButtonReleaseEventType(event.type))
            RouterPointerSourceAdmission().finishRelease(heldIndex, this.m_pointerState.primaryDown(), this.m_pointerState.secondaryDown(), this.m_pointerState.sources(), this.m_pointerState.activeSource());
    }
    private void terminatePointerSource(in InputSource source){
        b8 unfinishedHoverSource = false;
        TerminateRouterPointerSource(
            source,
            this.m_hoverState.source,
            this.m_pointerState.sources(),
            this.m_pointerState.gestures(),
            this.m_pointerState.gestureSequence(),
            this.m_pointerState.submitArmed(),
            this.m_pointerState.secondaryOwner(),
            this.m_pointerState.capture(),
            this.m_pointerState.capturePopup(),
            this.m_pointerState.captureDeclaration(),
            this.m_pointerState.captureControl(),
            this.m_pointerState.primaryDown(),
            this.m_pointerState.primaryConsumed(),
            this.m_pointerState.secondaryDown(),
            this.m_pointerState.secondaryConsumed(),
            this.m_pointerState.activeSource(),
            unfinishedHoverSource
        );
        if(unfinishedHoverSource)
            this.m_hoverState.forgetSource();
    }
    private Optional<in HitTarget> findHitTarget(in Point position)const{
        const Expected<usize> hitIndex = FindRouterHitTargetIndexIndexed(this.m_targetTable.targets(), this.m_targetTable.lookup(), this.m_popupState.records(), this.m_targetTable.spatialIndex(), position);
        if(!hitIndex.has_value())
            return Optional<in HitTarget>();
        return Optional<in HitTarget>(this.m_targetTable.targets()[hitIndex.value()]);
    }
    [cpp_unwind]
    private void routeSecondary(in InputEvent event, in b8 hasHit, in HitTarget hit, mut InputRoutingResult result){
        const InputPointerRouteEffects effects = this.m_pointerState.routeSecondary(event, hasHit, hit, this.m_targetTable, this.m_popupState, this.m_windowFocused, this.m_contextMenuActions, this.m_nextActionSequence, result);
        if(effects.dismissedPopup && !this.m_popupState.apply(effects.popupDismissal))
            TerminateInvariant();
        if(effects.advanceHover)
            this.m_hoverState.advanceActivity();
        if(effects.dismissedPopup){
            this.reconcileTargets();
            this.updateHover();
        }
    }
    [cpp_unwind]
    private void routeWheel(in InputEvent event, in b8 hasHit, in HitTarget hit, mut InputRoutingResult result){
        this.m_pointerState.routeWheel(event, hasHit, hit, this.m_targetTable, this.m_popupState, this.m_controlActions, this.m_nextActionSequence, result);
    }
    [cpp_unwind]
    private b8 stagePopups(in Span<PopupScope> scopes){
        return this.m_popupState.stage(scopes);
    }
    [cpp_unwind]
    private void installPopups(in u64 expectedFocusLossGeneration){
        this.m_popupState.install(
            this.m_targetTable.targets(),
            this.m_targetTable.lookup(),
            this.m_windowFocused,
            this.m_focusLossGeneration,
            expectedFocusLossGeneration,
            this.m_commandSources.records(),
            this.m_commandSources.focus(),
            this.m_commandSources.declaration(),
            this.m_commandSources.control()
        );
    }
    [cpp_unwind]
    private void retirePopup(in WidgetId id){
        const Optional<InputPopupRetirement> retirement = this.m_popupState.retire(this.m_targetTable, id);
        if(!retirement.has_value())
            return;
        RestoreRouterPopupFocus(retirement.value().top, retirement.value().restore, this.m_windowFocused, this.m_targetTable.targets(), this.m_targetTable.lookup(), this.m_popupState.records(),
            this.m_commandSources.records(), this.m_commandSources.focus(), this.m_commandSources.declaration(), this.m_commandSources.control());
        this.reconcileTargets();
    }
    private void reconcileTargets(){
        b8 changedHoverOwner = false;
        if(this.m_hoverState.known)
            this.m_targetTable.prepareSpatialIndex();
        ReconcileRouterAllTargets(
            this.m_targetTable.targets(),
            this.m_targetTable.lookup(),
            this.m_popupState.records(),
            this.m_targetTable.spatialIndex(),
            this.m_windowFocused,
            this.m_hoverState.known,
            this.m_hoverState.position,
            this.m_commandSources.records(),
            this.m_actions,
            this.m_controlActions,
            this.m_contextMenuActions,
            this.m_pointerState.gestures(),
            this.m_pointerState.gestureSequence(),
            this.m_commandSources.focus(),
            this.m_commandSources.declaration(),
            this.m_commandSources.control(),
            this.m_pointerState.capture(),
            this.m_pointerState.capturePopup(),
            this.m_pointerState.captureDeclaration(),
            this.m_pointerState.captureControl(),
            this.m_pointerState.submitArmed(),
            this.m_pointerState.secondaryOwner(),
            this.m_hoverState.identity,
            this.m_hoverState.target,
            changedHoverOwner
        );
        if(changedHoverOwner)
            this.m_hoverState.advanceActivity();
    }
    private void updateHover(){
        if(this.m_hoverState.known){
            this.m_targetTable.prepareSpatialIndex();
            const Optional<in HitTarget> hovered = this.findHitTarget(this.m_hoverState.position);
            if(hovered.has_value()){
                this.m_hoverState.setTarget(this.m_targetTable.targets(), this.m_targetTable.lookup(), this.m_popupState.records(), true, hovered.value());
                return;
            }
        }
        this.m_hoverState.setTarget(this.m_targetTable.targets(), this.m_targetTable.lookup(), this.m_popupState.records(), false, HitTarget());
    }
    private void cancelInteraction(){
        this.m_hoverState.advanceActivity();
        CancelRouterInteraction(
            this.m_actions,
            this.m_controlActions,
            this.m_contextMenuActions,
            this.m_pointerState.gestures(),
            this.m_commandSources.records(),
            this.m_pointerState.gestureSequence(),
            this.m_hoverState.target,
            this.m_hoverState.identity,
            this.m_commandSources.focus(),
            this.m_pointerState.capture(),
            this.m_pointerState.capturePopup(),
            this.m_pointerState.captureControl(),
            this.m_commandSources.control(),
            this.m_commandSources.declaration(),
            this.m_pointerState.captureDeclaration(),
            this.m_hoverState.known,
            this.m_pointerState.secondaryOwner(),
            this.m_pointerState.submitArmed()
        );
    }
    [cpp_unwind]
    private void routePointer(in InputEvent event, in b8 hasHit, in HitTarget hit, mut InputRoutingResult result){
        const InputPointerRouteEffects effects = this.m_pointerState.routePrimary(event, hasHit, hit, this.m_targetTable, this.m_popupState, this.m_commandSources, this.m_actions, this.m_controlActions, this.m_nextActionSequence, result);
        if(effects.dismissedPopup && !this.m_popupState.apply(effects.popupDismissal))
            TerminateInvariant();
        if(effects.advanceHover)
            this.m_hoverState.advanceActivity();
        if(effects.dismissedPopup){
            this.reconcileTargets();
            this.updateHover();
        }
        if(!effects.ok)
            TerminateInvariant();
    }
    [cpp_unwind]
    private void routeCommand(in InputEvent event, mut InputRoutingResult result){
        b8 dismissedPopup = false;
        PopupDismissRequest popupDismissal;
        RouteRouterCommand(
            this.m_targetTable.targets(),
            this.m_targetTable.lookup(),
            this.m_windowFocused,
            this.m_targetTable.generation(),
            event,
            this.m_pointerState.primaryConsumed(),
            this.m_pointerState.secondaryConsumed(),
            this.m_pointerState.sources(),
            this.m_popupState.records(),
            this.m_popupState.canAppendDismissal(),
            popupDismissal,
            this.m_commandSources.records(),
            this.m_actions,
            this.m_controlActions,
            this.m_contextMenuActions,
            this.m_pointerState.gestures(),
            this.m_pointerState.gestureSequence(),
            this.m_nextActionSequence,
            this.m_pointerState.submitArmed(),
            this.m_pointerState.secondaryOwner(),
            this.m_hoverState.target,
            this.m_commandSources.focus(),
            this.m_commandSources.declaration(),
            this.m_commandSources.control(),
            this.m_pointerState.capture(),
            this.m_pointerState.capturePopup(),
            this.m_pointerState.captureDeclaration(),
            this.m_pointerState.captureControl(),
            result,
            dismissedPopup
        );
        if(dismissedPopup && !this.m_popupState.apply(popupDismissal))
            TerminateInvariant();
        if(dismissedPopup){
            this.reconcileTargets();
            this.updateHover();
        }
    }
}


