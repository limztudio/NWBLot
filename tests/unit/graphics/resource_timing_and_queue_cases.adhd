    EXPECT_EQ(context.queueMetrics[1u].internalIdleTicks, 0u);
    EXPECT_EQ(context.queueMetrics[2u].internalIdleTicks, 0u);
}

void VerifyGpuPacketEnvelopeMetrics_PreservesLargeAndNearLimitTickPrecision(){
    PacketMetricsScratchContext context = PacketMetricsScratchContext(s_GpuTimingCasePacketMetricsPrecision);
    Array<GpuComparableTimestampRange, 3> largeRanges = Array<GpuComparableTimestampRange, 3>();
    largeRanges[0u] = MakeComparableRange(s_GpuTimingLargeTick, s_GpuTimingLargeTick + 20u, 0.5, MakePhysicalQueue(5u, 9u));
    largeRanges[1u] = MakeComparableRange(s_GpuTimingLargeTick + 30u, s_GpuTimingLargeTick + 40u, 0.5, MakePhysicalQueue(5u, 9u));
    largeRanges[2u] = MakeComparableRange(s_GpuTimingLargeTick + 5u, s_GpuTimingLargeTick + 35u, 0.5, MakePhysicalQueue(6u, 9u));
    Expected<GpuPacketEnvelopeMetrics> metrics = AggregateEnvelopeMetrics(largeRanges, context);
    ASSERT_TRUE(metrics.has_value());
    EXPECT_EQ(metrics.value().queueOverlapTicks, 20u);
    ASSERT_EQ(context.queueMetrics.size(), 2u);
