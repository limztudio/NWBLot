}

TEST_F(UiNumericSelectionEpochTests, LaterSiblingSourceRejectsAnAlreadyPaintedFloatSelectionRoundTrip){
    useHost();
    ASSERT_TRUE(m_float.setValue(1.25));
    SelectionEpochSource source;
    ListState list;
    PopupState sibling;
    m_parent.open();
    m_child.open();
    sibling.open();
