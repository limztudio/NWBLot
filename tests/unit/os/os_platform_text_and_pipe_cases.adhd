using namespace NWB::Core;
using GlobalString = AString<Alloc::GlobalArena>;

struct PreeditTestContext{
    NWB::Tests::TestArena<> arena;
    X11PreeditBuffer preedit;
    GlobalString scratch;

    PreeditTestContext()
        : preedit(arena.arena)
        , scratch(arena.arena)
    {}
};

struct WaylandStateContext{
    NWB::Tests::TestArena<> arena;
    GlobalString scratch;
    WaylandTextInputSurroundingState wire;
    WaylandTextInputSerialTracker tracker;
    WaylandTextInputDeferredState deferred;

    WaylandStateContext()
        : scratch(arena.arena)
    {}
};

[[nodiscard]] inline TextInputSessionToken MakeSessionToken(const u64 service, const u64 generation)noexcept{
    return TextInputSessionToken{ service, generation };
}

[[nodiscard]] inline WaylandTextInputProvenance MakeWaylandProvenance(const TextInputSessionToken token, const u64 revision, const b8 revisionKnown)noexcept{
    return WaylandTextInputProvenance{ token, revision, revisionKnown };
}

inline void AppendGlobalString(GlobalString& target, const AStringView text){
    target.append(text.data(), text.size());
}

inline void ClearAndShrinkGlobalString(GlobalString& target){
    target.clear();
    target.shrink_to_fit();
}

[[nodiscard]] inline constexpr usize GetX11PreeditMaxBytes()noexcept{
    return X11PreeditBuffer::s_MaxBytes;
}

