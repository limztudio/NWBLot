[cpp_name("::NWB::Impl::RendererFramePipeline"), cpp_header("<impl/ecs_render/renderer_frame_pipeline.adhd.h>")]
extern class RendererFramePipeline;


[modular]
class ShadowPreparePacketValidator : NoCopy{
    private in RendererFramePipeline m_pipeline;

    public ShadowPreparePacketValidator(in RendererFramePipeline pipeline){
        this.m_pipeline = pipeline;
    }

    public void validate(in GpuCompiledGraphReadView compiledPlan, mut ShadowPreparePacketValidationResult outResult)const;
}


