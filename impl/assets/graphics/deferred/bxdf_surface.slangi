#ifndef NWB_GRAPHICS_DEFERRED_BXDF_SURFACE_SLANGI
#define NWB_GRAPHICS_DEFERRED_BXDF_SURFACE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Shared BXDF input: deferred unpacks from G-buffer, AVBOIT builds from the surface hook; both feed nwbDeferredDispatchBxdf. param0/1 are material-packed alpha channels; shadingModel selects the BXDF.
struct NwbBxdfSurface{
    half3  baseColor;
    float3 normal;          // world space, normalized
    float3 worldPosition;
    float3 viewVector;      // normalized, surface -> observer; ray effects supply the reflected viewing direction
    uint   shadingModel;
    half   param0;
    half   param1;
    bool   isBackground;    // no geometry at this pixel (sky); lighting shaders pass the base color through
    // Indirect diffuse irradiance. Deferred fills it from the resolved surfel-GI texture; disabled/transparent paths get the hemiAmbient fallback.
    half3  indirectIrradiance;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

