////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_AVBOIT_ACCUMULATE_PS_AUTHORING_SLANGI
#define NWB_GRAPHICS_AVBOIT_ACCUMULATE_PS_AUTHORING_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Engine-owned AVBOIT entry/compositing; materials provide the shared surface hook and BXDF.


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "binding_slots.h"
#include "../scene/binding_slots.h"
#include "../mesh/runtime_constants.h"

#define NWB_MESH_MATERIAL_CONTEXT_PROVIDED
#include "common.slangi"
#define g_NwbDeferredBindlessResources NWB_AVBOIT_DEFERRED_BINDLESS_RESOURCES

// Scene resources are selected through the target-generation heap payload.
#define NWB_SCENE_SHADING_HEAP_SLOT g_NwbDeferredBindlessResources.avboitSlots.z
#define NWB_SCENE_LIGHT_LIST_HEAP_SLOT g_NwbDeferredBindlessResources.avboitSlots.w

// Transparent fragments bypass opaque-G-buffer shadow/caustic sampling and omit conflicting local bindings.
#define NWB_SCENE_SHADOW_CAUSTIC_SAMPLING_DISABLED
#define NWB_SCENE_GI_SAMPLING_DISABLED

// AVBOIT draw push constants expose the same material context as rasterization.
#include "../scene/lighting.slangi"

// Project BXDFs own their tone-map policy and use this shared presentation query in either shading harness.
bool nwbBxdfPresentationIsHdr10(){
    return nwbAvboitPresentationIsHdr10();
}

#include "../mesh/gbuffer_io.slangi"

#include "material_context_authoring.slangi"

#include "../mesh/material_typed_accessors.slangi"
#include "../mesh/surface.slangi"
#include "../deferred/bxdf_surface.slangi"
// Generated BXDF dispatch resolves from its own include root.
#include "deferred/generated/bxdf_dispatch.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Texture3D<float4> nwbAvboitTransmittanceTexture(){
    return NwbHeapSampledImage3D(g_NwbDeferredBindlessResources.avboitSlots.x);
}

SamplerState nwbAvboitAccumulationSampler(){
    return NwbHeapSampler(g_NwbDeferredBindlessResources.avboitSlots.y);
}

struct NwbAvboitAccumulatePixelInput{
    float4 position : SV_Position;
    bool frontFace : SV_IsFrontFace;
    NWB_MESH_RASTER_PAYLOAD_FIELDS
};

struct NwbAvboitAccumulatePixelOutput{
    [[vk::location(NWB_AVBOIT_ACCUM_COLOR_LOCATION)]] float4 accumColor : SV_Target0;
    [[vk::location(NWB_AVBOIT_ACCUM_EXTINCTION_LOCATION)]] float4 accumExtinction : SV_Target1;
    [[vk::location(NWB_AVBOIT_ACCUM_FOREGROUND_COLOR_LOCATION)]] float4 foregroundColor : SV_Target2;
    [[vk::location(NWB_AVBOIT_ACCUM_FOREGROUND_EXTINCTION_LOCATION)]] float4 foregroundExtinction : SV_Target3;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "accumulate_transmittance.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NwbAvboitAccumulatePixelOutput main(NwbAvboitAccumulatePixelInput input){
    NwbMeshSurfaceInputs surfaceInputs;
    surfaceInputs.color = half4(input.color);
    surfaceInputs.normal = float3(input.normal);
    surfaceInputs.tangent = float4(input.tangent);
    surfaceInputs.uv0 = input.uv0;
    surfaceInputs.worldPosition = input.worldPosition.xyz;
    surfaceInputs.incidentDirection = nwbMeshCameraToSurfaceDirection(input.worldPosition.xyz);
    nwbLoadMeshSurfaceInputs(surfaceInputs);
#if NWB_CSG_ENABLED
    if(nwbAvboitCsgPixelDiscard(input.position, input.worldPosition))
        discard;
#endif

    // Surface coverage must match occupancy and extinction.
    const NwbMeshSurface surface = nwbMaterialSurface();

    const half alpha = half(clamp(surface.renderCoverage, 0.0, 1.0));

    if(nwbAvboitRefractionCapture()){
        const float ior = float(surface.refractionIor);
        if(!isfinite(ior) || ior <= 1.0001)
            discard;
        // Capture owns a separate depth attachment. Opaque visibility must therefore be tested explicitly.
        const float opaqueDepth = NwbHeapSampledImage2D(g_NwbDeferredBindlessResources.gbufferSlots.w)
            .Load(int3(int2(input.position.xy), 0)).r;
        if(input.position.z > opaqueDepth)
            discard;

        NwbAvboitAccumulatePixelOutput capture;
        capture.accumColor = float4(nwbSafeNormalize(surface.normal, float3(0.0, 0.0, 1.0)), ior);
        capture.accumExtinction = float4(clamp(float3(surface.shadowAbsorptionTint), float3(0.0), float3(1.0)), float(alpha));
#if NWB_CSG_ENABLED
        // The triangle TLAS does not contain boolean-cut exits. Resolve this primary through the raster-aware
        // screen fallback instead of tracing the original uncut volume. Coverage is not used for optical masking.
        capture.accumExtinction.w = -1.0;
#endif
        capture.foregroundColor = float4(float(nwbMeshInstanceIndex()) + 1.0, 0.0, 0.0, 0.0);
        capture.foregroundExtinction = float4(0.0);
        return capture;
    }

    if(alpha <= half(0.0))
        discard;
    if(nwbAvboitPrimaryRefractionInstance(nwbAvboitFullUvFromFragCoord(input.position.xy), nwbMeshInstanceIndex()))
        discard;

    const half volumeTransmittance = nwbAvboitLinearBiasedTransmittance(input.position.xy, input.position.z);
    const half weightedAlpha = alpha * volumeTransmittance;

    NwbBxdfSurface bxdfSurface;
    bxdfSurface.baseColor = surface.baseColor;
    bxdfSurface.normal = nwbSafeNormalize(surface.normal, float3(0.0, 0.0, 1.0));
    bxdfSurface.worldPosition = inWorldPosition;
    bxdfSurface.viewVector = nwbSafeNormalize(g_NwbSceneCameraPosition.xyz - inWorldPosition, float3(0.0, 0.0, 1.0));
    bxdfSurface.shadingModel = nwbMeshShadingModelId();
    bxdfSurface.param0 = surface.param0;
    bxdfSurface.param1 = surface.param1;
    bxdfSurface.isBackground = false;
    bxdfSurface.indirectIrradiance = nwbBxdfIndirectIrradiance(bxdfSurface.worldPosition, bxdfSurface.normal);

    // Negative pixel bypasses opaque-G-buffer shadow sampling.
    const half3 resolvedColor = nwbDeferredDispatchBxdf(bxdfSurface.shadingModel, bxdfSurface, int2(-1, -1));
    // Opacity belongs in weightedAlpha and never exceeds one. RGB is radiance: retain HDR highlights through the
    // RGBA16F accumulation/composite targets, but preserve the prior SDR clamp for non-HDR presentation.
    const half3 shadedColor = nwbAvboitPresentationIsHdr10()
        ? max(resolvedColor, half3(0.0h))
        : clamp(resolvedColor, half3(0.0h), half3(1.0h))
    ;

    NwbAvboitAccumulatePixelOutput output;
    output.accumColor = half4(shadedColor * weightedAlpha, weightedAlpha);
    output.accumExtinction = float4(nwbAvboitExtinctionFromAlpha(alpha), 0.0, 0.0, 0.0);
    output.foregroundColor = float4(0.0);
    output.foregroundExtinction = float4(0.0);
    // Preserve foreground transparency at its camera pixel. Background accumulation is resolved separately
    // through the bent path; a cleared capture depth leaves ordinary AVBOIT's original outputs unchanged.
    const float refractionDepth = nwbAvboitPrimaryRefractionDepth(input.position.xy);
    if(refractionDepth < NWB_SCENE_BACKGROUND_DEPTH && input.position.z < refractionDepth){
        output.foregroundColor = output.accumColor;
        output.foregroundExtinction = output.accumExtinction;
        output.accumColor = float4(0.0);
        output.accumExtinction = float4(0.0);
    }
    return output;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#undef g_NwbDeferredBindlessResources


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

