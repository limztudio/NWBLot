void VerifyArenaObjectConstruction_NestedFactorySuccessIsDestroyedWhenOuterConstructionThrows(){
    const Name owner = s_GlobalArenaCaseArenaObjectNestedConstructorFailure;
    b8 outerDestroyed = false;
    native(in owner, mut outerDestroyed){
        using namespace __hidden_arena_object_construction_tests;
        GlobalArena arena{ owner };
        ConstructionState state;
        const ArenaMemoryStats before = arena.memoryStats();
        EXPECT_THROW(EXPECT_TRUE(MakeGlobalUnique<NestedConstruction>(arena, arena, state, outerDestroyed)), ConstructionFailure);
        const ArenaMemoryStats after = arena.memoryStats();
        EXPECT_EQ(state.constructors, 1u);
        EXPECT_EQ(state.completed, 1u);
        EXPECT_EQ(state.destructors, 1u);
        EXPECT_EQ(state.memberDestructors, 1u);
        EXPECT_EQ(state.liveMembers, 0u);
        EXPECT_EQ(after.usedBytes, before.usedBytes);
        EXPECT_EQ(after.allocationCount - before.allocationCount, after.deallocationCount - before.deallocationCount);
    }
    EXPECT_FALSE(outerDestroyed);
}

void VerifyArenaObjectConstruction_FailedRawAllocationsNeverRunConstructorsOrDestructors(){
    const Name owner = s_GlobalArenaCaseArenaObjectRejectedConstruction;
    usize attempts = 0u;
    usize constructors = 1u;
    usize destructors = 1u;
    usize memberDestructors = 1u;
    native(in owner, mut attempts, mut constructors, mut destructors, mut memberDestructors){
        using namespace __hidden_arena_object_construction_tests;
        GlobalArena memberArena{ owner };
        RejectingArena arena;
        ConstructionState state;
        ActiveConstruction<GlobalArena> active(memberArena, state);
        using Probe = ConstructionProbe<GlobalArena>;
        EXPECT_EQ(NewArenaObject<Probe>(arena, memberArena, state), nullptr);
        EXPECT_FALSE(MakeArenaUnique<Probe>(arena, memberArena, state));
        EXPECT_FALSE(MakeArenaUnique<Probe[]>(arena, 4u));
        attempts = arena.attempts;
        constructors = state.constructors;
        destructors = state.destructors;
        memberDestructors = state.memberDestructors;
    }
    EXPECT_EQ(attempts, 3u);
    EXPECT_EQ(constructors, 0u);
    EXPECT_EQ(destructors, 0u);
    EXPECT_EQ(memberDestructors, 0u);
}

void VerifyArenaObjectConstruction_ArenaFactoriesRetainStorageIdentityAndBypassClassAllocationHooks(){
    const Name globalOwner = s_GlobalArenaCaseArenaObjectCanonicalGlobalPlacement;
    const Name persistentOwner = s_GlobalArenaCaseArenaObjectCanonicalPersistentPlacement;
    usize placementCalls = 1u;
    usize constructors = 0u;
    usize destructors = 0u;
    b8 memoryBalanced = false;
    native(in globalOwner, in persistentOwner, mut placementCalls, mut constructors, mut destructors, mut memoryBalanced){
        using namespace __hidden_arena_object_construction_tests;
        GlobalArena global{ globalOwner };
        PersistentArena persistent(persistentOwner, PersistentArena::StructureAlignedSize(4096u));
        ArenaPlacementProbe::s_PlacementCalls = 0u;
        ArenaPlacementProbe::s_Constructors = 0u;
        ArenaPlacementProbe::s_Destructors = 0u;
        const ArenaMemoryStats globalBefore = global.memoryStats();
        const ArenaMemoryStats persistentBefore = persistent.memoryStats();
        {
            auto globalObject = MakeGlobalUnique<ArenaPlacementProbe>(global);
            auto persistentObject = MakePersistentUnique<ArenaPlacementProbe>(persistent);
            auto globalArray = MakeGlobalUnique<ArenaPlacementProbe[]>(global, 3u);
            auto persistentArray = MakePersistentUnique<ArenaPlacementProbe[]>(persistent, 3u);
            EXPECT_TRUE(globalObject);
            EXPECT_TRUE(persistentObject);
            EXPECT_TRUE(globalArray);
            EXPECT_TRUE(persistentArray);
            ArenaPlacementProbe* const globalRaw = NewArenaObject<ArenaPlacementProbe>(global);
            ArenaPlacementProbe* const persistentRaw = NewArenaObject<ArenaPlacementProbe>(persistent);
            EXPECT_NE(globalRaw, nullptr);
            EXPECT_NE(persistentRaw, nullptr);
            DestroyArenaObject(global, globalRaw);
            DestroyArenaObject(persistent, persistentRaw);
        }
        placementCalls = ArenaPlacementProbe::s_PlacementCalls;
        constructors = ArenaPlacementProbe::s_Constructors;
        destructors = ArenaPlacementProbe::s_Destructors;
        const ArenaMemoryStats globalAfter = global.memoryStats();
        const ArenaMemoryStats persistentAfter = persistent.memoryStats();
        memoryBalanced =
            globalAfter.usedBytes == globalBefore.usedBytes
            && globalAfter.reservedBytes == globalBefore.reservedBytes
            && persistentAfter.usedBytes == persistentBefore.usedBytes
            && persistentAfter.reservedBytes == persistentBefore.reservedBytes
            && (globalAfter.allocationCount - globalBefore.allocationCount) == (globalAfter.deallocationCount - globalBefore.deallocationCount)
            && (persistentAfter.allocationCount - persistentBefore.allocationCount) == (persistentAfter.deallocationCount - persistentBefore.deallocationCount)
        ;
    }
    EXPECT_EQ(placementCalls, 0u);
    EXPECT_EQ(constructors, 10u);
    EXPECT_EQ(destructors, 10u);
    EXPECT_TRUE(memoryBalanced);
}

void VerifyArenaObjectConstruction_ArgumentTemporaryFailureDestroysCompletedMembersBeforeReleasingArenaStorage(){
    const Name globalOwner = s_GlobalArenaCaseArenaObjectGlobalArgumentCleanupFailure;
    const Name persistentOwner = s_GlobalArenaCaseArenaObjectPersistentArgumentCleanupFailure;
    usize globalLive = 1u;
    usize globalMemberDestructors = 0u;
    usize persistentLive = 1u;
    usize persistentMemberDestructors = 0u;
    b8 memoryBalanced = false;
    native(in globalOwner, in persistentOwner, mut globalLive, mut globalMemberDestructors, mut persistentLive, mut persistentMemberDestructors, mut memoryBalanced){
        using namespace __hidden_arena_object_construction_tests;
        GlobalArena global{ globalOwner };
        PersistentArena persistent(persistentOwner, PersistentArena::StructureAlignedSize(4096u));
        ConstructionState globalState;
        ConstructionState persistentState;
        const ConstructionArgumentSource<GlobalArena> globalArgument{ global, globalState };
        const ConstructionArgumentSource<PersistentArena> persistentArgument{ persistent, persistentState };
        const ArenaMemoryStats globalBefore = global.memoryStats();
        const ArenaMemoryStats persistentBefore = persistent.memoryStats();
        EXPECT_THROW(EXPECT_TRUE(MakeGlobalUnique<ArgumentCleanupProbe<GlobalArena>>(global, globalArgument)), ConstructionFailure);
        EXPECT_THROW(EXPECT_TRUE(MakePersistentUnique<ArgumentCleanupProbe<PersistentArena>>(persistent, persistentArgument)), ConstructionFailure);
        globalLive = globalState.liveMembers;
        globalMemberDestructors = globalState.memberDestructors;
        persistentLive = persistentState.liveMembers;
        persistentMemberDestructors = persistentState.memberDestructors;
        const ArenaMemoryStats globalAfter = global.memoryStats();
        const ArenaMemoryStats persistentAfter = persistent.memoryStats();
        memoryBalanced =
            globalAfter.usedBytes == globalBefore.usedBytes
            && globalAfter.reservedBytes == globalBefore.reservedBytes
            && persistentAfter.usedBytes == persistentBefore.usedBytes
            && persistentAfter.reservedBytes == persistentBefore.reservedBytes
            && (globalAfter.allocationCount - globalBefore.allocationCount) == (globalAfter.deallocationCount - globalBefore.deallocationCount)
            && (persistentAfter.allocationCount - persistentBefore.allocationCount) == (persistentAfter.deallocationCount - persistentBefore.deallocationCount)
        ;
    }
    EXPECT_EQ(globalLive, 0u);
    EXPECT_EQ(globalMemberDestructors, 1u);
    EXPECT_EQ(persistentLive, 0u);
    EXPECT_EQ(persistentMemberDestructors, 1u);
    EXPECT_TRUE(memoryBalanced);
}

void VerifyArenaObjectConstruction_CanonicalPrivateDestructorsRetainOwningRollbackAndRawConstructionAccess(){
    const Name globalOwner = s_GlobalArenaCaseArenaObjectPrivateGlobalDestructor;
    const Name persistentOwner = s_GlobalArenaCaseArenaObjectPrivatePersistentDestructor;
    b8 globalDestroyed = false;
    b8 persistentDestroyed = false;
    b8 rawDestroyed = false;
    native(in globalOwner, in persistentOwner, mut globalDestroyed, mut persistentDestroyed, mut rawDestroyed){
        using namespace __hidden_arena_object_construction_tests;
        GlobalArena global{ globalOwner };
        PersistentArena persistent(persistentOwner, PersistentArena::StructureAlignedSize(4096u));
        ConstructionState globalState;
        ConstructionState persistentState;
        const ConstructionArgumentSource<GlobalArena> globalArgument{ global, globalState };
        const ConstructionArgumentSource<PersistentArena> persistentArgument{ persistent, persistentState };
        const ArenaMemoryStats globalBefore = global.memoryStats();
        const ArenaMemoryStats persistentBefore = persistent.memoryStats();
        EXPECT_THROW(EXPECT_TRUE(MakeGlobalUnique<PrivateDestructorProbe<GlobalArena>>(global, globalArgument)), ConstructionFailure);
        EXPECT_THROW(EXPECT_TRUE(MakePersistentUnique<PrivateDestructorProbe<PersistentArena>>(persistent, persistentArgument)), ConstructionFailure);
        EXPECT_EQ(globalState.liveMembers, 0u);
        EXPECT_EQ(globalState.memberDestructors, 1u);
        EXPECT_EQ(persistentState.liveMembers, 0u);
        EXPECT_EQ(persistentState.memberDestructors, 1u);
        {
            auto globalOwnerPtr = MakeGlobalUnique<PrivateDestructorProbe<GlobalArena>>(global, global, globalState, globalDestroyed);
            auto persistentOwnerPtr = MakePersistentUnique<PrivateDestructorProbe<PersistentArena>>(persistent, persistent, persistentState, persistentDestroyed);
            EXPECT_TRUE(globalOwnerPtr);
            EXPECT_TRUE(persistentOwnerPtr);
        }
        auto* const raw = NewArenaObject<RawPrivateDestructorProbe<GlobalArena>>(global, rawDestroyed);
        ASSERT_NE(raw, nullptr);
        DestroyArenaObject(global, raw);
        const ArenaMemoryStats globalAfter = global.memoryStats();
        const ArenaMemoryStats persistentAfter = persistent.memoryStats();
        EXPECT_EQ(globalAfter.usedBytes, globalBefore.usedBytes);
        EXPECT_EQ(globalAfter.reservedBytes, globalBefore.reservedBytes);
        EXPECT_EQ(persistentAfter.usedBytes, persistentBefore.usedBytes);
        EXPECT_EQ(persistentAfter.reservedBytes, persistentBefore.reservedBytes);
        EXPECT_EQ(globalAfter.allocationCount - globalBefore.allocationCount, globalAfter.deallocationCount - globalBefore.deallocationCount);
        EXPECT_EQ(persistentAfter.allocationCount - persistentBefore.allocationCount, persistentAfter.deallocationCount - persistentBefore.deallocationCount);
    }
    EXPECT_TRUE(globalDestroyed);
    EXPECT_TRUE(persistentDestroyed);
    EXPECT_TRUE(rawDestroyed);
}

void VerifyArenaObjectConstruction_IndividualDeleterFriendRetainsCompletedRollbackAndNormalOwningDestruction(){
    const Name globalOwner = s_GlobalArenaCaseArenaObjectOperatorFriendGlobalDestructor;
    const Name persistentOwner = s_GlobalArenaCaseArenaObjectOperatorFriendPersistentDestructor;
    b8 globalPrivateAlive = false;
    b8 persistentPrivateAlive = false;
    native(in globalOwner, in persistentOwner, mut globalPrivateAlive, mut persistentPrivateAlive){
        using namespace __hidden_arena_object_construction_tests;
        GlobalArena global{ globalOwner };
        PersistentArena persistent(persistentOwner, PersistentArena::StructureAlignedSize(4096u));
        ConstructionState globalState;
        ConstructionState persistentState;
        const ConstructionArgumentSource<GlobalArena> globalArgument{ global, globalState };
        const ConstructionArgumentSource<PersistentArena> persistentArgument{ persistent, persistentState };
        const ArenaMemoryStats globalBefore = global.memoryStats();
        const ArenaMemoryStats persistentBefore = persistent.memoryStats();
        EXPECT_THROW(EXPECT_TRUE(MakeGlobalUnique<OperatorPrivateDestructorProbe<GlobalArena>>(global, globalArgument)), ConstructionFailure);
        EXPECT_THROW(EXPECT_TRUE(MakePersistentUnique<OperatorPrivateDestructorProbe<PersistentArena>>(persistent, persistentArgument)), ConstructionFailure);
        EXPECT_EQ(globalState.liveMembers, 0u);
        EXPECT_EQ(globalState.memberDestructors, 1u);
        EXPECT_EQ(persistentState.liveMembers, 0u);
        EXPECT_EQ(persistentState.memberDestructors, 1u);
        {
            auto globalOwnerPtr = MakeGlobalUnique<OperatorPrivateDestructorProbe<GlobalArena>>(global, global, globalState);
            auto persistentOwnerPtr = MakePersistentUnique<OperatorPrivateDestructorProbe<PersistentArena>>(persistent, persistent, persistentState);
            EXPECT_TRUE(globalOwnerPtr);
            EXPECT_TRUE(persistentOwnerPtr);
        }
        EXPECT_EQ(globalState.liveMembers, 0u);
        EXPECT_EQ(globalState.memberDestructors, 2u);
        EXPECT_EQ(persistentState.liveMembers, 0u);
        EXPECT_EQ(persistentState.memberDestructors, 2u);
        {
            auto globalPrivate = MakeGlobalUnique<PrivateConstructorProbe<GlobalArena>>(global, globalPrivateAlive);
            auto persistentPrivate = MakePersistentUnique<PrivateConstructorProbe<PersistentArena>>(persistent, persistentPrivateAlive);
            EXPECT_TRUE(globalPrivate);
            EXPECT_TRUE(persistentPrivate);
            EXPECT_TRUE(globalPrivateAlive);
            EXPECT_TRUE(persistentPrivateAlive);
        }
        const ArenaMemoryStats globalAfter = global.memoryStats();
        const ArenaMemoryStats persistentAfter = persistent.memoryStats();
        EXPECT_EQ(globalAfter.usedBytes, globalBefore.usedBytes);
        EXPECT_EQ(globalAfter.reservedBytes, globalBefore.reservedBytes);
        EXPECT_EQ(persistentAfter.usedBytes, persistentBefore.usedBytes);
        EXPECT_EQ(persistentAfter.reservedBytes, persistentBefore.reservedBytes);
        EXPECT_EQ(globalAfter.allocationCount - globalBefore.allocationCount, globalAfter.deallocationCount - globalBefore.deallocationCount);
        EXPECT_EQ(persistentAfter.allocationCount - persistentBefore.allocationCount, persistentAfter.deallocationCount - persistentBefore.deallocationCount);
    }
    EXPECT_FALSE(globalPrivateAlive);
    EXPECT_FALSE(persistentPrivateAlive);
}

void VerifyArenaObjectConstruction_PolymorphicTransfersRetainCompleteAllocationAcrossVirtualBases(){
    const Name globalOwner = s_GlobalArenaCaseArenaObjectPolymorphicGlobal;
    const Name persistentOwner = s_GlobalArenaCaseArenaObjectPolymorphicPersistent;
    const Name scratchOwner = s_GlobalArenaCaseArenaObjectPolymorphicScratch;
    u64 remainingUsedBytes = 1u;
    native(in globalOwner, in persistentOwner, in scratchOwner, mut remainingUsedBytes){
        using namespace __hidden_arena_object_construction_tests;
        GlobalArena global{ globalOwner };
        PersistentArena persistent(persistentOwner, PersistentArena::StructureAlignedSize(4096u));
        ScratchArena scratch{ scratchOwner };
        VerifyPolymorphicAllocationIdentity(global);
        VerifyPolymorphicAllocationIdentity(persistent);
        VerifyPolymorphicAllocationIdentity(scratch);
        remainingUsedBytes = global.memoryStats().usedBytes + persistent.memoryStats().usedBytes + scratch.memoryStats().usedBytes;
    }
    EXPECT_EQ(remainingUsedBytes, 0u);
}

void VerifyArenaObjectConstruction_StatefulCleanupSurvivesPreallocatedOwnerReentry(){
    const Name oldGlobalOwner = s_GlobalArenaCaseArenaObjectReentryOldGlobal;
    const Name newGlobalOwner = s_GlobalArenaCaseArenaObjectReentryNewGlobal;
    const Name oldPersistentOwner = s_GlobalArenaCaseArenaObjectReentryOldPersistent;
    const Name newPersistentOwner = s_GlobalArenaCaseArenaObjectReentryNewPersistent;
    const Name oldScratchOwner = s_GlobalArenaCaseArenaObjectReentryOldScratch;
    const Name newScratchOwner = s_GlobalArenaCaseArenaObjectReentryNewScratch;
    u64 remainingUsedBytes = 1u;
    native(in oldGlobalOwner, in newGlobalOwner, in oldPersistentOwner, in newPersistentOwner, in oldScratchOwner, in newScratchOwner, mut remainingUsedBytes){
        using namespace __hidden_arena_object_construction_tests;
        GlobalArena oldGlobal{ oldGlobalOwner }, newGlobal{ newGlobalOwner };
        PersistentArena oldPersistent(oldPersistentOwner, PersistentArena::StructureAlignedSize(4096u));
        PersistentArena newPersistent(newPersistentOwner, PersistentArena::StructureAlignedSize(4096u));
        ScratchArena oldScratch{ oldScratchOwner }, newScratch{ newScratchOwner };
        VerifyScalarOwnerReentry(oldGlobal, newGlobal);
        VerifyScalarOwnerReentry(oldPersistent, newPersistent);
        VerifyScalarOwnerReentry(oldScratch, newScratch);
        VerifyArrayOwnerReentry<GlobalArena, false>(oldGlobal, newGlobal);
        VerifyArrayOwnerReentry<PersistentArena, false>(oldPersistent, newPersistent);
        VerifyArrayOwnerReentry<ScratchArena, false>(oldScratch, newScratch);
        VerifyArrayOwnerReentry<GlobalArena, true>(oldGlobal, newGlobal);
        VerifyArrayOwnerReentry<PersistentArena, true>(oldPersistent, newPersistent);
        VerifyArrayOwnerReentry<ScratchArena, true>(oldScratch, newScratch);
        remainingUsedBytes =
            oldGlobal.memoryStats().usedBytes
            + newGlobal.memoryStats().usedBytes
            + oldPersistent.memoryStats().usedBytes
            + newPersistent.memoryStats().usedBytes
            + oldScratch.memoryStats().usedBytes
            + newScratch.memoryStats().usedBytes
        ;
    }
    EXPECT_EQ(remainingUsedBytes, 0u);
}



