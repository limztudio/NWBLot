                desc,
                PacketLifecycleTask::Payload{ .acceptedCount = &acceptedCount, .discardedCount = &discardedCount }
            );
            ASSERT_TRUE(taskResult);
            task = *taskResult;
        }
        ASSERT_TRUE(task.valid());
    }

    EXPECT_EQ(acceptedCount, 0u);
    EXPECT_EQ(discardedCount, 2u);
}

void VerifyGpuPacket_ResetRetiresPayloadsAndPublishesReusableStateWhenDiscardObserverThrows(){
    TestArena testArena = TestArena();
    u32 destructionCount = 0u;
    u32 discardCount = 0u;
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskDesc desc = GpuTaskDesc();
    desc.setIdentity(s_GpuCaseTaskGraphResetThrowingObserver);
    desc.setMarkerLabel("Throwing Reset Observer");
    native(mut graph, in desc, mut destructionCount, mut discardCount){
        const auto task = graph.addTask<GpuPacketThrowingResetTask>(desc, GpuPacketThrowingResetTask::Payload(destructionCount, discardCount));
        ASSERT_TRUE(task);
        EXPECT_THROW(graph.reset(), GpuPacketResetDiscardFailure);
    }
    EXPECT_EQ(discardCount, 1u);
    EXPECT_EQ(destructionCount, 1u);
    EXPECT_TRUE(graph.tryReset());
    EXPECT_EQ(discardCount, 1u);
    EXPECT_EQ(destructionCount, 1u);
}

void VerifyGpuPacket_ResetDuringUnwindPreservesOriginalFailureWithoutCallingDiscardObserver(){
    TestArena testArena = TestArena();
    u32 destructionCount = 0u;
    u32 discardCount = 0u;
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskDesc desc = GpuTaskDesc();
    desc.setIdentity(s_GpuCaseTaskGraphResetActiveUnwind);
    desc.setMarkerLabel("Reset During Active Unwind");
    native(mut graph, in desc, mut destructionCount, mut discardCount){
        const auto task = graph.addTask<GpuPacketThrowingResetTask>(desc, GpuPacketThrowingResetTask::Payload(destructionCount, discardCount));
        ASSERT_TRUE(task);

        EXPECT_THROW(([&](){
            ScopeExit resetOnUnwind([&]()noexcept{ graph.reset(); });
            throw GpuPacketResetOriginalFailure{};
        }()), GpuPacketResetOriginalFailure);
    }
    EXPECT_EQ(discardCount, 0u);
    EXPECT_EQ(destructionCount, 1u);

    GpuTaskDesc nextDesc = GpuTaskDesc();
    nextDesc.setIdentity(s_GpuCaseTaskGraphAfterResetUnwind);
    nextDesc.setMarkerLabel("After Reset Unwind");
    const Expected<GpuTaskId> nextTask = graph.addTask(nextDesc);
    ASSERT_TRUE(nextTask.has_value());
    graph.reset();
    EXPECT_EQ(discardCount, 0u);
    EXPECT_EQ(destructionCount, 1u);
}

void VerifyGpuPacket_RetiresOperationPayloadsBeforeBorrowedStateExpiresAndPreservesDeclarations(){
    TestArena testArena = TestArena();
    b8 ownerAlive = true;
    u32 destructionCount = 0u;
    u32 discardCount = 0u;
    u32 lateUseCount = 0u;
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    GpuGraphSubmissionTransaction transaction = GpuGraphSubmissionTransaction(testArena.arena);
    GpuTaskId task = GpuTaskId();
    u64 generation = 0u;
    u64 declarationRevision = 0u;
    usize payloadObjectSize = 0u;
    native(
        mut transaction,
        mut graph,
        mut compiledGraph,
        mut ownerAlive,
        mut destructionCount,
        mut discardCount,
        mut lateUseCount,
        mut task,
        mut generation,
        mut declarationRevision,
        mut payloadObjectSize
    ){
        Core::GpuGraphSubmissionTransaction::PayloadLifetimeScope payloadLifetime(transaction, graph, compiledGraph);
        Core::GpuTaskDesc desc;
        desc.setIdentity(s_GpuCaseTaskGraphOperationPayload).setMarkerLabel("Operation Payload");
        const auto added = graph.addTask<GpuPacketBorrowedPayloadLifetimeTask>(
            desc,
            GpuPacketBorrowedPayloadLifetimeTask::Payload(ownerAlive, destructionCount, discardCount, lateUseCount, false)
        );
        ASSERT_TRUE(added);
        task = *added;
        const Core::GpuTaskGraph::DeclarationReadView declarations(graph);
        generation = declarations.generation();
        declarationRevision = declarations.declarationRevision();
        payloadObjectSize = declarations.taskAt(task.index).payloadObjectSize;
        EXPECT_TRUE(declarations.taskAt(task.index).hasPayload);
    }
    EXPECT_EQ(discardCount, 1u);
    EXPECT_EQ(destructionCount, 1u);
    ownerAlive = false;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        EXPECT_EQ(declarations.generation(), generation);
        EXPECT_EQ(declarations.declarationRevision(), declarationRevision);
        EXPECT_EQ(declarations.taskCount(), 1u);
        EXPECT_TRUE(declarations.validTask(task));
        const GpuTaskGraphTaskView view = declarations.taskAt(task.index);
        EXPECT_EQ(view.identity, Name("tests/task_graph/operation_payload"));
        EXPECT_EQ(view.markerLabel, AStringView("Operation Payload"));
        EXPECT_EQ(view.payloadObjectSize, payloadObjectSize);
        EXPECT_FALSE(view.hasPayload);
    }
    graph.reset();
    EXPECT_EQ(discardCount, 1u);
    EXPECT_EQ(destructionCount, 1u);
    EXPECT_EQ(lateUseCount, 0u);
}

void VerifyGpuPacket_OperationPayloadRetirementPreservesObserverFailureAndFinishesAllDestruction(){
    TestArena testArena = TestArena();
    b8 ownerAlive = true;
    u32 destructionCount = 0u;
    u32 discardCount = 0u;
    u32 lateUseCount = 0u;
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    GpuGraphSubmissionTransaction transaction = GpuGraphSubmissionTransaction(testArena.arena);
    native(
        mut transaction,
        mut graph,
        mut compiledGraph,
        mut ownerAlive,
        mut destructionCount,
        mut discardCount,
        mut lateUseCount
    ){
        EXPECT_THROW(([&](){
            Core::GpuGraphSubmissionTransaction::PayloadLifetimeScope payloadLifetime(transaction, graph, compiledGraph);
            Core::GpuTaskDesc firstDesc;
            firstDesc.setIdentity(s_GpuCaseTaskGraphRetireThrowFirst).setMarkerLabel("Retire Throw First");
            const auto first = graph.addTask<GpuPacketBorrowedPayloadLifetimeTask>(
                firstDesc,
                GpuPacketBorrowedPayloadLifetimeTask::Payload(ownerAlive, destructionCount, discardCount, lateUseCount, true)
            );
            ASSERT_TRUE(first);
            Core::GpuTaskDesc secondDesc;
            secondDesc.setIdentity(s_GpuCaseTaskGraphRetireThrowSecond).setMarkerLabel("Retire Throw Second");
            const auto second = graph.addTask<GpuPacketBorrowedPayloadLifetimeTask>(
                secondDesc,
                GpuPacketBorrowedPayloadLifetimeTask::Payload(ownerAlive, destructionCount, discardCount, lateUseCount, false)
            );
            ASSERT_TRUE(second);
        }()), GpuPacketResetDiscardFailure);
    }
    EXPECT_EQ(discardCount, 1u);
    EXPECT_EQ(destructionCount, 2u);
    ownerAlive = false;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        EXPECT_EQ(declarations.taskCount(), 2u);
        EXPECT_FALSE(declarations.taskAt(0u).hasPayload);
        EXPECT_FALSE(declarations.taskAt(1u).hasPayload);
    }
    graph.reset();
    EXPECT_EQ(discardCount, 1u);
    EXPECT_EQ(destructionCount, 2u);
    EXPECT_EQ(lateUseCount, 0u);
}

