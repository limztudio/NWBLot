    [[nodiscard]] isize sendChar(const u32, const isize)noexcept{ return 0; }
    [[nodiscard]] isize sendSysChar(const u32, const isize)noexcept{ return 0; }
    [[nodiscard]] isize sendUniChar(const u32, const isize)noexcept{ return 0; }
    [[nodiscard]] isize sendImeStartComposition()noexcept{ return 0; }
    [[nodiscard]] isize sendImeEndComposition()noexcept{ return 0; }
    [[nodiscard]] isize sendImeChar(const u32)noexcept{ return 0; }
    [[nodiscard]] isize sendImeComposition(const u32, const isize)noexcept{ return 0; }
    [[nodiscard]] isize sendImeSetContext(const b8, const isize)noexcept{ return 0; }
    [[nodiscard]] isize sendKillFocus()noexcept{ return 0; }
    [[nodiscard]] isize sendSetFocus()noexcept{ return 0; }

    [[nodiscard]] b8 dispatchDirectChar(const u32)noexcept{ return false; }
    [[nodiscard]] Expected<u32> decodeFallbackChar(const u32)noexcept{ return MakeUnexpected(Failure{}); }
    [[nodiscard]] b8 resetFallbackChar()noexcept{ return false; }


public:
