type IntegerModelTests = NumericModelFixture<IntegerEditModel>;
const StringView s_UiListScrollbarPanelKey = "panel";
const StringView s_UiListScrollbarListKey = "list";
const StringView s_UiListScrollbarPopupKey = "popup";
const StringView s_UiListScrollbarUpperPopupKey = "upper";
const StringView s_UiListScrollbarKey = "scrollbar";

class UiInputBindingsTests{
    public InputBindings m_bindings;

    public usize bindingsDataAddress()const{ return TestDataAddress(this.m_bindings.bindings()); }
    public b8 setSingle(in InputKeyBinding binding){ return this.m_bindings.set(Array<InputKeyBinding, 1u>(binding)); }
    public b8 setSpan(in Span<InputKeyBinding> bindings){
        return this.m_bindings.set(bindings);
    }
    public b8 setCount(in Span<InputKeyBinding> bindings, in usize count){
        return this.m_bindings.set(bindings.subspan(0u, count));
    }
    public b8 setEmpty(){ return this.m_bindings.set(Span<InputKeyBinding>()); }
    public b8 setAliasedSlice(in usize offset, in usize count){ return this.m_bindings.set(this.m_bindings.bindings().subspan(offset, count)); }
}


class UiInputTests : RouterTestFixture{


    public void tab(){ this.tab(false); }
    public void tab(in b8 reverse){
        this.key(Key::Tab, reverse);
    }
    public b8 commitSingle(in HitTarget target, in u64 generation){ return this.m_router.commitTargets(MakeUiSingleHitTargetArray(target), generation, Span<PopupScope>(), u64.max); }
    public b8 commitSpan(in Span<HitTarget> targets, in u64 generation){
        return this.m_router.commitTargets(targets, generation, Span<PopupScope>(), u64.max);
    }
    public b8 commitEmpty(in u64 generation){ return this.m_router.commitTargets(Span<HitTarget>(), generation, Span<PopupScope>(), u64.max); }
    public b8 commitOverflowSingle(in HitTarget target, in usize overflowCount, in u64 generation){
        Vector<HitTarget> targets;
        targets.resize(overflowCount, target);
        return this.m_router.commitTargets(targets, generation, Span<PopupScope>(), u64.max);
    }
    public b8 commitOverflowSpan(in Span<HitTarget> targets, in u64 generation){
        Vector<HitTarget> oversized;
        oversized.reserve(targets.size() + 1u);
        for(in HitTarget target : targets)
            oversized.push_back(target);
        oversized.push_back(HitTarget());
        return this.m_router.commitTargets(oversized, generation, Span<PopupScope>(), u64.max);
    }
    public usize findTargetAddress(in WidgetId id)const{ return this.findTargetAddress(id, 0u); }
    public usize findTargetAddress(in WidgetId id, in u64 declarationGeneration)const{
        const auto found = this.m_router.findTarget(id, declarationGeneration);
        if(found.has_value())
            return TestValueAddress<HitTarget>(found.value());
        return 0u;
    }
    public usize targetEntryAddress(in usize index)const{ return TestValueAddress<HitTarget>(this.m_router.targets()[index]); }
    public Optional<HitTarget> findTargetCopy(in WidgetId id)const{ return this.findTargetCopy(id, 0u); }
    public Optional<HitTarget> findTargetCopy(in WidgetId id, in u64 declarationGeneration)const{
        const auto found = this.m_router.findTarget(id, declarationGeneration);
        if(found.has_value())
            return Optional<HitTarget>(found.value());
        return Optional<HitTarget>();
    }
    public b8 queueNative(in InputEvent event){
        return this.m_router.queue(NativeInput(event)).has_value();
    }
}


class UiLayoutTests{
    public LayoutTree m_tree;

    public Expected<u32> add(in u32 parent, in LayoutNodeDesc description){
        return this.m_tree.addNode(parent, description);
    }
    public usize boxAddress(in u32 index)const{ return UiLayoutTreeBoxAddress(this.m_tree, index); }
    public Optional<LayoutBox> boxCopy(in u32 index)const{
        return this.m_tree.box(index);
    }
}

usize UiLayoutTreeBoxAddress(in LayoutTree tree, in u32 index){
    if(index < tree.boxes().size())
        return TestValueAddress<LayoutBox>(tree.boxes()[index]);
    return 0u;
}
void ExpectUiIntegerModelRejected(in NumericEditResult result){ ExpectNumericEditRejected(result, false); }
void ExpectUiIntegerModelRejected(in NumericEditResult result, in b8 restored){ ExpectNumericEditRejected(result, restored); }


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


InputKeyBinding MakeUiInputKeyBinding(in i32 key, in i32 modifiers, in i32 ignoredModifiers, in InputCommand command){
    InputKeyBinding binding = InputKeyBinding();
    binding.key = key;
    binding.modifiers = modifiers;
    binding.ignoredModifiers = ignoredModifiers;
    binding.command = command;
    return binding;
}

HitTarget MakeUiInputTargetAt(in u64 value, in Rect rectangle){
    HitTarget target = HitTarget();
    target.id = WidgetId(value);
    target.rectangle = rectangle;
    target.clip = Rect(0.0f, 0.0f, 100.0f, 100.0f);
    target.focusable = true;
    target.activatable = true;
    return target;
}

HitTarget MakeUiInputTarget(in u64 value){
    return MakeUiInputTargetAt(value, Rect(10.0f, 10.0f, 20.0f, 20.0f));
}

InputEvent MakeUiInputPointer(in InputEventType type){
    return MakeUiPointerEvent(type, Point(15.0f, 15.0f));
}

InputEvent MakeUiInputKey(in InputEventType type, in Key key, in b8 repeat){
    InputEvent event = InputEvent();
    event.type = type;
    event.key = key;
    event.repeat = repeat;
    return event;
}

LayoutNodeDesc MakeUiLayoutStretchContainer(in LayoutDirection direction){
    LayoutNodeDesc description = LayoutNodeDesc();
    description.direction = direction;
    description.width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    description.height = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    return description;
}

LayoutNodeDesc MakeUiLayoutFixedLeaf(in f32 width, in f32 height){
    LayoutNodeDesc description = LayoutNodeDesc();
    description.width = LayoutSize(LayoutSizePolicy::Fixed, width);
    description.height = LayoutSize(LayoutSizePolicy::Fixed, height);
    return description;
}

ListResult MakeUiListBehaviorResult(in b8 valid, in b8 selectionChanged, in b8 activated, in b8 focused){
    ListResult result = ListResult();
    result.valid = valid;
    result.selectionChanged = selectionChanged;
    result.activated = activated;
    result.focused = focused;
    return result;
}


