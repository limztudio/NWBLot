[[nodiscard]] FOUNDATION_INLINE EditBoxView CreateBenchmarkEditBoxView()noexcept{
    return EditBoxView(ActiveBenchmarkArena());
}

[[nodiscard]] FOUNDATION_INLINE DrawSnapshot CreateBenchmarkDrawSnapshot()noexcept{
    return DrawSnapshot(ActiveBenchmarkArena());
}

[[nodiscard]] FOUNDATION_INLINE HitTargetVector CreateBenchmarkHitTargetVector()noexcept{
    return HitTargetVector(ActiveBenchmarkArena());
}

FOUNDATION_INLINE void WriteUiBenchmarkStdout(const AStringView text){
    FOUNDATION_COUT << text;
}

FOUNDATION_INLINE b8 AdoptBuiltTextLayout(TextLayoutBuilder& layoutBuilder, const ShapeRequest& request, EditBoxView& view){
    auto layout = layoutBuilder.layout(request);
    return layout && view.adoptLayout(*layout);
}

FOUNDATION_INLINE b8 TryDeclareEditBoxWidget(Context& context, const AStringView id, WidgetState& outWidget){
    const auto widget = context.declare(id, WidgetKind::EditBox);
    if(!widget)
        return false;
    outWidget = **widget;
    return true;
}

FOUNDATION_INLINE b8 HasCommittedTargetWithWidth(const Context& context, const WidgetId id, const u64 declarationGeneration, const f32 expectedWidth){
    const auto target = context.input().findTarget(id, declarationGeneration);
    return target && (*target)->rectangle.width == expectedWidth;
}
};


