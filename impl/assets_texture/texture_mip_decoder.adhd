////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_texture/loader.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize ComputeUastcBlockByteOffset(in u32 blockX, in u32 blockY, in u32 blockCountX){
    const u64 blockIndex = cast<u64>(blockY) * cast<u64>(blockCountX) + cast<u64>(blockX);
    return cast<usize>(blockIndex * s_TextureUastcBytesPerBlock);
}

usize ComputeDecodedUastcDestinationTexelIndex(
    in u64 destinationX,
    in u64 destinationY,
    in u32 mipWidth
){
    return cast<usize>(destinationY * cast<u64>(mipWidth) + destinationX);
}

f32 NormalizeTextureAlphaUnorm8(in u8 alphaUnorm8){
    const VectorSingle normalized = VectorSingle(cast<f32>(alphaUnorm8)) / VectorSingle(cast<f32>(u8.max));
    return normalized.x;
}

u8 ResolveHdrUniformAlphaUnorm8(in b8 isConstantUnorm8, in u8 alphaConstantUnorm8){
    if(isConstantUnorm8)
        return alphaConstantUnorm8;
    return u8.max;
}

b8 ValidateAstcSliceByteCount(in b8 hasSource, in u64 sourceBytes, in usize uploadBytes){
    if(hasSource && sourceBytes == cast<u64>(uploadBytes))
        return true;

    error("TextureAssetLoader: ASTC UASTC slice size is invalid");
    return false;
}

b8 ValidateRgba8SliceLayout(in b8 hasSource, in usize expectedBytes, in usize uploadBytes){
    if(hasSource && expectedBytes == uploadBytes)
        return true;

    error("TextureAssetLoader: invalid RGBA8 UASTC slice layout");
    return false;
}

b8 ValidateSupportedLdrTextureUploadFormat(in b8 isSupported){
    if(isSupported)
        return true;

    error("TextureAssetLoader: unsupported linear LDR texture upload format");
    return false;
}

b8 ValidateSupportedHdrTextureUploadFormat(in b8 isSupported){
    if(isSupported)
        return true;

    error("TextureAssetLoader: unsupported HDR texture upload format");
    return false;
}

void LogUnsupportedTexturePayloadFormat(){
    error("TextureAssetLoader: unsupported texture payload format");
}

void LogUastcTranscodeFailure(in StringView message){
    error("TextureAssetLoader: {}", message);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

