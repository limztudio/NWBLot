// Finite infinity for CPU BVH bounds.
const f32 s_RayTracingFiniteInfinity = 1e30f;
const u32 s_RayTracingTriangleIndexCount = 3u;
const u32 s_RayTracingAllInstanceMask = 0xFFu;
// Heap geometry buffers per mesh.
const u32 s_HardwareRayTracingMeshBufferCount = 3u;
const u32 s_SoftwareRayTracingMeshBufferCount = 4u;

// Limit skinned BLAS refits before rebuilding topology.
const u32 s_BlasMaxRefitsBeforeRebuild = 8u;
// Scale rebuild cadence by mesh size, clamped to preserve quality.
const u32 s_BlasMinRefitsBeforeRebuild = 4u;
const u32 s_BlasMaxRefitsBeforeRebuildCap = 64u;
const u32 s_BlasRefitBudgetLog2ExponentStep = 3u;

// Cube-root-scaled refit budget.
u32 AdaptiveRefitsBeforeRebuild(in u32 primitiveCount){
    u32 log2Val = 0u;
    u32 n = primitiveCount;
    while(n > 1u){
        n >>= 1u;
        ++log2Val;
    }
    u32 budget = s_BlasMaxRefitsBeforeRebuild << (log2Val / s_BlasRefitBudgetLog2ExponentStep);
    if(budget < s_BlasMinRefitsBeforeRebuild){
        budget = s_BlasMinRefitsBeforeRebuild;
    }
    if(budget > s_BlasMaxRefitsBeforeRebuildCap){
        budget = s_BlasMaxRefitsBeforeRebuildCap;
    }
    return budget;
}

