namespace UiListTests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace Impl;
using namespace Impl::Ui;
using namespace UiWidgetTests;

inline constexpr AStringView s_PanelKey = "panel";
inline constexpr AStringView s_ListKey = "list";
inline constexpr AStringView s_PopupKey = "popup";
inline constexpr AStringView s_UpperPopupKey = "upper";
inline constexpr AStringView s_RowsKey = "rows";
inline constexpr AStringView s_ScrollbarKey = "scrollbar";
inline constexpr AStringView s_FirstRowText = "Ax";


// Arithmetic list source that computes rows on demand without allocating per row.
class ArithmeticSource final : public IListDataSource{
public:
    virtual ~ArithmeticSource()noexcept override = default;


public:
    [[nodiscard]] virtual u64 instanceGeneration()const noexcept override{ invalidateText(); return generation; }
    [[nodiscard]] virtual u64 revision()const noexcept override{ invalidateText(); return contentRevision; }
    [[nodiscard]] virtual u64 rowCount()const noexcept override{ invalidateText(); return count; }
    [[nodiscard]] virtual u64 key(const u64 index)const noexcept override{
        invalidateText();
        ++keyCalls;
        return duplicate ? 1u : rawKey(index);
    }
    [[nodiscard]] virtual Expected<u64> indexOf(const u64 value)const noexcept override{
        invalidateText();
        ++lookupCalls;
        if(malformedLookup)
            return count;
        return UiWidgetTests::FindArithmeticFixtureRowIndex(count, removed, reverse, value);
    }
    [[nodiscard]] virtual Expected<u64> findEnabled(const u64 start, const b8 backwards)const noexcept override{
        invalidateText();
        return UiWidgetTests::FindSingleDisabledFixtureRow(count, removed, reverse, start, backwards, disabled);
    }
    [[nodiscard]] virtual StringView text(u64 index)const noexcept override;
    [[nodiscard]] virtual b8 enabled(const u64 index)const noexcept override{
        invalidateText();
        return rawKey(index) != disabled;
    }


private:
    [[nodiscard]] u64 rawKey(const u64 index)const noexcept{
        return UiWidgetTests::ArithmeticFixtureRowKey(count, removed, reverse, index);
    }
    void invalidateText()const noexcept{ temporary.fill('?'); }


public:
    u64 count = 100000u;
    u64 generation = 301u;
    u64 contentRevision = 1u;
    u64 removed = 0u;
    u64 disabled = 0u;
    u64 specialIndex = Limit<u64>::s_Max;
    StringView specialText = "A\xCC\x81\xCC\x81 g\xCC\xA3\nPrevious\nNext";
    mutable u64 keyCalls = 0u;
    mutable u64 lookupCalls = 0u;
    mutable u64 textCalls = 0u;
    mutable Array<u64, 32u> textCallsByIndex{};
    b8 reverse = false;
    b8 duplicate = false;
    b8 malformedLookup = false;
    mutable Array<char, 128u> temporary{};
};

[[nodiscard]] ListOptions Options()noexcept;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiListBuilderTests : public WidgetFixture{
public:
    [[nodiscard]] b8 prepare(const u64 generation, const ListOptions& options = Options()){
        return prepareSource(generation, m_source, m_state, options);
    }
    [[nodiscard]] b8 prepareSource(u64 generation, const IListDataSource& source, ListState& state, const ListOptions& options = Options(), const DisplayMetrics& display = { 800.0f, 600.0f, 1.0f, 1.0f });
    [[nodiscard]] b8 accept(const u64 generation, const ListOptions& options = Options()){
        return prepare(generation, options) && m_context.commitFrame(generation);
    }
    [[nodiscard]] b8 preparePopups(u64 generation, PopupState& lowerPopup, ListState& lowerState, PopupState* upperPopup = nullptr, ListState* upperState = nullptr);
    [[nodiscard]] WidgetId row(const u64 key)const{
        return UiTestSupport::RequireWidgetPartId(UiTestSupport::RequireWidgetId(id(s_ListKey, s_PanelKey), s_RowsKey), key);
    }
    [[nodiscard]] b8 wheel(f64 delta = -1.0);


public:
    ArithmeticSource m_source;
    ListState m_state;
    ListResult m_result;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_END

namespace __hidden_ui_glyph_sdf_tests{
using ComboSource = ::NWB::UiComboTests::ComboSource;
using ComboFixture = ::NWB::UiComboTests::ComboFixture;
using ArithmeticSource = ::NWB::UiListTests::ArithmeticSource;
using UiListBuilderTests = ::NWB::UiListTests::UiListBuilderTests;
using ::NWB::UiComboTests::s_ComboPanelKey;
using ::NWB::UiComboTests::s_ComboKey;

ComboOptions MakeComboFixtureOptions()noexcept;
ListOptions MakeListFixtureOptions()noexcept;
ControlAction MakeUiListControlAction(u64 instanceGeneration, u64 contentGeneration, u64 contentRevision, const ControlActionKindEnum& kind)noexcept;
void ExpectUiListResult(const ListResult& actual, const ListResult& expected)noexcept;
void ResetComboSourceCounters(ComboSource& self)noexcept;
b8 DeclareComboFixtureSource(ComboFixture& self, u64 generation, const IListDataSource& source, ComboState& state, const ComboOptions& options, const Rect& bounds)noexcept;
b8 OpenComboFixtureByPointer(ComboFixture& self, u64 generation)noexcept;
StringView FormatArithmeticSourceText(ArithmeticSource& self, u64 index)noexcept;
b8 PrepareUiListFixtureSource(UiListBuilderTests& self, u64 generation, const IListDataSource& source, ListState& state, const ListOptions& options, const DisplayMetrics& display)noexcept;
b8 PrepareUiListFixtureLowerPopup(UiListBuilderTests& self, u64 generation, PopupState& lowerPopup, ListState& lowerState)noexcept;
b8 PrepareUiListFixtureTwoPopups(UiListBuilderTests& self, u64 generation, PopupState& lowerPopup, ListState& lowerState, PopupState& upperPopup, ListState& upperState)noexcept;
b8 SendUiListFixtureWheel(UiListBuilderTests& self, f64 delta)noexcept;
};

NWB_BEGIN
namespace UiComboTests{
NWB_INLINE void ComboSource::resetCounters()const noexcept{ ::__hidden_ui_glyph_sdf_tests::ResetComboSourceCounters(const_cast<ComboSource&>(*this)); }
NWB_INLINE ComboOptions Options()noexcept{ return ::__hidden_ui_glyph_sdf_tests::MakeComboFixtureOptions(); }
NWB_INLINE b8 ComboFixture::declareSource(const u64 generation, const IListDataSource& source, ComboState& state, const ComboOptions& options, const Rect& bounds){
    return ::__hidden_ui_glyph_sdf_tests::DeclareComboFixtureSource(*this, generation, source, state, options, bounds);
}
NWB_INLINE b8 ComboFixture::openByPointer(const u64 generation){ return ::__hidden_ui_glyph_sdf_tests::OpenComboFixtureByPointer(*this, generation); }
};
namespace UiListTests{
NWB_INLINE StringView ArithmeticSource::text(const u64 index)const noexcept{ return ::__hidden_ui_glyph_sdf_tests::FormatArithmeticSourceText(const_cast<ArithmeticSource&>(*this), index); }
NWB_INLINE ListOptions Options()noexcept{ return ::__hidden_ui_glyph_sdf_tests::MakeListFixtureOptions(); }
NWB_INLINE b8 UiListBuilderTests::prepareSource(const u64 generation, const IListDataSource& source, ListState& state, const ListOptions& options, const DisplayMetrics& display){
    return ::__hidden_ui_glyph_sdf_tests::PrepareUiListFixtureSource(*this, generation, source, state, options, display);
}
NWB_INLINE b8 UiListBuilderTests::preparePopups(const u64 generation, PopupState& lowerPopup, ListState& lowerState, PopupState* upperPopup, ListState* upperState){
    if(upperPopup && upperState)
        return ::__hidden_ui_glyph_sdf_tests::PrepareUiListFixtureTwoPopups(*this, generation, lowerPopup, lowerState, *upperPopup, *upperState);
    return ::__hidden_ui_glyph_sdf_tests::PrepareUiListFixtureLowerPopup(*this, generation, lowerPopup, lowerState);
}
NWB_INLINE b8 UiListBuilderTests::wheel(const f64 delta){ return ::__hidden_ui_glyph_sdf_tests::SendUiListFixtureWheel(*this, delta); }
};
NWB_END

namespace UiListBehaviorTestSupport{
NWB_INLINE ControlAction Action(const ListState& state, const RangeSource& source, const ControlActionKind::Enum kind)noexcept{
    return ::__hidden_ui_glyph_sdf_tests::MakeUiListControlAction(state.inputGeneration(), source.instanceGeneration(), source.revision(), kind);
}
NWB_INLINE void ExpectResult(const ListResult& actual, const ListResult& expected){
    ::__hidden_ui_glyph_sdf_tests::ExpectUiListResult(actual, expected);
}
};


