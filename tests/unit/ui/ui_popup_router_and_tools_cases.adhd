void VerifyUiPopupToolsBuilderTests_OneMenuStateCannotOwnTwoAttachmentsInTheSameFrame(mut UiPopupToolsBuilderTests self){
    ASSERT_TRUE(self.declareTools(1u, false));
    EXPECT_FALSE(self.m_builder.button("second", "Second", self.m_anchorOptions));
    const ContextMenuResult second = self.m_builder.contextMenu("other", "second", self.m_source, self.m_menu, self.m_menuOptions);
    EXPECT_FALSE(second.valid);
    EXPECT_TRUE(self.m_context.failed());
}

