////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_name("::NWB::Impl::RendererRayTracingSystem")]
extern class RendererRayTracingSystem;


[modular]
class PreparedSceneSwBvhTraversal : NoCopy{
    private mut RendererRayTracingSystem m_owner;
    private Vector<PreparedSceneSwBvhMesh> m_preparedSceneSwBvhMeshes;
    private u64 m_preparedSceneSwBvhRendererMutationVersion = 0u;
    private u64 m_preparedSceneSwBvhTransformMutationVersion = 0u;
    private u64 m_preparedSceneSwBvhMaterialMutationVersion = 0u;
    private u32 m_preparedSceneSwBvhInstanceCount = 0u;
    private b8 m_preparedSceneSwBvhReady = false;

    public PreparedSceneSwBvhTraversal(mut RendererRayTracingSystem owner){
        this.m_owner = owner;
    }

    public b8 capture(in Span<PreparedSceneSwBvhMesh> meshes, in u32 instanceCount);
    public b8 record();
    public void clear(){
        this.m_preparedSceneSwBvhMeshes.clear();
        this.m_preparedSceneSwBvhInstanceCount = 0u;
        this.m_preparedSceneSwBvhRendererMutationVersion = 0u;
        this.m_preparedSceneSwBvhTransformMutationVersion = 0u;
        this.m_preparedSceneSwBvhMaterialMutationVersion = 0u;
        this.m_preparedSceneSwBvhReady = false;
    }
    public b8 ready()const{ return this.m_preparedSceneSwBvhReady; }
}


