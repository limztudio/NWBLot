////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_MESH_GBUFFER_PS_SLANGI
#define NWB_GRAPHICS_MESH_GBUFFER_PS_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "gbuffer_io.slangi"
#include "surface.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Engine-owned G-buffer PS entry: the engine owns entry + target writes; each material provides only nwbMaterialSurface(). Materials never touch targets or model-id packing.
NwbMeshGBufferOutput main(NwbMeshPixelInput input){
    nwbLoadMeshPixelInput(input, nwbMeshCameraToSurfaceDirection(input.worldPosition.xyz));

    const NwbMeshSurface surface = nwbMaterialSurface();
    nwbWriteMeshGBufferParams(surface.baseColor, surface.normal, inWorldPosition, surface.param0, surface.param1, nwbPackMeshSurfaceReflection(surface.specularF0, surface.perceptualRoughness));

    return nwbBuildMeshGBufferOutput();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

