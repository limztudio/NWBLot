void VerifyUiInputTests_AcceptedTargetLookupPreservesCommittedGeometryAcrossFailureRetirementAndReset(mut UiInputTests self){
    Array<HitTarget, 3u> initial = Array<HitTarget, 3u>();
    initial[0u] = MakeUiInputTarget(50u);
    initial[1u] = MakeUiInputTarget(10u);
    initial[2u] = MakeUiInputTarget(90u);
    ASSERT_TRUE(self.commitSpan(initial, 1u));
    EXPECT_EQ(self.findTargetAddress(WidgetId()), 0u);
    EXPECT_EQ(self.findTargetAddress(WidgetId(20u)), 0u);
    EXPECT_EQ(self.findTargetAddress(WidgetId(10u), initial[1u].declarationGeneration + 1u), 0u);
    const usize acceptedAddress = self.findTargetAddress(WidgetId(10u), initial[1u].declarationGeneration);
    ASSERT_NE(acceptedAddress, 0u);
    EXPECT_EQ(acceptedAddress, self.targetEntryAddress(1u));

    Array<HitTarget, 2u> duplicate = Array<HitTarget, 2u>();
    duplicate[0u] = MakeUiInputTarget(70u);
    duplicate[1u] = MakeUiInputTarget(70u);
    duplicate[0u].rectangle.x = 40.0f;
    EXPECT_FALSE(self.commitSpan(duplicate, 2u));
    EXPECT_EQ(self.findTargetAddress(WidgetId(10u)), acceptedAddress);
    EXPECT_EQ(self.findTargetAddress(WidgetId(70u)), 0u);
    const Optional<HitTarget> acceptedCopy = self.findTargetCopy(WidgetId(10u));
    ASSERT_TRUE(acceptedCopy.has_value());
    EXPECT_FLOAT_EQ(acceptedCopy.value().rectangle.x, initial[1u].rectangle.x);

    self.m_router.invalidateTarget(WidgetId(50u));
    EXPECT_EQ(self.findTargetAddress(WidgetId(50u)), 0u);
    ASSERT_NE(self.findTargetAddress(WidgetId(10u)), 0u);
    EXPECT_EQ(self.findTargetAddress(WidgetId(10u)), self.targetEntryAddress(0u));
    ASSERT_NE(self.findTargetAddress(WidgetId(90u)), 0u);
    EXPECT_EQ(self.findTargetAddress(WidgetId(90u)), self.targetEntryAddress(1u));

    HitTarget replacement = MakeUiInputTarget(10u);
    replacement.declarationGeneration = initial[1u].declarationGeneration + 1u;
    replacement.rectangle.x = 60.0f;
    ASSERT_TRUE(self.commitSingle(replacement, 2u));
    EXPECT_EQ(self.findTargetAddress(WidgetId(10u), initial[1u].declarationGeneration), 0u);
    ASSERT_NE(self.findTargetAddress(WidgetId(10u), replacement.declarationGeneration), 0u);
    const Optional<HitTarget> replacedCopy = self.findTargetCopy(WidgetId(10u));
    ASSERT_TRUE(replacedCopy.has_value());
    EXPECT_FLOAT_EQ(replacedCopy.value().rectangle.x, 60.0f);
    EXPECT_EQ(self.findTargetAddress(WidgetId(90u)), 0u);
    self.m_router.reset();
    EXPECT_EQ(self.findTargetAddress(WidgetId(10u)), 0u);
}

void VerifyUiInputTests_AbsentTargetInvalidationPreservesLiveFocusCaptureHoverAndQueuedActions(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 7u));
    self.click();
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    const u64 actionSequence = self.m_router.actions()[0u].id.sequence;
    ASSERT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    const u64 hoverActivity = self.m_router.hoverActivityGeneration();
    self.m_router.invalidateTarget(WidgetId(999u));
    self.m_router.invalidateTarget(WidgetId());
    EXPECT_EQ(self.m_router.layoutGeneration(), 7u);
    EXPECT_EQ(self.m_router.targets().size(), 1u);
    EXPECT_EQ(self.m_router.focus(), target.id);
    EXPECT_EQ(self.m_router.capture(), target.id);
    EXPECT_EQ(self.m_router.hover(), target.id);
    EXPECT_EQ(self.m_router.hoverActivityGeneration(), hoverActivity);
    EXPECT_TRUE(self.m_router.primaryDown());
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_EQ(self.m_router.actions()[0u].id.sequence, actionSequence);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
}

void VerifyUiInputTests_FirstClickConsumesBeforeFocusExistsAndActivationIsNotReplayed(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 7u));
    EXPECT_FALSE(self.m_router.focus().valid());
    const InputRoutingResult pressed = self.send(MakeUiInputPointer(InputEventType::PrimaryDown));
    EXPECT_TRUE(pressed.pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    const InputRoutingResult released = self.send(MakeUiInputPointer(InputEventType::PrimaryUp));
    EXPECT_TRUE(released.pointerConsumed);
    EXPECT_FALSE(released.capture.valid());
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    const InputAction action = self.m_router.actions()[0u];
    EXPECT_FALSE(self.m_router.process().pointerConsumed);
    EXPECT_EQ(self.m_router.actions()[0u].id.sequence, action.id.sequence);
    EXPECT_FALSE(self.commitSingle(target, 7u));
    EXPECT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.m_router.actions().empty());
}

void VerifyUiInputTests_HitTestRespectsPaintOrderClippingDisabledTargetsAndHalfOpenBounds(mut UiInputTests self){
    Array<HitTarget, 4u> targets = Array<HitTarget, 4u>();
    targets[0u] = MakeUiInputTarget(1u);
    targets[1u] = MakeUiInputTarget(2u);
    targets[2u] = MakeUiInputTarget(3u);
    targets[3u] = MakeUiInputTarget(4u);
    for(usize index = 0u; index < 4u; ++index){
        targets[index].rectangle = Rect(0.0f, 0.0f, 100.0f, 100.0f);
    }
    targets[0u].paintOrder = 20u;
    targets[0u].clip = Rect(40.0f, 40.0f, 20.0f, 20.0f);
    targets[1u].paintOrder = 1u;
    targets[2u].paintOrder = 100u;
    targets[2u].enabled = false;
    targets[3u].paintOrder = 20u;
    targets[3u].clip = Rect(45.0f, 45.0f, 5.0f, 5.0f);
    ASSERT_TRUE(self.commitSpan(targets, 1u));
    EXPECT_EQ(self.m_router.hitTest(Point(40.0f, 40.0f)).value, 1u);
    EXPECT_EQ(self.m_router.hitTest(Point(45.0f, 45.0f)).value, 4u);
    EXPECT_EQ(self.m_router.hitTest(Point(50.0f, 50.0f)).value, 1u);
    EXPECT_EQ(self.m_router.hitTest(Point(60.0f, 60.0f)).value, 2u);
    EXPECT_EQ(self.m_router.hitTest(Point(10.0f, 10.0f)).value, 2u);
    EXPECT_FALSE(self.m_router.hitTest(Point(100.0f, 10.0f)).valid());
    EXPECT_FALSE(self.m_router.hitTest(Point(bit_cast<f32>(0x7fc00000u), 0.0f)).valid());
    EXPECT_TRUE(self.m_router.wouldConsumePointer(Point(45.0f, 45.0f)));
    EXPECT_FALSE(self.m_router.wouldConsumePointer(Point(-1.0f, -1.0f)));
}

void VerifyUiInputTests_TransientHoverDepartureAndReentryAdvanceActivityBeforeTheNextPaint(mut UiInputTests self){
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = MakeUiInputTarget(1u);
    targets[1u] = MakeUiInputTargetAt(2u, Rect(40.0f, 10.0f, 20.0f, 20.0f));
    ASSERT_TRUE(self.commitSpan(targets, 1u));
    ASSERT_EQ(self.send(MakeUiInputPointer(InputEventType::PointerMove)).hover, targets[0u].id);
    const u64 stable = self.m_router.hoverActivityGeneration();
    ASSERT_EQ(self.send(MakeUiPointerEvent(InputEventType::PointerMove, Point(16.0f, 16.0f))).hover, targets[0u].id);
    EXPECT_EQ(self.m_router.hoverActivityGeneration(), stable);
    ASSERT_TRUE(self.commitSpan(targets, 2u));
    EXPECT_EQ(self.m_router.hoverActivityGeneration(), stable);
    EXPECT_FALSE(self.commitSpan(targets, 2u));
    EXPECT_EQ(self.m_router.hoverActivityGeneration(), stable);

    ASSERT_TRUE(self.queueNative(MakeUiPointerEvent(InputEventType::PointerMove, Point(45.0f, 15.0f))));
    ASSERT_TRUE(self.queueNative(MakeUiInputPointer(InputEventType::PointerMove)));
    EXPECT_EQ(self.m_router.process().hover, targets[0u].id);
    const u64 returned = self.m_router.hoverActivityGeneration();
    EXPECT_GT(returned, stable);

    ASSERT_TRUE(self.queueNative(MakeUiBareInputEvent(InputEventType::PointerLeave)));
    ASSERT_TRUE(self.queueNative(MakeUiInputPointer(InputEventType::PointerMove)));
    EXPECT_EQ(self.m_router.process().hover, targets[0u].id);
    EXPECT_GT(self.m_router.hoverActivityGeneration(), returned);
}

void VerifyUiInputTests_HoverActivityUsesTheControlHostLifetimeAcrossOwnedParts(mut UiInputTests self){
    Array<HitTarget, 3u> targets = Array<HitTarget, 3u>();
    targets[0u] = MakeUiInputTargetAt(1u, Rect(10.0f, 10.0f, 80.0f, 20.0f));
    targets[1u] = MakeUiInputTargetAt(2u, Rect(20.0f, 10.0f, 10.0f, 20.0f));
    targets[2u] = MakeUiInputTargetAt(3u, Rect(40.0f, 10.0f, 10.0f, 20.0f));
    targets[0u].control = ControlToken(11u, 12u, 13u);
    for(usize index = 1u; index < 3u; ++index){
        targets[index].owner = targets[0u].id;
        targets[index].ownerDeclarationGeneration = targets[0u].declarationGeneration;
        targets[index].control = targets[0u].control;
        targets[index].focusable = false;
        targets[index].paintOrder = cast<u32>(index);
    }
    ASSERT_TRUE(self.commitSpan(targets, 1u));
    ASSERT_EQ(self.send(MakeUiPointerEvent(InputEventType::PointerMove, Point(15.0f, 15.0f))).hover, targets[0u].id);
    const u64 ownerGeneration = self.m_router.hoverActivityGeneration();
    EXPECT_EQ(self.send(MakeUiPointerEvent(InputEventType::PointerMove, Point(25.0f, 15.0f))).hover, targets[1u].id);
    EXPECT_EQ(self.send(MakeUiPointerEvent(InputEventType::PointerMove, Point(45.0f, 15.0f))).hover, targets[2u].id);
    EXPECT_EQ(self.send(MakeUiPointerEvent(InputEventType::PointerMove, Point(80.0f, 15.0f))).hover, targets[0u].id);
    EXPECT_EQ(self.m_router.hoverActivityGeneration(), ownerGeneration);
    ASSERT_TRUE(self.commitSpan(targets, 2u));
    EXPECT_EQ(self.m_router.hoverActivityGeneration(), ownerGeneration);

    targets[0u].control.contentRevision = 14u;
    targets[1u].control = targets[0u].control;
    targets[2u].control = targets[0u].control;
    ASSERT_TRUE(self.commitSpan(targets, 3u));
    const u64 changedControl = self.m_router.hoverActivityGeneration();
    EXPECT_GT(changedControl, ownerGeneration);
    targets[0u].declarationGeneration = 2u;
    targets[1u].ownerDeclarationGeneration = 2u;
    targets[2u].ownerDeclarationGeneration = 2u;
    ASSERT_TRUE(self.commitSpan(targets, 4u));
    EXPECT_GT(self.m_router.hoverActivityGeneration(), changedControl);
}

void VerifyUiInputTests_PressCaptureLossFocusLossAndResetFenceHoverActivity(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    ASSERT_EQ(self.send(MakeUiInputPointer(InputEventType::PointerMove)).hover, target.id);
    u64 previous = self.m_router.hoverActivityGeneration();
    ASSERT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_GT(self.m_router.hoverActivityGeneration(), previous);
    previous = self.m_router.hoverActivityGeneration();
    ASSERT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_EQ(self.m_router.hoverActivityGeneration(), previous);

    ASSERT_TRUE(self.send(MakeUiInputPointer(InputEventType::SecondaryDown)).pointerConsumed);
    EXPECT_GT(self.m_router.hoverActivityGeneration(), previous);
    previous = self.m_router.hoverActivityGeneration();
    ASSERT_TRUE(self.send(MakeUiInputPointer(InputEventType::SecondaryUp)).pointerConsumed);
    EXPECT_EQ(self.m_router.hoverActivityGeneration(), previous);

    ASSERT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_GT(self.m_router.hoverActivityGeneration(), previous);
    previous = self.m_router.hoverActivityGeneration();
    self.send(MakeUiBareInputEvent(InputEventType::PointerCaptureLost));
    EXPECT_GT(self.m_router.hoverActivityGeneration(), previous);
    previous = self.m_router.hoverActivityGeneration();
    self.send(MakeUiBareInputEvent(InputEventType::FocusLost));
    self.m_router.cancelDeviceInput(0u);
    EXPECT_GT(self.m_router.hoverActivityGeneration(), previous);
    previous = self.m_router.hoverActivityGeneration();
    self.m_router.reset();
    EXPECT_GT(self.m_router.hoverActivityGeneration(), previous);
    previous = self.m_router.hoverActivityGeneration();
    ASSERT_TRUE(self.commitSingle(target, 1u));
    self.send(MakeUiBareInputEvent(InputEventType::FocusGained));
    EXPECT_EQ(self.send(MakeUiInputPointer(InputEventType::PointerMove)).hover, target.id);
    EXPECT_GT(self.m_router.hoverActivityGeneration(), previous);
}

void VerifyUiInputTests_DragOutsideDoesNotActivateAndRemovalKeepsReleaseConsumption(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    const InputRoutingResult moved = self.send(MakeUiPointerEvent(InputEventType::PointerMove, Point(90.0f, 90.0f)));
    EXPECT_TRUE(moved.pointerConsumed);
    EXPECT_FALSE(moved.hover.valid());
    EXPECT_EQ(moved.capture.value, 1u);
    EXPECT_TRUE(self.m_router.wouldConsumePointer(Point(90.0f, 90.0f)));
    EXPECT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PrimaryUp, Point(90.0f, 90.0f))).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    ASSERT_TRUE(self.commitEmpty(2u));
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_FALSE(self.m_router.focus().valid());
    const InputRoutingResult afterRemoval = self.send(MakeUiPointerEvent(InputEventType::PointerMove, Point(90.0f, 90.0f)));
    EXPECT_TRUE(afterRemoval.pointerConsumed);
    EXPECT_TRUE(afterRemoval.wantsPointer);
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.send(MakeUiInputPointer(InputEventType::PointerMove)).pointerConsumed);
    EXPECT_FALSE(self.m_router.wouldConsumePointer(Point(15.0f, 15.0f)));
}

void VerifyUiInputTests_PointerLeaveClearsHoverButPreservesLogicalCaptureAndReleaseOwnership(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PointerMove)).pointerConsumed);
    const InputRoutingResult hoveredLeave = self.send(MakeUiBareInputEvent(InputEventType::PointerLeave));
    EXPECT_FALSE(hoveredLeave.hover.valid());
    EXPECT_FALSE(hoveredLeave.wantsPointer);
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    const InputRoutingResult capturedLeave = self.send(MakeUiBareInputEvent(InputEventType::PointerLeave));
    EXPECT_TRUE(capturedLeave.pointerConsumed);
    EXPECT_TRUE(capturedLeave.wantsPointer);
    EXPECT_FALSE(capturedLeave.hover.valid());
    EXPECT_EQ(capturedLeave.capture.value, 1u);
    EXPECT_EQ(capturedLeave.focus.value, 1u);
    EXPECT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PrimaryUp, Point(90.0f, 90.0f))).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.capture().valid());
}

void VerifyUiInputTests_NewDeclarationAndDisabledTargetsCancelPendingStateAndActions(mut UiInputTests self){
    HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    self.click();
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    target.declarationGeneration = 2u;
    ASSERT_TRUE(self.commitSingle(target, 2u));
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    target.enabled = false;
    ASSERT_TRUE(self.commitSingle(target, 3u));
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.hitTest(Point(15.0f, 15.0f)).valid());
}

void VerifyUiInputTests_InvalidatedDeclarationPrunesActionsAndCaptureWithoutAdvancingLayout(mut UiInputTests self){
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = MakeUiInputTarget(1u);
    targets[1u] = MakeUiInputTargetAt(2u, Rect(40.0f, 10.0f, 20.0f, 20.0f));
    ASSERT_TRUE(self.commitSpan(targets, 7u));
    self.click();
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Space, false)).commandConsumed);
    self.m_router.invalidateTarget(targets[0u].id);
    EXPECT_EQ(self.m_router.layoutGeneration(), 7u);
    ASSERT_EQ(self.m_router.targets().size(), 1u);
    EXPECT_EQ(self.m_router.targets()[0u].id.value, 2u);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_FALSE(self.m_router.hitTest(Point(15.0f, 15.0f)).valid());
    EXPECT_EQ(self.m_router.hitTest(Point(45.0f, 15.0f)).value, 2u);
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, Key::Space, false)).commandConsumed);
}

void VerifyUiInputTests_PanelBlocksPointerAndClearsKeyboardFocusWithoutActivating(mut UiInputTests self){
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = MakeUiInputTarget(1u);
    targets[1u] = MakeUiInputTargetAt(2u, Rect(40.0f, 10.0f, 20.0f, 20.0f));
    targets[1u].focusable = false;
    targets[1u].activatable = false;
    ASSERT_TRUE(self.commitSpan(targets, 1u));
    self.click();
    ASSERT_EQ(self.m_router.focus().value, 1u);
    ASSERT_TRUE(self.m_router.consumeActivation(targets[0u].id));
    const InputRoutingResult panel = self.send(MakeUiPointerEvent(InputEventType::PrimaryDown, Point(45.0f, 15.0f)));
    EXPECT_TRUE(panel.pointerConsumed);
    EXPECT_FALSE(panel.focus.valid());
    EXPECT_EQ(panel.capture.value, 2u);
    EXPECT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PrimaryUp, Point(45.0f, 15.0f))).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Enter, false)).commandConsumed);
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyUp, Key::Enter, false)).commandConsumed);
}

void VerifyUiInputTests_TabOrderWrapsInBothDirectionsAndSkipsDisabledOrInvisibleTargets(mut UiInputTests self){
    Array<HitTarget, 5u> targets = Array<HitTarget, 5u>();
    targets[0u] = MakeUiInputTarget(1u);
    targets[1u] = MakeUiInputTarget(2u);
    targets[2u] = MakeUiInputTarget(3u);
    targets[3u] = MakeUiInputTarget(4u);
    targets[4u] = MakeUiInputTarget(5u);
    targets[1u].enabled = false;
    targets[2u].focusable = false;
    targets[3u].clip = Rect(90.0f, 90.0f, 10.0f, 10.0f);
    targets[0u].paintOrder = 100u;
    targets[4u].paintOrder = 0u;
    ASSERT_TRUE(self.commitSpan(targets, 1u));
    self.tab();
    EXPECT_EQ(self.m_router.focus().value, 1u);
    self.tab();
    EXPECT_EQ(self.m_router.focus().value, 5u);
    self.tab();
    EXPECT_EQ(self.m_router.focus().value, 1u);
    self.tab(true);
    EXPECT_EQ(self.m_router.focus().value, 5u);
    self.tab(true);
    EXPECT_EQ(self.m_router.focus().value, 1u);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Escape, false)).commandConsumed);
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, Key::Escape, false)).commandConsumed);
    self.tab(true);
    EXPECT_EQ(self.m_router.focus().value, 5u);
    ASSERT_TRUE(self.commitEmpty(2u));
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Tab, false)).commandConsumed);
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyUp, Key::Tab, false)).commandConsumed);
}

void VerifyUiInputTests_KeyboardActivationIgnoresNativeRepeatsAndDuplicateDowns(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    self.tab();
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Enter, false)).commandConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.m_router.pressed(target.id));
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Enter, true)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Enter, false)).commandConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.process().commandConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, Key::Enter, false)).commandConsumed);
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_EQ(self.m_router.actions()[0u].origin, InputActionSource::Command);
    EXPECT_FALSE(self.m_router.pressed(target.id));
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Enter, false)).commandConsumed);
    EXPECT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, Key::Enter, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Space, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, Key::Space, false)).commandConsumed);
    EXPECT_EQ(self.m_router.actions().size(), 3u);
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Space, true)).commandConsumed);
    EXPECT_EQ(self.m_router.actions().size(), 3u);
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyUp, Key::Space, false)).commandConsumed);
    ASSERT_TRUE(self.commitEmpty(2u));
    EXPECT_TRUE(self.m_router.actions().empty());
}

void VerifyUiInputTests_HeldUiKeysKeepReleaseOwnershipAfterFocusedTargetRemoval(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    self.tab();
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Space, false)).commandConsumed);
    ASSERT_TRUE(self.commitEmpty(2u));
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_TRUE(self.m_router.actions().empty());
    const InputRoutingResult repeated = self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Space, true));
    EXPECT_TRUE(repeated.commandConsumed);
    EXPECT_TRUE(repeated.wantsCommands);
    EXPECT_TRUE(self.m_router.actions().empty());
    const InputRoutingResult released = self.send(MakeUiInputKey(InputEventType::KeyUp, Key::Space, false));
    EXPECT_TRUE(released.commandConsumed);
    EXPECT_FALSE(released.wantsCommands);
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Space, false)).commandConsumed);
}

void VerifyUiInputTests_ClearingKeyboardFocusPreservesAcceptedActionsCaptureAndHeldReleaseOwnership(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    self.click();
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Space, false)).commandConsumed);
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_TRUE(self.m_router.ownsKey(Key::Space));
    EXPECT_FALSE(self.m_router.ownsKey(Key::Unknown));
    EXPECT_FALSE(self.m_router.ownsKey(Key::Menu + 1));
    self.m_router.clearFocus();
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_TRUE(self.m_router.ownsKey(Key::Space));
    EXPECT_EQ(self.m_router.capture().value, 1u);
    EXPECT_TRUE(self.m_router.primaryDown());
    EXPECT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, Key::Space, false)).commandConsumed);
    EXPECT_FALSE(self.m_router.ownsKey(Key::Space));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    ASSERT_EQ(self.m_router.actions().size(), 2u);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
}

void VerifyUiInputTests_NativeFocusTerminationAndResetDoNotReuseActionSequences(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    self.click();
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    const u64 firstSequence = self.m_router.actions()[0u].id.sequence;
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Space, false)).commandConsumed);
    const InputRoutingResult lost = self.send(MakeUiBareInputEvent(InputEventType::FocusLost));
    EXPECT_TRUE(lost.pointerConsumed);
    EXPECT_TRUE(lost.commandConsumed);
    EXPECT_TRUE(lost.wantsPointer);
    EXPECT_TRUE(lost.wantsCommands);
    EXPECT_FALSE(lost.hover.valid());
    EXPECT_FALSE(lost.focus.valid());
    EXPECT_FALSE(lost.capture.valid());
    EXPECT_TRUE(self.m_router.primaryDown());
    EXPECT_TRUE(self.m_router.ownsKey(Key::Space));
    EXPECT_TRUE(self.m_router.actions().empty());
    self.m_router.cancelDeviceInput(0u);
    EXPECT_FALSE(self.m_router.primaryDown());
    EXPECT_FALSE(self.m_router.ownsKey(Key::Space));
    EXPECT_FALSE(self.m_router.wantsPointer());
    EXPECT_FALSE(self.m_router.wantsCommands());
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyUp, Key::Space, false)).commandConsumed);
    EXPECT_FALSE(self.send(MakeUiPointerEvent(InputEventType::PrimaryUp, Point(90.0f, 90.0f))).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    ASSERT_TRUE(self.queueNative(MakeUiInputPointer(InputEventType::PrimaryDown)));
    self.m_router.reset();
    EXPECT_EQ(self.m_router.layoutGeneration(), 0u);
    EXPECT_TRUE(self.m_router.targets().empty());
    EXPECT_FALSE(self.m_router.process().pointerConsumed);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    EXPECT_FALSE(self.send(MakeUiPointerEvent(InputEventType::PrimaryUp, Point(90.0f, 90.0f))).pointerConsumed);
    self.send(MakeUiBareInputEvent(InputEventType::FocusGained));
    self.click();
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_GT(self.m_router.actions()[0u].id.sequence, firstSequence);
}

void VerifyUiInputTests_EventsUseCommittedTargetsAndScenePressCannotTransferToNewLayout(mut UiInputTests self){
    const HitTarget oldTarget = MakeUiInputTarget(1u);
    HitTarget nextTarget = MakeUiInputTargetAt(2u, Rect(40.0f, 10.0f, 20.0f, 20.0f));
    ASSERT_TRUE(self.commitSingle(oldTarget, 1u));
    EXPECT_FALSE(self.m_router.hitTest(Point(45.0f, 15.0f)).valid());
    EXPECT_FALSE(self.send(MakeUiPointerEvent(InputEventType::PrimaryDown, Point(45.0f, 15.0f))).pointerConsumed);
    ASSERT_TRUE(self.commitSingle(nextTarget, 2u));
    EXPECT_EQ(self.m_router.hitTest(Point(45.0f, 15.0f)).value, 2u);
    EXPECT_FALSE(self.send(MakeUiPointerEvent(InputEventType::PrimaryUp, Point(45.0f, 15.0f))).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    self.click(Point(45.0f, 15.0f));
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_EQ(self.m_router.actions()[0u].id.target.value, 2u);
    EXPECT_EQ(self.m_router.actions()[0u].id.layoutGeneration, 2u);
    nextTarget.rectangle.x = 60.0f;
    ASSERT_TRUE(self.commitSingle(nextTarget, 3u));
    EXPECT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_TRUE(self.m_router.consumeActivation(nextTarget.id));
}

void VerifyUiInputTests_InvalidTargetPublicationPreservesAcceptedLayoutCaptureAndFocus(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    Array<HitTarget, 2u> invalid = Array<HitTarget, 2u>();
    invalid[0u] = MakeUiInputTarget(2u);
    invalid[1u] = MakeUiInputTarget(2u);
    EXPECT_FALSE(self.commitSpan(invalid, 2u));
    invalid[1u].id.value = 3u;
    invalid[1u].rectangle.width = -1.0f;
    EXPECT_FALSE(self.commitSpan(invalid, 2u));
    invalid[1u].rectangle.width = bit_cast<f32>(0x7f800000u);
    EXPECT_FALSE(self.commitSpan(invalid, 2u));
    invalid[1u].rectangle = Rect(0.0f, 0.0f, 1.0f, 1.0f);
    invalid[1u].declarationGeneration = 0u;
    EXPECT_FALSE(self.commitSpan(invalid, 2u));
    invalid[1u].declarationGeneration = 1u;
    invalid[1u].id.value = 0u;
    EXPECT_FALSE(self.commitSpan(invalid, 2u));
    EXPECT_FALSE(self.commitOverflowSingle(target, s_InputMaxTargets + 1u, 2u));
    EXPECT_FALSE(self.commitSingle(target, 0u));
    EXPECT_FALSE(self.commitSingle(target, 1u));
    EXPECT_EQ(self.m_router.layoutGeneration(), 1u);
    ASSERT_EQ(self.m_router.targets().size(), 1u);
    EXPECT_EQ(self.m_router.focus().value, 1u);
    EXPECT_EQ(self.m_router.capture().value, 1u);
    EXPECT_EQ(self.m_router.hitTest(Point(15.0f, 15.0f)).value, 1u);
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
}

void VerifyUiInputTests_TargetAndEventLimitsRejectOverflowAndAllowSubsequentProcessing(mut UiInputTests self){
    Vector<HitTarget> targets = Vector<HitTarget>();
    targets.reserve(s_InputMaxTargets);
    for(usize index = 0u; index < s_InputMaxTargets; ++index){
        targets.push_back(MakeUiInputTarget(cast<u64>(index) + 1u));
    }
    ASSERT_TRUE(self.commitSpan(targets, 1u));
    EXPECT_FALSE(self.commitOverflowSpan(targets, 2u));
    EXPECT_EQ(self.m_router.targets().size(), s_InputMaxTargets);
    for(usize index = 0u; index < s_InputMaxEvents; ++index){
        ASSERT_TRUE(self.queueNative(MakeUiInputPointer(InputEventType::PointerMove)));
    }
    EXPECT_FALSE(self.queueNative(MakeUiInputPointer(InputEventType::PointerMove)));
    EXPECT_TRUE(self.m_router.process().pointerConsumed);
    EXPECT_EQ(self.m_router.hover().value, s_InputMaxTargets);
    EXPECT_FALSE(self.queueNative(MakeUiPointerEvent(InputEventType::PointerMove, Point(bit_cast<f32>(0x7fc00000u), 1.0f))));
    EXPECT_FALSE(self.queueNative(MakeUiBareInputEvent(bit_cast<InputEventType>(u8(255u)))));
    EXPECT_FALSE(self.queueNative(MakeUiInputKey(InputEventType::KeyDown, Key::Unknown, false)));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PointerMove)).pointerConsumed);
}

void VerifyUiInputTests_ActionLimitReportsOverflowWithoutReplayingDroppedInput(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    self.tab();
    for(usize index = 0u; index < s_InputMaxActions; ++index){
        const InputRoutingResult activated = self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Enter, false));
        EXPECT_TRUE(activated.commandConsumed);
        EXPECT_FALSE(activated.activationOverflow);
        EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, Key::Enter, false)).commandConsumed);
    }
    ASSERT_EQ(self.m_router.actions().size(), s_InputMaxActions);
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Enter, false)).activationOverflow);
    const InputRoutingResult overflow = self.send(MakeUiInputKey(InputEventType::KeyUp, Key::Enter, false));
    EXPECT_TRUE(overflow.commandConsumed);
    EXPECT_TRUE(overflow.activationOverflow);
    EXPECT_EQ(self.m_router.actions().size(), s_InputMaxActions);
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyUp, Key::Enter, false)).commandConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.m_router.process().activationOverflow);
    EXPECT_EQ(self.m_router.actions().size(), s_InputMaxActions - 1u);
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Enter, false)).activationOverflow);
    EXPECT_EQ(self.m_router.actions().size(), s_InputMaxActions - 1u);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, Key::Enter, false)).commandConsumed);
    EXPECT_EQ(self.m_router.actions().size(), s_InputMaxActions);
}

void VerifyUiInputTests_EscapeCancelsPointerPressEvenWhenATextEditorKeepsFocus(mut UiInputTests self){
    HitTarget target = MakeUiInputTarget(1u);
    target.textEditable = true;
    ASSERT_TRUE(self.commitSingle(target, 1u));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.m_router.pressed(target.id));
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Escape, false)).commandConsumed);
    EXPECT_EQ(self.m_router.focus(), target.id);
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_FALSE(self.m_router.pressed(target.id));
    EXPECT_TRUE(self.m_router.primaryDown());
    EXPECT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PointerMove, Point(90.0f, 90.0f))).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, Key::Escape, false)).commandConsumed);
    self.click();
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
}

void VerifyUiInputTests_NativeCaptureLossTerminatesPointerOwnershipWithoutSubmitting(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiBareInputEvent(InputEventType::PointerCaptureLost)).pointerConsumed);
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_FALSE(self.m_router.primaryDown());
    EXPECT_FALSE(self.m_router.wantsPointer());
    EXPECT_FALSE(self.send(MakeUiPointerEvent(InputEventType::PrimaryUp, Point(150.0f, 150.0f))).pointerConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.send(MakeUiPointerEvent(InputEventType::PrimaryUp, Point(150.0f, 150.0f))).pointerConsumed);
}

void VerifyUiInputTests_NativeCaptureTerminationAdmitsFreshClicksWithoutCancellingCompletedActionsOrKeys(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    self.click();
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Space, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiBareInputEvent(InputEventType::PointerCaptureLost)).pointerConsumed);
    EXPECT_FALSE(self.m_router.primaryDown());
    EXPECT_FALSE(self.m_router.secondaryDown());
    EXPECT_TRUE(self.m_router.ownsKey(Key::Space));
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    self.click();
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, Key::Space, false)).commandConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
}

void VerifyUiInputTests_NativeFocusTerminationDropsMissingNativeReleasesButPreservesControllerOwnership(mut UiInputTests self){
    const HitTarget target = MakeUiInputTarget(1u);
    ASSERT_TRUE(self.commitSingle(target, 1u));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Space, false)).commandConsumed);
    InputEvent controller = InputEvent();
    controller.type = InputEventType::CommandDown;
    controller.source = InputSource(7u, 3u);
    controller.command = InputCommand::Activate;
    EXPECT_TRUE(self.send(controller).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiBareInputEvent(InputEventType::FocusLost)).commandConsumed);
    self.m_router.cancelDeviceInput(0u);
    EXPECT_FALSE(self.m_router.primaryDown());
    EXPECT_FALSE(self.m_router.ownsKey(Key::Space));
    EXPECT_TRUE(self.m_router.ownsSource(controller.source));
    EXPECT_TRUE(self.m_router.actions().empty());
    self.send(MakeUiBareInputEvent(InputEventType::FocusGained));
    self.click();
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, Key::Space, false)).commandConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, Key::Space, false)).commandConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    controller.type = InputEventType::CommandUp;
    controller.command = InputCommand::None;
    EXPECT_TRUE(self.send(controller).commandConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.m_router.ownsSource(controller.source));
}


