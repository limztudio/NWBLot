void VerifyUiCommandInputTests_TwoControllersRetainIndependentOwnersForTheSameCommand(mut UiCommandInputTests self){
    const HitTarget host = MakeUiCommandInputControl(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(host), 1u));
    const InputSource first = MakeUiCommandInputSource(1u, 5u);
    const InputSource second = MakeUiCommandInputSource(2u, 5u);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, first, InputCommand::Down, false)).routing.commandConsumed);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, second, InputCommand::Down, false)).routing.commandConsumed);
    const Expected<ControlAction> actionResult1 = self.take(host);
    ASSERT_TRUE(actionResult1.has_value());
    ControlAction action = actionResult1.value();
    EXPECT_EQ(action.kind, ControlActionKind::Down);
    const u64 firstSequence = action.id.sequence;
    const Expected<ControlAction> actionResult2 = self.take(host);
    ASSERT_TRUE(actionResult2.has_value());
    action = actionResult2.value();
    EXPECT_EQ(action.kind, ControlActionKind::Down);
    EXPECT_GT(action.id.sequence, firstSequence);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, first, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_FALSE(self.m_router.ownsSource(first));
    EXPECT_TRUE(self.m_router.ownsSource(second));
    const UiCommandInputRouted dispatchResult = self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, second, InputCommand::Right, false));
    EXPECT_TRUE(dispatchResult.routing.commandConsumed);
    const InputEvent resolved = dispatchResult.event;
    EXPECT_EQ(resolved.command, InputCommand::Down);
    EXPECT_TRUE(resolved.repeat);
    const Expected<ControlAction> actionResult3 = self.take(host);
    ASSERT_TRUE(actionResult3.has_value());
    action = actionResult3.value();
    EXPECT_EQ(action.kind, ControlActionKind::Down);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, second, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_FALSE(self.m_router.ownsSource(second));
    EXPECT_FALSE(self.take(host).has_value());
}

void VerifyUiCommandInputTests_HeldPhysicalPressPinsCommandSelectionAndEditAdmissionAcrossProfileReplacement(mut UiCommandInputTests self){
    const HitTarget host = MakeUiCommandInputControl(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(host), 1u));
    InputKeyBinding initial = InputKeyBinding();
    initial.key = CoreKey::W;
    initial.modifiers = 0;
    initial.ignoredModifiers = CoreInputModifier::Shift;
    initial.command = InputCommand::Down;
    initial.selection = InputSelectionPolicy::Shift;
    initial.edit = true;
    initial.allowText = true;
    ASSERT_TRUE(self.m_router.setBindings(MakeUiSingleKeyBindingArray(initial)));
    const UiCommandInputRouted dispatchResult1 = self.send(MakeUiCommandInputKey(InputEventType::KeyDown, true, false));
    EXPECT_TRUE(dispatchResult1.routing.commandConsumed);
    InputEvent resolved = dispatchResult1.event;
    EXPECT_EQ(resolved.command, InputCommand::Down);
    EXPECT_TRUE(resolved.extend);
    EXPECT_TRUE(resolved.edit);
    EXPECT_TRUE(resolved.allowText);
    InputKeyBinding replacement = InputKeyBinding();
    replacement.key = CoreKey::W;
    replacement.modifiers = 0;
    replacement.ignoredModifiers = 0;
    replacement.command = InputCommand::Up;
    replacement.selection = InputSelectionPolicy::None;
    replacement.edit = false;
    ASSERT_TRUE(self.m_router.setBindings(MakeUiSingleKeyBindingArray(replacement)));
    self.m_router.restoreDefaultBindings();
    const UiCommandInputRouted dispatchResult2 = self.send(MakeUiCommandInputKey(InputEventType::KeyDown, false, false));
    EXPECT_TRUE(dispatchResult2.routing.commandConsumed);
    resolved = dispatchResult2.event;
    EXPECT_EQ(resolved.command, InputCommand::Down);
    EXPECT_TRUE(resolved.repeat);
    EXPECT_TRUE(resolved.extend);
    EXPECT_TRUE(resolved.edit);
    EXPECT_TRUE(resolved.allowText);
    EXPECT_TRUE(self.m_router.ownsKey(CoreKey::W));
    const UiCommandInputRouted dispatchResult3 = self.send(MakeUiCommandInputKey(InputEventType::KeyUp, false, false));
    EXPECT_TRUE(dispatchResult3.routing.commandConsumed);
    resolved = dispatchResult3.event;
    EXPECT_EQ(resolved.command, InputCommand::Down);
    EXPECT_TRUE(resolved.allowText);
    EXPECT_FALSE(self.m_router.ownsKey(CoreKey::W));
    const Expected<ControlAction> actionResult1 = self.take(host);
    ASSERT_TRUE(actionResult1.has_value());
    EXPECT_EQ(actionResult1.value().kind, ControlActionKind::Down);
    const Expected<ControlAction> actionResult2 = self.take(host);
    ASSERT_TRUE(actionResult2.has_value());
    EXPECT_EQ(actionResult2.value().kind, ControlActionKind::Down);
    ASSERT_TRUE(self.m_router.setBindings(MakeUiSingleKeyBindingArray(replacement)));
    const UiCommandInputRouted dispatchResult4 = self.send(MakeUiCommandInputKey(InputEventType::KeyDown, false, false));
    EXPECT_TRUE(dispatchResult4.routing.commandConsumed);
    resolved = dispatchResult4.event;
    EXPECT_EQ(resolved.command, InputCommand::Up);
    EXPECT_FALSE(resolved.extend);
    EXPECT_FALSE(resolved.edit);
    EXPECT_FALSE(resolved.allowText);
    const Expected<ControlAction> actionResult3 = self.take(host);
    ASSERT_TRUE(actionResult3.has_value());
    EXPECT_EQ(actionResult3.value().kind, ControlActionKind::Up);
}

void VerifyUiCommandInputTests_AnUnconsumedInitialPressCannotClaimUiAfterFocusAppears(mut UiCommandInputTests self){
    const InputSource source = MakeUiCommandInputSource(1u, 1u);
    EXPECT_FALSE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, source, InputCommand::Activate, false)).routing.commandConsumed);
    const HitTarget target = MakeUiCommandInputTarget(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(target), 1u));
    EXPECT_FALSE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, source, InputCommand::Activate, true)).routing.commandConsumed);
    EXPECT_FALSE(self.m_router.ownsSource(source));
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, source, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, source, InputCommand::Activate, false)).routing.commandConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, source, InputCommand::None, false)).routing.commandConsumed);
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_EQ(self.m_router.actions()[0u].origin, InputActionSource::Command);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
}

void VerifyUiCommandInputTests_RetiredControlOwnerCannotReviveWhenTheExactOldTargetReturns(mut UiCommandInputTests self){
    const HitTarget host = MakeUiCommandInputControl(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(host), 1u));
    const InputSource source = MakeUiCommandInputSource(3u, 9u);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, source, InputCommand::Down, false)).routing.commandConsumed);
    const Expected<ControlAction> actionResult1 = self.take(host);
    ASSERT_TRUE(actionResult1.has_value());
    self.m_router.invalidateTarget(host.id);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(host), 2u));
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, source, InputCommand::Down, true)).routing.commandConsumed);
    EXPECT_FALSE(self.take(host).has_value());
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, source, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, source, InputCommand::Down, false)).routing.commandConsumed);
    const Expected<ControlAction> actionResult2 = self.take(host);
    ASSERT_TRUE(actionResult2.has_value());
}

void VerifyUiCommandInputTests_RetiredEditorCannotBorrowAHeldCommandAfterReturningWithItsOldIdentity(mut UiCommandInputTests self){
    HitTarget editor = MakeUiCommandInputTarget(1u);
    editor.textEditable = true;
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(editor), 1u));
    const InputSource source = MakeUiCommandInputSource(3u, 9u);
    const UiCommandInputRouted dispatchResult1 = self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, source, InputCommand::Left, false));
    EXPECT_TRUE(dispatchResult1.routing.commandConsumed);
    EXPECT_TRUE(self.m_router.canEditCommand(dispatchResult1.event));
    self.m_router.invalidateTarget(editor.id);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(editor), 2u));
    const UiCommandInputRouted dispatchResult2 = self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, source, InputCommand::Left, true));
    EXPECT_TRUE(dispatchResult2.routing.commandConsumed);
    EXPECT_FALSE(self.m_router.canEditCommand(dispatchResult2.event));
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, source, InputCommand::None, false)).routing.commandConsumed);
    const UiCommandInputRouted dispatchResult3 = self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, source, InputCommand::Left, false));
    EXPECT_TRUE(dispatchResult3.routing.commandConsumed);
    EXPECT_TRUE(self.m_router.canEditCommand(dispatchResult3.event));
}

void VerifyUiCommandInputTests_HeldEditingCommandCannotMoveToAnotherFocusedEditor(mut UiCommandInputTests self){
    HitTarget first = MakeUiCommandInputTarget(1u);
    first.textEditable = true;
    HitTarget second = MakeUiCommandInputTarget(2u);
    second.textEditable = true;
    second.focusOnCommit = false;
    second.rectangle.x = 100.0f;
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = first;
    targets[1u] = second;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u));
    const InputSource edit = MakeUiCommandInputSource(3u, 1u);
    const UiCommandInputRouted dispatchResult1 = self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, edit, InputCommand::Left, false));
    EXPECT_TRUE(dispatchResult1.routing.commandConsumed);
    EXPECT_TRUE(self.m_router.canEditCommand(dispatchResult1.event));
    const InputSource traverse = MakeUiCommandInputSource(3u, 2u);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, traverse, InputCommand::FocusNext, false)).routing.commandConsumed);
    EXPECT_EQ(self.m_router.focus(), second.id);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, traverse, InputCommand::None, false)).routing.commandConsumed);
    const UiCommandInputRouted dispatchResult2 = self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, edit, InputCommand::Left, true));
    EXPECT_TRUE(dispatchResult2.routing.commandConsumed);
    EXPECT_FALSE(self.m_router.canEditCommand(dispatchResult2.event));
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, edit, InputCommand::None, false)).routing.commandConsumed);
    const UiCommandInputRouted dispatchResult3 = self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, edit, InputCommand::Left, false));
    EXPECT_TRUE(dispatchResult3.routing.commandConsumed);
    EXPECT_TRUE(self.m_router.canEditCommand(dispatchResult3.event));
}

void VerifyUiCommandInputTests_DelegatedAcceptStillReachesEditorSubmissionWhileVerticalNavigationDoesNot(mut UiCommandInputTests self){
    HitTarget editor = MakeUiCommandInputTarget(1u);
    editor.textEditable = true;
    HitTarget host = MakeUiCommandInputControl(2u);
    host.focusOnCommit = false;
    host.rectangle.x = 100.0f;
    editor.commandOwner = host.id;
    editor.commandOwnerDeclarationGeneration = host.declarationGeneration;
    editor.commandControl = host.control;
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = editor;
    targets[1u] = host;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u));
    const InputSource submit = MakeUiCommandInputSource(4u, 1u);
    const UiCommandInputRouted dispatchResult1 = self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, submit, InputCommand::Accept, false));
    EXPECT_TRUE(dispatchResult1.routing.commandConsumed);
    EXPECT_TRUE(self.m_router.canEditCommand(dispatchResult1.event));
    EXPECT_FALSE(self.take(host).has_value());
    const Expected<InputEvent> submitRelease = self.queueNative(MakeUiCommandInputCommand(InputEventType::CommandUp, submit, InputCommand::None, false));
    ASSERT_TRUE(submitRelease.has_value());
    EXPECT_TRUE(self.m_router.canSubmitCommand(submitRelease.value()));
    EXPECT_TRUE(self.m_router.process().commandConsumed);
    const Expected<ControlAction> actionResult1 = self.take(host);
    ASSERT_TRUE(actionResult1.has_value());
    EXPECT_EQ(actionResult1.value().kind, ControlActionKind::Submit);
    EXPECT_FALSE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, submit, InputCommand::None, false)).routing.commandConsumed);
    const InputSource navigate = MakeUiCommandInputSource(4u, 2u);
    const UiCommandInputRouted dispatchResult2 = self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, navigate, InputCommand::Down, false));
    EXPECT_TRUE(dispatchResult2.routing.commandConsumed);
    EXPECT_FALSE(self.m_router.canEditCommand(dispatchResult2.event));
    const Expected<ControlAction> actionResult2 = self.take(host);
    ASSERT_TRUE(actionResult2.has_value());
    EXPECT_EQ(actionResult2.value().kind, ControlActionKind::Down);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, navigate, InputCommand::None, false)).routing.commandConsumed);
    const UiCommandInputRouted dispatchResult3 = self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, submit, InputCommand::Accept, false));
    EXPECT_TRUE(dispatchResult3.routing.commandConsumed);
    EXPECT_TRUE(self.m_router.canEditCommand(dispatchResult3.event));
    self.m_router.invalidateTarget(host.id);
    ASSERT_TRUE(self.m_router.commitTargets(targets, 2u));
    const UiCommandInputRouted dispatchResult4 = self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, submit, InputCommand::Accept, true));
    EXPECT_TRUE(dispatchResult4.routing.commandConsumed);
    EXPECT_FALSE(self.m_router.canEditCommand(dispatchResult4.event));
    EXPECT_FALSE(self.take(host).has_value());
}

void VerifyUiCommandInputTests_ClearFocusAndNativeLossRetainReleaseOwnershipButCancelPendingSubmissions(mut UiCommandInputTests self){
    const HitTarget target = MakeUiCommandInputTarget(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(target), 1u));
    const InputSource held = MakeUiCommandInputSource(5u, 1u);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, held, InputCommand::Activate, false)).routing.commandConsumed);
    self.m_router.clearFocus();
    EXPECT_TRUE(self.m_router.ownsSource(held));
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, held, InputCommand::None, false)).routing.commandConsumed);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(target), 2u));
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, held, InputCommand::Activate, false)).routing.commandConsumed);
    InputEvent focusLost = InputEvent();
    focusLost.type = InputEventType::FocusLost;
    EXPECT_TRUE(self.send(focusLost).routing.commandConsumed);
    EXPECT_TRUE(self.m_router.ownsSource(held));
    EXPECT_TRUE(self.m_router.wantsCommands());
    const InputSource traverse = MakeUiCommandInputSource(5u, 2u);
    EXPECT_FALSE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, traverse, InputCommand::FocusNext, false)).routing.commandConsumed);
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, held, InputCommand::Activate, false)).routing.commandConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    InputEvent focusGained = InputEvent();
    focusGained.type = InputEventType::FocusGained;
    EXPECT_FALSE(self.send(focusGained).routing.commandConsumed);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, held, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, traverse, InputCommand::FocusNext, true)).routing.commandConsumed);
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, traverse, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, traverse, InputCommand::FocusNext, false)).routing.commandConsumed);
    EXPECT_EQ(self.m_router.focus(), target.id);
}

void VerifyUiCommandInputTests_QueuedReleaseSeparatesOldAndNewBindingSnapshotsBeforeProcessing(mut UiCommandInputTests self){
    const HitTarget host = MakeUiCommandInputControl(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(host), 1u));
    InputKeyBinding initial = InputKeyBinding();
    initial.key = CoreKey::W;
    initial.command = InputCommand::Left;
    ASSERT_TRUE(self.m_router.setBindings(MakeUiSingleKeyBindingArray(initial)));
    const Expected<InputEvent> firstResult = self.queueNative(MakeUiCommandInputKey(InputEventType::KeyDown, false, false));
    ASSERT_TRUE(firstResult.has_value());
    InputKeyBinding replacement = InputKeyBinding();
    replacement.key = CoreKey::W;
    replacement.command = InputCommand::Right;
    ASSERT_TRUE(self.m_router.setBindings(MakeUiSingleKeyBindingArray(replacement)));
    const Expected<InputEvent> releaseResult = self.queueNative(MakeUiCommandInputKey(InputEventType::KeyUp, false, false));
    ASSERT_TRUE(releaseResult.has_value());
    const Expected<InputEvent> secondResult = self.queueNative(MakeUiCommandInputKey(InputEventType::KeyDown, false, false));
    ASSERT_TRUE(secondResult.has_value());
    EXPECT_EQ(firstResult.value().command, InputCommand::Left);
    EXPECT_EQ(releaseResult.value().command, InputCommand::Left);
    EXPECT_EQ(secondResult.value().command, InputCommand::Right);
    EXPECT_TRUE(self.m_router.process().commandConsumed);
    const Expected<ControlAction> actionResult1 = self.take(host);
    ASSERT_TRUE(actionResult1.has_value());
    EXPECT_EQ(actionResult1.value().kind, ControlActionKind::Left);
    const u64 sequence = actionResult1.value().id.sequence;
    const Expected<ControlAction> actionResult2 = self.take(host);
    ASSERT_TRUE(actionResult2.has_value());
    EXPECT_EQ(actionResult2.value().kind, ControlActionKind::Right);
    EXPECT_GT(actionResult2.value().id.sequence, sequence);
    EXPECT_TRUE(self.m_router.ownsKey(CoreKey::W));
}

void VerifyUiCommandInputTests_OrphanRepeatsAfterNativeLossAndResetNeedReleaseBeforeEditingOrNavigation(mut UiCommandInputTests self){
    HitTarget editor = MakeUiCommandInputTarget(1u);
    editor.textEditable = true;
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(editor), 1u));
    const InputSource edit = MakeUiCommandInputSource(7u, 1u);
    const UiCommandInputRouted dispatchResult1 = self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, edit, InputCommand::Left, false));
    EXPECT_TRUE(dispatchResult1.routing.commandConsumed);
    EXPECT_TRUE(self.m_router.canEditCommand(dispatchResult1.event));
    InputEvent focusLost = InputEvent();
    focusLost.type = InputEventType::FocusLost;
    EXPECT_TRUE(self.send(focusLost).routing.commandConsumed);
    InputEvent focusGained = InputEvent();
    focusGained.type = InputEventType::FocusGained;
    EXPECT_FALSE(self.send(focusGained).routing.commandConsumed);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(editor), 2u));
    EXPECT_TRUE(self.m_router.focus().valid());
    const UiCommandInputRouted dispatchResult2 = self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, edit, InputCommand::Left, true));
    EXPECT_TRUE(dispatchResult2.routing.commandConsumed);
    EXPECT_FALSE(self.m_router.canEditCommand(dispatchResult2.event));
    EXPECT_TRUE(self.m_router.ownsSource(edit));
    const UiCommandInputRouted dispatchResult3 = self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, edit, InputCommand::Left, false));
    EXPECT_TRUE(dispatchResult3.routing.commandConsumed);
    EXPECT_FALSE(self.m_router.canEditCommand(dispatchResult3.event));
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, edit, InputCommand::None, false)).routing.commandConsumed);
    const UiCommandInputRouted dispatchResult4 = self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, edit, InputCommand::Left, false));
    EXPECT_TRUE(dispatchResult4.routing.commandConsumed);
    EXPECT_TRUE(self.m_router.canEditCommand(dispatchResult4.event));
    self.m_router.reset();
    HitTarget button = MakeUiCommandInputTarget(2u);
    button.focusOnCommit = false;
    button.rectangle.x = 100.0f;
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = editor;
    targets[1u] = button;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u));
    const InputSource traverse = MakeUiCommandInputSource(7u, 2u);
    EXPECT_FALSE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, traverse, InputCommand::FocusNext, true)).routing.commandConsumed);
    EXPECT_EQ(self.m_router.focus(), editor.id);
    EXPECT_FALSE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, traverse, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, traverse, InputCommand::FocusNext, false)).routing.commandConsumed);
    EXPECT_EQ(self.m_router.focus(), button.id);
    const InputSource activate = MakeUiCommandInputSource(7u, 3u);
    EXPECT_FALSE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, activate, InputCommand::Activate, true)).routing.commandConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(button.id));
    EXPECT_FALSE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, activate, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, activate, InputCommand::Activate, false)).routing.commandConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(button.id));
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, activate, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(button.id));
}

void VerifyUiCommandInputTests_MalformedCommandSourcesRejectWithoutChangingExistingOwners(mut UiCommandInputTests self){
    const HitTarget target = MakeUiCommandInputTarget(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(target), 1u));
    Array<InputSource, 2u> invalidSources = Array<InputSource, 2u>();
    invalidSources[0u] = InputSource();
    invalidSources[1u] = MakeUiCommandInputSource(1u, 0u);
    for(in InputSource source : invalidSources)
        EXPECT_FALSE(self.queueNative(MakeUiCommandInputCommand(InputEventType::CommandDown, source, InputCommand::Activate, false)).has_value());
    EXPECT_FALSE(self.queueNative(MakeUiCommandInputCommand(InputEventType::CommandDown, MakeUiCommandInputSource(1u, 1u), MakeUiInvalidInputCommand(), false)).has_value());
    EXPECT_FALSE(self.m_router.process().commandConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    InputEvent strayRelease = MakeUiCommandInputCommand(InputEventType::CommandUp, MakeUiCommandInputSource(2u, 2u), InputCommand::None, false);
    strayRelease.allowText = true;
    const Expected<InputEvent> outputResult = self.queueNative(strayRelease);
    ASSERT_TRUE(outputResult.has_value());
    EXPECT_FALSE(outputResult.value().allowText);
    EXPECT_FALSE(self.m_router.process().commandConsumed);
    const InputSource zeroDevice = MakeUiCommandInputSource(0u, 1u);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, zeroDevice, InputCommand::Activate, false)).routing.commandConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, zeroDevice, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
}

void VerifyUiCommandInputTests_ExplicitDeviceTerminationPreservesAnotherProvidersHeldSubmit(mut UiCommandInputTests self){
    const HitTarget target = MakeUiCommandInputTarget(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(target), 1u));
    const InputSource first = MakeUiCommandInputSource(31u, 7u);
    const InputSource second = MakeUiCommandInputSource(32u, 7u);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, first, InputCommand::Activate, false)).routing.commandConsumed);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, second, InputCommand::Activate, false)).routing.commandConsumed);
    self.m_router.cancelDeviceInput(first.device);
    EXPECT_FALSE(self.m_router.ownsSource(first));
    EXPECT_TRUE(self.m_router.ownsSource(second));
    EXPECT_FALSE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, first, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, second, InputCommand::None, false)).routing.commandConsumed);
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_EQ(self.m_router.actions()[0u].inputSource, second);
}

void VerifyUiCommandInputTests_ExactSourceCapacityRejectsOverflowWithoutLosingReleaseOrRebindingState(mut UiCommandInputTests self){
    const HitTarget target = MakeUiCommandInputTarget(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(target), 1u));
    for(usize index = 0u; index < s_InputMaxSources; ++index)
        EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, MakeUiCommandInputSource(1u, index + 1u), InputCommand::Left, false)).routing.commandConsumed);
    const InputSource overflow = MakeUiCommandInputSource(1u, s_InputMaxSources + 1u);
    EXPECT_FALSE(self.queueNative(MakeUiCommandInputCommand(InputEventType::CommandDown, overflow, InputCommand::Right, false)).has_value());
    const InputSource first = MakeUiCommandInputSource(1u, 1u);
    EXPECT_TRUE(self.m_router.ownsSource(first));
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, first, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, overflow, InputCommand::Right, false)).routing.commandConsumed);
    EXPECT_TRUE(self.m_router.ownsSource(overflow));
    self.m_router.reset();
    EXPECT_TRUE(self.m_router.ownsSource(overflow));
    EXPECT_TRUE(self.m_router.wantsCommands());
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, overflow, InputCommand::None, false)).routing.commandConsumed);
    for(usize index = 1u; index < s_InputMaxSources; ++index)
        EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, MakeUiCommandInputSource(1u, index + 1u), InputCommand::None, false)).routing.commandConsumed);
    EXPECT_FALSE(self.m_router.wantsCommands());
}

void VerifyUiCommandInputTests_FullEventQueueCannotReleaseOrChangeAnAlreadyAdmittedSource(mut UiCommandInputTests self){
    const HitTarget host = MakeUiCommandInputControl(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(host), 1u));
    const InputSource source = MakeUiCommandInputSource(8u, 8u);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, source, InputCommand::Down, false)).routing.commandConsumed);
    InputEvent pointerMove = InputEvent();
    pointerMove.type = InputEventType::PointerMove;
    for(usize index = 0u; index < s_InputMaxEvents; ++index)
        ASSERT_TRUE(self.queueNative(pointerMove).has_value());
    EXPECT_FALSE(self.queueNative(MakeUiCommandInputCommand(InputEventType::CommandUp, source, InputCommand::None, false)).has_value());
    EXPECT_FALSE(self.m_router.process().commandConsumed);
    EXPECT_TRUE(self.m_router.ownsSource(source));
    const UiCommandInputRouted dispatchResult = self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, source, InputCommand::Up, true));
    EXPECT_TRUE(dispatchResult.routing.commandConsumed);
    EXPECT_EQ(dispatchResult.event.command, InputCommand::Down);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, source, InputCommand::None, false)).routing.commandConsumed);
}

void VerifyUiCommandInputTests_DirectContextMenuReleaseCopiesAcceptedAnchorAndDoesNotRepeatOrActivate(mut UiCommandInputTests self){
    HitTarget target = MakeUiCommandInputTarget(1u);
    target.contextMenu = true;
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(target), 1u));
    const InputSource source = MakeUiCommandInputSource(9u, 9u);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, source, InputCommand::ContextMenu, false)).routing.commandConsumed);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, source, InputCommand::Activate, true)).routing.commandConsumed);
    EXPECT_FALSE(self.m_router.consumeContextMenu(target.id, target.declarationGeneration).has_value());
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, source, InputCommand::None, false)).routing.commandConsumed);
    const Expected<ContextMenuAction> actionResult = self.m_router.consumeContextMenu(target.id, target.declarationGeneration);
    ASSERT_TRUE(actionResult.has_value());
    const ContextMenuAction action = actionResult.value();
    EXPECT_EQ(action.origin, InputActionSource::Command);
    EXPECT_FLOAT_EQ(action.position.x, target.rectangle.x);
    EXPECT_FLOAT_EQ(action.position.y, target.rectangle.y + target.rectangle.height);
    EXPECT_FALSE(self.m_router.consumeContextMenu(target.id, target.declarationGeneration).has_value());
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, source, InputCommand::None, false)).routing.commandConsumed);
}

void VerifyUiCommandInputTests_IndependentControllerSubmitReleasesDoNotTransferOrRepeat(mut UiCommandInputTests self){
    const HitTarget target = MakeUiCommandInputTarget(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(target), 1u));
    const InputSource first = MakeUiCommandInputSource(1u, 8u);
    const InputSource second = MakeUiCommandInputSource(2u, 8u);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, first, InputCommand::Activate, false)).routing.commandConsumed);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, second, InputCommand::Activate, false)).routing.commandConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, MakeUiCommandInputSource(3u, 8u), InputCommand::Activate, false)).routing.commandConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, first, InputCommand::None, true)).routing.commandConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.m_router.pressed(target.id));
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, second, InputCommand::Submit, true)).routing.commandConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, second, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.m_router.pressed(target.id));
    EXPECT_FALSE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, second, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
}

void VerifyUiCommandInputTests_SubmitCannotReviveWhenFocusReturnsToTheOriginalDeclaration(mut UiCommandInputTests self){
    const HitTarget first = MakeUiCommandInputTarget(1u);
    HitTarget second = MakeUiCommandInputTarget(2u);
    second.focusOnCommit = false;
    second.rectangle.x = 100.0f;
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = first;
    targets[1u] = second;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u));
    const InputSource activate = MakeUiCommandInputSource(5u, 5u);
    const InputSource traverse = MakeUiCommandInputSource(5u, 6u);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, activate, InputCommand::Activate, false)).routing.commandConsumed);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, traverse, InputCommand::FocusNext, false)).routing.commandConsumed);
    EXPECT_EQ(self.m_router.focus(), second.id);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, traverse, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, traverse, InputCommand::FocusPrevious, false)).routing.commandConsumed);
    EXPECT_EQ(self.m_router.focus(), first.id);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, activate, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(first.id));
    EXPECT_FALSE(self.m_router.consumeActivation(second.id));
}

void VerifyUiCommandInputTests_EditorCancelRetiresAllSubmitSourcesButKeepsTheirReleasesOwned(mut UiCommandInputTests self){
    HitTarget editor = MakeUiCommandInputTarget(1u);
    editor.textEditable = true;
    editor.activatable = false;
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(editor), 1u));
    const InputSource first = MakeUiCommandInputSource(2u, 1u);
    const InputSource second = MakeUiCommandInputSource(3u, 1u);
    const InputSource cancel = MakeUiCommandInputSource(2u, 2u);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, first, InputCommand::Submit, false)).routing.commandConsumed);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, second, InputCommand::Accept, false)).routing.commandConsumed);
    EXPECT_TRUE(self.m_router.pressed(editor.id));
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, cancel, InputCommand::Cancel, false)).routing.commandConsumed);
    EXPECT_EQ(self.m_router.focus(), editor.id);
    EXPECT_FALSE(self.m_router.pressed(editor.id));
    Array<InputSource, 2u> submitSources = Array<InputSource, 2u>();
    submitSources[0u] = first;
    submitSources[1u] = second;
    for(in InputSource source : submitSources){
        const Expected<InputEvent> release = self.queueNative(MakeUiCommandInputCommand(InputEventType::CommandUp, source, InputCommand::None, false));
        ASSERT_TRUE(release.has_value());
        EXPECT_FALSE(self.m_router.canSubmitCommand(release.value()));
        EXPECT_TRUE(self.m_router.process().commandConsumed);
    }
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, cancel, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, first, InputCommand::Submit, false)).routing.commandConsumed);
    const Expected<InputEvent> release = self.queueNative(MakeUiCommandInputCommand(InputEventType::CommandUp, first, InputCommand::None, true));
    ASSERT_TRUE(release.has_value());
    EXPECT_FALSE(release.value().repeat);
    EXPECT_TRUE(self.m_router.canSubmitCommand(release.value()));
    self.m_router.cancelSubmitCommands(editor.id);
    EXPECT_FALSE(self.m_router.canSubmitCommand(release.value()));
    EXPECT_TRUE(self.m_router.process().commandConsumed);
}

void VerifyUiCommandInputTests_CustomSubmitBindingPinsItsReleaseAcrossModifierAndProfileChanges(mut UiCommandInputTests self){
    const HitTarget target = MakeUiCommandInputTarget(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(target), 1u));
    InputKeyBinding initial = InputKeyBinding();
    initial.key = CoreKey::W;
    initial.modifiers = 0;
    initial.ignoredModifiers = CoreInputModifier::Shift;
    initial.command = InputCommand::Activate;
    ASSERT_TRUE(self.m_router.setBindings(MakeUiSingleKeyBindingArray(initial)));
    EXPECT_TRUE(self.send(MakeUiCommandInputKey(InputEventType::KeyDown, true, false)).routing.commandConsumed);
    InputKeyBinding replacement = InputKeyBinding();
    replacement.key = CoreKey::W;
    replacement.command = InputCommand::FocusNext;
    ASSERT_TRUE(self.m_router.setBindings(MakeUiSingleKeyBindingArray(replacement)));
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    const Expected<InputEvent> release = self.queueNative(MakeUiCommandInputKey(InputEventType::KeyUp, false, false));
    ASSERT_TRUE(release.has_value());
    EXPECT_EQ(release.value().command, InputCommand::Activate);
    EXPECT_TRUE(self.m_router.process().commandConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
}

void VerifyUiCommandInputTests_QueuedReleaseDiscardedByResetRetiresOnlyTheReleasedCommand(mut UiCommandInputTests self){
    const HitTarget target = MakeUiCommandInputTarget(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(target), 1u));
    const InputSource released = MakeUiCommandInputSource(41u, 1u);
    const InputSource held = MakeUiCommandInputSource(41u, 2u);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, released, InputCommand::Activate, false)).routing.commandConsumed);
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, held, InputCommand::Activate, false)).routing.commandConsumed);
    ASSERT_TRUE(self.m_router.queue(MakeUiCommandInputCommand(InputEventType::CommandUp, released, InputCommand::None, false)).has_value());
    self.m_router.reset();
    EXPECT_FALSE(self.m_router.ownsSource(released));
    EXPECT_TRUE(self.m_router.ownsSource(held));
    EXPECT_TRUE(self.m_router.actions().empty());
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(target), 1u));
    EXPECT_FALSE(self.m_router.pressed(target.id));
    const UiCommandInputRouted fresh = self.send(MakeUiCommandInputCommand(InputEventType::CommandDown, released, InputCommand::Activate, false));
    EXPECT_FALSE(fresh.event.repeat);
    EXPECT_TRUE(fresh.routing.commandConsumed);
    EXPECT_TRUE(self.m_router.pressed(target.id));
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, released, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.send(MakeUiCommandInputCommand(InputEventType::CommandUp, held, InputCommand::None, false)).routing.commandConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
}


