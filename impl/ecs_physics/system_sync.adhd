class EcsPhysicsAssetCache{
    public HashMap<Name, SurfaceMaterial> materialCache;
    public HashMap<Name, Vector<EcsCachedHullGeometry>> hullGeometries;
    public HashMap<Name, Vector<EcsCachedCompoundHullGeometry>> compoundHullGeometries;
    public HashMap<Name, Vector<EcsCachedMeshGeometry>> meshGeometries;
    public HashMap<Name, Vector<EcsCachedHeightfieldGeometry>> heightfieldGeometries;
}

void ReleaseEcsPhysicsAssetCache(mut EcsPhysicsAssetCache cache, mut PhysicsWorld physicsWorld, in b8 destroyGeometries){
    if(destroyGeometries){
        for(in auto kv : cache.hullGeometries){
            in Vector<EcsCachedHullGeometry> list = kv.second;
            for(usize i = 0u; i < list.size(); ++i){
                if(physicsWorld.isHullGeometryValid(list[i].geometryId))
                    physicsWorld.destroyHullGeometry(list[i].geometryId);
            }
        }
        for(in auto kv : cache.compoundHullGeometries){
            in Vector<EcsCachedCompoundHullGeometry> list = kv.second;
            for(usize i = 0u; i < list.size(); ++i){
                in Vector<HullGeometryId> ids = list[i].geometryIds;
                for(usize gi = 0u; gi < ids.size(); ++gi){
                    if(physicsWorld.isHullGeometryValid(ids[gi]))
                        physicsWorld.destroyHullGeometry(ids[gi]);
                }
            }
        }
        for(in auto kv : cache.meshGeometries){
            in Vector<EcsCachedMeshGeometry> list = kv.second;
            for(usize i = 0u; i < list.size(); ++i){
                if(physicsWorld.isMeshGeometryValid(list[i].geometryId))
                    physicsWorld.destroyMeshGeometry(list[i].geometryId);
            }
        }
        for(in auto kv : cache.heightfieldGeometries){
            in Vector<EcsCachedHeightfieldGeometry> list = kv.second;
            for(usize i = 0u; i < list.size(); ++i){
                if(physicsWorld.isHeightfieldGeometryValid(list[i].geometryId))
                    physicsWorld.destroyHeightfieldGeometry(list[i].geometryId);
            }
        }
    }
    cache.materialCache.clear();
    cache.hullGeometries.clear();
    cache.compoundHullGeometries.clear();
    cache.meshGeometries.clear();
    cache.heightfieldGeometries.clear();
}

void PruneUnusedEcsPhysicsAssetCache(mut EcsPhysicsAssetCache cache, mut PhysicsWorld physicsWorld){
    Vector<Name> emptyKeys;
    for(in auto kv : cache.hullGeometries){
        const Name key = kv.first;
        mut Vector<EcsCachedHullGeometry> list = cache.hullGeometries.at(key);
        usize writeIdx = 0u;
        for(usize i = 0u; i < list.size(); ++i){
            const HullGeometryId id = list[i].geometryId;
            const b8 valid = physicsWorld.isHullGeometryValid(id);
            const b8 used = valid && (id.index < cast<u32>(physicsWorld.m_hullRefCounts.size())) && (physicsWorld.m_hullRefCounts[id.index] > 0u);
            if(used){
                if(writeIdx != i)
                    list[writeIdx] = list[i];
                ++writeIdx;
            }
            else if(valid){
                physicsWorld.destroyHullGeometry(id);
            }
        }
        list.resize(writeIdx);
        if(list.empty())
            emptyKeys.push_back(key);
    }
    for(usize ki = 0u; ki < emptyKeys.size(); ++ki)
        cache.hullGeometries.erase(emptyKeys[ki]);

    emptyKeys.clear();
    for(in auto kv : cache.compoundHullGeometries){
        const Name key = kv.first;
        mut Vector<EcsCachedCompoundHullGeometry> list = cache.compoundHullGeometries.at(key);
        usize writeIdx = 0u;
        for(usize i = 0u; i < list.size(); ++i){
            in Vector<HullGeometryId> ids = list[i].geometryIds;
            b8 anyUsed = false;
            for(usize gi = 0u; gi < ids.size(); ++gi){
                const HullGeometryId id = ids[gi];
                if(physicsWorld.isHullGeometryValid(id) && (id.index < cast<u32>(physicsWorld.m_hullRefCounts.size())) && (physicsWorld.m_hullRefCounts[id.index] > 0u)){
                    anyUsed = true;
                    break;
                }
            }
            if(anyUsed){
                if(writeIdx != i)
                    list[writeIdx] = list[i];
                ++writeIdx;
            }
            else{
                for(usize gi = 0u; gi < ids.size(); ++gi){
                    if(physicsWorld.isHullGeometryValid(ids[gi]))
                        physicsWorld.destroyHullGeometry(ids[gi]);
                }
            }
        }
        list.resize(writeIdx);
        if(list.empty())
            emptyKeys.push_back(key);
    }
    for(usize ki = 0u; ki < emptyKeys.size(); ++ki)
        cache.compoundHullGeometries.erase(emptyKeys[ki]);

    emptyKeys.clear();
    for(in auto kv : cache.meshGeometries){
        const Name key = kv.first;
        mut Vector<EcsCachedMeshGeometry> list = cache.meshGeometries.at(key);
        usize writeIdx = 0u;
        for(usize i = 0u; i < list.size(); ++i){
            const MeshGeometryId id = list[i].geometryId;
            const b8 valid = physicsWorld.isMeshGeometryValid(id);
            const b8 used = valid && (id.index < cast<u32>(physicsWorld.m_meshRefCounts.size())) && (physicsWorld.m_meshRefCounts[id.index] > 0u);
            if(used){
                if(writeIdx != i)
                    list[writeIdx] = list[i];
                ++writeIdx;
            }
            else if(valid){
                physicsWorld.destroyMeshGeometry(id);
            }
        }
        list.resize(writeIdx);
        if(list.empty())
            emptyKeys.push_back(key);
    }
    for(usize ki = 0u; ki < emptyKeys.size(); ++ki)
        cache.meshGeometries.erase(emptyKeys[ki]);

    emptyKeys.clear();
    for(in auto kv : cache.heightfieldGeometries){
        const Name key = kv.first;
        mut Vector<EcsCachedHeightfieldGeometry> list = cache.heightfieldGeometries.at(key);
        usize writeIdx = 0u;
        for(usize i = 0u; i < list.size(); ++i){
            const HeightfieldGeometryId id = list[i].geometryId;
            const b8 valid = physicsWorld.isHeightfieldGeometryValid(id);
            const b8 used = valid && (id.index < cast<u32>(physicsWorld.m_heightfieldRefCounts.size())) && (physicsWorld.m_heightfieldRefCounts[id.index] > 0u);
            if(used){
                if(writeIdx != i)
                    list[writeIdx] = list[i];
                ++writeIdx;
            }
            else if(valid){
                physicsWorld.destroyHeightfieldGeometry(id);
            }
        }
        list.resize(writeIdx);
        if(list.empty())
            emptyKeys.push_back(key);
    }
    for(usize ki = 0u; ki < emptyKeys.size(); ++ki)
        cache.heightfieldGeometries.erase(emptyKeys[ki]);
}

class EcsScopedEntityNames{
    public HashMap<Name, EntityID> globalNames;
    public HashMap<EntityID, u32> entityToScope;
    public Vector<HashMap<Name, EntityID>> scopes;
}

EntityID ResolveEcsScopedEntityName(in EcsScopedEntityNames scopedNames, in EntityID requester, in Name targetName){
    if(targetName == s_NameNone)
        return s_InvalidEntityId;
    if(requester.valid()){
        const auto scopeIt = scopedNames.entityToScope.find(requester);
        if(scopeIt != scopedNames.entityToScope.end()){
            const u32 scopeId = scopeIt.value();
            if(scopeId < cast<u32>(scopedNames.scopes.size())){
                const auto scopedIt = scopedNames.scopes[scopeId].find(targetName);
                if(scopedIt != scopedNames.scopes[scopeId].end())
                    return scopedIt.value();
            }
        }
    }
    const auto globalIt = scopedNames.globalNames.find(targetName);
    if(globalIt != scopedNames.globalNames.end())
        return globalIt.value();
    return s_InvalidEntityId;
}

b8 EcsF32x3BitEqual(in VectorSingle a, in VectorSingle b){
    return a.x == b.x && a.y == b.y && a.z == b.z;
}

b8 EcsF32x4BitEqual(in VectorSingle a, in VectorSingle b){
    return a.x == b.x && a.y == b.y && a.z == b.z && a.w == b.w;
}

