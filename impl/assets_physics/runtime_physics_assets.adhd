////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_physics/physics_asset_binary_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 PhysicsMaterialAsset::validatePayload()const{
    if(!this.checkVirtualPath("PhysicsMaterialAsset::validatePayload"))
        return false;
    return PhysicsAssetBinaryCodec().validatePhysicsMaterial(this.material, this.virtualPath());
}

b8 PhysicsMaterialAsset::loadBinary(in Span<u8> binary){
    const Expected<SurfaceMaterial> decoded = PhysicsAssetBinaryCodec().deserializePhysicsMaterial(binary);
    if(!decoded.has_value())
        return false;
    PhysicsMaterialAsset candidate(this.virtualPath());
    candidate.material = decoded.value();
    if(!candidate.validatePayload())
        return false;
    this.material = candidate.material;
    return true;
}

