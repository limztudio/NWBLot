const u32 s_RtInvalidSlot = 0xffffffffu;
const u64 s_RtMaxU32Value = 4294967295ull;
const u64 s_RtAddressableBytes = 4294967296ull;
const u32 s_RtMaxI32AsU32 = 2147483647u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Semantic identities selected by the current scene preflight, including direct transform and material edits.
// Runtime deformation is unstamped.
// Static mesh, texture and shader resources remain immutable until invalidation.
class RayTracingSceneContentStamp{
    public u64 geometry;
    public u64 material;
    public b8 trusted;

    public RayTracingSceneContentStamp(){
        this.geometry = 0u;
        this.material = 0u;
        this.trusted = false;
    }

    public RayTracingSceneContentStamp(in u64 inGeometry, in u64 inMaterial, in b8 inTrusted){
        this.geometry = inGeometry;
        this.material = inMaterial;
        this.trusted = inTrusted;
    }
}

// CPU mirror of trace material ABI; HW and SW share instance IDs.
[serialize]
class NwbRtInstanceMaterialGpu{
    public u32 surfaceDispatchId = s_RtInvalidSlot;
    public u32 flags = 0u;
    public u32 shadingModelId = 0u;
    public u32 materialConstantByteOffset = 0u;
    public u32 meshInstanceIndex = 0u;
    // Global-heap geometry slots; nodeSlot is software-only.
    public u32 indexSlot = s_RtInvalidSlot;
    public u32 attributeSlot = s_RtInvalidSlot;
    public u32 positionSlot = s_RtInvalidSlot;
    public u32 nodeSlot = s_RtInvalidSlot;
}

const usize s_NwbRtInstanceMaterialGpuByteSize = 36u;

// Shader-mirrored flags: transparent selects transmittance; refractive selects caustics.
enum<u32> RtInstanceMaterialFlag{
    flag None = 0u,
    flag Transparent = 1u << 0u,
    flag Refractive = 1u << 1u,
    flag CsgShadow = 1u << 2u,
    flag RefractionEntryCertified = 1u << 3u
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The caustic resolve chain works on targets reduced by this factor in each axis.
const u32 s_CausticResolveDownscaleFactor = 2u;
const u32 s_CausticResolveGroupSize = 8u;

class CausticResolveActivityLayout{
    public u64 bufferByteSize = 0u;
    public u32 tilesX = 0u;
    public u32 tilesY = 0u;
}

b8 TryResolveCausticActivityLayout(in u32 halfWidth, in u32 halfHeight, mut CausticResolveActivityLayout outLayout){
    outLayout = CausticResolveActivityLayout();
    if(halfWidth == 0u || halfHeight == 0u || halfWidth > s_RtMaxI32AsU32 || halfHeight > s_RtMaxI32AsU32){
        return false;
    }
    const u32 tilesX = divideUp(halfWidth, s_CausticResolveGroupSize);
    const u32 tilesY = divideUp(halfHeight, s_CausticResolveGroupSize);
    const u64 byteSize = cast<u64>(tilesX) * cast<u64>(tilesY) * 4ull;
    if(byteSize > s_RtAddressableBytes){
        return false;
    }
    outLayout.bufferByteSize = byteSize;
    outLayout.tilesX = tilesX;
    outLayout.tilesY = tilesY;
    return true;
}


