using namespace NWB;
using namespace NWB::Impl;
using namespace NWB::Impl::Ui;

[[nodiscard]] inline b8 ValidImageBindings(const DrawSnapshot& snapshot)noexcept{
    return GpuImageResources::ValidateGlyphPages(snapshot) && GpuImageResources::ValidateSdfPages(snapshot) && GpuImageResources::ValidateTextureImages(snapshot);
}

inline void SetCommandTextureImageIndex(DrawSnapshot& snapshot, const usize commandIndex, const u32 imageIndex)noexcept{
    const_cast<DrawCommand&>(snapshot.commands()[commandIndex]).textureImageIndex = imageIndex;
}

inline void ResetFirstSnapshotTextureImage(DrawSnapshot& snapshot)noexcept{
    const_cast<SharedImageSource&>(snapshot.textureImages()[0u]).reset();
}

inline void AppendSnapshotTextureImage(DrawSnapshot& snapshot, const SharedImageSource& image){
    const_cast<PaintVector<SharedImageSource>&>(snapshot.textureImages()).push_back(image);
}

inline void SetSnapshotCommandRaw(DrawSnapshot& snapshot, const usize commandIndex, const DrawCommand& command)noexcept{
    const_cast<DrawCommand&>(snapshot.commands()[commandIndex]) = command;
}

inline void SetFirstCommandUnknownMaterial(DrawSnapshot& snapshot)noexcept{
    DrawCommand& command = const_cast<DrawCommand&>(snapshot.commands()[0u]);
    command.material = static_cast<PaintMaterial::Enum>(Limit<u8>::s_Max);
    command.textureImageIndex = Limit<u32>::s_Max;
}

[[nodiscard]] inline b8 BuildMaxGlyphBudgetSnapshot(UiPaintImageTests::PaintImageFixture& self, const b8 withExtraImage, DrawSnapshot& outSnapshot){
    FixedVector<SharedGlyphPage, s_PaintMaxImages - 2u> glyphs;
    for(usize index = 0u; index < glyphs.max_size(); ++index){
        auto glyphResult = self.makeGlyph(100u + index);
        if(!glyphResult || !*glyphResult)
            return false;
        glyphs.push_back(Move(*glyphResult));
    }
    auto sdfResult = self.makeSdf();
    auto imageResult = self.makeImage();
    if(!sdfResult || !*sdfResult || !imageResult || !*imageResult)
        return false;
    const SharedSdfAtlasPage sdf = Move(*sdfResult);
    const SharedImageSource image = Move(*imageResult);
    if(!self.m_builder.prepareImages(glyphs, Span(&sdf, 1u), Span(&image, 1u)))
        return false;
    const Rect rectangle{ 2.0f, 3.0f, 16.0f, 8.0f };
    const Rect uv{ 0.0f, 0.0f, 1.0f, 1.0f };
    if(!withExtraImage){
        if(!self.m_builder.drawGlyph(glyphs[0u], rectangle, uv) || !self.m_builder.drawSdfGlyph(sdf, 2u, rectangle, uv))
            return false;
    }
    if(!self.m_builder.drawImage(image, rectangle))
        return false;
    outSnapshot = self.m_builder.freeze();
    if(withExtraImage){
        auto additionResult = self.makeImage("tests/ui/overflow_gpu_image", 73u);
        if(!additionResult || !*additionResult)
            return false;
        const_cast<PaintVector<SharedImageSource>&>(outSnapshot.textureImages()).push_back(Move(*additionResult));
    }
    return true;
}

[[nodiscard]] inline b8 PrepareSingleGlyphSdfAndImage(UiPaintImageTests::PaintImageFixture& self, SharedImageSource& outImage){
    auto imageResult = self.makeImage();
    auto glyphResult = self.makeGlyph();
    auto sdfResult = self.makeSdf();
    if(!imageResult || !*imageResult || !glyphResult || !*glyphResult || !sdfResult || !*sdfResult)
        return false;
    outImage = Move(*imageResult);
    const SharedGlyphPage glyph = Move(*glyphResult);
    const SharedSdfAtlasPage sdf = Move(*sdfResult);
    return self.m_builder.prepareImages(Span(&glyph, 1u), Span(&sdf, 1u), Span(&outImage, 1u));
}


