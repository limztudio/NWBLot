const u8 s_TextureClearQueueTransfer = 0u;
const u8 s_TextureClearQueueComputeOrGraphics = 1u;
const u8 s_TextureClearQueueGraphics = 2u;
const u8 s_QueueCapabilityTransferBit = 0x01u;
const u8 s_QueueCapabilityComputeBit = 0x02u;
const u8 s_QueueCapabilityGraphicsBit = 0x04u;

b8 TextureClearQueueRequirementSatisfied(in u8 requirement, in u8 declaredCapabilities, in u8 physicalCapabilities){
    switch(requirement){
    case s_TextureClearQueueTransfer: return (declaredCapabilities & physicalCapabilities & s_QueueCapabilityTransferBit) != 0u;
    case s_TextureClearQueueComputeOrGraphics: return (declaredCapabilities & physicalCapabilities & (s_QueueCapabilityComputeBit | s_QueueCapabilityGraphicsBit)) != 0u;
    case s_TextureClearQueueGraphics: return (declaredCapabilities & physicalCapabilities & s_QueueCapabilityGraphicsBit) != 0u;
    default: return false;
    }
}


