template<typename Storage, usize LogicalCount, typename Source>
[[nodiscard]] b8 RunDoubleStorePaddingStep(const Source& source, const b8 stream, Storage& outStored)noexcept{
    struct StorageRecord{
        Storage value;
        Array<u64, 4> neighbor{};
    };
    StorageRecord record{};
    FOUNDATION_MEMSET(&record, 0xa5, sizeof(record));
    const Array<u64, 3> poison = { 0x7ff0000000000000u, 0x7ff8000000001234u, 0xfff0000000000000u };
    const usize logicalBytes = LogicalCount * sizeof(f64);
    FOUNDATION_MEMCPY(reinterpret_cast<u8*>(&record.value) + logicalBytes, sizeof(Storage) - logicalBytes, poison.data(), sizeof(Storage) - logicalBytes);
    Array<u8, sizeof(StorageRecord)> original{};
    FOUNDATION_MEMCPY(original.data(), original.size(), &record, sizeof(record));
    if(stream){
        StreamDouble(source, record.value);
        StreamDoubleFence();
    }
    else
        StoreDouble(source, record.value);
    const auto bytes = MakeNotNull(reinterpret_cast<const u8*>(&record));
    for(usize index = logicalBytes; index < sizeof(record); ++index){
        if(bytes.get()[index] != original[index])
            return false;
    }
    outStored = record.value;
    return true;
}

template<typename Storage, usize LogicalCount>
void PoisonDoubleStoragePadding(Storage& lhs, Storage& rhs)noexcept{
    const usize logicalBytes = LogicalCount * sizeof(f64);
    FOUNDATION_MEMSET(reinterpret_cast<u8*>(&lhs) + logicalBytes, 0x7f, sizeof(Storage) - logicalBytes);
    FOUNDATION_MEMSET(reinterpret_cast<u8*>(&rhs) + logicalBytes, 0xff, sizeof(Storage) - logicalBytes);
}

struct DoubleTransformStreamFixture{
    struct AlignedRecord{
        Double3 value;
        Array<u64, 4> gap{};
    };
    struct alignas(32) UnalignedRecord{
        u64 prefix;
        Double3U value;
        Array<u64, 4> gap{};
    };
    struct PairRecord{
        Double2 value;
        Array<u64, 4> gap{};
    };

    Array<AlignedRecord, 3> aligned{};
    Array<UnalignedRecord, 3> unaligned{};
    Array<u8, sizeof(aligned)> alignedOriginal{};
    Array<u8, sizeof(unaligned)> unalignedOriginal{};
    Array<PairRecord, 2> pairs{};
    Array<u8, sizeof(pairs)> pairOriginal{};

    DoubleTransformStreamFixture()noexcept{
        FOUNDATION_MEMSET(aligned.data(), 0xa5, sizeof(aligned));
        FOUNDATION_MEMSET(unaligned.data(), 0x5a, sizeof(unaligned));
        const u64 poison = 0x7ff8000000001234u;
        for(usize index = 0u; index < LengthOf(aligned); ++index){
            const f64 position = static_cast<f64>(index);
            const f64 x = 0.25 * position + (0x1p+40 + 0.25);
            const f64 y = (position - 1.0) * 0x1p-40;
            StoreDouble(VectorDoubleSet(x, y, 1.0 + 0x1p-52, Limit<f64>::s_Infinity), aligned[index].value);
            FOUNDATION_MEMCPY(reinterpret_cast<u8*>(&aligned[index].value) + 3u * sizeof(f64), sizeof(aligned[index].value) - 3u * sizeof(f64), &poison, sizeof(poison));
        }
        FOUNDATION_MEMCPY(alignedOriginal.data(), alignedOriginal.size(), aligned.data(), sizeof(aligned));
        FOUNDATION_MEMCPY(unalignedOriginal.data(), unalignedOriginal.size(), unaligned.data(), sizeof(unaligned));

        FOUNDATION_MEMSET(pairs.data(), 0xa5, sizeof(pairs));
        for(usize index = 0u; index < LengthOf(pairs); ++index){
            StoreDouble(SIMDVectorDouble{ 0x1p+40 + 0.25, 1.0 + 0x1p-52, Limit<f64>::s_Infinity, Limit<f64>::s_QuietNaN }, pairs[index].value);
            FOUNDATION_MEMCPY(reinterpret_cast<u8*>(&pairs[index].value) + 2u * sizeof(f64), sizeof(pairs[index].value) - 2u * sizeof(f64), &poison, sizeof(poison));
        }
        FOUNDATION_MEMCPY(pairOriginal.data(), pairOriginal.size(), pairs.data(), sizeof(pairs));
    }

    [[nodiscard]] b8 alignedPaddingIntact(const usize index)const noexcept{
        const auto alignedBytes = MakeNotNull(reinterpret_cast<const u8*>(&aligned[index]));
        for(usize offset = 3u * sizeof(f64); offset < sizeof(AlignedRecord); ++offset){
            if(alignedBytes.get()[offset] != alignedOriginal[index * sizeof(AlignedRecord) + offset])
                return false;
        }
        return true;
    }

    [[nodiscard]] b8 unalignedPaddingIntact(const usize index)const noexcept{
        const auto unalignedBytes = MakeNotNull(reinterpret_cast<const u8*>(&unaligned[index]));
        for(usize offset = 0u; offset < sizeof(UnalignedRecord); ++offset){
            if(offset >= offsetof(UnalignedRecord, value) && offset < offsetof(UnalignedRecord, value) + sizeof(Double3U))
                continue;
            if(unalignedBytes.get()[offset] != unalignedOriginal[index * sizeof(UnalignedRecord) + offset])
                return false;
        }
        return true;
    }

    [[nodiscard]] b8 pairPaddingIntact(const usize index)const noexcept{
        const auto bytes = MakeNotNull(reinterpret_cast<const u8*>(&pairs[index]));
        for(usize offset = 2u * sizeof(f64); offset < sizeof(PairRecord); ++offset){
            if(bytes.get()[offset] != pairOriginal[index * sizeof(PairRecord) + offset])
                return false;
        }
        return true;
    }
};

template<typename Element, usize Count>
struct RawEqualityStorage{
    Array<Element, Count> raw{};


public:
    friend b8 operator==(const RawEqualityStorage& lhs, const RawEqualityStorage& rhs)noexcept{
        return MathTypeDetail::EqualElements<Element, Count>(MakeNotNull<const Element*>(lhs.raw.data()), MakeNotNull<const Element*>(rhs.raw.data()));
    }
    friend b8 operator!=(const RawEqualityStorage& lhs, const RawEqualityStorage& rhs)noexcept{ return !(lhs == rhs); }
};

template<typename Value, usize Count>
FOUNDATION_NOINLINE b8 LegacyEqual(const Value& lhs, const Value& rhs)noexcept{
#pragma STDC FENV_ACCESS ON
    for(usize lane = 0u; lane < Count; ++lane){
        if(lhs.raw[lane] != rhs.raw[lane])
            return false;
    }
    return true;
}

#pragma STDC FENV_ACCESS OFF
template<typename Value, usize Count>
FOUNDATION_NOINLINE b8 DefaultContextLegacyEqual(const Value& lhs, const Value& rhs)noexcept{
    for(usize i = 0u; i < Count; ++i){
        if(lhs.raw[i] != rhs.raw[i])
            return false;
    }
    return true;
}

template<typename Value>
FOUNDATION_NOINLINE b8 StorageEqual(const Value& lhs, const Value& rhs)noexcept{
#pragma STDC FENV_ACCESS ON
    return lhs == rhs;
}

class ExactFloatingPointEnvironmentGuard final : NoCopy{
public:
    ExactFloatingPointEnvironmentGuard() = default;
    ExactFloatingPointEnvironmentGuard(ExactFloatingPointEnvironmentGuard&&) = delete;
    ~ExactFloatingPointEnvironmentGuard()noexcept{
        if(m_original && !SetFloatingPointEnvironment(*m_original))
            FOUNDATION_ASSERT(false);
    }


public:
    [[nodiscard]] b8 valid()const noexcept{ return m_original.has_value(); }


private:
    Expected<FloatingPointEnvironment> m_original = GetFloatingPointEnvironment();
};

template<typename Value, usize Count>
[[nodiscard]] b8 ObserveNaNComparisonPair(const u32 nanBits, const usize nanLane, const usize mismatch, b8& outExpected, i32& outExpectedFlags, b8& outActual, i32& outActualFlags)noexcept{
#pragma STDC FENV_ACCESS ON
    Value lhs{};
    Value rhs{};
    for(usize lane = 0u; lane < Count; ++lane)
        lhs.raw[lane] = rhs.raw[lane] = static_cast<f32>(lane + 1u);
    lhs.raw[nanLane] = rhs.raw[nanLane] = BitCast<f32>(nanBits);
    if(mismatch < Count && mismatch != nanLane)
        rhs.raw[mismatch] = rhs.raw[mismatch] + 1.0f;
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    outExpected = LegacyEqual<Value, Count>(lhs, rhs);
    outExpectedFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    outActual = StorageEqual(lhs, rhs);
    outActualFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    return true;
}

template<typename Result>
struct ExpectedVectorStorage{
    u64 prefix = 0u;
    Array<Expected<Result>, 2> values;
};

template<typename Result>
FOUNDATION_NOINLINE auto ReadExpectedVector(const Expected<Result>& result)noexcept{ return result->value; }

struct PageBoundaryCaseResult{
    b8 pageSizePositive = false;
    b8 mapped = false;
    i32 protectStatus = -1;
    b8 equalMatch = false;
    b8 unequalMismatch = true;
    i32 unmapStatus = -1;
};

[[nodiscard]] inline constexpr b8 HasLinuxPageBoundaryMapping()noexcept{
#if defined(__linux__)
    return true;
#else
    return false;
#endif
}

[[nodiscard]] inline constexpr b8 HasInt128StorageSupport()noexcept{
#if defined(__SIZEOF_INT128__)
    return true;
#else
    return false;
#endif
}

[[nodiscard]] inline constexpr b8 HasSse2RawMxcsrSupport()noexcept{
#if defined(FOUNDATION_HAS_SSE2)
    return true;
#else
    return false;
#endif
}

#if defined(__linux__)
template<typename Value, usize Count>
[[nodiscard]] PageBoundaryCaseResult RunPageBoundaryTyped()noexcept{
    PageBoundaryCaseResult out{};
    const isize pageSize = static_cast<isize>(sysconf(_SC_PAGESIZE));
    out.pageSizePositive = pageSize > 0;
    if(!out.pageSizePositive)
        return out;
    void* const mapping = mmap(nullptr, static_cast<usize>(pageSize) * 2u, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    out.mapped = mapping != MAP_FAILED;
    if(!out.mapped)
        return out;
    out.protectStatus = static_cast<i32>(mprotect(static_cast<char*>(mapping) + pageSize, static_cast<usize>(pageSize), PROT_NONE));
    if(out.protectStatus != 0){
        out.unmapStatus = static_cast<i32>(munmap(mapping, static_cast<usize>(pageSize) * 2u));
        return out;
    }
    Value* const lhs = ::new(static_cast<char*>(mapping) + pageSize - sizeof(Value)) Value{};
    Value rhs{};
    for(usize lane = 0u; lane < Count; ++lane)
        lhs->raw[lane] = rhs.raw[lane] = static_cast<RemoveCVRef_T<decltype(rhs.raw[0])>>(lane + 1u);
    out.equalMatch = StorageEqual(*lhs, rhs);
    if constexpr(IsSame_V<RemoveCVRef_T<decltype(rhs.raw[0])>, b8>)
        rhs.raw[Count - 1u] = !rhs.raw[Count - 1u];
    else
        rhs.raw[Count - 1u] += 1;
    out.unequalMismatch = StorageEqual(*lhs, rhs);
    lhs->~Value();
    out.unmapStatus = static_cast<i32>(munmap(mapping, static_cast<usize>(pageSize) * 2u));
    return out;
}
#endif

[[nodiscard]] FOUNDATION_INLINE PageBoundaryCaseResult RunPageBoundaryCase([[maybe_unused]] const u32 caseIndex)noexcept{
#if defined(__linux__)
    switch(caseIndex){
    case 0u: return RunPageBoundaryTyped<RawEqualityStorage<b8, 1u>, 1u>();
    case 1u: return RunPageBoundaryTyped<RawEqualityStorage<b8, 16u>, 16u>();
    case 2u: return RunPageBoundaryTyped<RawEqualityStorage<b8, 17u>, 17u>();
    case 3u: return RunPageBoundaryTyped<RawEqualityStorage<b8, 33u>, 33u>();
    case 4u: return RunPageBoundaryTyped<Half2U, 2u>();
    case 5u: return RunPageBoundaryTyped<Half4U, 4u>();
    case 6u: return RunPageBoundaryTyped<Float2U, 2u>();
    case 7u: return RunPageBoundaryTyped<Float3U, 3u>();
    case 8u: return RunPageBoundaryTyped<Float33U, 9u>();
    case 9u: return RunPageBoundaryTyped<Int2U, 2u>();
    case 10u: return RunPageBoundaryTyped<Int3U, 3u>();
    case 11u: return RunPageBoundaryTyped<UInt2U, 2u>();
    default: return RunPageBoundaryTyped<UInt3U, 3u>();
    }
#else
    return {};
#endif
}

template<usize Count>
void ObserveBooleanFallbackStep(const usize flipLane, b8& outInitialEqual, b8& outFlippedEqual, b8& outFlippedLegacy, b8& outRestoredEqual)noexcept{
    RawEqualityStorage<b8, Count> lhs{};
    RawEqualityStorage<b8, Count> rhs{};
    for(usize lane = 0u; lane < Count; ++lane)
        lhs.raw[lane] = rhs.raw[lane] = (lane & 1u) != 0u;
    outInitialEqual = StorageEqual(lhs, rhs);
    rhs.raw[flipLane] = !rhs.raw[flipLane];
    outFlippedEqual = StorageEqual(lhs, rhs);
    outFlippedLegacy = LegacyEqual<RawEqualityStorage<b8, Count>, Count>(lhs, rhs);
    rhs.raw[flipLane] = lhs.raw[flipLane];
    outRestoredEqual = StorageEqual(lhs, rhs);
}

FOUNDATION_INLINE void RunBooleanFallbackStepByIndex(const usize countIndex, const usize flipLane, b8& outInitialEqual, b8& outFlippedEqual, b8& outFlippedLegacy, b8& outRestoredEqual)noexcept{
    switch(countIndex){
    case 0u: ObserveBooleanFallbackStep<1u>(flipLane, outInitialEqual, outFlippedEqual, outFlippedLegacy, outRestoredEqual); break;
    case 1u: ObserveBooleanFallbackStep<2u>(flipLane, outInitialEqual, outFlippedEqual, outFlippedLegacy, outRestoredEqual); break;
    case 2u: ObserveBooleanFallbackStep<7u>(flipLane, outInitialEqual, outFlippedEqual, outFlippedLegacy, outRestoredEqual); break;
    case 3u: ObserveBooleanFallbackStep<16u>(flipLane, outInitialEqual, outFlippedEqual, outFlippedLegacy, outRestoredEqual); break;
    case 4u: ObserveBooleanFallbackStep<17u>(flipLane, outInitialEqual, outFlippedEqual, outFlippedLegacy, outRestoredEqual); break;
    default: ObserveBooleanFallbackStep<33u>(flipLane, outInitialEqual, outFlippedEqual, outFlippedLegacy, outRestoredEqual); break;
    }
}

class MxcsrEqualityEnvironmentGuard final : NoCopy{
public:
    MxcsrEqualityEnvironmentGuard()noexcept
        : m_original(GetFloatingPointEnvironment())
#if defined(FOUNDATION_HAS_SSE2)
        , m_originalMxcsr(_mm_getcsr())
#endif
        , m_held(HoldFloatingPointExceptions())
    {
#if defined(FOUNDATION_HAS_SSE2)
        m_heldMxcsr = _mm_getcsr();
#endif
    }

    MxcsrEqualityEnvironmentGuard(MxcsrEqualityEnvironmentGuard&&) = delete;

    ~MxcsrEqualityEnvironmentGuard()noexcept{
        if(m_original && !SetFloatingPointEnvironment(*m_original))
            FOUNDATION_ASSERT(false);
#if defined(FOUNDATION_HAS_SSE2)
        if(m_original)
            _mm_setcsr(m_originalMxcsr);
#endif
    }


public:
    [[nodiscard]] b8 valid()const noexcept{ return m_original.has_value() && m_held.has_value(); }

    void applyMode([[maybe_unused]] const u32 mode)const noexcept{
#if defined(FOUNDATION_HAS_SSE2)
        _mm_setcsr((m_heldMxcsr & ~(0x8040u | 0x3Fu)) | mode);
#endif
    }


private:
    Expected<FloatingPointEnvironment> m_original;
#if defined(FOUNDATION_HAS_SSE2)
    u32 m_originalMxcsr = 0u;
    u32 m_heldMxcsr = 0u;
#endif
    Expected<FloatingPointEnvironment> m_held;
};

#if defined(FOUNDATION_HAS_SSE2)
template<typename Value, typename Compare>
[[nodiscard]] Expected<NWB::Tests::MathCases::EqualityObservation> ObserveEquality(const Value& lhs, const Value& rhs, Compare compare)noexcept(noexcept(DeclVal<void(*)(b8)noexcept>()(compare(lhs, rhs))) && IsNothrowDestructible_V<Compare>){
#pragma STDC FENV_ACCESS ON
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return MakeUnexpected(Failure{});
    _mm_setcsr(_mm_getcsr() & ~0x3Fu);
    const b8 equal = compare(lhs, rhs);
    NWB::Tests::MathCases::EqualityObservation obs{};
    obs.flags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    obs.rawFlags = _mm_getcsr() & 0x3Fu;
    obs.equal = equal;
    return obs;
}

template<typename Value, usize Count>
[[nodiscard]] b8 ObserveMxcsrEqualityFourWay(
    const u32 bits,
    const usize exceptionalLane,
    const usize mismatch,
    const b8 compareWithZero,
    NWB::Tests::MathCases::EqualityObservation& outStrict,
    NWB::Tests::MathCases::EqualityObservation& outActual,
    NWB::Tests::MathCases::EqualityObservation& outDefaultCtx,
    NWB::Tests::MathCases::EqualityObservation& outActualDefault
)noexcept{
#pragma STDC FENV_ACCESS ON
    Value lhs{};
    Value rhs{};
    for(usize lane = 0u; lane < Count; ++lane)
        lhs.raw[lane] = rhs.raw[lane] = static_cast<f32>(lane + 1u);
    lhs.raw[exceptionalLane] = BitCast<f32>(bits);
    rhs.raw[exceptionalLane] = compareWithZero ? 0.0f : BitCast<f32>(bits);
    if(mismatch < Count && mismatch != exceptionalLane)
        rhs.raw[mismatch] = rhs.raw[mismatch] + 1.0f;
    const auto strict = ObserveEquality(lhs, rhs, LegacyEqual<Value, Count>);
    const auto actual = ObserveEquality(lhs, rhs, StorageEqual<Value>);
    const auto defaultCtx = ObserveEquality(lhs, rhs, DefaultContextLegacyEqual<Value, Count>);
    const auto actualDefault = ObserveEquality(lhs, rhs, StorageEqual<Value>);
    if(!strict || !actual || !defaultCtx || !actualDefault)
        return false;
    outStrict = *strict;
    outActual = *actual;
    outDefaultCtx = *defaultCtx;
    outActualDefault = *actualDefault;
    return true;
}
#endif

