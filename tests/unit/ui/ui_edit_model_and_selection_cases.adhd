void VerifyUiEditSurroundingSelectionTests_OneSidedCountsAddressNormalizedSelectionEdgesForEitherDirection(mut UiEditSurroundingSelectionTests self){
    Array<b8, 2u> directions = Array<b8, 2u>();
    directions[0u] = false;
    directions[1u] = true;
    for(in b8 reverse : directions){
        usize selStart = 3u;
        usize selEnd = 6u;
        usize expectedBeforeAnchor = 1u;
        usize expectedBeforeCaret = 4u;
        if(reverse){
            selStart = 6u;
            selEnd = 3u;
            expectedBeforeAnchor = 4u;
            expectedBeforeCaret = 1u;
        }
        EditModel before = EditModel(self.m_arena);
        ASSERT_TRUE(before.setText(s_UiEditSelectionSampleText));
        ASSERT_TRUE(before.setSelection(selStart, selEnd));
        ASSERT_TRUE(before.eraseAroundSelection(2u, 0u));
        EXPECT_EQ(before.text(), "aDEFghi");
        EXPECT_EQ(before.selectedText(), "DEF");
        EXPECT_EQ(before.anchor(), expectedBeforeAnchor);
        EXPECT_EQ(before.caret(), expectedBeforeCaret);

        EditModel after = EditModel(self.m_arena);
        ASSERT_TRUE(after.setText(s_UiEditSelectionSampleText));
        ASSERT_TRUE(after.setSelection(selStart, selEnd));
        ASSERT_TRUE(after.eraseAroundSelection(0u, 2u));
        EXPECT_EQ(after.text(), "abcDEFi");
        EXPECT_EQ(after.selectedText(), "DEF");
        EXPECT_EQ(after.anchor(), selStart);
        EXPECT_EQ(after.caret(), selEnd);
    }
}

void VerifyUiEditSurroundingSelectionTests_CollapsedSelectionDeletesAroundTheCaretAndStaysCollapsed(mut UiEditSurroundingSelectionTests self){
    ASSERT_TRUE(self.m_model.setText("abcdef"));
    ASSERT_TRUE(self.m_model.setSelection(3u, 3u));
    ASSERT_TRUE(self.m_model.eraseAroundSelection(2u, 1u));
    EXPECT_EQ(self.m_model.text(), "aef");
    EXPECT_EQ(self.m_model.anchor(), 1u);
    EXPECT_EQ(self.m_model.caret(), 1u);
    EXPECT_FALSE(self.m_model.hasSelection());
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "abcdef");
    EXPECT_EQ(self.m_model.anchor(), 3u);
    EXPECT_EQ(self.m_model.caret(), 3u);
    EXPECT_FALSE(self.m_model.canUndo());
}

void VerifyUiEditSurroundingSelectionTests_RemovingAllOutsideBytesLeavesTheCompleteSelection(mut UiEditSurroundingSelectionTests self){
    ASSERT_TRUE(self.m_model.setText(s_UiEditSelectionSampleText));
    ASSERT_TRUE(self.m_model.setSelection(3u, 6u));
    ASSERT_TRUE(self.m_model.eraseAroundSelection(3u, 3u));
    EXPECT_EQ(self.m_model.text(), "DEF");
    EXPECT_EQ(self.m_model.anchor(), 0u);
    EXPECT_EQ(self.m_model.caret(), 3u);
    EXPECT_EQ(self.m_model.selectedText(), "DEF");
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), s_UiEditSelectionSampleText);
    EXPECT_EQ(self.m_model.anchor(), 3u);
    EXPECT_EQ(self.m_model.caret(), 6u);
    ASSERT_TRUE(self.m_model.redo());
    EXPECT_EQ(self.m_model.text(), "DEF");
}

void VerifyUiEditSurroundingSelectionTests_SelectedCombiningAndZwjEmojiGraphemesRemainByteExact(mut UiEditSurroundingSelectionTests self){
    const StringView selected = "e\xCC\x81\xF0\x9F\x91\xA9\xE2\x80\x8D\xF0\x9F\x92\xBB";
    ASSERT_EQ(selected.size(), 14u);
    ASSERT_TRUE(self.m_model.setText("abe\xCC\x81\xF0\x9F\x91\xA9\xE2\x80\x8D\xF0\x9F\x92\xBByz"));
    ASSERT_TRUE(self.m_model.setSelection(2u, 16u));
    ASSERT_TRUE(self.m_model.eraseAroundSelection(1u, 1u));
    EXPECT_EQ(self.m_model.text(), "ae\xCC\x81\xF0\x9F\x91\xA9\xE2\x80\x8D\xF0\x9F\x92\xBBz");
    EXPECT_EQ(self.m_model.selectedText(), selected);
    EXPECT_EQ(self.m_model.anchor(), 1u);
    EXPECT_EQ(self.m_model.caret(), 15u);
    EXPECT_EQ(self.m_model.graphemeBoundaries().size(), 5u);
}

void VerifyUiEditSurroundingSelectionTests_MultilineSelectionKeepsItsLfBytesAndReverseDirection(mut UiEditSurroundingSelectionTests self){
    EditModel model = EditModel(self.m_arena, EditLimits(), EditTextMode::Multiline);
    ASSERT_TRUE(model.setText("ab\nC\nD\nef"));
    ASSERT_TRUE(model.setSelection(7u, 2u));
    ASSERT_TRUE(model.eraseAroundSelection(1u, 1u));
    EXPECT_EQ(model.text(), "a\nC\nD\nf");
    EXPECT_EQ(model.selectedText(), "\nC\nD\n");
    EXPECT_EQ(model.anchor(), 6u);
    EXPECT_EQ(model.caret(), 1u);
    ASSERT_TRUE(model.undo());
    EXPECT_EQ(model.text(), "ab\nC\nD\nef");
    EXPECT_EQ(model.anchor(), 7u);
    EXPECT_EQ(model.caret(), 2u);
    EXPECT_FALSE(model.canUndo());
}

void VerifyUiEditSurroundingSelectionTests_AcceptedDeletionCancelsPreeditWithoutAddingTransientHistory(mut UiEditSurroundingSelectionTests self){
    ASSERT_TRUE(self.m_model.setText(s_UiEditSelectionSampleText));
    ASSERT_TRUE(self.m_model.setSelection(3u, 6u));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("transient", 0u, 9u));
    const u64 revision = self.m_model.revision();
    const u64 selection = self.m_model.selectionGeneration();
    const u64 composition = self.m_model.compositionGeneration();
    const u64 external = self.m_model.externalRevision();
    ASSERT_TRUE(self.m_model.eraseAroundSelection(2u, 1u));
    EXPECT_EQ(self.m_model.text(), "aDEFhi");
    EXPECT_EQ(self.m_model.anchor(), 1u);
    EXPECT_EQ(self.m_model.caret(), 4u);
    EXPECT_FALSE(self.m_model.composition().active);
    EXPECT_TRUE(self.m_model.composition().text.empty());
    EXPECT_EQ(self.m_model.revision(), revision + 1u);
    EXPECT_EQ(self.m_model.selectionGeneration(), selection + 1u);
    EXPECT_EQ(self.m_model.compositionGeneration(), composition + 1u);
    EXPECT_EQ(self.m_model.externalRevision(), external);
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), s_UiEditSelectionSampleText);
    EXPECT_EQ(self.m_model.anchor(), 3u);
    EXPECT_EQ(self.m_model.caret(), 6u);
    EXPECT_FALSE(self.m_model.canUndo());
    EXPECT_FALSE(self.m_model.composition().active);
}

void VerifyUiEditSurroundingSelectionTests_ZeroCountsPreserveSelectionPreeditHistoryAndAllEpochs(mut UiEditSurroundingSelectionTests self){
    ASSERT_TRUE(SeedUiEditSurroundingHistoryAndPreedit(s_UiEditSelectionSampleText, 6u, 3u, self.m_model));
    const MultilineSnapshot before = MultilineSnapshot(self.m_arena, self.m_model);
    ASSERT_TRUE(self.m_model.eraseAroundSelection(0u, 0u));
    before.expectUnchanged(self.m_model);
    ExpectUiEditRetainedHistory(s_UiEditSelectionSampleText, self.m_model);
}

void VerifyUiEditSurroundingSelectionTests_OutOfRangeCountsPreserveTheCompleteDraftAndRedoBranch(mut UiEditSurroundingSelectionTests self){
    ASSERT_TRUE(SeedUiEditSurroundingHistoryAndPreedit(s_UiEditSelectionSampleText, 3u, 6u, self.m_model));
    const MultilineSnapshot before = MultilineSnapshot(self.m_arena, self.m_model);
    EXPECT_FALSE(self.m_model.eraseAroundSelection(4u, 0u));
    before.expectUnchanged(self.m_model);
    EXPECT_FALSE(self.m_model.eraseAroundSelection(0u, 4u));
    before.expectUnchanged(self.m_model);
    EXPECT_FALSE(self.m_model.eraseAroundSelection(usize.max, 0u));
    before.expectUnchanged(self.m_model);
    EXPECT_FALSE(self.m_model.eraseAroundSelection(0u, usize.max));
    before.expectUnchanged(self.m_model);
    ExpectUiEditRetainedHistory(s_UiEditSelectionSampleText, self.m_model);
}

void VerifyUiEditSurroundingSelectionTests_OriginalCutsRejectBothUtf8SplitsAndScalarValidGraphemeSplits(mut UiEditSurroundingSelectionTests self){
    const StringView text = "ae\314\201DEF\xF0\x9F\x91\xA9\xE2\x80\x8D\xF0\x9F\x92\xBBz";
    ASSERT_TRUE(SeedUiEditSurroundingHistoryAndPreedit(text, 4u, 7u, self.m_model));
    const MultilineSnapshot before = MultilineSnapshot(self.m_arena, self.m_model);
    EXPECT_FALSE(IsUtf8ScalarBoundary(text, 3u));
    EXPECT_TRUE(IsUtf8ScalarBoundary(text, 2u));
    EXPECT_FALSE(IsUtf8ScalarBoundary(text, 8u));
    EXPECT_TRUE(IsUtf8ScalarBoundary(text, 11u));
    EXPECT_FALSE(self.m_model.eraseAroundSelection(1u, 0u));
    before.expectUnchanged(self.m_model);
    EXPECT_FALSE(self.m_model.eraseAroundSelection(2u, 0u));
    before.expectUnchanged(self.m_model);
    EXPECT_FALSE(self.m_model.eraseAroundSelection(0u, 1u));
    before.expectUnchanged(self.m_model);
    EXPECT_FALSE(self.m_model.eraseAroundSelection(0u, 4u));
    before.expectUnchanged(self.m_model);
    ExpectUiEditRetainedHistory(text, self.m_model);
}

void VerifyUiEditSurroundingSelectionTests_CandidateSeamMergesRejectEitherEndpointWithoutSnappingOrCancelling(mut UiEditSurroundingSelectionTests self){
    Array<UiEditSeamMergeCase, 2u> cases = Array<UiEditSeamMergeCase, 2u>();
    cases[0u] = MakeUiEditSeamMergeCase("\xF0\x9F\x87\xA6x\xF0\x9F\x87\xA7z", 5u, 9u, 1u, 0u, "\xF0\x9F\x87\xA6\xF0\x9F\x87\xA7z", 4u);
    cases[1u] = MakeUiEditSeamMergeCase("z\xF0\x9F\x87\xA6x\xF0\x9F\x87\xA7q", 1u, 5u, 0u, 1u, "z\xF0\x9F\x87\xA6\xF0\x9F\x87\xA7q", 5u);
    for(in UiEditSeamMergeCase value : cases){
        EditModel model = EditModel(self.m_arena);
        ASSERT_TRUE(SeedUiEditSurroundingHistoryAndPreedit(value.text, value.anchor, value.caret, model));
        const MultilineSnapshot before = MultilineSnapshot(self.m_arena, model);
        EditModel merged = EditModel(self.m_arena);
        ASSERT_TRUE(merged.setText(value.merged));
        EXPECT_TRUE(IsUtf8ScalarBoundary(value.merged, value.lostBoundary));
        EXPECT_FALSE(merged.setSelection(value.lostBoundary, value.lostBoundary));
        EXPECT_FALSE(model.eraseAroundSelection(value.before, value.after));
        before.expectUnchanged(model);
        ExpectUiEditRetainedHistory(value.text, model);
    }
}


