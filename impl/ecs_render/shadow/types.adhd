class LightSpaceShadowGraph{
    public ShadowGpuGraphResourceId counts = ShadowGpuGraphResourceId();
    public ShadowGpuGraphResourceId events = ShadowGpuGraphResourceId();
    public ShadowGpuGraphResourceId views = ShadowGpuGraphResourceId();
