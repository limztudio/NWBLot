#include <impl/assets_mesh/cook.adhd>
#include <impl/assets_mesh/cook_metadata_value.adhd>
#include <impl/assets_mesh/skin_asset.adhd>
#include <impl/assets_subsystem/cook.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


register_asset SkinningSubsystem using SubsystemCookRegistration<SkinningSubsystem>;

[cook_entry("skin", s_SkinMetaDiagnosticPrefix, ParseSkinCookMetadata, document_and_value, log_failure)]
Expected<Skin> CookSkinVolumeEntry(in SkinCookEntry entry){
    return BuildSkinAsset(entry);
}

b8 ExtractSkinDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    const Expected<AssetRef<Mesh>> meshRef = ReadMetadataAssetRefField<Mesh>(context.nwbFilePath, context.asset, s_SkinMetaDiagnosticPrefix, s_SkinMetaMeshField, true);
    if(!meshRef.has_value())
        return false;
    const Expected<AssetRef<Skeleton>> skeletonRef = ReadMetadataAssetRefField<Skeleton>(context.nwbFilePath, context.asset, s_SkinMetaDiagnosticPrefix, s_SkinMetaSkeletonField, true);
    if(!skeletonRef.has_value())
        return false;
    if(!collector.addAssetDependency(meshRef.value().name(), Mesh::AssetTypeName()))
        return false;
    return collector.addAssetDependency(skeletonRef.value().name(), Skeleton::AssetTypeName());
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cook_entry("mesh", s_MeshMetaText, ParseMeshCookMetadata, document_and_value, log_failure)]
Expected<Mesh> CookMeshVolumeEntry(mut MeshCookEntry entry){
    return BuildMeshAsset(entry);
}

[cook_registrar]
b8 RegisterSkinCookDependency(mut CookDependencyRegistry registry){
    return registry.registerType(Skin::AssetTypeName(), ExtractSkinDependencies);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

