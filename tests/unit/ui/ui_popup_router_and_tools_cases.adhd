void VerifyUiPopupRouterTests_AcceptedPopupBlocksUnderlyingHitTargetsDespiteTheirLaterPaintOrder(mut UiPopupRouterTests self){
    const PopupScope scope = MakeUiPopupRouterScope();
    Array<HitTarget, 5u> targets = MakeUiPopupRouterTargets(scope);
    targets[0u].rectangle = scope.viewport;
    targets[0u].paintOrder = u32.max;
    ASSERT_TRUE(self.commitWithScope(targets, 1u, scope));
    EXPECT_TRUE(self.m_router.hasPopup());
    EXPECT_TRUE(self.m_router.wantsCommands());
    EXPECT_TRUE(self.m_router.wantsPointer());
    EXPECT_EQ(self.m_router.focus().value, 101u);
    EXPECT_EQ(self.m_router.hitTest(MakeUiPopupRouterPoint(55.0f, 55.0f)).value, 101u);
    EXPECT_EQ(self.m_router.hitTest(MakeUiPopupRouterPoint(45.0f, 45.0f)).value, 100u);
    EXPECT_FALSE(self.m_router.hitTest(MakeUiPopupRouterPoint(15.0f, 15.0f)).valid());
    EXPECT_TRUE(self.m_router.wouldConsumePointer(MakeUiPopupRouterPoint(15.0f, 15.0f)));
    self.click(MakeUiPopupRouterPoint(55.0f, 55.0f));
    EXPECT_TRUE(self.m_router.consumeActivation(MakeUiPopupRouterWidgetId(101u)));
    EXPECT_FALSE(self.m_router.consumeActivation(MakeUiPopupRouterWidgetId(1u)));
}

void VerifyUiPopupRouterTests_TabAndReverseTabWrapOnlyWithinTheAcceptedTopScope(mut UiPopupRouterTests self){
    const PopupScope scope = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(scope, 1u));
    EXPECT_EQ(self.m_router.focus().value, 101u);
    self.key(Key::Tab);
    EXPECT_EQ(self.m_router.focus().value, 102u);
    self.key(Key::Tab);
    EXPECT_EQ(self.m_router.focus().value, 101u);
    self.key(Key::Tab, true);
    EXPECT_EQ(self.m_router.focus().value, 102u);
    self.key(Key::Enter);
    EXPECT_TRUE(self.m_router.consumeActivation(MakeUiPopupRouterWidgetId(102u)));
    EXPECT_FALSE(self.m_router.consumeActivation(MakeUiPopupRouterWidgetId(1u)));
    EXPECT_FALSE(self.m_router.consumeActivation(MakeUiPopupRouterWidgetId(2u)));
}

void VerifyUiPopupRouterTests_OptedInSingleStopPopupTabsToTheNextParentStopAfterAcceptance(mut UiPopupRouterTests self){
    self.focusBase();
    PopupScope scope = MakeUiPopupRouterScope();
    scope.dismissFocusTraversal = true;
    scope.focusAnchor.value = 1u;
    scope.focusAnchorDeclarationGeneration = 1u;
    const Array<HitTarget, 5u> targets = MakeUiPopupRouterTargets(scope);
    ASSERT_TRUE(self.commitCountWithScope(targets, 4u, 2u, scope));
    ASSERT_EQ(self.m_router.focus().value, 101u);
    EXPECT_TRUE(self.send(MakeUiPopupRouterKeyEvent(InputEventType::KeyDown, Key::Tab, false)).commandConsumed);
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_TRUE(self.send(MakeUiPopupRouterKeyEvent(InputEventType::KeyDown, Key::Tab, true)).commandConsumed);
    const auto reasonResult = self.m_router.consumePopupDismissal(scope.token);
    ASSERT_TRUE(reasonResult.has_value());
    EXPECT_EQ(reasonResult.value(), PopupDismissReason::FocusTraversal);
    EXPECT_FALSE(self.m_router.consumePopupDismissal(scope.token).has_value());
    const Array<HitTarget, 2u> base = MakeUiPopupRouterBaseTargets();
    ASSERT_TRUE(self.m_router.commitTargets(base, 3u));
    EXPECT_EQ(self.m_router.focus().value, 2u);
    EXPECT_TRUE(self.send(MakeUiPopupRouterKeyEvent(InputEventType::KeyUp, Key::Tab, false)).commandConsumed);
    EXPECT_FALSE(self.m_router.ownsKey(Key::Tab));
}

void VerifyUiPopupRouterTests_OptedInPopupReverseTabsToThePreviousParentStop(mut UiPopupRouterTests self){
    self.focusBase();
    PopupScope scope = MakeUiPopupRouterScope();
    scope.dismissFocusTraversal = true;
    scope.focusAnchor.value = 1u;
    scope.focusAnchorDeclarationGeneration = 1u;
    const Array<HitTarget, 5u> targets = MakeUiPopupRouterTargets(scope);
    ASSERT_TRUE(self.commitCountWithScope(targets, 4u, 2u, scope));
    ASSERT_EQ(self.m_router.focus().value, 101u);
    self.key(Key::Tab, true);
    const auto reasonResult = self.m_router.consumePopupDismissal(scope.token);
    ASSERT_TRUE(reasonResult.has_value());
    EXPECT_EQ(reasonResult.value(), PopupDismissReason::FocusTraversal);
    const Array<HitTarget, 2u> base = MakeUiPopupRouterBaseTargets();
    ASSERT_TRUE(self.m_router.commitTargets(base, 3u));
    EXPECT_EQ(self.m_router.focus().value, 2u);
}

void VerifyUiPopupRouterTests_OptedInTwoStopPopupMovesInsideBeforeLeaving(mut UiPopupRouterTests self){
    self.focusBase();
    PopupScope scope = MakeUiPopupRouterScope();
    scope.dismissFocusTraversal = true;
    scope.focusAnchor.value = 1u;
    scope.focusAnchorDeclarationGeneration = 1u;
    ASSERT_TRUE(self.install(scope, 2u));
    ASSERT_EQ(self.m_router.focus().value, 101u);
    self.key(Key::Tab);
    EXPECT_EQ(self.m_router.focus().value, 102u);
    EXPECT_FALSE(self.m_router.consumePopupDismissal(scope.token).has_value());
    self.key(Key::Tab, true);
    EXPECT_EQ(self.m_router.focus().value, 101u);
    EXPECT_FALSE(self.m_router.consumePopupDismissal(scope.token).has_value());
    self.key(Key::Tab);
    self.key(Key::Tab);
    const auto reasonResult = self.m_router.consumePopupDismissal(scope.token);
    ASSERT_TRUE(reasonResult.has_value());
    EXPECT_EQ(reasonResult.value(), PopupDismissReason::FocusTraversal);
}

void VerifyUiPopupRouterTests_EmptyPopupStillOwnsKeysAndOutsidePointerInput(mut UiPopupRouterTests self){
    const PopupScope scope = MakeUiPopupRouterScope();
    const Array<HitTarget, 2u> base = MakeUiPopupRouterBaseTargets();
    Array<HitTarget, 3u> targets = Array<HitTarget, 3u>();
    targets[0u] = base[0u];
    targets[1u] = base[1u];
    targets[2u] = MakeUiPopupRouterBarrier(scope);
    ASSERT_TRUE(self.commitWithScope(targets, 1u, scope));
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_TRUE(self.m_router.wantsCommands());
    self.key(Key::Tab);
    EXPECT_FALSE(self.m_router.focus().valid());
    self.key(Key::Enter);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointerEvent(InputEventType::PointerMove, 15.0f, 15.0f)).pointerConsumed);
    self.key(Key::Escape);
    const auto reasonResult = self.m_router.consumePopupDismissal(scope.token);
    ASSERT_TRUE(reasonResult.has_value());
    EXPECT_EQ(reasonResult.value(), PopupDismissReason::Cancel);
}

void VerifyUiPopupRouterTests_AutofocusFalseClearsUnderlyingFocusAndWaitsForExplicitTab(mut UiPopupRouterTests self){
    self.focusBase();
    PopupScope scope = MakeUiPopupRouterScope();
    scope.autofocus = false;
    ASSERT_TRUE(self.install(scope, 2u));
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_TRUE(self.m_router.wantsCommands());
    self.key(Key::Enter);
    EXPECT_TRUE(self.m_router.actions().empty());
    self.key(Key::Tab);
    EXPECT_EQ(self.m_router.focus().value, 101u);
}

void VerifyUiPopupRouterTests_OutsideDismissalConsumesItsEntirePressAcrossAcceptedRemoval(mut UiPopupRouterTests self){
    self.focusBase();
    const PopupScope scope = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(scope, 2u));
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointerEvent(InputEventType::PrimaryDown, 15.0f, 15.0f)).pointerConsumed);
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.m_router.hasPopup());
    EXPECT_TRUE(self.m_router.wantsPointer());
    const auto reasonResult = self.m_router.consumePopupDismissal(scope.token);
    ASSERT_TRUE(reasonResult.has_value());
    EXPECT_EQ(reasonResult.value(), PopupDismissReason::OutsideClick);
    EXPECT_FALSE(self.m_router.consumePopupDismissal(scope.token).has_value());
    const Array<HitTarget, 2u> base = MakeUiPopupRouterBaseTargets();
    ASSERT_TRUE(self.m_router.commitTargets(base, 3u));
    EXPECT_FALSE(self.m_router.hasPopup());
    EXPECT_EQ(self.m_router.focus().value, 1u);
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointerEvent(InputEventType::PointerMove, 15.0f, 15.0f)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointerEvent(InputEventType::PrimaryUp, 15.0f, 15.0f)).pointerConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(MakeUiPopupRouterWidgetId(1u)));
    self.click(MakeUiPopupRouterPoint(15.0f, 15.0f));
    EXPECT_TRUE(self.m_router.consumeActivation(MakeUiPopupRouterWidgetId(1u)));
}

void VerifyUiPopupRouterTests_EscapeDismissalPreservesHeldKeyOwnershipAcrossAcceptedRemoval(mut UiPopupRouterTests self){
    self.focusBase();
    const PopupScope scope = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(scope, 2u));
    EXPECT_TRUE(self.send(MakeUiPopupRouterKeyEvent(InputEventType::KeyDown, Key::Escape, false)).commandConsumed);
    EXPECT_TRUE(self.m_router.ownsKey(Key::Escape));
    const auto reasonResult = self.m_router.consumePopupDismissal(scope.token);
    ASSERT_TRUE(reasonResult.has_value());
    EXPECT_EQ(reasonResult.value(), PopupDismissReason::Cancel);
    const Array<HitTarget, 2u> base = MakeUiPopupRouterBaseTargets();
    ASSERT_TRUE(self.m_router.commitTargets(base, 3u));
    EXPECT_EQ(self.m_router.focus().value, 1u);
    EXPECT_TRUE(self.send(MakeUiPopupRouterKeyEvent(InputEventType::KeyUp, Key::Escape, false)).commandConsumed);
    EXPECT_FALSE(self.m_router.ownsKey(Key::Escape));
    EXPECT_EQ(self.m_router.focus().value, 1u);
}

void VerifyUiPopupRouterTests_NonDismissibleModalBlocksOutsideAndEscapeWithoutPublishingDismissals(mut UiPopupRouterTests self){
    PopupScope scope = MakeUiPopupRouterScope();
    scope.dismissOutside = false;
    scope.dismissCancel = false;
    ASSERT_TRUE(self.install(scope, 1u));
    self.click(MakeUiPopupRouterPoint(15.0f, 15.0f));
    self.key(Key::Escape);
    EXPECT_TRUE(self.m_router.hasPopup());
    EXPECT_EQ(self.m_router.focus().value, 101u);
    EXPECT_FALSE(self.m_router.dismissPopup(PopupDismissReason::OutsideClick));
    EXPECT_FALSE(self.m_router.dismissPopup(PopupDismissReason::Cancel));
    EXPECT_FALSE(self.m_router.dismissPopup(PopupDismissReason::None));
    EXPECT_FALSE(self.m_router.consumePopupDismissal(scope.token).has_value());
    EXPECT_TRUE(self.m_router.actions().empty());
}

void VerifyUiPopupRouterTests_ClosingTokenSuppressesActionsUntilItsAcceptedRemovalAndPublishesNoDismissal(mut UiPopupRouterTests self){
    self.focusBase();
    const PopupScope scope = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(scope, 2u));
    self.click(MakeUiPopupRouterPoint(55.0f, 55.0f));
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    self.m_router.closePopup(scope.token);
    EXPECT_TRUE(self.m_router.hasPopup());
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.hitTest(MakeUiPopupRouterPoint(55.0f, 55.0f)).valid());
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.m_router.wantsCommands());
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointerEvent(InputEventType::PointerMove, 15.0f, 15.0f)).pointerConsumed);
    self.key(Key::Enter);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.consumePopupDismissal(scope.token).has_value());
    const Array<HitTarget, 2u> base = MakeUiPopupRouterBaseTargets();
    ASSERT_TRUE(self.m_router.commitTargets(base, 3u));
    EXPECT_FALSE(self.m_router.hasPopup());
    EXPECT_EQ(self.m_router.focus().value, 1u);
}

void VerifyUiPopupRouterTests_SameOpenEpochRetainsChosenChildFocusAcrossAcceptedGeometryUpdates(mut UiPopupRouterTests self){
    self.focusBase();
    PopupScope scope = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(scope, 2u));
    self.key(Key::Tab);
    ASSERT_EQ(self.m_router.focus().value, 102u);
    scope.bounds = MakeUiPopupRouterRect(60.0f, 30.0f, 100.0f, 70.0f);
    Array<HitTarget, 5u> targets = MakeUiPopupRouterTargets(scope);
    targets[3u].rectangle = MakeUiPopupRouterRect(70.0f, 40.0f, 30.0f, 20.0f);
    targets[4u].rectangle = MakeUiPopupRouterRect(110.0f, 40.0f, 30.0f, 20.0f);
    ASSERT_TRUE(self.commitWithScope(targets, 3u, scope));
    EXPECT_EQ(self.m_router.focus().value, 102u);
    EXPECT_EQ(self.m_router.hitTest(MakeUiPopupRouterPoint(115.0f, 45.0f)).value, 102u);
    EXPECT_FALSE(self.m_router.hitTest(MakeUiPopupRouterPoint(55.0f, 55.0f)).valid());
    self.m_router.closePopup(scope.token);
    const Array<HitTarget, 2u> base = MakeUiPopupRouterBaseTargets();
    ASSERT_TRUE(self.m_router.commitTargets(base, 4u));
    EXPECT_EQ(self.m_router.focus().value, 1u);
}

void VerifyUiPopupRouterTests_ReopenedEpochFencesOldCloseAndDismissalTokens(mut UiPopupRouterTests self){
    self.focusBase();
    const PopupScope original = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(original, 2u));
    self.key(Key::Escape);
    const PopupScope reopened = MakeUiPopupRouterScopeEpoch(100u, 3u, 2u);
    ASSERT_TRUE(self.install(reopened, 3u));
    EXPECT_EQ(self.m_router.focus().value, 101u);
    self.m_router.closePopup(original.token);
    EXPECT_EQ(self.m_router.focus().value, 101u);
    EXPECT_EQ(self.m_router.hitTest(MakeUiPopupRouterPoint(55.0f, 55.0f)).value, 101u);
    EXPECT_FALSE(self.m_router.consumePopupDismissal(reopened.token).has_value());
    self.m_router.closePopup(reopened.token);
    const Array<HitTarget, 2u> base = MakeUiPopupRouterBaseTargets();
    ASSERT_TRUE(self.m_router.commitTargets(base, 4u));
    EXPECT_EQ(self.m_router.focus().value, 1u);
}

void VerifyUiPopupRouterTests_ReopenedEpochCannotReplayQueuedActivationWithTheSameChildIdAndDeclaration(mut UiPopupRouterTests self){
    const PopupScope original = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(original, 1u));
    self.click(MakeUiPopupRouterPoint(55.0f, 55.0f));
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    const u64 originalSequence = self.m_router.actions()[0u].id.sequence;
    const PopupScope reopened = MakeUiPopupRouterScopeEpoch(100u, 3u, 2u);
    ASSERT_TRUE(self.install(reopened, 2u));
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.consumeActivation(MakeUiPopupRouterWidgetId(101u)));
    self.click(MakeUiPopupRouterPoint(55.0f, 55.0f));
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_GT(self.m_router.actions()[0u].id.sequence, originalSequence);
    EXPECT_TRUE(self.m_router.consumeActivation(MakeUiPopupRouterWidgetId(101u)));
    EXPECT_FALSE(self.m_router.consumeActivation(MakeUiPopupRouterWidgetId(101u)));
}

void VerifyUiPopupRouterTests_ReopenedEpochCancelsOldCaptureWithoutTransferringItsReleaseToTheNewChild(mut UiPopupRouterTests self){
    const PopupScope original = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(original, 1u));
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointerEvent(InputEventType::PrimaryDown, 55.0f, 55.0f)).pointerConsumed);
    ASSERT_EQ(self.m_router.capture().value, 101u);
    const PopupScope reopened = MakeUiPopupRouterScopeEpoch(100u, 3u, 2u);
    ASSERT_TRUE(self.install(reopened, 2u));
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointerEvent(InputEventType::PrimaryUp, 55.0f, 55.0f)).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.consumeActivation(MakeUiPopupRouterWidgetId(101u)));
    self.click(MakeUiPopupRouterPoint(55.0f, 55.0f));
    EXPECT_TRUE(self.m_router.consumeActivation(MakeUiPopupRouterWidgetId(101u)));
}

void VerifyUiPopupRouterTests_HeldEscapeDoesNotDismissTheNewlyAcceptedLowerScopeOnRepeatOrDuplicateDown(mut UiPopupRouterTests self){
    const PopupScope lower = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(lower, 1u));
    const PopupScope higher = MakeUiPopupRouterScopeLayer(200u, 5u);
    const Array<HitTarget, 7u> targets = MakeUiPopupRouterTwoLayerTargets(lower, higher);
    Array<PopupScope, 2u> scopes = Array<PopupScope, 2u>();
    scopes[0u] = lower;
    scopes[1u] = higher;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 2u, scopes));
    EXPECT_TRUE(self.send(MakeUiPopupRouterKeyEvent(InputEventType::KeyDown, Key::Escape, false)).commandConsumed);
    const auto reasonResult1 = self.m_router.consumePopupDismissal(higher.token);
    ASSERT_TRUE(reasonResult1.has_value());
    EXPECT_EQ(reasonResult1.value(), PopupDismissReason::Cancel);
    ASSERT_TRUE(self.install(lower, 3u));
    EXPECT_EQ(self.m_router.focus().value, 101u);
    EXPECT_TRUE(self.send(MakeUiPopupRouterKeyEvent(InputEventType::KeyDown, Key::Escape, true)).commandConsumed);
    EXPECT_FALSE(self.m_router.consumePopupDismissal(lower.token).has_value());
    EXPECT_EQ(self.m_router.focus().value, 101u);
    EXPECT_TRUE(self.send(MakeUiPopupRouterKeyEvent(InputEventType::KeyDown, Key::Escape, false)).commandConsumed);
    EXPECT_FALSE(self.m_router.consumePopupDismissal(lower.token).has_value());
    EXPECT_EQ(self.m_router.focus().value, 101u);
    EXPECT_TRUE(self.send(MakeUiPopupRouterKeyEvent(InputEventType::KeyUp, Key::Escape, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiPopupRouterKeyEvent(InputEventType::KeyDown, Key::Escape, false)).commandConsumed);
    const auto reasonResult2 = self.m_router.consumePopupDismissal(lower.token);
    ASSERT_TRUE(reasonResult2.has_value());
    EXPECT_EQ(reasonResult2.value(), PopupDismissReason::Cancel);
    EXPECT_TRUE(self.send(MakeUiPopupRouterKeyEvent(InputEventType::KeyUp, Key::Escape, false)).commandConsumed);
}

void VerifyUiPopupRouterTests_RemovalNeverRestoresDisabledOrRecreatedUnderlyingFocus(mut UiPopupRouterTests self){
    self.focusBase();
    const PopupScope scope = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(scope, 2u));
    Array<HitTarget, 2u> base = MakeUiPopupRouterBaseTargets();
    base[0u].enabled = false;
    ASSERT_TRUE(self.m_router.commitTargets(base, 3u));
    EXPECT_FALSE(self.m_router.focus().valid());
    base[0u].enabled = true;
    ASSERT_TRUE(self.m_router.commitTargets(base, 4u));
    self.key(Key::Tab);
    ASSERT_EQ(self.m_router.focus().value, 1u);
    const PopupScope reopened = MakeUiPopupRouterScopeEpoch(100u, 3u, 2u);
    ASSERT_TRUE(self.install(reopened, 5u));
    base[0u].declarationGeneration = 2u;
    ASSERT_TRUE(self.m_router.commitTargets(base, 6u));
    EXPECT_FALSE(self.m_router.focus().valid());
}

