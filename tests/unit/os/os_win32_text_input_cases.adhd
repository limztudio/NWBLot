inline constexpr isize s_Win32TrueResult = static_cast<isize>(TRUE);
inline constexpr isize s_Win32GcsResultStr = static_cast<isize>(GCS_RESULTSTR);
inline constexpr isize s_Win32CsInsertChar = static_cast<isize>(CS_INSERTCHAR);
inline constexpr isize s_Win32CsNoMoveCaret = static_cast<isize>(CS_NOMOVECARET);
inline constexpr isize s_Win32ShowUiCompositionWindowFlag = static_cast<isize>(ISC_SHOWUICOMPOSITIONWINDOW);
inline constexpr isize s_Win32ShowUiFullFlags = static_cast<isize>(ISC_SHOWUICOMPOSITIONWINDOW | ISC_SHOWUICANDIDATEWINDOW | (ISC_SHOWUICANDIDATEWINDOW << 2u) | (1u << 20u));
inline constexpr isize s_Win32ShowUiReplayFlags = static_cast<isize>(ISC_SHOWUICOMPOSITIONWINDOW | ISC_SHOWUICANDIDATEWINDOW | (1u << 20u));

class Win32TextInputFixture : public testing::Test{
public:
    static LRESULT CALLBACK WindowProc(const HWND window, const UINT message, const WPARAM wParam, const LPARAM lParam);

    Win32TextInputFixture()
        : m_loggerGuard(m_logger, Common::LoggerBreakPolicy::ReportOnly)
    {}

    virtual void SetUp()override;
    virtual void TearDown()override;


public:
    [[nodiscard]] TextInputSessionToken activeSession()const noexcept{ return m_service->activeSession(); }
    [[nodiscard]] b8 setFocused(const b8 focused){ return m_service->setFocused(focused); }
    [[nodiscard]] Expected<TextInputSessionToken, TextInputAdmission::Enum> beginEmpty(){ return m_service->begin({}); }
    [[nodiscard]] b8 endSession(const TextInputSessionToken token){ return m_service->end(token); }
    [[nodiscard]] TextInputPollResult::Enum poll(const TextInputSessionToken token, TextInputEvent& outEvent){ return m_service->poll(token, outEvent); }

    [[nodiscard]] isize sendChar(const u32 ch, const isize lParam){ return static_cast<isize>(SendMessageW(m_window, WM_CHAR, static_cast<WPARAM>(ch), static_cast<LPARAM>(lParam))); }
    [[nodiscard]] isize sendSysChar(const u32 ch, const isize lParam){ return static_cast<isize>(SendMessageW(m_window, WM_SYSCHAR, static_cast<WPARAM>(ch), static_cast<LPARAM>(lParam))); }
    [[nodiscard]] isize sendUniChar(const u32 ch, const isize lParam){ return static_cast<isize>(SendMessageW(m_window, WM_UNICHAR, static_cast<WPARAM>(ch), static_cast<LPARAM>(lParam))); }
    [[nodiscard]] isize sendImeStartComposition(){ return static_cast<isize>(SendMessageW(m_window, WM_IME_STARTCOMPOSITION, 0u, 0)); }
    [[nodiscard]] isize sendImeEndComposition(){ return static_cast<isize>(SendMessageW(m_window, WM_IME_ENDCOMPOSITION, 0u, 0)); }
    [[nodiscard]] isize sendImeChar(const u32 ch){ return static_cast<isize>(SendMessageW(m_window, WM_IME_CHAR, static_cast<WPARAM>(ch), 0)); }
    [[nodiscard]] isize sendImeComposition(const u32 ch, const isize flags){ return static_cast<isize>(SendMessageW(m_window, WM_IME_COMPOSITION, static_cast<WPARAM>(ch), static_cast<LPARAM>(flags))); }
    [[nodiscard]] isize sendImeSetContext(const b8 active, const isize flags){ return static_cast<isize>(SendMessageW(m_window, WM_IME_SETCONTEXT, active ? TRUE : FALSE, static_cast<LPARAM>(flags))); }
    [[nodiscard]] isize sendKillFocus(){ return static_cast<isize>(SendMessageW(m_window, WM_KILLFOCUS, 0u, 0)); }
    [[nodiscard]] isize sendSetFocus(){ return static_cast<isize>(SendMessageW(m_window, WM_SETFOCUS, 0u, 0)); }

    [[nodiscard]] b8 dispatchDirectChar(const u32 ch){ return DispatchWin32TextInputMessage(*m_service, WM_CHAR, static_cast<WPARAM>(ch), 0); }
    [[nodiscard]] Expected<u32> decodeFallbackChar(const u32 unit){ return DecodeWin32FallbackCharInput(*m_service, unit); }
    [[nodiscard]] b8 resetFallbackChar(){ return ResetWin32FallbackCharInput(*m_service); }


public:
    NWB::Tests::CapturingLogger m_logger;
    Common::LoggerRegistrationGuard m_loggerGuard;
    NWB::Tests::TestArena<> m_arena;
    GlobalUniquePtr<ITextInputService> m_service;
    HWND m_window = nullptr;
    TextInputSessionToken m_token;
    usize m_sceneCharacterCount = 0u;
    usize m_contextForwardCount = 0u;
    isize m_lastContextForwardedFlags = 0;
    LRESULT m_lastContextDefaultResult = 0;
    TextInputSessionToken m_cancelledDuringContextToken;
    u32 m_sceneCodePoint = 0u;
    b8 m_cancelOnNextContextForward = false;
    b8 m_contextFocusLossSucceeded = false;
    b8 m_contextFocusRestoreSucceeded = false;
};
#else
inline constexpr u32 s_Win32UnicodeNoChar = 0xFFFFu;
inline constexpr isize s_Win32TrueResult = 1;
inline constexpr isize s_Win32GcsResultStr = 0;
inline constexpr isize s_Win32CsInsertChar = 0;
inline constexpr isize s_Win32CsNoMoveCaret = 0;
inline constexpr isize s_Win32ShowUiCompositionWindowFlag = 0;
inline constexpr isize s_Win32ShowUiFullFlags = 0;
inline constexpr isize s_Win32ShowUiReplayFlags = 0;

class Win32TextInputFixture{
public:
    [[nodiscard]] TextInputSessionToken activeSession()const noexcept{ return {}; }
    [[nodiscard]] b8 setFocused(const b8)noexcept{ return false; }
    [[nodiscard]] Expected<TextInputSessionToken, TextInputAdmission::Enum> beginEmpty()noexcept{ return MakeUnexpected(TextInputAdmission::Unsupported); }
    [[nodiscard]] b8 endSession(const TextInputSessionToken)noexcept{ return false; }
