void VerifyUiTextAreaReentryTests_HostLoanResetRejectsWithoutClearingTheLentModel(mut UiTextAreaReentryTests self){
    ASSERT_TRUE(self.acceptBaseline());
    const UiTextAreaAcceptedInput16 before = self.accepted();
    usize attempts = 0u;
    b8 failedAtAttempt = false;
    const auto loanHook = lambda[mut self, mut attempts, mut failedAtAttempt]() -> void{
        ++attempts;
        EXPECT_TRUE(self.m_model.setText("owned\nmutation"));
        self.m_builder.reset();
        failedAtAttempt = self.m_builder.failed();
    };
    self.m_host.loanHook = loanHook;
    ASSERT_TRUE(self.beginArea(2u));
    EXPECT_FALSE(self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, UiTextAreaLoanOptions()).valid);
    EXPECT_EQ(attempts, 1u);
    EXPECT_TRUE(failedAtAttempt);
    EXPECT_EQ(self.m_host.loans, 1u);
    EXPECT_EQ(self.m_host.ordinaryLoans, 0u);
    EXPECT_EQ(self.m_host.actionLoans, 0u);
    EXPECT_EQ(self.m_host.publishes, 0u);
    EXPECT_EQ(self.m_model.text(), "owned\nmutation");
    self.expectRejected(before);
}

void VerifyUiTextAreaReentryTests_HostLoanNestedDeclarationRejectsBeforeASecondLoan(mut UiTextAreaReentryTests self){
    ASSERT_TRUE(self.acceptBaseline());
    const UiTextAreaAcceptedInput16 before = self.accepted();
    EditModel otherModel = EditModel(self.m_arena, EditLimits(), EditTextMode::Multiline);
    TextAreaState otherState = TextAreaState();
    ASSERT_TRUE(otherModel.setText("other\narea"));
    usize attempts = 0u;
    EditBoxResult nested = EditBoxResult();
    const auto loanHook = lambda[mut self, mut otherModel, mut otherState, mut attempts, mut nested]() -> void{
        ++attempts;
        nested = self.m_builder.textArea("reentered", otherModel, otherState, UiTextAreaLoanOptions());
    };
    self.m_host.loanHook = loanHook;
    ASSERT_TRUE(self.beginArea(2u));
    EXPECT_FALSE(self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, UiTextAreaLoanOptions()).valid);
    EXPECT_EQ(attempts, 1u);
    EXPECT_FALSE(nested.valid);
    EXPECT_EQ(self.m_host.loans, 1u);
    EXPECT_EQ(self.m_host.publishes, 0u);
    EXPECT_EQ(self.m_model.text(), "alpha\nbeta");
    EXPECT_EQ(otherModel.text(), "other\narea");
    self.expectRejected(before);
}

void VerifyUiTextAreaReentryTests_PublicationResetRejectsBeforeLaterAreaPublication(mut UiTextAreaReentryTests self){
    ASSERT_TRUE(self.acceptBaseline());
    const UiTextAreaAcceptedInput16 before = self.accepted();
    EditModel otherModel = EditModel(self.m_arena, EditLimits(), EditTextMode::Multiline);
    TextAreaState otherState = TextAreaState();
    ASSERT_TRUE(otherModel.setText("other\narea"));
    ASSERT_TRUE(self.beginArea(2u));
    ASSERT_TRUE(self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, UiTextAreaLoanOptions()).valid);
    ASSERT_TRUE(self.m_builder.textArea("other", otherModel, otherState, UiTextAreaLoanOptions()).valid);
    usize attempts = 0u;
    b8 failedAtAttempt = false;
    const auto publishHook = lambda[mut self, mut otherModel, mut attempts, mut failedAtAttempt]() -> void{
        ++attempts;
        EXPECT_TRUE(otherModel.setText("application\nmutation"));
        self.m_builder.reset();
        failedAtAttempt = self.m_builder.failed();
    };
    self.m_host.publishHook = publishHook;
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_EQ(attempts, 1u);
    EXPECT_TRUE(failedAtAttempt);
    EXPECT_EQ(self.m_host.publishes, 1u);
    ASSERT_EQ(self.m_host.publications.size(), 1u);
    EXPECT_EQ(UiTextAreaPublicationText(self.m_host.publications[0u]), "alpha\nbeta");
    EXPECT_EQ(self.m_model.text(), "alpha\nbeta");
    EXPECT_EQ(otherModel.text(), "application\nmutation");
    self.expectRejected(before);
}

void VerifyUiTextAreaReentryTests_ChildRowScopeReentryRejectsBeforeSiblingAreaPublication(mut UiTextAreaReentryTests self){
    ASSERT_TRUE(self.acceptBaseline());
    const UiTextAreaAcceptedInput16 before = self.accepted();
    UiTextAreaReentrySource source = UiTextAreaReentrySource();
    ListState list = ListState();
    EditModel siblingModel = EditModel(self.m_arena, EditLimits(), EditTextMode::Multiline);
    TextAreaState siblingState = TextAreaState();
    PopupState sibling = PopupState();
    ASSERT_TRUE(siblingModel.setText("sibling\narea"));
    self.m_parent.open();
    self.m_child.open();
    sibling.open();
    ASSERT_TRUE(self.beginParent(2u));
    ASSERT_TRUE(self.m_builder.textArea("parentArea", self.m_model, self.m_state, UiTextAreaLoanOptions()).valid);
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiTextAreaChildPopupKey, self.m_child, UiTextAreaLargeLoanChildOptions()));
    ASSERT_TRUE(self.m_builder.virtualList("list", source, list, UiTextAreaLargeLoanListOptions()).valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    ASSERT_TRUE(self.m_builder.beginPopup("sibling", sibling, UiTextAreaLargeLoanChildOptions()));
    ASSERT_TRUE(self.m_builder.textArea("siblingArea", siblingModel, siblingState, UiTextAreaLoanOptions()).valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    b8 beginAccepted = true;
    b8 endAccepted = true;
    b8 failedAtAttempt = false;
    source.rowHook = lambda[mut self, mut beginAccepted, mut endAccepted, mut failedAtAttempt]() -> void{
        Rect bounds = Rect();
        bounds.x = 0.0f;
        bounds.y = 0.0f;
        bounds.width = 100.0f;
        bounds.height = 80.0f;
        beginAccepted = self.m_builder.beginPanel("reentered", bounds);
        endAccepted = self.m_builder.endPanel();
        failedAtAttempt = self.m_builder.failed();
    };
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_EQ(source.attempts, 1u);
    EXPECT_EQ(source.callbacksAfterAttempt, 0u);
    EXPECT_FALSE(beginAccepted);
    EXPECT_FALSE(endAccepted);
    EXPECT_TRUE(failedAtAttempt);
    EXPECT_EQ(self.m_host.loans, 2u);
    EXPECT_EQ(self.m_host.publishes, 1u);
    ASSERT_EQ(self.m_host.publications.size(), 1u);
    EXPECT_EQ(UiTextAreaPublicationText(self.m_host.publications[0u]), "alpha\nbeta");
    EXPECT_EQ(siblingModel.text(), "sibling\narea");
    self.expectRejected(before);
}


