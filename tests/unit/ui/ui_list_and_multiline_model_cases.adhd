void VerifyMultilineModelTests_SingleLineRejectsHardBreaksAndNulWithoutChangingModel(mut MultilineModelTests self){
    EditModel single = EditModel(self.m_arena);
    ASSERT_TRUE(single.setText("a\t\x01\x7F\302\205b"));
    const MultilineSnapshot before = MultilineSnapshot(self.m_arena, single);
    Array<StringView, 5u> rejectedList = Array<StringView, 5u>();
    rejectedList[0u] = "\n";
    rejectedList[1u] = "\r";
    rejectedList[2u] = s_UiMultilineLineSeparator;
    rejectedList[3u] = s_UiMultilineParagraphSeparator;
    rejectedList[4u] = MakeUiMultilineSingleNul();
    for(in StringView rejected : rejectedList){
        EXPECT_FALSE(single.setText(rejected));
        before.expectUnchanged(single);
    }
}

void VerifyMultilineModelTests_CanonicalLinesPreserveUnicodeGraphemeBoundariesAndTrailingEmptyLine(mut MultilineModelTests self){
    ASSERT_TRUE(self.m_model.setText("a\xCC\x81\n\xE1\x84\x80\xE1\x85\xA1\n\xF0\x9F\x87\xB0\xF0\x9F\x87\xB7\n"));
    Array<usize, 7u> expected = Array<usize, 7u>();
    expected[0u] = 0u;
    expected[1u] = 3u;
    expected[2u] = 4u;
    expected[3u] = 10u;
    expected[4u] = 11u;
    expected[5u] = 19u;
    expected[6u] = 20u;
    ASSERT_EQ(self.m_model.graphemeBoundaries().size(), 7u);
    for(usize index = 0u; index < 7u; ++index){
        EXPECT_EQ(self.m_model.graphemeBoundaries()[index], expected[index]);
    }
    EXPECT_EQ(self.m_model.caret(), 20u);
    EXPECT_FALSE(self.m_model.setSelection(1u, 1u));
    EXPECT_FALSE(self.m_model.setSelection(7u, 7u));
    ASSERT_TRUE(self.m_model.move(EditMove::Home));
    EXPECT_EQ(self.m_model.caret(), 20u);
    ASSERT_TRUE(self.m_model.move(EditMove::End));
    EXPECT_EQ(self.m_model.caret(), 20u);
}

void VerifyMultilineModelTests_InvalidSetAndReplacementPreserveTextHistorySelectionAndComposition(mut MultilineModelTests self){
    ASSERT_TRUE(self.m_model.setText("a\nb"));
    ASSERT_TRUE(self.m_model.replaceSelection("x"));
    ASSERT_TRUE(self.m_model.replaceSelection("y"));
    ASSERT_TRUE(self.m_model.undo());
    ASSERT_TRUE(self.m_model.setSelection(1u, 3u));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("q\nr", 0u, 3u));
    const MultilineSnapshot before = MultilineSnapshot(self.m_arena, self.m_model);
    Array<StringView, 8u> invalid = Array<StringView, 8u>();
    invalid[0u] = "\r\n";
    invalid[1u] = "\t";
    invalid[2u] = "\xC2\x85";
    invalid[3u] = s_UiMultilineLineSeparator;
    invalid[4u] = s_UiMultilineParagraphSeparator;
    invalid[5u] = "\xC0\xAF";
    invalid[6u] = "\xED\xA0\x80";
    invalid[7u] = MakeUiMultilineEmbeddedNulAB();
    for(in StringView value : invalid){
        const ScopedTestTrace trace = ScopedTestTrace(value);
        EXPECT_FALSE(self.m_model.setText(value));
        EXPECT_FALSE(self.m_model.replaceSelection(value));
        before.expectUnchanged(self.m_model);
    }
    for(u32 scalar = 0u; scalar < 32u; ++scalar){
        if(scalar == 10u){
            continue;
        }
        Array<u8, 1u> bytes = Array<u8, 1u>();
        bytes[0u] = cast<u8>(scalar);
        const StringView view = MakeUiMultilineByteView(bytes);
        EXPECT_FALSE(self.m_model.setText(view));
        EXPECT_FALSE(self.m_model.replaceSelection(view));
        before.expectUnchanged(self.m_model);
    }
    for(u32 scalar = 0x80u; scalar <= 0x9Fu; ++scalar){
        Array<u8, 2u> bytes = Array<u8, 2u>();
        bytes[0u] = 0xC2u;
        bytes[1u] = cast<u8>(scalar);
        const StringView view = MakeUiMultilineByteView(bytes);
        EXPECT_FALSE(self.m_model.setText(view));
        EXPECT_FALSE(self.m_model.replaceSelection(view));
        before.expectUnchanged(self.m_model);
    }
    self.m_model.cancelComposition();
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "a\nb");
    ASSERT_TRUE(self.m_model.redo());
    EXPECT_EQ(self.m_model.text(), "a\nbx");
    ASSERT_TRUE(self.m_model.redo());
    EXPECT_EQ(self.m_model.text(), "a\nbxy");
}

void VerifyMultilineModelTests_CapacityFailureKeepsTheExactBorrowedModelState(mut MultilineModelTests self){
    EditModel limited = EditModel(self.m_arena, MakeUiMultilineLimits(6u, 8u, 128u), EditTextMode::Multiline);
    ASSERT_TRUE(limited.setText("a\nb"));
    ASSERT_TRUE(limited.replaceSelection("d"));
    ASSERT_TRUE(limited.setSelection(0u, 1u));
    ASSERT_TRUE(limited.beginComposition());
    ASSERT_TRUE(limited.updateComposition("x", 0u, 1u));
    const MultilineSnapshot before = MultilineSnapshot(self.m_arena, limited);
    EXPECT_FALSE(limited.setText("abcdef\n"));
    EXPECT_FALSE(limited.replaceSelection("x\nyz"));
    before.expectUnchanged(limited);
}

void VerifyMultilineModelTests_AliasedInsertionAndExternalSameTextReplacementOwnTheirBytes(mut MultilineModelTests self){
    ASSERT_TRUE(self.m_model.setText("ab\ncd"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 4u));
    ASSERT_TRUE(self.m_model.replaceSelection(self.m_model.text()));
    EXPECT_EQ(self.m_model.text(), "aab\ncdd");
    EXPECT_EQ(self.m_model.caret(), 6u);
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "ab\ncd");
    EXPECT_EQ(self.m_model.anchor(), 1u);
    EXPECT_EQ(self.m_model.caret(), 4u);
    ASSERT_TRUE(self.m_model.redo());
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("x", 0u, 1u));
    const u64 external = self.m_model.externalRevision();
    const u64 selection = self.m_model.selectionGeneration();
    const u64 revision = self.m_model.revision();
    ASSERT_TRUE(self.m_model.setText(self.m_model.text()));
    EXPECT_EQ(self.m_model.text(), "aab\ncdd");
    EXPECT_EQ(self.m_model.revision(), revision);
    EXPECT_GT(self.m_model.externalRevision(), external);
    EXPECT_GT(self.m_model.selectionGeneration(), selection);
    EXPECT_FALSE(self.m_model.canUndo());
    EXPECT_FALSE(self.m_model.composition().active);
}

void VerifyMultilineModelTests_DeletingLineBreaksJoinsLinesWithoutSplittingGraphemes(mut MultilineModelTests self){
    ASSERT_TRUE(self.m_model.setText("a\xCC\x81\nz"));
    ASSERT_TRUE(self.m_model.setSelection(4u, 4u));
    ASSERT_TRUE(self.m_model.backspace());
    EXPECT_EQ(self.m_model.text(), "a\xCC\x81z");
    EXPECT_EQ(self.m_model.caret(), 3u);
    ASSERT_TRUE(self.m_model.undo());
    ASSERT_TRUE(self.m_model.setSelection(3u, 3u));
    ASSERT_TRUE(self.m_model.eraseForward());
    EXPECT_EQ(self.m_model.text(), "a\xCC\x81z");
    ASSERT_TRUE(self.m_model.undo());
    ASSERT_TRUE(self.m_model.setSelection(3u, 3u));
    ASSERT_TRUE(self.m_model.backspace());
    EXPECT_EQ(self.m_model.text(), "\nz");
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "a\xCC\x81\nz");
    EXPECT_EQ(self.m_model.caret(), 3u);
}

void VerifyMultilineModelTests_SurroundingDeletionAcrossLinesRemainsBoundaryCheckedAndUndoable(mut MultilineModelTests self){
    ASSERT_TRUE(self.m_model.setText("a\xCC\x81\nz"));
    ASSERT_TRUE(self.m_model.setSelection(4u, 4u));
    const MultilineSnapshot before = MultilineSnapshot(self.m_arena, self.m_model);
    EXPECT_FALSE(self.m_model.eraseSurrounding(2u, 0u));
    before.expectUnchanged(self.m_model);
    ASSERT_TRUE(self.m_model.eraseSurrounding(1u, 1u));
    EXPECT_EQ(self.m_model.text(), "a\xCC\x81");
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "a\xCC\x81\nz");
    EXPECT_EQ(self.m_model.anchor(), 4u);
    EXPECT_EQ(self.m_model.caret(), 4u);
}

void VerifyMultilineModelTests_HomeEndAddressCurrentHardLineIncludingEmptyAndTrailingLines(mut MultilineModelTests self){
    ASSERT_TRUE(self.m_model.setText("ab\n\ncde\n"));
    Array<usize, 9u> homes = Array<usize, 9u>();
    homes[0u] = 0u;
    homes[1u] = 0u;
    homes[2u] = 0u;
    homes[3u] = 3u;
    homes[4u] = 4u;
    homes[5u] = 4u;
    homes[6u] = 4u;
    homes[7u] = 4u;
    homes[8u] = 8u;
    Array<usize, 9u> ends = Array<usize, 9u>();
    ends[0u] = 2u;
    ends[1u] = 2u;
    ends[2u] = 2u;
    ends[3u] = 3u;
    ends[4u] = 7u;
    ends[5u] = 7u;
    ends[6u] = 7u;
    ends[7u] = 7u;
    ends[8u] = 8u;
    Array<usize, 5u> boundaries = Array<usize, 5u>();
    boundaries[0u] = 2u;
    boundaries[1u] = 3u;
    boundaries[2u] = 4u;
    boundaries[3u] = 7u;
    boundaries[4u] = 8u;
    for(in usize caret : boundaries){
        ASSERT_TRUE(self.m_model.setSelection(caret, caret));
        ASSERT_TRUE(self.m_model.move(EditMove::Home));
        EXPECT_EQ(self.m_model.caret(), homes[caret]);
        ASSERT_TRUE(self.m_model.setSelection(caret, caret));
        ASSERT_TRUE(self.m_model.move(EditMove::End));
        EXPECT_EQ(self.m_model.caret(), ends[caret]);
    }
    ASSERT_TRUE(self.m_model.setText(""));
    ASSERT_TRUE(self.m_model.move(EditMove::Home));
    ASSERT_TRUE(self.m_model.move(EditMove::End));
    EXPECT_EQ(self.m_model.caret(), 0u);
}

void VerifyMultilineModelTests_AcceptedNoopSelectionAndMovementAdvanceTheSelectionEpochInBothModes(mut MultilineModelTests self){
    Array<EditTextModeEnum, 2u> modes = Array<EditTextModeEnum, 2u>();
    modes[0u] = EditTextMode::SingleLine;
    modes[1u] = EditTextMode::Multiline;
    for(in EditTextModeEnum mode : modes){
        EditModel model = EditModel(self.m_arena, EditLimits(), mode);
        ASSERT_TRUE(model.setText("a\xCC\x81z"));
        const u64 revision = model.revision();
        const u64 external = model.externalRevision();
        u64 selection = model.selectionGeneration();
        ASSERT_TRUE(model.setSelection(model.anchor(), model.caret()));
        EXPECT_GT(model.selectionGeneration(), selection);
        selection = model.selectionGeneration();
        ASSERT_TRUE(model.move(EditMove::Right));
        EXPECT_GT(model.selectionGeneration(), selection);
        selection = model.selectionGeneration();
        ASSERT_TRUE(model.selectAll());
        EXPECT_GT(model.selectionGeneration(), selection);
        selection = model.selectionGeneration();
        ASSERT_TRUE(model.selectAll());
        EXPECT_GT(model.selectionGeneration(), selection);
        EXPECT_EQ(model.revision(), revision);
        EXPECT_EQ(model.externalRevision(), external);
        const MultilineSnapshot before = MultilineSnapshot(self.m_arena, model);
        EXPECT_FALSE(model.setSelection(1u, 1u));
        EXPECT_FALSE(model.move(bit_cast<EditMoveEnum>(u8(255u))));
        before.expectUnchanged(model);
    }
}

void VerifyMultilineModelTests_SelectionAwayAndBackCannotReviveAnOldLoanEpoch(mut MultilineModelTests self){
    Array<EditTextModeEnum, 2u> modes = Array<EditTextModeEnum, 2u>();
    modes[0u] = EditTextMode::SingleLine;
    modes[1u] = EditTextMode::Multiline;
    for(in EditTextModeEnum mode : modes){
        EditModel model = EditModel(self.m_arena, EditLimits(), mode);
        ASSERT_TRUE(model.setText("ab"));
        const u64 revision = model.revision();
        const u64 external = model.externalRevision();
        const u64 selection = model.selectionGeneration();
        ASSERT_TRUE(model.setSelection(0u, 0u));
        ASSERT_TRUE(model.setSelection(2u, 2u));
        EXPECT_EQ(model.anchor(), 2u);
        EXPECT_EQ(model.caret(), 2u);
        EXPECT_GT(model.selectionGeneration(), selection);
        EXPECT_EQ(model.revision(), revision);
        EXPECT_EQ(model.externalRevision(), external);
    }
}

void VerifyMultilineModelTests_AliasedSameTextAndEmptyReplacementRetireSelectionButZeroErasePreservesIt(mut MultilineModelTests self){
    ASSERT_TRUE(self.m_model.setText("a\nb"));
    u64 selection = self.m_model.selectionGeneration();
    ASSERT_TRUE(self.m_model.setText(self.m_model.text()));
    EXPECT_GT(self.m_model.selectionGeneration(), selection);
    selection = self.m_model.selectionGeneration();
    ASSERT_TRUE(self.m_model.replaceSelection(""));
    EXPECT_GT(self.m_model.selectionGeneration(), selection);
    selection = self.m_model.selectionGeneration();
    ASSERT_TRUE(self.m_model.eraseSurrounding(0u, 0u));
    EXPECT_EQ(self.m_model.selectionGeneration(), selection);
}


