class TransitiveSplitResolver final : public Core::Metascript::IIncludeResolver{
public:
    [[nodiscard]] virtual b8 resolveInclude(MStringView includePath, b8 isSystem, MetaArena& rArena, MString& outResolvedKey, MString& outContent)override;
    virtual void popIncludeScope()noexcept override;


public:
    u32 popCount = 0u;
};

