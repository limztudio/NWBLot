class GpuFramebufferAttachmentExtent{
    public u32 width = 0u;
    public u32 height = 0u;
    public u32 arraySize = 0u;
}


u32 FramebufferMipDimension(in u32 dimension, in u32 mip){
    return max(dimension >> mip, 1u);
}


