struct FontAtlasCookEntry{
    FontAtlasPayload payload;
    Name virtualPath = s_NameNone;


public:
    explicit FontAtlasCookEntry(Core::Assets::AssetArena& memoryArena)noexcept
        : payload(memoryArena)
    {}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] Expected<FontAtlasCookEntry> ParseFontAtlasCookMetadata(const Path& assetRoot, AStringView virtualRoot, const Path& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<FontAtlasCookEntry> ParseFontAtlasCookMetadataValue(Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);

template<typename RootArenaT, typename FileArenaT>
    requires (!IsSame_V<RootArenaT, Core::Alloc::GlobalArena> || !IsSame_V<FileArenaT, Core::Alloc::GlobalArena>)
[[nodiscard]] FOUNDATION_INLINE Expected<FontAtlasCookEntry> ParseFontAtlasCookMetadata(const ::Path<RootArenaT>& assetRoot, const AStringView virtualRoot, const ::Path<FileArenaT>& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    return ParseFontAtlasCookMetadata(Path(arena, assetRoot), virtualRoot, Path(arena, nwbFilePath), doc, arena, scratchArena);
}

template<typename FileArenaT>
    requires (!IsSame_V<FileArenaT, Core::Alloc::GlobalArena>)
[[nodiscard]] FOUNDATION_INLINE Expected<FontAtlasCookEntry> ParseFontAtlasCookMetadataValue(const Name virtualPath, const ::Path<FileArenaT>& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    return ParseFontAtlasCookMetadataValue(virtualPath, Path(arena, nwbFilePath), asset, arena, scratchArena);
}
[[nodiscard]] Expected<FontAtlas> BuildFontAtlasAsset(const FontAtlasCookEntry& entry, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const b8 s_FontAtlasCookIncludePreparedPixels = true;

b8 HasPositiveFontAtlasGlyphBitmapDimensions(in u32 width, in u32 height){
    return width > 0u && height > 0u;
}

b8 IsMatchingFontAtlasSourceGlyphListCount(in u32 sourceGlyphCount, in u32 maxGlyphCount, in usize metadataGlyphCount){
    return sourceGlyphCount > 0u && sourceGlyphCount <= maxGlyphCount && metadataGlyphCount == cast<usize>(sourceGlyphCount);
}

Expected<u32> TryConvertFontAtlasMetadataInteger(in i64 rawValue, in u32 minimum, in u32 maximum){
    if(rawValue < cast<i64>(minimum) || cast<u64>(rawValue) > cast<u64>(maximum))
        return MakeUnexpected(Failure());
    return cast<u32>(rawValue);
}

b8 ValidateFontAtlasPositiveGlyphBitmapDimensions(in Path path, in u32 width, in u32 height){
    if(HasPositiveFontAtlasGlyphBitmapDimensions(width, height))
        return true;

    error("Font atlas glyph meta '{}': bitmap dimensions must be positive; empty glyphs declare only advance_units", PathToString(path));
    return false;
}

b8 ValidateFontAtlasSourceGlyphListCount(in Path path, in u32 sourceGlyphCount, in u32 maxGlyphCount, in usize metadataGlyphCount){
    if(IsMatchingFontAtlasSourceGlyphListCount(sourceGlyphCount, maxGlyphCount, metadataGlyphCount))
        return true;

    error("Font atlas glyph meta '{}': exactly one record per source glyph is required", PathToString(path));
    return false;
}

Expected<u32> ValidateFontAtlasMetadataU32Field(
    in Path path,
    in StringView diagnosticPrefix,
    in StringView field,
    in b8 hasInteger,
    in i64 rawValue,
    in u32 minimum,
    in u32 maximum
){
    if(hasInteger){
        const Expected<u32> converted = TryConvertFontAtlasMetadataInteger(rawValue, minimum, maximum);
        if(converted.has_value())
            return converted.value();
    }
    error("{} '{}': field '{}' must be an integer in {}..{}", diagnosticPrefix, PathToString(path), field, minimum, maximum);
    return MakeUnexpected(Failure());
}

b8 ValidateParsedFontAtlasRasterMode(in Path path, in b8 valid){
    if(valid)
        return true;

    error("Font atlas meta '{}': unsupported raster_mode", PathToString(path));
    return false;
}

b8 ValidatePairedFontSourceMetrics(in Path path, in b8 valid){
    if(valid)
        return true;

    error("Font atlas meta '{}': paired font source has invalid face metrics", PathToString(path));
    return false;
}

Expected<u32> ReadFontAtlasMetadataU32(
    in Path path,
    in MetascriptValue map,
    in StringView diagnosticPrefix,
    in StringView field,
    in u32 minimum,
    in u32 maximum
){
    b8 hasInteger = false;
    i64 rawValue = 0;
    map.visitField(field, lambda[mut hasInteger, mut rawValue](in MetascriptValue value) -> void{
        if(value.isInteger()){
            hasInteger = true;
            rawValue = value.asInteger();
        }
    });
    return ValidateFontAtlasMetadataU32Field(path, diagnosticPrefix, field, hasInteger, rawValue, minimum, maximum);
}

b8 ReadFontAtlasU32Field(
    in Path path,
    in MetascriptValue map,
    in StringView diagnosticPrefix,
    in StringView field,
    in u32 minimum,
    in u32 maximum,
    mut u32 outValue
){
    const Expected<u32> result = ReadFontAtlasMetadataU32(path, map, diagnosticPrefix, field, minimum, maximum);
    if(!result.has_value())
        return false;
    outValue = result.value();
    return true;
}

b8 ReadFontAtlasFiniteF32Field(in Path path, in MetascriptValue map, in StringView diagnosticPrefix, in StringView field, mut f32 outValue){
    const Expected<f32> result = ReadMetadataFiniteF32Field(path, map, diagnosticPrefix, field, true);
    if(!result.has_value())
        return false;
    outValue = result.value();
    return true;
}

Expected<FontAtlasGlyph> ReadFontAtlasGlyphMetadata(in Path path, in MetascriptValue map, in u32 glyphId, in f32 unitsPerPixel){
    if(!CheckMetadataAssetMap(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix))
        return MakeUnexpected(Failure());

    const b8 hasBitmap = map.hasField(s_FontAtlasGlyphWidthField);
    if(!ValidateMetadataAssetFields(
        path,
        map,
        s_FontAtlasGlyphMetaDiagnosticPrefix,
        lambda[in hasBitmap](in StringView field) -> b8{
            return IsAllowedFontAtlasGlyphField(field, hasBitmap);
        }
    ))
        return MakeUnexpected(Failure());

    FontAtlasGlyph glyph;
    glyph.glyphId = glyphId;
    if(!ReadFontAtlasFiniteF32Field(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphAdvanceUnitsField, glyph.advanceUnits))
        return MakeUnexpected(Failure());
    if(!hasBitmap)
        return glyph;

    if(
        !ReadFontAtlasU32Field(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphGroupField, 0u, s_FontAtlasMaxGroupCount - 1u, glyph.group)
        || !ReadFontAtlasU32Field(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphChannelField, 0u, s_FontAtlasMaxChannelCount - 1u, glyph.channel)
        || !ReadFontAtlasU32Field(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphXField, 0u, s_FontAtlasMaxExtent, glyph.x)
        || !ReadFontAtlasU32Field(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphYField, 0u, s_FontAtlasMaxExtent, glyph.y)
        || !ReadFontAtlasU32Field(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphWidthField, 0u, s_FontAtlasMaxExtent, glyph.width)
        || !ReadFontAtlasU32Field(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphHeightField, 0u, s_FontAtlasMaxExtent, glyph.height)
        || !ReadFontAtlasFiniteF32Field(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphPlaneLeftField, glyph.planeLeft)
        || !ReadFontAtlasFiniteF32Field(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphPlaneTopField, glyph.planeTop)
    )
        return MakeUnexpected(Failure());
    if(!ValidateFontAtlasPositiveGlyphBitmapDimensions(path, glyph.width, glyph.height))
        return MakeUnexpected(Failure());
    ComputeFontAtlasGlyphPlaneBounds(unitsPerPixel, glyph);
    return glyph;
}

Expected<Vector<FontAtlasGlyph>> ParseFontAtlasGlyphMetadata(in Path nwbFilePath, in MetascriptValue asset, in FontAtlasPayload payload){
    const Expected<Span<MetascriptValue>> glyphsResult = ReadMetadataListField(nwbFilePath, asset, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphsField);
    if(!glyphsResult.has_value())
        return MakeUnexpected(Failure());
    in Span<MetascriptValue> glyphs = glyphsResult.value();
    if(!ValidateFontAtlasSourceGlyphListCount(nwbFilePath, payload.sourceGlyphCount, s_FontAtlasMaxGlyphCount, glyphs.size()))
        return MakeUnexpected(Failure());

    Vector<FontAtlasGlyph> candidate;
    candidate.reserve(cast<usize>(payload.sourceGlyphCount));
    const f32 unitsPerPixel = ComputeFontAtlasUnitsPerPixel(payload.unitsPerEm, payload.bakePpem);
    for(u32 index = 0u; index < payload.sourceGlyphCount; ++index){
        const Expected<FontAtlasGlyph> glyphResult = ReadFontAtlasGlyphMetadata(nwbFilePath, glyphs[cast<usize>(index)], index, unitsPerPixel);
        if(!glyphResult.has_value())
            return MakeUnexpected(Failure());
        candidate.push_back(glyphResult.value());
    }
    return candidate;
}

b8 ReadFontAtlasSettings(in Path path, in MetascriptValue asset, mut FontAtlasPayload payload){
    if(
        !ReadFontAtlasU32Field(path, asset, s_FontAtlasMetaDiagnosticPrefix, s_FontAtlasBakePpemField, s_FontAtlasMinBakePpem, s_FontAtlasMaxBakePpem, payload.bakePpem)
        || !ReadFontAtlasU32Field(path, asset, s_FontAtlasMetaDiagnosticPrefix, s_FontAtlasSpreadPixelsField, s_FontAtlasMinSpreadPixels, s_FontAtlasMaxSpreadPixels, payload.spreadPixels)
        || !ReadFontAtlasFiniteF32Field(path, asset, s_FontAtlasMetaDiagnosticPrefix, s_FontAtlasAscenderUnitsField, payload.ascenderUnits)
        || !ReadFontAtlasFiniteF32Field(path, asset, s_FontAtlasMetaDiagnosticPrefix, s_FontAtlasDescenderUnitsField, payload.descenderUnits)
        || !ReadFontAtlasFiniteF32Field(path, asset, s_FontAtlasMetaDiagnosticPrefix, s_FontAtlasLineGapUnitsField, payload.lineGapUnits)
    )
        return false;

    const Expected<MetadataStringField> rasterModeResult = ReadMetadataStringField(path, asset, s_FontAtlasMetaDiagnosticPrefix, s_FontAtlasRasterModeField, true);
    if(!rasterModeResult.has_value())
        return false;
    const Expected<FontAtlasRasterMode> parsedRasterMode = TryParseFontAtlasRasterMode(rasterModeResult.value().text);
    if(!ValidateParsedFontAtlasRasterMode(path, parsedRasterMode.has_value()))
        return false;
    payload.rasterMode = parsedRasterMode.value();
    return true;
}


