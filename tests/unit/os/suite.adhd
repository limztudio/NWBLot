class UnsupportedClipboardContext{
    private HeapStorage m_storage = HeapStorage();
    public OsClipboardServiceOwner service = OsClipboardServiceOwner();
    public b8 factorySucceeded = false;
    public UnsupportedClipboardContext(){ this.open(); }
    private void open(){
        auto result = OpenOsClipboardService(this.m_storage, s_OsNullWindow);
        if(result.has_value()){
            this.factorySucceeded = true;
            TestMoveAssign<OsClipboardServiceOwner>(this.service, result.value());
        }
    }
    public b8 hasService()const{ return this.service.valid(); }

    public ClipboardCompletion completion = ClipboardCompletion();
    public ClipboardCapabilities capabilities(in ClipboardChannel channel)const{ return this.service.deref().capabilities(channel); }
    public Expected<ClipboardRequestToken, ClipboardAdmission> requestWriteText(in ClipboardChannel channel, in StringView text){ return this.service.deref().requestWriteText(channel, text); }
    public b8 pump(){ return this.service.deref().pump(); }
    public ClipboardPollResult poll(in ClipboardRequestToken token){ return this.service.deref().poll(token, this.completion); }
}

class UnsupportedTextInputContext{
    private HeapStorage m_storage = HeapStorage();
    public OsTextServiceOwner service = OsTextServiceOwner();
    public b8 factorySucceeded = false;
    public UnsupportedTextInputContext(){ this.open(); }
    private void open(){
        auto result = OpenOsTextService(this.m_storage, s_OsNullWindow);
        if(result.has_value()){
            this.factorySucceeded = true;
            TestMoveAssign<OsTextServiceOwner>(this.service, result.value());
        }
    }
    public b8 hasService()const{ return this.service.valid(); }

    public TextInputCapabilities capabilities()const{ return this.service.deref().capabilities(); }
    public b8 setFocused(in b8 focused){ return this.service.deref().setFocused(focused); }
    public Expected<TextInputSessionToken, TextInputAdmission> beginEmpty(){ return this.service.deref().begin(TextInputSessionDesc()); }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


TextInputSessionDesc MakeSessionDesc(in StringView text, in usize anchor, in usize caret){
    return TextInputSessionDesc(TextInputRect(), text, anchor, caret);
}

TextInputDeletionBasis MakeInvalidDeletionBasis(){ return cast<TextInputDeletionBasis>(255u); }

TextInputChangeCause MakeInvalidChangeCause(){ return cast<TextInputChangeCause>(255u); }

void FillGlobalString(mut String target, in usize count, in u8 byteValue){ target.assign(count, cast<u8>(byteValue)); }

void AssignGlobalString(mut String target, in StringView value){ target.assign(value); }

void AppendByteGlobalString(mut String target, in u8 value){ target.push_back(cast<u8>(value)); }

void VerifyTextInputSelection_ReverseSelectionHasTheSameOuterByteLimits(){
    SelectionTextInputContext ctx = SelectionTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> begun = ctx.service.begin(MakeSessionDesc("abcDEFghi", 6u, 3u));
    ASSERT_TRUE(begun.has_value());
    const TextInputSessionToken token = begun.value();
    const u64 revision = ctx.service.surroundingRevision(token);
    EXPECT_EQ(ctx.service.sendDeletion(token, 4u, 0u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.sendDeletion(token, 0u, 4u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::InvalidRange);
    ASSERT_EQ(ctx.service.sendDeletion(token, 3u, 3u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.deleteBeforeBytes, 3u);
    EXPECT_EQ(ctx.event.deleteAfterBytes, 3u);
    EXPECT_EQ(ctx.event.deletionBasis, TextInputDeletionBasis::Selection);
    EXPECT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Pending);
}

void VerifyTextInputSelection_UnknownBasisAndMissingOrStaleRevisionDoNotQueueAnyEvent(){
    SelectionTextInputContext ctx = SelectionTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> begun = ctx.service.begin(MakeSessionDesc("abcDEFghi", 3u, 6u));
    ASSERT_TRUE(begun.has_value());
    const TextInputSessionToken token = begun.value();
    const u64 revision = ctx.service.surroundingRevision(token);
    ASSERT_EQ(ctx.service.updateSurrounding(token, "abcDEFghi", 3u, 6u), TextInputAdmission::Accepted);
    const u64 currentRevision = ctx.service.surroundingRevision(token);
    EXPECT_EQ(ctx.service.sendDeletion(token, 2u, 1u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.sendDeletion(token, 2u, 1u, 0u, TextInputDeletionBasis::Selection), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.sendDeletion(token, 0u, 0u, currentRevision, MakeInvalidDeletionBasis()), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Pending);
    EXPECT_EQ(ctx.service.activeSession(), token);
    ASSERT_EQ(ctx.service.sendDeletion(token, 2u, 1u, currentRevision, TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.surroundingRevision, currentRevision);
    EXPECT_EQ(ctx.event.deletionBasis, TextInputDeletionBasis::Selection);
    EXPECT_EQ(ctx.event.deleteBeforeBytes, 2u);
    EXPECT_EQ(ctx.event.deleteAfterBytes, 1u);
    EXPECT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Pending);
}

void VerifyTextInputSelection_OuterUtf8EndpointsMustRemainScalarBoundaries(){
    SelectionTextInputContext ctx = SelectionTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> begun = ctx.service.begin(MakeSessionDesc("a\xED\x95\x9C\x44\x45\x46\xEA\xB8\x80z", 4u, 7u));
    ASSERT_TRUE(begun.has_value());
    const TextInputSessionToken token = begun.value();
    const u64 revision = ctx.service.surroundingRevision(token);
    EXPECT_EQ(ctx.service.sendDeletion(token, 1u, 0u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.sendDeletion(token, 0u, 1u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::InvalidRange);
    ASSERT_EQ(ctx.service.sendDeletion(token, 3u, 3u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.deleteBeforeBytes, 3u);
    EXPECT_EQ(ctx.event.deleteAfterBytes, 3u);
}

void VerifyTextInputSelection_PollCopiesTheBasisAndNonDeletionEventsResetAReusedOutput(){
    StandaloneTextInputEvent out = StandaloneTextInputEvent();
    TextInputSessionToken token = TextInputSessionToken();
    {
        SelectionTextInputContext ctx = SelectionTextInputContext();
        ASSERT_TRUE(ctx.service.setFocused(true));
        const Expected<TextInputSessionToken, TextInputAdmissionEnum> begun = ctx.service.begin(MakeSessionDesc("abcDEFghi", 3u, 6u));
        ASSERT_TRUE(begun.has_value());
        token = begun.value();
        const u64 revision = ctx.service.surroundingRevision(token);
        ASSERT_EQ(ctx.service.sendDeletion(token, 2u, 1u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
        ASSERT_EQ(ctx.service.poll(token, out.event), TextInputPollResult::Event);
        EXPECT_EQ(out.event.deletionBasis, TextInputDeletionBasis::Selection);
        ASSERT_EQ(ctx.service.sendCommit(token, "X"), TextInputAdmission::Accepted);
        ASSERT_EQ(ctx.service.poll(token, out.event), TextInputPollResult::Event);
        EXPECT_EQ(out.event.deletionBasis, TextInputDeletionBasis::Caret);
        ASSERT_EQ(ctx.service.sendDeletion(token, 0u, 0u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
        ASSERT_EQ(ctx.service.poll(token, out.event), TextInputPollResult::Event);
        ASSERT_TRUE(ctx.service.end(token));
    }
    EXPECT_EQ(out.event.token, token);
    EXPECT_EQ(out.event.kind, TextInputEventKind::DeleteSurrounding);
    EXPECT_EQ(out.event.deletionBasis, TextInputDeletionBasis::Selection);
    EXPECT_EQ(out.event.deleteBeforeBytes, 0u);
    EXPECT_EQ(out.event.deleteAfterBytes, 0u);
}

void VerifyTextInputSelection_DeletionPreservesThePreeditCommitOrderingBarrier(){
    SelectionTextInputContext ctx = SelectionTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> begun = ctx.service.begin(MakeSessionDesc("abcDEFghi", 3u, 6u));
    ASSERT_TRUE(begun.has_value());
    const TextInputSessionToken token = begun.value();
    const u64 revision = ctx.service.surroundingRevision(token);
    ASSERT_EQ(ctx.service.sendPreedit(token, StringView(), 0u, 0u), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.sendDeletion(token, 2u, 1u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.sendCommit(token, "X"), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.sendPreedit(token, "next", 0u, 4u), TextInputAdmission::Accepted);

    FixedVector<TextInputEventKindEnum, 4> kinds = FixedVector<TextInputEventKindEnum, 4>();
    kinds.push_back(TextInputEventKind::Preedit);
    kinds.push_back(TextInputEventKind::DeleteSurrounding);
    kinds.push_back(TextInputEventKind::Commit);
    kinds.push_back(TextInputEventKind::Preedit);

    u64 previousSequence = 0u;
    for(in TextInputEventKindEnum kind : kinds){
        ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
        EXPECT_EQ(ctx.event.kind, kind);
        EXPECT_GT(ctx.event.sequence, previousSequence);
        TextInputDeletionBasisEnum expectedBasis = TextInputDeletionBasis::Caret;
        if(kind == TextInputEventKind::DeleteSurrounding){
            expectedBasis = TextInputDeletionBasis::Selection;
        }
        EXPECT_EQ(ctx.event.deletionBasis, expectedBasis);
        previousSequence = ctx.event.sequence;
    }
    EXPECT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Pending);
}

void VerifyClipboard_RequestsCopyTextAndPublishOnlyWhenPumped(){
    FakeClipboardContext ctx = FakeClipboardContext();
    AssignGlobalString(ctx.scratch, "Hello \xED\x95\x9C\xEA\xB8\x80 \xF0\x9F\x98\x80");
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> write = ctx.service.requestWriteText(ClipboardChannel::Clipboard, StringView(ctx.scratch));
    ASSERT_TRUE(write.has_value());
    AssignGlobalString(ctx.scratch, "changed");
    EXPECT_EQ(ctx.service.poll(write.value(), ctx.completion), ClipboardPollResult::Pending);
    EXPECT_EQ(ctx.service.m_writeCount, 0u);
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> read = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(read.has_value());
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.poll(write.value(), ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.status, ClipboardStatus::Success);
    EXPECT_EQ(ctx.service.poll(read.value(), ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.text, "Hello \xED\x95\x9C\xEA\xB8\x80 \xF0\x9F\x98\x80");
    EXPECT_EQ(ctx.completion.token, read.value());
    EXPECT_EQ(ctx.service.poll(read.value(), ctx.completion), ClipboardPollResult::InvalidRequest);
}

void VerifyClipboard_CancelPreventsPendingWritesAndRejectsReusedGenerations(){
    FakeClipboardContext ctx = FakeClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> canceledAdmission = ctx.service.requestWriteText(ClipboardChannel::Clipboard, "discard");
    ASSERT_TRUE(canceledAdmission.has_value());
    const ClipboardRequestToken canceled = canceledAdmission.value();
    ASSERT_TRUE(ctx.service.cancel(canceled));
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> currentAdmission = ctx.service.requestWriteText(ClipboardChannel::Clipboard, "keep");
    ASSERT_TRUE(currentAdmission.has_value());
    const ClipboardRequestToken current = currentAdmission.value();
    EXPECT_NE(canceled.generation, current.generation);
    EXPECT_EQ(ctx.service.poll(canceled, ctx.completion), ClipboardPollResult::InvalidRequest);
    EXPECT_FALSE(ctx.service.cancel(canceled));
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.m_writeCount, 1u);
    EXPECT_EQ(ctx.service.m_text, "keep");
    ASSERT_TRUE(ctx.service.cancel(current));
    EXPECT_EQ(ctx.service.poll(current, ctx.completion), ClipboardPollResult::InvalidRequest);
    EXPECT_EQ(ctx.service.m_text, "keep");
}

void VerifyClipboard_ReusedSlotsKeepRequestOrdering(){
    FakeClipboardContext ctx = FakeClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> firstAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(firstAdmission.has_value());
    const ClipboardRequestToken first = firstAdmission.value();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> secondAdmission = ctx.service.requestWriteText(ClipboardChannel::Clipboard, "second");
    ASSERT_TRUE(secondAdmission.has_value());
    const ClipboardRequestToken second = secondAdmission.value();
    ASSERT_TRUE(ctx.service.cancel(first));
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> thirdAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(thirdAdmission.has_value());
    const ClipboardRequestToken third = thirdAdmission.value();
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.poll(second, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.service.poll(third, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.text, "second");
}

void VerifyClipboard_TokensCannotCrossServicesOrSurviveServiceRecreation(){
    StandaloneClipboardCompletion out = StandaloneClipboardCompletion();
    ClipboardRequestToken old = ClipboardRequestToken();
    {
        FakeClipboardContext previous = FakeClipboardContext();
        const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> oldAdmission = previous.service.requestReadText(ClipboardChannel::Clipboard);
        ASSERT_TRUE(oldAdmission.has_value());
        old = oldAdmission.value();
    }
    FakeClipboardContext currentCtx = FakeClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> currentAdmission = currentCtx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(currentAdmission.has_value());
    const ClipboardRequestToken current = currentAdmission.value();
    EXPECT_NE(old.service, current.service);
    EXPECT_EQ(currentCtx.service.poll(old, out.completion), ClipboardPollResult::InvalidRequest);
    EXPECT_FALSE(currentCtx.service.cancel(old));
    EXPECT_EQ(currentCtx.service.poll(ClipboardRequestToken(), out.completion), ClipboardPollResult::InvalidRequest);
}

void VerifyClipboard_CanceledNativeCompletionCannotReachNewRequest(){
    FakeClipboardContext ctx = FakeClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> oldAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(oldAdmission.has_value());
    const ClipboardRequestToken old = oldAdmission.value();
    ClipboardRequestToken current = ClipboardRequestToken();
    ctx.service.m_onRead = lambda[mut ctx, in old, mut current]() -> void{
        EXPECT_TRUE(ctx.service.cancel(old));
        const auto currentAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
        ASSERT_TRUE(currentAdmission.has_value());
        current = currentAdmission.value();
        EXPECT_FALSE(ctx.service.pump());
    };
    ASSERT_TRUE(ctx.service.pump());
    ASSERT_FALSE(HasFatalTestFailure());
    ctx.service.m_onRead = OsServiceHook();
    EXPECT_EQ(ctx.service.poll(old, ctx.completion), ClipboardPollResult::InvalidRequest);
    EXPECT_EQ(ctx.service.poll(current, ctx.completion), ClipboardPollResult::Pending);
    AssignGlobalString(ctx.service.m_text, "new completion");
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.poll(current, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.text, "new completion");
}

void VerifyClipboard_UnsupportedChannelsAndUnavailableReadsStayExplicit(){
    FakeClipboardContext ctx = FakeClipboardContext();
    EXPECT_FALSE(ctx.service.capabilities(ClipboardChannel::PrimarySelection).readText);
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> primaryAdmission = ctx.service.requestReadText(ClipboardChannel::PrimarySelection);
    ASSERT_TRUE(primaryAdmission.has_value());
    const ClipboardRequestToken primary = primaryAdmission.value();
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.poll(primary, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.status, ClipboardStatus::Unsupported);
    EXPECT_EQ(ctx.service.m_readCount, 0u);
    ctx.service.m_readStatus = ClipboardStatus::Unavailable;
    AssignGlobalString(ctx.service.m_text, "must not escape failed read");
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> unavailableAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(unavailableAdmission.has_value());
    const ClipboardRequestToken unavailable = unavailableAdmission.value();
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.poll(unavailable, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.status, ClipboardStatus::Unavailable);
    EXPECT_TRUE(ctx.completion.text.empty());
}

void VerifyClipboard_UnsupportedFactoryDoesNotAccessNativeClipboard(){
    UnsupportedClipboardContext ctx = UnsupportedClipboardContext();
    ASSERT_TRUE(ctx.factorySucceeded);
    ASSERT_TRUE(ctx.hasService());
    EXPECT_FALSE(ctx.capabilities(ClipboardChannel::Clipboard).readText);
    EXPECT_FALSE(ctx.capabilities(ClipboardChannel::Clipboard).writeText);
    EXPECT_FALSE(ctx.capabilities(ClipboardChannel::PrimarySelection).readText);
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> tokenAdmission = ctx.requestWriteText(ClipboardChannel::Clipboard, "unused");
    ASSERT_TRUE(tokenAdmission.has_value());
    const ClipboardRequestToken token = tokenAdmission.value();
    ASSERT_TRUE(ctx.pump());
    EXPECT_EQ(ctx.poll(token), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.status, ClipboardStatus::Unsupported);
}

void VerifyClipboard_AdmissionBoundsOutstandingRequestsAndText(){
    FakeClipboardContext ctx = FakeClipboardContext();
    Vector<ClipboardRequestToken> tokens = Vector<ClipboardRequestToken>();
    for(usize index = 0u; index < s_ClipboardMaxOutstandingRequests; ++index){
        const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> request = ctx.service.requestReadText(ClipboardChannel::Clipboard);
        ASSERT_TRUE(request.has_value());
        tokens.push_back(request.value());
    }
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> queueFullRead = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_FALSE(queueFullRead.has_value());
    EXPECT_EQ(queueFullRead.error(), ClipboardAdmission::QueueFull);
    for(in ClipboardRequestToken token : tokens){
        ASSERT_TRUE(ctx.service.cancel(token));
    }
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> invalidAdmission = ctx.service.requestWriteText(ClipboardChannel::Clipboard, StringView("a\0b", 3u));
    ASSERT_TRUE(invalidAdmission.has_value());
    const ClipboardRequestToken invalid = invalidAdmission.value();
    EXPECT_EQ(ctx.service.poll(invalid, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.status, ClipboardStatus::InvalidText);
    FillGlobalString(ctx.scratch, s_ClipboardMaxTextBytes + 1u, 0x78u);
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> largeAdmission = ctx.service.requestWriteText(ClipboardChannel::Clipboard, StringView(ctx.scratch));
    ASSERT_TRUE(largeAdmission.has_value());
    const ClipboardRequestToken large = largeAdmission.value();
    EXPECT_EQ(ctx.service.poll(large, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.status, ClipboardStatus::TooLarge);
    EXPECT_EQ(ctx.service.m_writeCount, 0u);
}

void VerifyClipboard_WrongThreadCallsNeverTouchRequestStorage(){
    FakeClipboardContext ctx = FakeClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> tokenAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(tokenAdmission.has_value());
    const ClipboardRequestToken token = tokenAdmission.value();
    JoiningThread worker = JoiningThread(lambda[mut ctx, in token]() -> void{
        EXPECT_FALSE(ctx.service.isOwnerThread());
        const auto wrongThreadRead = ctx.service.requestReadText(ClipboardChannel::Clipboard);
        ASSERT_FALSE(wrongThreadRead.has_value());
        EXPECT_EQ(wrongThreadRead.error(), ClipboardAdmission::WrongThread);
        const auto wrongThreadWrite = ctx.service.requestWriteText(ClipboardChannel::Clipboard, "ignored");
        ASSERT_FALSE(wrongThreadWrite.has_value());
        EXPECT_EQ(wrongThreadWrite.error(), ClipboardAdmission::WrongThread);
        EXPECT_EQ(ctx.service.poll(token, ctx.completion), ClipboardPollResult::WrongThread);
        EXPECT_FALSE(ctx.service.cancel(token));
        EXPECT_FALSE(ctx.service.pump());
    });
    worker.join();
    ASSERT_FALSE(HasFatalTestFailure());
    EXPECT_EQ(ctx.service.poll(token, ctx.completion), ClipboardPollResult::Pending);
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.poll(token, ctx.completion), ClipboardPollResult::Completed);
}

void VerifyClipboard_ConsumedCompletionOutlivesServiceAndItsArena(){
    StandaloneClipboardCompletion out = StandaloneClipboardCompletion();
    {
        FakeClipboardContext ctx = FakeClipboardContext();
        AssignGlobalString(ctx.service.m_text, "owned result");
        const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> tokenAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
        ASSERT_TRUE(tokenAdmission.has_value());
        const ClipboardRequestToken token = tokenAdmission.value();
        ASSERT_TRUE(ctx.service.pump());
        EXPECT_EQ(ctx.service.poll(token, out.completion), ClipboardPollResult::Completed);
    }
    EXPECT_EQ(out.completion.text, "owned result");
}

void VerifyClipboardAsync_PendingNativeRequestPreservesFifoAndCopiedWriteInput(){
    DelayedClipboardContext ctx = DelayedClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> firstAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(firstAdmission.has_value());
    const ClipboardRequestToken first = firstAdmission.value();
    AssignGlobalString(ctx.scratch, "copied write");
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> secondAdmission = ctx.service.requestWriteText(ClipboardChannel::Clipboard, StringView(ctx.scratch));
    ASSERT_TRUE(secondAdmission.has_value());
    const ClipboardRequestToken second = secondAdmission.value();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> thirdAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(thirdAdmission.has_value());
    const ClipboardRequestToken third = thirdAdmission.value();
    AssignGlobalString(ctx.scratch, "changed caller input");

    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.m_nativeToken, first);
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.m_startCount, 1u);
    EXPECT_EQ(ctx.service.poll(second, ctx.completion), ClipboardPollResult::Pending);
    ASSERT_TRUE(ctx.service.deliver(first, ClipboardStatus::Success, "first result"));
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.m_nativeToken, second);
    EXPECT_EQ(ctx.service.m_nativeOperation, ClipboardOperation::WriteText);
    EXPECT_EQ(ctx.service.m_startedText, "copied write");
    ASSERT_TRUE(ctx.service.deliver(second, ClipboardStatus::Success));
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.m_nativeToken, third);
    EXPECT_EQ(ctx.service.m_startCount, 3u);
    ASSERT_TRUE(ctx.service.deliver(third, ClipboardStatus::Success, "third result"));

    ASSERT_EQ(ctx.service.poll(first, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.text, "first result");
    ASSERT_EQ(ctx.service.poll(second, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.operation, ClipboardOperation::WriteText);
    EXPECT_TRUE(ctx.completion.text.empty());
    ASSERT_EQ(ctx.service.poll(third, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.text, "third result");
}

void VerifyClipboardAsync_CancellationReleasesFifoAndLateNativeRepliesCannotCompleteReplacement(){
    DelayedClipboardContext ctx = DelayedClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> oldAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(oldAdmission.has_value());
    const ClipboardRequestToken old = oldAdmission.value();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> nextAdmission = ctx.service.requestWriteText(ClipboardChannel::Clipboard, "next");
    ASSERT_TRUE(nextAdmission.has_value());
    const ClipboardRequestToken next = nextAdmission.value();
    ASSERT_TRUE(ctx.service.pump());
    ASSERT_TRUE(ctx.service.cancel(old));
    EXPECT_EQ(ctx.service.m_cancelCount, 1u);
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> replacementAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(replacementAdmission.has_value());
    const ClipboardRequestToken replacement = replacementAdmission.value();
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.m_nativeToken, next);
    EXPECT_FALSE(ctx.service.deliver(old, ClipboardStatus::Success, "stale bytes"));
    EXPECT_EQ(ctx.service.poll(old, ctx.completion), ClipboardPollResult::InvalidRequest);
    ASSERT_TRUE(ctx.service.deliver(next, ClipboardStatus::Success));
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.m_nativeToken, replacement);
    EXPECT_FALSE(ctx.service.deliver(old, ClipboardStatus::Success, "stale bytes"));
    EXPECT_EQ(ctx.service.poll(replacement, ctx.completion), ClipboardPollResult::Pending);
    ASSERT_TRUE(ctx.service.deliver(replacement, ClipboardStatus::Success, "replacement bytes"));
    ASSERT_EQ(ctx.service.poll(replacement, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.text, "replacement bytes");
}

void VerifyClipboardAsync_CancellationInvalidatesTokenBeforeReentrantNativeCleanup(){
    DelayedClipboardContext ctx = DelayedClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> oldAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(oldAdmission.has_value());
    const ClipboardRequestToken old = oldAdmission.value();
    ASSERT_TRUE(ctx.service.pump());
    ClipboardRequestToken replacement = ClipboardRequestToken();
    b8 observedCancellation = false;
    ctx.service.m_onCancel = lambda[mut ctx, in old, mut replacement, mut observedCancellation]() -> void{
        if(observedCancellation)
            return;
        observedCancellation = true;
        EXPECT_FALSE(ctx.service.cancel(old));
        EXPECT_EQ(ctx.service.poll(old, ctx.completion), ClipboardPollResult::InvalidRequest);
        EXPECT_FALSE(ctx.service.deliver(old, ClipboardStatus::Success, "late during cancellation"));
        const auto replacementAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
        ASSERT_TRUE(replacementAdmission.has_value());
        replacement = replacementAdmission.value();
    };
    ASSERT_TRUE(ctx.service.cancel(old));
    ASSERT_FALSE(HasFatalTestFailure());
    ctx.service.m_onCancel = OsServiceHook();
    EXPECT_TRUE(observedCancellation);
    EXPECT_EQ(ctx.service.m_cancelCount, 1u);
    ASSERT_TRUE(replacement.valid());
    EXPECT_EQ(ctx.service.poll(replacement, ctx.completion), ClipboardPollResult::Pending);
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.m_nativeToken, replacement);
    ASSERT_TRUE(ctx.service.deliver(replacement, ClipboardStatus::Success, "survives cleanup"));
    ASSERT_EQ(ctx.service.poll(replacement, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.text, "survives cleanup");
}

void VerifyClipboardAsync_ReentrantStartCancellationDefersNewGenerationToNextPump(){
    DelayedClipboardContext ctx = DelayedClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> oldAdmission = ctx.service.requestWriteText(ClipboardChannel::Clipboard, "old input");
    ASSERT_TRUE(oldAdmission.has_value());
    const ClipboardRequestToken old = oldAdmission.value();
    ClipboardRequestToken replacement = ClipboardRequestToken();
    ctx.service.m_onStart = lambda[mut ctx, in old, mut replacement]() -> void{
        if(ctx.service.m_nativeToken != old)
            return;
        ASSERT_TRUE(ctx.service.cancel(old));
        const auto replacementAdmission = ctx.service.requestWriteText(ClipboardChannel::Clipboard, "new input");
        ASSERT_TRUE(replacementAdmission.has_value());
        replacement = replacementAdmission.value();
        EXPECT_FALSE(ctx.service.deliver(old, ClipboardStatus::Success));
        EXPECT_FALSE(ctx.service.pump());
    };
    ASSERT_TRUE(ctx.service.pump());
    ASSERT_FALSE(HasFatalTestFailure());
    ctx.service.m_onStart = OsServiceHook();
    EXPECT_EQ(ctx.service.m_startCount, 1u);
    EXPECT_EQ(ctx.service.poll(old, ctx.completion), ClipboardPollResult::InvalidRequest);
    EXPECT_EQ(ctx.service.poll(replacement, ctx.completion), ClipboardPollResult::Pending);
    ASSERT_TRUE(ctx.service.pump());
    EXPECT_EQ(ctx.service.m_startCount, 2u);
    EXPECT_EQ(ctx.service.m_nativeToken, replacement);
    EXPECT_EQ(ctx.service.m_startedText, "new input");
    ASSERT_TRUE(ctx.service.deliver(replacement, ClipboardStatus::Success));
}

void VerifyClipboardAsync_DelayedRepliesValidateUtf8AndOwnTheirCompletionBytes(){
    DelayedClipboardContext ctx = DelayedClipboardContext();
    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> invalidAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(invalidAdmission.has_value());
    const ClipboardRequestToken invalid = invalidAdmission.value();
    ASSERT_TRUE(ctx.service.pump());
    ASSERT_TRUE(ctx.service.deliver(invalid, ClipboardStatus::Success, "\xF0\x9F"));
    ASSERT_EQ(ctx.service.poll(invalid, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.status, ClipboardStatus::InvalidText);
    EXPECT_TRUE(ctx.completion.text.empty());

    const Expected<ClipboardRequestToken, ClipboardAdmissionEnum> validAdmission = ctx.service.requestReadText(ClipboardChannel::Clipboard);
    ASSERT_TRUE(validAdmission.has_value());
    const ClipboardRequestToken valid = validAdmission.value();
    ASSERT_TRUE(ctx.service.pump());
    AssignGlobalString(ctx.scratch, "\xED\x95\x9C\xF0\x9F\x98\x80");
    ASSERT_TRUE(ctx.service.deliver(valid, ClipboardStatus::Success, StringView(ctx.scratch)));
    AssignGlobalString(ctx.scratch, "changed source");
    ASSERT_EQ(ctx.service.poll(valid, ctx.completion), ClipboardPollResult::Completed);
    EXPECT_EQ(ctx.completion.status, ClipboardStatus::Success);
    EXPECT_EQ(ctx.completion.text, "\xED\x95\x9C\xF0\x9F\x98\x80");
    EXPECT_FALSE(ctx.service.deliver(valid, ClipboardStatus::Success, "duplicate reply"));
}

void VerifyClipboardText_Utf8RejectsMalformedUnicodeAndEmbeddedNull(){
    EXPECT_EQ(ValidateClipboardUtf8Text(StringView()), ClipboardStatus::Success);
    EXPECT_EQ(ValidateClipboardUtf8Text("\xF4\x8F\xBF\xBF"), ClipboardStatus::Success);
    FixedVector<StringView, 7> invalid = FixedVector<StringView, 7>();
    invalid.push_back("\x80");
    invalid.push_back("\xC0\xAF");
    invalid.push_back("\xE0\x80\xAF");
    invalid.push_back("\xED\xA0\x80");
    invalid.push_back("\xF4\x90\x80\x80");
    invalid.push_back("\xF0\x9F");
    invalid.push_back(StringView("before\0after", 12u));
    for(in StringView text : invalid){
        EXPECT_EQ(ValidateClipboardUtf8Text(text), ClipboardStatus::InvalidText);
    }
}

void VerifyClipboardText_IncrementalChunksCanSplitUnicodeUntilFinalValidation(){
    ClipboardTextTestContext ctx = ClipboardTextTestContext();
    EXPECT_EQ(ctx.accumulator.appendBytes("\xED"), ClipboardStatus::Success);
    EXPECT_EQ(ValidateClipboardUtf8Text(StringView(ctx.accumulator.text())), ClipboardStatus::InvalidText);
    EXPECT_EQ(ctx.accumulator.appendBytes("\x95\x9C\xF0\x9F"), ClipboardStatus::Success);
    EXPECT_EQ(ValidateClipboardUtf8Text(StringView(ctx.accumulator.text())), ClipboardStatus::InvalidText);
    EXPECT_EQ(ctx.accumulator.appendBytes("\x98\x80"), ClipboardStatus::Success);
    EXPECT_EQ(ValidateClipboardUtf8Text(StringView(ctx.accumulator.text())), ClipboardStatus::Success);
    EXPECT_EQ(ctx.accumulator.text(), "\xED\x95\x9C\xF0\x9F\x98\x80");
}

void VerifyClipboardText_IncrementalFailuresDiscardBytesAndRemainStickyUntilClear(){
    ClipboardTextTestContext ctx = ClipboardTextTestContext();
    ASSERT_EQ(ctx.accumulator.appendBytes("prefix"), ClipboardStatus::Success);
    EXPECT_EQ(ctx.accumulator.appendBytes(StringView("a\0b", 3u)), ClipboardStatus::InvalidText);
    EXPECT_TRUE(ctx.accumulator.text().empty());
    EXPECT_EQ(ctx.accumulator.appendBytes("ignored"), ClipboardStatus::InvalidText);
    EXPECT_TRUE(ctx.accumulator.text().empty());
    ctx.accumulator.clear();
    EXPECT_EQ(ctx.accumulator.appendBytes("fresh"), ClipboardStatus::Success);
    EXPECT_EQ(ctx.accumulator.text(), "fresh");
}

void VerifyClipboardText_ByteLimitIsInclusiveAndBoundsIncrementalAccumulation(){
    ClipboardTextTestContext ctx = ClipboardTextTestContext();
    ctx.first.assign(s_ClipboardMaxTextBytes, cast<u8>(0x78u));
    EXPECT_EQ(ValidateClipboardUtf8Text(StringView(ctx.first)), ClipboardStatus::Success);
    ASSERT_EQ(ctx.accumulator.appendBytes(StringView(ctx.first)), ClipboardStatus::Success);
    EXPECT_EQ(ctx.accumulator.text().size(), s_ClipboardMaxTextBytes);
    EXPECT_EQ(ctx.accumulator.appendBytes("x"), ClipboardStatus::TooLarge);
    EXPECT_TRUE(ctx.accumulator.text().empty());
    EXPECT_EQ(ctx.accumulator.appendBytes("ignored"), ClipboardStatus::TooLarge);
    ctx.first.push_back(cast<u8>(0x78u));
    EXPECT_EQ(ValidateClipboardUtf8Text(StringView(ctx.first)), ClipboardStatus::TooLarge);
    ctx.accumulator.clear();
    EXPECT_EQ(ctx.accumulator.appendBytes("fresh"), ClipboardStatus::Success);
}

void VerifyClipboardText_Latin1UpperByteBoundsAndUnsupportedUnicodeClearOutput(){
    ClipboardTextTestContext ctx = ClipboardTextTestContext();
    const StringView source = StringView("\x80\xFF", 2u);
    ASSERT_EQ(DecodeClipboardLatin1(source, ctx.first), ClipboardStatus::Success);
    EXPECT_EQ(ctx.first, "\xC2\x80\xC3\xBF");
    ASSERT_EQ(EncodeClipboardLatin1(StringView(ctx.first), ctx.second), ClipboardStatus::Success);
    EXPECT_EQ(ctx.second, source);
    EXPECT_EQ(EncodeClipboardLatin1(StringView("\xC4\x80\xFF", 3u), ctx.second), ClipboardStatus::InvalidText);
    EXPECT_TRUE(ctx.second.empty());
    EXPECT_EQ(EncodeClipboardLatin1("\xE2\x98\x83", ctx.second), ClipboardStatus::Unsupported);
    EXPECT_TRUE(ctx.second.empty());
    EXPECT_EQ(DecodeClipboardLatin1(StringView("a\0b", 3u), ctx.first), ClipboardStatus::InvalidText);
    EXPECT_TRUE(ctx.first.empty());
}

void VerifyClipboardText_Latin1ConversionAcceptsAliasedOutputAndSubviews(){
    ClipboardTextTestContext ctx = ClipboardTextTestContext();
    ctx.first.assign(StringView("\x80\xFF", 2u));
    ASSERT_EQ(DecodeClipboardLatin1(StringView(ctx.first), ctx.first), ClipboardStatus::Success);
    EXPECT_EQ(ctx.first, "\xC2\x80\xC3\xBF");
    ASSERT_EQ(EncodeClipboardLatin1(StringView(ctx.first), ctx.first), ClipboardStatus::Success);
    EXPECT_EQ(StringView(ctx.first), StringView("\x80\xFF", 2u));

    ctx.first.assign("prefix\xC2\x80");
    const StringView suffix = StringView(ctx.first).substr(6u);
    ASSERT_EQ(EncodeClipboardLatin1(suffix, ctx.first), ClipboardStatus::Success);
    EXPECT_EQ(StringView(ctx.first), StringView("\x80", 1u));
}

void VerifyClipboardText_Latin1ExpansionCannotExceedUtf8ByteLimit(){
    ClipboardTextTestContext ctx = ClipboardTextTestContext();
    ctx.first.assign(s_ClipboardMaxTextBytes / 2u + 1u, cast<u8>(0xFFu));
    ctx.second.assign("stale bytes");
    EXPECT_EQ(DecodeClipboardLatin1(StringView(ctx.first), ctx.second), ClipboardStatus::TooLarge);
    EXPECT_TRUE(ctx.second.empty());
}

void VerifyTextInput_BeginRequiresFocusCapabilityAndOnlyOneActiveSession(){
    FakeTextInputContext ctx = FakeTextInputContext();
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> unavailableBegin = ctx.service.begin(TextInputSessionDesc());
    ASSERT_FALSE(unavailableBegin.has_value());
    EXPECT_EQ(unavailableBegin.error(), TextInputAdmission::Unavailable);
    ASSERT_TRUE(ctx.service.setFocused(true));
    ctx.service.m_supported = false;
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> unsupportedBegin = ctx.service.begin(TextInputSessionDesc());
    ASSERT_FALSE(unsupportedBegin.has_value());
    EXPECT_EQ(unsupportedBegin.error(), TextInputAdmission::Unsupported);
    ctx.service.m_supported = true;
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> first = ctx.service.begin(TextInputSessionDesc());
    ASSERT_TRUE(first.has_value());
    ASSERT_TRUE(first.value().valid());
    EXPECT_EQ(ctx.service.activeSession(), first.value());
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> busyBegin = ctx.service.begin(TextInputSessionDesc());
    ASSERT_FALSE(busyBegin.has_value());
    EXPECT_EQ(busyBegin.error(), TextInputAdmission::Busy);
    ASSERT_TRUE(ctx.service.end(first.value()));
    EXPECT_FALSE(ctx.service.activeSession().valid());
}

void VerifyTextInput_InputsAndPolledEventsOwnCopiedUtf8Bytes(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    AssignGlobalString(ctx.scratch, "A\xED\x95\x9C\xF0\x9F\x98\x80");
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(MakeSessionDesc(StringView(ctx.scratch), 1u, 4u));
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    ASSERT_TRUE(token.valid());
    AssignGlobalString(ctx.scratch, "changed caller input");
    EXPECT_EQ(ctx.service.currentText(), "A\xED\x95\x9C\xF0\x9F\x98\x80");
    EXPECT_EQ(ctx.service.m_nativeSurrounding, ctx.service.currentText());
    AssignGlobalString(ctx.secondScratch, "\xED\x95\x9C\xF0\x9F\x98\x80");
    ASSERT_EQ(ctx.service.sendCommit(token, StringView(ctx.secondScratch)), TextInputAdmission::Accepted);
    AssignGlobalString(ctx.secondScratch, "changed event input");
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.text, "\xED\x95\x9C\xF0\x9F\x98\x80");
    EXPECT_EQ(ctx.event.token, token);
    EXPECT_EQ(ctx.event.kind, TextInputEventKind::Commit);
    ASSERT_EQ(ctx.service.sendCommit(token, "next"), TextInputAdmission::Accepted);
    EXPECT_EQ(ctx.event.text, "\xED\x95\x9C\xF0\x9F\x98\x80");
}

void VerifyTextInput_EndRejectsLateEventsForeignTokensAndReusedGenerations(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    ASSERT_TRUE(ctx.foreign.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> oldAdmission = ctx.service.begin(TextInputSessionDesc());
    ASSERT_TRUE(oldAdmission.has_value());
    const TextInputSessionToken old = oldAdmission.value();
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> otherAdmission = ctx.foreign.begin(TextInputSessionDesc());
    ASSERT_TRUE(otherAdmission.has_value());
    const TextInputSessionToken other = otherAdmission.value();
    ASSERT_EQ(ctx.service.sendCommit(old, "queued"), TextInputAdmission::Accepted);
    ASSERT_TRUE(ctx.service.end(old));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> currentAdmission = ctx.service.begin(TextInputSessionDesc());
    ASSERT_TRUE(currentAdmission.has_value());
    const TextInputSessionToken current = currentAdmission.value();
    ASSERT_TRUE(current.valid());
    EXPECT_NE(old.generation, current.generation);
    EXPECT_NE(other.service, current.service);
    EXPECT_EQ(ctx.service.poll(old, ctx.event), TextInputPollResult::InvalidSession);
    EXPECT_EQ(ctx.service.poll(other, ctx.event), TextInputPollResult::InvalidSession);
    EXPECT_EQ(ctx.service.sendCommit(old, "late"), TextInputAdmission::InvalidSession);
    EXPECT_EQ(ctx.service.sendCommit(other, "foreign"), TextInputAdmission::InvalidSession);
    EXPECT_FALSE(ctx.service.end(old));
    EXPECT_EQ(ctx.service.poll(current, ctx.event), TextInputPollResult::Pending);
}

void VerifyTextInput_FocusLossReplacesQueuedWorkWithOneTerminalCancellation(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(TextInputSessionDesc());
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    ASSERT_EQ(ctx.service.sendCommit(token, "unconsumed"), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.sendPreedit(token, "draft", 5u, 5u), TextInputAdmission::Accepted);
    ASSERT_TRUE(ctx.service.setFocused(false));
    EXPECT_FALSE(ctx.service.activeSession().valid());
    EXPECT_EQ(ctx.service.m_endCount, 1u);
    EXPECT_EQ(ctx.service.sendCommit(token, "stale"), TextInputAdmission::InvalidSession);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.kind, TextInputEventKind::Cancelled);
    EXPECT_EQ(ctx.event.cancelReason, TextInputCancelReason::FocusLost);
    EXPECT_TRUE(ctx.event.text.empty());
    EXPECT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::InvalidSession);
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> unavailableBegin = ctx.service.begin(TextInputSessionDesc());
    ASSERT_FALSE(unavailableBegin.has_value());
    EXPECT_EQ(unavailableBegin.error(), TextInputAdmission::Unavailable);
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> resumed = ctx.service.begin(TextInputSessionDesc());
    ASSERT_TRUE(resumed.has_value());
    EXPECT_TRUE(resumed.value().valid());
}

void VerifyTextInput_NewSessionInvalidatesUnpolledCancellation(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> oldAdmission = ctx.service.begin(TextInputSessionDesc());
    ASSERT_TRUE(oldAdmission.has_value());
    const TextInputSessionToken old = oldAdmission.value();
    ASSERT_TRUE(ctx.service.sendCancel(old, TextInputCancelReason::NativeCancelled));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> currentAdmission = ctx.service.begin(TextInputSessionDesc());
    ASSERT_TRUE(currentAdmission.has_value());
    const TextInputSessionToken current = currentAdmission.value();
    EXPECT_EQ(ctx.service.poll(old, ctx.event), TextInputPollResult::InvalidSession);
    EXPECT_EQ(ctx.service.poll(current, ctx.event), TextInputPollResult::Pending);
}

void VerifyTextInput_ConsecutivePreeditCoalescesWithoutCrossingCommitOrDeletion(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(MakeSessionDesc("abc", 1u, 1u));
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    const u64 revision = ctx.service.surroundingRevision(token);
    ASSERT_EQ(ctx.service.sendPreedit(token, "draft", 5u, 5u), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.sendPreedit(token, "final draft", 11u, 11u, false), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.sendCommit(token, "committed"), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.sendPreedit(token, "new", 3u, 3u), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.sendDeletion(token, 1u, 1u, revision, TextInputDeletionBasis::Caret), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.sendPreedit(token, "last", 4u, 4u), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.text, "final draft");
    EXPECT_FALSE(ctx.event.caretVisible);
    u64 lastSequence = ctx.event.sequence;
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.kind, TextInputEventKind::Commit);
    EXPECT_EQ(ctx.event.text, "committed");
    EXPECT_GT(ctx.event.sequence, lastSequence);
    lastSequence = ctx.event.sequence;
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.text, "new");
    EXPECT_GT(ctx.event.sequence, lastSequence);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.kind, TextInputEventKind::DeleteSurrounding);
    EXPECT_EQ(ctx.event.deleteBeforeBytes, 1u);
    EXPECT_EQ(ctx.event.deleteAfterBytes, 1u);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.text, "last");
    EXPECT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Pending);
}

void VerifyTextInput_QueueOverflowCancelsInsteadOfApplyingPartialCommittedText(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(TextInputSessionDesc());
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    for(usize index = 0u; index < s_TextInputMaxEvents; ++index){
        ASSERT_EQ(ctx.service.sendCommit(token, "x"), TextInputAdmission::Accepted);
    }
    EXPECT_EQ(ctx.service.sendCommit(token, "overflow"), TextInputAdmission::QueueFull);
    EXPECT_FALSE(ctx.service.activeSession().valid());
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.kind, TextInputEventKind::Cancelled);
    EXPECT_EQ(ctx.event.cancelReason, TextInputCancelReason::Overflow);
    EXPECT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::InvalidSession);
}

void VerifyTextInput_QueuedByteBudgetCancelsEvenBelowEventCountLimit(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(TextInputSessionDesc());
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    FillGlobalString(ctx.scratch, s_TextInputMaxEventTextBytes, 0x78u);
    for(usize index = 0u; index < s_TextInputMaxQueuedTextBytes / ctx.scratch.size(); ++index){
        ASSERT_EQ(ctx.service.sendCommit(token, StringView(ctx.scratch)), TextInputAdmission::Accepted);
    }
    EXPECT_EQ(ctx.service.sendCommit(token, "x"), TextInputAdmission::QueueFull);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.cancelReason, TextInputCancelReason::Overflow);
}

void VerifyTextInput_InvalidUpdatesAreAtomicAndDeleteOffsetsRequireUtf8BoundariesAndRevision(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const StringView initialText = "\x41\xED\x95\x9C\x42";
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(MakeSessionDesc(initialText, 4u, 4u));
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    ASSERT_TRUE(token.valid());
    EXPECT_EQ(ctx.service.updateSurrounding(token, "bad\xF0\x9F", 0u, 0u), TextInputAdmission::InvalidText);
    EXPECT_EQ(ctx.service.updateSurrounding(token, "\xED\x95\x9C", 1u, 3u), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.currentText(), initialText);
    EXPECT_EQ(ctx.service.currentCaretByte(), 4u);
    EXPECT_EQ(ctx.service.surroundingRevision(token), 1u);
    const u64 revision = ctx.service.surroundingRevision(token);
    EXPECT_EQ(ctx.service.updateCaret(token, TextInputRect(0, 0, 0, 1)), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.currentRectangle().width, 1);
    EXPECT_EQ(ctx.service.sendDeletion(token, 1u, 0u, revision, TextInputDeletionBasis::Caret), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.sendDeletion(token, 5u, 0u, revision, TextInputDeletionBasis::Caret), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.sendDeletion(token, 0u, 2u, revision, TextInputDeletionBasis::Caret), TextInputAdmission::InvalidRange);
    ASSERT_EQ(ctx.service.sendDeletion(token, 3u, 1u, revision, TextInputDeletionBasis::Caret), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.surroundingRevision, 1u);
    ASSERT_EQ(ctx.service.updateSurrounding(token, "updated", 0u, 0u), TextInputAdmission::Accepted);
    EXPECT_EQ(ctx.service.surroundingRevision(token), 2u);
    const u64 currentRevision = ctx.service.surroundingRevision(token);
    EXPECT_EQ(ctx.service.sendDeletion(token, 0u, 1u, revision, TextInputDeletionBasis::Caret), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.sendDeletion(token, 0u, 1u, currentRevision, TextInputDeletionBasis::Caret), TextInputAdmission::Accepted);
}

void VerifyTextInput_MalformedNativeTextAndPreeditSelectionsCannotEnterQueue(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(TextInputSessionDesc());
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    EXPECT_EQ(ctx.service.sendCommit(token, StringView("a\0b", 3u)), TextInputAdmission::InvalidText);
    EXPECT_EQ(ctx.service.sendPreedit(token, "\xED\x95\x9C", 1u, 3u), TextInputAdmission::InvalidRange);
    FillGlobalString(ctx.scratch, s_TextInputMaxEventTextBytes + 1u, 0x78u);
    EXPECT_EQ(ctx.service.sendCommit(token, StringView(ctx.scratch)), TextInputAdmission::TooLarge);
    EXPECT_EQ(ctx.service.activeSession(), token);
    EXPECT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Pending);
}

void VerifyTextInput_CancellationInvalidatesBeforeNativeCleanupAndRejectsReentry(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(TextInputSessionDesc());
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    ctx.service.m_onEnd = lambda[mut ctx, in token](in TextInputSessionToken ended) -> void{
        EXPECT_EQ(ended, token);
        EXPECT_EQ(ctx.service.sendCommit(ended, "reentrant late"), TextInputAdmission::InvalidSession);
        const auto busyBegin = ctx.service.begin(TextInputSessionDesc());
        ASSERT_FALSE(busyBegin.has_value());
        EXPECT_EQ(busyBegin.error(), TextInputAdmission::Busy);
        EXPECT_FALSE(ctx.service.end(ended));
    };
    ASSERT_TRUE(ctx.service.sendCancel(token, TextInputCancelReason::NativeCancelled));
    ASSERT_FALSE(HasFatalTestFailure());
    ctx.service.m_onEnd = OsSessionHook();
    EXPECT_EQ(ctx.service.m_endCount, 1u);
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> resumed = ctx.service.begin(TextInputSessionDesc());
    ASSERT_TRUE(resumed.has_value());
    ASSERT_TRUE(resumed.value().valid());
}

void VerifyTextInput_NativeStartFailureRetiresTokenAndAnyEarlyEvent(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    TextInputSessionToken failed = TextInputSessionToken();
    ctx.service.m_onStart = lambda[mut ctx, mut failed]() -> void{
        failed = ctx.service.activeSession();
        EXPECT_EQ(ctx.service.sendCommit(failed, "early event"), TextInputAdmission::Accepted);
    };
    ctx.service.m_startAdmission = TextInputAdmission::NativeFailure;
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> nativeFailureBegin = ctx.service.begin(TextInputSessionDesc());
    ASSERT_FALSE(nativeFailureBegin.has_value());
    EXPECT_EQ(nativeFailureBegin.error(), TextInputAdmission::NativeFailure);
    EXPECT_FALSE(ctx.service.activeSession().valid());
    EXPECT_EQ(ctx.service.poll(failed, ctx.event), TextInputPollResult::InvalidSession);
    EXPECT_EQ(ctx.service.m_endCount, 1u);
}

void VerifyTextInput_WrongThreadCannotMutateOrPollOwnerSession(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(TextInputSessionDesc());
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    JoiningThread worker = JoiningThread(lambda[mut ctx, in token]() -> void{
        TextInputEvent threadEvent = TextInputEvent();
        EXPECT_FALSE(ctx.service.isOwnerThread());
        EXPECT_FALSE(ctx.service.activeSession().valid());
        EXPECT_EQ(ctx.service.surroundingRevision(token), 0u);
        const auto wrongThreadBegin = ctx.service.begin(TextInputSessionDesc());
        ASSERT_FALSE(wrongThreadBegin.has_value());
        EXPECT_EQ(wrongThreadBegin.error(), TextInputAdmission::WrongThread);
        EXPECT_EQ(ctx.service.sendCommit(token, "wrong thread"), TextInputAdmission::WrongThread);
        EXPECT_EQ(ctx.service.poll(token, threadEvent), TextInputPollResult::WrongThread);
        EXPECT_EQ(ctx.service.updateCaret(token, TextInputRect()), TextInputAdmission::WrongThread);
        EXPECT_EQ(ctx.service.updateSurrounding(token, "", 0u, 0u), TextInputAdmission::WrongThread);
        EXPECT_FALSE(ctx.service.setFocused(false));
        EXPECT_FALSE(ctx.service.end(token));
    });
    worker.join();
    ASSERT_FALSE(HasFatalTestFailure());
    EXPECT_EQ(ctx.service.activeSession(), token);
    EXPECT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Pending);
}

void VerifyTextInput_NullNativeFactoryReportsUnsupportedWithoutClaimingTextInput(){
    UnsupportedTextInputContext ctx = UnsupportedTextInputContext();
    ASSERT_TRUE(ctx.factorySucceeded);
    ASSERT_TRUE(ctx.hasService());
    EXPECT_FALSE(ctx.capabilities().commit);
    EXPECT_FALSE(ctx.capabilities().preedit);
    EXPECT_FALSE(ctx.capabilities().surrounding);
    EXPECT_FALSE(ctx.capabilities().deleteSurrounding);
    ASSERT_TRUE(ctx.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> unsupportedBegin = ctx.beginEmpty();
    ASSERT_FALSE(unsupportedBegin.has_value());
    EXPECT_EQ(unsupportedBegin.error(), TextInputAdmission::Unsupported);
}

void VerifyTextInput_ReentrantNativeCaretCancellationReturnsFailureAndRetainsTerminalEvent(){
