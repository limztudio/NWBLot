    private SmokeClipboardRef m_clipboard;
    private String m_longText = "";
    private EditModel m_model;
    private TextAreaState m_state = TextAreaState();
    private EditBoxView m_observed;
    private ClipboardCompletion m_completion;
    private ClipboardRequestToken m_clipboardToken = ClipboardRequestToken();
    private UiTextAreaSnapshot m_snapshot = UiTextAreaSnapshot();
    private u32 m_submits = 0u;
    private u32 m_cancels = 0u;
    private u32 m_blurs = 0u;
    private u32 m_abandons = 0u;
    private u32 m_outside = 0u;
    private u32 m_clipboardSeeds = 0u;
    private b8 m_enabled = true;
    private b8 m_readOnly = false;
    private b8 m_compact = false;
    private b8 m_longDocument = false;

    public UiTextAreaSmokeScene(mut GlobalArena arena, mut IClipboardService clipboard);
    public ~UiTextAreaSmokeScene();

    public b8 paint(mut UiPaintContext context);

    private void resetModel();
    private void longDocument();
    private b8 seedClipboard();
    private b8 drainClipboard();
    private b8 observeState(mut UiPaintContext context);
    private void paintMarkers(mut UiPaintContext context)const;
}


