}

void VerifyUiBuilderTests_PreparedFrameTargetsStayInaccessibleUntilExactCommit(mut UiBuilderTests self){
    WidgetOptions fixed = WidgetOptions();
    fixed.width.policy = LayoutSizePolicy::Fixed;
    fixed.width.value = 20.0f;
    fixed.height.policy = LayoutSizePolicy::Fixed;
    fixed.height.value = 20.0f;
    ASSERT_TRUE(self.begin(1u, MakeUiBuilderRect(0.0f, 0.0f, 100.0f, 100.0f)));
    EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "", fixed));
    ASSERT_TRUE(self.finish());
    const DrawSnapshot first = self.m_paint.freeze();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    ASSERT_TRUE(self.begin(2u, MakeUiBuilderRect(150.0f, 50.0f, 100.0f, 100.0f)));
    EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "", fixed));
    ASSERT_TRUE(self.finish());
    const DrawSnapshot prepared = self.m_paint.freeze();
    EXPECT_EQ(first.generation(), 1u);
    EXPECT_EQ(prepared.generation(), 2u);
    EXPECT_TRUE(self.m_context.ready());
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiBuilderPoint(15.0f, 15.0f)), self.id(s_UiBuilderApplyKey));
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiBuilderPoint(160.0f, 60.0f)).valid());
    EXPECT_FALSE(self.send(MakeUiBuilderPointerEvent(InputEventType::PrimaryDown, MakeUiBuilderPoint(160.0f, 60.0f))).pointerConsumed);
    EXPECT_FALSE(self.send(MakeUiBuilderPointerEvent(InputEventType::PrimaryUp, MakeUiBuilderPoint(160.0f, 60.0f))).pointerConsumed);
    EXPECT_TRUE(self.m_context.input().actions().empty());
    EXPECT_FALSE(self.m_context.beginFrame(3u));
    EXPECT_FALSE(self.m_context.commitFrame(1u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiBuilderPoint(160.0f, 60.0f)), self.id(s_UiBuilderApplyKey));
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiBuilderPoint(15.0f, 15.0f)).valid());
}

void VerifyUiBuilderTests_EscapeBeforeReleaseCancelsPointerAndKeyboardButtonSubmission(mut UiBuilderTests self){
    ASSERT_TRUE(self.begin(1u));
    EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "Apply"));
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const Optional<HitTarget> target = self.findTarget(self.id(s_UiBuilderApplyKey));
    ASSERT_TRUE(target.has_value());
    const Point point = CenterUiRect(target.value().rectangle);
    u64 generation = 1u;
    Array<i32, 3u> keys = Array<i32, 3u>();
    keys[0u] = CoreKey::Unknown;
    keys[1u] = CoreKey::Enter;
    keys[2u] = CoreKey::Space;
    for(in i32 key : keys){
        if(!self.m_context.input().focus().valid()){
            EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyDown, CoreKey::Tab, false, false)).commandConsumed);
            EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyUp, CoreKey::Tab, false, false)).commandConsumed);
        }
        ASSERT_EQ(self.m_context.input().focus(), self.id(s_UiBuilderApplyKey));
        const b8 pointer = key == CoreKey::Unknown;
        InputEvent down = InputEvent();
        down.position = point;
        down.key = key;
        if(pointer)
            down.type = InputEventType::PrimaryDown;
        else
            down.type = InputEventType::KeyDown;
        InputEvent up = InputEvent();
        up.position = point;
        up.key = key;
        if(pointer)
            up.type = InputEventType::PrimaryUp;
        else
            up.type = InputEventType::KeyUp;
        const InputRoutingResult held = self.send(down);
        if(pointer)
            EXPECT_TRUE(held.pointerConsumed);
        else
            EXPECT_TRUE(held.commandConsumed);
        ++generation;
        ASSERT_TRUE(self.begin(generation));
        EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "Apply"));
        ASSERT_TRUE(self.finish());
        ASSERT_TRUE(self.m_context.commitFrame(generation));
        EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyDown, CoreKey::Escape, false, false)).commandConsumed);
        EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyUp, CoreKey::Escape, false, false)).commandConsumed);
        const InputRoutingResult released = self.send(up);
        if(pointer)
            EXPECT_TRUE(released.pointerConsumed);
        else
            EXPECT_TRUE(released.commandConsumed);
        ++generation;
        ASSERT_TRUE(self.begin(generation));
        EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "Apply"));
        ASSERT_TRUE(self.finish());
        ASSERT_TRUE(self.m_context.commitFrame(generation));
        EXPECT_TRUE(self.m_context.input().actions().empty());
    }
    EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyDown, CoreKey::Tab, false, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyUp, CoreKey::Tab, false, false)).commandConsumed);
    ASSERT_EQ(self.m_context.input().focus(), self.id(s_UiBuilderApplyKey));
    EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyDown, CoreKey::Enter, false, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyUp, CoreKey::Enter, false, false)).commandConsumed);
    ++generation;
    ASSERT_TRUE(self.begin(generation));
    EXPECT_TRUE(self.m_builder.button(s_UiBuilderApplyKey, "Apply"));
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(generation));
}

void VerifyUiBuilderTests_FocusTransferWhileButtonSubmitIsHeldCannotActivateEitherButton(mut UiBuilderTests self){
    ASSERT_TRUE(self.begin(1u));
    EXPECT_FALSE(self.m_builder.button("first", "First"));
    EXPECT_FALSE(self.m_builder.button("second", "Second"));
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyDown, CoreKey::Tab, false, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyUp, CoreKey::Tab, false, false)).commandConsumed);
    ASSERT_EQ(self.m_context.input().focus(), self.id("first"));
    EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyDown, CoreKey::Enter, false, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyDown, CoreKey::Tab, false, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyUp, CoreKey::Tab, false, false)).commandConsumed);
    ASSERT_EQ(self.m_context.input().focus(), self.id("second"));
    EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyUp, CoreKey::Enter, false, false)).commandConsumed);
    ASSERT_TRUE(self.begin(2u));
    EXPECT_FALSE(self.m_builder.button("first", "First"));
    EXPECT_FALSE(self.m_builder.button("second", "Second"));
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyDown, CoreKey::Enter, false, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyUp, CoreKey::Enter, false, false)).commandConsumed);
    ASSERT_TRUE(self.begin(3u));
    EXPECT_FALSE(self.m_builder.button("first", "First"));
    EXPECT_TRUE(self.m_builder.button("second", "Second"));
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
}

void VerifyUiBuilderTests_FrozenPaintRetainsValuesAndFontPagesAfterModelChangeAndBuilderReuse(mut UiBuilderTests self){
    b8 checked = true;
    String caption = "A";
    ASSERT_TRUE(self.begin(1u));
    EXPECT_FALSE(self.m_builder.checkbox("enabled", "Enabled", checked));
    ASSERT_TRUE(self.m_builder.label(s_UiBuilderCaptionKey, caption));
    ASSERT_TRUE(self.finish());
    const DrawSnapshot first = self.m_paint.freeze();
    const Expected<Rect> originalMarker = self.regionQuad(first, 9u);
    ASSERT_TRUE(originalMarker.has_value());
    EXPECT_FLOAT_EQ(originalMarker.value().width, 20.4f);
    ASSERT_FALSE(first.glyphPages().empty());
    const Sha256Digest pixelHash = ComputeUiBuilderFirstGlyphPageHash(first);
    Vector<Vertex> saved;
    saved.reserve(first.vertices().size());
    for(usize index = 0u; index < first.vertices().size(); ++index)
        saved.push_back(first.vertices()[index]);
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    checked = false;
    caption.assign("A longer changed model caption");
    ASSERT_TRUE(self.begin(2u));
    EXPECT_FALSE(self.m_builder.checkbox("enabled", "Enabled", checked));
    ASSERT_TRUE(self.m_builder.label(s_UiBuilderCaptionKey, caption));
    ASSERT_TRUE(self.finish());
    const DrawSnapshot second = self.m_paint.freeze();
    EXPECT_FALSE(self.regionQuad(second, 9u).has_value());
    const Expected<Rect> retainedMarker = self.regionQuad(first, 9u);
    ASSERT_TRUE(retainedMarker.has_value());
    EXPECT_FLOAT_EQ(retainedMarker.value().width, originalMarker.value().width);
    ASSERT_EQ(first.vertices().size(), saved.size());
    EXPECT_TRUE(EqualUiBuilderVertexBytes(first.vertices(), saved));
    EXPECT_EQ(ComputeUiBuilderFirstGlyphPageHash(first), pixelHash);
    EXPECT_EQ(ReadUiBuilderFirstGlyphPageFontGeneration(first), 1u);
    EXPECT_EQ(first.generation(), 1u);
    EXPECT_EQ(second.generation(), 2u);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
}


