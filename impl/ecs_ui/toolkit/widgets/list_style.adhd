////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_ListDefaultHeight = 240.0f;
// Padding left, top, right, bottom, then minimum x and y.
const usize s_ListRowMetricCount = 6u;
const usize s_ListLanguageBufferBytes = 64u;
const u32 s_ListMaxPreparedRows = 1024u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> ListActionOutcome{
    Continue,
    Stop,
    Failed,
}

class SelectableStyle{
    public Name normal = Name("list.row.normal");
    public Name hover = Name("list.row.hover");
    public Name selected = Name("list.row.selected");
    public Name disabled = Name("list.row.disabled");
    public Name fallback = Name("button.normal");
    public Name hoverFallback = Name("button.hover");
    public Name selectedFallback = Name("button.pressed");
    public Name disabledFallback = Name("button.disabled");
    public Name focus = Name("focus.overlay");
    public Insets padding = Insets(s_StyleSpacingMedium, s_StyleSpacingSmall, s_StyleSpacingMedium, s_StyleSpacingSmall);
}

class ListStyle{
    public SelectableStyle row;
    public Name background = Name("list.background");
    public Name backgroundFallback = Name("panel.normal");
    public Name track = Name("scroll.track");
    public Name trackFallback = Name("panel.normal");
    public Name thumb = Name("scroll.thumb");
    public Name thumbFallback = Name("button.normal");
    public Name thumbHover = Name("button.hover");
    public Insets padding = Insets(s_StyleSpacingSmall, s_StyleSpacingSmall, s_StyleSpacingSmall, s_StyleSpacingSmall);
    public f32 scrollbarWidth = s_StyleScrollbarThickness;
    public f32 minimumThumb = s_StyleScrollbarMinimumThumb;
}

class ListOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public LayoutSize height = LayoutSize(LayoutSizePolicy::Fixed, s_ListDefaultHeight);
    public f32 wheelRows = s_StyleScrollWheelStep;
    public b8 enabled = true;
    public b8 selectOnNavigate = true;
}

class ListResult{
    public b8 valid = false;
    public b8 selectionChanged = false;
    public b8 activated = false;
    public b8 focused = false;
}

// Stable across interaction states so hover, selection and disabling cannot change text placement.
class SelectableMetrics{
    public Insets padding;
    public Point minimum;
}

class SelectablePaintFlags{
    public b8 enabled = true;
    public b8 selected = false;
    public b8 hover = false;
    public b8 focused = false;
}

class ListKeyResolution{
    public ListKeyResolution(){
        this.index = 0u;
        this.present = false;
    }

    public ListKeyResolution(in u64 inIndex, in b8 inPresent){
        this.index = inIndex;
        this.present = inPresent;
    }

    public u64 index;
    public b8 present;
}

class ListMeasureKey{
    private b8 equals(in ListMeasureKey rhs)const{
        if(
            this.sourceGeneration != rhs.sourceGeneration
            || this.sourceRevision != rhs.sourceRevision
            || this.rowCount != rhs.rowCount
            || this.textIdentity != rhs.textIdentity
            || this.textGeneration != rhs.textGeneration
            || this.fontSize != rhs.fontSize
            || this.pixelScaleX != rhs.pixelScaleX
            || this.pixelScaleY != rhs.pixelScaleY
            || this.scriptTag != rhs.scriptTag
        )
            return false;
        for(usize i = 0u; i < s_ListRowMetricCount; ++i){
            if(this.rowMetrics[i] != rhs.rowMetrics[i])
                return false;
        }
        for(usize i = 0u; i < s_ListLanguageBufferBytes; ++i){
            if(this.language[i] != rhs.language[i])
                return false;
        }
        return true;
    }

    public b8 operator==(in ListMeasureKey rhs)const{
        return this.equals(rhs);
    }

    public b8 operator!=(in ListMeasureKey rhs)const{
        return !this.equals(rhs);
    }

    public u64 sourceGeneration = 0u;
    public u64 sourceRevision = 0u;
    public u64 rowCount = 0u;
    public u64 textIdentity = 0u;
    public u64 textGeneration = 0u;
    public f32 fontSize = 0.0f;
    public f32 pixelScaleX = 0.0f;
    public f32 pixelScaleY = 0.0f;
    public Array<f32, s_ListRowMetricCount> rowMetrics;
    public Array<u8, s_ListLanguageBufferBytes> language;
    public u32 scriptTag = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidListOptions(in ListOptions options){
    return options.enabled && isFinite(options.wheelRows) && options.wheelRows > 0.0f;
}

b8 IsReverseListControlAction(in ControlActionKind kind){
    return kind == ControlActionKind::Up || kind == ControlActionKind::PageUp || kind == ControlActionKind::End;
}

Expected<f64> TryComputeListWheelOffset(in f64 current, in f64 delta, in f64 step, in f64 maximum){
    if(!isFinite(delta) || !isFinite(step) || step <= 0.0 || !isFinite(maximum) || maximum < 0.0)
        return makeUnexpected(Failure());
    f64 candidateValue = min(current, maximum);
    if(delta > 0.0){
        const f64 distanceInSteps = candidateValue / step;
        if(delta >= distanceInSteps)
            candidateValue = 0.0;
        else
            candidateValue = candidateValue - delta * step;
    }
    else if(delta < 0.0){
        const f64 reverseDelta = -delta;
        const f64 distanceInSteps = (maximum - candidateValue) / step;
        if(reverseDelta >= distanceInSteps)
            candidateValue = maximum;
        else
            candidateValue = candidateValue + reverseDelta * step;
    }
    f64 candidate = 0.0;
    if(candidateValue > 0.0)
        candidate = min(maximum, candidateValue);
    if(!isFinite(candidate))
        return makeUnexpected(Failure());
    return candidate;
}

Expected<UiSkinRegion> TryResolveSelectableStateRegion(in UiSkin skin, in Name preferred, in Name fallback){
    UiSkinRegion outRegion;
    if(skin.tryFindRegion(preferred, outRegion))
        return outRegion;
    if(skin.tryFindRegion(fallback, outRegion))
        return outRegion;
    return makeUnexpected(Failure());
}

b8 AccumulateSelectableStateMetrics(in UiSkin skin, in Name preferred, in Name fallback, mut SelectableMetrics metrics){
    const Expected<UiSkinRegion> region = TryResolveSelectableStateRegion(skin, preferred, fallback);
    if(!region.has_value())
        return false;
    const Insets padding(region.value().padding.left, region.value().padding.top, region.value().padding.right, region.value().padding.bottom);
    const Point minimum(region.value().minimumWidth, region.value().minimumHeight);
    if(!IsBoundedUiPadding(padding) || !IsValidUiExtent(minimum))
        return false;
    metrics.padding = MaxUiPadding(metrics.padding, padding);
    metrics.minimum = Point(max(metrics.minimum.x, minimum.x), max(metrics.minimum.y, minimum.y));
    return true;
}

Expected<SelectableMetrics> MeasureSelectable(in UiSkin skin, in SelectableStyle style){
    if(!IsBoundedUiPadding(style.padding))
        return makeUnexpected(Failure());
    SelectableMetrics metrics;
    metrics.padding = style.padding;
    if(
        !AccumulateSelectableStateMetrics(skin, style.normal, style.fallback, metrics)
        || !AccumulateSelectableStateMetrics(skin, style.hover, style.hoverFallback, metrics)
        || !AccumulateSelectableStateMetrics(skin, style.selected, style.selectedFallback, metrics)
        || !AccumulateSelectableStateMetrics(skin, style.disabled, style.disabledFallback, metrics)
        || !IsBoundedUiPadding(metrics.padding)
    )
        return makeUnexpected(Failure());
    return metrics;
}

// Use the same display-scale visual bounds and resolved padding that sized the control.
b8 PaintSelectable(
    mut PaintBuilder paint,
    mut TextService text,
    in UiSkin skin,
    in TextLayout layout,
    in Rect textBounds,
    in Insets padding,
    in Rect bounds,
    in Rect clip,
    in SelectableStyle style,
    in SelectablePaintFlags flags,
    in Color textColor,
    in Color disabledTextColor
){
    Name preferred = style.normal;
    Name fallback = style.fallback;
    if(!flags.enabled){
        preferred = style.disabled;
        fallback = style.disabledFallback;
    }
    else if(flags.selected){
        preferred = style.selected;
        fallback = style.selectedFallback;
    }
    else if(flags.hover){
        preferred = style.hover;
        fallback = style.hoverFallback;
    }
    const Expected<UiSkinRegion> region = TryResolveSelectableStateRegion(skin, preferred, fallback);
    if(!region.has_value())
        return false;
    paint.pushClip(clip);
    paint.pushClip(bounds);
    b8 painted = paint.drawRegion(region.value().name, bounds);
    if(painted && flags.enabled && flags.focused && skin.hasRegion(style.focus))
        painted = paint.drawRegion(style.focus, bounds);
    const Rect content = InsetUiRectBounds(bounds, padding);
    const Point origin = ResolveCenteredTextOrigin(content, 0.0f, textBounds);
    paint.pushClip(content);
    if(painted){
        Color activeColor = disabledTextColor;
        if(flags.enabled)
            activeColor = textColor;
        painted = text.paint(paint, layout, origin, activeColor);
    }
    const b8 textPopped = paint.popClip();
    const b8 rowPopped = paint.popClip();
    const b8 clipPopped = paint.popClip();
    return painted && textPopped && rowPopped && clipPopped;
}

u64 ResolveListNavigationStartIndex(in u64 count, in ListKeyResolution current, in ControlAction action){
    const b8 reverse = IsReverseListControlAction(action.kind);
    u64 start = 0u;
    if(reverse)
        start = count - 1u;
    if(action.kind == ControlActionKind::Home)
        start = 0u;
    else if(action.kind == ControlActionKind::End)
        start = count - 1u;
    else if(current.present){
        u64 distance = 1u;
        if(action.kind == ControlActionKind::PageUp || action.kind == ControlActionKind::PageDown)
            distance = action.pageRows;
        if(reverse)
            start = current.index - min(distance, current.index);
        else
            start = current.index + min(distance, count - 1u - current.index);
    }
    return start;
}

b8 ValidateListEnabledSearchIndex(in u64 index, in u64 count, in u64 start, in b8 reverse){
    if(index >= count)
        return false;
    if(reverse)
        return index <= start;
    return index >= start;
}

b8 ValidateListControlActionHeader(in ListOptions options, in ControlToken token, in ControlAction action){
    return IsValidListOptions(options)
        && token.valid()
        && action.control == token
        && cast<u8>(action.kind) <= cast<u8>(ControlActionKind::Activate)
        && !((action.kind == ControlActionKind::PageUp || action.kind == ControlActionKind::PageDown) && action.pageRows == 0u);
}

void ApplyListCandidateSelection(
    in ListOptions options,
    in b8 activate,
    in u64 candidate,
    mut u64 inOutSelected,
    mut u64 outCursor,
    mut b8 outEnsureCursor,
    mut ListResult inOutResult
){
    if(candidate != 0u){
        outCursor = candidate;
        outEnsureCursor = true;
        if(activate || options.selectOnNavigate){
            inOutResult.selectionChanged = inOutResult.selectionChanged || inOutSelected != candidate;
            inOutSelected = candidate;
        }
        inOutResult.activated = inOutResult.activated || activate;
    }
    inOutResult.valid = true;
}

u64 ComputeListHostPageRows(in f32 viewportHeight, in f32 rowHeight, in u64 rowCount){
    const f64 page = floor(cast<f64>(viewportHeight) / cast<f64>(rowHeight));
    if(page >= cast<f64>(rowCount))
        return max(cast<u64>(1u), rowCount);
    return max(cast<u64>(1u), cast<u64>(page));
}

f64 ComputeListExpandedScrollOffset(
    in f32 contentClipY,
    in f32 viewportY,
    in f64 candidateOffset,
    in u64 candidateFirstRow,
    in f32 oldRowHeight,
    in f32 newRowHeight
){
    const f64 clippedTop = cast<f64>(contentClipY) - cast<f64>(viewportY);
    const f64 firstRow = cast<f64>(candidateFirstRow);
    const f64 within = (candidateOffset + clippedTop) - (firstRow * cast<f64>(oldRowHeight));
    const f64 offset = ((firstRow * cast<f64>(newRowHeight)) + within) - clippedTop;
    return max(0.0, offset);
}

f64 ComputeListRescaledScrollOffset(
    in f32 contentClipY,
    in f32 viewportY,
    in f64 scrollOffset,
    in f32 oldRowHeight,
    in f32 newRowHeight
){
    const f64 clippedTop = cast<f64>(contentClipY) - cast<f64>(viewportY);
    const f64 anchor = max(0.0, scrollOffset + clippedTop) / cast<f64>(oldRowHeight);
    return max(0.0, anchor * cast<f64>(newRowHeight) - clippedTop);
}

Expected<f64> TryComputeListGestureScrollOffset(in PointerGesture gesture){
    const f64 travel = cast<f64>(gesture.referenceRectangle.height) - cast<f64>(gesture.targetRectangle.height);
    if(!isFinite(travel) || travel <= 0.0 || !isFinite(gesture.maximum) || gesture.maximum < 0.0)
        return makeUnexpected(Failure());
    const f64 start = cast<f64>(gesture.targetRectangle.y) - cast<f64>(gesture.referenceRectangle.y);
    const f64 delta = cast<f64>(gesture.position.y) - cast<f64>(gesture.origin.y);
    const f64 fractionValue = (start + delta) / travel;
    f64 fraction = 0.0;
    if(fractionValue > 0.0)
        fraction = min(1.0, fractionValue);
    return fraction * gesture.maximum;
}

Expected<ListMeasureKey> TryBuildListMeasureKey(
    in u64 sourceGeneration,
    in u64 sourceRevision,
    in u64 rowCount,
    in u64 textIdentity,
    in u64 textGeneration,
    in f32 fontSize,
    in DisplayMetrics display,
    in SelectableMetrics metrics,
    in u32 scriptTag,
    in StringView textLanguage
){
    ListMeasureKey key;
    if(textLanguage.size() >= key.language.size())
        return makeUnexpected(Failure());
    key.sourceGeneration = sourceGeneration;
    key.sourceRevision = sourceRevision;
    key.rowCount = rowCount;
    key.textIdentity = textIdentity;
    key.textGeneration = textGeneration;
    key.fontSize = fontSize;
    key.pixelScaleX = display.pixelScaleX;
    key.pixelScaleY = display.pixelScaleY;
    key.rowMetrics[0u] = metrics.padding.left;
    key.rowMetrics[1u] = metrics.padding.top;
    key.rowMetrics[2u] = metrics.padding.right;
    key.rowMetrics[3u] = metrics.padding.bottom;
    key.rowMetrics[4u] = metrics.minimum.x;
    key.rowMetrics[5u] = metrics.minimum.y;
    key.scriptTag = scriptTag;
    for(usize index = 0u; index < textLanguage.size(); ++index)
        key.language[index] = cast<u8>(textLanguage[index]);
    return key;
}

Rect ResolveListProbeRect(in UiSkinRegion background, in Insets padding, in f32 scrollbarWidth, in f32 rowHeight){
    const f32 probeWidth = max(max(s_StyleMinimumFieldWidth, background.minimumWidth), padding.left + padding.right + scrollbarWidth + rowHeight);
    const f32 probeHeight = max(background.minimumHeight, rowHeight + padding.top + padding.bottom);
    return Rect(0.0f, 0.0f, probeWidth, probeHeight);
}

Point ResolveListIntrinsicSize(in UiSkinRegion background, in Insets padding, in f32 rowHeight){
    return Point(
        max(background.minimumWidth, s_StyleMinimumFieldWidth),
        max(background.minimumHeight, rowHeight + padding.top + padding.bottom)
    );
}

f32 ResolveListRowBaseHeight(in SelectableMetrics metrics, in f32 textHeight){
    return max(metrics.minimum.y, textHeight + metrics.padding.top + metrics.padding.bottom);
}


