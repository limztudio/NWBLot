using GpuTelemetryReadViews = ::NWB::Tests::GpuTaskGraphReadViews;
using GpuTelemetryCompiledGraphReadView = Core::GpuCompiledGraph::ReadView;
using GpuTelemetryTimingTestArena = ::NWB::Tests::TestArena<struct TaskGraphTimingTestsTag>;
using GpuTelemetryGraphicsArena = Core::GraphicsArena;
