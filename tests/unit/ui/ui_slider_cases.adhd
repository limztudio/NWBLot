void VerifyUiSliderInputTests_OffCenterThumbPressHasNoJumpAndZeroDeltaDoesNotOverwriteAnEarlierKey(mut UiSliderInputTests self){
    const f64 baseline = 0.1;
    ASSERT_TRUE(self.m_state.setValue(baseline));
    ASSERT_TRUE(self.accept(1u));
    self.press(UiSliderKey::Tab);
    self.press(UiSliderKey::Right);
    const Rect thumbBounds = self.m_state.placement().thumb;
    const Point origin = Point(thumbBounds.x + 3.0f, CenterUiRect(thumbBounds).y);
    const f64 stepped = baseline + 0.125;
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(origin, InputEventType::PrimaryDown)).pointerConsumed);
    ASSERT_TRUE(self.accept(2u));
    EXPECT_DOUBLE_EQ(self.m_state.value(), stepped);
    EXPECT_TRUE(self.m_state.result().dragging);
    EXPECT_EQ(self.m_context.input().capture(), self.thumb());
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(origin, InputEventType::PrimaryUp)).pointerConsumed);
    ASSERT_TRUE(self.accept(3u));
    EXPECT_DOUBLE_EQ(self.m_state.value(), stepped);
    EXPECT_FALSE(self.m_state.result().valueChanged);
}

void VerifyUiSliderInputTests_HeldThumbRepaintPreservesCaptureAndReturningToOriginRestoresExactBaselineBits(mut UiSliderInputTests self){
    const f64 baseline = 0.1;
    ASSERT_TRUE(self.m_state.setValue(baseline));
    ASSERT_TRUE(self.accept(1u));
    const Point origin = self.thumbPoint();
    const Point destination = Point(origin.x + 50.0f, origin.y);
    const f64 travel = cast<f64>(self.m_state.placement().centerTravel.width);
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(origin, InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(destination, InputEventType::PointerMove)).pointerConsumed);
    ASSERT_TRUE(self.accept(2u));
    const f64 displacement = cast<f64>(destination.x) - cast<f64>(origin.x);
    EXPECT_NEAR(self.m_state.value(), baseline + displacement / travel, 0.00000001);
    EXPECT_EQ(self.m_context.input().capture(), self.thumb());
    ControlToken token = ControlToken();
    native(in self, mut token){
        ASSERT_NE(self.target(self.host()), nullptr);
        token = self.target(self.host())->control;
    }
    ASSERT_TRUE(self.accept(3u));
    native(in self, in token){
        ASSERT_NE(self.target(self.host()), nullptr);
        EXPECT_EQ(self.target(self.host())->control, token);
    }
    EXPECT_EQ(self.m_context.input().capture(), self.thumb());
    EXPECT_TRUE(self.m_state.result().dragging);
    EXPECT_FALSE(self.m_state.result().valueChanged);
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(origin, InputEventType::PointerMove)).pointerConsumed);
    ASSERT_TRUE(self.accept(4u));
    EXPECT_EQ(bit_cast<u64>(self.m_state.value()), bit_cast<u64>(baseline));
    EXPECT_TRUE(self.m_state.result().valueChanged);
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(origin, InputEventType::PrimaryUp)).pointerConsumed);
    ASSERT_TRUE(self.accept(5u));
    EXPECT_FALSE(self.m_state.result().dragging);
}

void VerifyUiSliderInputTests_LatestCoalescedMoveAfterAKeyAppliesAfterTheCopiedKeySequence(mut UiSliderInputTests self){
    ASSERT_TRUE(self.accept(1u));
    const Point origin = self.thumbPoint();
    const f64 travel = cast<f64>(self.m_state.placement().centerTravel.width);
