const StringView s_AvboitAccumulationFinalizeLabel = "AVBOIT Accumulation Finalize";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class AvboitPreRecordPolicy{
    public b8 shouldRenderTransparentCsgIntervals(in b8 hasTransparentRenderers, in b8 transparentCsgStreamsUploaded)const{
        return hasTransparentRenderers && transparentCsgStreamsUploaded;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 AreAvboitDepthWarpResourcesValid(in b8 coverageValid, in b8 depthWarpValid, in b8 controlValid, in b8 currentBindlessSlotsValid){
    return coverageValid && depthWarpValid && controlValid && currentBindlessSlotsValid;
}

b8 AreAvboitIntegrationResourcesValid(in b8 extinctionTaskValid, in b8 extinctionValid, in b8 controlValid, in b8 extinctionOverflowValid, in b8 transmittanceValid, in b8 currentBindlessSlotsValid){
    return extinctionTaskValid && extinctionValid && controlValid && extinctionOverflowValid && transmittanceValid && currentBindlessSlotsValid;
}


