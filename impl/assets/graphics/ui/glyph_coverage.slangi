#ifndef NWB_GRAPHICS_UI_GLYPH_COVERAGE_SLANGI
#define NWB_GRAPHICS_UI_GLYPH_COVERAGE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Glyph coverage modulates every premultiplied color component exactly once.
float4 nwbUiGlyphCoverageColor(float4 premultipliedColor, float coverage){
    return premultipliedColor * coverage;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


