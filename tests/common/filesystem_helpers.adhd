////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_DefaultDirectoryPollMilliseconds = 10u;
const u32 s_MinimumDirectoryPollMilliseconds = 1u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 TextFileContains(in Path path, in StringView needle){
    String text = "";
    if(!ReadTextFile(path, text).has_value())
        return false;

    return text.find(needle) < text.size();
}

Expected<b8, ErrorCode> WaitForDirectory(in Path path, in u32 timeoutMilliseconds, in u32 pollMilliseconds){
    u32 stepMilliseconds = pollMilliseconds;
    if(stepMilliseconds == 0u)
        stepMilliseconds = s_MinimumDirectoryPollMilliseconds;
    const Timer deadline = TimerAddMS(TimerNow(), timeoutMilliseconds);
    while(true){
        const auto directory = IsDirectory(path);
        if(!directory.has_value())
            return MakeUnexpected(directory.error());
        if(directory.value())
            return true;
        const Timer now = TimerNow();
        if(now >= deadline)
            return false;
        const i64 remainingMsSigned = Max(DurationInMS<i64>(deadline, now), cast<i64>(s_MinimumDirectoryPollMilliseconds));
        const u32 remainingMilliseconds = cast<u32>(remainingMsSigned);
        SleepMS(Min(stepMilliseconds, remainingMilliseconds));
    }
}

Expected<b8, ErrorCode> WaitForDirectory(in Path path, in u32 timeoutMilliseconds){
    return WaitForDirectory(path, timeoutMilliseconds, s_DefaultDirectoryPollMilliseconds);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

