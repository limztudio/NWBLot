void VerifyUiSeparatorTests_MissingRegionRejectsCandidateWithoutReplacingAcceptedLayout(mut UiSeparatorTests self){
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(0.0f, 0.0f, 160.0f, 100.0f)));
    ASSERT_TRUE(self.m_builder.separator("divider"));
    EXPECT_FALSE(self.m_builder.button("apply", "Apply"));
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    self.configureSkin("separator");
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(100.0f, 100.0f, 160.0f, 100.0f)));
    EXPECT_FALSE(self.m_builder.separator("divider"));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    EXPECT_TRUE(self.hasTarget(self.id("apply", "panel")));
}

void VerifyUiSeparatorTests_InvalidThicknessPoisonsBuildAndPreservesPreviousLayout(mut UiSeparatorTests self){
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(0.0f, 0.0f, 160.0f, 100.0f)));
    ASSERT_TRUE(self.m_builder.separator("divider"));
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    SeparatorOptions options = SeparatorOptions();
    options.thickness = bit_cast<f32>(s_UiSeparatorQuietNaNF32Bits);
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(0.0f, 0.0f, 160.0f, 100.0f)));
    EXPECT_FALSE(self.m_builder.separator("divider", options));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
}

void VerifyUiSeparatorTests_DuplicateKeyAndUnbalancedScopeRejectDeclarations(mut UiSeparatorTests self){
