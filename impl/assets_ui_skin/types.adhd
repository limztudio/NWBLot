const Name s_ButtonNormalRegionName = "button.normal";
const Name s_CheckboxNormalRegionName = "checkbox.normal";
const Name s_CheckboxMarkRegionName = "checkbox.mark";
const Name s_EditNormalRegionName = "edit.normal";
const Name s_ListBackgroundRegionName = "list.background";
const Name s_ListRowNormalRegionName = "list.row.normal";
const Name s_ListRowHoverRegionName = "list.row.hover";
const Name s_ListRowSelectedRegionName = "list.row.selected";
const Name s_ListRowDisabledRegionName = "list.row.disabled";
const Name s_ScrollTrackRegionName = "scroll.track";
const Name s_ScrollThumbRegionName = "scroll.thumb";
const Name s_ScrollbarTrackRegionName = "scrollbar.track";
const Name s_ScrollbarThumbNormalRegionName = "scrollbar.thumb.normal";
