////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_material/asset.adhd>
#include <impl/assets_material/material_binary_reader.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanAssignMaterialStageShader(in b8 isSupportedStage, in b8 isShaderValid){
    return isSupportedStage && isShaderValid;
}

u32 NextMaterialStageShaderCount(in u32 currentCount, in b8 hadExistingStageShader){
    if(hadExistingStageShader)
        return currentCount;
    return currentCount + 1u;
}

b8 Material::loadBinary(in Span<u8> binary){
    if(!this.checkVirtualPath("Material::loadBinary"))
        return false;

    Material candidate(this.virtualPath());
    if(!MaterialBinaryReader().deserialize(
        binary,
        candidate.m_shaderVariant,
        candidate.m_materialInterface,
        candidate.m_typedLayoutHash,
        candidate.m_typedLayoutBlocks,
        candidate.m_typedLayoutFields,
        candidate.m_typedBlockBytes,
        candidate.m_resourceReferences,
        candidate.m_stageShaders,
        candidate.m_stageShaderCount,
        candidate.m_transparent,
        candidate.m_twoSided,
        candidate.m_refractive,
        candidate.m_shadingModelId,
        candidate.m_surfaceDispatchId,
        candidate.m_avboitAccumulatePixelShader,
        candidate.m_avboitOccupancyPixelShader,
        candidate.m_avboitExtinctionPixelShader
    ))
        return false;

    this = candidate;
    return true;
}

b8 Material::validatePayload(in StringView failureContext, in StringView failureContextText)const{
    if(!this.checkVirtualPath(failureContext))
        return false;
    return ValidateMaterialPayloadData(
        this.m_stageShaderCount,
        this.m_materialInterface,
        StringView(this.m_shaderVariant),
        this.m_transparent,
        this.m_avboitAccumulatePixelShader,
        this.m_avboitOccupancyPixelShader,
        this.m_avboitExtinctionPixelShader,
        this.m_typedLayoutHash,
        this.m_typedLayoutBlocks,
        this.m_typedLayoutFields,
        this.m_typedBlockBytes,
        this.m_resourceReferences,
        failureContextText
    );
}

b8 Material::validatePayload(in StringView failureContext)const{
    return this.validatePayload(failureContext, failureContext);
}

b8 Material::validatePayload()const{
    return this.validatePayload(s_MaterialValidatePayloadContextText, s_MaterialValidatePayloadContextText);
}

void Material::setTypedLayout(
    in u64 layoutHash,
    in Span<MaterialTypedLayoutBlock> blocks,
    in Span<MaterialTypedLayoutField> fields,
    in Span<u8> blockBytes
){
    AssignMaterialTypedLayoutPayload(
        layoutHash,
        blocks,
        fields,
        blockBytes,
        this.m_typedLayoutHash,
        this.m_typedLayoutBlocks,
        this.m_typedLayoutFields,
        this.m_typedBlockBytes
    );
}

void Material::setResourceReferences(in Span<MaterialResourceReference> resourceReferences){
    AssignMaterialResourceReferencesPayload(resourceReferences, this.m_resourceReferences);
}

b8 Material::setShaderForStage(in ShaderType shaderType, in AssetRef<IShader> shaderAsset){
    if(!CanAssignMaterialStageShader(IsSupportedMaterialShaderStage(shaderType), shaderAsset.valid()))
        return false;

    const usize stageIndex = cast<usize>(shaderType);
    this.m_stageShaderCount = NextMaterialStageShaderCount(this.m_stageShaderCount, this.m_stageShaders[stageIndex].valid());
    this.m_stageShaders[stageIndex] = shaderAsset;
    return true;
}


