[[nodiscard]] FOUNDATION_INLINE Sha256Digest ComputeUiBuilderFirstGlyphPageHash(const DrawSnapshot& snapshot)noexcept{
    const auto& page = snapshot.glyphPages().front();
    return ::ComputeSha256({ page->pixels().data(), page->pixels().size() });
}
[[nodiscard]] FOUNDATION_INLINE u64 ReadUiBuilderFirstGlyphPageFontGeneration(const DrawSnapshot& snapshot)noexcept{
    return snapshot.glyphPages().front()->binding().fontGeneration;
}
[[nodiscard]] FOUNDATION_INLINE b8 EqualUiBuilderVertexBytes(const Span<const Vertex> lhs, const Span<const Vertex> rhs)noexcept{
    return lhs.size() == rhs.size() && FOUNDATION_MEMCMP(lhs.data(), rhs.data(), lhs.size() * sizeof(Vertex)) == 0;
}
