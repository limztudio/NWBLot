void VerifyEcsGraphics_RuntimeMeshBufferByteCountRejectsOverflow(){
    const usize maxValue = usize.max;
    const Expected<usize> largest = TryComputeRuntimeMeshBufferByteCount(maxValue / 16u, 16u);
    ASSERT_TRUE(largest.has_value());
    EXPECT_EQ(largest.value(), (maxValue / 16u) * 16u);
    EXPECT_FALSE(TryComputeRuntimeMeshBufferByteCount(maxValue / 16u + 1u, 16u).has_value());
    const Expected<usize> zero = TryComputeRuntimeMeshBufferByteCount(maxValue, 0u);
    ASSERT_TRUE(zero.has_value());
    EXPECT_EQ(zero.value(), 0u);
}

void VerifyEcsGraphics_AvboitUploadCountsRejectEachOverflowBoundary(){
    const usize maxValue = usize.max;
    const usize instanceLimit = maxValue / s_InstanceGpuBytes;
    const usize receiverLimit = maxValue / s_ReceiverGpuBytes;
    const usize cutterLimit = maxValue / s_CutterGpuBytes;
    EXPECT_TRUE(AvboitUploadCountsFit(instanceLimit, receiverLimit, cutterLimit, instanceLimit, receiverLimit, cutterLimit));
    EXPECT_FALSE(AvboitUploadCountsFit(instanceLimit + 1u, 0u, 0u, instanceLimit, receiverLimit, cutterLimit));
    EXPECT_FALSE(AvboitUploadCountsFit(0u, receiverLimit + 1u, 0u, instanceLimit, receiverLimit, cutterLimit));
    EXPECT_FALSE(AvboitUploadCountsFit(0u, 0u, cutterLimit + 1u, instanceLimit, receiverLimit, cutterLimit));
}

void VerifyEcsGraphics_MissingOpticalAttachmentsDisableAuxiliarySamplingInBothPresentationModes(){
    AvboitFrameTargets targets = AvboitFrameTargets();
    targets.fullWidth = 1920u;
    targets.fullHeight = 1080u;
    targets.lowWidth = 480u;
    targets.lowHeight = 270u;
    targets.virtualSliceCount = 128u;
    targets.physicalSliceCount = 64u;
    targets.deferredSlotsBufferDescriptor = GpuDescriptorHandle::Make(GpuDescriptorClass::UniformBuffer, 23u);

    const b8 hasRefractionFramebuffer = HasRefractionFramebuffer(targets);

    const RendererAvboitPushConstants sdr = ResolveRendererAvboitPushConstants(
        targets.fullWidth,
        targets.fullHeight,
        targets.lowWidth,
        targets.lowHeight,
        targets.virtualSliceCount,
        targets.physicalSliceCount,
        false,
        hasRefractionFramebuffer,
        targets.deferredSlotsBufferDescriptor.slot()
    );
    const RendererAvboitPushConstants hdr10 = ResolveRendererAvboitPushConstants(
        targets.fullWidth,
        targets.fullHeight,
        targets.lowWidth,
        targets.lowHeight,
        targets.virtualSliceCount,
        targets.physicalSliceCount,
        true,
        hasRefractionFramebuffer,
        targets.deferredSlotsBufferDescriptor.slot()
    );
    EXPECT_FLOAT_EQ(sdr.params.raw[s_AvboitPushParamsRefractionCapture], s_AvboitRefractionDisabled);
    EXPECT_FLOAT_EQ(hdr10.params.raw[s_AvboitPushParamsRefractionCapture], s_AvboitRefractionDisabled);
}

void VerifyEcsGraphics_MeshSkinningSubmissionCommitRejectKeepsPoseAndSelectorPending(){
    RuntimeMeshDirtyFlagMask dirtyFlags = RuntimeMeshDirtyFlag::GpuUploadDirty | RuntimeMeshDirtyFlag::SkinningInputDirty | RuntimeMeshDirtyFlag::MeshletBoundsDirty;
    b8 bindlessResourceSlotsUploaded = false;
    MeshSkinningSubmissionCommit commit = MeshSkinningSubmissionCommit();
    commit.editRevision = 17u;
    commit.handledDirtyFlags = RuntimeMeshDirtyFlag::SkinningInputDirty | RuntimeMeshDirtyFlag::MeshletBoundsDirty;
    commit.bindlessResourceSlotsUploadRecorded = true;

    ApplyMeshSkinningSubmissionCommit(false, 17u, commit, dirtyFlags, bindlessResourceSlotsUploaded);

    EXPECT_EQ(dirtyFlags, RuntimeMeshDirtyFlag::GpuUploadDirty | RuntimeMeshDirtyFlag::SkinningInputDirty | RuntimeMeshDirtyFlag::MeshletBoundsDirty);
    EXPECT_FALSE(bindlessResourceSlotsUploaded);

    ApplyMeshSkinningSubmissionCommit(true, 17u, commit, dirtyFlags, bindlessResourceSlotsUploaded);

    EXPECT_EQ(dirtyFlags, RuntimeMeshDirtyFlag::GpuUploadDirty);
    EXPECT_TRUE(bindlessResourceSlotsUploaded);
}

void VerifyEcsGraphics_MeshSkinningSubmissionCommitPreservesNewerEditRevision(){
    RuntimeMeshDirtyFlagMask dirtyFlags = RuntimeMeshDirtyFlag::SkinningInputDirty | RuntimeMeshDirtyFlag::MeshletBoundsDirty;
    b8 bindlessResourceSlotsUploaded = false;
    MeshSkinningSubmissionCommit commit = MeshSkinningSubmissionCommit();
    commit.editRevision = 17u;
    commit.handledDirtyFlags = dirtyFlags;
    commit.bindlessResourceSlotsUploadRecorded = true;

    ApplyMeshSkinningSubmissionCommit(true, 18u, commit, dirtyFlags, bindlessResourceSlotsUploaded);

    EXPECT_EQ(dirtyFlags, RuntimeMeshDirtyFlag::SkinningInputDirty | RuntimeMeshDirtyFlag::MeshletBoundsDirty);
    EXPECT_FALSE(bindlessResourceSlotsUploaded);
}

void VerifyEcsGraphics_MissingMeshDoesNotReplacePreviousResolution(){
    MeshResolutionContext context = MeshResolutionContext();
    const EntityID entity = context.addMeshEntity(Name(s_EcsCaseProjectMeshesStaticMesh));
    const ResolvedMeshRef resolvedMesh = context.resolveMesh(entity);
    ASSERT_TRUE(resolvedMesh.present());

    const EntityID missingMeshEntity = context.addEmptyEntity();
    EXPECT_FALSE(context.resolveMesh(missingMeshEntity).present());
    EXPECT_TRUE(resolvedMesh.valid());
}

void VerifyEcsGraphics_MaterialDrawCountRejectsAnOverflowingAddition(){
    const usize maxValue = usize.max / 11u;
    const Expected<usize> exact = TryAccumulateMaterialDrawCount(maxValue - 1u, 1u, maxValue);
    ASSERT_TRUE(exact.has_value());
    EXPECT_EQ(exact.value(), maxValue);
    EXPECT_FALSE(TryAccumulateMaterialDrawCount(maxValue - 1u, 2u, maxValue).has_value());
    const Expected<usize> empty = TryAccumulateMaterialDrawCount(maxValue, 0u, maxValue);
    ASSERT_TRUE(empty.has_value());
    EXPECT_EQ(empty.value(), maxValue);
}

void VerifyEcsGraphics_MaterialTypedReserveFallsBackWhenMultiplicationWouldOverflow(){
    const usize maxValue = usize.max;
    EXPECT_EQ(ResolveMaterialTypedReserve(maxValue / 4u), (maxValue / 4u) * 4u);
    EXPECT_EQ(ResolveMaterialTypedReserve(maxValue / 4u + 1u), maxValue / 4u + 1u);
    EXPECT_EQ(ResolveMaterialTypedReserve(maxValue), maxValue);
}

void VerifyEcsGraphics_SharedMaterialMeshShaderDistinguishesMissingAndEmptyNames(){
    const Name shader = s_EcsGraphicsNameTestsSharedMeshShader;
    const Name emptyText = s_EcsGraphicsNameEmpty;
    const MeshShaderAssetRef matching = MeshShaderAssetRef(shader);
    const MeshShaderAssetRef emptyName = MeshShaderAssetRef(emptyText);
    EXPECT_FALSE(UsesSharedMaterialMeshShader(s_NameNone, matching, "default", "default"));
    EXPECT_TRUE(UsesSharedMaterialMeshShader(shader, matching, "default", "default"));
    EXPECT_FALSE(UsesSharedMaterialMeshShader(shader, matching, "variant", "default"));
    EXPECT_TRUE(UsesSharedMaterialMeshShader(emptyText, emptyName, "default", "default"));
}

void VerifyEcsGraphics_MaterialPipelineReadinessRejectsUnknownPathsAndMissingHandles(){
    MaterialPipelineResources resources = MaterialPipelineResources();
    Array<RenderPathEnum, 4> paths = Array<RenderPathEnum, 4>();
    paths[0u] = RenderPath::MeshShader;
    paths[1u] = RenderPath::VertexIndexed;
    paths[2u] = RenderPath::ComputeEmulation;
    paths[3u] = cast<RenderPathEnum>(255u);
    for(in RenderPathEnum path : paths){
        resources.renderPath = path;
        EXPECT_FALSE(resources.ready());
    }
}

void VerifyEcsGraphics_MaterialPipelineKeyDistinguishesFramebufferFormatsAndSamples(){
    MaterialPipelineKey first = MaterialPipelineKey();
    MaterialPipelineKey second = MaterialPipelineKey();
    const MaterialPipelineKeyEqualTo equal = MaterialPipelineKeyEqualTo();
    const MaterialPipelineKeyHasher hash = MaterialPipelineKeyHasher();
    ASSERT_TRUE(equal(first, second));
    EXPECT_EQ(hash(first), hash(second));
    second.framebufferInfo.sampleCount = 4u;
    EXPECT_FALSE(equal(first, second));
    second = first;
    second.framebufferInfo.addColorFormat(Format::RGBA8_UNORM);
    EXPECT_FALSE(equal(first, second));
}

void VerifyEcsGraphics_MaterialPipelineCacheRejectsReplacedCsgEvaluatorInclude(){
    MaterialPipelineCacheContext context = MaterialPipelineCacheContext();
    ASSERT_TRUE(RegisterBuiltInCsgShapeTypes(context.registry));

    Expected<CsgShapeTypeInfo> foundShape = context.registry.findShapeType(s_CsgBoxShapeName);
    ASSERT_TRUE(foundShape.has_value());
    CsgShapeTypeDesc desc = foundShape.value().desc;
    desc.shaderModule = Name(s_EcsCaseTestsCsgPipelineEvaluator);
    desc.shaderModuleInclude = "tests/csg/pipeline_evaluator_a.slangi";
    const Expected<u32> registered = context.registry.registerShapeType(desc, true);
    ASSERT_TRUE(registered.has_value());

    MaterialPipelineKey original = MaterialPipelineKey();
    original.material = Name(s_EcsCaseTestsCsgPipelineMaterial);
    original.csgMode = MaterialPipelineCsgMode::ClipOnly;
    original.csgEvaluatorVariant = desc.shaderModule;
    original.csgShapeRegistryRevision = context.registry.revision();
    ASSERT_TRUE(context.insert(original, 17u));

    desc.shaderModuleInclude = "tests/csg/pipeline_evaluator_b.slangi";
    const Expected<u32> replaced = context.registry.registerShapeType(desc, true);
    ASSERT_TRUE(replaced.has_value());
    EXPECT_EQ(registered.value(), replaced.value());
    const Optional<StringView> include = context.findShaderModuleIncludeView(original.csgEvaluatorVariant);
    ASSERT_TRUE(include.has_value());
    EXPECT_EQ(include.value(), "tests/csg/pipeline_evaluator_b.slangi");

    MaterialPipelineKey updated = original;
    updated.csgShapeRegistryRevision = context.registry.revision();
    EXPECT_NE(original.csgShapeRegistryRevision, updated.csgShapeRegistryRevision);
    EXPECT_EQ(original.material, updated.material);
    EXPECT_EQ(original.csgEvaluatorVariant, updated.csgEvaluatorVariant);
    const MaterialPipelineKeyEqualTo keyEqual = MaterialPipelineKeyEqualTo();
    EXPECT_FALSE(keyEqual(original, updated));
    EXPECT_FALSE(context.find(updated).has_value());
    const Optional<u32> retained = context.find(original);
    ASSERT_TRUE(retained.has_value());
    EXPECT_EQ(retained.value(), 17u);
}

void VerifyEcsGraphics_NonUniformScaleCannotBecomeRigidJointRotation(){
    EXPECT_FALSE(MatrixTryBuildRigidRotationQuaternion(LoadFloat(MakeNonUniformScaleJointMatrix()), s_SkeletonAffineEpsilon, s_SkeletonRigidJointEpsilon).has_value());
}

void VerifyEcsGraphics_InvalidSkeletonParentsAndJointCountsAreRejected(){
    SkeletonPoseComponent pose = MakeTwoJointSkeletonPose(MakeTranslationJointMatrix(1.0f, 0.0f, 0.0f), MakeTranslationJointMatrix(0.0f, 2.0f, 0.0f));
    SkeletonPoseScratch scratch = SkeletonPoseScratch();
    scratch.resolvedJoints.reserve(pose.localJoints.size());
    ASSERT_TRUE(BuildStoredJointPaletteFromSkeletonPose(pose, scratch));
    pose.parentJoints[1u] = 1u;
    EXPECT_FALSE(BuildStoredJointPaletteFromSkeletonPose(pose, scratch));
    pose.parentJoints[1u] = 0u;
    pose.parentJoints.pop_back();
    EXPECT_FALSE(BuildStoredJointPaletteFromSkeletonPose(pose, scratch));
}

void VerifyEcsGraphics_MeshSkinningPayloadValidatesSkeletonAndPalette(){
    CapturingLogger runtimeValidationLogger = CapturingLogger();
    {
        SkinningValidationContext context = SkinningValidationContext();
        const LoggerRegistrationGuard runtimeValidationLoggerRegistrationGuard = LoggerRegistrationGuard(runtimeValidationLogger);
        EXPECT_FALSE(context.buildOutsidePalette());
        EXPECT_FALSE(context.buildNonAffineJoint());
        EXPECT_FALSE(context.buildScaledDualQuaternionJoint());
    }

    EXPECT_EQ(runtimeValidationLogger.errorCount(), 3u);
    EXPECT_TRUE(runtimeValidationLogger.sawErrorContaining("joint palette count"));
    EXPECT_TRUE(runtimeValidationLogger.sawErrorContaining("joint palette entry 0 is not a finite invertible affine matrix"));
    EXPECT_TRUE(runtimeValidationLogger.sawErrorContaining("failed dual-quaternion payload build"));
}

void VerifyEcsGraphics_FrameGraphPhysicalQueueRuntimeStatisticsRejectsMixedSnapshots(){
    PhysicalQueueRuntimeSnapshots snapshots = MakeValidPhysicalQueueRuntimeSnapshots();
    ++snapshots.submission.recordingAttemptGeneration;
    EXPECT_FALSE(IsValidFrameGraphPhysicalQueueRuntimeStatistics(BuildFrameGraphPhysicalQueueRuntimeStatistics(snapshots.compile, snapshots.recording, snapshots.submission)));

    snapshots = MakeValidPhysicalQueueRuntimeSnapshots();
    ++snapshots.recording.queue.index;
    EXPECT_FALSE(IsValidFrameGraphPhysicalQueueRuntimeStatistics(BuildFrameGraphPhysicalQueueRuntimeStatistics(snapshots.compile, snapshots.recording, snapshots.submission)));

    snapshots = MakeValidPhysicalQueueRuntimeSnapshots();
    snapshots.submission.queueClass = CommandQueue::Graphics;
    EXPECT_FALSE(IsValidFrameGraphPhysicalQueueRuntimeStatistics(BuildFrameGraphPhysicalQueueRuntimeStatistics(snapshots.compile, snapshots.recording, snapshots.submission)));

    snapshots = MakeValidPhysicalQueueRuntimeSnapshots();
    snapshots.submission.recoverySubmissionCount = 2u;
    EXPECT_FALSE(IsValidFrameGraphPhysicalQueueRuntimeStatistics(BuildFrameGraphPhysicalQueueRuntimeStatistics(snapshots.compile, snapshots.recording, snapshots.submission)));
}

void VerifyEcsGraphics_FrameGraphPacketSubmissionStatisticsRejectsInvalidQueueOrOwner(){
    const GpuTaskGraphPacketSubmissionStatistics statistics = MakeValidPacketSubmissionStatistics();
    GpuTaskGraphPacketSubmissionStatistics invalid = statistics;
    invalid.queueClass = CommandQueue::kCount;
    EXPECT_FALSE(IsValidFrameGraphPacketSubmissionStatistics(BuildFrameGraphPacketSubmissionStatistics(invalid, 4u)));
    EXPECT_FALSE(IsValidFrameGraphPacketSubmissionStatistics(BuildFrameGraphPacketSubmissionStatistics(statistics, u32.max)));
}

void VerifyEcsGraphics_FrameGraphBuilderCopiesOwnerBoundPacketSubmissionStatistics(){
    FrameGraphPacketStatsTestContext context = FrameGraphPacketStatsTestContext();
    const FrameGraphNodeHandle owner = context.addOwnerPass(
        Name(s_EcsCasePacketOwner),
        "Packet owner",
        BuildFrameGraphRuntimeStatistics(MakeValidRuntimeStatistics(), 41u, 41u)
    );
    ASSERT_TRUE(owner.valid());
    FrameGraphPacketSubmissionStatisticsRecord statistics = BuildFrameGraphPacketSubmissionStatistics(MakeValidPacketSubmissionStatistics(), owner.index);
    FrameGraphPacketSubmissionStatisticsRecord excessiveDuration = statistics;
    excessiveDuration.submissionSeconds = 0.003;
    EXPECT_FALSE(context.builder.addPacketSubmissionStatistics(owner, excessiveDuration));
    ASSERT_TRUE(context.builder.addPacketSubmissionStatistics(owner, statistics));
    statistics.commandListCount = 3u;

    ASSERT_EQ(context.packetStatistics.size(), 1u);
    EXPECT_EQ(context.packetStatistics[0u].commandListCount, 1u);
    EXPECT_FALSE(context.builder.addPacketSubmissionStatistics(owner, context.packetStatistics[0u]));

    const FrameGraphNodeHandle resource = context.builder.addResource(Name(s_EcsCasePacketResource), "Packet resource");
    ASSERT_TRUE(resource.valid());
    statistics = context.packetStatistics[0u];
    statistics.ownerNodeIndex = resource.index;
    EXPECT_FALSE(context.builder.addPacketSubmissionStatistics(resource, statistics));

    statistics = context.packetStatistics[0u];
    ++statistics.packetGeneration;
    EXPECT_FALSE(context.builder.addPacketSubmissionStatistics(owner, statistics));
}

void VerifyEcsGraphics_FrameGraphRuntimeStatisticsSelectsOnlyMatchingCoherentSnapshot(){
    const GpuTaskGraphRuntimeStatistics statistics = MakeValidRuntimeStatistics();
    ASSERT_TRUE(statistics.valid());

    const FrameGraphRuntimeStatistics matching = BuildFrameGraphRuntimeStatistics(statistics, 41u, 41u);
    EXPECT_TRUE(matching.present);
    EXPECT_TRUE(IsValidFrameGraphRuntimeStatistics(matching));
    const FrameGraphRuntimeStatistics stale = BuildFrameGraphRuntimeStatistics(statistics, 42u, 41u);
    EXPECT_FALSE(stale.present);

    GpuTaskGraphRuntimeStatistics invalidGenerations = statistics;
    ++invalidGenerations.submission.planGeneration;
    ASSERT_FALSE(invalidGenerations.valid());
    const FrameGraphRuntimeStatistics invalid = BuildFrameGraphRuntimeStatistics(invalidGenerations, 41u, 41u);
    EXPECT_FALSE(invalid.present);
}

void VerifyEcsGraphics_FrameGraphRuntimeStatisticsRejectsInconsistentInheritedWaitElisions(){
    GpuTaskGraphRuntimeStatistics runtimeStatistics = MakeValidRuntimeStatistics();
    runtimeStatistics.submission.timelineWaitCount = 0u;
    runtimeStatistics.submission.inheritedTimelineWaitElisionCount = 1u;
    ASSERT_TRUE(IsValidFrameGraphRuntimeStatistics(BuildFrameGraphRuntimeStatistics(runtimeStatistics, 41u, 41u)));
    ++runtimeStatistics.submission.inheritedTimelineWaitElisionCount;
    EXPECT_FALSE(BuildFrameGraphRuntimeStatistics(runtimeStatistics, 41u, 41u).present);

    PhysicalQueueRuntimeSnapshots snapshots = MakeValidPhysicalQueueRuntimeSnapshots();
    snapshots.submission.timelineWaitCount = 1u;
    snapshots.submission.inheritedTimelineWaitElisionCount = 1u;
    ASSERT_TRUE(IsValidFrameGraphPhysicalQueueRuntimeStatistics(BuildFrameGraphPhysicalQueueRuntimeStatistics(snapshots.compile, snapshots.recording, snapshots.submission)));
    ++snapshots.submission.inheritedTimelineWaitElisionCount;
    EXPECT_FALSE(IsValidFrameGraphPhysicalQueueRuntimeStatistics(BuildFrameGraphPhysicalQueueRuntimeStatistics(snapshots.compile, snapshots.recording, snapshots.submission)));

    GpuTaskGraphPacketSubmissionStatistics packetStatistics = MakeValidPacketSubmissionStatistics();
    packetStatistics.timelineWaitCount = 0u;
    packetStatistics.inheritedTimelineWaitElisionCount = 1u;
    ASSERT_TRUE(IsValidFrameGraphPacketSubmissionStatistics(BuildFrameGraphPacketSubmissionStatistics(packetStatistics, 4u)));
    ++packetStatistics.inheritedTimelineWaitElisionCount;
    EXPECT_FALSE(IsValidFrameGraphPacketSubmissionStatistics(BuildFrameGraphPacketSubmissionStatistics(packetStatistics, 4u)));
}

void VerifyEcsGraphics_FrameGraphRuntimeStatisticsOmitsResetArtifactsForMatchingFrame(){
    ResetRuntimeStatisticsContext context = ResetRuntimeStatisticsContext();
    const GpuTaskGraphDeclarationReadView declarationAccess = GpuTaskGraphDeclarationReadView(context.graph);
    ASSERT_TRUE(declarationAccess.valid());
    ASSERT_TRUE(context.compileSingleGraphicsQueue(declarationAccess));

    const GpuCompiledGraphReadView planAccess = GpuCompiledGraphReadView(context.compiledGraph);
    ASSERT_TRUE(planAccess.validFor(declarationAccess));
    const GpuTaskGraphRuntimeStatistics resetStatistics = context.collect(planAccess);
    ASSERT_FALSE(resetStatistics.valid());
    const FrameGraphRuntimeStatistics telemetry = BuildFrameGraphRuntimeStatistics(resetStatistics, 41u, 41u);
    EXPECT_FALSE(telemetry.present);
}

void VerifyLightSpaceCaptureHistory_RequiresRecordedAcceptedCaptureAndAlternatesOneReuse(){
    LightSpaceCaptureHistory history = LightSpaceCaptureHistory();
    const LightSpaceCaptureIdentity identity = MakeCaptureIdentity(7u, 11u, 13u, true);
    history.beginFrame();
    const LightSpaceCaptureTicket first = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseOneFrame);
    ASSERT_FALSE(first.reuse);
    EXPECT_FALSE(history.accept(first));
    history.recordCapture(first);
    ASSERT_TRUE(history.accept(first));
    EXPECT_FALSE(history.accept(first));
    history.beginFrame();
    const LightSpaceCaptureTicket reused = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseOneFrame);
    ASSERT_TRUE(reused.reuse);
    ASSERT_TRUE(history.accept(reused));
    history.beginFrame();
    const LightSpaceCaptureTicket refreshed = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseOneFrame);
    EXPECT_FALSE(refreshed.reuse);
    history.recordCapture(refreshed);
    ASSERT_TRUE(history.accept(refreshed));
    EXPECT_EQ(history.acceptedCaptures(), 2u);
    EXPECT_EQ(history.acceptedReuses(), 1u);
}

void VerifyLightSpaceCaptureHistory_UntrustedSceneNeverReusesAcceptedCaptures(){
    LightSpaceCaptureHistory history = LightSpaceCaptureHistory();
    const LightSpaceCaptureIdentity identity = MakeCaptureIdentity(7u, 11u, 13u, false);
    for(u32 frame = 0u; frame < 4u; ++frame){
        history.beginFrame();
        const LightSpaceCaptureTicket ticket = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseOneFrame);
        EXPECT_FALSE(ticket.reuse);
        history.recordCapture(ticket);
        ASSERT_TRUE(history.accept(ticket));
    }
    EXPECT_EQ(history.acceptedCaptures(), 4u);
    EXPECT_EQ(history.acceptedReuses(), 0u);
}

void VerifyLightSpaceCaptureHistory_EachIdentityDomainAndTrustChangeForcesRefresh(){
    const LightSpaceCaptureIdentity original = MakeCaptureIdentity(7u, 11u, 13u, true);
    Array<LightSpaceCaptureIdentity, 4> changes = Array<LightSpaceCaptureIdentity, 4>();
    changes[0u] = MakeCaptureIdentity(8u, 11u, 13u, true);
    changes[1u] = MakeCaptureIdentity(7u, 12u, 13u, true);
    changes[2u] = MakeCaptureIdentity(7u, 11u, 14u, true);
    changes[3u] = MakeCaptureIdentity(7u, 11u, 13u, false);
    for(in LightSpaceCaptureIdentity changed : changes){
        LightSpaceCaptureHistory history = LightSpaceCaptureHistory();
        history.beginFrame();
        const LightSpaceCaptureTicket captured = history.prepare(original, SoftwareShadowCaptureCadence::ReuseOneFrame);
        history.recordCapture(captured);
        ASSERT_TRUE(history.accept(captured));
        history.beginFrame();
        EXPECT_FALSE(history.prepare(changed, SoftwareShadowCaptureCadence::ReuseOneFrame).reuse);
    }
}

void VerifyLightSpaceCaptureHistory_RejectedRefreshCannotResurrectPreviousInPlaceContents(){
    LightSpaceCaptureHistory history = LightSpaceCaptureHistory();
    const LightSpaceCaptureIdentity identity = MakeCaptureIdentity(7u, 11u, 13u, true);
    history.beginFrame();
    const LightSpaceCaptureTicket captured = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseOneFrame);
    history.recordCapture(captured);
    ASSERT_TRUE(history.accept(captured));
    history.beginFrame();
    LightSpaceCaptureIdentity changed = identity;
    ++changed.scene;
    const LightSpaceCaptureTicket rejected = history.prepare(changed, SoftwareShadowCaptureCadence::ReuseOneFrame);
    EXPECT_FALSE(rejected.reuse);
    history.recordCapture(rejected);
    history.beginFrame();
    const LightSpaceCaptureTicket next = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseOneFrame);
    EXPECT_FALSE(next.reuse);
    EXPECT_FALSE(history.accept(rejected));
    history.recordCapture(rejected);
    EXPECT_FALSE(history.accept(next));
}

void VerifyLightSpaceCaptureHistory_RejectedReuseAndSkippedFramesCannotExtendCaptureAge(){
    Array<b8, 2> flags = Array<b8, 2>();
    flags[0u] = false;
    flags[1u] = true;
    for(in b8 prepareReuse : flags){
        LightSpaceCaptureHistory history = LightSpaceCaptureHistory();
        const LightSpaceCaptureIdentity identity = MakeCaptureIdentity(7u, 11u, 13u, true);
        history.beginFrame();
        const LightSpaceCaptureTicket captured = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseOneFrame);
        history.recordCapture(captured);
        ASSERT_TRUE(history.accept(captured));
        history.beginFrame();
        if(prepareReuse)
            EXPECT_TRUE(history.prepare(identity, SoftwareShadowCaptureCadence::ReuseOneFrame).reuse);
        history.beginFrame();
        EXPECT_FALSE(history.prepare(identity, SoftwareShadowCaptureCadence::ReuseOneFrame).reuse);
    }
}

void VerifyLightSpaceCaptureHistory_InvalidatedResourcesRejectPendingTicketsAndRequireRefresh(){
    LightSpaceCaptureHistory history = LightSpaceCaptureHistory();
    const LightSpaceCaptureIdentity identity = MakeCaptureIdentity(7u, 11u, 13u, true);
    history.beginFrame();
    const LightSpaceCaptureTicket captured = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseOneFrame);
    history.recordCapture(captured);
    history.invalidate();
    EXPECT_FALSE(history.accept(captured));
    history.beginFrame();
    const LightSpaceCaptureTicket current = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseOneFrame);
    EXPECT_FALSE(current.reuse);
    EXPECT_NE(current.sequence, captured.sequence);
    history.recordCapture(captured);
    EXPECT_FALSE(history.accept(current));
}

void VerifyLightSpaceCaptureHistory_TwoAcceptedReusesRequireARefreshBeforeTheThird(){
    LightSpaceCaptureHistory history = LightSpaceCaptureHistory();
    const LightSpaceCaptureIdentity identity = MakeCaptureIdentity(7u, 11u, 13u, true);
    for(u32 frame = 0u; frame < 9u; ++frame){
        history.beginFrame();
        const LightSpaceCaptureTicket ticket = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseTwoFrames);
        EXPECT_EQ(ticket.reuse, frame % 3u != 0u);
        if(!ticket.reuse){
            EXPECT_FALSE(history.accept(ticket));
            history.recordCapture(ticket);
        }
        ASSERT_TRUE(history.accept(ticket));
        EXPECT_FALSE(history.accept(ticket));
    }
    EXPECT_EQ(history.acceptedCaptures(), 3u);
    EXPECT_EQ(history.acceptedReuses(), 6u);
}

void VerifyLightSpaceCaptureHistory_TwoFrameReuseRetainsIdentityInvalidationAndRejectsUnsubmittedEdits(){
    const LightSpaceCaptureIdentity original = MakeCaptureIdentity(7u, 11u, 13u, true);
    Array<LightSpaceCaptureIdentity, 4> changes = Array<LightSpaceCaptureIdentity, 4>();
    changes[0u] = MakeCaptureIdentity(8u, 11u, 13u, true);
    changes[1u] = MakeCaptureIdentity(7u, 12u, 13u, true);
    changes[2u] = MakeCaptureIdentity(7u, 11u, 14u, true);
    changes[3u] = MakeCaptureIdentity(7u, 11u, 13u, false);
    Array<b8, 2> flags = Array<b8, 2>();
    flags[0u] = false;
    flags[1u] = true;
    for(in LightSpaceCaptureIdentity changed : changes){
        for(in b8 submitEdit : flags){
            LightSpaceCaptureHistory history = LightSpaceCaptureHistory();
            history.beginFrame();
            const LightSpaceCaptureTicket captured = history.prepare(original, SoftwareShadowCaptureCadence::ReuseTwoFrames);
            history.recordCapture(captured);
            ASSERT_TRUE(history.accept(captured));
            history.beginFrame();
            const LightSpaceCaptureTicket reused = history.prepare(original, SoftwareShadowCaptureCadence::ReuseTwoFrames);
            ASSERT_TRUE(reused.reuse);
            ASSERT_TRUE(history.accept(reused));
            history.beginFrame();
            const LightSpaceCaptureTicket edited = history.prepare(changed, SoftwareShadowCaptureCadence::ReuseTwoFrames);
            EXPECT_FALSE(edited.reuse);
            history.recordCapture(edited);
            if(submitEdit)
                ASSERT_TRUE(history.accept(edited));
            history.beginFrame();
            const LightSpaceCaptureTicket next = history.prepare(original, SoftwareShadowCaptureCadence::ReuseTwoFrames);
            EXPECT_FALSE(next.reuse);
            EXPECT_FALSE(history.accept(edited));
            history.recordCapture(edited);
            EXPECT_FALSE(history.accept(next));
        }
    }
}

void VerifyLightSpaceCaptureHistory_TwoFrameReuseCannotExtendAgeThroughRejectedSkippedOrInvalidatedFrames(){
    for(u32 interruption = 0u; interruption < 3u; ++interruption){
        LightSpaceCaptureHistory history = LightSpaceCaptureHistory();
        const LightSpaceCaptureIdentity identity = MakeCaptureIdentity(7u, 11u, 13u, true);
        history.beginFrame();
        const LightSpaceCaptureTicket captured = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseTwoFrames);
        history.recordCapture(captured);
        ASSERT_TRUE(history.accept(captured));
        history.beginFrame();
        const LightSpaceCaptureTicket firstReuse = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseTwoFrames);
        ASSERT_TRUE(firstReuse.reuse);
        ASSERT_TRUE(history.accept(firstReuse));
        history.beginFrame();
        if(interruption != 0u){
            const LightSpaceCaptureTicket rejected = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseTwoFrames);
            ASSERT_TRUE(rejected.reuse);
            if(interruption == 2u){
                history.invalidate();
                EXPECT_FALSE(history.accept(rejected));
            }
        }
        history.beginFrame();
        EXPECT_FALSE(history.prepare(identity, SoftwareShadowCaptureCadence::ReuseTwoFrames).reuse);
    }
}

void VerifyLightSpaceCaptureHistory_RetryingATwoFrameReuseDoesNotConsumeAnAdditionalAcceptedFrame(){
    LightSpaceCaptureHistory history = LightSpaceCaptureHistory();
    const LightSpaceCaptureIdentity identity = MakeCaptureIdentity(7u, 11u, 13u, true);
    history.beginFrame();
    const LightSpaceCaptureTicket captured = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseTwoFrames);
    history.recordCapture(captured);
    ASSERT_TRUE(history.accept(captured));
    for(u32 frame = 0u; frame < 2u; ++frame){
        history.beginFrame();
        const LightSpaceCaptureTicket original = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseTwoFrames);
        const LightSpaceCaptureTicket retried = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseTwoFrames);
        ASSERT_TRUE(original.reuse);
        ASSERT_TRUE(retried.reuse);
        EXPECT_FALSE(history.accept(original));
        ASSERT_TRUE(history.accept(retried));
    }
    history.beginFrame();
    EXPECT_FALSE(history.prepare(identity, SoftwareShadowCaptureCadence::ReuseTwoFrames).reuse);
    EXPECT_EQ(history.acceptedCaptures(), 1u);
    EXPECT_EQ(history.acceptedReuses(), 2u);
}

void VerifyLightSpaceCaptureHistory_RejectsUnknownCaptureCadence(){
    SoftwareShadowSettings settings = SoftwareShadowSettings();
    settings.captureCadence = cast<SoftwareShadowCaptureCadenceEnum>(3u);
    EXPECT_FALSE(ValidateSoftwareShadowSettings(settings));
}

void VerifyLightSpaceCaptureHistory_SameFrameGraphRetryAcceptsOnlyItsLatestRecordedCandidate(){
    LightSpaceCaptureHistory history = LightSpaceCaptureHistory();
    const LightSpaceCaptureIdentity identity = MakeCaptureIdentity(7u, 11u, 13u, true);
    history.beginFrame();
    const LightSpaceCaptureTicket firstDeclaration = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseOneFrame);
    const LightSpaceCaptureTicket retryDeclaration = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseOneFrame);
    EXPECT_FALSE(firstDeclaration.reuse);
    EXPECT_FALSE(retryDeclaration.reuse);
    EXPECT_NE(firstDeclaration.sequence, retryDeclaration.sequence);
    history.recordCapture(firstDeclaration);
    EXPECT_FALSE(history.accept(firstDeclaration));
    EXPECT_FALSE(history.accept(retryDeclaration));
    history.recordCapture(retryDeclaration);
    ASSERT_TRUE(history.accept(retryDeclaration));
    history.beginFrame();
    const LightSpaceCaptureTicket firstReuse = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseOneFrame);
    const LightSpaceCaptureTicket retryReuse = history.prepare(identity, SoftwareShadowCaptureCadence::ReuseOneFrame);
    EXPECT_TRUE(firstReuse.reuse);
    EXPECT_TRUE(retryReuse.reuse);
    EXPECT_FALSE(history.accept(firstReuse));
    EXPECT_TRUE(history.accept(retryReuse));
    EXPECT_EQ(history.acceptedCaptures(), 1u);
    EXPECT_EQ(history.acceptedReuses(), 1u);
}

void VerifyLightSpacePlan_RejectsUnknownCoverage(){
    Array<LightSpaceLightRequest, 2> requests = Array<LightSpaceLightRequest, 2>();
    requests[0u] = MakeLightRequest(7u, 3u, LightType::Directional);
    requests[1u] = MakeLightRequest(63u, 0u, LightType::Point);
    SoftwareShadowSettings settings = SoftwareShadowSettings();
    settings.coverage = cast<SoftwareShadowCoverageEnum>(2u);
    EXPECT_FALSE(ValidateSoftwareShadowSettings(settings));
    EXPECT_FALSE(TryBuildLightSpacePlan(settings, requests, u32.max, 20u, false).has_value());
}

void VerifyLightSpacePlan_RejectsUnknownBlockerPolicy(){
    SoftwareShadowSettings settings = SoftwareShadowSettings();
    settings.blockerSearch = cast<SoftwareShadowBlockerSearchEnum>(3u);
    EXPECT_FALSE(ValidateSoftwareShadowSettings(settings));
    Array<LightSpaceLightRequest, 1> single = Array<LightSpaceLightRequest, 1>();
    EXPECT_FALSE(TryBuildLightSpacePlan(settings, single, u32.max, 20u, false).has_value());
}

void VerifyLightSpacePlan_ChargesLargerDepthExtentToPreviouslyAdmittedPointFaces(){
    Array<LightSpaceLightRequest, 1> pointSpan = Array<LightSpaceLightRequest, 1>();
    pointSpan[0u] = MakeLightRequest(0u, 0u, LightType::Point);
    Array<LightSpaceLightRequest, 1> directionalSpan = Array<LightSpaceLightRequest, 1>();
    directionalSpan[0u] = MakeLightRequest(1u, 1u, LightType::Directional);
    SoftwareShadowSettings settings = SoftwareShadowSettings();
    const Expected<LightSpacePlan> pointOnly = TryBuildLightSpacePlan(settings, pointSpan, u32.max, 20u, false);
    ASSERT_TRUE(pointOnly.has_value());
    const Expected<LightSpacePlan> directionalOnly = TryBuildLightSpacePlan(settings, directionalSpan, u32.max, 20u, false);
    ASSERT_TRUE(directionalOnly.has_value());
    settings.memoryBudgetBytes = pointOnly.value().totalByteSize + directionalOnly.value().totalByteSize;
    Array<LightSpaceLightRequest, 2> requests = Array<LightSpaceLightRequest, 2>();
    requests[0u] = pointSpan[0u];
    requests[1u] = directionalSpan[0u];
    const Expected<LightSpacePlan> plan = TryBuildLightSpacePlan(settings, requests, u32.max, 20u, false);
    ASSERT_TRUE(plan.has_value());
    ASSERT_EQ(plan.value().lightCount, 1u);
    EXPECT_EQ(plan.value().views[0u].light[0u], 0u);
    EXPECT_EQ(plan.value().viewCount, 6u);
    EXPECT_EQ(plan.value().textureResolution, 256u);
    EXPECT_EQ(plan.value().totalByteSize, pointOnly.value().totalByteSize);
}

void VerifyLightSpacePlan_BudgetBoundaryAdmitsWholeLightsAndLeavesOthersForTracing(){
    SoftwareShadowSettings settings = SoftwareShadowSettings();
    Array<LightSpaceLightRequest, 1> light = Array<LightSpaceLightRequest, 1>();
    const Expected<LightSpacePlan> expected = TryBuildLightSpacePlan(settings, light, u32.max, 20u, false);
    ASSERT_TRUE(expected.has_value());
    ASSERT_EQ(expected.value().lightCount, 1u);
    settings.memoryBudgetBytes = expected.value().totalByteSize;
    Expected<LightSpacePlan> exact = TryBuildLightSpacePlan(settings, light, u32.max, 20u, false);
    ASSERT_TRUE(exact.has_value());
    EXPECT_EQ(exact.value().lightCount, 1u);
    --settings.memoryBudgetBytes;
    exact = TryBuildLightSpacePlan(settings, light, u32.max, 20u, false);
    ASSERT_TRUE(exact.has_value());
    EXPECT_EQ(exact.value().lightCount, 0u);
    EXPECT_EQ(exact.value().viewCount, 0u);
    EXPECT_EQ(exact.value().totalByteSize, 0u);
}

void VerifyLightSpacePlan_SkipsUnsupportedAndIneligibleCastersWithoutDroppingLaterEligibleLights(){
    Array<LightSpaceLightRequest, 3> requests = Array<LightSpaceLightRequest, 3>();
    requests[0u] = MakeLightRequest(0u, 0u, LightType::Spot);
    requests[1u] = MakeLightRequest(1u, 1u, LightType::Directional, false);
    requests[2u] = MakeLightRequest(2u, 2u, LightType::Point);
    SoftwareShadowSettings settings = SoftwareShadowSettings();
    settings.backend = SoftwareShadowBackend::LightSpace;
    const Expected<LightSpacePlan> plan = TryBuildLightSpacePlan(settings, requests, u32.max, 20u, false);
    ASSERT_TRUE(plan.has_value());
    ASSERT_EQ(plan.value().lightCount, 1u);
    EXPECT_EQ(plan.value().views[0u].light[0u], 2u);
    EXPECT_EQ(plan.value().viewCount, 6u);
}

void VerifyLightSpacePlan_RejectsInvalidIdentityWithoutPublishingPartialPlan(){
    SoftwareShadowSettings settings = SoftwareShadowSettings();
    Array<LightSpaceLightRequest, 9> requests = Array<LightSpaceLightRequest, 9>();
    requests[0u] = MakeLightRequest(0u, 0u);
    requests[1u] = MakeLightRequest(1u, 1u);
    EXPECT_FALSE(TryBuildLightSpacePlan(settings, requests, u32.max, 20u, false).has_value());
    requests[1u].shadowSlot = 0u;
    EXPECT_FALSE(TryBuildLightSpacePlan(settings, LightRequestSpan(requests.data(), 2u), u32.max, 20u, false).has_value());
    requests[1u].shadowSlot = 1u;
    requests[1u].lightIndex = 0u;
    EXPECT_FALSE(TryBuildLightSpacePlan(settings, LightRequestSpan(requests.data(), 2u), u32.max, 20u, false).has_value());
    requests[1u].lightIndex = 64u;
    EXPECT_FALSE(TryBuildLightSpacePlan(settings, LightRequestSpan(requests.data(), 2u), u32.max, 20u, false).has_value());
    requests[1u].lightIndex = 1u;
    requests[1u].shadowSlot = 8u;
    EXPECT_FALSE(TryBuildLightSpacePlan(settings, LightRequestSpan(requests.data(), 2u), u32.max, 20u, false).has_value());
    requests[1u].shadowSlot = 1u;
    requests[1u].type = LightType::kCount;
    EXPECT_FALSE(TryBuildLightSpacePlan(settings, LightRequestSpan(requests.data(), 2u), u32.max, 20u, false).has_value());
}

void VerifyLightSpacePlan_RespectsDeviceDescriptorRangeAndRetainsLaterFittingLights(){
    SoftwareShadowSettings settings = SoftwareShadowSettings();
    settings.memoryBudgetBytes = 512u * 1024u * 1024u;
    settings.pointResolution = 512u;
    Array<LightSpaceLightRequest, 2> requests = Array<LightSpaceLightRequest, 2>();
    requests[0u] = MakeLightRequest(0u, 0u, LightType::Point);
    requests[1u] = MakeLightRequest(1u, 1u, LightType::Directional);
    const u64 directionalEventBytes = 512uLL * 512uLL * s_LightSpaceEventsPerTexel * s_LightSpaceEventBytes;
    Expected<LightSpacePlan> plan = TryBuildLightSpacePlan(settings, requests, directionalEventBytes, 20u, false);
    ASSERT_TRUE(plan.has_value());
    ASSERT_EQ(plan.value().lightCount, 1u);
    EXPECT_EQ(plan.value().views[0u].light[0u], 1u);
    EXPECT_EQ(plan.value().eventByteSize, directionalEventBytes);
    EXPECT_LE(plan.value().countByteSize, directionalEventBytes);
    EXPECT_LE(plan.value().viewByteSize, directionalEventBytes);
    EXPECT_LE(plan.value().drawArgumentByteSize, directionalEventBytes);
    plan = TryBuildLightSpacePlan(settings, requests, directionalEventBytes - 1u, 20u, false);
    ASSERT_TRUE(plan.has_value());
    EXPECT_EQ(plan.value().lightCount, 0u);
    EXPECT_FALSE(TryBuildLightSpacePlan(settings, requests, 0u, 20u, false).has_value());
}

void VerifyLightSpacePlan_BoundsExternalSettingsAndShaderAddressSpace(){
    SoftwareShadowSettings settings = SoftwareShadowSettings();
    settings.directionalResolution = 0u;
    EXPECT_FALSE(ValidateSoftwareShadowSettings(settings));
    settings.directionalResolution = 2049u;
    EXPECT_FALSE(ValidateSoftwareShadowSettings(settings));
    settings.directionalResolution = 2048u;
    settings.pointResolution = 2048u;
    settings.memoryBudgetBytes = u64.max;
    EXPECT_FALSE(ValidateSoftwareShadowSettings(settings));
    settings.memoryBudgetBytes = u32.max;
    ShadowSlotLightRequestArray requests = ShadowSlotLightRequestArray();
    for(u32 index = 0u; index < requests.size(); ++index)
        requests[index] = MakeLightRequest(index, index, LightType::Point);
    Expected<LightSpacePlan> plan = TryBuildLightSpacePlan(settings, requests, u32.max, 20u, false);
    ASSERT_TRUE(plan.has_value());
    // One six-face 2048 map exceeds the shader address range.
    EXPECT_EQ(plan.value().lightCount, 0u);
    settings.pointResolution = 1024u;
    plan = TryBuildLightSpacePlan(settings, requests, u32.max, 20u, false);
    ASSERT_TRUE(plan.has_value());
    ASSERT_EQ(plan.value().lightCount, 2u);
    EXPECT_LE(plan.value().eventByteSize, u32.max);
    EXPECT_LE(plan.value().totalByteSize, settings.memoryBudgetBytes);
    settings.memoryBudgetBytes = 0u;
    EXPECT_FALSE(ValidateSoftwareShadowSettings(settings));
    settings = SoftwareShadowSettings();
    settings.backend = cast<SoftwareShadowBackendEnum>(255u);
    EXPECT_FALSE(ValidateSoftwareShadowSettings(settings));
}

void VerifyLightSpacePlan_ChargesActualDrawArgumentsAndEnforcesTheirDescriptorRange(){
    SoftwareShadowSettings settings = SoftwareShadowSettings();
    settings.directionalResolution = 32u;
    settings.memoryBudgetBytes = 16u * 1024u * 1024u;
    Array<LightSpaceLightRequest, 1> light = Array<LightSpaceLightRequest, 1>();
    const u32 drawCount = 65536u;
    const u64 argumentBytes = cast<u64>(drawCount) * s_LightSpaceDrawArgumentBytes;
    Expected<LightSpacePlan> plan = TryBuildLightSpacePlan(settings, light, argumentBytes, drawCount, false);
    ASSERT_TRUE(plan.has_value());
    ASSERT_EQ(plan.value().lightCount, 1u);
    EXPECT_EQ(plan.value().drawArgumentByteSize, argumentBytes);
    EXPECT_EQ(plan.value().totalByteSize, plan.value().eventByteSize + plan.value().countByteSize + plan.value().viewByteSize + plan.value().depthByteSize + argumentBytes);
    plan = TryBuildLightSpacePlan(settings, light, argumentBytes - 1u, drawCount, false);
    ASSERT_TRUE(plan.has_value());
    EXPECT_EQ(plan.value().lightCount, 0u);
    EXPECT_FALSE(TryBuildLightSpacePlan(settings, light, u32.max, 0u, false).has_value());
    plan = TryBuildLightSpacePlan(settings, LightRequestSpan(), u32.max, 0u, false);
    ASSERT_TRUE(plan.has_value());
    EXPECT_EQ(plan.value().totalByteSize, 0u);
    plan = TryBuildLightSpacePlan(settings, light, u32.max, u32.max, false);
    ASSERT_TRUE(plan.has_value());
    EXPECT_EQ(plan.value().lightCount, 0u);
}

void ClearLightSpaceShadowGraphRequiredResource(mut LightSpaceShadowGraph graph, in u32 index){
    switch(index){
    case 0u:
        graph.counts = GpuGraphResourceId();
        break;
    case 1u:
        graph.events = GpuGraphResourceId();
        break;
    case 2u:
        graph.views = GpuGraphResourceId();
        break;
    default:
        graph.depth = GpuGraphResourceId();
        break;
    }
}

void VerifyLightSpaceShadowStorage_GraphRequiresEachResourceAndValidTaskGeneration(){
    LightSpaceShadowGraph graph = LightSpaceShadowGraph();
    EXPECT_FALSE(graph.valid());
    GpuGraphResourceId resource = GpuGraphResourceId();
    resource.generation = 1u;
    resource.index = 0u;
    graph.counts = resource;
    graph.events = resource;
    graph.views = resource;
    graph.depth = resource;
    GpuTaskId readyTask = GpuTaskId();
    readyTask.generation = 1u;
    readyTask.index = 0u;
    graph.ready = readyTask;
    ASSERT_TRUE(graph.valid());
    for(u32 fieldIndex = 0u; fieldIndex < 4u; ++fieldIndex){
        LightSpaceShadowGraph missing = graph;
        ClearLightSpaceShadowGraphRequiredResource(missing, fieldIndex);
        EXPECT_FALSE(missing.valid());
    }
    graph.ready.generation = 0u;
    EXPECT_FALSE(graph.valid());
}

void VerifyLightSpaceShadowStorage_PipelineSelectionRespectsCsgRangeBoundaries(){
    for(u32 index = 0u; index < 12u; ++index){
        EXPECT_EQ(ShouldSkipLightSpacePipeline(index, false, false), index >= 6u && index <= 10u);
        EXPECT_EQ(ShouldSkipLightSpacePipeline(index, true, true), index >= 9u && index <= 10u);
        EXPECT_FALSE(ShouldSkipLightSpacePipeline(index, true, false));
    }
}

void VerifyLightSpaceShadowStorage_ReservesWholeCasterAndRoundedMeshletGroupDraws(){
    Array<LightSpaceShadowCaster, 4> casters = Array<LightSpaceShadowCaster, 4>();
    casters[1u].meshletCount = 1u;
    casters[2u].meshletCount = s_LightSpaceMeshletsPerDraw + 1u;
    casters[3u].meshletCount = 2u * s_LightSpaceMeshletsPerDraw + 1u;
    const Expected<u32> counted = LightSpaceShadowDrawCount(casters);
    ASSERT_TRUE(counted.has_value());
    const u32 drawCount = counted.value();
    ASSERT_EQ(drawCount, 7u);
    casters[1u].meshletCount = s_LightSpaceMeshletsPerDraw;
    const Expected<u32> recounted = LightSpaceShadowDrawCount(casters);
    ASSERT_TRUE(recounted.has_value());
    EXPECT_EQ(recounted.value(), drawCount);

    Array<LightSpaceLightRequest, 2> requests = Array<LightSpaceLightRequest, 2>();
    requests[0u] = MakeLightRequest(0u, 0u, LightType::Directional);
    requests[1u] = MakeLightRequest(1u, 1u, LightType::Point);
    const Expected<LightSpacePlan> plan = TryBuildLightSpacePlan(SoftwareShadowSettings(), requests, u32.max, drawCount, false);
    ASSERT_TRUE(plan.has_value());
    ASSERT_EQ(plan.value().lightCount, 2u);
    ASSERT_EQ(plan.value().viewCount, 7u);
    EXPECT_EQ(plan.value().drawArgumentByteSize, 7u * 7u * s_LightSpaceDrawArgumentBytes);
}

void VerifyLightSpaceShadowStorage_RejectsInvalidAndOverflowingDrawSpansWithoutWrapping(){
    const Expected<u32> emptyNull = LightSpaceShadowDrawCount(ShadowCasterSpan());
    ASSERT_TRUE(emptyNull.has_value());
    EXPECT_EQ(emptyNull.value(), 0u);
    Array<LightSpaceShadowCaster, 32> casters = Array<LightSpaceShadowCaster, 32>();
    const Expected<u32> emptySpan = LightSpaceShadowDrawCount(ShadowCasterSpan(casters.data(), 0u));
    ASSERT_TRUE(emptySpan.has_value());
    EXPECT_EQ(emptySpan.value(), 0u);
    for(mut LightSpaceShadowCaster caster : casters)
        caster.meshletCount = u32.max;
    const Expected<u32> singleMaximum = LightSpaceShadowDrawCount(ShadowCasterSpan(casters.data(), 1u));
    ASSERT_TRUE(singleMaximum.has_value());
    EXPECT_EQ(singleMaximum.value(), 134217728u);
    const Expected<u32> lastRepresentable = LightSpaceShadowDrawCount(ShadowCasterSpan(casters.data(), 31u));
    ASSERT_TRUE(lastRepresentable.has_value());
    EXPECT_EQ(lastRepresentable.value(), 4160749568u);
    EXPECT_FALSE(LightSpaceShadowDrawCount(casters).has_value());
}

void VerifyLightSpaceShadowStorage_AcceptsExactGenerationAndRejectsEachInsufficientResource(){
    Array<LightSpaceLightRequest, 2> requests = Array<LightSpaceLightRequest, 2>();
    requests[0u] = MakeLightRequest(0u, 0u, LightType::Directional);
    requests[1u] = MakeLightRequest(1u, 1u, LightType::Point);
    const Expected<LightSpacePlan> plan = TryBuildLightSpacePlan(SoftwareShadowSettings(), requests, u32.max, 20u, false);
    ASSERT_TRUE(plan.has_value());
    const LightSpaceShadowStorageCapacity exact = MakeStorageCapacity(plan.value());
    ASSERT_TRUE(LightSpaceShadowStorageFits(plan.value(), exact));
    LightSpaceShadowStorageCapacity capacity = exact;
    --capacity.countBytes;
    EXPECT_FALSE(LightSpaceShadowStorageFits(plan.value(), capacity));
    capacity = exact;
    --capacity.eventBytes;
    EXPECT_FALSE(LightSpaceShadowStorageFits(plan.value(), capacity));
    capacity = exact;
    --capacity.viewBytes;
    EXPECT_FALSE(LightSpaceShadowStorageFits(plan.value(), capacity));
    capacity = exact;
    --capacity.drawArgumentBytes;
    EXPECT_FALSE(LightSpaceShadowStorageFits(plan.value(), capacity));
    capacity = exact;
    --capacity.textureResolution;
    EXPECT_FALSE(LightSpaceShadowStorageFits(plan.value(), capacity));
    capacity = exact;
    --capacity.arrayLayers;
    EXPECT_FALSE(LightSpaceShadowStorageFits(plan.value(), capacity));
}

void VerifyLightSpaceShadowStorage_CanSelectSmallerCurrentPlanWithoutAllocatingAndDeclinesGrowth(){
    Array<LightSpaceLightRequest, 1> pointSpan = Array<LightSpaceLightRequest, 1>();
    pointSpan[0u] = MakeLightRequest(1u, 1u, LightType::Point);
    Array<LightSpaceLightRequest, 2> both = Array<LightSpaceLightRequest, 2>();
    both[0u] = MakeLightRequest(0u, 0u, LightType::Directional);
    both[1u] = pointSpan[0u];
    const Expected<LightSpacePlan> larger = TryBuildLightSpacePlan(SoftwareShadowSettings(), both, u32.max, 20u, false);
    const Expected<LightSpacePlan> smaller = TryBuildLightSpacePlan(SoftwareShadowSettings(), pointSpan, u32.max, 20u, false);
    ASSERT_TRUE(larger.has_value());
    ASSERT_TRUE(smaller.has_value());
    const LightSpaceShadowStorageCapacity capacity = MakeStorageCapacity(larger.value());
    EXPECT_TRUE(LightSpaceShadowStorageFits(smaller.value(), capacity));
    const LightSpaceShadowStorageCapacity small = MakeStorageCapacity(smaller.value());
    EXPECT_FALSE(LightSpaceShadowStorageFits(larger.value(), small));
    EXPECT_FALSE(LightSpaceShadowStorageFits(LightSpacePlan(), capacity));
}

void VerifyLightingContentStamp_OnlyTheSelectedLightPrefixContributes(){
    SceneShadingGpuData shading = SceneShadingGpuData();
    Array<SceneLightGpuData, 2> lights = Array<SceneLightGpuData, 2>();
    const u64 original = ComputeSceneLightingContentHash(shading, SceneLightSpan(lights.data(), 1u));
    lights[1u].position.x = 3.0f;
    lights[1u].colorIntensity.w = 0.0f;
    EXPECT_EQ(ComputeSceneLightingContentHash(shading, SceneLightSpan(lights.data(), 1u)), original);
    EXPECT_NE(ComputeSceneLightingContentHash(shading, SceneLightSpan(lights.data(), 2u)), original);
    EXPECT_EQ(
        ComputeSceneLightingContentHash(shading, SceneLightSpan()),
        ComputeSceneLightingContentHash(shading, SceneLightSpan(lights.data(), 0u))
    );
}

void VerifyLightingContentStamp_ReversingSelectedLightsChangesSemanticIdentity(){
    SceneShadingGpuData shading = SceneShadingGpuData();
    Array<SceneLightGpuData, 2> lights = Array<SceneLightGpuData, 2>();
    lights[0u].colorIntensity.x = 0.2f;
    lights[1u].colorIntensity.y = 0.7f;
    const u64 original = ComputeSceneLightingContentHash(shading, SceneLightSpan(lights.data(), 2u));
    Array<SceneLightGpuData, 2> reversed = Array<SceneLightGpuData, 2>();
    reversed[0u] = lights[1u];
    reversed[1u] = lights[0u];
    EXPECT_NE(ComputeSceneLightingContentHash(shading, SceneLightSpan(reversed.data(), 2u)), original);
}

Expected<Span<u8>> PrepareMutableCacheEntry(
    mut MaterialInstanceMutableCache cache,
    mut EcsTestWorld context,
    in EntityID entity,
    in MaterialSurfaceInfo surface,
    in MaterialInstanceComponent instance
){
    return PrepareMutableCacheWithInstance(cache, context, entity, surface, instance);
}

void VerifyMaterialInstanceMutableCacheTests_RevisionChangesAndClearInvalidatePreparedBytes(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration = LoggerRegistrationGuard(logger, LoggerBreakPolicy::ReportOnly);
    EcsTestWorld context = EcsTestWorld();
    MaterialInstanceMutableCache cache = MaterialInstanceMutableCache(context.arena);
    MaterialSurfaceInfo surface = MaterialSurfaceInfo(context.arena);
    surface.materialName = Name(s_EcsGraphicsOverrideMaterial);
    surface.materialInterface = Name(s_EcsGraphicsOverrideInterface);
    surface.typedLayoutHash = 7u;
    surface.mutableDefaultTypedBytes.resize(4u);
    MaterialTypedLayoutBlock block = MaterialTypedLayoutBlock();
    block.blockName = Name(s_EcsGraphicsOverrideBlock);
    block.blockClass = MaterialBlockClass::MaterialMutable;
    block.fieldCount = 1u;
    block.byteSize = 4u;
    surface.typedLayoutBlocks.push_back(block);
    MaterialTypedLayoutField field = MaterialTypedLayoutField();
    field.fieldName = Name(s_EcsGraphicsMutableValue);
    field.fieldType = MaterialLayoutFieldType::u32;
    surface.typedLayoutFields.push_back(field);
    MaterialInstanceComponent instance = MaterialInstanceComponent(surface.materialInterface);
    MaterialInstanceParameter parameter = MaterialInstanceParameter();
    parameter.parameterName = Name(s_EcsGraphicsMutableParameter);
    parameter.blockName = block.blockName;
    parameter.fieldName = field.fieldName;
    parameter.fieldType = field.fieldType;
    parameter.value = UInt4U(0x01020304u, 0u, 0u, 0u);
    instance.overrides.push_back(parameter);
    const EntityID entity = EntityID(1u);

    ASSERT_FALSE(FindMutableCacheWithInstance(cache, entity, surface, instance).has_value());
    const Expected<Span<u8>> first = PrepareMutableCacheEntry(cache, context, entity, surface, instance);
    ASSERT_TRUE(first.has_value());
    ASSERT_EQ(first.value().size(), 4u);
    EXPECT_EQ(first.value()[0u], 0x04u);
    EXPECT_TRUE(FindMutableCacheWithInstance(cache, entity, surface, instance).has_value());
    ++instance.revision;
    instance.overrides[0u].value = UInt4U(0xAABBCCDDu, 0u, 0u, 0u);
    EXPECT_FALSE(FindMutableCacheWithInstance(cache, entity, surface, instance).has_value());
    const Expected<Span<u8>> refreshed = PrepareMutableCacheEntry(cache, context, entity, surface, instance);
    ASSERT_TRUE(refreshed.has_value());
    EXPECT_EQ(refreshed.value()[0u], 0xDDu);
    EXPECT_EQ(refreshed.value()[3u], 0xAAu);
    cache.clear();
    EXPECT_FALSE(FindMutableCacheWithInstance(cache, entity, surface, instance).has_value());
    EXPECT_TRUE(FindMutableCacheWithoutInstance(cache, entity, surface).has_value());
    EXPECT_EQ(logger.errorCount(), 0u);
}

b8 ApplyMaterialOverrides(
    in MaterialInstanceOverrideApplier applier,
    in u32 entityId,
    in Name materialName,
    in Name interfaceName,
    in MaterialTypedLayoutBlock block,
    in MaterialTypedLayoutField field,
    in MaterialInstanceComponent instance,
    mut Array<u8, 8> bytes,
    in usize byteCount
){
    return ApplyMaterialInstanceOverridesToPrefix(applier, entityId, materialName, interfaceName, block, field, instance, bytes, byteCount);
}

void VerifyMaterialInstanceOverrideApplierTests_RejectsTruncatedStorageWithoutWritingAndAcceptsExactFit(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration = LoggerRegistrationGuard(logger, LoggerBreakPolicy::ReportOnly);
    const Name interfaceName = Name(s_EcsGraphicsOverrideInterface);
    const Name blockName = Name(s_EcsGraphicsOverrideBlock);
    const Name fieldName = Name(s_EcsGraphicsOverrideField);
    MaterialTypedLayoutBlock block = MaterialTypedLayoutBlock();
    block.blockName = blockName;
    block.blockClass = MaterialBlockClass::MaterialMutable;
    block.fieldCount = 1u;
    block.byteSize = 8u;
    MaterialTypedLayoutField field = MaterialTypedLayoutField();
    field.fieldName = fieldName;
    field.fieldType = MaterialLayoutFieldType::u32;
    field.offset = 4u;
    MaterialInstanceParameter parameter = MaterialInstanceParameter();
    parameter.parameterName = Name(s_EcsGraphicsOverrideParameter);
    parameter.blockName = blockName;
    parameter.fieldName = fieldName;
    parameter.fieldType = field.fieldType;
    parameter.value = UInt4U(0x12345678u, 0u, 0u, 0u);
    MaterialInstanceComponent instance = MaterialInstanceComponent(interfaceName);
    instance.overrides.push_back(parameter);
    Array<u8, 8> bytes = Array<u8, 8>();
    for(mut u8 value : bytes)
        value = 0xABu;
    const MaterialInstanceOverrideApplier applier = MaterialInstanceOverrideApplier();

    EXPECT_FALSE(ApplyMaterialOverrides(applier, 1u, Name(s_EcsGraphicsOverrideMaterial), interfaceName, block, field, instance, bytes, bytes.size() - 1u));
    for(in u8 value : bytes)
        EXPECT_EQ(value, 0xABu);
    EXPECT_EQ(logger.errorCount(), 1u);
    EXPECT_TRUE(logger.sawErrorContaining("exceeds mutable storage"));

    ASSERT_TRUE(ApplyMaterialOverrides(applier, 1u, Name(s_EcsGraphicsOverrideMaterial), interfaceName, block, field, instance, bytes, bytes.size()));
    EXPECT_EQ(bytes[3u], 0xABu);
    EXPECT_EQ(bytes[4u], 0x78u);
    EXPECT_EQ(bytes[5u], 0x56u);
    EXPECT_EQ(bytes[6u], 0x34u);
    EXPECT_EQ(bytes[7u], 0x12u);
}

void VerifyEcsGraphics_ShadowMaterialConstantsReuseOnlyTheSameMaterialAndLayout(){
    const Name material = s_EcsGraphicsNameProjectMaterialsShared;
    const Name otherMaterial = s_EcsGraphicsNameProjectMaterialsOther;
    MaterialConstantRangeTestContext context = MaterialConstantRangeTestContext();
    Array<u8, 4> constants = Array<u8, 4>();
    constants[0u] = 0xA1u;
    constants[1u] = 0xB2u;
    constants[2u] = 0xC3u;
    constants[3u] = 0xD4u;

    const Expected<MaterialTypedByteRange> first = context.findOrAppend(material, 17u, constants);
    ASSERT_TRUE(first.has_value());
    const usize firstUploadSize = context.uploadSize();
    for(u32 instance = 0u; instance < 8u; ++instance){
        const Expected<MaterialTypedByteRange> repeated = context.findOrAppend(material, 17u, constants);
        ASSERT_TRUE(repeated.has_value());
        EXPECT_EQ(repeated.value().byteOffset, first.value().byteOffset);
        EXPECT_EQ(repeated.value().byteCount, first.value().byteCount);
        EXPECT_EQ(context.uploadSize(), firstUploadSize);
    }
    const Expected<MaterialTypedByteRange> differentLayout = context.findOrAppend(material, 18u, constants);
    const Expected<MaterialTypedByteRange> differentMaterial = context.findOrAppend(otherMaterial, 17u, constants);
    ASSERT_TRUE(differentLayout.has_value());
    ASSERT_TRUE(differentMaterial.has_value());
    EXPECT_NE(differentLayout.value().byteOffset, first.value().byteOffset);
    EXPECT_NE(differentMaterial.value().byteOffset, first.value().byteOffset);
    EXPECT_NE(differentMaterial.value().byteOffset, differentLayout.value().byteOffset);
    ASSERT_EQ(context.rangeCount(), 3u);
    context.verifyStoredRanges(material, otherMaterial, constants);
}

void VerifyEcsGraphics_MaterialTypedByteRangeRepeatedHitsAvoidScratchAllocations(){
    Array<u8, 4096> sourceBytes = Array<u8, 4096>();
    for(usize index = 0u; index < sourceBytes.size(); ++index)
        sourceBytes[index] = cast<u8>((index * 31u) & 255u);

    Array<usize, 2> byteCounts = Array<usize, 2>();
    byteCounts[0u] = 512u;
    byteCounts[1u] = 4096u;
    for(in usize byteCount : byteCounts){
        MaterialTypedByteRangeTestContext context = MaterialTypedByteRangeTestContext();
        context.reserveStorage(byteCount, 1u);
        const Span<u8> bytes = Span<u8>(sourceBytes.data(), byteCount);
        const Expected<MaterialTypedByteRange> rangeResult1 = context.findOrAppend(bytes);
        ASSERT_TRUE(rangeResult1.has_value());
        const MaterialTypedByteRange firstRange = rangeResult1.value();

        const ArenaMemoryStats before = context.memoryStats();
        for(usize lookup = 0u; lookup < 256u; ++lookup){
            const Expected<MaterialTypedByteRange> rangeResult3 = context.findOrAppend(bytes);
            ASSERT_TRUE(rangeResult3.has_value());
            const MaterialTypedByteRange range = rangeResult3.value();
            EXPECT_EQ(range.byteOffset, firstRange.byteOffset);
            EXPECT_EQ(range.byteCount, firstRange.byteCount);
        }
        const Span<u8> emptyBytes = Span<u8>();
        const Expected<MaterialTypedByteRange> rangeResult4 = context.findOrAppend(emptyBytes);
        ASSERT_TRUE(rangeResult4.has_value());
        const MaterialTypedByteRange emptyRange = rangeResult4.value();
        const ArenaMemoryStats after = context.memoryStats();
        EXPECT_EQ(after.allocationCount, before.allocationCount);
        EXPECT_EQ(after.reallocationCount, before.reallocationCount);
        EXPECT_EQ(after.deallocationCount, before.deallocationCount);
        EXPECT_EQ(after.usedBytes, before.usedBytes);
        EXPECT_EQ(after.peakUsedBytes, before.peakUsedBytes);
        EXPECT_EQ(after.reservedBytes, before.reservedBytes);
        EXPECT_EQ(emptyRange.byteOffset, 0u);
        EXPECT_EQ(emptyRange.byteCount, 0u);
        EXPECT_EQ(context.uploadSize(), byteCount);
        EXPECT_EQ(context.rangeCount(), 1u);
    }
}

void VerifyEcsGraphics_MaterialTypedByteRangeHashCollisionRetainsOwnedBytes(){
    const u64 collisionHash = s_EcsGraphicsCollisionHash;
    MaterialTypedByteRangeTestContext context = MaterialTypedByteRangeTestContext();
    context.reserveStorage(0u, 2u);
    Array<u8, 4> originalFirstBytes = Array<u8, 4>();
    originalFirstBytes[0u] = 1u;
    originalFirstBytes[1u] = 2u;
    originalFirstBytes[2u] = 3u;
    originalFirstBytes[3u] = 4u;
    Array<u8, 4> secondBytes = Array<u8, 4>();
    secondBytes[0u] = 1u;
    secondBytes[1u] = 2u;
    secondBytes[2u] = 3u;
    secondBytes[3u] = 5u;
    {
        Array<u8, 4> firstBytes = originalFirstBytes;
        ASSERT_TRUE(context.emplaceOwnedKey(collisionHash, firstBytes, 0u, 4u));
        firstBytes.fill(0u);
    }

    // Compare payload bytes even when hash and byte length match.
    const Optional<MaterialTypedByteRange> firstFound = context.findByLookup(collisionHash, originalFirstBytes);
    ASSERT_TRUE(firstFound.has_value());
    EXPECT_EQ(firstFound.value().byteOffset, 0u);
    EXPECT_FALSE(context.findByLookup(collisionHash, secondBytes).has_value());
    ASSERT_TRUE(context.emplaceOwnedKey(collisionHash, secondBytes, 4u, 4u));
    const Optional<MaterialTypedByteRange> secondFound = context.findByLookup(collisionHash, secondBytes);
    ASSERT_TRUE(secondFound.has_value());
    EXPECT_EQ(secondFound.value().byteOffset, 4u);
    EXPECT_EQ(context.rangeCount(), 2u);
}

void InitMaterialUploadPattern(mut MaterialTypedByteRangeTestContext context, mut Array<u8, 32> expectedBytes){
    context.fillUploadPattern(expectedBytes.size(), expectedBytes);
}

void VerifyEcsGraphics_MaterialTypedByteRangeUploadAliasSurvivesGrowthAndMutation(){
    Array<u8, 32> expectedBytes = Array<u8, 32>();
    MaterialTypedByteRangeTestContext context = MaterialTypedByteRangeTestContext();
    InitMaterialUploadPattern(context, expectedBytes);
    const usize initialCapacity = context.uploadCapacity();
    context.reserveStorage(0u, 1u);
    const Expected<MaterialTypedByteRange> rangeResult5 = context.appendSelfAliasedUploadBytes();
    ASSERT_TRUE(rangeResult5.has_value());
    const MaterialTypedByteRange appendedRange = rangeResult5.value();
    ASSERT_GT(context.uploadCapacity(), initialCapacity);
    ASSERT_EQ(appendedRange.byteCount, expectedBytes.size());
    ASSERT_EQ(context.uploadSize(), expectedBytes.size() * 2u);
    EXPECT_TRUE(context.rangeMatchesUpload(appendedRange, expectedBytes));

    // Mutating the original upload bytes cannot change the retained dedup key.
    context.invertUploadPrefix(expectedBytes.size());
    const usize uploadByteCount = context.uploadSize();
    const Expected<MaterialTypedByteRange> rangeResult6 = context.findOrAppend(expectedBytes);
    ASSERT_TRUE(rangeResult6.has_value());
    const MaterialTypedByteRange foundRange = rangeResult6.value();
    EXPECT_EQ(foundRange.byteOffset, appendedRange.byteOffset);
    EXPECT_EQ(foundRange.byteCount, appendedRange.byteCount);
    EXPECT_EQ(context.uploadSize(), uploadByteCount);
    EXPECT_EQ(context.rangeCount(), 1u);
}

