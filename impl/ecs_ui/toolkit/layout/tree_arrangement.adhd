////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "tree_measurement.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class LayoutTreeArrangementStart{
    public Rect childClip = Rect();
    public f64 available = 0.0;
    public f64 invWeight = 0.0;
    public f64 cursor = 0.0;
}

Rect IntersectLayoutRectsScalar(in Rect lhs, in Rect rhs){
    const f32 x0 = Max(lhs.x, rhs.x);
    const f32 y0 = Max(lhs.y, rhs.y);
    const f32 x1 = Min(lhs.x + lhs.width, rhs.x + rhs.width);
    const f32 y1 = Min(lhs.y + lhs.height, rhs.y + rhs.height);
    return Rect(x0, y0, Max(0.0f, x1 - x0), Max(0.0f, y1 - y0));
}

Expected<LayoutTreeArrangementStart> TryBeginArrangeLayoutTreeNode(
    in Span<LayoutTreeNode> nodes,
    in Span<LayoutBox> boxes,
    in Span<Rect> inheritedClips,
    in u32 index,
    mut LayoutBox inoutBox
){
    LayoutTreeArrangementStart result;
    if(!IsValidUiRect(inoutBox.rectangle))
        return MakeUnexpected(Failure());
    in LayoutTreeNode node = nodes[cast<usize>(index)];
    in LayoutNodeDesc description = node.description;
    in Rect inheritedClip = inheritedClips[cast<usize>(index)];
    const f64 boxWidth = cast<f64>(inoutBox.rectangle.width);
    const f64 boxHeight = cast<f64>(inoutBox.rectangle.height);
    const f64 padLeft = Min(cast<f64>(description.padding.left), boxWidth);
    const f64 padTop = Min(cast<f64>(description.padding.top), boxHeight);
    const f64 remWidth = boxWidth - padLeft;
    const f64 remHeight = boxHeight - padTop;
    const f64 padRight = Min(cast<f64>(description.padding.right), remWidth);
    const f64 padBottom = Min(cast<f64>(description.padding.bottom), remHeight);
    inoutBox.content = Rect(
        cast<f32>(cast<f64>(inoutBox.rectangle.x) + padLeft),
        cast<f32>(cast<f64>(inoutBox.rectangle.y) + padTop),
        cast<f32>(remWidth - padRight),
        cast<f32>(remHeight - padBottom)
    );
    inoutBox.clip = IntersectLayoutRectsScalar(inoutBox.rectangle, inheritedClip);
    inoutBox.hit = inoutBox.clip;
    if(!IsValidUiRect(inoutBox.content) || !IsValidUiRect(inoutBox.clip))
        return MakeUnexpected(Failure());
    if(node.firstChild == s_LayoutNoParent)
        return result;
    if(description.clipChildren)
        result.childClip = IntersectLayoutRectsScalar(inheritedClip, inoutBox.content);
    else
        result.childClip = inheritedClip;
    const b8 row = description.direction == LayoutDirection::Row;
    const b8 column = description.direction == LayoutDirection::Column;
    if(!row && !column)
        return result;
    f64 consumed = 0.0;
    f64 weight = 0.0;
    u32 childCount = 0u;
    for(u32 child = node.firstChild; child != s_LayoutNoParent; child = nodes[cast<usize>(child)].nextSibling){
        in LayoutNodeDesc childDescription = nodes[cast<usize>(child)].description;
        LayoutSize main = childDescription.height;
        if(row)
            main = childDescription.width;
        if(main.policy == LayoutSizePolicy::Stretch)
            weight += cast<f64>(main.value);
        else{
            f32 measuredMain = boxes[cast<usize>(child)].measuredSize.y;
            if(row)
                measuredMain = boxes[cast<usize>(child)].measuredSize.x;
            consumed += cast<f64>(measuredMain);
        }
        ++childCount;
    }
    f64 spacing = 0.0;
    if(childCount > 1u)
        spacing = cast<f64>(description.gap) * cast<f64>(childCount - 1u);
    f32 mainExtent = inoutBox.content.height;
    if(row)
        mainExtent = inoutBox.content.width;
    result.available = Max(0.0, (cast<f64>(mainExtent) - consumed) - spacing);
    if(weight > 0.0)
        result.invWeight = 1.0 / weight;
    f32 startCoord = inoutBox.content.y;
    if(row)
        startCoord = inoutBox.content.x;
    result.cursor = cast<f64>(startCoord);
    return result;
}

Expected<Rect> TryArrangeLayoutTreeChild(
    in LayoutDirection parentDirection,
    in f32 parentGap,
    in Rect parentContent,
    in LayoutNodeDesc childDescription,
    in Point childMeasured,
    in f64 available,
    in f64 invWeight,
    mut f64 inoutCursor
){
    const b8 row = parentDirection == LayoutDirection::Row;
    const b8 column = parentDirection == LayoutDirection::Column;
    f32 width = childMeasured.x;
    f32 height = childMeasured.y;
    if(childDescription.width.policy == LayoutSizePolicy::Stretch){
        if(row)
            width = cast<f32>(available * (cast<f64>(childDescription.width.value) * invWeight));
        else
            width = parentContent.width;
    }
    if(childDescription.height.policy == LayoutSizePolicy::Stretch){
        if(column)
            height = cast<f32>(available * (cast<f64>(childDescription.height.value) * invWeight));
        else
            height = parentContent.height;
    }
    f32 x = parentContent.x;
    if(row)
        x = cast<f32>(inoutCursor);
    f32 y = parentContent.y;
    if(column)
        y = cast<f32>(inoutCursor);
    const Rect rectangle(x, y, width, height);
    if(!IsValidUiRect(rectangle))
        return MakeUnexpected(Failure());
    const f64 gap = cast<f64>(parentGap);
    if(row)
        inoutCursor += cast<f64>(width) + gap;
    else if(column)
        inoutCursor += cast<f64>(height) + gap;
    return rectangle;
}

b8 ArrangeLayoutTreeNodeAt(in Span<LayoutTreeNode> nodes, in u32 index, mut Vector<LayoutBox> boxes, mut Vector<Rect> inheritedClips){
    const Expected<LayoutTreeArrangementStart> arrangement = TryBeginArrangeLayoutTreeNode(nodes, Span<LayoutBox>(boxes), Span<Rect>(inheritedClips), index, boxes[cast<usize>(index)]);
    if(!arrangement.has_value())
        return false;
    in LayoutTreeNode node = nodes[cast<usize>(index)];
    if(node.firstChild == s_LayoutNoParent)
        return true;
    f64 cursor = arrangement.value().cursor;
    in LayoutNodeDesc description = node.description;
    in Rect content = boxes[cast<usize>(index)].content;
    for(u32 child = node.firstChild; child != s_LayoutNoParent; child = nodes[cast<usize>(child)].nextSibling){
        const Expected<Rect> childRect = TryArrangeLayoutTreeChild(
            description.direction,
            description.gap,
            content,
            nodes[cast<usize>(child)].description,
            boxes[cast<usize>(child)].measuredSize,
            arrangement.value().available,
            arrangement.value().invWeight,
            cursor
        );
        if(!childRect.has_value())
            return false;
        boxes[cast<usize>(child)].rectangle = childRect.value();
        inheritedClips[cast<usize>(child)] = arrangement.value().childClip;
    }
    return true;
}

b8 ArrangeLayoutTree(
    in Span<LayoutTreeNode> nodes,
    in b8 buildFailed,
    in Rect viewport,
    mut Vector<Rect> inheritedClips,
    mut Vector<LayoutBox> stagedBoxes,
    mut Vector<LayoutBox> boxes
){
    if(buildFailed || nodes.empty() || !IsValidUiRect(viewport))
        return false;
    stagedBoxes.clear();
    stagedBoxes.resize(nodes.size());
    inheritedClips.clear();
    inheritedClips.resize(nodes.size());
    if(!MeasureLayoutTreeNodes(nodes, stagedBoxes))
        return false;
    in LayoutNodeDesc root = nodes[0u].description;
    const Point measured = stagedBoxes[0u].measuredSize;
    f32 width = measured.x;
    if(root.width.policy == LayoutSizePolicy::Stretch)
        width = viewport.width;
    f32 height = measured.y;
    if(root.height.policy == LayoutSizePolicy::Stretch)
        height = viewport.height;
    stagedBoxes[0u].rectangle = Rect(viewport.x, viewport.y, width, height);
    inheritedClips[0u] = viewport;
    for(u32 index = 0u; cast<usize>(index) < nodes.size(); ++index){
        if(!ArrangeLayoutTreeNodeAt(nodes, index, stagedBoxes, inheritedClips))
            return false;
    }
    boxes.swap(stagedBoxes);
    return true;
}


