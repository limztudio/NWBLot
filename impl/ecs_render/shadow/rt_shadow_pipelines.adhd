#include <impl/assets_graphics/shadow_subsystem.adhd>
#include <impl/ecs_render/kernel/compute_pipeline_utils.adhd>
#include <impl/ecs_render/kernel/descriptor_register_utils.adhd>
#include <impl/ecs_render/shadow/shadow_pipeline_set.adhd>
#include <impl/ecs_render/shadow/rt_shadow_state.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets/graphics/shadow/sw_binding_slots.h>"), cpp_name("NWB_SW_SHADOW_EDGE_COUNTER_SIZE")]
extern const u32 s_ShaderSwEdgeCounterSize;

[cpp_header("<impl/assets/graphics/shadow/sw_binding_slots.h>"), cpp_name("NWB_SW_SHADOW_INDIRECT_ARGS_WORD_COUNT")]
extern const u32 s_ShaderSwIndirectArgsWordCount;

[cpp_header("<impl/assets/graphics/shadow/shadow_resolve_binding_slots.h>"), cpp_name("NWB_SHADOW_RESOLVE_STAGE_WAVELET")]
extern const u32 s_ShaderResolveWavelet;

[cpp_header("<impl/assets/graphics/shadow/shadow_resolve_binding_slots.h>"), cpp_name("NWB_SHADOW_RESOLVE_STAGE_UPSAMPLE")]
extern const u32 s_ShaderResolveUpsample;

static_assert(s_ShaderResolveWavelet == 1u && s_ShaderResolveUpsample == 2u);
static_assert(size_of<ShadowRqSoftPushConstants>() >= size_of<ShadowRqPushConstants>());


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Name s_ShadowRayQueryShaderDebugName = "ECSRender_ShadowRayQuery";
const Name s_ShadowRayQuerySoftShaderDebugName = "ECSRender_ShadowRayQuerySoft";
const Name s_SoftShadowResolveShaderScope = "ECSRender_SoftShadowResolve";
const Name s_ShadowGeometryDownsampleShaderScope = "ECSRender_ShadowGeometryDownsample";
const Name s_SoftShadowReprojectMergeShaderScope = "ECSRender_SoftShadowReprojectMerge";
const Name s_CombinedShadowUpsampleShaderScope = "ECSRender_CombinedShadowUpsample";
const Name s_CombinedShadowWaveletShaderScope = "ECSRender_CombinedShadowWavelet";
const Name s_CombinedShadowTemporalShaderScope = "ECSRender_CombinedShadowTemporal";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u64 ResolveSoftwareShadowEdgeCounterByteSize(in u32 counterWordCount){
    return cast<u64>(counterWordCount) * 4ull;
}

u64 ResolveSoftwareShadowIndirectArgsByteSize(in u32 indirectArgsWordCount){
    return cast<u64>(indirectArgsWordCount) * 4ull;
}

b8 CanPrepareSoftCombinedResolvePipelines(in b8 softShadowReady, in b8 softTransparentReady){
    return softShadowReady && softTransparentReady;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 EnsureShadowResolveStage(
    in BindingLayoutHandle layout,
    in Func<64u, AssetRef<ComputeShader>(in ShadowSubsystem)> selector,
    mut RendererShaderSystem shaders,
    mut Device device,
    in StringView variant,
    in Name debugScope,
    mut SoftShadowResolveStageState stage
){
    if(stage.m_pipeline.valid())
        return true;
    if(!shaders.loadShader<ComputeShader, ShadowSubsystem>(selector, variant, debugScope, stage.m_shader))
        return false;
    const Expected<ComputePipelineHandle> pipeline = CreateHeapComputePipeline(device, stage.m_shader, layout, false);
    if(!pipeline.has_value()){
        stage.m_pipeline.reset();
        return false;
    }
    stage.m_pipeline = pipeline.value();
    return true;
}

b8 EnsureResolveChannel(
    in BindingLayoutHandle layout,
    in Func<64u, AssetRef<ComputeShader>(in ShadowSubsystem)> selector,
    mut RendererShaderSystem shaders,
    mut Device device,
    mut SoftShadowResolveChannelState channel
){
    if(EnsureShadowResolveStage(layout, selector, shaders, device, s_ShadowResolveWaveletVariant, s_SoftShadowResolveShaderScope, channel.m_wavelet)
        && EnsureShadowResolveStage(layout, selector, shaders, device, s_ShadowResolveUpsampleVariant, s_SoftShadowResolveShaderScope, channel.m_upsample))
        return true;
    error("RendererSystem: failed to create specialized shadow resolve pipeline");
    channel.m_failed = true;
    return false;
}

b8 EnsurePushConstantShadowPipeline(
    mut GraphicsRuntime graphics,
    mut RendererShaderSystem shaderSystem,
    in Func<64u, AssetRef<ComputeShader>(in ShadowSubsystem)> selector,
    in Name debugScope,
    in u32 pushConstantBytes,
    mut BindingLayoutHandle inOutLayout,
    mut ShaderHandle inOutShader,
    mut ComputePipelineHandle inOutPipeline,
    mut b8 outFailed
){
    if(inOutPipeline.valid())
        return true;
    if(outFailed)
        return false;

    if(!EnsurePushConstantComputePipeline<ShadowSubsystem>(
        graphics.getDevice(),
        shaderSystem,
        selector,
        s_ShaderArchiveDefaultVariant,
        debugScope,
        pushConstantBytes,
        false,
        inOutLayout,
        inOutShader,
        inOutPipeline
    )){
        outFailed = true;
        return false;
    }
    return true;
}

b8 EnsureRayQueryShadowPipeline(
    mut GraphicsRuntime graphics,
    mut RendererShaderSystem shaderSystem,
    in Func<64u, AssetRef<ComputeShader>(in ShadowSubsystem)> selector,
    in Name debugName,
    in b8 createBindingLayout,
    in StringView tlasHeapError,
    in StringView pipelineFailError,
    in StringView successInfo,
    mut BindingLayoutHandle shadowBindingLayout,
    mut ShaderHandle outShader,
    mut ComputePipelineHandle outPipeline,
    mut b8 outFailed
){
    if(outPipeline.valid())
        return true;
    if(outFailed)
        return false;
    if(!graphics.queryFeatureSupport(Feature::RayQuery) || !graphics.queryFeatureSupport(Feature::RayTracingAccelStruct)){
        outFailed = true;
        return false;
    }

    mut Device device = graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized() || !heap.hasAccelStructLayout()){
        error("{}", tlasHeapError);
        outFailed = true;
        return false;
    }

    if(createBindingLayout){
        if(!EnsurePushConstantBindingLayout(device, sizeof(ShadowRqSoftPushConstants), ShaderTypeMask::Compute, shadowBindingLayout)){
            error("RendererSystem: failed to create shadow binding layout");
            outFailed = true;
            return false;
        }
    }
    else if(!shadowBindingLayout.valid()){
        error("RendererSystem: shadow binding layout missing for the soft RayQuery pipeline");
        outFailed = true;
        return false;
    }

    if(!shaderSystem.loadShader<ComputeShader, ShadowSubsystem>(selector, s_ShaderArchiveDefaultVariant, debugName, outShader)){
        error("{}", pipelineFailError);
        outFailed = true;
        return false;
    }
    const Expected<ComputePipelineHandle> createdPipeline = CreateHeapComputePipeline(device, outShader, shadowBindingLayout, true);
    if(!createdPipeline.has_value()){
        outPipeline.reset();
        error("{}", pipelineFailError);
        outFailed = true;
        return false;
    }
    outPipeline = createdPipeline.value();
    info("{}", successInfo);
    return true;
}

b8 EnsureSwShadowPassPipeline(
    mut RendererShaderSystem shaderSystem,
    mut GraphicsRuntime graphics,
    in BindingLayoutHandle bindingLayout,
    mut ShaderHandle shader,
    mut ComputePipelineHandle pipeline,
    in Func<64u, AssetRef<ComputeShader>(in ShadowSubsystem)> selector,
    in Name debugLabel
){
    if(pipeline.valid())
        return true;

    if(!shaderSystem.loadShader<ComputeShader, ShadowSubsystem>(selector, s_ShaderArchiveDefaultVariant, debugLabel, shader))
        return false;
    const Expected<ComputePipelineHandle> createdPipeline = CreateHeapComputePipeline(graphics.getDevice(), shader, bindingLayout, false);
    if(!createdPipeline.has_value()){
        pipeline.reset();
        error("RendererSystem: failed to create software shadow compute pipeline");
        return false;
    }
    pipeline = createdPipeline.value();
    return true;
}


b8 ShadowPipelineSet::ensureShadowPipeline(){
    return EnsureRayQueryShadowPipeline(
        this.m_graphics,
        this.m_shaderSystem,
        lambda[](in ShadowSubsystem s) -> AssetRef<ComputeShader>{ return s.shadowRayqueryCs; },
        s_ShadowRayQueryShaderDebugName,
        true,
        "RendererSystem: RayQuery shadows require the descriptor-buffer TLAS heap layout",
        "RendererSystem: failed to create RayQuery shadow compute pipeline",
        "RendererSystem: created RayQuery shadow compute pipeline",
        this.m_shadow.m_shadowBindingLayout,
        this.m_shadow.m_shadowShader,
        this.m_shadow.m_shadowPipeline,
        this.m_shadow.m_shadowPipelineFailed
    );
}

b8 ShadowPipelineSet::ensureShadowSoftPipeline(){
    return EnsureRayQueryShadowPipeline(
        this.m_graphics,
        this.m_shaderSystem,
        lambda[](in ShadowSubsystem s) -> AssetRef<ComputeShader>{ return s.shadowRayquerySoftCs; },
        s_ShadowRayQuerySoftShaderDebugName,
        false,
        "RendererSystem: soft RayQuery shadows require the descriptor-buffer TLAS heap layout",
        "RendererSystem: failed to create RayQuery soft shadow compute pipeline",
        "RendererSystem: created RayQuery soft shadow compute pipeline",
        this.m_shadow.m_shadowBindingLayout,
        this.m_softShadow.m_shadowSoftShader,
        this.m_softShadow.m_shadowSoftPipeline,
        this.m_softShadow.m_shadowSoftPipelineFailed
    );
}

b8 ShadowPipelineSet::ensureSwShadowPipeline(){
    if(this.m_shadow.m_swShadowPipelineFailed)
        return false;

    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        error("RendererSystem: software shadows require the initialized global descriptor heap");
        this.m_shadow.m_swShadowPipelineFailed = true;
        return false;
    }

    if(!this.m_shadow.m_swShadowBindingLayout.valid()){
        if(!EnsurePushConstantBindingLayout(device, sizeof(SwShadowHeapPushConstants), ShaderTypeMask::Compute, this.m_shadow.m_swShadowBindingLayout)){
            error("RendererSystem: failed to create software shadow binding layout");
            this.m_shadow.m_swShadowPipelineFailed = true;
            return false;
        }

        BufferDesc edgeCounterDesc;
        edgeCounterDesc
            .setByteSize(ResolveSoftwareShadowEdgeCounterByteSize(s_ShaderSwEdgeCounterSize))
            .setStructStride(sizeof(u32))
            .setCanHaveUAVs(true)
            .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
            .setDebugName(s_SoftwareShadowEdgeCounter)
            .enableAutomaticStateTracking(ResourceStates::Common)
        ;
        const Expected<BufferHandle> swShadowEdgeCounterBufferResult = this.m_graphics.createBuffer(edgeCounterDesc);
        if(swShadowEdgeCounterBufferResult.has_value())
            this.m_shadow.m_swShadowEdgeCounterBuffer = swShadowEdgeCounterBufferResult.value();
        else
            this.m_shadow.m_swShadowEdgeCounterBuffer.reset();
        if(!swShadowEdgeCounterBufferResult.has_value()){
            error("RendererSystem: failed to create SW shadow edge-counter buffer");
            this.m_shadow.m_swShadowPipelineFailed = true;
            return false;
        }

        BufferDesc indirectArgsDesc;
        indirectArgsDesc
            .setByteSize(ResolveSoftwareShadowIndirectArgsByteSize(s_ShaderSwIndirectArgsWordCount))
            .setStructStride(sizeof(u32))
            .setCanHaveUAVs(true)
            .setIsDrawIndirectArgs(true)
            .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
            .setDebugName(s_SoftwareShadowIndirectArgs)
            .enableAutomaticStateTracking(ResourceStates::Common)
        ;
        const Expected<BufferHandle> swShadowIndirectArgsBufferResult = this.m_graphics.createBuffer(indirectArgsDesc);
        if(swShadowIndirectArgsBufferResult.has_value())
            this.m_shadow.m_swShadowIndirectArgsBuffer = swShadowIndirectArgsBufferResult.value();
        else
            this.m_shadow.m_swShadowIndirectArgsBuffer.reset();
        if(!swShadowIndirectArgsBufferResult.has_value()){
            error("RendererSystem: failed to create SW shadow indirect-args buffer");
            this.m_shadow.m_swShadowPipelineFailed = true;
            return false;
        }
    }

    const b8 heapResourcesReady =
        EnsureHeapBuffer(GpuDescriptorClass::StorageBuffer, true, heap, this.m_shadow.m_swShadowEdgeCounterBuffer.deref(), this.m_shadow.m_swShadowEdgeCounterHeapHandle)
        && EnsureHeapBuffer(GpuDescriptorClass::StorageBuffer, true, heap, this.m_shadow.m_swShadowIndirectArgsBuffer.deref(), this.m_shadow.m_swShadowIndirectArgsHeapHandle)
    ;
    if(!heapResourcesReady){
        error("RendererSystem: failed to register software-shadow work buffers in the descriptor heap");
        this.m_shadow.m_swShadowPipelineFailed = true;
        return false;
    }

    const b8 passesReady =
        EnsureSwShadowPassPipeline(this.m_shaderSystem, this.m_graphics, this.m_shadow.m_swShadowBindingLayout, this.m_shadow.m_swShadowOpaquePrepassShader, this.m_shadow.m_swShadowOpaquePrepassPipeline,
            lambda[](in ShadowSubsystem s) -> AssetRef<ComputeShader>{ return s.swShadowOpaquePrepassCs; }, "ECSRender_SwShadowOpaquePrepass")
        && EnsureSwShadowPassPipeline(this.m_shaderSystem, this.m_graphics, this.m_shadow.m_swShadowBindingLayout, this.m_shadow.m_swShadowSoftOpaqueShader, this.m_shadow.m_swShadowSoftOpaquePipeline,
            lambda[](in ShadowSubsystem s) -> AssetRef<ComputeShader>{ return s.swShadowSoftOpaqueCs; }, "ECSRender_SwShadowSoftOpaque")
        && EnsureSwShadowPassPipeline(this.m_shaderSystem, this.m_graphics, this.m_shadow.m_swShadowBindingLayout, this.m_shadow.m_swShadowTransparentCoarseShader, this.m_shadow.m_swShadowTransparentCoarsePipeline,
            lambda[](in ShadowSubsystem s) -> AssetRef<ComputeShader>{ return s.swShadowTransparentCoarseCs; }, "ECSRender_SwShadowTransparentCoarse")
        && EnsureSwShadowPassPipeline(this.m_shaderSystem, this.m_graphics, this.m_shadow.m_swShadowBindingLayout, this.m_shadow.m_swShadowTransparentResolveShader, this.m_shadow.m_swShadowTransparentResolvePipeline,
            lambda[](in ShadowSubsystem s) -> AssetRef<ComputeShader>{ return s.swShadowTransparentResolveCs; }, "ECSRender_SwShadowTransparentResolve")
        && EnsureSwShadowPassPipeline(this.m_shaderSystem, this.m_graphics, this.m_shadow.m_swShadowBindingLayout, this.m_shadow.m_swShadowTransparentClassifyShader, this.m_shadow.m_swShadowTransparentClassifyPipeline,
            lambda[](in ShadowSubsystem s) -> AssetRef<ComputeShader>{ return s.swShadowTransparentClassifyCs; }, "ECSRender_SwShadowTransparentClassify")
        && EnsureSwShadowPassPipeline(this.m_shaderSystem, this.m_graphics, this.m_shadow.m_swShadowBindingLayout, this.m_shadow.m_swShadowTransparentBuildArgsShader, this.m_shadow.m_swShadowTransparentBuildArgsPipeline,
            lambda[](in ShadowSubsystem s) -> AssetRef<ComputeShader>{ return s.swShadowTransparentBuildargsCs; }, "ECSRender_SwShadowTransparentBuildArgs")
        && EnsureSwShadowPassPipeline(this.m_shaderSystem, this.m_graphics, this.m_shadow.m_swShadowBindingLayout, this.m_shadow.m_swShadowTransparentIndirectShader, this.m_shadow.m_swShadowTransparentIndirectPipeline,
            lambda[](in ShadowSubsystem s) -> AssetRef<ComputeShader>{ return s.swShadowTransparentIndirectCs; }, "ECSRender_SwShadowTransparentIndirect")
        && this.ensureSoftwareTransparentSamplingPipeline()
    ;
    if(!passesReady){
        this.m_shadow.m_swShadowPipelineFailed = true;
        return false;
    }
    return true;
}

b8 ShadowPipelineSet::ensureSoftShadowResolvePipeline(){
    mut SoftShadowResolveState resolve = this.m_shadow.m_softShadowResolve;
    if(resolve.m_scalar.m_wavelet.m_pipeline.valid() && resolve.m_scalar.m_upsample.m_pipeline.valid())
        return true;
    if(resolve.m_scalar.m_failed)
        return false;

    mut Device device = this.m_graphics.getDevice();
    if(!device.getDescriptorHeap().isInitialized())
        return false;
    if(!EnsurePushConstantBindingLayout(device, sizeof(ShadowResolvePushConstants), ShaderTypeMask::Compute, resolve.m_bindingLayout)){
        resolve.m_scalar.m_failed = true;
        return false;
    }
    return EnsureResolveChannel(resolve.m_bindingLayout, lambda[](in ShadowSubsystem s) -> AssetRef<ComputeShader>{ return s.shadowResolveCs; }, this.m_shaderSystem, device, resolve.m_scalar);
}

b8 ShadowPipelineSet::ensureShadowGeometryDownsamplePipeline(){
    return EnsurePushConstantShadowPipeline(
        this.m_graphics,
        this.m_shaderSystem,
        lambda[](in ShadowSubsystem s) -> AssetRef<ComputeShader>{ return s.shadowGeometryDownsampleCs; },
        s_ShadowGeometryDownsampleShaderScope,
        sizeof(ShadowGeometryDownsamplePushConstants),
        this.m_softShadow.m_shadowGeometryDownsampleBindingLayout,
        this.m_softShadow.m_shadowGeometryDownsampleShader,
        this.m_softShadow.m_shadowGeometryDownsamplePipeline,
        this.m_softShadow.m_shadowGeometryDownsamplePipelineFailed
    );
}

b8 ShadowPipelineSet::ensureSoftTransparentResolvePipeline(){
    mut SoftShadowResolveState resolve = this.m_shadow.m_softShadowResolve;
    if(resolve.m_rgb.m_wavelet.m_pipeline.valid() && resolve.m_rgb.m_upsample.m_pipeline.valid())
        return true;
    if(resolve.m_rgb.m_failed || !resolve.m_bindingLayout.valid())
        return false;

    mut Device device = this.m_graphics.getDevice();
    if(!device.getDescriptorHeap().isInitialized())
        return false;
    return EnsureResolveChannel(resolve.m_bindingLayout, lambda[](in ShadowSubsystem s) -> AssetRef<ComputeShader>{ return s.shadowResolveRgbCs; }, this.m_shaderSystem, device, resolve.m_rgb);
}

b8 ShadowPipelineSet::ensureShadowReprojectMergePipeline(){
    return EnsurePushConstantShadowPipeline(
        this.m_graphics,
        this.m_shaderSystem,
        lambda[](in ShadowSubsystem s) -> AssetRef<ComputeShader>{ return s.shadowReprojectMergeCs; },
        s_SoftShadowReprojectMergeShaderScope,
        sizeof(ShadowReprojectMergePushConstants),
        this.m_softShadow.m_shadowReprojectMergeBindingLayout,
        this.m_softShadow.m_shadowReprojectMergeShader,
        this.m_softShadow.m_shadowReprojectMergePipeline,
        this.m_softShadow.m_shadowReprojectMergePipelineFailed
    );
}

void ShadowPipelineSet::prepareSoftCombinedResolvePipelines(){
    if(!CanPrepareSoftCombinedResolvePipelines(this.m_softShadow.m_softShadowReady, this.m_softShadow.m_softTransparentReady))
        return;
    if(!this.ensureSoftCombinedUpsamplePipeline())
        this.m_shadow.m_softShadowResolve.m_combinedUpsampleFailed = true;
    if(!this.ensureSoftCombinedWaveletPipeline())
        this.m_shadow.m_softShadowResolve.m_combinedWaveletFailed = true;
    if(!this.ensureSoftCombinedTemporalPipeline())
        this.m_shadow.m_softShadowResolve.m_combinedTemporalFailed = true;
}

b8 ShadowPipelineSet::ensureSoftwareTransparentSamplingPipeline(){
    mut SoftwareTransparentSamplingState sampling = this.m_shadow.m_softwareTransparentSampling;
    if(sampling.m_pipelines[0].valid() && sampling.m_pipelines[1].valid())
        return true;
    mut Device device = this.m_graphics.getDevice();
    Array<StringView, 2u> variants;
    variants[0u] = s_SwTransparentAdaptiveDisabledVariant;
    variants[1u] = s_SwTransparentAdaptiveEnabledVariant;
    for(u32 index = 0u; index < variants.size(); ++index){
        if(!EnsurePushConstantComputePipeline<ShadowSubsystem>(
            device,
            this.m_shaderSystem,
            lambda[](in ShadowSubsystem s) -> AssetRef<ComputeShader>{ return s.swShadowTransparentSoftCs; },
            variants[index],
            s_SoftwareShadowShaderScope,
            sizeof(SoftwareTransparentSamplingPush),
            false,
            sampling.m_layout,
            sampling.m_shaders[index],
            sampling.m_pipelines[index]
        ))
            return false;
    }
    return true;
}

b8 ShadowPipelineSet::ensureSoftCombinedUpsamplePipeline(){
    mut SoftShadowResolveState resolve = this.m_shadow.m_softShadowResolve;
    if(resolve.m_combinedUpsample.m_pipeline.valid())
        return true;
    if(resolve.m_combinedUpsampleFailed || !resolve.m_bindingLayout.valid())
        return false;
    if(!EnsureShadowResolveStage(
        resolve.m_bindingLayout,
        lambda[](in ShadowSubsystem s) -> AssetRef<ComputeShader>{ return s.shadowResolveCombinedCs; },
        this.m_shaderSystem,
        this.m_graphics.getDevice(),
        s_ShaderArchiveDefaultVariant,
        s_CombinedShadowUpsampleShaderScope,
        resolve.m_combinedUpsample
    )){
        resolve.m_combinedUpsampleFailed = true;
        return false;
    }
    return true;
}

b8 ShadowPipelineSet::ensureSoftCombinedWaveletPipeline(){
    mut SoftShadowResolveState resolve = this.m_shadow.m_softShadowResolve;
    return EnsurePushConstantShadowPipeline(
        this.m_graphics,
        this.m_shaderSystem,
        lambda[](in ShadowSubsystem s) -> AssetRef<ComputeShader>{ return s.shadowResolveWaveletCombinedCs; },
        s_CombinedShadowWaveletShaderScope,
        sizeof(ShadowCombinedWaveletPushConstants),
        resolve.m_combinedWaveletBindingLayout,
        resolve.m_combinedWavelet.m_shader,
        resolve.m_combinedWavelet.m_pipeline,
        resolve.m_combinedWaveletFailed
    );
}

b8 ShadowPipelineSet::ensureSoftCombinedTemporalPipeline(){
    mut SoftShadowResolveState resolve = this.m_shadow.m_softShadowResolve;
    return EnsurePushConstantShadowPipeline(
        this.m_graphics,
        this.m_shaderSystem,
        lambda[](in ShadowSubsystem s) -> AssetRef<ComputeShader>{ return s.shadowReprojectMergeCombinedCs; },
        s_CombinedShadowTemporalShaderScope,
        sizeof(ShadowCombinedTemporalPushConstants),
        resolve.m_combinedTemporalBindingLayout,
        resolve.m_combinedTemporal.m_shader,
        resolve.m_combinedTemporal.m_pipeline,
        resolve.m_combinedTemporalFailed
    );
}


