void VerifyUiLayoutTests_ExhaustedColumnSpaceCollapsesStretchAndClipsFixedOverflow(mut UiLayoutTests self){
    LayoutNodeDesc rootDescription = MakeUiLayoutStretchContainer(LayoutDirection::Column);
    rootDescription.gap = 3.0f;
    const Expected<u32> rootResult = self.add(s_LayoutNoParent, rootDescription);
    ASSERT_TRUE(rootResult.has_value());
    const u32 root = rootResult.value();
    const Expected<u32> fixedResult = self.add(root, MakeUiLayoutFixedLeaf(12.0f, 30.0f));
    ASSERT_TRUE(fixedResult.has_value());
    const u32 fixed = fixedResult.value();
    const Expected<u32> stretchedResult = self.add(root, MakeUiLayoutStretchContainer(LayoutDirection::Leaf));
    ASSERT_TRUE(stretchedResult.has_value());
    const u32 stretched = stretchedResult.value();
    ASSERT_TRUE(self.m_tree.arrange(Rect(0.0f, 0.0f, 20.0f, 17.0f)));
    ASSERT_EQ(self.m_tree.boxes().size(), 3u);
    const Optional<LayoutBox> fixedBox = self.boxCopy(fixed);
    const Optional<LayoutBox> stretchedBox = self.boxCopy(stretched);
    ASSERT_TRUE(fixedBox.has_value());
    ASSERT_TRUE(stretchedBox.has_value());
    ExpectUiLayoutRect(fixedBox.value().rectangle, Rect(0.0f, 0.0f, 12.0f, 30.0f));
    ExpectUiLayoutRect(fixedBox.value().hit, Rect(0.0f, 0.0f, 12.0f, 17.0f));
    ExpectUiLayoutRect(stretchedBox.value().rectangle, Rect(0.0f, 33.0f, 20.0f, 0.0f));
    EXPECT_FLOAT_EQ(stretchedBox.value().hit.height, 0.0f);
}

void VerifyUiLayoutTests_OverlaySizesChildrenIndependentlyAndClipsToPaddedContent(mut UiLayoutTests self){
    LayoutNodeDesc rootDescription = MakeUiLayoutStretchContainer(LayoutDirection::Overlay);
    rootDescription.padding = Insets(2.0f, 3.0f, 4.0f, 5.0f);
    const Expected<u32> rootResult = self.add(s_LayoutNoParent, rootDescription);
    ASSERT_TRUE(rootResult.has_value());
    const u32 root = rootResult.value();
    const Expected<u32> fixedResult = self.add(root, MakeUiLayoutFixedLeaf(70.0f, 80.0f));
    ASSERT_TRUE(fixedResult.has_value());
    const u32 fixed = fixedResult.value();
    const Expected<u32> stretchedResult = self.add(root, MakeUiLayoutStretchContainer(LayoutDirection::Leaf));
    ASSERT_TRUE(stretchedResult.has_value());
    const u32 stretched = stretchedResult.value();
    ASSERT_TRUE(self.m_tree.arrange(Rect(10.0f, 20.0f, 41.0f, 31.0f)));
    ASSERT_EQ(self.m_tree.boxes().size(), 3u);
    const Optional<LayoutBox> fixedBox = self.boxCopy(fixed);
    const Optional<LayoutBox> stretchedBox = self.boxCopy(stretched);
    ASSERT_TRUE(fixedBox.has_value());
    ASSERT_TRUE(stretchedBox.has_value());
    ExpectUiLayoutRect(fixedBox.value().rectangle, Rect(12.0f, 23.0f, 70.0f, 80.0f));
    ExpectUiLayoutRect(fixedBox.value().clip, Rect(12.0f, 23.0f, 35.0f, 23.0f));
    ExpectUiLayoutRect(stretchedBox.value().rectangle, Rect(12.0f, 23.0f, 35.0f, 23.0f));
}

void VerifyUiLayoutTests_UnclippedContainerOverflowStillHonorsViewportAndOuterAncestors(mut UiLayoutTests self){
    const Expected<u32> rootResult = self.add(s_LayoutNoParent, MakeUiLayoutStretchContainer(LayoutDirection::Overlay));
    ASSERT_TRUE(rootResult.has_value());
    const u32 root = rootResult.value();
    LayoutNodeDesc containerDescription = MakeUiLayoutFixedLeaf(20.0f, 15.0f);
    containerDescription.direction = LayoutDirection::Overlay;
    containerDescription.clipChildren = false;
    const Expected<u32> containerResult = self.add(root, containerDescription);
    ASSERT_TRUE(containerResult.has_value());
    const u32 container = containerResult.value();
    const Expected<u32> leafResult = self.add(container, MakeUiLayoutFixedLeaf(80.0f, 70.0f));
    ASSERT_TRUE(leafResult.has_value());
    const u32 leaf = leafResult.value();
    ASSERT_TRUE(self.m_tree.arrange(Rect(5.0f, 7.0f, 43.0f, 31.0f)));
    ASSERT_EQ(self.m_tree.boxes().size(), 3u);
    const Optional<LayoutBox> containerBox = self.boxCopy(container);
    const Optional<LayoutBox> leafBox = self.boxCopy(leaf);
    ASSERT_TRUE(containerBox.has_value());
    ASSERT_TRUE(leafBox.has_value());
    ExpectUiLayoutRect(containerBox.value().hit, Rect(5.0f, 7.0f, 20.0f, 15.0f));
    ExpectUiLayoutRect(leafBox.value().hit, Rect(5.0f, 7.0f, 43.0f, 31.0f));
}

void VerifyUiLayoutTests_FixedAndContentRootSizingRespectsViewportClipping(mut UiLayoutTests self){
    LayoutNodeDesc rootDescription = LayoutNodeDesc();
    rootDescription.direction = LayoutDirection::Overlay;
    rootDescription.width = LayoutSize(LayoutSizePolicy::Fixed, 40.0f);
    rootDescription.padding = Insets(2.0f, 3.0f, 2.0f, 3.0f);
    const Expected<u32> rootResult = self.add(s_LayoutNoParent, rootDescription);
    ASSERT_TRUE(rootResult.has_value());
    const u32 root = rootResult.value();
    ASSERT_TRUE(self.add(root, MakeUiLayoutFixedLeaf(20.0f, 18.0f)).has_value());
    ASSERT_TRUE(self.m_tree.arrange(Rect(3.0f, 4.0f, 31.0f, 17.0f)));
    ASSERT_EQ(self.m_tree.boxes().size(), 2u);
    const Optional<LayoutBox> rootBox = self.boxCopy(root);
    ASSERT_TRUE(rootBox.has_value());
    ExpectUiLayoutRect(rootBox.value().rectangle, Rect(3.0f, 4.0f, 40.0f, 24.0f));
    ExpectUiLayoutRect(rootBox.value().clip, Rect(3.0f, 4.0f, 31.0f, 17.0f));
}

void VerifyUiLayoutTests_OddPhysicalDisplaySizesRemainLogicalAndDoNotRoundStretch(mut UiLayoutTests self){
    const Expected<u32> rootResult = self.add(s_LayoutNoParent, MakeUiLayoutStretchContainer(LayoutDirection::Row));
    ASSERT_TRUE(rootResult.has_value());
    const u32 root = rootResult.value();
    const Expected<u32> firstResult = self.add(root, MakeUiLayoutStretchContainer(LayoutDirection::Leaf));
    ASSERT_TRUE(firstResult.has_value());
    const u32 first = firstResult.value();
    const Expected<u32> secondResult = self.add(root, MakeUiLayoutStretchContainer(LayoutDirection::Leaf));
    ASSERT_TRUE(secondResult.has_value());
    const u32 second = secondResult.value();
    const DisplayMetrics firstMetrics = DisplayMetrics(901.0f / 1.5f, 607.0f / 1.5f, 1.5f, 1.5f);
    ASSERT_TRUE(self.m_tree.arrange(Rect(0.0f, 0.0f, firstMetrics.logicalWidth, firstMetrics.logicalHeight)));
    ASSERT_EQ(self.m_tree.boxes().size(), 3u);
    const Optional<LayoutBox> firstBoxOpt = self.boxCopy(first);
    const Optional<LayoutBox> secondBoxOpt = self.boxCopy(second);
    ASSERT_TRUE(firstBoxOpt.has_value());
    ASSERT_TRUE(secondBoxOpt.has_value());
    const Rect firstBefore = firstBoxOpt.value().rectangle;
    const Rect secondBefore = secondBoxOpt.value().rectangle;
    EXPECT_FLOAT_EQ(firstBefore.width, firstMetrics.logicalWidth * 0.5f);
    EXPECT_FLOAT_EQ(secondBefore.x + secondBefore.width, firstMetrics.logicalWidth);
    const DisplayMetrics secondMetrics = DisplayMetrics(firstMetrics.logicalWidth, firstMetrics.logicalHeight, 2.0f, 1.25f);
    ASSERT_TRUE(self.m_tree.arrange(Rect(0.0f, 0.0f, secondMetrics.logicalWidth, secondMetrics.logicalHeight)));
    const Optional<LayoutBox> firstAfter = self.boxCopy(first);
    const Optional<LayoutBox> secondAfter = self.boxCopy(second);
    ASSERT_TRUE(firstAfter.has_value());
    ASSERT_TRUE(secondAfter.has_value());
    ExpectUiLayoutRect(firstAfter.value().rectangle, firstBefore);
    ExpectUiLayoutRect(secondAfter.value().rectangle, secondBefore);
}

void VerifyUiLayoutTests_OversizedPaddingAndEmptyViewportProduceFiniteEmptyContentAndHit(mut UiLayoutTests self){
    LayoutNodeDesc description = MakeUiLayoutStretchContainer(LayoutDirection::Overlay);
    description.padding = Insets(100.0f, 100.0f, 100.0f, 100.0f);
    const Expected<u32> rootResult = self.add(s_LayoutNoParent, description);
    ASSERT_TRUE(rootResult.has_value());
    const u32 root = rootResult.value();
    const Expected<u32> leafResult = self.add(root, MakeUiLayoutStretchContainer(LayoutDirection::Leaf));
    ASSERT_TRUE(leafResult.has_value());
    const u32 leaf = leafResult.value();
    ASSERT_TRUE(self.m_tree.arrange(Rect(7.0f, 11.0f, 5.0f, 3.0f)));
    ASSERT_EQ(self.m_tree.boxes().size(), 2u);
    const Optional<LayoutBox> rootBox = self.boxCopy(root);
    const Optional<LayoutBox> leafBox = self.boxCopy(leaf);
    ASSERT_TRUE(rootBox.has_value());
    ASSERT_TRUE(leafBox.has_value());
    ExpectUiLayoutRect(rootBox.value().content, Rect(12.0f, 14.0f, 0.0f, 0.0f));
    ExpectUiLayoutRect(leafBox.value().hit, Rect(12.0f, 14.0f, 0.0f, 0.0f));
    ASSERT_TRUE(self.m_tree.arrange(Rect(7.0f, 11.0f, 0.0f, 0.0f)));
    const Optional<LayoutBox> emptyRootBox = self.boxCopy(root);
    ASSERT_TRUE(emptyRootBox.has_value());
    ExpectUiLayoutRect(emptyRootBox.value().hit, Rect(7.0f, 11.0f, 0.0f, 0.0f));
}

void VerifyUiLayoutTests_InvalidViewportOrOverflowCannotPublishPartialBoxes(mut UiLayoutTests self){
    ASSERT_TRUE(self.add(s_LayoutNoParent, MakeUiLayoutStretchContainer(LayoutDirection::Overlay)).has_value());
    ASSERT_TRUE(self.m_tree.arrange(Rect(1.0f, 2.0f, 31.0f, 17.0f)));
    const usize published = self.boxAddress(0u);
    ASSERT_NE(published, 0u);
    const Optional<LayoutBox> publishedCopy = self.boxCopy(0u);
    ASSERT_TRUE(publishedCopy.has_value());
    const Rect before = publishedCopy.value().rectangle;
    EXPECT_FALSE(self.m_tree.arrange(Rect(0.0f, 0.0f, -1.0f, 10.0f)));
    EXPECT_FALSE(self.m_tree.arrange(Rect(UiInputLayoutQuietNaNF32(), 0.0f, 1.0f, 1.0f)));
    EXPECT_FALSE(self.m_tree.arrange(Rect(0.0f, 0.0f, UiInputLayoutInfinityF32(), 1.0f)));
    EXPECT_EQ(self.boxAddress(0u), published);
    const Optional<LayoutBox> afterInvalidViewport = self.boxCopy(0u);
    ASSERT_TRUE(afterInvalidViewport.has_value());
    ExpectUiLayoutRect(afterInvalidViewport.value().rectangle, before);
    self.m_tree.reset();
    const Expected<u32> rootResult = self.add(s_LayoutNoParent, MakeUiLayoutStretchContainer(LayoutDirection::Row));
    ASSERT_TRUE(rootResult.has_value());
    const u32 root = rootResult.value();
    ASSERT_TRUE(self.add(root, MakeUiLayoutFixedLeaf(f32.max * 0.75f, 1.0f)).has_value());
    ASSERT_TRUE(self.add(root, MakeUiLayoutFixedLeaf(f32.max * 0.75f, 1.0f)).has_value());
    EXPECT_FALSE(self.m_tree.arrange(Rect(0.0f, 0.0f, 31.0f, 17.0f)));
    EXPECT_EQ(self.m_tree.boxes().size(), 1u);
    EXPECT_EQ(self.boxAddress(0u), published);
    const Optional<LayoutBox> afterRowOverflow = self.boxCopy(0u);
    ASSERT_TRUE(afterRowOverflow.has_value());
    ExpectUiLayoutRect(afterRowOverflow.value().rectangle, before);
    self.m_tree.reset();
    ASSERT_TRUE(self.add(s_LayoutNoParent, MakeUiLayoutFixedLeaf(f32.max * 0.75f, 10.0f)).has_value());
    EXPECT_FALSE(self.m_tree.arrange(Rect(f32.max, 0.0f, 0.0f, 0.0f)));
    EXPECT_EQ(self.boxAddress(0u), published);
}

void VerifyUiLayoutTests_InvalidConstructionPoisonsTheBuildUntilResetAndPreservesPublishedOutput(mut UiLayoutTests self){
    ASSERT_TRUE(self.add(s_LayoutNoParent, MakeUiLayoutStretchContainer(LayoutDirection::Overlay)).has_value());
    ASSERT_TRUE(self.m_tree.arrange(Rect(0.0f, 0.0f, 21.0f, 13.0f)));
    const usize published = self.boxAddress(0u);
    EXPECT_FALSE(self.m_tree.addNode(s_LayoutNoParent, MakeUiLayoutFixedLeaf(1.0f, 1.0f)).has_value());
    EXPECT_FALSE(self.m_tree.arrange(Rect(0.0f, 0.0f, 41.0f, 37.0f)));
    EXPECT_EQ(self.boxAddress(0u), published);
    self.m_tree.reset();
    EXPECT_FALSE(self.m_tree.addNode(0u, MakeUiLayoutFixedLeaf(1.0f, 1.0f)).has_value());
    EXPECT_FALSE(self.m_tree.addNode(s_LayoutNoParent, MakeUiLayoutFixedLeaf(1.0f, 1.0f)).has_value());
    self.m_tree.reset();
    const Expected<u32> leafResult = self.add(s_LayoutNoParent, MakeUiLayoutFixedLeaf(1.0f, 1.0f));
    ASSERT_TRUE(leafResult.has_value());
    const u32 leaf = leafResult.value();
    EXPECT_FALSE(self.m_tree.addNode(leaf, MakeUiLayoutFixedLeaf(1.0f, 1.0f)).has_value());
    EXPECT_FALSE(self.m_tree.arrange(Rect(0.0f, 0.0f, 1.0f, 1.0f)));
    self.m_tree.reset();
    const Expected<u32> rootResult = self.add(s_LayoutNoParent, MakeUiLayoutStretchContainer(LayoutDirection::Overlay));
    ASSERT_TRUE(rootResult.has_value());
    const u32 root = rootResult.value();
    EXPECT_FALSE(self.m_tree.addNode(root + 1u, MakeUiLayoutFixedLeaf(1.0f, 1.0f)).has_value());
    EXPECT_EQ(self.boxAddress(0u), published);
    self.m_tree.reset();
    ASSERT_TRUE(self.add(s_LayoutNoParent, MakeUiLayoutFixedLeaf(7.0f, 9.0f)).has_value());
    ASSERT_TRUE(self.m_tree.arrange(Rect(3.0f, 4.0f, 21.0f, 13.0f)));
    const Optional<LayoutBox> finalBox = self.boxCopy(0u);
    ASSERT_TRUE(finalBox.has_value());
    ExpectUiLayoutRect(finalBox.value().rectangle, Rect(3.0f, 4.0f, 7.0f, 9.0f));
}

void VerifyUiLayoutTests_InvalidDescriptionsAndBoundedCapacityRejectNodeAdmission(mut UiLayoutTests self){
    LayoutNodeDesc invalid = LayoutNodeDesc();
    Array<LayoutNodeDesc, 7u> invalidDescriptions = Array<LayoutNodeDesc, 7u>();
    invalidDescriptions[0u].width = LayoutSize(LayoutSizePolicy::Stretch, 0.0f);
    invalidDescriptions[1u].width = LayoutSize(LayoutSizePolicy::Fixed, -1.0f);
    invalidDescriptions[2u].height = LayoutSize(LayoutSizePolicy::Content, UiInputLayoutQuietNaNF32());
    invalidDescriptions[3u].padding = Insets(0.0f, -1.0f, 0.0f, 0.0f);
    invalidDescriptions[4u].gap = UiInputLayoutInfinityF32();
    invalidDescriptions[5u].intrinsicSize = Point(0.0f, -1.0f);
    invalidDescriptions[6u].direction = bit_cast<LayoutDirectionEnum>(u8(255u));
    for(in LayoutNodeDesc description : invalidDescriptions){
        self.m_tree.reset();
        EXPECT_FALSE(self.m_tree.addNode(s_LayoutNoParent, description).has_value());
        EXPECT_EQ(self.m_tree.nodeCount(), 0u);
        EXPECT_FALSE(self.m_tree.arrange(Rect(0.0f, 0.0f, 31.0f, 17.0f)));
    }
    LayoutTree bounded = LayoutTree(self.m_arena, 2u);
    const Expected<u32> admittedNode = bounded.addNode(s_LayoutNoParent, MakeUiLayoutStretchContainer(LayoutDirection::Overlay));
    ASSERT_TRUE(admittedNode.has_value());
    const u32 root = admittedNode.value();
    ASSERT_TRUE(bounded.addNode(root, MakeUiLayoutFixedLeaf(1.0f, 1.0f)).has_value());
    ASSERT_TRUE(bounded.arrange(Rect(0.0f, 0.0f, 31.0f, 17.0f)));
    const usize published = UiLayoutTreeBoxAddress(bounded, root);
    EXPECT_FALSE(bounded.addNode(root, MakeUiLayoutFixedLeaf(1.0f, 1.0f)).has_value());
    EXPECT_FALSE(bounded.arrange(Rect(0.0f, 0.0f, 31.0f, 17.0f)));
    EXPECT_EQ(UiLayoutTreeBoxAddress(bounded, root), published);
    LayoutTree empty = LayoutTree(self.m_arena, 0u);
    EXPECT_FALSE(empty.addNode(s_LayoutNoParent, invalid).has_value());
}

void VerifyUiLayoutTests_MaximumDepthArrangesWithoutRecursionAndRejectsFurtherNodes(mut UiLayoutTests self){
    u32 parent = s_LayoutNoParent;
    for(u32 index = 0u; index < s_LayoutMaxNodes; ++index){
        const Expected<u32> next = self.add(parent, MakeUiLayoutStretchContainer(LayoutDirection::Overlay));
        ASSERT_TRUE(next.has_value());
        parent = next.value();
    }
    ASSERT_EQ(self.m_tree.nodeCount(), s_LayoutMaxNodes);
    ASSERT_TRUE(self.m_tree.arrange(Rect(3.0f, 5.0f, 101.0f, 79.0f)));
    ASSERT_EQ(self.m_tree.boxes().size(), s_LayoutMaxNodes);
    const Optional<LayoutBox> deepestBox = self.boxCopy(parent);
    ASSERT_TRUE(deepestBox.has_value());
    ExpectUiLayoutRect(deepestBox.value().rectangle, Rect(3.0f, 5.0f, 101.0f, 79.0f));
    EXPECT_FALSE(self.m_tree.addNode(parent, MakeUiLayoutFixedLeaf(1.0f, 1.0f)).has_value());
}


