const StringView s_DoesNotTargetADeclaredAsset = "does not target a declared asset";
const StringView s_BunchOwnershipMetadata = "\nmetadata local = { \"label\": \"a separately owned metadata string\", \"items\": [1, 2, 3] };\nprobe first;\nprobe second;\nfirst.local = local;\nfirst.target = second;\nsecond.items = [local, { \"target\": first }];\nasset_bunch bunch = [second, first];\n";
const StringView s_ModifiedSamplerCacheMetadata = "sampler asset;\nasset.min_filter = \"linear\";\nasset.mag_filter = \"linear\";\nasset.mip_filter = \"linear\";\nasset.address_u = \"wrap\";\nasset.address_v = \"wrap\";\nasset.address_w = \"wrap\";\nasset.reduction = \"standard\";\nasset.max_anisotropy = 1.0;\nasset.mip_bias = 3.5;\n";
const Array<usize, 2u> s_BunchUnusedDeclarationCounts(0u, 32u);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class BunchCallerFailure{}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanExpandFixtureBunch(mut BunchFixture fixture){
    return ExpandFixtureAssetBunch(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, fixture.document, fixture.scratchArena).has_value();
}

Expected<ExpandedAssetMetadataVector> ExpandBunchWithScratch(in GraphicsTestPath assetRoot, in StringView virtualRoot, in GraphicsTestPath filePath, in MetaDocument document, mut GraphicsScratchArena scratch){
    return ExpandAssetBunch(Path(assetRoot), virtualRoot, Path(filePath), document, scratch.arena);
}

Expected<AssetBunchExpandFailureEnum> TryBunchExpandFailure(mut BunchFixture fixture){
    const AssetBunchExpandContext context(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, fixture.document, fixture.scratchArena);
    const auto result = TryAutoCollectedAssetBunchExpanders(context);
    if(result.has_value())
        return MakeUnexpected(Failure());
    return result.error();
}

Expected<ExpandedAssetMetadataVector> ExpandRegisteredBunch(mut BunchFixture fixture){
    const AssetBunchExpandContext context(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, fixture.document, fixture.scratchArena);
    const auto result = TryAutoCollectedAssetBunchExpanders(context);
    if(!result.has_value())
        return MakeUnexpected(Failure());
    return result.value();
}

void PrepareCacheRecordHelper(in GraphicsTestPath root, in DiscoveredNwbFile discovered, in StringView metadataText, in Sha256Digest producer, mut GraphicsScratchArena scratch, mut ScratchString sourcePath, mut ScratchString cacheName, mut NwbFileAssetCacheRecord outRecord){
    PrepareGraphicsCacheRecord(JoinGraphicsPath(root, s_CacheDirectory), discovered, metadataText, producer, scratch.arena, sourcePath, cacheName, outRecord);
}

usize CountNwbaFilesInDirectory(in GraphicsTestPath directory){
    const auto entries = RecursiveDirectoryIteratorCreate(Path(directory));
    if(!entries.has_value())
        return usize.max;
    usize count = 0u;
    for(in DirectoryEntry entry : entries.value()){
        const auto regular = entry.isRegularFile();
        if(!regular.has_value())
            return usize.max;
        if(regular.value() && StringView(PathToString(entry.path().extensionView())) == s_BuiltAssetExtension)
            ++count;
    }
    return count;
}

void VerifyAssetBunchOwnership_ClearReplacementAndDestructionReleaseAllResolvedValues(){
    BunchFixture fixture = BunchFixture();
    ASSERT_TRUE(fixture.document.parse(s_BunchOwnershipMetadata));
    const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
    {
        ExpandedAssetMetadataVector output(fixture.scratchArena);
        for(usize iteration = 0u; iteration < 8u; ++iteration){
            {
                Expected<ExpandedAssetMetadataVector> expandedResult = ExpandFixtureAssetBunch(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, fixture.document, fixture.scratchArena);
                ASSERT_TRUE(expandedResult.has_value());
                output = expandedResult.value();
            }
            VerifyOwnedBunchOutput(output, fixture.document);
            const ArenaMemoryStats liveMetadata = fixture.metadataArena.memoryStats();
            EXPECT_GT(liveMetadata.usedBytes, baselineMetadata.usedBytes);
            {
                Expected<ExpandedAssetMetadataVector> expandedResult = ExpandFixtureAssetBunch(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, fixture.document, fixture.scratchArena);
                ASSERT_TRUE(expandedResult.has_value());
                output = expandedResult.value();
            }
            VerifyOwnedBunchOutput(output, fixture.document);
            EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, liveMetadata.usedBytes);
            output.clear();
            EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
        }
        {
            Expected<ExpandedAssetMetadataVector> expandedResult = ExpandFixtureAssetBunch(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, fixture.document, fixture.scratchArena);
            ASSERT_TRUE(expandedResult.has_value());
            output = expandedResult.value();
        }
        VerifyOwnedBunchOutput(output, fixture.document);
    }
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
}

void VerifyAssetBunchOwnership_OutputMoveAndGrowthPreserveValuesUntilTheirFinalOwnerDies(){
    BunchFixture fixture = BunchFixture();
    ASSERT_TRUE(fixture.document.parse(s_BunchOwnershipMetadata));
    const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
    {
        ExpandedAssetMetadataVector source(fixture.scratchArena);
        {
            Expected<ExpandedAssetMetadataVector> expandedResult = ExpandFixtureAssetBunch(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, fixture.document, fixture.scratchArena);
            ASSERT_TRUE(expandedResult.has_value());
            source = expandedResult.value();
        }
        ExpandedAssetMetadataVector destination(fixture.scratchArena);
        destination = source;
        destination.reserve(destination.capacity() + 37u);
        VerifyOwnedBunchOutput(destination, fixture.document);
        destination[1u].value.field(s_BunchLocal).field(s_BunchLabel).setString("changed output");
        ASSERT_TRUE(HasMetaVariable(fixture.document, s_BunchLocal));
        ASSERT_TRUE(HasMetaField(GetMetaVariable(fixture.document, s_BunchLocal), s_BunchLabel));
        EXPECT_EQ(GetMetaField(GetMetaVariable(fixture.document, s_BunchLocal), s_BunchLabel).asString(), s_ASeparatelyOwnedMetadataString);
    }
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
}

void VerifyAssetBunchOwnership_LongExportAndReferencePathsReclaimScopedResultsAndReuseCallerScratch(){
    Vector<usize> unusedCounts = Vector<usize>();
    unusedCounts.reserve(2u);
    unusedCounts.push_back(0u);
    unusedCounts.push_back(17u);

    for(in usize unusedDeclarations : unusedCounts){
        BunchFixture fixture = BunchFixture();
        MetaString firstVariable("first_", fixture.metadataArena);
        firstVariable.append(192u, 97u);
        MetaString secondVariable("second_", fixture.metadataArena);
        secondVariable.append(224u, 98u);
        MetaString rootText(fixture.metadataArena);
        rootText.append(256u, 114u);

        String source = StringFormat(
            "probe {};\r\nprobe {};\r\n{}.target = {};\r\n{}.nested = [{{ \"target\": {} }}];\r\nasset_bunch bunch = [{}, {}];\r\n"
            , StringView(firstVariable)
            , StringView(secondVariable)
            , StringView(firstVariable)
            , StringView(secondVariable)
            , StringView(secondVariable)
            , StringView(firstVariable)
            , StringView(secondVariable)
            , StringView(firstVariable)
        );
        for(usize index = 0u; index < unusedDeclarations; ++index)
            GraphicsStringAppendFormat(source, "metadata unused_{};\r\n", index);
        ASSERT_TRUE(fixture.document.parse(source));

        const GraphicsTestPath filePath = JoinGraphicsPath(fixture.assetRoot, "bundle.nwb");
        const String formattedFirst = StringFormat("{}/bundle/{}", StringView(rootText), StringView(firstVariable));
        const String formattedSecond = StringFormat("{}/bundle/{}", StringView(rootText), StringView(secondVariable));
        const Expected<Name> firstIdentityResult = ParseName(formattedFirst);
        ASSERT_TRUE(firstIdentityResult.has_value());
        const Name firstIdentity = firstIdentityResult.value();
        const Expected<Name> secondIdentityResult = ParseName(formattedSecond);
        ASSERT_TRUE(secondIdentityResult.has_value());
        const Name secondIdentity = secondIdentityResult.value();
        const StringView virtualRoot = StringView(rootText);

        const ArenaMemoryStats retainedMetadata = fixture.metadataArena.memoryStats();

        GraphicsScratchArena scratch = GraphicsScratchArena(s_AssetCaseTestsAssetBunchLongPathScratch, 65536u);
        ScratchPattern sentinel(scratch, 32u, 73u);
        ASSERT_TRUE(sentinel.valid());
        const ArenaMemoryStats baselineScratch = scratch.arena.memoryStats();
        ArenaMemoryStats warm = ArenaMemoryStats();
        const StringView virtualRootView = virtualRoot;
        const StringView firstPathView = formattedFirst;
        const StringView secondPathView = formattedSecond;
        for(usize iteration = 0u; iteration < 16u; ++iteration){
            {
                Expected<ExpandedAssetMetadataVector> expandedResult = ExpandBunchWithScratch(fixture.assetRoot, virtualRootView, filePath, fixture.document, scratch);
                ASSERT_TRUE(expandedResult.has_value());
                in ExpandedAssetMetadataVector output = expandedResult.value();
                ASSERT_EQ(output.size(), 2u);
                EXPECT_EQ(output[0u].virtualPath, secondIdentity);
                EXPECT_EQ(output[1u].virtualPath, firstIdentity);
                ASSERT_TRUE(HasMetaField(output[0u].value, "nested"));
                ASSERT_TRUE(GetMetaField(output[0u].value, "nested").isList());
                ASSERT_EQ(GetMetaField(output[0u].value, "nested").listView().size(), 1u);
                ASSERT_TRUE(HasMetaField(GetMetaField(output[0u].value, "nested").listView()[0u], s_FieldTarget));
                ASSERT_TRUE(GetMetaField(GetMetaField(output[0u].value, "nested").listView()[0u], s_FieldTarget).isString());
                EXPECT_EQ(GetMetaField(GetMetaField(output[0u].value, "nested").listView()[0u], s_FieldTarget).asString(), firstPathView);
                ASSERT_TRUE(HasMetaField(output[1u].value, s_FieldTarget));
                ASSERT_TRUE(GetMetaField(output[1u].value, s_FieldTarget).isString());
                EXPECT_EQ(GetMetaField(output[1u].value, s_FieldTarget).asString(), secondPathView);
            }
            EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, retainedMetadata.usedBytes);
            EXPECT_TRUE(sentinel.intact());
            const ArenaMemoryStats current = scratch.arena.memoryStats();
            EXPECT_EQ(current.usedBytes, baselineScratch.usedBytes);
            if(iteration == 0u)
                warm = current;
            else{
                EXPECT_EQ(current.usedBytes, warm.usedBytes);
                EXPECT_EQ(current.reservedBytes, warm.reservedBytes);
            }
        }
        sentinel.release();
    }
}

void VerifyAssetBunchOwnership_ValuesOutliveTheirSourceDocumentWhileItsArenaRemainsAlive(){
    BunchFixture fixture = BunchFixture();
    const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
    {
        ExpandedAssetMetadataVector output(fixture.scratchArena);
        {
            MetaDocument sourceDocument(fixture.metadataArena);
            ASSERT_TRUE(sourceDocument.parse(s_BunchOwnershipMetadata));
            {
                Expected<ExpandedAssetMetadataVector> expandedResult = ExpandFixtureAssetBunch(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, sourceDocument, fixture.scratchArena);
                ASSERT_TRUE(expandedResult.has_value());
                output = expandedResult.value();
            }
            VerifyOwnedBunchOutput(output, sourceDocument);
        }
        ASSERT_EQ(output.size(), 2u);
        ASSERT_TRUE(HasMetaField(output[0u].value, s_BunchItemsField));
        ASSERT_TRUE(GetMetaField(output[0u].value, s_BunchItemsField).isList());
        ASSERT_EQ(GetMetaField(output[0u].value, s_BunchItemsField).listView().size(), 2u);
        ASSERT_TRUE(HasMetaField(GetMetaField(output[0u].value, s_BunchItemsField).listView()[0u], s_BunchLabel));
        EXPECT_EQ(GetMetaField(GetMetaField(output[0u].value, s_BunchItemsField).listView()[0u], s_BunchLabel).asString(), s_ASeparatelyOwnedMetadataString);
        ASSERT_TRUE(HasMetaField(GetMetaField(output[0u].value, s_BunchItemsField).listView()[1u], s_FieldTarget));
        EXPECT_EQ(GetMetaField(GetMetaField(output[0u].value, s_BunchItemsField).listView()[1u], s_FieldTarget).asString(), s_ProjectFixturesBundleFirst);
    }
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
}

[cpp_unwind]
void VerifyAssetBunchOwnership_CallerUnwindDestroysEveryPublishedResolvedValue(){
    BunchFixture fixture = BunchFixture();
    ASSERT_TRUE(fixture.document.parse(s_BunchOwnershipMetadata));
    const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
    EXPECT_TRUE(ThrowsException<BunchCallerFailure>(lambda[mut fixture]() -> void{
        ExpandedAssetMetadataVector output(fixture.scratchArena);
        {
            auto expanded = ExpandFixtureAssetBunch(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, fixture.document, fixture.scratchArena);
            ASSERT_TRUE(expanded.has_value());
            output = expanded.value();
        }
        VerifyOwnedBunchOutput(output, fixture.document);
        ThrowTestException<BunchCallerFailure>(BunchCallerFailure());
    }));
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
}

void VerifyAssetBunchOwnership_FailedLaterLocalCycleReleasesTheUnpublishedValueAndPriorOutput(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration(logger, LoggerBreakPolicy::BreakOnFatal);
    BunchFixture fixture = BunchFixture();
    ASSERT_TRUE(fixture.document.parse("\nmetadata loop_a;\nmetadata loop_b;\nloop_a = { \"copied\": [1, 2, 3], \"next\": loop_b };\nloop_b = { \"next\": loop_a };\nprobe first = { \"owned\": \"first output remains valid on failure\" };\nprobe second = [ { \"copied\": [4, 5, 6] }, loop_a ];\nasset_bunch bunch = [first, second];\n"));
    const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
    for(usize iteration = 0u; iteration < 9u; ++iteration){
        EXPECT_FALSE(CanExpandFixtureBunch(fixture));
        EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
    }
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
    EXPECT_TRUE(SawCapturedError(logger, "cyclic local metadata reference"));
}

void VerifyAssetBunchOwnership_MissingLaterReferenceReleasesPartialNestedCollections(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration(logger, LoggerBreakPolicy::BreakOnFatal);
    BunchFixture fixture = BunchFixture();
    ASSERT_TRUE(fixture.document.parse("\nmetadata known;\nprobe first = { \"items\": [\"copied string\", 1, 2] };\nprobe second = [ { \"copied\": [4, 5, 6] }, known.missing ];\nasset_bunch bunch = [first, second];\n"));
    const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
    EXPECT_FALSE(CanExpandFixtureBunch(fixture));
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
    EXPECT_TRUE(SawCapturedError(logger, s_DoesNotTargetADeclaredAsset));
}

void VerifyAssetBunchOwnership_RegisteredExpanderDistinguishesUnsupportedDocumentsFromExpansionErrors(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration(logger, LoggerBreakPolicy::BreakOnFatal);
    BunchFixture fixture = BunchFixture();
    ASSERT_TRUE(fixture.document.parse("probe first;"));
    const Expected<AssetBunchExpandFailureEnum> unsupported = TryBunchExpandFailure(fixture);
    ASSERT_TRUE(unsupported.has_value());
    EXPECT_EQ(unsupported.value(), AssetBunchExpandFailure::Unsupported);
    EXPECT_EQ(logger.errorCount(), 0u);

    ASSERT_TRUE(fixture.document.parse("asset_bunch bunch = [];"));
    const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
    const Expected<AssetBunchExpandFailureEnum> failed = TryBunchExpandFailure(fixture);
    ASSERT_TRUE(failed.has_value());
    EXPECT_EQ(failed.value(), AssetBunchExpandFailure::Error);
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
    EXPECT_TRUE(SawCapturedError(logger, "list must contain at least one asset"));
}

void VerifyAssetBunchOwnership_RegisteredExpanderTransfersValuesToTheModelParserWithoutBorrowedLifetime(){
    BunchFixture fixture = BunchFixture();
    ASSERT_TRUE(fixture.document.parse("\nmetadata rig = { \"skeleton\": \"project/shared/skeleton\" };\nmodel model;\nmodel.skeletons = { \"rig\": rig };\nasset_bunch bunch = [model];\n"));
    const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
    ModelCookEntry entry(fixture.outputArena);
    {
        ExpandedAssetMetadataVector output(fixture.scratchArena);
        {
            Expected<ExpandedAssetMetadataVector> expandedResult = ExpandRegisteredBunch(fixture);
            ASSERT_TRUE(expandedResult.has_value());
            output = expandedResult.value();
        }
        ASSERT_EQ(output.size(), 1u);
        Expected<ModelCookEntry> entryParseResult = ParseModelCookMetadata(output[0u].virtualPath, fixture.filePath, output[0u].value);
        ASSERT_TRUE(entryParseResult.has_value());
        entry = entryParseResult.value();
    }
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
    ASSERT_EQ(entry.skeletonObjects.size(), 1u);
    EXPECT_EQ(entry.skeletonObjects[0u].name, Name("rig"));
    EXPECT_EQ(entry.skeletonObjects[0u].skeleton.name(), Name("project/shared/skeleton"));
}

void VerifyAssetBunchOwnership_NullValueReachesTheTypeParserAndKeepsItsRejectionContract(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration(logger, LoggerBreakPolicy::BreakOnFatal);
    BunchFixture fixture = BunchFixture();
    ASSERT_TRUE(fixture.document.parse("model model; asset_bunch bunch = [model];"));
    const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
    {
        ExpandedAssetMetadataVector output(fixture.scratchArena);
        {
            Expected<ExpandedAssetMetadataVector> expandedResult = ExpandRegisteredBunch(fixture);
            ASSERT_TRUE(expandedResult.has_value());
            output = expandedResult.value();
        }
        ASSERT_EQ(output.size(), 1u);
        EXPECT_TRUE(output[0u].value.isNull());
        EXPECT_FALSE(ParseModelCookMetadata(output[0u].virtualPath, fixture.filePath, output[0u].value).has_value());
    }
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
    EXPECT_TRUE(SawCapturedError(logger, "asset is not a map"));
}

void VerifyAssetBunchLookup_ExactCaseReferencesPreserveExportAndRepeatedLocalValueOrder(){
    Vector<usize> unusedCounts = Vector<usize>();
    unusedCounts.reserve(4u);
    unusedCounts.push_back(0u);
    unusedCounts.push_back(11u);
    unusedCounts.push_back(12u);
    unusedCounts.push_back(32u);

    Array<i64, 3> expectedIds = Array<i64, 3>();
    expectedIds[0u] = 11;
    expectedIds[1u] = 22;
    expectedIds[2u] = 11;

    const StringView metadata = "\nmetadata Local = { \"id\": 11 };\nmetadata local = { \"id\": 22 };\nprobe first = { \"values\": [Local, local, Local] };\nprobe second = { \"values\": [local] };\nASSET_BUNCH bunch = [second, first];\n";
    for(in usize unusedDeclarations : unusedCounts){
        BunchFixture fixture = BunchFixture();
        ASSERT_TRUE(ParseBunchLookupFixture(metadata, unusedDeclarations, fixture));
        const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
        {
            ExpandedAssetMetadataVector output(fixture.scratchArena);
            {
                Expected<ExpandedAssetMetadataVector> expandedResult = ExpandFixtureAssetBunch(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, fixture.document, fixture.scratchArena);
                ASSERT_TRUE(expandedResult.has_value());
                output = expandedResult.value();
            }
            ASSERT_EQ(output.size(), 2u);
            EXPECT_EQ(output[0u].virtualPath, Name("project/fixtures/bundle/second"));
            EXPECT_EQ(output[1u].virtualPath, Name(s_ProjectFixturesBundleFirst));
            ASSERT_TRUE(HasMetaField(output[1u].value, s_BunchValuesField));
            ASSERT_TRUE(GetMetaField(output[1u].value, s_BunchValuesField).isList());
            ASSERT_EQ(GetMetaField(output[1u].value, s_BunchValuesField).listView().size(), 3u);
            for(usize index = 0u; index < expectedIds.size(); ++index){
                ASSERT_TRUE(HasMetaField(GetMetaField(output[1u].value, s_BunchValuesField).listView()[index], s_BunchIdField));
                EXPECT_EQ(GetMetaField(GetMetaField(output[1u].value, s_BunchValuesField).listView()[index], s_BunchIdField).asInteger(), expectedIds[index]);
            }
            ASSERT_TRUE(HasMetaField(output[0u].value, s_BunchValuesField));
            ASSERT_TRUE(GetMetaField(output[0u].value, s_BunchValuesField).isList());
            ASSERT_EQ(GetMetaField(output[0u].value, s_BunchValuesField).listView().size(), 1u);
            ASSERT_TRUE(HasMetaField(GetMetaField(output[0u].value, s_BunchValuesField).listView()[0u], s_BunchIdField));
            EXPECT_EQ(GetMetaField(GetMetaField(output[0u].value, s_BunchValuesField).listView()[0u], s_BunchIdField).asInteger(), 22);
            output.clear();
        }
        EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
    }
}

void ExpectBunchLookupFailure(in usize unusedDeclarations, in StringView metadata, in StringView expectedDiagnostic, in StringView unexpectedDiagnostic){
    CapturingLogger logger;
    LoggerRegistrationGuard registration(logger, LoggerBreakPolicy::BreakOnFatal);
    BunchFixture fixture;
    ASSERT_TRUE(ParseBunchLookupFixture(metadata, unusedDeclarations, fixture));
    const ArenaMemoryStats baseline = fixture.metadataArena.memoryStats();
    EXPECT_FALSE(CanExpandFixtureBunch(fixture));
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baseline.usedBytes);
    EXPECT_EQ(logger.errorCount(), 1u);
    EXPECT_TRUE(SawCapturedError(logger, expectedDiagnostic));
    if(!unexpectedDiagnostic.empty())
        EXPECT_FALSE(SawCapturedError(logger, unexpectedDiagnostic));
}

void VerifyAssetBunchLookup_CanonicalDuplicateExportsAreRejectedBeforeNestedResolution(){
    for(in usize unused : s_BunchUnusedDeclarationCounts)
        ExpectBunchLookupFailure(unused, "\nmetadata known;\nprobe Asset = { \"missing\": known.missing };\nprobe asset;\nasset_bunch bunch = [Asset, asset];\n", "variable 'asset' is listed more than once", "does not target a declared asset");
}

void VerifyAssetBunchLookup_LocalCycleDetectionKeepsCanonicalVariableIdentity(){
    for(in usize unused : s_BunchUnusedDeclarationCounts)
        ExpectBunchLookupFailure(unused, "\nmetadata Local;\nmetadata local = { \"id\": 5 };\nLocal.next = local;\nprobe asset = { \"nested\": Local };\nasset_bunch bunch = [asset];\n", "cyclic local metadata reference 'local'", "");
}

void VerifyAssetBunchLookup_BunchDeclarationsAreExcludedFromExportAndNestedReferenceLookup(){
    for(in usize unused : s_BunchUnusedDeclarationCounts){
        ExpectBunchLookupFailure(unused, "asset_bunch bunch; bunch = [bunch];", "item 0 references undeclared asset variable 'bunch'", "");
        ExpectBunchLookupFailure(unused, "probe asset; ASSET_BUNCH bunch; asset.items = [bunch]; bunch = [asset];", "reference 'bunch' does not target a declared asset", "");
    }
}

void VerifyAssetBunchLookup_ExportLookupKeepsFullReferenceTextAndRejectsLiteralItems(){
    for(in usize unused : s_BunchUnusedDeclarationCounts){
        ExpectBunchLookupFailure(unused, "metadata known; probe asset; asset_bunch bunch = [known.missing, asset];", "item 0 references undeclared asset variable 'known.missing'", "");
        ExpectBunchLookupFailure(unused, "probe asset; asset_bunch bunch = [\"asset\", asset];", "item 0 must be a declared asset reference", "");
    }
}

void VerifyAssetBunchLookup_NestedListFailureFollowsSourceTraversalOrder(){
    for(in usize unused : s_BunchUnusedDeclarationCounts){
        ExpectBunchLookupFailure(unused, "metadata known; metadata cycle; cycle.next = cycle; probe asset = [known.missing, cycle]; asset_bunch bunch = [asset];", "does not target a declared asset", "cyclic local metadata reference");
        ExpectBunchLookupFailure(unused, "metadata known; metadata cycle; cycle.next = cycle; probe asset = [cycle, known.missing]; asset_bunch bunch = [asset];", "cyclic local metadata reference", "does not target a declared asset");
    }
}

void VerifyAssetsGraphics_AssetCacheWritesLowercaseAbsolutePathSha1AndSharesAcrossProjects(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    TestArena testArena = TestArena();

    AssetString emptySha1Hex(testArena.arena);
    AppendSha1Hex(ComputeSha1Text(""), emptySha1Hex);
    EXPECT_EQ(StringView(emptySha1Hex), "da39a3ee5e6b4b0d3255bfef95601890afd80709");
    AssetString abcSha1Hex(testArena.arena);
    AppendSha1Hex(ComputeSha1Text("abc"), abcSha1Hex);
    EXPECT_EQ(StringView(abcSha1Hex), "a9993e364706816aba3e25717850c26c9cd0d89d");

    const Expected<CookCase> cookCase = PrepareCookCase(testArena, "nwb_asset_cache_sha1_param_checksum");
    ASSERT_TRUE(cookCase.has_value());
    const CookCase prepared = cookCase.value();
    const GraphicsTestPath root = prepared.root;
    const GraphicsTestPath assetRoot = JoinGraphicsPath(root, s_AssetsDirectory);
    const GraphicsTestPath mixedCaseNwbPath = JoinGraphicsPath2(assetRoot, "Samplers", "First_Sampler.nwb");
    const Name virtualPath = s_ProjectSamplersFirstSampler;

    const auto absoluteMixed = AbsolutePath(Path(mixedCaseNwbPath));
    ASSERT_TRUE(absoluteMixed.has_value());
    String expectedSourcePathText = PathToString(absoluteMixed.value().lexicallyNormal());
    CanonicalizeTextInPlace(expectedSourcePathText);
    const Sha1Digest expectedDigest = ComputeSha1Text(StringView(expectedSourcePathText));
    AssetString expectedSha1Name(testArena.arena);
    AppendSha1Hex(expectedDigest, expectedSha1Name);
    expectedSha1Name.append(s_BuiltAssetExtension);
    const GraphicsTestPath expectedCacheFilePath = JoinGraphicsPath2(root, s_CacheDirectory, StringView(expectedSha1Name));

    ASSERT_TRUE(WriteGraphicsFixtureText(mixedCaseNwbPath, s_LinearWrapSamplerMetadata));
    const GraphicsTestPath builtFirst = JoinGraphicsPath(root, "built_first");
    ASSERT_TRUE(BuildAndGatherWithExplicitRepoRoot(testArena, root, assetRoot, builtFirst, prepared.outputDirectory));
    EXPECT_FALSE(SawCapturedMessage(logger, "is already cached"));
    EXPECT_EQ(CountNwbaFilesInDirectory(builtFirst), 0u);

    AssetBytes initialCacheBytes(testArena.arena);
    ASSERT_TRUE(GraphicsReadBinaryFile(expectedCacheFilePath, initialCacheBytes).has_value());
    const Expected<BuiltAssetFileHeader> initialHeaderResult = ReadBuiltAssetFileHeader(initialCacheBytes);
    ASSERT_TRUE(initialHeaderResult.has_value());
    const BuiltAssetFileHeader initialHeader = initialHeaderResult.value();
    EXPECT_EQ(initialHeader.magic, s_BuiltAssetMagic);
    EXPECT_EQ(initialHeader.version, s_BuiltAssetVersion);
    EXPECT_NE(initialHeader.flags & s_BuiltAssetFlagStandalone, 0u);
    EXPECT_EQ(initialHeader.entryCount, 1u);

    {
        GraphicsScratchArena scratch = GraphicsScratchArena(s_CodecScratchArena);
        const ExecutablePaths executablePaths = ExecutablePaths();
        const Expected<Path, ErrorCode> executablePath = executablePaths.path();
        ASSERT_TRUE(executablePath.has_value());
        Vector<u8> executableBytes = Vector<u8>();
        ASSERT_TRUE(ReadBinaryFile(executablePath.value(), executableBytes).has_value());
        const Sha256Digest producer = ComputeSha256(executableBytes);
        Sha256Digest otherProducer = producer;
        otherProducer.bytes[0u] = otherProducer.bytes[0u] ^ 1u;

        DiscoveredNwbFile discovered = MakeDiscoveredNwbFile(assetRoot, mixedCaseNwbPath, s_ProjectVirtualRoot, testArena, scratch);
        NwbFileAssetCacheRecord originalProducer(testArena.arena);
        NwbFileAssetCacheRecord staleProducer(testArena.arena);
        ScratchString sourcePath(scratch.arena);
        ScratchString cacheName(scratch.arena);
        PrepareCacheRecordHelper(root, discovered, s_LinearWrapSamplerMetadata, producer, scratch, sourcePath, cacheName, originalProducer);
        PrepareCacheRecordHelper(root, discovered, s_LinearWrapSamplerMetadata, otherProducer, scratch, sourcePath, cacheName, staleProducer);
        ASSERT_TRUE(originalProducer.canWriteCache);
        ASSERT_TRUE(staleProducer.canWriteCache);
        EXPECT_EQ(StringView(originalProducer.sourcePathText), StringView(expectedSourcePathText));
        EXPECT_EQ(originalProducer.paramSha256, initialHeader.paramSha256);
        EXPECT_NE(staleProducer.paramSha256, originalProducer.paramSha256);

        AssetBytes staleBytes = initialCacheBytes;
        BuiltAssetFileHeader staleHeader = initialHeader;
        staleHeader.paramSha256 = staleProducer.paramSha256;
        ASSERT_TRUE(OverwritePOD(0u, staleHeader, staleBytes));
        ASSERT_TRUE(GraphicsWriteBinaryFile(expectedCacheFilePath, staleBytes));
        ASSERT_TRUE(BuildAndGatherWithExplicitRepoRoot(testArena, root, assetRoot, JoinGraphicsPath(root, "built_new_producer"), JoinGraphicsPath(root, "out_new_producer")));
        AssetBytes refreshed(testArena.arena);
        ASSERT_TRUE(GraphicsReadBinaryFile(expectedCacheFilePath, refreshed).has_value());
        EXPECT_EQ(refreshed, initialCacheBytes);

        const GraphicsTestPath bunchPath = JoinGraphicsPath2(assetRoot, "Samplers", "Sidecar_Bunch.nwb");
        const GraphicsTestPath fontPath = JoinGraphicsPath2(assetRoot, "Samplers", "Sidecar_Bunch.font");
        const GraphicsTestPath texturePath = JoinGraphicsPath2(assetRoot, "Samplers", "Sidecar_Bunch.tex");
        ASSERT_TRUE(WriteGraphicsFixtureText(fontPath, "font-one"));
        ASSERT_TRUE(WriteGraphicsFixtureText(texturePath, "texture-one"));
        DiscoveredNwbFile bunch = MakeDiscoveredNwbFile(assetRoot, bunchPath, s_ProjectVirtualRoot, testArena, scratch);
        ScratchString largeMetadata(scratch.arena);
        largeMetadata.append(70000u, 32u);
        largeMetadata.append("ASSET_BUNCH asset; font f; texture t;");
        NwbFileAssetCacheRecord initialSidecars(testArena.arena);
        NwbFileAssetCacheRecord changedFont(testArena.arena);
        NwbFileAssetCacheRecord changedTexture(testArena.arena);
        PrepareCacheRecordHelper(root, bunch, StringView(largeMetadata), producer, scratch, sourcePath, cacheName, initialSidecars);
        ASSERT_TRUE(initialSidecars.canWriteCache);
        ASSERT_TRUE(WriteGraphicsFixtureText(fontPath, "font-two"));
        PrepareCacheRecordHelper(root, bunch, StringView(largeMetadata), producer, scratch, sourcePath, cacheName, changedFont);
        ASSERT_TRUE(changedFont.canWriteCache);
        EXPECT_NE(initialSidecars.paramSha256, changedFont.paramSha256);
        ASSERT_TRUE(WriteGraphicsFixtureText(texturePath, "texture-two"));
        PrepareCacheRecordHelper(root, bunch, StringView(largeMetadata), producer, scratch, sourcePath, cacheName, changedTexture);
        ASSERT_TRUE(changedTexture.canWriteCache);
        EXPECT_NE(changedFont.paramSha256, changedTexture.paramSha256);
    }

    const GraphicsTestPath builtSecond = JoinGraphicsPath(root, "built_second");
    ASSERT_TRUE(BuildAndGatherWithExplicitRepoRoot(testArena, root, assetRoot, builtSecond, JoinGraphicsPath(root, "out_second")));
    EXPECT_TRUE(SawCapturedMessage(logger, "is already cached"));
    EXPECT_EQ(CountNwbaFilesInDirectory(builtSecond), 0u);

    const Expected<SamplerAsset> cachedSampler = LoadCookedSamplerAsset(JoinGraphicsPath(root, "out_second"), virtualPath, 1u, testArena);
    ASSERT_TRUE(cachedSampler.has_value());
    EXPECT_FLOAT_EQ(cachedSampler.value().description().mipBias, 0.0f);

    AssetBytes corruptedCacheBytes = initialCacheBytes;
    BuiltAssetFileHeader corruptedHeader = initialHeader;
    corruptedHeader.payloadSectionHashFnv64 = corruptedHeader.payloadSectionHashFnv64 ^ 1u;
    ASSERT_TRUE(OverwritePOD(0u, corruptedHeader, corruptedCacheBytes));
    ASSERT_TRUE(GraphicsWriteBinaryFile(expectedCacheFilePath, corruptedCacheBytes));
    ASSERT_TRUE(BuildAndGatherWithExplicitRepoRoot(testArena, root, assetRoot, JoinGraphicsPath(root, "built_repaired"), JoinGraphicsPath(root, "out_repaired")));
    AssetBytes repairedCacheBytes(testArena.arena);
    ASSERT_TRUE(GraphicsReadBinaryFile(expectedCacheFilePath, repairedCacheBytes).has_value());
    EXPECT_EQ(repairedCacheBytes, initialCacheBytes);

    corruptedHeader = initialHeader;
    corruptedHeader.entryCount = u32.max;
    corruptedCacheBytes = initialCacheBytes;
    ASSERT_TRUE(OverwritePOD(0u, corruptedHeader, corruptedCacheBytes));
    ASSERT_TRUE(GraphicsWriteBinaryFile(expectedCacheFilePath, corruptedCacheBytes));
    ASSERT_TRUE(BuildAndGatherWithExplicitRepoRoot(testArena, root, assetRoot, JoinGraphicsPath(root, "built_bad_count"), JoinGraphicsPath(root, "out_bad_count")));
    ASSERT_TRUE(GraphicsReadBinaryFile(expectedCacheFilePath, repairedCacheBytes).has_value());
    EXPECT_EQ(repairedCacheBytes, initialCacheBytes);

    ASSERT_TRUE(WriteGraphicsFixtureText(mixedCaseNwbPath, s_ModifiedSamplerCacheMetadata));
    ASSERT_TRUE(BuildAndGatherWithExplicitRepoRoot(testArena, root, assetRoot, JoinGraphicsPath(root, "built_third"), JoinGraphicsPath(root, "out_third")));

    AssetBytes updatedCacheBytes(testArena.arena);
    ASSERT_TRUE(GraphicsReadBinaryFile(expectedCacheFilePath, updatedCacheBytes).has_value());
    const Expected<BuiltAssetFileHeader> updatedHeader = ReadBuiltAssetFileHeader(updatedCacheBytes);
    ASSERT_TRUE(updatedHeader.has_value());
    EXPECT_NE(updatedHeader.value().paramSha256, initialHeader.paramSha256);

    const Expected<SamplerAsset> updatedSampler = LoadCookedSamplerAsset(JoinGraphicsPath(root, "out_third"), virtualPath, 1u, testArena);
    ASSERT_TRUE(updatedSampler.has_value());
    EXPECT_FLOAT_EQ(updatedSampler.value().description().mipBias, 3.5f);

    const GraphicsTestPath bunchRoot = JoinGraphicsPath(root, "bunch_assets");
    const GraphicsTestPath bunchNwbPath = JoinGraphicsPath2(bunchRoot, "Components", "Pair.nwb");
    ASSERT_TRUE(WriteGraphicsFixtureText(bunchNwbPath, "transform_component first;\r\ntransform_component second;\r\nasset_bunch bunch = [first, second];\r\n"));
    const auto absoluteBunch = AbsolutePath(Path(bunchNwbPath));
    ASSERT_TRUE(absoluteBunch.has_value());
    String canonicalBunchAbs = PathToString(absoluteBunch.value().lexicallyNormal());
    CanonicalizeTextInPlace(canonicalBunchAbs);
    AssetString bunchSha1Name(testArena.arena);
    AppendSha1Hex(ComputeSha1Text(StringView(canonicalBunchAbs)), bunchSha1Name);
    bunchSha1Name.append(s_BuiltAssetExtension);
    const GraphicsTestPath bunchCacheFilePath = JoinGraphicsPath2(root, s_CacheDirectory, StringView(bunchSha1Name));
    ASSERT_TRUE(BuildAndGatherWithExplicitRepoRoot(testArena, root, bunchRoot, JoinGraphicsPath(root, "built_bunch_first"), JoinGraphicsPath(root, "out_bunch_first")));
    AssetBytes bunchCacheBytes(testArena.arena);
    ASSERT_TRUE(GraphicsReadBinaryFile(bunchCacheFilePath, bunchCacheBytes).has_value());
    const Expected<BuiltAssetFileHeader> bunchHeader = ReadBuiltAssetFileHeader(bunchCacheBytes);
    ASSERT_TRUE(bunchHeader.has_value());
    EXPECT_EQ(bunchHeader.value().entryCount, 2u);
    const GraphicsTestPath builtBunchSecond = JoinGraphicsPath(root, "built_bunch_second");
    const GraphicsTestPath outBunchSecond = JoinGraphicsPath(root, "out_bunch_second");
    ASSERT_TRUE(BuildAndGatherWithExplicitRepoRoot(testArena, root, bunchRoot, builtBunchSecond, outBunchSecond));
    EXPECT_EQ(CountNwbaFilesInDirectory(builtBunchSecond), 0u);
    auto mountedBunch = MountGraphicsTestVolume(outBunchSecond, testArena);
    ASSERT_TRUE(mountedBunch.has_value());
    EXPECT_EQ(mountedBunch.value().deref().fileCount(), 2u);

    EXPECT_EQ(logger.errorCount(), 0u);
    EXPECT_TRUE(GraphicsRemoveAllIfExists(root));
}

NWB_ADHD_GTEST(AssetBunchOwnership, ClearReplacementAndDestructionReleaseAllResolvedValues, VerifyAssetBunchOwnership_ClearReplacementAndDestructionReleaseAllResolvedValues)

NWB_ADHD_GTEST(AssetBunchOwnership, OutputMoveAndGrowthPreserveValuesUntilTheirFinalOwnerDies, VerifyAssetBunchOwnership_OutputMoveAndGrowthPreserveValuesUntilTheirFinalOwnerDies)

NWB_ADHD_GTEST(AssetBunchOwnership, LongExportAndReferencePathsReclaimScopedResultsAndReuseCallerScratch, VerifyAssetBunchOwnership_LongExportAndReferencePathsReclaimScopedResultsAndReuseCallerScratch)

NWB_ADHD_GTEST(AssetBunchOwnership, ValuesOutliveTheirSourceDocumentWhileItsArenaRemainsAlive, VerifyAssetBunchOwnership_ValuesOutliveTheirSourceDocumentWhileItsArenaRemainsAlive)

NWB_ADHD_GTEST(AssetBunchOwnership, CallerUnwindDestroysEveryPublishedResolvedValue, VerifyAssetBunchOwnership_CallerUnwindDestroysEveryPublishedResolvedValue)

NWB_ADHD_GTEST(AssetBunchOwnership, FailedLaterLocalCycleReleasesTheUnpublishedValueAndPriorOutput, VerifyAssetBunchOwnership_FailedLaterLocalCycleReleasesTheUnpublishedValueAndPriorOutput)

NWB_ADHD_GTEST(AssetBunchOwnership, MissingLaterReferenceReleasesPartialNestedCollections, VerifyAssetBunchOwnership_MissingLaterReferenceReleasesPartialNestedCollections)

NWB_ADHD_GTEST(AssetBunchOwnership, RegisteredExpanderDistinguishesUnsupportedDocumentsFromExpansionErrors, VerifyAssetBunchOwnership_RegisteredExpanderDistinguishesUnsupportedDocumentsFromExpansionErrors)

NWB_ADHD_GTEST(AssetBunchOwnership, RegisteredExpanderTransfersValuesToTheModelParserWithoutBorrowedLifetime, VerifyAssetBunchOwnership_RegisteredExpanderTransfersValuesToTheModelParserWithoutBorrowedLifetime)

NWB_ADHD_GTEST(AssetBunchOwnership, NullValueReachesTheTypeParserAndKeepsItsRejectionContract, VerifyAssetBunchOwnership_NullValueReachesTheTypeParserAndKeepsItsRejectionContract)

NWB_ADHD_GTEST(AssetBunchLookup, ExactCaseReferencesPreserveExportAndRepeatedLocalValueOrder, VerifyAssetBunchLookup_ExactCaseReferencesPreserveExportAndRepeatedLocalValueOrder)

NWB_ADHD_GTEST(AssetBunchLookup, CanonicalDuplicateExportsAreRejectedBeforeNestedResolution, VerifyAssetBunchLookup_CanonicalDuplicateExportsAreRejectedBeforeNestedResolution)

NWB_ADHD_GTEST(AssetBunchLookup, LocalCycleDetectionKeepsCanonicalVariableIdentity, VerifyAssetBunchLookup_LocalCycleDetectionKeepsCanonicalVariableIdentity)

NWB_ADHD_GTEST(AssetBunchLookup, BunchDeclarationsAreExcludedFromExportAndNestedReferenceLookup, VerifyAssetBunchLookup_BunchDeclarationsAreExcludedFromExportAndNestedReferenceLookup)

NWB_ADHD_GTEST(AssetBunchLookup, ExportLookupKeepsFullReferenceTextAndRejectsLiteralItems, VerifyAssetBunchLookup_ExportLookupKeepsFullReferenceTextAndRejectsLiteralItems)

NWB_ADHD_GTEST(AssetBunchLookup, NestedListFailureFollowsSourceTraversalOrder, VerifyAssetBunchLookup_NestedListFailureFollowsSourceTraversalOrder)

NWB_ADHD_GTEST(AssetsGraphics, AssetCacheWritesLowercaseAbsolutePathSha1AndSharesAcrossProjects, VerifyAssetsGraphics_AssetCacheWritesLowercaseAbsolutePathSha1AndSharesAcrossProjects)


