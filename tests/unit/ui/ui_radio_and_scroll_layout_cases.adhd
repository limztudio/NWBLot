    EXPECT_FLOAT_EQ(placement.horizontal.thumb.width, 88.36f);
    EXPECT_FLOAT_EQ(placement.vertical.thumb.height, 38.72f);
}

void VerifyUiScrollbarLayoutTests_ZeroThicknessKeepsFullViewportWhileRetainingScrollableExtents(){
    const Rect bounds = Rect(10.0f, 20.0f, 100.0f, 80.0f);
    const auto placementResult = CalculateScrollViewportPlacement(bounds, bounds, Insets(), Point(399.0f, 200.0f), 1.0f, Point(350.0f, 100.0f), 0.0f, 16.0f);
    ASSERT_TRUE(placementResult.has_value());
    ScrollViewportPlacement placement = placementResult.value();
    ExpectUiRect(placement.viewport, bounds);
    EXPECT_FALSE(placement.horizontal.visible);
    EXPECT_FALSE(placement.vertical.visible);
    EXPECT_DOUBLE_EQ(placement.horizontal.maximum, 300.0);
    EXPECT_DOUBLE_EQ(placement.vertical.maximum, 120.0);
    EXPECT_DOUBLE_EQ(placement.horizontal.offset, 300.0);
    EXPECT_DOUBLE_EQ(placement.vertical.offset, 100.0);
    ASSERT_TRUE(TryUpdateScrollViewportOffsets(Point(40.0f, 50.0f), placement));
    EXPECT_DOUBLE_EQ(placement.horizontal.offset, 40.0);
    EXPECT_DOUBLE_EQ(placement.vertical.offset, 50.0);
    ExpectUiRect(placement.horizontal.thumb, Rect());
    ExpectUiRect(placement.vertical.thumb, Rect());
}

void VerifyUiScrollbarLayoutTests_InheritedClipChangesOnlyContentClip(){
    const Rect bounds = Rect(10.0f, 20.0f, 200.0f, 100.0f);
    const auto referenceResult = CalculateScrollViewportPlacement(bounds, bounds, Insets(), Point(399.0f, 300.0f), 1.0f, Point(60.0f, 70.0f), 12.0f, 16.0f);
    ASSERT_TRUE(referenceResult.has_value());
    ScrollViewportPlacement reference = referenceResult.value();
    const auto clippedResult = CalculateScrollViewportPlacement(bounds, Rect(50.0f, 60.0f, 40.0f, 20.0f), Insets(), Point(399.0f, 300.0f), 1.0f, Point(60.0f, 70.0f), 12.0f, 16.0f);
    ASSERT_TRUE(clippedResult.has_value());
    const ScrollViewportPlacement clipped = clippedResult.value();
    ExpectUiRect(clipped.contentClip, Rect(50.0f, 60.0f, 40.0f, 20.0f));
    reference.contentClip = clipped.contentClip;
    ExpectUiScrollbarPlacement(clipped, reference);
}

void VerifyUiScrollbarLayoutTests_DisjointAndZeroAreaClipsKeepOffsetsAndLogicalBars(){
    const Rect bounds = Rect(10.0f, 20.0f, 200.0f, 100.0f);
    Array<Rect, 4u> clips;
    clips[0u] = Rect(300.0f, 20.0f, 10.0f, 100.0f);
    clips[1u] = Rect(10.0f, 200.0f, 200.0f, 10.0f);
    clips[2u] = Rect(10.0f, 20.0f, 0.0f, 100.0f);
    clips[3u] = Rect(10.0f, 20.0f, 200.0f, 0.0f);
    for(in Rect clip : clips){
        const auto placementResult = CalculateScrollViewportPlacement(bounds, clip, Insets(), Point(399.0f, 300.0f), 1.0f, Point(60.0f, 70.0f), 12.0f, 16.0f);
        ASSERT_TRUE(placementResult.has_value());
        const ScrollViewportPlacement placement = placementResult.value();
        EXPECT_TRUE(placement.contentClip.width == 0.0f || placement.contentClip.height == 0.0f);
        EXPECT_TRUE(placement.horizontal.visible);
        EXPECT_TRUE(placement.vertical.visible);
        EXPECT_DOUBLE_EQ(placement.horizontal.offset, 60.0);
        EXPECT_DOUBLE_EQ(placement.vertical.offset, 70.0);
    }
}

