////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_skeleton/joint_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_SkeletonAffineEpsilon = 0.000001f;
const f32 s_SkeletonJointDeterminantEpsilon = 0.000000000001f;
const f32 s_SkeletonRigidJointEpsilon = 0.001f;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u32> SkeletonSkinningMode{
    LinearBlend = 0u,
    DualQuaternion = 1u
}

[component("skeleton_joint_palette")]
class SkeletonJointPaletteComponent{
    public Vector<SkeletonJointMatrix> joints;
    public u32 skinningMode = cast<u32>(SkeletonSkinningMode::LinearBlend);
}

[component("skeleton_pose")]
class SkeletonPoseComponent{
    public Vector<u32> parentJoints;
    public Vector<SkeletonJointMatrix> localJoints;
    public u32 skinningMode = cast<u32>(SkeletonSkinningMode::LinearBlend);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidSkeletonSkinningMode(in u32 mode){
    return mode == cast<u32>(SkeletonSkinningMode::LinearBlend) || mode == cast<u32>(SkeletonSkinningMode::DualQuaternion);
}

b8 HasSkeletonPoseData(in SkeletonPoseComponent pose){
    return !pose.localJoints.empty() || !pose.parentJoints.empty();
}

b8 ValidSkeletonPoseTopology(in SkeletonPoseComponent pose){
    if(!ValidSkeletonSkinningMode(pose.skinningMode))
        return false;
    const usize jointCount = pose.localJoints.size();
    if(jointCount == 0u || pose.parentJoints.size() != jointCount || jointCount > 0xffffffffu)
        return false;
    for(usize jointIndex = 0u; jointIndex < jointCount; ++jointIndex){
        const u32 parentJoint = pose.parentJoints[jointIndex];
        if(parentJoint != s_SkeletonInvalidJointIndex && cast<usize>(parentJoint) >= jointIndex)
            return false;
    }
    return true;
}

b8 CanEvaluateSkeletonPoseJoint(in SkeletonPoseComponent pose, in u32 targetJointIndex){
    return HasSkeletonPoseData(pose) && ValidSkeletonPoseTopology(pose) && cast<usize>(targetJointIndex) < pose.localJoints.size();
}

void InitializeSkeletonPoseFromJoints(in Span<SkeletonJoint> joints, mut SkeletonPoseComponent outPose){
    outPose.parentJoints.clear();
    outPose.localJoints.clear();
    outPose.parentJoints.reserve(joints.size());
    outPose.localJoints.reserve(joints.size());
    for(in SkeletonJoint joint : joints){
        outPose.parentJoints.push_back(joint.parentIndex);
        outPose.localJoints.push_back(joint.localBindPose);
    }
}

b8 IsInvertibleAffineJointMatrix3x4(in MatrixSingle matrix, in f32 determinantEpsilon){
    const VectorSingle row0 = matrix[0u];
    const VectorSingle row1 = matrix[1u];
    const VectorSingle row2 = matrix[2u];
    if(!IsFiniteSkeletonJointRow(row0) || !IsFiniteSkeletonJointRow(row1) || !IsFiniteSkeletonJointRow(row2))
        return false;
    const f32 determinant = Vector3Dot(row0, Vector3Cross(row1, row2)).x;
    return IsFinite(VectorSingle(determinant)) && Abs(VectorSingle(determinant)).x > determinantEpsilon;
}

MatrixSingle MultiplyAffineJointMatrix3x4(in MatrixSingle lhs, in MatrixSingle rhs){
    return Mul(lhs, rhs);
}

b8 TryResolveSkinningJointMatrix3x4Prevalidated(
    in MatrixSingle poseJoint,
    in b8 poseValidated,
    in b8 hasInverseBind,
    in MatrixSingle inverseBind,
    in b8 inverseBindValidated,
    in f32 inverseBindDeterminantEpsilon,
    mut MatrixSingle outMatrix
){
    if(!poseValidated && !IsInvertibleAffineJointMatrix3x4(poseJoint, s_SkeletonJointDeterminantEpsilon))
        return false;
    if(!hasInverseBind){
        outMatrix = poseJoint;
        return true;
    }
    if(!inverseBindValidated && !IsInvertibleAffineJointMatrix3x4(inverseBind, inverseBindDeterminantEpsilon))
        return false;
    const MatrixSingle combined = MultiplyAffineJointMatrix3x4(poseJoint, inverseBind);
    if(!IsInvertibleAffineJointMatrix3x4(combined, s_SkeletonJointDeterminantEpsilon))
        return false;
    outMatrix = combined;
    return true;
}

b8 TryEvaluateSkeletonPoseJointMatrix(in SkeletonPoseComponent pose, in u32 targetJointIndex, mut MatrixSingle outMatrix){
    if(!CanEvaluateSkeletonPoseJoint(pose, targetJointIndex))
        return false;
    const usize jointCount = pose.localJoints.size();
    for(usize jointIndex = 0u; jointIndex < jointCount; ++jointIndex){
        if(!IsInvertibleAffineJointMatrix3x4(MatrixSingle(pose.localJoints[jointIndex]), s_SkeletonJointDeterminantEpsilon))
            return false;
    }
    MatrixSingle matrix(pose.localJoints[cast<usize>(targetJointIndex)]);
    u32 currentJoint = targetJointIndex;
    while(pose.parentJoints[cast<usize>(currentJoint)] != s_SkeletonInvalidJointIndex){
        const u32 parentJoint = pose.parentJoints[cast<usize>(currentJoint)];
        matrix = MultiplyAffineJointMatrix3x4(MatrixSingle(pose.localJoints[cast<usize>(parentJoint)]), matrix);
        if(!IsInvertibleAffineJointMatrix3x4(matrix, s_SkeletonJointDeterminantEpsilon))
            return false;
        currentJoint = parentJoint;
    }
    outMatrix = matrix;
    return true;
}

Expected<SkeletonJointMatrix> TryResolveSkeletonPoseJointMatrixAt(
    in SkeletonPoseComponent pose,
    in usize jointIndex,
    in Span<SkeletonJointMatrix> resolvedJoints
){
    const MatrixSingle localJoint(pose.localJoints[jointIndex]);
    if(!IsInvertibleAffineJointMatrix3x4(localJoint, s_SkeletonJointDeterminantEpsilon))
        return MakeUnexpected(Failure());
    const u32 parentJoint = pose.parentJoints[jointIndex];
    if(parentJoint == s_SkeletonInvalidJointIndex)
        return pose.localJoints[jointIndex];
    const MatrixSingle combined = MultiplyAffineJointMatrix3x4(MatrixSingle(resolvedJoints[cast<usize>(parentJoint)]), localJoint);
    if(!IsInvertibleAffineJointMatrix3x4(combined, s_SkeletonJointDeterminantEpsilon))
        return MakeUnexpected(Failure());
    return SkeletonJointMatrix(combined);
}

Expected<u32> TryBuildStoredJointPaletteVectorFromSkeletonPose(
    in SkeletonPoseComponent pose,
    mut Vector<SkeletonJointMatrix> outJointPalette
){
    outJointPalette.clear();
    if(!HasSkeletonPoseData(pose))
        return cast<u32>(SkeletonSkinningMode::LinearBlend);
    if(!ValidSkeletonPoseTopology(pose))
        return MakeUnexpected(Failure());
    const usize jointCount = pose.localJoints.size();
    outJointPalette.reserve(jointCount);
    for(usize jointIndex = 0u; jointIndex < jointCount; ++jointIndex){
        const Expected<SkeletonJointMatrix> resolved = TryResolveSkeletonPoseJointMatrixAt(pose, jointIndex, outJointPalette);
        if(!resolved.has_value()){
            outJointPalette.clear();
            return MakeUnexpected(Failure());
        }
        outJointPalette.push_back(resolved.value());
    }
    return pose.skinningMode;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

