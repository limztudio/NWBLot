#include <impl/assets_font_atlas/asset.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
b8 FontAtlas::loadBinary(in Span<u8> binary){
    if(!this.checkVirtualPath("FontAtlas::loadBinary"))
        return false;
    FontAtlas candidate(this.virtualPath());
    if(!DeserializeFontAtlasBinaryInto(binary, candidate.m_payload)){
        LogFontAtlasBinaryDeserializeFailed();
        return false;
    }
    candidate.markPayloadValidated();
    this = candidate;
    return true;
}

[cpp_unwind]
b8 FontAtlas::validatePayload()const{
    return this.checkVirtualPath(s_FontAtlasValidatePayloadContext) && ValidateFontAtlasPayload(this.m_payload);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

