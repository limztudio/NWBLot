#include <tests/unit/ui/fixture_text_shaping.adhd.h>

#include <tests/common/font_fixture.adhd.h>
#include <tests/unit/ui/name_cases.adhd.h>

#include <impl/ecs_ui/toolkit/widgets/edit_box.adhd.h>

#include <global/filesystem.h>
#include <global/simdmath.h>
#include <global/simplemath.h>

#include <gtest/gtest.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_ui_edit_box_layout_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB;
using namespace NWB::Impl;
using namespace NWB::Impl::Ui;

constexpr AStringView s_EditBoxSkinPath = "tests/ui/edit_box/skin";
constexpr AStringView s_EditBoxTexturePath = "tests/ui/edit_box/texture";
constexpr AStringView s_EditBoxFontPath = "tests/ui/edit_box/font";
constexpr Name s_FontScratchArenaName = NWB::Tests::UiCases::s_UiCaseNameFontScratch;
constexpr AStringView s_LatinFontFileName = "latin.font";

using NWB::Tests::UiFixtureText::FixtureShaper;

class EditBoxLayoutTests : public testing::Test{
public:
    EditBoxLayoutTests()
        : m_arena(Name(NWB::Tests::UiCases::s_UiCaseNameEditBoxLayout))
        , m_model(m_arena)
        , m_shaper(m_arena)
        , m_builder(m_arena, m_shaper)
        , m_view(m_arena)
    {}


protected:
    [[nodiscard]] b8 shapeView(){
        if(!m_view.snapshot(m_model))
            return false;
        auto layout = m_builder.layout({ m_view.displayText() });
        return layout && m_view.adoptLayout(Move(*layout));
    }

    [[nodiscard]] b8 place(f32 width = 100.0f, f32 scroll = 0.0f)noexcept{
        const auto placement = m_view.arrange({ 10.0f, 20.0f, width, 20.0f }, {}, { 0.0f, 0.0f, 500.0f, 500.0f }, { scroll, 0.0f });
        if(!placement)
            return false;
        m_placement = *placement;
        return true;
    }

    [[nodiscard]] Expected<Rect> rangeRect(const EditBoxRange range)const noexcept{
        auto rect = m_view.caretGeometry().rangeOnLine(range, 0u, m_placement.caret.width);
        if(!rect)
            return MakeUnexpected(Failure{});
        const SIMDVectorSingle origin = VectorAdd(VectorSet(rect->x, rect->y, 0.0f, 0.0f), VectorSet(m_placement.textOrigin.x, m_placement.textOrigin.y, 0.0f, 0.0f));
        rect->x = VectorGetX(origin);
        rect->y = VectorGetY(origin);
        return rect;
    }


protected:
    Core::Alloc::GlobalArena m_arena;
    EditModel m_model;
    FixtureShaper m_shaper;
    TextLayoutBuilder m_builder;
    EditBoxView m_view;
    EditBoxPlacement m_placement;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


TEST_F(EditBoxLayoutTests, LigaturesExposeEachGraphemeCaretAndPartialSelection){
    ASSERT_TRUE(m_model.setText("ffi"));
    ASSERT_TRUE(m_model.setSelection(1u, 2u));
    ASSERT_TRUE(shapeView());
    ASSERT_EQ(m_view.layout().clusters().size(), 1u);
    ASSERT_EQ(m_view.caretStops().size(), 4u);
    for(usize index = 0u; index < 4u; ++index){
        EXPECT_EQ(m_view.caretStops()[index].committedByte, index);
        EXPECT_FLOAT_EQ(m_view.caretStops()[index].x, static_cast<f32>(index) * 10.0f);
    }
    ASSERT_TRUE(place());
    EXPECT_FLOAT_EQ(m_placement.caret.x, 30.0f);
    const auto selection = rangeRect(m_view.selectionRange());
    ASSERT_TRUE(selection);
    EXPECT_FLOAT_EQ(selection->x, 20.0f);
    EXPECT_FLOAT_EQ(selection->width, 10.0f);
    Expected<usize> hit = m_view.hitTest({ 21.0f, 24.0f }, m_placement);
    ASSERT_TRUE(hit);
    EXPECT_EQ(*hit, 1u);
    hit = m_view.hitTest({ 27.0f, 24.0f }, m_placement);
    ASSERT_TRUE(hit);
    EXPECT_EQ(*hit, 2u);
}

TEST_F(EditBoxLayoutTests, CombiningAndDecomposedHangulHitsStayOnWholeGraphemes){
    ASSERT_TRUE(m_model.setText("A\xcc\x81" "B"));
    ASSERT_TRUE(shapeView());
    ASSERT_TRUE(place());
    ASSERT_EQ(m_view.caretStops().size(), 3u);
    EXPECT_EQ(m_view.caretStops()[1].committedByte, 3u);
    Expected<usize> hit = m_view.hitTest({ 14.9f, 24.0f }, m_placement);
    ASSERT_TRUE(hit);
    EXPECT_EQ(*hit, 0u);
    hit = m_view.hitTest({ 15.1f, 24.0f }, m_placement);
    ASSERT_TRUE(hit);
    EXPECT_EQ(*hit, 3u);
    ASSERT_TRUE(m_model.setText("\xe1\x84\x92\xe1\x85\xa1\xe1\x86\xab"));
    ASSERT_TRUE(shapeView());
    ASSERT_TRUE(place());
    ASSERT_EQ(m_view.caretStops().size(), 2u);
    EXPECT_EQ(m_view.caretStops()[1].committedByte, 9u);
    hit = m_view.hitTest({ 17.0f, 24.0f }, m_placement);
    ASSERT_TRUE(hit);
    EXPECT_EQ(*hit, 9u);
}

TEST_F(EditBoxLayoutTests, PreeditReplacesOnlyTheDisplayAndOwnsItsSelectionAndUnderline){
    ASSERT_TRUE(m_model.setText("ABC"));
    ASSERT_TRUE(m_model.setSelection(1u, 2u));
    ASSERT_TRUE(m_model.beginComposition());
    ASSERT_TRUE(m_model.updateComposition("\xed\x95\x9c\xea\xb8\x80", 0u, 3u));
    ASSERT_TRUE(shapeView());
    EXPECT_EQ(m_model.text(), "ABC");
    EXPECT_EQ(m_view.displayText(), "A\xed\x95\x9c\xea\xb8\x80" "C");
    EXPECT_EQ(m_view.preeditRange().begin, 1u);
    EXPECT_EQ(m_view.preeditRange().end, 7u);
    EXPECT_EQ(m_view.displayCaret(), 4u);
    EXPECT_EQ(m_view.selectionRange().begin, 1u);
    EXPECT_EQ(m_view.selectionRange().end, 4u);
    ASSERT_EQ(m_view.caretStops().size(), 4u);
    EXPECT_EQ(m_view.caretStops()[2].committedByte, 2u);
    EXPECT_EQ(m_view.caretStops()[2].displayByte, 7u);
    ASSERT_TRUE(place());
    const auto selection = rangeRect(m_view.selectionRange());
    ASSERT_TRUE(selection);
    const auto preedit = rangeRect(m_view.preeditRange());
    ASSERT_TRUE(preedit);
    EXPECT_FLOAT_EQ(selection->x, 20.0f);
    EXPECT_FLOAT_EQ(selection->width, 10.0f);
    EXPECT_FLOAT_EQ(preedit->x, 20.0f);
    EXPECT_FLOAT_EQ(preedit->width, 20.0f);
    EXPECT_FLOAT_EQ(Min(m_placement.caret.width, preedit->height), 1.0f);
    const Expected<usize> hit = m_view.hitTest({ 39.0f, 24.0f }, m_placement);
    ASSERT_TRUE(hit);
    EXPECT_EQ(*hit, 2u);
    m_model.cancelComposition();
    ASSERT_TRUE(m_model.setText("changed"));
    EXPECT_EQ(m_view.displayText(), "A\xed\x95\x9c\xea\xb8\x80" "C");
    EXPECT_TRUE(m_view.composing());
}

TEST_F(EditBoxLayoutTests, NativePreeditCaretCanAddressScalarEdgesInsideOneGrapheme){
    ASSERT_TRUE(m_model.beginComposition());
    ASSERT_TRUE(m_model.updateComposition("\xe1\x84\x92\xe1\x85\xa1\xe1\x86\xab", 3u, 6u));
    ASSERT_TRUE(shapeView());
    ASSERT_TRUE(place());
    EXPECT_FLOAT_EQ(m_placement.caret.x, 18.0f);
    const auto selection = rangeRect(m_view.selectionRange());
    ASSERT_TRUE(selection);
    const auto preedit = rangeRect(m_view.preeditRange());
    ASSERT_TRUE(preedit);
    EXPECT_FLOAT_EQ(selection->x, 14.0f);
    EXPECT_FLOAT_EQ(selection->width, 4.0f);
    EXPECT_FLOAT_EQ(preedit->width, 12.0f);
    ASSERT_EQ(m_view.caretStops().size(), 2u);
    EXPECT_EQ(m_view.caretStops()[0].committedByte, 0u);
    EXPECT_EQ(m_view.caretStops()[1].committedByte, 0u);
}

TEST_F(EditBoxLayoutTests, HorizontalScrollFollowsCaretAndClampsWhenTextShrinks){
    ASSERT_TRUE(m_model.setText("abcdef"));
    ASSERT_TRUE(shapeView());
    const auto arranged = m_view.arrange({ 10.0f, 20.0f, 26.0f, 20.0f }, { 3.0f, 0.0f, 3.0f, 0.0f }, { 0.0f, 0.0f, 500.0f, 500.0f }, {});
    ASSERT_TRUE(arranged);
    m_placement = *arranged;
    EXPECT_FLOAT_EQ(m_placement.content.x, 13.0f);
    EXPECT_FLOAT_EQ(m_placement.content.width, 20.0f);
    EXPECT_FLOAT_EQ(m_placement.scroll, 41.0f);
    EXPECT_FLOAT_EQ(m_placement.caret.x + m_placement.caret.width, 33.0f);
    ASSERT_TRUE(m_model.move(EditMove::Home));
    ASSERT_TRUE(shapeView());
    ASSERT_TRUE(place(20.0f, 41.0f));
    EXPECT_FLOAT_EQ(m_placement.scroll, 0.0f);
    EXPECT_FLOAT_EQ(m_placement.caret.x, 10.0f);
    ASSERT_TRUE(m_model.setText("A"));
    ASSERT_TRUE(shapeView());
    ASSERT_TRUE(place(20.0f, 41.0f));
    EXPECT_FLOAT_EQ(m_placement.scroll, 0.0f);
}

TEST_F(EditBoxLayoutTests, PlacementIntersectsFrameAndContentClipsAndRejectsInvalidInputs){
    ASSERT_TRUE(m_model.setText("abc"));
    ASSERT_TRUE(shapeView());
    const auto arranged = m_view.arrange({ 10.0f, 20.0f, 100.0f, 30.0f }, { 8.0f, 4.0f, 8.0f, 4.0f }, { 30.0f, 22.0f, 20.0f, 40.0f }, {});
    ASSERT_TRUE(arranged);
    m_placement = *arranged;
    EXPECT_FLOAT_EQ(m_placement.frameClip.x, 30.0f);
    EXPECT_FLOAT_EQ(m_placement.frameClip.y, 22.0f);
    EXPECT_FLOAT_EQ(m_placement.frameClip.height, 28.0f);
    EXPECT_FLOAT_EQ(m_placement.clip.y, 24.0f);
    EXPECT_FLOAT_EQ(m_placement.clip.height, 22.0f);
    EXPECT_FALSE(m_view.arrange({ 0.0f, 0.0f, -1.0f, 20.0f }, {}, {}, {}));
    EXPECT_FALSE(m_view.arrange({ 0.0f, 0.0f, 20.0f, 20.0f }, { -1.0f }, {}, {}));
    EXPECT_FALSE(m_view.arrange({ 0.0f, 0.0f, 20.0f, 20.0f }, {}, {}, { Limit<f32>::s_QuietNaN, 0.0f }));
    EXPECT_FALSE(m_view.hitTest({ Limit<f32>::s_QuietNaN, 0.0f }, m_placement));
}

TEST_F(EditBoxLayoutTests, MismatchedAndRtlLayoutsPreserveTheAdmittedGeometry){
    ASSERT_TRUE(m_model.setText("abc"));
    ASSERT_TRUE(shapeView());
    ASSERT_TRUE(place());
    const f32 oldCaret = m_placement.caret.x;
    auto wrong = m_builder.layout({ "other" });
    ASSERT_TRUE(wrong);
    EXPECT_FALSE(m_view.adoptLayout(Move(*wrong)));
    EXPECT_EQ(m_view.layout().utf8(), "abc");
    ShapeRequest request{ "abc" };
    request.direction = TextDirection::RightToLeft;
    auto rtl = m_builder.layout(request);
    ASSERT_TRUE(rtl);
    EXPECT_FALSE(m_view.adoptLayout(Move(*rtl)));
    ASSERT_TRUE(place());
    EXPECT_FLOAT_EQ(m_placement.caret.x, oldCaret);
    TextService service(m_arena);
    EXPECT_EQ(m_view.shape(service, request), TextLayoutStatus::InvalidParameters);
    EXPECT_EQ(m_view.layout().utf8(), "abc");
}

TEST_F(EditBoxLayoutTests, SnapshotOwnsModelBytesAndReshapingRejectsUnsupportedSingleLineControls){
    ASSERT_TRUE(m_model.setText("owned"));
    ASSERT_TRUE(shapeView());
    const u64 revision = m_view.revision();
    ASSERT_TRUE(m_model.setText("replacement"));
    EXPECT_EQ(m_view.displayText(), "owned");
    EXPECT_EQ(m_view.layout().utf8(), "owned");
    EXPECT_EQ(m_view.revision(), revision);
    EditBoxView moved(Move(m_view));
    EXPECT_EQ(moved.displayText(), "owned");
    EXPECT_EQ(moved.layout().utf8(), "owned");
    EXPECT_TRUE(moved.ready());
    ASSERT_TRUE(m_model.setText("A\tB"));
    ASSERT_TRUE(moved.snapshot(m_model));
    EXPECT_FALSE(moved.ready());
    TextService service(m_arena);
    EXPECT_EQ(moved.shape(service), TextLayoutStatus::UnsupportedControl);
    EXPECT_FALSE(moved.arrange({}, {}, {}, {}));
}

TEST_F(EditBoxLayoutTests, EmptyTextKeepsOneCaretAndCanPaintWithoutAFontOrEditSkinRegion){
    ASSERT_TRUE(shapeView());
    ASSERT_TRUE(place());
    ASSERT_EQ(m_view.caretStops().size(), 1u);
    EXPECT_FLOAT_EQ(m_placement.caret.x, 10.0f);
    EXPECT_FLOAT_EQ(m_placement.caret.height, 12.0f);
    UiSkin skin(m_arena, Name(s_EditBoxSkinPath));
    UiSkin::RegionVector regions(m_arena);
    skin.setAtlas(Core::Assets::AssetRef<Texture>(s_EditBoxTexturePath), 4u, 4u, 1.0f, Move(regions));
    PaintBuilder paint(m_arena);
    TextService service(m_arena);
    EditBoxPaintFlags flags;
    flags.focused = true;
    flags.caretVisible = false;
    paint.begin({ 200.0f, 100.0f, 1.0f, 1.0f }, 1u, 1u, Core::Assets::AssetRef<UiSkin>(s_EditBoxSkinPath), skin);
    ASSERT_TRUE(m_view.paint(service, paint, skin, m_placement, {}, flags));
    EXPECT_EQ(paint.freeze().vertices().size(), 4u);
    flags.caretVisible = true;
    paint.begin({ 200.0f, 100.0f, 1.0f, 1.0f }, 2u, 1u, Core::Assets::AssetRef<UiSkin>(s_EditBoxSkinPath), skin);
    ASSERT_TRUE(m_view.paint(service, paint, skin, m_placement, {}, flags));
    EXPECT_EQ(paint.freeze().vertices().size(), 8u);
    flags.readOnly = true;
    paint.begin({ 200.0f, 100.0f, 1.0f, 1.0f }, 3u, 1u, Core::Assets::AssetRef<UiSkin>(s_EditBoxSkinPath), skin);
    ASSERT_TRUE(m_view.paint(service, paint, skin, m_placement, {}, flags));
    EXPECT_EQ(paint.freeze().vertices().size(), 4u);
}

TEST_F(EditBoxLayoutTests, EmptySelectionRejectsInvalidCaretWidthsAndRestoresClippingWithoutADrawnCaret){
    ASSERT_TRUE(shapeView());
    ASSERT_TRUE(place());
    UiSkin skin(m_arena, Name(s_EditBoxSkinPath));
    UiSkin::RegionVector regions(m_arena);
    skin.setAtlas(Core::Assets::AssetRef<Texture>(s_EditBoxTexturePath), 4u, 4u, 1.0f, Move(regions));
    PaintBuilder paint(m_arena);
    TextService service(m_arena);
    EditBoxPaintFlags flags;
    flags.focused = true;
    flags.caretVisible = false;
    u64 generation = 0u;
    for(const f32 width : { -1.0f, Limit<f32>::s_QuietNaN, Limit<f32>::s_Infinity }){
        EditBoxPlacement placement = m_placement;
        placement.caret.width = width;
        paint.begin({ 200.0f, 100.0f }, ++generation, 1u, Core::Assets::AssetRef<UiSkin>(s_EditBoxSkinPath), skin);
        EXPECT_FALSE(m_view.paint(service, paint, skin, placement, {}, flags));
        EXPECT_FALSE(paint.popClip());
        EXPECT_EQ(paint.freeze().vertices().size(), 4u);
    }
}

TEST_F(EditBoxLayoutTests, EmptyPreeditSelectionStillPaintsItsUnderlineAndRestoresClipping){
    Core::Alloc::ScratchArena fontScratchArena(s_FontScratchArenaName);
    Font font(m_arena, Name(s_EditBoxFontPath));
    const ::Path<Core::Alloc::GlobalArena> path = ::Path<Core::Alloc::GlobalArena>(m_arena, NWB_TEST_FONT_DIRECTORY) / s_LatinFontFileName;
    auto bytes = Tests::ReadBundledFontBytes(path, m_arena);
    ASSERT_TRUE(bytes);
    font.setFontBytes(Move(*bytes));
    ASSERT_TRUE(font.validatePayload());
    TextService service(m_arena);
    const FontSource source{ Core::Assets::AssetRef<Font>(s_EditBoxFontPath), font, 1u };
    ASSERT_TRUE(service.setFonts(fontScratchArena, Span(&source, 1u)));
    ASSERT_TRUE(m_model.beginComposition());
    ASSERT_TRUE(m_model.updateComposition("IME", 3u, 3u));
    ASSERT_TRUE(m_view.snapshot(m_model));
    ASSERT_EQ(m_view.shape(service), TextLayoutStatus::Success);
    ASSERT_EQ(m_view.selectionRange().begin, m_view.selectionRange().end);
    const auto placement = m_view.arrange({ 10.0f, 20.0f, 180.0f, 80.0f }, {}, { 0.0f, 0.0f, 200.0f, 120.0f }, {});
    ASSERT_TRUE(placement);
    UiSkin skin(m_arena, Name(s_EditBoxSkinPath));
    UiSkin::RegionVector regions(m_arena);
    skin.setAtlas(Core::Assets::AssetRef<Texture>(s_EditBoxTexturePath), 4u, 4u, 1.0f, Move(regions));
    PaintBuilder paint(m_arena);
    EditBoxStyle style;
    style.preedit = { 0.0f, 1.0f, 0.0f, 1.0f };
    EditBoxPaintFlags flags;
    flags.focused = true;
    flags.preeditCaretVisible = false;
    paint.begin({ 200.0f, 120.0f }, 1u, 1u, Core::Assets::AssetRef<UiSkin>(s_EditBoxSkinPath), skin);
    ASSERT_TRUE(m_view.paint(service, paint, skin, *placement, style, flags));
    EXPECT_FALSE(paint.popClip());
    const DrawSnapshot snapshot = paint.freeze();
    usize underlineVertices = 0u;
    for(const Vertex& vertex : snapshot.vertices()){
        if(vertex.color.r == 0.0f && vertex.color.g == 1.0f && vertex.color.b == 0.0f && vertex.color.a == 1.0f)
            ++underlineVertices;
    }
    EXPECT_EQ(underlineVertices, 4u);
}

TEST_F(EditBoxLayoutTests, PaintingRestoresClipStackAndBoundsVerticesAcrossDisplayScales){
    Core::Alloc::ScratchArena fontScratchArena(s_FontScratchArenaName);
    Font font(m_arena, Name(s_EditBoxFontPath));
    const ::Path<Core::Alloc::GlobalArena> path = ::Path<Core::Alloc::GlobalArena>(m_arena, NWB_TEST_FONT_DIRECTORY) / s_LatinFontFileName;
    auto bytes = Tests::ReadBundledFontBytes(path, m_arena);
    ASSERT_TRUE(bytes);
    font.setFontBytes(Move(*bytes));
    ASSERT_TRUE(font.validatePayload());
    TextService service(m_arena);
    const FontSource source{ Core::Assets::AssetRef<Font>(s_EditBoxFontPath), font, 1u };
    ASSERT_TRUE(service.setFonts(fontScratchArena, Span(&source, 1u)));
    ASSERT_TRUE(m_model.setText("ffi"));
    ASSERT_TRUE(m_model.setSelection(1u, 2u));
    ASSERT_TRUE(m_view.snapshot(m_model));
    ASSERT_EQ(m_view.shape(service), TextLayoutStatus::Success);
    ASSERT_TRUE(place());
    UiSkin skin(m_arena, Name(s_EditBoxSkinPath));
    UiSkin::RegionVector regions(m_arena);
    regions.push_back({ Name(NWB::Tests::UiCases::s_UiCaseNameButtonNormal), { 0u, 0u, 4u, 4u }, {}, {} });
    skin.setAtlas(Core::Assets::AssetRef<Texture>(s_EditBoxTexturePath), 4u, 4u, 1.0f, Move(regions));
    PaintBuilder paint(m_arena);
    EditBoxPaintFlags flags;
    flags.focused = true;
    for(const f32 scale : { 1.0f, 2.0f }){
        paint.begin({ 200.0f, 100.0f, scale, scale }, static_cast<u64>(scale), 1u, Core::Assets::AssetRef<UiSkin>(s_EditBoxSkinPath), skin);
        ASSERT_TRUE(m_view.paint(service, paint, skin, m_placement, {}, flags));
        EXPECT_FALSE(paint.popClip());
        const auto snapshot = paint.freeze();
        ASSERT_FALSE(snapshot.glyphPages().empty());
        ASSERT_FALSE(snapshot.vertices().empty());
        const f32 boundsRight = m_placement.bounds.x + m_placement.bounds.width;
        for(const Vertex& vertex : snapshot.vertices()){
            EXPECT_GE(vertex.position.x, m_placement.bounds.x);
            EXPECT_LE(vertex.position.x, boundsRight);
        }
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


TEST_F(EditBoxLayoutTests, NegativeZeroScrollClampsToPositiveZero){
    ASSERT_TRUE(m_model.setText("abcdef"));
    ASSERT_TRUE(m_model.move(EditMove::Home));
    ASSERT_TRUE(shapeView());
    for(const b8 revealCaret : { false, true }){
        const auto placement = m_view.arrange({ 10.0f, 20.0f, 26.0f, 20.0f }, {}, { 0.0f, 0.0f, 500.0f, 500.0f }, { -0.0f, -0.0f }, 1.0f, revealCaret);
        ASSERT_TRUE(placement);
        EXPECT_FLOAT_EQ(placement->scroll, 0.0f);
        EXPECT_FALSE(SignBit(placement->scroll));
    }
}


};


