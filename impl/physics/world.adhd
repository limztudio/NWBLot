    public b8 setJointGroundAnchorA(in JointId jointId, in VectorSingle groundAnchorA){
        if(!this.isValidJoint(jointId) || !IsFinite(groundAnchorA.xyz))
            return false;
        in Joint j = this.m_joints[jointId.index];
        if(j.type != JointType::Pulley || j.extraDataIndex >= this.m_jointExtraData.size())
            return false;
        this.m_jointExtraData[j.extraDataIndex].groundAnchorA = f32x4(groundAnchorA, 0.0f);
        this.resetJointWarmStartAndWake(jointId.index);
        return true;
    }

    public b8 setJointGroundAnchorB(in JointId jointId, in VectorSingle groundAnchorB){
        if(!this.isValidJoint(jointId) || !IsFinite(groundAnchorB.xyz))
            return false;
        in Joint j = this.m_joints[jointId.index];
        if(j.type != JointType::Pulley || j.extraDataIndex >= this.m_jointExtraData.size())
            return false;
        this.m_jointExtraData[j.extraDataIndex].groundAnchorB = f32x4(groundAnchorB, 0.0f);
        this.resetJointWarmStartAndWake(jointId.index);
        return true;
    }

    public b8 setJointPulleyConstant(in JointId jointId, in f32 pulleyConstant){
        if(!this.isValidJoint(jointId) || !IsFinite(VectorSingle(pulleyConstant)) || pulleyConstant < 0.0f)
            return false;
        mut Joint j = this.m_joints[jointId.index];
        if(j.type != JointType::Pulley || j.extraDataIndex >= this.m_jointExtraData.size())
            return false;
        this.m_jointExtraData[j.extraDataIndex].pulleyConstant = pulleyConstant;
        j.setLength(pulleyConstant);
        this.wakeJointBodies(jointId.index);
        return true;
    }

