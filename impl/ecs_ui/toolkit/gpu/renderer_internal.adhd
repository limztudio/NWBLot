class GpuSkinVersion : NoCopy{
public:
    explicit GpuSkinVersion(Core::GraphicsRuntime& graphics)noexcept
        : m_graphics(graphics)
    {}
    ~GpuSkinVersion()noexcept{
        TextureAssetLoader::Release(m_graphics, m_texture);
    }


public:
    Core::GraphicsRuntime& m_graphics;
    SkinBinding m_binding;
    TextureGpuResource m_texture;
};

template<typename TPage>
class GpuPageVersion : NoCopy{
public:
    GpuPageVersion(Core::GraphicsRuntime& graphics, TPage page)noexcept
        : m_graphics(graphics)
        , m_page(Move(page))
    {}
    ~GpuPageVersion()noexcept{
        FreeGpuDescriptor(m_graphics, m_sampledImage);
    }


public:
    Core::GraphicsRuntime& m_graphics;
    TPage m_page;
    Core::TextureHandle m_texture;
    Core::GpuDescriptorHandle m_sampledImage;
    Core::QueueSubmissionToken m_readinessToken;
};

class GpuTextureImageVersion : NoCopy{
public:
    GpuTextureImageVersion(Core::GraphicsRuntime& graphics, SharedImageSource source)noexcept
        : m_graphics(graphics)
        , m_source(Move(source))
    {}
    ~GpuTextureImageVersion()noexcept{
        TextureAssetLoader::Release(m_graphics, m_texture);
    }


public:
    Core::GraphicsRuntime& m_graphics;
    SharedImageSource m_source;
    TextureGpuResource m_texture;
};

NWB_INLINE GpuImageCache::GpuImageCache(Core::Alloc::GlobalArena& arena)
    : m_glyphCache(arena)
    , m_sdfCache(arena)
    , m_textureCache(arena)
{}

NWB_INLINE GpuImageCache::~GpuImageCache()noexcept = default;

NWB_INLINE void GpuImageCache::reserve(){
    m_glyphCache.reserve(s_PaintMaxImages);
    m_sdfCache.reserve(s_PaintMaxImages);
    m_textureCache.reserve(s_PaintMaxImages);
}

NWB_INLINE void GpuImageCache::clear()noexcept{
    m_glyphCache.clear();
    m_sdfCache.clear();
    m_textureCache.clear();
}

NWB_INLINE void GpuImageCache::trim(const DrawSnapshot& snapshot){
    const auto sameGlyphKey = [](const GpuVersion<GpuGlyphVersion>& cached, const SharedGlyphPage& page)noexcept{
        return SameGlyphPageKey(cached->m_page->binding(), page->binding());
    };
    const auto sameSdfKey = [](const GpuVersion<GpuSdfAtlasVersion>& cached, const SharedSdfAtlasPage& page)noexcept{
        return SameSdfAtlasPageKey(cached->m_page->binding(), page->binding());
    };
    const auto sameTextureKey = [](const GpuVersion<GpuTextureImageVersion>& cached, const SharedImageSource& source)noexcept{
        return SameTextureImageKey(*cached->m_source, *source);
    };
    const auto countMissing = [](const auto& cache, const auto& requested, const auto& sameKey)noexcept{
        return CountMissingCacheEntries(cache, requested, sameKey);
    };
    const auto retainReferenced = [](const auto& requested, const auto& sameKey, auto& cache)noexcept{
        RetainReferencedCacheEntries(requested, sameKey, cache);
    };
    const usize missing = countMissing(m_glyphCache, snapshot.glyphPages(), sameGlyphKey)
        + countMissing(m_sdfCache, snapshot.sdfPages(), sameSdfKey)
        + countMissing(m_textureCache, snapshot.textureImages(), sameTextureKey);
    if(!ShouldTrimGpuImageCache(m_glyphCache.size(), m_sdfCache.size(), m_textureCache.size(), missing))
        return;
    // Retain requested logical keys even when their immutable metadata conflicts; preparation must reject that conflict.
    // Live frames retain evicted versions.
    // Removing only cache ownership never changes sampled pixels or live descriptors.
    retainReferenced(snapshot.glyphPages(), sameGlyphKey, m_glyphCache);
    retainReferenced(snapshot.sdfPages(), sameSdfKey, m_sdfCache);
    retainReferenced(snapshot.textureImages(), sameTextureKey, m_textureCache);
}

NWB_INLINE void GpuImageCache::evict()noexcept{
    // Pending and in-flight frames keep their own strong version references after cache ownership is removed.
    if(!m_glyphCache.empty())
        m_glyphCache.erase(m_glyphCache.begin());
    else if(!m_sdfCache.empty())
        m_sdfCache.erase(m_sdfCache.begin());
    else if(!m_textureCache.empty())
        m_textureCache.erase(m_textureCache.begin());
}

class GpuTargetVersion : NoCopy{
public:
    explicit GpuTargetVersion(Core::GraphicsRuntime& graphics)noexcept
        : m_graphics(graphics)
    {}
    ~GpuTargetVersion()noexcept{
        FreeGpuDescriptor(m_graphics, m_sampledImage);
    }


public:
    Core::GraphicsRuntime& m_graphics;
    Core::TextureHandle m_color;
    Core::FramebufferHandle m_framebuffer;
    Core::GpuDescriptorHandle m_sampledImage;
    Core::QueueSubmissionToken m_readinessToken;
};

class GpuSharedResources : NoCopy{
public:
    explicit GpuSharedResources(Core::GraphicsRuntime& graphics)noexcept
        : m_graphics(graphics)
    {}
    ~GpuSharedResources()noexcept{
        FreeGpuDescriptor(m_graphics, m_samplerDescriptor);
    }


public:
    Core::GraphicsRuntime& m_graphics;
    Core::ShaderHandle m_vertexShader;
    Core::ShaderHandle m_pixelShader;
    Core::ShaderHandle m_outputVertexShader;
    Core::ShaderHandle m_outputPixelShader;
    Core::InputLayoutHandle m_inputLayout;
    Core::BindingLayoutHandle m_layout;
    Core::BindingLayoutHandle m_outputLayout;
    Core::GraphicsPipelineHandle m_pipeline;
    Core::GraphicsPipelineHandle m_outputPipeline;
    Core::SamplerHandle m_sampler;
    Core::GpuDescriptorHandle m_samplerDescriptor;
};

class GpuFrameData : NoCopy{
public:
    explicit GpuFrameData(Core::Alloc::GlobalArena& arena)noexcept
        : m_arena(arena)
        , m_snapshot(arena)
        , m_glyphPages(arena)
        , m_sdfPages(arena)
        , m_textureImages(arena)
    {}


public:
    void reset(DrawSnapshot&& snapshot, GpuVersion<GpuSkinVersion> skin)noexcept;


public:
    [[nodiscard]] b8 prefixComplete(Core::Device& device)const;
    [[nodiscard]] b8 recyclable(Core::Device& device)const;
    [[nodiscard]] b8 complete(Core::Device& device)const;


public:
    // Strong version owners keep descriptors allocated through pending recording and final GPU completion.
    Core::Alloc::GlobalArena& m_arena;
    DrawSnapshot m_snapshot;
    GpuVersion<GpuSkinVersion> m_skin;
    Vector<GpuVersion<GpuGlyphVersion>, Core::Alloc::GlobalArena> m_glyphPages;
    Vector<GpuVersion<GpuSdfAtlasVersion>, Core::Alloc::GlobalArena> m_sdfPages;
    Vector<GpuVersion<GpuTextureImageVersion>, Core::Alloc::GlobalArena> m_textureImages;
    GpuVersion<GpuTargetVersion> m_target;
    GpuVersion<GpuSharedResources> m_resources;
    Core::BufferHandle m_vertices;
    Core::BufferHandle m_indices;
    Core::GraphicsPipelineHandle m_outputPipeline;
    Core::AcquiredPresentationFrame m_acquired;
    Core::QueueSubmissionToken m_vertexUpload;
    Core::QueueSubmissionToken m_indexUpload;
    Core::QueueSubmissionToken m_clear;
    Core::QueueSubmissionToken m_raster;
    Core::QueueSubmissionToken m_finalConsumer;
    GpuCommandRecordingMode::Enum m_recordingMode = GpuCommandRecordingMode::Direct;
    b8 m_prepared = false;
    u32 m_presentationMode = NWB_UI_PRESENTATION_SDR;
};

using GpuFrame = GpuVersion<GpuFrameData>;

struct GpuFrameSlot{
    GpuVersion<GpuTargetVersion> target;
    Core::BufferHandle vertices;
    Core::BufferHandle indices;
    GpuFrame inFlight;
    usize vertexCapacity = 0u;
    usize indexCapacity = 0u;
};


