class ThrowingPublishLogger final : public Core::Common::ILogger{
public:
    explicit ThrowingPublishLogger(Core::Common::LogArena& arena)noexcept
        : m_arena(arena)
    {}


public:
    virtual Core::Common::LogArena& arena()noexcept override{ return m_arena; }

    virtual void enqueue(Core::Common::LogString&&, Core::Common::LogType::Enum)override;
    virtual void enqueue(const Core::Common::LogString&, Core::Common::LogType::Enum)override;


private:
    Core::Common::LogArena& m_arena;
};

class BlockingRestoreLogger final : public Core::Common::ILogger{
public:
    BlockingRestoreLogger(Core::Common::LogArena& arena, const NWB::Path& blockedPath, const b8 throwAfterBlock = false)noexcept
        : m_arena(arena)
        , m_blockedPath(blockedPath)
        , m_throwAfterBlock(throwAfterBlock)
    {}


public:
    virtual Core::Common::LogArena& arena()noexcept override{ return m_arena; }
    virtual void enqueue(Core::Common::LogString&&, Core::Common::LogType::Enum)override{ block(); }
    virtual void enqueue(const Core::Common::LogString&, Core::Common::LogType::Enum)override{ block(); }
    [[nodiscard]] b8 blocked()const noexcept{ return m_blocked; }


private:
    void block();


private:
    Core::Common::LogArena& m_arena;
    const NWB::Path& m_blockedPath;
    b8 m_throwAfterBlock;
    b8 m_blocked = false;
};

class FilesystemVolumeTest : public testing::Test{
public:
    FilesystemVolumeTest();


public:
    virtual void SetUp()override;
    virtual void TearDown()override;


public:
    Core::Alloc::GlobalArena m_arena;
    NWB::Path m_directory;
    Core::Filesystem::VolumeMountDesc m_desc;
    Tests::CapturingLogger m_logger;
    Core::Common::LoggerRegistrationGuard m_loggerGuard;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


