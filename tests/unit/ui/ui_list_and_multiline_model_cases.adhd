void VerifyUiListReconciliationTests_ReorderingRetainsStableSelectionAndCursorKeys(){
    RangeSource source = RangeSource();
    ListState state = ListState();
    state.select(5u);
    ASSERT_TRUE(ReconcileListState(state, source));
    ListOptions options = ListOptions();
    options.selectOnNavigate = false;
    ListResult result = ListResult();
    ASSERT_TRUE(ApplyListControlAction(source, options, MakeRangeSourceAction(state, source, ControlActionKind::Down), state, result));
    ASSERT_EQ(state.cursorKey(), 6u);
    source.reversed = true;
    ++source.revisionValue.value();
    ASSERT_TRUE(ReconcileListState(state, source));
    EXPECT_EQ(state.selectedKey(), 5u);
    EXPECT_EQ(state.cursorKey(), 6u);
}

void VerifyUiListReconciliationTests_RemovedCursorClearsIndependentlyOfSurvivingSelection(){
    RangeSource source = RangeSource();
    ListState state = ListState();
    state.select(5u);
    ASSERT_TRUE(ReconcileListState(state, source));
    ListOptions options = ListOptions();
    options.selectOnNavigate = false;
    ListResult result = ListResult();
    ASSERT_TRUE(ApplyListControlAction(source, options, MakeRangeSourceAction(state, source, ControlActionKind::Down), state, result));
    source.count = 5u;
    ++source.revisionValue.value();
    ASSERT_TRUE(ReconcileListState(state, source));
    EXPECT_EQ(state.selectedKey(), 5u);
    EXPECT_EQ(state.cursorKey(), 0u);
}

void VerifyUiListReconciliationTests_DisabledSelectionClearsIndependentlyOfEnabledCursor(){
    RangeSource source = RangeSource();
    ListState state = ListState();
    state.select(5u);
    ASSERT_TRUE(ReconcileListState(state, source));
    ListOptions options = ListOptions();
    options.selectOnNavigate = false;
    ListResult result = ListResult();
    ASSERT_TRUE(ApplyListControlAction(source, options, MakeRangeSourceAction(state, source, ControlActionKind::Down), state, result));
    source.disabledBegin = 4u;
    source.disabledEnd = 5u;
    ++source.revisionValue.value();
    ASSERT_TRUE(ReconcileListState(state, source));
    EXPECT_EQ(state.selectedKey(), 0u);
    EXPECT_EQ(state.cursorKey(), 6u);
}

void VerifyUiListReconciliationTests_ReplacingAnEstablishedSourceClearsSelectionCursorAndOffset(){
    RangeSource source = RangeSource();
    ListState state = ListState();
    state.select(5u);
    ASSERT_TRUE(state.scrollTo(90.0));
    ASSERT_TRUE(ReconcileListState(state, source));
    const u64 inputGeneration = state.inputGeneration();
    ++source.generation;
    ASSERT_TRUE(ReconcileListState(state, source));
    EXPECT_EQ(state.selectedKey(), 0u);
    EXPECT_EQ(state.cursorKey(), 0u);
    EXPECT_DOUBLE_EQ(state.scrollOffset(), 0.0);
    EXPECT_EQ(state.inputGeneration(), inputGeneration);
}

void VerifyUiListReconciliationTests_InvalidSourceIdentitiesAndMalformedLookupFailWithoutPartialMutation(){
    RangeSource source = RangeSource();
    ListState state = ListState();
    state.select(5u);
    ASSERT_TRUE(state.scrollTo(90.0));
    source.generation = 0u;
    EXPECT_FALSE(ReconcileListState(state, source));
    source.generation = 41u;
    source.revisionValue.value() = 0u;
    EXPECT_FALSE(ReconcileListState(state, source));
    source.revisionValue.value() = 1u;
    source.badLookup = true;
    EXPECT_FALSE(ReconcileListState(state, source));
    source.badLookup = false;
    source.wrongLookup = true;
    EXPECT_FALSE(ReconcileListState(state, source));
    EXPECT_EQ(state.selectedKey(), 5u);
    EXPECT_EQ(state.cursorKey(), 5u);
    EXPECT_DOUBLE_EQ(state.scrollOffset(), 90.0);
    source.wrongLookup = false;
    ASSERT_TRUE(ReconcileListState(state, source));
}

void VerifyUiListReconciliationTests_SourceRevisionChangingDuringLookupFailsAtomically(){
    RangeSource source = RangeSource();
    ListState state = ListState();
    state.select(5u);
    source.changeRevisionOnLookup.value() = true;
    EXPECT_FALSE(ReconcileListState(state, source));
    EXPECT_EQ(state.selectedKey(), 5u);
    EXPECT_EQ(state.cursorKey(), 5u);
    ListResult result = ListResult();
    EXPECT_FALSE(ApplyListControlAction(source, ListOptions(), MakeRangeSourceAction(state, source, ControlActionKind::Down), state, result));
    EXPECT_FALSE(result.valid);
    ASSERT_TRUE(ReconcileListState(state, source));
}

void VerifyUiListReconciliationTests_InputSourceAndRevisionTokensRejectStaleActions(){
    RangeSource source = RangeSource();
    ListState state = ListState();
    state.select(2u);
    ASSERT_TRUE(ReconcileListState(state, source));
    ListResult result = ListResult();
    const ControlAction valid = MakeRangeSourceAction(state, source, ControlActionKind::Down);
    ControlAction action = valid;
    ++action.control.instanceGeneration;
    EXPECT_FALSE(ApplyListControlAction(source, ListOptions(), action, state, result));
    action = valid;
    ++action.control.contentGeneration;
    EXPECT_FALSE(ApplyListControlAction(source, ListOptions(), action, state, result));
    action = valid;
    ++action.control.contentRevision;
    EXPECT_FALSE(ApplyListControlAction(source, ListOptions(), action, state, result));
    ++source.revisionValue.value();
    EXPECT_FALSE(ApplyListControlAction(source, ListOptions(), MakeRangeSourceAction(state, source, ControlActionKind::Down), state, result));
    ASSERT_TRUE(ReconcileListState(state, source));
    EXPECT_FALSE(ApplyListControlAction(source, ListOptions(), valid, state, result));
    ASSERT_TRUE(ApplyListControlAction(source, ListOptions(), MakeRangeSourceAction(state, source, ControlActionKind::Down), state, result));
    EXPECT_EQ(state.selectedKey(), 3u);
}

void VerifyUiListReconciliationTests_ApplicationChangesFenceEvenAnUnchangedSelectionValue(){
    RangeSource source = RangeSource();
    ListState state = ListState();
    state.select(2u);
    ASSERT_TRUE(ReconcileListState(state, source));
    const ControlAction action = MakeRangeSourceAction(state, source, ControlActionKind::Down);
    state.select(2u);
    ListResult result = ListResult();
    EXPECT_FALSE(ApplyListControlAction(source, ListOptions(), action, state, result));
    EXPECT_EQ(state.cursorKey(), 2u);
    ASSERT_TRUE(ReconcileListState(state, source));
    ASSERT_TRUE(ApplyListControlAction(source, ListOptions(), MakeRangeSourceAction(state, source, ControlActionKind::Down), state, result));
    EXPECT_EQ(state.cursorKey(), 3u);
}


