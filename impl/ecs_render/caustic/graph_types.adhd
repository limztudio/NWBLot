}


class CausticsStageTargetNaming{
    public Name accumulator;
    public Name history;
    public Name resolveHalf;
    public Name resolveGeometry;
    public Name sceneGeometryDomain;
    public CausticLabelView sceneGeometryDomainLabel;
    public CausticWarnView importWarnText;

    public CausticsStageTargetNaming(){
        this.accumulator = Name();
        this.history = Name();
        this.resolveHalf = Name();
        this.resolveGeometry = Name();
        this.sceneGeometryDomain = Name();
        this.sceneGeometryDomainLabel = CausticLabelView();
        this.importWarnText = CausticWarnView();
    }

    public CausticsStageTargetNaming(in Name accumulator, in Name history, in Name resolveHalf, in Name resolveGeometry, in Name sceneGeometryDomain, in CausticLabelView sceneGeometryDomainLabel, in CausticWarnView importWarnText){
        this.accumulator = accumulator;
        this.history = history;
        this.resolveHalf = resolveHalf;
        this.resolveGeometry = resolveGeometry;
        this.sceneGeometryDomain = sceneGeometryDomain;
        this.sceneGeometryDomainLabel = sceneGeometryDomainLabel;
        this.importWarnText = importWarnText;
    }
}


class CausticsStageTargets{
    public CausticGraphResourceId causticAccumulator;
    public CausticGraphResourceId causticHistory;
    public CausticGraphResourceId causticResolveHalf;
    public CausticGraphResourceId causticResolveGeometry;
    public CausticGraphResourceId sceneGeometryDomain;

    public CausticsStageTargets(){
        this.causticAccumulator = CausticGraphResourceId();
        this.causticHistory = CausticGraphResourceId();
        this.causticResolveHalf = CausticGraphResourceId();
        this.causticResolveGeometry = CausticGraphResourceId();
        this.sceneGeometryDomain = CausticGraphResourceId();
    }

    public CausticsStageTargets(in CausticGraphResourceId causticAccumulator, in CausticGraphResourceId causticHistory, in CausticGraphResourceId causticResolveHalf, in CausticGraphResourceId causticResolveGeometry, in CausticGraphResourceId sceneGeometryDomain){
        this.causticAccumulator = causticAccumulator;
        this.causticHistory = causticHistory;
        this.causticResolveHalf = causticResolveHalf;
        this.causticResolveGeometry = causticResolveGeometry;
        this.sceneGeometryDomain = sceneGeometryDomain;
    }
}


