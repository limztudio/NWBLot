#include <impl/ecs_ui/toolkit/gpu/image_cache.adhd>
#include <impl/ecs_ui/toolkit/gpu/sampled_texture_resources.adhd>
#include <impl/ecs_ui/toolkit/gpu/shader_abi.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class GpuImageResources : NoCopy{
    private mut GraphicsRuntime m_graphics;
    private mut GpuImageCache m_imageCache;
    private in SharedPool m_versions;

    public GpuImageResources(mut GraphicsRuntime graphics, mut GpuImageCache imageCache, in SharedPool versions){
        this.m_graphics = graphics;
        this.m_imageCache = imageCache;
        this.m_versions = versions;
    }

    [cpp_unwind]
    private Expected<GpuVersion<GpuGlyphVersion>> prepareGlyphPage(in SharedGlyphPage page){
        usize replaceIndex = this.m_imageCache.glyphs().size();
        for(usize index = 0u; index < this.m_imageCache.glyphs().size(); ++index){
            in GpuVersion<GpuGlyphVersion> existing = this.m_imageCache.glyphs()[index];
            if(!SameGlyphPageKey(existing.deref().m_page.deref().binding(), page.deref().binding()))
                continue;
            replaceIndex = index;
            if(existing.deref().m_page.deref().binding().generation != page.deref().binding().generation)
                break;
            if(!SameGlyphPageVersion(existing.deref().m_page.deref().binding(), existing.deref().m_page.deref().pixels(), page.deref().binding(), page.deref().pixels(), existing.deref().m_page == page))
                return MakeUnexpected(Failure());
            GpuVersion<GpuGlyphVersion> reused = existing;
            reused.deref().m_lastUsedTick = this.m_imageCache.nextTick();
            if(!PrepareGpuSampledTextureDescriptor(this.m_graphics, reused.deref().m_texture, reused.deref().m_texture.deref().getDescription().format, reused.deref().m_sampledImage))
                return MakeUnexpected(Failure());
            return reused;
        }
        mut Device device = this.m_graphics.getDevice();
        in GlyphPageBinding binding = page.deref().binding();
        Format pageFormat = Format::R8_UNORM;
        if(binding.channelCount == 4u){
            if(SupportsTextureFormat(Format::RGBA8_UNORM_SRGB, device))
                pageFormat = Format::RGBA8_UNORM_SRGB;
            else
                pageFormat = Format::RGBA8_UNORM;
        }
        if(!SupportsTextureFormat(pageFormat, device))
            return MakeUnexpected(Failure());
        const Expected<GpuVersion<GpuGlyphVersion>> versionResult = this.m_versions.make<GpuGlyphVersion>(this.m_graphics, page);
        if(!versionResult.has_value())
            return MakeUnexpected(versionResult.error());
        GpuVersion<GpuGlyphVersion> version = versionResult.value();
        GpuSampledTextures textures;
        const Expected<GpuPageUploadResult> uploadedPage = textures.createAndUploadPage(
            this.m_graphics,
            GpuPageTextureUploadDesc(
                s_GpuGlyphPageTextureName,
                Span<u8>(page.deref().pixels()),
                cast<usize>(binding.width) * cast<usize>(binding.channelCount),
                binding.width,
                binding.height,
                pageFormat
            )
        );
        if(!uploadedPage.has_value())
            return MakeUnexpected(Failure());
        version.deref().m_texture = uploadedPage.value().texture;
        version.deref().m_readinessToken = uploadedPage.value().readinessToken;
        version.deref().m_lastUsedTick = this.m_imageCache.nextTick();
        if(replaceIndex < this.m_imageCache.glyphs().size())
            this.m_imageCache.glyphs()[replaceIndex] = version;
        else{
            if(ShouldEvictGpuImageCacheBeforeInsert(this.m_imageCache.glyphs().size(), this.m_imageCache.sdfs().size(), this.m_imageCache.textures().size()))
                this.m_imageCache.evict();
            this.m_imageCache.glyphs().push_back(version);
        }
        if(!PrepareGpuSampledTextureDescriptor(this.m_graphics, version.deref().m_texture, pageFormat, version.deref().m_sampledImage))
            return MakeUnexpected(Failure());
        return version;
    }

    [cpp_unwind]
    public b8 prepareGlyphPages(in DrawSnapshot snapshot, mut Vector<GpuVersion<GpuGlyphVersion>> versions){
        in Vector<SharedGlyphPage> pages = snapshot.glyphPages();
        versions.reserve(pages.size());
        while(versions.size() < pages.size()){
            const Expected<GpuVersion<GpuGlyphVersion>> version = this.prepareGlyphPage(pages[versions.size()]);
            if(!version.has_value())
                return false;
            versions.push_back(version.value());
        }
        return true;
    }

    [cpp_unwind]
    private Expected<GpuVersion<GpuSdfAtlasVersion>> prepareSdfPage(in SharedSdfAtlasPage page){
        for(usize index = 0u; index < this.m_imageCache.sdfs().size(); ++index){
            in GpuVersion<GpuSdfAtlasVersion> existing = this.m_imageCache.sdfs()[index];
            if(!SameSdfAtlasPageKey(existing.deref().m_page.deref().binding(), page.deref().binding()))
                continue;
            if(!(existing.deref().m_page.deref().binding() == page.deref().binding()))
                return MakeUnexpected(Failure());
            GpuVersion<GpuSdfAtlasVersion> reused = existing;
            reused.deref().m_lastUsedTick = this.m_imageCache.nextTick();
            if(!PrepareGpuSampledTextureDescriptor(this.m_graphics, reused.deref().m_texture, reused.deref().m_texture.deref().getDescription().format, reused.deref().m_sampledImage))
                return MakeUnexpected(Failure());
            return reused;
        }
        mut Device device = this.m_graphics.getDevice();
        in SdfAtlasPageBinding binding = page.deref().binding();
        Format format = Format::RGBA8_UNORM;
        if(binding.channelCount == 1u) format = Format::R8_UNORM;
        else if(binding.channelCount == 2u) format = Format::RG8_UNORM;
        else if(binding.channelCount == 3u) format = Format::RGB8_UNORM;
        u32 uploadChannels = binding.channelCount;
        if(ShouldExpandGpuRgbSdfUpload(binding.channelCount, SupportsTextureFormat(format, device))){
            format = Format::RGBA8_UNORM;
            uploadChannels = s_GpuRgbaChannelCount;
        }
        if(!SupportsTextureFormat(format, device))
            return MakeUnexpected(Failure());
        const Expected<GpuVersion<GpuSdfAtlasVersion>> versionResult = this.m_versions.make<GpuSdfAtlasVersion>(this.m_graphics, page);
        if(!versionResult.has_value())
            return MakeUnexpected(versionResult.error());
        GpuVersion<GpuSdfAtlasVersion> version = versionResult.value();
        Vector<u8> expanded;
        Span<u8> uploadPixels = Span<u8>(page.deref().pixels());
        if(uploadChannels != binding.channelCount){
            ExpandGpuSdfPagePixels(binding.width, binding.height, binding.channelCount, uploadChannels, uploadPixels, expanded);
            uploadPixels = Span<u8>(expanded);
        }
        GpuSampledTextures textures;
        const Expected<GpuPageUploadResult> uploadedPage = textures.createAndUploadPage(
            this.m_graphics,
            GpuPageTextureUploadDesc(
                s_GpuSdfPageTextureName,
                uploadPixels,
                cast<usize>(binding.width) * uploadChannels,
                binding.width,
                binding.height,
                format
            )
        );
        if(!uploadedPage.has_value())
            return MakeUnexpected(Failure());
        version.deref().m_texture = uploadedPage.value().texture;
        version.deref().m_readinessToken = uploadedPage.value().readinessToken;
        version.deref().m_lastUsedTick = this.m_imageCache.nextTick();
        if(ShouldEvictGpuImageCacheBeforeInsert(this.m_imageCache.glyphs().size(), this.m_imageCache.sdfs().size(), this.m_imageCache.textures().size()))
            this.m_imageCache.evict();
        this.m_imageCache.sdfs().push_back(version);
        if(!PrepareGpuSampledTextureDescriptor(this.m_graphics, version.deref().m_texture, version.deref().m_texture.deref().getDescription().format, version.deref().m_sampledImage))
            return MakeUnexpected(Failure());
        return version;
    }

    [cpp_unwind]
    public b8 prepareSdfPages(in DrawSnapshot snapshot, mut Vector<GpuVersion<GpuSdfAtlasVersion>> versions){
        in Vector<SharedSdfAtlasPage> pages = snapshot.sdfPages();
        versions.reserve(pages.size());
        while(versions.size() < pages.size()){
            const Expected<GpuVersion<GpuSdfAtlasVersion>> version = this.prepareSdfPage(pages[versions.size()]);
            if(!version.has_value())
                return false;
            versions.push_back(version.value());
        }
        return true;
    }

    [cpp_unwind]
    private Expected<GpuVersion<GpuTextureImageVersion>> prepareTextureImage(in SharedImageSource source){
        if(!source.valid() || !ValidUiTextureImageSource(source.deref()))
            return MakeUnexpected(Failure());
        for(usize index = 0u; index < this.m_imageCache.textures().size(); ++index){
            in GpuVersion<GpuTextureImageVersion> existing = this.m_imageCache.textures()[index];
            if(existing.deref().m_source.deref().generation() != source.deref().generation())
                continue;
            if(!SameTextureImageKey(existing.deref().m_source.deref(), source.deref()) || (!existing.deref().m_validated && !ValidGpuTextureImageVersion(existing.deref())))
                return MakeUnexpected(Failure());
            GpuVersion<GpuTextureImageVersion> reused = existing;
            reused.deref().m_validated = true;
            reused.deref().m_lastUsedTick = this.m_imageCache.nextTick();
            return reused;
        }
        assert(source.deref().texture().validatePayload());
        const Expected<GpuVersion<GpuTextureImageVersion>> versionResult = this.m_versions.make<GpuTextureImageVersion>(this.m_graphics, source);
        if(!versionResult.has_value())
            return MakeUnexpected(versionResult.error());
        GpuVersion<GpuTextureImageVersion> version = versionResult.value();
        if(!CreateTextureGpuResource(source.deref().texture(), source.deref().identity().name(), "UI Texture Image", this.m_graphics, version.deref().m_texture))
            return MakeUnexpected(Failure());
        if(!ValidGpuTextureImageVersion(version.deref())){
            error("GpuRenderer: texture image {} has invalid GPU format, geometry, or readiness", source.deref().generation());
            return MakeUnexpected(Failure());
        }
        version.deref().m_validated = true;
        version.deref().m_lastUsedTick = this.m_imageCache.nextTick();
        if(ShouldEvictGpuImageCacheBeforeInsert(this.m_imageCache.glyphs().size(), this.m_imageCache.sdfs().size(), this.m_imageCache.textures().size()))
            this.m_imageCache.evict();
        this.m_imageCache.textures().push_back(version);
        return version;
    }

    [cpp_unwind]
    public b8 prepareTextureImages(in DrawSnapshot snapshot, mut Vector<GpuVersion<GpuTextureImageVersion>> versions){
        in Vector<SharedImageSource> images = snapshot.textureImages();
        versions.reserve(images.size());
        while(versions.size() < images.size()){
            const Expected<GpuVersion<GpuTextureImageVersion>> version = this.prepareTextureImage(images[versions.size()]);
            if(!version.has_value())
                return false;
            versions.push_back(version.value());
        }
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ShouldExpandGpuRgbSdfUpload(in u32 channelCount, in b8 rgbSampledSupported){
    return channelCount == s_GpuRgbChannelCount && !rgbSampledSupported;
}

b8 ValidGpuTextureImageVersion(in GpuTextureImageVersion version){
    if(!version.m_source.valid() || !ValidUiTextureImageSource(version.m_source.deref()) || !version.m_texture.valid())
        return false;
    in TextureGpuResource resource = version.m_texture;
    if(resource.format == Format::UNKNOWN || resource.format >= Format::kCount)
        return false;
    const FormatInfo format = GetFormatInfo(resource.format);
    in TextureDesc description = resource.texture.deref().getCreationDescription();
    in Texture texture = version.m_source.deref().texture();
    return IsValidGpuTextureImageResourceDesc(
        format.kind == FormatKind::Normalized || format.kind == FormatKind::Float,
        format.hasDepth,
        format.hasStencil,
        format.hasRed || format.hasGreen || format.hasBlue || format.hasAlpha,
        resource.sampledImageHeapHandle.descriptorClass() == GpuDescriptorClass::SampledImage,
        resource.readinessToken.valid(),
        resource.readinessToken.hasPhysicalQueueIdentity(),
        description.dimension == TextureDimension::Texture2D,
        description.depth,
        description.arraySize,
        description.sampleCount,
        description.format == resource.format,
        description.width,
        texture.width(),
        description.height,
        texture.height(),
        description.mipLevels,
        texture.mipLevels().size()
    );
}

b8 ValidateGpuGlyphPages(in DrawSnapshot snapshot){
    if(!ValidSnapshotImageCounts(snapshot.glyphPages().size(), snapshot.sdfPages().size(), snapshot.textureImages().size()))
        return false;
    in Vector<SharedGlyphPage> pages = snapshot.glyphPages();
    for(usize index = 0u; index < pages.size(); ++index){
        if(!pages[index].valid() || !ValidGlyphPageBinding(pages[index].deref().binding(), pages[index].deref().pixels().size()))
            return false;
        for(usize previous = 0u; previous < index; ++previous){
            if(SameGlyphPageKey(pages[index].deref().binding(), pages[previous].deref().binding()))
                return false;
        }
    }
    return ValidateDrawCommandGlyphBindings(snapshot.commands(), pages.size());
}

b8 ValidateGpuSdfPages(in DrawSnapshot snapshot){
    if(!ValidSnapshotImageCounts(snapshot.glyphPages().size(), snapshot.sdfPages().size(), snapshot.textureImages().size()))
        return false;
    in Vector<SharedSdfAtlasPage> pages = snapshot.sdfPages();
    for(usize index = 0u; index < pages.size(); ++index){
        if(!pages[index].valid() || !ValidSdfAtlasPageBinding(pages[index].deref().binding(), pages[index].deref().pixels().size()))
            return false;
        for(usize previous = 0u; previous < index; ++previous){
            if(SameSdfAtlasPageKey(pages[index].deref().binding(), pages[previous].deref().binding()))
                return false;
        }
    }
    for(in DrawCommand command : snapshot.commands()){
        u32 channelCount = 0u;
        if(command.sdfPageIndex < pages.size())
            channelCount = pages[command.sdfPageIndex].deref().binding().channelCount;
        if(!ValidDrawCommandSdfBinding(command, pages.size(), channelCount))
            return false;
    }
    return true;
}

b8 ValidateGpuTextureImages(in DrawSnapshot snapshot){
    if(!ValidSnapshotImageCounts(snapshot.glyphPages().size(), snapshot.sdfPages().size(), snapshot.textureImages().size()))
        return false;
    in Vector<SharedImageSource> images = snapshot.textureImages();
    for(usize index = 0u; index < images.size(); ++index){
        if(!images[index].valid() || !ValidUiTextureImageSource(images[index].deref()))
            return false;
        for(usize previous = 0u; previous < index; ++previous){
            if(images[index].deref().generation() == images[previous].deref().generation())
                return false;
        }
    }
    return ValidateDrawCommandImageBindings(snapshot.commands(), images.size());
}

b8 ValidGpuClipMaskChain(in u32 headOffset, in usize effectBytes, in Span<u32> words){
    u32 cursor = headOffset;
    for(usize step = 0u; step < s_PaintMaxAnalyticClipDepth; ++step){
        if(cursor == u32.max)
            return true;
        if((cursor & 15u) != 0u)
            return false;
        const usize byteCursor = cast<usize>(cursor);
        const usize recordBytes = cast<usize>(s_ShaderUiClipMaskRecordBytes);
        if(byteCursor > effectBytes || recordBytes > effectBytes - byteCursor)
            return false;
        const usize wordIndex = cast<usize>(cursor >> 2u);
        const u32 kind = words[wordIndex];
        if(kind != cast<u32>(PaintClipShapeKind::RoundedRect) && kind != cast<u32>(PaintClipShapeKind::Ellipse))
            return false;
        cursor = words[wordIndex + 1u];
    }
    return cursor == u32.max;
}

b8 ValidGpuDrawCommandBindingsAndEffects(
    in DrawCommand command,
    in b8 allowLayerComposite,
    in DrawSnapshot snapshot,
    in usize effectBytes
){
    in Vector<SharedGlyphPage> glyphPages = snapshot.glyphPages();
    in Vector<SharedSdfAtlasPage> sdfPages = snapshot.sdfPages();
    in Vector<SharedImageSource> images = snapshot.textureImages();
    in Vector<u32> words = snapshot.effectWords();
    in Vector<PaintEffectLayer> layers = snapshot.effectLayers();
    const usize glyphCount = glyphPages.size();
    const usize sdfCount = sdfPages.size();
    const usize imageCount = images.size();

    if(command.blendMode > PaintBlendMode::Replace)
        return false;
    if(!ValidGpuClipMaskChain(command.clipMaskOffset, effectBytes, Span<u32>(words)))
        return false;

    if(command.material == PaintMaterial::Solid || command.material == PaintMaterial::Skin)
        return command.glyphPageIndex == 0xffffffffu && command.sdfPageIndex == 0xffffffffu && command.sdfChannel == 0u && command.textureImageIndex == 0xffffffffu && command.effectOffset == u32.max;
    if(command.material == PaintMaterial::Glyph)
        return cast<usize>(command.glyphPageIndex) < glyphCount && glyphPages[command.glyphPageIndex].deref().binding().channelCount == 1u && command.sdfPageIndex == 0xffffffffu && command.sdfChannel == 0u && command.textureImageIndex == 0xffffffffu && command.effectOffset == u32.max;
    if(command.material == PaintMaterial::ColorGlyph)
        return cast<usize>(command.glyphPageIndex) < glyphCount && glyphPages[command.glyphPageIndex].deref().binding().channelCount == 4u && command.sdfPageIndex == 0xffffffffu && command.sdfChannel == 0u && command.textureImageIndex == 0xffffffffu && command.effectOffset == u32.max;
    if(command.material == PaintMaterial::SdfGlyph)
        return command.glyphPageIndex == 0xffffffffu && cast<usize>(command.sdfPageIndex) < sdfCount && command.sdfChannel < sdfPages[command.sdfPageIndex].deref().binding().channelCount && command.textureImageIndex == 0xffffffffu && command.effectOffset == u32.max;
    if(command.material == PaintMaterial::Image)
        return cast<usize>(command.textureImageIndex) < imageCount && command.glyphPageIndex == 0xffffffffu && command.sdfPageIndex == 0xffffffffu && command.sdfChannel == 0u && command.effectOffset == u32.max;

    if(command.glyphPageIndex != 0xffffffffu || command.sdfPageIndex != 0xffffffffu || command.sdfChannel != 0u || command.textureImageIndex != 0xffffffffu)
        return false;

    if(command.material == PaintMaterial::Gradient){
        if((command.effectOffset & 15u) != 0u)
            return false;
        const usize byteOff = cast<usize>(command.effectOffset);
        const usize headerBytes = cast<usize>(s_ShaderUiGradientHeaderBytes);
        if(byteOff > effectBytes || headerBytes > effectBytes - byteOff)
            return false;
        const u32 stopCount = words[cast<usize>(command.effectOffset >> 2u) + 2u];
        if(stopCount == 0u || stopCount > s_ShaderUiMaxGradientStops)
            return false;
        const usize offsetGroupBytes = cast<usize>((stopCount + 3u) >> 2u) * cast<usize>(s_ShaderUiGradientOffsetGroupBytes);
        const usize totalBytes = headerBytes + offsetGroupBytes + cast<usize>(stopCount) * cast<usize>(s_ShaderUiGradientColorBytes);
        return totalBytes <= effectBytes - byteOff;
    }
    if(command.material == PaintMaterial::DropShadow){
        if((command.effectOffset & 15u) != 0u)
            return false;
        const usize byteOff = cast<usize>(command.effectOffset);
        const usize recordBytes = cast<usize>(s_ShaderUiDropShadowRecordBytes);
        return byteOff <= effectBytes && recordBytes <= effectBytes - byteOff;
    }
    if(command.material == PaintMaterial::EffectLayerComposite){
        if(!allowLayerComposite)
            return false;
        return cast<usize>(command.effectOffset) < layers.size();
    }
    return false;
}

b8 ValidGpuBlurRecord(in u32 byteOffset, in usize effectBytes, in Span<u32> words){
    if(byteOffset == u32.max || (byteOffset & 15u) != 0u)
        return false;
    const usize byteOff = cast<usize>(byteOffset);
    const usize headerBytes = cast<usize>(s_ShaderUiBlurHeaderBytes);
    if(byteOff > effectBytes || headerBytes > effectBytes - byteOff)
        return false;
    const u32 pairCount = words[cast<usize>(byteOffset >> 2u) + 3u];
    if(pairCount == 0u || pairCount > s_ShaderUiMaxBlurTapPairs)
        return false;
    const usize totalBytes = headerBytes + cast<usize>((pairCount + 1u) >> 1u) * cast<usize>(s_ShaderUiBlurPairGroupBytes);
    return totalBytes <= effectBytes - byteOff;
}

b8 ValidateGpuSnapshotImages(in DrawSnapshot snapshot){
    in Vector<SharedGlyphPage> glyphPages = snapshot.glyphPages();
    in Vector<SharedSdfAtlasPage> sdfPages = snapshot.sdfPages();
    in Vector<SharedImageSource> images = snapshot.textureImages();
    in Vector<u32> words = snapshot.effectWords();
    in Vector<PaintEffectLayer> layers = snapshot.effectLayers();
    in Vector<DrawCommand> effectCommands = snapshot.effectCommands();
    const usize glyphCount = glyphPages.size();
    const usize sdfCount = sdfPages.size();
    const usize imageCount = images.size();
    if(!ValidSnapshotImageCounts(glyphCount, sdfCount, imageCount))
        return false;
    if((words.size() & 3u) != 0u || layers.size() > s_PaintMaxEffectLayers)
        return false;
    const usize effectBytes = words.size() * 4u;

    for(usize index = 0u; index < glyphCount; ++index){
        if(!glyphPages[index].valid() || !ValidGlyphPageBinding(glyphPages[index].deref().binding(), glyphPages[index].deref().pixels().size()))
            return false;
        for(usize previous = 0u; previous < index; ++previous){
            if(SameGlyphPageKey(glyphPages[index].deref().binding(), glyphPages[previous].deref().binding()))
                return false;
        }
    }
    for(usize index = 0u; index < sdfCount; ++index){
        if(!sdfPages[index].valid() || !ValidSdfAtlasPageBinding(sdfPages[index].deref().binding(), sdfPages[index].deref().pixels().size()))
            return false;
        for(usize previous = 0u; previous < index; ++previous){
            if(SameSdfAtlasPageKey(sdfPages[index].deref().binding(), sdfPages[previous].deref().binding()))
                return false;
        }
    }
    for(usize index = 0u; index < imageCount; ++index){
        if(!images[index].valid() || !ValidUiTextureImageSource(images[index].deref()))
            return false;
        for(usize previous = 0u; previous < index; ++previous){
            if(images[index].deref().generation() == images[previous].deref().generation())
                return false;
        }
    }
    for(in PaintEffectLayer layer : layers){
        if(layer.commandBegin >= layer.commandEnd || cast<usize>(layer.commandEnd) > effectCommands.size())
            return false;
        if(layer.opacity < 0.0f || layer.opacity > 1.0f || layer.blurRadius < 0.0f || layer.blurRadius > s_PaintMaxBlurRadius || layer.blendMode > PaintBlendMode::Replace)
            return false;
        if(!ValidGpuClipMaskChain(layer.clipMaskOffset, effectBytes, Span<u32>(words)))
            return false;
        if(layer.blurRadius > 0.0f){
            if(!ValidGpuBlurRecord(layer.blurHorizontalOffset, effectBytes, Span<u32>(words)))
                return false;
            if(!ValidGpuBlurRecord(layer.blurVerticalOffset, effectBytes, Span<u32>(words)))
                return false;
            if(cast<usize>(s_PaintQuadIndexCount) > snapshot.indices().size() || cast<usize>(layer.blurFirstIndex) > snapshot.indices().size() - cast<usize>(s_PaintQuadIndexCount))
                return false;
        }
        else if(layer.blurHorizontalOffset != u32.max || layer.blurVerticalOffset != u32.max)
            return false;
    }
    for(in DrawCommand command : snapshot.commands()){
        if(!ValidGpuDrawCommandBindingsAndEffects(command, true, snapshot, effectBytes))
            return false;
    }
    for(in DrawCommand command : effectCommands){
        if(!ValidGpuDrawCommandBindingsAndEffects(command, false, snapshot, effectBytes))
            return false;
    }
    return true;
}

[cpp_unwind]
Expected<GpuSampledGraphResources> DeclareGpuGlyphPages(
    mut GpuTaskGraph graph,
    in DrawSnapshot snapshot,
    in Vector<GpuVersion<GpuGlyphVersion>> versions,
    mut GpuSampledTextureNameTable nameTable,
    mut GpuRasterResourceUses uses
){
    GpuSampledGraphResources resources;
    if(versions.size() != snapshot.glyphPages().size()){
        error("GpuRenderer: prepared glyph page count does not match the immutable snapshot");
        return MakeUnexpected(Failure());
    }
    for(usize index = 0u; index < versions.size(); ++index){
        in GpuVersion<GpuGlyphVersion> page = versions[index];
        Name readyIdentity;
        Name textureIdentity;
        if(!nameTable.resolvePair(0u, index, s_GpuGlyphPageReadyPrefix, s_GpuGlyphPagePrefix, readyIdentity, textureIdentity))
            return MakeUnexpected(Failure());
        const Expected<GpuGraphResourceId, GpuSampledTextureImportError> texture = ImportGpuSampledTextureWithNames(
            GpuSampledTextureImportDesc(
                s_GpuGlyphPageReadyMarkerLabel,
                "glyph page",
                page.deref().m_readinessToken,
                s_GpuGlyphPageMarkerLabel,
                page.deref().m_texture,
                index
            ),
            readyIdentity,
            textureIdentity,
            graph,
            uses
        );
        if(!texture.has_value()){
            if(texture.error() == GpuSampledTextureImportError::Texture)
                error(
                    "GpuRenderer: glyph page {} texture import failed (atlas={}, page={}, generation={})"
                    , index
                    , page.deref().m_page.deref().binding().atlasIdentity
                    , page.deref().m_page.deref().binding().index
                    , page.deref().m_page.deref().binding().generation
                );
            return MakeUnexpected(Failure());
        }
        resources.push_back(texture.value());
    }
    return resources;
}

[cpp_unwind]
Expected<GpuSampledGraphResources> DeclareGpuSdfPages(
    mut GpuTaskGraph graph,
    in DrawSnapshot snapshot,
    in Vector<GpuVersion<GpuSdfAtlasVersion>> versions,
    mut GpuSampledTextureNameTable nameTable,
    mut GpuRasterResourceUses uses
){
    GpuSampledGraphResources resources;
    if(versions.size() != snapshot.sdfPages().size()){
        error("GpuRenderer: prepared SDF page count does not match the immutable snapshot");
        return MakeUnexpected(Failure());
    }
    for(usize index = 0u; index < versions.size(); ++index){
        in GpuVersion<GpuSdfAtlasVersion> page = versions[index];
        Name readyIdentity;
        Name textureIdentity;
        if(!nameTable.resolvePair(1u, index, s_GpuSdfPageReadyPrefix, s_GpuSdfPagePrefix, readyIdentity, textureIdentity))
            return MakeUnexpected(Failure());
        const Expected<GpuGraphResourceId, GpuSampledTextureImportError> texture = ImportGpuSampledTextureWithNames(
            GpuSampledTextureImportDesc(
                s_GpuSdfPageReadyMarkerLabel,
                "SDF page",
                page.deref().m_readinessToken,
                s_GpuSdfPageMarkerLabel,
                page.deref().m_texture,
                index
            ),
            readyIdentity,
            textureIdentity,
            graph,
            uses
        );
        if(!texture.has_value()){
            if(texture.error() == GpuSampledTextureImportError::Texture)
                error(
                    "GpuRenderer: SDF page {} texture import failed (atlas={}, group={}, generation={})"
                    , index
                    , page.deref().m_page.deref().binding().atlasIdentity
                    , page.deref().m_page.deref().binding().index
                    , page.deref().m_page.deref().binding().generation
                );
            return MakeUnexpected(Failure());
        }
        resources.push_back(texture.value());
    }
    return resources;
}

[cpp_unwind]
Expected<GpuSampledGraphResources> DeclareGpuTextureImages(
    mut GpuTaskGraph graph,
    in DrawSnapshot snapshot,
    in Vector<GpuVersion<GpuTextureImageVersion>> versions,
    mut GpuSampledTextureNameTable nameTable,
    mut GpuRasterResourceUses uses
){
    GpuSampledGraphResources resources;
    if(versions.size() != snapshot.textureImages().size()){
        error("GpuRenderer: prepared texture image count does not match the immutable snapshot");
        return MakeUnexpected(Failure());
    }
    for(usize index = 0u; index < versions.size(); ++index){
        in GpuVersion<GpuTextureImageVersion> image = versions[index];
        in SharedImageSource source = snapshot.textureImages()[index];
        if(!image.valid() || !source.valid() || !image.deref().m_source.valid() || !SameTextureImageKey(image.deref().m_source.deref(), source.deref()) || (!image.deref().m_validated && !ValidGpuTextureImageVersion(image.deref())))
            return MakeUnexpected(Failure());
        Name readyIdentity;
        Name textureIdentity;
        if(!nameTable.resolvePair(2u, index, s_GpuTextureImageReadyPrefix, s_GpuTextureImagePrefix, readyIdentity, textureIdentity))
            return MakeUnexpected(Failure());
        const Expected<GpuGraphResourceId, GpuSampledTextureImportError> texture = ImportGpuSampledTextureWithNames(
            GpuSampledTextureImportDesc(
                s_GpuTextureImageReadyMarkerLabel,
                "texture",
                image.deref().m_texture.readinessToken,
                s_GpuTextureImageMarkerLabel,
                image.deref().m_texture.texture,
                index
            ),
            readyIdentity,
            textureIdentity,
            graph,
            uses
        );
        if(!texture.has_value()){
            if(texture.error() == GpuSampledTextureImportError::Texture)
                error("GpuRenderer: texture image {} import failed (source generation={})", index, source.deref().generation());
            return MakeUnexpected(Failure());
        }
        resources.push_back(texture.value());
    }
    return resources;
}


