#include <impl/ecs_render/shadow/light_space_shadow.adhd>
#include <impl/ecs_render/shadow/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class LightSpaceShadowGraphInputs{
    public mut GraphicsRuntime graphics;
    public in b8 shadowPrepared;
    public in LightSpaceShadowSnapshot snapshot;
    public GpuTaskId dependency;
    public Span<GpuTaskResourceUse> sceneReads;
    public Span<GpuTaskResourceSetUse> sceneReadSets;
    public Span<GpuTaskExternalStateSource> stateSources;

    public LightSpaceShadowGraphInputs(
        mut GraphicsRuntime graphics,
        in borrow b8 shadowPrepared,
        in LightSpaceShadowSnapshot snapshot,
        in GpuTaskId dependency,
        in Span<GpuTaskResourceUse> sceneReads,
        in Span<GpuTaskResourceSetUse> sceneReadSets,
        in Span<GpuTaskExternalStateSource> stateSources
    ){
        this.graphics = graphics;
        this.shadowPrepared = shadowPrepared;
        this.snapshot = snapshot;
        this.dependency = dependency;
        this.sceneReads = sceneReads;
        this.sceneReadSets = sceneReadSets;
        this.stateSources = stateSources;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

