#include "style.adhd"
#include <impl/ecs_ui/toolkit/edit/text_normalization.adhd>
#include <impl/ecs_ui/toolkit/paint_types.adhd>
#include <impl/ecs_ui/toolkit/text/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Color s_EditBoxSelectionColor = Color(0.20f, 0.40f, 0.78f, 0.75f);
const Color s_EditBoxInactiveSelectionColor = Color(0.28f, 0.31f, 0.38f, 0.55f);
const Color s_EditBoxCaretColor = Color(0.95f, 0.97f, 1.0f, 1.0f);
const Color s_EditBoxPreeditColor = Color(0.50f, 0.72f, 1.0f, 1.0f);

const f32 s_TextAreaDefaultHeight = 160.0f;
const u32 s_UiEditMinInterpolatedStops = 2u;
// One stop per byte boundary 0..committedBytes, plus one extra at the preedit seam.
const usize s_EditCaretMaxExtraMappingStops = 2u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class EditBoxCaretStop{
    public usize committedByte = 0u;
    public usize displayByte = 0u;
    public f32 x = 0.0f;
    public u32 lineIndex = 0u;
}

class EditBoxRange{
    public usize begin = 0u;
    public usize end = 0u;
}

class EditCaretMapping{
    public usize committedByte = 0u;
    public usize displayByte = 0u;
}

class EditCaretLine{
    public usize byteBegin = 0u;
    public usize byteEnd = 0u;
    public usize breakEnd = 0u;
    public u32 firstStop = 0u;
    public u32 stopCount = 0u;
    public f32 top = 0.0f;
    public f32 height = 0.0f;
    public f32 advance = 0.0f;
}

class EditBoxPlacement{
    public Rect bounds;
    public Rect frameClip;
    public Rect content;
    public Rect clip;
    public Point textOrigin;
    public Rect caret;
    public f32 scroll = 0.0f;
    public f32 scrollY = 0.0f;
}

class EditBoxStyle{
    public Name normal = Name("edit.normal");
    public Name hover = Name("edit.hover");
    public Name focused = Name("edit.focused");
    public Name disabled = Name("edit.disabled");
    public Name fallback = Name("button.normal");
    public Name focus = Name("focus.overlay");
    public Color background = s_StyleInsetColor;
    public Color text = s_StyleTextColor;
    public Color disabledText = s_StyleDisabledTextColor;
    public Color selection = s_EditBoxSelectionColor;
    public Color inactiveSelection = s_EditBoxInactiveSelectionColor;
    public Color caret = s_EditBoxCaretColor;
    public Color preedit = s_EditBoxPreeditColor;
    public Insets padding = Insets(s_StyleSpacingMedium, s_StyleSpacingSmall, s_StyleSpacingMedium, s_StyleSpacingSmall);
}

class EditBoxPaintFlags{
    public b8 enabled = true;
    public b8 hovered = false;
    public b8 focused = false;
    public b8 readOnly = false;
    public b8 caretVisible = true;
    public b8 preeditCaretVisible = true;
}

class EditBoxOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public LayoutSize height;
    public b8 enabled = true;
    public b8 readOnly = false;
}

// The host keeps this value alive through the matching endPanel/endWindow; paint and GPU snapshots own their text.
class EditBoxState{
    public b8 matchesStamp(in TextAreaModelStamp stamp, in b8 expectedFocused)const{
        return this.modelGeneration == stamp.instanceGeneration
            && this.revision == stamp.revision
            && this.selectionGeneration == stamp.selectionGeneration
            && this.anchor == stamp.anchor
            && this.caret == stamp.caret
            && this.focused == expectedFocused;
    }

    public f64 caretElapsed = 0.0;
    public u64 modelGeneration = 0u;
    public u64 revision = 0u;
    public u64 selectionGeneration = 0u;
    public usize anchor = 0u;
    public usize caret = 0u;
    public EditBoxPlacement placement;
    public f32 scroll = 0.0f;
    public b8 focused = false;
}

class EditBoxResult{
    public b8 valid = false;
    public b8 textChanged = false;
    public b8 selectionChanged = false;
    public b8 submitted = false;
    public b8 cancelled = false;
    public b8 focused = false;
    public b8 preeditCaretVisible = true;
    public b8 blurred = false;
    public b8 abandoned = false;
}

class IntegerEditOptions{
    public EditBoxOptions edit;
    public IntegerBounds bounds;
}

class FloatEditOptions{
    public EditBoxOptions edit;
    public FloatBounds bounds;
}

class NumericEditBoxResult{
    public EditBoxResult edit;
    public NumericEditResult numeric;
}

class TextAreaOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public LayoutSize height = LayoutSize(LayoutSizePolicy::Fixed, s_TextAreaDefaultHeight);
    public b8 enabled = true;
    public b8 readOnly = false;
    public f32 wheelLines = s_StyleScrollWheelStep;
}

class TextAreaScrollSnapshot{
    public TextAreaScrollSnapshot(){
        this.declarationGeneration = 0u;
        this.stateRevision = 0u;
        this.enabled = false;
        this.readOnly = false;
    }

    public TextAreaScrollSnapshot(
        in WidgetId inOwner,
        in PopupToken inPopup,
        in u64 inDeclarationGeneration,
        in u64 inStateRevision,
        in TextAreaModelStamp inModel,
        in b8 inEnabled,
        in b8 inReadOnly
    ){
        this.owner = inOwner;
        this.popup = inPopup;
        this.declarationGeneration = inDeclarationGeneration;
        this.stateRevision = inStateRevision;
        this.model = inModel;
        this.enabled = inEnabled;
        this.readOnly = inReadOnly;
    }

    public b8 operator==(in TextAreaScrollSnapshot rhs)const{
        return this.owner == rhs.owner
            && this.popup == rhs.popup
            && this.declarationGeneration == rhs.declarationGeneration
            && this.stateRevision == rhs.stateRevision
            && this.model == rhs.model
            && this.enabled == rhs.enabled
            && this.readOnly == rhs.readOnly;
    }

    public b8 operator!=(in TextAreaScrollSnapshot rhs)const{
        return this.owner != rhs.owner
            || this.popup != rhs.popup
            || this.declarationGeneration != rhs.declarationGeneration
            || this.stateRevision != rhs.stateRevision
            || this.model != rhs.model
            || this.enabled != rhs.enabled
            || this.readOnly != rhs.readOnly;
    }

    public WidgetId owner;
    public PopupToken popup;
    public u64 declarationGeneration;
    public u64 stateRevision;
    public TextAreaModelStamp model;
    public b8 enabled;
    public b8 readOnly;
}

void ApplySkinPaletteToEditBoxStyle(in UiSkinPalette palette, mut EditBoxStyle style){
    style.background = ResolveUiSkinColor(palette, UiSkinColorRole::EditBackground);
    style.text = ResolveUiSkinColor(palette, UiSkinColorRole::TextNormal);
    style.disabledText = ResolveUiSkinColor(palette, UiSkinColorRole::TextDisabled);
    style.selection = ResolveUiSkinColor(palette, UiSkinColorRole::EditSelection);
    style.inactiveSelection = ResolveUiSkinColor(palette, UiSkinColorRole::EditInactiveSelection);
    style.caret = ResolveUiSkinColor(palette, UiSkinColorRole::EditCaret);
    style.preedit = ResolveUiSkinColor(palette, UiSkinColorRole::EditPreedit);
}

void PlaceEditPreeditUnderline(in Point textOrigin, in f32 caretWidth, mut Rect segment){
    if(segment.width > 0.0f){
        const f32 thickness = min(caretWidth, segment.height);
        const f32 verticalOffset = textOrigin.y + max(0.0f, segment.height - thickness);
        segment.x += textOrigin.x;
        segment.y += verticalOffset;
        segment.height = thickness;
    }
}

Expected<Rect> TryComputeEditBoxViewport(in Rect bounds, in Insets padding, in Rect clip, in Point previousScroll, in f32 caretWidth){
    if(!IsValidUiRect(bounds) || !IsValidUiRect(clip) || !IsValidUiPadding(padding) || !IsValidUiExtent(previousScroll) || !isFinite(caretWidth) || caretWidth <= 0.0f)
        return makeUnexpected(Failure());
    const f32 firstX = bounds.x + min(padding.left, bounds.width);
    const f32 firstY = bounds.y + min(padding.top, bounds.height);
    const f32 lastX = (bounds.x + bounds.width) - min(padding.right, bounds.width);
    const f32 lastY = (bounds.y + bounds.height) - min(padding.bottom, bounds.height);
    return Rect(firstX, firstY, max(lastX, firstX) - firstX, max(lastY, firstY) - firstY);
}

b8 ValidateEditBoxViewportArrangeInputs(in Rect bounds, in Rect viewport, in Rect clip, in Point previousScroll, in f32 caretWidth){
    if(!IsValidUiRect(bounds) || !IsValidUiRect(viewport) || !IsValidUiRect(clip) || viewport.x < bounds.x || viewport.y < bounds.y)
        return false;
    const VectorSingle end = VectorSingle(viewport.x, viewport.y, bounds.x, bounds.y) + VectorSingle(viewport.width, viewport.height, bounds.width, bounds.height);
    return end.x <= end.z && end.y <= end.w && IsValidUiExtent(previousScroll) && isFinite(caretWidth) && caretWidth > 0.0f;
}

Expected<EditBoxPlacement> TryComputeEditBoxViewportPlacement(
    in Rect bounds,
    in Rect viewport,
    in Rect clip,
    in Point previousScroll,
    in f32 caretWidth,
    in b8 revealCaret,
    in EditTextMode textMode,
    in Rect visualBounds,
    in Point logicalSize,
    in Rect caretRect
){
    EditBoxPlacement placement;
    placement.bounds = bounds;
    placement.frameClip = IntersectUiRectsBounds(bounds, clip);
    placement.content = viewport;
    placement.clip = IntersectUiRectsBounds(viewport, clip);
    const f32 left = viewport.x;
    const f32 top = viewport.y;
    const f32 overhangX = max(0.0f, (visualBounds.x + visualBounds.width) - logicalSize.x);
    const f32 maximumScroll = max(0.0f, (visualBounds.width + caretWidth) - placement.content.width);
    // Scroll offsets start at the visual envelope; reveal its overhang with the logical caret at either text edge.
    const f32 caretEndX = ((caretRect.x - visualBounds.x) + caretWidth) + overhangX;
    if(!isFinite(maximumScroll) || !isFinite(caretEndX))
        return makeUnexpected(Failure());
    f32 scrollX = 0.0f;
    if(previousScroll.x > 0.0f)
        scrollX = min(maximumScroll, previousScroll.x);
    if(revealCaret && caretRect.x < scrollX)
        scrollX = caretRect.x;
    if(revealCaret && caretEndX > scrollX + placement.content.width)
        scrollX = caretEndX - placement.content.width;
    if(scrollX > 0.0f)
        scrollX = min(maximumScroll, scrollX);
    else
        scrollX = 0.0f;
    placement.scroll = scrollX;
    if(textMode == EditTextMode::Multiline){
        const f32 overhangY = max(0.0f, (visualBounds.y + visualBounds.height) - logicalSize.y);
        const f32 maximumScrollY = max(0.0f, visualBounds.height - placement.content.height);
        const f32 caretEndY = ((caretRect.y - visualBounds.y) + caretRect.height) + overhangY;
        if(!isFinite(maximumScrollY) || !isFinite(caretEndY))
            return makeUnexpected(Failure());
        f32 scrollY = 0.0f;
        if(previousScroll.y > 0.0f)
            scrollY = min(maximumScrollY, previousScroll.y);
        if(revealCaret && caretRect.y < scrollY)
            scrollY = caretRect.y;
        if(revealCaret && caretEndY > scrollY + placement.content.height)
            scrollY = caretEndY - placement.content.height;
        if(scrollY > 0.0f)
            scrollY = min(maximumScrollY, scrollY);
        else
            scrollY = 0.0f;
        placement.scrollY = scrollY;
        placement.textOrigin = Point((left - visualBounds.x) - scrollX, (top - visualBounds.y) - scrollY);
    }
    else{
        const f32 verticalOffset = max(0.0f, (placement.content.height - visualBounds.height) * s_RectCenterFraction);
        placement.textOrigin = Point((left - visualBounds.x) - placement.scroll, (top - visualBounds.y) + verticalOffset);
    }
    placement.caret = Rect(placement.textOrigin.x + caretRect.x, placement.textOrigin.y + caretRect.y, caretWidth, caretRect.height);
    return placement;
}

b8 ValidateEditBoxArrangedSegments(in EditBoxPlacement placement, in f32 caretWidth, in Rect selectionIn, in Rect preeditUnderlineIn, in b8 composing){
    Rect selection = selectionIn;
    Rect preeditUnderline = preeditUnderlineIn;
    if(selection.width > 0.0f){
        selection.x += placement.textOrigin.x;
        selection.y += placement.textOrigin.y;
    }
    if(composing)
        PlaceEditPreeditUnderline(placement.textOrigin, caretWidth, preeditUnderline);
    return IsValidUiRect(placement.caret) && IsValidUiRect(selection) && IsValidUiRect(preeditUnderline) && isFinite(placement.textOrigin.x) && isFinite(placement.textOrigin.y);
}

b8 IsValidEditBoxPaintStyle(in EditBoxStyle style){
    return IsValidPaintColor(style.background)
        && IsValidPaintColor(style.text)
        && IsValidPaintColor(style.disabledText)
        && IsValidPaintColor(style.selection)
        && IsValidPaintColor(style.inactiveSelection)
        && IsValidPaintColor(style.caret)
        && IsValidPaintColor(style.preedit);
}

Name ResolvePreferredEditBoxBackgroundName(in EditBoxStyle style, in EditBoxPaintFlags flags){
    if(!flags.enabled)
        return style.disabled;
    if(flags.focused)
        return style.focused;
    if(flags.hovered)
        return style.hover;
    return style.normal;
}

Expected<b8> ValidateTextAreaNavigationInputs(
    in EditTextMode textMode,
    in b8 compositionActive,
    in EditNavigationDirection direction,
    in f32 fontSize,
    in f32 viewportHeight,
    in EditNavigationSnapshot preferred
){
    const b8 page = direction == EditNavigationDirection::PageUp || direction == EditNavigationDirection::PageDown;
    if(
        textMode != EditTextMode::Multiline
        || compositionActive
        || cast<u8>(direction) > cast<u8>(EditNavigationDirection::PageDown)
        || !isFinite(fontSize)
        || fontSize <= 0.0f
        || !isFinite(viewportHeight)
        || viewportHeight < 0.0f
        || (page && viewportHeight == 0.0f)
        || !isFinite(preferred.preferredX)
    )
        return makeUnexpected(Failure());
    return page;
}

Expected<f32> TryResolveTextAreaPreferredX(in EditNavigationSnapshot preferred, in Rect caret){
    f32 outPreferredX = caret.x;
    if(preferred.valid)
        outPreferredX = preferred.preferredX;
    if(!isFinite(outPreferredX))
        return makeUnexpected(Failure());
    return outPreferredX;
}

b8 TryResolveEditBoxSnapshotSizes(
    in usize committedBytes,
    in EditCompositionView composition,
    mut usize outReplaced,
    mut usize outPreeditBytes,
    mut usize outDisplayBytes
){
    outReplaced = 0u;
    outPreeditBytes = 0u;
    outDisplayBytes = 0u;
    if(composition.active){
        outReplaced = composition.replacementEnd - composition.replacementStart;
        outPreeditBytes = composition.text.size();
    }
    if(committedBytes > s_TextMaxBytes || outPreeditBytes > s_TextMaxBytes - (committedBytes - outReplaced))
        return false;
    outDisplayBytes = (committedBytes - outReplaced) + outPreeditBytes;
    return true;
}

EditCaretMapping MakeEditCaretMapping(in usize committedByte, in usize displayByte){
    EditCaretMapping item;
    item.committedByte = committedByte;
    item.displayByte = displayByte;
    return item;
}

b8 BuildEditBoxSnapshotInto(
    in StringView committed,
    in Span<usize> graphemeBoundaries,
    in EditCompositionView composition,
    in EditTextMode textMode,
    mut String outDisplay,
    mut Vector<EditCaretMapping> outStops,
    mut usize outPreeditBytes
){
    usize replaced = 0u;
    usize preeditBytes = 0u;
    usize displayBytes = 0u;
    if(!TryResolveEditBoxSnapshotSizes(committed.size(), composition, replaced, preeditBytes, displayBytes))
        return false;
    outDisplay.clear();
    outDisplay.reserve(displayBytes);
    if(composition.active){
        outDisplay.append(committed.substr(0u, composition.replacementStart));
        if(preeditBytes != 0u)
            outDisplay.append(composition.text.substr(0u, preeditBytes));
        outDisplay.append(committed.substr(composition.replacementEnd, committed.size() - composition.replacementEnd));
    }
    else if(!committed.empty())
        outDisplay.assign(committed);
    if(!ValidateEditTextForMode(outDisplay, textMode))
        return false;
    outStops.clear();
    outStops.reserve(graphemeBoundaries.size() + 1u);
    for(in usize boundary : graphemeBoundaries){
        if(!composition.active || boundary <= composition.replacementStart)
            outStops.push_back(MakeEditCaretMapping(boundary, boundary));
        if(composition.active && boundary >= composition.replacementEnd)
            outStops.push_back(MakeEditCaretMapping(boundary, boundary - replaced + preeditBytes));
    }
    outPreeditBytes = preeditBytes;
    return true;
}

void ResolveEditBoxSnapshotRanges(
    in EditCompositionView composition,
    in usize preeditBytes,
    in usize modelSelectionStart,
    in usize modelSelectionEnd,
    in usize modelCaret,
    mut EditBoxRange outPreedit,
    mut EditBoxRange outReplacement,
    mut EditBoxRange outSelection,
    mut usize outCaret
){
    outPreedit = EditBoxRange();
    outReplacement = EditBoxRange();
    outSelection = EditBoxRange();
    outCaret = modelCaret;
    if(composition.active){
        outPreedit.begin = composition.replacementStart;
        outPreedit.end = composition.replacementStart + preeditBytes;
        outReplacement.begin = composition.replacementStart;
        outReplacement.end = composition.replacementEnd;
        outSelection.begin = outPreedit.begin + min(composition.anchor, composition.caret);
        outSelection.end = outPreedit.begin + max(composition.anchor, composition.caret);
        outCaret = outPreedit.begin + composition.caret;
    }
    else{
        outSelection.begin = modelSelectionStart;
        outSelection.end = modelSelectionEnd;
    }
}

b8 ShouldPaintEditBoxCaret(in EditBoxPaintFlags flags, in b8 composing){
    if(!flags.focused || !flags.enabled || flags.readOnly)
        return false;
    if(composing)
        return flags.preeditCaretVisible;
    return flags.caretVisible;
}

void OffsetEditBoxSegmentOrigin(in Point textOrigin, mut Rect inOutSegment){
    inOutSegment.x += textOrigin.x;
    inOutSegment.y += textOrigin.y;
}


