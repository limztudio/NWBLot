#include <impl/ecs_mesh/skinning/runtime_instance.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets/graphics/skinned_mesh/constants.h>

#include <core/alloc/scratch.h>
#include <core/common/log.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct alignas(NWB_SKINNED_MESH_SKIN_INFLUENCE_ALIGNMENT) MeshSkinningInfluenceGpu{
    Array<u32, NWB_SKINNED_MESH_SKIN_JOINT_WORD_COUNT> packedJoint{};
    Float4U weight{};
};
static_assert(sizeof(MeshSkinningInfluenceGpu) == NWB_SKINNED_MESH_SKIN_INFLUENCE_BYTE_SIZE, "MeshSkinning influence GPU layout drifted");
static_assert(alignof(MeshSkinningInfluenceGpu) == NWB_SKINNED_MESH_SKIN_INFLUENCE_ALIGNMENT, "MeshSkinning influence GPU alignment must match the packed uint2");
static_assert(offsetof(MeshSkinningInfluenceGpu, packedJoint) == 0u, "MeshSkinning packed joints must lead each GPU record");
static_assert(offsetof(MeshSkinningInfluenceGpu, weight) == NWB_SKINNED_MESH_SKIN_WEIGHT_BYTE_OFFSET, "MeshSkinning FP32 weights must follow the packed joints");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace MeshSkinningPayload{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Encode mesh-owned data only when creating its GPU buffer.
[[nodiscard]] FOUNDATION_INLINE Expected<Vector<MeshSkinningInfluenceGpu, Core::Alloc::ScratchArena>> BuildSkinInfluences(const MeshSkinningRuntimeInstance& instance, Core::Alloc::ScratchArena& arena){
    Vector<MeshSkinningInfluenceGpu, Core::Alloc::ScratchArena> influences(arena);
    if(!ValidateMeshSkinningInfluenceStream(instance.handle.value, instance.skeletonJointCount, instance.skin))
        return MakeUnexpected(Failure{});
    if(instance.skin.empty())
        return influences;

    influences.reserve(instance.skin.size());
    for(const SkinInfluence4& sourceSkin : instance.skin)
        influences.push_back(MeshSkinningInfluenceGpu{ PackSkinInfluenceJoints(sourceSkin), sourceSkin.weight });
    return influences;
}

// Source validation and deformation snapshots keep every row; GPU reads only joints referenced by this Skin.
[[nodiscard]] FOUNDATION_INLINE Expected<Span<const SkeletonJointMatrix>> ResolveGpuJointPalette(const MeshSkinningRuntimeInstance& instance, const RuntimeSkinPayloadScratch& payload)noexcept{
    return ResolveMeshSkinningGpuJointPalette(instance, payload);
}

template<typename VectorArenaT>
[[nodiscard]] FOUNDATION_INLINE b8 BuildSkinJointPalette(
    const MeshSkinningRuntimeInstance& instance,
    const Span<const SkeletonJointMatrix> sourceJoints,
    const u32 skinningMode,
    Vector<SkeletonJointMatrix, VectorArenaT>& outJointPalette
){
    return BuildMeshSkinningJointPalette(instance, sourceJoints, skinningMode, outJointPalette);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] FOUNDATION_INLINE b8 BuildRuntimeSkinPayload(const MeshSkinningRuntimeInstance& instance, const SkeletonJointPaletteComponent* jointPalette, const SkeletonPoseComponent* skeletonPose, RuntimeSkinPayloadScratch& payload){
    if(skeletonPose && HasSkeletonPoseData(*skeletonPose))
        return PopulateRuntimeSkinPayloadFromPose(instance, *skeletonPose, payload);

    if(jointPalette)
        return PopulateRuntimeSkinPayloadFromPalette(instance, *jointPalette, payload);

    payload.skinInfluenceCount = 0u;
    payload.jointMatrices.clear();
    payload.poseJoints.clear();
    payload.resolvedSkinningMode = static_cast<u32>(SkeletonSkinningMode::LinearBlend);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


