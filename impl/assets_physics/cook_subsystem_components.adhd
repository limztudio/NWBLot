Expected<SoftBodyComponentCookEntry> ParseSoftBodyComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue value){
    SoftBodyComponentCookEntry entry;
    if(!ValidateOptionalSceneMetadataMap(file, value, s_SoftBodyComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_SoftBodyComponentDiagnosticPrefix, entry))
        return MakeUnexpected(Failure());

    if(value.isMap()){
        if(!value.forEachMapEntry(lambda[in file, mut entry](in StringView key, in MetascriptValue fieldVal) -> b8{
            mut SoftBody s = entry.component.softBody;
            if(key == "enabled") return ReadPhysicsBoolValue(file, fieldVal, s_SoftBodyComponentDiagnosticPrefix, key, entry.component.enabled);
            if(key == "collide_with_world") return ReadPhysicsBoolValue(file, fieldVal, s_SoftBodyComponentDiagnosticPrefix, key, s.collideWithWorld);
            if(key == "particle_radius") return ReadPhysicsF32Value(file, fieldVal, s_SoftBodyComponentDiagnosticPrefix, key, s.particleRadius);
            if(key == "damping") return ReadPhysicsF32Value(file, fieldVal, s_SoftBodyComponentDiagnosticPrefix, key, s.damping);
            if(key == "aerodynamic_drag") return ReadPhysicsF32Value(file, fieldVal, s_SoftBodyComponentDiagnosticPrefix, key, s.aerodynamicDrag);
            if(key == "friction") return ReadPhysicsF32Value(file, fieldVal, s_SoftBodyComponentDiagnosticPrefix, key, s.friction);
            if(key == "restitution") return ReadPhysicsF32Value(file, fieldVal, s_SoftBodyComponentDiagnosticPrefix, key, s.restitution);
            if(key == "sub_steps") return ReadPhysicsU32Value(file, fieldVal, s_SoftBodyComponentDiagnosticPrefix, key, s.subSteps);
            if(key == "solver_iterations") return ReadPhysicsU32Value(file, fieldVal, s_SoftBodyComponentDiagnosticPrefix, key, s.solverIterations);
            if(key == "collision_filter") return ParsePhysicsFilterMap(file, fieldVal, s_SoftBodyComponentDiagnosticPrefix, s.collisionFilter);
            if(key == "particles"){
                if(!fieldVal.isList()){
                    error("{} '{}': field 'particles' must be a list", s_SoftBodyComponentDiagnosticPrefix, PathToString(file));
                    return false;
                }
                const Span<MetascriptValue> items = fieldVal.listView();
                s.particles.clear();
                s.particles.resize(items.size());
                for(usize i = 0u; i < items.size(); ++i){
                    if(!items[i].isMap() || !ParseSoftBodyParticleMap(file, items[i], s.particles[i]))
                        return false;
                }
                return true;
            }
            if(key == "distance_constraints"){
                if(!fieldVal.isList()){
                    error("{} '{}': field 'distance_constraints' must be a list", s_SoftBodyComponentDiagnosticPrefix, PathToString(file));
                    return false;
                }
                const Span<MetascriptValue> items = fieldVal.listView();
                s.distanceConstraints.clear();
                s.distanceConstraints.resize(items.size());
                for(usize i = 0u; i < items.size(); ++i){
                    if(!items[i].isMap())
                        return false;
                    mut SoftBodyDistanceConstraint dc = s.distanceConstraints[i];
                    if(!ParseSoftBodyPairConstraintMap(file, items[i], dc.p0, dc.p1, dc.restLength, dc.compliance, dc.lambda))
                        return false;
                }
                return true;
            }
            if(key == "bending_constraints"){
                if(!fieldVal.isList()){
                    error("{} '{}': field 'bending_constraints' must be a list", s_SoftBodyComponentDiagnosticPrefix, PathToString(file));
                    return false;
                }
                const Span<MetascriptValue> items = fieldVal.listView();
                s.bendingConstraints.clear();
                s.bendingConstraints.resize(items.size());
                for(usize i = 0u; i < items.size(); ++i){
                    if(!items[i].isMap())
                        return false;
                    mut SoftBodyBendingConstraint bc = s.bendingConstraints[i];
                    if(!ParseSoftBodyPairConstraintMap(file, items[i], bc.p0, bc.p1, bc.restLength, bc.compliance, bc.lambda))
                        return false;
                }
                return true;
            }
            if(key == "volume_constraints"){
                if(!fieldVal.isList()){
                    error("{} '{}': field 'volume_constraints' must be a list", s_SoftBodyComponentDiagnosticPrefix, PathToString(file));
                    return false;
                }
                const Span<MetascriptValue> items = fieldVal.listView();
                s.volumeConstraints.clear();
                s.volumeConstraints.resize(items.size());
                for(usize i = 0u; i < items.size(); ++i){
                    if(!items[i].isMap() || !ParseSoftBodyVolumeConstraintMap(file, items[i], s.volumeConstraints[i]))
                        return false;
                }
                return true;
            }
            if(key == "surface_triangles"){
                if(!fieldVal.isList()){
                    error("{} '{}': field 'surface_triangles' must be a list", s_SoftBodyComponentDiagnosticPrefix, PathToString(file));
                    return false;
                }
                const Span<MetascriptValue> items = fieldVal.listView();
                s.surfaceTriangles.clear();
                s.surfaceTriangles.resize(items.size());
                for(usize i = 0u; i < items.size(); ++i){
                    if(!items[i].isMap() || !ParseSoftBodyTriangleMap(file, items[i], s.surfaceTriangles[i]))
                        return false;
                }
                return true;
            }
            if(key == "attachments"){
                if(!fieldVal.isList()){
                    error("{} '{}': field 'attachments' must be a list", s_SoftBodyComponentDiagnosticPrefix, PathToString(file));
                    return false;
                }
                const Span<MetascriptValue> items = fieldVal.listView();
                s.attachments.clear();
                s.attachments.resize(items.size());
                for(usize i = 0u; i < items.size(); ++i){
                    if(!items[i].isMap() || !ParseSoftBodyAttachmentMap(file, items[i], s.attachments[i]))
                        return false;
                }
                return true;
            }
            error("{} '{}': unsupported asset field '{}'", s_SoftBodyComponentDiagnosticPrefix, PathToString(file), key);
            return false;
        }))
            return MakeUnexpected(Failure());
    }

    if(!SubsystemPhysicsComponentBinaryCodec().validateSoftBody(entry.component, entry.virtualPath))
        return MakeUnexpected(Failure());
    return entry;
}

Expected<GpuRenderTransformExportComponentCookEntry> ParseGpuRenderTransformExportComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue value){
    GpuRenderTransformExportComponentCookEntry entry;
    if(!ValidateOptionalSceneMetadataMap(file, value, s_GpuRenderTransformExportComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_GpuRenderTransformExportComponentDiagnosticPrefix, entry))
        return MakeUnexpected(Failure());

    if(value.isMap()){
        if(!value.forEachMapEntry(lambda[in file, mut entry](in StringView key, in MetascriptValue fieldVal) -> b8{
            if(key == "enabled") return ReadPhysicsBoolValue(file, fieldVal, s_GpuRenderTransformExportComponentDiagnosticPrefix, key, entry.component.enabled);
            if(key == "instance_index") return ReadPhysicsU32Value(file, fieldVal, s_GpuRenderTransformExportComponentDiagnosticPrefix, key, entry.component.instanceIndex);
            if(key == "flags") return ReadPhysicsU32Value(file, fieldVal, s_GpuRenderTransformExportComponentDiagnosticPrefix, key, entry.component.flags);
            if(key == "local_scale"){
                const Expected<VectorSingle> v = DecodePhysicsFloat3Value(file, fieldVal, s_GpuRenderTransformExportComponentDiagnosticPrefix, key);
                if(!v.has_value()) return false;
                entry.component.localScale = f32x4(v.value(), 0.0f);
                return true;
            }
            error("{} '{}': unsupported asset field '{}'", s_GpuRenderTransformExportComponentDiagnosticPrefix, PathToString(file), key);
            return false;
        }))
            return MakeUnexpected(Failure());
    }

    if(!SubsystemPhysicsComponentBinaryCodec().validateGpuRenderTransformExport(entry.component, entry.virtualPath))
        return MakeUnexpected(Failure());
    return entry;
}


