void VerifyUiImageLayoutTests_NineSliceMinimumsRemainLogicalAndCanExceedTheNaturalExtent(){
    UiSkinRegion region = MakeUiImageLayoutSprite();
    region.drawMode = UiSkinDrawMode::NineSlice;
    region.sliceInsets.left = 20u;
    region.sliceInsets.top = 10u;
    region.sliceInsets.right = 30u;
    region.sliceInsets.bottom = 15u;
    region.minimumWidth = 120.0f;
    region.minimumHeight = 30.0f;
    const Expected<ImageMetrics> metricsResult = MeasureImage(ImageOptions(), region, 2.0f);
    ASSERT_TRUE(metricsResult.has_value());
    ExpectUiImageLayoutMetrics(metricsResult.value(), 120.0f, 50.0f);
    region.minimumHeight = 80.0f;
    const Expected<ImageMetrics> metricsResult2 = MeasureImage(ImageOptions(), region, 2.0f);
    ASSERT_TRUE(metricsResult2.has_value());
    ExpectUiImageLayoutMetrics(metricsResult2.value(), 120.0f, 80.0f);
}

void VerifyUiImageLayoutTests_EmptyAndDisjointClipsRemainValidAtFiniteNegativeOrigins(){
    const Rect bounds = MakeUiHorizImageRect(-100.0f, -50.0f, 200.0f, 100.0f);
    const Expected<ImagePlacement> placementResult = PlaceImage(bounds, MakeUiHorizImageRect(150.0f, 0.0f, 20.0f, 20.0f));
    ASSERT_TRUE(placementResult.has_value());
    ExpectUiRectExact(placementResult.value().bounds, bounds);
    ExpectUiRectExact(placementResult.value().clip, MakeUiHorizImageRect(150.0f, 0.0f, 0.0f, 20.0f));
    const Rect emptyBounds = MakeUiHorizImageRect(-10.0f, -20.0f, 0.0f, 0.0f);
    const Expected<ImagePlacement> placementResult2 = PlaceImage(emptyBounds, bounds);
    ASSERT_TRUE(placementResult2.has_value());
    ExpectUiRectExact(placementResult2.value().bounds, emptyBounds);
    ExpectUiRectExact(placementResult2.value().clip, placementResult2.value().bounds);
}

void VerifyUiImageLayoutTests_SubnormalPositiveBoundsAndExtremeFiniteEndpointsRemainValid(){
    const f32 tiny = bit_cast<f32>(1u);
    const Rect small = MakeUiHorizImageRect(0.0f, 0.0f, tiny, tiny);
    const Expected<ImagePlacement> placementResult = PlaceImage(small, small);
    ASSERT_TRUE(placementResult.has_value());
    ExpectUiRectExact(placementResult.value().bounds, small);
    ExpectUiRectExact(placementResult.value().clip, small);
    const Rect large = MakeUiHorizImageRect(-f32.max, 0.0f, f32.max, 1.0f);
    const Expected<ImagePlacement> placementResult2 = PlaceImage(large, large);
    ASSERT_TRUE(placementResult2.has_value());
    ExpectUiRectExact(placementResult2.value().bounds, large);
    ExpectUiRectExact(placementResult2.value().clip, large);
}

void VerifyUiImageLayoutTests_InvalidLayoutSizesTintsAndDensityRejectMeasurement(){
    const UiSkinRegion region = MakeUiImageLayoutSprite();
    for(u32 field = 0u; field < 15u; ++field){
        ImageOptions options = ImageOptions();
        f32 density = 2.0f;
        switch(field){
            case 0u: options.width.policy = MakeUiInvalidLayoutSizePolicy(); break;
            case 1u: options.height.policy = MakeUiInvalidLayoutSizePolicy(); break;
            case 2u: options.width.value = -1.0f; break;
            case 3u:
                options.height.policy = LayoutSizePolicy::Stretch;
                options.height.value = 0.0f;
                break;
            case 4u: options.width.value = UiHorizImageQuietNaNF32(); break;
            case 5u: options.height.value = UiHorizImageInfinityF32(); break;
            case 6u: options.tint.r = -1.0f; break;
            case 7u: options.tint.g = UiHorizImageInfinityF32(); break;
            case 8u: options.tint.b = UiHorizImageQuietNaNF32(); break;
            case 9u: options.tint.a = 1.01f; break;
            case 10u: options.tint.a = -0.01f; break;
            case 11u: density = 0.0f; break;
            case 12u: density = -1.0f; break;
            case 13u: density = UiHorizImageInfinityF32(); break;
            default: density = UiHorizImageQuietNaNF32(); break;
        }
        EXPECT_FALSE(MeasureImage(options, region, density).has_value());
    }
}

void VerifyUiImageLayoutTests_InvalidRegionExtentMinimumsAndSliceMetadataRejectMeasurement(){
    const UiSkinRegion valid = MakeUiImageLayoutSprite();
    for(u32 field = 0u; field < 8u; ++field){
        UiSkinRegion region = valid;
        switch(field){
            case 0u: region.rectangle.width = 0u; break;
            case 1u: region.rectangle.height = 0u; break;
            case 2u: region.minimumWidth = -1.0f; break;
            case 3u: region.minimumHeight = UiHorizImageQuietNaNF32(); break;
            case 4u: region.minimumWidth = UiHorizImageInfinityF32(); break;
            case 5u: region.drawMode = MakeUiInvalidSkinDrawMode(); break;
            case 6u: region.sliceInsets.left = 1u; break;
            default:
                region.drawMode = UiSkinDrawMode::NineSlice;
                region.sliceInsets.bottom = 101u;
                break;
        }
        EXPECT_FALSE(MeasureImage(ImageOptions(), region, 2.0f).has_value());
    }
    UiSkinRegion region = valid;
    region.drawMode = UiSkinDrawMode::NineSlice;
    region.rectangle.width = u32.max;
    region.sliceInsets.left = u32.max;
    region.sliceInsets.right = u32.max;
    EXPECT_FALSE(MeasureImage(ImageOptions(), region, 2.0f).has_value());
}

void VerifyUiImageLayoutTests_UnrepresentableNaturalExtentRejectsMeasurement(){
    const UiSkinRegion region = MakeUiImageLayoutSprite();
    EXPECT_FALSE(MeasureImage(ImageOptions(), region, bit_cast<f32>(1u)).has_value());
}

void VerifyUiImageLayoutTests_InvalidAndCollapsedProspectiveEndpointsRejectPlacement(){
    const Rect normal = MakeUiHorizImageRect(10.0f, 20.0f, 200.0f, 100.0f);
    Array<Rect, 7u> invalidList = Array<Rect, 7u>();
    invalidList[0u] = MakeUiHorizImageRect(UiHorizImageQuietNaNF32(), 0.0f, 1.0f, 1.0f);
    invalidList[1u] = MakeUiHorizImageRect(0.0f, UiHorizImageInfinityF32(), 1.0f, 1.0f);
    invalidList[2u] = MakeUiHorizImageRect(0.0f, 0.0f, -1.0f, 1.0f);
    invalidList[3u] = MakeUiHorizImageRect(0.0f, 0.0f, 1.0f, -1.0f);
    invalidList[4u] = MakeUiHorizImageRect(f32.max, 0.0f, f32.max, 1.0f);
    invalidList[5u] = MakeUiHorizImageRect(f32.max, 0.0f, 1.0f, 1.0f);
    invalidList[6u] = MakeUiHorizImageRect(0.0f, f32.max, 1.0f, 1.0f);
    for(in Rect invalid : invalidList){
        EXPECT_FALSE(PlaceImage(invalid, normal).has_value());
        EXPECT_FALSE(PlaceImage(normal, invalid).has_value());
    }
}


