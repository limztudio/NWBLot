    public u32 p2 = 0u;
    public u32 p3 = 0u;
    public f32 restVolume = 0.0f;
    public f32 compliance = 0.0f;
    public f32 lambda = 0.0f;
    public f32 youngsModulus = 0.0f;
    public f32 poissonsRatio = 0.35f;
    public f32 plasticYield = 0.0f;
    public f32 plasticCreep = 0.0f;
