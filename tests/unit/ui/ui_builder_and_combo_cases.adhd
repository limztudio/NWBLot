}

void VerifyUiComboBehaviorTests_RemovedOrDisabledCommittedKeyClearsOnRevisionWithoutCommittingPreview(){
    UiComboBehaviorSource source = UiComboBehaviorSource();
    ComboState state = ComboState();
    state.select(4u);
    ASSERT_TRUE(UiComboBehaviorReconcile(state, source));
    UiComboBehaviorOpen(state);
    ASSERT_TRUE(UiComboBehaviorNavigate(source, ControlActionKind::Down, state));
    source.disabledKey = 4u;
    ++source.revisionValue;
    ASSERT_TRUE(UiComboBehaviorReconcile(state, source));
    ASSERT_TRUE(UiComboBehaviorReconcilePreview(state, source));
    EXPECT_EQ(state.selectedKey(), 0u);
    EXPECT_EQ(state.listState().cursorKey(), 5u);
    EXPECT_TRUE(state.isOpen());
    UiComboBehaviorClose(state);
    EXPECT_EQ(state.listState().cursorKey(), 0u);
    state.select(5u);
    source.count = 4u;
    ++source.revisionValue;
    ASSERT_TRUE(UiComboBehaviorReconcile(state, source));
    EXPECT_EQ(state.selectedKey(), 0u);
}

void VerifyUiComboBehaviorTests_ReplacingEstablishedSourceClosesAndClearsSelectionPreviewAndScroll(){
    UiComboBehaviorSource source = UiComboBehaviorSource();
    ComboState state = ComboState();
    state.select(10u);
    ASSERT_TRUE(UiComboBehaviorReconcile(state, source));
    UiComboBehaviorOpen(state);
    ASSERT_TRUE(UiComboBehaviorReconcilePreview(state, source));
    ASSERT_TRUE(UiComboBehaviorScrollPreviewTo(state, 120.0));
    ASSERT_GT(state.listState().scrollOffset(), 0.0);
    const u64 inputGeneration = state.inputGeneration();
    ++source.generation;
    ASSERT_TRUE(UiComboBehaviorReconcile(state, source));
    EXPECT_EQ(state.selectedKey(), 0u);
    EXPECT_EQ(state.listState().selectedKey(), 0u);
    EXPECT_EQ(state.listState().cursorKey(), 0u);
    EXPECT_DOUBLE_EQ(state.listState().scrollOffset(), 0.0);
    EXPECT_EQ(state.inputGeneration(), inputGeneration);
    EXPECT_FALSE(state.isOpen());
}

void VerifyUiComboBehaviorTests_EmptyDatasetClearsSelectionAndDoesNotInventACommit(){
