    CompactString text;
    AppendUnsignedDecimal(text, index);
    return DeriveName(s_AssetCaseProjectGather, text.view());
}

[ordered]
class GatherInputs{
    public ScratchStorage m_scratchArena(s_AssetCaseTestsAssetsGraphicsGatherInputs);
    private HeapStorage storage;
    public CapturingLogger m_logger;
    private LoggerRegistrationGuard loggerGuard(this.m_logger, LoggerBreakPolicy::BreakOnFatal);
    private Path root;
    public AssetGatherOptions m_options;

    public void setup(){
        CompactString key;
        AppendHexU32(cast<u32>(ComputeFnv64Text(GraphicsCurrentTestName())), key);
        this.root = GraphicsRepoPath() / "__build_obj" / "g" / key.view();
        this.m_options.outputDirectory = PathToString(this.root / "out");
        this.m_options.configuration = CompactString("tests");
        this.resetMergeCallCount();
    }

    public void writeInputs(in StringView directory, in usize count, in usize payloadSize, in u8 seed){
        AssetCookWorkspace workspace(s_AssetCaseTestsAssetsGraphicsBuiltInputs);
        CookVolumeManifest volume(workspace);
        ASSERT_TRUE(volume.reserve(count));
        Vector<u8> bytes;
        bytes.resize(payloadSize, seed);
        for(usize i = 0u; i < count; ++i){
            if(!bytes.empty())
                bytes[0u] = cast<u8>(seed + i);
            const auto name = GatherInputAssetName(i);
            ASSERT_TRUE(name.has_value());
            ASSERT_TRUE(volume.append(name.value(), bytes));
        }
        const Path input = this.root / directory;
        ASSERT_TRUE(volume.writeBuiltAssets(OwnGraphicsPath(this.storage, input)));
        this.m_options.inputs.emplace_back(PathToString(input));
    }

    public void verifyPayloads(in usize count, in usize payloadSize, in u8 seed){
        VolumeMountDesc desc(this.storage);
        EXPECT_TRUE(desc.volumeName.assign("graphics"));
        desc.mountDirectory = OwnGraphicsPath(this.storage, this.root / "out");
        auto result = CreateVolumeFilesystem(this.storage, desc);
        ASSERT_TRUE(result.has_value());
        mut IFilesystem filesystem = result.value().deref();
        ASSERT_TRUE(filesystem.mounted());
        EXPECT_EQ(filesystem.fileCount(), count);
        Vector<u8> bytes;
        for(usize i = 0u; i < count; ++i){
            const auto name = GatherInputAssetName(i);
            ASSERT_TRUE(name.has_value());
            ASSERT_TRUE(filesystem.readFile(name.value(), bytes));
            ASSERT_EQ(bytes.size(), payloadSize);
            if(!bytes.empty())
                EXPECT_EQ(bytes.front(), cast<u8>(seed + i));
            if(bytes.size() > 1u)
                EXPECT_EQ(bytes.back(), seed);
        }
        EXPECT_TRUE(filesystem.unmount());
    }

    public void addRawInput(in StringView input){ this.m_options.inputs.emplace_back(input); }
    public void duplicateFirstInput(){ this.m_options.inputs.push_back(this.m_options.inputs.front()); }
    public void enableTestMerge(){ this.m_options.mergePayloads = BindGatherMerge<GatherBytesMerge>(); }
    public usize mergeCallCount()const{ return TestProcessValue<GatherMergeCount>().calls; }
    public void resetMergeCallCount(){ TestProcessValue<GatherMergeCount>().calls = 0u; }
    public b8 hasFatalFailure()const{ return HasFatalTestFailure(); }
    public AssetTestVector<AssetString> makeInputStrings(){ return this.storage.makeValue<AssetTestVector<AssetString>>(); }
    public void appendInputString(in StringView text, mut AssetTestVector<AssetString> list){ list.emplace_back(text, this.storage); }

    public b8 writeDuplicateEntryManifestVolume(in Name name){
        AssetCookWorkspace workspace(s_AssetCaseTestsAssetsGraphicsGatherInputs);
        CookVolumeManifest volume(workspace);
        if(!volume.reserve(2u))
            return false;
        const Array<u8, 1u> first(7u);
        const Array<u8, 1u> second(8u);
        if(!AppendTestCookPayload(name, first, volume.manifest, 1u)
            || !AppendTestCookPayload(name, second, volume.manifest, 1u))
            return false;
        return volume.writeVolume(this.root / "out", "tests").has_value();
    }
}

