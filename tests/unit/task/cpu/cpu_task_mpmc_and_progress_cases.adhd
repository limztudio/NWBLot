#include <tests/common/gtest_macros.adhd>
#include <tests/unit/task/cpu/suite.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyCpuTaskMpmcTests_OwnerExternalAndWorkerProducersShareQueuesWithoutLosingOrRepeatingTasks(){
    const u32 workerCount = s_MpmcWorkerCount;
    const u32 externalProducerCount = s_MpmcExternalProducerCount;
    const u32 producerCount = s_MpmcProducerCount;
    const u32 tasksPerProducer = s_MpmcTasksPerProducer;
    const u32 expectedWorkerMask = (1u << workerCount) - 1u;
    const usize expectedVisitSlots = cast<usize>(producerCount * tasksPerProducer * 4u);
    const TestSchedulerConfig config = HomogeneousWorkers(workerCount);
    b8 readyReached = false;
    u32 observedWorkerMask = 0u;
    b8 expired = true;
    b8 rejected = true;
    b8 invalidOrder = true;
    u32 consumedPrefixMask = 0u;
    Vector<u32> visitCounts = Vector<u32>();
    visitCounts.reserve(expectedVisitSlots);
    u64 completedTasks = 0u;
    usize outstandingTasks = 1u;
    native(
        in config,
        in workerCount,
        in externalProducerCount,
        in producerCount,
        mut readyReached,
        mut observedWorkerMask,
        mut expired,
        mut rejected,
        mut invalidOrder,
        mut consumedPrefixMask,
        mut visitCounts,
        mut completedTasks,
        mut outstandingTasks
    ){
        using namespace CpuTaskMpmcTestSupport;
        DeadlineGuard deadline(false, s_WatchdogTimeoutMS);
        ProducerState state;
        CpuTaskScheduler scheduler(config);
        CpuTaskScope scope(scheduler);
        Array<JoiningThread, s_ExternalProducerCount> producers;
        ScopeExit stopProducers([&]()noexcept {
            state.start.store(true, MemoryOrder::release);
            for(auto& producer : producers){
                if(producer.joinable())
                    producer.join();
            }
            scheduler.drain();
        });

        for(u32 producer = 0u; producer < workerCount; ++producer){
            const auto cpuTaskAdmission = scope.submit([&, producer]() {
                const usize worker = scheduler.currentWorkerIndex();
                if(worker >= 1u && worker <= workerCount)
                    state.workerMask.fetch_or(1u << (worker - 1u), MemoryOrder::release);
                state.ready.fetch_add(1u, MemoryOrder::release);
                Produce(scheduler, scope, state, 1u + externalProducerCount + producer);
            }, { .cost = CpuTaskCost::Any });
            EXPECT_TRUE(cpuTaskAdmission);
            if(cpuTaskAdmission)
                EXPECT_TRUE(cpuTaskAdmission->valid());
        }
        for(u32 producer = 0u; producer < externalProducerCount; ++producer){
            producers[producer] = JoiningThread([&, producer]() {
                state.ready.fetch_add(1u, MemoryOrder::release);
                Produce(scheduler, scope, state, 1u + producer);
            });
        }
        readyReached = WaitUntil([&]()noexcept { return state.ready.load(MemoryOrder::acquire) == producerCount - 1u; });
        observedWorkerMask = state.workerMask.load(MemoryOrder::acquire);
        state.start.store(true, MemoryOrder::release);
        Produce(scheduler, scope, state, 0u);
        for(auto& producer : producers)
            producer.join();
        scope.wait();
        scheduler.wait();
        stopProducers.release();

        expired = state.expired.load(MemoryOrder::acquire);
        rejected = state.rejected.load(MemoryOrder::acquire);
        invalidOrder = state.invalidOrder.load(MemoryOrder::acquire);
        consumedPrefixMask = state.consumedPrefixMask.load(MemoryOrder::acquire);
        for(const auto& visits : state.visits)
            visitCounts.push_back(visits.load(MemoryOrder::acquire));
        completedTasks = scheduler.statistics().completedTasks;
        outstandingTasks = scheduler.statistics().outstandingTasks;
    }
    EXPECT_TRUE(readyReached);
    EXPECT_EQ(observedWorkerMask, expectedWorkerMask);
    EXPECT_FALSE(expired);
    EXPECT_FALSE(rejected);
    EXPECT_FALSE(invalidOrder);
    EXPECT_EQ(consumedPrefixMask, expectedWorkerMask);
    ASSERT_EQ(visitCounts.size(), expectedVisitSlots);
    for(in u32 count : visitCounts)
        EXPECT_EQ(count, 1u);
    EXPECT_EQ(completedTasks, cast<u64>(workerCount + producerCount * tasksPerProducer * 4u));
    EXPECT_EQ(outstandingTasks, 0u);
}

void VerifyCpuTaskMpmcTests_ExternalProducersCanWaitForMainThreadTasksWhileTheOwnerPumps(){
    const u32 workerCount = s_MpmcWorkerCount;
    const u32 externalProducerCount = s_MpmcExternalProducerCount;
    const u32 tasksPerProducer = s_MpmcTasksPerProducer;
    const u32 joinKinds = 3u;
    const usize expectedVisitSlots = cast<usize>(externalProducerCount * tasksPerProducer);
    const TestSchedulerConfig config = HomogeneousWorkers(workerCount);
    b8 readyReached = false;
    b8 firstPublishedReached = false;
    u32 invokedBeforePump = 1u;
    b8 expired = true;
    b8 rejected = true;
    b8 wrongThread = true;
    u32 totalInvoked = 0u;
    Vector<u32> visitCounts = Vector<u32>();
    visitCounts.reserve(expectedVisitSlots);
    usize outstandingTasks = 1u;
    native(
        in config,
        in externalProducerCount,
        in tasksPerProducer,
        in joinKinds,
        mut readyReached,
        mut firstPublishedReached,
        mut invokedBeforePump,
        mut expired,
        mut rejected,
        mut wrongThread,
        mut totalInvoked,
        mut visitCounts,
        mut outstandingTasks
    ){
        using namespace CpuTaskMpmcTestSupport;
        DeadlineGuard deadline(false, s_WatchdogTimeoutMS);
        const ThreadId owner = QueryCurrentThreadId();
        Atomic<u32> ready{ 0u };
        Atomic<u32> firstPublished{ 0u };
        Atomic<u32> finished{ 0u };
        Atomic<u32> invoked{ 0u };
        Atomic<b8> start{ false };
        Atomic<b8> localExpired{ false };
        Atomic<b8> localRejected{ false };
        Atomic<b8> localWrongThread{ false };
        Array<Atomic<u32>, s_ExternalProducerCount * s_TasksPerProducer> visits{};
        CpuTaskScheduler scheduler(config);
        CpuTaskScope scope(scheduler);
        Array<JoiningThread, s_ExternalProducerCount> producers;
        ScopeExit stopProducers([&]()noexcept {
            start.store(true, MemoryOrder::release);
            scheduler.drain();
            for(auto& producer : producers){
                if(producer.joinable())
                    producer.join();
            }
        });

        for(u32 producer = 0u; producer < externalProducerCount; ++producer){
            producers[producer] = JoiningThread([&, producer]() {
                ScopeExit finish([&]()noexcept { finished.fetch_add(1u, MemoryOrder::release); });
                ready.fetch_add(1u, MemoryOrder::release);
                if(!WaitUntil([&]()noexcept { return start.load(MemoryOrder::acquire); })){
                    localExpired.store(true, MemoryOrder::release);
                    return;
                }
                for(u32 task = 0u; task < tasksPerProducer; ++task){
                    const u32 slot = producer * tasksPerProducer + task;
                    auto callback = [&, slot]()noexcept {
                        if(QueryCurrentThreadId() != owner || scheduler.currentWorkerIndex() != 0u)
                            localWrongThread.store(true, MemoryOrder::release);
                        visits[slot].fetch_add(1u, MemoryOrder::relaxed);
                        invoked.fetch_add(1u, MemoryOrder::release);
                    };
                    const CpuTaskOptions options{ .cost = CpuTaskCost::Light, .target = CpuTaskTarget::MainThread };
                    const u32 joinKind = task % joinKinds;
                    const auto cpuTaskAdmission = task % 2u == 0u || joinKind == 1u ? scope.submit(Move(callback), options) : scheduler.submit(Move(callback), options);
                    if(!cpuTaskAdmission){
                        localRejected.store(true, MemoryOrder::release);
                        return;
                    }
                    const CpuTaskHandle handle = *cpuTaskAdmission;
                    if(!handle.valid()){
                        localRejected.store(true, MemoryOrder::release);
                        return;
                    }
                    if(task == 0u)
                        firstPublished.fetch_add(1u, MemoryOrder::release);
                    if(joinKind == 0u)
                        scheduler.wait(handle);
                    else if(joinKind == 1u)
                        scope.wait();
                    else
                        scheduler.wait();
                }
            });
        }
        readyReached = WaitUntil([&]()noexcept { return ready.load(MemoryOrder::acquire) == externalProducerCount; });
        start.store(true, MemoryOrder::release);
        firstPublishedReached = WaitUntil([&]()noexcept { return firstPublished.load(MemoryOrder::acquire) == externalProducerCount; });
        invokedBeforePump = invoked.load(MemoryOrder::acquire);
        const Timer begin = TimerNow();
        while(finished.load(MemoryOrder::acquire) != externalProducerCount){
            if(DurationInMS<u64>(TimerNow(), begin) >= s_GateTimeoutMS){
                localExpired.store(true, MemoryOrder::release);
                scheduler.drain();
                break;
            }
            scheduler.pumpMainThread();
            // Yield lets dependent producers publish the next batch without pacing every handoff to a timer tick.
            YieldThread();
        }
        for(auto& producer : producers)
            producer.join();
        scope.wait();
        scheduler.wait();
        stopProducers.release();

        expired = localExpired.load(MemoryOrder::acquire);
        rejected = localRejected.load(MemoryOrder::acquire);
        wrongThread = localWrongThread.load(MemoryOrder::acquire);
        totalInvoked = invoked.load(MemoryOrder::acquire);
        for(const auto& count : visits)
            visitCounts.push_back(count.load(MemoryOrder::acquire));
        outstandingTasks = scheduler.statistics().outstandingTasks;
    }
    EXPECT_TRUE(readyReached);
    EXPECT_TRUE(firstPublishedReached);
    EXPECT_EQ(invokedBeforePump, 0u);
    EXPECT_FALSE(expired);
    EXPECT_FALSE(rejected);
    EXPECT_FALSE(wrongThread);
    EXPECT_EQ(totalInvoked, externalProducerCount * tasksPerProducer);
    ASSERT_EQ(visitCounts.size(), expectedVisitSlots);
    for(in u32 count : visitCounts)
        EXPECT_EQ(count, 1u);
    EXPECT_EQ(outstandingTasks, 0u);
}

void VerifyCpuTaskMpmcTests_CanceledCompletionCannotLoseConcurrentHandleScopeOrSchedulerJoins(){
    u32 callbacks = 0u;
    usize outstandingTasks = 0u;
    native(mut callbacks, mut outstandingTasks){
        using namespace CpuTaskMpmcTestSupport;
        DeadlineGuard deadline(false, s_WatchdogTimeoutMS);
        constexpr u32 s_JoinKinds = 3u;
        constexpr u32 s_Rounds = 32u;
        CpuTaskScheduler scheduler(0u);
        for(u32 round = 0u; round < s_Rounds; ++round){
            CpuTaskScope scope(scheduler);
            const auto handleTaskAdmission = scope.submit([&]()noexcept { ++callbacks; }, { .target = CpuTaskTarget::MainThread });
            ASSERT_TRUE(handleTaskAdmission);
            const auto handle = *handleTaskAdmission;
            ASSERT_TRUE(handle.valid());
            Atomic<b8> start{ false };
            Atomic<b8> expired{ false };
            Atomic<u32> entered{ 0u };
            Atomic<u32> finished{ 0u };
            Array<JoiningThread, s_JoinKinds> waiters;
            ScopeExit finishWaiters([&]()noexcept {
                start.store(true, MemoryOrder::release);
                scope.cancel();
                scheduler.pumpMainThread();
                for(auto& waiter : waiters){
                    if(waiter.joinable())
                        waiter.join();
                }
            });
            for(u32 kind = 0u; kind < s_JoinKinds; ++kind){
                waiters[kind] = JoiningThread([&, kind]() {
                    if(!WaitUntil([&]()noexcept { return start.load(MemoryOrder::acquire); })){
                        expired.store(true, MemoryOrder::release);
                        return;
                    }
                    entered.fetch_add(1u, MemoryOrder::release);
                    if(kind == 0u)
                        scheduler.wait(handle);
                    else if(kind == 1u)
                        scope.wait();
                    else
                        scheduler.wait();
                    finished.fetch_add(1u, MemoryOrder::release);
                });
            }
            if(round % 2u == 0u){
                start.store(true, MemoryOrder::release);
                ASSERT_TRUE(WaitUntil([&]()noexcept { return entered.load(MemoryOrder::acquire) == s_JoinKinds; }));
            }
            // Alternate retirement racing wait registration with retirement completed before any join starts.
            scope.cancel();
            scheduler.pumpMainThread();
            start.store(true, MemoryOrder::release);
            for(auto& waiter : waiters)
                waiter.join();
            finishWaiters.release();
            EXPECT_FALSE(expired.load(MemoryOrder::acquire));
            EXPECT_EQ(finished.load(MemoryOrder::acquire), s_JoinKinds);
        }
        outstandingTasks = scheduler.statistics().outstandingTasks;
    }
    EXPECT_EQ(callbacks, 0u);
    EXPECT_EQ(outstandingTasks, 0u);
}



