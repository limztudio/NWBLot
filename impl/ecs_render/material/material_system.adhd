#include <impl/ecs_scene/components.adhd>
#include <impl/ecs_render/csg/csg_system.adhd>
#include <impl/ecs_render/material/instance_typed_ranges.adhd>
#include <impl/ecs_render/material/material_surface_lookup.adhd>
#include <impl/ecs_render/material/material_typed_private.adhd>
#include <impl/ecs_render/material/material_pass_draw_recorder.adhd>
#include <impl/ecs_render/material/renderer_material_state.adhd>
#include <impl/ecs_render/optics/coincident_volumes.adhd>
#include <impl/ecs_render/shared/renderer_frame_bindings.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MaterialPassGatherOutputs{
    public mut MaterialPassDrawItemPartitions drawItems;
    public mut InstanceGpuDataVector instanceData;
    public mut CsgFrameGpuData csgFrameData;
    public mut MaterialTypedInstanceRangeVector materialTypedRanges;
    public mut MaterialTypedByteDataVector materialTypedBytes;

    public MaterialPassGatherOutputs(mut MaterialPassDrawItemPartitions draws, mut InstanceGpuDataVector instances, mut CsgFrameGpuData frame,
        mut MaterialTypedInstanceRangeVector ranges, mut MaterialTypedByteDataVector bytes){
        this.drawItems = draws;
        this.instanceData = instances;
        this.csgFrameData = frame;
        this.materialTypedRanges = ranges;
        this.materialTypedBytes = bytes;
    }
}

[modular, move_only]
class RendererMaterialSystem : IPreparedMaterialLookup{
    private mut World m_world;
    private mut GraphicsRuntime m_graphics;
    private MaterialPassDrawRecorder m_drawRecorder;
    private mut AssetManager m_assetManager;
    private mut CsgShapeRegistry m_csgShapeRegistry;
    private mut RendererMaterialState m_materialState;
    private mut RendererShaderSystem m_shaderSystem;
    private mut RendererMeshSystem m_meshSystem;
    private mut RendererCsgSystem m_csgSystem;
    private in RendererOpticalVolumeSelection m_opticalVolumes;

    public RendererMaterialSystem(mut World world, mut GraphicsRuntime graphics, mut AssetManager assetManager, mut CsgShapeRegistry csgShapeRegistry,
        mut RendererMaterialState materialState, mut RendererShaderSystem shaderSystem, mut RendererMeshSystem meshSystem,
        mut RendererCsgSystem csgSystem, in RendererOpticalVolumeSelection opticalVolumes){
        this.m_world = world;
        this.m_graphics = graphics;
        this.m_drawRecorder = MaterialPassDrawRecorder(graphics);
        this.m_assetManager = assetManager;
        this.m_csgShapeRegistry = csgShapeRegistry;
        this.m_materialState = materialState;
        this.m_shaderSystem = shaderSystem;
        this.m_meshSystem = meshSystem;
        this.m_csgSystem = csgSystem;
        this.m_opticalVolumes = opticalVolumes;
    }

    public in RendererMaterialState materialState()const{ return this.m_materialState; }
    public mut MaterialPassDrawRecorder drawRecorder(){ return this.m_drawRecorder; }
    [cpp_unwind]
    public void invalidateResources();
    [cpp_unwind]
    public Expected<mut MaterialSurfaceInfo> createMaterialSurfaceInfo(in AssetRef<Material> materialAsset);
    public Expected<mut MaterialSurfaceInfo> findMaterialSurfaceInfo(in AssetRef<Material> materialAsset) override;
    [cpp_unwind]
    public b8 prepareVisibleMaterialSurfaceInfos();
    [cpp_unwind]
    public void prepareVisibleMaterialInstanceMutableCache();
    [cpp_unwind]
    public Expected<BindingLayoutHandle> prepareMaterialPassBindingLayout();
    [cpp_unwind]
    public Expected<mut MaterialPipelineResources> createRendererPipeline(in MaterialSurfaceInfo materialInfo, in MaterialPipelineKey pipelineKey, mut Framebuffer framebuffer);
    public Expected<mut MaterialPipelineResources> findRendererPipeline(in MaterialPipelineKey pipelineKey);
    public void invalidateRendererPipelines();
    [cpp_unwind]
    public b8 hasTransparentRenderers(in RendererResourceLookupMode lookupMode);
    [cpp_unwind]
    public void logMaterialRenderPathDecision(in Name materialKey, in RenderPath renderPath, in b8 meshSupported);
    [cpp_unwind]
    public b8 prepareMeshComputeBindingLayout();
    [cpp_unwind]
    public b8 createComputeEmulationResources();
    [cpp_unwind]
    public b8 createObjectGeometryPipelineResources(mut MaterialPipelineResources resources);
    [cpp_unwind]
    public void renderPreparedAvboitMaterialPass(mut CommandList commands, in FramebufferHandle framebuffer, in MaterialPipelinePass pass, in AvboitFrameTargets avboitTargets,
        in MaterialPassDrawItemPartitionsView drawItems, in CsgFrameGpuDataView csgFrameData, in CsgGraphResourceSnapshot csgResources,
        in MeshFrameBindingSnapshot frameBindings, in usize instanceCount, in usize materialTypedByteCount, in b8 materialFrameStatesGraphOwned,
        in b8 materialGeometryStatesGraphOwned, in b8 emulationOutputEntryStateGraphOwned, in b8 csgEmulationOutputEntryStateGraphOwned,
        in b8 emulationOutputReused, in Optional<mut Optional<GpuTimingMeasure>> emulationOutputTiming);
    [cpp_unwind]
    public b8 prepareMaterialPassResources(in FramebufferHandle framebuffer, in MaterialPipelinePass pass, in b8 transparent, in CsgFrameState csgFrameState);
    [cpp_unwind]
    public b8 prepareMaterialPassResources(in FramebufferHandle framebuffer, in MaterialPipelinePass pass, in b8 transparent, in CsgFrameState csgFrameState, in AvboitFrameTargets avboitTargets);
    [cpp_unwind]
    public void gatherMaterialPassDrawItems(in FramebufferHandle framebuffer, in MaterialPipelinePass pass, in b8 transparent, in CsgFrameState csgFrameState, in RendererResourceLookupMode lookupMode,
        in Optional<in MeshViewGpuData> csgWorkRegionMeshViewState, mut MaterialPassDrawItemPartitions drawItems, mut InstanceGpuDataVector instanceData, mut CsgFrameGpuData csgFrameData,
        mut MaterialTypedInstanceRangeVector materialTypedRanges, mut MaterialTypedByteDataVector materialTypedBytes){
        MaterialPassGatherOutputs outputs(drawItems, instanceData, csgFrameData, materialTypedRanges, materialTypedBytes);
        this.gatherDraws(framebuffer, pass, transparent, csgFrameState, lookupMode, csgWorkRegionMeshViewState, outputs);
    }
    [cpp_unwind]
    private void gatherDraws(in FramebufferHandle framebuffer, in MaterialPipelinePass pass, in b8 transparent,
        in CsgFrameState csgFrameState, in RendererResourceLookupMode lookupMode, in Optional<in MeshViewGpuData> csgWorkRegionMeshViewState, in MaterialPassGatherOutputs outputs);
    [cpp_unwind]
    public Expected<Span<u8>> prepareMaterialInstanceMutableTypedBytes(in EntityID entity, in MaterialSurfaceInfo materialInfo, in Optional<in MaterialInstanceComponent> materialInstance);
    public Expected<Span<u8>> findPreparedMaterialInstanceMutableTypedBytes(in EntityID entity, in MaterialSurfaceInfo materialInfo, in Optional<in MaterialInstanceComponent> materialInstance)const override;
    [cpp_unwind]
    public Expected<ShadowOccluderMaterialContext> appendShadowOccluderMaterialContext(in EntityID entity, in MaterialSurfaceInfo materialInfo, in Optional<in TransformComponent> transform,
        mut MaterialTypedByteDataVector inOutMaterialTypedBytes, mut MaterialTypedConstantRangeMap inOutConstantRanges, mut MaterialTypedByteContentRangeMap inOutMutableRanges){
        const auto constant = FindOrAppendMaterialConstantTypedByteRange(materialInfo.materialName, materialInfo.typedLayoutHash,
            materialInfo.constantTypedBytes, inOutMaterialTypedBytes, inOutConstantRanges);
        if(!constant.has_value())
            return MakeUnexpected(Failure());
        Optional<in MaterialInstanceComponent> instance;
        if(this.m_world.hasComponent<MaterialInstanceComponent>(entity))
            instance = Optional<in MaterialInstanceComponent>(this.m_world.getComponent<MaterialInstanceComponent>(entity));
        const auto bytes = this.prepareMaterialInstanceMutableTypedBytes(entity, materialInfo, instance);
        if(!bytes.has_value())
            return MakeUnexpected(Failure());
        const auto mutableRange = inOutMutableRanges.findOrAppend(bytes.value(), inOutMaterialTypedBytes);
        if(!mutableRange.has_value())
            return MakeUnexpected(Failure());
        assert(MaterialTypedByteRangeEmptyOffsetValid(constant.value()) && MaterialTypedByteRangeEmptyOffsetValid(mutableRange.value()));
        TransformComponent resolved;
        if(transform.has_value())
            resolved = transform.value();
        ShadowOccluderMaterialContext context;
        context.instance = BuildInstanceGpuData(entity, transform.has_value(), LoadFloat(resolved.position), LoadFloat(resolved.rotation), LoadFloat(resolved.scale), mutableRange.value().byteOffset);
        context.constantByteOffset = constant.value().byteOffset;
        return context;
    }
    [cpp_unwind]
    public b8 recordObjectGeometryDecode(in MaterialPassDrawContext context, in MaterialPassDrawItem drawItem);
    [cpp_unwind]
    public b8 reserveInstanceBufferCapacity(in usize instanceCount);
    [cpp_unwind]
    public b8 reserveMaterialTypedBufferCapacity(in usize byteCount);
    [cpp_unwind]
    public b8 prepareMaterialPassDrawBuffers(in Span<InstanceGpuData> instanceData, in Span<u8> materialTypedBytes);
    public b8 materialPassDrawBuffersReady(in Span<InstanceGpuData> instanceData, in Span<u8> materialTypedBytes)const;
    public b8 materialPassDrawBuffersReady(in usize instanceCount, in usize materialTypedByteCount)const;
    public MaterialPassBufferSnapshot materialPassBufferSnapshot()const;
    public void prepareMaterialPassInstanceUploadData(in CsgGraphResourceSnapshot csgResources, mut Span<InstanceGpuData> instanceData);
    [cpp_unwind]
    private void releaseMaterialResourceReferences();
    [cpp_unwind]
    private b8 prepareMaterialPassResourcesImpl(in FramebufferHandle framebuffer, in MaterialPipelinePass pass, in b8 transparent, in CsgFrameState csgFrameState, in b8 avboitTargetsValid);
}


