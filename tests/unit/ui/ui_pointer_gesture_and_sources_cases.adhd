void VerifyUiPointerSourceTests_SourceMismatchCannotMoveReleaseOrCancelAnActiveGesture(mut UiPointerSourceTests self){
    const InputSource first = MakeUiPointerGestureSource(11u, 1u);
    const InputSource second = MakeUiPointerGestureSource(11u, 2u);
    ASSERT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Press, first)).pointerConsumed);
    const auto initialResult = self.m_router.consumePointerGesture(self.m_targets[0u].id, 7u);
    ASSERT_TRUE(initialResult.has_value());
    const PointerGesture initial = initialResult.value();
    EXPECT_FALSE(self.send(MakeUiPointerContactAt(PointerPhase::Move, second, 140.0f, 30.0f)).pointerRouted);
    EXPECT_FALSE(self.send(MakeUiPointerContact(PointerPhase::Release, second)).pointerRouted);
    EXPECT_FALSE(self.send(MakeUiPointerContact(PointerPhase::Cancel, second)).pointerRouted);
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
    EXPECT_EQ(self.m_router.activePointerSource(), first);
    EXPECT_TRUE(self.m_router.pressed(self.m_targets[0u].id));
    EXPECT_FALSE(self.m_router.consumePointerGesture(self.m_targets[0u].id, 7u).has_value());
    EXPECT_TRUE(self.m_router.actions().empty());
    ASSERT_TRUE(self.send(MakeUiPointerContactAt(PointerPhase::Move, first, 30.0f, 25.0f)).pointerRouted);
    const auto movedResult = self.m_router.consumePointerGesture(self.m_targets[0u].id, 7u);
    ASSERT_TRUE(movedResult.has_value());
    const PointerGesture moved = movedResult.value();
    EXPECT_EQ(moved.id.sequence, initial.id.sequence);
    EXPECT_EQ(moved.value, 17u);
    EXPECT_FLOAT_EQ(moved.position.x, 30.0f);
    EXPECT_FLOAT_EQ(moved.position.y, 25.0f);
    ASSERT_TRUE(self.send(MakeUiPointerContactAt(PointerPhase::Release, first, 30.0f, 25.0f)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(self.m_targets[0u].id));
    EXPECT_FALSE(self.m_router.consumeActivation(self.m_targets[1u].id));
}

void VerifyUiPointerSourceTests_CompetingUiPressStaysInertUntilItsOwnReleaseAfterTheOwnerEnds(mut UiPointerSourceTests self){
    const InputSource first = MakeUiPointerGestureSource(11u, 1u);
    const InputSource second = MakeUiPointerGestureSource(11u, 2u);
    ASSERT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Press, first)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiPointerContactAt(PointerPhase::Press, second, 130.0f, 20.0f)).pointerConsumed);
    EXPECT_TRUE(self.m_router.ownsPointerSource(second));
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
    EXPECT_FALSE(self.m_router.pressed(self.m_targets[1u].id));
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Release, first)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(self.m_targets[0u].id));
    EXPECT_FALSE(self.send(MakeUiPointerContactAt(PointerPhase::Move, second, 130.0f, 20.0f)).pointerRouted);
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.send(MakeUiPointerContactAt(PointerPhase::Release, second, 130.0f, 20.0f)).pointerConsumed);
    EXPECT_FALSE(self.m_router.ownsPointerSource(second));
    EXPECT_FALSE(self.m_router.consumeActivation(self.m_targets[1u].id));
    EXPECT_TRUE(self.send(MakeUiPointerContactAt(PointerPhase::Press, second, 130.0f, 20.0f)).pointerConsumed);
    EXPECT_EQ(self.m_router.capture(), self.m_targets[1u].id);
    EXPECT_TRUE(self.send(MakeUiPointerContactAt(PointerPhase::Release, second, 130.0f, 20.0f)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(self.m_targets[1u].id));
}

void VerifyUiPointerSourceTests_SceneAdmissionCannotTransferToAChangedUiLayoutDuringTheHold(mut UiPointerSourceTests self){
    const InputSource first = MakeUiPointerGestureSource(11u, 1u);
    EXPECT_FALSE(self.send(MakeUiPointerContactAt(PointerPhase::Press, first, 250.0f, 20.0f)).pointerConsumed);
    EXPECT_FALSE(self.m_router.ownsPointerSource(first));
    self.m_targets[0u].rectangle.x = 230.0f;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    EXPECT_FALSE(self.send(MakeUiPointerContactAt(PointerPhase::Move, first, 250.0f, 20.0f)).pointerConsumed);
    EXPECT_FALSE(self.send(MakeUiPointerContactAt(PointerPhase::Release, first, 250.0f, 20.0f)).pointerConsumed);
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.send(MakeUiPointerContactAt(PointerPhase::Press, first, 250.0f, 20.0f)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiPointerContactAt(PointerPhase::Release, first, 250.0f, 20.0f)).pointerConsumed);
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_EQ(self.m_router.actions().front().id.target, self.m_targets[0u].id);
    EXPECT_EQ(self.m_router.actions().front().id.layoutGeneration, 2u);
}

void VerifyUiPointerSourceTests_TouchEscapeCancellationRetainsItsReleaseOwnerWithoutSubmitting(mut UiPointerSourceTests self){
    const InputSource first = MakeUiPointerGestureSource(11u, 1u);
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Press, first)).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.m_router.pressed(self.m_targets[0u].id));
    EXPECT_FALSE(self.m_router.pointerKnown());
    EXPECT_FALSE(self.m_router.hover().valid());
    self.cancelCommand();
    EXPECT_TRUE(self.m_router.ownsPointerSource(first));
    EXPECT_FALSE(self.m_router.pressed(self.m_targets[0u].id));
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Release, first)).pointerConsumed);
    EXPECT_FALSE(self.m_router.ownsPointerSource(first));
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.pointerKnown());
    EXPECT_FALSE(self.m_router.hover().valid());
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Press, first)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Release, first)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(self.m_targets[0u].id));
}

void VerifyUiPointerSourceTests_RecreatedCapturedOwnerCannotReviveTheOriginalContactRelease(mut UiPointerSourceTests self){
    const InputSource first = MakeUiPointerGestureSource(11u, 1u);
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Press, first)).pointerConsumed);
    self.m_router.invalidateTarget(self.m_targets[0u].id);
    ++self.m_targets[0u].declarationGeneration;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    --self.m_targets[0u].declarationGeneration;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 3u));
    EXPECT_TRUE(self.m_router.ownsPointerSource(first));
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Release, first)).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.consumePointerGesture(self.m_targets[0u].id, 7u).has_value());
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Press, first)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Release, first)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(self.m_targets[0u].id));
}

void VerifyUiPointerSourceTests_ExactSourceCancellationPreservesOtherHoldsAndCompletedSnapshots(mut UiPointerSourceTests self){
    const InputSource first = MakeUiPointerGestureSource(11u, 1u);
    const InputSource second = MakeUiPointerGestureSource(11u, 2u);
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Press, first)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Release, first)).pointerConsumed);
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Press, first)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiPointerContactAt(PointerPhase::Press, second, 130.0f, 20.0f)).pointerConsumed);
    self.send(MakeUiPointerContact(PointerPhase::Cancel, second));
    EXPECT_FALSE(self.m_router.ownsPointerSource(second));
    EXPECT_TRUE(self.m_router.ownsPointerSource(first));
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
    self.send(MakeUiPointerContact(PointerPhase::Cancel, first));
    EXPECT_FALSE(self.m_router.ownsPointerSource(first));
    EXPECT_FALSE(self.m_router.primaryDown());
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.m_router.consumeActivation(self.m_targets[0u].id));
    EXPECT_FALSE(self.m_router.consumeActivation(self.m_targets[0u].id));
    const auto completedResult = self.m_router.consumePointerGesture(self.m_targets[0u].id, 7u);
    ASSERT_TRUE(completedResult.has_value());
    const PointerGesture completed = completedResult.value();
    EXPECT_EQ(completed.state, PointerGestureState::Completed);
    EXPECT_EQ(completed.value, 17u);
    EXPECT_FALSE(self.m_router.consumePointerGesture(self.m_targets[0u].id, 7u).has_value());
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Press, first)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Release, first)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(self.m_targets[0u].id));
}

void VerifyUiPointerSourceTests_TouchMovementAndSubmissionPreserveTheHoverCapableCursorGeometry(mut UiPointerSourceTests self){
    const InputSource first = MakeUiPointerGestureSource(11u, 1u);
    const InputSource cursorSource = MakeUiPointerGestureSource(12u, 1u);
    const Point cursor = MakeUiPointerGesturePoint(140.0f, 30.0f);
    self.send(MakeUiPointerContactHover(PointerPhase::Move, cursorSource, cursor.x, cursor.y, true));
    EXPECT_TRUE(self.m_router.pointerKnown());
    ASSERT_EQ(self.m_router.hover(), self.m_targets[1u].id);
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Press, first)).pointerConsumed);
    EXPECT_TRUE(self.m_router.pressed(self.m_targets[0u].id));
    EXPECT_EQ(self.m_router.hover(), self.m_targets[1u].id);
    self.send(MakeUiPointerContactAt(PointerPhase::Move, first, 30.0f, 25.0f));
    EXPECT_EQ(self.m_router.hover(), self.m_targets[1u].id);
    EXPECT_FLOAT_EQ(self.m_router.pointerPosition().x, cursor.x);
    EXPECT_FLOAT_EQ(self.m_router.pointerPosition().y, cursor.y);
    EXPECT_TRUE(self.send(MakeUiPointerContactAt(PointerPhase::Release, first, 30.0f, 25.0f)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(self.m_targets[0u].id));
    EXPECT_TRUE(self.m_router.pointerKnown());
    EXPECT_EQ(self.m_router.hover(), self.m_targets[1u].id);
    EXPECT_FLOAT_EQ(self.m_router.pointerPosition().x, cursor.x);
    EXPECT_FLOAT_EQ(self.m_router.pointerPosition().y, cursor.y);
}

void VerifyUiPointerSourceTests_ContextIntentCannotBeReleasedByAnotherRoleOrSource(mut UiPointerSourceTests self){
    const InputSource first = MakeUiPointerGestureSource(11u, 1u);
    const InputSource second = MakeUiPointerGestureSource(11u, 2u);
    EXPECT_TRUE(self.send(MakeUiPointerContactFull(PointerPhase::Press, first, 20.0f, 20.0f, false, PointerIntent::ContextMenu)).pointerConsumed);
    EXPECT_FALSE(self.m_router.consumeContextMenu(self.m_targets[0u].id, 7u).has_value());
    self.send(MakeUiPointerContact(PointerPhase::Release, first));
    self.send(MakeUiPointerContactFull(PointerPhase::Release, second, 20.0f, 20.0f, false, PointerIntent::ContextMenu));
    EXPECT_TRUE(self.m_router.ownsPointerSource(first, PointerIntent::ContextMenu));
    EXPECT_FALSE(self.m_router.consumeContextMenu(self.m_targets[0u].id, 7u).has_value());
    EXPECT_TRUE(self.send(MakeUiPointerContactFull(PointerPhase::Release, first, 30.0f, 25.0f, false, PointerIntent::ContextMenu)).pointerConsumed);
    const auto actionResult = self.m_router.consumeContextMenu(self.m_targets[0u].id, 7u);
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_FLOAT_EQ(actionResult.value().position.x, 20.0f);
    EXPECT_FLOAT_EQ(actionResult.value().position.y, 20.0f);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.pointerKnown());
}

void VerifyUiPointerSourceTests_QueuedTouchCapabilityChangesCannotPublishCursorHover(mut UiPointerSourceTests self){
    const InputSource first = MakeUiPointerGestureSource(11u, 1u);
    ASSERT_TRUE(self.m_router.queuePointer(MakeUiPointerContact(PointerPhase::Press, first)).has_value());
    const auto moveResult = self.m_router.queuePointer(MakeUiPointerContactHover(PointerPhase::Move, first, 30.0f, 25.0f, true));
    ASSERT_TRUE(moveResult.has_value());
    EXPECT_FALSE(moveResult.value().hoverCapable);
    const auto releaseResult = self.m_router.queuePointer(MakeUiPointerContactHover(PointerPhase::Release, first, 30.0f, 25.0f, true));
    ASSERT_TRUE(releaseResult.has_value());
    EXPECT_FALSE(releaseResult.value().hoverCapable);
    const InputRoutingResult routed = self.m_router.process();
    EXPECT_TRUE(routed.pointerConsumed);
    EXPECT_TRUE(routed.pointerRouted);
    EXPECT_FALSE(self.m_router.pointerKnown());
    EXPECT_FALSE(self.m_router.hover().valid());
    EXPECT_TRUE(self.m_router.consumeActivation(self.m_targets[0u].id));
    EXPECT_FALSE(self.m_router.consumeActivation(self.m_targets[0u].id));
    const auto gestureResult = self.m_router.consumePointerGesture(self.m_targets[0u].id, 7u);
    ASSERT_TRUE(gestureResult.has_value());
    const PointerGesture gesture = gestureResult.value();
    EXPECT_EQ(gesture.state, PointerGestureState::Completed);
    EXPECT_FLOAT_EQ(gesture.origin.x, 20.0f);
    EXPECT_FLOAT_EQ(gesture.position.x, 30.0f);
}

void VerifyUiPointerSourceTests_DuplicatePressCannotRerouteOrReplaceTheAcceptedGesture(mut UiPointerSourceTests self){
    const InputSource first = MakeUiPointerGestureSource(11u, 1u);
    ASSERT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Press, first)).pointerConsumed);
    const auto initialResult = self.m_router.consumePointerGesture(self.m_targets[0u].id, 7u);
    ASSERT_TRUE(initialResult.has_value());
    const PointerGesture initial = initialResult.value();
    PointerInput duplicate = MakeUiPointerContactAt(PointerPhase::Press, first, 130.0f, 20.0f);
    duplicate.timestampMs = 200u;
    const auto normalizedResult = self.m_router.queuePointer(duplicate);
    ASSERT_TRUE(normalizedResult.has_value());
    EXPECT_TRUE(normalizedResult.value().repeat);
    EXPECT_FALSE(self.m_router.process().pointerRouted);
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
    EXPECT_TRUE(self.m_router.pressed(self.m_targets[0u].id));
    EXPECT_FALSE(self.m_router.consumePointerGesture(self.m_targets[0u].id, 7u).has_value());
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Release, first)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(self.m_targets[0u].id));
    EXPECT_FALSE(self.m_router.consumeActivation(self.m_targets[0u].id));
    EXPECT_FALSE(self.m_router.consumeActivation(self.m_targets[1u].id));
    const auto completedResult = self.m_router.consumePointerGesture(self.m_targets[0u].id, 7u);
    ASSERT_TRUE(completedResult.has_value());
    const PointerGesture completed = completedResult.value();
    EXPECT_EQ(completed.id.sequence, initial.id.sequence);
    EXPECT_EQ(completed.state, PointerGestureState::Completed);
    EXPECT_FLOAT_EQ(completed.origin.x, 20.0f);
    EXPECT_FLOAT_EQ(completed.position.x, 20.0f);
}

void VerifyUiPointerSourceTests_QueuedTerminalDiscardedByResetRetiresTheContactWithoutSubmitting(mut UiPointerSourceTests self){
    const InputSource first = MakeUiPointerGestureSource(11u, 1u);
    Array<PointerPhaseEnum, 2u> terminals = Array<PointerPhaseEnum, 2u>();
    terminals[0u] = PointerPhase::Release;
    terminals[1u] = PointerPhase::Cancel;
    for(in PointerPhaseEnum terminal : terminals){
        ASSERT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Press, first)).pointerConsumed);
        ASSERT_TRUE(self.m_router.queuePointer(MakeUiPointerContact(terminal, first)).has_value());
        EXPECT_TRUE(self.m_router.ownsPointerSource(first));
        self.m_router.reset();
        EXPECT_FALSE(self.m_router.ownsPointerSource(first));
        EXPECT_FALSE(self.m_router.primaryDown());
        EXPECT_FALSE(self.m_router.activePointerSource().valid());
        EXPECT_TRUE(self.m_router.actions().empty());
        ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
        const auto freshResult = self.m_router.queuePointer(MakeUiPointerContact(PointerPhase::Press, first));
        ASSERT_TRUE(freshResult.has_value());
        EXPECT_FALSE(freshResult.value().repeat);
        EXPECT_TRUE(self.m_router.process().pointerRouted);
        EXPECT_TRUE(self.m_router.pressed(self.m_targets[0u].id));
        EXPECT_TRUE(self.m_router.actions().empty());
        EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Release, first)).pointerConsumed);
        EXPECT_TRUE(self.m_router.consumeActivation(self.m_targets[0u].id));
        EXPECT_FALSE(self.m_router.consumeActivation(self.m_targets[0u].id));
    }
}

void VerifyUiPointerSourceTests_QueuedReleaseBeforeResetReclaimsAFullSourceSlotAndRejectsOverflowAtomically(mut UiPointerSourceTests self){
    const InputSource first = MakeUiPointerGestureSource(11u, 1u);
    const InputSource second = MakeUiPointerGestureSource(11u, 2u);
    for(usize index = 0u; index < s_InputMaxSources; ++index)
        ASSERT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Press, MakeUiPointerGestureSource(11u, index + 1u))).pointerConsumed);
    ASSERT_TRUE(self.m_router.queuePointer(MakeUiPointerContact(PointerPhase::Release, first)).has_value());
    self.m_router.reset();
    EXPECT_FALSE(self.m_router.ownsPointerSource(first));
    EXPECT_TRUE(self.m_router.ownsPointerSource(second));
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    const InputSource replacement = MakeUiPointerGestureSource(11u, s_InputMaxSources + 1u);
    const InputSource overflow = MakeUiPointerGestureSource(11u, s_InputMaxSources + 2u);
    ASSERT_TRUE(self.m_router.queuePointer(MakeUiPointerContact(PointerPhase::Press, replacement)).has_value());
    EXPECT_FALSE(self.m_router.queuePointer(MakeUiPointerContact(PointerPhase::Press, overflow)).has_value());
    EXPECT_TRUE(self.m_router.process().pointerRouted);
    EXPECT_EQ(self.m_router.activePointerSource(), replacement);
    EXPECT_TRUE(self.m_router.ownsPointerSource(replacement));
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Release, replacement)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(self.m_targets[0u].id));
    const auto retriedResult = self.m_router.queuePointer(MakeUiPointerContact(PointerPhase::Press, overflow));
    ASSERT_TRUE(retriedResult.has_value());
    EXPECT_FALSE(retriedResult.value().repeat);
    EXPECT_TRUE(self.m_router.process().pointerRouted);
    EXPECT_EQ(self.m_router.activePointerSource(), overflow);
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Release, overflow)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(self.m_targets[0u].id));
    EXPECT_FALSE(self.m_router.consumeActivation(self.m_targets[0u].id));
}

void VerifyUiPointerSourceTests_DiscardedQueuedPressCannotAcquireUiOwnershipOnItsRepeatAfterReset(mut UiPointerSourceTests self){
    const InputSource first = MakeUiPointerGestureSource(11u, 1u);
    ASSERT_TRUE(self.m_router.queuePointer(MakeUiPointerContact(PointerPhase::Press, first)).has_value());
    self.m_router.reset();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    const auto repeatedResult = self.m_router.queuePointer(MakeUiPointerContact(PointerPhase::Press, first));
    ASSERT_TRUE(repeatedResult.has_value());
    EXPECT_TRUE(repeatedResult.value().repeat);
    const InputRoutingResult routed = self.m_router.process();
    EXPECT_FALSE(routed.pointerConsumed);
    EXPECT_FALSE(routed.pointerRouted);
    EXPECT_FALSE(self.m_router.ownsPointerSource(first));
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_FALSE(self.send(MakeUiPointerContactAt(PointerPhase::Move, first, 30.0f, 25.0f)).pointerConsumed);
    EXPECT_FALSE(self.send(MakeUiPointerContactAt(PointerPhase::Release, first, 30.0f, 25.0f)).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Press, first)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Release, first)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(self.m_targets[0u].id));
}

void VerifyUiPointerSourceTests_CancelConsumesARetainedUiContactWithoutClaimingAnIdleCursorHover(mut UiPointerSourceTests self){
    const InputSource first = MakeUiPointerGestureSource(11u, 1u);
    const InputSource second = MakeUiPointerGestureSource(11u, 2u);
    const InputSource cursorSource = MakeUiPointerGestureSource(12u, 1u);
    ASSERT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Press, first)).pointerConsumed);
    ASSERT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Press, second)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Release, first)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(self.m_targets[0u].id));
    self.m_router.clearFocus();
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.m_router.ownsPointerSource(second));
    self.cancelCommand();
    EXPECT_TRUE(self.m_router.ownsPointerSource(second));
    EXPECT_TRUE(self.send(MakeUiPointerContact(PointerPhase::Release, second)).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    self.send(MakeUiPointerContactHover(PointerPhase::Move, cursorSource, 20.0f, 20.0f, true));
    ASSERT_EQ(self.m_router.hover(), self.m_targets[0u].id);
    InputEvent cancel = InputEvent();
    cancel.type = InputEventType::CommandDown;
    cancel.source = MakeUiPointerGestureSource(21u, 1u);
    cancel.command = InputCommand::Cancel;
    ASSERT_TRUE(self.m_router.queue(cancel).has_value());
    EXPECT_FALSE(self.m_router.process().commandConsumed);
    cancel.type = InputEventType::CommandUp;
    cancel.command = InputCommand::None;
    ASSERT_TRUE(self.m_router.queue(cancel).has_value());
    EXPECT_FALSE(self.m_router.process().commandConsumed);
}


