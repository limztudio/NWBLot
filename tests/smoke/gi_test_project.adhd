#include "gi_test_runtime.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class GiTestSmokeProject : IProjectEntryCallbacks{
    public GiTestSmokeProject(mut ProjectRuntimeContext context){
        this.m_impl = GiTestSmokeProjectImpl(context);
    }

    public b8 onStartup()override{
        return this.m_impl.onStartup();
    }

    public void onShutdown()override{
        this.m_impl.onShutdown();
    }

    public b8 onUpdate(in f32 delta)override{
        return this.m_impl.onUpdate(delta);
    }

    private GiTestSmokeProjectImpl m_impl;
}


