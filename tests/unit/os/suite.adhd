struct EncodedCodePointBuffer{
    Array<char, s_Utf8MaxSequenceBytes> bytes = {};

    [[nodiscard]] Expected<usize, TextInputAdmission::Enum> encode(const u32 codePoint)noexcept{
        return EncodeTextInputCodePoint(codePoint, bytes);
    }

    [[nodiscard]] AStringView view(const usize length)const noexcept{
        return AStringView(bytes.data(), length);
    }
};

[[nodiscard]] FOUNDATION_INLINE TextInputSessionDesc MakeEmptySessionDesc()noexcept{
    return TextInputSessionDesc{};
}

[[nodiscard]] FOUNDATION_INLINE TextInputSessionDesc MakeSessionDesc(const AStringView surrounding, const usize anchorByte, const usize caretByte)noexcept{
    return TextInputSessionDesc{ {}, surrounding, anchorByte, caretByte };
}

[[nodiscard]] FOUNDATION_INLINE TextInputRect MakeTextInputRect(const i32 x, const i32 y, const i32 width, const i32 height)noexcept{
    return TextInputRect{ x, y, width, height };
}

[[nodiscard]] FOUNDATION_INLINE TextInputDeletionBasis::Enum MakeInvalidDeletionBasis()noexcept{
    return static_cast<TextInputDeletionBasis::Enum>(255u);
}

[[nodiscard]] FOUNDATION_INLINE TextInputChangeCause::Enum MakeInvalidChangeCause()noexcept{
    return static_cast<TextInputChangeCause::Enum>(255u);
}

FOUNDATION_INLINE void FillGlobalString(GlobalString& target, const usize count, const u8 byteValue){
    target.assign(count, static_cast<char>(byteValue));
}

FOUNDATION_INLINE void AssignGlobalString(GlobalString& target, const AStringView value){
    target.assign(value.data(), value.size());
}

FOUNDATION_INLINE void AppendByteGlobalString(GlobalString& target, const u8 byteValue){
    target.push_back(static_cast<char>(byteValue));
}

[[nodiscard]] FOUNDATION_INLINE AStringView ViewGlobalString(const GlobalString& source)noexcept{
    return AStringView(source);
}


