////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/text/shaper_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_TextCarriageReturnLineFeedBytes = 2u;
const f64 s_TextRasterMarginPixels = 2.0;
const f64 s_TextHalfPixel = 0.5;
const f64 s_TextSdfMinimumFilterWidth = 0.001;
const f64 s_TextSdfEncodedHalfRange = 128.0;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> TextCaretEdge{
    Leading,
    Trailing,
}

enum<u8> TextGlyphIntersection{
    Invalid,
    Invisible,
    Visible,
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TextCluster{
    public u32 byteBegin = 0u;
    public u32 byteEnd = 0u;
    public u32 firstGlyph = 0u;
    public u32 glyphCount = 0u;
    public u32 lineIndex = 0u;
    public f32 leadingX = 0.0f;
    public f32 trailingX = 0.0f;
}

class TextLine{
    public u32 byteBegin = 0u;
    public u32 byteEnd = 0u;
    public u32 breakEnd = 0u;
    public u32 firstGlyph = 0u;
    public u32 glyphCount = 0u;
    public u32 firstCluster = 0u;
    public u32 clusterCount = 0u;
    public f32 top = 0.0f;
    public f32 baseline = 0.0f;
    public f32 height = 0.0f;
    public f32 advance = 0.0f;
}

class TextHit{
    public u32 byteOffset = 0u;
}

class TextRasterMetrics{
    public f32 physicalSize = 0.0f;
    public f32 rasterPpem = 0.0f;
    public f32 rasterScale = 0.0f;
    public u32 pixelSize = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<TextRasterMetrics> TryResolveTextRasterMetrics(in f32 fontSize, in DisplayMetrics display){
    TextRasterMetrics outMetrics;
    if(!IsValidTextFontSize(fontSize) || !isFinite(display.pixelScaleX) || !isFinite(display.pixelScaleY) || display.pixelScaleX <= 0.0f || display.pixelScaleY <= 0.0f)
        return makeUnexpected(Failure());
    const f32 physicalSize = fontSize * max(display.pixelScaleX, display.pixelScaleY);
    const f32 rasterPpem = ceil(physicalSize);
    if(!isFinite(rasterPpem) || rasterPpem < 1.0f || rasterPpem > s_TextMaxRasterPpemF32)
        return makeUnexpected(Failure());
    outMetrics.physicalSize = physicalSize;
    outMetrics.rasterPpem = rasterPpem;
    outMetrics.rasterScale = rasterPpem / fontSize;
    outMetrics.pixelSize = cast<u32>(rasterPpem);
    return outMetrics;
}

Expected<Rect> TryMakeMeasuredTextRect(in f64 left, in f64 top, in f64 right, in f64 bottom){
    if(
        !isFinite(left) || !isFinite(top) || !isFinite(right) || !isFinite(bottom)
        || left < -s_TextMaxCoordinateF64 || top < -s_TextMaxCoordinateF64
        || right > s_TextMaxCoordinateF64 || bottom > s_TextMaxCoordinateF64
        || right < left || bottom < top
    )
        return makeUnexpected(Failure());
    const f32 x = roundF64ToF32Bound(left, false);
    const f32 y = roundF64ToF32Bound(top, false);
    const f64 width = cast<f64>(roundF64ToF32Bound(right, true)) - cast<f64>(x);
    const f64 height = cast<f64>(roundF64ToF32Bound(bottom, true)) - cast<f64>(y);
    if(width > s_TextMaxCoordinateF64 || height > s_TextMaxCoordinateF64)
        return makeUnexpected(Failure());
    const f32 roundedWidth = roundF64ToF32Bound(width, true);
    const f32 roundedHeight = roundF64ToF32Bound(height, true);
    if(
        !isFinite(roundedWidth) || roundedWidth < 0.0f
        || !isFinite(roundedHeight) || roundedHeight < 0.0f
        || !isFinite(x + roundedWidth) || !isFinite(y + roundedHeight)
    )
        return makeUnexpected(Failure());
    return Rect(x, y, roundedWidth, roundedHeight);
}

TextHit HitTestTextLayout(in Span<TextLine> lines, in Span<TextCluster> clusters, in Point point){
    TextHit hit;
    if(lines.empty() || !isFinite(point.x) || !isFinite(point.y))
        return hit;
    usize lineIndex = lines.size() - 1u;
    for(usize index = 0u; index < lines.size(); ++index){
        if(point.y < lines[index].top + lines[index].height){
            lineIndex = index;
            break;
        }
    }
    const TextLine line = lines[lineIndex];
    hit.byteOffset = line.byteBegin;
    if(line.clusterCount == 0u)
        return hit;
    f32 nearest = s_TextMaxCoordinateF32;
    for(u32 index = line.firstCluster; index < line.firstCluster + line.clusterCount; ++index){
        const TextCluster cluster = clusters[cast<usize>(index)];
        const f32 leadingDistance = abs(point.x - cluster.leadingX);
        const f32 trailingDistance = abs(point.x - cluster.trailingX);
        if(leadingDistance <= nearest){
            nearest = leadingDistance;
            hit.byteOffset = cluster.byteBegin;
        }
        if(trailingDistance < nearest){
            nearest = trailingDistance;
            hit.byteOffset = cluster.byteEnd;
        }
    }
    return hit;
}

Expected<Rect> TryResolveTextCaretRect(in Span<TextLine> lines, in Span<TextCluster> clusters, in TextDirection direction, in u32 byteOffset, in TextCaretEdge edge){
    if(edge != TextCaretEdge::Leading && edge != TextCaretEdge::Trailing)
        return makeUnexpected(Failure());
    b8 hasAlternate = false;
    TextCluster alternate;
    for(usize i = 0u; i < clusters.size(); ++i){
        const TextCluster cluster = clusters[i];
        b8 matched = false;
        if(edge == TextCaretEdge::Leading)
            matched = cluster.byteBegin == byteOffset;
        else
            matched = cluster.byteEnd == byteOffset;
        if(matched){
            const TextLine line = lines[cast<usize>(cluster.lineIndex)];
            f32 x = cluster.trailingX;
            if(edge == TextCaretEdge::Leading)
                x = cluster.leadingX;
            return Rect(x, line.top, 0.0f, line.height);
        }
        if(cluster.byteBegin == byteOffset || cluster.byteEnd == byteOffset){
            alternate = cluster;
            hasAlternate = true;
        }
    }
    if(hasAlternate){
        const TextLine line = lines[cast<usize>(alternate.lineIndex)];
        f32 x = alternate.trailingX;
        if(alternate.byteBegin == byteOffset)
            x = alternate.leadingX;
        return Rect(x, line.top, 0.0f, line.height);
    }
    for(usize i = 0u; i < lines.size(); ++i){
        const TextLine line = lines[i];
        if(byteOffset == line.byteBegin || byteOffset == line.byteEnd){
            const b8 atBegin = byteOffset == line.byteBegin;
            f32 x = line.advance;
            if(atBegin == (direction == TextDirection::LeftToRight))
                x = 0.0f;
            return Rect(x, line.top, 0.0f, line.height);
        }
    }
    return makeUnexpected(Failure());
}

TextGlyphIntersection TryIntersectTextBounds(in f64 minX, in f64 minY, in f64 maxX, in f64 maxY, in Rect clip){
    if(
        !FitsTextCoordinate(minX) || !FitsTextCoordinate(minY)
        || !FitsTextCoordinate(maxX) || !FitsTextCoordinate(maxY)
        || maxX < minX || maxY < minY
    )
        return TextGlyphIntersection::Invalid;
    const f64 extentX = maxX - minX;
    const f64 extentY = maxY - minY;
    if(extentX > s_TextMaxCoordinateF64 || extentY > s_TextMaxCoordinateF64)
        return TextGlyphIntersection::Invalid;
    const f64 clipX = cast<f64>(clip.x);
    const f64 clipY = cast<f64>(clip.y);
    if(maxX <= minX || maxY <= minY || clip.width <= 0.0f || clip.height <= 0.0f || maxX <= clipX || maxY <= clipY)
        return TextGlyphIntersection::Invisible;
    const f64 clipEndX = clipX + cast<f64>(clip.width);
    const f64 clipEndY = clipY + cast<f64>(clip.height);
    if(minX >= clipEndX || minY >= clipEndY)
        return TextGlyphIntersection::Invisible;
    return TextGlyphIntersection::Visible;
}

TextGlyphIntersection TryIntersectTextRects(in Rect rectangle, in Rect clip){
    if(!IsValidUiRect(rectangle) || !IsValidUiRect(clip))
        return TextGlyphIntersection::Invalid;
    const f64 minX = cast<f64>(rectangle.x);
    const f64 minY = cast<f64>(rectangle.y);
    const f64 maxX = minX + cast<f64>(rectangle.width);
    const f64 maxY = minY + cast<f64>(rectangle.height);
    return TryIntersectTextBounds(minX, minY, maxX, maxY, clip);
}

Point ResolveLabelPaintOrigin(in Rect bounds, in Rect measured){
    return Point(bounds.x - measured.x, bounds.y - measured.y);
}

b8 IsValidTextGlyphLocation(in Point glyphPosition, in Point topLeft){
    return isFinite(glyphPosition.x) && isFinite(glyphPosition.y) && isFinite(topLeft.x) && isFinite(topLeft.y);
}

Expected<VectorDouble> TryLoadGlyphAtlasRectangle(
    in Point glyphPosition,
    in Point topLeft,
    in f32 fontSize,
    in u32 unitsPerEm,
    in FontAtlasGlyph record
){
    if(!IsValidTextGlyphLocation(glyphPosition, topLeft) || !IsValidTextFontSize(fontSize) || unitsPerEm == 0u)
        return makeUnexpected(Failure());
    if(record.drawable == 0u)
        return VectorDouble(0.0, 0.0, 0.0, 0.0);
    if(
        !isFinite(record.planeLeft) || !isFinite(record.planeTop)
        || !isFinite(record.planeRight) || !isFinite(record.planeBottom)
        || record.planeRight <= record.planeLeft || record.planeBottom <= record.planeTop
    )
        return makeUnexpected(Failure());
    const f64 scale = cast<f64>(fontSize) / cast<f64>(unitsPerEm);
    const f64 x = (cast<f64>(topLeft.x) + cast<f64>(glyphPosition.x)) + (cast<f64>(record.planeLeft) * scale);
    const f64 y = (cast<f64>(topLeft.y) + cast<f64>(glyphPosition.y)) + (cast<f64>(record.planeTop) * scale);
    const f64 width = (cast<f64>(record.planeRight) - cast<f64>(record.planeLeft)) * scale;
    const f64 height = (cast<f64>(record.planeBottom) - cast<f64>(record.planeTop)) * scale;
    if(
        !FitsTextCoordinate(x) || !FitsTextCoordinate(y)
        || !FitsTextCoordinate(width) || !FitsTextCoordinate(height)
        || width < 0.0 || height < 0.0
        || !FitsTextCoordinate(x + width) || !FitsTextCoordinate(y + height)
    )
        return makeUnexpected(Failure());
    const VectorSingle rounded(cast<f32>(x), cast<f32>(y), cast<f32>(width), cast<f32>(height));
    if(!isFinite(rounded.x) || !isFinite(rounded.y) || !isFinite(rounded.z) || !isFinite(rounded.w) || !isFinite(rounded.x + rounded.z) || !isFinite(rounded.y + rounded.w))
        return makeUnexpected(Failure());
    return VectorDouble(rounded);
}

TextGlyphIntersection IntersectTextCoverageInk(
    in Point glyphPosition,
    in Point topLeft,
    in Rect ink,
    in b8 coverageKnown,
    in u32 unitsPerEm,
    in f32 fontSize,
    in f32 physicalSize,
    in Rect clip,
    in Point pixelScale
){
    const f64 fontSizeF64 = cast<f64>(fontSize);
    const f64 shapedSize = floor((fontSizeF64 * s_TextFixedPointScaleF64) + s_TextHalfPixel) / s_TextFixedPointScaleF64;
    f64 correctionScalar = 1.0;
    if(!coverageKnown)
        correctionScalar = fontSizeF64 / shapedSize;
    const f64 rasterScale = cast<f64>(physicalSize) / fontSizeF64;
    f64 outlineAllowance = 0.0;
    if(!coverageKnown)
        outlineAllowance = fontSizeF64 / cast<f64>(unitsPerEm);
    // Native outline bounds include their design-unit allowance; keep raster rounding and physical-pixel snapping conservative.
    const f64 rasterMarginScalar = ((max(1.0, correctionScalar) / s_TextFixedPointScaleF64) + (s_TextRasterMarginPixels / rasterScale)) + outlineAllowance;
    const f64 marginX = rasterMarginScalar + (s_TextHalfPixel / cast<f64>(pixelScale.x));
    const f64 marginY = rasterMarginScalar + (s_TextHalfPixel / cast<f64>(pixelScale.y));
    const f64 inkOriginX = cast<f64>(ink.x);
    const f64 inkOriginY = cast<f64>(ink.y);
    const f64 inkEndX = inkOriginX + cast<f64>(ink.width);
    const f64 inkEndY = inkOriginY + cast<f64>(ink.height);
    const f64 posX = cast<f64>(topLeft.x) + cast<f64>(glyphPosition.x);
    const f64 posY = cast<f64>(topLeft.y) + cast<f64>(glyphPosition.y);
    const f64 minX = (posX + min(inkOriginX, inkOriginX * correctionScalar)) - marginX;
    const f64 minY = (posY + min(inkOriginY, inkOriginY * correctionScalar)) - marginY;
    const f64 maxX = (posX + max(inkEndX, inkEndX * correctionScalar)) + marginX;
    const f64 maxY = (posY + max(inkEndY, inkEndY * correctionScalar)) + marginY;
    return TryIntersectTextBounds(minX, minY, maxX, maxY, clip);
}

Expected<Rect> TryResolveGlyphCoverageRectangle(
    in Point glyphPosition,
    in u32 pageIndex,
    in Rect recordPixels,
    in i32 bearingX,
    in i32 bearingY,
    in f32 rasterScale,
    in Point topLeft,
    in Point pixelScale
){
    if(
        !IsValidTextGlyphLocation(glyphPosition, topLeft)
        || !isFinite(rasterScale) || rasterScale <= 0.0f
        || !IsValidUiRect(recordPixels)
        || !isFinite(pixelScale.x) || !isFinite(pixelScale.y) || pixelScale.x <= 0.0f || pixelScale.y <= 0.0f
    )
        return makeUnexpected(Failure());
    if(pageIndex == s_GlyphAtlasNoPage)
        return Rect();
    const f64 scaleF64 = cast<f64>(rasterScale);
    const f64 posX = (cast<f64>(topLeft.x) + cast<f64>(glyphPosition.x)) + (cast<f64>(bearingX) / scaleF64);
    const f64 posY = (cast<f64>(topLeft.y) + cast<f64>(glyphPosition.y)) - (cast<f64>(bearingY) / scaleF64);
    const f64 scaleX = cast<f64>(pixelScale.x);
    const f64 scaleY = cast<f64>(pixelScale.y);
    const f64 alignedX = floor((posX * scaleX) + s_TextHalfPixel) / scaleX;
    const f64 alignedY = floor((posY * scaleY) + s_TextHalfPixel) / scaleY;
    const f64 width = cast<f64>(recordPixels.width) / scaleF64;
    const f64 height = cast<f64>(recordPixels.height) / scaleF64;
    return TryMakeUiRect(alignedX, alignedY, width, height, UiRectPrecision::BoundedEndpoints);
}

Rect ToTextGlyphAtlasRect(in VectorDouble rectangle){
    return Rect(
        cast<f32>(rectangle.x),
        cast<f32>(rectangle.y),
        cast<f32>(rectangle.z),
        cast<f32>(rectangle.w)
    );
}

TextGlyphIntersection IntersectGlyphAtlasRectangle(in VectorDouble rectangle, in Rect clip){
    const f64 minX = rectangle.x;
    const f64 minY = rectangle.y;
    const f64 maxX = minX + rectangle.z;
    const f64 maxY = minY + rectangle.w;
    return TryIntersectTextBounds(minX, minY, maxX, maxY, clip);
}

TextGlyphIntersection ValidateTextGlyphCandidateInputs(
    in Point glyphPosition,
    in Point topLeft,
    in f32 fontSize,
    in f32 physicalSize,
    in Rect clip,
    in Point pixelScale
){
    if(
        !IsValidTextGlyphLocation(glyphPosition, topLeft) || !IsValidTextFontSize(fontSize) || !isFinite(physicalSize)
        || physicalSize < 1.0f || physicalSize > s_TextMaxRasterPpemF32 || !IsValidUiRect(clip)
        || !isFinite(pixelScale.x) || !isFinite(pixelScale.y) || pixelScale.x <= 0.0f || pixelScale.y <= 0.0f
    )
        return TextGlyphIntersection::Invalid;
    if(clip.width <= 0.0f || clip.height <= 0.0f)
        return TextGlyphIntersection::Invisible;
    return TextGlyphIntersection::Visible;
}

TextGlyphIntersection EvaluateUnselectedAtlasGlyphCandidate(
    in Point glyphPosition,
    in Point topLeft,
    in Rect glyphInk,
    in GlyphCoverageBounds coverage,
    in b8 hasValidFace,
    in b8 coverageInkReliable,
    in u32 faceUnitsPerEm,
    in f32 fontSize,
    in f32 physicalSize,
    in Rect clip,
    in Point pixelScale
){
    if(!IsValidUiRect(glyphInk) || (coverage.known && !IsValidUiRect(coverage.ink)))
        return TextGlyphIntersection::Invalid;
    Rect ink = glyphInk;
    if(coverage.known)
        ink = coverage.ink;
    if(coverage.known && (ink.width <= 0.0f || ink.height <= 0.0f))
        return TextGlyphIntersection::Invisible;
    u32 unitsPerEm = 1u;
    if(!coverage.known){
        if(!hasValidFace)
            return TextGlyphIntersection::Invalid;
        if(ink.width <= 0.0f || ink.height <= 0.0f || !coverageInkReliable)
            return TextGlyphIntersection::Visible;
        unitsPerEm = faceUnitsPerEm;
    }
    return IntersectTextCoverageInk(glyphPosition, topLeft, ink, coverage.known, unitsPerEm, fontSize, physicalSize, clip, pixelScale);
}


