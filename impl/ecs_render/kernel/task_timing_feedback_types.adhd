#include <impl/ecs_render/kernel/task_timing_telemetry_labels.adhd>
#include <impl/ecs_render/kernel/timing_policy.adhd>
#include <impl/ecs_render/shared/frame_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererTaskTimingFeedbackState : NoCopy{
    private Vector<RendererTaskTimingPendingSample> m_pendingSamples;

    public b8 trackSample(
        in GpuTimingSampleAttribution attribution,
        in Name scopeName,
        in GpuTaskTimingKey key,
        in GpuPhysicalQueueId expectedQueue,
        in u64 sourceFrameIndex,
        in b8 recordsNonCommittingTimingSample
    ){
        return TrackRendererTaskTimingSample(attribution, scopeName, key, expectedQueue, sourceFrameIndex, recordsNonCommittingTimingSample, this.m_pendingSamples);
    }

    public void acceptSubmission(in GpuTimingSampleAttribution attribution, in QueueSubmissionToken token, in b8 feedbackActive){
        AcceptRendererTaskTimingSubmission(attribution, token, feedbackActive, true, this.m_pendingSamples);
    }

    public void discardRecording(in GpuTimingSampleAttribution attribution){
        DiscardRendererTaskTimingRecording(attribution, this.m_pendingSamples);
    }

    public void completeSample(in GpuTimingSample sample, in b8 feedbackActive){
        CompleteRendererTaskTimingSample(sample, feedbackActive, this.m_pendingSamples);
    }

    public RendererTaskTimingFeedbackDrainResult drain(mut GpuTaskTimingHistoryStore history, in u16 deviceGeneration){
        return DrainRendererTaskTimingPendingSamples(history, deviceGeneration, this.m_pendingSamples);
    }

    public void reset(){
        this.m_pendingSamples.clear();
    }
}


RendererTaskTimingFeedbackPolicyTransition PrepareRendererTaskTimingFeedbackPolicyTransition(in RendererTimingPolicy requestedPolicy, in b8 rendererActive, mut RendererTimingPolicy currentPolicy){
    RendererTaskTimingFeedbackPolicyTransition transition = RendererTaskTimingFeedbackPolicyTransition(
        currentPolicy,
        requestedPolicy,
        ResolveRendererTaskTimingFeedbackCollectionAction(rendererActive, currentPolicy.enabled, requestedPolicy.enabled)
    );
    if(transition.action != RendererTaskTimingFeedbackCollectionAction::Enable)
        currentPolicy = requestedPolicy;
    return transition;
}

void ResolveRendererTaskTimingFeedbackPolicyTransition(in RendererTaskTimingFeedbackPolicyTransition transition, in b8 collectionUpdated, mut RendererTimingPolicy currentPolicy){
    if(transition.action == RendererTaskTimingFeedbackCollectionAction::None)
        return;

    if(collectionUpdated)
        currentPolicy = transition.requestedPolicy;
    else
        currentPolicy = transition.previousPolicy;
}

b8 IsAcceptedRendererTaskTimingSubmission(
    in b8 feedbackActive,
    in b8 tokenValid,
    in b8 hasPhysicalQueueIdentity,
    in b8 queueClassMatches,
    in b8 physicalQueueMatches
){
    return feedbackActive && tokenValid && hasPhysicalQueueIdentity && queueClassMatches && physicalQueueMatches;
}


