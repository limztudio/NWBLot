UiSliderSmokeScene::UiSliderSmokeScene(){
    const b8 initialized = this.m_state.setValue(0.25)
        && this.m_disabled.setValue(0.75)
        && this.m_constant.setValue(0.5)
        && this.m_popupSlider.setValue(0.5);
    [essential] assert(initialized, "UI slider smoke states must initialize");
}

b8 UiSliderSmokeScene::paint(mut UiPaintContext context){
    context.ui.style().fontSize = 14.0f;
    context.ui.style().gap = 8.0f;
    const f32 leftWidth = Max(280.0f, (context.display.logicalWidth - 96.0f) * 0.5f);
    const f32 right = 24.0f + leftWidth + 32.0f;
    const f32 rightWidth = Max(240.0f, context.display.logicalWidth - right - 24.0f);
    if(
        !this.paintMain(context.ui, Rect(24.0f, 24.0f, leftWidth, 220.0f))
        || !this.paintOther(context.ui, Rect(right, 24.0f, rightWidth, 180.0f))
        || !this.paintPopup(context.ui, right)
        || context.ui.failed()
    )
        return false;
    this.observeState(context);
    this.paintMarkers(context);
    return true;
}

b8 UiSliderSmokeScene::keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods){
    if(key < s_SmokeKeyF4 || key > s_SmokeKeyF9)
        return false;
    if(action != s_SmokeActionPress)
        return true;
    if(key == s_SmokeKeyF4){
        if(this.m_state.setValue(this.m_state.value()))
            ++this.m_externalIntents;
    }
    else if(key == s_SmokeKeyF5){
        this.m_narrowRange = !this.m_narrowRange;
    }
    else if(key == s_SmokeKeyF6){
        this.m_coarseStep = !this.m_coarseStep;
    }
    else if(key == s_SmokeKeyF7){
        this.m_enabled = !this.m_enabled;
    }
    else if(key == s_SmokeKeyF8){
        if(this.m_state.setValue(0.25))
            ++this.m_externalIntents;
    }
    else if(key == s_SmokeKeyF9){
        this.m_parent.close();
    }
    return true;
}

b8 UiSliderSmokeScene::paintMain(mut Builder ui, in Rect bounds){
    if(!ui.beginPanel("slider_main", bounds))
        return false;
    const WidgetOptions caption = MakeFixedHeightSmokeWidget(16.0f);
    const WidgetOptions button = MakeStretchWidthSmokeWidget(28.0f);
    if(!ui.label(s_UiSliderTitleKey, "Continuous slider / exact double value", caption))
        return false;
    if(ui.button("before", "Before slider", button))
        ++this.m_beforeClicks;
    SliderOptions settings();
    settings.maximum = 1.0;
    if(this.m_narrowRange)
        settings.maximum = 0.5;
    settings.keyStep = 0.125;
    if(this.m_coarseStep)
        settings.keyStep = 0.25;
    settings.enabled = this.m_enabled;
    if(!ui.slider(s_UiSliderValueKey, this.m_state, settings))
        return false;
    if(ui.button("after", "After slider", button))
        ++this.m_afterClicks;
    if(ui.button("open", "Open parent popup", button))
        this.m_parent.open();
    if(!ui.endPanel())
        return false;
    this.m_changes += cast<u32>(this.m_state.result().valueChanged);
    return this.m_state.result().valid;
}

b8 UiSliderSmokeScene::paintOther(mut Builder ui, in Rect bounds){
    if(!ui.beginPanel("slider_other", bounds))
        return false;
    const WidgetOptions caption = MakeFixedHeightSmokeWidget(16.0f);
    if(!ui.label("disabled_title", "Disabled slider keeps its value", caption))
        return false;
    SliderOptions disabled();
    disabled.enabled = false;
    if(!ui.slider("disabled", this.m_disabled, disabled))
        return false;
    if(!ui.label("constant_title", "Constant range has no interaction", caption))
        return false;
    SliderOptions constant();
    constant.minimum = 0.5;
    constant.maximum = 0.5;
    if(!ui.slider("constant", this.m_constant, constant) || !ui.endPanel())
        return false;
    return this.m_disabled.result().valid && this.m_constant.result().valid;
}

b8 UiSliderSmokeScene::paintPopup(mut Builder ui, in f32 right){
    PopupOptions popup();
    popup.anchor = Rect(right, 228.0f, 8.0f, 24.0f);
    popup.side = PopupPlacementSide::Below;
    popup.size = MakeSmokePoint(300.0f, 144.0f);
    if(!ui.beginPopup("slider_parent", this.m_parent, popup))
        return !ui.failed();
    const WidgetOptions caption = MakeFixedHeightSmokeWidget(16.0f);
    if(!ui.label(s_UiSliderTitleKey, "Slider inside parent popup", caption))
        return false;
    SliderOptions settings();
    settings.keyStep = 0.125;
    if(!ui.slider(s_UiSliderValueKey, this.m_popupSlider, settings))
        return false;
    const WidgetOptions button = MakeStretchWidthSmokeWidget(28.0f);
    if(ui.button("close", "Close parent", button))
        this.m_parent.close();
    if(!ui.endPopup())
        return false;
    if(this.m_parent.isOpen())
        this.m_popupChanges += cast<u32>(this.m_popupSlider.result().valueChanged);
    return true;
}

void UiSliderSmokeScene::observeState(mut UiPaintContext context){
    UiSliderSnapshot current();
    current.display = context.display;
    CopySmokeSliderPlacement(current, this.m_state.placement(), 5u);
    CopySmokeSliderPlacement(current, this.m_disabled.placement(), 11u);
    CopySmokeSliderPlacement(current, this.m_constant.placement(), 17u);
    if(this.m_parent.isOpen()){
        current.rectangles[3u] = this.m_parent.placement().bounds;
        CopySmokeSliderPlacement(current, this.m_popupSlider.placement(), 23u);
    }
    u32 focusCode = 0u;
    u32 focusScope = 0u;
    u64 popupCount = 0u;
    ObserveSliderSmokeTargets(
        context.ui.input(),
        this.m_parent.instanceGeneration(),
        this.m_parent.isOpen(),
        this.m_state.inputGeneration(),
        this.m_popupSlider.inputGeneration(),
        current.rectangles,
        focusCode,
        focusScope,
        popupCount
    );
    const b8 open = this.m_parent.isOpen();
    current.values[0u] = cast<u64>(focusCode);
    current.values[1u] = cast<u64>(this.m_changes);
    current.values[2u] = cast<u64>(this.m_popupChanges);
    current.values[3u] = cast<u64>(this.m_beforeClicks);
    current.values[4u] = cast<u64>(this.m_afterClicks);
    current.values[5u] = cast<u64>(this.m_enabled);
    current.values[6u] = cast<u64>(this.m_narrowRange);
    current.values[7u] = cast<u64>(this.m_coarseStep);
    current.values[8u] = cast<u64>(open);
    current.values[9u] = popupCount;
    current.values[10u] = cast<u64>(focusScope);
    current.values[11u] = cast<u64>(this.m_state.result().valid);
    current.values[12u] = cast<u64>(this.m_state.result().dragging);
    current.values[13u] = cast<u64>(open && this.m_popupSlider.result().valid);
    current.values[14u] = cast<u64>(open && this.m_popupSlider.result().dragging);
    current.values[15u] = cast<u64>(this.m_externalIntents);
    current.bits[0u] = bit_cast<u64>(this.m_state.value());
    current.bits[1u] = bit_cast<u64>(this.m_disabled.value());
    current.bits[2u] = bit_cast<u64>(this.m_constant.value());
    current.bits[3u] = bit_cast<u64>(this.m_popupSlider.value());

    const b8 stateChanged = !SameSmokeU64Span(current.values, this.m_snapshot.values)
        || !SameSmokeU64Span(current.bits, this.m_snapshot.bits);
    const PassiveSmokeSnapshotUpdate update = EvaluatePassiveSmokeSnapshotChange(
        stateChanged,
        current.display,
        this.m_snapshot.display,
        current.rectangles,
        this.m_snapshot.rectangles,
        this.m_snapshot.sequence
    );
    if(!update.published)
        return;
    current.sequence = this.m_snapshot.sequence + 1u;
    this.m_snapshot = current;
    if(update.displayChanged){
        [essential] info(
            "UiSliderSmoke: display logical={}x{} scale={}x{}"
            , current.display.logicalWidth
            , current.display.logicalHeight
            , current.display.pixelScaleX
            , current.display.pixelScaleY
        );
    }
    [essential] info(
        "UiSliderSmoke: state sequence={} values={},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{} bits={},{},{},{}"
        , current.sequence
        , current.values[0u]
        , current.values[1u]
        , current.values[2u]
        , current.values[3u]
        , current.values[4u]
        , current.values[5u]
        , current.values[6u]
        , current.values[7u]
        , current.values[8u]
        , current.values[9u]
        , current.values[10u]
        , current.values[11u]
        , current.values[12u]
        , current.values[13u]
        , current.values[14u]
        , current.values[15u]
        , current.bits[0u]
        , current.bits[1u]
        , current.bits[2u]
        , current.bits[3u]
    );
    for(usize index = 0u; index < current.rectangles.size(); ++index)
        LogSmokeRect(s_UiSliderSmokeTag, current.sequence, UiSliderSmokeRectName(index), current.rectangles[index]);
}

void UiSliderSmokeScene::paintMarkers(mut UiPaintContext context)const{
    PaintSmokeValueMarkers(this.m_snapshot.values, this.m_snapshot.bits, this.m_snapshot.sequence, context);
}


