#include "edit_box.adhd"
#include "edit_box_style.adhd"
#include <impl/ecs_ui/toolkit/edit/actions.adhd>
#include <impl/ecs_ui/toolkit/edit/vertical_navigation.adhd>
#include <impl/ecs_ui/toolkit/id.adhd>
#include <impl/ecs_ui/toolkit/input/popup.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


interface IEditBoxHost : NoCopy{
    EditBoxResult edit(in WidgetState widget, in EditBoxOptions options, mut EditModel model);

    EditBoxResult editInPopup(in WidgetState widget, in EditBoxOptions options, in PopupToken popup, mut EditModel model);

    EditBoxResult editActions(in WidgetState widget, in EditBoxOptions options, in PopupToken popup, mut EditModel model, mut IEditActionSink actions);

    EditBoxResult editNavigated(
        in WidgetState widget,
        in EditBoxOptions options,
        in PopupToken popup,
        mut EditModel model,
        mut EditNavigationState navigation,
        mut IEditNavigationResolver resolver,
        mut IEditActionSink actions
    );

    b8 publish(in WidgetState widget, in EditBoxView view, in EditBoxPlacement placement, in EditBoxOptions options);
}


