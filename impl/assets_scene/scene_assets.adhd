////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_scene/component_assets.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{
#include <core/alloc/scratch.h>

namespace NWB::Impl{
using SceneScratchArena = Core::Alloc::ScratchArena;
using SceneScratchNameHashVector = Vector<NameHash, Core::Alloc::ScratchArena>;
using SceneScratchNameHashSet = HashSet<NameHash, Core::Alloc::ScratchArena, Hasher<NameHash>, EqualTo<NameHash>>;
using SceneScratchAssetEntryBinaryVector = Vector<SceneAssetEntryBinary, Core::Alloc::ScratchArena>;

[[nodiscard]] inline constexpr b8 LessSceneAssetEntryBinary(const SceneAssetEntryBinary& lhs, const SceneAssetEntryBinary& rhs)noexcept{
    return LessNameHash(lhs.nicknameHash, rhs.nicknameHash);
}
};
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[serialize]
class ProjectHeaderBinary{
    public u32 magic = s_ProjectMagic;
    public u32 version = s_ProjectVersion;
    public NameHash startSceneHash;
}

[serialize]
class EntityHeaderBinary{
    public u32 magic = s_EntityMagic;
    public u32 version = s_EntityVersion;
    public u64 componentCount = 0u;
}

[serialize]
class SceneHeaderBinary{
    public u32 magic = s_SceneMagic;
    public u32 version = s_SceneVersion;
    public u64 subsystemCount = 0u;
    public u64 entityCount = 0u;
    public u64 assetCount = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


ProjectHeaderBinary MakeProjectHeaderBinary(in NameHash startSceneHash){
    ProjectHeaderBinary header;
    header.startSceneHash = startSceneHash;
    return header;
}

EntityHeaderBinary MakeEntityHeaderBinary(in u64 componentCount){
    EntityHeaderBinary header;
    header.componentCount = componentCount;
    return header;
}

SceneHeaderBinary MakeSceneHeaderBinary(in u64 subsystemCount, in u64 entityCount, in u64 assetCount){
    SceneHeaderBinary header;
    header.subsystemCount = subsystemCount;
    header.entityCount = entityCount;
    header.assetCount = assetCount;
    return header;
}

b8 IsAllowedEntityAssetField(in StringView fieldName){
    return fieldName == s_EntityComponentsField;
}

b8 IsAllowedProjectAssetField(in StringView fieldName){
    return fieldName == s_SceneStartSceneField;
}

b8 IsAllowedSceneAssetField(in StringView fieldName){
    return
        fieldName == s_SceneSubsystemsField
        || fieldName == s_SceneEntitiesField
        || fieldName == s_SceneAssetsField
    ;
}

b8 ValidateEntityHeaderBinary(in EntityHeaderBinary header){
    if(header.version == s_EntityVersion)
        return true;

    error("EntityAsset::loadBinary failed: unsupported version {}", header.version);
    return false;
}

b8 ValidateProjectHeaderBinary(in ProjectHeaderBinary header){
    if(header.version == s_ProjectVersion)
        return true;

    error("ProjectAsset::loadBinary failed: unsupported version {}", header.version);
    return false;
}

b8 ValidateSceneHeaderBinary(in SceneHeaderBinary header){
    if(header.version == s_SceneVersion)
        return true;

    error("SceneAsset::loadBinary failed: unsupported version {}", header.version);
    return false;
}

b8 ValidateSceneAssetMapEntry(in Name nickname, in b8 hasValidRef){
    if(nickname == s_NameNone){
        error("SceneAsset::validatePayload failed: asset entry has an empty nickname");
        return false;
    }
    if(!hasValidRef){
        error("SceneAsset::validatePayload failed: asset nickname '{}' has an empty asset reference", nickname.resolvedText());
        return false;
    }
    return true;
}

b8 ValidateSceneAssetBinaryEntry(in Name nickname, in b8 hasValidRef, in usize index){
    if(nickname != s_NameNone && hasValidRef)
        return true;

    error("SceneAsset::loadBinary failed: invalid asset entry at index {}", index);
    return false;
}

void AssignAssetRefsFromHashes<TAsset>(in Span<NameHash> hashes, mut Vector<AssetRef<TAsset>> outRefs){
    outRefs.clear();
    outRefs.reserve(hashes.size());
    for(in NameHash hash : hashes){
        AssetRef<TAsset> ref;
        ref.virtualPath = Name(hash);
        outRefs.push_back(ref);
    }
}

b8 UnpackSceneAssetEntriesBinary<TAsset>(
    in Span<SceneAssetEntryBinary> assetEntries,
    mut HashMap<Name, AssetRef<TAsset>> outAssets
){
    outAssets.clear();
    outAssets.reserve(assetEntries.size());
    for(usize i = 0u; i < assetEntries.size(); ++i){
        const SceneAssetEntryBinary entry = assetEntries[i];
        const Name nickname(entry.nicknameHash);
        AssetRef<TAsset> ref;
        ref.virtualPath = Name(entry.assetHash);
        if(!ValidateSceneAssetBinaryEntry(nickname, ref.valid(), i))
            return false;
        if(outAssets.contains(nickname)){
            error("SceneAsset::loadBinary failed: duplicate asset nickname at index {}", i);
            return false;
        }
        outAssets.try_emplace(nickname, ref);
    }
    return true;
}

b8 ValidateProjectAssetPayload(in b8 hasStartScene){
    if(hasStartScene)
        return true;

    error("ProjectAsset::validatePayload failed: start_scene must not be empty");
    return false;
}

b8 ValidateEntityAssetComponentCount(in usize componentCount){
    if(componentCount != 0u)
        return true;

    error("EntityAsset::validatePayload failed: entity must declare at least one component");
    return false;
}

b8 ValidateSceneAssetSubsystemCount(in usize subsystemCount){
    if(subsystemCount != 0u)
        return true;

    error("SceneAsset::validatePayload failed: scene must declare at least one subsystem");
    return false;
}

b8 IsValidSceneAssetNicknameText(in StringView nicknameView){
    const StringView trimmed = trimView(nicknameView);
    return !trimmed.empty() && nicknameView == trimmed;
}

b8 ValidateUniqueAssetRefs<TAsset>(
    in Span<AssetRef<TAsset>> references,
    in StringView contextPrefix,
    in StringView contextLabel,
    mut SceneScratchArena scratchArena
){
    SceneScratchNameHashSet seen(0u, Hasher<NameHash>(), EqualTo<NameHash>(), scratchArena);
    seen.reserve(references.size());
    for(usize i = 0u; i < references.size(); ++i){
        const AssetRef<TAsset> entry = references[i];
        if(!entry.valid()){
            error("{} failed: {} entry {} is empty", contextPrefix, contextLabel, i);
            return false;
        }
        const NameHash hash = entry.name().hash();
        if(seen.contains(hash)){
            error("{} failed: duplicate {} entry at index {}", contextPrefix, contextLabel, i);
            return false;
        }
        seen.insert(hash);
    }
    return true;
}

b8 ValidateSceneAssetMap<TAsset>(in HashMap<Name, AssetRef<TAsset>> assets){
    for(in auto entry : assets){
        if(!ValidateSceneAssetMapEntry(entry.first, entry.second.valid()))
            return false;
    }
    return true;
}

void CollectAssetRefHashes<TAsset>(
    in Span<AssetRef<TAsset>> references,
    mut SceneScratchNameHashVector outHashes
){
    outHashes.clear();
    outHashes.reserve(references.size());
    for(in AssetRef<TAsset> item : references)
        outHashes.push_back(item.name().hash());
}

void CollectSortedSceneAssetEntries<TAsset>(
    in HashMap<Name, AssetRef<TAsset>> assets,
    mut SceneScratchAssetEntryBinaryVector outEntries
){
    outEntries.clear();
    outEntries.reserve(assets.size());
    for(in auto entry : assets)
        outEntries.push_back(SceneAssetEntryBinary(entry.first.hash(), entry.second.name().hash()));
    native(mut outEntries){
        Sort(outEntries.begin(), outEntries.end(), LessSceneAssetEntryBinary);
    }
}

const usize s_EntityHeaderBinaryBytes = 16u;
const usize s_ProjectHeaderBinaryBytes = 72u;
const usize s_SceneHeaderBinaryBytes = 32u;
const usize s_NameHashBinaryBytes = 64u;
const usize s_SceneAssetEntryBinaryBytes = 128u;

b8 SerializeEntityAssetBinary<TComponent>(in Span<AssetRef<TComponent>> components, mut Vector<u8> outBinary){
    usize reserveBytes = s_EntityHeaderBinaryBytes;
    if(!AddBinaryRepeatedReserveBytes(reserveBytes, components.size(), s_NameHashBinaryBytes) || !CanStoreValueCount(outBinary, reserveBytes)){
        error("EntityAssetCodec::serialize failed: 'components' payload byte size overflows");
        return false;
    }
    outBinary.clear();
    outBinary.reserve(reserveBytes);
    AppendPOD(outBinary, MakeEntityHeaderBinary(cast<u64>(components.size())));
    for(in AssetRef<TComponent> component : components)
        AppendPOD(outBinary, component.name().hash());
    return true;
}

b8 SerializeSceneAssetBinary<TSubsystem, TEntity, TAsset>(
    in Span<AssetRef<TSubsystem>> subsystems,
    in Span<AssetRef<TEntity>> entities,
    in HashMap<Name, AssetRef<TAsset>> assets,
    mut SceneScratchAssetEntryBinaryVector scratchAssetEntries,
    mut Vector<u8> outBinary
){
    CollectSortedSceneAssetEntries(assets, scratchAssetEntries);
    usize reserveBytes = s_SceneHeaderBinaryBytes;
    const b8 canReserve =
        AddBinaryRepeatedReserveBytes(reserveBytes, subsystems.size(), s_NameHashBinaryBytes)
        && AddBinaryRepeatedReserveBytes(reserveBytes, entities.size(), s_NameHashBinaryBytes)
        && AddBinaryRepeatedReserveBytes(reserveBytes, scratchAssetEntries.size(), s_SceneAssetEntryBinaryBytes)
        && CanStoreValueCount(outBinary, reserveBytes)
    ;
    if(!canReserve){
        error("SceneAssetCodec::serialize failed: scene payload byte size overflows");
        return false;
    }
    outBinary.clear();
    outBinary.reserve(reserveBytes);
    AppendPOD(outBinary, MakeSceneHeaderBinary(cast<u64>(subsystems.size()), cast<u64>(entities.size()), cast<u64>(scratchAssetEntries.size())));
    for(in AssetRef<TSubsystem> subsystem : subsystems)
        AppendPOD(outBinary, subsystem.name().hash());
    for(in AssetRef<TEntity> entity : entities)
        AppendPOD(outBinary, entity.name().hash());
    for(in SceneAssetEntryBinary entry : scratchAssetEntries)
        AppendPOD(outBinary, entry);
    return true;
}

b8 DeserializeProjectAssetBinary(in Span<u8> binary, mut Name outStartScene){
    usize cursor = 0u;
    const Expected<ProjectHeaderBinary> headerResult = ReadPOD<ProjectHeaderBinary>(binary, cursor);
    if(!headerResult.has_value()){
        error("ProjectAsset::loadBinary failed: malformed header");
        return false;
    }
    const ProjectHeaderBinary header = headerResult.value();
    if(header.magic != s_ProjectMagic){
        error("ProjectAsset::loadBinary failed: invalid project asset format; recook required");
        return false;
    }
    if(!ValidateProjectHeaderBinary(header))
        return false;
    if(cursor != binary.size()){
        error("ProjectAsset::loadBinary failed: trailing bytes detected");
        return false;
    }
    outStartScene = Name(header.startSceneHash);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
