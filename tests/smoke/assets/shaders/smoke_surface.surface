// Solid smoke surface hook fragment. The cook wraps it with the engine pixel-shader authoring + this material's
// typed .bind to generate the G-buffer pixel shader.
NwbMeshSurface nwbMaterialSurface(){
    const NwbMeshInstanceData instance = nwbMeshLoadInstance();
    const NwbSmokeSurfaceMaterial surface = nwbMaterialBindLoadSurface(instance);
    const NwbSmokeRuntimeMaterial runtime = nwbMaterialBindLoadRuntime(instance);
    const half4 fixtureColor = half4(nwbMaterialBindLoadSurfaceBaseColorMap(instance).SampleLevel(
        nwbMaterialBindLoadSurfaceBaseColorSampler(instance),
        inUv0,
        0.0
    ));
    const half fixtureWeight = clamp(surface.fixture_color_weight, half(0.0h), half(1.0h));
    const half4 baseColorFactor = lerp(half4(1.0h, 1.0h, 1.0h, 1.0h), fixtureColor, fixtureWeight);
    const half3 baseColor = clamp((surface.base_color * runtime.color_tint * baseColorFactor).rgb, half3(0.0h), half3(1.0h));
    return nwbMakeMeshSurface(baseColor, inNormal);
}


