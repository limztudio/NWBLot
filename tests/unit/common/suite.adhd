NWB_ADHD_GTEST(NameSymbolDecodeTests, UnknownAndBoundaryNarrowTokensDoNotAllocate, VerifyNameSymbolDecodeTests_UnknownAndBoundaryNarrowTokensDoNotAllocate)
NWB_ADHD_GTEST(NameSymbolDecodeTests, ResolvesNarrowSpansWithoutChangingUnresolvedText, VerifyNameSymbolDecodeTests_ResolvesNarrowSpansWithoutChangingUnresolvedText)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace CommonTestsDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void CallbackUnregisterLogger::handle(const TStringView text, const Core::Common::LogType::Enum){
    m_callbackCount.fetch_add(1u, MemoryOrder::relaxed);
    m_bothEnteredGate.arrive_and_wait();
    if(text == FOUNDATION_TEXT("self-unregister")){
        m_unregistrationStarted.testAndSet(MemoryOrder::release);
        m_unregistrationStarted.notifyAll();
        m_guardSlot.reset();
        if(m_peerStillInCallback.load(MemoryOrder::acquire))
            m_unregistrationReturnedWhilePeerActive.store(true, MemoryOrder::relaxed);
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("routed-to-base-after-self-unregister"));
        return;
    }

    while(!m_unregistrationStarted.test(MemoryOrder::acquire))
        m_unregistrationStarted.wait(false, MemoryOrder::relaxed);
    for(u32 spin = 0u; spin < 64u; ++spin)
        YieldThread();
    m_peerStillInCallback.store(false, MemoryOrder::release);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_END


