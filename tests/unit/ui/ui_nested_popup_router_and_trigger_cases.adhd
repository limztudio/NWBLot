void VerifyUiNestedPopupRouterTests_ChildMayExtendOutsideParentWhileFocusAndPointerStayInAcceptedTopScope(mut UiNestedPopupRouterTests self){
    const PopupScope parent = MakeUiNestedPopupRouterScope(100u, 1u);
    const PopupScope child = MakeUiNestedPopupRouterScope(200u, 2u, parent.token);
    Array<PopupScope, 2u> scopes = Array<PopupScope, 2u>();
    scopes[0u] = parent;
    scopes[1u] = child;
    ASSERT_TRUE(self.install(scopes, 1u));
    ASSERT_EQ(self.m_router.popupCount(), 2u);
    const Optional<PopupScope> childScope = self.findPopupScope(child.token);
    ASSERT_TRUE(childScope.has_value());
    EXPECT_EQ(childScope.value().parent, parent.token);
    EXPECT_EQ(self.m_router.topPopupToken(), child.token);
    EXPECT_EQ(self.m_router.focus().value, 201u);
    EXPECT_EQ(self.m_router.hitTest(MakeUiNestedPopupRouterPoint(175.0f, 125.0f)).value, 201u);
    EXPECT_FALSE(self.m_router.hitTest(MakeUiNestedPopupRouterPoint(35.0f, 35.0f)).valid());
    self.key(CoreKey::Tab);
    EXPECT_EQ(self.m_router.focus().value, 202u);
    self.key(CoreKey::Tab);
    EXPECT_EQ(self.m_router.focus().value, 201u);
    self.key(CoreKey::Tab, true);
    EXPECT_EQ(self.m_router.focus().value, 202u);
    self.key(CoreKey::Enter);
    EXPECT_TRUE(self.m_router.consumeActivation(MakeUiNestedPopupRouterWidgetId(202u)));
    EXPECT_FALSE(self.m_router.consumeActivation(MakeUiNestedPopupRouterWidgetId(101u)));
}

void VerifyUiNestedPopupRouterTests_EscapeDismissesOnlyChildThenRestoresChosenParentFocusAfterAcceptance(mut UiNestedPopupRouterTests self){
    self.focusBase();
    const PopupScope parent = MakeUiNestedPopupRouterScope(100u, 1u);
    ASSERT_TRUE(self.installOne(parent, 2u));
    self.key(CoreKey::Tab);
    ASSERT_EQ(self.m_router.focus().value, 102u);
    const PopupScope child = MakeUiNestedPopupRouterScope(200u, 2u, parent.token);
    Array<PopupScope, 2u> scopes = Array<PopupScope, 2u>();
    scopes[0u] = parent;
    scopes[1u] = child;
    ASSERT_TRUE(self.install(scopes, 3u));
    ASSERT_EQ(self.m_router.focus().value, 201u);
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterKeyEvent(InputEventType::KeyDown, CoreKey::Escape, false)).commandConsumed);
    PopupDismissReasonEnum reason = PopupDismissReason::None;
    const auto reasonResult1 = self.m_router.consumePopupDismissal(child.token);
    ASSERT_TRUE(reasonResult1.has_value());
    reason = reasonResult1.value();
    EXPECT_EQ(reason, PopupDismissReason::Cancel);
    EXPECT_FALSE(self.m_router.consumePopupDismissal(parent.token).has_value());
    EXPECT_FALSE(self.m_router.focus().valid());
    ASSERT_TRUE(self.installOne(parent, 4u));
    EXPECT_EQ(self.m_router.focus().value, 102u);
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterKeyEvent(InputEventType::KeyDown, CoreKey::Escape, true)).commandConsumed);
    EXPECT_FALSE(self.m_router.consumePopupDismissal(parent.token).has_value());
    EXPECT_EQ(self.m_router.focus().value, 102u);
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterKeyEvent(InputEventType::KeyUp, CoreKey::Escape, false)).commandConsumed);
    self.key(CoreKey::Escape);
    const auto reasonResult2 = self.m_router.consumePopupDismissal(parent.token);
    ASSERT_TRUE(reasonResult2.has_value());
    reason = reasonResult2.value();
    EXPECT_EQ(reason, PopupDismissReason::Cancel);
}

void VerifyUiNestedPopupRouterTests_OptedInChildTabLeavesItsParentOpenAndAdvancesParentFocus(mut UiNestedPopupRouterTests self){
    self.focusBase();
    const PopupScope parent = MakeUiNestedPopupRouterScope(100u, 1u);
    ASSERT_TRUE(self.installOne(parent, 2u));
    self.key(CoreKey::Tab);
    ASSERT_EQ(self.m_router.focus().value, 102u);
    PopupScope child = MakeUiNestedPopupRouterScope(200u, 2u, parent.token);
    child.dismissFocusTraversal = true;
    child.focusAnchor = MakeUiNestedPopupRouterWidgetId(102u);
    child.focusAnchorDeclarationGeneration = 10u;
    Array<PopupScope, 2u> scopes = Array<PopupScope, 2u>();
    scopes[0u] = parent;
    scopes[1u] = child;
    ASSERT_TRUE(self.install(scopes, 3u));
    ASSERT_EQ(self.m_router.focus().value, 201u);
    self.key(CoreKey::Tab);
    EXPECT_EQ(self.m_router.focus().value, 202u);
    self.key(CoreKey::Tab);
    PopupDismissReasonEnum reason = PopupDismissReason::None;
    const auto reasonResult = self.m_router.consumePopupDismissal(child.token);
    ASSERT_TRUE(reasonResult.has_value());
    reason = reasonResult.value();
    EXPECT_EQ(reason, PopupDismissReason::FocusTraversal);
    EXPECT_FALSE(self.m_router.consumePopupDismissal(parent.token).has_value());
    ASSERT_TRUE(self.installOne(parent, 4u));
    EXPECT_EQ(self.m_router.popupCount(), 1u);
    EXPECT_EQ(self.m_router.topPopupToken(), parent.token);
    EXPECT_EQ(self.m_router.focus().value, 101u);
}

void VerifyUiNestedPopupRouterTests_OutsideChildPressOverParentConsumesReleaseWithoutParentActivation(mut UiNestedPopupRouterTests self){
    const PopupScope parent = MakeUiNestedPopupRouterScope(100u, 1u);
    const PopupScope child = MakeUiNestedPopupRouterScope(200u, 2u, parent.token);
    Array<PopupScope, 2u> scopes = Array<PopupScope, 2u>();
    scopes[0u] = parent;
    scopes[1u] = child;
    ASSERT_TRUE(self.install(scopes, 1u));
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerEvent(InputEventType::PrimaryDown, 35.0f, 35.0f)).pointerConsumed);
    EXPECT_FALSE(self.m_router.capture().valid());
    PopupDismissReasonEnum reason = PopupDismissReason::None;
    const auto reasonResult = self.m_router.consumePopupDismissal(child.token);
    ASSERT_TRUE(reasonResult.has_value());
    reason = reasonResult.value();
    EXPECT_EQ(reason, PopupDismissReason::OutsideClick);
    EXPECT_FALSE(self.m_router.consumePopupDismissal(parent.token).has_value());
    ASSERT_TRUE(self.installOne(parent, 2u));
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerEvent(InputEventType::PrimaryUp, 35.0f, 35.0f)).pointerConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(MakeUiNestedPopupRouterWidgetId(101u)));
    self.click(MakeUiNestedPopupRouterPoint(35.0f, 35.0f));
    EXPECT_TRUE(self.m_router.consumeActivation(MakeUiNestedPopupRouterWidgetId(101u)));
}

void VerifyUiNestedPopupRouterTests_OutsideSecondarySequenceCannotOpenTheNewlyExposedParentMenu(mut UiNestedPopupRouterTests self){
    const PopupScope parent = MakeUiNestedPopupRouterScope(100u, 1u);
    const PopupScope child = MakeUiNestedPopupRouterScope(200u, 2u, parent.token);
    Array<PopupScope, 2u> scopes = Array<PopupScope, 2u>();
    scopes[0u] = parent;
    scopes[1u] = child;
    ASSERT_TRUE(self.install(scopes, 1u, true));
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerEvent(InputEventType::SecondaryDown, 35.0f, 35.0f)).pointerConsumed);
    const auto reasonResult = self.m_router.consumePopupDismissal(child.token);
    ASSERT_TRUE(reasonResult.has_value());
    ASSERT_TRUE(self.installOne(parent, 2u, true));
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerEvent(InputEventType::SecondaryUp, 35.0f, 35.0f)).pointerConsumed);
    const WidgetId target101 = MakeUiNestedPopupRouterWidgetId(101u);
    ContextMenuAction action = ContextMenuAction();
    EXPECT_FALSE(self.m_router.consumeContextMenu(target101, 10u).has_value());
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerEvent(InputEventType::SecondaryDown, 35.0f, 35.0f)).pointerConsumed);
    EXPECT_FALSE(self.m_router.consumeContextMenu(target101, 10u).has_value());
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerEvent(InputEventType::SecondaryUp, 35.0f, 35.0f)).pointerConsumed);
    const auto actionResult = self.m_router.consumeContextMenu(target101, 10u);
    ASSERT_TRUE(actionResult.has_value());
    action = actionResult.value();
    EXPECT_EQ(action.popup, parent.token);
    EXPECT_EQ(action.origin, InputActionSource::Pointer);
}

void VerifyUiNestedPopupRouterTests_ClosingAncestorPreservesUnrelatedTopChainAndItsAcceptedAction(mut UiNestedPopupRouterTests self){
    self.focusBase();
    const PopupScope parent = MakeUiNestedPopupRouterScope(100u, 1u);
    const PopupScope child = MakeUiNestedPopupRouterScope(200u, 2u, parent.token);
    const PopupScope grandchild = MakeUiNestedPopupRouterScope(300u, 3u, child.token);
    const PopupScope unrelated = MakeUiNestedPopupRouterScope(400u, 4u);
    Array<PopupScope, 4u> scopes = Array<PopupScope, 4u>();
    scopes[0u] = parent;
    scopes[1u] = child;
    scopes[2u] = grandchild;
    scopes[3u] = unrelated;
    ASSERT_TRUE(self.install(scopes, 2u));
    self.key(CoreKey::Enter);
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    self.m_router.closePopup(parent.token);
    EXPECT_EQ(self.m_router.focus().value, 401u);
    EXPECT_EQ(self.m_router.hitTest(MakeUiNestedPopupRouterPoint(255.0f, 35.0f)).value, 401u);
    EXPECT_TRUE(self.m_router.consumeActivation(MakeUiNestedPopupRouterWidgetId(401u)));
    ASSERT_TRUE(self.installOne(unrelated, 3u));
    EXPECT_EQ(self.m_router.popupCount(), 1u);
    EXPECT_EQ(self.m_router.focus().value, 401u);
    EXPECT_FALSE(self.hasPopupScope(parent.token));
    EXPECT_FALSE(self.hasPopupScope(child.token));
    EXPECT_FALSE(self.hasPopupScope(grandchild.token));
    ASSERT_TRUE(self.installEmpty(4u));
    EXPECT_EQ(self.m_router.focus().value, 1u);
}

void VerifyUiNestedPopupRouterTests_RetiringAncestorCancelsDescendantIntentionsAcrossRemovalAndIdenticalReturn(mut UiNestedPopupRouterTests self){
    self.focusBase();
    const PopupScope parent = MakeUiNestedPopupRouterScope(100u, 1u);
    const PopupScope child = MakeUiNestedPopupRouterScope(200u, 2u, parent.token);
    Array<PopupScope, 2u> scopes = Array<PopupScope, 2u>();
    scopes[0u] = parent;
    scopes[1u] = child;
    ASSERT_TRUE(self.install(scopes, 2u, true));
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterKeyEvent(InputEventType::KeyDown, CoreKey::Down, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterKeyEvent(InputEventType::KeyDown, CoreKey::Menu, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerEvent(InputEventType::PrimaryDown, 175.0f, 125.0f)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerEvent(InputEventType::SecondaryDown, 175.0f, 125.0f)).pointerConsumed);
    ASSERT_EQ(self.m_router.capture().value, 201u);
    ASSERT_EQ(self.m_router.controlActions().size(), 1u);
    self.m_router.invalidateTarget(parent.token.widget);
    EXPECT_FALSE(self.m_router.hasPopup());
    EXPECT_EQ(self.m_router.popupCount(), 0u);
    ASSERT_EQ(self.m_router.targets().size(), 1u);
    EXPECT_EQ(self.m_router.focus().value, 1u);
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.m_router.controlActions().empty());
    const WidgetId target201 = MakeUiNestedPopupRouterWidgetId(201u);
    EXPECT_FALSE(self.m_router.consumeContextMenu(target201, 10u).has_value());
    ASSERT_TRUE(self.install(scopes, 3u, true));
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterKeyEvent(InputEventType::KeyDown, CoreKey::Down, true)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterKeyEvent(InputEventType::KeyDown, CoreKey::Menu, false)).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_FALSE(self.m_router.consumeContextMenu(target201, 10u).has_value());
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerEvent(InputEventType::PrimaryUp, 175.0f, 125.0f)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerEvent(InputEventType::SecondaryUp, 175.0f, 125.0f)).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterKeyEvent(InputEventType::KeyUp, CoreKey::Down, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterKeyEvent(InputEventType::KeyUp, CoreKey::Menu, false)).commandConsumed);
    self.key(CoreKey::Down);
    ControlAction action = ControlAction();
    const auto actionResult = self.m_router.consumeControlAction(target201, 10u, MakeUiNestedPopupRouterControlToken(600u, 700u, 800u));
    ASSERT_TRUE(actionResult.has_value());
    action = actionResult.value();
    EXPECT_EQ(action.popup, child.token);
    EXPECT_EQ(action.kind, ControlActionKind::Down);
}

void VerifyUiNestedPopupRouterTests_RetiringLowerFamilyPreservesUnrelatedTopCaptureAndFocus(mut UiNestedPopupRouterTests self){
    const PopupScope parent = MakeUiNestedPopupRouterScope(100u, 1u);
    const PopupScope child = MakeUiNestedPopupRouterScope(200u, 2u, parent.token);
    const PopupScope unrelated = MakeUiNestedPopupRouterScope(400u, 3u);
    Array<PopupScope, 3u> scopes = Array<PopupScope, 3u>();
    scopes[0u] = parent;
    scopes[1u] = child;
    scopes[2u] = unrelated;
    ASSERT_TRUE(self.install(scopes, 1u));
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerEvent(InputEventType::PrimaryDown, 255.0f, 35.0f)).pointerConsumed);
    ASSERT_EQ(self.m_router.capture().value, 401u);
    self.m_router.invalidateTarget(parent.token.widget);
    EXPECT_EQ(self.m_router.popupCount(), 1u);
    EXPECT_EQ(self.m_router.topPopupToken(), unrelated.token);
    EXPECT_EQ(self.m_router.focus().value, 401u);
    EXPECT_EQ(self.m_router.capture().value, 401u);
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerEvent(InputEventType::PrimaryUp, 255.0f, 35.0f)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(MakeUiNestedPopupRouterWidgetId(401u)));
    EXPECT_FALSE(self.m_router.consumeActivation(MakeUiNestedPopupRouterWidgetId(201u)));
}

void VerifyUiNestedPopupRouterTests_ChangingAncestorRequiresRenewedChildTokenAndFencesOldCapture(mut UiNestedPopupRouterTests self){
    const PopupScope parent = MakeUiNestedPopupRouterScope(100u, 1u);
    const PopupScope child = MakeUiNestedPopupRouterScope(200u, 2u, parent.token);
    Array<PopupScope, 2u> original = Array<PopupScope, 2u>();
    original[0u] = parent;
    original[1u] = child;
    ASSERT_TRUE(self.install(original, 1u));
    self.click(MakeUiNestedPopupRouterPoint(175.0f, 125.0f));
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerEvent(InputEventType::PrimaryDown, 175.0f, 125.0f)).pointerConsumed);
    PopupScope nextParent = parent;
    ++nextParent.token.openGeneration;
    PopupScope nextChild = child;
    Array<PopupScope, 2u> staleParent = Array<PopupScope, 2u>();
    staleParent[0u] = nextParent;
    staleParent[1u] = nextChild;
    EXPECT_FALSE(self.install(staleParent, 2u));
    nextChild.parent = nextParent.token;
    Array<PopupScope, 2u> staleChild = Array<PopupScope, 2u>();
    staleChild[0u] = nextParent;
    staleChild[1u] = nextChild;
    EXPECT_FALSE(self.install(staleChild, 2u));
    EXPECT_EQ(self.m_router.layoutGeneration(), 1u);
    EXPECT_EQ(self.m_router.focus().value, 201u);
    EXPECT_EQ(self.m_router.capture().value, 201u);
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    ++nextChild.token.openGeneration;
    Array<PopupScope, 2u> renewed = Array<PopupScope, 2u>();
    renewed[0u] = nextParent;
    renewed[1u] = nextChild;
    ASSERT_TRUE(self.install(renewed, 2u));
    EXPECT_EQ(self.m_router.focus().value, 201u);
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerEvent(InputEventType::PrimaryUp, 175.0f, 125.0f)).pointerConsumed);
    const WidgetId target201 = MakeUiNestedPopupRouterWidgetId(201u);
    EXPECT_FALSE(self.m_router.consumeActivation(target201));
    self.click(MakeUiNestedPopupRouterPoint(175.0f, 125.0f));
    EXPECT_TRUE(self.m_router.consumeActivation(target201));
}

void VerifyUiNestedPopupRouterTests_InvalidOrMissingAncestryRejectsAtomicallyAgainstAcceptedNestedGeometry(mut UiNestedPopupRouterTests self){
    const PopupScope parent = MakeUiNestedPopupRouterScope(100u, 1u);
    const PopupScope child = MakeUiNestedPopupRouterScope(200u, 2u, parent.token);
    Array<PopupScope, 2u> scopes = Array<PopupScope, 2u>();
    scopes[0u] = parent;
    scopes[1u] = child;
    ASSERT_TRUE(self.install(scopes, 1u));
    self.click(MakeUiNestedPopupRouterPoint(175.0f, 125.0f));
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerEvent(InputEventType::PrimaryDown, 175.0f, 125.0f)).pointerConsumed);
    Array<PopupScope, 5u> invalid = Array<PopupScope, 5u>();
    invalid.fill(child);
    ++invalid[0u].parent.openGeneration;
    invalid[1u].parent.widget = WidgetId();
    invalid[2u].parent = MakeUiNestedPopupRouterToken(999u, 10u, 20u, 1u);
    invalid[3u].parent = child.token;
    invalid[4u].parent = PopupToken();
    for(in PopupScope candidate : invalid){
        Array<PopupScope, 2u> rejected = Array<PopupScope, 2u>();
        rejected[0u] = parent;
        rejected[1u] = candidate;
        EXPECT_FALSE(self.install(rejected, 2u));
        EXPECT_EQ(self.m_router.layoutGeneration(), 1u);
        EXPECT_EQ(self.m_router.focus().value, 201u);
        EXPECT_EQ(self.m_router.capture().value, 201u);
        EXPECT_EQ(self.m_router.hitTest(MakeUiNestedPopupRouterPoint(175.0f, 125.0f)).value, 201u);
        EXPECT_EQ(self.m_router.actions().size(), 1u);
    }
    EXPECT_FALSE(self.installOne(child, 2u));
    PopupScope forwardParent = parent;
    forwardParent.parent = child.token;
    Array<PopupScope, 2u> cyclic = Array<PopupScope, 2u>();
    cyclic[0u] = forwardParent;
    cyclic[1u] = child;
    EXPECT_FALSE(self.install(cyclic, 2u));
    EXPECT_EQ(self.m_router.popupCount(), 2u);
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerEvent(InputEventType::PrimaryUp, 175.0f, 125.0f)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(MakeUiNestedPopupRouterWidgetId(201u)));
}

void VerifyUiNestedPopupRouterTests_NewDescendantsCannotRestoreInputBeneathAClosingAncestorLifetime(mut UiNestedPopupRouterTests self){
    PopupScope parent = MakeUiNestedPopupRouterScope(100u, 1u);
    PopupScope child = MakeUiNestedPopupRouterScope(200u, 2u, parent.token);
    PopupScope grandchild = MakeUiNestedPopupRouterScope(300u, 3u, child.token);
    Array<PopupScope, 3u> original = Array<PopupScope, 3u>();
    original[0u] = parent;
    original[1u] = child;
    original[2u] = grandchild;
    ASSERT_TRUE(self.install(original, 1u));
    self.m_router.closePopup(parent.token);
    ++child.token.openGeneration;
    ++grandchild.token.openGeneration;
    grandchild.parent = child.token;
    Array<PopupScope, 3u> underClosingParent = Array<PopupScope, 3u>();
    underClosingParent[0u] = parent;
    underClosingParent[1u] = child;
    underClosingParent[2u] = grandchild;
    ASSERT_TRUE(self.install(underClosingParent, 2u));
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.hitTest(MakeUiNestedPopupRouterPoint(285.0f, 205.0f)).valid());
    EXPECT_TRUE(self.m_router.actions().empty());
    ++parent.token.openGeneration;
    self.m_router.fencePopup(parent.token);
    ++child.token.openGeneration;
    child.parent = parent.token;
    ++grandchild.token.openGeneration;
    grandchild.parent = child.token;
    Array<PopupScope, 3u> renewed = Array<PopupScope, 3u>();
    renewed[0u] = parent;
    renewed[1u] = child;
    renewed[2u] = grandchild;
    ASSERT_TRUE(self.install(renewed, 3u));
    EXPECT_EQ(self.m_router.focus().value, 301u);
    EXPECT_EQ(self.m_router.hitTest(MakeUiNestedPopupRouterPoint(285.0f, 205.0f)).value, 301u);
}

void VerifyUiNestedPopupRouterTests_FencingAncestorImmediatelySuppressesAllDescendantActionsAndCapture(mut UiNestedPopupRouterTests self){
    const PopupScope parent = MakeUiNestedPopupRouterScope(100u, 1u);
    const PopupScope child = MakeUiNestedPopupRouterScope(200u, 2u, parent.token);
    const PopupScope grandchild = MakeUiNestedPopupRouterScope(300u, 3u, child.token);
    Array<PopupScope, 3u> scopes = Array<PopupScope, 3u>();
    scopes[0u] = parent;
    scopes[1u] = child;
    scopes[2u] = grandchild;
    ASSERT_TRUE(self.install(scopes, 1u));
    self.click(MakeUiNestedPopupRouterPoint(285.0f, 205.0f));
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerEvent(InputEventType::PrimaryDown, 285.0f, 205.0f)).pointerConsumed);
    PopupToken replaced = parent.token;
    ++replaced.instanceGeneration;
    self.m_router.fencePopup(replaced);
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.hitTest(MakeUiNestedPopupRouterPoint(285.0f, 205.0f)).valid());
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterPointerEvent(InputEventType::PrimaryUp, 285.0f, 205.0f)).pointerConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(MakeUiNestedPopupRouterWidgetId(301u)));
}

void VerifyUiNestedPopupRouterTests_RetiringAnAlreadyRemovedPopupOwnerPartStillRestoresUnderlyingFocus(mut UiNestedPopupRouterTests self){
    self.focusBase();
    const PopupScope scope = MakeUiNestedPopupRouterScope(100u, 1u);
    const HitTarget host = MakeUiNestedPopupRouterChild(scope, 1u, 1u, true);
    HitTarget owner = MakeUiNestedPopupRouterBarrier(scope, 2u);
    owner.owner = host.id;
    owner.ownerDeclarationGeneration = host.declarationGeneration;
    owner.control = host.control;
    Array<HitTarget, 3u> targets = Array<HitTarget, 3u>();
    targets[0u] = MakeUiNestedPopupRouterBaseHitTarget();
    targets[1u] = host;
    targets[2u] = owner;
    ASSERT_TRUE(self.commitSingleScopeTargets(targets, 2u, scope));
    self.m_router.invalidateTarget(host.id);
    EXPECT_EQ(self.m_router.targets().size(), 1u);
    EXPECT_FALSE(self.hasRouterTarget(owner.id));
    EXPECT_EQ(self.m_router.popupCount(), 1u);
    EXPECT_FALSE(self.m_router.focus().valid());
    self.m_router.invalidateTarget(owner.id);
    EXPECT_EQ(self.m_router.popupCount(), 0u);
    EXPECT_EQ(self.m_router.focus(), MakeUiNestedPopupRouterBaseHitTarget().id);
    EXPECT_EQ(self.m_router.targets().size(), 1u);
}

void VerifyUiNestedPopupRouterTests_NativeFocusLossDismissesWholeFamilyWithoutRestoringUnderlyingFocus(mut UiNestedPopupRouterTests self){
    self.focusBase();
    const PopupScope parent = MakeUiNestedPopupRouterScope(100u, 1u);
    const PopupScope child = MakeUiNestedPopupRouterScope(200u, 2u, parent.token);
    const PopupScope grandchild = MakeUiNestedPopupRouterScope(300u, 3u, child.token);
    Array<PopupScope, 3u> scopes = Array<PopupScope, 3u>();
    scopes[0u] = parent;
    scopes[1u] = child;
    scopes[2u] = grandchild;
    ASSERT_TRUE(self.install(scopes, 2u));
    EXPECT_TRUE(self.send(MakeUiNestedPopupRouterFocusEvent(InputEventType::FocusLost)).commandConsumed);
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.hitTest(MakeUiNestedPopupRouterPoint(285.0f, 205.0f)).valid());
    PopupDismissReasonEnum reason = PopupDismissReason::None;
    for(in PopupScope scope : scopes){
        const auto reasonResult = self.m_router.consumePopupDismissal(scope.token);
        ASSERT_TRUE(reasonResult.has_value());
        reason = reasonResult.value();
        EXPECT_EQ(reason, PopupDismissReason::FocusLost);
        EXPECT_FALSE(self.m_router.consumePopupDismissal(scope.token).has_value());
    }
    EXPECT_FALSE(self.send(MakeUiNestedPopupRouterFocusEvent(InputEventType::FocusGained)).focus.valid());
    ASSERT_TRUE(self.installEmpty(3u));
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.hasPopup());
}


