void VerifyUiScrollbarLayoutTests_FittingContentKeepsPaddedViewportAndClampsStoredOffsets(){
    const Rect bounds = Rect(10.0f, 20.0f, 200.0f, 120.0f);
    const auto placementResult = CalculateScrollViewportPlacement(
        bounds,
        bounds,
        MakeUiRadioScrollInsets(8.0f, 6.0f, 4.0f, 14.0f),
        Point(100.0f, 80.0f),
        2.0f,
        Point(40.0f, 60.0f),
        12.0f,
        16.0f
    );
    ASSERT_TRUE(placementResult.has_value());
    const ScrollViewportPlacement placement = placementResult.value();
    ExpectUiRect(placement.viewport, Rect(18.0f, 26.0f, 188.0f, 100.0f));
    ExpectUiRect(placement.contentClip, placement.viewport);
    ExpectUiRect(placement.corner, Rect());
    ExpectUiRect(placement.horizontal.track, Rect());
    ExpectUiRect(placement.vertical.track, Rect());
    EXPECT_DOUBLE_EQ(placement.horizontal.offset, 0.0);
    EXPECT_DOUBLE_EQ(placement.vertical.offset, 0.0);
    EXPECT_FALSE(placement.horizontal.visible);
    EXPECT_FALSE(placement.vertical.visible);
}

void VerifyUiScrollbarLayoutTests_ExactContentFitDoesNotReserveEitherBar(){
    const Rect bounds = Rect(0.0f, 0.0f, 100.0f, 80.0f);
    const auto placementResult = CalculateScrollViewportPlacement(bounds, bounds, Insets(), Point(99.0f, 80.0f), 1.0f, Point(), 12.0f, 16.0f);
    ASSERT_TRUE(placementResult.has_value());
    const ScrollViewportPlacement placement = placementResult.value();
    ExpectUiRect(placement.viewport, bounds);
    EXPECT_FALSE(placement.horizontal.visible);
    EXPECT_FALSE(placement.vertical.visible);
    EXPECT_DOUBLE_EQ(placement.horizontal.maximum, 0.0);
    EXPECT_DOUBLE_EQ(placement.vertical.maximum, 0.0);
}

void VerifyUiScrollbarLayoutTests_HorizontalExtentIncludesCaretWidth(){
