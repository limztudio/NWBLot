Expected<UniquePtr<World>> CreateInitialProjectWorld(mut ProjectRuntimeContext context){
    UniquePtr<World> world = UniquePtr<World>();
    b8 created = false;
    native(mut context, mut world, mut created){
        static constexpr TStringView s_WorldAllocFailed = NWB_TEXT("CreateInitialProjectWorld failed: ECS world allocation failed");
        static constexpr TStringView s_ResolverNull = NWB_TEXT("CreateInitialProjectWorld failed: shader path resolver callback is null");

        world = MakeUnique<World>(context.objectArena, context.cpuTasks);
        if(!world){
            NWB_LOGGER_FATAL(s_WorldAllocFailed);
        }
        else if(!context.shaderPathResolver){
            NWB_LOGGER_FATAL(s_ResolverNull);
            world.reset();
        }
        else{
            auto& meshSystem = world->addSystem<MeshSystem>(*world);
            auto& rendererSystem = world->addSystem<RendererSystem>(*world, context.graphics, context.assetManager, context.shaderPathResolver);
            world->addSystem<ModelSystem>(*world, context.assetManager, NWB::Impl::CreateModelObjectRendererHooks());
            auto& meshSkinningSystem = world->addSystem<MeshSkinningSystem>(*world, context.graphics, context.assetManager, meshSystem, context.shaderPathResolver);
            auto& uiLayerSystem = world->addSystem<UiLayerSystem>(
                *world,
                context.graphics,
                context.input,
                context.clipboard,
                context.textInput,
                context.assetManager,
                context.shaderPathResolver,
                NWB::Core::Assets::AssetRef<UiSkin>{},
                UiLayerPresentation::Scene
            );
            context.graphics.addRenderPassToBack(meshSkinningSystem);
            context.graphics.addRenderPassToBack(rendererSystem);
            context.graphics.addRenderPassToBack(uiLayerSystem);
            context.frameGraphRegistry.registerContributor(rendererSystem);
            created = true;
        }
    }
    if(!created)
        return MakeUnexpected(Failure());
    return world;
}

void DestroyInitialProjectWorld(mut ProjectRuntimeContext context, mut NotNullUniquePtr<World> worldHandle){
    native(mut context, mut worldHandle){
        UniquePtr<World>& world = worldHandle.owner();
        if(!world)
            return;

        MeshSkinningSystem& meshSkinningSystem = *MakeNotNull(world->getSystem<MeshSkinningSystem>());
        RendererSystem& rendererSystem = *MakeNotNull(world->getSystem<RendererSystem>());
        UiLayerSystem& uiLayerSystem = *MakeNotNull(world->getSystem<UiLayerSystem>());

        context.frameGraphRegistry.unregisterContributor(rendererSystem);
        context.graphics.removeRenderPass(meshSkinningSystem);
        context.graphics.removeRenderPass(rendererSystem);
        context.graphics.removeRenderPass(uiLayerSystem);

        const b8 deviceIdle = context.graphics.waitForIdle();
        NWB_FATAL_ASSERT_MSG(deviceIdle || context.graphics.isDeviceLost(), NWB_TEXT("Project-world destruction requires either a completed device join or terminal device loss"));

        world->clear();
        world.reset();
    }
}

void BindActiveSceneSubsystemsToWorld(mut NotNullUniquePtr<World> world, in ActiveSceneSubsystems sceneSubsystems){
    native(mut world, in sceneSubsystems){
        if(auto* const rendererSystem = world->getSystem<RendererSystem>())
            rendererSystem->setActiveSceneSubsystems(&sceneSubsystems);
        if(auto* const meshSkinningSystem = world->getSystem<MeshSkinningSystem>())
            meshSkinningSystem->setActiveSceneSubsystems(&sceneSubsystems);
        if(auto* const uiLayerSystem = world->getSystem<UiLayerSystem>())
            uiLayerSystem->setActiveSceneSubsystems(&sceneSubsystems);
    }
}

b8 CreateStartupCameraAndLightsOnWorld(mut World world){
    Entity activeCameraEntity = world.createEntity();
    mut ActiveCameraComponent activeCamera = activeCameraEntity.addComponent<ActiveCameraComponent>();
    const f32x4 cameraPosition(0.0f, s_CharacterCameraTargetY, s_CameraStartDepth, 0.0f);
    activeCamera.camera = CreateSceneCameraEntity(world, cameraPosition);
    assert(activeCamera.camera.valid());
    const EntityID cameraEntity = activeCamera.camera;
    native(mut world, in cameraEntity){
        auto& cameraTransform = *MakeNotNull(world.tryGetComponent<TransformComponent>(cameraEntity));
        StoreFloat(QuaternionRotationRollPitchYaw(0.0f, s_PI, 0.0f), cameraTransform.rotation);
    }
    const EntityID directionalLight = CreateDirectionalLightEntity(
        world,
        s_DefaultDirectionalLightPitch,
        s_DefaultDirectionalLightYaw,
        s_DefaultDirectionalLightRoll,
        s_DefaultDirectionalLightColor,
        s_DefaultDirectionalLightIntensity
    );
    const EntityID pointLight = CreatePointLightEntity(
        world,
        s_PointLightPosition,
        s_PointLightColor,
        s_PointLightIntensity,
        s_PointLightRange
    );
    return directionalLight.valid() && pointLight.valid();
}

b8 CreateStartupCameraAndLights(mut NotNullUniquePtr<World> world){
    b8 created = false;
    native(mut world, mut created){
        created = CreateStartupCameraAndLightsOnWorld(*world);
    }
    return created;
}

void SyncWorldModelRuntimes(mut NotNullUniquePtr<World> world){
    native(mut world){
        ModelSystem& modelSystem = *MakeNotNull(world->getSystem<ModelSystem>());
        modelSystem.syncModelRuntimes();
    }
}

b8 TickProjectWorld(mut NotNullUniquePtr<World> world, in f32 safeDelta){
    u32 errorCode = 0u;
    b8 updatedOk = true;
    native(mut world, in safeDelta, mut updatedOk, mut errorCode){
        const auto updated = world->tick(safeDelta);
        if(!updated){
            updatedOk = false;
            errorCode = static_cast<u32>(updated.error());
        }
    }
    if(!updatedOk){
        error("Project: world update rejected CPU work: {}", errorCode);
        return false;
    }
    return true;
}

b8 WantsUiKeyboard(in NotNullUniquePtr<World> world){
    b8 wants = false;
    native(in world, mut wants){
        wants = MakeNotNull(world->getSystem<UiLayerSystem>())->wantsKeyboard();
    }
    return wants;
}

b8 WantsUiPointer(in NotNullUniquePtr<World> world){
    b8 wants = false;
    native(in world, mut wants){
        wants = MakeNotNull(world->getSystem<UiLayerSystem>())->wantsPointer();
    }
    return wants;
}

void ApplyFlyCameraTransform(
    mut TransformComponent transform,
    in VectorSingle moveAxes,
    in b8 boosted,
    in VectorSingle mouseDelta,
    in f32 deltaSeconds
){
    const FlyCameraMotion motion = FlyCameraMotion();
    VectorSingle currentRotation = VectorSingle(0.0f);
    VectorSingle currentPosition = VectorSingle(0.0f);
    native(in transform, mut currentRotation, mut currentPosition){
        currentRotation = LoadFloat(transform.rotation);
        currentPosition = LoadFloat(transform.position);
    }
    const VectorSingle resolvedRotation = motion.resolveStepRotation(currentRotation, mouseDelta);
    const VectorSingle resolvedPosition = motion.resolvePosition(currentPosition, moveAxes, resolvedRotation, deltaSeconds, boosted);
    transform.rotation = f32x4(resolvedRotation);
    transform.position = f32x4(resolvedPosition);
}

void ApplyFlyCameraInputToMainCamera(
    mut NotNullUniquePtr<World> world,
    in VectorSingle moveAxes,
    in b8 boosted,
    in VectorSingle mouseDelta,
    in f32 deltaSeconds
){
    native(mut world, in moveAxes, in boosted, in mouseDelta, in deltaSeconds){
        const SceneCameraView cameraView = ResolveSceneCameraView(*world);
        NWB_ASSERT(cameraView.valid());
        ApplyFlyCameraTransform(*MakeNotNull(cameraView.transform), moveAxes, boosted, mouseDelta, deltaSeconds);
    }
}

b8 InstantiateSceneSubsystemsEntities(in ActiveSceneSubsystems sceneSubsystems, mut NotNullUniquePtr<World> world){
    b8 instantiated = false;
    native(in sceneSubsystems, mut world, mut instantiated){
        instantiated = sceneSubsystems.instantiateEntities(*world);
    }
    return instantiated;
}

void AttachProjectUiPaintEntity<ProjectT>(mut NotNullUniquePtr<World> world, mut ProjectT project){
    native(mut world, mut project){
        auto uiEntity = world->createEntity();
        auto& customUi = uiEntity.addComponent<UiPaintComponent>();
        customUi.paint = [&project](UiPaintContext& context)noexcept{
            project.paintUiLayer(context);
        };
    }
}

native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NotNullUniquePtr<World> Testbed::CreateInitialWorldOrDie(ProjectRuntimeContext& context){
    auto world = CreateInitialProjectWorld(context);
    if(!world){
        NWB_LOGGER_FATAL(NWB_TEXT("ProjectTestbed initialization failed: CreateInitialProjectWorld returned false"));
        throw RuntimeException(s_InitWorldFailedNarrow.data());
    }
    return MakeNotNullUnique(Move(*world));
}


