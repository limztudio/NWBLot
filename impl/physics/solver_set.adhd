    }

    public f32 motorSpeed()const{
        return this.lastTorqueMotorSpeed.w;
    }

    public void setMotorSpeed(in f32 v){
        this.lastTorqueMotorSpeed.w = v;
    }

    public b8 hasFlag(in JointFlags flagBit)const{
        return (cast<u32>(this.flags) & cast<u32>(flagBit)) != 0u;
    }

    public void setFlag(in JointFlags flagBit, in b8 enabled){
        const u32 bit = cast<u32>(flagBit);
        if(enabled)
            this.flags = cast<u8>(cast<u32>(this.flags) | bit);
        else
            this.flags = cast<u8>(cast<u32>(this.flags) & (0xffu ^ bit));
    }

    public b8 enableLimit()const{
        return this.hasFlag(JointFlags::EnableLimit);
    }

    public b8 enableMotor()const{
        return this.hasFlag(JointFlags::EnableMotor);
    }

    public b8 enableSpring()const{
        return this.hasFlag(JointFlags::EnableSpring);
    }

    public b8 collideConnected()const{
        return this.hasFlag(JointFlags::CollideConnected);
    }

    public b8 alive()const{
        return this.hasFlag(JointFlags::Alive);
    }

    public b8 enabled()const{
        return this.hasFlag(JointFlags::Enabled);
    }

    public b8 enableProjection()const{
        return this.hasFlag(JointFlags::EnableProjection);
    }

    public b8 enableTwistLimit()const{
        return this.hasFlag(JointFlags::EnableTwistLimit);
    }
}

