void VerifyUiWidgetIdTests_EmbeddedNulAndScopeConcatenationDoNotAliasAndInvalidKeysAreRejected(){
    const WidgetRoot root = MakeUiContextRoot(7u, 3u);
    const Expected<WidgetId> rootId = TryMakeRootId(root);
    ASSERT_TRUE(rootId.has_value());
    EXPECT_EQ(rootId.value().value, 0x7c2b17581cd0d181u);
    const Expected<WidgetId> partId = TryMakeWidgetPartId(rootId.value(), 0x123456789abcdef0u);
    ASSERT_TRUE(partId.has_value());
    EXPECT_EQ(partId.value().value, 0xb6d51fb9629e37ddu);
    const Expected<WidgetId> embedded = TryMakeWidgetId(rootId.value(), MakeUiWidgetIdEmbeddedNulKey());
    const Expected<WidgetId> simple = TryMakeWidgetId(rootId.value(), "a");
    const Expected<WidgetId> combined = TryMakeWidgetId(rootId.value(), "ab");
    ASSERT_TRUE(embedded.has_value());
    EXPECT_EQ(embedded.value().value, 0xa9602ae44adeb3dfu);
    ASSERT_TRUE(simple.has_value());
    ASSERT_TRUE(combined.has_value());
    EXPECT_NE(embedded.value(), simple.value());
    const Expected<WidgetId> first = TryMakeWidgetId(simple.value(), "bc");
    const Expected<WidgetId> second = TryMakeWidgetId(combined.value(), "c");
    ASSERT_TRUE(first.has_value());
    ASSERT_TRUE(second.has_value());
    EXPECT_NE(first.value(), second.value());
    EXPECT_FALSE(TryMakeRootId(MakeUiContextRoot(7u, 0u)).has_value());
    EXPECT_FALSE(TryMakeWidgetId(WidgetId(), s_UiContextActionKey).has_value());
    EXPECT_FALSE(TryMakeWidgetId(rootId.value(), "").has_value());
}


