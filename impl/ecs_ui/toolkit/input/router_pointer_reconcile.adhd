#include "router_pointer_gestures.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void CancelRouterPointerPress(
    mut Vector<PointerGestureRecord> pointerGestures,
    mut u64 inOutActiveGestureSequence,
    mut b8 outPointerSubmitArmed,
    mut TargetOwner outSecondaryOwner,
    mut WidgetId outCapture,
    mut PopupToken outCapturePopup,
    mut u64 outCaptureDeclaration,
    mut ControlToken outCaptureControl
){
    outPointerSubmitArmed = false;
    outSecondaryOwner = TargetOwner();
    for(usize index = 0u; index < pointerGestures.size(); ++index){
        if(pointerGestures[index].gesture.id.sequence == inOutActiveGestureSequence){
            for(usize moveIndex = index + 1u; moveIndex < pointerGestures.size(); ++moveIndex)
                pointerGestures[moveIndex - 1u] = pointerGestures[moveIndex];
            pointerGestures.pop_back();
            break;
        }
    }
    inOutActiveGestureSequence = 0u;
    outCapture = WidgetId();
    outCapturePopup = PopupToken();
    outCaptureDeclaration = 0u;
    outCaptureControl = ControlToken();
}

Expected<usize> FindRouterHitTargetIndex(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in Point position
){
    if(!IsFinite(position.x) || !IsFinite(position.y))
        return MakeUnexpected(Failure());
    b8 hasFound = false;
    usize foundIndex = 0u;
    HitTarget foundTarget;
    for(usize index = 0u; index < targets.size(); ++index){
        const HitTarget target = targets[index];
        if(!UiRectContainsPoint(target.rectangle, position) || !UiRectContainsPoint(target.clip, position) || !IsRouterTargetInteractive(targets, lookup, popups, target))
            continue;
        if(!hasFound || target.layer > foundTarget.layer || (target.layer == foundTarget.layer && target.paintOrder >= foundTarget.paintOrder)){
            hasFound = true;
            foundIndex = index;
            foundTarget = target;
        }
    }
    if(!hasFound)
        return MakeUnexpected(Failure());
    return foundIndex;
}

b8 TryConsumeRouterActivation(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in WidgetId id,
    mut Vector<InputAction> actions
){
    const Expected<usize> targetIndex = FindTargetIndexInTable(targets, lookup, id, 0u);
    if(!targetIndex.has_value())
        return false;
    const HitTarget target = targets[targetIndex.value()];
    if(!IsRouterTargetInteractive(targets, lookup, popups, target) || !target.activatable)
        return false;
    for(usize index = 0u; index < actions.size(); ++index){
        const InputAction candidate = actions[index];
        if(candidate.id.target == id && candidate.id.declarationGeneration == target.declarationGeneration && candidate.popup == target.popup && candidate.control == target.control){
            for(usize moveIndex = index + 1u; moveIndex < actions.size(); ++moveIndex)
                actions[moveIndex - 1u] = actions[moveIndex];
            actions.pop_back();
            return true;
        }
    }
    return false;
}

Expected<ContextMenuAction> TryConsumeRouterContextMenu(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in b8 windowFocused,
    in WidgetId id,
    in u64 declarationGeneration,
    mut Vector<ContextMenuAction> contextMenuActions
){
    const Expected<usize> targetIndex = FindTargetIndexInTable(targets, lookup, id, declarationGeneration);
    if(declarationGeneration == 0u || !windowFocused || !targetIndex.has_value())
        return MakeUnexpected(Failure());
    const HitTarget target = targets[targetIndex.value()];
    if(!target.contextMenu || !IsRouterTargetInteractive(targets, lookup, popups, target))
        return MakeUnexpected(Failure());
    for(usize index = 0u; index < contextMenuActions.size(); ++index){
        const ContextMenuAction candidate = contextMenuActions[index];
        if(candidate.id.target != id || candidate.id.declarationGeneration != declarationGeneration || candidate.popup != target.popup || candidate.control != target.control)
            continue;
        for(usize moveIndex = index + 1u; moveIndex < contextMenuActions.size(); ++moveIndex)
            contextMenuActions[moveIndex - 1u] = contextMenuActions[moveIndex];
        contextMenuActions.pop_back();
        return candidate;
    }
    return MakeUnexpected(Failure());
}

Expected<PointerGesture> TryConsumeRouterPointerGesture(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in WidgetId id,
    in u64 declarationGeneration,
    mut Vector<PointerGestureRecord> pointerGestures
){
    const Expected<usize> targetIndex = FindTargetIndexInTable(targets, lookup, id, declarationGeneration);
    if(declarationGeneration == 0u || !targetIndex.has_value())
        return MakeUnexpected(Failure());
    const HitTarget target = targets[targetIndex.value()];
    if(!IsRouterTargetInteractive(targets, lookup, popups, target) || !target.pointerGesture)
        return MakeUnexpected(Failure());
    for(usize index = 0u; index < pointerGestures.size(); ++index){
        PointerGestureRecord record = pointerGestures[index];
        if(record.gesture.id.target != id || record.gesture.id.declarationGeneration != declarationGeneration || !record.pendingUpdate || record.gesture.popup != target.popup || record.gesture.control != target.control)
            continue;
        const PointerGesture gesture = record.gesture;
        if(record.gesture.state == PointerGestureState::Completed){
            for(usize moveIndex = index + 1u; moveIndex < pointerGestures.size(); ++moveIndex)
                pointerGestures[moveIndex - 1u] = pointerGestures[moveIndex];
            pointerGestures.pop_back();
        }
        else{
            record.pendingUpdate = false;
            pointerGestures[index] = record;
        }
        return gesture;
    }
    return MakeUnexpected(Failure());
}

void ReconcileRouterPointerGestures(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    mut Vector<PointerGestureRecord> pointerGestures,
    mut u64 inOutActiveGestureSequence
){
    usize keptGestures = 0u;
    for(usize index = 0u; index < pointerGestures.size(); ++index){
        const PointerGesture gesture = pointerGestures[index].gesture;
        const Expected<usize> targetIndex = FindTargetIndexInTable(targets, lookup, gesture.id.target, gesture.id.declarationGeneration);
        b8 valid = false;
        if(targetIndex.has_value()){
            const HitTarget target = targets[targetIndex.value()];
            valid = IsRouterTargetInteractive(targets, lookup, popups, target)
                && target.pointerGesture
                && gesture.popup == target.popup
                && gesture.control == target.control;
        }
        if(!valid){
            if(gesture.id.sequence == inOutActiveGestureSequence)
                inOutActiveGestureSequence = 0u;
        }
        else{
            if(keptGestures != index)
                pointerGestures[keptGestures] = pointerGestures[index];
            ++keptGestures;
        }
    }
    pointerGestures.resize(keptGestures);
}

void ReconcileRouterContextMenus(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in b8 windowFocused,
    mut Vector<ContextMenuAction> contextMenuActions,
    mut TargetOwner inOutSecondaryOwner,
    mut Vector<CommandSource> commandSources
){
    usize keptMenus = 0u;
    for(usize index = 0u; index < contextMenuActions.size(); ++index){
        const ContextMenuAction action = contextMenuActions[index];
        const TargetOwner owner(action.id.target, action.id.declarationGeneration, action.popup, action.control);
        if(IsCurrentRouterContextMenuOwner(targets, lookup, popups, windowFocused, owner)){
            if(keptMenus != index)
                contextMenuActions[keptMenus] = action;
            ++keptMenus;
        }
    }
    contextMenuActions.resize(keptMenus);
    if(!IsCurrentRouterContextMenuOwner(targets, lookup, popups, windowFocused, inOutSecondaryOwner))
        inOutSecondaryOwner = TargetOwner();
    for(usize index = 0u; index < commandSources.size(); ++index){
        CommandSource source = commandSources[index];
        if(source.contextArmed && !IsCurrentRouterContextMenuOwner(targets, lookup, popups, windowFocused, source.focusOwner)){
            source.contextArmed = false;
            commandSources[index] = source;
        }
    }
}


