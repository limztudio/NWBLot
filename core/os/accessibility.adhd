[cpp_header("<core/os/accessibility.h>"), cpp_name("::NWB::Core::AccessibilityBackend::Enum")]
extern enum AccessibilityBackend : u8{
    Unsupported,
    Win32Uia,
    LinuxAtSpi
};

[cpp_header("<core/os/accessibility.h>"), cpp_name("::NWB::Core::AccessibilityRole::Enum")]
extern enum AccessibilityRole : u8{
    None,
    Window,
    Dialog,
    Panel,
    Group,
    Region,
    Text,
    Heading,
    Button,
    ToggleButton,
    CheckBox,
    RadioGroup,
    RadioButton,
    TextField,
    TextArea,
    Slider,
    SpinButton,
    ProgressBar,
    ComboBox,
    List,
    ListItem,
    Tree,
    TreeItem,
    Table,
    TableHeader,
    TableRow,
    TabList,
    Tab,
    MenuBar,
    Menu,
    MenuItem,
    ScrollBar,
    Splitter,
    Link,
    Image,
    Canvas,
    Tooltip,
    Alert,
    Status,
    Toolbar,
    ColorPicker,
    DockSpace,
    kCount
};

[cpp_header("<core/os/accessibility.h>"), cpp_name("::NWB::Core::AccessibilityLiveMode::Enum")]
extern enum AccessibilityLiveMode : u8{
    Off,
    Polite,
    Assertive
};

[cpp_header("<core/os/accessibility.h>"), cpp_name("::NWB::Core::AccessibilityActionKind::Enum")]
extern enum AccessibilityActionKind : u8{
    Invoke,
    Toggle,
    Select,
    Focus,
    Expand,
    Collapse,
    Increment,
    Decrement,
    SetValue,
    ContextMenu
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<core/os/accessibility.h>"), cpp_name("::NWB::Core::AccessibilityCapabilities"), cpp_flags(self_defaulted, small_value, binary_serializable, brace_init)]
extern class AccessibilityCapabilities{
    b8 tree;
    b8 announcements;
    b8 actions;
    AccessibilityBackend backend;
};

[cpp_header("<core/os/accessibility.h>"), cpp_name("::NWB::Core::AccessibilityNodeData"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class AccessibilityNodeData{
    u64 id;
    u64 parentId;
    AccessibilityRole role;
    AccessibilityLiveMode liveMode;
    u32 stateBits;
    u32 actionBits;
    f32 x;
    f32 y;
    f32 width;
    f32 height;
    u32 nameOffset;
    u32 nameLength;
    u32 descriptionOffset;
    u32 descriptionLength;
    u32 valueOffset;
    u32 valueLength;
    f64 numericValue;
    f64 numericMin;
    f64 numericMax;
    f64 numericStep;
    i32 positionInSet;
    i32 setSize;
    i32 level;
};

[cpp_header("<core/os/accessibility.h>"), cpp_name("::NWB::Core::AccessibilityActionEvent"), cpp_flags(self_defaulted, small_value, binary_serializable, brace_init)]
extern class AccessibilityActionEvent{
    u64 targetId;
    AccessibilityActionKind kind;
    f64 numericValue;
};

[cpp_header("<core/os/accessibility.h>"), cpp_name("::NWB::Core::IAccessibilityService"), cpp_flags(no_copy, no_assign, abstract, polymorphic_base)]
extern class IAccessibilityService{
    AccessibilityCapabilities capabilities()const;
    b8 isOwnerThread()const;
    [cpp_flags(unwind)] b8 publishTree(in Span<AccessibilityNodeData> nodes, in StringView textStorage, in u64 focusedId, in u64 version, in f32 scaleX, in f32 scaleY);
    [cpp_flags(unwind)] b8 updateFocus(in u64 focusedId);
    [cpp_flags(unwind)] b8 announce(in StringView text, in AccessibilityLiveMode politeness);
    b8 pollAction(mut AccessibilityActionEvent outEvent);
    u64 publishedVersion()const;
    usize publishedNodeCount()const;
    u64 publishedFocusedId()const;
    usize announcementCount()const;
};


