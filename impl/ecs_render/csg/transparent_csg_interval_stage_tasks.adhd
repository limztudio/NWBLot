#include <impl/ecs_render/csg/cutter_gpu_data.adhd>
#include <impl/ecs_render/kernel/task_graph_scheduling.adhd>
#include <impl/ecs_render/material/material_typed_private.adhd>
#include <impl/ecs_render/csg/frame_graph_transparent_csg_tasks.adhd>
#include <impl/ecs_render/csg/transparent_csg_interval_builder.adhd>
#include <impl/ecs_render/csg/opaque_csg_interval_clear_builder.adhd>
#include <impl/ecs_render/csg/types.adhd>
#include <impl/ecs_render/kernel/task_graph_resource_utils.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>
#include <impl/ecs_render/material/task_graph_resource_sets.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 HasTransparentCsgPassCandidateWork(in b8 hasTransparentRenderers, in CsgFrameState csgFrameState){
    return hasTransparentRenderers && CsgFrameHasReceiverPassWork(csgFrameState, CsgReceiverPass::Transparent);
}

b8 HasValidTransparentCsgUploadElementCounts(
    in usize instanceCount,
    in usize instanceByteSize,
    in usize receiverRangeCount,
    in usize receiverRangeByteSize,
    in usize cutterCount,
    in usize cutterByteSize
){
    assert(instanceByteSize != 0u && receiverRangeByteSize != 0u && cutterByteSize != 0u);
    return instanceCount <= usize.max / instanceByteSize
        && receiverRangeCount <= usize.max / receiverRangeByteSize
        && cutterCount <= usize.max / cutterByteSize
    ;
}

b8 IsAvboitCsgReceiverSpanGraphOwned(
    in b8 streamsUploaded,
    in b8 preCaptured,
    in b8 receiverSpanCaptured,
    in b8 receiverSpanUploaded
){
    return streamsUploaded && preCaptured && receiverSpanCaptured && receiverSpanUploaded;
}

b8 IsAvboitCsgIntervalCombineGraphOwned(
    in b8 receiverSpanGraphOwned,
    in b8 intervalCombineCaptured,
    in b8 intervalCombineUploaded
){
    return receiverSpanGraphOwned && intervalCombineCaptured && intervalCombineUploaded;
}

Expected<FrameGraphTransparentCsgTaskResult> FrameGraphTransparentCsgTasks::declare(
    in FrameGraphTransparentCsgTaskInputs inputs,
    mut ObjectGeometryCacheGraph objectGeometry,
    mut AvboitPreGraphTaskPayload prePayload,
    mut TransparentCsgIntervalRecordInputs receiverSpanPayload,
    mut TransparentCsgIntervalRecordInputs intervalCombinePayload
){
    FrameGraphTransparentCsgTaskResult result;


    GpuTaskId intervalDependency = inputs.producer.uploadTask;

    const BufferRange transparentCsgInstanceRange(0u, prePayload.transparentCsgSnapshot.instanceCount * size_of<InstanceGpuData>());
    const BufferRange transparentCsgMaterialTypedRange(0u, prePayload.transparentCsgSnapshot.materialTypedByteCount);
    const BufferRange transparentCsgReceiverRange(0u, prePayload.transparentCsgSnapshot.frameData.receiverRanges.size() * size_of<CsgReceiverRangeGpuData>());
    const BufferRange transparentCsgCutterRange(0u, prePayload.transparentCsgSnapshot.frameData.cutters.size() * size_of<CsgCutterGpuData>());

    Vector<GpuTaskResourceUse> avboitIntervalResourceUses;
    avboitIntervalResourceUses.reserve(s_TransparentCsgIntervalResourceUseCapacity);
    if(prePayload.transparentCsgStreamsUploaded){
        avboitIntervalResourceUses.push_back(ReadUse(inputs.resources.albedo, ResourceStates::RenderTarget));
        avboitIntervalResourceUses.push_back(ReadUse(inputs.resources.normal, ResourceStates::RenderTarget));
        avboitIntervalResourceUses.push_back(ReadUse(inputs.resources.worldPosition, ResourceStates::RenderTarget));
        avboitIntervalResourceUses.push_back(ReadUse(inputs.resources.specularRoughness, ResourceStates::RenderTarget));
        avboitIntervalResourceUses.push_back(ReadUse(inputs.resources.depth, ResourceStates::DepthWrite));
        avboitIntervalResourceUses.push_back(ReadUse(inputs.resources.meshView, ResourceStates::ConstantBuffer));
        avboitIntervalResourceUses.push_back(ReadBufferUse(inputs.resources.materialInstances, transparentCsgInstanceRange));
        avboitIntervalResourceUses.push_back(ReadBufferUse(inputs.resources.materialTyped, transparentCsgMaterialTypedRange));
        avboitIntervalResourceUses.push_back(ReadBufferUse(inputs.resources.csgReceiverRanges, transparentCsgReceiverRange));
        avboitIntervalResourceUses.push_back(ReadBufferUse(inputs.resources.csgCutters, transparentCsgCutterRange));
        avboitIntervalResourceUses.push_back(ReadUse(inputs.resources.csgClipContextSlots, ResourceStates::ConstantBuffer));
        avboitIntervalResourceUses.push_back(ReadUse(inputs.resources.csgIntervalSampleState, ResourceStates::ConstantBuffer));
        avboitIntervalResourceUses.push_back(WriteTextureUse(inputs.resources.csgCapBackNormal, inputs.resources.csgPeelSubresources, ResourceStates::UnorderedAccess));
        avboitIntervalResourceUses.push_back(WriteTextureUse(inputs.resources.csgIntervalDepth, inputs.resources.csgPeelSubresources, ResourceStates::UnorderedAccess));
        avboitIntervalResourceUses.push_back(ReadWriteTextureUse(inputs.resources.csgIntervalId, inputs.resources.csgPeelSubresources, ResourceStates::UnorderedAccess));
        avboitIntervalResourceUses.push_back(WriteTextureUse(inputs.resources.csgReceiverEventData, inputs.resources.csgReceiverEventDataSubresources, ResourceStates::UnorderedAccess));
        avboitIntervalResourceUses.push_back(ReadWriteTextureUse(inputs.resources.csgReceiverEventCount, inputs.resources.csgReceiverEventCountSubresources, ResourceStates::UnorderedAccess));
    }
    FixedVector<GpuTaskResourceSetUse, s_TransparentCsgMaterialResourceSetUseCapacity> sets;
    if(prePayload.transparentCsgMaterialGeometryStatesGraphOwned)
        sets.push_back(MakeResourceSetUse(inputs.producer.materialGeometrySet, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read));
    if(inputs.producer.materialSampledTextureSet.valid())
        sets.push_back(MakeResourceSetUse(inputs.producer.materialSampledTextureSet, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read));
    avboitIntervalResourceUses.push_back(ReadUse(inputs.resources.currentBindlessSlots, ResourceStates::ConstantBuffer));
    avboitIntervalResourceUses.push_back(ReadUse(inputs.resources.avboitMaterialDomain));
    avboitIntervalResourceUses.push_back(ReadWriteUse(inputs.resources.avboitCsgDomain, ResourceStates::ShaderResource));

    if(prePayload.transparentCsgStreamsUploaded && !objectGeometry.prepare(
        prePayload.transparentCsgSnapshot.receiverSurfaceDrawItemsView().indexedDrawItems,
        prePayload.frameBindings, intervalDependency, avboitIntervalResourceUses,
        inputs.timingTicket, Optional<in GraphicsPrefixTimingTicket>()
    ))
        return MakeUnexpected(Failure());

    GpuTaskSchedulingHint avboitIntervalScheduling;
    avboitIntervalScheduling.cost = GpuTaskCostHint::Large;
    avboitIntervalScheduling.forceSubmissionBoundary = false;
    avboitIntervalScheduling.allowPacketMerge = true;
    avboitIntervalScheduling.mergeWithPrevious = prePayload.transparentCsgStreamsUploaded;
    GpuTaskDesc avboitIntervalDesc;
    avboitIntervalDesc
        .setIdentity(Name(s_RenderNameRenderAvboitIntervals))
        .setMarkerLabel(s_TransparentCsgIntervalsLabel)
        .setScheduling(avboitIntervalScheduling)
        .setDependency(intervalDependency)
        .setResourceUses(avboitIntervalResourceUses)
        .setResourceSetUses(sets)
    ;
    const b8 avboitCsgReceiverSpanGraphOwned = IsAvboitCsgReceiverSpanGraphOwned(
        prePayload.transparentCsgStreamsUploaded,
        prePayload.transparentCsgSnapshot.captured,
        receiverSpanPayload.transparentCsgSnapshot.captured,
        receiverSpanPayload.csgFrameBuffersUploaded
    );
    const b8 avboitCsgIntervalCombineGraphOwned = IsAvboitCsgIntervalCombineGraphOwned(
        avboitCsgReceiverSpanGraphOwned,
        intervalCombinePayload.transparentCsgSnapshot.captured,
        intervalCombinePayload.csgFrameBuffersUploaded
    );
    const auto preTaskResult = this.m_graph.addPreparedPayloadTask(avboitIntervalDesc, prePayload);
    if(!preTaskResult.has_value()){
        this.m_avboitSystem.taskGraphStage().m_preTask = GpuTaskId();
        warning("RendererSystem: could not declare transparent CSG interval graph task");
        return MakeUnexpected(Failure());
    }
    this.m_avboitSystem.taskGraphStage().m_preTask = preTaskResult.value();

    GpuTaskId avboitIntervalCompletionTask = this.m_avboitSystem.taskGraphStage().m_preTask;
    b8 avboitIntervalOutputsGraphOwned = false;
    if(avboitCsgReceiverSpanGraphOwned){
        const Array<GpuTaskResourceUse, 6u> avboitIntervalSpanResourceUses = Array<GpuTaskResourceUse, 6u>(
            ReadTextureUse(inputs.resources.csgReceiverEventData, inputs.resources.csgReceiverEventDataSubresources, ResourceStates::UnorderedAccess),
            ReadTextureUse(inputs.resources.csgReceiverEventCount, inputs.resources.csgReceiverEventCountSubresources, ResourceStates::UnorderedAccess),
            ReadUse(inputs.resources.csgClipContextSlots, ResourceStates::ConstantBuffer),
            ReadUse(inputs.resources.currentBindlessSlots, ResourceStates::ConstantBuffer),
            WriteTextureUse(inputs.resources.csgReceiverSpanData, inputs.resources.csgReceiverSpanDataSubresources, ResourceStates::UnorderedAccess),
            WriteTextureUse(inputs.resources.csgReceiverSpanCount, inputs.resources.csgReceiverSpanCountSubresources, ResourceStates::UnorderedAccess)
        );
        GpuTaskSchedulingHint avboitIntervalSpanScheduling;
        avboitIntervalSpanScheduling.cost = GpuTaskCostHint::Medium;
        avboitIntervalSpanScheduling.forceSubmissionBoundary = false;
        avboitIntervalSpanScheduling.allowPacketMerge = true;
        avboitIntervalSpanScheduling.mergeWithPrevious = true;
        GpuTaskDesc avboitIntervalSpanDesc;
        avboitIntervalSpanDesc
            .setIdentity(Name(s_RenderNameRenderAvboitTransparentCsgReceiverSpan))
            .setMarkerLabel("Transparent CSG Receiver Span")
            .setScheduling(avboitIntervalSpanScheduling)
            .setDependency(this.m_avboitSystem.taskGraphStage().m_preTask)
            .setResourceUses(avboitIntervalSpanResourceUses)
        ;
        const auto csgReceiverSpanTaskResult = this.m_graph.addPreparedPayloadTask(avboitIntervalSpanDesc, receiverSpanPayload);
        if(!csgReceiverSpanTaskResult.has_value()){
            this.m_avboitSystem.taskGraphStage().m_csgReceiverSpanTask = GpuTaskId();
            warning("RendererSystem: could not declare transparent CSG receiver-span graph task");
            return MakeUnexpected(Failure());
        }
        this.m_avboitSystem.taskGraphStage().m_csgReceiverSpanTask = csgReceiverSpanTaskResult.value();
        avboitIntervalCompletionTask = this.m_avboitSystem.taskGraphStage().m_csgReceiverSpanTask;
    }
    if(avboitCsgIntervalCombineGraphOwned){
        const Array<GpuTaskResourceUse, 11u> avboitIntervalCombineResourceUses = Array<GpuTaskResourceUse, 11u>(
            ReadTextureUse(inputs.resources.csgCapBackNormal, inputs.resources.csgPeelSubresources, ResourceStates::UnorderedAccess),
            ReadTextureUse(inputs.resources.csgIntervalDepth, inputs.resources.csgPeelSubresources, ResourceStates::UnorderedAccess),
            ReadTextureUse(inputs.resources.csgIntervalId, inputs.resources.csgPeelSubresources, ResourceStates::UnorderedAccess),
            ReadTextureUse(inputs.resources.csgReceiverSpanData, inputs.resources.csgReceiverSpanDataSubresources, ResourceStates::UnorderedAccess),
            ReadTextureUse(inputs.resources.csgReceiverSpanCount, inputs.resources.csgReceiverSpanCountSubresources, ResourceStates::UnorderedAccess),
            ReadUse(inputs.resources.csgClipContextSlots, ResourceStates::ConstantBuffer),
            ReadUse(inputs.resources.currentBindlessSlots, ResourceStates::ConstantBuffer),
            WriteTextureUse(inputs.resources.csgRemovedIntervalDepth, inputs.resources.csgRemovedIntervalSubresources, ResourceStates::UnorderedAccess),
            WriteTextureUse(inputs.resources.csgRemovedIntervalCapNormal, inputs.resources.csgRemovedIntervalSubresources, ResourceStates::UnorderedAccess),
            WriteTextureUse(inputs.resources.csgRemovedIntervalData, inputs.resources.csgRemovedIntervalSubresources, ResourceStates::UnorderedAccess),
            WriteTextureUse(inputs.resources.csgRemovedIntervalCount, inputs.resources.csgRemovedIntervalCountSubresources, ResourceStates::UnorderedAccess)
        );
        GpuTaskSchedulingHint avboitIntervalCombineScheduling;
        avboitIntervalCombineScheduling.cost = GpuTaskCostHint::Medium;
        avboitIntervalCombineScheduling.forceSubmissionBoundary = false;
        avboitIntervalCombineScheduling.allowPacketMerge = true;
        avboitIntervalCombineScheduling.mergeWithPrevious = true;
        GpuTaskDesc avboitIntervalCombineDesc;
        avboitIntervalCombineDesc
            .setIdentity(Name(s_RenderNameRenderAvboitTransparentCsgIntervalCombine))
            .setMarkerLabel("Transparent CSG Interval Combine")
            .setScheduling(avboitIntervalCombineScheduling)
            .setDependency(avboitIntervalCompletionTask)
            .setResourceUses(avboitIntervalCombineResourceUses)
        ;
        const auto csgIntervalCombineTaskResult = this.m_graph.addPreparedPayloadTask(avboitIntervalCombineDesc, intervalCombinePayload);
        if(!csgIntervalCombineTaskResult.has_value()){
            this.m_avboitSystem.taskGraphStage().m_csgIntervalCombineTask = GpuTaskId();
            warning("RendererSystem: could not declare transparent CSG interval-combine graph task");
            return MakeUnexpected(Failure());
        }
        this.m_avboitSystem.taskGraphStage().m_csgIntervalCombineTask = csgIntervalCombineTaskResult.value();
        avboitIntervalCompletionTask = this.m_avboitSystem.taskGraphStage().m_csgIntervalCombineTask;
        avboitIntervalOutputsGraphOwned = true;
    }
    result.intervalCompletionTask = avboitIntervalCompletionTask;
    result.intervalOutputsGraphOwned = avboitIntervalOutputsGraphOwned;
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<TransparentCsgIntervalProducerResult> TransparentCsgIntervalBuilder::declare(
    in TransparentCsgIntervalProducerInputs inputs,
    mut AvboitPreGraphTaskPayload avboitPrePayload,
    mut TransparentCsgIntervalRecordInputs receiverSpanPayload,
    mut TransparentCsgIntervalRecordInputs intervalCombinePayload,
    mut GraphClearTimingRecordState intervalClearTimingState
){

    TransparentCsgIntervalProducerResult result;
    if(!inputs.prefixTask.valid())
        return MakeUnexpected(Failure());

    result.uploadTask = inputs.prefixTask;
    GpuGraphResourceSetId transparentCsgMaterialGeometrySet = GpuGraphResourceSetId();
    GpuGraphResourceSetId transparentCsgMaterialSampledTextureSet = GpuGraphResourceSetId();
    const b8 hasTransparentCsgFrameWork = HasTransparentCsgPassCandidateWork(inputs.hasTransparentRenderers, inputs.csgFrameState);
    if(hasTransparentCsgFrameWork){
        MaterialPassDrawItemPartitions transparentCsgDrawItems;
        InstanceGpuDataVector transparentCsgInstanceData;
        CsgFrameGpuData transparentCsgFrameData;
        MaterialTypedInstanceRangeVector transparentCsgMaterialTypedRanges;
        MaterialTypedByteDataVector transparentCsgMaterialTypedBytes;
        FramebufferHandle framebuffer = inputs.targets.framebuffer;
        this.m_materialSystem.gatherMaterialPassDrawItems(
            framebuffer,
            MaterialPipelinePass::CsgReceiverSurface,
            true,
            inputs.csgFrameState,
            RendererResourceLookupMode::PreparedOnly,
            Optional<in MeshViewGpuData>(inputs.meshViewState),
            transparentCsgDrawItems,
            transparentCsgInstanceData,
            transparentCsgFrameData,
            transparentCsgMaterialTypedRanges,
            transparentCsgMaterialTypedBytes
        );

        if(!transparentCsgDrawItems.csgReceiverSurface.empty() && transparentCsgFrameData.hasWork()){
            const CsgFrameGpuDataView frame = CsgFrameGpuDataView(transparentCsgFrameData);
            if(
                !inputs.resources.materialInstances.valid()
                || !inputs.resources.materialTyped.valid()
                || !inputs.resources.csgReceiverRanges.valid()
                || !inputs.resources.csgCutters.valid()
                || !inputs.resources.csgClipContextSlots.valid()
                || !inputs.resources.csgIntervalSampleState.valid()
                || !inputs.frameBindings.frameReady(transparentCsgInstanceData.size(), transparentCsgMaterialTypedBytes.size())
                || !inputs.csgResources.frameReady(frame)
                || !this.m_materialSystem.drawRecorder().materialPassDrawResourcesReady(MaterialPassDrawItemsView(transparentCsgDrawItems.csgReceiverSurface), inputs.frameBindings)
            ){
                warning("RendererSystem: prepared transparent CSG interval resources were unavailable during graph declaration");
                return MakeUnexpected(Failure());
            }

            const MaterialPassDrawItemsView receiverDraws = MaterialPassDrawItemsView(transparentCsgDrawItems.csgReceiverSurface);
            const Array<MaterialPassDrawItemsView, 1u> transparentCsgMaterialGeometryDrawSets(receiverDraws);
            const auto geometrySetResult = GatherPreparedMaterialGeometryResourceSet(transparentCsgMaterialGeometryDrawSets, Name(s_RenderNameRenderAvboitIntervalsTransparentCsgMaterialGeometry), "Transparent CSG Material Geometry", this.m_graph);
            avboitPrePayload.transparentCsgMaterialGeometryStatesGraphOwned = geometrySetResult.has_value();
            if(!geometrySetResult.has_value()){
                warning("RendererSystem: could not declare prepared transparent CSG material geometry states");
                return MakeUnexpected(Failure());
            }
            transparentCsgMaterialGeometrySet = geometrySetResult.value();
            const auto sampledTextureSetResult = GatherPreparedMaterialSampledTextureResourceSet(
                this.m_materialSystem,
                transparentCsgMaterialGeometryDrawSets,
                Name(s_RenderNameRenderAvboitIntervalsTransparentCsgMaterialSampledTextures),
                "Transparent CSG Material Sampled Textures",
                this.m_graph
            );
            if(!sampledTextureSetResult.has_value()){
                warning("RendererSystem: could not declare prepared transparent CSG material sampled textures");
                return MakeUnexpected(Failure());
            }
            transparentCsgMaterialSampledTextureSet = sampledTextureSetResult.value();

            this.m_materialSystem.prepareMaterialPassInstanceUploadData(inputs.csgResources, transparentCsgInstanceData);
            if(s_RuntimeAssertionsEnabled){
                if(!HasValidTransparentCsgUploadElementCounts(
                    transparentCsgInstanceData.size(),
                    size_of<InstanceGpuData>(),
                    transparentCsgFrameData.receiverRanges.size(),
                    size_of<CsgReceiverRangeGpuData>(),
                    transparentCsgFrameData.cutters.size(),
                    size_of<CsgCutterGpuData>()
                )){
                    warning("RendererSystem: transparent CSG interval upload size overflows graph blob capacity");
                    return MakeUnexpected(Failure());
            }
            assert(transparentCsgInstanceData.size() == transparentCsgMaterialTypedRanges.size());
            ValidateMaterialTypedUploadRanges(transparentCsgMaterialTypedRanges, transparentCsgMaterialTypedBytes);
            }

            const auto clipContextSlotResult = this.m_csgSystem.prepareCsgClipContextSlotData(inputs.targets, frame, inputs.csgResources, inputs.frameBindings);
            if(!clipContextSlotResult.has_value()){
                warning("RendererSystem: could not snapshot transparent CSG interval auxiliary upload data");
                return MakeUnexpected(Failure());
            }
            const auto intervalSampleStateResult = this.m_csgSystem.prepareCsgIntervalSampleStateData(inputs.targets, frame, inputs.csgResources, inputs.frameBindings);
            if(!intervalSampleStateResult.has_value()){
                warning("RendererSystem: could not snapshot transparent CSG interval auxiliary upload data");
                return MakeUnexpected(Failure());
            }
            in CsgClipContextSlots transparentCsgClipContextSlotData = clipContextSlotResult.value();
            in CsgIntervalSampleStateGpuData transparentCsgIntervalSampleStateData = intervalSampleStateResult.value();

            const Span<InstanceGpuData> instanceValues = transparentCsgInstanceData;
            const auto instances = this.m_graph.copyUploadElements<InstanceGpuData>(instanceValues);
            const auto material = this.m_graph.copyUploadBytes<u32>(transparentCsgMaterialTypedBytes);
            const auto receivers = this.m_graph.copyUploadElements<CsgReceiverRangeGpuData>(frame.receiverRanges);
            const auto cutters = this.m_graph.copyUploadElements<CsgCutterGpuData>(frame.cutters);
            const auto slots = this.m_graph.copyUploadValue(transparentCsgClipContextSlotData);
            const auto interval = this.m_graph.copyUploadValue(transparentCsgIntervalSampleStateData);
            if(!instances.has_value() || !material.has_value() || !receivers.has_value() || !cutters.has_value() || !slots.has_value() || !interval.has_value()){
                warning("RendererSystem: could not retain immutable transparent CSG interval upload data");
                return MakeUnexpected(Failure());
            }
            if(!AppendImmutableBufferUpload(this.m_graph, instances.value(), inputs.resources.materialInstances,
                s_RenderNameRenderAvboitTransparentCsgMaterialInstancesUpload, "Transparent CSG Material Instances Upload", result.uploadTask, false)){
                warning("RendererSystem: could not declare transparent CSG material instance upload");
                return MakeUnexpected(Failure());
            }
            if(!AppendImmutableBufferUpload(this.m_graph, material.value(), inputs.resources.materialTyped,
                s_RenderNameRenderAvboitTransparentCsgMaterialTypedUpload, "Transparent CSG Material Typed Upload", result.uploadTask, true)){
                warning("RendererSystem: could not declare transparent CSG material typed upload");
                return MakeUnexpected(Failure());
            }
            if(!AppendImmutableBufferUpload(this.m_graph, receivers.value(), inputs.resources.csgReceiverRanges,
                s_RenderNameRenderAvboitTransparentCsgReceiverRangesUpload, "Transparent CSG Receiver Ranges Upload", result.uploadTask, true)){
                warning("RendererSystem: could not declare transparent CSG receiver-range upload");
                return MakeUnexpected(Failure());
            }
            if(!AppendImmutableBufferUpload(this.m_graph, cutters.value(), inputs.resources.csgCutters,
                s_RenderNameRenderAvboitTransparentCsgCuttersUpload, "Transparent CSG Cutters Upload", result.uploadTask, true)){
                warning("RendererSystem: could not declare transparent CSG cutter upload");
                return MakeUnexpected(Failure());
            }
            if(!AppendImmutableBufferUpload(this.m_graph, slots.value(), inputs.resources.csgClipContextSlots,
                s_RenderNameRenderAvboitTransparentCsgClipContextSlotsUpload, "Transparent CSG Clip Context Slots Upload", result.uploadTask, true)){
                warning("RendererSystem: could not declare transparent CSG clip-context upload");
                return MakeUnexpected(Failure());
            }
            if(!AppendImmutableBufferUpload(this.m_graph, interval.value(), inputs.resources.csgIntervalSampleState,
                s_RenderNameRenderAvboitTransparentCsgIntervalSampleStateUpload, "Transparent CSG Interval State Upload", result.uploadTask, true)){
                warning("RendererSystem: could not declare transparent CSG interval-state upload");
                return MakeUnexpected(Failure());
            }

            const b8 hasReceiverDraws = !receiverDraws.empty();
            const b8 receiverDrawsReady = this.m_materialSystem.drawRecorder().materialPassDrawResourcesReady(receiverDraws, inputs.frameBindings);
            avboitPrePayload.transparentCsgSnapshot.capture(receiverDraws, frame, transparentCsgInstanceData.size(), transparentCsgMaterialTypedBytes.size());
            receiverSpanPayload.transparentCsgSnapshot.capture(frame, transparentCsgInstanceData.size(), transparentCsgMaterialTypedBytes.size(), hasReceiverDraws, receiverDrawsReady);
            receiverSpanPayload.csgFrameBuffersUploaded = true;
            intervalCombinePayload.transparentCsgSnapshot.capture(frame, transparentCsgInstanceData.size(), transparentCsgMaterialTypedBytes.size(), hasReceiverDraws, receiverDrawsReady);
            if(!avboitPrePayload.transparentCsgSnapshot.captured || !receiverSpanPayload.transparentCsgSnapshot.captured || !intervalCombinePayload.transparentCsgSnapshot.captured){
                warning("RendererSystem: could not capture transparent CSG interval graph snapshots");
                return MakeUnexpected(Failure());
            }
            intervalCombinePayload.csgFrameBuffersUploaded = true;
            avboitPrePayload.transparentCsgStreamsUploaded = true;
        }
    }

    if(avboitPrePayload.transparentCsgStreamsUploaded){
        CsgIntervalRectClearDesc clearDesc;
        clearDesc.intervalClearIdentity = Name(s_RenderNameRenderAvboitTransparentCsgIntervalClear);
        clearDesc.intervalClearMarkerLabel = "Transparent CSG Interval Id Clear";
        clearDesc.intervalClearWarningMessage = "RendererSystem: could not declare graph-owned transparent CSG interval-id clear";
        clearDesc.receiverEventClearIdentity = Name(s_RenderNameRenderAvboitTransparentCsgReceiverEventCountClear);
        clearDesc.receiverEventClearMarkerLabel = "Transparent CSG Receiver Event Count Clear";
        clearDesc.receiverEventClearWarningMessage = "RendererSystem: could not declare graph-owned transparent CSG receiver-event clear";
        clearDesc.csgIntervalId = inputs.resources.csgIntervalId;
        clearDesc.csgReceiverEventCount = inputs.resources.csgReceiverEventCount;
        clearDesc.csgPeelSubresources = inputs.resources.csgPeelSubresources;
        clearDesc.csgReceiverEventCountSubresources = inputs.resources.csgReceiverEventCountSubresources;
        clearDesc.clearRect = ToCoreRect(avboitPrePayload.transparentCsgSnapshot.frameData.workRegion.resolveRect(inputs.targets.width, inputs.targets.height));
        clearDesc.dependencyTask = result.uploadTask;
        if(!DeclareCsgIntervalRectClearTasks(
            clearDesc,
            this.m_graph,
            intervalClearTimingState,
            this.m_avboitSystem.taskGraphStage().m_transparentCsgIntervalClearFirstTask,
            this.m_avboitSystem.taskGraphStage().m_transparentCsgIntervalClearTask
        ))
            return MakeUnexpected(Failure());
        result.uploadTask = this.m_avboitSystem.taskGraphStage().m_transparentCsgIntervalClearTask;
        assert(avboitPrePayload.transparentCsgStreamsUploaded && avboitPrePayload.transparentCsgSnapshot.captured);
    }
    result.materialGeometrySet = transparentCsgMaterialGeometrySet;
    result.materialSampledTextureSet = transparentCsgMaterialSampledTextureSet;
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

