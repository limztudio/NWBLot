[cpp_header("<global/assert.h>"), cpp_name("FOUNDATION_ASSERT_CHECK")]
extern b8 AssertionCheck(in b8 condition);

[cpp_name("::DiagnosticEventRecord"), cpp_flags(brace_init)]
extern class DiagnosticEventRecord{
    StringView category;
    StringView event;
    StringView expression;
    StringView file;
    u64 instructionPointer;
    u32 line;
    StringView message;
    b8 terminatesProcess;
};

[cpp_name("::DiagnosticEventText"), cpp_flags(brace_init)]
extern class DiagnosticEventText{
    StringView nullTerminatedText(...)const;
    StringView view(...)const;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<global/diagnostics.h>"), cpp_name("::SetDiagnosticEventCallback")]
extern void SetDiagnosticEventCallback(in auto callback);

[cpp_header("<global/diagnostics.h>"), cpp_name("::ClearDiagnosticEventCallback")]
extern void ClearDiagnosticEventCallback(in auto callback);

[cpp_name("::CaptureDiagnosticEvent")]
extern void CaptureDiagnosticEvent(in DiagnosticEventRecord a0);

[cpp_header("<global/diagnostics.h>"), cpp_name("::MakeDiagnosticEventText")]
extern DiagnosticEventText MakeDiagnosticEventText(in StringView format, in auto value);

[cpp_header("<global/diagnostics.h>"), cpp_name("::CaptureDiagnosticEventAtCallSite")]
extern void CaptureDiagnosticEventAtCallSite(in DiagnosticEventRecord record);

[cpp_name("::CaptureDiagnosticEvent")]
extern void CaptureDiagnosticMessage(in StringView category, in StringView message, in StringView file = {}, in u32 line = {});

[cpp_name("::DiagnosticEventNameFromCategory")]
extern StringView DiagnosticEventNameFromCategory(in StringView a0);

[cpp_name("::DiagnosticEventNameFromRecord")]
extern StringView DiagnosticEventNameFromRecord(in DiagnosticEventRecord a0);


