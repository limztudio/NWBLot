////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
enum<u32> Section{
    Controls,
    Edit,
    List,
    Combo,
    SearchCombo,
    PopupTools,
    NestedPopup,
    NumericEdit,
    TextArea,
    RadioGroup,
    Slider,
    Progress,
    Image,
    kCount
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StringView SectionName(in Section section){
    switch(section){
        case Section::Controls: return "Controls and menu";
        case Section::Edit: return "Text editing";
        case Section::List: return "Virtual list";
        case Section::Combo: return "Keyed combo";
        case Section::SearchCombo: return "Searchable combo";
        case Section::PopupTools: return "Tooltips and context menu";
        case Section::NestedPopup: return "Nested popups";
        case Section::NumericEdit: return "Numeric editing";
        case Section::TextArea: return "Multiline text";
        case Section::RadioGroup: return "Radio choices";
        case Section::Slider: return "Slider";
        case Section::Progress: return "Progress";
        case Section::Image: return "Images";
        case Section::kCount: return "";
    }
    return "";
}

Rect ResolveWidgetGalleryLayoutBounds(in DisplayMetrics display, in f32 preferredTop){
    const f32 height = (s_SelectorHeight + s_ContentGap) + s_ContentHeight;
    const f32 availableX = (display.logicalWidth - s_SelectorWidth) - s_GalleryMargin;
    const f32 availableY = (display.logicalHeight - height) - s_GalleryMargin;
    const f32 x = max(s_GalleryMargin, availableX);
    const f32 y = max(s_GalleryMargin, min(preferredTop, availableY));
    return Rect(x, y, s_SelectorWidth, height);
}

u64 ResolveImmutableListSourceKey(in u64 index, in usize labelCount){
    if(index < cast<u64>(labelCount))
        return index + 1u;
    return 0u;
}

Expected<u64> TryResolveImmutableListSourceIndex(in u64 keyValue, in usize labelCount){
    if(keyValue == 0u || keyValue > cast<u64>(labelCount))
        return makeUnexpected(Failure());
    return keyValue - 1u;
}

b8 IsImmutableListSourceRowEnabled(in u64 index, in usize labelCount, in u64 disabledKey){
    return index < cast<u64>(labelCount) && index + 1u != disabledKey;
}

Expected<u64> TryFindFilteredListSourceIndex(in Span<u64> indices, in u64 count, in usize labelCount, in u64 keyValue){
    for(u64 candidate = 0u; candidate < count && cast<usize>(candidate) < indices.size(); ++candidate){
        if(ResolveImmutableListSourceKey(indices[cast<usize>(candidate)], labelCount) == keyValue)
            return candidate;
    }
    return makeUnexpected(Failure());
}

StringView ResolvePopupGalleryCaption(in u32 choice){
    if(choice == 0u)
        return "Popup menu";
    if(choice == s_PopupFirstChoice)
        return "First choice selected";
    return "Second choice selected";
}

f32 ResolveWidgetGalleryContentWidth(in u32 selected){
    if(selected == cast<u32>(Section::TextArea))
        return s_SelectorWidth;
    return s_OrdinaryGalleryWidth;
}

StringView ResolveNestedPopupLabel(in u64 index){
    switch(index){
    case 0u: return "Alpha";
    case 1u: return "Beta";
    case 2u: return "Gamma (disabled)";
    case 3u: return "Delta";
    case 4u: return "Echo";
    default: return "";
    }
}

StringView ResolvePopupToolsLabel(in u64 index){
    switch(index){
    case 0u: return "Inspect selection";
    case 1u: return "Duplicate";
    case 2u: return "Delete (disabled)";
    case 3u: return "Rename";
    case 4u: return "Reset view";
    default: return "";
    }
}

StringView ResolveRadioGroupLabel(in u64 index){
    switch(index){
    case 0u: return "Balanced";
    case 1u: return "High quality";
    case 2u: return "Unavailable";
    default: return "";
    }
}

StringView ResolveSearchComboLabel(in u64 index){
    switch(index){
    case 0u: return "Apple";
    case 1u: return "Banana";
    case 2u: return "Blueberry";
    case 3u: return "Cherry";
    case 4u: return "Fig (disabled)";
    case 5u: return "Grape";
    case 6u: return "Kiwi";
    case 7u: return "Lemon";
    case 8u: return "Mango";
    case 9u: return "Orange";
    case 10u: return "Pear";
    case 11u: return "Plum";
    default: return "";
    }
}

f32 ResolveSkinGalleryCaptionHeight(in f32 captionHeight, in f32 koreanHeight){
    return captionHeight + koreanHeight + s_CaptionPadding;
}

f32 ResolveSkinGalleryPreferredTop(in f32 captionHeight){
    return s_GalleryMargin + s_PanelBaseHeight + captionHeight + s_PanelBottomGap;
}

f32 ResolveSkinGalleryOriginX(in f32 logicalWidth){
    return max(s_GalleryMargin, (logicalWidth - s_OrdinaryGalleryWidth) - s_GalleryMargin);
}

f32 ResolveSkinGalleryCenteredTextY(in f32 originY, in f32 boxOffsetY, in f32 boxHeight, in f32 textHeight){
    return originY + boxOffsetY + (boxHeight - textHeight) * 0.5f;
}

Color ResolveImageGallerySliceTint(){
    return Color(s_ImageGallerySliceTint.x, s_ImageGallerySliceTint.y, s_ImageGallerySliceTint.z, s_ImageGallerySliceTint.w);
}

f64 AdvanceProgressGalleryFraction(in f64 fraction){
    if(fraction >= 1.0)
        return 0.0;
    return fraction + s_DefaultProgressFraction;
}

b8 CanShowTestbedOverviewWindow(in Rect gallery, in Rect overview){
    return !(gallery.x < overview.x + overview.width && gallery.y < overview.y + overview.height);
}

u32 StepWidgetGalleryCounter(in u32 count){
    if(count != u32.max)
        return count + 1u;
    return count;
}

Point ResolveWidgetGalleryContentOrigin(in Rect bounds, in u32 selected){
    const f32 width = ResolveWidgetGalleryContentWidth(selected);
    return Point(
        bounds.x + (bounds.width - width) * 0.5f,
        bounds.y + s_SelectorHeight + s_ContentGap
    );
}

Rect ResolvePopupGalleryAnchorRect(in f32 x, in f32 y){
    return Rect(
        x + s_PopupAnchorLeft,
        y + s_PopupAnchorTop,
        s_PopupMenuButtonWidth,
        s_PopupAnchorHeight
    );
}

Rect ResolveNestedPopupParentAnchorRect(in f32 x, in f32 y){
    return Rect(
        x + s_NestedPopupParentAnchorInset,
        y + s_NestedPopupParentAnchorTop,
        s_NestedPopupParentAnchorWidth,
        s_NestedPopupParentAnchorHeight
    );
}

Rect ResolveNestedPopupChildAnchorRect(in Rect parentBounds){
    return Rect(
        (parentBounds.x + parentBounds.width) - s_NestedPopupChildAnchorWidth,
        parentBounds.y + s_NestedPopupChildAnchorTop,
        s_NestedPopupChildAnchorWidth,
        s_NestedPopupChildAnchorHeight
    );
}


