////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/widgets/style.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<f64x2u> TryResolveListCursorScrollSpan(in u64 cursorIndex, in f32 rowHeight){
    const f64 start = cast<f64>(cursorIndex) * cast<f64>(rowHeight);
    const f64 end = start + cast<f64>(rowHeight);
    if(!IsFinite(start) || !IsFinite(end) || end <= start)
        return MakeUnexpected(Failure());
    return f64x2u(start, end);
}

b8 NeedsListScrollOffsetRescale(
    in f32 scrollRowHeight,
    in u64 scrollSourceGeneration,
    in u64 measureSourceGeneration,
    in f32 rowHeight
){
    return scrollRowHeight > 0.0f && scrollSourceGeneration == measureSourceGeneration && scrollRowHeight != rowHeight;
}

b8 IsListRowsFocused(in WidgetId focusId, in WidgetId listId, in WidgetId commandFocus){
    return focusId == listId || (commandFocus.valid() && focusId == commandFocus);
}


