void VerifyUiContextClaimTests_DifferentKindsCanShareAnInstanceGenerationWhilePreservingTheFullGeneration(mut UiContextClaimTests self){
    ASSERT_TRUE(self.begin(1u));
    const Expected<WidgetState> slider = self.declareState(s_UiContextClaimSliderKey, WidgetKind::Slider);
    const Expected<WidgetState> list = self.declareState(s_UiContextClaimListKey, WidgetKind::VirtualList);
    ASSERT_TRUE(slider.has_value());
    ASSERT_TRUE(list.has_value());
    EXPECT_TRUE(self.m_context.claimState(slider.value(), u64.max));
    EXPECT_TRUE(self.m_context.claimState(list.value(), u64.max));
    EXPECT_TRUE(self.m_context.claimState(slider.value(), cast<u64>(u32.max)));
    EXPECT_TRUE(self.m_context.claimState(list.value(), cast<u64>(u32.max)));
    ASSERT_TRUE(self.commit(1u));
}

void VerifyUiContextClaimTests_ASharedKindAndInstanceFailsAcrossDistinctRoots(mut UiContextClaimTests self){
    ASSERT_TRUE(self.begin(1u));
    const Expected<WidgetState> first = self.declareState(s_UiContextClaimSliderKey, WidgetKind::Slider);
    ASSERT_TRUE(first.has_value());
    ASSERT_TRUE(self.m_context.claimState(first.value(), 91u));
    ASSERT_TRUE(self.m_context.endRoot());
    WidgetRoot secondRoot = WidgetRoot();
    secondRoot.value = 18u;
    secondRoot.generation = 1u;
    ASSERT_TRUE(self.m_context.beginRoot(secondRoot));
    const Expected<WidgetState> second = self.declareState(s_UiContextClaimSliderKey, WidgetKind::Slider);
    ASSERT_TRUE(second.has_value());
    EXPECT_NE(first.value().id, second.value().id);
    EXPECT_FALSE(self.m_context.claimState(second.value(), 91u));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(1u));
}

void VerifyUiContextClaimTests_ASharedKindAndInstanceFailsAcrossDistinctScopes(mut UiContextClaimTests self){
    ASSERT_TRUE(self.begin(1u));
    const Expected<WidgetState> first = self.declareState(s_UiContextClaimSliderKey, WidgetKind::Slider);
    ASSERT_TRUE(first.has_value());
    ASSERT_TRUE(self.m_context.claimState(first.value(), 91u));
    ASSERT_TRUE(self.m_context.pushScope("nested"));
    const Expected<WidgetState> second = self.declareState(s_UiContextClaimSliderKey, WidgetKind::Slider);
    ASSERT_TRUE(second.has_value());
    EXPECT_NE(first.value().id, second.value().id);
    EXPECT_FALSE(self.m_context.claimState(second.value(), 91u));
    EXPECT_TRUE(self.m_context.failed());
}

void VerifyUiContextClaimTests_AcceptedAndAbandonedFramesReleaseTheirClaimsBeforeTheNextFrame(mut UiContextClaimTests self){
    ASSERT_TRUE(self.begin(1u));
    const Expected<WidgetState> first = self.declareState(s_UiContextClaimSliderKey, WidgetKind::Slider);
    ASSERT_TRUE(first.has_value());
    ASSERT_TRUE(self.m_context.claimState(first.value(), 91u));
    ASSERT_TRUE(self.commit(1u));

    ASSERT_TRUE(self.begin(2u));
    const Expected<WidgetState> second = self.declareState(s_UiContextClaimSliderKey, WidgetKind::Slider);
    ASSERT_TRUE(second.has_value());
    ASSERT_TRUE(self.m_context.claimState(second.value(), 91u));
    EXPECT_FALSE(self.m_context.claimState(second.value(), 91u));
    self.m_context.abandonFrame();

    ASSERT_TRUE(self.begin(3u));
    const Expected<WidgetState> third = self.declareState(s_UiContextClaimSliderKey, WidgetKind::Slider);
    ASSERT_TRUE(third.has_value());
    EXPECT_TRUE(self.m_context.claimState(third.value(), 91u));
    ASSERT_TRUE(self.commit(3u));
}

void VerifyUiContextClaimTests_ZeroInstancesAndStaleDeclarationsStillRejectTheFrame(mut UiContextClaimTests self){
    ASSERT_TRUE(self.begin(1u));
    const Expected<WidgetState> first = self.declareState(s_UiContextClaimSliderKey, WidgetKind::Slider);
    ASSERT_TRUE(first.has_value());
    const WidgetState stale = first.value();
    EXPECT_FALSE(self.m_context.claimState(first.value(), 0u));
    EXPECT_TRUE(self.m_context.failed());
    self.m_context.abandonFrame();

    ASSERT_TRUE(self.begin(2u));
    const Expected<WidgetState> current = self.declareState(s_UiContextClaimSliderKey, WidgetKind::Slider);
    ASSERT_TRUE(current.has_value());
    ASSERT_TRUE(self.m_context.claimState(current.value(), 91u));
    EXPECT_FALSE(self.m_context.claimState(stale, 92u));
    EXPECT_TRUE(self.m_context.failed());
}

void VerifyUiContextClaimTests_PromotedClaimsStillRejectPairsFromTheInlinePrefix(mut UiContextClaimTests self){
    ASSERT_TRUE(self.begin(1u));
    const Expected<WidgetState> slider = self.declareState(s_UiContextClaimSliderKey, WidgetKind::Slider);
    const Expected<WidgetState> list = self.declareState(s_UiContextClaimListKey, WidgetKind::VirtualList);
    ASSERT_TRUE(slider.has_value());
    ASSERT_TRUE(list.has_value());
    for(u64 instance = 1u; instance <= 32u; ++instance)
        ASSERT_TRUE(self.m_context.claimState(slider.value(), instance));
    ASSERT_TRUE(self.m_context.claimState(list.value(), 1u));
    EXPECT_FALSE(self.m_context.claimState(slider.value(), 1u));
    EXPECT_TRUE(self.m_context.failed());
}

void VerifyUiContextClaimTests_DuplicateAtThePromotionBoundaryRejectsTheFrame(mut UiContextClaimTests self){
    ASSERT_TRUE(self.begin(1u));
    const Expected<WidgetState> slider = self.declareState(s_UiContextClaimSliderKey, WidgetKind::Slider);
    ASSERT_TRUE(slider.has_value());
    for(u64 instance = 1u; instance <= 32u; ++instance)
        ASSERT_TRUE(self.m_context.claimState(slider.value(), instance));
    EXPECT_FALSE(self.m_context.claimState(slider.value(), 32u));
    EXPECT_TRUE(self.m_context.failed());
}

void VerifyUiContextClaimTests_LargeSmallAndEmptyFramesDoNotLeakPreviousPairsIntoPromotion(mut UiContextClaimTests self){
    for(u64 generation = 1u; generation <= 4u; ++generation){
        ASSERT_TRUE(self.begin(generation));
        const Expected<WidgetState> slider = self.declareState(s_UiContextClaimSliderKey, WidgetKind::Slider);
        const Expected<WidgetState> list = self.declareState(s_UiContextClaimListKey, WidgetKind::VirtualList);
        ASSERT_TRUE(slider.has_value());
        ASSERT_TRUE(list.has_value());
        u64 claims = 33u;
        if(generation == 1u)
            claims = 128u;
        else if(generation == 2u)
            claims = 16u;
        else if(generation == 3u)
            claims = 0u;
        for(u64 instance = 1u; instance <= claims; ++instance)
            ASSERT_TRUE(self.m_context.claimState(slider.value(), instance));
        if(generation == 4u){
            EXPECT_TRUE(self.m_context.claimState(slider.value(), 128u));
            EXPECT_TRUE(self.m_context.claimState(list.value(), 1u));
            EXPECT_FALSE(self.m_context.claimState(slider.value(), 1u));
            EXPECT_TRUE(self.m_context.failed());
        }
        else{
            ASSERT_TRUE(self.commit(generation));
        }
    }
}

void VerifyUiContextClaimTests_CapacityCountsDistinctKindAndInstancePairs(mut UiContextClaimTests self){
    ASSERT_TRUE(self.begin(1u));
    const Expected<WidgetState> slider = self.declareState(s_UiContextClaimSliderKey, WidgetKind::Slider);
    const Expected<WidgetState> list = self.declareState(s_UiContextClaimListKey, WidgetKind::VirtualList);
    ASSERT_TRUE(slider.has_value());
    ASSERT_TRUE(list.has_value());
    for(usize index = 0u; index < s_InputMaxTargets / 2u; ++index){
        const u64 instance = cast<u64>(index + 1u);
        ASSERT_TRUE(self.m_context.claimState(slider.value(), instance));
        ASSERT_TRUE(self.m_context.claimState(list.value(), instance));
    }
    EXPECT_FALSE(self.m_context.claimState(slider.value(), u64.max));
    EXPECT_TRUE(self.m_context.failed());
}


