#include <impl/ecs_mesh/runtime/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RuntimeMeshRequestSet : NoCopy{
    private usize m_expectedRequestCount;
    private Array<RuntimeMeshRequestEntry, s_RuntimeMeshRequestInlineCapacity> m_inlineEntries;
    private usize m_inlineCount = 0u;
    private usize m_remainingCount = 0u;
    private Optional<HashMap<RuntimeMeshRequestKey, b8>> m_index;

    [cpp_unwind]
    public RuntimeMeshRequestSet(in usize expectedRequestCount){
        this.m_expectedRequestCount = expectedRequestCount;
        if(expectedRequestCount > s_RuntimeMeshRequestInlineCapacity){
            this.m_index = Optional<HashMap<RuntimeMeshRequestKey, b8>>(HashMap<RuntimeMeshRequestKey, b8>());
            this.m_index.value().reserve(expectedRequestCount * s_RuntimeMeshIndexBucketsPerRequest);
        }
    }

    [cpp_unwind]
    public void add(in Name meshKey, in u64 version){
        if(meshKey == s_NameNone)
            return;
        const NameHash meshHash = meshKey.identityHash();
        if(!this.m_index.has_value()){
            if(TryAddInlineRuntimeMeshRequest(this.m_inlineEntries, this.m_inlineCount, this.m_remainingCount, meshHash, version))
                return;
            this.promoteIndex();
        }
        const RuntimeMeshRequestKey key(meshHash, version);
        if(this.m_index.value().try_emplace(key, false).second)
            ++this.m_remainingCount;
    }

    public void markLive(in Name meshKey, in u64 version){
        if(meshKey == s_NameNone)
            return;
        const NameHash meshHash = meshKey.identityHash();
        if(this.m_index.has_value()){
            this.markIndexedLive(meshHash, version);
            return;
        }
        MarkInlineRuntimeMeshRequestLive(this.m_inlineEntries, this.m_remainingCount, this.m_inlineCount, meshHash, version);
    }

    public b8 containsLive(in Name meshKey, in u64 version)const{
        if(meshKey == s_NameNone)
            return false;
        const NameHash meshHash = meshKey.identityHash();
        if(this.m_index.has_value())
            return this.containsIndexedLive(meshHash, version);
        return ContainsInlineRuntimeMeshRequestLive(this.m_inlineEntries, this.m_inlineCount, meshHash, version);
    }

    public b8 complete()const{
        return this.m_remainingCount == 0u;
    }

    [cpp_unwind]
    private void promoteIndex(){
        this.m_index = Optional<HashMap<RuntimeMeshRequestKey, b8>>(HashMap<RuntimeMeshRequestKey, b8>());
        this.m_index.value().reserve(Max(this.m_expectedRequestCount, s_RuntimeMeshRequestInlineCapacity + 1u) * s_RuntimeMeshIndexBucketsPerRequest);
        for(usize entryIndex = 0u; entryIndex < this.m_inlineCount; ++entryIndex){
            in RuntimeMeshRequestEntry entry = this.m_inlineEntries[entryIndex];
            this.m_index.value().insert_or_assign(entry.key, entry.found);
        }
    }

    private void markIndexedLive(in NameHash meshHash, in u64 version){
        const RuntimeMeshRequestKey key(meshHash, version);
        const auto found = this.m_index.value().find(key);
        if(found != this.m_index.value().end() && !found.value()){
            found.value() = true;
            --this.m_remainingCount;
        }
    }

    private b8 containsIndexedLive(in NameHash meshHash, in u64 version)const{
        const RuntimeMeshRequestKey key(meshHash, version);
        const auto found = this.m_index.value().find(key);
        return found != this.m_index.value().end() && found.value();
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

