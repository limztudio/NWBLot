#include <impl/ecs_skeleton/components.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace SkeletonRuntime{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] NWB_INLINE Expected<u32> BuildStoredJointPaletteFromSkeletonPose(const SkeletonPoseComponent& pose, Vector<SkeletonJointMatrix, Core::Alloc::GlobalArena>& outJointPalette)noexcept{
    return TryBuildStoredJointPaletteVectorFromSkeletonPose(pose, outJointPalette);
}

[[nodiscard]] NWB_INLINE Expected<u32> BuildStoredJointPaletteFromSkeletonPose(const SkeletonPoseComponent& pose, Vector<SkeletonJointMatrix, Core::Alloc::ScratchArena>& outJointPalette)noexcept{
    outJointPalette.clear();
    if(!HasSkeletonPoseData(pose))
        return static_cast<u32>(SkeletonSkinningMode::LinearBlend);
    if(!ValidSkeletonPoseTopology(pose))
        return MakeUnexpected(Failure{});
    outJointPalette.resize(pose.localJoints.size(), MakeIdentitySkeletonJointMatrix());
    const Expected<u32> resolvedMode = TryFillStoredJointPaletteSpanFromSkeletonPose(pose, Span<SkeletonJointMatrix>(outJointPalette.data(), outJointPalette.size()));
    if(!resolvedMode.has_value()){
        outJointPalette.clear();
        return MakeUnexpected(Failure{});
    }
    return resolvedMode.value();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

