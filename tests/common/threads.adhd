[cpp_header("<global/atomic.h>"), cpp_name("::Atomic"), cpp_flags(no_copy, no_assign)]
extern class TestAtomic<T>{
    T load(in MemoryOrder order)const;
    void store(in T value, in MemoryOrder order);
    T exchange(in T value, in MemoryOrder order);
    void wait(in T value, in MemoryOrder order)const;
    void notify_all();
    void notify_one();
    T fetch_add(in T value, in MemoryOrder order);
    T fetch_sub(in T value, in MemoryOrder order);
    b8 compare_exchange_weak(mut T expected, in T value, in MemoryOrder order);
};


