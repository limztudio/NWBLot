#include <impl/ecs_render/deferred/import_types.adhd.h>
#include <impl/ecs_render/deferred/opaque_compute_emulation_planner.adhd.h>
#include <impl/ecs_render/deferred/opaque_compute_emulation_producers.adhd.h>
#include <impl/ecs_render/deferred/opaque_shared_compute_emulation_chain.adhd.h>
#include <impl/ecs_render/deferred/post_gbuffer_normalize_builder.adhd.h>
#include <impl/ecs_render/deferred/presentation_settings.adhd.h>
#include <impl/ecs_render/deferred/task_graph_gbuffer_task.adhd.h>
#include <impl/ecs_render/csg/csg_system.adhd.h>
#include <impl/ecs_render/csg/renderer_csg_types.adhd.h>
#include <impl/ecs_render/csg/work_region.adhd.h>
#include <impl/ecs_render/kernel/renderer_constants_private.adhd.h>
#include <impl/ecs_render/kernel/task_graph_resource_utils.adhd.h>
#include <impl/ecs_render/kernel/timing_names.adhd.h>
#include <impl/ecs_render/material/material_system.adhd.h>
#include <impl/ecs_render/material/renderer_draw_types.adhd.h>
#include <impl/ecs_render/material/task_graph_resource_sets.adhd.h>
#include <impl/ecs_render/shared/frame_push_constants.adhd.h>
#include <impl/ecs_render/shared/frame_types.adhd.h>
#include <impl/assets/graphics/mesh/runtime_constants.h>

#include <core/common/log.h>
