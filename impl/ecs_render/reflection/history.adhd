native{
#include <impl/ecs_render/reflection/feedback.adhd.h>

#include <impl/ecs_render/shared/statistics_readback_state.adhd.h>

#include <core/alloc/global.h>

#include <global/plan_reservation.h>
#include <global/arena_object.h>
#include <global/refcount_ptr.h>
#include <global/sync.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// CPU acceptance chooses banks; GPU ordering protects reuse; owner never waits.
class ReflectionHistoryState : NoCopy{
public:
    explicit ReflectionHistoryState(const u16 deviceGeneration)noexcept
        : m_deviceGeneration(deviceGeneration)
    {}


public:
    void reset(const u16 deviceGeneration)noexcept{
        NothrowScopedLock lock(m_mutex);

        ++m_generation;
        m_deviceGeneration = deviceGeneration;
        m_acceptedSequence = 0u;
        m_reservedSequence = 0u;
        m_nextSampleIndex = 0u;
        m_sampleCount = 0u;
        m_acceptedBank = 0u;
        m_eligible = false;
        m_hardwareReady = false;
        m_resourcesChanged = true;
    }
    [[nodiscard]] ReflectionHistoryPlan plan(const ReflectionSceneContentStamp& stamp, const ReflectionSettings& settings, const u64 graphicsFrameIndex)noexcept{
        NothrowScopedLock lock(m_mutex);

        const u64 sequence = m_nextSequence++;
        return ResolveReflectionHistoryPlan(
            stamp,
            settings,
            graphicsFrameIndex,
            m_stamp,
            m_settings,
            m_generation,
            sequence,
            m_acceptedSequence,
            m_epoch,
            m_historyStartGraphicsFrame,
            m_nextSampleIndex,
            m_sampleCount,
            m_acceptedBank,
            m_eligible,
            m_hardwareReady,
            m_resourcesChanged
        );
    }
    [[nodiscard]] b8 reserve(const ReflectionHistoryPlan& plan)noexcept{
        NothrowScopedLock lock(m_mutex);

        if(!CanReserveReflectionHistoryPlan(m_deviceGeneration, m_reservedSequence, m_generation, m_acceptedSequence, plan))
            return false;
        m_reservedSequence = plan.sequence;
        return true;
    }
    void discard(const ReflectionHistoryPlan& plan)noexcept{
        NothrowScopedLock lock(m_mutex);

        if(plan.generation == m_generation && plan.sequence == m_reservedSequence)
            m_reservedSequence = 0u;
    }
    void accept(const ReflectionHistoryPlan& plan, const Core::QueueSubmissionToken& token, const b8 hardwareReady)noexcept{
        NothrowScopedLock lock(m_mutex);

        if(plan.generation != m_generation || plan.sequence != m_reservedSequence)
            return;
        if(!token.valid() || !token.hasPhysicalQueueIdentity() || token.deviceGeneration != m_deviceGeneration)
            return;
        ApplyAcceptedReflectionHistoryPlan(
            plan,
            hardwareReady,
            m_stamp,
            m_settings,
            m_acceptedSequence,
            m_reservedSequence,
            m_epoch,
            m_historyStartGraphicsFrame,
            m_nextSampleIndex,
            m_sampleCount,
            m_acceptedBank,
            m_eligible,
            m_hardwareReady,
            m_resourcesChanged
        );
    }


private:
    ReflectionSceneContentStamp m_stamp;
    ReflectionSettings m_settings;
    u64 m_generation = 1u;
    u64 m_nextSequence = 1u;
    u64 m_acceptedSequence = 0u;
    u64 m_reservedSequence = 0u;
    u64 m_epoch = 0u;
    u64 m_historyStartGraphicsFrame = 0u;
    u32 m_nextSampleIndex = 0u;
    u32 m_sampleCount = 0u;
    u32 m_acceptedBank = 0u;
    mutable Futex m_mutex;
    u16 m_deviceGeneration = 0u;
    b8 m_eligible = false;
    b8 m_hardwareReady = false;
    b8 m_resourcesChanged = false;
};

using ReflectionHistoryControl = RefCounter<ReflectionHistoryState>;
using ReflectionHistoryControlHandle = RefCountPtr< ReflectionHistoryControl, ArenaRefDeleter<ReflectionHistoryControl, Core::Alloc::GlobalArena> >;


class ReflectionHistoryReservation final : public PlanReservationBase<ReflectionHistoryControlHandle, ReflectionHistoryPlan>{
public:
    using PlanReservationBase<ReflectionHistoryControlHandle, ReflectionHistoryPlan>::PlanReservationBase;


public:
    void accept(const Core::QueueSubmissionToken& token, const b8 hardwareReady)noexcept{
        if(m_reserved)
            m_control->accept(m_plan, token, hardwareReady);
        m_reserved = false;
        m_control = nullptr;
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


