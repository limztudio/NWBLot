// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidDeferredTargetExtent(in u32 width, in u32 height){
    return width > 0u && height > 0u;
}

b8 ValidDeferredCsgTargetLayerCounts(
    in u32 peelLayerCount,
    in u32 receiverEventLayerCount,
    in u32 receiverSpanLayerCount,
    in u32 removedIntervalLayerCount
){
    return peelLayerCount > 0u && receiverEventLayerCount > 0u && receiverSpanLayerCount > 0u && removedIntervalLayerCount > 0u;
}

b8 ValidLaggedLightingHistoryState(in b8 hasTextures, in b8 hasSlotsBuffer, in b8 descriptorsValid, in u64 generation){
    return hasTextures && hasSlotsBuffer && descriptorsValid && generation != 0u;
}

b8 AllDeferredTargetFormatsKnown(in b8 gbufferFormatsKnown, in b8 csgPeelFormatsKnown, in b8 csgStorageFormatsKnown){
    return gbufferFormatsKnown && csgPeelFormatsKnown && csgStorageFormatsKnown;
}

void LogUnsupportedDeferredTargetFormats(){
    error("RendererSystem: failed to find supported deferred framebuffer formats");
}

void LogLaggedLightingHistoryHeapMissing(){
    error("RendererSystem: lagged lighting history requires the global descriptor heap");
}


