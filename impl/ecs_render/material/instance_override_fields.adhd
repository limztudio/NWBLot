#include <impl/assets_material/field_types.adhd>
#include <impl/ecs_render/components.adhd>
#include <impl/ecs_render/mesh/instance_gpu_data.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////




////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_MaterialInstanceVectorComponentCount = 4u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MaterialInstanceParameterNames{
    public Name parameterName;
    public Name blockName;
    public Name fieldName;
}



////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


MaterialInstanceParameter BuildMaterialInstanceParameter(
    in MaterialInstanceParameterNames names,
    in MaterialLayoutFieldType fieldType,
    in u32x4u value
){
    MaterialInstanceParameter parameter;
    parameter.parameterName = names.parameterName;
    parameter.blockName = names.blockName;
    parameter.fieldName = names.fieldName;
    parameter.fieldType = fieldType;
    parameter.value = value;
    return parameter;
}

u32x4u PackMaterialInstanceBytes(in Span<u8> bytes){
    assert(bytes.size() <= 16u);
    if(bytes.empty())
        return u32x4u(0u, 0u, 0u, 0u);

    return u32x4u(
        ReadPartialU32LittleEndian(bytes, 0u),
        ReadPartialU32LittleEndian(bytes, 4u),
        ReadPartialU32LittleEndian(bytes, 8u),
        ReadPartialU32LittleEndian(bytes, 12u)
    );
}

b8 TryStoreMaterialMutableParameter(mut MaterialInstanceComponent component, in MaterialInstanceParameter parameter){
    for(usize index = 0u; index < component.overrides.size(); ++index){
        if(component.overrides[index].parameterName != parameter.parameterName)
            continue;

        if(component.overrides[index].fieldType != parameter.fieldType)
            return false;

        component.overrides[index] = parameter;
        ++component.revision;
        return true;
    }

    component.overrides.push_back(parameter);
    ++component.revision;
    return true;
}

Expected<usize> TryFindMaterialParameterNameDotIndex(in StringView parameterName){
    const usize dotIndex = parameterName.find('.');
    if(parameterName.empty() || dotIndex >= parameterName.size() || dotIndex == 0u || dotIndex + 1u >= parameterName.size()){
        error("MaterialInstanceComponent: parameter '{}' must use block.field form", parameterName);
        return MakeUnexpected(Failure());
    }
    if(parameterName.find('.', dotIndex + 1u) < parameterName.size()){
        error("MaterialInstanceComponent: parameter '{}' must not contain more than one block separator", parameterName);
        return MakeUnexpected(Failure());
    }
    return dotIndex;
}

b8 ValidateMaterialInstanceInterface(in MaterialInstanceComponent component, in Name materialInterface, in StringView parameterNameText){
    if(materialInterface == s_NameNone){
        error("MaterialInstanceComponent: parameter '{}' requires a material interface", parameterNameText);
        return false;
    }
    if(component.materialInterface == s_NameNone){
        error("MaterialInstanceComponent: parameter '{}' requires a component material interface", parameterNameText);
        return false;
    }
    if(component.materialInterface == materialInterface)
        return true;

    error(
        "MaterialInstanceComponent: parameter '{}' targets interface '{}' but component expects '{}'"
        , parameterNameText
        , materialInterface.resolvedText()
        , component.materialInterface.resolvedText()
    );
    return false;
}

b8 StoreMaterialMutableParameter(mut MaterialInstanceComponent component, in MaterialInstanceParameter parameter, in StringView parameterNameText){
    if(TryStoreMaterialMutableParameter(component, parameter))
        return true;

    error("MaterialInstanceComponent: parameter '{}' was already set with a different type", parameterNameText);
    return false;
}

b8 ValidateMaterialInstanceNumericFieldType(in MaterialLayoutFieldType fieldType, in StringView parameterNameText){
    if(IsMaterialLayoutNumericFieldType(fieldType))
        return true;

    error("MaterialInstanceComponent: parameter '{}' must use a numeric mutable field type", parameterNameText);
    return false;
}

Expected<MaterialInstanceParameterNames> SplitMaterialInstanceParameterName(in StringView parameterName){
    const Expected<usize> dotIndex = TryFindMaterialParameterNameDotIndex(parameterName);
    if(!dotIndex.has_value())
        return MakeUnexpected(Failure());

    const usize dotPos = dotIndex.value();
    Name resolvedParameterName = s_NameNone;
    Name resolvedBlockName = s_NameNone;
    Name resolvedFieldName = s_NameNone;
    b8 validNames = false;
    native(in parameterName, in dotPos, mut resolvedParameterName, mut resolvedBlockName, mut resolvedFieldName, mut validNames){
        const auto name = Name::FromText(parameterName);
        const auto blockName = Name::FromText(parameterName.substr(0u, dotPos));
        const auto fieldName = Name::FromText(parameterName.substr(dotPos + 1u));
        if(name && blockName && fieldName){
            resolvedParameterName = *name;
            resolvedBlockName = *blockName;
            resolvedFieldName = *fieldName;
            validNames = true;
        }
    }
    if(!validNames){
        error("MaterialInstanceComponent: parameter '{}' contains an embedded null", parameterName);
        return MakeUnexpected(Failure());
    }
    MaterialInstanceParameterNames result;
    result.parameterName = resolvedParameterName;
    result.blockName = resolvedBlockName;
    result.fieldName = resolvedFieldName;
    return result;
}

b8 SetMaterialMutableParameter(
    mut MaterialInstanceComponent component,
    in Name materialInterface,
    in StringView parameterNameText,
    in MaterialLayoutFieldType fieldType,
    in u32x4u value
){
    if(!ValidateMaterialInstanceNumericFieldType(fieldType, parameterNameText))
        return false;
    if(!ValidateMaterialInstanceInterface(component, materialInterface, parameterNameText))
        return false;

    const Expected<MaterialInstanceParameterNames> names = SplitMaterialInstanceParameterName(parameterNameText);
    if(!names.has_value())
        return false;

    const MaterialInstanceParameter parameter = BuildMaterialInstanceParameter(names.value(), fieldType, value);
    return StoreMaterialMutableParameter(component, parameter, parameterNameText);
}

