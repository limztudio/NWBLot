#include <impl/physics/snapshot.adhd>
#include <impl/ecs_physics/subsystem_bridges.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena, modular, system("physics")]
class PhysicsSystem{
    private mut World m_world;
    private PhysicsWorld m_physicsWorld;
    private PhysicsGpuDispatcher m_gpuDispatcher;
    private Optional<mut AssetManager> m_assetManager;
    private HashMap<EntityID, EcsEntityPhysicsRecord> m_entityRecords;
    private HashMap<EntityID, EcsJointSyncRecord> m_entityJoints;
    private HashMap<EntityID, EcsTrackedRagdoll> m_activeRagdolls;
    private PhysicsEnvironment m_environmentScratch;
    private CollisionLayerMatrix m_collisionLayerMatrix;
    private Vector<EcsBodyTransformSnapshot> m_bodyTransformSnapshots;
    private Vector<u32> m_bodyTransformSnapshotMeta;
    private Vector<EcsSlotOwner> m_bodyIndexToEntity;
    private Vector<EcsSlotOwner> m_shapeIndexToEntity;
    private Vector<EcsSlotOwner> m_jointIndexToEntity;
    private HashMap<Name, EntityID> m_namedEntities;
    private HashMap<EntityID, Name> m_syncedRigidBodyTags;
    private HashMap<EntityID, Name> m_syncedColliderTags;
    private EcsPhysicsSyncScratch m_syncScratch;
    private EcsPhysicsAssetCache m_assetCache;
    private Vector<GpuPhysicsRenderTransformBinding> m_exportBindingsScratch;
    private Vector<BodyMoveEvent> m_frameBodyMoveEvents;
    private Vector<ContactBeginTouchEvent> m_frameContactBeginEvents;
    private Vector<ContactEndTouchEvent> m_frameContactEndEvents;
    private Vector<ContactPersistEvent> m_frameContactPersistEvents;
    private Vector<ContactHitEvent> m_frameContactHitEvents;
    private Vector<SensorBeginTouchEvent> m_frameSensorBeginEvents;
    private Vector<SensorEndTouchEvent> m_frameSensorEndEvents;
    private Vector<SensorStayEvent> m_frameSensorStayEvents;
    private Vector<BodyWakeEvent> m_frameBodyWakeEvents;
    private Vector<JointBreakEvent> m_frameJointBreakEvents;
    private Vector<EcsBodyMoveEvent> m_ecsBodyMoveEvents;
    private Vector<EcsContactBeginEvent> m_ecsContactBeginEvents;
    private Vector<EcsContactEndEvent> m_ecsContactEndEvents;
    private Vector<EcsContactPersistEvent> m_ecsContactPersistEvents;
    private Vector<EcsContactHitEvent> m_ecsContactHitEvents;
    private Vector<EcsSensorBeginEvent> m_ecsSensorBeginEvents;
    private Vector<EcsSensorEndEvent> m_ecsSensorEndEvents;
    private Vector<EcsSensorStayEvent> m_ecsSensorStayEvents;
    private Vector<EcsBodyWakeEvent> m_ecsBodyWakeEvents;
    private Vector<EcsJointBreakEvent> m_ecsJointBreakEvents;
    private f32 m_accumulator = 0.0f;
    private f32 m_interpolationAlpha = 1.0f;
    private WorldStepStats m_lastStepStats;
    private f64 m_lastStepMs = 0.0;
    private u64 m_lastStepTopologyVersion = 0u;
    private b8 m_useDirectWorldEvents = false;
    private b8 m_ecsEventsPopulated = false;

    public PhysicsSystem(mut World world){
        this.m_world = world;
        this.registerDefaultAccesses();
    }

    public PhysicsSystem(
        mut World world,
        mut GraphicsRuntime graphics,
        mut AssetManager assetManager,
        in ShaderArchivePathResolver shaderPathResolver
    ){
        this.m_world = world;
        this.m_assetManager = Optional<mut AssetManager>(assetManager);
        this.m_gpuDispatcher.attachRuntime(graphics, assetManager, shaderPathResolver);
        this.registerDefaultAccesses();
    }

    private void registerDefaultAccesses(){
        this.writeAccess<PhysicsWorldConfigComponent>();
        this.writeAccess<RigidBodyComponent>();
        this.writeAccess<ColliderComponent>();
        this.writeAccess<JointComponent>();
        this.writeAccess<TransformComponent>();
        this.writeAccess<PhysicsParentComponent>();
        this.writeAccess<CharacterControllerComponent>();
        this.writeAccess<VehicleComponent>();
        this.writeAccess<RagdollComponent>();
        this.writeAccess<FluidVolumeComponent>();
        this.writeAccess<ForceFieldComponent>();
        this.writeAccess<ArticulationComponent>();
        this.writeAccess<SoftBodyComponent>();
        this.writeAccess<GpuRenderTransformExportComponent>();
    }

    private void clearFrameEvents(){
        this.m_useDirectWorldEvents = false;
        this.m_ecsEventsPopulated = false;
        this.m_frameBodyMoveEvents.clear();
        this.m_frameContactBeginEvents.clear();
        this.m_frameContactEndEvents.clear();
        this.m_frameContactPersistEvents.clear();
        this.m_frameContactHitEvents.clear();
        this.m_frameSensorBeginEvents.clear();
        this.m_frameSensorEndEvents.clear();
        this.m_frameSensorStayEvents.clear();
        this.m_frameBodyWakeEvents.clear();
        this.m_frameJointBreakEvents.clear();
        this.m_ecsBodyMoveEvents.clear();
        this.m_ecsContactBeginEvents.clear();
        this.m_ecsContactEndEvents.clear();
        this.m_ecsContactPersistEvents.clear();
        this.m_ecsContactHitEvents.clear();
        this.m_ecsSensorBeginEvents.clear();
        this.m_ecsSensorEndEvents.clear();
        this.m_ecsSensorStayEvents.clear();
        this.m_ecsBodyWakeEvents.clear();
        this.m_ecsJointBreakEvents.clear();
    }

    private void appendLastStepEvents(){
        const Span<BodyMoveEvent> moves = this.m_physicsWorld.bodyMoveEvents();
        if(!moves.empty()){
            this.m_frameBodyMoveEvents.reserve(this.m_frameBodyMoveEvents.size() + moves.size());
            for(usize i = 0u; i < moves.size(); ++i)
                this.m_frameBodyMoveEvents.push_back(moves[i]);
        }

        const Span<ContactBeginTouchEvent> cBegins = this.m_physicsWorld.contactBeginEvents();
        if(!cBegins.empty()){
            this.m_frameContactBeginEvents.reserve(this.m_frameContactBeginEvents.size() + cBegins.size());
            for(usize i = 0u; i < cBegins.size(); ++i)
                this.m_frameContactBeginEvents.push_back(cBegins[i]);
        }

        const Span<ContactEndTouchEvent> cEnds = this.m_physicsWorld.contactEndEvents();
        if(!cEnds.empty()){
            this.m_frameContactEndEvents.reserve(this.m_frameContactEndEvents.size() + cEnds.size());
            for(usize i = 0u; i < cEnds.size(); ++i)
                this.m_frameContactEndEvents.push_back(cEnds[i]);
        }

        const Span<ContactPersistEvent> cPersists = this.m_physicsWorld.contactPersistEvents();
        if(!cPersists.empty()){
            this.m_frameContactPersistEvents.reserve(this.m_frameContactPersistEvents.size() + cPersists.size());
            for(usize i = 0u; i < cPersists.size(); ++i)
                this.m_frameContactPersistEvents.push_back(cPersists[i]);
        }

        const Span<ContactHitEvent> cHits = this.m_physicsWorld.contactHitEvents();
        if(!cHits.empty()){
            this.m_frameContactHitEvents.reserve(this.m_frameContactHitEvents.size() + cHits.size());
            for(usize i = 0u; i < cHits.size(); ++i)
                this.m_frameContactHitEvents.push_back(cHits[i]);
        }

        const Span<SensorBeginTouchEvent> sBegins = this.m_physicsWorld.sensorBeginEvents();
        if(!sBegins.empty()){
            this.m_frameSensorBeginEvents.reserve(this.m_frameSensorBeginEvents.size() + sBegins.size());
            for(usize i = 0u; i < sBegins.size(); ++i)
                this.m_frameSensorBeginEvents.push_back(sBegins[i]);
        }

        const Span<SensorEndTouchEvent> sEnds = this.m_physicsWorld.sensorEndEvents();
        if(!sEnds.empty()){
            this.m_frameSensorEndEvents.reserve(this.m_frameSensorEndEvents.size() + sEnds.size());
            for(usize i = 0u; i < sEnds.size(); ++i)
                this.m_frameSensorEndEvents.push_back(sEnds[i]);
        }

        const Span<SensorStayEvent> sStays = this.m_physicsWorld.sensorStayEvents();
        if(!sStays.empty()){
            this.m_frameSensorStayEvents.reserve(this.m_frameSensorStayEvents.size() + sStays.size());
            for(usize i = 0u; i < sStays.size(); ++i)
                this.m_frameSensorStayEvents.push_back(sStays[i]);
        }

        const Span<BodyWakeEvent> bWakes = this.m_physicsWorld.bodyWakeEvents();
        if(!bWakes.empty()){
            this.m_frameBodyWakeEvents.reserve(this.m_frameBodyWakeEvents.size() + bWakes.size());
            for(usize i = 0u; i < bWakes.size(); ++i)
                this.m_frameBodyWakeEvents.push_back(bWakes[i]);
        }

        const Span<JointBreakEvent> jBreaks = this.m_physicsWorld.jointBreakEvents();
        if(!jBreaks.empty()){
            this.m_frameJointBreakEvents.reserve(this.m_frameJointBreakEvents.size() + jBreaks.size());
            for(usize i = 0u; i < jBreaks.size(); ++i)
                this.m_frameJointBreakEvents.push_back(jBreaks[i]);
        }
    }

    private EntityID resolveEcsEventBodyEntity(in BodyId bodyId, in b8 topoTrusted)const{
        if(!bodyId.valid())
            return s_InvalidEntityId;
        if(topoTrusted){
            if(bodyId.index < cast<u32>(this.m_bodyIndexToEntity.size())){
                in EcsSlotOwner owner = this.m_bodyIndexToEntity[bodyId.index];
                if(owner.entity.valid() && owner.generation == bodyId.generation)
                    return owner.entity;
            }
            if(!this.m_syncScratch.destroyedBodyOwners.empty()){
                const auto found = this.m_syncScratch.destroyedBodyOwners.find(PackEcsSlotKey(bodyId.index, bodyId.generation));
                if(found != this.m_syncScratch.destroyedBodyOwners.end())
                    return found.value();
            }
            return s_InvalidEntityId;
        }
        return this.entityForBodyIncludingDestroyed(bodyId);
    }

    private EntityID resolveEcsEventShapeEntity(in ShapeId shapeId, in b8 topoTrusted)const{
        if(!shapeId.valid())
            return s_InvalidEntityId;
        if(topoTrusted){
            if(shapeId.index < cast<u32>(this.m_shapeIndexToEntity.size())){
                in EcsSlotOwner owner = this.m_shapeIndexToEntity[shapeId.index];
                if(owner.entity.valid() && owner.generation == shapeId.generation)
                    return owner.entity;
            }
            if(!this.m_syncScratch.destroyedShapeOwners.empty()){
                const auto found = this.m_syncScratch.destroyedShapeOwners.find(PackEcsSlotKey(shapeId.index, shapeId.generation));
                if(found != this.m_syncScratch.destroyedShapeOwners.end())
                    return found.value();
            }
            return s_InvalidEntityId;
        }
        return this.entityForShapeIncludingDestroyed(shapeId);
    }

    private void ensureEcsFrameEventsPopulated(){
        if(this.m_ecsEventsPopulated)
            return;
        this.m_ecsEventsPopulated = true;
        this.populateEcsFrameEvents();
    }

    private void populateEcsFrameEvents(){
        const b8 topoTrusted = (this.m_physicsWorld.m_topologyVersion == this.m_lastStepTopologyVersion);
        const Span<BodyMoveEvent> moves = this.bodyMoveEvents();
        if(!moves.empty()){
            this.m_ecsBodyMoveEvents.reserve(moves.size());
            for(usize i = 0u; i < moves.size(); ++i){
                EcsBodyMoveEvent ev;
                ev.event = moves[i];
                ev.entity = this.resolveEcsEventBodyEntity(moves[i].bodyId, topoTrusted);
                this.m_ecsBodyMoveEvents.push_back(ev);
            }
        }

        const Span<ContactBeginTouchEvent> cBegins = this.contactBeginEvents();
        if(!cBegins.empty()){
            this.m_ecsContactBeginEvents.reserve(cBegins.size());
            for(usize i = 0u; i < cBegins.size(); ++i){
                EcsContactBeginEvent ev;
                ev.event = cBegins[i];
                ev.entityA = this.resolveEcsEventShapeEntity(cBegins[i].shapeIdA, topoTrusted);
                ev.entityB = this.resolveEcsEventShapeEntity(cBegins[i].shapeIdB, topoTrusted);
                this.m_ecsContactBeginEvents.push_back(ev);
            }
        }

        const Span<ContactEndTouchEvent> cEnds = this.contactEndEvents();
        if(!cEnds.empty()){
            this.m_ecsContactEndEvents.reserve(cEnds.size());
            for(usize i = 0u; i < cEnds.size(); ++i){
                EcsContactEndEvent ev;
                ev.event = cEnds[i];
                ev.entityA = this.resolveEcsEventShapeEntity(cEnds[i].shapeIdA, topoTrusted);
                ev.entityB = this.resolveEcsEventShapeEntity(cEnds[i].shapeIdB, topoTrusted);
                this.m_ecsContactEndEvents.push_back(ev);
            }
        }

        const Span<ContactPersistEvent> cPersists = this.contactPersistEvents();
        if(!cPersists.empty()){
            this.m_ecsContactPersistEvents.reserve(cPersists.size());
            for(usize i = 0u; i < cPersists.size(); ++i){
                EcsContactPersistEvent ev;
                ev.event = cPersists[i];
                ev.entityA = this.resolveEcsEventShapeEntity(cPersists[i].shapeIdA, topoTrusted);
                ev.entityB = this.resolveEcsEventShapeEntity(cPersists[i].shapeIdB, topoTrusted);
                this.m_ecsContactPersistEvents.push_back(ev);
            }
        }

        const Span<ContactHitEvent> cHits = this.contactHitEvents();
        if(!cHits.empty()){
            this.m_ecsContactHitEvents.reserve(cHits.size());
            for(usize i = 0u; i < cHits.size(); ++i){
                EcsContactHitEvent ev;
                ev.event = cHits[i];
                ev.entityA = this.resolveEcsEventShapeEntity(cHits[i].shapeIdA, topoTrusted);
                ev.entityB = this.resolveEcsEventShapeEntity(cHits[i].shapeIdB, topoTrusted);
                this.m_ecsContactHitEvents.push_back(ev);
            }
        }

        const Span<SensorBeginTouchEvent> sBegins = this.sensorBeginEvents();
        if(!sBegins.empty()){
            this.m_ecsSensorBeginEvents.reserve(sBegins.size());
            for(usize i = 0u; i < sBegins.size(); ++i){
                EcsSensorBeginEvent ev;
                ev.event = sBegins[i];
                ev.sensorEntity = this.resolveEcsEventShapeEntity(sBegins[i].sensorShapeId, topoTrusted);
                ev.visitorEntity = this.resolveEcsEventShapeEntity(sBegins[i].visitorShapeId, topoTrusted);
                this.m_ecsSensorBeginEvents.push_back(ev);
            }
        }

        const Span<SensorEndTouchEvent> sEnds = this.sensorEndEvents();
        if(!sEnds.empty()){
            this.m_ecsSensorEndEvents.reserve(sEnds.size());
            for(usize i = 0u; i < sEnds.size(); ++i){
                EcsSensorEndEvent ev;
                ev.event = sEnds[i];
                ev.sensorEntity = this.resolveEcsEventShapeEntity(sEnds[i].sensorShapeId, topoTrusted);
                ev.visitorEntity = this.resolveEcsEventShapeEntity(sEnds[i].visitorShapeId, topoTrusted);
                this.m_ecsSensorEndEvents.push_back(ev);
            }
        }

        const Span<SensorStayEvent> sStays = this.sensorStayEvents();
        if(!sStays.empty()){
            this.m_ecsSensorStayEvents.reserve(sStays.size());
            for(usize i = 0u; i < sStays.size(); ++i){
                EcsSensorStayEvent ev;
                ev.event = sStays[i];
                ev.sensorEntity = this.resolveEcsEventShapeEntity(sStays[i].sensorShapeId, topoTrusted);
                ev.visitorEntity = this.resolveEcsEventShapeEntity(sStays[i].visitorShapeId, topoTrusted);
                this.m_ecsSensorStayEvents.push_back(ev);
            }
        }

        const Span<BodyWakeEvent> bWakes = this.bodyWakeEvents();
        if(!bWakes.empty()){
            this.m_ecsBodyWakeEvents.reserve(bWakes.size());
            for(usize i = 0u; i < bWakes.size(); ++i){
                EcsBodyWakeEvent ev;
                ev.event = bWakes[i];
                ev.entity = this.resolveEcsEventBodyEntity(bWakes[i].bodyId, topoTrusted);
                this.m_ecsBodyWakeEvents.push_back(ev);
            }
        }

        const Span<JointBreakEvent> jBreaks = this.jointBreakEvents();
        if(!jBreaks.empty()){
            this.m_ecsJointBreakEvents.reserve(jBreaks.size());
            for(usize i = 0u; i < jBreaks.size(); ++i){
                EcsJointBreakEvent ev;
                ev.event = jBreaks[i];
                ev.entity = this.entityForJoint(jBreaks[i].jointId);
                ev.entityA = this.resolveEcsEventBodyEntity(jBreaks[i].bodyIdA, topoTrusted);
                ev.entityB = this.resolveEcsEventBodyEntity(jBreaks[i].bodyIdB, topoTrusted);
                this.m_ecsJointBreakEvents.push_back(ev);
            }
        }
    }

    public mut PhysicsWorld physicsWorld(){ return this.m_physicsWorld; }
    public in PhysicsWorld physicsWorld()const{ return this.m_physicsWorld; }
    public in WorldStepStats lastStepStats()const{ return this.m_lastStepStats; }
    public f64 lastStepMs()const{ return this.m_lastStepMs; }
    public f32 interpolationAlpha()const{ return this.m_interpolationAlpha; }
    public Span<BodyMoveEvent> bodyMoveEvents()const{
        if(this.m_useDirectWorldEvents)
            return this.m_physicsWorld.bodyMoveEvents();
        return this.m_frameBodyMoveEvents;
    }

    public Span<ContactBeginTouchEvent> contactBeginEvents()const{
        if(this.m_useDirectWorldEvents)
            return this.m_physicsWorld.contactBeginEvents();
        return this.m_frameContactBeginEvents;
    }

    public Span<ContactEndTouchEvent> contactEndEvents()const{
        if(this.m_useDirectWorldEvents)
            return this.m_physicsWorld.contactEndEvents();
        return this.m_frameContactEndEvents;
    }

    public Span<ContactPersistEvent> contactPersistEvents()const{
        if(this.m_useDirectWorldEvents)
            return this.m_physicsWorld.contactPersistEvents();
        return this.m_frameContactPersistEvents;
    }

    public Span<ContactHitEvent> contactHitEvents()const{
        if(this.m_useDirectWorldEvents)
            return this.m_physicsWorld.contactHitEvents();
        return this.m_frameContactHitEvents;
    }

    public Span<SensorBeginTouchEvent> sensorBeginEvents()const{
        if(this.m_useDirectWorldEvents)
            return this.m_physicsWorld.sensorBeginEvents();
        return this.m_frameSensorBeginEvents;
    }

    public Span<SensorEndTouchEvent> sensorEndEvents()const{
        if(this.m_useDirectWorldEvents)
            return this.m_physicsWorld.sensorEndEvents();
