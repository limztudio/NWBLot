#include <impl/ecs_render/shared/frame_push_constants.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Name s_FrameGraphNameEcsRenderFrame = "ecs_render/frame";
const Name s_FrameGraphNameEcsRenderFrameSetup = "ecs_render/frame_setup";
const Name s_FrameGraphNameEcsRenderDeferredTargets = "ecs_render/deferred_targets";
const Name s_FrameGraphNameEcsRenderMeshViewBuffer = "ecs_render/mesh_view_buffer";
const Name s_FrameGraphNameEcsRenderSceneShadingBuffer = "ecs_render/scene_shading_buffer";
const Name s_FrameGraphNameEcsRenderMaterialDrawBuffers = "ecs_render/material_draw_buffers";
const Name s_FrameGraphNameEcsRenderCsgIntervalTargets = "ecs_render/csg_interval_targets";
const Name s_FrameGraphNameEcsRenderAvboitTargets = "ecs_render/avboit_targets";

// Hashes the immutable upload payload, including edits and light order.
u64 ComputeSceneLightingContentHash(in SceneShadingGpuData shading, in Span<SceneLightGpuData> lights){
    const u32 lightCount = cast<u32>(lights.size());
    usize seed = HashValue(lightCount);
    HashCombineF32x4(VectorSingle(shading.cameraPositionLightCount), seed);
    for(usize i = 0u; i < lights.size(); ++i){
        HashCombineF32x4(VectorSingle(lights[i].position), seed);
        HashCombineF32x4(VectorSingle(lights[i].direction), seed);
        HashCombineF32x4(VectorSingle(lights[i].colorIntensity), seed);
        HashCombineF32x4(VectorSingle(lights[i].params), seed);
        HashCombineF32x4(VectorSingle(lights[i].params2), seed);
    }
    return cast<u64>(seed);
}

b8 IsSupportedSharedComputeEmulationDrawCount(in usize drawCount){
    return drawCount >= s_SharedComputeEmulationMinimumDrawCount && drawCount <= s_SharedComputeEmulationMaximumDrawCount;
}

usize SharedComputeEmulationPhaseCountForDrawCount(in usize drawCount){
    return drawCount * s_SharedComputeEmulationPhasesPerDraw;
}

b8 IsSupportedSharedComputeEmulationPhaseCount(in usize phaseCount){
    return phaseCount >= s_SharedComputeEmulationMinimumDrawCount * s_SharedComputeEmulationPhasesPerDraw && phaseCount <= s_SharedComputeEmulationMaximumPhaseCount && (phaseCount % s_SharedComputeEmulationPhasesPerDraw) == 0u;
}

b8 FrameSetupReady(in b8 meshViewSetupReady, in b8 sceneShadingSetupReady){
    return meshViewSetupReady && sceneShadingSetupReady;
}

MeshFrameHeapSlots MakeMeshFrameHeapSlots(in u32 instance, in u32 materialTyped, in u32 view, in u32 generatedVertex){
    MeshFrameHeapSlots slots;
    slots.instance = instance;
    slots.materialTyped = materialTyped;
    slots.view = view;
    slots.generatedVertex = generatedVertex;
    return slots;
}

ShaderDrivenPushConstants ResolveShaderDrivenPushConstants(
    in u32 meshletCount,
    in u32 instanceIndex,
    in u32 materialConstantByteOffset,
    in b8 hasViewport,
    in VectorSingle viewportRect,
    in VectorSingle scissorRect,
    in MeshFrameHeapSlots frameHeapSlots,
    in u32 dispatchFlags
){
    ShaderDrivenPushConstants pushConstants;
    pushConstants.meshletCount = meshletCount;
    pushConstants.instanceIndex = instanceIndex;
    pushConstants.materialConstantByteOffset = materialConstantByteOffset;
    pushConstants.dispatchFlags = dispatchFlags;
    pushConstants.frameHeapSlots = frameHeapSlots;
    if(!hasViewport)
        return pushConstants;

    pushConstants.dispatchFlags |= (1u << 0u);
    pushConstants.viewportRect = f32x4(viewportRect);
    pushConstants.scissorRect = f32x4(scissorRect);
    return pushConstants;
}

TransparentDrawPushConstants ResolveTransparentDrawPushConstants(
    in ShaderDrivenPushConstants meshPushConstants,
    in RendererAvboitPushConstants avboitPushConstants,
    in u32 csgContextHeapSlot,
    in b8 refractionCapture
){
    TransparentDrawPushConstants pushConstants;
    pushConstants.mesh = meshPushConstants;
    pushConstants.avboit = avboitPushConstants;
    pushConstants.avboit.heapSlots[1u] = csgContextHeapSlot;
    if(refractionCapture){
        pushConstants.avboit.params = f32x4(
            pushConstants.avboit.params.x,
            pushConstants.avboit.params.y,
            pushConstants.avboit.params.z,
            s_AvboitRefractionCapture
        );
    }
    return pushConstants;
}

f32 SceneLightRadiantImportance(in VectorSingle colorIntensity){
    const f32 luminance = Dot(colorIntensity, VectorSingle(0.2126f, 0.7152f, 0.0722f, 0.0f));
    const f32 intensity = Max(colorIntensity.w, 0.0f);
    return luminance * intensity;
}

SceneShadingGpuData MakeSceneShadingGpuData(in VectorSingle cameraPosition, in u32 lightCount){
    SceneShadingGpuData state;
    state.cameraPositionLightCount = f32x4(cameraPosition, cast<f32>(lightCount));
    return state;
}

SceneLightGpuData MakeSceneLightGpuData(
    in VectorSingle position,
    in VectorSingle direction,
    in VectorSingle colorIntensity,
    in f32 range,
    in f32 lightType,
    in f32 shadowSlot,
    in f32 causticSlot,
    in f32 angularRadius,
    in f32 sourceRadius
){
    SceneLightGpuData dst;
    dst.position = f32x4(position);
    dst.direction = f32x4(direction);
    dst.colorIntensity = f32x4(colorIntensity);
    dst.params = f32x4(range, lightType, shadowSlot, causticSlot);
    dst.params2 = f32x4(angularRadius, sourceRadius, 0.0f, 0.0f);
    return dst;
}

b8 CanAcceptMeshFrameBindingCapacities(
    in b8 bindingValid,
    in usize instanceBufferCapacity,
    in usize materialTypedBufferCapacity,
    in usize instanceCount,
    in usize materialTypedByteCount
){
    if(materialTypedByteCount == 0u || (materialTypedByteCount & 3u) != 0u)
        return false;
    return bindingValid && instanceBufferCapacity >= instanceCount && materialTypedBufferCapacity >= materialTypedByteCount;
}

RendererTaskTimingFeedbackCollectionAction ResolveRendererTaskTimingFeedbackCollectionAction(
    in b8 rendererActive,
    in b8 currentEnabled,
    in b8 requestedEnabled
){
    if(!rendererActive || currentEnabled == requestedEnabled)
        return RendererTaskTimingFeedbackCollectionAction::None;
    if(requestedEnabled)
        return RendererTaskTimingFeedbackCollectionAction::Enable;
    return RendererTaskTimingFeedbackCollectionAction::Disable;
}

b8 IsValidRendererTaskTimingSampleDuration(in f64 durationSeconds){
    return IsFinite(durationSeconds) && durationSeconds > 0.0 && durationSeconds < f64.max;
}

b8 ContainsRendererTaskTimingFeedbackScope(in Span<Name> scopes, in Name scopeName){
    for(in Name scope : scopes){
        if(scope == scopeName)
            return true;
    }
    return false;
}

b8 IsValidCompletedRendererTaskTimingSample(
    in b8 feedbackActive,
    in b8 published,
    in Name sampleScopeName,
    in Name expectedScopeName,
    in u64 sampleSourceFrameIndex,
    in u64 expectedSourceFrameIndex,
    in b8 queueMatches,
    in f64 durationSeconds
){
    return feedbackActive
        && published
        && sampleScopeName == expectedScopeName
        && sampleSourceFrameIndex == expectedSourceFrameIndex
        && queueMatches
        && IsValidRendererTaskTimingSampleDuration(durationSeconds);
}

StringView ResolveTelemetryPhysicalQueueClassLabel(in u8 queueClassValue){
    if(queueClassValue == 0u)
        return s_GraphicsQueueLabel;
    if(queueClassValue == 1u)
        return s_ComputeQueueLabel;
    if(queueClassValue == 2u)
        return s_TransferQueueLabel;
    return s_UnknownStageLabel;
}

StringView ResolveTelemetryOwnershipTransferRouteLabel(in u8 routeValue){
    if(routeValue == 0u)
        return s_InternalRouteLabel;
    if(routeValue == 1u)
        return s_ExternalImportRouteLabel;
    if(routeValue == 2u)
        return s_ExternalExportRouteLabel;
    return s_UnknownStageLabel;
}

StringView ResolveTelemetryResourceQueueSharingLabel(in u8 queueSharingValue){
    if(queueSharingValue == 0u)
        return s_ExclusiveSharingLabel;
    if(queueSharingValue == 1u)
        return s_GraphicsQueueLabel;
    if(queueSharingValue == 2u)
        return s_AsyncComputeSharingLabel;
    if(queueSharingValue == 4u)
        return s_TransferQueueLabel;
    if(queueSharingValue == 3u)
        return s_GraphicsAndAsyncComputeSharingLabel;
    if(queueSharingValue == 5u)
        return s_GraphicsAndTransferSharingLabel;
    if(queueSharingValue == 6u)
        return s_AsyncComputeAndTransferSharingLabel;
    if(queueSharingValue == 7u)
        return s_GraphicsAsyncComputeAndTransferSharingLabel;
    return s_UnknownStageLabel;
}


