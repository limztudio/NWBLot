////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/csg/cutter_gpu_data.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CsgWorkRect{
    public CsgWorkRect(){
        this.minX = 0;
        this.maxX = 0;
        this.minY = 0;
        this.maxY = 0;
    }

    public CsgWorkRect(in i32 inMinX, in i32 inMaxX, in i32 inMinY, in i32 inMaxY){
        this.minX = inMinX;
        this.maxX = inMaxX;
        this.minY = inMinY;
        this.maxY = inMaxY;
    }

    public i32 width()const{
        return this.maxX - this.minX;
    }

    public i32 height()const{
        return this.maxY - this.minY;
    }

    public i32 minX;
    public i32 maxX;
    public i32 minY;
    public i32 maxY;
}

class CsgFrameWorkRegion{
    public b8 bounded()const{
        return !this.fullFrame && this.minX < this.maxX && this.minY < this.maxY;
    }

    public b8 valid()const{
        return this.fullFrame || this.bounded();
    }

    public u32 width()const{
        if(this.bounded())
            return this.maxX - this.minX;
        return 0u;
    }

    public u32 height()const{
        if(this.bounded())
            return this.maxY - this.minY;
        return 0u;
    }

    public void expandFull(){
        this.fullFrame = true;
    }

    public void expandClamped(in i32 rectMinX, in i32 rectMaxX, in i32 rectMinY, in i32 rectMaxY, in u32 frameWidth, in u32 frameHeight){
        if(this.fullFrame || frameWidth == 0u || frameHeight == 0u)
            return;

        const i32 maxExtentX = cast<i32>(frameWidth);
        const i32 maxExtentY = cast<i32>(frameHeight);
        const i32 clampedMinX = Max(Min(rectMinX, maxExtentX), 0);
        const i32 clampedMaxX = Max(Min(rectMaxX, maxExtentX), 0);
        const i32 clampedMinY = Max(Min(rectMinY, maxExtentY), 0);
        const i32 clampedMaxY = Max(Min(rectMaxY, maxExtentY), 0);
        if(clampedMinX >= clampedMaxX || clampedMinY >= clampedMaxY)
            return;

        this.minX = Min(this.minX, cast<u32>(clampedMinX));
        this.minY = Min(this.minY, cast<u32>(clampedMinY));
        this.maxX = Max(this.maxX, cast<u32>(clampedMaxX));
        this.maxY = Max(this.maxY, cast<u32>(clampedMaxY));
    }

    public void expandWorldBounds(in MatrixSingle worldToClip, in VectorSingle minBounds, in VectorSingle maxBounds, in u32 frameWidth, in u32 frameHeight){
        if(
            frameWidth == 0u || frameHeight == 0u
            || !IsFinite(minBounds.x) || !IsFinite(minBounds.y) || !IsFinite(minBounds.z)
            || !IsFinite(maxBounds.x) || !IsFinite(maxBounds.y) || !IsFinite(maxBounds.z)
            || minBounds.x > maxBounds.x || minBounds.y > maxBounds.y || minBounds.z > maxBounds.z
        ){
            this.expandFull();
            return;
        }

        const f32 widthFloat = cast<f32>(frameWidth);
        const f32 heightFloat = cast<f32>(frameHeight);
        f32 minPixelX = widthFloat;
        f32 minPixelY = heightFloat;
        f32 maxPixelX = 0.0f;
        f32 maxPixelY = 0.0f;
        for(u32 corner = 0u; corner < s_BoxCornerCount; ++corner){
            f32 wx = minBounds.x;
            if((corner & 1u) != 0u)
                wx = maxBounds.x;
            f32 wy = minBounds.y;
            if(((corner >> 1u) & 1u) != 0u)
                wy = maxBounds.y;
            f32 wz = minBounds.z;
            if(((corner >> 2u) & 1u) != 0u)
                wz = maxBounds.z;
            const VectorSingle worldPosition(wx, wy, wz, 1.0f);
            const VectorSingle clipPosition = Mul(worldPosition, worldToClip);
            const f32 clipW = clipPosition.w;
            if(!IsFinite(clipW) || clipW <= s_MinClipWForWorkRegion){
                this.expandFull();
                return;
            }

            const f32 ndcX = clipPosition.x / clipW;
            const f32 ndcY = clipPosition.y / clipW;
            if(!IsFinite(ndcX) || !IsFinite(ndcY)){
                this.expandFull();
                return;
            }

            const f32 normX = ndcX * 0.5f + 0.5f;
            const f32 normY = 1.0f - (ndcY * 0.5f + 0.5f);
            const f32 pixelX = normX * widthFloat;
            const f32 pixelY = normY * heightFloat;
            if(!IsFinite(pixelX) || !IsFinite(pixelY)){
                this.expandFull();
                return;
            }
            minPixelX = Min(minPixelX, pixelX);
            minPixelY = Min(minPixelY, pixelY);
            maxPixelX = Max(maxPixelX, pixelX);
            maxPixelY = Max(maxPixelY, pixelY);
        }

        if(maxPixelX < 0.0f || maxPixelY < 0.0f || minPixelX > widthFloat || minPixelY > heightFloat)
            return;

        const f32 workMinX = Max(minPixelX, 0.0f);
        const f32 workMinY = Max(minPixelY, 0.0f);
        const f32 workMaxX = Min(maxPixelX, widthFloat);
        const f32 workMaxY = Min(maxPixelY, heightFloat);
        const i32 paddedMinX = cast<i32>(Floor(workMinX)) - s_WorkRegionPixelPadding;
        const i32 paddedMaxX = cast<i32>(Ceil(workMaxX)) + s_WorkRegionPixelPadding;
        const i32 paddedMinY = cast<i32>(Floor(workMinY)) - s_WorkRegionPixelPadding;
        const i32 paddedMaxY = cast<i32>(Ceil(workMaxY)) + s_WorkRegionPixelPadding;
        this.expandClamped(paddedMinX, paddedMaxX, paddedMinY, paddedMaxY, frameWidth, frameHeight);
    }

    public CsgWorkRect resolveRect(in u32 frameWidth, in u32 frameHeight)const{
        if(!this.bounded())
            return CsgWorkRect(0, cast<i32>(frameWidth), 0, cast<i32>(frameHeight));

        const u32 resolvedMaxX = Min(this.maxX, frameWidth);
        const u32 resolvedMaxY = Min(this.maxY, frameHeight);
        return CsgWorkRect(cast<i32>(this.minX), cast<i32>(resolvedMaxX), cast<i32>(this.minY), cast<i32>(resolvedMaxY));
    }

    public u32 minX = u32.max;
    public u32 minY = u32.max;
    public u32 maxX = 0u;
    public u32 maxY = 0u;
    public b8 fullFrame = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

