////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/material/instance_typed_ranges.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type MaterialTypedConstantRangeMap = HashMap<MaterialTypedByteRangeKey, MaterialTypedByteRange>;
type MaterialTypedInstanceRangeVector = Vector<MaterialTypedInstanceRanges>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MaterialTypedByteBucket{
    public u64 byteHash;
    public usize byteCount;
    public MaterialTypedByteBucket(in MaterialTypedByteContentLookup lookup){
        this.byteHash = lookup.byteHash;
        this.byteCount = lookup.bytes.size();
    }
    public usize hash()const{ return HashMaterialTypedByteContent(this.byteHash, this.byteCount); }
    public b8 operator==(in MaterialTypedByteBucket other)const{
        return this.byteHash == other.byteHash && this.byteCount == other.byteCount;
    }
}

class MaterialTypedByteEntry{
    public usize storageOffset = 0u;
    public usize storageSize = 0u;
    public MaterialTypedByteRange range;
    public usize next = usize.max;
}

class PendingMaterialTypedByteEntry : NoCopy{
    private mut Vector<MaterialTypedByteEntry> m_entries;
    private mut Vector<u8> m_storage;
    private usize m_originalSize;
    private usize m_originalStorageSize;
    private b8 m_committed = false;

    public PendingMaterialTypedByteEntry(mut Vector<MaterialTypedByteEntry> entries, mut Vector<u8> storage){
        this.m_entries = entries;
        this.m_storage = storage;
        this.m_originalSize = entries.size();
        this.m_originalStorageSize = storage.size();
    }
    public void commit(){ this.m_committed = true; }
    public ~PendingMaterialTypedByteEntry(){
        if(!this.m_committed){
            if(this.m_entries.size() > this.m_originalSize)
                this.m_entries.resize(this.m_originalSize);
            if(this.m_storage.size() > this.m_originalStorageSize)
                this.m_storage.resize(this.m_originalStorageSize);
        }
    }
}

class MaterialTypedByteContentRangeMap : NoCopy{
    private HashMap<MaterialTypedByteBucket, usize> m_heads;
    private Vector<MaterialTypedByteEntry> m_entries;
    private Vector<u8> m_storage;

    private Span<u8> entrySpan(in MaterialTypedByteEntry entry)const{
        return Span<u8>(this.m_storage).subspan(entry.storageOffset, entry.storageSize);
    }

    private Optional<MaterialTypedByteRange> findInChain(in usize headIndex, in MaterialTypedByteContentLookup lookup)const{
        usize chainIndex = headIndex;
        while(chainIndex != usize.max){
            in MaterialTypedByteEntry existing = this.m_entries[chainIndex];
            if(EqualMaterialTypedByteContent(lookup.byteHash, this.entrySpan(existing), lookup.byteHash, lookup.bytes))
                return Optional<MaterialTypedByteRange>(existing.range);
            chainIndex = existing.next;
        }
        return Optional<MaterialTypedByteRange>();
    }

    [cpp_unwind]
    private mut MaterialTypedByteEntry copyBytes(in Span<u8> bytes){
        const usize index = this.m_entries.size();
        const usize storageOffset = this.m_storage.size();
        AppendTriviallyCopyableVector(this.m_storage, bytes);
        MaterialTypedByteEntry entry;
        entry.storageOffset = storageOffset;
        entry.storageSize = bytes.size();
        this.m_entries.push_back(entry);
        return this.m_entries[index];
    }

    public usize size()const{ return this.m_entries.size(); }
    [cpp_unwind]
    public void reserve(in usize count){
        this.m_heads.reserve(count);
        this.m_entries.reserve(count);
    }

    public void clear(){
        this.m_heads.clear();
        this.m_entries.clear();
        this.m_storage.clear();
    }

    public Optional<MaterialTypedByteRange> find(in MaterialTypedByteContentLookup lookup)const{
        const auto head = this.m_heads.find(MaterialTypedByteBucket(lookup));
        if(head != this.m_heads.end())
            return this.findInChain(head.value(), lookup);
        return Optional<MaterialTypedByteRange>();
    }

    [cpp_unwind]
    public b8 insert(in MaterialTypedByteContentLookup lookup, in MaterialTypedByteRange range){
        const auto head = this.m_heads.try_emplace(MaterialTypedByteBucket(lookup), usize.max);
        if(!head.second && this.findInChain(head.first.value(), lookup).has_value())
            return false;
        PendingMaterialTypedByteEntry pending(this.m_entries, this.m_storage);
        const usize index = this.m_entries.size();
        mut MaterialTypedByteEntry entry = this.copyBytes(lookup.bytes);
        entry.next = head.first.value();
        entry.range = range;
        head.first.value() = index;
        pending.commit();
        return true;
    }

    [cpp_unwind]
    public Expected<MaterialTypedByteRange> findOrAppend(in Span<u8> bytes, mut Vector<u8> upload){
        if(bytes.empty())
            return MaterialTypedByteRange();
        const MaterialTypedByteContentLookup lookup(HashMaterialTypedBytesFast(bytes), bytes);
        const auto head = this.m_heads.try_emplace(MaterialTypedByteBucket(lookup), usize.max);
        if(!head.second){
            const Optional<MaterialTypedByteRange> found = this.findInChain(head.first.value(), lookup);
            if(found.has_value())
                return found.value();
        }

        PendingMaterialTypedByteEntry pending(this.m_entries, this.m_storage);
        const usize index = this.m_entries.size();
        mut MaterialTypedByteEntry entry = this.copyBytes(bytes);
        const auto range = AppendMaterialTypedByteRange(this.entrySpan(entry), upload);
        if(!range.has_value()){
            if(head.second)
                this.m_heads.erase(head.first);
            return MakeUnexpected(Failure());
        }
        entry.next = head.first.value();
        entry.range = range.value();
        head.first.value() = index;
        pending.commit();
        return range;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u64 HashMaterialTypedBytesFast(in Span<u8> bytes){
    const usize count = bytes.size();
    u64 hash = 0x9e3779b97f4a7c15u ^ cast<u64>(count);
    usize offset = 0u;
    while(offset + 8u <= count){
        const u64 word =
            cast<u64>(bytes[offset + 0u])
            | (cast<u64>(bytes[offset + 1u]) << 8u)
            | (cast<u64>(bytes[offset + 2u]) << 16u)
            | (cast<u64>(bytes[offset + 3u]) << 24u)
            | (cast<u64>(bytes[offset + 4u]) << 32u)
            | (cast<u64>(bytes[offset + 5u]) << 40u)
            | (cast<u64>(bytes[offset + 6u]) << 48u)
            | (cast<u64>(bytes[offset + 7u]) << 56u);
        hash ^= word * 0xbf58476d1ce4e5b9u;
        hash = ((hash << 27u) | (hash >> 37u)) * 0x94d049bb133111ebu;
        offset += 8u;
    }
    if(offset < count){
        u64 tail = 0u;
        u32 shift = 0u;
        while(offset < count){
            tail |= cast<u64>(bytes[offset]) << shift;
            shift += 8u;
            ++offset;
        }
        hash ^= tail * 0xbf58476d1ce4e5b9u;
        hash = ((hash << 27u) | (hash >> 37u)) * 0x94d049bb133111ebu;
    }
    hash ^= hash >> 30u;
    hash *= 0xbf58476d1ce4e5b9u;
    hash ^= hash >> 27u;
    hash *= 0x94d049bb133111ebu;
    hash ^= hash >> 31u;
    return hash;
}

[cpp_unwind]
Expected<MaterialTypedByteRange> FindOrAppendMaterialConstantTypedByteRange(
    in Name materialName,
    in u64 typedLayoutHash,
    in Span<u8> bytes,
    mut Vector<u8> upload,
    mut MaterialTypedConstantRangeMap ranges
){
    MaterialTypedByteRangeKey key;
    key.materialName = materialName;
    key.typedLayoutHash = typedLayoutHash;
    const auto found = ranges.find(key);
    if(found != ranges.end())
        return found.value();
    const auto range = AppendMaterialTypedByteRange(bytes, upload);
    if(!range.has_value())
        return MakeUnexpected(Failure());
    if(!ranges.try_emplace(key, range.value()).second){
        assert(false);
        return MakeUnexpected(Failure());
    }
    return range;
}


