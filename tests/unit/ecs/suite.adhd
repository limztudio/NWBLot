[arena, system("counting")]
class CountingSystem{
    public u32 prepares = 0u;
    public u32 updates = 0u;
    public f32 lastDelta = 0.0f;

    public CountingSystem(){
        this.writeAccess<PositionComponent>();
    }

    public void prepare(mut World world){
        ++this.prepares;
    }

    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta){
        ++this.updates;
        this.lastDelta = delta;

        world.view<PositionComponent>().each(
            lambda[](in EntityID entityId, mut PositionComponent position) -> void{
                if(!entityId.valid() && position.x == i32.min)
                    return;
                ++position.x;
            }
        );
        return Expected<void, CpuTaskAdmissionError>();
    }
}

[arena, system("scheduled")]
class ScheduledSystem{
    private Func<void()> m_update;
    private CpuTaskOptions m_options;

    public ScheduledSystem(in Func<void()> update){
        this.m_update = update;
        this.m_options = CpuTaskOptions();
    }

    public ScheduledSystem(in ComponentTypeId typeId, in AccessMode mode, in Func<void()> update){
        this.m_update = update;
        this.m_options = CpuTaskOptions();
        this.registerAccess(typeId, mode);
    }

    public ScheduledSystem(in ComponentTypeId typeId, in AccessMode mode, in Func<void()> update, in CpuTaskOptions options){
        this.m_update = update;
        this.m_options = options;
        this.registerAccess(typeId, mode);
    }

    public ScheduledSystem(
        in ComponentTypeId firstTypeId,
        in AccessMode firstMode,
        in ComponentTypeId secondTypeId,
        in AccessMode secondMode,
        in Func<void()> update
    ){
        this.m_update = update;
        this.m_options = CpuTaskOptions();
        this.registerAccess(firstTypeId, firstMode);
        this.registerAccess(secondTypeId, secondMode);
    }

    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta){
        this.m_update();
        return Expected<void, CpuTaskAdmissionError>();
    }

    public CpuTaskOptions taskOptions()const{
        return this.m_options;
    }
}

[arena, system("rejecting_range")]
class RejectingRangeSystem{
    public u32 callbacks = 0u;

    public RejectingRangeSystem(){
        this.writeAccess<PositionComponent>();
    }

    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta){
        return world.taskScope().parallelFor(
            cast<usize>(0u),
            cast<usize>(1u),
            1u,
            lambda[mut this](in usize index) -> void{
                if(index == usize.max)
                    return;
                ++this.callbacks;
            },
            InvalidTargetTaskOptions()
        );
    }
}

[arena, system("lifetime")]
class LifetimeSystem{
    private mut SystemLifetimeState m_state;
    private b8 m_isProvider;

    public LifetimeSystem(mut SystemLifetimeState state, in b8 isProvider){
        this.m_state = state;
        this.m_isProvider = isProvider;
        if(this.m_isProvider)
            this.m_state.providerAlive = true;
    }

    public ~LifetimeSystem(){
        if(this.m_isProvider){
            this.m_state.providerAlive = false;
            this.m_state.destructionOrder[this.m_state.destructionCount] = 1u;
        }
        else{
            this.m_state.borrowerObservedProvider = this.m_state.providerAlive;
            this.m_state.destructionOrder[this.m_state.destructionCount] = 2u;
        }
        ++this.m_state.destructionCount;
    }

    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta){
        return Expected<void, CpuTaskAdmissionError>();
    }
}

b8 HasTryPositionComponent(mut World world, in EntityID entityId){
    return HasTryComponent<PositionComponent>(world, entityId);
}

b8 HasTryPoolSlot63Component(mut World world, in EntityID entityId){
    return HasTryComponent<PoolSlotComponent<63>>(world, entityId);
}

void RegisterScheduledSystem(mut SystemScheduler scheduler, mut ScheduledSystem system){
    scheduler.addSystem(system);
}

void VerifyEcs_ParallelEachNestedInTaskBatchCompletes(){
    GlobalArena arena(s_EcsTestParallelArenaName);
    CpuTaskScheduler taskScheduler(3u);
    World world(arena, taskScheduler);

    for(u32 i = 0u; i < s_EcsTestNestedEntityCount; ++i){
        const EntityID id = world.createEntity().id();
        world.entity(id).addComponent<PositionComponent>().x = cast<i32>(i);
    }

    Atomic<u32> visits(0u);
    const b8 outerParallelOk = world.taskScope().parallelFor(
        cast<usize>(0u),
        s_EcsTestNestedOuterCount,
        lambda[mut world, mut visits](in usize outerIndex) -> void{
            if(outerIndex == usize.max)
                return;
            const b8 innerParallelOk = world.view<PositionComponent>().parallelEach(
                world.taskScope(),
                1u,
                lambda[mut visits](in EntityID entityId, mut PositionComponent position) -> void{
                    if(!entityId.valid() && position.x == i32.min)
                        return;
                    visits.fetch_add(1u, MemoryOrder::relaxed);
                }
            ).has_value();
            EXPECT_TRUE(innerParallelOk);
        }
    ).has_value();
    EXPECT_TRUE(outerParallelOk);
    const u32 visitTotal = visits.load(MemoryOrder::relaxed);

    EXPECT_EQ(visitTotal, s_EcsTestNestedEntityCount * cast<u32>(s_EcsTestNestedOuterCount));
}

void VerifyEcs_DuplicateSchedulerAddIsStable(){
    EcsTestWorld testWorld = EcsTestWorld();
    const EntityID entity = testWorld.world.createEntity().id();
    mut PositionComponent position = testWorld.world.entity(entity).addComponent<PositionComponent>();
    position.x = 1;

    CountingSystem system = CountingSystem();
    EXPECT_EQ(CountingSystem::SystemTypeName(), Name("counting"));
    EXPECT_EQ(CountingSystem::s_SystemTypeName, Name("counting"));
    EXPECT_EQ(system.systemType(), Name("counting"));
    SystemScheduler scheduler(testWorld.arena);
    scheduler.addSystem(system);
    scheduler.addSystem(system);
    ASSERT_TRUE(scheduler.execute(testWorld.world, 0.5f).has_value());

    EXPECT_EQ(system.prepares, 1u);
    EXPECT_EQ(system.updates, 1u);
    EXPECT_EQ(position.x, 2);
}

void VerifyEcs_WorldTickPropagatesRangeRejectionAndSkipsDependentSystems(){
    EcsTestWorld testWorld = EcsTestWorld();
    u32 independentUpdates = 0u;
    u32 laterCallbacks = 0u;

    mut RejectingRangeSystem rejectedSystem = testWorld.world.addSystem<RejectingRangeSystem>();
    mut CountingSystem dependent = testWorld.world.addSystem<CountingSystem>();
    testWorld.world.addSystem<ScheduledSystem>(lambda[mut independentUpdates]() -> void{ ++independentUpdates; });
    const TickAdmissionResult updated = testWorld.world.tick(0.5f);
    ASSERT_FALSE(updated.has_value());
    EXPECT_EQ(updated.error(), CpuTaskAdmissionError::InvalidOptions);
    EXPECT_EQ(rejectedSystem.callbacks, 0u);
    EXPECT_EQ(dependent.prepares, 1u);
    EXPECT_EQ(dependent.updates, 0u);
    EXPECT_EQ(testWorld.taskScheduler.statistics().outstandingTasks, 0u);
    const TaskSubmitResult admitted = testWorld.taskScheduler.submit(lambda[mut laterCallbacks]() -> void{ ++laterCallbacks; });
    ASSERT_TRUE(admitted.has_value());
    testWorld.taskScheduler.wait(admitted.value());

    EXPECT_EQ(independentUpdates, 1u);
    EXPECT_EQ(laterCallbacks, 1u);
}

void VerifyEcs_SystemDependenciesPreserveRegistrationOrderAcrossComponents(){
    EcsTestWorld testWorld = EcsTestWorld();
    i32 position = 0;
    i32 velocity = 0;
    i32 observed = 0;

    const ComponentTypeId positionType = ComponentType<PositionComponent>();
    const ComponentTypeId velocityType = ComponentType<VelocityComponent>();

    ScheduledSystem writer(
        positionType,
        AccessMode::Write,
        lambda[mut position]() -> void{ position = 17; }
    );
    ScheduledSystem transfer(
        positionType,
        AccessMode::Read,
        velocityType,
        AccessMode::Write,
        lambda[mut position, mut velocity]() -> void{ velocity = position + 1; }
    );
    ScheduledSystem reader(
        velocityType,
        AccessMode::Read,
        lambda[mut velocity, mut observed]() -> void{ observed = velocity; }
    );

    SystemScheduler scheduler(testWorld.arena);
    RegisterScheduledSystem(scheduler, writer);
    RegisterScheduledSystem(scheduler, transfer);
    RegisterScheduledSystem(scheduler, reader);
    ASSERT_TRUE(scheduler.execute(testWorld.world, 0.0f).has_value());
    EXPECT_EQ(observed, 18);

    // Removing and adding a system invalidates the cached predecessor list.
    scheduler.removeSystem(transfer);
    velocity = 31;
    ASSERT_TRUE(scheduler.execute(testWorld.world, 0.0f).has_value());
    EXPECT_EQ(observed, 31);
    RegisterScheduledSystem(scheduler, transfer);
    velocity = 47;
    ASSERT_TRUE(scheduler.execute(testWorld.world, 0.0f).has_value());

    EXPECT_EQ(observed, 47);
    EXPECT_EQ(velocity, 18);
}

void VerifyEcs_SystemDependentsProceedWithoutWaitingForUnrelatedWork(){
    GlobalArena arena(s_EcsTestParallelArenaName);
    CpuTaskScheduler taskScheduler(3u);
    World world(arena, taskScheduler);

    const ComponentTypeId positionType = ComponentType<PositionComponent>();
    Atomic<b8> dependentCompleted(false);
    Atomic<b8> independentObservedCompletion(false);
    i32 value = 0;

    ScheduledSystem writer(
        positionType,
        AccessMode::Write,
        lambda[mut value]() -> void{ value = 5; }
    );
    ScheduledSystem independent(
        lambda[mut dependentCompleted, mut independentObservedCompletion]() -> void{
            const Timer begin = TimerNow();
            while(!dependentCompleted.load(MemoryOrder::acquire) && DurationInMS<u64>(TimerNow(), begin) < s_EcsTestSystemCompletionTimeoutMS)
                SleepMS(s_EcsTestPollIntervalMS);
            independentObservedCompletion.store(dependentCompleted.load(MemoryOrder::acquire), MemoryOrder::release);
        }
    );
    ScheduledSystem dependent(
        positionType,
        AccessMode::Read,
        lambda[mut value, mut dependentCompleted]() -> void{
            EXPECT_EQ(value, 5);
            dependentCompleted.store(true, MemoryOrder::release);
        }
    );

    SystemScheduler scheduler(arena);
    RegisterScheduledSystem(scheduler, writer);
    RegisterScheduledSystem(scheduler, independent);
    RegisterScheduledSystem(scheduler, dependent);
    ASSERT_TRUE(scheduler.execute(world, 0.0f).has_value());
    const b8 observedCompletion = independentObservedCompletion.load(MemoryOrder::acquire);

    EXPECT_TRUE(observedCompletion);
}

void VerifyEcs_MainThreadSystemRespectsWorkerDependencies(){
    GlobalArena arena(s_EcsTestParallelArenaName);
    CpuTaskScheduler taskScheduler(2u);
    World world(arena, taskScheduler);
    b8 executedOnCaller = false;

    const ComponentTypeId positionType = ComponentType<PositionComponent>();
    SetCallerThreadFlag(true);
    i32 value = 0;

    ScheduledSystem worker(
        positionType,
        AccessMode::Write,
        lambda[mut value]() -> void{ value = 23; }
    );
    ScheduledSystem caller(
        positionType,
        AccessMode::Write,
        lambda[mut executedOnCaller, mut value]() -> void{
            executedOnCaller = IsCallerThreadFlagSet();
            EXPECT_EQ(value, 23);
            value = 29;
        },
        MainThreadTaskOptions()
    );
    ScheduledSystem consumer(
        positionType,
        AccessMode::Read,
        lambda[mut value]() -> void{ EXPECT_EQ(value, 29); }
    );

    SystemScheduler scheduler(arena);
    RegisterScheduledSystem(scheduler, worker);
    RegisterScheduledSystem(scheduler, caller);
    RegisterScheduledSystem(scheduler, consumer);
    ASSERT_TRUE(scheduler.execute(world, 0.0f).has_value());
    SetCallerThreadFlag(false);

    EXPECT_TRUE(executedOnCaller);
}

void VerifyEcs_DependentSystemObservesAllNestedQueryTasks(){
    GlobalArena arena(s_EcsTestParallelArenaName);
    CpuTaskScheduler taskScheduler(2u);
    World world(arena, taskScheduler);
    for(usize i = 0u; i < s_EcsTestDependentQueryEntityCount; ++i)
        world.createEntity().addComponent<PositionComponent>().x = cast<i32>(i);
    usize observed = 0u;

    const ComponentTypeId positionType = ComponentType<PositionComponent>();

    ScheduledSystem writer(
        positionType,
        AccessMode::Write,
        lambda[mut world]() -> void{
            const b8 writerParallelOk = world.view<PositionComponent>().parallelEach(
                world.taskScope(),
                8u,
                lambda[](in EntityID entityId, mut PositionComponent position) -> void{
                    if(!entityId.valid() && position.x == i32.min)
                        return;
                    position.y = position.x + 1;
                }
            ).has_value();
            EXPECT_TRUE(writerParallelOk);
        }
    );
    ScheduledSystem reader(
        positionType,
        AccessMode::Read,
        lambda[mut world, mut observed]() -> void{
            world.view<PositionComponent>().each(
                lambda[mut observed](in EntityID entityId, mut PositionComponent position) -> void{
                    if(!entityId.valid() && position.x == i32.min)
                        return;
                    EXPECT_EQ(position.y, position.x + 1);
                    ++observed;
                }
            );
        }
    );

    SystemScheduler scheduler(arena);
    RegisterScheduledSystem(scheduler, writer);
    RegisterScheduledSystem(scheduler, reader);
    ASSERT_TRUE(scheduler.execute(world, 0.0f).has_value());

    EXPECT_EQ(observed, s_EcsTestDependentQueryEntityCount);
}

void VerifyEcs_SystemCompletionIncludesAsynchronousDescendants(){
    GlobalArena arena(s_EcsTestParallelArenaName);
    CpuTaskScheduler taskScheduler(2u);
    World world(arena, taskScheduler);
    i32 observed = 0;

    const ComponentTypeId positionType = ComponentType<PositionComponent>();
    Atomic<i32> value(0);

    ScheduledSystem writer(
        positionType,
        AccessMode::Write,
        lambda[mut world, mut value]() -> void{
            const TaskSubmitResult cpuTaskAdmission = world.taskScope().submit(
                lambda[mut world, mut value]() -> void{
                    SleepMS(s_EcsTestEntityWaitIntervalMS);
                    const TaskSubmitResult secondCpuTaskAdmission = world.taskScope().submit(
                        lambda[mut value]() -> void{ value.store(41, MemoryOrder::release); }
                    );
                    ASSERT_TRUE(secondCpuTaskAdmission.has_value());
                    EXPECT_TRUE(secondCpuTaskAdmission.value().valid());
                }
            );
            ASSERT_TRUE(cpuTaskAdmission.has_value());
            EXPECT_TRUE(cpuTaskAdmission.value().valid());
        }
    );
    ScheduledSystem reader(
        positionType,
        AccessMode::Read,
        lambda[mut value, mut observed]() -> void{
            observed = value.load(MemoryOrder::acquire);
        }
    );

    SystemScheduler scheduler(arena);
    RegisterScheduledSystem(scheduler, writer);
    RegisterScheduledSystem(scheduler, reader);
    ASSERT_TRUE(scheduler.execute(world, 0.0f).has_value());

    EXPECT_EQ(observed, 41);
}

void VerifyEcs_WorldClearDoesNotWaitForUnrelatedSchedulerTasks(){
    GlobalArena arena(s_EcsTestParallelArenaName);
    CpuTaskScheduler taskScheduler(2u);
    CpuTaskScope unrelatedTasks(taskScheduler);
    World world(arena, taskScheduler);

    Atomic<b8> started(false);
    Atomic<b8> release(false);
    Atomic<b8> completed(false);
    const TaskSubmitResult cpuTaskAdmission = unrelatedTasks.submit(
        lambda[mut started, mut release, mut completed]() -> void{
            started.store(true, MemoryOrder::release);
            started.notify_all();
            const Timer begin = TimerNow();
            while(!release.load(MemoryOrder::acquire) && DurationInMS<u64>(TimerNow(), begin) < s_EcsTestSystemCompletionTimeoutMS)
                SleepMS(s_EcsTestPollIntervalMS);
            completed.store(true, MemoryOrder::release);
        }
    );
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    EXPECT_TRUE(cpuTaskAdmission.value().valid());
    started.wait(false, MemoryOrder::acquire);
    world.createEntity().addComponent<PositionComponent>();
    world.clear();
    const b8 unrelatedStillRunning = !completed.load(MemoryOrder::acquire);
    release.store(true, MemoryOrder::release);
    unrelatedTasks.wait();

    EXPECT_TRUE(unrelatedStillRunning);
    EXPECT_EQ(world.entityCount(), 0u);
}

void VerifyEcs_ComponentStoragePreservesOverAlignment(){
    EcsTestWorld testWorld = EcsTestWorld();
    Entity entity = testWorld.world.createEntity();
    mut OverAlignedComponent aligned = entity.addComponent<OverAlignedComponent>();
    EXPECT_EQ(ComponentAddress(aligned) % s_OverAlignedComponentAlignment, 0u);
}

void VerifyEcs_StoredComponentLookupBypassesThrowingAddressOperators(){
    EcsTestWorld testWorld = EcsTestWorld();
    native(mut testWorld){
        auto entity = testWorld.world.createEntity();
        AddressTrapComponent& component = entity.addComponent<AddressTrapComponent>();
        AddressTrapComponent* const expected = AddressOf(component);
        const World& constWorld = testWorld.world;
        static_assert(noexcept(testWorld.world.tryGetComponent<AddressTrapComponent>(entity.id())));
        static_assert(noexcept(constWorld.tryGetComponent<AddressTrapComponent>(entity.id())));
        EXPECT_EQ(testWorld.world.tryGetComponent<AddressTrapComponent>(entity.id()), expected);
        EXPECT_EQ(constWorld.tryGetComponent<AddressTrapComponent>(entity.id()), expected);
        EXPECT_EQ(component.addressCalls, 0u);
        entity.destroy();
        EXPECT_EQ(testWorld.world.tryGetComponent<AddressTrapComponent>(entity.id()), nullptr);
    }
}

void VerifyEcs_ViewAndMessageConsumersPreserveCallbackExceptionContracts(){
    EcsTestWorld testWorld = EcsTestWorld();
    native(mut testWorld){
        auto entity = testWorld.world.createEntity();
        entity.addComponent<PositionComponent>();
        entity.addComponent<VelocityComponent>();
        const auto single = testWorld.world.view<PositionComponent>();
        const auto multiple = testWorld.world.view<PositionComponent, VelocityComponent>();
        const auto singleNoThrow = [](const NWB::Core::ECS::EntityID&, PositionComponent&)noexcept{};
        const auto singleThrows = [](const NWB::Core::ECS::EntityID&, PositionComponent&){ throw 43u; };
        const auto multipleNoThrow = [](NWB::Core::ECS::EntityID&, PositionComponent&, VelocityComponent&)noexcept{};
        const auto multipleThrows = [](NWB::Core::ECS::EntityID&, PositionComponent&, VelocityComponent&){ throw 47u; };
        static_assert(noexcept(single.each(singleNoThrow)));
        static_assert(!noexcept(single.each(singleThrows)));
        static_assert(noexcept(multiple.each(multipleNoThrow)));
        static_assert(!noexcept(multiple.each(multipleThrows)));
        EXPECT_THROW(single.each(singleThrows), u32);
        EXPECT_THROW(multiple.each(multipleThrows), u32);
        single.each(singleNoThrow);
        multiple.each(multipleNoThrow);

        testWorld.world.postMessage(7u);
        testWorld.world.swapMessageBuffers();
        u32 observed = 0u;
        const auto messageNoThrow = [&observed](const u32& value)noexcept{ observed += value; };
        const auto messageThrows = [](const u32&){ throw 53u; };
        static_assert(noexcept(testWorld.world.consumeMessages<u32>(messageNoThrow)));
        static_assert(!noexcept(testWorld.world.consumeMessages<u32>(messageThrows)));
        testWorld.world.consumeMessages<u32>(messageNoThrow);
        EXPECT_EQ(observed, 7u);
        EXPECT_THROW(testWorld.world.consumeMessages<u32>(messageThrows), u32);
        EXPECT_EQ(testWorld.world.messageCount<u32>(), 1u);
    }
}

void VerifyEcs_EmptyViewDoesNotAllocateComponentPools(){
    EcsTestWorld testWorld = EcsTestWorld();
    const ArenaMemoryStats initialMemory = testWorld.arena.memoryStats();

    usize singleViewCount = 0u;
    usize multiViewCount = 0u;

    testWorld.world.view<PositionComponent>().each(
        lambda[mut singleViewCount](in EntityID entityId, mut PositionComponent position) -> void{
            if(!entityId.valid() && position.x == i32.min)
                return;
            ++singleViewCount;
        }
    );
    testWorld.world.view<PositionComponent, VelocityComponent>().each(
        lambda[mut multiViewCount](in EntityID entityId, mut PositionComponent position, mut VelocityComponent velocity) -> void{
            if(!entityId.valid() && position.x == i32.min && velocity.x == i32.min)
                return;
            ++multiViewCount;
        }
    );
    const b8 singleParallelOk = testWorld.world.view<PositionComponent>().parallelEach(
        testWorld.world.taskScope(),
        lambda[mut singleViewCount](in EntityID entityId, mut PositionComponent position) -> void{
            if(!entityId.valid() && position.x == i32.min)
                return;
            ++singleViewCount;
        }
    ).has_value();
    EXPECT_TRUE(singleParallelOk);
    const b8 multiParallelOk = testWorld.world.view<PositionComponent, VelocityComponent>().parallelEach(
        testWorld.world.taskScope(),
        lambda[mut multiViewCount](in EntityID entityId, mut PositionComponent position, mut VelocityComponent velocity) -> void{
            if(!entityId.valid() && position.x == i32.min && velocity.x == i32.min)
                return;
            ++multiViewCount;
        }
    ).has_value();
    EXPECT_TRUE(multiParallelOk);

    EXPECT_EQ(singleViewCount, 0u);
    EXPECT_EQ(multiViewCount, 0u);

    const ArenaMemoryStats finalMemory = testWorld.arena.memoryStats();
    EXPECT_EQ(finalMemory.allocationCount, initialMemory.allocationCount);
    EXPECT_EQ(finalMemory.reallocationCount, initialMemory.reallocationCount);
    EXPECT_EQ(finalMemory.usedBytes, initialMemory.usedBytes);
}

void VerifyEcs_DestroyedEntityGenerationCannotReachRecycledComponents(){
    EcsTestWorld testWorld = EcsTestWorld();
    const EntityID entityId = testWorld.world.createEntity().id();
    testWorld.world.entity(entityId).addComponent<PositionComponent>();

    testWorld.world.entity(entityId).destroy();
    EXPECT_FALSE(testWorld.world.entity(entityId).alive());
    EXPECT_FALSE(HasTryPositionComponent(testWorld.world, entityId));

    const EntityID recycledId = testWorld.world.createEntity().id();
    EXPECT_NE(recycledId, entityId);
}

void VerifyEcs_ExhaustedEntityGenerationNeverRevivesAStaleId(){
    EcsTestWorld testWorld = EcsTestWorld();
    EntityID currentId = testWorld.world.createEntity().id();
    const EntityID stale = currentId;
    const u32 generationMask = s_EntityGenerationMask;
    for(u32 generation = 0u; generation <= generationMask; ++generation){
        testWorld.world.entity(currentId).destroy();
        currentId = testWorld.world.createEntity().id();
    }
    EXPECT_NE(currentId.index(), stale.index());
    EXPECT_FALSE(testWorld.world.entity(stale).alive());
    testWorld.world.clear();
    const EntityID afterClearId = testWorld.world.createEntity().id();
    EXPECT_NE(afterClearId.index(), stale.index());
    EXPECT_FALSE(testWorld.world.entity(stale).alive());
}

void VerifyEcs_ClearingAtTheLastGenerationRetiresTheIndex(){
    EcsTestWorld testWorld = EcsTestWorld();
    EntityID currentId = testWorld.world.createEntity().id();
    const EntityID stale = currentId;
    const u32 generationMask = s_EntityGenerationMask;
    for(u32 generation = 0u; generation <= generationMask; ++generation){
        testWorld.world.clear();
        testWorld.world.clear();
        currentId = testWorld.world.createEntity().id();
    }
    EXPECT_NE(currentId.index(), stale.index());
    EXPECT_FALSE(testWorld.world.entity(stale).alive());
}

void VerifyEcs_ClearedEntityFacadesCannotReachOrDestroyReplacementComponents(){
    EcsTestWorld testWorld = EcsTestWorld();
    Array<EntityID, 8> retiredIds = Array<EntityID, 8>();
    for(usize round = 0u; round < retiredIds.size(); ++round){
        const EntityID entityId = testWorld.world.createEntity().id();
        testWorld.world.entity(entityId).addComponent<PositionComponent>().x = cast<i32>(round);
        retiredIds[round] = entityId;
        testWorld.world.clear();
        testWorld.world.clear();
        const EntityID replacementId = testWorld.world.createEntity().id();
        testWorld.world.entity(replacementId).addComponent<PositionComponent>().x = 73;
        for(usize retired = 0u; retired <= round; ++retired){
            const EntityID staleId = retiredIds[retired];
            EXPECT_FALSE(testWorld.world.entity(staleId).alive());
            EXPECT_FALSE(testWorld.world.entity(staleId).hasComponent<PositionComponent>());
            EXPECT_FALSE(HasTryPositionComponent(testWorld.world, staleId));
            testWorld.world.entity(staleId).removeComponent<PositionComponent>();
            testWorld.world.entity(staleId).destroy();
        }
        EXPECT_TRUE(testWorld.world.entity(replacementId).alive());
        EXPECT_EQ(testWorld.world.entityCount(), 1u);
        EXPECT_EQ(testWorld.world.entity(replacementId).getComponent<PositionComponent>().x, 73);
        testWorld.world.clear();
    }
}

void VerifyEcs_NextGenerationIdForAFreeSlotCannotDestroyOrUnderflowEntityCount(){
    EcsTestWorld testWorld = EcsTestWorld();
    const EntityID originalId = testWorld.world.createEntity().id();
    testWorld.world.entity(originalId).destroy();
    const EntityID unallocatedId = EntityID(originalId.index(), originalId.generation() + 1u);
    EXPECT_FALSE(testWorld.world.entity(unallocatedId).alive());
    EXPECT_EQ(testWorld.world.entityCount(), 0u);
    testWorld.world.entity(unallocatedId).destroy();
    EXPECT_EQ(testWorld.world.entityCount(), 0u);
    const EntityID replacementId = testWorld.world.createEntity().id();
    testWorld.world.entity(replacementId).addComponent<PositionComponent>().x = 91;
    EXPECT_TRUE(testWorld.world.entity(replacementId).alive());
    EXPECT_EQ(testWorld.world.entityCount(), 1u);
    EXPECT_EQ(testWorld.world.entity(replacementId).getComponent<PositionComponent>().x, 91);
}

void VerifyEcs_DuplicateAddAndRemovePreserveComponentMutationVersions(){
    EcsTestWorld testWorld = EcsTestWorld();

    const EntityID entityId = testWorld.world.createEntity().id();
    testWorld.world.entity(entityId).addComponent<PositionComponent>();
    EXPECT_EQ(testWorld.world.componentMutationVersion<PositionComponent>(), 1u);

    testWorld.world.entity(entityId).addComponent<PositionComponent>();
    EXPECT_EQ(testWorld.world.componentMutationVersion<PositionComponent>(), 1u);

    testWorld.world.entity(entityId).addComponent<VelocityComponent>();
    EXPECT_EQ(testWorld.world.componentMutationVersion<PositionComponent>(), 1u);
    EXPECT_EQ(testWorld.world.componentMutationVersion<VelocityComponent>(), 1u);

    testWorld.world.entity(entityId).removeComponent<VelocityComponent>();
    EXPECT_EQ(testWorld.world.componentMutationVersion<VelocityComponent>(), 2u);

    testWorld.world.entity(entityId).removeComponent<VelocityComponent>();
    EXPECT_EQ(testWorld.world.componentMutationVersion<VelocityComponent>(), 2u);

    testWorld.world.entity(entityId).destroy();
    EXPECT_EQ(testWorld.world.componentMutationVersion<PositionComponent>(), 2u);
}

void VerifyEcs_ComponentPoolsPreserveSparseTypeLookupAndWorldIsolation(){
    EcsTestWorld firstWorld = EcsTestWorld();
    EcsTestWorld secondWorld = EcsTestWorld();

    const Array<usize, 64> typeIds = RegisterPoolSlotTypes64();
    EXPECT_NE(typeIds.front(), typeIds.back());

    Entity firstEntity = firstWorld.world.createEntity();
    Entity secondEntity = secondWorld.world.createEntity();
    mut PoolSlotComponent<0> firstComponent = firstEntity.addComponent<PoolSlotComponent<0>>();
    firstComponent.value = 17u;

    secondEntity.addComponent<PoolSlotComponent<31>>().value = 29u;
    firstEntity.addComponent<PoolSlotComponent<64>>().value = 41u;

    EXPECT_TRUE(TryComponentMatches<PoolSlotComponent<0>>(firstWorld.world, firstEntity.id(), firstComponent));
    EXPECT_FALSE(HasTryComponent<PoolSlotComponent<31>>(firstWorld.world, firstEntity.id()));
    EXPECT_FALSE(HasTryComponent<PoolSlotComponent<0>>(secondWorld.world, secondEntity.id()));
    EXPECT_FALSE(HasTryComponent<PoolSlotComponent<64>>(secondWorld.world, secondEntity.id()));
    EXPECT_EQ(firstWorld.world.componentMutationVersion<PoolSlotComponent<31>>(), 0u);

    EXPECT_TRUE(ConstTryComponentMatches<PoolSlotComponent<0>>(firstWorld.world, firstEntity.id(), firstComponent));
    EXPECT_FALSE(HasConstTryComponent<PoolSlotComponent<31>>(firstWorld.world, firstEntity.id()));
    EXPECT_FALSE(HasConstTryComponent<VelocityComponent>(firstWorld.world, firstEntity.id()));

    usize visits = 0u;
    const EntityID expectedFirstId = firstEntity.id();
    const usize expectedFirstAddress = ComponentAddress(firstComponent);
    firstWorld.world.view<PoolSlotComponent<0>>().each(
        lambda[in expectedFirstId, in expectedFirstAddress, mut visits](in EntityID entityId, mut PoolSlotComponent<0> component) -> void{
            EXPECT_EQ(entityId, expectedFirstId);
            EXPECT_EQ(ComponentAddress(component), expectedFirstAddress);
            EXPECT_EQ(component.value, 17u);
            ++visits;
        }
    );
    EXPECT_EQ(visits, 1u);

    firstEntity.addComponent<PoolSlotComponent<31>>().value = 53u;
    EXPECT_EQ(firstEntity.getComponent<PoolSlotComponent<31>>().value, 53u);
    EXPECT_EQ(secondEntity.getComponent<PoolSlotComponent<31>>().value, 29u);
}

void VerifyEcs_ComponentPoolsCanBeRecreatedAfterWorldClear(){
    EcsTestWorld testWorld = EcsTestWorld();
    const EntityID entityId = testWorld.world.createEntity().id();
    testWorld.world.entity(entityId).addComponent<PoolSlotComponent<63>>().value = 19u;
    testWorld.world.entity(entityId).addComponent<PositionComponent>().x = 23;

    testWorld.world.clear();
    EXPECT_EQ(testWorld.world.entityCount(), 0u);
    EXPECT_EQ(testWorld.world.componentMutationVersion<PositionComponent>(), 0u);
    EXPECT_EQ(testWorld.world.componentMutationVersion<PoolSlotComponent<63>>(), 0u);
    EXPECT_FALSE(HasTryPoolSlot63Component(testWorld.world, entityId));
    EXPECT_EQ(testWorld.world.view<PositionComponent>().candidateCount(), 0u);

    const EntityID recreatedId = testWorld.world.createEntity().id();
    testWorld.world.entity(recreatedId).addComponent<PoolSlotComponent<63>>().value = 37u;
    EXPECT_EQ(testWorld.world.entity(recreatedId).getComponent<PoolSlotComponent<63>>().value, 37u);
    EXPECT_EQ(testWorld.world.componentMutationVersion<PoolSlotComponent<63>>(), 1u);
    EXPECT_FALSE(testWorld.world.entity(recreatedId).hasComponent<PositionComponent>());
    EXPECT_EQ(testWorld.world.view<PoolSlotComponent<63>>().candidateCount(), 1u);
}

void VerifyEcs_ClearingPendingMoveOnlyMessagesPreventsPublication(){
    EcsTestWorld testWorld = EcsTestWorld();
    testWorld.world.emplaceMessage<MoveOnlyMessage>(41u);
    testWorld.world.clearMessages();
    testWorld.world.swapMessageBuffers();
    EXPECT_EQ(testWorld.world.messageCount<MoveOnlyMessage>(), 0u);
}

void VerifyEcs_DuplicateComponentAddIsStable(){
    EcsTestWorld testWorld = EcsTestWorld();

    usize viewCount = 0u;
    Entity entity = testWorld.world.createEntity();
    mut PositionComponent first = entity.addComponent<PositionComponent>();
    first.x = 9;
    first.y = 4;

    mut PositionComponent second = entity.addComponent<PositionComponent>();
    EXPECT_EQ(ComponentAddress(first), ComponentAddress(second));
    EXPECT_EQ(second.x, 9);
    EXPECT_EQ(second.y, 4);

    testWorld.world.view<PositionComponent>().each(
        lambda[mut viewCount](in EntityID entityId, mut PositionComponent position) -> void{
            if(!entityId.valid() && position.x == i32.min)
                return;
            ++viewCount;
        }
    );
    EXPECT_EQ(viewCount, 1u);
}

void VerifyEcs_FailedComponentConstructionDoesNotPublishMembership(){
    EcsTestWorld testWorld = EcsTestWorld();
    native(mut testWorld){
        auto entity = testWorld.world.createEntity();
        entity.addComponent<PublicationPositionComponent>().x = 71;
        EXPECT_THROW(entity.addComponent<ThrowingConstructionComponent>(true, 73u), u32);
        ASSERT_FALSE(entity.hasComponent<ThrowingConstructionComponent>());
        EXPECT_EQ(testWorld.world.tryGetComponent<ThrowingConstructionComponent>(entity.id()), nullptr);
        EXPECT_EQ(testWorld.world.view<ThrowingConstructionComponent>().candidateCount(), 0u);
        EXPECT_EQ(testWorld.world.componentMutationVersion<ThrowingConstructionComponent>(), 0u);
        EXPECT_EQ(entity.getComponent<PublicationPositionComponent>().x, 71);

        EXPECT_EQ(entity.addComponent<ThrowingConstructionComponent>(false, 79u).value, 79u);
        EXPECT_EQ(entity.addComponent<ThrowingConstructionComponent>(true, 83u).value, 79u);
        EXPECT_EQ(testWorld.world.componentMutationVersion<ThrowingConstructionComponent>(), 1u);
        entity.destroy();
        EXPECT_FALSE(entity.alive());
    }
    EXPECT_EQ(testWorld.world.view<ThrowingConstructionComponent>().candidateCount(), 0u);
    EXPECT_EQ(testWorld.world.view<PublicationPositionComponent>().candidateCount(), 0u);
}

void VerifyEcs_FailedComponentMoveAssignmentPreservesEntityMappings(){
    b8 rejectMove = false;
    EcsTestWorld testWorld = EcsTestWorld();
    native(mut rejectMove, mut testWorld){
        auto first = testWorld.world.createEntity();
        auto second = testWorld.world.createEntity();
        first.addComponent<ThrowingMoveAssignmentComponent>(rejectMove, 89u);
        second.addComponent<ThrowingMoveAssignmentComponent>(rejectMove, 97u);
        static_assert(!noexcept(first.removeComponent<ThrowingMoveAssignmentComponent>()));
        rejectMove = true;
        EXPECT_THROW(first.removeComponent<ThrowingMoveAssignmentComponent>(), u32);
        rejectMove = false;
        ASSERT_TRUE(first.hasComponent<ThrowingMoveAssignmentComponent>());
        ASSERT_TRUE(second.hasComponent<ThrowingMoveAssignmentComponent>());
        EXPECT_EQ(first.getComponent<ThrowingMoveAssignmentComponent>().value, 89u);
        EXPECT_EQ(second.getComponent<ThrowingMoveAssignmentComponent>().value, 97u);
        EXPECT_EQ(testWorld.world.view<ThrowingMoveAssignmentComponent>().candidateCount(), 2u);
        EXPECT_EQ(testWorld.world.componentMutationVersion<ThrowingMoveAssignmentComponent>(), 2u);

        first.removeComponent<ThrowingMoveAssignmentComponent>();
        EXPECT_FALSE(first.hasComponent<ThrowingMoveAssignmentComponent>());
        EXPECT_EQ(second.getComponent<ThrowingMoveAssignmentComponent>().value, 97u);
        EXPECT_EQ(testWorld.world.view<ThrowingMoveAssignmentComponent>().candidateCount(), 1u);
        second.destroy();
    }
    EXPECT_EQ(testWorld.world.view<ThrowingMoveAssignmentComponent>().candidateCount(), 0u);
}

void VerifyEcs_FailedEntityDestructionRetainsRemainingMembershipForRetry(){
    b8 rejectMove = false;
    EcsTestWorld testWorld = EcsTestWorld();
    native(mut rejectMove, mut testWorld){
        auto first = testWorld.world.createEntity();
        auto second = testWorld.world.createEntity();
        first.addComponent<PublicationPositionComponent>().x = 101;
        first.addComponent<ThrowingMoveAssignmentComponent>(rejectMove, 103u);
        first.addComponent<PublicationVelocityComponent>().x = 107;
        second.addComponent<ThrowingMoveAssignmentComponent>(rejectMove, 109u);
        rejectMove = true;
        EXPECT_THROW(first.destroy(), u32);
        rejectMove = false;
        EXPECT_TRUE(first.alive());
        EXPECT_FALSE(first.hasComponent<PublicationVelocityComponent>());
        EXPECT_TRUE(first.hasComponent<PublicationPositionComponent>());

        first.destroy();
        EXPECT_FALSE(first.alive());
        EXPECT_EQ(testWorld.world.tryGetComponent<PublicationPositionComponent>(first.id()), nullptr);
        EXPECT_EQ(testWorld.world.tryGetComponent<ThrowingMoveAssignmentComponent>(first.id()), nullptr);
        EXPECT_EQ(testWorld.world.view<PublicationPositionComponent>().candidateCount(), 0u);
        EXPECT_EQ(testWorld.world.view<ThrowingMoveAssignmentComponent>().candidateCount(), 1u);
        ASSERT_TRUE(second.hasComponent<ThrowingMoveAssignmentComponent>());
        EXPECT_EQ(second.getComponent<ThrowingMoveAssignmentComponent>().value, 109u);
        second.destroy();
    }
    EXPECT_EQ(testWorld.world.entityCount(), 0u);
    EXPECT_EQ(testWorld.world.view<ThrowingMoveAssignmentComponent>().candidateCount(), 0u);
}

void VerifyEcs_WorldUnwindDestroysPendingMessagesWithoutMovingThem(){
    b8 rejectMove = false;
    u32 moveAttempts = 0u;
    u32 destructions = 0u;
    native(mut rejectMove, mut moveAttempts, mut destructions){
        const auto failWithPendingMessage = [&](){
            EcsTestWorld testWorld;
            testWorld.world.emplaceMessage<ThrowingMoveMessage>(rejectMove, moveAttempts, destructions);
            rejectMove = true;
            throw static_cast<i32>(-79);
        };
        EXPECT_THROW(failWithPendingMessage(), i32);
    }
    EXPECT_EQ(moveAttempts, 0u);
    EXPECT_EQ(destructions, 1u);
}

void VerifyEcs_OrdinaryWorldDestructionDestroysPendingMessagesWithoutMovingThem(){
    b8 rejectMove = true;
    u32 moveAttempts = 0u;
    u32 destructions = 0u;
    {
        EcsTestWorld testWorld = EcsTestWorld();
        testWorld.world.emplaceMessage<ThrowingMoveMessage>(rejectMove, moveAttempts, destructions);
    }
    EXPECT_EQ(moveAttempts, 0u);
    EXPECT_EQ(destructions, 1u);
}

void VerifyEcs_FailedWorldTaskJoinStillRetiresBorrowingSystemsInOrder(){
    SystemLifetimeState state = SystemLifetimeState();
    native(mut state){
        const auto failDuringWorldWait = [&](){
            EcsTestWorld testWorld;
            testWorld.world.addSystem<LifetimeSystem>(state, true);
            testWorld.world.addSystem<LifetimeSystem>(state, false);
            const auto admitted = testWorld.world.taskScope().submit([](){ throw static_cast<i32>(-83); });
            ASSERT_TRUE(admitted);
        };
        EXPECT_THROW(failDuringWorldWait(), i32);
    }
    EXPECT_TRUE(state.borrowerObservedProvider);
    EXPECT_FALSE(state.providerAlive);
    EXPECT_EQ(state.destructionCount, 2u);
    EXPECT_EQ(state.destructionOrder[0u], 2u);
    EXPECT_EQ(state.destructionOrder[1u], 1u);
}

void VerifyEcs_WorldClearAndDestructionRetireBorrowersBeforeEarlierSystems(){
    for(u32 round = 0u; round < 2u; ++round){
        SystemLifetimeState state = SystemLifetimeState();
        {
            EcsTestWorld testWorld = EcsTestWorld();
            testWorld.world.addSystem<LifetimeSystem>(state, true);
            testWorld.world.addSystem<LifetimeSystem>(state, false);
            if(round == 0u)
                testWorld.world.clear();
        }
        EXPECT_TRUE(state.borrowerObservedProvider);
        EXPECT_FALSE(state.providerAlive);
        EXPECT_EQ(state.destructionCount, 2u);
        EXPECT_EQ(state.destructionOrder[0u], 2u);
        EXPECT_EQ(state.destructionOrder[1u], 1u);
    }
}


