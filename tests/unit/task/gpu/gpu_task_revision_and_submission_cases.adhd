const StringView s_GpuSubmissionCompletionLabel = "Storage Completion";
const usize s_GpuSubmissionNoUse = usize.max;

void GpuSubmissionRecompileAfterMutation(
    in GpuTaskGraph graph,
    in GpuPhysicalQueueTopology topology,
    mut ScratchArena operationScratchArena,
    mut GpuTaskGraphAnalysis analysis,
    mut GpuTaskGraphQueueAssignments assignments,
    mut GpuCompiledGraph compiledGraph
){
    {
        const GpuSubmissionReadViews reads = GpuSubmissionReadViews(graph, compiledGraph);
        EXPECT_FALSE(analysis.validFor(reads.declarations));
        EXPECT_FALSE(assignments.validFor(reads.declarations));
        EXPECT_FALSE(reads.compiled.validFor(reads.declarations));
    }
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuSubmissionReadViews reads = GpuSubmissionReadViews(graph, compiledGraph);
    EXPECT_TRUE(reads.valid());
    EXPECT_TRUE(analysis.validFor(reads.declarations));
    EXPECT_TRUE(assignments.validFor(reads.declarations, reads.compiled));
}

void VerifyGpuSubmission_DeclarationStorageMutationsInvalidateCompilerSnapshots(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    {
        const Expected<GpuTaskId> gpuTaskAdmission = AddTask(
            s_DeclarationCaseDeclarationRevisionBase,
            "Declaration Revision Base",
            Span<GpuTaskId>(),
            Span<GpuTaskResourceUse>(),
            Span<GpuTaskResourceSetUse>(),
            Span<GpuTaskResourceVersionUse>(),
            Span<GpuExternalCompletionId>(),
            graph
        );
        ASSERT_TRUE(gpuTaskAdmission.has_value());
        ASSERT_TRUE(gpuTaskAdmission.value().valid());
    }

    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuSubmissionTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    {
        const GpuSubmissionReadViews reads = GpuSubmissionReadViews(graph, compiledGraph);
        ASSERT_TRUE(reads.valid());
        ASSERT_TRUE(analysis.validFor(reads.declarations));
        ASSERT_TRUE(assignments.validFor(reads.declarations, reads.compiled));
    }

    u64 previousRevision = GpuTaskGraphDeclarationReadView(graph).declarationRevision();
    {
        const Expected<GpuTaskId> secondGpuTaskAdmission = AddTask(
            s_DeclarationCaseDeclarationRevisionTask,
            "Declaration Revision Task",
            Span<GpuTaskId>(),
            Span<GpuTaskResourceUse>(),
            Span<GpuTaskResourceSetUse>(),
            Span<GpuTaskResourceVersionUse>(),
            Span<GpuExternalCompletionId>(),
            graph
        );
        ASSERT_TRUE(secondGpuTaskAdmission.has_value());
        ASSERT_TRUE(secondGpuTaskAdmission.value().valid());
    }
    EXPECT_NE(GpuTaskGraphDeclarationReadView(graph).declarationRevision(), previousRevision);
    GpuSubmissionRecompileAfterMutation(graph, topology, operationScratchArena, analysis, assignments, compiledGraph);

    previousRevision = GpuTaskGraphDeclarationReadView(graph).declarationRevision();
    const Expected<GpuGraphResourceId> resourceResult = AddBufferMetadata(graph, s_DeclarationCaseDeclarationRevisionResource, "Declaration Revision Resource");
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    ASSERT_TRUE(resource.valid());
    EXPECT_NE(GpuTaskGraphDeclarationReadView(graph).declarationRevision(), previousRevision);
    GpuSubmissionRecompileAfterMutation(graph, topology, operationScratchArena, analysis, assignments, compiledGraph);

    Array<GpuGraphResourceId, 1> resourceSetMembers = Array<GpuGraphResourceId, 1>();
    resourceSetMembers[0u] = resource;
    previousRevision = GpuTaskGraphDeclarationReadView(graph).declarationRevision();
    GpuGraphResourceSetDesc setDesc = GpuGraphResourceSetDesc();
    setDesc.setIdentity(s_DeclarationCaseDeclarationRevisionResourceSet);
    setDesc.setMarkerLabel("Declaration Revision Resource Set");
    setDesc.setMembers(resourceSetMembers);
    const Expected<GpuGraphResourceSetId> resourceSetResult = graph.importResourceSet(setDesc);
    ASSERT_TRUE(resourceSetResult.has_value());
    const GpuGraphResourceSetId resourceSet = resourceSetResult.value();
    ASSERT_TRUE(resourceSet.valid());
    EXPECT_NE(GpuTaskGraphDeclarationReadView(graph).declarationRevision(), previousRevision);
    GpuSubmissionRecompileAfterMutation(graph, topology, operationScratchArena, analysis, assignments, compiledGraph);

    previousRevision = GpuTaskGraphDeclarationReadView(graph).declarationRevision();
    const Expected<GpuGraphPipelineId> pipelineResult = AddPipelineMetadata(
        graph,
        s_DeclarationCaseDeclarationRevisionPipeline,
        "Declaration Revision Pipeline",
        GpuGraphPipelineType::Compute
    );
    ASSERT_TRUE(pipelineResult.has_value());
    const GpuGraphPipelineId pipeline = pipelineResult.value();
    ASSERT_TRUE(pipeline.valid());
    EXPECT_NE(GpuTaskGraphDeclarationReadView(graph).declarationRevision(), previousRevision);
    GpuSubmissionRecompileAfterMutation(graph, topology, operationScratchArena, analysis, assignments, compiledGraph);

    previousRevision = GpuTaskGraphDeclarationReadView(graph).declarationRevision();
    GpuExternalCompletionDesc completionDesc = GpuExternalCompletionDesc();
    completionDesc.setIdentity(s_DeclarationCaseDeclarationRevisionCompletion);
    completionDesc.setMarkerLabel("Declaration Revision Completion");
    const Expected<GpuExternalCompletionId> completionResult = graph.importExternalCompletion(completionDesc);
    ASSERT_TRUE(completionResult.has_value());
    const GpuExternalCompletionId completion = completionResult.value();
    ASSERT_TRUE(completion.valid());
    EXPECT_NE(GpuTaskGraphDeclarationReadView(graph).declarationRevision(), previousRevision);
    GpuSubmissionRecompileAfterMutation(graph, topology, operationScratchArena, analysis, assignments, compiledGraph);

    Array<u8, 4> uploadBytes = Array<u8, 4>();
    uploadBytes[0u] = 0x17u;
    uploadBytes[1u] = 0x3au;
    uploadBytes[2u] = 0x5cu;
    uploadBytes[3u] = 0x8eu;
    previousRevision = GpuTaskGraphDeclarationReadView(graph).declarationRevision();
    const Expected<GpuUploadBlobId> uploadResult = CopyGpuSubmissionUploadBytes(graph, uploadBytes, 4u);
    ASSERT_TRUE(uploadResult.has_value());
    const GpuUploadBlobId upload = uploadResult.value();
    ASSERT_TRUE(upload.valid());
    EXPECT_NE(GpuTaskGraphDeclarationReadView(graph).declarationRevision(), previousRevision);
    GpuSubmissionRecompileAfterMutation(graph, topology, operationScratchArena, analysis, assignments, compiledGraph);
}

void VerifyGpuSubmission_FailedAndIdempotentDeclarationsPreserveCompilerSnapshots(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);

    GpuGraphResourceDesc resourceDesc = GpuGraphResourceDesc();
    resourceDesc.setIdentity(s_DeclarationCaseStableDeclarationResource);
    resourceDesc.setMarkerLabel("Stable Declaration Resource");
    resourceDesc.setType(GpuGraphResourceType::Buffer);
    resourceDesc.setInitialState(ResourceStates::Common);
    const Expected<GpuGraphResourceId> resourceResult = graph.importResource(resourceDesc);
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    ASSERT_TRUE(resource.valid());

    Array<GpuGraphResourceId, 1> resourceSetMembers = Array<GpuGraphResourceId, 1>();
    resourceSetMembers[0u] = resource;
    GpuGraphResourceSetDesc resourceSetDesc = GpuGraphResourceSetDesc();
    resourceSetDesc.setIdentity(s_DeclarationCaseStableDeclarationResourceSet);
    resourceSetDesc.setMarkerLabel("Stable Declaration Resource Set");
    resourceSetDesc.setMembers(resourceSetMembers);
    const Expected<GpuGraphResourceSetId> resourceSetResult = graph.importResourceSet(resourceSetDesc);
    ASSERT_TRUE(resourceSetResult.has_value());
    const GpuGraphResourceSetId resourceSet = resourceSetResult.value();
    ASSERT_TRUE(resourceSet.valid());

    GpuGraphPipelineDesc pipelineDesc = GpuGraphPipelineDesc();
    pipelineDesc.setIdentity(s_DeclarationCaseStableDeclarationPipeline);
    pipelineDesc.setMarkerLabel("Stable Declaration Pipeline");
    pipelineDesc.setType(GpuGraphPipelineType::Compute);
    const Expected<GpuGraphPipelineId> pipelineResult = graph.importPipeline(pipelineDesc);
    ASSERT_TRUE(pipelineResult.has_value());
    const GpuGraphPipelineId pipeline = pipelineResult.value();
    ASSERT_TRUE(pipeline.valid());

    GpuExternalCompletionDesc completionDesc = GpuExternalCompletionDesc();
    completionDesc.setIdentity(s_DeclarationCaseStableDeclarationCompletion);
    completionDesc.setMarkerLabel("Stable Declaration Completion");
    const Expected<GpuExternalCompletionId> completionResult = graph.importExternalCompletion(completionDesc);
    ASSERT_TRUE(completionResult.has_value());
    const GpuExternalCompletionId completion = completionResult.value();
    ASSERT_TRUE(completion.valid());

    Array<u8, 1> uploadBytes = Array<u8, 1>();
    uploadBytes[0u] = 0x17u;
    {
        const Expected<GpuUploadBlobId> gpuTaskAdmission = CopyGpuSubmissionUploadBytes(graph, uploadBytes, 1u);
        ASSERT_TRUE(gpuTaskAdmission.has_value());
        ASSERT_TRUE(gpuTaskAdmission.value().valid());
    }
    {
        const Expected<GpuTaskId> secondGpuTaskAdmission = AddTask(
            s_DeclarationCaseStableDeclarationTask,
            "Stable Declaration Task",
            Span<GpuTaskId>(),
            Span<GpuTaskResourceUse>(),
            Span<GpuTaskResourceSetUse>(),
            Span<GpuTaskResourceVersionUse>(),
            Span<GpuExternalCompletionId>(),
            graph
        );
        ASSERT_TRUE(secondGpuTaskAdmission.has_value());
        ASSERT_TRUE(secondGpuTaskAdmission.value().valid());
    }

    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuSubmissionTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const u64 compiledRevision = GpuTaskGraphDeclarationReadView(graph).declarationRevision();

    {
        const Expected<GpuGraphResourceId> thirdGpuTaskAdmission = graph.importResource(resourceDesc);
        EXPECT_TRUE(thirdGpuTaskAdmission.has_value());
        if(thirdGpuTaskAdmission.has_value())
            EXPECT_EQ(thirdGpuTaskAdmission.value(), resource);
    }
    {
        const Expected<GpuGraphResourceSetId> fourthGpuTaskAdmission = graph.importResourceSet(resourceSetDesc);
        EXPECT_TRUE(fourthGpuTaskAdmission.has_value());
        if(fourthGpuTaskAdmission.has_value())
            EXPECT_EQ(fourthGpuTaskAdmission.value(), resourceSet);
    }
    {
        const Expected<GpuGraphPipelineId> fifthGpuTaskAdmission = graph.importPipeline(pipelineDesc);
        EXPECT_TRUE(fifthGpuTaskAdmission.has_value());
        if(fifthGpuTaskAdmission.has_value())
            EXPECT_EQ(fifthGpuTaskAdmission.value(), pipeline);
    }
    {
        const Expected<GpuExternalCompletionId> sixthGpuTaskAdmission = graph.importExternalCompletion(completionDesc);
        EXPECT_TRUE(sixthGpuTaskAdmission.has_value());
        if(sixthGpuTaskAdmission.has_value())
            EXPECT_EQ(sixthGpuTaskAdmission.value(), completion);
    }
    {
        const GpuSubmissionReadViews reads = GpuSubmissionReadViews(graph, compiledGraph);
        EXPECT_EQ(reads.declarations.declarationRevision(), compiledRevision);
        EXPECT_TRUE(analysis.validFor(reads.declarations));
        EXPECT_TRUE(assignments.validFor(reads.declarations, reads.compiled));
        EXPECT_TRUE(reads.compiled.validFor(reads.declarations));
    }

    EXPECT_FALSE(graph.addTask(GpuTaskDesc()).has_value());
    EXPECT_FALSE(graph.importResource(GpuGraphResourceDesc()).has_value());
    EXPECT_FALSE(graph.importResourceSet(GpuGraphResourceSetDesc()).has_value());
    EXPECT_FALSE(graph.importPipeline(GpuGraphPipelineDesc()).has_value());
    EXPECT_FALSE(graph.importExternalCompletion(GpuExternalCompletionDesc()).has_value());
    EXPECT_FALSE(CopyGpuSubmissionNullUpload(graph, 1u, 1u));
    const GpuSubmissionReadViews reads = GpuSubmissionReadViews(graph, compiledGraph);
    EXPECT_EQ(reads.declarations.declarationRevision(), compiledRevision);
    EXPECT_TRUE(analysis.validFor(reads.declarations));
    EXPECT_TRUE(assignments.validFor(reads.declarations, reads.compiled));
    EXPECT_TRUE(reads.compiled.validFor(reads.declarations));
}

void VerifyGpuSubmission_ExternalFinalResourceDeclarationInvalidatesPriorCompiledPlan(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    {
        const Expected<GpuTaskId> gpuTaskAdmission = AddTask(
            s_DeclarationCaseExternalFinalRevisionBase,
            "External Final Revision Base",
            Span<GpuTaskId>(),
            Span<GpuTaskResourceUse>(),
            Span<GpuTaskResourceSetUse>(),
            Span<GpuTaskResourceVersionUse>(),
            Span<GpuExternalCompletionId>(),
            graph
        );
        ASSERT_TRUE(gpuTaskAdmission.has_value());
        ASSERT_TRUE(gpuTaskAdmission.value().valid());
    }

    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuSubmissionTopology(queues);
    GpuTaskGraphAnalysis priorAnalysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments priorAssignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph priorCompiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(Compile(priorAnalysis, priorAssignments, priorCompiledGraph, operationScratchArena, graph, topology));
    u64 compiledRevision = 0u;
    {
        const GpuSubmissionReadViews reads = GpuSubmissionReadViews(graph, priorCompiledGraph);
        ASSERT_TRUE(reads.valid());
        compiledRevision = reads.declarations.declarationRevision();
    }

    GpuGraphResourceDesc externalDesc = GpuGraphResourceDesc();
    externalDesc.setIdentity(s_DeclarationCaseExternalFinalRevisionResource);
    externalDesc.setMarkerLabel("External Final Revision Resource");
    externalDesc.setType(GpuGraphResourceType::Buffer);
    externalDesc.setInitialState(ResourceStates::Common);
    externalDesc.setExternalFinalState(ResourceStates::ShaderResource);
    const Expected<GpuGraphResourceId> externalFinalResourceResult = graph.importResource(externalDesc);
    ASSERT_TRUE(externalFinalResourceResult.has_value());
    const GpuGraphResourceId externalFinalResource = externalFinalResourceResult.value();
    ASSERT_TRUE(externalFinalResource.valid());
    {
        const GpuSubmissionReadViews reads = GpuSubmissionReadViews(graph, priorCompiledGraph);
        EXPECT_NE(reads.declarations.declarationRevision(), compiledRevision);
        EXPECT_FALSE(priorAnalysis.validFor(reads.declarations));
        EXPECT_FALSE(priorAssignments.validFor(reads.declarations));
        EXPECT_FALSE(reads.compiled.validFor(reads.declarations));
    }

    GpuTaskGraphAnalysis freshAnalysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments freshAssignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph freshCompiledGraph = GpuCompiledGraph(testArena.arena);
    EXPECT_FALSE(Compile(freshAnalysis, freshAssignments, freshCompiledGraph, operationScratchArena, graph, topology));
    const GpuSubmissionCompiledGraphReadView freshCompiledPlan = GpuSubmissionCompiledGraphReadView(freshCompiledGraph);
    EXPECT_FALSE(freshCompiledPlan.valid());
}

void VerifyGpuSubmission_ReducesSchedulingDagWithoutLosingRawDependencyDiagnostics(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> handoffResult = AddHazardDomain(graph, s_GpuCaseTaskGraphTransitiveReductionHandoff, "Transitive Reduction Handoff");
    ASSERT_TRUE(handoffResult.has_value());
    const GpuGraphResourceId handoff = handoffResult.value();
    ASSERT_TRUE(handoff.valid());

    const GpuTaskCommandRequirements graphicsCommands = GraphicsCommands();
    const GpuTaskCommandRequirements computeCommands = ComputeCommands();
    const Name mergeDomain = s_TaskGraphTransitiveReductionMergeDomain;

    GpuTaskSchedulingHint firstScheduling = GpuTaskSchedulingHint();
    firstScheduling.cost = GpuTaskCostHint::Medium;
    firstScheduling.frontierScoredMergeDomain = mergeDomain;
    Array<GpuTaskResourceUse, 1> firstUses = Array<GpuTaskResourceUse, 1>();
    firstUses[0u].resource = handoff;
    firstUses[0u].requiredState = ResourceStates::UnorderedAccess;
    firstUses[0u].access = GpuTaskResourceAccess::Write;
    GpuTaskDesc firstDesc = GpuTaskDesc();
    firstDesc.setIdentity(s_GpuCaseTaskGraphTransitiveReductionFirst);
    firstDesc.setMarkerLabel("Transitive Reduction First");
    firstDesc.setScheduling(firstScheduling);
    firstDesc.setResourceUses(firstUses);
    const Expected<GpuTaskId> firstResult = graph.addTask(firstDesc, graphicsCommands);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    ASSERT_TRUE(first.valid());

    GpuTaskSchedulingHint secondScheduling = GpuTaskSchedulingHint();
    secondScheduling.cost = GpuTaskCostHint::Tiny;
    secondScheduling.frontierScoredMergeDomain = mergeDomain;
    Array<GpuTaskId, 1> secondDeps = Array<GpuTaskId, 1>();
    secondDeps[0u] = first;
    GpuTaskDesc secondDesc = GpuTaskDesc();
    secondDesc.setIdentity(s_GpuCaseTaskGraphTransitiveReductionSecond);
    secondDesc.setMarkerLabel("Transitive Reduction Second");
    secondDesc.setScheduling(secondScheduling);
    secondDesc.setDependencies(secondDeps);
    const Expected<GpuTaskId> secondResult = graph.addTask(secondDesc, graphicsCommands);
    ASSERT_TRUE(secondResult.has_value());
    const GpuTaskId second = secondResult.value();
    ASSERT_TRUE(second.valid());

    Array<GpuTaskId, 1> thirdDeps = Array<GpuTaskId, 1>();
    thirdDeps[0u] = second;
    Array<GpuTaskResourceUse, 1> thirdUses = Array<GpuTaskResourceUse, 1>();
    thirdUses[0u].resource = handoff;
    thirdUses[0u].requiredState = ResourceStates::ShaderResource;
    thirdUses[0u].access = GpuTaskResourceAccess::Read;
    GpuTaskDesc thirdDesc = GpuTaskDesc();
    thirdDesc.setIdentity(s_GpuCaseTaskGraphTransitiveReductionThird);
    thirdDesc.setMarkerLabel("Transitive Reduction Third");
    thirdDesc.setDependencies(thirdDeps);
    thirdDesc.setResourceUses(thirdUses);
    const Expected<GpuTaskId> thirdResult = graph.addTask(thirdDesc, computeCommands);
    ASSERT_TRUE(thirdResult.has_value());
    const GpuTaskId third = thirdResult.value();
    ASSERT_TRUE(third.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_EQ(analysis.edges().size(), 3u);
    EXPECT_EQ(analysis.edges()[0u].producer, first);
    EXPECT_EQ(analysis.edges()[0u].consumer, second);
    EXPECT_EQ(analysis.edges()[1u].producer, second);
    EXPECT_EQ(analysis.edges()[1u].consumer, third);
    EXPECT_EQ(analysis.edges()[2u].producer, first);
    EXPECT_EQ(analysis.edges()[2u].consumer, third);
    ASSERT_EQ(analysis.schedulingEdges().size(), 2u);
    EXPECT_EQ(analysis.schedulingEdges()[0u].producer, first);
    EXPECT_EQ(analysis.schedulingEdges()[0u].consumer, second);
    EXPECT_EQ(analysis.schedulingEdges()[1u].producer, second);
    EXPECT_EQ(analysis.schedulingEdges()[1u].consumer, third);
    ASSERT_EQ(analysis.inferredEdges().size(), 1u);
    EXPECT_TRUE(HasInferredHazard(analysis, first, third, handoff, GpuTaskHazardType::ReadAfterWrite));

    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuSubmissionTopology(queues);
    GpuTaskGraphAnalysis separateAnalysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments separateAssignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph separateGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(separateAnalysis, separateAssignments, separateGraph, operationScratchArena, graph, topology));
    {
        const GpuSubmissionCompiledGraphReadView compiledPlan = GpuSubmissionCompiledGraphReadView(separateGraph);
        ASSERT_EQ(compiledPlan.packetCount(), 3u);
        const GpuSubmissionPacketId separateFirstPacket = compiledPlan.packetForTask(first);
        const GpuSubmissionPacketId separateSecondPacket = compiledPlan.packetForTask(second);
        const GpuSubmissionPacketId separateThirdPacket = compiledPlan.packetForTask(third);
        ASSERT_TRUE(separateFirstPacket.valid());
        ASSERT_TRUE(separateSecondPacket.valid());
        ASSERT_TRUE(separateThirdPacket.valid());
        native(in compiledPlan, in separateFirstPacket, in separateSecondPacket, in separateThirdPacket){
            EXPECT_EQ(compiledPlan.packet(separateFirstPacket).plan->dependencyCount, 0u);
            ASSERT_EQ(compiledPlan.packet(separateSecondPacket).plan->dependencyCount, 1u);
            EXPECT_EQ(compiledPlan.packet(separateSecondPacket).dependencies[0u].producer, separateFirstPacket);
            ASSERT_EQ(compiledPlan.packet(separateThirdPacket).plan->dependencyCount, 1u);
            EXPECT_EQ(compiledPlan.packet(separateThirdPacket).dependencies[0u].producer, separateSecondPacket);
        }
    }

    GpuTaskGraphCompileOptions scoredOptions = GpuTaskGraphCompileOptions();
    scoredOptions.packetizationPolicy = GpuTaskGraphPacketizationPolicy::FrontierScored;
    GpuTaskGraphAnalysis scoredAnalysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments scoredAssignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph scoredGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(scoredAnalysis, scoredAssignments, scoredGraph, operationScratchArena, graph, topology, scoredOptions));
    const GpuSubmissionCompiledGraphReadView compiledPlan = GpuSubmissionCompiledGraphReadView(scoredGraph);
    ASSERT_EQ(compiledPlan.packetCount(), 2u);
    const GpuSubmissionPacketId scoredFirstPacket = compiledPlan.packetForTask(first);
    const GpuSubmissionPacketId scoredSecondPacket = compiledPlan.packetForTask(second);
    const GpuSubmissionPacketId scoredThirdPacket = compiledPlan.packetForTask(third);
    ASSERT_TRUE(scoredFirstPacket.valid());
    ASSERT_TRUE(scoredThirdPacket.valid());
    EXPECT_EQ(scoredFirstPacket, scoredSecondPacket);
    EXPECT_NE(scoredFirstPacket, scoredThirdPacket);
    EXPECT_EQ(compiledPlan.packetizationDecisionForTask(second), GpuTaskPacketizationDecision::MergedFrontierScored);
    native(in compiledPlan, in scoredFirstPacket, in scoredThirdPacket){
        ASSERT_EQ(compiledPlan.packet(scoredThirdPacket).plan->dependencyCount, 1u);
        EXPECT_EQ(compiledPlan.packet(scoredThirdPacket).dependencies[0u].producer, scoredFirstPacket);
    }
}

void VerifyGpuSubmission_SchedulingAdjacencyRejectsStaleIdsAndClearsOnReset(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuTaskId> firstResult = AddTask(
        s_GpuCaseTaskGraphSchedulingAdjacencyFirst,
        "Scheduling Adjacency First",
        Span<GpuTaskId>(),
        Span<GpuTaskResourceUse>(),
        Span<GpuTaskResourceSetUse>(),
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    Array<GpuTaskId, 1> secondDeps = Array<GpuTaskId, 1>();
    secondDeps[0u] = first;
    const Expected<GpuTaskId> secondResult = AddTask(
        s_GpuCaseTaskGraphSchedulingAdjacencySecond,
        "Scheduling Adjacency Second",
        secondDeps,
        Span<GpuTaskResourceUse>(),
        Span<GpuTaskResourceSetUse>(),
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(secondResult.has_value());
    const GpuTaskId second = secondResult.value();
    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(second.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    const GpuTaskGraphSchedulingTaskIndexView consumers = analysis.schedulingConsumers(first);
    const GpuTaskGraphSchedulingTaskIndexView producers = analysis.schedulingProducers(second);
    ASSERT_EQ(consumers.taskCount, 1u);
    ASSERT_EQ(producers.taskCount, 1u);
    EXPECT_EQ(consumers[0u], second.index);
    EXPECT_EQ(producers[0u], first.index);

    u32 declaredTaskCount = 0u;
    u64 graphGeneration = 0u;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        declaredTaskCount = cast<u32>(declarations.taskCount());
        graphGeneration = declarations.generation();
    }
    GpuTaskId outOfRangeTask = GpuTaskId();
    outOfRangeTask.generation = graphGeneration;
    outOfRangeTask.index = declaredTaskCount;
    GpuTaskId staleTask = GpuTaskId();
    staleTask.generation = graphGeneration + 1u;
    staleTask.index = first.index;

    GpuTaskGraph foreignGraph = GpuTaskGraph(testArena.arena);
    const Expected<GpuTaskId> foreignTaskResult = AddTask(
        s_GpuCaseTaskGraphSchedulingAdjacencyForeign,
        "Scheduling Adjacency Foreign",
        Span<GpuTaskId>(),
        Span<GpuTaskResourceUse>(),
        Span<GpuTaskResourceSetUse>(),
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuExternalCompletionId>(),
        foreignGraph
    );
    ASSERT_TRUE(foreignTaskResult.has_value());
    const GpuTaskId foreignTask = foreignTaskResult.value();
    ASSERT_TRUE(foreignTask.valid());
    EXPECT_TRUE(analysis.schedulingConsumers(GpuTaskId()).empty());
    EXPECT_TRUE(analysis.schedulingConsumers(outOfRangeTask).empty());
    EXPECT_TRUE(analysis.schedulingConsumers(staleTask).empty());
    EXPECT_TRUE(analysis.schedulingConsumers(foreignTask).empty());
    EXPECT_TRUE(analysis.schedulingProducers(GpuTaskId()).empty());
    EXPECT_TRUE(analysis.schedulingProducers(outOfRangeTask).empty());
    EXPECT_TRUE(analysis.schedulingProducers(staleTask).empty());
    EXPECT_TRUE(analysis.schedulingProducers(foreignTask).empty());

    analysis.reset();
    EXPECT_FALSE(analysis.valid());
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        EXPECT_FALSE(analysis.validFor(declarations));
    }
    EXPECT_TRUE(analysis.schedulingConsumers(first).empty());
    EXPECT_TRUE(analysis.schedulingProducers(second).empty());
}

void VerifyGpuSubmission_PackedSchedulingReachabilityPreservesStrictClosureAcrossWordBoundaries(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    const usize maxTaskCount = 129u;
    Array<usize, 7> taskCounts = Array<usize, 7>();
    taskCounts[0u] = 63u;
    taskCounts[1u] = 64u;
    taskCounts[2u] = 65u;
    taskCounts[3u] = 66u;
    taskCounts[4u] = 127u;
    taskCounts[5u] = 128u;
    taskCounts[6u] = 129u;

    for(in usize taskCount : taskCounts){
        TestArena testArena = TestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        Array<GpuTaskId, 129> tasks = Array<GpuTaskId, 129>();
        const Name taskBaseName = s_TaskGraphPackedReachabilityTask;
        for(usize taskIndex = 0u; taskIndex < taskCount; ++taskIndex){
            const Expected<Name> derivedNameResult = IndexedName(taskBaseName, taskIndex);
            ASSERT_TRUE(derivedNameResult.has_value());
            Expected<GpuTaskId> taskAdmission = MakeUnexpected(Failure());
            if(taskIndex >= 2u){
                Array<GpuTaskId, 1> dep = Array<GpuTaskId, 1>();
                dep[0u] = tasks[taskIndex - 2u];
                taskAdmission = AddTask(
                    derivedNameResult.value(),
                    "Packed Reachability Task",
                    dep,
                    Span<GpuTaskResourceUse>(),
                    Span<GpuTaskResourceSetUse>(),
                    Span<GpuTaskResourceVersionUse>(),
                    Span<GpuExternalCompletionId>(),
                    graph
                );
            }
            else{
                taskAdmission = AddTask(
                    derivedNameResult.value(),
                    "Packed Reachability Task",
                    Span<GpuTaskId>(),
                    Span<GpuTaskResourceUse>(),
                    Span<GpuTaskResourceSetUse>(),
                    Span<GpuTaskResourceVersionUse>(),
                    Span<GpuExternalCompletionId>(),
                    graph
                );
            }
            ASSERT_TRUE(taskAdmission.has_value());
            tasks[taskIndex] = taskAdmission.value();
            ASSERT_TRUE(tasks[taskIndex].valid());
            EXPECT_EQ(tasks[taskIndex].index, taskIndex);
        }

        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
        ScratchArena reachabilityScratchArena = ScratchArena(s_GpuCaseTaskGpuPackedReachabilityScratch);
        u64 graphGeneration = 0u;
        native(
            in graph,
            in analysis,
            in tasks,
            in taskCount,
            in maxTaskCount,
            mut operationScratchArena,
            mut reachabilityScratchArena,
            mut testArena,
            mut graphGeneration
        ){
            GpuSubmissionSchedulingReachability reachability(reachabilityScratchArena);
            {
                const Core::GpuTaskGraph::DeclarationReadView declarations(graph);
                ASSERT_TRUE(Core::GpuTaskGraphCompilerDetail::BuildGpuTaskSchedulingReachability(declarations, analysis, reachability));
                graphGeneration = declarations.generation();
            }

            const usize lastEvenTask = (taskCount & 1u) != 0u ? taskCount - 1u : taskCount - 2u;
            const usize lastOddTask = (taskCount & 1u) != 0u ? taskCount - 2u : taskCount - 1u;
            EXPECT_TRUE(reachability.reaches(tasks[0u], tasks[lastEvenTask]));
            EXPECT_FALSE(reachability.reaches(tasks[lastEvenTask], tasks[0u]));
            EXPECT_TRUE(reachability.reaches(tasks[1u], tasks[lastOddTask]));
            EXPECT_FALSE(reachability.reaches(tasks[lastOddTask], tasks[1u]));
            EXPECT_FALSE(reachability.transitivelyIndependent(tasks[0u], tasks[lastEvenTask]));
            EXPECT_FALSE(reachability.transitivelyIndependent(tasks[1u], tasks[lastOddTask]));
            EXPECT_TRUE(reachability.transitivelyIndependent(tasks[0u], tasks[lastOddTask]));
            EXPECT_TRUE(reachability.transitivelyIndependent(tasks[1u], tasks[lastEvenTask]));

            const usize boundaryProducer = taskCount - 3u;
            const usize boundaryConsumer = taskCount - 1u;
            EXPECT_TRUE(reachability.reaches(tasks[boundaryProducer], tasks[boundaryConsumer]));
            EXPECT_FALSE(reachability.reaches(tasks[boundaryConsumer], tasks[boundaryProducer]));
            EXPECT_TRUE(reachability.transitivelyIndependent(tasks[taskCount - 2u], tasks[boundaryConsumer]));
            if(taskCount >= 127u){
                const usize secondWordProducer = taskCount - 63u;
                EXPECT_TRUE(reachability.reaches(tasks[secondWordProducer], tasks[boundaryConsumer]));
                EXPECT_FALSE(reachability.reaches(tasks[boundaryConsumer], tasks[secondWordProducer]));
                EXPECT_TRUE(reachability.transitivelyIndependent(tasks[secondWordProducer - 1u], tasks[boundaryConsumer]));
            }

            const Core::GpuTaskId staleTask{ .generation = graphGeneration + 1u, .index = tasks[0u].index };
            const Core::GpuTaskId outOfRangeTask{ .generation = graphGeneration, .index = static_cast<u32>(taskCount) };
            EXPECT_FALSE(reachability.reaches(tasks[0u], tasks[0u]));
            EXPECT_FALSE(reachability.transitivelyIndependent(tasks[0u], tasks[0u]));
            EXPECT_FALSE(reachability.reaches(staleTask, tasks[lastEvenTask]));
            EXPECT_FALSE(reachability.transitivelyIndependent(staleTask, tasks[lastOddTask]));
            EXPECT_FALSE(reachability.reaches(outOfRangeTask, tasks[lastEvenTask]));
            EXPECT_FALSE(reachability.transitivelyIndependent(outOfRangeTask, tasks[lastOddTask]));

            if(taskCount == maxTaskCount){
                Core::GpuTaskGraph emptyGraph(testArena.arena);
                Core::GpuTaskGraphAnalysis emptyAnalysis(testArena.arena);
                ASSERT_TRUE(Analyze(emptyGraph, operationScratchArena, emptyAnalysis));
                const Core::GpuTaskGraph::DeclarationReadView declarations(emptyGraph);
                ASSERT_TRUE(Core::GpuTaskGraphCompilerDetail::BuildGpuTaskSchedulingReachability(declarations, emptyAnalysis, reachability));
                EXPECT_FALSE(reachability.reaches(tasks[0u], tasks[lastEvenTask]));
                EXPECT_FALSE(reachability.transitivelyIndependent(tasks[0u], tasks[lastOddTask]));
            }
        }
    }
}

void VerifyGpuSubmission_FansInTerminalTextureStateFragmentsForBroadCrossQueueConsumer(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> textureResult = AddTextureMetadata(graph, s_GpuCaseTaskGraphFragmentFanInTexture, "Fragment Fan-In Texture");
    ASSERT_TRUE(textureResult.has_value());
    const GpuGraphResourceId texture = textureResult.value();
    ASSERT_TRUE(texture.valid());

    Array<GpuPhysicalQueueInfo, 3> queues = Array<GpuPhysicalQueueInfo, 3>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    queues[2u] = DedicatedTransferQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuSubmissionTopology(queues);
    const GpuTaskCommandRequirements graphicsCommands = GraphicsCommands();
    const GpuTaskCommandRequirements computeCommands = ComputeCommands();
    GpuTaskCommandRequirements transferCommands = GpuTaskCommandRequirements();
    transferCommands.requiredCapabilities = GpuQueueCapability::Transfer;
    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.forceSubmissionBoundary = true;
    scheduling.allowPacketMerge = false;

    GpuTaskResourceRange transferRange = GpuTaskResourceRange();
    transferRange.textureSubresources = TextureSubresourceSet(0u, 1u, 0u, s_GpuSubmissionAllArraySlices);
    GpuTaskResourceRange computeRange = GpuTaskResourceRange();
    computeRange.textureSubresources = TextureSubresourceSet(1u, 1u, 0u, s_GpuSubmissionAllArraySlices);
    GpuTaskResourceRange broadRange = GpuTaskResourceRange();
    broadRange.textureSubresources = s_GpuSubmissionAllSubresources;
    GpuTaskResourceRange initialTailRange = GpuTaskResourceRange();
    initialTailRange.textureSubresources = TextureSubresourceSet(2u, s_GpuSubmissionAllMipLevels, 0u, s_GpuSubmissionAllArraySlices);

    Array<GpuTaskResourceUse, 1> transferUses = Array<GpuTaskResourceUse, 1>();
    transferUses[0u].resource = texture;
    transferUses[0u].range = transferRange;
    transferUses[0u].requiredState = ResourceStates::CopyDest;
    transferUses[0u].access = GpuTaskResourceAccess::Write;

    Array<GpuTaskResourceUse, 1> computeUses = Array<GpuTaskResourceUse, 1>();
    computeUses[0u].resource = texture;
    computeUses[0u].range = computeRange;
    computeUses[0u].requiredState = ResourceStates::UnorderedAccess;
    computeUses[0u].access = GpuTaskResourceAccess::Write;

    Array<GpuTaskResourceUse, 1> consumerUses = Array<GpuTaskResourceUse, 1>();
    consumerUses[0u].resource = texture;
    consumerUses[0u].range = broadRange;
    consumerUses[0u].requiredState = ResourceStates::ShaderResource;
    consumerUses[0u].access = GpuTaskResourceAccess::Read;

    GpuTaskDesc transferDesc = GpuTaskDesc();
    transferDesc.setIdentity(s_GpuCaseTaskGraphFragmentFanInTransfer);
    transferDesc.setMarkerLabel("Fragment Fan-In Transfer");
    transferDesc.setScheduling(scheduling);
    transferDesc.setResourceUses(transferUses);

    GpuTaskDesc computeDesc = GpuTaskDesc();
    computeDesc.setIdentity(s_GpuCaseTaskGraphFragmentFanInCompute);
    computeDesc.setMarkerLabel("Fragment Fan-In Compute");
    computeDesc.setScheduling(scheduling);
    computeDesc.setResourceUses(computeUses);

    GpuTaskDesc consumerDesc = GpuTaskDesc();
    consumerDesc.setIdentity(s_GpuCaseTaskGraphFragmentFanInConsumer);
    consumerDesc.setMarkerLabel("Fragment Fan-In Consumer");
    consumerDesc.setScheduling(scheduling);
    consumerDesc.setResourceUses(consumerUses);

    const Expected<GpuTaskId> transferTaskResult = graph.addTask(transferDesc, transferCommands);
    ASSERT_TRUE(transferTaskResult.has_value());
    const GpuTaskId transferTask = transferTaskResult.value();
    const Expected<GpuTaskId> computeTaskResult = graph.addTask(computeDesc, computeCommands);
    ASSERT_TRUE(computeTaskResult.has_value());
    const GpuTaskId computeTask = computeTaskResult.value();
    const Expected<GpuTaskId> consumerTaskResult = graph.addTask(consumerDesc, graphicsCommands);
    ASSERT_TRUE(consumerTaskResult.has_value());
    const GpuTaskId consumerTask = consumerTaskResult.value();
    ASSERT_TRUE(transferTask.valid());
    ASSERT_TRUE(computeTask.valid());
    ASSERT_TRUE(consumerTask.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuSubmissionCompiledGraphReadView compiledPlan = GpuSubmissionCompiledGraphReadView(compiledGraph);

    native(
        in compiledPlan,
        in transferTask,
        in computeTask,
        in consumerTask,
        in queues,
        in texture,
        in transferRange,
        in computeRange,
        in broadRange,
        in initialTailRange
    ){
        const Core::GpuCompiledTask* const compiledTransfer = compiledPlan.findTask(transferTask).plan;
        const Core::GpuCompiledTask* const compiledCompute = compiledPlan.findTask(computeTask).plan;
        const Core::GpuCompiledTask* const compiledConsumer = compiledPlan.findTask(consumerTask).plan;
        ASSERT_NE(compiledTransfer, nullptr);
        ASSERT_NE(compiledCompute, nullptr);
        ASSERT_NE(compiledConsumer, nullptr);
        EXPECT_EQ(compiledTransfer->queue, queues[2u].id);
        EXPECT_EQ(compiledCompute->queue, queues[1u].id);
        EXPECT_EQ(compiledConsumer->queue, queues[0u].id);

        const Core::GpuSubmissionPacketId transferPacket = compiledTransfer->packet;
        const Core::GpuSubmissionPacketId computePacket = compiledCompute->packet;
        const Core::GpuSubmissionPacketId consumerPacket = compiledConsumer->packet;
        ASSERT_TRUE(transferPacket.valid());
        ASSERT_TRUE(computePacket.valid());
        ASSERT_TRUE(consumerPacket.valid());
        ASSERT_EQ(compiledConsumer->prologueStateSeedCount, 2u);
        const Core::GpuPacketStateSeed* const seeds = compiledPlan.findTask(consumerTask).prologueStateSeeds;
        ASSERT_NE(seeds, nullptr);
        b8 hasTransferSeed = false;
        b8 hasComputeSeed = false;
        for(u32 seedIndex = 0u; seedIndex < compiledConsumer->prologueStateSeedCount; ++seedIndex){
            const Core::GpuPacketStateSeed& seed = seeds[seedIndex];
            hasTransferSeed = hasTransferSeed || (seed.resource == texture && seed.range.textureSubresources == transferRange.textureSubresources && seed.sourcePacket == transferPacket);
            hasComputeSeed = hasComputeSeed || (seed.resource == texture && seed.range.textureSubresources == computeRange.textureSubresources && seed.sourcePacket == computePacket);
            EXPECT_NE(seed.range.textureSubresources, broadRange.textureSubresources);
        }
        EXPECT_TRUE(hasTransferSeed);
        EXPECT_TRUE(hasComputeSeed);

        ASSERT_EQ(compiledPlan.packet(consumerPacket).plan->dependencyCount, 2u);
        const Core::GpuPacketDependency* const dependencies = compiledPlan.packet(consumerPacket).dependencies;
        ASSERT_NE(dependencies, nullptr);
        b8 waitsForTransfer = false;
        b8 waitsForCompute = false;
        for(u32 dependencyIndex = 0u; dependencyIndex < compiledPlan.packet(consumerPacket).plan->dependencyCount; ++dependencyIndex){
            waitsForTransfer = waitsForTransfer || dependencies[dependencyIndex].producer == transferPacket;
            waitsForCompute = waitsForCompute || dependencies[dependencyIndex].producer == computePacket;
        }
        EXPECT_TRUE(waitsForTransfer);
        EXPECT_TRUE(waitsForCompute);

        ASSERT_EQ(compiledTransfer->epilogueBarrierCount, 1u);
        ASSERT_EQ(compiledCompute->epilogueBarrierCount, 1u);
        const Core::GpuCompiledBarrier* const transferRelease = compiledPlan.findTask(transferTask).epilogueBarriers;
        const Core::GpuCompiledBarrier* const computeRelease = compiledPlan.findTask(computeTask).epilogueBarriers;
        ASSERT_NE(transferRelease, nullptr);
        ASSERT_NE(computeRelease, nullptr);
        EXPECT_EQ(transferRelease[0u].type, Core::GpuCompiledBarrierType::TextureOwnershipRelease);
        EXPECT_EQ(transferRelease[0u].range.textureSubresources, transferRange.textureSubresources);
        EXPECT_EQ(transferRelease[0u].sourceQueue, queues[2u].id);
        EXPECT_EQ(transferRelease[0u].destinationQueue, queues[0u].id);
        EXPECT_EQ(computeRelease[0u].type, Core::GpuCompiledBarrierType::TextureOwnershipRelease);
        EXPECT_EQ(computeRelease[0u].range.textureSubresources, computeRange.textureSubresources);
        EXPECT_EQ(computeRelease[0u].sourceQueue, queues[1u].id);
        EXPECT_EQ(computeRelease[0u].destinationQueue, queues[0u].id);

        ASSERT_EQ(compiledConsumer->prologueBarrierCount, 5u);
        const Core::GpuCompiledBarrier* const barriers = compiledPlan.findTask(consumerTask).prologueBarriers;
        ASSERT_NE(barriers, nullptr);
        b8 hasTransferAcquire = false;
        b8 hasComputeAcquire = false;
        b8 hasTransferTransition = false;
        b8 hasComputeTransition = false;
        b8 hasInitialTailTransition = false;
        for(u32 barrierIndex = 0u; barrierIndex < compiledConsumer->prologueBarrierCount; ++barrierIndex){
            const Core::GpuCompiledBarrier& barrier = barriers[barrierIndex];
            hasTransferAcquire = hasTransferAcquire || (
                barrier.type == Core::GpuCompiledBarrierType::TextureOwnershipAcquire
                && barrier.range.textureSubresources == transferRange.textureSubresources
                && barrier.before == Core::ResourceStates::CopyDest
                && barrier.sourceQueue == queues[2u].id
                && barrier.destinationQueue == queues[0u].id
            );
            hasComputeAcquire = hasComputeAcquire || (
                barrier.type == Core::GpuCompiledBarrierType::TextureOwnershipAcquire
                && barrier.range.textureSubresources == computeRange.textureSubresources
                && barrier.before == Core::ResourceStates::UnorderedAccess
                && barrier.sourceQueue == queues[1u].id
                && barrier.destinationQueue == queues[0u].id
            );
            hasTransferTransition = hasTransferTransition || (
                barrier.type == Core::GpuCompiledBarrierType::TextureTransition
                && barrier.range.textureSubresources == transferRange.textureSubresources
                && barrier.before == Core::ResourceStates::CopyDest
                && barrier.after == Core::ResourceStates::ShaderResource
                && !barrier.isGraphInitialState
            );
            hasComputeTransition = hasComputeTransition || (
                barrier.type == Core::GpuCompiledBarrierType::TextureTransition
                && barrier.range.textureSubresources == computeRange.textureSubresources
                && barrier.before == Core::ResourceStates::UnorderedAccess
                && barrier.after == Core::ResourceStates::ShaderResource
                && !barrier.isGraphInitialState
            );
            hasInitialTailTransition = hasInitialTailTransition || (
                barrier.type == Core::GpuCompiledBarrierType::TextureTransition
                && barrier.range.textureSubresources == initialTailRange.textureSubresources
                && barrier.before == Core::ResourceStates::Common
                && barrier.after == Core::ResourceStates::ShaderResource
                && barrier.isGraphInitialState
            );
        }
        EXPECT_TRUE(hasTransferAcquire);
        EXPECT_TRUE(hasComputeAcquire);
        EXPECT_TRUE(hasTransferTransition);
        EXPECT_TRUE(hasComputeTransition);
        EXPECT_TRUE(hasInitialTailTransition);
    }
}

void VerifyGpuSubmission_LargeTaskChainPreservesDeclarationsAndReusesStorage(){
    const usize taskCount = 4096u;
    GpuSubmissionStorageTestArena testArena = GpuSubmissionStorageTestArena();
    Vector<Name> identities = Vector<Name>();
    identities.reserve(taskCount);
    for(usize index = 0u; index < taskCount; ++index){
        const Expected<Name> derivedNameResult = IndexedName(s_GpuCaseGraphStorageTask, index);
        ASSERT_TRUE(derivedNameResult.has_value());
        identities.push_back(derivedNameResult.value());
    }

    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskId previousGenerationTask = GpuTaskId();
    for(usize pass = 0u; pass < 2u; ++pass){
        GpuGraphResourceDesc resourceDesc = GpuGraphResourceDesc();
        resourceDesc.setIdentity(s_GpuCaseGraphStorageInput);
        resourceDesc.setMarkerLabel("Storage Input");
        resourceDesc.setType(GpuGraphResourceType::Buffer);
        resourceDesc.setInitialState(ResourceStates::ShaderResource);
        const Expected<GpuGraphResourceId> resourceResult = graph.importResource(resourceDesc);
        ASSERT_TRUE(resourceResult.has_value());
        const GpuGraphResourceId resource = resourceResult.value();
        ASSERT_TRUE(resource.valid());

        GpuExternalCompletionDesc completionDesc = GpuExternalCompletionDesc();
        completionDesc.setIdentity(s_GpuCaseGraphStorageCompletion);
        completionDesc.setMarkerLabel(s_GpuSubmissionCompletionLabel);
        const Expected<GpuExternalCompletionId> completionResult = graph.importExternalCompletion(completionDesc);
        ASSERT_TRUE(completionResult.has_value());
        const GpuExternalCompletionId completion = completionResult.value();
        ASSERT_TRUE(completion.valid());

        Array<GpuTaskResourceUse, 1> uses = Array<GpuTaskResourceUse, 1>();
        uses[0u].resource = resource;
        uses[0u].requiredState = ResourceStates::ShaderResource;
        uses[0u].access = GpuTaskResourceAccess::Read;

        Array<GpuExternalCompletionId, 1> completions = Array<GpuExternalCompletionId, 1>();
        completions[0u] = completion;

        GpuTaskId previousTask = GpuTaskId();
        b8 accepted = true;
        const ArenaMemoryStats memoryBefore = testArena.arena.memoryStats();
        for(usize index = 0u; index < taskCount; ++index){
            GpuTaskDesc desc = GpuTaskDesc();
            desc.setIdentity(identities[index]);
            desc.setMarkerLabel("Storage Chain Task");
            desc.setExternalDependencies(completions);
            desc.setResourceUses(uses);
            Expected<GpuTaskId> previousTaskAdmission = MakeUnexpected(Failure());
            if(index == 0u){
                desc.setDependencies(Span<GpuTaskId>());
                previousTaskAdmission = graph.addTask(desc);
            }
            else{
                Array<GpuTaskId, 1> deps = Array<GpuTaskId, 1>();
                deps[0u] = previousTask;
                desc.setDependencies(deps);
                previousTaskAdmission = graph.addTask(desc);
            }
            ASSERT_TRUE(previousTaskAdmission.has_value());
            previousTask = previousTaskAdmission.value();
            accepted = accepted && previousTask.valid();
        }
        const ArenaMemoryStats memoryAfter = testArena.arena.memoryStats();

        ASSERT_TRUE(accepted);
        if(pass != 0u){
            EXPECT_EQ(memoryAfter.allocationCount, memoryBefore.allocationCount);
            EXPECT_EQ(memoryAfter.usedBytes, memoryBefore.usedBytes);
            EXPECT_EQ(memoryAfter.reservedBytes, memoryBefore.reservedBytes);
            EXPECT_EQ(memoryAfter.reallocationCount, memoryBefore.reallocationCount);
        }
        {
            const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
            ASSERT_TRUE(declarations.valid());
            EXPECT_FALSE(declarations.validTask(previousGenerationTask));
            ASSERT_EQ(declarations.taskCount(), taskCount);
            for(usize index = 0u; index < taskCount; ++index){
                const GpuTaskGraphTaskView task = declarations.taskAt(index);
                const Name expectedIdentity = identities[index];
                u32 expectedDeps = 1u;
                if(index == 0u)
                    expectedDeps = 0u;
                EXPECT_EQ(task.identity, expectedIdentity);
                ASSERT_EQ(task.dependencyCount, expectedDeps);
                if(index != 0u){
                    const GpuTaskId expectedDep = declarations.taskAt(index - 1u).id;
                    native(in task, in expectedDep){
                        EXPECT_EQ(task.dependencies[0u], expectedDep);
                    }
                }
                ASSERT_EQ(task.externalDependencyCount, 1u);
                ASSERT_EQ(task.resourceUseCount, 1u);
                native(in task, in completion, in resource, in uses){
                    EXPECT_EQ(task.externalDependencies[0u], completion);
                    EXPECT_EQ(task.resourceUses[0u].resource, resource);
                    EXPECT_EQ(task.resourceUses[0u].requiredState, uses[0u].requiredState);
                }
            }
        }
        previousGenerationTask = previousTask;
        graph.reset();
    }
}

void VerifyGpuSubmission_MixedDeclarationsAndUploadBytesSurviveStorageGrowth(){
    const usize recordCount = 256u;
    GpuSubmissionStorageTestArena testArena = GpuSubmissionStorageTestArena();
    Vector<Name> identities = Vector<Name>();
    identities.reserve(recordCount);
    for(usize index = 0u; index < recordCount; ++index){
        const Expected<Name> derivedNameResult = IndexedName(s_GpuCaseGraphStorageRecord, index);
        ASSERT_TRUE(derivedNameResult.has_value());
        identities.push_back(derivedNameResult.value());
    }

    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    Vector<GpuUploadBlobId> uploads = Vector<GpuUploadBlobId>();
    uploads.reserve(recordCount);
    b8 accepted = true;
    for(usize index = 0u; index < recordCount; ++index){
        GpuGraphResourceDesc resourceDesc = GpuGraphResourceDesc();
        resourceDesc.setIdentity(identities[index]);
        resourceDesc.setMarkerLabel("Storage Resource");
        resourceDesc.setType(GpuGraphResourceType::Buffer);
        const Expected<GpuGraphResourceId> resourceResult = graph.importResource(resourceDesc);
        ASSERT_TRUE(resourceResult.has_value());
        const GpuGraphResourceId resource = resourceResult.value();

        Array<GpuGraphResourceId, 1> setMembers = Array<GpuGraphResourceId, 1>();
        setMembers[0u] = resource;
        GpuGraphResourceSetDesc setDesc = GpuGraphResourceSetDesc();
        setDesc.setIdentity(identities[index]);
        setDesc.setMarkerLabel("Storage Resource Set");
        setDesc.setMembers(setMembers);
        const Expected<GpuGraphResourceSetId> resourceSetResult = graph.importResourceSet(setDesc);
        ASSERT_TRUE(resourceSetResult.has_value());
        const GpuGraphResourceSetId resourceSet = resourceSetResult.value();

        GpuGraphPipelineDesc pipelineDesc = GpuGraphPipelineDesc();
        pipelineDesc.setIdentity(identities[index]);
        pipelineDesc.setMarkerLabel("Storage Pipeline");
        pipelineDesc.setType(GpuGraphPipelineType::Compute);
        const Expected<GpuGraphPipelineId> pipelineResult = graph.importPipeline(pipelineDesc);
        ASSERT_TRUE(pipelineResult.has_value());
        const GpuGraphPipelineId pipeline = pipelineResult.value();

        GpuExternalCompletionDesc completionDesc = GpuExternalCompletionDesc();
        completionDesc.setIdentity(identities[index]);
        completionDesc.setMarkerLabel(s_GpuSubmissionCompletionLabel);
        const Expected<GpuExternalCompletionId> completionResult = graph.importExternalCompletion(completionDesc);
        ASSERT_TRUE(completionResult.has_value());
        const GpuExternalCompletionId completion = completionResult.value();

        const u64 word = cast<u64>(index);
        const Expected<GpuUploadBlobId> uploadResult = CopyGpuSubmissionUploadU64Pair(graph, word, ~word);
        ASSERT_TRUE(uploadResult.has_value());
        const GpuUploadBlobId upload = uploadResult.value();
        uploads.push_back(upload);
        accepted = accepted && resource.valid() && resourceSet.valid() && pipeline.valid() && completion.valid() && upload.valid();
    }

    ASSERT_TRUE(accepted);
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        ASSERT_EQ(declarations.resourceCount(), recordCount);
        ASSERT_EQ(declarations.resourceSetCount(), recordCount);
        ASSERT_EQ(declarations.pipelineCount(), recordCount);
        ASSERT_EQ(declarations.externalCompletionCount(), recordCount);
        ASSERT_EQ(declarations.uploadBlobCount(), recordCount);
        for(usize index = 0u; index < recordCount; ++index){
            const GpuTaskGraphResourceView resource = declarations.resourceAt(index);
            const GpuTaskGraphResourceSetView resourceSet = declarations.resourceSetAt(index);
            const GpuTaskGraphPipelineView pipeline = declarations.pipelineAt(index);
            const GpuTaskGraphExternalCompletionView completion = declarations.externalCompletionAt(index);
            const Name expectedIdentity = identities[index];
            EXPECT_EQ(resource.identity, expectedIdentity);
            EXPECT_EQ(resourceSet.identity, expectedIdentity);
            ASSERT_EQ(resourceSet.memberCount, 1u);
            EXPECT_EQ(pipeline.identity, expectedIdentity);
            EXPECT_EQ(completion.identity, expectedIdentity);
            const GpuUploadBlobId uploadId = uploads[index];
            native(in declarations, in resourceSet, in resource, in uploadId, in index){
                EXPECT_EQ(resourceSet.members[0u], resource.id);
                const auto storedBytes = declarations.uploadBlobData(uploadId);
                const Array<u64, 2u> expectedBytes = { static_cast<u64>(index), ~static_cast<u64>(index) };
                ASSERT_TRUE(storedBytes);
                ASSERT_EQ(storedBytes->size(), sizeof(expectedBytes));
                EXPECT_EQ(NWB_MEMCMP(storedBytes->data(), expectedBytes.data(), sizeof(expectedBytes)), 0);
            }
        }
    }
    graph.reset();
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    EXPECT_EQ(declarations.resourceCount(), 0u);
    EXPECT_EQ(declarations.resourceSetCount(), 0u);
    EXPECT_EQ(declarations.pipelineCount(), 0u);
    EXPECT_EQ(declarations.externalCompletionCount(), 0u);
    EXPECT_EQ(declarations.uploadBlobCount(), 0u);
    for(in GpuUploadBlobId upload : uploads)
        EXPECT_FALSE(declarations.validUploadBlob(upload));
}

void VerifyGpuSubmission_PreservesMergedAliasesAndReversedBindingOrderWithoutInvokingHooks(){
    GpuSubmissionBindingFixture fixture = GpuSubmissionBindingFixture();
    ASSERT_TRUE(fixture.prepare(48u, 3u));
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(fixture.graph);
    const GpuSubmissionCompiledGraphReadView plan = GpuSubmissionCompiledGraphReadView(fixture.compileState.compiledGraph);
    ASSERT_EQ(plan.packetCount(), 16u);
    native(mut fixture, in declarations, in plan){
        GpuSubmissionTimingBindingVector timingBindings(fixture.testArena.arena);
        GpuSubmissionHookBindingVector hookBindings(fixture.testArena.arena);
        timingBindings.reserve(fixture.tasks.size());
        hookBindings.reserve(plan.packetCount());
        for(usize reverseIndex = fixture.tasks.size(); reverseIndex != 0u; --reverseIndex){
            const usize index = reverseIndex - 1u;
            const usize first = index - index % 3u;
            timingBindings.push_back({ .task = fixture.tasks[index], .timingTicket = fixture.tickets[first + (index % 3u == 1u ? 1u : 0u)].get() });
            if(index % 3u == 1u)
                hookBindings.push_back({ .task = fixture.tasks[index], .hook = fixture.hook(index + 1u) });
        }
        Core::Alloc::ScratchArena scratch(s_TaskGraphScratchArena);
        GpuSubmissionBindings resolved(scratch);
        ASSERT_TRUE(resolved.resolve(
            declarations,
            plan,
            plan.allPacketRange(),
            Span<const Core::GpuTaskGraphTaskTimingTicket>(timingBindings.data(), timingBindings.size()),
            Span<const Core::GpuTaskGraphTaskSubmissionHook>(hookBindings.data(), hookBindings.size())
        ));
        GpuSubmissionPacketTickets packetTickets(scratch);
        packetTickets.reserve(resolved.timingTickets.size());
        const usize collectAllocationCount = scratch.memoryStats().allocationCount;
        for(usize packetIndex = 0u; packetIndex < plan.packetCount(); ++packetIndex){
            const usize first = packetIndex * 3u;
            const Core::GpuSubmissionPacketId packet = plan.packetForTask(fixture.tasks[first]);
            ASSERT_EQ(packet, plan.packetIdAt(packetIndex));
            const Core::QueueSubmissionPreSubmitHook* hook = resolved.collectPacket(packet, packetTickets);
            ASSERT_EQ(packetTickets.size(), 2u);
            EXPECT_EQ(packetTickets[0u].get(), fixture.tickets[first].get());
            EXPECT_EQ(packetTickets[1u].get(), fixture.tickets[first + 1u].get());
            ASSERT_NE(hook, nullptr);
            EXPECT_EQ(hook->context, &fixture.hookInvocationCount);
            EXPECT_EQ(hook->identity, first + 2u);
            EXPECT_TRUE(resolved.validateOwnedTimingTicket(packet, fixture.tickets[first].get()));
            EXPECT_TRUE(resolved.validateOwnedTimingTicket(packet, nullptr));
            EXPECT_TRUE(resolved.validateOwnedTimingTicket(packet, fixture.tickets[first + 2u].get()));
            EXPECT_FALSE(resolved.validateOwnedTimingTicket(plan.packetIdAt((packetIndex + 1u) % plan.packetCount()), fixture.tickets[first].get()));
        }
        Core::GpuSubmissionPacketId stalePacket = plan.packetIdAt(0u);
        ++stalePacket.generation;
        const Core::QueueSubmissionPreSubmitHook* hook = resolved.collectPacket(stalePacket, packetTickets);
        EXPECT_TRUE(packetTickets.empty());
        EXPECT_EQ(hook, nullptr);
        EXPECT_FALSE(resolved.validateOwnedTimingTicket(stalePacket, fixture.tickets[0u].get()));
        EXPECT_EQ(scratch.memoryStats().allocationCount, collectAllocationCount);

        const Core::GpuTaskGraphTaskTimingTicket singleTiming{ .task = fixture.tasks[0u], .timingTicket = fixture.tickets[0u].get() };
        const Core::GpuTaskGraphTaskSubmissionHook singleHook{ .task = fixture.tasks[1u], .hook = fixture.hook(99u) };
        ASSERT_TRUE(resolved.resolve(
            declarations,
            plan,
            plan.allPacketRange(),
            Span<const Core::GpuTaskGraphTaskTimingTicket>(&singleTiming, 1u),
            Span<const Core::GpuTaskGraphTaskSubmissionHook>(&singleHook, 1u)
        ));
        hook = resolved.collectPacket(plan.packetIdAt(0u), packetTickets);
        ASSERT_EQ(packetTickets.size(), 1u);
        EXPECT_EQ(packetTickets[0u].get(), fixture.tickets[0u].get());
        ASSERT_NE(hook, nullptr);
        EXPECT_EQ(hook->identity, 99u);
        hook = resolved.collectPacket(plan.packetIdAt(15u), packetTickets);
        EXPECT_TRUE(packetTickets.empty());
        EXPECT_EQ(hook, nullptr);
        EXPECT_TRUE(resolved.validateOwnedTimingTicket(plan.packetIdAt(0u), fixture.tickets[3u].get()));

        ASSERT_TRUE(resolved.resolve(declarations, plan, plan.allPacketRange(), {}, {}));
        hook = resolved.collectPacket(plan.packetIdAt(0u), packetTickets);
        EXPECT_TRUE(packetTickets.empty());
        EXPECT_EQ(hook, nullptr);
        EXPECT_TRUE(resolved.validateOwnedTimingTicket(stalePacket, fixture.tickets[0u].get()));
    }
    EXPECT_EQ(fixture.hookInvocationCount, 0u);
}

void VerifyGpuSubmission_RejectsLateDuplicateAnchorsCrossPacketTicketsAndMergedHookCollisions(){
    GpuSubmissionBindingFixture fixture = GpuSubmissionBindingFixture();
    ASSERT_TRUE(fixture.prepare(48u, 3u));
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(fixture.graph);
    const GpuSubmissionCompiledGraphReadView plan = GpuSubmissionCompiledGraphReadView(fixture.compileState.compiledGraph);
    const GpuSubmissionPacketRange range = plan.allPacketRange();
    native(mut fixture, in declarations, in plan, in range){
        GpuSubmissionTimingBindingVector timingBindings(fixture.testArena.arena);
        GpuSubmissionHookBindingVector hookBindings(fixture.testArena.arena);
        timingBindings.reserve(fixture.tasks.size());
        hookBindings.reserve(plan.packetCount());
        for(usize index = 0u; index < fixture.tasks.size(); ++index)
            timingBindings.push_back({ .task = fixture.tasks[index], .timingTicket = fixture.tickets[index].get() });
        for(usize index = 0u; index < plan.packetCount(); ++index)
            hookBindings.push_back({ .task = fixture.tasks[index * 3u], .hook = fixture.hook(index + 1u) });
        Core::Alloc::ScratchArena scratch(s_TaskGraphScratchArena);
        GpuSubmissionBindings resolved(scratch);
        const Core::GpuTaskGraphTaskTimingTicket lastTiming = timingBindings.back();
        timingBindings.back().task = timingBindings.front().task;
        EXPECT_FALSE(resolved.resolve(declarations, plan, range, Span<const Core::GpuTaskGraphTaskTimingTicket>(timingBindings.data(), timingBindings.size()), {}));
        timingBindings.back() = lastTiming;
        timingBindings.back().timingTicket = timingBindings.front().timingTicket;
        EXPECT_FALSE(resolved.resolve(declarations, plan, range, Span<const Core::GpuTaskGraphTaskTimingTicket>(timingBindings.data(), timingBindings.size()), {}));
        timingBindings.back() = lastTiming;
        const Core::GpuTaskGraphTaskSubmissionHook lastHook = hookBindings.back();
        hookBindings.back().task = fixture.tasks[1u];
        EXPECT_FALSE(resolved.resolve(declarations, plan, range, {}, Span<const Core::GpuTaskGraphTaskSubmissionHook>(hookBindings.data(), hookBindings.size())));
        hookBindings.back().task = hookBindings.front().task;
        EXPECT_FALSE(resolved.resolve(declarations, plan, range, {}, Span<const Core::GpuTaskGraphTaskSubmissionHook>(hookBindings.data(), hookBindings.size())));
        hookBindings.back() = lastHook;
        ASSERT_TRUE(resolved.resolve(
            declarations,
            plan,
            range,
            Span<const Core::GpuTaskGraphTaskTimingTicket>(timingBindings.data(), timingBindings.size()),
            Span<const Core::GpuTaskGraphTaskSubmissionHook>(hookBindings.data(), hookBindings.size())
        ));
    }
    EXPECT_EQ(fixture.hookInvocationCount, 0u);
}

void VerifyGpuSubmission_RejectsStaleMissingAndOutOfRangeAnchorsAndMalformedBindings(){
    GpuSubmissionBindingFixture fixture = GpuSubmissionBindingFixture();
    ASSERT_TRUE(fixture.prepare(2u));
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(fixture.graph);
    const GpuSubmissionCompiledGraphReadView plan = GpuSubmissionCompiledGraphReadView(fixture.compileState.compiledGraph);
    const GpuSubmissionPacketRange range = plan.allPacketRange();
    GpuSubmissionPacketRange prefix = range;
    prefix.packetCount = 1u;
    native(mut fixture, in declarations, in plan, in range, in prefix){
        Core::GpuTaskGraphTaskTimingTicket timing{ .task = fixture.tasks[1u], .timingTicket = fixture.tickets[1u].get() };
        Core::GpuTaskGraphTaskSubmissionHook hook{ .task = fixture.tasks[1u], .hook = fixture.hook(2u) };
        Core::Alloc::ScratchArena scratch(s_TaskGraphScratchArena);
        GpuSubmissionBindings resolved(scratch);
        EXPECT_FALSE(resolved.resolve(declarations, plan, prefix, Span<const Core::GpuTaskGraphTaskTimingTicket>(&timing, 1u), {}));
        EXPECT_FALSE(resolved.resolve(declarations, plan, prefix, {}, Span<const Core::GpuTaskGraphTaskSubmissionHook>(&hook, 1u)));
        ++timing.task.generation;
        ++hook.task.generation;
        EXPECT_FALSE(resolved.resolve(declarations, plan, range, Span<const Core::GpuTaskGraphTaskTimingTicket>(&timing, 1u), {}));
        EXPECT_FALSE(resolved.resolve(declarations, plan, range, {}, Span<const Core::GpuTaskGraphTaskSubmissionHook>(&hook, 1u)));
        timing.task = fixture.tasks[1u];
        hook.task = fixture.tasks[1u];
        timing.task.index = static_cast<u32>(fixture.tasks.size());
        hook.task.index = static_cast<u32>(fixture.tasks.size());
        EXPECT_FALSE(resolved.resolve(declarations, plan, range, Span<const Core::GpuTaskGraphTaskTimingTicket>(&timing, 1u), {}));
        EXPECT_FALSE(resolved.resolve(declarations, plan, range, {}, Span<const Core::GpuTaskGraphTaskSubmissionHook>(&hook, 1u)));
        timing.task = fixture.tasks[1u];
        hook.task = fixture.tasks[1u];
        timing.timingTicket = nullptr;
        hook.hook.invoke = nullptr;
        EXPECT_FALSE(resolved.resolve(declarations, plan, range, Span<const Core::GpuTaskGraphTaskTimingTicket>(&timing, 1u), {}));
        EXPECT_FALSE(resolved.resolve(declarations, plan, range, {}, Span<const Core::GpuTaskGraphTaskSubmissionHook>(&hook, 1u)));
        EXPECT_FALSE(resolved.resolve(declarations, plan, range, Span<const Core::GpuTaskGraphTaskTimingTicket>(static_cast<const Core::GpuTaskGraphTaskTimingTicket*>(nullptr), 1u), {}));
        EXPECT_FALSE(resolved.resolve(declarations, plan, range, {}, Span<const Core::GpuTaskGraphTaskSubmissionHook>(static_cast<const Core::GpuTaskGraphTaskSubmissionHook*>(nullptr), 1u)));
    }
    EXPECT_EQ(fixture.hookInvocationCount, 0u);
}

void GpuSubmissionExpectWaitStatistics(in GpuPhysicalQueueId queue, in Span<QueueSubmissionToken> tokens){
    ScratchArena scratch = ScratchArena(s_TaskGraphScratchArena);
    GpuSubmissionPacketWaitStatistics actual = GpuSubmissionPacketWaitStatistics();
    native(in queue, in tokens, mut scratch, mut actual){
        actual = Core::GpuPacketRuntimeDetail::CountPacketWaitStatistics(queue, tokens, scratch);
    }

    Vector<u32> identities = Vector<u32>();
    identities.reserve(tokens.size());
    usize sameQueueCount = 0u;
    for(usize index = 0u; index < tokens.size(); ++index){
        const QueueSubmissionToken token = tokens[index];
        if(token.matchesPhysicalQueue(queue.index, queue.deviceGeneration))
            ++sameQueueCount;
        else
            identities.push_back((cast<u32>(token.deviceGeneration) << 16u) | cast<u32>(token.physicalQueueIndex));
    }

    usize uniqueQueueCount = 0u;
    native(mut identities, mut uniqueQueueCount){
        Sort(identities.begin(), identities.end());
        uniqueQueueCount = identities.empty() ? 0u : static_cast<usize>(Unique(identities.begin(), identities.end()) - identities.begin());
    }
    EXPECT_EQ(actual.plannedWaitTokenCount, tokens.size());
    EXPECT_EQ(actual.sameQueueWaitElisionCount, sameQueueCount);
    EXPECT_EQ(actual.timelineWaitCount, uniqueQueueCount);
    EXPECT_EQ(actual.mergedTimelineWaitCount, tokens.size() - sameQueueCount - uniqueQueueCount);
}

void VerifyGpuSubmission_CountsDistinctPhysicalQueueGenerationsWithoutChangingWaitTokens(){
    TestArena testArena = TestArena();
    GpuPhysicalQueueId queue = GpuPhysicalQueueId();
    queue.index = 41u;
    queue.deviceGeneration = 9u;
    GpuSubmissionTokenVector tokens = GpuSubmissionTokenVector(testArena.arena);
    for(usize index = 0u; index < 24u; ++index){
        QueueSubmissionToken token = QueueSubmissionToken();
        token.value = index + 1u;
        if(index < 4u)
            token.physicalQueueIndex = queue.index;
        else
            token.physicalQueueIndex = cast<u16>(300u + index % 12u);
        u16 genDelta = 0u;
        if(index % 5u == 0u)
            genDelta = 1u;
        token.deviceGeneration = queue.deviceGeneration + genDelta;
        token.queue = CommandQueue::Compute;
        tokens.push_back(token);
    }
    const GpuSubmissionTokenVector original = tokens;
    GpuSubmissionExpectWaitStatistics(queue, Span<QueueSubmissionToken>());
    native(in queue, mut tokens, in original){
        GpuSubmissionExpectWaitStatistics(queue, tokens);
        Sort(tokens.begin(), tokens.end(), [](const auto& first, const auto& second)noexcept{ return first.value > second.value; });
        GpuSubmissionExpectWaitStatistics(queue, tokens);
        Sort(tokens.begin(), tokens.end(), [](const auto& first, const auto& second)noexcept{ return first.value < second.value; });
        ASSERT_EQ(tokens.size(), original.size());
        EXPECT_EQ(NWB_MEMCMP(tokens.data(), original.data(), tokens.size() * sizeof(tokens[0u])), 0);
    }
}

GpuGraphResourceId GpuSubmissionMakeResourceId(in u64 generation, in u32 index){
    GpuGraphResourceId id = GpuGraphResourceId();
    id.generation = generation;
    id.index = index;
    return id;
}

GpuTaskResourceUse GpuSubmissionBufferUseState(
    in GpuGraphResourceId resource,
    in u64 offset,
    in u64 size,
    in GpuSubmissionResourceStateMask state
){
    GpuTaskResourceUse use = GpuTaskResourceUse();
    use.resource = resource;
    use.range.bufferRange = BufferRange(offset, size);
    use.requiredState = state;
    use.access = GpuTaskResourceAccess::Write;
    return use;
}

GpuTaskResourceUse GpuSubmissionBufferUse(in GpuGraphResourceId resource, in u64 offset, in u64 size){
    return GpuSubmissionBufferUseState(resource, offset, size, ResourceStates::CopyDest);
}

b8 GpuSubmissionCollectFirstUseRanges(
    in GpuTaskGraphDeclarationReadView declarations,
    in GpuTaskGraphTaskView task,
    in usize useIndex,
    in GpuTaskGraphResourceView resource,
    in GpuTaskResourceRange range,
    mut GpuSubmissionUseIndexScope scope
){
    b8 result = false;
    native(in declarations, in task, in useIndex, in resource, in range, mut scope, mut result){
        result = Core::GpuTaskGraphCompilerDetail::CollectResourceFirstUseRangesWithinTask(
            declarations,
            task,
            scope.index,
            useIndex,
            resource,
            range,
            scope.scratchArena,
            scope.ranges
        );
    }
    return result;
}

void GpuSubmissionExpectBufferRanges(in GpuSubmissionRanges ranges, in Span<BufferRange> expected){
    ASSERT_EQ(ranges.size(), expected.size());
    for(usize index = 0u; index < expected.size(); ++index){
        const ScopedTestTrace trace = ScopedTestTrace(index);
        EXPECT_EQ(ranges[index].bufferRange, expected[index]);
    }
}

void VerifyGpuSubmission_RebuildResetsOnlyThePreviousTaskAndRejectsDetachedViews(){
    const GpuGraphResourceId resA = GpuSubmissionMakeResourceId(1u, 0u);
    const GpuGraphResourceId resB = GpuSubmissionMakeResourceId(1u, 1u);
    Array<GpuTaskResourceUse, 2> first = Array<GpuTaskResourceUse, 2>();
    first[0u] = GpuSubmissionBufferUse(resA, 0u, 16u);
    first[1u] = GpuSubmissionBufferUse(resA, 16u, 16u);
    Array<GpuTaskResourceUse, 1> second = Array<GpuTaskResourceUse, 1>();
    second[0u] = GpuSubmissionBufferUse(resB, 0u, 8u);
    const GpuTaskGraphTaskView taskA = MakeGpuSubmissionTaskView(first, 1u, 0u);
    const GpuTaskGraphTaskView taskB = MakeGpuSubmissionTaskView(second, 1u, 1u);
    GpuSubmissionUseIndexScope scope = GpuSubmissionUseIndexScope(3u, 1u, first.size());
    ASSERT_TRUE(scope.index.build(taskA));
    EXPECT_EQ(scope.index.first(GpuSubmissionMakeResourceId(1u, 2u)), s_GpuSubmissionNoUse);
    EXPECT_EQ(scope.index.next(first.size()), s_GpuSubmissionNoUse);
    ASSERT_TRUE(scope.index.build(taskB));
    EXPECT_FALSE(scope.index.validFor(taskA));
    EXPECT_EQ(scope.index.first(resA), s_GpuSubmissionNoUse);
    EXPECT_EQ(scope.index.first(resB), 0u);
    EXPECT_EQ(scope.index.next(0u), s_GpuSubmissionNoUse);

    GpuTaskGraphTaskView detached = taskB;
    detached.id.index = 2u;
    EXPECT_FALSE(scope.index.validFor(detached));
    detached = taskB;
    native(in first, mut detached){
        detached.resourceUses = first.data();
    }
    EXPECT_FALSE(scope.index.validFor(detached));
    detached = taskB;
    detached.resourceUseCount = 0u;
    EXPECT_FALSE(scope.index.validFor(detached));

    GpuTaskGraphTaskView empty = GpuTaskGraphTaskView();
    empty.id.generation = 1u;
    empty.id.index = 2u;
    ASSERT_TRUE(scope.index.build(empty));
    EXPECT_TRUE(scope.index.validFor(empty));
    EXPECT_EQ(scope.index.first(resB), s_GpuSubmissionNoUse);
    ASSERT_TRUE(scope.index.build(taskA));
    EXPECT_EQ(scope.index.next(0u), 1u);
}

void VerifyGpuSubmission_InvalidGenerationIdentityAndCapacityNeverPublishAUsableIndex(){
    const GpuGraphResourceId resA = GpuSubmissionMakeResourceId(1u, 0u);
    const GpuGraphResourceId resB = GpuSubmissionMakeResourceId(1u, 1u);
    Array<GpuTaskResourceUse, 2> uses = Array<GpuTaskResourceUse, 2>();
    uses[0u] = GpuSubmissionBufferUse(resA, 0u, 16u);
    uses[1u] = GpuSubmissionBufferUse(resB, 0u, 8u);
    const GpuTaskGraphTaskView task = MakeGpuSubmissionTaskView(uses, 1u, 0u);
    GpuSubmissionUseIndexScope scope = GpuSubmissionUseIndexScope(2u, 1u, uses.size());

    Array<GpuGraphResourceId, 3> invalidIds = Array<GpuGraphResourceId, 3>();
    invalidIds[0u] = GpuGraphResourceId();
    invalidIds[1u] = GpuSubmissionMakeResourceId(2u, 0u);
    invalidIds[2u] = GpuSubmissionMakeResourceId(1u, 2u);
    for(in GpuGraphResourceId invalidId : invalidIds){
        uses[0u].resource = invalidId;
        EXPECT_FALSE(scope.index.build(task));
        EXPECT_FALSE(scope.index.validFor(task));
        EXPECT_EQ(scope.index.first(resB), s_GpuSubmissionNoUse);
        uses[0u].resource = resA;
        ASSERT_TRUE(scope.index.build(task));
    }

    GpuTaskGraphTaskView invalid = task;
    invalid.id.generation = 2u;
    EXPECT_FALSE(scope.index.build(invalid));
    invalid = task;
    invalid.id = GpuTaskId();
    EXPECT_FALSE(scope.index.build(invalid));
    invalid = task;
    native(mut invalid){
        invalid.resourceUses = nullptr;
    }
    EXPECT_FALSE(scope.index.build(invalid));
    invalid = task;
    invalid.resourceUseCount = uses.size() + 1u;
    EXPECT_FALSE(scope.index.build(invalid));
    ASSERT_TRUE(scope.index.build(task));
    EXPECT_EQ(scope.index.first(resA), 0u);
    EXPECT_EQ(scope.index.first(resB), 1u);
}

void VerifyGpuSubmission_FirstOccurrenceReturnsNormalizedRangeAndStillRejectsEmptyRequest(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> bufferResult = AddBufferMetadata(graph, s_GpuCaseTaskUseFirst, "First Use Buffer");
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    ASSERT_TRUE(buffer.valid());
    Array<GpuTaskResourceUse, 1> uses = Array<GpuTaskResourceUse, 1>();
    uses[0u] = GpuSubmissionBufferUse(buffer, 32u, s_GpuSubmissionAllBytes);
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    const GpuTaskGraphTaskView task = MakeGpuSubmissionTaskView(uses, declarations.generation(), 0u);
    const GpuTaskGraphResourceView resource = declarations.resourceAt(buffer.index);
    GpuSubmissionUseIndexScope scope = GpuSubmissionUseIndexScope(declarations.resourceCount(), declarations.generation(), 1u);
    ASSERT_TRUE(scope.index.build(task));
    scope.ranges.reserve(1u);
    ASSERT_TRUE(GpuSubmissionCollectFirstUseRanges(declarations, task, 0u, resource, uses[0u].range, scope));
    Array<BufferRange, 1> expected = Array<BufferRange, 1>();
    expected[0u] = BufferRange(32u, s_GpuSubmissionAllBytes);
    GpuSubmissionExpectBufferRanges(scope.ranges, expected);
    EXPECT_FALSE(GpuSubmissionCollectFirstUseRanges(declarations, task, 0u, resource, GpuSubmissionBufferUse(buffer, 0u, 0u).range, scope));
    EXPECT_TRUE(scope.ranges.empty());
    EXPECT_FALSE(GpuSubmissionCollectFirstUseRanges(declarations, task, 1u, resource, uses[0u].range, scope));
}

void VerifyGpuSubmission_PartialAndDisjointEarlierUsesRetainSubtractionOrderAndUnknownStateCoverage(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> bufferResult = AddBufferMetadata(graph, s_GpuCaseTaskUsePartial, "Partial Use Buffer");
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    const Expected<GpuGraphResourceId> otherResult = AddBufferMetadata(graph, s_GpuCaseTaskUseOther, "Other Use Buffer");
    ASSERT_TRUE(otherResult.has_value());
    const GpuGraphResourceId other = otherResult.value();
    ASSERT_TRUE(buffer.valid());
    ASSERT_TRUE(other.valid());
    Array<GpuTaskResourceUse, 6> uses = Array<GpuTaskResourceUse, 6>();
    uses[0u] = GpuSubmissionBufferUse(buffer, 64u, 16u);
    uses[1u] = GpuSubmissionBufferUse(other, 0u, 0u);
    uses[2u] = GpuSubmissionBufferUseState(buffer, 32u, 16u, ResourceStates::Unknown);
    uses[3u] = GpuSubmissionBufferUse(buffer, 160u, 16u);
    uses[4u] = GpuSubmissionBufferUse(buffer, 0u, 128u);
    uses[5u] = GpuSubmissionBufferUse(buffer, 0u, 0u);
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    const GpuTaskGraphTaskView task = MakeGpuSubmissionTaskView(uses, declarations.generation(), 0u);
    const GpuTaskGraphResourceView resource = declarations.resourceAt(buffer.index);
    GpuSubmissionUseIndexScope scope = GpuSubmissionUseIndexScope(declarations.resourceCount(), declarations.generation(), uses.size());
    ASSERT_TRUE(scope.index.build(task));
    scope.ranges.reserve(3u);
    ASSERT_TRUE(GpuSubmissionCollectFirstUseRanges(declarations, task, 4u, resource, uses[4u].range, scope));
    Array<BufferRange, 3> expected = Array<BufferRange, 3>();
    expected[0u] = BufferRange(0u, 32u);
    expected[1u] = BufferRange(48u, 16u);
    expected[2u] = BufferRange(80u, 48u);
    GpuSubmissionExpectBufferRanges(scope.ranges, expected);
}

void VerifyGpuSubmission_CompleteCoverageStopsBeforeLaterInvalidRangeButSelectedInvalidPrefixStillFails(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> bufferResult = AddBufferMetadata(graph, s_GpuCaseTaskUseCovered, "Covered Buffer");
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    ASSERT_TRUE(buffer.valid());
    Array<GpuTaskResourceUse, 3> uses = Array<GpuTaskResourceUse, 3>();
    uses[0u] = GpuSubmissionBufferUse(buffer, 0u, 64u);
    uses[1u] = GpuSubmissionBufferUse(buffer, 0u, 0u);
    uses[2u] = GpuSubmissionBufferUse(buffer, 16u, 16u);
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    const GpuTaskGraphTaskView task = MakeGpuSubmissionTaskView(uses, declarations.generation(), 0u);
    const GpuTaskGraphResourceView resource = declarations.resourceAt(buffer.index);
    GpuSubmissionUseIndexScope scope = GpuSubmissionUseIndexScope(declarations.resourceCount(), declarations.generation(), uses.size());
    ASSERT_TRUE(scope.index.build(task));
    scope.ranges.reserve(2u);
    ASSERT_TRUE(GpuSubmissionCollectFirstUseRanges(declarations, task, 2u, resource, uses[2u].range, scope));
    EXPECT_TRUE(scope.ranges.empty());
    uses[0u].range = GpuSubmissionBufferUse(buffer, 0u, 8u).range;
    ASSERT_TRUE(scope.index.build(task));
    EXPECT_FALSE(GpuSubmissionCollectFirstUseRanges(declarations, task, 2u, resource, uses[2u].range, scope));
}

void VerifyGpuSubmission_SymbolicBufferTailSurvivesFinitePreviousUse(){
    TestArena testArena = TestArena();
