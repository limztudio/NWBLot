InputKeyBinding MakeUiInputKeyBinding(in i32 key, in i32 modifiers, in i32 ignoredModifiers, in InputCommandEnum command){
    InputKeyBinding binding = InputKeyBinding();
    binding.key = key;
    binding.modifiers = modifiers;
    binding.ignoredModifiers = ignoredModifiers;
    binding.command = command;
    return binding;
}

HitTarget MakeUiInputTargetAt(in u64 value, in Rect rectangle){
    HitTarget target = HitTarget();
    target.id = WidgetId(value);
    target.rectangle = rectangle;
    target.clip = Rect(0.0f, 0.0f, 100.0f, 100.0f);
    target.focusable = true;
    target.activatable = true;
    return target;
}

HitTarget MakeUiInputTarget(in u64 value){
    return MakeUiInputTargetAt(value, Rect(10.0f, 10.0f, 20.0f, 20.0f));
}

InputEvent MakeUiInputPointerAt(in InputEventTypeEnum type, in Point position){
    InputEvent event = InputEvent();
    event.type = type;
    event.position = position;
    return event;
}

InputEvent MakeUiInputPointer(in InputEventTypeEnum type){
    return MakeUiInputPointerAt(type, Point(15.0f, 15.0f));
}

InputEvent MakeUiInputKey(in InputEventTypeEnum type, in CoreKeyEnum key, in b8 repeat){
    InputEvent event = InputEvent();
    event.type = type;
    event.key = key;
    event.repeat = repeat;
    return event;
}

InputEvent MakeUiInputBareEvent(in InputEventTypeEnum type){
    InputEvent event = InputEvent();
    event.type = type;
    event.position = Point();
    return event;
}

IntegerBounds MakeUiIntegerBounds(in i64 minimum, in i64 maximum, in NumericBoundsPolicyEnum policy){
    IntegerBounds bounds = IntegerBounds();
    bounds.minimum = minimum;
    bounds.maximum = maximum;
    bounds.policy = policy;
    return bounds;
}

LayoutNodeDesc MakeUiLayoutStretchContainer(in LayoutDirectionEnum direction){
    LayoutNodeDesc description = LayoutNodeDesc();
    description.direction = direction;
    description.width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    description.height = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    return description;
}

LayoutNodeDesc MakeUiLayoutFixedLeaf(in f32 width, in f32 height){
    LayoutNodeDesc description = LayoutNodeDesc();
    description.width = LayoutSize(LayoutSizePolicy::Fixed, width);
    description.height = LayoutSize(LayoutSizePolicy::Fixed, height);
    return description;
}

ListResult MakeUiListBehaviorResult(in b8 valid, in b8 selectionChanged, in b8 activated, in b8 focused){
    ListResult result = ListResult();
    result.valid = valid;
    result.selectionChanged = selectionChanged;
    result.activated = activated;
    result.focused = focused;
    return result;
}


