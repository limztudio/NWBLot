////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_skeleton/joint_validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateSkeletonRuntimePayload(
    in b8 hasValidVirtualPath,
    in Span<SkeletonJoint> joints,
    in HashMap<Name, u32> jointIndices,
    mut ScratchSkeletonByteVector scratchNamedJoints
){
    if(!hasValidVirtualPath)
        return false;
    return ValidateSkeletonPayloadData(joints, jointIndices, scratchNamedJoints);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_skeleton/asset.adhd.h>

#include <core/assets/auto_registration.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_skeleton_runtime{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_DEFINE_ASSET_CODEC_REGISTRAR(s_SkeletonAssetCodecAutoRegistrar, SkeletonAssetCodec);
static_assert(sizeof(SkeletonHeaderBinary) == s_SkeletonHeaderBinaryBytes, "SkeletonHeaderBinary layout drifted");
static_assert(sizeof(SkeletonJointBinary) == s_SkeletonJointBinaryBytes, "SkeletonJointBinary layout drifted");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 Skeleton::validatePayload(Core::Alloc::ScratchArena& scratchArena)const{
    Vector<u8, Core::Alloc::ScratchArena> namedJoints(scratchArena);
    return ValidateSkeletonRuntimePayload(checkVirtualPath(NWB_TEXT("Skeleton::validatePayload")), m_joints, m_jointIndices, namedJoints);
}

b8 Skeleton::loadBinary(const Span<const u8> binary){
    Core::Alloc::ScratchArena scratchArena(s_AssetsSkeletonLoadBinaryArena);
    Skeleton candidate(m_joints.get_allocator().arena(), virtualPath());
    if(!DeserializeSkeletonBinaryPayload(binary, candidate.m_joints, candidate.m_jointIndices))
        return false;
    if(!candidate.validatePayload(scratchArena))
        return false;
    *this = Move(candidate);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


