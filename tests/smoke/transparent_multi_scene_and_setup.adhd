namespace Tests::Smoke{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TransparentMultiSceneTransforms final{
public:
    static constexpr f32 s_CameraTargetY = s_TransparentMultiCameraTargetY;
    static constexpr Float4 s_TransparentLeftShapeBasePosition{ -0.68f, s_CameraTargetY, 0.02f, 0.0f };
    static constexpr Float4 s_TransparentCenterShapeBasePosition{ 0.0f, s_CameraTargetY, 0.0f, 0.0f };
    static constexpr Float4 s_TransparentRightShapeBasePosition{ 0.68f, s_CameraTargetY, 0.04f, 0.0f };
    static constexpr Float4 s_OpaqueLeftShapeBasePosition{ -0.34f, s_CameraTargetY, 0.30f, 0.0f };
    static constexpr Float4 s_OpaqueRightShapeBasePosition{ 0.34f, s_CameraTargetY, 0.30f, 0.0f };


public:
    void update(f32 yaw, Core::ECS::World& world)const noexcept;


public:
    Core::ECS::EntityID leftShape = {};
    Core::ECS::EntityID centerShape = {};
    Core::ECS::EntityID rightShape = {};
    Core::ECS::EntityID opaqueLeftShape = {};
    Core::ECS::EntityID opaqueRightShape = {};
#if defined(NWB_TRANSPARENT_MULTI_ENABLE_CSG)
    Core::ECS::EntityID csgReceiver = {};
    Core::ECS::EntityID csgCutter = {};
#endif
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_transparent_multi_scene_transforms{

#if defined(NWB_TRANSPARENT_MULTI_ENABLE_CSG)
using NWB::Tests::Smoke::AssignCsgCutterTransform;
#endif

static void ApplyTransparentSceneTransform(const NWB::Core::ECS::EntityID entity, const Float4& basePosition, const SIMDVectorSingle sceneRotation, const SIMDVectorSingle localRotation, NWB::Core::ECS::World& world)noexcept{
    auto* transform = world.tryGetComponent<NWB::Impl::Scene::TransformComponent>(entity);
    if(!transform)
        return;

    SIMDVectorSingle position;
    SIMDVectorSingle rotation;
    ComputeTransparentSceneTransform(LoadFloat(basePosition), sceneRotation, localRotation, position, rotation);
    StoreFloat(position, transform->position);
    StoreFloat(rotation, transform->rotation);
}

#if defined(NWB_TRANSPARENT_MULTI_ENABLE_CSG)
static void ApplyTransparentCsgSceneTransform(
    const NWB::Core::ECS::EntityID receiverEntity,
    const NWB::Core::ECS::EntityID cutterEntity,
    const Float4& receiverBasePosition,
    const SIMDVectorSingle sceneRotation,
    const SIMDVectorSingle localRotation,
    NWB::Core::ECS::World& world
)noexcept{
    SIMDVectorSingle receiverPosition;
    SIMDVectorSingle receiverRotation;
    ComputeTransparentSceneTransform(LoadFloat(receiverBasePosition), sceneRotation, localRotation, receiverPosition, receiverRotation);

    if(auto* transform = world.tryGetComponent<NWB::Impl::Scene::TransformComponent>(receiverEntity)){
        StoreFloat(receiverPosition, transform->position);
        StoreFloat(receiverRotation, transform->rotation);
    }

    if(auto* cutter = world.tryGetComponent<NWB::Impl::CsgCutterComponent>(cutterEntity))
        AssignCsgCutterTransform(receiverPosition, receiverRotation, *cutter);
}
#endif

};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void TransparentMultiSceneTransforms::update(const f32 yaw, Core::ECS::World& world)const noexcept{
    using namespace __hidden_transparent_multi_scene_transforms;
    const SIMDVectorSingle sceneRotation = BuildTransparentSceneRotation(yaw);
    ApplyTransparentSceneTransform(leftShape, s_TransparentLeftShapeBasePosition, sceneRotation, QuaternionIdentity(), world);
#if defined(NWB_TRANSPARENT_MULTI_ENABLE_CSG)
    ApplyTransparentCsgSceneTransform(csgReceiver, csgCutter, s_TransparentCenterShapeBasePosition, sceneRotation, BuildTransparentCsgRotation(yaw), world);
#else
    ApplyTransparentSceneTransform(centerShape, s_TransparentCenterShapeBasePosition, sceneRotation, QuaternionIdentity(), world);
#endif
    ApplyTransparentSceneTransform(rightShape, s_TransparentRightShapeBasePosition, sceneRotation, QuaternionIdentity(), world);
    ApplyTransparentSceneTransform(opaqueLeftShape, s_OpaqueLeftShapeBasePosition, sceneRotation, QuaternionIdentity(), world);
    ApplyTransparentSceneTransform(opaqueRightShape, s_OpaqueRightShapeBasePosition, sceneRotation, QuaternionIdentity(), world);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TransparentMultiScene final{
public:
    static constexpr f32 s_DefaultDirectionalLightPitch = s_TransparentMultiDefaultDirectionalLightPitch;
    static constexpr f32 s_DefaultDirectionalLightYaw = s_TransparentMultiDefaultDirectionalLightYaw;
    static constexpr f32 s_DefaultDirectionalLightIntensity = s_TransparentMultiDefaultDirectionalLightIntensity;
    static constexpr f32 s_CausticSphereScale = s_TransparentMultiCausticSphereScale;


public:
    [[nodiscard]] static b8 Populate(f32 cameraDistance, b8 causticTiming, f32 yaw, Core::ECS::World& world, TransparentMultiSceneTransforms& transforms);
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_transparent_multi_scene{

using Tests::Smoke::CreateSmokeCamera;
using Tests::Smoke::CreateTintedStaticMeshEntity;
using Tests::Smoke::ReadSmokeEnvironmentF32;
#if defined(NWB_TRANSPARENT_MULTI_ENABLE_CSG)
using Tests::Smoke::AddStaticCsgMeshReceiver;
using Tests::Smoke::AssignCsgCutterParameters;
using Tests::Smoke::AssignCsgCutterTransform;
#endif

using TransparentMeshRef = Core::Assets::AssetRef<Impl::Mesh>;
using TransparentMaterialRef = Core::Assets::AssetRef<Impl::Material>;

#if defined(NWB_TRANSPARENT_MULTI_CAUSTIC_SPHERE)
static constexpr TransparentMeshRef s_TransparentShapeMesh{"project/meshes/caustic_sphere"};
#else
static constexpr TransparentMeshRef s_TransparentLeftMesh{"project/meshes/cylinder"};
static constexpr TransparentMeshRef s_TransparentCenterMesh{"project/meshes/octahedron"};
static constexpr TransparentMeshRef s_TransparentRightMesh{"project/meshes/cone"};
#endif
static constexpr TransparentMeshRef s_ShadowPlaneMesh{"project/meshes/shadow_plane"};
static constexpr TransparentMaterialRef s_TransparentSharedMaterial{"project/smoke/transparent_multi/materials/shared"};
static constexpr TransparentMaterialRef s_GroundMaterial{"project/smoke/transparent_multi/materials/ground"};
#if defined(NWB_TRANSPARENT_MULTI_ENABLE_CSG)
static constexpr TransparentMaterialRef s_TransparentCsgMaterial{"project/smoke/transparent_multi/materials/csg_center"};
static constexpr Name s_TransparentCsgReceiverGroup = NWB::Tests::Smoke::s_SmokeNameProjectSmokeTransparentMultiCenterReceiver;
#endif

#if defined(NWB_TRANSPARENT_MULTI_CAUSTIC_SPHERE)
[[nodiscard]] static b8 CreateCausticRefractionBackdrop(NWB::Core::ECS::World& world){
    constexpr TransparentMaterialRef s_BackdropMaterial{"project/smoke/refraction/materials/opaque"};
    for(u32 stripe = 0u; stripe < 24u; ++stripe){
        const f32 value = (stripe & 1u) != 0u ? 0.92f : 0.04f;
        const f32 x = static_cast<f32>(stripe) * 0.2f - 2.3f;
        const auto entity = CreateTintedStaticMeshEntity(s_ShadowPlaneMesh, s_BackdropMaterial, s_SmokeSurfaceMaterialInterface, Float4(value, value, value, 1.0f), Float4(x, TransparentMultiSceneTransforms::s_CameraTargetY, 2.2f, 0.0f), Float4(0.1f, 1.0f, 1.3f, 0.0f), world);
        if(!entity.valid()){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("CausticSphereSmokeProject: failed to create screen refraction backdrop"));
            return false;
        }
        auto& transform = world.entity(entity).getComponent<NWB::Impl::Scene::TransformComponent>();
        StoreFloat(QuaternionRotationRollPitchYaw(-s_PIDIV2, 0.0f, 0.0f), transform.rotation);
    }
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("CausticSphereSmokeProject: screen refraction striped backdrop created (24 opaque strips)"));
    return true;
}
#endif


[[nodiscard, maybe_unused]] static Name TransparentCenterCsgReceiverGroup()noexcept{
#if defined(NWB_TRANSPARENT_MULTI_ENABLE_CSG)
    return s_TransparentCsgReceiverGroup;
#else
    return s_NameNone;
#endif
}

#if defined(NWB_TRANSPARENT_MULTI_ENABLE_CSG)
[[nodiscard]] static NWB::Core::ECS::EntityID CreateTransparentCsgPlaneCutter(NWB::Core::ECS::World& world){
    auto cutterEntity = world.createEntity();
    auto& cutter = cutterEntity.addComponent<NWB::Impl::CsgCutterComponent>();
    cutter.receiverGroup = s_TransparentCsgReceiverGroup;
    cutter.shapeType = Name(NWB::Impl::s_CsgPlaneShapeName);
    cutter.active = !NWB::Tests::Smoke::ReadSmokeEnvironmentFlag("NWB_TRANSPARENT_CSG_DISABLE_CUTTER");
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("TransparentCsgSmokeProject: cutter active {}"), cutter.active);

    NWB::Impl::CsgPlaneShapeParameters parameters;
    parameters.normalDistance = Float4(0.0f, -1.0f, 0.0f, 0.0f);
    AssignCsgCutterParameters(parameters, cutter);
    AssignCsgCutterTransform(VectorSet(0.0f, TransparentMultiSceneTransforms::s_CameraTargetY, 0.0f, 0.0f), QuaternionIdentity(), cutter);
    return cutterEntity.id();
}
#endif

[[nodiscard]] static NWB::Core::ECS::EntityID CreateTransparentStaticMeshEntity(
    const TransparentMeshRef& mesh,
    const TransparentMaterialRef& material,
    const Float4& colorTint,
    const Float4& position,
    const Float4& scale,
    NWB::Core::ECS::World& world,
    [[maybe_unused]] const Name csgReceiverGroup = s_NameNone
){
    const NWB::Core::ECS::EntityID entity = CreateTintedStaticMeshEntity(mesh, material, s_SmokeSurfaceMaterialInterface, colorTint, position, scale, world);
    if(!entity.valid())
        return NWB::Core::ECS::s_InvalidEntityId;

#if defined(NWB_TRANSPARENT_MULTI_ENABLE_CSG)
    if(csgReceiverGroup)
        AddStaticCsgMeshReceiver(entity, csgReceiverGroup, false, true, world);
#endif

    return entity;
}


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 TransparentMultiScene::Populate(const f32 cameraDistance, [[maybe_unused]] const b8 causticTiming, const f32 yaw, Core::ECS::World& world, TransparentMultiSceneTransforms& transforms){
    using namespace __hidden_transparent_multi_scene;
    const NWB::Core::ECS::EntityID activeCamera = CreateSmokeCamera(TransparentMultiSceneTransforms::s_CameraTargetY, cameraDistance, 0.0f, world);
    const auto lightEntity = NWB::Impl::Scene::CreateDirectionalLightEntity(world, s_DefaultDirectionalLightPitch, s_DefaultDirectionalLightYaw, 0.0f, Float4(1.0f, 0.96f, 0.88f), s_DefaultDirectionalLightIntensity);
#if defined(NWB_TRANSPARENT_MULTI_CAUSTIC_SPHERE)
    const auto causticSetting = ReadSmokeEnvironmentF32("NWB_CAUSTIC_SMOKE_ENABLED");
    const b8 causticsEnabled = !causticSetting || *causticSetting != 0.0f;
    world.entity(lightEntity).getComponent<NWB::Impl::Scene::LightComponent>().enableCaustics = causticsEnabled;
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("CausticSphereSmokeProject: caustics {}"), causticsEnabled ? FOUNDATION_TEXT("enabled") : FOUNDATION_TEXT("disabled"));
#else
    world.entity(lightEntity).getComponent<NWB::Impl::Scene::LightComponent>().enableCaustics = false;
#endif

#if defined(NWB_TRANSPARENT_MULTI_CAUSTIC_SPHERE)
    const auto centerShapeEntity = CreateTransparentStaticMeshEntity(
        s_TransparentShapeMesh,
        s_TransparentSharedMaterial,
        Float4(0.55f, 0.78f, 1.0f, 0.30f),
        TransparentMultiSceneTransforms::s_TransparentCenterShapeBasePosition,
        Float4(s_CausticSphereScale, s_CausticSphereScale, s_CausticSphereScale),
        world
    );
    transforms.centerShape = centerShapeEntity;
    const b8 shapesValid = centerShapeEntity.valid();
    if(shapesValid)
        world.entity(centerShapeEntity).getComponent<NWB::Impl::RendererComponent>().opticalBoundaryMode = NWB::Impl::OpticalBoundaryMode::ClosedNested;
#else
    const auto shapeEntity = CreateTransparentStaticMeshEntity(s_TransparentLeftMesh, s_TransparentSharedMaterial, Float4(1.0f, 0.42f, 0.20f, 0.42f), TransparentMultiSceneTransforms::s_TransparentLeftShapeBasePosition, Float4(0.62f, 0.62f, 0.62f), world);
    const auto centerShapeEntity = CreateTransparentStaticMeshEntity(
        s_TransparentCenterMesh,
#if defined(NWB_TRANSPARENT_MULTI_ENABLE_CSG)
        s_TransparentCsgMaterial,
        Float4(0.02f, 1.0f, 0.05f, 0.60f),
#else
        s_TransparentSharedMaterial,
        Float4(0.10f, 1.0f, 0.45f, 0.42f),
#endif
        TransparentMultiSceneTransforms::s_TransparentCenterShapeBasePosition, Float4(0.78f, 0.78f, 0.78f), world, TransparentCenterCsgReceiverGroup()
    );
    const auto rightShapeEntity = CreateTransparentStaticMeshEntity(s_TransparentRightMesh, s_TransparentSharedMaterial, Float4(0.12f, 0.44f, 1.0f, 0.42f), TransparentMultiSceneTransforms::s_TransparentRightShapeBasePosition, Float4(0.68f, 0.68f, 0.68f), world);
    transforms.leftShape = shapeEntity;
    transforms.centerShape = centerShapeEntity;
    transforms.rightShape = rightShapeEntity;

    const auto opaqueLeftEntity = CreateTintedStaticMeshEntity(s_TransparentCenterMesh, s_GroundMaterial, s_SmokeSurfaceMaterialInterface, Float4(0.66f, 0.66f, 0.70f, 1.0f), TransparentMultiSceneTransforms::s_OpaqueLeftShapeBasePosition, Float4(0.26f, 0.26f, 0.26f), world);
    const auto opaqueRightEntity = CreateTintedStaticMeshEntity(s_TransparentRightMesh, s_GroundMaterial, s_SmokeSurfaceMaterialInterface, Float4(0.72f, 0.68f, 0.62f, 1.0f), TransparentMultiSceneTransforms::s_OpaqueRightShapeBasePosition, Float4(0.26f, 0.26f, 0.26f), world);
    transforms.opaqueLeftShape = opaqueLeftEntity;
    transforms.opaqueRightShape = opaqueRightEntity;

    const b8 shapesValid = shapeEntity.valid() && centerShapeEntity.valid() && rightShapeEntity.valid() && opaqueLeftEntity.valid() && opaqueRightEntity.valid();
#endif

    const auto shadowPlaneEntity = CreateTintedStaticMeshEntity(
        s_ShadowPlaneMesh,
        s_GroundMaterial,
        s_SmokeSurfaceMaterialInterface,
#if defined(NWB_TRANSPARENT_MULTI_CAUSTIC_SPHERE)
        Float4(1.0f, 1.0f, 1.0f, 1.0f),
#else
        Float4(0.08f, 0.08f, 0.08f, 1.0f),
#endif
        Float4(0.0f, -0.08f, 0.08f), Float4(1.75f, 1.0f, 1.55f), world
    );
#if defined(NWB_TRANSPARENT_MULTI_CAUSTIC_SPHERE)
    if(NWB::Tests::Smoke::ReadSmokeEnvironmentFlag("NWB_CAUSTIC_SMOKE_SCREEN_REFRACTION_BACKDROP") && !CreateCausticRefractionBackdrop(world))
        return false;
#endif
#if defined(NWB_TRANSPARENT_MULTI_ENABLE_CSG)
    const auto cutterEntity = CreateTransparentCsgPlaneCutter(world);
    const b8 csgEntitiesValid = cutterEntity.valid();
    transforms.csgReceiver = centerShapeEntity;
    transforms.csgCutter = cutterEntity;
#else
    const b8 csgEntitiesValid = true;
#endif
    transforms.update(yaw, world);
    FOUNDATION_FATAL_ASSERT_MSG(activeCamera.valid() && lightEntity.valid() && shapesValid && shadowPlaneEntity.valid() && csgEntitiesValid, FOUNDATION_TEXT("TransparentMultiSmokeProjectImpl failed to create all scene entities"));

#if defined(NWB_TRANSPARENT_MULTI_CAUSTIC_SPHERE)
    if(causticTiming){
        const auto& camera = world.entity(activeCamera).getComponent<NWB::Impl::Scene::CameraComponent>();
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("CausticTimingProbe: vertical FOV radians {}"), camera.verticalFovRadians());
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("CausticTimingProbe: scene single-static-sphere-ground-v1"));
    }
#endif
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("TransparentMultiSmokeProjectImpl: shared transparent material with three mutable instance overrides created"));
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TransparentMultiRendererSetup final{
public:
    static void Configure(Core::ECS::World& world, ProjectRuntimeContext& context);
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void TransparentMultiRendererSetup::Configure(Core::ECS::World& world, ProjectRuntimeContext& context){
#if defined(NWB_TRANSPARENT_MULTI_CAUSTIC_SPHERE)
    static constexpr AStringView s_CausticTimingEnvironment = s_TransparentMultiCausticTimingEnvironment;
#endif
    const b8 rayQueryHardwareAvailable = context.graphics.queryFeatureSupport(NWB::Core::Feature::RayTracingAccelStruct) && context.graphics.queryFeatureSupport(NWB::Core::Feature::RayQuery);
    if(rayQueryHardwareAvailable)
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("TransparentMultiSmokeProjectImpl: natural hardware shadow route selected on RayQuery-capable hardware"));
    else
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("TransparentMultiSmokeProjectImpl: natural software-only shadow route selected because RayQuery-capable hardware is unavailable"));

#if defined(NWB_TRANSPARENT_MULTI_FRAME_LAGGED_ASYNC_LIGHTING_SMOKE)
    auto& rendererSystem = AddSmokeRenderSystems(world, context);
    rendererSystem.setFrameLaggedAsyncLightingEnabled(true);
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("FrameLaggedAsyncLightingSmoke: requested frame-lagged async lighting; F1 toggles the current-frame path"));
#elif defined(NWB_TRANSPARENT_MULTI_CAUSTIC_SPHERE)
    NWB::Core::Alloc::ScratchArena scratchArena(NWB::Tests::Smoke::s_SmokeEnvironmentArena);
    auto& rendererSystem = AddSmokeRenderSystems(world, context);
    const auto refractionSetting = ReadSmokeEnvironmentF32("NWB_REFRACTION_SMOKE_ENABLED");
    const b8 refractionEnabled = !refractionSetting || *refractionSetting != 0.0f;
    const auto hardwareSetting = ReadSmokeEnvironmentF32("NWB_REFRACTION_SMOKE_HARDWARE");
    const b8 hardwareEnabled = !hardwareSetting || *hardwareSetting != 0.0f;
    rendererSystem.setRefractionEnabled(refractionEnabled);
    rendererSystem.setRefractionHardwareTracingEnabled(hardwareEnabled);
    NWB::Impl::ReflectionSettings reflectionSettings;
    const auto reflectionModeText = NWB::Tests::Smoke::ReadSmokeEnvironmentText(scratchArena, "NWB_REFLECTION_SMOKE_MODE");
    if(reflectionModeText){
        const AStringView mode(reflectionModeText->data(), reflectionModeText->size());
        if(mode == "disabled")
            reflectionSettings.traceMode = NWB::Impl::ReflectionTraceMode::Disabled;
        else if(mode == "hardware")
            reflectionSettings.traceMode = NWB::Impl::ReflectionTraceMode::Hardware;
        else if(mode == "screen")
            reflectionSettings.traceMode = NWB::Impl::ReflectionTraceMode::ScreenSpace;
        else
            FOUNDATION_FATAL_ASSERT_MSG(mode == "hybrid", FOUNDATION_TEXT("CausticSphereSmokeProject: invalid reflection mode"));
    }
    if(NWB::Tests::Smoke::ReadSmokeEnvironmentFlag("NWB_CAUSTIC_SMOKE_REFLECTION_COMPARISON")){
        reflectionSettings.environmentTop = Float3U(0.6f, 0.7f, 1.0f);
        reflectionSettings.environmentBottom = reflectionSettings.environmentTop;
        reflectionSettings.maxHardwareRaysPerFrame = 2u * 1280u * 900u;
        reflectionSettings.temporalEnabled = false;
        reflectionSettings.spatialFilterEnabled = false;
    }
    if(NWB::Tests::Smoke::ReadSmokeEnvironmentFlag(s_CausticTimingEnvironment)){
        reflectionSettings.diagnosticsEnabled = false;
        reflectionSettings.temporalEnabled = false;
        reflectionSettings.spatialFilterEnabled = false;
        reflectionSettings.screenFeedbackEnabled = false;
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("CausticTimingProbe: reflection diagnostics {} temporal {} spatial {} feedback {}")
            , reflectionSettings.diagnosticsEnabled
            , reflectionSettings.temporalEnabled
            , reflectionSettings.spatialFilterEnabled
            , reflectionSettings.screenFeedbackEnabled
        );
    }
    FOUNDATION_FATAL_ASSERT_MSG(rendererSystem.setReflectionSettings(reflectionSettings), FOUNDATION_TEXT("CausticSphereSmokeProject: invalid reflection settings"));
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("CausticSphereSmokeProject: reflection mode {}"), static_cast<u32>(reflectionSettings.traceMode));
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("CausticSphereSmokeProject: camera refraction {}"), refractionEnabled ? FOUNDATION_TEXT("enabled") : FOUNDATION_TEXT("disabled"));
#elif defined(NWB_TRANSPARENT_MULTI_ENABLE_CSG)
    auto& rendererSystem = AddSmokeRenderSystems(world, context);
    rendererSystem.setRefractionEnabled(false);
    NWB::Impl::ReflectionSettings reflectionSettings;
    reflectionSettings.traceMode = NWB::Impl::ReflectionTraceMode::Disabled;
    FOUNDATION_FATAL_ASSERT_MSG(rendererSystem.setReflectionSettings(reflectionSettings), FOUNDATION_TEXT("TransparentCsgSmokeProject: invalid reflection settings"));
#else
    AddSmokeRenderSystems(world, context);
#endif
}


