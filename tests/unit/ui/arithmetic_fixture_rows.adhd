u64 ArithmeticFixtureRowKey(in u64 count, in u64 removed, in b8 reverse, in u64 index){
    u64 forward = index;
    if(reverse)
        forward = count - 1u - index;
    const u64 value = forward + 1u;
    if(removed != 0u && value >= removed)
        return value + 1u;
    return value;
}

Expected<u64> FindArithmeticFixtureRowIndex(in u64 count, in u64 removed, in b8 reverse, in u64 value){
    u64 maxCount = count;
    if(removed != 0u)
        maxCount = count + 1u;
    if(value == 0u || value == removed || value > maxCount)
        return MakeUnexpected(Failure());
    u64 forward = value - 1u;
    if(removed != 0u && value > removed)
        forward -= 1u;
    u64 index = forward;
    if(reverse)
        index = count - 1u - forward;
    if(index < count)
        return index;
    return MakeUnexpected(Failure());
}

Expected<u64> FindSingleDisabledFixtureRowByKey(in u64 count, in u64 start, in b8 backwards, in u64 startKey, in u64 disabled){
    if(start >= count)
        return MakeUnexpected(Failure());
    if(startKey != disabled)
        return start;
    if(backwards){
        if(start == 0u)
            return MakeUnexpected(Failure());
        return start - 1u;
    }
    if(start + 1u == count)
        return MakeUnexpected(Failure());
    return start + 1u;
}

Expected<u64> FindSingleDisabledFixtureRow(in u64 count, in u64 removed, in b8 reverse, in u64 start, in b8 backwards, in u64 disabled){
    if(start >= count)
        return MakeUnexpected(Failure());
    return FindSingleDisabledFixtureRowByKey(count, start, backwards, ArithmeticFixtureRowKey(count, removed, reverse, start), disabled);
}


