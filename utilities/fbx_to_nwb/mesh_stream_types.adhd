////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <utilities/fbx_to_nwb/mesh_stream_records.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StringView NormalModeText(in NormalMode normalMode){
    switch(normalMode){
        case NormalMode::Imported: return s_DefaultNormalModeText;
        case NormalMode::Smooth: return s_SmoothNormalModeText;
        case NormalMode::Regenerate: return s_RegenerateNormalModeText;
    }
    return "";
}

StringView SourceTangentModeText(in SourceTangentMode mode){
    switch(mode){
        case SourceTangentMode::Imported: return s_DefaultNormalModeText;
        case SourceTangentMode::GeneratedUv: return s_GeneratedUvTangentModeText;
        case SourceTangentMode::GeneratedFallback: return s_GeneratedFallbackTangentModeText;
    }
    return "";
}

void AccumulateReport(in SourceMeshCanonicalizeReport item, mut SourceMeshCanonicalizeReport inOutTotal){
    inOutTotal.before.positions += item.before.positions;
    inOutTotal.before.normals += item.before.normals;
    inOutTotal.before.tangents += item.before.tangents;
    inOutTotal.before.uv0 += item.before.uv0;
    inOutTotal.before.colors += item.before.colors;
    inOutTotal.before.skin += item.before.skin;
    inOutTotal.before.vertexRefs += item.before.vertexRefs;
    inOutTotal.before.indices += item.before.indices;

    inOutTotal.after.positions += item.after.positions;
    inOutTotal.after.normals += item.after.normals;
    inOutTotal.after.tangents += item.after.tangents;
    inOutTotal.after.uv0 += item.after.uv0;
    inOutTotal.after.colors += item.after.colors;
    inOutTotal.after.skin += item.after.skin;
    inOutTotal.after.vertexRefs += item.after.vertexRefs;
    inOutTotal.after.indices += item.after.indices;
}

u64 PositionSkinKey(in u32 position, in u32 skin){
    return (cast<u64>(position) << s_PositionSkinKeySkinShiftBits) | cast<u64>(skin);
}

f32 CleanFloat(in f32 value){
    if(Abs(value) < s_CleanFloatEpsilon)
        return 0.0f;
    return value;
}

b8 ValidateFbxSkinPositionCount(in usize positionCount, in usize influenceCount){
    if(positionCount != influenceCount){
        error("Failed to canonicalize skinned mesh: position and skin influence counts must match");
        return false;
    }
    return true;
}

b8 ValidateFbxMeshAttributes(in b8 hasPositions, in b8 requiresImportedNormals, in b8 hasNormals){
    if(!hasPositions){
        error("Failed to build mesh: mesh is missing positions");
        return false;
    }
    if(requiresImportedNormals && !hasNormals){
        error("Failed to build mesh: imported normal mode requires mesh normals after ufbx import");
        return false;
    }
    return true;
}

b8 ValidateFbxSkinDeformerCount(in usize count){
    if(count != 1u){
        error("Failed to build mesh: skinned mesh requires exactly one skin deformer per selected mesh");
        return false;
    }
    return true;
}

b8 TryAccumulateFbxSelectedTriangleCorners(in usize triangleCount, mut usize inOutCornerCount){
    if(triangleCount > (usize.max - inOutCornerCount) / cast<usize>(s_MeshletTriangleIndexCount)){
        error("Failed to build mesh: selected meshes have too many triangle corners");
        return false;
    }
    inOutCornerCount += triangleCount * cast<usize>(s_MeshletTriangleIndexCount);
    return true;
}

b8 HasSourceMeshStreamValueCapacity(in usize count){
    return count < cast<usize>(s_MeshMissingStreamIndex);
}

b8 HasUsableSourceTriangleArea(in f64 areaLengthSquared, in f64 minimumAreaLengthSquared){
    return IsFinite(areaLengthSquared) && !(areaLengthSquared <= minimumAreaLengthSquared);
}

SourceTangentMode ResolveGeneratedSourceTangentMode(in b8 usedDefaultUvs, in u32 degenerateUvTriangleCount, in u32 fallbackTangentVertexCount){
    if(usedDefaultUvs || degenerateUvTriangleCount != 0u || fallbackTangentVertexCount != 0u)
        return SourceTangentMode::GeneratedFallback;
    return SourceTangentMode::GeneratedUv;
}

b8 SourceVertexRefsHaveCompleteTangents(in Span<SourceVertexRef> vertexRefs, in usize tangentCount){
    if(vertexRefs.empty() || tangentCount == 0u)
        return false;
    for(in SourceVertexRef ref : vertexRefs){
        if(cast<usize>(ref.tangent) >= tangentCount)
            return false;
    }
    return true;
}

VectorSingle ResolveImportedFbxTangent(
    in VectorSingle normal,
    in VectorSingle tangent,
    in b8 hasBitangent,
    in VectorSingle bitangent
){
    f32 sign = 1.0f;
    if(hasBitangent){
        const VectorSingle tangentSpaceBitangent = Cross(normal.xyz, tangent.xyz);
        if(Dot(tangentSpaceBitangent.xyz, bitangent.xyz) < 0.0f)
            sign = -1.0f;
    }
    return VectorSingle(tangent, sign);
}

b8 SourceVertexRefsHaveNoSkin(in Span<SourceVertexRef> vertexRefs){
    for(in SourceVertexRef ref : vertexRefs){
        if(ref.skin != s_MeshMissingStreamIndex)
            return false;
    }
    return true;
}

b8 DidSourceMeshComponentRefsChange(in SourceMeshStreamCounts before, in SourceMeshStreamCounts after){
    return
        before.positions != after.positions
        || before.normals != after.normals
        || before.tangents != after.tangents
        || before.uv0 != after.uv0
        || before.colors != after.colors
        || before.vertexRefs != after.vertexRefs
    ;
}

b8 RemapRequiredSourceStreamIndex(in Span<u32> remap, in StringView streamName, mut u32 inOutIndex){
    if(cast<usize>(inOutIndex) < remap.size()){
        inOutIndex = remap[cast<usize>(inOutIndex)];
        return true;
    }
    error("Failed to canonicalize mesh: vertex_ref {} index is out of range", streamName);
    return false;
}

b8 RemapOptionalSourceStreamIndex(in Span<u32> remap, in StringView streamName, mut u32 inOutIndex){
    if(inOutIndex == s_MeshMissingStreamIndex)
        return true;
    return RemapRequiredSourceStreamIndex(remap, streamName, inOutIndex);
}

b8 RemapSourceVertexRef(
    in Span<u32> positions,
    in Span<u32> normals,
    in Span<u32> tangents,
    in Span<u32> uv0,
    in Span<u32> colors,
    in Span<u32> skin,
    mut SourceVertexRef inOutRef
){
    if(!RemapRequiredSourceStreamIndex(positions, s_VertexRefPositionName, inOutRef.position))
        return false;
    if(!RemapRequiredSourceStreamIndex(normals, s_VertexRefNormalName, inOutRef.normal))
        return false;
    if(!RemapRequiredSourceStreamIndex(tangents, s_VertexRefTangentName, inOutRef.tangent))
        return false;
    if(!RemapRequiredSourceStreamIndex(uv0, s_MeshUv0FieldNameView, inOutRef.uv0))
        return false;
    if(!RemapRequiredSourceStreamIndex(colors, s_VertexRefColorName, inOutRef.color))
        return false;
    return RemapOptionalSourceStreamIndex(skin, s_SkinStreamLabel, inOutRef.skin);
}


