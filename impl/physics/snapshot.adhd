#include <impl/physics/world.adhd>
#include <impl/physics/buoyancy.adhd>
#include <impl/physics/soft_body.adhd>
#include <impl/physics/vehicle.adhd>
#include <impl/physics/ragdoll.adhd>
#include <impl/physics/character_controller.adhd>
#include <impl/physics/articulation.adhd>
#include <impl/physics/fracture.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_SnapshotMagic = 0x50534E57u;
const u32 s_SnapshotVersion = 6u;
const u32 s_DeltaSnapshotMagic = 0x4442574eu;
const u32 s_DeltaSnapshotVersion = 1u;
const u32 s_SubsystemsSnapshotMagic = 0x50535353u;
const u32 s_SubsystemsSnapshotVersion = 4u;
const u32 s_SubsystemsDeltaSnapshotMagic = 0x50535344u;
const u32 s_SubsystemsDeltaSnapshotVersion = 1u;
const u32 s_FullSnapshotMagic = 0x50534657u;
const u32 s_FullSnapshotVersion = 3u;
const u32 s_FullDeltaSnapshotMagic = 0x50534644u;
const u32 s_FullDeltaSnapshotVersion = 1u;
const u32 s_SnapshotMaxElements = 16777216u;
const u64 s_Fnv64OffsetBasis = 14695981039346656037u;
const u64 s_Fnv64Prime = 1099511628211u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u64 SnapshotFnv1a64(in Span<u8> data){
    u64 h = s_Fnv64OffsetBasis;
    for(usize i = 0u; i < data.size(); ++i){
        h ^= cast<u64>(data[i]);
        h *= s_Fnv64Prime;
    }
    return h;
}

interface ISnapshotSink{
    void writeU8(in u8 v);
    void writeB8(in b8 v);
    void writeU16(in u16 v);
    void writeI16(in i16 v);
    void writeU32(in u32 v);
    void writeI32(in i32 v);
    void writeU64(in u64 v);
    void writeF32(in f32 v);
    void writeF64(in f64 v);
    b8 writeCount(in usize n);
    void writeBytes(in Span<u8> data);
    void writeU16Span(in Span<u16> data);
    void writeU32Span(in Span<u32> data);
    void writeF32Span(in Span<f32> data);
    usize byteCount()const;
}

class SnapshotFnv1a64Sink : ISnapshotSink{
    public u64 hash = s_Fnv64OffsetBasis;

    public void writeU8(in u8 v)override{
        this.hash ^= cast<u64>(v);
        this.hash *= s_Fnv64Prime;
    }

    public void writeB8(in b8 v)override{
        if(v)
            this.writeU8(1u);
        else
            this.writeU8(0u);
    }

    public void writeU16(in u16 v)override{
        u64 h = this.hash;
        h ^= cast<u64>(v & 0xffu);
        h *= s_Fnv64Prime;
        h ^= cast<u64>((v >> 8u) & 0xffu);
        h *= s_Fnv64Prime;
        this.hash = h;
    }

    public void writeI16(in i16 v)override{
        this.writeU16(bit_cast<u16>(v));
    }

    public void writeU32(in u32 v)override{
        u64 h = this.hash;
        h ^= cast<u64>(v & 0xffu);
        h *= s_Fnv64Prime;
        h ^= cast<u64>((v >> 8u) & 0xffu);
        h *= s_Fnv64Prime;
        h ^= cast<u64>((v >> 16u) & 0xffu);
        h *= s_Fnv64Prime;
        h ^= cast<u64>((v >> 24u) & 0xffu);
        h *= s_Fnv64Prime;
        this.hash = h;
    }

    public void writeI32(in i32 v)override{
        this.writeU32(bit_cast<u32>(v));
    }

    public void writeU64(in u64 v)override{
        u64 h = this.hash;
        const u32 lo = cast<u32>(v & 0xffffffffu);
        const u32 hi = cast<u32>((v >> 32u) & 0xffffffffu);
        h ^= cast<u64>(lo & 0xffu); h *= s_Fnv64Prime;
        h ^= cast<u64>((lo >> 8u) & 0xffu); h *= s_Fnv64Prime;
        h ^= cast<u64>((lo >> 16u) & 0xffu); h *= s_Fnv64Prime;
        h ^= cast<u64>((lo >> 24u) & 0xffu); h *= s_Fnv64Prime;
        h ^= cast<u64>(hi & 0xffu); h *= s_Fnv64Prime;
        h ^= cast<u64>((hi >> 8u) & 0xffu); h *= s_Fnv64Prime;
        h ^= cast<u64>((hi >> 16u) & 0xffu); h *= s_Fnv64Prime;
        h ^= cast<u64>((hi >> 24u) & 0xffu); h *= s_Fnv64Prime;
        this.hash = h;
    }

    public void writeF32(in f32 v)override{
        this.writeU32(bit_cast<u32>(v));
    }

    public void writeF64(in f64 v)override{
        this.writeU64(bit_cast<u64>(v));
    }

    public b8 writeCount(in usize n)override{
        if(n > s_SnapshotMaxElements)
            return false;
        this.writeU32(cast<u32>(n));
        return true;
    }

    public void writeBytes(in Span<u8> data)override{
        u64 h = this.hash;
        for(usize i = 0u; i < data.size(); ++i){
            h ^= cast<u64>(data[i]);
            h *= s_Fnv64Prime;
        }
        this.hash = h;
    }

    public void writeU16Span(in Span<u16> data)override{
        u64 h = this.hash;
        for(usize i = 0u; i < data.size(); ++i){
            const u16 v = data[i];
            h ^= cast<u64>(v & 0xffu); h *= s_Fnv64Prime;
            h ^= cast<u64>((v >> 8u) & 0xffu); h *= s_Fnv64Prime;
        }
        this.hash = h;
    }

    public void writeU32Span(in Span<u32> data)override{
        u64 h = this.hash;
        for(usize i = 0u; i < data.size(); ++i){
            const u32 v = data[i];
            h ^= cast<u64>(v & 0xffu); h *= s_Fnv64Prime;
            h ^= cast<u64>((v >> 8u) & 0xffu); h *= s_Fnv64Prime;
            h ^= cast<u64>((v >> 16u) & 0xffu); h *= s_Fnv64Prime;
            h ^= cast<u64>((v >> 24u) & 0xffu); h *= s_Fnv64Prime;
        }
        this.hash = h;
    }

    public void writeF32Span(in Span<f32> data)override{
        u64 h = this.hash;
        for(usize i = 0u; i < data.size(); ++i){
            const u32 v = bit_cast<u32>(data[i]);
            h ^= cast<u64>(v & 0xffu); h *= s_Fnv64Prime;
            h ^= cast<u64>((v >> 8u) & 0xffu); h *= s_Fnv64Prime;
            h ^= cast<u64>((v >> 16u) & 0xffu); h *= s_Fnv64Prime;
            h ^= cast<u64>((v >> 24u) & 0xffu); h *= s_Fnv64Prime;
        }
        this.hash = h;
    }

    public usize byteCount()const override{
        return 0u;
    }
}

void SnapWriteVec4<TSink : ISnapshotSink>(mut TSink w, in VectorSingle v){
    w.writeF32(v.x);
    w.writeF32(v.y);
    w.writeF32(v.z);
    w.writeF32(v.w);
}

void SnapWriteVec3<TSink : ISnapshotSink>(mut TSink w, in VectorSingle v){
    w.writeF32(v.x);
    w.writeF32(v.y);
    w.writeF32(v.z);
}

void SnapWriteVec2F<TSink : ISnapshotSink>(mut TSink w, in f32 x, in f32 y){
    w.writeF32(x);
    w.writeF32(y);
}

void SnapWriteVec3U32F<TSink : ISnapshotSink>(mut TSink w, in f32 x, in f32 y, in f32 z, in u32 u){
    w.writeF32(x);
    w.writeF32(y);
    w.writeF32(z);
    w.writeU32(u);
}

void SnapWriteU32x4F<TSink : ISnapshotSink>(mut TSink w, in u32 x, in u32 y, in u32 z, in u32 u){
    w.writeU32(x);
    w.writeU32(y);
    w.writeU32(z);
    w.writeU32(u);
}

void SnapWriteTransform3D<TSink : ISnapshotSink>(mut TSink w, in Transform3D xf){
    SnapWriteVec4(w, VectorSingle(xf.position));
    SnapWriteVec4(w, VectorSingle(xf.rotation));
}

void SnapWriteAabb3D<TSink : ISnapshotSink>(mut TSink w, in Aabb3D box){
    SnapWriteVec4(w, VectorSingle(box.lowerBound));
    SnapWriteVec4(w, VectorSingle(box.upperBound));
}

void SnapWriteSymMat3<TSink : ISnapshotSink>(mut TSink w, in SymMat3 m){
    w.writeF32(m.m00);
    w.writeF32(m.m01);
    w.writeF32(m.m02);
    w.writeF32(m.m11);
    w.writeF32(m.m12);
    w.writeF32(m.m22);
}

void SnapWriteMat3<TSink : ISnapshotSink>(mut TSink w, in Mat3 m){
    SnapWriteVec4(w, VectorSingle(m.row0));
    SnapWriteVec4(w, VectorSingle(m.row1));
    SnapWriteVec4(w, VectorSingle(m.row2));
}

void SnapWriteFilter<TSink : ISnapshotSink>(mut TSink w, in Filter f){
    w.writeU64(f.categoryBits);
    w.writeU64(f.maskBits);
    w.writeI32(f.groupIndex);
    w.writeU8(f.broadPhaseLayer);
}

void SnapWriteSurfaceMaterial<TSink : ISnapshotSink>(mut TSink w, in SurfaceMaterial m){
    SnapWriteVec4(w, VectorSingle(m.surfaceVelocity));
    SnapWriteVec4(w, VectorSingle(m.anisotropicFriction));
    SnapWriteVec4(w, VectorSingle(m.frictionDirection));
    w.writeF32(m.friction);
    w.writeF32(m.staticFriction);
    w.writeF32(m.restitution);
    w.writeF32(m.rollingResistance);
    w.writeF32(m.tangentSpeed);
    w.writeU8(cast<u8>(m.frictionCombineMode));
    w.writeU8(cast<u8>(m.restitutionCombineMode));
}

class SnapshotByteReader{
    public usize cursor = 0u;
    public usize limit = 0u;

    public b8 hasRemaining(in usize needed)const{
        if(this.cursor > this.limit)
            return false;
        return needed <= (this.limit - this.cursor);
    }

    public b8 readU8(in Span<u8> data, mut u8 outVal){
        if(!this.hasRemaining(1u))
            return false;
        outVal = data[this.cursor];
        ++this.cursor;
        return true;
    }

    public b8 readB8(in Span<u8> data, mut b8 outVal){
        u8 b = 0u;
        if(!this.readU8(data, b))
            return false;
        outVal = (b != 0u);
        return true;
    }

    public b8 readU16(in Span<u8> data, mut u16 outVal){
        if(!this.hasRemaining(2u))
            return false;
        const u16 b0 = cast<u16>(data[this.cursor]);
        const u16 b1 = cast<u16>(data[this.cursor + 1u]);
        outVal = b0 | (b1 << 8u);
        this.cursor += 2u;
        return true;
    }

    public b8 readI16(in Span<u8> data, mut i16 outVal){
        u16 bits = 0u;
        if(!this.readU16(data, bits))
            return false;
        outVal = bit_cast<i16>(bits);
        return true;
    }

    public b8 readU32(in Span<u8> data, mut u32 outVal){
        if(!this.hasRemaining(4u))
            return false;
        const u32 b0 = cast<u32>(data[this.cursor]);
        const u32 b1 = cast<u32>(data[this.cursor + 1u]);
        const u32 b2 = cast<u32>(data[this.cursor + 2u]);
        const u32 b3 = cast<u32>(data[this.cursor + 3u]);
        outVal = b0 | (b1 << 8u) | (b2 << 16u) | (b3 << 24u);
        this.cursor += 4u;
        return true;
    }

    public b8 readI32(in Span<u8> data, mut i32 outVal){
        u32 bits = 0u;
        if(!this.readU32(data, bits))
            return false;
        outVal = bit_cast<i32>(bits);
        return true;
    }

    public b8 readU64(in Span<u8> data, mut u64 outVal){
        u32 lo = 0u;
        u32 hi = 0u;
        if(!this.readU32(data, lo) || !this.readU32(data, hi))
            return false;
        outVal = cast<u64>(lo) | (cast<u64>(hi) << 32u);
        return true;
    }

    public b8 readF32(in Span<u8> data, mut f32 outVal){
        u32 bits = 0u;
        if(!this.readU32(data, bits))
            return false;
        outVal = bit_cast<f32>(bits);
        return true;
    }

    public b8 readF64(in Span<u8> data, mut f64 outVal){
        u64 bits = 0u;
        if(!this.readU64(data, bits))
            return false;
        outVal = bit_cast<f64>(bits);
        return true;
    }

    public b8 readVec4F(in Span<u8> data, mut f32 ox, mut f32 oy, mut f32 oz, mut f32 ow){
        return this.readF32(data, ox) && this.readF32(data, oy) && this.readF32(data, oz) && this.readF32(data, ow);
    }

    public b8 readVec3F(in Span<u8> data, mut f32 ox, mut f32 oy, mut f32 oz){
        return this.readF32(data, ox) && this.readF32(data, oy) && this.readF32(data, oz);
    }

    public b8 readVec2F(in Span<u8> data, mut f32 ox, mut f32 oy){
        return this.readF32(data, ox) && this.readF32(data, oy);
    }

    public b8 readVec3U32F(in Span<u8> data, mut f32 ox, mut f32 oy, mut f32 oz, mut u32 ow){
        return this.readF32(data, ox) && this.readF32(data, oy) && this.readF32(data, oz) && this.readU32(data, ow);
    }

    public b8 readU32x4F(in Span<u8> data, mut u32 ox, mut u32 oy, mut u32 oz, mut u32 ow){
        return this.readU32(data, ox) && this.readU32(data, oy) && this.readU32(data, oz) && this.readU32(data, ow);
    }

    public b8 readTransform3D(in Span<u8> data, mut Transform3D outXf){
        return
            this.readVec4F(data, outXf.position.x, outXf.position.y, outXf.position.z, outXf.position.w)
            && this.readVec4F(data, outXf.rotation.x, outXf.rotation.y, outXf.rotation.z, outXf.rotation.w)
        ;
    }

    public b8 readAabb3D(in Span<u8> data, mut Aabb3D outBox){
        return
            this.readVec4F(data, outBox.lowerBound.x, outBox.lowerBound.y, outBox.lowerBound.z, outBox.lowerBound.w)
            && this.readVec4F(data, outBox.upperBound.x, outBox.upperBound.y, outBox.upperBound.z, outBox.upperBound.w)
        ;
    }

    public b8 readSymMat3(in Span<u8> data, mut SymMat3 outM){
        return
            this.readF32(data, outM.m00)
            && this.readF32(data, outM.m01)
            && this.readF32(data, outM.m02)
            && this.readF32(data, outM.m11)
            && this.readF32(data, outM.m12)
            && this.readF32(data, outM.m22)
        ;
    }

    public b8 readMat3(in Span<u8> data, mut Mat3 outM){
        return
            this.readVec4F(data, outM.row0.x, outM.row0.y, outM.row0.z, outM.row0.w)
            && this.readVec4F(data, outM.row1.x, outM.row1.y, outM.row1.z, outM.row1.w)
            && this.readVec4F(data, outM.row2.x, outM.row2.y, outM.row2.z, outM.row2.w)
        ;
    }

    public b8 readFilter(in Span<u8> data, mut Filter outF){
        return this.readU64(data, outF.categoryBits) && this.readU64(data, outF.maskBits) && this.readI32(data, outF.groupIndex) && this.readU8(data, outF.broadPhaseLayer);
    }

    private b8 readHandleParts(in Span<u8> data, mut u32 outIndex, mut u16 outGen, mut u16 outWorldIdx){
        return this.readU32(data, outIndex) && this.readU16(data, outGen) && this.readU16(data, outWorldIdx);
    }

    public b8 readBodyId(in Span<u8> data, mut BodyId outId){
        return this.readHandleParts(data, outId.index, outId.generation, outId.worldIndex);
    }

    public b8 readShapeId(in Span<u8> data, mut ShapeId outId){
        return this.readHandleParts(data, outId.index, outId.generation, outId.worldIndex);
    }

    public b8 readJointId(in Span<u8> data, mut JointId outId){
        return this.readHandleParts(data, outId.index, outId.generation, outId.worldIndex);
    }

    public b8 readHullGeometryId(in Span<u8> data, mut HullGeometryId outId){
        return this.readHandleParts(data, outId.index, outId.generation, outId.worldIndex);
    }

    public b8 readCompoundGeometryId(in Span<u8> data, mut CompoundGeometryId outId){
        return this.readHandleParts(data, outId.index, outId.generation, outId.worldIndex);
    }

    public b8 readSurfaceMaterial(in Span<u8> data, mut SurfaceMaterial outM){
        u8 fMode = 0u;
        u8 rMode = 0u;
        if(
            !this.readVec4F(data, outM.surfaceVelocity.x, outM.surfaceVelocity.y, outM.surfaceVelocity.z, outM.surfaceVelocity.w)
            || !this.readVec4F(data, outM.anisotropicFriction.x, outM.anisotropicFriction.y, outM.anisotropicFriction.z, outM.anisotropicFriction.w)
            || !this.readVec4F(data, outM.frictionDirection.x, outM.frictionDirection.y, outM.frictionDirection.z, outM.frictionDirection.w)
            || !this.readF32(data, outM.friction)
            || !this.readF32(data, outM.staticFriction)
            || !this.readF32(data, outM.restitution)
            || !this.readF32(data, outM.rollingResistance)
            || !this.readF32(data, outM.tangentSpeed)
            || !this.readU8(data, fMode)
            || !this.readU8(data, rMode)
        )
            return false;
        if(fMode >= cast<u8>(MaterialCombineMode::kCount) || rMode >= cast<u8>(MaterialCombineMode::kCount))
            return false;
        outM.frictionCombineMode = cast<MaterialCombineMode>(fMode);
        outM.restitutionCombineMode = cast<MaterialCombineMode>(rMode);
        return true;
    }

    public b8 readCount(in Span<u8> data, in usize minBytesPerItem, mut u32 outCount){
        if(!this.readU32(data, outCount))
            return false;
        if(outCount > s_SnapshotMaxElements)
            return false;
        if(minBytesPerItem > 0u && !this.hasRemaining(cast<usize>(outCount) * minBytesPerItem))
            return false;
        return true;
    }
}

u16 SnapWireWorldIndex(in b8 valid){
    if(valid)
        return 1u;
    return 0u;
}

void SnapWriteHandleParts<TSink : ISnapshotSink>(mut TSink w, in u32 index, in u16 generation, in b8 valid){
    w.writeU32(index);
    w.writeU16(generation);
    w.writeU16(SnapWireWorldIndex(valid));
}

void SnapWriteBodyId<TSink : ISnapshotSink>(mut TSink w, in BodyId id){
    SnapWriteHandleParts(w, id.index, id.generation, id.valid());
}

void SnapWriteShapeId<TSink : ISnapshotSink>(mut TSink w, in ShapeId id){
    SnapWriteHandleParts(w, id.index, id.generation, id.valid());
}

void SnapWriteHullGeometryId<TSink : ISnapshotSink>(mut TSink w, in HullGeometryId id){
    SnapWriteHandleParts(w, id.index, id.generation, id.valid());
}

void SnapWriteCompoundGeometryId<TSink : ISnapshotSink>(mut TSink w, in CompoundGeometryId id){
    SnapWriteHandleParts(w, id.index, id.generation, id.valid());
}

b8 SnapshotWriteU32Vec<TSink : ISnapshotSink>(mut TSink w, in Vector<u32> v){
    if(!w.writeCount(v.size()))
        return false;
    w.writeU32Span(Span<u32>(v));
    return true;
}

b8 SnapshotWriteU16Vec<TSink : ISnapshotSink>(mut TSink w, in Vector<u16> v){
    if(!w.writeCount(v.size()))
        return false;
    w.writeU16Span(Span<u16>(v));
    return true;
}

b8 SnapshotWriteU8Vec<TSink : ISnapshotSink>(mut TSink w, in Vector<u8> v){
    if(!w.writeCount(v.size()))
        return false;
    w.writeBytes(Span<u8>(v));
    return true;
}

b8 SnapshotReadU32Vec(in Span<u8> data, mut SnapshotByteReader r, mut Vector<u32> outV){
    u32 cnt = 0u;
    if(!r.readCount(data, 4u, cnt))
        return false;
    outV.resize(cnt);
    usize c = r.cursor;
    for(u32 i = 0u; i < cnt; ++i){
        const u32 b0 = cast<u32>(data[c]);
        const u32 b1 = cast<u32>(data[c + 1u]);
        const u32 b2 = cast<u32>(data[c + 2u]);
        const u32 b3 = cast<u32>(data[c + 3u]);
        outV[i] = b0 | (b1 << 8u) | (b2 << 16u) | (b3 << 24u);
        c += 4u;
    }
    r.cursor = c;
    return true;
}

b8 SnapshotReadU16Vec(in Span<u8> data, mut SnapshotByteReader r, mut Vector<u16> outV){
    u32 cnt = 0u;
    if(!r.readCount(data, 2u, cnt))
        return false;
    outV.resize(cnt);
    usize c = r.cursor;
    for(u32 i = 0u; i < cnt; ++i){
        const u16 b0 = cast<u16>(data[c]);
        const u16 b1 = cast<u16>(data[c + 1u]);
        outV[i] = b0 | (b1 << 8u);
        c += 2u;
    }
    r.cursor = c;
    return true;
}

b8 SnapshotReadU8Vec(in Span<u8> data, mut SnapshotByteReader r, mut Vector<u8> outV){
    u32 cnt = 0u;
    if(!r.readCount(data, 1u, cnt))
        return false;
    outV.resize(cnt);
    usize c = r.cursor;
    for(u32 i = 0u; i < cnt; ++i){
        outV[i] = data[c];
        ++c;
    }
    r.cursor = c;
    return true;
}

void SnapWriteJointId<TSink : ISnapshotSink>(in JointId id, mut TSink w){
    SnapWriteHandleParts(w, id.index, id.generation, id.valid());
}

void SnapWriteSpatialVec<TSink : ISnapshotSink>(in SpatialVec v, mut TSink w){
    SnapWriteVec4(w, VectorSingle(v.ang));
    SnapWriteVec4(w, VectorSingle(v.lin));
}

b8 SnapReadSpatialVec(in Span<u8> bytes, mut SnapshotByteReader r, mut SpatialVec outV){
    return
        r.readVec4F(bytes, outV.ang.x, outV.ang.y, outV.ang.z, outV.ang.w)
        && r.readVec4F(bytes, outV.lin.x, outV.lin.y, outV.lin.z, outV.lin.w)
    ;
}

b8 SnapshotWriteF32Vec<TSink : ISnapshotSink>(in Vector<f32> v, mut TSink w){
    if(!w.writeCount(v.size()))
        return false;
    w.writeF32Span(Span<f32>(v));
    return true;
}

b8 SnapshotReadF32Vec(in Span<u8> data, mut SnapshotByteReader r, mut Vector<f32> outV){
    u32 cnt = 0u;
    if(!r.readCount(data, 4u, cnt))
        return false;
    outV.resize(cnt);
    for(u32 i = 0u; i < cnt; ++i){
        if(!r.readF32(data, outV[i]))
            return false;
    }
    return true;
}

b8 SnapshotWriteVec4Vec<TSink : ISnapshotSink>(in Vector<f32x4> v, mut TSink w){
    if(!w.writeCount(v.size()))
        return false;
    for(usize i = 0u; i < v.size(); ++i)
        SnapWriteVec4(w, VectorSingle(v[i]));
    return true;
}

b8 SnapshotReadVec4Vec(in Span<u8> data, mut SnapshotByteReader r, mut Vector<f32x4> outV){
    u32 cnt = 0u;
    if(!r.readCount(data, 16u, cnt))
        return false;
    outV.resize(cnt);
    for(u32 i = 0u; i < cnt; ++i){
        if(!r.readVec4F(data, outV[i].x, outV[i].y, outV[i].z, outV[i].w))
            return false;
    }
    return true;
}

b8 SnapshotWriteU64Vec<TSink : ISnapshotSink>(in Vector<u64> v, mut TSink w){
    if(!w.writeCount(v.size()))
        return false;
    for(usize i = 0u; i < v.size(); ++i)
        w.writeU64(v[i]);
    return true;
}

b8 SnapshotReadU64Vec(in Span<u8> data, mut SnapshotByteReader r, mut Vector<u64> outV){
    u32 cnt = 0u;
    if(!r.readCount(data, 8u, cnt))
        return false;
    outV.resize(cnt);
    for(u32 i = 0u; i < cnt; ++i){
        if(!r.readU64(data, outV[i]))
            return false;
    }
    return true;
}

usize EstimatePhysicsWorldSnapshotSize(in PhysicsWorld world){
    usize est = 512u;
    est += world.m_bodies.size() * 100u + world.m_freeBodyIds.size() * 4u;
    est += world.m_shapes.size() * 196u + world.m_freeShapeIds.size() * 4u;
    for(usize i = 0u; i < world.m_hullShapes.size(); ++i){
        in HullShape h = world.m_hullShapes[i];
        est += 64u + h.vertices.size() * 12u + h.facePlanes.size() * 16u + h.faceTopologies.size() * 2u + h.halfEdges.size() * 4u;
    }
    est += world.m_hullLocalAabbs.size() * 32u + world.m_hullRefCounts.size() * 4u + world.m_hullGenerations.size() * 2u + world.m_hullOwnedByUser.size() + world.m_freeHullShapeIds.size() * 4u;
    for(usize i = 0u; i < world.m_meshShapes.size(); ++i){
        in MeshShape m = world.m_meshShapes[i];
        est += 64u + m.triangles.size() * 48u + m.nodes.size() * 32u + m.materials.size() * 70u + m.triangleMaterialIndices.size() * 2u + m.triangleUserData.size() * 4u;
    }
    est += world.m_meshRefCounts.size() * 4u + world.m_meshGenerations.size() * 2u + world.m_meshOwnedByUser.size() + world.m_freeMeshShapeIds.size() * 4u;
    for(usize i = 0u; i < world.m_heightfieldShapes.size(); ++i){
        in HeightfieldShape hf = world.m_heightfieldShapes[i];
        est += 65u + hf.heights.size() * 4u + hf.cellMaterialIndices.size() * 2u + hf.materials.size() * 70u + hf.cellHoles.size();
    }
    est += world.m_heightfieldRefCounts.size() * 4u + world.m_heightfieldGenerations.size() * 2u + world.m_heightfieldOwnedByUser.size() + world.m_freeHeightfieldShapeIds.size() * 4u;
    for(usize i = 0u; i < world.m_compoundShapes.size(); ++i){
        in CompoundShape comp = world.m_compoundShapes[i];
        est += 48u + comp.children.size() * 144u + comp.nodes.size() * 32u + comp.bvhChildOrder.size() * 4u;
    }
    est += world.m_compoundRefCounts.size() * 4u + world.m_compoundGenerations.size() * 2u + world.m_compoundOwnedByUser.size() + world.m_freeCompoundShapeIds.size() * 4u;
    est += world.m_scaledShapes.size() * 73u + world.m_scaledRefCounts.size() * 4u + world.m_scaledGenerations.size() * 2u + world.m_scaledOwnedByUser.size() + world.m_freeScaledShapeIds.size() * 4u;
    for(usize i = 0u; i < world.m_chainShapes.size(); ++i){
        in ChainShape ch = world.m_chainShapes[i];
        est += 140u + ch.vertices.size() * 16u + ch.nodes.size() * 32u + ch.bvhSegmentOrder.size() * 4u + ch.materials.size() * 70u + ch.segmentMaterialIndices.size() * 2u;
    }
    est += world.m_chainRefCounts.size() * 4u + world.m_chainGenerations.size() * 2u + world.m_chainOwnedByUser.size() + world.m_freeChainShapeIds.size() * 4u;
    for(usize i = 0u; i < world.m_sdfShapes.size(); ++i)
        est += 89u + world.m_sdfShapes[i].distances.size() * 4u;
    est += world.m_sdfRefCounts.size() * 4u + world.m_sdfGenerations.size() * 2u + world.m_sdfOwnedByUser.size() + world.m_freeSdfShapeIds.size() * 4u;
    est += world.m_contacts.size() * 384u + world.m_freeContactIds.size() * 4u;
    est += world.m_joints.size() * 329u + world.m_freeJointIds.size() * 4u;
    for(usize i = 0u; i < world.m_jointExtraData.size(); ++i)
        est += 324u + world.m_jointExtraData[i].pathPoints.size() * 16u;
    est += world.m_freeJointExtraData.size() * 4u;
    for(usize i = 0u; i < world.m_solverSets.size(); ++i){
        in SolverSet ss = world.m_solverSets[i];
        est += 24u + ss.sims.size() * 204u + ss.states.size() * 64u + ss.islands.size() * 4u;
    }
    est += world.m_freeSolverSetIds.size() * 4u;
    for(usize i = 0u; i < world.m_islands.size(); ++i){
        in Island isl = world.m_islands[i];
        est += 32u + isl.bodies.size() * 4u + isl.contacts.size() * 12u + isl.joints.size() * 12u;
    }
    est += world.m_freeIslandIds.size() * 4u;
    for(usize c = 0u; c < s_GraphColorCount; ++c)
        est += 4u + world.m_graph.colors[c].contactIds.size() * 4u;
    est += world.m_graph.bodyColorMasks.size() * 4u;
    for(usize t = 0u; t < s_TreeCount; ++t){
        in DynamicTree tree = world.m_broadPhase.trees[t];
        est += 20u + tree.nodes().size() * 46u + tree.moveIndices().size() * 4u;
    }
    est += world.m_broadPhase.moveArray.size() * 4u;
    est += 12u + world.m_pendingContactEndEvents.size() * 16u + world.m_pendingSensorEndEvents.size() * 16u + world.m_pendingBodyWakeEvents.size() * 17u;
    est += 8u + world.m_ignoredBodyPairs.size() * 16u + world.m_extraContactManifolds.size() * 512u;
    return est;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void SnapWriteManifold<TSink : ISnapshotSink>(in Manifold m, mut TSink w){
    for(usize pi = 0u; pi < s_MaxManifoldPoints; ++pi){
        SnapWriteVec4(w, VectorSingle(m.points[pi].pointSeparation));
        SnapWriteVec4(w, VectorSingle(m.points[pi].anchorANormalImpulse));
        SnapWriteVec4(w, VectorSingle(m.points[pi].anchorBTotalImpulse));
        SnapWriteVec2F(w, m.pointFrictionImpulses[pi].x, m.pointFrictionImpulses[pi].y);
        w.writeF32(m.postSolveTangentImpulses[pi]);
    }
    SnapWriteVec4(w, VectorSingle(m.normalTwist));
    SnapWriteVec3U32F(w, m.rollingImpulseMeta.x, m.rollingImpulseMeta.y, m.rollingImpulseMeta.z, m.rollingImpulseMeta.w);
    SnapWriteU32x4F(w, m.pointIds.x, m.pointIds.y, m.pointIds.z, m.pointIds.w);
    SnapWriteVec2F(w, m.frictionImpulse.x, m.frictionImpulse.y);
    w.writeU32(m.materialTriangleA);
    w.writeU32(m.materialTriangleB);
    w.writeU32(m.materialSubShapeA);
    w.writeU32(m.materialSubShapeB);
}

b8 SnapReadManifold(in Span<u8> bytes, mut SnapshotByteReader r, mut Manifold outM){
    for(usize pi = 0u; pi < s_MaxManifoldPoints; ++pi){
        if(
            !r.readVec4F(bytes, outM.points[pi].pointSeparation.x, outM.points[pi].pointSeparation.y, outM.points[pi].pointSeparation.z, outM.points[pi].pointSeparation.w)
            || !r.readVec4F(bytes, outM.points[pi].anchorANormalImpulse.x, outM.points[pi].anchorANormalImpulse.y, outM.points[pi].anchorANormalImpulse.z, outM.points[pi].anchorANormalImpulse.w)
            || !r.readVec4F(bytes, outM.points[pi].anchorBTotalImpulse.x, outM.points[pi].anchorBTotalImpulse.y, outM.points[pi].anchorBTotalImpulse.z, outM.points[pi].anchorBTotalImpulse.w)
            || !r.readVec2F(bytes, outM.pointFrictionImpulses[pi].x, outM.pointFrictionImpulses[pi].y)
            || !r.readF32(bytes, outM.postSolveTangentImpulses[pi])
        )
            return false;
    }
    if(
        !r.readVec4F(bytes, outM.normalTwist.x, outM.normalTwist.y, outM.normalTwist.z, outM.normalTwist.w)
        || !r.readVec3U32F(bytes, outM.rollingImpulseMeta.x, outM.rollingImpulseMeta.y, outM.rollingImpulseMeta.z, outM.rollingImpulseMeta.w)
        || !r.readU32x4F(bytes, outM.pointIds.x, outM.pointIds.y, outM.pointIds.z, outM.pointIds.w)
        || !r.readVec2F(bytes, outM.frictionImpulse.x, outM.frictionImpulse.y)
        || !r.readU32(bytes, outM.materialTriangleA)
        || !r.readU32(bytes, outM.materialTriangleB)
        || !r.readU32(bytes, outM.materialSubShapeA)
        || !r.readU32(bytes, outM.materialSubShapeB)
    )
        return false;
    return true;
}

b8 SnapWriteMeshBvhNodes<TSink : ISnapshotSink>(in Vector<MeshBvhNode> nodes, mut TSink w){
    if(!w.writeCount(nodes.size()))
        return false;
    for(usize k = 0u; k < nodes.size(); ++k){
        SnapWriteVec3U32F(w, nodes[k].aabbMinLeft.x, nodes[k].aabbMinLeft.y, nodes[k].aabbMinLeft.z, nodes[k].aabbMinLeft.w);
        SnapWriteVec3U32F(w, nodes[k].aabbMaxRight.x, nodes[k].aabbMaxRight.y, nodes[k].aabbMaxRight.z, nodes[k].aabbMaxRight.w);
    }
    return true;
}

b8 SnapReadMeshBvhNodes(in Span<u8> bytes, mut SnapshotByteReader r, mut Vector<MeshBvhNode> outNodes){
    u32 nc = 0u;
    if(!r.readCount(bytes, 32u, nc))
        return false;
    outNodes.resize(nc);
    for(u32 k = 0u; k < nc; ++k){
        if(
            !r.readVec3U32F(bytes, outNodes[k].aabbMinLeft.x, outNodes[k].aabbMinLeft.y, outNodes[k].aabbMinLeft.z, outNodes[k].aabbMinLeft.w)
            || !r.readVec3U32F(bytes, outNodes[k].aabbMaxRight.x, outNodes[k].aabbMaxRight.y, outNodes[k].aabbMaxRight.z, outNodes[k].aabbMaxRight.w)
        )
            return false;
    }
    return true;
}

b8 SnapWriteSurfaceMaterials<TSink : ISnapshotSink>(in Vector<SurfaceMaterial> mats, mut TSink w){
    if(!w.writeCount(mats.size()))
        return false;
    for(usize k = 0u; k < mats.size(); ++k)
        SnapWriteSurfaceMaterial(w, mats[k]);
    return true;
}

b8 SnapReadSurfaceMaterials(in Span<u8> bytes, mut SnapshotByteReader r, mut Vector<SurfaceMaterial> outMats){
    u32 mc = 0u;
    if(!r.readCount(bytes, 16u, mc))
        return false;
    outMats.resize(mc);
    for(u32 k = 0u; k < mc; ++k){
        if(!r.readSurfaceMaterial(bytes, outMats[k]))
            return false;
    }
    return true;
}

b8 SnapWriteShapePoolMeta<TSink : ISnapshotSink>(
    in Vector<u32> refCounts,
    in Vector<u16> generations,
    in Vector<u8> ownedByUser,
    in Vector<u32> freeIds,
    mut TSink w
){
    return
        SnapshotWriteU32Vec(w, refCounts)
        && SnapshotWriteU16Vec(w, generations)
        && SnapshotWriteU8Vec(w, ownedByUser)
        && SnapshotWriteU32Vec(w, freeIds)
    ;
}

b8 SnapReadShapePoolMeta(
    in Span<u8> bytes,
    mut SnapshotByteReader r,
    in usize expectedSize,
    mut Vector<u32> outRefCounts,
    mut Vector<u16> outGenerations,
    mut Vector<u8> outOwnedByUser,
    mut Vector<u32> outFreeIds
){
    if(
        !SnapshotReadU32Vec(bytes, r, outRefCounts)
        || !SnapshotReadU16Vec(bytes, r, outGenerations)
        || !SnapshotReadU8Vec(bytes, r, outOwnedByUser)
        || !SnapshotReadU32Vec(bytes, r, outFreeIds)
    )
        return false;
    return outRefCounts.size() == expectedSize && outGenerations.size() == expectedSize && outOwnedByUser.size() == expectedSize;
}

void SnapWriteWorldGlobals<TSink : ISnapshotSink>(in PhysicsWorld world, mut TSink w){
    SnapWriteVec4(w, VectorSingle(world.m_def.gravity));
    w.writeF32(world.m_def.restitutionThreshold);
    w.writeF32(world.m_def.hitEventThreshold);
    w.writeF32(world.m_def.contactHertz);
    w.writeF32(world.m_def.contactDampingRatio);
    w.writeF32(world.m_def.maxLinearVelocity);
    w.writeF32(world.m_def.timeToSleep);
    w.writeB8(world.m_def.enableSleep);
    w.writeB8(world.m_def.enableContinuous);
    w.writeB8(world.m_def.enableContactSoftening);
    w.writeB8(world.m_def.enableGpuCollision);
    w.writeB8(world.m_def.forceGpuCollision);
    w.writeB8(world.m_def.gpuResidentMode);
    w.writeB8(world.m_def.useGpuLbvhBroadphase);
    w.writeB8(world.m_def.enableBlockSolver);
    w.writeB8(world.m_def.enableShockPropagation);
    w.writeB8(world.m_def.deterministicMode);
    w.writeB8(world.m_def.enableGlobalCcd);
    w.writeB8(world.m_def.enablePerPointFriction);
    w.writeB8(world.m_def.enableDoublePrecisionPositions);
    for(usize li = 0u; li < 32u; ++li)
        w.writeU32(world.m_def.broadPhaseLayerMasks[li]);

    w.writeU8(cast<u8>(world.m_backendMode));
    w.writeU32(world.m_gpuDispatchThreshold);
    w.writeF32(world.m_gpuWorkloadFraction);
    w.writeB8(world.m_enableWarmStarting);
    w.writeB8(world.m_hasDirtyBodyMass);
    w.writeB8(world.m_cpuBroadphaseDirty);
    w.writeU32(world.m_sensorEventShapeCount);
    w.writeU32(world.m_hitEventShapeCount);
    w.writeU32(world.m_breakableJointCount);
    w.writeU32(world.m_bulletBodyCount);
    w.writeF64(world.m_worldOriginOffset.x);
    w.writeF64(world.m_worldOriginOffset.y);
    w.writeF64(world.m_worldOriginOffset.z);
}

b8 SnapReadWorldGlobals(in Span<u8> bytes, mut SnapshotByteReader r, mut PhysicsWorld tmp){
    if(
        !r.readVec4F(bytes, tmp.m_def.gravity.x, tmp.m_def.gravity.y, tmp.m_def.gravity.z, tmp.m_def.gravity.w)
        || !r.readF32(bytes, tmp.m_def.restitutionThreshold)
        || !r.readF32(bytes, tmp.m_def.hitEventThreshold)
        || !r.readF32(bytes, tmp.m_def.contactHertz)
        || !r.readF32(bytes, tmp.m_def.contactDampingRatio)
        || !r.readF32(bytes, tmp.m_def.maxLinearVelocity)
        || !r.readF32(bytes, tmp.m_def.timeToSleep)
        || !r.readB8(bytes, tmp.m_def.enableSleep)
        || !r.readB8(bytes, tmp.m_def.enableContinuous)
        || !r.readB8(bytes, tmp.m_def.enableContactSoftening)
        || !r.readB8(bytes, tmp.m_def.enableGpuCollision)
        || !r.readB8(bytes, tmp.m_def.forceGpuCollision)
        || !r.readB8(bytes, tmp.m_def.gpuResidentMode)
        || !r.readB8(bytes, tmp.m_def.useGpuLbvhBroadphase)
        || !r.readB8(bytes, tmp.m_def.enableBlockSolver)
        || !r.readB8(bytes, tmp.m_def.enableShockPropagation)
        || !r.readB8(bytes, tmp.m_def.deterministicMode)
        || !r.readB8(bytes, tmp.m_def.enableGlobalCcd)
        || !r.readB8(bytes, tmp.m_def.enablePerPointFriction)
        || !r.readB8(bytes, tmp.m_def.enableDoublePrecisionPositions)
    )
        return false;
    for(usize li = 0u; li < 32u; ++li){
        if(!r.readU32(bytes, tmp.m_def.broadPhaseLayerMasks[li]))
            return false;
    }

    u8 backendByte = 0u;
    f64 ox = 0.0;
    f64 oy = 0.0;
    f64 oz = 0.0;
    if(
        !r.readU8(bytes, backendByte)
        || !r.readU32(bytes, tmp.m_gpuDispatchThreshold)
        || !r.readF32(bytes, tmp.m_gpuWorkloadFraction)
        || !r.readB8(bytes, tmp.m_enableWarmStarting)
        || !r.readB8(bytes, tmp.m_hasDirtyBodyMass)
        || !r.readB8(bytes, tmp.m_cpuBroadphaseDirty)
        || !r.readU32(bytes, tmp.m_sensorEventShapeCount)
        || !r.readU32(bytes, tmp.m_hitEventShapeCount)
        || !r.readU32(bytes, tmp.m_breakableJointCount)
        || !r.readU32(bytes, tmp.m_bulletBodyCount)
        || !r.readF64(bytes, ox)
        || !r.readF64(bytes, oy)
        || !r.readF64(bytes, oz)
    )
        return false;
    if(backendByte >= cast<u8>(PhysicsBackendMode::kCount))
        return false;
    const f64x4 originVec(ox, oy, oz, 0.0);
    if(!IsFinite(VectorDouble(ox, oy, oz, 0.0)))
        return false;
    tmp.m_backendMode = cast<PhysicsBackendMode>(backendByte);
    tmp.m_worldOriginOffset = originVec;
    return true;
}

void SnapWriteBody<TSink : ISnapshotSink>(in Body b, mut TSink w){
    w.writeU64(b.userData);
    w.writeU32(b.setIndex);
    w.writeU32(b.localIndex);
    w.writeU32(b.headContactKey);
    w.writeU32(b.contactCount);
    w.writeU32(b.headJointKey);
    w.writeU32(b.jointCount);
    w.writeU32(b.headShapeId);
    w.writeU32(b.shapeCount);
    w.writeU32(b.islandId);
    w.writeU32(b.islandIndex);
    w.writeF32(b.sleepThreshold);
    w.writeF32(b.sleepTime);
    w.writeF32(b.mass);
    SnapWriteSymMat3(w, b.inertiaLocal);
    w.writeF32(b.maxAngularVelocity);
    w.writeU32(b.bodyMoveIndex);
    w.writeU32(b.id);
    w.writeU32(b.flags);
    w.writeU8(cast<u8>(b.type));
    w.writeU16(b.generation);
    w.writeB8(b.alive);
}

b8 SnapReadBody(in Span<u8> bytes, mut SnapshotByteReader r, mut Body b){
    u8 bType = 0u;
    if(
        !r.readU64(bytes, b.userData)
        || !r.readU32(bytes, b.setIndex)
        || !r.readU32(bytes, b.localIndex)
        || !r.readU32(bytes, b.headContactKey)
        || !r.readU32(bytes, b.contactCount)
        || !r.readU32(bytes, b.headJointKey)
        || !r.readU32(bytes, b.jointCount)
        || !r.readU32(bytes, b.headShapeId)
        || !r.readU32(bytes, b.shapeCount)
        || !r.readU32(bytes, b.islandId)
        || !r.readU32(bytes, b.islandIndex)
        || !r.readF32(bytes, b.sleepThreshold)
        || !r.readF32(bytes, b.sleepTime)
        || !r.readF32(bytes, b.mass)
        || !r.readSymMat3(bytes, b.inertiaLocal)
        || !r.readF32(bytes, b.maxAngularVelocity)
        || !r.readU32(bytes, b.bodyMoveIndex)
        || !r.readU32(bytes, b.id)
        || !r.readU32(bytes, b.flags)
        || !r.readU8(bytes, bType)
        || !r.readU16(bytes, b.generation)
        || !r.readB8(bytes, b.alive)
    )
        return false;
    if(bType >= cast<u8>(BodyType::kCount))
        return false;
    b.type = cast<BodyType>(bType);
    return true;
}

void SnapWriteShape<TSink : ISnapshotSink>(in Shape s, mut TSink w){
    SnapWriteVec4(w, VectorSingle(s.geom0));
    SnapWriteVec4(w, VectorSingle(s.geom1));
    SnapWriteAabb3D(w, s.aabb);
    SnapWriteTransform3D(w, s.localTransform);
    w.writeU64(s.userData);
    SnapWriteSurfaceMaterial(w, s.material);
    SnapWriteFilter(w, s.filter);
    w.writeU32(s.bodyId);
    w.writeU32(s.id);
    w.writeU32(s.nextShapeId);
    w.writeU32(s.proxyKey);
    w.writeU32(s.geometryIndex);
    w.writeF32(s.density);
    w.writeU16(s.generation);
    w.writeU8(cast<u8>(s.type));
    w.writeU16(s.flags);
}

b8 SnapReadShape(in Span<u8> bytes, mut SnapshotByteReader r, mut Shape s){
    u8 sType = 0u;
    if(
        !r.readVec4F(bytes, s.geom0.x, s.geom0.y, s.geom0.z, s.geom0.w)
        || !r.readVec4F(bytes, s.geom1.x, s.geom1.y, s.geom1.z, s.geom1.w)
        || !r.readAabb3D(bytes, s.aabb)
        || !r.readTransform3D(bytes, s.localTransform)
        || !r.readU64(bytes, s.userData)
        || !r.readSurfaceMaterial(bytes, s.material)
        || !r.readFilter(bytes, s.filter)
        || !r.readU32(bytes, s.bodyId)
        || !r.readU32(bytes, s.id)
        || !r.readU32(bytes, s.nextShapeId)
        || !r.readU32(bytes, s.proxyKey)
        || !r.readU32(bytes, s.geometryIndex)
        || !r.readF32(bytes, s.density)
        || !r.readU16(bytes, s.generation)
        || !r.readU8(bytes, sType)
        || !r.readU16(bytes, s.flags)
    )
        return false;
    if(sType >= cast<u8>(ShapeType::kCount))
        return false;
    s.type = cast<ShapeType>(sType);
    return true;
}

b8 SnapWriteHullShape<TSink : ISnapshotSink>(in HullShape h, mut TSink w){
    SnapWriteVec4(w, VectorSingle(h.centroidRadius));
    SnapWriteVec3U32F(w, h.halfExtentsFlags.x, h.halfExtentsFlags.y, h.halfExtentsFlags.z, h.halfExtentsFlags.w);
    SnapWriteVec4(w, VectorSingle(h.boxRotation));
    if(!w.writeCount(h.vertices.size()))
        return false;
    for(usize k = 0u; k < h.vertices.size(); ++k)
        SnapWriteVec3(w, VectorSingle(h.vertices[k], 0.0f));
    if(!w.writeCount(h.facePlanes.size()))
        return false;
    for(usize k = 0u; k < h.facePlanes.size(); ++k)
        SnapWriteVec4(w, VectorSingle(h.facePlanes[k].normalOffset));
    if(!w.writeCount(h.faceTopologies.size()))
        return false;
    for(usize k = 0u; k < h.faceTopologies.size(); ++k){
        w.writeU8(h.faceTopologies[k].edge);
        w.writeU8(h.faceTopologies[k].vertexCount);
    }
    if(!w.writeCount(h.halfEdges.size()))
        return false;
    for(usize k = 0u; k < h.halfEdges.size(); ++k){
        w.writeU8(h.halfEdges[k].tail);
        w.writeU8(h.halfEdges[k].face);
        w.writeU8(h.halfEdges[k].next);
        w.writeU8(h.halfEdges[k].twin);
    }
    return true;
}

b8 SnapReadHullShape(in Span<u8> bytes, mut SnapshotByteReader r, mut HullShape outH){
    if(
        !r.readVec4F(bytes, outH.centroidRadius.x, outH.centroidRadius.y, outH.centroidRadius.z, outH.centroidRadius.w)
        || !r.readVec3U32F(bytes, outH.halfExtentsFlags.x, outH.halfExtentsFlags.y, outH.halfExtentsFlags.z, outH.halfExtentsFlags.w)
        || !r.readVec4F(bytes, outH.boxRotation.x, outH.boxRotation.y, outH.boxRotation.z, outH.boxRotation.w)
    )
        return false;
    u32 vc = 0u;
    if(!r.readCount(bytes, 12u, vc))
        return false;
    outH.vertices.resize(vc);
    for(u32 k = 0u; k < vc; ++k){
        if(!r.readVec3F(bytes, outH.vertices[k].x, outH.vertices[k].y, outH.vertices[k].z))
            return false;
    }
    u32 fpc = 0u;
    if(!r.readCount(bytes, 16u, fpc))
        return false;
    outH.facePlanes.resize(fpc);
    for(u32 k = 0u; k < fpc; ++k){
        if(!r.readVec4F(bytes, outH.facePlanes[k].normalOffset.x, outH.facePlanes[k].normalOffset.y, outH.facePlanes[k].normalOffset.z, outH.facePlanes[k].normalOffset.w))
            return false;
    }
    u32 ftc = 0u;
    if(!r.readCount(bytes, 2u, ftc))
        return false;
    outH.faceTopologies.resize(ftc);
    for(u32 k = 0u; k < ftc; ++k){
        if(!r.readU8(bytes, outH.faceTopologies[k].edge) || !r.readU8(bytes, outH.faceTopologies[k].vertexCount))
            return false;
    }
    u32 hec = 0u;
    if(!r.readCount(bytes, 4u, hec))
        return false;
    outH.halfEdges.resize(hec);
    for(u32 k = 0u; k < hec; ++k){
        if(
            !r.readU8(bytes, outH.halfEdges[k].tail)
            || !r.readU8(bytes, outH.halfEdges[k].face)
            || !r.readU8(bytes, outH.halfEdges[k].next)
            || !r.readU8(bytes, outH.halfEdges[k].twin)
        )
            return false;
    }
    PrepareHullBuoyancyCaches(outH);
    return true;
}

b8 SnapWriteHullPool<TSink : ISnapshotSink>(in PhysicsWorld world, mut TSink w){
    if(!w.writeCount(world.m_hullShapes.size()))
        return false;
    for(usize i = 0u; i < world.m_hullShapes.size(); ++i){
        if(!SnapWriteHullShape(world.m_hullShapes[i], w))
            return false;
    }
    if(!w.writeCount(world.m_hullLocalAabbs.size()))
        return false;
    for(usize i = 0u; i < world.m_hullLocalAabbs.size(); ++i)
        SnapWriteAabb3D(w, world.m_hullLocalAabbs[i]);
    return SnapWriteShapePoolMeta(world.m_hullRefCounts, world.m_hullGenerations, world.m_hullOwnedByUser, world.m_freeHullShapeIds, w);
}

b8 SnapReadHullPool(in Span<u8> bytes, mut SnapshotByteReader r, mut PhysicsWorld tmp){
    u32 hullCount = 0u;
    if(!r.readCount(bytes, 32u, hullCount))
        return false;
    tmp.m_hullShapes.resize(hullCount);
    for(u32 i = 0u; i < hullCount; ++i){
        if(!SnapReadHullShape(bytes, r, tmp.m_hullShapes[i]))
            return false;
    }
    u32 hullAabbCount = 0u;
    if(!r.readCount(bytes, 32u, hullAabbCount) || hullAabbCount != hullCount)
        return false;
    tmp.m_hullLocalAabbs.resize(hullAabbCount);
    for(u32 i = 0u; i < hullAabbCount; ++i){
        if(!r.readAabb3D(bytes, tmp.m_hullLocalAabbs[i]))
            return false;
    }
    return SnapReadShapePoolMeta(bytes, r, hullCount, tmp.m_hullRefCounts, tmp.m_hullGenerations, tmp.m_hullOwnedByUser, tmp.m_freeHullShapeIds);
}

b8 SnapWriteMeshPool<TSink : ISnapshotSink>(in PhysicsWorld world, mut TSink w){
    if(!w.writeCount(world.m_meshShapes.size()))
        return false;
    for(usize i = 0u; i < world.m_meshShapes.size(); ++i){
        in MeshShape m = world.m_meshShapes[i];
        SnapWriteVec4(w, VectorSingle(m.localAabbMinRadius));
        SnapWriteVec3U32F(w, m.localAabbMaxMeta.x, m.localAabbMaxMeta.y, m.localAabbMaxMeta.z, m.localAabbMaxMeta.w);
        if(!w.writeCount(m.triangles.size()))
            return false;
        for(usize k = 0u; k < m.triangles.size(); ++k){
            SnapWriteVec3(w, VectorSingle(m.triangles[k].v0, 0.0f));
            SnapWriteVec3(w, VectorSingle(m.triangles[k].v1, 0.0f));
            SnapWriteVec3(w, VectorSingle(m.triangles[k].v2, 0.0f));
            SnapWriteVec3(w, VectorSingle(m.triangles[k].normal, 0.0f));
        }
        if(
            !SnapWriteMeshBvhNodes(m.nodes, w)
            || !SnapWriteSurfaceMaterials(m.materials, w)
            || !SnapshotWriteU16Vec(w, m.triangleMaterialIndices)
            || !SnapshotWriteU32Vec(w, m.triangleUserData)
        )
            return false;
    }
    return SnapWriteShapePoolMeta(world.m_meshRefCounts, world.m_meshGenerations, world.m_meshOwnedByUser, world.m_freeMeshShapeIds, w);
}

b8 SnapReadMeshPool(in Span<u8> bytes, mut SnapshotByteReader r, mut PhysicsWorld tmp){
    u32 meshCount = 0u;
    if(!r.readCount(bytes, 32u, meshCount))
        return false;
    tmp.m_meshShapes.resize(meshCount);
    for(u32 i = 0u; i < meshCount; ++i){
        mut MeshShape m = tmp.m_meshShapes[i];
        if(!r.readVec4F(bytes, m.localAabbMinRadius.x, m.localAabbMinRadius.y, m.localAabbMinRadius.z, m.localAabbMinRadius.w) || !r.readVec3U32F(bytes, m.localAabbMaxMeta.x, m.localAabbMaxMeta.y, m.localAabbMaxMeta.z, m.localAabbMaxMeta.w))
            return false;
        u32 tc = 0u;
        if(!r.readCount(bytes, 48u, tc))
            return false;
        m.triangles.resize(tc);
        for(u32 k = 0u; k < tc; ++k){
            if(
                !r.readVec3F(bytes, m.triangles[k].v0.x, m.triangles[k].v0.y, m.triangles[k].v0.z)
                || !r.readVec3F(bytes, m.triangles[k].v1.x, m.triangles[k].v1.y, m.triangles[k].v1.z)
                || !r.readVec3F(bytes, m.triangles[k].v2.x, m.triangles[k].v2.y, m.triangles[k].v2.z)
                || !r.readVec3F(bytes, m.triangles[k].normal.x, m.triangles[k].normal.y, m.triangles[k].normal.z)
            )
                return false;
        }
        if(
            !SnapReadMeshBvhNodes(bytes, r, m.nodes)
            || !SnapReadSurfaceMaterials(bytes, r, m.materials)
            || !SnapshotReadU16Vec(bytes, r, m.triangleMaterialIndices)
            || !SnapshotReadU32Vec(bytes, r, m.triangleUserData)
        )
            return false;
        PrepareMeshBuoyancyVolumeCache(m);
    }
    tmp.m_meshRefitCaches.clear();
    return SnapReadShapePoolMeta(bytes, r, meshCount, tmp.m_meshRefCounts, tmp.m_meshGenerations, tmp.m_meshOwnedByUser, tmp.m_freeMeshShapeIds);
}

b8 SnapWriteHeightfieldPool<TSink : ISnapshotSink>(in PhysicsWorld world, mut TSink w){
    if(!w.writeCount(world.m_heightfieldShapes.size()))
        return false;
    for(usize i = 0u; i < world.m_heightfieldShapes.size(); ++i){
        in HeightfieldShape hf = world.m_heightfieldShapes[i];
        w.writeU32(hf.rows);
        w.writeU32(hf.cols);
        SnapWriteVec4(w, VectorSingle(hf.scaleMinMaxY));
        SnapWriteVec4(w, VectorSingle(hf.originMaxY));
        w.writeF32(hf.thickness);
        if(!SnapshotWriteF32Vec(hf.heights, w))
            return false;
        if(!SnapshotWriteU16Vec(w, hf.cellMaterialIndices))
            return false;
        if(!SnapshotWriteU8Vec(w, hf.cellHoles))
            return false;
        w.writeB8(hf.flipDiagonal);
        if(!SnapWriteSurfaceMaterials(hf.materials, w))
            return false;
    }
    return SnapWriteShapePoolMeta(world.m_heightfieldRefCounts, world.m_heightfieldGenerations, world.m_heightfieldOwnedByUser, world.m_freeHeightfieldShapeIds, w);
}

b8 SnapReadHeightfieldPool(in Span<u8> bytes, mut SnapshotByteReader r, mut PhysicsWorld tmp){
    u32 hfCount = 0u;
    if(!r.readCount(bytes, 32u, hfCount))
        return false;
    tmp.m_heightfieldShapes.resize(hfCount);
    for(u32 i = 0u; i < hfCount; ++i){
        mut HeightfieldShape hf = tmp.m_heightfieldShapes[i];
        if(
            !r.readU32(bytes, hf.rows)
            || !r.readU32(bytes, hf.cols)
            || !r.readVec4F(bytes, hf.scaleMinMaxY.x, hf.scaleMinMaxY.y, hf.scaleMinMaxY.z, hf.scaleMinMaxY.w)
            || !r.readVec4F(bytes, hf.originMaxY.x, hf.originMaxY.y, hf.originMaxY.z, hf.originMaxY.w)
            || !r.readF32(bytes, hf.thickness)
        )
            return false;
        if(!SnapshotReadF32Vec(bytes, r, hf.heights))
            return false;
        if(!SnapshotReadU16Vec(bytes, r, hf.cellMaterialIndices))
            return false;
        if(!SnapshotReadU8Vec(bytes, r, hf.cellHoles))
            return false;
        if(!r.readB8(bytes, hf.flipDiagonal))
            return false;
        if(!SnapReadSurfaceMaterials(bytes, r, hf.materials))
            return false;
        hf.buildHierarchy();
    }
    return SnapReadShapePoolMeta(bytes, r, hfCount, tmp.m_heightfieldRefCounts, tmp.m_heightfieldGenerations, tmp.m_heightfieldOwnedByUser, tmp.m_freeHeightfieldShapeIds);
}

b8 SnapWriteCompoundPool<TSink : ISnapshotSink>(in PhysicsWorld world, mut TSink w){
    if(!w.writeCount(world.m_compoundShapes.size()))
        return false;
    for(usize i = 0u; i < world.m_compoundShapes.size(); ++i){
        in CompoundShape comp = world.m_compoundShapes[i];
        if(!w.writeCount(comp.children.size()))
            return false;
        for(usize k = 0u; k < comp.children.size(); ++k){
            in CompoundSubShape sub = comp.children[k];
            SnapWriteTransform3D(w, sub.localTransform);
            SnapWriteVec4(w, VectorSingle(sub.geom0));
            SnapWriteVec4(w, VectorSingle(sub.geom1));
            SnapWriteSurfaceMaterial(w, sub.material);
            w.writeU32(sub.geometryIndex);
            w.writeF32(sub.density);
            w.writeU8(cast<u8>(sub.type));
        }
        if(!SnapWriteMeshBvhNodes(comp.nodes, w) || !SnapshotWriteU32Vec(w, comp.bvhChildOrder))
            return false;
        SnapWriteAabb3D(w, comp.localAabb);
        w.writeF32(comp.cachedBuoyancyVolume);
    }
    return SnapWriteShapePoolMeta(world.m_compoundRefCounts, world.m_compoundGenerations, world.m_compoundOwnedByUser, world.m_freeCompoundShapeIds, w);
}

b8 SnapReadCompoundPool(in Span<u8> bytes, mut SnapshotByteReader r, mut PhysicsWorld tmp){
    u32 compCount = 0u;
    if(!r.readCount(bytes, 36u, compCount))
        return false;
    tmp.m_compoundShapes.resize(compCount);
    for(u32 i = 0u; i < compCount; ++i){
        mut CompoundShape comp = tmp.m_compoundShapes[i];
        u32 childCount = 0u;
        if(!r.readCount(bytes, 64u, childCount))
            return false;
        comp.children.resize(childCount);
        for(u32 k = 0u; k < childCount; ++k){
            mut CompoundSubShape sub = comp.children[k];
            u8 subType = 0u;
            if(
                !r.readTransform3D(bytes, sub.localTransform)
                || !r.readVec4F(bytes, sub.geom0.x, sub.geom0.y, sub.geom0.z, sub.geom0.w)
                || !r.readVec4F(bytes, sub.geom1.x, sub.geom1.y, sub.geom1.z, sub.geom1.w)
                || !r.readSurfaceMaterial(bytes, sub.material)
                || !r.readU32(bytes, sub.geometryIndex)
                || !r.readF32(bytes, sub.density)
                || !r.readU8(bytes, subType)
            )
                return false;
            if(subType >= cast<u8>(ShapeType::kCount))
                return false;
            sub.type = cast<ShapeType>(subType);
        }
        if(
            !SnapReadMeshBvhNodes(bytes, r, comp.nodes)
            || !SnapshotReadU32Vec(bytes, r, comp.bvhChildOrder)
            || !r.readAabb3D(bytes, comp.localAabb)
            || !r.readF32(bytes, comp.cachedBuoyancyVolume)
        )
            return false;
    }
    return SnapReadShapePoolMeta(bytes, r, compCount, tmp.m_compoundRefCounts, tmp.m_compoundGenerations, tmp.m_compoundOwnedByUser, tmp.m_freeCompoundShapeIds);
}

b8 SnapWriteScaledPool<TSink : ISnapshotSink>(in PhysicsWorld world, mut TSink w){
    if(!w.writeCount(world.m_scaledShapes.size()))
        return false;
    for(usize i = 0u; i < world.m_scaledShapes.size(); ++i){
        in ScaledShape sc = world.m_scaledShapes[i];
        SnapWriteVec4(w, VectorSingle(sc.geom0));
        SnapWriteVec4(w, VectorSingle(sc.geom1));
        SnapWriteVec4(w, VectorSingle(sc.scale));
        SnapWriteVec4(w, VectorSingle(sc.invScale));
        w.writeU32(sc.childGeometryIndex);
        w.writeU8(cast<u8>(sc.childType));
        w.writeF32(sc.cachedBuoyancyVolume);
    }
    return SnapWriteShapePoolMeta(world.m_scaledRefCounts, world.m_scaledGenerations, world.m_scaledOwnedByUser, world.m_freeScaledShapeIds, w);
}

b8 SnapReadScaledPool(in Span<u8> bytes, mut SnapshotByteReader r, mut PhysicsWorld tmp){
    u32 scaledCount = 0u;
    if(!r.readCount(bytes, 73u, scaledCount))
        return false;
    tmp.m_scaledShapes.resize(scaledCount);
    for(u32 i = 0u; i < scaledCount; ++i){
        mut ScaledShape sc = tmp.m_scaledShapes[i];
        u8 cType = 0u;
        if(
            !r.readVec4F(bytes, sc.geom0.x, sc.geom0.y, sc.geom0.z, sc.geom0.w)
            || !r.readVec4F(bytes, sc.geom1.x, sc.geom1.y, sc.geom1.z, sc.geom1.w)
            || !r.readVec4F(bytes, sc.scale.x, sc.scale.y, sc.scale.z, sc.scale.w)
            || !r.readVec4F(bytes, sc.invScale.x, sc.invScale.y, sc.invScale.z, sc.invScale.w)
            || !r.readU32(bytes, sc.childGeometryIndex)
            || !r.readU8(bytes, cType)
            || !r.readF32(bytes, sc.cachedBuoyancyVolume)
        )
            return false;
        if(cType >= cast<u8>(ShapeType::kCount) || cType == cast<u8>(ShapeType::Scaled))
            return false;
        sc.childType = cast<ShapeType>(cType);
    }
    return SnapReadShapePoolMeta(bytes, r, scaledCount, tmp.m_scaledRefCounts, tmp.m_scaledGenerations, tmp.m_scaledOwnedByUser, tmp.m_freeScaledShapeIds);
}

b8 SnapWriteChainPool<TSink : ISnapshotSink>(in PhysicsWorld world, mut TSink w){
    if(!w.writeCount(world.m_chainShapes.size()))
        return false;
    for(usize i = 0u; i < world.m_chainShapes.size(); ++i){
        in ChainShape ch = world.m_chainShapes[i];
        if(
            !SnapshotWriteVec4Vec(ch.vertices, w)
            || !SnapWriteMeshBvhNodes(ch.nodes, w)
            || !SnapshotWriteU32Vec(w, ch.bvhSegmentOrder)
            || !SnapWriteSurfaceMaterials(ch.materials, w)
            || !SnapshotWriteU16Vec(w, ch.segmentMaterialIndices)
        )
            return false;
        SnapWriteAabb3D(w, ch.localAabb);
        SnapWriteVec4(w, VectorSingle(ch.ghostStart));
        SnapWriteVec4(w, VectorSingle(ch.ghostEnd));
        SnapWriteSurfaceMaterial(w, ch.material);
        w.writeF32(ch.radius);
        w.writeB8(ch.isLoop);
    }
    return SnapWriteShapePoolMeta(world.m_chainRefCounts, world.m_chainGenerations, world.m_chainOwnedByUser, world.m_freeChainShapeIds, w);
}

b8 SnapReadChainPool(in Span<u8> bytes, mut SnapshotByteReader r, mut PhysicsWorld tmp){
    u32 chainCount = 0u;
    if(!r.readCount(bytes, 64u, chainCount))
        return false;
    tmp.m_chainShapes.resize(chainCount);
    for(u32 i = 0u; i < chainCount; ++i){
        mut ChainShape ch = tmp.m_chainShapes[i];
        if(
            !SnapshotReadVec4Vec(bytes, r, ch.vertices)
            || !SnapReadMeshBvhNodes(bytes, r, ch.nodes)
            || !SnapshotReadU32Vec(bytes, r, ch.bvhSegmentOrder)
            || !SnapReadSurfaceMaterials(bytes, r, ch.materials)
            || !SnapshotReadU16Vec(bytes, r, ch.segmentMaterialIndices)
            || !r.readAabb3D(bytes, ch.localAabb)
            || !r.readVec4F(bytes, ch.ghostStart.x, ch.ghostStart.y, ch.ghostStart.z, ch.ghostStart.w)
            || !r.readVec4F(bytes, ch.ghostEnd.x, ch.ghostEnd.y, ch.ghostEnd.z, ch.ghostEnd.w)
            || !r.readSurfaceMaterial(bytes, ch.material)
            || !r.readF32(bytes, ch.radius)
            || !r.readB8(bytes, ch.isLoop)
        )
            return false;
    }
    return SnapReadShapePoolMeta(bytes, r, chainCount, tmp.m_chainRefCounts, tmp.m_chainGenerations, tmp.m_chainOwnedByUser, tmp.m_freeChainShapeIds);
}

b8 SnapWriteSdfPool<TSink : ISnapshotSink>(in PhysicsWorld world, mut TSink w){
    if(!w.writeCount(world.m_sdfShapes.size()))
        return false;
    for(usize i = 0u; i < world.m_sdfShapes.size(); ++i){
        in SdfShape sdf = world.m_sdfShapes[i];
        if(!SnapshotWriteF32Vec(sdf.distances, w))
            return false;
        SnapWriteVec4(w, VectorSingle(sdf.boundsMin));
        SnapWriteVec4(w, VectorSingle(sdf.boundsMax));
        SnapWriteVec4(w, VectorSingle(sdf.cellSize));
        SnapWriteVec4(w, VectorSingle(sdf.invCellSize));
        w.writeU32(sdf.dimX);
        w.writeU32(sdf.dimY);
        w.writeU32(sdf.dimZ);
        w.writeF32(sdf.margin);
        w.writeB8(sdf.isClosed);
        w.writeF32(sdf.cachedBuoyancyVolume);
    }
    return SnapWriteShapePoolMeta(world.m_sdfRefCounts, world.m_sdfGenerations, world.m_sdfOwnedByUser, world.m_freeSdfShapeIds, w);
}

b8 SnapReadSdfPool(in Span<u8> bytes, mut SnapshotByteReader r, mut PhysicsWorld tmp){
    u32 sdfCount = 0u;
    if(!r.readCount(bytes, 64u, sdfCount))
        return false;
    tmp.m_sdfShapes.resize(sdfCount);
    for(u32 i = 0u; i < sdfCount; ++i){
        mut SdfShape sdf = tmp.m_sdfShapes[i];
        if(
            !SnapshotReadF32Vec(bytes, r, sdf.distances)
            || !r.readVec4F(bytes, sdf.boundsMin.x, sdf.boundsMin.y, sdf.boundsMin.z, sdf.boundsMin.w)
            || !r.readVec4F(bytes, sdf.boundsMax.x, sdf.boundsMax.y, sdf.boundsMax.z, sdf.boundsMax.w)
            || !r.readVec4F(bytes, sdf.cellSize.x, sdf.cellSize.y, sdf.cellSize.z, sdf.cellSize.w)
            || !r.readVec4F(bytes, sdf.invCellSize.x, sdf.invCellSize.y, sdf.invCellSize.z, sdf.invCellSize.w)
            || !r.readU32(bytes, sdf.dimX)
            || !r.readU32(bytes, sdf.dimY)
            || !r.readU32(bytes, sdf.dimZ)
            || !r.readF32(bytes, sdf.margin)
            || !r.readB8(bytes, sdf.isClosed)
            || !r.readF32(bytes, sdf.cachedBuoyancyVolume)
        )
            return false;
    }
    return SnapReadShapePoolMeta(bytes, r, sdfCount, tmp.m_sdfRefCounts, tmp.m_sdfGenerations, tmp.m_sdfOwnedByUser, tmp.m_freeSdfShapeIds);
}

void SnapWriteContact<TSink : ISnapshotSink>(in Contact c, mut TSink w){
    w.writeU64(c.pairKey);
    w.writeU32(c.edges[0u].bodyId); w.writeU32(c.edges[0u].prevKey); w.writeU32(c.edges[0u].nextKey);
    w.writeU32(c.edges[1u].bodyId); w.writeU32(c.edges[1u].prevKey); w.writeU32(c.edges[1u].nextKey);
    SnapWriteVec4(w, VectorSingle(c.surfaceVelocity));
    SnapWriteVec4(w, VectorSingle(c.anisotropicFriction));
    SnapWriteVec4(w, VectorSingle(c.frictionDirection));
    w.writeU32(c.contactId);
    w.writeU32(c.shapeIdA);
    w.writeU32(c.shapeIdB);
    w.writeU32(c.colorIndex);
    w.writeU32(c.localIndex);
    w.writeU32(c.islandId);
    w.writeU32(c.islandIndex);
    w.writeF32(c.friction);
    w.writeF32(c.staticFriction);
    w.writeF32(c.restitution);
    w.writeF32(c.rollingResistance);
    w.writeF32(c.tangentSpeed);
    w.writeF32(c.invMassScaleA);
    w.writeF32(c.invMassScaleB);
    w.writeF32(c.invInertiaScaleA);
    w.writeF32(c.invInertiaScaleB);
    w.writeF32(c.maxNormalImpulse);
    w.writeU32(c.flags);
    SnapWriteManifold(c.manifold, w);
}

b8 SnapReadContact(in Span<u8> bytes, mut SnapshotByteReader r, mut Contact c){
    if(
        !r.readU64(bytes, c.pairKey)
        || !r.readU32(bytes, c.edges[0u].bodyId) || !r.readU32(bytes, c.edges[0u].prevKey) || !r.readU32(bytes, c.edges[0u].nextKey)
        || !r.readU32(bytes, c.edges[1u].bodyId) || !r.readU32(bytes, c.edges[1u].prevKey) || !r.readU32(bytes, c.edges[1u].nextKey)
        || !r.readVec4F(bytes, c.surfaceVelocity.x, c.surfaceVelocity.y, c.surfaceVelocity.z, c.surfaceVelocity.w)
        || !r.readVec4F(bytes, c.anisotropicFriction.x, c.anisotropicFriction.y, c.anisotropicFriction.z, c.anisotropicFriction.w)
        || !r.readVec4F(bytes, c.frictionDirection.x, c.frictionDirection.y, c.frictionDirection.z, c.frictionDirection.w)
        || !r.readU32(bytes, c.contactId)
        || !r.readU32(bytes, c.shapeIdA)
        || !r.readU32(bytes, c.shapeIdB)
        || !r.readU32(bytes, c.colorIndex)
        || !r.readU32(bytes, c.localIndex)
        || !r.readU32(bytes, c.islandId)
        || !r.readU32(bytes, c.islandIndex)
        || !r.readF32(bytes, c.friction)
        || !r.readF32(bytes, c.staticFriction)
        || !r.readF32(bytes, c.restitution)
        || !r.readF32(bytes, c.rollingResistance)
        || !r.readF32(bytes, c.tangentSpeed)
        || !r.readF32(bytes, c.invMassScaleA)
        || !r.readF32(bytes, c.invMassScaleB)
        || !r.readF32(bytes, c.invInertiaScaleA)
        || !r.readF32(bytes, c.invInertiaScaleB)
        || !r.readF32(bytes, c.maxNormalImpulse)
        || !r.readU32(bytes, c.flags)
    )
        return false;
    return SnapReadManifold(bytes, r, c.manifold);
}

void SnapWriteJoint<TSink : ISnapshotSink>(in Joint j, mut TSink w){
    SnapWriteVec4(w, VectorSingle(j.localAnchorALength));
    SnapWriteVec4(w, VectorSingle(j.localAnchorBMinLength));
    SnapWriteVec4(w, VectorSingle(j.localAxisAMaxLength));
    SnapWriteVec4(w, VectorSingle(j.localAxisBLowerLimit));
    SnapWriteVec4(w, VectorSingle(j.referenceRotation));
    SnapWriteVec4(w, VectorSingle(j.linearOffsetUpperLimit));
    SnapWriteVec4(w, VectorSingle(j.linearImpulseLimit));
    SnapWriteVec4(w, VectorSingle(j.angularImpulseMotor));
    SnapWriteVec4(w, VectorSingle(j.lastForceConeSusp));
    SnapWriteVec4(w, VectorSingle(j.lastTorqueMotorSpeed));
    w.writeU64(j.userData);
    w.writeU32(j.edges[0u].bodyId); w.writeU32(j.edges[0u].prevKey); w.writeU32(j.edges[0u].nextKey);
    w.writeU32(j.edges[1u].bodyId); w.writeU32(j.edges[1u].prevKey); w.writeU32(j.edges[1u].nextKey);
    w.writeU32(j.jointId);
    w.writeU32(j.islandId);
    w.writeU32(j.islandIndex);
    w.writeU32(j.extraDataIndex);
    w.writeF32(j.maxMotorForce);
    w.writeF32(j.hertz);
    w.writeF32(j.dampingRatio);
    w.writeF32(j.correctionFactor);
    w.writeF32(j.maxTorque);
    w.writeF32(j.swingLimit);
    w.writeF32(j.swingLimitY);
    w.writeF32(j.springTarget);
    w.writeF32(j.suspensionHertz);
    w.writeF32(j.suspensionDampingRatio);
    w.writeF32(j.steeringAngle);
    w.writeF32(j.suspensionRestLength);
    w.writeF32(j.invMassScaleA);
    w.writeF32(j.invMassScaleB);
    w.writeF32(j.invInertiaScaleA);
    w.writeF32(j.invInertiaScaleB);
    w.writeF32(j.limitRestitution);
    w.writeF32(j.limitHertz);
    w.writeF32(j.limitDampingRatio);
    w.writeF32(j.projectionLinearTolerance);
    w.writeF32(j.projectionAngularTolerance);
    w.writeF32(j.ratio);
    w.writeF32(j.breakForce);
    w.writeF32(j.breakTorque);
    SnapWriteJointId(j.referenceJointA, w);
    SnapWriteJointId(j.referenceJointB, w);
    w.writeF32(j.continuousAngle);
    w.writeF32(j.accumulatedPhaseError);
    w.writeB8(j.hasContinuousAngle);
    w.writeU16(j.generation);
    w.writeU8(cast<u8>(j.type));
    w.writeU8(j.flags);
}

b8 SnapReadJoint(in Span<u8> bytes, mut SnapshotByteReader r, mut Joint j){
    u8 jType = 0u;
    if(
        !r.readVec4F(bytes, j.localAnchorALength.x, j.localAnchorALength.y, j.localAnchorALength.z, j.localAnchorALength.w)
        || !r.readVec4F(bytes, j.localAnchorBMinLength.x, j.localAnchorBMinLength.y, j.localAnchorBMinLength.z, j.localAnchorBMinLength.w)
        || !r.readVec4F(bytes, j.localAxisAMaxLength.x, j.localAxisAMaxLength.y, j.localAxisAMaxLength.z, j.localAxisAMaxLength.w)
        || !r.readVec4F(bytes, j.localAxisBLowerLimit.x, j.localAxisBLowerLimit.y, j.localAxisBLowerLimit.z, j.localAxisBLowerLimit.w)
        || !r.readVec4F(bytes, j.referenceRotation.x, j.referenceRotation.y, j.referenceRotation.z, j.referenceRotation.w)
        || !r.readVec4F(bytes, j.linearOffsetUpperLimit.x, j.linearOffsetUpperLimit.y, j.linearOffsetUpperLimit.z, j.linearOffsetUpperLimit.w)
        || !r.readVec4F(bytes, j.linearImpulseLimit.x, j.linearImpulseLimit.y, j.linearImpulseLimit.z, j.linearImpulseLimit.w)
        || !r.readVec4F(bytes, j.angularImpulseMotor.x, j.angularImpulseMotor.y, j.angularImpulseMotor.z, j.angularImpulseMotor.w)
        || !r.readVec4F(bytes, j.lastForceConeSusp.x, j.lastForceConeSusp.y, j.lastForceConeSusp.z, j.lastForceConeSusp.w)
        || !r.readVec4F(bytes, j.lastTorqueMotorSpeed.x, j.lastTorqueMotorSpeed.y, j.lastTorqueMotorSpeed.z, j.lastTorqueMotorSpeed.w)
        || !r.readU64(bytes, j.userData)
        || !r.readU32(bytes, j.edges[0u].bodyId) || !r.readU32(bytes, j.edges[0u].prevKey) || !r.readU32(bytes, j.edges[0u].nextKey)
        || !r.readU32(bytes, j.edges[1u].bodyId) || !r.readU32(bytes, j.edges[1u].prevKey) || !r.readU32(bytes, j.edges[1u].nextKey)
        || !r.readU32(bytes, j.jointId)
        || !r.readU32(bytes, j.islandId)
        || !r.readU32(bytes, j.islandIndex)
        || !r.readU32(bytes, j.extraDataIndex)
        || !r.readF32(bytes, j.maxMotorForce)
        || !r.readF32(bytes, j.hertz)
        || !r.readF32(bytes, j.dampingRatio)
        || !r.readF32(bytes, j.correctionFactor)
        || !r.readF32(bytes, j.maxTorque)
        || !r.readF32(bytes, j.swingLimit)
        || !r.readF32(bytes, j.swingLimitY)
        || !r.readF32(bytes, j.springTarget)
        || !r.readF32(bytes, j.suspensionHertz)
        || !r.readF32(bytes, j.suspensionDampingRatio)
        || !r.readF32(bytes, j.steeringAngle)
        || !r.readF32(bytes, j.suspensionRestLength)
        || !r.readF32(bytes, j.invMassScaleA)
        || !r.readF32(bytes, j.invMassScaleB)
        || !r.readF32(bytes, j.invInertiaScaleA)
        || !r.readF32(bytes, j.invInertiaScaleB)
        || !r.readF32(bytes, j.limitRestitution)
        || !r.readF32(bytes, j.limitHertz)
        || !r.readF32(bytes, j.limitDampingRatio)
        || !r.readF32(bytes, j.projectionLinearTolerance)
        || !r.readF32(bytes, j.projectionAngularTolerance)
        || !r.readF32(bytes, j.ratio)
        || !r.readF32(bytes, j.breakForce)
        || !r.readF32(bytes, j.breakTorque)
        || !r.readJointId(bytes, j.referenceJointA)
        || !r.readJointId(bytes, j.referenceJointB)
        || !r.readF32(bytes, j.continuousAngle)
        || !r.readF32(bytes, j.accumulatedPhaseError)
        || !r.readB8(bytes, j.hasContinuousAngle)
        || !r.readU16(bytes, j.generation)
        || !r.readU8(bytes, jType)
        || !r.readU8(bytes, j.flags)
    )
        return false;
    if(jType >= cast<u8>(JointType::kCount))
        return false;
    j.type = cast<JointType>(jType);
    return true;
}

b8 SnapWriteJointExtraData<TSink : ISnapshotSink>(in JointExtraData e, mut TSink w){
    for(usize k = 0u; k < 6u; ++k){
        in SixDofAxisConfig cfg = e.sixDofAxes[k];
        w.writeU8(cast<u8>(cfg.motion));
        w.writeF32(cfg.lowerLimit);
        w.writeF32(cfg.upperLimit);
        w.writeF32(cfg.motorTargetVelocity);
        w.writeF32(cfg.motorTargetPosition);
        w.writeF32(cfg.maxMotorForce);
        w.writeF32(cfg.springHertz);
        w.writeF32(cfg.springDampingRatio);
        w.writeB8(cfg.enableMotor);
        w.writeB8(cfg.enableSpring);
        w.writeF32(e.sixDofLowerImpulses[k]);
        w.writeF32(e.sixDofUpperImpulses[k]);
        w.writeF32(e.sixDofMotorImpulses[k]);
        w.writeF32(e.sixDofSpringImpulses[k]);
    }
    SnapWriteVec4(w, VectorSingle(e.groundAnchorA));
    SnapWriteVec4(w, VectorSingle(e.groundAnchorB));
    w.writeF32(e.pulleyConstant);
    if(!SnapshotWriteVec4Vec(e.pathPoints, w))
        return false;
    w.writeB8(e.pathClosed);
    w.writeB8(e.pathLockRotation);
    w.writeB8(e.alive);
    SnapWriteVec4(w, VectorSingle(e.targetOrientation));
    SnapWriteVec4(w, VectorSingle(e.slerpImpulse));
    w.writeF32(e.slerpHertz);
    w.writeF32(e.slerpDampingRatio);
    w.writeF32(e.slerpMaxTorque);
    w.writeF32(e.sixDofSwingLimitY);
    w.writeF32(e.sixDofSwingLimitZ);
    w.writeF32(e.sixDofSwingImpulse);
    w.writeU8(cast<u8>(e.sixDofSwingLimitMode));
    w.writeB8(e.enableSlerpDrive);
    return true;
}

b8 SnapReadJointExtraData(in Span<u8> bytes, mut SnapshotByteReader r, mut JointExtraData e){
    for(usize k = 0u; k < 6u; ++k){
        mut SixDofAxisConfig cfg = e.sixDofAxes[k];
        u8 mot = 0u;
        if(
            !r.readU8(bytes, mot)
            || !r.readF32(bytes, cfg.lowerLimit)
            || !r.readF32(bytes, cfg.upperLimit)
            || !r.readF32(bytes, cfg.motorTargetVelocity)
            || !r.readF32(bytes, cfg.motorTargetPosition)
            || !r.readF32(bytes, cfg.maxMotorForce)
            || !r.readF32(bytes, cfg.springHertz)
            || !r.readF32(bytes, cfg.springDampingRatio)
            || !r.readB8(bytes, cfg.enableMotor)
            || !r.readB8(bytes, cfg.enableSpring)
            || !r.readF32(bytes, e.sixDofLowerImpulses[k])
            || !r.readF32(bytes, e.sixDofUpperImpulses[k])
            || !r.readF32(bytes, e.sixDofMotorImpulses[k])
            || !r.readF32(bytes, e.sixDofSpringImpulses[k])
        )
            return false;
        if(mot >= cast<u8>(JointMotion::kCount))
            return false;
        cfg.motion = cast<JointMotion>(mot);
    }
    if(
        !r.readVec4F(bytes, e.groundAnchorA.x, e.groundAnchorA.y, e.groundAnchorA.z, e.groundAnchorA.w)
        || !r.readVec4F(bytes, e.groundAnchorB.x, e.groundAnchorB.y, e.groundAnchorB.z, e.groundAnchorB.w)
        || !r.readF32(bytes, e.pulleyConstant)
        || !SnapshotReadVec4Vec(bytes, r, e.pathPoints)
        || !r.readB8(bytes, e.pathClosed)
        || !r.readB8(bytes, e.pathLockRotation)
        || !r.readB8(bytes, e.alive)
    )
        return false;
    u8 swingModeByte = 0u;
    if(
        !r.readVec4F(bytes, e.targetOrientation.x, e.targetOrientation.y, e.targetOrientation.z, e.targetOrientation.w)
        || !r.readVec4F(bytes, e.slerpImpulse.x, e.slerpImpulse.y, e.slerpImpulse.z, e.slerpImpulse.w)
        || !r.readF32(bytes, e.slerpHertz)
        || !r.readF32(bytes, e.slerpDampingRatio)
        || !r.readF32(bytes, e.slerpMaxTorque)
        || !r.readF32(bytes, e.sixDofSwingLimitY)
        || !r.readF32(bytes, e.sixDofSwingLimitZ)
        || !r.readF32(bytes, e.sixDofSwingImpulse)
        || !r.readU8(bytes, swingModeByte)
        || !r.readB8(bytes, e.enableSlerpDrive)
    )
        return false;
    if(swingModeByte >= cast<u8>(SixDofSwingLimitMode::kCount))
        return false;
    e.sixDofSwingLimitMode = cast<SixDofSwingLimitMode>(swingModeByte);
    e.rebuildPathCache();
    return true;
}

void SnapWriteBodySim<TSink : ISnapshotSink>(in BodySim sim, mut TSink w){
    SnapWriteTransform3D(w, sim.transform);
    SnapWriteVec4(w, VectorSingle(sim.centerInvMass));
    SnapWriteVec4(w, VectorSingle(sim.localCenterMinExtent));
    SnapWriteVec4(w, VectorSingle(sim.rotation0));
    SnapWriteVec4(w, VectorSingle(sim.center0MaxExtent));
    SnapWriteVec4(w, VectorSingle(sim.forceLinearDamping));
    SnapWriteVec4(w, VectorSingle(sim.torqueAngularDamping));
    SnapWriteSymMat3(w, sim.invInertiaLocal);
    SnapWriteSymMat3(w, sim.invInertiaWorld);
    w.writeF32(sim.gravityScale);
    w.writeU32(sim.flags);
    w.writeU32(sim.bodyId);
    w.writeF32(sim.maxAngularVelocity);
    w.writeF64(sim.positionDouble.x);
    w.writeF64(sim.positionDouble.y);
    w.writeF64(sim.positionDouble.z);
    w.writeF64(sim.positionDouble.w);
}

b8 SnapReadBodySim(in Span<u8> bytes, mut SnapshotByteReader r, mut BodySim sim){
    return
        r.readTransform3D(bytes, sim.transform)
        && r.readVec4F(bytes, sim.centerInvMass.x, sim.centerInvMass.y, sim.centerInvMass.z, sim.centerInvMass.w)
        && r.readVec4F(bytes, sim.localCenterMinExtent.x, sim.localCenterMinExtent.y, sim.localCenterMinExtent.z, sim.localCenterMinExtent.w)
        && r.readVec4F(bytes, sim.rotation0.x, sim.rotation0.y, sim.rotation0.z, sim.rotation0.w)
        && r.readVec4F(bytes, sim.center0MaxExtent.x, sim.center0MaxExtent.y, sim.center0MaxExtent.z, sim.center0MaxExtent.w)
        && r.readVec4F(bytes, sim.forceLinearDamping.x, sim.forceLinearDamping.y, sim.forceLinearDamping.z, sim.forceLinearDamping.w)
        && r.readVec4F(bytes, sim.torqueAngularDamping.x, sim.torqueAngularDamping.y, sim.torqueAngularDamping.z, sim.torqueAngularDamping.w)
        && r.readSymMat3(bytes, sim.invInertiaLocal)
        && r.readSymMat3(bytes, sim.invInertiaWorld)
        && r.readF32(bytes, sim.gravityScale)
        && r.readU32(bytes, sim.flags)
        && r.readU32(bytes, sim.bodyId)
        && r.readF32(bytes, sim.maxAngularVelocity)
        && r.readF64(bytes, sim.positionDouble.x)
        && r.readF64(bytes, sim.positionDouble.y)
        && r.readF64(bytes, sim.positionDouble.z)
        && r.readF64(bytes, sim.positionDouble.w)
    ;
}

void SnapWriteBodyState<TSink : ISnapshotSink>(in BodyState st, mut TSink w){
    SnapWriteVec4(w, VectorSingle(st.linearVelocity));
    SnapWriteVec4(w, VectorSingle(st.angularVelocity));
    SnapWriteVec3U32F(w, st.deltaPositionFlags.x, st.deltaPositionFlags.y, st.deltaPositionFlags.z, st.deltaPositionFlags.w);
    SnapWriteVec4(w, VectorSingle(st.deltaRotation));
}

b8 SnapReadBodyState(in Span<u8> bytes, mut SnapshotByteReader r, mut BodyState st){
    return
        r.readVec4F(bytes, st.linearVelocity.x, st.linearVelocity.y, st.linearVelocity.z, st.linearVelocity.w)
        && r.readVec4F(bytes, st.angularVelocity.x, st.angularVelocity.y, st.angularVelocity.z, st.angularVelocity.w)
        && r.readVec3U32F(bytes, st.deltaPositionFlags.x, st.deltaPositionFlags.y, st.deltaPositionFlags.z, st.deltaPositionFlags.w)
        && r.readVec4F(bytes, st.deltaRotation.x, st.deltaRotation.y, st.deltaRotation.z, st.deltaRotation.w)
    ;
}

b8 SnapWriteSolverSet<TSink : ISnapshotSink>(in SolverSet ss, mut TSink w){
    w.writeU32(ss.setIndex);
    w.writeU64(ss.membershipVersion);
    if(!w.writeCount(ss.sims.size()))
        return false;
    for(usize k = 0u; k < ss.sims.size(); ++k)
        SnapWriteBodySim(ss.sims[k], w);
    if(!w.writeCount(ss.states.size()))
        return false;
    for(usize k = 0u; k < ss.states.size(); ++k)
        SnapWriteBodyState(ss.states[k], w);
    return SnapshotWriteU32Vec(w, ss.islands);
}

b8 SnapReadSolverSet(in Span<u8> bytes, mut SnapshotByteReader r, mut SolverSet ss){
    if(!r.readU32(bytes, ss.setIndex) || !r.readU64(bytes, ss.membershipVersion))
        return false;
    u32 simC = 0u;
    if(!r.readCount(bytes, 64u, simC))
        return false;
    ss.sims.resize(simC);
    for(u32 k = 0u; k < simC; ++k){
        if(!SnapReadBodySim(bytes, r, ss.sims[k]))
            return false;
    }
    u32 stC = 0u;
    if(!r.readCount(bytes, 48u, stC))
        return false;
    ss.states.resize(stC);
    for(u32 k = 0u; k < stC; ++k){
        if(!SnapReadBodyState(bytes, r, ss.states[k]))
            return false;
    }
    return SnapshotReadU32Vec(bytes, r, ss.islands);
}

b8 SnapWriteIsland<TSink : ISnapshotSink>(in Island isl, mut TSink w){
    w.writeU32(isl.setIndex);
    w.writeU32(isl.localIndex);
    w.writeU32(isl.islandId);
    w.writeU32(isl.constraintRemoveCount);
    w.writeB8(isl.alive);
    if(!SnapshotWriteU32Vec(w, isl.bodies))
        return false;
    if(!w.writeCount(isl.contacts.size()))
        return false;
    for(usize k = 0u; k < isl.contacts.size(); ++k){
        w.writeU32(isl.contacts[k].contactId);
        w.writeU32(isl.contacts[k].bodyIdA);
        w.writeU32(isl.contacts[k].bodyIdB);
    }
    if(!w.writeCount(isl.joints.size()))
        return false;
    for(usize k = 0u; k < isl.joints.size(); ++k){
        w.writeU32(isl.joints[k].jointId);
        w.writeU32(isl.joints[k].bodyIdA);
        w.writeU32(isl.joints[k].bodyIdB);
    }
    return true;
}

b8 SnapReadIsland(in Span<u8> bytes, mut SnapshotByteReader r, mut Island isl){
    if(
        !r.readU32(bytes, isl.setIndex)
        || !r.readU32(bytes, isl.localIndex)
        || !r.readU32(bytes, isl.islandId)
        || !r.readU32(bytes, isl.constraintRemoveCount)
        || !r.readB8(bytes, isl.alive)
        || !SnapshotReadU32Vec(bytes, r, isl.bodies)
    )
        return false;
    u32 cc = 0u;
    if(!r.readCount(bytes, 12u, cc))
        return false;
    isl.contacts.resize(cc);
    for(u32 k = 0u; k < cc; ++k){
        if(!r.readU32(bytes, isl.contacts[k].contactId) || !r.readU32(bytes, isl.contacts[k].bodyIdA) || !r.readU32(bytes, isl.contacts[k].bodyIdB))
            return false;
    }
    u32 jc = 0u;
    if(!r.readCount(bytes, 12u, jc))
        return false;
    isl.joints.resize(jc);
    for(u32 k = 0u; k < jc; ++k){
        if(!r.readU32(bytes, isl.joints[k].jointId) || !r.readU32(bytes, isl.joints[k].bodyIdA) || !r.readU32(bytes, isl.joints[k].bodyIdB))
            return false;
    }
    return true;
}

void SnapWriteTreeNode<TSink : ISnapshotSink>(in TreeNode n, mut TSink w){
    SnapWriteVec3U32F(w, n.aabbMinUser.x, n.aabbMinUser.y, n.aabbMinUser.z, n.aabbMinUser.w);
    SnapWriteVec3U32F(w, n.aabbMaxLayer.x, n.aabbMaxLayer.y, n.aabbMaxLayer.z, n.aabbMaxLayer.w);
    w.writeU64(n.categoryBits);
    w.writeU32(n.parentOrNext);
    w.writeU32(n.child1);
    w.writeU32(n.child2);
    w.writeI16(n.height);
    w.writeB8(n.moved);
    w.writeU8(n.nodeFlags);
}

b8 SnapReadTreeNode(in Span<u8> bytes, mut SnapshotByteReader r, mut TreeNode n){
    return
        r.readVec3U32F(bytes, n.aabbMinUser.x, n.aabbMinUser.y, n.aabbMinUser.z, n.aabbMinUser.w)
        && r.readVec3U32F(bytes, n.aabbMaxLayer.x, n.aabbMaxLayer.y, n.aabbMaxLayer.z, n.aabbMaxLayer.w)
        && r.readU64(bytes, n.categoryBits)
        && r.readU32(bytes, n.parentOrNext)
        && r.readU32(bytes, n.child1)
        && r.readU32(bytes, n.child2)
        && r.readI16(bytes, n.height)
        && r.readB8(bytes, n.moved)
        && r.readU8(bytes, n.nodeFlags)
    ;
}

b8 SnapWriteDynamicTree<TSink : ISnapshotSink>(in DynamicTree tree, mut TSink w){
    in Vector<TreeNode> nodes = tree.nodes();
    w.writeU32(tree.root());
    w.writeU32(tree.freeList());
    w.writeU32(tree.nodeCount());
    if(!w.writeCount(nodes.size()))
        return false;
    for(usize k = 0u; k < nodes.size(); ++k)
        SnapWriteTreeNode(nodes[k], w);
    return SnapshotWriteU32Vec(w, tree.moveIndices());
}

b8 SnapReadDynamicTree(in Span<u8> bytes, mut SnapshotByteReader r, mut DynamicTree dstTree){
    u32 tRoot = s_NullIndex;
    u32 tFreeList = s_NullIndex;
    u32 tNodeCount = 0u;
    if(!r.readU32(bytes, tRoot) || !r.readU32(bytes, tFreeList) || !r.readU32(bytes, tNodeCount))
        return false;
    u32 nCount = 0u;
    if(!r.readCount(bytes, 44u, nCount))
        return false;
    if(tRoot != s_NullIndex && tRoot >= nCount)
        return false;
    if(tFreeList != s_NullIndex && tFreeList >= nCount)
        return false;
    dstTree.beginRestore(cast<usize>(nCount), cast<usize>(nCount), tRoot, tFreeList, tNodeCount);
    for(u32 k = 0u; k < nCount; ++k){
        TreeNode n;
        if(!SnapReadTreeNode(bytes, r, n))
            return false;
        dstTree.setRestoredNode(cast<usize>(k), n);
    }
    u32 mvCount = 0u;
    if(!r.readCount(bytes, 4u, mvCount) || mvCount != nCount)
        return false;
    for(u32 k = 0u; k < mvCount; ++k){
        u32 mv = s_NullIndex;
        if(!r.readU32(bytes, mv))
            return false;
        dstTree.setRestoredMoveIndex(cast<usize>(k), mv);
    }
    return true;
}

b8 SnapWriteGraph<TSink : ISnapshotSink>(in PhysicsWorld world, mut TSink w){
    for(usize c = 0u; c < s_GraphColorCount; ++c){
        if(!SnapshotWriteU32Vec(w, world.m_graph.colors[c].contactIds))
            return false;
    }
    return SnapshotWriteU32Vec(w, world.m_graph.bodyColorMasks);
}

b8 SnapReadGraph(in Span<u8> bytes, mut SnapshotByteReader r, mut PhysicsWorld tmp){
    for(usize c = 0u; c < s_GraphColorCount; ++c){
        if(!SnapshotReadU32Vec(bytes, r, tmp.m_graph.colors[c].contactIds))
            return false;
    }
    return SnapshotReadU32Vec(bytes, r, tmp.m_graph.bodyColorMasks);
}

b8 SnapWritePendingEvents<TSink : ISnapshotSink>(in PhysicsWorld world, mut TSink w){
    if(!w.writeCount(world.m_pendingContactEndEvents.size()))
        return false;
    for(usize i = 0u; i < world.m_pendingContactEndEvents.size(); ++i){
        SnapWriteShapeId(w, world.m_pendingContactEndEvents[i].shapeIdA);
        SnapWriteShapeId(w, world.m_pendingContactEndEvents[i].shapeIdB);
    }
    if(!w.writeCount(world.m_pendingSensorEndEvents.size()))
        return false;
    for(usize i = 0u; i < world.m_pendingSensorEndEvents.size(); ++i){
        SnapWriteShapeId(w, world.m_pendingSensorEndEvents[i].sensorShapeId);
        SnapWriteShapeId(w, world.m_pendingSensorEndEvents[i].visitorShapeId);
    }
    if(!w.writeCount(world.m_pendingBodyWakeEvents.size()))
        return false;
    for(usize i = 0u; i < world.m_pendingBodyWakeEvents.size(); ++i){
        SnapWriteBodyId(w, world.m_pendingBodyWakeEvents[i].bodyId);
        w.writeU64(world.m_pendingBodyWakeEvents[i].userData);
        w.writeB8(world.m_pendingBodyWakeEvents[i].awake);
    }
    return true;
}

b8 SnapReadPendingEvents(in Span<u8> bytes, mut SnapshotByteReader r, mut PhysicsWorld tmp){
    u32 pendContactEndCount = 0u;
    if(!r.readCount(bytes, 16u, pendContactEndCount))
        return false;
    tmp.m_pendingContactEndEvents.resize(pendContactEndCount);
    for(u32 i = 0u; i < pendContactEndCount; ++i){
        mut ContactEndTouchEvent ev = tmp.m_pendingContactEndEvents[i];
        if(!r.readShapeId(bytes, ev.shapeIdA) || !r.readShapeId(bytes, ev.shapeIdB))
            return false;
    }
    u32 pendSensorEndCount = 0u;
    if(!r.readCount(bytes, 16u, pendSensorEndCount))
        return false;
    tmp.m_pendingSensorEndEvents.resize(pendSensorEndCount);
    for(u32 i = 0u; i < pendSensorEndCount; ++i){
        mut SensorEndTouchEvent ev = tmp.m_pendingSensorEndEvents[i];
        if(!r.readShapeId(bytes, ev.sensorShapeId) || !r.readShapeId(bytes, ev.visitorShapeId))
            return false;
    }
    u32 pendWakeCount = 0u;
    if(!r.readCount(bytes, 17u, pendWakeCount))
        return false;
    tmp.m_pendingBodyWakeEvents.resize(pendWakeCount);
    for(u32 i = 0u; i < pendWakeCount; ++i){
        mut BodyWakeEvent ev = tmp.m_pendingBodyWakeEvents[i];
        if(!r.readBodyId(bytes, ev.bodyId) || !r.readU64(bytes, ev.userData) || !r.readB8(bytes, ev.awake))
            return false;
    }
    return true;
}

b8 SnapWriteIgnoredPairs<TSink : ISnapshotSink>(in PhysicsWorld world, mut TSink w){
    Vector<u64> ignKeys;
    ignKeys.reserve(world.m_ignoredBodyPairs.size());
    for(in u64 key : world.m_ignoredBodyPairs)
        ignKeys.push_back(key);
    if(ignKeys.size() > 1u){
        SortSequence<u64>(ignKeys, lambda[](in u64 lhs, in u64 rhs) -> b8{
            return lhs < rhs;
        });
    }
    if(!w.writeCount(ignKeys.size()))
        return false;
    for(usize i = 0u; i < ignKeys.size(); ++i)
        w.writeU64(ignKeys[i]);
    return true;
}

b8 SnapReadIgnoredPairs(in Span<u8> bytes, mut SnapshotByteReader r, mut PhysicsWorld tmp){
    u32 ignCount = 0u;
    if(!r.readCount(bytes, 8u, ignCount))
        return false;
    tmp.m_ignoredBodyPairs.clear();
    if(ignCount > 0u)
        tmp.m_ignoredBodyPairs.reserve(ignCount);
    for(u32 i = 0u; i < ignCount; ++i){
        u64 ignKey = 0u;
        if(!r.readU64(bytes, ignKey))
            return false;
        tmp.m_ignoredBodyPairs.emplace(ignKey);
    }
    return true;
}

void SnapWriteExtraManifoldRecord<TSink : ISnapshotSink>(in ExtraManifoldRecord rec, mut TSink w){
    SnapWriteManifold(rec.manifold, w);
    SnapWriteVec4(w, VectorSingle(rec.surfaceVelocity));
    SnapWriteVec4(w, VectorSingle(rec.anisotropicFriction));
    SnapWriteVec4(w, VectorSingle(rec.frictionDirection));
    w.writeF32(rec.friction);
    w.writeF32(rec.staticFriction);
    w.writeF32(rec.restitution);
    w.writeF32(rec.rollingResistance);
    w.writeF32(rec.tangentSpeed);
    w.writeF32(rec.invMassScaleA);
    w.writeF32(rec.invMassScaleB);
    w.writeF32(rec.invInertiaScaleA);
    w.writeF32(rec.invInertiaScaleB);
    w.writeF32(rec.maxNormalImpulse);
    w.writeU32(rec.flags);
    w.writeB8(rec.hasMaterialOverride);
}

b8 SnapReadExtraManifoldRecord(in Span<u8> bytes, mut SnapshotByteReader r, mut ExtraManifoldRecord outRec){
    return
        SnapReadManifold(bytes, r, outRec.manifold)
        && r.readVec4F(bytes, outRec.surfaceVelocity.x, outRec.surfaceVelocity.y, outRec.surfaceVelocity.z, outRec.surfaceVelocity.w)
        && r.readVec4F(bytes, outRec.anisotropicFriction.x, outRec.anisotropicFriction.y, outRec.anisotropicFriction.z, outRec.anisotropicFriction.w)
        && r.readVec4F(bytes, outRec.frictionDirection.x, outRec.frictionDirection.y, outRec.frictionDirection.z, outRec.frictionDirection.w)
        && r.readF32(bytes, outRec.friction)
        && r.readF32(bytes, outRec.staticFriction)
        && r.readF32(bytes, outRec.restitution)
        && r.readF32(bytes, outRec.rollingResistance)
        && r.readF32(bytes, outRec.tangentSpeed)
        && r.readF32(bytes, outRec.invMassScaleA)
        && r.readF32(bytes, outRec.invMassScaleB)
        && r.readF32(bytes, outRec.invInertiaScaleA)
        && r.readF32(bytes, outRec.invInertiaScaleB)
        && r.readF32(bytes, outRec.maxNormalImpulse)
        && r.readU32(bytes, outRec.flags)
        && r.readB8(bytes, outRec.hasMaterialOverride)
    ;
}

b8 SnapWriteExtraManifoldList<TSink : ISnapshotSink>(in u32 cId, in FixedVector<ExtraManifoldRecord, s_MaxExtraManifoldsPerContact> list, mut TSink w){
    w.writeU32(cId);
    if(!w.writeCount(list.size()))
        return false;
    for(usize ei = 0u; ei < list.size(); ++ei)
        SnapWriteExtraManifoldRecord(list[ei], w);
    return true;
}

b8 SnapWriteExtraManifolds<TSink : ISnapshotSink>(in PhysicsWorld world, mut TSink w){
    Vector<u32> extraKeys;
    extraKeys.reserve(world.m_extraContactManifolds.size());
    for(in auto entry : world.m_extraContactManifolds)
        extraKeys.push_back(entry.first);
    if(extraKeys.size() > 1u){
        SortSequence<u32>(extraKeys, lambda[](in u32 lhs, in u32 rhs) -> b8{
            return lhs < rhs;
        });
    }
    if(!w.writeCount(extraKeys.size()))
        return false;
    for(usize i = 0u; i < extraKeys.size(); ++i){
        const u32 cId = extraKeys[i];
        const auto itExtra = world.m_extraContactManifolds.find(cId);
        if(!SnapWriteExtraManifoldList(cId, itExtra.value(), w))
            return false;
    }
    return true;
}

b8 SnapReadExtraManifolds(in Span<u8> bytes, mut SnapshotByteReader r, in usize contactCap, mut PhysicsWorld tmp){
    u32 extraCount = 0u;
    if(!r.readCount(bytes, 8u, extraCount))
        return false;
    tmp.m_extraContactManifolds.clear();
    if(extraCount > 0u)
        tmp.m_extraContactManifolds.reserve(extraCount);
    for(u32 i = 0u; i < extraCount; ++i){
        u32 cId = 0u;
        u32 mCount = 0u;
        if(!r.readU32(bytes, cId) || cast<usize>(cId) >= contactCap || !r.readCount(bytes, 64u, mCount) || mCount == 0u || mCount > s_MaxExtraManifoldsPerContact)
            return false;
        FixedVector<ExtraManifoldRecord, s_MaxExtraManifoldsPerContact> list;
        list.resize(mCount);
        for(u32 mi = 0u; mi < mCount; ++mi){
            if(!SnapReadExtraManifoldRecord(bytes, r, list[mi]))
                return false;
        }
        tmp.m_extraContactManifolds.insert_or_assign(cId, list);
    }
    return true;
}

void RebuildDirtyMassBodyIds(mut PhysicsWorld tmp){
    tmp.m_dirtyMassBodyIds.clear();
    if(!tmp.m_hasDirtyBodyMass)
        return;
    const u32 dirtyBit = cast<u32>(BodyFlags::DirtyMass);
    for(usize i = 0u; i < tmp.m_bodies.size(); ++i){
        in Body b = tmp.m_bodies[i];
        if(b.alive && (b.flags & dirtyBit) != 0u)
            tmp.m_dirtyMassBodyIds.push_back(cast<u32>(i));
    }
}

b8 SerializePhysicsWorldSnapshotPayloadWithPoolBytes<TSink : ISnapshotSink>(
    in PhysicsWorld world,
    mut TSink w,
    mut SnapshotWorldProvenance outProv
){
    w.writeU32(s_SnapshotMagic);
    w.writeU32(s_SnapshotVersion);

    SnapWriteWorldGlobals(world, w);

    if(!w.writeCount(world.m_bodies.size()))
        return false;
    for(usize i = 0u; i < world.m_bodies.size(); ++i)
        SnapWriteBody(world.m_bodies[i], w);
    if(!SnapshotWriteU32Vec(w, world.m_freeBodyIds))
        return false;

    if(!w.writeCount(world.m_shapes.size()))
        return false;
    for(usize i = 0u; i < world.m_shapes.size(); ++i)
        SnapWriteShape(world.m_shapes[i], w);
    if(!SnapshotWriteU32Vec(w, world.m_freeShapeIds))
        return false;

    const usize sHull = w.byteCount();
    if(!SnapWriteHullPool(world, w))
        return false;
    outProv.hullPoolBytes = cast<u64>(w.byteCount() - sHull);

    const usize sMesh = w.byteCount();
    if(!SnapWriteMeshPool(world, w))
        return false;
    outProv.meshPoolBytes = cast<u64>(w.byteCount() - sMesh);

    const usize sHf = w.byteCount();
    if(!SnapWriteHeightfieldPool(world, w))
        return false;
    outProv.heightfieldPoolBytes = cast<u64>(w.byteCount() - sHf);

    const usize sComp = w.byteCount();
    if(!SnapWriteCompoundPool(world, w))
        return false;
    outProv.compoundPoolBytes = cast<u64>(w.byteCount() - sComp);

    const usize sSc = w.byteCount();
    if(!SnapWriteScaledPool(world, w))
        return false;
    outProv.scaledPoolBytes = cast<u64>(w.byteCount() - sSc);

    const usize sCh = w.byteCount();
    if(!SnapWriteChainPool(world, w))
        return false;
    outProv.chainPoolBytes = cast<u64>(w.byteCount() - sCh);

    const usize sSdf = w.byteCount();
    if(!SnapWriteSdfPool(world, w))
        return false;
    outProv.sdfPoolBytes = cast<u64>(w.byteCount() - sSdf);

    if(!w.writeCount(world.m_contacts.size()))
        return false;
    for(usize i = 0u; i < world.m_contacts.size(); ++i)
        SnapWriteContact(world.m_contacts[i], w);
    if(!SnapshotWriteU32Vec(w, world.m_freeContactIds))
        return false;

    if(!w.writeCount(world.m_joints.size()))
        return false;
    for(usize i = 0u; i < world.m_joints.size(); ++i)
        SnapWriteJoint(world.m_joints[i], w);
    if(!SnapshotWriteU32Vec(w, world.m_freeJointIds))
        return false;

    if(!w.writeCount(world.m_jointExtraData.size()))
        return false;
    for(usize i = 0u; i < world.m_jointExtraData.size(); ++i){
        if(!SnapWriteJointExtraData(world.m_jointExtraData[i], w))
            return false;
    }
    if(!SnapshotWriteU32Vec(w, world.m_freeJointExtraData))
        return false;

    if(!w.writeCount(world.m_solverSets.size()))
        return false;
    for(usize i = 0u; i < world.m_solverSets.size(); ++i){
        if(!SnapWriteSolverSet(world.m_solverSets[i], w))
            return false;
    }
    if(!SnapshotWriteU32Vec(w, world.m_freeSolverSetIds))
        return false;

    if(!w.writeCount(world.m_islands.size()))
        return false;
    for(usize i = 0u; i < world.m_islands.size(); ++i){
        if(!SnapWriteIsland(world.m_islands[i], w))
            return false;
    }
    if(!SnapshotWriteU32Vec(w, world.m_freeIslandIds))
        return false;

    if(!SnapWriteGraph(world, w))
        return false;

    for(usize t = 0u; t < s_TreeCount; ++t){
        if(!SnapWriteDynamicTree(world.m_broadPhase.trees[t], w))
            return false;
    }
    if(!SnapshotWriteU32Vec(w, world.m_broadPhase.moveArray))
        return false;

    return
        SnapWritePendingEvents(world, w)
        && SnapWriteIgnoredPairs(world, w)
        && SnapWriteExtraManifolds(world, w)
    ;
}

b8 SerializePhysicsWorldSnapshotPayload<TSink : ISnapshotSink>(in PhysicsWorld world, mut TSink w){
    SnapshotWorldProvenance unusedProv;
    return SerializePhysicsWorldSnapshotPayloadWithPoolBytes(world, w, unusedProv);
}

class SnapshotDirectByteWriter : ISnapshotSink{
    private mut Vector<u8> m_outBytes;
    public u64 m_hash = s_Fnv64OffsetBasis;

    public SnapshotDirectByteWriter(mut Vector<u8> outBytes){
        this.m_outBytes = outBytes;
    }

    public void writeU8(in u8 v)override{
        this.m_hash ^= cast<u64>(v);
        this.m_hash *= s_Fnv64Prime;
        this.m_outBytes.push_back(v);
    }

    public void writeB8(in b8 v)override{
        if(v)
            this.writeU8(1u);
        else
            this.writeU8(0u);
    }

    public void writeU16(in u16 v)override{
        const u8 b0 = cast<u8>(v & 0xffu);
        const u8 b1 = cast<u8>((v >> 8u) & 0xffu);
        u64 h = this.m_hash;
        h ^= cast<u64>(b0); h *= s_Fnv64Prime;
        h ^= cast<u64>(b1); h *= s_Fnv64Prime;
        this.m_hash = h;
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + 2u);
        this.m_outBytes[pos] = b0;
        this.m_outBytes[pos + 1u] = b1;
    }

    public void writeI16(in i16 v)override{
        this.writeU16(bit_cast<u16>(v));
    }

    public void writeU32(in u32 v)override{
        const u8 b0 = cast<u8>(v & 0xffu);
        const u8 b1 = cast<u8>((v >> 8u) & 0xffu);
        const u8 b2 = cast<u8>((v >> 16u) & 0xffu);
        const u8 b3 = cast<u8>((v >> 24u) & 0xffu);
        u64 h = this.m_hash;
        h ^= cast<u64>(b0); h *= s_Fnv64Prime;
        h ^= cast<u64>(b1); h *= s_Fnv64Prime;
        h ^= cast<u64>(b2); h *= s_Fnv64Prime;
        h ^= cast<u64>(b3); h *= s_Fnv64Prime;
        this.m_hash = h;
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + 4u);
        this.m_outBytes[pos] = b0;
        this.m_outBytes[pos + 1u] = b1;
        this.m_outBytes[pos + 2u] = b2;
        this.m_outBytes[pos + 3u] = b3;
    }

    public void writeI32(in i32 v)override{
        this.writeU32(bit_cast<u32>(v));
    }

    public void writeU64(in u64 v)override{
        const u32 lo = cast<u32>(v & 0xffffffffu);
        const u32 hi = cast<u32>((v >> 32u) & 0xffffffffu);
        const u8 b0 = cast<u8>(lo & 0xffu);
        const u8 b1 = cast<u8>((lo >> 8u) & 0xffu);
        const u8 b2 = cast<u8>((lo >> 16u) & 0xffu);
        const u8 b3 = cast<u8>((lo >> 24u) & 0xffu);
        const u8 b4 = cast<u8>(hi & 0xffu);
        const u8 b5 = cast<u8>((hi >> 8u) & 0xffu);
        const u8 b6 = cast<u8>((hi >> 16u) & 0xffu);
        const u8 b7 = cast<u8>((hi >> 24u) & 0xffu);
        u64 h = this.m_hash;
        h ^= cast<u64>(b0); h *= s_Fnv64Prime;
        h ^= cast<u64>(b1); h *= s_Fnv64Prime;
        h ^= cast<u64>(b2); h *= s_Fnv64Prime;
        h ^= cast<u64>(b3); h *= s_Fnv64Prime;
        h ^= cast<u64>(b4); h *= s_Fnv64Prime;
        h ^= cast<u64>(b5); h *= s_Fnv64Prime;
        h ^= cast<u64>(b6); h *= s_Fnv64Prime;
        h ^= cast<u64>(b7); h *= s_Fnv64Prime;
        this.m_hash = h;
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + 8u);
        this.m_outBytes[pos] = b0;
        this.m_outBytes[pos + 1u] = b1;
        this.m_outBytes[pos + 2u] = b2;
        this.m_outBytes[pos + 3u] = b3;
        this.m_outBytes[pos + 4u] = b4;
        this.m_outBytes[pos + 5u] = b5;
        this.m_outBytes[pos + 6u] = b6;
        this.m_outBytes[pos + 7u] = b7;
    }

    public void writeF32(in f32 v)override{
        this.writeU32(bit_cast<u32>(v));
    }

    public void writeF64(in f64 v)override{
        this.writeU64(bit_cast<u64>(v));
    }

    public b8 writeCount(in usize n)override{
        if(n > s_SnapshotMaxElements)
            return false;
        this.writeU32(cast<u32>(n));
        return true;
    }

    public void writeBytes(in Span<u8> data)override{
        const usize n = data.size();
        if(n == 0u)
            return;
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + n);
        u64 h = this.m_hash;
        for(usize i = 0u; i < n; ++i){
            const u8 b = data[i];
            h ^= cast<u64>(b);
            h *= s_Fnv64Prime;
            this.m_outBytes[pos + i] = b;
        }
        this.m_hash = h;
    }

    public void writeU16Span(in Span<u16> data)override{
        const usize n = data.size();
        if(n == 0u)
            return;
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + n * 2u);
        u64 h = this.m_hash;
        usize dst = pos;
        for(usize i = 0u; i < n; ++i){
            const u16 v = data[i];
            const u8 b0 = cast<u8>(v & 0xffu);
            const u8 b1 = cast<u8>((v >> 8u) & 0xffu);
            h ^= cast<u64>(b0); h *= s_Fnv64Prime;
            h ^= cast<u64>(b1); h *= s_Fnv64Prime;
            this.m_outBytes[dst] = b0;
            this.m_outBytes[dst + 1u] = b1;
            dst += 2u;
        }
        this.m_hash = h;
    }

    public void writeU32Span(in Span<u32> data)override{
        const usize n = data.size();
        if(n == 0u)
            return;
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + n * 4u);
        u64 h = this.m_hash;
        usize dst = pos;
        for(usize i = 0u; i < n; ++i){
            const u32 v = data[i];
            const u8 b0 = cast<u8>(v & 0xffu);
            const u8 b1 = cast<u8>((v >> 8u) & 0xffu);
            const u8 b2 = cast<u8>((v >> 16u) & 0xffu);
            const u8 b3 = cast<u8>((v >> 24u) & 0xffu);
            h ^= cast<u64>(b0); h *= s_Fnv64Prime;
            h ^= cast<u64>(b1); h *= s_Fnv64Prime;
            h ^= cast<u64>(b2); h *= s_Fnv64Prime;
            h ^= cast<u64>(b3); h *= s_Fnv64Prime;
            this.m_outBytes[dst] = b0;
            this.m_outBytes[dst + 1u] = b1;
            this.m_outBytes[dst + 2u] = b2;
            this.m_outBytes[dst + 3u] = b3;
            dst += 4u;
        }
        this.m_hash = h;
    }

    public void writeF32Span(in Span<f32> data)override{
        const usize n = data.size();
        if(n == 0u)
            return;
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + n * 4u);
        u64 h = this.m_hash;
        usize dst = pos;
        for(usize i = 0u; i < n; ++i){
            const u32 v = bit_cast<u32>(data[i]);
            const u8 b0 = cast<u8>(v & 0xffu);
            const u8 b1 = cast<u8>((v >> 8u) & 0xffu);
            const u8 b2 = cast<u8>((v >> 16u) & 0xffu);
            const u8 b3 = cast<u8>((v >> 24u) & 0xffu);
            h ^= cast<u64>(b0); h *= s_Fnv64Prime;
            h ^= cast<u64>(b1); h *= s_Fnv64Prime;
            h ^= cast<u64>(b2); h *= s_Fnv64Prime;
            h ^= cast<u64>(b3); h *= s_Fnv64Prime;
            this.m_outBytes[dst] = b0;
            this.m_outBytes[dst + 1u] = b1;
            this.m_outBytes[dst + 2u] = b2;
            this.m_outBytes[dst + 3u] = b3;
            dst += 4u;
        }
        this.m_hash = h;
    }

    public usize byteCount()const override{
        return this.m_outBytes.size();
    }
}

class SnapshotRawByteWriter : ISnapshotSink{
    private mut Vector<u8> m_outBytes;

    public SnapshotRawByteWriter(mut Vector<u8> outBytes){
        this.m_outBytes = outBytes;
    }

    public void writeU8(in u8 v)override{
        this.m_outBytes.push_back(v);
    }

    public void writeB8(in b8 v)override{
        if(v)
            this.m_outBytes.push_back(1u);
        else
            this.m_outBytes.push_back(0u);
    }

    public void writeU16(in u16 v)override{
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + 2u);
        this.m_outBytes[pos] = cast<u8>(v & 0xffu);
        this.m_outBytes[pos + 1u] = cast<u8>((v >> 8u) & 0xffu);
    }

    public void writeI16(in i16 v)override{
        this.writeU16(bit_cast<u16>(v));
    }

    public void writeU32(in u32 v)override{
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + 4u);
        this.m_outBytes[pos] = cast<u8>(v & 0xffu);
        this.m_outBytes[pos + 1u] = cast<u8>((v >> 8u) & 0xffu);
        this.m_outBytes[pos + 2u] = cast<u8>((v >> 16u) & 0xffu);
        this.m_outBytes[pos + 3u] = cast<u8>((v >> 24u) & 0xffu);
    }

    public void writeI32(in i32 v)override{
        this.writeU32(bit_cast<u32>(v));
    }

    public void writeU64(in u64 v)override{
        const u32 lo = cast<u32>(v & 0xffffffffu);
        const u32 hi = cast<u32>((v >> 32u) & 0xffffffffu);
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + 8u);
        this.m_outBytes[pos] = cast<u8>(lo & 0xffu);
        this.m_outBytes[pos + 1u] = cast<u8>((lo >> 8u) & 0xffu);
        this.m_outBytes[pos + 2u] = cast<u8>((lo >> 16u) & 0xffu);
        this.m_outBytes[pos + 3u] = cast<u8>((lo >> 24u) & 0xffu);
        this.m_outBytes[pos + 4u] = cast<u8>(hi & 0xffu);
        this.m_outBytes[pos + 5u] = cast<u8>((hi >> 8u) & 0xffu);
        this.m_outBytes[pos + 6u] = cast<u8>((hi >> 16u) & 0xffu);
        this.m_outBytes[pos + 7u] = cast<u8>((hi >> 24u) & 0xffu);
    }

    public void writeF32(in f32 v)override{
        this.writeU32(bit_cast<u32>(v));
    }

    public void writeF64(in f64 v)override{
        this.writeU64(bit_cast<u64>(v));
    }

    public b8 writeCount(in usize n)override{
        if(n > s_SnapshotMaxElements)
            return false;
        this.writeU32(cast<u32>(n));
        return true;
    }

    public void writeBytes(in Span<u8> data)override{
        const usize n = data.size();
        if(n == 0u)
            return;
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + n);
        for(usize i = 0u; i < n; ++i)
            this.m_outBytes[pos + i] = data[i];
    }

    public void writeU16Span(in Span<u16> data)override{
        const usize n = data.size();
        if(n == 0u)
            return;
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + n * 2u);
        usize dst = pos;
        for(usize i = 0u; i < n; ++i){
            const u16 v = data[i];
            this.m_outBytes[dst] = cast<u8>(v & 0xffu);
            this.m_outBytes[dst + 1u] = cast<u8>((v >> 8u) & 0xffu);
            dst += 2u;
        }
    }

    public void writeU32Span(in Span<u32> data)override{
        const usize n = data.size();
        if(n == 0u)
            return;
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + n * 4u);
        usize dst = pos;
        for(usize i = 0u; i < n; ++i){
            const u32 v = data[i];
            this.m_outBytes[dst] = cast<u8>(v & 0xffu);
            this.m_outBytes[dst + 1u] = cast<u8>((v >> 8u) & 0xffu);
            this.m_outBytes[dst + 2u] = cast<u8>((v >> 16u) & 0xffu);
            this.m_outBytes[dst + 3u] = cast<u8>((v >> 24u) & 0xffu);
            dst += 4u;
        }
    }

    public void writeF32Span(in Span<f32> data)override{
        const usize n = data.size();
        if(n == 0u)
            return;
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + n * 4u);
        usize dst = pos;
        for(usize i = 0u; i < n; ++i){
            const u32 v = bit_cast<u32>(data[i]);
            this.m_outBytes[dst] = cast<u8>(v & 0xffu);
            this.m_outBytes[dst + 1u] = cast<u8>((v >> 8u) & 0xffu);
            this.m_outBytes[dst + 2u] = cast<u8>((v >> 16u) & 0xffu);
            this.m_outBytes[dst + 3u] = cast<u8>((v >> 24u) & 0xffu);
            dst += 4u;
        }
    }

    public usize byteCount()const override{
        return this.m_outBytes.size();
    }
}

class SnapshotWorldProvenance{
    public u64 worldGeneration = 0u;
    public u64 hullPoolVersion = 0u;
    public u64 meshPoolVersion = 0u;
    public u64 heightfieldPoolVersion = 0u;
    public u64 compoundPoolVersion = 0u;
    public u64 scaledPoolVersion = 0u;
    public u64 chainPoolVersion = 0u;
    public u64 sdfPoolVersion = 0u;
    public u64 hullPoolBytes = 0u;
    public u64 meshPoolBytes = 0u;
    public u64 heightfieldPoolBytes = 0u;
    public u64 compoundPoolBytes = 0u;
    public u64 scaledPoolBytes = 0u;
    public u64 chainPoolBytes = 0u;
    public u64 sdfPoolBytes = 0u;
}

class SnapshotWorldSectionSpans{
    public usize globalsStart = 0u;
    public usize globalsEnd = 0u;
    public usize hullPoolStart = 0u;
    public usize hullPoolEnd = 0u;
    public usize meshPoolStart = 0u;
    public usize meshPoolEnd = 0u;
    public usize heightfieldPoolStart = 0u;
    public usize heightfieldPoolEnd = 0u;
    public usize compoundPoolStart = 0u;
    public usize compoundPoolEnd = 0u;
    public usize scaledPoolStart = 0u;
    public usize scaledPoolEnd = 0u;
    public usize chainPoolStart = 0u;
    public usize chainPoolEnd = 0u;
    public usize sdfPoolStart = 0u;
    public usize sdfPoolEnd = 0u;
    public usize graphStart = 0u;
    public usize graphEnd = 0u;
    public usize pendingEventsStart = 0u;
    public usize pendingEventsEnd = 0u;
    public usize ignoredPairsStart = 0u;
    public usize ignoredPairsEnd = 0u;
    public usize extraManifoldsStart = 0u;
    public usize extraManifoldsEnd = 0u;
}

void WriteSnapshotProvenanceFooter(in PhysicsWorld world, in SnapshotWorldProvenance poolSizes, mut SnapshotDirectByteWriter w){
    w.writeU64(world.m_worldGeneration);
    w.writeU64(world.m_hullPoolVersion);
    w.writeU64(world.m_meshPoolVersion);
    w.writeU64(world.m_heightfieldPoolVersion);
    w.writeU64(world.m_compoundPoolVersion);
    w.writeU64(world.m_scaledPoolVersion);
    w.writeU64(world.m_chainPoolVersion);
    w.writeU64(world.m_sdfPoolVersion);
    w.writeU64(poolSizes.hullPoolBytes);
    w.writeU64(poolSizes.meshPoolBytes);
    w.writeU64(poolSizes.heightfieldPoolBytes);
    w.writeU64(poolSizes.compoundPoolBytes);
    w.writeU64(poolSizes.scaledPoolBytes);
    w.writeU64(poolSizes.chainPoolBytes);
    w.writeU64(poolSizes.sdfPoolBytes);
}

b8 SerializePhysicsWorldSnapshot(in PhysicsWorld world, mut Vector<u8> outBytes){
    outBytes.clear();
    outBytes.reserve(EstimatePhysicsWorldSnapshotSize(world) + 128u);
    SnapshotDirectByteWriter w(outBytes);
    SnapshotWorldProvenance poolSizes;
    if(!SerializePhysicsWorldSnapshotPayloadWithPoolBytes(world, w, poolSizes))
        return false;
    WriteSnapshotProvenanceFooter(world, poolSizes, w);
    w.writeU64(w.m_hash);
    return true;
}

b8 SnapTrySkipSectionBytes(mut SnapshotByteReader r, in u64 byteCount, mut usize outStart, mut usize outEnd){
    if(r.cursor > r.limit)
        return false;
    const u64 rem = cast<u64>(r.limit - r.cursor);
    if(byteCount > rem)
        return false;
    outStart = r.cursor;
    r.cursor += cast<usize>(byteCount);
    outEnd = r.cursor;
    return true;
}

u32 ComputeMatchingPoolSkipMask(in SnapshotWorldProvenance prov, in PhysicsWorld world){
    if(prov.worldGeneration != world.m_worldGeneration)
        return 0u;
    u32 mask = 0u;
    if(prov.hullPoolVersion == world.m_hullPoolVersion)
        mask |= 1u;
    if(prov.meshPoolVersion == world.m_meshPoolVersion)
        mask |= 2u;
    if(prov.heightfieldPoolVersion == world.m_heightfieldPoolVersion)
        mask |= 4u;
    if(prov.compoundPoolVersion == world.m_compoundPoolVersion)
        mask |= 8u;
    if(prov.scaledPoolVersion == world.m_scaledPoolVersion)
        mask |= 16u;
    if(prov.chainPoolVersion == world.m_chainPoolVersion)
        mask |= 32u;
    if(prov.sdfPoolVersion == world.m_sdfPoolVersion)
        mask |= 64u;
    return mask;
}

b8 ReadPhysicsWorldSnapshotPayloadWithSpansFiltered(
    in Span<u8> bytes,
    in u32 skipPoolMask,
    in SnapshotWorldProvenance prov,
    mut SnapshotByteReader r,
    mut PhysicsWorld tmp,
    mut SnapshotWorldSectionSpans outSpans
){
    u32 magic = 0u;
    u32 version = 0u;
    if(!r.readU32(bytes, magic) || !r.readU32(bytes, version))
        return false;
    if(magic != s_SnapshotMagic || version != s_SnapshotVersion)
        return false;

    tmp.clear();
    tmp.m_solverSets.clear();

    outSpans.globalsStart = r.cursor;
    if(!SnapReadWorldGlobals(bytes, r, tmp))
        return false;
    outSpans.globalsEnd = r.cursor;

    u32 bodyCount = 0u;
    if(!r.readCount(bytes, 32u, bodyCount))
        return false;
    tmp.m_bodies.resize(bodyCount);
    for(u32 i = 0u; i < bodyCount; ++i){
        if(!SnapReadBody(bytes, r, tmp.m_bodies[i]))
            return false;
    }
    RebuildDirtyMassBodyIds(tmp);
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeBodyIds))
        return false;

    u32 shapeCount = 0u;
    if(!r.readCount(bytes, 64u, shapeCount))
        return false;
    tmp.m_shapes.resize(shapeCount);
    for(u32 i = 0u; i < shapeCount; ++i){
        if(!SnapReadShape(bytes, r, tmp.m_shapes[i]))
            return false;
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeShapeIds))
        return false;

    if((skipPoolMask & 1u) != 0u){
        if(!SnapTrySkipSectionBytes(r, prov.hullPoolBytes, outSpans.hullPoolStart, outSpans.hullPoolEnd))
            return false;
    }
    else{
        outSpans.hullPoolStart = r.cursor;
        if(!SnapReadHullPool(bytes, r, tmp))
            return false;
        outSpans.hullPoolEnd = r.cursor;
    }

    if((skipPoolMask & 2u) != 0u){
        if(!SnapTrySkipSectionBytes(r, prov.meshPoolBytes, outSpans.meshPoolStart, outSpans.meshPoolEnd))
            return false;
    }
    else{
        outSpans.meshPoolStart = r.cursor;
        if(!SnapReadMeshPool(bytes, r, tmp))
            return false;
        outSpans.meshPoolEnd = r.cursor;
    }

    if((skipPoolMask & 4u) != 0u){
        if(!SnapTrySkipSectionBytes(r, prov.heightfieldPoolBytes, outSpans.heightfieldPoolStart, outSpans.heightfieldPoolEnd))
            return false;
    }
    else{
        outSpans.heightfieldPoolStart = r.cursor;
        if(!SnapReadHeightfieldPool(bytes, r, tmp))
            return false;
        outSpans.heightfieldPoolEnd = r.cursor;
    }

    if((skipPoolMask & 8u) != 0u){
        if(!SnapTrySkipSectionBytes(r, prov.compoundPoolBytes, outSpans.compoundPoolStart, outSpans.compoundPoolEnd))
            return false;
    }
    else{
        outSpans.compoundPoolStart = r.cursor;
        if(!SnapReadCompoundPool(bytes, r, tmp))
            return false;
        outSpans.compoundPoolEnd = r.cursor;
    }

    if((skipPoolMask & 16u) != 0u){
        if(!SnapTrySkipSectionBytes(r, prov.scaledPoolBytes, outSpans.scaledPoolStart, outSpans.scaledPoolEnd))
            return false;
    }
    else{
        outSpans.scaledPoolStart = r.cursor;
        if(!SnapReadScaledPool(bytes, r, tmp))
            return false;
        outSpans.scaledPoolEnd = r.cursor;
    }

    if((skipPoolMask & 32u) != 0u){
        if(!SnapTrySkipSectionBytes(r, prov.chainPoolBytes, outSpans.chainPoolStart, outSpans.chainPoolEnd))
            return false;
    }
    else{
        outSpans.chainPoolStart = r.cursor;
        if(!SnapReadChainPool(bytes, r, tmp))
            return false;
        outSpans.chainPoolEnd = r.cursor;
    }

    if((skipPoolMask & 64u) != 0u){
        if(!SnapTrySkipSectionBytes(r, prov.sdfPoolBytes, outSpans.sdfPoolStart, outSpans.sdfPoolEnd))
            return false;
    }
    else{
        outSpans.sdfPoolStart = r.cursor;
        if(!SnapReadSdfPool(bytes, r, tmp))
            return false;
        outSpans.sdfPoolEnd = r.cursor;
    }

    u32 contactCount = 0u;
    if(!r.readCount(bytes, 64u, contactCount))
        return false;
    tmp.m_contacts.resize(contactCount);
    for(u32 i = 0u; i < contactCount; ++i){
        if(!SnapReadContact(bytes, r, tmp.m_contacts[i]))
            return false;
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeContactIds))
        return false;

    u32 jointCount = 0u;
    if(!r.readCount(bytes, 64u, jointCount))
        return false;
    tmp.m_joints.resize(jointCount);
    for(u32 i = 0u; i < jointCount; ++i){
        if(!SnapReadJoint(bytes, r, tmp.m_joints[i]))
            return false;
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeJointIds))
        return false;

    u32 extraCount = 0u;
    if(!r.readCount(bytes, 32u, extraCount))
        return false;
    tmp.m_jointExtraData.resize(extraCount);
    for(u32 i = 0u; i < extraCount; ++i){
        if(!SnapReadJointExtraData(bytes, r, tmp.m_jointExtraData[i]))
            return false;
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeJointExtraData))
        return false;

    u32 setCount = 0u;
    if(!r.readCount(bytes, 12u, setCount) || setCount < 3u)
        return false;
    tmp.m_solverSets.resize(setCount);
    for(u32 i = 0u; i < setCount; ++i){
        if(!SnapReadSolverSet(bytes, r, tmp.m_solverSets[i]))
            return false;
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeSolverSetIds))
        return false;

    u32 islandCount = 0u;
    if(!r.readCount(bytes, 16u, islandCount))
        return false;
    tmp.m_islands.resize(islandCount);
    for(u32 i = 0u; i < islandCount; ++i){
        if(!SnapReadIsland(bytes, r, tmp.m_islands[i]))
            return false;
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeIslandIds))
        return false;

    outSpans.graphStart = r.cursor;
    if(!SnapReadGraph(bytes, r, tmp))
        return false;
    outSpans.graphEnd = r.cursor;

    for(usize t = 0u; t < s_TreeCount; ++t){
        if(!SnapReadDynamicTree(bytes, r, tmp.m_broadPhase.trees[t]))
            return false;
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_broadPhase.moveArray))
        return false;

    outSpans.pendingEventsStart = r.cursor;
    if(!SnapReadPendingEvents(bytes, r, tmp))
        return false;
    outSpans.pendingEventsEnd = r.cursor;

    outSpans.ignoredPairsStart = r.cursor;
    if(!SnapReadIgnoredPairs(bytes, r, tmp))
        return false;
    outSpans.ignoredPairsEnd = r.cursor;

    outSpans.extraManifoldsStart = r.cursor;
    if(!SnapReadExtraManifolds(bytes, r, contactCount, tmp))
        return false;
    outSpans.extraManifoldsEnd = r.cursor;

    if(skipPoolMask == 0u && !ValidateRestoredPhysicsWorld(tmp))
        return false;
    return true;
}

b8 ReadPhysicsWorldSnapshotPayloadWithSpans(
    in Span<u8> bytes,
    mut SnapshotByteReader r,
    mut PhysicsWorld tmp,
    mut SnapshotWorldSectionSpans outSpans
){
    SnapshotWorldProvenance unusedProv;
    return ReadPhysicsWorldSnapshotPayloadWithSpansFiltered(bytes, 0u, unusedProv, r, tmp, outSpans);
}

b8 ReadPhysicsWorldSnapshotPayload(in Span<u8> bytes, mut SnapshotByteReader r, mut PhysicsWorld tmp){
    SnapshotWorldSectionSpans unusedSpans;
    return ReadPhysicsWorldSnapshotPayloadWithSpans(bytes, r, tmp, unusedSpans);
}

b8 ValidateShapePoolMeta(
    in usize poolSize,
    in Vector<u32> refCounts,
    in Vector<u16> generations,
    in Vector<u8> ownedByUser,
    in Vector<u32> freeIds
){
    if(refCounts.size() != poolSize || generations.size() != poolSize || ownedByUser.size() != poolSize)
        return false;
    for(usize i = 0u; i < freeIds.size(); ++i){
        if(freeIds[i] >= poolSize)
            return false;
    }
    return true;
}

b8 ValidateSubShapePoolIndexBounds(
    in ShapeType st,
    in u32 geomIdx,
    in usize hullCap,
    in usize meshCap,
    in usize hfCap,
    in usize compCap,
    in usize scaledCap,
    in usize chainCap,
    in usize sdfCap
){
    if(st == ShapeType::Hull)
        return cast<usize>(geomIdx) < hullCap;
    if(st == ShapeType::Mesh)
        return cast<usize>(geomIdx) < meshCap;
    if(st == ShapeType::Heightfield)
        return cast<usize>(geomIdx) < hfCap;
    if(st == ShapeType::Compound)
        return cast<usize>(geomIdx) < compCap;
    if(st == ShapeType::Scaled)
        return cast<usize>(geomIdx) < scaledCap;
    if(st == ShapeType::Chain)
        return cast<usize>(geomIdx) < chainCap;
    if(st == ShapeType::Sdf)
        return cast<usize>(geomIdx) < sdfCap;
    return true;
}

b8 ValidateCompoundHierarchyAcyclic(
    in PhysicsWorld tmp,
    in u32 rootCompIdx,
    in usize hullCap,
    in usize meshCap,
    in usize hfCap,
    in usize compCap,
    in usize scaledCap,
    in usize chainCap,
    in usize sdfCap
){
    if(cast<usize>(rootCompIdx) >= compCap)
        return false;
    Array<u32, 9u> stackComp;
    Array<usize, 9u> stackChild;
    usize sp = 0u;
    stackComp[0u] = rootCompIdx;
    stackChild[0u] = 0u;
    while(true){
        const u32 curComp = stackComp[sp];
        in CompoundShape cur = tmp.m_compoundShapes[curComp];
        const usize k = stackChild[sp];
        if(k >= cur.children.size()){
            if(sp == 0u)
                break;
            --sp;
            continue;
        }
        ++stackChild[sp];
        in CompoundSubShape sub = cur.children[k];
        if(!ValidateSubShapePoolIndexBounds(sub.type, sub.geometryIndex, hullCap, meshCap, hfCap, compCap, scaledCap, chainCap, sdfCap))
            return false;
        ShapeType nextType = sub.type;
        u32 nextIdx = sub.geometryIndex;
        if(nextType == ShapeType::Scaled){
            in ScaledShape sc = tmp.m_scaledShapes[nextIdx];
            if(sc.childType == ShapeType::Scaled)
                return false;
            if(!ValidateSubShapePoolIndexBounds(sc.childType, sc.childGeometryIndex, hullCap, meshCap, hfCap, compCap, scaledCap, chainCap, sdfCap))
                return false;
            nextType = sc.childType;
            nextIdx = sc.childGeometryIndex;
        }
        if(nextType == ShapeType::Compound){
            if(sp >= 8u)
                return false;
            for(usize a = 0u; a <= sp; ++a){
                if(stackComp[a] == nextIdx)
                    return false;
            }
            ++sp;
            stackComp[sp] = nextIdx;
            stackChild[sp] = 0u;
        }
    }
    return true;
}

b8 ValidateRestoredPhysicsWorld(in PhysicsWorld tmp){
    if(!IsFinite(VectorDouble(tmp.m_worldOriginOffset)))
        return false;
    if(tmp.m_solverSets.size() < 3u)
        return false;
    if(tmp.m_solverSets[s_AwakeSetIndex].sims.size() != tmp.m_solverSets[s_AwakeSetIndex].states.size())
        return false;

    const usize bodyCap = tmp.m_bodies.size();
    const usize shapeCap = tmp.m_shapes.size();
    const usize contactCap = tmp.m_contacts.size();
    const usize jointCap = tmp.m_joints.size();
    const usize islandCap = tmp.m_islands.size();
    const usize setCap = tmp.m_solverSets.size();
    const usize extraCap = tmp.m_jointExtraData.size();
    const usize hullCap = tmp.m_hullShapes.size();
    const usize meshCap = tmp.m_meshShapes.size();
    const usize hfCap = tmp.m_heightfieldShapes.size();
    const usize compCap = tmp.m_compoundShapes.size();
    const usize scaledCap = tmp.m_scaledShapes.size();
    const usize chainCap = tmp.m_chainShapes.size();
    const usize sdfCap = tmp.m_sdfShapes.size();

    if(
        tmp.m_hullLocalAabbs.size() != hullCap
        || !ValidateShapePoolMeta(hullCap, tmp.m_hullRefCounts, tmp.m_hullGenerations, tmp.m_hullOwnedByUser, tmp.m_freeHullShapeIds)
        || !ValidateShapePoolMeta(meshCap, tmp.m_meshRefCounts, tmp.m_meshGenerations, tmp.m_meshOwnedByUser, tmp.m_freeMeshShapeIds)
        || !ValidateShapePoolMeta(hfCap, tmp.m_heightfieldRefCounts, tmp.m_heightfieldGenerations, tmp.m_heightfieldOwnedByUser, tmp.m_freeHeightfieldShapeIds)
        || !ValidateShapePoolMeta(compCap, tmp.m_compoundRefCounts, tmp.m_compoundGenerations, tmp.m_compoundOwnedByUser, tmp.m_freeCompoundShapeIds)
        || !ValidateShapePoolMeta(scaledCap, tmp.m_scaledRefCounts, tmp.m_scaledGenerations, tmp.m_scaledOwnedByUser, tmp.m_freeScaledShapeIds)
        || !ValidateShapePoolMeta(chainCap, tmp.m_chainRefCounts, tmp.m_chainGenerations, tmp.m_chainOwnedByUser, tmp.m_freeChainShapeIds)
        || !ValidateShapePoolMeta(sdfCap, tmp.m_sdfRefCounts, tmp.m_sdfGenerations, tmp.m_sdfOwnedByUser, tmp.m_freeSdfShapeIds)
    )
        return false;

    for(usize ci = 0u; ci < compCap; ++ci){
        in CompoundShape comp = tmp.m_compoundShapes[ci];
        for(usize k = 0u; k < comp.bvhChildOrder.size(); ++k){
            if(comp.bvhChildOrder[k] >= comp.children.size())
                return false;
        }
        if(tmp.m_compoundRefCounts[ci] > 0u || tmp.m_compoundOwnedByUser[ci] != 0u){
            if(!ValidateCompoundHierarchyAcyclic(tmp, cast<u32>(ci), hullCap, meshCap, hfCap, compCap, scaledCap, chainCap, sdfCap))
                return false;
        }
    }

    for(usize si = 0u; si < scaledCap; ++si){
        if(tmp.m_scaledRefCounts[si] == 0u && tmp.m_scaledOwnedByUser[si] == 0u)
            continue;
        in ScaledShape sc = tmp.m_scaledShapes[si];
        if(
            sc.childType == ShapeType::Scaled
            || !IsFinite(VectorSingle(sc.scale).xyz)
            || sc.scale.x <= 0.0f
            || sc.scale.y <= 0.0f
            || sc.scale.z <= 0.0f
            || !IsFinite(VectorSingle(sc.invScale).xyz)
        )
            return false;
        if(sc.childType == ShapeType::Hull && sc.childGeometryIndex >= hullCap)
            return false;
        if(sc.childType == ShapeType::Mesh && sc.childGeometryIndex >= meshCap)
            return false;
        if(sc.childType == ShapeType::Heightfield && sc.childGeometryIndex >= hfCap)
            return false;
        if(sc.childType == ShapeType::Compound && sc.childGeometryIndex >= compCap)
            return false;
        if(sc.childType == ShapeType::Chain && sc.childGeometryIndex >= chainCap)
            return false;
        if(sc.childType == ShapeType::Sdf && sc.childGeometryIndex >= sdfCap)
            return false;
    }

    for(usize ci = 0u; ci < chainCap; ++ci){
        in ChainShape ch = tmp.m_chainShapes[ci];
        usize segCount = 0u;
        if(ch.vertices.size() >= 2u){
            if(ch.isLoop)
                segCount = ch.vertices.size();
            else
                segCount = ch.vertices.size() - 1u;
        }
        for(usize k = 0u; k < ch.bvhSegmentOrder.size(); ++k){
            if(ch.bvhSegmentOrder[k] >= segCount)
                return false;
        }
        if(!ch.materials.empty()){
            for(usize k = 0u; k < ch.segmentMaterialIndices.size(); ++k){
                if(ch.segmentMaterialIndices[k] >= ch.materials.size())
                    return false;
            }
        }
    }

    for(usize si = 0u; si < sdfCap; ++si){
        in SdfShape sdf = tmp.m_sdfShapes[si];
        if(sdf.dimX > 0u || sdf.dimY > 0u || sdf.dimZ > 0u){
            if(sdf.dimX == 0u || sdf.dimY == 0u || sdf.dimZ == 0u)
                return false;
            const u64 expectedDistCount = cast<u64>(sdf.dimX) * cast<u64>(sdf.dimY) * cast<u64>(sdf.dimZ);
            if(expectedDistCount != cast<u64>(sdf.distances.size()))
                return false;
        }
    }

    for(usize si = 0u; si < setCap; ++si){
        in SolverSet ss = tmp.m_solverSets[si];
        for(usize li = 0u; li < ss.sims.size(); ++li){
            if(ss.sims[li].bodyId >= bodyCap)
                return false;
        }
        for(usize ii = 0u; ii < ss.islands.size(); ++ii){
            if(ss.islands[ii] >= islandCap)
                return false;
        }
        for(usize di = 0u; di < ss.dirtySplitIslands.size(); ++di){
            if(ss.dirtySplitIslands[di] >= islandCap)
                return false;
        }
    }

    for(usize bi = 0u; bi < bodyCap; ++bi){
        in Body b = tmp.m_bodies[bi];
        if(!b.alive)
            continue;
        if(b.id != cast<u32>(bi) || b.setIndex >= setCap)
            return false;
        in SolverSet bSet = tmp.m_solverSets[b.setIndex];
        if(b.localIndex >= bSet.sims.size() || bSet.sims[b.localIndex].bodyId != cast<u32>(bi))
            return false;
        if(b.setIndex == s_AwakeSetIndex && b.localIndex >= bSet.states.size())
            return false;
        if(b.headShapeId != s_NullIndex && b.headShapeId >= shapeCap)
            return false;
        if(b.islandId != s_NullIndex && (b.islandId >= islandCap || !tmp.m_islands[b.islandId].alive))
            return false;
    }

    for(usize si = 0u; si < shapeCap; ++si){
        in Shape s = tmp.m_shapes[si];
        if(!s.alive())
            continue;
        if(s.id != cast<u32>(si) || s.bodyId >= bodyCap || !tmp.m_bodies[s.bodyId].alive)
            return false;
        if(s.nextShapeId != s_NullIndex && s.nextShapeId >= shapeCap)
            return false;
        if(s.type == ShapeType::Hull && s.geometryIndex >= hullCap)
            return false;
        if(s.type == ShapeType::Mesh && s.geometryIndex >= meshCap)
            return false;
        if(s.type == ShapeType::Heightfield && s.geometryIndex >= hfCap)
            return false;
        if(s.type == ShapeType::Compound && s.geometryIndex >= compCap)
            return false;
        if(s.type == ShapeType::Scaled && s.geometryIndex >= scaledCap)
            return false;
        if(s.type == ShapeType::Chain && s.geometryIndex >= chainCap)
            return false;
        if(s.type == ShapeType::Sdf && s.geometryIndex >= sdfCap)
            return false;
    }

    const u32 cAliveBit = cast<u32>(ContactFlags::Alive);
    for(usize ci = 0u; ci < contactCap; ++ci){
        in Contact c = tmp.m_contacts[ci];
        if((c.flags & cAliveBit) == 0u)
            continue;
        if(c.contactId != cast<u32>(ci))
            return false;
        if(c.shapeIdA >= shapeCap || !tmp.m_shapes[c.shapeIdA].alive())
            return false;
        if(c.shapeIdB >= shapeCap || !tmp.m_shapes[c.shapeIdB].alive())
            return false;
        if(c.edges[0u].bodyId >= bodyCap || !tmp.m_bodies[c.edges[0u].bodyId].alive)
            return false;
        if(c.edges[1u].bodyId >= bodyCap || !tmp.m_bodies[c.edges[1u].bodyId].alive)
            return false;
        if(c.manifold.pointCount() > cast<u32>(s_MaxManifoldPoints))
            return false;
        if(c.colorIndex != s_NullIndex && c.colorIndex >= cast<u32>(s_GraphColorCount))
            return false;
        if(c.islandId != s_NullIndex && (c.islandId >= islandCap || !tmp.m_islands[c.islandId].alive))
            return false;
    }

    for(usize ji = 0u; ji < jointCap; ++ji){
        in Joint j = tmp.m_joints[ji];
        if(!j.alive())
            continue;
        if(j.jointId != cast<u32>(ji))
            return false;
        if(j.edges[0u].bodyId >= bodyCap || !tmp.m_bodies[j.edges[0u].bodyId].alive)
            return false;
        if(j.edges[1u].bodyId >= bodyCap || !tmp.m_bodies[j.edges[1u].bodyId].alive)
            return false;
        if(j.extraDataIndex != s_NullIndex && (j.extraDataIndex >= extraCap || !tmp.m_jointExtraData[j.extraDataIndex].alive))
            return false;
        if(j.islandId != s_NullIndex && (j.islandId >= islandCap || !tmp.m_islands[j.islandId].alive))
            return false;
    }

    for(usize col = 0u; col < s_GraphColorCount; ++col){
        in Vector<u32> cIds = tmp.m_graph.colors[col].contactIds;
        for(usize k = 0u; k < cIds.size(); ++k){
            const u32 cId = cIds[k];
            if(cId >= contactCap || (tmp.m_contacts[cId].flags & cAliveBit) == 0u)
                return false;
        }
    }

    for(usize i = 0u; i < tmp.m_dirtyMassBodyIds.size(); ++i){
        if(tmp.m_dirtyMassBodyIds[i] >= bodyCap)
            return false;
    }
    for(usize i = 0u; i < tmp.m_freeBodyIds.size(); ++i){
        if(tmp.m_freeBodyIds[i] >= bodyCap)
            return false;
    }
    for(usize i = 0u; i < tmp.m_freeShapeIds.size(); ++i){
        if(tmp.m_freeShapeIds[i] >= shapeCap)
            return false;
    }
    for(usize i = 0u; i < tmp.m_freeContactIds.size(); ++i){
        if(tmp.m_freeContactIds[i] >= contactCap)
            return false;
    }
    for(usize i = 0u; i < tmp.m_freeJointIds.size(); ++i){
        if(tmp.m_freeJointIds[i] >= jointCap)
            return false;
    }
    for(usize i = 0u; i < tmp.m_freeJointExtraData.size(); ++i){
        if(tmp.m_freeJointExtraData[i] >= extraCap)
            return false;
    }
    for(usize i = 0u; i < tmp.m_freeSolverSetIds.size(); ++i){
        if(tmp.m_freeSolverSetIds[i] >= setCap)
            return false;
    }
    for(usize i = 0u; i < tmp.m_freeIslandIds.size(); ++i){
        if(tmp.m_freeIslandIds[i] >= islandCap)
            return false;
    }
    for(in auto entry : tmp.m_extraContactManifolds){
        if(
            entry.first >= contactCap
            || (tmp.m_contacts[entry.first].flags & cAliveBit) == 0u
            || entry.second.empty()
            || entry.second.size() > cast<usize>(s_MaxExtraManifoldsPerContact)
        )
            return false;
        for(usize ei = 0u; ei < entry.second.size(); ++ei){
            if(entry.second[ei].manifold.pointCount() > cast<u32>(s_MaxManifoldPoints))
                return false;
        }
    }
    return true;
}

void CommitRestoredPhysicsWorld(mut PhysicsWorld tmp, mut PhysicsWorld world){
    world.m_meshRefitCaches.clear();
    world.m_def = tmp.m_def;
    world.m_backendMode = tmp.m_backendMode;
    world.m_gpuDispatchThreshold = tmp.m_gpuDispatchThreshold;
    world.m_gpuWorkloadFraction = tmp.m_gpuWorkloadFraction;
    world.m_enableWarmStarting = tmp.m_enableWarmStarting;
    world.m_hasDirtyBodyMass = tmp.m_hasDirtyBodyMass;
    world.m_cpuBroadphaseDirty = tmp.m_cpuBroadphaseDirty;
    world.m_sensorEventShapeCount = tmp.m_sensorEventShapeCount;
    world.m_hitEventShapeCount = tmp.m_hitEventShapeCount;
    world.m_breakableJointCount = tmp.m_breakableJointCount;
    world.m_bulletBodyCount = tmp.m_bulletBodyCount;
    world.m_worldOriginOffset = tmp.m_worldOriginOffset;

    world.m_bodies.swap(tmp.m_bodies);
    world.m_freeBodyIds.swap(tmp.m_freeBodyIds);
    world.m_shapes.swap(tmp.m_shapes);
    world.m_freeShapeIds.swap(tmp.m_freeShapeIds);
    world.m_hullShapes.swap(tmp.m_hullShapes);
    world.m_hullLocalAabbs.swap(tmp.m_hullLocalAabbs);
    world.m_hullRefCounts.swap(tmp.m_hullRefCounts);
    world.m_hullGenerations.swap(tmp.m_hullGenerations);
    world.m_hullOwnedByUser.swap(tmp.m_hullOwnedByUser);
    world.m_freeHullShapeIds.swap(tmp.m_freeHullShapeIds);
    world.m_meshShapes.swap(tmp.m_meshShapes);
    world.m_meshRefCounts.swap(tmp.m_meshRefCounts);
    world.m_meshGenerations.swap(tmp.m_meshGenerations);
    world.m_meshOwnedByUser.swap(tmp.m_meshOwnedByUser);
    world.m_freeMeshShapeIds.swap(tmp.m_freeMeshShapeIds);
    world.m_heightfieldShapes.swap(tmp.m_heightfieldShapes);
    world.m_heightfieldRefCounts.swap(tmp.m_heightfieldRefCounts);
    world.m_heightfieldGenerations.swap(tmp.m_heightfieldGenerations);
    world.m_heightfieldOwnedByUser.swap(tmp.m_heightfieldOwnedByUser);
    world.m_freeHeightfieldShapeIds.swap(tmp.m_freeHeightfieldShapeIds);
    world.m_compoundShapes.swap(tmp.m_compoundShapes);
    world.m_compoundRefCounts.swap(tmp.m_compoundRefCounts);
    world.m_compoundGenerations.swap(tmp.m_compoundGenerations);
    world.m_compoundOwnedByUser.swap(tmp.m_compoundOwnedByUser);
    world.m_freeCompoundShapeIds.swap(tmp.m_freeCompoundShapeIds);
    world.m_scaledShapes.swap(tmp.m_scaledShapes);
    world.m_scaledRefCounts.swap(tmp.m_scaledRefCounts);
    world.m_scaledGenerations.swap(tmp.m_scaledGenerations);
    world.m_scaledOwnedByUser.swap(tmp.m_scaledOwnedByUser);
    world.m_freeScaledShapeIds.swap(tmp.m_freeScaledShapeIds);
    world.m_chainShapes.swap(tmp.m_chainShapes);
    world.m_chainRefCounts.swap(tmp.m_chainRefCounts);
    world.m_chainGenerations.swap(tmp.m_chainGenerations);
    world.m_chainOwnedByUser.swap(tmp.m_chainOwnedByUser);
    world.m_freeChainShapeIds.swap(tmp.m_freeChainShapeIds);
    world.m_sdfShapes.swap(tmp.m_sdfShapes);
    world.m_sdfRefCounts.swap(tmp.m_sdfRefCounts);
    world.m_sdfGenerations.swap(tmp.m_sdfGenerations);
    world.m_sdfOwnedByUser.swap(tmp.m_sdfOwnedByUser);
    world.m_freeSdfShapeIds.swap(tmp.m_freeSdfShapeIds);
    world.m_contacts.swap(tmp.m_contacts);
    world.m_freeContactIds.swap(tmp.m_freeContactIds);
    world.m_joints.swap(tmp.m_joints);
    world.m_freeJointIds.swap(tmp.m_freeJointIds);
    world.m_jointExtraData.swap(tmp.m_jointExtraData);
    world.m_freeJointExtraData.swap(tmp.m_freeJointExtraData);
    world.m_solverSets.swap(tmp.m_solverSets);
    world.m_freeSolverSetIds.swap(tmp.m_freeSolverSetIds);
    world.m_islands.swap(tmp.m_islands);
    world.m_freeIslandIds.swap(tmp.m_freeIslandIds);
    world.m_dirtyMassBodyIds.swap(tmp.m_dirtyMassBodyIds);
    for(usize c = 0u; c < s_GraphColorCount; ++c)
        world.m_graph.colors[c].contactIds.swap(tmp.m_graph.colors[c].contactIds);
    world.m_graph.bodyColorMasks.swap(tmp.m_graph.bodyColorMasks);
    for(usize t = 0u; t < s_TreeCount; ++t)
        world.m_broadPhase.trees[t].swapState(tmp.m_broadPhase.trees[t]);
    world.m_broadPhase.moveArray.swap(tmp.m_broadPhase.moveArray);
    world.m_broadPhase.workerBuckets.clear();
    world.m_broadPhase.workerQueryStacks.clear();

    world.m_pairContactMap.clear();
    world.m_pairContactMap.reserve(world.m_contacts.size());
    for(usize i = 0u; i < world.m_contacts.size(); ++i){
        in Contact c = world.m_contacts[i];
        if((c.flags & cast<u32>(ContactFlags::Alive)) != 0u)
            world.m_pairContactMap.emplace(c.pairKey, c.contactId);
    }

    world.m_ignoredBodyPairs.clear();
    if(!tmp.m_ignoredBodyPairs.empty()){
        world.m_ignoredBodyPairs.reserve(tmp.m_ignoredBodyPairs.size());
        for(in u64 key : tmp.m_ignoredBodyPairs)
            world.m_ignoredBodyPairs.emplace(key);
    }

    world.m_extraContactManifolds.clear();
    if(!tmp.m_extraContactManifolds.empty()){
        world.m_extraContactManifolds.reserve(tmp.m_extraContactManifolds.size());
        const u32 hasExtraBit = cast<u32>(ContactFlags::HasExtraManifolds);
        for(in auto entry : tmp.m_extraContactManifolds){
            world.m_extraContactManifolds.emplace(entry.first, entry.second);
            if(cast<usize>(entry.first) < world.m_contacts.size())
                world.m_contacts[entry.first].flags |= hasExtraBit;
        }
    }
    world.recomputeDerivedCounts();

    world.m_bodyMoveEvents.clear();
    world.m_contactBeginEvents.clear();
    world.m_contactEndEvents.clear();
    world.m_contactPersistEvents.clear();
    world.m_contactHitEvents.clear();
    world.m_sensorBeginEvents.clear();
    world.m_sensorEndEvents.clear();
    world.m_sensorStayEvents.clear();
    world.m_bodyWakeEvents.clear();
    world.m_jointBreakEvents.clear();
    for(usize ji = 0u; ji < world.m_joints.size(); ++ji){
        if(!world.m_joints[ji].alive())
            continue;
        if(world.m_joints[ji].referenceJointA.valid())
            world.m_joints[ji].referenceJointA.worldIndex = world.m_worldIndex;
        if(world.m_joints[ji].referenceJointB.valid())
            world.m_joints[ji].referenceJointB.worldIndex = world.m_worldIndex;
    }
    world.m_pendingContactEndEvents.swap(tmp.m_pendingContactEndEvents);
    for(usize i = 0u; i < world.m_pendingContactEndEvents.size(); ++i){
        world.m_pendingContactEndEvents[i].shapeIdA.worldIndex = world.m_worldIndex;
        world.m_pendingContactEndEvents[i].shapeIdB.worldIndex = world.m_worldIndex;
    }
    world.m_pendingSensorEndEvents.swap(tmp.m_pendingSensorEndEvents);
    for(usize i = 0u; i < world.m_pendingSensorEndEvents.size(); ++i){
        world.m_pendingSensorEndEvents[i].sensorShapeId.worldIndex = world.m_worldIndex;
        world.m_pendingSensorEndEvents[i].visitorShapeId.worldIndex = world.m_worldIndex;
    }
    world.m_pendingBodyWakeEvents.swap(tmp.m_pendingBodyWakeEvents);
    for(usize i = 0u; i < world.m_pendingBodyWakeEvents.size(); ++i)
        world.m_pendingBodyWakeEvents[i].bodyId.worldIndex = world.m_worldIndex;
    world.m_lastStats = WorldStepStats();
    world.m_cpuScratch.clear();

    if(cast<usize>(s_AwakeSetIndex) < world.m_solverSets.size()){
        mut Vector<u32> dirtyList = world.m_solverSets[s_AwakeSetIndex].dirtySplitIslands;
        dirtyList.clear();
        for(usize i = 0u; i < world.m_islands.size(); ++i){
            in Island isl = world.m_islands[i];
            if(isl.alive && isl.setIndex == s_AwakeSetIndex && isl.constraintRemoveCount > 0u)
                dirtyList.push_back(isl.islandId);
        }
    }

    world.m_worldGeneration = AllocateWrappingIdentity<PhysicsWorld>();
    world.markAllSetsTopologyDirty();
    ++world.m_hullPoolVersion;
    ++world.m_meshPoolVersion;
    ++world.m_heightfieldPoolVersion;
    ++world.m_compoundPoolVersion;
    ++world.m_scaledPoolVersion;
    ++world.m_chainPoolVersion;
    ++world.m_sdfPoolVersion;
    ++world.m_poseMutationVersion;
    ++world.m_stepPoseVersion;
    ++world.m_jointTopologyVersion;
    ++world.m_nonCollideJointVersion;
    world.m_inStep = false;
}

b8 VerifySnapshotChecksumAndInitReader(
    in Span<u8> bytes,
    in usize minBytes,
    mut SnapshotByteReader outReader,
    mut usize outPayloadEnd
){
    if(bytes.size() < minBytes)
        return false;
    outPayloadEnd = bytes.size() - 8u;
    const u64 computedHash = SnapshotFnv1a64(Span<u8>(bytes.data(), outPayloadEnd));
    SnapshotByteReader hashReader;
    hashReader.cursor = outPayloadEnd;
    hashReader.limit = bytes.size();
    u64 storedHash = 0u;
    if(!hashReader.readU64(bytes, storedHash) || storedHash != computedHash)
        return false;
    outReader.cursor = 0u;
    outReader.limit = outPayloadEnd;
    return true;
}

b8 VerifyWorldSnapshotChecksumAndProvenance(
    in Span<u8> bytes,
    mut SnapshotByteReader outReader,
    mut usize outPayloadEnd,
    mut u64 outPayloadHash,
    mut SnapshotWorldProvenance outProv
){
    if(bytes.size() < 144u)
        return false;
    const usize provOffset = bytes.size() - 128u;
    const usize totalHashedEnd = bytes.size() - 8u;
    const u64 payloadHash = SnapshotFnv1a64(Span<u8>(bytes.data(), provOffset));
    u64 fullHash = payloadHash;
    for(usize i = provOffset; i < totalHashedEnd; ++i){
        fullHash ^= cast<u64>(bytes[i]);
        fullHash *= s_Fnv64Prime;
    }
    SnapshotByteReader provReader;
    provReader.cursor = provOffset;
    provReader.limit = bytes.size();
    if(
        !provReader.readU64(bytes, outProv.worldGeneration)
        || !provReader.readU64(bytes, outProv.hullPoolVersion)
        || !provReader.readU64(bytes, outProv.meshPoolVersion)
        || !provReader.readU64(bytes, outProv.heightfieldPoolVersion)
        || !provReader.readU64(bytes, outProv.compoundPoolVersion)
        || !provReader.readU64(bytes, outProv.scaledPoolVersion)
        || !provReader.readU64(bytes, outProv.chainPoolVersion)
        || !provReader.readU64(bytes, outProv.sdfPoolVersion)
        || !provReader.readU64(bytes, outProv.hullPoolBytes)
        || !provReader.readU64(bytes, outProv.meshPoolBytes)
        || !provReader.readU64(bytes, outProv.heightfieldPoolBytes)
        || !provReader.readU64(bytes, outProv.compoundPoolBytes)
        || !provReader.readU64(bytes, outProv.scaledPoolBytes)
        || !provReader.readU64(bytes, outProv.chainPoolBytes)
        || !provReader.readU64(bytes, outProv.sdfPoolBytes)
    )
        return false;
    u64 storedHash = 0u;
    if(!provReader.readU64(bytes, storedHash) || storedHash != fullHash)
        return false;
    outPayloadEnd = provOffset;
    outPayloadHash = payloadHash;
    outReader.cursor = 0u;
    outReader.limit = provOffset;
    return true;
}

b8 RestorePhysicsWorldSnapshot(in Span<u8> bytes, mut PhysicsWorld world){
    if(world.m_inStep)
        return false;
    SnapshotByteReader r;
    usize payloadEnd = 0u;
    u64 unusedPayloadHash = 0u;
    SnapshotWorldProvenance unusedProv;
    if(!VerifyWorldSnapshotChecksumAndProvenance(bytes, r, payloadEnd, unusedPayloadHash, unusedProv))
        return false;
    PhysicsWorld tmp;
    if(!ReadPhysicsWorldSnapshotPayload(bytes, r, tmp))
        return false;
    if(r.cursor != payloadEnd)
        return false;
    CommitRestoredPhysicsWorld(tmp, world);
    return true;
}

u64 ComputePhysicsWorldStateHash(in PhysicsWorld world){
    SnapshotFnv1a64Sink hashSink;
    if(!SerializePhysicsWorldSnapshotPayload(world, hashSink))
        return 0u;
    return hashSink.hash;
}

class DeltaSnapshotScratch{
    public Vector<u8> curBuf;
    public Vector<u32> dirtyIndices;
    public Vector<u8> elemBlobs;
    public Vector<u32> elemStarts;
    public Vector<u32> elemLens;
}

b8 SnapF32BitsEqual(in f32 a, in f32 b){
    return bit_cast<u32>(a) == bit_cast<u32>(b);
}

b8 SnapF64BitsEqual(in f64 a, in f64 b){
    return bit_cast<u64>(a) == bit_cast<u64>(b);
}

b8 SnapJointIdsEqual(in JointId a, in JointId b){
    return a.index == b.index && a.generation == b.generation && a.valid() == b.valid();
}

b8 SnapVec2BitsEqual(in f32 ax, in f32 ay, in f32 bx, in f32 by){
    return SnapF32BitsEqual(ax, bx) && SnapF32BitsEqual(ay, by);
}

b8 SnapVec4BitsEqual(in VectorSingle a, in VectorSingle b){
    return
        SnapF32BitsEqual(a.x, b.x)
        && SnapF32BitsEqual(a.y, b.y)
        && SnapF32BitsEqual(a.z, b.z)
        && SnapF32BitsEqual(a.w, b.w)
    ;
}

b8 SnapVec3U32BitsEqual(in f32 ax, in f32 ay, in f32 az, in u32 aw, in f32 bx, in f32 by, in f32 bz, in u32 bw){
    return
        SnapF32BitsEqual(ax, bx)
        && SnapF32BitsEqual(ay, by)
        && SnapF32BitsEqual(az, bz)
        && aw == bw
    ;
}

b8 SnapU32x4Equal(in u32 ax, in u32 ay, in u32 az, in u32 aw, in u32 bx, in u32 by, in u32 bz, in u32 bw){
    return ax == bx && ay == by && az == bz && aw == bw;
}

b8 SnapTransform3DBitsEqual(in Transform3D a, in Transform3D b){
    return SnapVec4BitsEqual(VectorSingle(a.position), VectorSingle(b.position)) && SnapVec4BitsEqual(VectorSingle(a.rotation), VectorSingle(b.rotation));
}

b8 SnapAabb3DBitsEqual(in Aabb3D a, in Aabb3D b){
    return SnapVec4BitsEqual(VectorSingle(a.lowerBound), VectorSingle(b.lowerBound)) && SnapVec4BitsEqual(VectorSingle(a.upperBound), VectorSingle(b.upperBound));
}

b8 SnapSymMat3BitsEqual(in SymMat3 a, in SymMat3 b){
    return
        SnapF32BitsEqual(a.m00, b.m00)
        && SnapF32BitsEqual(a.m01, b.m01)
        && SnapF32BitsEqual(a.m02, b.m02)
        && SnapF32BitsEqual(a.m11, b.m11)
        && SnapF32BitsEqual(a.m12, b.m12)
        && SnapF32BitsEqual(a.m22, b.m22)
    ;
}

b8 SnapFilterEqual(in Filter a, in Filter b){
    return a.categoryBits == b.categoryBits && a.maskBits == b.maskBits && a.groupIndex == b.groupIndex && a.broadPhaseLayer == b.broadPhaseLayer;
}

b8 SnapSurfaceMaterialBitsEqual(in SurfaceMaterial a, in SurfaceMaterial b){
    return
        SnapVec4BitsEqual(VectorSingle(a.surfaceVelocity), VectorSingle(b.surfaceVelocity))
        && SnapVec4BitsEqual(VectorSingle(a.anisotropicFriction), VectorSingle(b.anisotropicFriction))
        && SnapVec4BitsEqual(VectorSingle(a.frictionDirection), VectorSingle(b.frictionDirection))
        && SnapF32BitsEqual(a.friction, b.friction)
        && SnapF32BitsEqual(a.staticFriction, b.staticFriction)
        && SnapF32BitsEqual(a.restitution, b.restitution)
        && SnapF32BitsEqual(a.rollingResistance, b.rollingResistance)
        && SnapF32BitsEqual(a.tangentSpeed, b.tangentSpeed)
        && a.frictionCombineMode == b.frictionCombineMode
        && a.restitutionCombineMode == b.restitutionCombineMode
    ;
}

b8 SnapManifoldBitsEqual(in Manifold a, in Manifold b){
    for(usize pi = 0u; pi < s_MaxManifoldPoints; ++pi){
        if(
            !SnapVec4BitsEqual(VectorSingle(a.points[pi].pointSeparation), VectorSingle(b.points[pi].pointSeparation))
            || !SnapVec4BitsEqual(VectorSingle(a.points[pi].anchorANormalImpulse), VectorSingle(b.points[pi].anchorANormalImpulse))
            || !SnapVec4BitsEqual(VectorSingle(a.points[pi].anchorBTotalImpulse), VectorSingle(b.points[pi].anchorBTotalImpulse))
            || !SnapVec2BitsEqual(a.pointFrictionImpulses[pi].x, a.pointFrictionImpulses[pi].y, b.pointFrictionImpulses[pi].x, b.pointFrictionImpulses[pi].y)
            || !SnapF32BitsEqual(a.postSolveTangentImpulses[pi], b.postSolveTangentImpulses[pi])
        )
            return false;
    }
    return
        SnapVec4BitsEqual(VectorSingle(a.normalTwist), VectorSingle(b.normalTwist))
        && SnapVec3U32BitsEqual(a.rollingImpulseMeta.x, a.rollingImpulseMeta.y, a.rollingImpulseMeta.z, a.rollingImpulseMeta.w, b.rollingImpulseMeta.x, b.rollingImpulseMeta.y, b.rollingImpulseMeta.z, b.rollingImpulseMeta.w)
        && SnapU32x4Equal(a.pointIds.x, a.pointIds.y, a.pointIds.z, a.pointIds.w, b.pointIds.x, b.pointIds.y, b.pointIds.z, b.pointIds.w)
        && SnapVec2BitsEqual(a.frictionImpulse.x, a.frictionImpulse.y, b.frictionImpulse.x, b.frictionImpulse.y)
        && a.materialTriangleA == b.materialTriangleA
        && a.materialTriangleB == b.materialTriangleB
        && a.materialSubShapeA == b.materialSubShapeA
        && a.materialSubShapeB == b.materialSubShapeB
    ;
}

b8 SnapBodiesEqual(in Body a, in Body b){
    return
        a.userData == b.userData
        && a.setIndex == b.setIndex
        && a.localIndex == b.localIndex
        && a.headContactKey == b.headContactKey
        && a.contactCount == b.contactCount
        && a.headJointKey == b.headJointKey
        && a.jointCount == b.jointCount
        && a.headShapeId == b.headShapeId
        && a.shapeCount == b.shapeCount
        && a.islandId == b.islandId
        && a.islandIndex == b.islandIndex
        && SnapF32BitsEqual(a.sleepThreshold, b.sleepThreshold)
        && SnapF32BitsEqual(a.sleepTime, b.sleepTime)
        && SnapF32BitsEqual(a.mass, b.mass)
        && SnapSymMat3BitsEqual(a.inertiaLocal, b.inertiaLocal)
        && SnapF32BitsEqual(a.maxAngularVelocity, b.maxAngularVelocity)
        && a.bodyMoveIndex == b.bodyMoveIndex
        && a.id == b.id
        && a.flags == b.flags
        && a.type == b.type
        && a.generation == b.generation
        && a.alive == b.alive
    ;
}

b8 SnapShapesEqual(in Shape a, in Shape b){
    return
        SnapVec4BitsEqual(VectorSingle(a.geom0), VectorSingle(b.geom0))
        && SnapVec4BitsEqual(VectorSingle(a.geom1), VectorSingle(b.geom1))
        && SnapAabb3DBitsEqual(a.aabb, b.aabb)
        && SnapTransform3DBitsEqual(a.localTransform, b.localTransform)
        && a.userData == b.userData
        && SnapSurfaceMaterialBitsEqual(a.material, b.material)
        && SnapFilterEqual(a.filter, b.filter)
        && a.bodyId == b.bodyId
        && a.id == b.id
        && a.nextShapeId == b.nextShapeId
        && a.proxyKey == b.proxyKey
        && a.geometryIndex == b.geometryIndex
        && SnapF32BitsEqual(a.density, b.density)
        && a.generation == b.generation
        && a.type == b.type
        && a.flags == b.flags
    ;
}

b8 SnapContactsEqual(in Contact a, in Contact b){
    return
        a.pairKey == b.pairKey
        && a.edges[0u].bodyId == b.edges[0u].bodyId
        && a.edges[0u].prevKey == b.edges[0u].prevKey
        && a.edges[0u].nextKey == b.edges[0u].nextKey
        && a.edges[1u].bodyId == b.edges[1u].bodyId
        && a.edges[1u].prevKey == b.edges[1u].prevKey
        && a.edges[1u].nextKey == b.edges[1u].nextKey
        && SnapVec4BitsEqual(VectorSingle(a.surfaceVelocity), VectorSingle(b.surfaceVelocity))
        && SnapVec4BitsEqual(VectorSingle(a.anisotropicFriction), VectorSingle(b.anisotropicFriction))
        && SnapVec4BitsEqual(VectorSingle(a.frictionDirection), VectorSingle(b.frictionDirection))
        && a.contactId == b.contactId
        && a.shapeIdA == b.shapeIdA
        && a.shapeIdB == b.shapeIdB
        && a.colorIndex == b.colorIndex
        && a.localIndex == b.localIndex
        && a.islandId == b.islandId
        && a.islandIndex == b.islandIndex
        && SnapF32BitsEqual(a.friction, b.friction)
        && SnapF32BitsEqual(a.staticFriction, b.staticFriction)
        && SnapF32BitsEqual(a.restitution, b.restitution)
        && SnapF32BitsEqual(a.rollingResistance, b.rollingResistance)
        && SnapF32BitsEqual(a.tangentSpeed, b.tangentSpeed)
        && SnapF32BitsEqual(a.invMassScaleA, b.invMassScaleA)
        && SnapF32BitsEqual(a.invMassScaleB, b.invMassScaleB)
        && SnapF32BitsEqual(a.invInertiaScaleA, b.invInertiaScaleA)
        && SnapF32BitsEqual(a.invInertiaScaleB, b.invInertiaScaleB)
        && SnapF32BitsEqual(a.maxNormalImpulse, b.maxNormalImpulse)
        && a.flags == b.flags
        && SnapManifoldBitsEqual(a.manifold, b.manifold)
    ;
}

b8 SnapJointsEqual(in Joint a, in Joint b){
    return
        SnapVec4BitsEqual(VectorSingle(a.localAnchorALength), VectorSingle(b.localAnchorALength))
        && SnapVec4BitsEqual(VectorSingle(a.localAnchorBMinLength), VectorSingle(b.localAnchorBMinLength))
        && SnapVec4BitsEqual(VectorSingle(a.localAxisAMaxLength), VectorSingle(b.localAxisAMaxLength))
        && SnapVec4BitsEqual(VectorSingle(a.localAxisBLowerLimit), VectorSingle(b.localAxisBLowerLimit))
        && SnapVec4BitsEqual(VectorSingle(a.referenceRotation), VectorSingle(b.referenceRotation))
        && SnapVec4BitsEqual(VectorSingle(a.linearOffsetUpperLimit), VectorSingle(b.linearOffsetUpperLimit))
        && SnapVec4BitsEqual(VectorSingle(a.linearImpulseLimit), VectorSingle(b.linearImpulseLimit))
        && SnapVec4BitsEqual(VectorSingle(a.angularImpulseMotor), VectorSingle(b.angularImpulseMotor))
        && SnapVec4BitsEqual(VectorSingle(a.lastForceConeSusp), VectorSingle(b.lastForceConeSusp))
        && SnapVec4BitsEqual(VectorSingle(a.lastTorqueMotorSpeed), VectorSingle(b.lastTorqueMotorSpeed))
        && a.userData == b.userData
        && a.edges[0u].bodyId == b.edges[0u].bodyId
        && a.edges[0u].prevKey == b.edges[0u].prevKey
        && a.edges[0u].nextKey == b.edges[0u].nextKey
        && a.edges[1u].bodyId == b.edges[1u].bodyId
        && a.edges[1u].prevKey == b.edges[1u].prevKey
        && a.edges[1u].nextKey == b.edges[1u].nextKey
        && a.jointId == b.jointId
        && a.islandId == b.islandId
        && a.islandIndex == b.islandIndex
        && a.extraDataIndex == b.extraDataIndex
        && SnapF32BitsEqual(a.maxMotorForce, b.maxMotorForce)
        && SnapF32BitsEqual(a.hertz, b.hertz)
        && SnapF32BitsEqual(a.dampingRatio, b.dampingRatio)
        && SnapF32BitsEqual(a.correctionFactor, b.correctionFactor)
        && SnapF32BitsEqual(a.maxTorque, b.maxTorque)
        && SnapF32BitsEqual(a.swingLimit, b.swingLimit)
        && SnapF32BitsEqual(a.swingLimitY, b.swingLimitY)
        && SnapF32BitsEqual(a.springTarget, b.springTarget)
        && SnapF32BitsEqual(a.suspensionHertz, b.suspensionHertz)
        && SnapF32BitsEqual(a.suspensionDampingRatio, b.suspensionDampingRatio)
        && SnapF32BitsEqual(a.steeringAngle, b.steeringAngle)
        && SnapF32BitsEqual(a.suspensionRestLength, b.suspensionRestLength)
        && SnapF32BitsEqual(a.invMassScaleA, b.invMassScaleA)
        && SnapF32BitsEqual(a.invMassScaleB, b.invMassScaleB)
        && SnapF32BitsEqual(a.invInertiaScaleA, b.invInertiaScaleA)
        && SnapF32BitsEqual(a.invInertiaScaleB, b.invInertiaScaleB)
        && SnapF32BitsEqual(a.limitRestitution, b.limitRestitution)
        && SnapF32BitsEqual(a.limitHertz, b.limitHertz)
        && SnapF32BitsEqual(a.limitDampingRatio, b.limitDampingRatio)
        && SnapF32BitsEqual(a.projectionLinearTolerance, b.projectionLinearTolerance)
        && SnapF32BitsEqual(a.projectionAngularTolerance, b.projectionAngularTolerance)
        && SnapF32BitsEqual(a.ratio, b.ratio)
        && SnapF32BitsEqual(a.breakForce, b.breakForce)
        && SnapF32BitsEqual(a.breakTorque, b.breakTorque)
        && SnapJointIdsEqual(a.referenceJointA, b.referenceJointA)
        && SnapJointIdsEqual(a.referenceJointB, b.referenceJointB)
        && SnapF32BitsEqual(a.continuousAngle, b.continuousAngle)
        && SnapF32BitsEqual(a.accumulatedPhaseError, b.accumulatedPhaseError)
        && a.hasContinuousAngle == b.hasContinuousAngle
        && a.generation == b.generation
        && a.type == b.type
        && a.flags == b.flags
    ;
}

b8 SnapJointExtraDataEqual(in JointExtraData a, in JointExtraData b){
    for(usize k = 0u; k < 6u; ++k){
        in SixDofAxisConfig ca = a.sixDofAxes[k];
        in SixDofAxisConfig cb = b.sixDofAxes[k];
        if(
            ca.motion != cb.motion
            || !SnapF32BitsEqual(ca.lowerLimit, cb.lowerLimit)
            || !SnapF32BitsEqual(ca.upperLimit, cb.upperLimit)
            || !SnapF32BitsEqual(ca.motorTargetVelocity, cb.motorTargetVelocity)
            || !SnapF32BitsEqual(ca.motorTargetPosition, cb.motorTargetPosition)
            || !SnapF32BitsEqual(ca.maxMotorForce, cb.maxMotorForce)
            || !SnapF32BitsEqual(ca.springHertz, cb.springHertz)
            || !SnapF32BitsEqual(ca.springDampingRatio, cb.springDampingRatio)
            || ca.enableMotor != cb.enableMotor
            || ca.enableSpring != cb.enableSpring
            || !SnapF32BitsEqual(a.sixDofLowerImpulses[k], b.sixDofLowerImpulses[k])
            || !SnapF32BitsEqual(a.sixDofUpperImpulses[k], b.sixDofUpperImpulses[k])
            || !SnapF32BitsEqual(a.sixDofMotorImpulses[k], b.sixDofMotorImpulses[k])
            || !SnapF32BitsEqual(a.sixDofSpringImpulses[k], b.sixDofSpringImpulses[k])
        )
            return false;
    }
    if(
        !SnapVec4BitsEqual(VectorSingle(a.groundAnchorA), VectorSingle(b.groundAnchorA))
        || !SnapVec4BitsEqual(VectorSingle(a.groundAnchorB), VectorSingle(b.groundAnchorB))
        || !SnapF32BitsEqual(a.pulleyConstant, b.pulleyConstant)
        || a.pathPoints.size() != b.pathPoints.size()
    )
        return false;
    for(usize k = 0u; k < a.pathPoints.size(); ++k){
        if(!SnapVec4BitsEqual(VectorSingle(a.pathPoints[k]), VectorSingle(b.pathPoints[k])))
            return false;
    }
    return
        a.pathClosed == b.pathClosed
        && a.pathLockRotation == b.pathLockRotation
        && a.alive == b.alive
        && SnapVec4BitsEqual(VectorSingle(a.targetOrientation), VectorSingle(b.targetOrientation))
        && SnapVec4BitsEqual(VectorSingle(a.slerpImpulse), VectorSingle(b.slerpImpulse))
        && SnapF32BitsEqual(a.slerpHertz, b.slerpHertz)
        && SnapF32BitsEqual(a.slerpDampingRatio, b.slerpDampingRatio)
        && SnapF32BitsEqual(a.slerpMaxTorque, b.slerpMaxTorque)
        && SnapF32BitsEqual(a.sixDofSwingLimitY, b.sixDofSwingLimitY)
        && SnapF32BitsEqual(a.sixDofSwingLimitZ, b.sixDofSwingLimitZ)
        && SnapF32BitsEqual(a.sixDofSwingImpulse, b.sixDofSwingImpulse)
        && a.sixDofSwingLimitMode == b.sixDofSwingLimitMode
        && a.enableSlerpDrive == b.enableSlerpDrive
    ;
}

b8 SnapBodySimsEqual(in BodySim a, in BodySim b){
    return
        SnapTransform3DBitsEqual(a.transform, b.transform)
        && SnapVec4BitsEqual(VectorSingle(a.centerInvMass), VectorSingle(b.centerInvMass))
        && SnapVec4BitsEqual(VectorSingle(a.localCenterMinExtent), VectorSingle(b.localCenterMinExtent))
        && SnapVec4BitsEqual(VectorSingle(a.rotation0), VectorSingle(b.rotation0))
        && SnapVec4BitsEqual(VectorSingle(a.center0MaxExtent), VectorSingle(b.center0MaxExtent))
        && SnapVec4BitsEqual(VectorSingle(a.forceLinearDamping), VectorSingle(b.forceLinearDamping))
        && SnapVec4BitsEqual(VectorSingle(a.torqueAngularDamping), VectorSingle(b.torqueAngularDamping))
        && SnapSymMat3BitsEqual(a.invInertiaLocal, b.invInertiaLocal)
        && SnapSymMat3BitsEqual(a.invInertiaWorld, b.invInertiaWorld)
        && SnapF32BitsEqual(a.gravityScale, b.gravityScale)
        && a.flags == b.flags
        && a.bodyId == b.bodyId
        && SnapF32BitsEqual(a.maxAngularVelocity, b.maxAngularVelocity)
        && SnapF64BitsEqual(a.positionDouble.x, b.positionDouble.x)
        && SnapF64BitsEqual(a.positionDouble.y, b.positionDouble.y)
        && SnapF64BitsEqual(a.positionDouble.z, b.positionDouble.z)
        && SnapF64BitsEqual(a.positionDouble.w, b.positionDouble.w)
    ;
}

b8 SnapBodyStatesEqual(in BodyState a, in BodyState b){
    return
        SnapVec4BitsEqual(VectorSingle(a.linearVelocity), VectorSingle(b.linearVelocity))
        && SnapVec4BitsEqual(VectorSingle(a.angularVelocity), VectorSingle(b.angularVelocity))
        && SnapVec3U32BitsEqual(a.deltaPositionFlags.x, a.deltaPositionFlags.y, a.deltaPositionFlags.z, a.deltaPositionFlags.w, b.deltaPositionFlags.x, b.deltaPositionFlags.y, b.deltaPositionFlags.z, b.deltaPositionFlags.w)
        && SnapVec4BitsEqual(VectorSingle(a.deltaRotation), VectorSingle(b.deltaRotation))
    ;
}

b8 SnapIslandsEqual(in Island a, in Island b){
    if(
        a.setIndex != b.setIndex
        || a.localIndex != b.localIndex
        || a.islandId != b.islandId
        || a.constraintRemoveCount != b.constraintRemoveCount
        || a.alive != b.alive
        || a.bodies.size() != b.bodies.size()
        || a.contacts.size() != b.contacts.size()
        || a.joints.size() != b.joints.size()
    )
        return false;
    for(usize k = 0u; k < a.bodies.size(); ++k){
        if(a.bodies[k] != b.bodies[k])
            return false;
    }
    for(usize k = 0u; k < a.contacts.size(); ++k){
        if(
            a.contacts[k].contactId != b.contacts[k].contactId
            || a.contacts[k].bodyIdA != b.contacts[k].bodyIdA
            || a.contacts[k].bodyIdB != b.contacts[k].bodyIdB
        )
            return false;
    }
    for(usize k = 0u; k < a.joints.size(); ++k){
        if(
            a.joints[k].jointId != b.joints[k].jointId
            || a.joints[k].bodyIdA != b.joints[k].bodyIdA
            || a.joints[k].bodyIdB != b.joints[k].bodyIdB
        )
            return false;
    }
    return true;
}

b8 SnapEmitU32VecDelta(in Vector<u32> baseV, in Vector<u32> curV, mut SnapshotDirectByteWriter w){
    b8 equal = (baseV.size() == curV.size());
    if(equal){
        for(usize i = 0u; i < baseV.size(); ++i){
            if(baseV[i] != curV[i]){
                equal = false;
                break;
            }
        }
    }
    if(equal){
        w.writeU8(0u);
        return true;
    }
    w.writeU8(1u);
    return SnapshotWriteU32Vec(w, curV);
}

b8 SnapApplyU32VecDelta(in Span<u8> bytes, mut SnapshotByteReader r, mut Vector<u32> outV){
    u8 changed = 0u;
    if(!r.readU8(bytes, changed))
        return false;
    if(changed == 0u)
        return true;
    return SnapshotReadU32Vec(bytes, r, outV);
}

b8 SnapTreeNodesEqual(in TreeNode a, in TreeNode b){
    return
        SnapVec3U32BitsEqual(a.aabbMinUser.x, a.aabbMinUser.y, a.aabbMinUser.z, a.aabbMinUser.w, b.aabbMinUser.x, b.aabbMinUser.y, b.aabbMinUser.z, b.aabbMinUser.w)
        && SnapVec3U32BitsEqual(a.aabbMaxLayer.x, a.aabbMaxLayer.y, a.aabbMaxLayer.z, a.aabbMaxLayer.w, b.aabbMaxLayer.x, b.aabbMaxLayer.y, b.aabbMaxLayer.z, b.aabbMaxLayer.w)
        && a.categoryBits == b.categoryBits
        && a.parentOrNext == b.parentOrNext
        && a.child1 == b.child1
        && a.child2 == b.child2
        && a.height == b.height
        && a.moved == b.moved
        && a.nodeFlags == b.nodeFlags
    ;
}

b8 SnapEmitWorldBlobDeltaFromSlice<WriteFn>(
    in Span<u8> baseSnapshotBytes,
    in usize baseStart,
    in usize baseEnd,
    in b8 skipCompareEqual,
    in PhysicsWorld curWorld,
    in WriteFn writeSection,
    mut DeltaSnapshotScratch sc,
    mut SnapshotDirectByteWriter w
){
    if(skipCompareEqual){
        w.writeU8(0u);
        return true;
    }
    sc.curBuf.clear();
    {
        SnapshotRawByteWriter cw(sc.curBuf);
        if(!writeSection(curWorld, cw))
            return false;
    }
    const usize baseLen = baseEnd - baseStart;
    b8 same = (sc.curBuf.size() == baseLen);
    if(same){
        for(usize i = 0u; i < baseLen; ++i){
            if(baseSnapshotBytes[baseStart + i] != sc.curBuf[i]){
                same = false;
                break;
            }
        }
    }
    if(same){
        w.writeU8(0u);
        return true;
    }
    w.writeU8(1u);
    w.writeBytes(Span<u8>(sc.curBuf));
    return true;
}

b8 SnapWriteSparseArrayDelta<TElem, EqualFn, WriteFn>(
    in Vector<TElem> baseV,
    in Vector<TElem> curV,
    in EqualFn equalElem,
    in WriteFn writeElem,
    mut DeltaSnapshotScratch sc,
    mut SnapshotDirectByteWriter w
){
    if(baseV.size() == curV.size()){
        sc.dirtyIndices.clear();
        for(usize i = 0u; i < curV.size(); ++i){
            if(!equalElem(baseV[i], curV[i]))
                sc.dirtyIndices.push_back(cast<u32>(i));
        }
        if(sc.dirtyIndices.empty()){
            w.writeU8(0u);
            return true;
        }
        if(sc.dirtyIndices.size() * 2u < curV.size()){
            w.writeU8(1u);
            if(!w.writeCount(sc.dirtyIndices.size()))
                return false;
            for(usize k = 0u; k < sc.dirtyIndices.size(); ++k){
                const u32 idx = sc.dirtyIndices[k];
                w.writeU32(idx);
                if(!writeElem(curV[idx], w))
                    return false;
            }
            return true;
        }
    }
    w.writeU8(2u);
    if(!w.writeCount(curV.size()))
        return false;
    for(usize i = 0u; i < curV.size(); ++i){
        if(!writeElem(curV[i], w))
            return false;
    }
    return true;
}

b8 SnapReadSparseArrayDelta<TElem, ReadFn>(
    in Span<u8> bytes,
    mut SnapshotByteReader r,
    in usize minBytesPerItem,
    in ReadFn readElem,
    mut Vector<TElem> ioV
){
    u8 mode = 0u;
    if(!r.readU8(bytes, mode))
        return false;
    if(mode == 0u)
        return true;
    if(mode == 1u){
        u32 cnt = 0u;
        if(!r.readCount(bytes, minBytesPerItem + 4u, cnt))
            return false;
        for(u32 k = 0u; k < cnt; ++k){
            u32 idx = 0u;
            if(!r.readU32(bytes, idx) || cast<usize>(idx) >= ioV.size() || !readElem(bytes, r, ioV[idx]))
                return false;
        }
        return true;
    }
    if(mode != 2u)
        return false;
    u32 total = 0u;
    if(!r.readCount(bytes, minBytesPerItem, total))
        return false;
    ioV.resize(total);
    for(u32 i = 0u; i < total; ++i){
        if(!readElem(bytes, r, ioV[i]))
            return false;
    }
    return true;
}

b8 SnapWriteSolverSetsDelta(in Vector<SolverSet> baseV, in Vector<SolverSet> curV, mut DeltaSnapshotScratch sc, mut SnapshotDirectByteWriter w){
    const auto equalSim = lambda[](in BodySim a, in BodySim b) -> b8{
        return SnapBodySimsEqual(a, b);
    };
    const auto writeSim = lambda[](in BodySim s, mut SnapshotDirectByteWriter sw) -> b8{
        SnapWriteBodySim(s, sw);
        return true;
    };
    const auto equalState = lambda[](in BodyState a, in BodyState b) -> b8{
        return SnapBodyStatesEqual(a, b);
    };
    const auto writeState = lambda[](in BodyState s, mut SnapshotDirectByteWriter sw) -> b8{
        SnapWriteBodyState(s, sw);
        return true;
    };
    if(baseV.size() == curV.size()){
        w.writeU8(1u);
        for(usize si = 0u; si < curV.size(); ++si){
            in SolverSet bSet = baseV[si];
            in SolverSet cSet = curV[si];
            b8 hdrSame =
                bSet.setIndex == cSet.setIndex
                && bSet.membershipVersion == cSet.membershipVersion
                && bSet.islands.size() == cSet.islands.size()
            ;
            if(hdrSame){
                for(usize k = 0u; k < cSet.islands.size(); ++k){
                    if(bSet.islands[k] != cSet.islands[k]){
                        hdrSame = false;
                        break;
                    }
                }
            }
            if(hdrSame){
                w.writeU8(0u);
            }
            else{
                w.writeU8(1u);
                w.writeU32(cSet.setIndex);
                w.writeU64(cSet.membershipVersion);
                if(!SnapshotWriteU32Vec(w, cSet.islands))
                    return false;
            }
            if(
                !SnapWriteSparseArrayDelta(bSet.sims, cSet.sims, equalSim, writeSim, sc, w)
                || !SnapWriteSparseArrayDelta(bSet.states, cSet.states, equalState, writeState, sc, w)
            )
                return false;
        }
        return true;
    }
    w.writeU8(2u);
    if(!w.writeCount(curV.size()))
        return false;
    for(usize si = 0u; si < curV.size(); ++si){
        if(!SnapWriteSolverSet(curV[si], w))
            return false;
    }
    return true;
}

b8 SnapReadSolverSetsDelta(in Span<u8> bytes, mut SnapshotByteReader r, mut Vector<SolverSet> ioV){
    const auto readSim = lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut BodySim s) -> b8{
        return SnapReadBodySim(b, sr, s);
    };
    const auto readState = lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut BodyState s) -> b8{
        return SnapReadBodyState(b, sr, s);
    };
    u8 mode = 0u;
    if(!r.readU8(bytes, mode))
        return false;
    if(mode == 1u){
        for(usize si = 0u; si < ioV.size(); ++si){
            mut SolverSet ss = ioV[si];
            u8 hdrChanged = 0u;
            if(!r.readU8(bytes, hdrChanged))
                return false;
            if(hdrChanged != 0u){
                if(!r.readU32(bytes, ss.setIndex) || !r.readU64(bytes, ss.membershipVersion) || !SnapshotReadU32Vec(bytes, r, ss.islands))
                    return false;
            }
            if(
                !SnapReadSparseArrayDelta(bytes, r, 64u, readSim, ss.sims)
                || !SnapReadSparseArrayDelta(bytes, r, 48u, readState, ss.states)
            )
                return false;
        }
        return true;
    }
    if(mode != 2u)
        return false;
    u32 total = 0u;
    if(!r.readCount(bytes, 12u, total) || total < 3u)
        return false;
    ioV.resize(total);
    for(u32 si = 0u; si < total; ++si){
        if(!SnapReadSolverSet(bytes, r, ioV[si]))
            return false;
    }
    return true;
}

b8 SnapWriteDynamicTreeDelta(in DynamicTree baseTree, in DynamicTree curTree, mut DeltaSnapshotScratch sc, mut SnapshotDirectByteWriter w){
    in Vector<TreeNode> bNodes = baseTree.nodes();
    in Vector<TreeNode> cNodes = curTree.nodes();
    in Vector<u32> bMoves = baseTree.moveIndices();
    in Vector<u32> cMoves = curTree.moveIndices();
    const b8 metaSame =
        baseTree.root() == curTree.root()
        && baseTree.freeList() == curTree.freeList()
        && baseTree.nodeCount() == curTree.nodeCount()
    ;
    if(bNodes.size() == cNodes.size() && bMoves.size() == cMoves.size() && bMoves.size() == cNodes.size()){
        sc.dirtyIndices.clear();
        for(usize k = 0u; k < cNodes.size(); ++k){
            if(!SnapTreeNodesEqual(bNodes[k], cNodes[k]))
                sc.dirtyIndices.push_back(cast<u32>(k));
        }
        b8 movesSame = true;
        for(usize k = 0u; k < cMoves.size(); ++k){
            if(bMoves[k] != cMoves[k]){
                movesSame = false;
                break;
            }
        }
        if(metaSame && sc.dirtyIndices.empty() && movesSame){
            w.writeU8(0u);
            return true;
        }
        if(sc.dirtyIndices.size() * 2u < cNodes.size()){
            w.writeU8(1u);
            w.writeU32(curTree.root());
            w.writeU32(curTree.freeList());
            w.writeU32(curTree.nodeCount());
            if(!w.writeCount(sc.dirtyIndices.size()))
                return false;
            for(usize k = 0u; k < sc.dirtyIndices.size(); ++k){
                const u32 idx = sc.dirtyIndices[k];
                w.writeU32(idx);
                SnapWriteTreeNode(cNodes[idx], w);
            }
            if(movesSame){
                w.writeU8(0u);
                return true;
            }
            w.writeU8(1u);
            sc.dirtyIndices.clear();
            for(usize k = 0u; k < cMoves.size(); ++k){
                if(bMoves[k] != cMoves[k])
                    sc.dirtyIndices.push_back(cast<u32>(k));
            }
            if(!w.writeCount(sc.dirtyIndices.size()))
                return false;
            for(usize k = 0u; k < sc.dirtyIndices.size(); ++k){
                const u32 idx = sc.dirtyIndices[k];
                w.writeU32(idx);
                w.writeU32(cMoves[idx]);
            }
            return true;
        }
    }
    w.writeU8(2u);
    return SnapWriteDynamicTree(curTree, w);
}

b8 SnapReadDynamicTreeDelta(in Span<u8> bytes, mut SnapshotByteReader r, mut DynamicTree dstTree){
    u8 mode = 0u;
    if(!r.readU8(bytes, mode))
        return false;
    if(mode == 0u)
        return true;
    if(mode == 1u){
        u32 tRoot = s_NullIndex;
        u32 tFreeList = s_NullIndex;
        u32 tNodeCount = 0u;
        if(!r.readU32(bytes, tRoot) || !r.readU32(bytes, tFreeList) || !r.readU32(bytes, tNodeCount))
            return false;
        const usize nCount = dstTree.nodes().size();
        if(tRoot != s_NullIndex && cast<usize>(tRoot) >= nCount)
            return false;
        if(tFreeList != s_NullIndex && cast<usize>(tFreeList) >= nCount)
            return false;
        dstTree.beginRestore(nCount, nCount, tRoot, tFreeList, tNodeCount);
        u32 nodePatches = 0u;
        if(!r.readCount(bytes, 48u, nodePatches))
            return false;
        for(u32 k = 0u; k < nodePatches; ++k){
            u32 idx = 0u;
            TreeNode n;
            if(!r.readU32(bytes, idx) || cast<usize>(idx) >= nCount || !SnapReadTreeNode(bytes, r, n))
                return false;
            dstTree.setRestoredNode(cast<usize>(idx), n);
        }
        u8 mvChanged = 0u;
        if(!r.readU8(bytes, mvChanged))
            return false;
        if(mvChanged != 0u){
            u32 mvPatches = 0u;
            if(!r.readCount(bytes, 8u, mvPatches))
                return false;
            for(u32 k = 0u; k < mvPatches; ++k){
                u32 idx = 0u;
                u32 mv = 0u;
                if(!r.readU32(bytes, idx) || cast<usize>(idx) >= nCount || !r.readU32(bytes, mv))
                    return false;
                dstTree.setRestoredMoveIndex(cast<usize>(idx), mv);
            }
        }
        return true;
    }
    if(mode != 2u)
        return false;
    return SnapReadDynamicTree(bytes, r, dstTree);
}

void ClonePhysicsWorldNonGeometryStateForDelta(in PhysicsWorld src, mut PhysicsWorld dst){
    dst.m_def = src.m_def;
    dst.m_worldIndex = src.m_worldIndex;
    dst.m_backendMode = src.m_backendMode;
    dst.m_gpuDispatchThreshold = src.m_gpuDispatchThreshold;
    dst.m_gpuWorkloadFraction = src.m_gpuWorkloadFraction;
    dst.m_enableWarmStarting = src.m_enableWarmStarting;
    dst.m_hasDirtyBodyMass = src.m_hasDirtyBodyMass;
    dst.m_cpuBroadphaseDirty = src.m_cpuBroadphaseDirty;
    dst.m_sensorEventShapeCount = src.m_sensorEventShapeCount;
    dst.m_hitEventShapeCount = src.m_hitEventShapeCount;
    dst.m_breakableJointCount = src.m_breakableJointCount;
    dst.m_bulletBodyCount = src.m_bulletBodyCount;
    dst.m_nonDefaultBroadPhaseLayerMaskCount = src.m_nonDefaultBroadPhaseLayerMaskCount;
    dst.m_gpuUnsupportedFilterShapeCount = src.m_gpuUnsupportedFilterShapeCount;
    dst.m_referenceJointCount = src.m_referenceJointCount;
    dst.m_gpuUnsupportedGeomRefTotal = src.m_gpuUnsupportedGeomRefTotal;
    dst.m_activeShapeCount = src.m_activeShapeCount;
    dst.m_shapelessDynamicBodyCount = src.m_shapelessDynamicBodyCount;
    dst.m_ignoredBodyPairCounts = src.m_ignoredBodyPairCounts;
    dst.m_worldOriginOffset = src.m_worldOriginOffset;

    dst.m_bodies = src.m_bodies;
    dst.m_freeBodyIds = src.m_freeBodyIds;
    dst.m_dirtyMassBodyIds = src.m_dirtyMassBodyIds;
    dst.m_shapes = src.m_shapes;
    dst.m_freeShapeIds = src.m_freeShapeIds;
    dst.m_contacts = src.m_contacts;
    dst.m_freeContactIds = src.m_freeContactIds;
    dst.m_joints = src.m_joints;
    dst.m_freeJointIds = src.m_freeJointIds;
    dst.m_jointExtraData = src.m_jointExtraData;
    dst.m_freeJointExtraData = src.m_freeJointExtraData;
    dst.m_solverSets = src.m_solverSets;
    dst.m_freeSolverSetIds = src.m_freeSolverSetIds;
    dst.m_islands = src.m_islands;
    dst.m_freeIslandIds = src.m_freeIslandIds;
    for(usize c = 0u; c < s_GraphColorCount; ++c)
        dst.m_graph.colors[c].contactIds = src.m_graph.colors[c].contactIds;
    dst.m_graph.bodyColorMasks = src.m_graph.bodyColorMasks;
    for(usize t = 0u; t < s_TreeCount; ++t)
        dst.m_broadPhase.trees[t] = src.m_broadPhase.trees[t];
    dst.m_broadPhase.moveArray = src.m_broadPhase.moveArray;
    dst.m_pendingContactEndEvents = src.m_pendingContactEndEvents;
    dst.m_pendingSensorEndEvents = src.m_pendingSensorEndEvents;
    dst.m_pendingBodyWakeEvents = src.m_pendingBodyWakeEvents;

    dst.m_ignoredBodyPairs.clear();
    if(!src.m_ignoredBodyPairs.empty()){
        dst.m_ignoredBodyPairs.reserve(src.m_ignoredBodyPairs.size());
        for(in u64 key : src.m_ignoredBodyPairs)
            dst.m_ignoredBodyPairs.emplace(key);
    }
    dst.m_extraContactManifolds.clear();
    if(!src.m_extraContactManifolds.empty()){
        dst.m_extraContactManifolds.reserve(src.m_extraContactManifolds.size());
        for(in auto entry : src.m_extraContactManifolds)
            dst.m_extraContactManifolds.emplace(entry.first, entry.second);
    }
}

void SwapPhysicsWorldGeometryPoolByBit(mut PhysicsWorld a, mut PhysicsWorld b, in u32 poolBit){
    if(poolBit == 1u){
        a.m_hullShapes.swap(b.m_hullShapes);
        a.m_hullLocalAabbs.swap(b.m_hullLocalAabbs);
        a.m_hullRefCounts.swap(b.m_hullRefCounts);
        a.m_hullGenerations.swap(b.m_hullGenerations);
        a.m_hullOwnedByUser.swap(b.m_hullOwnedByUser);
        a.m_freeHullShapeIds.swap(b.m_freeHullShapeIds);
    }
    else if(poolBit == 2u){
        a.m_meshShapes.swap(b.m_meshShapes);
        a.m_meshRefCounts.swap(b.m_meshRefCounts);
        a.m_meshGenerations.swap(b.m_meshGenerations);
        a.m_meshOwnedByUser.swap(b.m_meshOwnedByUser);
        a.m_freeMeshShapeIds.swap(b.m_freeMeshShapeIds);
    }
    else if(poolBit == 4u){
        a.m_heightfieldShapes.swap(b.m_heightfieldShapes);
        a.m_heightfieldRefCounts.swap(b.m_heightfieldRefCounts);
        a.m_heightfieldGenerations.swap(b.m_heightfieldGenerations);
        a.m_heightfieldOwnedByUser.swap(b.m_heightfieldOwnedByUser);
        a.m_freeHeightfieldShapeIds.swap(b.m_freeHeightfieldShapeIds);
    }
    else if(poolBit == 8u){
        a.m_compoundShapes.swap(b.m_compoundShapes);
        a.m_compoundRefCounts.swap(b.m_compoundRefCounts);
        a.m_compoundGenerations.swap(b.m_compoundGenerations);
        a.m_compoundOwnedByUser.swap(b.m_compoundOwnedByUser);
        a.m_freeCompoundShapeIds.swap(b.m_freeCompoundShapeIds);
    }
    else if(poolBit == 16u){
        a.m_scaledShapes.swap(b.m_scaledShapes);
        a.m_scaledRefCounts.swap(b.m_scaledRefCounts);
        a.m_scaledGenerations.swap(b.m_scaledGenerations);
        a.m_scaledOwnedByUser.swap(b.m_scaledOwnedByUser);
        a.m_freeScaledShapeIds.swap(b.m_freeScaledShapeIds);
    }
    else if(poolBit == 32u){
        a.m_chainShapes.swap(b.m_chainShapes);
        a.m_chainRefCounts.swap(b.m_chainRefCounts);
        a.m_chainGenerations.swap(b.m_chainGenerations);
        a.m_chainOwnedByUser.swap(b.m_chainOwnedByUser);
        a.m_freeChainShapeIds.swap(b.m_freeChainShapeIds);
    }
    else if(poolBit == 64u){
        a.m_sdfShapes.swap(b.m_sdfShapes);
        a.m_sdfRefCounts.swap(b.m_sdfRefCounts);
        a.m_sdfGenerations.swap(b.m_sdfGenerations);
        a.m_sdfOwnedByUser.swap(b.m_sdfOwnedByUser);
        a.m_freeSdfShapeIds.swap(b.m_freeSdfShapeIds);
    }
}

void SwapAllPhysicsWorldGeometryPools(mut PhysicsWorld a, mut PhysicsWorld b){
    for(u32 bit = 1u; bit <= 64u; bit *= 2u)
        SwapPhysicsWorldGeometryPoolByBit(a, b, bit);
}

void RestoreUnchangedPhysicsWorldGeometryPools(mut PhysicsWorld tmp, mut PhysicsWorld world, in u32 restoredPoolMask){
    for(u32 bit = 1u; bit <= 64u; bit *= 2u){
        if((restoredPoolMask & bit) == 0u)
            SwapPhysicsWorldGeometryPoolByBit(tmp, world, bit);
    }
}

b8 WritePhysicsWorldDeltaBody(
    in Span<u8> baseSnapshotBytes,
    in SnapshotWorldSectionSpans baseSpans,
    in SnapshotWorldProvenance baseProv,
    in PhysicsWorld baseWorld,
    in PhysicsWorld world,
    mut DeltaSnapshotScratch sc,
    mut SnapshotDirectByteWriter w
){
    const b8 sameWorldGen = (baseProv.worldGeneration == world.m_worldGeneration);
    const auto equalBodyFn = lambda[](in Body a, in Body b) -> b8{ return SnapBodiesEqual(a, b); };
    const auto writeBodyFn = lambda[](in Body b, mut SnapshotDirectByteWriter sw) -> b8{ SnapWriteBody(b, sw); return true; };
    const auto equalShapeFn = lambda[](in Shape a, in Shape b) -> b8{ return SnapShapesEqual(a, b); };
    const auto writeShapeFn = lambda[](in Shape s, mut SnapshotDirectByteWriter sw) -> b8{ SnapWriteShape(s, sw); return true; };
    const auto equalContactFn = lambda[](in Contact a, in Contact b) -> b8{ return SnapContactsEqual(a, b); };
    const auto writeContactFn = lambda[](in Contact c, mut SnapshotDirectByteWriter sw) -> b8{ SnapWriteContact(c, sw); return true; };
    const auto equalJointFn = lambda[](in Joint a, in Joint b) -> b8{ return SnapJointsEqual(a, b); };
    const auto writeJointFn = lambda[](in Joint j, mut SnapshotDirectByteWriter sw) -> b8{ SnapWriteJoint(j, sw); return true; };
    const auto equalJointExtraFn = lambda[](in JointExtraData a, in JointExtraData b) -> b8{ return SnapJointExtraDataEqual(a, b); };
    const auto writeJointExtraFn = lambda[](in JointExtraData e, mut SnapshotDirectByteWriter sw) -> b8{ return SnapWriteJointExtraData(e, sw); };
    const auto equalIslandFn = lambda[](in Island a, in Island b) -> b8{ return SnapIslandsEqual(a, b); };
    const auto writeIslandFn = lambda[](in Island isl, mut SnapshotDirectByteWriter sw) -> b8{ return SnapWriteIsland(isl, sw); };

    if(
        !SnapEmitWorldBlobDeltaFromSlice(baseSnapshotBytes, baseSpans.globalsStart, baseSpans.globalsEnd, false, world, lambda[](in PhysicsWorld pw, mut SnapshotRawByteWriter sw) -> b8{ SnapWriteWorldGlobals(pw, sw); return true; }, sc, w)
        || !SnapWriteSparseArrayDelta(baseWorld.m_bodies, world.m_bodies, equalBodyFn, writeBodyFn, sc, w)
        || !SnapEmitU32VecDelta(baseWorld.m_freeBodyIds, world.m_freeBodyIds, w)
        || !SnapWriteSparseArrayDelta(baseWorld.m_shapes, world.m_shapes, equalShapeFn, writeShapeFn, sc, w)
        || !SnapEmitU32VecDelta(baseWorld.m_freeShapeIds, world.m_freeShapeIds, w)
        || !SnapEmitWorldBlobDeltaFromSlice(baseSnapshotBytes, baseSpans.hullPoolStart, baseSpans.hullPoolEnd, sameWorldGen && baseProv.hullPoolVersion == world.m_hullPoolVersion, world, lambda[](in PhysicsWorld pw, mut SnapshotRawByteWriter sw) -> b8{ return SnapWriteHullPool(pw, sw); }, sc, w)
        || !SnapEmitWorldBlobDeltaFromSlice(baseSnapshotBytes, baseSpans.meshPoolStart, baseSpans.meshPoolEnd, sameWorldGen && baseProv.meshPoolVersion == world.m_meshPoolVersion, world, lambda[](in PhysicsWorld pw, mut SnapshotRawByteWriter sw) -> b8{ return SnapWriteMeshPool(pw, sw); }, sc, w)
        || !SnapEmitWorldBlobDeltaFromSlice(baseSnapshotBytes, baseSpans.heightfieldPoolStart, baseSpans.heightfieldPoolEnd, sameWorldGen && baseProv.heightfieldPoolVersion == world.m_heightfieldPoolVersion, world, lambda[](in PhysicsWorld pw, mut SnapshotRawByteWriter sw) -> b8{ return SnapWriteHeightfieldPool(pw, sw); }, sc, w)
        || !SnapEmitWorldBlobDeltaFromSlice(baseSnapshotBytes, baseSpans.compoundPoolStart, baseSpans.compoundPoolEnd, sameWorldGen && baseProv.compoundPoolVersion == world.m_compoundPoolVersion, world, lambda[](in PhysicsWorld pw, mut SnapshotRawByteWriter sw) -> b8{ return SnapWriteCompoundPool(pw, sw); }, sc, w)
        || !SnapEmitWorldBlobDeltaFromSlice(baseSnapshotBytes, baseSpans.scaledPoolStart, baseSpans.scaledPoolEnd, sameWorldGen && baseProv.scaledPoolVersion == world.m_scaledPoolVersion, world, lambda[](in PhysicsWorld pw, mut SnapshotRawByteWriter sw) -> b8{ return SnapWriteScaledPool(pw, sw); }, sc, w)
        || !SnapEmitWorldBlobDeltaFromSlice(baseSnapshotBytes, baseSpans.chainPoolStart, baseSpans.chainPoolEnd, sameWorldGen && baseProv.chainPoolVersion == world.m_chainPoolVersion, world, lambda[](in PhysicsWorld pw, mut SnapshotRawByteWriter sw) -> b8{ return SnapWriteChainPool(pw, sw); }, sc, w)
        || !SnapEmitWorldBlobDeltaFromSlice(baseSnapshotBytes, baseSpans.sdfPoolStart, baseSpans.sdfPoolEnd, sameWorldGen && baseProv.sdfPoolVersion == world.m_sdfPoolVersion, world, lambda[](in PhysicsWorld pw, mut SnapshotRawByteWriter sw) -> b8{ return SnapWriteSdfPool(pw, sw); }, sc, w)
        || !SnapWriteSparseArrayDelta(baseWorld.m_contacts, world.m_contacts, equalContactFn, writeContactFn, sc, w)
        || !SnapEmitU32VecDelta(baseWorld.m_freeContactIds, world.m_freeContactIds, w)
        || !SnapWriteSparseArrayDelta(baseWorld.m_joints, world.m_joints, equalJointFn, writeJointFn, sc, w)
        || !SnapEmitU32VecDelta(baseWorld.m_freeJointIds, world.m_freeJointIds, w)
        || !SnapWriteSparseArrayDelta(baseWorld.m_jointExtraData, world.m_jointExtraData, equalJointExtraFn, writeJointExtraFn, sc, w)
        || !SnapEmitU32VecDelta(baseWorld.m_freeJointExtraData, world.m_freeJointExtraData, w)
        || !SnapWriteSolverSetsDelta(baseWorld.m_solverSets, world.m_solverSets, sc, w)
        || !SnapEmitU32VecDelta(baseWorld.m_freeSolverSetIds, world.m_freeSolverSetIds, w)
        || !SnapWriteSparseArrayDelta(baseWorld.m_islands, world.m_islands, equalIslandFn, writeIslandFn, sc, w)
        || !SnapEmitU32VecDelta(baseWorld.m_freeIslandIds, world.m_freeIslandIds, w)
        || !SnapEmitWorldBlobDeltaFromSlice(baseSnapshotBytes, baseSpans.graphStart, baseSpans.graphEnd, false, world, lambda[](in PhysicsWorld pw, mut SnapshotRawByteWriter sw) -> b8{ return SnapWriteGraph(pw, sw); }, sc, w)
    )
        return false;

    for(usize t = 0u; t < s_TreeCount; ++t){
        if(!SnapWriteDynamicTreeDelta(baseWorld.m_broadPhase.trees[t], world.m_broadPhase.trees[t], sc, w))
            return false;
    }
    if(
        !SnapEmitU32VecDelta(baseWorld.m_broadPhase.moveArray, world.m_broadPhase.moveArray, w)
        || !SnapEmitWorldBlobDeltaFromSlice(baseSnapshotBytes, baseSpans.pendingEventsStart, baseSpans.pendingEventsEnd, false, world, lambda[](in PhysicsWorld pw, mut SnapshotRawByteWriter sw) -> b8{ return SnapWritePendingEvents(pw, sw); }, sc, w)
        || !SnapEmitWorldBlobDeltaFromSlice(baseSnapshotBytes, baseSpans.ignoredPairsStart, baseSpans.ignoredPairsEnd, false, world, lambda[](in PhysicsWorld pw, mut SnapshotRawByteWriter sw) -> b8{ return SnapWriteIgnoredPairs(pw, sw); }, sc, w)
        || !SnapEmitWorldBlobDeltaFromSlice(baseSnapshotBytes, baseSpans.extraManifoldsStart, baseSpans.extraManifoldsEnd, false, world, lambda[](in PhysicsWorld pw, mut SnapshotRawByteWriter sw) -> b8{ return SnapWriteExtraManifolds(pw, sw); }, sc, w)
    )
        return false;
    return true;
}

b8 CreatePhysicsWorldDeltaSnapshot(in PhysicsWorld world, in Span<u8> baseSnapshotBytes, mut Vector<u8> outDeltaBytes){
    outDeltaBytes.clear();
    if(world.m_inStep)
        return false;

    SnapshotByteReader baseR;
    usize basePayloadEnd = 0u;
    u64 baseHash = 0u;
    SnapshotWorldProvenance baseProv;
    if(!VerifyWorldSnapshotChecksumAndProvenance(baseSnapshotBytes, baseR, basePayloadEnd, baseHash, baseProv))
        return false;
    PhysicsWorld baseWorld;
    SnapshotWorldSectionSpans baseSpans;
    const u32 skipPoolMask = ComputeMatchingPoolSkipMask(baseProv, world);
    if(!ReadPhysicsWorldSnapshotPayloadWithSpansFiltered(baseSnapshotBytes, skipPoolMask, baseProv, baseR, baseWorld, baseSpans) || baseR.cursor != basePayloadEnd)
        return false;

    const u64 targetHash = ComputePhysicsWorldStateHash(world);
    if(baseHash == 0u || targetHash == 0u)
        return false;

    DeltaSnapshotScratch sc;
    outDeltaBytes.reserve(1024u);
    SnapshotDirectByteWriter w(outDeltaBytes);
    w.writeU32(s_DeltaSnapshotMagic);
    w.writeU32(s_DeltaSnapshotVersion);
    w.writeU64(baseHash);
    w.writeU64(targetHash);

    if(!WritePhysicsWorldDeltaBody(baseSnapshotBytes, baseSpans, baseProv, baseWorld, world, sc, w))
        return false;

    w.writeU64(w.m_hash);
    return true;
}

b8 ReadDeltaSnapshotHeaderWithMagic(
    in Span<u8> bytes,
    in u32 expectedMagic,
    in u32 expectedVersion,
    mut SnapshotByteReader r,
    mut u64 outBaseHash,
    mut u64 outTargetHash
){
    u32 magic = 0u;
    u32 version = 0u;
    if(!r.readU32(bytes, magic) || !r.readU32(bytes, version) || !r.readU64(bytes, outBaseHash) || !r.readU64(bytes, outTargetHash))
        return false;
    return magic == expectedMagic && version == expectedVersion;
}

b8 ReadDeltaSnapshotHeader(
    in Span<u8> bytes,
    mut SnapshotByteReader r,
    mut u64 outBaseHash,
    mut u64 outTargetHash
){
    return ReadDeltaSnapshotHeaderWithMagic(bytes, s_DeltaSnapshotMagic, s_DeltaSnapshotVersion, r, outBaseHash, outTargetHash);
}

b8 SnapApplyWorldBlobDelta<ReadFn>(in Span<u8> bytes, mut SnapshotByteReader r, in ReadFn readSection, mut PhysicsWorld tmp){
    u8 changed = 0u;
    if(!r.readU8(bytes, changed))
        return false;
    if(changed == 0u)
        return true;
    return readSection(bytes, r, tmp);
}

b8 SnapApplyWorldPoolDelta<ReadFn>(
    in Span<u8> bytes,
    in u32 poolBit,
    in b8 preserveGeometry,
    mut SnapshotByteReader r,
    in ReadFn readSection,
    mut PhysicsWorld backupWorld,
    mut u32 restoredPoolMask,
    mut PhysicsWorld tmp
){
    u8 changed = 0u;
    if(!r.readU8(bytes, changed))
        return false;
    if(changed == 0u)
        return true;
    if(preserveGeometry){
        SwapPhysicsWorldGeometryPoolByBit(tmp, backupWorld, poolBit);
        restoredPoolMask |= poolBit;
    }
    return readSection(bytes, r, tmp);
}

b8 ApplyPhysicsWorldDeltaBody(
    in Span<u8> deltaBytes,
    in b8 preserveGeometry,
    mut SnapshotByteReader r,
    mut PhysicsWorld backupWorld,
    mut u32 restoredPoolMask,
    mut PhysicsWorld tmp
){
    const auto readBodyFn = lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut Body e) -> b8{ return SnapReadBody(b, sr, e); };
    const auto readShapeFn = lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut Shape e) -> b8{ return SnapReadShape(b, sr, e); };
    const auto readContactFn = lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut Contact e) -> b8{ return SnapReadContact(b, sr, e); };
    const auto readJointFn = lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut Joint e) -> b8{ return SnapReadJoint(b, sr, e); };
    const auto readJointExtraFn = lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut JointExtraData e) -> b8{ return SnapReadJointExtraData(b, sr, e); };
    const auto readIslandFn = lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut Island e) -> b8{ return SnapReadIsland(b, sr, e); };

    if(
        !SnapApplyWorldBlobDelta(deltaBytes, r, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut PhysicsWorld pw) -> b8{ return SnapReadWorldGlobals(b, sr, pw); }, tmp)
        || !SnapReadSparseArrayDelta(deltaBytes, r, 32u, readBodyFn, tmp.m_bodies)
        || !SnapApplyU32VecDelta(deltaBytes, r, tmp.m_freeBodyIds)
        || !SnapReadSparseArrayDelta(deltaBytes, r, 64u, readShapeFn, tmp.m_shapes)
        || !SnapApplyU32VecDelta(deltaBytes, r, tmp.m_freeShapeIds)
    )
        return false;
    RebuildDirtyMassBodyIds(tmp);

    if(
        !SnapApplyWorldPoolDelta(deltaBytes, 1u, preserveGeometry, r, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut PhysicsWorld pw) -> b8{ return SnapReadHullPool(b, sr, pw); }, backupWorld, restoredPoolMask, tmp)
        || !SnapApplyWorldPoolDelta(deltaBytes, 2u, preserveGeometry, r, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut PhysicsWorld pw) -> b8{ return SnapReadMeshPool(b, sr, pw); }, backupWorld, restoredPoolMask, tmp)
        || !SnapApplyWorldPoolDelta(deltaBytes, 4u, preserveGeometry, r, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut PhysicsWorld pw) -> b8{ return SnapReadHeightfieldPool(b, sr, pw); }, backupWorld, restoredPoolMask, tmp)
        || !SnapApplyWorldPoolDelta(deltaBytes, 8u, preserveGeometry, r, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut PhysicsWorld pw) -> b8{ return SnapReadCompoundPool(b, sr, pw); }, backupWorld, restoredPoolMask, tmp)
        || !SnapApplyWorldPoolDelta(deltaBytes, 16u, preserveGeometry, r, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut PhysicsWorld pw) -> b8{ return SnapReadScaledPool(b, sr, pw); }, backupWorld, restoredPoolMask, tmp)
        || !SnapApplyWorldPoolDelta(deltaBytes, 32u, preserveGeometry, r, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut PhysicsWorld pw) -> b8{ return SnapReadChainPool(b, sr, pw); }, backupWorld, restoredPoolMask, tmp)
        || !SnapApplyWorldPoolDelta(deltaBytes, 64u, preserveGeometry, r, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut PhysicsWorld pw) -> b8{ return SnapReadSdfPool(b, sr, pw); }, backupWorld, restoredPoolMask, tmp)
        || !SnapReadSparseArrayDelta(deltaBytes, r, 64u, readContactFn, tmp.m_contacts)
        || !SnapApplyU32VecDelta(deltaBytes, r, tmp.m_freeContactIds)
        || !SnapReadSparseArrayDelta(deltaBytes, r, 64u, readJointFn, tmp.m_joints)
        || !SnapApplyU32VecDelta(deltaBytes, r, tmp.m_freeJointIds)
        || !SnapReadSparseArrayDelta(deltaBytes, r, 32u, readJointExtraFn, tmp.m_jointExtraData)
        || !SnapApplyU32VecDelta(deltaBytes, r, tmp.m_freeJointExtraData)
        || !SnapReadSolverSetsDelta(deltaBytes, r, tmp.m_solverSets)
        || !SnapApplyU32VecDelta(deltaBytes, r, tmp.m_freeSolverSetIds)
        || !SnapReadSparseArrayDelta(deltaBytes, r, 16u, readIslandFn, tmp.m_islands)
        || !SnapApplyU32VecDelta(deltaBytes, r, tmp.m_freeIslandIds)
        || !SnapApplyWorldBlobDelta(deltaBytes, r, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut PhysicsWorld pw) -> b8{ return SnapReadGraph(b, sr, pw); }, tmp)
    )
        return false;

    for(usize t = 0u; t < s_TreeCount; ++t){
        if(!SnapReadDynamicTreeDelta(deltaBytes, r, tmp.m_broadPhase.trees[t]))
            return false;
    }
    const usize contactCount = tmp.m_contacts.size();
    if(
        !SnapApplyU32VecDelta(deltaBytes, r, tmp.m_broadPhase.moveArray)
        || !SnapApplyWorldBlobDelta(deltaBytes, r, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut PhysicsWorld pw) -> b8{ return SnapReadPendingEvents(b, sr, pw); }, tmp)
        || !SnapApplyWorldBlobDelta(deltaBytes, r, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut PhysicsWorld pw) -> b8{ return SnapReadIgnoredPairs(b, sr, pw); }, tmp)
        || !SnapApplyWorldBlobDelta(deltaBytes, r, lambda[in contactCount](in Span<u8> b, mut SnapshotByteReader sr, mut PhysicsWorld pw) -> b8{ return SnapReadExtraManifolds(b, sr, contactCount, pw); }, tmp)
    )
        return false;

    return true;
}

b8 ApplyPhysicsWorldDeltaPayload(
    in Span<u8> deltaBytes,
    in usize payloadEnd,
    in u64 baseHash,
    in u64 targetHash,
    in b8 verifyBaseHash,
    in b8 preserveGeometry,
    mut SnapshotByteReader r,
    mut PhysicsWorld backupWorld,
    mut PhysicsWorld tmp
){
    if(verifyBaseHash && ComputePhysicsWorldStateHash(tmp) != baseHash){
        if(preserveGeometry)
            RestoreUnchangedPhysicsWorldGeometryPools(tmp, backupWorld, 0u);
        return false;
    }
    u32 restoredPoolMask = 0u;
    if(
        !ApplyPhysicsWorldDeltaBody(deltaBytes, preserveGeometry, r, backupWorld, restoredPoolMask, tmp)
        || r.cursor != payloadEnd
        || !ValidateRestoredPhysicsWorld(tmp)
        || ComputePhysicsWorldStateHash(tmp) != targetHash
    ){
        if(preserveGeometry)
            RestoreUnchangedPhysicsWorldGeometryPools(tmp, backupWorld, restoredPoolMask);
        return false;
    }
    return true;
}

b8 ApplyPhysicsWorldDeltaSnapshot(in Span<u8> deltaBytes, mut PhysicsWorld world){
    if(world.m_inStep)
        return false;
    SnapshotByteReader r;
    usize payloadEnd = 0u;
    if(!VerifySnapshotChecksumAndInitReader(deltaBytes, 32u, r, payloadEnd))
        return false;
    u64 baseHash = 0u;
    u64 targetHash = 0u;
    if(!ReadDeltaSnapshotHeader(deltaBytes, r, baseHash, targetHash))
        return false;
    if(ComputePhysicsWorldStateHash(world) != baseHash)
        return false;

    PhysicsWorld tmp;
    ClonePhysicsWorldNonGeometryStateForDelta(world, tmp);
    SwapAllPhysicsWorldGeometryPools(world, tmp);

    if(!ApplyPhysicsWorldDeltaPayload(deltaBytes, payloadEnd, baseHash, targetHash, false, true, r, world, tmp))
        return false;
    CommitRestoredPhysicsWorld(tmp, world);
    return true;
}

b8 RestorePhysicsWorldDeltaSnapshot(in Span<u8> baseSnapshotBytes, in Span<u8> deltaBytes, mut PhysicsWorld world){
    if(world.m_inStep)
        return false;
    SnapshotByteReader r;
    usize payloadEnd = 0u;
    if(!VerifySnapshotChecksumAndInitReader(deltaBytes, 32u, r, payloadEnd))
        return false;
    u64 baseHash = 0u;
    u64 targetHash = 0u;
    if(!ReadDeltaSnapshotHeader(deltaBytes, r, baseHash, targetHash))
        return false;

    SnapshotByteReader baseR;
    usize baseEnd = 0u;
    u64 basePayloadHash = 0u;
    SnapshotWorldProvenance unusedProv;
    if(!VerifyWorldSnapshotChecksumAndProvenance(baseSnapshotBytes, baseR, baseEnd, basePayloadHash, unusedProv))
        return false;
    if(basePayloadHash != baseHash)
        return false;
    PhysicsWorld tmp;
    if(!ReadPhysicsWorldSnapshotPayload(baseSnapshotBytes, baseR, tmp) || baseR.cursor != baseEnd)
        return false;

    if(!ApplyPhysicsWorldDeltaPayload(deltaBytes, payloadEnd, baseHash, targetHash, false, false, r, world, tmp))
        return false;
    CommitRestoredPhysicsWorld(tmp, world);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class PhysicsSubsystemsBundle{
    public PhysicsEnvironment environment;
    public Vector<SoftBody> softBodies;
    public Vector<VehicleController> vehicles;
    public Vector<RagdollInstance> ragdolls;
    public Vector<CharacterController> characters;
    public Vector<Articulation> articulations;
    public Vector<FractureClusterBody> fractureClusters;
    public Vector<FractureBondGraph> fractureBondGraphs;
    public Vector<FractureCollection> fractureCollections;

    public void clear(){
        this.environment.fluids.clear();
        this.environment.forceFields.clear();
        this.environment.elapsedTimeSec = 0.0f;
        this.environment.resetTracking();
        this.softBodies.clear();
        this.vehicles.clear();
        this.ragdolls.clear();
        this.characters.clear();
        this.articulations.clear();
        this.fractureClusters.clear();
        this.fractureBondGraphs.clear();
        this.fractureCollections.clear();
    }
}

b8 SnapWritePhysicsEnvironment<TSink : ISnapshotSink>(in PhysicsEnvironment env, mut TSink w){
    if(!w.writeCount(env.fluids.size()))
        return false;
    for(usize i = 0u; i < env.fluids.size(); ++i){
        in FluidVolume fv = env.fluids[i];
        w.writeU8(cast<u8>(fv.shape));
        SnapWriteVec4(w, VectorSingle(fv.surfaceNormalOffset));
        SnapWriteAabb3D(w, fv.bounds);
        SnapWriteVec4(w, VectorSingle(fv.obbCenter));
        SnapWriteVec4(w, VectorSingle(fv.obbHalfExtents));
        SnapWriteVec4(w, VectorSingle(fv.obbRotation));
        SnapWriteTransform3D(w, fv.shapeTransform);
        if(
            !SnapshotWriteVec4Vec(fv.hullVertices, w)
            || !SnapshotWriteVec4Vec(fv.hullPlanes, w)
            || !SnapshotWriteVec4Vec(fv.meshVertices, w)
            || !SnapshotWriteU32Vec(w, fv.meshIndices)
            || !SnapshotWriteVec4Vec(fv.riverPoints, w)
        )
            return false;
        w.writeF32(fv.riverHalfWidth);
        w.writeF32(fv.riverDepth);
        w.writeF32(fv.riverFlowSpeed);
        if(!w.writeCount(fv.gerstnerWaves.size()))
            return false;
        for(usize wi = 0u; wi < fv.gerstnerWaves.size(); ++wi){
            in FluidGerstnerWave gw = fv.gerstnerWaves[wi];
            SnapWriteVec4(w, VectorSingle(gw.directionAndSteepness));
            w.writeF32(gw.amplitude);
            w.writeF32(gw.wavelength);
            w.writeF32(gw.speed);
            w.writeF32(gw.phase);
        }
        SnapWriteVec4(w, VectorSingle(fv.flowVelocity));
        w.writeF32(fv.density);
        w.writeF32(fv.linearDrag);
        w.writeF32(fv.angularDrag);
        w.writeF32(fv.quadraticDrag);
        w.writeF32(fv.liftCoeff);
        w.writeF32(fv.addedMassCoeff);
        w.writeF32(fv.waveAmplitude);
        w.writeF32(fv.waveFrequency);
        w.writeF32(fv.waveSpeed);
        w.writeF32(fv.sleepWrenchTolerance);
        SnapWriteFilter(w, fv.filter);
        w.writeB8(fv.enabled);
        w.writeB8(fv.enableDynamicWaveGrid);
        w.writeU32(fv.waveGridDimX);
        w.writeU32(fv.waveGridDimZ);
        w.writeF32(fv.waveGridCellSize);
        w.writeF32(fv.waveGridSpeed);
        w.writeF32(fv.waveDamping);
        w.writeF32(fv.waveMaxAmplitude);
        w.writeF32(fv.waveImpulseScale);
        SnapWriteVec4(w, VectorSingle(fv.waveGridOrigin));
        if(!SnapshotWriteF32Vec(fv.waveHeights, w) || !SnapshotWriteF32Vec(fv.waveVelocities, w))
            return false;
        w.writeF32(fv.snapshotWaveGridPeakAbs());
    }
    if(!w.writeCount(env.forceFields.size()))
        return false;
    for(usize i = 0u; i < env.forceFields.size(); ++i){
        in ForceField ff = env.forceFields[i];
        w.writeU8(cast<u8>(ff.type));
        w.writeU8(cast<u8>(ff.shape));
        w.writeU8(cast<u8>(ff.falloffMode));
        SnapWriteAabb3D(w, ff.bounds);
        w.writeB8(ff.useBounds);
        SnapWriteVec4(w, VectorSingle(ff.obbCenter));
        SnapWriteVec4(w, VectorSingle(ff.obbHalfExtents));
        SnapWriteVec4(w, VectorSingle(ff.obbRotation));
        SnapWriteVec4(w, VectorSingle(ff.capsulePointA));
        SnapWriteVec4(w, VectorSingle(ff.capsulePointB));
        w.writeF32(ff.capsuleRadius);
        SnapWriteVec4(w, VectorSingle(ff.originOrDirection));
        SnapWriteVec4(w, VectorSingle(ff.axis));
        w.writeF32(ff.strength);
        w.writeF32(ff.minDistance);
        w.writeF32(ff.radius);
        w.writeF32(ff.falloffPower);
        w.writeF32(ff.inwardSuction);
        w.writeF32(ff.turbulenceAmplitude);
        w.writeF32(ff.turbulenceFrequency);
        SnapWriteFilter(w, ff.filter);
        w.writeB8(ff.enableOcclusion);
        w.writeB8(ff.enabled);
        w.writeU32(ff.vectorFieldDimX);
        w.writeU32(ff.vectorFieldDimY);
        w.writeU32(ff.vectorFieldDimZ);
        if(!SnapshotWriteVec4Vec(ff.vectorFieldSamples, w))
            return false;
    }
    w.writeF32(env.elapsedTimeSec);
    w.writeF32(env.splashImpulseThreshold);
    const Span<FluidImmersionRecord> immersions = env.activeImmersions();
    if(!w.writeCount(immersions.size()))
        return false;
    for(usize i = 0u; i < immersions.size(); ++i){
        in FluidImmersionRecord rec = immersions[i];
        w.writeU32(rec.fluidIndex);
        SnapWriteBodyId(w, rec.bodyId);
        w.writeF32(rec.submergedFraction);
        SnapWriteVec4(w, VectorSingle(rec.lastPoint));
        SnapWriteVec4(w, VectorSingle(rec.lastNormal));
    }
    return true;
}

b8 SnapReadPhysicsEnvironment(in Span<u8> bytes, mut SnapshotByteReader r, mut PhysicsEnvironment outEnv){
    u32 fluidCount = 0u;
    if(!r.readCount(bytes, 32u, fluidCount))
        return false;
    outEnv.fluids.resize(fluidCount);
    for(u32 i = 0u; i < fluidCount; ++i){
        mut FluidVolume fv = outEnv.fluids[i];
        u8 shapeByte = 0u;
        if(
            !r.readU8(bytes, shapeByte)
            || !r.readVec4F(bytes, fv.surfaceNormalOffset.x, fv.surfaceNormalOffset.y, fv.surfaceNormalOffset.z, fv.surfaceNormalOffset.w)
            || !r.readAabb3D(bytes, fv.bounds)
            || !r.readVec4F(bytes, fv.obbCenter.x, fv.obbCenter.y, fv.obbCenter.z, fv.obbCenter.w)
            || !r.readVec4F(bytes, fv.obbHalfExtents.x, fv.obbHalfExtents.y, fv.obbHalfExtents.z, fv.obbHalfExtents.w)
            || !r.readVec4F(bytes, fv.obbRotation.x, fv.obbRotation.y, fv.obbRotation.z, fv.obbRotation.w)
            || !r.readTransform3D(bytes, fv.shapeTransform)
            || !SnapshotReadVec4Vec(bytes, r, fv.hullVertices)
            || !SnapshotReadVec4Vec(bytes, r, fv.hullPlanes)
            || !SnapshotReadVec4Vec(bytes, r, fv.meshVertices)
            || !SnapshotReadU32Vec(bytes, r, fv.meshIndices)
            || !SnapshotReadVec4Vec(bytes, r, fv.riverPoints)
            || !r.readF32(bytes, fv.riverHalfWidth)
            || !r.readF32(bytes, fv.riverDepth)
            || !r.readF32(bytes, fv.riverFlowSpeed)
        )
            return false;
        u32 waveCount = 0u;
        if(!r.readCount(bytes, 32u, waveCount))
            return false;
        fv.gerstnerWaves.resize(waveCount);
        for(u32 wi = 0u; wi < waveCount; ++wi){
            mut FluidGerstnerWave gw = fv.gerstnerWaves[wi];
            if(
                !r.readVec4F(bytes, gw.directionAndSteepness.x, gw.directionAndSteepness.y, gw.directionAndSteepness.z, gw.directionAndSteepness.w)
                || !r.readF32(bytes, gw.amplitude)
                || !r.readF32(bytes, gw.wavelength)
                || !r.readF32(bytes, gw.speed)
                || !r.readF32(bytes, gw.phase)
            )
                return false;
        }
        f32 waveGridPeakAbs = 0.0f;
        if(
            !r.readVec4F(bytes, fv.flowVelocity.x, fv.flowVelocity.y, fv.flowVelocity.z, fv.flowVelocity.w)
            || !r.readF32(bytes, fv.density)
            || !r.readF32(bytes, fv.linearDrag)
            || !r.readF32(bytes, fv.angularDrag)
            || !r.readF32(bytes, fv.quadraticDrag)
            || !r.readF32(bytes, fv.liftCoeff)
            || !r.readF32(bytes, fv.addedMassCoeff)
            || !r.readF32(bytes, fv.waveAmplitude)
            || !r.readF32(bytes, fv.waveFrequency)
            || !r.readF32(bytes, fv.waveSpeed)
            || !r.readF32(bytes, fv.sleepWrenchTolerance)
            || !r.readFilter(bytes, fv.filter)
            || !r.readB8(bytes, fv.enabled)
            || !r.readB8(bytes, fv.enableDynamicWaveGrid)
            || !r.readU32(bytes, fv.waveGridDimX)
            || !r.readU32(bytes, fv.waveGridDimZ)
            || !r.readF32(bytes, fv.waveGridCellSize)
            || !r.readF32(bytes, fv.waveGridSpeed)
            || !r.readF32(bytes, fv.waveDamping)
            || !r.readF32(bytes, fv.waveMaxAmplitude)
            || !r.readF32(bytes, fv.waveImpulseScale)
            || !r.readVec4F(bytes, fv.waveGridOrigin.x, fv.waveGridOrigin.y, fv.waveGridOrigin.z, fv.waveGridOrigin.w)
            || !SnapshotReadF32Vec(bytes, r, fv.waveHeights)
            || !SnapshotReadF32Vec(bytes, r, fv.waveVelocities)
            || !r.readF32(bytes, waveGridPeakAbs)
        )
            return false;
        if(fv.waveHeights.size() != fv.waveVelocities.size())
            return false;
        if(shapeByte >= cast<u8>(FluidVolumeShape::kCount))
            return false;
        fv.shape = cast<FluidVolumeShape>(shapeByte);
        fv.finalizeSnapshotRestore(waveGridPeakAbs);
    }

    u32 fieldCount = 0u;
    if(!r.readCount(bytes, 32u, fieldCount))
        return false;
    outEnv.forceFields.resize(fieldCount);
    for(u32 i = 0u; i < fieldCount; ++i){
        mut ForceField ff = outEnv.forceFields[i];
        u8 typeByte = 0u;
        u8 shapeByte = 0u;
        u8 falloffByte = 0u;
        if(
            !r.readU8(bytes, typeByte)
            || !r.readU8(bytes, shapeByte)
            || !r.readU8(bytes, falloffByte)
            || !r.readAabb3D(bytes, ff.bounds)
            || !r.readB8(bytes, ff.useBounds)
            || !r.readVec4F(bytes, ff.obbCenter.x, ff.obbCenter.y, ff.obbCenter.z, ff.obbCenter.w)
            || !r.readVec4F(bytes, ff.obbHalfExtents.x, ff.obbHalfExtents.y, ff.obbHalfExtents.z, ff.obbHalfExtents.w)
            || !r.readVec4F(bytes, ff.obbRotation.x, ff.obbRotation.y, ff.obbRotation.z, ff.obbRotation.w)
            || !r.readVec4F(bytes, ff.capsulePointA.x, ff.capsulePointA.y, ff.capsulePointA.z, ff.capsulePointA.w)
            || !r.readVec4F(bytes, ff.capsulePointB.x, ff.capsulePointB.y, ff.capsulePointB.z, ff.capsulePointB.w)
            || !r.readF32(bytes, ff.capsuleRadius)
            || !r.readVec4F(bytes, ff.originOrDirection.x, ff.originOrDirection.y, ff.originOrDirection.z, ff.originOrDirection.w)
            || !r.readVec4F(bytes, ff.axis.x, ff.axis.y, ff.axis.z, ff.axis.w)
            || !r.readF32(bytes, ff.strength)
            || !r.readF32(bytes, ff.minDistance)
            || !r.readF32(bytes, ff.radius)
            || !r.readF32(bytes, ff.falloffPower)
            || !r.readF32(bytes, ff.inwardSuction)
            || !r.readF32(bytes, ff.turbulenceAmplitude)
            || !r.readF32(bytes, ff.turbulenceFrequency)
            || !r.readFilter(bytes, ff.filter)
            || !r.readB8(bytes, ff.enableOcclusion)
            || !r.readB8(bytes, ff.enabled)
            || !r.readU32(bytes, ff.vectorFieldDimX)
            || !r.readU32(bytes, ff.vectorFieldDimY)
            || !r.readU32(bytes, ff.vectorFieldDimZ)
            || !SnapshotReadVec4Vec(bytes, r, ff.vectorFieldSamples)
        )
            return false;
        if(
            typeByte >= cast<u8>(ForceFieldType::kCount)
            || shapeByte >= cast<u8>(ForceFieldShape::kCount)
            || falloffByte >= cast<u8>(ForceFieldFalloffMode::kCount)
        )
            return false;
        ff.type = cast<ForceFieldType>(typeByte);
        ff.shape = cast<ForceFieldShape>(shapeByte);
        ff.falloffMode = cast<ForceFieldFalloffMode>(falloffByte);
    }

    if(!r.readF32(bytes, outEnv.elapsedTimeSec) || !r.readF32(bytes, outEnv.splashImpulseThreshold))
        return false;
    u32 immCount = 0u;
    if(!r.readCount(bytes, 44u, immCount))
        return false;
    Vector<FluidImmersionRecord> tmpImmersions;
    tmpImmersions.resize(immCount);
    for(u32 i = 0u; i < immCount; ++i){
        mut FluidImmersionRecord rec = tmpImmersions[i];
        if(
            !r.readU32(bytes, rec.fluidIndex)
            || !r.readBodyId(bytes, rec.bodyId)
            || !r.readF32(bytes, rec.submergedFraction)
            || !r.readVec4F(bytes, rec.lastPoint.x, rec.lastPoint.y, rec.lastPoint.z, rec.lastPoint.w)
            || !r.readVec4F(bytes, rec.lastNormal.x, rec.lastNormal.y, rec.lastNormal.z, rec.lastNormal.w)
        )
            return false;
    }
    outEnv.finalizeSnapshotRestore(Span<FluidImmersionRecord>(tmpImmersions));
    return true;
}

b8 SnapWriteSoftBody<TSink : ISnapshotSink>(in SoftBody sb, mut TSink w){
    if(!w.writeCount(sb.particles.size()))
        return false;
    for(usize i = 0u; i < sb.particles.size(); ++i){
        in SoftBodyParticle pt = sb.particles[i];
        SnapWriteVec4(w, VectorSingle(pt.position));
        SnapWriteVec4(w, VectorSingle(pt.prevPosition));
        SnapWriteVec4(w, VectorSingle(pt.velocity));
        SnapWriteVec4(w, VectorSingle(pt.externalForce));
        w.writeF32(pt.invMass);
        w.writeB8(pt.isFixed);
    }
    if(!w.writeCount(sb.distanceConstraints.size()))
        return false;
    for(usize i = 0u; i < sb.distanceConstraints.size(); ++i){
        in SoftBodyDistanceConstraint c = sb.distanceConstraints[i];
        w.writeU32(c.p0);
        w.writeU32(c.p1);
        w.writeF32(c.restLength);
        w.writeF32(c.compliance);
        w.writeF32(c.lambda);
    }
    if(!w.writeCount(sb.bendingConstraints.size()))
        return false;
    for(usize i = 0u; i < sb.bendingConstraints.size(); ++i){
        in SoftBodyBendingConstraint c = sb.bendingConstraints[i];
        w.writeU32(c.p0);
        w.writeU32(c.p1);
        w.writeF32(c.restLength);
        w.writeF32(c.compliance);
        w.writeF32(c.lambda);
    }
    if(!w.writeCount(sb.dihedralBendingConstraints.size()))
        return false;
    for(usize i = 0u; i < sb.dihedralBendingConstraints.size(); ++i){
        in SoftBodyDihedralBendingConstraint c = sb.dihedralBendingConstraints[i];
        w.writeU32(c.p0);
        w.writeU32(c.p1);
        w.writeU32(c.p2);
        w.writeU32(c.p3);
        w.writeF32(c.restAngle);
        w.writeF32(c.compliance);
        w.writeF32(c.lambda);
    }
    if(!w.writeCount(sb.volumeConstraints.size()))
        return false;
    for(usize i = 0u; i < sb.volumeConstraints.size(); ++i){
        in SoftBodyVolumeConstraint c = sb.volumeConstraints[i];
        w.writeU32(c.p0);
        w.writeU32(c.p1);
        w.writeU32(c.p2);
        w.writeU32(c.p3);
        w.writeF32(c.restVolume);
        w.writeF32(c.compliance);
        w.writeF32(c.lambda);
        w.writeF32(c.youngsModulus);
        w.writeF32(c.poissonsRatio);
        w.writeF32(c.plasticYield);
        w.writeF32(c.plasticCreep);
        w.writeF32(c.plasticMaxStrain);
        w.writeF32(c.devLambda);
        SnapWriteVec4(w, VectorSingle(c.restCol0));
        SnapWriteVec4(w, VectorSingle(c.restCol1));
        SnapWriteVec4(w, VectorSingle(c.restCol2));
    }
    if(!w.writeCount(sb.surfaceTriangles.size()))
        return false;
    for(usize i = 0u; i < sb.surfaceTriangles.size(); ++i){
        in SoftBodyTriangle t = sb.surfaceTriangles[i];
        w.writeU32(t.p0);
        w.writeU32(t.p1);
        w.writeU32(t.p2);
    }
    if(!w.writeCount(sb.attachments.size()))
        return false;
    for(usize i = 0u; i < sb.attachments.size(); ++i){
        in SoftBodyAttachment a = sb.attachments[i];
        w.writeU32(a.particleIndex);
        SnapWriteBodyId(w, a.bodyId);
        SnapWriteVec4(w, VectorSingle(a.localAnchor));
        w.writeF32(a.compliance);
    }
    if(!w.writeCount(sb.backstopConstraints.size()))
        return false;
    for(usize i = 0u; i < sb.backstopConstraints.size(); ++i){
        in SoftBodyBackstopConstraint c = sb.backstopConstraints[i];
        w.writeU32(c.particleIndex);
        SnapWriteVec4(w, VectorSingle(c.center));
        SnapWriteVec4(w, VectorSingle(c.normal));
        w.writeF32(c.maxDistance);
        w.writeF32(c.backstopRadius);
    }
    if(!w.writeCount(sb.goalConstraints.size()))
        return false;
    for(usize i = 0u; i < sb.goalConstraints.size(); ++i){
        in SoftBodyGoalConstraint c = sb.goalConstraints[i];
        w.writeU32(c.particleIndex);
        SnapWriteVec4(w, VectorSingle(c.targetPosition));
        w.writeF32(c.stiffness);
        w.writeF32(c.damping);
    }
    if(!w.writeCount(sb.anisotropicConstraints.size()))
        return false;
    for(usize i = 0u; i < sb.anisotropicConstraints.size(); ++i){
        in SoftBodyAnisotropicClothConstraint c = sb.anisotropicConstraints[i];
        w.writeU32(c.p0);
        w.writeU32(c.p1);
        w.writeU32(c.p2);
        w.writeF32(c.restArea);
        w.writeF32(c.warpStiffness);
        w.writeF32(c.weftStiffness);
        w.writeF32(c.shearStiffness);
        SnapWriteVec4(w, VectorSingle(c.uvInvRow0));
        SnapWriteVec4(w, VectorSingle(c.uvInvRow1));
    }
    if(!w.writeCount(sb.tetherConstraints.size()))
        return false;
    for(usize i = 0u; i < sb.tetherConstraints.size(); ++i){
        in SoftBodyTetherConstraint c = sb.tetherConstraints[i];
        w.writeU32(c.anchorIndex);
        w.writeU32(c.particleIndex);
        w.writeF32(c.maxDistance);
        w.writeF32(c.compliance);
        w.writeF32(c.lambda);
    }
    if(!w.writeCount(sb.cageBinding.bindings.size()))
        return false;
    for(usize i = 0u; i < sb.cageBinding.bindings.size(); ++i){
        in SoftBodyTetBindWeight bw = sb.cageBinding.bindings[i];
        w.writeU32(bw.tetIndex);
        SnapWriteVec4(w, VectorSingle(bw.baryWeights));
    }
    if(!SnapshotWriteVec4Vec(sb.restLocalPositions, w))
        return false;
    if(!SnapshotWriteU32Vec(w, sb.particleSourceIndices))
        return false;
    w.writeU64(sb.topologyVersion);
    w.writeB8(sb.isWorldSpaceBaked());
    SnapWriteVec4(w, VectorSingle(sb.windVelocity));
    w.writeF32(sb.particleRadius);
    w.writeF32(sb.damping);
    w.writeF32(sb.aerodynamicDrag);
    w.writeF32(sb.liftCoeff);
    SnapWriteSurfaceMaterial(w, sb.surfaceMaterial);
    w.writeF32(sb.tearStrainThreshold);
    w.writeB8(sb.enableSelfCollision);
    w.writeF32(sb.selfCollisionRadius);
    w.writeF32(sb.selfCollisionStiffness);
    w.writeF32(sb.selfCollisionFriction);
    w.writeB8(sb.enableTriangleEdgeSelfCollision);
    w.writeB8(sb.enableContinuousSelfCollision);
    w.writeB8(sb.enableVertexSplitTearing);
    w.writeB8(sb.enableParticleCcd);
    w.writeB8(sb.enableSurfaceTriangleCollision);
    w.writeF32(sb.inertialBlendFactor);
    SnapWriteVec4(w, VectorSingle(sb.referenceFramePosition));
    SnapWriteVec4(w, VectorSingle(sb.referenceFrameRotation));
    w.writeB8(sb.useAttachmentReferenceFrame);
    w.writeB8(sb.enableSleep);
    w.writeF32(sb.sleepLinearThreshold);
    w.writeF32(sb.sleepTimeThreshold);
    w.writeB8(sb.isSleeping);
    w.writeF32(sb.pressureCoeff);
    w.writeF32(sb.restSurfaceVolume);
    w.writeF32(sb.pressureCompliance);
    w.writeB8(sb.enableShapeMatching);
    w.writeF32(sb.shapeMatchingStiffness);
    w.writeU32(sb.subSteps);
    w.writeU32(sb.solverIterations);
    SnapWriteFilter(w, sb.collisionFilter);
    w.writeB8(sb.collideWithWorld);
    w.writeF32(sb.impactEventThreshold);
    w.writeB8(sb.snapshotPressureShellTorn());
    w.writeF32(sb.snapshotSleepTimer());
    SnapWriteVec4(w, sb.snapshotShapeMatchQuat());
    SnapWriteVec4(w, sb.snapshotPrevInertialRefPos());
    SnapWriteVec4(w, sb.snapshotPrevInertialRefRot());
    w.writeB8(sb.snapshotHasInertialRef());
    return true;
}

b8 SnapReadSoftBody(in Span<u8> bytes, mut SnapshotByteReader r, mut SoftBody outSb){
    u32 ptCount = 0u;
    if(!r.readCount(bytes, 32u, ptCount))
        return false;
    outSb.particles.resize(ptCount);
    for(u32 i = 0u; i < ptCount; ++i){
        mut SoftBodyParticle pt = outSb.particles[i];
        if(
            !r.readVec4F(bytes, pt.position.x, pt.position.y, pt.position.z, pt.position.w)
            || !r.readVec4F(bytes, pt.prevPosition.x, pt.prevPosition.y, pt.prevPosition.z, pt.prevPosition.w)
            || !r.readVec4F(bytes, pt.velocity.x, pt.velocity.y, pt.velocity.z, pt.velocity.w)
            || !r.readVec4F(bytes, pt.externalForce.x, pt.externalForce.y, pt.externalForce.z, pt.externalForce.w)
            || !r.readF32(bytes, pt.invMass)
            || !r.readB8(bytes, pt.isFixed)
        )
            return false;
    }

    u32 distCount = 0u;
    if(!r.readCount(bytes, 20u, distCount))
        return false;
    outSb.distanceConstraints.resize(distCount);
    for(u32 i = 0u; i < distCount; ++i){
        mut SoftBodyDistanceConstraint c = outSb.distanceConstraints[i];
        if(!r.readU32(bytes, c.p0) || !r.readU32(bytes, c.p1) || !r.readF32(bytes, c.restLength) || !r.readF32(bytes, c.compliance) || !r.readF32(bytes, c.lambda))
            return false;
    }

    u32 bendCount = 0u;
    if(!r.readCount(bytes, 20u, bendCount))
        return false;
    outSb.bendingConstraints.resize(bendCount);
    for(u32 i = 0u; i < bendCount; ++i){
        mut SoftBodyBendingConstraint c = outSb.bendingConstraints[i];
        if(!r.readU32(bytes, c.p0) || !r.readU32(bytes, c.p1) || !r.readF32(bytes, c.restLength) || !r.readF32(bytes, c.compliance) || !r.readF32(bytes, c.lambda))
            return false;
    }

    u32 dihCount = 0u;
    if(!r.readCount(bytes, 28u, dihCount))
        return false;
    outSb.dihedralBendingConstraints.resize(dihCount);
    for(u32 i = 0u; i < dihCount; ++i){
        mut SoftBodyDihedralBendingConstraint c = outSb.dihedralBendingConstraints[i];
        if(!r.readU32(bytes, c.p0) || !r.readU32(bytes, c.p1) || !r.readU32(bytes, c.p2) || !r.readU32(bytes, c.p3) || !r.readF32(bytes, c.restAngle) || !r.readF32(bytes, c.compliance) || !r.readF32(bytes, c.lambda))
            return false;
    }

    u32 volCount = 0u;
    if(!r.readCount(bytes, 32u, volCount))
        return false;
    outSb.volumeConstraints.resize(volCount);
    for(u32 i = 0u; i < volCount; ++i){
        mut SoftBodyVolumeConstraint c = outSb.volumeConstraints[i];
        if(
            !r.readU32(bytes, c.p0)
            || !r.readU32(bytes, c.p1)
            || !r.readU32(bytes, c.p2)
            || !r.readU32(bytes, c.p3)
            || !r.readF32(bytes, c.restVolume)
            || !r.readF32(bytes, c.compliance)
            || !r.readF32(bytes, c.lambda)
            || !r.readF32(bytes, c.youngsModulus)
            || !r.readF32(bytes, c.poissonsRatio)
            || !r.readF32(bytes, c.plasticYield)
            || !r.readF32(bytes, c.plasticCreep)
            || !r.readF32(bytes, c.plasticMaxStrain)
            || !r.readF32(bytes, c.devLambda)
            || !r.readVec4F(bytes, c.restCol0.x, c.restCol0.y, c.restCol0.z, c.restCol0.w)
            || !r.readVec4F(bytes, c.restCol1.x, c.restCol1.y, c.restCol1.z, c.restCol1.w)
            || !r.readVec4F(bytes, c.restCol2.x, c.restCol2.y, c.restCol2.z, c.restCol2.w)
        )
            return false;
    }

    u32 triCount = 0u;
    if(!r.readCount(bytes, 12u, triCount))
        return false;
    outSb.surfaceTriangles.resize(triCount);
    for(u32 i = 0u; i < triCount; ++i){
        mut SoftBodyTriangle t = outSb.surfaceTriangles[i];
        if(!r.readU32(bytes, t.p0) || !r.readU32(bytes, t.p1) || !r.readU32(bytes, t.p2))
            return false;
    }

    u32 attCount = 0u;
    if(!r.readCount(bytes, 16u, attCount))
        return false;
    outSb.attachments.resize(attCount);
    for(u32 i = 0u; i < attCount; ++i){
        mut SoftBodyAttachment a = outSb.attachments[i];
        if(
            !r.readU32(bytes, a.particleIndex)
            || !r.readBodyId(bytes, a.bodyId)
            || !r.readVec4F(bytes, a.localAnchor.x, a.localAnchor.y, a.localAnchor.z, a.localAnchor.w)
            || !r.readF32(bytes, a.compliance)
        )
            return false;
    }

    u32 bsCount = 0u;
    if(!r.readCount(bytes, 16u, bsCount))
        return false;
    outSb.backstopConstraints.resize(bsCount);
    for(u32 i = 0u; i < bsCount; ++i){
        mut SoftBodyBackstopConstraint c = outSb.backstopConstraints[i];
        if(
            !r.readU32(bytes, c.particleIndex)
            || !r.readVec4F(bytes, c.center.x, c.center.y, c.center.z, c.center.w)
            || !r.readVec4F(bytes, c.normal.x, c.normal.y, c.normal.z, c.normal.w)
            || !r.readF32(bytes, c.maxDistance)
            || !r.readF32(bytes, c.backstopRadius)
        )
            return false;
    }

    u32 goalCount = 0u;
    if(!r.readCount(bytes, 16u, goalCount))
        return false;
    outSb.goalConstraints.resize(goalCount);
    for(u32 i = 0u; i < goalCount; ++i){
        mut SoftBodyGoalConstraint c = outSb.goalConstraints[i];
        if(
            !r.readU32(bytes, c.particleIndex)
            || !r.readVec4F(bytes, c.targetPosition.x, c.targetPosition.y, c.targetPosition.z, c.targetPosition.w)
            || !r.readF32(bytes, c.stiffness)
            || !r.readF32(bytes, c.damping)
        )
            return false;
    }

    u32 anisoCount = 0u;
    if(!r.readCount(bytes, 32u, anisoCount))
        return false;
    outSb.anisotropicConstraints.resize(anisoCount);
    for(u32 i = 0u; i < anisoCount; ++i){
        mut SoftBodyAnisotropicClothConstraint c = outSb.anisotropicConstraints[i];
        if(
            !r.readU32(bytes, c.p0)
            || !r.readU32(bytes, c.p1)
            || !r.readU32(bytes, c.p2)
            || !r.readF32(bytes, c.restArea)
            || !r.readF32(bytes, c.warpStiffness)
            || !r.readF32(bytes, c.weftStiffness)
            || !r.readF32(bytes, c.shearStiffness)
            || !r.readVec4F(bytes, c.uvInvRow0.x, c.uvInvRow0.y, c.uvInvRow0.z, c.uvInvRow0.w)
            || !r.readVec4F(bytes, c.uvInvRow1.x, c.uvInvRow1.y, c.uvInvRow1.z, c.uvInvRow1.w)
        )
            return false;
    }

    u32 tetherCount = 0u;
    if(!r.readCount(bytes, 20u, tetherCount))
        return false;
    outSb.tetherConstraints.resize(tetherCount);
    for(u32 i = 0u; i < tetherCount; ++i){
        mut SoftBodyTetherConstraint c = outSb.tetherConstraints[i];
        if(
            !r.readU32(bytes, c.anchorIndex)
            || !r.readU32(bytes, c.particleIndex)
            || !r.readF32(bytes, c.maxDistance)
            || !r.readF32(bytes, c.compliance)
            || !r.readF32(bytes, c.lambda)
        )
            return false;
    }

    u32 cageCount = 0u;
    if(!r.readCount(bytes, 20u, cageCount))
        return false;
    outSb.cageBinding.bindings.resize(cageCount);
    for(u32 i = 0u; i < cageCount; ++i){
        mut SoftBodyTetBindWeight bw = outSb.cageBinding.bindings[i];
        if(
            !r.readU32(bytes, bw.tetIndex)
            || !r.readVec4F(bytes, bw.baryWeights.x, bw.baryWeights.y, bw.baryWeights.z, bw.baryWeights.w)
        )
            return false;
    }

    if(!SnapshotReadVec4Vec(bytes, r, outSb.restLocalPositions))
        return false;
    if(!SnapshotReadU32Vec(bytes, r, outSb.particleSourceIndices))
        return false;
    b8 worldSpaceBaked = false;
    if(!r.readU64(bytes, outSb.topologyVersion) || !r.readB8(bytes, worldSpaceBaked))
        return false;
    outSb.setWorldSpaceBaked(worldSpaceBaked);

    f32 qx = 0.0f;
    f32 qy = 0.0f;
    f32 qz = 0.0f;
    f32 qw = 1.0f;
    b8 pressureShellTorn = false;
    f32 sleepTimer = 0.0f;
    f32 rpx = 0.0f;
    f32 rpy = 0.0f;
    f32 rpz = 0.0f;
    f32 rpw = 0.0f;
    f32 rrx = 0.0f;
    f32 rry = 0.0f;
    f32 rrz = 0.0f;
    f32 rrw = 1.0f;
    b8 hasInertialRef = false;
    if(
        !r.readVec4F(bytes, outSb.windVelocity.x, outSb.windVelocity.y, outSb.windVelocity.z, outSb.windVelocity.w)
        || !r.readF32(bytes, outSb.particleRadius)
        || !r.readF32(bytes, outSb.damping)
        || !r.readF32(bytes, outSb.aerodynamicDrag)
        || !r.readF32(bytes, outSb.liftCoeff)
        || !r.readSurfaceMaterial(bytes, outSb.surfaceMaterial)
        || !r.readF32(bytes, outSb.tearStrainThreshold)
        || !r.readB8(bytes, outSb.enableSelfCollision)
        || !r.readF32(bytes, outSb.selfCollisionRadius)
        || !r.readF32(bytes, outSb.selfCollisionStiffness)
        || !r.readF32(bytes, outSb.selfCollisionFriction)
        || !r.readB8(bytes, outSb.enableTriangleEdgeSelfCollision)
        || !r.readB8(bytes, outSb.enableContinuousSelfCollision)
        || !r.readB8(bytes, outSb.enableVertexSplitTearing)
        || !r.readB8(bytes, outSb.enableParticleCcd)
        || !r.readB8(bytes, outSb.enableSurfaceTriangleCollision)
        || !r.readF32(bytes, outSb.inertialBlendFactor)
        || !r.readVec4F(bytes, outSb.referenceFramePosition.x, outSb.referenceFramePosition.y, outSb.referenceFramePosition.z, outSb.referenceFramePosition.w)
        || !r.readVec4F(bytes, outSb.referenceFrameRotation.x, outSb.referenceFrameRotation.y, outSb.referenceFrameRotation.z, outSb.referenceFrameRotation.w)
        || !r.readB8(bytes, outSb.useAttachmentReferenceFrame)
        || !r.readB8(bytes, outSb.enableSleep)
        || !r.readF32(bytes, outSb.sleepLinearThreshold)
        || !r.readF32(bytes, outSb.sleepTimeThreshold)
        || !r.readB8(bytes, outSb.isSleeping)
        || !r.readF32(bytes, outSb.pressureCoeff)
        || !r.readF32(bytes, outSb.restSurfaceVolume)
        || !r.readF32(bytes, outSb.pressureCompliance)
        || !r.readB8(bytes, outSb.enableShapeMatching)
        || !r.readF32(bytes, outSb.shapeMatchingStiffness)
        || !r.readU32(bytes, outSb.subSteps)
        || !r.readU32(bytes, outSb.solverIterations)
        || !r.readFilter(bytes, outSb.collisionFilter)
        || !r.readB8(bytes, outSb.collideWithWorld)
        || !r.readF32(bytes, outSb.impactEventThreshold)
        || !r.readB8(bytes, pressureShellTorn)
        || !r.readF32(bytes, sleepTimer)
        || !r.readVec4F(bytes, qx, qy, qz, qw)
        || !r.readVec4F(bytes, rpx, rpy, rpz, rpw)
        || !r.readVec4F(bytes, rrx, rry, rrz, rrw)
        || !r.readB8(bytes, hasInertialRef)
    )
        return false;

    outSb.finalizeSnapshotRestore(
        VectorSingle(qx, qy, qz, qw),
        pressureShellTorn,
        sleepTimer,
        VectorSingle(rpx, rpy, rpz, rpw),
        VectorSingle(rrx, rry, rrz, rrw),
        hasInertialRef
    );
    return true;
}

b8 SnapWriteVehicleController<TSink : ISnapshotSink>(in VehicleController veh, mut TSink w){
    SnapWriteBodyId(w, veh.chassisBodyId);
    SnapWriteBodyId(w, veh.trailerBodyId);
    SnapWriteJointId(veh.trailerJointId, w);

    in VehicleEngineDef eng = veh.engine;
    w.writeF32(eng.maxTorque);
    w.writeF32(eng.idleRpm);
    w.writeF32(eng.maxRpm);
    w.writeF32(eng.revLimiterRpm);
    w.writeF32(eng.shiftUpRpm);
    w.writeF32(eng.shiftDownRpm);
    w.writeF32(eng.finalDriveRatio);
    w.writeF32(eng.reverseRatio);
    for(usize i = 0u; i < 6u; ++i)
        w.writeF32(eng.forwardGearRatios[i]);
    if(!w.writeCount(eng.torqueCurvePoints.size()))
        return false;
    for(usize i = 0u; i < eng.torqueCurvePoints.size(); ++i){
        in f32x2u pt = eng.torqueCurvePoints[i];
        SnapWriteVec2F(w, pt.x, pt.y);
    }
    w.writeU32(eng.gearCount);
    w.writeU8(cast<u8>(eng.archetype));
    w.writeU8(cast<u8>(eng.centerDifferentialMode));
    w.writeU8(cast<u8>(eng.axleDifferentialMode));
    w.writeF32(eng.differentialBias);
    w.writeF32(eng.torsenBiasRatio);
    w.writeF32(eng.centerDiffFrontSplit);
    w.writeF32(eng.differentialLockTorque);
    w.writeF32(eng.clutchStrength);
    w.writeF32(eng.torqueConverterStallRpm);
    w.writeF32(eng.torqueConverterMaxTorqueRatio);
    w.writeF32(eng.engineInertia);
    w.writeF32(eng.dragCoeff);
    w.writeF32(eng.downforceCoeff);
    w.writeF32(eng.frontalArea);
    w.writeF32(eng.airDensity);
    SnapWriteVec4(w, VectorSingle(eng.ambientWindVelocity));
    SnapWriteVec4(w, VectorSingle(eng.chassisForwardAxis));
    SnapWriteVec4(w, VectorSingle(eng.chassisUpAxis));
    w.writeF32(eng.steerSlewRateRadPerSec);
    w.writeF32(eng.rearSteerRatio);
    w.writeF32(eng.motorcycleLeanGain);
    w.writeF32(eng.motorcycleLeanMaxRad);
    w.writeU32(eng.subSteps);
    w.writeF32(eng.trackWidth);
    w.writeF32(eng.wheelbase);
    w.writeF32(eng.espStrength);
    w.writeF32(eng.espMaxBrakeTorque);
    w.writeB8(eng.useAckermanSteering);
    w.writeB8(eng.automaticTransmission);
    w.writeB8(eng.useTorqueConverter);
    w.writeB8(eng.enableAbs);
    w.writeB8(eng.enableTcs);
    w.writeB8(eng.enableEsp);
    w.writeF32(eng.steerSelfCenteringGain);
    w.writeF32(eng.trailerBrakeForce);
    w.writeF32(eng.motorcycleCasterAngleRad);
    w.writeF32(eng.motorcycleTrail);
    w.writeF32(eng.motorcycleCounterSteerGain);
    w.writeF32(eng.motorcycleGyroGain);

    if(!w.writeCount(veh.wheelDefs.size()))
        return false;
    for(usize i = 0u; i < veh.wheelDefs.size(); ++i){
        in VehicleWheelDef wd = veh.wheelDefs[i];
        SnapWriteVec4(w, VectorSingle(wd.attachmentPoint));
        SnapWriteVec4(w, VectorSingle(wd.suspensionDirection));
        SnapWriteVec4(w, VectorSingle(wd.axleAxis));
        SnapWriteVec4(w, VectorSingle(wd.forwardAxis));
        w.writeF32(wd.suspensionRestLength);
        w.writeF32(wd.suspensionMaxTravel);
        w.writeF32(wd.suspensionStiffness);
        w.writeF32(wd.suspensionDamping);
        w.writeF32(wd.suspensionReboundDamping);
        w.writeF32(wd.bumpStopStiffness);
        w.writeF32(wd.bumpStopRestitution);
        w.writeF32(wd.wheelRadius);
        w.writeF32(wd.wheelWidth);
        w.writeF32(wd.wheelChamfer);
        w.writeF32(wd.wheelInertia);
        w.writeF32(wd.maxSteerAngleRad);
        w.writeF32(wd.rearSteerRatio);
        w.writeF32(wd.camberAngleRad);
        w.writeF32(wd.toeAngleRad);
        w.writeF32(wd.driveFraction);
        w.writeF32(wd.maxBrakeTorque);
        w.writeF32(wd.maxHandbrakeTorque);
        w.writeF32(wd.frictionMultiplier);
        w.writeF32(wd.loadSensitivity);
        w.writeF32(wd.nominalWheelLoad);
        w.writeF32(wd.rollingResistanceCoeff);
        w.writeF32(wd.longitudinalStiffness);
        w.writeF32(wd.lateralStiffness);
        w.writeF32(wd.pacejkaShapeC);
        w.writeF32(wd.pacejkaCurvatureE);
        w.writeF32(wd.pacejkaShapeCLat);
        w.writeF32(wd.pacejkaCurvatureELat);
        w.writeF32(wd.relaxationLengthLong);
        w.writeF32(wd.relaxationLengthLat);
        w.writeF32(wd.selfAligningTrail);
        w.writeI32(wd.axleIndex);
        w.writeI32(wd.antiRollPairIndex);
        w.writeI32(wd.trackSide);
        w.writeF32(wd.antiRollStiffness);
        w.writeU8(cast<u8>(wd.wheelCastMode));
        w.writeB8(wd.isSteerable);
        w.writeB8(wd.isDriven);
        w.writeB8(wd.handbrakeAffected);
        w.writeB8(wd.attachedToTrailer);
    }

    if(!w.writeCount(veh.wheelStates.size()))
        return false;
    for(usize i = 0u; i < veh.wheelStates.size(); ++i){
        in VehicleWheelState ws = veh.wheelStates[i];
        w.writeF32(ws.suspensionLength);
        w.writeF32(ws.prevSuspensionLength);
        w.writeF32(ws.steerAngle);
        w.writeF32(ws.prevSteerAngle);
        w.writeF32(ws.rotationAngle);
        w.writeF32(ws.prevRotationAngle);
        w.writeF32(ws.angularVelocity);
        w.writeF32(ws.longitudinalSlip);
        w.writeF32(ws.lateralSlip);
        w.writeF32(ws.prevSlipLong);
        w.writeF32(ws.prevSlipLat);
        w.writeF32(ws.aligningTorque);
        w.writeF32(ws.suspensionForce);
        w.writeF32(ws.longitudinalForce);
        w.writeF32(ws.lateralForce);
        SnapWriteVec4(w, VectorSingle(ws.contactPoint));
        SnapWriteVec4(w, VectorSingle(ws.contactNormal));
        SnapWriteVec4(w, VectorSingle(ws.groundVelocity));
        SnapWriteBodyId(w, ws.groundBodyId);
        SnapWriteShapeId(w, ws.groundShapeId);
        SnapWriteSurfaceMaterial(w, ws.groundMaterial);
        w.writeB8(ws.isGrounded);
        SnapWriteTransform3D(w, ws.worldTransform);
    }

    SnapWriteFilter(w, veh.queryFilter);
    w.writeF32(veh.engineRpm);
    w.writeF32(veh.clutchSlip);
    w.writeI32(veh.currentGear);
    w.writeF32(veh.shiftCooldown);
    w.writeF32(veh.currentSpeedMps);
    w.writeF32(veh.wheelSlipEventThreshold);
    w.writeF32(veh.steeringFeedbackTorque);
    SnapWriteVec4(w, veh.snapshotEnvWindVelocity());
    const Span<f32> prevSlipMags = veh.snapshotPrevWheelSlipMags();
    if(!w.writeCount(prevSlipMags.size()))
        return false;
    w.writeF32Span(prevSlipMags);
    return true;
}

b8 SnapReadVehicleController(in Span<u8> bytes, mut SnapshotByteReader r, mut VehicleController outVeh){
    if(
        !r.readBodyId(bytes, outVeh.chassisBodyId)
        || !r.readBodyId(bytes, outVeh.trailerBodyId)
        || !r.readJointId(bytes, outVeh.trailerJointId)
    )
        return false;

    mut VehicleEngineDef eng = outVeh.engine;
    if(
        !r.readF32(bytes, eng.maxTorque)
        || !r.readF32(bytes, eng.idleRpm)
        || !r.readF32(bytes, eng.maxRpm)
        || !r.readF32(bytes, eng.revLimiterRpm)
        || !r.readF32(bytes, eng.shiftUpRpm)
        || !r.readF32(bytes, eng.shiftDownRpm)
        || !r.readF32(bytes, eng.finalDriveRatio)
        || !r.readF32(bytes, eng.reverseRatio)
    )
        return false;
    for(usize i = 0u; i < 6u; ++i){
        if(!r.readF32(bytes, eng.forwardGearRatios[i]))
            return false;
    }
    u32 curveCnt = 0u;
    if(!r.readCount(bytes, 8u, curveCnt) || curveCnt > 16u)
        return false;
    eng.torqueCurvePoints.resize(curveCnt);
    for(u32 i = 0u; i < curveCnt; ++i){
        f32 px = 0.0f;
        f32 py = 0.0f;
        if(!r.readVec2F(bytes, px, py))
            return false;
        eng.torqueCurvePoints[i] = f32x2u(px, py);
    }
    u8 archetypeByte = 0u;
    u8 centerDiffByte = 0u;
    u8 axleDiffByte = 0u;
    if(
        !r.readU32(bytes, eng.gearCount)
        || !r.readU8(bytes, archetypeByte)
        || !r.readU8(bytes, centerDiffByte)
        || !r.readU8(bytes, axleDiffByte)
        || !r.readF32(bytes, eng.differentialBias)
        || !r.readF32(bytes, eng.torsenBiasRatio)
        || !r.readF32(bytes, eng.centerDiffFrontSplit)
        || !r.readF32(bytes, eng.differentialLockTorque)
        || !r.readF32(bytes, eng.clutchStrength)
        || !r.readF32(bytes, eng.torqueConverterStallRpm)
        || !r.readF32(bytes, eng.torqueConverterMaxTorqueRatio)
        || !r.readF32(bytes, eng.engineInertia)
        || !r.readF32(bytes, eng.dragCoeff)
        || !r.readF32(bytes, eng.downforceCoeff)
        || !r.readF32(bytes, eng.frontalArea)
        || !r.readF32(bytes, eng.airDensity)
        || !r.readVec4F(bytes, eng.ambientWindVelocity.x, eng.ambientWindVelocity.y, eng.ambientWindVelocity.z, eng.ambientWindVelocity.w)
        || !r.readVec4F(bytes, eng.chassisForwardAxis.x, eng.chassisForwardAxis.y, eng.chassisForwardAxis.z, eng.chassisForwardAxis.w)
        || !r.readVec4F(bytes, eng.chassisUpAxis.x, eng.chassisUpAxis.y, eng.chassisUpAxis.z, eng.chassisUpAxis.w)
        || !r.readF32(bytes, eng.steerSlewRateRadPerSec)
        || !r.readF32(bytes, eng.rearSteerRatio)
        || !r.readF32(bytes, eng.motorcycleLeanGain)
        || !r.readF32(bytes, eng.motorcycleLeanMaxRad)
        || !r.readU32(bytes, eng.subSteps)
        || !r.readF32(bytes, eng.trackWidth)
        || !r.readF32(bytes, eng.wheelbase)
        || !r.readF32(bytes, eng.espStrength)
        || !r.readF32(bytes, eng.espMaxBrakeTorque)
        || !r.readB8(bytes, eng.useAckermanSteering)
        || !r.readB8(bytes, eng.automaticTransmission)
        || !r.readB8(bytes, eng.useTorqueConverter)
        || !r.readB8(bytes, eng.enableAbs)
        || !r.readB8(bytes, eng.enableTcs)
        || !r.readB8(bytes, eng.enableEsp)
        || !r.readF32(bytes, eng.steerSelfCenteringGain)
        || !r.readF32(bytes, eng.trailerBrakeForce)
        || !r.readF32(bytes, eng.motorcycleCasterAngleRad)
        || !r.readF32(bytes, eng.motorcycleTrail)
        || !r.readF32(bytes, eng.motorcycleCounterSteerGain)
        || !r.readF32(bytes, eng.motorcycleGyroGain)
    )
        return false;
    if(
        archetypeByte >= cast<u8>(VehicleArchetype::kCount)
        || centerDiffByte >= cast<u8>(VehicleDifferentialMode::kCount)
        || axleDiffByte >= cast<u8>(VehicleDifferentialMode::kCount)
    )
        return false;
    eng.archetype = cast<VehicleArchetype>(archetypeByte);
    eng.centerDifferentialMode = cast<VehicleDifferentialMode>(centerDiffByte);
    eng.axleDifferentialMode = cast<VehicleDifferentialMode>(axleDiffByte);

    u32 wheelDefCnt = 0u;
    if(!r.readCount(bytes, 32u, wheelDefCnt))
        return false;
    outVeh.wheelDefs.resize(wheelDefCnt);
    for(u32 i = 0u; i < wheelDefCnt; ++i){
        mut VehicleWheelDef wd = outVeh.wheelDefs[i];
        u8 castModeByte = 0u;
        if(
            !r.readVec4F(bytes, wd.attachmentPoint.x, wd.attachmentPoint.y, wd.attachmentPoint.z, wd.attachmentPoint.w)
            || !r.readVec4F(bytes, wd.suspensionDirection.x, wd.suspensionDirection.y, wd.suspensionDirection.z, wd.suspensionDirection.w)
            || !r.readVec4F(bytes, wd.axleAxis.x, wd.axleAxis.y, wd.axleAxis.z, wd.axleAxis.w)
            || !r.readVec4F(bytes, wd.forwardAxis.x, wd.forwardAxis.y, wd.forwardAxis.z, wd.forwardAxis.w)
            || !r.readF32(bytes, wd.suspensionRestLength)
            || !r.readF32(bytes, wd.suspensionMaxTravel)
            || !r.readF32(bytes, wd.suspensionStiffness)
            || !r.readF32(bytes, wd.suspensionDamping)
            || !r.readF32(bytes, wd.suspensionReboundDamping)
            || !r.readF32(bytes, wd.bumpStopStiffness)
            || !r.readF32(bytes, wd.bumpStopRestitution)
            || !r.readF32(bytes, wd.wheelRadius)
            || !r.readF32(bytes, wd.wheelWidth)
            || !r.readF32(bytes, wd.wheelChamfer)
            || !r.readF32(bytes, wd.wheelInertia)
            || !r.readF32(bytes, wd.maxSteerAngleRad)
            || !r.readF32(bytes, wd.rearSteerRatio)
            || !r.readF32(bytes, wd.camberAngleRad)
            || !r.readF32(bytes, wd.toeAngleRad)
            || !r.readF32(bytes, wd.driveFraction)
            || !r.readF32(bytes, wd.maxBrakeTorque)
            || !r.readF32(bytes, wd.maxHandbrakeTorque)
            || !r.readF32(bytes, wd.frictionMultiplier)
            || !r.readF32(bytes, wd.loadSensitivity)
            || !r.readF32(bytes, wd.nominalWheelLoad)
            || !r.readF32(bytes, wd.rollingResistanceCoeff)
            || !r.readF32(bytes, wd.longitudinalStiffness)
            || !r.readF32(bytes, wd.lateralStiffness)
            || !r.readF32(bytes, wd.pacejkaShapeC)
            || !r.readF32(bytes, wd.pacejkaCurvatureE)
            || !r.readF32(bytes, wd.pacejkaShapeCLat)
            || !r.readF32(bytes, wd.pacejkaCurvatureELat)
            || !r.readF32(bytes, wd.relaxationLengthLong)
            || !r.readF32(bytes, wd.relaxationLengthLat)
            || !r.readF32(bytes, wd.selfAligningTrail)
            || !r.readI32(bytes, wd.axleIndex)
            || !r.readI32(bytes, wd.antiRollPairIndex)
            || !r.readI32(bytes, wd.trackSide)
            || !r.readF32(bytes, wd.antiRollStiffness)
            || !r.readU8(bytes, castModeByte)
            || !r.readB8(bytes, wd.isSteerable)
            || !r.readB8(bytes, wd.isDriven)
            || !r.readB8(bytes, wd.handbrakeAffected)
            || !r.readB8(bytes, wd.attachedToTrailer)
        )
            return false;
        if(castModeByte >= cast<u8>(VehicleWheelCastMode::kCount))
            return false;
        wd.wheelCastMode = cast<VehicleWheelCastMode>(castModeByte);
    }

    u32 wheelStateCnt = 0u;
    if(!r.readCount(bytes, 32u, wheelStateCnt) || wheelStateCnt != wheelDefCnt)
        return false;
    outVeh.wheelStates.resize(wheelStateCnt);
    for(u32 i = 0u; i < wheelStateCnt; ++i){
        mut VehicleWheelState ws = outVeh.wheelStates[i];
        if(
            !r.readF32(bytes, ws.suspensionLength)
            || !r.readF32(bytes, ws.prevSuspensionLength)
            || !r.readF32(bytes, ws.steerAngle)
            || !r.readF32(bytes, ws.prevSteerAngle)
            || !r.readF32(bytes, ws.rotationAngle)
            || !r.readF32(bytes, ws.prevRotationAngle)
            || !r.readF32(bytes, ws.angularVelocity)
            || !r.readF32(bytes, ws.longitudinalSlip)
            || !r.readF32(bytes, ws.lateralSlip)
            || !r.readF32(bytes, ws.prevSlipLong)
            || !r.readF32(bytes, ws.prevSlipLat)
            || !r.readF32(bytes, ws.aligningTorque)
            || !r.readF32(bytes, ws.suspensionForce)
            || !r.readF32(bytes, ws.longitudinalForce)
            || !r.readF32(bytes, ws.lateralForce)
            || !r.readVec4F(bytes, ws.contactPoint.x, ws.contactPoint.y, ws.contactPoint.z, ws.contactPoint.w)
            || !r.readVec4F(bytes, ws.contactNormal.x, ws.contactNormal.y, ws.contactNormal.z, ws.contactNormal.w)
            || !r.readVec4F(bytes, ws.groundVelocity.x, ws.groundVelocity.y, ws.groundVelocity.z, ws.groundVelocity.w)
            || !r.readBodyId(bytes, ws.groundBodyId)
            || !r.readShapeId(bytes, ws.groundShapeId)
            || !r.readSurfaceMaterial(bytes, ws.groundMaterial)
            || !r.readB8(bytes, ws.isGrounded)
            || !r.readTransform3D(bytes, ws.worldTransform)
        )
            return false;
    }

    f32 ewx = 0.0f;
    f32 ewy = 0.0f;
    f32 ewz = 0.0f;
    f32 eww = 0.0f;
    Vector<f32> tmpPrevSlipMags;
    if(
        !r.readFilter(bytes, outVeh.queryFilter)
        || !r.readF32(bytes, outVeh.engineRpm)
        || !r.readF32(bytes, outVeh.clutchSlip)
        || !r.readI32(bytes, outVeh.currentGear)
        || !r.readF32(bytes, outVeh.shiftCooldown)
        || !r.readF32(bytes, outVeh.currentSpeedMps)
        || !r.readF32(bytes, outVeh.wheelSlipEventThreshold)
        || !r.readF32(bytes, outVeh.steeringFeedbackTorque)
        || !r.readVec4F(bytes, ewx, ewy, ewz, eww)
        || !SnapshotReadF32Vec(bytes, r, tmpPrevSlipMags)
    )
        return false;

    outVeh.finalizeSnapshotRestore(VectorSingle(ewx, ewy, ewz, eww), Span<f32>(tmpPrevSlipMags));
    return true;
}

b8 SnapWriteArticulation<TSink : ISnapshotSink>(in Articulation art, mut TSink w){
    if(!w.writeCount(art.linkDefs.size()))
        return false;
    for(usize i = 0u; i < art.linkDefs.size(); ++i){
        in ArticulationLinkDef d = art.linkDefs[i];
        w.writeU32(d.parentIndex);
        w.writeU8(cast<u8>(d.jointType));
        SnapWriteTransform3D(w, d.parentToJoint);
        SnapWriteTransform3D(w, d.jointToChild);
        SnapWriteVec4(w, VectorSingle(d.jointAxisLocal));
        SnapWriteVec4(w, VectorSingle(d.jointAxisSecondaryLocal));
        w.writeF32(d.mass);
        SnapWriteVec4(w, VectorSingle(d.comLocal));
        SnapWriteVec4(w, VectorSingle(d.inertiaDiag));
        SnapWriteSymMat3(w, d.inertiaTensor);
        w.writeB8(d.useFullInertiaTensor);
        w.writeB8(d.enableLimit);
        SnapWriteVec4(w, VectorSingle(d.lowerLimits));
        SnapWriteVec4(w, VectorSingle(d.upperLimits));
        w.writeF32(d.limitStiffness);
        w.writeF32(d.limitDamping);
        w.writeB8(d.enableDrive);
        SnapWriteVec4(w, VectorSingle(d.driveTargetPos3));
        SnapWriteVec4(w, VectorSingle(d.driveTargetVel3));
        w.writeF32(d.jointDamping);
        w.writeF32(d.jointFriction);
        w.writeF32(d.limitRestitution);
        SnapWriteBodyId(w, d.proxyBodyId);
        w.writeF32(d.screwPitch);
        w.writeU8(d.limitDofMask);
        w.writeU8(d.driveDofMask);
        SnapWriteVec4(w, VectorSingle(d.driveStiffness3));
        SnapWriteVec4(w, VectorSingle(d.driveDamping3));
        SnapWriteVec4(w, VectorSingle(d.driveMaxForce3));
        SnapWriteVec4(w, VectorSingle(d.armature));
        w.writeB8(d.useImplicitDrive);
        w.writeB8(d.useEllipticConeLimit);
        SnapWriteVec4(w, VectorSingle(d.driveTargetQuat));
        w.writeB8(d.useQuatDrive);
        w.writeF32(d.breakForce);
        w.writeF32(d.breakTorque);
    }

    if(!w.writeCount(art.linkStates.size()))
        return false;
    for(usize i = 0u; i < art.linkStates.size(); ++i){
        in ArticulationLinkState s = art.linkStates[i];
        SnapWriteVec4(w, VectorSingle(s.q3));
        SnapWriteVec4(w, VectorSingle(s.qd3));
        SnapWriteVec4(w, VectorSingle(s.qdd3));
        SnapWriteVec4(w, VectorSingle(s.externalTau3));
        SnapWriteVec4(w, VectorSingle(s.jointRotation));
        SnapWriteVec4(w, VectorSingle(s.measuredJointTorque3));
        SnapWriteSpatialVec(s.measuredReactionForce, w);
        SnapWriteTransform3D(w, s.worldTransform);
        SnapWriteSpatialVec(s.spatialVelocity, w);
        SnapWriteSpatialVec(s.externalForce, w);
        w.writeB8(s.jointBroken);
    }

    SnapWriteTransform3D(w, art.baseTransform);
    SnapWriteSpatialVec(art.baseVelocity, w);
    w.writeB8(art.fixedBase);
    w.writeU32(art.subSteps);
    w.writeU32(art.solverIterations);
    w.writeB8(art.enableContactCoupling);
    w.writeB8(art.overrideContactFriction);
    w.writeF32(art.contactRestitution);
    w.writeF32(art.contactFriction);
    SnapWriteFilter(w, art.contactFilter);

    if(!w.writeCount(art.mimicConstraints.size()))
        return false;
    for(usize i = 0u; i < art.mimicConstraints.size(); ++i){
        in ArticulationMimicConstraint mc = art.mimicConstraints[i];
        w.writeU32(mc.linkIndex);
        w.writeU32(mc.dofIndex);
        w.writeU32(mc.targetLinkIndex);
        w.writeU32(mc.targetDofIndex);
        w.writeF32(mc.gearRatio);
        w.writeF32(mc.offset);
        w.writeF32(mc.compliance);
        w.writeB8(mc.enabled);
    }

    if(!w.writeCount(art.tendonConstraints.size()))
        return false;
    for(usize i = 0u; i < art.tendonConstraints.size(); ++i){
        in ArticulationTendonConstraint tc = art.tendonConstraints[i];
        if(!w.writeCount(tc.linkIndices.size()))
            return false;
        for(usize k = 0u; k < tc.linkIndices.size(); ++k)
            w.writeU32(tc.linkIndices[k]);
        if(!w.writeCount(tc.dofIndices.size()))
            return false;
        for(usize k = 0u; k < tc.dofIndices.size(); ++k)
            w.writeU32(tc.dofIndices[k]);
        if(!w.writeCount(tc.coefficients.size()))
            return false;
        for(usize k = 0u; k < tc.coefficients.size(); ++k)
            w.writeF32(tc.coefficients[k]);
        w.writeF32(tc.restLength);
        w.writeF32(tc.lowerLimit);
        w.writeF32(tc.upperLimit);
        w.writeF32(tc.compliance);
        w.writeB8(tc.isEquality);
        w.writeB8(tc.enabled);
    }

    if(!w.writeCount(art.spatialTendons.size()))
        return false;
    for(usize i = 0u; i < art.spatialTendons.size(); ++i){
        in ArticulationSpatialTendon st = art.spatialTendons[i];
        if(!w.writeCount(st.attachments.size()))
            return false;
        for(usize k = 0u; k < st.attachments.size(); ++k){
            w.writeU32(st.attachments[k].linkIndex);
            SnapWriteVec4(w, VectorSingle(st.attachments[k].localPoint));
        }
        w.writeF32(st.restLength);
        w.writeF32(st.lowerLimit);
        w.writeF32(st.upperLimit);
        w.writeF32(st.stiffness);
        w.writeF32(st.damping);
        w.writeF32(st.compliance);
        w.writeB8(st.isEquality);
        w.writeB8(st.enabled);
    }

    if(!w.writeCount(art.loopConstraints.size()))
        return false;
    for(usize i = 0u; i < art.loopConstraints.size(); ++i){
        in ArticulationLoopConstraint lc = art.loopConstraints[i];
        w.writeU32(lc.linkIndexA);
        w.writeU32(lc.linkIndexB);
        SnapWriteVec4(w, VectorSingle(lc.localAnchorA));
        SnapWriteVec4(w, VectorSingle(lc.localAnchorB));
        w.writeB8(lc.lockOrientation);
        SnapWriteVec4(w, VectorSingle(lc.relOrientation));
        w.writeF32(lc.compliance);
        w.writeB8(lc.enabled);
    }

    if(!w.writeCount(art.rigidBodyConstraints.size()))
        return false;
    for(usize i = 0u; i < art.rigidBodyConstraints.size(); ++i){
        in ArticulationRigidBodyConstraint rbc = art.rigidBodyConstraints[i];
        w.writeU32(rbc.linkIndex);
        SnapWriteBodyId(w, rbc.bodyId);
        SnapWriteVec4(w, VectorSingle(rbc.localAnchorLink));
        SnapWriteVec4(w, VectorSingle(rbc.localAnchorBody));
        w.writeB8(rbc.lockOrientation);
        SnapWriteVec4(w, VectorSingle(rbc.relOrientation));
        w.writeF32(rbc.compliance);
        w.writeB8(rbc.enabled);
    }

    w.writeB8(art.enableSelfCollision);
    w.writeF32(art.selfCollisionMargin);
    w.writeB8(art.enableCcd);
    w.writeF32(art.ccdMotionThreshold);
    w.writeB8(art.enableSleep);
    w.writeB8(art.isSleeping);
    w.writeF32(art.sleepTimer);
    w.writeF32(art.sleepLinearThreshold);
    w.writeF32(art.sleepAngularThreshold);
    w.writeF32(art.sleepTimeThreshold);
    w.writeB8(art.enableBreakEvents);
    Vector<u64> warmNKeys;
    Vector<f32> warmNVals;
    Vector<u64> warmTKeys;
    Vector<f32x4> warmTVals;
    art.snapshotCollectWarmContacts(warmNKeys, warmNVals, warmTKeys, warmTVals);
    if(
        !SnapshotWriteU64Vec(warmNKeys, w)
        || !SnapshotWriteF32Vec(warmNVals, w)
        || !SnapshotWriteU64Vec(warmTKeys, w)
        || !SnapshotWriteVec4Vec(warmTVals, w)
    )
        return false;
    return true;
}

b8 SnapReadArticulation(in Span<u8> bytes, mut SnapshotByteReader r, mut Articulation outArt){
    u32 linkDefCnt = 0u;
    if(!r.readCount(bytes, 32u, linkDefCnt))
        return false;
    outArt.linkDefs.resize(linkDefCnt);
    for(u32 i = 0u; i < linkDefCnt; ++i){
        mut ArticulationLinkDef d = outArt.linkDefs[i];
        u8 jointTypeByte = 0u;
        if(
            !r.readU32(bytes, d.parentIndex)
            || !r.readU8(bytes, jointTypeByte)
            || !r.readTransform3D(bytes, d.parentToJoint)
            || !r.readTransform3D(bytes, d.jointToChild)
            || !r.readVec4F(bytes, d.jointAxisLocal.x, d.jointAxisLocal.y, d.jointAxisLocal.z, d.jointAxisLocal.w)
            || !r.readVec4F(bytes, d.jointAxisSecondaryLocal.x, d.jointAxisSecondaryLocal.y, d.jointAxisSecondaryLocal.z, d.jointAxisSecondaryLocal.w)
            || !r.readF32(bytes, d.mass)
            || !r.readVec4F(bytes, d.comLocal.x, d.comLocal.y, d.comLocal.z, d.comLocal.w)
            || !r.readVec4F(bytes, d.inertiaDiag.x, d.inertiaDiag.y, d.inertiaDiag.z, d.inertiaDiag.w)
            || !r.readSymMat3(bytes, d.inertiaTensor)
            || !r.readB8(bytes, d.useFullInertiaTensor)
            || !r.readB8(bytes, d.enableLimit)
            || !r.readVec4F(bytes, d.lowerLimits.x, d.lowerLimits.y, d.lowerLimits.z, d.lowerLimits.w)
            || !r.readVec4F(bytes, d.upperLimits.x, d.upperLimits.y, d.upperLimits.z, d.upperLimits.w)
            || !r.readF32(bytes, d.limitStiffness)
            || !r.readF32(bytes, d.limitDamping)
            || !r.readB8(bytes, d.enableDrive)
            || !r.readVec4F(bytes, d.driveTargetPos3.x, d.driveTargetPos3.y, d.driveTargetPos3.z, d.driveTargetPos3.w)
            || !r.readVec4F(bytes, d.driveTargetVel3.x, d.driveTargetVel3.y, d.driveTargetVel3.z, d.driveTargetVel3.w)
            || !r.readF32(bytes, d.jointDamping)
            || !r.readF32(bytes, d.jointFriction)
            || !r.readF32(bytes, d.limitRestitution)
            || !r.readBodyId(bytes, d.proxyBodyId)
            || !r.readF32(bytes, d.screwPitch)
            || !r.readU8(bytes, d.limitDofMask)
            || !r.readU8(bytes, d.driveDofMask)
            || !r.readVec4F(bytes, d.driveStiffness3.x, d.driveStiffness3.y, d.driveStiffness3.z, d.driveStiffness3.w)
            || !r.readVec4F(bytes, d.driveDamping3.x, d.driveDamping3.y, d.driveDamping3.z, d.driveDamping3.w)
            || !r.readVec4F(bytes, d.driveMaxForce3.x, d.driveMaxForce3.y, d.driveMaxForce3.z, d.driveMaxForce3.w)
            || !r.readVec4F(bytes, d.armature.x, d.armature.y, d.armature.z, d.armature.w)
            || !r.readB8(bytes, d.useImplicitDrive)
            || !r.readB8(bytes, d.useEllipticConeLimit)
            || !r.readVec4F(bytes, d.driveTargetQuat.x, d.driveTargetQuat.y, d.driveTargetQuat.z, d.driveTargetQuat.w)
            || !r.readB8(bytes, d.useQuatDrive)
            || !r.readF32(bytes, d.breakForce)
            || !r.readF32(bytes, d.breakTorque)
        )
            return false;
        if(jointTypeByte >= cast<u8>(ArticulationJointType::kCount))
            return false;
        if(i > 0u && d.parentIndex >= i)
            return false;
        d.jointType = cast<ArticulationJointType>(jointTypeByte);
    }

    u32 linkStateCnt = 0u;
    if(!r.readCount(bytes, 32u, linkStateCnt) || linkStateCnt != linkDefCnt)
        return false;
    outArt.linkStates.resize(linkStateCnt);
    for(u32 i = 0u; i < linkStateCnt; ++i){
        mut ArticulationLinkState s = outArt.linkStates[i];
        if(
            !r.readVec4F(bytes, s.q3.x, s.q3.y, s.q3.z, s.q3.w)
            || !r.readVec4F(bytes, s.qd3.x, s.qd3.y, s.qd3.z, s.qd3.w)
            || !r.readVec4F(bytes, s.qdd3.x, s.qdd3.y, s.qdd3.z, s.qdd3.w)
            || !r.readVec4F(bytes, s.externalTau3.x, s.externalTau3.y, s.externalTau3.z, s.externalTau3.w)
            || !r.readVec4F(bytes, s.jointRotation.x, s.jointRotation.y, s.jointRotation.z, s.jointRotation.w)
            || !r.readVec4F(bytes, s.measuredJointTorque3.x, s.measuredJointTorque3.y, s.measuredJointTorque3.z, s.measuredJointTorque3.w)
            || !SnapReadSpatialVec(bytes, r, s.measuredReactionForce)
            || !r.readTransform3D(bytes, s.worldTransform)
            || !SnapReadSpatialVec(bytes, r, s.spatialVelocity)
            || !SnapReadSpatialVec(bytes, r, s.externalForce)
            || !r.readB8(bytes, s.jointBroken)
        )
            return false;
    }

    if(
        !r.readTransform3D(bytes, outArt.baseTransform)
        || !SnapReadSpatialVec(bytes, r, outArt.baseVelocity)
        || !r.readB8(bytes, outArt.fixedBase)
        || !r.readU32(bytes, outArt.subSteps)
        || !r.readU32(bytes, outArt.solverIterations)
        || !r.readB8(bytes, outArt.enableContactCoupling)
        || !r.readB8(bytes, outArt.overrideContactFriction)
        || !r.readF32(bytes, outArt.contactRestitution)
        || !r.readF32(bytes, outArt.contactFriction)
        || !r.readFilter(bytes, outArt.contactFilter)
    )
        return false;

    u32 mimicCnt = 0u;
    if(!r.readCount(bytes, 16u, mimicCnt))
        return false;
    outArt.mimicConstraints.resize(mimicCnt);
    for(u32 i = 0u; i < mimicCnt; ++i){
        mut ArticulationMimicConstraint mc = outArt.mimicConstraints[i];
        if(
            !r.readU32(bytes, mc.linkIndex)
            || !r.readU32(bytes, mc.dofIndex)
            || !r.readU32(bytes, mc.targetLinkIndex)
            || !r.readU32(bytes, mc.targetDofIndex)
            || !r.readF32(bytes, mc.gearRatio)
            || !r.readF32(bytes, mc.offset)
            || !r.readF32(bytes, mc.compliance)
            || !r.readB8(bytes, mc.enabled)
        )
            return false;
    }

    u32 tendonCnt = 0u;
    if(!r.readCount(bytes, 16u, tendonCnt))
        return false;
    outArt.tendonConstraints.resize(tendonCnt);
    for(u32 i = 0u; i < tendonCnt; ++i){
        mut ArticulationTendonConstraint tc = outArt.tendonConstraints[i];
        u32 lCnt = 0u;
        if(!r.readCount(bytes, 4u, lCnt) || lCnt > 8u)
            return false;
        tc.linkIndices.resize(lCnt);
        for(u32 k = 0u; k < lCnt; ++k){
            if(!r.readU32(bytes, tc.linkIndices[k]))
                return false;
        }
        u32 dCnt = 0u;
        if(!r.readCount(bytes, 4u, dCnt) || dCnt > 8u)
            return false;
        tc.dofIndices.resize(dCnt);
        for(u32 k = 0u; k < dCnt; ++k){
            if(!r.readU32(bytes, tc.dofIndices[k]))
                return false;
        }
        u32 cCnt = 0u;
        if(!r.readCount(bytes, 4u, cCnt) || cCnt > 8u)
            return false;
        tc.coefficients.resize(cCnt);
        for(u32 k = 0u; k < cCnt; ++k){
            if(!r.readF32(bytes, tc.coefficients[k]))
                return false;
        }
        if(
            !r.readF32(bytes, tc.restLength)
            || !r.readF32(bytes, tc.lowerLimit)
            || !r.readF32(bytes, tc.upperLimit)
            || !r.readF32(bytes, tc.compliance)
            || !r.readB8(bytes, tc.isEquality)
            || !r.readB8(bytes, tc.enabled)
        )
            return false;
    }

    u32 spatialCnt = 0u;
    if(!r.readCount(bytes, 16u, spatialCnt))
        return false;
    outArt.spatialTendons.resize(spatialCnt);
    for(u32 i = 0u; i < spatialCnt; ++i){
        mut ArticulationSpatialTendon st = outArt.spatialTendons[i];
        u32 attCnt = 0u;
        if(!r.readCount(bytes, 20u, attCnt) || attCnt > 8u)
            return false;
        st.attachments.resize(attCnt);
        for(u32 k = 0u; k < attCnt; ++k){
            if(
                !r.readU32(bytes, st.attachments[k].linkIndex)
                || !r.readVec4F(bytes, st.attachments[k].localPoint.x, st.attachments[k].localPoint.y, st.attachments[k].localPoint.z, st.attachments[k].localPoint.w)
            )
                return false;
        }
        if(
            !r.readF32(bytes, st.restLength)
            || !r.readF32(bytes, st.lowerLimit)
            || !r.readF32(bytes, st.upperLimit)
            || !r.readF32(bytes, st.stiffness)
            || !r.readF32(bytes, st.damping)
            || !r.readF32(bytes, st.compliance)
            || !r.readB8(bytes, st.isEquality)
            || !r.readB8(bytes, st.enabled)
        )
            return false;
    }

    u32 loopCnt = 0u;
    if(!r.readCount(bytes, 32u, loopCnt))
        return false;
    outArt.loopConstraints.resize(loopCnt);
    for(u32 i = 0u; i < loopCnt; ++i){
        mut ArticulationLoopConstraint lc = outArt.loopConstraints[i];
        if(
            !r.readU32(bytes, lc.linkIndexA)
            || !r.readU32(bytes, lc.linkIndexB)
            || !r.readVec4F(bytes, lc.localAnchorA.x, lc.localAnchorA.y, lc.localAnchorA.z, lc.localAnchorA.w)
            || !r.readVec4F(bytes, lc.localAnchorB.x, lc.localAnchorB.y, lc.localAnchorB.z, lc.localAnchorB.w)
            || !r.readB8(bytes, lc.lockOrientation)
            || !r.readVec4F(bytes, lc.relOrientation.x, lc.relOrientation.y, lc.relOrientation.z, lc.relOrientation.w)
            || !r.readF32(bytes, lc.compliance)
            || !r.readB8(bytes, lc.enabled)
        )
            return false;
    }

    u32 rbcCnt = 0u;
    if(!r.readCount(bytes, 48u, rbcCnt))
        return false;
    outArt.rigidBodyConstraints.resize(rbcCnt);
    for(u32 i = 0u; i < rbcCnt; ++i){
        mut ArticulationRigidBodyConstraint rbc = outArt.rigidBodyConstraints[i];
        if(
            !r.readU32(bytes, rbc.linkIndex)
            || !r.readBodyId(bytes, rbc.bodyId)
            || !r.readVec4F(bytes, rbc.localAnchorLink.x, rbc.localAnchorLink.y, rbc.localAnchorLink.z, rbc.localAnchorLink.w)
            || !r.readVec4F(bytes, rbc.localAnchorBody.x, rbc.localAnchorBody.y, rbc.localAnchorBody.z, rbc.localAnchorBody.w)
            || !r.readB8(bytes, rbc.lockOrientation)
            || !r.readVec4F(bytes, rbc.relOrientation.x, rbc.relOrientation.y, rbc.relOrientation.z, rbc.relOrientation.w)
            || !r.readF32(bytes, rbc.compliance)
            || !r.readB8(bytes, rbc.enabled)
        )
            return false;
    }

    if(
        !r.readB8(bytes, outArt.enableSelfCollision)
        || !r.readF32(bytes, outArt.selfCollisionMargin)
        || !r.readB8(bytes, outArt.enableCcd)
        || !r.readF32(bytes, outArt.ccdMotionThreshold)
        || !r.readB8(bytes, outArt.enableSleep)
        || !r.readB8(bytes, outArt.isSleeping)
        || !r.readF32(bytes, outArt.sleepTimer)
        || !r.readF32(bytes, outArt.sleepLinearThreshold)
        || !r.readF32(bytes, outArt.sleepAngularThreshold)
        || !r.readF32(bytes, outArt.sleepTimeThreshold)
        || !r.readB8(bytes, outArt.enableBreakEvents)
    )
        return false;

    Vector<u64> warmNKeys;
    Vector<f32> warmNVals;
    Vector<u64> warmTKeys;
    Vector<f32x4> warmTVals;
    if(
        !SnapshotReadU64Vec(bytes, r, warmNKeys)
        || !SnapshotReadF32Vec(bytes, r, warmNVals)
        || !SnapshotReadU64Vec(bytes, r, warmTKeys)
        || !SnapshotReadVec4Vec(bytes, r, warmTVals)
    )
        return false;
    if(warmNKeys.size() != warmNVals.size() || warmTKeys.size() != warmTVals.size())
        return false;

    outArt.finalizeSnapshotRestore(
        Span<u64>(warmNKeys),
        Span<f32>(warmNVals),
        Span<u64>(warmTKeys),
        Span<f32x4>(warmTVals)
    );
    return true;
}

b8 SnapWriteRagdollInstance<TSink : ISnapshotSink>(in RagdollInstance rag, mut TSink w){
    if(!w.writeCount(rag.boneBodies.size()))
        return false;
    for(usize i = 0u; i < rag.boneBodies.size(); ++i)
        SnapWriteBodyId(w, rag.boneBodies[i]);
    if(!w.writeCount(rag.joints.size()))
        return false;
    for(usize i = 0u; i < rag.joints.size(); ++i)
        SnapWriteJointId(rag.joints[i], w);
    if(!w.writeCount(rag.boneJointIds.size()))
        return false;
    for(usize i = 0u; i < rag.boneJointIds.size(); ++i)
        SnapWriteJointId(rag.boneJointIds[i], w);
    if(
        !SnapshotWriteU32Vec(w, rag.parentIndices)
        || !SnapshotWriteF32Vec(rag.maxMotorTorques, w)
        || !SnapshotWriteF32Vec(rag.motorHertzes, w)
        || !SnapshotWriteF32Vec(rag.motorDampings, w)
    )
        return false;
    w.writeB8(rag.enableSelfCollision);
    w.writeB8(rag.autoExcludeInitialOverlaps);
    w.writeU8(cast<u8>(rag.mode));
    if(!w.writeCount(rag.disabledSelfCollisionPairs.size()))
        return false;
    for(usize i = 0u; i < rag.disabledSelfCollisionPairs.size(); ++i){
        in RagdollSelfCollisionPair pair = rag.disabledSelfCollisionPairs[i];
        w.writeU32(pair.boneA);
        w.writeU32(pair.boneB);
    }

    if(!w.writeCount(rag.boneJointToBodyOffsets.size()))
        return false;
    for(usize i = 0u; i < rag.boneJointToBodyOffsets.size(); ++i)
        SnapWriteTransform3D(w, rag.boneJointToBodyOffsets[i]);

    if(!SnapWriteArticulation(rag.articulation, w))
        return false;

    const Span<f32> inertias = rag.snapshotBoneMaxInertias();
    if(!w.writeCount(inertias.size()))
        return false;
    w.writeF32Span(inertias);

    const Span<Mat3> localInertias = rag.snapshotBoneLocalInertias();
    if(!w.writeCount(localInertias.size()))
        return false;
    for(usize i = 0u; i < localInertias.size(); ++i)
        SnapWriteMat3(w, localInertias[i]);

    const Span<f32x4> refQuats = rag.snapshotJointRestRefQuats();
    if(!w.writeCount(refQuats.size()))
        return false;
    for(usize i = 0u; i < refQuats.size(); ++i)
        SnapWriteVec4(w, VectorSingle(refQuats[i]));

    w.writeB8(rag.snapshotArticulationKinematic());
    const Span<u8> boneKinMask = rag.snapshotArticulationBoneKinMask();
    if(!w.writeCount(boneKinMask.size()))
        return false;
    w.writeBytes(boneKinMask);
    return true;
}

b8 SnapReadRagdollInstance(in Span<u8> bytes, mut SnapshotByteReader r, mut RagdollInstance outRag){
    u32 bodyCnt = 0u;
    if(!r.readCount(bytes, 8u, bodyCnt))
        return false;
    outRag.boneBodies.resize(bodyCnt);
    for(u32 i = 0u; i < bodyCnt; ++i){
        if(!r.readBodyId(bytes, outRag.boneBodies[i]))
            return false;
    }

    u32 jointCnt = 0u;
    if(!r.readCount(bytes, 8u, jointCnt))
        return false;
    outRag.joints.resize(jointCnt);
    for(u32 i = 0u; i < jointCnt; ++i){
        if(!r.readJointId(bytes, outRag.joints[i]))
            return false;
    }

    u32 boneJointCnt = 0u;
    if(!r.readCount(bytes, 8u, boneJointCnt))
        return false;
    outRag.boneJointIds.resize(boneJointCnt);
    for(u32 i = 0u; i < boneJointCnt; ++i){
        if(!r.readJointId(bytes, outRag.boneJointIds[i]))
            return false;
    }

    u8 modeByte = 0u;
    if(
        !SnapshotReadU32Vec(bytes, r, outRag.parentIndices)
        || !SnapshotReadF32Vec(bytes, r, outRag.maxMotorTorques)
        || !SnapshotReadF32Vec(bytes, r, outRag.motorHertzes)
        || !SnapshotReadF32Vec(bytes, r, outRag.motorDampings)
        || !r.readB8(bytes, outRag.enableSelfCollision)
        || !r.readB8(bytes, outRag.autoExcludeInitialOverlaps)
        || !r.readU8(bytes, modeByte)
    )
        return false;
    if(modeByte >= cast<u8>(RagdollMode::kCount))
        return false;
    outRag.mode = cast<RagdollMode>(modeByte);

    u32 pairCnt = 0u;
    if(!r.readCount(bytes, 8u, pairCnt))
        return false;
    outRag.disabledSelfCollisionPairs.resize(pairCnt);
    for(u32 i = 0u; i < pairCnt; ++i){
        mut RagdollSelfCollisionPair pair = outRag.disabledSelfCollisionPairs[i];
        if(!r.readU32(bytes, pair.boneA) || !r.readU32(bytes, pair.boneB))
            return false;
    }

    u32 offCnt = 0u;
    if(!r.readCount(bytes, 32u, offCnt))
        return false;
    outRag.boneJointToBodyOffsets.resize(offCnt);
    for(u32 i = 0u; i < offCnt; ++i){
        if(!r.readTransform3D(bytes, outRag.boneJointToBodyOffsets[i]))
            return false;
    }

    if(!SnapReadArticulation(bytes, r, outRag.articulation))
        return false;

    Vector<f32> tmpInertias;
    Vector<Mat3> tmpLocalInertias;
    Vector<f32x4> tmpRestQ;
    if(!SnapshotReadF32Vec(bytes, r, tmpInertias))
        return false;
    u32 localInertiaCnt = 0u;
    if(!r.readCount(bytes, 48u, localInertiaCnt))
        return false;
    tmpLocalInertias.resize(localInertiaCnt);
    for(u32 i = 0u; i < localInertiaCnt; ++i){
        if(!r.readMat3(bytes, tmpLocalInertias[i]))
            return false;
    }
    b8 artKin = false;
    Vector<u8> tmpBoneKinMask;
    if(
        !SnapshotReadVec4Vec(bytes, r, tmpRestQ)
        || !r.readB8(bytes, artKin)
        || !SnapshotReadU8Vec(bytes, r, tmpBoneKinMask)
    )
        return false;

    outRag.finalizeSnapshotRestore(
        Span<f32>(tmpInertias),
        Span<Mat3>(tmpLocalInertias),
        Span<f32x4>(tmpRestQ),
        artKin,
        Span<u8>(tmpBoneKinMask)
    );
    return true;
}

b8 SnapWriteCharacterController<TSink : ISnapshotSink>(in CharacterController ch, mut TSink w){
    in CharacterControllerDef def = ch.def;
    w.writeF32(def.radius);
    w.writeF32(def.halfHeight);
    w.writeF32(def.skinWidth);
    w.writeF32(def.maxSlopeAngleRad);
    w.writeF32(def.stepUpHeight);
    w.writeF32(def.stepDownHeight);
    w.writeF32(def.maxStrength);
    w.writeF32(def.mass);
    w.writeF32(def.predictiveContactDistance);
    w.writeU32(def.maxCollisionIterations);
    w.writeU32(def.maxConstraintIterations);
    w.writeU8(cast<u8>(def.shapeType));
    SnapWriteVec4(w, VectorSingle(def.boxHalfExtents));
    SnapWriteFilter(w, def.filter);
    SnapWriteBodyId(w, def.ignoreBodyId);
    SnapWriteShapeId(w, def.ignoreShapeId);
    w.writeB8(def.hitSensors);
    w.writeB8(def.stickToFloor);
    w.writeB8(def.pushDynamicBodies);
    w.writeB8(def.applyStandingWeight);
    w.writeB8(def.followPlatformPitchRoll);
    w.writeB8(def.enableGravityAndSlopeSlide);
    w.writeF32(def.gravityScale);
    w.writeF32(def.slopeSlideAcceleration);
    w.writeB8(def.inheritPlatformVelocity);
    SnapWriteVec4(w, VectorSingle(def.up));
    SnapWriteHullGeometryId(w, def.customHullGeometryId);
    SnapWriteCompoundGeometryId(w, def.customCompoundGeometryId);
    SnapWriteVec4(w, VectorSingle(def.customShapeScale));
    w.writeB8(def.enableGroundFriction);
    w.writeF32(def.characterFriction);
    w.writeF32(def.characterRestitution);
    w.writeB8(def.enableRotationalSweep);

    SnapWriteVec4(w, VectorSingle(ch.position));
    SnapWriteVec4(w, VectorSingle(ch.rotation));
    SnapWriteVec4(w, VectorSingle(ch.linearVelocity));
    SnapWriteVec4(w, VectorSingle(ch.angularVelocity));
    SnapWriteVec4(w, VectorSingle(ch.groundNormal));
    SnapWriteVec4(w, VectorSingle(ch.groundVelocity));
    SnapWriteVec4(w, VectorSingle(ch.groundPoint));
    w.writeU8(cast<u8>(ch.groundState));
    SnapWriteBodyId(w, ch.groundBodyId);
    SnapWriteShapeId(w, ch.groundShapeId);
    w.writeU32(ch.groundTriangleIndex);
    w.writeU32(ch.groundSubShapeIndex);
    SnapWriteSurfaceMaterial(w, ch.groundMaterial);
    w.writeB8(ch.hitCeiling);
    w.writeB8(ch.isCrushed);
    SnapWriteVec4(w, VectorSingle(ch.platformInheritedVelocity));
    SnapWriteTransform3D(w, ch.prevGroundTransform);
    w.writeB8(ch.hasPrevGroundTransform);

    if(!w.writeCount(ch.activeContacts.size()))
        return false;
    for(usize i = 0u; i < ch.activeContacts.size(); ++i){
        in CharacterContactInfo ci = ch.activeContacts[i];
        SnapWriteShapeId(w, ci.shapeId);
        w.writeU32(ci.triangleIndex);
        SnapWriteBodyId(w, ci.bodyId);
        SnapWriteVec4(w, VectorSingle(ci.point));
        SnapWriteVec4(w, VectorSingle(ci.normal));
        w.writeF32(ci.penetrationDepth);
        w.writeB8(ci.isWalkable);
    }

    SnapWriteVec4(w, ch.snapshotGroundConveyorVelocity());
    SnapWriteVec4(w, ch.snapshotPrevProxyRotation());
    w.writeB8(ch.snapshotHasPrevProxyRotation());
    return true;
}

b8 SnapReadCharacterController(in Span<u8> bytes, mut SnapshotByteReader r, mut CharacterController outCh){
    mut CharacterControllerDef def = outCh.def;
    u8 shapeTypeByte = 0u;
    if(
        !r.readF32(bytes, def.radius)
        || !r.readF32(bytes, def.halfHeight)
        || !r.readF32(bytes, def.skinWidth)
        || !r.readF32(bytes, def.maxSlopeAngleRad)
        || !r.readF32(bytes, def.stepUpHeight)
        || !r.readF32(bytes, def.stepDownHeight)
        || !r.readF32(bytes, def.maxStrength)
        || !r.readF32(bytes, def.mass)
        || !r.readF32(bytes, def.predictiveContactDistance)
        || !r.readU32(bytes, def.maxCollisionIterations)
        || !r.readU32(bytes, def.maxConstraintIterations)
        || !r.readU8(bytes, shapeTypeByte)
        || !r.readVec4F(bytes, def.boxHalfExtents.x, def.boxHalfExtents.y, def.boxHalfExtents.z, def.boxHalfExtents.w)
        || !r.readFilter(bytes, def.filter)
        || !r.readBodyId(bytes, def.ignoreBodyId)
        || !r.readShapeId(bytes, def.ignoreShapeId)
        || !r.readB8(bytes, def.hitSensors)
        || !r.readB8(bytes, def.stickToFloor)
        || !r.readB8(bytes, def.pushDynamicBodies)
        || !r.readB8(bytes, def.applyStandingWeight)
        || !r.readB8(bytes, def.followPlatformPitchRoll)
        || !r.readB8(bytes, def.enableGravityAndSlopeSlide)
        || !r.readF32(bytes, def.gravityScale)
        || !r.readF32(bytes, def.slopeSlideAcceleration)
        || !r.readB8(bytes, def.inheritPlatformVelocity)
        || !r.readVec4F(bytes, def.up.x, def.up.y, def.up.z, def.up.w)
        || !r.readHullGeometryId(bytes, def.customHullGeometryId)
        || !r.readCompoundGeometryId(bytes, def.customCompoundGeometryId)
        || !r.readVec4F(bytes, def.customShapeScale.x, def.customShapeScale.y, def.customShapeScale.z, def.customShapeScale.w)
        || !r.readB8(bytes, def.enableGroundFriction)
        || !r.readF32(bytes, def.characterFriction)
        || !r.readF32(bytes, def.characterRestitution)
        || !r.readB8(bytes, def.enableRotationalSweep)
    )
        return false;
    if(shapeTypeByte >= cast<u8>(CharacterShapeType::kCount))
        return false;
    def.shapeType = cast<CharacterShapeType>(shapeTypeByte);

    u8 groundStateByte = 0u;
    if(
        !r.readVec4F(bytes, outCh.position.x, outCh.position.y, outCh.position.z, outCh.position.w)
        || !r.readVec4F(bytes, outCh.rotation.x, outCh.rotation.y, outCh.rotation.z, outCh.rotation.w)
        || !r.readVec4F(bytes, outCh.linearVelocity.x, outCh.linearVelocity.y, outCh.linearVelocity.z, outCh.linearVelocity.w)
        || !r.readVec4F(bytes, outCh.angularVelocity.x, outCh.angularVelocity.y, outCh.angularVelocity.z, outCh.angularVelocity.w)
        || !r.readVec4F(bytes, outCh.groundNormal.x, outCh.groundNormal.y, outCh.groundNormal.z, outCh.groundNormal.w)
        || !r.readVec4F(bytes, outCh.groundVelocity.x, outCh.groundVelocity.y, outCh.groundVelocity.z, outCh.groundVelocity.w)
        || !r.readVec4F(bytes, outCh.groundPoint.x, outCh.groundPoint.y, outCh.groundPoint.z, outCh.groundPoint.w)
        || !r.readU8(bytes, groundStateByte)
        || !r.readBodyId(bytes, outCh.groundBodyId)
        || !r.readShapeId(bytes, outCh.groundShapeId)
        || !r.readU32(bytes, outCh.groundTriangleIndex)
        || !r.readU32(bytes, outCh.groundSubShapeIndex)
        || !r.readSurfaceMaterial(bytes, outCh.groundMaterial)
        || !r.readB8(bytes, outCh.hitCeiling)
        || !r.readB8(bytes, outCh.isCrushed)
        || !r.readVec4F(bytes, outCh.platformInheritedVelocity.x, outCh.platformInheritedVelocity.y, outCh.platformInheritedVelocity.z, outCh.platformInheritedVelocity.w)
        || !r.readTransform3D(bytes, outCh.prevGroundTransform)
        || !r.readB8(bytes, outCh.hasPrevGroundTransform)
    )
        return false;
    if(groundStateByte > cast<u8>(CharacterGroundState::InAir))
        return false;
    outCh.groundState = cast<CharacterGroundState>(groundStateByte);

    u32 contactCnt = 0u;
    if(!r.readCount(bytes, 32u, contactCnt))
        return false;
    outCh.activeContacts.resize(contactCnt);
    for(u32 i = 0u; i < contactCnt; ++i){
        mut CharacterContactInfo ci = outCh.activeContacts[i];
        if(
            !r.readShapeId(bytes, ci.shapeId)
            || !r.readU32(bytes, ci.triangleIndex)
            || !r.readBodyId(bytes, ci.bodyId)
            || !r.readVec4F(bytes, ci.point.x, ci.point.y, ci.point.z, ci.point.w)
            || !r.readVec4F(bytes, ci.normal.x, ci.normal.y, ci.normal.z, ci.normal.w)
            || !r.readF32(bytes, ci.penetrationDepth)
            || !r.readB8(bytes, ci.isWalkable)
        )
            return false;
    }

    f32 gcx = 0.0f;
    f32 gcy = 0.0f;
    f32 gcz = 0.0f;
    f32 gcw = 0.0f;
    f32 prx = 0.0f;
    f32 pry = 0.0f;
    f32 prz = 0.0f;
    f32 prw = 1.0f;
    b8 hasPrevProxyRot = false;
    if(
        !r.readVec4F(bytes, gcx, gcy, gcz, gcw)
        || !r.readVec4F(bytes, prx, pry, prz, prw)
        || !r.readB8(bytes, hasPrevProxyRot)
    )
        return false;
    outCh.finalizeSnapshotRestore(VectorSingle(gcx, gcy, gcz, gcw), VectorSingle(prx, pry, prz, prw), hasPrevProxyRot);
    return true;
}

b8 SnapWriteBodyIdVec<TSink : ISnapshotSink>(in Vector<BodyId> v, mut TSink w){
    if(!w.writeCount(v.size()))
        return false;
    for(usize i = 0u; i < v.size(); ++i)
        SnapWriteBodyId(w, v[i]);
    return true;
}

b8 SnapReadBodyIdVec(in Span<u8> bytes, mut SnapshotByteReader r, mut Vector<BodyId> outV){
    u32 cnt = 0u;
    if(!r.readCount(bytes, 8u, cnt))
        return false;
    outV.resize(cnt);
    for(u32 i = 0u; i < cnt; ++i){
        if(!r.readBodyId(bytes, outV[i]))
            return false;
    }
    return true;
}

b8 SnapWriteShapeIdVec<TSink : ISnapshotSink>(in Vector<ShapeId> v, mut TSink w){
    if(!w.writeCount(v.size()))
        return false;
    for(usize i = 0u; i < v.size(); ++i)
        SnapWriteShapeId(w, v[i]);
    return true;
}

b8 SnapReadShapeIdVec(in Span<u8> bytes, mut SnapshotByteReader r, mut Vector<ShapeId> outV){
    u32 cnt = 0u;
    if(!r.readCount(bytes, 8u, cnt))
        return false;
    outV.resize(cnt);
    for(u32 i = 0u; i < cnt; ++i){
        if(!r.readShapeId(bytes, outV[i]))
            return false;
    }
    return true;
}

b8 SnapWriteFractureChunkSpec<TSink : ISnapshotSink>(in FractureChunkSpec ch, mut TSink w){
    if(!SnapWriteHullShape(ch.hull, w))
        return false;
    SnapWriteVec4(w, VectorSingle(ch.localCentroid));
    SnapWriteVec4(w, VectorSingle(ch.localAabbMin));
    SnapWriteVec4(w, VectorSingle(ch.localAabbMax));
    w.writeF32(ch.volume);
    w.writeF32(ch.massFraction);
    w.writeU32(ch.cellIndex);
    return true;
}

b8 SnapReadFractureChunkSpec(in Span<u8> bytes, mut SnapshotByteReader r, mut FractureChunkSpec outCh){
    return
        SnapReadHullShape(bytes, r, outCh.hull)
        && r.readVec4F(bytes, outCh.localCentroid.x, outCh.localCentroid.y, outCh.localCentroid.z, outCh.localCentroid.w)
        && r.readVec4F(bytes, outCh.localAabbMin.x, outCh.localAabbMin.y, outCh.localAabbMin.z, outCh.localAabbMin.w)
        && r.readVec4F(bytes, outCh.localAabbMax.x, outCh.localAabbMax.y, outCh.localAabbMax.z, outCh.localAabbMax.w)
        && r.readF32(bytes, outCh.volume)
        && r.readF32(bytes, outCh.massFraction)
        && r.readU32(bytes, outCh.cellIndex)
    ;
}

b8 SnapWriteFractureClusterBody<TSink : ISnapshotSink>(in FractureClusterBody fc, mut TSink w){
    SnapWriteBodyId(w, fc.rootBodyId);
    SnapWriteShapeId(w, fc.rootShapeId);

    if(!w.writeCount(fc.chunks.size()))
        return false;
    for(usize i = 0u; i < fc.chunks.size(); ++i){
        if(!SnapWriteFractureChunkSpec(fc.chunks[i], w))
            return false;
    }

    if(!SnapshotWriteU8Vec(w, fc.chunkActive) || !SnapshotWriteU8Vec(w, fc.chunkAnchored))
        return false;

    if(!w.writeCount(fc.bonds.size()))
        return false;
    for(usize i = 0u; i < fc.bonds.size(); ++i){
        in FractureClusterBond b = fc.bonds[i];
        w.writeU32(b.chunkA);
        w.writeU32(b.chunkB);
        SnapWriteVec4(w, VectorSingle(b.localAnchor));
        w.writeF32(b.sharedArea);
        w.writeF32(b.strength);
        w.writeF32(b.accumulatedStress);
        w.writeB8(b.broken);
    }

    if(
        !SnapWriteBodyIdVec(fc.anchoredBodies, w)
        || !SnapWriteShapeIdVec(fc.anchoredShapes, w)
        || !SnapWriteBodyIdVec(fc.detachedBodies, w)
        || !SnapWriteShapeIdVec(fc.detachedShapes, w)
    )
        return false;

    if(!w.writeCount(fc.subClusters.size()))
        return false;
    for(usize i = 0u; i < fc.subClusters.size(); ++i){
        in FractureSubCluster sc = fc.subClusters[i];
        SnapWriteBodyId(w, sc.bodyId);
        SnapWriteShapeId(w, sc.shapeId);
        if(!SnapshotWriteU32Vec(w, sc.chunkIndices))
            return false;
        w.writeB8(sc.isAnchored);
    }

    SnapWriteTransform3D(w, fc.initialWorldTransform);
    SnapWriteFilter(w, fc.collisionFilter);
    SnapWriteSurfaceMaterial(w, fc.material);
    w.writeF32(fc.totalMass);
    w.writeF32(fc.stressPropagationDecay);
    w.writeF32(fc.gravityStressScale);
    w.writeF32(fc.compressionStrengthMultiplier);
    w.writeF32(fc.outwardBurstScale);

    const Span<HullGeometryId> cachedHulls = fc.snapshotCachedChunkHullIds();
    if(!w.writeCount(cachedHulls.size()))
        return false;
    for(usize i = 0u; i < cachedHulls.size(); ++i)
        SnapWriteHullGeometryId(w, cachedHulls[i]);
    return true;
}

b8 SnapReadFractureClusterBody(in Span<u8> bytes, mut SnapshotByteReader r, mut FractureClusterBody outFc){
    if(!r.readBodyId(bytes, outFc.rootBodyId) || !r.readShapeId(bytes, outFc.rootShapeId))
        return false;

    u32 chunkCnt = 0u;
    if(!r.readCount(bytes, 32u, chunkCnt))
        return false;
    outFc.chunks.resize(chunkCnt);
    for(u32 i = 0u; i < chunkCnt; ++i){
        if(!SnapReadFractureChunkSpec(bytes, r, outFc.chunks[i]))
            return false;
    }

    if(!SnapshotReadU8Vec(bytes, r, outFc.chunkActive) || !SnapshotReadU8Vec(bytes, r, outFc.chunkAnchored))
        return false;

    u32 bondCnt = 0u;
    if(!r.readCount(bytes, 32u, bondCnt))
        return false;
    outFc.bonds.resize(bondCnt);
    for(u32 i = 0u; i < bondCnt; ++i){
        mut FractureClusterBond b = outFc.bonds[i];
        if(
            !r.readU32(bytes, b.chunkA)
            || !r.readU32(bytes, b.chunkB)
            || !r.readVec4F(bytes, b.localAnchor.x, b.localAnchor.y, b.localAnchor.z, b.localAnchor.w)
            || !r.readF32(bytes, b.sharedArea)
            || !r.readF32(bytes, b.strength)
            || !r.readF32(bytes, b.accumulatedStress)
            || !r.readB8(bytes, b.broken)
        )
            return false;
    }

    if(
        !SnapReadBodyIdVec(bytes, r, outFc.anchoredBodies)
        || !SnapReadShapeIdVec(bytes, r, outFc.anchoredShapes)
        || !SnapReadBodyIdVec(bytes, r, outFc.detachedBodies)
        || !SnapReadShapeIdVec(bytes, r, outFc.detachedShapes)
    )
        return false;

    u32 subCnt = 0u;
    if(!r.readCount(bytes, 20u, subCnt))
        return false;
    outFc.subClusters.resize(subCnt);
    for(u32 i = 0u; i < subCnt; ++i){
        mut FractureSubCluster sc = outFc.subClusters[i];
        if(
            !r.readBodyId(bytes, sc.bodyId)
            || !r.readShapeId(bytes, sc.shapeId)
            || !SnapshotReadU32Vec(bytes, r, sc.chunkIndices)
            || !r.readB8(bytes, sc.isAnchored)
        )
            return false;
    }

    if(
        !r.readTransform3D(bytes, outFc.initialWorldTransform)
        || !r.readFilter(bytes, outFc.collisionFilter)
        || !r.readSurfaceMaterial(bytes, outFc.material)
        || !r.readF32(bytes, outFc.totalMass)
        || !r.readF32(bytes, outFc.stressPropagationDecay)
        || !r.readF32(bytes, outFc.gravityStressScale)
        || !r.readF32(bytes, outFc.compressionStrengthMultiplier)
        || !r.readF32(bytes, outFc.outwardBurstScale)
    )
        return false;

    u32 cachedHullCnt = 0u;
    if(!r.readCount(bytes, 8u, cachedHullCnt))
        return false;
    Vector<HullGeometryId> tmpCachedHulls;
    tmpCachedHulls.resize(cachedHullCnt);
    for(u32 i = 0u; i < cachedHullCnt; ++i){
        if(!r.readHullGeometryId(bytes, tmpCachedHulls[i]))
            return false;
    }

    outFc.finalizeSnapshotRestore(Span<HullGeometryId>(tmpCachedHulls));
    return true;
}

b8 SnapWriteFractureBondGraph<TSink : ISnapshotSink>(in FractureBondGraph bg, mut TSink w){
    if(!SnapWriteBodyIdVec(bg.chunkBodies, w))
        return false;
    if(!w.writeCount(bg.bonds.size()))
        return false;
    for(usize i = 0u; i < bg.bonds.size(); ++i){
        in FractureBond b = bg.bonds[i];
        w.writeU32(b.chunkA);
        w.writeU32(b.chunkB);
        SnapWriteJointId(b.jointId, w);
        SnapWriteVec4(w, VectorSingle(b.worldAnchor));
        SnapWriteVec4(w, VectorSingle(b.localAnchorA));
        SnapWriteVec4(w, VectorSingle(b.localAnchorB));
        w.writeF32(b.health);
        w.writeF32(b.maxHealth);
        w.writeF32(b.sharedArea);
        w.writeB8(b.broken);
    }
    return true;
}

b8 SnapReadFractureBondGraph(in Span<u8> bytes, mut SnapshotByteReader r, mut FractureBondGraph outBg){
    if(!SnapReadBodyIdVec(bytes, r, outBg.chunkBodies))
        return false;
    u32 bondCnt = 0u;
    if(!r.readCount(bytes, 48u, bondCnt))
        return false;
    outBg.bonds.resize(bondCnt);
    for(u32 i = 0u; i < bondCnt; ++i){
        mut FractureBond b = outBg.bonds[i];
        if(
            !r.readU32(bytes, b.chunkA)
            || !r.readU32(bytes, b.chunkB)
            || !r.readJointId(bytes, b.jointId)
            || !r.readVec4F(bytes, b.worldAnchor.x, b.worldAnchor.y, b.worldAnchor.z, b.worldAnchor.w)
            || !r.readVec4F(bytes, b.localAnchorA.x, b.localAnchorA.y, b.localAnchorA.z, b.localAnchorA.w)
            || !r.readVec4F(bytes, b.localAnchorB.x, b.localAnchorB.y, b.localAnchorB.z, b.localAnchorB.w)
            || !r.readF32(bytes, b.health)
            || !r.readF32(bytes, b.maxHealth)
            || !r.readF32(bytes, b.sharedArea)
            || !r.readB8(bytes, b.broken)
        )
            return false;
    }
    return true;
}

b8 SnapWriteFractureCollection<TSink : ISnapshotSink>(in FractureCollection col, mut TSink w){
    w.writeF32(col.totalVolume);
    if(!w.writeCount(col.nodes.size()))
        return false;
    for(usize i = 0u; i < col.nodes.size(); ++i){
        in FractureCollectionNode node = col.nodes[i];
        w.writeU32(node.parentIndex);
        w.writeU32(node.level);
        if(!SnapWriteFractureChunkSpec(node.chunk, w))
            return false;
        if(!SnapshotWriteU32Vec(w, node.childIndices))
            return false;
        w.writeB8(node.isLeaf);
    }
    if(!w.writeCount(col.leafNeighborPairs.size()))
        return false;
    for(usize i = 0u; i < col.leafNeighborPairs.size(); ++i){
        in FractureNeighborPair pair = col.leafNeighborPairs[i];
        w.writeU32(pair.chunkA);
        w.writeU32(pair.chunkB);
        w.writeF32(pair.sharedArea);
        SnapWriteVec4(w, VectorSingle(pair.localSharedCentroid));
    }
    return true;
}

b8 SnapReadFractureCollection(in Span<u8> bytes, mut SnapshotByteReader r, mut FractureCollection outCol){
    if(!r.readF32(bytes, outCol.totalVolume))
        return false;
    u32 nodeCnt = 0u;
    if(!r.readCount(bytes, 32u, nodeCnt))
        return false;
    outCol.nodes.resize(nodeCnt);
    for(u32 i = 0u; i < nodeCnt; ++i){
        mut FractureCollectionNode node = outCol.nodes[i];
        if(
            !r.readU32(bytes, node.parentIndex)
            || !r.readU32(bytes, node.level)
            || !SnapReadFractureChunkSpec(bytes, r, node.chunk)
            || !SnapshotReadU32Vec(bytes, r, node.childIndices)
            || !r.readB8(bytes, node.isLeaf)
        )
            return false;
    }
    u32 pairCnt = 0u;
    if(!r.readCount(bytes, 28u, pairCnt))
        return false;
    outCol.leafNeighborPairs.resize(pairCnt);
    for(u32 i = 0u; i < pairCnt; ++i){
        mut FractureNeighborPair pair = outCol.leafNeighborPairs[i];
        if(
            !r.readU32(bytes, pair.chunkA)
            || !r.readU32(bytes, pair.chunkB)
            || !r.readF32(bytes, pair.sharedArea)
            || !r.readVec4F(bytes, pair.localSharedCentroid.x, pair.localSharedCentroid.y, pair.localSharedCentroid.z, pair.localSharedCentroid.w)
        )
            return false;
    }
    return true;
}

usize EstimatePhysicsSubsystemsSnapshotSize(in PhysicsSubsystemsBundle bundle){
    usize est = 64u + bundle.environment.activeImmersions().size() * 52u;
    for(usize i = 0u; i < bundle.environment.fluids.size(); ++i){
        in FluidVolume fv = bundle.environment.fluids[i];
        est += 300u + fv.hullVertices.size() * 16u + fv.hullPlanes.size() * 16u + fv.meshVertices.size() * 16u + fv.meshIndices.size() * 4u + fv.riverPoints.size() * 16u + fv.gerstnerWaves.size() * 32u + fv.waveHeights.size() * 4u + fv.waveVelocities.size() * 4u;
    }
    for(usize i = 0u; i < bundle.environment.forceFields.size(); ++i){
        in ForceField ff = bundle.environment.forceFields[i];
        est += 240u + ff.vectorFieldSamples.size() * 16u;
    }
    for(usize i = 0u; i < bundle.softBodies.size(); ++i){
        in SoftBody sb = bundle.softBodies[i];
        est += 288u + sb.particles.size() * 72u + sb.distanceConstraints.size() * 20u + sb.bendingConstraints.size() * 20u;
        est += sb.dihedralBendingConstraints.size() * 28u + sb.volumeConstraints.size() * 100u + sb.surfaceTriangles.size() * 12u;
        est += sb.anisotropicConstraints.size() * 64u + sb.tetherConstraints.size() * 20u + sb.cageBinding.bindings.size() * 20u;
        est += sb.attachments.size() * 32u + sb.backstopConstraints.size() * 44u + sb.goalConstraints.size() * 28u + sb.restLocalPositions.size() * 16u + sb.particleSourceIndices.size() * 4u;
    }
    for(usize i = 0u; i < bundle.vehicles.size(); ++i){
        in VehicleController veh = bundle.vehicles[i];
        est += 420u + veh.wheelDefs.size() * 240u + veh.wheelStates.size() * 240u;
    }
    for(usize i = 0u; i < bundle.ragdolls.size(); ++i){
        in RagdollInstance rag = bundle.ragdolls[i];
        est += 144u + rag.boneBodies.size() * 112u + rag.joints.size() * 8u + rag.boneJointIds.size() * 8u + rag.disabledSelfCollisionPairs.size() * 8u + rag.boneJointToBodyOffsets.size() * 32u + rag.articulation.linkDefs.size() * 368u + rag.articulation.rigidBodyConstraints.size() * 68u;
    }
    for(usize i = 0u; i < bundle.characters.size(); ++i){
        in CharacterController ch = bundle.characters[i];
        est += 520u + ch.activeContacts.size() * 64u;
    }
    for(usize i = 0u; i < bundle.articulations.size(); ++i){
        in Articulation art = bundle.articulations[i];
        est += 320u + art.linkDefs.size() * 368u + art.linkStates.size() * 264u;
        est += art.mimicConstraints.size() * 32u + art.tendonConstraints.size() * 128u + art.spatialTendons.size() * 196u + art.loopConstraints.size() * 64u + art.rigidBodyConstraints.size() * 68u;
    }
    for(usize i = 0u; i < bundle.fractureClusters.size(); ++i){
        in FractureClusterBody fc = bundle.fractureClusters[i];
        est += 224u + fc.chunks.size() * 256u + fc.bonds.size() * 36u + fc.anchoredBodies.size() * 8u + fc.anchoredShapes.size() * 8u + fc.detachedBodies.size() * 8u + fc.detachedShapes.size() * 8u + fc.subClusters.size() * 32u;
    }
    for(usize i = 0u; i < bundle.fractureBondGraphs.size(); ++i){
        in FractureBondGraph bg = bundle.fractureBondGraphs[i];
        est += 64u + bg.chunkBodies.size() * 8u + bg.bonds.size() * 80u;
    }
    for(usize i = 0u; i < bundle.fractureCollections.size(); ++i){
        in FractureCollection col = bundle.fractureCollections[i];
        est += 64u + col.nodes.size() * 272u + col.leafNeighborPairs.size() * 28u;
    }
    return est;
}

b8 SerializePhysicsSubsystemsPayload<TSink : ISnapshotSink>(in PhysicsSubsystemsBundle bundle, mut TSink w){
    w.writeU32(s_SubsystemsSnapshotMagic);
    w.writeU32(s_SubsystemsSnapshotVersion);

    if(!SnapWritePhysicsEnvironment(bundle.environment, w))
        return false;

    if(!w.writeCount(bundle.softBodies.size()))
        return false;
    for(usize i = 0u; i < bundle.softBodies.size(); ++i){
        if(!SnapWriteSoftBody(bundle.softBodies[i], w))
            return false;
    }

    if(!w.writeCount(bundle.vehicles.size()))
        return false;
    for(usize i = 0u; i < bundle.vehicles.size(); ++i){
        if(!SnapWriteVehicleController(bundle.vehicles[i], w))
            return false;
    }

    if(!w.writeCount(bundle.ragdolls.size()))
        return false;
    for(usize i = 0u; i < bundle.ragdolls.size(); ++i){
        if(!SnapWriteRagdollInstance(bundle.ragdolls[i], w))
            return false;
    }

    if(!w.writeCount(bundle.characters.size()))
        return false;
    for(usize i = 0u; i < bundle.characters.size(); ++i){
        if(!SnapWriteCharacterController(bundle.characters[i], w))
            return false;
    }

    if(!w.writeCount(bundle.articulations.size()))
        return false;
    for(usize i = 0u; i < bundle.articulations.size(); ++i){
        if(!SnapWriteArticulation(bundle.articulations[i], w))
            return false;
    }

    if(!w.writeCount(bundle.fractureClusters.size()))
        return false;
    for(usize i = 0u; i < bundle.fractureClusters.size(); ++i){
        if(!SnapWriteFractureClusterBody(bundle.fractureClusters[i], w))
            return false;
    }

    if(!w.writeCount(bundle.fractureBondGraphs.size()))
        return false;
    for(usize i = 0u; i < bundle.fractureBondGraphs.size(); ++i){
        if(!SnapWriteFractureBondGraph(bundle.fractureBondGraphs[i], w))
            return false;
    }

    if(!w.writeCount(bundle.fractureCollections.size()))
        return false;
    for(usize i = 0u; i < bundle.fractureCollections.size(); ++i){
        if(!SnapWriteFractureCollection(bundle.fractureCollections[i], w))
            return false;
    }
    return true;
}

b8 ReadPhysicsSubsystemsPayload(in Span<u8> bytes, mut SnapshotByteReader r, mut PhysicsSubsystemsBundle outTmp){
    u32 magic = 0u;
    u32 version = 0u;
    if(!r.readU32(bytes, magic) || !r.readU32(bytes, version))
        return false;
    if(magic != s_SubsystemsSnapshotMagic || version != s_SubsystemsSnapshotVersion)
        return false;

    outTmp.clear();
    if(!SnapReadPhysicsEnvironment(bytes, r, outTmp.environment))
        return false;

    u32 sbCount = 0u;
    if(!r.readCount(bytes, 32u, sbCount))
        return false;
    outTmp.softBodies.resize(sbCount);
    for(u32 i = 0u; i < sbCount; ++i){
        if(!SnapReadSoftBody(bytes, r, outTmp.softBodies[i]))
            return false;
    }

    u32 vehCount = 0u;
    if(!r.readCount(bytes, 32u, vehCount))
        return false;
    outTmp.vehicles.resize(vehCount);
    for(u32 i = 0u; i < vehCount; ++i){
        if(!SnapReadVehicleController(bytes, r, outTmp.vehicles[i]))
            return false;
    }

    u32 ragCount = 0u;
    if(!r.readCount(bytes, 16u, ragCount))
        return false;
    outTmp.ragdolls.resize(ragCount);
    for(u32 i = 0u; i < ragCount; ++i){
        if(!SnapReadRagdollInstance(bytes, r, outTmp.ragdolls[i]))
            return false;
    }

    u32 chCount = 0u;
    if(!r.readCount(bytes, 64u, chCount))
        return false;
    outTmp.characters.resize(chCount);
    for(u32 i = 0u; i < chCount; ++i){
        if(!SnapReadCharacterController(bytes, r, outTmp.characters[i]))
            return false;
    }

    u32 artCount = 0u;
    if(!r.readCount(bytes, 32u, artCount))
        return false;
    outTmp.articulations.resize(artCount);
    for(u32 i = 0u; i < artCount; ++i){
        if(!SnapReadArticulation(bytes, r, outTmp.articulations[i]))
            return false;
    }

    u32 fcCount = 0u;
    if(!r.readCount(bytes, 32u, fcCount))
        return false;
    outTmp.fractureClusters.resize(fcCount);
    for(u32 i = 0u; i < fcCount; ++i){
        if(!SnapReadFractureClusterBody(bytes, r, outTmp.fractureClusters[i]))
            return false;
    }

    u32 bgCount = 0u;
    if(!r.readCount(bytes, 8u, bgCount))
        return false;
    outTmp.fractureBondGraphs.resize(bgCount);
    for(u32 i = 0u; i < bgCount; ++i){
        if(!SnapReadFractureBondGraph(bytes, r, outTmp.fractureBondGraphs[i]))
            return false;
    }

    u32 colCount = 0u;
    if(!r.readCount(bytes, 12u, colCount))
        return false;
    outTmp.fractureCollections.resize(colCount);
    for(u32 i = 0u; i < colCount; ++i){
        if(!SnapReadFractureCollection(bytes, r, outTmp.fractureCollections[i]))
            return false;
    }
    return true;
}

void SnapRemapBodyId(in u16 targetWorldIndex, mut BodyId id){
    if(id.valid())
        id.worldIndex = targetWorldIndex;
}

void SnapRemapShapeId(in u16 targetWorldIndex, mut ShapeId id){
    if(id.valid())
        id.worldIndex = targetWorldIndex;
}

void SnapRemapJointId(in u16 targetWorldIndex, mut JointId id){
    if(id.valid())
        id.worldIndex = targetWorldIndex;
}

void SnapRemapHullGeometryId(in u16 targetWorldIndex, mut HullGeometryId id){
    if(id.valid())
        id.worldIndex = targetWorldIndex;
}

void SnapRemapCompoundGeometryId(in u16 targetWorldIndex, mut CompoundGeometryId id){
    if(id.valid())
        id.worldIndex = targetWorldIndex;
}

void RemapArticulationWorldIndex(in u16 targetWorldIndex, mut Articulation art){
    for(usize i = 0u; i < art.linkDefs.size(); ++i)
        SnapRemapBodyId(targetWorldIndex, art.linkDefs[i].proxyBodyId);
    for(usize i = 0u; i < art.rigidBodyConstraints.size(); ++i)
        SnapRemapBodyId(targetWorldIndex, art.rigidBodyConstraints[i].bodyId);
}

void RemapPhysicsSubsystemsBundleWorldIndex(in u16 targetWorldIndex, mut PhysicsSubsystemsBundle bundle){
    bundle.environment.remapWorldIndex(targetWorldIndex);
    for(usize i = 0u; i < bundle.softBodies.size(); ++i){
        mut SoftBody sb = bundle.softBodies[i];
        for(usize k = 0u; k < sb.attachments.size(); ++k)
            SnapRemapBodyId(targetWorldIndex, sb.attachments[k].bodyId);
    }
    for(usize i = 0u; i < bundle.vehicles.size(); ++i){
        mut VehicleController veh = bundle.vehicles[i];
        SnapRemapBodyId(targetWorldIndex, veh.chassisBodyId);
        SnapRemapBodyId(targetWorldIndex, veh.trailerBodyId);
        SnapRemapJointId(targetWorldIndex, veh.trailerJointId);
        for(usize k = 0u; k < veh.wheelStates.size(); ++k){
            SnapRemapBodyId(targetWorldIndex, veh.wheelStates[k].groundBodyId);
            SnapRemapShapeId(targetWorldIndex, veh.wheelStates[k].groundShapeId);
        }
    }
    for(usize i = 0u; i < bundle.ragdolls.size(); ++i){
        mut RagdollInstance rag = bundle.ragdolls[i];
        for(usize k = 0u; k < rag.boneBodies.size(); ++k)
            SnapRemapBodyId(targetWorldIndex, rag.boneBodies[k]);
        for(usize k = 0u; k < rag.joints.size(); ++k)
            SnapRemapJointId(targetWorldIndex, rag.joints[k]);
        for(usize k = 0u; k < rag.boneJointIds.size(); ++k)
            SnapRemapJointId(targetWorldIndex, rag.boneJointIds[k]);
        RemapArticulationWorldIndex(targetWorldIndex, rag.articulation);
    }
    for(usize i = 0u; i < bundle.characters.size(); ++i){
        mut CharacterController ch = bundle.characters[i];
        SnapRemapBodyId(targetWorldIndex, ch.def.ignoreBodyId);
        SnapRemapShapeId(targetWorldIndex, ch.def.ignoreShapeId);
        SnapRemapHullGeometryId(targetWorldIndex, ch.def.customHullGeometryId);
        SnapRemapCompoundGeometryId(targetWorldIndex, ch.def.customCompoundGeometryId);
        SnapRemapBodyId(targetWorldIndex, ch.groundBodyId);
        SnapRemapShapeId(targetWorldIndex, ch.groundShapeId);
        for(usize k = 0u; k < ch.activeContacts.size(); ++k){
            SnapRemapShapeId(targetWorldIndex, ch.activeContacts[k].shapeId);
            SnapRemapBodyId(targetWorldIndex, ch.activeContacts[k].bodyId);
        }
    }
    for(usize i = 0u; i < bundle.articulations.size(); ++i)
        RemapArticulationWorldIndex(targetWorldIndex, bundle.articulations[i]);
    for(usize i = 0u; i < bundle.fractureClusters.size(); ++i){
        mut FractureClusterBody fc = bundle.fractureClusters[i];
        SnapRemapBodyId(targetWorldIndex, fc.rootBodyId);
        SnapRemapShapeId(targetWorldIndex, fc.rootShapeId);
        for(usize k = 0u; k < fc.anchoredBodies.size(); ++k)
            SnapRemapBodyId(targetWorldIndex, fc.anchoredBodies[k]);
        for(usize k = 0u; k < fc.anchoredShapes.size(); ++k)
            SnapRemapShapeId(targetWorldIndex, fc.anchoredShapes[k]);
        for(usize k = 0u; k < fc.detachedBodies.size(); ++k)
            SnapRemapBodyId(targetWorldIndex, fc.detachedBodies[k]);
        for(usize k = 0u; k < fc.detachedShapes.size(); ++k)
            SnapRemapShapeId(targetWorldIndex, fc.detachedShapes[k]);
        for(usize k = 0u; k < fc.subClusters.size(); ++k){
            SnapRemapBodyId(targetWorldIndex, fc.subClusters[k].bodyId);
            SnapRemapShapeId(targetWorldIndex, fc.subClusters[k].shapeId);
        }
        fc.remapCachedHullWorldIndex(targetWorldIndex);
    }
    for(usize i = 0u; i < bundle.fractureBondGraphs.size(); ++i){
        mut FractureBondGraph bg = bundle.fractureBondGraphs[i];
        for(usize k = 0u; k < bg.chunkBodies.size(); ++k)
            SnapRemapBodyId(targetWorldIndex, bg.chunkBodies[k]);
        for(usize k = 0u; k < bg.bonds.size(); ++k)
            SnapRemapJointId(targetWorldIndex, bg.bonds[k].jointId);
    }
}

void PreservePhysicsSubsystemsCallbacks(in PhysicsSubsystemsBundle src, mut PhysicsSubsystemsBundle dst){
    const usize fluidKeep = Min(src.environment.fluids.size(), dst.environment.fluids.size());
    for(usize i = 0u; i < fluidKeep; ++i)
        dst.environment.fluids[i].copySurfaceCallbackFrom(src.environment.fluids[i]);
    const usize charKeep = Min(src.characters.size(), dst.characters.size());
    for(usize i = 0u; i < charKeep; ++i)
        dst.characters[i].copyCallbacksFrom(src.characters[i]);
}

b8 SerializePhysicsSubsystemsSnapshot(in PhysicsSubsystemsBundle bundle, mut Vector<u8> outBytes){
    outBytes.clear();
    outBytes.reserve(EstimatePhysicsSubsystemsSnapshotSize(bundle));
    SnapshotDirectByteWriter w(outBytes);
    if(!SerializePhysicsSubsystemsPayload(bundle, w))
        return false;
    w.writeU64(w.m_hash);
    return true;
}

b8 RestorePhysicsSubsystemsSnapshot(in Span<u8> bytes, mut PhysicsSubsystemsBundle bundle){
    SnapshotByteReader r;
    usize payloadEnd = 0u;
    if(!VerifySnapshotChecksumAndInitReader(bytes, 24u, r, payloadEnd))
        return false;
    PhysicsSubsystemsBundle tmp;
    if(!ReadPhysicsSubsystemsPayload(bytes, r, tmp))
        return false;
    if(r.cursor != payloadEnd)
        return false;
    PreservePhysicsSubsystemsCallbacks(bundle, tmp);
    bundle = tmp;
    return true;
}

u64 ComputePhysicsSubsystemsStateHash(in PhysicsSubsystemsBundle bundle){
    SnapshotFnv1a64Sink hashSink;
    if(!SerializePhysicsSubsystemsPayload(bundle, hashSink))
        return 0u;
    return hashSink.hash;
}

b8 ReadFullPhysicsSnapshotBodyWithSpansFiltered(
    in Span<u8> bytes,
    in usize payloadEnd,
    in u32 skipPoolMask,
    in SnapshotWorldProvenance prov,
    mut SnapshotByteReader ioR,
    mut PhysicsWorld outWorld,
    mut SnapshotWorldSectionSpans outSpans,
    mut PhysicsSubsystemsBundle outBundle
){
    u32 magic = 0u;
    u32 version = 0u;
    if(!ioR.readU32(bytes, magic) || !ioR.readU32(bytes, version))
        return false;
    if(magic != s_FullSnapshotMagic || version != s_FullSnapshotVersion)
        return false;
    if(!ReadPhysicsWorldSnapshotPayloadWithSpansFiltered(bytes, skipPoolMask, prov, ioR, outWorld, outSpans))
        return false;
    if(!ReadPhysicsSubsystemsPayload(bytes, ioR, outBundle))
        return false;
    return ioR.cursor == payloadEnd;
}

b8 ReadFullPhysicsSnapshotWithSpans(
    in Span<u8> bytes,
    mut SnapshotByteReader outR,
    mut usize outPayloadEnd,
    mut u64 outPayloadHash,
    mut SnapshotWorldProvenance outProv,
    mut PhysicsWorld outWorld,
    mut SnapshotWorldSectionSpans outSpans,
    mut PhysicsSubsystemsBundle outBundle
){
    if(!VerifyWorldSnapshotChecksumAndProvenance(bytes, outR, outPayloadEnd, outPayloadHash, outProv))
        return false;
    return ReadFullPhysicsSnapshotBodyWithSpansFiltered(bytes, outPayloadEnd, 0u, outProv, outR, outWorld, outSpans, outBundle);
}

b8 SerializeFullPhysicsSnapshot(in PhysicsWorld world, in PhysicsSubsystemsBundle bundle, mut Vector<u8> outBytes){
    outBytes.clear();
    outBytes.reserve(EstimatePhysicsWorldSnapshotSize(world) + EstimatePhysicsSubsystemsSnapshotSize(bundle) + 144u);
    SnapshotDirectByteWriter w(outBytes);
    w.writeU32(s_FullSnapshotMagic);
    w.writeU32(s_FullSnapshotVersion);
    SnapshotWorldProvenance poolSizes;
    if(!SerializePhysicsWorldSnapshotPayloadWithPoolBytes(world, w, poolSizes))
        return false;
    if(!SerializePhysicsSubsystemsPayload(bundle, w))
        return false;
    WriteSnapshotProvenanceFooter(world, poolSizes, w);
    w.writeU64(w.m_hash);
    return true;
}

b8 RestoreFullPhysicsSnapshot(in Span<u8> bytes, mut PhysicsWorld world, mut PhysicsSubsystemsBundle bundle){
    if(world.m_inStep)
        return false;
    SnapshotByteReader r;
    usize payloadEnd = 0u;
    u64 unusedPayloadHash = 0u;
    SnapshotWorldProvenance unusedProv;
    PhysicsWorld tmpWorld;
    SnapshotWorldSectionSpans unusedSpans;
    PhysicsSubsystemsBundle tmpBundle;
    if(!ReadFullPhysicsSnapshotWithSpans(bytes, r, payloadEnd, unusedPayloadHash, unusedProv, tmpWorld, unusedSpans, tmpBundle))
        return false;

    PreservePhysicsSubsystemsCallbacks(bundle, tmpBundle);
    CommitRestoredPhysicsWorld(tmpWorld, world);
    RemapPhysicsSubsystemsBundleWorldIndex(world.m_worldIndex, tmpBundle);
    bundle = tmpBundle;
    return true;
}

u64 ComputeFullPhysicsStateHash(in PhysicsWorld world, in PhysicsSubsystemsBundle bundle){
    SnapshotFnv1a64Sink hashSink;
    hashSink.writeU32(s_FullSnapshotMagic);
    hashSink.writeU32(s_FullSnapshotVersion);
    if(!SerializePhysicsWorldSnapshotPayload(world, hashSink))
        return 0u;
    if(!SerializePhysicsSubsystemsPayload(bundle, hashSink))
        return 0u;
    return hashSink.hash;
}

b8 SnapByteVecsEqual(in Vector<u8> a, in Vector<u8> b){
    if(a.size() != b.size())
        return false;
    for(usize i = 0u; i < a.size(); ++i){
        if(a[i] != b[i])
            return false;
    }
    return true;
}

b8 SnapByteVecEqualsSlice(in Vector<u8> a, in Vector<u8> b, in usize bStart, in usize bLen){
    if(a.size() != bLen)
        return false;
    for(usize i = 0u; i < bLen; ++i){
        if(a[i] != b[bStart + i])
            return false;
    }
    return true;
}

b8 SnapEmitBlobDelta<T, WriteFn>(
    in T baseObj,
    in T curObj,
    in WriteFn writeObj,
    mut Vector<u8> baseBuf,
    mut DeltaSnapshotScratch sc,
    mut SnapshotDirectByteWriter w
){
    baseBuf.clear();
    {
        SnapshotRawByteWriter bw(baseBuf);
        if(!writeObj(baseObj, bw))
            return false;
    }
    sc.curBuf.clear();
    {
        SnapshotRawByteWriter cw(sc.curBuf);
        if(!writeObj(curObj, cw))
            return false;
    }
    if(SnapByteVecsEqual(baseBuf, sc.curBuf)){
        w.writeU8(0u);
        return true;
    }
    w.writeU8(1u);
    w.writeBytes(Span<u8>(sc.curBuf));
    return true;
}

b8 SnapApplyBlobDelta<T, ReadFn>(
    in Span<u8> bytes,
    in ReadFn readObj,
    mut SnapshotByteReader r,
    mut T ioObj
){
    u8 changed = 0u;
    if(!r.readU8(bytes, changed))
        return false;
    if(changed == 0u)
        return true;
    if(changed != 1u)
        return false;
    Vector<T> fresh;
    fresh.resize(1u);
    if(!readObj(bytes, r, fresh[0u]))
        return false;
    ioObj = fresh[0u];
    return true;
}

b8 SnapEmitVectorBlobDelta<T, WriteFn>(
    in Vector<T> baseV,
    in Vector<T> curV,
    in WriteFn writeElem,
    mut Vector<u8> baseBuf,
    mut DeltaSnapshotScratch sc,
    mut SnapshotDirectByteWriter w
){
    if(baseV.size() == curV.size()){
        sc.dirtyIndices.clear();
        sc.elemBlobs.clear();
        sc.elemStarts.clear();
        sc.elemLens.clear();
        sc.elemStarts.reserve(curV.size());
        sc.elemLens.reserve(curV.size());
        for(usize i = 0u; i < curV.size(); ++i){
            baseBuf.clear();
            {
                SnapshotRawByteWriter bw(baseBuf);
                if(!writeElem(baseV[i], bw))
                    return false;
            }
            const usize start = sc.elemBlobs.size();
            {
                SnapshotRawByteWriter cw(sc.elemBlobs);
                if(!writeElem(curV[i], cw))
                    return false;
            }
            const usize len = sc.elemBlobs.size() - start;
            if(start > cast<usize>(0xFFFFFFFFu) || len > cast<usize>(0xFFFFFFFFu))
                return false;
            sc.elemStarts.push_back(cast<u32>(start));
            sc.elemLens.push_back(cast<u32>(len));
            if(!SnapByteVecEqualsSlice(baseBuf, sc.elemBlobs, start, len))
                sc.dirtyIndices.push_back(cast<u32>(i));
        }
        if(sc.dirtyIndices.empty()){
            w.writeU8(0u);
            return true;
        }
        if(sc.dirtyIndices.size() * 2u < curV.size()){
            w.writeU8(1u);
            if(!w.writeCount(sc.dirtyIndices.size()))
                return false;
            for(usize k = 0u; k < sc.dirtyIndices.size(); ++k){
                const u32 idx = sc.dirtyIndices[k];
                w.writeU32(idx);
                const usize start = cast<usize>(sc.elemStarts[idx]);
                const usize len = cast<usize>(sc.elemLens[idx]);
                if(len > 0u)
                    w.writeBytes(Span<u8>(sc.elemBlobs.data() + start, len));
            }
            return true;
        }
        w.writeU8(2u);
        if(!w.writeCount(curV.size()))
            return false;
        if(!sc.elemBlobs.empty())
            w.writeBytes(Span<u8>(sc.elemBlobs));
        return true;
    }
    w.writeU8(2u);
    if(!w.writeCount(curV.size()))
        return false;
    for(usize i = 0u; i < curV.size(); ++i){
        sc.curBuf.clear();
        {
            SnapshotRawByteWriter ew(sc.curBuf);
            if(!writeElem(curV[i], ew))
                return false;
        }
        w.writeBytes(Span<u8>(sc.curBuf));
    }
    return true;
}

b8 SnapApplyVectorBlobDelta<T, ReadFn>(
    in Span<u8> bytes,
    in usize minBytesPerItem,
    in ReadFn readElem,
    mut SnapshotByteReader r,
    mut Vector<T> ioV
){
    u8 mode = 0u;
    if(!r.readU8(bytes, mode))
        return false;
    if(mode == 0u)
        return true;
    if(mode == 1u){
        u32 cnt = 0u;
        if(!r.readCount(bytes, minBytesPerItem + 4u, cnt))
            return false;
        Vector<T> fresh;
        for(u32 k = 0u; k < cnt; ++k){
            u32 idx = 0u;
            if(!r.readU32(bytes, idx) || cast<usize>(idx) >= ioV.size())
                return false;
            fresh.clear();
            fresh.resize(1u);
            if(!readElem(bytes, r, fresh[0u]))
                return false;
            ioV[idx] = fresh[0u];
        }
        return true;
    }
    if(mode == 2u){
        u32 cnt = 0u;
        if(!r.readCount(bytes, minBytesPerItem, cnt))
            return false;
        ioV.clear();
        ioV.resize(cnt);
        for(u32 i = 0u; i < cnt; ++i){
            if(!readElem(bytes, r, ioV[i]))
                return false;
        }
        return true;
    }
    return false;
}

b8 SerializePhysicsSubsystemsDeltaPayload(
    in PhysicsSubsystemsBundle baseBundle,
    in PhysicsSubsystemsBundle bundle,
    mut DeltaSnapshotScratch sc,
    mut SnapshotDirectByteWriter w
){
    Vector<u8> baseBuf;
    return
        SnapEmitBlobDelta(baseBundle.environment, bundle.environment, lambda[](in PhysicsEnvironment e, mut SnapshotRawByteWriter sw) -> b8{ return SnapWritePhysicsEnvironment(e, sw); }, baseBuf, sc, w)
        && SnapEmitVectorBlobDelta(baseBundle.softBodies, bundle.softBodies, lambda[](in SoftBody s, mut SnapshotRawByteWriter sw) -> b8{ return SnapWriteSoftBody(s, sw); }, baseBuf, sc, w)
        && SnapEmitVectorBlobDelta(baseBundle.vehicles, bundle.vehicles, lambda[](in VehicleController v, mut SnapshotRawByteWriter sw) -> b8{ return SnapWriteVehicleController(v, sw); }, baseBuf, sc, w)
        && SnapEmitVectorBlobDelta(baseBundle.ragdolls, bundle.ragdolls, lambda[](in RagdollInstance rg, mut SnapshotRawByteWriter sw) -> b8{ return SnapWriteRagdollInstance(rg, sw); }, baseBuf, sc, w)
        && SnapEmitVectorBlobDelta(baseBundle.characters, bundle.characters, lambda[](in CharacterController c, mut SnapshotRawByteWriter sw) -> b8{ return SnapWriteCharacterController(c, sw); }, baseBuf, sc, w)
        && SnapEmitVectorBlobDelta(baseBundle.articulations, bundle.articulations, lambda[](in Articulation a, mut SnapshotRawByteWriter sw) -> b8{ return SnapWriteArticulation(a, sw); }, baseBuf, sc, w)
        && SnapEmitVectorBlobDelta(baseBundle.fractureClusters, bundle.fractureClusters, lambda[](in FractureClusterBody f, mut SnapshotRawByteWriter sw) -> b8{ return SnapWriteFractureClusterBody(f, sw); }, baseBuf, sc, w)
        && SnapEmitVectorBlobDelta(baseBundle.fractureBondGraphs, bundle.fractureBondGraphs, lambda[](in FractureBondGraph g, mut SnapshotRawByteWriter sw) -> b8{ return SnapWriteFractureBondGraph(g, sw); }, baseBuf, sc, w)
        && SnapEmitVectorBlobDelta(baseBundle.fractureCollections, bundle.fractureCollections, lambda[](in FractureCollection c, mut SnapshotRawByteWriter sw) -> b8{ return SnapWriteFractureCollection(c, sw); }, baseBuf, sc, w)
    ;
}

b8 ApplyPhysicsSubsystemsDeltaPayload(
    in Span<u8> deltaBytes,
    mut SnapshotByteReader r,
    mut PhysicsSubsystemsBundle ioBundle
){
    return
        SnapApplyBlobDelta(deltaBytes, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut PhysicsEnvironment e) -> b8{ return SnapReadPhysicsEnvironment(b, sr, e); }, r, ioBundle.environment)
        && SnapApplyVectorBlobDelta(deltaBytes, 32u, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut SoftBody s) -> b8{ return SnapReadSoftBody(b, sr, s); }, r, ioBundle.softBodies)
        && SnapApplyVectorBlobDelta(deltaBytes, 32u, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut VehicleController v) -> b8{ return SnapReadVehicleController(b, sr, v); }, r, ioBundle.vehicles)
        && SnapApplyVectorBlobDelta(deltaBytes, 16u, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut RagdollInstance rg) -> b8{ return SnapReadRagdollInstance(b, sr, rg); }, r, ioBundle.ragdolls)
        && SnapApplyVectorBlobDelta(deltaBytes, 64u, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut CharacterController c) -> b8{ return SnapReadCharacterController(b, sr, c); }, r, ioBundle.characters)
        && SnapApplyVectorBlobDelta(deltaBytes, 32u, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut Articulation a) -> b8{ return SnapReadArticulation(b, sr, a); }, r, ioBundle.articulations)
        && SnapApplyVectorBlobDelta(deltaBytes, 32u, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut FractureClusterBody f) -> b8{ return SnapReadFractureClusterBody(b, sr, f); }, r, ioBundle.fractureClusters)
        && SnapApplyVectorBlobDelta(deltaBytes, 8u, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut FractureBondGraph g) -> b8{ return SnapReadFractureBondGraph(b, sr, g); }, r, ioBundle.fractureBondGraphs)
        && SnapApplyVectorBlobDelta(deltaBytes, 12u, lambda[](in Span<u8> b, mut SnapshotByteReader sr, mut FractureCollection c) -> b8{ return SnapReadFractureCollection(b, sr, c); }, r, ioBundle.fractureCollections)
    ;
}

b8 CreatePhysicsSubsystemsDeltaSnapshot(
    in PhysicsSubsystemsBundle bundle,
    in Span<u8> baseSnapshotBytes,
    mut Vector<u8> outDeltaBytes
){
    outDeltaBytes.clear();
    SnapshotByteReader baseR;
    usize basePayloadEnd = 0u;
    if(!VerifySnapshotChecksumAndInitReader(baseSnapshotBytes, 24u, baseR, basePayloadEnd))
        return false;
    PhysicsSubsystemsBundle baseBundle;
    if(!ReadPhysicsSubsystemsPayload(baseSnapshotBytes, baseR, baseBundle) || baseR.cursor != basePayloadEnd)
        return false;

    const u64 baseHash = ComputePhysicsSubsystemsStateHash(baseBundle);
    const u64 targetHash = ComputePhysicsSubsystemsStateHash(bundle);
    if(baseHash == 0u || targetHash == 0u)
        return false;

    DeltaSnapshotScratch sc;
    outDeltaBytes.reserve(1024u);
    SnapshotDirectByteWriter w(outDeltaBytes);
    w.writeU32(s_SubsystemsDeltaSnapshotMagic);
    w.writeU32(s_SubsystemsDeltaSnapshotVersion);
    w.writeU64(baseHash);
    w.writeU64(targetHash);
    if(!SerializePhysicsSubsystemsDeltaPayload(baseBundle, bundle, sc, w))
        return false;
    w.writeU64(w.m_hash);
    return true;
}

b8 ApplyPhysicsSubsystemsDeltaSnapshot(in Span<u8> deltaBytes, mut PhysicsSubsystemsBundle bundle){
    SnapshotByteReader r;
    usize payloadEnd = 0u;
    if(!VerifySnapshotChecksumAndInitReader(deltaBytes, 32u, r, payloadEnd))
        return false;
    u64 baseHash = 0u;
    u64 targetHash = 0u;
    if(!ReadDeltaSnapshotHeaderWithMagic(deltaBytes, s_SubsystemsDeltaSnapshotMagic, s_SubsystemsDeltaSnapshotVersion, r, baseHash, targetHash))
        return false;
    if(ComputePhysicsSubsystemsStateHash(bundle) != baseHash)
        return false;

    PhysicsSubsystemsBundle tmp = bundle;
    if(!ApplyPhysicsSubsystemsDeltaPayload(deltaBytes, r, tmp) || r.cursor != payloadEnd)
        return false;
    if(ComputePhysicsSubsystemsStateHash(tmp) != targetHash)
        return false;
    PreservePhysicsSubsystemsCallbacks(bundle, tmp);
    bundle = tmp;
    return true;
}

b8 RestorePhysicsSubsystemsDeltaSnapshot(
    in Span<u8> baseSnapshotBytes,
    in Span<u8> deltaBytes,
    mut PhysicsSubsystemsBundle bundle
){
    SnapshotByteReader r;
    usize payloadEnd = 0u;
    if(!VerifySnapshotChecksumAndInitReader(deltaBytes, 32u, r, payloadEnd))
        return false;
    u64 baseHash = 0u;
    u64 targetHash = 0u;
    if(!ReadDeltaSnapshotHeaderWithMagic(deltaBytes, s_SubsystemsDeltaSnapshotMagic, s_SubsystemsDeltaSnapshotVersion, r, baseHash, targetHash))
        return false;

    SnapshotByteReader baseR;
    usize basePayloadEnd = 0u;
    if(!VerifySnapshotChecksumAndInitReader(baseSnapshotBytes, 24u, baseR, basePayloadEnd))
        return false;
    PhysicsSubsystemsBundle tmp;
    if(!ReadPhysicsSubsystemsPayload(baseSnapshotBytes, baseR, tmp) || baseR.cursor != basePayloadEnd)
        return false;
    if(ComputePhysicsSubsystemsStateHash(tmp) != baseHash)
        return false;

    if(!ApplyPhysicsSubsystemsDeltaPayload(deltaBytes, r, tmp) || r.cursor != payloadEnd)
        return false;
    if(ComputePhysicsSubsystemsStateHash(tmp) != targetHash)
        return false;
    PreservePhysicsSubsystemsCallbacks(bundle, tmp);
    bundle = tmp;
    return true;
}

b8 CreateFullPhysicsDeltaSnapshot(
    in PhysicsWorld world,
    in PhysicsSubsystemsBundle bundle,
    in Span<u8> baseFullSnapshotBytes,
    mut Vector<u8> outDeltaBytes
){
    outDeltaBytes.clear();
    if(world.m_inStep)
        return false;

    SnapshotByteReader baseR;
    usize basePayloadEnd = 0u;
    u64 baseHash = 0u;
    SnapshotWorldProvenance baseProv;
    if(!VerifyWorldSnapshotChecksumAndProvenance(baseFullSnapshotBytes, baseR, basePayloadEnd, baseHash, baseProv))
        return false;
    PhysicsWorld baseWorld;
    SnapshotWorldSectionSpans baseSpans;
    PhysicsSubsystemsBundle baseBundle;
    const u32 skipPoolMask = ComputeMatchingPoolSkipMask(baseProv, world);
    if(!ReadFullPhysicsSnapshotBodyWithSpansFiltered(baseFullSnapshotBytes, basePayloadEnd, skipPoolMask, baseProv, baseR, baseWorld, baseSpans, baseBundle))
        return false;

    const u64 targetHash = ComputeFullPhysicsStateHash(world, bundle);
    if(baseHash == 0u || targetHash == 0u)
        return false;

    DeltaSnapshotScratch sc;
    outDeltaBytes.reserve(1024u);
    SnapshotDirectByteWriter w(outDeltaBytes);
    w.writeU32(s_FullDeltaSnapshotMagic);
    w.writeU32(s_FullDeltaSnapshotVersion);
    w.writeU64(baseHash);
    w.writeU64(targetHash);
    if(!WritePhysicsWorldDeltaBody(baseFullSnapshotBytes, baseSpans, baseProv, baseWorld, world, sc, w))
        return false;
    if(!SerializePhysicsSubsystemsDeltaPayload(baseBundle, bundle, sc, w))
        return false;
    w.writeU64(w.m_hash);
    return true;
}

b8 FinalizeFullDeltaRestore(
    in Span<u8> deltaBytes,
    in usize payloadEnd,
    in u64 targetHash,
    in b8 preserveGeometry,
    mut SnapshotByteReader r,
    mut PhysicsWorld tmpWorld,
    mut PhysicsSubsystemsBundle tmpBundle,
    mut PhysicsWorld world,
    mut PhysicsSubsystemsBundle bundle
){
    u32 restoredPoolMask = 0u;
    if(
        !ApplyPhysicsWorldDeltaBody(deltaBytes, preserveGeometry, r, world, restoredPoolMask, tmpWorld)
        || !ApplyPhysicsSubsystemsDeltaPayload(deltaBytes, r, tmpBundle)
        || r.cursor != payloadEnd
        || !ValidateRestoredPhysicsWorld(tmpWorld)
        || ComputeFullPhysicsStateHash(tmpWorld, tmpBundle) != targetHash
    ){
        if(preserveGeometry)
            RestoreUnchangedPhysicsWorldGeometryPools(tmpWorld, world, restoredPoolMask);
        return false;
    }

    PreservePhysicsSubsystemsCallbacks(bundle, tmpBundle);
    CommitRestoredPhysicsWorld(tmpWorld, world);
    RemapPhysicsSubsystemsBundleWorldIndex(world.m_worldIndex, tmpBundle);
    bundle = tmpBundle;
    return true;
}

b8 ApplyFullPhysicsDeltaSnapshot(in Span<u8> deltaBytes, mut PhysicsWorld world, mut PhysicsSubsystemsBundle bundle){
    if(world.m_inStep)
        return false;
    SnapshotByteReader r;
    usize payloadEnd = 0u;
    if(!VerifySnapshotChecksumAndInitReader(deltaBytes, 32u, r, payloadEnd))
        return false;
    u64 baseHash = 0u;
    u64 targetHash = 0u;
    if(!ReadDeltaSnapshotHeaderWithMagic(deltaBytes, s_FullDeltaSnapshotMagic, s_FullDeltaSnapshotVersion, r, baseHash, targetHash))
        return false;
    if(ComputeFullPhysicsStateHash(world, bundle) != baseHash)
        return false;

    PhysicsWorld tmpWorld;
    ClonePhysicsWorldNonGeometryStateForDelta(world, tmpWorld);
    SwapAllPhysicsWorldGeometryPools(world, tmpWorld);
    PhysicsSubsystemsBundle tmpBundle = bundle;
    return FinalizeFullDeltaRestore(deltaBytes, payloadEnd, targetHash, true, r, tmpWorld, tmpBundle, world, bundle);
}

b8 RestoreFullPhysicsDeltaSnapshot(
    in Span<u8> baseFullSnapshotBytes,
    in Span<u8> deltaBytes,
    mut PhysicsWorld world,
    mut PhysicsSubsystemsBundle bundle
){
    if(world.m_inStep)
        return false;
    SnapshotByteReader r;
    usize payloadEnd = 0u;
    if(!VerifySnapshotChecksumAndInitReader(deltaBytes, 32u, r, payloadEnd))
        return false;
    u64 baseHash = 0u;
    u64 targetHash = 0u;
    if(!ReadDeltaSnapshotHeaderWithMagic(deltaBytes, s_FullDeltaSnapshotMagic, s_FullDeltaSnapshotVersion, r, baseHash, targetHash))
        return false;

    SnapshotByteReader baseR;
    usize basePayloadEnd = 0u;
    u64 basePayloadHash = 0u;
    SnapshotWorldProvenance unusedProv;
    PhysicsWorld tmpWorld;
    SnapshotWorldSectionSpans unusedSpans;
    PhysicsSubsystemsBundle tmpBundle;
    if(!ReadFullPhysicsSnapshotWithSpans(baseFullSnapshotBytes, baseR, basePayloadEnd, basePayloadHash, unusedProv, tmpWorld, unusedSpans, tmpBundle))
        return false;
    if(basePayloadHash != baseHash)
        return false;

    return FinalizeFullDeltaRestore(deltaBytes, payloadEnd, targetHash, false, r, tmpWorld, tmpBundle, world, bundle);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

