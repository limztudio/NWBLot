#include <impl/ecs_render/avboit/avboit_compute_emulation_validator.adhd>
#include <impl/ecs_render/avboit/avboit_stage_internal_types.adhd>
#include <impl/ecs_render/avboit/task_graph_stage.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class AvboitTaskGraphStageTopologyPolicy{
    public b8 isStagePlacementQueueClassValid(
        in b8 depthWarpRunsOnGraphics,
        in b8 depthWarpRunsOnCompute,
        in b8 extinctionRunsOnGraphics,
        in b8 integrationRunsOnGraphics,
        in b8 integrationRunsOnCompute,
        in b8 accumulationRunsOnGraphics,
        in b8 accumulationFinalizeRunsOnGraphics
    )const{
        return (depthWarpRunsOnGraphics || depthWarpRunsOnCompute)
            && extinctionRunsOnGraphics
            && (integrationRunsOnGraphics || integrationRunsOnCompute)
            && accumulationRunsOnGraphics
            && accumulationFinalizeRunsOnGraphics;
    }
}

Optional<GpuPhysicalQueueInfo> FindFirstAvboitSharedComputeEmulationQueue(
    in GpuCompiledGraphReadView compiledGraph,
    in Span<GpuTaskId> sharedTasks,
    in usize taskCount
){
    if(taskCount == 0u || sharedTasks.empty())
        return Optional<GpuPhysicalQueueInfo>();
    return compiledGraph.findQueueInfoForTask(sharedTasks[0u]);
}

b8 IsAvboitOccupancySharedComputeEmulationMerged(
    in RendererAvboitTaskGraphStageState taskGraphStage,
    in GpuCompiledGraphReadView compiledGraph,
    in Optional<GpuPhysicalQueueInfo> avboitPreQueue,
    in Optional<GpuPhysicalQueueInfo> sharedQueue,
    in Optional<GpuPhysicalQueueInfo> occupancyQueue
){
    const usize phaseCount = taskGraphStage.m_occupancySharedComputeEmulationTaskCount;
    if(!IsAvboitSharedComputeEmulationChainValid(
        compiledGraph,
        taskGraphStage.m_occupancySharedComputeEmulationTasks,
        phaseCount,
        taskGraphStage.m_occupancyComputeEmulationTask,
        taskGraphStage.m_occupancyTask,
        taskGraphStage.m_occupancyStreamTask,
        sharedQueue,
        occupancyQueue
    ))
        return false;
    if(phaseCount == 0u)
        return true;
    return
        taskGraphStage.m_clearTask.valid()
        && IsAvboitCompiledTaskValid(compiledGraph, taskGraphStage.m_preTask)
        && IsAvboitQueueOnClass(avboitPreQueue, CommandQueue::Graphics)
        && compiledGraph.tasksSharePacket(taskGraphStage.m_preTask, taskGraphStage.m_occupancySharedComputeEmulationTasks[0u])
        && compiledGraph.tasksSharePacket(taskGraphStage.m_preTask, taskGraphStage.m_occupancyStreamTask)
        && compiledGraph.tasksSharePacket(taskGraphStage.m_preTask, taskGraphStage.m_clearTask)
        && compiledGraph.taskPrecedesOrSharesPacket(taskGraphStage.m_clearTask, taskGraphStage.m_occupancySharedComputeEmulationTasks[0u])
        && compiledGraph.taskPrecedesInSamePacket(taskGraphStage.m_preTask, taskGraphStage.m_occupancyStreamTask)
        && compiledGraph.taskPrecedesInSamePacket(taskGraphStage.m_occupancyStreamTask, taskGraphStage.m_clearTask)
        && compiledGraph.taskPrecedesInSamePacket(taskGraphStage.m_clearTask, taskGraphStage.m_occupancySharedComputeEmulationTasks[0u])
    ;
}

b8 IsAvboitExtinctionSharedComputeEmulationMerged(
    in RendererAvboitTaskGraphStageState taskGraphStage,
    in GpuCompiledGraphReadView compiledGraph,
    in Optional<GpuPhysicalQueueInfo> sharedQueue,
    in Optional<GpuPhysicalQueueInfo> extinctionQueue
){
    const usize phaseCount = taskGraphStage.m_extinctionSharedComputeEmulationTaskCount;
    if(!IsAvboitSharedComputeEmulationChainValid(
        compiledGraph,
        taskGraphStage.m_extinctionSharedComputeEmulationTasks,
        phaseCount,
        taskGraphStage.m_extinctionComputeEmulationTask,
        taskGraphStage.m_extinctionTask,
        taskGraphStage.m_extinctionStreamTask,
        sharedQueue,
        extinctionQueue
    ))
        return false;
    return phaseCount == 0u || (IsAvboitCompiledTaskValid(compiledGraph, taskGraphStage.m_extinctionTask) && IsOptionalAvboitTaskPrecedingInSharedPacket(compiledGraph, taskGraphStage.m_extinctionStreamTask, taskGraphStage.m_extinctionSharedComputeEmulationTasks[0u]));
}

b8 IsAvboitAccumulationSharedComputeEmulationMerged(
    in RendererAvboitTaskGraphStageState taskGraphStage,
    in GpuCompiledGraphReadView compiledGraph,
    in Optional<GpuPhysicalQueueInfo> sharedQueue,
    in Optional<GpuPhysicalQueueInfo> accumulationQueue
){
    const usize phaseCount = taskGraphStage.m_accumulationSharedComputeEmulationTaskCount;
    if(!IsAvboitSharedComputeEmulationChainValid(
        compiledGraph,
        taskGraphStage.m_accumulationSharedComputeEmulationTasks,
        phaseCount,
        taskGraphStage.m_accumulationComputeEmulationTask,
        taskGraphStage.m_accumulationTask,
        taskGraphStage.m_accumulationStreamTask,
        sharedQueue,
        accumulationQueue
    ))
        return false;
    if(phaseCount == 0u)
        return true;
    if(!IsAvboitCompiledTaskValid(compiledGraph, taskGraphStage.m_accumulationTask) || !taskGraphStage.m_accumulationFinalizeTask.valid())
        return false;
    Array<GpuTaskId, 2u> finalizerBoundary;
    finalizerBoundary[0u] = taskGraphStage.m_accumulationSharedComputeEmulationTasks[phaseCount - 1u];
    finalizerBoundary[1u] = taskGraphStage.m_accumulationFinalizeTask;
    return compiledGraph.tasksFormContiguousPacketSequence(finalizerBoundary) && IsOptionalAvboitTaskPrecedingInSharedPacket(compiledGraph, taskGraphStage.m_accumulationStreamTask, taskGraphStage.m_accumulationSharedComputeEmulationTasks[0u]);
}

RendererAvboitTaskGraphValidation ValidateAvboitTaskGraphStage(
    in RendererAvboitTaskGraphStageState taskGraphStage,
    in GpuCompiledGraphReadView compiledGraph,
    in b8 clearTargets,
    in b8 hasTransparentRenderers
){
    AvboitTaskGraphStageTopologyPolicy topologyPolicy;
    const b8 reusedGeometryValid = IsAvboitReusedGeometryOrdered(
        compiledGraph,
        taskGraphStage.m_occupancyReusedGeometryProducer, taskGraphStage.m_occupancyTask,
        taskGraphStage.m_occupancyComputeEmulationTask, taskGraphStage.m_occupancySharedComputeEmulationTaskCount
    ) && IsAvboitReusedGeometryOrdered(compiledGraph, taskGraphStage.m_extinctionReusedGeometryProducer, taskGraphStage.m_extinctionTask, taskGraphStage.m_extinctionComputeEmulationTask, taskGraphStage.m_extinctionSharedComputeEmulationTaskCount) && IsAvboitReusedGeometryOrdered(
        compiledGraph,
        taskGraphStage.m_accumulationReusedGeometryProducer, taskGraphStage.m_accumulationTask,
        taskGraphStage.m_accumulationComputeEmulationTask, taskGraphStage.m_accumulationSharedComputeEmulationTaskCount
    );
    const b8 avboitPrePacketContainsClear = !clearTargets || (
        taskGraphStage.m_clearFirstTask.valid()
        && taskGraphStage.m_clearTask.valid()
        && compiledGraph.tasksSharePacket(taskGraphStage.m_preTask, taskGraphStage.m_clearFirstTask)
        && compiledGraph.tasksSharePacket(taskGraphStage.m_preTask, taskGraphStage.m_clearTask)
    );
    // Keep CSG clears with AVBOIT Pre for its timing and handoff.
    const b8 avboitPrePacketContainsTransparentCsgClear =
        (!taskGraphStage.m_transparentCsgIntervalClearFirstTask.valid() && !taskGraphStage.m_transparentCsgIntervalClearTask.valid())
        || (
            taskGraphStage.m_transparentCsgIntervalClearFirstTask.valid()
            && taskGraphStage.m_transparentCsgIntervalClearTask.valid()
            && compiledGraph.tasksSharePacket(taskGraphStage.m_preTask, taskGraphStage.m_transparentCsgIntervalClearFirstTask)
            && compiledGraph.tasksSharePacket(taskGraphStage.m_preTask, taskGraphStage.m_transparentCsgIntervalClearTask)
        )
    ;
    const b8 avboitPrePacketContainsOccupancy = compiledGraph.tasksSharePacket(taskGraphStage.m_preTask, taskGraphStage.m_occupancyTask) && compiledGraph.taskPrecedesInSamePacket(taskGraphStage.m_preTask, taskGraphStage.m_occupancyTask);
    // Span/Combine share Pre's timing; reject a split before recording.
    const b8 avboitPrePacketContainsCsgReceiverSpan = !taskGraphStage.m_csgReceiverSpanTask.valid() || compiledGraph.tasksSharePacket(taskGraphStage.m_preTask, taskGraphStage.m_csgReceiverSpanTask);
    const b8 avboitPrePacketContainsCsgIntervalCombine = !taskGraphStage.m_csgIntervalCombineTask.valid() || compiledGraph.tasksSharePacket(taskGraphStage.m_preTask, taskGraphStage.m_csgIntervalCombineTask);
    const Optional<GpuPhysicalQueueInfo> avboitPreQueue = compiledGraph.findQueueInfoForTask(taskGraphStage.m_preTask);
    const Optional<GpuPhysicalQueueInfo> avboitOccupancyQueue = compiledGraph.findQueueInfoForTask(taskGraphStage.m_occupancyTask);
    const Optional<GpuPhysicalQueueInfo> avboitOccupancyComputeEmulationQueue = compiledGraph.findQueueInfoForTask(taskGraphStage.m_occupancyComputeEmulationTask);
    const Optional<GpuPhysicalQueueInfo> avboitOccupancySharedComputeEmulationQueue = FindFirstAvboitSharedComputeEmulationQueue(
        compiledGraph,
        taskGraphStage.m_occupancySharedComputeEmulationTasks,
        taskGraphStage.m_occupancySharedComputeEmulationTaskCount
    );
    const b8 transparentTaskShapeValid = IsAvboitTransparentTaskShapeValid(
        hasTransparentRenderers,
        taskGraphStage.m_depthWarpTask.valid(),
        taskGraphStage.m_extinctionTask.valid(),
        taskGraphStage.m_integrationTask.valid(),
        taskGraphStage.m_accumulationTask.valid(),
        taskGraphStage.m_accumulationFinalizeTask.valid()
    );
    const b8 avboitExtinctionPacketContainsStreams = !taskGraphStage.m_extinctionStreamTask.valid() || compiledGraph.tasksSharePacket(taskGraphStage.m_extinctionTask, taskGraphStage.m_extinctionStreamTask);
    const b8 avboitAccumulationPacketContainsStreams = !taskGraphStage.m_accumulationStreamTask.valid() || compiledGraph.tasksSharePacket(taskGraphStage.m_accumulationTask, taskGraphStage.m_accumulationStreamTask);
    // The finalizer is part of accumulation's packet; a split would bypass it.
    const b8 avboitAccumulationPacketContainsFinalizer = !hasTransparentRenderers || compiledGraph.tasksSharePacket(taskGraphStage.m_accumulationTask, taskGraphStage.m_accumulationFinalizeTask);
    const Optional<GpuPhysicalQueueInfo> avboitDepthWarpQueue = compiledGraph.findQueueInfoForTask(taskGraphStage.m_depthWarpTask);
    const Optional<GpuPhysicalQueueInfo> avboitExtinctionQueue = compiledGraph.findQueueInfoForTask(taskGraphStage.m_extinctionTask);
    const Optional<GpuPhysicalQueueInfo> avboitExtinctionComputeEmulationQueue = compiledGraph.findQueueInfoForTask(taskGraphStage.m_extinctionComputeEmulationTask);
    const Optional<GpuPhysicalQueueInfo> avboitExtinctionSharedComputeEmulationQueue = FindFirstAvboitSharedComputeEmulationQueue(
        compiledGraph,
        taskGraphStage.m_extinctionSharedComputeEmulationTasks,
        taskGraphStage.m_extinctionSharedComputeEmulationTaskCount
    );
    const Optional<GpuPhysicalQueueInfo> avboitIntegrationQueue = compiledGraph.findQueueInfoForTask(taskGraphStage.m_integrationTask);
    const Optional<GpuPhysicalQueueInfo> avboitAccumulationQueue = compiledGraph.findQueueInfoForTask(taskGraphStage.m_accumulationTask);
    const Optional<GpuPhysicalQueueInfo> avboitAccumulationFinalizeQueue = compiledGraph.findQueueInfoForTask(taskGraphStage.m_accumulationFinalizeTask);
    const Optional<GpuPhysicalQueueInfo> avboitAccumulationComputeEmulationQueue = compiledGraph.findQueueInfoForTask(taskGraphStage.m_accumulationComputeEmulationTask);
    const Optional<GpuPhysicalQueueInfo> avboitAccumulationSharedComputeEmulationQueue = FindFirstAvboitSharedComputeEmulationQueue(
        compiledGraph,
        taskGraphStage.m_accumulationSharedComputeEmulationTasks,
        taskGraphStage.m_accumulationSharedComputeEmulationTaskCount
    );
    const b8 depthWarpRunsOnGraphics = IsAvboitQueueOnClass(avboitDepthWarpQueue, CommandQueue::Graphics);
    const b8 depthWarpRunsOnCompute = IsAvboitQueueOnClass(avboitDepthWarpQueue, CommandQueue::Compute);
    const b8 integrationRunsOnGraphics = IsAvboitQueueOnClass(avboitIntegrationQueue, CommandQueue::Graphics);
    const b8 integrationRunsOnCompute = IsAvboitQueueOnClass(avboitIntegrationQueue, CommandQueue::Compute);
    // Keep natural stage order; collapsed stages merge with adjacent Graphics.
    const b8 avboitNaturalStagePlacementValid = !hasTransparentRenderers || (
        avboitDepthWarpQueue.has_value()
        && avboitExtinctionQueue.has_value()
        && avboitIntegrationQueue.has_value()
        && avboitAccumulationQueue.has_value()
        && avboitAccumulationFinalizeQueue.has_value()
        && topologyPolicy.isStagePlacementQueueClassValid(
            depthWarpRunsOnGraphics,
            depthWarpRunsOnCompute,
            IsAvboitQueueOnClass(avboitExtinctionQueue, CommandQueue::Graphics),
            integrationRunsOnGraphics,
            integrationRunsOnCompute,
            IsAvboitQueueOnClass(avboitAccumulationQueue, CommandQueue::Graphics),
            IsAvboitQueueOnClass(avboitAccumulationFinalizeQueue, CommandQueue::Graphics)
        )
        && IsAvboitTaskBoundaryOrdered(compiledGraph, taskGraphStage.m_occupancyTask, taskGraphStage.m_depthWarpTask)
        && IsAvboitTaskBoundaryOrdered(compiledGraph, taskGraphStage.m_depthWarpTask, taskGraphStage.m_extinctionTask)
        && IsAvboitTaskBoundaryOrdered(compiledGraph, taskGraphStage.m_extinctionTask, taskGraphStage.m_integrationTask)
        && IsAvboitTaskBoundaryOrdered(compiledGraph, taskGraphStage.m_integrationTask, taskGraphStage.m_accumulationTask)
        && IsAvboitTaskBoundaryOrdered(compiledGraph, taskGraphStage.m_accumulationTask, taskGraphStage.m_accumulationFinalizeTask)
        && (!depthWarpRunsOnGraphics || (compiledGraph.tasksSharePacket(taskGraphStage.m_occupancyTask, taskGraphStage.m_depthWarpTask) && compiledGraph.tasksSharePacket(taskGraphStage.m_depthWarpTask, taskGraphStage.m_extinctionTask)))
        && (!integrationRunsOnGraphics || (compiledGraph.tasksSharePacket(taskGraphStage.m_extinctionTask, taskGraphStage.m_integrationTask) && compiledGraph.tasksSharePacket(taskGraphStage.m_integrationTask, taskGraphStage.m_accumulationTask)))
        && compiledGraph.tasksSharePacket(taskGraphStage.m_accumulationTask, taskGraphStage.m_accumulationFinalizeTask)
    );
    // Require exact packet order so the graph owns the output handoff.
    const b8 avboitOccupancyComputeEmulationMerged =
        IsAvboitComputeEmulationMerged(compiledGraph, taskGraphStage.m_occupancyComputeEmulationTask, taskGraphStage.m_occupancyTask, taskGraphStage.m_occupancyStreamTask, avboitOccupancyComputeEmulationQueue, avboitOccupancyQueue)
        && (
            !taskGraphStage.m_occupancyComputeEmulationTask.valid()
            || (
                IsAvboitQueueOnClass(avboitPreQueue, CommandQueue::Graphics)
                && compiledGraph.tasksSharePacket(taskGraphStage.m_preTask, taskGraphStage.m_occupancyComputeEmulationTask)
                && (!taskGraphStage.m_clearTask.valid() || compiledGraph.taskPrecedesOrSharesPacket(taskGraphStage.m_clearTask, taskGraphStage.m_occupancyComputeEmulationTask))
                && IsOptionalAvboitTaskPrecedingInSharedPacket(compiledGraph, taskGraphStage.m_clearTask, taskGraphStage.m_occupancyComputeEmulationTask)
            )
        )
    ;
    // Shared outputs need contiguous D/R callbacks in Pre's packet.
    const b8 avboitOccupancySharedComputeEmulationMerged = IsAvboitOccupancySharedComputeEmulationMerged(
        taskGraphStage,
        compiledGraph,
        avboitPreQueue,
        avboitOccupancySharedComputeEmulationQueue,
        avboitOccupancyQueue
    );
    const b8 avboitOccupancyAllComputeEmulationMerged = avboitOccupancyComputeEmulationMerged && avboitOccupancySharedComputeEmulationMerged;
    const b8 avboitExtinctionComputeEmulationMerged = IsAvboitComputeEmulationMerged(
        compiledGraph,
        taskGraphStage.m_extinctionComputeEmulationTask,
        taskGraphStage.m_extinctionTask,
        taskGraphStage.m_extinctionStreamTask,
        avboitExtinctionComputeEmulationQueue,
        avboitExtinctionQueue
    );
    // Shared outputs need a packet-local D/R chain.
    const b8 avboitExtinctionSharedComputeEmulationMerged = IsAvboitExtinctionSharedComputeEmulationMerged(
        taskGraphStage,
        compiledGraph,
        avboitExtinctionSharedComputeEmulationQueue,
        avboitExtinctionQueue
    );
    const b8 avboitExtinctionAllComputeEmulationMerged = avboitExtinctionComputeEmulationMerged && avboitExtinctionSharedComputeEmulationMerged;
    const b8 avboitAccumulationComputeEmulationMerged = IsAvboitComputeEmulationMerged(
        compiledGraph,
        taskGraphStage.m_accumulationComputeEmulationTask,
        taskGraphStage.m_accumulationTask,
        taskGraphStage.m_accumulationStreamTask,
        avboitAccumulationComputeEmulationQueue,
        avboitAccumulationQueue
    );
    // Shared outputs need packet-local D/R callbacks.
    const b8 avboitAccumulationSharedComputeEmulationMerged = IsAvboitAccumulationSharedComputeEmulationMerged(
        taskGraphStage,
        compiledGraph,
        avboitAccumulationSharedComputeEmulationQueue,
        avboitAccumulationQueue
    );
    const b8 avboitAccumulationAllComputeEmulationMerged = avboitAccumulationComputeEmulationMerged && avboitAccumulationSharedComputeEmulationMerged;
    const RendererTaskGraphTransparencyStage stage = taskGraphStage.transparencyStage();
    return RendererAvboitTaskGraphValidation(
        stage,
        compiledGraph.valid()
            && stage.valid()
            && taskGraphStage.m_preTask.valid()
            && taskGraphStage.m_occupancyTask.valid()
            && transparentTaskShapeValid
            && reusedGeometryValid
            && stage.hasTransparentTasks == hasTransparentRenderers
            && IsAvboitCompiledTaskValid(compiledGraph, stage.firstTask)
            && IsAvboitCompiledTaskValid(compiledGraph, stage.completionTask)
            && avboitPrePacketContainsClear
            && avboitPrePacketContainsTransparentCsgClear
            && avboitPrePacketContainsCsgReceiverSpan
            && avboitPrePacketContainsCsgIntervalCombine
            && avboitPrePacketContainsOccupancy
            && avboitOccupancyAllComputeEmulationMerged
            && avboitExtinctionPacketContainsStreams
            && avboitExtinctionAllComputeEmulationMerged
            && avboitAccumulationAllComputeEmulationMerged
            && avboitAccumulationPacketContainsStreams
            && avboitAccumulationPacketContainsFinalizer
            && avboitNaturalStagePlacementValid
            && (!hasTransparentRenderers || (
                IsAvboitCompiledTaskValid(compiledGraph, taskGraphStage.m_depthWarpTask)
                && IsAvboitCompiledTaskValid(compiledGraph, taskGraphStage.m_extinctionTask)
                && IsAvboitCompiledTaskValid(compiledGraph, taskGraphStage.m_integrationTask)
                && IsAvboitCompiledTaskValid(compiledGraph, taskGraphStage.m_accumulationTask)
                && IsAvboitCompiledTaskValid(compiledGraph, taskGraphStage.m_accumulationFinalizeTask)
            ))
            && IsAvboitQueueOnClass(avboitPreQueue, CommandQueue::Graphics)
            && IsAvboitQueueOnClass(avboitOccupancyQueue, CommandQueue::Graphics)
            && compiledGraph.taskPrecedesOrSharesPacket(stage.firstTask, stage.completionTask)
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


RendererAvboitTaskGraphValidation RendererAvboitSystem::validateTaskGraphStage(const Core::GpuCompiledGraph::ReadView& compiledGraph, const b8 clearTargets, const b8 hasTransparentRenderers)const noexcept{
    return ValidateAvboitTaskGraphStage(m_taskGraphStage, compiledGraph, clearTargets, hasTransparentRenderers);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RendererAvboitSystem::appendTaskGraphTimingTickets(
    const RendererAvboitTaskGraphValidation& validation,
    RendererAvboitTaskGraphTimingTickets& timingTickets,
    const Span<Core::GpuTaskGraphTaskTimingTicket> bindings,
    usize& bindingCount
)const{
    // Depth warp, extinction, integration, and accumulation tickets.
    const auto requiredBindingCount = TryResolveAvboitRequiredTimingBindingCount(
        validation.valid(),
        validation.stage().hasTransparentTasks,
        m_taskGraphStage.m_extinctionComputeEmulationTask.valid(),
        m_taskGraphStage.m_accumulationComputeEmulationTask.valid(),
        bindingCount,
        bindings.size()
    );
    if(!requiredBindingCount)
        return false;

    const auto appendTimingTicket = [bindings, &bindingCount](const Core::GpuTaskId task, Core::GpuTimingSubmissionTicket& timingTicket)noexcept{
        bindings[bindingCount++] = Core::GpuTaskGraphTaskTimingTicket{ .task = task, .timingTicket = &timingTicket, };
    };

    appendTimingTicket(m_taskGraphStage.m_preTask, timingTickets.pre);
    if(validation.stage().hasTransparentTasks){
        appendTimingTicket(m_taskGraphStage.m_depthWarpTask, timingTickets.depthWarp);
        if(m_taskGraphStage.m_extinctionComputeEmulationTask.valid()){
            // Shares the one Extinction ticket.
            appendTimingTicket(m_taskGraphStage.m_extinctionComputeEmulationTask, timingTickets.extinction);
        }
        appendTimingTicket(m_taskGraphStage.m_extinctionTask, timingTickets.extinction);
        appendTimingTicket(m_taskGraphStage.m_integrationTask, timingTickets.integration);
        if(m_taskGraphStage.m_accumulationComputeEmulationTask.valid()){
            // Shares the one Accumulation ticket.
            appendTimingTicket(m_taskGraphStage.m_accumulationComputeEmulationTask, timingTickets.accumulation);
        }
        appendTimingTicket(m_taskGraphStage.m_accumulationTask, timingTickets.accumulation);
    }
    else{
        timingTickets.depthWarp.discard();
        timingTickets.extinction.discard();
        timingTickets.integration.discard();
        timingTickets.accumulation.discard();
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


