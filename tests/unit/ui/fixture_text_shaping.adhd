[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <global/algorithm.h>

NWB_BEGIN

namespace Tests::UiFixtureText{

using Impl::Ui::FontMetrics;
using Impl::Ui::Point;
using Impl::Ui::Rect;
using Impl::Ui::ShapedGlyph;
using Impl::Ui::ShapedRun;
using Impl::Ui::ShapeRequest;
using Impl::Ui::SharedFontFace;
namespace TextDirection = Impl::Ui::TextDirection;

b8 PopulateFixtureShapedRun(const ShapeRequest& request, ShapedRun& run)noexcept;

class FixtureShaper final : public Impl::Ui::ITextShaper{
public:
    explicit FixtureShaper(Core::Alloc::GlobalArena& arena)noexcept : m_arena(arena){}
    virtual ~FixtureShaper()noexcept override = default;


public:
    [[nodiscard]] virtual Expected<Impl::Ui::ShapedRun, Impl::Ui::TextLayoutStatus::Enum> shape(const Impl::Ui::ShapeRequest& request)override{
        if(request.text == "FAIL")
            return MakeUnexpected(Impl::Ui::TextLayoutStatus::MissingGlyph);
        Impl::Ui::ShapedRun run(m_arena);
        if(!PopulateFixtureShapedRun(request, run))
            return MakeUnexpected(Impl::Ui::TextLayoutStatus::MissingGlyph);
        return run;
    }


private:
    Core::Alloc::GlobalArena& m_arena;
};

};

NWB_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void AppendCodePointGlyphs(in AStringView text, in Rect ink, mut ShapedRun run){
    usize begin = 0u;
    while(begin < text.size()){
        usize end = begin + 1u;
        while(end < text.size() && IsUtf8Continuation(cast<u8>(text[end])))
            ++end;
        run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 1u, cast<u32>(begin), cast<u32>(end), Point(), Point(10.0f, 0.0f), ink));
        begin = end;
    }
}

void ReverseGlyphs(mut ShapedRun run){
    for(usize index = 0u; index < run.glyphs.size() / 2u; ++index)
        Swap(run.glyphs[index], run.glyphs[run.glyphs.size() - index - 1u]);
}

b8 PopulateFixtureShapedRun(in ShapeRequest request, mut ShapedRun run){
    if(request.text == "FAIL")
        return false;
    run.metrics.ascender = 8.0f;
    run.metrics.descender = 2.0f;
    run.metrics.lineGap = 2.0f;
    if(request.text == "ffi")
        run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 1u, 0u, 3u, Point(), Point(30.0f, 0.0f), Rect()));
    else if(request.text == "A\xcc\x81"){
        run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 1u, 0u, 3u, Point(), Point(10.0f, 0.0f), Rect(-1.0f, -8.0f, 12.0f, 10.0f)));
        run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 2u, 0u, 3u, Point(-4.0f, -2.0f), Point(), Rect(0.0f, -8.0f, 3.0f, 2.0f)));
    }
    else if(request.text == "A\314\201B"){
        run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 1u, 0u, 3u, Point(), Point(10.0f, 0.0f), Rect()));
        run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 2u, 3u, 4u, Point(), Point(10.0f, 0.0f), Rect()));
    }
    else if(request.text == "\xe1\x84\x92\xe1\x85\xa1\xe1\x86\xab")
        run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 1u, 0u, 9u, Point(), Point(12.0f, 0.0f), Rect()));
    else
        AppendCodePointGlyphs(request.text, Rect(), run);
    if(request.direction == TextDirection::RightToLeft)
        ReverseGlyphs(run);
    return true;
}


