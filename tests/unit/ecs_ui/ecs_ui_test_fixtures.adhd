[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace NWB::Tests::EcsUi{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 FakeClipboard::deliver(const ClipboardRequestToken token, const ClipboardStatus::Enum status, const AStringView text){
    return DeliverEcsUiFakeClipboard(*this, token, status, text);
}

void FakeClipboard::startNativeRequest(const ClipboardRequestToken token, const ClipboardOperation::Enum operation, const ClipboardChannel::Enum, const AStringView text){
    StartEcsUiFakeClipboardRequest(*this, token, operation, text);
}

b8 PrepareEditView(const Ui::EditModel& model, Ui::TextLayoutBuilder& layoutBuilder, Ui::EditBoxView& view){
    return PrepareEcsUiEditView(model, layoutBuilder, view);
}

b8 UiEditBoxHostTests::prepare(Ui::EditModel& model, const Ui::EditBoxOptions& options, const Ui::Rect& bounds, Ui::IEditActionSink* actions){
    return actions ? PrepareEcsUiEditActionsFrame(*this, model, options, bounds, *actions) : PrepareEcsUiEditBoxFrame(*this, model, options, bounds);
}

b8 UiEditBoxHostTests::commit(){ return CommitEcsUiEditFrame(*this); }
b8 UiEditBoxHostTests::dispatch(const Ui::InputEvent& event){ return DispatchEcsUiEditEvent(*this, event); }
b8 UiEditBoxHostTests::dispatchPointer(const Ui::PointerInput& input){ return DispatchEcsUiEditPointer(*this, input); }
b8 UiEditBoxHostTests::emptyFrame(){ return EmptyEcsUiEditFrame(*this); }
b8 RecordingActions::apply(Ui::EditModel& draft, const Ui::EditAction::Enum action, const b8 readOnly){ return ApplyEcsUiRecordingAction(*this, draft, action, readOnly); }
b8 UiEditActionHostTests::activateActions(){ return ActivateEcsUiEditActions(*this); }
usize UiEditActionHostTests::actionCount(const Ui::EditAction::Enum action)const noexcept{ return CountEcsUiRecordedActions(*this, action); }


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


