const f32 s_EcsUiViewportWidth = 500.0f;
const f32 s_EcsUiViewportHeight = 200.0f;
const usize s_EcsUiInputMaxEvents = 256u;

UiRect MakeEcsUiRect(in f32 x, in f32 y, in f32 width, in f32 height){
    UiRect rect = UiRect();
    rect.x = x;
    rect.y = y;
    rect.width = width;
    rect.height = height;
    return rect;
}

UiPoint MakeEcsUiPoint(in f32 x, in f32 y){
    UiPoint point = UiPoint();
    point.x = x;
    point.y = y;
    return point;
}

UiInputSource MakeEcsUiInputSource(in u32 device, in u32 control){
    UiInputSource source = UiInputSource();
    source.device = device;
    source.control = control;
    return source;
}

b8 DeliverEcsUiFakeClipboard(mut FakeClipboard self, in ClipboardRequestToken token, in ClipboardStatusEnum status, in StringView text){
    if(!self.completeNativeRequest(token, status, text)){
        return false;
    }
    if(status == ClipboardStatus::Success && self.startedOperation == ClipboardOperation::WriteText && token == self.startedToken){
        self.document = self.startedText;
    }
    return true;
}

void StartEcsUiFakeClipboardRequest(mut FakeClipboard self, in ClipboardRequestToken token, in ClipboardOperationEnum operation, in StringView text){
    self.startedToken = token;
    self.startedOperation = operation;
    self.startedText.assign(text.data(), text.size());
    StringView payload = StringView();
    if(operation == ClipboardOperation::ReadText){
        payload = StringView(self.document);
    }
    if(!self.delayed && !DeliverEcsUiFakeClipboard(self, token, ClipboardStatus::Success, payload)){
        EXPECT_TRUE(false);
    }
}

b8 PrepareEcsUiEditView(in UiEditModel model, mut UiTextLayoutBuilder layoutBuilder, mut UiEditBoxView view){
    if(!view.snapshot(model)){
        return false;
    }
    UiShapeRequest desc = UiShapeRequest();
    desc.text = view.displayText();
    auto layout = layoutBuilder.layout(desc);
    if(!layout){
        return false;
    }
    return view.adoptLayout(layout.value());
}

b8 BeginEcsUiRootFrame(mut UiEditBoxHostTests self){
    ++self.m_generation;
    if(!self.m_context.beginFrame(self.m_generation)){
        return false;
    }
    UiDisplayMetrics metrics = UiDisplayMetrics();
    metrics.logicalWidth = s_EcsUiViewportWidth;
    metrics.logicalHeight = s_EcsUiViewportHeight;
    metrics.pixelScaleX = 1.0f;
    metrics.pixelScaleY = 1.0f;
    self.m_host.beginFrame(self.m_generation, metrics);
    UiWidgetRoot rootSurface = UiWidgetRoot();
    rootSurface.value = 17u;
    rootSurface.generation = 1u;
    return self.m_context.beginRoot(rootSurface);
}

b8 BeginEcsUiEditFrame(mut UiEditBoxHostTests self){
    return BeginEcsUiRootFrame(self) && DeclareEcsUiWidget(self.m_context, "edit", UiWidgetKind::EditBox, self.m_widget);
}

b8 PublishEcsUiEditBox(mut UiEditBoxHostTests self, mut UiEditModel model, in UiEditBoxOptions options, in UiRect bounds, in UiPoint previousScroll){
    UiEditBoxView view = UiEditBoxView(self.m_arena);
    if(!PrepareEcsUiEditView(model, self.m_layoutBuilder, view)){
        return false;
    }
    const UiRect viewport = MakeEcsUiRect(0.0f, 0.0f, s_EcsUiViewportWidth, s_EcsUiViewportHeight);
    const auto placement = view.arrange(bounds, UiInsets(), viewport, previousScroll);
    if(!placement){
        return false;
    }
    self.m_placement = placement.value();
    if(!self.m_host.publish(self.m_widget, view, self.m_placement, options)){
        return false;
    }
    UiHitTarget target = UiHitTarget();
    target.rectangle = bounds;
    target.clip = viewport;
    target.enabled = options.enabled;
    target.focusable = options.enabled;
    target.pointerGesture = options.enabled;
    target.textEditable = true;
    return self.m_context.addTarget(self.m_widget, target);
}

b8 FinishEcsUiEditBoxPrepare(mut UiEditBoxHostTests self, mut UiEditModel model, in UiEditBoxOptions options, in UiRect bounds){
    if(!self.m_result.valid || !PublishEcsUiEditBox(self, model, options, bounds, UiPoint())){
        return false;
    }
    if(self.m_includeButton){
        if(!DeclareEcsUiWidget(self.m_context, "other", UiWidgetKind::Button, self.m_otherWidget)){
            return false;
        }
        UiHitTarget other = UiHitTarget();
        other.rectangle = MakeEcsUiRect(230.0f, 20.0f, 100.0f, 30.0f);
        other.clip = MakeEcsUiRect(0.0f, 0.0f, s_EcsUiViewportWidth, s_EcsUiViewportHeight);
        other.focusable = true;
        other.activatable = true;
        if(!self.m_context.addTarget(self.m_otherWidget, other)){
            return false;
        }
    }
    if(!self.m_context.endRoot() || !self.m_context.finishFrame()){
        return false;
    }
    self.m_host.finishFrame();
    return true;
}

b8 PrepareEcsUiEditBoxFrame(mut UiEditBoxHostTests self, mut UiEditModel model, in UiEditBoxOptions options, in UiRect bounds){
    if(!BeginEcsUiEditFrame(self)){
        return false;
    }
    self.m_result = self.m_host.edit(self.m_widget, options, model);
    return FinishEcsUiEditBoxPrepare(self, model, options, bounds);
}

b8 PrepareEcsUiEditActionsFrame(mut UiEditBoxHostTests self, mut UiEditModel model, in UiEditBoxOptions options, in UiRect bounds, mut UiIEditActionSink actions){
    if(!BeginEcsUiEditFrame(self)){
        return false;
    }
    self.m_result = self.m_host.editActions(self.m_widget, options, UiPopupToken(), model, actions);
    return FinishEcsUiEditBoxPrepare(self, model, options, bounds);
}

b8 CommitEcsUiEditFrame(mut UiEditBoxHostTests self){
    if(!self.m_context.commitFrame(self.m_generation)){
        return false;
    }
    self.m_host.commitFrame(self.m_generation);
    return true;
}

b8 DispatchEcsUiEditEvent(mut UiEditBoxHostTests self, in UiInputEvent event){
    self.m_host.collectNative();
    const UiWidgetId previousCapture = self.m_context.input().capture();
    const auto normalized = self.m_context.input().queue(NativeInput(event));
    if(!normalized){
        return false;
    }
    const b8 submit = self.m_host.prepareSubmit(normalized.value());
    const UiInputRoutingResult result = self.m_context.input().process();
    self.m_host.input(normalized.value(), previousCapture, submit);
    return !result.activationOverflow && !result.gestureOverflow;
}

b8 DispatchEcsUiEditPointer(mut UiEditBoxHostTests self, in UiPointerInput input){
    self.m_host.collectNative();
    const UiWidgetId previousCapture = self.m_context.input().capture();
    const auto normalized = self.m_context.input().queuePointer(input);
    if(!normalized){
        return false;
    }
    const UiInputRoutingResult result = self.m_context.input().process();
    if(result.pointerRouted){
        self.m_host.input(normalized.value(), previousCapture, false);
    }
    return !result.activationOverflow && !result.gestureOverflow;
}

b8 EmptyEcsUiEditFrame(mut UiEditBoxHostTests self){
    if(!BeginEcsUiRootFrame(self) || !self.m_context.endRoot() || !self.m_context.finishFrame()){
        return false;
    }
    self.m_host.finishFrame();
    return CommitEcsUiEditFrame(self);
}

b8 ApplyEcsUiRecordingAction(mut RecordingActions self, mut UiEditModel draft, in UiEditActionEnum action, in b8 readOnly){
    ActionRecord record = ActionRecord(self.arena());
    record.action = action;
    record.text.assign(draft.text().data(), draft.text().size());
    self.records.push_back(record);
    if(self.failSubmit && action == UiEditAction::Submit){
        return false;
    }
    if(action == UiEditAction::Submit){
        self.resetIfConfigured();
        if(readOnly){
            return true;
        }
        self.committed.assign(draft.text().data(), draft.text().size());
        return !self.canonicalizeSubmit || draft.setText(StringView(self.committed));
    }
    if(action == UiEditAction::Blur && !readOnly && !self.rejectBlur){
        self.committed.assign(draft.text().data(), draft.text().size());
    }
    return draft.setText(StringView(self.committed));
}

b8 ActivateEcsUiEditActions(mut UiEditActionHostTests self){
    if(!self.actionFrame() || !self.key(Key::Tab) || !self.actionFrame() || !self.m_textInput.activeSession().valid()){
        return false;
    }
    self.m_actions.clear();
    return true;
}

usize CountEcsUiRecordedActions(in UiEditActionHostTests self, in UiEditActionEnum action){
    usize count = 0u;
    for(usize i = 0u; i < self.m_actions.records.size(); ++i){
        if(self.m_actions.records[i].action == action){
            ++count;
        }
    }
    return count;
}


