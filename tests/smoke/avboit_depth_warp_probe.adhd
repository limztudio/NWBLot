////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "avboit_depth_warp_probe_interop.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena]
class DepthWarpProbeProject : IProjectEntryCallbacks{
    public DepthWarpProbeProject(mut ProjectRuntimeContext context){
        this.m_sceneSubsystems = ActiveSceneSubsystems(context.objectArena);
        this.m_cases = GlobalProbeCaseVector(context.objectArena);
        this.m_context = context;
        this.m_unfocusedPass = DepthWarpUnfocusedPass(context.graphics);
    }

    public b8 onStartup()override{
        return InitializeDepthWarpProbeProject(
            this.m_context,
            this.m_sceneSubsystems,
            this.m_cases,
            this.m_shader,
            this.m_pushLayout,
            this.m_pipeline,
            this.m_coverage,
            this.m_warp,
            this.m_control,
            this.m_slots,
            this.m_readback,
            this.m_descriptors,
            this.m_unfocusedPass,
            this.m_unfocusedPassRegistered
        );
    }

    public b8 onUpdate(in f32 delta)override{
        if(this.m_completed)
            return true;
        return RunDepthWarpProbeProjectUpdate(
            this.m_context,
            this.m_sceneSubsystems,
            this.m_cases,
            this.m_coverage,
            this.m_warp,
            this.m_control,
            this.m_slots,
            this.m_readback,
            this.m_pipeline,
            this.m_descriptors,
            this.m_completed
        );
    }

    public void onShutdown()override{
        if(this.m_unfocusedPassRegistered){
            this.m_context.graphics.removeRenderPass(this.m_unfocusedPass);
            this.m_unfocusedPassRegistered = false;
        }
        if(!this.m_context.graphics.waitForIdle())
            error("AvboitDepthWarpProbe: shutdown completion wait failed");
        FreeDepthWarpProbeDescriptors(this.m_context, this.m_descriptors);
        u32 completedVal = 0u;
        if(this.m_completed)
            completedVal = 1u;
        [essential] info("AvboitDepthWarpProbe: shutdown completed={}", completedVal);
    }

    private ActiveSceneSubsystems m_sceneSubsystems;
    private DescriptorHandleArray4 m_descriptors = DescriptorHandleArray4();
    private GlobalProbeCaseVector m_cases;
    private ShaderHandle m_shader = ShaderHandle();
    private BindingLayoutHandle m_pushLayout = BindingLayoutHandle();
    private ComputePipelineHandle m_pipeline = ComputePipelineHandle();
    private BufferHandle m_coverage = BufferHandle();
    private BufferHandle m_warp = BufferHandle();
    private BufferHandle m_control = BufferHandle();
    private BufferHandle m_slots = BufferHandle();
    private BufferHandle m_readback = BufferHandle();
    private mut ProjectRuntimeContext m_context;
    private DepthWarpUnfocusedPass m_unfocusedPass;
    private b8 m_unfocusedPassRegistered = false;
    private b8 m_completed = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB::ProjectFrameClientSize NWB::QueryProjectFrameClientSize(){
    return { 320u, 240u };
}

TStringView NWB::QueryProjectWindowTitle()noexcept{
    return FOUNDATION_TEXT("NWB AVBOIT Depth Warp Probe");
}

UniquePtr<NWB::IProjectEntryCallbacks> NWB::CreateProjectEntryCallbacks(NWB::ProjectRuntimeContext& context){
    return MakeUnique<NWB::Tests::Smoke::DepthWarpProbeProject>(context);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

