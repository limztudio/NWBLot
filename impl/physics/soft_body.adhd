class SoftBodyTetBindWeight{
    public u32 tetIndex = 0u;
    public f32x4 baryWeights(0.25f, 0.25f, 0.25f, 0.25f);
}

class SoftBodyCageBinding{
    public Vector<SoftBodyTetBindWeight> bindings;

    public b8 empty()const{
        return this.bindings.empty();
    }

    public void clear(){
        this.bindings.clear();
    }

    public void evaluateDeformedPositions(in Span<SoftBodyParticle> particles, in Span<SoftBodyVolumeConstraint> tets, mut Vector<f32x3u> outPositions)const{
        const usize vCount = this.bindings.size();
        outPositions.resize(vCount);
        const usize pCount = particles.size();
        const usize tCount = tets.size();
        for(usize vi = 0u; vi < vCount; ++vi){
            in SoftBodyTetBindWeight bw = this.bindings[vi];
            if(cast<usize>(bw.tetIndex) >= tCount)
                continue;
            in SoftBodyVolumeConstraint vc = tets[bw.tetIndex];
            if(vc.p0 >= pCount || vc.p1 >= pCount || vc.p2 >= pCount || vc.p3 >= pCount)
                continue;
            const VectorSingle p0 = VectorSingle(particles[vc.p0].position);
            const VectorSingle p1 = VectorSingle(particles[vc.p1].position);
            const VectorSingle p2 = VectorSingle(particles[vc.p2].position);
            const VectorSingle p3 = VectorSingle(particles[vc.p3].position);
            const VectorSingle pOut = p0 * bw.baryWeights.x + p1 * bw.baryWeights.y + p2 * bw.baryWeights.z + p3 * bw.baryWeights.w;
            outPositions[vi] = f32x3u(pOut.x, pOut.y, pOut.z);
        }
    }
}

void ComputeSoftBodyTriangleBarycentrics(
    in VectorSingle q,
    in VectorSingle a,
    in VectorSingle b,
    in VectorSingle c,
    mut f32 outU,
    mut f32 outV,
    mut f32 outW
){
    const VectorSingle ab = b - a;
    const VectorSingle ac = c - a;
    const VectorSingle aq = q - a;
    const f32 d00 = Vector3Dot(ab, ab).x;
    const f32 d01 = Vector3Dot(ab, ac).x;
    const f32 d11 = Vector3Dot(ac, ac).x;
    const f32 d20 = Vector3Dot(aq, ab).x;
    const f32 d21 = Vector3Dot(aq, ac).x;
    const f32 baryDenom = d00 * d11 - d01 * d01;
    outU = 1.0f / 3.0f;
    outV = 1.0f / 3.0f;
    outW = 1.0f / 3.0f;
    if(Abs(VectorSingle(baryDenom)).x > 1.0e-12f){
        outV = Clamp((d11 * d20 - d01 * d21) / baryDenom, 0.0f, 1.0f);
        outW = Clamp((d00 * d21 - d01 * d20) / baryDenom, 0.0f, 1.0f);
        outU = Clamp(1.0f - outV - outW, 0.0f, 1.0f);
    }
}

u64 MakeSoftBodyUndirectedEdgeKey(in u32 a, in u32 b){
    u32 lo = a;
    u32 hi = b;
    if(b < a){
        lo = b;
        hi = a;
    }
    return (cast<u64>(lo) << 32u) | cast<u64>(hi);
}

u32 HashSoftBodyCellCoord(in i32 cx, in i32 cy, in i32 cz, in usize tableMask){
    const u32 h = (cast<u32>(cx) * 73856093u) ^ (cast<u32>(cy) * 19349663u) ^ (cast<u32>(cz) * 83492791u);
    return h & cast<u32>(tableMask);
}

void ComputeSoftBodyCellCoord(
    in VectorSingle p,
    in f32 invCell,
    mut i32 outX,
    mut i32 outY,
    mut i32 outZ
){
    const VectorSingle fc = VectorFloor(p * invCell);
    outX = cast<i32>(fc.x);
    outY = cast<i32>(fc.y);
    outZ = cast<i32>(fc.z);
}

void ComputeSoftBodyCellBounds(
    in VectorSingle bMin,
    in VectorSingle bMax,
    in f32 invCell,
    mut i32 outMinX,
    mut i32 outMinY,
    mut i32 outMinZ,
    mut i32 outMaxX,
    mut i32 outMaxY,
    mut i32 outMaxZ
){
    const VectorSingle fMin = VectorFloor(bMin * invCell);
    const VectorSingle fMax = VectorFloor(bMax * invCell);
    outMinX = cast<i32>(fMin.x);
    outMinY = cast<i32>(fMin.y);
    outMinZ = cast<i32>(fMin.z);
    outMaxX = cast<i32>(fMax.x);
    outMaxY = cast<i32>(fMax.y);
    outMaxZ = cast<i32>(fMax.z);
}

