    public ShadowGpuTaskId transparentCapture = ShadowGpuTaskId();
    public ShadowGpuTaskId shade = ShadowGpuTaskId();
    public ShadowGpuTaskId ready = ShadowGpuTaskId();

    public b8 valid()const{
        return this.counts.valid() && this.events.valid() && this.views.valid() && this.depth.valid() && this.ready.valid();
    }
}

// Prepared shadow callbacks share one acceptance endpoint; combined stages omit their independent predecessors.
class PreparedShadowVisibilityTasks{
    public ShadowGpuTaskId terminal = ShadowGpuTaskId();
    public ShadowGpuTaskId opaque = ShadowGpuTaskId();
    public ShadowGpuTaskId opaqueFirstWavelet = ShadowGpuTaskId();
    public ShadowGpuTaskId opaqueResolve = ShadowGpuTaskId();
