#include <impl/ecs_ui/toolkit/gpu/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_GpuRasterResourceCapacity = s_PaintMaxImages + s_GpuRasterFixedResourceUses;
type GpuRasterResourceUses = FixedVector<GpuTaskResourceUse, s_GpuRasterResourceCapacity>;
type GpuSampledGraphResources = FixedVector<GpuGraphResourceId, s_PaintMaxImages>;

class GpuSampledTextureImportDesc{
    public Name readyPrefix;
    public StringView readyMarkerLabel;
    public StringView completionLabel;
    public QueueSubmissionToken readinessToken;
    public Name texturePrefix;
    public StringView textureMarkerLabel;
    public TextureHandle texture;
    public usize index;


    public GpuSampledTextureImportDesc(){
        this.readyMarkerLabel = "";
        this.completionLabel = "";
        this.textureMarkerLabel = "";
        this.index = 0u;
    }

    public GpuSampledTextureImportDesc(
        in Name readyPrefix,
        in StringView readyMarkerLabel,
        in StringView completionLabel,
        in QueueSubmissionToken readinessToken,
        in Name texturePrefix,
        in StringView textureMarkerLabel,
        in TextureHandle texture,
        in usize index
    ){
        this.readyPrefix = readyPrefix;
        this.readyMarkerLabel = readyMarkerLabel;
        this.completionLabel = completionLabel;
        this.readinessToken = readinessToken;
        this.texturePrefix = texturePrefix;
        this.textureMarkerLabel = textureMarkerLabel;
        this.texture = texture;
        this.index = index;
    }
};

class GpuPageTextureUploadDesc{
    public Name name;
    public Span<u8> pixels;
    public usize rowPitch;
    public u32 width;
    public u32 height;
    public Format format;


    public GpuPageTextureUploadDesc(){
        this.rowPitch = 0u;
        this.width = 0u;
        this.height = 0u;
        this.format = Format::UNKNOWN;
    }

    public GpuPageTextureUploadDesc(
        in Name name,
        in Span<u8> pixels,
        in usize rowPitch,
        in u32 width,
        in u32 height,
        in Format format
    ){
        this.name = name;
        this.pixels = pixels;
        this.rowPitch = rowPitch;
        this.width = width;
        this.height = height;
        this.format = format;
    }
};

class GpuSampledTextures{
    public b8 createAndUploadPage(
        mut GraphicsRuntime graphics,
        in GpuPageTextureUploadDesc desc,
        mut TextureHandle outTexture,
        mut QueueSubmissionToken outReadinessToken
    ){
        TextureDesc description;
        description.setName(desc.name);
        description.setWidth(desc.width);
        description.setHeight(desc.height);
        description.setFormat(desc.format);
        description.setInitialState(ResourceStates::ShaderResource);
        description.setKeepInitialState(true);
        description.setQueueSharing(ResourceQueueSharing::GraphicsAsyncComputeAndTransfer);

        const Expected<TextureHandle> created = graphics.getDevice().createTexture(description);
        if(!created.has_value()){
            outTexture.reset();
            return false;
        }
        outTexture = created.value();

        Array<StandaloneTextureUploadRegion, 1u> regions;
        regions[0u].setBytes(desc.pixels);
        regions[0u].rowPitch = desc.rowPitch;
        regions[0u].depthPitch = desc.pixels.size();
        if(!graphics.standaloneGraph().uploadTextureBatch(outTexture, Span<StandaloneTextureUploadRegion>(regions), ResourceStates::ShaderResource, ResourceStates::Unknown, outReadinessToken))
            return false;
        return IsValidGpuUploadedReadinessToken(outReadinessToken.valid(), outReadinessToken.hasPhysicalQueueIdentity());
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidGpuUploadedReadinessToken(in b8 tokenValid, in b8 hasPhysicalQueueIdentity){
    return tokenValid && hasPhysicalQueueIdentity;
}

b8 PrepareGpuSampledTextureDescriptor(
    mut GraphicsRuntime graphics,
    in TextureHandle texture,
    in Format format,
    mut GpuDescriptorHandle inOutDescriptor
){
    if(inOutDescriptor.valid())
        return true;
    if(!texture.valid())
        return false;
    mut GpuDescriptorHeap heap = graphics.getDevice().getDescriptorHeap();
    const Expected<GpuDescriptorHandle> descriptorResult = heap.allocate(GpuDescriptorClass::SampledImage);
    if(!descriptorResult.has_value())
        return false;
    const GpuDescriptorHandle descriptor = descriptorResult.value();
    GpuDescriptorRetirementGuard descriptorGuard(heap, descriptor);
    TextureHandle localTexture = texture;
    if(!heap.write(descriptor, DescriptorWriteItemTextureSrv(0u, localTexture.deref(), format, s_AllSubresources, TextureDimension::Texture2D)))
        return false;
    inOutDescriptor = descriptor;
    descriptorGuard.release();
    return true;
}

Expected<GpuGraphResourceId, GpuSampledTextureImportError> ImportGpuSampledTexture(
    in GpuSampledTextureImportDesc desc,
    mut GpuTaskGraph graph,
    mut GpuRasterResourceUses uses
){
    CompactString suffix = CompactString("");
    AppendUnsignedU64Text(suffix, cast<u64>(desc.index));
    // Graph imports unify equal identities; every immutable snapshot page needs a distinct texture and completion name.
    const Expected<Name> readyIdentity = DeriveName(desc.readyPrefix, suffix.view());
    const Expected<Name> textureIdentity = DeriveName(desc.texturePrefix, suffix.view());
    if(!readyIdentity.has_value() || !textureIdentity.has_value())
        return MakeUnexpected(GpuSampledTextureImportError::Identity);
    GpuExternalCompletionDesc completionDesc = GpuExternalCompletionDesc();
    completionDesc.setIdentity(readyIdentity.value());
    completionDesc.setMarkerLabel(desc.readyMarkerLabel);
    completionDesc.setToken(desc.readinessToken);
    const Expected<GpuExternalCompletionId> readyResult = graph.importExternalCompletion(completionDesc);
    if(!readyResult.has_value()){
        error(
            "GpuRenderer: {} {} upload completion import failed (queue={}, generation={}, value={})",
            desc.completionLabel,
            desc.index,
            desc.readinessToken.physicalQueueIndex,
            desc.readinessToken.deviceGeneration,
            desc.readinessToken.value
        );
        return MakeUnexpected(GpuSampledTextureImportError::Completion);
    }
    GpuGraphResourceDesc resourceDesc = GpuGraphResourceDesc();
    resourceDesc.setIdentity(textureIdentity.value());
    resourceDesc.setMarkerLabel(desc.textureMarkerLabel);
    resourceDesc.setType(GpuGraphResourceType::Texture);
    resourceDesc.setInitialAvailabilityCompletion(readyResult.value());
    resourceDesc.setExternalFinalState(ResourceStates::ShaderResource);
    const Expected<GpuGraphResourceId> textureResult = graph.importTexture(desc.texture, resourceDesc);
    if(!textureResult.has_value())
        return MakeUnexpected(GpuSampledTextureImportError::Texture);
    GpuTaskResourceUse use = GpuTaskResourceUse();
    use.resource = textureResult.value();
    use.requiredState = ResourceStates::ShaderResource;
    use.access = GpuTaskResourceAccess::Read;
    uses.push_back(use);
    return textureResult.value();
}


