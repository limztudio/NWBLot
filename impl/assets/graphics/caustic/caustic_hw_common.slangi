////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_CAUSTIC_HW_COMMON_SLANGI
#define NWB_GRAPHICS_CAUSTIC_HW_COMMON_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "hw_binding_slots.h"
#include "photon_push_constants.slangi"
#include "photon_types.slangi"
#include "../bvh/constants.h"
#include "../mesh/runtime_constants.h"
#include "../deferred/bindless_resources.slangi"
#include "../raytrace/material_context_slots.slangi"
#include "../bindless/bindless_heap_rt.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[vk::push_constant]]
ConstantBuffer<NwbCausticPhotonPushConstants> g_NwbCausticHwPushConstants;

// The shared scene-shading CB + light list are selected by the frame selector payload in the UniformBuffer heap. The per-hit surface dispatch reads the same shadow-owned material buffers as the SW path through the heap selector below.
#pragma warning(push)
#pragma warning(disable: 39001) // Deliberate typed alias of the global UniformBuffer descriptor table.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_UNIFORM_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
ConstantBuffer<NwbRayTraceMaterialContextSlots, Std140DataLayout> g_NwbHeapCausticHwMaterialContextSlots[];
#pragma warning(pop)
#define g_NwbCausticHwBindlessResources g_NwbHeapDeferredBindlessResources[g_NwbCausticHwPushConstants.deferredResourcesHeapSlot]
#define g_NwbCausticHwMaterialContextSlots g_NwbHeapCausticHwMaterialContextSlots[g_NwbCausticHwPushConstants.materialContextSlotsHeapSlot]
#define NWB_SCENE_SHADING_HEAP_SLOT g_NwbCausticHwBindlessResources.avboitSlots.z
#define NWB_SCENE_LIGHT_LIST_HEAP_SLOT g_NwbCausticHwBindlessResources.avboitSlots.w

// Route the per-hit surface dispatch through the heap-selected typed-word and mesh-instance buffers. The caustic push block selects its own mesh-view heap slot.
uint nwbMeshFrameMaterialTypedHeapSlot(){
    return g_NwbCausticHwMaterialContextSlots.sceneSlots.w;
}
uint nwbMeshFrameInstanceHeapSlot(){
    return g_NwbCausticHwMaterialContextSlots.materialSlots.x;
}
uint nwbMeshFrameViewHeapSlot(){
    return 0u; // The caustic surface path does not consume the mesh-view alias.
}
#include "../bindless/bindless_heap_mesh.slangi"

#include "../scene/buffer.slangi"
#include "../common/math.slangi"
#include "../bvh/ray_vertex_attrib.slangi"

// Caustics and shadows share per-hit surface dispatch, keeping IOR and transmission equal.
#include "../shadow/shadow_surface.slangi"
#include "shadow/generated/surface_dispatch.slangi"

// Closest-hit/miss need only splat conversion; the transport hook and TraceRay stay in raygen.
#include "splat_constants.slangi"
#include "light_pick.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Keep full-precision transport in two vector lanes; raygen reconstructs world position from the ray and returned distance.
struct NwbCausticHwPayload{
    float4 normalAndDistance;
    float4 transmissionAndIor;
    uint hit;
    uint isRefractive;
};

// The caustic-specific producer inputs share the global heap's StorageBuffer / UniformBuffer tables with the trace material context and mesh-frame view. Their slots are uniform for one ray dispatch and ride the photon push block, so no NonUniformResourceIndex decoration is needed here.
#pragma warning(push)
#pragma warning(disable: 39001) // Deliberate typed aliases of the global heap descriptor tables.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
StructuredBuffer<NwbCausticEmissionTarget, Std430DataLayout> g_NwbHeapCausticHwEmissionTargets[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_UNIFORM_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
ConstantBuffer<NwbCausticPhotonView, Std140DataLayout> g_NwbHeapCausticHwViews[];
#pragma warning(pop)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The fixed-function intersector supplies triangle/barycentric data; its InstanceID selects the heap-backed material record through the UniformBuffer heap payload. Per-corner attributes remain separately addressed by that record's heap slot.
StructuredBuffer<NwbRtInstanceMaterial, Std430DataLayout> nwbCausticHwInstanceMaterials(){
    return nwbHeapRtInstanceMaterials(g_NwbCausticHwMaterialContextSlots.sceneSlots.z);
}

// The closest-hit reads corner attributes through the material record's global heap slot. The shared backing buffers remain transitioned for those heap reads; the world hit point comes from WorldRayOrigin()+RayTCurrent()*WorldRayDirection().

Texture2D<float4> nwbCausticHwGbufferDepth(){
    return nwbHeapSampledImage2D(g_NwbCausticHwPushConstants.depthSlot);
}

Texture2D<float4> nwbCausticHwGbufferWorldPosition(){
    return nwbHeapSampledImage2D(g_NwbCausticHwPushConstants.worldPositionSlot);
}

StructuredBuffer<NwbCausticEmissionTarget, Std430DataLayout> nwbCausticHwEmissionTargets(){
    return g_NwbHeapCausticHwEmissionTargets[g_NwbCausticHwPushConstants.emissionTargetSlot];
}

ConstantBuffer<NwbCausticPhotonView, Std140DataLayout> nwbCausticHwView(){
    return g_NwbHeapCausticHwViews[g_NwbCausticHwPushConstants.viewSlot];
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Per-corner attributes use the shared 16-byte normal/uv0 ABI, matching software and shadow surface inputs.
NwbRayTraceVertexAttrib nwbCausticHwLoadVertexAttrib(const uint attributeSlot, const uint attributeIndex){
    // attributeSlot is non-uniform across the ray wave: nwbHeapRawBuffer() tags NonUniformResourceIndex per Load.
    // One Load4 covers the 16-byte record (packed normal .xy, uv0 .zw); mirrors the SW producer.
    return nwbRayTraceDecodeVertexAttrib(nwbHeapRawBuffer(attributeSlot).Load4(attributeIndex * NWB_RAYTRACE_VERTEX_ATTRIBUTE_STRIDE_BYTES));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#define NWB_CAUSTIC_SPLAT_VIEW nwbCausticHwView()
#define NWB_CAUSTIC_SPLAT_PUSH g_NwbCausticHwPushConstants
#define NWB_CAUSTIC_SPLAT_GBUFFER_DEPTH nwbCausticHwGbufferDepth()
#define NWB_CAUSTIC_SPLAT_GBUFFER_WORLD_POSITION nwbCausticHwGbufferWorldPosition()
#define NWB_CAUSTIC_SPLAT_ACCUMULATOR nwbHeapStorageImage2DArrayUint(g_NwbCausticHwPushConstants.accumulatorStorageSlot)
#include "splat.slangi"
#undef NWB_CAUSTIC_SPLAT_ACCUMULATOR
#undef NWB_CAUSTIC_SPLAT_GBUFFER_WORLD_POSITION
#undef NWB_CAUSTIC_SPLAT_GBUFFER_DEPTH
#undef NWB_CAUSTIC_SPLAT_PUSH
#undef NWB_CAUSTIC_SPLAT_VIEW


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

