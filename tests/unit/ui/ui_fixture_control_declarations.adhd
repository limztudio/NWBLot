namespace SliderCallbackMutation = ::__hidden_ui_glyph_sdf_tests::UiFixtureSliderCallbackMutation;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// A later deferred list label can mutate an earlier slider loan or try to reenter its finalizing Builder.
class SliderCallbackSource final : public UiComboTests::ComboSource{
public:
    SliderCallbackSource()noexcept{
        count = 1u;
        generation = 2501u;
    }


public:
    [[nodiscard]] virtual StringView text(u64 index)const override;
    void arm(const SliderCallbackMutation::Enum mutation, SliderState* state = nullptr, Builder* builder = nullptr, PopupState* popup = nullptr)noexcept{
        m_mutation = mutation;
        m_state = state;
        m_builder = builder;
        m_popup = popup;
        clearCounters();
    }
    void armState(const SliderCallbackMutation::Enum mutation, SliderState& state)noexcept{ arm(mutation, &state, nullptr, nullptr); }
    void armBuilder(const SliderCallbackMutation::Enum mutation, Builder& builder)noexcept{ arm(mutation, nullptr, &builder, nullptr); }
    void armPopup(const SliderCallbackMutation::Enum mutation, PopupState& popup)noexcept{ arm(mutation, nullptr, nullptr, &popup); }
    void clearCounters()const noexcept;


public:
    mutable u32 m_calls = 0u;
    mutable u32 m_mutations = 0u;
    mutable b8 m_beginAccepted = false;
    mutable b8 m_endAccepted = false;


private:
    SliderState* m_state = nullptr;
    Builder* m_builder = nullptr;
    PopupState* m_popup = nullptr;
    mutable SliderCallbackMutation::Enum m_mutation = SliderCallbackMutation::None;
};

class SliderFixture : public WidgetFixture{
public:
    using WidgetFixture::press;


public:
    [[nodiscard]] static SliderOptions Options()noexcept;
    [[nodiscard]] static ListOptions SiblingOptions()noexcept;


public:
    void setUpWidgetBase(){ WidgetFixture::SetUp(); }
    virtual void SetUp()override;
    void configureSliderSkin(){
        configureSkin();
        UiSkin::RegionVector regions(m_arena);
        regions.assign(m_skin.regions().begin(), m_skin.regions().end());
        constexpr Array<StringView, 3> s_Names{ "slider.track", "slider.thumb.normal", "slider.thumb.hover" };
        for(u32 index = 0u; index < 3u; ++index){
            UiSkinRegion region;
            const auto regionName = Name::FromText(s_Names[index]);
            ASSERT_TRUE(regionName);
            region.name = *regionName;
            region.rectangle = { 96u + index * 32u, 0u, 24u, 24u };
            region.drawMode = UiSkinDrawMode::NineSlice;
            region.sliceInsets = { 6u, 6u, 6u, 6u };
            region.minimumWidth = 12.0f;
            region.minimumHeight = 12.0f;
            regions.push_back(Move(region));
        }
        m_skin.setAtlas(Core::Assets::AssetRef<Texture>("tests/ui/texture"), 192u, 32u, 1.0f, Move(regions));
    }
    [[nodiscard]] b8 declare(u64 generation, const SliderOptions& settings = Options(), const Rect& bounds = { 10.0f, 10.0f, 360.0f, 240.0f });
    [[nodiscard]] b8 prepare(u64 generation, const SliderOptions& settings = Options(), const Rect& bounds = { 10.0f, 10.0f, 360.0f, 240.0f });
    [[nodiscard]] b8 accept(u64 generation, const SliderOptions& settings = Options(), const Rect& bounds = { 10.0f, 10.0f, 360.0f, 240.0f });
    [[nodiscard]] b8 sibling(AStringView key = "later");
    [[nodiscard]] WidgetId host()const;
    [[nodiscard]] WidgetId track()const;
    [[nodiscard]] WidgetId thumb()const;
    [[nodiscard]] Point trackPoint(f64 normalized, const SliderState& state)const noexcept;
    [[nodiscard]] Point thumbPoint()const noexcept;
    [[nodiscard]] AcceptedInputState<64u> accepted()const noexcept{ return CaptureAcceptedInput<64u>(m_context.input()); }
    void expectAccepted(const AcceptedInputState<64u>& saved, const b8 popupFocus = true)const{
        ExpectAcceptedInput(m_context.input(), saved, false, popupFocus, popupFocus, true);
    }


public:
    SliderState m_state;
    SliderCallbackSource m_laterSource;
    ListState m_laterState;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace UiTextAreaTests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace UiComboTests;

inline constexpr AStringView s_TextAreaPanelKey = "panel";
inline constexpr AStringView s_TextAreaKey = "area";

namespace AreaEventKind = ::__hidden_ui_glyph_sdf_tests::UiFixtureAreaEventKind;

struct AreaEvent{
    AString<Core::Alloc::GlobalArena> text;
    usize anchor = 0u;
    usize caret = 0u;
    InputCommandIntent intent;
    EditAction::Enum action = EditAction::Submit;
    AreaEventKind::Enum kind = AreaEventKind::Text;


public:
    explicit AreaEvent(Core::Alloc::GlobalArena& arena)noexcept : text(arena){}
};

struct AreaPublication{
    AString<Core::Alloc::GlobalArena> text;
    EditBoxPlacement placement;
    PopupToken popup;


public:
    explicit AreaPublication(Core::Alloc::GlobalArena& arena)noexcept : text(arena){}
};

struct AreaResolution{
    AString<Core::Alloc::GlobalArena> text;
    EditNavigationSnapshot preferred;
    Expected<EditNavigationResult> result = MakeUnexpected(Failure{});
    usize caret = 0u;


public:
    explicit AreaResolution(Core::Alloc::GlobalArena& arena)noexcept : text(arena){}
};

class TextAreaHost final : public IEditBoxHost{
public:
    TextAreaHost(Core::Alloc::GlobalArena& arena, const Context& context)
        : publications(arena)
        , resolutions(arena)
        , actionTexts(arena)
        , m_arena(arena)
        , m_context(context)
        , m_events(arena)
        , m_bindings(arena)
    {}
    virtual ~TextAreaHost()noexcept override = default;


public:
    void text(const AStringView value){
        AreaEvent event(m_arena);
        event.text.assign(value.data(), value.size());
        m_events.push_back(Move(event));
    }
    void key(const i32 value, const b8 control = false, const b8 shift = false){
        AreaEvent event(m_arena);
        event.kind = AreaEventKind::Key;
        const i32 modifiers = (control ? Core::InputModifier::Control : 0) | (shift ? Core::InputModifier::Shift : 0);
        event.intent = m_bindings.resolve(value, modifiers);
        m_events.push_back(Move(event));
    }
    void selection(const usize anchor, const usize caret){
        AreaEvent event(m_arena);
        event.kind = AreaEventKind::Selection;
        event.anchor = anchor;
        event.caret = caret;
        m_events.push_back(Move(event));
    }
    void action(const EditAction::Enum value){
        AreaEvent event(m_arena);
        event.kind = AreaEventKind::Action;
        event.action = value;
        m_events.push_back(Move(event));
    }

    [[nodiscard]] virtual EditBoxResult edit(const WidgetState&, const EditBoxOptions&, EditModel&)noexcept override{
        ++ordinaryLoans;
        return {};
    }
    [[nodiscard]] virtual EditBoxResult editInPopup(const WidgetState&, const EditBoxOptions&, const PopupToken&, EditModel&)noexcept override{ return {}; }
    [[nodiscard]] virtual EditBoxResult editActions(const WidgetState&, const EditBoxOptions&, const PopupToken&, EditModel&, IEditActionSink&)noexcept override{
        ++actionLoans;
        return {};
    }
    [[nodiscard]] virtual EditBoxResult editNavigated(
        const WidgetState& widget,
        const EditBoxOptions& options,
        const PopupToken& popup,
        EditModel& model,
        EditNavigationState& navigation,
        IEditNavigationResolver& resolver,
        IEditActionSink& sink
    )override;
    [[nodiscard]] virtual b8 publish(const WidgetState& widget, const EditBoxView& view, const EditBoxPlacement& placement, const EditBoxOptions&)override{
        ++publishes;
        publications.emplace_back(m_arena);
        AreaPublication& record = publications.back();
        record.text.assign(view.displayText().data(), view.displayText().size());
        record.placement = placement;
        record.popup = m_context.popupToken();
        viewportHeight = placement.content.height;
        if(publishHook && (!publishHookWidget.valid() || publishHookWidget == widget.id)){
            Function<void()> hook = Move(publishHook);
            publishHook = {};
            hook();
        }
        return true;
    }


private:
    [[nodiscard]] b8 applyAction(EditAction::Enum action, b8 readOnly, EditModel& model, EditNavigationState& navigation, IEditActionSink& sink, EditBoxResult& result);


public:
    PaintVector<AreaPublication> publications;
    PaintVector<AreaResolution> resolutions;
    PaintVector<AString<Core::Alloc::GlobalArena>> actionTexts;
    Function<void()> loanHook;
    Function<void()> publishHook;
    WidgetId loanHookWidget;
    WidgetId publishHookWidget;
    PopupToken lastPopup;
    usize loans = 0u;
    usize ordinaryLoans = 0u;
    usize actionLoans = 0u;
    usize publishes = 0u;
    f32 viewportHeight = 80.0f;
    f32 seededColumn = 0.0f;
    b8 seedColumn = false;
    b8 focused = true;


private:
    Core::Alloc::GlobalArena& m_arena;
    const Context& m_context;
    PaintVector<AreaEvent> m_events;
    InputBindings m_bindings;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TextAreaFixture : public WidgetFixture{
public:
    TextAreaFixture()
        : m_model(m_arena, {}, EditTextMode::Multiline)
        , m_host(m_arena, m_context)
    {}


public:
    [[nodiscard]] b8 beginArea(const u64 generation, const Rect& bounds = { 20.0f, 20.0f, 740.0f, 520.0f }){
        return begin(generation) && m_builder.beginPanel(s_TextAreaPanelKey, bounds);
    }
    [[nodiscard]] b8 acceptArea(){ return finishPanel() && m_context.commitFrame(m_context.readyGeneration()); }
    [[nodiscard]] b8 frameArea(u64 generation, const TextAreaOptions& options = {}, const Rect& bounds = { 20.0f, 20.0f, 740.0f, 520.0f });
    void useHost()noexcept{ m_builder.setEditHost(&m_host); }


public:
    EditModel m_model;
    TextAreaState m_state;
    TextAreaHost m_host;
    EditBoxResult m_result;
};

class TextAreaLoanFixture : public TextAreaFixture{
public:
    [[nodiscard]] static TextAreaOptions AreaOptions()noexcept;


public:
    [[nodiscard]] b8 acceptBaseline();
    [[nodiscard]] b8 beginParent(const u64 generation){
        return begin(generation) && m_builder.beginPopup(s_ParentPopupKey, m_parent, UiWidgetTests::LargeLoanParentOptions());
    }
    [[nodiscard]] b8 finishRoot(){ return m_context.endRoot() && m_context.finishFrame(); }
    [[nodiscard]] UiWidgetTests::AcceptedInputState<16u> accepted()const noexcept{ return UiWidgetTests::CaptureAcceptedInput<16u>(m_context.input()); }
    void expectRejected(const UiWidgetTests::AcceptedInputState<16u>& frame){
        EXPECT_TRUE(m_builder.failed());
        EXPECT_TRUE(m_context.failed());
        EXPECT_FALSE(m_context.ready());
        EXPECT_FALSE(m_context.commitFrame(2u));
        UiWidgetTests::ExpectAcceptedInput(m_context.input(), frame, true, false, true, false);
    }


public:
    PopupState m_parent;
    PopupState m_child;
};


