void RegisterTestContributor<ContributorT>(mut FrameGraphRegistry registry, mut ContributorT contributor){
    registry.registerContributor(contributor);
}

b8 RecordRegistryFrameGraph(mut FrameGraphRegistry registry, mut TelemetryCaptureSession session){
    return registry.record(session);
}

FrameGraphNodeHandle MakeNodeHandle(in u32 index){
    FrameGraphNodeHandle handle = FrameGraphNodeHandle();
    handle.index = index;
    return handle;
}

Expected<Name> MakeDecimalScopeName(in u32 index){
    String scopeText = String();
    AppendUnsignedU64Text(scopeText, cast<u64>(index));
    return ParseName(StringView(scopeText));
}

StringView FindLineWithPrefix(in StringView text, in StringView prefix){
    const usize begin = text.find(prefix);
    if(begin == usize.max)
        return "";
    const usize end = text.find("\n", begin);
    if(end == usize.max)
        return text.substr(begin, text.size() - begin);
    return text.substr(begin, end - begin);
}

void AddReportUnmeasuredNode(mut ReportFixture fixture){
    FrameGraphNodeDesc node = FrameGraphNodeDesc();
    node.name = s_ReportTask;
    node.label = "Unmeasured task";
    node.kind = FrameGraphNodeKind::Pass;
    node.flags = 0u;
    fixture.nodes.push_back(node);
}

void AddReportOwner(mut ReportFixture fixture, in u32 packetCount, in u16 firstQueueIndex, in b8 includeQueues){
    const u32 ownerIndex = cast<u32>(fixture.nodes.size());
    const FrameGraphRuntimeStatistics owner = OwnerStatistics(packetCount);

    FrameGraphNodeDesc ownerNode = FrameGraphNodeDesc();
    ownerNode.name = s_ReportOwner;
    ownerNode.label = "Measured owner";
    ownerNode.kind = FrameGraphNodeKind::Pass;
    ownerNode.runtimeStatistics = owner;
    fixture.nodes.push_back(ownerNode);

    if(includeQueues){
        u32 queueCount = packetCount;
        if(packetCount > 1u)
            queueCount = 2u;
        for(u32 queueOffset = 0u; queueOffset < queueCount; ++queueOffset){
            u32 acceptedCount = packetCount / 2u;
            if(queueOffset == 0u)
                acceptedCount += packetCount % 2u;

            FrameGraphPhysicalQueueRuntimeStatistics statistics = FrameGraphPhysicalQueueRuntimeStatistics();
            statistics.graphGeneration = owner.graphGeneration;
            statistics.planGeneration = owner.planGeneration;
            statistics.recordingAttemptGeneration = owner.recordingAttemptGeneration;
            statistics.deviceGeneration = owner.deviceGeneration;
            statistics.queue.index = firstQueueIndex + cast<u16>(queueOffset);
            statistics.queue.deviceGeneration = 17u;
            statistics.queueClass = FrameGraphQueueClass::Graphics;
            statistics.compile.taskCount = acceptedCount;
            statistics.compile.packetCount = acceptedCount;
            statistics.recording.packetCount = acceptedCount;
            statistics.recording.taskCount = acceptedCount;
            statistics.recording.commandListCount = acceptedCount;
            statistics.submission.acceptedPacketCount = acceptedCount;
            statistics.submission.acceptedTaskCount = acceptedCount;
            statistics.submission.nativeSubmissionCount = acceptedCount;
            statistics.submission.nativeCommandListCount = acceptedCount;

            FrameGraphPhysicalQueueRuntimeStatisticsRecord record = FrameGraphPhysicalQueueRuntimeStatisticsRecord();
            record.ownerNodeIndex = ownerIndex;
            record.statistics = statistics;
            fixture.queues.push_back(record);
        }
    }

    // Deliberately unsorted producer input exercises canonical owner and packet ordering.
    for(u32 remaining = packetCount; remaining != 0u; --remaining){
        const u32 packetIndex = remaining - 1u;
        FrameGraphPacketSubmissionStatisticsRecord packet = FrameGraphPacketSubmissionStatisticsRecord();
        packet.packetGeneration = owner.planGeneration;
        packet.taskCount = 1u;
        packet.commandListCount = 1u;
        packet.queue.index = firstQueueIndex + cast<u16>(packetIndex % 2u);
        packet.queue.deviceGeneration = 17u;
        packet.ownerNodeIndex = ownerIndex;
        packet.packetIndex = packetIndex;
        packet.queueClass = FrameGraphQueueClass::Graphics;
        fixture.packets.push_back(packet);
    }
}

void AddReportOwner(mut ReportFixture fixture, in u32 packetCount, in u16 firstQueueIndex){
    AddReportOwner(fixture, packetCount, firstQueueIndex, true);
}

void SeedSnapshotValidationFixture(mut SnapshotValidationFixture fixture){
    fixture.runtime.planGeneration = 9u;
    fixture.runtime.compile.taskCount = 4u;
    fixture.runtime.compile.packetCount = 3u;
    fixture.runtime.submission.acceptedTaskCount = 3u;
    fixture.runtime.submission.acceptedPacketCount = 2u;
    fixture.runtime.submission.rejectedTaskCount = 1u;
    fixture.runtime.submission.rejectedPacketCount = 1u;

    Array<Name, 4> names = Array<Name, 4>();
    names[0u] = s_RenderFirst;
    names[1u] = s_RenderSecond;
    names[2u] = s_RenderPresent;
    names[3u] = s_RenderFrameRecovery;

    Array<u32, 4> packets = Array<u32, 4>();
    packets[0u] = 0u;
    packets[1u] = 0u;
    packets[2u] = 1u;
    packets[3u] = 2u;

    for(usize index = 0u; index < names.size(); ++index){
        FrameGraphNodePayload node = FrameGraphNodePayload();
        node.name = names[index];
        node.compiledTask.planGeneration = fixture.runtime.planGeneration;
        node.compiledTask.packetIndex = packets[index];
        node.compiledTask.present = true;
        fixture.payload.nodes.push_back(node);
    }

    for(u32 index = 0u; index < 2u; ++index){
        FrameGraphPacketSubmissionStatisticsRecord packet = FrameGraphPacketSubmissionStatisticsRecord();
        packet.packetGeneration = fixture.runtime.planGeneration;
        packet.packetIndex = index;
        if(index == 0u)
            packet.taskCount = 2u;
        else
            packet.taskCount = 1u;
        packet.queue.index = 0u;
        packet.queue.deviceGeneration = 1u;
        fixture.payload.packetSubmissionStatistics.push_back(packet);
    }
}

b8 IsSnapshotValidationFixtureValid(in SnapshotValidationFixture fixture){
    return ValidateNormalFrameSnapshotCompletion(fixture.payload, fixture.runtime);
}

FrameGraphPhysicalQueueRuntimeStatistics QueueStatistics(in u16 queueIndex, in u32 packetCount){
    FrameGraphPhysicalQueueRuntimeStatistics stats = FrameGraphPhysicalQueueRuntimeStatistics();
    stats.graphGeneration = 71u;
    stats.planGeneration = 72u;
    stats.recordingAttemptGeneration = 73u;
    stats.deviceGeneration = 17u;
    stats.queue.index = queueIndex;
    stats.queue.deviceGeneration = 17u;
    if(queueIndex == 1u)
        stats.queueClass = FrameGraphQueueClass::Graphics;
    else
        stats.queueClass = FrameGraphQueueClass::Compute;
    stats.compile.taskCount = packetCount;
    stats.compile.packetCount = packetCount;
    stats.recording.packetCount = packetCount;
    stats.recording.taskCount = packetCount;
    stats.recording.commandListCount = packetCount;
    stats.submission.acceptedPacketCount = packetCount;
    stats.submission.acceptedTaskCount = packetCount;
    stats.submission.nativeSubmissionCount = packetCount;
    stats.submission.nativeCommandListCount = packetCount;
    return stats;
}

void PrepareFixture(in u32 packetCount, in u32 ownerCount, mut StatisticsFixture fixture){
    const u32 packetsPerOwner = packetCount / ownerCount;
    fixture.nodes.reserve(ownerCount);
    fixture.queues.reserve(ownerCount * 2u);
    fixture.packets.reserve(packetCount);
    for(u32 ownerIndex = 0u; ownerIndex < ownerCount; ++ownerIndex){
        FrameGraphNodeDesc node = FrameGraphNodeDesc();
        node.name = s_TelemetryCaseScalingOwner;
        node.label = "Scaling owner";
        node.kind = FrameGraphNodeKind::Pass;
        node.runtimeStatistics = OwnerStatistics(packetsPerOwner);
        fixture.nodes.push_back(node);
    }
}

b8 AppendFixtureStatistics(in u32 packetCount, in u32 ownerCount, mut ScratchArena scratchArena, mut StatisticsFixture fixture){
    FrameGraphBuilder builder = FrameGraphBuilder(scratchArena, fixture.nodes, fixture.edges, fixture.pendingEdges, fixture.queues, fixture.packets);
    const u32 packetsPerOwner = packetCount / ownerCount;
    for(u32 ownerIndex = 0u; ownerIndex < ownerCount; ++ownerIndex){
        const FrameGraphNodeHandle owner = MakeNodeHandle(ownerIndex);
        if(!builder.addPhysicalQueueRuntimeStatistics(owner, QueueStatistics(3u, packetsPerOwner / 2u)))
            return false;
        if(!builder.addPhysicalQueueRuntimeStatistics(owner, QueueStatistics(1u, packetsPerOwner / 2u)))
            return false;
    }

    // Odd multiplication permutes the power-of-two workload, interleaving owners and physical queues.
    for(u32 index = 0u; index < packetCount; ++index){
        const u32 shuffled = (index * 2053u + 7u) % packetCount;
        const u32 ownerIndex = shuffled / packetsPerOwner;
        const u32 packetIndex = shuffled % packetsPerOwner;
        u16 queueIndex = 3u;
        FrameGraphQueueClassEnum queueClass = FrameGraphQueueClass::Compute;
        if((packetIndex & 1u) == 0u){
            queueIndex = 1u;
            queueClass = FrameGraphQueueClass::Graphics;
        }

        FrameGraphPacketSubmissionStatisticsRecord packet = FrameGraphPacketSubmissionStatisticsRecord();
        packet.packetGeneration = 72u;
        packet.taskCount = 1u;
        packet.commandListCount = 1u;
        packet.queue.index = queueIndex;
        packet.queue.deviceGeneration = 17u;
        packet.ownerNodeIndex = ownerIndex;
        packet.packetIndex = packetIndex;
        packet.queueClass = queueClass;
        if(!builder.addPacketSubmissionStatistics(MakeNodeHandle(ownerIndex), packet))
            return false;
    }
    return true;
}

void ApplyRuntimeStatisticsCountMutation(mut FrameGraphRuntimeStatistics statistics, in usize mutationIndex){
    switch(mutationIndex){
    case 0u:
        statistics.compile.packetCount = statistics.compile.taskCount + 1u;
        break;
    case 1u:
        ++statistics.compile.mergedTaskCount;
        break;
    case 2u:
        statistics.compile.resourceVersionCount = 0u;
        break;
    case 3u:
        statistics.compile.directResourceUseCount = statistics.compile.resourceUseCount + 1u;
        break;
    case 4u:
        ++statistics.compile.expandedResourceSetMemberUseCount;
        break;
    case 5u:
        statistics.compile.payloadObjectCount = statistics.compile.taskCount + 1u;
        break;
    case 6u:
        statistics.compile.logicalOwnershipTransferSignatureCount = statistics.compile.logicalOwnershipTransferCount + 1u;
        break;
    case 7u:
        statistics.compile.repeatedOwnershipTransferSignatureCount = statistics.compile.logicalOwnershipTransferSignatureCount + 1u;
        break;
    case 8u:
        statistics.compile.concurrentSharingCouldAvoidTransferCount = statistics.compile.logicalOwnershipTransferCount + 1u;
        break;
    case 9u:
        statistics.compile.concurrentSharingAdviceResourceCount = statistics.compile.resourceCount + 1u;
        break;
    case 10u:
        statistics.compile.logicalOwnershipTransferInternalCount = statistics.compile.logicalOwnershipTransferCount + 1u;
        break;
    case 11u:
        statistics.compile.logicalOwnershipTransferExternalImportCount = statistics.compile.logicalOwnershipTransferCount - statistics.compile.logicalOwnershipTransferInternalCount + 1u;
        break;
    case 12u:
        ++statistics.compile.logicalOwnershipTransferExternalExportCount;
        break;
    case 13u:
        statistics.recording.packetCount = statistics.compile.packetCount + 1u;
        break;
    case 14u:
        statistics.recording.taskCount = statistics.compile.taskCount + 1u;
        break;
    case 15u:
        statistics.recording.taskCount = statistics.recording.packetCount - 1u;
        break;
    case 16u:
        statistics.recording.commandListCount = statistics.recording.packetCount - 1u;
        break;
    case 17u:
        statistics.recording.workerRoutedPacketCount = statistics.recording.packetCount + 1u;
        break;
    case 18u:
        statistics.recording.parallelPacketCount = statistics.recording.packetCount + 1u;
        break;
    case 19u:
        statistics.submission.acceptedPacketCount = statistics.compile.packetCount + 1u;
        break;
    case 20u:
        statistics.submission.rejectedPacketCount = statistics.compile.packetCount - statistics.submission.acceptedPacketCount + 1u;
        break;
    case 21u:
        statistics.submission.acceptedTaskCount = statistics.compile.taskCount + 1u;
        break;
    case 22u:
        statistics.submission.rejectedTaskCount = statistics.compile.taskCount - statistics.submission.acceptedTaskCount + 1u;
        break;
    case 23u:
        statistics.submission.acceptedTaskCount = statistics.submission.acceptedPacketCount - 1u;
        break;
    case 24u:
        statistics.submission.rejectedTaskCount = statistics.submission.rejectedPacketCount - 1u;
        break;
    case 25u:
        statistics.submission.acceptedPacketCount = statistics.submission.nativeSubmissionCount - 1u;
        break;
    case 26u:
        statistics.submission.rejectedSubmissionCount = statistics.submission.rejectedPacketCount + 1u;
        break;
    case 27u:
        statistics.submission.acceptedFrontierSubmissionCount = statistics.submission.nativeSubmissionCount + 1u;
        break;
    case 28u:
        statistics.submission.recoverySubmissionCount = statistics.submission.acceptedFrontierSubmissionCount + 1u;
        break;
    case 29u:
        statistics.submission.nativeSubmissionCount = statistics.recording.packetCount + 1u;
        break;
    case 30u:
        statistics.submission.nativeCommandListCount = statistics.submission.nativeSubmissionCount - 1u;
        break;
    case 31u:
        statistics.submission.nativeCommandListCount = statistics.recording.commandListCount + 1u;
        break;
    case 32u:
        statistics.submission.sameQueueWaitElisionCount = statistics.submission.plannedWaitTokenCount + 1u;
        break;
    case 33u:
        statistics.submission.mergedTimelineWaitCount = statistics.submission.plannedWaitTokenCount - statistics.submission.sameQueueWaitElisionCount + 1u;
        break;
    case 34u:
        statistics.submission.inheritedTimelineWaitElisionCount = statistics.submission.plannedWaitTokenCount - statistics.submission.sameQueueWaitElisionCount - statistics.submission.mergedTimelineWaitCount + 1u;
        break;
    case 35u:
        statistics.submission.inheritedTimelineWaitElisionCount = u64.max;
        break;
    case 36u:
        statistics.submission = FrameGraphSubmissionRuntimeStatistics();
        statistics.submission.plannedWaitTokenCount = 1u;
        statistics.submission.inheritedTimelineWaitElisionCount = 1u;
        break;
    default:
        ++statistics.submission.timelineWaitCount;
        break;
    }
}

b8 ReloadRuntimeStatisticsPayload(
    in FrameGraphNodeDescs nodes,
    in FrameGraphEdgeDescs edges,
    in usize runtimeStatisticsOffset,
    mut ScratchArena scratchArena,
    mut TelemetryBytes outPayload,
    mut EncodedFrameGraphRuntimeStatistics outFirst,
    mut EncodedFrameGraphRuntimeStatistics outSecond
){
    if(!BuildTestFrameGraphPayload(911u, nodes, edges, scratchArena, outPayload))
        return false;
    ReadTelemetryPod(outPayload, runtimeStatisticsOffset, outFirst);
    ReadTelemetryPod(outPayload, runtimeStatisticsOffset + s_EncodedFrameGraphRuntimeStatisticsByteSize, outSecond);
    return true;
}


