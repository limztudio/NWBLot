class UiScopeDescriptorFactory{
    public PopupScope comboPopup(
        in PopupToken token,
        in PopupToken parent,
        in PopupPlacement placement,
        in WidgetId focusAnchor,
        in u64 focusAnchorDeclarationGeneration
    )const{
        PopupScope scope;
        scope.token = token;
        scope.parent = parent;
        scope.bounds = placement.bounds;
        scope.viewport = placement.viewport;
        scope.dismissFocusTraversal = true;
        scope.focusAnchor = focusAnchor;
        scope.focusAnchorDeclarationGeneration = focusAnchorDeclarationGeneration;
        return scope;
    }

    public PopupScope popupFrame(
        in PopupToken token,
        in PopupToken parent,
        in PopupPlacement placement,
        in PopupOptions options
    )const{
        PopupScope scope;
        scope.token = token;
        scope.parent = parent;
        scope.bounds = placement.bounds;
        scope.viewport = placement.viewport;
        scope.dismissOutside = options.dismissOutside;
        scope.dismissCancel = options.dismissCancel;
        scope.autofocus = options.autofocus;
        return scope;
    }

    public LayoutNodeDesc popupRoot(
        in Rect bounds,
        in Insets popupPadding,
        in UiSkinInsets backgroundPadding,
        in f32 gap
    )const{
        LayoutNodeDesc description;
        description.direction = LayoutDirection::Column;
        description.width = LayoutSize(LayoutSizePolicy::Fixed, bounds.width);
        description.height = LayoutSize(LayoutSizePolicy::Fixed, bounds.height);
        description.padding = MaxUiPadding(popupPadding, backgroundPadding);
        description.gap = gap;
        return description;
    }

    public PopupScope basicPopup(
        in PopupToken token,
        in PopupToken parent,
        in PopupPlacement placement
    )const{
        PopupScope scope;
        scope.token = token;
        scope.parent = parent;
        scope.bounds = placement.bounds;
        scope.viewport = placement.viewport;
        return scope;
    }

    public LayoutNodeDesc panelRoot(
        in Rect bounds,
        in LayoutDirection direction,
        in UiSkinInsets panelPadding,
        in f32 gap
    )const{
        LayoutNodeDesc description;
        description.direction = direction;
        description.width = LayoutSize(LayoutSizePolicy::Fixed, bounds.width);
        description.height = LayoutSize(LayoutSizePolicy::Fixed, bounds.height);
        description.padding = Insets(panelPadding.left, panelPadding.top, panelPadding.right, panelPadding.bottom);
        description.gap = gap;
        return description;
    }

    public LayoutNodeDesc container(
        in LayoutDirection direction,
        in ContainerOptions options
    )const{
        LayoutNodeDesc description;
        description.direction = direction;
        description.width = options.width;
        description.height = options.height;
        description.padding = options.padding;
        description.gap = options.gap;
        return description;
    }
};

b8 MatchesContextMenuFrameStateValues(
    in b8 popupAncestorsVisible,
    in u64 stateRevision,
    in u64 expectedRevision,
    in b8 isOpen,
    in b8 expectedOpen,
    in u64 popupInstanceGeneration,
    in u64 expectedPopupInstanceGeneration,
    in u64 popupOpenGeneration,
    in u64 expectedPopupOpenGeneration,
    in PopupToken popupParent,
    in PopupToken expectedParentToken,
    in u64 listInputGeneration,
    in u64 expectedListInstanceGeneration,
    in WidgetId owner,
    in WidgetId expectedOwner,
    in u64 ownerDeclaration,
    in u64 expectedOwnerDeclaration,
    in WidgetId anchorWidget,
    in WidgetId expectedAnchorWidget,
    in u64 anchorDeclaration,
    in u64 expectedAnchorDeclaration
){
    return popupAncestorsVisible
        && stateRevision == expectedRevision
        && isOpen == expectedOpen
        && popupInstanceGeneration == expectedPopupInstanceGeneration
        && popupOpenGeneration == expectedPopupOpenGeneration
        && popupParent == expectedParentToken
        && listInputGeneration == expectedListInstanceGeneration
        && owner == expectedOwner
        && ownerDeclaration == expectedOwnerDeclaration
        && anchorWidget == expectedAnchorWidget
        && anchorDeclaration == expectedAnchorDeclaration;
}

b8 IsComboActionEligibleToOpen(in ControlActionKind kind){
    return kind == ControlActionKind::Submit || kind == ControlActionKind::Up || kind == ControlActionKind::Down;
}

b8 ShouldIgnoreComboEditorAction(
    in b8 fromEditor,
    in b8 compositionActive,
    in ControlActionKind kind,
    in b8 editorSubmitted
){
    return fromEditor && (compositionActive || (kind == ControlActionKind::Submit && !editorSubmitted));
}

u8 SelectNextSliderInputStream(
    in b8 hasControl,
    in u64 controlSequence,
    in b8 hasTrack,
    in u64 trackSequence,
    in b8 hasThumb,
    in u64 thumbSequence
){
    if(hasControl && (!hasTrack || controlSequence < trackSequence) && (!hasThumb || controlSequence < thumbSequence))
        return 0u;
    if(hasTrack && (!hasThumb || trackSequence < thumbSequence))
        return 1u;
    return 2u;
}

f32 ComputeListRowPaddedHeight(in f32 textHeight, in Insets padding, in f32 currentHeight){
    const f32 paddedHeight = (textHeight + padding.top) + padding.bottom;
    return Max(currentHeight, paddedHeight);
}


