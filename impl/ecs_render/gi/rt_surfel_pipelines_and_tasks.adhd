b8 SurfelGiPipelineSet::ensureSurfelTraceBuildArgsPipeline(){
    return __hidden_surfel_pipelines::EnsureSurfelComputePipeline(
        m_arena,
        m_graphics.getDevice(),
        m_shaderSystem,
