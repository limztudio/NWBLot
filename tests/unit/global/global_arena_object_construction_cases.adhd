NWB_ADHD_GTEST(ArenaObjectConstruction, RawObjectFailureReleasesAlignedStorageAndConstructedMembers, VerifyArenaObjectConstruction_RawObjectFailureReleasesAlignedStorageAndConstructedMembers)
NWB_ADHD_GTEST(ArenaObjectConstruction, GenericUniqueObjectFailureReleasesAlignedStorageAndConstructedMembers, VerifyArenaObjectConstruction_GenericUniqueObjectFailureReleasesAlignedStorageAndConstructedMembers)
NWB_ADHD_GTEST(ArenaObjectConstruction, GlobalUniqueObjectFailureReleasesAlignedStorageAndConstructedMembers, VerifyArenaObjectConstruction_GlobalUniqueObjectFailureReleasesAlignedStorageAndConstructedMembers)
NWB_ADHD_GTEST(ArenaObjectConstruction, PersistentUniqueObjectFailureReleasesAlignedStorageAndConstructedMembers, VerifyArenaObjectConstruction_PersistentUniqueObjectFailureReleasesAlignedStorageAndConstructedMembers)
NWB_ADHD_GTEST(ArenaObjectConstruction, GenericArrayFailureDestroysOnlyCompletedElementsAndReleasesStorage, VerifyArenaObjectConstruction_GenericArrayFailureDestroysOnlyCompletedElementsAndReleasesStorage)
NWB_ADHD_GTEST(ArenaObjectConstruction, GlobalArrayFailureDestroysOnlyCompletedElementsAndReleasesStorage, VerifyArenaObjectConstruction_GlobalArrayFailureDestroysOnlyCompletedElementsAndReleasesStorage)
NWB_ADHD_GTEST(ArenaObjectConstruction, PersistentArrayFailureDestroysOnlyCompletedElementsAndReleasesStorage, VerifyArenaObjectConstruction_PersistentArrayFailureDestroysOnlyCompletedElementsAndReleasesStorage)
NWB_ADHD_GTEST(ArenaObjectConstruction, NestedFactorySuccessIsDestroyedWhenOuterConstructionThrows, VerifyArenaObjectConstruction_NestedFactorySuccessIsDestroyedWhenOuterConstructionThrows)
NWB_ADHD_GTEST(ArenaObjectConstruction, FailedRawAllocationsNeverRunConstructorsOrDestructors, VerifyArenaObjectConstruction_FailedRawAllocationsNeverRunConstructorsOrDestructors)
NWB_ADHD_GTEST(ArenaObjectConstruction, ArenaFactoriesRetainStorageIdentityAndBypassClassAllocationHooks, VerifyArenaObjectConstruction_ArenaFactoriesRetainStorageIdentityAndBypassClassAllocationHooks)
NWB_ADHD_GTEST(ArenaObjectConstruction, ArgumentTemporaryFailureDestroysCompletedMembersBeforeReleasingArenaStorage, VerifyArenaObjectConstruction_ArgumentTemporaryFailureDestroysCompletedMembersBeforeReleasingArenaStorage)
NWB_ADHD_GTEST(ArenaObjectConstruction, CanonicalPrivateDestructorsRetainOwningRollbackAndRawConstructionAccess, VerifyArenaObjectConstruction_CanonicalPrivateDestructorsRetainOwningRollbackAndRawConstructionAccess)
NWB_ADHD_GTEST(ArenaObjectConstruction, IndividualDeleterFriendRetainsCompletedRollbackAndNormalOwningDestruction, VerifyArenaObjectConstruction_IndividualDeleterFriendRetainsCompletedRollbackAndNormalOwningDestruction)
NWB_ADHD_GTEST(ArenaObjectConstruction, PolymorphicTransfersRetainCompleteAllocationAcrossVirtualBases, VerifyArenaObjectConstruction_PolymorphicTransfersRetainCompleteAllocationAcrossVirtualBases)
NWB_ADHD_GTEST(ArenaObjectConstruction, StatefulCleanupSurvivesPreallocatedOwnerReentry, VerifyArenaObjectConstruction_StatefulCleanupSurvivesPreallocatedOwnerReentry)


