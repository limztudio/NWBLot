#include <utilities/fbx_to_nwb/module.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StringView SelectOptionListSeparator(in b8 isLast){
    if(isLast)
        return s_OptionLastSeparatorText;
    return s_OptionSeparatorText;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_FBX_TO_NWB_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_common{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


inline constexpr Array<OutputAssetType::Enum, 5u> s_OutputAssetTypeValues = { OutputAssetType::Bunch, OutputAssetType::Mesh, OutputAssetType::Model, OutputAssetType::Skeleton, OutputAssetType::Skin };
inline constexpr Array<NormalMode::Enum, 3u> s_NormalModeValues = { NormalMode::Imported, NormalMode::Smooth, NormalMode::Regenerate };


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


template<typename EnumT, typename TextFunction>
[[nodiscard]] ScratchString BuildOptionTexts(const Span<const EnumT> values, TextFunction textFunction, Core::Alloc::ScratchArena& scratchArena){
    usize capacity = 0u;
    for(usize i = 0u; i < values.size(); ++i){
        if(i > 0u)
            capacity = AddSize(capacity, SelectOptionListSeparator(i + 1u == values.size()).size());
        capacity = AddSize(capacity, textFunction(values[i]).size());
    }
    ScratchString text(scratchArena);
    text.reserve(capacity);
    for(usize i = 0u; i < values.size(); ++i){
        if(i > 0u)
            text += SelectOptionListSeparator(i + 1u == values.size());
        text += textFunction(values[i]);
    }
    return text;
}

template<typename TextFunction, typename ParseFunction>
b8 ValidateOptionText(TextFunction textFunction, ParseFunction parseValue, UtilityString& inOutValue){
    const auto parsed = parseValue(AStringView(inOutValue));
    if(parsed){
        inOutValue.assign(textFunction(*parsed));
        return true;
    }

    inOutValue = NormalizeOptionText(Move(inOutValue));
    return false;
}

template<typename OptionsTextFunction>
[[nodiscard]] ScratchString BuildOptionErrorText(const AStringView prefix, OptionsTextFunction optionsTextFunction, Core::Alloc::ScratchArena& scratchArena){
    const ScratchString options = optionsTextFunction(scratchArena);
    ScratchString message(prefix, scratchArena);
    message.reserve(AddSize(message.size(), options.size()));
    message += options;
    return message;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


ScratchString OutputAssetTypeOptionsText(Core::Alloc::ScratchArena& scratchArena){
    return __hidden_common::BuildOptionTexts(Span<const OutputAssetType::Enum>(__hidden_common::s_OutputAssetTypeValues), OutputAssetTypeText, scratchArena);
}

ScratchString OutputAssetTypeErrorText(Core::Alloc::ScratchArena& scratchArena){
    return __hidden_common::BuildOptionErrorText("Asset type must be ", OutputAssetTypeOptionsText, scratchArena);
}

Expected<OutputAssetType::Enum> ParseAssetTypeText(const AStringView value)noexcept{
    return ParseOptionText(value, Span<const OutputAssetType::Enum>(__hidden_common::s_OutputAssetTypeValues), OutputAssetTypeText);
}

b8 ValidateAssetTypeText(UtilityString& inOutValue){
    return __hidden_common::ValidateOptionText(OutputAssetTypeText, ParseAssetTypeText, inOutValue);
}

ScratchString NormalModeOptionsText(Core::Alloc::ScratchArena& scratchArena){
    return __hidden_common::BuildOptionTexts(Span<const NormalMode::Enum>(__hidden_common::s_NormalModeValues), NormalModeText, scratchArena);
}

ScratchString NormalModeErrorText(Core::Alloc::ScratchArena& scratchArena){
    return __hidden_common::BuildOptionErrorText("normal mode must be ", NormalModeOptionsText, scratchArena);
}

Expected<NormalMode::Enum> ParseNormalModeText(const AStringView value)noexcept{
    return ParseOptionText(value, Span<const NormalMode::Enum>(__hidden_common::s_NormalModeValues), NormalModeText);
}

b8 ValidateNormalModeText(UtilityString& inOutValue){
    return __hidden_common::ValidateOptionText(NormalModeText, ParseNormalModeText, inOutValue);
}

Expected<Vec4> ParseColorText(const AStringView text, Core::Alloc::ScratchArena& scratchArena){
    ScratchString normalized(text, scratchArena);
    Replace(normalized.begin(), normalized.end(), ',', ' ');
    ScratchStringStream in(normalized, ScratchStringStream::in, scratchArena);

    f32 red = 0.0f;
    f32 green = 0.0f;
    f32 blue = 0.0f;
    f32 alpha = 0.0f;
    if(!(in >> red >> green >> blue >> alpha))
        return MakeUnexpected(Failure{});

    ScratchString trailing(scratchArena);
    if(in >> trailing)
        return MakeUnexpected(Failure{});

    return TryMakeFiniteColorVec4(red, green, blue, alpha);
}

ScratchPath DefaultOutputPath(const AStringView inputPath, Core::Alloc::ScratchArena& scratchArena){
    ScratchPath outputPath(scratchArena, inputPath);
    outputPath.replaceExtension(Core::Assets::s_NwbExtension);
    return outputPath;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_FBX_TO_NWB_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


