const u32 s_CausticHwPhotonGridSide = 512u;
// Resolve exposure; photon-count changes preserve brightness.
const f32 s_CausticIntensity = 2.0f;
// Runtime refractor bounds are inflated because emission uses bind-pose AABBs.
const f32 s_CausticRuntimeBoundsInflation = 1.25f;
// Conservative top-level bounds for transparent-shadow rays.
const f32 s_SwShadowSceneBoundsMinPadding = 0.25f;
const f32 s_SwShadowSceneBoundsRelativePadding = 0.10f;

class RayTracingDispatchGroups{
    public u32 x = 0u;
    public u32 y = 0u;
}

RayTracingDispatchGroups ResolveRayTracingDispatchGroups(in u32 width, in u32 height, in u32 receiverFactor, in u32 groupSize){
    const u32 receiverWidth = (width + receiverFactor - 1u) / receiverFactor;
    const u32 receiverHeight = (height + receiverFactor - 1u) / receiverFactor;
    RayTracingDispatchGroups groups;
    groups.x = divideUp(receiverWidth, groupSize);
    groups.y = divideUp(receiverHeight, groupSize);
    return groups;
}


