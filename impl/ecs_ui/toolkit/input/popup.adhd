////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/id.adhd>
#include <impl/ecs_ui/toolkit/paint_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_InputMaxPopups = 8u;
const usize s_MaxNestedPopupFrames = s_InputMaxPopups - 1u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> PopupDismissReason{
    None,
    Cancel,
    OutsideClick,
    FocusTraversal,
    FocusLost,
}

class PopupToken{
    public b8 operator==(in PopupToken rhs)const{
        return this.widget == rhs.widget && this.declarationGeneration == rhs.declarationGeneration && this.instanceGeneration == rhs.instanceGeneration && this.openGeneration == rhs.openGeneration;
    }

    public b8 operator!=(in PopupToken rhs)const{
        return this.widget != rhs.widget || this.declarationGeneration != rhs.declarationGeneration || this.instanceGeneration != rhs.instanceGeneration || this.openGeneration != rhs.openGeneration;
    }

    public b8 valid()const{
        return this.widget.valid() && this.declarationGeneration != 0u && this.instanceGeneration != 0u && this.openGeneration != 0u;
    }

    public b8 empty()const{
        return !this.widget.valid() && this.declarationGeneration == 0u && this.instanceGeneration == 0u && this.openGeneration == 0u;
    }

    public WidgetId widget;
    public u64 declarationGeneration = 0u;
    public u64 instanceGeneration = 0u;
    public u64 openGeneration = 0u;
}

class PopupScope{
    public PopupToken token;
    public Rect bounds;
    public Rect viewport;
    public u32 layer = 0u;
    public b8 dismissOutside = true;
    public b8 dismissCancel = true;
    public b8 dismissFocusTraversal = false;
    public b8 autofocus = true;
    public PopupToken parent;
    public WidgetId focusAnchor;
    public u64 focusAnchorDeclarationGeneration = 0u;
}

class PopupDismissal{
    public PopupToken token;
    public PopupDismissReason reason = PopupDismissReason::None;
}

class PopupRecord{
    public PopupScope scope;
    public WidgetId restoreFocus;
    public u64 restoreDeclaration = 0u;
    public PopupToken restorePopup;
    public b8 closing = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 HasValidPopupScopeGeometry(in PopupScope scope){
    if(
        !IsFinite(scope.bounds.x) || !IsFinite(scope.bounds.y) || !IsFinite(scope.bounds.width) || !IsFinite(scope.bounds.height)
        || !IsFinite(scope.viewport.x) || !IsFinite(scope.viewport.y) || !IsFinite(scope.viewport.width) || !IsFinite(scope.viewport.height)
        || scope.bounds.width <= 0.0f || scope.bounds.height <= 0.0f || scope.viewport.width <= 0.0f || scope.viewport.height <= 0.0f
    )
        return false;
    const f32 boundsRight = scope.bounds.x + scope.bounds.width;
    const f32 boundsBottom = scope.bounds.y + scope.bounds.height;
    const f32 viewportRight = scope.viewport.x + scope.viewport.width;
    const f32 viewportBottom = scope.viewport.y + scope.viewport.height;
    return IsFinite(boundsRight) && IsFinite(boundsBottom) && IsFinite(viewportRight) && IsFinite(viewportBottom) && scope.bounds.x >= scope.viewport.x && scope.bounds.y >= scope.viewport.y && boundsRight <= viewportRight && boundsBottom <= viewportBottom;
}

b8 CanDismissPopupScope(in PopupScope scope, in b8 closing, in PopupDismissReason reason){
    if(closing || reason <= PopupDismissReason::None || reason > PopupDismissReason::FocusLost)
        return false;
    if(reason == PopupDismissReason::Cancel && !scope.dismissCancel)
        return false;
    if(reason == PopupDismissReason::OutsideClick && !scope.dismissOutside)
        return false;
    if(reason == PopupDismissReason::FocusTraversal && !scope.dismissFocusTraversal)
        return false;
    return true;
}

b8 IsPopupTokenDescendant(in Span<PopupRecord> popups, in PopupToken token, in PopupToken ancestor){
    PopupToken current = token;
    for(usize depth = 0u; depth < s_InputMaxPopups && current.valid(); ++depth){
        if(current == ancestor)
            return true;
        b8 found = false;
        for(usize index = 0u; index < popups.size(); ++index){
            if(popups[index].scope.token == current){
                current = popups[index].scope.parent;
                found = true;
                break;
            }
        }
        if(!found)
            return false;
    }
    return false;
}

b8 ValidateStagedPopupScopes(in Span<PopupScope> scopes, in Span<PopupRecord> existingPopups){
    const usize count = scopes.size();
    if(count > s_InputMaxPopups)
        return false;
    for(usize index = 0u; index < count; ++index){
        const PopupScope scope = scopes[index];
        if(
            !scope.token.valid() || !HasValidPopupScopeGeometry(scope)
            || scope.layer == 0u || (index != 0u && scope.layer <= scopes[index - 1u].layer)
            || (scope.dismissFocusTraversal && (!scope.focusAnchor.valid() || scope.focusAnchorDeclarationGeneration == 0u))
        )
            return false;
        for(usize previous = 0u; previous < index; ++previous){
            if(scopes[previous].token.widget == scope.token.widget)
                return false;
        }
        if(!scope.parent.empty()){
            b8 parent = false;
            for(usize previous = 0u; previous < index; ++previous)
                parent = parent || (scopes[previous].token == scope.parent);
            if(!scope.parent.valid() || !parent)
                return false;
        }
        // A child cannot reuse its open lifetime beneath a different ancestor lifetime.
        for(usize previous = 0u; previous < existingPopups.size(); ++previous){
            if(existingPopups[previous].scope.token == scope.token && existingPopups[previous].scope.parent != scope.parent)
                return false;
        }
    }
    return true;
}

void BindPopupParentState(
    in PopupToken parent,
    in u64 openGeneration,
    mut b8 inOutOpen,
    mut b8 inOutParentBound,
    mut PopupToken inOutParent,
    mut u64 inOutParentOpenGeneration
){
    if(inOutParentBound && inOutParent != parent && inOutParentOpenGeneration == openGeneration)
        inOutOpen = false;
    inOutParent = parent;
    inOutParentBound = true;
    inOutParentOpenGeneration = openGeneration;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

