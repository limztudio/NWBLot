f32 AabbPairMinDistanceSq(in VectorSingle minA, in VectorSingle maxA, in VectorSingle minB, in VectorSingle maxB){
    const VectorSingle dMin = Max(minA - maxB, VectorSingle(0.0f));
    const VectorSingle dMax = Max(minB - maxA, VectorSingle(0.0f));
    const VectorSingle d = dMin + dMax;
    return Vector3LengthSq(d).x;
}

Expected<DistanceOutput> ComputeInfinitePlaneVsInfinitePlaneDistance(
    in PlaneShape plA,
    in VectorSingle posA,
    in VectorSingle rotA,
    in PlaneShape plB,
    in VectorSingle posB,
    in VectorSingle rotB
){
    const VectorSingle up(0.0f, 1.0f, 0.0f, 0.0f);
    const VectorSingle nA = SafeNormalizeVec3(Vector3Rotate(plA.normal(), rotA), up);
    const VectorSingle p0A = TransformPointValues(posA, rotA, plA.normal() * plA.offset());
    const VectorSingle nB = SafeNormalizeVec3(Vector3Rotate(plB.normal(), rotB), up);
    const VectorSingle p0B = TransformPointValues(posB, rotB, plB.normal() * plB.offset());
    const f32 dA = Vector3Dot(nA, p0A).x;
    const f32 dB = Vector3Dot(nB, p0B).x;
    const f32 dotN = Vector3Dot(nA, nB).x;
    DistanceOutput outD;
    if(dotN < -0.9999f){
        const f32 sep = -(dA + dB);
        if(sep > 0.0f){
            outD.pointADistance = f32x4(p0A, sep);
            outD.pointB = f32x4(p0A + nA * sep, 0.0f);
            outD.normalIterations = f32x3_u32(nA.x, nA.y, nA.z, 1u);
            return outD;
        }
        outD.pointADistance = f32x4(p0A, 0.0f);
        outD.pointB = f32x4(p0A, 0.0f);
        outD.normalIterations = f32x3_u32(nA.x, nA.y, nA.z, 1u);
        return outD;
    }
    if(dotN > 0.9999f){
        VectorSingle deepPt = p0A;
        if(dB < dA)
            deepPt = p0B;
        outD.pointADistance = f32x4(deepPt, 0.0f);
        outD.pointB = f32x4(deepPt, 0.0f);
        outD.normalIterations = f32x3_u32(nA.x, nA.y, nA.z, 1u);
        return outD;
    }
    const f32 denom = 1.0f - dotN * dotN;
    VectorSingle linePt = p0A;
    if(denom > 1.0e-6f){
        const f32 c1 = (dA - dB * dotN) / denom;
        const f32 c2 = (dB - dA * dotN) / denom;
        linePt = nA * c1 + nB * c2;
    }
    outD.pointADistance = f32x4(linePt, 0.0f);
    outD.pointB = f32x4(linePt, 0.0f);
    outD.normalIterations = f32x3_u32(nA.x, nA.y, nA.z, 1u);
    return outD;
}

Expected<DistanceOutput> ComputeInfinitePlaneMeshDistance(
    in PlaneShape pl,
    in VectorSingle posPlane,
    in VectorSingle rotPlane,
    in MeshShape mesh,
    in VectorSingle posMesh,
    in VectorSingle rotMesh,
    in b8 flipOrder
){
    if(mesh.nodes.empty() || mesh.triangles.empty())
        return MakeUnexpected(Failure());
    const VectorSingle up(0.0f, 1.0f, 0.0f, 0.0f);
    const VectorSingle worldPlaneN = SafeNormalizeVec3(Vector3Rotate(pl.normal(), rotPlane), up);
    const VectorSingle planeOriginW = TransformPointValues(posPlane, rotPlane, pl.normal() * pl.offset());
    const VectorSingle planeNInM = SafeNormalizeVec3(Vector3InverseRotate(worldPlaneN, rotMesh), up);
    const VectorSingle planePtInM = InverseTransformPointValues(posMesh, rotMesh, planeOriginW);
    const f32 planeDInM = Vector3Dot(planeNInM, planePtInM).x;
    const f32 meshR = mesh.radius();

    b8 foundAny = false;
    f32 minSd = s_MaxF32;
    VectorSingle bestPtM(0.0f);

    BvhSpillStack<u32, 256u> stack;
    stack.push(0u);
    u32 nodeIdx = 0u;
    while(stack.pop(nodeIdx)){
        in MeshBvhNode node = mesh.nodes[nodeIdx];
        const f32 nodeMinSd = ComputeAabbMinSignedDistToPlaneValues(VectorSingle(node.aabbMinLeft, 0.0f), VectorSingle(node.aabbMaxRight, 0.0f), planeNInM, planeDInM) - meshR;
        if(foundAny && nodeMinSd >= minSd)
            continue;
        if(node.isLeaf()){
            const u32 firstTri = node.leftOrFirst();
            const u32 endTri = firstTri + node.rightOrCount();
            for(u32 ti = firstTri; ti < endTri; ++ti){
                in MeshTriangle tri = mesh.triangles[ti];
                Array<f32x3u, 3u> triPts;
                triPts[0u] = tri.v0;
                triPts[1u] = tri.v1;
                triPts[2u] = tri.v2;
                for(u32 vi = 0u; vi < 3u; ++vi){
                    const VectorSingle v(triPts[vi], 0.0f);
                    const f32 sd = Vector3Dot(planeNInM, v).x - planeDInM - meshR;
                    if(!foundAny || sd < minSd){
                        foundAny = true;
                        minSd = sd;
                        bestPtM = v - planeNInM * meshR;
                    }
                }
            }
        }
        else{
            const u32 leftIdx = node.leftOrFirst();
            const u32 rightIdx = node.rightOrCount();
            in MeshBvhNode leftNode = mesh.nodes[leftIdx];
            in MeshBvhNode rightNode = mesh.nodes[rightIdx];
            const f32 lMinSd = ComputeAabbMinSignedDistToPlaneValues(VectorSingle(leftNode.aabbMinLeft, 0.0f), VectorSingle(leftNode.aabbMaxRight, 0.0f), planeNInM, planeDInM) - meshR;
            const f32 rMinSd = ComputeAabbMinSignedDistToPlaneValues(VectorSingle(rightNode.aabbMinLeft, 0.0f), VectorSingle(rightNode.aabbMaxRight, 0.0f), planeNInM, planeDInM) - meshR;
            if(lMinSd < rMinSd){
                if(!foundAny || rMinSd < minSd)
                    stack.push(rightIdx);
                if(!foundAny || lMinSd < minSd)
                    stack.push(leftIdx);
            }
            else{
                if(!foundAny || lMinSd < minSd)
                    stack.push(leftIdx);
                if(!foundAny || rMinSd < minSd)
                    stack.push(rightIdx);
            }
        }
    }
    if(!foundAny)
        return MakeUnexpected(Failure());

    const VectorSingle ptMeshW = TransformPointValues(posMesh, rotMesh, bestPtM);
    const f32 signedGap = Vector3Dot(VectorSingle(ptMeshW - planeOriginW, 0.0f), worldPlaneN).x;
    const f32 dist = Max(0.0f, signedGap);
    const VectorSingle ptPlaneW = ptMeshW - worldPlaneN * signedGap;
    DistanceOutput outD;
    if(flipOrder){
        outD.pointADistance = f32x4(ptMeshW, dist);
        outD.pointB = f32x4(ptPlaneW, 0.0f);
        outD.normalIterations = f32x3_u32(-worldPlaneN.x, -worldPlaneN.y, -worldPlaneN.z, 1u);
    }
    else{
        outD.pointADistance = f32x4(ptPlaneW, dist);
        outD.pointB = f32x4(ptMeshW, 0.0f);
        outD.normalIterations = f32x3_u32(worldPlaneN.x, worldPlaneN.y, worldPlaneN.z, 1u);
    }
    return outD;
}

Expected<DistanceOutput> ComputeInfinitePlaneHeightfieldDistance(
    in PlaneShape pl,
    in VectorSingle posPlane,
    in VectorSingle rotPlane,
    in HeightfieldShape hf,
    in VectorSingle posHf,
    in VectorSingle rotHf,
    in b8 flipOrder
){
    if(!hf.isValid())
        return MakeUnexpected(Failure());
    const VectorSingle up(0.0f, 1.0f, 0.0f, 0.0f);
    const VectorSingle worldPlaneN = SafeNormalizeVec3(Vector3Rotate(pl.normal(), rotPlane), up);
    const VectorSingle planeOriginW = TransformPointValues(posPlane, rotPlane, pl.normal() * pl.offset());
    const VectorSingle planeNInHf = SafeNormalizeVec3(Vector3InverseRotate(worldPlaneN, rotHf), up);
    const VectorSingle planePtInHf = InverseTransformPointValues(posHf, rotHf, planeOriginW);
    const f32 planeDInHf = Vector3Dot(planeNInHf, planePtInHf).x;
    const f32 thick = hf.thickness;

    b8 foundAny = false;
    f32 minSd = s_MaxF32;
    VectorSingle bestPtHf(0.0f);

    const u32 cellCols = hf.cols - 1u;
    const u32 cellRows = hf.rows - 1u;
    if(!hf.hierarchy.empty()){
        const f32 ox = hf.originMaxY.x;
        const f32 oz = hf.originMaxY.z;
        const f32 sx = hf.cellSizeX();
        const f32 sz = hf.cellSizeZ();
        const usize topLvl = hf.hierarchy.size() - 1u;
        in HeightfieldMipLevel topMip = hf.hierarchy[topLvl];
        BvhSpillStack<u64, 128u> stack;
        for(u32 bz = 0u; bz < topMip.rows; ++bz){
            for(u32 bx = 0u; bx < topMip.cols; ++bx){
                in f32x2u tmm = topMip.minMaxY[cast<usize>(bz) * cast<usize>(topMip.cols) + cast<usize>(bx)];
                if(tmm.x <= tmm.y)
                    stack.push((cast<u64>(topLvl) << 58u) | (cast<u64>(bz) << 29u) | cast<u64>(bx));
            }
        }
        u64 packedNode = 0u;
        while(stack.pop(packedNode)){
            const u32 lvl = cast<u32>(packedNode >> 58u);
            const u32 bz = cast<u32>((packedNode >> 29u) & 0x1fffffffu);
            const u32 bx = cast<u32>(packedNode & 0x1fffffffu);
            in HeightfieldMipLevel mip = hf.hierarchy[lvl];
            if(bx >= mip.cols || bz >= mip.rows)
                continue;
            const f32x2u mm = mip.minMaxY[cast<usize>(bz) * cast<usize>(mip.cols) + cast<usize>(bx)];
            if(mm.x > mm.y)
                continue;
            const u32 span = 1u << (lvl + 1u);
            const u32 c0 = bx * span;
            const u32 r0 = bz * span;
            const u32 c1 = Min(c0 + span, cellCols);
            const u32 r1 = Min(r0 + span, cellRows);
            const VectorSingle bMin(ox + cast<f32>(c0) * sx, mm.x, oz + cast<f32>(r0) * sz, 0.0f);
            const VectorSingle bMax(ox + cast<f32>(c1) * sx, mm.y, oz + cast<f32>(r1) * sz, 0.0f);
            const f32 blockMinSd = ComputeAabbMinSignedDistToPlaneValues(bMin, bMax, planeNInHf, planeDInHf) - thick;
            if(foundAny && blockMinSd >= minSd)
                continue;
            if(lvl == 0u){
                u16 localBlockMask = 0u;
                for(u32 cz = r0; cz < r1; ++cz){
                    for(u32 cx = c0; cx < c1; ++cx){
                        if(hf.isCellHole(cx, cz))
                            continue;
                        for(u32 dz = 0u; dz < 2u; ++dz){
                            const u32 vz = cz + dz;
                            const u32 lz = vz - r0;
                            const f32 pz = oz + cast<f32>(vz) * sz;
                            for(u32 dx = 0u; dx < 2u; ++dx){
                                const u32 vx = cx + dx;
                                const u16 vBit = cast<u16>(1u << (lz * 3u + (vx - c0)));
                                if((localBlockMask & vBit) != 0u)
                                    continue;
                                localBlockMask |= vBit;
                                const f32 rawH = hf.heights[cast<usize>(vz) * cast<usize>(hf.cols) + cast<usize>(vx)];
                                const VectorSingle v(ox + cast<f32>(vx) * sx, hf.originMaxY.y + rawH * hf.scaleMinMaxY.y, pz, 0.0f);
                                const f32 sd = Vector3Dot(planeNInHf, v).x - planeDInHf - thick;
                                if(!foundAny || sd < minSd){
                                    foundAny = true;
                                    minSd = sd;
                                    bestPtHf = v - planeNInHf * thick;
                                }
                            }
                        }
                    }
                }
            }
            else{
                const u32 childLvl = lvl - 1u;
                in HeightfieldMipLevel childMip = hf.hierarchy[childLvl];
                for(u32 dz = 0u; dz < 2u; ++dz){
                    const u32 cbz = bz * 2u + dz;
                    if(cbz >= childMip.rows)
                        continue;
                    for(u32 dx = 0u; dx < 2u; ++dx){
                        const u32 cbx = bx * 2u + dx;
                        if(cbx >= childMip.cols)
                            continue;
                        in f32x2u cmm = childMip.minMaxY[cast<usize>(cbz) * cast<usize>(childMip.cols) + cast<usize>(cbx)];
                        if(cmm.x <= cmm.y)
                            stack.push((cast<u64>(childLvl) << 58u) | (cast<u64>(cbz) << 29u) | cast<u64>(cbx));
                    }
                }
            }
        }
    }
    else{
        for(u32 cz = 0u; cz < cellRows; ++cz){
            for(u32 cx = 0u; cx < cellCols; ++cx){
                VectorSingle v00(0.0f);
                VectorSingle v10(0.0f);
                VectorSingle v01(0.0f);
                VectorSingle v11(0.0f);
                if(!LoadHeightfieldCellVertices(hf, cx, cz, v00, v10, v01, v11))
                    continue;
                Array<f32x4, 4u> verts;
                verts[0u] = f32x4(v00);
                verts[1u] = f32x4(v10);
                verts[2u] = f32x4(v01);
                verts[3u] = f32x4(v11);
                for(u32 vi = 0u; vi < 4u; ++vi){
                    const VectorSingle v(verts[vi], 0.0f);
                    const f32 sd = Vector3Dot(planeNInHf, v).x - planeDInHf - thick;
                    if(!foundAny || sd < minSd){
                        foundAny = true;
                        minSd = sd;
                        bestPtHf = v - planeNInHf * thick;
                    }
                }
            }
        }
    }
    if(!foundAny)
        return MakeUnexpected(Failure());

    const VectorSingle ptHfW = TransformPointValues(posHf, rotHf, bestPtHf);
    const f32 signedGap = Vector3Dot(VectorSingle(ptHfW - planeOriginW, 0.0f), worldPlaneN).x;
    const f32 dist = Max(0.0f, signedGap);
    const VectorSingle ptPlaneW = ptHfW - worldPlaneN * signedGap;
    DistanceOutput outD;
    if(flipOrder){
        outD.pointADistance = f32x4(ptHfW, dist);
        outD.pointB = f32x4(ptPlaneW, 0.0f);
        outD.normalIterations = f32x3_u32(-worldPlaneN.x, -worldPlaneN.y, -worldPlaneN.z, 1u);
    }
    else{
        outD.pointADistance = f32x4(ptPlaneW, dist);
        outD.pointB = f32x4(ptHfW, 0.0f);
        outD.normalIterations = f32x3_u32(worldPlaneN.x, worldPlaneN.y, worldPlaneN.z, 1u);
    }
    return outD;
}

class MeshDistBvhPair{
    public u32 nodeA = 0u;
    public u32 nodeB = 0u;
    public f32 lowerBoundSq = 0.0f;
}


void BuildConvexLocalAabbAndPoints(
    in ShapeProxyView pConvex,
    in VectorSingle posConvexInTarget,
    in VectorSingle rotConvexInTarget,
    mut b8 outUseLocalPts,
    mut FixedVector<f32x3u, s_MaxHullVertices> outPts,
    mut VectorSingle outMin,
    mut VectorSingle outMax
){
    outUseLocalPts = (pConvex.kind == ProxyKind::PointCloud && pConvex.points.size() <= s_MaxHullVertices);
    outPts.clear();
    outMin = VectorSingle(s_MaxF32);
    outMax = VectorSingle(-s_MaxF32);
    if(pConvex.kind == ProxyKind::PointCloud){
        for(usize pi = 0u; pi < pConvex.points.size(); ++pi){
            const VectorSingle lp = TransformPointValues(posConvexInTarget, rotConvexInTarget, VectorSingle(pConvex.points[pi], 0.0f));
            outMin = Min(outMin, lp);
            outMax = Max(outMax, lp);
            if(outUseLocalPts)
                outPts.push_back(f32x3u(lp));
        }
        return;
    }
    VectorSingle lMin(0.0f);
    VectorSingle lMax(0.0f);
    ComputeProxyViewLocalBounds(pConvex, lMin, lMax);
    for(u32 mask = 0u; mask < 8u; ++mask){
        f32 cx = lMin.x;
        f32 cy = lMin.y;
        f32 cz = lMin.z;
        if((mask & 1u) != 0u) cx = lMax.x;
        if((mask & 2u) != 0u) cy = lMax.y;
        if((mask & 4u) != 0u) cz = lMax.z;
        const VectorSingle lp = TransformPointValues(posConvexInTarget, rotConvexInTarget, VectorSingle(cx, cy, cz, 0.0f));
        outMin = Min(outMin, lp);
        outMax = Max(outMax, lp);
    }
}

void ComputeShapeProxyViewWorldAabbValues(
    in ShapeProxyView view,
    in VectorSingle xfPos,
    in VectorSingle xfRot,
    in f32 extraRadius,
    mut VectorSingle outMin,
    mut VectorSingle outMax
){
    if(view.kind == ProxyKind::PointCloud){
        const f32 rad = view.radius + extraRadius;
        const VectorSingle rVec(rad, rad, rad, 0.0f);
        if(view.points.empty()){
            outMin = xfPos - rVec;
            outMax = xfPos + rVec;
            return;
        }
        VectorSingle minP = TransformPointValues(xfPos, xfRot, VectorSingle(view.points[0u], 0.0f));
        VectorSingle maxP = minP;
        for(usize i = 1u; i < view.points.size(); ++i){
            const VectorSingle wp = TransformPointValues(xfPos, xfRot, VectorSingle(view.points[i], 0.0f));
            minP = Min(minP, wp);
            maxP = Max(maxP, wp);
        }
        outMin = minP - rVec;
        outMax = maxP + rVec;
        return;
    }
    VectorSingle lMin(0.0f);
    VectorSingle lMax(0.0f);
    ComputeProxyViewLocalBounds(view, lMin, lMax);
    TransformLocalAabbValuesToWorld(lMin, lMax, view.radius + extraRadius, xfPos, xfRot, outMin, outMax);
}

VectorSingle ComputeShapeProxyViewLocalCenter(in ShapeProxyView view){
    if(view.kind == ProxyKind::Cylinder || view.kind == ProxyKind::Cone)
        return VectorSingle(view.param0, 0.0f);
    if(view.kind == ProxyKind::TaperedCapsule)
        return (VectorSingle(view.param0, 0.0f) + VectorSingle(view.param1, 0.0f)) * 0.5f;
    if(view.points.empty())
        return VectorSingle(0.0f);
    VectorSingle sum(0.0f);
    for(usize i = 0u; i < view.points.size(); ++i)
        sum = sum + VectorSingle(view.points[i], 0.0f);
    return sum * (1.0f / cast<f32>(view.points.size()));
}

b8 LoadHeightfieldCellVerticesInCoreBound(
    in HeightfieldShape hf,
    in u32 cx,
    in u32 cz,
    in b8 hasBound,
    in VectorSingle cMin,
    in VectorSingle cMax,
    in f32 bestCoreBoundSq,
    mut VectorSingle outV00,
    mut VectorSingle outV10,
    mut VectorSingle outV01,
    mut VectorSingle outV11
){
    if(!LoadHeightfieldCellVertices(hf, cx, cz, outV00, outV10, outV01, outV11))
        return false;
    const VectorSingle hCol0(outV00.y, outV01.y, 0.0f, 0.0f);
    const VectorSingle hCol1(outV10.y, outV11.y, 0.0f, 0.0f);
    const VectorSingle hPairMin = Min(hCol0, hCol1);
    const VectorSingle hPairMax = Max(hCol0, hCol1);
    const f32 cellMinY = Min(hPairMin.x, hPairMin.y);
    const f32 cellMaxY = Max(hPairMax.x, hPairMax.y);
    if(hasBound && AabbPairMinDistanceSq(cMin, cMax, VectorSingle(outV00.x, cellMinY, outV00.z, 0.0f), VectorSingle(outV11.x, cellMaxY, outV11.z, 0.0f)) > bestCoreBoundSq)
        return false;
    return true;
}

void TraverseHeightfieldDistanceRings<EvalCellFn>(
    in HeightfieldShape hf,
    in VectorSingle cMin,
    in VectorSingle cMax,
    in b8 stopAtZero,
    in f32 initialBestSurfDist,
    mut f32 bestSurfDist,
    mut f32 bestCoreBoundSq,
    mut b8 outBestFound,
    mut b8 outHasBound,
    in EvalCellFn evalCell
){
    const u32 cellCols = hf.cols - 1u;
    const u32 cellRows = hf.rows - 1u;
    const f32 sx = hf.cellSizeX();
    const f32 sz = hf.cellSizeZ();
    const f32 ox = hf.originMaxY.x;
    const f32 oz = hf.originMaxY.z;
    const VectorSingle gridClamp = Clamp(
        VectorSingle((cMin.x - ox) / sx, (cMax.x - ox) / sx, (cMin.z - oz) / sz, (cMax.z - oz) / sz),
        VectorSingle(0.0f),
        VectorSingle(
            cast<f32>(cellCols) - 1.0e-4f,
            cast<f32>(cellCols) - 1.0e-4f,
            cast<f32>(cellRows) - 1.0e-4f,
            cast<f32>(cellRows) - 1.0e-4f
        )
    );
    const isize bx0 = cast<isize>(gridClamp.x);
    const isize bx1 = cast<isize>(gridClamp.y);
    const isize bz0 = cast<isize>(gridClamp.z);
    const isize bz1 = cast<isize>(gridClamp.w);
    const isize maxRing = cast<isize>(Max(cellCols, cellRows));

    for(isize ring = 0; ring <= maxRing; ++ring){
        if(stopAtZero && outBestFound && bestSurfDist <= 0.0f)
            break;
        if(ring == 0){
            for(isize cz = bz0; cz <= bz1; ++cz){
                for(isize cx = bx0; cx <= bx1; ++cx)
                    evalCell(cast<u32>(cx), cast<u32>(cz));
            }
            if(!outBestFound && outHasBound && bestSurfDist < initialBestSurfDist)
                outBestFound = true;
            continue;
        }

        const b8 hasTop = (bz0 >= ring);
        const b8 hasBot = (bz1 + ring < cast<isize>(cellRows));
        const b8 hasLeft = (bx0 >= ring);
        const b8 hasRight = (bx1 + ring < cast<isize>(cellCols));
        if(!hasTop && !hasBot && !hasLeft && !hasRight)
            break;

        if(outHasBound){
            f32 minSideSq = s_MaxF32;
            if(hasTop){
                const f32 dz = Max(0.0f, cMin.z - (oz + cast<f32>(bz0 - ring + 1) * sz));
                minSideSq = Min(minSideSq, dz * dz);
            }
            if(hasBot){
                const f32 dz = Max(0.0f, (oz + cast<f32>(bz1 + ring) * sz) - cMax.z);
                minSideSq = Min(minSideSq, dz * dz);
            }
            if(hasLeft){
                const f32 dx = Max(0.0f, cMin.x - (ox + cast<f32>(bx0 - ring + 1) * sx));
                minSideSq = Min(minSideSq, dx * dx);
            }
            if(hasRight){
                const f32 dx = Max(0.0f, (ox + cast<f32>(bx1 + ring) * sx) - cMax.x);
                minSideSq = Min(minSideSq, dx * dx);
            }
            if(minSideSq > bestCoreBoundSq)
                break;
        }

        const isize xSpan0 = Max(cast<isize>(0), bx0 - ring);
        const isize xSpan1 = Min(cast<isize>(cellCols) - 1, bx1 + ring);
        const isize zSpan0 = Max(cast<isize>(0), bz0 - ring + 1);
        const isize zSpan1 = Min(cast<isize>(cellRows) - 1, bz1 + ring - 1);
        if(hasTop){
            const u32 cz = cast<u32>(bz0 - ring);
            for(isize cx = xSpan0; cx <= xSpan1; ++cx)
                evalCell(cast<u32>(cx), cz);
        }
        if(hasBot){
            const u32 cz = cast<u32>(bz1 + ring);
            for(isize cx = xSpan0; cx <= xSpan1; ++cx)
                evalCell(cast<u32>(cx), cz);
        }
        if(hasLeft){
            const u32 cx = cast<u32>(bx0 - ring);
            for(isize cz = zSpan0; cz <= zSpan1; ++cz)
                evalCell(cx, cast<u32>(cz));
        }
        if(hasRight){
            const u32 cx = cast<u32>(bx1 + ring);
            for(isize cz = zSpan0; cz <= zSpan1; ++cz)
                evalCell(cx, cast<u32>(cz));
        }
        if(!outBestFound && outHasBound && bestSurfDist < initialBestSurfDist)
            outBestFound = true;
    }
}

void EvalHeightfieldDistanceCell(
    in HeightfieldShape hf,
    in u32 cx,
    in u32 cz,
    in u32 cellCols,
    in VectorSingle cMin,
    in VectorSingle cMax,
    in f32 combR,
    in ShapeProxyView convexViewInHf,
    in ShapeProxyView pConvex,
    in VectorSingle posConvexInHf,
    in VectorSingle rotConvexInHf,
    in b8 useLocalPts,
    mut b8 bestFound,
    mut DistanceOutput bestOut,
    mut f32 bestSurfDist,
    mut f32 bestCoreBoundSq,
    mut u32 bestKey
){
    VectorSingle v00(0.0f);
    VectorSingle v10(0.0f);
    VectorSingle v01(0.0f);
    VectorSingle v11(0.0f);
    if(!LoadHeightfieldCellVerticesInCoreBound(hf, cx, cz, bestFound, cMin, cMax, bestCoreBoundSq, v00, v10, v01, v11))
        return;

    const u32 cellBaseKey = (cz * cellCols + cx) * 2u;
    for(usize ti = 0u; ti < 2u; ++ti){
        VectorSingle tv0(0.0f);
        VectorSingle tv1(0.0f);
        VectorSingle tv2(0.0f);
        ExtractHeightfieldCellTriangle(hf.flipDiagonal, ti, v00, v10, v01, v11, tv0, tv1, tv2);
        Array<f32x3u, 3u> triPts;
        triPts[0u] = f32x3u(tv0);
        triPts[1u] = f32x3u(tv1);
        triPts[2u] = f32x3u(tv2);
        const ShapeProxyView triView = MakeSpanProxyView(Span<f32x3u>(triPts), hf.thickness);
        SimplexCache cache;
        DistanceOutput d;
        if(useLocalPts)
            d = ShapeDistanceLocalProxyViews(convexViewInHf, triView, true, cache);
        else
            d = ShapeDistanceProxyViews(pConvex, posConvexInHf, rotConvexInHf, triView, VectorSingle(0.0f), QuaternionIdentity(), true, cache);
        const f32 dist = d.distance();
        const u32 candKey = cellBaseKey + cast<u32>(ti);
        if(!bestFound || dist < bestSurfDist || (dist == bestSurfDist && candKey < bestKey)){
            bestFound = true;
            bestOut = d;
            bestSurfDist = dist;
            const f32 bound = dist + combR + 1.0e-4f;
            bestCoreBoundSq = bound * bound;
            bestKey = candKey;
        }
    }
}

