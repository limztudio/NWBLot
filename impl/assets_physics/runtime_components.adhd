#include <impl/assets_physics/components.adhd>
#include <impl/assets_physics/physics_component_binary_codec.adhd>
#include <impl/assets_physics/subsystem_component_codec.adhd>
#include <impl/assets_scene/component_asset_binary_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 LoadPhysicsComponentBinary(mut IComponent asset, in StringView context, in Span<u8> binary){
    if(!asset.checkVirtualPath(context))
        return false;
    const Expected<Span<u8>> payload = ComponentAssetBinaryCodec().unpackEnvelope(binary, asset.assetType());
    if(!payload.has_value())
        return false;
    return asset.loadComponentPayload(payload.value());
}

b8 RigidBodyComponentAsset::loadBinary(in Span<u8> binary){
    return LoadPhysicsComponentBinary(this, "RigidBodyComponentAsset::loadBinary", binary);
}

b8 RigidBodyComponentAsset::loadComponentPayload(in Span<u8> payload){
    Expected<RigidBodyComponent> result = PhysicsComponentBinaryCodec().deserializeRigidBody(payload);
    if(!result.has_value())
        return false;
    this.component = result.value();
    return true;
}

b8 RigidBodyComponentAsset::validatePayload()const{
    if(!this.checkVirtualPath("RigidBodyComponentAsset::validatePayload"))
        return false;
    return PhysicsComponentBinaryCodec().validateRigidBody(this.component, this.virtualPath());
}

b8 RigidBodyComponentAsset::serializeComponentPayload(mut Vector<u8> outPayload)const{
    return PhysicsComponentBinaryCodec().serializeRigidBody(this.component, outPayload);
}

b8 RigidBodyComponentAsset::appendValidatedComponentPayload(mut Vector<u8> outBinary)const{
    return PhysicsComponentBinaryCodec().appendRigidBodyValidated(this.component, outBinary);
}

