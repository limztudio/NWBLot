////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 FrameSetupReady(in b8 meshViewSetupReady, in b8 sceneShadingSetupReady){
    return meshViewSetupReady && sceneShadingSetupReady;
}

ShaderDrivenPushConstants ResolveShaderDrivenPushConstants(
    in u32 meshletCount,
    in u32 instanceIndex,
    in u32 materialConstantByteOffset,
    in b8 hasViewport,
    in f32x4 viewportRect,
    in f32x4 scissorRect,
    in MeshFrameHeapSlots frameHeapSlots,
    in u32 dispatchFlags
){
    ShaderDrivenPushConstants pushConstants;
    pushConstants.meshletCount = meshletCount;
    pushConstants.instanceIndex = instanceIndex;
    pushConstants.materialConstantByteOffset = materialConstantByteOffset;
    pushConstants.dispatchFlags = dispatchFlags;
    pushConstants.frameHeapSlots = frameHeapSlots;
    if(!hasViewport)
        return pushConstants;

    pushConstants.dispatchFlags |= (1u << 0u);
    pushConstants.viewportRect = viewportRect;
    pushConstants.scissorRect = scissorRect;
    return pushConstants;
}

TransparentDrawPushConstants ResolveTransparentDrawPushConstants(
    in ShaderDrivenPushConstants meshPushConstants,
    in RendererAvboitPushConstants avboitPushConstants,
    in u32 csgContextHeapSlot,
    in b8 refractionCapture
){
    TransparentDrawPushConstants pushConstants;
    pushConstants.mesh = meshPushConstants;
    pushConstants.avboit = avboitPushConstants;
    pushConstants.avboit.heapSlots[1u] = csgContextHeapSlot;
    if(refractionCapture){
        pushConstants.avboit.params = f32x4(
            pushConstants.avboit.params.x,
            pushConstants.avboit.params.y,
            pushConstants.avboit.params.z,
            s_AvboitRefractionCapture
        );
    }
    return pushConstants;
}


