void RadioGroupFixture::SetUp(){
    WidgetFixture::SetUp();
    configureRadioSkin();
    ASSERT_TRUE(m_skin.validatePayload());
    m_builder.setSkin(m_skin);
    m_state.select(10u);
}

void RadioGroupFixture::configureRadioSkin(const b8 fallbackOnly){
    configureSkin();
    UiSkin::RegionVector regions(m_arena);
    regions.assign(m_skin.regions().begin(), m_skin.regions().end());
    constexpr Array<StringView, 6> s_Names{ "radio.normal", "radio.checked", "radio.mark", "checkbox.normal", "checkbox.checked", "checkbox.mark" };
    for(u32 index = 0u; index < 6u; ++index){
        if(fallbackOnly && index < 3u)
            continue;
        UiSkinRegion region;
        const auto regionName = Name::FromText(s_Names[index]);
        ASSERT_TRUE(regionName);
        region.name = *regionName;
        region.rectangle = { 88u + index * 8u, 0u, 8u, 8u };
        if(index % 3u != 2u){
            region.minimumWidth = 24.0f;
            region.minimumHeight = 24.0f;
        }
        regions.push_back(Move(region));
    }
    m_skin.setAtlas(Core::Assets::AssetRef<Texture>("tests/ui/texture"), 144u, 16u, 1.0f, Move(regions));
}

b8 RadioGroupFixture::declare(const u64 generation, const RadioGroupOptions& options, const Rect& bounds){
    return declareSource(generation, m_source, m_state, options, bounds);
}

b8 RadioGroupFixture::declareSource(const u64 generation, const IListDataSource& source, RadioGroupState& state, const RadioGroupOptions& options, const Rect& bounds){
    if(!begin(generation) || !m_builder.beginPanel(s_RadioPanelKey, bounds))
        return false;
    m_result = m_builder.radioGroup(s_RadioGroupKey, source, state, options);
    return m_result.valid;
}

b8 RadioGroupFixture::prepare(const u64 generation, const RadioGroupOptions& options, const Rect& bounds){
    return declare(generation, options, bounds) && finishPanel();
}

b8 RadioGroupFixture::accept(const u64 generation, const RadioGroupOptions& options, const Rect& bounds){
    return prepare(generation, options, bounds) && m_context.commitFrame(generation);
}

WidgetId RadioGroupFixture::host()const{
    return id(s_RadioGroupKey, s_RadioPanelKey);
}

const RadioGroupChoicePlacement* RadioGroupFixture::choice(const u64 keyValue, const RadioGroupState& state)const noexcept{
    const RadioGroupPlacement& placement = state.placement();
    for(u32 index = 0u; index < placement.count; ++index){
        if(placement.rows[index].key == keyValue)
            return &placement.rows[index];
    }
    return nullptr;
}

Point RadioGroupFixture::choicePoint(const u64 keyValue)const noexcept{
    const RadioGroupChoicePlacement* item = choice(keyValue, m_state);
    return item ? UiWidgetTests::Center(item->rectangle) : Point{};
}

usize RadioGroupFixture::regionQuads(const DrawSnapshot& snapshot, const Name& name)const noexcept{
    const UiSkinRegion* region = m_skin.findRegion(name);
    if(!region)
        return 0u;
    constexpr f32 s_UvTolerance = 0.00000024f;
    const f32 atlasWidth = static_cast<f32>(m_skin.atlasWidth());
    // Lanes are left U and right U.
    const SIMDVectorSingle edges = VectorDivide(VectorSet(static_cast<f32>(region->rectangle.x), static_cast<f32>(region->rectangle.x + region->rectangle.width), 0.0f, 0.0f), VectorSet(atlasWidth, atlasWidth, 1.0f, 1.0f));
    usize count = 0u;
    for(const DrawCommand& command : snapshot.commands()){
        if(command.material != PaintMaterial::Skin)
            continue;
        for(u32 index = command.firstIndex; index + 5u < command.firstIndex + command.indexCount; index += 6u){
            const Vertex& first = snapshot.vertices()[snapshot.indices()[index]];
            const Vertex& opposite = snapshot.vertices()[snapshot.indices()[index + 2u]];
            if(Vector2LessOrEqual(VectorAbs(VectorSubtract(VectorSet(first.texCoord.x, opposite.texCoord.x, 0.0f, 0.0f), edges)), VectorReplicate(s_UvTolerance)))
                ++count;
        }
    }
    return count;
}


