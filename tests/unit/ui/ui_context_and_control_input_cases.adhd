    ASSERT_TRUE(self.m_context.beginFrame(2u));
    ASSERT_TRUE(self.m_context.beginRoot(original.root));
    const Expected<WidgetState> state = self.declareState(s_UiContextActionKey, WidgetKind::Button);
    ASSERT_TRUE(state.has_value());
    EXPECT_FALSE(self.m_context.takeActivation(state.value(), false));
    EXPECT_TRUE(self.m_context.input().actions().empty());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    HitTarget target = MakeUiContextButtonTarget();
    target.enabled = false;
