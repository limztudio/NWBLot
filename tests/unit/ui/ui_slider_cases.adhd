void VerifyUiSliderLifetimeTests_ChangedClipRetiresOldPointerGeometryEvenWhenTheFullTrackSizeIsUnchanged(mut UiSliderLifetimeTests self){
    ASSERT_TRUE(self.accept(1u));
    const Point origin = self.thumbPoint();
    const SliderPlacement before = self.m_state.placement();
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(origin, InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(Point(origin.x + 30.0f, origin.y), InputEventType::PointerMove)).pointerConsumed);
    ASSERT_TRUE(self.begin(2u, MakeUiSliderDisplayMetrics(180.0f, 600.0f, 1.0f, 1.0f)));
    ASSERT_TRUE(self.m_builder.beginPanel(s_UiSliderPanelKey, Rect(10.0f, 10.0f, 360.0f, 240.0f)));
    ASSERT_TRUE(self.m_builder.slider(s_UiSliderKey, self.m_state, MakeSliderFixtureOptions()));
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_FLOAT_EQ(self.m_state.placement().track.width, before.track.width);
    EXPECT_LT(self.m_state.placement().clip.width, before.clip.width);
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.25);
    EXPECT_FALSE(self.m_context.input().capture().valid());
}

