b8 BuildTestTextLogPayload(in LogTypeEnum type, in StringView message, mut ScratchArena scratchArena, mut TelemetryBytes outPayload){
    native(in type, in message, mut scratchArena, mut outPayload){
#if defined(FOUNDATION_UNICODE)
        const auto converted = ConvertString(scratchArena, message);
        return Core::Telemetry::BuildTextLogPayload(type, TStringView(converted), scratchArena, outPayload);
#else
        return Core::Telemetry::BuildTextLogPayload(type, TStringView(message), scratchArena, outPayload);
#endif
    }
}

b8 RecordTestTextLog(mut TelemetryRecorder recorder, in LogTypeEnum type, in StringView message, in u64 frameIndex, in u32 streamId){
    native(in type, in message, in frameIndex, in streamId, mut recorder){
#if defined(FOUNDATION_UNICODE)
        Core::Alloc::ScratchArena scratchArena{ s_TelemetryScratch };
        const auto converted = ConvertString(scratchArena, message);
        return Core::Telemetry::RecordTextLog(recorder, type, TStringView(converted), frameIndex, streamId);
#else
        return Core::Telemetry::RecordTextLog(recorder, type, TStringView(message), frameIndex, streamId);
#endif
    }
}

b8 RecordTestTextLog(mut TelemetryRecorder recorder, in LogTypeEnum type, in StringView message, in u64 frameIndex){
