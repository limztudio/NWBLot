class WholeAllocationCase{
    public ResourceCaseType resourceType;
    public ResourceCaseState readState;
    public ResourceCaseState finalState;

    public WholeAllocationCase(in ResourceCaseType resourceType, in ResourceCaseState readState, in ResourceCaseState finalState){
        this.resourceType = resourceType;
        this.readState = readState;
        this.finalState = finalState;
    }
}

class GpuTaskResourceCase{
    public ResourceCaseType resourceType;
    public Name identity;
    public StringView markerLabel;

    public GpuTaskResourceCase(in ResourceCaseType resourceType, in Name identity, in StringView markerLabel){
        this.resourceType = resourceType;
        this.identity = identity;
        this.markerLabel = markerLabel;
    }
}

class GpuTaskInitialOwnerCase{
    public ResourceCaseType resourceType;
    public ResourceCaseState initialState;
    public Name identity;
    public StringView markerLabel;

    public GpuTaskInitialOwnerCase(in ResourceCaseType resourceType, in ResourceCaseState initialState, in Name identity, in StringView markerLabel){
        this.resourceType = resourceType;
        this.initialState = initialState;
        this.identity = identity;
        this.markerLabel = markerLabel;
    }
}


class ExpectedBufferFragment{
    public usize stateIndex = 0u;
    public u64 offset = 0u;
    public u64 size = 0u;
}


class GraphStamp{
    public u64 generation = 0u;
    public u64 revision = 0u;
    public usize resources = 0u;
    public usize sets = 0u;
}


