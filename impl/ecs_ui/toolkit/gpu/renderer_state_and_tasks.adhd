#include <impl/ecs_ui/toolkit/gpu/renderer_internal.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanPrepareGpuPresentationFrame(in b8 acquiredValid, in b8 hasSharedResources, in u32 width, in u32 height){
    return acquiredValid && hasSharedResources && width != 0u && height != 0u;
}

u32 ResolveGpuPresentationMode(in b8 hdr10Active, in u32 hdr10Mode, in u32 sdrMode){
    if(hdr10Active)
        return hdr10Mode;
    return sdrMode;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
b8 EnsureGpuGeometryBuffer<TElement>(
    mut Device device,
    in usize requiredCount,
    in usize initialCapacity,
    in Name debugName,
    in b8 isVertexBuffer,
    mut BufferHandle inOutBuffer,
    mut usize inOutCapacity
){
    if(inOutCapacity >= requiredCount)
        return true;
    const usize capacity = ComputeGpuGrowingBufferCapacity(inOutCapacity, requiredCount, initialCapacity, size_of<TElement>());
    BufferDesc description;
    description.setByteSize(cast<u64>(capacity * size_of<TElement>())).setIsVertexBuffer(isVertexBuffer).setIsIndexBuffer(!isVertexBuffer)
        .setDebugName(debugName).enableAutomaticStateTracking(ResourceStates::Common)
        .setQueueSharing(ResourceQueueSharing::GraphicsAsyncComputeAndTransfer)
    ;
    auto bufferResult = device.createBuffer(description);
    if(!bufferResult.has_value())
        return false;
    inOutBuffer = bufferResult.value();
    inOutCapacity = capacity;
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 GpuRendererState::prepareBuffers(mut GpuFrameSlot slot, in DrawSnapshot snapshot){
    const usize vertexCount = snapshot.vertices().size();
    const usize indexCount = snapshot.indices().size();
    if(vertexCount == 0u && indexCount == 0u)
        return true;
    if(!IsValidGpuSnapshotBufferCounts(vertexCount, indexCount, size_of<Vertex>(), size_of<u32>()))
        return false;
    mut Device device = this.m_graphics.getDevice();
    return EnsureGpuGeometryBuffer<Vertex>(device, vertexCount, s_GpuInitialVertexCapacity, s_GpuVertexBufferName, true, slot.vertices, slot.vertexCapacity)
        && EnsureGpuGeometryBuffer<u32>(device, indexCount, s_GpuInitialIndexCapacity, s_GpuIndexBufferName, false, slot.indices, slot.indexCapacity);
}


b8 GpuRendererState::prepare(in AcquiredPresentationFrame acquired){
    this.m_readyToDeclare = false;
    if(!this.m_pending.valid())
        return true;
    if(!CanPrepareGpuPresentationFrame(acquired.valid(), this.m_resources.valid(), this.m_width, this.m_height))
        return false;
    in FramebufferDesc attachments = acquired.framebuffer.deref().getDescription();
    in TextureDesc backBuffer = acquired.backBuffer.texture.deref().getDescription();
    if(!IsValidGpuPresentationAttachments(
        attachments.colorAttachments.size(),
        attachments.colorAttachments.size() == 1u && attachments.colorAttachments[0u].hasTexture(acquired.backBuffer.texture.deref()),
        attachments.depthAttachment.valid(),
        attachments.shadingRateAttachment.valid(),
        backBuffer.width,
        this.m_width,
        backBuffer.height,
        this.m_height,
        backBuffer.sampleCount
    ))
        return false;
    if(!this.m_resources.deref().m_outputPipeline.valid() || this.m_resources.deref().m_outputPipeline.deref().getFramebufferInfo() != acquired.framebuffer.deref().getFramebufferInfo())
        return false;
    if(this.m_pending.deref().m_prepared && MatchesGpuAcquiredPresentationFrame(this.m_pending.deref().m_acquired, acquired)){
        this.m_readyToDeclare = true;
        return true;
    }
    mut Device device = this.m_graphics.getDevice();
    if(this.m_pending.deref().m_prepared){
        // A failed graph may have accepted uploads or raster. Rebuild only after that exact prefix completes.
        if(!this.m_pending.deref().prefixComplete(device))
            return true;
        this.m_pending.deref().m_acquired = acquired;
        this.m_readyToDeclare = true;
        this.m_claimed = false;
        this.m_declaredGraph.reset();
        return true;
    }
    // Retire all completed owners before cache eviction or descriptor allocation can need their heap slots.
    for(mut auto slot : this.m_slots){
        if(slot.inFlight.valid() && slot.inFlight.deref().complete(device))
            slot.inFlight.reset();
    }
    this.m_imageCache.trim(this.m_pending.deref().m_snapshot);
    for(mut auto slot : this.m_slots){
        if(slot.inFlight.valid())
            continue;
        GpuImageResources imageResources(this.m_graphics, this.m_imageCache, this.m_versions);
        if(!imageResources.prepareGlyphPages(this.m_pending.deref().m_snapshot, this.m_pending.deref().m_glyphPages) || !imageResources.prepareSdfPages(this.m_pending.deref().m_snapshot,
            this.m_pending.deref().m_sdfPages) || !imageResources.prepareTextureImages(this.m_pending.deref().m_snapshot, this.m_pending.deref().m_textureImages) || !this.prepareBuffers(slot, this.m_pending.deref().m_snapshot))
            return false;
        this.m_pending.deref().m_target = slot.target;
        this.m_pending.deref().m_resources = this.m_resources;
        this.m_pending.deref().m_vertices = slot.vertices;
        this.m_pending.deref().m_indices = slot.indices;
        this.m_pending.deref().m_outputPipeline = this.m_resources.deref().m_outputPipeline;
        this.m_pending.deref().m_acquired = acquired;
        this.m_pending.deref().m_presentationMode = ResolveGpuPresentationMode(this.m_graphics.isHDR10OutputActive(), s_ShaderUiPresentationHdr10, s_ShaderUiPresentationSdr);
        this.m_pending.deref().m_prepared = true;
        this.m_readyToDeclare = true;
        slot.inFlight = this.m_pending;
        this.m_claimed = false;
        this.m_declaredGraph.reset();
        return true;
    }
    // Admission is bounded. The pending immutable CPU generation survives until a slot becomes available.
    return true;
}


