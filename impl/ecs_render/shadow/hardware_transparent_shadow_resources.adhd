#include <impl/ecs_render/deferred/deferred_frame_targets.adhd>
#include <impl/ecs_render/kernel/descriptor_register_utils.adhd>
#include <impl/ecs_render/shader/shader_system.adhd>
#include <impl/ecs_render/shadow/hardware_transparent_shadow_state.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class HardwareTransparentShadowResources : NoCopy{
    private mut GraphicsRuntime m_graphics;
    private mut RendererShaderSystem m_shaderSystem;
    private mut HardwareTransparentShadowState m_state;

    public HardwareTransparentShadowResources(mut GraphicsRuntime graphics, mut RendererShaderSystem shaderSystem, mut HardwareTransparentShadowState state){
        this.m_graphics = graphics;
        this.m_shaderSystem = shaderSystem;
        this.m_state = state;
    }

    public b8 prepareHardwareTransparentShadowResources(mut DeferredFrameTargets targets);

    public void releaseHardwareTransparentShadowResources(){
        mut Device device = this.m_graphics.getDevice();
        mut GpuDescriptorHeap heap = device.getDescriptorHeap();
        RetireDescriptor(heap, this.m_state.m_crossingsHeapHandle);
        RetireDescriptor(heap, this.m_state.m_overflowListHeapHandle);
        RetireDescriptor(heap, this.m_state.m_overflowArgsHeapHandle);
        this.m_state = HardwareTransparentShadowState();
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

