    public b8 rebuildCsgCollider(in EntityID entity){
        if(!entity.valid() || !this.m_world.alive(entity) || !this.m_world.hasComponent<ColliderComponent>(entity))
            return false;
        const Optional<mut ColliderComponent> colOpt = this.m_world.borrowComponent<ColliderComponent>(entity);
        if(!colOpt.has_value())
            return false;
        const b8 hasAnyPhysicsParents = RefreshPhysicsHierarchyCache(this.m_world, this.m_syncScratch);
        if(hasAnyPhysicsParents)
            this.m_syncScratch.writeBackPoseCache.clear();
        u64 globalCutterSig = 0u;
        GatherActiveEcsCsgCutters(this.m_world, this.m_csgShapeRegistry, this.m_syncScratch.csgGatheredCuttersScratch, globalCutterSig);
        const Span<EcsGatheredCsgCutter> cuttersSpan(this.m_syncScratch.csgGatheredCuttersScratch.data(), this.m_syncScratch.csgGatheredCuttersScratch.size());
        mut ColliderComponent col = colOpt.value();
        return RebuildSingleEntityCsgCollider(
            entity,
            this.m_assetManager,
            this.m_scopedNames,
            this.m_csgShapeRegistry,
            cuttersSpan,
            globalCutterSig,
            hasAnyPhysicsParents,
            true,
            this.m_world,
            col,
            this.m_syncScratch
        );
    }
