////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/raytrace/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RayTracingBuildPolicy{
    public void applyConfirmedMeshBlasBuild(
        in b8 firstBuild,
        in b8 performRefit,
        in u32 refitsAfterBuild,
        in u64 geometryContentRevision,
        in u64 positionByteSize,
        mut b8 outBlasBuildPending,
        mut b8 outBlasBackingFresh,
        mut u32 outBlasRefitsSinceRebuild,
        mut b8 outBlasBuildAccepted,
        mut u64 outBlasGeometryContentRevision,
        mut u64 inOutFirstBuilds,
        mut u64 inOutRefits,
        mut u64 inOutRebuilds,
        mut u64 inOutUploadedBytes
    )const{
        outBlasBuildPending = false;
        outBlasBackingFresh = false;
        outBlasRefitsSinceRebuild = refitsAfterBuild;
        outBlasBuildAccepted = true;
        outBlasGeometryContentRevision = geometryContentRevision;
        if(firstBuild)
            inOutFirstBuilds += 1u;
        else if(performRefit)
            inOutRefits += 1u;
        else
            inOutRebuilds += 1u;
        inOutUploadedBytes += positionByteSize;
    }

    public void applyConfirmedMeshSwBvhBuild(
        in b8 performRefit,
        in u32 refitsAfterBuild,
        in u64 geometryContentRevision,
        mut b8 outSwBvhBuildPending,
        mut b8 outSwBvhBuildAccepted,
        mut u64 outSwBvhGeometryContentRevision,
        mut b8 inOutSwBvhTopologyBuilt,
        mut u32 outSwBvhRefitsSinceRebuild
    )const{
        outSwBvhBuildPending = false;
        outSwBvhBuildAccepted = true;
        outSwBvhGeometryContentRevision = geometryContentRevision;
        if(!performRefit)
            inOutSwBvhTopologyBuilt = true;
        outSwBvhRefitsSinceRebuild = refitsAfterBuild;
    }

    public void initializeCreatedMeshBlas(
        mut b8 outBlasBuildPending,
        mut b8 outBlasBuildAccepted,
        mut u64 outBlasGeometryContentRevision,
        mut b8 outBlasBackingFresh,
        mut u32 outBlasRefitsSinceRebuild
    )const{
        outBlasBuildPending = true;
        outBlasBuildAccepted = false;
        outBlasGeometryContentRevision = 0u;
        outBlasBackingFresh = true;
        outBlasRefitsSinceRebuild = 0u;
    }

    public void publishConfirmedSceneTlasBuild(
        in b8 preparedTlasMatchesCurrent,
        in b8 staticScene,
        in u64 staticSceneHash,
        mut u64 inOutTlasStaticSceneHash,
        mut b8 outTlasStaticSceneHashValid,
        mut b8 inOutTlasBackingFresh
    )const{
        if(preparedTlasMatchesCurrent && staticScene){
            inOutTlasStaticSceneHash = staticSceneHash;
            outTlasStaticSceneHashValid = true;
        }
        else
            outTlasStaticSceneHashValid = false;
        if(preparedTlasMatchesCurrent)
            inOutTlasBackingFresh = false;
    }

    public void finalizeConfirmedMeshBlasBuilds(
        in b8 allPlansCurrent,
        in u64 staticSkipped,
        in u64 firstBuilds,
        in u64 refits,
        in u64 rebuilds,
        in u64 uploadedBytes,
        mut b8 inOutTlasStaticSceneHashValid
    )const{
        if(!allPlansCurrent)
            inOutTlasStaticSceneHashValid = false;
        info(
            "RendererSystem: BLAS ownership staticSkipped={} firstBuilds={} refits={} rebuilds={} uploadedBytes={}"
            , staticSkipped
            , firstBuilds
            , refits
            , rebuilds
            , uploadedBytes
        );
    }

    public b8 validateMeshSwBvhPrimitiveCount(in u32 primitiveCount)const{
        if(primitiveCount > s_BvhMaxPrimitivesPerMesh){
            warning(
                "RendererSystem: mesh exceeds software BVH primitive cap ({} > {}), shadows skipped"
                , cast<u64>(primitiveCount)
                , cast<u64>(s_BvhMaxPrimitivesPerMesh)
            );
            return false;
        }
        return true;
    }

    public b8 validateSceneSwBvhNodeCount(in usize requiredNodeCount)const{
        if(requiredNodeCount > cast<usize>(BvhNodeIndex::ChildIndexMask) + 1u){
            error(
                "RendererSystem: software scene BVH requires {} nodes, exceeding the tagged child-index limit"
                , cast<u64>(requiredNodeCount)
            );
            return false;
        }
        return true;
    }

    public void initializeCreatedSceneTlas(
        in usize capacity,
        mut b8 outTlasBackingFresh,
        mut usize outTlasMaxInstances
    )const{
        outTlasBackingFresh = true;
        outTlasMaxInstances = capacity;
        info(
            "RendererSystem: created scene TLAS (capacity {} instances)"
            , cast<u64>(capacity)
        );
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

