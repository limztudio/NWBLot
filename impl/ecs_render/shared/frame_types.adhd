// Summarizes one owner-serialized ledger drain at the compiler boundary.
class RendererTaskTimingFeedbackDrainResult{
    public usize acceptedAssignmentCount = 0u;
    public usize recordedSampleCount = 0u;
    public usize retiredSampleCount = 0u;
    public usize rejectedAssignmentCount = 0u;
    public usize rejectedSampleCount = 0u;
}

enum<u8> RendererTaskTimingFeedbackCollectionAction{
    None = 0u,
    Enable = 1u,
    Disable = 2u,
    kCount = 3u
}


