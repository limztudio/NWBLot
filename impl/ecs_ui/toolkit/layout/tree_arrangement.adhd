#include "tree_measurement.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 TryBeginArrangeLayoutTreeNode(
    in Span<LayoutTreeNode> nodes,
    in Span<LayoutTreeWork> work,
    in u32 index,
    mut LayoutBox inoutBox,
    mut Rect outChildClip,
    mut f64 outAvailable,
    mut f64 outWeight,
    mut f64 outCursor
){
    outChildClip = Rect();
    outAvailable = 0.0;
    outWeight = 0.0;
    outCursor = 0.0;
    if(!IsValidUiRect(inoutBox.rectangle))
        return false;
    const LayoutTreeNode node = nodes[cast<usize>(index)];
    const LayoutNodeDesc description = node.description;
    const Rect inheritedClip = work[cast<usize>(index)].inheritedClip;
    const VectorSingle rectangleVec = LoadRect(inoutBox.rectangle);
    const VectorSingle inheritedClipVec = LoadRect(inheritedClip);
    const VectorSingle contentVec = VectorSingle(ComputeInsetUiRectBounds(inoutBox.rectangle, description.padding));
    const VectorSingle clipVec = IntersectRectVec(rectangleVec, inheritedClipVec);
    inoutBox.content = StoreRect(contentVec);
    inoutBox.clip = StoreRect(clipVec);
    inoutBox.hit = inoutBox.clip;
    if(!IsValidUiRect(inoutBox.content) || !IsValidUiRect(inoutBox.clip))
        return false;
    VectorSingle childClipVec = inheritedClipVec;
    if(description.clipChildren)
        childClipVec = IntersectRectVec(inheritedClipVec, contentVec);
    outChildClip = StoreRect(childClipVec);
    const b8 row = description.direction == LayoutDirection::Row;
    const b8 column = description.direction == LayoutDirection::Column;
    f64 consumed = 0.0;
    f64 weight = 0.0;
    u32 childCount = 0u;
    for(u32 child = node.firstChild; child != s_LayoutNoParent; child = nodes[cast<usize>(child)].nextSibling){
        const LayoutNodeDesc childDescription = nodes[cast<usize>(child)].description;
        if(row || column){
            LayoutSize main = childDescription.height;
            if(row)
                main = childDescription.width;
            if(main.policy == LayoutSizePolicy::Stretch)
                weight += cast<f64>(main.value);
            else{
                f32 measuredMain = work[cast<usize>(child)].box.measuredSize.y;
                if(row)
                    measuredMain = work[cast<usize>(child)].box.measuredSize.x;
                consumed += cast<f64>(measuredMain);
            }
        }
        ++childCount;
    }
    const f64 gap = cast<f64>(description.gap);
    f64 spacing = 0.0;
    if(childCount > 1u)
        spacing = gap * cast<f64>(childCount - 1u);
    f32 mainExtent = inoutBox.content.height;
    if(row)
        mainExtent = inoutBox.content.width;
    const f64 mainSize = cast<f64>(mainExtent);
    outAvailable = Max(0.0, (mainSize - consumed) - spacing);
    outWeight = weight;
    f32 startCoord = inoutBox.content.y;
    if(row)
        startCoord = inoutBox.content.x;
    outCursor = cast<f64>(startCoord);
    return true;
}

Expected<Rect> TryArrangeLayoutTreeChild(
    in LayoutDirection parentDirection,
    in f32 parentGap,
    in Rect parentContent,
    in LayoutNodeDesc childDescription,
    in Point childMeasured,
    in f64 available,
    in f64 weight,
    mut f64 inoutCursor
){
    const b8 row = parentDirection == LayoutDirection::Row;
    const b8 column = parentDirection == LayoutDirection::Column;
    f32 width = childMeasured.x;
    f32 height = childMeasured.y;
    if(childDescription.width.policy == LayoutSizePolicy::Stretch){
        if(row)
            width = cast<f32>(available * (cast<f64>(childDescription.width.value) / weight));
        else
            width = parentContent.width;
    }
    if(childDescription.height.policy == LayoutSizePolicy::Stretch){
        if(column)
            height = cast<f32>(available * (cast<f64>(childDescription.height.value) / weight));
        else
            height = parentContent.height;
    }
    f32 x = parentContent.x;
    if(row)
        x = cast<f32>(inoutCursor);
    f32 y = parentContent.y;
    if(column)
        y = cast<f32>(inoutCursor);
    const Rect rectangle(x, y, width, height);
    if(!IsValidUiRect(rectangle))
        return MakeUnexpected(Failure());
    const f64 gap = cast<f64>(parentGap);
    if(row)
        inoutCursor += cast<f64>(width) + gap;
    else if(column)
        inoutCursor += cast<f64>(height) + gap;
    return rectangle;
}

b8 ArrangeLayoutTreeNodeAt(in Span<LayoutTreeNode> nodes, in u32 index, mut Vector<LayoutTreeWork> work){
    Rect childClip;
    f64 available = 0.0;
    f64 weight = 0.0;
    f64 cursor = 0.0;
    if(!TryBeginArrangeLayoutTreeNode(nodes, work, index, work[cast<usize>(index)].box, childClip, available, weight, cursor))
        return false;
    const LayoutTreeNode node = nodes[cast<usize>(index)];
    const LayoutNodeDesc description = node.description;
    const Rect content = work[cast<usize>(index)].box.content;
    for(u32 child = node.firstChild; child != s_LayoutNoParent; child = nodes[cast<usize>(child)].nextSibling){
        const Expected<Rect> childRect = TryArrangeLayoutTreeChild(
            description.direction,
            description.gap,
            content,
            nodes[cast<usize>(child)].description,
            work[cast<usize>(child)].box.measuredSize,
            available,
            weight,
            cursor
        );
        if(!childRect.has_value())
            return false;
        work[cast<usize>(child)].box.rectangle = childRect.value();
        work[cast<usize>(child)].inheritedClip = childClip;
    }
    return true;
}

b8 ArrangeLayoutTree(
    in Span<LayoutTreeNode> nodes,
    in b8 buildFailed,
    in Rect viewport,
    mut Vector<LayoutTreeWork> work,
    mut Vector<LayoutBox> stagedBoxes,
    mut Vector<LayoutBox> boxes
){
    if(buildFailed || nodes.empty() || !IsValidUiRect(viewport))
        return false;
    work.clear();
    work.resize(nodes.size());
    if(!MeasureLayoutTreeNodes(nodes, work))
        return false;
    const LayoutNodeDesc root = nodes[0u].description;
    const Point measured = work[0u].box.measuredSize;
    f32 width = measured.x;
    if(root.width.policy == LayoutSizePolicy::Stretch)
        width = viewport.width;
    f32 height = measured.y;
    if(root.height.policy == LayoutSizePolicy::Stretch)
        height = viewport.height;
    work[0u].box.rectangle = Rect(viewport.x, viewport.y, width, height);
    work[0u].inheritedClip = viewport;
    for(u32 index = 0u; cast<usize>(index) < nodes.size(); ++index){
        if(!ArrangeLayoutTreeNodeAt(nodes, index, work))
            return false;
    }
    stagedBoxes.clear();
    for(in LayoutTreeWork item : work)
        stagedBoxes.push_back(item.box);
    boxes.swap(stagedBoxes);
    return true;
}


