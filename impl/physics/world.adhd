    public b8 setJointLengthRange(in JointId jointId, in f32 minLength, in f32 maxLength){
        if(!this.isValidJoint(jointId) || !IsFinite(minLength) || !IsFinite(maxLength) || minLength < 0.0f || maxLength < minLength)
            return false;
        this.m_joints[jointId.index].setMinLength(minLength);
        this.m_joints[jointId.index].setMaxLength(maxLength);
        this.wakeJointBodies(jointId.index);
