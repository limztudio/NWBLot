[cpp_name("::MemoryOrder")]
extern enum MemoryOrder : u32{
    relaxed,
    consume,
    acquire,
    release,
    acq_rel,
    seq_cst
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_name("::AtomicFlag"), cpp_layout(4, 4), cpp_flags(self_defaulted, brace_init, no_copy, no_assign)]
extern class AtomicFlag;


