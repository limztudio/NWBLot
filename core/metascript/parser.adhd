[cpp_header("<core/metascript/parser.h>"), cpp_name("::NWB::Core::Metascript::Document"), cpp_layout(264, 8), cpp_flags(no_assign)]
extern class MetascriptDocument{
    Span<MetascriptParseError> errors(...)const;
    b8 hasErrors(...)const;
    b8 hasVariable(...)const;
    b8 parse(...);
    b8 visitVariable(in StringView a0, in Func<b8(mut MetascriptValue)> a1)const;
};

[cpp_header("<core/metascript/parser.h>"), cpp_name("::NWB::Core::Metascript::ParseError"), cpp_layout(48, 8), cpp_flags(self_defaulted, brace_init)]
extern class MetascriptParseError{
    u32 line;
    u32 column;
    String message;
};


