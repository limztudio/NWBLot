void VerifyAllocatorPropagation_OrderedMapMoveTransfersNodesAndTheirDeallocationOwner(){
    Array<b8, 2> flags = Array<b8, 2>();
    flags[0u] = false;
    flags[1u] = true;
    for(in b8 foreignArena : flags){
        const Name sourceOwner = s_GlobalArenaCaseAllocatorPropagationMapSource;
        const Name targetOwner = s_GlobalArenaCaseAllocatorPropagationMapTarget;
        ArenaMemoryStats sourceStats = ArenaMemoryStats();
        ArenaMemoryStats targetStats = ArenaMemoryStats();
        native(in foreignArena, in sourceOwner, in targetOwner, mut sourceStats, mut targetStats){
            using NWB::Core::Alloc::GlobalArena;
            GlobalArena sourceArena{ sourceOwner };
            GlobalArena targetArena{ targetOwner };
            {
                ::Map<u32, u32, GlobalArena> target{ foreignArena ? targetArena : sourceArena };
                ASSERT_TRUE(target.emplace(900u, 900u).second);
                {
                    ::Map<u32, u32, GlobalArena> source{ sourceArena };
                    for(u32 key = 0u; key < 64u; ++key)
                        ASSERT_TRUE(source.emplace(key, key * 3u).second);
                    const NotNull<const u32*> sourceValue = MakeNotNull(&source.find(0u)->second);
                    target = Move(source);
                    EXPECT_EQ(target.get_allocator().arenaPtr(), &sourceArena);
                    ASSERT_EQ(target.size(), 64u);
                    EXPECT_EQ(&target.find(0u)->second, sourceValue.get());
                    EXPECT_TRUE(source.empty());
                    ASSERT_TRUE(source.emplace(7u, 8u).second);
                }
                for(u32 key = 0u; key < 64u; ++key)
                    EXPECT_EQ(target.find(key)->second, key * 3u);
                ASSERT_TRUE(target.emplace(65u, 195u).second);
            }
            sourceStats = sourceArena.memoryStats();
            targetStats = targetArena.memoryStats();
        }
        EXPECT_EQ(sourceStats.usedBytes, 0u);
        EXPECT_EQ(targetStats.usedBytes, 0u);
        EXPECT_EQ(sourceStats.allocationCount, sourceStats.deallocationCount);
        EXPECT_EQ(targetStats.allocationCount, targetStats.deallocationCount);
    }
}

