void VerifyAssetsGraphics_MeshAcceptanceUvSeamQuad(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_ReportOnly);
    TestArena testArena = TestArena();
    const Expected<CookCase> cookCase = PrepareCookCase(testArena, "uv_seam_quad");
    ASSERT_TRUE(cookCase.has_value());
    const CookCase prepared = cookCase.value();

    MeshAsset loadedMesh(testArena.arena);
    if(CookAndLoadSmokeMeshInto("uv_seam_quad.nwb", s_AssetCaseProjectMeshesUvSeamQuad, prepared, testArena, loadedMesh)){
        ASSERT_EQ(loadedMesh.meshlets().size(), 1u);
        ASSERT_GE(loadedMesh.meshletLocalVertexRefs().size(), 5u);
        EXPECT_EQ(loadedMesh.meshletLocalVertexRefs()[0u].localDeformedPosition, loadedMesh.meshletLocalVertexRefs()[3u].localDeformedPosition);
        EXPECT_EQ(loadedMesh.meshletLocalVertexRefs()[2u].localDeformedPosition, loadedMesh.meshletLocalVertexRefs()[4u].localDeformedPosition);
        EXPECT_NE(loadedMesh.meshletLocalVertexRefs()[0u].localAttribute, loadedMesh.meshletLocalVertexRefs()[3u].localAttribute);
        EXPECT_NE(loadedMesh.meshletLocalVertexRefs()[2u].localAttribute, loadedMesh.meshletLocalVertexRefs()[4u].localAttribute);

        const MeshletDesc meshlet = loadedMesh.meshlets()[0u];
        const Expected<MeshletAttributeStreamRef> attributeRef0 = DecodeMeshAssetAttributeRef(loadedMesh, meshlet, loadedMesh.meshletLocalVertexRefs()[0u].localAttribute);
        const Expected<MeshletAttributeStreamRef> attributeRef2 = DecodeMeshAssetAttributeRef(loadedMesh, meshlet, loadedMesh.meshletLocalVertexRefs()[2u].localAttribute);
        const Expected<MeshletAttributeStreamRef> attributeRef3 = DecodeMeshAssetAttributeRef(loadedMesh, meshlet, loadedMesh.meshletLocalVertexRefs()[3u].localAttribute);
        const Expected<MeshletAttributeStreamRef> attributeRef4 = DecodeMeshAssetAttributeRef(loadedMesh, meshlet, loadedMesh.meshletLocalVertexRefs()[4u].localAttribute);
        ASSERT_TRUE(attributeRef0.has_value());
        ASSERT_TRUE(attributeRef2.has_value());
        ASSERT_TRUE(attributeRef3.has_value());
        ASSERT_TRUE(attributeRef4.has_value());
        EXPECT_EQ(attributeRef0.value().uv0, 0u);
        EXPECT_EQ(attributeRef2.value().uv0, 2u);
        EXPECT_EQ(attributeRef3.value().uv0, 1u);
        EXPECT_EQ(attributeRef4.value().uv0, 3u);
        EXPECT_EQ(attributeRef0.value().tangent, 0u);
        EXPECT_EQ(attributeRef2.value().tangent, 0u);
        EXPECT_EQ(attributeRef3.value().tangent, 1u);
        EXPECT_EQ(attributeRef4.value().tangent, 1u);
    }
    EXPECT_EQ(logger.errorCount(), 0u);
    EXPECT_TRUE(RemoveAllIfExists(prepared.root));
}

