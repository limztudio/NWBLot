#include <impl/ecs_render/deferred/deferred_frame_targets.adhd>
#include <impl/ecs_render/raytrace/graph_snapshots.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <core/graphics/gpu_timing.h>
#include <core/task/gpu/persistent_state.h>
#include <core/task/gpu/task_graph.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererRayTracingSystem;


struct SurfelGiGraphContext{
    Core::GpuTaskGraph& graph;
    RendererRayTracingSystem& rayTracing;
    Core::GpuPersistentResourceStateCache& computeState;
    Core::GpuPersistentResourceStateCache& counterState;
    Core::GpuPersistentResourceStateCache& irradianceReturnState;
    // The frame-timing task is declared after the GI stages.
    const Core::GpuTaskId& frameTimingEndTask;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_name("::NWB::Impl::SurfelGiGraphContext")]
extern class SurfelGiGraphContext;

[modular]
class SurfelGiGraphCoordinator : NoCopy{
    // Surfel lifecycle publishes after all four clears accept; stages share one effects packet.
    public GpuTaskId m_deferredSurfelGiPreparationTask;
    public GpuTaskId m_deferredSurfelGiInitializationLifecycleTask;
    public GpuTaskId m_deferredSurfelGiSnapshotCopyTask;
    public GpuTaskId m_deferredSurfelGiIrradianceClearTask;
    public GpuTaskId m_deferredSurfelGiAgeFreeTask;
    public GpuTaskId m_deferredSurfelGiCellHeadClearTask;
    public GpuTaskId m_deferredSurfelGiHashBuildTask;
    public GpuTaskId m_deferredSurfelGiSpawnTask;
    public GpuTaskId m_deferredSurfelGiTraceBuildArgsTask;
    public GpuTaskId m_deferredSurfelGiTraceTask;
    public GpuTaskId m_deferredSurfelGiResolveTask;
    public GpuTaskId m_deferredSurfelGiTask;
    // A rare diagnostic tail: it depends on GI but records/submits after Present on Transfer when available.
    public GpuTaskId m_deferredSurfelGiCounterReadbackTask;

    public SurfelGiGraphCoordinator(){}

    public b8 declareDeferredSurfelGiTask(
        in SurfelGiGraphContext context,
        in DeferredLightingGraphResources deferredLightingResources,
        in RayTracingDeferredGraphResourceSnapshot rayTracingResources,
        in RayTracingSurfelPersistentResourceSnapshot rayTracingSurfelResources,
        in GpuGraphResourceId worldPosition,
        in GpuGraphResourceId normal,
        in GpuGraphResourceId surfelIrradiance,
        in GpuGraphResourceId currentBindlessSlots,
        in GpuGraphResourceId sceneShading,
        in GpuGraphResourceId lights,
        in GpuGraphResourceId materialContextSlots,
        in Span<GpuGraphResourceId> traceGeometryResources,
        in GpuGraphResourceSetId traceGeometrySet,
        in GpuGraphResourceSetId traceMaterialSampledTextureSet,
        in GpuTaskId effectsTask,
        in b8 useLaggedLightingHistory,
        in GpuExternalCompletionId surfelCounterReadbackCompletion,
        mut ScratchArena scratchArena,
        mut DeferredFrameTargets deferredTargets,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming
    );
    public void declareDeferredSurfelCountReadbackTask(in SurfelGiGraphContext context, in RayTracingSurfelPersistentResourceSnapshot rayTracingSurfelResources);
}


