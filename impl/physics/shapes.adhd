class TaperedCapsuleShape{
    public f32x4 center1Radius1(0.0f, -0.5f, 0.0f, 0.25f);
    public f32x4 center2Radius2(0.0f, 0.5f, 0.0f, 0.15f);

    public VectorSingle center1()const{
        return VectorSingle(this.center1Radius1, 0.0f);
    }

