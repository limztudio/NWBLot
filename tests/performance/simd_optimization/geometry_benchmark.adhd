namespace SimdOptimizationBenchmark{
namespace GeometryKernels{

using Intersection = b8 (FOUNDATION_SIMD_CALL *)(SIMDVectorDouble, SIMDVectorDouble, SIMDVectorDouble, SIMDVectorDouble, SIMDVectorDouble, SIMDVectorDouble)noexcept;

struct TrianglePairVectors{
    alignas(SIMDVectorDouble) Array<SIMDVectorDouble, 3> first{};
    alignas(SIMDVectorDouble) Array<SIMDVectorDouble, 3> second{};
};

FOUNDATION_INLINE volatile u64 s_ChecksumSink = 0u;

FOUNDATION_NOINLINE b8 FOUNDATION_SIMD_CALL Baseline(const SIMDVectorDouble a0, const SIMDVectorDouble a1, const SIMDVectorDouble a2, const SIMDVectorDouble b0, const SIMDVectorDouble b1, const SIMDVectorDouble b2)noexcept{
    const SIMDVectorDouble first0 = VectorDoubleAndInt(a0, s_DoubleSIMDMask3), first1 = VectorDoubleAndInt(a1, s_DoubleSIMDMask3), first2 = VectorDoubleAndInt(a2, s_DoubleSIMDMask3);
    const SIMDVectorDouble second0 = VectorDoubleAndInt(b0, s_DoubleSIMDMask3), second1 = VectorDoubleAndInt(b1, s_DoubleSIMDMask3), second2 = VectorDoubleAndInt(b2, s_DoubleSIMDMask3);
    const SIMDVectorDouble minA = VectorDoubleMin(first0, VectorDoubleMin(first1, first2)), maxA = VectorDoubleMax(first0, VectorDoubleMax(first1, first2));
    const SIMDVectorDouble minB = VectorDoubleMin(second0, VectorDoubleMin(second1, second2)), maxB = VectorDoubleMax(second0, VectorDoubleMax(second1, second2));
    if(!CollisionDoubleDetail::MinMaxIntersects(minA, maxA, minB, maxB))
        return false;

    const SIMDVectorDouble zero = VectorDoubleZero();
    const SIMDVectorDouble relativeA1 = VectorDoubleSubtract(first1, first0), relativeA2 = VectorDoubleSubtract(first2, first0);
    const SIMDVectorDouble relativeB0 = VectorDoubleSubtract(second0, first0), relativeB1 = VectorDoubleSubtract(second1, first0), relativeB2 = VectorDoubleSubtract(second2, first0);
    const auto differenceRoundoff = [](const SIMDVectorDouble point, const SIMDVectorDouble origin, const SIMDVectorDouble difference)noexcept{
        // TwoDiff recovers the subtraction residual without expanding the allowance with a large common translation.
        const SIMDVectorDouble virtualOrigin = VectorDoubleSubtract(point, difference), virtualPoint = VectorDoubleAdd(difference, virtualOrigin);
        return VectorDoubleAdd(VectorDoubleSubtract(point, virtualPoint), VectorDoubleSubtract(virtualOrigin, origin));
    };
    const SIMDVectorDouble roundoffA1 = differenceRoundoff(first1, first0, relativeA1), roundoffA2 = differenceRoundoff(first2, first0, relativeA2);
    const SIMDVectorDouble roundoffB0 = differenceRoundoff(second0, first0, relativeB0), roundoffB1 = differenceRoundoff(second1, first0, relativeB1), roundoffB2 = differenceRoundoff(second2, first0, relativeB2);
    const SIMDVectorDouble edgeA0 = relativeA1, edgeA1 = VectorDoubleSubtract(first2, first1), edgeA2 = VectorDoubleNegate(relativeA2);
    const SIMDVectorDouble edgeB0 = VectorDoubleSubtract(second1, second0), edgeB1 = VectorDoubleSubtract(second2, second1), edgeB2 = VectorDoubleSubtract(second0, second2);
    const auto crossAxis = [](const SIMDVectorDouble first, const SIMDVectorDouble second)noexcept{
        // Separate products make parallel directions produce a zero axis instead of an explicit-FMA residual.
        const SIMDVectorDouble positive = VectorDoubleMultiply(VectorDoubleSwizzle<1, 2, 0, 3>(first), VectorDoubleSwizzle<2, 0, 1, 3>(second));
        const SIMDVectorDouble negative = VectorDoubleMultiply(VectorDoubleSwizzle<2, 0, 1, 3>(first), VectorDoubleSwizzle<1, 2, 0, 3>(second));
        return VectorDoubleSubtract(positive, negative);
    };
    const auto separated = [&](const SIMDVectorDouble axis)noexcept{
        const SIMDVectorDouble absoluteAxis = VectorDoubleAbs(axis);
        const auto projectionInterval = [&](const SIMDVectorDouble relative, const SIMDVectorDouble roundoff)noexcept{
            const SIMDVectorDouble projection = SimdBaselineKernels::Dot3(relative, axis);
            const SIMDVectorDouble magnitude = SimdBaselineKernels::Dot3(VectorDoubleAbs(relative), absoluteAxis), coordinateError = SimdBaselineKernels::Dot3(VectorDoubleAbs(roundoff), absoluteAxis);
            // Eight epsilons bound cancellation and endpoint rounding across three products and two sums.
            const SIMDVectorDouble allowance = VectorDoubleMultiplyAddExpression(VectorDoubleAdd(magnitude, coordinateError), VectorDoubleReplicate(0x1p-49), coordinateError);
            return VectorDoubleSelect(VectorDoubleSubtract(projection, allowance), VectorDoubleAdd(projection, allowance), s_DoubleSIMDMaskY);
        };
        const SIMDVectorDouble intervalA1 = projectionInterval(relativeA1, roundoffA1), intervalA2 = projectionInterval(relativeA2, roundoffA2);
        const SIMDVectorDouble minimumA = VectorDoubleMin(zero, VectorDoubleMin(VectorDoubleSplatX(intervalA1), VectorDoubleSplatX(intervalA2)));
        const SIMDVectorDouble maximumA = VectorDoubleMax(zero, VectorDoubleMax(VectorDoubleSplatY(intervalA1), VectorDoubleSplatY(intervalA2)));
        const SIMDVectorDouble intervalB0 = projectionInterval(relativeB0, roundoffB0), intervalB1 = projectionInterval(relativeB1, roundoffB1), intervalB2 = projectionInterval(relativeB2, roundoffB2);
        const SIMDVectorDouble minimumB = VectorDoubleMin(VectorDoubleSplatX(intervalB0), VectorDoubleMin(VectorDoubleSplatX(intervalB1), VectorDoubleSplatX(intervalB2)));
        const SIMDVectorDouble maximumB = VectorDoubleMax(VectorDoubleSplatY(intervalB0), VectorDoubleMax(VectorDoubleSplatY(intervalB1), VectorDoubleSplatY(intervalB2)));
        return VectorDouble4Less(maximumA, minimumB) || VectorDouble4Less(maximumB, minimumA);
    };
    const SIMDVectorDouble normalA = crossAxis(edgeA0, VectorDoubleNegate(edgeA2)), normalB = crossAxis(edgeB0, VectorDoubleNegate(edgeB2));
    if(separated(normalA) || separated(normalB))
        return false;

    if(VectorDouble3Equal(normalA, zero) && VectorDouble3Equal(normalB, zero)){
        // Closed degenerate triangles retain their point/segment hulls, including collinear endpoint contact.
        const SIMDVectorDouble directionA = VectorDouble3Equal(edgeA0, zero) ? edgeA1 : edgeA0, directionB = VectorDouble3Equal(edgeB0, zero) ? edgeB1 : edgeB0;
        const SIMDVectorDouble normal = crossAxis(directionA, directionB);
        if(separated(directionA) || separated(directionB) || separated(normal) || separated(crossAxis(directionA, normal)) || separated(crossAxis(directionB, normal)))
            return false;
        const auto parallelSeparated = [&](const SIMDVectorDouble direction)noexcept{
            return separated(crossAxis(direction, s_DoubleSIMDIdentityR0)) || separated(crossAxis(direction, s_DoubleSIMDIdentityR1)) || separated(crossAxis(direction, s_DoubleSIMDIdentityR2));
        };
        return !parallelSeparated(directionA) && !parallelSeparated(directionB);
    }

    const auto edgeSeparated = [&](const SIMDVectorDouble edge)noexcept{
        // In-plane edge normals are necessary when the triangles are coplanar or one hull is degenerate.
        return separated(crossAxis(edge, normalA)) || separated(crossAxis(edge, normalB)) || separated(crossAxis(edge, edgeB0)) || separated(crossAxis(edge, edgeB1)) || separated(crossAxis(edge, edgeB2));
    };
    if(edgeSeparated(edgeA0) || edgeSeparated(edgeA1) || edgeSeparated(edgeA2))
        return false;
    const auto secondEdgeSeparated = [&](const SIMDVectorDouble edge)noexcept{
        return separated(crossAxis(edge, normalA)) || separated(crossAxis(edge, normalB));
    };
    return !secondEdgeSeparated(edgeB0) && !secondEdgeSeparated(edgeB1) && !secondEdgeSeparated(edgeB2);
}

FOUNDATION_NOINLINE b8 FOUNDATION_SIMD_CALL CurrentDot3Baseline(const SIMDVectorDouble a0, const SIMDVectorDouble a1, const SIMDVectorDouble a2, const SIMDVectorDouble b0, const SIMDVectorDouble b1, const SIMDVectorDouble b2)noexcept{
    const SIMDVectorDouble first0 = VectorDoubleAndInt(a0, s_DoubleSIMDMask3), first1 = VectorDoubleAndInt(a1, s_DoubleSIMDMask3), first2 = VectorDoubleAndInt(a2, s_DoubleSIMDMask3);
    const SIMDVectorDouble second0 = VectorDoubleAndInt(b0, s_DoubleSIMDMask3), second1 = VectorDoubleAndInt(b1, s_DoubleSIMDMask3), second2 = VectorDoubleAndInt(b2, s_DoubleSIMDMask3);
    const SIMDVectorDouble minA = VectorDoubleMin(first0, VectorDoubleMin(first1, first2)), maxA = VectorDoubleMax(first0, VectorDoubleMax(first1, first2));
    const SIMDVectorDouble minB = VectorDoubleMin(second0, VectorDoubleMin(second1, second2)), maxB = VectorDoubleMax(second0, VectorDoubleMax(second1, second2));
    if(!CollisionDoubleDetail::MinMaxIntersects(minA, maxA, minB, maxB))
        return false;

    const SIMDVectorDouble zero = VectorDoubleZero();
    const SIMDVectorDouble relativeA1 = VectorDoubleSubtract(first1, first0), relativeA2 = VectorDoubleSubtract(first2, first0);
    const SIMDVectorDouble relativeB0 = VectorDoubleSubtract(second0, first0), relativeB1 = VectorDoubleSubtract(second1, first0), relativeB2 = VectorDoubleSubtract(second2, first0);
    const auto differenceRoundoff = [](const SIMDVectorDouble point, const SIMDVectorDouble origin, const SIMDVectorDouble difference)noexcept{
        const SIMDVectorDouble virtualOrigin = VectorDoubleSubtract(point, difference), virtualPoint = VectorDoubleAdd(difference, virtualOrigin);
        return VectorDoubleAdd(VectorDoubleSubtract(point, virtualPoint), VectorDoubleSubtract(virtualOrigin, origin));
    };
    const SIMDVectorDouble roundoffA1 = differenceRoundoff(first1, first0, relativeA1), roundoffA2 = differenceRoundoff(first2, first0, relativeA2);
    const SIMDVectorDouble roundoffB0 = differenceRoundoff(second0, first0, relativeB0), roundoffB1 = differenceRoundoff(second1, first0, relativeB1), roundoffB2 = differenceRoundoff(second2, first0, relativeB2);
    const SIMDVectorDouble edgeA0 = relativeA1, edgeA1 = VectorDoubleSubtract(first2, first1), edgeA2 = VectorDoubleNegate(relativeA2);
    const SIMDVectorDouble edgeB0 = VectorDoubleSubtract(second1, second0), edgeB1 = VectorDoubleSubtract(second2, second1), edgeB2 = VectorDoubleSubtract(second0, second2);
    const auto crossAxis = [](const SIMDVectorDouble first, const SIMDVectorDouble second)noexcept{
        const SIMDVectorDouble positive = VectorDoubleMultiply(VectorDoubleSwizzle<1, 2, 0, 3>(first), VectorDoubleSwizzle<2, 0, 1, 3>(second));
        const SIMDVectorDouble negative = VectorDoubleMultiply(VectorDoubleSwizzle<2, 0, 1, 3>(first), VectorDoubleSwizzle<1, 2, 0, 3>(second));
        return VectorDoubleSubtract(positive, negative);
    };
    const auto separated = [&](const SIMDVectorDouble axis)noexcept{
        const SIMDVectorDouble absoluteAxis = VectorDoubleAbs(axis);
        const auto projectionInterval = [&](const SIMDVectorDouble relative, const SIMDVectorDouble roundoff)noexcept{
            const SIMDVectorDouble projection = VectorDouble3Dot(relative, axis);
            const SIMDVectorDouble magnitude = VectorDouble3Dot(VectorDoubleAbs(relative), absoluteAxis), coordinateError = VectorDouble3Dot(VectorDoubleAbs(roundoff), absoluteAxis);
            const SIMDVectorDouble allowance = VectorDoubleMultiplyAddExpression(VectorDoubleAdd(magnitude, coordinateError), VectorDoubleReplicate(0x1p-49), coordinateError);
            return VectorDoubleSelect(VectorDoubleSubtract(projection, allowance), VectorDoubleAdd(projection, allowance), s_DoubleSIMDMaskY);
        };
        const SIMDVectorDouble intervalA1 = projectionInterval(relativeA1, roundoffA1), intervalA2 = projectionInterval(relativeA2, roundoffA2);
        const SIMDVectorDouble minimumA = VectorDoubleMin(zero, VectorDoubleMin(VectorDoubleSplatX(intervalA1), VectorDoubleSplatX(intervalA2)));
        const SIMDVectorDouble maximumA = VectorDoubleMax(zero, VectorDoubleMax(VectorDoubleSplatY(intervalA1), VectorDoubleSplatY(intervalA2)));
        const SIMDVectorDouble intervalB0 = projectionInterval(relativeB0, roundoffB0), intervalB1 = projectionInterval(relativeB1, roundoffB1), intervalB2 = projectionInterval(relativeB2, roundoffB2);
        const SIMDVectorDouble minimumB = VectorDoubleMin(VectorDoubleSplatX(intervalB0), VectorDoubleMin(VectorDoubleSplatX(intervalB1), VectorDoubleSplatX(intervalB2)));
        const SIMDVectorDouble maximumB = VectorDoubleMax(VectorDoubleSplatY(intervalB0), VectorDoubleMax(VectorDoubleSplatY(intervalB1), VectorDoubleSplatY(intervalB2)));
        return VectorDouble4Less(maximumA, minimumB) || VectorDouble4Less(maximumB, minimumA);
    };
    const SIMDVectorDouble normalA = crossAxis(edgeA0, VectorDoubleNegate(edgeA2)), normalB = crossAxis(edgeB0, VectorDoubleNegate(edgeB2));
    if(separated(normalA) || separated(normalB))
        return false;

    if(VectorDouble3Equal(normalA, zero) && VectorDouble3Equal(normalB, zero)){
        const SIMDVectorDouble directionA = VectorDouble3Equal(edgeA0, zero) ? edgeA1 : edgeA0, directionB = VectorDouble3Equal(edgeB0, zero) ? edgeB1 : edgeB0;
        const SIMDVectorDouble normal = crossAxis(directionA, directionB);
        if(separated(directionA) || separated(directionB) || separated(normal) || separated(crossAxis(directionA, normal)) || separated(crossAxis(directionB, normal)))
            return false;
        const auto parallelSeparated = [&](const SIMDVectorDouble direction)noexcept{
            return separated(crossAxis(direction, s_DoubleSIMDIdentityR0)) || separated(crossAxis(direction, s_DoubleSIMDIdentityR1)) || separated(crossAxis(direction, s_DoubleSIMDIdentityR2));
        };
        return !parallelSeparated(directionA) && !parallelSeparated(directionB);
    }

    const auto edgeSeparated = [&](const SIMDVectorDouble edge)noexcept{
        return separated(crossAxis(edge, normalA)) || separated(crossAxis(edge, normalB)) || separated(crossAxis(edge, edgeB0)) || separated(crossAxis(edge, edgeB1)) || separated(crossAxis(edge, edgeB2));
    };
    if(edgeSeparated(edgeA0) || edgeSeparated(edgeA1) || edgeSeparated(edgeA2))
        return false;
    const auto secondEdgeSeparated = [&](const SIMDVectorDouble edge)noexcept{
        return separated(crossAxis(edge, normalA)) || separated(crossAxis(edge, normalB));
    };
    return !secondEdgeSeparated(edgeB0) && !secondEdgeSeparated(edgeB1) && !secondEdgeSeparated(edgeB2);
}

FOUNDATION_NOINLINE b8 FOUNDATION_SIMD_CALL ZeroAxis(const SIMDVectorDouble a0, const SIMDVectorDouble a1, const SIMDVectorDouble a2, const SIMDVectorDouble b0, const SIMDVectorDouble b1, const SIMDVectorDouble b2)noexcept{
    const SIMDVectorDouble first0 = VectorDoubleAndInt(a0, s_DoubleSIMDMask3), first1 = VectorDoubleAndInt(a1, s_DoubleSIMDMask3), first2 = VectorDoubleAndInt(a2, s_DoubleSIMDMask3);
    const SIMDVectorDouble second0 = VectorDoubleAndInt(b0, s_DoubleSIMDMask3), second1 = VectorDoubleAndInt(b1, s_DoubleSIMDMask3), second2 = VectorDoubleAndInt(b2, s_DoubleSIMDMask3);
    const SIMDVectorDouble minA = VectorDoubleMin(first0, VectorDoubleMin(first1, first2)), maxA = VectorDoubleMax(first0, VectorDoubleMax(first1, first2));
    const SIMDVectorDouble minB = VectorDoubleMin(second0, VectorDoubleMin(second1, second2)), maxB = VectorDoubleMax(second0, VectorDoubleMax(second1, second2));
    if(!CollisionDoubleDetail::MinMaxIntersects(minA, maxA, minB, maxB))
        return false;

    const SIMDVectorDouble zero = VectorDoubleZero();
    const SIMDVectorDouble relativeA1 = VectorDoubleSubtract(first1, first0), relativeA2 = VectorDoubleSubtract(first2, first0);
    const SIMDVectorDouble relativeB0 = VectorDoubleSubtract(second0, first0), relativeB1 = VectorDoubleSubtract(second1, first0), relativeB2 = VectorDoubleSubtract(second2, first0);
    const auto differenceRoundoff = [](const SIMDVectorDouble point, const SIMDVectorDouble origin, const SIMDVectorDouble difference)noexcept{
        const SIMDVectorDouble virtualOrigin = VectorDoubleSubtract(point, difference), virtualPoint = VectorDoubleAdd(difference, virtualOrigin);
        return VectorDoubleAdd(VectorDoubleSubtract(point, virtualPoint), VectorDoubleSubtract(virtualOrigin, origin));
    };
    const SIMDVectorDouble roundoffA1 = differenceRoundoff(first1, first0, relativeA1), roundoffA2 = differenceRoundoff(first2, first0, relativeA2);
    const SIMDVectorDouble roundoffB0 = differenceRoundoff(second0, first0, relativeB0), roundoffB1 = differenceRoundoff(second1, first0, relativeB1), roundoffB2 = differenceRoundoff(second2, first0, relativeB2);
    const SIMDVectorDouble edgeA0 = relativeA1, edgeA1 = VectorDoubleSubtract(first2, first1), edgeA2 = VectorDoubleNegate(relativeA2);
    const SIMDVectorDouble edgeB0 = VectorDoubleSubtract(second1, second0), edgeB1 = VectorDoubleSubtract(second2, second1), edgeB2 = VectorDoubleSubtract(second0, second2);
    const auto crossAxis = [](const SIMDVectorDouble first, const SIMDVectorDouble second)noexcept{
        const SIMDVectorDouble positive = VectorDoubleMultiply(VectorDoubleSwizzle<1, 2, 0, 3>(first), VectorDoubleSwizzle<2, 0, 1, 3>(second));
        const SIMDVectorDouble negative = VectorDoubleMultiply(VectorDoubleSwizzle<2, 0, 1, 3>(first), VectorDoubleSwizzle<1, 2, 0, 3>(second));
        return VectorDoubleSubtract(positive, negative);
    };
    const auto separated = [&](const SIMDVectorDouble axis)noexcept{
        if(VectorDouble3Equal(axis, zero))
            return false;
        const SIMDVectorDouble absoluteAxis = VectorDoubleAbs(axis);
        const auto projectionInterval = [&](const SIMDVectorDouble relative, const SIMDVectorDouble roundoff)noexcept{
            const SIMDVectorDouble projection = VectorDouble3Dot(relative, axis);
            const SIMDVectorDouble magnitude = VectorDouble3Dot(VectorDoubleAbs(relative), absoluteAxis), coordinateError = VectorDouble3Dot(VectorDoubleAbs(roundoff), absoluteAxis);
            const SIMDVectorDouble allowance = VectorDoubleMultiplyAddExpression(VectorDoubleAdd(magnitude, coordinateError), VectorDoubleReplicate(0x1p-49), coordinateError);
            return VectorDoubleSelect(VectorDoubleSubtract(projection, allowance), VectorDoubleAdd(projection, allowance), s_DoubleSIMDMaskY);
        };
        const SIMDVectorDouble intervalA1 = projectionInterval(relativeA1, roundoffA1), intervalA2 = projectionInterval(relativeA2, roundoffA2);
        const SIMDVectorDouble minimumA = VectorDoubleMin(zero, VectorDoubleMin(VectorDoubleSplatX(intervalA1), VectorDoubleSplatX(intervalA2)));
        const SIMDVectorDouble maximumA = VectorDoubleMax(zero, VectorDoubleMax(VectorDoubleSplatY(intervalA1), VectorDoubleSplatY(intervalA2)));
        const SIMDVectorDouble intervalB0 = projectionInterval(relativeB0, roundoffB0), intervalB1 = projectionInterval(relativeB1, roundoffB1), intervalB2 = projectionInterval(relativeB2, roundoffB2);
        const SIMDVectorDouble minimumB = VectorDoubleMin(VectorDoubleSplatX(intervalB0), VectorDoubleMin(VectorDoubleSplatX(intervalB1), VectorDoubleSplatX(intervalB2)));
        const SIMDVectorDouble maximumB = VectorDoubleMax(VectorDoubleSplatY(intervalB0), VectorDoubleMax(VectorDoubleSplatY(intervalB1), VectorDoubleSplatY(intervalB2)));
        return VectorDouble4Less(maximumA, minimumB) || VectorDouble4Less(maximumB, minimumA);
    };
    const SIMDVectorDouble normalA = crossAxis(edgeA0, VectorDoubleNegate(edgeA2)), normalB = crossAxis(edgeB0, VectorDoubleNegate(edgeB2));
    if(separated(normalA) || separated(normalB))
        return false;

    if(VectorDouble3Equal(normalA, zero) && VectorDouble3Equal(normalB, zero)){
        const SIMDVectorDouble directionA = VectorDouble3Equal(edgeA0, zero) ? edgeA1 : edgeA0, directionB = VectorDouble3Equal(edgeB0, zero) ? edgeB1 : edgeB0;
        const SIMDVectorDouble normal = crossAxis(directionA, directionB);
        if(separated(directionA) || separated(directionB) || separated(normal) || separated(crossAxis(directionA, normal)) || separated(crossAxis(directionB, normal)))
            return false;
        const auto parallelSeparated = [&](const SIMDVectorDouble direction)noexcept{
            return separated(crossAxis(direction, s_DoubleSIMDIdentityR0)) || separated(crossAxis(direction, s_DoubleSIMDIdentityR1)) || separated(crossAxis(direction, s_DoubleSIMDIdentityR2));
        };
        return !parallelSeparated(directionA) && !parallelSeparated(directionB);
    }

    const auto edgeSeparated = [&](const SIMDVectorDouble edge)noexcept{
        return separated(crossAxis(edge, normalA)) || separated(crossAxis(edge, normalB)) || separated(crossAxis(edge, edgeB0)) || separated(crossAxis(edge, edgeB1)) || separated(crossAxis(edge, edgeB2));
    };
    if(edgeSeparated(edgeA0) || edgeSeparated(edgeA1) || edgeSeparated(edgeA2))
        return false;
    const auto secondEdgeSeparated = [&](const SIMDVectorDouble edge)noexcept{
        return separated(crossAxis(edge, normalA)) || separated(crossAxis(edge, normalB));
    };
    return !secondEdgeSeparated(edgeB0) && !secondEdgeSeparated(edgeB1) && !secondEdgeSeparated(edgeB2);
}

FOUNDATION_NOINLINE b8 FOUNDATION_SIMD_CALL AbsHoisted(const SIMDVectorDouble a0, const SIMDVectorDouble a1, const SIMDVectorDouble a2, const SIMDVectorDouble b0, const SIMDVectorDouble b1, const SIMDVectorDouble b2)noexcept{
    const SIMDVectorDouble first0 = VectorDoubleAndInt(a0, s_DoubleSIMDMask3), first1 = VectorDoubleAndInt(a1, s_DoubleSIMDMask3), first2 = VectorDoubleAndInt(a2, s_DoubleSIMDMask3);
    const SIMDVectorDouble second0 = VectorDoubleAndInt(b0, s_DoubleSIMDMask3), second1 = VectorDoubleAndInt(b1, s_DoubleSIMDMask3), second2 = VectorDoubleAndInt(b2, s_DoubleSIMDMask3);
    const SIMDVectorDouble minA = VectorDoubleMin(first0, VectorDoubleMin(first1, first2)), maxA = VectorDoubleMax(first0, VectorDoubleMax(first1, first2));
    const SIMDVectorDouble minB = VectorDoubleMin(second0, VectorDoubleMin(second1, second2)), maxB = VectorDoubleMax(second0, VectorDoubleMax(second1, second2));
    if(!CollisionDoubleDetail::MinMaxIntersects(minA, maxA, minB, maxB))
        return false;

    const SIMDVectorDouble zero = VectorDoubleZero();
    const SIMDVectorDouble relativeA1 = VectorDoubleSubtract(first1, first0), relativeA2 = VectorDoubleSubtract(first2, first0);
    const SIMDVectorDouble relativeB0 = VectorDoubleSubtract(second0, first0), relativeB1 = VectorDoubleSubtract(second1, first0), relativeB2 = VectorDoubleSubtract(second2, first0);
    const SIMDVectorDouble absoluteA1 = VectorDoubleAbs(relativeA1), absoluteA2 = VectorDoubleAbs(relativeA2);
    const SIMDVectorDouble absoluteB0 = VectorDoubleAbs(relativeB0), absoluteB1 = VectorDoubleAbs(relativeB1), absoluteB2 = VectorDoubleAbs(relativeB2);
    const auto differenceRoundoff = [](const SIMDVectorDouble point, const SIMDVectorDouble origin, const SIMDVectorDouble difference)noexcept{
        const SIMDVectorDouble virtualOrigin = VectorDoubleSubtract(point, difference), virtualPoint = VectorDoubleAdd(difference, virtualOrigin);
        return VectorDoubleAdd(VectorDoubleSubtract(point, virtualPoint), VectorDoubleSubtract(virtualOrigin, origin));
    };
    const SIMDVectorDouble roundoffA1 = VectorDoubleAbs(differenceRoundoff(first1, first0, relativeA1)), roundoffA2 = VectorDoubleAbs(differenceRoundoff(first2, first0, relativeA2));
    const SIMDVectorDouble roundoffB0 = VectorDoubleAbs(differenceRoundoff(second0, first0, relativeB0));
    const SIMDVectorDouble roundoffB1 = VectorDoubleAbs(differenceRoundoff(second1, first0, relativeB1)), roundoffB2 = VectorDoubleAbs(differenceRoundoff(second2, first0, relativeB2));
    const SIMDVectorDouble edgeA0 = relativeA1, edgeA1 = VectorDoubleSubtract(first2, first1), edgeA2 = VectorDoubleNegate(relativeA2);
    const SIMDVectorDouble edgeB0 = VectorDoubleSubtract(second1, second0), edgeB1 = VectorDoubleSubtract(second2, second1), edgeB2 = VectorDoubleSubtract(second0, second2);
    const auto crossAxis = [](const SIMDVectorDouble first, const SIMDVectorDouble second)noexcept{
        const SIMDVectorDouble positive = VectorDoubleMultiply(VectorDoubleSwizzle<1, 2, 0, 3>(first), VectorDoubleSwizzle<2, 0, 1, 3>(second));
        const SIMDVectorDouble negative = VectorDoubleMultiply(VectorDoubleSwizzle<2, 0, 1, 3>(first), VectorDoubleSwizzle<1, 2, 0, 3>(second));
        return VectorDoubleSubtract(positive, negative);
    };
    const auto separated = [&](const SIMDVectorDouble axis)noexcept{
        if(VectorDouble3Equal(axis, zero))
            return false;
        const SIMDVectorDouble absoluteAxis = VectorDoubleAbs(axis);
        const auto projectionInterval = [&](const SIMDVectorDouble relative, const SIMDVectorDouble absoluteRelative, const SIMDVectorDouble absoluteRoundoff)noexcept{
            const SIMDVectorDouble projection = VectorDouble3Dot(relative, axis);
            const SIMDVectorDouble magnitude = VectorDouble3Dot(absoluteRelative, absoluteAxis), coordinateError = VectorDouble3Dot(absoluteRoundoff, absoluteAxis);
            const SIMDVectorDouble allowance = VectorDoubleMultiplyAddExpression(VectorDoubleAdd(magnitude, coordinateError), VectorDoubleReplicate(0x1p-49), coordinateError);
            return VectorDoubleSelect(VectorDoubleSubtract(projection, allowance), VectorDoubleAdd(projection, allowance), s_DoubleSIMDMaskY);
        };
        const SIMDVectorDouble intervalA1 = projectionInterval(relativeA1, absoluteA1, roundoffA1), intervalA2 = projectionInterval(relativeA2, absoluteA2, roundoffA2);
        const SIMDVectorDouble minimumA = VectorDoubleMin(zero, VectorDoubleMin(VectorDoubleSplatX(intervalA1), VectorDoubleSplatX(intervalA2)));
        const SIMDVectorDouble maximumA = VectorDoubleMax(zero, VectorDoubleMax(VectorDoubleSplatY(intervalA1), VectorDoubleSplatY(intervalA2)));
        const SIMDVectorDouble intervalB0 = projectionInterval(relativeB0, absoluteB0, roundoffB0), intervalB1 = projectionInterval(relativeB1, absoluteB1, roundoffB1), intervalB2 = projectionInterval(relativeB2, absoluteB2, roundoffB2);
        const SIMDVectorDouble minimumB = VectorDoubleMin(VectorDoubleSplatX(intervalB0), VectorDoubleMin(VectorDoubleSplatX(intervalB1), VectorDoubleSplatX(intervalB2)));
        const SIMDVectorDouble maximumB = VectorDoubleMax(VectorDoubleSplatY(intervalB0), VectorDoubleMax(VectorDoubleSplatY(intervalB1), VectorDoubleSplatY(intervalB2)));
        return VectorDouble4Less(maximumA, minimumB) || VectorDouble4Less(maximumB, minimumA);
    };
    const SIMDVectorDouble normalA = crossAxis(edgeA0, VectorDoubleNegate(edgeA2)), normalB = crossAxis(edgeB0, VectorDoubleNegate(edgeB2));
    if(separated(normalA) || separated(normalB))
        return false;

    if(VectorDouble3Equal(normalA, zero) && VectorDouble3Equal(normalB, zero)){
        const SIMDVectorDouble directionA = VectorDouble3Equal(edgeA0, zero) ? edgeA1 : edgeA0, directionB = VectorDouble3Equal(edgeB0, zero) ? edgeB1 : edgeB0;
        const SIMDVectorDouble normal = crossAxis(directionA, directionB);
        if(separated(directionA) || separated(directionB) || separated(normal) || separated(crossAxis(directionA, normal)) || separated(crossAxis(directionB, normal)))
            return false;
        const auto parallelSeparated = [&](const SIMDVectorDouble direction)noexcept{
            return separated(crossAxis(direction, s_DoubleSIMDIdentityR0)) || separated(crossAxis(direction, s_DoubleSIMDIdentityR1)) || separated(crossAxis(direction, s_DoubleSIMDIdentityR2));
        };
        return !parallelSeparated(directionA) && !parallelSeparated(directionB);
    }

    const auto edgeSeparated = [&](const SIMDVectorDouble edge)noexcept{
        return separated(crossAxis(edge, normalA)) || separated(crossAxis(edge, normalB)) || separated(crossAxis(edge, edgeB0)) || separated(crossAxis(edge, edgeB1)) || separated(crossAxis(edge, edgeB2));
    };
    if(edgeSeparated(edgeA0) || edgeSeparated(edgeA1) || edgeSeparated(edgeA2))
        return false;
    const auto secondEdgeSeparated = [&](const SIMDVectorDouble edge)noexcept{
        return separated(crossAxis(edge, normalA)) || separated(crossAxis(edge, normalB));
    };
    return !secondEdgeSeparated(edgeB0) && !secondEdgeSeparated(edgeB1) && !secondEdgeSeparated(edgeB2);
}

[[nodiscard]] FOUNDATION_INLINE Intersection SelectImplementation(const u32 implId)noexcept{
    switch(implId){
    case 0u: return Baseline;
    case 1u: return CurrentDot3Baseline;
    case 2u: return ZeroAxis;
    case 3u: return AbsHoisted;
    default: return TriangleDoubleTests::Intersects;
    }
}

template<typename PairT>
FOUNDATION_NOINLINE u64 RunBatch(const u32 implId, const Span<const PairT> pairs, const u32 passes)noexcept{
    const NotNull<Intersection> implementation = MakeNotNull<Intersection>(SelectImplementation(implId));
    u64 result = 0u;
    for(u32 pass = 0u; pass < passes; ++pass){
        for(const PairT& pair : pairs)
            result += implementation.get()(LoadDouble(pair.first[0]), LoadDouble(pair.first[1]), LoadDouble(pair.first[2]), LoadDouble(pair.second[0]), LoadDouble(pair.second[1]), LoadDouble(pair.second[2])) ? 1u : 0u;
    }
    s_ChecksumSink = result;
    return result;
}

template<typename PairT>
[[nodiscard]] FOUNDATION_INLINE TrianglePairVectors LoadTrianglePair(const PairT& pair)noexcept{
    return { { LoadDouble(pair.first[0]), LoadDouble(pair.first[1]), LoadDouble(pair.first[2]) }, { LoadDouble(pair.second[0]), LoadDouble(pair.second[1]), LoadDouble(pair.second[2]) } };
}

[[nodiscard]] FOUNDATION_INLINE b8 CheckExceptionEquivalence(const TrianglePairVectors& pair)noexcept{
#pragma STDC FENV_ACCESS ON
    const auto originalEnvironment = HoldFloatingPointExceptions();
    if(!originalEnvironment)
        return false;
    NWB::Tests::FloatingPointEnvironmentGuard restoreEnvironment(*originalEnvironment);
    const b8 original = Baseline(pair.first[0], pair.first[1], pair.first[2], pair.second[0], pair.second[1], pair.second[2]);
    const i32 originalFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    const b8 reference = ZeroAxis(pair.first[0], pair.first[1], pair.first[2], pair.second[0], pair.second[1], pair.second[2]);
    const i32 referenceFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    const b8 hoisted = AbsHoisted(pair.first[0], pair.first[1], pair.first[2], pair.second[0], pair.second[1], pair.second[2]);
    const i32 hoistedFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    const b8 production = TriangleDoubleTests::Intersects(pair.first[0], pair.first[1], pair.first[2], pair.second[0], pair.second[1], pair.second[2]);
    const i32 productionFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    return original == reference && reference == hoisted && hoisted == production && originalFlags == referenceFlags && referenceFlags == hoistedFlags && hoistedFlags == productionFlags;
}

#if defined(FOUNDATION_PLATFORM_LINUX)
FOUNDATION_INLINE void TrapHandler([[maybe_unused]] const i32 signalNumber, siginfo_t* information, [[maybe_unused]] void* context)noexcept{
    _exit(32 + information->si_code);
}

[[nodiscard]] FOUNDATION_INLINE Expected<i32, ErrorCode> TrapResult(const NotNull<Intersection> implementation, const TrianglePairVectors& pair, const i32 mask)noexcept{
    const pid_t child = fork();
    if(child < 0)
        return MakeUnexpected(MakeErrorCode(static_cast<ErrorCondition>(errno)));
    if(child == 0){
        struct sigaction action{};
        action.sa_sigaction = TrapHandler;
        action.sa_flags = SA_SIGINFO;
        if(sigemptyset(&action.sa_mask) != 0 || sigaction(SIGFPE, &action, nullptr) != 0)
            _exit(127);
        const auto environment = HoldFloatingPointExceptions();
        if(!environment || feenableexcept(mask) < 0)
            _exit(127);
        const b8 result = implementation.get()(pair.first[0], pair.first[1], pair.first[2], pair.second[0], pair.second[1], pair.second[2]);
        _exit(result ? 1 : 0);
    }
    i32 status = 0;
    if(waitpid(child, &status, 0) != child)
        return MakeUnexpected(MakeErrorCode(static_cast<ErrorCondition>(errno)));
    if(!WIFEXITED(status))
        return MakeUnexpected(MakeErrorCode(ErrorCondition::state_not_recoverable));
    return WEXITSTATUS(status);
}
#endif

[[nodiscard]] FOUNDATION_INLINE b8 CheckTrapEquivalence(const TrianglePairVectors& pair)noexcept{
#if defined(FOUNDATION_PLATFORM_LINUX)
    const auto production = MakeNotNull<Intersection>(TriangleDoubleTests::Intersects);
    for(const i32 mask : { FE_INVALID, FE_OVERFLOW, FE_INVALID | FE_OVERFLOW, FE_INVALID | FE_OVERFLOW | FE_UNDERFLOW | FE_INEXACT }){
        const auto original = TrapResult(MakeNotNull<Intersection>(Baseline), pair, mask);
        if(!original || *original == 127)
            return false;
        for(const auto implementation : { MakeNotNull<Intersection>(ZeroAxis), MakeNotNull<Intersection>(AbsHoisted), production }){
            const auto observed = TrapResult(implementation, pair, mask);
            if(!observed || *observed != *original)
                return false;
        }
    }
#else
    if(!CheckExceptionEquivalence(pair))
        return false;
#endif
    return true;
}

[[nodiscard]] FOUNDATION_INLINE u64 NextGeometryVerifySeed(u64& state)noexcept{
    state ^= state << 13u;
    state ^= state >> 7u;
    state ^= state << 17u;
    return state;
}

}

template<typename PairT>
[[nodiscard]] FOUNDATION_INLINE b8 CheckTrianglePairPermutationsKernel(const PairT& pair, const b8 expected)noexcept{
    const GeometryKernels::TrianglePairVectors vectors = GeometryKernels::LoadTrianglePair(pair);
    constexpr Array<Array<u32, 3>, 6> s_Permutations = {
        Array<u32, 3>{ 0u, 1u, 2u },
        Array<u32, 3>{ 0u, 2u, 1u },
        Array<u32, 3>{ 1u, 0u, 2u },
        Array<u32, 3>{ 1u, 2u, 0u },
        Array<u32, 3>{ 2u, 0u, 1u },
        Array<u32, 3>{ 2u, 1u, 0u },
    };
    b8 valid = true;
    for(const auto& firstOrder : s_Permutations){
        for(const auto& secondOrder : s_Permutations){
            for(const b8 reverse : { false, true }){
                const auto& first = reverse ? vectors.second : vectors.first;
                const auto& second = reverse ? vectors.first : vectors.second;
                const auto& firstIndices = reverse ? secondOrder : firstOrder;
                const auto& secondIndices = reverse ? firstOrder : secondOrder;
                const b8 baseline = GeometryKernels::Baseline(first[firstIndices[0]], first[firstIndices[1]], first[firstIndices[2]], second[secondIndices[0]], second[secondIndices[1]], second[secondIndices[2]]);
                const b8 candidate = GeometryKernels::ZeroAxis(first[firstIndices[0]], first[firstIndices[1]], first[firstIndices[2]], second[secondIndices[0]], second[secondIndices[1]], second[secondIndices[2]]);
                const b8 production = TriangleDoubleTests::Intersects(first[firstIndices[0]], first[firstIndices[1]], first[firstIndices[2]], second[secondIndices[0]], second[secondIndices[1]], second[secondIndices[2]]);
                const b8 hoisted = GeometryKernels::AbsHoisted(first[firstIndices[0]], first[firstIndices[1]], first[firstIndices[2]], second[secondIndices[0]], second[secondIndices[1]], second[secondIndices[2]]);
                if(baseline != expected || candidate != baseline || production != baseline || hoisted != baseline)
                    valid = false;
            }
        }
    }
    return valid;
}

template<typename PairT>
[[nodiscard]] FOUNDATION_INLINE b8 ValidateGeometryContainmentAndTrapsKernel(const PairT& fixture0, const PairT& fixture3)noexcept{
#pragma STDC FENV_ACCESS ON
    constexpr u64 s_VerifyInitialState = 0x4f1bbcdc6762c13fu;
    constexpr u32 s_ContainedSampleCount = 200000u;
    u64 state = s_VerifyInitialState;
    b8 valid = true;
    for(u32 sample = 0u; sample < s_ContainedSampleCount && valid; ++sample){
        GeometryKernels::TrianglePairVectors pair{};
        for(u32 vertex = 0u; vertex < 3u; ++vertex){
            Array<f64, 3> coordinates{};
            for(f64& coordinate : coordinates)
                coordinate = static_cast<f64>(static_cast<i64>(GeometryKernels::NextGeometryVerifySeed(state) % 2000000001u) - 1000000000);
            pair.first[vertex] = VectorDoubleScale(VectorDoubleSet(coordinates[0], coordinates[1], coordinates[2], 0.0), 0.25);
        }
        const SIMDVectorDouble contained = VectorDoubleScale(VectorDoubleAdd(VectorDoubleAdd(VectorDoubleScale(pair.first[0], 2.0), pair.first[1]), pair.first[2]), 0.25);
        for(SIMDVectorDouble& vertex : pair.second)
            vertex = contained;
        if(
            !GeometryKernels::Baseline(pair.first[0], pair.first[1], pair.first[2], contained, contained, contained)
            || !GeometryKernels::ZeroAxis(pair.first[0], pair.first[1], pair.first[2], contained, contained, contained)
            || !TriangleDoubleTests::Intersects(pair.first[0], pair.first[1], pair.first[2], contained, contained, contained)
            || !GeometryKernels::AbsHoisted(pair.first[0], pair.first[1], pair.first[2], contained, contained, contained)
        ){
            valid = false;
            break;
        }
        for(u32 vertex = 0u; vertex < 3u; ++vertex){
            Array<f64, 3> coordinates{};
            for(f64& coordinate : coordinates)
                coordinate = static_cast<f64>(static_cast<i64>(GeometryKernels::NextGeometryVerifySeed(state) % 2000001u) - 1000000);
            pair.first[vertex] = VectorDoubleSet(coordinates[0], coordinates[1], coordinates[2], 0.0);
        }
        const SIMDVectorDouble containedSingle = VectorDoubleScale(VectorDoubleAdd(VectorDoubleAdd(VectorDoubleScale(pair.first[0], 2.0), pair.first[1]), pair.first[2]), 0.25);
        for(u32 vertex = 0u; vertex < 3u; ++vertex){
            pair.first[vertex] = ConvertVectorSingleToDouble(ConvertVectorDoubleToSingle(pair.first[vertex]));
            pair.second[vertex] = ConvertVectorSingleToDouble(ConvertVectorDoubleToSingle(containedSingle));
        }
        if(
            !GeometryKernels::Baseline(pair.first[0], pair.first[1], pair.first[2], pair.second[0], pair.second[1], pair.second[2])
            || !GeometryKernels::ZeroAxis(pair.first[0], pair.first[1], pair.first[2], pair.second[0], pair.second[1], pair.second[2])
            || !TriangleDoubleTests::Intersects(pair.first[0], pair.first[1], pair.first[2], pair.second[0], pair.second[1], pair.second[2])
            || !GeometryKernels::AbsHoisted(pair.first[0], pair.first[1], pair.first[2], pair.second[0], pair.second[1], pair.second[2])
        ){
            valid = false;
            break;
        }
    }
    if(valid){
        GeometryKernels::TrianglePairVectors signaling = GeometryKernels::LoadTrianglePair(fixture0);
        constexpr u64 s_SignalingNaNBits = 0x7ff0000000000001u;
        for(SIMDVectorDouble& vertex : signaling.first)
            vertex = VectorDoubleSetIntW(vertex, s_SignalingNaNBits);
        for(SIMDVectorDouble& vertex : signaling.second)
            vertex = VectorDoubleSetIntW(vertex, s_SignalingNaNBits);
        const auto environment = HoldFloatingPointExceptions();
        if(!environment){
            valid = false;
        }
        else{
            const b8 baseline = GeometryKernels::Baseline(signaling.first[0], signaling.first[1], signaling.first[2], signaling.second[0], signaling.second[1], signaling.second[2]);
            const i32 baselineExceptions = TestFloatingPointExceptions(FE_ALL_EXCEPT);
            if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT)){
                valid = false;
            }
            else{
                const b8 candidate = GeometryKernels::ZeroAxis(signaling.first[0], signaling.first[1], signaling.first[2], signaling.second[0], signaling.second[1], signaling.second[2]);
                const i32 candidateExceptions = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT)){
                    valid = false;
                }
                else{
                    const b8 production = TriangleDoubleTests::Intersects(signaling.first[0], signaling.first[1], signaling.first[2], signaling.second[0], signaling.second[1], signaling.second[2]);
                    const i32 productionExceptions = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT)){
                        valid = false;
                    }
                    else{
                        const b8 hoisted = GeometryKernels::AbsHoisted(signaling.first[0], signaling.first[1], signaling.first[2], signaling.second[0], signaling.second[1], signaling.second[2]);
                        const i32 hoistedExceptions = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                        if(!SetFloatingPointEnvironment(*environment))
                            valid = false;
                        if(!(baseline && candidate && production && hoisted && baselineExceptions == candidateExceptions && candidateExceptions == productionExceptions && productionExceptions == hoistedExceptions && (candidateExceptions & FE_INVALID) == 0))
                            valid = false;
                    }
                }
            }
        }
    }
    if(valid){
        const Array<u64, 3> activeBits = { 0x7ff0000000000000u, 0x7ff8000012345678u, 0x7ff0000000000001u };
        constexpr Array<f64, 6> s_Scales = { 0.0, 0x1p-300, 0x1p-100, 0x1p+100, 0x1p+300, 0x1p+900 };
        for(const f64 scale : s_Scales){
            GeometryKernels::TrianglePairVectors scaled = GeometryKernels::LoadTrianglePair(fixture3);
            for(u32 vertex = 0u; vertex < 3u; ++vertex){
                scaled.first[vertex] = VectorDoubleMultiply(scaled.first[vertex], VectorDoubleReplicate(scale));
                scaled.second[vertex] = VectorDoubleMultiply(scaled.second[vertex], VectorDoubleReplicate(scale));
            }
            if(!GeometryKernels::CheckExceptionEquivalence(scaled))
                valid = false;
        }
        for(u32 index = 0u; index < activeBits.size(); ++index){
            GeometryKernels::TrianglePairVectors active = GeometryKernels::LoadTrianglePair(fixture3);
            volatile u64 bits = activeBits[index];
            active.first[0] = VectorDoubleSetIntX(active.first[0], bits);
            if(!GeometryKernels::CheckExceptionEquivalence(active))
                valid = false;
        }
        constexpr f64 s_Maximum = Limit<f64>::s_Max;
        Array<PairT, 2> extreme{};
        extreme[0].first = { Double4(0.0, 1.0, 1.0, 0.0), Double4(0.0, 1.0, 1.0, 0.0), Double4(0.0, 1.0, 1.0, 0.0) };
        extreme[0].second = { Double4(Limit<f64>::s_Infinity, 1.0, 2.0, 0.0), Double4(-1.0, -1.0, -1.0, 0.0), Double4(1.0, 3.0, 4.0, 0.0) };
        extreme[1].first = { Double4(s_Maximum, 0.0, 0.0, 0.0), Double4(s_Maximum, 0.0, 0.0, 0.0), Double4(s_Maximum, 0.0, 0.0, 0.0) };
        extreme[1].second = { Double4(-s_Maximum, -1.0, -1.0, 0.0), Double4(0.0, 1.0, 1.0, 0.0), Double4(s_Maximum, 0.0, 0.0, 0.0) };
        for(const PairT& pair : extreme){
            const GeometryKernels::TrianglePairVectors vectors = GeometryKernels::LoadTrianglePair(pair);
            if(!GeometryKernels::CheckExceptionEquivalence(vectors) || !GeometryKernels::CheckTrapEquivalence(vectors))
                valid = false;
        }
    }
    return valid;
}

template<typename PairT, usize PairCount>
[[nodiscard]] FOUNDATION_INLINE u64 RunGeometryBatchKernel(const u32 implId, const Array<PairT, PairCount>& pairs, const u32 passes)noexcept{
    return GeometryKernels::RunBatch(implId, Span<const PairT>(pairs.data(), pairs.size()), passes);
}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_ZeroAxisLabel = "zero_axis";
const StringView s_ValidateMode = "validate";
const StringView s_AbsoluteMode = "abs";
const StringView s_GuardMode = "guard";
const u32 s_GeometryFixtureCount = 64u;
const u32 s_GeometryRounds = 7u;
const u32 s_GeometryPasses = 512u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TrianglePair{
    public Array<f64x4, 3> first;
    public Array<f64x4, 3> second;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StringView GeometryWorkloadName(in u32 kind){
    switch(kind){
    case 0u: return "coplanar";
    case 1u: return "point_hull";
    case 2u: return "segment_hull";
    case 3u: return "noncoplanar";
    case 4u: return "noncoplanar_miss";
    case 5u: return "aabb_miss";
    default: return "point_point";
    }
}

void FillTrianglePairs(in u32 kind, mut Span<TrianglePair> pairs){
    for(usize index = 0u; index < pairs.size(); ++index){
        // Multiply by -0.25 to match the negated product bits.
        const f64 step = cast<f64>(index);
        const f64 tx = step * 0.25;
        const f64 ty = step * -0.25;
        const f64 tz = step * 0.25;
        Array<f64x4, 3> first;
        Array<f64x4, 3> second;
        if(kind == 0u){
            first[0] = f64x4(0.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[1] = f64x4(4.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[2] = f64x4(0.0 + tx, 4.0 + ty, 0.0 + tz, 0.0);
            second[0] = f64x4(1.0 + tx, 1.0 + ty, 0.0 + tz, 0.0);
            second[1] = f64x4(3.0 + tx, 1.0 + ty, 0.0 + tz, 0.0);
            second[2] = f64x4(1.0 + tx, 3.0 + ty, 0.0 + tz, 0.0);
        }
        else if(kind == 1u){
            first[0] = f64x4(0.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[1] = f64x4(4.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[2] = f64x4(0.0 + tx, 4.0 + ty, 0.0 + tz, 0.0);
            second[0] = f64x4(1.0 + tx, 1.0 + ty, 0.0 + tz, 0.0);
            second[1] = f64x4(1.0 + tx, 1.0 + ty, 0.0 + tz, 0.0);
            second[2] = f64x4(1.0 + tx, 1.0 + ty, 0.0 + tz, 0.0);
        }
        else if(kind == 2u){
            first[0] = f64x4(0.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[1] = f64x4(1.0 + tx, 1.0 + ty, 0.0 + tz, 0.0);
            first[2] = f64x4(2.0 + tx, 2.0 + ty, 0.0 + tz, 0.0);
            second[0] = f64x4(1.0 + tx, 1.0 + ty, 0.0 + tz, 0.0);
            second[1] = f64x4(2.0 + tx, 2.0 + ty, 0.0 + tz, 0.0);
            second[2] = f64x4(3.0 + tx, 3.0 + ty, 0.0 + tz, 0.0);
        }
        else if(kind == 3u){
            first[0] = f64x4(0.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[1] = f64x4(3.0 + tx, 1.0 + ty, 2.0 + tz, 0.0);
            first[2] = f64x4(1.0 + tx, 4.0 + ty, -1.0 + tz, 0.0);
            second[0] = f64x4(1.0 + tx, 1.25 + ty, 0.25 + tz, 0.0);
            second[1] = f64x4(1.5 + tx, 2.5 + ty, 1.0 + tz, 0.0);
            second[2] = f64x4(0.25 + tx, 1.75 + ty, 1.75 + tz, 0.0);
        }
        else if(kind == 4u){
            first[0] = f64x4(0.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[1] = f64x4(2.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[2] = f64x4(0.0 + tx, 2.0 + ty, 0.0 + tz, 0.0);
            second[0] = f64x4(1.5 + tx, 1.5 + ty, -1.0 + tz, 0.0);
            second[1] = f64x4(1.5 + tx, 2.0 + ty, 1.0 + tz, 0.0);
            second[2] = f64x4(2.0 + tx, 1.5 + ty, 1.0 + tz, 0.0);
        }
        else if(kind == 5u){
            first[0] = f64x4(0.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[1] = f64x4(2.0 + tx, 0.0 + ty, 0.0 + tz, 0.0);
            first[2] = f64x4(0.0 + tx, 2.0 + ty, 0.0 + tz, 0.0);
            second[0] = f64x4(100.0 + tx, 100.0 + ty, 100.0 + tz, 0.0);
            second[1] = f64x4(102.0 + tx, 100.0 + ty, 100.0 + tz, 0.0);
            second[2] = f64x4(100.0 + tx, 102.0 + ty, 100.0 + tz, 0.0);
        }
        else{
            first[0] = f64x4(1.0 + tx, 1.0 + ty, 1.0 + tz, 0.0);
            first[1] = f64x4(1.0 + tx, 1.0 + ty, 1.0 + tz, 0.0);
            first[2] = f64x4(1.0 + tx, 1.0 + ty, 1.0 + tz, 0.0);
            second[0] = f64x4(1.0 + tx, 1.0 + ty, 1.0 + tz, 0.0);
            second[1] = f64x4(1.0 + tx, 1.0 + ty, 1.0 + tz, 0.0);
            second[2] = f64x4(1.0 + tx, 1.0 + ty, 1.0 + tz, 0.0);
        }
        pairs[index].first = first;
        pairs[index].second = second;
    }
}

b8 CheckTrianglePair(in TrianglePair pair, in b8 expected){
    return CheckTrianglePairPermutationsKernel(pair, expected);
}

b8 ValidateGeometryBenchmark(){
    Array<TrianglePair, s_GeometryFixtureCount> pairs;
    for(u32 kind = 0u; kind < 7u; ++kind){
        FillTrianglePairs(kind, pairs);
        if(!CheckTrianglePair(pairs[0], kind != 4u && kind != 5u))
            return false;
    }

    FillTrianglePairs(0u, pairs);
    const TrianglePair fixture0 = pairs[0];
    FillTrianglePairs(3u, pairs);
    const TrianglePair fixture3 = pairs[0];
    return ValidateGeometryContainmentAndTrapsKernel(fixture0, fixture3);
}

void SortGeometryRoundValues(mut Array<f64, s_GeometryRounds> sorted){
    for(usize index = 1u; index < s_GeometryRounds; ++index){
        const f64 value = sorted[index];
        usize destination = index;
        while(destination != 0u && sorted[destination - 1u] > value){
            sorted[destination] = sorted[destination - 1u];
            --destination;
        }
        sorted[destination] = value;
    }
}

void PrintGeometrySummary(in StringView prefix, in StringView workload, in Array<f64, s_GeometryRounds> values){
    Array<f64, s_GeometryRounds> sorted = values;
    SortGeometryRoundValues(sorted);
    const f64 medianValue = sorted[s_GeometryRounds / 2u];
    const f64 minValue = sorted[0];
    const f64 maxValue = sorted[s_GeometryRounds - 1u];
    WriteBenchmarkStdout(StringFormat("{}_summary,{},{},{},{}\n", prefix, workload, medianValue, minValue, maxValue));
}

u64 RunGeometryImplementation(in u32 implId, in Array<TrianglePair, s_GeometryFixtureCount> pairs, in u32 passes){
    return RunGeometryBatchKernel(implId, pairs, passes);
}

i32 RunGeometryBenchmark(in b8 validationOnly, in b8 measureAbs, in b8 guardOnly){
    if(!ValidateGeometryBenchmark()){
        WriteBenchmarkStderr("validation failed\n");
        return 1;
    }
    WriteBenchmarkStdout("validation,400000 exact containment probes, winding, finite/nonfinite FENV and trap-order equivalence,passed\n");
    if(validationOnly)
        return 0;

    u32 referenceId = 0u;
    u32 selectedId = 4u;
    StringView referenceName = "baseline";
    StringView selectedName = "production";
    StringView modeLabel = "production_vs_original_baseline";
    if(measureAbs){
        referenceId = 2u;
        selectedId = 3u;
        referenceName = s_ZeroAxisLabel;
        selectedName = "abs_hoisted";
        modeLabel = "abs_hoisted_vs_zero_axis";
    }
    else if(guardOnly){
        referenceId = 1u;
        selectedId = 2u;
        referenceName = "current_dot3_baseline";
        selectedName = s_ZeroAxisLabel;
        modeLabel = "zero_axis_vs_current_dot3";
    }

    WriteBenchmarkStdout(StringFormat("timer,TimerNow/DurationInNS\nmode,{}\n", modeLabel));

    Array<TrianglePair, s_GeometryFixtureCount> pairs;
    for(u32 kind = 0u; kind < 7u; ++kind){
        FillTrianglePairs(kind, pairs);
        const u64 expected = RunGeometryImplementation(referenceId, pairs, 1u) * cast<u64>(s_GeometryPasses);
        if(RunGeometryImplementation(selectedId, pairs, 1u) * cast<u64>(s_GeometryPasses) != expected)
            return 2;

        const StringView workloadName = GeometryWorkloadName(kind);
        Array<f64, s_GeometryRounds> baselineValues;
        Array<f64, s_GeometryRounds> candidateValues;
        Array<f64, s_GeometryRounds> ratios;
        for(u32 round = 0u; round < s_GeometryRounds; ++round){
            for(u32 step = 0u; step < 2u; ++step){
                const b8 candidate = ((round + step) & 1u) != 0u;
                u32 implId = referenceId;
                StringView implName = referenceName;
                if(candidate){
                    implId = selectedId;
                    implName = selectedName;
                }
                const Timer begin = TimerNow();
                const u64 checksum = RunGeometryImplementation(implId, pairs, s_GeometryPasses);
                const f64 elapsedNs = DurationInNS<f64>(TimerNow(), begin);
                if(checksum != expected)
                    return 3;
                const f64 nanoseconds = elapsedNs / cast<f64>(s_GeometryPasses * s_GeometryFixtureCount);
                if(candidate)
                    candidateValues[cast<usize>(round)] = nanoseconds;
                else
                    baselineValues[cast<usize>(round)] = nanoseconds;
                WriteBenchmarkStdout(StringFormat("sample,{},{},{},{},{}\n", workloadName, implName, round, nanoseconds, checksum));
            }
            ratios[cast<usize>(round)] = candidateValues[cast<usize>(round)] / baselineValues[cast<usize>(round)];
        }
        PrintGeometrySummary(referenceName, workloadName, baselineValues);
        PrintGeometrySummary(selectedName, workloadName, candidateValues);
        PrintGeometrySummary("ratio", workloadName, ratios);
    }
    return 0;
}

i32 RunGeometryBenchmarkCli(in Span<StringView> args){
    StringView mode = "";
    if(args.size() > 1u)
        mode = args[1];
    if(!mode.empty() && mode != s_ValidateMode && mode != s_AbsoluteMode && mode != s_GuardMode)
        return 2;
    return RunGeometryBenchmark(mode == s_ValidateMode, mode == s_AbsoluteMode, mode == s_GuardMode);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


int main(int argc, char** argv){
    if(argc <= 0)
        return 2;
    Array<StringView, 4> args{};
    const usize count = Min(static_cast<usize>(argc), args.size());
    for(usize index = 0u; index < count; ++index)
        args[index] = StringView(argv[index]);
    return SimdOptimizationBenchmark::RunGeometryBenchmarkCli(Span<const StringView>(args.data(), count));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


