#ifndef NWB_GRAPHICS_GI_SURFEL_GBUFFER_SLANGI
#define NWB_GRAPHICS_GI_SURFEL_GBUFFER_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


float3 nwbSurfelDecodeGbufferNormal(const float3 packedNormal){
    return normalize(packedNormal * 2.0 - 1.0);
}


