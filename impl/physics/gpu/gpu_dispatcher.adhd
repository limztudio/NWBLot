    public void invalidateResources(){
        if(!this.m_graphics.has_value())
            return;

        mut GraphicsRuntime graphics = this.m_graphics.value();
        const b8 drained = graphics.waitForIdle();
        if(!drained)
            warning("PhysicsGpuDispatcher: waitForIdle returned false during invalidateResources");

        mut GpuDescriptorHeap heap = graphics.getDevice().getDescriptorHeap();
        ReleasePhysicsGpuBufferSlot(heap, this.m_bodySimSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_bodyStateSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_shapeSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_shapeAabbSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_pairSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_surfacePairSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_counterSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_indirectArgsSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_gridSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_largeListSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_hullVertexSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_meshNodeSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_meshTriSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_manifoldSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_constraintSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_jointConstraintSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_bodyOutSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_contactImpulseOutSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_contactTotalImpulseSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_jointImpulseOutSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_islandSliceSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_solverBodySimSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_rollingMassSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_toiBodySimSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_toiShapeSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_toiPairSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_toiManifoldSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_nonCollideHashSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_lbvhMortonSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_lbvhMortonTempSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_lbvhRadixHistSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_lbvhNodeSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_lbvhMetaSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_queryBodyPoseSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_queryShapeSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_queryShapeAabbSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_queryLbvhMortonSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_queryLbvhNodeSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_spatialQuerySlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_spatialQueryResultSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_spatialQueryAuxSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_spatialQueryMultiHitSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_spatialQueryShapeSlot);
        for(usize ri = 0u; ri < s_PhysicsGpuExportRingSlots; ++ri){
            ReleasePhysicsGpuBufferSlot(heap, this.m_renderBindingSlots[ri]);
            ReleasePhysicsGpuBufferSlot(heap, this.m_exportPoseSlots[ri]);
            this.m_exportTrackers[ri] = PhysicsGpuExportSubmissionTracker();
            this.m_renderBindingBufferGens[ri] = 0u;
            this.m_exportPoseBufferGens[ri] = 0u;
        }
        ReleasePhysicsGpuBufferSlot(heap, this.m_renderTransformOutSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_shapeMatSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_warmCachePrevSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_warmCacheNextSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_resRawConstraintSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_resRawContactAuxSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_resRawMetaFeatSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_resSortedMetaFeatSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_resPrepCountersSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_resColorMetaSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_resColorIndirectSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_resBodyMaskWakeSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_resEventRingSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_resJointConstraintSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_resJointRefreshMetaSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_resJointAuxSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_resJointImpulseOutSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_resBulletMetaSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_resBodyMaxRadiusSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_resBulletInputSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_resBulletShapeIdxSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_toiCounterSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_toiIndirectSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_softParticlePosSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_softParticlePosTmpSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_softParticleStateSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_softScHeadSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_softScNextSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_softBackstopSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_forceFieldSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_fluidVolumeSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_fluidBodyVolSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_softWorldPoseSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_softWorldShapeSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_softWorldAabbSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_softBsRangeSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_gerstnerWaveSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_softDeformXfConstSlot);
        for(usize s = 0u; s < s_SoftBodyGpuCacheSlotCount; ++s){
            mut SoftBodyGpuTopoCacheSlot tSlot = this.m_softTopoCacheSlots[s];
            ReleasePhysicsGpuBufferSlot(heap, tSlot.distConSlot);
            ReleasePhysicsGpuBufferSlot(heap, tSlot.volConSlot);
            ReleasePhysicsGpuBufferSlot(heap, tSlot.bendConSlot);
            ReleasePhysicsGpuBufferSlot(heap, tSlot.adjRangeSlot);
            ReleasePhysicsGpuBufferSlot(heap, tSlot.adjListSlot);
            ReleasePhysicsGpuBufferSlot(heap, tSlot.aeroRangeSlot);
            ReleasePhysicsGpuBufferSlot(heap, tSlot.aeroListSlot);
            ReleasePhysicsGpuBufferSlot(heap, tSlot.surfTriSlot);
            ReleasePhysicsGpuBufferSlot(heap, tSlot.restRelSlot);
            ReleasePhysicsGpuBufferSlot(heap, tSlot.shapeOutSlot);
            mut SoftBodyGpuDeformCacheSlot dSlot = this.m_softDeformCacheSlots[s];
            ReleasePhysicsGpuBufferSlot(heap, dSlot.vertMapSlot);
            ReleasePhysicsGpuBufferSlot(heap, dSlot.cagePartSlot);
            ReleasePhysicsGpuBufferSlot(heap, dSlot.cageBarySlot);
            ReleasePhysicsGpuBufferSlot(heap, dSlot.triIdxSlot);
            ReleasePhysicsGpuBufferSlot(heap, dSlot.vertTriRangeSlot);
            ReleasePhysicsGpuBufferSlot(heap, dSlot.vertTriListSlot);
            ReleasePhysicsGpuBufferSlot(heap, dSlot.uvSlot);
            ReleasePhysicsGpuBufferSlot(heap, dSlot.meshletMetaSlot);
            ReleasePhysicsGpuBufferSlot(heap, dSlot.meshletVertSlot);
            ReleasePhysicsGpuBufferSlot(heap, dSlot.meshletTriSlot);
        }
        ReleasePhysicsGpuBufferSlot(heap, this.m_envBodyFilterSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_envSplashCounterSlot);
        ReleasePhysicsGpuBufferSlot(heap, this.m_envSplashEventSlot);
        for(usize ei = 0u; ei < this.m_retiredExportBuffers.size(); ++ei){
            mut RetiredPhysicsGpuExportBuffer retired = this.m_retiredExportBuffers[ei];
            if(retired.descriptor.valid() && heap.isInitialized())
                heap.free(retired.descriptor);
            retired.descriptor = GpuDescriptorHandle();
            retired.buffer.reset();
        }
        this.m_retiredExportBuffers.clear();
        for(usize rci = 0u; rci < this.m_retiredComputeBuffers.size(); ++rci){
            mut RetiredPhysicsGpuComputeBuffer retiredC = this.m_retiredComputeBuffers[rci];
            if(retiredC.descriptor.valid() && heap.isInitialized())
                heap.free(retiredC.descriptor);
            retiredC.descriptor = GpuDescriptorHandle();
            retiredC.buffer.reset();
        }
        this.m_retiredComputeBuffers.clear();
        this.m_exportRingIndex = 0u;
        this.m_exportFrameStamp = 0u;
        this.m_exportGraphBindingCursor = 0u;
        this.m_exportGraphPoseCursor = 0u;
        for(usize clIdx = 0u; clIdx < s_PhysicsGpuComputeCmdRingSlots; ++clIdx){
            this.m_computeCommandLists[clIdx].reset();
            this.m_computeCmdTokens[clIdx] = QueueSubmissionToken();
        }
        this.m_computeCmdCursor = 0u;
        this.m_computeQueue = GpuPhysicalQueueId();
        this.m_lastComputeToken = QueueSubmissionToken();
        this.m_resWarmGen = 0u;
        this.m_resWarmPrevGen = 0u;
        this.m_resWarmClearPending = 2u;

        this.invalidateWorldCaches();

        this.m_broadphasePipeline.reset();
        this.m_narrowphasePrimPipeline.reset();
        this.m_narrowphaseComplexPipeline.reset();
        this.m_narrowphaseMeshPipeline.reset();
        this.m_narrowphaseTerrainPipeline.reset();
        this.m_bulletToiPipeline.reset();
        this.m_integrateVelPipeline.reset();
        this.m_contactsPipeline.reset();
        this.m_jointsPipeline.reset();
        this.m_integratePosPipeline.reset();
        this.m_finalizePipeline.reset();
        this.m_islandsPipeline.reset();
        this.m_largeIslandsPipeline.reset();
        this.m_jointIslandsPipeline.reset();
        this.m_jointOnlyIslandsPipeline.reset();
        this.m_lbvhBroadphasePipeline.reset();
        this.m_gpuResidentStepPipeline.reset();
        this.m_gpuResidentToiPipeline.reset();
        this.m_spatialQueryPipeline.reset();
        this.m_spatialQuerySimplePipeline.reset();
        this.m_spatialQueryShapePipeline.reset();
        this.m_exportRenderTransformsPipeline.reset();
        this.m_gpuResidentContactPrepPipeline.reset();
        this.m_gpuSubsysEnvPipeline.reset();
        this.m_gpuSubsysSoftXpbdPipeline.reset();
        this.m_gpuSubsysSoftCollidePipeline.reset();
        this.m_gpuSubsysSoftDeformPipeline.reset();

        this.m_broadphaseShader.reset();
        this.m_narrowphasePrimShader.reset();
        this.m_narrowphaseComplexShader.reset();
        this.m_narrowphaseMeshShader.reset();
        this.m_narrowphaseTerrainShader.reset();
        this.m_bulletToiShader.reset();
        this.m_integrateVelShader.reset();
        this.m_contactsShader.reset();
        this.m_jointsShader.reset();
        this.m_integratePosShader.reset();
        this.m_finalizeShader.reset();
        this.m_islandsShader.reset();
        this.m_largeIslandsShader.reset();
        this.m_jointIslandsShader.reset();
        this.m_jointOnlyIslandsShader.reset();
        this.m_lbvhBroadphaseShader.reset();
        this.m_gpuResidentStepShader.reset();
        this.m_gpuResidentToiShader.reset();
        this.m_spatialQueryShader.reset();
        this.m_spatialQuerySimpleShader.reset();
        this.m_spatialQueryShapeShader.reset();
        this.m_exportRenderTransformsShader.reset();
        this.m_gpuResidentContactPrepShader.reset();
        this.m_gpuSubsysEnvShader.reset();
        this.m_gpuSubsysSoftXpbdShader.reset();
        this.m_gpuSubsysSoftCollideShader.reset();
        this.m_gpuSubsysSoftDeformShader.reset();
        this.m_contactsBlockPipeline.reset();
        this.m_islandsBlockPipeline.reset();
        this.m_largeIslandsBlockPipeline.reset();
        this.m_jointIslandsBlockPipeline.reset();
        this.m_contactsBlockShader.reset();
        this.m_islandsBlockShader.reset();
        this.m_largeIslandsBlockShader.reset();
        this.m_jointIslandsBlockShader.reset();

        this.m_bindingLayout.reset();
        this.m_deviceGeneration = 0u;
        this.m_pipelinesReady = false;
    }

    public b8 validateResources(){
        if(!this.m_graphics.has_value() || !this.m_assetManager.has_value())
            return false;

        mut GraphicsRuntime graphics = this.m_graphics.value();
        mut Device device = graphics.getDevice();
        in GpuDescriptorHeap heap = device.getDescriptorHeap();
        if(!heap.isInitialized())
            return false;

        const u16 generation = device.getDeviceGeneration();
        if(this.m_deviceGeneration != 0u && this.m_deviceGeneration != generation)
            this.invalidateResources();
        this.m_deviceGeneration = generation;

        if(this.m_pipelinesReady)
            return true;

        if(!this.m_activeSceneSubsystems.has_value() || !this.resolveShaderAssetName(0u))
            return false;

        if(!this.m_bindingLayout.valid()){
            BindingLayoutDesc desc;
            desc.setVisibility(ShaderTypeMask::Compute);
            desc.addItem(BindingLayoutItemPushConstants(0u, s_GpuPushConstantsBytes));
            const Expected<BindingLayoutHandle> layoutRes = device.createBindingLayout(desc);
            if(!layoutRes.has_value())
                return false;
            this.m_bindingLayout = layoutRes.value();
        }

        this.m_pipelinesReady = true;
        return true;
    }

    private b8 ensureComputePipeline(
        in u32 shaderIndex,
        in StringView variantName,
        in Name debugName,
        mut ShaderHandle outShader,
        mut ComputePipelineHandle outPipeline
    ){
        if(outPipeline.valid())
            return true;
        if(!this.m_pipelinesReady || !this.m_bindingLayout.valid() || !this.m_graphics.has_value() || !this.m_assetManager.has_value())
            return false;
        mut GraphicsRuntime graphics = this.m_graphics.value();
        mut AssetManager assets = this.m_assetManager.value();
        return LoadPhysicsComputePipeline(
            graphics,
            assets,
            this.m_shaderPathResolver,
            this.m_bindingLayout,
            this.resolveShaderAssetName(shaderIndex),
            variantName,
            debugName,
            outShader,
            outPipeline
        );
    }

