#include "router_pointer_reconcile.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<usize> FindRouterPointerSourceIndex(
    in Span<PointerSource> pointerSources,
    in InputSource source,
    in PointerIntent intent
){
    for(usize index = 0u; index < pointerSources.size(); ++index){
        if(pointerSources[index].source == source && pointerSources[index].intent == intent)
            return index;
    }
    return makeUnexpected(Failure());
}

b8 OwnsRouterPointerSource(
    in Span<PointerSource> pointerSources,
    in InputSource source,
    in PointerIntent intent
){
    const Expected<usize> found = FindRouterPointerSourceIndex(pointerSources, source, intent);
    return found.has_value() && pointerSources[found.value()].consumed;
}

void TerminateRouterPointerSource(
    in InputSource source,
    in InputSource hoverPointerSource,
    mut Vector<PointerSource> pointerSources,
    mut Vector<PointerGestureRecord> pointerGestures,
    mut u64 inOutActiveGestureSequence,
    mut b8 inOutPointerSubmitArmed,
    mut TargetOwner inOutSecondaryOwner,
    mut WidgetId inOutCapture,
    mut PopupToken inOutCapturePopup,
    mut u64 inOutCaptureDeclaration,
    mut ControlToken inOutCaptureControl,
    mut b8 inOutPrimaryDown,
    mut b8 inOutPointerSequenceConsumed,
    mut b8 inOutSecondaryDown,
    mut b8 inOutSecondarySequenceConsumed,
    mut InputSource inOutActivePointerSource,
    mut b8 outUnfinishedHoverSource
){
    outUnfinishedHoverSource = false;
    const b8 active = inOutActivePointerSource == source;
    b8 unfinished = false;
    for(in PointerSource held : pointerSources){
        if(held.source == source){
            unfinished = true;
            break;
        }
    }
    if(active){
        CancelRouterPointerPress(
            pointerGestures,
            inOutActiveGestureSequence,
            inOutPointerSubmitArmed,
            inOutSecondaryOwner,
            inOutCapture,
            inOutCapturePopup,
            inOutCaptureDeclaration,
            inOutCaptureControl
        );
        inOutPrimaryDown = false;
        inOutPointerSequenceConsumed = false;
        inOutSecondaryDown = false;
        inOutSecondarySequenceConsumed = false;
        inOutActivePointerSource = InputSource();
    }
    usize keptSources = 0u;
    for(usize index = 0u; index < pointerSources.size(); ++index){
        if(pointerSources[index].source != source){
            if(keptSources != index)
                pointerSources[keptSources] = pointerSources[index];
            ++keptSources;
        }
    }
    pointerSources.resize(keptSources);
    outUnfinishedHoverSource = unfinished && hoverPointerSource == source;
}

void UpdateRouterHoverTarget(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in b8 hasHovered,
    in HitTarget hovered,
    mut HoverIdentity inOutHoverIdentity,
    mut WidgetId outHover,
    mut b8 outChangedOwner
){
    outChangedOwner = false;
    HoverIdentity identity;
    if(hasHovered){
        if(hovered.owner.valid()){
            const Expected<HitTarget> host = TryResolveRouterControlHost(targets, lookup, popups, hovered);
            if(host.has_value())
                identity = HoverIdentity(host.value().id, host.value().declarationGeneration, host.value().popup, host.value().control);
        }
        else
            identity = HoverIdentity(hovered.id, hovered.declarationGeneration, hovered.popup, hovered.control);
    }
    if(
        inOutHoverIdentity.owner != identity.owner
        || inOutHoverIdentity.declarationGeneration != identity.declarationGeneration
        || inOutHoverIdentity.popup != identity.popup
        || inOutHoverIdentity.control != identity.control
    )
        outChangedOwner = true;
    inOutHoverIdentity = identity;
    if(hasHovered)
        outHover = hovered.id;
    else
        outHover = WidgetId();
}

void RouteRouterSecondary(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in b8 windowFocused,
    in u64 layoutGeneration,
    in InputEvent event,
    in b8 hasHit,
    in HitTarget hit,
    in b8 primaryDown,
    in b8 pointerSequenceConsumed,
    mut Vector<PopupRecord> popups,
    mut Vector<PopupDismissal> popupDismissals,
    mut Vector<ContextMenuAction> contextMenuActions,
    mut u64 inOutNextActionSequence,
    mut b8 inOutSecondaryDown,
    mut b8 inOutSecondarySequenceConsumed,
    mut TargetOwner inOutSecondaryOwner,
    mut Point inOutSecondaryPosition,
    mut InputRoutingResult inOutResult,
    mut b8 outAdvanceHoverActivity,
    mut b8 outDismissedPopup
){
    outAdvanceHoverActivity = false;
    outDismissedPopup = false;
    b8 hasAnchor = hasHit;
    HitTarget anchor = hit;
    if(hasHit && !hit.contextMenu && hit.owner.valid()){
        const Expected<HitTarget> host = TryResolveRouterControlHost(targets, lookup, popups, hit);
        hasAnchor = host.has_value();
        if(hasAnchor)
            anchor = host.value();
    }
    if(event.type == InputEventType::SecondaryUp){
        if(inOutSecondaryDown)
            inOutResult.pointerConsumed = inOutResult.pointerConsumed || inOutSecondarySequenceConsumed;
        else if(primaryDown)
            inOutResult.pointerConsumed = inOutResult.pointerConsumed || pointerSequenceConsumed;
        else
            inOutResult.pointerConsumed = inOutResult.pointerConsumed || !popups.empty() || hasHit;
        if(
            inOutSecondaryDown
            && inOutSecondarySequenceConsumed
            && hasAnchor
            && anchor.id == inOutSecondaryOwner.target
            && IsCurrentRouterContextMenuOwner(targets, lookup, popups, windowFocused, inOutSecondaryOwner)
        )
            AppendRouterContextMenu(anchor, layoutGeneration, inOutSecondaryPosition, InputActionSource::Pointer, event.source, contextMenuActions, inOutNextActionSequence, inOutResult);
        inOutSecondaryDown = false;
        inOutSecondarySequenceConsumed = false;
        inOutSecondaryOwner = TargetOwner();
        return;
    }
    if(inOutSecondaryDown){
        inOutResult.pointerConsumed = inOutResult.pointerConsumed || inOutSecondarySequenceConsumed;
        return;
    }
    outAdvanceHoverActivity = true;
    inOutSecondaryDown = true;
    if(primaryDown)
        inOutSecondarySequenceConsumed = pointerSequenceConsumed;
    else
        inOutSecondarySequenceConsumed = !popups.empty() || hasHit;
    inOutResult.pointerConsumed = inOutResult.pointerConsumed || inOutSecondarySequenceConsumed;
    if(!inOutSecondarySequenceConsumed)
        return;
    if(!popups.empty() && !hasHit){
        outDismissedPopup = TryDismissRouterPopup(PopupDismissReason::OutsideClick, popups, popupDismissals);
        return;
    }
    if(!hasAnchor || !anchor.contextMenu || !windowFocused)
        return;
    inOutSecondaryOwner = TargetOwner(anchor.id, anchor.declarationGeneration, anchor.popup, anchor.control);
    inOutSecondaryPosition = event.position;
}

b8 RouteRouterPrimary(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in InputEvent event,
    in b8 hasHit,
    in HitTarget hit,
    in b8 secondaryDown,
    in b8 secondarySequenceConsumed,
    in u64 layoutGeneration,
    in InputSource activePointerSource,
    in Point interactionPosition,
    mut Vector<PopupRecord> popups,
    mut Vector<PopupDismissal> popupDismissals,
    mut Vector<CommandSource> commandSources,
    mut Vector<InputAction> actions,
    mut Vector<ControlAction> controlActions,
    mut Vector<PointerGestureRecord> pointerGestures,
    mut u64 inOutActiveGestureSequence,
    mut u64 inOutNextActionSequence,
    mut b8 inOutPrimaryDown,
    mut b8 inOutPointerSubmitArmed,
    mut b8 inOutPointerSequenceConsumed,
    mut WidgetId inOutFocus,
    mut u64 inOutFocusDeclaration,
    mut ControlToken inOutFocusControl,
    mut WidgetId inOutCapture,
    mut PopupToken inOutCapturePopup,
    mut u64 inOutCaptureDeclaration,
    mut ControlToken inOutCaptureControl,
    mut InputRoutingResult inOutResult,
    mut b8 outAdvanceHoverActivity,
    mut b8 outDismissedPopup
){
    outAdvanceHoverActivity = false;
    outDismissedPopup = false;
    if(event.type == InputEventType::PointerMove){
        if(inOutPrimaryDown){
            if(!TryUpdateRouterPointerGesture(event.position, false, pointerGestures, inOutActiveGestureSequence, inOutNextActionSequence))
                return false;
        }
        if(inOutPrimaryDown)
            inOutResult.pointerConsumed = inOutResult.pointerConsumed || inOutPointerSequenceConsumed;
        else if(secondaryDown)
            inOutResult.pointerConsumed = inOutResult.pointerConsumed || secondarySequenceConsumed;
        else
            inOutResult.pointerConsumed = inOutResult.pointerConsumed || !popups.empty() || hasHit;
        return true;
    }
    if(event.type == InputEventType::PrimaryDown){
        if(inOutPrimaryDown){
            inOutResult.pointerConsumed = inOutResult.pointerConsumed || inOutPointerSequenceConsumed;
            return true;
        }
        outAdvanceHoverActivity = true;
        inOutPrimaryDown = true;
        inOutPointerSubmitArmed = false;
        if(secondaryDown)
            inOutPointerSequenceConsumed = secondarySequenceConsumed;
        else
            inOutPointerSequenceConsumed = !popups.empty() || hasHit;
        inOutResult.pointerConsumed = inOutResult.pointerConsumed || inOutPointerSequenceConsumed;
        if(!inOutPointerSequenceConsumed){
            RetireRouterCommandFocus(commandSources);
            inOutFocus = WidgetId();
            inOutFocusDeclaration = 0u;
            inOutFocusControl = ControlToken();
            return true;
        }
        if(!popups.empty() && !hasHit){
            outDismissedPopup = TryDismissRouterPopup(PopupDismissReason::OutsideClick, popups, popupDismissals);
            inOutCapture = WidgetId();
            inOutCapturePopup = PopupToken();
            inOutCaptureDeclaration = 0u;
            inOutCaptureControl = ControlToken();
            return true;
        }
        if(hasHit){
            inOutCapture = hit.id;
            inOutCaptureDeclaration = hit.declarationGeneration;
            inOutCapturePopup = hit.popup;
            inOutCaptureControl = hit.control;
            inOutPointerSubmitArmed = hit.activatable;
        }
        else{
            inOutCapture = WidgetId();
            inOutCaptureDeclaration = 0u;
            inOutCapturePopup = PopupToken();
            inOutCaptureControl = ControlToken();
            inOutPointerSubmitArmed = false;
        }
        b8 hasFocused = hasHit;
        HitTarget focused = hit;
        if(hasHit && hit.owner.valid()){
            const Expected<HitTarget> host = TryResolveRouterControlHost(targets, lookup, popups, hit);
            hasFocused = host.has_value();
            if(hasFocused)
                focused = host.value();
        }
        if(hasFocused && focused.focusable)
            AssignRouterFocus(focused, commandSources, inOutFocus, inOutFocusDeclaration, inOutFocusControl);
        else{
            RetireRouterCommandFocus(commandSources);
            inOutFocus = WidgetId();
            inOutFocusDeclaration = 0u;
            inOutFocusControl = ControlToken();
        }
        if(hasHit && hit.pointerGesture){
            AppendRouterPointerGesture(
                hit,
                layoutGeneration,
                activePointerSource,
                interactionPosition,
                pointerGestures,
                inOutActiveGestureSequence,
                inOutNextActionSequence,
                inOutResult
            );
        }
        return true;
    }
    if(inOutPrimaryDown)
        inOutResult.pointerConsumed = inOutResult.pointerConsumed || inOutPointerSequenceConsumed;
    else if(secondaryDown)
        inOutResult.pointerConsumed = inOutResult.pointerConsumed || secondarySequenceConsumed;
    else
        inOutResult.pointerConsumed = inOutResult.pointerConsumed || hasHit;
    if(
        inOutPrimaryDown
        && inOutPointerSequenceConsumed
        && inOutPointerSubmitArmed
        && hasHit
        && hit.id == inOutCapture
        && hit.declarationGeneration == inOutCaptureDeclaration
        && hit.activatable
        && hit.popup == inOutCapturePopup
        && hit.control == inOutCaptureControl
    ){
        b8 hasHost = false;
        HitTarget host;
        if(hit.owner.valid()){
            const Expected<HitTarget> resolvedHost = TryResolveRouterControlHost(targets, lookup, popups, hit);
            hasHost = resolvedHost.has_value();
            if(hasHost)
                host = resolvedHost.value();
        }
        if(hasHost)
            AppendRouterControlAction(host, hit, layoutGeneration, ControlActionKind::Activate, 0.0, 0.0, controlActions, inOutNextActionSequence, inOutResult);
        else
            AppendRouterActivation(hit, layoutGeneration, InputActionSource::Pointer, event.source, actions, inOutNextActionSequence, inOutResult);
    }
    if(inOutPrimaryDown){
        if(!TryUpdateRouterPointerGesture(event.position, true, pointerGestures, inOutActiveGestureSequence, inOutNextActionSequence))
            return false;
    }
    inOutPrimaryDown = false;
    inOutPointerSubmitArmed = false;
    inOutPointerSequenceConsumed = false;
    inOutCapture = WidgetId();
    inOutCapturePopup = PopupToken();
    inOutCaptureDeclaration = 0u;
    inOutCaptureControl = ControlToken();
    return true;
}

void ObserveRouterPointer(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in InputEvent event,
    in b8 hasHit,
    in HitTarget hit,
    mut Point inOutPointer,
    mut b8 inOutPointerKnown,
    mut InputSource inOutHoverPointerSource,
    mut HoverIdentity inOutHoverIdentity,
    mut WidgetId inOutHover,
    mut b8 outChangedOwner
){
    outChangedOwner = false;
    if(!event.hoverCapable)
        return;
    inOutHoverPointerSource = event.source;
    inOutPointer = event.position;
    inOutPointerKnown = true;
    UpdateRouterHoverTarget(targets, lookup, popups, hasHit, hit, inOutHoverIdentity, inOutHover, outChangedOwner);
}


