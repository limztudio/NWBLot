#include <impl/ecs_ui/toolkit/input/input.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class InputTargetTable : NoCopy{
    public InputTargetTable(){
        this.m_targets.reserve(s_InputMaxTargets);
        this.m_stagedTargets.reserve(s_InputMaxTargets);
        this.m_lookup.reserve(s_InputMaxTargets);
        this.m_stagedLookup.reserve(s_InputMaxTargets);
    }

    public b8 canPublish(in usize count, in u64 generation)const{
        return CanPublishRouterTargetTable(count, generation, this.m_generation);
    }

    public b8 publish(in Span<HitTarget> targets, in Span<PopupRecord> stagedPopups, in u64 generation){
        return PublishRouterTargetTable(targets, stagedPopups, generation, this.m_targets, this.m_stagedTargets, this.m_lookup, this.m_stagedLookup, this.m_generation);
    }

    public Expected<usize> findIndex(in WidgetId id, in u64 declarationGeneration)const{
        return FindTargetIndexInTable(this.m_targets, this.m_lookup, id, declarationGeneration);
    }

    public b8 invalidate(in WidgetId id){
        return InvalidateRouterTargetTable(id, this.m_lookup, this.m_targets);
    }

    public b8 fenceControl(in WidgetId host, in u64 declarationGeneration, in ControlToken token){
        return FenceRouterControlTargets(host, declarationGeneration, token, this.m_lookup, this.m_targets);
    }

    public Optional<InputPopupRetirement> retirePopup(in WidgetId id, mut Vector<PopupRecord> popups, mut Vector<PopupDismissal> dismissals){
        return RetireRouterTargetTablePopup(id, popups, this.m_targets, dismissals, this.m_lookup);
    }

    public void reset(){
        ResetRouterTargetTable(this.m_targets, this.m_stagedTargets, this.m_lookup, this.m_stagedLookup, this.m_generation);
    }

    public u64 generation()const{
        return this.m_generation;
    }

    public in Vector<HitTarget> targets()const{
        return this.m_targets;
    }

    public Span<TargetLookup> lookup()const{
        return this.m_lookup;
    }

    private Vector<HitTarget> m_targets;
    private Vector<HitTarget> m_stagedTargets;
    private Vector<TargetLookup> m_lookup;
    private Vector<TargetLookup> m_stagedLookup;
    private u64 m_generation = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

