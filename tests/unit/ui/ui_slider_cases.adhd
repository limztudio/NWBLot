    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(Point(origin.x + 30.0f, origin.y), InputEventType::PointerMove)).pointerConsumed);
    self.press(UiSliderKey::Right);
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(Point(origin.x + 60.0f, origin.y), InputEventType::PointerMove)).pointerConsumed);
    ASSERT_TRUE(self.accept(2u));
    EXPECT_NEAR(self.m_state.value(), 0.25 + 60.0 / travel, 0.00000001);
    EXPECT_TRUE(self.m_state.result().dragging);
}

void VerifyUiSliderInputTests_AKeyAfterTheLatestCoalescedMoveAppliesToTheDraggedValue(mut UiSliderInputTests self){
    ASSERT_TRUE(self.accept(1u));
    const Point origin = self.thumbPoint();
    const f64 travel = cast<f64>(self.m_state.placement().centerTravel.width);
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(origin, InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(Point(origin.x + 60.0f, origin.y), InputEventType::PointerMove)).pointerConsumed);
    self.press(UiSliderKey::Right);
    ASSERT_TRUE(self.accept(2u));
    const f64 dragged = 0.25 + 60.0 / travel;
    EXPECT_NEAR(self.m_state.value(), dragged + 0.125, 0.00000001);
}

void VerifyUiSliderInputTests_DragOutsideTravelSaturatesBothEndsWithoutLosingOwnedCapture(mut UiSliderInputTests self){
    ASSERT_TRUE(self.accept(1u));
    const Point origin = self.thumbPoint();
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(origin, InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(Point(790.0f, origin.y), InputEventType::PointerMove)).pointerConsumed);
    ASSERT_TRUE(self.accept(2u));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 1.0);
    EXPECT_EQ(self.m_context.input().capture(), self.thumb());
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(Point(1.0f, origin.y), InputEventType::PointerMove)).pointerConsumed);
    ASSERT_TRUE(self.accept(3u));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.0);
    EXPECT_EQ(self.m_context.input().capture(), self.thumb());
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(Point(1.0f, origin.y), InputEventType::PrimaryUp)).pointerConsumed);
    ASSERT_TRUE(self.accept(4u));
    EXPECT_FALSE(self.m_state.result().dragging);
}

void VerifyUiSliderInputTests_CaptureLossCancelsPendingMotionAndRetainsTheLastAppliedValue(mut UiSliderInputTests self){
    ASSERT_TRUE(self.accept(1u));
    const Point origin = self.thumbPoint();
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(origin, InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(Point(origin.x + 40.0f, origin.y), InputEventType::PointerMove)).pointerConsumed);
    ASSERT_TRUE(self.accept(2u));
    const u64 retained = bit_cast<u64>(self.m_state.value());
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(Point(origin.x + 80.0f, origin.y), InputEventType::PointerMove)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(Point(), InputEventType::PointerCaptureLost)).pointerConsumed);
    ASSERT_TRUE(self.accept(3u));
    EXPECT_EQ(bit_cast<u64>(self.m_state.value()), retained);
    EXPECT_FALSE(self.m_state.result().valueChanged);
    EXPECT_FALSE(self.m_state.result().dragging);
    EXPECT_FALSE(self.m_context.input().capture().valid());
}

void VerifyUiSliderInputTests_FocusLossRetiresPendingDragAndHeldNavigationWithoutRollingBackAppliedInput(mut UiSliderInputTests self){
    ASSERT_TRUE(self.accept(1u));
    const Point origin = self.thumbPoint();
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(origin, InputEventType::PrimaryDown)).pointerConsumed);
    self.press(UiSliderKey::Right);
    ASSERT_TRUE(self.accept(2u));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.375);
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(Point(origin.x + 80.0f, origin.y), InputEventType::PointerMove)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(Point(), InputEventType::FocusLost)).pointerConsumed);
    EXPECT_FALSE(self.send(MakeUiSliderPointerEvent(Point(), InputEventType::FocusGained)).pointerConsumed);
    ASSERT_TRUE(self.accept(3u));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.375);
    EXPECT_FALSE(self.m_state.result().dragging);
    EXPECT_FALSE(self.m_state.result().focused);
}

void VerifyUiSliderInputTests_EnterAndWheelDoNotChangeTheSliderOrCreateActivationActions(mut UiSliderInputTests self){
    ASSERT_TRUE(self.accept(1u));
