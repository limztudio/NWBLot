// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_RAYTRACE_OPTICAL_BOOTSTRAP_SLANGI
#define NWB_GRAPHICS_RAYTRACE_OPTICAL_BOOTSTRAP_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "surface_hit.slangi"
#include "optical_events.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static const float3 NWB_OPTICAL_BOOTSTRAP_RAY_DIRECTION = float3(0.754877666, 0.569840291, 0.324717957);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The transparent union is conservative, including unspecified transparent materials.
// Outside it, air is proven without a ray.
// Inside it, replay one complete exterior-to-origin crossing list; neither opaque scene occluders nor arbitrary traversal order can establish containment.
// Candidate collection never commits hits.
bool nwbOpticalBootstrap(const NwbOpticalTraceConfig config, const float3 origin, const float3 direction, out NwbOpticalMedia media, inout NwbOpticalTraceResult result){
    media = (NwbOpticalMedia)0;
    const uint headerFlags = nwbHeapRawBuffer(config.opticalSceneHeapSlot).Load(NWB_RT_OPTICAL_SCENE_FLAGS_OFFSET);
    if((headerFlags & NWB_RT_OPTICAL_SCENE_FLAG_BOUNDS_VALID) == 0u){
        result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
        return false;
    }
    const uint transparentCount = nwbHeapRawBuffer(config.opticalSceneHeapSlot).Load(NWB_RT_OPTICAL_SCENE_TRANSPARENT_COUNT_OFFSET);
    if(transparentCount == 0u)
        return true;
    const float3 boundsMin = asfloat(nwbHeapRawBuffer(config.opticalSceneHeapSlot).Load3(NWB_RT_OPTICAL_SCENE_BOUNDS_MIN_OFFSET));
    const float3 boundsMax = asfloat(nwbHeapRawBuffer(config.opticalSceneHeapSlot).Load3(NWB_RT_OPTICAL_SCENE_BOUNDS_MAX_OFFSET));
    if(!all(isfinite(boundsMin)) || !all(isfinite(boundsMax)) || any(boundsMin > boundsMax)){
        result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
        return false;
    }
    if(any(origin < boundsMin) || any(origin > boundsMax))
        return true;
    const float3 bootstrapDirection = normalize(NWB_OPTICAL_BOOTSTRAP_RAY_DIRECTION);
    const float tolerance = NWB_OPTICS_POSITION_TOLERANCE_SCALE * max(nwbOpticsPositionUncertainty(boundsMin), nwbOpticsPositionUncertainty(boundsMax));
    const float bootstrapDistance = length(boundsMax - boundsMin) + tolerance * 2.0;
    RayDesc ray;
    ray.Origin = origin - bootstrapDirection * bootstrapDistance;
    ray.Direction = bootstrapDirection;
    ray.TMin = 0.0;
    ray.TMax = bootstrapDistance;
    if(!isfinite(bootstrapDistance) || bootstrapDistance <= 0.0 || !all(isfinite(ray.Origin)) || !(any(ray.Origin < boundsMin) || any(ray.Origin > boundsMax))){
        result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
        return false;
    }
    if(!nwbOpticalConsumeQuery(config, result))
        return false;
    RayQuery<RAY_FLAG_FORCE_NON_OPAQUE> query;
#if NWB_RT_CSG_ENABLED
    query.TraceRayInline(nwbHeapAccelStruct(), RAY_FLAG_FORCE_NON_OPAQUE, NWB_RT_SHADOW_TRANSPARENT_INSTANCE_MASK, ray);
#else
    query.TraceRayInline(nwbHeapAccelStruct(), RAY_FLAG_FORCE_NON_OPAQUE, NWB_RT_OPTICAL_TRANSPARENT_INSTANCE_MASK, ray);
#endif
#if NWB_RT_CSG_ENABLED
    ++result.physicalQueries;
#endif
#if NWB_OPTICAL_CLOSED_MEDIA
    NwbOpticalBootstrapEvent events[NWB_OPTICAL_MAX_CANDIDATE_EVENTS];
    uint eventCount = 0u;
#endif
    bool complete = false;
    [loop] for(uint candidate = 0u; candidate < NWB_OPTICAL_MAX_CANDIDATE_EVENTS; ++candidate){
        if(!query.Proceed()){
            complete = true;
            break;
        }
        ++result.bootstrapEventCount;
        if(query.CandidateType() != CANDIDATE_NON_OPAQUE_TRIANGLE){
            query.Abort();
            result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
            return false;
        }
        const uint instance = query.CandidateInstanceID();
        NwbOpticalInstance optical;
        if(!nwbOpticalReadInstance(config, instance, optical, result)){
            query.Abort();
            return false;
        }
        if(optical.mode == NWB_RT_OPTICAL_BOUNDARY_UNSPECIFIED){
            const NwbRayTraceSurfaceHit hit = nwbRayTraceReconstructSurfaceHit(
                config.instanceMaterialHeapSlot, ray.Origin, ray.Direction, query.CandidateTriangleRayT(), instance,
                query.CandidatePrimitiveIndex(), query.CandidateTriangleBarycentrics(), query.CandidateWorldToObject3x4()
            );
            // A flat alpha surface cannot contain a medium. An unspecified refractor may be open or displaced; without an authored volume contract it cannot prove that the initial origin is in air.
            if(!isfinite(float(hit.surface.refractionIor)) || hit.surface.refractionIor != half(1.0)){
                query.Abort();
                result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
                return false;
            }
            continue;
        }
#if NWB_OPTICAL_CLOSED_MEDIA
        if(optical.mode != NWB_RT_OPTICAL_BOUNDARY_CLOSED_NESTED && optical.mode != NWB_RT_OPTICAL_BOUNDARY_CLOSED_PRIORITY){
            query.Abort();
            result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
            return false;
        }
        const NwbRtInstanceMaterial material = nwbHeapRtInstanceMaterials(config.instanceMaterialHeapSlot)[instance];
        const float3 normal = nwbRayTraceTriangleGeometricNormal(material, query.CandidatePrimitiveIndex(), query.CandidateWorldToObject3x4());
        const float facing = dot(bootstrapDirection, normal);
        const float distance = query.CandidateTriangleRayT();
        if(!isfinite(facing) || abs(facing) <= NWB_OPTICAL_FACING_EPSILON || bootstrapDistance - distance <= tolerance){
            query.Abort();
            result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
            return false;
        }
        NwbOpticalBootstrapEvent event;
        event.distance = distance;
        event.instance = instance;
        event.primitive = query.CandidatePrimitiveIndex();
        event.entering = facing < 0.0 ? 1u : 0u;
        events[eventCount] = event;
        ++eventCount;
#else
        // Only an all-Unspecified frozen scene selects this specialization. Unknown policies still reject.
        query.Abort();
        result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
        return false;
#endif
    }
    if(!complete){
        // Once all candidate slots are consumed, stopping is conservative even if this was the final candidate. A Proceed call could expose an unbudgeted event, so containment is dropped.
        query.Abort();
        result.termination = NWB_OPTICAL_TERMINATION_EVENT_LIMIT;
        return false;
    }

#if NWB_RT_CSG_ENABLED
    // Raw receiver triangles do not describe retained containment. Replay each retained boundary, including analytic walls, with the same bounded event and query budgets.
    const uint contextSlot = NWB_RT_CSG_CONTEXT_SLOT;
    const uint activeOffset = nwbHeapRawBuffer(contextSlot).Load(NWB_CSG_RAY_CONTEXT_ACTIVE_BASE_OFFSET);
    const uint activeCount = nwbHeapRawBuffer(contextSlot).Load(NWB_CSG_RAY_CONTEXT_ACTIVE_COUNT_OFFSET);
    for(uint activeIndex = 0u; activeIndex < activeCount; ++activeIndex){
        const uint instance = nwbHeapRawBuffer(contextSlot).Load(activeOffset + activeIndex * NWB_CSG_RAY_ACTIVE_INDEX_BYTES);
        NwbOpticalInstance optical;
        if(!nwbOpticalReadInstance(config, instance, optical, result))
            return false;
        if((optical.flags & NWB_RT_OPTICAL_INSTANCE_FLAG_TRANSPARENT) == 0u)
            continue;
        const NwbSwBvhInstance receiver = nwbCsgRayLoadInstance(contextSlot, instance);
        const NwbBvhNode root = nwbCsgRayReceiverRoot(contextSlot, instance, receiver);
        if(!nwbCsgRayBoundsIntersect(receiver, root, ray.Origin, ray.Direction, 0.0, bootstrapDistance))
            continue;
        float minimum = 0.0;
        bool receiverComplete = false;
        for(uint crossing = 0u; crossing < NWB_OPTICAL_MAX_CANDIDATE_EVENTS; ++crossing){
            if(!nwbOpticalConsumeQuery(config, result))
                return false;
            const NwbRayTraceGeometryHit geometry = nwbRayTraceCsgGeometryHit(
                contextSlot, config.instanceMaterialHeapSlot, instance, ray.Origin, ray.Direction, minimum, bootstrapDistance
#if NWB_CSG_RAY_OPTICAL_REUSE
                , false
#endif
            );
            result.physicalQueries += geometry.physicalQueries;
            if(geometry.failure != 0u){
                result.transparentPath = true;
                result.termination = (geometry.failure & NWB_CSG_RAY_FAILURE_AMBIGUOUS_NORMAL) != 0u ? NWB_OPTICAL_TERMINATION_AMBIGUOUS : NWB_OPTICAL_TERMINATION_UNSUPPORTED;
                return false;
            }
            if(!geometry.hit){
                receiverComplete = true;
                break;
            }
            if(++result.bootstrapEventCount >= NWB_OPTICAL_MAX_CANDIDATE_EVENTS){
                result.termination = NWB_OPTICAL_TERMINATION_EVENT_LIMIT;
                return false;
            }
            if(bootstrapDistance - geometry.distance <= tolerance){
                result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
                return false;
            }
            minimum = geometry.distance;
            if(optical.mode == NWB_RT_OPTICAL_BOUNDARY_UNSPECIFIED){
                const NwbRayTraceSurfaceHit hit = nwbRayTraceReconstructSurfaceHit(config.instanceMaterialHeapSlot, ray.Origin, ray.Direction, geometry);
                if(!isfinite(float(hit.surface.refractionIor)) || hit.surface.refractionIor != half(1.0)){
                    result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
                    return false;
                }
                continue;
            }
#if NWB_OPTICAL_CLOSED_MEDIA
            if(optical.mode != NWB_RT_OPTICAL_BOUNDARY_CLOSED_NESTED && optical.mode != NWB_RT_OPTICAL_BOUNDARY_CLOSED_PRIORITY){
                result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
                return false;
            }
            NwbOpticalBootstrapEvent event;
            event.distance = geometry.distance;
            event.instance = instance;
            event.primitive = geometry.primitive;
            event.entering = geometry.frontFace ? 1u : 0u;
            events[eventCount] = event;
            ++eventCount;
#else
            result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
            return false;
#endif
        }
        if(!receiverComplete){
            result.termination = NWB_OPTICAL_TERMINATION_EVENT_LIMIT;
            return false;
        }
    }
#endif

#if NWB_OPTICAL_CLOSED_MEDIA
    return nwbOpticalReplayBootstrap(config, origin, direction, tolerance, events, eventCount, media, result);
#else
    result.transparentPath = media.count != 0u;
    return true;
#endif
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

