void ExecuteWorkerSelfWaitDeath(in TestSchedulerConfig config){
    DeadlineGuard deadline(true, s_TestTimeoutMS);
    TaskGate start = TaskGate();
    CpuTaskScheduler scheduler(config);
    CpuTaskHandle self = CpuTaskHandle();
    native(mut scheduler, mut start, mut self){
        const auto selfTaskAdmission = scheduler.submit([&]() { start.block(); scheduler.wait(self); });
        if(!selfTaskAdmission)
            ExitTestProcess(0u);
        self = *selfTaskAdmission;
    }
    start.open();
    scheduler.wait();
}

void VerifyCpuTaskSchedulerTests_WorkerSelfWaitIsRejectedInsteadOfDeadlocking(){
    const TestSchedulerConfig config = HomogeneousWorkers(1u);
    EXPECT_DEATH(ExecuteWorkerSelfWaitDeath(config), "");
}

void ExecuteDescendantAncestorWaitDeath(in TestSchedulerConfig config){
    DeadlineGuard deadline(true, s_TestTimeoutMS);
    TaskGate start = TaskGate();
    CpuTaskScheduler scheduler(config);
    CpuTaskHandle parent = CpuTaskHandle();
    native(mut scheduler, mut start, mut parent){
        const auto cpuTaskAdmission = scheduler.submit([&]() {
            start.block();
            const auto childTaskAdmission = scheduler.submit([&]() { scheduler.wait(parent); });
            if(!childTaskAdmission)
                ExitTestProcess(0u);
            const auto child = *childTaskAdmission;
            EXPECT_TRUE(child.valid());
        });
        if(!cpuTaskAdmission)
            ExitTestProcess(0u);
        parent = *cpuTaskAdmission;
    }
    start.open();
    scheduler.wait();
}

void VerifyCpuTaskSchedulerTests_DescendantWaitForAnAncestorIsRejectedInsteadOfDeadlocking(){
    const TestSchedulerConfig config = HomogeneousWorkers(1u);
    EXPECT_DEATH(ExecuteDescendantAncestorWaitDeath(config), "");
}

