}

void VerifyCausticEmissionTargetBuilderTests_SupportedVolumesDoNotRetireFirstUnsupportedIdentity(){
    const CausticEmissionTargetBuilder builder = CausticEmissionTargetBuilder();
    u32 first = 0u;
    u32 count = 0u;
    u64 hash = 14695981039346656037uLL;
    const u64 initialHash = hash;
    builder.recordUnsupportedVolume(9u, OpticalBoundaryMode::ClosedNested, first, count, hash);
    EXPECT_EQ(count, 0u);
    EXPECT_EQ(hash, initialHash);
    builder.recordUnsupportedVolume(11u, OpticalBoundaryMode::Unspecified, first, count, hash);
    const u64 firstHash = hash;
    EXPECT_EQ(first, 11u);
    EXPECT_EQ(count, 1u);
    EXPECT_NE(hash, initialHash);
    builder.recordUnsupportedVolume(12u, OpticalBoundaryMode::ClosedPriority, first, count, hash);
    EXPECT_EQ(count, 1u);
    EXPECT_EQ(hash, firstHash);
    builder.recordUnsupportedVolume(13u, OpticalBoundaryMode::Unspecified, first, count, hash);
    EXPECT_EQ(first, 11u);
    EXPECT_EQ(count, 2u);
    EXPECT_NE(hash, firstHash);
}

void VerifyCausticLightSelectorTests_MissingInputsPreserveSlotsAndPointLightsCannotWin(){
    Array<SceneLightGpuData, 3> lights = Array<SceneLightGpuData, 3>();
    lights[0u].params.y = 0.0f;
    lights[1u].params.y = 1.0f;
    lights[2u].params.y = 2.0f;
    for(mut SceneLightGpuData light : lights)
        light.params.w = -1.0f;
    Array<f32, 3> importance = Array<f32, 3>();
    importance[0u] = 10.0f;
    importance[1u] = 100.0f;
    importance[2u] = 5.0f;
    MutableSceneLightGpuDataSpan lightSpan = MutableSceneLightGpuDataSpan(lights.data(), lights.size());
    const Span<f32> allImportance = importance;
    const Span<f32> shortImportance = allImportance.subspan(0u, 2u);
    const CausticLightSelector selector = CausticLightSelector();

    EXPECT_EQ(selector.assignSlots(allImportance, 0u, lightSpan), 0u);
    EXPECT_EQ(selector.assignSlots(shortImportance, 1u, lightSpan), 0u);
    for(in SceneLightGpuData light : lights)
        EXPECT_EQ(light.params.w, -1.0f);
    EXPECT_EQ(selector.assignSlots(allImportance, 1u, lightSpan), 2u);
    EXPECT_EQ(lights[0u].params.w, 0.0f);
    EXPECT_EQ(lights[1u].params.w, -1.0f);
    EXPECT_EQ(lights[2u].params.w, 1.0f);
}

void VerifyCausticQualitySettings_RejectsUnsupportedPhotonGridDivisors(){
    CausticQualitySettings settings = CausticQualitySettings();
    Array<u32, 6> divisors = Array<u32, 6>();
    divisors[0u] = 0u;
    divisors[1u] = 3u;
    divisors[2u] = 5u;
    divisors[3u] = 8u;
    divisors[4u] = 65536u;
    divisors[5u] = u32.max;
    for(in u32 divisor : divisors){
        settings.photonGridDivisor = divisor;
        EXPECT_FALSE(ValidateCausticQualitySettings(settings));
    }
}

void VerifyCausticResolveActivityTests_PartialTilesReserveOneWordForEveryDispatchGroup(){
    const Expected<CausticResolveActivityLayout> layout = TryResolveCausticActivityLayout(65u, 17u);
    ASSERT_TRUE(layout.has_value());
    EXPECT_EQ(layout.value().tilesX, 9u);
    EXPECT_EQ(layout.value().tilesY, 3u);
    EXPECT_EQ(layout.value().bufferByteSize, 27u * 4u);
}

void VerifyCausticResolveActivityTests_InvalidExtentsNeverPublishLayout(){
    EXPECT_FALSE(TryResolveCausticActivityLayout(0u, 1u).has_value());
    EXPECT_FALSE(TryResolveCausticActivityLayout(1u, 0u).has_value());
    EXPECT_FALSE(TryResolveCausticActivityLayout(u32.max, 1u).has_value());
    EXPECT_FALSE(TryResolveCausticActivityLayout(u32.max, u32.max).has_value());
}

void VerifyCausticResolveActivityTests_LastRawWordMayEndAtTheUintAddressBoundary(){
    const Expected<CausticResolveActivityLayout> layout = TryResolveCausticActivityLayout(262144u, 262144u);
    ASSERT_TRUE(layout.has_value());
    EXPECT_EQ(layout.value().bufferByteSize, cast<u64>(u32.max) + 1u);
    EXPECT_EQ(layout.value().tilesX, 32768u);
    EXPECT_EQ(layout.value().tilesY, 32768u);
    EXPECT_FALSE(TryResolveCausticActivityLayout(262145u, 262144u).has_value());
}

void VerifyCoincidentOpticalVolumes_AutomaticSelectionComparesBytesFromSeparateAllocations(){
    CoincidentSelectionContext context = CoincidentSelectionContext();
    Array<u8, 4> firstBytes = Array<u8, 4>();
    firstBytes[0u] = 0u;
    firstBytes[1u] = 17u;
    firstBytes[2u] = 255u;
    firstBytes[3u] = 64u;
    Array<u8, 4> secondBytes = Array<u8, 4>();
    secondBytes[0u] = 0u;
    secondBytes[1u] = 17u;
    secondBytes[2u] = 255u;
    secondBytes[3u] = 64u;
    Array<CoincidentOpticalVolumeCandidate, 3> candidates = Array<CoincidentOpticalVolumeCandidate, 3>();
    candidates[0u] = MakeOpticalCandidate(20u);
    candidates[1u] = MakeOpticalCandidate(10u);
    candidates[2u] = MakeOpticalCandidate(30u);
    candidates[0u].mutableTypedBytes = AsSuiteByteSpan(firstBytes);
    candidates[1u].mutableTypedBytes = AsSuiteByteSpan(secondBytes);
    candidates[2u].mutableTypedBytes = AsSuiteByteSpan(firstBytes);

    SuiteSelectOpticalVolumes(context, candidates);

    EXPECT_TRUE(context.selection.isSuppressed(candidates[0u].entity));
    EXPECT_FALSE(context.selection.isSuppressed(candidates[1u].entity));
    EXPECT_TRUE(context.selection.isSuppressed(candidates[2u].entity));
    EXPECT_FALSE(context.selection.isSuppressed(EntityID(99u, 0u)));
}

void VerifyCoincidentOpticalVolumes_AutomaticSelectionKeepsDifferentByteValuesAndLengths(){
    CoincidentSelectionContext context = CoincidentSelectionContext();
    Array<u8, 4> firstBytes = Array<u8, 4>();
    firstBytes[0u] = 1u;
    firstBytes[1u] = 2u;
    firstBytes[2u] = 3u;
    firstBytes[3u] = 4u;
    Array<u8, 4> changedBytes = Array<u8, 4>();
    changedBytes[0u] = 1u;
    changedBytes[1u] = 2u;
    changedBytes[2u] = 3u;
    changedBytes[3u] = 5u;
    const Span<u8> firstByteSpan = firstBytes;
    Array<CoincidentOpticalVolumeCandidate, 4> candidates = Array<CoincidentOpticalVolumeCandidate, 4>();
    candidates[0u] = MakeOpticalCandidate(10u);
    candidates[1u] = MakeOpticalCandidate(20u);
    candidates[2u] = MakeOpticalCandidate(30u);
    candidates[3u] = MakeOpticalCandidate(40u);
    candidates[0u].mutableTypedBytes = AsSuiteByteSpan(firstBytes);
    candidates[1u].mutableTypedBytes = AsSuiteByteSpan(changedBytes);
    candidates[2u].mutableTypedBytes = firstByteSpan.subspan(0u, firstBytes.size() - 1u);
    candidates[1u].priority = 100;

    SuiteSelectOpticalVolumes(context, candidates);

    for(in CoincidentOpticalVolumeCandidate candidate : candidates)
        EXPECT_FALSE(context.selection.isSuppressed(candidate.entity));
}

void VerifyCoincidentOpticalVolumes_IdenticalMaterialGroupingKeepsDistinctMediumSemantics(){
    CoincidentSelectionContext context = CoincidentSelectionContext();
    Array<CoincidentOpticalVolumeCandidate, 4> candidates = Array<CoincidentOpticalVolumeCandidate, 4>();
    candidates[0u] = MakeOpticalCandidate(10u);
    candidates[1u] = MakeOpticalCandidate(20u);
    candidates[2u] = MakeOpticalCandidate(30u);
    candidates[3u] = MakeOpticalCandidate(40u);
    candidates[1u].boundaryMode = 1u;
    candidates[2u].boundaryMode = 2u;
    candidates[3u].boundaryMode = 2u;
    candidates[3u].mediumPriority = 50;
    SuiteSelectOpticalVolumes(context, candidates);
    for(in CoincidentOpticalVolumeCandidate candidate : candidates)
        EXPECT_FALSE(context.selection.isSuppressed(candidate.entity));

    candidates[3u].mediumPriority = 0;
    SuiteSelectOpticalVolumes(context, candidates);
    EXPECT_FALSE(context.selection.isSuppressed(candidates[2u].entity));
    EXPECT_TRUE(context.selection.isSuppressed(candidates[3u].entity));
}

void VerifyCoincidentOpticalVolumes_PriorityTiesUseFullEntityIdRegardlessOfInputPermutation(){
    CoincidentSelectionContext context = CoincidentSelectionContext();
    Array<CoincidentOpticalVolumeCandidate, 3> source = Array<CoincidentOpticalVolumeCandidate, 3>();
    source[0u] = MakeOpticalCandidate(200u);
    source[1u] = MakeOpticalCandidate(1u);
    source[2u] = MakeOpticalCandidate(300u);
    source[1u].entity = EntityID(1u, 1u);
    for(mut CoincidentOpticalVolumeCandidate candidate : source){
        candidate.group = s_EcsCaseTestsCoincidentOpticalVolumesTie;
        candidate.priority = 3;
    }
    Array<u32, 18> permutationIndices = Array<u32, 18>();
    permutationIndices[0u] = 0u;
    permutationIndices[1u] = 1u;
    permutationIndices[2u] = 2u;
    permutationIndices[3u] = 0u;
    permutationIndices[4u] = 2u;
    permutationIndices[5u] = 1u;
    permutationIndices[6u] = 1u;
    permutationIndices[7u] = 0u;
    permutationIndices[8u] = 2u;
    permutationIndices[9u] = 1u;
    permutationIndices[10u] = 2u;
    permutationIndices[11u] = 0u;
    permutationIndices[12u] = 2u;
    permutationIndices[13u] = 0u;
    permutationIndices[14u] = 1u;
    permutationIndices[15u] = 2u;
    permutationIndices[16u] = 1u;
    permutationIndices[17u] = 0u;

    for(usize perm = 0u; perm < 6u; ++perm){
        const usize base = perm * 3u;
        Array<CoincidentOpticalVolumeCandidate, 3> candidates = Array<CoincidentOpticalVolumeCandidate, 3>();
        candidates[0u] = source[permutationIndices[base]];
        candidates[1u] = source[permutationIndices[base + 1u]];
        candidates[2u] = source[permutationIndices[base + 2u]];
        SuiteSelectOpticalVolumes(context, candidates);
        EXPECT_FALSE(context.selection.isSuppressed(source[0u].entity));
        EXPECT_TRUE(context.selection.isSuppressed(source[1u].entity));
        EXPECT_TRUE(context.selection.isSuppressed(source[2u].entity));
    }
}

void VerifyCoincidentOpticalVolumes_GroupsMeshAndMaterialRemainIndependentBoundaries(){
    CoincidentSelectionContext context = CoincidentSelectionContext();
    Array<CoincidentOpticalVolumeCandidate, 9> candidates = Array<CoincidentOpticalVolumeCandidate, 9>();
    for(u32 index = 0u; index < 9u; ++index)
        candidates[index] = MakeOpticalCandidate((index + 1u) * 10u);
    const Name firstGroup = s_EcsGraphicsNameTestsCoincidentOpticalVolumesFirst;
    const Name secondGroup = s_EcsGraphicsNameTestsCoincidentOpticalVolumesSecond;
    candidates[2u].group = firstGroup;
    candidates[3u].group = firstGroup;
    candidates[4u].group = secondGroup;
    candidates[5u].group = secondGroup;
    candidates[6u].group = firstGroup;
    candidates[6u].mesh = SuiteMeshAssetRef("tests/coincident_optical_volumes/other_mesh");
    candidates[7u].group = firstGroup;
    candidates[7u].material = SuiteMaterialAssetRef("tests/coincident_optical_volumes/other_glass");
    candidates[8u].group = s_EcsCaseTestsCoincidentOpticalVolumesThird;

    SuiteSelectOpticalVolumes(context, candidates);

    for(usize index = 0u; index < candidates.size(); ++index){
        const b8 expectedSuppressed = index == 1u || index == 3u || index == 5u;
        ScopedTestTrace trace = ScopedTestTrace(StringFormat("index={}", index));
        EXPECT_EQ(context.selection.isSuppressed(candidates[index].entity), expectedSuppressed);
    }
}

