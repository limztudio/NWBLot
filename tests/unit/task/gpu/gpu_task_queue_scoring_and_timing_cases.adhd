const usize s_GpuScoringTaskCount = 8u;
const usize s_GpuScoringFragmentBufferCount = 64u;
const usize s_GpuScoringFragmentCutCount = 128u;
const usize s_GpuScoringInitialState = usize.max;
const Name s_GpuScoringCrossClassTimingComputeToGraphics = "tests/task_graph/cross_class_timing_compute_to_graphics";
const Name s_GpuScoringCrossClassTimingGraphicsToCompute = "tests/task_graph/cross_class_timing_graphics_to_compute";

void GpuScoringTakeSnapshot(in GpuTaskTimingHistoryStore store, mut GpuTaskTimingHistorySnapshot snapshot){
    native(in store, mut snapshot){
        store.snapshot(snapshot);
    }
}

void GpuScoringRebuildLoads(
    mut GpuScoringData scoringData,
    in GpuScoringAssignmentVector assignments,
    in GpuPhysicalQueueTopology topology
){
    native(mut scoringData, in assignments, in topology){
        scoringData.rebuildAssignmentLoads(assignments, topology);
    }
}

GpuScoringContext GpuScoringMakeContext(
    in GpuTaskGraphDeclarationReadView declarations,
    in GpuTaskGraphAnalysis analysis,
    in GpuTaskGraphQueueAssignmentOptions options,
    mut ScratchArena scratchArena
){
    return GpuScoringContext(declarations, analysis, options, scratchArena);
}

i32 GpuScoringSaturateReferenceTerm(in u64 value){
    if(value > cast<u64>(i32.max))
        return i32.max;
    return cast<i32>(value);
}

b8 GpuScoringRowIgnored(in usize row, in usize offset, in usize count){
    return row >= offset && row - offset < count;
}

void GpuScoringExpectScores(
    in GpuTaskGraphDeclarationReadView declarations,
    in GpuTaskGraphAnalysis analysis,
    in GpuScoringAssignmentVector assignments,
    in GpuScoringU32Vector assignmentIndices,
    in GpuPhysicalQueueTopology topology,
    in Span<GpuPhysicalQueueInfo> queues,
    in GpuScoringSchedulingReachability reachability,
    in GpuScoringData scoringData,
    in Span<u64> costs,
    in Array<Array<b8, 8>, 8> reachable,
    in Array<Array<usize, 2>, 5> ignoredRanges
){
    u64 totalCost = 0u;
    for(usize row = 0u; row < assignments.size(); ++row)
        totalCost += costs[assignments[row].task.index];
    EXPECT_EQ(scoringData.totalAssignedCost, totalCost);

    for(usize candidateIndex = 0u; candidateIndex < queues.size(); ++candidateIndex){
        const GpuPhysicalQueueInfo candidate = queues[candidateIndex];
        u64 assignedCost = 0u;
        for(usize row = 0u; row < assignments.size(); ++row){
            const GpuTaskQueueAssignment assignment = assignments[row];
            if(assignment.queue == candidate.id)
                assignedCost += costs[assignment.task.index];
        }
        EXPECT_EQ(scoringData.assignedQueueLoad(candidate.id), assignedCost);

        for(usize rangeIndex = 0u; rangeIndex < ignoredRanges.size(); ++rangeIndex){
            const usize rangeOffset = ignoredRanges[rangeIndex][0u];
            const usize rangeCount = ignoredRanges[rangeIndex][1u];
            GpuScoringExclusions exclusions = GpuScoringExclusions();
            exclusions.assignmentOffset = rangeOffset;
            exclusions.assignmentCount = rangeCount;
            for(usize row = 0u; row < assignments.size(); ++row){
                if(!GpuScoringRowIgnored(row, rangeOffset, rangeCount))
                    continue;
                const GpuTaskQueueAssignment assignment = assignments[row];
                exclusions.totalCost += costs[assignment.task.index];
                if(assignment.queue == candidate.id)
                    exclusions.candidateQueueCost += costs[assignment.task.index];
            }

            for(usize taskIndex = 0u; taskIndex < s_GpuScoringTaskCount; ++taskIndex){
                const GpuTaskGraphTaskView task = declarations.taskAt(taskIndex);
                u64 queueLoad = 0u;
                u64 overlap = 0u;
                for(usize row = 0u; row < assignments.size(); ++row){
                    const GpuTaskQueueAssignment assignment = assignments[row];
                    if(GpuScoringRowIgnored(row, rangeOffset, rangeCount) || assignment.task == task.id)
                        continue;
                    if(assignment.queue == candidate.id)
                        queueLoad += costs[assignment.task.index];
                    else if(
                        rangeCount <= 1u
                        && task.scheduling.overlapPreferred
                        && !task.scheduling.avoidQueueCrossing
                        && !reachable[taskIndex][assignment.task.index]
                        && !reachable[assignment.task.index][taskIndex]
                    )
                        overlap += costs[assignment.task.index];
                }

                u64 external = 0u;
                if(candidate.id == queues[1u].id)
                    external = 13u;
                else if(candidate.id == queues[2u].id)
                    external = u64.max;

                if(queueLoad > u64.max - external)
                    queueLoad = u64.max;
                else
                    queueLoad = queueLoad + external;

                i32 incomingCrossings = 0;
                i32 outgoingCrossings = 0;
                const Span<GpuTaskDependencyEdge> schedulingEdges = analysis.schedulingEdges();
                for(usize edgeIndex = 0u; edgeIndex < schedulingEdges.size(); ++edgeIndex){
                    const GpuTaskDependencyEdge edge = schedulingEdges[edgeIndex];
                    const usize producerRow = cast<usize>(assignmentIndices[edge.producer.index]);
                    const usize consumerRow = cast<usize>(assignmentIndices[edge.consumer.index]);
                    if(edge.consumer == task.id && !GpuScoringRowIgnored(producerRow, rangeOffset, rangeCount) && assignments[producerRow].queue != candidate.id)
                        ++incomingCrossings;
                    if(edge.producer == task.id && !GpuScoringRowIgnored(consumerRow, rangeOffset, rangeCount) && assignments[consumerRow].queue != candidate.id)
                        ++outgoingCrossings;
                }

                const GpuQueueAssignmentScore score = BuildGpuScoringScore(
                    declarations,
                    analysis,
                    assignments,
                    assignmentIndices,
                    topology,
                    reachability,
                    scoringData,
                    task,
                    candidate,
                    exclusions
                );
                EXPECT_EQ(score.queueLoad, GpuScoringSaturateReferenceTerm(queueLoad));
                EXPECT_EQ(score.overlap, GpuScoringSaturateReferenceTerm(overlap));
                EXPECT_EQ(score.incomingCrossings, incomingCrossings);
                EXPECT_EQ(score.outgoingCrossings, outgoingCrossings);
                EXPECT_EQ(score.ownershipTransfers, 0);
            }
        }
    }
}

void VerifyGpuScoring_CachedLoadsAndScoresMatchIndependentReferenceAfterMovesAndRebuilds(){
    Array<b8, 2> dependencyCases = Array<b8, 2>();
    dependencyCases[0u] = false;
    dependencyCases[1u] = true;

    Array<GpuScoringCostHintEnum, 8> hints = Array<GpuScoringCostHintEnum, 8>();
    hints[0u] = GpuTaskCostHint::Tiny;
    hints[1u] = GpuTaskCostHint::Small;
    hints[2u] = GpuTaskCostHint::Medium;
    hints[3u] = GpuTaskCostHint::Large;
    hints[4u] = GpuTaskCostHint::Tiny;
    hints[5u] = GpuTaskCostHint::Large;
    hints[6u] = GpuTaskCostHint::Small;
    hints[7u] = GpuTaskCostHint::Medium;

    Array<u64, 8> costs = Array<u64, 8>();
    costs[0u] = 1u;
    costs[1u] = 2u;
    costs[2u] = 4u;
    costs[3u] = 8u;
    costs[4u] = 1u;
    costs[5u] = 8u;
    costs[6u] = 2u;
    costs[7u] = 4u;

    Array<Array<u8, 3>, 8> parents = Array<Array<u8, 3>, 8>();
    parents[1u][0u] = 0u;
    parents[3u][0u] = 0u;
    parents[3u][1u] = 2u;
    parents[4u][0u] = 1u;
    parents[6u][0u] = 3u;
    parents[7u][0u] = 4u;
    parents[7u][1u] = 6u;
    parents[7u][2u] = 0u;

    Array<usize, 8> parentCounts = Array<usize, 8>();
    parentCounts[0u] = 0u;
    parentCounts[1u] = 1u;
    parentCounts[2u] = 0u;
    parentCounts[3u] = 2u;
    parentCounts[4u] = 1u;
    parentCounts[5u] = 0u;
    parentCounts[6u] = 1u;
    parentCounts[7u] = 3u;

    Array<usize, 8> assignmentOrder = Array<usize, 8>();
    assignmentOrder[0u] = 5u;
    assignmentOrder[1u] = 0u;
    assignmentOrder[2u] = 7u;
    assignmentOrder[3u] = 2u;
    assignmentOrder[4u] = 6u;
    assignmentOrder[5u] = 1u;
    assignmentOrder[6u] = 4u;
    assignmentOrder[7u] = 3u;

    Array<Array<usize, 2>, 5> ignoredRanges = Array<Array<usize, 2>, 5>();
    ignoredRanges[0u][0u] = 0u;
    ignoredRanges[0u][1u] = 0u;
    ignoredRanges[1u][0u] = 0u;
    ignoredRanges[1u][1u] = 1u;
    ignoredRanges[2u][0u] = 3u;
    ignoredRanges[2u][1u] = 1u;
    ignoredRanges[3u][0u] = 1u;
    ignoredRanges[3u][1u] = 3u;
    ignoredRanges[4u][0u] = 0u;
    ignoredRanges[4u][1u] = s_GpuScoringTaskCount;

    for(in b8 hasDependencies : dependencyCases){
        const ScopedTestTrace trace = ScopedTestTrace(hasDependencies);
        GpuScoringTestArena testArena = GpuScoringTestArena();
        ScratchArena scratchArena = ScratchArena(s_GpuCaseTaskGpuQueueScoring);
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        Array<GpuTaskId, 8> tasks = Array<GpuTaskId, 8>();
        for(usize taskIndex = 0u; taskIndex < s_GpuScoringTaskCount; ++taskIndex){
            Array<GpuTaskId, 3> dependencies = Array<GpuTaskId, 3>();
            usize dependencyCount = 0u;
            if(hasDependencies)
                dependencyCount = parentCounts[taskIndex];
            for(usize dependencyIndex = 0u; dependencyIndex < dependencyCount; ++dependencyIndex)
                dependencies[dependencyIndex] = tasks[cast<usize>(parents[taskIndex][dependencyIndex])];

            const Expected<Name> derivedNameResult = IndexedName(s_GpuCaseQueueScoringTask, taskIndex);
            ASSERT_TRUE(derivedNameResult.has_value());

            GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
            scheduling.cost = hints[taskIndex];
            scheduling.overlapPreferred = taskIndex != 1u;
            scheduling.avoidQueueCrossing = taskIndex == 6u;

            GpuTaskDesc desc = GpuTaskDesc();
            desc.setIdentity(derivedNameResult.value());
            desc.setMarkerLabel("Queue Scoring Task");
            desc.setDependencies(MakeGpuScoringTaskPrefixSpan(dependencies, dependencyCount));
            desc.setScheduling(scheduling);

            GpuTaskCommandRequirements transferCommands = GpuTaskCommandRequirements();
            transferCommands.requiredCapabilities = GpuQueueCapability::Transfer;
            const Expected<GpuTaskId> taskAdmission = graph.addTask(desc, transferCommands);
            ASSERT_TRUE(taskAdmission.has_value());
            tasks[taskIndex] = taskAdmission.value();
            ASSERT_TRUE(tasks[taskIndex].valid());
        }

        Array<GpuPhysicalQueueInfo, 3> queues = Array<GpuPhysicalQueueInfo, 3>();
        queues[0u].familyIndex = 1u;
        queues[0u].id.index = 17u;
        queues[0u].id.deviceGeneration = 23u;
        queues[0u].queueClass = CommandQueue::Transfer;
        queues[0u].capabilities = GpuQueueCapability::Transfer;

        queues[1u].familyIndex = 2u;
        queues[1u].id.index = 311u;
        queues[1u].id.deviceGeneration = 23u;
        queues[1u].queueClass = CommandQueue::Transfer;
        queues[1u].capabilities = GpuQueueCapability::Transfer;

        queues[2u].familyIndex = 3u;
        queues[2u].id.index = 1024u;
        queues[2u].id.deviceGeneration = 23u;
        queues[2u].queueClass = CommandQueue::Transfer;
        queues[2u].capabilities = GpuQueueCapability::Transfer;

        const GpuPhysicalQueueTopology topology = MakeGpuScoringTopology(queues);

        Array<GpuTaskQueueLoad, 2> externalLoads = Array<GpuTaskQueueLoad, 2>();
        externalLoads[0u].queue = queues[1u].id;
        externalLoads[0u].estimatedCost = 13u;
        externalLoads[1u].queue = queues[2u].id;
        externalLoads[1u].estimatedCost = u64.max;

        GpuTaskGraphQueueAssignmentOptions options = GpuTaskGraphQueueAssignmentOptions();
        SetGpuScoringExternalQueueLoads(options, externalLoads);

        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        const GpuTaskGraphCompiler compiler = GpuTaskGraphCompiler();
        ASSERT_TRUE(compiler.analyze(declarations, scratchArena, analysis));
        GpuScoringContext scoringContext = GpuScoringMakeContext(declarations, analysis, options, scratchArena);
        ASSERT_TRUE(scoringContext.reachabilityValid);

        Array<Array<b8, 8>, 8> reachable = Array<Array<b8, 8>, 8>();
        const Span<GpuTaskDependencyEdge> allEdges = analysis.edges();
        for(usize edgeIndex = 0u; edgeIndex < allEdges.size(); ++edgeIndex){
            const GpuTaskDependencyEdge edge = allEdges[edgeIndex];
            reachable[edge.producer.index][edge.consumer.index] = true;
        }
        // Plain Floyd-Warshall closure is independent of the packed scheduling representation.
        for(usize intermediate = 0u; intermediate < s_GpuScoringTaskCount; ++intermediate)
            for(usize producer = 0u; producer < s_GpuScoringTaskCount; ++producer)
                for(usize consumer = 0u; consumer < s_GpuScoringTaskCount; ++consumer)
                    reachable[producer][consumer] = reachable[producer][consumer] || (reachable[producer][intermediate] && reachable[intermediate][consumer]);

        GpuScoringAssignmentVector assignments = GpuScoringAssignmentVector(testArena.arena);
        GpuScoringU32Vector assignmentIndices = GpuScoringU32Vector(testArena.arena);
        assignments.reserve(s_GpuScoringTaskCount);
        assignmentIndices.resize(s_GpuScoringTaskCount, u32.max);
        for(usize row = 0u; row < s_GpuScoringTaskCount; ++row){
            const usize taskIndex = assignmentOrder[row];
            const GpuPhysicalQueueId queue = queues[row % queues.size()].id;
            GpuTaskQueueAssignment item = GpuTaskQueueAssignment();
            item.task = tasks[taskIndex];
            item.initialQueue = queue;
            item.queue = queue;
            assignments.push_back(item);
            assignmentIndices[taskIndex] = cast<u32>(row);
        }

        GpuScoringRebuildLoads(scoringContext.scoringData, assignments, topology);
        GpuScoringExpectScores(
            declarations,
            analysis,
            assignments,
            assignmentIndices,
            topology,
            queues,
            scoringContext.reachability,
            scoringContext.scoringData,
            costs,
            reachable,
            ignoredRanges
        );

        Array<Array<usize, 2>, 6> moves = Array<Array<usize, 2>, 6>();
        moves[0u][0u] = 0u;
        moves[0u][1u] = 1u;
        moves[1u][0u] = 3u;
        moves[1u][1u] = 1u;
        moves[2u][0u] = 6u;
        moves[2u][1u] = 1u;
        moves[3u][0u] = 0u;
        moves[3u][1u] = 2u;
        moves[4u][0u] = 5u;
        moves[4u][1u] = 0u;
        moves[5u][0u] = 0u;
        moves[5u][1u] = 2u;

        for(usize moveIndex = 0u; moveIndex < moves.size(); ++moveIndex){
            const usize moveRow = moves[moveIndex][0u];
            const GpuPhysicalQueueId nextQueue = queues[moves[moveIndex][1u]].id;
            scoringContext.scoringData.updateAssignmentLoads(assignments[moveRow].task, assignments[moveRow].queue, nextQueue);
            assignments[moveRow].queue = nextQueue;
            GpuScoringExpectScores(
                declarations,
                analysis,
                assignments,
                assignmentIndices,
                topology,
                queues,
                scoringContext.reachability,
                scoringContext.scoringData,
                costs,
                reachable,
                ignoredRanges
            );
        }

        // Exercise zero eligible off-queue cost, including cancellation by self and a singleton exclusion.
        for(usize row = 0u; row < assignments.size(); ++row){
            scoringContext.scoringData.updateAssignmentLoads(assignments[row].task, assignments[row].queue, queues[0u].id);
            assignments[row].queue = queues[0u].id;
        }
        GpuScoringExpectScores(
            declarations,
            analysis,
            assignments,
            assignmentIndices,
            topology,
            queues,
            scoringContext.reachability,
            scoringContext.scoringData,
            costs,
            reachable,
            ignoredRanges
        );

        Array<usize, 2> offQueueRows = Array<usize, 2>();
        offQueueRows[0u] = 0u;
        offQueueRows[1u] = 3u;
        for(in usize row : offQueueRows){
            scoringContext.scoringData.updateAssignmentLoads(assignments[row].task, assignments[row].queue, queues[1u].id);
            assignments[row].queue = queues[1u].id;
            GpuScoringExpectScores(
                declarations,
                analysis,
                assignments,
                assignmentIndices,
                topology,
                queues,
                scoringContext.reachability,
                scoringContext.scoringData,
                costs,
                reachable,
                ignoredRanges
            );
        }

        GpuScoringAssignmentVector emptyAssignments = GpuScoringAssignmentVector(testArena.arena);
        GpuScoringRebuildLoads(scoringContext.scoringData, emptyAssignments, topology);
        EXPECT_EQ(scoringContext.scoringData.totalAssignedCost, 0u);
        for(in GpuPhysicalQueueInfo queue : queues)
            EXPECT_EQ(scoringContext.scoringData.assignedQueueLoad(queue.id), 0u);
        GpuScoringRebuildLoads(scoringContext.scoringData, assignments, topology);
        GpuScoringExpectScores(
            declarations,
            analysis,
            assignments,
            assignmentIndices,
            topology,
            queues,
            scoringContext.reachability,
            scoringContext.scoringData,
            costs,
            reachable,
            ignoredRanges
        );
    }
}

void VerifyGpuScoring_AppliesHistoricalTimingFeedbackWithHysteresisAndCompileOptions(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);

    GpuTaskCommandRequirements graphicsCommands = GpuTaskCommandRequirements();
    graphicsCommands.requiredCapabilities = GpuQueueCapability::Graphics;

    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.allowSameClassQueueRouting = true;
    scheduling.allowTimingFeedbackRouting = true;
    const Name taskIdentity = s_TaskGraphTimingFeedbackHysteresis;
    GpuTaskTimingMetadata timingMetadata = GpuTaskTimingMetadata();
    timingMetadata.variant = 7u;
    timingMetadata.resolutionClass = 0x07800438u;
    const Expected<GpuTaskId> taskResult = AddTaskWithCommands(
        taskIdentity,
        "Timing Feedback Hysteresis",
        graphicsCommands,
        scheduling,
        timingMetadata,
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    GpuPhysicalQueueInfo auxiliaryGraphicsQueue = GraphicsQueue(1u);
    auxiliaryGraphicsQueue.queueIndex = 1u;
    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = auxiliaryGraphicsQueue;
    const GpuPhysicalQueueTopology topology = MakeGpuScoringTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));

    GpuTaskTimingHistoryStore timingHistory = GpuTaskTimingHistoryStore(testArena.arena);
    GpuTaskTimingKey timingKey = GpuTaskTimingKey();
    timingKey.task = taskIdentity;
    timingKey.variant = timingMetadata.variant;
    timingKey.resolutionClass = timingMetadata.resolutionClass;
    timingKey.queue = CommandQueue::Graphics;
    for(u64 frameIndex = 1u; frameIndex <= 4u; ++frameIndex)
        ASSERT_TRUE(timingHistory.recordSample(timingKey, auxiliaryGraphicsQueue.id, 0.001, frameIndex));
    for(u64 frameIndex = 5u; frameIndex <= 8u; ++frameIndex)
        ASSERT_TRUE(timingHistory.recordSample(timingKey, queues[0u].id, 0.010, frameIndex));

    GpuTaskTimingHistorySnapshot timingSnapshot = GpuTaskTimingHistorySnapshot(testArena.arena);
    GpuScoringTakeSnapshot(timingHistory, timingSnapshot);
    ASSERT_TRUE(timingSnapshot.valid());

    GpuTaskTimingFeedbackPolicy timingPolicy = GpuTaskTimingFeedbackPolicy();
    timingPolicy.minimumSampleCount = 4u;
    timingPolicy.minimumAbsoluteBenefitSeconds = 0.001;
    timingPolicy.minimumRelativeBenefit = 0.1;
    timingPolicy.minimumFramesBetweenSwitches = 10u;
    GpuTaskGraphQueueAssignmentOptions assignmentOptions = GpuTaskGraphQueueAssignmentOptions();
    SetGpuScoringTimingHistory(assignmentOptions, timingSnapshot);
    assignmentOptions.timingFeedbackPolicy = timingPolicy;
    assignmentOptions.timingFrameIndex = 9u;

    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    // Disabled remains an exact deterministic fallback even when a complete snapshot is present.
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, assignmentOptions));
    native(in assignments, in task, in queues){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->initialQueue, queues[0u].id);
        EXPECT_EQ(assignment->queue, queues[0u].id);
        EXPECT_FALSE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingFeedback);
    }

    timingPolicy.enabled = true;
    assignmentOptions.timingFeedbackPolicy = timingPolicy;
    // The accepted primary route switched at frame five, so the configured dwell period still retains it.
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, assignmentOptions));
    native(in assignments, in task, in queues){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->initialQueue, queues[0u].id);
        EXPECT_EQ(assignment->queue, queues[0u].id);
        EXPECT_FALSE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingFeedback);
    }

    timingPolicy.minimumFramesBetweenSwitches = 0u;
    assignmentOptions.timingFeedbackPolicy = timingPolicy;
    GpuTaskGraphCompileOptions compileOptions = GpuTaskGraphCompileOptions();
    compileOptions.queueAssignmentOptions = assignmentOptions;
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology, compileOptions));
    native(in assignments, in task, in queues, in auxiliaryGraphicsQueue){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->initialQueue, queues[0u].id);
        EXPECT_EQ(assignment->queue, auxiliaryGraphicsQueue.id);
        EXPECT_EQ(assignment->reason, Core::GpuTaskQueueAssignmentReason::RequiredGraphics);
        EXPECT_TRUE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingFeedback);
    }
}

void VerifyGpuScoring_CalibratesOptInTimingFeedbackBeforeHysteresisSwitches(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);

    GpuTaskCommandRequirements graphicsCommands = GpuTaskCommandRequirements();
    graphicsCommands.requiredCapabilities = GpuQueueCapability::Graphics;

    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.allowSameClassQueueRouting = true;
    scheduling.allowCrossFamilySameClassQueueRouting = true;
    scheduling.allowTimingFeedbackRouting = true;
    const Name taskIdentity = s_TaskGraphTimingFeedbackCalibration;
    GpuTaskTimingMetadata timingMetadata = GpuTaskTimingMetadata();
    timingMetadata.variant = 9u;
    timingMetadata.resolutionClass = 0x07800438u;
    const Expected<GpuTaskId> taskResult = AddTaskWithCommands(
        taskIdentity,
        "Timing Feedback Calibration",
        graphicsCommands,
        scheduling,
        timingMetadata,
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    GpuPhysicalQueueInfo auxiliaryGraphicsQueue = GraphicsQueue(1u);
    auxiliaryGraphicsQueue.familyIndex = 3u;
    auxiliaryGraphicsQueue.queueIndex = 1u;
    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = auxiliaryGraphicsQueue;
    const GpuPhysicalQueueTopology topology = MakeGpuScoringTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));

    GpuTaskTimingHistoryStore timingHistory = GpuTaskTimingHistoryStore(testArena.arena, 1u);
    timingHistory.resetForDeviceGeneration(queues[0u].id.deviceGeneration);
    GpuTaskTimingHistorySnapshot timingSnapshot = GpuTaskTimingHistorySnapshot(testArena.arena);
    GpuTaskTimingFeedbackPolicy timingPolicy = GpuTaskTimingFeedbackPolicy();
    timingPolicy.enabled = true;
    timingPolicy.minimumSampleCount = 1u;
    timingPolicy.minimumAbsoluteBenefitSeconds = 0.001;
    timingPolicy.minimumRelativeBenefit = 0.1;
    timingPolicy.minimumFramesBetweenSwitches = 0u;
    timingPolicy.calibrationIntervalFrames = 1u;
    GpuTaskGraphQueueAssignmentOptions assignmentOptions = GpuTaskGraphQueueAssignmentOptions();
    SetGpuScoringTimingHistory(assignmentOptions, timingSnapshot);
    assignmentOptions.timingFeedbackPolicy = timingPolicy;
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuTaskTimingKey timingKey = GpuTaskTimingKey();
    timingKey.task = taskIdentity;
    timingKey.variant = timingMetadata.variant;
    timingKey.resolutionClass = timingMetadata.resolutionClass;
    timingKey.queue = CommandQueue::Graphics;

    GpuScoringTakeSnapshot(timingHistory, timingSnapshot);
    assignmentOptions.timingFrameIndex = 0u;
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, assignmentOptions));
    native(in assignments, in task, in queues){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->initialQueue, queues[0u].id);
        EXPECT_EQ(assignment->queue, queues[0u].id);
        EXPECT_TRUE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingCalibration);
    }

    ASSERT_TRUE(timingHistory.recordNonCommittingSample(timingKey, queues[0u].id, 0.010));
    GpuScoringTakeSnapshot(timingHistory, timingSnapshot);
    assignmentOptions.timingFrameIndex = 1u;
    GpuTaskGraphCompileOptions compileOptions = GpuTaskGraphCompileOptions();
    compileOptions.queueAssignmentOptions = assignmentOptions;
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology, compileOptions));
    native(in assignments, in task, in queues, in auxiliaryGraphicsQueue){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->initialQueue, queues[0u].id);
        EXPECT_EQ(assignment->queue, auxiliaryGraphicsQueue.id);
        EXPECT_EQ(assignment->reason, Core::GpuTaskQueueAssignmentReason::RequiredGraphics);
        EXPECT_TRUE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingCalibration);
    }
    {
        const GpuScoringCompiledGraphReadView compiledPlan = GpuScoringCompiledGraphReadView(compiledGraph);
        native(in compiledPlan, in task){
            const Core::GpuCompiledTask* const compiledTask = compiledPlan.findTask(task).plan;
            ASSERT_NE(compiledTask, nullptr);
            EXPECT_TRUE(compiledTask->recordsNonCommittingTimingSample);
        }
    }

    ASSERT_TRUE(timingHistory.recordNonCommittingSample(timingKey, auxiliaryGraphicsQueue.id, 0.020));
    const GpuTaskTimingAssignmentKey assignmentKey = GpuTaskTimingAssignmentKeyFromHistoryKey(timingKey);
    native(in timingHistory, in assignmentKey){
        EXPECT_EQ(timingHistory.findAssignment(assignmentKey), nullptr);
    }
    GpuScoringTakeSnapshot(timingHistory, timingSnapshot);
    assignmentOptions.timingFrameIndex = 2u;
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, assignmentOptions));
    native(in assignments, in task, in queues){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->initialQueue, queues[0u].id);
        EXPECT_EQ(assignment->queue, queues[0u].id);
        EXPECT_FALSE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingCalibration);
    }

    // Calibration observations update route history without becoming the committed incumbent.
    ASSERT_TRUE(timingHistory.recordNonCommittingSample(timingKey, auxiliaryGraphicsQueue.id, 0.001));
    GpuScoringTakeSnapshot(timingHistory, timingSnapshot);
    assignmentOptions.timingFrameIndex = 3u;
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, assignmentOptions));
    native(in assignments, in task, in queues, in auxiliaryGraphicsQueue){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->initialQueue, queues[0u].id);
        EXPECT_EQ(assignment->queue, auxiliaryGraphicsQueue.id);
        EXPECT_EQ(assignment->reason, Core::GpuTaskQueueAssignmentReason::RequiredGraphics);
        EXPECT_TRUE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingFeedback);
    }

    // Under-sampled probe frames do not commit the probed route as the incumbent.
    GpuTaskTimingHistoryStore intervalTimingHistory = GpuTaskTimingHistoryStore(testArena.arena, 2u);
    intervalTimingHistory.resetForDeviceGeneration(queues[0u].id.deviceGeneration);
    ASSERT_TRUE(intervalTimingHistory.recordSample(timingKey, queues[0u].id, 0.010, 10u));
    ASSERT_TRUE(intervalTimingHistory.recordNonCommittingSample(timingKey, queues[0u].id, 0.010));
    GpuTaskTimingHistorySnapshot intervalTimingSnapshot = GpuTaskTimingHistorySnapshot(testArena.arena);
    GpuScoringTakeSnapshot(intervalTimingHistory, intervalTimingSnapshot);
    GpuTaskTimingFeedbackPolicy intervalTimingPolicy = timingPolicy;
    intervalTimingPolicy.minimumSampleCount = 2u;
    intervalTimingPolicy.calibrationIntervalFrames = 2u;
    GpuTaskGraphQueueAssignmentOptions intervalAssignmentOptions = GpuTaskGraphQueueAssignmentOptions();
    SetGpuScoringTimingHistory(intervalAssignmentOptions, intervalTimingSnapshot);
    intervalAssignmentOptions.timingFeedbackPolicy = intervalTimingPolicy;
    intervalAssignmentOptions.timingFrameIndex = 12u;
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, intervalAssignmentOptions));
    native(in assignments, in task, in auxiliaryGraphicsQueue){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->queue, auxiliaryGraphicsQueue.id);
        EXPECT_TRUE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingCalibration);
    }

    ASSERT_TRUE(intervalTimingHistory.recordNonCommittingSample(timingKey, auxiliaryGraphicsQueue.id, 0.020));
    native(in intervalTimingHistory, in assignmentKey, in queues){
        const Core::GpuTaskTimingAssignmentState* const intervalAssignmentState = intervalTimingHistory.findAssignment(assignmentKey);
        ASSERT_NE(intervalAssignmentState, nullptr);
        EXPECT_EQ(intervalAssignmentState->lastAcceptedQueue, queues[0u].id);
        EXPECT_EQ(intervalAssignmentState->lastAcceptedFrameIndex, 10u);
        EXPECT_EQ(intervalAssignmentState->lastSwitchFrameIndex, 10u);
    }
    GpuScoringTakeSnapshot(intervalTimingHistory, intervalTimingSnapshot);
    intervalAssignmentOptions.timingFrameIndex = 13u;
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, intervalAssignmentOptions));
    native(in assignments, in task, in queues){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->queue, queues[0u].id);
        EXPECT_FALSE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingCalibration);
        EXPECT_FALSE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingFeedback);
    }

    intervalAssignmentOptions.timingFrameIndex = 14u;
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, intervalAssignmentOptions));
    native(in assignments, in task, in auxiliaryGraphicsQueue){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->queue, auxiliaryGraphicsQueue.id);
        EXPECT_TRUE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingCalibration);
    }
}

void VerifyGpuScoring_IgnoresTimingFeedbackWithoutAnyEnabledRoute(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);

    GpuTaskCommandRequirements graphicsCommands = GpuTaskCommandRequirements();
    graphicsCommands.requiredCapabilities = GpuQueueCapability::Graphics;
    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.allowTimingFeedbackRouting = true;
    const Expected<GpuTaskId> taskResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphTimingFeedbackWithoutEnabledRoute,
        "Timing Feedback Without Enabled Route",
        graphicsCommands,
        scheduling,
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueInfo queue = queues[0u];
    const GpuPhysicalQueueTopology topology = MakeGpuScoringTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    GpuTaskTimingHistoryStore timingHistory = GpuTaskTimingHistoryStore(testArena.arena);
    timingHistory.resetForDeviceGeneration(queue.id.deviceGeneration);
    GpuTaskTimingHistorySnapshot timingSnapshot = GpuTaskTimingHistorySnapshot(testArena.arena);
    GpuScoringTakeSnapshot(timingHistory, timingSnapshot);
    ASSERT_TRUE(timingSnapshot.valid());
    GpuTaskTimingFeedbackPolicy timingPolicy = GpuTaskTimingFeedbackPolicy();
    timingPolicy.enabled = true;
    timingPolicy.minimumSampleCount = 1u;
    timingPolicy.calibrationIntervalFrames = 1u;
    GpuTaskGraphQueueAssignmentOptions assignmentOptions = GpuTaskGraphQueueAssignmentOptions();
    SetGpuScoringTimingHistory(assignmentOptions, timingSnapshot);
    assignmentOptions.timingFeedbackPolicy = timingPolicy;
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, assignmentOptions));
    native(in assignments, in task, in queue){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->initialQueue, queue.id);
        EXPECT_EQ(assignment->queue, queue.id);
        EXPECT_FALSE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingCalibration);
        EXPECT_FALSE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingFeedback);
    }
}

void VerifyGpuScoring_QueueTimingScoreUsesOnlyReducedIncomingDependencies(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> handoffResult = AddHazardDomain(graph, s_GpuCaseTaskGraphReducedTimingScoreHandoff, "Reduced Timing Score Handoff");
    ASSERT_TRUE(handoffResult.has_value());
    const GpuGraphResourceId handoff = handoffResult.value();
    ASSERT_TRUE(handoff.valid());

    GpuTaskCommandRequirements graphicsCommands = GpuTaskCommandRequirements();
    graphicsCommands.requiredCapabilities = GpuQueueCapability::Graphics;
    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.allowSameClassQueueRouting = true;
    scheduling.allowTimingFeedbackRouting = true;

    const Name firstIdentity = s_TaskGraphReducedTimingScoreFirst;
    Array<GpuTaskResourceUse, 1> firstUses = Array<GpuTaskResourceUse, 1>();
    firstUses[0u].resource = handoff;
    firstUses[0u].requiredState = ResourceStates::UnorderedAccess;
    firstUses[0u].access = GpuTaskResourceAccess::Write;
    GpuTaskDesc firstDesc = GpuTaskDesc();
    firstDesc.setIdentity(firstIdentity);
    firstDesc.setMarkerLabel("Reduced Timing Score First");
    firstDesc.setScheduling(scheduling);
    firstDesc.setResourceUses(firstUses);
    const Expected<GpuTaskId> firstResult = graph.addTask(firstDesc, graphicsCommands);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    ASSERT_TRUE(first.valid());

    const Name secondIdentity = s_TaskGraphReducedTimingScoreSecond;
    Array<GpuTaskId, 1> secondDeps = Array<GpuTaskId, 1>();
    secondDeps[0u] = first;
    GpuTaskDesc secondDesc = GpuTaskDesc();
    secondDesc.setIdentity(secondIdentity);
    secondDesc.setMarkerLabel("Reduced Timing Score Second");
    secondDesc.setScheduling(scheduling);
    secondDesc.setDependencies(secondDeps);
    const Expected<GpuTaskId> secondResult = graph.addTask(secondDesc, graphicsCommands);
    ASSERT_TRUE(secondResult.has_value());
    const GpuTaskId second = secondResult.value();
    ASSERT_TRUE(second.valid());

    const Name thirdIdentity = s_TaskGraphReducedTimingScoreThird;
    Array<GpuTaskId, 1> thirdDeps = Array<GpuTaskId, 1>();
    thirdDeps[0u] = second;
    Array<GpuTaskResourceUse, 1> thirdUses = Array<GpuTaskResourceUse, 1>();
    thirdUses[0u].resource = handoff;
    thirdUses[0u].requiredState = ResourceStates::ShaderResource;
    thirdUses[0u].access = GpuTaskResourceAccess::Read;
    GpuTaskDesc thirdDesc = GpuTaskDesc();
    thirdDesc.setIdentity(thirdIdentity);
    thirdDesc.setMarkerLabel("Reduced Timing Score Third");
    thirdDesc.setScheduling(scheduling);
    thirdDesc.setDependencies(thirdDeps);
    thirdDesc.setResourceUses(thirdUses);
    const Expected<GpuTaskId> thirdResult = graph.addTask(thirdDesc, graphicsCommands);
    ASSERT_TRUE(thirdResult.has_value());
    const GpuTaskId third = thirdResult.value();
    ASSERT_TRUE(third.valid());

    GpuPhysicalQueueInfo firstAuxiliaryQueue = GraphicsQueue(1u);
    firstAuxiliaryQueue.queueIndex = 1u;
    GpuPhysicalQueueInfo secondAuxiliaryQueue = GraphicsQueue(2u);
    secondAuxiliaryQueue.queueIndex = 2u;
    Array<GpuPhysicalQueueInfo, 3> queues = Array<GpuPhysicalQueueInfo, 3>();
    queues[0u] = GraphicsQueue();
    queues[1u] = firstAuxiliaryQueue;
    queues[2u] = secondAuxiliaryQueue;
    const GpuPhysicalQueueTopology topology = MakeGpuScoringTopology(queues);

    GpuTaskTimingKey firstTimingKey = GpuTaskTimingKey();
    firstTimingKey.task = firstIdentity;
    firstTimingKey.queue = CommandQueue::Graphics;
    GpuTaskTimingKey secondTimingKey = GpuTaskTimingKey();
    secondTimingKey.task = secondIdentity;
    secondTimingKey.queue = CommandQueue::Graphics;
    GpuTaskTimingKey thirdTimingKey = GpuTaskTimingKey();
    thirdTimingKey.task = thirdIdentity;
    thirdTimingKey.queue = CommandQueue::Graphics;
    GpuTaskTimingHistoryStore timingHistory = GpuTaskTimingHistoryStore(testArena.arena);
    // A and B each have one measured fast route, so history alone splits them across the auxiliary queues.
    for(u64 frameIndex = 1u; frameIndex <= 4u; ++frameIndex){
        ASSERT_TRUE(timingHistory.recordSample(firstTimingKey, firstAuxiliaryQueue.id, 0.001, frameIndex));
        ASSERT_TRUE(timingHistory.recordSample(secondTimingKey, secondAuxiliaryQueue.id, 0.001, frameIndex));
        ASSERT_TRUE(timingHistory.recordSample(thirdTimingKey, firstAuxiliaryQueue.id, 0.001, frameIndex));
    }
    for(u64 frameIndex = 5u; frameIndex <= 8u; ++frameIndex){
        ASSERT_TRUE(timingHistory.recordSample(firstTimingKey, queues[0u].id, 0.010, frameIndex));
        ASSERT_TRUE(timingHistory.recordSample(secondTimingKey, queues[0u].id, 0.010, frameIndex));
        ASSERT_TRUE(timingHistory.recordSample(thirdTimingKey, secondAuxiliaryQueue.id, 0.001, frameIndex));
    }
    for(u64 frameIndex = 9u; frameIndex <= 12u; ++frameIndex)
        ASSERT_TRUE(timingHistory.recordSample(thirdTimingKey, queues[0u].id, 0.010, frameIndex));

    GpuTaskTimingHistorySnapshot timingSnapshot = GpuTaskTimingHistorySnapshot(testArena.arena);
    GpuScoringTakeSnapshot(timingHistory, timingSnapshot);
    ASSERT_TRUE(timingSnapshot.valid());

    GpuTaskTimingFeedbackPolicy timingPolicy = GpuTaskTimingFeedbackPolicy();
    timingPolicy.enabled = true;
    timingPolicy.minimumSampleCount = 4u;
    timingPolicy.calibrationIntervalFrames = 0u;
    timingPolicy.minimumAbsoluteBenefitSeconds = 0.001;
    timingPolicy.minimumRelativeBenefit = 0.1;
    timingPolicy.minimumFramesBetweenSwitches = 0u;
    GpuTaskGraphQueueAssignmentOptions options = GpuTaskGraphQueueAssignmentOptions();
    SetGpuScoringTimingHistory(options, timingSnapshot);
    options.timingFeedbackPolicy = timingPolicy;
    options.timingFrameIndex = 12u;

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_EQ(analysis.edges().size(), 3u);
    ASSERT_EQ(analysis.schedulingEdges().size(), 2u);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, options));
    native(in assignments, in first, in second, in third, in firstAuxiliaryQueue, in secondAuxiliaryQueue){
        const Core::GpuTaskQueueAssignment* const firstAssignment = assignments.find(first);
        const Core::GpuTaskQueueAssignment* const secondAssignment = assignments.find(second);
        const Core::GpuTaskQueueAssignment* const thirdAssignment = assignments.find(third);
        ASSERT_NE(firstAssignment, nullptr);
        ASSERT_NE(secondAssignment, nullptr);
        ASSERT_NE(thirdAssignment, nullptr);
        EXPECT_EQ(firstAssignment->queue, firstAuxiliaryQueue.id);
        EXPECT_EQ(secondAssignment->queue, secondAuxiliaryQueue.id);
        // Transitive reduction drops the redundant A-to-C edge so C stays on B's queue.
        EXPECT_EQ(thirdAssignment->queue, secondAuxiliaryQueue.id);
    }
}

void VerifyGpuScoring_RejectsInvalidGraphOwnedTimingPolicy(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskTimingMetadata invalidTiming = GpuTaskTimingMetadata();
    invalidTiming.policy = s_GpuScoringInvalidTimingPolicy;
    const Expected<GpuTaskId> taskResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphTimingPolicyInvalid,
        "Timing Policy Invalid",
        GpuTaskCommandRequirements(),
        GpuTaskSchedulingHint(),
        invalidTiming,
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    EXPECT_FALSE(Analyze(graph, operationScratchArena, analysis));
    EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::InvalidTask);
}

void GpuScoringRunCrossClassTimingRouteCase(in b8 staticCompute){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);

    GpuTaskCommandRequirements graphicsCommands = GpuTaskCommandRequirements();
    graphicsCommands.requiredCapabilities = GpuQueueCapability::Graphics;
    if(staticCompute){
        const Expected<GpuTaskId> independentGraphicsResult = AddTaskWithCommands(
            s_GpuCaseTaskGraphCrossClassTimingIndependentGraphics,
            "Cross Class Timing Independent Graphics",
            graphicsCommands,
            GpuTaskSchedulingHint(),
            GpuTaskTimingMetadata(),
            Span<GpuTaskId>(),
            graph
        );
        ASSERT_TRUE(independentGraphicsResult.has_value());
        const GpuTaskId independentGraphics = independentGraphicsResult.value();
        ASSERT_TRUE(independentGraphics.valid());
    }

    GpuTaskCommandRequirements computeCommands = GpuTaskCommandRequirements();
    computeCommands.requiredCapabilities = GpuQueueCapability::Compute;
    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.allowSameClassQueueRouting = false;
    scheduling.allowCrossFamilySameClassQueueRouting = true;
    scheduling.allowTimingFeedbackRouting = true;
    scheduling.allowCrossClassTimingFeedbackRouting = true;
    Name taskIdentity = s_GpuScoringCrossClassTimingGraphicsToCompute;
    u32 variant = 12u;
    if(staticCompute){
        taskIdentity = s_GpuScoringCrossClassTimingComputeToGraphics;
        variant = 11u;
    }
    GpuTaskTimingMetadata timingMetadata = GpuTaskTimingMetadata();
    timingMetadata.variant = variant;
    timingMetadata.resolutionClass = 0x07800438u;
    const Expected<GpuTaskId> taskResult = AddTaskWithCommands(
        taskIdentity,
        "Cross Class Timing Target",
        computeCommands,
        scheduling,
        timingMetadata,
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuScoringTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology));

    GpuPhysicalQueueInfo incumbentQueue = queues[0u];
    GpuPhysicalQueueInfo candidateQueue = queues[1u];
    if(staticCompute){
        incumbentQueue = queues[1u];
        candidateQueue = queues[0u];
    }
    native(in assignments, in task, in incumbentQueue){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->initialQueue, incumbentQueue.id);
        EXPECT_EQ(assignment->queue, incumbentQueue.id);
    }

    GpuTaskTimingKey graphicsKey = GpuTaskTimingKey();
    graphicsKey.task = taskIdentity;
    graphicsKey.variant = timingMetadata.variant;
    graphicsKey.resolutionClass = timingMetadata.resolutionClass;
    graphicsKey.queue = CommandQueue::Graphics;

    GpuTaskTimingKey computeKey = GpuTaskTimingKey();
    computeKey.task = taskIdentity;
    computeKey.variant = timingMetadata.variant;
    computeKey.resolutionClass = timingMetadata.resolutionClass;
    computeKey.queue = CommandQueue::Compute;

    GpuTaskTimingKey incumbentKey = graphicsKey;
    GpuTaskTimingKey candidateKey = computeKey;
    if(staticCompute){
        incumbentKey = computeKey;
        candidateKey = graphicsKey;
    }

    GpuTaskTimingHistoryStore timingHistory = GpuTaskTimingHistoryStore(testArena.arena, 1u);
    ASSERT_TRUE(timingHistory.recordSample(candidateKey, candidateQueue.id, 0.001, 1u));
    ASSERT_TRUE(timingHistory.recordSample(incumbentKey, incumbentQueue.id, 0.010, 2u));

    GpuTaskTimingHistorySnapshot timingSnapshot = GpuTaskTimingHistorySnapshot(testArena.arena);
    GpuScoringTakeSnapshot(timingHistory, timingSnapshot);
    ASSERT_TRUE(timingSnapshot.valid());
    GpuTaskTimingFeedbackPolicy timingPolicy = GpuTaskTimingFeedbackPolicy();
    timingPolicy.enabled = true;
    timingPolicy.minimumSampleCount = 1u;
    timingPolicy.calibrationIntervalFrames = 0u;
    timingPolicy.minimumAbsoluteBenefitSeconds = 0.001;
    timingPolicy.minimumRelativeBenefit = 0.1;
    timingPolicy.minimumFramesBetweenSwitches = 0u;
    GpuTaskGraphQueueAssignmentOptions assignmentOptions = GpuTaskGraphQueueAssignmentOptions();
    SetGpuScoringTimingHistory(assignmentOptions, timingSnapshot);
    assignmentOptions.timingFeedbackPolicy = timingPolicy;
    assignmentOptions.timingFrameIndex = 10u;
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, assignmentOptions));
    native(in assignments, in task, in incumbentQueue, in candidateQueue){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->initialQueue, incumbentQueue.id);
        EXPECT_EQ(assignment->queue, candidateQueue.id);
        EXPECT_EQ(assignment->queueClass, candidateQueue.queueClass);
        EXPECT_TRUE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingFeedback);
    }

    ASSERT_TRUE(timingHistory.noteAcceptedAssignment(candidateKey, candidateQueue.id, 10u));
    ASSERT_TRUE(timingHistory.recordNonCommittingSample(incumbentKey, incumbentQueue.id, 0.001));
    ASSERT_TRUE(timingHistory.recordNonCommittingSample(candidateKey, candidateQueue.id, 0.010));
    const GpuTaskTimingAssignmentKey assignmentKey = GpuTaskTimingAssignmentKeyFromHistoryKey(candidateKey);
    native(in timingHistory, in assignmentKey, in candidateQueue){
        const Core::GpuTaskTimingAssignmentState* const assignmentState = timingHistory.findAssignment(assignmentKey);
        ASSERT_NE(assignmentState, nullptr);
        EXPECT_EQ(assignmentState->lastAcceptedQueue, candidateQueue.id);
        EXPECT_EQ(assignmentState->lastSwitchFrameIndex, 10u);
    }
    GpuScoringTakeSnapshot(timingHistory, timingSnapshot);
    timingPolicy.minimumFramesBetweenSwitches = 10u;
    assignmentOptions.timingFeedbackPolicy = timingPolicy;
    assignmentOptions.timingFrameIndex = 12u;
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, assignmentOptions));
    native(in assignments, in task, in incumbentQueue, in candidateQueue){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->initialQueue, incumbentQueue.id);
        EXPECT_EQ(assignment->queue, candidateQueue.id);
        EXPECT_EQ(assignment->queueClass, candidateQueue.queueClass);
        EXPECT_TRUE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingFeedback);
    }

    assignmentOptions.timingFrameIndex = 20u;
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, assignmentOptions));
    native(in assignments, in task, in incumbentQueue){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->initialQueue, incumbentQueue.id);
        EXPECT_EQ(assignment->queue, incumbentQueue.id);
        EXPECT_EQ(assignment->queueClass, incumbentQueue.queueClass);
        EXPECT_TRUE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingFeedback);
    }
}

void VerifyGpuScoring_RoutesOptInTimingFeedbackAcrossGraphicsAndComputeClasses(){
    GpuScoringRunCrossClassTimingRouteCase(false);
    GpuScoringRunCrossClassTimingRouteCase(true);
}

void VerifyGpuScoring_CrossClassTimingCalibrationPreservesStaticBaselineAndHonorsHysteresisAndDwell(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);

    GpuTaskCommandRequirements graphicsCommands = GpuTaskCommandRequirements();
    graphicsCommands.requiredCapabilities = GpuQueueCapability::Graphics;
    const Expected<GpuTaskId> independentGraphicsResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphCrossClassCalibrationIndependentGraphics,
        "Cross Class Calibration Independent Graphics",
        graphicsCommands,
        GpuTaskSchedulingHint(),
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(independentGraphicsResult.has_value());
    const GpuTaskId independentGraphics = independentGraphicsResult.value();
    ASSERT_TRUE(independentGraphics.valid());

    GpuTaskCommandRequirements computeCommands = GpuTaskCommandRequirements();
    computeCommands.requiredCapabilities = GpuQueueCapability::Compute;
    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.allowSameClassQueueRouting = true;
    scheduling.allowCrossFamilySameClassQueueRouting = true;
    scheduling.allowTimingFeedbackRouting = true;
    scheduling.allowCrossClassTimingFeedbackRouting = true;
    const Name taskIdentity = s_TaskGraphCrossClassTimingCalibration;
    GpuTaskTimingMetadata timingMetadata = GpuTaskTimingMetadata();
    timingMetadata.variant = 13u;
    timingMetadata.resolutionClass = 0x07800438u;
    const Expected<GpuTaskId> taskResult = AddTaskWithCommands(
        taskIdentity,
        "Cross Class Timing Calibration",
        computeCommands,
        scheduling,
        timingMetadata,
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuScoringTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuTaskTimingHistoryStore timingHistory = GpuTaskTimingHistoryStore(testArena.arena);
    timingHistory.resetForDeviceGeneration(queues[0u].id.deviceGeneration);
    GpuTaskTimingHistorySnapshot timingSnapshot = GpuTaskTimingHistorySnapshot(testArena.arena);
    GpuScoringTakeSnapshot(timingHistory, timingSnapshot);
    ASSERT_TRUE(timingSnapshot.valid());

    GpuTaskTimingFeedbackPolicy timingPolicy = GpuTaskTimingFeedbackPolicy();
    timingPolicy.enabled = true;
    timingPolicy.minimumSampleCount = 1u;
    timingPolicy.calibrationIntervalFrames = 1u;
    timingPolicy.minimumAbsoluteBenefitSeconds = 0.001;
    timingPolicy.minimumRelativeBenefit = 0.1;
    timingPolicy.minimumFramesBetweenSwitches = 0u;
    GpuTaskGraphQueueAssignmentOptions assignmentOptions = GpuTaskGraphQueueAssignmentOptions();
    SetGpuScoringTimingHistory(assignmentOptions, timingSnapshot);
    assignmentOptions.timingFeedbackPolicy = timingPolicy;
    assignmentOptions.timingFrameIndex = 0u;
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, assignmentOptions));
    native(in assignments, in task, in queues){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->initialQueue, queues[1u].id);
        EXPECT_EQ(assignment->queue, queues[1u].id);
        EXPECT_FALSE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingFeedback);
    }

    GpuTaskTimingKey graphicsKey = GpuTaskTimingKey();
    graphicsKey.task = taskIdentity;
    graphicsKey.variant = timingMetadata.variant;
    graphicsKey.resolutionClass = timingMetadata.resolutionClass;
    graphicsKey.queue = CommandQueue::Graphics;

    GpuTaskTimingKey computeKey = GpuTaskTimingKey();
    computeKey.task = taskIdentity;
    computeKey.variant = timingMetadata.variant;
    computeKey.resolutionClass = timingMetadata.resolutionClass;
    computeKey.queue = CommandQueue::Compute;

    ASSERT_TRUE(timingHistory.recordSample(computeKey, queues[1u].id, 0.010, 1u));
    GpuScoringTakeSnapshot(timingHistory, timingSnapshot);
    assignmentOptions.timingFrameIndex = 1u;
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, assignmentOptions));
    native(in assignments, in task, in queues){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->initialQueue, queues[1u].id);
        EXPECT_EQ(assignment->queue, queues[0u].id);
        EXPECT_TRUE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingCalibration);
    }

    ASSERT_TRUE(timingHistory.recordNonCommittingSample(graphicsKey, queues[0u].id, 0.004));
    ASSERT_TRUE(timingHistory.recordSample(computeKey, queues[1u].id, 0.010, 3u));
    EXPECT_EQ(timingHistory.historyCount(), 2u);
    const GpuTaskTimingAssignmentKey assignmentKey = GpuTaskTimingAssignmentKeyFromHistoryKey(computeKey);
    native(in timingHistory, in assignmentKey, in queues){
        const Core::GpuTaskTimingAssignmentState* const assignmentState = timingHistory.findAssignment(assignmentKey);
        ASSERT_NE(assignmentState, nullptr);
        EXPECT_EQ(assignmentState->lastAcceptedQueue, queues[1u].id);
        EXPECT_EQ(assignmentState->lastAcceptedFrameIndex, 3u);
        EXPECT_EQ(assignmentState->lastSwitchFrameIndex, 1u);
    }
    GpuScoringTakeSnapshot(timingHistory, timingSnapshot);

    timingPolicy.minimumAbsoluteBenefitSeconds = 0.007;
    assignmentOptions.timingFeedbackPolicy = timingPolicy;
    assignmentOptions.timingFrameIndex = 20u;
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, assignmentOptions));
    native(in assignments, in task, in queues){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->queue, queues[1u].id);
        EXPECT_FALSE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingFeedback);
    }

    timingPolicy.minimumAbsoluteBenefitSeconds = 0.001;
    timingPolicy.minimumFramesBetweenSwitches = 10u;
    assignmentOptions.timingFeedbackPolicy = timingPolicy;
    assignmentOptions.timingFrameIndex = 5u;
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, assignmentOptions));
    native(in assignments, in task, in queues){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->queue, queues[1u].id);
        EXPECT_FALSE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingFeedback);
    }

    assignmentOptions.timingFrameIndex = 13u;
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, assignmentOptions));
    native(in assignments, in task, in queues){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->initialQueue, queues[1u].id);
        EXPECT_EQ(assignment->queue, queues[0u].id);
        EXPECT_TRUE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingFeedback);
    }
}

void GpuScoringRunRejectedCrossClassCase(
    in b8 allowCrossClassRouting,
    in b8 allowCrossFamilyRouting,
    in b8 requireGraphicsCapability
){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);

    GpuTaskCommandRequirements graphicsCommands = GpuTaskCommandRequirements();
    graphicsCommands.requiredCapabilities = GpuQueueCapability::Graphics;
    const Expected<GpuTaskId> independentGraphicsResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphRejectedCrossClassIndependentGraphics,
        "Rejected Cross Class Independent Graphics",
        graphicsCommands,
        GpuTaskSchedulingHint(),
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(independentGraphicsResult.has_value());
    const GpuTaskId independentGraphics = independentGraphicsResult.value();
    ASSERT_TRUE(independentGraphics.valid());

    GpuTaskCommandRequirements commands = GpuTaskCommandRequirements();
    if(requireGraphicsCapability)
        commands.requiredCapabilities = GpuQueueCapability::Graphics;
    else
        commands.requiredCapabilities = GpuQueueCapability::Compute;

    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.allowSameClassQueueRouting = true;
    scheduling.allowCrossFamilySameClassQueueRouting = allowCrossFamilyRouting;
    scheduling.allowTimingFeedbackRouting = true;
    scheduling.allowCrossClassTimingFeedbackRouting = allowCrossClassRouting;
    Name taskIdentity = s_TaskGraphRejectedCapabilityCrossClassTiming;
    if(!allowCrossClassRouting)
        taskIdentity = s_GpuCaseTaskGraphRejectedMissingCrossClassTimingOptIn;
    else if(!allowCrossFamilyRouting)
        taskIdentity = s_GpuCaseTaskGraphRejectedCrossFamilyCrossClassTiming;

    const Expected<GpuTaskId> taskResult = AddTaskWithCommands(
        taskIdentity,
        "Rejected Cross Class Timing",
        commands,
        scheduling,
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuScoringTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));

    GpuTaskTimingKey graphicsKey = GpuTaskTimingKey();
    graphicsKey.task = taskIdentity;
    graphicsKey.queue = CommandQueue::Graphics;
    GpuTaskTimingKey computeKey = GpuTaskTimingKey();
    computeKey.task = taskIdentity;
    computeKey.queue = CommandQueue::Compute;

    usize incumbentQueueIndex = 1u;
    usize candidateQueueIndex = 0u;
    GpuTaskTimingKey incumbentKey = computeKey;
    GpuTaskTimingKey candidateKey = graphicsKey;
    if(requireGraphicsCapability){
        incumbentQueueIndex = 0u;
        candidateQueueIndex = 1u;
        incumbentKey = graphicsKey;
        candidateKey = computeKey;
    }

    GpuTaskTimingHistoryStore timingHistory = GpuTaskTimingHistoryStore(testArena.arena);
    for(u64 frameIndex = 1u; frameIndex <= 4u; ++frameIndex)
        ASSERT_TRUE(timingHistory.recordSample(candidateKey, queues[candidateQueueIndex].id, 0.001, frameIndex));
    for(u64 frameIndex = 5u; frameIndex <= 8u; ++frameIndex)
        ASSERT_TRUE(timingHistory.recordSample(incumbentKey, queues[incumbentQueueIndex].id, 0.010, frameIndex));

    GpuTaskTimingHistorySnapshot timingSnapshot = GpuTaskTimingHistorySnapshot(testArena.arena);
    GpuScoringTakeSnapshot(timingHistory, timingSnapshot);
    ASSERT_TRUE(timingSnapshot.valid());
    GpuTaskTimingFeedbackPolicy timingPolicy = GpuTaskTimingFeedbackPolicy();
    timingPolicy.enabled = true;
    timingPolicy.minimumSampleCount = 4u;
    timingPolicy.calibrationIntervalFrames = 0u;
    timingPolicy.minimumFramesBetweenSwitches = 0u;
    GpuTaskGraphQueueAssignmentOptions assignmentOptions = GpuTaskGraphQueueAssignmentOptions();
    SetGpuScoringTimingHistory(assignmentOptions, timingSnapshot);
    assignmentOptions.timingFeedbackPolicy = timingPolicy;
    assignmentOptions.timingFrameIndex = 20u;
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, assignmentOptions));
    const GpuPhysicalQueueId expectedQueue = queues[incumbentQueueIndex].id;
    native(in assignments, in task, in expectedQueue){
        const Core::GpuTaskQueueAssignment* const assignment = assignments.find(task);
        ASSERT_NE(assignment, nullptr);
        EXPECT_EQ(assignment->initialQueue, expectedQueue);
        EXPECT_EQ(assignment->queue, expectedQueue);
        EXPECT_FALSE(assignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingFeedback);
    }

    // A rejected policy must also drop the earlier valid result.
    timingPolicy.minimumRelativeBenefit = 2.0;
    assignmentOptions.timingFeedbackPolicy = timingPolicy;
    EXPECT_FALSE(Assign(assignments, operationScratchArena, graph, analysis, topology, assignmentOptions));
    EXPECT_EQ(assignments.diagnostic().status, GpuTaskGraphQueueAssignmentStatus::InvalidTimingFeedback);
    EXPECT_FALSE(assignments.valid());
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        EXPECT_FALSE(assignments.validFor(declarations));
    }
    native(in assignments, in task){
        EXPECT_EQ(assignments.find(task), nullptr);
    }
}

void VerifyGpuScoring_RejectsCrossClassTimingRoutesWithoutEveryRequiredOptIn(){
    GpuScoringRunRejectedCrossClassCase(false, true, false);
    GpuScoringRunRejectedCrossClassCase(true, false, false);
    GpuScoringRunRejectedCrossClassCase(true, true, true);
}

void VerifyGpuScoring_RanksEqualTimingRoutesDeterministicallyAndKeepsDwellAndFamilyOptIn(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);

    GpuTaskCommandRequirements graphicsCommands = GpuTaskCommandRequirements();
    graphicsCommands.requiredCapabilities = GpuQueueCapability::Graphics;

    GpuTaskSchedulingHint preloadScheduling = GpuTaskSchedulingHint();
    preloadScheduling.cost = GpuTaskCostHint::Large;
    preloadScheduling.allowSameClassQueueRouting = true;
    preloadScheduling.preferNonPrimarySameClassQueue = true;
    const Expected<GpuTaskId> preloadResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphTimingFeedbackPreload,
        "Timing Feedback Preload",
        graphicsCommands,
        preloadScheduling,
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(preloadResult.has_value());
    const GpuTaskId preload = preloadResult.value();
    ASSERT_TRUE(preload.valid());

    GpuTaskSchedulingHint targetScheduling = GpuTaskSchedulingHint();
    targetScheduling.allowSameClassQueueRouting = true;
    targetScheduling.allowTimingFeedbackRouting = true;
    const Name targetIdentity = s_TaskGraphTimingFeedbackEqualCandidates;
    const Expected<GpuTaskId> targetResult = AddTaskWithCommands(
        targetIdentity,
        "Timing Feedback Equal Candidates",
        graphicsCommands,
        targetScheduling,
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(targetResult.has_value());
    const GpuTaskId target = targetResult.value();
    ASSERT_TRUE(target.valid());

    GpuPhysicalQueueInfo firstAuxiliaryGraphicsQueue = GraphicsQueue(1u);
    firstAuxiliaryGraphicsQueue.queueIndex = 1u;
    GpuPhysicalQueueInfo secondAuxiliaryGraphicsQueue = GraphicsQueue(2u);
    secondAuxiliaryGraphicsQueue.queueIndex = 2u;
    Array<GpuPhysicalQueueInfo, 3> queues = Array<GpuPhysicalQueueInfo, 3>();
    queues[0u] = GraphicsQueue();
    queues[1u] = firstAuxiliaryGraphicsQueue;
    queues[2u] = secondAuxiliaryGraphicsQueue;
    const GpuPhysicalQueueTopology topology = MakeGpuScoringTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));

    GpuTaskTimingHistoryStore timingHistory = GpuTaskTimingHistoryStore(testArena.arena);
    GpuTaskTimingKey targetTimingKey = GpuTaskTimingKey();
    targetTimingKey.task = targetIdentity;
    targetTimingKey.queue = CommandQueue::Graphics;
    for(u64 frameIndex = 1u; frameIndex <= 4u; ++frameIndex)
        ASSERT_TRUE(timingHistory.recordSample(targetTimingKey, firstAuxiliaryGraphicsQueue.id, 0.001, frameIndex));
    for(u64 frameIndex = 5u; frameIndex <= 8u; ++frameIndex)
        ASSERT_TRUE(timingHistory.recordSample(targetTimingKey, secondAuxiliaryGraphicsQueue.id, 0.001, frameIndex));
    for(u64 frameIndex = 9u; frameIndex <= 12u; ++frameIndex)
        ASSERT_TRUE(timingHistory.recordSample(targetTimingKey, queues[0u].id, 0.010, frameIndex));

    GpuTaskTimingHistorySnapshot timingSnapshot = GpuTaskTimingHistorySnapshot(testArena.arena);
    GpuScoringTakeSnapshot(timingHistory, timingSnapshot);
    ASSERT_TRUE(timingSnapshot.valid());

    GpuTaskTimingFeedbackPolicy timingPolicy = GpuTaskTimingFeedbackPolicy();
    timingPolicy.enabled = true;
    timingPolicy.minimumSampleCount = 4u;
    timingPolicy.minimumAbsoluteBenefitSeconds = 0.001;
    timingPolicy.minimumRelativeBenefit = 0.1;
    timingPolicy.minimumFramesBetweenSwitches = 0u;
    GpuTaskGraphQueueAssignmentOptions assignmentOptions = GpuTaskGraphQueueAssignmentOptions();
    SetGpuScoringTimingHistory(assignmentOptions, timingSnapshot);
    assignmentOptions.timingFeedbackPolicy = timingPolicy;
    assignmentOptions.timingFrameIndex = 12u;

    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, assignmentOptions));
    native(in assignments, in preload, in target, in firstAuxiliaryGraphicsQueue, in secondAuxiliaryGraphicsQueue){
        const Core::GpuTaskQueueAssignment* const preloadAssignment = assignments.find(preload);
        const Core::GpuTaskQueueAssignment* const targetAssignment = assignments.find(target);
        ASSERT_NE(preloadAssignment, nullptr);
        ASSERT_NE(targetAssignment, nullptr);
        EXPECT_EQ(preloadAssignment->queue, firstAuxiliaryGraphicsQueue.id);
        // Choose the unloaded second auxiliary queue when both histories are equally fast.
        EXPECT_EQ(targetAssignment->queue, secondAuxiliaryGraphicsQueue.id);
    }

    // A non-committing sample adds route history but must not move the committed incumbent or restart its dwell.
    ASSERT_TRUE(timingHistory.recordNonCommittingSample(targetTimingKey, firstAuxiliaryGraphicsQueue.id, 0.020));
    const GpuTaskTimingAssignmentKey targetAssignmentKey = GpuTaskTimingAssignmentKeyFromHistoryKey(targetTimingKey);
    native(in timingHistory, in targetAssignmentKey, in queues){
        const Core::GpuTaskTimingAssignmentState* const targetAssignmentState = timingHistory.findAssignment(targetAssignmentKey);
        ASSERT_NE(targetAssignmentState, nullptr);
        EXPECT_EQ(targetAssignmentState->lastAcceptedQueue, queues[0u].id);
        EXPECT_EQ(targetAssignmentState->lastSwitchFrameIndex, 9u);
    }
    GpuScoringTakeSnapshot(timingHistory, timingSnapshot);
    timingPolicy.minimumFramesBetweenSwitches = 30u;
    assignmentOptions.timingFeedbackPolicy = timingPolicy;
    assignmentOptions.timingFrameIndex = 14u;
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, assignmentOptions));
    native(in assignments, in target, in queues){
        const Core::GpuTaskQueueAssignment* const dwellAssignment = assignments.find(target);
        ASSERT_NE(dwellAssignment, nullptr);
        EXPECT_EQ(dwellAssignment->queue, queues[0u].id);
        EXPECT_FALSE(dwellAssignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingFeedback);
    }

    // The faster history on queue ID 1 now names another family, and the target has no cross-family opt-in.
    GpuPhysicalQueueInfo crossFamilyGraphicsQueue = GraphicsQueue(1u);
    crossFamilyGraphicsQueue.familyIndex = 1u;
    Array<GpuPhysicalQueueInfo, 2> crossFamilyQueues = Array<GpuPhysicalQueueInfo, 2>();
    crossFamilyQueues[0u] = GraphicsQueue();
    crossFamilyQueues[1u] = crossFamilyGraphicsQueue;
    const GpuPhysicalQueueTopology crossFamilyTopology = MakeGpuScoringTopology(crossFamilyQueues);
    timingPolicy.minimumFramesBetweenSwitches = 0u;
    assignmentOptions.timingFeedbackPolicy = timingPolicy;
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, crossFamilyTopology, assignmentOptions));
    native(in assignments, in target, in queues){
        const Core::GpuTaskQueueAssignment* const crossFamilyAssignment = assignments.find(target);
        ASSERT_NE(crossFamilyAssignment, nullptr);
        EXPECT_EQ(crossFamilyAssignment->queue, queues[0u].id);
        EXPECT_FALSE(crossFamilyAssignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingFeedback);
    }
}

void VerifyGpuScoring_RoutesOptedInCrossFamilyTimingFeedbackWithExclusiveOwnershipHandoffs(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> bufferResult = AddBufferMetadata(
        graph,
        s_GpuCaseTaskGraphTimingFeedbackCrossFamilyBuffer,
        "Timing Feedback Cross Family Buffer"
    );
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    ASSERT_TRUE(buffer.valid());

    GpuTaskCommandRequirements graphicsCommands = GpuTaskCommandRequirements();
    graphicsCommands.requiredCapabilities = GpuQueueCapability::Graphics;

    Array<GpuTaskResourceUse, 1> producerUses = Array<GpuTaskResourceUse, 1>();
    producerUses[0u].resource = buffer;
    producerUses[0u].requiredState = ResourceStates::CopyDest;
    producerUses[0u].access = GpuTaskResourceAccess::Write;
    GpuTaskDesc producerDesc = GpuTaskDesc();
    producerDesc.setIdentity(s_GpuCaseTaskGraphTimingFeedbackCrossFamilyProducer);
    producerDesc.setMarkerLabel("Timing Feedback Cross Family Producer");
    producerDesc.setResourceUses(producerUses);
    const Expected<GpuTaskId> producerResult = graph.addTask(producerDesc, graphicsCommands);
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();
    ASSERT_TRUE(producer.valid());

    GpuTaskSchedulingHint consumerScheduling = GpuTaskSchedulingHint();
    consumerScheduling.allowSameClassQueueRouting = true;
    consumerScheduling.preserveSameClassQueueWithDirectDependency = true;
    consumerScheduling.allowCrossFamilySameClassQueueRouting = true;
    consumerScheduling.allowTimingFeedbackRouting = true;
    Array<GpuTaskId, 1> consumerDependencies = Array<GpuTaskId, 1>();
    consumerDependencies[0u] = producer;
    Array<GpuTaskResourceUse, 1> consumerUses = Array<GpuTaskResourceUse, 1>();
    consumerUses[0u].resource = buffer;
    consumerUses[0u].requiredState = ResourceStates::CopySource;
    consumerUses[0u].access = GpuTaskResourceAccess::Read;
    const Name consumerIdentity = s_TaskGraphTimingFeedbackCrossFamilyConsumer;
    GpuTaskDesc consumerDesc = GpuTaskDesc();
    consumerDesc.setIdentity(consumerIdentity);
    consumerDesc.setMarkerLabel("Timing Feedback Cross Family Consumer");
    consumerDesc.setScheduling(consumerScheduling);
    consumerDesc.setDependencies(consumerDependencies);
    consumerDesc.setResourceUses(consumerUses);
    const Expected<GpuTaskId> consumerResult = graph.addTask(consumerDesc, graphicsCommands);
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(consumer.valid());

    GpuPhysicalQueueInfo auxiliaryGraphicsQueue = GraphicsQueue(1u);
    auxiliaryGraphicsQueue.familyIndex = 3u;
    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = auxiliaryGraphicsQueue;
    const GpuPhysicalQueueTopology topology = MakeGpuScoringTopology(queues);

    GpuTaskTimingKey consumerTimingKey = GpuTaskTimingKey();
    consumerTimingKey.task = consumerIdentity;
    consumerTimingKey.queue = CommandQueue::Graphics;
    GpuTaskTimingHistoryStore timingHistory = GpuTaskTimingHistoryStore(testArena.arena);
    for(u64 frameIndex = 1u; frameIndex <= 4u; ++frameIndex)
        ASSERT_TRUE(timingHistory.recordSample(consumerTimingKey, auxiliaryGraphicsQueue.id, 0.001, frameIndex));
    for(u64 frameIndex = 5u; frameIndex <= 8u; ++frameIndex)
        ASSERT_TRUE(timingHistory.recordSample(consumerTimingKey, queues[0u].id, 0.010, frameIndex));

    GpuTaskTimingHistorySnapshot timingSnapshot = GpuTaskTimingHistorySnapshot(testArena.arena);
    GpuScoringTakeSnapshot(timingHistory, timingSnapshot);
    ASSERT_TRUE(timingSnapshot.valid());

    GpuTaskTimingFeedbackPolicy timingPolicy = GpuTaskTimingFeedbackPolicy();
    timingPolicy.enabled = true;
    timingPolicy.minimumSampleCount = 4u;
    timingPolicy.calibrationIntervalFrames = 0u;
    timingPolicy.minimumAbsoluteBenefitSeconds = 0.001;
    timingPolicy.minimumRelativeBenefit = 0.1;
    timingPolicy.minimumFramesBetweenSwitches = 0u;
    GpuTaskGraphQueueAssignmentOptions assignmentOptions = GpuTaskGraphQueueAssignmentOptions();
    SetGpuScoringTimingHistory(assignmentOptions, timingSnapshot);
    assignmentOptions.timingFeedbackPolicy = timingPolicy;
    assignmentOptions.timingFrameIndex = 8u;
    GpuTaskGraphCompileOptions compileOptions = GpuTaskGraphCompileOptions();
    compileOptions.queueAssignmentOptions = assignmentOptions;

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology, compileOptions));
    const GpuScoringCompiledGraphReadView compiledPlan = GpuScoringCompiledGraphReadView(compiledGraph);

    native(in assignments, in compiledPlan, in producer, in consumer, in buffer, in queues, in auxiliaryGraphicsQueue){
        const Core::GpuTaskQueueAssignment* const producerAssignment = assignments.find(producer);
        const Core::GpuTaskQueueAssignment* const consumerAssignment = assignments.find(consumer);
        ASSERT_NE(producerAssignment, nullptr);
        ASSERT_NE(consumerAssignment, nullptr);
        EXPECT_EQ(producerAssignment->queue, queues[0u].id);
        EXPECT_EQ(consumerAssignment->queue, auxiliaryGraphicsQueue.id);
        EXPECT_EQ(consumerAssignment->reason, Core::GpuTaskQueueAssignmentReason::RequiredGraphics);
        EXPECT_TRUE(consumerAssignment->modifiers & Core::GpuTaskQueueAssignmentModifier::TimingFeedback);

        const Core::GpuSubmissionPacketId producerPacket = compiledPlan.packetForTask(producer);
        const Core::GpuSubmissionPacketId consumerPacket = compiledPlan.packetForTask(consumer);
        const Core::GpuCompiledTask* const compiledProducer = compiledPlan.findTask(producer).plan;
        const Core::GpuCompiledTask* const compiledConsumer = compiledPlan.findTask(consumer).plan;
        ASSERT_TRUE(producerPacket.valid());
        ASSERT_TRUE(consumerPacket.valid());
        ASSERT_NE(compiledProducer, nullptr);
        ASSERT_NE(compiledConsumer, nullptr);
        ASSERT_NE(producerPacket, consumerPacket);
        ASSERT_EQ(compiledPlan.packet(consumerPacket).plan->dependencyCount, 1u);
        EXPECT_EQ(compiledPlan.packet(consumerPacket).dependencies[0u].producer, producerPacket);
        ASSERT_EQ(compiledProducer->epilogueBarrierCount, 1u);
        ASSERT_EQ(compiledConsumer->prologueStateSeedCount, 1u);
        ASSERT_EQ(compiledConsumer->prologueBarrierCount, 2u);

        const Core::GpuCompiledBarrier& release = compiledPlan.findTask(producer).epilogueBarriers[0u];
        EXPECT_EQ(release.type, Core::GpuCompiledBarrierType::BufferOwnershipRelease);
        EXPECT_EQ(release.resource, buffer);
        EXPECT_EQ(release.sourceQueue, queues[0u].id);
        EXPECT_EQ(release.destinationQueue, auxiliaryGraphicsQueue.id);

        const Core::GpuCompiledBarrier* const acquireAndTransition = compiledPlan.findTask(consumer).prologueBarriers;
        ASSERT_NE(acquireAndTransition, nullptr);
        EXPECT_EQ(acquireAndTransition[0u].type, Core::GpuCompiledBarrierType::BufferOwnershipAcquire);
        EXPECT_EQ(acquireAndTransition[0u].resource, buffer);
        EXPECT_EQ(acquireAndTransition[0u].sourceQueue, queues[0u].id);
        EXPECT_EQ(acquireAndTransition[0u].destinationQueue, auxiliaryGraphicsQueue.id);
        EXPECT_EQ(acquireAndTransition[1u].type, Core::GpuCompiledBarrierType::BufferTransition);
    }
}

GpuGraphResourceId GpuScoringMakeResourceId(in u64 generation, in u32 index){
    GpuGraphResourceId id = GpuGraphResourceId();
    id.generation = generation;
    id.index = index;
    return id;
}

GpuGraphResourceId GpuScoringBufferId(){
    return GpuScoringMakeResourceId(1u, 0u);
}

GpuGraphResourceId GpuScoringOtherBufferId(){
    return GpuScoringMakeResourceId(1u, 1u);
}

GpuTaskGraphResourceView GpuScoringResourceView(in GpuGraphResourceId id, in GpuScoringResourceTypeEnum resourceType){
    GpuTaskGraphResourceView view = GpuTaskGraphResourceView();
    view.id = id;
    view.type = resourceType;
    return view;
}

GpuTaskResourceRange GpuScoringBufferRange(in u64 offset, in u64 size){
    GpuTaskResourceRange range = GpuTaskResourceRange();
    range.bufferRange = BufferRange(offset, size);
    return range;
}

ExpectedBufferFragment GpuScoringExpectedFragment(in usize stateIndex, in u64 offset, in u64 size){
    ExpectedBufferFragment fragment = ExpectedBufferFragment();
    fragment.stateIndex = stateIndex;
    fragment.offset = offset;
    fragment.size = size;
    return fragment;
}

void GpuScoringAppendBufferState(
    mut GpuScoringTrackedStates states,
    mut GpuScoringStateHistory history,
    in GpuGraphResourceId resource,
    in u64 offset,
    in u64 size
){
    GpuScoringTrackedState state = GpuScoringTrackedState();
    state.resource = resource;
    state.range = GpuScoringBufferRange(offset, size);
    state.task.generation = 1u;
    state.task.index = cast<u32>(states.size());
    state.state = ResourceStates::CopyDest;
    state.access = GpuTaskResourceAccess::Write;
    state.queue.index = 0u;
    state.queue.deviceGeneration = 1u;
    ASSERT_TRUE(history.append(state));
}

void GpuScoringExpectBufferFragments(
    in GpuScoringStateFragments fragments,
    in GpuScoringTrackedStates states,
    in Span<ExpectedBufferFragment> expected
){
    ASSERT_EQ(fragments.size(), expected.size());
    for(usize index = 0u; index < expected.size(); ++index){
        const ScopedTestTrace trace = ScopedTestTrace(index);
        const ExpectedBufferFragment expectedItem = expected[index];
        EXPECT_EQ(fragments[index].stateIndex, expectedItem.stateIndex);
        EXPECT_EQ(fragments[index].range.bufferRange, BufferRange(expectedItem.offset, expectedItem.size));
        if(expectedItem.stateIndex == s_GpuScoringInitialState){
            native(in fragments, in index){
                EXPECT_EQ(fragments[index].state, nullptr);
            }
        }
        else{
            ASSERT_LT(expectedItem.stateIndex, states.size());
            const usize expectedStateIndex = expectedItem.stateIndex;
            native(in fragments, in states, in index, in expectedStateIndex){
                EXPECT_EQ(fragments[index].state, &states[expectedStateIndex]);
            }
        }
    }
}

void VerifyGpuScoring_LatestPartialOverwritesKeepProducerAndFragmentOrderBeforeInitialGaps(){
    ScratchArena scratchArena = ScratchArena(s_TaskGraphScratchArena);
    GpuScoringTrackedStates states = GpuScoringTrackedStates(scratchArena);
    states.reserve(5u);
    GpuScoringStateHistory history = GpuScoringStateHistory(states, 2u, 1u, scratchArena);
    const GpuGraphResourceId buffer = GpuScoringBufferId();
    const GpuGraphResourceId otherBuffer = GpuScoringOtherBufferId();
    GpuScoringAppendBufferState(states, history, buffer, 16u, 96u);
    GpuScoringAppendBufferState(states, history, otherBuffer, 0u, 128u);
    GpuScoringAppendBufferState(states, history, buffer, 32u, 16u);
    GpuScoringAppendBufferState(states, history, buffer, 64u, 16u);
    GpuScoringAppendBufferState(states, history, otherBuffer, 16u, 16u);
    GpuScoringRequestedRanges requested = GpuScoringRequestedRanges(scratchArena);
    requested.push_back(GpuScoringBufferRange(0u, 128u));
    GpuScoringStateFragments fragments = GpuScoringStateFragments(scratchArena);
    const GpuTaskGraphResourceView resource = GpuScoringResourceView(buffer, GpuGraphResourceType::Buffer);

    ASSERT_TRUE(CollectGpuScoringLatestFragments(states, history, resource, requested, scratchArena, fragments));
    Array<ExpectedBufferFragment, 7> expected = Array<ExpectedBufferFragment, 7>();
    expected[0u] = GpuScoringExpectedFragment(0u, 16u, 16u);
    expected[1u] = GpuScoringExpectedFragment(0u, 48u, 16u);
    expected[2u] = GpuScoringExpectedFragment(0u, 80u, 32u);
    expected[3u] = GpuScoringExpectedFragment(2u, 32u, 16u);
    expected[4u] = GpuScoringExpectedFragment(3u, 64u, 16u);
    expected[5u] = GpuScoringExpectedFragment(s_GpuScoringInitialState, 0u, 16u);
    expected[6u] = GpuScoringExpectedFragment(s_GpuScoringInitialState, 112u, 16u);
    GpuScoringExpectBufferFragments(fragments, states, expected);

    ASSERT_TRUE(CollectGpuScoringTerminalFragments(states, history, resource, scratchArena, fragments));
    Array<ExpectedBufferFragment, 5> terminal = Array<ExpectedBufferFragment, 5>();
    terminal[0u] = GpuScoringExpectedFragment(0u, 16u, 16u);
    terminal[1u] = GpuScoringExpectedFragment(0u, 48u, 16u);
    terminal[2u] = GpuScoringExpectedFragment(0u, 80u, 32u);
    terminal[3u] = GpuScoringExpectedFragment(2u, 32u, 16u);
    terminal[4u] = GpuScoringExpectedFragment(3u, 64u, 16u);
    GpuScoringExpectBufferFragments(fragments, states, terminal);
}

void VerifyGpuScoring_SparseProducerIndicesRetainUnsortedRequestOrderWithinEachProducer(){
    ScratchArena scratchArena = ScratchArena(s_TaskGraphScratchArena);
    GpuScoringTrackedStates states = GpuScoringTrackedStates(scratchArena);
    states.reserve(130u);
    GpuScoringStateHistory history = GpuScoringStateHistory(states, 2u, 1u, scratchArena);
    const GpuGraphResourceId buffer = GpuScoringBufferId();
    const GpuGraphResourceId otherBuffer = GpuScoringOtherBufferId();
    GpuScoringAppendBufferState(states, history, buffer, 16u, 96u);
    for(usize index = 1u; index < 129u; ++index)
        GpuScoringAppendBufferState(states, history, otherBuffer, cast<u64>(index) * 16u, 16u);
    GpuScoringAppendBufferState(states, history, buffer, 120u, 8u);
    GpuScoringRequestedRanges requested = GpuScoringRequestedRanges(scratchArena);
    requested.reserve(6u);
    requested.push_back(GpuScoringBufferRange(80u, 8u));
    requested.push_back(GpuScoringBufferRange(16u, 8u));
    requested.push_back(GpuScoringBufferRange(120u, 8u));
    requested.push_back(GpuScoringBufferRange(48u, 8u));
    requested.push_back(GpuScoringBufferRange(144u, 8u));
    requested.push_back(GpuScoringBufferRange(0u, 8u));
    GpuScoringStateFragments fragments = GpuScoringStateFragments(scratchArena);
    const GpuTaskGraphResourceView resource = GpuScoringResourceView(buffer, GpuGraphResourceType::Buffer);

    ASSERT_TRUE(CollectGpuScoringLatestFragments(states, history, resource, requested, scratchArena, fragments));
    Array<ExpectedBufferFragment, 6> expected = Array<ExpectedBufferFragment, 6>();
    expected[0u] = GpuScoringExpectedFragment(0u, 80u, 8u);
    expected[1u] = GpuScoringExpectedFragment(0u, 16u, 8u);
    expected[2u] = GpuScoringExpectedFragment(0u, 48u, 8u);
    expected[3u] = GpuScoringExpectedFragment(129u, 120u, 8u);
    expected[4u] = GpuScoringExpectedFragment(s_GpuScoringInitialState, 144u, 8u);
    expected[5u] = GpuScoringExpectedFragment(s_GpuScoringInitialState, 0u, 8u);
    GpuScoringExpectBufferFragments(fragments, states, expected);
}

void VerifyGpuScoring_EmptyAndUntrackedRequestsClearPriorOutputAndPreserveInitialOrder(){
    ScratchArena scratchArena = ScratchArena(s_TaskGraphScratchArena);
    GpuScoringTrackedStates states = GpuScoringTrackedStates(scratchArena);
    GpuScoringStateHistory history = GpuScoringStateHistory(states, 2u, 1u, scratchArena);
    const GpuGraphResourceId buffer = GpuScoringBufferId();
    const GpuGraphResourceId otherBuffer = GpuScoringOtherBufferId();
    GpuScoringRequestedRanges requested = GpuScoringRequestedRanges(scratchArena);
    requested.reserve(2u);
    requested.push_back(GpuScoringBufferRange(64u, 8u));
    requested.push_back(GpuScoringBufferRange(0u, 8u));
    GpuScoringStateFragments fragments = GpuScoringStateFragments(scratchArena);
    const GpuTaskGraphResourceView resource = GpuScoringResourceView(buffer, GpuGraphResourceType::Buffer);

    ASSERT_TRUE(CollectGpuScoringLatestFragments(states, history, resource, requested, scratchArena, fragments));
    Array<ExpectedBufferFragment, 2> expected = Array<ExpectedBufferFragment, 2>();
    expected[0u] = GpuScoringExpectedFragment(s_GpuScoringInitialState, 64u, 8u);
    expected[1u] = GpuScoringExpectedFragment(s_GpuScoringInitialState, 0u, 8u);
    GpuScoringExpectBufferFragments(fragments, states, expected);
    GpuScoringAppendBufferState(states, history, otherBuffer, 0u, 128u);
    ASSERT_TRUE(CollectGpuScoringLatestFragments(states, history, resource, requested, scratchArena, fragments));
    GpuScoringExpectBufferFragments(fragments, states, expected);
    requested.clear();
    ASSERT_TRUE(CollectGpuScoringLatestFragments(states, history, resource, requested, scratchArena, fragments));
    EXPECT_TRUE(fragments.empty());
    ASSERT_TRUE(CollectGpuScoringTerminalFragments(states, history, resource, scratchArena, fragments));
    EXPECT_TRUE(fragments.empty());
}

void VerifyGpuScoring_SymbolicBufferTailRemainsAfterFiniteRemainderWithinOldestProducer(){
    ScratchArena scratchArena = ScratchArena(s_TaskGraphScratchArena);
    GpuScoringTrackedStates states = GpuScoringTrackedStates(scratchArena);
    states.reserve(2u);
    GpuScoringStateHistory history = GpuScoringStateHistory(states, 2u, 1u, scratchArena);
    const GpuGraphResourceId buffer = GpuScoringBufferId();
    GpuScoringAppendBufferState(states, history, buffer, 0u, s_GpuScoringAllBytes);
    GpuScoringAppendBufferState(states, history, buffer, 16u, 16u);
    GpuScoringRequestedRanges requested = GpuScoringRequestedRanges(scratchArena);
    requested.push_back(GpuScoringBufferRange(0u, s_GpuScoringAllBytes));
    GpuScoringStateFragments fragments = GpuScoringStateFragments(scratchArena);
    const GpuTaskGraphResourceView resource = GpuScoringResourceView(buffer, GpuGraphResourceType::Buffer);
    Array<ExpectedBufferFragment, 3> expected = Array<ExpectedBufferFragment, 3>();
    expected[0u] = GpuScoringExpectedFragment(0u, 0u, 16u);
    expected[1u] = GpuScoringExpectedFragment(0u, 32u, s_GpuScoringAllBytes);
    expected[2u] = GpuScoringExpectedFragment(1u, 16u, 16u);

    ASSERT_TRUE(CollectGpuScoringLatestFragments(states, history, resource, requested, scratchArena, fragments));
    GpuScoringExpectBufferFragments(fragments, states, expected);
    ASSERT_TRUE(CollectGpuScoringTerminalFragments(states, history, resource, scratchArena, fragments));
    GpuScoringExpectBufferFragments(fragments, states, expected);
}

void VerifyGpuScoring_TextureInteriorOverwritePreservesFourRemaindersInDiscoveryOrder(){
    ScratchArena scratchArena = ScratchArena(s_TaskGraphScratchArena);
    GpuScoringTrackedStates states = GpuScoringTrackedStates(scratchArena);
    states.reserve(2u);
    GpuScoringStateHistory history = GpuScoringStateHistory(states, 2u, 1u, scratchArena);
    const GpuGraphResourceId buffer = GpuScoringBufferId();
    GpuTaskResourceRange whole = GpuTaskResourceRange();
    whole.textureSubresources = TextureSubresourceSet(0u, 6u, 0u, 5u);
    GpuTaskResourceRange center = GpuTaskResourceRange();
    center.textureSubresources = TextureSubresourceSet(2u, 2u, 1u, 3u);

    GpuScoringTrackedState firstState = GpuScoringTrackedState();
    firstState.resource = buffer;
    firstState.range = whole;
    firstState.task.generation = 1u;
    firstState.task.index = 0u;
    firstState.state = ResourceStates::CopyDest;
    firstState.access = GpuTaskResourceAccess::Write;
    firstState.queue.index = 0u;
    firstState.queue.deviceGeneration = 1u;
    ASSERT_TRUE(history.append(firstState));

    GpuScoringTrackedState secondState = firstState;
    secondState.range = center;
    secondState.task.index = 1u;
    ASSERT_TRUE(history.append(secondState));

    GpuScoringRequestedRanges requested = GpuScoringRequestedRanges(scratchArena);
    requested.push_back(whole);
    GpuScoringStateFragments fragments = GpuScoringStateFragments(scratchArena);
    const GpuTaskGraphResourceView resource = GpuScoringResourceView(buffer, GpuGraphResourceType::Texture);
    Array<TextureSubresourceSet, 5> expected = Array<TextureSubresourceSet, 5>();
    expected[0u] = TextureSubresourceSet(0u, 2u, 0u, 5u);
    expected[1u] = TextureSubresourceSet(4u, 2u, 0u, 5u);
    expected[2u] = TextureSubresourceSet(2u, 2u, 0u, 1u);
    expected[3u] = TextureSubresourceSet(2u, 2u, 4u, 1u);
    expected[4u] = center.textureSubresources;

    for(usize terminal = 0u; terminal < 2u; ++terminal){
        const ScopedTestTrace trace = ScopedTestTrace(terminal);
        b8 collected = false;
        if(terminal == 0u)
            collected = CollectGpuScoringLatestFragments(states, history, resource, requested, scratchArena, fragments);
        else
            collected = CollectGpuScoringTerminalFragments(states, history, resource, scratchArena, fragments);
        ASSERT_TRUE(collected);
        ASSERT_EQ(fragments.size(), expected.size());
        for(usize index = 0u; index < expected.size(); ++index){
            const ScopedTestTrace itemTrace = ScopedTestTrace(index);
            usize stateIndex = 1u;
            if(index < 4u)
                stateIndex = 0u;
            EXPECT_EQ(fragments[index].stateIndex, stateIndex);
            native(in fragments, in states, in index, in stateIndex){
                EXPECT_EQ(fragments[index].state, &states[stateIndex]);
            }
            EXPECT_EQ(fragments[index].range.textureSubresources, expected[index]);
        }
    }
}

void VerifyGpuScoring_IndexedHistoryKeepsGlobalOrderAcrossIncrementalGrowthAndUnrelatedStates(){
    ScratchArena scratchArena = ScratchArena(s_TaskGraphScratchArena);
    GpuScoringTrackedStates states = GpuScoringTrackedStates(scratchArena);
    states.reserve(1u);
    GpuScoringStateHistory history = GpuScoringStateHistory(states, 2u, 1u, scratchArena);
    const GpuGraphResourceId buffer = GpuScoringBufferId();
    const GpuGraphResourceId otherBuffer = GpuScoringOtherBufferId();
    GpuScoringAppendBufferState(states, history, buffer, 0u, 128u);
    GpuScoringRequestedRanges requested = GpuScoringRequestedRanges(scratchArena);
    requested.push_back(GpuScoringBufferRange(0u, 128u));
    GpuScoringStateFragments fragments = GpuScoringStateFragments(scratchArena);
    const GpuTaskGraphResourceView resource = GpuScoringResourceView(buffer, GpuGraphResourceType::Buffer);
    ASSERT_TRUE(CollectGpuScoringLatestFragments(states, history, resource, requested, scratchArena, fragments));
    Array<ExpectedBufferFragment, 1> before = Array<ExpectedBufferFragment, 1>();
    before[0u] = GpuScoringExpectedFragment(0u, 0u, 128u);
    GpuScoringExpectBufferFragments(fragments, states, before);

    for(usize index = 0u; index < 257u; ++index)
        GpuScoringAppendBufferState(states, history, otherBuffer, cast<u64>(index) * 16u, 16u);
    GpuScoringAppendBufferState(states, history, buffer, 32u, 16u);
    states.reserve(states.capacity() + 1024u);
    GpuScoringAppendBufferState(states, history, otherBuffer, 0u, 8u);
    GpuScoringAppendBufferState(states, history, buffer, 80u, 16u);
    ASSERT_TRUE(history.validFor(states));
    Array<ExpectedBufferFragment, 5> after = Array<ExpectedBufferFragment, 5>();
    after[0u] = GpuScoringExpectedFragment(0u, 0u, 32u);
    after[1u] = GpuScoringExpectedFragment(0u, 48u, 32u);
    after[2u] = GpuScoringExpectedFragment(0u, 96u, 32u);
    after[3u] = GpuScoringExpectedFragment(258u, 32u, 16u);
    after[4u] = GpuScoringExpectedFragment(260u, 80u, 16u);
    ASSERT_TRUE(CollectGpuScoringLatestFragments(states, history, resource, requested, scratchArena, fragments));
    GpuScoringExpectBufferFragments(fragments, states, after);
    ASSERT_TRUE(CollectGpuScoringTerminalFragments(states, history, resource, scratchArena, fragments));
    GpuScoringExpectBufferFragments(fragments, states, after);
}

void VerifyGpuScoring_IndexedHistoryRejectsForeignGenerationAndInvalidResourcesWithoutPublication(){
    ScratchArena scratchArena = ScratchArena(s_TaskGraphScratchArena);
    GpuScoringTrackedStates states = GpuScoringTrackedStates(scratchArena);
    states.reserve(2u);
    GpuScoringStateHistory history = GpuScoringStateHistory(states, 2u, 1u, scratchArena);
    const GpuGraphResourceId buffer = GpuScoringBufferId();
    GpuScoringTrackedState state = GpuScoringTrackedState();
    state.resource = buffer;
    state.range = GpuScoringBufferRange(0u, 16u);
    state.task.generation = 1u;
    state.task.index = 0u;
    state.state = ResourceStates::CopyDest;
    state.access = GpuTaskResourceAccess::Write;
    state.queue.index = 0u;
    state.queue.deviceGeneration = 1u;
    ASSERT_TRUE(history.append(state));

    Array<GpuGraphResourceId, 3> invalidIds = Array<GpuGraphResourceId, 3>();
    invalidIds[0u] = GpuScoringMakeResourceId(2u, 0u);
    invalidIds[1u] = GpuScoringMakeResourceId(1u, 2u);
    invalidIds[2u] = GpuGraphResourceId();
    for(in GpuGraphResourceId invalid : invalidIds){
        state.resource = invalid;
        EXPECT_FALSE(history.append(state));
        EXPECT_EQ(states.size(), 1u);
        EXPECT_EQ(history.first(buffer), 0u);
        EXPECT_EQ(history.last(buffer), 0u);
        EXPECT_EQ(history.next(0u), s_GpuScoringInitialState);
    }

    GpuScoringRequestedRanges requested = GpuScoringRequestedRanges(scratchArena);
    requested.push_back(GpuScoringBufferRange(0u, 16u));
    GpuScoringStateFragments fragments = GpuScoringStateFragments(scratchArena);
    const GpuTaskGraphResourceView foreign = GpuScoringResourceView(GpuScoringMakeResourceId(0u, 2u), GpuGraphResourceType::Buffer);
    EXPECT_FALSE(CollectGpuScoringLatestFragments(states, history, foreign, requested, scratchArena, fragments));
    EXPECT_FALSE(CollectGpuScoringTerminalFragments(states, history, foreign, scratchArena, fragments));
}

void VerifyGpuScoring_IndexedHistoryRejectsMismatchedVectorAndBypassedAppend(){
    ScratchArena scratchArena = ScratchArena(s_TaskGraphScratchArena);
    GpuScoringTrackedStates states = GpuScoringTrackedStates(scratchArena);
    GpuScoringTrackedStates otherStates = GpuScoringTrackedStates(scratchArena);
    states.reserve(2u);
    otherStates.reserve(1u);
    GpuScoringStateHistory history = GpuScoringStateHistory(states, 2u, 1u, scratchArena);
    const GpuGraphResourceId buffer = GpuScoringBufferId();
    GpuScoringAppendBufferState(states, history, buffer, 0u, 16u);
    otherStates.push_back(states[0u]);
    EXPECT_FALSE(history.validFor(otherStates));
    GpuScoringRequestedRanges requested = GpuScoringRequestedRanges(scratchArena);
    requested.push_back(GpuScoringBufferRange(0u, 16u));
    GpuScoringStateFragments fragments = GpuScoringStateFragments(scratchArena);
    const GpuTaskGraphResourceView resource = GpuScoringResourceView(buffer, GpuGraphResourceType::Buffer);
    EXPECT_FALSE(CollectGpuScoringLatestFragments(otherStates, history, resource, requested, scratchArena, fragments));
    EXPECT_FALSE(CollectGpuScoringTerminalFragments(otherStates, history, resource, scratchArena, fragments));

    states.push_back(states[0u]);
    EXPECT_FALSE(history.validFor(states));
    EXPECT_FALSE(history.append(states[0u]));
    EXPECT_EQ(states.size(), 2u);
    EXPECT_FALSE(CollectGpuScoringLatestFragments(states, history, resource, requested, scratchArena, fragments));
    EXPECT_FALSE(CollectGpuScoringTerminalFragments(states, history, resource, scratchArena, fragments));
}

void VerifyGpuScoring_IndexedHistorySkipsUnrelatedInvalidRangesButStillRejectsSelectedInvalidRange(){
    ScratchArena scratchArena = ScratchArena(s_TaskGraphScratchArena);
    GpuScoringTrackedStates states = GpuScoringTrackedStates(scratchArena);
    states.reserve(2u);
    GpuScoringStateHistory history = GpuScoringStateHistory(states, 2u, 1u, scratchArena);
    const GpuGraphResourceId buffer = GpuScoringBufferId();
    const GpuGraphResourceId otherBuffer = GpuScoringOtherBufferId();
    GpuScoringAppendBufferState(states, history, buffer, 16u, 16u);
    GpuScoringAppendBufferState(states, history, otherBuffer, 0u, 0u);
    GpuScoringRequestedRanges requested = GpuScoringRequestedRanges(scratchArena);
    requested.push_back(GpuScoringBufferRange(0u, 64u));
    GpuScoringStateFragments fragments = GpuScoringStateFragments(scratchArena);
    const GpuTaskGraphResourceView resource = GpuScoringResourceView(buffer, GpuGraphResourceType::Buffer);
    Array<ExpectedBufferFragment, 3> expected = Array<ExpectedBufferFragment, 3>();
    expected[0u] = GpuScoringExpectedFragment(0u, 16u, 16u);
    expected[1u] = GpuScoringExpectedFragment(s_GpuScoringInitialState, 0u, 16u);
    expected[2u] = GpuScoringExpectedFragment(s_GpuScoringInitialState, 32u, 32u);
    ASSERT_TRUE(CollectGpuScoringLatestFragments(states, history, resource, requested, scratchArena, fragments));
    GpuScoringExpectBufferFragments(fragments, states, expected);
    Array<ExpectedBufferFragment, 1> terminal = Array<ExpectedBufferFragment, 1>();
    terminal[0u] = GpuScoringExpectedFragment(0u, 16u, 16u);
    ASSERT_TRUE(CollectGpuScoringTerminalFragments(states, history, resource, scratchArena, fragments));
    GpuScoringExpectBufferFragments(fragments, states, terminal);

    const GpuTaskGraphResourceView other = GpuScoringResourceView(otherBuffer, GpuGraphResourceType::Buffer);
    EXPECT_FALSE(CollectGpuScoringLatestFragments(states, history, other, requested, scratchArena, fragments));
    EXPECT_FALSE(CollectGpuScoringTerminalFragments(states, history, other, scratchArena, fragments));
}

void VerifyGpuScoring_LatestCoveredRangeNormalizesInactiveDimensionsAndPreservesPriorOutputOnFailure(){
    Array<GpuScoringResourceTypeEnum, 2> types = Array<GpuScoringResourceTypeEnum, 2>();
    types[0u] = GpuGraphResourceType::Buffer;
    types[1u] = GpuGraphResourceType::Texture;
    const GpuGraphResourceId buffer = GpuScoringBufferId();
    const GpuGraphResourceId otherBuffer = GpuScoringOtherBufferId();
    for(in GpuScoringResourceTypeEnum resourceType : types){
        const ScopedTestTrace trace = ScopedTestTrace(resourceType);
        ScratchArena scratchArena = ScratchArena(s_TaskGraphScratchArena);
        GpuScoringTrackedStates states = GpuScoringTrackedStates(scratchArena);
        states.reserve(3u);
        GpuScoringStateHistory history = GpuScoringStateHistory(states, 2u, 1u, scratchArena);
        GpuScoringTrackedState state = GpuScoringTrackedState();
        state.resource = buffer;
        state.task.generation = 1u;
        state.task.index = 0u;
        state.state = ResourceStates::CopyDest;
        state.access = GpuTaskResourceAccess::Write;
        state.queue.index = 0u;
        state.queue.deviceGeneration = 1u;
        ASSERT_TRUE(history.append(state));

        state.range.bufferRange = BufferRange(16u, s_GpuScoringAllBytes);
        state.range.textureSubresources = TextureSubresourceSet(1u, s_GpuScoringAllMipLevels, 2u, s_GpuScoringAllArraySlices);
        state.task.index = 1u;
        ASSERT_TRUE(history.append(state));

        state.resource = otherBuffer;
        state.task.index = 2u;
        ASSERT_TRUE(history.append(state));

        GpuScoringRequestedRanges requested = GpuScoringRequestedRanges(scratchArena);
        requested.reserve(1u);
        GpuTaskResourceRange requestedRange = GpuTaskResourceRange();
        if(resourceType == GpuGraphResourceType::Texture){
            requestedRange.textureSubresources = TextureSubresourceSet(3u, s_GpuScoringAllMipLevels, 4u, s_GpuScoringAllArraySlices);
            requestedRange.bufferRange = BufferRange(32u, 8u);
        }
        else{
            requestedRange.textureSubresources = TextureSubresourceSet(3u, 1u, 4u, 1u);
            requestedRange.bufferRange = BufferRange(32u, s_GpuScoringAllBytes);
        }
        requested.push_back(requestedRange);

        GpuScoringStateFragments fragments = GpuScoringStateFragments(scratchArena);
        fragments.reserve(2u);
        native(in states, mut fragments){
            GpuScoringStateFragment seed = GpuScoringStateFragment();
            seed.state = &states[0u];
            seed.stateIndex = 0u;
            fragments.push_back(seed);
            fragments.push_back(seed);
        }

        const GpuTaskGraphResourceView resource = GpuScoringResourceView(buffer, resourceType);
        ASSERT_TRUE(CollectGpuScoringLatestFragments(states, history, resource, requested, scratchArena, fragments));
        ASSERT_EQ(fragments.size(), 1u);
        native(in fragments, in states){
            EXPECT_EQ(fragments.front().state, &states[1u]);
        }
        EXPECT_EQ(fragments[0u].stateIndex, 1u);

        GpuTaskResourceRange expected = GpuTaskResourceRange();
        if(resourceType == GpuGraphResourceType::Texture)
            expected.textureSubresources = requested[0u].textureSubresources;
        else
            expected.bufferRange = requested[0u].bufferRange;
        EXPECT_EQ(fragments[0u].range.textureSubresources, expected.textureSubresources);
        EXPECT_EQ(fragments[0u].range.bufferRange, expected.bufferRange);

        const GpuTaskResourceRange validRequestedRange = requested[0u];
        if(resourceType == GpuGraphResourceType::Buffer)
            requested[0u].bufferRange = BufferRange(0u, 0u);
        else
            requested[0u].textureSubresources = TextureSubresourceSet(0u, 0u, 0u, 1u);
        EXPECT_FALSE(CollectGpuScoringLatestFragments(states, history, resource, requested, scratchArena, fragments));

        requested[0u] = validRequestedRange;
        states[1u].range = requested[0u];
        if(resourceType == GpuGraphResourceType::Buffer)
            states[1u].range.bufferRange = BufferRange(0u, 0u);
        else
            states[1u].range.textureSubresources = TextureSubresourceSet(0u, 0u, 0u, 1u);
        EXPECT_FALSE(CollectGpuScoringLatestFragments(states, history, resource, requested, scratchArena, fragments));
        ASSERT_EQ(fragments.size(), 1u);
        native(in fragments, in states){
            EXPECT_EQ(fragments.front().state, &states[1u]);
        }
        EXPECT_EQ(fragments[0u].stateIndex, 1u);
        EXPECT_EQ(fragments[0u].range.textureSubresources, expected.textureSubresources);
        EXPECT_EQ(fragments[0u].range.bufferRange, expected.bufferRange);
    }
}

void VerifyGpuScoring_SixtyFourBuffersPreserveExactTerminalExportSourceOrderAcrossPartialWrites(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuScoringTopology(queues);

    Array<GpuGraphResourceId, 64> buffers = Array<GpuGraphResourceId, 64>();
    Array<GpuTaskResourceUse, 64> wholeUses = Array<GpuTaskResourceUse, 64>();
    Array<GpuTaskResourceUse, 128> cutUses = Array<GpuTaskResourceUse, 128>();
    Array<GpuTaskResourceUse, 64> readUses = Array<GpuTaskResourceUse, 64>();
    for(usize index = 0u; index < s_GpuScoringFragmentBufferCount; ++index){
        const Expected<Name> identityNameResult = IndexedName(s_GpuCaseFragmentOrderBuffer, index);
        ASSERT_TRUE(identityNameResult.has_value());
        const Name identity = identityNameResult.value();

        GpuGraphResourceDesc resourceDesc = GpuGraphResourceDesc();
        resourceDesc.setIdentity(identity);
        resourceDesc.setMarkerLabel("Fragment Order Buffer");
        resourceDesc.setType(GpuGraphResourceType::Buffer);
        resourceDesc.setInitialState(ResourceStates::Common);
        resourceDesc.setExternalFinalState(ResourceStates::ShaderResource);
        resourceDesc.setExternalFinalReleaseDestinationQueue(queues[1u].id);
        const Expected<GpuGraphResourceId> gpuTaskAdmission = graph.importResource(resourceDesc);
        ASSERT_TRUE(gpuTaskAdmission.has_value());
        buffers[index] = gpuTaskAdmission.value();
        ASSERT_TRUE(buffers[index].valid());

        wholeUses[index].resource = buffers[index];
        wholeUses[index].range = GpuScoringBufferRange(0u, 128u);
        wholeUses[index].requiredState = ResourceStates::CopyDest;
        wholeUses[index].access = GpuTaskResourceAccess::Write;

        cutUses[index * 2u].resource = buffers[index];
        cutUses[index * 2u].range = GpuScoringBufferRange(32u, 16u);
        cutUses[index * 2u].requiredState = ResourceStates::UnorderedAccess;
        cutUses[index * 2u].access = GpuTaskResourceAccess::Write;

        cutUses[index * 2u + 1u] = cutUses[index * 2u];
        cutUses[index * 2u + 1u].range = GpuScoringBufferRange(64u, 16u);

        readUses[index].resource = buffers[index];
        readUses[index].range = GpuScoringBufferRange(48u, 16u);
        readUses[index].requiredState = ResourceStates::ShaderResource;
        readUses[index].access = GpuTaskResourceAccess::Read;
    }

    GpuTaskCommandRequirements commands = GpuTaskCommandRequirements();
    commands.requiredCapabilities = GpuQueueCapability::Graphics;

    GpuTaskDesc wholeDesc = GpuTaskDesc();
    wholeDesc.setIdentity(s_GpuCaseFragmentOrderWhole);
    wholeDesc.setMarkerLabel("Whole Writer");
    wholeDesc.setResourceUses(wholeUses);
    const Expected<GpuTaskId> wholeResult = graph.addTask(wholeDesc, commands);
    ASSERT_TRUE(wholeResult.has_value());
    const GpuTaskId whole = wholeResult.value();
    ASSERT_TRUE(whole.valid());

    Array<GpuTaskId, 1> wholeDeps = Array<GpuTaskId, 1>();
    wholeDeps[0u] = whole;
    GpuTaskDesc cutsDesc = GpuTaskDesc();
    cutsDesc.setIdentity(s_GpuCaseFragmentOrderCuts);
    cutsDesc.setMarkerLabel("Partial Writers");
    cutsDesc.setDependencies(wholeDeps);
    cutsDesc.setResourceUses(cutUses);
    const Expected<GpuTaskId> cutsResult = graph.addTask(cutsDesc, commands);
    ASSERT_TRUE(cutsResult.has_value());
    const GpuTaskId cuts = cutsResult.value();
    ASSERT_TRUE(cuts.valid());

    Array<GpuTaskId, 1> cutsDeps = Array<GpuTaskId, 1>();
    cutsDeps[0u] = cuts;
    GpuTaskDesc readerDesc = GpuTaskDesc();
    readerDesc.setIdentity(s_GpuCaseFragmentOrderReader);
    readerDesc.setMarkerLabel("Gap Reader");
    readerDesc.setDependencies(cutsDeps);
    readerDesc.setResourceUses(readUses);
    const Expected<GpuTaskId> readerResult = graph.addTask(readerDesc, commands);
    ASSERT_TRUE(readerResult.has_value());
    const GpuTaskId reader = readerResult.value();
    ASSERT_TRUE(reader.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuScoringCompiledGraphReadView plan = GpuScoringCompiledGraphReadView(compiledGraph);

    Array<GpuTaskId, 5> expectedTasks = Array<GpuTaskId, 5>();
    expectedTasks[0u] = whole;
    expectedTasks[1u] = whole;
    expectedTasks[2u] = cuts;
    expectedTasks[3u] = cuts;
    expectedTasks[4u] = reader;

    Array<BufferRange, 5> expectedRanges = Array<BufferRange, 5>();
    expectedRanges[0u] = BufferRange(0u, 32u);
    expectedRanges[1u] = BufferRange(80u, 48u);
    expectedRanges[2u] = BufferRange(32u, 16u);
    expectedRanges[3u] = BufferRange(64u, 16u);
    expectedRanges[4u] = BufferRange(48u, 16u);

    for(usize index = 0u; index < s_GpuScoringFragmentBufferCount; ++index){
        const ScopedTestTrace trace = ScopedTestTrace(index);
        const GpuGraphResourceId bufferId = buffers[index];
        native(in plan, in bufferId, in queues, in expectedTasks, in expectedRanges){
            const Core::GpuCompiledExternalResourceExportView exported = plan.externalResourceExport(bufferId);
            ASSERT_NE(exported.plan, nullptr);
            ASSERT_NE(exported.sources, nullptr);
            EXPECT_EQ(exported.plan->finalState, Core::ResourceStates::ShaderResource);
            EXPECT_EQ(exported.plan->destinationQueue, queues[1u].id);
            ASSERT_EQ(exported.plan->sourceCount, expectedTasks.size());
            for(usize sourceIndex = 0u; sourceIndex < expectedTasks.size(); ++sourceIndex){
                SCOPED_TRACE(sourceIndex);
                EXPECT_EQ(exported.sources[sourceIndex].producerTask, expectedTasks[sourceIndex]);
                EXPECT_EQ(exported.sources[sourceIndex].sourceQueue, queues[0u].id);
                EXPECT_EQ(exported.sources[sourceIndex].range.bufferRange, expectedRanges[sourceIndex]);
            }
        }
    }
}


