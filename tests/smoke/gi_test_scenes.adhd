    outBoxes[12u] = ComplexSceneBox(VectorSingle(1.80f, 0.48f, -1.82f, 0.0f), VectorSingle(0.18f, 0.96f, 0.56f, 0.0f), red, 0.0f);
    outBoxes[13u] = ComplexSceneBox(VectorSingle(-0.85f, 0.23f, -1.30f, 0.0f), VectorSingle(0.70f, 0.46f, 0.60f, 0.0f), white, 0.0f);
    outBoxes[14u] = ComplexSceneBox(VectorSingle(0.95f, 0.32f, -1.45f, 0.0f), VectorSingle(0.60f, 0.64f, 0.65f, 0.0f), white, 0.0f);
    outBoxes[15u] = ComplexSceneBox(VectorSingle(0.00f, 0.20f, 0.35f, 0.0f), VectorSingle(0.52f, 0.40f, 0.50f, 0.0f), white, 0.0f);

    outBoxes[16u] = ComplexSceneBox(VectorSingle(-1.30f, 0.65f, -0.75f, 0.0f), VectorSingle(0.10f, 1.30f, 1.00f, 0.0f), white, 55.0f, true);
