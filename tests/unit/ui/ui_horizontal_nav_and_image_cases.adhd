void VerifyHorizontalNavigationFixture_DisabledClippedOrOmittedHostCannotResumeItsPreviousHorizontalHold(mut HorizontalNavigationFixture self){
    const HitTarget original = self.m_targets[0u];
    for(usize variant = 0u; variant < 3u; ++variant){
        self.m_targets[0u] = original;
        ASSERT_TRUE(self.publish(1u));
        self.focusTarget();
        EXPECT_TRUE(self.keyDown(CoreKey::Left).commandConsumed);
        ASSERT_EQ(self.m_router.controlActions().size(), 1u);
        usize publishCount = 1u;
        if(variant == 0u)
            self.m_targets[0u].enabled = false;
        else if(variant == 1u)
            self.m_targets[0u].clip = MakeUiHorizImageRect(200.0f, 0.0f, 10.0f, 100.0f);
        else
            publishCount = 0u;
        ASSERT_TRUE(self.publish(publishCount));
        EXPECT_FALSE(self.m_router.focus().valid());
        EXPECT_TRUE(self.m_router.controlActions().empty());
        self.m_targets[0u] = original;
        ASSERT_TRUE(self.publish(1u));
        self.focusTarget();
        EXPECT_TRUE(self.keyDown(CoreKey::Left, true).commandConsumed);
        EXPECT_TRUE(self.m_router.controlActions().empty());
        EXPECT_TRUE(self.keyUp(CoreKey::Left).commandConsumed);
        self.press(CoreKey::Left);
        const Expected<ControlAction> actionResult = self.take();
        ASSERT_TRUE(actionResult.has_value());
        EXPECT_EQ(actionResult.value().kind, ControlActionKind::Left);
    }
}

void VerifyHorizontalNavigationFixture_ClosingAndReopeningPopupRequiresFreshHorizontalPress(mut HorizontalNavigationFixture self){
    PopupScope popup = MakeUiHorizontalNavPopup(self.m_targets[0u]);
    self.m_targets[0u].popup = popup.token;
    self.m_targets[0u].layer = popup.layer;
    ASSERT_TRUE(self.publish(1u, MakeUiHorizNavSinglePopup(popup)));
    self.focusTarget();
    EXPECT_TRUE(self.keyDown(CoreKey::Right).commandConsumed);
    ASSERT_EQ(self.m_router.controlActions().size(), 1u);
    self.m_router.closePopup(popup.token);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_FALSE(self.m_router.focus().valid());
    ASSERT_TRUE(self.publish(1u, MakeUiHorizNavSinglePopup(popup)));
    EXPECT_FALSE(self.m_router.focus().valid());
    ++popup.token.openGeneration;
    self.m_targets[0u].popup = popup.token;
    ASSERT_TRUE(self.publish(1u, MakeUiHorizNavSinglePopup(popup)));
    self.focusTarget();
    EXPECT_TRUE(self.keyDown(CoreKey::Right, true).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.keyUp(CoreKey::Right).commandConsumed);
    self.press(CoreKey::Right);
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_EQ(actionResult.value().kind, ControlActionKind::Right);
    EXPECT_EQ(actionResult.value().popup, popup.token);
}

void VerifyHorizontalNavigationFixture_PopupMaskCannotRedirectOrReviveLowerHostHorizontalHold(mut HorizontalNavigationFixture self){
    ASSERT_TRUE(self.publish());
    self.focusTarget();
    EXPECT_TRUE(self.keyDown(CoreKey::Left).commandConsumed);
    const PopupScope popup = MakeUiHorizontalNavPopup(self.m_targets[1u]);
    self.m_targets[1u].popup = popup.token;
    self.m_targets[1u].layer = popup.layer;
    ASSERT_TRUE(self.publish(2u, MakeUiHorizNavSinglePopup(popup)));
    EXPECT_TRUE(self.m_router.controlActions().empty());
    self.focusTarget(1u);
    EXPECT_TRUE(self.keyDown(CoreKey::Left, true).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    self.m_targets[1u].popup = PopupToken();
    self.m_targets[1u].layer = 0u;
    ASSERT_TRUE(self.publish());
    self.focusTarget();
    EXPECT_TRUE(self.keyDown(CoreKey::Left, true).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.keyUp(CoreKey::Left).commandConsumed);
    self.press(CoreKey::Left);
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_EQ(actionResult.value().kind, ControlActionKind::Left);
    EXPECT_TRUE(actionResult.value().popup.empty());
}

void VerifyHorizontalNavigationFixture_PreservedTextFenceClearsHorizontalCapabilityAndRetainsMainCapture(mut HorizontalNavigationFixture self){
    self.m_targets[0u].textEditable = true;
    self.m_targets[0u].scrollable = true;
    ASSERT_TRUE(self.publish(1u));
    InputEvent primaryDown = InputEvent();
    primaryDown.type = InputEventType::PrimaryDown;
    primaryDown.position.x = 10.0f;
    primaryDown.position.y = 10.0f;
    EXPECT_TRUE(self.send(primaryDown).pointerConsumed);
    EXPECT_TRUE(self.keyDown(CoreKey::Left).commandConsumed);
    ASSERT_EQ(self.m_router.controlActions().size(), 1u);
    self.m_router.fenceControl(self.m_targets[0u].id, self.m_targets[0u].declarationGeneration, self.m_targets[0u].control);
    EXPECT_TRUE(self.m_router.targets()[0u].horizontalNavigation);
    EXPECT_EQ(self.m_router.controlActions().size(), 1u);
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
    ++self.m_targets[0u].control.contentRevision;
    self.m_router.fenceControl(self.m_targets[0u].id, self.m_targets[0u].declarationGeneration, self.m_targets[0u].control);
    ASSERT_EQ(self.m_router.targets().size(), 1u);
    EXPECT_FALSE(self.m_router.targets()[0u].horizontalNavigation);
    EXPECT_FALSE(self.m_router.targets()[0u].navigable);
    EXPECT_TRUE(self.m_router.targets()[0u].enabled);
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    ++self.m_targets[0u].control.contentRevision;
    self.m_router.fenceControl(self.m_targets[0u].id, self.m_targets[0u].declarationGeneration, self.m_targets[0u].control);
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
    EXPECT_FALSE(self.m_router.targets()[0u].horizontalNavigation);
    ASSERT_TRUE(self.publish(1u));
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
    EXPECT_TRUE(self.keyDown(CoreKey::Left, true).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.keyUp(CoreKey::Left).commandConsumed);
    self.press(CoreKey::Right);
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_EQ(actionResult.value().kind, ControlActionKind::Right);
    EXPECT_EQ(actionResult.value().control, self.m_targets[0u].control);
    InputEvent primaryUp = InputEvent();
    primaryUp.type = InputEventType::PrimaryUp;
    primaryUp.position.x = 10.0f;
    primaryUp.position.y = 10.0f;
    EXPECT_TRUE(self.send(primaryUp).pointerConsumed);
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
}

void VerifyHorizontalNavigationFixture_HeldHorizontalNavigationRepeatsWhileSubmitIsOneShotInSequence(mut HorizontalNavigationFixture self){
    ASSERT_TRUE(self.publish());
    self.focusTarget();
    EXPECT_TRUE(self.keyDown(CoreKey::Left).commandConsumed);
    EXPECT_TRUE(self.keyDown(CoreKey::Left, true).commandConsumed);
    EXPECT_TRUE(self.keyDown(CoreKey::Enter).commandConsumed);
    EXPECT_TRUE(self.keyDown(CoreKey::Enter, true).commandConsumed);
    EXPECT_TRUE(self.keyUp(CoreKey::Enter).commandConsumed);
    EXPECT_TRUE(self.keyUp(CoreKey::Left).commandConsumed);
    Array<ControlActionKindEnum, 3u> kinds = Array<ControlActionKindEnum, 3u>();
    kinds[0u] = ControlActionKind::Left;
    kinds[1u] = ControlActionKind::Left;
    kinds[2u] = ControlActionKind::Submit;
    ASSERT_EQ(self.m_router.controlActions().size(), kinds.size());
    u64 previous = 0u;
    for(in ControlActionKindEnum kind : kinds){
        const Expected<ControlAction> actionResult = self.take();
        ASSERT_TRUE(actionResult.has_value());
        EXPECT_EQ(actionResult.value().kind, kind);
        EXPECT_GT(actionResult.value().id.sequence, previous);
        previous = actionResult.value().id.sequence;
    }
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.m_router.actions().empty());
}

void VerifyHorizontalNavigationFixture_VerticalOnlyNavigableHostKeepsHorizontalKeysLocalAndVerticalKeysActive(mut HorizontalNavigationFixture self){
    HitTarget host = HitTarget();
    host.id = self.m_targets[0u].id;
    host.declarationGeneration = self.m_targets[0u].declarationGeneration;
    host.rectangle = self.m_targets[0u].rectangle;
    host.clip = self.m_targets[0u].clip;
    host.focusable = true;
    host.control = self.m_targets[0u].control;
    host.navigable = true;
    self.m_targets[0u] = host;
    ASSERT_TRUE(self.publish(1u));
    self.focusTarget();
    self.press(CoreKey::Left);
    self.press(CoreKey::Right);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    self.press(CoreKey::Up);
    self.press(CoreKey::Down);
    const Expected<ControlAction> actionResult1 = self.take();
    ASSERT_TRUE(actionResult1.has_value());
    EXPECT_EQ(actionResult1.value().kind, ControlActionKind::Up);
    const Expected<ControlAction> actionResult2 = self.take();
    ASSERT_TRUE(actionResult2.has_value());
    EXPECT_EQ(actionResult2.value().kind, ControlActionKind::Down);
    EXPECT_FALSE(self.take().has_value());
}

void VerifyHorizontalNavigationFixture_CapabilityUsesAcceptedCopiedTargetsUntilSuccessfulPublication(mut HorizontalNavigationFixture self){
    ASSERT_TRUE(self.publish());
    self.focusTarget();
    self.m_targets[0u].horizontalNavigation = false;
    self.press(CoreKey::Left);
    ASSERT_EQ(self.m_router.controlActions().size(), 1u);
    EXPECT_TRUE(self.m_router.targets()[0u].horizontalNavigation);
    const u64 sequence = self.m_router.controlActions()[0u].id.sequence;
    ASSERT_TRUE(self.publish());
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    self.press(CoreKey::Right);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    self.m_targets[0u].horizontalNavigation = true;
    ASSERT_TRUE(self.publish());
    self.press(CoreKey::Right);
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_EQ(actionResult.value().kind, ControlActionKind::Right);
    EXPECT_EQ(actionResult.value().id.layoutGeneration, 3u);
    EXPECT_GT(actionResult.value().id.sequence, sequence);
}

void VerifyHorizontalNavigationFixture_DelegatedEditorKeepsCaretKeysLocalToAvoidMovingTheOwner(mut HorizontalNavigationFixture self){
    self.bindEditor();
    ASSERT_TRUE(self.publish(3u));
    self.focusTarget(2u);
    Array<CoreKeyEnum, 6u> localKeys = Array<CoreKeyEnum, 6u>();
    localKeys[0u] = CoreKey::Left;
    localKeys[1u] = CoreKey::Right;
    localKeys[2u] = CoreKey::Home;
    localKeys[3u] = CoreKey::End;
    localKeys[4u] = CoreKey::Space;
    localKeys[5u] = CoreKey::Backspace;
    for(in CoreKeyEnum key : localKeys){
        self.press(key);
        EXPECT_TRUE(self.m_router.controlActions().empty());
    }
    EXPECT_TRUE(self.keyDown(CoreKey::Left).commandConsumed);
    EXPECT_TRUE(self.keyDown(CoreKey::Left, true).commandConsumed);
    EXPECT_TRUE(self.m_router.ownsKey(CoreKey::Left));
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.keyUp(CoreKey::Left).commandConsumed);
    self.press(CoreKey::Down);
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_EQ(actionResult.value().kind, ControlActionKind::Down);
    EXPECT_EQ(actionResult.value().id.target, self.m_targets[0u].id);
    EXPECT_EQ(actionResult.value().source, self.m_targets[2u].id);
    EXPECT_EQ(self.m_router.focus(), self.m_targets[2u].id);
    EXPECT_TRUE(self.m_router.actions().empty());
}

void VerifyHorizontalNavigationFixture_InvalidHorizontalHostPublicationPreservesAcceptedFocusAndHeldAction(mut HorizontalNavigationFixture self){
    ASSERT_TRUE(self.publish());
    self.focusTarget();
    EXPECT_TRUE(self.keyDown(CoreKey::Right).commandConsumed);
    const HitTarget accepted = self.m_targets[0u];
    for(usize variant = 0u; variant < 4u; ++variant){
        self.m_targets[0u] = accepted;
        if(variant == 0u)
            self.m_targets[0u].navigable = false;
        else if(variant == 1u)
            self.m_targets[0u].focusable = false;
        else if(variant == 2u)
            self.m_targets[0u].control = ControlToken();
        else{
            self.m_targets[0u].owner = self.m_targets[1u].id;
            self.m_targets[0u].ownerDeclarationGeneration = self.m_targets[1u].declarationGeneration;
        }
        EXPECT_FALSE(self.publish());
        EXPECT_EQ(self.m_router.layoutGeneration(), 1u);
        EXPECT_EQ(self.m_router.focus(), accepted.id);
        ASSERT_EQ(self.m_router.controlActions().size(), 1u);
        EXPECT_TRUE(self.m_router.targets()[0u].horizontalNavigation);
        EXPECT_TRUE(self.m_router.ownsKey(CoreKey::Right));
    }
    self.m_targets[0u] = accepted;
    const Expected<ControlAction> actionResult1 = self.take();
    ASSERT_TRUE(actionResult1.has_value());
    EXPECT_EQ(actionResult1.value().kind, ControlActionKind::Right);
    EXPECT_EQ(actionResult1.value().control, accepted.control);
    EXPECT_TRUE(self.keyDown(CoreKey::Right, true).commandConsumed);
    const Expected<ControlAction> actionResult2 = self.take();
    ASSERT_TRUE(actionResult2.has_value());
    EXPECT_EQ(actionResult2.value().kind, ControlActionKind::Right);
    EXPECT_TRUE(self.keyUp(CoreKey::Right).commandConsumed);
}

void VerifyHorizontalNavigationFixture_OwnedPartsRejectHorizontalCapabilityWithoutReplacingAcceptedActions(mut HorizontalNavigationFixture self){
    ASSERT_TRUE(self.publish());
    self.focusTarget();
    self.press(CoreKey::Right);
    self.m_targets[2u] = MakeUiHorizontalNavPart(self.m_targets[0u]);
    self.m_targets[2u].horizontalNavigation = true;
    EXPECT_FALSE(self.publish(3u));
    EXPECT_EQ(self.m_router.layoutGeneration(), 1u);
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    ASSERT_EQ(self.m_router.controlActions().size(), 1u);
    self.m_targets[2u].horizontalNavigation = false;
    ASSERT_TRUE(self.publish(3u));
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_EQ(actionResult.value().kind, ControlActionKind::Right);
}


