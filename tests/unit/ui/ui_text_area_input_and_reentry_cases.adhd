void VerifyUiTextAreaNavigationTests_IdenticalAcceptedScrollIntentRetiresTheResolver(mut UiTextAreaNavigationTests self){
    ASSERT_TRUE(self.m_model.setText("MM\nMM"));
    TextAreaNavigationResolver resolver = TextAreaNavigationResolver(self.m_arena, self.m_text, self.m_context, self.m_state, 14.0f);
    const EditNavigationSnapshot preferred = self.m_state.navigation().snapshot();
    ASSERT_TRUE(self.m_state.scrollTo(Point(0.0f, 0.0f)));
    EXPECT_TRUE(self.m_state.navigation().matches(preferred));
    EXPECT_FALSE(resolver.resolve(self.m_model, EditNavigationDirection::Down, preferred, 160.0f).has_value());
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 0.0f);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
}

void VerifyUiTextAreaNavigationTests_ScrollAwayAndBackCannotReviveTheResolver(mut UiTextAreaNavigationTests self){
