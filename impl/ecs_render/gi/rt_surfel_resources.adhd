class SurfelGiCounterReadbackBuilder final : NoCopy{
public:
    SurfelGiCounterReadbackBuilder(Core::GpuTaskGraph& graph, RendererRayTracingSystem& raytracingSystem)noexcept
        : m_graph(graph)
        , m_raytracingSystem(raytracingSystem)
    {}


public:
    void declare(const RayTracingSurfelPersistentResourceSnapshot& rayTracingSurfelResources, Core::GpuTaskId surfelTask, Core::GpuTaskId timingEndTask, Core::GpuTaskId& outTask);


private:
    Core::GpuTaskGraph& m_graph;
    RendererRayTracingSystem& m_raytracingSystem;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererRayTracingSystem;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Declares the surfel GI phase tasks; every payload borrows the ray-tracing system and the frame targets until the packet accepts.
class SurfelGiTaskBuilder final : NoCopy{
public:
    SurfelGiTaskBuilder(RendererRayTracingSystem& system, Core::GpuTaskGraph& graph)noexcept
        : m_system(system)
        , m_graph(graph)
    {}


public:
    [[nodiscard]] Expected<Core::GpuTaskId> declareAgeFreeTask(
        const Core::GpuTaskDesc& desc,
        const DeferredLightingGraphResources& deferredLightingResources,
        DeferredFrameTargets& targets,
        Core::GpuTimingSubmissionTicket& timingTicket,
        Optional<Core::GpuTimingMeasure>& asyncTiming
    );
    [[nodiscard]] Expected<Core::GpuTaskId> declareHashBuildTask(
        const Core::GpuTaskDesc& desc,
        const DeferredLightingGraphResources& deferredLightingResources,
        DeferredFrameTargets& targets,
        Core::GpuTimingSubmissionTicket& timingTicket,
        Optional<Core::GpuTimingMeasure>& asyncTiming
    );
    [[nodiscard]] Expected<Core::GpuTaskId> declareSpawnTask(
        const Core::GpuTaskDesc& desc,
        const DeferredLightingGraphResources& deferredLightingResources,
        DeferredFrameTargets& targets,
        Core::GpuTimingSubmissionTicket& timingTicket,
        Optional<Core::GpuTimingMeasure>& asyncTiming
    );
    [[nodiscard]] Expected<Core::GpuTaskId> declareTraceBuildArgsTask(
        const Core::GpuTaskDesc& desc,
        const DeferredLightingGraphResources& deferredLightingResources,
        DeferredFrameTargets& targets,
        Core::GpuTimingSubmissionTicket& timingTicket,
        Optional<Core::GpuTimingMeasure>& asyncTiming
    );
    [[nodiscard]] Expected<Core::GpuTaskId> declareTraceTask(
        const Core::GpuTaskDesc& desc,
        const DeferredLightingGraphResources& deferredLightingResources,
        DeferredFrameTargets& targets,
        Core::GpuTimingSubmissionTicket& timingTicket,
        Optional<Core::GpuTimingMeasure>& asyncTiming
    );
    [[nodiscard]] Expected<Core::GpuTaskId> declareResolveTask(
        const Core::GpuTaskDesc& desc,
        const DeferredLightingGraphResources& deferredLightingResources,
        DeferredFrameTargets& targets,
        Core::GpuTimingSubmissionTicket& timingTicket,
        Optional<Core::GpuTimingMeasure>& asyncTiming
    );
    // Records the phases the split route left over; only the resolve-owning route brackets the shared async range.
    [[nodiscard]] Expected<Core::GpuTaskId> declareTerminalTask(
        const Core::GpuTaskDesc& desc,
        const DeferredLightingGraphResources& deferredLightingResources,
        DeferredFrameTargets& targets,
        Core::GpuTimingSubmissionTicket& timingTicket,
        Optional<Core::GpuTimingMeasure>* asyncTiming
    );


private:
    RendererRayTracingSystem& m_system;
    Core::GpuTaskGraph& m_graph;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererShaderSystem;
struct RtSurfelGiState;


class SurfelGiPipelineSet final : NoCopy{
public:
    SurfelGiPipelineSet(Core::Alloc::GlobalArena& arena, Core::GraphicsRuntime& graphics, RendererShaderSystem& shaderSystem, RtSurfelGiState& state)noexcept
        : m_arena(arena)
        , m_graphics(graphics)
        , m_shaderSystem(shaderSystem)
        , m_rayTracingState(state)
    {}


public:
    [[nodiscard]] b8 ensureSurfelSpawnPipeline();
    [[nodiscard]] b8 ensureSurfelAgeFreePipeline();
    [[nodiscard]] b8 ensureSurfelHashBuildPipeline();
    [[nodiscard]] b8 ensureSurfelTracePipeline();
    // Hardware surfel trace uses inline RayQuery over the TLAS.
    [[nodiscard]] b8 ensureSurfelTraceHwPipeline();
    // Resolve keeps the writable surfel pool off deferred lighting.
    [[nodiscard]] b8 ensureSurfelResolvePipeline();
    [[nodiscard]] b8 ensureSurfelUpsamplePipeline();
    [[nodiscard]] b8 ensureSurfelTraceBuildArgsPipeline();


private:
    Core::Alloc::GlobalArena& m_arena;
    Core::GraphicsRuntime& m_graphics;
    RendererShaderSystem& m_shaderSystem;
    RtSurfelGiState& m_rayTracingState;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 SurfelGiGraphCoordinator::declareDeferredSurfelGiTask(
    const SurfelGiGraphContext& context,
    const DeferredLightingGraphResources& deferredLightingResources,
    const RayTracingDeferredGraphResourceSnapshot& rayTracingResources,
    const RayTracingSurfelPersistentResourceSnapshot& rayTracingSurfelResources,
    const Core::GpuGraphResourceId worldPosition,
    const Core::GpuGraphResourceId normal,
    const Core::GpuGraphResourceId surfelIrradiance,
    const Core::GpuGraphResourceId currentBindlessSlots,
    const Core::GpuGraphResourceId sceneShading,
    const Core::GpuGraphResourceId lights,
    const Core::GpuGraphResourceId materialContextSlots,
    const Span<const Core::GpuGraphResourceId> traceGeometryResources,
    const Core::GpuGraphResourceSetId traceGeometrySet,
    const Core::GpuGraphResourceSetId traceMaterialSampledTextureSet,
    const Core::GpuTaskId effectsTask,
    const b8 useLaggedLightingHistory,
    const Core::GpuExternalCompletionId surfelCounterReadbackCompletion,
    Core::Alloc::ScratchArena& scratchArena,
    DeferredFrameTargets& deferredTargets,
    Core::GpuTimingSubmissionTicket& timingTicket,
    Optional<Core::GpuTimingMeasure>& asyncTiming
){
    using namespace RendererTaskGraphDetail;

    SurfelGiTaskBuilder surfelGiTasks(context.rayTracing, context.graph);
    m_deferredSurfelGiPreparationTask = {};
    m_deferredSurfelGiInitializationLifecycleTask = {};
    m_deferredSurfelGiSnapshotCopyTask = {};
    m_deferredSurfelGiIrradianceClearTask = {};
    m_deferredSurfelGiAgeFreeTask = {};
    m_deferredSurfelGiCellHeadClearTask = {};
    m_deferredSurfelGiHashBuildTask = {};
    m_deferredSurfelGiSpawnTask = {};
    m_deferredSurfelGiTraceBuildArgsTask = {};
    m_deferredSurfelGiTraceTask = {};
    m_deferredSurfelGiResolveTask = {};
    asyncTiming.reset();
    m_deferredSurfelGiTask = {};
    m_deferredSurfelGiCounterReadbackTask = {};
    if(!deferredTargets.valid() || !deferredTargets.bindless.valid() || !worldPosition.valid() || !normal.valid() || !surfelIrradiance.valid() || !currentBindlessSlots.valid() || !sceneShading.valid() || !lights.valid() || !effectsTask.valid())
        return false;

    const b8 useHwTrace = rayTracingResources.surfelUsesHardwareTrace;
    const b8 hasSurfelWork = context.rayTracing.hasSurfelWork();
    const b8 traceGeometryStatesGraphOwned = traceGeometrySet.valid();
    const RendererFramePipelineDetail::TraceResourceSetUses traceResourceSets = RendererFramePipelineDetail::MakeTraceResourceSetUses(traceGeometrySet, traceMaterialSampledTextureSet);

    const Core::GpuTaskExternalStateSource surfelGiComputeStateSource{ .states = context.computeState.source(), };
    const Core::GpuTaskExternalStateSource surfelGiCounterStateSource{ .states = context.counterState.source(), };
    const Core::GpuTaskExternalStateSource surfelIrradianceReturnStateSource{ .states = context.irradianceReturnState.source(), .applicableConsumerQueueClass = Core::CommandQueue::Compute, };
    struct SurfelGiTaskStateSourceSet{
        Array<Core::GpuTaskExternalStateSource, s_SurfelGiStateSourceCapacity> values{};
        usize count = 0u;
    };
    const auto makeSurfelGiTaskStateSources = [&](const b8 includeCompute, const b8 includeCounter, const b8 includeIrradianceReturn)noexcept{
        SurfelGiTaskStateSourceSet result;
        if(includeCompute && surfelGiComputeStateSource.states){
            result.values[result.count] = surfelGiComputeStateSource;
            ++result.count;
        }
        if(includeCounter && surfelGiCounterStateSource.states){
            result.values[result.count] = surfelGiCounterStateSource;
            ++result.count;
        }
        if(includeIrradianceReturn && surfelIrradianceReturnStateSource.states){
            result.values[result.count] = surfelIrradianceReturnStateSource;
            ++result.count;
        }
        return result;
    };
    const SurfelGiTaskStateSourceSet surfelGiComputeCounterStateSources = makeSurfelGiTaskStateSources(true, true, false);
    const SurfelGiTaskStateSourceSet surfelGiComputeReturnStateSources = makeSurfelGiTaskStateSources(true, false, true);
    const SurfelGiTaskStateSourceSet surfelGiAllStateSources = makeSurfelGiTaskStateSources(true, true, true);

    SurfelGiResourcePlan surfelGiResourcePlan(scratchArena);
    const SurfelGiResourceInputs surfelGiResourceInputs{
        deferredTargets, rayTracingResources, rayTracingSurfelResources,
        worldPosition, normal, surfelIrradiance, currentBindlessSlots, sceneShading, lights, materialContextSlots,
        traceGeometryResources, traceGeometryStatesGraphOwned, useHwTrace, hasSurfelWork
    };
    SurfelGiResourceBuilder surfelGiResourceBuilder(context.graph, context.rayTracing);
    if(!surfelGiResourceBuilder.prepare(surfelGiResourceInputs, surfelGiResourcePlan))
        return false;
    const auto& surfelIrradianceHalf = surfelGiResourcePlan.surfelIrradianceHalf;
    const auto& csgTraceContext = surfelGiResourcePlan.csgTraceContext;
    const auto& surfelConstants = surfelGiResourcePlan.surfelConstants;
    const auto& surfelPool = surfelGiResourcePlan.surfelPool;
    const auto& surfelGuidePool = surfelGiResourcePlan.surfelGuidePool;
    const auto& surfelCellHead = surfelGiResourcePlan.surfelCellHead;
    const auto& surfelCounter = surfelGiResourcePlan.surfelCounter;
    const auto& surfelTraceIndirectArgs = surfelGiResourcePlan.surfelTraceIndirectArgs;
    const auto& surfelFreeList = surfelGiResourcePlan.surfelFreeList;
    const auto& surfelPoolSnapshot = surfelGiResourcePlan.surfelPoolSnapshot;
    const auto& surfelCellHeadSnapshot = surfelGiResourcePlan.surfelCellHeadSnapshot;
    const auto& graphOwnsSurfelGiResolve = surfelGiResourcePlan.graphOwnsSurfelGiResolve;
    const auto& resourceUses = surfelGiResourcePlan.resourceUses;
    const auto& traceResourceUses = surfelGiResourcePlan.traceResourceUses;

    Core::GpuTaskSchedulingHint scheduling;
    scheduling.cost = Core::GpuTaskCostHint::Large;
    // Live Lighting joins both effects; lagged Lighting retains their independent publication boundaries.
    scheduling.forceSubmissionBoundary = useLaggedLightingHistory;
    scheduling.allowPacketMerge = !useLaggedLightingHistory;
    scheduling.mergeWithPrevious = !useLaggedLightingHistory;
    scheduling.allowMergeAcrossConsumerFrontier = !useLaggedLightingHistory;
    const Core::GpuExternalCompletionId* const surfelGiExternalDependencies = surfelCounterReadbackCompletion.valid() ? &surfelCounterReadbackCompletion : nullptr;
    const usize surfelGiExternalDependencyCount = surfelCounterReadbackCompletion.valid() ? 1u : 0u;

    SurfelGiLifecycleBuilder surfelGiLifecycleBuilder(context.graph, context.rayTracing);
    SurfelGiLifecycleInputs surfelGiLifecycleInputs;
    surfelGiLifecycleInputs.targets = &deferredTargets;
    surfelGiLifecycleInputs.dependency = effectsTask;
    surfelGiLifecycleInputs.surfelPool = surfelPool;
    surfelGiLifecycleInputs.surfelCellHead = surfelCellHead;
    surfelGiLifecycleInputs.surfelCounter = surfelCounter;
    surfelGiLifecycleInputs.surfelFreeList = surfelFreeList;
    surfelGiLifecycleInputs.surfelPoolSnapshot = surfelPoolSnapshot;
    surfelGiLifecycleInputs.surfelCellHeadSnapshot = surfelCellHeadSnapshot;
    surfelGiLifecycleInputs.poolSnapshotByteSize = rayTracingSurfelResources.poolBuffer->getCreationDescription().byteSize;
    surfelGiLifecycleInputs.cellHeadSnapshotByteSize = rayTracingSurfelResources.cellHeadBuffer->getCreationDescription().byteSize;
    surfelGiLifecycleInputs.scheduling = scheduling;
    surfelGiLifecycleInputs.externalDependencies = { surfelGiExternalDependencies, surfelGiExternalDependencyCount };
    surfelGiLifecycleInputs.computeStateSource = surfelGiComputeStateSource;
    surfelGiLifecycleInputs.counterStateSource = surfelGiCounterStateSource;
    surfelGiLifecycleInputs.hasWork = hasSurfelWork;
    auto surfelGiLifecycleResult = surfelGiLifecycleBuilder.declare(surfelGiLifecycleInputs);
    if(!surfelGiLifecycleResult){
        NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: could not declare deferred surfel-GI lifecycle"));
        return false;
    }
    m_deferredSurfelGiPreparationTask = surfelGiLifecycleResult->preparationTask;
    m_deferredSurfelGiInitializationLifecycleTask = surfelGiLifecycleResult->initializationLifecycleTask;
    m_deferredSurfelGiSnapshotCopyTask = surfelGiLifecycleResult->snapshotCopyTask;
    Core::GpuTaskId surfelGiDependency = surfelGiLifecycleResult->dependency;

    // Zero coverage is the no-op; keep its clear at the front of the GI packet.
    Core::GpuTaskSchedulingHint surfelIrradianceClearScheduling;
    surfelIrradianceClearScheduling.cost = Core::GpuTaskCostHint::Tiny;
    surfelIrradianceClearScheduling.allowPacketMerge = true;
    surfelIrradianceClearScheduling.mergeWithPrevious = !useLaggedLightingHistory;
    surfelIrradianceClearScheduling.allowMergeAcrossConsumerFrontier = !useLaggedLightingHistory;
    // Compatible live effects share the snapshot packet; the GI chain retains its selected queue.
    EnableSameFamilyComputeEffectRouting(surfelIrradianceClearScheduling, false);
    EnableCrossFamilyComputeEffectRouting(surfelIrradianceClearScheduling);
    const Core::GpuTaskResourceUse surfelIrradianceClearResourceUse = WriteTextureUse(surfelIrradiance, ECSRenderDetail::s_FramebufferSubresources, Core::ResourceStates::CopyDest);
    Core::GpuTaskDesc surfelIrradianceClearDesc;
    surfelIrradianceClearDesc
        .setIdentity(Name(s_SurfelGraphIrradianceClear))
        .setMarkerLabel("Surfel Irradiance Clear")
        .setScheduling(surfelIrradianceClearScheduling)
        .setDependencies({ &surfelGiDependency, 1u })
        .setResourceUses({ &surfelIrradianceClearResourceUse, 1u })
    ;
    const auto surfelIrradianceClearTaskResult = context.graph.addTask<ECSRenderDetail::FloatTextureClearGraphTask>(
        surfelIrradianceClearDesc,
        ECSRenderDetail::FloatTextureClearGraphTask::Payload{ .destination = surfelIrradiance, .subresources = ECSRenderDetail::s_FramebufferSubresources, .floatValue = ECSRenderDetail::s_SurfelIrradianceClearColor, });
    if(!surfelIrradianceClearTaskResult){
        NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: could not declare graph-owned deferred surfel-irradiance clear"));
        return false;
    }
    const Core::GpuTaskId surfelIrradianceClearTask = *surfelIrradianceClearTaskResult;
    m_deferredSurfelGiIrradianceClearTask = surfelIrradianceClearTask;
    surfelGiDependency = surfelIrradianceClearTask;

    Core::GpuTaskSchedulingHint surfelGiScheduling = scheduling;
    surfelGiScheduling.forceSubmissionBoundary = false;
    surfelGiScheduling.allowPacketMerge = true;
    surfelGiScheduling.mergeWithPrevious = true;
    // GI stages share one accepted timing packet; cross-queue consumers wait for it.
    surfelGiScheduling.allowMergeAcrossConsumerFrontier = true;
    EnableSameFamilyComputeEffectRouting(surfelGiScheduling);
    EnableCrossFamilyComputeEffectRouting(surfelGiScheduling);
    if(graphOwnsSurfelGiResolve){
        const Array<Core::GpuTaskResourceUse, 4u> ageFreeResourceUses = {
            ReadUse(surfelConstants, Core::ResourceStates::ConstantBuffer),
            WriteUse(surfelPool, Core::ResourceStates::UnorderedAccess),
            WriteUse(surfelCounter, Core::ResourceStates::UnorderedAccess),
            WriteUse(surfelFreeList, Core::ResourceStates::UnorderedAccess),
        };

        Core::GpuTaskDesc ageFreeDesc;
        ageFreeDesc
            .setIdentity(Name(s_SurfelGraphAgeFree))
            .setMarkerLabel("Surfel GI Age Free")
            .setScheduling(surfelGiScheduling)
            .setDependencies({ &surfelGiDependency, 1u })
            .setExternalDependencies({ surfelGiExternalDependencies, surfelGiExternalDependencyCount })
            .setExternalStateSources({ surfelGiComputeCounterStateSources.count != 0u ? surfelGiComputeCounterStateSources.values.data() : nullptr, surfelGiComputeCounterStateSources.count })
            .setResourceUses(ageFreeResourceUses)
        ;
        const auto deferredSurfelGiAgeFreeTaskResult = surfelGiTasks.declareAgeFreeTask(ageFreeDesc, deferredLightingResources, deferredTargets, timingTicket, asyncTiming);
        if(!deferredSurfelGiAgeFreeTaskResult){
            m_deferredSurfelGiAgeFreeTask = {};
            NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: could not declare deferred surfel-GI age/free graph task"));
            return false;
        }
        m_deferredSurfelGiAgeFreeTask = *deferredSurfelGiAgeFreeTaskResult;

        Core::GpuTaskDesc cellHeadClearDesc;
        cellHeadClearDesc
            .setIdentity(Name(s_SurfelGraphCellHeadClear))
            .setMarkerLabel("Surfel GI Cell Head Clear")
            .setScheduling(surfelGiScheduling)
            .setDependencies({ &m_deferredSurfelGiAgeFreeTask, 1u })
            .setExternalStateSources({ surfelGiComputeStateSource.states ? &surfelGiComputeStateSource : nullptr, surfelGiComputeStateSource.states ? 1u : 0u })
        ;
        const auto deferredSurfelGiCellHeadClearTaskResult = context.graph.addClearBufferTask(cellHeadClearDesc, Core::GpuClearBufferTaskDesc{ .destination = surfelCellHead, .clearValue = NWB_SURFEL_CELL_INVALID, });
        if(!deferredSurfelGiCellHeadClearTaskResult){
            m_deferredSurfelGiCellHeadClearTask = {};
            NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: could not declare graph-owned deferred surfel cell-head clear"));
            return false;
        }
        m_deferredSurfelGiCellHeadClearTask = *deferredSurfelGiCellHeadClearTaskResult;

        const Array<Core::GpuTaskResourceUse, 3u> hashBuildResourceUses = {
            ReadUse(surfelConstants, Core::ResourceStates::ConstantBuffer),
            ReadWriteUse(surfelPool, Core::ResourceStates::UnorderedAccess),
            ReadWriteUse(surfelCellHead, Core::ResourceStates::UnorderedAccess),
        };
        Core::GpuTaskDesc hashBuildDesc;
        hashBuildDesc
            .setIdentity(Name(s_SurfelGraphHashBuild))
            .setMarkerLabel("Surfel GI Hash Build")
            .setScheduling(surfelGiScheduling)
            .setDependencies({ &m_deferredSurfelGiCellHeadClearTask, 1u })
            .setResourceUses(hashBuildResourceUses)
        ;
        const auto deferredSurfelGiHashBuildTaskResult = surfelGiTasks.declareHashBuildTask(hashBuildDesc, deferredLightingResources, deferredTargets, timingTicket, asyncTiming);
        if(!deferredSurfelGiHashBuildTaskResult){
            m_deferredSurfelGiHashBuildTask = {};
            NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: could not declare deferred surfel-GI hash-build graph task"));
            return false;
        }
        m_deferredSurfelGiHashBuildTask = *deferredSurfelGiHashBuildTaskResult;

        const Array<Core::GpuTaskResourceUse, 10u> spawnResourceUses = {
            ReadUse(worldPosition),
            ReadUse(normal),
            ReadUse(surfelConstants, Core::ResourceStates::ConstantBuffer),
            ReadWriteUse(surfelPool, Core::ResourceStates::UnorderedAccess),
            ReadWriteUse(surfelGuidePool, Core::ResourceStates::UnorderedAccess),
            ReadWriteUse(surfelCellHead, Core::ResourceStates::UnorderedAccess),
            ReadWriteUse(surfelCounter, Core::ResourceStates::UnorderedAccess),
            ReadWriteUse(surfelFreeList, Core::ResourceStates::UnorderedAccess),
            ReadUse(surfelPoolSnapshot, Core::ResourceStates::ShaderResource),
            ReadUse(surfelCellHeadSnapshot, Core::ResourceStates::ShaderResource),
        };
        Core::GpuTaskDesc spawnDesc;
        spawnDesc.setIdentity(Name(s_SurfelGraphSpawn)).setMarkerLabel("Surfel GI Spawn").setScheduling(surfelGiScheduling).setDependencies({ &m_deferredSurfelGiHashBuildTask, 1u }).setResourceUses(spawnResourceUses);
        const auto deferredSurfelGiSpawnTaskResult = surfelGiTasks.declareSpawnTask(spawnDesc, deferredLightingResources, deferredTargets, timingTicket, asyncTiming);
        if(!deferredSurfelGiSpawnTaskResult){
            m_deferredSurfelGiSpawnTask = {};
            NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: could not declare deferred surfel-GI spawn graph task"));
            return false;
        }
        m_deferredSurfelGiSpawnTask = *deferredSurfelGiSpawnTaskResult;

        const Array<Core::GpuTaskResourceUse, 3u> traceBuildArgsResourceUses = {
            ReadUse(surfelConstants, Core::ResourceStates::ConstantBuffer),
            ReadUse(surfelCounter, Core::ResourceStates::UnorderedAccess),
            WriteUse(surfelTraceIndirectArgs, Core::ResourceStates::UnorderedAccess),
        };
        Core::GpuTaskDesc traceBuildArgsDesc;
        traceBuildArgsDesc
            .setIdentity(Name(s_SurfelGraphTraceBuildArgs))
            .setMarkerLabel("Surfel GI Trace Build Args")
            .setScheduling(surfelGiScheduling)
            .setDependencies({ &m_deferredSurfelGiSpawnTask, 1u })
            .setExternalStateSources({ surfelGiComputeCounterStateSources.count != 0u ? surfelGiComputeCounterStateSources.values.data() : nullptr, surfelGiComputeCounterStateSources.count })
            .setResourceUses(traceBuildArgsResourceUses)
        ;
        const auto deferredSurfelGiTraceBuildArgsTaskResult = surfelGiTasks.declareTraceBuildArgsTask(traceBuildArgsDesc, deferredLightingResources, deferredTargets, timingTicket, asyncTiming);
        if(!deferredSurfelGiTraceBuildArgsTaskResult){
            m_deferredSurfelGiTraceBuildArgsTask = {};
            NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: could not declare deferred surfel-GI trace-build-args graph task"));
            return false;
        }
        m_deferredSurfelGiTraceBuildArgsTask = *deferredSurfelGiTraceBuildArgsTaskResult;

        Core::GpuTaskDesc traceDesc;
        const SurfelGiTaskStateSourceSet traceStateSources = makeSurfelGiTaskStateSources(true, csgTraceContext.valid(), false);
        traceDesc
            .setIdentity(Name(s_SurfelGraphTrace))
            .setMarkerLabel("Surfel GI Trace")
            .setScheduling(surfelGiScheduling)
            .setDependencies({ &m_deferredSurfelGiTraceBuildArgsTask, 1u })
            .setExternalStateSources({ traceStateSources.count != 0u ? traceStateSources.values.data() : nullptr, traceStateSources.count })
            .setResourceUses(traceResourceUses)
            .setResourceSetUses({ traceResourceSets.useCount != 0u ? traceResourceSets.uses.data() : nullptr, traceResourceSets.useCount })
        ;
        const auto deferredSurfelGiTraceTaskResult = surfelGiTasks.declareTraceTask(traceDesc, deferredLightingResources, deferredTargets, timingTicket, asyncTiming);
        if(!deferredSurfelGiTraceTaskResult){
            m_deferredSurfelGiTraceTask = {};
            NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: could not declare deferred surfel-GI trace graph task"));
            return false;
        }
        m_deferredSurfelGiTraceTask = *deferredSurfelGiTraceTaskResult;

        const Array<Core::GpuTaskResourceUse, 6u> resolveResourceUses = {
            ReadUse(worldPosition),
            ReadUse(normal),
            ReadUse(surfelConstants, Core::ResourceStates::ConstantBuffer),
            ReadUse(surfelPool, Core::ResourceStates::ShaderResource),
            ReadUse(surfelCellHead, Core::ResourceStates::ShaderResource),
            WriteUse(surfelIrradianceHalf, Core::ResourceStates::UnorderedAccess),
        };
        Core::GpuTaskDesc resolveDesc;
        resolveDesc
            .setIdentity(Name(s_SurfelGraphResolve))
            .setMarkerLabel("Surfel GI Resolve")
            .setScheduling(surfelGiScheduling)
            .setDependencies({ &m_deferredSurfelGiTraceTask, 1u })
            .setExternalStateSources({ surfelGiComputeStateSource.states ? &surfelGiComputeStateSource : nullptr, surfelGiComputeStateSource.states ? 1u : 0u })
            .setResourceUses(resolveResourceUses)
        ;
        const auto deferredSurfelGiResolveTaskResult = surfelGiTasks.declareResolveTask(resolveDesc, deferredLightingResources, deferredTargets, timingTicket, asyncTiming);
        if(!deferredSurfelGiResolveTaskResult){
            m_deferredSurfelGiResolveTask = {};
            NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: could not declare deferred surfel-GI resolve graph task"));
            return false;
        }
        m_deferredSurfelGiResolveTask = *deferredSurfelGiResolveTaskResult;
        surfelGiDependency = m_deferredSurfelGiResolveTask;
    }

    const SurfelGiTaskStateSourceSet& terminalStateSources = graphOwnsSurfelGiResolve ? surfelGiComputeReturnStateSources : surfelGiAllStateSources;
    Core::GpuTaskDesc desc;
    desc
        .setIdentity(Name(s_SurfelGraphPass))
        .setMarkerLabel("Surfel GI")
        .setScheduling(surfelGiScheduling)
        .setDependencies({ &surfelGiDependency, 1u })
        .setExternalDependencies({ graphOwnsSurfelGiResolve ? nullptr : surfelGiExternalDependencies, graphOwnsSurfelGiResolve ? 0u : surfelGiExternalDependencyCount })
        .setExternalStateSources({ terminalStateSources.count != 0u ? terminalStateSources.values.data() : nullptr, terminalStateSources.count })
        .setResourceUses(resourceUses)
        .setResourceSetUses({ !graphOwnsSurfelGiResolve && traceResourceSets.useCount != 0u ? traceResourceSets.uses.data() : nullptr, !graphOwnsSurfelGiResolve ? traceResourceSets.useCount : 0u })
    ;
    const auto deferredSurfelGiTaskResult = surfelGiTasks.declareTerminalTask(desc, deferredLightingResources, deferredTargets, timingTicket, graphOwnsSurfelGiResolve ? &asyncTiming : nullptr);
    if(!deferredSurfelGiTaskResult){
        m_deferredSurfelGiTask = {};
        NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: could not declare deferred surfel-GI graph task"));
        return false;
    }
    m_deferredSurfelGiTask = *deferredSurfelGiTaskResult;
    return true;
}

void SurfelGiGraphCoordinator::declareDeferredSurfelCountReadbackTask(const SurfelGiGraphContext& context, const RayTracingSurfelPersistentResourceSnapshot& rayTracingSurfelResources){
    SurfelGiCounterReadbackBuilder builder(context.graph, context.rayTracing);
    builder.declare(rayTracingSurfelResources, m_deferredSurfelGiTask, context.frameTimingEndTask, m_deferredSurfelGiCounterReadbackTask);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void SurfelGiCounterReadbackBuilder::declare(const RayTracingSurfelPersistentResourceSnapshot& rayTracingSurfelResources, const Core::GpuTaskId surfelTask, const Core::GpuTaskId timingEndTask, Core::GpuTaskId& outTask){
    using namespace RendererTaskGraphDetail;

    outTask = {};
    if(!surfelTask.valid() || !timingEndTask.valid() || !m_raytracingSystem.shouldCaptureSurfelCountReadback())
        return;

    const auto counterResult = m_graph.importBuffer(rayTracingSurfelResources.counterBuffer, BufferResourceDesc(Name(s_SurfelCounterName), s_SurfelCounterLabel));
    const auto readbackResult = m_graph.importBuffer(
        rayTracingSurfelResources.counterReadbackBuffer,
        BufferResourceDesc(Name(s_SurfelCounterReadbackName), s_SurfelCounterReadbackLabel)
    );
    if(!counterResult || !readbackResult){
        NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: could not import surfel counter-readback graph resources"));
        return;
    }
    const Core::GpuGraphResourceId counter = *counterResult;
    const Core::GpuGraphResourceId readback = *readbackResult;

    const Array<Core::GpuCopyBufferTaskRegion, 1u> regions = { Core::GpuCopyBufferTaskRegion{ .source = counter, .destination = readback, .dataSizeBytes = static_cast<u64>(sizeof(u32)) * NWB_SURFEL_COUNTER_SIZE, }, };
    Core::GpuTaskSchedulingHint scheduling;
    // Infrequent diagnostic after presentation; small copy so Transfer absorbs it.
    scheduling.cost = Core::GpuTaskCostHint::Small;
    scheduling.forceSubmissionBoundary = true;
    scheduling.allowPacketMerge = false;
    const Array<Core::GpuTaskId, 2u> dependencies = { surfelTask, timingEndTask, };
    Core::GpuTaskDesc desc;
    desc.setIdentity(Name(s_SurfelCounterReadbackName)).setMarkerLabel(s_SurfelCounterReadbackLabel).setScheduling(scheduling).setDependencies(dependencies);
    const auto deferredSurfelGiCounterReadbackTaskResult = m_graph.addCopyBufferTask(desc, Core::GpuCopyBufferTaskDesc{ .regions = regions.data(), .regionCount = regions.size(), });
    if(!deferredSurfelGiCounterReadbackTaskResult){
        outTask = {};
        NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: could not declare deferred surfel counter-readback task"));
        return;
    }
    outTask = *deferredSurfelGiCounterReadbackTaskResult;
    // The token stays invalid until native submission accepts; this timestamp is only read when it publishes.
    m_raytracingSystem.markSurfelCountReadbackScheduled();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<SurfelGiLifecycleResult> SurfelGiLifecycleBuilder::declare(const SurfelGiLifecycleInputs& inputs){
    SurfelGiLifecycleResult result{};
    if(!inputs.targets)
        return MakeUnexpected(Failure{});
    Core::GpuTaskId dependency = inputs.dependency;
    result.dependency = inputs.dependency;
    if(!inputs.hasWork)
        return result;
    {
        if(!inputs.surfelPool.valid() || !inputs.surfelCellHead.valid() || !inputs.surfelCounter.valid() || !inputs.surfelFreeList.valid() || !inputs.surfelPoolSnapshot.valid() || !inputs.surfelCellHeadSnapshot.valid()){
            NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: surfel-GI snapshot resources were unavailable during graph declaration"));
            return MakeUnexpected(Failure{});
        }

        if(m_raytracingSystem.needsSurfelResourceInitialization()){
            Core::GpuTaskSchedulingHint initializationScheduling;
            initializationScheduling.cost = Core::GpuTaskCostHint::Medium;
            // Merge serial successors into the first clear's packet; never force a boundary here.
            initializationScheduling.allowPacketMerge = true;
            Core::GpuTaskDesc poolClearDesc;
            poolClearDesc
                .setIdentity(Name(s_SurfelGraphInitializePoolClear))
                .setMarkerLabel("Surfel GI Initialize Pool Clear")
                .setScheduling(initializationScheduling)
                .setDependencies({ &dependency, 1u })
                .setExternalDependencies(inputs.externalDependencies)
                .setExternalStateSources({ inputs.computeStateSource.states ? &inputs.computeStateSource : nullptr, inputs.computeStateSource.states ? 1u : 0u })
            ;
            const auto preparationTaskResult = m_graph.addClearBufferTask(poolClearDesc, Core::GpuClearBufferTaskDesc{ .destination = inputs.surfelPool, .clearValue = 0u, });
            if(!preparationTaskResult){
                NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: could not declare deferred surfel-GI pool initialization clear"));
                return MakeUnexpected(Failure{});
            }
            result.preparationTask = *preparationTaskResult;

            Core::GpuTaskSchedulingHint chainedInitializationScheduling = initializationScheduling;
            chainedInitializationScheduling.cost = Core::GpuTaskCostHint::Tiny;
            chainedInitializationScheduling.mergeWithPrevious = true;
            // Snapshot may route to Transfer; retain the full init chain in one accepted packet.
            chainedInitializationScheduling.allowMergeAcrossConsumerFrontier = true;
            Core::GpuTaskId initializationDependency = result.preparationTask;
            const auto addInitializationClear = [&](
                const Name& identity,
                const AStringView label,
                const Core::GpuGraphResourceId destination,
                const u32 clearValue,
                const Core::GpuTaskExternalStateSource* const externalStateSources,
                const usize externalStateSourceCount
            ){
                Core::GpuTaskDesc clearDesc;
                clearDesc.setIdentity(identity).setMarkerLabel(label).setScheduling(chainedInitializationScheduling).setDependencies({ &initializationDependency, 1u }).setExternalStateSources({ externalStateSources, externalStateSourceCount });
                const auto clearTask = m_graph.addClearBufferTask(clearDesc, Core::GpuClearBufferTaskDesc{ .destination = destination, .clearValue = clearValue, });
                if(clearTask)
                    initializationDependency = *clearTask;
                return clearTask;
            };
            if(
                !addInitializationClear(
                    Name(s_SurfelGraphInitializeCellHeadClear),
                    "Surfel GI Initialize Cell-Head Clear",
                    inputs.surfelCellHead,
                    NWB_SURFEL_CELL_INVALID,
                    inputs.computeStateSource.states ? &inputs.computeStateSource : nullptr,
                    inputs.computeStateSource.states ? 1u : 0u
                ).has_value()
                || !addInitializationClear(
                    Name(s_SurfelGraphInitializeCounterClear),
                    "Surfel GI Initialize Counter Clear",
                    inputs.surfelCounter,
                    0u,
                    inputs.counterStateSource.states ? &inputs.counterStateSource : nullptr,
                    inputs.counterStateSource.states ? 1u : 0u
                ).has_value()
                || !addInitializationClear(
                    Name(s_SurfelGraphInitializeFreeListClear),
                    "Surfel GI Initialize Free-List Clear",
                    inputs.surfelFreeList,
                    0u,
                    inputs.computeStateSource.states ? &inputs.computeStateSource : nullptr,
                    inputs.computeStateSource.states ? 1u : 0u
                ).has_value()
            ){
                NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: could not declare deferred surfel-GI initialization clears"));
                return MakeUnexpected(Failure{});
            }

            Core::GpuTaskDesc initializationLifecycleDesc;
            initializationLifecycleDesc.setIdentity(Name(s_SurfelGraphInitializeLifecycle)).setMarkerLabel("Surfel GI Initialize Lifecycle").setScheduling(chainedInitializationScheduling).setDependencies({ &initializationDependency, 1u });
            const auto initializationLifecycleTaskResult = m_raytracingSystem.declareSurfelResourceInitializationLifecycleTask(m_graph, initializationLifecycleDesc);
            if(!initializationLifecycleTaskResult){
                NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: could not declare deferred surfel-GI initialization lifecycle"));
                return MakeUnexpected(Failure{});
            }
            result.initializationLifecycleTask = *initializationLifecycleTaskResult;
            dependency = result.initializationLifecycleTask;
        }

        const Array<Core::GpuCopyBufferTaskRegion, 2u> snapshotRegions = {
            Core::GpuCopyBufferTaskRegion{ .source = inputs.surfelPool, .destination = inputs.surfelPoolSnapshot, .dataSizeBytes = inputs.poolSnapshotByteSize, },
            Core::GpuCopyBufferTaskRegion{ .source = inputs.surfelCellHead, .destination = inputs.surfelCellHeadSnapshot, .dataSizeBytes = inputs.cellHeadSnapshotByteSize, },
        };
        Core::GpuTaskDesc snapshotDesc;
        snapshotDesc
            .setIdentity(Name(s_SurfelGraphSnapshotCopy))
            .setMarkerLabel("Surfel GI Snapshot Copy")
            .setScheduling(inputs.scheduling)
            .setDependencies({ &dependency, 1u })
            .setExternalStateSources({ inputs.computeStateSource.states ? &inputs.computeStateSource : nullptr, inputs.computeStateSource.states ? 1u : 0u })
        ;
        const auto snapshotCopyTaskResult = m_graph.addCopyBufferTask(snapshotDesc, Core::GpuCopyBufferTaskDesc{ .regions = snapshotRegions.data(), .regionCount = snapshotRegions.size(), });
        if(!snapshotCopyTaskResult){
            NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: could not declare deferred surfel-GI snapshot-copy task"));
            return MakeUnexpected(Failure{});
        }
        result.snapshotCopyTask = *snapshotCopyTaskResult;
        if(!result.preparationTask.valid())
            result.preparationTask = result.snapshotCopyTask;
        dependency = result.snapshotCopyTask;
    }
    result.dependency = dependency;
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 SurfelGiResourceBuilder::prepare(const SurfelGiResourceInputs& inputs, SurfelGiResourcePlan& result){
    using namespace RendererTaskGraphDetail;
    const auto& deferredTargets = inputs.deferredTargets;
    const auto& rayTracingResources = inputs.rayTracingResources;
    const auto& rayTracingSurfelResources = inputs.rayTracingSurfelResources;
    const auto worldPosition = inputs.worldPosition;
    const auto normal = inputs.normal;
    const auto surfelIrradiance = inputs.surfelIrradiance;
    const auto currentBindlessSlots = inputs.currentBindlessSlots;
    const auto sceneShading = inputs.sceneShading;
    const auto lights = inputs.lights;
    const auto materialContextSlots = inputs.materialContextSlots;
    const auto& traceGeometryResources = inputs.traceGeometryResources;
    const auto traceGeometryStatesGraphOwned = inputs.traceGeometryStatesGraphOwned;
    const auto useHwTrace = inputs.useHwTrace;
    const auto hasSurfelWork = inputs.hasSurfelWork;
    auto& surfelIrradianceHalf = result.surfelIrradianceHalf;
    auto& sceneGeometryDomain = result.sceneGeometryDomain;
    auto& shadowInstanceMaterials = result.shadowInstanceMaterials;
    auto& shadowMaterialTyped = result.shadowMaterialTyped;
    auto& shadowInstances = result.shadowInstances;
    auto& csgTraceContext = result.csgTraceContext;
    auto& surfelConstants = result.surfelConstants;
    auto& surfelPool = result.surfelPool;
    auto& surfelGuidePool = result.surfelGuidePool;
    auto& surfelCellHead = result.surfelCellHead;
    auto& surfelCounter = result.surfelCounter;
    auto& surfelTraceIndirectArgs = result.surfelTraceIndirectArgs;
    auto& surfelFreeList = result.surfelFreeList;
    auto& surfelPoolSnapshot = result.surfelPoolSnapshot;
    auto& surfelCellHeadSnapshot = result.surfelCellHeadSnapshot;
    auto& sceneBvhNodes = result.sceneBvhNodes;
    auto& sceneInstances = result.sceneInstances;
    auto& tlas = result.tlas;
    auto& resourceUses = result.resourceUses;
    auto& traceResourceUses = result.traceResourceUses;
    auto& graphOwnsSurfelGiResolve = result.graphOwnsSurfelGiResolve;

    const auto surfelIrradianceHalfResult = ImportExternalTexture(m_graph, deferredTargets.surfelIrradianceHalf, Name(s_SurfelGraphIrradianceHalf), "Surfel Irradiance Half");
    const auto sceneGeometryDomainResult = m_graph.importHazardDomain(HazardDomainDesc(Name(s_SurfelGraphSceneGeometry), s_SceneGeometryDomainLabel));
    if(!surfelIrradianceHalfResult || !sceneGeometryDomainResult){
        NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: could not import deferred surfel-GI graph resources"));
        return false;
    }
    surfelIrradianceHalf = *surfelIrradianceHalfResult;
    sceneGeometryDomain = *sceneGeometryDomainResult;

    const b8 hasCsgTraceContext = rayTracingResources.csgTraceContextBuffer.get() != nullptr;
    resourceUses.reserve(s_SurfelResourceUseCapacity + (hasCsgTraceContext ? 1u : 0u) + (traceGeometryStatesGraphOwned ? 0u : traceGeometryResources.size()));
    traceResourceUses.reserve(s_SurfelTraceResourceUseCapacity + (hasCsgTraceContext ? s_SurfelCsgTraceContextUseCapacity : 0u) + rayTracingResources.csgTraceBoundsBuffers.size() + (traceGeometryStatesGraphOwned ? 0u : traceGeometryResources.size()));
    resourceUses.push_back(ReadUse(worldPosition));
    resourceUses.push_back(ReadUse(normal));
    resourceUses.push_back(ReadUse(currentBindlessSlots, Core::ResourceStates::ConstantBuffer));
    resourceUses.push_back(WriteUse(surfelIrradianceHalf, Core::ResourceStates::UnorderedAccess));
    resourceUses.push_back(WriteUse(surfelIrradiance, Core::ResourceStates::UnorderedAccess));
    resourceUses.push_back(ReadUse(sceneShading, Core::ResourceStates::ConstantBuffer));
    resourceUses.push_back(ReadUse(lights, Core::ResourceStates::ShaderResource));
    resourceUses.push_back(ReadUse(sceneGeometryDomain));
    if(materialContextSlots.valid())
        resourceUses.push_back(ReadUse(materialContextSlots, Core::ResourceStates::ConstantBuffer));
    for(const Core::GpuGraphResourceId resource : traceGeometryResources){
        if(!resource.valid())
            return false;
        if(!traceGeometryStatesGraphOwned)
            resourceUses.push_back(ReadUse(resource, Core::ResourceStates::ShaderResource));
    }

    const auto appendOptionalBuffer = [&](const Core::BufferHandle& buffer, const Name& identity, const AStringView label, const Core::ResourceStates::Mask state, const b8 writable = false) -> Expected<Core::GpuGraphResourceId>{
        if(!buffer)
            return Core::GpuGraphResourceId{};
        const auto resourceResult = ImportExternalBuffer(m_graph, buffer, identity, label);
        if(!resourceResult)
            return MakeUnexpected(Failure{});
        const Core::GpuGraphResourceId resource = *resourceResult;
        resourceUses.push_back(writable ? WriteUse(resource, state) : ReadUse(resource, state));
        return resource;
    };
    const auto importOptionalResources = [&]() -> Expected<void>{
        const auto shadowInstanceMaterialsResult = appendOptionalBuffer(
            rayTracingResources.shadowInstanceMaterialBuffer,
            Name(s_SceneShadowInstanceMaterialName),
            s_SceneShadowInstanceMaterialLabel,
            Core::ResourceStates::ShaderResource
        );
        if(!shadowInstanceMaterialsResult)
            return MakeUnexpected(Failure{});
        shadowInstanceMaterials = *shadowInstanceMaterialsResult;
        const auto shadowMaterialTypedResult = appendOptionalBuffer(
            rayTracingResources.shadowMaterialTypedBuffer,
            Name(s_SceneShadowMaterialTypedName),
            s_SceneShadowMaterialTypedLabel,
            Core::ResourceStates::ShaderResource
        );
        if(!shadowMaterialTypedResult)
            return MakeUnexpected(Failure{});
        shadowMaterialTyped = *shadowMaterialTypedResult;
        const auto shadowInstancesResult = appendOptionalBuffer(
            rayTracingResources.shadowInstanceBuffer,
            Name(s_SceneShadowInstancesName),
            s_SceneShadowInstancesLabel,
            Core::ResourceStates::ShaderResource
        );
        if(!shadowInstancesResult)
            return MakeUnexpected(Failure{});
        shadowInstances = *shadowInstancesResult;
        const auto surfelConstantsResult = appendOptionalBuffer(rayTracingSurfelResources.constantsBuffer, Name(s_SurfelConstantsName), s_SurfelConstantsLabel, Core::ResourceStates::ConstantBuffer);
        if(!surfelConstantsResult)
            return MakeUnexpected(Failure{});
        surfelConstants = *surfelConstantsResult;
        const auto surfelPoolResult = appendOptionalBuffer(rayTracingSurfelResources.poolBuffer, Name(s_SurfelGraphPool), "Surfel Pool", Core::ResourceStates::UnorderedAccess, true);
        if(!surfelPoolResult)
            return MakeUnexpected(Failure{});
        surfelPool = *surfelPoolResult;
        const auto surfelGuidePoolResult = appendOptionalBuffer(rayTracingSurfelResources.guidePoolBuffer, Name(s_SurfelGraphGuidePool), "Surfel Guide Pool", Core::ResourceStates::UnorderedAccess, true);
        if(!surfelGuidePoolResult)
            return MakeUnexpected(Failure{});
        surfelGuidePool = *surfelGuidePoolResult;
        const auto surfelCellHeadResult = appendOptionalBuffer(rayTracingSurfelResources.cellHeadBuffer, Name(s_SurfelGraphCellHeads), "Surfel Cell Heads", Core::ResourceStates::UnorderedAccess, true);
        if(!surfelCellHeadResult)
            return MakeUnexpected(Failure{});
        surfelCellHead = *surfelCellHeadResult;
        const auto surfelCounterResult = appendOptionalBuffer(rayTracingSurfelResources.counterBuffer, Name(s_SurfelCounterName), s_SurfelCounterLabel, Core::ResourceStates::UnorderedAccess, true);
        if(!surfelCounterResult)
            return MakeUnexpected(Failure{});
        surfelCounter = *surfelCounterResult;
        const auto surfelFreeListResult = appendOptionalBuffer(rayTracingSurfelResources.freeListBuffer, Name(s_SurfelGraphFreeList), "Surfel Free List", Core::ResourceStates::UnorderedAccess, true);
        if(!surfelFreeListResult)
            return MakeUnexpected(Failure{});
        surfelFreeList = *surfelFreeListResult;
        const auto surfelPoolSnapshotResult = appendOptionalBuffer(rayTracingSurfelResources.poolSnapshotBuffer, Name(s_SurfelGraphPoolSnapshot), "Surfel Pool Snapshot", Core::ResourceStates::ShaderResource);
        if(!surfelPoolSnapshotResult)
            return MakeUnexpected(Failure{});
        surfelPoolSnapshot = *surfelPoolSnapshotResult;
        const auto surfelCellHeadSnapshotResult = appendOptionalBuffer(rayTracingSurfelResources.cellHeadSnapshotBuffer, Name(s_SurfelGraphCellHeadSnapshot), "Surfel Cell Head Snapshot", Core::ResourceStates::ShaderResource);
        if(!surfelCellHeadSnapshotResult)
            return MakeUnexpected(Failure{});
        surfelCellHeadSnapshot = *surfelCellHeadSnapshotResult;
        return {};
    };
    b8 optionalResourcesImported = importOptionalResources().has_value();
    if(optionalResourcesImported && rayTracingResources.csgTraceContextBuffer){
        {
            const Core::GpuTaskGraph::DeclarationReadView declarations(m_graph);
            csgTraceContext = declarations.findImportedBuffer(rayTracingResources.csgTraceContextBuffer);
        }
        optionalResourcesImported = csgTraceContext.valid();
        if(optionalResourcesImported)
            resourceUses.push_back(ReadUse(csgTraceContext, Core::ResourceStates::ShaderResource));
    }
    if(optionalResourcesImported && rayTracingSurfelResources.traceIndirectArgsBuffer){
        const auto surfelTraceIndirectArgsResult = ImportExternalBuffer(m_graph, rayTracingSurfelResources.traceIndirectArgsBuffer, Name(s_SurfelGraphTraceArgs), "Surfel Trace Arguments");
        if(surfelTraceIndirectArgsResult)
            surfelTraceIndirectArgs = *surfelTraceIndirectArgsResult;
        optionalResourcesImported = surfelTraceIndirectArgsResult.has_value();
    }
    if(optionalResourcesImported && !useHwTrace){
        const auto sceneBvhNodesResult = appendOptionalBuffer(rayTracingResources.sceneBvhNodeBuffer, Name(s_SceneBvhNodesName), s_SceneBvhNodesLabel, Core::ResourceStates::ShaderResource);
        if(sceneBvhNodesResult)
            sceneBvhNodes = *sceneBvhNodesResult;
        optionalResourcesImported = sceneBvhNodesResult.has_value();
    }
    if(optionalResourcesImported && !useHwTrace){
        const auto sceneInstancesResult = appendOptionalBuffer(rayTracingResources.sceneInstanceBuffer, Name(s_SceneInstancesName), s_SceneInstancesLabel, Core::ResourceStates::ShaderResource);
        if(sceneInstancesResult)
            sceneInstances = *sceneInstancesResult;
        optionalResourcesImported = sceneInstancesResult.has_value();
    }
    if(optionalResourcesImported && useHwTrace){
        if(!rayTracingResources.sceneTlas)
            optionalResourcesImported = false;
        else{
            const auto tlasResult = m_graph.importAccelStruct(
                rayTracingResources.sceneTlas,
                AccelStructResourceDesc(Name(s_SceneTlasResourceName), s_SceneTlasResourceLabel)
                    .setInitialState(m_raytracingSystem.sceneTlasBackingInitialState())
            );
            if(tlasResult)
                tlas = *tlasResult;
            optionalResourcesImported = tlasResult.has_value();
            if(optionalResourcesImported)
                resourceUses.push_back(ReadUse(tlas, Core::ResourceStates::AccelStructRead));
        }
    }
    if(!optionalResourcesImported){
        NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: could not import a deferred surfel-GI dynamic resource domain"));
        return false;
    }

    graphOwnsSurfelGiResolve =
        hasSurfelWork
        && shadowInstanceMaterials.valid()
        && shadowMaterialTyped.valid()
        && shadowInstances.valid()
        && materialContextSlots.valid()
        && surfelConstants.valid()
        && surfelPool.valid()
        && surfelGuidePool.valid()
        && surfelCellHead.valid()
        && surfelCounter.valid()
        && surfelTraceIndirectArgs.valid()
        && surfelFreeList.valid()
        && surfelPoolSnapshot.valid()
        && surfelCellHeadSnapshot.valid()
        && (useHwTrace ? tlas.valid() : (sceneBvhNodes.valid() && sceneInstances.valid()))
        && rayTracingResources.surfelSplitGraphPipelinesReady
    ;
    if(hasSurfelWork && !graphOwnsSurfelGiResolve){
        NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: active surfel GI has no complete prepared graph resources"));
        return false;
    }
    if(graphOwnsSurfelGiResolve){
        resourceUses.clear();
        resourceUses.push_back(ReadUse(worldPosition));
        resourceUses.push_back(ReadUse(normal));
        resourceUses.push_back(ReadUse(surfelIrradianceHalf, Core::ResourceStates::ShaderResource));
        resourceUses.push_back(WriteUse(surfelIrradiance, Core::ResourceStates::UnorderedAccess));

        traceResourceUses.push_back(ReadUse(currentBindlessSlots, Core::ResourceStates::ConstantBuffer));
        traceResourceUses.push_back(ReadUse(sceneShading, Core::ResourceStates::ConstantBuffer));
        traceResourceUses.push_back(ReadUse(lights, Core::ResourceStates::ShaderResource));
        traceResourceUses.push_back(ReadUse(sceneGeometryDomain));
        traceResourceUses.push_back(ReadUse(materialContextSlots, Core::ResourceStates::ConstantBuffer));
        traceResourceUses.push_back(ReadUse(shadowInstanceMaterials, Core::ResourceStates::ShaderResource));
        traceResourceUses.push_back(ReadUse(shadowMaterialTyped, Core::ResourceStates::ShaderResource));
        traceResourceUses.push_back(ReadUse(shadowInstances, Core::ResourceStates::ShaderResource));
        if(csgTraceContext.valid()){
            if(!RendererFramePipelineDetail::AppendCurrentCsgRayGeometry(
                rayTracingResources.csgTraceContextBuffer,
                rayTracingResources.csgTraceBoundsBuffers,
                m_graph,
                traceResourceUses
            ))
                return false;
            traceResourceUses.push_back(ReadWriteUse(surfelCounter, Core::ResourceStates::UnorderedAccess));
        }
        traceResourceUses.push_back(ReadUse(surfelConstants, Core::ResourceStates::ConstantBuffer));
        traceResourceUses.push_back(ReadWriteUse(surfelPool, Core::ResourceStates::UnorderedAccess));
        traceResourceUses.push_back(ReadWriteUse(surfelGuidePool, Core::ResourceStates::UnorderedAccess));
        traceResourceUses.push_back(ReadUse(surfelPoolSnapshot, Core::ResourceStates::ShaderResource));
        traceResourceUses.push_back(ReadUse(surfelCellHeadSnapshot, Core::ResourceStates::ShaderResource));
        traceResourceUses.push_back(ReadUse(surfelTraceIndirectArgs, Core::ResourceStates::IndirectArgument));
        if(!traceGeometryStatesGraphOwned){
            for(const Core::GpuGraphResourceId resource : traceGeometryResources)
                traceResourceUses.push_back(ReadUse(resource, Core::ResourceStates::ShaderResource));
        }
        if(useHwTrace)
            traceResourceUses.push_back(ReadUse(tlas, Core::ResourceStates::AccelStructRead));
        else{
            traceResourceUses.push_back(ReadUse(sceneBvhNodes, Core::ResourceStates::ShaderResource));
            traceResourceUses.push_back(ReadUse(sceneInstances, Core::ResourceStates::ShaderResource));
        }
    }
    else if(surfelTraceIndirectArgs.valid())
        resourceUses.push_back(WriteUse(surfelTraceIndirectArgs, Core::ResourceStates::UnorderedAccess));

    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RendererRayTracingSystem::createSurfelTargets(DeferredFrameTargets& targets){
    const u32 factor = targets.surfelResolveFactor;
    const SurfelGiResolveSize resolveSize = MakeSurfelGiResolveSize(targets.width, targets.height, factor);
    if(!IsValidSurfelGiResolveSize(resolveSize))
        return false;

    // Deferred lighting samples resolved surfel GI, never the writable pool.
    targets.surfelIrradianceFormat = Core::Format::RGBA16_FLOAT;
    Core::TextureDesc surfelIrradianceDesc;
    surfelIrradianceDesc.setWidth(targets.width).setHeight(targets.height).setFormat(targets.surfelIrradianceFormat).setIsUAV(true).setQueueSharing(Core::ResourceQueueSharing::GraphicsAsyncComputeAndTransfer).setName("engine/gi/surfel_irradiance");
    auto surfelIrradianceResult = m_graphics.createTexture(surfelIrradianceDesc);
    if(surfelIrradianceResult)
        targets.surfelIrradiance = Move(*surfelIrradianceResult);
    else
        targets.surfelIrradiance.reset();
    if(!surfelIrradianceResult){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to create surfel irradiance target"));
        return false;
    }

    // Transient reduced-resolution surfel resolve input.
    Core::TextureDesc surfelIrradianceHalfDesc;
    surfelIrradianceHalfDesc.setWidth(resolveSize.width).setHeight(resolveSize.height).setFormat(targets.surfelIrradianceFormat).setIsUAV(true).setQueueSharing(Core::ResourceQueueSharing::GraphicsAndAsyncCompute).setName("engine/gi/surfel_irradiance_half");
    auto surfelIrradianceHalfResult = m_graphics.createTexture(surfelIrradianceHalfDesc);
    if(surfelIrradianceHalfResult)
        targets.surfelIrradianceHalf = Move(*surfelIrradianceHalfResult);
    else
        targets.surfelIrradianceHalf.reset();
    if(!surfelIrradianceHalfResult){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to create surfel reduced-resolution irradiance target"));
        return false;
    }

    m_rayTracingState.m_surfelResolveDispatchLogged = false;
    return true;
}

Expected<Optional<Core::GpuUploadBlobId>> RendererRayTracingSystem::retainPreparedSurfelFrameConstantsUpload(Core::GpuTaskGraph& graph, const DeferredFrameTargets& targets)const{
    if(!hasSurfelWork())
        return Optional<Core::GpuUploadBlobId>{};
    if(!m_rayTracingState.m_surfelConstants){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: active surfel GI has no preflighted constant buffer"));
        return MakeUnexpected(Failure{});
    }

    const NwbSurfelConstantsGpu params = BuildSurfelFrameConstants(
        m_rayTracingState.m_surfelSeeded,
        m_rayTracingState.m_surfelHashCellCount,
        m_rayTracingState.m_surfelPoolCapacity,
        m_rayTracingState.m_surfelFrameIndex,
        targets.width,
        targets.height,
        targets.surfelResolveFactor
    );
    const auto blob = graph.copyUploadData(&params, sizeof(params), alignof(NwbSurfelConstantsGpu));
    if(!blob)
        return MakeUnexpected(Failure{});
    return Optional<Core::GpuUploadBlobId>{*blob};
}

void RendererRayTracingSystem::releaseSurfelGiHeapHandles(){
    Core::GpuDescriptorHeap& heap = m_graphics.getDevice().getDescriptorHeap();
    RayTracingDetail::RetireHeapHandle(heap, m_rayTracingState.m_surfelConstantsHeapHandle);
    RayTracingDetail::RetireHeapHandle(heap, m_rayTracingState.m_surfelPoolHeapHandle);
    RayTracingDetail::RetireHeapHandle(heap, m_rayTracingState.m_surfelGuidePoolHeapHandle);
    RayTracingDetail::RetireHeapHandle(heap, m_rayTracingState.m_surfelCellHeadHeapHandle);
    RayTracingDetail::RetireHeapHandle(heap, m_rayTracingState.m_surfelCounterHeapHandle);
    RayTracingDetail::RetireHeapHandle(heap, m_rayTracingState.m_surfelTraceIndirectArgsHeapHandle);
    RayTracingDetail::RetireHeapHandle(heap, m_rayTracingState.m_surfelFreeListHeapHandle);
    RayTracingDetail::RetireHeapHandle(heap, m_rayTracingState.m_surfelPoolSnapshotHeapHandle);
    RayTracingDetail::RetireHeapHandle(heap, m_rayTracingState.m_surfelCellHeadSnapshotHeapHandle);
}

RayTracingSurfelPersistentResourceSnapshot RendererRayTracingSystem::snapshotSurfelPersistentResources()const noexcept{
    return RayTracingSurfelPersistentResourceSnapshot{
        .constantsBuffer = m_rayTracingState.m_surfelConstants,
        .poolBuffer = m_rayTracingState.m_surfelPoolBuffer,
        .guidePoolBuffer = m_rayTracingState.m_surfelGuidePoolBuffer,
        .cellHeadBuffer = m_rayTracingState.m_surfelCellHeadBuffer,
        .counterBuffer = m_rayTracingState.m_surfelCounterBuffer,
        .traceIndirectArgsBuffer = m_rayTracingState.m_surfelTraceIndirectArgsBuffer,
        .freeListBuffer = m_rayTracingState.m_surfelFreeListBuffer,
        .poolSnapshotBuffer = m_rayTracingState.m_surfelPoolSnapshotBuffer,
        .cellHeadSnapshotBuffer = m_rayTracingState.m_surfelCellHeadSnapshotBuffer,
        .counterReadbackBuffer = m_rayTracingState.m_surfelCounterReadback,
        .countReadbackSubmissionToken = m_rayTracingState.m_surfelCountReadbackSubmissionToken,
    };
}

b8 RendererRayTracingSystem::surfelCountReadbackSubmissionMatches(const Core::QueueSubmissionToken& submissionToken)const noexcept{
    return SurfelReadbackSubmissionMatches(m_rayTracingState.m_surfelCountReadbackSubmissionToken, submissionToken);
}

void RendererRayTracingSystem::confirmSurfelCountReadbackSubmission(const Core::QueueSubmissionToken& submissionToken)noexcept{
    NWB_ASSERT(submissionToken.valid());
    m_rayTracingState.m_surfelCountReadbackSubmissionToken = submissionToken;
}

b8 RendererRayTracingSystem::recordSurfelResourceInitializationLifecycle()noexcept{
    return BeginSurfelResourceInitializationLifecycle(m_rayTracingState.m_surfelResourcesNeedClear, m_rayTracingState.m_surfelResourcesClearPending);
}

void RendererRayTracingSystem::finalizeSurfelResourceInitialization()noexcept{
    FinalizeSurfelResourceInitializationLifecycle(m_rayTracingState.m_surfelResourcesClearPending, m_rayTracingState.m_surfelResourcesNeedClear);
}

b8 RendererRayTracingSystem::ensureSurfelResources(){
    // Persistent field storage survives window resizes.
    if(!hasSurfelWork())
        return true;

    const u32 poolCapacity = m_rayTracingState.m_surfelPoolCapacity;
    const u32 cellCount = m_rayTracingState.m_surfelHashCellCount;
    if(!IsValidSurfelGiStorageCounts(poolCapacity, cellCount))
        return false;

    auto& device = m_graphics.getDevice();
    Core::GpuDescriptorHeap& heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: surfel GI requires the initialized global descriptor heap"));
        return false;
    }

    const auto ensureBuffer = [&](
        const Core::BufferDesc& desc,
        const tchar* const errorMessage,
        const b8 markNeedsClear,
        const b8 resetSeeded,
        Core::BufferHandle& inOutBuffer
    ){
        if(inOutBuffer)
            return true;
        auto bufferResult = m_graphics.createBuffer(desc);
        if(bufferResult)
            inOutBuffer = Move(*bufferResult);
        else{
            inOutBuffer.reset();
            NWB_LOGGER_ERROR(NWB_TEXT("{}"), errorMessage);
            return false;
        }
        if(resetSeeded)
            m_rayTracingState.m_surfelSeeded = false;
        if(markNeedsClear)
            m_rayTracingState.m_surfelResourcesNeedClear = true;
        return true;
    };
    const auto makeStructuredDesc = [](
        const u64 byteSize,
        const u32 stride,
        const b8 canHaveUavs,
        const b8 indirectArgs,
        const Core::ResourceQueueSharing::Mask queueSharing,
        const Name debugName
    ){
        Core::BufferDesc desc;
        desc
            .setByteSize(byteSize)
            .setStructStride(stride)
            .setCanHaveUAVs(canHaveUavs)
            .setIsDrawIndirectArgs(indirectArgs)
            .setQueueSharing(queueSharing)
            .setDebugName(debugName)
            .enableAutomaticStateTracking(Core::ResourceStates::Common)
        ;
        return desc;
    };

    Core::BufferDesc readbackDesc;
    readbackDesc
        .setByteSize(static_cast<u64>(sizeof(u32)) * NWB_SURFEL_COUNTER_SIZE)
        .setCpuAccess(Core::CpuAccessMode::Read)
        .setQueueSharing(Core::ResourceQueueSharing::GraphicsAsyncComputeAndTransfer)
        .setDebugName(Name(s_SurfelResourceCounterReadback))
        .enableAutomaticStateTracking(Core::ResourceStates::CopyDest)
    ;
    Core::BufferDesc constantsDesc;
    constantsDesc
        .setByteSize(sizeof(NwbSurfelConstantsGpu))
        .setIsConstantBuffer(true)
        // The upload and asynchronous consumers share this selector.
        .setQueueSharing(Core::ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setDebugName(Name(s_SurfelResourceConstants))
        .enableAutomaticStateTracking(Core::ResourceStates::Common)
    ;

    if(
        // Fresh pool storage needs one clear before tracing.
        !ensureBuffer(
            makeStructuredDesc(ComputeSurfelBufferByteSize(NWB_SURFEL_RECORD_SIZE, poolCapacity), NWB_SURFEL_RECORD_SIZE, true, false, Core::ResourceQueueSharing::GraphicsAsyncComputeAndTransfer, Name(s_SurfelResourcePool)),
            NWB_TEXT("RendererSystem: failed to create surfel pool buffer"),
            true,
            true,
            m_rayTracingState.m_surfelPoolBuffer
        )
        // Four float4 guide lanes per surfel; this live-only buffer is never needed by bounce gathers.
        || !ensureBuffer(
            makeStructuredDesc(
                ComputeSurfelBufferByteSize(static_cast<u64>(NWB_SURFEL_GUIDE_FLOAT4_STRIDE) * NWB_SURFEL_GUIDE_FLOAT4S_PER_SURFEL, poolCapacity),
                NWB_SURFEL_GUIDE_FLOAT4_STRIDE, true, false, Core::ResourceQueueSharing::GraphicsAsyncComputeAndTransfer, Name(s_SurfelResourceGuidePool)
            ),
            NWB_TEXT("RendererSystem: failed to create surfel guide pool buffer"),
            true,
            false,
            m_rayTracingState.m_surfelGuidePoolBuffer
        )
        // Hash heads use 0xFFFFFFFF as the empty sentinel.
        || !ensureBuffer(
            makeStructuredDesc(ComputeSurfelBufferByteSize(sizeof(u32), cellCount), sizeof(u32), true, false, Core::ResourceQueueSharing::GraphicsAsyncComputeAndTransfer, Name(s_SurfelResourceCellHead)),
            NWB_TEXT("RendererSystem: failed to create surfel cell-head buffer"),
            true,
            false,
            m_rayTracingState.m_surfelCellHeadBuffer
        )
        // The persistent counter writes on Compute; the diagnostic tail may copy it on Transfer before the next import.
        || !ensureBuffer(
            makeStructuredDesc(static_cast<u64>(sizeof(u32)) * NWB_SURFEL_COUNTER_SIZE, sizeof(u32), true, false, Core::ResourceQueueSharing::GraphicsAsyncComputeAndTransfer, Name(s_SurfelResourceCounter)),
            NWB_TEXT("RendererSystem: failed to create surfel counter buffer"),
            true,
            false,
            m_rayTracingState.m_surfelCounterBuffer
        )
        // Build-args rewrites the indirect dispatch buffer each frame.
        || !ensureBuffer(
            makeStructuredDesc(static_cast<u64>(sizeof(u32)) * NWB_SURFEL_TRACE_INDIRECT_ARGS_WORD_COUNT, sizeof(u32), true, true, Core::ResourceQueueSharing::GraphicsAndAsyncCompute, Name(s_SurfelResourceTraceIndirectArgs)),
            NWB_TEXT("RendererSystem: failed to create surfel trace indirect-args buffer"),
            false,
            false,
            m_rayTracingState.m_surfelTraceIndirectArgsBuffer
        )
        // Age-free pushes ids and spawn pops them from this persistent free list.
        || !ensureBuffer(
            makeStructuredDesc(ComputeSurfelBufferByteSize(sizeof(u32), poolCapacity), sizeof(u32), true, false, Core::ResourceQueueSharing::GraphicsAndAsyncCompute, Name(s_SurfelResourceFreeList)),
            NWB_TEXT("RendererSystem: failed to create surfel free-list buffer"),
            true,
            false,
            m_rayTracingState.m_surfelFreeListBuffer
        )
        // Bounce gathers read a stable previous-frame pool snapshot.
        || !ensureBuffer(
            makeStructuredDesc(ComputeSurfelBufferByteSize(NWB_SURFEL_RECORD_SIZE, poolCapacity), NWB_SURFEL_RECORD_SIZE, false, false, Core::ResourceQueueSharing::GraphicsAsyncComputeAndTransfer, Name(s_SurfelResourcePoolSnapshot)),
            NWB_TEXT("RendererSystem: failed to create surfel pool snapshot buffer"),
            false,
            false,
            m_rayTracingState.m_surfelPoolSnapshotBuffer
        )
        // Snapshot hash heads alongside the pool for a consistent bounce gather.
        || !ensureBuffer(
            makeStructuredDesc(ComputeSurfelBufferByteSize(sizeof(u32), cellCount), sizeof(u32), false, false, Core::ResourceQueueSharing::GraphicsAsyncComputeAndTransfer, Name(s_SurfelResourceCellHeadSnapshot)),
            NWB_TEXT("RendererSystem: failed to create surfel cell-head snapshot buffer"),
            false,
            false,
            m_rayTracingState.m_surfelCellHeadSnapshotBuffer
        )
        || !ensureBuffer(
            readbackDesc,
            NWB_TEXT("RendererSystem: failed to create surfel counter readback buffer"),
            false,
            false,
            m_rayTracingState.m_surfelCounterReadback
        )
        // Every surfel pass binds this per-frame parameter buffer as a ConstantBuffer.
        || !ensureBuffer(
            constantsDesc,
            NWB_TEXT("RendererSystem: failed to create surfel constant buffer"),
            false,
            false,
            m_rayTracingState.m_surfelConstants
        )
    )
        return false;

    // Persistent descriptors own backing resources until deferred retirement.
    if(
        !RayTracingDetail::EnsureHeapBuffer(Core::GpuDescriptorClass::UniformBuffer, false, heap, *m_rayTracingState.m_surfelConstants.get(), m_rayTracingState.m_surfelConstantsHeapHandle)
        || !RayTracingDetail::EnsureHeapBuffer(Core::GpuDescriptorClass::StorageBuffer, true, heap, *m_rayTracingState.m_surfelPoolBuffer.get(), m_rayTracingState.m_surfelPoolHeapHandle)
        || !RayTracingDetail::EnsureHeapBuffer(Core::GpuDescriptorClass::StorageBuffer, true, heap, *m_rayTracingState.m_surfelGuidePoolBuffer.get(), m_rayTracingState.m_surfelGuidePoolHeapHandle)
        || !RayTracingDetail::EnsureHeapBuffer(Core::GpuDescriptorClass::StorageBuffer, true, heap, *m_rayTracingState.m_surfelCellHeadBuffer.get(), m_rayTracingState.m_surfelCellHeadHeapHandle)
        || !RayTracingDetail::EnsureHeapBuffer(Core::GpuDescriptorClass::StorageBuffer, true, heap, *m_rayTracingState.m_surfelCounterBuffer.get(), m_rayTracingState.m_surfelCounterHeapHandle)
        || !RayTracingDetail::EnsureHeapBuffer(Core::GpuDescriptorClass::StorageBuffer, true, heap, *m_rayTracingState.m_surfelTraceIndirectArgsBuffer.get(), m_rayTracingState.m_surfelTraceIndirectArgsHeapHandle)
        || !RayTracingDetail::EnsureHeapBuffer(Core::GpuDescriptorClass::StorageBuffer, true, heap, *m_rayTracingState.m_surfelFreeListBuffer.get(), m_rayTracingState.m_surfelFreeListHeapHandle)
        || !RayTracingDetail::EnsureHeapBuffer(Core::GpuDescriptorClass::StorageBuffer, false, heap, *m_rayTracingState.m_surfelPoolSnapshotBuffer.get(), m_rayTracingState.m_surfelPoolSnapshotHeapHandle)
        || !RayTracingDetail::EnsureHeapBuffer(Core::GpuDescriptorClass::StorageBuffer, false, heap, *m_rayTracingState.m_surfelCellHeadSnapshotBuffer.get(), m_rayTracingState.m_surfelCellHeadSnapshotHeapHandle)
    ){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to register persistent surfel resources in the descriptor heap"));
        return false;
    }

    // Only tracing differs between hardware and software surfel paths.
    SurfelGiPipelineSet pipelines(m_arena, m_graphics, m_shaderSystem, m_rayTracingState);
    const b8 traceReady = m_rayTracingState.m_surfelUseHwTrace ? pipelines.ensureSurfelTraceHwPipeline() : pipelines.ensureSurfelTracePipeline();
    if(!pipelines.ensureSurfelSpawnPipeline() || !pipelines.ensureSurfelAgeFreePipeline() || !pipelines.ensureSurfelHashBuildPipeline() || !traceReady || !pipelines.ensureSurfelResolvePipeline() || !pipelines.ensureSurfelUpsamplePipeline() || !pipelines.ensureSurfelTraceBuildArgsPipeline())
        return false;
    return true;
}

b8 RendererRayTracingSystem::shouldCaptureSurfelCountReadback()const noexcept{
    return hasSurfelWork() && m_rayTracingState.m_surfelCounterBuffer && m_rayTracingState.m_surfelCounterReadback && !m_rayTracingState.m_surfelCountReadbackSubmissionToken.valid() && IsSurfelCountReadbackDue(m_rayTracingState.m_surfelFrameIndex);
}

b8 RendererRayTracingSystem::prepareSurfelResources(DeferredFrameTargets& targets){
    if(!hasSurfelWork())
        return true;

    m_rayTracingState.m_surfelUseCsgTrace = m_lightSpaceShadow.m_csg.snapshot.hasCsg;
    if(!ensureSurfelResources())
        return false;

    // GI consumes the same selector descriptor as the other current ray effects.
    if(!targets.bindless.valid() || !RayTracingDetail::IsHeapHandle(targets.bindless.slotsBufferDescriptor, Core::GpuDescriptorClass::UniformBuffer) || !RayTraceMaterialResources(m_graphics, m_rayTracingState, m_rayTracingState).ensureRayTraceMaterialContextSlotsHeapHandle()){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: surfel GI trace heap context is incomplete"));
        return false;
    }

    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_surfel_pipelines{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] static b8 EnsureSurfelComputePipeline(
    Core::Alloc::GlobalArena& arena,
    Core::GraphicsBackend::Device& device,
    RendererShaderSystem& shaderSystem,
    const Core::Assets::AssetRef<ComputeShader> GiSubsystem::* member,
    const AStringView variantName,
    const Name& debugName,
    const b8 includeAccelStruct,
    const TStringView passLabel,
    Core::BindingLayoutHandle& inOutLayout,
    Core::ShaderHandle& inOutShader,
    Core::ComputePipelineHandle& inOutPipeline,
    b8& inOutFailed
){
    if(inOutPipeline)
        return true;
    if(inOutFailed)
        return false;

    const Core::GpuDescriptorHeap& heap = device.getDescriptorHeap();
    if(!heap.isInitialized() || (includeAccelStruct && !heap.hasAccelStructLayout())){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: surfel {} requires the initialized global descriptor heap"), passLabel);
        inOutFailed = true;
        return false;
    }
    if(!RendererComputePipelineDetail::EnsurePushConstantBindingLayout(arena, device, sizeof(SurfelHeapPushConstants), Core::ShaderType::Compute, inOutLayout)){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to create surfel {} binding layout"), passLabel);
        inOutFailed = true;
        return false;
    }
    if(!shaderSystem.loadShader<ComputeShader>(member, variantName, debugName, inOutShader)){
        inOutFailed = true;
        return false;
    }
    if(!RendererComputePipelineDetail::CreateHeapComputePipeline(device, inOutShader, inOutLayout, includeAccelStruct, inOutPipeline)){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to create surfel {} compute pipeline"), passLabel);
        inOutFailed = true;
        return false;
    }
    NWB_LOGGER_ESSENTIAL_INFO(NWB_TEXT("RendererSystem: created surfel {} compute pipeline"), passLabel);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 SurfelGiPipelineSet::ensureSurfelSpawnPipeline(){
    return __hidden_surfel_pipelines::EnsureSurfelComputePipeline(
        m_arena,
        m_graphics.getDevice(),
        m_shaderSystem,
        &GiSubsystem::surfelSpawnCs,
        Core::ShaderArchive::s_DefaultVariant,
        "ECSRender_SurfelSpawn",
        false,
        NWB_TEXT("spawn"),
        m_rayTracingState.m_surfelHeapBindingLayout,
        m_rayTracingState.m_surfelSpawnShader,
        m_rayTracingState.m_surfelSpawnPipeline,
        m_rayTracingState.m_surfelSpawnPipelineFailed
    );
}

b8 SurfelGiPipelineSet::ensureSurfelAgeFreePipeline(){
    return __hidden_surfel_pipelines::EnsureSurfelComputePipeline(
        m_arena,
        m_graphics.getDevice(),
        m_shaderSystem,
        &GiSubsystem::surfelAgeFreeCs,
        Core::ShaderArchive::s_DefaultVariant,
        "ECSRender_SurfelAgeFree",
        false,
        NWB_TEXT("age-free"),
        m_rayTracingState.m_surfelHeapBindingLayout,
        m_rayTracingState.m_surfelAgeFreeShader,
        m_rayTracingState.m_surfelAgeFreePipeline,
        m_rayTracingState.m_surfelAgeFreePipelineFailed
    );
}

b8 SurfelGiPipelineSet::ensureSurfelHashBuildPipeline(){
    return __hidden_surfel_pipelines::EnsureSurfelComputePipeline(
        m_arena,
        m_graphics.getDevice(),
        m_shaderSystem,
        &GiSubsystem::surfelHashBuildCs,
        Core::ShaderArchive::s_DefaultVariant,
        "ECSRender_SurfelHashBuild",
        false,
        NWB_TEXT("hash-build"),
        m_rayTracingState.m_surfelHeapBindingLayout,
        m_rayTracingState.m_surfelHashBuildShader,
        m_rayTracingState.m_surfelHashBuildPipeline,
        m_rayTracingState.m_surfelHashBuildPipelineFailed
    );
}

b8 SurfelGiPipelineSet::ensureSurfelTracePipeline(){
    const b8 csg = m_rayTracingState.m_surfelUseCsgTrace;
    return __hidden_surfel_pipelines::EnsureSurfelComputePipeline(
        m_arena,
        m_graphics.getDevice(),
        m_shaderSystem,
        &GiSubsystem::surfelTraceCs,
        ResolveGiCsgVariant(csg),
        "ECSRender_SurfelTrace",
        false,
        NWB_TEXT("trace"),
        m_rayTracingState.m_surfelHeapBindingLayout,
        csg ? m_rayTracingState.m_surfelTraceCsgShader : m_rayTracingState.m_surfelTraceShader,
        csg ? m_rayTracingState.m_surfelTraceCsgPipeline : m_rayTracingState.m_surfelTracePipeline,
        csg ? m_rayTracingState.m_surfelTraceCsgPipelineFailed : m_rayTracingState.m_surfelTracePipelineFailed
    );
}

// Hardware trace twin; other surfel passes are shared.
b8 SurfelGiPipelineSet::ensureSurfelTraceHwPipeline(){
    const b8 csg = m_rayTracingState.m_surfelUseCsgTrace;
    auto& pipeline = csg ? m_rayTracingState.m_surfelTraceCsgHwPipeline : m_rayTracingState.m_surfelTraceHwPipeline;
    auto& shader = csg ? m_rayTracingState.m_surfelTraceCsgHwShader : m_rayTracingState.m_surfelTraceHwShader;
    auto& failed = csg ? m_rayTracingState.m_surfelTraceCsgHwPipelineFailed : m_rayTracingState.m_surfelTraceHwPipelineFailed;

    if(pipeline)
        return true;
    if(failed)
        return false;
    if(!m_graphics.queryFeatureSupport(Core::Feature::RayTracingAccelStruct) || !m_graphics.queryFeatureSupport(Core::Feature::RayQuery)){
        failed = true;
        return false;
    }

    return __hidden_surfel_pipelines::EnsureSurfelComputePipeline(
        m_arena,
        m_graphics.getDevice(),
        m_shaderSystem,
        &GiSubsystem::surfelTraceHwCs,
        ResolveGiCsgVariant(csg),
        "ECSRender_SurfelTraceHw",
        true,
        NWB_TEXT("HW trace"),
        m_rayTracingState.m_surfelHeapBindingLayout,
        shader,
        pipeline,
        failed
    );
}

b8 SurfelGiPipelineSet::ensureSurfelResolvePipeline(){
    return __hidden_surfel_pipelines::EnsureSurfelComputePipeline(
        m_arena,
        m_graphics.getDevice(),
        m_shaderSystem,
        &GiSubsystem::surfelResolveCs,
        Core::ShaderArchive::s_DefaultVariant,
        "ECSRender_SurfelResolve",
        false,
        NWB_TEXT("resolve"),
        m_rayTracingState.m_surfelHeapBindingLayout,
        m_rayTracingState.m_surfelResolveShader,
        m_rayTracingState.m_surfelResolvePipeline,
        m_rayTracingState.m_surfelResolvePipelineFailed
    );
}

b8 SurfelGiPipelineSet::ensureSurfelUpsamplePipeline(){
    return __hidden_surfel_pipelines::EnsureSurfelComputePipeline(
        m_arena,
        m_graphics.getDevice(),
        m_shaderSystem,
        &GiSubsystem::surfelUpsampleCs,
        Core::ShaderArchive::s_DefaultVariant,
        "ECSRender_SurfelUpsample",
        false,
        NWB_TEXT("upsample"),
        m_rayTracingState.m_surfelHeapBindingLayout,
        m_rayTracingState.m_surfelUpsampleShader,
        m_rayTracingState.m_surfelUpsamplePipeline,
        m_rayTracingState.m_surfelUpsamplePipelineFailed
    );
}

b8 SurfelGiPipelineSet::ensureSurfelTraceBuildArgsPipeline(){
    return __hidden_surfel_pipelines::EnsureSurfelComputePipeline(
        m_arena,
        m_graphics.getDevice(),
        m_shaderSystem,
        &GiSubsystem::surfelTraceBuildArgsCs,
        Core::ShaderArchive::s_DefaultVariant,
        "ECSRender_SurfelTraceBuildArgs",
        false,
        NWB_TEXT("trace build-args"),
        m_rayTracingState.m_surfelHeapBindingLayout,
        m_rayTracingState.m_surfelTraceBuildArgsShader,
        m_rayTracingState.m_surfelTraceBuildArgsPipeline,
        m_rayTracingState.m_surfelTraceBuildArgsPipelineFailed
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RendererRayTracingSystem::renderSurfelGiPhases(
    Core::CommandList& commandList,
    DeferredFrameTargets& targets,
    const DeferredLightingGraphResources& deferredLightingResources,
    const b8 dispatchAgeFree,
    const b8 dispatchHashBuild,
    const b8 dispatchSpawn,
    const b8 dispatchTraceBuildArgs,
    const b8 dispatchTrace,
    const b8 dispatchResolve,
    const b8 dispatchRemaining
){
    if(!hasSurfelWork())
        return true;

    NWB_ASSERT(targets.bindless.valid());
    Core::GpuDescriptorHeap& heap = m_graphics.getDevice().getDescriptorHeap();
    if(!heap.isInitialized())
        return false;

    // Only the trace pass is backend-specific.
    const b8 useHwTrace = m_rayTracingState.m_surfelUseHwTrace;
    const b8 useCsgTrace = m_rayTracingState.m_surfelUseCsgTrace;
    Core::ComputePipeline* const tracePipeline = useHwTrace
        ? (useCsgTrace ? m_rayTracingState.m_surfelTraceCsgHwPipeline.get() : m_rayTracingState.m_surfelTraceHwPipeline.get())
        : (useCsgTrace ? m_rayTracingState.m_surfelTraceCsgPipeline.get() : m_rayTracingState.m_surfelTracePipeline.get())
    ;

    if(
        !m_rayTracingState.m_surfelSpawnPipeline
        || !m_rayTracingState.m_surfelAgeFreePipeline
        || !m_rayTracingState.m_surfelHashBuildPipeline
        || !tracePipeline
        || !m_rayTracingState.m_surfelResolvePipeline
        || !m_rayTracingState.m_surfelUpsamplePipeline
        || !m_rayTracingState.m_surfelTraceBuildArgsPipeline
    ){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: active surfel GI phase pipeline is missing"));
        return false;
    }

    if(
        !targets.bindless.valid()
        || !IsValidSurfelGiResolveFactor(targets.surfelResolveFactor)
        || !deferredLightingResources.valid()
        || !RayTracingDetail::IsHeapHandle(m_rayTracingState.m_surfelConstantsHeapHandle, Core::GpuDescriptorClass::UniformBuffer)
        || !RayTracingDetail::IsHeapHandle(m_rayTracingState.m_surfelPoolHeapHandle, Core::GpuDescriptorClass::StorageBuffer)
        || !RayTracingDetail::IsHeapHandle(m_rayTracingState.m_surfelGuidePoolHeapHandle, Core::GpuDescriptorClass::StorageBuffer)
        || !RayTracingDetail::IsHeapHandle(m_rayTracingState.m_surfelCellHeadHeapHandle, Core::GpuDescriptorClass::StorageBuffer)
        || !RayTracingDetail::IsHeapHandle(m_rayTracingState.m_surfelCounterHeapHandle, Core::GpuDescriptorClass::StorageBuffer)
        || !RayTracingDetail::IsHeapHandle(m_rayTracingState.m_surfelTraceIndirectArgsHeapHandle, Core::GpuDescriptorClass::StorageBuffer)
        || !RayTracingDetail::IsHeapHandle(m_rayTracingState.m_surfelFreeListHeapHandle, Core::GpuDescriptorClass::StorageBuffer)
        || !RayTracingDetail::IsHeapHandle(m_rayTracingState.m_surfelPoolSnapshotHeapHandle, Core::GpuDescriptorClass::StorageBuffer)
        || !RayTracingDetail::IsHeapHandle(m_rayTracingState.m_surfelCellHeadSnapshotHeapHandle, Core::GpuDescriptorClass::StorageBuffer)
        || !RayTracingDetail::IsHeapHandle(m_rayTracingState.m_rayTraceMaterialContextSlotsHeapHandle, Core::GpuDescriptorClass::UniformBuffer)
        || !RayTracingDetail::IsHeapHandle(targets.bindless.slotsBufferDescriptor, Core::GpuDescriptorClass::UniformBuffer)
        || !RayTracingDetail::IsHeapHandle(targets.bindless.gbufferWorldPosition, Core::GpuDescriptorClass::SampledImage)
        || !RayTracingDetail::IsHeapHandle(targets.bindless.gbufferNormal, Core::GpuDescriptorClass::SampledImage)
        || !RayTracingDetail::IsHeapHandle(targets.bindless.surfelIrradianceHalf, Core::GpuDescriptorClass::SampledImage)
        || !RayTracingDetail::IsHeapHandle(targets.bindless.surfelIrradianceHalfStorage, Core::GpuDescriptorClass::StorageImage)
        || !RayTracingDetail::IsHeapHandle(targets.bindless.surfelIrradianceStorage, Core::GpuDescriptorClass::StorageImage)
        || (useHwTrace && (!m_rayTracingState.m_tlas || !RayTracingDetail::IsHeapHandle(m_rayTracingState.m_tlasHeapHandle, Core::GpuDescriptorClass::AccelStruct)))
    ){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: surfel GI heap registration is incomplete"));
        return false;
    }

    const u32 poolCapacity = m_rayTracingState.m_surfelPoolCapacity;

    SurfelHeapPushConstants surfelPush = MakeSurfelHeapPushConstants(
        m_rayTracingState.m_surfelConstantsHeapHandle.slot(),
        m_rayTracingState.m_surfelPoolHeapHandle.slot(),
        m_rayTracingState.m_surfelGuidePoolHeapHandle.slot(),
        m_rayTracingState.m_surfelCellHeadHeapHandle.slot(),
        m_rayTracingState.m_surfelCounterHeapHandle.slot(),
        m_rayTracingState.m_surfelFreeListHeapHandle.slot(),
        m_rayTracingState.m_surfelPoolSnapshotHeapHandle.slot(),
        m_rayTracingState.m_surfelCellHeadSnapshotHeapHandle.slot(),
        m_rayTracingState.m_surfelTraceIndirectArgsHeapHandle.slot(),
        targets.bindless.slotsBufferDescriptor.slot(),
        m_rayTracingState.m_rayTraceMaterialContextSlotsHeapHandle.slot()
    );

    // Order every in-place field update, including prior-frame spawn writes.
    commandList.setEnableUavBarriersForBuffer(m_rayTracingState.m_surfelPoolBuffer.get(), true);
    commandList.setEnableUavBarriersForBuffer(m_rayTracingState.m_surfelGuidePoolBuffer.get(), true);
    commandList.setEnableUavBarriersForBuffer(m_rayTracingState.m_surfelCellHeadBuffer.get(), true);
    commandList.setEnableUavBarriersForBuffer(m_rayTracingState.m_surfelCounterBuffer.get(), true);
    commandList.setEnableUavBarriersForBuffer(m_rayTracingState.m_surfelFreeListBuffer.get(), true);
    commandList.setEnableUavBarriersForBuffer(m_rayTracingState.m_surfelTraceIndirectArgsBuffer.get(), true);

    // Age-free recycles unseen surfels before the graph-owned cell-head reset and hash rebuild.
    if(dispatchAgeFree){
        Core::GpuTimingMeasure timing(m_graphics.gpuTiming(), RendererGpuTimingScope::s_SurfelAgeFree, m_graphics.getDevice(), commandList);

        commandList.commitBarriers();
        Core::ComputeState state;
        state.setPipeline(m_rayTracingState.m_surfelAgeFreePipeline.get());
        commandList.setComputeState(state);
        heap.bindCompute(commandList, *m_rayTracingState.m_surfelAgeFreePipeline.get());
        commandList.setPushConstants(&surfelPush, sizeof(surfelPush));
        commandList.dispatch(DivideUp(poolCapacity, static_cast<u32>(NWB_SURFEL_LINEAR_GROUP_SIZE)), 1u, 1u);
    }

    if(!dispatchHashBuild && !dispatchSpawn && !dispatchTraceBuildArgs && !dispatchTrace && !dispatchResolve && !dispatchRemaining)
        return true;

    // Rebuild bucket lists before spawning uncovered surface representatives.
    if(dispatchHashBuild){
        Core::GpuTimingMeasure timing(m_graphics.gpuTiming(), RendererGpuTimingScope::s_SurfelHashBuild, m_graphics.getDevice(), commandList);

        commandList.commitBarriers();
        Core::ComputeState state;
        state.setPipeline(m_rayTracingState.m_surfelHashBuildPipeline.get());
        commandList.setComputeState(state);
        heap.bindCompute(commandList, *m_rayTracingState.m_surfelHashBuildPipeline.get());
        commandList.setPushConstants(&surfelPush, sizeof(surfelPush));
        commandList.dispatch(DivideUp(poolCapacity, static_cast<u32>(NWB_SURFEL_LINEAR_GROUP_SIZE)), 1u, 1u);
    }

    if(!dispatchSpawn && !dispatchTraceBuildArgs && !dispatchTrace && !dispatchResolve && !dispatchRemaining)
        return true;

    // Spawn retains compatible surfaces and inserts uncovered candidates into bounded bucket lists.
    if(dispatchSpawn){
        Core::GpuTimingMeasure timing(m_graphics.gpuTiming(), RendererGpuTimingScope::s_SurfelSpawn, m_graphics.getDevice(), commandList);

        commandList.commitBarriers();

        surfelPush.worldPositionSlot = targets.bindless.gbufferWorldPosition.slot();
        surfelPush.normalSlot = targets.bindless.gbufferNormal.slot();

        Core::ComputeState state;
        state.setPipeline(m_rayTracingState.m_surfelSpawnPipeline.get());
        commandList.setComputeState(state);
        heap.bindCompute(commandList, *m_rayTracingState.m_surfelSpawnPipeline.get());
        commandList.setPushConstants(&surfelPush, sizeof(surfelPush));
        commandList.dispatch(ResolveSurfelSpawnDispatchGroup(targets.width, static_cast<u32>(NWB_SURFEL_GROUP_SIZE)), ResolveSurfelSpawnDispatchGroup(targets.height, static_cast<u32>(NWB_SURFEL_GROUP_SIZE)), 1u);
    }

    if(!dispatchTraceBuildArgs && !dispatchTrace && !dispatchResolve && !dispatchRemaining)
        return true;

    // Build an indirect dispatch sized for live surfels.
    if(dispatchTraceBuildArgs){
        commandList.commitBarriers();
        Core::ComputeState state;
        state.setPipeline(m_rayTracingState.m_surfelTraceBuildArgsPipeline.get());
        commandList.setComputeState(state);
        heap.bindCompute(commandList, *m_rayTracingState.m_surfelTraceBuildArgsPipeline.get());
        commandList.setPushConstants(&surfelPush, sizeof(surfelPush));
        commandList.dispatch(NWB_SURFEL_TRACE_BUILD_ARGS_DISPATCH_GROUP_COUNT_X, NWB_SURFEL_TRACE_BUILD_ARGS_DISPATCH_GROUP_COUNT_Y, NWB_SURFEL_TRACE_BUILD_ARGS_DISPATCH_GROUP_COUNT_Z);
    }

    if(!dispatchTrace && !dispatchResolve && !dispatchRemaining)
        return true;

    if(dispatchTrace){
        Core::GpuTimingMeasure timing(m_graphics.gpuTiming(), RendererGpuTimingScope::s_SurfelTrace, m_graphics.getDevice(), commandList);

        commandList.commitBarriers();
        Core::ComputeState state;
        state.setPipeline(tracePipeline);
        state.setIndirectParams(m_rayTracingState.m_surfelTraceIndirectArgsBuffer.get());
        commandList.setComputeState(state);
        // Hardware trace additionally selects the TLAS generation at set 2.
        if(m_rayTracingState.m_surfelUseHwTrace && !m_rayTracingState.m_tlasHeapHandle.valid()){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: cannot dispatch surfel HW GI without the descriptor-heap TLAS handle"));
            return false;
        }
        const Core::GpuDescriptorHandle tlasHeapHandle = m_rayTracingState.m_surfelUseHwTrace ? m_rayTracingState.m_tlasHeapHandle : Core::GpuDescriptorHandle::Invalid();
        heap.bindCompute(commandList, *tracePipeline, tlasHeapHandle);
        commandList.setPushConstants(&surfelPush, sizeof(surfelPush));
        commandList.dispatchIndirect(0u);
    }

    if(!dispatchResolve && !dispatchRemaining)
        return true;

    // Resolve at the target generation's selected scale so deferred lighting never touches the writable pool.
    if(dispatchResolve){
        const SurfelGiResolveSize resolveSize = MakeSurfelGiResolveSize(targets.width, targets.height, targets.surfelResolveFactor);
        {
            Core::GpuTimingMeasure timing(m_graphics.gpuTiming(), RendererGpuTimingScope::s_SurfelResolve, m_graphics.getDevice(), commandList);

            commandList.commitBarriers();

            surfelPush.worldPositionSlot = targets.bindless.gbufferWorldPosition.slot();
            surfelPush.normalSlot = targets.bindless.gbufferNormal.slot();
            surfelPush.outputStorageHeapSlot = targets.bindless.surfelIrradianceHalfStorage.slot();

            Core::ComputeState state;
            state.setPipeline(m_rayTracingState.m_surfelResolvePipeline.get());
            commandList.setComputeState(state);
            heap.bindCompute(commandList, *m_rayTracingState.m_surfelResolvePipeline.get());
            commandList.setPushConstants(&surfelPush, sizeof(surfelPush));
            const u32 groupSize = static_cast<u32>(NWB_SURFEL_RESOLVE_GROUP_SIZE);
            commandList.dispatch(DivideUp(resolveSize.width, groupSize), DivideUp(resolveSize.height, groupSize), 1u);
            if(commandList.commandRecordingFailed())
                return false;
            LogSurfelGiResolveDispatchIfNeeded(targets.surfelResolveFactor, targets.width, targets.height, resolveSize, m_rayTracingState.m_surfelResolveDispatchLogged);
        }
    }

    if(!dispatchRemaining)
        return true;

    // Surface-aware upsample preserves coverage across edges.
    {
        Core::GpuTimingMeasure timing(m_graphics.gpuTiming(), RendererGpuTimingScope::s_SurfelUpsample, m_graphics.getDevice(), commandList);

        commandList.commitBarriers();

        surfelPush.halfIrradianceSlot = targets.bindless.surfelIrradianceHalf.slot();
        surfelPush.normalSlot = targets.bindless.gbufferNormal.slot();
        surfelPush.worldPositionSlot = targets.bindless.gbufferWorldPosition.slot();
        surfelPush.outputStorageHeapSlot = targets.bindless.surfelIrradianceStorage.slot();

        Core::ComputeState state;
        state.setPipeline(m_rayTracingState.m_surfelUpsamplePipeline.get());
        commandList.setComputeState(state);
        heap.bindCompute(commandList, *m_rayTracingState.m_surfelUpsamplePipeline.get());
        commandList.setPushConstants(&surfelPush, sizeof(surfelPush));
        const u32 groupSize = static_cast<u32>(NWB_SURFEL_UPSAMPLE_GROUP_SIZE);
        commandList.dispatch(DivideUp(targets.width, groupSize), DivideUp(targets.height, groupSize), 1u);
    }

    // The graph-owned late copy publishes its token only after Transfer/Compute/Graphics accepts. This pass only consumes completed diagnostics.
    {
        const u32 frameIndex = m_rayTracingState.m_surfelFrameIndex;
        const Core::QueueSubmissionToken submissionToken = m_rayTracingState.m_surfelCountReadbackSubmissionToken;
        b8 submissionComplete = false;
        if(submissionToken.valid() && submissionToken.hasPhysicalQueueIdentity()){
            const Expected<u64> completedValue = m_graphics.getDevice().queueGetCompletedInstance(Core::GpuPhysicalQueueId{ .index = submissionToken.physicalQueueIndex, .deviceGeneration = submissionToken.deviceGeneration, });
            submissionComplete = completedValue && *completedValue >= submissionToken.value;
        }
        if(submissionComplete && IsSurfelCountReadbackDelayElapsed(frameIndex, m_rayTracingState.m_surfelCountReadbackFrame)){
            Core::Buffer& readback = *m_rayTracingState.m_surfelCounterReadback;
            const Expected<void*> mappedCounts = m_graphics.getDevice().mapBuffer(readback, Core::CpuAccessMode::Read);
            if(mappedCounts){
                const NotNull<const u32*> counts = MakeNotNull(static_cast<const u32*>(*mappedCounts));
                const u32 bumpTop = counts.get()[NWB_SURFEL_COUNTER_BUMP_TOP];
                const u32 freeTop = counts.get()[NWB_SURFEL_COUNTER_FREE_TOP];
                const u32 geometryFailures = counts.get()[NWB_SURFEL_COUNTER_TRACE_GEOMETRY_FAILURE];
                m_graphics.getDevice().unmapBuffer(readback);
                LogSurfelCountReadbackCounts(
                    bumpTop,
                    freeTop,
                    geometryFailures,
                    m_rayTracingState.m_surfelPoolCapacity,
                    m_rayTracingState.m_surfelTraceGeometryFailureFlags
                );
            }
            m_rayTracingState.m_surfelCountReadbackSubmissionToken = {};
        }
    }

    // Subsequent frames use steady-state round-robin updates.
    AdvanceSurfelGiFrameState(m_rayTracingState.m_surfelSeeded, m_rayTracingState.m_surfelFrameIndex);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_rt_surfel_tasks{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(sizeof(NwbSurfelConstantsGpu) == sizeof(Float4) * NWB_SURFEL_CONSTANTS_FLOAT4_COUNT, "NwbSurfelConstantsGpu must match the shader NwbSurfelConstants layout");
static_assert(s_SurfelUpdateDivisor == NWB_SURFEL_UPDATE_DIVISOR, "s_SurfelUpdateDivisor must match NWB_SURFEL_UPDATE_DIVISOR");
static_assert(s_SurfelCellSize == NWB_SURFEL_CELL_SIZE, "s_SurfelCellSize must match NWB_SURFEL_CELL_SIZE");
static_assert(s_SurfelDefaultRadius == NWB_SURFEL_DEFAULT_RADIUS, "s_SurfelDefaultRadius must match NWB_SURFEL_DEFAULT_RADIUS");
static_assert(s_SurfelMaxAccum == NWB_SURFEL_MAX_ACCUM, "s_SurfelMaxAccum must match NWB_SURFEL_MAX_ACCUM");
static_assert(s_SurfelMaxAge == NWB_SURFEL_MAX_AGE, "s_SurfelMaxAge must match NWB_SURFEL_MAX_AGE");
static_assert(s_SurfelRaysPerSurfel == NWB_SURFEL_RAYS_PER_SURFEL, "s_SurfelRaysPerSurfel must match NWB_SURFEL_RAYS_PER_SURFEL");
static_assert(s_SurfelSpawnTile == NWB_SURFEL_SPAWN_TILE, "s_SurfelSpawnTile must match NWB_SURFEL_SPAWN_TILE");


struct SurfelGiAsyncPassPayload{
    RendererRayTracingSystem& raytracingSystem;
    DeferredFrameTargets& targets;
    DeferredLightingGraphResources deferredLightingResources;
    Core::GpuTimingSubmissionTicket& timingTicket;
    Optional<Core::GpuTimingMeasure>& asyncTiming;
};

// Hash-build, spawn, trace-args, trace, and resolve share one async-guard preamble; only the render call differs.
template<typename PayloadT>
[[nodiscard]] inline b8 SurfelAsyncRecordReady(const PayloadT& payload, const Core::GpuTaskRecordContext& context)noexcept(
    noexcept(static_cast<b8>(!payload.deferredLightingResources.valid()))
    && noexcept(static_cast<b8>(!DeclVal<const Core::GpuPhysicalQueueInfo*>() || (DeclVal<const Core::GpuPhysicalQueueInfo*>()->queueClass == Core::CommandQueue::Compute && !payload.asyncTiming.has_value())))
){
    if(!payload.deferredLightingResources.valid())
        return false;

    const Core::GpuPhysicalQueueInfo* const queue = context.compiledPlan.queueInfo(context.queue);
    if(!queue || (queue->queueClass == Core::CommandQueue::Compute && !payload.asyncTiming.has_value()))
        return false;
    return true;
}

template<b8 DispatchHashBuild, b8 DispatchSpawn, b8 DispatchTraceBuildArgs, b8 DispatchTrace, b8 DispatchResolve>
[[nodiscard]] inline b8 RecordSurfelGiAsyncPass(const SurfelGiAsyncPassPayload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext& context){
    if(!SurfelAsyncRecordReady(payload, context))
        return false;

    Core::GpuTimingSubmissionTicket::RecordingScope timingRecording(payload.timingTicket);
    if(!payload.raytracingSystem.renderSurfelGiPhases(
        commandList,
        payload.targets,
        payload.deferredLightingResources,
        false,
        DispatchHashBuild,
        DispatchSpawn,
        DispatchTraceBuildArgs,
        DispatchTrace,
        DispatchResolve,
        false
    )){
        if(payload.asyncTiming.has_value()){
            payload.asyncTiming.value().discardTiming();
            payload.asyncTiming.reset();
        }
        return false;
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct SurfelGiAgeFreeGraphTask{
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements = { Core::GpuQueueCapability::Compute };


public:
    // All bindings are required: age/free always brackets the async surfel range for this frame.
    struct Payload{
        RendererRayTracingSystem& raytracingSystem;
        Core::GraphicsRuntime& graphics;
        DeferredFrameTargets& targets;
        DeferredLightingGraphResources deferredLightingResources;
        Core::GpuTimingSubmissionTicket& timingTicket;
        Optional<Core::GpuTimingMeasure>& asyncTiming;
    };


public:
    [[nodiscard]] static b8 Record(const Payload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext& context){
        if(!payload.deferredLightingResources.valid())
            return false;

        const Core::GpuPhysicalQueueInfo* const queue = context.compiledPlan.queueInfo(context.queue);
        if(!queue || payload.asyncTiming.has_value())
            return false;

        Core::GpuTimingSubmissionTicket::RecordingScope timingRecording(payload.timingTicket);
        if(queue->queueClass == Core::CommandQueue::Compute)
            payload.asyncTiming.emplace(payload.graphics.gpuTiming(), RendererGpuTimingScope::s_AsyncSurfelGi, payload.graphics.getDevice(), commandList);

        if(!payload.raytracingSystem.renderSurfelGiPhases(commandList, payload.targets, payload.deferredLightingResources, true, false, false, false, false, false, false)){
            if(payload.asyncTiming.has_value()){
                payload.asyncTiming.value().discardTiming();
                payload.asyncTiming.reset();
            }
            return false;
        }
        // The endpoint follows in the remaining-GI callback, but this nested marker must close before the recorder advances.
        if(payload.asyncTiming.has_value() && !Core::FinishSplitGpuTimingMarker(&payload.asyncTiming))
            return false;
        return true;
    }

    static void Discarded(Payload& payload)noexcept{
        Core::DiscardGpuTimingMeasure(&payload.asyncTiming);
    }
};

template<b8 DispatchHashBuild, b8 DispatchSpawn, b8 DispatchTraceBuildArgs, b8 DispatchTrace, b8 DispatchResolve>
struct SurfelGiAsyncPassGraphTask{
    using Payload = SurfelGiAsyncPassPayload;


public:
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements = { Core::GpuQueueCapability::Compute };


public:
    [[nodiscard]] static b8 Record(const Payload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext& context){
        return RecordSurfelGiAsyncPass<DispatchHashBuild, DispatchSpawn, DispatchTraceBuildArgs, DispatchTrace, DispatchResolve>(payload, commandList, context);
    }

    static void Accepted(Payload& payload, const Core::QueueSubmissionToken& token)noexcept requires(DispatchTrace){
        payload.raytracingSystem.confirmRayTraceContextReadSubmission(token);
    }

    static void Discarded(Payload& payload)noexcept{
        Core::DiscardGpuTimingMeasure(&payload.asyncTiming);
    }
};

using SurfelGiHashBuildGraphTask = SurfelGiAsyncPassGraphTask<true, false, false, false, false>;
using SurfelGiSpawnGraphTask = SurfelGiAsyncPassGraphTask<false, true, false, false, false>;
using SurfelGiTraceBuildArgsGraphTask = SurfelGiAsyncPassGraphTask<false, false, true, false, false>;
using SurfelGiTraceGraphTask = SurfelGiAsyncPassGraphTask<false, false, false, true, false>;
using SurfelGiResolveGraphTask = SurfelGiAsyncPassGraphTask<false, false, false, false, true>;

struct SurfelGiGraphTask{
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements = { Core::GpuQueueCapability::Compute };


public:
    // The raytracing system, the frame targets, and the timing ticket are required: the fallback upsample always records against this frame's ticket.
    // The async timing stays optional: only the resolve-owning route brackets the shared async surfel range.
    struct Payload{
        RendererRayTracingSystem& raytracingSystem;
        DeferredFrameTargets& targets;
        DeferredLightingGraphResources deferredLightingResources;
        Core::GpuTimingSubmissionTicket& timingTicket;
        Optional<Core::GpuTimingMeasure>* asyncTiming = nullptr;
    };


public:
    [[nodiscard]] static b8 Record(const Payload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext& context){
        if(!payload.deferredLightingResources.valid())
            return false;

        const Core::GpuPhysicalQueueInfo* const queue = context.compiledPlan.queueInfo(context.queue);
        if(!queue)
            return false;

        Core::GpuTimingSubmissionTicket::RecordingScope timingRecording(payload.timingTicket);
        if(payload.raytracingSystem.hasSurfelWork() && queue->queueClass == Core::CommandQueue::Compute && (!payload.asyncTiming || !payload.asyncTiming->has_value()))
            return false;
        if(!payload.raytracingSystem.renderSurfelGiPhases(commandList, payload.targets, payload.deferredLightingResources, false, false, false, false, false, false, true)){
            if(payload.asyncTiming && payload.asyncTiming->has_value()){
                payload.asyncTiming->value().discardTiming();
                payload.asyncTiming->reset();
            }
            return false;
        }
        if(payload.asyncTiming && payload.asyncTiming->has_value()){
            payload.asyncTiming->value().finishTiming(commandList);
            payload.asyncTiming->reset();
        }
        return true;
    }

    static void Discarded(Payload& payload)noexcept{
        Core::DiscardGpuTimingMeasure(payload.asyncTiming);
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The typed clear primitives own the four persistent-buffer writes.
// The CPU mirror becomes pending after every clear records and initialized after their shared packet accepts.
// The raytracing system is required: the lifecycle always records against this frame's system.
struct RendererRayTracingSystem::SurfelGiInitializationLifecycleGraphTask{
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements = {};


public:
    struct Payload{
        RendererRayTracingSystem& raytracingSystem;
    };


public:
    [[nodiscard]] static b8 Record(const Payload& payload, [[maybe_unused]] Core::CommandList& commandList, [[maybe_unused]] const Core::GpuTaskRecordContext& context)noexcept{
        return payload.raytracingSystem.recordSurfelResourceInitializationLifecycle();
    }

    static void Discarded(Payload& payload)noexcept{
        payload.raytracingSystem.discardSurfelResourceInitialization();
    }

    static void Accepted(Payload& payload, [[maybe_unused]] const Core::QueueSubmissionToken& token)noexcept{
        payload.raytracingSystem.finalizeSurfelResourceInitialization();
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<Core::GpuTaskId> RendererRayTracingSystem::declareSurfelResourceInitializationLifecycleTask(Core::GpuTaskGraph& graph, const Core::GpuTaskDesc& desc){
    return graph.addTask<SurfelGiInitializationLifecycleGraphTask>(desc, SurfelGiInitializationLifecycleGraphTask::Payload{ .raytracingSystem = *this, });
}

Expected<Core::GpuTaskId> SurfelGiTaskBuilder::declareAgeFreeTask(
    const Core::GpuTaskDesc& desc,
    const DeferredLightingGraphResources& deferredLightingResources,
    DeferredFrameTargets& targets,
    Core::GpuTimingSubmissionTicket& timingTicket,
    Optional<Core::GpuTimingMeasure>& asyncTiming
){
    return m_graph.addTask<__hidden_rt_surfel_tasks::SurfelGiAgeFreeGraphTask>(
        desc,
        __hidden_rt_surfel_tasks::SurfelGiAgeFreeGraphTask::Payload{
            .raytracingSystem = m_system,
            .graphics = m_system.graphics(),
            .targets = targets,
            .deferredLightingResources = deferredLightingResources,
            .timingTicket = timingTicket,
            .asyncTiming = asyncTiming,
        });
}

