////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <loader/project_entry.adhd>
#include <impl/assets_graphics/bindless/runtime_abi.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ConfigureProject(mut ProjectStartupContext context){
    mut GraphicsRuntime graphics = context.graphics;
    if(!graphics.setBindlessHeapAbi(MakeGpuDescriptorHeapAbi()))
        return false;
#if defined(NWB_SMOKE_ENABLE_SWAP_CHAIN_READBACK)
    if(!graphics.setSwapChainReadbackEnabled(true))
        return false;
#endif
#if defined(NWB_SMOKE_DISABLE_ASYNC_COMPUTE)
    return graphics.setAsyncComputeLaneEnabled(false);
#else
    return graphics.setAsyncComputeLaneEnabled(true);
#endif
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

