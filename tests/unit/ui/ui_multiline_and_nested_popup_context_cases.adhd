    }
}

void VerifyUiMultilineText_RejectsMalformedUtf8AndNonScalarSequences(){
    Array<StringView, 26u> cases = Array<StringView, 26u>();
    cases[0u] = "\x80";
    cases[1u] = "\xBF";
    cases[2u] = "\xC0\x80";
    cases[3u] = "\xC0\xAF";
    cases[4u] = "\xC1\xBF";
    cases[5u] = "\xE0\x80\x80";
    cases[6u] = "\xF0\x80\x80\x80";
    cases[7u] = "\xED\xA0\x80";
    cases[8u] = "\xED\xBF\xBF";
    cases[9u] = "\xF4\x90\x80\x80";
    cases[10u] = "\xF5\x80\x80\x80";
    cases[11u] = "\xFE";
    cases[12u] = "\xFF";
    cases[13u] = "\xC2";
    cases[14u] = "\xE2";
    cases[15u] = "\xE2\x82";
    cases[16u] = "\xF0";
    cases[17u] = "\xF0\x9F";
    cases[18u] = "\xF0\x9F\x92";
    cases[19u] = "\xC2 ";
    cases[20u] = "\xE2\x28\xA1";
    cases[21u] = "\xF0\x28\x8C\xBC";
    cases[22u] = "\xE2\x82x";
    cases[23u] = "\xF8\x88\x80\x80\x80";
    cases[24u] = "valid\r\n\xED\xA0\x80";
    cases[25u] = s_UiMultilineTextEmbeddedNulShort;
    UiMultilineTextArena arena = UiMultilineTextArena();
