#include "style.adhd"
#include <impl/ecs_ui/toolkit/paint.adhd>
#include <impl/ecs_ui/toolkit/text/service.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_PlotDefaultHeight = 160.0f;
const f32 s_PlotDefaultPadding = 8.0f;
const f32 s_PlotDefaultLineThickness = 2.0f;
const f32 s_PlotDefaultBarGapFraction = 0.2f;
const f32 s_PlotDefaultAreaFillAlpha = 0.25f;
const f32 s_PlotDefaultAxisThickness = 1.0f;
const f32 s_PlotDefaultCrosshairThickness = 1.0f;
const f32 s_PlotDefaultMarkerRadius = 3.5f;
const f32 s_PlotDefaultLegendSwatchSize = 10.0f;
const f32 s_PlotDefaultLegendGap = 6.0f;
const Color s_PlotDefaultBgColor = Color(0.09f, 0.11f, 0.15f, 1.0f);
const Color s_PlotDefaultBorderColor = Color(0.28f, 0.32f, 0.38f, 0.90f);
const Color s_PlotDefaultGridColor = Color(0.24f, 0.28f, 0.34f, 0.55f);
const Color s_PlotDefaultAxisColor = Color(0.45f, 0.50f, 0.58f, 0.85f);
const Color s_PlotDefaultCrosshairColor = Color(0.85f, 0.88f, 0.94f, 0.70f);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> PlotKind{
    Line,
    Bar,
    Area,
    kCount,
}

class PlotSeries{
    public StringView label = "";
    public Span<f32> values;
    public Color color = Color(0.32f, 0.72f, 0.98f, 1.0f);
    public f32 lineThickness = s_PlotDefaultLineThickness;
    public PlotKind kind = PlotKind::Line;
}

class PlotStyle{
    public Color backgroundColor = s_PlotDefaultBgColor;
    public Color borderColor = s_PlotDefaultBorderColor;
    public Color gridColor = s_PlotDefaultGridColor;
    public Color axisColor = s_PlotDefaultAxisColor;
    public Color crosshairColor = s_PlotDefaultCrosshairColor;
    public Color textColor = s_StyleTextColor;
    public Insets padding = Insets(s_PlotDefaultPadding, s_PlotDefaultPadding, s_PlotDefaultPadding, s_PlotDefaultPadding);
    public f32 barGapFraction = s_PlotDefaultBarGapFraction;
    public f32 areaFillAlpha = s_PlotDefaultAreaFillAlpha;
}

class PlotOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public LayoutSize height = LayoutSize(LayoutSizePolicy::Fixed, s_PlotDefaultHeight);
    public b8 autoScaleY = true;
    public f32 minY = 0.0f;
    public f32 maxY = 1.0f;
    public u32 gridLinesX = 4u;
    public u32 gridLinesY = 4u;
    public b8 showGrid = true;
    public b8 showZeroLine = true;
    public b8 showCrosshair = true;
    public b8 showLegend = false;
    public b8 enabled = true;
    public LayoutItemOptions layout;
}

class PlotResult{
    public b8 valid = false;
    public b8 hovered = false;
    public usize hoveredSampleIndex = 0u;
    public f32 hoveredValue = 0.0f;
    public f32 computedMinY = 0.0f;
    public f32 computedMaxY = 1.0f;
}

interface ICanvasPainter{
    b8 paint(mut PaintBuilder paint, mut TextService text, in Rect bounds, in Rect clip);
}

class CanvasOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public LayoutSize height = LayoutSize(LayoutSizePolicy::Fixed, s_PlotDefaultHeight);
    public b8 clipToBounds = true;
    public b8 interactive = true;
    public b8 enabled = true;
    public Color backgroundColor = s_PlotDefaultBgColor;
    public b8 fillBackground = false;
    public Color borderColor = s_PlotDefaultBorderColor;
    public b8 drawBorder = false;
    public LayoutItemOptions layout;
}

class CanvasResult{
    public b8 valid = false;
    public b8 hovered = false;
    public b8 dragging = false;
    public b8 clicked = false;
    public Point localPointer;
    public Point dragOrigin;
    public Point dragDelta;
    public f64 wheelDelta = 0.0;
    public Rect bounds;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidPlotSeriesSpan(in Span<PlotSeries> series){
    for(in PlotSeries s : series){
        if(s.kind >= PlotKind::kCount)
            return false;
        if(!IsValidPaintColor(s.color))
            return false;
        if(!IsFinite(VectorSingle(s.lineThickness)) || s.lineThickness <= 0.0f)
            return false;
    }
    return true;
}

b8 IsValidPlotOptions(in PlotOptions options){
    return IsValidLayoutSize(options.width)
        && IsValidLayoutSize(options.height)
        && (options.autoScaleY || (IsFinite(VectorSingle(options.minY, options.maxY, 0.0f, 0.0f)) && options.maxY > options.minY));
}

b8 IsValidPlotStyle(in PlotStyle style){
    return IsValidPaintColor(style.backgroundColor)
        && IsValidPaintColor(style.borderColor)
        && IsValidPaintColor(style.gridColor)
        && IsValidPaintColor(style.axisColor)
        && IsValidPaintColor(style.crosshairColor)
        && IsValidPaintColor(style.textColor)
        && IsBoundedUiPadding(style.padding)
        && IsFinite(VectorSingle(style.barGapFraction, style.areaFillAlpha, 0.0f, 0.0f))
        && style.barGapFraction >= 0.0f && style.barGapFraction < 1.0f
        && style.areaFillAlpha >= 0.0f && style.areaFillAlpha <= 1.0f;
}

b8 IsValidCanvasOptions(in CanvasOptions options){
    return IsValidLayoutSize(options.width)
        && IsValidLayoutSize(options.height)
        && (!options.fillBackground || IsValidPaintColor(options.backgroundColor))
        && (!options.drawBorder || IsValidPaintColor(options.borderColor));
}

b8 ComputePlotAutoRangeSimd(in Span<PlotSeries> series, mut f32 outMinY, mut f32 outMaxY){
    b8 hasFinite = false;
    VectorSingle minVec(s_UiMaxFloat);
    VectorSingle maxVec(-s_UiMaxFloat);
    for(in PlotSeries s : series){
        in Span<f32> vals = s.values;
        const usize n = vals.size();
        usize i = 0u;
        while(i + 4u <= n){
            const VectorSingle v4(vals[i], vals[i + 1u], vals[i + 2u], vals[i + 3u]);
            if(IsFinite(v4)){
                minVec = Min(minVec, v4);
                maxVec = Max(maxVec, v4);
                hasFinite = true;
            }
            else{
                for(usize k = 0u; k < 4u; ++k){
                    const f32 v = vals[i + k];
                    if(IsFinite(VectorSingle(v))){
                        const VectorSingle vs(v);
                        minVec = Min(minVec, vs);
                        maxVec = Max(maxVec, vs);
                        hasFinite = true;
                    }
                }
            }
            i += 4u;
        }
        while(i < n){
            const f32 v = vals[i];
            if(IsFinite(VectorSingle(v))){
                const VectorSingle vs(v);
                minVec = Min(minVec, vs);
                maxVec = Max(maxVec, vs);
                hasFinite = true;
            }
            ++i;
        }
    }
    if(!hasFinite){
        outMinY = 0.0f;
        outMaxY = 1.0f;
        return true;
    }
    const VectorSingle minPair = Min(minVec, minVec.zwxy);
    outMinY = Min(minPair, minPair.yxwz).x;
    const VectorSingle maxPair = Max(maxVec, maxVec.zwxy);
    outMaxY = Max(maxPair, maxPair.yxwz).x;
    if(outMaxY <= outMinY){
        outMinY -= 1.0f;
        outMaxY += 1.0f;
    }
    return true;
}

void ApplySkinPaletteToPlotStyle(in UiSkinPalette palette, mut PlotStyle style){
    style.textColor = ResolveUiSkinColor(palette, UiSkinColorRole::TextNormal);
    style.borderColor = ResolveUiSkinColor(palette, UiSkinColorRole::TextDisabled);
}


