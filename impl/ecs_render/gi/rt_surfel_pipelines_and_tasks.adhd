////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Name s_SurfelSpawnShaderDebugName = "ECSRender_SurfelSpawn";
const Name s_SurfelAgeFreeShaderDebugName = "ECSRender_SurfelAgeFree";
const Name s_SurfelHashBuildShaderDebugName = "ECSRender_SurfelHashBuild";
const Name s_SurfelTraceShaderDebugName = "ECSRender_SurfelTrace";
const Name s_SurfelTraceHwShaderDebugName = "ECSRender_SurfelTraceHw";
const Name s_SurfelResolveShaderDebugName = "ECSRender_SurfelResolve";
const Name s_SurfelUpsampleShaderDebugName = "ECSRender_SurfelUpsample";
const Name s_SurfelTraceBuildArgsShaderDebugName = "ECSRender_SurfelTraceBuildArgs";

const StringView s_SurfelSpawnPassLabel = "spawn";
const StringView s_SurfelAgeFreePassLabel = "age-free";
const StringView s_SurfelHashBuildPassLabel = "hash-build";
const StringView s_SurfelTracePassLabel = "trace";
const StringView s_SurfelTraceHwPassLabel = "HW trace";
const StringView s_SurfelResolvePassLabel = "resolve";
const StringView s_SurfelUpsamplePassLabel = "upsample";
const StringView s_SurfelTraceBuildArgsPassLabel = "trace build-args";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateSurfelPipelineDescriptorHeap(in b8 heapInitialized, in b8 includeAccelStruct, in b8 hasAccelStructLayout, in StringView passLabel){
    if(heapInitialized && (!includeAccelStruct || hasAccelStructLayout))
        return true;

    error("RendererSystem: surfel {} requires the initialized global descriptor heap", passLabel);
    return false;
}

void LogSurfelBindingLayoutCreateFailed(in StringView passLabel){
    error("RendererSystem: failed to create surfel {} binding layout", passLabel);
}

void LogSurfelPipelineCreateFailed(in StringView passLabel){
    error("RendererSystem: failed to create surfel {} compute pipeline", passLabel);
}

void LogSurfelPipelineCreated(in StringView passLabel){
    [essential]
    info("RendererSystem: created surfel {} compute pipeline", passLabel);
}

u32 ComputeSurfelLinearDispatchGroups(in u32 poolCapacity, in u32 linearGroupSize){
    return DivideUp(poolCapacity, linearGroupSize);
}

void ApplySurfelSpawnPushConstantSlots(mut SurfelHeapPushConstants inOutPush, in u32 worldPositionSlot, in u32 normalSlot){
    inOutPush.worldPositionSlot = worldPositionSlot;
    inOutPush.normalSlot = normalSlot;
}

void ApplySurfelResolvePushConstantSlots(
    mut SurfelHeapPushConstants inOutPush,
    in u32 worldPositionSlot,
    in u32 normalSlot,
    in u32 outputStorageHeapSlot
){
    inOutPush.worldPositionSlot = worldPositionSlot;
    inOutPush.normalSlot = normalSlot;
    inOutPush.outputStorageHeapSlot = outputStorageHeapSlot;
}

void ApplySurfelUpsamplePushConstantSlots(
    mut SurfelHeapPushConstants inOutPush,
    in u32 halfIrradianceSlot,
    in u32 normalSlot,
    in u32 worldPositionSlot,
    in u32 outputStorageHeapSlot
){
    inOutPush.halfIrradianceSlot = halfIrradianceSlot;
    inOutPush.normalSlot = normalSlot;
    inOutPush.worldPositionSlot = worldPositionSlot;
    inOutPush.outputStorageHeapSlot = outputStorageHeapSlot;
}

b8 HasSurfelPhaseAfterAgeFree(
    in b8 dispatchHashBuild,
    in b8 dispatchSpawn,
    in b8 dispatchTraceBuildArgs,
    in b8 dispatchTrace,
    in b8 dispatchResolve,
    in b8 dispatchRemaining
){
    return dispatchHashBuild || dispatchSpawn || dispatchTraceBuildArgs || dispatchTrace || dispatchResolve || dispatchRemaining;
}

b8 HasSurfelPhaseAfterHashBuild(
    in b8 dispatchSpawn,
    in b8 dispatchTraceBuildArgs,
    in b8 dispatchTrace,
    in b8 dispatchResolve,
    in b8 dispatchRemaining
){
    return dispatchSpawn || dispatchTraceBuildArgs || dispatchTrace || dispatchResolve || dispatchRemaining;
}

b8 HasSurfelPhaseAfterSpawn(
    in b8 dispatchTraceBuildArgs,
    in b8 dispatchTrace,
    in b8 dispatchResolve,
    in b8 dispatchRemaining
){
    return dispatchTraceBuildArgs || dispatchTrace || dispatchResolve || dispatchRemaining;
}

b8 HasSurfelPhaseAfterTraceBuildArgs(in b8 dispatchTrace, in b8 dispatchResolve, in b8 dispatchRemaining){
    return dispatchTrace || dispatchResolve || dispatchRemaining;
}

b8 HasSurfelPhaseAfterTrace(in b8 dispatchResolve, in b8 dispatchRemaining){
    return dispatchResolve || dispatchRemaining;
}

b8 HasCompletedSurfelCountReadbackValue(in u64 completedValue, in u64 tokenValue){
    return completedValue >= tokenValue;
}


