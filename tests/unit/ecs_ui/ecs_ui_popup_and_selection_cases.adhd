void VerifyUiSelectionDeletionTests_CopiedSelectionBasisSurvivesNativeReleaseAndRetainsSelectedBytes(mut UiSelectionDeletionTests self){
    ASSERT_TRUE(self.seed());
    UiTextEditSession session = UiTextEditSession(self.m_arena, self.m_textInput);
    ASSERT_EQ(session.begin(self.owner(), s_SelectionDeletionCaret, self.m_model), TextInputAdmission::Accepted);
    const u64 surrounding = session.surroundingRevision();
    ASSERT_EQ(self.m_textInput.erase(1u, 1u, surrounding, TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
    TextInputEvent event = TextInputEvent(self.m_arena);
    ASSERT_EQ(session.pollOwned(event), TextInputPollResult::Event);
    EXPECT_EQ(self.m_model.text(), "abcDEFghi");
    ASSERT_TRUE(session.cancel());
    ASSERT_EQ(ApplyUiTextEditEvent(self.m_model, event, surrounding, true), UiTextEditStatus::Applied);
    EXPECT_EQ(self.m_model.text(), "abDEFhi");
    EXPECT_EQ(self.m_model.selectedText(), "DEF");
    EXPECT_EQ(self.m_model.anchor(), 2u);
    EXPECT_EQ(self.m_model.caret(), 5u);
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "abcDEFghi");
    EXPECT_EQ(self.m_model.anchor(), 3u);
    EXPECT_EQ(self.m_model.caret(), 6u);
    EXPECT_FALSE(self.m_model.canUndo());
}

void VerifyUiSelectionDeletionTests_MalformedCopiedDeletionBasisRejectsWithoutChangingModelEpochs(mut UiSelectionDeletionTests self){
    ASSERT_TRUE(self.seed());
    const u64 revision = self.m_model.revision();
    const u64 externalRevision = self.m_model.externalRevision();
    const u64 selectionGeneration = self.m_model.selectionGeneration();
    const u64 compositionGeneration = self.m_model.compositionGeneration();
    TextInputEvent event = TextInputEvent(self.m_arena);
    event.kind = TextInputEventKind::DeleteSurrounding;
    event.surroundingRevision = 7u;
    event.deletionBasis = TextInputDeletionBasis::Count;
    event.deleteBeforeBytes = 1u;
    event.deleteAfterBytes = 1u;
    EXPECT_EQ(ApplyUiTextEditEvent(self.m_model, event, 7u, true), UiTextEditStatus::InvalidEvent);
    self.expectBaseline(revision, externalRevision, selectionGeneration);
    EXPECT_EQ(self.m_model.compositionGeneration(), compositionGeneration);
    EXPECT_FALSE(self.m_model.canUndo());
    EXPECT_FALSE(self.m_model.canRedo());
}

void VerifyUiSelectionDeletionTests_CaretDeletionStillRejectsANonemptySelectionAndDropsTheFollowingCommit(mut UiSelectionDeletionTests self){
    ASSERT_TRUE(self.seed());
    UiTextEditSession session = UiTextEditSession(self.m_arena, self.m_textInput);
    ASSERT_EQ(session.begin(self.owner(), s_SelectionDeletionCaret, self.m_model), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.erase(1u, 1u, self.m_textInput.surroundingRevision(self.m_textInput.activeSession()), TextInputDeletionBasis::Caret), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.commit("X"), TextInputAdmission::Accepted);
    const UiTextEditResult result = session.drain(self.owner(), self.m_model);
    EXPECT_EQ(result.status, UiTextEditStatus::ModelRejected);
    EXPECT_EQ(result.eventsApplied, 0u);
    EXPECT_FALSE(result.textChanged);
    EXPECT_EQ(self.m_model.text(), "abcDEFghi");
    EXPECT_EQ(self.m_model.anchor(), 3u);
    EXPECT_EQ(self.m_model.caret(), 6u);
    EXPECT_FALSE(self.m_model.canUndo());
    EXPECT_FALSE(session.token().valid());
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
}

void VerifyUiSelectionDeletionTests_ANewNativePublicationCannotReviveTheSessionsOldSurroundingSnapshot(mut UiSelectionDeletionTests self){
    ASSERT_TRUE(self.seed());
    UiTextEditSession session = UiTextEditSession(self.m_arena, self.m_textInput);
    ASSERT_EQ(session.begin(self.owner(), s_SelectionDeletionCaret, self.m_model), TextInputAdmission::Accepted);
    const u64 surrounding = session.surroundingRevision();
    const u64 revision = self.m_model.revision();
    const u64 externalRevision = self.m_model.externalRevision();
    const u64 selectionGeneration = self.m_model.selectionGeneration();
    ASSERT_EQ(self.m_textInput.updateSurrounding(session.token(), self.m_model.text(), 3u, 6u), TextInputAdmission::Accepted);
    ASSERT_GT(self.m_textInput.surroundingRevision(session.token()), surrounding);
    ASSERT_EQ(self.m_textInput.erase(1u, 1u, self.m_textInput.surroundingRevision(self.m_textInput.activeSession()), TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.commit("late"), TextInputAdmission::Accepted);
    const UiTextEditResult result = session.drain(self.owner(), self.m_model);
    EXPECT_EQ(result.status, UiTextEditStatus::StaleSurrounding);
    EXPECT_EQ(result.eventsApplied, 0u);
    EXPECT_FALSE(result.textChanged);
    self.expectBaseline(revision, externalRevision, selectionGeneration);
    EXPECT_FALSE(self.m_model.canUndo());
    EXPECT_FALSE(session.token().valid());
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
}

void VerifyUiSelectionDeletionTests_AnEarlierUnpublishedCommitMakesTheQueuedSelectionDeletionStale(mut UiSelectionDeletionTests self){
    ASSERT_TRUE(self.seed());
    UiTextEditSession session = UiTextEditSession(self.m_arena, self.m_textInput);
    ASSERT_EQ(session.begin(self.owner(), s_SelectionDeletionCaret, self.m_model), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.commit("X"), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.erase(1u, 1u, self.m_textInput.surroundingRevision(self.m_textInput.activeSession()), TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.commit("late"), TextInputAdmission::Accepted);
    const UiTextEditResult result = session.drain(self.owner(), self.m_model);
    EXPECT_EQ(result.status, UiTextEditStatus::StaleSurrounding);
    EXPECT_EQ(result.eventsApplied, 1u);
    EXPECT_TRUE(result.textChanged);
    EXPECT_EQ(self.m_model.text(), "abcXghi");
    EXPECT_FALSE(session.token().valid());
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "abcDEFghi");
    EXPECT_EQ(self.m_model.anchor(), 3u);
    EXPECT_EQ(self.m_model.caret(), 6u);
    EXPECT_FALSE(self.m_model.canUndo());
}

