class RendererTaskTimingPendingSample{
    public KernelGpuTimingSampleAttribution attribution = s_KernelNoGpuTimingSampleAttribution;
    public Name scopeName = s_NameNone;
    public KernelGpuTaskTimingKey key = KernelGpuTaskTimingKey();
    public KernelGpuPhysicalQueueId expectedQueue = KernelGpuPhysicalQueueId();
    public u64 sourceFrameIndex = 0u;
    public f64 durationSeconds = 0.0;
    public b8 recordsNonCommittingTimingSample = false;
    public b8 submissionResolved = false;
    public b8 accepted = false;
    public b8 assignmentRecorded = false;
    public b8 sampleResolved = false;
    public b8 hasUsableSample = false;
}

usize FindRendererTaskTimingPendingSample(
    in Span<RendererTaskTimingPendingSample> pendingSamples,
    in KernelGpuTimingSampleAttribution attribution
){
    for(usize pendingIndex = 0u; pendingIndex < pendingSamples.size(); ++pendingIndex){
        if(pendingSamples[pendingIndex].attribution == attribution)
            return pendingIndex;
    }
    return pendingSamples.size();
}

void RetireRendererTaskTimingPendingSample(in usize pendingIndex, mut Vector<RendererTaskTimingPendingSample> pendingSamples){
    assert(pendingIndex < pendingSamples.size());
    const usize lastIndex = pendingSamples.size() - 1u;
    for(usize index = pendingIndex; index < lastIndex; ++index)
        pendingSamples[index] = pendingSamples[index + 1u];
    pendingSamples.pop_back();
}

b8 TrackRendererTaskTimingSample(
    in KernelGpuTimingSampleAttribution attribution,
    in Name scopeName,
    in KernelGpuTaskTimingKey key,
    in KernelGpuPhysicalQueueId expectedQueue,
    in u64 sourceFrameIndex,
    in b8 recordsNonCommittingTimingSample,
    mut Vector<RendererTaskTimingPendingSample> pendingSamples
){
    if(!attribution.valid() || scopeName == Name() || !key.valid() || !expectedQueue.valid())
        return false;
    if(FindRendererTaskTimingPendingSample(pendingSamples, attribution) != pendingSamples.size())
        return false;

    RendererTaskTimingPendingSample entry;
    entry.attribution = attribution;
    entry.scopeName = scopeName;
    entry.key = key;
    entry.expectedQueue = expectedQueue;
    entry.sourceFrameIndex = sourceFrameIndex;
    entry.recordsNonCommittingTimingSample = recordsNonCommittingTimingSample;
    pendingSamples.push_back(entry);
    return true;
}

void AcceptRendererTaskTimingSubmission(
    in KernelGpuTimingSampleAttribution attribution,
    in KernelQueueSubmissionToken token,
    in b8 feedbackActive,
    in b8 submissionAccepted,
    mut Vector<RendererTaskTimingPendingSample> pendingSamples
){
    const usize pendingIndex = FindRendererTaskTimingPendingSample(pendingSamples, attribution);
    if(pendingIndex == pendingSamples.size())
        return;
    if(pendingSamples[pendingIndex].submissionResolved)
        return;

    const b8 physicalQueueMatches =
        token.physicalQueueIndex == pendingSamples[pendingIndex].expectedQueue.index
        && token.deviceGeneration == pendingSamples[pendingIndex].expectedQueue.deviceGeneration
    ;
    pendingSamples[pendingIndex].submissionResolved = true;
    pendingSamples[pendingIndex].accepted =
        submissionAccepted
        && feedbackActive
        && token.valid()
        && token.hasPhysicalQueueIdentity()
        && KernelTokenMatchesTimingKeyQueue(token, pendingSamples[pendingIndex].key)
        && physicalQueueMatches
    ;
}

void DiscardRendererTaskTimingRecording(
    in KernelGpuTimingSampleAttribution attribution,
    mut Vector<RendererTaskTimingPendingSample> pendingSamples
){
    const usize pendingIndex = FindRendererTaskTimingPendingSample(pendingSamples, attribution);
    if(pendingIndex == pendingSamples.size())
        return;
    if(pendingSamples[pendingIndex].submissionResolved)
        return;

    pendingSamples[pendingIndex].submissionResolved = true;
    pendingSamples[pendingIndex].accepted = false;
}

void CompleteRendererTaskTimingSample(
    in KernelGpuTimingSample sample,
    in b8 feedbackActive,
    mut Vector<RendererTaskTimingPendingSample> pendingSamples
){
    const usize pendingIndex = FindRendererTaskTimingPendingSample(pendingSamples, sample.attribution);
    if(pendingIndex == pendingSamples.size())
        return;
    if(pendingSamples[pendingIndex].sampleResolved)
        return;

    // Every matching notification is terminal; only complete positive durations enter history.
    pendingSamples[pendingIndex].sampleResolved = true;
    if(!IsValidCompletedRendererTaskTimingSample(
        feedbackActive,
        sample.published,
        sample.scopeName,
        pendingSamples[pendingIndex].scopeName,
        sample.sourceFrameIndex,
        pendingSamples[pendingIndex].sourceFrameIndex,
        sample.physicalQueue == pendingSamples[pendingIndex].expectedQueue,
        sample.durationSeconds
    ))
        return;

    pendingSamples[pendingIndex].durationSeconds = sample.durationSeconds;
    pendingSamples[pendingIndex].hasUsableSample = true;
}

RendererTaskTimingFeedbackDrainResult DrainRendererTaskTimingPendingSamples(
    mut KernelGpuTaskTimingHistoryStore history,
    in u16 deviceGeneration,
    mut Vector<RendererTaskTimingPendingSample> pendingSamples
){
    RendererTaskTimingFeedbackDrainResult result;
    usize pendingIndex = 0u;
    while(pendingIndex < pendingSamples.size()){
        if(pendingSamples[pendingIndex].expectedQueue.deviceGeneration != deviceGeneration){
            RetireRendererTaskTimingPendingSample(pendingIndex, pendingSamples);
            ++result.retiredSampleCount;
            continue;
        }
        if(!pendingSamples[pendingIndex].submissionResolved){
            ++pendingIndex;
            continue;
        }
        if(!pendingSamples[pendingIndex].accepted){
            RetireRendererTaskTimingPendingSample(pendingIndex, pendingSamples);
            ++result.retiredSampleCount;
            continue;
        }

        if(!pendingSamples[pendingIndex].recordsNonCommittingTimingSample && !pendingSamples[pendingIndex].assignmentRecorded){
            if(!history.noteAcceptedAssignment(
                pendingSamples[pendingIndex].key,
                pendingSamples[pendingIndex].expectedQueue,
                pendingSamples[pendingIndex].sourceFrameIndex
            )){
                RetireRendererTaskTimingPendingSample(pendingIndex, pendingSamples);
                ++result.retiredSampleCount;
                ++result.rejectedAssignmentCount;
                continue;
            }
            pendingSamples[pendingIndex].assignmentRecorded = true;
            ++result.acceptedAssignmentCount;
        }

        if(!pendingSamples[pendingIndex].sampleResolved){
            ++pendingIndex;
            continue;
        }
        if(pendingSamples[pendingIndex].hasUsableSample){
            if(history.recordNonCommittingSample(
                pendingSamples[pendingIndex].key,
                pendingSamples[pendingIndex].expectedQueue,
                pendingSamples[pendingIndex].durationSeconds
            ))
                ++result.recordedSampleCount;
            else
                ++result.rejectedSampleCount;
        }
        RetireRendererTaskTimingPendingSample(pendingIndex, pendingSamples);
        ++result.retiredSampleCount;
    }
    return result;
}

void ConfigureSameFamilyComputeEffectRoutingHint(in b8 preserveDirectDependency, mut KernelGpuTaskSchedulingHint scheduling){
    scheduling.allowSameClassQueueRouting = true;
    scheduling.preferNonPrimarySameClassQueue = true;
    scheduling.preserveSameClassQueueWithDirectDependency = preserveDirectDependency;
}

void ConfigureCrossFamilyComputeEffectRoutingHint(mut KernelGpuTaskSchedulingHint scheduling){
    scheduling.allowCrossFamilySameClassQueueRouting = true;
}

b8 CanBeginGraphClearTimingState(in b8 hasGraphics, in b8 hasTiming, in b8 hasTicket, in b8 timingAlreadyActive){
    return hasGraphics && hasTiming && hasTicket && !timingAlreadyActive;
}

b8 CanEndGraphClearTimingState(in b8 hasTiming, in b8 timingActive, in b8 hasTicket){
    return hasTiming && timingActive && hasTicket;
}

b8 CanRecordFloatTextureClear(in b8 hasDestination, in b8 renderPassActive){
    return hasDestination && !renderPassActive;
}

b8 CanBuildPacketSubmissionTelemetry(in b8 statisticsValid, in u32 ownerNodeIndex){
    return statisticsValid && ownerNodeIndex != u32.max;
}

b8 CanBeginRendererTaskTimingFeedbackSample(
    in Name scopeName,
    in Span<Name> feedbackCollectionScopes,
    in b8 keyValid,
    in b8 expectedQueueValid
){
    return scopeName != Name()
        && ContainsRendererTaskTimingFeedbackScope(feedbackCollectionScopes, scopeName)
        && keyValid
        && expectedQueueValid;
}

b8 CanPublishRendererTaskTimingFeedbackSnapshot(in b8 active, in b8 subscriptionValid, in b8 policyEnabled){
    return active && subscriptionValid && policyEnabled;
}

void LogRendererTaskTimingFeedbackSubscriptionFailure(){
    warning("Renderer task timing feedback failed to subscribe to GPU timing samples.");
}

void LogRendererTaskTimingFeedbackScopeCollectionFailure(){
    warning("Renderer task timing feedback failed to enable GPU sample collection.");
}

void LogRendererTaskTimingFeedbackRejections(in u64 rejectedAssignmentCount, in u64 rejectedSampleCount){
    if(rejectedAssignmentCount != 0u || rejectedSampleCount != 0u)
        warning("Renderer task timing feedback rejected {} assignment(s) and {} terminal sample(s).", rejectedAssignmentCount, rejectedSampleCount);
}


