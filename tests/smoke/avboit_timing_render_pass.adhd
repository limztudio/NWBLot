////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/kernel/timing_names.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_TimingProbeInFlightRanges = 32u;
const StringView s_AvboitTimingProbeName = "AvboitTimingProbe";
const StringView s_ShadowTimingProbeName = "ShadowTimingProbe";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TimingProbeUnfocusedPass : IRenderPass{
    private b8 m_registered = false;

    public TimingProbeUnfocusedPass(mut GraphicsRuntime graphics){}
    public ~TimingProbeUnfocusedPass(){ this.stop(); }
    public b8 shouldRenderUnfocused()override{ return true; }
    public b8 registered()const{ return this.m_registered; }

    public b8 prepareScope(in Name scope, in u32 ranges){
        mut GraphicsRuntime graphics = this.getGraphics();
        return graphics.gpuTiming().prepareScopeQueries(scope, graphics.getDevice(), ranges);
    }

    public b8 prepareScopes(in Span<Name> scopes, in StringView probeName, in StringView scopeLabel){
        for(in Name scope : scopes){
            if(!this.prepareScope(scope, s_TimingProbeInFlightRanges)){
                error("{}: failed to prepare {} '{}'", probeName, scopeLabel, scope.resolvedText());
                return false;
            }
        }
        return true;
    }

    public void registerPass(){
        if(!this.m_registered){
            this.getGraphics().addRenderPassToBack(this);
            this.m_registered = true;
        }
    }

    public b8 start(in Span<Name> scopes, in StringView probeName){
        if(this.m_registered)
            return true;
        if(!this.prepareScopes(scopes, probeName, "scope"))
            return false;
        this.registerPass();
        [essential] info("{}: in-flight ranges {}", probeName, s_TimingProbeInFlightRanges);
        [essential] info("{}: render unfocused 1", probeName);
        return true;
    }

    public void stop(){
        if(this.m_registered){
            this.getGraphics().removeRenderPass(this);
            this.m_registered = false;
        }
    }
}

class AvboitTimingRenderPass{
    public AvboitTimingRenderPass(mut GraphicsRuntime graphics){
        this.m_pass = TimingProbeUnfocusedPass(graphics);
    }

    public b8 start(){
        return this.start(false);
    }

    public b8 start(in b8 includeCaustics){
        if(this.m_pass.registered())
            return this.m_includeCaustics == includeCaustics;

        const Array<Name, 26u> scopes(
            s_TimingScopeFrame.identity,
            s_TimingScopeOpaqueRegular.identity,
            s_TimingScopeShadowVisibility.identity,
            s_TimingScopeLightSpaceShadowViews.identity,
            s_TimingScopeLightSpaceShadowOpaqueCapture.identity,
            s_TimingScopeLightSpaceShadowTransparentCapture.identity,
            s_TimingScopeLightSpaceShadowShade.identity,
            s_TimingScopeLightSpaceShadowMapOpaque.identity,
            s_TimingScopeLightSpaceShadowMapTransparent.identity,
            s_TimingScopeLightSpaceShadowFallbackOpaque.identity,
            s_TimingScopeLightSpaceShadowFallbackTransparent.identity,
            s_TimingScopeDeferredLighting.identity,
            s_TimingScopeDeferredComposite.identity,
            s_TimingScopeDeferredPresent.identity,
            s_TimingScopeAvboitClear.identity,
            s_TimingScopeAvboitOccupancy.identity,
            s_TimingScopeAvboitDepthWarp.identity,
            s_TimingScopeAvboitExtinction.identity,
            s_TimingScopeAvboitIntegration.identity,
            s_TimingScopeAvboitAccumulate.identity,
            s_TimingScopeRefractionResolve.identity,
            s_TimingScopeRefractionClassifyTiles.identity,
            s_TimingScopeRefractionClearTileArguments.identity,
            s_TimingScopeOpticalBoundsFinalize.identity,
            s_TimingScopeCausticPhotons.identity,
            s_TimingScopeCausticResolve.identity
        );

        usize scopeCount = scopes.size() - 2u;
        if(includeCaustics)
            scopeCount = scopes.size();
        if(!this.m_pass.start(Span<Name>(scopes).first(scopeCount), s_AvboitTimingProbeName))
            return false;
        this.m_includeCaustics = includeCaustics;
        if(includeCaustics)
            [essential] info("AvboitTimingProbe: caustic in-flight ranges {}", s_TimingProbeInFlightRanges);
        return true;
    }

    public void stop(){
        this.m_pass.stop();
        this.m_includeCaustics = false;
    }

    private TimingProbeUnfocusedPass m_pass;
    private b8 m_includeCaustics = false;
}

class ShadowTimingRenderPass{
    public ShadowTimingRenderPass(mut GraphicsRuntime graphics){
        this.m_pass = TimingProbeUnfocusedPass(graphics);
    }

    public b8 start(){
        if(this.m_pass.registered())
            return true;

        const Array<Name, 13u> scopes(
            s_TimingScopeFrame.identity,
            s_TimingScopeOpaqueRegular.identity,
            s_TimingScopeDeferredLighting.identity,
            s_TimingScopeDeferredComposite.identity,
            s_TimingScopeDeferredPresent.identity,
            s_TimingScopeShadowVisibility.identity,
            s_TimingScopeShadowOpaqueTrace.identity,
            s_TimingScopeShadowGeometryDownsample.identity,
            s_TimingScopeShadowOpaqueTemporal.identity,
            s_TimingScopeShadowOpaqueResolve.identity,
            s_TimingScopeShadowTransparentTrace.identity,
            s_TimingScopeShadowTransparentTemporal.identity,
            s_TimingScopeShadowTransparentResolve.identity
        );

        return this.m_pass.start(scopes, s_ShadowTimingProbeName);
    }

    public void stop(){
        this.m_pass.stop();
    }

    private TimingProbeUnfocusedPass m_pass;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

