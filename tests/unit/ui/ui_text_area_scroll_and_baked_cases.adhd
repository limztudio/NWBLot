void VerifyUiTextControlLifetimeTests_AcceptedAuxiliaryEpochChangePreservesTextFocusAndMainCapture(mut UiTextControlLifetimeTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(Point(10.0f, 10.0f), InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiTextScrollWheelEvent(Point(10.0f, 10.0f), 1.0, -1.0)).pointerConsumed);
    ASSERT_EQ(self.m_router.controlActions().size(), 1u);
    self.revise();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(Point(160.0f, 150.0f), InputEventType::PointerMove)).pointerConsumed);
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(Point(160.0f, 150.0f), InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_FALSE(self.m_router.capture().valid());
}

void VerifyUiTextControlLifetimeTests_AcceptedAuxiliaryEpochChangeRetiresOwnedPartCaptureAndGesture(mut UiTextControlLifetimeTests self){
    self.m_targets[1u].textEditable = true;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(Point(95.0f, 25.0f), InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_EQ(self.m_router.capture(), self.m_targets[1u].id);
    self.revise();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_FALSE(self.m_router.consumePointerGesture(self.m_targets[1u].id, 7u).has_value());
}

void VerifyUiTextControlLifetimeTests_PrepublicationFencePreservesTextCaptureAndRejectsOldWheelUntilAcceptance(mut UiTextControlLifetimeTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(Point(10.0f, 10.0f), InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiTextScrollWheelEvent(Point(10.0f, 10.0f), 0.0, -1.0)).pointerConsumed);
    self.revise();
    self.m_router.fenceControl(self.m_targets[0u].id, 7u, self.m_targets[0u].control);
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    ASSERT_EQ(self.m_router.targets().size(), 2u);
    EXPECT_TRUE(self.m_router.targets()[0u].enabled);
    EXPECT_FALSE(self.m_router.targets()[0u].scrollable);
    EXPECT_TRUE(self.m_router.targets()[0u].control.empty());
    EXPECT_FALSE(self.m_router.targets()[1u].enabled);
    EXPECT_TRUE(self.send(MakeUiTextScrollWheelEvent(Point(10.0f, 10.0f), 1.0, -1.0)).pointerConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
    EXPECT_TRUE(self.send(MakeUiTextScrollWheelEvent(Point(10.0f, 10.0f), 1.0, 0.0)).pointerConsumed);
    const auto actionResult = self.m_router.consumeControlAction(self.m_targets[0u].id, 7u, self.m_targets[0u].control);
    ASSERT_TRUE(actionResult.has_value());
    const ControlAction action = actionResult.value();
    EXPECT_EQ(action.control, self.m_targets[0u].control);
}

void VerifyUiTextControlLifetimeTests_RepeatedAuxiliaryFenceKeepsTextCaptureBeforeAnyNewAcceptance(mut UiTextControlLifetimeTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(Point(10.0f, 10.0f), InputEventType::PrimaryDown)).pointerConsumed);
    self.revise();
    self.m_router.fenceControl(self.m_targets[0u].id, 7u, self.m_targets[0u].control);
    self.revise();
    self.m_router.fenceControl(self.m_targets[0u].id, 7u, self.m_targets[0u].control);
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
    EXPECT_TRUE(self.m_router.targets()[0u].enabled);
    EXPECT_FALSE(self.m_router.targets()[1u].enabled);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
}

void VerifyUiTextControlLifetimeTests_PrepublicationFenceRetiresOwnedPartDragWithoutBlurringEditor(mut UiTextControlLifetimeTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(Point(95.0f, 25.0f), InputEventType::PrimaryDown)).pointerConsumed);
    self.revise();
    self.m_router.fenceControl(self.m_targets[0u].id, 7u, self.m_targets[0u].control);
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_FALSE(self.m_router.consumePointerGesture(self.m_targets[1u].id, 7u).has_value());
}

void VerifyUiTextControlLifetimeTests_DifferentDeclarationFenceStillRetiresTextFocusAndCapture(mut UiTextControlLifetimeTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(Point(10.0f, 10.0f), InputEventType::PrimaryDown)).pointerConsumed);
    self.m_router.fenceControl(self.m_targets[0u].id, 8u, self.m_targets[0u].control);
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_FALSE(self.m_router.targets()[0u].enabled);
    EXPECT_FALSE(self.m_router.targets()[1u].enabled);
}

void VerifyUiTextControlLifetimeTests_ReplacedDeclarationStillRetiresTextFocusAndMainCapture(mut UiTextControlLifetimeTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(Point(10.0f, 10.0f), InputEventType::PrimaryDown)).pointerConsumed);
    ++self.m_targets[0u].declarationGeneration;
    ++self.m_targets[1u].ownerDeclarationGeneration;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.capture().valid());
}

void VerifyUiTextControlLifetimeTests_DisabledTextHostCannotKeepFocusOrMainCapture(mut UiTextControlLifetimeTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(Point(10.0f, 10.0f), InputEventType::PrimaryDown)).pointerConsumed);
    self.revise();
    self.m_targets[0u].enabled = false;
    ASSERT_TRUE(self.commitFirstTarget(2u));
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.capture().valid());
}

void VerifyUiTextControlLifetimeTests_FullyClippedTextHostCannotKeepFocusOrMainCapture(mut UiTextControlLifetimeTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(Point(10.0f, 10.0f), InputEventType::PrimaryDown)).pointerConsumed);
    self.revise();
    self.m_targets[0u].clip = Rect(200.0f, 0.0f, 10.0f, 100.0f);
    self.m_targets[1u].clip = Rect(200.0f, 0.0f, 10.0f, 100.0f);
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.capture().valid());
}

void VerifyUiTextControlLifetimeTests_RefreshedAuxiliaryTokenSupportsLaterOrdinaryControlRules(mut UiTextControlLifetimeTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(Point(10.0f, 10.0f), InputEventType::PrimaryDown)).pointerConsumed);
    self.revise();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    self.m_targets[0u].textEditable = false;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 3u));
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
    self.revise();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 4u));
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.capture().valid());
}

void VerifyUiTextControlLifetimeTests_NonTextScrollHostKeepsItsExistingFullFenceBehavior(mut UiTextControlLifetimeTests self){
    self.m_targets[0u].textEditable = false;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(Point(10.0f, 10.0f), InputEventType::PrimaryDown)).pointerConsumed);
    self.revise();
    self.m_router.fenceControl(self.m_targets[0u].id, 7u, self.m_targets[0u].control);
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_FALSE(self.m_router.targets()[0u].enabled);
    EXPECT_FALSE(self.m_router.targets()[1u].enabled);
}

void VerifyUiTextControlLifetimeTests_AuxiliaryTokenRestorationPreservesMainTextCaptureWithoutRevivingSubmission(mut UiTextControlLifetimeTests self){
    self.m_targets[0u].activatable = true;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(Point(10.0f, 10.0f), InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
    EXPECT_TRUE(self.m_router.pressed(self.m_targets[0u].id));
    const ControlToken original = self.m_targets[0u].control;
    self.revise();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
    EXPECT_FALSE(self.m_router.pressed(self.m_targets[0u].id));
    self.m_targets[0u].control = original;
    self.m_targets[1u].control = original;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 3u));
    EXPECT_EQ(self.m_router.capture(), self.m_targets[0u].id);
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(Point(10.0f, 10.0f), InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(self.m_targets[0u].id));
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(Point(10.0f, 10.0f), InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(Point(10.0f, 10.0f), InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(self.m_targets[0u].id));
}


