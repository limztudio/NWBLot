extern const StringView s_UiTestFontDirectory;

const StringView s_TestSkinPath = "tests/ui/skin";
const StringView s_TestLatinFontPath = "tests/ui/fonts/latin";
const StringView s_TestKoreanFontPath = "tests/ui/fonts/korean";
const StringView s_ParentPopupKey = "parent";
const StringView s_ChildPopupKey = "child";


