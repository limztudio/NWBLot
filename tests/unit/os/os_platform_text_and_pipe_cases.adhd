void VerifyWin32TextInputFixture_UnfocusedSceneFallbackRefusesLateWindowCharacterAndClearsPartialPair(mut Win32TextInputFixture self){
    native(mut self){
#if defined(NWB_PLATFORM_WINDOWS)
        ASSERT_TRUE(self.m_service->end(self.m_token));
        EXPECT_EQ(SendMessageW(self.m_window, WM_CHAR, 0xd83du, 0), 0);
        EXPECT_EQ(self.m_sceneCharacterCount, 0u);
        // Direct focus state update leaves fallback reset to the refusal guard, as a defensive late-message case.
        ASSERT_TRUE(self.m_service->setFocused(false));
        EXPECT_EQ(SendMessageW(self.m_window, WM_CHAR, 'A', 0), 0);
        EXPECT_EQ(self.m_sceneCharacterCount, 0u);
        ASSERT_TRUE(self.m_service->setFocused(true));
        EXPECT_EQ(SendMessageW(self.m_window, WM_CHAR, 0xde00u, 0), 0);
        EXPECT_EQ(self.m_sceneCharacterCount, 0u);
        EXPECT_EQ(SendMessageW(self.m_window, WM_CHAR, 'B', 0), 0);
        EXPECT_EQ(self.m_sceneCharacterCount, 1u);
        EXPECT_EQ(self.m_sceneCodePoint, static_cast<u32>('B'));
#else
        (void)self;
#endif
    }
}

