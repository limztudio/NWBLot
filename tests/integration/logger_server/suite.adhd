void VerifyLoggerServerCrash_WindowsCrashPackageReportsMissingMinidump(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_windows_missing_dump_test";
    const StringView stem = "windows_missing_dump_001";
    RemoveTestArtifacts(group);

    String archive = "";
    BeginArchiveWithManifest("windows-missing-dump-test", s_Windows, s_Crash, s_WindowsExceptionCategory, 0xC0000005u, s_IncludeEventField, ManifestTriggerFields(), archive);

    const CrashIngestResult result = ProcessCrashArchive(testArena.arena, group, stem, StringView(archive));
    EXPECT_TRUE(result.accepted);

    String report = "";
    ASSERT_TRUE(ReadServerSymbolicationText(group, stem, report));
    EXPECT_TRUE(Contains(StringView(report), "platform=windows"));
    EXPECT_TRUE(Contains(StringView(report), s_Event));
    EXPECT_TRUE(Contains(StringView(report), "event=crash"));
    EXPECT_TRUE(Contains(StringView(report), "exception=access_violation 0x00000000c0000005"));
    EXPECT_TRUE(Contains(StringView(report), "resolver=windows_pdb_minidump"));
    if(IsWindowsLoggerCrashPlatform()){
        const String missingDumpMessage = StringFormat("{} is missing or unreadable", s_ProcessDumpFileName);
        EXPECT_TRUE(Contains(StringView(report), StringView(missingDumpMessage)));
    }
    else
        EXPECT_TRUE(Contains(StringView(report), "only available on Windows logserver builds"));

    RemoveTestArtifacts(group);
}

void VerifyLoggerServerCrash_WindowsCrashPackageDecodesGpuDetectiveCaptureInProcess(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_gpu_detective_test";
    const StringView stem = "gpu_detective_001";
    RemoveTestArtifacts(group);

    String archive = "";
    BeginArchiveWithManifest("gpu-detective-test", s_Windows, s_Crash, s_WindowsExceptionCategory, 0xC0000005u, s_IncludeEventField, ManifestTriggerFields(), archive);
    // Malformed RGD input must report decode failure without aborting crash ingest.
    AppendArchiveFile(s_GpuDetectiveCaptureFileName, "not a valid radeon gpu detective capture\n", archive);

    const CrashIngestResult result = ProcessCrashArchive(testArena.arena, group, stem, StringView(archive));
    EXPECT_TRUE(result.accepted);

    String report = "";
    ASSERT_TRUE(ReadServerSymbolicationText(group, stem, report));
    // The decoder always emits the section header before reporting invalid input.
    EXPECT_TRUE(Contains(StringView(report), "[gpu_detective]"));
    EXPECT_TRUE(Contains(StringView(report), "status=decode_failed"));

    RemoveTestArtifacts(group);
}

void VerifyLoggerServerCrash_InvalidCrashPackageIsRejected(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_invalid_crash_test";
    const StringView stem = "invalid_001";
    RemoveTestArtifacts(group);

    String archive = "";
    archive.append(s_InvalidArchiveHeader);
    const CrashIngestResult result = ProcessCrashArchive(testArena.arena, group, stem, StringView(archive));

    EXPECT_FALSE(result.accepted);
    EXPECT_EQ(result.type, s_LogTypeError);
    EXPECT_TRUE(CrashIngestMessageContains(result, "Crash upload rejected"));
    EXPECT_TRUE(CrashIngestMessageContains(result, "invalid crash archive header"));

    ExpectIsRegularFile(InvalidArchivePath(group, stem), true);
    RemoveTestArtifacts(group);
}

void VerifyLoggerServerCrash_UnsafeArchiveEntryCannotEscapePackageDirectory(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_unsafe_archive_20261107";
    const StringView stem = "unsafe_001";
    const Path testDirectory = TestCaseDirectory(group);
    const Expected<b8, ErrorCode> existed = FileExistsNoFollow(testDirectory);
    ASSERT_TRUE(existed.has_value());
    ASSERT_FALSE(existed.value());

    String archive = "";
    archive.append(s_ArchiveHeaderText);
    AppendArchiveFile("../escape", "payload", archive);
    const CrashIngestResult result = ProcessCrashArchive(testArena.arena, group, stem, StringView(archive));
    EXPECT_FALSE(result.accepted);
    EXPECT_TRUE(CrashIngestMessageContains(result, "malformed crash archive file header"));
    const Path escapePath = StorageDirectory(group) / "packages" / "escape";
    const Expected<b8, ErrorCode> escaped = FileExistsNoFollow(escapePath);
    ASSERT_TRUE(escaped.has_value());
    EXPECT_FALSE(escaped.value());
    RemoveTestArtifacts(group);
}

void VerifyLoggerServerCrash_CrashManifestWithoutEventIsRejected(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_missing_event_manifest_crash_test";
    const StringView stem = "missing_event_manifest_001";
    RemoveTestArtifacts(group);

    String archive = "";
    BeginArchiveWithManifest("missing-event-manifest-test", s_Linux, s_Crash, s_Signal, 11u, s_OmitEventField, ManifestTriggerFields(), archive);
    const CrashIngestResult result = ProcessCrashArchive(testArena.arena, group, stem, StringView(archive));

    EXPECT_FALSE(result.accepted);
    EXPECT_EQ(result.type, s_LogTypeError);
    EXPECT_TRUE(CrashIngestMessageContains(result, "manifest.json is missing required fields"));
    ExpectIsRegularFile(InvalidArchivePath(group, stem), true);

    RemoveTestArtifacts(group);
}

void VerifyLoggerServerCrash_InvalidManifestBooleanIsRejectedWhileFalseAndZeroRemainValid(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_boolean_manifest_test";
    const StringView validStem = "valid_false_001";
    const StringView invalidStem = "invalid_boolean_001";
    RemoveTestArtifacts(group);

    String validArchive = "";
    BeginArchiveWithManifest(validStem, s_Linux, s_Crash, s_Signal, 0u, s_IncludeEventField, ManifestTriggerFields(), validArchive);
    const CrashIngestResult validResult = ProcessCrashArchive(testArena.arena, group, validStem, StringView(validArchive));
    ASSERT_TRUE(validResult.accepted);

    String manifest = BuildManifest(invalidStem, s_Linux, s_Crash, s_Signal, 0u, s_IncludeEventField, ManifestTriggerFields());
    const StringView booleanPrefix = "\"has_exception_context\": ";
    const usize fieldOffset = StringView(manifest).find(booleanPrefix);
    ASSERT_LT(fieldOffset, manifest.size());
    manifest.replace(fieldOffset + booleanPrefix.size(), 5u, "null");

    String invalidArchive = "";
    invalidArchive.append(s_ArchiveHeaderText);
    AppendArchiveFile(s_ManifestFileName, StringView(manifest), invalidArchive);
    const CrashIngestResult invalidResult = ProcessCrashArchive(testArena.arena, group, invalidStem, StringView(invalidArchive));
    EXPECT_FALSE(invalidResult.accepted);
    EXPECT_TRUE(CrashIngestMessageContains(invalidResult, "manifest.json is missing required fields"));
    ExpectIsRegularFile(InvalidArchivePath(group, invalidStem), true);
    ExpectIsDirectory(ExtractedPackageDirectory(group, validStem), true);

    RemoveTestArtifacts(group);
}

void VerifyLoggerServerCrash_CrashRetentionPrunesOldestAcceptedUploads(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_retention_accepted_test";
    const StringView stem0 = "retention_001";
    const StringView stem1 = "retention_002";
    const StringView stem2 = "retention_003";
    RemoveTestArtifacts(group);

    CrashIngestConfig config = MakeIngestConfig(testArena.arena, group);
    config.retention.maxExtractedPackages = 2u;
    config.retention.maxRawArchives = 2u;
    config.retention.maxInvalidArchives = 0u;

    String archive0 = "";
    BuildLinuxCrashArchive(stem0, archive0);
    EXPECT_TRUE(ProcessCrashArchive(testArena.arena, group, stem0, StringView(archive0), config).accepted);

    String archive1 = "";
    BuildLinuxCrashArchive(stem1, archive1);
    EXPECT_TRUE(ProcessCrashArchive(testArena.arena, group, stem1, StringView(archive1), config).accepted);

    String archive2 = "";
    BuildLinuxCrashArchive(stem2, archive2);
    EXPECT_TRUE(ProcessCrashArchive(testArena.arena, group, stem2, StringView(archive2), config).accepted);

    ExpectPathExists(ExtractedPackageDirectory(group, stem0), false);
    ExpectPathExists(RawArchivePath(group, stem0), false);
    ExpectIsDirectory(ExtractedPackageDirectory(group, stem1), true);
    ExpectIsRegularFile(RawArchivePath(group, stem1), true);
    ExpectIsDirectory(ExtractedPackageDirectory(group, stem2), true);
    ExpectIsRegularFile(RawArchivePath(group, stem2), true);

    RemoveTestArtifacts(group);
}

void VerifyLoggerServerCrash_AcceptedCrashWarnsWhenRawArchiveCannotBeRetained(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_raw_archive_failed_test";
    const StringView stem = "raw_blocked_001";
    RemoveTestArtifacts(group);

    String archive = "";
    BuildLinuxCrashArchive(stem, archive);

    const Path storageDir = StorageDirectory(group);
    const Path rawDirFile = storageDir / s_CrashRawDirectoryName;
    EXPECT_TRUE(EnsureDirectories(storageDir).has_value());
    EXPECT_TRUE(WriteTextFile(rawDirFile, "blocked"));

    const CrashIngestConfig config = MakeIngestConfig(testArena.arena, group);
    const CrashIngestResult result = ProcessCrashArchive(testArena.arena, group, stem, StringView(archive), config);

    EXPECT_TRUE(result.accepted);
    EXPECT_EQ(result.type, s_LogTypeWarning);
    EXPECT_TRUE(CrashIngestMessageContains(result, "raw upload archive could not be retained"));
    ExpectIsDirectory(ExtractedPackageDirectory(group, stem), true);
    ExpectPathExists(ArchivePath(group, stem), false);

    RemoveTestArtifacts(group);
}

void VerifyLoggerServerCrash_CrashRetentionPrunesOldestInvalidUploads(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_retention_invalid_test";
    const StringView stem0 = "invalid_retention_001";
    const StringView stem1 = "invalid_retention_002";
    RemoveTestArtifacts(group);

    CrashIngestConfig config = MakeIngestConfig(testArena.arena, group);
    config.retention.maxExtractedPackages = 0u;
    config.retention.maxRawArchives = 0u;
    config.retention.maxInvalidArchives = 1u;

    String archive0 = "";
    archive0.append(s_InvalidArchiveHeader);
    EXPECT_FALSE(ProcessCrashArchive(testArena.arena, group, stem0, StringView(archive0), config).accepted);

    String archive1 = "";
    archive1.append(s_InvalidArchiveHeader);
    EXPECT_FALSE(ProcessCrashArchive(testArena.arena, group, stem1, StringView(archive1), config).accepted);

    ExpectPathExists(InvalidArchivePath(group, stem0), false);
    ExpectIsRegularFile(InvalidArchivePath(group, stem1), true);

    RemoveTestArtifacts(group);
}


