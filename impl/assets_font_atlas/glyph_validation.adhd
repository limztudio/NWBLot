#include <impl/assets_font_atlas/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


FontAtlasGroupCompactBounds ComputeFontAtlasGroupCompactBounds(
    in Span<FontAtlasGlyph> glyphs,
    in u32 groupIndex,
    in u32 groupWidth,
    in u32 groupHeight,
    in u32 groupChannelCount,
    in u32 guardTexels
){
    u32 firstX = groupWidth;
    u32 firstY = groupHeight;
    u32 endX = 0u;
    u32 endY = 0u;
    u32 channelCount = 0u;
    for(usize i = 0u; i < glyphs.size(); ++i){
        const FontAtlasGlyph glyph = glyphs[i];
        if(glyph.drawable == 0u || glyph.group != groupIndex)
            continue;
        firstX = Min(firstX, glyph.x - guardTexels);
        firstY = Min(firstY, glyph.y - guardTexels);
        endX = Max(endX, glyph.x + glyph.width + guardTexels);
        endY = Max(endY, glyph.y + glyph.height + guardTexels);
        channelCount = Max(channelCount, glyph.channel + 1u);
    }
    assert(channelCount > 0u);
    FontAtlasGroupCompactBounds out;
    out.firstX = firstX;
    out.firstY = firstY;
    out.width = endX - firstX;
    out.height = endY - firstY;
    out.channelCount = channelCount;
    out.unchanged = firstX == 0u && firstY == 0u && out.width == groupWidth && out.height == groupHeight && channelCount == groupChannelCount;
    return out;
}

void OffsetFontAtlasGroupGlyph(in u32 groupIndex, in u32 firstX, in u32 firstY, mut FontAtlasGlyph inoutGlyph){
    if(inoutGlyph.drawable != 0u && inoutGlyph.group == groupIndex){
        inoutGlyph.x -= firstX;
        inoutGlyph.y -= firstY;
    }
}

b8 ValidateFontAtlasGlyphRecord(
    in FontAtlasGlyph glyph,
    in usize expectedIndex,
    in usize groupCount,
    in f32 unitsPerPixel
){
    if(
        cast<usize>(glyph.glyphId) != expectedIndex
        || glyph.drawable > 1u
        || !IsFinite(glyph.advanceUnits)
        || !IsFinite(glyph.planeLeft)
        || !IsFinite(glyph.planeTop)
        || !IsFinite(glyph.planeRight)
        || !IsFinite(glyph.planeBottom)
    ){
        error("FontAtlas validation failed: invalid glyph ID, flags, or metrics at {}", expectedIndex);
        return false;
    }
    if(glyph.drawable == 0u){
        if(!IsValidNondrawableFontAtlasGlyph(glyph)){
            error("FontAtlas validation failed: nondrawable glyph {} carries a bitmap", expectedIndex);
            return false;
        }
        return true;
    }
    if(
        cast<usize>(glyph.group) >= groupCount
        || glyph.width == 0u
        || glyph.height == 0u
        || glyph.planeLeft >= glyph.planeRight
        || glyph.planeTop >= glyph.planeBottom
    ){
        error("FontAtlas validation failed: invalid glyph {} page or padded bounds", expectedIndex);
        return false;
    }
    if(!IsValidFontAtlasGlyphPlaneBounds(glyph, unitsPerPixel)){
        error("FontAtlas validation failed: glyph {} plane bounds disagree with bitmap size", expectedIndex);
        return false;
    }
    return true;
}

u64 ComputeFontAtlasGuardedWordMask(in usize begin, in usize last, in usize word){
    u64 mask = u64.max;
    if(word == begin / s_BitsPerU64)
        mask &= u64.max << (begin % s_BitsPerU64);
    if(word == last / s_BitsPerU64)
        mask &= u64.max >> (s_FontAtlasOccupiedWordLastBit - (last % s_BitsPerU64));
    return mask;
}

b8 TryMarkFontAtlasGuardedWordOccupied(in u32 glyphId, in usize begin, in usize last, in usize word, mut u64 inOutOccupiedWord){
    const u64 mask = ComputeFontAtlasGuardedWordMask(begin, last, word);
    if((inOutOccupiedWord & mask) != 0u){
        error("FontAtlas validation failed: glyph {} overlaps another guarded region", glyphId);
        return false;
    }
    inOutOccupiedWord |= mask;
    return true;
}

b8 ValidateFontAtlasGroupGuardedOverlap(
    in Span<FontAtlasGlyph> glyphs,
    in u32 groupIndex,
    in u32 groupWidth,
    in u32 groupHeight,
    in u32 groupChannelCount,
    in u32 guardTexels
){
    const Expected<usize> groupWords = TryComputeFontAtlasOccupancyWordCount(groupWidth, groupHeight, groupChannelCount);
    if(!groupWords.has_value())
        return false;
    Vector<u64> occupiedWords(groupWords.value(), 0u);
    const usize planePixels = cast<usize>(groupWidth) * cast<usize>(groupHeight);
    for(in FontAtlasGlyph glyph : glyphs){
        if(glyph.drawable == 0u || glyph.group != groupIndex)
            continue;
        const u32 firstX = glyph.x - guardTexels;
        const u32 endX = glyph.x + glyph.width + guardTexels;
        const u32 firstY = glyph.y - guardTexels;
        const u32 endY = glyph.y + glyph.height + guardTexels;
        for(u32 row = firstY; row < endY; ++row){
            const usize begin = planePixels * cast<usize>(glyph.channel) + cast<usize>(row) * cast<usize>(groupWidth) + cast<usize>(firstX);
            const usize last = begin + cast<usize>(endX - firstX) - 1u;
            for(usize word = begin / s_BitsPerU64; word <= last / s_BitsPerU64; ++word){
                if(!TryMarkFontAtlasGuardedWordOccupied(glyph.glyphId, begin, last, word, occupiedWords[word]))
                    return false;
            }
        }
    }
    return true;
}

b8 ValidateFontAtlasHeaderParameters(
    in u32 unitsPerEm,
    in u32 sourceGlyphCount,
    in usize glyphCount,
    in u32 bakePpem,
    in u32 spreadPixels,
    in u32 guardTexels,
    in FontAtlasRasterMode rasterMode,
    in f32 ascenderUnits,
    in f32 descenderUnits,
    in f32 lineGapUnits,
    in usize groupCount
){
    if(
        unitsPerEm < s_FontAtlasMinUnitsPerEm
        || unitsPerEm > s_FontAtlasMaxUnitsPerEm
        || sourceGlyphCount == 0u
        || sourceGlyphCount > s_FontAtlasMaxGlyphCount
        || glyphCount != cast<usize>(sourceGlyphCount)
    ){
        error("FontAtlas validation failed: invalid face metrics or incomplete all-glyph policy");
        return false;
    }
    if(!IsValidFontAtlasBakeParameters(bakePpem, spreadPixels, guardTexels, rasterMode)){
        error("FontAtlas validation failed: unsupported bake size, spread, guard, or raster mode");
        return false;
    }
    if(!IsValidFontAtlasMetrics(ascenderUnits, descenderUnits, lineGapUnits)){
        error("FontAtlas validation failed: nonfinite or invalid vertical metrics");
        return false;
    }
    if(groupCount == 0u || groupCount > cast<usize>(s_FontAtlasMaxGroupCount)){
        error("FontAtlas validation failed: invalid image group count");
        return false;
    }
    return true;
}


