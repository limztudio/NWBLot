class VertexInputBinding{
    public u32 slot;
    public u32 stride;
    public b8 instanceRate;
    public b8 valid;

    public VertexInputBinding(){
        this.slot = 0u;
        this.stride = 0u;
        this.instanceRate = false;
        this.valid = false;
    }

    public VertexInputBinding(in u32 slot, in u32 stride, in b8 instanceRate, in b8 valid){
        this.slot = slot;
        this.stride = stride;
        this.instanceRate = instanceRate;
        this.valid = valid;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

