#include "scene_types.adhd"
#include "presentation_types.adhd"
#include "smoke_cpu_gpu_timing_probe.adhd"

native{
#include <core/alloc/general.h>
#include <core/graphics/runtime/render_pass.h>
#include <core/graphics/runtime/runtime.h>
#include <core/perf/report.h>
#include <core/task/gpu/compiled_graph.h>
#include <core/task/gpu/packet_runtime.h>
#include <impl/ecs_render/module.adhd.h>
#include <global/filesystem.h>
#include <global/simd/vector.h>
#include <global/simplemath.h>

namespace NWB::Tests::Smoke{
using PerfSessionReport = Core::Perf::SessionReport;
using PerfMemorySnapshot = Core::Perf::MemorySnapshot;
using Core::Perf::TimingStats;
using Core::Alloc::GlobalArena;

class RendererCompilerStatisticsProbe final : public Core::IRenderPass{
private:
    struct Sample{
        Core::GpuTaskGraphCompileStatistics compile;
        u64 sourceFrame = 0u;
        u64 recordingAttempt = 0u;
        usize acceptedPackets = 0u;
        usize acceptedTasks = 0u;
        usize rejectedPackets = 0u;
        usize rejectedTasks = 0u;
        b8 valid = false;
    };

    struct DurationField{
        AStringView name;
        f64 Core::GpuTaskGraphCompileStatistics::*member;
    };

    struct CountField{
        AStringView name;
        usize Core::GpuTaskGraphCompileStatistics::*member;
    };

private:
    static constexpr usize s_Capacity = 1024u;
    static constexpr AStringView s_ValidStatus = "valid";

    static constexpr Array<DurationField, 12> s_Durations = {{
        { "declaration", &Core::GpuTaskGraphCompileStatistics::declarationSeconds },
        { "analysis", &Core::GpuTaskGraphCompileStatistics::analysisSeconds },
        { "validation", &Core::GpuTaskGraphCompileStatistics::validationSeconds },
        { "dependency_analysis", &Core::GpuTaskGraphCompileStatistics::dependencyAnalysisSeconds },
        { "hazard_analysis", &Core::GpuTaskGraphCompileStatistics::hazardAnalysisSeconds },
        { "topological_order", &Core::GpuTaskGraphCompileStatistics::topologicalOrderSeconds },
        { "queue_assignment", &Core::GpuTaskGraphCompileStatistics::queueAssignmentSeconds },
        { "planning", &Core::GpuTaskGraphCompileStatistics::planningSeconds },
        { "total", &Core::GpuTaskGraphCompileStatistics::totalSeconds },
        { "packetization", &Core::GpuTaskGraphCompileStatistics::packetizationSeconds },
        { "resource_state_planning", &Core::GpuTaskGraphCompileStatistics::resourceStatePlanningSeconds },
        { "packet_dependency_planning", &Core::GpuTaskGraphCompileStatistics::packetDependencyPlanningSeconds },
    }};

    static constexpr Array<CountField, 19> s_Counts = {{
        { "task", &Core::GpuTaskGraphCompileStatistics::taskCount },
        { "resource", &Core::GpuTaskGraphCompileStatistics::resourceCount },
        { "resource_use", &Core::GpuTaskGraphCompileStatistics::resourceUseCount },
        { "resource_version", &Core::GpuTaskGraphCompileStatistics::resourceVersionCount },
        { "resource_version_edge", &Core::GpuTaskGraphCompileStatistics::resourceVersionEdgeCount },
        { "explicit_dependency", &Core::GpuTaskGraphCompileStatistics::explicitDependencyCount },
        { "inferred_dependency", &Core::GpuTaskGraphCompileStatistics::inferredDependencyCount },
        { "external_dependency", &Core::GpuTaskGraphCompileStatistics::externalDependencyCount },
        { "packet", &Core::GpuTaskGraphCompileStatistics::packetCount },
        { "packet_dependency", &Core::GpuTaskGraphCompileStatistics::packetDependencyCount },
        { "packet_external_dependency", &Core::GpuTaskGraphCompileStatistics::packetExternalDependencyCount },
        { "cross_queue_packet_dependency", &Core::GpuTaskGraphCompileStatistics::crossQueuePacketDependencyCount },
        { "prologue_state_seed", &Core::GpuTaskGraphCompileStatistics::prologueStateSeedCount },
        { "prologue_barrier", &Core::GpuTaskGraphCompileStatistics::prologueBarrierCount },
        { "epilogue_barrier", &Core::GpuTaskGraphCompileStatistics::epilogueBarrierCount },
        { "state_export_barrier", &Core::GpuTaskGraphCompileStatistics::stateExportBarrierCount },
        { "resource_set", &Core::GpuTaskGraphCompileStatistics::resourceSetCount },
        { "direct_resource_use", &Core::GpuTaskGraphCompileStatistics::directResourceUseCount },
        { "expanded_resource_set_member_use", &Core::GpuTaskGraphCompileStatistics::expandedResourceSetMemberUseCount },
    }};

public:
    RendererCompilerStatisticsProbe(Core::GraphicsRuntime& graphics, Core::Alloc::GlobalArena& arena)noexcept
        : IRenderPass(graphics)
        , m_samples(arena)
        , m_output(arena)
    {}

    virtual ~RendererCompilerStatisticsProbe()noexcept override{
        stop();
    }

public:
    [[nodiscard]] b8 start(const AStringView path, Impl::RendererSystem& renderer){
        if(m_enabled || path.empty())
            return false;
        m_output.assign(path);
        m_samples.reserve(s_Capacity);
        m_renderer = &renderer;
        getGraphics().addRenderPassToBack(*this);
        m_registered = true;
        m_enabled = true;
        return true;
    }

    void stop(){
        if(m_registered){
            getGraphics().removeRenderPass(*this);
            m_registered = false;
        }
        m_renderer = nullptr;
    }

    [[nodiscard]] b8 write()const{
        if(!m_enabled)
            return true;
        if(m_registered)
            return false;
        OutputFileStream output(m_output.c_str(), s_FileOpenTruncate);
        if(!output.is_open())
            return false;
        output.precision(17);
        output << "{\"type\":\"compiler_statistics_configuration\",\"schema\":1,\"capacity\":" << s_Capacity << "}\n";
        usize invalid = 0u;
        for(usize index = 0u; index < m_samples.size(); ++index){
            const Sample& sample = m_samples[index];
            AStringView status = sample.valid ? s_ValidStatus : "invalid_snapshot";
            if(sample.valid){
                for(const auto& field : s_Durations){
                    const f64 seconds = sample.compile.*field.member;
                    if(!IsFinite(seconds) || seconds < 0.0){
                        status = "invalid_duration";
                        break;
                    }
                }
                for(usize previous = 0u; previous < index; ++previous){
                    const Sample& prior = m_samples[previous];
                    if(
                        prior.valid
                        && prior.compile.graphGeneration == sample.compile.graphGeneration
                        && prior.compile.planGeneration == sample.compile.planGeneration
                        && prior.compile.deviceGeneration == sample.compile.deviceGeneration
                    ){
                        status = "duplicate_plan";
                        break;
                    }
                }
            }
            if(index != 0u && sample.sourceFrame <= m_samples[index - 1u].sourceFrame)
                status = "non_monotonic_frame";
            output << "{\"type\":\"compiler_statistics\",\"sequence\":" << index << ",\"source_frame\":" << sample.sourceFrame << ",\"status\":\"" << status << '\"';
            if(status == s_ValidStatus){
                output << ",\"identity\":{\"graph_generation\":" << sample.compile.graphGeneration
                    << ",\"plan_generation\":" << sample.compile.planGeneration
                    << ",\"device_generation\":" << sample.compile.deviceGeneration
                    << ",\"recording_attempt_generation\":" << sample.recordingAttempt << "},\"seconds\":{";
                b8 first = true;
                for(const auto& field : s_Durations){
                    if(!first)
                        output << ',';
                    first = false;
                    output << '\"' << field.name << "\":" << sample.compile.*field.member;
                }
                output << "},\"counts\":{";
                first = true;
                for(const auto& field : s_Counts){
                    if(!first)
                        output << ',';
                    first = false;
                    output << '\"' << field.name << "\":" << sample.compile.*field.member;
                }
                output << "},\"submission\":{\"accepted_packets\":" << sample.acceptedPackets << ",\"accepted_tasks\":" << sample.acceptedTasks << ",\"rejected_packets\":" << sample.rejectedPackets << ",\"rejected_tasks\":" << sample.rejectedTasks << '}';
            }
            else
                ++invalid;
            output << "}\n";
        }
        const u64 overflow = m_attempts - m_samples.size();
        const b8 complete = !m_samples.empty() && overflow == 0u;
        output << "{\"type\":\"compiler_statistics_complete\",\"attempts\":" << m_attempts << ",\"stored\":" << m_samples.size() << ",\"overflow\":" << overflow << ",\"invalid\":" << invalid << ",\"complete\":" << (complete ? "true" : "false") << "}\n";
        output.close();
        return output.good() && complete;
    }

    virtual b8 shouldRenderUnfocused()noexcept override{ return true; }

    virtual void render(Core::Framebuffer*)override{
        if(!m_renderer)
            return;
        ++m_attempts;
        if(m_samples.size() == s_Capacity)
            return;
        Sample sample;
        sample.sourceFrame = getGraphics().getFrameIndex();
        const auto statistics = m_renderer->deferredTaskGraphRuntimeStatistics();
        sample.valid = statistics.valid() && statistics.compile.deviceGeneration != 0u;
        if(sample.valid){
            sample.compile = statistics.compile;
            sample.recordingAttempt = statistics.recording.recordingAttemptGeneration;
            sample.acceptedPackets = statistics.submission.acceptedPacketCount;
            sample.acceptedTasks = statistics.submission.acceptedTaskCount;
            sample.rejectedPackets = statistics.submission.rejectedPacketCount;
            sample.rejectedTasks = statistics.submission.rejectedTaskCount;
        }
        m_samples.push_back(Move(sample));
    }

private:
    Vector<Sample, Core::Alloc::GlobalArena> m_samples;
    AString<Core::Alloc::GlobalArena> m_output;
    Impl::RendererSystem* m_renderer = nullptr;
    u64 m_attempts = 0u;
    b8 m_enabled = false;
    b8 m_registered = false;
};
};
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_CompilerStatisticsProbeCapacity = 1024;
const u32 s_GatherBenchmarkWarmupFrames = 96u;
const u32 s_GatherBenchmarkSampleFrames = 256u;
const u32 s_GatherBenchmarkDrainFrames = 32u;
const u32 s_GatherBenchmarkCpuScopeCount = 8u;
const u32 s_GatherBenchmarkGpuScopeCount = 18u;
const u32 s_GatherBenchmarkArenaScopeCount = 3u;

StringView GatherBenchmarkCpuScopeName(in u32 scope){
    switch(scope){
    case 0u: return "graphics.frame";
    case 1u: return "graphics.frame_preamble";
    case 2u: return "graphics.prepare_resources";
    case 3u: return "graphics.render_passes";
    case 4u: return "graphics.render";
    case 5u: return "frame.project_update";
    case 6u: return "graphics.present";
    }
    return "graphics.begin_frame";
}

StringView GatherBenchmarkGpuScopeName(in u32 scope){
    switch(scope){
    case 0u: return "render.frame";
    case 1u: return "render.opaque_regular";
    case 2u: return "render.shadow_visibility";
    case 3u: return "render.deferred_lighting";
    case 4u: return "render.deferred_composite";
    case 5u: return "render.deferred_present";
    case 6u: return "render.avboit_clear";
    case 7u: return "render.avboit_occupancy";
    case 8u: return "render.avboit_depth_warp";
    case 9u: return "render.avboit_extinction";
    case 10u: return "render.avboit_integration";
    case 11u: return "render.avboit_accumulate";
    case 12u: return "render.reflection_classify";
    case 13u: return "render.reflection_build_args";
    case 14u: return "render.reflection_hardware";
    case 15u: return "render.reflection_depth_pyramid";
    case 16u: return "render.reflection_temporal";
    }
    return "render.reflection_spatial";
}

StringView GatherBenchmarkArenaScopeName(in u32 scope){
    switch(scope){
    case 0u: return "impl/ecs_render/prepare";
    case 1u: return "impl/ecs_render/render";
    }
    return "impl/ecs_render/task_graph";
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererGatherCpuSample{
    public Array<PerfMemorySnapshot, s_GatherBenchmarkArenaScopeCount> memory;
    public Array<f64, s_GatherBenchmarkCpuScopeCount> milliseconds;
    public u64 sourceFrame = 0u;
    public u64 publishFrame = 0u;
}

class RendererGatherGpuSample{
    public RendererGatherGpuSample(){
        this.timing = TimingStats();
        this.scope = 0u;
    }

    public RendererGatherGpuSample(in TimingStats stats, in u32 scopeIndex){
        this.timing = stats;
        this.scope = scopeIndex;
    }

    public TimingStats timing;
    public u32 scope;
}

void WriteGatherBenchmarkMemory(in Span<PerfMemorySnapshot> snapshots, mut OutputFileStream output){
    native(in snapshots, mut output){
        output << '{';
        for(u32 scope = 0u; scope < s_GatherBenchmarkArenaScopeCount; ++scope){
            if(scope != 0u)
                output << ',';
            const auto& snapshot = snapshots[scope];
            output << '"' << GatherBenchmarkArenaScopeName(scope) << "\":{\"present\":" << (snapshot.valid() ? "true" : "false")
                << ",\"frame\":" << snapshot.frameIndex << ",\"reserved\":" << snapshot.reservedBytes
                << ",\"used\":" << snapshot.usedBytes << ",\"historical_arena_peak\":" << snapshot.peakUsedBytes
                << ",\"allocations\":" << snapshot.allocationCount << ",\"reallocations\":" << snapshot.reallocationCount
                << ",\"deallocations\":" << snapshot.deallocationCount << '}';
        }
        output << '}';
    }
}

class RendererGatherBenchmarkProbe{
    public RendererGatherBenchmarkProbe(){
        this.m_cpu.reserve(s_GatherBenchmarkSampleFrames);
        this.m_gpu.reserve((s_GatherBenchmarkWarmupFrames + s_GatherBenchmarkSampleFrames + s_GatherBenchmarkDrainFrames) * s_GatherBenchmarkGpuScopeCount);
    }

    public RendererGatherBenchmarkProbe(mut GlobalArena arena){
        this.m_cpu.reserve(s_GatherBenchmarkSampleFrames);
        this.m_gpu.reserve((s_GatherBenchmarkWarmupFrames + s_GatherBenchmarkSampleFrames + s_GatherBenchmarkDrainFrames) * s_GatherBenchmarkGpuScopeCount);
    }

    public b8 poll(in PerfSessionReport report, in b8 memoryEnabled){
        const StringView frameScopeText = GatherBenchmarkCpuScopeName(0u);
        b8 skipFrame = false;
        b8 invalidFrame = false;
        u64 publishFrame = 0u;
        u64 sourceFrame = 0u;
        native(
            in report,
            in frameScopeText,
            in hasPub = this.m_hasPublication,
            in lastPub = this.m_lastPublish,
            in successful = this.m_successfulFrames,
            mut skipFrame,
            mut invalidFrame,
            mut publishFrame,
            mut sourceFrame
        ){
            const auto& frame = report.cpuTiming.stats(Name(frameScopeText));
            if(!frame.valid() || (hasPub && frame.publishFrameIndex == lastPub)){
                skipFrame = true;
            }
            else if((hasPub && frame.publishFrameIndex < lastPub) || frame.sampleCount != 1u || frame.firstSampleFrameIndex != frame.lastSampleFrameIndex){
                invalidFrame = true;
            }
            else{
                const auto& failedPreparation = report.cpuTiming.stats(Name(s_PresentationTimingNamePrepareResourcesFailed));
                if(failedPreparation.valid() && failedPreparation.publishFrameIndex == frame.publishFrameIndex){
                    invalidFrame = true;
                }
                else{
                    const auto& preamble = report.cpuTiming.stats(Name(s_PresentationTimingNameFramePreamble));
                    if((!preamble.valid() || preamble.publishFrameIndex != frame.publishFrameIndex) && successful == 0u){
                        skipFrame = true;
                    }
                    else{
                        publishFrame = frame.publishFrameIndex;
                        sourceFrame = frame.firstSampleFrameIndex;
                    }
                }
            }
        }
        if(invalidFrame)
            return false;
        if(skipFrame)
            return true;

        RendererGatherCpuSample sample = RendererGatherCpuSample();
        sample.sourceFrame = sourceFrame;
        sample.publishFrame = publishFrame;
        for(u32 scope = 0u; scope < s_GatherBenchmarkCpuScopeCount; ++scope){
            const StringView scopeText = GatherBenchmarkCpuScopeName(scope);
            b8 ok = false;
            f64 seconds = 0.0;
            native(in report, in scopeText, in publishFrame, in sourceFrame, mut ok, mut seconds){
                const auto scopeName = Name::FromText(scopeText);
                if(scopeName){
                    const auto& timing = report.cpuTiming.stats(*scopeName);
                    if(
                        timing.valid()
                        && timing.sampleCount == 1u
                        && timing.publishFrameIndex == publishFrame
                        && timing.firstSampleFrameIndex == sourceFrame
                        && timing.lastSampleFrameIndex == sourceFrame
                    ){
                        seconds = timing.seconds;
                        ok = true;
                    }
                }
            }
            if(!ok)
                return false;
            sample.milliseconds[scope] = seconds;
        }

        u32 cpuScope = 0u;
        while(cpuScope + 1u < s_GatherBenchmarkCpuScopeCount){
            const VectorDouble ms = VectorDouble(sample.milliseconds[cpuScope], sample.milliseconds[cpuScope + 1u], 0.0, 0.0) * s_PresentationPacingMsPerSecond;
            sample.milliseconds[cpuScope] = ms.x;
            sample.milliseconds[cpuScope + 1u] = ms.y;
            cpuScope += 2u;
        }
        if(cpuScope < s_GatherBenchmarkCpuScopeCount)
            sample.milliseconds[cpuScope] = sample.milliseconds[cpuScope] * s_PresentationPacingMsPerSecond;

        if(memoryEnabled){
            for(u32 arenaIndex = 0u; arenaIndex < s_GatherBenchmarkArenaScopeCount; ++arenaIndex){
                const StringView arenaText = GatherBenchmarkArenaScopeName(arenaIndex);
                b8 ok = false;
                PerfMemorySnapshot snapshot = PerfMemorySnapshot();
                native(in report, in arenaText, in publishFrame, mut ok, mut snapshot){
                    const auto arenaName = Name::FromText(arenaText);
                    if(arenaName){
                        const auto& current = report.memory.snapshot(*arenaName, Core::Perf::MemorySource::Arena);
                        if(!current.valid() || current.frameIndex == publishFrame){
                            snapshot = current;
                            ok = true;
                        }
                    }
                }
                if(!ok)
                    return false;
                sample.memory[arenaIndex] = snapshot;
            }
        }

        for(u32 gpuScope = 0u; gpuScope < s_GatherBenchmarkGpuScopeCount; ++gpuScope){
            const StringView gpuScopeText = GatherBenchmarkGpuScopeName(gpuScope);
            const b8 hadPub = this.m_hasGpuPublication[gpuScope];
            const u64 prevPub = this.m_gpuPublish[gpuScope];
            b8 invalidGpu = false;
            b8 newGpu = false;
            TimingStats gpuTiming = TimingStats();
            native(in report, in gpuScopeText, in hadPub, in prevPub, mut invalidGpu, mut newGpu, mut gpuTiming){
                const auto scopeName = Name::FromText(gpuScopeText);
                if(!scopeName){
                    invalidGpu = true;
                }
                else{
                    const auto& timing = report.gpuTiming.stats(*scopeName);
                    if(timing.valid() && (!hadPub || timing.publishFrameIndex != prevPub)){
                        if(hadPub && timing.publishFrameIndex < prevPub){
                            invalidGpu = true;
                        }
                        else{
                            gpuTiming = timing;
                            newGpu = true;
                        }
                    }
                }
            }
            if(invalidGpu)
                return false;
            if(newGpu){
                this.m_hasGpuPublication[gpuScope] = true;
                this.m_gpuPublish[gpuScope] = gpuTiming.publishFrameIndex;
                this.m_gpu.push_back(RendererGatherGpuSample(gpuTiming, gpuScope));
            }
        }

        this.m_lastPublish = publishFrame;
        this.m_hasPublication = true;
        ++this.m_successfulFrames;
        if(this.m_successfulFrames == s_GatherBenchmarkWarmupFrames)
            this.m_memoryBaseline = sample.memory;
        if(this.m_successfulFrames > s_GatherBenchmarkWarmupFrames && this.m_cpu.size() < s_GatherBenchmarkSampleFrames)
            this.m_cpu.push_back(sample);
        return true;
    }

    public b8 finished()const{
        return this.m_successfulFrames >= s_GatherBenchmarkWarmupFrames + s_GatherBenchmarkSampleFrames + s_GatherBenchmarkDrainFrames;
    }

    public u32 successfulFrames()const{
        return this.m_successfulFrames;
    }

    public b8 write(
        in StringView path,
        in StringView workload,
        in b8 memoryEnabled,
        in u32 renderers,
        in u32 runtimeRenderers,
        in u32 transparentRenderers,
        in u32 runtimeOwners
    )const{
        const b8 complete = this.finished() && this.m_cpu.size() == s_GatherBenchmarkSampleFrames;
        const String pathStr = String(path);
        b8 good = false;
        native(
            in pathStr,
            in workload,
            in memoryEnabled,
            in renderers,
            in runtimeRenderers,
            in transparentRenderers,
            in runtimeOwners,
            in complete,
            in successfulFrames = this.m_successfulFrames,
            in memoryBaseline = this.m_memoryBaseline,
            in cpuSamples = this.m_cpu,
            in gpuSamples = this.m_gpu,
            mut good
        ){
            OutputFileStream output(pathStr.c_str(), s_FileOpenTruncate);
            if(output.is_open()){
                output.setf(s_FileFormatFixed, s_FileFormatFloatField);
                output.precision(9);
                output << "{\"type\":\"configuration\",\"schema\":2,\"workload\":\"" << workload
                    << "\",\"mode\":\"" << (memoryEnabled ? "memory" : "timing")
                    << "\",\"width\":960,\"height\":720,\"warmup\":" << s_GatherBenchmarkWarmupFrames
                    << ",\"samples\":" << s_GatherBenchmarkSampleFrames << ",\"drain\":" << s_GatherBenchmarkDrainFrames
                    << ",\"successful_frames\":" << successfulFrames << ",\"renderers\":" << renderers
                    << ",\"runtime_renderers\":" << runtimeRenderers << ",\"transparent_renderers\":" << transparentRenderers
                    << ",\"runtime_owners\":" << runtimeOwners
                    << ",\"reflection_mode\":\"hardware\",\"hardware_budget\":4096,\"optical_queries\":16"
                    << ",\"temporal\":false,\"spatial\":false,\"feedback\":false,\"diagnostics\":false"
                    << ",\"fixed_delta_seconds\":0.016666667,\"sampling_seed\":0,\"refraction\":true}\n";
                if(memoryEnabled){
                    output << "{\"type\":\"memory_baseline\",\"arenas\":";
                    WriteGatherBenchmarkMemory(memoryBaseline, output);
                    output << "}\n";
                }
                for(const RendererGatherCpuSample& sample : cpuSamples){
                    output << "{\"type\":\"cpu\",\"source_frame\":" << sample.sourceFrame << ",\"publish_frame\":" << sample.publishFrame << ",\"scopes_ms\":{";
                    for(u32 scope = 0u; scope < s_GatherBenchmarkCpuScopeCount; ++scope){
                        if(scope != 0u)
                            output << ',';
                        output << '"' << GatherBenchmarkCpuScopeName(scope) << "\":" << sample.milliseconds[scope];
                    }
                    output << '}';
                    if(memoryEnabled){
                        output << ",\"arenas\":";
                        WriteGatherBenchmarkMemory(sample.memory, output);
                    }
                    output << "}\n";
                }
                for(usize index = 0u; index < gpuSamples.size(); index += 2u){
                    const usize count = Min(usize{ 2u }, gpuSamples.size() - index);
                    const SIMDVectorDouble milliseconds = VectorDoubleScale(
                        VectorDoubleSet(
                            gpuSamples[index].timing.seconds,
                            count > 1u ? gpuSamples[index + 1u].timing.seconds : 0.0,
                            0.0,
                            0.0
                        ),
                        s_PresentationPacingMsPerSecond
                    );
                    for(usize lane = 0u; lane < count; ++lane){
                        const RendererGatherGpuSample& sample = gpuSamples[index + lane];
                        output << "{\"type\":\"gpu\",\"scope\":\"" << GatherBenchmarkGpuScopeName(sample.scope)
                            << "\",\"publish_frame\":" << sample.timing.publishFrameIndex
                            << ",\"first_source_frame\":" << sample.timing.firstSampleFrameIndex
                            << ",\"last_source_frame\":" << sample.timing.lastSampleFrameIndex
                            << ",\"total_ms\":" << VectorDoubleGetByIndex(milliseconds, lane)
                            << ",\"samples\":" << sample.timing.sampleCount << "}\n";
                    }
                }
                if(complete)
                    output << "{\"type\":\"complete\"}\n";
                output.close();
                good = output.good() && complete;
            }
        }
        return good;
    }

    private Array<PerfMemorySnapshot, s_GatherBenchmarkArenaScopeCount> m_memoryBaseline;
    private Array<u64, s_GatherBenchmarkGpuScopeCount> m_gpuPublish;
    private Vector<RendererGatherCpuSample> m_cpu;
    private Vector<RendererGatherGpuSample> m_gpu;
    private Array<b8, s_GatherBenchmarkGpuScopeCount> m_hasGpuPublication;
    private u64 m_lastPublish = 0u;
    private u32 m_successfulFrames = 0u;
    private b8 m_hasPublication = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

