[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_model_renderer/model_renderer.adhd.h>

#include <core/ecs/entity.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace NWB::Tests::ModelCases{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using Entity = Core::ECS::Entity;
using World = Core::ECS::World;
using Material = Impl::Material;
using RendererComponent = Impl::RendererComponent;
using MaterialInstanceComponent = Impl::MaterialInstanceComponent;
using MaterialInstanceParameter = Impl::MaterialInstanceParameter;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize MaterialInstanceComponentAddress(in World world, in EntityID entity){
    usize address = 0u;
    native(in world, in entity, mut address){
        address = reinterpret_cast<usize>(world.tryGetComponent<MaterialInstanceComponent>(entity));
    }
    return address;
}

void VerifyModelRendererOwnerOverridesSurvivePoolGrowth(){
    EcsTestWorld context = EcsTestWorld();
    Entity owner = context.world.createEntity();
    mut RendererComponent renderer = owner.addComponent<RendererComponent>();
    const Name identity = s_ModelFixtureNameObject;
    renderer.material = AssetRef<Material>(identity);
    mut MaterialInstanceComponent source = owner.addComponent<MaterialInstanceComponent>(identity);
    source.revision = 7u;
    MaterialInstanceParameter overrideItem = MaterialInstanceParameter();
    overrideItem.parameterName = identity;
    source.overrides.push_back(overrideItem);

    b8 relocated = false;
    for(u32 index = 0u; index < 256u && !relocated; ++index){
        const usize beforeAddress = MaterialInstanceComponentAddress(context.world, owner.id());
        ASSERT_NE(beforeAddress, 0u);

        Entity child = context.world.createEntity();
        Impl::ApplyModelObjectRenderer(owner.id(), AssetRef<Material>(), context.world, child);

        const usize afterAddress = MaterialInstanceComponentAddress(context.world, owner.id());
        const usize copiedAddress = MaterialInstanceComponentAddress(context.world, child.id());
        ASSERT_NE(afterAddress, 0u);
        ASSERT_NE(copiedAddress, 0u);
        relocated = beforeAddress != afterAddress;

        mut MaterialInstanceComponent after = context.world.entity(owner.id()).getComponent<MaterialInstanceComponent>();
        mut MaterialInstanceComponent copied = child.getComponent<MaterialInstanceComponent>();
        ASSERT_EQ(after.overrides.size(), 1u);
        ASSERT_EQ(copied.overrides.size(), 1u);
        EXPECT_EQ(copied.materialInterface, identity);
        EXPECT_EQ(copied.revision, 7u);
        EXPECT_EQ(copied.overrides.front().parameterName, identity);
    }
    EXPECT_TRUE(relocated);
}

NWB_ADHD_GTEST(ModelRenderer, OwnerOverridesSurviveMaterialComponentPoolGrowth, VerifyModelRendererOwnerOverridesSurvivePoolGrowth)


