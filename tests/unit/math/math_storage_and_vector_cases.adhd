VectorSingle FailSingleTransform(in VectorSingle value, in MatrixSingle matrix){
    ThrowTestException<u32>(0xe206u);
    return value;
}

VectorDouble FailDoubleTransform(in VectorDouble value, in MatrixDouble matrix){
    ThrowTestException<u32>(0xe207u);
    return value;
}

VectorSingle KeepSingleTransform(in VectorSingle value, in MatrixSingle matrix){ return value; }
VectorDouble KeepDoubleTransform(in VectorDouble value, in MatrixDouble matrix){ return value; }


