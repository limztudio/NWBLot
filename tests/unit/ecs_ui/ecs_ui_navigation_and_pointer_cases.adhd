void VerifyUiEditActionHostTests_ReboundEditorModelCannotReceiveAnEarlierHeldSubmit(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    InputEvent down = InputEvent();
    down.key = Key::Enter;
    down.type = InputEventType::KeyDown;
    ASSERT_TRUE(self.core.dispatch(down));
    EditModel replacement = EditModel();
    ASSERT_TRUE(replacement.setText("replacement"));
    ASSERT_TRUE(PrepareEcsUiEditActionsFrame(self.core, replacement, EditBoxOptions(), MakeEcsUiRect(10.0f, 20.0f, 180.0f, 30.0f), self.m_actions));
    ASSERT_TRUE(self.core.commit());
    self.m_actions.clear();
    InputEvent up = InputEvent();
    up.key = Key::Enter;
    up.type = InputEventType::KeyUp;
    ASSERT_TRUE(self.core.dispatch(up));
    ASSERT_TRUE(PrepareEcsUiEditActionsFrame(self.core, replacement, EditBoxOptions(), MakeEcsUiRect(10.0f, 20.0f, 180.0f, 30.0f), self.m_actions));
    ASSERT_TRUE(self.core.commit());
    EXPECT_FALSE(self.core.m_result.submitted);
    EXPECT_EQ(self.actionCount(EditAction::Submit), 0u);
    ASSERT_TRUE(self.core.key(Key::Enter));
    ASSERT_TRUE(PrepareEcsUiEditActionsFrame(self.core, replacement, EditBoxOptions(), MakeEcsUiRect(10.0f, 20.0f, 180.0f, 30.0f), self.m_actions));
    ASSERT_TRUE(self.core.commit());
    EXPECT_EQ(self.actionCount(EditAction::Submit), 1u);
}

