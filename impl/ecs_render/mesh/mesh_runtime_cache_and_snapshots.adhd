#include <impl/ecs_render/mesh/mesh_raytracing_snapshots.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize ComputeSolidTriangleWordByteSize(in usize wordCount, in usize wordByteSize){
    return wordCount * wordByteSize;
}

b8 RequiresShadowSoftwareBvhBuild(in b8 rtSupported){
    return !rtSupported;
}

b8 RuntimeMeshSourceDimensionsMatch(
    in u64 meshVersion,
    in u64 descVersion,
    in u32 meshletCount,
    in u32 descMeshletCount,
    in u32 primitiveIndexCount,
    in u32 descPrimitiveIndexCount
){
    return meshVersion == descVersion && meshletCount == descMeshletCount && primitiveIndexCount == descPrimitiveIndexCount;
}


