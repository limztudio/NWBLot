const Name s_CsgIntervalPeelShaderDebugName = "ECSRender_CsgIntervalPeelCS";
const Name s_CsgReceiverSpanBuildShaderDebugName = "ECSRender_CsgReceiverSpanBuildCS";
const Name s_CsgIntervalCombineShaderDebugName = "ECSRender_CsgIntervalCombineCS";
const Name s_CsgIntervalCapFillShaderDebugName = "ECSRender_CsgIntervalCapFillPS";
const Name s_CsgRefractionCapFillShaderDebugName = "ECSRender_CsgRefractionCapFillPS";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CsgIntervalComputeDispatchPlan{
    public CsgIntervalDispatchPushConstants pushConstants;
    public u32 groupsX = 0u;
    public u32 groupsY = 0u;
    public b8 active = false;
}

CsgIntervalComputeDispatchPlan BuildCsgIntervalComputeDispatchPlan(
    in CsgFrameWorkRegion workRegion,
    in u32 frameWidth,
    in u32 frameHeight,
    in u32 csgPeelLayerCount,
    in u32 receiverCount,
    in u32 meshViewHeapSlot,
    in u32 csgContextHeapSlot,
    in u32 groupSizeX,
    in u32 groupSizeY
){
    CsgIntervalComputeDispatchPlan plan;
    plan.pushConstants = ResolveCsgIntervalDispatchPushConstants(
        workRegion,
        frameWidth,
        frameHeight,
        csgPeelLayerCount,
        receiverCount,
        meshViewHeapSlot,
        csgContextHeapSlot
    );
    if(plan.pushConstants.workExtentX == 0u || plan.pushConstants.workExtentY == 0u)
        return plan;
    plan.groupsX = DivideUp(plan.pushConstants.workExtentX, groupSizeX);
    plan.groupsY = DivideUp(plan.pushConstants.workExtentY, groupSizeY);
    plan.active = true;
    return plan;
}

b8 HasValidCsgIntervalSampleTargetState(
    in b8 hasReceiverEventData,
    in b8 hasReceiverEventCount,
    in b8 hasRemovedIntervalDepth,
    in b8 hasRemovedIntervalCapNormal,
    in b8 hasRemovedIntervalData,
    in b8 hasRemovedIntervalCount,
    in u32 receiverEventLayerCount,
    in u32 removedIntervalLayerCount
){
    return hasReceiverEventData
        && hasReceiverEventCount
        && hasRemovedIntervalDepth
        && hasRemovedIntervalCapNormal
        && hasRemovedIntervalData
        && hasRemovedIntervalCount
        && receiverEventLayerCount != 0u
        && removedIntervalLayerCount != 0u
    ;
}

b8 HasValidCsgIntervalPeelTargetState(
    in b8 hasCapBackNormal,
    in b8 hasIntervalDepth,
    in b8 hasIntervalId,
    in b8 hasReceiverSpanData,
    in b8 hasReceiverSpanCount,
    in u32 peelLayerCount,
    in u32 receiverSpanLayerCount,
    in b8 sampleTargetsValid
){
    return sampleTargetsValid
        && hasCapBackNormal
        && hasIntervalDepth
        && hasIntervalId
        && hasReceiverSpanData
        && hasReceiverSpanCount
        && peelLayerCount != 0u
        && receiverSpanLayerCount != 0u
    ;
}

FramebufferInfo BuildCsgFramebufferInfo(in FramebufferInfoEx infoEx){
    FramebufferInfo framebufferInfo;
    framebufferInfo.sampleCount = infoEx.sampleCount;
    framebufferInfo.sampleQuality = infoEx.sampleQuality;
    framebufferInfo.depthFormat = infoEx.depthFormat;
    framebufferInfo.colorFormats = infoEx.colorFormats;
    return framebufferInfo;
}

b8 CreateIntervalCapFillPipeline(
    in ShaderHandle vertexShader,
    in ShaderHandle pixelShader,
    in BindingLayoutHandle clipBindingLayout,
    in FramebufferInfo framebufferInfo,
    mut Device device,
    mut GraphicsPipelineHandle pipeline
){
    if(pipeline.valid() && pipeline.deref().getFramebufferInfo() == framebufferInfo)
        return true;

    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized())
        return false;

    GraphicsPipelineDesc pipelineDesc;
    pipelineDesc.setVertexShader(vertexShader).setPixelShader(pixelShader).setRenderState(BuildCompositeRenderState()).addBindingLayout(clipBindingLayout).addBindingLayout(heap.getResourceLayout()).addBindingLayout(heap.getSamplerLayout());

    const Expected<GraphicsPipelineHandle> pipelineResult = device.createGraphicsPipeline(pipelineDesc, framebufferInfo);
    if(pipelineResult.has_value()){
        pipeline = pipelineResult.value();
        return true;
    }
    pipeline.reset();
    return false;
}

b8 CreateCsgTargetTexture(
    in u32 width,
    in u32 height,
    in Format format,
    in Name name,
    in u32 layerCount,
    in b8 renderTarget,
    in StringView errorMessage,
    mut GraphicsRuntime graphics,
    mut TextureHandle outTexture
){
    TextureDesc desc;
    desc.setWidth(width).setHeight(height).setArraySize(layerCount).setFormat(format).setDimension(TextureDimension::Texture2DArray).setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute);
    if(renderTarget)
        desc.setIsRenderTarget(true);
    desc.setIsUAV(true).setName(name);
    const Expected<TextureHandle> result = graphics.createTexture(desc);
    if(!result.has_value()){
        outTexture.reset();
        error("{}", errorMessage);
        return false;
    }
    outTexture = result.value();
    return true;
}

void DispatchCsgIntervalCompute(
    in DeferredFrameTargets targets,
    in CsgFrameGpuDataView csgFrameData,
    in u32 csgContextHeapSlot,
    in u32 meshViewHeapSlot,
    mut CommandList commandList,
    mut GpuDescriptorHeap heap,
    mut ComputePipeline pipeline
){
    ComputeState computeState;
    computeState.setPipeline(pipeline);
    // Push-only layout; the rest is heap-selected.
    commandList.setComputeState(computeState);
    // Bind after setComputeState so the StorageImage table resolves.
    heap.bindCompute(commandList, pipeline);

    const CsgIntervalComputeDispatchPlan dispatchPlan = BuildCsgIntervalComputeDispatchPlan(
        csgFrameData.workRegion,
        targets.width,
        targets.height,
        targets.csgPeelLayerCount,
        cast<u32>(csgFrameData.receiverRanges.size()),
        meshViewHeapSlot,
        csgContextHeapSlot,
        s_CsgIntervalPeelGroupSizeX,
        s_CsgIntervalPeelGroupSizeY
    );
    if(!dispatchPlan.active)
        return;
    commandList.setPushConstants(dispatchPlan.pushConstants);
    commandList.dispatch(dispatchPlan.groupsX, dispatchPlan.groupsY, 1u);
}

void DispatchCsgIntervalCompute(
    in DeferredFrameTargets targets,
    in CsgFrameGpuDataView csgFrameData,
    in u32 csgContextHeapSlot,
    mut CommandList commandList,
    mut GpuDescriptorHeap heap,
    mut ComputePipeline pipeline
){
    DispatchCsgIntervalCompute(targets, csgFrameData, csgContextHeapSlot, 0u, commandList, heap, pipeline);
}

b8 RendererCsgSystem::createCsgPeelTargets(mut DeferredFrameTargets targets){
    if(targets.csgIntervalTargetsValid())
        return true;

    ResetCsgIntervalTargets(targets);

    assert(targets.width > 0u && targets.height > 0u);
    assert(targets.csgCapNormalFormat != Format::UNKNOWN);
    assert(targets.csgIntervalDepthFormat != Format::UNKNOWN);
    assert(targets.csgIntervalIdFormat != Format::UNKNOWN);
    assert(targets.csgReceiverEventDataFormat != Format::UNKNOWN);
    assert(targets.csgReceiverEventCountFormat != Format::UNKNOWN);
    assert(targets.csgReceiverSpanDataFormat != Format::UNKNOWN);
    assert(targets.csgReceiverSpanCountFormat != Format::UNKNOWN);
    assert(targets.csgRemovedIntervalDepthFormat != Format::UNKNOWN);
    assert(targets.csgRemovedIntervalCapNormalFormat != Format::UNKNOWN);
    assert(targets.csgRemovedIntervalDataFormat != Format::UNKNOWN);
    assert(targets.csgRemovedIntervalCountFormat != Format::UNKNOWN);
    assert(targets.csgPeelLayerCount == s_CsgPeelLayerCount);
    assert(targets.csgReceiverEventLayerCount == s_CsgReceiverEventLayerCount);
    assert(targets.csgReceiverSpanLayerCount == s_CsgReceiverSpanLayerCount);
    assert(targets.csgRemovedIntervalLayerCount == s_CsgRemovedIntervalLayerCount);

    return
        CreateCsgTargetTexture(targets.width, targets.height, targets.csgCapNormalFormat, s_RenderNameEngineDeferredCsgCapBackNormal, targets.csgPeelLayerCount, true, "RendererSystem: failed to create deferred CSG cap back-normal peel target", this.m_graphics, targets.csgCapBackNormal)
        && CreateCsgTargetTexture(targets.width, targets.height, targets.csgIntervalDepthFormat, s_RenderNameEngineDeferredCsgIntervalDepth, targets.csgPeelLayerCount, true, "RendererSystem: failed to create deferred CSG interval depth peel target", this.m_graphics, targets.csgIntervalDepth)
        && CreateCsgTargetTexture(targets.width, targets.height, targets.csgIntervalIdFormat, s_RenderNameEngineDeferredCsgIntervalId, targets.csgPeelLayerCount, true, "RendererSystem: failed to create deferred CSG interval id peel target", this.m_graphics, targets.csgIntervalId)
        && CreateCsgTargetTexture(targets.width, targets.height, targets.csgReceiverEventDataFormat, s_RenderNameEngineDeferredCsgReceiverEventData, targets.csgReceiverEventLayerCount, false, "RendererSystem: failed to create deferred CSG receiver event data target", this.m_graphics, targets.csgReceiverEventData)
        && CreateCsgTargetTexture(targets.width, targets.height, targets.csgReceiverEventCountFormat, s_RenderNameEngineDeferredCsgReceiverEventCount, 1u, false, "RendererSystem: failed to create deferred CSG receiver event count target", this.m_graphics, targets.csgReceiverEventCount)
        && CreateCsgTargetTexture(targets.width, targets.height, targets.csgReceiverSpanDataFormat, s_RenderNameEngineDeferredCsgReceiverSpanData, targets.csgReceiverSpanLayerCount, false, "RendererSystem: failed to create deferred CSG receiver span data target", this.m_graphics, targets.csgReceiverSpanData)
        && CreateCsgTargetTexture(targets.width, targets.height, targets.csgReceiverSpanCountFormat, s_RenderNameEngineDeferredCsgReceiverSpanCount, 1u, false, "RendererSystem: failed to create deferred CSG receiver span count target", this.m_graphics, targets.csgReceiverSpanCount)
        && CreateCsgTargetTexture(targets.width, targets.height, targets.csgRemovedIntervalDepthFormat, s_RenderNameEngineDeferredCsgRemovedIntervalDepth, targets.csgRemovedIntervalLayerCount, false, "RendererSystem: failed to create deferred CSG removed interval depth target", this.m_graphics, targets.csgRemovedIntervalDepth)
        && CreateCsgTargetTexture(targets.width, targets.height, targets.csgRemovedIntervalCapNormalFormat, s_RenderNameEngineDeferredCsgRemovedIntervalCapNormal, targets.csgRemovedIntervalLayerCount, false, "RendererSystem: failed to create deferred CSG removed interval cap-normal target", this.m_graphics, targets.csgRemovedIntervalCapNormal)
        && CreateCsgTargetTexture(targets.width, targets.height, targets.csgRemovedIntervalDataFormat, s_RenderNameEngineDeferredCsgRemovedIntervalData, targets.csgRemovedIntervalLayerCount, false, "RendererSystem: failed to create deferred CSG removed interval data target", this.m_graphics, targets.csgRemovedIntervalData)
        && CreateCsgTargetTexture(targets.width, targets.height, targets.csgRemovedIntervalCountFormat, s_RenderNameEngineDeferredCsgRemovedIntervalCount, 1u, false, "RendererSystem: failed to create deferred CSG removed interval count target", this.m_graphics, targets.csgRemovedIntervalCount)
    ;
}

b8 RendererCsgSystem::createCsgIntervalPeelResources(mut DeferredFrameTargets targets, in b8 capFillRequired){
    mut Device device = this.m_graphics.getDevice();
    if(!this.createCsgClipResources())
        return false;
    if(!this.m_csgState.m_clipBindingLayout.valid()){
        error("RendererSystem: CSG interval peel requires a CSG clip binding layout");
        return false;
    }
    if(!this.m_meshSystem.meshViewBufferSnapshot().valid()){
        error("RendererSystem: CSG interval peel requires a mesh view buffer");
        return false;
    }
    const b8 sampleTargetsValid = HasValidCsgIntervalSampleTargetState(
        targets.csgReceiverEventData.valid(),
        targets.csgReceiverEventCount.valid(),
        targets.csgRemovedIntervalDepth.valid(),
        targets.csgRemovedIntervalCapNormal.valid(),
        targets.csgRemovedIntervalData.valid(),
        targets.csgRemovedIntervalCount.valid(),
        targets.csgReceiverEventLayerCount,
        targets.csgRemovedIntervalLayerCount
    );
    if(!HasValidCsgIntervalPeelTargetState(
        targets.csgCapBackNormal.valid(),
        targets.csgIntervalDepth.valid(),
        targets.csgIntervalId.valid(),
        targets.csgReceiverSpanData.valid(),
        targets.csgReceiverSpanCount.valid(),
        targets.csgPeelLayerCount,
        targets.csgReceiverSpanLayerCount,
        sampleTargetsValid
    )){
        error("RendererSystem: CSG interval peel requires valid peel targets");
        return false;
    }

    if(!this.createCsgIntervalSampleStateBuffer())
        return false;

    // Push range selects the CSG context and mesh view; the rest is heap-owned.
    if(!EnsurePushConstantBindingLayout(device, sizeof(CsgIntervalDispatchPushConstants), ShaderTypeMask::Compute, this.m_csgState.m_intervalPeelBindingLayout)){
        error("RendererSystem: failed to create CSG interval peel binding layout");
        return false;
    }

    if(!EnsurePushConstantBindingLayout(device, sizeof(CsgIntervalDispatchPushConstants), ShaderTypeMask::Compute, this.m_csgState.m_receiverSpanBuildBindingLayout)){
        error("RendererSystem: failed to create CSG receiver span build binding layout");
        return false;
    }

    if(!EnsurePushConstantBindingLayout(device, sizeof(CsgIntervalDispatchPushConstants), ShaderTypeMask::Compute, this.m_csgState.m_intervalCombineBindingLayout)){
        error("RendererSystem: failed to create CSG interval combine binding layout");
        return false;
    }

    if(!this.m_csgState.m_intervalPeelComputeShader.valid()){
        if(!this.m_shaderSystem.loadShader<ComputeShader, CsgSubsystem>(lambda[](in CsgSubsystem s) -> AssetRef<ComputeShader>{ return s.intervalPeelCs; }, s_ShaderArchiveDefaultVariant, s_CsgIntervalPeelShaderDebugName, this.m_csgState.m_intervalPeelComputeShader))
            return false;
    }

    if(!this.m_csgState.m_receiverSpanBuildComputeShader.valid()){
        if(!this.m_shaderSystem.loadShader<ComputeShader, CsgSubsystem>(lambda[](in CsgSubsystem s) -> AssetRef<ComputeShader>{ return s.receiverSpanBuildCs; }, s_ShaderArchiveDefaultVariant, s_CsgReceiverSpanBuildShaderDebugName, this.m_csgState.m_receiverSpanBuildComputeShader))
            return false;
    }

    if(!this.m_csgState.m_intervalCombineComputeShader.valid()){
        if(!this.m_shaderSystem.loadShader<ComputeShader, CsgSubsystem>(lambda[](in CsgSubsystem s) -> AssetRef<ComputeShader>{ return s.intervalCombineCs; }, s_ShaderArchiveDefaultVariant, s_CsgIntervalCombineShaderDebugName, this.m_csgState.m_intervalCombineComputeShader))
            return false;
    }

    if(capFillRequired){
        if(!this.m_shaderSystem.loadDeferredCompositeVertexShader())
            return false;

        if(!this.m_csgState.m_intervalCapFillPixelShader.valid()){
            if(!this.m_shaderSystem.loadShader<PixelShader, CsgSubsystem>(lambda[](in CsgSubsystem s) -> AssetRef<PixelShader>{ return s.intervalCapFillPs; }, s_ShaderArchiveDefaultVariant, s_CsgIntervalCapFillShaderDebugName, this.m_csgState.m_intervalCapFillPixelShader))
                return false;
        }
    }

    if(!this.m_csgState.m_intervalPeelPipeline.valid() && !CreateHeapComputePipeline(device, this.m_csgState.m_intervalPeelComputeShader, this.m_csgState.m_intervalPeelBindingLayout, false, this.m_csgState.m_intervalPeelPipeline)){
        error("RendererSystem: failed to create CSG interval peel pipeline");
        return false;
    }

    if(!this.m_csgState.m_receiverSpanBuildPipeline.valid() && !CreateHeapComputePipeline(device, this.m_csgState.m_receiverSpanBuildComputeShader, this.m_csgState.m_receiverSpanBuildBindingLayout, false, this.m_csgState.m_receiverSpanBuildPipeline)){
        error("RendererSystem: failed to create CSG receiver span build pipeline");
        return false;
    }

    if(!this.m_csgState.m_intervalCombinePipeline.valid() && !CreateHeapComputePipeline(device, this.m_csgState.m_intervalCombineComputeShader, this.m_csgState.m_intervalCombineBindingLayout, false, this.m_csgState.m_intervalCombinePipeline)){
        error("RendererSystem: failed to create CSG interval combine pipeline");
        return false;
    }

    if(capFillRequired && !CreateIntervalCapFillPipeline(
        this.m_shaderSystem.deferredCompositeVertexShader(),
        this.m_csgState.m_intervalCapFillPixelShader,
        this.m_csgState.m_clipBindingLayout,
        BuildCsgFramebufferInfo(targets.framebuffer.deref().getFramebufferInfo()),
        device,
        this.m_csgState.m_intervalCapFillPipeline
    )){
        error("RendererSystem: failed to create CSG interval cap fill pipeline");
        return false;
    }

    if(!this.createCsgIntervalSampleResources(targets))
        return false;

    return true;
}

b8 RendererCsgSystem::createCsgIntervalSampleResources(mut DeferredFrameTargets targets){
    if(!this.m_meshSystem.meshViewBufferSnapshot().valid()){
        error("RendererSystem: CSG interval sampling requires a mesh view buffer");
        return false;
    }
    if(!HasValidCsgIntervalSampleTargetState(
        targets.csgReceiverEventData.valid(),
        targets.csgReceiverEventCount.valid(),
        targets.csgRemovedIntervalDepth.valid(),
        targets.csgRemovedIntervalCapNormal.valid(),
        targets.csgRemovedIntervalData.valid(),
        targets.csgRemovedIntervalCount.valid(),
        targets.csgReceiverEventLayerCount,
        targets.csgRemovedIntervalLayerCount
    )){
        error("RendererSystem: CSG interval sampling requires valid peel targets");
        return false;
    }

    if(!this.createCsgIntervalSampleStateBuffer())
        return false;

    return true;
}

b8 RendererCsgSystem::prepareRefractionIntervalCapResources(in DeferredFrameTargets targets){
    if(!targets.avboit.refractionFramebuffer.valid() || !this.m_csgState.m_clipBindingLayout.valid())
        return false;
    if(!this.m_shaderSystem.loadDeferredCompositeVertexShader())
        return false;
    if(!this.m_csgState.m_refractionCapFillPixelShader.valid()){
        if(!this.m_shaderSystem.loadShader<PixelShader, CsgSubsystem>(lambda[](in CsgSubsystem s) -> AssetRef<PixelShader>{ return s.refractionCapFillPs; }, s_ShaderArchiveDefaultVariant, s_CsgRefractionCapFillShaderDebugName, this.m_csgState.m_refractionCapFillPixelShader))
            return false;
    }
    if(!CreateIntervalCapFillPipeline(
        this.m_shaderSystem.deferredCompositeVertexShader(),
        this.m_csgState.m_refractionCapFillPixelShader,
        this.m_csgState.m_clipBindingLayout,
        BuildCsgFramebufferInfo(targets.avboit.refractionFramebuffer.deref().getFramebufferInfo()),
        this.m_graphics.getDevice(),
        this.m_csgState.m_refractionCapFillPipeline
    )){
        error("RendererSystem: failed to create CSG refraction cap fill pipeline");
        return false;
    }
    return true;
}

void RendererCsgSystem::dispatchCsgIntervalPeels(
    mut CommandList commandList,
    mut DeferredFrameTargets targets,
    in CsgFrameGpuDataView csgFrameData,
    in CsgGraphResourceSnapshot csgResources,
    in MeshFrameBindingSnapshot frameBindings
){
    if(!csgFrameData.hasWork())
        return;
    assert(this.m_csgState.m_intervalPeelPipeline.valid());
    assert(csgResources.frameReady(csgFrameData));
    assert(frameBindings.bindingValid());

    GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeCsgIntervalPeel, this.m_graphics.getDevice(), commandList);

    DispatchCsgIntervalCompute(
        targets,
        csgFrameData,
        csgResources.clipContextSlotsHeapHandle.slot(),
        frameBindings.meshView.heapHandle.slot(),
        commandList,
        this.m_graphics.getDevice().getDescriptorHeap(),
        this.m_csgState.m_intervalPeelPipeline.deref()
    );
}

void RendererCsgSystem::dispatchCsgReceiverSpanBuild(mut CommandList commandList, mut DeferredFrameTargets targets, in CsgFrameGpuDataView csgFrameData, in CsgGraphResourceSnapshot csgResources){
    if(!csgFrameData.hasWork())
        return;
    assert(this.m_csgState.m_receiverSpanBuildPipeline.valid());
    assert(csgResources.frameReady(csgFrameData));

    GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeCsgReceiverSpanBuild, this.m_graphics.getDevice(), commandList);

    commandList.endRenderPass();
    DispatchCsgIntervalCompute(targets, csgFrameData, csgResources.clipContextSlotsHeapHandle.slot(), commandList, this.m_graphics.getDevice().getDescriptorHeap(), this.m_csgState.m_receiverSpanBuildPipeline.deref());
}

void RendererCsgSystem::dispatchCsgIntervalCombine(mut CommandList commandList, mut DeferredFrameTargets targets, in CsgFrameGpuDataView csgFrameData, in CsgGraphResourceSnapshot csgResources){
    if(!csgFrameData.hasWork())
        return;
    assert(this.m_csgState.m_intervalCombinePipeline.valid());
    assert(csgResources.frameReady(csgFrameData));

    GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeCsgIntervalCombine, this.m_graphics.getDevice(), commandList);

    commandList.endRenderPass();
    DispatchCsgIntervalCompute(targets, csgFrameData, csgResources.clipContextSlotsHeapHandle.slot(), commandList, this.m_graphics.getDevice().getDescriptorHeap(), this.m_csgState.m_intervalCombinePipeline.deref());
}

void RendererCsgSystem::renderCsgIntervalCaps(mut CommandList commandList, mut DeferredFrameTargets targets, in CsgFrameGpuDataView csgFrameData, in CsgGraphResourceSnapshot csgResources){
    assert(this.m_csgState.m_intervalCapFillPipeline.valid());
    assert(csgResources.frameReady(csgFrameData));
    assert(targets.framebuffer.valid());

    GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeCsgCapFill, this.m_graphics.getDevice(), commandList);

    ViewportState viewportState;
    viewportState.addViewport(targets.framebuffer.deref().getFramebufferInfo().getViewport()).addScissorRect(ToCoreRect(csgFrameData.workRegion.resolveRect(targets.width, targets.height)));

    GraphicsState graphicsState;
    graphicsState.setPipeline(this.m_csgState.m_intervalCapFillPipeline.deref());
    graphicsState.setFramebuffer(targets.framebuffer.deref());
    graphicsState.setViewport(viewportState);
    commandList.setGraphicsState(graphicsState);
    this.m_graphics.getDevice().getDescriptorHeap().bindGraphics(commandList, this.m_csgState.m_intervalCapFillPipeline.deref());

    MeshFrameHeapSlots frameHeapSlots;
    frameHeapSlots.generatedVertex = csgResources.clipContextSlotsHeapHandle.slot();
    SetShaderDrivenPushConstants(commandList, 0u, 0u, 0u, viewportState, frameHeapSlots, 0u);

    DrawArguments drawArgs;
    drawArgs.setVertexCount(s_FullscreenTriangleVertexCount);
    commandList.draw(drawArgs);
}

void RendererCsgSystem::renderRefractionIntervalCaps(mut CommandList commandList, in DeferredFrameTargets targets, in CsgGraphResourceSnapshot csgResources, in Rect workRect, in Span<u32> receiverIndices){
    assert(csgResources.refractionCapFillPipeline.valid());
    assert(csgResources.bindingValid());
    assert(targets.avboit.refractionFramebuffer.valid());
    assert(targets.bindless.slotsBufferDescriptor.valid());
    assert(!receiverIndices.empty());

    ViewportState viewportState;
    viewportState.addViewport(targets.avboit.refractionFramebuffer.deref().getFramebufferInfo().getViewport()).addScissorRect(workRect);
    GraphicsState graphicsState;
    graphicsState.setPipeline(csgResources.refractionCapFillPipeline.deref());
    graphicsState.setFramebuffer(targets.avboit.refractionFramebuffer.deref());
    graphicsState.setViewport(viewportState);
    commandList.setGraphicsState(graphicsState);
    this.m_graphics.getDevice().getDescriptorHeap().bindGraphics(commandList, csgResources.refractionCapFillPipeline.deref());

    MeshFrameHeapSlots frameHeapSlots;
    frameHeapSlots.view = targets.bindless.slotsBufferDescriptor.slot();
    frameHeapSlots.generatedVertex = csgResources.clipContextSlotsHeapHandle.slot();
    DrawArguments drawArgs;
    drawArgs.setVertexCount(s_FullscreenTriangleVertexCount);
    for(in u32 receiverIndex : receiverIndices){
        SetShaderDrivenPushConstants(commandList, 0u, receiverIndex, 0u, viewportState, frameHeapSlots, 0u);
        commandList.draw(drawArgs);
    }
}


