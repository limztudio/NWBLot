////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace LoggerCrashSymbolicateDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace CrashNames = ::NWB::Core::Crash::PackageNames;

inline constexpr usize s_DecimalTextBufferCapacity = ::NWB::Log::s_CrashSymbolicateInternalDecimalTextBufferCapacity;
inline constexpr usize s_CrashReportReserveBytes = ::NWB::Log::s_CrashSymbolicateInternalCrashReportReserveBytes;
inline constexpr AStringView s_HexAddressPrefix = ::NWB::Log::s_CrashSymbolicateInternalHexAddressPrefix;
inline constexpr AStringView s_CallstackSectionHeader = ::NWB::Log::s_CrashSymbolicateInternalCallstackSectionHeader;

struct CrashSymbolicationFailure{
    AStringView operation;
    ErrorCode code;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static void AppendNativeFailure(const CrashSymbolicationFailure& failure, CrashReportText& outReport){
    const DiagnosticEventText detail = MakeDiagnosticEventText("operation={}\nnative_category={}\nnative_code={}\n", failure.operation, failure.code.category().name(), failure.code.value());
    outReport += detail.view();
}

static void AppendOptionalTextFile(const CrashScratchPath& packageDirectory, const AStringView fileName, const AStringView label, Core::Alloc::ScratchArena& scratchArena, CrashReportText& outReport){
    AString<Core::Alloc::ScratchArena> text{scratchArena};
    const auto read = ReadTextFile(packageDirectory / fileName, text);
    if(!read){
        if(read.error() != ErrorCondition::no_such_file_or_directory){
            outReport += s_CrashSymbolicateReportSectionOpen;
            outReport += label;
            outReport += "]\nstatus=read_failed\n";
            AppendNativeFailure(CrashSymbolicationFailure{ .operation = fileName, .code = read.error(), }, outReport);
        }
        return;
    }
    if(text.empty())
        return;

    outReport += s_CrashSymbolicateReportSectionOpen;
    outReport += label;
    outReport += "]\n";
    outReport += text;
    if(outReport.back() != '\n')
        outReport += '\n';
}

[[nodiscard]] static CrashScratchPath EffectiveSymbolStoreDirectory(const CrashSymbolicationConfig& config, Core::Alloc::ScratchArena& arena){
    if(!config.symbolStoreDirectory.empty())
        return CrashScratchPath(arena, config.symbolStoreDirectory);

    return CrashDefaultRootDirectory(arena) / s_CrashSymbolStoreDirectoryName;
}

static void AppendSymbolStoreStatus(const CrashSymbolicationConfig& config, Core::Alloc::ScratchArena& arena, CrashReportText& outReport){
    const CrashScratchPath symbolStoreDirectory = EffectiveSymbolStoreDirectory(config, arena);
    outReport += "symbol_store=";
    outReport += PathToString<char>(arena, symbolStoreDirectory);
    outReport += "\nsymbol_store_status=";

    const auto exists = IsDirectory(symbolStoreDirectory);
    outReport += SelectSymbolStoreStatusText(exists.has_value(), exists.has_value() && *exists);
    outReport += s_ReportLineEnd;
}

static void AppendExceptionSummary(const CrashPackageSummary& summary, CrashReportText& outReport){
    if(summary.reasonKind == Core::Crash::s_SignalReasonKind){
        outReport += s_CrashSymbolicateExceptionKey;
        outReport += Core::Crash::PosixSignalName(summary.reasonCode);
        outReport += " (";
        AppendCrashDecimal(summary.reasonCode, outReport);
        outReport += ")\n";
        return;
    }
    if(summary.reasonKind == Core::Crash::s_WindowsExceptionReasonKind){
        outReport += s_CrashSymbolicateExceptionKey;
        outReport += Core::Crash::WindowsExceptionName(summary.reasonCode);
        outReport += " ";
        AppendCrashHexAddress(summary.reasonCode, outReport);
        outReport += s_ReportLineEnd;
        return;
    }
    if(summary.reasonKind == Core::Crash::s_TerminateReasonKind){
        outReport += "exception=std::terminate\n";
        return;
    }
    if(summary.reasonKind == Core::Crash::s_ManualDumpReasonKind){
        outReport += "exception=manual diagnostic dump\n";
        return;
    }
    if(summary.reasonKind == Core::Crash::s_GpuCrashReasonKind){
        outReport += "exception=GPU device removed / crash\n";
        return;
    }

    outReport += s_CrashSymbolicateExceptionKey;
    outReport += summary.reasonKind;
    outReport += s_ReportLineEnd;
}

static void AppendEventSummary(const CrashPackageSummary& summary, CrashReportText& outReport){
    outReport += "\n[event]\n";
    outReport += "event=";
    outReport += summary.event;
    outReport += s_ReportLineEnd;

    if(!HasCrashHeadlineFields(summary.triggerExpression, summary.triggerMessage, summary.triggerFile, summary.triggerLine))
        AppendExceptionSummary(summary, outReport);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static void AppendAndroidTombstoneSummary(const CrashScratchPath& packageDirectory, Core::Alloc::ScratchArena& arena, CrashReportText& outReport){
    AString<Core::Alloc::ScratchArena> tombstone{arena};
    const b8 tombstonePresent = ReadTextFile(packageDirectory / CrashNames::s_AndroidTombstoneFileName, tombstone) && !tombstone.empty();
    AppendParsedAndroidTombstoneReport(tombstonePresent, AStringView(tombstone.data(), tombstone.size()), outReport);
}

// Expected decode failures retain the ingest report; unexpected exceptions remain terminal.
static void AppendRadeonGpuDetectiveSummary(const CrashScratchPath& packageDirectory, Core::Alloc::ScratchArena& arena, CrashReportText& outReport){
    const CrashScratchPath rgdCapture = packageDirectory / CrashNames::s_GpuDetectiveCaptureFileName;
    const auto regularCapture = IsRegularFile(rgdCapture);
    if(!regularCapture){
        NWB_LOGGER_WARNING(FOUNDATION_TEXT("Log server: failed to inspect Radeon GPU Detective capture '{}': {}"), PathToString<tchar>(rgdCapture), ConvertString(regularCapture.error().message()));
        outReport += s_CrashSymbolicateRgdGpuDetectiveSectionHeader;
        outReport += s_RgdInspectFailedStatusLine;
        return;
    }
    if(!*regularCapture)
        return;

    const AString<Core::Alloc::ScratchArena> capturePath = PathToString<char>(arena, rgdCapture);
    const auto decoded = Rgd::DecodeCrashDumpToText(capturePath);
    if(!decoded){
        AppendDecodedRgdReport(false, decoded.error(), outReport);
        return;
    }

    AppendDecodedRgdReport(true, AStringView(decoded->data(), decoded->size()), outReport);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Expected SDK failures retain the ingest report; unexpected exceptions remain terminal.
#if defined(NWB_WITH_AFTERMATH)
struct AftermathLoadFailure{
    AStringView operation;
    SharedLibraryFailure native;
};

struct AftermathDecoder{
    SharedLibrary library;
    PFN_GFSDK_Aftermath_GpuCrashDump_CreateDecoder createDecoder = nullptr;
    PFN_GFSDK_Aftermath_GpuCrashDump_GenerateJSON generateJson = nullptr;
    PFN_GFSDK_Aftermath_GpuCrashDump_GetJSON getJson = nullptr;
    PFN_GFSDK_Aftermath_GpuCrashDump_DestroyDecoder destroyDecoder = nullptr;


public:
    [[nodiscard]] Expected<void, AftermathLoadFailure> load(Core::Alloc::ScratchArena& scratchArena){
        const auto opened = library.open(scratchArena, Core::Crash::s_AftermathRuntimeName);
        if(!opened)
            return MakeUnexpected(AftermathLoadFailure{ .operation = s_CrashSymbolicateAftermathAftermathLoadRuntimeOperation, .native = opened.error(), });

        const auto create = library.resolve<PFN_GFSDK_Aftermath_GpuCrashDump_CreateDecoder>(scratchArena, "GFSDK_Aftermath_GpuCrashDump_CreateDecoder");
        const auto generate = library.resolve<PFN_GFSDK_Aftermath_GpuCrashDump_GenerateJSON>(scratchArena, "GFSDK_Aftermath_GpuCrashDump_GenerateJSON");
        const auto get = library.resolve<PFN_GFSDK_Aftermath_GpuCrashDump_GetJSON>(scratchArena, "GFSDK_Aftermath_GpuCrashDump_GetJSON");
        const auto destroy = library.resolve<PFN_GFSDK_Aftermath_GpuCrashDump_DestroyDecoder>(scratchArena, "GFSDK_Aftermath_GpuCrashDump_DestroyDecoder");
        if(!create || !generate || !get || !destroy){
            const SharedLibraryFailure& failure = !create ? create.error() : !generate ? generate.error() : !get ? get.error() : destroy.error();
            return MakeUnexpected(AftermathLoadFailure{ .operation = "resolve_symbols", .native = failure, });
        }
        createDecoder = *create;
        generateJson = *generate;
        getJson = *get;
        destroyDecoder = *destroy;
        return {};
    }
};
#endif

static void AppendAftermathGpuDumpSummary(const CrashScratchPath& packageDirectory, [[maybe_unused]] Core::Alloc::ScratchArena& scratchArena, CrashReportText& outReport){
    const CrashScratchPath dumpPath = packageDirectory / CrashNames::s_AftermathGpuDumpFileName;
    const auto regularDump = IsRegularFile(dumpPath);
    if(!regularDump){
        outReport += s_AftermathInspectFailedReport;
        AppendNativeFailure(CrashSymbolicationFailure{ .operation = "inspect_aftermath_dump", .code = regularDump.error(), }, outReport);
        return;
    }
    if(!*regularDump)
        return;

#if !defined(NWB_WITH_AFTERMATH)
    outReport += s_CrashSymbolicateAftermathAftermathSectionHeader;
    outReport += s_CrashSymbolicateAftermathAftermathSkippedReport;
#else
    Vector<u8, Core::Alloc::ScratchArena> dumpBytes(scratchArena);
    const auto read = ReadBinaryFile(dumpPath, dumpBytes);
    if(!read || dumpBytes.empty()){
        outReport += s_AftermathReadFailedReport;
        if(!read)
            AppendNativeFailure(CrashSymbolicationFailure{ .operation = "read_aftermath_dump", .code = read.error(), }, outReport);
        return;
    }

    AftermathDecoder decoderLib;
    const auto loaded = decoderLib.load(scratchArena);
    if(!loaded){
        const AftermathLoadFailure& failure = loaded.error();
        outReport += SelectAftermathLoadFailureHeader(failure.operation);
        outReport += s_AftermathAdmissionFailedDetail;
        AppendNativeFailure(CrashSymbolicationFailure{ .operation = failure.operation, .code = failure.native.code, }, outReport);
        outReport += "native_detail=";
        outReport += failure.native.detail.view();
        outReport += SelectAftermathDetailTruncatedSuffix(failure.native.detailTruncated);
        return;
    }

    if(dumpBytes.size() > static_cast<usize>(Limit<u32>::s_Max)){
        outReport += s_CrashSymbolicateAftermathAftermathSectionHeader;
        outReport += s_CrashSymbolicateAftermathAftermathCreateDecoderFailedReport;
        return;
    }

    Vector<char, Core::Alloc::ScratchArena> json(scratchArena);
    u32 jsonSize = 0u;
    {
        GFSDK_Aftermath_GpuCrashDump_Decoder decoder = nullptr;
        const GFSDK_Aftermath_Result createResult = decoderLib.createDecoder(GFSDK_Aftermath_Version_API, dumpBytes.data(), static_cast<u32>(dumpBytes.size()), &decoder);
        if(!GFSDK_Aftermath_SUCCEED(createResult) || !decoder){
            outReport += s_CrashSymbolicateAftermathAftermathSectionHeader;
            outReport += s_CrashSymbolicateAftermathAftermathCreateDecoderFailedReport;
            outReport += MakeDiagnosticEventText("native_category=GFSDK_Aftermath\nnative_code={}\ndecoder_present={}\n", createResult, decoder != nullptr).view();
            return;
        }

        ScopeExit cleanupDecoder([&]()noexcept{
            const GFSDK_Aftermath_Result destroyed = decoderLib.destroyDecoder(decoder);
            if(!GFSDK_Aftermath_SUCCEED(destroyed)){
                const DiagnosticEventText detail = MakeDiagnosticEventText("Failed to destroy Aftermath crash dump decoder: native_category=GFSDK_Aftermath native_code={}", destroyed);
                CaptureDiagnosticEvent("logger_server_aftermath", detail.view(), __FILE__, __LINE__);
            }
            decoder = nullptr;
        });

        const GFSDK_Aftermath_Result generateResult = decoderLib.generateJson(
            decoder,
            static_cast<u32>(GFSDK_Aftermath_GpuCrashDumpDecoderFlags_ALL_INFO),
            static_cast<u32>(GFSDK_Aftermath_GpuCrashDumpFormatterFlags_UTF8_OUTPUT),
            nullptr,
            nullptr,
            nullptr,
            nullptr,
            &jsonSize
        );
        if(!GFSDK_Aftermath_SUCCEED(generateResult) || jsonSize == 0u){
            outReport += s_CrashSymbolicateAftermathAftermathSectionHeader;
            outReport += s_CrashSymbolicateAftermathAftermathGenerateJsonFailedReport;
            outReport += MakeDiagnosticEventText("native_category=GFSDK_Aftermath\nnative_code={}\njson_bytes={}\n", generateResult, jsonSize).view();
            return;
        }

        json.resize(jsonSize, '\0');
        const GFSDK_Aftermath_Result getResult = decoderLib.getJson(decoder, jsonSize, json.data());
        if(!GFSDK_Aftermath_SUCCEED(getResult)){
            outReport += s_CrashSymbolicateAftermathAftermathSectionHeader;
            outReport += s_CrashSymbolicateAftermathAftermathGetJsonFailedReport;
            outReport += MakeDiagnosticEventText("native_category=GFSDK_Aftermath\nnative_code={}\n", getResult).view();
            return;
        }
    }

    // jsonSize includes the terminator; omit it and cap shader/warp text to the report budget.
    AppendBoundedAftermathJson(AStringView(json.data(), json.size()), jsonSize, outReport);
#endif
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if defined(FOUNDATION_PLATFORM_LINUX) && !defined(FOUNDATION_PLATFORM_ANDROID)
namespace __hidden_linux_frame_symbol_resolver{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct LinuxSymbolFileCacheEntry{
    AString<Core::Alloc::ScratchArena> modulePath;
    AString<Core::Alloc::ScratchArena> symbolPath;
    b8 found = false;


public:
    explicit LinuxSymbolFileCacheEntry(Core::Alloc::ScratchArena& arena)noexcept(noexcept(decltype(modulePath)(arena)) && noexcept(decltype(symbolPath)(arena)))
        : modulePath(arena)
        , symbolPath(arena)
    {}
};

struct LinuxSymbolFileCache{
    Vector<LinuxSymbolFileCacheEntry, Core::Alloc::ScratchArena> entries;


public:
    explicit LinuxSymbolFileCache(Core::Alloc::ScratchArena& arena)noexcept(noexcept(decltype(entries)(arena)))
        : entries(arena)
    {}
};

[[nodiscard]] static Expected<AString<::ArenaBase>> RunLinuxSymbolizerCommand(const Span<const AStringView> arguments, Core::Alloc::ScratchArena& arena){
    AString<Core::Alloc::ScratchArena> output{arena};
    output.reserve(ProcessExecutionDetail::s_DefaultCaptureOutputMaxBytes);
    const auto captured = CaptureProcessOutput(output, arena, arguments);
    if(!captured){
        const ProcessCaptureFailure& failure = captured.error();
        NWB_LOGGER_INFO(FOUNDATION_TEXT("Linux symbolizer capture failed: phase {}, native {}, completion {}, exit {}, signal {}, truncated {}")
            , static_cast<u32>(failure.kind)
            , static_cast<i32>(failure.nativeError)
            , static_cast<i32>(failure.completionError)
            , failure.exitCode
            , failure.terminationSignal
            , failure.outputTruncated
        );
        return MakeUnexpected(Failure{});
    }

    return ExtractLinuxSymbolizerResult(arena, AStringView(output.data(), output.size()));
}

[[nodiscard]] static Expected<AString<::ArenaBase>> TryRunLinuxSymbolizer(const AStringView toolName, const AStringView modulePathText, const u64 moduleOffset, Core::Alloc::ScratchArena& arena){
    AString<Core::Alloc::ScratchArena> addressArgument{arena};
    addressArgument.reserve(s_HexAddressPrefix.size() + ::s_HexU64DigitCount);
    addressArgument += s_HexAddressPrefix;
    AppendHexU64(moduleOffset, addressArgument);

    if(toolName == s_CrashSymbolicateLinuxLlvmSymbolizerTool){
        AString<Core::Alloc::ScratchArena> objectArgument{arena};
        objectArgument.reserve(AddSize(s_CrashSymbolicateLinuxLlvmSymbolizerObjectPrefix.size(), modulePathText.size()));
        objectArgument += s_CrashSymbolicateLinuxLlvmSymbolizerObjectPrefix;
        objectArgument.append(modulePathText.data(), modulePathText.size());

        const Array<AStringView, 6> arguments = {{
            s_CrashSymbolicateLinuxLlvmSymbolizerTool,
            s_CrashSymbolicateLinuxLlvmSymbolizerDemangleFlag,
            s_CrashSymbolicateLinuxLlvmSymbolizerFunctionsFlag,
            s_CrashSymbolicateLinuxLlvmSymbolizerInliningFlag,
            AStringView(objectArgument),
            AStringView(addressArgument),
        }};

        return RunLinuxSymbolizerCommand(arguments, arena);
    }

    AString<Core::Alloc::ScratchArena> modulePathArgument{arena};
    modulePathArgument.reserve(modulePathText.size());
    modulePathArgument.append(modulePathText.data(), modulePathText.size());

    const Array<AStringView, 7> arguments = {{
        s_CrashSymbolicateLinuxAddr2LineTool,
        s_CrashSymbolicateLinuxAddr2LineFunctionsFlag,
        s_CrashSymbolicateLinuxAddr2LineDemangleFlag,
        s_CrashSymbolicateLinuxAddr2LineInlineFlag,
        s_CrashSymbolicateLinuxAddr2LineExeFlag,
        AStringView(modulePathArgument),
        AStringView(addressArgument),
    }};

    return RunLinuxSymbolizerCommand(arguments, arena);
}

[[nodiscard]] static Expected<CrashScratchPath> FindLinuxSymbolFile(const AStringView modulePathText, const CrashSymbolicationConfig& config, Core::Alloc::ScratchArena& arena){
    if(IsRejectedLinuxModulePath(modulePathText))
        return MakeUnexpected(Failure{});

    CrashScratchPath modulePath(arena, modulePathText);
    const auto regularModule = IsRegularFile(modulePath);
    if(!regularModule){
        NWB_LOGGER_WARNING(FOUNDATION_TEXT("Log server: failed to inspect Linux symbol module '{}': {}"), PathToString<tchar>(modulePath), ConvertString(regularModule.error().message()));
        return MakeUnexpected(Failure{});
    }
    if(*regularModule)
        return modulePath;

    const CrashScratchPath symbolStoreDirectory = EffectiveSymbolStoreDirectory(config, arena);
    if(symbolStoreDirectory.empty())
        return MakeUnexpected(Failure{});

    const auto moduleFileName = modulePath.filenameView();
    if(moduleFileName.empty())
        return MakeUnexpected(Failure{});

    CrashScratchPath symbolStoreCandidate = symbolStoreDirectory / moduleFileName;
    const auto regularCandidate = IsRegularFile(symbolStoreCandidate);
    if(!regularCandidate){
        NWB_LOGGER_WARNING(FOUNDATION_TEXT("Log server: failed to inspect Linux symbol-store candidate '{}': {}"), PathToString<tchar>(symbolStoreCandidate), ConvertString(regularCandidate.error().message()));
        return MakeUnexpected(Failure{});
    }
    if(*regularCandidate)
        return symbolStoreCandidate;

    return MakeUnexpected(Failure{});
}

[[nodiscard]] static Expected<AStringView> FindLinuxSymbolFileText(const AStringView modulePathText, const CrashSymbolicationConfig& config, Core::Alloc::ScratchArena& arena, LinuxSymbolFileCache& cache){
    for(const LinuxSymbolFileCacheEntry& entry : cache.entries){
        if(AStringView(entry.modulePath.data(), entry.modulePath.size()) != modulePathText)
            continue;

        if(!entry.found)
            return MakeUnexpected(Failure{});

        return AStringView(entry.symbolPath.data(), entry.symbolPath.size());
    }

    LinuxSymbolFileCacheEntry& entry = cache.entries.emplace_back(cache.entries.get_allocator().arena());
    entry.modulePath.assign(modulePathText.data(), modulePathText.size());

    const auto symbolPath = FindLinuxSymbolFile(modulePathText, config, arena);
    entry.found = symbolPath.has_value();
    if(!entry.found)
        return MakeUnexpected(Failure{});

    const auto symbolPathText = PathToString<char>(cache.entries.get_allocator().arena(), *symbolPath);
    entry.symbolPath.assign(symbolPathText.data(), symbolPathText.size());
    return AStringView(entry.symbolPath.data(), entry.symbolPath.size());
}

class LinuxFrameSymbolResolver final : NoCopy{
public:
    LinuxFrameSymbolResolver(const CrashSymbolicationConfig& config, Core::Alloc::ScratchArena& arena, const usize frameCount)
        : m_config(config)
        , m_arena(arena)
        , m_cache(arena)
    {
        m_cache.entries.reserve(frameCount);
    }

    [[nodiscard]] Expected<AString<::ArenaBase>> resolve(const AStringView modulePathText, const u64 moduleOffset){
        const auto symbolPathText = FindLinuxSymbolFileText(modulePathText, m_config, m_arena, m_cache);
        if(!symbolPathText)
            return MakeUnexpected(Failure{});

        auto llvmSymbol = TryRunLinuxSymbolizer(s_CrashSymbolicateLinuxLlvmSymbolizerTool, *symbolPathText, moduleOffset, m_arena);
        if(llvmSymbol)
            return Move(*llvmSymbol);
        return TryRunLinuxSymbolizer(s_CrashSymbolicateLinuxAddr2LineTool, *symbolPathText, moduleOffset, m_arena);
    }


private:
    const CrashSymbolicationConfig& m_config;
    Core::Alloc::ScratchArena& m_arena;
    LinuxSymbolFileCache m_cache;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct LinuxProcessMemoryMapTable{
    Vector<LinuxProcessMemoryMapEntry, Core::Alloc::ScratchArena> entries;


public:
    explicit LinuxProcessMemoryMapTable(Core::Alloc::ScratchArena& arena)noexcept(noexcept(decltype(entries)(arena)))
        : entries(arena)
    {}
};

static void AppendLinuxClientCallstack(const AStringView callstackText, const LinuxProcessMemoryMapTable* const procMaps, [[maybe_unused]] const CrashSymbolicationConfig& config, [[maybe_unused]] Core::Alloc::ScratchArena& arena, CrashReportText& outReport){
    outReport += s_CallstackSectionHeader;

#if defined(FOUNDATION_PLATFORM_LINUX) && !defined(FOUNDATION_PLATFORM_ANDROID)
    __hidden_linux_frame_symbol_resolver::LinuxFrameSymbolResolver symbolResolver(config, arena, CountTextNewlinesPlusOne(callstackText));
#endif

    usize cursor = 0u;
    while(const auto line = NextTextLine(callstackText, cursor)){
        const AStringView trimmed = TrimLeftView(*line);
        if(trimmed.empty())
            continue;

        outReport.append(trimmed.data(), trimmed.size());

        const auto address = ParseCallstackFrameAddress(trimmed);
        if(procMaps && address){
            const auto mapEntry = ::FindLinuxProcessMemoryMapForAddress(procMaps->entries, *address);
            if(mapEntry){
                const u64 moduleOffset = *address - mapEntry->begin;
                const AStringView modulePath = SelectLinuxModuleDisplayPath(mapEntry->path);
                outReport += " ";
                outReport.append(modulePath.data(), modulePath.size());
                outReport += "+";
#if defined(FOUNDATION_PLATFORM_LINUX) && !defined(FOUNDATION_PLATFORM_ANDROID)
                const auto symbolOffset = AddNoOverflow(moduleOffset, mapEntry->fileOffset);
                AppendCrashHexAddress(moduleOffset, outReport);
                if(symbolOffset){
                    const auto symbol = symbolResolver.resolve(modulePath, *symbolOffset);
                    if(symbol){
                        outReport += " ";
                        outReport += *symbol;
                    }
                }
#else
                AppendCrashHexAddress(moduleOffset, outReport);
#endif
            }
        }

        outReport += s_ReportLineEnd;
    }
}

static void AppendLinuxArtifactSummary(const CrashScratchPath& packageDirectory, const CrashSymbolicationConfig& config, Core::Alloc::ScratchArena& scratchArena, CrashReportText& outReport){
    AString<Core::Alloc::ScratchArena> clientCallstack(scratchArena);
    const auto clientCallstackRead = ReadTextFile(packageDirectory / CrashNames::s_CallstackFileName, clientCallstack);
    const b8 clientCallstackPresent = clientCallstackRead && !clientCallstack.empty();

    outReport += SelectLinuxResolverStatusHeader(clientCallstackPresent);
    if(!clientCallstackRead && clientCallstackRead.error() != ErrorCondition::no_such_file_or_directory)
        AppendNativeFailure(CrashSymbolicationFailure{ .operation = "read_linux_client_callstack", .code = clientCallstackRead.error(), }, outReport);

    const auto corePath = packageDirectory / CrashNames::s_LinuxCoreFileName;
    const auto corePresent = IsRegularFile(corePath);
    if(!corePresent){
        NWB_LOGGER_WARNING(FOUNDATION_TEXT("Log server: failed to inspect Linux core artifact '{}': {}"), PathToString<tchar>(corePath), ConvertString(corePresent.error().message()));
        outReport += s_LinuxCoreInspectFailedLine;
    }
    else
        outReport += SelectLinuxCoreArtifactStatusLine(*corePresent);

    AString<Core::Alloc::ScratchArena> cpuContext(scratchArena);
    AString<Core::Alloc::ScratchArena> procMaps(scratchArena);
    const auto cpuContextRead = ReadTextFile(packageDirectory / CrashNames::s_CpuContextFileName, cpuContext);
    const auto procMapsRead = ReadTextFile(packageDirectory / CrashNames::s_ProcMapsFileName, procMaps);
    const b8 cpuContextPresent = cpuContextRead && !cpuContext.empty();
    const b8 procMapsPresent = procMapsRead && !procMaps.empty();
    outReport += SelectLinuxProcMapsStatusLine(procMapsPresent);
    if(!cpuContextRead && cpuContextRead.error() != ErrorCondition::no_such_file_or_directory)
        AppendNativeFailure(CrashSymbolicationFailure{ .operation = "read_linux_cpu_context", .code = cpuContextRead.error(), }, outReport);
    if(!procMapsRead && procMapsRead.error() != ErrorCondition::no_such_file_or_directory)
        AppendNativeFailure(CrashSymbolicationFailure{ .operation = "read_linux_proc_maps", .code = procMapsRead.error(), }, outReport);

    LinuxProcessMemoryMapTable procMapTable(scratchArena);
    if(procMapsPresent){
        const AStringView procMapsView(procMaps.data(), procMaps.size());
        procMapTable.entries.reserve(CountTextNewlinesPlusOne(procMapsView));
        ::ParseLinuxProcessMemoryMaps(procMapsView, procMapTable.entries);
    }
    const LinuxProcessMemoryMapTable* const procMapTablePtr = procMapsPresent ? &procMapTable : nullptr;

    const auto instructionPointer = FindLineKeyValueU64(AStringView(cpuContext.data(), cpuContext.size()), "instruction_pointer");
    if(!cpuContextPresent || !instructionPointer || *instructionPointer == 0u){
        outReport += "detail=ELF/DWARF stack resolver requires a Linux core artifact; instruction pointer mapping unavailable\n";
        if(clientCallstackPresent)
            AppendLinuxClientCallstack(AStringView(clientCallstack.data(), clientCallstack.size()), procMapTablePtr, config, scratchArena, outReport);
        return;
    }

    outReport += "instruction_pointer=";
    AppendCrashHexAddress(*instructionPointer, outReport);
    outReport += s_ReportLineEnd;

    if(!procMapsPresent){
        outReport += "detail=proc maps missing for module lookup; symbolic frame resolution unavailable\n";
        if(clientCallstackPresent)
            AppendLinuxClientCallstack(AStringView(clientCallstack.data(), clientCallstack.size()), nullptr, config, scratchArena, outReport);
        return;
    }

    const auto instructionMapEntry = ::FindLinuxProcessMemoryMapForAddress(procMapTable.entries, *instructionPointer);
    if(!instructionMapEntry){
        outReport += "detail=instruction pointer was not found in proc maps\n";
        if(clientCallstackPresent)
            AppendLinuxClientCallstack(AStringView(clientCallstack.data(), clientCallstack.size()), procMapTablePtr, config, scratchArena, outReport);
        return;
    }

    const AStringView modulePath = SelectLinuxModuleDisplayPath(instructionMapEntry->path);
    outReport += "instruction_pointer_module=";
    outReport.append(modulePath.data(), modulePath.size());
    outReport += "\nmodule_relative_ip=";
    AppendCrashHexAddress(*instructionPointer - instructionMapEntry->begin, outReport);
#if defined(FOUNDATION_PLATFORM_LINUX) && !defined(FOUNDATION_PLATFORM_ANDROID)
    outReport += "\nsymbolication_relative_ip=";
    const auto symbolOffset = AddNoOverflow(*instructionPointer - instructionMapEntry->begin, instructionMapEntry->fileOffset);
    if(symbolOffset)
        AppendCrashHexAddress(*symbolOffset, outReport);
    else
        outReport += "unavailable";
#endif
    outReport += SelectLinuxResolvedIpDetailLine(clientCallstackPresent);
    if(clientCallstackPresent)
        AppendLinuxClientCallstack(AStringView(clientCallstack.data(), clientCallstack.size()), procMapTablePtr, config, scratchArena, outReport);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if defined(FOUNDATION_PLATFORM_WINDOWS)
template<typename T>
struct MinidumpRecords{
    NotNull<const u8*> bytes;
    usize count = 0u;


public:
    [[nodiscard]] T record(const usize index)const noexcept{
        static_assert(IsTriviallyCopyable_V<T> && IsNothrowConstructible_V<T> && IsNothrowMoveConstructible_V<T>);
        FOUNDATION_ASSERT(index < count);
        T value;
        FOUNDATION_MEMCPY(&value, sizeof(value), bytes.get() + index * sizeof(T), sizeof(value));
        return value;
    }
};

struct DumpImage{
    const u8* bytes = nullptr;
    usize byteCount = 0u;


public:
    [[nodiscard]] const u8* rva(const u64 offset, const u64 size)const noexcept{
        if(!bytes || !IsValidMinidumpByteRange(static_cast<u64>(byteCount), offset, size))
            return nullptr;
        return bytes + static_cast<usize>(offset);
    }

    template<typename T>
    [[nodiscard]] Expected<T> read(const u64 offset)const noexcept{
        static_assert(IsTriviallyCopyable_V<T> && IsNothrowConstructible_V<T> && IsNothrowMoveConstructible_V<T>);
        const u8* const source = rva(offset, sizeof(T));
        if(!source)
            return MakeUnexpected(Failure{});
        T value;
        FOUNDATION_MEMCPY(&value, sizeof(value), source, sizeof(value));
        return value;
    }

    [[nodiscard]] Expected<WString<Core::Alloc::ScratchArena>> readString(const RVA rvaValue, Core::Alloc::ScratchArena& scratchArena)const{
        const auto textByteCount = read<ULONG32>(rvaValue);
        if(!textByteCount || !IsValidMinidumpWideStringByteCount(*textByteCount, sizeof(wchar)))
            return MakeUnexpected(Failure{});
        const u64 textOffset = static_cast<u64>(rvaValue) + offsetof(MINIDUMP_STRING, Buffer);
        if(!IsValidMinidumpByteRange(static_cast<u64>(byteCount), textOffset, static_cast<u64>(*textByteCount) + sizeof(wchar)))
            return MakeUnexpected(Failure{});
        const u8* const textBytes = rva(textOffset, static_cast<u64>(*textByteCount) + sizeof(wchar));
        if(!textBytes)
            return MakeUnexpected(Failure{});
        const auto terminator = read<wchar>(textOffset + *textByteCount);
        if(!terminator || *terminator != 0)
            return MakeUnexpected(Failure{});
        WString<Core::Alloc::ScratchArena> text(scratchArena);
        text.resize(static_cast<usize>(*textByteCount / sizeof(wchar)));
        if(*textByteCount != 0u)
            FOUNDATION_MEMCPY(text.data(), *textByteCount, textBytes, *textByteCount);
        return text;
    }

    [[nodiscard]] Expected<Optional<DumpImage>> stream(const MINIDUMP_STREAM_TYPE streamType)const noexcept{
        const auto header = read<MINIDUMP_HEADER>(0u);
        if(!header || header->Signature != MINIDUMP_SIGNATURE || (header->Version & Limit<u16>::s_Max) != MINIDUMP_VERSION)
            return MakeUnexpected(Failure{});
        const u64 directoryBytes = static_cast<u64>(header->NumberOfStreams) * sizeof(MINIDUMP_DIRECTORY);
        if(!rva(header->StreamDirectoryRva, directoryBytes))
            return MakeUnexpected(Failure{});

        Optional<DumpImage> selected;
        for(u32 index = 0u; index < header->NumberOfStreams; ++index){
            const u64 directoryOffset = static_cast<u64>(header->StreamDirectoryRva) + static_cast<u64>(index) * sizeof(MINIDUMP_DIRECTORY);
            const auto directory = read<MINIDUMP_DIRECTORY>(directoryOffset);
            if(!directory)
                return MakeUnexpected(Failure{});
            const u8* const streamBytes = rva(directory->Location.Rva, directory->Location.DataSize);
            if(!streamBytes)
                return MakeUnexpected(Failure{});
            if(directory->StreamType == static_cast<ULONG32>(streamType) && !selected)
                selected = DumpImage{ streamBytes, static_cast<usize>(directory->Location.DataSize) };
        }
        return selected;
    }

    template<typename T>
    [[nodiscard]] Expected<MinidumpRecords<T>> records(const usize recordsOffset, const u64 count)const noexcept{
        if(!bytes || !IsValidMinidumpRecordCount(byteCount, recordsOffset, sizeof(T), count))
            return MakeUnexpected(Failure{});
        return MinidumpRecords<T>{ MakeNotNull(bytes + recordsOffset), static_cast<usize>(count) };
    }
};

using CrashBytes = Vector<u8, Core::Alloc::ScratchArena>;

struct DumpMemoryRange{
    u64 begin = 0u;
    u64 size = 0u;
    NotNull<const u8*> bytes;
};

struct DumpMemoryReader{
    Vector<DumpMemoryRange, Core::Alloc::ScratchArena> ranges;


public:
    explicit DumpMemoryReader(Core::Alloc::ScratchArena& scratchArena)noexcept
        : ranges(scratchArena)
    {}
};

static DumpMemoryReader* s_CurrentDumpMemoryReader = nullptr;

[[nodiscard]] static Expected<void> AddMemoryRange(const u64 begin, const u64 size, const u8* const bytes, DumpMemoryReader& reader){
    if(size == 0u)
        return {};
    if(!bytes || !IsRepresentableDumpMemoryRange(begin, size))
        return MakeUnexpected(Failure{});
    reader.ranges.push_back(DumpMemoryRange{ begin, size, MakeNotNull(bytes) });
    return {};
}

[[nodiscard]] static Expected<void> AddLocationMemoryRange(const DumpImage& dumpImage, const u64 begin, const MINIDUMP_LOCATION_DESCRIPTOR& location, DumpMemoryReader& reader){
    return AddMemoryRange(begin, location.DataSize, dumpImage.rva(location.Rva, location.DataSize), reader);
}

[[nodiscard]] static Expected<usize> CountDumpMemoryRanges(const DumpImage& dumpImage)noexcept{
    usize total = 0u;
    for(const auto streamType : Array<MINIDUMP_STREAM_TYPE, 3u>{ ThreadListStream, MemoryListStream, Memory64ListStream }){
        const auto selected = dumpImage.stream(streamType);
        if(!selected)
            return MakeUnexpected(Failure{});
        if(!*selected)
            continue;
        const DumpImage& stream = **selected;
        u64 count = 0u;
        if(streamType == Memory64ListStream){
            const auto records = stream.read<ULONG64>(0u);
            if(!records || !stream.records<MINIDUMP_MEMORY_DESCRIPTOR64>(offsetof(MINIDUMP_MEMORY64_LIST, MemoryRanges), *records))
                return MakeUnexpected(Failure{});
            count = *records;
        }
        else{
            const auto records = stream.read<ULONG32>(0u);
            if(!records)
                return MakeUnexpected(Failure{});
            if(streamType == ThreadListStream){
                if(!stream.records<MINIDUMP_THREAD>(offsetof(MINIDUMP_THREAD_LIST, Threads), *records))
                    return MakeUnexpected(Failure{});
            }
            else if(!stream.records<MINIDUMP_MEMORY_DESCRIPTOR>(offsetof(MINIDUMP_MEMORY_LIST, MemoryRanges), *records))
                return MakeUnexpected(Failure{});
            count = *records;
        }
        if(count > static_cast<u64>(Limit<usize>::s_Max - total))
            return MakeUnexpected(Failure{});
        total += static_cast<usize>(count);
    }
    return total;
}

[[nodiscard]] static Expected<DumpMemoryReader> BuildDumpMemoryReader(const DumpImage& dumpImage, Core::Alloc::ScratchArena& scratchArena){
    const auto rangeCapacity = CountDumpMemoryRanges(dumpImage);
    if(!rangeCapacity)
        return MakeUnexpected(Failure{});
    DumpMemoryReader reader(scratchArena);
    reader.ranges.reserve(*rangeCapacity);
    const auto threadStream = dumpImage.stream(ThreadListStream);
    if(!threadStream)
        return MakeUnexpected(Failure{});
    if(*threadStream){
        const DumpImage& stream = **threadStream;
        const auto count = stream.read<ULONG32>(0u);
        if(!count)
            return MakeUnexpected(Failure{});
        const auto threads = stream.records<MINIDUMP_THREAD>(offsetof(MINIDUMP_THREAD_LIST, Threads), *count);
        if(!threads)
            return MakeUnexpected(Failure{});
        for(usize index = 0u; index < threads->count; ++index){
            const MINIDUMP_THREAD thread = threads->record(index);
            if(!AddLocationMemoryRange(dumpImage, thread.Stack.StartOfMemoryRange, thread.Stack.Memory, reader))
                return MakeUnexpected(Failure{});
        }
    }

    const auto memoryStream = dumpImage.stream(MemoryListStream);
    if(!memoryStream)
        return MakeUnexpected(Failure{});
    if(*memoryStream){
        const DumpImage& stream = **memoryStream;
        const auto count = stream.read<ULONG32>(0u);
        if(!count)
            return MakeUnexpected(Failure{});
        const auto ranges = stream.records<MINIDUMP_MEMORY_DESCRIPTOR>(offsetof(MINIDUMP_MEMORY_LIST, MemoryRanges), *count);
        if(!ranges)
            return MakeUnexpected(Failure{});
        for(usize index = 0u; index < ranges->count; ++index){
            const MINIDUMP_MEMORY_DESCRIPTOR descriptor = ranges->record(index);
            if(!AddLocationMemoryRange(dumpImage, descriptor.StartOfMemoryRange, descriptor.Memory, reader))
                return MakeUnexpected(Failure{});
        }
    }

    const auto memory64Stream = dumpImage.stream(Memory64ListStream);
    if(!memory64Stream)
        return MakeUnexpected(Failure{});
    if(*memory64Stream){
        const DumpImage& stream = **memory64Stream;
        const auto count = stream.read<ULONG64>(0u);
        const auto baseRva = stream.read<RVA64>(offsetof(MINIDUMP_MEMORY64_LIST, BaseRva));
        if(!count || !baseRva)
            return MakeUnexpected(Failure{});
        const auto ranges = stream.records<MINIDUMP_MEMORY_DESCRIPTOR64>(offsetof(MINIDUMP_MEMORY64_LIST, MemoryRanges), *count);
        if(!ranges || !dumpImage.rva(*baseRva, 0u))
            return MakeUnexpected(Failure{});
        u64 cursor = *baseRva;
        for(usize index = 0u; index < ranges->count; ++index){
            const MINIDUMP_MEMORY_DESCRIPTOR64 descriptor = ranges->record(index);
            const u8* const bytes = dumpImage.rva(cursor, descriptor.DataSize);
            if(!bytes || !AddMemoryRange(descriptor.StartOfMemoryRange, descriptor.DataSize, bytes, reader))
                return MakeUnexpected(Failure{});
            cursor += descriptor.DataSize;
        }
    }
    return reader;
}

static BOOL CALLBACK ReadProcessMemoryFromDump([[maybe_unused]] HANDLE process, DWORD64 baseAddress, PVOID buffer, DWORD size, LPDWORD bytesRead)noexcept{
    if(bytesRead)
        *bytesRead = 0u;
    if(!s_CurrentDumpMemoryReader || !buffer)
        return FALSE;

    for(const DumpMemoryRange& range : s_CurrentDumpMemoryReader->ranges){
        usize offset = 0u;
        const DumpMemoryRangeMatch::Enum match = ClassifyDumpMemoryRangeRead(range.begin, range.size, baseAddress, static_cast<u64>(size), offset);
        if(match == DumpMemoryRangeMatch::Outside)
            continue;
        if(match == DumpMemoryRangeMatch::PartialOverflow)
            return FALSE;

        FOUNDATION_MEMCPY(buffer, static_cast<usize>(size), range.bytes.get() + offset, static_cast<usize>(size));
        if(bytesRead)
            *bytesRead = size;
        return TRUE;
    }

    return FALSE;
}

struct CrashContext{
    CONTEXT context = {};
    DWORD threadId = 0u;
};

[[nodiscard]] static Expected<CrashContext> ReadCrashContext(const DumpImage& dumpImage, const DWORD threadId, const MINIDUMP_LOCATION_DESCRIPTOR& location)noexcept{
    if(location.DataSize < sizeof(CONTEXT) || !dumpImage.rva(location.Rva, location.DataSize))
        return MakeUnexpected(Failure{});
    const auto context = dumpImage.read<CONTEXT>(location.Rva);
    if(!context)
        return MakeUnexpected(Failure{});
    return CrashContext{ *context, threadId };
}

[[nodiscard]] static Expected<CrashContext> FindCrashContext(const DumpImage& dumpImage, const CrashPackageSummary& summary)noexcept{
    const auto exceptionStream = dumpImage.stream(ExceptionStream);
    if(!exceptionStream)
        return MakeUnexpected(Failure{});
    if(*exceptionStream){
        const auto exceptionInfo = (**exceptionStream).read<MINIDUMP_EXCEPTION_STREAM>(0u);
        if(!exceptionInfo)
            return MakeUnexpected(Failure{});
        return ReadCrashContext(dumpImage, exceptionInfo->ThreadId, exceptionInfo->ThreadContext);
    }

    if(summary.threadId > Limit<DWORD>::s_Max)
        return MakeUnexpected(Failure{});
    const DWORD threadId = static_cast<DWORD>(summary.threadId);
    const auto threadStream = dumpImage.stream(ThreadListStream);
    if(!threadStream || !*threadStream)
        return MakeUnexpected(Failure{});
    const DumpImage& stream = **threadStream;
    const auto count = stream.read<ULONG32>(0u);
    if(!count)
        return MakeUnexpected(Failure{});
    const auto threads = stream.records<MINIDUMP_THREAD>(offsetof(MINIDUMP_THREAD_LIST, Threads), *count);
    if(!threads)
        return MakeUnexpected(Failure{});
    for(usize index = 0u; index < threads->count; ++index){
        const MINIDUMP_THREAD thread = threads->record(index);
        if(threadId != 0u && thread.ThreadId != threadId)
            continue;
        return ReadCrashContext(dumpImage, thread.ThreadId, thread.ThreadContext);
    }
    return MakeUnexpected(Failure{});
}

[[nodiscard]] static DWORD MachineTypeFromContext([[maybe_unused]] const CONTEXT& context)noexcept{
#if defined(_M_X64) || defined(__x86_64__)
    return IMAGE_FILE_MACHINE_AMD64;
#elif defined(_M_ARM64) || defined(__aarch64__)
    return IMAGE_FILE_MACHINE_ARM64;
#else
    return 0u;
#endif
}

static void InitializeStackFrameFromContext(const CONTEXT& context, STACKFRAME64& outFrame)noexcept{
    outFrame = STACKFRAME64{};
#if defined(_M_X64) || defined(__x86_64__)
    outFrame.AddrPC.Offset = context.Rip;
    outFrame.AddrFrame.Offset = context.Rbp;
    outFrame.AddrStack.Offset = context.Rsp;
#elif defined(_M_ARM64) || defined(__aarch64__)
    outFrame.AddrPC.Offset = context.Pc;
    outFrame.AddrFrame.Offset = context.Fp;
    outFrame.AddrStack.Offset = context.Sp;
#endif
    outFrame.AddrPC.Mode = AddrModeFlat;
    outFrame.AddrFrame.Mode = AddrModeFlat;
    outFrame.AddrStack.Mode = AddrModeFlat;
}

[[nodiscard]] static WString<Core::Alloc::ScratchArena> BuildSymbolSearchPath(const CrashScratchPath& packageDirectory, const CrashSymbolicationConfig& config, Core::Alloc::ScratchArena& scratchArena){
    WString<Core::Alloc::ScratchArena> path{scratchArena};
    const CrashScratchPath symbolStoreDirectory = EffectiveSymbolStoreDirectory(config, scratchArena);
    const WStringView pkgView(packageDirectory.data(), packageDirectory.size());
    const WStringView storeView(symbolStoreDirectory.data(), symbolStoreDirectory.size());
    path.reserve(AddSize(AddSize(pkgView.size(), 1u), storeView.size()));
    path += pkgView;
    path += L";";
    path += storeView;
    return path;
}

static void LoadDumpModules(const HANDLE symbolProcess, const DumpImage& dumpImage, Core::Alloc::ScratchArena& scratchArena, CrashReportText& outReport){
    const auto moduleStream = dumpImage.stream(ModuleListStream);
    if(!moduleStream){
        outReport += s_CrashSymbolicateWin32InvalidModuleListReport;
        return;
    }
    if(!*moduleStream){
        outReport += s_Win32MissingModuleListReport;
        return;
    }
    const DumpImage& stream = **moduleStream;
    const auto count = stream.read<ULONG32>(0u);
    if(!count){
        outReport += s_CrashSymbolicateWin32InvalidModuleListReport;
        return;
    }
    const auto modules = stream.records<MINIDUMP_MODULE>(offsetof(MINIDUMP_MODULE_LIST, Modules), *count);
    if(!modules){
        outReport += s_CrashSymbolicateWin32InvalidModuleListReport;
        return;
    }

    u32 loadedCount = 0u;
    for(usize index = 0u; index < modules->count; ++index){
        const MINIDUMP_MODULE module = modules->record(index);
        const auto moduleNameText = dumpImage.readString(module.ModuleNameRva, scratchArena);
        if(!moduleNameText){
            outReport += s_CrashSymbolicateWin32InvalidModuleListReport;
            return;
        }
        const wchar* imageName = moduleNameText->empty() ? nullptr : moduleNameText->c_str();
        const DWORD64 loadedBase = SymLoadModuleExW(symbolProcess, nullptr, imageName, nullptr, module.BaseOfImage, module.SizeOfImage, nullptr, 0u);
        if(loadedBase != 0u)
            ++loadedCount;
    }

    outReport += "modules_loaded=";
    AppendCrashDecimal(loadedCount, outReport);
    outReport += s_ReportLineEnd;
}

static void AppendResolvedSymbol(const HANDLE symbolProcess, const DWORD frameIndex, const DWORD64 address, Core::Alloc::ScratchArena& scratchArena, CrashReportText& outReport){
    outReport += "#";
    AppendCrashDecimal(frameIndex, outReport);
    outReport += " ";
    AppendCrashHexAddress(address, outReport);

    alignas(SYMBOL_INFOW) Array<u8, sizeof(SYMBOL_INFOW) + (MAX_SYM_NAME * sizeof(wchar))> symbolBuffer = {};
    const auto symbol = MakeNotNull(reinterpret_cast<SYMBOL_INFOW*>(symbolBuffer.data()));
    symbol->SizeOfStruct = sizeof(SYMBOL_INFOW);
    symbol->MaxNameLen = MAX_SYM_NAME;

    DWORD64 displacement = 0u;
    if(SymFromAddrW(symbolProcess, address, &displacement, symbol.get())){
        const AString<Core::Alloc::ScratchArena> name = WideToUtf8(scratchArena, WStringView(symbol->Name, symbol->NameLen));
        outReport += " ";
        outReport += name;
        if(displacement != 0u){
            outReport += "+";
            AppendCrashHexAddress(displacement, outReport);
        }
    }
    else
        outReport += " <unknown>";

    IMAGEHLP_LINEW64 line = {};
    line.SizeOfStruct = sizeof(line);
    DWORD lineDisplacement = 0u;
    if(SymGetLineFromAddrW64(symbolProcess, address, &lineDisplacement, &line)){
        const AString<Core::Alloc::ScratchArena> file = WideToUtf8(scratchArena, WStringView(line.FileName));
        outReport += " at ";
        outReport += file;
        outReport += ":";
        AppendCrashDecimal(line.LineNumber, outReport);
    }

    outReport += s_ReportLineEnd;
}

[[nodiscard]] static Expected<b8, ErrorCode> AppendClientCallstack(const HANDLE symbolProcess, const CrashScratchPath& packageDirectory, Core::Alloc::ScratchArena& scratchArena, CrashReportText& outReport){
    AString<Core::Alloc::ScratchArena> callstackText{scratchArena};
    const auto read = ReadTextFile(packageDirectory / CrashNames::s_CallstackFileName, callstackText);
    if(!read){
        if(read.error() == ErrorCondition::no_such_file_or_directory)
            return false;
        return MakeUnexpected(read.error());
    }
    if(callstackText.empty())
        return false;

    const AStringView text(callstackText.data(), callstackText.size());
    DWORD frameIndex = 0u;
    usize cursor = 0u;
    b8 decodedAnyFrame = false;
    while(const auto line = NextTextLine(text, cursor)){
        const Expected<u64> address = ParseCallstackFrameAddress(*line);
        if(address && *address != 0u){
            AppendResolvedSymbol(symbolProcess, frameIndex, static_cast<DWORD64>(*address), scratchArena, outReport);
            ++frameIndex;
            decodedAnyFrame = true;
        }
    }
    return decodedAnyFrame;
}

[[nodiscard]] static Expected<b8, CrashSymbolicationFailure> AppendWindowsMinidumpStack(const CrashScratchPath& packageDirectory, const CrashPackageSummary& summary, const CrashSymbolicationConfig& config, Core::Alloc::ScratchArena& scratchArena, CrashReportText& outReport){
    const CrashScratchPath dumpPath = packageDirectory / CrashNames::s_ProcessDumpFileName;
    CrashBytes dumpBytes{scratchArena};
    const auto read = ReadBinaryFile(dumpPath, dumpBytes);
    if(!read || dumpBytes.empty()){
        outReport += s_Win32MissingDumpPrefix;
        outReport += CrashNames::s_ProcessDumpFileName;
        outReport += s_Win32MissingDumpSuffix;
        if(!read)
            return MakeUnexpected(CrashSymbolicationFailure{ .operation = "read_windows_minidump", .code = read.error(), });
        return false;
    }

    const DumpImage dumpImage{ dumpBytes.data(), dumpBytes.size() };
    const auto crashContext = FindCrashContext(dumpImage, summary);
    if(!crashContext){
        outReport += s_Win32MissingThreadContextReport;
        return false;
    }

    auto memoryReader = BuildDumpMemoryReader(dumpImage, scratchArena);
    if(!memoryReader){
        outReport += s_Win32InvalidMemoryRangesReport;
        return false;
    }

    const HANDLE symbolProcess = GetCurrentProcess();
    const WString<Core::Alloc::ScratchArena> symbolPath = BuildSymbolSearchPath(packageDirectory, config, scratchArena);
    SymSetOptions(SYMOPT_DEFERRED_LOADS | SYMOPT_UNDNAME | SYMOPT_LOAD_LINES);
    if(!SymInitializeW(symbolProcess, symbolPath.c_str(), FALSE)){
        const ErrorCode error = LastSystemError();
        outReport += s_Win32SymInitializeFailedReport;
        return MakeUnexpected(CrashSymbolicationFailure{ .operation = "initialize_windows_symbols", .code = error, });
    }

    ScopeExit cleanupSymbols([&]()noexcept{
        if(!SymCleanup(symbolProcess)){
            const DiagnosticEventText detail = MakeDiagnosticEventText("Windows symbol session cleanup failed: native_category=system native_code={}", GetLastError());
            CaptureDiagnosticEvent("logger_windows_symbols", detail.view(), __FILE__, __LINE__);
        }
    });
    s_CurrentDumpMemoryReader = &*memoryReader;
    ScopeExit clearMemoryReader([]()noexcept{ s_CurrentDumpMemoryReader = nullptr; });

    outReport += s_Win32DecodedResolverPrefix;
    outReport += WideToUtf8(scratchArena, WStringView(symbolPath));
    outReport += "\nthread_id=";
    AppendCrashDecimal(crashContext->threadId, outReport);
    outReport += s_ReportLineEnd;
    LoadDumpModules(symbolProcess, dumpImage, scratchArena, outReport);
    outReport += s_CallstackSectionHeader;

    const auto clientFrames = AppendClientCallstack(symbolProcess, packageDirectory, scratchArena, outReport);
    if(!clientFrames)
        AppendNativeFailure(CrashSymbolicationFailure{ .operation = "read_client_callstack", .code = clientFrames.error(), }, outReport);
    else if(*clientFrames)
        return true;

    CONTEXT walkContext = crashContext->context;
    STACKFRAME64 frame;
    InitializeStackFrameFromContext(walkContext, frame);

    const DWORD machineType = MachineTypeFromContext(walkContext);
    b8 decodedAnyFrame = false;
    for(DWORD frameIndex = 0u; frameIndex < s_CrashSymbolicateWin32MaxWindowsStackFrames; ++frameIndex){
        if(frame.AddrPC.Offset == 0u)
            break;

        AppendResolvedSymbol(symbolProcess, frameIndex, frame.AddrPC.Offset, scratchArena, outReport);
        decodedAnyFrame = true;

        if(!StackWalk64(machineType, symbolProcess, nullptr, &frame, &walkContext, ReadProcessMemoryFromDump, SymFunctionTableAccess64, SymGetModuleBase64, nullptr))
            break;
    }

    if(!decodedAnyFrame)
        outReport += s_Win32NoFramesDecodedLine;
    return decodedAnyFrame;
}
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


CrashReportText BuildCrashSymbolicationReport(const CrashScratchPath& packageDirectory, const CrashPackageSummary& summary, const CrashSymbolicationConfig& config, LogArena& arena, Core::Alloc::ScratchArena& scratchArena){
    CrashReportText detailReport{arena};
    detailReport.reserve(LoggerCrashSymbolicateDetail::s_CrashReportReserveBytes);

    detailReport += "package=";
    detailReport += PathToString<char>(scratchArena, packageDirectory);
    detailReport += "\ncrash_id=";
    detailReport += summary.crashId;
    detailReport += "\nplatform=";
    detailReport += summary.platform;
    detailReport += "\nreason=";
    detailReport += summary.reasonKind;
    detailReport += "\nartifact_strategy=";
    detailReport += summary.artifactStrategy;
    detailReport += s_ReportLineEnd;
    LoggerCrashSymbolicateDetail::AppendSymbolStoreStatus(config, scratchArena, detailReport);
    LoggerCrashSymbolicateDetail::AppendEventSummary(summary, detailReport);

    if(summary.platform == Core::Crash::s_WindowsPlatformName){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        const auto decoded = LoggerCrashSymbolicateDetail::AppendWindowsMinidumpStack(packageDirectory, summary, config, scratchArena, detailReport);
        if(!decoded)
            LoggerCrashSymbolicateDetail::AppendNativeFailure(decoded.error(), detailReport);
        else if(!*decoded)
            detailReport += "stack_decode=unavailable\n";
#else
        detailReport += "status=not_decoded\nresolver=windows_pdb_minidump\ndetail=Windows minidump resolver is only available on Windows logserver builds\n";
#endif
    }
    else if(summary.platform == Core::Crash::s_LinuxPlatformName){
        LoggerCrashSymbolicateDetail::AppendLinuxArtifactSummary(packageDirectory, config, scratchArena, detailReport);
    }
    else if(summary.platform == Core::Crash::s_AndroidPlatformName){
        LoggerCrashSymbolicateDetail::AppendAndroidTombstoneSummary(packageDirectory, scratchArena, detailReport);
    }
    else{
        detailReport += "status=not_decoded\nresolver=unknown\ndetail=unknown crash platform\n";
    }

    LoggerCrashSymbolicateDetail::AppendOptionalTextFile(packageDirectory, Core::Crash::PackageNames::s_GpuCrashReportFileName, "gpu_crash", scratchArena, detailReport);
    LoggerCrashSymbolicateDetail::AppendRadeonGpuDetectiveSummary(packageDirectory, scratchArena, detailReport);
    LoggerCrashSymbolicateDetail::AppendAftermathGpuDumpSummary(packageDirectory, scratchArena, detailReport);
    LoggerCrashSymbolicateDetail::AppendOptionalTextFile(packageDirectory, Core::Crash::PackageNames::s_CpuContextFileName, "cpu_context", scratchArena, detailReport);
    LoggerCrashSymbolicateDetail::AppendOptionalTextFile(packageDirectory, Core::Crash::PackageNames::s_MetadataFileName, "metadata", scratchArena, detailReport);
    LoggerCrashSymbolicateDetail::AppendOptionalTextFile(packageDirectory, Core::Crash::PackageNames::s_BreadcrumbsFileName, "breadcrumbs", scratchArena, detailReport);
    LoggerCrashSymbolicateDetail::AppendOptionalTextFile(packageDirectory, Core::Crash::PackageNames::s_SymbolicationFileName, "client_symbolication_note", scratchArena, detailReport);
    LoggerCrashSymbolicateDetail::AppendOptionalTextFile(packageDirectory, Core::Crash::PackageNames::s_AndroidCollectionFileName, "android_collection", scratchArena, detailReport);
    return LoggerCrashSymbolicateDetail::CrashReportComposer::BuildOrderedCrashReport(summary, scratchArena, Move(detailReport));
}


