const f32 s_StressCutterHeight = 0.9f;
const f32 s_StressCutterAmplitude = 0.1f;
const f32 s_StressTransparentRowZ = -0.55f;
const u32 s_StressDefaultCharactersPerClass = 10u;
const u32 s_StressComparisonCharactersPerClass = 5u;
const f32 s_StressSpinSpeed = 0.8f;
const f32 s_StressManualYawSpeed = 0.6f;
const f32 s_StressMaxSpinDelta = 1.0f / 15.0f;


