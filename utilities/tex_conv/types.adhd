[reflect]
enum<u8> AlphaSourceMode{
    Original,
    Constant,
    Image
}

b8 IsValidAlphaSourceMode(in AlphaSourceMode mode){
    return mode == AlphaSourceMode::Original || mode == AlphaSourceMode::Constant || mode == AlphaSourceMode::Image;
}


