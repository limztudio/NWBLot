[cpp_header("<tests/common/memory_sdk.h>"), cpp_name("::NWB::Tests::PersistentStorage")]
extern class PersistentStorage{
    ArenaMemoryStats memoryStats()const;
    AllocationIdentity identity()const;
};


[cpp_header("<tests/common/memory_sdk.h>"), cpp_name("::NWB::Tests::HeapStorageVector")]
extern class HeapStorageVector<T>{
    mut T emplace_back(...);
    void assign(...);
    auto begin();
    auto end();
    void erase(...);
    void pop_back();
    void insert(...);
    void swap(...);
    usize capacity()const;
    b8 empty()const;
    void clear();
    mut T front();
    in T front()const;
    in T back()const;
    void reserve(in usize count);
    void push_back(in T value);
    mut T back();
    void resize(...);
    mut T operator[](in usize index);
    in T operator[](in usize index)const;
    usize size()const;
};


[cpp_header("<tests/common/memory_sdk.h>"), cpp_name("::NWB::Tests::ScratchStorageVector")]
extern class ScratchStorageVector<T>{
    void clear();
    mut T front();
    in T front()const;
    in T back()const;
    b8 empty()const;
    void reserve(in usize count);
    void push_back(in T value);
    mut T back();
    void resize(...);
    mut T operator[](in usize index);
    in T operator[](in usize index)const;
    usize size()const;
};


type HeapStorage = HeapStorageHandle;


[cpp_header("<tests/common/memory_sdk.h>"), cpp_name("::NWB::Tests::TestArrayData"), cpp_flags(small_value)]
extern class TestArrayData<T>{
    Span<T> declaredSpan(in usize count)const;
};


