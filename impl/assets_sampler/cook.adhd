////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_sampler/asset.adhd>
#include <impl/assets_sampler/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SamplerCookEntry{
    public Name virtualPath = s_NameNone;
    public SamplerDesc description;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_SamplerCookBorderColorChannel = 0.0f;

b8 ValidateSamplerCookMetadataDescription(
    in Path nwbFilePath,
    in f32 borderColorR,
    in f32 borderColorG,
    in f32 borderColorB,
    in f32 borderColorA,
    in f32 maxAnisotropy,
    in f32 mipBias,
    in u32 addressU,
    in u32 addressV,
    in u32 addressW,
    in u32 reductionType
){
    if(IsValidSamplerDescriptionParameters(
        borderColorR,
        borderColorG,
        borderColorB,
        borderColorA,
        maxAnisotropy,
        mipBias,
        addressU,
        addressV,
        addressW,
        reductionType
    ))
        return true;

    error("{} '{}': sampler description is invalid", s_SamplerMetaDiagnosticPrefix, PathToString(nwbFilePath));
    return false;
}

b8 ValidateSamplerCookEntryVirtualPath(in Name virtualPath){
    if(virtualPath != s_NameNone)
        return true;

    error("Sampler cook: sampler entry is invalid");
    return false;
}

Expected<b8> ReadSamplerFilterField(in Path nwbFilePath, in MetascriptValue object, in StringView fieldName){
    const Expected<MetadataStringField> field = ReadMetadataStringField(nwbFilePath, object, s_SamplerMetaDiagnosticPrefix, fieldName, true);
    if(!field.has_value())
        return MakeUnexpected(Failure());

    const StringView value = field.value().text;
    if(value == s_SamplerFilterNearest)
        return false;
    if(value == s_SamplerFilterLinear)
        return true;

    error("{} '{}': field '{}' {}", s_SamplerMetaDiagnosticPrefix, PathToString(nwbFilePath), fieldName, s_SamplerFilterHint);
    return MakeUnexpected(Failure());
}

Expected<SamplerAddressMode> ReadSamplerAddressModeField(in Path nwbFilePath, in MetascriptValue object, in StringView fieldName){
    const Expected<MetadataStringField> field = ReadMetadataStringField(nwbFilePath, object, s_SamplerMetaDiagnosticPrefix, fieldName, true);
    if(!field.has_value())
        return MakeUnexpected(Failure());

    const StringView value = field.value().text;
    if(value == s_SamplerAddressClamp)
        return SamplerAddressMode::Clamp;
    if(value == s_SamplerAddressWrap)
        return SamplerAddressMode::Wrap;
    if(value == s_SamplerAddressBorder)
        return SamplerAddressMode::Border;
    if(value == s_SamplerAddressMirror)
        return SamplerAddressMode::Mirror;
    if(value == s_SamplerAddressMirrorOnce)
        return SamplerAddressMode::MirrorOnce;

    error("{} '{}': field '{}' {}", s_SamplerMetaDiagnosticPrefix, PathToString(nwbFilePath), fieldName, s_SamplerAddressModeHint);
    return MakeUnexpected(Failure());
}

Expected<SamplerReductionType> ReadSamplerReductionTypeField(in Path nwbFilePath, in MetascriptValue object, in StringView fieldName){
    const Expected<MetadataStringField> field = ReadMetadataStringField(nwbFilePath, object, s_SamplerMetaDiagnosticPrefix, fieldName, true);
    if(!field.has_value())
        return MakeUnexpected(Failure());

    const StringView value = field.value().text;
    if(value == s_SamplerReductionStandard)
        return SamplerReductionType::Standard;
    if(value == s_SamplerReductionComparison)
        return SamplerReductionType::Comparison;

    error("{} '{}': field '{}' {}", s_SamplerMetaDiagnosticPrefix, PathToString(nwbFilePath), fieldName, s_SamplerReductionTypeHint);
    return MakeUnexpected(Failure());
}

Expected<SamplerCookEntry> ParseSamplerCookMetadataValue(in Name virtualPath, in Path nwbFilePath, in MetascriptValue asset){
    SamplerCookEntry entry;
    if(!CheckMetadataAssetMap(nwbFilePath, asset, s_SamplerMetaDiagnosticPrefix))
        return MakeUnexpected(Failure());
    if(!AssignCookEntryVirtualPath(virtualPath, nwbFilePath, s_SamplerMetaDiagnosticPrefix, entry))
        return MakeUnexpected(Failure());
    if(!ValidateMetadataAssetFields(nwbFilePath, asset, s_SamplerMetaDiagnosticPrefix, lambda[](in StringView fieldName) -> b8{
        return IsAllowedSamplerMetadataField(fieldName);
    }))
        return MakeUnexpected(Failure());

    SamplerDesc description;
    description.borderColor = Color(s_SamplerCookBorderColorChannel, s_SamplerCookBorderColorChannel, s_SamplerCookBorderColorChannel, s_SamplerCookBorderColorChannel);
    const Expected<b8> minFilterResult = ReadSamplerFilterField(nwbFilePath, asset, s_SamplerMinFilterField);
    if(!minFilterResult.has_value())
        return MakeUnexpected(Failure());
    description.minFilter = minFilterResult.value();
    const Expected<b8> magFilterResult = ReadSamplerFilterField(nwbFilePath, asset, s_SamplerMagFilterField);
    if(!magFilterResult.has_value())
        return MakeUnexpected(Failure());
    description.magFilter = magFilterResult.value();
    const Expected<b8> mipFilterResult = ReadSamplerFilterField(nwbFilePath, asset, s_SamplerMipFilterField);
    if(!mipFilterResult.has_value())
        return MakeUnexpected(Failure());
    description.mipFilter = mipFilterResult.value();
    const Expected<SamplerAddressMode> addressUResult = ReadSamplerAddressModeField(nwbFilePath, asset, s_SamplerAddressUField);
    if(!addressUResult.has_value())
        return MakeUnexpected(Failure());
    description.addressU = addressUResult.value();
    const Expected<SamplerAddressMode> addressVResult = ReadSamplerAddressModeField(nwbFilePath, asset, s_SamplerAddressVField);
    if(!addressVResult.has_value())
        return MakeUnexpected(Failure());
    description.addressV = addressVResult.value();
    const Expected<SamplerAddressMode> addressWResult = ReadSamplerAddressModeField(nwbFilePath, asset, s_SamplerAddressWField);
    if(!addressWResult.has_value())
        return MakeUnexpected(Failure());
    description.addressW = addressWResult.value();
    const Expected<SamplerReductionType> reductionTypeResult = ReadSamplerReductionTypeField(nwbFilePath, asset, s_SamplerReductionField);
    if(!reductionTypeResult.has_value())
        return MakeUnexpected(Failure());
    description.reductionType = reductionTypeResult.value();
    const Expected<f32> maxAnisotropyResult = ReadMetadataFiniteF32Field(nwbFilePath, asset, s_SamplerMetaDiagnosticPrefix, s_SamplerMaxAnisotropyField, true);
    if(!maxAnisotropyResult.has_value())
        return MakeUnexpected(Failure());
    description.maxAnisotropy = maxAnisotropyResult.value();
    const Expected<f32> mipBiasResult = ReadMetadataFiniteF32Field(nwbFilePath, asset, s_SamplerMetaDiagnosticPrefix, s_SamplerMipBiasField, true);
    if(!mipBiasResult.has_value())
        return MakeUnexpected(Failure());
    description.mipBias = mipBiasResult.value();
    if(!ValidateSamplerCookMetadataDescription(
        nwbFilePath,
        description.borderColor.r,
        description.borderColor.g,
        description.borderColor.b,
        description.borderColor.a,
        description.maxAnisotropy,
        description.mipBias,
        cast<u32>(description.addressU),
        cast<u32>(description.addressV),
        cast<u32>(description.addressW),
        cast<u32>(description.reductionType)
    ))
        return MakeUnexpected(Failure());

    entry.description = description;
    return entry;
}

Expected<SamplerCookEntry> ParseSamplerCookMetadata(
    in Path assetRoot,
    in StringView virtualRoot,
    in Path nwbFilePath,
    in MetascriptDocument doc,
    mut ScratchArena scratchArena
){
    return ParseCookMetadataDocument<SamplerCookEntry>(
        assetRoot,
        virtualRoot,
        nwbFilePath,
        doc,
        s_SamplerMetaDiagnosticPrefix,
        lambda[in nwbFilePath](in Name virtualPath, in MetascriptValue asset) -> Expected<SamplerCookEntry>{
            return ParseSamplerCookMetadataValue(virtualPath, nwbFilePath, asset);
        },
        scratchArena
    );
}

Expected<Sampler> BuildSamplerAsset(in SamplerCookEntry samplerEntry, mut AssetArena arena){
    if(!ValidateSamplerCookEntryVirtualPath(samplerEntry.virtualPath))
        return MakeUnexpected(Failure());

    Sampler asset(arena, samplerEntry.virtualPath);
    asset.setDescription(samplerEntry.description);
    if(!asset.validatePayload())
        return MakeUnexpected(Failure());
    return asset;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if defined(NWB_COOK)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 SamplerAssetCodec::serialize(const Core::Assets::IAsset& asset, Core::Assets::AssetBytes& outBinary)const{
    if(!checkSerializeAssetType(asset, FOUNDATION_TEXT("SamplerAssetCodec::serialize")))
        return false;

    const Sampler& sampler = *MakeNotNull(checked_cast<const Sampler*>(&asset));
    if(!sampler.validatePayload())
        return false;

    const Core::SamplerDesc& description = sampler.description();
    SerializeSamplerBinaryPayload(
        description.borderColor.r,
        description.borderColor.g,
        description.borderColor.b,
        description.borderColor.a,
        description.maxAnisotropy,
        description.mipBias,
        description.minFilter,
        description.magFilter,
        description.mipFilter,
        static_cast<u32>(description.addressU),
        static_cast<u32>(description.addressV),
        static_cast<u32>(description.addressW),
        static_cast<u32>(description.reductionType),
        outBinary
    );
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


