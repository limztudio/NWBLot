////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_MATERIAL_COLOR_SLANGI
#define NWB_MATERIAL_COLOR_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <common/math.slangi>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Material color transforms belong in each surface hook.
half3 nwbMaterialVertexColor(half3 color){
    return clamp(color, half3(0.0h), half3(1.0h));
}

// Read the shared typed constant/mutable color pair before surface-specific modulation.
half3 nwbMaterialSurfaceBaseColor(){
    const NwbMeshInstanceData instance = nwbMeshLoadInstance();
    const NwbSurfaceMaterial surface = nwbMaterialBindLoadSurface(instance);
    const NwbRuntimeMaterial runtime = nwbMaterialBindLoadRuntime(instance);
    return nwbMaterialVertexColor(half3((surface.base_color * runtime.color_tint).rgb));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

