#include <impl/ecs_render/kernel/task_graph_resource_descs.adhd>
#include <impl/ecs_render/shadow/rt_shadow_internal_types.adhd>
#include <impl/ecs_render/shadow/shadow_material_context_preparer.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateShadowMaterialContextUploadBatch(
    in b8 instanceMaterialsBlobValid,
    in b8 instancesBlobValid,
    in b8 materialTypedBlobValid,
    in b8 instanceMaterialsImported,
    in b8 instancesImported,
    in b8 materialTypedImported
){
    if(instanceMaterialsBlobValid != instancesBlobValid || instanceMaterialsBlobValid != materialTypedBlobValid){
        warning("RendererSystem: incomplete frozen shadow material-context upload batch");
        return false;
    }
    if(instanceMaterialsBlobValid && (!instanceMaterialsImported || !instancesImported || !materialTypedImported)){
        warning("RendererSystem: frozen shadow material-context batch has no imported destination");
        return false;
    }
    return true;
}

b8 ValidateSceneBvhUploadBatch(in b8 nodesBlobValid, in b8 instancesBlobValid, in b8 nodesImported, in b8 instancesImported){
    if(nodesBlobValid != instancesBlobValid){
        warning("RendererSystem: incomplete frozen software scene-BVH upload pair");
        return false;
    }
    if(nodesBlobValid && (!nodesImported || !instancesImported)){
        warning("RendererSystem: frozen software scene-BVH pair has no imported destination");
        return false;
    }
    return true;
}

Name SelectCausticEmissionTargetsIdentity(in b8 hardwareRayTracingSupported, in Name hardwareIdentity, in Name softwareIdentity){
    if(hardwareRayTracingSupported)
        return hardwareIdentity;
    return softwareIdentity;
}

b8 CanReusePreparedShadowMaterialContext(
    in PreparedShadowMaterialContextRoute route,
    in b8 staticScene,
    in b8 hwHashValid,
    in u64 hwHash,
    in b8 swHashValid,
    in u64 swHash,
    in u64 expectedHash,
    in b8 buffersReady
){
    if(!staticScene || !buffersReady)
        return false;
    if(route == PreparedShadowMaterialContextRoute::Hardware)
        return hwHashValid && hwHash == expectedHash;
    if(route == PreparedShadowMaterialContextRoute::Software)
        return swHashValid && swHash == expectedHash;
    return false;
}

Expected<Name> FormatCsgQueueReadCompleteIdentity(in u32 physicalQueueIndex){
    CompactString text = CompactString("render.raytrace.csg_queue_");
    AppendUnsignedU64Text(text, cast<u64>(physicalQueueIndex));
    if(!text.append(".read_complete"))
        return MakeUnexpected(Failure());
    return ParseName(text.view());
}

Expected<GpuGraphResourceId> ImportOptionalShadowPrepareExternalBuffer(mut GpuTaskGraph graph, in BufferHandle buffer, in Name identity, in StringView label){
    if(!buffer.valid())
        return GpuGraphResourceId();
    return ImportExternalBuffer(graph, buffer, identity, label);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 AppendChainedUploadBufferTask(
    mut GpuTaskGraph graph,
    in Name identity,
    in StringView markerLabel,
    in GpuTaskCostHint cost,
    in GpuUploadBlobId source,
    in GpuGraphResourceId destination,
    in StringView warningMessage,
    mut Vector<GpuExternalCompletionId> pendingReadCompletions,
    mut GpuTaskId inOutDependencyTask,
    mut GpuTaskId outTask
){
    GpuTaskSchedulingHint uploadScheduling;
    uploadScheduling.cost = cost;
    uploadScheduling.forceSubmissionBoundary = false;
    uploadScheduling.allowPacketMerge = true;
    uploadScheduling.mergeWithPrevious = inOutDependencyTask.valid();

    GpuTaskDesc uploadDesc;
    uploadDesc.setIdentity(identity).setMarkerLabel(markerLabel).setScheduling(uploadScheduling);
    if(inOutDependencyTask.valid())
        uploadDesc.setDependency(inOutDependencyTask);
    if(!pendingReadCompletions.empty()){
        uploadDesc.setExternalDependencies(pendingReadCompletions);
        pendingReadCompletions.clear();
    }
    GpuUploadBufferTaskDesc uploadTaskResultUpload;
    uploadTaskResultUpload.source = source;
    uploadTaskResultUpload.destination = destination;
    uploadTaskResultUpload.finalState = ResourceStates::Common;
    const auto uploadTaskResult = graph.addUploadBufferTask(uploadDesc,uploadTaskResultUpload);
    if(!uploadTaskResult.has_value()){
        outTask = GpuTaskId();
        warning("{}", warningMessage);
        return false;
    }
    outTask = uploadTaskResult.value();
    inOutDependencyTask = outTask;
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ShadowPrepareUploadChainBuilder::declareSelectorAndContextUploads(in ShadowPrepareUploadInputs inputs, mut ShadowPrepareUploadChain chain){
    chain.completionTask = GpuTaskId();

    chain.currentBindlessSlotsGraphOwned = !inputs.targets.bindless.slotsUploaded;
    if(chain.currentBindlessSlotsGraphOwned){
        const auto bindlessSlotsBlobResult = this.m_graph.copyUploadValue(inputs.targets.bindless.slots);
        if(!bindlessSlotsBlobResult.has_value()){
            warning("RendererSystem: could not retain deferred bindless selector upload data");
            return false;
        }
        const GpuUploadBlobId bindlessSlotsBlob = bindlessSlotsBlobResult.value();

        GpuTaskSchedulingHint uploadScheduling;
        uploadScheduling.cost = GpuTaskCostHint::Tiny;
        uploadScheduling.forceSubmissionBoundary = false;
        uploadScheduling.allowPacketMerge = true;
        GpuTaskDesc uploadDesc;
        uploadDesc.setIdentity(s_ShadowDeferredBindlessSlotsUpload).setMarkerLabel("Deferred Bindless Slots Upload").setScheduling(uploadScheduling);
        GpuUploadBufferTaskDesc deferredBindlessSlotsUploadTaskResultUpload;
        deferredBindlessSlotsUploadTaskResultUpload.source = bindlessSlotsBlob;
        deferredBindlessSlotsUploadTaskResultUpload.destination = inputs.currentBindlessSlots;
        deferredBindlessSlotsUploadTaskResultUpload.finalState = ResourceStates::ConstantBuffer;
        const auto deferredBindlessSlotsUploadTaskResult = this.m_graph.addUploadBufferTask(
            uploadDesc,deferredBindlessSlotsUploadTaskResultUpload);
        if(!deferredBindlessSlotsUploadTaskResult.has_value()){
            chain.tasks.bindlessSlots = GpuTaskId();
            warning("RendererSystem: could not declare deferred bindless selector upload");
            return false;
        }
        chain.tasks.bindlessSlots = deferredBindlessSlotsUploadTaskResult.value();
        chain.completionTask = chain.tasks.bindlessSlots;
    }

    const auto rayTraceMaterialContextSlots = this.m_raytracingSystem.snapshotRayTraceMaterialContextSlots();
    if(!rayTraceMaterialContextSlots.has_value()){
        warning("RendererSystem: could not snapshot ray-trace material-context selector");
        return false;
    }

    chain.pendingContextReadCompletions.clear();
    if(!inputs.rayTracingResources.rayTraceContextReadSubmissionTokens.empty()){
        chain.pendingContextReadCompletions.reserve(inputs.rayTracingResources.rayTraceContextReadSubmissionTokens.size());
        for(in QueueSubmissionToken token : inputs.rayTracingResources.rayTraceContextReadSubmissionTokens){
            if(!token.valid())
                continue;
            const Expected<Name> completionIdentity = FormatCsgQueueReadCompleteIdentity(token.physicalQueueIndex);
            if(!completionIdentity.has_value())
                return false;
            GpuExternalCompletionDesc readCompleteDesc;
            readCompleteDesc.setIdentity(completionIdentity.value()).setMarkerLabel("Prior CSG Ray Read Complete").setToken(token);
            const auto readCompleteResult = this.m_graph.importExternalCompletion(readCompleteDesc);
            if(!readCompleteResult.has_value())
                return false;
            chain.pendingContextReadCompletions.push_back(readCompleteResult.value());
        }
    }

    const usize slotsBufferIdentity = inputs.rayTracingResources.materialContextSlotsBuffer.identity();
    if(this.m_raytracingSystem.rayTraceMaterialContextSlotsUploadNeeded(
        rayTraceMaterialContextSlots.value(),
        slotsBufferIdentity,
        chain.rayTraceMaterialContextSlotsWord0,
        chain.rayTraceMaterialContextSlotsWord1,
        chain.rayTraceMaterialContextSlotsWord2,
        chain.rayTraceMaterialContextSlotsWord3
    )){
        const auto rayTraceMaterialContextSlotsBlobResult = this.m_graph.copyUploadValue(rayTraceMaterialContextSlots.value());
        if(!rayTraceMaterialContextSlotsBlobResult.has_value()){
            warning("RendererSystem: could not retain ray-trace material-context selector upload data");
            return false;
        }
        const GpuUploadBlobId rayTraceMaterialContextSlotsBlob = rayTraceMaterialContextSlotsBlobResult.value();

        GpuTaskSchedulingHint materialContextUploadScheduling;
        materialContextUploadScheduling.cost = GpuTaskCostHint::Tiny;
        materialContextUploadScheduling.forceSubmissionBoundary = false;
        materialContextUploadScheduling.allowPacketMerge = true;
        materialContextUploadScheduling.mergeWithPrevious = chain.completionTask.valid();
        GpuTaskDesc materialContextUploadDesc;
        materialContextUploadDesc
            .setIdentity(s_ShadowRaytraceMaterialContextSlotsUpload)
            .setMarkerLabel("Ray-Trace Material Context Slots Upload")
            .setScheduling(materialContextUploadScheduling)
        ;
        if(!chain.pendingContextReadCompletions.empty()){
            materialContextUploadDesc.setExternalDependencies(chain.pendingContextReadCompletions);
            chain.pendingContextReadCompletions.clear();
        }
        if(chain.completionTask.valid())
            materialContextUploadDesc.setDependency(chain.completionTask);
        GpuUploadBufferTaskDesc rayTraceMaterialContextSlotsUploadTaskResultUpload;
        rayTraceMaterialContextSlotsUploadTaskResultUpload.source = rayTraceMaterialContextSlotsBlob;
        rayTraceMaterialContextSlotsUploadTaskResultUpload.destination = inputs.materialContextSlots;
        rayTraceMaterialContextSlotsUploadTaskResultUpload.finalState = ResourceStates::Common;
        const auto rayTraceMaterialContextSlotsUploadTaskResult = this.m_graph.addUploadBufferTask(
            materialContextUploadDesc,rayTraceMaterialContextSlotsUploadTaskResultUpload);
        if(!rayTraceMaterialContextSlotsUploadTaskResult.has_value()){
            chain.tasks.rayTraceMaterialContextSlots = GpuTaskId();
            warning("RendererSystem: could not declare ray-trace material-context selector upload");
            return false;
        }
        chain.tasks.rayTraceMaterialContextSlots = rayTraceMaterialContextSlotsUploadTaskResult.value();
        chain.completionTask = chain.tasks.rayTraceMaterialContextSlots;
        chain.rayTraceMaterialContextSlotsBufferIdentity = slotsBufferIdentity;
        chain.rayTraceMaterialContextSlotsUploadPending = true;
    }

    const Name causticEmissionTargetsIdentity = SelectCausticEmissionTargetsIdentity(
        this.m_graphics.queryFeatureSupport(Feature::RayTracingAccelStruct) && this.m_graphics.queryFeatureSupport(Feature::RayQuery),
        Name(s_HardwareCausticEmissionTargetsName),
        Name(s_SoftwareCausticEmissionTargetsName)
    );
    const auto causticEmissionTargetsResult = ImportOptionalShadowPrepareExternalBuffer(this.m_graph, inputs.rayTracingResources.causticEmissionTargetBuffer, causticEmissionTargetsIdentity, s_CausticEmissionTargetsLabel);
    if(!causticEmissionTargetsResult.has_value()){
        warning("RendererSystem: could not import preflighted caustic emission targets");
        return false;
    }
    chain.causticEmissionTargets = causticEmissionTargetsResult.value();

    const auto causticEmissionTargetsBlob = this.m_raytracingSystem.retainPreparedCausticEmissionTargetUpload(
        this.m_graph,
        chain.causticEmissionTargetsUploadHash,
        chain.causticEmissionTargetsUploadByteSize,
        chain.causticEmissionTargetsUploadBufferIdentity
    );
    if(!causticEmissionTargetsBlob.has_value()){
        warning("RendererSystem: could not retain preflighted caustic emission-target upload data");
        return false;
    }

    Expected<GpuGraphResourceId> csgTraceContextResult = MakeUnexpected(Failure());
    if(inputs.rayTracingResources.csgTraceContextBuffer.valid()){
        GpuGraphResourceDesc contextDesc = BufferResourceDesc(s_ShadowRaytraceCsgContext, "Current CSG Ray Context");
        csgTraceContextResult = this.m_graph.importBuffer(inputs.rayTracingResources.csgTraceContextBuffer, contextDesc);
        if(csgTraceContextResult.has_value())
            chain.csgTraceContext = csgTraceContextResult.value();
    }
    const auto csgTraceContextBlob = this.m_raytracingSystem.retainPreparedCsgTraceContextUpload(
        this.m_graph,
        chain.csgTraceContextUploadHash,
        chain.csgTraceContextUploadByteSize,
        chain.csgTraceContextUploadBufferIdentity
    );
    if(!csgTraceContextBlob.has_value() || (inputs.rayTracingResources.csgTraceContextBuffer.valid() && !csgTraceContextResult.has_value())){
        error("RendererSystem: could not retain current CSG ray context");
        return false;
    }
    if(csgTraceContextBlob.value().has_value()){
        if(!chain.csgTraceContext.valid())
            return false;
        GpuTaskSchedulingHint csgUploadScheduling;
        csgUploadScheduling.cost = GpuTaskCostHint::Medium;
        csgUploadScheduling.forceSubmissionBoundary = false;
        csgUploadScheduling.allowPacketMerge = true;
        csgUploadScheduling.mergeWithPrevious = chain.completionTask.valid();
        GpuTaskDesc csgUploadDesc;
        csgUploadDesc
            .setIdentity(s_ShadowRaytraceCsgContextUpload)
            .setMarkerLabel("Current CSG Ray Context Upload")
            .setScheduling(csgUploadScheduling)
        ;
        if(!chain.pendingContextReadCompletions.empty()){
            csgUploadDesc.setExternalDependencies(chain.pendingContextReadCompletions);
            chain.pendingContextReadCompletions.clear();
        }
        if(chain.completionTask.valid())
            csgUploadDesc.setDependency(chain.completionTask);
        GpuUploadBufferTaskDesc csgTraceContextUploadTaskResultUpload;
        csgTraceContextUploadTaskResultUpload.source = csgTraceContextBlob.value().value();
        csgTraceContextUploadTaskResultUpload.destination = chain.csgTraceContext;
        csgTraceContextUploadTaskResultUpload.finalState = ResourceStates::Common;
        const auto csgTraceContextUploadTaskResult = this.m_graph.addUploadBufferTask(csgUploadDesc,csgTraceContextUploadTaskResultUpload);
        if(!csgTraceContextUploadTaskResult.has_value()){
            chain.tasks.csgTraceContext = GpuTaskId();
            return false;
        }
        chain.tasks.csgTraceContext = csgTraceContextUploadTaskResult.value();
        chain.completionTask = chain.tasks.csgTraceContext;
        chain.csgTraceContextUploadPending = true;
    }
    if(causticEmissionTargetsBlob.value().has_value()){
        if(!chain.causticEmissionTargets.valid()){
            warning("RendererSystem: caustic emission-target upload has no imported destination");
            return false;
        }
        if(!AppendChainedUploadBufferTask(this.m_graph, s_ShadowRaytraceCausticEmissionTargetsUpload, "Caustic Emission Targets Upload", GpuTaskCostHint::Medium, causticEmissionTargetsBlob.value().value(),
            chain.causticEmissionTargets, "RendererSystem: could not declare caustic emission-target upload", chain.pendingContextReadCompletions, chain.completionTask, chain.tasks.causticEmissionTargets))
            return false;
        chain.causticEmissionTargetsUploadPending = true;
    }
    return true;
}

b8 ShadowPrepareUploadChainBuilder::declareSurfelFrameConstantsUpload(in ShadowPrepareUploadInputs inputs, mut ShadowPrepareUploadChain chain){
    const auto surfelFrameConstantsResult = ImportOptionalShadowPrepareExternalBuffer(this.m_graph, inputs.rayTracingResources.surfelFrameConstantsBuffer, Name(s_SurfelConstantsName), s_SurfelConstantsLabel);
    if(!surfelFrameConstantsResult.has_value()){
        warning("RendererSystem: could not import preflighted surfel constants");
        return false;
    }
    chain.surfelFrameConstants = surfelFrameConstantsResult.value();

    const auto surfelFrameConstantsBlob = this.m_raytracingSystem.retainPreparedSurfelFrameConstantsUpload(this.m_graph, inputs.targets);
    if(!surfelFrameConstantsBlob.has_value()){
        warning("RendererSystem: could not retain preflighted surfel-frame constants upload data");
        return false;
    }
    if(surfelFrameConstantsBlob.value().has_value()){
        if(!chain.surfelFrameConstants.valid()){
            warning("RendererSystem: surfel-frame constants upload has no imported destination");
            return false;
        }
        if(!AppendChainedUploadBufferTask(this.m_graph, s_ShadowSurfelConstantsUpload, "Surfel Frame Constants Upload", GpuTaskCostHint::Tiny, surfelFrameConstantsBlob.value().value(), chain.surfelFrameConstants,
            "RendererSystem: could not declare surfel-frame constants upload", chain.pendingContextReadCompletions, chain.completionTask, chain.tasks.surfelFrameConstants))
            return false;
    }
    return true;
}

b8 ShadowPrepareUploadChainBuilder::declareShadowMaterialContextUploads(in ShadowPrepareUploadInputs inputs, mut ShadowPrepareUploadChain chain){
    const auto shadowInstanceMaterialsResult = ImportOptionalShadowPrepareExternalBuffer(this.m_graph, inputs.rayTracingResources.shadowInstanceMaterialBuffer, Name(s_SceneShadowInstanceMaterialName), s_SceneShadowInstanceMaterialLabel);
    const auto shadowInstancesResult = ImportOptionalShadowPrepareExternalBuffer(this.m_graph, inputs.rayTracingResources.shadowInstanceBuffer, Name(s_SceneShadowInstancesName), s_SceneShadowInstancesLabel);
    const auto shadowMaterialTypedResult = ImportOptionalShadowPrepareExternalBuffer(this.m_graph, inputs.rayTracingResources.shadowMaterialTypedBuffer, Name(s_SceneShadowMaterialTypedName), s_SceneShadowMaterialTypedLabel);
    if(!shadowInstanceMaterialsResult.has_value() || !shadowInstancesResult.has_value() || !shadowMaterialTypedResult.has_value()){
        warning("RendererSystem: could not import preflighted shadow material-context buffers");
        return false;
    }
    chain.shadowMaterialTyped = shadowMaterialTypedResult.value();
    chain.shadowInstances = shadowInstancesResult.value();
    chain.shadowInstanceMaterials = shadowInstanceMaterialsResult.value();

    const auto shadowMaterialContextUploads = this.m_raytracingSystem.retainPreparedShadowMaterialContextUploads(this.m_graph);
    if(!shadowMaterialContextUploads.has_value()){
        warning("RendererSystem: could not retain preflighted shadow material-context upload data");
        return false;
    }
    const GpuUploadBlobId shadowInstanceMaterialsBlob = shadowMaterialContextUploads.value().instanceMaterial;
    const GpuUploadBlobId shadowInstancesBlob = shadowMaterialContextUploads.value().instance;
    const GpuUploadBlobId shadowMaterialTypedBlob = shadowMaterialContextUploads.value().materialTyped;
    chain.shadowMaterialContextBatchGraphOwned = shadowInstanceMaterialsBlob.valid();
    if(!ValidateShadowMaterialContextUploadBatch(shadowInstanceMaterialsBlob.valid(), shadowInstancesBlob.valid(), shadowMaterialTypedBlob.valid(), chain.shadowInstanceMaterials.valid(), chain.shadowInstances.valid(), chain.shadowMaterialTyped.valid()))
        return false;
    if(chain.shadowMaterialContextBatchGraphOwned){
        if(
            !AppendChainedUploadBufferTask(this.m_graph, s_ShadowDeferredEffectsInstanceMaterialUpload, "Shadow Instance Materials Upload", GpuTaskCostHint::Medium, shadowInstanceMaterialsBlob,
                chain.shadowInstanceMaterials, "RendererSystem: could not declare shadow instance-material upload", chain.pendingContextReadCompletions, chain.completionTask, chain.tasks.shadowInstanceMaterial)
            || !AppendChainedUploadBufferTask(this.m_graph, s_ShadowDeferredEffectsShadowInstancesUpload, "Shadow Instances Upload", GpuTaskCostHint::Medium, shadowInstancesBlob, chain.shadowInstances,
                "RendererSystem: could not declare shadow instance upload", chain.pendingContextReadCompletions, chain.completionTask, chain.tasks.shadowInstance)
            || !AppendChainedUploadBufferTask(this.m_graph, s_ShadowDeferredEffectsMaterialTypedUpload, "Shadow Typed Materials Upload", GpuTaskCostHint::Medium, shadowMaterialTypedBlob, chain.shadowMaterialTyped,
                "RendererSystem: could not declare shadow typed-material upload", chain.pendingContextReadCompletions, chain.completionTask, chain.tasks.shadowMaterialTyped)
        )
            return false;
    }
    return true;
}

b8 ShadowPrepareUploadChainBuilder::declareSceneBvhUploads(in ShadowPrepareUploadInputs inputs, mut ShadowPrepareUploadChain chain){
    const auto sceneBvhNodesResult = ImportOptionalShadowPrepareExternalBuffer(this.m_graph, inputs.rayTracingResources.sceneBvhNodeBuffer, Name(s_SceneBvhNodesName), s_SceneBvhNodesLabel);
    const auto sceneBvhInstancesResult = ImportOptionalShadowPrepareExternalBuffer(this.m_graph, inputs.rayTracingResources.sceneInstanceBuffer, Name(s_SceneInstancesName), s_SceneInstancesLabel);
    if(!sceneBvhNodesResult.has_value() || !sceneBvhInstancesResult.has_value()){
        warning("RendererSystem: could not import preflighted software scene-BVH buffers");
        return false;
    }
    chain.sceneBvhInstances = sceneBvhInstancesResult.value();
    chain.sceneBvhNodes = sceneBvhNodesResult.value();

    const auto sceneBvhUploads = this.m_raytracingSystem.retainPreparedSceneBvhUploads(this.m_graph);
    if(!sceneBvhUploads.has_value()){
        warning("RendererSystem: could not retain preflighted software scene-BVH upload data");
        return false;
    }
    const GpuUploadBlobId sceneBvhNodesBlob = sceneBvhUploads.value().node;
    const GpuUploadBlobId sceneBvhInstancesBlob = sceneBvhUploads.value().instance;
    chain.sceneBvhBatchGraphOwned = sceneBvhNodesBlob.valid();
    if(!ValidateSceneBvhUploadBatch(sceneBvhNodesBlob.valid(), sceneBvhInstancesBlob.valid(), chain.sceneBvhNodes.valid(), chain.sceneBvhInstances.valid()))
        return false;
    if(chain.sceneBvhBatchGraphOwned){
        if(
            !AppendChainedUploadBufferTask(this.m_graph, s_ShadowPassSceneBvhNodesUpload, "Scene BVH Nodes Upload", GpuTaskCostHint::Medium, sceneBvhNodesBlob, chain.sceneBvhNodes,
                "RendererSystem: could not declare software scene-BVH node upload", chain.pendingContextReadCompletions, chain.completionTask, chain.tasks.sceneBvhNodes)
            || !AppendChainedUploadBufferTask(this.m_graph, s_ShadowPassSceneInstancesUpload, "Scene BVH Instances Upload", GpuTaskCostHint::Medium, sceneBvhInstancesBlob, chain.sceneBvhInstances,
                "RendererSystem: could not declare software scene-BVH instance upload", chain.pendingContextReadCompletions, chain.completionTask, chain.tasks.sceneBvhInstances)
        )
            return false;
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<u64> ShadowMaterialContextPreparer::prepareBytes(
    in PreparedShadowMaterialContextRoute route,
    in b8 staticScene,
    in usize sceneInstanceCount,
    in Span<NwbRtInstanceMaterialGpu> instanceMaterials,
    in Span<InstanceGpuData> shadowInstanceData,
    in Span<u8> shadowMaterialTypedBytes,
    in u64 materialTypedHash
){

    const usize materialTypedUploadBytes = ResolveMaterialTypedUploadByteCount(shadowMaterialTypedBytes);
    const u64 materialContextHash = ComputeShadowMaterialContextHashWithTypedHash(instanceMaterials, shadowInstanceData, shadowMaterialTypedBytes.size(), materialTypedHash);
    const b8 canReuseMaterialContext = CanReusePreparedShadowMaterialContext(
        route, staticScene,
        this.m_system.m_rayTracingState.shadow.m_hwShadowMaterialContextHashValid, this.m_system.m_rayTracingState.shadow.m_hwShadowMaterialContextHash,
        this.m_system.m_rayTracingState.shadow.m_swShadowMaterialContextHashValid, this.m_system.m_rayTracingState.shadow.m_swShadowMaterialContextHash,
        materialContextHash, HasPreparedShadowMaterialContextBuffers(this.m_system.m_rayTracingState, instanceMaterials.size(), shadowInstanceData.size(), materialTypedUploadBytes)
    );
    if(canReuseMaterialContext && !this.m_system.capturePreparedShadowMaterialContextCacheReuse(route, materialContextHash, instanceMaterials.size(), shadowInstanceData.size(), materialTypedUploadBytes))
        return MakeUnexpected(Failure());
    if(!canReuseMaterialContext){
        RayTraceMaterialResources resources(this.m_system.m_graphics, this.m_system.m_rayTracingState.sceneBvh, this.m_system.m_rayTracingState.shadow);
        if(
            !resources.ensureShadowInstanceMaterialBuffer(sceneInstanceCount)
            || !resources.ensureShadowInstanceContextBuffer(shadowInstanceData.size())
            || !resources.ensureShadowMaterialTypedBuffer(materialTypedUploadBytes)
            || !HasPreparedShadowMaterialContextBuffers(this.m_system.m_rayTracingState, instanceMaterials.size(), shadowInstanceData.size(), materialTypedUploadBytes)
        )
            return MakeUnexpected(Failure());
        if(!this.m_system.capturePreparedShadowMaterialContext(route, staticScene, materialContextHash, instanceMaterials, shadowInstanceData, shadowMaterialTypedBytes.subspan(0u, materialTypedUploadBytes)))
            return MakeUnexpected(Failure());
    }
    return materialContextHash;
}


