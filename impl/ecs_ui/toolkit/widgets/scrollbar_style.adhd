////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "style.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Color s_ScrollbarThumbColor = Color(0.35f, 0.40f, 0.48f, 1.0f);
const Color s_ScrollbarDisabledColor = Color(0.25f, 0.28f, 0.32f, 1.0f);
const u32 s_ScrollAxisCount = 2u;
// Each axis can add a reservation once, then both axes are rechecked.
const u32 s_ScrollbarReservationPassLimit = 3u;
// Activation values of the track parts before and after each scrollbar thumb.
const u32 s_TextAreaScrollHorizontalBefore = 1u;
const u32 s_TextAreaScrollHorizontalAfter = 2u;
const u32 s_TextAreaScrollVerticalBefore = 3u;
const u32 s_TextAreaScrollVerticalAfter = 4u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> ScrollAxis{
    Horizontal,
    Vertical,
}

class ScrollbarStyle{
    public Name track = Name("scroll.track");
    public Name trackFallback = Name("panel.normal");
    public Name thumb = Name("scroll.thumb");
    public Name thumbHover = Name("button.hover");
    public Name thumbPressed = Name("button.pressed");
    public Name thumbDisabled = Name("button.disabled");
    public Name thumbFallback = Name("button.normal");
    public Color trackColor = s_StyleInsetColor;
    public Color thumbColor = s_ScrollbarThumbColor;
    public Color disabledColor = s_ScrollbarDisabledColor;
    public f32 thickness = s_StyleScrollbarThickness;
    public f32 minimumThumb = s_StyleScrollbarMinimumThumb;
}

class ScrollbarPlacement{
    public Rect track;
    public Rect thumb;
    public f64 contentExtent = 0.0;
    public f64 viewportExtent = 0.0;
    public f64 maximum = 0.0;
    public f64 offset = 0.0;
    public b8 visible = false;
}

class ScrollViewportPlacement{
    public Rect viewport;
    public Rect contentClip;
    public Rect corner;
    public ScrollbarPlacement horizontal;
    public ScrollbarPlacement vertical;
}

class ScrollPlacement{
    public Rect bounds;
    public Rect viewport;
    public Rect contentClip;
    public Rect track;
    public Rect thumb;
    public f64 contentHeight = 0.0;
    public f64 maxOffset = 0.0;
    public f64 offset = 0.0;
    public u64 firstRow = 0u;
    public u64 endRow = 0u;
    public u64 rowCount = 0u;
    public b8 scrollbarVisible = false;
}

class MovedScrollbarThumb{
    public f64 offset = 0.0;
    public f32 origin = 0.0f;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 SameScrollbarPlacementGeometry(in ScrollbarPlacement first, in ScrollbarPlacement second){
    // Offset and thumb position change during an ordinary drag without changing its accepted press geometry.
    return EqualUiRect(first.track, second.track)
        && first.thumb.width == second.thumb.width
        && first.thumb.height == second.thumb.height
        && first.contentExtent == second.contentExtent
        && first.viewportExtent == second.viewportExtent
        && first.maximum == second.maximum
        && first.visible == second.visible;
}

b8 SameScrollViewportPlacementGeometry(in ScrollViewportPlacement first, in ScrollViewportPlacement second){
    return EqualUiRect(first.viewport, second.viewport)
        && EqualUiRect(first.contentClip, second.contentClip)
        && EqualUiRect(first.corner, second.corner)
        && SameScrollbarPlacementGeometry(first.horizontal, second.horizontal)
        && SameScrollbarPlacementGeometry(first.vertical, second.vertical);
}

Expected<f64> TrySetScrollOffset(in f64 offset){
    if(!isFinite(offset) || offset < 0.0)
        return makeUnexpected(Failure());
    return offset;
}

void ApplySkinPaletteToScrollbarStyle(in UiSkinPalette palette, mut ScrollbarStyle style){
    style.trackColor = ResolveUiSkinColor(palette, UiSkinColorRole::ScrollbarTrack);
    style.thumbColor = ResolveUiSkinColor(palette, UiSkinColorRole::ScrollbarThumb);
    style.disabledColor = ResolveUiSkinColor(palette, UiSkinColorRole::ScrollbarDisabled);
}

Expected<f64> TryEnsureScrollVisible(in f64 currentOffset, in f64 start, in f64 end, in f64 viewportHeight){
    if(!isFinite(start) || start < 0.0 || !isFinite(end) || end < start || !isFinite(viewportHeight) || viewportHeight < 0.0)
        return makeUnexpected(Failure());
    f64 candidate = currentOffset;
    if(end - start > viewportHeight || start < candidate)
        candidate = start;
    else if(end > candidate && end - candidate > viewportHeight)
        candidate = end - viewportHeight;
    return candidate;
}

Expected<f64> TryScrollByOffset(in f64 currentOffset, in f64 delta, in f64 contentHeight, in f64 viewportHeight){
    if(!isFinite(delta) || !isFinite(contentHeight) || contentHeight < 0.0 || !isFinite(viewportHeight) || viewportHeight < 0.0)
        return makeUnexpected(Failure());
    const f64 maxOffset = max(0.0, contentHeight - viewportHeight);
    const f64 base = min(currentOffset, maxOffset);
    if(delta >= 0.0)
        return base + min(delta, maxOffset - base);
    return max(0.0, base + delta);
}

Expected<f64> TryClampScrollOffset(in f64 currentOffset, in f64 contentHeight, in f64 viewportHeight){
    if(!isFinite(contentHeight) || contentHeight < 0.0 || !isFinite(viewportHeight) || viewportHeight < 0.0)
        return makeUnexpected(Failure());
    return min(currentOffset, max(0.0, contentHeight - viewportHeight));
}

// Extents and offsets are logical doubles; only the clipped visible row interval reaches float paint geometry.
// Reject viewports that cannot be represented within the double content extent.
Expected<ScrollPlacement> CalculateScrollPlacement(in Rect bounds, in Rect inheritedClip, in Insets padding, in f32 scrollbarWidth, in f32 minimumThumb, in u64 rowCount, in f32 rowHeight, in f64 offset){
    if(
        !IsValidUiRect(bounds) || !IsValidUiRect(inheritedClip) || !IsValidUiPadding(padding)
        || !isFinite(scrollbarWidth) || scrollbarWidth < 0.0f
        || !isFinite(minimumThumb) || minimumThumb < 0.0f
        || !isFinite(rowHeight) || rowHeight <= 0.0f || !isFinite(offset) || offset < 0.0
    )
        return makeUnexpected(Failure());
    const VectorDouble inset = ComputeInsetUiRectBounds(bounds, padding);
    const f64 x = inset.x;
    const f64 y = inset.y;
    const f64 availableWidth = inset.z;
    const f64 availableHeight = inset.w;
    ScrollPlacement candidate;
    candidate.bounds = bounds;
    candidate.rowCount = rowCount;
    candidate.contentHeight = cast<f64>(rowCount) * cast<f64>(rowHeight);
    if(!isFinite(candidate.contentHeight))
        return makeUnexpected(Failure());
    candidate.maxOffset = max(0.0, candidate.contentHeight - availableHeight);
    if(availableHeight > 0.0 && candidate.maxOffset > 0.0 && candidate.maxOffset >= candidate.contentHeight)
        return makeUnexpected(Failure());
    candidate.offset = min(offset, candidate.maxOffset);
    f64 barWidth = 0.0;
    if(candidate.maxOffset > 0.0)
        barWidth = min(cast<f64>(scrollbarWidth), availableWidth);
    candidate.viewport = Rect(cast<f32>(x), cast<f32>(y), cast<f32>(availableWidth - barWidth), cast<f32>(availableHeight));
    if(!IsValidUiRect(candidate.viewport))
        return makeUnexpected(Failure());
    candidate.contentClip = IntersectUiRectsBounds(candidate.viewport, inheritedClip);
    candidate.scrollbarVisible = barWidth > 0.0 && availableHeight > 0.0;
    if(candidate.scrollbarVisible){
        candidate.track = Rect(cast<f32>((x + availableWidth) - barWidth), cast<f32>(y), cast<f32>(barWidth), cast<f32>(availableHeight));
        const f64 proportionalHeight = availableHeight * (availableHeight / candidate.contentHeight);
        const f64 minimumSize = min(cast<f64>(minimumThumb), availableHeight);
        f64 thumbHeight = minimumSize;
        if(proportionalHeight > minimumSize)
            thumbHeight = min(availableHeight, proportionalHeight);
        const f64 thumbTravel = availableHeight - thumbHeight;
        const f64 thumbY = y + thumbTravel * (candidate.offset / candidate.maxOffset);
        candidate.thumb = Rect(candidate.track.x, cast<f32>(thumbY), candidate.track.width, cast<f32>(thumbHeight));
        if(!IsValidUiRect(candidate.track) || !IsValidUiRect(candidate.thumb))
            return makeUnexpected(Failure());
    }
    if(candidate.contentClip.width > 0.0f && candidate.contentClip.height > 0.0f && rowCount > 0u){
        const f64 clippedTop = cast<f64>(candidate.contentClip.y) - cast<f64>(candidate.viewport.y);
        const f64 startPos = candidate.offset + clippedTop;
        const f64 endPos = startPos + cast<f64>(candidate.contentClip.height);
        f64 clampedStart = 0.0;
        if(startPos > 0.0)
            clampedStart = startPos;
        f64 clampedEnd = 0.0;
        if(endPos > 0.0)
            clampedEnd = endPos;
        const f64 rowHeightF64 = cast<f64>(rowHeight);
        const f64 firstRow = floor(clampedStart / rowHeightF64);
        const f64 endRow = ceil(clampedEnd / rowHeightF64);
        const f64 rowCountF64 = cast<f64>(rowCount);
        if(firstRow >= rowCountF64)
            candidate.firstRow = rowCount;
        else if(firstRow <= 0.0)
            candidate.firstRow = 0u;
        else
            candidate.firstRow = cast<u64>(firstRow);
        u64 boundedEnd = 0u;
        if(endRow >= rowCountF64)
            boundedEnd = rowCount;
        else if(endRow <= 0.0)
            boundedEnd = 0u;
        else
            boundedEnd = cast<u64>(endRow);
        candidate.endRow = max(candidate.firstRow, boundedEnd);
    }
    return candidate;
}

Expected<Rect> CalculateScrollRowBounds(in u64 index, in ScrollPlacement placement, in f32 rowHeight){
    if(
        index < placement.firstRow || index >= placement.endRow || index >= placement.rowCount
        || !IsValidUiRect(placement.viewport)
        || !isFinite(placement.offset) || placement.offset < 0.0
        || !isFinite(rowHeight) || rowHeight <= 0.0f
    )
        return makeUnexpected(Failure());
    const f64 y = (cast<f64>(index) * cast<f64>(rowHeight) - placement.offset) + cast<f64>(placement.viewport.y);
    if(!isFinite(y) || y < -s_UiMaxFloatF64 || y > s_UiMaxFloatF64)
        return makeUnexpected(Failure());
    const Rect candidate(placement.viewport.x, cast<f32>(y), placement.viewport.width, rowHeight);
    if(!IsValidUiRect(candidate))
        return makeUnexpected(Failure());
    return candidate;
}

b8 IsValidScrollbarPlacement(in ScrollbarPlacement bar, in ScrollAxis axis){
    if(
        !isFinite(bar.track.x)
        || !isFinite(bar.track.y)
        || !isFinite(bar.track.width)
        || !isFinite(bar.track.height)
        || !isFinite(bar.thumb.x)
        || !isFinite(bar.thumb.y)
        || !isFinite(bar.thumb.width)
        || !isFinite(bar.thumb.height)
        || !isFinite(bar.contentExtent)
        || !isFinite(bar.viewportExtent)
        || !isFinite(bar.maximum)
        || !isFinite(bar.offset)
    )
        return false;
    const f32 trackX = bar.track.x;
    const f32 trackY = bar.track.y;
    const f32 trackWidth = bar.track.width;
    const f32 trackHeight = bar.track.height;
    const f32 thumbX = bar.thumb.x;
    const f32 thumbY = bar.thumb.y;
    const f32 thumbWidth = bar.thumb.width;
    const f32 thumbHeight = bar.thumb.height;
    if(bar.contentExtent < 0.0 || bar.viewportExtent < 0.0)
        return false;
    const f64 expectedMaximum = max(0.0, bar.contentExtent - bar.viewportExtent);
    const f32 trackRight = trackX + trackWidth;
    const f32 trackBottom = trackY + trackHeight;
    const f32 thumbRight = thumbX + thumbWidth;
    const f32 thumbBottom = thumbY + thumbHeight;
    if(
        trackWidth < 0.0f || trackHeight < 0.0f || thumbWidth < 0.0f || thumbHeight < 0.0f
        || !isFinite(trackRight) || !isFinite(trackBottom) || !isFinite(thumbRight) || !isFinite(thumbBottom)
        || bar.maximum != expectedMaximum
        || bar.offset < 0.0 || bar.offset > bar.maximum
        || (bar.viewportExtent > 0.0 && bar.maximum > 0.0 && bar.maximum >= bar.contentExtent)
    )
        return false;
    if(!bar.visible)
        return trackX == 0.0f && trackY == 0.0f && trackWidth == 0.0f && trackHeight == 0.0f && thumbX == 0.0f && thumbY == 0.0f && thumbWidth == 0.0f && thumbHeight == 0.0f;
    if(bar.maximum <= 0.0 || trackWidth <= 0.0f || trackHeight <= 0.0f)
        return false;
    if(axis == ScrollAxis::Horizontal)
        return bar.viewportExtent == cast<f64>(trackWidth) && thumbY == trackY && thumbHeight == trackHeight && thumbX >= trackX && thumbWidth <= trackWidth && thumbRight <= trackRight;
    return bar.viewportExtent == cast<f64>(trackHeight) && thumbX == trackX && thumbWidth == trackWidth && thumbY >= trackY && thumbHeight <= trackHeight && thumbBottom <= trackBottom;
}

Expected<MovedScrollbarThumb> TryMoveScrollbarThumb(in f64 offset, in f64 maximum, in f32 trackOrigin, in f32 trackLength, in f32 thumbLength, in b8 visible){
    MovedScrollbarThumb outMoved;
    const f64 acceptedOffset = min(offset, maximum);
    if(!visible){
        outMoved.offset = acceptedOffset;
        outMoved.origin = 0.0f;
        return outMoved;
    }
    const f64 travel = max(0.0, cast<f64>(trackLength) - cast<f64>(thumbLength));
    const f64 position = cast<f64>(trackOrigin) + travel * (acceptedOffset / maximum);
    if(!isFinite(position) || position < -s_UiMaxFloatF64 || position > s_UiMaxFloatF64)
        return makeUnexpected(Failure());
    const f32 first = trackOrigin;
    const f32 last = max(first, (first + trackLength) - thumbLength);
    const f32 positionSingle = cast<f32>(position);
    f32 origin = first;
    if(positionSingle > first)
        origin = min(last, positionSingle);
    outMoved.offset = acceptedOffset;
    outMoved.origin = origin;
    return outMoved;
}

b8 TryStoreScrollbarOffset(in f64 offset, in ScrollAxis axis, mut ScrollbarPlacement bar){
    f32 trackOrigin = bar.track.y;
    f32 trackLength = bar.track.height;
    f32 thumbLength = bar.thumb.height;
    if(axis == ScrollAxis::Horizontal){
        trackOrigin = bar.track.x;
        trackLength = bar.track.width;
        thumbLength = bar.thumb.width;
    }
    const Expected<MovedScrollbarThumb> values = TryMoveScrollbarThumb(offset, bar.maximum, trackOrigin, trackLength, thumbLength, bar.visible);
    if(!values.has_value())
        return false;
    bar.offset = values.value().offset;
    if(bar.visible){
        if(axis == ScrollAxis::Horizontal)
            bar.thumb.x = values.value().origin;
        else
            bar.thumb.y = values.value().origin;
    }
    return !bar.visible || IsValidScrollbarPlacement(bar, axis);
}

Expected<ScrollbarPlacement> TryBuildScrollbarPlacement(in f64 contentExtent, in f64 viewportExtent, in Rect track, in f32 minThumb, in f64 offset, in ScrollAxis axis){
    ScrollbarPlacement candidate;
    candidate.contentExtent = contentExtent;
    candidate.viewportExtent = viewportExtent;
    candidate.maximum = max(0.0, contentExtent - viewportExtent);
    if(!isFinite(candidate.maximum) || (viewportExtent > 0.0 && candidate.maximum > 0.0 && candidate.maximum >= contentExtent))
        return makeUnexpected(Failure());
    candidate.visible = track.width > 0.0f && track.height > 0.0f;
    if(candidate.visible){
        if(candidate.maximum <= 0.0)
            return makeUnexpected(Failure());
        candidate.track = track;
        f64 length = cast<f64>(track.height);
        if(axis == ScrollAxis::Horizontal)
            length = cast<f64>(track.width);
        const f64 proportional = length * (viewportExtent / contentExtent);
        const f64 minimum = min(cast<f64>(minThumb), length);
        f64 clampedThumb = minimum;
        if(proportional > minimum)
            clampedThumb = min(length, proportional);
        const f32 thumbExtent = cast<f32>(clampedThumb);
        candidate.thumb = track;
        if(axis == ScrollAxis::Horizontal)
            candidate.thumb.width = min(thumbExtent, track.width);
        else
            candidate.thumb.height = min(thumbExtent, track.height);
    }
    if(!TryStoreScrollbarOffset(offset, axis, candidate) || !IsValidScrollbarPlacement(candidate, axis))
        return makeUnexpected(Failure());
    return candidate;
}

// Resolve coupled bar visibility in logical coordinates.
Expected<ScrollViewportPlacement> CalculateScrollViewportPlacement(in Rect bounds, in Rect clip, in Insets padding, in Point contentMeasure, in f32 caretWidth, in Point previousScroll, in f32 thickness, in f32 minThumb){
    if(
        !IsValidUiRect(bounds) || !IsValidUiRect(clip) || !IsValidUiPadding(padding)
        || !IsValidUiExtent(contentMeasure) || !IsValidUiExtent(previousScroll)
        || !isFinite(caretWidth) || caretWidth <= 0.0f
        || !isFinite(thickness) || thickness < 0.0f || !isFinite(minThumb) || minThumb < 0.0f
    )
        return makeUnexpected(Failure());
    const Expected<Rect> paddedOpt = TryInsetUiRect(bounds, padding, UiRectPrecision::RoundedEndpoints);
    if(!paddedOpt.has_value())
        return makeUnexpected(Failure());
    const Rect padded = paddedOpt.value();
    const f64 availableWidth = cast<f64>(padded.width);
    const f64 availableHeight = cast<f64>(padded.height);
    const f64 thicknessF64 = cast<f64>(thickness);
    f64 verticalWidth = availableWidth;
    if(thicknessF64 < availableWidth)
        verticalWidth = thicknessF64;
    f64 horizontalHeight = availableHeight;
    if(thicknessF64 < availableHeight)
        horizontalHeight = thicknessF64;
    const f64 contentWidth = cast<f64>(contentMeasure.x) + cast<f64>(caretWidth);
    const f64 contentHeight = cast<f64>(contentMeasure.y);
    if(!isFinite(contentWidth))
        return makeUnexpected(Failure());
    b8 horizontal = false;
    b8 vertical = false;
    for(u32 iteration = 0u; iteration < s_ScrollbarReservationPassLimit; ++iteration){
        f64 reservedWidth = 0.0;
        if(vertical)
            reservedWidth = verticalWidth;
        f64 reservedHeight = 0.0;
        if(horizontal)
            reservedHeight = horizontalHeight;
        const f64 viewportWidth = cast<f64>(cast<f32>(availableWidth - reservedWidth));
        const f64 viewportHeight = cast<f64>(cast<f32>(availableHeight - reservedHeight));
        const b8 nextHorizontal = horizontal || (horizontalHeight > 0.0 && availableWidth > 0.0 && contentWidth > viewportWidth);
        const b8 nextVertical = vertical || (verticalWidth > 0.0 && availableHeight > 0.0 && contentHeight > viewportHeight);
        if(nextHorizontal == horizontal && nextVertical == vertical)
            break;
        horizontal = nextHorizontal;
        vertical = nextVertical;
    }
    f64 barWidth = 0.0;
    if(vertical)
        barWidth = verticalWidth;
    f64 barHeight = 0.0;
    if(horizontal)
        barHeight = horizontalHeight;
    ScrollViewportPlacement candidate;
    const f64 paddedX = cast<f64>(padded.x);
    const f64 paddedY = cast<f64>(padded.y);
    const Expected<Rect> viewportRect = TryMakeUiRect(paddedX, paddedY, availableWidth - barWidth, availableHeight - barHeight, UiRectPrecision::RoundedEndpoints);
    if(!viewportRect.has_value())
        return makeUnexpected(Failure());
    candidate.viewport = viewportRect.value();
    if((barWidth > 0.0 && candidate.viewport.width >= padded.width) || (barHeight > 0.0 && candidate.viewport.height >= padded.height))
        return makeUnexpected(Failure());
    const Expected<Rect> contentClip = TryIntersectUiRects(candidate.viewport, clip, UiRectPrecision::RoundedEndpoints);
    if(!contentClip.has_value())
        return makeUnexpected(Failure());
    candidate.contentClip = contentClip.value();
    const f64 viewportWidth = cast<f64>(candidate.viewport.width);
    const f64 viewportHeight = cast<f64>(candidate.viewport.height);
    const f64 cornerX = paddedX + viewportWidth;
    const f64 cornerY = paddedY + viewportHeight;
    Rect horizontalTrack;
    Rect verticalTrack;
    if(horizontal && viewportWidth > 0.0 && barHeight > 0.0){
        const Expected<Rect> hTrack = TryMakeUiRect(paddedX, cornerY, viewportWidth, barHeight, UiRectPrecision::RoundedEndpoints);
        if(!hTrack.has_value())
            return makeUnexpected(Failure());
        horizontalTrack = hTrack.value();
    }
    if(vertical && viewportHeight > 0.0 && barWidth > 0.0){
        const Expected<Rect> vTrack = TryMakeUiRect(cornerX, paddedY, barWidth, viewportHeight, UiRectPrecision::RoundedEndpoints);
        if(!vTrack.has_value())
            return makeUnexpected(Failure());
        verticalTrack = vTrack.value();
    }
    if(barWidth > 0.0 && barHeight > 0.0){
        const Expected<Rect> corner = TryMakeUiRect(cornerX, cornerY, barWidth, barHeight, UiRectPrecision::RoundedEndpoints);
        if(!corner.has_value())
            return makeUnexpected(Failure());
        candidate.corner = corner.value();
    }
    const Expected<ScrollbarPlacement> hPlacement = TryBuildScrollbarPlacement(contentWidth, viewportWidth, horizontalTrack, minThumb, cast<f64>(previousScroll.x), ScrollAxis::Horizontal);
    if(!hPlacement.has_value())
        return makeUnexpected(Failure());
    candidate.horizontal = hPlacement.value();
    const Expected<ScrollbarPlacement> vPlacement = TryBuildScrollbarPlacement(contentHeight, viewportHeight, verticalTrack, minThumb, cast<f64>(previousScroll.y), ScrollAxis::Vertical);
    if(!vPlacement.has_value())
        return makeUnexpected(Failure());
    candidate.vertical = vPlacement.value();
    return candidate;
}

b8 TryUpdateScrollViewportOffsets(in Point scroll, mut ScrollViewportPlacement placement){
    if(
        !IsValidUiExtent(scroll) || !IsValidUiRect(placement.viewport) || !IsValidUiRect(placement.contentClip) || !IsValidUiRect(placement.corner)
        || placement.horizontal.viewportExtent != cast<f64>(placement.viewport.width)
        || placement.vertical.viewportExtent != cast<f64>(placement.viewport.height)
        || !IsValidScrollbarPlacement(placement.horizontal, ScrollAxis::Horizontal)
        || !IsValidScrollbarPlacement(placement.vertical, ScrollAxis::Vertical)
    )
        return false;
    ScrollViewportPlacement candidate = placement;
    if(!TryStoreScrollbarOffset(cast<f64>(scroll.x), ScrollAxis::Horizontal, candidate.horizontal) || !TryStoreScrollbarOffset(cast<f64>(scroll.y), ScrollAxis::Vertical, candidate.vertical))
        return false;
    placement = candidate;
    return true;
}

Expected<f32> TryStepScrollbarOffset(in f64 offset, in f64 delta, in f64 step, in f64 maximum){
    if(!isFinite(offset) || !isFinite(delta) || !isFinite(step) || step < 0.0 || !isFinite(maximum) || maximum < 0.0)
        return makeUnexpected(Failure());
    f64 next = 0.0;
    if(offset > 0.0)
        next = min(maximum, offset);
    if(step > 0.0 && delta > 0.0){
        const f64 distanceInSteps = (maximum - next) / step;
        if(delta >= distanceInSteps)
            next = maximum;
        else
            next = next + (delta * step);
    }
    else if(step > 0.0 && delta < 0.0){
        const f64 distanceInSteps = next / step;
        if((-delta) >= distanceInSteps)
            next = 0.0;
        else
            next = next + (delta * step);
    }
    if(!isFinite(next) || next > s_UiMaxFloatF64)
        return makeUnexpected(Failure());
    return cast<f32>(next);
}

Expected<f32> TryDragScrollbarOffset(in PointerGesture gesture, in b8 horizontal){
    f64 currentTarget = cast<f64>(gesture.targetRectangle.y);
    f64 currentPointer = cast<f64>(gesture.position.y);
    f64 referenceTarget = cast<f64>(gesture.referenceRectangle.y);
    f64 referencePointer = cast<f64>(gesture.origin.y);
    f64 referenceExtent = cast<f64>(gesture.referenceRectangle.height);
    f64 targetExtent = cast<f64>(gesture.targetRectangle.height);
    if(horizontal){
        currentTarget = cast<f64>(gesture.targetRectangle.x);
        currentPointer = cast<f64>(gesture.position.x);
        referenceTarget = cast<f64>(gesture.referenceRectangle.x);
        referencePointer = cast<f64>(gesture.origin.x);
        referenceExtent = cast<f64>(gesture.referenceRectangle.width);
        targetExtent = cast<f64>(gesture.targetRectangle.width);
    }
    const f64 startDelta = currentTarget - referenceTarget;
    const f64 pointerDelta = currentPointer - referencePointer;
    const f64 travel = referenceExtent - targetExtent;
    const f64 maximum = gesture.maximum;
    if(!isFinite(travel) || travel <= 0.0 || !isFinite(startDelta) || !isFinite(pointerDelta) || !isFinite(maximum) || maximum < 0.0)
        return makeUnexpected(Failure());
    const f64 normalized = (startDelta + pointerDelta) / travel;
    f64 clamped = 0.0;
    if(normalized > 0.0)
        clamped = min(1.0, normalized);
    const f64 next = clamped * maximum;
    if(!isFinite(next) || next > s_UiMaxFloatF64)
        return makeUnexpected(Failure());
    return cast<f32>(next);
}

Name ResolveScrollbarThumbRegionName(in ScrollbarStyle style, in b8 enabled, in b8 pressed, in b8 hovered){
    if(!enabled)
        return style.thumbDisabled;
    if(pressed)
        return style.thumbPressed;
    if(hovered)
        return style.thumbHover;
    return style.thumb;
}

void ResolveScrollbarBeforeAfterRects(
    in ScrollbarPlacement bar,
    in b8 horizontal,
    mut Rect outBeforeRect,
    mut Rect outAfterRect
){
    f32 start = bar.track.y;
    f32 thumbStart = bar.thumb.y;
    f32 trackExtent = bar.track.height;
    f32 thumbExtent = bar.thumb.height;
    if(horizontal){
        start = bar.track.x;
        thumbStart = bar.thumb.x;
        trackExtent = bar.track.width;
        thumbExtent = bar.thumb.width;
    }
    const f32 before = max(0.0f, thumbStart - start);
    const f32 after = max(0.0f, ((start + trackExtent) - thumbStart) - thumbExtent);
    outBeforeRect = bar.track;
    outAfterRect = bar.track;
    if(horizontal){
        outBeforeRect.width = before;
        outAfterRect.x = thumbStart + thumbExtent;
        outAfterRect.width = after;
    }
    else{
        outBeforeRect.height = before;
        outAfterRect.y = thumbStart + thumbExtent;
        outAfterRect.height = after;
    }
}

b8 TryApplyTextAreaScrollControlAction(
    in ControlAction action,
    in ScrollViewportPlacement accepted,
    mut Point inOutScroll,
    mut b8 inOutManual
){
    Point next = inOutScroll;
    if(action.kind == ControlActionKind::Wheel){
        const Expected<f32> nextX = TryStepScrollbarOffset(cast<f64>(inOutScroll.x), action.deltaX, action.stepX, action.maximumX);
        const Expected<f32> nextY = TryStepScrollbarOffset(cast<f64>(inOutScroll.y), -action.delta, action.step, action.maximum);
        if(!nextX.has_value() || !nextY.has_value())
            return false;
        next.x = nextX.value();
        next.y = nextY.value();
        inOutManual = true;
    }
    else if(
        action.kind == ControlActionKind::Activate
        && action.value >= cast<u64>(s_TextAreaScrollHorizontalBefore)
        && action.value <= cast<u64>(s_TextAreaScrollVerticalAfter)
    ){
        const b8 x = action.value <= cast<u64>(s_TextAreaScrollHorizontalAfter);
        f64 direction = 1.0;
        if(action.value == cast<u64>(s_TextAreaScrollHorizontalBefore) || action.value == cast<u64>(s_TextAreaScrollVerticalBefore))
            direction = -1.0;
        ScrollbarPlacement bar = accepted.vertical;
        f64 currentOffset = cast<f64>(inOutScroll.y);
        if(x){
            bar = accepted.horizontal;
            currentOffset = cast<f64>(inOutScroll.x);
        }
        const Expected<f32> stepped = TryStepScrollbarOffset(currentOffset, direction, bar.viewportExtent, bar.maximum);
        if(!stepped.has_value())
            return false;
        if(x)
            next.x = stepped.value();
        else
            next.y = stepped.value();
        inOutManual = true;
    }
    inOutScroll = next;
    return true;
}

Expected<Point> TryResolveTextAreaScrollStep(in f32 fontSize, in f32 lineHeight, in f32 wheelLines){
    const Point step(fontSize * wheelLines, lineHeight * wheelLines);
    if(!isFinite(step.x) || !isFinite(step.y) || step.x <= 0.0f || step.y <= 0.0f)
        return makeUnexpected(Failure());
    return step;
}

void ReconcileTextAreaVisualScrollState(
    in u64 modelGeneration,
    in u64 modelRevision,
    in u64 modelSelectionGeneration,
    in u64 modelCompositionGeneration,
    in usize modelAnchor,
    in usize modelCaret,
    in b8 resultFocused,
    in WidgetId captureId,
    in WidgetId widgetId,
    in u64 stateCompositionGeneration,
    in u64 visualModelGeneration,
    in u64 visualRevision,
    in u64 visualSelectionGeneration,
    in usize visualAnchor,
    in usize visualCaret,
    in b8 visualFocused,
    mut f32 inOutVisualScroll,
    mut f32 inOutScrollY,
    mut b8 inOutRevealCaret,
    mut f64 inOutCaretElapsed,
    mut b8 outFirstBinding
){
    outFirstBinding = visualModelGeneration == 0u;
    const b8 rebound = !outFirstBinding && visualModelGeneration != modelGeneration;
    if(rebound){
        inOutVisualScroll = 0.0f;
        inOutScrollY = 0.0f;
        inOutRevealCaret = true;
    }
    else if(
        !outFirstBinding && (
            visualRevision != modelRevision
            || visualSelectionGeneration != modelSelectionGeneration
            || stateCompositionGeneration != modelCompositionGeneration
            || visualAnchor != modelAnchor
            || visualCaret != modelCaret
            || (!visualFocused && resultFocused && (!captureId.valid() || captureId == widgetId))
        )
    )
        inOutRevealCaret = true;
    if(!outFirstBinding && stateCompositionGeneration != modelCompositionGeneration)
        inOutCaretElapsed = 0.0;
}


