[serialize, reflect]
class MeshSkinningRestToSkinnedCopyByteCounts{
    public usize positionBytes = 0u;
    public usize normalBytes = 0u;
    public usize tangentBytes = 0u;
}

Array<u32, 2u> PackSkinInfluenceJoints(in SkinInfluence4 sourceSkin){
    Array<u32, 2u> packed;
    for(u32 wordIndex = 0u; wordIndex < s_SkinJointWordCount; ++wordIndex){
        const u32 influenceIndex = wordIndex * 2u;
        packed[wordIndex] = cast<u32>(sourceSkin.joint[influenceIndex]) | (cast<u32>(sourceSkin.joint[influenceIndex + 1u]) << s_SkinJointBits);
    }
    return packed;
}

b8 TryResolveMeshSkinningRestToSkinnedCopyByteCounts(in usize positionCount, in usize normalCount, in usize tangentCount, mut MeshSkinningRestToSkinnedCopyByteCounts outCounts){
    outCounts = MeshSkinningRestToSkinnedCopyByteCounts();
    if(positionCount == 0u || normalCount == 0u || tangentCount == 0u)
        return false;
    const usize positionBytes = positionCount * s_SkinRestPositionElementBytes;
    if(positionBytes / s_SkinRestPositionElementBytes != positionCount)
        return false;
    const usize normalBytes = normalCount * s_SkinRestNormalElementBytes;
    if(normalBytes / s_SkinRestNormalElementBytes != normalCount)
        return false;
    const usize tangentBytes = tangentCount * s_SkinRestTangentElementBytes;
    if(tangentBytes / s_SkinRestTangentElementBytes != tangentCount)
        return false;
    outCounts.positionBytes = positionBytes;
    outCounts.normalBytes = normalBytes;
    outCounts.tangentBytes = tangentBytes;
    return true;
}

Name DeriveRuntimeResourceName(in Name sourceName, in u64 ownerId, in u32 editRevision, in StringView label){
    Name outName = s_NameNone;
    if(sourceName == s_NameNone || label.empty())
        return outName;
    native(in sourceName, in ownerId, in editRevision, in label, mut outName){
        Array<char, s_DecimalTextBufferBytes> ownerBuffer;
        Array<char, s_DecimalTextBufferBytes> revisionBuffer;
        const AStringView ownerText = FormatDecimal(static_cast<usize>(ownerId), ownerBuffer);
        const AStringView revisionText = FormatDecimal(static_cast<usize>(editRevision), revisionBuffer);
        if(!ownerText.empty() && !revisionText.empty()){
            if(auto derivedHash = BeginDerivedNameHash(sourceName)){
                if(
                    UpdateDerivedNameHashText(*derivedHash, s_RuntimePrefix)
                    && UpdateDerivedNameHashText(*derivedHash, ownerText)
                    && UpdateDerivedNameHashText(*derivedHash, s_RevisionSeparator)
                    && UpdateDerivedNameHashText(*derivedHash, revisionText)
                    && UpdateDerivedNameHashText(*derivedHash, s_OwnerSeparator)
                    && UpdateDerivedNameHashText(*derivedHash, label)
                ){
                    if(const auto finished = FinishDerivedNameHash(*derivedHash))
                        outName = *finished;
                }
            }
        }
    }
    return outName;
}


