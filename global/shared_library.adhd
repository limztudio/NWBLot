[cpp_header("<global/shared_library.h>"), cpp_name("::SharedLibrary"), cpp_layout(8, 8), cpp_flags(self_defaulted, brace_init, no_copy, no_assign)]
extern class SharedLibrary{
    void close(...);
    b8 isOpen(...)const;
};

[cpp_header("<global/shared_library.h>"), cpp_name("::SharedLibraryFailure"), cpp_layout(2072, 8), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class SharedLibraryFailure{
    ErrorCode code;
    DiagnosticEventText detail;
    b8 detailTruncated;
};


