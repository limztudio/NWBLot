////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


HitTarget MakeHorizontalNavigationPart(in HitTarget host){
    HitTarget part = HitTarget();
    part.id.value = 4u;
    part.declarationGeneration = host.declarationGeneration;
    part.rectangle.x = 20.0f;
    part.rectangle.y = 20.0f;
    part.rectangle.width = 60.0f;
    part.rectangle.height = 20.0f;
    part.clip = host.clip;
    part.paintOrder = 1u;
    part.activatable = true;
    part.control = host.control;
    part.owner = host.id;
    part.ownerDeclarationGeneration = host.declarationGeneration;
    part.value = 91u;
    part.popup = host.popup;
    part.layer = host.layer;
    return part;
}

PopupScope MakeHorizontalNavigationPopup(in HitTarget owner, in u64 openGeneration){
    PopupScope popup = PopupScope();
    popup.token.widget = owner.id;
    popup.token.declarationGeneration = owner.declarationGeneration;
    popup.token.instanceGeneration = 6u;
    popup.token.openGeneration = openGeneration;
    popup.bounds.x = 0.0f;
    popup.bounds.y = 0.0f;
    popup.bounds.width = 300.0f;
    popup.bounds.height = 200.0f;
    popup.viewport = popup.bounds;
    popup.layer = 1u;
    return popup;
}

void ExpectUiEditBoxPlacement(in EditBoxPlacement actual, in EditBoxPlacement expected){
    ExpectUiRect(actual.bounds, expected.bounds);
    ExpectUiRect(actual.frameClip, expected.frameClip);
    ExpectUiRect(actual.content, expected.content);
    ExpectUiRect(actual.clip, expected.clip);
    ExpectUiRect(actual.caret, expected.caret);
    EXPECT_FLOAT_EQ(actual.textOrigin.x, expected.textOrigin.x);
    EXPECT_FLOAT_EQ(actual.textOrigin.y, expected.textOrigin.y);
    EXPECT_FLOAT_EQ(actual.scroll, expected.scroll);
    EXPECT_FLOAT_EQ(actual.scrollY, expected.scrollY);
}

void ExpectUiEditCaretRect(in Rect rectangle, in f32 x, in f32 y, in f32 height){
    EXPECT_FLOAT_EQ(rectangle.x, x);
    EXPECT_FLOAT_EQ(rectangle.y, y);
    EXPECT_FLOAT_EQ(rectangle.width, 0.0f);
    EXPECT_FLOAT_EQ(rectangle.height, height);
}


