void VerifyModelPayload_RevalidatesReplacedObjectsAndRecoversAfterRejection(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, s_BreakOnFatal);
    ModelInputs inputs = ModelInputs();

    ASSERT_TRUE(inputs.validate());
    inputs.skeletonObjects[0u].name = Name(s_ModelPayloadReplacementRig);
    inputs.publish();
    EXPECT_FALSE(inputs.validate());

    inputs.staticMeshObjects[0u].parentObject = Name(s_ModelPayloadReplacementRig);
    inputs.skinnedMeshObjects[0u].skeletonObject = Name(s_ModelPayloadReplacementRig);
    inputs.publish();
    EXPECT_TRUE(inputs.validate());

    inputs.skinnedMeshObjects[0u].name = Name(s_ModelPayloadProp);
    inputs.publish();
    EXPECT_FALSE(inputs.validate());

    inputs.skinnedMeshObjects.clear();
    inputs.publish();
    EXPECT_TRUE(inputs.validate());
}

void VerifyModelPayload_SingleObjectValidationDoesNotAllocateOrResolveItselfAsASkeleton(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, s_BreakOnFatal);
    ModelInputs inputs = ModelInputs();

    inputs.skeletonObjects.clear();
    inputs.skinnedMeshObjects.clear();
    inputs.publish();
    EXPECT_FALSE(inputs.validate());

    inputs.staticMeshObjects[0u].parentObject = inputs.staticMeshObjects[0u].name;
    inputs.publish();
    EXPECT_FALSE(inputs.validate());

    inputs.staticMeshObjects[0u].parentObject = s_NameNone;
    inputs.staticMeshObjects[0u].parentJoint = s_NameNone;
    inputs.publish();
    EXPECT_TRUE(inputs.validate());
    EXPECT_EQ(inputs.scratchStats().allocationCount, 0u);
}

void VerifyModelPayload_RepeatedValidationReclaimsCallerScratchAfterSuccessAndRejection(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, s_BreakOnFatal);
    ModelInputs inputs = ModelInputs();

    ASSERT_TRUE(inputs.validate());
    const ArenaMemoryStats warm = inputs.scratchStats();
    for(usize iteration = 0u; iteration < 16u; ++iteration){
        const b8 valid = iteration % 2u == 0u;
        if(valid)
            inputs.skinnedMeshObjects[0u].name = Name(s_ModelBodySegment);
        else
            inputs.skinnedMeshObjects[0u].name = Name(s_ModelPayloadProp);
        inputs.publish();
        EXPECT_EQ(inputs.validate(), valid);
        const ArenaMemoryStats current = inputs.scratchStats();
        EXPECT_EQ(current.usedBytes, warm.usedBytes);
        EXPECT_EQ(current.reservedBytes, warm.reservedBytes);
    }
}

void VerifyModelPayload_CodecRejectsDuplicateNamesAndWrongParentsAndReloadsValidPayload(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, s_BreakOnFatal);
    ModelInputs inputs = ModelInputs();

    ModelAssetCodec codec = ModelAssetCodec();
    AssetBytes binary = MakeModelInputsBytes(inputs);
    ASSERT_TRUE(SerializeModelAsset(codec, inputs.model, binary));
    ModelAsset loaded = MakeLoadedModelFromInputs(inputs);
    ASSERT_TRUE(LoadModelAssetBinary(loaded, binary));

    AssetBytes malformed = MakeModelInputsBytes(inputs);
    CopyAssetBytes(binary, malformed);
    CorruptModelBinarySkinnedName(Name(s_ModelPayloadProp), malformed);
    EXPECT_FALSE(LoadModelAssetBinary(loaded, malformed));
    EXPECT_TRUE(LoadModelAssetBinary(loaded, binary));

    CopyAssetBytes(binary, malformed);
    CorruptModelBinaryStaticParent(Name(s_ModelBodySegment), malformed);
    EXPECT_FALSE(LoadModelAssetBinary(loaded, malformed));
    EXPECT_TRUE(LoadModelAssetBinary(loaded, binary));

    inputs.skinnedMeshObjects[0u].name = Name(s_ModelRigSegment);
    inputs.publish();
    EXPECT_FALSE(SerializeModelAsset(codec, inputs.model, malformed));
    EXPECT_TRUE(loaded.validatePayload(inputs.scratchArena));
}

void VerifyModelPayload_CodecRejectsPreviousSchemaAndTruncatedSkinnedRecordAndReloadsCurrentPayload(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration(logger, s_BreakOnFatal);
    ModelInputs inputs = ModelInputs();

    ModelAssetCodec codec = ModelAssetCodec();
    AssetBytes binary = MakeModelInputsBytes(inputs);
    ASSERT_TRUE(SerializeModelAsset(codec, inputs.model, binary));
    ASSERT_EQ(binary.size(), ExpectedSingleTripleModelBinaryBytes());
    ModelAsset loaded = MakeLoadedModelFromInputs(inputs);
    ASSERT_TRUE(LoadModelAssetBinary(loaded, binary));

    AssetBytes malformed = MakeModelInputsBytes(inputs);
    CopyAssetBytes(binary, malformed);
    ASSERT_TRUE(OverwriteU32InAssetBytes(0u, 0x4D444C31u, malformed));
    EXPECT_FALSE(LoadModelAssetBinary(loaded, malformed));
    AssetBytes retained = MakeModelInputsBytes(inputs);
    ASSERT_TRUE(SerializeModelAsset(codec, loaded, retained));
    EXPECT_EQ(retained, binary);
    ASSERT_TRUE(LoadModelAssetBinary(loaded, binary));

    CopyAssetBytes(binary, malformed);
    malformed.pop_back();
    EXPECT_FALSE(LoadModelAssetBinary(loaded, malformed));
    ASSERT_TRUE(SerializeModelAsset(codec, loaded, retained));
    EXPECT_EQ(retained, binary);
    ASSERT_TRUE(LoadModelAssetBinary(loaded, binary));
    ASSERT_EQ(loaded.skinnedMeshObjects().size(), 1u);
    EXPECT_EQ(loaded.skinnedMeshObjects()[0u].skin.name(), inputs.skinnedMeshObjects[0u].skin.name());
    EXPECT_EQ(loaded.skinnedMeshObjects()[0u].skeletonObject, Name(s_ModelRigSegment));
    EXPECT_EQ(logger.errorCount(), 2u);
}


