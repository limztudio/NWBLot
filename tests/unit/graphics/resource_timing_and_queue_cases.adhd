void GpuTimingSubscriptionCapture::Invoke(void* const context, const Core::GpuTimingSample&)noexcept{
    GpuTimingSubscriptionCapture* const capture = static_cast<GpuTimingSubscriptionCapture*>(context);
    if(!capture)
        return;

    ++capture->sampleCount;
}

Core::GpuTimingSampleListener MakeSubscriptionListener(GpuTimingSubscriptionCapture& capture)noexcept{
    return Core::GpuTimingSampleListener{
        .context = &capture,
        .invoke = &GpuTimingSubscriptionCapture::Invoke,
    };
}

Expected<Name> DeriveIndexedScopeName(const Name& prefix, const usize scopeIndex)noexcept{
    Array<char, 32u> scopeIndexBuffer = {};
    return DeriveName(prefix, FormatDecimal(scopeIndex, scopeIndexBuffer));
}


