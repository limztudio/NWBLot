#include <impl/assets_font_atlas/asset.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 FontAtlas::loadBinary(in Span<u8> binary){
    if(!this.checkVirtualPath("FontAtlas::loadBinary"))
        return false;
    ScratchArena scratchArena(s_AssetsFontAtlasLoadBinaryArena);
    FontAtlas candidate(this.virtualPath());
    if(!DeserializeFontAtlasBinaryInto(binary, candidate.m_payload, scratchArena)){
        LogFontAtlasBinaryDeserializeFailed();
        return false;
    }
    this = candidate;
    return true;
}

b8 FontAtlas::validatePayload(mut ScratchArena scratchArena)const{
    return this.checkVirtualPath(s_FontAtlasValidatePayloadContext) && ValidateFontAtlasPayload(this.m_payload, scratchArena);
}


