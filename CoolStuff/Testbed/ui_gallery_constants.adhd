// Default skin regions drawn by more than one sample.
const Name s_ButtonNormal = "button.normal";
const Name s_ComboArrow = "combo.arrow";

[reflect]
enum<u32> Section{
    Controls,
    Edit,
    List,
    Combo,
    SearchCombo,
    PopupTools,
    NestedPopup,
    NumericEdit,
    TextArea,
    RadioGroup,
    Slider,
    Progress,
    Image,
    kCount
}

StringView SectionName(in Section section){
    switch(section){
        case Section::Controls: return "Controls and menu";
        case Section::Edit: return "Text editing";
        case Section::List: return "Virtual list";
        case Section::Combo: return "Keyed combo";
        case Section::SearchCombo: return "Searchable combo";
        case Section::PopupTools: return "Tooltips and context menu";
        case Section::NestedPopup: return "Nested popups";
        case Section::NumericEdit: return "Numeric editing";
        case Section::TextArea: return "Multiline text";
        case Section::RadioGroup: return "Radio choices";
        case Section::Slider: return "Slider";
        case Section::Progress: return "Progress";
        case Section::Image: return "Images";
        case Section::kCount: return "";
    }
    return "";
}

