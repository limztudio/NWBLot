        this.m_returnStateCandidate = GpuPersistentStateCandidate(renderer.m_causticIrradianceReturnState);
        this.m_scratchStateCandidate = GpuPersistentStateCandidate(renderer.m_causticsComputePersistentState);
    }

    [cpp_unwind]
    public b8 recorded(in Optional<in CommandListResourceStateHandoff> finalState){
        if(this.irradianceTextures.empty() || this.scratchTextures.empty() || !finalState.has_value())
            return false;

        const b8 returnStateReady = this.renderer.m_causticIrradianceReturnState.buildFilteredResourceSubset(finalState.value(), this.irradianceTextures, Span<BufferHandle>(), this.m_returnStateCandidate);
        const b8 scratchStateReady = this.renderer.m_causticsComputePersistentState.buildFilteredResourceSubset(finalState.value(), this.scratchTextures, Span<BufferHandle>(), this.m_scratchStateCandidate);
        this.statePrepared = AreDualPersistentStateSubsetsReady(returnStateReady, scratchStateReady);
        return this.statePrepared;
    }
    public b8 accepted(in QueueSubmissionToken token){
        if(!this.statePrepared)
            return false;

        const b8 returnStateReady = this.renderer.m_causticIrradianceReturnState.commit(this.m_returnStateCandidate);
        const b8 scratchStateReady = this.renderer.m_causticsComputePersistentState.commit(this.m_scratchStateCandidate);
        this.stateReady = AreDualPersistentStateSubsetsReady(returnStateReady, scratchStateReady);
        return this.stateReady;
    }
}

class SurfelGiStateLifecycleContext{
    public mut RendererFramePipeline renderer;
    private GpuPersistentStateCandidate m_returnStateCandidate;
    private GpuPersistentStateCandidate m_counterStateCandidate;
    private GpuPersistentStateCandidate m_computeStateCandidate;
    public Span<TextureHandle> returnTextures;
    public Span<BufferHandle> counterBuffers;
    public Span<TextureHandle> computeTextures;
    public Span<BufferHandle> computeBuffers;
    public b8 statePrepared = false;
    public b8 stateReady = false;

    public SurfelGiStateLifecycleContext(mut RendererFramePipeline renderer){
        this.renderer = renderer;
        this.m_returnStateCandidate = GpuPersistentStateCandidate(renderer.m_surfelIrradianceReturnState);
        this.m_counterStateCandidate = GpuPersistentStateCandidate(renderer.m_surfelGiCounterPersistentState);
        this.m_computeStateCandidate = GpuPersistentStateCandidate(renderer.m_surfelGiComputePersistentState);
    }

    [cpp_unwind]
    public b8 recorded(in Optional<in CommandListResourceStateHandoff> finalState){
        if(this.returnTextures.empty() || this.counterBuffers.empty() || this.computeTextures.empty() || this.computeBuffers.empty() || !finalState.has_value())
            return false;

        const b8 returnStateReady = this.renderer.m_surfelIrradianceReturnState.buildFilteredResourceSubset(finalState.value(), this.returnTextures, Span<BufferHandle>(), this.m_returnStateCandidate);
        const b8 counterStateReady = this.renderer.m_surfelGiCounterPersistentState.buildFilteredResourceSubset(finalState.value(), Span<TextureHandle>(), this.counterBuffers, this.m_counterStateCandidate);
        const b8 computeStateReady = this.renderer.m_surfelGiComputePersistentState.buildFilteredResourceSubset(
            finalState.value(),
            this.computeTextures,
            this.computeBuffers,
            this.m_computeStateCandidate
        );
        this.statePrepared = AreTriplePersistentStateSubsetsReady(returnStateReady, counterStateReady, computeStateReady);
        return this.statePrepared;
    }
    public b8 accepted(in QueueSubmissionToken token){
        if(!this.statePrepared)
            return false;

        mut RendererFramePipeline renderer = this.renderer;
        const b8 returnStateReady = renderer.m_surfelIrradianceReturnState.commit(this.m_returnStateCandidate);
        const b8 counterStateReady = renderer.m_surfelGiCounterPersistentState.commit(this.m_counterStateCandidate);
        const b8 computeStateReady = renderer.m_surfelGiComputePersistentState.commit(this.m_computeStateCandidate);
        this.stateReady = AreTriplePersistentStateSubsetsReady(returnStateReady, counterStateReady, computeStateReady);
        if(this.stateReady)
            renderer.m_raytracingSystem.confirmRayTraceContextReadSubmission(token);
        return this.stateReady;
    }
}

class HardwareCausticsStateLifecycleContext{
    public mut RendererFramePipeline renderer;
    private GpuPersistentStateCandidate m_accumulatorStateCandidate;
    public Span<TextureHandle> accumulatorTextures;
    public b8 statePrepared = false;
