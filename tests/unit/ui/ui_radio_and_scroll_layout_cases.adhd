void VerifyUiRadioGroupLayoutTests_InheritedClipRestrictsEachRowAndItsLabel(){
    const RadioGroupChoices choices = MakeUiRadioGroupLayoutChoices(3u);
    const auto metrics = MeasureRadioGroup(3u, Point(100.0f, 16.0f), RadioGroupOptions(), RadioGroupStyle());
    ASSERT_TRUE(metrics.has_value());
    const auto placement = PlaceRadioGroup(Rect(10.0f, 20.0f, 140.0f, 112.0f), Rect(30.0f, 30.0f, 70.0f, 80.0f), choices, metrics.value());
    ASSERT_TRUE(placement.has_value());
    const RadioGroupPlacement placed = placement.value();
    ExpectUiRect(placed.clip, Rect(30.0f, 30.0f, 70.0f, 80.0f));
    ExpectUiRect(placed.rows[0u].clip, Rect(30.0f, 30.0f, 70.0f, 18.0f));
    ExpectUiRect(placed.rows[0u].textClip, Rect(46.0f, 30.0f, 54.0f, 18.0f));
    ExpectUiRect(placed.rows[2u].clip, Rect(30.0f, 80.0f, 70.0f, 24.0f));
}

void VerifyUiRadioGroupLayoutTests_FullChoiceBoundProducesAllRowsWithoutVirtualization(){
    const RadioGroupChoices choices = MakeUiRadioGroupLayoutChoices(s_RadioGroupMaxChoices);
    const auto metrics = MeasureRadioGroup(choices.count, Point(100.0f, 16.0f), RadioGroupOptions(), RadioGroupStyle());
    ASSERT_TRUE(metrics.has_value());
    EXPECT_FLOAT_EQ(metrics.value().contentSize.y, 1796.0f);
    const auto placement = PlaceRadioGroup(Rect(0.0f, 0.0f, 140.0f, 1796.0f), Rect(0.0f, 0.0f, 140.0f, 1796.0f), choices, metrics.value());
    ASSERT_TRUE(placement.has_value());
    const RadioGroupPlacement placed = placement.value();
    EXPECT_EQ(placed.count, 64u);
    EXPECT_EQ(placed.rows[63u].key, 64u);
    EXPECT_FLOAT_EQ(placed.rows[63u].rectangle.y, 1768.0f);
    EXPECT_FLOAT_EQ(placed.rows[63u].rectangle.height, 24.0f);
}

void VerifyUiRadioGroupLayoutTests_EmptyGroupHasOnlyPaddingAndNoChoiceGeometry(){
    const RadioGroupChoices choices = MakeUiRadioGroupLayoutChoices(0u);
    const auto metrics = MeasureRadioGroup(0u, Point(), RadioGroupOptions(), RadioGroupStyle());
    ASSERT_TRUE(metrics.has_value());
    EXPECT_FLOAT_EQ(metrics.value().contentSize.x, 8.0f);
    EXPECT_FLOAT_EQ(metrics.value().contentSize.y, 8.0f);
    const auto placement = PlaceRadioGroup(Rect(0.0f, 0.0f, 8.0f, 8.0f), Rect(0.0f, 0.0f, 8.0f, 8.0f), choices, metrics.value());
    ASSERT_TRUE(placement.has_value());
    const RadioGroupPlacement placed = placement.value();
    EXPECT_EQ(placed.count, 0u);
    ExpectUiRect(placed.content, Rect(4.0f, 4.0f, 0.0f, 0.0f));
    EXPECT_EQ(placed.rows[0u].key, 0u);
}

void VerifyUiRadioGroupLayoutTests_NarrowBoundsShrinkTheIndicatorAndLeaveAnEmptyLabelArea(){
    const RadioGroupChoices choices = MakeUiRadioGroupLayoutChoices(1u);
    const auto metrics = MeasureRadioGroup(1u, Point(100.0f, 16.0f), RadioGroupOptions(), RadioGroupStyle());
    ASSERT_TRUE(metrics.has_value());
    const auto placement = PlaceRadioGroup(Rect(0.0f, 0.0f, 20.0f, 40.0f), Rect(0.0f, 0.0f, 20.0f, 40.0f), choices, metrics.value());
    ASSERT_TRUE(placement.has_value());
    const RadioGroupPlacement placed = placement.value();
    ExpectUiRect(placed.rows[0u].indicator, Rect(4.0f, 10.0f, 12.0f, 12.0f));
    EXPECT_FLOAT_EQ(placed.rows[0u].mark.width, 4.8f);
    EXPECT_FLOAT_EQ(placed.rows[0u].textClip.width, 0.0f);
}

void VerifyUiRadioGroupLayoutTests_TinyAndZeroBoundsSafelyClipEveryChoice(){
    const RadioGroupChoices choices = MakeUiRadioGroupLayoutChoices(2u);
    const auto metrics = MeasureRadioGroup(2u, Point(100.0f, 16.0f), RadioGroupOptions(), RadioGroupStyle());
    ASSERT_TRUE(metrics.has_value());
    auto placement = PlaceRadioGroup(Rect(0.0f, 0.0f, 2.0f, 2.0f), Rect(0.0f, 0.0f, 2.0f, 2.0f), choices, metrics.value());
    ASSERT_TRUE(placement.has_value());
    EXPECT_EQ(placement.value().count, 2u);
    EXPECT_FLOAT_EQ(placement.value().rows[0u].indicator.width, 0.0f);
    EXPECT_FLOAT_EQ(placement.value().rows[0u].clip.height, 0.0f);
    placement = PlaceRadioGroup(Rect(), Rect(), choices, metrics.value());
    ASSERT_TRUE(placement.has_value());
    EXPECT_EQ(placement.value().count, 2u);
    EXPECT_FLOAT_EQ(placement.value().rows[1u].textClip.width, 0.0f);
    EXPECT_FLOAT_EQ(placement.value().rows[1u].textClip.height, 0.0f);
}

void VerifyUiRadioGroupLayoutTests_InvalidOptionsOrChoiceCountsRejectMetrics(){
    RadioGroupOptions options = RadioGroupOptions();
    options.width = LayoutSize(LayoutSizePolicy::Fixed, -1.0f);
    EXPECT_FALSE(MeasureRadioGroup(3u, Point(100.0f, 16.0f), options, RadioGroupStyle()).has_value());
    options.width = LayoutSize(LayoutSizePolicy::Fixed, bit_cast<f32>(s_UiRadioScrollQuietNaNF32Bits));
    EXPECT_FALSE(MeasureRadioGroup(3u, Point(100.0f, 16.0f), options, RadioGroupStyle()).has_value());
    EXPECT_FALSE(MeasureRadioGroup(65u, Point(100.0f, 16.0f), RadioGroupOptions(), RadioGroupStyle()).has_value());
    EXPECT_FALSE(MeasureRadioGroup(3u, Point(-1.0f, 16.0f), RadioGroupOptions(), RadioGroupStyle()).has_value());
}

void VerifyUiRadioGroupLayoutTests_InvalidStyleMetricsAndTintsRejectMetrics(){
    for(u32 mode = 0u; mode < 8u; ++mode){
        RadioGroupStyle style = RadioGroupStyle();
        switch(mode){
        case 0u:
            style.padding.top = -1.0f;
            break;
        case 1u:
            style.rowGap = bit_cast<f32>(s_UiRadioScrollPosInfF32Bits);
            break;
        case 2u:
            style.indicatorExtent = 0.0f;
            break;
        case 3u:
            style.gap = -1.0f;
            break;
        case 4u:
            style.markInset = 0.51f;
            break;
        case 5u:
            style.hoverTint.r = bit_cast<f32>(s_UiRadioScrollQuietNaNF32Bits);
            break;
        case 6u:
            style.pressedTint.g = -1.0f;
            break;
        default:
            style.disabledTint.a = 1.1f;
            break;
        }
        EXPECT_FALSE(MeasureRadioGroup(3u, Point(100.0f, 16.0f), RadioGroupOptions(), style).has_value());
    }
}

void VerifyUiRadioGroupLayoutTests_OverflowingContentHeightRejectsMetrics(){
    EXPECT_FALSE(MeasureRadioGroup(64u, Point(100.0f, f32.max), RadioGroupOptions(), RadioGroupStyle()).has_value());
}

void VerifyUiRadioGroupLayoutTests_InvalidAndUnrepresentableBoundsRejectPlacement(){
    const RadioGroupChoices choices = MakeUiRadioGroupLayoutChoices(3u);
    const auto metrics = MeasureRadioGroup(3u, Point(100.0f, 16.0f), RadioGroupOptions(), RadioGroupStyle());
    ASSERT_TRUE(metrics.has_value());
    const Rect bounds = Rect(0.0f, 0.0f, 140.0f, 112.0f);
    Array<Rect, 4u> invalid;
    invalid[0u] = Rect(0.0f, 0.0f, -1.0f, 112.0f);
    invalid[1u] = Rect(bit_cast<f32>(s_UiRadioScrollQuietNaNF32Bits), 0.0f, 140.0f, 112.0f);
    invalid[2u] = Rect(f32.max, 0.0f, f32.max, 112.0f);
    invalid[3u] = Rect(0.0f, 1.0e20f, 140.0f, 112.0f);
    for(in Rect rectangle : invalid)
        EXPECT_FALSE(PlaceRadioGroup(rectangle, bounds, choices, metrics.value()).has_value());
    EXPECT_FALSE(PlaceRadioGroup(bounds, Rect(0.0f, 0.0f, 140.0f, -1.0f), choices, metrics.value()).has_value());
}

void VerifyUiRadioGroupLayoutTests_MismatchedCountKeysOrMetricsRejectPlacement(){
    RadioGroupChoices choices = MakeUiRadioGroupLayoutChoices(3u);
    auto metrics = MeasureRadioGroup(3u, Point(100.0f, 16.0f), RadioGroupOptions(), RadioGroupStyle());
    ASSERT_TRUE(metrics.has_value());
    const Rect bounds = Rect(0.0f, 0.0f, 140.0f, 112.0f);
    choices.count = 2u;
    EXPECT_FALSE(PlaceRadioGroup(bounds, bounds, choices, metrics.value()).has_value());
    choices.count = 3u;
    choices.rows[1u].key = 1u;
    EXPECT_FALSE(PlaceRadioGroup(bounds, bounds, choices, metrics.value()).has_value());
    choices.rows[1u].key = 0u;
    EXPECT_FALSE(PlaceRadioGroup(bounds, bounds, choices, metrics.value()).has_value());
    choices.rows[1u].key = 2u;
    RadioGroupMetrics mutatedMetrics = metrics.value();
    mutatedMetrics.contentSize.y = 0.0f;
    EXPECT_FALSE(PlaceRadioGroup(bounds, bounds, choices, mutatedMetrics).has_value());
}


