#ifndef NWB_GRAPHICS_MESH_BINDLESS_HEAP_MESH_VIEW_SLANGI
#define NWB_GRAPHICS_MESH_BINDLESS_HEAP_MESH_VIEW_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../bindless/bindless_heap.slangi"
#include "view_buffer.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#pragma warning(push)
#pragma warning(disable: 39001) // The mesh view is a typed alias of the uniform descriptor table.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_UNIFORM_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] ConstantBuffer<NwbMeshViewBuffer, Std140DataLayout> g_NwbHeapMeshViewBuffers[];
#pragma warning(pop)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


ConstantBuffer<NwbMeshViewBuffer, Std140DataLayout> nwbHeapMeshViewBuffer(const uint slot){
    return g_NwbHeapMeshViewBuffers[slot];
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


