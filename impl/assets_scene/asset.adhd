////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_scene/component_asset_binary_codec.adhd>
#include <impl/assets_scene/scene_assets.adhd>
#include <impl/assets_subsystem/asset.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type ComponentRef = AssetRef<IComponent>;
type ComponentRefVector = Vector<ComponentRef>;
type SceneRef = AssetRef<SceneAsset>;
type SubsystemRef = AssetRef<ISubsystem>;
type EntityRef = AssetRef<EntityAsset>;
type SceneAssetRef = AssetRef<IAsset>;
type SubsystemRefVector = Vector<SubsystemRef>;
type EntityRefVector = Vector<EntityRef>;
type AssetMap = HashMap<Name, SceneAssetRef>;
type ProjectRef = AssetRef<ProjectAsset>;
type LoadedSubsystemVector = Vector<UniquePtr<ISubsystem>>;
type LoadedComponentVector = Vector<UniquePtr<IComponent>>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena, asset("entity")]
class EntityAsset{
    private Name m_name = s_NameNone;
    private ComponentRefVector m_components;

    public b8 validatePayload()const;
    public b8 loadBinary(in Span<u8> binary);

    public void setName(in Name name){
        this.m_name = name;
    }

    public Name name()const{
        return this.m_name;
    }

    public void setComponents(in ComponentRefVector components){
        this.m_components = components;
    }

    public ComponentRefVector takeComponents(){
        ComponentRefVector result = this.m_components;
        this.m_components.clear();
        return result;
    }

    public in ComponentRefVector components()const{
        return this.m_components;
    }
}

[arena, asset("project")]
class ProjectAsset{
    private SceneRef m_startScene;

    public b8 validatePayload()const;
    public b8 loadBinary(in Span<u8> binary);

    public void setStartScene(in SceneRef startScene){
        this.m_startScene = startScene;
    }

    public in SceneRef startScene()const{
        return this.m_startScene;
    }
}

[arena, asset("scene")]
class SceneAsset{
    private SubsystemRefVector m_subsystems;
    private EntityRefVector m_entities;
    private AssetMap m_assets;

    public b8 validatePayload()const;
    public b8 loadBinary(in Span<u8> binary);

    public void setContents(
        in SubsystemRefVector subsystems,
        in AssetMap assets,
        in EntityRefVector entities
    ){
        this.m_subsystems = subsystems;
        DeduplicateSubsystemRefs(this.m_subsystems);
        this.m_entities = entities;
        this.m_assets = assets;
    }

    public void takeContents(
        mut SubsystemRefVector outSubsystems,
        mut AssetMap outAssets,
        mut EntityRefVector outEntities
    ){
        outSubsystems = this.m_subsystems;
        this.m_subsystems.clear();
        outAssets = this.m_assets;
        this.m_assets.clear();
        outEntities = this.m_entities;
        this.m_entities.clear();
    }

    public in SubsystemRefVector subsystems()const{ return this.m_subsystems; }
    public in EntityRefVector entities()const{ return this.m_entities; }
    public in AssetMap assets()const{ return this.m_assets; }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[move_only]
class LoadedSceneEntity{
    public Name name = s_NameNone;
    public EntityRef entity;
    public LoadedComponentVector components;
}

[move_only]
class LoadedSceneContents{
    public SceneRef scene;
    public AssetMap assets;
    public LoadedSubsystemVector subsystems;
    public Vector<LoadedSceneEntity> entities;
}

[modular]
class InstantiatedSceneEntities{
    public Vector<EntityID> entities;
    public Vector<Name> names;
    public HashMap<Name, EntityID> namedEntities;

    public void clear();
    public EntityID findByName(in Name name)const;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[modular, move_only]
class ActiveSceneSubsystems{
    private LoadedSceneContents m_contents;

    public b8 loadProjectStartScene(in AssetManager assetManager, in ProjectRef project);
    public b8 loadProjectStartScene(in AssetManager assetManager){
        return this.loadProjectStartScene(assetManager, ProjectRef(s_DefaultProjectVirtualPath));
    }
    public b8 loadScene(in SceneRef scene, in AssetManager assetManager);
    public void unloadScene();
    public b8 instantiateEntities(mut World world)const;
    public b8 instantiateEntities(mut World world, mut InstantiatedSceneEntities outInstantiated)const;
    public Expected<InstantiatedSceneEntities> instantiateEntitiesWithResult(mut World world)const;
    public void destroyEntities(mut World world, in InstantiatedSceneEntities instantiated)const;
    public void destroyEntities(mut World world, mut InstantiatedSceneEntities instantiated)const;

    public b8 valid()const{ return this.m_contents.scene.valid() && !this.m_contents.subsystems.empty(); }
    public in SceneRef scene()const{ return this.m_contents.scene; }
    public usize subsystemCount()const{ return this.m_contents.subsystems.size(); }

    public Optional<in SubsystemT> findSubsystem<SubsystemT>()const{
        for(in UniquePtr<ISubsystem> loaded : this.m_contents.subsystems){
            if(loaded.valid()){
                const auto typed = BorrowTypedAsset<SubsystemT>(loaded.deref());
                if(typed.has_value())
                    return typed;
            }
        }
        return Optional<in SubsystemT>();
    }

    public b8 hasSubsystem<SubsystemT>()const{
        return this.findSubsystem<SubsystemT>().has_value();
    }

    public AssetRef<T> findSceneAsset<T>(in Name nickname)const{
        if(nickname == s_NameNone)
            return AssetRef<T>();
        const auto found = this.m_contents.assets.find(nickname);
        if(found == this.m_contents.assets.end())
            return AssetRef<T>();
        return AssetRef<T>(found.value().name());
    }

    public SceneAssetRef findSceneAsset(in Name nickname)const{ return this.findSceneAsset<IAsset>(nickname); }
}

type ActiveSceneSubsystemsRef = Optional<in ActiveSceneSubsystems>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

