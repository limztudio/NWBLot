void VerifyUiTextAreaNavigationTests_PageDocumentBoundariesKeepTheActiveCaret(mut UiTextAreaNavigationTests self){
    ASSERT_TRUE(self.m_model.setText("MMMM\nM"));
    ASSERT_TRUE(self.m_model.setSelection(2u, 2u));
    const auto first = self.resolve(EditNavigationDirection::PageUp, 1000.0f);
    ASSERT_TRUE(first.has_value());
    EXPECT_EQ(first.value().committedByte, 2u);
    ASSERT_TRUE(self.m_model.setSelection(5u, 6u));
    const auto last = self.resolve(EditNavigationDirection::PageDown, 1000.0f);
    ASSERT_TRUE(last.has_value());
    EXPECT_EQ(last.value().committedByte, 6u);
    EXPECT_EQ(self.m_model.anchor(), 5u);
    EXPECT_EQ(self.m_model.caret(), 6u);
}

void VerifyUiTextAreaNavigationTests_APageWithinTheCurrentRowKeepsTheActiveCaret(mut UiTextAreaNavigationTests self){
    ASSERT_TRUE(self.m_model.setText("MMMM\nMMMM\nMMMM"));
    ASSERT_TRUE(self.m_model.setSelection(7u, 7u));
    ASSERT_TRUE(self.shapeCurrent());
    const f32 height = self.m_view.caretGeometry().lines()[1u].height * 0.25f;
    const auto down = self.resolve(EditNavigationDirection::PageDown, height);
    ASSERT_TRUE(down.has_value());
    EXPECT_EQ(down.value().committedByte, 7u);
    const auto up = self.resolve(EditNavigationDirection::PageUp, height);
    ASSERT_TRUE(up.has_value());
    EXPECT_EQ(up.value().committedByte, 7u);
}

void VerifyUiTextAreaNavigationTests_FiniteExtremeViewportHeightClampsToDocumentEnds(mut UiTextAreaNavigationTests self){
    ASSERT_TRUE(self.m_model.setText("MMMM\nMMMM\nMMMM"));
    ASSERT_TRUE(self.m_model.setSelection(2u, 2u));
    const auto last = self.resolve(EditNavigationDirection::PageDown, f32.max);
    ASSERT_TRUE(last.has_value());
    EXPECT_EQ(last.value().committedByte, 12u);
    ASSERT_TRUE(self.m_model.setSelection(12u, 12u));
    const auto first = self.resolve(EditNavigationDirection::PageUp, f32.max);
    ASSERT_TRUE(first.has_value());
    EXPECT_EQ(first.value().committedByte, 2u);
    EXPECT_TRUE(IsFinite(first.value().preferredX));
    EXPECT_TRUE(IsFinite(last.value().preferredX));
}

void VerifyUiTextAreaNavigationTests_PageReachesTheTrailingEmptyLine(mut UiTextAreaNavigationTests self){
    ASSERT_TRUE(self.m_model.setText("MM\nMM\n"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 1u));
    const auto result = self.resolve(EditNavigationDirection::PageDown, 1000.0f);
