native{
#include <impl/ecs_ui/toolkit/widgets/radio_group.adhd.h>
#include <impl/ecs_ui/toolkit/text/layout.adhd.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Required source and state loans end when the owning scope destroys this transient frame.
class RadioGroupFrame final : NoCopy{
    friend class Builder;


private:
    struct Label{
        TextLayout text;
        Rect bounds;
    };


public:
    RadioGroupFrame(Core::Alloc::GlobalArena& arena, const IListDataSource& source, RadioGroupState& state)noexcept
        : m_source(source)
        , m_state(state)
        , m_labels(arena)
    {}


private:
    const IListDataSource& m_source;
    RadioGroupState& m_state;
    PaintVector<Label> m_labels;
    RadioGroupChoices m_choices;
    RadioGroupSnapshot m_snapshot;
    RadioGroupOptions m_options;
    b8 m_focusOnCommit = false;
    RadioGroupStyle m_style;
    RadioGroupMetrics m_metrics;
    WidgetStyle m_widgetStyle;
    ControlToken m_token;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ImplEcsUiToolkitWidgetsRadioGroupFrameAdhdModule(in u64 value){
    return value != 0u;
}


