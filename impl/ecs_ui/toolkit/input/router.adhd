////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


template<typename T>
using InputVector = Vector<T, Core::Alloc::GlobalArena>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// A single CPU owner serializes input and layout publication; native capture, IME, and clipboard remain OS services.
class InputRouter final : NoCopy{
public:
    explicit InputRouter(Core::Alloc::GlobalArena& arena);


public:
    [[nodiscard]] Expected<InputEvent> queue(const InputEvent& event){ return m_admission.queue(event); }
    [[nodiscard]] Expected<InputEvent> queuePointer(const PointerInput& input){ return m_admission.queuePointer(input); }
    [[nodiscard]] b8 setBindings(const Span<const InputKeyBinding> bindings){ return m_admission.setBindings(bindings); }
    void restoreDefaultBindings(){ m_admission.restoreDefaultBindings(); }

    [[nodiscard]] const InputBindings& bindings()const noexcept{ return m_admission.bindings(); }

    // Drain events exactly once against the current committed layout; pending actions survive subsequent process calls.
    [[nodiscard]] InputRoutingResult process();
    // Failure preserves the committed layout and all interaction state; generations increase until reset.
    // Context passes the focus-loss generation captured at preparation to fence delayed popup acceptance.
    [[nodiscard]] b8 commitTargets(Span<const HitTarget> targets, u64 layoutGeneration, Span<const PopupScope> popups = {}, u64 expectedFocusLossGeneration = Limit<u64>::s_Max);
    [[nodiscard]] Expected<PopupDismissReason::Enum> consumePopupDismissal(const PopupToken& token)noexcept{
        return m_popupState.consumeDismissal(token);
    }
    [[nodiscard]] b8 dismissPopup(PopupDismissReason::Enum reason);
    void closePopup(const PopupToken& token)noexcept;
    void fencePopup(const PopupToken& token)noexcept;

    [[nodiscard]] b8 hasPopup()const noexcept{ return !m_popupState.records().empty(); }

    [[nodiscard]] usize popupCount()const noexcept{ return m_popupState.records().size(); }

    // Accepted observations are borrowed only until layout publication, reset, or declaration retirement.
    [[nodiscard]] const PopupScope* popupScope(const PopupToken& token)const noexcept;
    [[nodiscard]] const HitTarget* findTarget(const WidgetId id, const u64 declarationGeneration = 0u)const noexcept{
        return m_targetTable.find(id, declarationGeneration);
    }

    [[nodiscard]] PopupToken topPopupToken()const noexcept{ return m_popupState.records().empty() ? PopupToken{} : m_popupState.records().back().scope.token; }

    [[nodiscard]] u64 focusLossGeneration()const noexcept{ return m_focusLossGeneration; }

    // Remove a hidden/deleted declaration immediately while a prior GPU frame remains pending.
    void invalidateTarget(WidgetId id);
    // Transfer command focus to another input owner without cancelling already accepted UI actions.
    void clearFocus()noexcept{
        m_commandSources.clearFocus();
    }
    // Invalidate interaction and layout after resize/device/root changes; action sequences never restart.
    void reset()noexcept;
    // Device termination may suppress releases; only this device's pending sources are removed.
    void cancelDeviceInput(u64 device)noexcept;
    [[nodiscard]] b8 consumeActivation(const WidgetId id)noexcept{
        return TryConsumeRouterActivation(m_targetTable.targets(), m_targetTable.lookup(), m_popupState.records(), id, m_actions);
    }
    [[nodiscard]] Expected<ContextMenuAction> consumeContextMenu(const WidgetId id, const u64 declarationGeneration)noexcept{
        return TryConsumeRouterContextMenu(m_targetTable.targets(), m_targetTable.lookup(), m_popupState.records(), m_windowFocused, id, declarationGeneration, m_contextMenuActions);
    }
    [[nodiscard]] Expected<ControlAction> consumeControlAction(const WidgetId host, const u64 declarationGeneration, const ControlToken& token)noexcept{
        return TryConsumeRouterControlAction(m_targetTable.targets(), m_targetTable.lookup(), m_popupState.records(), host, declarationGeneration, token, m_controlActions);
    }
    // A replaced borrowed model cannot receive input from its still displayed earlier lifetime.
    void fenceControl(WidgetId host, u64 declarationGeneration, const ControlToken& token)noexcept;
    // Active updates are consumed once while retaining their press baseline; terminal updates survive until consumed.
    [[nodiscard]] Expected<PointerGesture> consumePointerGesture(const WidgetId id, const u64 declarationGeneration)noexcept{
        return TryConsumeRouterPointerGesture(m_targetTable.targets(), m_targetTable.lookup(), m_popupState.records(), id, declarationGeneration, m_pointerState.gestures());
    }
    [[nodiscard]] WidgetId hitTest(const Point& position)const noexcept;
    [[nodiscard]] b8 wouldConsumePointer(const Point& position)const noexcept;

    [[nodiscard]] u64 layoutGeneration()const noexcept{ return m_targetTable.generation(); }

    [[nodiscard]] const InputVector<HitTarget>& targets()const noexcept{ return m_targetTable.targets(); }

    [[nodiscard]] const InputVector<InputAction>& actions()const noexcept{ return m_actions; }

    [[nodiscard]] const InputVector<ControlAction>& controlActions()const noexcept{ return m_controlActions; }

    [[nodiscard]] WidgetId hover()const noexcept{ return m_hoverState.target(); }

    [[nodiscard]] u64 hoverActivityGeneration()const noexcept{ return m_hoverState.activityGeneration(); }

    [[nodiscard]] WidgetId focus()const noexcept{ return m_commandSources.focus(); }

    [[nodiscard]] WidgetId capture()const noexcept{ return m_pointerState.capture(); }

    // One spatial source can own activation and context-menu roles concurrently; other held contacts remain inert.
    [[nodiscard]] InputSource activePointerSource()const noexcept{ return m_pointerState.activeSource(); }

    [[nodiscard]] b8 acceptsPointerSource(const InputSource& source)const noexcept{
        return m_pointerState.accepts(source);
    }
    [[nodiscard]] b8 ownsPointerSource(const InputSource& source, const PointerIntent::Enum intent = PointerIntent::Activate)const noexcept{
        return m_pointerState.owns(source, intent);
    }

    [[nodiscard]] b8 primaryDown()const noexcept{ return m_pointerState.primaryDown(); }

    [[nodiscard]] b8 secondaryDown()const noexcept{ return m_pointerState.secondaryDown(); }

    [[nodiscard]] b8 pointerKnown()const noexcept{ return m_hoverState.known(); }

    // Only an explicitly hover-capable source supplies cursor geometry; contact gestures keep their own position.
    [[nodiscard]] const Point& pointerPosition()const noexcept{ return m_hoverState.position(); }

    [[nodiscard]] b8 windowFocused()const noexcept{ return m_windowFocused; }

    [[nodiscard]] b8 wantsPointer()const noexcept{
        return m_pointerState.wants(hasPopup(), m_hoverState.target());
    }
    [[nodiscard]] b8 wantsCommands()const noexcept{
        return m_commandSources.wants(m_popupState.records());
    }
    [[nodiscard]] b8 ownsKey(i32 key)const noexcept;
    [[nodiscard]] b8 ownsSource(const InputSource& source)const noexcept{
        return m_commandSources.owns(source);
    }
    // Held commands cannot switch editors or begin editing after their delegated owner has retired.
    [[nodiscard]] b8 canEditCommand(const InputEvent& event)const noexcept{
        return m_commandSources.canEdit(m_targetTable.targets(), m_targetTable.lookup(), m_popupState.records(), m_windowFocused, event);
    }
    // Query a queued release before process retires its physical source.
    [[nodiscard]] b8 canSubmitCommand(const InputEvent& event)const noexcept{
        return m_commandSources.canSubmit(m_targetTable.targets(), m_targetTable.lookup(), m_popupState.records(), m_windowFocused, event);
    }
    void cancelSubmitCommands(const WidgetId id)noexcept{
        m_commandSources.cancelSubmit(id);
    }
    [[nodiscard]] b8 pressed(WidgetId id)const noexcept;


private:
    void retireQueuedReleases()noexcept;
    void routePointerSource(const InputEvent& event, InputRoutingResult& result);
    void terminatePointerSource(InputSource source)noexcept;
    [[nodiscard]] const HitTarget* findHitTarget(const Point& position)const noexcept;
    void routeSecondary(const InputEvent& event, const HitTarget* hit, InputRoutingResult& result);
    void routeWheel(const InputEvent& event, const HitTarget* hit, InputRoutingResult& result);
    [[nodiscard]] b8 stagePopups(Span<const PopupScope> scopes);
    void installPopups(u64 expectedFocusLossGeneration);
    void retirePopup(WidgetId id);
    void reconcileTargets()noexcept;
    void updateHover()noexcept;
    void cancelInteraction()noexcept;
    void routePointer(const InputEvent& event, const HitTarget* hit, InputRoutingResult& result);
    void routeCommand(const InputEvent& event, InputRoutingResult& result);


private:
    InputAdmission m_admission;
    InputCommandState m_commandSources;
    InputPointerState m_pointerState;
    InputTargetTable m_targetTable;
    InputVector<InputAction> m_actions;
    InputVector<ControlAction> m_controlActions;
    InputVector<ContextMenuAction> m_contextMenuActions;
    InputPopupState m_popupState;
    InputHoverState m_hoverState;
    u64 m_focusLossGeneration = 0u;
    u64 m_nextActionSequence = 1u;
    b8 m_windowFocused = true;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsCommandInputEventType(in InputEventType type){
    return type == InputEventType::CommandDown || type == InputEventType::CommandUp;
}

void ApplyRouterFocusLostEvent(
    in b8 hasActivePopup,
    in WidgetId capture,
    in b8 primaryConsumed,
    in b8 secondaryConsumed,
    in b8 wantsCommands,
    mut u64 inOutFocusLossGeneration,
    mut b8 outWindowFocused,
    mut InputRoutingResult inOutResult
){
    if(inOutFocusLossGeneration == u64.max)
        TerminateInvariant();
    ++inOutFocusLossGeneration;
    outWindowFocused = false;
    if(hasActivePopup || capture.valid() || primaryConsumed || secondaryConsumed)
        inOutResult.pointerConsumed = true;
    if(wantsCommands)
        inOutResult.commandConsumed = true;
}

void FinalizeRouterProcessResult(
    in b8 wantsPointer,
    in b8 wantsCommands,
    in WidgetId hover,
    in WidgetId focus,
    in WidgetId capture,
    mut InputRoutingResult inOutResult
){
    inOutResult.wantsPointer = wantsPointer;
    inOutResult.wantsCommands = wantsCommands;
    inOutResult.hover = hover;
    inOutResult.focus = focus;
    inOutResult.capture = capture;
}

b8 MatchesInputDeviceSource(in InputSource source, in u64 device){
    return source.valid() && source.device == device;
}

b8 WouldConsumeIdlePointer(in b8 hasActivePopup, in WidgetId capture, in WidgetId hoveredTarget){
    return hasActivePopup || capture.valid() || hoveredTarget.valid();
}

InputSource MakeKeyboardInputSource(in i32 key){
    return InputSource(0u, cast<u64>(key) + 1u);
}

b8 CanCheckPointerSubmitPressedTarget(in b8 primaryDown, in b8 submitArmed, in WidgetId capture, in WidgetId targetId){
    return primaryDown && submitArmed && capture == targetId;
}

void AccumulateTerminatedPointerSourceResult(
    in b8 ownsActivate,
    in b8 ownsContextMenu,
    in InputSource activeSource,
    in InputSource eventSource,
    mut InputRoutingResult inOutResult
){
    if(ownsActivate || ownsContextMenu)
        inOutResult.pointerConsumed = true;
    if(activeSource == eventSource)
        inOutResult.pointerRouted = true;
}

b8 IsSecondaryButtonInputEventType(in InputEventType type){
    return type == InputEventType::SecondaryDown || type == InputEventType::SecondaryUp;
}

b8 IsPointerButtonReleaseEventType(in InputEventType type){
    return type == InputEventType::PrimaryUp || type == InputEventType::SecondaryUp;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


InputRouter::InputRouter(Core::Alloc::GlobalArena& arena)
    : m_admission(arena)
    , m_commandSources(arena)
    , m_pointerState(arena)
    , m_targetTable(arena)
    , m_actions(arena)
    , m_controlActions(arena)
    , m_contextMenuActions(arena)
    , m_popupState(arena)
{
    m_commandSources.reserve();
    m_pointerState.reserveSources();
    m_actions.reserve(s_InputMaxActions);
    m_controlActions.reserve(s_InputMaxControlActions);
    m_contextMenuActions.reserve(s_InputMaxContextMenuActions);
    m_pointerState.reserveGestures();
}

InputRoutingResult InputRouter::process(){
    InputRoutingResult result;
    for(const InputEvent& event : m_admission.events()){
        if(IsPointerInputEventType(event.type))
            routePointerSource(event, result);
        else if(IsCommandInputEventType(event.type))
            routeCommand(event, result);
        else if(event.type == InputEventType::FocusLost){
            ApplyRouterFocusLostEvent(
                hasPopup(),
                m_pointerState.capture(),
                m_pointerState.primaryConsumed(),
                m_pointerState.secondaryConsumed(),
                wantsCommands(),
                m_focusLossGeneration,
                m_windowFocused,
                result
            );
            m_popupState.cancelFocus();
            cancelInteraction();
        }
        else if(event.type == InputEventType::FocusGained)
            m_windowFocused = true;
    }
    m_admission.clear();
    FinalizeRouterProcessResult(
        wantsPointer(),
        wantsCommands(),
        m_hoverState.target(),
        m_commandSources.focus(),
        m_pointerState.capture(),
        result
    );
    return result;
}

b8 InputRouter::commitTargets(const Span<const HitTarget> targets, const u64 layoutGeneration, const Span<const PopupScope> popups, const u64 expectedFocusLossGeneration){
    if(!m_targetTable.canPublish(targets.size(), layoutGeneration))
        return false;
    if(!stagePopups(popups) || !m_targetTable.publish(targets, m_popupState.staged(), layoutGeneration))
        return false;
    installPopups(expectedFocusLossGeneration);
    reconcileTargets();
    ApplyRouterFocusOnCommit(
        m_targetTable.targets(),
        m_targetTable.lookup(),
        m_popupState.records(),
        m_windowFocused,
        m_focusLossGeneration,
        expectedFocusLossGeneration,
        m_commandSources.focus(),
        m_commandSources.declaration(),
        m_commandSources.control()
    );
    return true;
}

b8 InputRouter::dismissPopup(const PopupDismissReason::Enum reason){
    if(!m_popupState.dismiss(reason))
        return false;
    reconcileTargets();
    return true;
}

void InputRouter::closePopup(const PopupToken& token)noexcept{
    m_popupState.close(token);
    reconcileTargets();
}

void InputRouter::fencePopup(const PopupToken& token)noexcept{
    m_popupState.fence(token);
    reconcileTargets();
}

const PopupScope* InputRouter::popupScope(const PopupToken& token)const noexcept{
    const auto scopeIndex = FindRouterPopupScopeIndex(m_popupState.records(), token);
    return scopeIndex ? &m_popupState.records()[*scopeIndex].scope : nullptr;
}

void InputRouter::invalidateTarget(const WidgetId id){
    retirePopup(id);
    if(!m_targetTable.invalidate(id))
        return;
    reconcileTargets();
}

void InputRouter::reset()noexcept{
    retireQueuedReleases();
    m_admission.clear();
    m_targetTable.reset();
    m_popupState.reset();
    cancelInteraction();
}

void InputRouter::cancelDeviceInput(const u64 device)noexcept{
    if(MatchesInputDeviceSource(m_pointerState.activeSource(), device))
        terminatePointerSource(m_pointerState.activeSource());
    m_admission.cancelDevice(device, m_pointerState.sources(), m_commandSources.records());
    if(MatchesInputDeviceSource(m_hoverState.source(), device))
        m_hoverState.forgetSource();
}

void InputRouter::fenceControl(const WidgetId host, const u64 declarationGeneration, const ControlToken& token)noexcept{
    if(m_targetTable.fenceControl(host, declarationGeneration, token))
        reconcileTargets();
}

WidgetId InputRouter::hitTest(const Point& position)const noexcept{
    const HitTarget* target = findHitTarget(position);
    return target == nullptr ? WidgetId{} : target->id;
}

b8 InputRouter::wouldConsumePointer(const Point& position)const noexcept{
    if(m_pointerState.primaryDown())
        return m_pointerState.primaryConsumed();
    if(m_pointerState.secondaryDown())
        return m_pointerState.secondaryConsumed();
    return WouldConsumeIdlePointer(hasPopup(), m_pointerState.capture(), hitTest(position));
}

b8 InputRouter::ownsKey(const i32 key)const noexcept{
    return IsValidInputKeyCode(key) && ownsSource(MakeKeyboardInputSource(key));
}

b8 InputRouter::pressed(const WidgetId id)const noexcept{
    if(CanCheckPointerSubmitPressedTarget(m_pointerState.primaryDown(), m_pointerState.submitArmed(), m_pointerState.capture(), id) && hitTest(m_pointerState.interactionPosition()) == id)
        return true;
    return m_commandSources.isPressed(m_targetTable.targets(), m_targetTable.lookup(), m_popupState.records(), m_windowFocused, id);
}

void InputRouter::retireQueuedReleases()noexcept{
    b8 unfinishedHoverSource = false;
    RetireRouterQueuedReleases(
        m_admission.events(),
        m_hoverState.source(),
        m_commandSources.records(),
        m_pointerState.sources(),
        m_pointerState.gestures(),
        m_pointerState.gestureSequence(),
        m_pointerState.submitArmed(),
        m_pointerState.secondaryOwner(),
        m_pointerState.capture(),
        m_pointerState.capturePopup(),
        m_pointerState.captureDeclaration(),
        m_pointerState.captureControl(),
        m_pointerState.primaryDown(),
        m_pointerState.primaryConsumed(),
        m_pointerState.secondaryDown(),
        m_pointerState.secondaryConsumed(),
        m_pointerState.activeSource(),
        unfinishedHoverSource
    );
    if(unfinishedHoverSource)
        m_hoverState.forgetSource();
}

void InputRouter::routePointerSource(const InputEvent& event, InputRoutingResult& result){
    if(event.type == InputEventType::PointerCaptureLost){
        AccumulateTerminatedPointerSourceResult(
            ownsPointerSource(event.source, PointerIntent::Activate),
            ownsPointerSource(event.source, PointerIntent::ContextMenu),
            m_pointerState.activeSource(),
            event.source,
            result
        );
        terminatePointerSource(event.source);
        return;
    }
    if(event.type == InputEventType::PointerLeave){
        AccumulateTerminatedPointerSourceResult(
            ownsPointerSource(event.source, PointerIntent::Activate),
            ownsPointerSource(event.source, PointerIntent::ContextMenu),
            m_pointerState.activeSource(),
            event.source,
            result
        );
        if(m_hoverState.source() == event.source)
            m_hoverState.forgetSource();
        return;
    }
    b8 hasHit = false;
    HitTarget hit;
    usize heldIndex = m_pointerState.sources().size();
    b8 advanceHover = false;
    const b8 shouldRoute = RouterPointerSourceAdmission{}.admitEvent(
        m_targetTable.targets(),
        m_targetTable.lookup(),
        m_popupState.records(),
        event,
        m_pointerState.primaryDown(),
        m_pointerState.primaryConsumed(),
        m_pointerState.secondaryConsumed(),
        m_hoverState.position(),
        m_hoverState.known(),
        m_hoverState.source(),
        m_hoverState.identity(),
        m_hoverState.target(),
        m_pointerState.sources(),
        m_pointerState.activeSource(),
        m_pointerState.interactionPosition(),
        result,
        hasHit,
        hit,
        heldIndex,
        advanceHover
    );
    if(advanceHover)
        m_hoverState.advanceActivity();
    if(!shouldRoute)
        return;
    const HitTarget* const hitPtr = hasHit ? &hit : nullptr;
    if(IsSecondaryButtonInputEventType(event.type))
        routeSecondary(event, hitPtr, result);
    else if(event.type == InputEventType::PointerWheel)
        routeWheel(event, hitPtr, result);
    else
        routePointer(event, hitPtr, result);
    if(IsPointerButtonReleaseEventType(event.type))
        RouterPointerSourceAdmission{}.finishRelease(heldIndex, m_pointerState.primaryDown(), m_pointerState.secondaryDown(), m_pointerState.sources(), m_pointerState.activeSource());
}

void InputRouter::terminatePointerSource(const InputSource source)noexcept{
    b8 unfinishedHoverSource = false;
    TerminateRouterPointerSource(
        source,
        m_hoverState.source(),
        m_pointerState.sources(),
        m_pointerState.gestures(),
        m_pointerState.gestureSequence(),
        m_pointerState.submitArmed(),
        m_pointerState.secondaryOwner(),
        m_pointerState.capture(),
        m_pointerState.capturePopup(),
        m_pointerState.captureDeclaration(),
        m_pointerState.captureControl(),
        m_pointerState.primaryDown(),
        m_pointerState.primaryConsumed(),
        m_pointerState.secondaryDown(),
        m_pointerState.secondaryConsumed(),
        m_pointerState.activeSource(),
        unfinishedHoverSource
    );
    if(unfinishedHoverSource)
        m_hoverState.forgetSource();
}

const HitTarget* InputRouter::findHitTarget(const Point& position)const noexcept{
    const auto hitIndex = FindRouterHitTargetIndex(m_targetTable.targets(), m_targetTable.lookup(), m_popupState.records(), position);
    return hitIndex ? &m_targetTable.targets()[*hitIndex] : nullptr;
}

void InputRouter::routeSecondary(const InputEvent& event, const HitTarget* const hit, InputRoutingResult& result){
    const auto effects = m_pointerState.routeSecondary(event, hit, m_targetTable, m_popupState, m_windowFocused, m_contextMenuActions, m_nextActionSequence, result);
    if(effects.dismissedPopup && !m_popupState.apply(effects.popupDismissal))
        TerminateInvariant();
    if(effects.advanceHover)
        m_hoverState.advanceActivity();
    if(effects.dismissedPopup){
        reconcileTargets();
        updateHover();
    }
}

void InputRouter::routeWheel(const InputEvent& event, const HitTarget* hit, InputRoutingResult& result){
    m_pointerState.routeWheel(event, hit, m_targetTable, m_popupState, m_controlActions, m_nextActionSequence, result);
}

b8 InputRouter::stagePopups(const Span<const PopupScope> scopes){
    return m_popupState.stage(scopes);
}

void InputRouter::installPopups(const u64 expectedFocusLossGeneration){
    m_popupState.install(
        m_targetTable.targets(),
        m_targetTable.lookup(),
        m_windowFocused,
        m_focusLossGeneration,
        expectedFocusLossGeneration,
        m_commandSources.records(),
        m_commandSources.focus(),
        m_commandSources.declaration(),
        m_commandSources.control()
    );
}

void InputRouter::retirePopup(const WidgetId id){
    const auto retirement = m_popupState.retire(m_targetTable, id);
    if(!retirement)
        return;
    RestoreRouterPopupFocus(retirement->top, retirement->restore, m_windowFocused, m_targetTable.targets(), m_targetTable.lookup(), m_popupState.records(), m_commandSources.records(), m_commandSources.focus(), m_commandSources.declaration(), m_commandSources.control());
    reconcileTargets();
}

void InputRouter::reconcileTargets()noexcept{
    b8 changedHoverOwner = false;
    ReconcileRouterAllTargets(
        m_targetTable.targets(),
        m_targetTable.lookup(),
        m_popupState.records(),
        m_windowFocused,
        m_hoverState.known(),
        m_hoverState.position(),
        m_commandSources.records(),
        m_actions,
        m_controlActions,
        m_contextMenuActions,
        m_pointerState.gestures(),
        m_pointerState.gestureSequence(),
        m_commandSources.focus(),
        m_commandSources.declaration(),
        m_commandSources.control(),
        m_pointerState.capture(),
        m_pointerState.capturePopup(),
        m_pointerState.captureDeclaration(),
        m_pointerState.captureControl(),
        m_pointerState.submitArmed(),
        m_pointerState.secondaryOwner(),
        m_hoverState.identity(),
        m_hoverState.target(),
        changedHoverOwner
    );
    if(changedHoverOwner)
        m_hoverState.advanceActivity();
}

void InputRouter::updateHover()noexcept{
    m_hoverState.setTarget(m_targetTable.targets(), m_targetTable.lookup(), m_popupState.records(), m_hoverState.known() ? findHitTarget(m_hoverState.position()) : nullptr);
}

void InputRouter::cancelInteraction()noexcept{
    m_hoverState.advanceActivity();
    CancelRouterInteraction(
        m_actions,
        m_controlActions,
        m_contextMenuActions,
        m_pointerState.gestures(),
        m_commandSources.records(),
        m_pointerState.gestureSequence(),
        m_hoverState.target(),
        m_hoverState.identity(),
        m_commandSources.focus(),
        m_pointerState.capture(),
        m_pointerState.capturePopup(),
        m_pointerState.captureControl(),
        m_commandSources.control(),
        m_commandSources.declaration(),
        m_pointerState.captureDeclaration(),
        m_hoverState.known(),
        m_pointerState.secondaryOwner(),
        m_pointerState.submitArmed()
    );
}

void InputRouter::routePointer(const InputEvent& event, const HitTarget* const hit, InputRoutingResult& result){
    const auto effects = m_pointerState.routePrimary(event, hit, m_targetTable, m_popupState, m_commandSources, m_actions, m_controlActions, m_nextActionSequence, result);
    if(effects.dismissedPopup && !m_popupState.apply(effects.popupDismissal))
        TerminateInvariant();
    if(effects.advanceHover)
        m_hoverState.advanceActivity();
    if(effects.dismissedPopup){
        reconcileTargets();
        updateHover();
    }
    if(!effects.ok)
        TerminateInvariant();
}

void InputRouter::routeCommand(const InputEvent& event, InputRoutingResult& result){
    b8 dismissedPopup = false;
    PopupDismissRequest popupDismissal;
    RouteRouterCommand(
        m_targetTable.targets(),
        m_targetTable.lookup(),
        m_windowFocused,
        m_targetTable.generation(),
        event,
        m_pointerState.primaryConsumed(),
        m_pointerState.secondaryConsumed(),
        m_pointerState.sources(),
        m_popupState.records(),
        m_popupState.canAppendDismissal(),
        popupDismissal,
        m_commandSources.records(),
        m_actions,
        m_controlActions,
        m_contextMenuActions,
        m_pointerState.gestures(),
        m_pointerState.gestureSequence(),
        m_nextActionSequence,
        m_pointerState.submitArmed(),
        m_pointerState.secondaryOwner(),
        m_hoverState.target(),
        m_commandSources.focus(),
        m_commandSources.declaration(),
        m_commandSources.control(),
        m_pointerState.capture(),
        m_pointerState.capturePopup(),
        m_pointerState.captureDeclaration(),
        m_pointerState.captureControl(),
        result,
        dismissedPopup
    );
    if(dismissedPopup && !m_popupState.apply(popupDismissal))
        TerminateInvariant();
    if(dismissedPopup){
        reconcileTargets();
        updateHover();
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_END


