#include <impl/ecs_render/renderer_frame_pipeline.adhd>
#include <impl/ecs_render/execute/frame_diagnostics.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidCompiledPacketForEnvelopeTiming(in b8 packetValid, in b8 recordsPacketEnvelopeTiming, in u32 taskCount){
    return packetValid && recordsPacketEnvelopeTiming && taskCount != 0u;
}

b8 CanScheduleDeclaredDeferredTaskGraph(in b8 declared){
    return declared;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RendererFramePipeline::prepareDeferredGraphPacketEnvelopeMetrics(in GpuTaskGraphDeclarationReadView graph, in GpuCompiledGraphReadView compiledGraph){
    const GpuSubmissionPacketRange range = compiledGraph.packetTimingEnvelopeRange();
    if(!range.valid() || !compiledGraph.validPacketRange(range))
        return false;

    Vector<GpuPacketEnvelopeMetricScope> packetScopes;
    Vector<GpuPacketEnvelopeMetricQueueOutput> queueOutputs;
    packetScopes.reserve(range.packetCount);
    queueOutputs.reserve(range.packetCount);
    for(usize offset = 0u; offset < range.packetCount; ++offset){
        const GpuSubmissionPacketId id = compiledGraph.packetIdAt(range.first.index + offset);
        const GpuCompiledPacketView packet = compiledGraph.packet(id);
        if(!packet.valid())
            return false;
        const auto plan = packet.packetPlan();
        if(!plan.has_value() || !IsValidCompiledPacketForEnvelopeTiming(true, plan.value().recordsPacketEnvelopeTiming, plan.value().taskCount))
            return false;

        const auto scopeName = GpuTaskPacketTimingScopeName(graph.taskAt(packet.taskSpan()[0u].index).identity);
        if(!scopeName.has_value())
            return false;
        GpuPacketEnvelopeMetricScope scope;
        scope.scopeName = scopeName.value();
        scope.physicalQueue = plan.value().queue;
        packetScopes.push_back(scope);

        b8 hasQueueOutput = false;
        for(in GpuPacketEnvelopeMetricQueueOutput output : queueOutputs)
            hasQueueOutput = hasQueueOutput || output.physicalQueue == plan.value().queue;
        if(hasQueueOutput)
            continue;

        const auto idleScope = ResolveDeferredGraphQueueInternalIdleScope(plan.value().queue.valid(), cast<u32>(plan.value().queue.index));
        if(!idleScope.has_value() || !idleScope.value().has_value())
            return false;
        GpuPacketEnvelopeMetricQueueOutput output;
        output.physicalQueue = plan.value().queue;
        output.internalIdleScopeName = idleScope.value().value();
        queueOutputs.push_back(output);
    }

    return this.m_graphics.gpuTiming().preparePacketEnvelopeMetrics(
        this.m_graphics.getFrameIndex(), Span<GpuPacketEnvelopeMetricScope>(packetScopes),
        s_TimingScopeDeferredGraphQueueOverlap.identity, Span<GpuPacketEnvelopeMetricQueueOutput>(queueOutputs)
    );
}

b8 RendererFramePipeline::declareFrameTimingBeginTask(mut GpuTimingFrameTransaction frameTimingTransaction){
    GpuTaskSchedulingHint scheduling;
    scheduling.cost = GpuTaskCostHint::Tiny;
    scheduling.forceSubmissionBoundary = true;
    scheduling.allowPacketMerge = false;
    GpuTaskDesc desc;
    desc.setIdentity(Name(s_FrameGraphNameRenderFrameTimingBegin)).setMarkerLabel("Frame Timing Begin").setScheduling(scheduling);
    const auto task = AddFrameTimingBeginTask(this.m_deferredLightingTaskGraph, desc, frameTimingTransaction, this.m_graphics.getDevice(), s_TimingScopeFrame);
    if(!task.has_value()){
        this.m_deferredFrameTimingBeginTask = GpuTaskId();
        warning("RendererSystem: could not declare frame timing prelude");
        return false;
    }
    this.m_deferredFrameTimingBeginTask = task.value();
    if(!this.m_deferredLightingTaskGraph.setNormalExecutionPrelude(task.value())){
        warning("RendererSystem: could not declare frame timing prelude");
        return false;
    }
    return true;
}

b8 RendererFramePipeline::scheduleDeferredLightingTaskGraphForExecution(){
    this.m_deferredLightingTaskGraphScheduled = false;
    if(!CanScheduleDeclaredDeferredTaskGraph(this.m_deferredLightingTaskGraphDeclared))
        return false;

    GpuTaskGraphCompileOptions options;
    options.packetizationPolicy = GpuTaskGraphPacketizationPolicy::FrontierSafe;
    options.packetTimingEnvelope.firstTask = this.m_deferredFrameTimingBeginTask;
    options.packetTimingEnvelope.lastTask = this.m_deferredFrameTimingEndTask;
    this.m_deferredTaskTimingFeedback.configureCompileOptions(options, this.m_graphics.getFrameIndex());
    options.declarationSeconds = this.m_deferredLightingTaskGraphDeclarationSeconds;

    if(!this.m_graphics.gpuTasks().scheduleGraph(
        this.m_deferredLightingTaskGraph, options,
        this.m_deferredLightingTaskGraphAnalysis, this.m_deferredLightingTaskGraphQueueAssignments,
        this.m_deferredLightingCompiledGraph, this.m_deferredLightingRecordedGraph, this.m_deferredLightingSubmissionTransaction
    )){
        const auto analysis = this.m_deferredLightingTaskGraphAnalysis.diagnostic();
        const auto queue = this.m_deferredLightingTaskGraphQueueAssignments.diagnostic();
        DeferredFrameDiagnostics diagnostics;
        diagnostics.logDeferredGraphSchedulingFailure(
            cast<u32>(analysis.status), analysis.task.index, analysis.resource.index, cast<u32>(queue.status), queue.task.index
        );
        return false;
    }

    const GpuTaskGraphDeclarationReadView declarations(this.m_deferredLightingTaskGraph);
    const GpuCompiledGraphReadView compiledPlan(this.m_deferredLightingCompiledGraph);
    if(!compiledPlan.validFor(declarations)){
        warning("RendererSystem: deferred graph scheduling lost its compiler plan");
        return false;
    }
    if(!this.prepareDeferredGraphPacketEnvelopeMetrics(declarations, compiledPlan))
        warning("RendererSystem: could not prepare deferred graph packet metrics");

    this.m_deferredLightingTaskGraphScheduled = true;
    return true;
}


