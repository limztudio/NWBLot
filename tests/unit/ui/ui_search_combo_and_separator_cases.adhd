void VerifyUiSearchComboBuilderTests_PublishingQueryMutationCannotReplaceTheAcceptedEditorGeometry(mut UiSearchComboBuilderTests self){
    self.m_search.combo().select(1u);
    self.m_search.combo().open();
    ASSERT_TRUE(self.acceptSearch(1u));
    const auto displayedQuery = self.tryTarget(self.query());
    ASSERT_TRUE(displayedQuery.has_value());
    const Rect displayed = displayedQuery.value().rectangle;
    ASSERT_TRUE(self.declareSearch(2u));
    self.m_host.armPublishMutation(self.m_search.query());
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_search.query().text(), "published");
    const auto currentQuery = self.tryTarget(self.query());
    ASSERT_TRUE(currentQuery.has_value());
    const Rect current = currentQuery.value().rectangle;
    ExpectUiRect(current, displayed);
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
}

