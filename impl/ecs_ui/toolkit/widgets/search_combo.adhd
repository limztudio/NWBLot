////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "search_combo_filter.adhd"
#include "edit_box_state.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


interface ISearchableListDataSource : IListDataSource{
    b8 filter(in StringView query);
    in IListDataSource filtered()const;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 FilterSearchCombo(mut SearchComboState state, mut ISearchableListDataSource source){
    SearchComboFilterRules rules;
    const TextAreaModelStamp query = state.m_query.stamp();
    const u64 comboGeneration = state.m_combo.inputGeneration();
    const u64 previewGeneration = state.m_combo.listState().inputGeneration();
    const SearchComboSourceSnapshot full = SearchComboSourceSnapshot(source.instanceGeneration(), source.revision(), source.rowCount());
    in IListDataSource previousView = source.filtered();
    const SearchComboSourceSnapshot previous = SearchComboSourceSnapshot(previousView.instanceGeneration(), previousView.revision(), previousView.rowCount());
    if(full.generation == 0u || full.revision == 0u || !MatchesSearchComboState(state, query, comboGeneration, previewGeneration))
        return false;
    const b8 rebuild = rules.evaluateSearchComboRebuildNeed(
        state.m_filterValid,
        state.m_sourceGeneration,
        state.m_sourceRevision,
        state.m_sourceCount,
        full,
        state.m_viewGeneration,
        state.m_viewRevision,
        state.m_viewCount,
        previous,
        StringView(state.m_filteredQuery),
        state.m_query.text()
    );
    String candidate;
    if(rebuild){
        candidate.assign(state.m_query.text());
        if(!source.filter(StringView(candidate)))
            return false;
    }
    in IListDataSource view = source.filtered();
    const SearchComboSourceSnapshot filtered = SearchComboSourceSnapshot(view.instanceGeneration(), view.revision(), view.rowCount());
    if(
        !rules.validateSearchComboFilteredSnapshot(full, filtered)
        || !MatchesListSource(view, filtered.generation, filtered.revision, filtered.count)
        || !MatchesListSource(source, full.generation, full.revision, full.count)
        || !MatchesSearchComboState(state, query, comboGeneration, previewGeneration)
    )
        return false;
    if(rules.shouldResetSearchComboPreviewOnFilter(rebuild, state.m_filterValid, state.m_queryGeneration, state.m_queryExternalRevision, query)){
        if(!state.m_combo.m_list.scrollTo(0.0))
            return false;
        state.m_combo.m_list.select(state.m_combo.selectedKey());
    }
    rules.commitSearchComboFilterState(
        rebuild,
        StringView(candidate),
        full,
        filtered,
        query,
        state.m_filteredQuery,
        state.m_sourceGeneration,
        state.m_sourceRevision,
        state.m_sourceCount,
        state.m_viewGeneration,
        state.m_viewRevision,
        state.m_viewCount,
        state.m_queryGeneration,
        state.m_queryExternalRevision,
        state.m_filterValid
    );
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

