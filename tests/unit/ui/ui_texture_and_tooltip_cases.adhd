void VerifyUiTooltipBehaviorTests_NewHoverDoesNotCountTimeFromBeforeTheBindingWasKnown(){
    TooltipState state = TooltipState();
    const TooltipOptions options = TooltipOptions();
    const WidgetId anchor = MakeUiTooltipAnchor();
    const u64 revision = state.revision();
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 100.0f, options));
    EXPECT_FALSE(state.visible());
    EXPECT_GT(state.revision(), revision);
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.25f, options));
    EXPECT_FALSE(state.visible());
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.25f, options));
    EXPECT_TRUE(state.visible());
}

void VerifyUiTooltipBehaviorTests_ContiguousHoverAppearsAtTheExactDelayBoundary(){
    TooltipState state = TooltipState();
    const TooltipOptions options = TooltipOptions();
    const WidgetId anchor = MakeUiTooltipAnchor();
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.0f, options));
    for(u32 frame = 0u; frame < 3u; ++frame){
        ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.125f, options));
        EXPECT_FALSE(state.visible());
    }
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.125f, options));
    EXPECT_TRUE(state.visible());
}

void VerifyUiTooltipBehaviorTests_ChangedHoverActivityRestartsDelayWithoutAnObservedUnhoveredFrame(){
    TooltipState state = TooltipState();
    const TooltipOptions options = TooltipOptions();
    const WidgetId anchor = MakeUiTooltipAnchor();
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 7u, true, 0.0f, options));
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 7u, true, 0.25f, options));
    const u64 previousRevision = state.revision();
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 8u, true, 100.0f, options));
    EXPECT_FALSE(state.visible());
    EXPECT_GT(state.revision(), previousRevision);
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 8u, true, 0.25f, options));
    EXPECT_FALSE(state.visible());
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 8u, true, 0.25f, options));
    EXPECT_TRUE(state.visible());
    const u64 visibleRevision = state.revision();
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 9u, true, 100.0f, options));
    EXPECT_FALSE(state.visible());
    EXPECT_GT(state.revision(), visibleRevision);
}

void VerifyUiTooltipBehaviorTests_UnchangedHoverActivityPreservesAccumulatedDelay(){
    TooltipState state = TooltipState();
    const TooltipOptions options = TooltipOptions();
    const WidgetId anchor = MakeUiTooltipAnchor();
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 7u, true, 0.0f, options));
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 7u, true, 0.25f, options));
    const u64 waitingRevision = state.revision();
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 7u, true, 0.0f, options));
    EXPECT_EQ(state.revision(), waitingRevision);
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 7u, true, 0.25f, options));
    EXPECT_TRUE(state.visible());
}

void VerifyUiTooltipBehaviorTests_ZeroDelayAppearsOnTheFirstEnabledAcceptedHover(){
    TooltipState state = TooltipState();
    TooltipOptions options = TooltipOptions();
    options.delaySeconds = 0.0f;
    const WidgetId anchor = MakeUiTooltipAnchor();
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, false, 0.0f, options));
    EXPECT_FALSE(state.visible());
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.0f, options));
    EXPECT_TRUE(state.visible());
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, false, 0.0f, options));
    EXPECT_FALSE(state.visible());
    options.enabled = false;
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 10.0f, options));
    EXPECT_FALSE(state.visible());
}

void VerifyUiTooltipBehaviorTests_ZeroDeltaAndSaturatedHoverDoNotInventTimeOrRevisionChanges(){
