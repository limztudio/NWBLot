////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_font_atlas/model.adhd.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class FontAtlas final : public Core::Assets::TypedAsset<FontAtlas>{
public:
    NWB_DEFINE_ASSET_TYPE("font_atlas")


public:
    explicit FontAtlas(Core::Assets::AssetArena& arena)noexcept
        : m_payload(arena)
    {}
    FontAtlas(Core::Assets::AssetArena& arena, const Name& virtualPath)noexcept
        : Core::Assets::TypedAsset<FontAtlas>(virtualPath)
        , m_payload(arena)
    {}


public:
    [[nodiscard]] b8 loadBinary(Span<const u8> binary);
    [[nodiscard]] b8 validatePayload(Core::Alloc::ScratchArena& scratchArena)const;
    void setPayload(FontAtlasPayload&& payload)noexcept;

    [[nodiscard]] const FontAtlasPayload& payload()const noexcept{ return m_payload; }

    [[nodiscard]] const FontAtlasGlyph* glyph(u32 glyphId)const noexcept;


private:
    FontAtlasPayload m_payload;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_DEFINE_ASSET_CODEC(FontAtlasAssetCodec, FontAtlas);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


