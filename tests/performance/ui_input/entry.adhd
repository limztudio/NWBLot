        : m_value(ActiveBenchmarkArena(), context, textInput, clipboard)
    {}

public:
    template<typename... Args>
    decltype(auto) beginFrame(Args&&... args){ return m_value.beginFrame(Forward<Args>(args)...); }
    template<typename... Args>
    decltype(auto) edit(Args&&... args){ return m_value.edit(Forward<Args>(args)...); }
    template<typename... Args>
    decltype(auto) publish(Args&&... args){ return m_value.publish(Forward<Args>(args)...); }
    template<typename... Args>
    decltype(auto) finishFrame(Args&&... args){ return m_value.finishFrame(Forward<Args>(args)...); }
    template<typename... Args>
    decltype(auto) commitFrame(Args&&... args){ return m_value.commitFrame(Forward<Args>(args)...); }
    [[nodiscard]] b8 hasTextFocus()const noexcept{ return m_value.hasTextFocus(); }

private:
    UiEditBoxHost m_value;
};

