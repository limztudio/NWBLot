#ifndef NWB_GRAPHICS_MESH_SHADER_ENCODING_SLANGI
#define NWB_GRAPHICS_MESH_SHADER_ENCODING_SLANGI


#include "meshlet_payload.slangi"


NwbMeshletBounds nwbMeshLoadMeshletBounds(const uint meshletIndex){
    const uint byteOffset = nwbMeshletBoundsByteOffset(meshletIndex);

    NwbMeshletBounds bounds;
    const ByteAddressBuffer meshletBounds = NwbHeapRawBuffer(
        nwbMeshGeometryHeapSlot(NWB_MESH_BINDING_MESHLET_BOUNDS)
    );
    bounds.sphere = asfloat(meshletBounds.Load4(byteOffset + NWB_MESHLET_BOUNDS_SPHERE_BYTE_OFFSET));
    bounds.conePacked = meshletBounds.Load(byteOffset + NWB_MESHLET_BOUNDS_CONE_BYTE_OFFSET);
    return bounds;
}


#endif


