////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_BVH_BINDLESS_HEAP_BVH_SLANGI
#define NWB_GRAPHICS_BVH_BINDLESS_HEAP_BVH_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Global descriptor heap - structured BVH-node view over the StorageBuffer class.
// Software per-mesh node buffers are read as StructuredBuffer<NwbBvhNode>; other geometry uses raw ByteAddressBuffer (bindless_heap.slangi).
// Separate alias so only node-traversing passes include BVH types, keeping shadow/caustic/GI graphs BVH-free.
// Same set/binding as the raw arrays (one Vulkan descriptor; 32-byte stride is per-view decoration): node buffers need no second registration.


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../bindless/bindless_heap.slangi"
#include "bvh_common.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#pragma warning(push)
#pragma warning(disable: 39001) // Deliberate structured view of the storage-buffer descriptor table in bindless_heap.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] StructuredBuffer<NwbBvhNode> g_NwbHeapBvhNodeBuffers[];
#pragma warning(pop)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Slot accessor for the node view. The varying slot wraps in NonUniformResourceIndex(); returns by value.
StructuredBuffer<NwbBvhNode> nwbHeapBvhNodes(const uint slot){
    return g_NwbHeapBvhNodeBuffers[NonUniformResourceIndex(slot)];
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

