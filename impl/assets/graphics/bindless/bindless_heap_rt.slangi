////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Global descriptor heap -- typed view of the shared ray-tracing per-instance material table.
//
// The storage-buffer descriptor table is deliberately reinterpreted here as NwbRtInstanceMaterial records. Every
// trace backend shares the same CPU-built table, while each pass selects its current descriptor through its local
// NwbRayTraceMaterialContextSlots cbuffer.


#ifndef NWB_GRAPHICS_BINDLESS_HEAP_RT_SLANGI
#define NWB_GRAPHICS_BINDLESS_HEAP_RT_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "bindless_heap.slangi"
#include "../shadow/instance_material.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#pragma warning(push)
#pragma warning(disable: 39001) // Deliberate typed view of the StorageBuffer descriptor table in bindless_heap.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
StructuredBuffer<NwbRtInstanceMaterial, Std430DataLayout> g_NwbHeapRtInstanceMaterialBuffers[];
#pragma warning(pop)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StructuredBuffer<NwbRtInstanceMaterial, Std430DataLayout> NwbHeapRtInstanceMaterials(const uint slot){
    return g_NwbHeapRtInstanceMaterialBuffers[slot];
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
