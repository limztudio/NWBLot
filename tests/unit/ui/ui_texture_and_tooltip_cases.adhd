void VerifyUiTooltipBehaviorTests_ChangingWidthGapOrSideAlsoStartsANewHoverLifetime(){
    Array<TooltipOptions, 3u> replacements;
    replacements[0u].maximumWidth = 256.0f;
    replacements[1u].gap = 8.0f;
    replacements[2u].side = PopupPlacementSide::Right;
    const TooltipOptions options = TooltipOptions();
    const WidgetId anchor = MakeUiTooltipAnchor();
