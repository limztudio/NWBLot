////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
enum<u8> OutputAssetType{
    Bunch,
    Mesh,
    Model,
    Skeleton,
    Skin
}

class OptionPresence{
    public b8 output = false;
    public b8 assetType = false;
    public b8 mesh = false;
    public b8 normalMode = false;
    public b8 defaultColor = false;
    public b8 scale = false;
    public b8 preserveSpace = false;
    public b8 includeHidden = false;
    public b8 local = false;
    public b8 ignoreColors = false;
    public b8 flipWinding = false;
}

class FbxMeshSkinningSummary{
    private b8 sawStatic = false;
    private b8 sawSkinned = false;

    public void observe(in b8 hasSkin){
        this.sawSkinned = this.sawSkinned || hasSkin;
        this.sawStatic = this.sawStatic || !hasSkin;
    }

    public Expected<b8> resolve()const{
        if(this.sawStatic && this.sawSkinned){
            warning("Model export does not support mixed static and skinned source meshes yet");
            return makeUnexpected(Failure());
        }
        return this.sawSkinned;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidFbxImportScale(in f64 value){
    return isFinite(value) && value > 0.0;
}

b8 IsValidFbxTriangleAreaEpsilon(in f64 value){
    return isFinite(value) && !(value < 0.0);
}

Expected<usize> TryComputeMeshRefreshReplacementCapacity(in usize declarationCount){
    if(declarationCount > usize.max / s_MaxMeshReplacementCount){
        error("Failed to refresh NWB mesh: replacement capacity overflows");
        return makeUnexpected(Failure());
    }
    return declarationCount * s_MaxMeshReplacementCount;
}

u32 ComputeWorkerCount(in u32 coreCount){
    if(coreCount > s_MinParallelCoreCount)
        return coreCount - s_MinParallelCoreCount;
    return s_NoWorkerThreads;
}

StringView OutputAssetTypeText(in OutputAssetType assetType){
    switch(assetType){
        case OutputAssetType::Bunch: return s_DefaultOutputAssetTypeText;
        case OutputAssetType::Mesh: return s_MeshAssetTypeText;
        case OutputAssetType::Model: return s_ModelAssetTypeText;
        case OutputAssetType::Skeleton: return s_SkeletonAssetTypeText;
        case OutputAssetType::Skin: return s_SkinAssetTypeText;
    }
    return "";
}

b8 AssetTypeRequiresSkinning(in OutputAssetType assetType){
    return assetType == OutputAssetType::Skeleton || assetType == OutputAssetType::Skin;
}

b8 AssetTypeCanUseSkinning(in OutputAssetType assetType){
    return assetType == OutputAssetType::Bunch || assetType == OutputAssetType::Model || AssetTypeRequiresSkinning(assetType);
}

b8 ValidateFbxOutputMode(
    in OutputAssetType assetType,
    in b8 separateAssets,
    in b8 hasMeshSkin,
    in b8 hasSkeletonJoints,
    in b8 hasBindPoses,
    in b8 hasInverseBindMatrices
){
    if(separateAssets && assetType != OutputAssetType::Bunch){
        error("Failed to write NWB asset: --separate-assets is only valid with asset type 'bunch'");
        return false;
    }
    if(assetType == OutputAssetType::Mesh && (hasSkeletonJoints || hasBindPoses || hasInverseBindMatrices)){
        error("Failed to write NWB mesh: mesh output cannot write split skeleton/skin payload");
        return false;
    }
    if(AssetTypeRequiresSkinning(assetType) && !hasMeshSkin && !hasSkeletonJoints && !hasInverseBindMatrices){
        error("Failed to write NWB asset: requested asset type requires a skinned source mesh");
        return false;
    }
    return true;
}

Expected<usize> TryParseMeshIndexSelector(in StringView text){
    const StringView trimmed = trimView(text);
    if(trimmed.empty())
        return makeUnexpected(Failure());
    const Expected<u64> parsed = parseU64(trimmed);
    if(!parsed.has_value())
        return makeUnexpected(Failure());
    if(parsed.value() > cast<u64>(usize.max))
        return makeUnexpected(Failure());
    return cast<usize>(parsed.value());
}

StringView ResolveFbxNodeDisplayName(in b8 hasNode, in StringView nodeName){
    if(!hasNode)
        return s_NullNodeLabel;
    if(!nodeName.empty())
        return nodeName;
    return s_UnnamedNodeLabel;
}

StringView ResolveFbxMeshDisplayName(in StringView meshName){
    if(!meshName.empty())
        return meshName;
    return s_UnnamedMeshLabel;
}

Expected<Vec4> TryMakeFiniteColorVec4(in f32 red, in f32 green, in f32 blue, in f32 alpha){
    if(!isFinite(red) || !isFinite(green) || !isFinite(blue) || !isFinite(alpha))
        return makeUnexpected(Failure());
    return Vec4(red, green, blue, alpha);
}


