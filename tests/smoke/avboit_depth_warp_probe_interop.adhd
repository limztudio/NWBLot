namespace NWB::Tests::Smoke{
inline constexpr u32 s_DepthWarpGuardWords = 4u;
inline constexpr u32 s_DepthWarpWords = s_AvboitMaxVirtualCount + s_DepthWarpGuardWords;
inline constexpr u32 s_DepthWarpControlWords = NWB_AVBOIT_CONTROL_WORD_COUNT + s_DepthWarpGuardWords;
inline constexpr u32 s_DepthWarpResultWords = s_DepthWarpWords + s_DepthWarpControlWords;
inline constexpr u32 s_DepthWarpSentinel = 0xa5f07c39u;

[[nodiscard]] FOUNDATION_INLINE Impl::RendererAvboitPushConstants BuildAvboitDepthWarpPush(const AvboitDepthWarpCase& probe, const u32 ordinal, const u32 slots)noexcept{
    Impl::RendererAvboitPushConstants push;
    push.frame[0] = 1000u + ordinal % 997u;
    push.frame[1] = 300u + ordinal % 251u;
    push.frame[2] = (push.frame[0] + 2u) / 3u;
    push.frame[3] = (push.frame[1] + 3u) / 4u;
    push.volume[0] = probe.virtualCount;
    push.volume[1] = probe.physicalCount;
    push.volume[3] = (probe.virtualCount + 31u) / 32u;
    push.heapSlots[0] = slots;
    return push;
}

struct DepthWarpProbeBatchTask{
    struct Payload{
        Core::BufferHandle coverage;
        Core::BufferHandle warp;
        Core::BufferHandle control;
        Core::BufferHandle slots;
        Core::BufferHandle readback;
        Core::ComputePipelineHandle pipeline;
        Core::GpuDescriptorHeap& heap;
        // The project keeps this case storage immutable until the accepted batch token completes.
        const AvboitDepthWarpCase* cases = nullptr;
        u32 firstCase = 0u;
        u32 caseCount = 0u;
        u32 slotsIndex = 0u;
    };


public:
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements{ .requiredCapabilities = Core::GpuQueueCapability::Compute | Core::GpuQueueCapability::Transfer, .requiresPrimaryGraphicsQueue = true };


public:
    [[nodiscard]] static b8 Record(const Payload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext&){
        for(u32 index = 0u; index < payload.caseCount; ++index){
            const AvboitDepthWarpCase& probe = payload.cases[index];
            commandList.setBufferState(payload.coverage.get(), Core::ResourceStates::CopyDest);
            commandList.setBufferState(payload.warp.get(), Core::ResourceStates::CopyDest);
            commandList.setBufferState(payload.control.get(), Core::ResourceStates::CopyDest);
            commandList.commitBarriers();
            if(!commandList.tryWriteBuffer(*payload.coverage, probe.coverage.data(), sizeof(probe.coverage))){
                NWB_LOGGER_ERROR(FOUNDATION_TEXT("AvboitDepthWarpProbe: coverage upload failed at case {}"), payload.firstCase + index);
                return false;
            }
            commandList.clearBufferUInt(*payload.warp, s_DepthWarpSentinel);
            commandList.clearBufferUInt(*payload.control, s_DepthWarpSentinel);
            commandList.setBufferState(payload.coverage.get(), Core::ResourceStates::UnorderedAccess);
            commandList.setBufferState(payload.warp.get(), Core::ResourceStates::UnorderedAccess);
            commandList.setBufferState(payload.control.get(), Core::ResourceStates::UnorderedAccess);
            commandList.commitBarriers();

            Core::ComputeState state;
            state.setPipeline(payload.pipeline.get());
            commandList.setComputeState(state);
            payload.heap.bindCompute(commandList, *payload.pipeline);
            const auto push = BuildAvboitDepthWarpPush(probe, payload.firstCase + index, payload.slotsIndex);
            commandList.setPushConstants(&push, sizeof(push));
            commandList.dispatch(NWB_AVBOIT_DEPTH_WARP_DISPATCH_GROUP_COUNT_X, 1u, 1u);

            commandList.setBufferState(payload.warp.get(), Core::ResourceStates::CopySource);
            commandList.setBufferState(payload.control.get(), Core::ResourceStates::CopySource);
            commandList.commitBarriers();
            const u64 offset = static_cast<u64>(index) * s_DepthWarpResultWords * sizeof(u32);
            commandList.copyBuffer(*payload.readback, offset, *payload.warp, 0u, s_DepthWarpWords * sizeof(u32));
            commandList.copyBuffer(*payload.readback, offset + s_DepthWarpWords * sizeof(u32), *payload.control, 0u, s_DepthWarpControlWords * sizeof(u32));
            if(commandList.commandRecordingFailed()){
                NWB_LOGGER_ERROR(FOUNDATION_TEXT("AvboitDepthWarpProbe: command recording failed at case {}"), payload.firstCase + index);
                return false;
            }
        }
        commandList.setBufferState(payload.coverage.get(), Core::ResourceStates::CopyDest);
        commandList.setBufferState(payload.warp.get(), Core::ResourceStates::CopyDest);
        commandList.setBufferState(payload.control.get(), Core::ResourceStates::CopyDest);
        commandList.commitBarriers();
        return !commandList.commandRecordingFailed();
    }
};

[[nodiscard]] FOUNDATION_INLINE Expected<Core::GpuTaskId> DeclareDepthWarpBatch(void* userData, Core::GpuTaskGraph& graph){
    const auto& payload = *MakeNotNull(static_cast<const DepthWarpProbeBatchTask::Payload*>(userData));
    const Name probeName = Name(s_SmokeNameAvboitDepthWarpProbe);
    const auto importBuf = [&graph](const Core::BufferHandle& buffer, const AStringView label, const Core::ResourceStates::Mask state){
        Core::GpuGraphResourceDesc desc;
        desc.setIdentity(buffer->getCreationDescription().debugName).setMarkerLabel(label).setType(Core::GpuGraphResourceType::Buffer).setInitialState(state).setExternalFinalState(state);
        return graph.importBuffer(buffer, desc);
    };
    const Array<Expected<Core::GpuGraphResourceId>, 5u> imported{
        importBuf(payload.coverage, "Depth warp probe coverage", Core::ResourceStates::CopyDest),
        importBuf(payload.warp, "Depth warp probe LUT", Core::ResourceStates::CopyDest),
        importBuf(payload.control, "Depth warp probe control", Core::ResourceStates::CopyDest),
        importBuf(payload.slots, "Depth warp probe heap slots", Core::ResourceStates::ConstantBuffer),
        importBuf(payload.readback, "Depth warp probe readback", Core::ResourceStates::CopyDest),
    };
    for(u32 index = 0u; index < imported.size(); ++index){
        if(!imported[index]){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("AvboitDepthWarpProbe: graph buffer import failed at index {}"), index);
            return MakeUnexpected(Failure{});
        }
    }
    // One task owns the transfer/compute transitions within its batch and restores the declared external states.
    const Array<Core::GpuTaskResourceUse, 5u> uses{
        Core::GpuTaskResourceUse{ .resource = *imported[0u], .range = {}, .requiredState = Core::ResourceStates::CopyDest, .access = Core::GpuTaskResourceAccess::ReadWrite },
        Core::GpuTaskResourceUse{ .resource = *imported[1u], .range = {}, .requiredState = Core::ResourceStates::CopyDest, .access = Core::GpuTaskResourceAccess::ReadWrite },
        Core::GpuTaskResourceUse{ .resource = *imported[2u], .range = {}, .requiredState = Core::ResourceStates::CopyDest, .access = Core::GpuTaskResourceAccess::ReadWrite },
        Core::GpuTaskResourceUse{ .resource = *imported[3u], .range = {}, .requiredState = Core::ResourceStates::ConstantBuffer, .access = Core::GpuTaskResourceAccess::Read },
        Core::GpuTaskResourceUse{ .resource = *imported[4u], .range = {}, .requiredState = Core::ResourceStates::CopyDest, .access = Core::GpuTaskResourceAccess::Write },
    };
    for(u32 index = 0u; index < uses.size(); ++index){
        if(!uses[index].resource.valid()){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("AvboitDepthWarpProbe: graph buffer import failed at index {}"), index);
            return MakeUnexpected(Failure{});
        }
    }
    Core::GpuTaskDesc desc;
    desc.setIdentity(probeName).setMarkerLabel("AVBOIT depth warp boundary probe").setResourceUses(uses);
    const auto taskResult = graph.addTask<DepthWarpProbeBatchTask>(desc, DepthWarpProbeBatchTask::Payload(payload));
    if(!taskResult || !taskResult->valid()){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("AvboitDepthWarpProbe: graph task declaration failed at case {}"), payload.firstCase);
        return MakeUnexpected(Failure{});
    }
    return *taskResult;
}

using GlobalProbeCaseVector = Vector<AvboitDepthWarpCase, Core::Alloc::GlobalArena>;
using DescriptorHandleArray4 = Array<Core::GpuDescriptorHandle, 4u>;
using ProbeBatchTaskPayload = DepthWarpProbeBatchTask::Payload;
using Core::ShaderHandle;
using Core::BindingLayoutHandle;
using Core::ComputePipelineHandle;
using Core::BufferHandle;
using Core::GraphicsRuntime;

class DepthWarpUnfocusedPass final : public Core::IRenderPass{
public:
    explicit DepthWarpUnfocusedPass(Core::GraphicsRuntime& graphics)noexcept : Core::IRenderPass(graphics){}
    virtual b8 shouldRenderUnfocused()noexcept override{ return true; }
};

[[nodiscard]] FOUNDATION_INLINE Expected<Core::BufferHandle> CreateDepthWarpProbeBuffer(const Name name, const u32 words, const b8 readback, Core::GraphicsRuntime& graphics){
    Core::BufferDesc desc;
    desc.setDebugName(name)
        .setByteSize(words * sizeof(u32))
        .setStructStride(sizeof(u32))
        .setCanHaveUAVs(!readback)
        .setCpuAccess(readback ? Core::CpuAccessMode::Read : Core::CpuAccessMode::None)
        .enableAutomaticStateTracking(Core::ResourceStates::CopyDest)
    ;
    return graphics.createBuffer(desc);
}
};


