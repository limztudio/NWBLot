namespace __hidden_ui_popup_builder_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB;
using namespace NWB::Impl;
using namespace NWB::Impl::Ui;
using namespace NWB::UiWidgetTests;

constexpr AStringView s_PopupKey = "popup";

class CountingEditHost final : public IEditBoxHost{
public:
    virtual ~CountingEditHost()noexcept override = default;


public:
    [[nodiscard]] virtual EditBoxResult edit(const WidgetState&, const EditBoxOptions&, EditModel& model)override{
        ++loans;
        EditBoxResult result;
        result.valid = model.setText("borrowed");
        result.textChanged = result.valid;
        return result;
    }

    [[nodiscard]] virtual EditBoxResult editInPopup(const WidgetState& widget, const EditBoxOptions& options, const PopupToken&, EditModel& model)override{ return edit(widget, options, model); }

    [[nodiscard]] virtual EditBoxResult editActions(const WidgetState&, const EditBoxOptions&, const PopupToken&, EditModel&, IEditActionSink&)noexcept override{ return {}; }

    [[nodiscard]] virtual EditBoxResult editNavigated(const WidgetState&, const EditBoxOptions&, const PopupToken&, EditModel&, EditNavigationState&, IEditNavigationResolver&, IEditActionSink&)noexcept override{ return {}; }

    [[nodiscard]] virtual b8 publish(const WidgetState&, const EditBoxView&, const EditBoxPlacement&, const EditBoxOptions&)noexcept override{
        ++publications;
        return true;
    }


public:
    u32 loans = 0u;
    u32 publications = 0u;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiPopupBuilderTests : public WidgetFixture{
public:
    [[nodiscard]] b8 finishPopup(){
        return m_builder.endPopup() && m_context.endRoot() && m_context.finishFrame();
    }

    [[nodiscard]] b8 finishRoot(){
        return m_context.endRoot() && m_context.finishFrame();
    }

    [[nodiscard]] WidgetId ownerId(const AStringView key = s_PopupKey)const{
        return UiTestSupport::RequireWidgetId(UiTestSupport::RequireRootId(m_root), key);
    }

    [[nodiscard]] b8 hasTarget(const WidgetId widget)const noexcept{
        return target(widget) != nullptr;
    }

    [[nodiscard]] Expected<HitTarget> findTarget(const WidgetId widget)const noexcept{
        const HitTarget* hit = target(widget);
        if(!hit)
            return MakeUnexpected(Failure{});
        return *hit;
    }

    void useEditHost(IEditBoxHost& host)noexcept{
        m_builder.setEditHost(&host);
    }

    void clearEditHost()noexcept{
        m_builder.setEditHost(nullptr);
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_ui_popup_context_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB;
using namespace NWB::Impl::Ui;

constexpr AStringView s_BaseKey = "base";
constexpr AStringView s_PopupKey = "popup";
constexpr AStringView s_ChildKey = "child";

struct PopupFrame{
    WidgetState base;
    WidgetState popup;
    WidgetState child;
    PopupScope scope;
};

struct PopupStack{
    PopupFrame lower;
    PopupFrame higher;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiPopupContextTests : public UiTestSupport::ContextTestFixture{
public:
    UiPopupContextTests()
        : ContextTestFixture(Name(NWB::Tests::UiCases::s_UiCaseTestsUiPopupContext))
    {}


public:
    [[nodiscard]] b8 begin(const u64 generation){
        return m_context.beginFrame(generation) && m_context.beginRoot({ 401u, 1u });
    }

    [[nodiscard]] b8 finish(){
        return m_context.endRoot() && m_context.finishFrame();
    }

    void clearRetainedRoots(){
        m_context.retainRoots({});
    }

    [[nodiscard]] Expected<HitTarget> findTarget(const WidgetId widget)const noexcept{
        const HitTarget* hit = UiTestSupport::FindHitTarget(m_context.input().targets(), widget);
        if(!hit)
            return MakeUnexpected(Failure{});
        return *hit;
    }

    [[nodiscard]] Expected<WidgetState> declare(const AStringView key, const WidgetKind::Enum kind){
        const auto state = m_context.declare(key, kind);
        EXPECT_TRUE(state);
        if(!state)
            return MakeUnexpected(state.error());
        return **state;
    }

    [[nodiscard]] Expected<WidgetState> button(const AStringView key, const Rect& bounds, const b8 publish = true){
        const auto stateResult = declare(key, WidgetKind::Button);
        EXPECT_TRUE(stateResult);
        if(!stateResult)
            return MakeUnexpected(stateResult.error());
        const WidgetState state = *stateResult;
        if(!state.id.valid())
            return MakeUnexpected(Failure{});
        if(publish){
            HitTarget target;
            target.rectangle = bounds;
            target.clip = { 0.0f, 0.0f, 400.0f, 300.0f };
            target.focusable = true;
            target.activatable = true;
            EXPECT_TRUE(m_context.addTarget(state, target));
        }
        if(m_context.failed())
            return MakeUnexpected(Failure{});
        return state;
    }

    [[nodiscard]] PopupScope scope(const WidgetState& owner, const Rect& bounds = { 100.0f, 40.0f, 160.0f, 100.0f }, const u64 instance = 1u, const u64 epoch = 1u)noexcept{
        PopupScope result;
        result.token = { owner.id, owner.declarationGeneration, instance, epoch };
        result.bounds = bounds;
        result.viewport = { 0.0f, 0.0f, 400.0f, 300.0f };
        return result;
    }

    void addOwner(const WidgetState& owner, const PopupScope& popup){
        HitTarget target;
        target.rectangle = popup.bounds;
        target.clip = popup.viewport;
        EXPECT_TRUE(m_context.addTarget(owner, target));
    }

    [[nodiscard]] Expected<PopupFrame> prepare(const u64 generation, const b8 open = false, const Rect& bounds = { 100.0f, 40.0f, 160.0f, 100.0f }, const b8 keepClosedChild = false, const b8 autofocus = true){
        PopupFrame frame;
        EXPECT_TRUE(begin(generation));
        const auto frameBaseResult = button(s_BaseKey, { 10.0f, 10.0f, 60.0f, 24.0f });
        EXPECT_TRUE(frameBaseResult);
        if(!frameBaseResult)
            return MakeUnexpected(frameBaseResult.error());
        frame.base = *frameBaseResult;
        const auto framePopupResult = declare(s_PopupKey, WidgetKind::Popup);
        EXPECT_TRUE(framePopupResult);
        if(!framePopupResult)
            return MakeUnexpected(framePopupResult.error());
        frame.popup = *framePopupResult;
        frame.scope = scope(frame.popup, bounds);
        frame.scope.autofocus = autofocus;
        if(open){
            EXPECT_TRUE(m_context.beginPopupScope(frame.popup, frame.scope));
            addOwner(frame.popup, frame.scope);
        }
        if(open || keepClosedChild){
            EXPECT_TRUE(m_context.pushScope(s_PopupKey));
            const SIMDVectorSingle childOrigin = VectorAdd(VectorSet(bounds.x, bounds.y, 0.0f, 0.0f), VectorReplicate(10.0f));
            const auto frameChildResult = button(s_ChildKey, { VectorGetX(childOrigin), VectorGetY(childOrigin), 60.0f, 24.0f }, open);
            EXPECT_TRUE(frameChildResult);
            if(!frameChildResult)
                return MakeUnexpected(frameChildResult.error());
            frame.child = *frameChildResult;
            EXPECT_TRUE(m_context.popScope());
        }
        if(open)
            EXPECT_TRUE(m_context.endPopupScope(true));
        EXPECT_TRUE(finish());
        if(m_context.failed())
            return MakeUnexpected(Failure{});
        return frame;
    }

    [[nodiscard]] Expected<PopupStack> prepareStack(const u64 generation){
        PopupStack stack;
        EXPECT_TRUE(begin(generation));
        const auto stackLowerBaseResult = button(s_BaseKey, { 10.0f, 10.0f, 60.0f, 24.0f });
        EXPECT_TRUE(stackLowerBaseResult);
        if(!stackLowerBaseResult)
            return MakeUnexpected(stackLowerBaseResult.error());
        stack.lower.base = *stackLowerBaseResult;
        const auto stackLowerPopupResult = declare(s_PopupKey, WidgetKind::Popup);
        EXPECT_TRUE(stackLowerPopupResult);
        if(!stackLowerPopupResult)
            return MakeUnexpected(stackLowerPopupResult.error());
        stack.lower.popup = *stackLowerPopupResult;
        stack.lower.scope = scope(stack.lower.popup);
        EXPECT_TRUE(m_context.beginPopupScope(stack.lower.popup, stack.lower.scope));
        addOwner(stack.lower.popup, stack.lower.scope);
        EXPECT_TRUE(m_context.pushScope(s_PopupKey));
        const auto stackLowerChildResult = button(s_ChildKey, { 110.0f, 50.0f, 60.0f, 24.0f });
        EXPECT_TRUE(stackLowerChildResult);
        if(!stackLowerChildResult)
            return MakeUnexpected(stackLowerChildResult.error());
        stack.lower.child = *stackLowerChildResult;
        EXPECT_TRUE(m_context.popScope());
        EXPECT_TRUE(m_context.endPopupScope(true));
        stack.higher.base = stack.lower.base;
        const auto stackHigherPopupResult = declare("higher", WidgetKind::Popup);
        EXPECT_TRUE(stackHigherPopupResult);
        if(!stackHigherPopupResult)
            return MakeUnexpected(stackHigherPopupResult.error());
        stack.higher.popup = *stackHigherPopupResult;
        stack.higher.scope = scope(stack.higher.popup, { 200.0f, 120.0f, 160.0f, 100.0f });
        EXPECT_TRUE(m_context.beginPopupScope(stack.higher.popup, stack.higher.scope));
        addOwner(stack.higher.popup, stack.higher.scope);
        EXPECT_TRUE(m_context.pushScope("higher"));
        const auto stackHigherChildResult = button(s_ChildKey, { 210.0f, 130.0f, 60.0f, 24.0f });
        EXPECT_TRUE(stackHigherChildResult);
        if(!stackHigherChildResult)
            return MakeUnexpected(stackHigherChildResult.error());
        stack.higher.child = *stackHigherChildResult;
        EXPECT_TRUE(m_context.popScope());
        EXPECT_TRUE(m_context.endPopupScope(true));
        EXPECT_TRUE(finish());
        if(m_context.failed())
            return MakeUnexpected(Failure{});
        return stack;
    }

    [[nodiscard]] Expected<PopupFrame> focusBase(){
        const auto frameResult = prepare(1u);
        EXPECT_TRUE(frameResult);
        if(!frameResult)
            return MakeUnexpected(frameResult.error());
        const PopupFrame frame = *frameResult;
        const b8 committed = m_context.commitFrame(1u);
        EXPECT_TRUE(committed);
        if(!committed)
            return MakeUnexpected(Failure{});
        EXPECT_TRUE(send({ .position = {}, .key = Core::Key::Tab, .type = InputEventType::KeyDown }).commandConsumed);
        EXPECT_TRUE(send({ .position = {}, .key = Core::Key::Tab, .type = InputEventType::KeyUp }).commandConsumed);
        EXPECT_EQ(m_context.input().focus(), frame.base.id);
        if(m_context.input().focus() != frame.base.id)
            return MakeUnexpected(Failure{});
        return frame;
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


