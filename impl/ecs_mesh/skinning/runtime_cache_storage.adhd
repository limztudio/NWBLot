static constexpr TStringView s_AssetLoadContext = NWB_TEXT("MeshSkinningRuntimeCache");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] b8 BuildRuntimeZippedPayload(const Mesh& mesh, const Span<const SkinInfluence4> skinStream, Core::Alloc::ScratchArena& scratchArena, MeshSkinningRuntimeInstance& instance){
    const Expected<MeshletRefTotalCounts> totalCounts = TrySumRuntimeMeshletRefCounts(mesh.meshlets());
    if(!totalCounts.has_value())
        return false;
    Vector<MeshletPositionStreamRef, Core::Alloc::ScratchArena> runtimePositionRefs{scratchArena};
    Vector<MeshletAttributeStreamRef, Core::Alloc::ScratchArena> runtimeAttributeRefs{scratchArena};
    runtimePositionRefs.resize(totalCounts->positionRefCount);
    runtimeAttributeRefs.resize(totalCounts->attributeRefCount);
    instance.meshletPositionRefDeltas.clear();
    instance.meshletAttributeRefDeltas.clear();
    instance.attributeSkins.clear();
    if(!TryDecodeRuntimeZippedMeshletStreams(
        mesh.meshlets(),
        mesh.meshletPositionRefDeltas(),
        mesh.meshletAttributeRefDeltas(),
        mesh.positionStream(),
        mesh.normalStream(),
        mesh.tangentStream(),
        mesh.uv0Stream().size(),
        mesh.colorStream().size(),
        skinStream.size(),
        instance.restPositions,
        instance.restNormals,
        instance.restTangents,
        instance.meshlets,
        Span<MeshletPositionStreamRef>(runtimePositionRefs.data(), runtimePositionRefs.size()),
        Span<MeshletAttributeStreamRef>(runtimeAttributeRefs.data(), runtimeAttributeRefs.size())
    ))
        return false;

    if(!ResolveRuntimeZippedAttributeSkins(
        instance.meshlets,
        runtimePositionRefs,
        instance.meshletLocalVertexRefs,
        runtimeAttributeRefs.size(),
        instance.attributeSkins
    ))
        return false;

    if(!EncodeMeshletRefDeltas(runtimePositionRefs, runtimeAttributeRefs, true, [&](const usize meshletIndex, const TStringView reason){
        NWB_LOGGER_ERROR(NWB_TEXT("MeshSkinningRuntimeCache: runtime meshlet {} {}"), meshletIndex, reason);
        return false;
    }, instance.meshlets, instance.meshletPositionRefDeltas, instance.meshletAttributeRefDeltas
    ))
        return false;

    instance.meshletPositionRefCount = static_cast<u32>(runtimePositionRefs.size());
    instance.meshletAttributeRefCount = static_cast<u32>(runtimeAttributeRefs.size());
    return BuildRuntimeMeshLocalBounds(instance.sourceName, instance.restPositions, instance.localBounds);
}

[[nodiscard]] b8 ValidateRuntimeMeshUploadPayload(const MeshSkinningRuntimeInstance& instance){
    if(!ValidateRuntimeMeshUploadPayloadStreams(
        instance.sourceName,
        instance.hasCompleteSplitMeshPayload(),
        instance.restPositions.size(),
        instance.restNormals.size(),
        instance.restTangents.size(),
        instance.uv0.size(),
        instance.colors.size(),
        instance.skin.size(),
        instance.meshlets,
        instance.meshletPositionRefDeltas,
        instance.meshletAttributeRefDeltas,
        instance.meshletLocalVertexRefs.size(),
        instance.meshletPrimitiveIndices.size(),
        instance.attributeSkins
    ))
        return false;
    // Skin::loadBinary already admitted the copied skin and inverse bind data.
    NWB_ASSERT(instance.skeletonJointCount > 0u && instance.skeletonJointCount <= static_cast<u32>(Limit<u16>::s_Max) + 1u);
    NWB_ASSERT(ValidInverseBindMatrixCount(instance.inverseBindMatrices.size(), instance.skeletonJointCount));
#if defined(NWB_DEBUG)
    for(const SkeletonJointMatrix& storedInverseBind : instance.inverseBindMatrices)
        NWB_ASSERT(MatrixIsInvertibleAffine(LoadFloat(storedInverseBind), s_SkinValidationEpsilon, s_SkinValidationEpsilon));
    for(const SkinInfluence4& skin : instance.skin)
        NWB_ASSERT(ValidSkinInfluenceWeights(LoadFloat(skin.weight)) && SkinInfluenceFitsSkeleton(skin, instance.skeletonJointCount));
#endif
    return true;
}

[[nodiscard]] b8 FinalizeRuntimeBufferUpload(
    Expected<Core::BufferHandle, BufferSetupFailure::Enum>&& buffer,
    const MeshSkinningRuntimeInstance& instance,
    const AStringView label,
    Core::BufferHandle& outBuffer
){
    if(buffer){
        outBuffer = Move(*buffer);
        return true;
    }
    outBuffer.reset();
    ReportRuntimeBufferUploadFailure(buffer.error(), label, instance.handle.value);
    return false;
}

template<typename PayloadT>
[[nodiscard]] b8 AssignRuntimeBuffer(
    const MeshSkinningRuntimeInstance& instance,
    const AStringView suffix,
    const Span<const PayloadT> payload,
    const b8 canHaveUavs,
    const AStringView label,
    Core::GraphicsRuntime& graphics,
    const b8 canHaveRawViews,
    const b8 accelStructBuildInput,
    const Core::ResourceQueueSharing::Mask queueSharing,
    const b8 isIndexBuffer,
    Core::BufferHandle& outBuffer
){
    const Name bufferName = DeriveNamedRuntimeBufferName(instance.sourceName, instance.handle.value, instance.editRevision, suffix, label);
    if(!bufferName){
        outBuffer.reset();
        return false;
    }

    auto buffer = RuntimeMeshBufferUpload::SetupRequiredBuffer<PayloadT>(graphics, bufferName, payload, { canHaveUavs, canHaveRawViews, accelStructBuildInput, queueSharing, isIndexBuffer });
    return FinalizeRuntimeBufferUpload(Move(buffer), instance, label, outBuffer);
}

[[nodiscard]] b8 AssignPaddedRawRuntimeBuffer(
    const MeshSkinningRuntimeInstance& instance,
    const AStringView suffix,
    const Span<const u8> payload,
    const b8 canHaveUavs,
    const AStringView label,
    Core::GraphicsRuntime& graphics,
    Core::Alloc::ScratchArena& scratchArena,
    Core::BufferHandle& outBuffer
){
    const Name bufferName = DeriveNamedRuntimeBufferName(instance.sourceName, instance.handle.value, instance.editRevision, suffix, label);
    if(!bufferName){
        outBuffer = nullptr;
        return false;
    }

    auto buffer = RuntimeMeshBufferUpload::SetupRequiredPaddedRawByteBuffer(graphics, scratchArena, bufferName, payload, { canHaveUavs, true, false, Core::ResourceQueueSharing::GraphicsAndAsyncCompute });
    return FinalizeRuntimeBufferUpload(Move(buffer), instance, label, outBuffer);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Mesh& MeshSkinningRuntimeCache::MeshSkinningSource::mesh()const noexcept{
    const auto asset = MakeNotNull(Core::Assets::CastAsset<Mesh>(meshAsset.get()));
    return *asset;
}

const Skin& MeshSkinningRuntimeCache::MeshSkinningSource::skin()const noexcept{
    const auto asset = MakeNotNull(Core::Assets::CastAsset<Skin>(skinAsset.get()));
    return *asset;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void MeshSkinningRuntimeCache::prepareResources(Core::ECS::World& world, Core::Alloc::ScratchArena& scratchArena){
    auto skinningBindingView = world.view<SkinnedMeshBindingComponent>();
    const usize rendererCandidateCount = skinningBindingView.candidateCount();
    if(rendererCandidateCount == 0u){
        clear();
        return;
    }

    m_instances.reserve(rendererCandidateCount);
    m_handleToEntity.reserve(rendererCandidateCount);
    m_sources.reserve(rendererCandidateCount);

    const b8 pruneStaleInstances = !m_instances.empty();
    skinningBindingView.each([&](Core::ECS::EntityID entity, SkinnedMeshBindingComponent& component){
        if(!ensureRuntimeMesh(entity, scratchArena, component))
            component.runtimeMesh.reset();
    });

    if(!pruneStaleInstances)
        return;

    for(auto it = m_instances.begin(); it != m_instances.end();){
        const Core::ECS::EntityID entity = it->first;
        if(world.tryGetComponent<SkinnedMeshBindingComponent>(entity)){
            ++it;
            continue;
        }

        it = eraseInstance(it);
    }
}

void MeshSkinningRuntimeCache::clear()noexcept{
    m_handleToEntity.clear();
    m_instances.clear();
    m_sources.clear();
}

const MeshSkinningRuntimeInstance* MeshSkinningRuntimeCache::findInstance(const RuntimeMeshHandle handle)const noexcept{
    const Expected<Core::ECS::EntityID> foundEntity = TryFindRuntimeMeshEntityByHandle(m_handleToEntity, handle.value);
    if(!foundEntity)
        return nullptr;

    const auto foundInstance = m_instances.find(*foundEntity);
    if(foundInstance == m_instances.end())
        return nullptr;
    return &foundInstance.value();
}

b8 MeshSkinningRuntimeCache::ensureRuntimeMesh(Core::ECS::EntityID entity, Core::Alloc::ScratchArena& scratchArena, SkinnedMeshBindingComponent& component){
    const Name& sourceName = component.skin.name();
    if(!component.skin.valid()){
        releaseRuntimeMesh(entity);
        component.runtimeMesh.reset();
        return false;
    }

    const auto foundInstance = m_instances.find(entity);
    const b8 hasExistingInstance = foundInstance != m_instances.end();
    const ExistingRuntimeMeshDisposition::Enum disposition = ClassifyExistingRuntimeMesh(
        hasExistingInstance,
        hasExistingInstance ? foundInstance.value().sourceName : s_NameNone,
        sourceName,
        hasExistingInstance ? static_cast<RuntimeMeshDirtyFlag::Flag>(foundInstance.value().dirtyFlags) : RuntimeMeshDirtyFlag::None
    );
    if(disposition == ExistingRuntimeMeshDisposition::ReuseClean || disposition == ExistingRuntimeMeshDisposition::ReuploadDirty){
        MeshSkinningRuntimeInstance& instance = foundInstance.value();
        component.runtimeMesh = instance.handle;
        if(disposition == ExistingRuntimeMeshDisposition::ReuploadDirty){
            if(!uploadRuntimeMeshBuffers(instance, scratchArena)){
                releaseRuntimeMesh(entity);
                component.runtimeMesh.reset();
                return false;
            }
            instance.dirtyFlags &= ~RuntimeMeshDirtyFlag::All;
        }
        return instance.valid();
    }
    if(disposition == ExistingRuntimeMeshDisposition::ReplaceStaleSource){
        releaseRuntimeMesh(entity);
        component.runtimeMesh.reset();
    }

    const auto sourceResult = ensureSourceLoaded(component.skin);
    if(!sourceResult)
        return false;
    MeshSkinningSource& source = **sourceResult;
    const Mesh& mesh = source.mesh();
    const Skin& skin = source.skin();

    MeshSkinningRuntimeInstance instance(m_arena);
    instance.entity = entity;
    const Expected<RuntimeMeshHandle> handleResult = allocateHandle();
    if(!handleResult){
        eraseUnusedSource(sourceName);
        return false;
    }
    instance.handle = *handleResult;
    instance.sourceName = sourceName;
    instance.uv0 = mesh.uv0Stream();
    instance.colors = mesh.colorStream();
    instance.skin = skin.influences();
    instance.skeletonJointCount = static_cast<u32>(skin.inverseBindMatrices().size());
    instance.inverseBindMatrices = skin.inverseBindMatrices();
    instance.meshletBounds = mesh.meshletBounds();
    instance.meshletLocalVertexRefs = mesh.meshletLocalVertexRefs();
    instance.meshletPrimitiveIndices = mesh.meshletPrimitiveIndices();
    instance.solidTriangleWords = mesh.solidTriangleWords();
    instance.dirtyFlags = RuntimeMeshDirtyFlag::All;
    if(!__hidden_runtime_cache_storage::BuildRuntimeZippedPayload(mesh, skin.influences(), scratchArena, instance)){
        eraseUnusedSource(sourceName);
        return false;
    }

    if(!uploadRuntimeMeshBuffers(instance, scratchArena)){
        eraseUnusedSource(sourceName);
        return false;
    }
    instance.dirtyFlags &= ~RuntimeMeshDirtyFlag::All;

    if(!instance.valid()){
        eraseUnusedSource(sourceName);
        NWB_LOGGER_ERROR(NWB_TEXT("MeshSkinningRuntimeCache: prepared runtime mesh is incomplete"));
        return false;
    }

    const RuntimeMeshHandle handle = instance.handle;
    auto [storedInstance, instanceInserted] = m_instances.try_emplace(entity, Move(instance));
    if(!instanceInserted){
        eraseUnusedSource(sourceName);
        NWB_LOGGER_ERROR(NWB_TEXT("MeshSkinningRuntimeCache: runtime instance identity was already registered"));
        return false;
    }
    ScopeExit discardInstance([&]()noexcept{ m_instances.erase(storedInstance); });
    const auto [storedEntity, handleInserted] = m_handleToEntity.emplace(handle.value, entity);
    if(!handleInserted){
        m_instances.erase(storedInstance);
        discardInstance.release();
        eraseUnusedSource(sourceName);
        NWB_LOGGER_ERROR(NWB_TEXT("MeshSkinningRuntimeCache: runtime mesh handle was already registered"));
        return false;
    }

    ++source.referenceCount;
    component.runtimeMesh = handle;
    discardInstance.release();
    return true;
}

Expected<NotNull<MeshSkinningRuntimeCache::MeshSkinningSource*>> MeshSkinningRuntimeCache::ensureSourceLoaded(const Core::Assets::AssetRef<Skin>& skinAsset){
    NWB_ASSERT(skinAsset.valid());

    const Name& sourceName = skinAsset.name();
    const auto foundSource = m_sources.find(sourceName);
    if(foundSource != m_sources.end()){
        MeshSkinningSource& cachedSource = foundSource.value();
        return MakeNotNull(&cachedSource);
    }

    auto loadedSkinAsset = m_assetManager.loadTypedSync<Skin>(skinAsset.name(), __hidden_runtime_cache_storage::s_AssetLoadContext);
    if(!loadedSkinAsset)
        return MakeUnexpected(Failure{});

    auto loadedMeshAsset = m_assetManager.loadTypedSync<Mesh>((*loadedSkinAsset)->mesh().name(), __hidden_runtime_cache_storage::s_AssetLoadContext);
    if(!loadedMeshAsset)
        return MakeUnexpected(Failure{});

    MeshSkinningSource source;
    source.meshAsset = Move(*loadedMeshAsset);
    source.skinAsset = Move(*loadedSkinAsset);

    auto [stored, inserted] = m_sources.try_emplace(sourceName, Move(source));
    if(!inserted){
        NWB_LOGGER_ERROR(NWB_TEXT("MeshSkinningRuntimeCache: source identity was already registered"));
        return MakeUnexpected(Failure{});
    }
    MeshSkinningSource& storedSource = stored.value();
    return MakeNotNull(&storedSource);
}

b8 MeshSkinningRuntimeCache::uploadRuntimeMeshBuffers(MeshSkinningRuntimeInstance& instance, Core::Alloc::ScratchArena& scratchArena){
    if(!__hidden_runtime_cache_storage::ValidateRuntimeMeshUploadPayload(instance))
        return false;

    const b8 rtSupported = m_graphics.queryFeatureSupport(Core::Feature::RayTracingAccelStruct);
    const Core::ResourceQueueSharing::Mask sharedQueues = Core::ResourceQueueSharing::GraphicsAndAsyncCompute;
    // Software and hybrid tails read raw position/index buffers; keep views even with HWRT.

    b8 uploaded = CreateMeshSkinningLocalBoundsBuffers(m_graphics, instance);
    uploaded = __hidden_runtime_cache_storage::AssignRuntimeBuffer<Float3U>(instance, s_RestPositionsSuffix, instance.restPositions, false, s_RuntimeCacheRestPositionLabel, m_graphics, false, false, sharedQueues, false, instance.restPositionBuffer) && uploaded;
    uploaded = __hidden_runtime_cache_storage::AssignRuntimeBuffer<Half4U>(instance, s_RestNormalsSuffix, instance.restNormals, false, s_RuntimeCacheRestNormalLabel, m_graphics, false, false, sharedQueues, false, instance.restNormalBuffer) && uploaded;
    uploaded = __hidden_runtime_cache_storage::AssignRuntimeBuffer<Half4U>(instance, s_RestTangentsSuffix, instance.restTangents, false, s_RuntimeCacheRestTangentLabel, m_graphics, false, false, sharedQueues, false, instance.restTangentBuffer) && uploaded;
    uploaded = __hidden_runtime_cache_storage::AssignRuntimeBuffer<Float3U>(instance, s_SkinnedPositionsSuffix, instance.restPositions, true, s_RuntimeCacheSkinnedPositionLabel, m_graphics, true, rtSupported, sharedQueues, false, instance.skinnedPositionBuffer) && uploaded;
    uploaded = __hidden_runtime_cache_storage::AssignRuntimeBuffer<Half4U>(instance, s_SkinnedNormalsSuffix, instance.restNormals, true, s_RuntimeCacheSkinnedNormalLabel, m_graphics, false, false, sharedQueues, false, instance.skinnedNormalBuffer) && uploaded;
    uploaded = __hidden_runtime_cache_storage::AssignRuntimeBuffer<Half4U>(instance, s_SkinnedTangentsSuffix, instance.restTangents, true, s_RuntimeCacheSkinnedTangentLabel, m_graphics, false, false, sharedQueues, false, instance.skinnedTangentBuffer) && uploaded;
    uploaded = __hidden_runtime_cache_storage::AssignRuntimeBuffer<Float2U>(instance, s_Uv0Suffix, instance.uv0, false, s_RuntimeCacheUv0Label, m_graphics, false, false, sharedQueues, false, instance.uv0Buffer) && uploaded;
    uploaded = __hidden_runtime_cache_storage::AssignRuntimeBuffer<Half4U>(instance, s_ColorsSuffix, instance.colors, false, s_RuntimeCacheColorLabel, m_graphics, false, false, sharedQueues, false, instance.colorBuffer) && uploaded;
    uploaded = __hidden_runtime_cache_storage::AssignRuntimeBuffer<MeshletDesc>(instance, s_MeshletsSuffix, instance.meshlets, false, s_RuntimeCacheMeshletDescriptorLabel, m_graphics, false, false, sharedQueues, false, instance.meshletDescBuffer) && uploaded;
    uploaded = __hidden_runtime_cache_storage::AssignRuntimeBuffer<MeshletBounds>(instance, s_MeshletBoundsSuffix, instance.meshletBounds, true, s_RuntimeCacheMeshletBoundsLabel, m_graphics, true, false, sharedQueues, false, instance.meshletBoundsBuffer) && uploaded;
    uploaded = __hidden_runtime_cache_storage::AssignPaddedRawRuntimeBuffer(instance, s_MeshletPositionRefDeltasSuffix, instance.meshletPositionRefDeltas, false, s_RuntimeCacheMeshletPositionRefDeltaLabel, m_graphics, scratchArena, instance.meshletPositionRefDeltaBuffer) && uploaded;
    uploaded = __hidden_runtime_cache_storage::AssignPaddedRawRuntimeBuffer(instance, s_MeshletAttributeRefDeltasSuffix, instance.meshletAttributeRefDeltas, false, s_RuntimeCacheMeshletAttributeRefDeltaLabel, m_graphics, scratchArena, instance.meshletAttributeRefDeltaBuffer) && uploaded;
    uploaded = __hidden_runtime_cache_storage::AssignRuntimeBuffer<MeshletLocalVertexRef>(instance, s_MeshletLocalVertexRefsSuffix, instance.meshletLocalVertexRefs, false, s_RuntimeCacheMeshletLocalVertexRefLabel, m_graphics, false, false, sharedQueues, false, instance.meshletLocalVertexRefBuffer) && uploaded;
    uploaded = __hidden_runtime_cache_storage::AssignPaddedRawRuntimeBuffer(instance, s_MeshletPrimitiveIndicesSuffix, instance.meshletPrimitiveIndices, false, s_RuntimeCacheMeshletPrimitiveIndexLabel, m_graphics, scratchArena, instance.meshletPrimitiveIndexBuffer) && uploaded;
    uploaded = __hidden_runtime_cache_storage::AssignRuntimeBuffer<u32>(instance, s_AttributeSkinsSuffix, instance.attributeSkins, false, s_RuntimeCacheAttributeSkinLabel, m_graphics, false, false, sharedQueues, false, instance.attributeSkinBuffer) && uploaded;

    // Both shadow backends trace triangles; always build the reconstructed index buffer.
    if(uploaded){
        const auto triangleIndices = MeshSkinningTraceGeometry::BuildIndices(instance, scratchArena);
        if(!triangleIndices)
            return false;

        uploaded = __hidden_runtime_cache_storage::AssignRuntimeBuffer<u32>(instance, s_RtTriangleIndicesBufferName, *triangleIndices, false, s_RuntimeCacheRtTriangleIndexLabel, m_graphics, true, rtSupported, sharedQueues, true, instance.triangleIndexBuffer) && uploaded;
    }

    // Per-corner trace attributes seeded from bind-pose; repack overwrites normals per frame.
    if(uploaded){
        const auto triangleAttributes = MeshSkinningTraceGeometry::BuildAttributes(instance, scratchArena);
        if(!triangleAttributes)
            return false;

        // The per-frame skinned-normal repack pass writes this buffer as a raw UAV in place.
        uploaded = __hidden_runtime_cache_storage::AssignRuntimeBuffer<AttribGpu>(instance, s_RtTriangleAttributesBufferName, *triangleAttributes, true, s_RuntimeCacheRtTriangleAttributeLabel, m_graphics, true, false, sharedQueues, false, instance.attributeBuffer) && uploaded;
    }

    return uploaded;
}

Expected<RuntimeMeshHandle> MeshSkinningRuntimeCache::allocateHandle(){
    const Expected<u64> handleValue = TryAllocateRuntimeMeshHandleValue(m_handleToEntity, m_nextHandleValue);
    if(!handleValue)
        return MakeUnexpected(Failure{});

    RuntimeMeshHandle handle;
    handle.value = *handleValue;
    return handle;
}

void MeshSkinningRuntimeCache::releaseRuntimeMesh(const Core::ECS::EntityID entity)noexcept{
    const auto foundInstance = m_instances.find(entity);
    if(foundInstance == m_instances.end())
        return;

    eraseInstance(foundInstance);
}

MeshSkinningRuntimeCache::InstanceMap::iterator MeshSkinningRuntimeCache::eraseInstance(const InstanceMap::iterator it)noexcept{
    const MeshSkinningRuntimeInstance& instance = it.value();
    m_handleToEntity.erase(instance.handle.value);
    releaseSource(instance.sourceName);
    return m_instances.erase(it);
}

void MeshSkinningRuntimeCache::releaseSource(const Name& sourceName)noexcept{
    const auto foundSource = m_sources.find(sourceName);
    if(foundSource == m_sources.end())
        return;

    MeshSkinningSource& source = foundSource.value();
    if(ReleaseSkinningSourceReference(source.referenceCount))
        m_sources.erase(foundSource);
}

void MeshSkinningRuntimeCache::eraseUnusedSource(const Name& sourceName)noexcept{
    const auto foundSource = m_sources.find(sourceName);
    if(foundSource != m_sources.end() && foundSource.value().referenceCount == 0u)
        m_sources.erase(foundSource);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CreateMeshSkinningLocalBoundsBuffers(Core::GraphicsRuntime& graphics, MeshSkinningRuntimeInstance& instance){
    instance.deformationState.invalidateCurrent();
    if(!ValidateMeshSkinningLocalBoundsMeshletCount(instance.meshlets.size(), NWB_RUNTIME_MESH_BOUNDS_BYTE_SIZE))
        return false;
    const auto partialName = DeriveRuntimeResourceName(instance.sourceName, instance.handle.value, instance.editRevision, s_MeshletLocalBoundsSuffix);
    const auto outputName = DeriveRuntimeResourceName(instance.sourceName, instance.handle.value, instance.editRevision, s_LocalBoundsSuffix);
    if(!partialName || !outputName){
        NWB_LOGGER_ERROR(NWB_TEXT("MeshSkinningSystem: failed to derive runtime local bounds buffer names"));
        return false;
    }
    Core::BufferDesc desc;
    desc.setByteSize(ComputeMeshletLocalBoundsByteSize(instance.meshlets.size(), NWB_RUNTIME_MESH_BOUNDS_BYTE_SIZE)).setCanHaveUAVs(true).setCanHaveRawViews(true).setQueueSharing(Core::ResourceQueueSharing::GraphicsAndAsyncCompute).setDebugName(partialName);
    auto partialsResult = graphics.createBuffer(desc);
    if(!partialsResult){
        NWB_LOGGER_ERROR(NWB_TEXT("MeshSkinningSystem: failed to create runtime local bounds partials"));
        return false;
    }
    Core::BufferHandle partials = Move(*partialsResult);
    desc.setByteSize(NWB_RUNTIME_MESH_BOUNDS_BYTE_SIZE).setDebugName(outputName);
    auto outputResult = graphics.createBuffer(desc);
    if(!outputResult){
        NWB_LOGGER_ERROR(NWB_TEXT("MeshSkinningSystem: failed to create runtime local bounds output"));
        return false;
    }
    Core::BufferHandle output = Move(*outputResult);
    instance.meshletLocalBoundsBuffer = Move(partials);
    instance.localBoundsBuffer = Move(output);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

