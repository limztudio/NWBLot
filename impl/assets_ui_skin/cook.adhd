[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if defined(NWB_COOK)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_ui_skin/ui_skin_binary_codec.adhd.h>

#include <core/assets/cook_metadata.h>
#include <core/common/log.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 UiSkinAssetCodec::serialize(const Core::Assets::IAsset& asset, Core::Assets::AssetBytes& outBinary)const{
    if(!checkSerializeAssetType(asset, FOUNDATION_TEXT("UiSkinAssetCodec::serialize")))
        return false;
    const UiSkin& skin = *MakeNotNull(checked_cast<const UiSkin*>(&asset));
    if(!skin.validatePayload())
        return false;

    return UiSkinBinaryCodec().serialize(
        skin.texture(),
        skin.atlasWidth(),
        skin.atlasHeight(),
        skin.referenceDensity(),
        skin.regions(),
        skin.palette(),
        skin.typography(),
        outBinary
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<UiSkin> BuildUiSkinAsset(const UiSkinCookEntry& entry, Core::Assets::AssetArena& arena){
    if(!ValidateUiSkinCookRegionCount(entry.regions.size()))
        return MakeUnexpected(Failure{});
    UiSkin candidate(arena, entry.virtualPath);
    UiSkin::RegionVector regions(entry.regions.begin(), entry.regions.end(), arena);
    candidate.setAtlas(entry.texture, entry.atlasWidth, entry.atlasHeight, entry.referenceDensity, Move(regions));
    candidate.setPalette(entry.palette);
    candidate.setTypography(entry.typography);
    if(entry.completeToolkitSkin ? !ValidateUiSkinToolkitContract(candidate) : !candidate.validatePayload())
        return MakeUnexpected(Failure{});
    return candidate;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<UiSkinCookEntry> ParseUiSkinCookMetadata(const Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena&){
    const auto headerResult = ParseUiSkinCookHeader(virtualPath, nwbFilePath, asset);
    if(!headerResult)
        return MakeUnexpected(Failure{});
    const auto regionsResult = ReadUiSkinRegionsMetadata(nwbFilePath, asset);
    if(!regionsResult)
        return MakeUnexpected(regionsResult.error());

    UiSkinCookEntry parsed(arena);
    parsed.texture = headerResult->texture;
    parsed.virtualPath = headerResult->virtualPath;
    parsed.atlasWidth = headerResult->atlasWidth;
    parsed.atlasHeight = headerResult->atlasHeight;
    parsed.referenceDensity = headerResult->referenceDensity;
    parsed.completeToolkitSkin = headerResult->completeToolkitSkin;
    parsed.palette = headerResult->palette;
    parsed.typography = headerResult->typography;
    parsed.regions.reserve(regionsResult->size());
    for(const Core::Metascript::Value& value : *regionsResult){
        auto regionResult = ParseUiSkinRegion(nwbFilePath, value);
        if(!regionResult)
            return MakeUnexpected(Failure{});
        parsed.regions.push_back(*regionResult);
    }

    if(!BuildUiSkinAsset(parsed, arena))
        return MakeUnexpected(Failure{});
    return parsed;
}

Expected<UiSkinCookEntry> ParseUiSkinCookMetadata(const Path& assetRoot, const AStringView virtualRoot, const Path& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena){
    return Core::Assets::ParseCookMetadataDocument<UiSkinCookEntry, &ParseUiSkinCookMetadata>(assetRoot, virtualRoot, nwbFilePath, doc, s_UiSkinDiagnosticPrefix, arena, scratchArena);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


