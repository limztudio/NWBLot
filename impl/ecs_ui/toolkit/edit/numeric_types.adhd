////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_NumericEditMaxBytes = 128u;
const usize s_NumericEditMaxHistoryRecords = 64u;
const usize s_NumericEditHistoryBytesFactor = 128u;
const i64 s_NumericEditMaxI64 = 9223372036854775807ll;
const i64 s_NumericEditMinI64 = -s_NumericEditMaxI64 - 1ll;
const f64 s_NumericEditMaxF64 = 1.79769313486231570815e+308;
const f64 s_NumericEditMinF64 = -s_NumericEditMaxF64;
const i64 s_DefaultIntegerEditValue = 0ll;
const f64 s_DefaultFloatEditValue = 0.0;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> NumericParseStatus{
    Complete,
    Incomplete,
    Invalid,
    OutOfRange,
}

enum<u8> NumericBoundsPolicy{
    Reject,
    Clamp,
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class IntegerBounds{
    public i64 minimum = s_NumericEditMinI64;
    public i64 maximum = s_NumericEditMaxI64;
    public NumericBoundsPolicy policy = NumericBoundsPolicy::Reject;
}

class FloatBounds{
    public f64 minimum = s_NumericEditMinF64;
    public f64 maximum = s_NumericEditMaxF64;
    public NumericBoundsPolicy policy = NumericBoundsPolicy::Reject;
}

class NumericEditResult{
    public b8 valid = false;
    public b8 committed = false;
    public b8 valueChanged = false;
    public b8 cancelled = false;
    public b8 rejected = false;
    public b8 clamped = false;
    public b8 restored = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateIntegerBounds(in IntegerBounds bounds){
    return bounds.minimum <= bounds.maximum && (bounds.policy == NumericBoundsPolicy::Reject || bounds.policy == NumericBoundsPolicy::Clamp);
}

b8 ValidateFloatBounds(in FloatBounds bounds){
    return IsFinite(VectorDouble(bounds.minimum, bounds.maximum, 0.0, 0.0)) && bounds.minimum <= bounds.maximum && (bounds.policy == NumericBoundsPolicy::Reject || bounds.policy == NumericBoundsPolicy::Clamp);
}

NumericParseStatus ToNumericParseStatus(in u8 status){
    if(status == s_NumericGrammarComplete)
        return NumericParseStatus::Complete;
    if(status == s_NumericGrammarIncomplete)
        return NumericParseStatus::Incomplete;
    return NumericParseStatus::Invalid;
}

Expected<i64, NumericParseStatus> ParseIntegerDraft(in StringView text){
    const StringView trimmed = TrimView(text);
    const NumericParseStatus status = ToNumericParseStatus(ClassifyIntegerGrammar(trimmed));
    if(status != NumericParseStatus::Complete)
        return MakeUnexpected(status);
    StringView number = trimmed;
    if(trimmed.front() == '+')
        number = trimmed.substr(1u);
    const Expected<i64> value = ParseI64(number);
    if(!value.has_value())
        return MakeUnexpected(NumericParseStatus::OutOfRange);
    return value.value();
}

Expected<f64, NumericParseStatus> ParseFloatDraft(in StringView text){
    const StringView trimmed = TrimView(text);
    const NumericParseStatus status = ToNumericParseStatus(ClassifyFloatGrammar(trimmed));
    if(status != NumericParseStatus::Complete)
        return MakeUnexpected(status);
    StringView number = trimmed;
    if(trimmed.front() == '+')
        number = trimmed.substr(1u);
    const Expected<f64> value = ParseF64(number);
    if(!value.has_value() || !IsFinite(VectorDouble(value.value())))
        return MakeUnexpected(NumericParseStatus::OutOfRange);
    return value.value();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsNumericValueOutOfRange(in i64 value, in IntegerBounds bounds){
    return value < bounds.minimum || value > bounds.maximum;
}

b8 IsNumericValueOutOfRange(in f64 value, in FloatBounds bounds){
    return value < bounds.minimum || value > bounds.maximum;
}

i64 ClampNumericValueToBounds(in i64 value, in IntegerBounds bounds){
    if(value < bounds.minimum)
        return bounds.minimum;
    return bounds.maximum;
}

f64 ClampNumericValueToBounds(in f64 value, in FloatBounds bounds){
    if(value < bounds.minimum)
        return bounds.minimum;
    return bounds.maximum;
}

NumericParseStatus EvaluateNumericBoundsStatus<ValueT, BoundsT>(
    in b8 boundsValid,
    in Expected<ValueT, NumericParseStatus> parsed,
    in BoundsT bounds
){
    if(!boundsValid)
        return NumericParseStatus::Invalid;
    if(!parsed.has_value())
        return parsed.error();
    if(IsNumericValueOutOfRange(parsed.value(), bounds))
        return NumericParseStatus::OutOfRange;
    return NumericParseStatus::Complete;
}

NumericParseStatus EvaluateIntegerDraftStatus(in StringView text, in IntegerBounds bounds){
    return EvaluateNumericBoundsStatus(ValidateIntegerBounds(bounds), ParseIntegerDraft(text), bounds);
}

NumericParseStatus EvaluateFloatDraftStatus(in StringView text, in FloatBounds bounds){
    return EvaluateNumericBoundsStatus(ValidateFloatBounds(bounds), ParseFloatDraft(text), bounds);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 HasIntegerEditValueChanged(in i64 candidate, in i64 value){
    return candidate != value;
}

b8 HasFloatEditBitsChanged(in f64 candidate, in f64 value){
    return bit_cast<u64>(candidate) != bit_cast<u64>(value);
}

b8 HasCanonicalDraftChanged(in StringView formatted, in StringView currentDraft){
    return formatted != currentDraft;
}

[cpp_unwind] Expected<b8, ErrorCode> FinalizeCanonicalNumericDraft(in StringView formattedText, in b8 changed, in b8 draftUpdated, mut String outAcceptedDraft){
    if(!draftUpdated)
        return MakeUnexpected(MakeErrorCode(ErrorCondition::invalid_argument));
    outAcceptedDraft.reserve(formattedText.size());
    outAcceptedDraft.clear();
    outAcceptedDraft.append(formattedText);
    return changed;
}

b8 FinalizeNumericDraftTextUpdate(in b8 draftUpdated, mut u64 inOutRevision){
    if(!draftUpdated)
        return false;
    AdvanceNonWrappingRevision(inOutRevision);
    return true;
}

void MergeNumericEditResult(in NumericEditResult delta, mut NumericEditResult inOutResult){
    inOutResult.valid = inOutResult.valid && delta.valid;
    inOutResult.committed = inOutResult.committed || delta.committed;
    inOutResult.valueChanged = inOutResult.valueChanged || delta.valueChanged;
    inOutResult.cancelled = inOutResult.cancelled || delta.cancelled;
    inOutResult.rejected = inOutResult.rejected || delta.rejected;
    inOutResult.clamped = inOutResult.clamped || delta.clamped;
    inOutResult.restored = inOutResult.restored || delta.restored;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

