    EXPECT_NE(GeneratedSourceView(utf8DecodeRes).find("::TryDecodeUtf8Scalar("), usize.max);
    EXPECT_NE(GeneratedSourceView(utf8DecodeRes).find("::TryDecodeUtf8CodePoint("), usize.max);
    EXPECT_NE(GeneratedSourceView(utf8DecodeRes).find("::IsUtf8ScalarBoundary("), usize.max);

    ExpectCompileFails(arena, s_SuiteBadUtf8DecodeConstOutSource, "impl/bad_utf8_const.adhd");
    ExpectCompileFails(arena, "b8 BadUtf8Boundary(in StringView text) {\r\n    return IsUtf8ScalarBoundary(text, 1.0f);\r\n}\r\n", "impl/bad_utf8_boundary.adhd");
    ExpectCompileFails(arena, "usize BadTempSubstr(in String text) {\r\n    StringView view = TrimView(text.substr(1u));\r\n    return view.size();\r\n}\r\n", "impl/bad_temp_substr.adhd");
    ExpectCompileFails(arena, s_SuiteBadTempMemberViewVarSource, "impl/bad_temp_member.adhd");
    ExpectCompileFails(arena, s_SuiteBadReturnLocalViewAliasSource, "impl/bad_ret_alias.adhd");
    ExpectCompileFails(arena, s_SuiteBadShorterBlockViewAssignSource, "impl/bad_outer_assign.adhd");
    ExpectCompileFails(arena, "void BadMutateView(in StringView v) {\r\n    v.front() = 65u;\r\n}\r\n", "impl/bad_mut_view.adhd");
}

void VerifyAdhdCompiler_LiteralOnlyUnitsAvoidEngineDependenciesAndComplexUnitsKeepThem(){
    AdhdTestArena arena = AdhdTestArena();
    const StringView s_NameOnly = "const Name s_First = \"first\";\r\nconst Name s_Second = \"second\";\r\n";
    CompileResult names = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(s_NameOnly, "core/input/names.adhd", arena.arena, names));
    const StringView namesHeader = GeneratedHeaderView(names);
    const StringView namesSource = GeneratedSourceView(names);
    EXPECT_NE(namesHeader.find("#include <global/name.h>"), usize.max);
    EXPECT_EQ(namesHeader.find("#include <core/"), usize.max);
    EXPECT_EQ(namesSource.find("#include <core/"), usize.max);

    const StringView s_Scalars = "const u8 s_Byte = 255u;\r\nconst i32 s_Negative = -17;\r\nconst f32 s_Float = -1.25f;\r\nconst b8 s_Flag = true;\r\nconst u64 s_Size = 64u * 1024u * 1024u;\r\nconst u32 s_Base = 8u;\r\nconst u32 s_Mask = s_Base - 1u;\r\nconst StringView s_Text = \"a\\tb\";\r\n";
    CompileResult scalars = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(s_Scalars, "core/input/scalars.adhd", arena.arena, scalars));
    const StringView scalarHeader = GeneratedHeaderView(scalars);
    const StringView scalarSource = GeneratedSourceView(scalars);
    EXPECT_NE(scalarHeader.find("#include <global/type.h>"), usize.max);
    EXPECT_EQ(scalarHeader.find("#include <core/"), usize.max);
    EXPECT_EQ(scalarSource.find("#include <core/"), usize.max);

    CompileResult limit = CompileResult(arena.arena);
    ASSERT_TRUE(Compile("const u32 s_Limit = u32.max;\r\n", "core/input/limit.adhd", arena.arena, limit));
    EXPECT_NE(GeneratedHeaderView(limit).find("#include <core/assets/ref.h>"), usize.max);
    EXPECT_NE(GeneratedSourceView(limit).find("#include <core/task/cpu/scheduler.h>"), usize.max);

    CompileResult castRes = CompileResult(arena.arena);
    ASSERT_TRUE(Compile("const u32 s_Cast = cast<u32>(1u);\r\n", "core/input/cast.adhd", arena.arena, castRes));
    EXPECT_NE(GeneratedHeaderView(castRes).find("#include <core/assets/ref.h>"), usize.max);

    CompileResult nameAndScalar = CompileResult(arena.arena);
    ASSERT_TRUE(Compile("const Name s_First = \"first\";\r\nconst u32 s_Value = 1u;\r\n", "core/input/name_and_scalar.adhd", arena.arena, nameAndScalar));
    EXPECT_NE(GeneratedHeaderView(nameAndScalar).find("#include <core/assets/ref.h>"), usize.max);

    CompileResult mixed = CompileResult(arena.arena);
    ASSERT_TRUE(Compile("const Name s_First = \"first\";\r\nu32 Value(){ return 1u; }\r\n", "core/input/mixed.adhd", arena.arena, mixed));
    EXPECT_NE(GeneratedHeaderView(mixed).find("#include <core/assets/ref.h>"), usize.max);
    EXPECT_NE(GeneratedSourceView(mixed).find("#include <core/task/cpu/scheduler.h>"), usize.max);

    CompileResult constructed = CompileResult(arena.arena);
    ASSERT_TRUE(Compile("const Name s_First = Name(\"first\");\r\n", "core/input/constructed.adhd", arena.arena, constructed));
    EXPECT_NE(GeneratedHeaderView(constructed).find("#include <core/assets/ref.h>"), usize.max);
}

