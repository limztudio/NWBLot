#include <impl/ecs_render/shader/shader_system.adhd>
#include <impl/ecs_render/raytrace/ray_trace_material_resources.adhd>
#include <impl/ecs_render/raytrace/prepared_builds.adhd>
#include <impl/ecs_render/kernel/descriptor_register_utils.adhd>
#include <impl/ecs_render/raytrace/renderer_raytracing_state.adhd>
#include <impl/ecs_render/shadow/rt_shadow_state.adhd>
#include <impl/ecs_render/raytrace/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[modular]
class SoftwareBvhBuilder : NoCopy{
    private mut GraphicsRuntime m_graphics;
    private mut RendererShaderSystem m_shaderSystem;
    private mut RtSceneBvhState m_state;

    public SoftwareBvhBuilder(mut GraphicsRuntime graphics, mut RendererShaderSystem shaderSystem, mut RtSceneBvhState state){
        this.m_graphics = graphics;
        this.m_shaderSystem = shaderSystem;
        this.m_state = state;
    }

    [cpp_unwind]
    public void releaseSwBvhScratchHeapHandles();
    [cpp_unwind]
    public b8 ensureSceneBvhBuffers(in u32 instanceCount, mut RayTraceMaterialResources materials);
    [cpp_unwind]
    public b8 ensureMeshSwBvhResources(in u32 primitiveCount, mut BufferHandle nodeBuffer, mut BufferHandle parentBuffer, mut GpuDescriptorHandle nodeHeapHandle, mut GpuDescriptorHandle parentHeapHandle);
    public b8 meshSwBvhResourcesReady(in BufferHandle nodeBuffer, in BufferHandle parentBuffer, in GpuDescriptorHandle nodeHeapHandle, in GpuDescriptorHandle parentHeapHandle);
    [cpp_unwind]
    public b8 buildMeshSwBvhPrepared(
        in u32 positionHeapSlot,
        in u32 triangleIndexHeapSlot,
        in u32 primitiveCount,
        in VectorSingle aabbMin,
        in VectorSingle aabbMax,
        in GpuDescriptorHandle nodeHeapHandle,
        in GpuDescriptorHandle parentHeapHandle,
        mut CommandList commandList,
        mut BufferHandle nodeBuffer,
        mut BufferHandle parentBuffer
    );
    [cpp_unwind]
    public b8 refitMeshSwBvhPrepared(
        in u32 positionHeapSlot,
        in u32 triangleIndexHeapSlot,
        in u32 primitiveCount,
        in GpuDescriptorHandle nodeHeapHandle,
        in GpuDescriptorHandle parentHeapHandle,
        mut CommandList commandList,
        mut BufferHandle nodeBuffer,
        mut BufferHandle parentBuffer
    );
    [cpp_unwind]
    private b8 ensureBvhSortPipeline();
    [cpp_unwind]
    private b8 ensureBvhSortBuffers(in usize paddedCount);
    [cpp_unwind]
    private b8 bvhBitonicSort(mut CommandList commandList, in u32 paddedCount);
    [cpp_unwind]
    private b8 ensureBvhBuildPipeline();
    [cpp_unwind]
    private b8 ensureBvhVisitCounterBuffer(in usize primitiveCount);
    [cpp_unwind]
    private b8 createMeshBvhStorage(in usize primitiveCount, mut BufferHandle nodeBuffer, mut BufferHandle parentBuffer, mut GpuDescriptorHandle nodeHeapHandle, mut GpuDescriptorHandle parentHeapHandle);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[modular]
class MeshHeapHandleGather{
    private mut GpuDescriptorHeap m_heap;
    private mut RtMeshHeapHandleCache m_cache;

    public MeshHeapHandleGather(mut GpuDescriptorHeap heap, mut RtMeshHeapHandleCache cache){
        this.m_heap = heap;
        this.m_cache = cache;
    }

    public void begin();
    public Expected<GpuDescriptorHandle> acquire(in BufferHandle bufferHandle);
    public void sweep();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 HasValidMeshTriangleIndexCount(in u32 primitiveIndexCount){
    return primitiveIndexCount != 0u && (primitiveIndexCount % s_RayTracingTriangleIndexCount) == 0u;
}

u32 ComputeMeshTrianglePrimitiveCount(in u32 primitiveIndexCount){
    return primitiveIndexCount / s_RayTracingTriangleIndexCount;
}

b8 MeshSwBvhResourcesReady(
    in RtSceneBvhState state,
    in BufferHandle nodeBuffer,
    in BufferHandle parentBuffer,
    in GpuDescriptorHandle nodeHeapHandle,
    in GpuDescriptorHandle parentHeapHandle
){
    return
        nodeBuffer.valid()
        && parentBuffer.valid()
        && IsDescriptorClass(nodeHeapHandle, GpuDescriptorClass::StorageBuffer)
        && IsDescriptorClass(parentHeapHandle, GpuDescriptorClass::StorageBuffer)
        && state.m_bvhSortPipeline
        && state.m_bvhSortKeysBuffer
        && state.m_bvhSortPayloadBuffer
        && IsDescriptorClass(state.m_bvhSortKeysHeapHandle, GpuDescriptorClass::StorageBuffer)
        && IsDescriptorClass(state.m_bvhSortPayloadHeapHandle, GpuDescriptorClass::StorageBuffer)
        && state.m_bvhMortonPipeline
        && state.m_bvhTopologyPipeline
        && state.m_bvhFitPipeline
        && state.m_bvhVisitCounterBuffer
        && IsDescriptorClass(state.m_bvhVisitCounterHeapHandle, GpuDescriptorClass::StorageBuffer)
    ;
}

u32 AdvanceAccelerationRefitCount(in b8 performRefit, in u32 refitsSinceRebuild){
    if(performRefit)
        return refitsSinceRebuild + 1u;
    return 0u;
}

b8 ShouldRefitRuntimeMeshAcceleration(in b8 runtimeMesh, in b8 firstBuild, in u32 refitsSinceRebuild, in u32 primitiveCount){
    if(!runtimeMesh || firstBuild)
        return false;
    return refitsSinceRebuild < AdaptiveRefitsBeforeRebuild(primitiveCount);
}


