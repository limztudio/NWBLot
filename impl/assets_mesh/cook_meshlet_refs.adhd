#include <impl/assets_mesh/cook_meshlet_ref_encoding.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


EncodedMeshletRefDeltaStatus CheckEncodedMeshletRefDeltas(
    in MeshletDesc meshlet,
    in u32 sourcePositionRefOffset,
    in u32 sourceAttributeRefOffset,
    in Span<MeshletPositionStreamRef> positionRefs,
    in Span<MeshletAttributeStreamRef> attributeRefs,
    in Span<u8> positionDeltas,
    in Span<u8> attributeDeltas,
    in b8 skinRequired
){
    const Expected<usize> encodedPositionBytes = TryComputeMeshletEncodedPositionRefByteCount(meshlet, skinRequired);
    const Expected<usize> encodedAttributeBytes = TryComputeMeshletEncodedAttributeRefByteCount(meshlet);
    if(!encodedPositionBytes.has_value() || !encodedAttributeBytes.has_value())
        return EncodedMeshletRefDeltaStatus::InvalidWidth;
    if(
        cast<usize>(meshlet.positionRefOffset) > positionDeltas.size()
        || encodedPositionBytes.value() != positionDeltas.size() - cast<usize>(meshlet.positionRefOffset)
        || cast<usize>(meshlet.attributeRefOffset) > attributeDeltas.size()
        || encodedAttributeBytes.value() != attributeDeltas.size() - cast<usize>(meshlet.attributeRefOffset)
    )
        return EncodedMeshletRefDeltaStatus::ByteCountMismatch;

    for(u32 localPositionIndex = 0u; localPositionIndex < MeshletPositionCount(meshlet); ++localPositionIndex){
        const MeshletPositionStreamRef sourceRef = positionRefs[cast<usize>(sourcePositionRefOffset + localPositionIndex)];
        const Expected<MeshletPositionStreamRef> decodedRef = TryDecodeMeshletPositionRef(positionDeltas, meshlet, localPositionIndex, skinRequired);
        if(!decodedRef.has_value() || !MeshletDecodedPositionRefMatches(decodedRef.value(), sourceRef, skinRequired))
            return EncodedMeshletRefDeltaStatus::PositionDecodeMismatch;
    }

    for(u32 localAttributeIndex = 0u; localAttributeIndex < MeshletAttributeCount(meshlet); ++localAttributeIndex){
        const MeshletAttributeStreamRef sourceRef = attributeRefs[cast<usize>(sourceAttributeRefOffset + localAttributeIndex)];
        const Expected<MeshletAttributeStreamRef> decodedRef = TryDecodeMeshletAttributeRef(attributeDeltas, meshlet, localAttributeIndex);
        if(!decodedRef.has_value() || !MeshletDecodedAttributeRefMatches(decodedRef.value(), sourceRef))
            return EncodedMeshletRefDeltaStatus::AttributeDecodeMismatch;
    }

    return EncodedMeshletRefDeltaStatus::Valid;
}

Expected<MeshletRefChannelWidths> TryPrepareMeshletRefEncoding(
    in Span<MeshletPositionStreamRef> positionRefs,
    in Span<MeshletAttributeStreamRef> attributeRefs,
    in u32 sourcePositionRefOffset,
    in u32 sourceAttributeRefOffset,
    in b8 skinRequired,
    mut MeshletDesc inOutMeshlet
){
    MeshletRefEncodeRange positionRange;
    MeshletRefEncodeRange skinRange;
    MeshletAttributeRefEncodeRanges attributeRanges;

    for(u32 localPositionIndex = 0u; localPositionIndex < MeshletPositionCount(inOutMeshlet); ++localPositionIndex){
        const MeshletPositionStreamRef ref = positionRefs[cast<usize>(sourcePositionRefOffset + localPositionIndex)];
        AddMeshletRefEncodeIndex(ref.position, positionRange);
        if(skinRequired){
            AddMeshletRefEncodeIndex(ref.skin, skinRange);
        }
        else if(ref.skin != s_MeshMissingStreamIndex){
            return makeUnexpected(Failure());
        }
    }

    for(u32 localAttributeIndex = 0u; localAttributeIndex < MeshletAttributeCount(inOutMeshlet); ++localAttributeIndex){
        const MeshletAttributeStreamRef ref = attributeRefs[cast<usize>(sourceAttributeRefOffset + localAttributeIndex)];
        AddMeshletAttributeRefEncodeRanges(ref, attributeRanges);
    }

    inOutMeshlet.positionBase = positionRange.minimum;
    if(skinRequired)
        inOutMeshlet.skinBase = skinRange.minimum;
    else
        inOutMeshlet.skinBase = s_MeshMissingStreamIndex;
    StoreMeshletAttributeRefEncodeBases(attributeRanges, inOutMeshlet);

    MeshletRefChannelWidths widths;
    widths.position = MeshletRefEncodeRangeWidth(positionRange);
    if(skinRequired)
        widths.skin = MeshletRefEncodeRangeWidth(skinRange);
    widths.normal = MeshletRefEncodeRangeWidth(attributeRanges.normal);
    widths.tangent = MeshletRefEncodeRangeWidth(attributeRanges.tangent);
    widths.uv0 = MeshletRefEncodeRangeWidth(attributeRanges.uv0);
    widths.color = MeshletRefEncodeRangeWidth(attributeRanges.color);
    inOutMeshlet.encoding = PackMeshletRefEncoding(widths.position, widths.skin, widths.normal, widths.tangent, widths.uv0, widths.color);
    return widths;
}

Expected<u16> TryFindMeshletPositionRef(in Span<MeshletPositionStreamRef> refs, in MeshletPositionStreamRef targetRef){
    for(usize localIndex = 0u; localIndex < refs.size(); ++localIndex){
        if(refs[localIndex].position != targetRef.position || refs[localIndex].skin != targetRef.skin)
            continue;

        return cast<u16>(localIndex);
    }

    return makeUnexpected(Failure());
}

Expected<u16> TryFindMeshletAttributeRef(in Span<MeshletAttributeStreamRef> refs, in MeshletAttributeStreamRef targetRef){
    for(usize localIndex = 0u; localIndex < refs.size(); ++localIndex){
        const MeshletAttributeStreamRef existing = refs[localIndex];
        if(existing.normal != targetRef.normal || existing.tangent != targetRef.tangent || existing.uv0 != targetRef.uv0 || existing.color != targetRef.color)
            continue;

        return cast<u16>(localIndex);
    }

    return makeUnexpected(Failure());
}

b8 BuildZippedMeshletRefsFixed(
    in StringView metaKind,
    in StringView filePathText,
    in Span<MeshVertexRef> vertexRefs,
    in Span<u32> sourceVertexRefs,
    mut FixedVector<MeshletPositionStreamRef, s_MeshMaxMeshletVertices> outPositionRefs,
    mut FixedVector<MeshletAttributeStreamRef, s_MeshMaxMeshletVertices> outAttributeRefs,
    mut FixedVector<MeshletLocalVertexRef, s_MeshMaxMeshletVertices> outLocalVertexRefs
){
    outPositionRefs.clear();
    outAttributeRefs.clear();
    outLocalVertexRefs.clear();

    for(in u32 vertexRefIndex : sourceVertexRefs){
        const MeshVertexRef source = vertexRefs[cast<usize>(vertexRefIndex)];
        MeshletPositionStreamRef positionRef;
        positionRef.position = source.position;
        positionRef.skin = s_MeshMissingStreamIndex;
        MeshletAttributeStreamRef attributeRef;
        attributeRef.normal = source.normal;
        attributeRef.tangent = source.tangent;
        attributeRef.uv0 = source.uv0;
        attributeRef.color = source.color;

        u16 localPosition = 0u;
        const Expected<u16> foundPosition = TryFindMeshletPositionRef(outPositionRefs, positionRef);
        if(foundPosition.has_value())
            localPosition = foundPosition.value();
        else{
            if(outPositionRefs.size() >= cast<usize>(s_MeshMaxMeshletVertices)){
                error("{} meta '{}': meshlet deformed positions exceed local index limits", metaKind, filePathText);
                return false;
            }
            localPosition = cast<u16>(outPositionRefs.size());
            outPositionRefs.push_back(positionRef);
        }

        u16 localAttribute = 0u;
        const Expected<u16> foundAttribute = TryFindMeshletAttributeRef(outAttributeRefs, attributeRef);
        if(foundAttribute.has_value())
            localAttribute = foundAttribute.value();
        else{
            if(outAttributeRefs.size() >= cast<usize>(s_MeshMaxMeshletVertices)){
                error("{} meta '{}': meshlet attributes exceed local index limits", metaKind, filePathText);
                return false;
            }
            localAttribute = cast<u16>(outAttributeRefs.size());
            outAttributeRefs.push_back(attributeRef);
        }

        MeshletLocalVertexRef localVertexRef;
        localVertexRef.localDeformedPosition = localPosition;
        localVertexRef.localAttribute = localAttribute;
        outLocalVertexRefs.push_back(localVertexRef);
    }

    return true;
}


