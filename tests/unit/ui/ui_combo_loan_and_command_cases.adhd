void VerifyUiComboLoanTests_SameValueApplicationSelectionAfterDeclarationRejectsDeferredPaint(mut UiComboLoanTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    const UiComboLoanAcceptedState displayed = self.accepted();
    ASSERT_TRUE(self.declareCombo(2u));
    const u64 inputGeneration = self.m_state.inputGeneration();
    self.m_state.select(1u);
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.ready());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_NE(self.m_state.inputGeneration(), inputGeneration);
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    self.expectAccepted(displayed);
}

void VerifyUiComboLoanTests_ClosingBetweenDeclarationAndEndKeepsTheApplicationClose(mut UiComboLoanTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    ASSERT_TRUE(self.openByPointer(2u));
    ASSERT_TRUE(self.declareCombo(3u));
    const UiComboLoanAcceptedState displayed = self.accepted();
    self.m_state.close();
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.commitFrame(3u));
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    self.expectAccepted(displayed);
}

void VerifyUiComboLoanTests_ReopeningBetweenDeclarationAndEndCannotPublishTheOldPopupLifetime(mut UiComboLoanTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    ASSERT_TRUE(self.openByPointer(2u));
    ASSERT_TRUE(self.declareCombo(3u));
    const UiComboLoanAcceptedState displayed = self.accepted();
    const u64 inputGeneration = self.m_state.inputGeneration();
    self.m_state.open();
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.commitFrame(3u));
    EXPECT_TRUE(self.m_state.isOpen());
    EXPECT_NE(self.m_state.inputGeneration(), inputGeneration);
    self.expectAccepted(displayed);
}

void VerifyUiComboLoanTests_SourceRevisionBetweenDeclarationAndEndRejectsTheWholeCandidate(mut UiComboLoanTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    ASSERT_TRUE(self.openByPointer(2u));
    ASSERT_TRUE(self.declareCombo(3u));
    const UiComboLoanAcceptedState displayed = self.accepted();
    ++self.m_source.contentRevision;
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.commitFrame(3u));
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    self.expectAccepted(displayed);
}

void VerifyUiComboLoanTests_SourceCountBetweenDeclarationAndEndRejectsEvenWithoutARevisionChange(mut UiComboLoanTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    ASSERT_TRUE(self.declareCombo(2u));
    const UiComboLoanAcceptedState displayed = self.accepted();
    --self.m_source.count;
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    self.expectAccepted(displayed);
}

void VerifyUiComboLoanTests_RevisionCallbackAtDeferredValidationKeepsExplicitApplicationSelection(mut UiComboLoanTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.acceptCallbacks(1u));
    ASSERT_TRUE(self.declareCallbacks(2u));
    const UiComboLoanAcceptedState displayed = self.accepted();
    const u64 inputGeneration = self.m_state.inputGeneration();
    self.m_callbacks.arm(UiComboLoanMutationKind::RevisionSelect, 8u);
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_callbacks.mutations(), 1u);
    EXPECT_NE(self.m_state.inputGeneration(), inputGeneration);
    EXPECT_EQ(self.m_state.selectedKey(), 8u);
    self.expectAccepted(displayed);
}

