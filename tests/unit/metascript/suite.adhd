NWB_ADHD_GTEST(AdhdCompiler, RejectsCyclicTypeAliasesAndRecursiveByValueClassMembers, VerifyAdhdCompiler_RejectsCyclicTypeAliasesAndRecursiveByValueClassMembers)
NWB_ADHD_GTEST(AdhdCompiler, RejectsMismatchedParameterizedInterfaceBoundsDoubleRefAliasesAndEscapingMutLambdas, VerifyAdhdCompiler_RejectsMismatchedParameterizedInterfaceBoundsDoubleRefAliasesAndEscapingMutLambdas)
NWB_ADHD_GTEST(AdhdCompiler, TopologicallyOrdersOutOfOrderDeclarationsAndRejectsAccessViolations, VerifyAdhdCompiler_TopologicallyOrdersOutOfOrderDeclarationsAndRejectsAccessViolations)
