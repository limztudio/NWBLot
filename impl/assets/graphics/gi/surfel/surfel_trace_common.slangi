////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_GI_SURFEL_TRACE_COMMON_SLANGI
#define NWB_GRAPHICS_GI_SURFEL_TRACE_COMMON_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Shared surfel trace body. The including shader selects the trace backend first (gi_sw_trace.slangi or gi_hw_trace.slangi), which provides nwbGiTraceClosest / nwbGiShadeHit.


#include "../constants.h"
#include "../../common/math.slangi"
#include "surfel_runtime.slangi"
#include "surfel_sh.slangi"
#include "surfel_guide.slangi"
#include "surfel_hash.slangi" // nwbSurfelCellCoord / nwbSurfelHashCell


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Snapshot of the previous frame's converged field. The bounce gather reads these global heap entries instead of the live pool this trace writes, so surfel feedback sees a stable frame-start field.
#define g_NwbSurfelSnapshotPool g_NwbHeapSurfelReadOnlyPools[g_NwbSurfelHeapPushConstants.snapshotPoolHeapSlot]
#define g_NwbSurfelSnapshotCellHead g_NwbHeapSurfelReadOnlyUintBuffers[g_NwbSurfelHeapPushConstants.snapshotCellHeadHeapSlot]


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#define NWB_SURFEL_GATHER_FIELD_POOL g_NwbSurfelSnapshotPool
#define NWB_SURFEL_GATHER_FIELD_CELL_HEAD g_NwbSurfelSnapshotCellHead
#define NWB_SURFEL_GATHER_FIELD_CONSTANTS g_NwbSurfelConstants
#define NWB_SURFEL_GATHER_FIELD_INDEX_VALID(id, poolCapacity) ((id) < (poolCapacity))

#include "surfel_gather_field.slangi"

#undef NWB_SURFEL_GATHER_FIELD_INDEX_VALID
#undef NWB_SURFEL_GATHER_FIELD_CONSTANTS
#undef NWB_SURFEL_GATHER_FIELD_CELL_HEAD
#undef NWB_SURFEL_GATHER_FIELD_POOL


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Infinite-bounce gather from the previous-frame surfel snapshot, queried with the face-forwarded hit normal.
half3 nwbSurfelBounceGather(const float3 worldPosition, const float3 queryNormal){
    const uint poolCapacity = uint(g_NwbSurfelConstants.hashPoolFrameDivisor.y);
    half3 irradiance;
    nwbSurfelGatherField(worldPosition, queryNormal, poolCapacity, irradiance);
    return irradiance;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


groupshared float4 s_surfelShR[NWB_SURFEL_RAYS_PER_SURFEL];
groupshared float4 s_surfelShG[NWB_SURFEL_RAYS_PER_SURFEL];
groupshared float4 s_surfelShB[NWB_SURFEL_RAYS_PER_SURFEL];
groupshared uint s_surfelGuideBin[NWB_SURFEL_RAYS_PER_SURFEL];
groupshared float s_surfelGuideObservation[NWB_SURFEL_RAYS_PER_SURFEL];
groupshared float s_surfelGuideUpdated[NWB_SURFEL_GUIDE_BIN_COUNT];


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[numthreads(NWB_SURFEL_RAYS_PER_SURFEL, 1, 1)]
void main(uint3 groupID : SV_GroupID, uint3 groupThreadID : SV_GroupThreadID){
    const uint rayIndex = groupThreadID.x;
    const uint poolCapacity = uint(g_NwbSurfelConstants.hashPoolFrameDivisor.y);
    const uint frameIndex = uint(g_NwbSurfelConstants.hashPoolFrameDivisor.z);
    const uint updateDivisor = max(uint(g_NwbSurfelConstants.hashPoolFrameDivisor.w), 1u);
    const uint maximumRayCount = min(max(uint(g_NwbSurfelConstants.ageRaysTileScreen.y), 1u), NWB_SURFEL_RAYS_PER_SURFEL);

    const uint cursor = frameIndex % updateDivisor;
    const uint surfelIndex = cursor + groupID.x * updateDivisor;

    s_surfelShR[rayIndex] = float4(0.0, 0.0, 0.0, 0.0);
    s_surfelShG[rayIndex] = float4(0.0, 0.0, 0.0, 0.0);
    s_surfelShB[rayIndex] = float4(0.0, 0.0, 0.0, 0.0);
    // On training visits, each traced ray writes its guide slot before the update scans [0, rayCount).

    if(surfelIndex >= poolCapacity)
        return;

    // The workgroup is 64 lanes even after a surfel converges to twelve rays. Load only the two group-wide fields here; pulling a whole NwbSurfel into every lane would fetch SH history in lanes that never trace a ray.
    if(g_NwbSurfelPool[surfelIndex].alive == 0u)
        return;
    const uint sampleCount = g_NwbSurfelPool[surfelIndex].sampleCount;

    // Fresh surfels train all 16 directional cells with 64 rays. Mature surfels keep four uniform rays for exploration and use up to eight guided rays. Counts are group-uniform and need not be powers of two.
    uint rayCount = maximumRayCount;
    if(sampleCount >= NWB_SURFEL_CONVERGED_SAMPLE_COUNT)
        rayCount = min(rayCount, NWB_SURFEL_CONVERGED_RAYS_PER_SURFEL);
    const uint uniformRayCount = sampleCount >= NWB_SURFEL_CONVERGED_SAMPLE_COUNT ? min(rayCount, NWB_SURFEL_CONVERGED_UNIFORM_RAYS_PER_SURFEL) : rayCount;
    const uint guidedRayCount = rayCount - uniformRayCount;
    // The dispatch visits each surfel once per updateDivisor frames. Stagger workgroups over four visits rather than using sampleCount, which saturates at 0xFFFF and would eventually stop guide training.
    // Train on the first mature update as well as every fresh update.
    const bool updateGuide = sampleCount <= NWB_SURFEL_CONVERGED_SAMPLE_COUNT || ((frameIndex / updateDivisor + groupID.x) % NWB_SURFEL_GUIDE_MATURE_UPDATE_INTERVAL == 0u);

    if(rayIndex < rayCount){
        const float normalBias = g_NwbSurfelConstants.coverageRadiusBiasHyst.z;
        const float3 n = g_NwbSurfelPool[surfelIndex].normal;
        const float3 up = abs(n.z) < NWB_FRAME_FALLBACK_AXIS_Z_MAX ? float3(0.0, 0.0, 1.0) : float3(1.0, 0.0, 0.0);
        const float3 tangent = normalize(cross(up, n));
        const float3 bitangent = cross(n, tangent);

        const uint randomSeed = frameIndex * 0x9e3779b9u ^ surfelIndex * 0x85ebca6bu ^ rayIndex * 0xc2b2ae35u;
        uint bin = 0u;
        float inversePdf = NWB_GI_FULL_TURN_RADIANS;
        if(rayIndex < uniformRayCount){
            // The odd stride visits each equal-solid-angle cell once before repeating; frame/surfel phase decorrelates the reduced four-ray uniform subset and gives the fresh 64-ray estimate four samples in every cell.
            const uint phase = nwbSurfelGuideHash(frameIndex * 0x27d4eb2du ^ surfelIndex) % NWB_SURFEL_GUIDE_BIN_COUNT;
            bin = (rayIndex * 5u + phase) % NWB_SURFEL_GUIDE_BIN_COUNT;
        }
        if(guidedRayCount != 0u){
            NwbSurfelGuide guide;
            [unroll]
            for(uint guideLane = 0u; guideLane < NWB_SURFEL_GUIDE_FLOAT4S_PER_SURFEL; ++guideLane)
                guide.weights[guideLane] = g_NwbSurfelGuidePool[surfelIndex * NWB_SURFEL_GUIDE_FLOAT4S_PER_SURFEL + guideLane];
            const float guideTotal = nwbSurfelGuideTotal(guide);
            if(rayIndex >= uniformRayCount){
                // Stratified inverse-CDF sampling of the learned radiance map.
                const uint guidedIndex = rayIndex - uniformRayCount;
                const float quantile = (float(guidedIndex) + nwbSurfelGuideRandom(randomSeed)) / float(guidedRayCount);
                bin = nwbSurfelGuideSelectBin(guide, quantile * guideTotal);
            }
            // Evaluate the mixture PDF for both ray classes before the trace so the guide can be discarded.
            inversePdf = nwbSurfelGuideInversePdf(guide, bin, uniformRayCount, rayCount, guideTotal);
        }
        const float2 withinBin = float2(nwbSurfelGuideRandom(randomSeed + 1u), nwbSurfelGuideRandom(randomSeed + 2u));
        const float3 dirLocal = nwbSurfelGuideDirection(bin, withinBin);
        const float3 rayDir = normalize(dirLocal.x * tangent + dirLocal.y * bitangent + dirLocal.z * n);

        const float3 origin = g_NwbSurfelPool[surfelIndex].position + n * normalBias;
        const NwbGiTraceHit hit = nwbGiTraceClosest(
            origin,
            rayDir,
            NWB_GI_TRACE_RAY_MIN_DISTANCE,
            NWB_GI_TRACE_RAY_MAX_DISTANCE
        );
        half3 radiance = half3(0.0h, 0.0h, 0.0h);
        // A zero-reflectance hit returns zero under this diffuse model. Keep its zero guide observation.
        if(hit.hit && any(hit.albedo != half3(0.0h))){
            radiance = nwbGiShadeHit(hit, rayDir);
            const float3 facingNormal = dot(hit.normal, rayDir) < 0.0 ? hit.normal : -hit.normal;
            const half3 bounce = min(nwbSurfelBounceGather(hit.worldPos, facingNormal), half3(half(NWB_SURFEL_BOUNCE_CLAMP), half(NWB_SURFEL_BOUNCE_CLAMP), half(NWB_SURFEL_BOUNCE_CLAMP)));
            radiance += hit.albedo * bounce;
        }

        // Both ray classes use the same mixture PDF. Its uniform component bounds weights and continues discovering light outside previously bright cells; the 1/N factor is applied after the workgroup reduction.
        const float4 weightedBasis = float4(nwbSurfelShBasis(rayDir)) * inversePdf;
        s_surfelShR[rayIndex] = float(radiance.r) * weightedBasis;
        s_surfelShG[rayIndex] = float(radiance.g) * weightedBasis;
        s_surfelShB[rayIndex] = float(radiance.b) * weightedBasis;
        if(updateGuide){
            s_surfelGuideBin[rayIndex] = bin;
            const float luminance = dot(float3(radiance), float3(0.2126, 0.7152, 0.0722));
            s_surfelGuideObservation[rayIndex] = sqrt(min(max(luminance, 0.0), NWB_SURFEL_GUIDE_LUMINANCE_CLAMP));
        }
    }

    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for(uint stride = NWB_SURFEL_RAYS_PER_SURFEL >> 1; stride > 0u; stride >>= 1){
        if(rayIndex < stride){
            s_surfelShR[rayIndex] += s_surfelShR[rayIndex + stride];
            s_surfelShG[rayIndex] += s_surfelShG[rayIndex + stride];
            s_surfelShB[rayIndex] += s_surfelShB[rayIndex + stride];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if(updateGuide && rayIndex < NWB_SURFEL_GUIDE_BIN_COUNT){
        float observed = 0.0;
        uint observations = 0u;
        [loop]
        for(uint sample = 0u; sample < rayCount; ++sample){
            if(s_surfelGuideBin[sample] == rayIndex){
                observed += s_surfelGuideObservation[sample];
                ++observations;
            }
        }
        const float4 oldGuideLane = g_NwbSurfelGuidePool[surfelIndex * NWB_SURFEL_GUIDE_FLOAT4S_PER_SURFEL + (rayIndex >> 2u)];
        const float oldWeight = max(oldGuideLane[rayIndex & 3u], NWB_SURFEL_GUIDE_INITIAL_WEIGHT);
        s_surfelGuideUpdated[rayIndex] = observations != 0u
            ? lerp(oldWeight, max(observed / float(observations), NWB_SURFEL_GUIDE_INITIAL_WEIGHT), NWB_SURFEL_GUIDE_OBSERVED_BLEND)
            : lerp(oldWeight, NWB_SURFEL_GUIDE_INITIAL_WEIGHT, NWB_SURFEL_GUIDE_UNOBSERVED_DECAY)
        ;
    }

    if(updateGuide)
        GroupMemoryBarrierWithGroupSync();

    if(rayIndex == 0u){
        const float projectionScale = 1.0 / float(rayCount);
        const float4 frameShR = s_surfelShR[0] * projectionScale;
        const float4 frameShG = s_surfelShG[0] * projectionScale;
        const float4 frameShB = s_surfelShB[0] * projectionScale;

        const uint accumCap = max(uint(g_NwbSurfelConstants.coverageRadiusBiasHyst.w), 1u);
        const uint n = min(sampleCount, accumCap);
        // The running-mean history blend is a (0, 1) bounded factor, so half arithmetic is sufficient here.
        const half historyWeight = half(float(n) / float(n + 1u));
        g_NwbSurfelPool[surfelIndex].shR = lerp(frameShR, g_NwbSurfelPool[surfelIndex].shR, float(historyWeight));
        g_NwbSurfelPool[surfelIndex].shG = lerp(frameShG, g_NwbSurfelPool[surfelIndex].shG, float(historyWeight));
        g_NwbSurfelPool[surfelIndex].shB = lerp(frameShB, g_NwbSurfelPool[surfelIndex].shB, float(historyWeight));
        g_NwbSurfelPool[surfelIndex].sampleCount = min(sampleCount + 1u, 0xFFFFu);
        if(updateGuide){
            [unroll]
            for(uint guideLane = 0u; guideLane < NWB_SURFEL_GUIDE_FLOAT4S_PER_SURFEL; ++guideLane){
                const uint guideBin = guideLane * 4u;
                g_NwbSurfelGuidePool[surfelIndex * NWB_SURFEL_GUIDE_FLOAT4S_PER_SURFEL + guideLane] = float4(
                    s_surfelGuideUpdated[guideBin + 0u],
                    s_surfelGuideUpdated[guideBin + 1u],
                    s_surfelGuideUpdated[guideBin + 2u],
                    s_surfelGuideUpdated[guideBin + 3u]
                );
            }
        }
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

