////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_shader/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace NWB::Impl{
interface IShader;
using MaterialStageShaderArray = Array<Core::Assets::AssetRef<IShader>, 14u>;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_MaterialBinaryMagic = 0x4D544C41u; // MTLA
const usize s_MaterialShaderEntryBytes = 65u;
const u8 s_MaterialPixelShaderStageValue = 4u;
const u8 s_MaterialMeshShaderStageValue = 7u;
const usize s_MaterialShaderStageCount = 14u;
const usize s_MaterialTypedLayoutBlockBytes = 80u;
const usize s_MaterialTypedLayoutFieldBytes = 88u;
const usize s_MaterialResourceReferenceBytes = 200u;
const u32 s_MaterialTypedWordBytes = 4u;
const u32 s_MaterialTypedValueComponentCount = 4u;
const StringView s_MaterialAvboitAccumulatePassLabel = "accumulate";
const StringView s_MaterialAvboitOccupancyPassLabel = "occupancy";
const StringView s_MaterialAvboitExtinctionPassLabel = "extinction";
const u32 s_MaterialLayoutFieldComponentsPerValueType = 4u;
const u32 s_MaterialLayoutFieldFirstTypeId = cast<u32>(MaterialLayoutFieldType::b8);
const u32 s_MaterialParameterFirstValueTypeId = cast<u32>(MaterialParameterValueType::b8);
const StringView s_MaterialTypedLayoutHashHeader = "NWB_MATERIAL_TYPED_LAYOUT_V1";
const StringView s_MaterialLoadBinaryContextText = "Material::loadBinary";
const StringView s_MaterialValidatePayloadContextText = "Material::validatePayload";
const StringView s_MaterialSerializeContextText = "MaterialAssetCodec::serialize";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
flag<u32> MaterialFlag{
    None = 0u,
    Transparent,
    TwoSided,
    Refractive,
    All = Transparent | TwoSided | Refractive
}

[reflect]
enum<u32> MaterialParameterValueType{
    None = 0u,
    b8,
    i8,
    u8,
    i16,
    u16,
    i32,
    u32,
    f16,
    f32
}

[reflect]
enum<u32> MaterialBlockClass{
    None = 0u,
    MaterialConstant,
    MaterialMutable
}

[reflect]
enum<u32> MaterialResourceKind{
    None = 0u,
    SampledImage2D,
    Sampler
}

[reflect]
enum<u32> MaterialLayoutFieldType{
    None = 0u,
    b8,
    b8x2,
    b8x3,
    b8x4,
    i8,
    i8x2,
    i8x3,
    i8x4,
    u8,
    u8x2,
    u8x3,
    u8x4,
    i16,
    i16x2,
    i16x3,
    i16x4,
    u16,
    u16x2,
    u16x3,
    u16x4,
    i32,
    i32x2,
    i32x3,
    i32x4,
    u32,
    u32x2,
    u32x3,
    u32x4,
    f16,
    f16x2,
    f16x3,
    f16x4,
    f32,
    f32x2,
    f32x3,
    f32x4,
    // Resource fields occupy one patched uint heap slot in the typed-byte payload.
    // They intentionally live after the contiguous numeric range so a resource can never be mistaken for an authored uint parameter.
    SampledImage2D = 37u,
    Sampler
}

[reflect]
enum<u8> MaterialTypedLayoutValidationStatus{
    Valid = 0u,
    EmptyLayout,
    ZeroHash,
    MissingBlocksOrFields,
    EmptyBlockName,
    InvalidBlockClass,
    NonContiguousFieldRange,
    FieldRangeExceedsCount,
    EmptyFieldName,
    InvalidFieldType,
    FieldAlignmentOverflow,
    MisalignedFieldOffset,
    FieldByteSizeOverflow,
    BlockByteSizeOverflow,
    BlockByteSizeMismatch,
    UnownedFields,
    LayoutHashMismatch,
    TotalBlockByteSizeOverflow,
    TotalBlockByteCountMismatch
}

[reflect]
class MaterialTypedLayoutBlock{
    public Name blockName = s_NameNone;
    public MaterialBlockClass blockClass = MaterialBlockClass::None;
    public u32 fieldBegin = 0u;
    public u32 fieldCount = 0u;
    public u32 byteSize = 0u;
}

[reflect]
class MaterialTypedLayoutField{
    public Name fieldName = s_NameNone;
    public MaterialLayoutFieldType fieldType = MaterialLayoutFieldType::None;
    public u32 offset = 0u;
    public u32x4u defaultValue;
}

// A cooked material separates resource identity from its numeric/default payload.
// `constantByteOffset` is the slot word the renderer patches after resolving the descriptor handle.
// Exactly one typed reference is valid.
[reflect]
class MaterialResourceReference{
    public Name blockName = s_NameNone;
    public Name fieldName = s_NameNone;
    public AssetRef<Texture> textureAsset;
    public AssetRef<Sampler> samplerAsset;
    public MaterialResourceKind resourceKind = MaterialResourceKind::None;
    public u32 constantByteOffset = 0u;
}

[serialize]
class MaterialTypedLayoutBlockBinary{
    public NameHash blockNameHash;
    public u32 blockClass = 0u;
    public u32 fieldBegin = 0u;
    public u32 fieldCount = 0u;
    public u32 byteSize = 0u;
}

[serialize]
class MaterialTypedLayoutFieldBinary{
    public NameHash fieldNameHash;
    public u32 fieldType = 0u;
    public u32 offset = 0u;
    public u32x4u defaultValue;
}

// Deserialization initializes the typed asset reference; runtime patches its resolved heap slot at constantByteOffset.
[serialize]
class MaterialResourceReferenceBinary{
    public NameHash blockNameHash;
    public NameHash fieldNameHash;
    public NameHash resourceNameHash;
    public u32 resourceKind = 0u;
    public u32 constantByteOffset = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

