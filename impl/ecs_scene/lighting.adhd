#include <impl/ecs_scene/components.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(size_of<LightType>() == size_of<u8>(), "LightType must stay compact for ECS storage");
static_assert(is_standard_layout<LightComponent>(), "LightComponent must stay layout-stable for ECS storage");
static_assert(is_trivially_copyable<LightComponent>(), "LightComponent must stay cheap to move in dense ECS storage");
static_assert(align_of<LightComponent>() >= align_of<f32x4>(), "LightComponent must stay aligned for SIMD component loads");
static_assert(size_of<LightComponent>() == (size_of<f32x4>() * 3), "LightComponent must stay three aligned vectors wide");
static_assert((size_of<LightComponent>() % align_of<LightComponent>()) == 0u, "LightComponent array stride must keep every element SIMD-aligned");
static_assert((offset_of<LightComponent>(colorIntensity) % align_of<f32x4>()) == 0u, "LightComponent::colorIntensity must stay aligned");
static_assert((offset_of<LightComponent>(range) % align_of<f32>()) == 0u, "LightComponent::range must stay aligned");
static_assert((offset_of<LightComponent>(innerConeCos) % align_of<f32>()) == 0u, "LightComponent::innerConeCos must stay aligned");
static_assert((offset_of<LightComponent>(outerConeCos) % align_of<f32>()) == 0u, "LightComponent::outerConeCos must stay aligned");
static_assert((offset_of<LightComponent>(type) % align_of<LightType>()) == 0u, "LightComponent::type must stay aligned");
static_assert((offset_of<LightComponent>(enableCaustics) % align_of<b8>()) == 0u, "LightComponent::enableCaustics must stay aligned");
static_assert((offset_of<LightComponent>(angularRadius) % align_of<f32>()) == 0u, "LightComponent::angularRadius must stay aligned");
static_assert((offset_of<LightComponent>(sourceRadius) % align_of<f32>()) == 0u, "LightComponent::sourceRadius must stay aligned");
static_assert(is_standard_layout<SceneLight>(), "SceneLight must stay layout-stable");
static_assert(is_trivially_copyable<SceneLight>(), "SceneLight must stay cheap to pass through scene preparation");
static_assert(align_of<SceneLight>() >= align_of<f32x4>(), "SceneLight must keep storage vectors aligned");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize GatherSceneLights(mut World world, in VectorSingle defaultForward, in usize limit, mut Span<SceneLight> outLights){
    const usize capacity = Min(limit, outLights.size());
    if(capacity == 0u)
        return 0u;

    usize count = 0u;
    for(in auto row : world.view<TransformComponent, LightComponent>()){
        if(count == capacity)
            break;
        const Expected<SceneLight> resolved = TryBuildSceneLight(Get<1>(row), Get<2>(row));
        if(resolved.has_value()){
            outLights[count] = resolved.value();
            ++count;
        }
    }
    if(count == 0u){
        outLights[0] = MakeDefaultSceneLightFromForward(defaultForward);
        return 1u;
    }
    return count;
}

EntityID CreateDirectionalLightEntity(mut World world, in f32 pitchRadians, in f32 yawRadians, in f32 rollRadians, in VectorSingle color, in f32 intensity){
    Entity lightEntity = world.createEntity();
    lightEntity.addComponent<TransformComponent>() = MakeEulerTransformComponent(pitchRadians, yawRadians, rollRadians);
    lightEntity.addComponent<LightComponent>() = MakeDirectionalLightComponent(color, intensity);
    return lightEntity.id();
}

EntityID CreatePointLightEntity(mut World world, in VectorSingle position, in VectorSingle color, in f32 intensity, in f32 range){
    Entity lightEntity = world.createEntity();
    lightEntity.addComponent<TransformComponent>() = MakePositionTransformComponent(position);
    lightEntity.addComponent<LightComponent>() = MakePointLightComponent(color, intensity, range);
    return lightEntity.id();
}

EntityID CreateSpotLightEntity(
    mut World world,
    in VectorSingle position,
    in f32 pitchRadians,
    in f32 yawRadians,
    in f32 rollRadians,
    in VectorSingle color,
    in f32 intensity,
    in f32 range,
    in f32 innerConeCos,
    in f32 outerConeCos
){
    Entity lightEntity = world.createEntity();
    lightEntity.addComponent<TransformComponent>() = MakePositionEulerTransformComponent(position, pitchRadians, yawRadians, rollRadians);
    lightEntity.addComponent<LightComponent>() = MakeSpotLightComponent(color, intensity, range, innerConeCos, outerConeCos);
    return lightEntity.id();
}


