#include <impl/assets_mesh/asset.adhd>
#include <impl/assets_mesh/skin_asset.adhd>
#include <impl/ecs_mesh/components.adhd>
#include <impl/ecs_mesh/skinning/runtime_instance.adhd>
#include <impl/ecs_mesh/skinning/runtime_cache_validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MeshSkinningSource : MoveOnly{
    public UniquePtr<Mesh> meshAsset;
    public UniquePtr<Skin> skinAsset;
    public u32 referenceCount = 0u;
}

type SkinningSourceMap = HashMap<Name, MeshSkinningSource>;
type SkinningInstanceMap = HashMap<EntityID, MeshSkinningRuntimeInstance>;

class PendingSkinningInstance : NoCopy{
    private mut SkinningInstanceMap m_instances;
    private mut SkinningSourceMap m_sources;
    private EntityID m_entity;
    private Name m_name;
    public b8 inserted = false;
    public b8 published = false;

    public PendingSkinningInstance(mut SkinningInstanceMap instances, mut SkinningSourceMap sources, in EntityID entity, in Name name){
        this.m_instances = instances;
        this.m_sources = sources;
        this.m_entity = entity;
        this.m_name = name;
    }
    public ~PendingSkinningInstance(){
        if(!this.published){
            if(this.inserted)
                this.m_instances.erase(this.m_entity);
            const auto source = this.m_sources.find(this.m_name);
            if(source != this.m_sources.end() && source.value().referenceCount == 0u)
                this.m_sources.erase(this.m_name);
        }
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MeshSkinningRuntimeCache : NoCopy{
    private mut GraphicsRuntime m_graphics;
    private in AssetManager m_assets;
    private SkinningSourceMap m_sources;
    private SkinningInstanceMap m_instances;
    private HashMap<u64, EntityID> m_handleToEntity;
    private u64 m_nextHandleValue = 1u;
    private u64 m_topologyGeneration = 1u;

    public MeshSkinningRuntimeCache(mut GraphicsRuntime graphics, in AssetManager assets){
        this.m_graphics = graphics;
        this.m_assets = assets;
    }

    [cpp_unwind]
    public void prepareResources(mut World world);
    public void clear(){
        if(!this.m_instances.empty())
            ++this.m_topologyGeneration;
        this.m_handleToEntity.clear();
        this.m_instances.clear();
        this.m_sources.clear();
    }
    public u64 topologyGeneration()const{ return this.m_topologyGeneration; }

    public Optional<mut MeshSkinningRuntimeInstance> editInstance(in RuntimeMeshHandle handle){
        const auto entity = TryFindRuntimeMeshEntityByHandle(this.m_handleToEntity, handle.value);
        if(entity.has_value() && this.m_instances.contains(entity.value())){
            mut MeshSkinningRuntimeInstance instance = this.m_instances.at(entity.value());
            return Optional<mut MeshSkinningRuntimeInstance>(instance);
        }
        return Optional<mut MeshSkinningRuntimeInstance>();
    }
    public Optional<in MeshSkinningRuntimeInstance> findInstance(in RuntimeMeshHandle handle)const{
        const auto entity = TryFindRuntimeMeshEntityByHandle(this.m_handleToEntity, handle.value);
        if(entity.has_value() && this.m_instances.contains(entity.value())){
            in MeshSkinningRuntimeInstance instance = this.m_instances.at(entity.value());
            return Optional<in MeshSkinningRuntimeInstance>(instance);
        }
        return Optional<in MeshSkinningRuntimeInstance>();
    }

    [cpp_unwind]
    private b8 ensureRuntimeMesh(in EntityID entity, mut SkinnedMeshBindingComponent component);
    [cpp_unwind]
    private b8 ensureSourceLoaded(in AssetRef<Skin> ref);
    [cpp_unwind]
    private b8 uploadRuntimeMeshBuffers(mut MeshSkinningRuntimeInstance instance);
    [owner_result]
    private MeshSkinningRuntimeInstance emptyInstance()const{ return MeshSkinningRuntimeInstance(); }

    private void releaseRuntimeMesh(in EntityID entity){
        const auto found = this.m_instances.find(entity);
        if(found == this.m_instances.end())
            return;
        const Name sourceName = found.value().sourceName;
        this.m_handleToEntity.erase(found.value().handle.value);
        this.m_instances.erase(entity);
        ++this.m_topologyGeneration;
        const auto source = this.m_sources.find(sourceName);
        if(source != this.m_sources.end() && source.value().referenceCount > 0u)
            --source.value().referenceCount;
        if(source != this.m_sources.end() && source.value().referenceCount == 0u)
            this.m_sources.erase(sourceName);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

