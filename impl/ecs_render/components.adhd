////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_material/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
enum<u8> OpticalVolumeCoincidence{
    enum Independent,
    enum IdenticalMaterial,
    enum SharedGroup
}

[reflect]
enum<u8> OpticalBoundaryMode{
    enum Unspecified,
    enum ClosedNested,
    enum ClosedPriority
}

[reflect]
class RendererComponent{
    public AssetRef<Material> material;
    public bool visible = true;
    public OpticalVolumeCoincidence opticalVolumeCoincidence = OpticalVolumeCoincidence::Enum::Independent;
    public Name opticalVolumeGroup = s_NameNone;
    public i32 opticalVolumePriority = 0;
    public OpticalBoundaryMode opticalBoundaryMode = OpticalBoundaryMode::Enum::Unspecified;
    public i32 opticalMediumPriority = 0;
}

[reflect]
class MaterialInstanceParameter{
    public Name parameterName = s_NameNone;
    public Name blockName = s_NameNone;
    public Name fieldName = s_NameNone;
    [transient]
    public MaterialLayoutFieldType fieldType = MaterialLayoutFieldType::Enum::None;
    [transient]
    public u32x4u value;
}

[reflect]
class MaterialInstanceComponent{
    public Name materialInterface;
    public Vector<MaterialInstanceParameter> overrides;
    public u64 revision = 0u;

    public MaterialInstanceComponent(){}

    public MaterialInstanceComponent(in Name interfaceName){
        this.materialInterface = interfaceName;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
