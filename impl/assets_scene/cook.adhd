#include <impl/assets_scene/asset.adhd>
#include <impl/assets_scene/component_asset_binary_codec.adhd>
#include <impl/assets_scene/cook_component_metadata.adhd>
#include <impl/assets_scene/scene_asset_binary_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TypedComponentCookEntry<T>{
    public Name virtualPath = s_NameNone;
    public T component;
}

type TransformComponentCookEntry = TypedComponentCookEntry<TransformComponent>;
type LocalTransformComponentCookEntry = TypedComponentCookEntry<LocalTransformComponent>;
type SceneParentComponentCookEntry = TypedComponentCookEntry<SceneParentComponent>;
type CameraComponentCookEntry = TypedComponentCookEntry<CameraComponent>;
type LightComponentCookEntry = TypedComponentCookEntry<LightComponent>;

class ActiveCameraComponentCookEntry{
    public Name virtualPath = s_NameNone;
}

class EntityCookEntry{
    public Name virtualPath = s_NameNone;
    public Name name = s_NameNone;
    public ComponentRefVector components;
}

class ProjectCookEntry{
    public Name virtualPath = s_NameNone;
    public SceneRef startScene;
}

class SceneCookEntry{
    public Name virtualPath = s_NameNone;
    public SubsystemRefVector subsystems;
    public EntityRefVector entities;
    public AssetMap assets;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateRequiredSceneMetadataField(
    in b8 hasField,
    in StringView diagnosticPrefix,
    in StringView filePathText,
    in StringView fieldName
){
    if(hasField)
        return true;

    error("{} '{}': field '{}' is required", diagnosticPrefix, filePathText, fieldName);
    return false;
}

b8 ValidateSceneAssetsFieldIsMap(in b8 isMap, in StringView filePathText){
    if(isMap)
        return true;

    error("{} '{}': field '{}' must be a map", s_SceneDiagnosticPrefix, filePathText, s_SceneAssetsField);
    return false;
}

b8 ValidateSceneAssetNicknameSyntax(in StringView nicknameView, in StringView filePathText){
    if(IsValidSceneAssetNicknameText(nicknameView))
        return true;

    error("{} '{}': asset nickname '{}' must not be empty or padded", s_SceneDiagnosticPrefix, filePathText, nicknameView);
    return false;
}

b8 ValidateSceneAssetNicknameResolved(in b8 hasValidName, in StringView nicknameView, in StringView filePathText){
    if(hasValidName)
        return true;

    error("{} '{}': asset nickname '{}' contains an embedded null", s_SceneDiagnosticPrefix, filePathText, nicknameView);
    return false;
}

b8 ValidateSceneAssetNicknameUnique(in b8 inserted, in StringView nicknameView, in StringView filePathText){
    if(inserted)
        return true;

    error("{} '{}': duplicate asset nickname '{}'", s_SceneDiagnosticPrefix, filePathText, nicknameView);
    return false;
}

b8 SerializeEntityAsset(in EntityAsset entity, mut Vector<u8> outBinary){
    if(!entity.validatePayload())
        return false;
    return SceneAssetBinaryCodec().serializeEntity(Span<ComponentRef>(entity.components()), entity.name().hash(), outBinary);
}

b8 SerializeProjectAsset(in ProjectAsset project, mut Vector<u8> outBinary){
    if(!project.validatePayload())
        return false;
    return SceneAssetBinaryCodec().serializeProject(project.startScene().name().hash(), outBinary);
}

b8 SerializeSceneAsset(in SceneAsset scene, mut Vector<u8> outBinary){
    if(!scene.validatePayload())
        return false;
    return SceneAssetBinaryCodec().serializeScene(
        Span<SubsystemRef>(scene.subsystems()),
        Span<EntityRef>(scene.entities()),
        scene.assets(),
        outBinary
    );
}

Expected<EntityAsset> BuildEntityAssetFromComponents(in Name virtualPath, in Name entityName, in Vector<ComponentRef> components){
    EntityAsset asset(virtualPath);
    asset.setName(entityName);
    asset.setComponents(components);
    if(!asset.validatePayload())
        return MakeUnexpected(Failure());
    return asset;
}

Expected<ProjectAsset> BuildProjectAssetFromStartScene(in Name virtualPath, in SceneRef startScene){
    ProjectAsset asset(virtualPath);
    asset.setStartScene(startScene);
    if(!asset.validatePayload())
        return MakeUnexpected(Failure());
    return asset;
}

Expected<SceneAsset> BuildSceneAssetFromContents(
    in Name virtualPath,
    in Vector<SubsystemRef> subsystems,
    in AssetMap assets,
    in Vector<EntityRef> entities
){
    SceneAsset asset(virtualPath);
    asset.setContents(subsystems, assets, entities);
    if(!asset.validatePayload())
        return MakeUnexpected(Failure());
    return asset;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<AssetT> BuildComponentAssetFromEntry<AssetT : IComponent, EntryT>(in EntryT entry){
    AssetT asset(entry.virtualPath);
    asset.component = entry.component;
    if(!asset.validatePayload())
        return MakeUnexpected(Failure());
    return asset;
}

Expected<EntryT> ParseSceneComponentCookMetadata<EntryT, ComponentT>(
    in Name path,
    in Path file,
    in MetascriptValue value,
    in StringView diagnosticPrefix,
    in Func<32u, Expected<ComponentT>(in MetascriptValue)> parseData,
    in Func<16u, b8(in ComponentT, in Name)> validatePayload
){
    EntryT entry = EntryT();
    if(!ValidateOptionalSceneMetadataMap(file, value, diagnosticPrefix) || !AssignCookEntryVirtualPath(path, file, diagnosticPrefix, entry))
        return MakeUnexpected(Failure());
    if(value.isMap()){
        const Expected<ComponentT> component = parseData(value);
        if(!component.has_value())
            return MakeUnexpected(Failure());
        entry.component = component.value();
    }
    if(!validatePayload(entry.component, entry.virtualPath))
        return MakeUnexpected(Failure());
    return entry;
}

Expected<TransformComponentCookEntry> ParseTransformComponentCookMetadata(in Name path, in Path file, in MetascriptValue value){
    in auto fileRef = file;
    return ParseSceneComponentCookMetadata<TransformComponentCookEntry, TransformComponent>(
        path, file, value, s_TransformDiagnosticPrefix,
        lambda[in fileRef](in MetascriptValue v) -> Expected<TransformComponent>{ return ParseTransformComponentData(fileRef, v); },
        lambda[](in TransformComponent c, in Name vp) -> b8{ return ValidateTransformComponentAssetPayload(c, vp); }
    );
}

Expected<LocalTransformComponentCookEntry> ParseLocalTransformComponentCookMetadata(in Name path, in Path file, in MetascriptValue value){
    in auto fileRef = file;
    return ParseSceneComponentCookMetadata<LocalTransformComponentCookEntry, LocalTransformComponent>(
        path, file, value, s_LocalTransformDiagnosticPrefix,
        lambda[in fileRef](in MetascriptValue v) -> Expected<LocalTransformComponent>{ return ParseLocalTransformComponentData(fileRef, v); },
        lambda[](in LocalTransformComponent c, in Name vp) -> b8{ return ValidateLocalTransformComponentAssetPayload(c, vp); }
    );
}

Expected<SceneParentComponentCookEntry> ParseSceneParentComponentCookMetadata(in Name path, in Path file, in MetascriptValue value){
    in auto fileRef = file;
    return ParseSceneComponentCookMetadata<SceneParentComponentCookEntry, SceneParentComponent>(
        path, file, value, s_SceneParentDiagnosticPrefix,
        lambda[in fileRef](in MetascriptValue v) -> Expected<SceneParentComponent>{ return ParseSceneParentComponentData(fileRef, v); },
        lambda[](in SceneParentComponent c, in Name vp) -> b8{ return ValidateSceneParentComponentAssetPayload(c, vp); }
    );
}

Expected<CameraComponentCookEntry> ParseCameraComponentCookMetadata(in Name path, in Path file, in MetascriptValue value){
    in auto fileRef = file;
    return ParseSceneComponentCookMetadata<CameraComponentCookEntry, CameraComponent>(
        path, file, value, s_CameraDiagnosticPrefix,
        lambda[in fileRef](in MetascriptValue v) -> Expected<CameraComponent>{ return ParseCameraComponentData(fileRef, v); },
        lambda[](in CameraComponent c, in Name vp) -> b8{ return ValidateCameraComponentAssetPayload(c, vp); }
    );
}

Expected<LightComponentCookEntry> ParseLightComponentCookMetadata(in Name path, in Path file, in MetascriptValue value){
    in auto fileRef = file;
    return ParseSceneComponentCookMetadata<LightComponentCookEntry, LightComponent>(
        path, file, value, s_LightDiagnosticPrefix,
        lambda[in fileRef](in MetascriptValue v) -> Expected<LightComponent>{ return ParseLightComponentData(fileRef, v); },
        lambda[](in LightComponent c, in Name vp) -> b8{ return ValidateLightComponentAssetPayload(c, vp); }
    );
}

Expected<ActiveCameraComponentCookEntry> ParseActiveCameraComponentCookMetadata(in Name path, in Path file, in MetascriptValue value){
    ActiveCameraComponentCookEntry entry;
    if(!ValidateOptionalSceneMetadataMap(file, value, s_ActiveCameraDiagnosticPrefix) || !AssignCookEntryVirtualPath(path, file, s_ActiveCameraDiagnosticPrefix, entry))
        return MakeUnexpected(Failure());
    if(value.isMap()){
        if(!ValidateMetadataAssetFields(file, value, s_ActiveCameraDiagnosticPrefix, lambda[](in StringView fieldName) -> b8{
            return false;
        }))
            return MakeUnexpected(Failure());
    }
    return entry;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<Vector<AssetRef<T>>> ReadSceneRefList<T>(in Path file, in StringView prefix, in StringView field, in MetascriptValue value){
    if(!value.isList()){
        error("{} '{}': field '{}' must be a list", prefix, file, field);
        return MakeUnexpected(Failure());
    }
    Vector<AssetRef<T>> refs;
    const Span<MetascriptValue> items = value.listView();
    refs.reserve(items.size());
    for(in MetascriptValue item : items){
        const auto parsed = ParseReservedAssetRefValue<T>(file, prefix, field, item, "entries must be strings");
        if(!parsed.has_value())
            return MakeUnexpected(Failure());
        refs.push_back(parsed.value());
    }
    return refs;
}

Expected<AssetMap> ReadSceneAssetsMap(in Path file, in MetascriptValue value){
    const String fileText = PathToString(file);
    if(!ValidateSceneAssetsFieldIsMap(value.isMap(), fileText))
        return MakeUnexpected(Failure());
    AssetMap assets;
    in auto fileRef = file;
    in String fileTextRef = fileText;
    if(!value.forEachMapEntry(lambda[in fileRef, in fileTextRef, mut assets](in StringView key, in MetascriptValue item) -> b8{
        if(!ValidateSceneAssetNicknameSyntax(key, fileTextRef))
            return false;
        const Expected<Name> name = ParseName(key);
        if(!ValidateSceneAssetNicknameResolved(name.has_value() && name.value() != s_NameNone, key, fileTextRef))
            return false;
        const auto parsed = ParseReservedAssetRefValue<IAsset>(fileRef, s_SceneDiagnosticPrefix, key, item, "entries must be strings");
        if(!parsed.has_value())
            return false;
        return ValidateSceneAssetNicknameUnique(assets.emplace(name.value(), parsed.value()).second, key, fileTextRef);
    }))
        return MakeUnexpected(Failure());
    return assets;
}

Expected<EntityCookEntry> ParseEntityCookMetadata(in Name path, in Path file, in MetascriptValue value){
    EntityCookEntry entry;
    if(!CheckMetadataAssetMap(file, value, s_EntityDiagnosticPrefix) || !AssignCookEntryVirtualPath(path, file, s_EntityDiagnosticPrefix, entry))
        return MakeUnexpected(Failure());
    if(!ValidateMetadataAssetFields(file, value, s_EntityDiagnosticPrefix, IsAllowedEntityAssetField))
        return MakeUnexpected(Failure());
    const Expected<MetadataStringField> nameField = ReadMetadataStringField(file, value, s_EntityDiagnosticPrefix, s_EntityNameField, false);
    if(!nameField.has_value())
        return MakeUnexpected(Failure());
    if(nameField.value().present){
        const StringView trimmedName = TrimView(nameField.value().text);
        if(trimmedName.empty() || trimmedName != nameField.value().text){
            error("{} '{}': field '{}' must not be empty or padded", s_EntityDiagnosticPrefix, PathToString(file), s_EntityNameField);
            return MakeUnexpected(Failure());
        }
        const Expected<Name> parsedName = ParseName(trimmedName);
        if(!parsedName.has_value() || parsedName.value() == s_NameNone){
            error("{} '{}': field '{}' is invalid", s_EntityDiagnosticPrefix, PathToString(file), s_EntityNameField);
            return MakeUnexpected(Failure());
        }
        entry.name = parsedName.value();
    }
    const Optional<in MetascriptValue> components = value.borrowField(s_EntityComponentsField);
    if(!ValidateRequiredSceneMetadataField(components.has_value(), s_EntityDiagnosticPrefix, PathToString(file), s_EntityComponentsField))
        return MakeUnexpected(Failure());
    const auto refs = ReadSceneRefList<IComponent>(file, s_EntityDiagnosticPrefix, s_EntityComponentsField, components.value());
    if(!refs.has_value())
        return MakeUnexpected(Failure());
    entry.components = refs.value();
    if(
        !ValidateEntityAssetComponentCount(entry.components.size())
        || !ValidateUniqueAssetRefs(Span<ComponentRef>(entry.components), "EntityAsset::validatePayload", "component")
    )
        return MakeUnexpected(Failure());
    return entry;
}

Expected<ProjectCookEntry> ParseProjectCookMetadata(in Name path, in Path file, in MetascriptValue value){
    ProjectCookEntry entry;
    if(!CheckMetadataAssetMap(file, value, s_ProjectDiagnosticPrefix) || !AssignCookEntryVirtualPath(path, file, s_ProjectDiagnosticPrefix, entry))
        return MakeUnexpected(Failure());
    if(!ValidateMetadataAssetFields(file, value, s_ProjectDiagnosticPrefix, IsAllowedProjectAssetField))
        return MakeUnexpected(Failure());
    const auto text = ReadMetadataStringField(file, value, s_ProjectDiagnosticPrefix, s_SceneStartSceneField, true);
    if(!text.has_value())
        return MakeUnexpected(Failure());
    const auto ref = ParseReservedAssetRefText<SceneAsset>(file, s_ProjectDiagnosticPrefix, s_SceneStartSceneField, text.value().text);
    if(!ref.has_value())
        return MakeUnexpected(Failure());
    entry.startScene = ref.value();
    if(!ValidateProjectAssetPayload(entry.startScene.valid()))
        return MakeUnexpected(Failure());
    return entry;
}

Expected<SceneCookEntry> ParseSceneCookMetadata(in Name path, in Path file, in MetascriptValue value){
    SceneCookEntry entry;
    if(!CheckMetadataAssetMap(file, value, s_SceneDiagnosticPrefix) || !AssignCookEntryVirtualPath(path, file, s_SceneDiagnosticPrefix, entry))
        return MakeUnexpected(Failure());
    if(!ValidateMetadataAssetFields(file, value, s_SceneDiagnosticPrefix, IsAllowedSceneAssetField))
        return MakeUnexpected(Failure());
    const Optional<in MetascriptValue> subsystems = value.borrowField(s_SceneSubsystemsField);
    if(!ValidateRequiredSceneMetadataField(subsystems.has_value(), s_SceneDiagnosticPrefix, PathToString(file), s_SceneSubsystemsField))
        return MakeUnexpected(Failure());
    const auto refs = ReadSceneRefList<ISubsystem>(file, s_SceneDiagnosticPrefix, s_SceneSubsystemsField, subsystems.value());
    if(!refs.has_value())
        return MakeUnexpected(Failure());
    entry.subsystems = refs.value();
    DeduplicateSubsystemRefs(entry.subsystems);
    const Optional<in MetascriptValue> entities = value.borrowField(s_SceneEntitiesField);
    if(entities.has_value()){
        const auto entityRefs = ReadSceneRefList<EntityAsset>(file, s_SceneDiagnosticPrefix, s_SceneEntitiesField, entities.value());
        if(!entityRefs.has_value())
            return MakeUnexpected(Failure());
        entry.entities = entityRefs.value();
    }
    const Optional<in MetascriptValue> assets = value.borrowField(s_SceneAssetsField);
    if(assets.has_value()){
        const auto map = ReadSceneAssetsMap(file, assets.value());
        if(!map.has_value())
            return MakeUnexpected(Failure());
        entry.assets = map.value();
    }
    if(
        !ValidateSceneAssetSubsystemCount(entry.subsystems.size())
        || !ValidateUniqueAssetRefs(Span<SubsystemRef>(entry.subsystems), "SceneAsset::validatePayload", "subsystem")
        || !ValidateUniqueAssetRefs(Span<EntityRef>(entry.entities), "SceneAsset::validatePayload", "entity")
        || !ValidateSceneAssetMap(entry.assets)
    )
        return MakeUnexpected(Failure());
    return entry;
}


