    cases[3u] = "prefix\xC2\x85\x7F";
    cases[4u] = "prefix\xE2\x80\xA8\xC2\x80";
    cases[5u] = "prefix\xE2\x80\xA9\xC2\x9F";
    cases[6u] = s_UiMultilineTextEmbeddedNulTail;
    UiMultilineTextArena arena = UiMultilineTextArena();
    for(in StringView text : cases){
        const ScopedTestTrace trace = ScopedTestTrace(text);
        ExpectUiMultilineTextNormalizedError(arena.arena, text, 64u, EditTextStatus::InvalidText);
    }
}

void VerifyUiMultilineText_LimitsNormalizedBytesAndNeverTruncatesUtf8Scalars(){
    Array<UiMultilineTextExpectationCase, 7u> cases = Array<UiMultilineTextExpectationCase, 7u>();
    cases[0u] = UiMultilineTextExpectationCase("a\r\nb", "a\nb");
    cases[1u] = UiMultilineTextExpectationCase("\r\n\r\n", "\n\n");
    cases[2u] = UiMultilineTextExpectationCase("\xE2\x80\xA8\xE2\x80\xA9", "\n\n");
    cases[3u] = UiMultilineTextExpectationCase("\xC2\x85\t", "\n ");
    cases[4u] = UiMultilineTextExpectationCase(s_UiMultilineTextThreeByteScalar, s_UiMultilineTextThreeByteScalar);
    cases[5u] = UiMultilineTextExpectationCase(s_UiMultilineTextFourByteScalar, s_UiMultilineTextFourByteScalar);
    cases[6u] = UiMultilineTextExpectationCase("\xED\x95\x9C\r\n\xE2\x80\xA8\t", "\xED\x95\x9C\n\n ");
    UiMultilineTextArena arena = UiMultilineTextArena();
    for(in UiMultilineTextExpectationCase test : cases){
        const ScopedTestTrace trace = ScopedTestTrace(test.source);
        const auto normalized = NormalizeMultilineText(arena.arena, test.source, test.expected.size());
        ASSERT_TRUE(normalized.has_value());
        const StringView outputView = StringView(normalized.value().data(), normalized.value().size());
        EXPECT_EQ(outputView, test.expected);
        ExpectUiMultilineTextNormalizedError(arena.arena, test.source, test.expected.size() - 1u, EditTextStatus::TooLarge);
        EXPECT_TRUE(ValidateMultilineText(outputView));
    }
}

void VerifyUiMultilineText_ZeroBudgetAcceptsEmptyInputAndRejectsEveryNonemptyNormalizedOutput(){
    UiMultilineTextArena arena = UiMultilineTextArena();
    Array<StringView, 7u> cases = Array<StringView, 7u>();
    cases[0u] = "a";
    cases[1u] = "\n";
    cases[2u] = "\r\n";
    cases[3u] = "\t";
    cases[4u] = s_UiMultilineTextNextLine;
    cases[5u] = s_UiMultilineTextLineSeparator;
    cases[6u] = s_UiMultilineTextParagraphSeparator;
    for(in StringView text : cases){
        const ScopedTestTrace trace = ScopedTestTrace(text);
        ExpectUiMultilineTextNormalizedError(arena.arena, text, 0u, EditTextStatus::TooLarge);
    }
    const auto nullText = NormalizeMultilineText(arena.arena, StringView(), 0u);
    ASSERT_TRUE(nullText.has_value());
    EXPECT_TRUE(nullText.value().empty());
    EXPECT_TRUE(ValidateMultilineText(StringView()));
    const auto emptyText = NormalizeMultilineText(arena.arena, "", 0u);
    ASSERT_TRUE(emptyText.has_value());
    EXPECT_TRUE(emptyText.value().empty());
}

void VerifyUiMultilineText_SupportsBorrowedWholeAndSubviewSourcesAtExactBudgets(){
    UiMultilineTextArena arena = UiMultilineTextArena();
    UiMultilineTextGlobalString output = UiMultilineTextGlobalString("a\r\nb\t\xED\x95\x9C\xE2\x80\xA9", arena.arena);
    const StringView whole = StringView(output.data(), output.size());
    auto normalizedWhole = NormalizeMultilineText(arena.arena, whole, 8u);
    ASSERT_TRUE(normalizedWhole.has_value());
    UiMultilineTextTakeNormalized(output, normalizedWhole);
    EXPECT_EQ(output, "a\nb \xED\x95\x9C\n");

    output.assign(s_UiMultilineTextBorrowedSourceText);
    const StringView middle = StringView(output.data(), output.size()).substr(7u, 6u);
    auto normalizedMiddle = NormalizeMultilineText(arena.arena, middle, 5u);
    ASSERT_TRUE(normalizedMiddle.has_value());
    UiMultilineTextTakeNormalized(output, normalizedMiddle);
    EXPECT_EQ(output, "a\nb z");

    output.assign("prefix\xE2\x80\xA8");
    const StringView trailing = StringView(output.data(), output.size()).substr(6u, 3u);
    auto normalizedTrailing = NormalizeMultilineText(arena.arena, trailing, 1u);
    ASSERT_TRUE(normalizedTrailing.has_value());
    UiMultilineTextTakeNormalized(output, normalizedTrailing);
    EXPECT_EQ(output, "\n");

    const StringView empty = StringView(output.data(), output.size()).substr(output.size(), 0u);
    auto normalizedEmpty = NormalizeMultilineText(arena.arena, empty, 0u);
    ASSERT_TRUE(normalizedEmpty.has_value());
    UiMultilineTextTakeNormalized(output, normalizedEmpty);
    EXPECT_TRUE(output.empty());
}

void VerifyUiMultilineText_RejectedBorrowedViewsPreserveSourceBytesAndStorage(){
    UiMultilineTextArena arena = UiMultilineTextArena();
    UiMultilineTextGlobalString output = UiMultilineTextGlobalString(s_UiMultilineTextBorrowedSourceText, arena.arena);
    output.reserve(128u);
    const UiMultilineTextGlobalString savedAlias = UiMultilineTextGlobalString(output, arena.arena);
    const usize storage = UiMultilineTextStorageAddress(output);
    const usize aliasCapacity = output.capacity();
    const StringView whole = StringView(output.data(), output.size());
    ExpectUiMultilineTextNormalizedError(arena.arena, whole, 1u, EditTextStatus::TooLarge);
    EXPECT_EQ(output, savedAlias);
    EXPECT_EQ(UiMultilineTextStorageAddress(output), storage);
    EXPECT_EQ(output.capacity(), aliasCapacity);
    const StringView middle = StringView(output.data(), output.size()).substr(7u, 6u);
    ExpectUiMultilineTextNormalizedError(arena.arena, middle, 4u, EditTextStatus::TooLarge);
    EXPECT_EQ(output, savedAlias);
    EXPECT_EQ(UiMultilineTextStorageAddress(output), storage);
    EXPECT_EQ(output.capacity(), aliasCapacity);

    Array<StringView, 3u> invalidAlias = Array<StringView, 3u>();
    invalidAlias[0u] = "prefix a\r\nb\x01";
    invalidAlias[1u] = "prefix a\r\nb\xE2\x82";
    invalidAlias[2u] = s_UiMultilineTextEmbeddedNulBorrowed;
    for(in StringView text : invalidAlias){
        output.assign(text.data(), text.size());
        const UiMultilineTextGlobalString savedInvalid = UiMultilineTextGlobalString(output, arena.arena);
        const usize invalidStorage = UiMultilineTextStorageAddress(output);
        const usize invalidCapacity = output.capacity();
        const StringView source = StringView(output.data(), output.size()).substr(7u, output.size() - 7u);
        ExpectUiMultilineTextNormalizedError(arena.arena, source, 64u, EditTextStatus::InvalidText);
        EXPECT_EQ(output, savedInvalid);
        EXPECT_EQ(UiMultilineTextStorageAddress(output), invalidStorage);
        EXPECT_EQ(output.capacity(), invalidCapacity);
    }
}


