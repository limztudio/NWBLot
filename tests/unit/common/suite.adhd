const StringView s_ParallelLoggerMessageText = "parallel logger message";
const StringView s_TestsNamesymbolsBeforeRegistryLive = "tests/namesymbols/before_registry_live";
const StringView s_TestsNamesymbolsBeforeRegistryRetire = "tests/namesymbols/before_registry_retired";
const StringView s_GlobalArenaMemoryHeapBacking = "global/arena_memory/heap_backing";
const StringView s_OriginalEscapedSymbol = "symbols/line\ncarriage\rtab\tend";
const StringView s_RetainedAdmissionSymbol = "admission/retained";
const StringView s_DecodeKnownSymbol = "decode/known";
const StringView s_DecodeShortSymbol = "decode/short";

void BuildBoundaryTokenSource(in Name known, mut String source){
    String knownTokenText = "";
    String unknownTokenText = "";
    String mutatedKnownTokenText = "";
    native(in known, mut knownTokenText, mut unknownTokenText, mut mutatedKnownTokenText){
        Array<char, NameHashTextCodec::s_TextLength + 1u> knownToken = {};
        Array<char, NameHashTextCodec::s_TextLength + 1u> unknownToken = {};
        NameHashTextCodec::Format(knownToken.data(), sizeof(knownToken), known.identityHash());
        NameHashTextCodec::Format(unknownToken.data(), sizeof(unknownToken), ComputeNameHash(MakeNotNull("decode/unknown")));
        knownTokenText.assign(AStringView(knownToken.data(), NameHashTextCodec::s_TextLength));
        unknownTokenText.assign(AStringView(unknownToken.data(), NameHashTextCodec::s_TextLength));
        knownToken[0u] = 'g';
        mutatedKnownTokenText.assign(AStringView(knownToken.data(), NameHashTextCodec::s_TextLength));
    }
    const StringView knownView = knownTokenText;
    const StringView unknownView = unknownTokenText;
    const StringView mutatedKnownView = mutatedKnownTokenText;
    source.clear();
    source.append(unknownView);
    source.append(" !");
    source.append(knownView);
    source.append("_ !a");
    source.append(knownView);
    source.append(" !");
    source.append(mutatedKnownView);
}

void BuildResolvedSpanSources(in Name shortName, mut b8 longNameCreated, mut String source, mut String expectedSource){
    String expanded = "";
    expanded.reserve(300u);
    for(u32 index = 0u; index < 300u; ++index)
        expanded.append("z");
    const StringView expandedView = expanded;

    String shortTokenText = "";
    String longTokenText = "";
    String unknownTokenText = "";
    native(in shortName, in expandedView, mut longNameCreated, mut shortTokenText, mut longTokenText, mut unknownTokenText){
        const auto longNameResult = Name::FromText(expandedView);
        longNameCreated = longNameResult.has_value();
        if(longNameResult){
            Array<char, NameHashTextCodec::s_TextLength + 1u> shortToken = {};
            Array<char, NameHashTextCodec::s_TextLength + 1u> longToken = {};
            Array<char, NameHashTextCodec::s_TextLength + 1u> unknownToken = {};
            NameHashTextCodec::Format(shortToken.data(), sizeof(shortToken), shortName.identityHash());
            NameHashTextCodec::Format(longToken.data(), sizeof(longToken), longNameResult->identityHash());
            NameHashTextCodec::Format(unknownToken.data(), sizeof(unknownToken), ComputeNameHash(MakeNotNull("decode/unresolved")));
            shortTokenText.assign(AStringView(shortToken.data(), NameHashTextCodec::s_TextLength));
            longTokenText.assign(AStringView(longToken.data(), NameHashTextCodec::s_TextLength));
            unknownTokenText.assign(AStringView(unknownToken.data(), NameHashTextCodec::s_TextLength));
        }
    }
    if(!longNameCreated)
        return;

    const StringView shortView = shortTokenText;
    const StringView longView = longTokenText;
    const StringView unknownView = unknownTokenText;

    source.clear();
    source.append(shortView);
    source.append(" !");
    source.append(unknownView);
    source.append(" !");
    source.append(longView);
    source.append(" !");
    source.append(shortView);

    expectedSource.clear();
    expectedSource.append("decode/short !");
    expectedSource.append(unknownView);
    expectedSource.append(" !");
    expectedSource.append(expandedView);
    expectedSource.append(" !decode/short");
}

void VerifyNameSymbolDecodeTests_UnknownAndBoundaryNarrowTokensDoNotAllocate(){
    NameSymbols::InstallRuntimeRegistry();
    NameSymbols::ClearRuntimeSymbols();
    GlobalArena arena(Name("Tests/NameSymbols/Boundaries"));
    const Name known(s_DecodeKnownSymbol);
    String source = "";
    BuildBoundaryTokenSource(known, source);
    const StringView sourceView = source;

    String decoded = "";
    b8 dataPointerUnchanged = false;
    ArenaMemoryStats before = arena.memoryStats();
    ArenaMemoryStats after = arena.memoryStats();
    native(in sourceView, mut arena, mut decoded, mut dataPointerUnchanged, mut before, mut after){
        const AString<GlobalArena> expected = CommonTestsDetail::CopyAsciiText<char>(arena, sourceView);
        AString<GlobalArena> text(expected);
        const char* const originalData = text.data();
        before = arena.memoryStats();
        NameSymbols::DecodeHashTokens(arena, text);
        after = arena.memoryStats();
        decoded.assign(AStringView(text));
        dataPointerUnchanged = text.data() == originalData;
    }

    EXPECT_EQ(decoded, source);
    EXPECT_TRUE(dataPointerUnchanged);
    EXPECT_EQ(after.allocationCount, before.allocationCount);
    EXPECT_EQ(after.reallocationCount, before.reallocationCount);
    EXPECT_EQ(after.deallocationCount, before.deallocationCount);
}

void VerifyNameSymbolDecodeTests_UnknownAndBoundaryWideTokensDoNotAllocate(){
    b8 unicodeEnabled = false;
    native(mut unicodeEnabled){
#if defined(FOUNDATION_UNICODE)
        unicodeEnabled = true;
        NameSymbols::InstallRuntimeRegistry();
        NameSymbols::ClearRuntimeSymbols();
#endif
    }
    if(!unicodeEnabled)
        return;

    GlobalArena arena(Name("Tests/NameSymbols/Boundaries"));
    const Name known(s_DecodeKnownSymbol);
    String source = "";
    BuildBoundaryTokenSource(known, source);
    const StringView sourceView = source;

    b8 textMatchesExpected = false;
    b8 dataPointerUnchanged = false;
    ArenaMemoryStats before = arena.memoryStats();
    ArenaMemoryStats after = arena.memoryStats();
    native(in sourceView, mut arena, mut textMatchesExpected, mut dataPointerUnchanged, mut before, mut after){
#if defined(FOUNDATION_UNICODE)
        const WString<GlobalArena> expected = CommonTestsDetail::CopyAsciiText<wchar>(arena, sourceView);
        WString<GlobalArena> text(expected);
        const wchar* const originalData = text.data();
        before = arena.memoryStats();
        NameSymbols::DecodeHashTokens(arena, text);
        after = arena.memoryStats();
        textMatchesExpected = text == expected;
        dataPointerUnchanged = text.data() == originalData;
#else
        static_cast<void>(sourceView);
        static_cast<void>(arena);
        static_cast<void>(textMatchesExpected);
        static_cast<void>(dataPointerUnchanged);
        static_cast<void>(before);
        static_cast<void>(after);
#endif
    }

    EXPECT_TRUE(textMatchesExpected);
    EXPECT_TRUE(dataPointerUnchanged);
    EXPECT_EQ(after.allocationCount, before.allocationCount);
    EXPECT_EQ(after.reallocationCount, before.reallocationCount);
    EXPECT_EQ(after.deallocationCount, before.deallocationCount);
}

void VerifyNameSymbolDecodeTests_ResolvesNarrowSpansWithoutChangingUnresolvedText(){
    NameSymbols::InstallRuntimeRegistry();
    NameSymbols::ClearRuntimeSymbols();
    GlobalArena arena(Name("Tests/NameSymbols/Resolved"));
    const Name shortName(s_DecodeShortSymbol);
    b8 longNameCreated = false;
    String source = "";
    String expectedSource = "";
    BuildResolvedSpanSources(shortName, longNameCreated, source, expectedSource);
    ASSERT_TRUE(longNameCreated);

    const StringView sourceView = source;
    String decoded = "";
    native(in sourceView, mut arena, mut decoded){
        AString<GlobalArena> text = CommonTestsDetail::CopyAsciiText<char>(arena, sourceView);
        NameSymbols::DecodeHashTokens(arena, text);
        decoded.assign(AStringView(text));
    }

    EXPECT_EQ(decoded, expectedSource);
}

void VerifyNameSymbolDecodeTests_ResolvesWideSpansWithoutChangingUnresolvedText(){
    b8 unicodeEnabled = false;
    native(mut unicodeEnabled){
#if defined(FOUNDATION_UNICODE)
        unicodeEnabled = true;
        NameSymbols::InstallRuntimeRegistry();
        NameSymbols::ClearRuntimeSymbols();
#endif
    }
    if(!unicodeEnabled)
        return;

    GlobalArena arena(Name("Tests/NameSymbols/Resolved"));
    const Name shortName(s_DecodeShortSymbol);
    b8 longNameCreated = false;
    String source = "";
    String expectedSource = "";
    BuildResolvedSpanSources(shortName, longNameCreated, source, expectedSource);
    ASSERT_TRUE(longNameCreated);

    const StringView sourceView = source;
    const StringView expectedView = expectedSource;
    b8 decodedMatchesExpected = false;
    usize decodedLength = 0u;
    native(in sourceView, in expectedView, mut arena, mut decodedMatchesExpected, mut decodedLength){
#if defined(FOUNDATION_UNICODE)
        WString<GlobalArena> text = CommonTestsDetail::CopyAsciiText<wchar>(arena, sourceView);
        const WString<GlobalArena> expected = CommonTestsDetail::CopyAsciiText<wchar>(arena, expectedView);
        NameSymbols::DecodeHashTokens(arena, text);
        decodedMatchesExpected = text == expected;
        decodedLength = text.size();
#else
        static_cast<void>(sourceView);
        static_cast<void>(expectedView);
        static_cast<void>(arena);
        static_cast<void>(decodedMatchesExpected);
        static_cast<void>(decodedLength);
#endif
    }

    EXPECT_TRUE(decodedMatchesExpected);
    EXPECT_EQ(decodedLength, expectedSource.size());
}

void VerifyNameSymbolDecodeTests_EscapedDocumentRoundTripsAndMalformedRecordsStayUnpublished(){
    GlobalArena arena(Name("Tests/NameSymbols/EscapedDocument"));
    ScratchArena scratchArena(s_CommonNameTestsNameSymbolsScratch);
    NameSymbols::InstallRuntimeRegistry();
    NameSymbols::ClearRuntimeSymbols();
    const StringView original = s_OriginalEscapedSymbol;
    const Name stored(s_OriginalEscapedSymbol);
    b8 serialized = false;
    String documentText = "";
    b8 loadedFromMemory = false;
    b8 resolvedStored = false;
    String resolvedText = "";
    b8 resolvedInvalid = true;

    native(in stored, mut arena, mut scratchArena, mut serialized, mut documentText, mut loadedFromMemory, mut resolvedStored, mut resolvedText, mut resolvedInvalid){
        ScopeExit cleanup([]()noexcept{
            NameSymbols::ClearRuntimeSymbols();
            NameSymbols::UninstallRuntimeRegistry();
        });
        const NameHash invalidHash = ComputeNameHash(MakeNotNull("symbols/invalid_escape_record"));
        Array<char, NameHashTextCodec::s_TextLength + 1u> invalidToken = {};
        NameHashTextCodec::Format(invalidToken.data(), invalidToken.size(), invalidHash);

        AString<GlobalArena> document("prefix:", arena);
        const usize prefixLength = document.size();
        serialized = NameSymbols::Serialize(document).has_value();
        documentText.assign(AStringView(document));
        if(serialized){
            document.append(invalidToken.data()).append("\truntime\tinvalid\\q\n");
            document.append(invalidToken.data()).append("\truntime\tdangling\\\n");
            NameSymbols::ClearRuntimeSymbols();
            loadedFromMemory = NameSymbols::LoadFromMemory(AStringView(document.data() + prefixLength, document.size() - prefixLength), scratchArena);
            if(loadedFromMemory){
                Array<char, NameSymbols::s_MaxResolvedTextLength> resolved = {};
                resolvedStored = NameSymbols::Resolve(resolved.data(), resolved.size(), stored.identityHash());
                if(resolvedStored)
                    resolvedText.assign(AStringView(resolved.data()));
                resolvedInvalid = NameSymbols::Resolve(resolved.data(), resolved.size(), invalidHash);
            }
        }
    }

    ASSERT_TRUE(serialized);
    EXPECT_LT(documentText.find("symbols/line\\ncarriage\\rtab\\tend"), documentText.size());
    ASSERT_TRUE(loadedFromMemory);
    ASSERT_TRUE(resolvedStored);
    const StringView resolvedView = resolvedText;
    EXPECT_EQ(resolvedView, original);
    EXPECT_FALSE(resolvedInvalid);
}

void VerifyNameSymbolDecodeTests_RejectsNoncurrentDocumentHeaderBeforePublishingSymbols(){
    GlobalArena arena(Name("Tests/NameSymbols/DocumentAdmission"));
    ScratchArena scratchArena(s_CommonNameTestsNameSymbolsScratch);
    NameSymbols::InstallRuntimeRegistry();
    NameSymbols::ClearRuntimeSymbols();
    const Name retained(s_RetainedAdmissionSymbol);
    Array<StringView, 6> rejectedHeaders = Array<StringView, 6>();
    rejectedHeaders[0u] = "";
    rejectedHeaders[1u] = "nwb_namesym_v0\tproducer=runtime\n";
    rejectedHeaders[2u] = "nwb_namesym_v2\tproducer=runtime\n";
    rejectedHeaders[3u] = "nwb_namesym_v10\tproducer=runtime\n";
    rejectedHeaders[4u] = "nwb_namesym_v1_suffix\tproducer=runtime\n";
    rejectedHeaders[5u] = "\n";

    b8 rejectedAllInvalidHeaders = true;
    b8 loadedCurrentDocument = false;
    b8 retainedStillResolved = false;
    b8 incomingResolvedAfterLoad = false;
    String incomingText = "";

    native(in retained, in rejectedHeaders, mut arena, mut scratchArena, mut rejectedAllInvalidHeaders, mut loadedCurrentDocument, mut retainedStillResolved, mut incomingResolvedAfterLoad, mut incomingText){
        const NameHash incomingHash = ComputeNameHash(MakeNotNull("admission/incoming"));
        Array<char, NameHashTextCodec::s_TextLength + 1u> incomingToken = {};
        NameHashTextCodec::Format(incomingToken.data(), sizeof(incomingToken), incomingHash);
        AString<GlobalArena> record(arena);
        StringAppendFormat(record, "{}\truntime\tAdmission/Incoming\n", incomingToken.data());
        const usize retainedCount = NameSymbols::EntryCount();
        Array<char, NameSymbols::s_MaxResolvedTextLength> resolvedText = {};
        for(const AStringView header : rejectedHeaders){
            AString<GlobalArena> document(arena);
            document.append(header).append(record);
            const b8 loaded = NameSymbols::LoadFromMemory(AStringView(document), scratchArena);
            const b8 countPreserved = NameSymbols::EntryCount() == retainedCount;
            const b8 retainedOk = NameSymbols::Resolve(resolvedText.data(), sizeof(resolvedText), retained.hash()) && AStringView(resolvedText.data()) == "admission/retained";
            const b8 incomingPublished = NameSymbols::Resolve(resolvedText.data(), sizeof(resolvedText), incomingHash);
            if(loaded || !countPreserved || !retainedOk || incomingPublished)
                rejectedAllInvalidHeaders = false;
        }

        AString<GlobalArena> currentDocument(arena);
        currentDocument.append(NameSymbols::s_FileHeader).append("\tproducer=runtime\r\n").append(record);
        loadedCurrentDocument = NameSymbols::LoadFromMemory(AStringView(currentDocument), scratchArena);
        if(loadedCurrentDocument){
            retainedStillResolved = NameSymbols::Resolve(resolvedText.data(), sizeof(resolvedText), retained.hash());
            incomingResolvedAfterLoad = NameSymbols::Resolve(resolvedText.data(), sizeof(resolvedText), incomingHash);
            if(incomingResolvedAfterLoad)
                incomingText.assign(AStringView(resolvedText.data()));
        }
        NameSymbols::ClearRuntimeSymbols();
    }

    EXPECT_TRUE(rejectedAllInvalidHeaders);
    ASSERT_TRUE(loadedCurrentDocument);
    EXPECT_TRUE(retainedStillResolved);
    ASSERT_TRUE(incomingResolvedAfterLoad);
    const StringView incomingView = incomingText;
    EXPECT_EQ(incomingView, "admission/incoming");
}

Expected<b8, ErrorCode> LoadNameSymbolsFileForTest(in Path path, mut ScratchArena scratchArena){
    return NameSymbols::LoadFile(path, scratchArena);
}

void VerifyNameSymbolDecodeTests_FileLoadSeparatesHeaderAnswerFromNativeReadFailure(){
    ScratchArena scratchArena(s_CommonNameTestsNameSymbolsScratch);
    const Path path("name_symbol_expected_file_unit.namesym");
    ASSERT_TRUE(RemoveAllIfExists(path).has_value());

    const b8 wroteV1 = WriteTextFile(path, "nwb_namesym_v1\n");
    Expected<b8, ErrorCode> accepted = false;
    if(wroteV1)
        accepted = LoadNameSymbolsFileForTest(path, scratchArena);

    const b8 wroteV2 = wroteV1 && WriteTextFile(path, "nwb_namesym_v2\n");
    Expected<b8, ErrorCode> rejectedHeader = true;
    if(wroteV2)
        rejectedHeader = LoadNameSymbolsFileForTest(path, scratchArena);

    const Expected<b8, ErrorCode> removed = RemoveFile(path);
    const Expected<u64, ErrorCode> missingFileSize = FileSize(path);
    const Expected<b8, ErrorCode> missing = LoadNameSymbolsFileForTest(path, scratchArena);
    const b8 cleanedUp = RemoveFile(path).has_value();

    ASSERT_TRUE(wroteV1);
    ASSERT_TRUE(accepted.has_value());
    EXPECT_TRUE(accepted.value());
    ASSERT_TRUE(wroteV2);
    ASSERT_TRUE(rejectedHeader.has_value());
    EXPECT_FALSE(rejectedHeader.value());
    ASSERT_TRUE(removed.has_value());
    ASSERT_TRUE(removed.value());
    ASSERT_FALSE(missingFileSize.has_value());
    ASSERT_FALSE(missing.has_value());
    EXPECT_EQ(missing.error(), missingFileSize.error());
    EXPECT_EQ(missing.error().category(), missingFileSize.error().category());
    EXPECT_TRUE(cleanedUp);
}

void VerifyNameSymbolDecodeTests_NameSymbolsCollectArenaOwnersWithoutPerformanceCapture(){
    b8 buildSymbolsEnabled = false;
    b8 preResolveAny = true;
    b8 serialized = false;
    String serializedText = "";
    b8 resolvedLive = false;
    b8 resolvedRetired = false;
    b8 resolvedHeap = false;
    String liveResolvedText = "";
    String retiredResolvedText = "";
    String heapResolvedText = "";
    b8 wroteDefaultFile = false;
    b8 readDefaultFile = false;
    String defaultFileText = "";
    b8 loadedDefaultOk = false;
    b8 resolvedLiveAfterDefault = false;
    String liveAfterDefaultText = "";
    b8 removedDefaultFile = false;

    native(
        mut buildSymbolsEnabled,
        mut preResolveAny,
        mut serialized,
        mut serializedText,
        mut resolvedLive,
        mut resolvedRetired,
        mut resolvedHeap,
        mut liveResolvedText,
        mut retiredResolvedText,
        mut heapResolvedText,
        mut wroteDefaultFile,
        mut readDefaultFile,
        mut defaultFileText,
        mut loadedDefaultOk,
        mut resolvedLiveAfterDefault,
        mut liveAfterDefaultText,
        mut removedDefaultFile
    ){
#if defined(NWB_BUILD_SYMBOLS)
        buildSymbolsEnabled = true;
#endif
        constexpr NameHash s_LiveHash = ComputeNameHash(MakeNotNull("tests/namesymbols/before_registry_live"));
        constexpr NameHash s_RetiredHash = ComputeNameHash(MakeNotNull("tests/namesymbols/before_registry_retired"));
        constexpr NameHash s_HeapHash = ComputeNameHash(MakeNotNull("global/arena_memory/heap_backing"));
        NameSymbols::UninstallRuntimeRegistry();
        GlobalArena liveOwner(s_CommonNameTestsNameSymbolsBeforeRegistryLive);
        {
            GlobalArena retiredOwner(s_CommonNameTestsNameSymbolsBeforeRegistryRetired);
        }
        NameSymbols::InstallRuntimeRegistry();
        NameSymbols::ClearRuntimeSymbols();

        Array<char, 128u> resolvedBuffer = {};
        preResolveAny =
            NameSymbols::Resolve(resolvedBuffer.data(), sizeof(resolvedBuffer), s_LiveHash)
            || NameSymbols::Resolve(resolvedBuffer.data(), sizeof(resolvedBuffer), s_RetiredHash)
            || NameSymbols::Resolve(resolvedBuffer.data(), sizeof(resolvedBuffer), s_HeapHash)
        ;

        ::AString<GlobalArena> namesymText(liveOwner);
        serialized = NameSymbols::Serialize(namesymText).has_value();
        serializedText.assign(AStringView(namesymText));

        resolvedLive = NameSymbols::Resolve(resolvedBuffer.data(), sizeof(resolvedBuffer), s_LiveHash);
        if(resolvedLive)
            liveResolvedText.assign(AStringView(resolvedBuffer.data()));
        resolvedRetired = NameSymbols::Resolve(resolvedBuffer.data(), sizeof(resolvedBuffer), s_RetiredHash);
        if(resolvedRetired)
            retiredResolvedText.assign(AStringView(resolvedBuffer.data()));
        resolvedHeap = NameSymbols::Resolve(resolvedBuffer.data(), sizeof(resolvedBuffer), s_HeapHash);
        if(resolvedHeap)
            heapResolvedText.assign(AStringView(resolvedBuffer.data()));

        NameSymbols::ClearRuntimeSymbols();
        const auto executableDirectory = ExecutablePaths(liveOwner).directory();
        const auto executableName = ExecutablePaths(liveOwner).name();
        ASSERT_TRUE(executableDirectory);
        ASSERT_TRUE(executableName);
        ::Path<GlobalArena> namesymPath = *executableDirectory / *executableName;
        namesymPath.replaceExtension(FOUNDATION_TEXT(".namesym"));
        // The application exception path exports after its scoped runtime callbacks have already detached.
        NameSymbols::UninstallRuntimeRegistry();
        wroteDefaultFile = NameSymbols::WriteDefaultFile();
        NameSymbols::InstallRuntimeRegistry();
        namesymText.clear();
        if(wroteDefaultFile){
            readDefaultFile = ReadTextFile(namesymPath, namesymText).has_value();
            defaultFileText.assign(AStringView(namesymText));
        }
        NameSymbols::ClearRuntimeSymbols();
        const auto loadedDefault = NameSymbols::LoadDefaultFile();
        loadedDefaultOk = loadedDefault ? *loadedDefault : loadedDefault.error().loadedAny;
        resolvedLiveAfterDefault = NameSymbols::Resolve(resolvedBuffer.data(), sizeof(resolvedBuffer), s_LiveHash);
        if(resolvedLiveAfterDefault)
            liveAfterDefaultText.assign(AStringView(resolvedBuffer.data()));
        removedDefaultFile = RemoveFile(namesymPath).has_value();
    }

    EXPECT_FALSE(preResolveAny);
    ASSERT_TRUE(serialized);
    if(buildSymbolsEnabled){
        EXPECT_TRUE(resolvedLive);
        const StringView liveView = liveResolvedText;
        EXPECT_EQ(liveView, s_TestsNamesymbolsBeforeRegistryLive);
        EXPECT_TRUE(resolvedRetired);
        const StringView retiredView = retiredResolvedText;
        EXPECT_EQ(retiredView, s_TestsNamesymbolsBeforeRegistryRetire);
        EXPECT_TRUE(resolvedHeap);
        const StringView heapView = heapResolvedText;
        EXPECT_EQ(heapView, s_GlobalArenaMemoryHeapBacking);
        EXPECT_LT(serializedText.find(s_TestsNamesymbolsBeforeRegistryLive), serializedText.size());
        EXPECT_LT(serializedText.find(s_TestsNamesymbolsBeforeRegistryRetire), serializedText.size());
        EXPECT_LT(serializedText.find(s_GlobalArenaMemoryHeapBacking), serializedText.size());
    }
    else{
        EXPECT_FALSE(resolvedLive);
        EXPECT_FALSE(resolvedRetired);
        EXPECT_FALSE(resolvedHeap);
    }

    ASSERT_TRUE(wroteDefaultFile);
    ASSERT_TRUE(readDefaultFile);
    if(buildSymbolsEnabled){
        EXPECT_LT(defaultFileText.find(s_TestsNamesymbolsBeforeRegistryLive), defaultFileText.size());
        EXPECT_LT(defaultFileText.find(s_TestsNamesymbolsBeforeRegistryRetire), defaultFileText.size());
        EXPECT_LT(defaultFileText.find(s_GlobalArenaMemoryHeapBacking), defaultFileText.size());
    }
    else{
        EXPECT_GE(defaultFileText.find(s_TestsNamesymbolsBeforeRegistryLive), defaultFileText.size());
        EXPECT_GE(defaultFileText.find(s_TestsNamesymbolsBeforeRegistryRetire), defaultFileText.size());
        EXPECT_GE(defaultFileText.find(s_GlobalArenaMemoryHeapBacking), defaultFileText.size());
    }
    EXPECT_TRUE(loadedDefaultOk);
    if(buildSymbolsEnabled){
        ASSERT_TRUE(resolvedLiveAfterDefault);
        const StringView liveDefaultView = liveAfterDefaultText;
        EXPECT_EQ(liveDefaultView, s_TestsNamesymbolsBeforeRegistryLive);
    }
    EXPECT_TRUE(removedDefaultFile);
}

void VerifyNameSymbolDecodeTests_ConcurrentRecordResolveClearAndUninstallStaySynchronized(){
    const u32 expectedRecorderIterations = 400u;
    const usize maxAllowedEntries = 64u;
    u32 completedIterations = 0u;
    b8 sawIdentityMismatch = false;
    b8 sawResolvedTextMismatch = false;
    usize observedPeakEntryCount = 0u;

    native(in expectedRecorderIterations, mut completedIterations, mut sawIdentityMismatch, mut sawResolvedTextMismatch, mut observedPeakEntryCount){
        NameSymbols::InstallRuntimeRegistry();
        NameSymbols::ClearRuntimeSymbols();
        ScopeExit restoreRegistry([]()noexcept{
            NameSymbols::InstallRuntimeRegistry();
            NameSymbols::ClearRuntimeSymbols();
        });

        constexpr AStringView s_TargetText = "concurrent/symbol_entry";
        const NameHash targetHash = ComputeNameHash(MakeNotNull("concurrent/symbol_entry"));
        Atomic<b8> stop{ false };
        Atomic<u32> recordedCount{ 0u };
        Atomic<b8> identityMismatch{ false };
        Atomic<b8> resolvedMismatch{ false };
        Atomic<usize> maxCount{ 0u };
        Latch startLatch(4);

        {
            JoiningThread recorderThread([&](){
                startLatch.arrive_and_wait();
                for(u32 i = 0u; i < expectedRecorderIterations; ++i){
                    const Name recorded(s_TargetText);
                    if(recorded.identityHash() != targetHash)
                        identityMismatch.store(true, MemoryOrder::relaxed);
                    recordedCount.fetch_add(1u, MemoryOrder::relaxed);
                }
                stop.store(true, MemoryOrder::release);
            });

            JoiningThread resolverThread([&](){
                startLatch.arrive_and_wait();
                Array<char, NameSymbols::s_MaxResolvedTextLength> buffer = {};
                while(!stop.load(MemoryOrder::acquire)){
                    if(NameSymbols::Resolve(buffer.data(), buffer.size(), targetHash) && AStringView(buffer.data()) != s_TargetText)
                        resolvedMismatch.store(true, MemoryOrder::relaxed);
                }
            });

            JoiningThread clearThread([&](){
                startLatch.arrive_and_wait();
                while(!stop.load(MemoryOrder::acquire)){
                    NameSymbols::ClearRuntimeSymbols();
                    const usize count = NameSymbols::EntryCount();
                    usize previousMax = maxCount.load(MemoryOrder::relaxed);
                    while(count > previousMax && !maxCount.compare_exchange_weak(previousMax, count, MemoryOrder::relaxed)){}
                }
            });

            JoiningThread toggleThread([&](){
                startLatch.arrive_and_wait();
                while(!stop.load(MemoryOrder::acquire)){
                    NameSymbols::UninstallRuntimeRegistry();
                    NameSymbols::InstallRuntimeRegistry();
                }
            });
        }

        completedIterations = recordedCount.load(MemoryOrder::relaxed);
        sawIdentityMismatch = identityMismatch.load(MemoryOrder::relaxed);
        sawResolvedTextMismatch = resolvedMismatch.load(MemoryOrder::relaxed);
        observedPeakEntryCount = maxCount.load(MemoryOrder::relaxed);
    }

    EXPECT_EQ(completedIterations, expectedRecorderIterations);
    EXPECT_FALSE(sawIdentityMismatch);
    EXPECT_FALSE(sawResolvedTextMismatch);
    EXPECT_LE(observedPeakEntryCount, maxAllowedEntries);
}

void VerifyCommonLoggingBoundaries_LoggerMacrosBehaveAsSingleStatements(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard guard(logger);

    b8 elseBranchRan = false;
    native(mut elseBranchRan){
        if(false)
            NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("unreachable"));
        else
            elseBranchRan = true;
    }

    EXPECT_TRUE(elseBranchRan);
    EXPECT_EQ(logger.messageCount(), 0u);
}

void VerifyCommonLoggingBoundaries_CapturingLoggerSerializesConcurrentWritersAndReaders(){
    const u32 threadCount = 4u;
    const u32 messagesPerThread = 512u;
    const u32 expectedMessageCount = threadCount * messagesPerThread;
    const u32 expectedErrorCount = expectedMessageCount / 2u;
    CapturingLogger logger = CapturingLogger();
    b8 sawInvalidObservation = false;
    u32 observedMessageTotal = 0u;
    u32 observedErrorTotal = 0u;

    native(mut logger, mut sawInvalidObservation, mut observedMessageTotal, mut observedErrorTotal){
        static constexpr TStringView s_ParallelLoggerMessage = FOUNDATION_TEXT("parallel logger message");
        Latch startGate(threadCount + 2u);
        Atomic<u32> activeWriters{ threadCount };
        Atomic<u32> observedMessages{ 0u };
        Atomic<u32> observedErrors{ 0u };
        Atomic<b8> invalidObservation{ false };
        Thread reader([&]()noexcept{
            startGate.arrive_and_wait();
            // Wait for the first writer burst so reads overlap live writes.
            while(activeWriters.load(MemoryOrder::acquire) == threadCount)
                YieldThread();
            u32 lastMessageCount = 0u;
            u32 lastErrorCount = 0u;
            do{
                const u32 messageCount = logger.messageCount();
                const u32 errorCount = logger.errorCount();
                const Core::Common::LogType::Enum lastType = logger.lastType();
                // Fail only on impossible counts, not on momentary message/error skew.
                if(messageCount > expectedMessageCount || errorCount > expectedErrorCount || (lastType != Core::Common::LogType::Info && lastType != Core::Common::LogType::Error))
                    invalidObservation.store(true, MemoryOrder::relaxed);
                if(messageCount > lastMessageCount){
                    observedMessages.fetch_add(messageCount - lastMessageCount, MemoryOrder::relaxed);
                    lastMessageCount = messageCount;
                }
                if(errorCount > lastErrorCount){
                    observedErrors.fetch_add(errorCount - lastErrorCount, MemoryOrder::relaxed);
                    lastErrorCount = errorCount;
                }
                YieldThread();
            }while(activeWriters.load(MemoryOrder::acquire) != 0u);
            // Drain the tail after the last writer exits the loop.
            const u32 messageCount = logger.messageCount();
            const u32 errorCount = logger.errorCount();
            if(messageCount > lastMessageCount)
                observedMessages.fetch_add(messageCount - lastMessageCount, MemoryOrder::relaxed);
            if(errorCount > lastErrorCount)
                observedErrors.fetch_add(errorCount - lastErrorCount, MemoryOrder::relaxed);
            // Partial reads already proved reader and writer overlap.
        });
        Array<Thread, 4> writers;
        for(u32 threadIndex = 0u; threadIndex < threadCount; ++threadIndex){
            writers[threadIndex] = Thread([&logger, &startGate, &activeWriters](){
                startGate.arrive_and_wait();
                for(u32 messageIndex = 0u; messageIndex < messagesPerThread; ++messageIndex){
                    const Core::Common::LogType::Enum type = (messageIndex & 1u) == 0u ? Core::Common::LogType::Info : Core::Common::LogType::Error;
                    Core::Common::LoggerDetail::EnqueueMessage(logger, type, s_ParallelLoggerMessage);
                }
                activeWriters.fetch_sub(1u, MemoryOrder::release);
            });
        }

        startGate.arrive_and_wait();
        for(Thread& writer : writers)
            writer.join();
        reader.join();

        sawInvalidObservation = invalidObservation.load(MemoryOrder::relaxed);
        observedMessageTotal = observedMessages.load(MemoryOrder::relaxed);
        observedErrorTotal = observedErrors.load(MemoryOrder::relaxed);
    }

    EXPECT_FALSE(sawInvalidObservation);
    // Reader polls live counts, so it always overlaps writes in progress.
    EXPECT_GT(observedMessageTotal, 0u);
    EXPECT_GT(observedErrorTotal, 0u);
    EXPECT_EQ(logger.messageCount(), expectedMessageCount);
    EXPECT_EQ(logger.errorCount(), expectedErrorCount);
    EXPECT_TRUE(SawCapturedMessage(logger, s_ParallelLoggerMessageText));
    EXPECT_TRUE(SawCapturedError(logger, s_ParallelLoggerMessageText));
}

void VerifyCommonLoggingBoundaries_GuardTeardownInsideEnqueueWaitsForOtherReaderWithoutSelfDeadlock(){
    CapturingLogger baseLogger = CapturingLogger();
    LoggerRegistrationGuard baseGuard(baseLogger, LoggerBreakPolicy::ReportOnly);
    b8 nestedGuardStillPresent = false;
    b8 unregistrationReturnedEarly = false;
    u32 totalCallbacks = 0u;

    native(mut baseLogger, mut nestedGuardStillPresent, mut unregistrationReturnedEarly, mut totalCallbacks){
        Optional<LoggerRegistrationGuard> nestedGuard;
        Latch bothEnteredGate(2u);
        AtomicFlag unregistrationStarted;
        Atomic<b8> peerStillInCallback{ true };
        Atomic<b8> unregistrationReturnedWhilePeerActive{ false };
        Atomic<u32> callbackCount{ 0u };

        CommonTestsDetail::CallbackUnregisterLogger callbackLogger(
            baseLogger.arena(),
            nestedGuard,
            bothEnteredGate,
            unregistrationStarted,
            peerStillInCallback,
            unregistrationReturnedWhilePeerActive,
            callbackCount
        );
        nestedGuard.emplace(callbackLogger, LoggerBreakPolicy::ReportOnly);

        Thread selfUnregisterThread([](){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("self-unregister"));
        });
        Thread peerReaderThread([](){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("peer-reader"));
        });

        selfUnregisterThread.join();
        peerReaderThread.join();

        nestedGuardStillPresent = nestedGuard.has_value();
        unregistrationReturnedEarly = unregistrationReturnedWhilePeerActive.load(MemoryOrder::relaxed);
        totalCallbacks = callbackCount.load(MemoryOrder::relaxed);
    }

    EXPECT_FALSE(nestedGuardStillPresent);
    EXPECT_FALSE(unregistrationReturnedEarly);
    EXPECT_EQ(totalCallbacks, 2u);
    EXPECT_EQ(baseLogger.messageCount(), 1u);
    EXPECT_TRUE(SawCapturedMessage(baseLogger, "routed-to-base-after-self-unregister"));
}


