void VerifyUiListBuilderTests_SiblingListsPaintTheirOwnDeferredBackgroundStyles(mut UiListBuilderTests self){
    self.m_source.count = 0u;
    ListState secondState = ListState();
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPanel(s_UiListCasePanelKey, Rect(10.0f, 10.0f, 320.0f, 260.0f)));
    self.m_builder.listStyle().background = Name(s_UiCaseNameButtonNormal);
    ASSERT_TRUE(self.m_builder.virtualList("first", self.m_source, self.m_state, MakeUiListBuilderDefaultOptions()).valid);
    self.m_builder.listStyle().background = Name(s_UiCaseButtonHover);
    ASSERT_TRUE(self.m_builder.virtualList("second", self.m_source, secondState, MakeUiListBuilderDefaultOptions()).valid);
    ASSERT_TRUE(self.finishPanel());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    const Expected<Rect> first = self.skinQuad(snapshot, 6u);
    ASSERT_TRUE(first.has_value());
    const Expected<Rect> second = self.skinQuad(snapshot, 7u);
    ASSERT_TRUE(second.has_value());
    EXPECT_LT(first.value().y, second.value().y);
}

void VerifyUiListBuilderTests_DistantTallRowGrowsBeforePaintingAndPreservesItsPixelScrollAnchor(mut UiListBuilderTests self){
    self.m_source.specialIndex = 50000u;
    ASSERT_TRUE(self.accept(1u));
    const Optional<HitTarget> firstRowOpt = FindUiListBuilderTarget(self, self.row(1u));
    ASSERT_TRUE(firstRowOpt.has_value());
    const f32 initialHeight = firstRowOpt.value().rectangle.height;
    const f64 within = cast<f64>(initialHeight) * 0.25;
    ASSERT_TRUE(self.m_state.scrollTo(cast<f64>(self.m_source.specialIndex) * cast<f64>(initialHeight) + within));
    self.m_source.textCalls = 0u;
    self.m_source.keyCalls = 0u;
    self.m_source.lookupCalls = 0u;
    ASSERT_TRUE(self.accept(2u));
    const ScrollPlacement placement = self.m_state.placement();
    ASSERT_EQ(placement.firstRow, self.m_source.specialIndex);
    const Optional<HitTarget> tallOpt = FindUiListBuilderTarget(self, self.row(self.m_source.specialIndex + 1u));
    ASSERT_TRUE(tallOpt.has_value());
    const HitTarget tall = tallOpt.value();
    const f32 grownHeight = tall.rectangle.height;
    EXPECT_GT(grownHeight, initialHeight);
    const f64 grown = cast<f64>(grownHeight);
    EXPECT_NEAR(cast<f64>(tall.rectangle.y), cast<f64>(placement.viewport.y) - within, 0.0001);
    EXPECT_DOUBLE_EQ(self.m_state.scrollOffset(), cast<f64>(self.m_source.specialIndex) * grown + within);
    EXPECT_DOUBLE_EQ(placement.contentHeight, cast<f64>(self.m_source.count) * grown);
    const Expected<SelectableMetrics> metrics = MeasureSelectable(self.m_skin, self.m_builder.listStyle().row);
    const Expected<TextLayout, TextLayoutStatusEnum> layout = self.m_text.layout(MakeUiListShapeRequest(self.m_source.specialText, self.m_builder.style().fontSize));
    ASSERT_TRUE(metrics.has_value());
    ASSERT_TRUE(layout.has_value());
    const Expected<Rect> visual = self.m_text.measure(layout.value(), self.m_paint.displayMetrics());
    ASSERT_TRUE(visual.has_value());
    EXPECT_GE(grownHeight + 0.0001f, visual.value().height + metrics.value().padding.top + metrics.value().padding.bottom);
    const u64 provisionalBound = cast<u64>(Ceil(placement.viewport.height / initialHeight)) + 1u;
    EXPECT_LE(self.m_source.textCalls, provisionalBound);
    EXPECT_LE(self.m_source.keyCalls, provisionalBound * 2u + 2u);
    EXPECT_LE(self.m_source.lookupCalls, provisionalBound + 2u);
    EXPECT_LT(self.m_context.input().targets().size(), 16u);
    ASSERT_TRUE(self.m_state.scrollTo(0.0));
    ASSERT_TRUE(self.accept(3u));
    const Optional<HitTarget> rowAfterScroll = FindUiListBuilderTarget(self, self.row(1u));
    ASSERT_TRUE(rowAfterScroll.has_value());
    EXPECT_FLOAT_EQ(rowAfterScroll.value().rectangle.height, grownHeight);
    ++self.m_source.contentRevision;
    ASSERT_TRUE(self.accept(4u));
    const Optional<HitTarget> rowAfterRevision = FindUiListBuilderTarget(self, self.row(1u));
    ASSERT_TRUE(rowAfterRevision.has_value());
    EXPECT_FLOAT_EQ(rowAfterRevision.value().rectangle.height, initialHeight);
}

void VerifyUiListBuilderTests_InvisibleTallMaximumIsInvalidatedByFontShapingDisplayAndResolvedRowGeometry(mut UiListBuilderTests self){
    const SelectableStyle originalStyle = self.m_builder.listStyle().row;
    u64 generation = 1u;
    for(u32 change = 0u; change < 7u; ++change){
        const ScopedTestTrace trace = ScopedTestTrace(change);
        self.m_builder.style().fontSize = 16.0f;
        SetUiListBuilderRowStyle(self.m_builder, originalStyle);
        ASSERT_TRUE(self.m_builder.setTextShaping(MakeUiListLatnScriptTag(), "en"));
        ListState state = ListState();
        UiListArithmeticSource source = UiListArithmeticSource();
        source.specialIndex = 50000u;
        DisplayMetrics display = DisplayMetrics(800.0f, 600.0f, 1.0f, 1.0f);
        ASSERT_TRUE(self.prepareSource(generation, source, state, MakeUiListBuilderDefaultOptions(), display));
        ASSERT_TRUE(self.m_context.commitFrame(generation));
        ++generation;
        const Optional<HitTarget> seedOpt = FindUiListBuilderTarget(self, self.row(1u));
        ASSERT_TRUE(seedOpt.has_value());
        const f32 seed = seedOpt.value().rectangle.height;
        ASSERT_TRUE(state.scrollTo(cast<f64>(source.specialIndex) * cast<f64>(seed)));
        ASSERT_TRUE(self.prepareSource(generation, source, state, MakeUiListBuilderDefaultOptions(), display));
        ASSERT_TRUE(self.m_context.commitFrame(generation));
        ++generation;
        const Optional<HitTarget> grownOpt = FindUiListBuilderTarget(self, self.row(source.specialIndex + 1u));
        ASSERT_TRUE(grownOpt.has_value());
        const f32 grown = grownOpt.value().rectangle.height;
        ASSERT_GT(grown, seed);
        ASSERT_TRUE(state.scrollTo(0.0));
        ASSERT_TRUE(self.prepareSource(generation, source, state, MakeUiListBuilderDefaultOptions(), display));
        ASSERT_TRUE(self.m_context.commitFrame(generation));
        ++generation;
        const Optional<HitTarget> cachedOpt = FindUiListBuilderTarget(self, self.row(1u));
        ASSERT_TRUE(cachedOpt.has_value());
        ASSERT_FLOAT_EQ(cachedOpt.value().rectangle.height, grown);
        switch(change){
        case 0u:
            ASSERT_TRUE(UiListInstallLatinFont(self.m_arena, self.m_font, self.m_text));
            break;
        case 1u:
            self.m_builder.style().fontSize = 12.0f;
            break;
        case 2u:
            display.pixelScaleX = 1.25f;
            display.pixelScaleY = 1.5f;
            break;
        case 3u:
            ASSERT_TRUE(self.m_builder.setTextShaping(MakeUiListLatnScriptTag(), "ko"));
            break;
        case 4u:
            self.m_builder.listStyle().row.padding.bottom = self.m_builder.listStyle().row.padding.bottom + 2.0f;
            break;
        case 5u:
            ++source.generation;
            break;
        case 6u:
            --source.count;
            break;
        default:
            break;
        }
        source.textCalls = 0u;
        ASSERT_TRUE(self.prepareSource(generation, source, state, MakeUiListBuilderDefaultOptions(), display));
        ASSERT_TRUE(self.m_context.commitFrame(generation));
        ++generation;
        const Optional<HitTarget> refreshedOpt = FindUiListBuilderTarget(self, self.row(1u));
        ASSERT_TRUE(refreshedOpt.has_value());
        const f32 refreshed = refreshedOpt.value().rectangle.height;
        EXPECT_LT(refreshed, grown);
        const Expected<SelectableMetrics> metrics = MeasureSelectable(self.m_skin, self.m_builder.listStyle().row);
        ASSERT_TRUE(metrics.has_value());
        f32 expected = metrics.value().minimum.y;
        StringView language = "en";
        if(change == 3u){
            language = "ko";
        }
        Array<StringView, 2u> labels = Array<StringView, 2u>();
        labels[0u] = "";
        labels[1u] = s_UiListCaseFirstRowText;
        for(in StringView label : labels){
            const Expected<TextLayout, TextLayoutStatusEnum> layout = self.m_text.layout(MakeUiListLanguageShapeRequest(label, language, self.m_builder.style().fontSize));
            ASSERT_TRUE(layout.has_value());
            const Expected<Rect> visual = self.m_text.measure(layout.value(), display);
            ASSERT_TRUE(visual.has_value());
            expected = Max(expected, visual.value().height + metrics.value().padding.top + metrics.value().padding.bottom);
        }
        EXPECT_FLOAT_EQ(refreshed, expected);
        EXPECT_LE(source.textCalls, 8u);
    }
}

void VerifyUiListBuilderTests_ReplacingTextServiceWithTheSameGenerationInvalidatesTheCachedMaximum(mut UiListBuilderTests self){
    self.m_source.specialIndex = 50000u;
    ASSERT_TRUE(self.accept(1u));
    const Optional<HitTarget> seedOpt = FindUiListBuilderTarget(self, self.row(1u));
    ASSERT_TRUE(seedOpt.has_value());
    const f32 seed = seedOpt.value().rectangle.height;
    ASSERT_TRUE(self.m_state.scrollTo(cast<f64>(self.m_source.specialIndex) * cast<f64>(seed)));
    ASSERT_TRUE(self.accept(2u));
    const Optional<HitTarget> grownOpt = FindUiListBuilderTarget(self, self.row(self.m_source.specialIndex + 1u));
    ASSERT_TRUE(grownOpt.has_value());
    const f32 grown = grownOpt.value().rectangle.height;
    ASSERT_GT(grown, seed);
    ASSERT_TRUE(self.m_state.scrollTo(0.0));
    ASSERT_TRUE(self.accept(3u));
    const Optional<HitTarget> cachedOpt = FindUiListBuilderTarget(self, self.row(1u));
    ASSERT_TRUE(cachedOpt.has_value());
    ASSERT_FLOAT_EQ(cachedOpt.value().rectangle.height, grown);
    TextService replacement = TextService(self.m_arena);
    ASSERT_TRUE(UiListInstallLatinFont(self.m_arena, self.m_font, replacement));
    ASSERT_EQ(replacement.generation(), self.m_text.generation());
    ASSERT_NE(replacement.identity(), self.m_text.identity());
    Builder builder = Builder(self.m_arena, self.m_context, self.m_paint, replacement);
    builder.setSkin(self.m_skin);
    CopyUiListBuilderStyles(self.m_builder, builder);
    ASSERT_TRUE(self.begin(4u));
    ASSERT_TRUE(builder.beginPanel(s_UiListCasePanelKey, Rect(10.0f, 10.0f, 320.0f, 260.0f)));
    ASSERT_TRUE(builder.virtualList(s_UiListCaseListKey, self.m_source, self.m_state, MakeUiListBuilderDefaultOptions()).valid);
    ASSERT_TRUE(builder.endPanel());
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(4u));
    const Optional<HitTarget> finalOpt = FindUiListBuilderTarget(self, self.row(1u));
    ASSERT_TRUE(finalOpt.has_value());
    EXPECT_FLOAT_EQ(finalOpt.value().rectangle.height, seed);
    EXPECT_EQ(replacement.generation(), self.m_text.generation());
}

void VerifyUiListBuilderTests_SharedStateDeclarationsMergeSameMetricMaximaWithoutContaminatingDifferentMetrics(mut UiListBuilderTests self){
    u64 generation = 1u;
    Array<b8, 2u> metricModes = Array<b8, 2u>();
    metricModes[0u] = false;
    metricModes[1u] = true;
    for(in b8 differentMetrics : metricModes){
        const ScopedTestTrace trace = ScopedTestTrace(differentMetrics);
        UiListArithmeticSource source = UiListArithmeticSource();
        source.specialIndex = 2u;
        ListState state = ListState();
        ASSERT_TRUE(self.begin(generation));
        ASSERT_TRUE(self.m_builder.beginPanel(s_UiListCasePanelKey, Rect(10.0f, 10.0f, 320.0f, 260.0f)));
        self.m_builder.style().fontSize = 22.0f;
        ASSERT_TRUE(self.m_builder.virtualList(s_UiListCaseListKey, source, state, MakeUiListBuilderDefaultOptions()).valid);
        if(differentMetrics){
            self.m_builder.style().fontSize = 12.0f;
        }
        ListOptions small = MakeUiListBuilderDefaultOptions();
        small.height.value = 40.0f;
        ASSERT_TRUE(self.m_builder.virtualList("second", source, state, small).valid);
        ASSERT_TRUE(self.finishPanel());
        ASSERT_TRUE(self.m_context.commitFrame(generation));
        ++generation;
        const Optional<HitTarget> firstOpt = FindUiListBuilderTarget(self, self.row(1u));
        ASSERT_TRUE(firstOpt.has_value());
        const f32 firstHeight = firstOpt.value().rectangle.height;
        const WidgetId secondRow = UiListBuilderRequireWidgetPartId(UiListBuilderRequireWidgetId(self.id("second", s_UiListCasePanelKey), s_UiListCaseRowsKey), 1u);
        const Optional<HitTarget> secondOpt = FindUiListBuilderTarget(self, secondRow);
        ASSERT_TRUE(secondOpt.has_value());
        const f32 secondHeight = secondOpt.value().rectangle.height;
        ASSERT_GT(firstHeight, secondHeight);
        ASSERT_TRUE(state.scrollTo(0.0));
        ASSERT_TRUE(self.prepareSource(generation, source, state, small));
        ASSERT_TRUE(self.m_context.commitFrame(generation));
        ++generation;
        const Optional<HitTarget> mergedOpt = FindUiListBuilderTarget(self, self.row(1u));
        ASSERT_TRUE(mergedOpt.has_value());
        if(differentMetrics){
            EXPECT_FLOAT_EQ(mergedOpt.value().rectangle.height, secondHeight);
        }
        else{
            EXPECT_FLOAT_EQ(mergedOpt.value().rectangle.height, firstHeight);
        }
    }
}

void VerifyUiListBuilderTests_SharedStyledContentKeepsItsFractionalFirstRowAndInheritedClipAcrossFrames(mut UiListBuilderTests self){
    self.m_builder.style().fontSize = 12.0f;
    self.m_source.specialIndex = 16u;
    ASSERT_TRUE(self.accept(1u));
    const Optional<HitTarget> naturalOpt = FindUiListBuilderTarget(self, self.row(1u));
    ASSERT_TRUE(naturalOpt.has_value());
    const f32 naturalHeight = naturalOpt.value().rectangle.height;
    ASSERT_TRUE(self.m_state.scrollTo(cast<f64>(naturalHeight) * 10.25));
    const WidgetId earlier = UiListBuilderRequireWidgetId(self.id("clipped", s_UiListCasePanelKey), "earlier");
    const WidgetId earlierRows = UiListBuilderRequireWidgetId(earlier, s_UiListCaseRowsKey);
    Rect previousRow = Rect();
    Rect previousClip = Rect();
    for(u64 generation = 2u; generation <= 3u; ++generation){
        ASSERT_TRUE(self.begin(generation));
        ASSERT_TRUE(self.m_builder.beginPanel(s_UiListCasePanelKey, Rect(10.0f, 10.0f, 320.0f, 260.0f)));
        ContainerOptions clipped = ContainerOptions();
        clipped.height = LayoutSize(LayoutSizePolicy::Fixed, 20.0f);
        ASSERT_TRUE(self.m_builder.beginColumn("clipped", clipped));
        self.m_builder.style().fontSize = 12.0f;
        ListOptions content = MakeUiListBuilderDefaultOptions();
        content.height = LayoutSize(LayoutSizePolicy::Content, 0.0f);
        ASSERT_TRUE(self.m_builder.virtualList("earlier", self.m_source, self.m_state, content).valid);
        ASSERT_TRUE(self.m_builder.endContainer());
        self.m_builder.style().fontSize = 22.0f;
        ASSERT_TRUE(self.m_builder.virtualList("later", self.m_source, self.m_state, MakeUiListBuilderDefaultOptions()).valid);
        ASSERT_TRUE(self.finishPanel());
        ASSERT_TRUE(self.m_context.commitFrame(generation));
        const Optional<HitTarget> hostTargetOpt = FindUiListBuilderTarget(self, earlier);
        const Optional<HitTarget> firstOpt = FindUiListBuilderTarget(self, UiListBuilderRequireWidgetPartId(earlierRows, 11u));
        ASSERT_TRUE(hostTargetOpt.has_value());
        ASSERT_TRUE(firstOpt.has_value());
        const HitTarget hostTarget = hostTargetOpt.value();
        const HitTarget first = firstOpt.value();
        EXPECT_FALSE(FindUiListBuilderTarget(self, UiListBuilderRequireWidgetPartId(earlierRows, 10u)).has_value());
        EXPECT_FALSE(FindUiListBuilderTarget(self, UiListBuilderRequireWidgetPartId(earlierRows, 17u)).has_value());
        EXPECT_FLOAT_EQ(first.rectangle.height, naturalHeight);
        EXPECT_FLOAT_EQ(hostTarget.clip.height, clipped.height.value);
        EXPECT_GT(hostTarget.rectangle.height, hostTarget.clip.height);
        EXPECT_GT(first.clip.height, 0.0f);
        EXPECT_LT(first.clip.height, first.rectangle.height);
        const VectorSingle clipBottom = VectorSingle(first.clip.y, hostTarget.clip.y, 0.0f, 0.0f) + VectorSingle(first.clip.height, hostTarget.clip.height, 0.0f, 0.0f);
        EXPECT_FLOAT_EQ(clipBottom.x, clipBottom.y);
        EXPECT_NEAR((first.clip.y - first.rectangle.y) / first.rectangle.height, 0.25f, 0.00001f);
        if(generation != 2u){
            ExpectUiListBuilderRect(first.rectangle, previousRow);
            ExpectUiListBuilderRect(first.clip, previousClip);
        }
        previousRow = first.rectangle;
        previousClip = first.clip;
    }
}

void VerifyUiListBuilderTests_ContentViewportPreflightsTallSecondRowAtFractionalScrollBeforeParentLayout(mut UiListBuilderTests self){
    self.m_source.count = 8u;
    self.m_source.specialIndex = 1u;
    ListOptions options = MakeUiListBuilderDefaultOptions();
    options.height = LayoutSize(LayoutSizePolicy::Content, 0.0f);
    const Expected<SelectableMetrics> metrics = MeasureSelectable(self.m_skin, self.m_builder.listStyle().row);
    const Expected<TextLayout, TextLayoutStatusEnum> ordinary = self.m_text.layout(MakeUiListShapeRequest(s_UiListCaseFirstRowText, self.m_builder.style().fontSize));
    const Expected<TextLayout, TextLayoutStatusEnum> tall = self.m_text.layout(MakeUiListShapeRequest(self.m_source.specialText, self.m_builder.style().fontSize));
    ASSERT_TRUE(metrics.has_value());
    ASSERT_TRUE(ordinary.has_value());
    ASSERT_TRUE(tall.has_value());
    const DisplayMetrics display = DisplayMetrics(800.0f, 600.0f, 1.0f, 1.0f);
    const Expected<Rect> ordinaryVisual = self.m_text.measure(ordinary.value(), display);
    const Expected<Rect> tallVisual = self.m_text.measure(tall.value(), display);
    ASSERT_TRUE(ordinaryVisual.has_value());
    ASSERT_TRUE(tallVisual.has_value());
    // Lanes are the ordinary row and the tall row.
    const f32 padTop = metrics.value().padding.top;
    const f32 padBottom = metrics.value().padding.bottom;
    const f32 minY = metrics.value().minimum.y;
    const VectorSingle contentHeight = (VectorSingle(ordinaryVisual.value().height, tallVisual.value().height, 0.0f, 0.0f) + VectorSingle(padTop, padTop, padTop, padTop)) + VectorSingle(padBottom, padBottom, padBottom, padBottom);
    const VectorSingle rowHeight = Max(VectorSingle(minY, minY, minY, minY), contentHeight);
    const f32 initialHeight = rowHeight.x;
    const f32 finalHeight = rowHeight.y;
    ASSERT_GT(finalHeight, initialHeight);
    ASSERT_TRUE(self.m_state.scrollTo(cast<f64>(initialHeight) * 0.25));
    ASSERT_TRUE(self.begin(1u, display));
    ASSERT_TRUE(self.m_builder.beginPanel(s_UiListCasePanelKey, Rect(10.0f, 10.0f, 320.0f, 260.0f)));
    ASSERT_TRUE(self.m_builder.virtualList(s_UiListCaseListKey, self.m_source, self.m_state, options).valid);
    EXPECT_FALSE(self.m_builder.button("after", ""));
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const Optional<HitTarget> listHostOpt = FindUiListBuilderTarget(self, self.id(s_UiListCaseListKey, s_UiListCasePanelKey));
    const Optional<HitTarget> row1Opt = FindUiListBuilderTarget(self, self.row(1u));
    const Optional<HitTarget> row2Opt = FindUiListBuilderTarget(self, self.row(2u));
    ASSERT_TRUE(listHostOpt.has_value());
    ASSERT_TRUE(row1Opt.has_value());
    ASSERT_TRUE(row2Opt.has_value());
    EXPECT_FLOAT_EQ(row1Opt.value().rectangle.height, finalHeight);
    EXPECT_FLOAT_EQ(row2Opt.value().rectangle.height, finalHeight);
    EXPECT_GE(self.m_state.placement().viewport.height + 0.0001f, finalHeight);
    const Optional<HitTarget> afterOpt = FindUiListBuilderTarget(self, self.id("after", s_UiListCasePanelKey));
    ASSERT_TRUE(afterOpt.has_value());
    EXPECT_FLOAT_EQ(afterOpt.value().rectangle.y, listHostOpt.value().rectangle.y + listHostOpt.value().rectangle.height + self.m_builder.style().gap);
    EXPECT_EQ(self.m_source.textCalls, 2u);
    EXPECT_EQ(self.m_source.textCallsByIndex[0u], 1u);
    EXPECT_EQ(self.m_source.textCallsByIndex[1u], 1u);
}

void VerifyUiListBuilderTests_ScrollingKeepsDisplayedRowsUntilTheMatchingCandidateIsAccepted(mut UiListBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    const Optional<HitTarget> firstRowOpt = FindUiListBuilderTarget(self, self.row(1u));
    const Optional<HitTarget> hostOpt = FindUiListBuilderTarget(self, self.id(s_UiListCaseListKey, s_UiListCasePanelKey));
    ASSERT_TRUE(firstRowOpt.has_value());
    ASSERT_TRUE(hostOpt.has_value());
    const Rect oldBounds = firstRowOpt.value().rectangle;
    const f64 acceptedStep = hostOpt.value().scrollStep;
    ASSERT_TRUE(self.wheel());
    ASSERT_TRUE(self.prepare(2u));
    EXPECT_DOUBLE_EQ(self.m_state.scrollOffset(), acceptedStep);
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    const Optional<HitTarget> stillDisplayedOpt = FindUiListBuilderTarget(self, self.row(1u));
    ASSERT_TRUE(stillDisplayedOpt.has_value());
    EXPECT_FLOAT_EQ(stillDisplayedOpt.value().rectangle.y, oldBounds.y);
    EXPECT_EQ(self.m_context.states().entries().size(), 2u);
    const Point oldRow = UiListBuilderCenter(oldBounds);
    EXPECT_EQ(self.m_context.input().hitTest(oldRow), self.row(1u));
    EXPECT_FALSE(self.m_context.commitFrame(3u));
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_FALSE(FindUiListBuilderTarget(self, self.row(1u)).has_value());
    ASSERT_TRUE(FindUiListBuilderTarget(self, self.row(4u)).has_value());
    EXPECT_EQ(self.m_context.input().hitTest(oldRow), self.row(4u));
}


