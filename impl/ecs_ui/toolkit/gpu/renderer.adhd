#include <impl/ecs_ui/toolkit/gpu/renderer_internal.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MatchesValidatedGpuRendererExtent(
    in u32 currentWidth,
    in u32 currentHeight,
    in u32 requestedWidth,
    in u32 requestedHeight,
    in b8 hasSharedResources
){
    return currentWidth == requestedWidth && currentHeight == requestedHeight && hasSharedResources;
}

b8 CanAcceptGpuSkinInput(in b8 validIdentity, in u64 skinGeneration, in b8 hasSharedResources){
    return validIdentity && skinGeneration != 0u && hasSharedResources;
}

b8 CanSubmitGpuSnapshotState(
    in b8 hasPending,
    in b8 hasSharedResources,
    in b8 hasSkin,
    in u64 snapshotGeneration
){
    return !hasPending && hasSharedResources && hasSkin && snapshotGeneration != 0u;
}

b8 IsExclusivelyRetainedGpuFrame(in b8 hasFrame, in u32 referenceCount){
    return hasFrame && referenceCount == 1u;
}

b8 ShouldResetStaleRecycledGpuFrame(in b8 alreadyAssignedPending, in u64 frameGeneration){
    return alreadyAssignedPending && frameGeneration != 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The caller joins GPU and graph work before invalidating the renderer.
[cpp_type_alias(ShaderPathResolveCallback, ShaderArchivePathResolver)]
class GpuRenderer : IGpuTaskGraphOutputLayerContributor, NoCopy{
    private ArenaObjectSlot<GpuRendererState> m_state = ArenaObjectSlot<GpuRendererState>();

    [cpp_unwind]
    public GpuRenderer(mut GraphicsRuntime graphics, mut AssetManager assetManager, in ShaderArchivePathResolver shaderPathResolver){
        if(!this.m_state.tryEmplace(graphics, assetManager, shaderPathResolver))
            TerminateInvariant();
    }
    public ~GpuRenderer(){ this.invalidateResources(); }

    public void setActiveSceneSubsystems(in ActiveSceneSubsystemsRef subsystems){ this.m_state.value().m_activeSceneSubsystems = subsystems; }

    [cpp_unwind]
    public b8 validateResources(in u32 width, in u32 height){
        mut GpuRendererState state = this.m_state.value();
        if(!IsValidGpuRendererExtent(width, height))
            return false;
        state.m_frameTimingScopePrepared = state.m_graphics.gpuTiming().prepareScopeQueries(s_UiFrameTimingScope.identity, state.m_graphics.getDevice(), s_GpuFrameTimingQueryCount);
        if(!state.m_frameTimingScopePrepared)
            warning("GpuRenderer: could not prepare standalone frame timing scope");
        if(MatchesValidatedGpuRendererExtent(state.m_width, state.m_height, width, height, state.m_resources.valid()))
            return true;
        if(state.m_pending.valid())
            return false;
        if(!state.createResources())
            return false;
        const FramebufferPtr framebuffer = state.m_graphics.getFramebuffer(0u);
        if(!IsValidFramebufferPtr(framebuffer) || !state.prepareOutputPipeline(DerefFramebufferPtr(framebuffer).getFramebufferInfo()))
            return false;
        Array<GpuFrame, s_GpuFrameCount> frames;
        for(mut auto frame : frames){
            auto created = state.makeFrame();
            if(!created.has_value())
                return false;
            frame = created.value();
        }
        Array<GpuVersion<GpuTargetVersion>, s_GpuTargetSlotCount> targets;
        for(mut auto target : targets){
            auto created = CreateGpuTarget(state.m_versions, state.m_graphics, width, height);
            if(!created.has_value())
                return false;
            target = created.value();
        }
        for(usize i = 0u; i < targets.size(); ++i){
            state.m_slots[i] = GpuFrameSlot();
            state.m_slots[i].target = targets[i];
        }
        state.m_frames = frames;
        state.m_width = width;
        state.m_height = height;
        return true;
    }

    public void invalidateResources(){
        mut GpuRendererState state = this.m_state.value();
        state.m_pending.reset();
        for(mut auto slot : state.m_slots)
            slot = GpuFrameSlot();
        for(mut auto frame : state.m_frames)
            frame.reset();
        state.m_skin.reset();
        state.m_imageCache.clear();
        state.m_resources.reset();
        state.m_width = 0u;
        state.m_height = 0u;
        state.m_frameTimingScopePrepared = false;
        state.m_claimed = false;
        state.m_declaredGraph.reset();
        state.m_graphGeneration = 0u;
        state.m_declaredLayer = GpuTaskGraphOutputLayer();
        state.m_readyToDeclare = false;
        state.m_lastAcceptedAcquired = AcquiredPresentationFrame();
        state.m_lastAcceptedGeneration = 0u;
        state.m_presentationContributor.reset();
    }

    [cpp_unwind]
    public b8 setSkin(in AssetRef<UiSkin> identity, in UiSkin skin, in u64 skinGeneration){
        mut GpuRendererState state = this.m_state.value();
        if(!CanAcceptGpuSkinInput(identity.valid(), skinGeneration, state.m_resources.valid()) || !skin.validatePayload())
            return false;
        const SkinBinding binding = MakePaintSkinBinding<UiSkin, Texture>(identity, skin.texture(), skinGeneration, skin.atlasWidth(), skin.atlasHeight(), skin.referenceDensity());
        if(state.m_skin.valid()){
            in SkinBinding existing = state.m_skin.deref().m_binding;
            if(SameSkinBindingKey(existing, binding))
                return SameSkinBinding(existing, binding);
        }
        auto loadedAsset = LoadTypedAssetSync<Texture>(state.m_assets, binding.texture.name(), s_GpuRendererContext);
        if(!loadedAsset.has_value() || !skin.validateTexture(loadedAsset.value().deref()))
            return false;
        auto versionResult = state.m_versions.make<GpuSkinVersion>(state.m_graphics);
        if(!versionResult.has_value())
            return false;
        GpuVersion<GpuSkinVersion> version = versionResult.value();
        version.deref().m_binding = binding;
        if(!CreateTextureGpuResource(loadedAsset.value().deref(), s_GpuAtlasTextureName, s_GpuRendererContext, state.m_graphics, version.deref().m_texture))
            return false;
        if(!IsValidGpuSubmissionReadinessToken(version.deref().m_texture.readinessToken.valid(), version.deref().m_texture.readinessToken.hasPhysicalQueueIdentity()))
            return false;
        state.m_skin = version;
        return true;
    }

    // Rejection leaves the caller's snapshot intact.
    [cpp_rvalue_overload]
    public b8 submit(mut DrawSnapshot snapshot){
        mut GpuRendererState state = this.m_state.value();
        if(!CanSubmitGpuSnapshotState(state.m_pending.valid(), state.m_resources.valid(), state.m_skin.valid(), snapshot.generation()))
            return false;
        if(!SameSkinBinding(snapshot.skinBinding(), state.m_skin.deref().m_binding))
            return false;
        if(!IsValidDisplayMetricsForGpuSubmit(snapshot.displayMetrics()))
            return false;
        if(!ValidateGpuGlyphPages(snapshot) || !ValidateGpuSdfPages(snapshot) || !ValidateGpuTextureImages(snapshot))
            return false;
        mut Device device = state.m_graphics.getDevice();
        for(mut auto slot : state.m_slots){
            if(slot.inFlight.valid() && slot.inFlight.deref().complete(device))
                slot.inFlight.reset();
        }
        for(mut auto frame : state.m_frames){
            // Completed GPU work can still have graph payload owners; mutate only an exclusively retained frame.
            if(!IsExclusivelyRetainedGpuFrame(frame.valid(), frame.referenceCount()))
                continue;
            AtomicThreadFence(MemoryOrder::acquire);
            if(!frame.deref().recyclable(device))
                continue;
            if(state.m_pending.valid()){
                if(ShouldResetStaleRecycledGpuFrame(true, frame.deref().m_snapshot.generation())){
                    DrawSnapshot empty;
                    frame.deref().reset(empty, GpuVersion<GpuSkinVersion>());
                }
                continue;
            }
            frame.deref().reset(snapshot, state.m_skin);
            state.m_pending = frame;
        }
        if(!state.m_pending.valid()){
            state.m_claimed = false;
            return false;
        }
        state.m_pending.deref().m_recordingMode = state.m_recordingMode;
        state.m_claimed = false;
        return true;
    }

    public void setCommandRecordingMode(in GpuCommandRecordingMode mode){ this.m_state.value().m_recordingMode = mode; }
    public b8 hasPendingFrame()const{ return this.m_state.read().m_pending.valid(); }
    public u64 lastAcceptedGeneration()const{ return this.m_state.read().m_lastAcceptedGeneration; }
    public PresentationReceiptStatus lastAcceptedPresentationStatus()const{
        in GpuRendererState state = this.m_state.read();
        return state.m_graphics.lastPresentationReceipt().status(state.m_lastAcceptedAcquired.backBuffer);
    }

    [cpp_unwind]
    public b8 renderStandalone(in AcquiredPresentationFrame frame){ return this.m_state.value().renderStandalone(frame); }
    [cpp_unwind]
    public b8 prepareTaskGraphOutputLayer(in AcquiredPresentationFrame frame)override{ return this.m_state.value().prepare(frame); }
    [cpp_unwind]
    public Expected<GpuTaskGraphOutputLayer> declareTaskGraphOutputLayer(mut GpuTaskGraph graph)override{ return this.m_state.value().declare(graph, true); }
    public void acceptTaskGraphOutputLayer(in u64 frameGeneration, in QueueSubmissionToken submissionToken)override{
        this.m_state.value().acceptOutputLayer(frameGeneration, submissionToken);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

