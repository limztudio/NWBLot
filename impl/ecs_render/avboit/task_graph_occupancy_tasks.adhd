#include <impl/global.adhd.h>
#include <impl/ecs_render/avboit/compute_effect_record_inputs.adhd.h>
#include <impl/ecs_render/avboit/compute_emulation_record.adhd.h>

#include <core/task/gpu/task_graph.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace RendererTaskGraphDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct AvboitPreGraphTask{
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements = { Core::GpuQueueCapability::Graphics | Core::GpuQueueCapability::Compute };


public:
    // All bindings required: the pre-pass always records against this frame's ticket.
    struct Payload{
        RendererAvboitSystem& avboitSystem;
        DeferredFrameTargets& targets;
        Core::GpuTimingSubmissionTicket& timingTicket;
        Optional<Core::GpuTimingMeasure>& transparentCsgIntervalsTiming;
        ECSRenderDetail::MeshFrameBindingSnapshot frameBindings;
        ECSRenderDetail::CsgGraphResourceSnapshot csgResources;
        ECSRenderDetail::TransparentCsgIntervalGraphSnapshot transparentCsgSnapshot;
        b8 hasTransparentRenderers = false;
        b8 transparentCsgStreamsUploaded = false;
        b8 transparentCsgMaterialGeometryStatesGraphOwned = false;


    public:
        explicit Payload(Core::Alloc::GlobalArena& arena, RendererAvboitSystem& avboitSystemIn, DeferredFrameTargets& targetsIn, Core::GpuTimingSubmissionTicket& timingTicketIn, Optional<Core::GpuTimingMeasure>& transparentCsgIntervalsTimingIn)noexcept
            : avboitSystem(avboitSystemIn)
            , targets(targetsIn)
            , timingTicket(timingTicketIn)
            , transparentCsgIntervalsTiming(transparentCsgIntervalsTimingIn)
            , transparentCsgSnapshot(arena)
        {}
    };


public:
    [[nodiscard]] static b8 Record(const Payload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext& context);

    static void Discarded(Payload& payload)noexcept{
        Core::DiscardGpuTimingMeasure(&payload.transparentCsgIntervalsTiming);
    }
};

// Occupancy emulation streams freeze after target clear; regular and CSG stay exclusive.
struct AvboitOccupancyComputeEmulationGraphTask : public AvboitComputeEmulationGraphTaskBase{
public:
    [[nodiscard]] static b8 Record(const Payload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext& context);
};

// Shared-buffer occupancy draws cannot batch generators; keep D/R streams as explicit callbacks.
struct AvboitOccupancySharedComputeEmulationGraphTask : public AvboitSharedComputeEmulationGraphTaskBase{
public:
    [[nodiscard]] static b8 Record(const Payload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext& context);
};

// Occupancy follows the interval producer with its own immutable stream.
struct AvboitOccupancyGraphTask : public AvboitRasterPassGraphTaskBase{
public:
    [[nodiscard]] static b8 Record(const Payload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext& context);
};

struct AvboitDepthWarpGraphTask : public AvboitComputeEffectGraphTaskBase{
public:
    [[nodiscard]] static b8 Record(const Payload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext& context);
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanRecordAvboitPrePass(in b8 transparentCsgStreamsUploaded, in b8 snapshotCaptured){
    return transparentCsgStreamsUploaded == snapshotCaptured;
}


