// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u32 ComputeDeferredDispatchGroupCount(in u32 extent, in u32 groupSize){
    return DivideUpWrapping(extent, groupSize);
}

u64 ComputeSceneLightBufferByteSize(in usize recordByteSize, in usize maxLights){
    return cast<u64>(recordByteSize * maxLights);
}

b8 CanRenderDeferredLightingWithHistory(in b8 useLaggedLightingHistory, in b8 laggedHistoryValid){
    return !useLaggedLightingHistory || laggedHistoryValid;
}

u32 SelectDeferredPresentOutputLayerSlot(in b8 valid, in u32 slot, in u32 invalidSlot){
    if(valid)
        return slot;
    return invalidSlot;
}


