#include <impl/ecs_render/shadow/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Target creation validates each history selector once; frame recording trusts the owner-created independent allocations.
class SoftShadowCombinedWaveletInputs{
    public TexturePtr opaqueHistory = TexturePtr();
    public TexturePtr opaqueMoments = TexturePtr();
    public TexturePtr transparentHistory = TexturePtr();
    public TexturePtr transparentMoments = TexturePtr();
    public TexturePtr geometry = TexturePtr();
    public TexturePtr opaqueOutput = TexturePtr();
    public TexturePtr transparentOutput = TexturePtr();


    public b8 valid()const{
        const Array<TexturePtr, 7u> textures(this.opaqueHistory, this.opaqueMoments, this.transparentHistory, this.transparentMoments, this.geometry, this.opaqueOutput, this.transparentOutput);
        for(usize i = 0u; i < textures.size(); ++i){
            if(!IsValidTexturePtr(textures[i]))
                return false;
            for(usize j = 0u; j < i; ++j){
                if(textures[i] == textures[j])
                    return false;
            }
        }
        return true;
    }
}

// Resolve resources pair backing targets with their pushed heap slots.
class SoftShadowResolvePassResources{
    public TexturePtr inputColorTexture = TexturePtr();
    public TexturePtr momentsTexture = TexturePtr();
    public TexturePtr outputTexture = TexturePtr();
    public u32 inputColor = 0u;
    public u32 moments = 0u;
    public u32 outputStorage = 0u;
}
// Heap-only soft resolve dispatch description.
class SoftShadowResolveDispatch{
    public ComputePipelineHandle waveletPipeline;
    public ComputePipelineHandle upsamplePipeline;
    public SoftShadowResolvePassResources firstWaveletResources;
    public SoftShadowResolvePassResources outputHalfAResources;
    public SoftShadowResolvePassResources outputHalfBResources;
    public SoftShadowResolvePassResources upsampleResources;
    public TexturePtr visibilityTexture = TexturePtr();
    public u32 visibilityStorage = 0u;
    public u32 sceneShading = 0u;
    // Must be odd so the selected upsample input is the final ping-pong result.
    public u32 waveletPassCount = 1u;
    public b8 temporalMomentsValid = false;
    // The prepared graph may already lower a transparent trace or temporal-merge output before the first wavelet.
    public b8 graphOwnsFirstWaveletInputState = false;
    // A split transparent temporal merge also publishes the selected moments input for the first wavelet.
    public b8 graphOwnsWaveletMomentsEntryState = false;
    // The split opaque first-wavelet callback inherits its output UAV state from the graph.
    public b8 graphOwnsFirstWaveletOutputState = false;
    // The transparent fold can inherit its geometry read from the graph; opaque geometry still transitions locally after its in-callback downsample.
    public b8 graphOwnsWaveletGeometryEntryState = false;
    // Both prepared opaque and transparent resolve callbacks inherit these descriptor-visible upsample reads.
    public b8 graphOwnsUpsampleStaticEntryStates = false;
    // The one-wavelet opaque resolve tail inherits both of these exact states from the preceding callback.
    public b8 graphOwnsUpsampleInputColorEntryState = false;
    public b8 graphOwnsUpsampleVisibilityOutputState = false;
    public b8 firstWaveletWritesHalfA = true;
    public SoftShadowUpsampleFold fold = SoftShadowUpsampleFold::Overwrite;
}


