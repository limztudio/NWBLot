void VerifyAssetsGraphics_MeshFailedReloadPreservesEveryPreviouslyPublishedStream(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    native(mut testArena){
        auto cookCase = PrepareAssetsGraphicsCookCase(testArena, "mesh_failed_reload");
        ASSERT_TRUE(cookCase);
        auto result = CookAndLoadSmokeMesh("uv_seam_quad.nwb", Name(s_AssetCaseProjectMeshesUvSeamQuad), *cookCase, testArena);
        ASSERT_TRUE(result);
        auto& mesh = static_cast<Impl::Mesh&>(**result);
        Impl::MeshAssetCodec codec;
        Core::Assets::AssetBytes original(testArena.arena);
        ASSERT_TRUE(codec.serialize(mesh, original));
        for(u32 invalidCase = 0u; invalidCase < 4u; ++invalidCase){
            Core::Assets::AssetBytes malformed(original);
            if(invalidCase == 0u)
                malformed[0u] ^= 1u;
            else if(invalidCase == 1u)
                malformed.pop_back();
            else if(invalidCase == 2u)
                malformed.push_back(0u);
            else{
                constexpr u32 s_OldMeshMagic = 0x4D534837u;
                ASSERT_TRUE(OverwritePOD(0u, s_OldMeshMagic, malformed));
            }
            EXPECT_FALSE(mesh.loadBinary(malformed)) << invalidCase;
            Core::Assets::AssetBytes retained(testArena.arena);
            ASSERT_TRUE(codec.serialize(mesh, retained));
            EXPECT_EQ(retained, original) << invalidCase;
        }
        EXPECT_TRUE(RemoveAllIfExists(cookCase->root));
    }
}

void VerifyAssetsGraphics_MeshCookerPreservesFlatAndNestedIndexCornerOrder(){
    Vector<StringView> indexLists = Vector<StringView>();
    indexLists.reserve(2u);
    indexLists.push_back("[2, 0, 1]");
    indexLists.push_back("[[], [2, [], [0]], [[], 1], []]");

    Vector<f32x3u> expectedPositions = Vector<f32x3u>();
    expectedPositions.reserve(3u);
    expectedPositions.push_back(f32x3u(0.0f, 0.5f, 0.0f));
    expectedPositions.push_back(f32x3u(-0.5f, -0.5f, 0.0f));
    expectedPositions.push_back(f32x3u(0.5f, -0.5f, 0.0f));

    for(in StringView indexList : indexLists){
        const ScopedTestTrace trace(indexList);
        CapturingLogger logger = CapturingLogger();
        LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
        TestArena testArena = TestArena();
        const Expected<CookCase> cookCase = PrepareAssetsGraphicsCookCase(testArena, "mesh_index_corner_order");
        ASSERT_TRUE(cookCase.has_value());
        const CookCase prepared = cookCase.value();

        const TestAString meta = BuildMeshIndexMeta(indexList);
        b8 cooked = false;
        native(in meta, in prepared, mut testArena, mut cooked){
            cooked = CookSingleMeshMeta(AStringView(meta.data(), meta.size()), prepared, testArena);
        }
        ASSERT_TRUE(cooked);

        ScratchArena scratchArena(s_AssetCaseTestsIntegrationAssetsGraphicsMeshIndexCornerOrder);
        Vector<f32x3u> actualPositions = Vector<f32x3u>();
        actualPositions.reserve(3u);
        native(in prepared, mut testArena, mut scratchArena, mut actualPositions){
            auto loadedAsset = LoadCookedAsset<Impl::MeshAssetCodec>(prepared.outputDirectory, Name(s_AssetCaseProjectMeshesMinimalMesh), 1u, testArena);
            ASSERT_TRUE(loadedAsset);
            const auto& mesh = static_cast<const Impl::Mesh&>(**loadedAsset);
            const auto triangleIndices = Impl::BuildMeshletTriangleIndices(mesh, scratchArena);
            ASSERT_TRUE(triangleIndices);
            ASSERT_EQ(triangleIndices->size(), 3u);
            for(usize corner = 0u; corner < 3u; ++corner){
                ASSERT_LT((*triangleIndices)[corner], mesh.positionStream().size());
                actualPositions.push_back(mesh.positionStream()[(*triangleIndices)[corner]]);
            }
        }
        ASSERT_EQ(actualPositions.size(), 3u);
        for(usize corner = 0u; corner < 3u; ++corner){
            EXPECT_EQ(actualPositions[corner].x, expectedPositions[corner].x);
            EXPECT_EQ(actualPositions[corner].y, expectedPositions[corner].y);
            EXPECT_EQ(actualPositions[corner].z, expectedPositions[corner].z);
        }
        EXPECT_EQ(logger.errorCount(), 0u);
        EXPECT_TRUE(RemoveAllIfExists(prepared.root));
    }
}

void VerifyAssetsGraphics_MeshCookerReportsFirstInvalidNestedIndex(){
    if(AssetsGraphicsTestConfigurationName() != "fin")
        return;

    Vector<MeshIndexDiagnosticCase> cases = Vector<MeshIndexDiagnosticCase>();
    cases.reserve(3u);
    cases.push_back(MeshIndexDiagnosticCase("[[], [2, [\"bad\", -1]], 4294967296]", "'indices[1][1][0]' must contain only integer values"));
    cases.push_back(MeshIndexDiagnosticCase("[[], [2, [-1, \"later\"]], 4294967296]", "'indices[1][1][0]' contains a non-integer or negative value"));
    cases.push_back(MeshIndexDiagnosticCase("[[], [2, [4294967296, \"later\"]], -1]", "'indices[1][1][0]' contains a value that exceeds u32"));

    for(in MeshIndexDiagnosticCase testCase : cases){
        const ScopedTestTrace trace(testCase.m_indices);
        CapturingLogger logger = CapturingLogger();
        LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
        TestArena testArena = TestArena();
        const Expected<CookCase> cookCase = PrepareAssetsGraphicsCookCase(testArena, "invalid_nested_mesh_index");
        ASSERT_TRUE(cookCase.has_value());
        const CookCase prepared = cookCase.value();
        const TestAString meta = BuildMeshIndexMeta(testCase.m_indices);
        b8 cooked = true;
        native(in meta, in prepared, mut testArena, mut cooked){
            cooked = CookSingleMeshMeta(AStringView(meta.data(), meta.size()), prepared, testArena);
        }
        EXPECT_FALSE(cooked);
        EXPECT_TRUE(RemoveAllIfExists(prepared.root));
        EXPECT_TRUE(SawCapturedError(logger, testCase.m_diagnostic));
        EXPECT_FALSE(SawCapturedError(logger, "'indices[1][1][1]'"));
        EXPECT_FALSE(SawCapturedError(logger, "'indices[2]'"));
    }
}

void VerifyAssetsGraphics_MeshCookerValidationFailures(){
    if(AssetsGraphicsTestConfigurationName() != "fin")
        return;

    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_ReportOnly);
    TestArena testArena = TestArena();
    native(mut testArena){
#if defined(NWB_FINAL)
        ExpectCookFailure(MakeNotNull<CookSingleMetaFn>(CookSingleMeshMeta), s_UnsupportedMeshFieldsMeta, "unsupported_mesh_fields", testArena);
        ExpectCookFailure(MakeNotNull<CookSingleMetaFn>(CookSingleMeshMeta), s_MismatchedMeshMeta, "mismatched_mesh_streams", testArena);
        ExpectCookFailure(
            MakeNotNull<CookSingleMetaFn>(CookSingleMeshMeta),
            BuildMeshTriangleMeta("", NWB_ASSETS_GRAPHICS_TEST_TRIANGLE_TANGENTS, NWB_ASSETS_GRAPHICS_TEST_TRIANGLE_VERTEX_REFS),
            "missing_mesh_normal_field",
            testArena
        );
        ExpectCookFailure(
            MakeNotNull<CookSingleMetaFn>(CookSingleMeshMeta),
            BuildMeshTriangleMeta(NWB_ASSETS_GRAPHICS_TEST_TRIANGLE_NORMALS, NWB_ASSETS_GRAPHICS_TEST_TRIANGLE_TANGENTS, NWB_ASSETS_GRAPHICS_TEST_TRIANGLE_MISSING_NORMAL_VERTEX_REFS),
            "missing_mesh_normal_vertex_ref",
            testArena
        );
        ExpectCookFailure(
            MakeNotNull<CookSingleMetaFn>(CookSingleMeshMeta),
            BuildMeshTriangleMeta(s_EmptyNormalListField, NWB_ASSETS_GRAPHICS_TEST_TRIANGLE_TANGENTS, NWB_ASSETS_GRAPHICS_TEST_TRIANGLE_VERTEX_REFS),
            "empty_list_mesh_normal",
            testArena
        );
        ExpectCookFailure(
            MakeNotNull<CookSingleMetaFn>(CookSingleMeshMeta),
            BuildMeshTriangleMeta(s_EmptyNormalMapField, NWB_ASSETS_GRAPHICS_TEST_TRIANGLE_TANGENTS, NWB_ASSETS_GRAPHICS_TEST_TRIANGLE_VERTEX_REFS),
            "empty_map_mesh_normal",
            testArena
        );
        ExpectCookFailure(
            MakeNotNull<CookSingleMetaFn>(CookSingleMeshMeta),
            BuildMeshTriangleMeta(NWB_ASSETS_GRAPHICS_TEST_TRIANGLE_NORMALS, "", NWB_ASSETS_GRAPHICS_TEST_TRIANGLE_VERTEX_REFS),
            "missing_mesh_tangent_field",
            testArena
        );
        ExpectCookFailure(
            MakeNotNull<CookSingleMetaFn>(CookSingleMeshMeta),
            BuildMeshTriangleMeta(NWB_ASSETS_GRAPHICS_TEST_TRIANGLE_NORMALS, NWB_ASSETS_GRAPHICS_TEST_TRIANGLE_TANGENTS, NWB_ASSETS_GRAPHICS_TEST_TRIANGLE_MISSING_TANGENT_VERTEX_REFS),
            "missing_mesh_tangent_vertex_ref",
            testArena
        );
        ExpectCookFailure(
            MakeNotNull<CookSingleMetaFn>(CookSingleMeshMeta),
            BuildMeshTriangleMeta(NWB_ASSETS_GRAPHICS_TEST_TRIANGLE_NORMALS, s_EmptyTangentListField, NWB_ASSETS_GRAPHICS_TEST_TRIANGLE_VERTEX_REFS),
            "empty_list_mesh_tangent",
            testArena
        );
        ExpectCookFailure(
            MakeNotNull<CookSingleMetaFn>(CookSingleMeshMeta),
            BuildMeshTriangleMeta(NWB_ASSETS_GRAPHICS_TEST_TRIANGLE_NORMALS, s_EmptyTangentMapField, NWB_ASSETS_GRAPHICS_TEST_TRIANGLE_VERTEX_REFS),
            "empty_map_mesh_tangent",
            testArena
        );
#endif
    }
    EXPECT_GE(logger.errorCount(), 10u);
    EXPECT_TRUE(SawCapturedError(logger, "unsupported asset field"));
    EXPECT_TRUE(SawCapturedError(logger, "'uv0' must be a list"));
    EXPECT_TRUE(SawCapturedError(logger, "'normals' must be a list"));
    EXPECT_TRUE(SawCapturedError(logger, "vertex_ref normal index is out of range"));
    EXPECT_TRUE(SawCapturedError(logger, "'normals' must not be empty"));
    EXPECT_TRUE(SawCapturedError(logger, "'tangents' must be a list"));
    EXPECT_TRUE(SawCapturedError(logger, "vertex_ref tangent index is out of range"));
    EXPECT_TRUE(SawCapturedError(logger, "'tangents' must not be empty"));
}

void VerifyAssetsGraphics_ObjectGeometryMetadataRejectsRetiredVertexSourceSelectors(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_ShaderScratchArena);
    native(in logger, mut testArena, mut scratchArena){
        auto rootResult = PrepareAssetsGraphicsCaseRoot(testArena, "object_geometry_metadata");
        ASSERT_TRUE(rootResult);
        Path root = Move(*rootResult);

        const Path metadataPath = root / "shader.nwb";
        ASSERT_TRUE(WriteTextFile(root / "shader.slang", "void main(){}\n"));
        constexpr Array<ShaderMetadataCase, 8u> s_Cases = {{
            { .shaderAssetType = "mesh_shader", .fields = "", .accepted = true },
            { .shaderAssetType = "pixel_shader", .fields = "", .accepted = true },
            { .shaderAssetType = "mesh_shader", .fields = "asset.mesh_object_vertex = \"object_vs.slang\";\n", .accepted = false },
            { .shaderAssetType = "mesh_shader", .fields = "asset.mesh_object_vertex = \"\";\n", .accepted = false },
            { .shaderAssetType = "compute_shader", .fields = "asset.mesh_object_vertex = \"object_vs.slang\";\n", .accepted = false },
            { .shaderAssetType = "vertex_shader", .fields = "asset.mesh_object_vertex = \"object_vs.slang\";\n", .accepted = false },
            { .shaderAssetType = "pixel_shader", .fields = "asset.mesh_object_vertex = \"object_vs.slang\";\n", .accepted = false },
            { .shaderAssetType = "mesh_shader", .fields = "asset.mesh_object_cull = \"object_cull_cs.slang\";\n", .accepted = false },
        }};
        Impl::ShaderCook shaderCook(testArena.arena);
        for(const ShaderMetadataCase& testCase : s_Cases){
            SCOPED_TRACE(testCase.shaderAssetType);
            SCOPED_TRACE(testCase.fields);
            Impl::ShaderCook::CookString metadata(testCase.shaderAssetType, testArena.arena);
            metadata.append(" asset;\nasset.entry_point = \"main\";\n");
            metadata.append(testCase.fields.data(), testCase.fields.size());
            ASSERT_TRUE(WriteTextFile(metadataPath, AStringView(metadata.data(), metadata.size())));
            const u32 priorErrors = logger.errorCount();
            EXPECT_EQ(ParseShaderMetadataFile<NWB::Impl::ShaderCook::ShaderEntry>(metadataPath, testArena, scratchArena, shaderCook).has_value(), testCase.accepted);
            if(testCase.accepted)
                EXPECT_EQ(logger.errorCount(), priorErrors);
            else
                EXPECT_GT(logger.errorCount(), priorErrors);
        }
        EXPECT_TRUE(RemoveAllIfExists(root));
    }
}


