void VerifyUiBuilderTests_RowUsesSkinMetricsPaddingAndClipsOverflowingControlHits(mut UiBuilderTests self){
    ContainerOptions row = ContainerOptions();
    row.width.policy = LayoutSizePolicy::Fixed;
    row.width.value = 100.0f;
    row.height.policy = LayoutSizePolicy::Fixed;
    row.height.value = 70.0f;
    row.padding.left = 2.0f;
    row.padding.top = 3.0f;
    row.padding.right = 4.0f;
    row.padding.bottom = 5.0f;
    row.gap = 6.0f;
    ASSERT_TRUE(self.begin(1u, MakeUiBuilderRect(10.0f, 20.0f, 150.0f, 90.0f)));
    ASSERT_TRUE(self.m_builder.beginRow("actions", row));
    EXPECT_FALSE(self.m_builder.button("first", "i"));
    EXPECT_FALSE(self.m_builder.button("second", "ii"));
    ASSERT_TRUE(self.m_builder.endContainer());
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const WidgetId rowId = self.id("actions");
    const WidgetId firstId = RequireUiWidgetId(rowId, "first");
    const WidgetId secondId = RequireUiWidgetId(rowId, "second");
    const Optional<HitTarget> secondTarget = self.findTarget(secondId);
    ASSERT_TRUE(secondTarget.has_value());
    EXPECT_FLOAT_EQ(secondTarget.value().clip.width, 18.0f);
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiBuilderPoint(100.0f, 40.0f)), secondId);
    EXPECT_NE(self.m_context.input().hitTest(MakeUiBuilderPoint(125.0f, 40.0f)), secondId);
    self.click(MakeUiBuilderPoint(125.0f, 40.0f));
    EXPECT_TRUE(self.m_context.input().actions().empty());
    self.click(MakeUiBuilderPoint(100.0f, 40.0f));
    EXPECT_TRUE(self.m_context.input().consumeActivation(secondId));
    EXPECT_FALSE(self.m_context.input().consumeActivation(firstId));
}

