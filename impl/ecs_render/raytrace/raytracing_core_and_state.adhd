// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/raytrace/raytrace_internal.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ShadowTraceGeometryBackendSelection{
    public b8 includeHardware = false;
    public b8 includeSoftware = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanEnableSurfelSceneTrace(in b8 backendReady, in u32 instanceCount, in u32 meshCount){
    return backendReady && instanceCount > 0u && meshCount > 0u;
}

b8 CanCompleteSoftwareMeshBuildsAtRecord(in b8 buildPlanFrozen, in b8 meshSwBvhBuildsGraphOwned, in b8 preparedMeshSwBvhBuildsRecordedByGraph){
    if(!buildPlanFrozen)
        return false;
    if(meshSwBvhBuildsGraphOwned && !preparedMeshSwBvhBuildsRecordedByGraph)
        return false;
    return true;
}

b8 ResolveSoftTransparentTemporalReady(in b8 softTransparentReady, in b8 softShadowTemporalReady){
    return softTransparentReady && softShadowTemporalReady;
}

ShadowTraceGeometryBackendSelection ResolveShadowTraceGeometryBackendSelection(in b8 hardwareSupported, in b8 traceResourcesPreflighted){
    ShadowTraceGeometryBackendSelection selection;
    selection.includeHardware = hardwareSupported && traceResourcesPreflighted;
    selection.includeSoftware = !hardwareSupported && traceResourcesPreflighted;
    return selection;
}

b8 AreSurfelSplitGraphPipelinesReady(
    in b8 ageFreeReady,
    in b8 hashBuildReady,
    in b8 spawnReady,
    in b8 useHwTrace,
    in b8 useCsgTrace,
    in b8 traceCsgHwReady,
    in b8 traceHwReady,
    in b8 traceCsgSwReady,
    in b8 traceSwReady,
    in b8 resolveReady,
    in b8 upsampleReady,
    in b8 traceBuildArgsReady
){
    b8 traceReady = false;
    if(useHwTrace){
        if(useCsgTrace)
            traceReady = traceCsgHwReady;
        else
            traceReady = traceHwReady;
    }
    else{
        if(useCsgTrace)
            traceReady = traceCsgSwReady;
        else
            traceReady = traceSwReady;
    }
    return ageFreeReady && hashBuildReady && spawnReady && traceReady && resolveReady && upsampleReady && traceBuildArgsReady;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/global.adhd.h>
#include <impl/ecs_render/caustic/caustic_activity_resources.adhd.h>
#include <impl/ecs_render/deferred/deferred_frame_targets.adhd.h>
#include <impl/ecs_render/mesh/mesh_system.adhd.h>
#include <impl/ecs_render/optics/optical_scene_resources.adhd.h>
#include <impl/ecs_render/raytrace/graph_snapshots.adhd.h>
#include <impl/ecs_render/raytrace/prepared_scene_bvh_upload.adhd.h>
#include <impl/ecs_render/raytrace/prepared_scene_sw_bvh_traversal.adhd.h>
#include <impl/ecs_render/raytrace/prepared_scene_tlas_build.adhd.h>
#include <impl/ecs_render/raytrace/ray_trace_material_resources.adhd.h>
#include <impl/ecs_render/raytrace/raytrace_internal.adhd.h>
#include <impl/ecs_render/raytrace/raytracing_diagnostics.adhd.h>
#include <impl/ecs_render/raytrace/raytracing_system.adhd.h>
#include <impl/ecs_render/raytrace/renderer_raytracing_state.adhd.h>
#include <impl/ecs_render/raytrace/rt_private.adhd.h>
#include <impl/ecs_render/raytrace/software_scene_refit.adhd.h>
#include <impl/ecs_render/raytrace/types.adhd.h>
#include <impl/ecs_render/refraction/refraction_renderer.adhd.h>
#include <impl/ecs_render/shadow/hardware_transparent_shadow_resources.adhd.h>
#include <impl/ecs_render/shadow/light_space_resource_set.adhd.h>
#include <impl/ecs_render/shadow/shadow_pipeline_set.adhd.h>
#include <impl/ecs_render/shadow/shadow_trace_geometry.adhd.h>
#include <impl/ecs_render/shared/frame_types.adhd.h>

#include <core/alloc/scratch.h>
#include <core/common/log.h>
#include <core/graphics/api.h>
#include <core/graphics/runtime/runtime.h>

#include <global/simdmath.h>
#include <global/span.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RendererRayTracingSystem::preflightShadowVisibilityResources(DeferredFrameTargets& targets, Core::Alloc::ScratchArena& scratchArena){
    m_rayTracingState.m_softwareTransparentSampling.m_history.prepareScene({});
    m_lightSpaceShadow.m_captureHistory.beginFrame();
    m_lightSpaceShadow.m_captureSceneTrusted = false;
    m_lightSpaceShadow.m_sceneBuffers.clear();
    m_lightSpaceShadow.m_sceneTextures.clear();
    m_lightSpaceShadow.m_snapshot.captureTicket = {};
    m_lightSpaceShadow.m_snapshot.ready = false;
    m_lightSpaceShadow.m_resourcesPrepared = false;
    m_lightSpaceShadow.m_sceneEligible = false;
    m_lightSpaceShadow.m_casters.clear();
    // A new frame replaces the previous preflight plan, but does not invalidate retained acceleration data.
    // Full invalidation is reserved for a rejected packet or resource teardown, where recorded work may not submit.
    m_shadowVisibilityPreparedTargets = nullptr;
    m_preparedSceneContentStamp = {};
    m_hardwareOpticalScene.resetPrepared();
    m_softwareOpticalScene.resetPrepared();
    m_shadowVisibilityResourcesPreflighted = false;
    m_shadowVisibilityHardwareSupported = false;
    m_opticalCausticReaderAdmitted = false;
    m_shadowVisibilityTraceResourcesPreflighted = false;
    m_shadowVisibilityBackendPipelinePreflighted = false;
    clearPreparedShadowTraceMaterialSampledTextures();
    clearPreparedShadowMaterialContext();
    clearPreparedSceneBvh();
    m_preparedSceneTlas.clear();
    clearPreparedMeshBlasBuilds();
    clearPreparedMeshSwBvhBuilds();
    // Surfel GI consumes the scene below per frame. Never reuse the prior frame's selection after an empty/rejected preflight.
    m_rayTracingState.m_hardwareTransparentShadow.m_ready = false;
    m_rayTracingState.m_softTransparentReady = false;
    m_rayTracingState.m_softTransparentTemporalReady = false;
    m_rayTracingState.m_surfelEnabled = false;
    m_rayTracingState.m_surfelUseHwTrace = false;
    if(!targets.shadowVisibility)
        return false;
    // The material-context selector is a global heap entry. Set it before gathering; the graph imports the backing handle.
    if(!RayTraceMaterialResources(m_graphics, m_rayTracingState, m_rayTracingState).ensureRayTraceMaterialContextSlotsBuffer())
        return false;

    // Caustic target storage is selected before graph compilation. Uploading the gathered payload remains in the graph-owned preparation packet.
    if(!prepareCausticEmissionTargetResources(scratchArena))
        NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: caustic emission-target gather failed"));

    ShadowPipelineSet shadowPipelines(m_arena, m_graphics, m_shaderSystem, m_rayTracingState, m_rayTracingState);
    m_shadowVisibilityHardwareSupported = m_graphics.queryFeatureSupport(Core::Feature::RayTracingAccelStruct) && m_graphics.queryFeatureSupport(Core::Feature::RayQuery);
    if(m_shadowVisibilityHardwareSupported){
        if(!preparePendingMeshBlasResources(scratchArena)){
            if(!RayTraceMaterialResources(m_graphics, m_rayTracingState, m_rayTracingState).ensureRayTraceMaterialContextSlotsHeapHandle())
                return false;
            m_shadowVisibilityPreparedTargets = &targets;
            m_shadowVisibilityResourcesPreflighted = true;
            return true;
        }

        const b8 sceneReady = prepareSceneTlasResources(scratchArena);
        if(!sceneReady){
            if(!RayTraceMaterialResources(m_graphics, m_rayTracingState, m_rayTracingState).ensureRayTraceMaterialContextSlotsHeapHandle())
                return false;
            m_shadowVisibilityPreparedTargets = &targets;
            m_shadowVisibilityResourcesPreflighted = true;
            return true;
        }
        if(!ensureCsgTraceContextResources())
            return false;

        // Hardware shadows and optical effects share one immutable TLAS/material context.
        if(!capturePreparedMeshBlasBuilds(scratchArena)){
            NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: could not freeze hardware BLAS build plan"));
            m_preparedSceneTlas.clear();
            return false;
        }
        m_shadowVisibilityTraceResourcesPreflighted = true;
        const b8 backendReady = shadowPipelines.ensureShadowPipeline();
        m_shadowVisibilityBackendPipelinePreflighted = backendReady;

        // HW opaque shadow shares the SW half-res denoise chain: jittered trace, temporal merge, a-trous resolve, upsample.
        // The HW trace writes shadowSoftHalfA; the shared block denoises through the same m_softShadow* state as SW.
        // Non-fatal: a failure leaves m_softShadowReady false and the HW render falls back to the full-res 1-spp trace.
        m_rayTracingState.m_softShadowReady = backendReady && shadowPipelines.ensureShadowSoftPipeline() && shadowPipelines.ensureShadowGeometryDownsamplePipeline() && shadowPipelines.ensureSoftShadowResolvePipeline();
        if(backendReady && !m_rayTracingState.m_softShadowReady)
            NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: HW soft opaque shadow resource preparation failed; HW shadows fall back to the full-res trace this frame"));

        // Soft opaque shadow TEMPORAL accumulation (shared reproject-merge): same as the SW branch.
        // Non-fatal: a failure leaves m_softShadowTemporalReady false and the soft path feeds the raw trace straight into the a-trous.
        m_rayTracingState.m_softShadowTemporalReady = m_rayTracingState.m_softShadowReady && shadowPipelines.ensureShadowReprojectMergePipeline();
        if(m_rayTracingState.m_softShadowReady && !m_rayTracingState.m_softShadowTemporalReady)
            NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: HW soft opaque shadow temporal resource preparation failed; no temporal accumulation this frame"));

        // Hardware transparent tracing retains the same half-resolution denoise and multiplicative resolve.
        // Its bounded gather and hardware overflow route never prepare a second software acceleration structure.
        HardwareTransparentShadowResources transparentResources(m_arena, m_graphics, m_shaderSystem, m_rayTracingState.m_hardwareTransparentShadow);
        m_rayTracingState.m_softTransparentReady = m_rayTracingState.m_softShadowReady && m_rayTracingState.m_sceneHasTransparentOccluder && transparentResources.prepareHardwareTransparentShadowResources(targets) && shadowPipelines.ensureSoftTransparentResolvePipeline();
        if(m_rayTracingState.m_softShadowReady && m_rayTracingState.m_sceneHasTransparentOccluder && !m_rayTracingState.m_softTransparentReady)
            NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: hardware transparent shadow resource preparation failed; colored shadows unavailable this frame"));

        m_rayTracingState.m_softTransparentTemporalReady = ResolveSoftTransparentTemporalReady(m_rayTracingState.m_softTransparentReady, m_rayTracingState.m_softShadowTemporalReady);

        shadowPipelines.prepareSoftCombinedResolvePipelines();

        // Build HW caustic resources with the shadow ones. Non-fatal to shadows: failure leaves a black caustic buffer.
        if(!prepareHwCausticResources(targets))
            NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: hardware caustic producer resource preparation failed"));

        // Hardware surfel GI reuses the TLAS, per-mesh geometry, and instance records built for shadows and caustics.
        // Gated on the HW shadow backend being ready + a non-empty TLAS.
        // Non-fatal: a failure leaves GI off this frame (lighting uses hemiAmbient).
        if(CanEnableSurfelSceneTrace(backendReady, m_rayTracingState.m_tlasInstanceCount, m_rayTracingState.m_shadowMeshCount)){
            m_rayTracingState.m_surfelEnabled = true;
            m_rayTracingState.m_surfelUseHwTrace = true;
            if(!prepareSurfelResources(targets))
                NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: HW surfel GI resource preparation failed"));
        }

        if(!RayTraceMaterialResources(m_graphics, m_rayTracingState, m_rayTracingState).ensureRayTraceMaterialContextSlotsHeapHandle())
            return false;
        m_shadowVisibilityPreparedTargets = &targets;
        preflightLightSpaceShadowResources();
        if(m_lightSpaceShadow.m_csgRequired && !m_lightSpaceShadow.m_resourcesPrepared){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: CSG shadow map preparation failed"));
            return false;
        }
        m_shadowVisibilityResourcesPreflighted = true;
        return true;
    }

    // No HW ray tracing: build/refit per-mesh software BVHs from skinned geometry, then the per-frame scene BVH.
    const b8 meshResourcesReady = preparePendingMeshSwBvhResources(scratchArena);
    if(!meshResourcesReady)
        NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: software shadow BVH resource preparation failed"));
    if(!meshResourcesReady || !prepareSceneSwBvhResources(scratchArena)){
        NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: software shadow scene BVH build failed"));
        m_shadowVisibilityPreparedTargets = &targets;
        m_shadowVisibilityResourcesPreflighted = true;
        return true;
    }
    if(!ensureCsgTraceContextResources())
        return false;

    // Enable surfel GI on the SW path once the scene BVH is resident; pool resources live on state so resize never resets them.
    if(CanEnableSurfelSceneTrace(true, m_rayTracingState.m_sceneBvhInstanceCount, m_rayTracingState.m_swShadowMeshCount)){
        m_rayTracingState.m_surfelEnabled = true;
        m_rayTracingState.m_surfelUseHwTrace = false;   // SW branch: the surfel trace walks the SW scene BVH
        if(!prepareSurfelResources(targets))
            NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: surfel GI resource preparation failed"));
    }

    if(m_rayTracingState.m_sceneBvhInstanceCount == 0u){
        if(!RayTraceMaterialResources(m_graphics, m_rayTracingState, m_rayTracingState).ensureRayTraceMaterialContextSlotsHeapHandle())
            return false;
        m_shadowVisibilityPreparedTargets = &targets;
        m_shadowVisibilityResourcesPreflighted = true;
        return true;
    }
    // The software-only route can freeze every selected per-mesh build/refit because it has no later non-fatal hardware fallback.
    if(!capturePreparedMeshSwBvhBuilds(scratchArena)){
        NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: could not freeze software BVH mesh build plan"));
        return false;
    }
    m_shadowVisibilityTraceResourcesPreflighted = true;

    const b8 backendReady = shadowPipelines.ensureSwShadowPipeline();
    m_shadowVisibilityBackendPipelinePreflighted = backendReady;

    // Soft opaque shadow: downsample + a-trous pipelines denoise half-res trace; non-fatal.
    m_rayTracingState.m_softShadowReady = backendReady && shadowPipelines.ensureShadowGeometryDownsamplePipeline() && shadowPipelines.ensureSoftShadowResolvePipeline();
    if(backendReady && !m_rayTracingState.m_softShadowReady)
        NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: soft opaque shadow resource preparation failed; shadows hard this frame"));

    // Temporal accumulation: reproject-merge plus SOFT_HALF variants; falls back to spatial.
    m_rayTracingState.m_softShadowTemporalReady = m_rayTracingState.m_softShadowReady && shadowPipelines.ensureShadowReprojectMergePipeline();
    if(m_rayTracingState.m_softShadowReady && !m_rayTracingState.m_softShadowTemporalReady)
        NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: soft opaque shadow temporal resource preparation failed; no temporal accumulation this frame"));

    // Colored transparent shadow: RGB resolve gated on opaque path; falls back to coarse/adaptive.
    m_rayTracingState.m_softTransparentReady = m_rayTracingState.m_softShadowReady && shadowPipelines.ensureSoftTransparentResolvePipeline();
    if(m_rayTracingState.m_softShadowReady && !m_rayTracingState.m_softTransparentReady)
        NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: soft transparent shadow resource preparation failed; colored shadows fall back to the hard-ish path this frame"));

    m_rayTracingState.m_softTransparentTemporalReady = ResolveSoftTransparentTemporalReady(m_rayTracingState.m_softTransparentReady, m_rayTracingState.m_softShadowTemporalReady);

    shadowPipelines.prepareSoftCombinedResolvePipelines();

    // Build the software caustic producer + resolve resources alongside the SW shadow resources (same SW scene BVH + per-mesh geometry).
    // Non-fatal to shadows: a failure leaves the caustic buffer black (the additive no-op).
    if(!prepareGpuBvhCausticResources(targets))
        NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: software caustic producer resource preparation failed"));

    if(!RayTraceMaterialResources(m_graphics, m_rayTracingState, m_rayTracingState).ensureRayTraceMaterialContextSlotsHeapHandle())
        return false;
    m_shadowVisibilityPreparedTargets = &targets;
    preflightLightSpaceShadowResources();
    if(m_lightSpaceShadow.m_csgRequired && !m_lightSpaceShadow.m_resourcesPrepared){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: CSG shadow map preparation failed"));
        return false;
    }
    m_shadowVisibilityResourcesPreflighted = true;
    return true;
}

Expected<b8> RendererRayTracingSystem::recordPreflightShadowVisibilityResources(
    Core::CommandList& commandList,
    DeferredFrameTargets& targets,
    const b8 sceneTlasBuildGraphOwned,
    const b8 meshBlasBuildsGraphOwned,
    const b8 meshBlasGeometryBuildInputStatesGraphOwned,
    const b8 meshSwBvhBuildsGraphOwned,
    const b8 preparedMeshSwBvhBuildsRecordedByGraph
){
    if(!m_shadowVisibilityResourcesPreflighted || m_shadowVisibilityPreparedTargets != &targets)
        return MakeUnexpected(Failure{});

    // A non-fatal preflight miss disables tracing this frame; no capacity retry, the graph already froze its imports.
    if(!m_shadowVisibilityTraceResourcesPreflighted)
        return false;

    if(m_shadowVisibilityHardwareSupported){
        if(meshBlasBuildsGraphOwned && !recordPreparedMeshBlasBuilds(commandList, meshBlasGeometryBuildInputStatesGraphOwned))
            return MakeUnexpected(Failure{});
        if(sceneTlasBuildGraphOwned && !m_preparedSceneTlas.record(m_rayTracingState, commandList))
            return MakeUnexpected(Failure{});
        return m_shadowVisibilityBackendPipelinePreflighted;
    }

    if(!CanCompleteSoftwareMeshBuildsAtRecord(m_preparedMeshSwBvhBuildPlanFrozen, meshSwBvhBuildsGraphOwned, preparedMeshSwBvhBuildsRecordedByGraph)){
        NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: software shadow mesh builds have no frozen graph completion"));
        return MakeUnexpected(Failure{});
    }
    // Pure software frames have no opaque-HW fallback. Uploads and cache reuse keep their traversal snapshot; recording checks that plan.
    // A missing or stale plan rejects the packet.
    if(!m_preparedSceneSwBvhTraversal.ready()){
        NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: software shadow scene has no frozen preflight traversal"));
        return MakeUnexpected(Failure{});
    }
    if(!m_preparedSceneSwBvhTraversal.record())
        return MakeUnexpected(Failure{});
    if(m_rayTracingState.m_sceneBvhInstanceCount == 0u){
        m_rayTracingState.m_surfelEnabled = false;
        m_rayTracingState.m_surfelUseHwTrace = false;
        return false;
    }

    return m_shadowVisibilityBackendPipelinePreflighted;
}

void RendererRayTracingSystem::discardPreflightShadowVisibilityResources()noexcept{
    invalidateLightSpaceShadowCapture();
    m_rayTracingState.m_softwareTransparentSampling.m_history.discard();
    m_preparedShadowTraceGeometryBuffers.clear();
    clearPreparedShadowTraceMaterialSampledTextures();
    m_preparedCausticEmissionTargetBytes.clear();
    clearPreparedShadowMaterialContext();
    clearPreparedSceneBvh();
    m_preparedSceneTlas.clear();
    clearPreparedMeshBlasBuilds();
    clearPreparedMeshSwBvhBuilds();
    m_shadowVisibilityPreparedTargets = nullptr;
    m_preparedSceneContentStamp = {};
    m_hardwareOpticalScene.resetPrepared();
    m_softwareOpticalScene.resetPrepared();
    m_shadowVisibilityResourcesPreflighted = false;
    m_shadowVisibilityHardwareSupported = false;
    m_opticalCausticReaderAdmitted = false;
    m_shadowVisibilityTraceResourcesPreflighted = false;
    m_shadowVisibilityBackendPipelinePreflighted = false;

    // A rejected prep packet may have grown storage without uploading it; keep allocs, drop semantic caches, rebuild next preflight.
    m_rayTracingState.m_tlasStaticSceneHashValid = false;
    m_rayTracingState.m_sceneSwBvhStaticSceneHashValid = false;
    m_rayTracingState.m_hwShadowMaterialContextHashValid = false;
    m_rayTracingState.m_swShadowMaterialContextHashValid = false;
    m_rayTracingState.m_surfelEnabled = false;
    m_rayTracingState.m_surfelUseHwTrace = false;

    // Flags update optimistically. If the packet never submits, keep retained structures rebuildable for later frames.
    m_meshSystem.discardRayTracingBuildState();
}

b8 RendererRayTracingSystem::freezePreparedShadowTraceGeometryBuffers(Core::Alloc::ScratchArena& scratchArena){
    m_preparedShadowTraceGeometryBuffers.clear();
    if(!m_shadowVisibilityResourcesPreflighted)
        return false;

    ECSRenderDetail::MeshRayTracingResourceSnapshotVector meshes{ scratchArena };
    m_meshSystem.collectRayTracingResourceSnapshots(meshes);

    const ShadowTraceGeometryBackendSelection backendSelection = ResolveShadowTraceGeometryBackendSelection(m_shadowVisibilityHardwareSupported, m_shadowVisibilityTraceResourcesPreflighted);
    // Raw tables are populated by preflight. Only the selected backend contributes trace geometry.
    const ShadowTraceGeometrySelection selection{
        .hardwarePositions = m_rayTracingState.m_shadowMeshPositionBuffers,
        .hardwareIndices = m_rayTracingState.m_shadowMeshIndexBuffers,
        .hardwareAttributes = m_rayTracingState.m_shadowMeshAttributeBuffers,
        .softwareNodes = m_rayTracingState.m_swShadowMeshNodeBuffers,
        .softwarePositions = m_rayTracingState.m_swShadowMeshPositionBuffers,
        .softwareIndices = m_rayTracingState.m_swShadowMeshIndexBuffers,
        .softwareAttributes = m_rayTracingState.m_swShadowMeshAttributeBuffers,
        .includeHardware = backendSelection.includeHardware,
        .includeSoftware = backendSelection.includeSoftware,
    };
    return FreezePreparedShadowTraceGeometryBuffers(meshes, selection, scratchArena, m_acceptedShadowTraceGeometryBuffers, m_preparedShadowTraceGeometryBuffers);
}

void RendererRayTracingSystem::confirmPreparedShadowTraceGeometryNormalization()noexcept{
    for(PreparedShadowTraceGeometryBuffer& resource : m_preparedShadowTraceGeometryBuffers){
        if(resource.buffer && resource.normalizationPending){
            FOUNDATION_ASSERT(m_acceptedShadowTraceGeometryBuffers.size() < m_acceptedShadowTraceGeometryBuffers.capacity());
            m_acceptedShadowTraceGeometryBuffers.push_back(resource.buffer);
            resource.normalizationPending = false;
        }
    }
}

void RendererRayTracingSystem::invalidatePreparedShadowTraceGeometryBuffers()noexcept{
    m_preparedShadowTraceGeometryBuffers.clear();
    m_acceptedShadowTraceGeometryBuffers.clear();
    clearPreparedShadowTraceMaterialSampledTextures();
}

void RendererRayTracingSystem::confirmPreparedSceneBvhUploads()noexcept{
    if(m_preparedSceneBvh.publishAcceptedUpload(m_rayTracingState))
        clearPreparedSceneBvh();
}

Core::ResourceStates::Mask RendererRayTracingSystem::sceneTlasBackingInitialState()const noexcept{
    const auto& state = m_rayTracingState;
    return state.m_tlasBackingFresh ? Core::ResourceStates::Common : Core::ResourceStates::Unknown;
}

b8 RendererRayTracingSystem::capturePreparedSceneBvh(const b8 staticScene, const u64 staticSceneHash, const Span<const NwbBvhNodeGpu> nodes, const Span<const SceneSwBvhInstanceGpu> instances){
    clearPreparedSceneBvh();
    return m_preparedSceneBvh.capture(m_rayTracingState, staticScene, staticSceneHash, nodes, instances);
}

b8 RendererRayTracingSystem::capturePreparedSceneBvhCacheReuse(const u64 staticSceneHash, const u32 instanceCount)noexcept{
    clearPreparedSceneBvh();
    return m_preparedSceneBvh.captureCacheReuse(m_rayTracingState, staticSceneHash, instanceCount);
}

void RendererRayTracingSystem::clearPreparedSceneBvh()noexcept{
    m_preparedSceneSwBvhRefit.reset();
    m_preparedSceneSwBvhTraversal.clear();
    m_preparedSceneBvh.clear();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void RendererRayTracingSystem::invalidateResources(){
    SoftwareBvhBuilder bvh(m_arena, m_graphics, m_shaderSystem, m_rayTracingState);
    discardPreflightShadowVisibilityResources();
    invalidatePreparedShadowTraceGeometryBuffers();
    m_hardwareOpticalScene.invalidate();
    m_softwareOpticalScene.invalidate();
    m_preparedSceneSwBvhRefit.reset();
    m_sceneSwBvhRefit.invalidate();
    releaseSceneTlasHeapHandle();
    releaseCausticEmissionTargetHeapHandle();
    CausticActivityResources activity(m_graphics, m_rayTracingState.m_causticResolve.m_activity);
    activity.releaseCausticResolveActivity();
    RayTraceMaterialResources(m_graphics, m_rayTracingState, m_rayTracingState).releaseRayTraceMaterialContextHeapHandles();
    bvh.releaseSwBvhScratchHeapHandles();
    releaseSurfelGiHeapHandles();
    HardwareTransparentShadowResources transparentResources(m_arena, m_graphics, m_shaderSystem, m_rayTracingState.m_hardwareTransparentShadow);
    transparentResources.releaseHardwareTransparentShadowResources();
    LightSpaceResourceSet resources(m_arena, m_graphics, m_shaderSystem, m_lightSpaceShadow, m_shadowVisibilityHardwareSupported);
    resources.releaseLightSpaceShadowResources();
    m_refraction.invalidateResources();
    m_rayTracingState.invalidateResources();
}

void RendererRayTracingSystem::releaseSceneTlasHeapHandle(){
    Core::GpuDescriptorHeap& heap = m_graphics.getDevice().getDescriptorHeap();
    if(heap.isInitialized()){
        RayTracingDetail::RetireHeapHandle(heap, m_rayTracingState.m_tlasHeapHandle);
        return;
    }
    m_rayTracingState.m_tlasHeapHandle = Core::GpuDescriptorHandle::Invalid();
}

RayTracingLightingClassificationInput RendererRayTracingSystem::snapshotLightingClassificationInput()const noexcept{
    return { .refractiveInstanceCount = m_rayTracingState.m_causticRefractiveInstanceCount, };
}

void RendererRayTracingSystem::publishPreparedLightingClassification(const RayTracingLightingClassification& classification, const Span<const SceneLightGpuData> lights){
    m_rayTracingState.m_causticLightCount = classification.causticLightCount;
    RayTracingDiagnostics().unsupportedCausticVolumes(
        m_shadowVisibilityTraceResourcesPreflighted,
        classification.causticLightCount,
        m_unsupportedCausticVolumeCount,
        m_unsupportedCausticVolumeHash,
        m_firstUnsupportedCausticVolumeEntity,
        m_unsupportedCausticVolumeReported,
        m_reportedUnsupportedCausticVolumeHash
    );
    m_rayTracingState.m_softShadowSlotMask = classification.softShadowSlotMask;
    m_rayTracingState.m_softwareTransparentSampling.m_history.prepareLighting(lights);
    prepareLightSpaceShadows(lights);

    // Emit the selected caustic-light and refractive-target gate once from the domain that owns the gathered bounds and diagnostic latch.
    // A successful prefix publication leaves the latch set across optional graph-build retries; final declaration failure restores the earlier snapshot.
    RayTracingDiagnostics().causticEmissionGate(
        classification.causticLightCount,
        m_rayTracingState.m_causticRefractiveInstanceCount,
        LoadFloat(m_rayTracingState.m_causticTargetBoundsMin),
        LoadFloat(m_rayTracingState.m_causticTargetBoundsMax),
        lights,
        m_rayTracingState.m_causticEmissionGateLogged
    );
}

RayTracingShadowPreparationResourceSnapshot RendererRayTracingSystem::snapshotShadowPreparationResources()const noexcept{
    return RayTracingShadowPreparationResourceSnapshot{
        .sceneTlas = m_rayTracingState.m_tlas,
        .sceneTlasBackingBuffer = m_rayTracingState.m_tlas ? m_rayTracingState.m_tlas->getBackingBufferHandle() : nullptr,
        .bvhSortKeysBuffer = m_shadowVisibilityHardwareSupported ? nullptr : m_rayTracingState.m_bvhSortKeysBuffer,
        .bvhSortPayloadBuffer = m_shadowVisibilityHardwareSupported ? nullptr : m_rayTracingState.m_bvhSortPayloadBuffer,
        .bvhVisitCounterBuffer = m_shadowVisibilityHardwareSupported ? nullptr : m_rayTracingState.m_bvhVisitCounterBuffer,
        .swShadowEdgeCounterBuffer = m_shadowVisibilityHardwareSupported ? nullptr : m_rayTracingState.m_swShadowEdgeCounterBuffer,
        .swShadowEdgeListBuffer = m_shadowVisibilityHardwareSupported ? nullptr : m_rayTracingState.m_swShadowEdgeListBuffer,
        .swShadowIndirectArgsBuffer = m_shadowVisibilityHardwareSupported ? nullptr : m_rayTracingState.m_swShadowIndirectArgsBuffer,
    };
}

RayTracingDeferredGraphResourceSnapshot RendererRayTracingSystem::snapshotDeferredGraphResources()const noexcept{
    const auto& state = m_rayTracingState;
    const b8 hasCsgTrace = m_shadowVisibilityTraceResourcesPreflighted && m_lightSpaceShadow.m_csg.snapshot.hasCsg;
    usize contextReadTokenCount = 0u;
    for(const auto& token : state.m_rayTraceContextReadSubmissionTokens){
        if(token.valid()){
            contextReadTokenCount = state.m_rayTraceContextReadSubmissionTokens.size();
            break;
        }
    }
    return RayTracingDeferredGraphResourceSnapshot{
        .materialContextSlotsBuffer = state.m_rayTraceMaterialContextSlotsBuffer,
        .csgTraceContextBuffer = hasCsgTrace ? state.m_csgTraceContextBuffer : nullptr,
        .rayTraceContextReadSubmissionTokens = contextReadTokenCount != 0u
            ? Span<const Core::QueueSubmissionToken>(state.m_rayTraceContextReadSubmissionTokens.data(), contextReadTokenCount)
            : Span<const Core::QueueSubmissionToken>{},
        .csgTraceBoundsBuffers = hasCsgTrace ? Span<const Core::BufferHandle>(m_lightSpaceShadow.m_csg.dynamicBounds) : Span<const Core::BufferHandle>{},
        .shadowInstanceMaterialBuffer = state.m_shadowInstanceMaterialBuffer,
        .shadowMaterialTypedBuffer = state.m_shadowMaterialTypedBuffer,
        .shadowInstanceBuffer = state.m_shadowInstanceBuffer,
        .causticEmissionTargetBuffer = state.m_causticEmissionTargets.buffer,
        .surfelFrameConstantsBuffer = state.m_surfelConstants,
        .hardwareTransparentCrossingsBuffer = state.m_hardwareTransparentShadow.m_crossingsBuffer,
        .hardwareTransparentOverflowListBuffer = state.m_hardwareTransparentShadow.m_overflowListBuffer,
        .hardwareTransparentOverflowArgsBuffer = state.m_hardwareTransparentShadow.m_overflowArgsBuffer,
        .sceneBvhNodeBuffer = m_shadowVisibilityHardwareSupported ? nullptr : state.m_sceneBvhNodeBuffer,
        .sceneInstanceBuffer = m_shadowVisibilityHardwareSupported ? nullptr : state.m_sceneInstanceBuffer,
        .sceneTlas = state.m_tlas,
        .causticAccumulatorInitialized = state.m_causticAccumulatorInitialized,
        .surfelUsesHardwareTrace = state.m_surfelUseHwTrace,
        .surfelSplitGraphPipelinesReady = AreSurfelSplitGraphPipelinesReady(
            static_cast<b8>(state.m_surfelAgeFreePipeline),
            static_cast<b8>(state.m_surfelHashBuildPipeline),
            static_cast<b8>(state.m_surfelSpawnPipeline),
            state.m_surfelUseHwTrace,
            state.m_surfelUseCsgTrace,
            static_cast<b8>(state.m_surfelTraceCsgHwPipeline),
            static_cast<b8>(state.m_surfelTraceHwPipeline),
            static_cast<b8>(state.m_surfelTraceCsgPipeline),
            static_cast<b8>(state.m_surfelTracePipeline),
            static_cast<b8>(state.m_surfelResolvePipeline),
            static_cast<b8>(state.m_surfelUpsamplePipeline),
            static_cast<b8>(state.m_surfelTraceBuildArgsPipeline)
        ),
    };
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void RendererRayTracingSystem::logCapabilityOnce(){
    RayTracingDiagnostics().rayTracingCapability(
        m_graphics.queryFeatureSupport(Core::Feature::RayTracingAccelStruct),
        m_graphics.queryFeatureSupport(Core::Feature::RayTracingPipeline),
        m_graphics.queryFeatureSupport(Core::Feature::RayQuery),
        m_rayTracingState.m_capabilityLogged
    );
}


