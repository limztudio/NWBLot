#include <impl/assets_graphics/bvh_subsystem.adhd>
#include <impl/ecs_render/kernel/compute_pipeline_utils.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>
#include <impl/ecs_render/raytrace/ray_trace_material_resources.adhd>
#include <impl/ecs_render/raytrace/raytracing_build_policy.adhd>
#include <impl/ecs_render/raytrace/renderer_raytracing_state.adhd>
#include <impl/ecs_render/raytrace/rt_private.adhd>
#include <impl/ecs_render/raytrace/types.adhd>
#include <impl/ecs_render/shader/shader_system.adhd>
#include <impl/ecs_render/raytrace/raytrace_internal.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_MaxBvhBitonicSortSteps = 160u;
const u32 s_BvhBuildGroupSize = 256u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class BvhMeshBuildDispatchPlan{
    public u32 paddedCount = 0u;
    public u32 mortonGroups = 0u;
    public u32 topologyGroups = 0u;
    public u32 fitGroups = 0u;

    public b8 hasTopologyDispatch()const{
        return this.topologyGroups != 0u;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanDispatchPreparedMeshSwBvh(in u32 primitiveCount, in u32 positionHeapSlot, in u32 triangleIndexHeapSlot){
    return primitiveCount != 0u && positionHeapSlot != s_RtInvalidSlot && triangleIndexHeapSlot != s_RtInvalidSlot;
}

BvhMeshBuildDispatchPlan ResolveBvhMeshBuildDispatchPlan(in u32 primitiveCount){
    BvhMeshBuildDispatchPlan plan;
    plan.paddedCount = ResolveBvhPaddedSortCount(primitiveCount);
    plan.mortonGroups = DivideUp(primitiveCount, s_BvhBuildGroupSize);
    if(primitiveCount > 1u)
        plan.topologyGroups = DivideUp(primitiveCount - 1u, s_BvhBuildGroupSize);
    plan.fitGroups = DivideUp(primitiveCount, s_BvhBuildGroupSize);
    return plan;
}

u32 ResolveBvhMeshRefitGroups(in u32 primitiveCount){
    return DivideUp(primitiveCount, s_BvhBuildGroupSize);
}

u32 BuildBvhBitonicSortSteps(in u32 elementCount, in u32 paddedCount, in u32 keysHeapSlot, in u32 payloadHeapSlot, mut FixedVector<BvhSortPushConstants, s_MaxBvhBitonicSortSteps> outSteps){
    outSteps.clear();
    if(paddedCount < s_BvhSortGroupSize)
        return 0u;

    const u32 groupCount = paddedCount / s_BvhSortGroupSize;
    outSteps.push_back(MakeBvhSortPushConstants(elementCount, 0u, 0u, s_BvhSortModeLocalTile, keysHeapSlot, payloadHeapSlot));

    u32 sequenceSize = s_BvhSortGroupSize << 1u;
    while(sequenceSize <= paddedCount){
        u32 compareDistance = sequenceSize >> 1u;
        while(compareDistance >= s_BvhSortGroupSize){
            outSteps.push_back(MakeBvhSortPushConstants(elementCount, compareDistance, sequenceSize, s_BvhSortModeGlobal, keysHeapSlot, payloadHeapSlot));
            compareDistance >>= 1u;
        }
        outSteps.push_back(MakeBvhSortPushConstants(elementCount, 0u, sequenceSize, s_BvhSortModeGlobalTail, keysHeapSlot, payloadHeapSlot));
        if(sequenceSize == paddedCount)
            break;
        sequenceSize <<= 1u;
    }
    return groupCount;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets/graphics/bvh/binding_slots.h>"), cpp_name("NWB_BVH_BUILD_GROUP_SIZE")]
extern const u32 s_ShaderBvhBuildGroupSize;
static_assert(s_BvhBuildGroupSize == cast<u32>(s_ShaderBvhBuildGroupSize));


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 EnsureBvhStorageDescriptors(mut GpuDescriptorHeap heap, in BufferHandle first, in BufferHandle second, mut GpuDescriptorHandle firstHandle, mut GpuDescriptorHandle secondHandle){
    GpuDescriptorHandle acquiredFirst = GpuDescriptorHandleInvalid();
    if(!firstHandle.valid()){
        const auto registered = RegisterHeapBuffer(heap, first.deref(), GpuDescriptorClass::StorageBuffer, true);
        if(!registered.has_value())
            return false;
        acquiredFirst = registered.value();
    }
    if(!secondHandle.valid()){
        const auto registered = RegisterHeapBuffer(heap, second.deref(), GpuDescriptorClass::StorageBuffer, true);
        if(!registered.has_value()){
            RetireDescriptor(heap, acquiredFirst);
            return false;
        }
        secondHandle = registered.value();
    }
    if(acquiredFirst.valid())
        firstHandle = acquiredFirst;
    return IsDescriptorClass(firstHandle, GpuDescriptorClass::StorageBuffer) && IsDescriptorClass(secondHandle, GpuDescriptorClass::StorageBuffer);
}

void CommitBvhBuildBarrier(mut CommandList commandList, mut Buffer keys, mut Buffer payload, mut Buffer nodes, mut Buffer parents, mut Buffer visits){
    commandList.setBufferState(keys, ResourceStates::UnorderedAccess);
    commandList.setBufferState(payload, ResourceStates::UnorderedAccess);
    commandList.setBufferState(nodes, ResourceStates::UnorderedAccess);
    commandList.setBufferState(parents, ResourceStates::UnorderedAccess);
    commandList.setBufferState(visits, ResourceStates::UnorderedAccess);
    commandList.commitBarriers();
}

void DispatchBvhBuildKernel(mut CommandList commandList, mut GpuDescriptorHeap heap, in BvhBuildPushConstants constants, mut ComputePipeline pipeline, in u32 groupCount){
    ComputeState state;
    state.setPipeline(pipeline);
    commandList.setComputeState(state);
    heap.bindCompute(commandList, pipeline);
    commandList.setPushConstants(constants);
    commandList.dispatch(groupCount, 1u, 1u);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
void SoftwareBvhBuilder::releaseSwBvhScratchHeapHandles(){
    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(heap.isInitialized()){
        RetireDescriptor(heap, this.m_state.m_bvhSortKeysHeapHandle);
        RetireDescriptor(heap, this.m_state.m_bvhSortPayloadHeapHandle);
        RetireDescriptor(heap, this.m_state.m_bvhVisitCounterHeapHandle);
        return;
    }
    this.m_state.m_bvhSortKeysHeapHandle = GpuDescriptorHandleInvalid();
    this.m_state.m_bvhSortPayloadHeapHandle = GpuDescriptorHandleInvalid();
    this.m_state.m_bvhVisitCounterHeapHandle = GpuDescriptorHandleInvalid();
}

[cpp_unwind]
b8 SoftwareBvhBuilder::ensureBvhSortPipeline(){
    if(this.m_state.m_bvhSortPipeline.valid())
        return true;
    if(this.m_state.m_bvhSortPipelineFailed)
        return false;

    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        error("RendererSystem: software BVH sort requires the initialized global descriptor heap");
        this.m_state.m_bvhSortPipelineFailed = true;
        return false;
    }

    // Push-only layout; sort resources use the global heap.
    if(!EnsurePushConstantBindingLayout(device, size_of<BvhSortPushConstants>(), ShaderTypeMask::Compute, this.m_state.m_bvhSortBindingLayout)){
        error("RendererSystem: failed to create BVH sort binding layout");
        this.m_state.m_bvhSortPipelineFailed = true;
        return false;
    }

    if(!this.m_shaderSystem.loadShader<ComputeShader, BvhSubsystem>(lambda[](in BvhSubsystem subsystem) -> AssetRef<ComputeShader>{ return subsystem.bitonicSortCs; }, s_ShaderArchiveDefaultVariant,
        Name("ECSRender_BvhBitonicSort"), this.m_state.m_bvhSortShader)){
        this.m_state.m_bvhSortPipelineFailed = true;
        return false;
    }

    if(!CreateHeapComputePipeline(device, this.m_state.m_bvhSortShader, this.m_state.m_bvhSortBindingLayout, false, this.m_state.m_bvhSortPipeline)){
        error("RendererSystem: failed to create BVH sort compute pipeline");
        this.m_state.m_bvhSortPipelineFailed = true;
        return false;
    }
    return true;
}

[cpp_unwind]
b8 SoftwareBvhBuilder::ensureBvhSortBuffers(in usize paddedCount){
    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized())
        return false;

    if(this.m_state.m_bvhSortKeysBuffer.valid() && this.m_state.m_bvhSortPayloadBuffer.valid() && this.m_state.m_bvhSortCapacity >= paddedCount){
        if(!EnsureBvhStorageDescriptors(heap, this.m_state.m_bvhSortKeysBuffer, this.m_state.m_bvhSortPayloadBuffer, this.m_state.m_bvhSortKeysHeapHandle, this.m_state.m_bvhSortPayloadHeapHandle)){
            error("RendererSystem: failed to register existing BVH sort scratch in the descriptor heap");
            return false;
        }
        return true;
    }

    const usize capacity = NextGrowingCapacity(this.m_state.m_bvhSortCapacity, paddedCount, s_BvhSortInitialCapacity);

    BufferDesc keysBufferDesc;
    keysBufferDesc.setByteSize(cast<u64>(size_of<u32>() * capacity)).setStructStride(size_of<u32>()).setCanHaveUAVs(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setDebugName(Name(s_RenderNameBvhSortKeys)).enableAutomaticStateTracking(ResourceStates::Common);
    auto keysBufferResult = this.m_graphics.createBuffer(keysBufferDesc);
    if(!keysBufferResult.has_value()){
        error("RendererSystem: failed to create BVH sort keys buffer");
        return false;
    }
    BufferHandle keysBuffer = keysBufferResult.value();

    BufferDesc payloadBufferDesc;
    payloadBufferDesc.setByteSize(cast<u64>(size_of<u32>() * capacity)).setStructStride(size_of<u32>()).setCanHaveUAVs(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setDebugName(Name(s_RenderNameBvhSortPayload)).enableAutomaticStateTracking(ResourceStates::Common);
    auto payloadBufferResult = this.m_graphics.createBuffer(payloadBufferDesc);
    if(!payloadBufferResult.has_value()){
        error("RendererSystem: failed to create BVH sort payload buffer");
        return false;
    }
    BufferHandle payloadBuffer = payloadBufferResult.value();

    GpuDescriptorHandle keysHeapHandle;
    GpuDescriptorHandle payloadHeapHandle;
    if(!EnsureBvhStorageDescriptors(heap, keysBuffer, payloadBuffer, keysHeapHandle, payloadHeapHandle)){
        error("RendererSystem: failed to register BVH sort scratch in the descriptor heap");
        return false;
    }

    RetireDescriptor(heap, this.m_state.m_bvhSortKeysHeapHandle);
    RetireDescriptor(heap, this.m_state.m_bvhSortPayloadHeapHandle);
    this.m_state.m_bvhSortKeysBuffer = keysBuffer;
    this.m_state.m_bvhSortPayloadBuffer = payloadBuffer;
    this.m_state.m_bvhSortKeysHeapHandle = keysHeapHandle;
    this.m_state.m_bvhSortPayloadHeapHandle = payloadHeapHandle;
    this.m_state.m_bvhSortCapacity = capacity;
    return true;
}

[cpp_unwind]
b8 SoftwareBvhBuilder::bvhBitonicSort(mut CommandList commandList, in u32 elementCount, in u32 paddedCount){
    assert(this.m_state.m_bvhSortPipeline.valid());
    assert(this.m_state.m_bvhSortKeysBuffer.valid());
    assert(this.m_state.m_bvhSortPayloadBuffer.valid());
    assert(IsDescriptorClass(this.m_state.m_bvhSortKeysHeapHandle, GpuDescriptorClass::StorageBuffer));
    assert(IsDescriptorClass(this.m_state.m_bvhSortPayloadHeapHandle, GpuDescriptorClass::StorageBuffer));

    FixedVector<BvhSortPushConstants, s_MaxBvhBitonicSortSteps> sortSteps;
    const u32 groupCount = BuildBvhBitonicSortSteps(elementCount, paddedCount, this.m_state.m_bvhSortKeysHeapHandle.slot(), this.m_state.m_bvhSortPayloadHeapHandle.slot(), sortSteps);
    if(groupCount == 0u)
        return false;

    mut Buffer keysBuffer = this.m_state.m_bvhSortKeysBuffer.deref();
    mut Buffer payloadBuffer = this.m_state.m_bvhSortPayloadBuffer.deref();

    // Sort scratch fits the max mesh. Fence only this dispatch's padded lanes, sentinels included.
    const BufferRange sortRange(0u, cast<u64>(paddedCount) * size_of<u32>());
    commandList.setEnableUavBarriersForBuffer(keysBuffer, true);
    commandList.setEnableUavBarriersForBuffer(payloadBuffer, true);
    commandList.setBufferState(keysBuffer, ResourceStates::UnorderedAccess, false, sortRange);
    commandList.setBufferState(payloadBuffer, ResourceStates::UnorderedAccess, false, sortRange);
    commandList.commitBarriers();

    for(in BvhSortPushConstants pushConstants : sortSteps){
        ComputeState computeState;
        computeState.setPipeline(this.m_state.m_bvhSortPipeline.deref());
        commandList.setComputeState(computeState);
        this.m_graphics.getDevice().getDescriptorHeap().bindCompute(commandList, this.m_state.m_bvhSortPipeline.deref());
        commandList.setPushConstants(pushConstants);
        commandList.dispatch(groupCount, 1u, 1u);
        commandList.setBufferState(keysBuffer, ResourceStates::UnorderedAccess, false, sortRange);
        commandList.setBufferState(payloadBuffer, ResourceStates::UnorderedAccess, false, sortRange);
        commandList.commitBarriers();
    }
    return true;
}

[cpp_unwind]
b8 SoftwareBvhBuilder::ensureBvhBuildPipeline(){
    if(this.m_state.m_bvhMortonPipeline.valid() && this.m_state.m_bvhTopologyPipeline.valid() && this.m_state.m_bvhFitPipeline.valid())
        return true;
    if(this.m_state.m_bvhBuildPipelineFailed)
        return false;

    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        error("RendererSystem: software BVH build requires the initialized global descriptor heap");
        this.m_state.m_bvhBuildPipelineFailed = true;
        return false;
    }

    // Push-only layout; build resources use the global heap.
    if(!EnsurePushConstantBindingLayout(device, size_of<BvhBuildPushConstants>(), ShaderTypeMask::Compute, this.m_state.m_bvhBuildBindingLayout)){
        error("RendererSystem: failed to create BVH build binding layout");
        this.m_state.m_bvhBuildPipelineFailed = true;
        return false;
    }

    if(
        !EnsurePushConstantComputePipeline<BvhSubsystem>(device, this.m_shaderSystem, lambda[](in BvhSubsystem subsystem) -> AssetRef<ComputeShader>{ return subsystem.mortonCs; }, s_ShaderArchiveDefaultVariant,
            Name("ECSRender_BvhMorton"), size_of<BvhBuildPushConstants>(), false, this.m_state.m_bvhBuildBindingLayout, this.m_state.m_bvhMortonShader, this.m_state.m_bvhMortonPipeline)
        || !EnsurePushConstantComputePipeline<BvhSubsystem>(device, this.m_shaderSystem, lambda[](in BvhSubsystem subsystem) -> AssetRef<ComputeShader>{ return subsystem.topologyCs; }, s_ShaderArchiveDefaultVariant,
            Name("ECSRender_BvhTopology"), size_of<BvhBuildPushConstants>(), false, this.m_state.m_bvhBuildBindingLayout, this.m_state.m_bvhTopologyShader, this.m_state.m_bvhTopologyPipeline)
        || !EnsurePushConstantComputePipeline<BvhSubsystem>(device, this.m_shaderSystem, lambda[](in BvhSubsystem subsystem) -> AssetRef<ComputeShader>{ return subsystem.fitCs; }, s_ShaderArchiveDefaultVariant,
            Name("ECSRender_BvhFit"), size_of<BvhBuildPushConstants>(), false, this.m_state.m_bvhBuildBindingLayout, this.m_state.m_bvhFitShader, this.m_state.m_bvhFitPipeline)
    ){
        error("RendererSystem: failed to create BVH build compute pipeline");
        this.m_state.m_bvhBuildPipelineFailed = true;
        return false;
    }
    return true;
}

[cpp_unwind]
b8 SoftwareBvhBuilder::ensureBvhVisitCounterBuffer(in usize primitiveCount){
    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized())
        return false;

    if(this.m_state.m_bvhVisitCounterBuffer.valid() && this.m_state.m_bvhBuildCapacity >= primitiveCount){
        if(IsDescriptorClass(this.m_state.m_bvhVisitCounterHeapHandle, GpuDescriptorClass::StorageBuffer))
            return true;

        if(!this.m_state.m_bvhVisitCounterHeapHandle.valid()){
            const auto acquired = RegisterHeapBuffer(heap, this.m_state.m_bvhVisitCounterBuffer.deref(), GpuDescriptorClass::StorageBuffer, true);
            if(acquired.has_value()){
                this.m_state.m_bvhVisitCounterHeapHandle = acquired.value();
                return true;
            }
        }
        error("RendererSystem: failed to register existing BVH visit counter in the descriptor heap");
        return false;
    }

    const usize capacity = NextGrowingCapacity(this.m_state.m_bvhBuildCapacity, primitiveCount, s_BvhBuildInitialCapacity);

    // Shared visit-counter scratch is safe because mesh builds are serialized.
    BufferDesc counterBufferDesc;
    counterBufferDesc.setByteSize(cast<u64>(size_of<u32>() * capacity)).setStructStride(size_of<u32>()).setCanHaveUAVs(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setDebugName(Name(s_RenderNameBvhVisitCounter)).enableAutomaticStateTracking(ResourceStates::Common);
    auto counterBufferResult = this.m_graphics.createBuffer(counterBufferDesc);
    if(!counterBufferResult.has_value()){
        error("RendererSystem: failed to create BVH visit counter buffer");
        return false;
    }
    BufferHandle counterBuffer = counterBufferResult.value();

    const auto counterHeapHandle = RegisterHeapBuffer(heap, counterBuffer.deref(), GpuDescriptorClass::StorageBuffer, true);
    if(!counterHeapHandle.has_value()){
        error("RendererSystem: failed to register BVH visit counter in the descriptor heap");
        return false;
    }

    RetireDescriptor(heap, this.m_state.m_bvhVisitCounterHeapHandle);
    this.m_state.m_bvhVisitCounterBuffer = counterBuffer;
    this.m_state.m_bvhVisitCounterHeapHandle = counterHeapHandle.value();
    this.m_state.m_bvhBuildCapacity = capacity;
    return true;
}

[cpp_unwind]
b8 SoftwareBvhBuilder::ensureSceneBvhBuffers(in u32 instanceCount, mut RayTraceMaterialResources materials){
    // Binary scene BVH keeps CPU topology; runtime scenes refit its bounds from live mesh roots.
    const usize requiredNodes = ComputeBinaryBvhNodeCount(cast<usize>(instanceCount));
    if(!this.m_state.m_sceneBvhNodeBuffer.valid() || this.m_state.m_sceneBvhNodeCapacity < requiredNodes){
        const usize capacity = NextGrowingCapacity(this.m_state.m_sceneBvhNodeCapacity, requiredNodes, ComputeBinaryBvhNodeCount(s_SceneBvhInitialInstanceCapacity));

        BufferDesc nodeBufferDesc;
        nodeBufferDesc.setByteSize(cast<u64>(size_of<NwbBvhNodeGpu>() * capacity)).setStructStride(size_of<NwbBvhNodeGpu>()).setCanHaveUAVs(true)
            .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setDebugName(Name(s_RenderNameSceneBvhNodes)).enableAutomaticStateTracking(ResourceStates::Common);
        auto nodeBufferResult = this.m_graphics.createBuffer(nodeBufferDesc);
        if(!nodeBufferResult.has_value()){
            error("RendererSystem: failed to create scene BVH node buffer");
            return false;
        }
        BufferHandle nodeBuffer = nodeBufferResult.value();
        // Register the new view before replacing ownership to keep the old pair retryable.
        if(!materials.replaceRayTraceMaterialContextHeapHandle(nodeBuffer.deref(), this.m_state.m_sceneBvhNodeHeapHandle))
            return false;
        this.m_state.m_sceneBvhNodeBuffer = nodeBuffer;
        this.m_state.m_sceneBvhNodeCapacity = capacity;
    }

    if(!this.m_state.m_sceneInstanceBuffer.valid() || this.m_state.m_sceneInstanceCapacity < instanceCount){
        const usize capacity = NextGrowingCapacity(this.m_state.m_sceneInstanceCapacity, instanceCount, s_SceneBvhInitialInstanceCapacity);

        BufferDesc instanceBufferDesc;
        instanceBufferDesc.setByteSize(cast<u64>(size_of<SceneSwBvhInstanceGpu>() * capacity)).setStructStride(size_of<SceneSwBvhInstanceGpu>())
            .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setDebugName(Name(s_RenderNameSceneBvhInstances)).enableAutomaticStateTracking(ResourceStates::Common);
        auto instanceBufferResult = this.m_graphics.createBuffer(instanceBufferDesc);
        if(!instanceBufferResult.has_value()){
            error("RendererSystem: failed to create scene BVH instance buffer");
            return false;
        }
        BufferHandle instanceBuffer = instanceBufferResult.value();
        if(!materials.replaceRayTraceMaterialContextHeapHandle(instanceBuffer.deref(), this.m_state.m_sceneInstanceHeapHandle))
            return false;
        this.m_state.m_sceneInstanceBuffer = instanceBuffer;
        this.m_state.m_sceneInstanceCapacity = capacity;
        info("RendererSystem: created software scene BVH buffers (capacity {} instances)", cast<u64>(capacity));
    }
    return materials.ensureRayTraceMaterialContextHeapHandle(this.m_state.m_sceneBvhNodeBuffer.deref(), this.m_state.m_sceneBvhNodeHeapHandle)
        && materials.ensureRayTraceMaterialContextHeapHandle(this.m_state.m_sceneInstanceBuffer.deref(), this.m_state.m_sceneInstanceHeapHandle);
}

[cpp_unwind]
b8 SoftwareBvhBuilder::createMeshBvhStorage(in usize primitiveCount, mut BufferHandle nodeBuffer, mut BufferHandle parentBuffer, mut GpuDescriptorHandle nodeHeapHandle, mut GpuDescriptorHandle parentHeapHandle){
    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized())
        return false;

    if(nodeBuffer.valid() && parentBuffer.valid()){
        if(!EnsureBvhStorageDescriptors(heap, nodeBuffer, parentBuffer, nodeHeapHandle, parentHeapHandle)){
            error("RendererSystem: failed to register existing per-mesh BVH storage in the descriptor heap");
            return false;
        }
        return true;
    }
    if(nodeBuffer.valid() || parentBuffer.valid()){
        error("RendererSystem: per-mesh BVH storage is partially allocated");
        return false;
    }

    // Per-mesh binary LBVH needs 2N-1 persistent nodes.
    const usize nodeCount = ComputeBinaryBvhNodeCount(primitiveCount);

    BufferDesc nodeBufferDesc;
    nodeBufferDesc.setByteSize(cast<u64>(size_of<NwbBvhNodeGpu>() * nodeCount)).setStructStride(size_of<NwbBvhNodeGpu>()).setCanHaveUAVs(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setDebugName(Name(s_RenderNameBvhMeshNodes)).enableAutomaticStateTracking(ResourceStates::Common);
    auto newNodeBufferResult = this.m_graphics.createBuffer(nodeBufferDesc);
    if(!newNodeBufferResult.has_value()){
        error("RendererSystem: failed to create per-mesh BVH node buffer");
        return false;
    }
    BufferHandle newNodeBuffer = newNodeBufferResult.value();

    BufferDesc parentBufferDesc;
    parentBufferDesc.setByteSize(cast<u64>(size_of<u32>() * nodeCount)).setStructStride(size_of<u32>()).setCanHaveUAVs(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setDebugName(Name(s_RenderNameBvhMeshParent)).enableAutomaticStateTracking(ResourceStates::Common);
    auto newParentBufferResult = this.m_graphics.createBuffer(parentBufferDesc);
    if(!newParentBufferResult.has_value()){
        error("RendererSystem: failed to create per-mesh BVH parent buffer");
        return false;
    }
    BufferHandle newParentBuffer = newParentBufferResult.value();

    GpuDescriptorHandle newNodeHeapHandle = GpuDescriptorHandleInvalid();
    GpuDescriptorHandle newParentHeapHandle = GpuDescriptorHandleInvalid();
    if(!EnsureBvhStorageDescriptors(heap, newNodeBuffer, newParentBuffer, newNodeHeapHandle, newParentHeapHandle)){
        error("RendererSystem: failed to register per-mesh BVH storage in the descriptor heap");
        return false;
    }

    nodeBuffer = newNodeBuffer;
    parentBuffer = newParentBuffer;
    nodeHeapHandle = newNodeHeapHandle;
    parentHeapHandle = newParentHeapHandle;
    return true;
}

[cpp_unwind]
b8 SoftwareBvhBuilder::ensureMeshSwBvhResources(in u32 primitiveCount, mut BufferHandle nodeBuffer, mut BufferHandle parentBuffer, mut GpuDescriptorHandle nodeHeapHandle, mut GpuDescriptorHandle parentHeapHandle){
    if(!RayTracingBuildPolicy().validateMeshSwBvhPrimitiveCount(primitiveCount))
        return false;

    if(!this.ensureBvhSortPipeline())
        return false;
    if(!this.ensureBvhBuildPipeline())
        return false;
    // Allocate shared sort/counter scratch at the maximum supported mesh size.
    if(!this.ensureBvhSortBuffers(s_BvhMaxPrimitivesPerMesh))
        return false;
    if(!this.ensureBvhVisitCounterBuffer(s_BvhMaxPrimitivesPerMesh))
        return false;
    if(!this.createMeshBvhStorage(primitiveCount, nodeBuffer, parentBuffer, nodeHeapHandle, parentHeapHandle))
        return false;
    return true;
}

b8 SoftwareBvhBuilder::meshSwBvhResourcesReady(in BufferHandle nodeBuffer, in BufferHandle parentBuffer, in GpuDescriptorHandle nodeHeapHandle, in GpuDescriptorHandle parentHeapHandle){
    return MeshSwBvhResourcesReady(this.m_state, nodeBuffer, parentBuffer, nodeHeapHandle, parentHeapHandle);
}

[cpp_unwind]
b8 SoftwareBvhBuilder::buildMeshSwBvhPrepared(in u32 positionHeapSlot, in u32 triangleIndexHeapSlot, in u32 primitiveCount, in VectorSingle aabbMin, in VectorSingle aabbMax, in GpuDescriptorHandle nodeHeapHandle,
    in GpuDescriptorHandle parentHeapHandle, mut CommandList commandList, mut BufferHandle nodeBuffer, mut BufferHandle parentBuffer){
    if(!CanDispatchPreparedMeshSwBvh(primitiveCount, positionHeapSlot, triangleIndexHeapSlot) || !this.meshSwBvhResourcesReady(nodeBuffer, parentBuffer, nodeHeapHandle, parentHeapHandle))
        return false;

    const BvhMeshBuildDispatchPlan dispatchPlan = ResolveBvhMeshBuildDispatchPlan(primitiveCount);

    mut Buffer keysBuffer = this.m_state.m_bvhSortKeysBuffer.deref();
    mut Buffer payloadBuffer = this.m_state.m_bvhSortPayloadBuffer.deref();
    mut Buffer visitCounterBuffer = this.m_state.m_bvhVisitCounterBuffer.deref();
    mut Buffer meshNodeBuffer = nodeBuffer.deref();
    mut Buffer meshParentBuffer = parentBuffer.deref();

    const BvhBuildPushConstants pushConstants = MakeBvhBuildPushConstants(
        primitiveCount, positionHeapSlot, triangleIndexHeapSlot, this.m_state.m_bvhSortKeysHeapHandle.slot(), this.m_state.m_bvhSortPayloadHeapHandle.slot(),
        nodeHeapHandle.slot(), parentHeapHandle.slot(), this.m_state.m_bvhVisitCounterHeapHandle.slot(), aabbMin, aabbMax
    );

    commandList.setEnableUavBarriersForBuffer(keysBuffer, true);
    commandList.setEnableUavBarriersForBuffer(payloadBuffer, true);
    commandList.setEnableUavBarriersForBuffer(meshNodeBuffer, true);
    commandList.setEnableUavBarriersForBuffer(meshParentBuffer, true);
    commandList.setEnableUavBarriersForBuffer(visitCounterBuffer, true);

    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    DispatchBvhBuildKernel(commandList, heap, pushConstants, this.m_state.m_bvhMortonPipeline.deref(), dispatchPlan.mortonGroups);
    CommitBvhBuildBarrier(commandList, keysBuffer, payloadBuffer, meshNodeBuffer, meshParentBuffer, visitCounterBuffer);

    // Attribute sorting to the mesh rebuild at its call site.
    {
        GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeSwBvhSort, this.m_graphics.getDevice(), commandList);

        if(!this.bvhBitonicSort(commandList, primitiveCount, dispatchPlan.paddedCount))
            return false;
    }
    CommitBvhBuildBarrier(commandList, keysBuffer, payloadBuffer, meshNodeBuffer, meshParentBuffer, visitCounterBuffer);

    if(dispatchPlan.hasTopologyDispatch()){
        DispatchBvhBuildKernel(commandList, heap, pushConstants, this.m_state.m_bvhTopologyPipeline.deref(), dispatchPlan.topologyGroups);
        CommitBvhBuildBarrier(commandList, keysBuffer, payloadBuffer, meshNodeBuffer, meshParentBuffer, visitCounterBuffer);
    }

    DispatchBvhBuildKernel(commandList, heap, pushConstants, this.m_state.m_bvhFitPipeline.deref(), dispatchPlan.fitGroups);
    return true;
}

[cpp_unwind]
b8 SoftwareBvhBuilder::refitMeshSwBvhPrepared(in u32 positionHeapSlot, in u32 triangleIndexHeapSlot, in u32 primitiveCount, in GpuDescriptorHandle nodeHeapHandle, in GpuDescriptorHandle parentHeapHandle,
    mut CommandList commandList, mut BufferHandle nodeBuffer, mut BufferHandle parentBuffer){
    if(!CanDispatchPreparedMeshSwBvh(primitiveCount, positionHeapSlot, triangleIndexHeapSlot) || !this.meshSwBvhResourcesReady(nodeBuffer, parentBuffer, nodeHeapHandle, parentHeapHandle))
        return false;

    mut Buffer keysBuffer = this.m_state.m_bvhSortKeysBuffer.deref();
    mut Buffer payloadBuffer = this.m_state.m_bvhSortPayloadBuffer.deref();
    mut Buffer meshNodeBuffer = nodeBuffer.deref();
    mut Buffer meshParentBuffer = parentBuffer.deref();
    mut Buffer visitCounterBuffer = this.m_state.m_bvhVisitCounterBuffer.deref();

    const BvhBuildPushConstants pushConstants = MakeBvhRefitPushConstants(
        primitiveCount, positionHeapSlot, triangleIndexHeapSlot, this.m_state.m_bvhSortKeysHeapHandle.slot(), this.m_state.m_bvhSortPayloadHeapHandle.slot(),
        nodeHeapHandle.slot(), parentHeapHandle.slot(), this.m_state.m_bvhVisitCounterHeapHandle.slot()
    );

    commandList.setEnableUavBarriersForBuffer(keysBuffer, true);
    commandList.setEnableUavBarriersForBuffer(payloadBuffer, true);
    commandList.setEnableUavBarriersForBuffer(meshNodeBuffer, true);
    commandList.setEnableUavBarriersForBuffer(meshParentBuffer, true);
    commandList.setEnableUavBarriersForBuffer(visitCounterBuffer, true);
    ComputeState computeState;
    computeState.setPipeline(this.m_state.m_bvhFitPipeline.deref());
    commandList.setComputeState(computeState);
    this.m_graphics.getDevice().getDescriptorHeap().bindCompute(commandList, this.m_state.m_bvhFitPipeline.deref());
    commandList.setPushConstants(pushConstants);
    commandList.dispatch(ResolveBvhMeshRefitGroups(primitiveCount), 1u, 1u);

    return true;
}


