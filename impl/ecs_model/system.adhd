namespace __hidden_model_system{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static constexpr TStringView s_AssetLoadContext = NWB_TEXT("ModelSystem");

static void ResolveAttachmentJointQueries(const Span<const usize> parentOrder, Core::ECS::World& world, Vector<SkeletonJointMatrix, Core::Alloc::GlobalArena>& jointPalette, Vector<ModelAttachmentJointQuery, Core::Alloc::GlobalArena>& queries){
    const usize queryCount = queries.size();
    const Span<const ModelAttachmentJointQuery> constQueries(queries.data(), queryCount);
    usize groupBegin = 0u;
    while(groupBegin < queryCount){
        const Core::ECS::EntityID parentEntity = queries[ResolveModelAttachmentQueryIndex(parentOrder, groupBegin)].parentEntity;
        const usize groupEnd = FindModelAttachmentJointQueryGroupEnd(parentOrder, constQueries, groupBegin);

        const SkeletonPoseComponent* const pose = world.tryGetComponent<SkeletonPoseComponent>(parentEntity);
        if(pose && TryBuildStoredJointPaletteVectorFromSkeletonPose(*pose, jointPalette))
            ResolveModelAttachmentJointQueryGroup(parentOrder, Span<const SkeletonJointMatrix>(jointPalette.data(), jointPalette.size()), groupBegin, groupEnd, queries);
        groupBegin = groupEnd;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


ModelSystem::ModelSystem(Core::Alloc::GlobalArena& arena, Core::ECS::World& world, Core::Assets::AssetManager& assetManager, ModelObjectRendererHooks rendererHooks)
    : Core::ECS::ISystem(arena)
    , m_world(world)
    , m_assetManager(assetManager)
    , m_applyRenderer(Move(rendererHooks.apply))
    , m_scratchJoints(arena)
    , m_attachmentJointQueries(arena)
    , m_attachmentParentOrder(arena)
{
    readAccess<ModelComponent>();
    writeAccess<ModelRuntimeComponent>();
    writeAccess<ModelObjectComponent>();
    writeAccess<ModelSkeletonComponent>();
    writeAccess<ModelStaticMeshAttachmentComponent>();
    writeAccess<MeshComponent>();
    writeAccess<SkinnedMeshBindingComponent>();
    writeAccess<Scene::TransformComponent>();
    writeAccess<SkeletonPoseComponent>();

    for(const Core::ECS::ComponentAccess& access : rendererHooks.accesses)
        registerAccess(access.typeId, access.mode);
}

Expected<void, Core::CpuTaskAdmissionError::Enum> ModelSystem::update([[maybe_unused]] Core::ECS::World& world, [[maybe_unused]] const f32 delta){
    const auto transformed = updateModelObjectTransforms();
    if(!transformed)
        return MakeUnexpected(transformed.error());
    updateStaticMeshAttachments();
    return {};
}

void ModelSystem::syncModelRuntimes(){
    Core::Alloc::ScratchArena scratchArena(s_ModelSyncRuntimeArena);
    clearInactiveModelRuntimes(scratchArena);

    m_world.view<ModelComponent>().each([&](const Core::ECS::EntityID entity, ModelComponent& component){
        ensureModelRuntime(entity, component, scratchArena);
    });
}

void ModelSystem::clearInactiveModelRuntimes(Core::Alloc::ScratchArena& scratchArena){
    const auto objects = m_world.view<ModelObjectComponent>();
    const auto runtimes = m_world.view<ModelRuntimeComponent>();
    const auto objectIsInactive = [&](const ModelObjectComponent& object)noexcept{
        return !m_world.tryGetComponent<ModelRuntimeComponent>(object.owner) || !m_world.tryGetComponent<ModelComponent>(object.owner);
    };
    usize inactiveObjectCount = 0u;
    objects.each([&]([[maybe_unused]] const Core::ECS::EntityID entity, const ModelObjectComponent& object)noexcept{
        if(objectIsInactive(object))
            ++inactiveObjectCount;
    });
    usize inactiveRuntimeCount = 0u;
    runtimes.each([&](const Core::ECS::EntityID entity, [[maybe_unused]] const ModelRuntimeComponent& runtime)noexcept{
        if(!m_world.tryGetComponent<ModelComponent>(entity))
            ++inactiveRuntimeCount;
    });
    if(inactiveObjectCount == 0u && inactiveRuntimeCount == 0u)
        return;

    Vector<Core::ECS::EntityID, Core::Alloc::ScratchArena> inactiveEntities(scratchArena);
    inactiveEntities.reserve(Max(inactiveObjectCount, inactiveRuntimeCount));
    if(inactiveObjectCount != 0u){
        objects.each([&](const Core::ECS::EntityID entity, const ModelObjectComponent& object)noexcept{
            if(objectIsInactive(object))
                inactiveEntities.push_back(entity);
        });
        for(const Core::ECS::EntityID entity : inactiveEntities)
            m_world.destroyEntity(entity);
    }

    if(inactiveRuntimeCount != 0u){
        // Destroying objects can also remove runtime components, so take a fresh view after that batch completes.
        inactiveEntities.clear();
        m_world.view<ModelRuntimeComponent>().each([&](const Core::ECS::EntityID entity, [[maybe_unused]] const ModelRuntimeComponent& runtime)noexcept{
            if(!m_world.tryGetComponent<ModelComponent>(entity))
                inactiveEntities.push_back(entity);
        });
        for(const Core::ECS::EntityID entity : inactiveEntities)
            m_world.entity(entity).removeComponent<ModelRuntimeComponent>();
    }
}

void ModelSystem::ensureModelRuntime(const Core::ECS::EntityID entity, const ModelComponent& component, Core::Alloc::ScratchArena& scratchArena){
    if(!component.model.valid()){
        clearModelRuntime(entity, scratchArena);
        m_world.entity(entity).removeComponent<ModelRuntimeComponent>();
        return;
    }

    ModelRuntimeComponent* const existing = m_world.tryGetComponent<ModelRuntimeComponent>(entity);
    if(existing && existing->model == component.model.name())
        return;
    auto& runtime = existing ? *existing : m_world.entity(entity).addComponent<ModelRuntimeComponent>();

    clearModelRuntime(entity, scratchArena);

    const Name modelName = component.model.name();
    auto loadedModel = m_assetManager.loadTypedSync<Model>(modelName, __hidden_model_system::s_AssetLoadContext);
    if(!loadedModel){
        ResetModelRuntimeState(runtime);
        return;
    }

    const Model& model = **loadedModel;
    if(!expandModel(entity, model, runtime))
        clearModelRuntime(entity, scratchArena);
}

void ModelSystem::clearModelRuntime(const Core::ECS::EntityID entity, Core::Alloc::ScratchArena& scratchArena){
    const auto objects = m_world.view<ModelObjectComponent>();
    usize ownedCount = 0u;
    objects.each([&]([[maybe_unused]] const Core::ECS::EntityID objectEntity, const ModelObjectComponent& object)noexcept{
        if(object.owner == entity)
            ++ownedCount;
    });
    if(ownedCount != 0u){
        Vector<Core::ECS::EntityID, Core::Alloc::ScratchArena> ownedEntities(scratchArena);
        ownedEntities.reserve(ownedCount);
        objects.each([&](const Core::ECS::EntityID objectEntity, const ModelObjectComponent& object)noexcept{
            if(object.owner == entity)
                ownedEntities.push_back(objectEntity);
        });
        for(const Core::ECS::EntityID objectEntity : ownedEntities)
            m_world.destroyEntity(objectEntity);
    }

    if(auto* runtime = m_world.tryGetComponent<ModelRuntimeComponent>(entity))
        ResetModelRuntimeState(*runtime);
}

b8 ModelSystem::expandModel(const Core::ECS::EntityID owner, const Model& model, ModelRuntimeComponent& runtime){
    runtime.model = model.virtualPath();
    runtime.objectCount = 0u;

    b8 complete = true;
    for(const ModelSkeletonObject& object : model.skeletonObjects()){
        if(spawnSkeletonObject(owner, object))
            ++runtime.objectCount;
        else
            complete = false;
    }
    for(const ModelStaticMeshObject& object : model.staticMeshObjects()){
        if(spawnStaticMeshObject(owner, object))
            ++runtime.objectCount;
        else
            complete = false;
    }
    for(const ModelSkinnedMeshObject& object : model.skinnedMeshObjects()){
        if(spawnSkinnedMeshObject(owner, object))
            ++runtime.objectCount;
        else
            complete = false;
    }

    return complete;
}

b8 ModelSystem::spawnSkeletonObject(const Core::ECS::EntityID owner, const ModelSkeletonObject& object){
    const Name skeletonName = object.skeleton.name();
    NWB_ASSERT(skeletonName);
    auto skeletonAsset = m_assetManager.loadTypedSync<Skeleton>(skeletonName, __hidden_model_system::s_AssetLoadContext);
    if(!skeletonAsset)
        return false;
    const Skeleton& skeleton = **skeletonAsset;

    Core::ECS::Entity entity = createSpawnedObjectEntity(owner, object.name, object.transform, ModelObjectKind::Skeleton);

    auto& pose = entity.addComponent<SkeletonPoseComponent>();
    InitializeSkeletonPoseFromJoints(skeleton.joints(), pose);

    auto& skeletonComponent = entity.addComponent<ModelSkeletonComponent>();
    skeletonComponent.skeleton = object.skeleton;

    return true;
}

b8 ModelSystem::spawnStaticMeshObject(const Core::ECS::EntityID owner, const ModelStaticMeshObject& object){
    Core::ECS::Entity entity = createSpawnedObjectEntity(owner, object.name, object.transform, ModelObjectKind::StaticMesh);
    if(m_applyRenderer)
        m_applyRenderer(owner, object.material, m_world, entity);

    auto& mesh = entity.addComponent<MeshComponent>();
    mesh.mesh = object.mesh;

    auto& attachment = entity.addComponent<ModelStaticMeshAttachmentComponent>();
    attachment.localTransform = object.transform;

    NWB_ASSERT(object.parentObject || !object.parentJoint);
    if(object.parentObject){
        attachment.parentEntity = findSpawnedObject(owner, object.parentObject);
        const ModelSkeletonComponent* skeletonComponent = attachment.parentEntity.valid()
            ? m_world.tryGetComponent<ModelSkeletonComponent>(attachment.parentEntity)
            : nullptr;
        if(!ValidateModelStaticMeshParentEntity(object.name, object.parentObject, attachment.parentEntity.valid(), skeletonComponent != nullptr))
            return false;

        if(object.parentJoint){
            const Name skeletonName = skeletonComponent->skeleton.name();
            if(!skeletonName)
                return false;
            auto skeletonAsset = m_assetManager.loadTypedSync<Skeleton>(skeletonName, __hidden_model_system::s_AssetLoadContext);
            if(!skeletonAsset)
                return false;
            const Skeleton& skeleton = **skeletonAsset;

            attachment.parentJointIndex = skeleton.findJointIndex(object.parentJoint);
            if(!ValidateModelStaticMeshParentJoint(object.name, object.parentObject, object.parentJoint, attachment.parentJointIndex))
                return false;
        }
    }

    return true;
}

b8 ModelSystem::spawnSkinnedMeshObject(const Core::ECS::EntityID owner, const ModelSkinnedMeshObject& object){
    const Core::ECS::EntityID skeletonEntity = findSpawnedObject(owner, object.skeletonObject);
    if(!ValidateModelSkinnedMeshSkeletonEntity(object.name, skeletonEntity.valid()))
        return false;

    Core::ECS::Entity entity = createSpawnedObjectEntity(owner, object.name, object.transform, ModelObjectKind::SkinnedMesh);
    if(m_applyRenderer)
        m_applyRenderer(owner, object.material, m_world, entity);

    auto& binding = entity.addComponent<SkinnedMeshBindingComponent>();
    binding.skin = object.skin;
    binding.skeletonEntity = skeletonEntity;
    return true;
}

Core::ECS::Entity ModelSystem::createSpawnedObjectEntity(const Core::ECS::EntityID owner, const Name objectName, const SkeletonJointMatrix& localTransform, const ModelObjectKind::Enum kind){
    Core::ECS::Entity entity = m_world.createEntity();
    const SIMDMatrix localMatrix = LoadFloat(localTransform);
    entity.addComponent<ModelObjectComponent>() = MakeModelObjectComponent(owner, m_world.entity(owner).getComponent<ModelRuntimeComponent>().model, objectName, localMatrix, kind);
    auto& transform = entity.addComponent<Scene::TransformComponent>();
    (void)Scene::TryDecomposeAndAssignTransformComponent(ComputeModelObjectWorldMatrix(Scene::LoadEntityTransformMatrix(m_world, owner), localMatrix), transform);
    return entity;
}

Core::ECS::EntityID ModelSystem::findSpawnedObject(const Core::ECS::EntityID owner, const Name objectName)const noexcept{
    const auto objects = m_world.view<ModelObjectComponent>();
    for(auto it = objects.begin(); it != objects.end(); ++it){
        auto&& [entity, object] = *it;
        if(MatchesModelObjectIdentity(object, owner, objectName))
            return entity;
    }
    return Core::ECS::s_InvalidEntityId;
}

Expected<void, Core::CpuTaskAdmissionError::Enum> ModelSystem::updateModelObjectTransforms(){
    return m_world.view<ModelObjectComponent, Scene::TransformComponent>().parallelEach(
        m_world.taskScope(),
        s_ParallelModelObjectTransformGrainSize,
        [&]([[maybe_unused]] const Core::ECS::EntityID entity, ModelObjectComponent& object, Scene::TransformComponent& transform)noexcept{
            if(object.kind == ModelObjectKind::StaticMesh)
                return;

            (void)Scene::TryDecomposeAndAssignTransformComponent(ComputeModelObjectWorldMatrix(Scene::LoadEntityTransformMatrix(m_world, object.owner), LoadFloat(object.localTransform)), transform);
        });
}

void ModelSystem::updateStaticMeshAttachments(){
    const auto attachments = m_world.view<ModelObjectComponent, ModelStaticMeshAttachmentComponent, Scene::TransformComponent>();
    usize queryCount = 0u;
    if(attachments.candidateCount() > 1u){
        attachments.each([&]([[maybe_unused]] const Core::ECS::EntityID entity, [[maybe_unused]] const ModelObjectComponent& object, const ModelStaticMeshAttachmentComponent& attachment, [[maybe_unused]] const Scene::TransformComponent& transform)noexcept{
            if(attachment.hasJointAttachment())
                ++queryCount;
        });
    }

    // Attachment grouping storage is reused member state; zero or one joint query needs neither an index nor scratch.
    // Only capacity growth may allocate, never per-frame creation.
    Vector<ModelAttachmentJointQuery, Core::Alloc::GlobalArena>& jointQueries = m_attachmentJointQueries;
    jointQueries.clear();
    if(queryCount > 1u){
        jointQueries.reserve(queryCount);
        b8 sharedParent = true;
        attachments.each([&]([[maybe_unused]] const Core::ECS::EntityID entity, [[maybe_unused]] const ModelObjectComponent& object, const ModelStaticMeshAttachmentComponent& attachment, [[maybe_unused]] const Scene::TransformComponent& transform)noexcept{
            if(!attachment.hasJointAttachment())
                return;
            if(!jointQueries.empty() && jointQueries.front().parentEntity != attachment.parentEntity)
                sharedParent = false;
            jointQueries.push_back(MakeModelAttachmentJointQuery(attachment.parentEntity, attachment.parentJointIndex));
        });
        const Span<const ModelAttachmentJointQuery> queries(jointQueries.data(), jointQueries.size());
        if(sharedParent)
            __hidden_model_system::ResolveAttachmentJointQueries({}, m_world, m_scratchJoints, jointQueries);
        else{
            Vector<usize, Core::Alloc::GlobalArena>& parentOrder = m_attachmentParentOrder;
            BuildSortedModelAttachmentParentOrder(queries, parentOrder);
            __hidden_model_system::ResolveAttachmentJointQueries(Span<const usize>(parentOrder.data(), parentOrder.size()), m_world, m_scratchJoints, jointQueries);
        }
    }

    usize nextQuery = 0u;
    attachments.each([&]([[maybe_unused]] const Core::ECS::EntityID entity, ModelObjectComponent& object, ModelStaticMeshAttachmentComponent& attachment, Scene::TransformComponent& transform){
        const Scene::TransformComponent* ownerTransform = m_world.tryGetComponent<Scene::TransformComponent>(object.owner);
        const Scene::TransformComponent* parentTransform = attachment.parentEntity.valid() ? m_world.tryGetComponent<Scene::TransformComponent>(attachment.parentEntity) : ownerTransform;
        const Scene::TransformComponent* basisTransform = parentTransform ? parentTransform : ownerTransform;
        const SIMDMatrix parentMatrix = basisTransform ? Scene::LoadTransformMatrix(*basisTransform) : MatrixIdentity();
        const SIMDMatrix localMatrix = LoadFloat(attachment.localTransform);

        SIMDMatrix worldTransform{};
        if(!attachment.hasJointAttachment())
            worldTransform = ComputeModelObjectWorldMatrix(parentMatrix, localMatrix);
        else{
            SIMDMatrix jointMatrix{};
            if(queryCount > 1u){
                const ModelAttachmentJointQuery& query = jointQueries[nextQuery++];
                if(!query.resolved)
                    return;
                jointMatrix = LoadFloat(query.jointMatrix);
            }
            else{
                const SkeletonPoseComponent* const pose = m_world.tryGetComponent<SkeletonPoseComponent>(attachment.parentEntity);
                if(!pose)
                    return;
                const auto resolvedJointMatrix = TryEvaluateSkeletonPoseJointMatrix(*pose, attachment.parentJointIndex);
                if(!resolvedJointMatrix)
                    return;
                jointMatrix = *resolvedJointMatrix;
            }
            worldTransform = ComputeModelJointAttachmentWorldMatrix(parentMatrix, jointMatrix, localMatrix);
        }

        (void)Scene::TryDecomposeAndAssignTransformComponent(worldTransform, transform);
    });
}


