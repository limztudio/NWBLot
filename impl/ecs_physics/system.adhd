    public b8 setBodyTransform(in EntityID entity, in VectorSingle position, in VectorSingle rotation){
        const auto found = this.m_entityRecords.find(entity);
        if(found == this.m_entityRecords.end() || found.value().attachedToParentBody || !found.value().bodyId.valid())
            return false;
        const BodyId bodyId = found.value().bodyId;
        if(!this.m_physicsWorld.setBodyTransform(bodyId, position, rotation))
            return false;
        const Transform3D normXf(position, SafeNormalizeQuat(rotation));
        SetBodySyncedPose(bodyId, normXf, this.m_syncScratch.bodySyncedPoses);
        SetBodyTransformSnapshotBoth(bodyId, normXf, this.m_bodyTransformSnapshots, this.m_bodyTransformSnapshotMeta);
        ClearStaticBodyPoseCacheIfMatches(bodyId, this.m_syncScratch.staticBodyPoseCache);
        return true;
    }

