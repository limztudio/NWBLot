#include <impl/ecs_ui/toolkit/edit/vertical_navigation.adhd>
#include <impl/ecs_ui/toolkit/widgets/edit_box_state.adhd>
#include <impl/ecs_ui/toolkit/widgets/edit_box_style.adhd>
#include <impl/ecs_ui/toolkit/widgets/text_area_scroll.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TextAreaState : NoCopy{
    public EditBoxState m_visual;
    public EditNavigationState m_navigation;
    public TextAreaScrollState m_scrollInput;
    public u64 m_revision = 1u;
    public u64 m_compositionGeneration = 0u;
    public f32 m_scrollY = 0.0f;
    public b8 m_revealCaret = true;

    public u64 instanceGeneration()const{
        return this.m_navigation.instanceGeneration();
    }

    public u64 revision()const{
        return this.m_revision;
    }

    public in EditBoxPlacement placement()const{
        return this.m_visual.placement;
    }

    public in ScrollViewportPlacement scrollbars()const{
        return this.m_scrollInput.placement;
    }

    public Point scroll()const{
        return Point(this.m_visual.scroll, this.m_scrollY);
    }

    public in EditNavigationState navigation()const{
        return this.m_navigation;
    }

    public b8 focused()const{
        return this.m_visual.focused;
    }

    public b8 scrollTo(in Point scroll){
        if(!IsValidUiExtent(scroll))
            return false;
        AdvanceNonWrappingRevision(this.m_revision);
        this.m_scrollInput.retire();
        this.m_visual.scroll = scroll.x;
        this.m_scrollY = scroll.y;
        this.m_revealCaret = false;
        return true;
    }

    public void reset(){
        AdvanceNonWrappingRevision(this.m_revision);
        this.m_scrollInput.retire();
        this.m_visual = EditBoxState();
        this.m_navigation.reset();
        this.m_compositionGeneration = 0u;
        this.m_scrollY = 0.0f;
        this.m_revealCaret = true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

