#include <impl/ecs_render/kernel/descriptor_register_utils.adhd>
#include <impl/ecs_render/raytrace/graph_snapshots.adhd>
#include <impl/ecs_render/raytrace/push_constants.adhd>
#include <impl/ecs_render/raytrace/renderer_raytracing_state.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsPreparedSceneBvhStorageReady(in RendererRayTracingState state, in usize nodeCount, in usize instanceCount){
    return state.sceneBvh.m_sceneBvhNodeBuffer.valid()
        && state.sceneBvh.m_sceneInstanceBuffer.valid()
        && state.sceneBvh.m_sceneBvhNodeCapacity >= nodeCount
        && state.sceneBvh.m_sceneInstanceCapacity >= instanceCount
        && IsDescriptorClass(state.sceneBvh.m_sceneBvhNodeHeapHandle, GpuDescriptorClass::StorageBuffer)
        && IsDescriptorClass(state.sceneBvh.m_sceneInstanceHeapHandle, GpuDescriptorClass::StorageBuffer);
}

b8 HasPreparedSceneBvhBuffers(in RendererRayTracingState state, in u32 instanceCount){
    assert(instanceCount > 0u);
    const usize requiredNodeCount = cast<usize>(instanceCount) * 2u - 1u;
    return IsPreparedSceneBvhStorageReady(state, requiredNodeCount, instanceCount);
}

[modular]
class PreparedSceneBvhUpload : NoCopy{
    private Vector<u8> m_nodeBytes;
    private Vector<u8> m_instanceBytes;
    private BufferHandle m_nodeBuffer;
    private BufferHandle m_instanceBuffer;
    private usize m_nodeCount = 0u;
    private usize m_instanceCount = 0u;
    private usize m_nodeCapacity = 0u;
    private usize m_instanceCapacity = 0u;
    private u64 m_staticSceneHash = 0u;
    private GpuDescriptorHandle m_nodeHeapHandle;
    private GpuDescriptorHandle m_instanceHeapHandle;
    private b8 m_static = false;
    private b8 m_ready = false;
    private b8 m_uploadRequired = false;

    public b8 capture(in RendererRayTracingState state, in b8 staticScene, in u64 staticSceneHash, in Span<NwbBvhNodeGpu> nodes, in Span<SceneSwBvhInstanceGpu> instances);
    public b8 captureCacheReuse(in RendererRayTracingState state, in u64 staticSceneHash, in u32 instanceCount);
    public void clear(){
        this.m_nodeBytes.clear();
        this.m_instanceBytes.clear();
        this.m_nodeBuffer.reset();
        this.m_instanceBuffer.reset();
        this.m_nodeHeapHandle = GpuDescriptorHandleInvalid();
        this.m_instanceHeapHandle = GpuDescriptorHandleInvalid();
        this.m_nodeCount = 0u;
        this.m_instanceCount = 0u;
        this.m_nodeCapacity = 0u;
        this.m_instanceCapacity = 0u;
        this.m_staticSceneHash = 0u;
        this.m_static = false;
        this.m_ready = false;
        this.m_uploadRequired = false;
    }

    public Expected<PreparedSceneBvhUploads> retainUploads(in RendererRayTracingState state, mut GpuTaskGraph graph)const;
    public b8 publishAcceptedUpload(mut RendererRayTracingState state)const;

    public b8 storageMatches(in RendererRayTracingState state)const;
    public b8 covers(in usize sceneInstanceCount)const{ return this.m_ready && this.m_instanceCount == sceneInstanceCount; }
    public b8 snapshotAccepted(in RendererRayTracingState state)const;
    public b8 ready()const{ return this.m_ready; }
    public b8 uploadRequired()const{ return this.m_uploadRequired; }
    public in BufferHandle nodeBuffer()const{ return this.m_nodeBuffer; }
    public GpuDescriptorHandle nodeHeapHandle()const{ return this.m_nodeHeapHandle; }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

