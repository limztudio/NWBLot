    glyph.position.x = 10.0f;
    glyph.ink = Rect(-1.0f, -30.0f, 2.0f, 2.0f);
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 16.0f, 16.0f, Point(), Rect(8.0f, -11.0f, 5.0f, 4.0f)), TextGlyphIntersection::Visible);
}

void VerifyTextGlyphVisibilityFontTests_HarfBuzzScaleCorrectionRetainsScaledAndOriginalInk(mut TextGlyphVisibilityFontTests self){
    PlacedGlyph glyph = PlacedGlyph();
    glyph.face = self.m_face;
    glyph.ink = Rect(1000.0f, -1.0f, 1.0f, 1.0f);
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 1.004f, 1.0f, Point(), Rect(1006.5f, -1.0f, 0.25f, 0.25f)), TextGlyphIntersection::Visible);
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 1.011f, 1.0f, Point(), Rect(1000.5f, -1.0f, 0.25f, 0.25f)), TextGlyphIntersection::Visible);
    glyph.coverage = MakeUiTextFontLayoutCoverage(glyph.ink, true);
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 1.004f, 1.0f, Point(), Rect(1006.5f, -1.0f, 0.25f, 0.25f)), TextGlyphIntersection::Invisible);
}

void VerifyTextGlyphVisibilityFontTests_UntrustedUnknownInkRetainsAConservativeCandidate(mut TextGlyphVisibilityFontTests self){
    PlacedGlyph glyph = PlacedGlyph();
    glyph.face = self.m_koreanFace;
    glyph.position = Point(1000.0f, 1000.0f);
    glyph.ink = Rect(-2.0f, -10.0f, 12.0f, 12.0f);
    const Rect clip = Rect(0.0f, 0.0f, 100.0f, 100.0f);
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 16.0f, 16.0f, Point(), clip), TextGlyphIntersection::Visible);
    glyph.coverage = MakeUiTextFontLayoutCoverage(glyph.ink, true);
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 16.0f, 16.0f, Point(), clip), TextGlyphIntersection::Invisible);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyTextGlyphVisibilityAtlasTests_SdfCandidateUsesExactPlanesRatherThanShapingInk(mut TextGlyphVisibilityAtlasTests self){
    PlacedGlyph glyph = PlacedGlyph();
    glyph.position = Point(10.0f, 20.0f);
    glyph.ink = Rect(1000.0f, 1000.0f, 1.0f, 1.0f);
    EXPECT_EQ(UiTextGlyphCandidateWithAtlas(glyph, self.m_atlas, 32.0f, 32.0f, Point(100.0f, 200.0f), Rect(106.25f, 204.25f, 0.25f, 0.25f)), TextGlyphIntersection::Visible);
    EXPECT_EQ(UiTextGlyphCandidateWithAtlas(glyph, self.m_atlas, 32.0f, 32.0f, Point(100.0f, 200.0f), Rect(108.0f, 204.0f, 1.0f, 4.0f)), TextGlyphIntersection::Invisible);
}

void VerifyTextGlyphVisibilityAtlasTests_NondrawableAtlasGlyphHasNoCandidateImage(mut TextGlyphVisibilityAtlasTests self){
    PlacedGlyph glyph = PlacedGlyph();
    glyph.glyphId = 1u;
    const auto rectangle = UiTextGlyphAtlasRect(glyph, self.m_atlas, 32.0f, Point());
    ASSERT_TRUE(rectangle.has_value());
    ExpectUiRect(rectangle.value(), Rect());
    EXPECT_EQ(UiTextGlyphCandidateWithAtlas(glyph, self.m_atlas, 32.0f, 32.0f, Point(), Rect(0.0f, 0.0f, 100.0f, 100.0f)), TextGlyphIntersection::Invisible);
}

void VerifyTextGlyphVisibilityAtlasTests_RejectedAtlasRectanglesRejectTheResult(mut TextGlyphVisibilityAtlasTests self){
    PlacedGlyph glyph = PlacedGlyph();
    glyph.glyphId = 2u;
    EXPECT_FALSE(UiTextGlyphAtlasRect(glyph, self.m_atlas, 32.0f, Point()).has_value());
    glyph.glyphId = 0u;
    EXPECT_FALSE(UiTextGlyphAtlasRect(glyph, self.m_atlas, 0.0f, Point()).has_value());
    glyph.position.x = f32.max;
    EXPECT_FALSE(UiTextGlyphAtlasRect(glyph, self.m_atlas, 32.0f, Point(f32.max, 0.0f)).has_value());
}


