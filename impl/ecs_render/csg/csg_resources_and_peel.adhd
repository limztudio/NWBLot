////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 HasValidCsgGraphResourceCapacities(
    in usize receiverRangeCapacity,
    in usize cutterCapacity,
    in usize receiverRangeCount,
    in usize cutterCount
){
    return receiverRangeCapacity >= receiverRangeCount && cutterCapacity >= cutterCount;
}

b8 IsFiniteCsgWorldToClipMatrix(in MatrixSingle worldToClip){
    return IsFiniteCsgMatrix(worldToClip);
}

u32 ComputeCsgIntervalDispatchGroups(in u32 workExtent, in u32 groupSize){
    return DivideUp(workExtent, groupSize);
}

b8 ShouldAdvanceRayTraceReadToken(in b8 previousValid, in b8 matchesQueue, in u64 tokenValue, in u64 previousValue){
    return !previousValid || !matchesQueue || tokenValue > previousValue;
}

usize AccumulateShadowCutterCapacity(in usize currentCapacity, in u32 drawStateCutterCount){
    const usize clampedCount = Min(cast<usize>(drawStateCutterCount), cast<usize>(s_CsgRayMaxCutters));
    if(currentCapacity > usize.max - clampedCount)
        return usize.max;
    return currentCapacity + clampedCount;
}

b8 HasActiveShadowCsgRange(in CsgShadowReceiverRangeGpu range){
    return (range.flags & s_CsgRayReceiverActive) != 0u;
}


