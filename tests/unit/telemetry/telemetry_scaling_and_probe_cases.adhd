void VerifyTelemetry_RegistryOwnsLabelsFromContributorCallbacks(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryCaptureSession session = TelemetryCaptureSession(testArena.arena);
    session.setCaptureOptions(CaptureFrameGraphOnly());
    FrameGraphRegistry registry = FrameGraphRegistry(testArena.arena);
    native(mut testArena, mut session, mut registry){
        LocalLabelContributor contributor;
        registry.registerContributor(contributor);
        ASSERT_TRUE(registry.record(session));
        const auto* event = session.view().eventAt(0u);
        ASSERT_NE(event, nullptr);
        const auto parsed = Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, event->payload.data(), event->payload.size());
        ASSERT_TRUE(parsed.has_value());
        ASSERT_EQ(parsed.value().nodes.size(), 1u);
        EXPECT_EQ(parsed.value().nodes[0u].label, "local label");
    }
}

void VerifyTelemetry_RegistryDefersAddedContributorsAndSkipsRemovedOnes(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryCaptureSession session = TelemetryCaptureSession(testArena.arena);
    session.setCaptureOptions(CaptureFrameGraphOnly());
    FrameGraphRegistry registry = FrameGraphRegistry(testArena.arena);
    MutatingContributor first = MutatingContributor(registry);
    MutatingContributor removed = MutatingContributor(registry);
    MutatingContributor last = MutatingContributor(registry);
    MutatingContributor added = MutatingContributor(registry);
    first.removeSelf = true;
    first.setRemoveOther(removed);
    first.setAddOther(added);
    registry.registerContributor(first);
    registry.registerContributor(removed);
    registry.registerContributor(last);

    ASSERT_TRUE(registry.record(session));
    EXPECT_EQ(first.calls, 1u);
    EXPECT_EQ(removed.calls, 0u);
    EXPECT_EQ(last.calls, 1u);
    EXPECT_EQ(added.calls, 0u);
    ASSERT_TRUE(registry.record(session));
    EXPECT_EQ(first.calls, 1u);
    EXPECT_EQ(removed.calls, 0u);
    EXPECT_EQ(last.calls, 2u);
    EXPECT_EQ(added.calls, 1u);
}

void VerifyTelemetry_RegistryKeepsLabelsAfterRemovedContributorIsDestroyed(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryCaptureSession session = TelemetryCaptureSession(testArena.arena);
    session.setCaptureOptions(CaptureFrameGraphOnly());
    FrameGraphRegistry registry = FrameGraphRegistry(testArena.arena);
    native(mut testArena, mut session, mut registry){
        Optional<OwnedLabelContributor> first;
        first.emplace(registry, testArena.arena);
        DestroyContributor destroyer(first);
        registry.registerContributor(first.value());
        registry.registerContributor(destroyer);
        ASSERT_TRUE(registry.record(session));
        EXPECT_FALSE(first.has_value());
        const auto* event = session.view().eventAt(0u);
        ASSERT_NE(event, nullptr);
        const auto parsed = Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, event->payload.data(), event->payload.size());
        ASSERT_TRUE(parsed.has_value());
        ASSERT_EQ(parsed.value().nodes.size(), 2u);
        EXPECT_EQ(parsed.value().nodes[0u].label, "label retained after contributor destruction");
    }
}

