StringView UiNestedPopupSmokeRectName(in usize index){
    switch(index){
    case 0u:
        return "open";
    case 1u:
        return "counter";
    case 2u:
        return "parent";
    case 3u:
        return "child";
    case 4u:
        return "before_button";
    case 5u:
        return "before_edit";
    case 6u:
        return "before_list";
    case 7u:
        return "before_row2";
    case 8u:
        return "child_open";
    case 9u:
        return "after_button";
    case 10u:
        return "after_edit";
    case 11u:
        return "after_list";
    case 12u:
        return "after_row2";
    case 13u:
        return "child_action";
    case 14u:
        return "child_edit";
    case 15u:
        return "close_branch";
    case 16u:
        return "combo";
    case 17u:
        return "combo_popup";
    case 18u:
        return "combo_row2";
    case 19u:
        return "search";
    case 20u:
        return "search_popup";
    case 21u:
        return "search_query";
    case 22u:
        return "search_row2";
    case 23u:
        return "menu_anchor";
    case 24u:
        return "menu";
    case 25u:
        return "menu_row2";
    default:
        return "";
    }
}

StringView UiNumericEditSmokeRectName(in usize index){
    switch(index){
    case 0u:
        return "integer_bounds";
    case 1u:
        return "integer_content";
    case 2u:
        return "integer_caret";
    case 3u:
        return "integer_selection";
    case 4u:
        return "float_bounds";
    case 5u:
        return "float_content";
    case 6u:
        return "float_caret";
    case 7u:
        return "float_selection";
    case 8u:
        return "clipboard_bounds";
    case 9u:
        return "clipboard_content";
    case 10u:
        return "clipboard_caret";
    case 11u:
        return "clipboard_selection";
    default:
        return "";
    }
}

b8 IsCoherentNumericSmokeEdit(in EditModel model, in EditBoxState state){
    return state.modelGeneration == model.instanceGeneration()
        && state.revision == model.revision()
        && state.selectionGeneration == model.selectionGeneration()
        && state.anchor == model.anchor()
        && state.caret == model.caret();
}

void CaptureNumericSmokeFieldGeometry(
    mut EditBoxView view,
    mut TextService text,
    in EditModel model,
    in EditBoxPlacement placement,
    in usize baseIndex,
    mut Array<SnapshotRect, 12u> rectangles
){
    rectangles[baseIndex] = placement.bounds;
    rectangles[baseIndex + 1u] = placement.content;
    rectangles[baseIndex + 2u] = placement.caret;
    rectangles[baseIndex + 3u] = CaptureEditSelection(view, text, model, placement, 16.0f);
}


void ObserveNestedPopupSmokeTargets(
    in InputRouter input,
    in u64 parentGen,
    in u64 childGen,
    in Span<Rect> rectangles,
    mut u32 outPopupCount,
    mut u32 outPopupTargets,
    mut b8 outChildParentScope,
    mut u32 outFocusScope,
    mut u32 outFocusCode
){
    outFocusScope = 0u;
    outFocusCode = 0u;
    outPopupTargets = 0u;
    outPopupCount = cast<u32>(input.popupCount());
    outChildParentScope = false;
    for(in HitTarget target : input.targets()){
        if(target.popup.valid())
            ++outPopupTargets;
        if(target.popup.instanceGeneration == childGen)
            outChildParentScope = outChildParentScope || SmokePopupMatchesParentGeneration(input, target.popup, parentGen);
        if(target.id != input.focus())
            continue;
        if(target.popup.valid()){
            if(target.popup.instanceGeneration == childGen)
                outFocusScope = 2u;
            else if(target.popup.instanceGeneration == parentGen)
                outFocusScope = 1u;
            else
                outFocusScope = 3u;
        }
        for(usize index = 0u; index < rectangles.size(); ++index){
            if(SameSmokeRect(target.rectangle, rectangles[index])){
                outFocusCode = cast<u32>(index + 1u);
                break;
            }
        }
    }
}


UiNestedPopupSmokeScene::UiNestedPopupSmokeScene(mut GlobalArena arena){
    this.m_source = UiNestedPopupSmokeSource(arena);
    this.m_search = SearchComboState(arena);
    this.m_beforeText = EditModel(arena);
    this.m_afterText = EditModel(arena);
    this.m_childText = EditModel(arena);
    const b8 initialized = this.m_beforeText.setText("Before") && this.m_afterText.setText("After") && this.m_childText.setText("Child");
    [essential] assert(initialized, "UI nested popup smoke models must initialize");
    this.m_combo.select(1u);
    this.m_search.combo().select(1u);
}

b8 UiNestedPopupSmokeScene::paint(mut UiPaintContext context){
    ObserveSmokeDisplay(s_UiNestedPopupSmokeTag, context.display, this.m_lastDisplay, this.m_displayChanged);
    this.m_source.beginFrame();
    this.m_childDeclared = false;
    context.ui.style().fontSize = 12.0f;
    context.ui.style().gap = 4.0f;
    if(!this.paintRoot(context.ui))
        return false;
    PopupOptions options();
    options.anchor = Rect(72.0f, 54.0f, 120.0f, 24.0f);
    options.size = MakeSmokePoint(300.0f, 420.0f);
    if(context.ui.beginPopup("parent", this.m_parent, options)){
        if(!this.paintParent(context.ui) || !context.ui.endPopup())
            return false;
    }
    if(context.ui.failed())
        return false;
    this.observeState(context);
    this.paintMarkers(context);
    return true;
}

b8 UiNestedPopupSmokeScene::keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods){
    if(key != s_SmokeKeyF8)
        return false;
    if(action == s_SmokeActionPress)
        this.m_parent.close();
    return true;
}

b8 UiNestedPopupSmokeScene::paintRoot(mut Builder ui){
    if(!ui.beginPanel("nested_root", Rect(24.0f, 24.0f, 300.0f, 80.0f)))
        return false;
    const WidgetOptions caption = MakeFixedHeightSmokeWidget(16.0f);
    if(!ui.label(s_UiNestedPopupTitleKey, "Nested popup ownership / F8 closes ancestor", caption))
        return false;
    ContainerOptions row();
    row.height.policy = LayoutSizePolicy::Fixed;
    row.height.value = 28.0f;
    row.gap = 4.0f;
    if(!ui.beginRow("root_buttons", row))
        return false;
    const WidgetOptions button = MakeFixedSmokeWidget(140.0f, 28.0f);
    if(ui.button("open", "Open parent", button))
        this.m_parent.open();
    if(ui.button("counter", "Outside counter", button))
        ++this.m_outside;
    return ui.endContainer() && ui.endPanel();
}

b8 UiNestedPopupSmokeScene::paintParent(mut Builder ui){
    const WidgetOptions caption = MakeFixedHeightSmokeWidget(16.0f);
    const WidgetOptions button = MakeFixedSmokeWidget(100.0f, 32.0f);
    const WidgetOptions wide = MakeStretchWidthSmokeWidget(32.0f);
    ContainerOptions row();
    row.height.policy = LayoutSizePolicy::Fixed;
    row.height.value = 32.0f;
    row.gap = 4.0f;
    EditBoxOptions edit();
    edit.height.policy = LayoutSizePolicy::Fixed;
    edit.height.value = 32.0f;
    ListOptions list();
    list.height.policy = LayoutSizePolicy::Fixed;
    list.height.value = 56.0f;
    if(!ui.label(s_UiNestedPopupTitleKey, "Parent scope resumes after nested child", caption) || !ui.beginRow("before", row))
        return false;
    if(ui.button(s_UiNestedPopupActionKey, "Before", button))
        ++this.m_beforeClicks;
    const EditBoxResult before = ui.editBox(s_UiNestedPopupEditKey, this.m_beforeText, this.m_beforeEdit, edit);
    if(!before.valid || !ui.endContainer() || !ui.virtualList("before_list", this.m_source, this.m_beforeList, list).valid)
        return false;
    if(ui.button("child_open", "Open right child", wide))
        this.m_child.open();
    if(!this.paintChild(ui) || !ui.beginRow("after", row))
        return false;
    if(ui.button(s_UiNestedPopupActionKey, "After", button))
        ++this.m_afterClicks;
    const EditBoxResult after = ui.editBox(s_UiNestedPopupEditKey, this.m_afterText, this.m_afterEdit, edit);
    if(!after.valid || !ui.endContainer() || !ui.virtualList("after_list", this.m_source, this.m_afterList, list).valid)
        return false;
    ComboOptions combo();
    combo.height.policy = LayoutSizePolicy::Fixed;
    combo.height.value = 32.0f;
    combo.popupHeight = 172.0f;
    if(!ui.comboBox("combo", this.m_source, this.m_combo, combo).valid)
        return false;
    SearchComboOptions search();
    search.combo = combo;
    search.combo.popupHeight = 196.0f;
    if(!ui.searchComboBox("search", this.m_source, this.m_search, search).combo.valid)
        return false;
    if(ui.button(s_UiNestedPopupMenuAnchorKey, "Right-click for context commands", wide))
        this.m_command = 0u;
    ContextMenuOptions menu();
    menu.size = MakeSmokePoint(200.0f, 172.0f);
    const ContextMenuResult command = ui.contextMenu("commands", s_UiNestedPopupMenuAnchorKey, this.m_source, this.m_menu, menu);
    if(command.activated)
        this.m_command = command.key;
    return command.valid;
}

b8 UiNestedPopupSmokeScene::paintChild(mut Builder ui){
    PopupOptions options();
    const Rect parent = this.m_parent.placement().bounds;
    options.anchor = StoreRect((VectorSingle(parent.x, parent.y, 8.0f, 32.0f) + VectorSingle(parent.width, 124.0f, 0.0f, 0.0f)) - VectorSingle(8.0f, 0.0f, 0.0f, 0.0f));
    options.side = PopupPlacementSide::Right;
    options.size = MakeSmokePoint(220.0f, 178.0f);
    if(!ui.beginPopup("child", this.m_child, options))
        return !ui.failed();
    this.m_childDeclared = true;
    const WidgetOptions caption = MakeFixedHeightSmokeWidget(16.0f);
    const WidgetOptions button = MakeStretchWidthSmokeWidget(32.0f);
    if(!ui.label(s_UiNestedPopupTitleKey, "Child escapes parent clip", caption))
        return false;
    if(ui.button(s_UiNestedPopupActionKey, "Child action", button))
        ++this.m_childClicks;
    EditBoxOptions edit();
    edit.height.policy = LayoutSizePolicy::Fixed;
    edit.height.value = 32.0f;
    const EditBoxResult text = ui.editBox(s_UiNestedPopupEditKey, this.m_childText, this.m_childEdit, edit);
    if(ui.button("close_branch", "Close whole ancestor branch", button))
        this.m_parent.close();
    return text.valid && ui.endPopup();
}

void UiNestedPopupSmokeScene::observeState(mut UiPaintContext context){
    for(usize index = 0u; index < this.m_rectangles.size(); ++index)
        this.m_rectangles[index] = Rect();
    this.m_rectangles[0u] = Rect(32.0f, 52.0f, 140.0f, 28.0f);
    this.m_rectangles[1u] = Rect(176.0f, 52.0f, 140.0f, 28.0f);
    if(this.m_parent.isOpen()){
        const Rect parent = this.m_parent.placement().bounds;
        this.m_rectangles[2u] = parent;
        const VectorSingle parentFrame(parent.x, parent.y, parent.width, 0.0f);
        this.m_rectangles[4u] = StoreRect(VectorSingle(parent.x, parent.y, 100.0f, 32.0f) + VectorSingle(8.0f, 28.0f, 0.0f, 0.0f));
        this.m_rectangles[5u] = this.m_beforeEdit.placement.bounds;
        this.m_rectangles[6u] = this.m_beforeList.placement().bounds;
        this.m_rectangles[7u] = this.rowBounds(this.m_beforeList, this.m_source, 2u);
        this.m_rectangles[8u] = StoreRect(parentFrame + VectorSingle(8.0f, 124.0f, -16.0f, 32.0f));
        this.m_rectangles[9u] = StoreRect(VectorSingle(parent.x, parent.y, 100.0f, 32.0f) + VectorSingle(8.0f, 160.0f, 0.0f, 0.0f));
        this.m_rectangles[10u] = this.m_afterEdit.placement.bounds;
        this.m_rectangles[11u] = this.m_afterList.placement().bounds;
        this.m_rectangles[12u] = this.rowBounds(this.m_afterList, this.m_source, 2u);
        this.m_rectangles[16u] = this.m_combo.bounds();
        this.m_rectangles[19u] = this.m_search.combo().bounds();
        this.m_rectangles[23u] = StoreRect(parentFrame + VectorSingle(8.0f, 328.0f, -16.0f, 32.0f));
        if(this.m_childDeclared && this.m_child.isOpen()){
            const Rect child = this.m_child.placement().bounds;
            this.m_rectangles[3u] = child;
            const VectorSingle childFrame(child.x, child.y, child.width, 0.0f);
            this.m_rectangles[13u] = StoreRect(childFrame + VectorSingle(8.0f, 28.0f, -16.0f, 32.0f));
            this.m_rectangles[14u] = this.m_childEdit.placement.bounds;
            this.m_rectangles[15u] = StoreRect(childFrame + VectorSingle(8.0f, 100.0f, -16.0f, 32.0f));
        }
        if(this.m_combo.isOpen()){
            this.m_rectangles[17u] = this.m_combo.placement().bounds;
            this.m_rectangles[18u] = this.rowBounds(this.m_combo.listState(), this.m_source, 2u);
        }
        if(this.m_search.combo().isOpen()){
            this.m_rectangles[20u] = this.m_search.combo().placement().bounds;
            this.m_rectangles[21u] = this.m_search.editorState().placement.bounds;
            this.m_rectangles[22u] = this.rowBounds(this.m_search.combo().listState(), this.m_source.filtered(), 2u);
        }
        if(this.m_menu.isOpen()){
            this.m_rectangles[24u] = this.m_menu.placement().bounds;
            this.m_rectangles[25u] = this.rowBounds(this.m_menu.listState(), this.m_source, 2u);
        }
    }
    ObserveNestedPopupSmokeTargets(
        context.ui.input(),
        this.m_parent.instanceGeneration(),
        this.m_child.instanceGeneration(),
        this.m_rectangles,
        this.m_popupCount,
        this.m_popupTargets,
        this.m_childParentScope,
        this.m_focusScope,
        this.m_focusCode
    );
    const Array<u64, 29u> current = this.values();
    const b8 geometryChanged = !SameSmokeRectSpan(this.m_rectangles, this.m_lastRectangles);
    if(this.m_sequence != 0u && !this.m_displayChanged && !geometryChanged && SameSmokeU64Span(current, this.m_lastValues))
        return;
    ++this.m_sequence;
    this.m_lastValues = current;
    this.m_lastRectangles = this.m_rectangles;
    this.m_displayChanged = false;
    [essential] info(
        "UiNestedPopupSmoke: state sequence={} values={},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{}"
        , this.m_sequence
        , current[0u]
        , current[1u]
        , current[2u]
        , current[3u]
        , current[4u]
        , current[5u]
        , current[6u]
        , current[7u]
        , current[8u]
        , current[9u]
        , current[10u]
        , current[11u]
        , current[12u]
        , current[13u]
        , current[14u]
        , current[15u]
        , current[16u]
        , current[17u]
        , current[18u]
        , current[19u]
        , current[20u]
        , current[21u]
        , current[22u]
        , current[23u]
        , current[24u]
        , current[25u]
        , current[26u]
        , current[27u]
        , current[28u]
    );
    for(usize index = 0u; index < this.m_rectangles.size(); ++index)
        LogSmokeRect(s_UiNestedPopupSmokeTag, this.m_sequence, UiNestedPopupSmokeRectName(index), this.m_rectangles[index]);
}

void UiNestedPopupSmokeScene::paintMarkers(mut UiPaintContext context)const{
    const Array<u64, 29u> markerValues = this.values();
    PaintPassiveSmokeValueMarkers(markerValues, cast<u64>(this.m_sequence), context);
}

Array<u64, 29u> UiNestedPopupSmokeScene::values()const{
    const b8 parent = this.m_parent.isOpen();
    Array<u64, 29u> out;
    out[0u] = cast<u64>(parent);
    out[1u] = cast<u64>(parent && this.m_childDeclared && this.m_child.isOpen());
    out[2u] = cast<u64>(this.m_focusScope);
    out[3u] = cast<u64>(this.m_focusCode);
    out[4u] = cast<u64>(this.m_beforeClicks);
    out[5u] = cast<u64>(this.m_afterClicks);
    out[6u] = cast<u64>(this.m_childClicks);
    out[7u] = cast<u64>(this.m_outside);
    out[8u] = cast<u64>(this.m_beforeText.text().size());
    out[9u] = cast<u64>(this.m_afterText.text().size());
    out[10u] = cast<u64>(this.m_childText.text().size());
    out[11u] = this.m_beforeList.selectedKey();
    out[12u] = this.m_afterList.selectedKey();
    out[13u] = cast<u64>(parent && this.m_combo.isOpen());
    out[14u] = this.m_combo.selectedKey();
    out[15u] = cast<u64>(parent && this.m_search.combo().isOpen());
    out[16u] = this.m_search.combo().selectedKey();
    out[17u] = cast<u64>(this.m_search.query().text().size());
    out[18u] = cast<u64>(parent && this.m_menu.isOpen());
    out[19u] = this.m_menu.cursorKey();
    out[20u] = this.m_command;
    out[21u] = cast<u64>(this.m_source.labelReads());
    out[22u] = cast<u64>(this.m_child.isOpen());
    out[23u] = cast<u64>(this.m_combo.isOpen());
    out[24u] = cast<u64>(this.m_search.combo().isOpen());
    out[25u] = cast<u64>(this.m_menu.isOpen());
    out[26u] = cast<u64>(this.m_popupTargets);
    out[27u] = cast<u64>(this.m_popupCount);
    out[28u] = cast<u64>(this.m_childParentScope);
    return out;
}

Rect UiNestedPopupSmokeScene::rowBounds(in ListState state, in IListDataSource source, in u64 key)const{
    const ScrollPlacement placement = state.placement();
    const Expected<u64> index = source.indexOf(key);
    if(!index.has_value() || index.value() < placement.firstRow || index.value() >= placement.endRow)
        return Rect();
    return VisibleSmokeListRow(placement, index.value());
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


UiNumericEditSmokeScene::UiNumericEditSmokeScene(mut GlobalArena arena){
    this.m_integer = IntegerEditModel(arena);
    this.m_float = FloatEditModel(arena);
    this.m_clipboard = EditModel(arena);
    this.m_selectionView = EditBoxView(arena);
    this.resetModels();
}

b8 UiNumericEditSmokeScene::paint(mut UiPaintContext context){
    context.ui.style().fontSize = 16.0f;
    context.ui.style().gap = 8.0f;
    if(!context.ui.beginPanel("numeric_edit_fixture", Rect(24.0f, 24.0f, 480.0f, 340.0f)))
        return false;
    const WidgetOptions title = MakeFixedHeightSmokeWidget(24.0f);
    const WidgetOptions caption = MakeFixedHeightSmokeWidget(18.0f);
    if(!context.ui.label("title", "Integer and decimal editors", title) || !context.ui.label("integer_caption", "Signed 64-bit integer", caption))
        return false;
    EditBoxOptions edit();
    edit.width.policy = LayoutSizePolicy::Fixed;
    edit.width.value = 400.0f;
    edit.height.policy = LayoutSizePolicy::Fixed;
    edit.height.value = 40.0f;
    edit.enabled = this.m_enabled;
    edit.readOnly = this.m_readOnly;
    IntegerEditOptions integer();
    integer.edit = edit;
    const NumericEditBoxResult first = context.ui.integerEdit("integer", this.m_integer, this.m_states[0u], integer);
    if(!first.edit.valid)
        return false;
    this.count(first.numeric);
    if(!context.ui.label("float_caption", "Decimal, range -10 to 10", caption))
        return false;
    FloatEditOptions floating();
    floating.edit = edit;
    floating.bounds = this.floatBounds();
    const NumericEditBoxResult second = context.ui.floatEdit("float", this.m_float, this.m_states[1u], floating);
    if(!second.edit.valid)
        return false;
    this.count(second.numeric);
    if(!context.ui.label("clipboard_caption", "Clipboard destination", caption))
        return false;
    edit.enabled = true;
    edit.readOnly = false;
    if(!context.ui.editBox("clipboard", this.m_clipboard, this.m_states[2u], edit).valid)
        return false;
    StringView policyText = "Range policy: reject";
    if(this.m_clamp)
        policyText = "Range policy: clamp";
    if(!context.ui.label("policy", policyText, caption) || !context.ui.label("hint", "Enter: commit / Escape: restore", caption) || !context.ui.endPanel())
        return false;
    this.observeState(context.display, context.text);
    this.paintMarkers(context);
    return true;
}

b8 UiNumericEditSmokeScene::keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods){
    if(key < s_SmokeKeyF5 || key > s_SmokeKeyF9)
        return false;
    if(action == s_SmokeActionPress){
        if(key == s_SmokeKeyF5){
            this.m_readOnly = !this.m_readOnly;
        }
        else if(key == s_SmokeKeyF6){
            this.m_enabled = !this.m_enabled;
        }
        else if(key == s_SmokeKeyF7){
            const b8 assigned = this.m_integer.setValue(cast<i64>(9007199254740995u)) && this.m_float.setValue(2.5);
            [essential] assert(assigned, "UI numeric edit smoke F7 assignment must succeed");
        }
        else if(key == s_SmokeKeyF8){
            this.m_clamp = !this.m_clamp;
        }
        else{
            this.resetModels();
        }
    }
    return true;
}

void UiNumericEditSmokeScene::resetModels(){
    const b8 reset = this.m_integer.setValue(cast<i64>(7)) && this.m_float.setValue(1.25) && this.m_clipboard.setText("");
    [essential] assert(reset, "UI numeric edit smoke reset must succeed");
    this.m_enabled = true;
    this.m_readOnly = false;
    this.m_clamp = true;
}

void UiNumericEditSmokeScene::count(in NumericEditResult result){
    if(result.committed)
        ++this.m_commits;
    if(result.cancelled)
        ++this.m_cancels;
    if(result.rejected)
        ++this.m_rejects;
    if(result.clamped)
        ++this.m_clamps;
    if(result.restored)
        ++this.m_restored;
}

FloatBounds UiNumericEditSmokeScene::floatBounds()const{
    FloatBounds bounds();
    bounds.minimum = -10.0;
    bounds.maximum = 10.0;
    if(this.m_clamp)
        bounds.policy = NumericBoundsPolicy::Clamp;
    else
        bounds.policy = NumericBoundsPolicy::Reject;
    return bounds;
}

Array<u64, 30u> UiNumericEditSmokeScene::values()const{
    Array<u64, 30u> out;
    out[0u] = bit_cast<u64>(this.m_integer.value());
    out[1u] = bit_cast<u64>(this.m_float.value());
    out[2u] = cast<u64>(this.m_integer.draft().text().size());
    out[3u] = cast<u64>(ComputeFnv32TextHash(this.m_integer.draft().text()));
    out[4u] = cast<u64>(this.m_integer.draft().anchor());
    out[5u] = cast<u64>(this.m_integer.draft().caret());
    out[6u] = cast<u64>(this.m_integer.status());
    out[7u] = cast<u64>(this.m_integer.dirty());
    out[8u] = cast<u64>(this.m_states[0u].focused);
    out[9u] = cast<u64>(this.m_float.draft().text().size());
    out[10u] = cast<u64>(ComputeFnv32TextHash(this.m_float.draft().text()));
    out[11u] = cast<u64>(this.m_float.draft().anchor());
    out[12u] = cast<u64>(this.m_float.draft().caret());
    out[13u] = cast<u64>(this.m_float.status(this.floatBounds()));
    out[14u] = cast<u64>(this.m_float.dirty());
    out[15u] = cast<u64>(this.m_states[1u].focused);
    out[16u] = cast<u64>(this.m_clipboard.text().size());
    out[17u] = cast<u64>(ComputeFnv32TextHash(this.m_clipboard.text()));
    out[18u] = cast<u64>(this.m_clipboard.anchor());
    out[19u] = cast<u64>(this.m_clipboard.caret());
    out[20u] = cast<u64>(this.m_states[2u].focused);
    out[21u] = cast<u64>(this.m_enabled);
    out[22u] = cast<u64>(this.m_readOnly);
    out[23u] = cast<u64>(this.m_clamp);
    out[24u] = cast<u64>(this.m_commits);
    out[25u] = cast<u64>(this.m_cancels);
    out[26u] = cast<u64>(this.m_rejects);
    out[27u] = cast<u64>(this.m_clamps);
    out[28u] = cast<u64>(this.m_restored);
    const b8 coherent = IsCoherentNumericSmokeEdit(this.m_integer.draft(), this.m_states[0u])
        && IsCoherentNumericSmokeEdit(this.m_float.draft(), this.m_states[1u])
        && IsCoherentNumericSmokeEdit(this.m_clipboard, this.m_states[2u]);
    out[29u] = cast<u64>(coherent);
    return out;
}

void UiNumericEditSmokeScene::observeState(in DisplayMetrics display, mut TextService text){
    UiNumericEditSnapshot current();
    current.values = this.values();
    current.display = display;
    CaptureNumericSmokeFieldGeometry(this.m_selectionView, text, this.m_integer.draft(), this.m_states[0u].placement, 0u, current.rectangles);
    CaptureNumericSmokeFieldGeometry(this.m_selectionView, text, this.m_float.draft(), this.m_states[1u].placement, 4u, current.rectangles);
    CaptureNumericSmokeFieldGeometry(this.m_selectionView, text, this.m_clipboard, this.m_states[2u].placement, 8u, current.rectangles);
    const b8 changed = !SameSmokeU64Span(current.values, this.m_snapshot.values)
        || !SameSmokeRectSpan(current.rectangles, this.m_snapshot.rectangles);
    const DisplayMetrics previous = this.m_snapshot.display;
    const b8 displayChanged = display.logicalWidth != previous.logicalWidth
        || display.logicalHeight != previous.logicalHeight
        || display.pixelScaleX != previous.pixelScaleX
        || display.pixelScaleY != previous.pixelScaleY;
    if(this.m_snapshot.sequence != 0u && !changed && !displayChanged)
        return;
    current.sequence = this.m_snapshot.sequence + 1u;
    this.m_snapshot = current;
    if(displayChanged){
        [essential] info(
            "UiNumericEditSmoke: display logical={}x{} scale={}x{}"
            , display.logicalWidth
            , display.logicalHeight
            , display.pixelScaleX
            , display.pixelScaleY
        );
    }
    [essential] info(
        "UiNumericEditSmoke: state sequence={} values={},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{}"
        , this.m_snapshot.sequence
        , this.m_snapshot.values[0u]
        , this.m_snapshot.values[1u]
        , this.m_snapshot.values[2u]
        , this.m_snapshot.values[3u]
        , this.m_snapshot.values[4u]
        , this.m_snapshot.values[5u]
        , this.m_snapshot.values[6u]
        , this.m_snapshot.values[7u]
        , this.m_snapshot.values[8u]
        , this.m_snapshot.values[9u]
        , this.m_snapshot.values[10u]
        , this.m_snapshot.values[11u]
        , this.m_snapshot.values[12u]
        , this.m_snapshot.values[13u]
        , this.m_snapshot.values[14u]
        , this.m_snapshot.values[15u]
        , this.m_snapshot.values[16u]
        , this.m_snapshot.values[17u]
        , this.m_snapshot.values[18u]
        , this.m_snapshot.values[19u]
        , this.m_snapshot.values[20u]
        , this.m_snapshot.values[21u]
        , this.m_snapshot.values[22u]
        , this.m_snapshot.values[23u]
        , this.m_snapshot.values[24u]
        , this.m_snapshot.values[25u]
        , this.m_snapshot.values[26u]
        , this.m_snapshot.values[27u]
        , this.m_snapshot.values[28u]
        , this.m_snapshot.values[29u]
    );
    for(usize index = 0u; index < this.m_snapshot.rectangles.size(); ++index)
        LogSmokeRect(s_UiNumericEditSmokeTag, this.m_snapshot.sequence, UiNumericEditSmokeRectName(index), this.m_snapshot.rectangles[index]);
}

void UiNumericEditSmokeScene::paintMarkers(mut UiPaintContext context)const{
    const f32 y = context.display.logicalHeight - 18.0f;
    const Array<f32, 73u> positions = BuildSmokeMarkerPositions<73u>(8u, 8u);
    usize marker = 0u;
    for(usize index = 0u; index <= this.m_snapshot.values.size(); ++index){
        u64 value = cast<u64>(this.m_snapshot.sequence);
        if(index < this.m_snapshot.values.size())
            value = this.m_snapshot.values[index];
        u32 parts = 2u;
        if(index < 2u)
            parts = 6u;
        else if(index == 3u || index == 10u || index == 17u)
            parts = 3u;
        for(u32 part = 0u; part < parts; ++part){
            context.paint.fillRect(Rect(positions[marker], y, 6.0f, 10.0f), EncodeSmokeColor(value >> (part * 12u)));
            ++marker;
        }
    }
}


