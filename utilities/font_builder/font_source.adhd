#include <utilities/font_builder/bake_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsPreparedFontSourcePath(in Path path){
    Array<StringView, 1u> extensions;
    extensions[0u] = s_PreparedFontExtension;
    return PathHasListedExtension(path, extensions);
}

b8 IsValidPreparedFontFaceIndex(in u32 faceIndex){
    return faceIndex == 0u;
}

b8 IsValidFontSourceByteCount(in b8 streamGood, in i64 sourceSize, in u64 maxSourceBytes){
    return streamGood && sourceSize > 0 && cast<u64>(sourceSize) <= maxSourceBytes;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

