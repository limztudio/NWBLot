const StringView s_MaterialMetaDiagnosticPrefix = "Material meta";
const StringView s_MaterialMetaInterfaceField = "interface";
const StringView s_MaterialMetaSurfaceField = "surface";
const StringView s_MaterialMetaShadersField = "shaders";
const StringView s_MaterialMetaShaderVariantField = "shader_variant";
const StringView s_MaterialMetaParametersField = "parameters";
const StringView s_MaterialMetaTransparentField = "transparent";
const StringView s_MaterialMetaTwoSidedField = "two_sided";
const StringView s_MaterialMetaRefractiveField = "refractive";
const StringView s_MaterialMetaBxdfField = "bxdf";
const StringView s_MaterialBxdfExtension = ".bxdf";
const StringView s_MaterialSurfaceExtension = ".surface";
const u32 s_NoSurfaceDispatchId = 0xFFFFFFFFu;
const StringView s_DeferredBxdfFunctionMacro = "NWB_DEFERRED_BXDF_FUNCTION";
const StringView s_DeferredBxdfModelPrefix = "nwbDeferredBxdfModel";
const StringView s_DeferredBxdfIncludeSubDir = "deferred_modules";
const StringView s_DeferredBxdfModuleSubPath = "deferred/generated/bxdf_dispatch.slangi";
const StringView s_DeferredBxdfUnknownFallbackSource = "    default: return half3(1.0h, 0.0h, 1.0h); // no engine default BXDF: an unknown id shows magenta\n";
const StringView s_GeneratedUndefBlockEnd = "\n\n";
const StringView s_GeneratedSwitchCaseLabel = "    case ";
const StringView s_GeneratedSwitchCaseReturn = "u: return ";
const StringView s_GeneratedSwitchEnd = "    }\n";
const StringView s_GeneratedDispatchEnd = "}\n\n#endif\n";
const usize s_ShadowSurfaceBindLayoutAliasCount = 7u;
const usize s_ShadowSurfaceBindInstanceAliasReserveCount = 4u;
const StringView s_ShadowSurfaceFunctionMacro = "nwbMaterialSurface";
const StringView s_ShadowSurfaceModelPrefix = "nwbShadowSurfaceModel";
const StringView s_ShadowSurfaceBindNamespacePrefix = "nwbShadowBindModel";
const StringView s_ShadowSurfaceIncludeSubDir = "shadow_modules";
const StringView s_ShadowSurfaceModuleSubPath = "shadow/generated/surface_dispatch.slangi";
const StringView s_ShadowSurfaceUnknownFallbackSource = "    default: return nwbMakeMeshSurface(half3(0.5h, 0.5h, 0.5h), hit.worldNormal, half(0.0), half(0.0));\n";
const StringView s_AvboitAccumulatePixelShaderGeneratedPrefix = "generated/avboit_accumulate_ps/";
const StringView s_AvboitOccupancyPixelShaderGeneratedPrefix = "generated/avboit_occupancy_ps/";
const StringView s_AvboitExtinctionPixelShaderGeneratedPrefix = "generated/avboit_extinction_ps/";
const StringView s_GeneratedCacheDirectory = "generated";
const StringView s_GeneratedShaderSourceExtension = ".slang";
const StringView s_GeneratedPixelShaderBindHookLine = "// typed .bind + its surface hook. The material declares only its 'surface' fragment; the cook\n";
const StringView s_GeneratedPixelShaderCookCacheLine = "// assembles this here, in the cook cache. Do not edit -- regenerated every cook.\n";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateMaterialBindIncludePath(in StringView virtualPath, in StringView source){
    if(virtualPath.empty()){
        error("Material bind include generation failed: virtual path is empty for '{}'", source);
        return false;
    }
    return true;
}

b8 ValidateDeferredBxdfSource(in StringView materialPath, in StringView bxdfSource){
    if(bxdfSource.empty()){
        error("Material cook: material '{}' is missing a deferred bxdf", materialPath);
        return false;
    }
    return true;
}

b8 ValidateDeferredBxdfCount(in usize count){
    if(count > cast<usize>(u32.max)){
        error("Material cook: too many unique deferred bxdfs");
        return false;
    }
    return true;
}

b8 ValidateMaterialSurfaceCount(in usize count){
    if(count > cast<usize>(u32.max)){
        error("Material cook: too many unique material surfaces");
        return false;
    }
    return true;
}

b8 ValidateGeneratedMaterialMeshShader(in usize generatedCount, in Name meshShaderName){
    if(generatedCount > 0u && meshShaderName == s_NameNone){
        error("Material pixel shader generation: missing shared mesh shader name");
        return false;
    }
    return true;
}

b8 ValidateTransparentMaterialInterface(in StringView materialPath, in StringView materialInterface, in StringView passLabel){
    if(materialInterface.empty()){
        error("Material cook: transparent material '{}' needs an interface to generate its AVBOIT {} pixel shader", materialPath, passLabel);
        return false;
    }
    return true;
}

b8 IsMaterialOpticalStageCombinationValid(in b8 hasExplicitShaders, in b8 hasSurface, in b8 transparent, in b8 refractive){
    return !hasExplicitShaders || hasSurface || (!transparent && !refractive);
}

b8 IsMaterialResourceParameterCandidate(in StringView trimmedText){
    return !trimmedText.empty() && !trimmedText.contains("(") && !trimmedText.contains(")");
}

b8 IsAllowedMaterialAssetField(in StringView fieldName){
    return fieldName == s_MaterialMetaInterfaceField
        || fieldName == s_MaterialMetaSurfaceField
        || fieldName == s_MaterialMetaShadersField
        || fieldName == s_MaterialMetaShaderVariantField
        || fieldName == s_MaterialMetaParametersField
        || fieldName == s_MaterialMetaTransparentField
        || fieldName == s_MaterialMetaTwoSidedField
        || fieldName == s_MaterialMetaRefractiveField
        || fieldName == s_MaterialMetaBxdfField;
}

b8 ValidateMaterialCookEntryRequiredFields(
    in StringView virtualPath,
    in StringView materialInterface,
    in u64 typedLayoutHash,
    in StringView shaderVariant
){
    if(materialInterface.empty()){
        error("Material cook: material '{}' is missing required material interface", virtualPath);
        return false;
    }
    if(typedLayoutHash == 0u){
        error("Material cook: interface material '{}' is missing typed layout data", virtualPath);
        return false;
    }
    if(shaderVariant.empty()){
        error("Material cook: material '{}' has empty shader variant", virtualPath);
        return false;
    }
    return true;
}

b8 TryResolveOptionalMaterialAvboitPixelShader(
    in StringView materialVirtualPath,
    in StringView shaderNameText,
    in StringView passLabel,
    mut AssetRef<PixelShader> outShaderRef
){
    outShaderRef = AssetRef<PixelShader>();
    if(shaderNameText.empty())
        return true;

    const Expected<Name> shaderName = TryParseMaterialBindName(shaderNameText);
    if(!shaderName.has_value()){
        error("Material cook: material '{}' has an invalid AVBOIT {} pixel shader name", materialVirtualPath, passLabel);
        return false;
    }

    outShaderRef.virtualPath = shaderName.value();
    return true;
}

b8 ValidateMaterialGeneratedPixelShaderEntry(
    in StringView virtualPath,
    in b8 hasExplicitShaders,
    in b8 hasSurface,
    in StringView materialInterface
){
    if(hasExplicitShaders){
        if(hasSurface){
            error("Material cook: material '{}' declares both 'surface' and 'shaders'; declare exactly one", virtualPath);
            return false;
        }
        return true;
    }
    if(!hasSurface){
        error("Material cook: material '{}' declares neither 'surface' nor 'shaders'", virtualPath);
        return false;
    }
    if(materialInterface.empty()){
        error("Material cook: material '{}' needs an interface to generate its pixel shader", virtualPath);
        return false;
    }
    return true;
}

String BuildDeferredBxdfDispatchModuleSource(in Span<StringView> sourceById){
    String outSource = "";
    outSource.append("// Generated by the asset cook from material `bxdf` declarations. Do not edit.\n");
    outSource.append("#ifndef NWB_GRAPHICS_DEFERRED_GENERATED_BXDF_DISPATCH_SLANGI\n");
    outSource.append("#define NWB_GRAPHICS_DEFERRED_GENERATED_BXDF_DISPATCH_SLANGI\n\n");

    for(usize id = 0u; id < sourceById.size(); ++id){
        if(sourceById[id].empty())
            continue;
        outSource.append(s_GeneratedDefineDirective);
        outSource.append(s_DeferredBxdfFunctionMacro);
        outSource.push_back(' ');
        outSource.append(s_DeferredBxdfModelPrefix);
        AppendDecimalU32(cast<u32>(id), outSource);
        outSource.push_back('\n');
        outSource.append(s_GeneratedIncludeDirective);
        outSource.append(sourceById[id]);
        outSource.append(s_GeneratedIncludeDirectiveEnd);
        outSource.append(s_GeneratedUndefDirective);
        outSource.append(s_DeferredBxdfFunctionMacro);
        outSource.append(s_GeneratedUndefBlockEnd);
    }

    outSource.append("half3 nwbDeferredDispatchBxdf(uint shadingModel, NwbBxdfSurface surface, int2 pixel){\n");
    outSource.append("    switch(shadingModel){\n");
    for(usize id = 0u; id < sourceById.size(); ++id){
        if(sourceById[id].empty())
            continue;
        outSource.append(s_GeneratedSwitchCaseLabel);
        AppendDecimalU32(cast<u32>(id), outSource);
        outSource.append(s_GeneratedSwitchCaseReturn);
        outSource.append(s_DeferredBxdfModelPrefix);
        AppendDecimalU32(cast<u32>(id), outSource);
        outSource.append("(surface, pixel);\n");
    }
    outSource.append(s_DeferredBxdfUnknownFallbackSource);
    outSource.append(s_GeneratedSwitchEnd);
    outSource.append(s_GeneratedDispatchEnd);
    return outSource;
}

void BuildGeneratedMaterialPixelShaderSource(
    in StringView headerCommentLine,
    in StringView authoringHeaderInclude,
    in StringView materialInterface,
    in StringView surfaceSource,
    mut String outSource
){
    outSource.clear();
    outSource.append(headerCommentLine);
    outSource.append(s_GeneratedPixelShaderBindHookLine);
    outSource.append(s_GeneratedPixelShaderCookCacheLine);
    outSource.append(s_GeneratedIncludeDirective);
    outSource.append(authoringHeaderInclude);
    outSource.append(s_GeneratedIncludeDirectiveEnd);
    outSource.append(s_GeneratedIncludeDirective);
    outSource.append(materialInterface);
    outSource.append(".bind\"\n");
    outSource.append(s_GeneratedIncludeDirective);
    outSource.append(surfaceSource);
    outSource.append(s_GeneratedIncludeDirectiveEnd);
}


