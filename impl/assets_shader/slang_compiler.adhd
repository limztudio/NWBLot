////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_ShaderOptionalBoolMetaPrefix = "Meta";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize ComputeCompilerDefineFixedArgumentBytes(in usize prefixBytes, in b8 hasValue){
    if(hasValue)
        return prefixBytes + 1u;
    return prefixBytes;
}

b8 IsPlannedMacroIncludeDefine(in b8 compilerInputsHaveBom, in Span<StringView> externallyPlannedMacroIncludes, in StringView defineName){
    if(!compilerInputsHaveBom)
        return false;
    for(in StringView plannedName : externallyPlannedMacroIncludes){
        if(plannedName == defineName)
            return true;
    }
    return false;
}

b8 ValidateUnexpectedCompilerDiagnosticsEmpty(
    in StringView shaderName,
    in StringView variantName,
    in StringView diagnostics
){
    if(diagnostics.empty())
        return true;

    error("Shader compiler emitted unexpected diagnostics for '{}' (variant '{}') :\n{}", shaderName, variantName, diagnostics);
    return false;
}

b8 ValidateCompiledShaderStageName(in StringView shaderName, in StringView variantName, in b8 validStageName){
    if(validStageName)
        return true;

    error("Shader compile failed for '{}' (variant '{}'): shader stage contains an embedded null", shaderName, variantName);
    return false;
}

b8 ValidateCompiledSpirvEntryPoint(in StringView shaderName, in StringView variantName, in b8 resolvedEntryPoint){
    if(resolvedEntryPoint)
        return true;

    error("Shader compile failed for '{}' (variant '{}'): malformed SPIR-V or wrong physical stage/entry point", shaderName, variantName);
    return false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

