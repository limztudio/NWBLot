#include <impl/assets_mesh/asset.adhd>
#include <impl/assets_mesh/skin_asset.adhd>
#include <impl/assets_mesh/mesh_binary_codec.adhd>
#include <impl/assets_mesh/skin_binary_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 DeserializeMeshBinaryPayload(
    in Span<u8> binary,
    mut Vector<f32x3u> outPositions,
    mut Vector<f16x4u> outNormals,
    mut Vector<f16x4u> outTangents,
    mut Vector<f32x2u> outUv0,
    mut Vector<f16x4u> outColors,
    mut Vector<MeshletDesc> outMeshlets,
    mut Vector<MeshletBounds> outMeshletBounds,
    mut Vector<u8> outMeshletPositionRefDeltas,
    mut Vector<u8> outMeshletAttributeRefDeltas,
    mut Vector<MeshletLocalVertexRef> outMeshletLocalVertexRefs,
    mut Vector<u8> outMeshletPrimitiveIndices,
    mut Vector<u32> outSolidTriangleWords
){
    MeshBinaryCodec codec;
    return codec.deserialize(
        binary,
        outPositions,
        outNormals,
        outTangents,
        outUv0,
        outColors,
        outMeshlets,
        outMeshletBounds,
        outMeshletPositionRefDeltas,
        outMeshletAttributeRefDeltas,
        outMeshletLocalVertexRefs,
        outMeshletPrimitiveIndices,
        outSolidTriangleWords
    );
}

b8 DeserializeSkinBinaryPayload(
    in Span<u8> binary,
    mut Name outMesh,
    mut Name outSkeleton,
    mut Vector<SkinInfluence4> outInfluences,
    mut Vector<SkeletonJointMatrix> outInverseBindMatrices
){
    SkinBinaryCodec codec;
    return codec.deserialize(binary, outMesh, outSkeleton, outInfluences, outInverseBindMatrices);
}

b8 Mesh::validatePayload()const{
    return ValidateMeshAssetPayload(
        this.virtualPath(),
        this.m_positionStream,
        this.m_normalStream,
        this.m_tangentStream,
        this.m_uv0Stream,
        this.m_colorStream,
        this.m_meshlets,
        this.m_meshletBounds,
        this.m_meshletPositionRefDeltas,
        this.m_meshletAttributeRefDeltas,
        this.m_meshletLocalVertexRefs,
        this.m_meshletPrimitiveIndices,
        this.m_solidTriangleWords
    );
}

b8 Mesh::validatePayload(mut ScratchArena scratchArena)const{
    return this.validatePayload();
}

b8 Mesh::loadBinary(in Span<u8> binary){
    if(!this.checkVirtualPath("Mesh::loadBinary"))
        return false;

    Mesh candidate(this.virtualPath());
    if(!DeserializeMeshBinaryPayload(
        binary,
        candidate.m_positionStream,
        candidate.m_normalStream,
        candidate.m_tangentStream,
        candidate.m_uv0Stream,
        candidate.m_colorStream,
        candidate.m_meshlets,
        candidate.m_meshletBounds,
        candidate.m_meshletPositionRefDeltas,
        candidate.m_meshletAttributeRefDeltas,
        candidate.m_meshletLocalVertexRefs,
        candidate.m_meshletPrimitiveIndices,
        candidate.m_solidTriangleWords
    ))
        return false;

    if(!candidate.validatePayload())
        return false;
    this = candidate;
    return true;
}

b8 Skin::loadBinary(in Span<u8> binary){
    Skin candidate(this.virtualPath());
    Name meshPath;
    Name skeletonPath;
    if(!DeserializeSkinBinaryPayload(binary, meshPath, skeletonPath, candidate.m_influences, candidate.m_inverseBindMatrices))
        return false;
    candidate.setMesh(AssetRef<Mesh>(meshPath));
    candidate.setSkeleton(AssetRef<Skeleton>(skeletonPath));
    if(!candidate.validatePayload())
        return false;
    this = candidate;
    return true;
}

b8 Skin::validatePayload()const{
    if(!this.checkVirtualPath("Skin::validatePayload"))
        return false;
    return ValidateSkinAssetPayload(this.m_mesh.valid(), this.m_skeleton.valid(), this.m_influences, this.m_inverseBindMatrices);
}


