struct alignas(SIMDVectorSingle) PowerObservation{
    SIMDVectorSingle value;
    u64 rawNativeStatus = 0u;
    i32 flags = 0;
    i32 error = 0;
    u32 nativeStatus = 0u;
};
static_assert(alignof(Expected<PowerObservation>) >= alignof(PowerObservation));

class PowerEnvironmentGuard final : NoCopy{
public:
    PowerEnvironmentGuard()noexcept
        : m_originalError(errno)
        , m_originalEnvironment(HoldFloatingPointExceptions())
    {
#if defined(NWB_PLATFORM_WINDOWS) && defined(NWB_HAS_NEON64) && !defined(_M_ARM64EC)
        __asm__ __volatile__("mrs %0, fpsr" : "=r"(m_originalNativeStatus));
#endif
    }

    PowerEnvironmentGuard(PowerEnvironmentGuard&&) = delete;

    ~PowerEnvironmentGuard()noexcept{
        if(!m_originalEnvironment)
            return;
        if(!SetFloatingPointEnvironment(*m_originalEnvironment))
            __builtin_trap();
#if defined(NWB_PLATFORM_WINDOWS) && defined(NWB_HAS_NEON64) && !defined(_M_ARM64EC)
        __asm__ __volatile__("msr fpsr, %0" : : "r"(m_originalNativeStatus));
#endif
        errno = m_originalError;
    }


public:
    [[nodiscard]] b8 valid()const noexcept{ return m_originalEnvironment.has_value(); }


private:
    i32 m_originalError = 0;
#if defined(NWB_PLATFORM_WINDOWS) && defined(NWB_HAS_NEON64) && !defined(_M_ARM64EC)
    u64 m_originalNativeStatus = 0u;
#endif
    Expected<FloatingPointEnvironment> m_originalEnvironment;
};

class MxcsrEnvironmentGuard final : NoCopy{
public:
    MxcsrEnvironmentGuard()noexcept
#if defined(NWB_HAS_SSE2) || defined(NWB_HAS_AVX)
        : m_originalControl(_mm_getcsr())
        , m_originalEnvironment(HoldFloatingPointExceptions())
#else
        : m_originalEnvironment(HoldFloatingPointExceptions())
#endif
    {
#if defined(NWB_HAS_SSE2) || defined(NWB_HAS_AVX)
        m_heldControl = _mm_getcsr();
#endif
    }

    MxcsrEnvironmentGuard(MxcsrEnvironmentGuard&&) = delete;

    ~MxcsrEnvironmentGuard()noexcept{
        if(m_originalEnvironment && !SetFloatingPointEnvironment(*m_originalEnvironment))
            NWB_ASSERT(false);
#if defined(NWB_HAS_SSE2) || defined(NWB_HAS_AVX)
        _mm_setcsr(m_originalControl);
#endif
    }


public:
    [[nodiscard]] b8 valid()const noexcept{ return m_originalEnvironment.has_value(); }

    void applyMode([[maybe_unused]] const u32 mode)const noexcept{
#if defined(NWB_HAS_SSE2) || defined(NWB_HAS_AVX)
        _mm_setcsr((m_heldControl & ~(0x8040u | 0x3fu)) | mode);
#endif
    }


private:
#if defined(NWB_HAS_SSE2) || defined(NWB_HAS_AVX)
    u32 m_originalControl = 0u;
    u32 m_heldControl = 0u;
#endif
    Expected<FloatingPointEnvironment> m_originalEnvironment;
};

#if defined(NWB_PLATFORM_WINDOWS) && defined(NWB_HAS_NEON64) && !defined(_M_ARM64EC)
inline constexpr Array<u32, 2u> s_PowerDenormalModes = { _DN_SAVE, _DN_FLUSH };
inline constexpr Array<u64, 4u> s_PowerNativeSeeds = { 0u, 0x80u, 0x08000000u, 0x08000080u };
#else
inline constexpr Array<u32, 1u> s_PowerDenormalModes = { 0u };
inline constexpr Array<u64, 1u> s_PowerNativeSeeds = { 0u };
#endif
inline constexpr Array<i32, 2u> s_PowerInitialFlags = { 0, FE_INEXACT };

#if defined(NWB_HAS_SSE2) || defined(NWB_HAS_AVX)
inline constexpr Array<u32, 4u> s_OrderedClampModes = { 0u, 0x40u, 0x8000u, 0x8040u };
#else
inline constexpr Array<u32, 1u> s_OrderedClampModes = { 0u };
#endif

[[nodiscard]] inline constexpr b8 ShouldSkipNeon32SqrtCase()noexcept{
#if defined(NWB_HAS_NEON) && !defined(NWB_HAS_NEON64)
    return true;
#else
    return false;
#endif
}

[[nodiscard]] inline constexpr b8 HasDoubleFmaResidual()noexcept{
#if defined(NWB_HAS_FMA3) || defined(NWB_HAS_NEON)
    return true;
#else
    return false;
#endif
}

[[nodiscard]] inline constexpr b8 HasSingleFmaResidual()noexcept{
#if defined(NWB_HAS_FMA3) || defined(NWB_HAS_NEON64)
    return true;
#else
    return false;
#endif
}

[[nodiscard]] inline b8 ConfigurePowerDenormalMode([[maybe_unused]] const u32 denormalMode, [[maybe_unused]] const b8 unmaskInvalid)noexcept{
#if defined(NWB_PLATFORM_WINDOWS) && defined(NWB_HAS_NEON64) && !defined(_M_ARM64EC)
    u32 control = 0u;
    if(_controlfp_s(&control, denormalMode, _MCW_DN) != 0)
        return false;
    if((control & _MCW_DN) != denormalMode)
        return false;
    if(unmaskInvalid && _controlfp_s(&control, control & ~_EM_INVALID, _MCW_EM) != 0)
        return false;
#endif
    return true;
}

NWB_NOINLINE SIMDVectorSingle FrozenPower(SIMDVectorSingle x, SIMDVectorSingle y)noexcept;
NWB_NOINLINE SIMDVectorSingle CurrentPower(SIMDVectorSingle x, SIMDVectorSingle y)noexcept;
[[nodiscard]] Expected<PowerObservation> ObserveFrozenPower(SIMDVectorSingle x, SIMDVectorSingle y, i32 initialFlags, u64 initialNativeFlags)noexcept;
[[nodiscard]] Expected<PowerObservation> ObserveCurrentPower(SIMDVectorSingle x, SIMDVectorSingle y, i32 initialFlags, u64 initialNativeFlags)noexcept;

NWB_NOINLINE f32 LegacyMultiplyAddExpression(f32 first, f32 second, f32 addend)noexcept;
NWB_NOINLINE f64 LegacyDoubleMultiplyAddExpression(f64 first, f64 second, f64 addend)noexcept;
NWB_NOINLINE f32 LegacyNegativeMultiplySubtractExpression(f32 first, f32 second, f32 addend)noexcept;
NWB_NOINLINE f64 LegacyDoubleMultiplyThenAdd(f64 first, f64 second, f64 addend)noexcept;
NWB_NOINLINE SIMDVectorDouble DoubleMultiplyAddExpression(SIMDVectorDouble first, SIMDVectorDouble second, SIMDVectorDouble addend)noexcept;
NWB_NOINLINE SIMDVectorDouble DoubleMultiplyThenAdd(SIMDVectorDouble first, SIMDVectorDouble second, SIMDVectorDouble addend)noexcept;


