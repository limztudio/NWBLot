#include <impl/ecs_ui/toolkit/text/sdf_support.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ResolveNextTextLineRange(
    in StringView text,
    in usize byteBegin,
    mut usize outByteEnd,
    mut usize outBreakEnd
){
    usize byteEnd = byteBegin;
    while(byteEnd < text.size() && text[byteEnd] != '\r' && text[byteEnd] != '\n')
        ++byteEnd;
    usize breakEnd = byteEnd;
    if(breakEnd < text.size()){
        if(text[breakEnd] == '\r')
            breakEnd += s_TextCarriageReturnLineFeedBytes;
        else
            breakEnd += 1u;
    }
    outByteEnd = byteEnd;
    outBreakEnd = breakEnd;
}

Expected<TextLine> TryBuildInitialTextLine(
    in usize byteBegin,
    in usize byteEnd,
    in usize breakEnd,
    in usize firstGlyph,
    in usize glyphCount,
    in usize firstCluster,
    in f32 top,
    in FontMetrics metrics
){
    const f64 baseline = cast<f64>(top) + cast<f64>(metrics.ascender);
    const f64 height = (cast<f64>(metrics.ascender) + cast<f64>(metrics.descender)) + cast<f64>(metrics.lineGap);
    if(!FitsTextCoordinate(baseline) || !FitsTextCoordinate(cast<f64>(top) + height))
        return makeUnexpected(Failure());
    TextLine line;
    line.byteBegin = cast<u32>(byteBegin);
    line.byteEnd = cast<u32>(byteEnd);
    line.breakEnd = cast<u32>(breakEnd);
    line.firstGlyph = cast<u32>(firstGlyph);
    line.glyphCount = cast<u32>(glyphCount);
    line.firstCluster = cast<u32>(firstCluster);
    line.top = top;
    line.baseline = cast<f32>(baseline);
    line.height = cast<f32>(height);
    return line;
}

Expected<Point> TryAdvanceTextGlyphPosition(
    in f32 baseline,
    in Point offset,
    in Point advance,
    in Rect ink,
    in GlyphCoverageBounds coverage,
    mut f32 inOutPen,
    mut VectorDouble inOutInkBounds,
    mut b8 inOutHasInk
){
    const f64 x = cast<f64>(inOutPen) + cast<f64>(offset.x);
    const f64 y = cast<f64>(baseline) + cast<f64>(offset.y);
    const f64 nextPen = cast<f64>(inOutPen) + cast<f64>(advance.x);
    if(!FitsTextCoordinate(x) || !FitsTextCoordinate(y) || !FitsTextCoordinate(nextPen))
        return makeUnexpected(Failure());
    const Point position(cast<f32>(x), cast<f32>(y));
    const Expected<VectorDouble> translatedInk = TryTranslateTextInk(position, ink);
    if(!translatedInk.has_value() || !TryIncludeTextInk(translatedInk.value(), inOutInkBounds, inOutHasInk))
        return makeUnexpected(Failure());
    if(coverage.known && !TryTranslateTextInk(position, coverage.ink).has_value())
        return makeUnexpected(Failure());
    inOutPen = cast<f32>(nextPen);
    return position;
}

TextCluster MakeTextCluster(
    in u32 lineByteBegin,
    in u32 glyphByteBegin,
    in u32 glyphByteEnd,
    in u32 firstGlyph,
    in u32 glyphCount,
    in u32 lineIndex,
    in TextDirection direction,
    in f32 clusterLeft,
    in f32 pen
){
    TextCluster cluster;
    cluster.byteBegin = lineByteBegin + glyphByteBegin;
    cluster.byteEnd = lineByteBegin + glyphByteEnd;
    cluster.firstGlyph = firstGlyph;
    cluster.glyphCount = glyphCount;
    cluster.lineIndex = lineIndex;
    if(direction == TextDirection::LeftToRight){
        cluster.leadingX = clusterLeft;
        cluster.trailingX = pen;
    }
    else{
        cluster.leadingX = pen;
        cluster.trailingX = clusterLeft;
    }
    return cluster;
}

VectorDouble ComputeInitialMeasuredTextBounds(in Point logical, in Rect ink){
    const f64 inkEndX = cast<f64>(ink.x) + cast<f64>(ink.width);
    const f64 inkEndY = cast<f64>(ink.y) + cast<f64>(ink.height);
    const f64 minX = min(0.0, cast<f64>(ink.x));
    const f64 minY = min(0.0, cast<f64>(ink.y));
    const f64 maxX = max(cast<f64>(logical.x), inkEndX);
    const f64 maxY = max(cast<f64>(logical.y), inkEndY);
    return VectorDouble(minX, minY, maxX, maxY);
}

void ExpandMeasuredTextBoundsWithSdfSupport(in VectorDouble support, mut VectorDouble inOutBounds){
    if(support.z <= 0.0 || support.w <= 0.0)
        return;
    const f64 firstX = support.x;
    const f64 firstY = support.y;
    const f64 lastX = firstX + support.z;
    const f64 lastY = firstY + support.w;
    inOutBounds = VectorDouble(
        min(inOutBounds.x, firstX),
        min(inOutBounds.y, firstY),
        max(inOutBounds.z, lastX),
        max(inOutBounds.w, lastY)
    );
}

void ExpandMeasuredTextBoundsWithRaster(
    in Point glyphPosition,
    in Rect raster,
    in f32 rasterScale,
    in DisplayMetrics display,
    mut VectorDouble inOutBounds
){
    if(raster.width <= 0.0f || raster.height <= 0.0f)
        return;
    const f64 scale = cast<f64>(rasterScale);
    const f64 originX = cast<f64>(glyphPosition.x);
    const f64 originY = cast<f64>(glyphPosition.y);
    const f64 pixelOriginX = cast<f64>(raster.x);
    const f64 pixelOriginY = cast<f64>(raster.y);
    const f64 pixelEndX = pixelOriginX + cast<f64>(raster.width);
    const f64 pixelEndY = pixelOriginY + cast<f64>(raster.height);
    // CoverageRectangle snaps the bitmap origin to the nearest physical pixel; every translation phase differs by at most half a pixel on each axis.
    const f64 snapX = s_TextHalfPixel / cast<f64>(display.pixelScaleX);
    const f64 snapY = s_TextHalfPixel / cast<f64>(display.pixelScaleY);
    const f64 firstX = (originX + (pixelOriginX / scale)) - snapX;
    const f64 firstY = (originY + (pixelOriginY / scale)) - snapY;
    const f64 lastX = (originX + (pixelEndX / scale)) + snapX;
    const f64 lastY = (originY + (pixelEndY / scale)) + snapY;
    inOutBounds = VectorDouble(
        min(inOutBounds.x, firstX),
        min(inOutBounds.y, firstY),
        max(inOutBounds.z, lastX),
        max(inOutBounds.w, lastY)
    );
}


