#include <impl/ecs_render/material/task_graph_opaque_compute_tasks.adhd>
#include <impl/ecs_render/shared/frame_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 OpaqueRegularComputeEmulationGraphTaskPayload::record(mut CommandList commands, in GpuTaskRecordContext context)const{
    if(!this.plan.generated.captured)
        return false;
    GpuTimingTicketRecordingScope timing(this.timingTicket.value());
    if(!FrameSetupReady(this.meshViewSetupReady, this.sceneShadingSetupReady))
        return true;
    if(!this.plan.generated.matches())
        return false;

    const b8 drawsReady = this.materialSystem.drawRecorder().meshMaterialPassDrawResourcesReady(this.plan.meshDrawItems, this.frameBindings)
        && this.materialSystem.drawRecorder().indexedMaterialPassDrawResourcesReady(this.plan.indexedDrawItems, this.frameBindings)
        && this.materialSystem.drawRecorder().computeMaterialPassDrawResourcesReady(this.plan.generated.drawItems, this.frameBindings);
    if(!this.materialDrawBuffersUploaded || !this.frameBindings.frameReady(this.instanceCount, this.materialTypedByteCount) || !drawsReady)
        return true;

    ViewportState viewport;
    viewport.addViewportAndScissorRect(this.targets.framebuffer.deref().getFramebufferInfo().getViewport());
    MaterialPassDrawContext drawContext(commands, viewport, this.frameBindings, MaterialPipelinePass::Opaque, this.materialFrameStatesGraphOwned, this.materialGeometryStatesGraphOwned, true);
    this.materialSystem.drawRecorder().generateComputeMaterialPassDrawItems(drawContext, this.plan.generated.drawItems);
    return true;
}

b8 OpaqueRegularSharedComputeEmulationGraphTask::record(mut CommandList commands, in GpuTaskRecordContext context)const{
    if(!this.plan.captured)
        return false;
    GpuTimingTicketRecordingScope timing(this.timingTicket.value());
    if(!this.opaqueRegularTiming.has_value()){
        if(this.phase == SharedComputeEmulationPhase::Raster)
            commands.endRenderPass();
        return true;
    }
    if(!FrameSetupReady(this.meshViewSetupReady, this.sceneShadingSetupReady) || !this.plan.matches(this.drawIndex))
        return false;
    const Span<MaterialPassDrawItem> capturedDraws = this.plan.drawItems;
    const Span<MaterialPassDrawItem> draws = capturedDraws.subspan(this.drawIndex, 1u);
    if(!this.materialDrawBuffersUploaded || !this.frameBindings.frameReady(this.instanceCount, this.materialTypedByteCount)
        || !this.materialSystem.drawRecorder().computeMaterialPassDrawResourcesReady(draws, this.frameBindings)){
        DiscardGpuTimingMeasure(this.opaqueRegularTiming);
        if(this.phase == SharedComputeEmulationPhase::Raster)
            commands.endRenderPass();
        return true;
    }
    ViewportState viewport;
    viewport.addViewportAndScissorRect(this.targets.framebuffer.deref().getFramebufferInfo().getViewport());
    MaterialPassDrawContext drawContext(commands, viewport, this.frameBindings, MaterialPipelinePass::Opaque, this.materialFrameStatesGraphOwned, this.materialGeometryStatesGraphOwned, true);
    if(this.phase == SharedComputeEmulationPhase::Raster)
        drawContext.setFramebuffer(this.targets.framebuffer);
    if(this.phase == SharedComputeEmulationPhase::Generate)
        this.materialSystem.drawRecorder().generateComputeMaterialPassDrawItems(drawContext, draws);
    else{
        this.materialSystem.drawRecorder().renderComputeMaterialPassDrawItemsRasterOnly(drawContext, draws);
        if(this.finishTiming){
            this.opaqueRegularTiming.value().finishTiming(commands);
            this.opaqueRegularTiming.reset();
        }
        commands.endRenderPass();
    }
    return true;
}


