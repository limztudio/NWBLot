void VerifyUiPopupToolsNavigationTests_SourceRevisionRestoresRowsFocusAtAcceptanceAndRetiresHeldInput(mut UiPopupToolsNavigationTests self){
    ASSERT_TRUE(self.acceptTools(1u, false));
    ASSERT_TRUE(self.openBySecondary(2u));
    const auto initialHost = self.findMenuHost();
    ASSERT_TRUE(initialHost.has_value());
    const WidgetId rows = initialHost.value().id;
    ASSERT_EQ(self.m_context.input().focus(), rows);
    self.press(Key::End);
    ASSERT_TRUE(self.acceptTools(3u, false));
    ASSERT_EQ(self.m_menu.cursorKey(), 5u);
    ASSERT_FALSE(self.m_menuResult.activated);
    const u64 oldInputGeneration = self.m_menu.listState().inputGeneration();
    const auto thirdHost = self.findMenuHost();
    ASSERT_TRUE(thirdHost.has_value());
    const u64 oldSourceRevision = thirdHost.value().control.contentRevision;

    self.press(Key::Enter);
    InputEvent heldNavigation = InputEvent();
    heldNavigation.type = InputEventType::KeyDown;
    heldNavigation.key = Key::Down;
    EXPECT_TRUE(self.send(heldNavigation).commandConsumed);
    ASSERT_FALSE(self.m_context.input().controlActions().empty());
    self.m_source.count = 4u;
    ++self.m_source.contentRevision;

    ASSERT_TRUE(self.prepareTools(4u, false));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 3u);
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_FALSE(self.m_context.input().capture().valid());
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
    EXPECT_NE(self.m_menu.listState().inputGeneration(), oldInputGeneration);
    EXPECT_EQ(self.m_menu.cursorKey(), 1u);
    EXPECT_TRUE(self.m_menu.isOpen());
    EXPECT_FALSE(self.m_menuResult.activated);
    EXPECT_EQ(self.m_menuResult.key, 0u);
    EXPECT_FALSE(self.m_context.commitFrame(3u));
    EXPECT_FALSE(self.m_context.input().focus().valid());

    ASSERT_TRUE(self.m_context.commitFrame(4u));
    const auto committedHost = self.findMenuHost();
    ASSERT_TRUE(committedHost.has_value());
    EXPECT_EQ(committedHost.value().id, rows);
    EXPECT_EQ(self.m_context.input().focus(), rows);
    EXPECT_NE(committedHost.value().control.contentRevision, oldSourceRevision);
    EXPECT_EQ(committedHost.value().control.contentRevision, self.m_source.contentRevision);
    EXPECT_EQ(committedHost.value().control.instanceGeneration, self.m_menu.listState().inputGeneration());
    heldNavigation.repeat = true;
    EXPECT_TRUE(self.send(heldNavigation).commandConsumed);
    ASSERT_TRUE(self.acceptTools(5u, false));
    EXPECT_EQ(self.m_menu.cursorKey(), 1u);
    EXPECT_FALSE(self.m_menuResult.activated);
    EXPECT_TRUE(self.m_menu.isOpen());
    heldNavigation.type = InputEventType::KeyUp;
    heldNavigation.repeat = false;
    EXPECT_TRUE(self.send(heldNavigation).commandConsumed);

    self.press(Key::End);
    ASSERT_TRUE(self.acceptTools(6u, false));
    EXPECT_EQ(self.m_menu.cursorKey(), 4u);
    EXPECT_FALSE(self.m_menuResult.activated);
    self.press(Key::Enter);
    ASSERT_TRUE(self.acceptTools(9u, false));
    EXPECT_TRUE(self.m_menuResult.activated);
    EXPECT_EQ(self.m_menuResult.key, 4u);
    EXPECT_TRUE(self.m_menuResult.closed);
    EXPECT_FALSE(self.m_menu.isOpen());
    EXPECT_FALSE(self.m_context.input().hasPopup());
}

void VerifyUiPopupToolsNavigationTests_FocusLossAndRegainCannotRestorePreparedRowsFocus(mut UiPopupToolsNavigationTests self){
    ASSERT_TRUE(self.acceptTools(1u, false));
    ASSERT_TRUE(self.openBySecondary(2u));
    const auto host = self.findMenuHost();
    ASSERT_TRUE(host.has_value());
    ASSERT_EQ(self.m_context.input().focus(), host.value().id);
    self.m_source.count = 4u;
    ++self.m_source.contentRevision;
    ASSERT_TRUE(self.prepareTools(3u, false));
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_TRUE(self.m_menu.isOpen());

    EXPECT_FALSE(self.send(MakeUiPopupRouterBareEvent(InputEventType::FocusLost)).focus.valid());
    EXPECT_FALSE(self.send(MakeUiPopupRouterBareEvent(InputEventType::FocusGained)).focus.valid());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_FALSE(self.m_context.input().capture().valid());
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
    ASSERT_TRUE(self.acceptTools(4u, false));
    EXPECT_TRUE(self.m_menuResult.closed);
    EXPECT_FALSE(self.m_menuResult.activated);
    EXPECT_FALSE(self.m_menu.isOpen());
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_FALSE(self.m_context.input().focus().valid());
}


