[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <core/alloc/scratch.h>

namespace NWB::Impl{
using ScratchSubsystemNameHashVector = Vector<NameHash, Core::Alloc::ScratchArena>;
using ScratchSubsystemFieldCountVector = Vector<u64, Core::Alloc::ScratchArena>;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Name s_SubsystemLoadBinaryArena = "impl/assets_subsystem/load_binary";
const Name s_SubsystemSerializeArena = "impl/assets_subsystem/serialize";

const StringView s_SubsystemDiagnosticPrefix = "Subsystem meta";
const StringView s_SubsystemSubsystemsFieldName = "subsystems";

const u32 s_SubsystemMagic = 0x53554231u; // SUB1
const u32 s_SubsystemVersion = 1u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SubsystemFieldValueDescriptor{
    public StringView fieldName = "";
    public Name expectedAssetType = s_NameNone;
    public b8 isArray = false;
}

[serialize]
class SubsystemHeaderBinary{
    public u32 magic = s_SubsystemMagic;
    public u32 version = s_SubsystemVersion;
    public NameHash subsystemTypeHash;
    public u64 subsystemCount = 0u;
    public u64 fieldCount = 0u;
    public u64 assetCount = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

b8 ValidateSubsystemDependentRef(in Name virtualPath, in Name refName, in b8 isValidRef, in usize index){
    if(!isValidRef){
        error("ISubsystem::validatePayload failed: subsystem '{}' dependent subsystem entry {} must not be empty", virtualPath.resolvedText(), index);
        return false;
    }
    if(refName == virtualPath){
        error("ISubsystem::validatePayload failed: subsystem '{}' cannot reference itself in 'subsystems'", virtualPath.resolvedText());
        return false;
    }
    return true;
}

b8 ValidateSubsystemFieldValueCount(in Name virtualPath, in SubsystemFieldValueDescriptor descriptor, in usize valueCount){
    if(descriptor.isArray){
        if(valueCount == 0u){
            error(
                "ISubsystem::validatePayload failed: subsystem '{}' array field '{}' must not be empty"
                , virtualPath.resolvedText()
                , descriptor.fieldName
            );
            return false;
        }
        return true;
    }
    if(valueCount != 1u){
        error(
            "ISubsystem::validatePayload failed: subsystem '{}' field '{}' must contain exactly one value"
            , virtualPath.resolvedText()
            , descriptor.fieldName
        );
        return false;
    }
    return true;
}

b8 ValidateSubsystemFieldElementValue(in Name virtualPath, in SubsystemFieldValueDescriptor descriptor, in Name value, in b8 isDuplicate){
    if(value == s_NameNone){
        error("ISubsystem::validatePayload failed: subsystem '{}' field '{}' must not be empty", virtualPath.resolvedText(), descriptor.fieldName);
        return false;
    }
    if(isDuplicate){
        error(
            "ISubsystem::validatePayload failed: subsystem '{}' array field '{}' has duplicate entry '{}'"
            , virtualPath.resolvedText()
            , descriptor.fieldName
            , value.resolvedText()
        );
        return false;
    }
    return true;
}

b8 ValidateSubsystemBinaryScalarFieldCount(in Name assetType, in SubsystemFieldValueDescriptor descriptor, in u64 elementCount){
    if(descriptor.isArray || elementCount == 1u)
        return true;

    error(
        "ISubsystem::loadBinary failed: scalar field '{}' in '{}' has element count {}"
        , descriptor.fieldName
        , assetType.resolvedText()
        , elementCount
    );
    return false;
}

void DeduplicateSubsystemRefs<TAsset>(mut Vector<AssetRef<TAsset>> subsystems){
    usize writeIndex = 0u;
    for(usize readIndex = 0u; readIndex < subsystems.size(); ++readIndex){
        const AssetRef<TAsset> candidate = subsystems[readIndex];
        b8 duplicate = false;
        for(usize prevIndex = 0u; prevIndex < writeIndex; ++prevIndex){
            if(subsystems[prevIndex].name() == candidate.name()){
                duplicate = true;
                break;
            }
        }
        if(!duplicate){
            if(writeIndex != readIndex)
                subsystems[writeIndex] = candidate;
            ++writeIndex;
        }
    }
    subsystems.resize(writeIndex);
}

b8 ValidateNonEmptySubsystemRefName(in Name subsystemName){
    if(subsystemName != s_NameNone)
        return true;

    error("ISubsystem::loadBinary failed: subsystem reference must not be empty");
    return false;
}

b8 UnpackSubsystemRefHashes<TAsset>(in Span<NameHash> subsystemHashes, mut Vector<AssetRef<TAsset>> outSubsystems){
    outSubsystems.clear();
    outSubsystems.reserve(subsystemHashes.size());
    for(in NameHash subsystemHash : subsystemHashes){
        const Name subsystemName(subsystemHash);
        if(!ValidateNonEmptySubsystemRefName(subsystemName))
            return false;
        AssetRef<TAsset> ref;
        ref.virtualPath = subsystemName;
        outSubsystems.push_back(ref);
    }
    DeduplicateSubsystemRefs(outSubsystems);
    return true;
}

const usize s_SubsystemHeaderBinaryBytes = 96u;
const usize s_SubsystemNameHashBinaryBytes = 64u;
const usize s_SubsystemFieldCountBinaryBytes = 8u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

