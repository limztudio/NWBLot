// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_BINDLESS_HEAP_SLANGI
#define NWB_GRAPHICS_BINDLESS_HEAP_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Global descriptor heap - shader accessor surface.
// One unbounded array per resource class at the set/binding in binding_slots.h; aliased views share one binding with different SPIR-V access/stride.
// A slot varying across a wave needs NonUniformResourceIndex() at the subscript (single-invocation tests exempt).
// TLAS is a dedicated fixed descriptor-buffer set; commands record the handle block offset so retired descriptors stay immutable until drain.


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "binding_slots.h"

// Most shaders skip the TLAS. Give those variants an explicit disabled value: Slang evaluates the right side of `defined(...) && ...` and warns on an undefined identifier.
#ifndef NWB_BINDLESS_TLAS
#define NWB_BINDLESS_TLAS 0
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Generic uniform-buffer heap alias: the leading uint is at byte 0, uint3 padding starts at byte 16, and the configured std140 layout has a 32-byte extent.
struct NwbBindlessHeapUint{
    uint value;
    uint3 padding;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[vk::binding(NWB_BINDLESS_HEAP_BINDING_SAMPLED_IMAGE, NWB_BINDLESS_HEAP_RESOURCE_SET)]] Texture2D<float4> g_NwbHeapSampledImages[];

// Texture2DArray needs its own declaration from Texture2D; it shares the resource-slot namespace under a separate binding/class.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_SAMPLED_IMAGE_2D_ARRAY, NWB_BINDLESS_HEAP_RESOURCE_SET)]] Texture2DArray<float4> g_NwbHeapSampledImage2DArrays[];

// Texture3D needs another sampled-image binding because the Slang resource type sets the SPIR-V view dimension. It shares the global slot namespace.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_SAMPLED_IMAGE_3D, NWB_BINDLESS_HEAP_RESOURCE_SET)]] Texture3D<float4> g_NwbHeapSampledImage3Ds[];

// TextureCube likewise needs its own declaration and binding: a cube view cannot be addressed through the Texture2D table.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_SAMPLED_IMAGE_CUBE, NWB_BINDLESS_HEAP_RESOURCE_SET)]] TextureCube<float4> g_NwbHeapSampledImageCubes[];

[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_IMAGE, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWTexture2D<float4> g_NwbHeapStorageImages[];

// Scalar uint and 3D float writable views share the StorageImage descriptor table through typed aliases.
#pragma warning(push)
#pragma warning(disable: 39001) // Deliberate typed aliases of the StorageImage descriptor table.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_IMAGE, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWTexture2D<uint> g_NwbHeapStorageImageUints[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_IMAGE, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWTexture3D<float> g_NwbHeapStorageImage3DFloats[];
#pragma warning(pop)

// Storage-image descriptors carry dimension+format, so one table exposes typed 2D-array aliases (CSG transients).
// Shared binding 1 avoids a new heap ABI class per format.
#pragma warning(push)
#pragma warning(disable: 39001) // Deliberate typed aliases of the StorageImage descriptor table.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_IMAGE, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWTexture2DArray<float4> g_NwbHeapStorageImage2DArrayFloat4s[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_IMAGE, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWTexture2DArray<uint> g_NwbHeapStorageImage2DArrayUints[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_IMAGE, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWTexture2DArray<uint2> g_NwbHeapStorageImage2DArrayUint2s[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_IMAGE, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWTexture2DArray<uint4> g_NwbHeapStorageImage2DArrayUint4s[];
#pragma warning(pop)

[[vk::binding(NWB_BINDLESS_HEAP_BINDING_SAMPLED_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] Buffer<uint> g_NwbHeapSampledBuffers[];

[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWByteAddressBuffer g_NwbHeapStorageBuffers[];

// Read-only raw alias over the same StorageBuffer binding (SRV/UAV is SPIR-V access decoration, not a new descriptor).
// Keeps write capability out of geometry fetches.
#pragma warning(push)
#pragma warning(disable: 39001) // Deliberate read-only view of the storage-buffer descriptor table above.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] ByteAddressBuffer g_NwbHeapRawBuffers[];
#pragma warning(pop)

[[vk::binding(NWB_BINDLESS_HEAP_BINDING_UNIFORM_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] ConstantBuffer<NwbBindlessHeapUint> g_NwbHeapUniformBuffers[];

[[vk::binding(NWB_BINDLESS_HEAP_BINDING_SAMPLER, NWB_BINDLESS_HEAP_SAMPLER_SET)]] SamplerState g_NwbHeapSamplers[];

#if NWB_BINDLESS_TLAS
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_ACCEL_STRUCT, NWB_BINDLESS_HEAP_ACCEL_STRUCT_SET)]] RaytracingAccelerationStructure g_NwbHeapAccelStruct;
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Read-only raw slot accessor; centralizes NonUniformResourceIndex (per-mesh slots vary across a wave). Returns the buffer by value for caller-offset loads.
ByteAddressBuffer nwbHeapRawBuffer(const uint slot){
    return g_NwbHeapRawBuffers[NonUniformResourceIndex(slot)];
}

// Deferred/compositor slot buffers are constant across their fullscreen draw. Keep these indices uniform: unlike per-mesh fetches they need no non-uniform-indexing capability.
Texture2D<float4> nwbHeapSampledImage2D(const uint slot){
    return g_NwbHeapSampledImages[slot];
}

// Material texture slots can differ between adjacent pixel/ray invocations. Keep NonUniformResourceIndex at the heap boundary.
Texture2D<float4> nwbHeapSampledImage2DNonUniform(const uint slot){
    return g_NwbHeapSampledImages[NonUniformResourceIndex(slot)];
}

Texture2DArray<float4> nwbHeapSampledImage2DArray(const uint slot){
    return g_NwbHeapSampledImage2DArrays[slot];
}

Texture3D<float4> nwbHeapSampledImage3D(const uint slot){
    return g_NwbHeapSampledImage3Ds[slot];
}

TextureCube<float4> nwbHeapSampledImageCube(const uint slot){
    return g_NwbHeapSampledImageCubes[slot];
}

// CSG's slot cbuffer is uniform per draw/dispatch, so these lookups stay uniform. Per-invocation storage-image indexing needs NonUniformResourceIndex.
RWTexture2DArray<float4> nwbHeapStorageImage2DArrayFloat4(const uint slot){
    return g_NwbHeapStorageImage2DArrayFloat4s[slot];
}

RWTexture2DArray<uint> nwbHeapStorageImage2DArrayUint(const uint slot){
    return g_NwbHeapStorageImage2DArrayUints[slot];
}

RWTexture2DArray<uint2> nwbHeapStorageImage2DArrayUint2(const uint slot){
    return g_NwbHeapStorageImage2DArrayUint2s[slot];
}

RWTexture2DArray<uint4> nwbHeapStorageImage2DArrayUint4(const uint slot){
    return g_NwbHeapStorageImage2DArrayUint4s[slot];
}

RWTexture2D<float4> nwbHeapStorageImage2DFloat4(const uint slot){
    return g_NwbHeapStorageImages[slot];
}

RWTexture2D<uint> nwbHeapStorageImage2DUint(const uint slot){
    return g_NwbHeapStorageImageUints[slot];
}

RWTexture3D<float> nwbHeapStorageImage3DFloat(const uint slot){
    return g_NwbHeapStorageImage3DFloats[slot];
}

SamplerState nwbHeapSampler(const uint slot){
    return g_NwbHeapSamplers[slot];
}

SamplerState nwbHeapSamplerNonUniform(const uint slot){
    return g_NwbHeapSamplers[NonUniformResourceIndex(slot)];
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if NWB_BINDLESS_TLAS


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The host selects the active TLAS descriptor when it binds the heap block.
// Not an array subscript: a fresh block per generation keeps older command buffers on their AS descriptor until quarantine retires it.


RaytracingAccelerationStructure nwbHeapAccelStruct(){
    return g_NwbHeapAccelStruct;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

