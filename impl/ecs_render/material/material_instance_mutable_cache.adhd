#include <impl/ecs_render/material/material_instance_override_applier.adhd>
#include <impl/ecs_render/material/material_surface_builder.adhd>
#include <impl/ecs_render/material/renderer_draw_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MaterialInstanceMutableCache : NoCopy{
    private HashMap<EntityID, MaterialInstanceMutableCacheEntry> m_entries;
    private Vector<EntityID> m_deadEntities;
    private u64 m_componentMutationVersion = 0u;

    [owner_result]
    private MaterialInstanceMutableCacheEntry emptyEntry()const{
        return MaterialInstanceMutableCacheEntry();
    }

    private b8 matches(in MaterialInstanceMutableCacheEntry entry, in MaterialSurfaceInfo surface, in MaterialInstanceComponent instance)const{
        return MaterialInstanceMutableCacheEntryMatches(entry.materialName, entry.materialInterface, entry.typedLayoutHash, entry.revision,
            surface.materialName, surface.materialInterface, surface.typedLayoutHash, instance);
    }

    [cpp_unwind]
    public Expected<Span<u8>> prepare(mut World world, in EntityID entity, in MaterialSurfaceInfo surface, in Optional<in MaterialInstanceComponent> instance){
        this.prune(world);
        if(!instance.has_value() || instance.value().overrides.empty())
            return Span<u8>(surface.mutableDefaultTypedBytes);

        const auto stored = this.m_entries.try_emplace(entity, this.emptyEntry());
        mut MaterialInstanceMutableCacheEntry entry = stored.first.value();
        if(this.matches(entry, surface, instance.value()))
            return Span<u8>(entry.mutableTypedBytes);

        MaterialSurfaceBuilder().copyTypedBytes(surface.mutableDefaultTypedBytes, entry.mutableTypedBytes);
        if(!MaterialInstanceOverrideApplier().applyWithLookup(entity.id, surface.materialName, surface.materialInterface, surface.typedLayoutBlocks,
            surface.typedLayoutFields, surface.overrideFieldLookup, instance.value(), entry.mutableTypedBytes)){
            this.m_entries.erase(stored.first);
            return MakeUnexpected(Failure());
        }
        entry.materialName = surface.materialName;
        entry.materialInterface = surface.materialInterface;
        entry.typedLayoutHash = surface.typedLayoutHash;
        entry.revision = instance.value().revision;
        return Span<u8>(entry.mutableTypedBytes);
    }

    public Expected<Span<u8>> find(in EntityID entity, in MaterialSurfaceInfo surface, in Optional<in MaterialInstanceComponent> instance)const{
        if(!instance.has_value() || instance.value().overrides.empty())
            return Span<u8>(surface.mutableDefaultTypedBytes);
        const auto found = this.m_entries.find(entity);
        if(found == this.m_entries.end() || !this.matches(found.value(), surface, instance.value()))
            return MakeUnexpected(Failure());
        return Span<u8>(found.value().mutableTypedBytes);
    }

    public void prune(mut World world){
        const u64 version = world.componentMutationVersion<MaterialInstanceComponent>();
        if(version == this.m_componentMutationVersion)
            return;

        this.m_componentMutationVersion = version;
        if(this.m_entries.empty())
            return;

        this.m_deadEntities.clear();
        for(in auto entry : this.m_entries){
            const EntityID entity = entry.first;
            if(!world.hasComponent<MaterialInstanceComponent>(entity))
                this.m_deadEntities.push_back(entity);
        }
        for(in EntityID dead : this.m_deadEntities)
            this.m_entries.erase(dead);
    }

    public void clear(){
        this.m_entries.clear();
        this.m_deadEntities.clear();
        this.m_componentMutationVersion = 0u;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

