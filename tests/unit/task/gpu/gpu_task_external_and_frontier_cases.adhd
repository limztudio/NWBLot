const Name s_GpuExtFrontierOwnedCompletion = "tests/task_graph/owned_external_completion";
const Name s_GpuExtFrontierMetadataCompletion = "tests/task_graph/metadata_external_completion";
const Name s_GpuExtFrontierSecondMergeDomain = "tests/task_graph/frontier_scored_second_domain";
const Name s_GpuExtFrontierCrossQueueMergeDomain = "tests/task_graph/frontier_scored_cross_queue";

SingleQueueCompile GpuExtFrontier_MakeSingleQueueCompile(mut TestArena testArena){
    return SingleQueueCompile(testArena);
}

TwoQueueCompile GpuExtFrontier_MakeTwoQueueCompile(mut TestArena testArena){
    return TwoQueueCompile(testArena);
}

GpuPhysicalQueueTopology GpuExtFrontier_MakeTopology(in Span<GpuPhysicalQueueInfo> queues){
    return MakeTopology(queues);
}

QueueSubmissionToken GpuExtFrontier_MakeToken(
    in u64 value,
    in u16 physicalQueueIndex,
    in u16 deviceGeneration,
    in CommandQueueEnum queue
){
    QueueSubmissionToken token = QueueSubmissionToken();
    token.value = value;
    token.physicalQueueIndex = physicalQueueIndex;
    token.deviceGeneration = deviceGeneration;
    token.queue = queue;
    return token;
}

Optional<QueueSubmissionToken> GpuExtFrontier_ExternalCompletionToken(
    in GpuTaskGraphDeclarationReadView declarations,
    in GpuExternalCompletionId completion
){
    return ExternalCompletionTokenValue(declarations, completion);
}

b8 GpuExtFrontier_ValidateExternalDependencyTokens(
    in GpuTaskGraphDeclarationReadView declarations,
    in GpuCompiledGraphReadView compiled,
    in GpuSubmissionPacketRange range
){
    return ValidateExternalDependencyTokens(declarations, compiled, range);
}

b8 GpuExtFrontier_HasEdge(in GpuTaskGraphAnalysis analysis, in GpuTaskId producer, in GpuTaskId consumer){
    return HasEdge(analysis, producer, consumer);
}

Optional<GpuTaskQueueAssignment> GpuExtFrontier_FindAssignment(in GpuTaskGraphQueueAssignments assignments, in GpuTaskId task){
    return FindQueueAssignment(assignments, task);
}

Optional<GpuCompiledTask> GpuExtFrontier_TaskPlan(in GpuCompiledTaskView view){
    return TaskPlan(view);
}

Span<GpuCompiledBarrier> GpuExtFrontier_EpilogueBarriers(in GpuCompiledTaskView view){
    return EpilogueBarriers(view);
}

Optional<GpuSubmissionPacket> GpuExtFrontier_PacketPlan(in GpuCompiledPacketView view){
    return PacketPlan(view);
}

b8 GpuExtFrontier_HasPacketDepsPtr(in GpuCompiledPacketView view){
    return HasPacketDependenciesPtr(view);
}

Span<GpuPacketDependency> GpuExtFrontier_PacketDependencies(in GpuCompiledPacketView view){
    return PacketDependencies(view);
}

Optional<GpuCompiledExternalResourceExport> GpuExtFrontier_ExportPlan(in GpuCompiledExternalResourceExportView view){
    return ExportPlan(view);
}

Span<GpuCompiledExternalResourceExportSource> GpuExtFrontier_ExportSources(in GpuCompiledExternalResourceExportView view){
    return ExportSources(view);
}

b8 GpuExtFrontier_HasTransfersPtr(in GpuCompiledGraphReadView plan){
    return HasLogicalOwnershipTransfersPtr(plan);
}

b8 GpuExtFrontier_FirstTransferMatchesSliceStart(in GpuCompiledGraphReadView plan){
    const Span<GpuCompiledOwnershipTransfer> transfers = LogicalOwnershipTransfers(plan);
    const Optional<GpuCompiledOwnershipTransfer> firstOpt = LogicalOwnershipTransferAtValue(plan, 0u);
    if(transfers.empty() || !firstOpt.has_value())
        return false;
    const GpuCompiledOwnershipTransfer sliceFirst = transfers[0u];
    const GpuCompiledOwnershipTransfer indexedFirst = firstOpt.value();
    return sliceFirst.resource == indexedFirst.resource
        && sliceFirst.range.bufferRange == indexedFirst.range.bufferRange
        && sliceFirst.range.textureSubresources == indexedFirst.range.textureSubresources
        && sliceFirst.sourceTask == indexedFirst.sourceTask
        && sliceFirst.destinationTask == indexedFirst.destinationTask
        && sliceFirst.sourcePacket == indexedFirst.sourcePacket
        && sliceFirst.destinationPacket == indexedFirst.destinationPacket
        && sliceFirst.sourceQueueFamilyIndex == indexedFirst.sourceQueueFamilyIndex
        && sliceFirst.destinationQueueFamilyIndex == indexedFirst.destinationQueueFamilyIndex
        && sliceFirst.resourceIdentity == indexedFirst.resourceIdentity
        && sliceFirst.sourceQueue == indexedFirst.sourceQueue
        && sliceFirst.destinationQueue == indexedFirst.destinationQueue
        && sliceFirst.declaredQueueSharing == indexedFirst.declaredQueueSharing
        && sliceFirst.resourceType == indexedFirst.resourceType
        && sliceFirst.route == indexedFirst.route
        && sliceFirst.concurrentSharingCouldAvoid == indexedFirst.concurrentSharingCouldAvoid;
}

Optional<GpuCompiledOwnershipTransfer> GpuExtFrontier_OwnershipTransferAt(in GpuCompiledGraphReadView plan, in usize index){
    return LogicalOwnershipTransferAtValue(plan, index);
}

Expected<GpuTaskId> GpuExtFrontier_AddEmptyTask(in Name identity, in AStringView label, mut GpuTaskGraph graph){
    const Span<GpuTaskId> emptyDeps = Span<GpuTaskId>();
    const Span<GpuTaskResourceUse> emptyUses = Span<GpuTaskResourceUse>();
    const Span<GpuTaskResourceSetUse> emptySets = Span<GpuTaskResourceSetUse>();
    const Span<GpuTaskResourceVersionUse> emptyVersions = Span<GpuTaskResourceVersionUse>();
    const Span<GpuExternalCompletionId> emptyExternals = Span<GpuExternalCompletionId>();
    return AddTask(identity, label, emptyDeps, emptyUses, emptySets, emptyVersions, emptyExternals, graph);
}

void VerifyGpuExtFrontier_RejectsSubmissionRangeWithMissingLatePacketCompletionToken(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Name completionIdentity = s_TaskGraphMissingLatePacketCompletion;
    GpuExternalCompletionDesc compDesc = GpuExternalCompletionDesc();
    compDesc.setIdentity(completionIdentity);
    compDesc.setMarkerLabel("Late Packet Completion");
    const auto completionResult = graph.importExternalCompletion(compDesc);
    ASSERT_TRUE(completionResult.has_value());
    const GpuExternalCompletionId completion = completionResult.value();
    ASSERT_TRUE(completion.valid());

    const auto firstResult = GpuExtFrontier_AddEmptyTask(s_GpuCaseTaskGraphTokenPreflightFirst, "Token Preflight First", graph);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    ASSERT_TRUE(first.valid());

    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.forceSubmissionBoundary = true;
    scheduling.allowPacketMerge = false;
    Array<GpuTaskId, 1> firstDeps = Array<GpuTaskId, 1>();
    firstDeps[0u] = first;
    Array<GpuExternalCompletionId, 1> extDeps = Array<GpuExternalCompletionId, 1>();
    extDeps[0u] = completion;
    GpuTaskDesc secondDesc = GpuTaskDesc();
    secondDesc.setIdentity(s_GpuCaseTaskGraphTokenPreflightSecond);
    secondDesc.setMarkerLabel("Token Preflight Second");
    secondDesc.setScheduling(scheduling);
    secondDesc.setDependencies(firstDeps);
    secondDesc.setExternalDependencies(extDeps);
    const auto secondResult = graph.addTask(secondDesc);
    ASSERT_TRUE(secondResult.has_value());
    const GpuTaskId second = secondResult.value();
    ASSERT_TRUE(second.valid());

    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = GpuExtFrontier_MakeTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    {
        const GpuTaskGraphReadViews views = GpuTaskGraphReadViews(graph, compiledGraph);
        ASSERT_TRUE(views.valid());
        ASSERT_EQ(views.compiled.packetCount(), 2u);
        const GpuSubmissionPacketRange firstRange = views.compiled.packetRangeForTasks(first, first);
        const GpuSubmissionPacketRange secondRange = views.compiled.packetRangeForTasks(second, second);
        EXPECT_FALSE(GpuExtFrontier_ExternalCompletionToken(views.declarations, completion).has_value());
        EXPECT_TRUE(GpuExtFrontier_ValidateExternalDependencyTokens(views.declarations, views.compiled, firstRange));
        EXPECT_FALSE(GpuExtFrontier_ValidateExternalDependencyTokens(views.declarations, views.compiled, secondRange));
        EXPECT_FALSE(GpuExtFrontier_ValidateExternalDependencyTokens(views.declarations, views.compiled, views.compiled.allPacketRange()));
    }

    const QueueSubmissionToken token = GpuExtFrontier_MakeToken(17u, queues[0u].id.index, queues[0u].id.deviceGeneration, queues[0u].queueClass);
    {
        GpuExternalCompletionDesc boundDesc = GpuExternalCompletionDesc();
        boundDesc.setIdentity(completionIdentity);
        boundDesc.setMarkerLabel("Bound Late Packet Completion");
        boundDesc.setToken(token);
        const auto gpuTaskAdmission = graph.importExternalCompletion(boundDesc);
        EXPECT_TRUE(gpuTaskAdmission.has_value());
        if(gpuTaskAdmission.has_value())
            EXPECT_EQ(gpuTaskAdmission.value(), completion);
    }
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);
        EXPECT_FALSE(GpuExtFrontier_ValidateExternalDependencyTokens(declarations, compiledPlan, compiledPlan.allPacketRange()));
    }
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    {
        const GpuTaskGraphReadViews views = GpuTaskGraphReadViews(graph, compiledGraph);
        ASSERT_TRUE(views.valid());
        EXPECT_TRUE(GpuExtFrontier_ValidateExternalDependencyTokens(views.declarations, views.compiled, views.compiled.allPacketRange()));
    }
}

void VerifyGpuExtFrontier_RetainsAuthoritativeExternalCompletionTokens(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const QueueSubmissionToken token = GpuExtFrontier_MakeToken(31u, 2u, 1u, CommandQueue::Transfer);
    GpuExternalCompletionDesc ownedDesc = GpuExternalCompletionDesc();
    ownedDesc.setIdentity(s_GpuExtFrontierOwnedCompletion);
    ownedDesc.setMarkerLabel("Owned External Completion");
    ownedDesc.setToken(token);
    const auto completionResult = graph.importExternalCompletion(ownedDesc);
    ASSERT_TRUE(completionResult.has_value());
    const GpuExternalCompletionId completion = completionResult.value();
    ASSERT_TRUE(completion.valid());

    u64 tokenFirstRevision = 0u;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        ASSERT_EQ(declarations.externalCompletionCount(), 1u);
        const Optional<QueueSubmissionToken> storedToken = GpuExtFrontier_ExternalCompletionToken(declarations, completion);
        ASSERT_TRUE(storedToken.has_value());
        EXPECT_TRUE(declarations.validForDeviceGeneration(token.deviceGeneration));
        tokenFirstRevision = declarations.declarationRevision();
    }

    GpuExternalCompletionDesc compatMetaDesc = GpuExternalCompletionDesc();
    compatMetaDesc.setIdentity(s_GpuExtFrontierOwnedCompletion);
    compatMetaDesc.setMarkerLabel("Compatible Metadata Reference");
    const auto repeatedMetadataImportResult = graph.importExternalCompletion(compatMetaDesc);
    ASSERT_TRUE(repeatedMetadataImportResult.has_value());
    EXPECT_EQ(repeatedMetadataImportResult.value(), completion);
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        EXPECT_EQ(declarations.declarationRevision(), tokenFirstRevision);
    }

    GpuExternalCompletionDesc compatTokDesc = GpuExternalCompletionDesc();
    compatTokDesc.setIdentity(s_GpuExtFrontierOwnedCompletion);
    compatTokDesc.setMarkerLabel("Compatible Token Reference");
    compatTokDesc.setToken(token);
    const auto repeatedTokenImportResult = graph.importExternalCompletion(compatTokDesc);
    ASSERT_TRUE(repeatedTokenImportResult.has_value());
    EXPECT_EQ(repeatedTokenImportResult.value(), completion);
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        EXPECT_EQ(declarations.declarationRevision(), tokenFirstRevision);
    }

    QueueSubmissionToken conflictingToken = token;
    ++conflictingToken.value;
    GpuExternalCompletionDesc conflictDesc = GpuExternalCompletionDesc();
    conflictDesc.setIdentity(s_GpuExtFrontierOwnedCompletion);
    conflictDesc.setMarkerLabel("Conflicting Token Reference");
    conflictDesc.setToken(conflictingToken);
    EXPECT_FALSE(graph.importExternalCompletion(conflictDesc).has_value());

    QueueSubmissionToken staleToken = token;
    ++staleToken.deviceGeneration;
    GpuExternalCompletionDesc staleDesc = GpuExternalCompletionDesc();
    staleDesc.setIdentity(s_TaskGraphCaseTestsTaskGraphStaleOwnedExternalCompletion);
    staleDesc.setMarkerLabel("Stale Owned External Completion");
    staleDesc.setToken(staleToken);
    EXPECT_FALSE(graph.importExternalCompletion(staleDesc).has_value());
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        EXPECT_FALSE(declarations.validForDeviceGeneration(staleToken.deviceGeneration));
    }

    QueueSubmissionToken missingPhysicalIdentity = token;
    missingPhysicalIdentity.physicalQueueIndex = u16.max;
    missingPhysicalIdentity.deviceGeneration = 0u;
    GpuExternalCompletionDesc missingPhysDesc = GpuExternalCompletionDesc();
    missingPhysDesc.setIdentity(s_GpuCaseTaskGraphUnidentifiedOwnedExternalCompletion);
    missingPhysDesc.setMarkerLabel("Unidentified Owned External Completion");
    missingPhysDesc.setToken(missingPhysicalIdentity);
    EXPECT_FALSE(graph.importExternalCompletion(missingPhysDesc).has_value());

    GpuExternalCompletionDesc metaDesc = GpuExternalCompletionDesc();
    metaDesc.setIdentity(s_GpuExtFrontierMetadataCompletion);
    metaDesc.setMarkerLabel("Metadata External Completion");
    const auto metadataCompletionResult = graph.importExternalCompletion(metaDesc);
    ASSERT_TRUE(metadataCompletionResult.has_value());
    const GpuExternalCompletionId metadataCompletion = metadataCompletionResult.value();
    ASSERT_TRUE(metadataCompletion.valid());
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        EXPECT_FALSE(declarations.externalCompletionAt(metadataCompletion.index).hasToken);
        EXPECT_FALSE(GpuExtFrontier_ExternalCompletionToken(declarations, metadataCompletion).has_value());
    }

    Array<GpuExternalCompletionId, 2> taskExternalDependencies = Array<GpuExternalCompletionId, 2>();
    taskExternalDependencies[0u] = completion;
    taskExternalDependencies[1u] = metadataCompletion;
    GpuTaskDesc consumerDesc = GpuTaskDesc();
    consumerDesc.setIdentity(s_GpuCaseTaskGraphOwnedExternalConsumer);
    consumerDesc.setMarkerLabel("Owned External Consumer");
    consumerDesc.setExternalDependencies(taskExternalDependencies);
    const auto consumerResult = graph.addTask(consumerDesc);
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(consumer.valid());

    Array<GpuPhysicalQueueInfo, 3> queues = Array<GpuPhysicalQueueInfo, 3>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    queues[2u] = DedicatedTransferQueue();
    const GpuPhysicalQueueTopology topology = GpuExtFrontier_MakeTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    {
        const GpuTaskGraphReadViews views = GpuTaskGraphReadViews(graph, compiledGraph);
        ASSERT_TRUE(views.valid());
        ASSERT_TRUE(analysis.validFor(views.declarations));
        ASSERT_TRUE(assignments.validFor(views.declarations, views.compiled));
    }

    Array<GpuPhysicalQueueInfo, 2> missingProducerQueues = Array<GpuPhysicalQueueInfo, 2>();
    missingProducerQueues[0u] = GraphicsQueue();
    missingProducerQueues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology missingProducerTopology = GpuExtFrontier_MakeTopology(missingProducerQueues);
    GpuTaskGraphAnalysis invalidTopologyAnalysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments invalidTopologyAssignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph invalidTopologyCompiledGraph = GpuCompiledGraph(testArena.arena);
    EXPECT_FALSE(Compile(invalidTopologyAnalysis, invalidTopologyAssignments, invalidTopologyCompiledGraph, operationScratchArena, graph, missingProducerTopology));

    Array<GpuPhysicalQueueInfo, 3> wrongProducerClassQueues = Array<GpuPhysicalQueueInfo, 3>();
    wrongProducerClassQueues[0u] = GraphicsQueue();
    wrongProducerClassQueues[1u] = DedicatedComputeQueue();
    wrongProducerClassQueues[2u] = DedicatedTransferQueue();
    wrongProducerClassQueues[2u].queueClass = CommandQueue::Compute;
    wrongProducerClassQueues[2u].capabilities = QueueCapabilities(GpuQueueCapability::Compute, GpuQueueCapability::Transfer);
    const GpuPhysicalQueueTopology wrongProducerClassTopology = GpuExtFrontier_MakeTopology(wrongProducerClassQueues);
    EXPECT_FALSE(Compile(invalidTopologyAnalysis, invalidTopologyAssignments, invalidTopologyCompiledGraph, operationScratchArena, graph, wrongProducerClassTopology));

    u64 metadataFirstRevision = 0u;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        metadataFirstRevision = declarations.declarationRevision();
    }
    GpuExternalCompletionDesc upgradeDesc = GpuExternalCompletionDesc();
    upgradeDesc.setIdentity(s_GpuExtFrontierMetadataCompletion);
    upgradeDesc.setMarkerLabel("Late Token Upgrade");
    upgradeDesc.setToken(token);
    const auto upgradedCompletionResult = graph.importExternalCompletion(upgradeDesc);
    ASSERT_TRUE(upgradedCompletionResult.has_value());
    EXPECT_EQ(upgradedCompletionResult.value(), metadataCompletion);
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);
        ASSERT_TRUE(declarations.valid());
        ASSERT_TRUE(compiledPlan.valid());
        EXPECT_NE(declarations.declarationRevision(), metadataFirstRevision);
        EXPECT_TRUE(declarations.externalCompletionAt(metadataCompletion.index).hasToken);
        const Optional<QueueSubmissionToken> upgradedToken = GpuExtFrontier_ExternalCompletionToken(declarations, metadataCompletion);
        ASSERT_TRUE(upgradedToken.has_value());
        EXPECT_EQ(upgradedToken.value().queue, token.queue);
        EXPECT_EQ(upgradedToken.value().value, token.value);
        EXPECT_EQ(upgradedToken.value().physicalQueueIndex, token.physicalQueueIndex);
        EXPECT_EQ(upgradedToken.value().deviceGeneration, token.deviceGeneration);
        EXPECT_FALSE(analysis.validFor(declarations));
        EXPECT_FALSE(assignments.validFor(declarations, compiledPlan));
        EXPECT_FALSE(compiledPlan.validFor(declarations));
    }

    u64 upgradedRevision = 0u;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        upgradedRevision = declarations.declarationRevision();
    }
    {
        GpuExternalCompletionDesc upMetaDesc = GpuExternalCompletionDesc();
        upMetaDesc.setIdentity(s_GpuExtFrontierMetadataCompletion);
        upMetaDesc.setMarkerLabel("Upgraded Metadata Reference");
        const auto gpuTaskAdmission = graph.importExternalCompletion(upMetaDesc);
        EXPECT_TRUE(gpuTaskAdmission.has_value());
        if(gpuTaskAdmission.has_value())
            EXPECT_EQ(gpuTaskAdmission.value(), metadataCompletion);
    }
    {
        GpuExternalCompletionDesc upTokDesc = GpuExternalCompletionDesc();
        upTokDesc.setIdentity(s_GpuExtFrontierMetadataCompletion);
        upTokDesc.setMarkerLabel("Upgraded Token Reference");
        upTokDesc.setToken(token);
        const auto secondGpuTaskAdmission = graph.importExternalCompletion(upTokDesc);
        EXPECT_TRUE(secondGpuTaskAdmission.has_value());
        if(secondGpuTaskAdmission.has_value())
            EXPECT_EQ(secondGpuTaskAdmission.value(), metadataCompletion);
    }
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        EXPECT_EQ(declarations.declarationRevision(), upgradedRevision);
    }

    Array<GpuPhysicalQueueInfo, 3> staleTopologyQueues = Array<GpuPhysicalQueueInfo, 3>();
    staleTopologyQueues[0u] = GraphicsQueue();
    staleTopologyQueues[1u] = DedicatedComputeQueue();
    staleTopologyQueues[2u] = DedicatedTransferQueue();
    for(mut GpuPhysicalQueueInfo staleQueue : staleTopologyQueues)
        ++staleQueue.id.deviceGeneration;
    const GpuPhysicalQueueTopology staleTopology = GpuExtFrontier_MakeTopology(staleTopologyQueues);
    GpuTaskGraphAnalysis staleAnalysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments staleAssignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph staleCompiledGraph = GpuCompiledGraph(testArena.arena);
    EXPECT_FALSE(Compile(staleAnalysis, staleAssignments, staleCompiledGraph, operationScratchArena, graph, staleTopology));
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    {
        const GpuTaskGraphReadViews views = GpuTaskGraphReadViews(graph, compiledGraph);
        ASSERT_TRUE(views.valid());
        EXPECT_TRUE(views.compiled.validFor(views.declarations));
        const Optional<QueueSubmissionToken> storedToken = GpuExtFrontier_ExternalCompletionToken(views.declarations, completion);
        const Optional<QueueSubmissionToken> upgradedToken = GpuExtFrontier_ExternalCompletionToken(views.declarations, metadataCompletion);
        ASSERT_TRUE(storedToken.has_value());
        ASSERT_TRUE(upgradedToken.has_value());
        EXPECT_EQ(storedToken.value().value, token.value);
        EXPECT_EQ(upgradedToken.value().value, token.value);
        EXPECT_TRUE(storedToken.value().matchesPhysicalQueue(token.physicalQueueIndex, token.deviceGeneration));
        EXPECT_TRUE(upgradedToken.value().matchesPhysicalQueue(token.physicalQueueIndex, token.deviceGeneration));
    }

    graph.reset();
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        EXPECT_FALSE(GpuExtFrontier_ExternalCompletionToken(declarations, completion).has_value());
    }
}

void VerifyGpuExtFrontier_ExportsExclusiveImportedResourceOwnershipToExternalQueue(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = GpuExtFrontier_MakeTopology(queues);

    GpuGraphResourceDesc resDesc = GpuGraphResourceDesc();
    resDesc.setIdentity(s_GpuCaseTaskGraphExternalFinalReleaseBuffer);
    resDesc.setMarkerLabel("External Final Release Buffer");
    resDesc.setType(GpuGraphResourceType::Buffer);
    resDesc.setInitialState(ResourceStates::Common);
    resDesc.setExternalFinalState(ResourceStates::ShaderResource);
    resDesc.setExternalFinalReleaseDestinationQueue(queues[1u].id);
    const auto bufferResult = graph.importResource(resDesc);
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    ASSERT_TRUE(buffer.valid());

    Array<GpuTaskResourceUse, 1> uses = Array<GpuTaskResourceUse, 1>();
    uses[0u].resource = buffer;
    uses[0u].range.bufferRange = BufferRange(32u, 64u);
    uses[0u].requiredState = ResourceStates::CopyDest;
    uses[0u].access = GpuTaskResourceAccess::Write;
    const Span<GpuTaskId> emptyDeps = Span<GpuTaskId>();
    const Span<GpuTaskResourceSetUse> emptySets = Span<GpuTaskResourceSetUse>();
    const Span<GpuTaskResourceVersionUse> emptyVersions = Span<GpuTaskResourceVersionUse>();
    const Span<GpuExternalCompletionId> emptyExternals = Span<GpuExternalCompletionId>();
    const auto taskResult = AddTask(
        s_GpuCaseTaskGraphExternalFinalReleaseWriter,
        "External Final Release Writer",
        emptyDeps,
        uses,
        emptySets,
        emptyVersions,
        emptyExternals,
        graph
    );
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    {
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);
        const GpuCompiledTaskView compiledTaskView = compiledPlan.findTask(task);
        const Optional<GpuCompiledTask> compiledTask = GpuExtFrontier_TaskPlan(compiledTaskView);
        ASSERT_TRUE(compiledTask.has_value());
        EXPECT_EQ(compiledTask.value().queue, queues[0u].id);

        const Optional<GpuCompiledExternalResourceExport> exportInfo = GpuExtFrontier_ExportPlan(compiledPlan.externalResourceExport(buffer));
        ASSERT_TRUE(exportInfo.has_value());
        EXPECT_EQ(exportInfo.value().resource, buffer);
        EXPECT_EQ(exportInfo.value().producerTask, task);
        EXPECT_EQ(exportInfo.value().sourceQueue, queues[0u].id);
        EXPECT_EQ(exportInfo.value().destinationQueue, queues[1u].id);
        EXPECT_EQ(exportInfo.value().finalState, ResourceStates::ShaderResource);

        const Span<GpuCompiledBarrier> barriers = GpuExtFrontier_EpilogueBarriers(compiledTaskView);
        ASSERT_EQ(barriers.size(), 2u);
        EXPECT_EQ(barriers[0u].type, GpuCompiledBarrierType::BufferStateExport);
        EXPECT_EQ(barriers[0u].resource, buffer);
        EXPECT_EQ(barriers[0u].before, ResourceStates::CopyDest);
        EXPECT_EQ(barriers[0u].after, ResourceStates::ShaderResource);
        EXPECT_EQ(barriers[0u].range.bufferRange, uses[0u].range.bufferRange);
        EXPECT_EQ(barriers[0u].sourceQueue, queues[0u].id);
        EXPECT_EQ(barriers[0u].destinationQueue, queues[0u].id);
        EXPECT_EQ(barriers[1u].type, GpuCompiledBarrierType::BufferOwnershipRelease);
        EXPECT_EQ(barriers[1u].resource, buffer);
        EXPECT_EQ(barriers[1u].before, ResourceStates::ShaderResource);
        EXPECT_EQ(barriers[1u].after, ResourceStates::ShaderResource);
        EXPECT_EQ(barriers[1u].range.bufferRange, uses[0u].range.bufferRange);
        EXPECT_EQ(barriers[1u].sourceQueue, queues[0u].id);
        EXPECT_EQ(barriers[1u].destinationQueue, queues[1u].id);

        const GpuTaskGraphPhysicalQueueCompileStatistics sourceQueueCompileStatistics = compiledPlan.physicalQueueCompileStatistics(queues[0u].id);
        const GpuTaskGraphPhysicalQueueCompileStatistics destinationQueueCompileStatistics = compiledPlan.physicalQueueCompileStatistics(queues[1u].id);
        ASSERT_TRUE(sourceQueueCompileStatistics.valid());
        ASSERT_TRUE(destinationQueueCompileStatistics.valid());
        EXPECT_EQ(sourceQueueCompileStatistics.ownershipReleaseBarrierCount, 1u);
        EXPECT_EQ(sourceQueueCompileStatistics.ownershipAcquireBarrierCount, 0u);
        EXPECT_EQ(destinationQueueCompileStatistics.ownershipReleaseBarrierCount, 0u);
        EXPECT_EQ(destinationQueueCompileStatistics.ownershipAcquireBarrierCount, 0u);

        ASSERT_EQ(compiledPlan.logicalOwnershipTransferCount(), 1u);
        ASSERT_TRUE(GpuExtFrontier_HasTransfersPtr(compiledPlan));
        EXPECT_TRUE(GpuExtFrontier_FirstTransferMatchesSliceStart(compiledPlan));
        EXPECT_FALSE(GpuExtFrontier_OwnershipTransferAt(compiledPlan, 1u).has_value());
        const Optional<GpuCompiledOwnershipTransfer> transferOpt = GpuExtFrontier_OwnershipTransferAt(compiledPlan, 0u);
        ASSERT_TRUE(transferOpt.has_value());
        const GpuCompiledOwnershipTransfer ownershipTransfer = transferOpt.value();
        EXPECT_TRUE(ownershipTransfer.valid());
        EXPECT_EQ(ownershipTransfer.resource, buffer);
        EXPECT_EQ(ownershipTransfer.resourceIdentity, s_GpuCaseTaskGraphExternalFinalReleaseBuffer);
        EXPECT_EQ(ownershipTransfer.range.bufferRange, uses[0u].range.bufferRange);
        EXPECT_EQ(ownershipTransfer.sourceTask, task);
        EXPECT_FALSE(ownershipTransfer.destinationTask.valid());
        EXPECT_EQ(ownershipTransfer.sourcePacket, compiledTask.value().packet);
        EXPECT_FALSE(ownershipTransfer.destinationPacket.valid());
        EXPECT_EQ(ownershipTransfer.sourceQueue, queues[0u].id);
        EXPECT_EQ(ownershipTransfer.destinationQueue, queues[1u].id);
        EXPECT_EQ(ownershipTransfer.sourceQueueFamilyIndex, queues[0u].familyIndex);
        EXPECT_EQ(ownershipTransfer.destinationQueueFamilyIndex, queues[1u].familyIndex);
        EXPECT_EQ(ownershipTransfer.declaredQueueSharing, ResourceQueueSharing::Exclusive);
        EXPECT_EQ(ownershipTransfer.resourceType, GpuGraphResourceType::Buffer);
        EXPECT_EQ(ownershipTransfer.route, GpuOwnershipTransferRoute::ExternalExport);
        EXPECT_TRUE(ownershipTransfer.concurrentSharingCouldAvoid);

        const GpuTaskGraphCompileStatistics ownershipStatistics = compiledPlan.compileStatistics();
        ASSERT_TRUE(ownershipStatistics.valid());
        EXPECT_EQ(ownershipStatistics.logicalOwnershipTransferCount, 1u);
        EXPECT_EQ(ownershipStatistics.logicalOwnershipTransferSignatureCount, 1u);
        EXPECT_EQ(ownershipStatistics.repeatedOwnershipTransferSignatureCount, 0u);
        EXPECT_EQ(ownershipStatistics.concurrentSharingCouldAvoidTransferCount, 1u);
        EXPECT_EQ(ownershipStatistics.concurrentSharingAdviceResourceCount, 0u);
        EXPECT_EQ(ownershipStatistics.logicalOwnershipTransferCountByRoute[cast<usize>(GpuOwnershipTransferRoute::ExternalExport)], 1u);
        EXPECT_EQ(sourceQueueCompileStatistics.outgoingLogicalOwnershipTransferCount, 1u);
        EXPECT_EQ(sourceQueueCompileStatistics.incomingLogicalOwnershipTransferCount, 0u);
        EXPECT_EQ(destinationQueueCompileStatistics.outgoingLogicalOwnershipTransferCount, 0u);
        EXPECT_EQ(destinationQueueCompileStatistics.incomingLogicalOwnershipTransferCount, 1u);
    }

    Array<GpuPhysicalQueueInfo, 2> sameFamilyQueues = Array<GpuPhysicalQueueInfo, 2>();
    sameFamilyQueues[0u] = queues[0u];
    sameFamilyQueues[1u] = queues[1u];
    sameFamilyQueues[1u].familyIndex = sameFamilyQueues[0u].familyIndex;
    sameFamilyQueues[1u].queueIndex = 1u;
    const GpuPhysicalQueueTopology sameFamilyTopology = GpuExtFrontier_MakeTopology(sameFamilyQueues);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, sameFamilyTopology));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    EXPECT_EQ(compiledPlan.logicalOwnershipTransferCount(), 0u);
    EXPECT_FALSE(GpuExtFrontier_HasTransfersPtr(compiledPlan));
    EXPECT_FALSE(GpuExtFrontier_OwnershipTransferAt(compiledPlan, 0u).has_value());
    EXPECT_EQ(compiledPlan.compileStatistics().logicalOwnershipTransferCount, 0u);
}

void VerifyGpuExtFrontier_ExportsExternalFinalOwnershipWithMultipleTerminalPackets(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = GpuExtFrontier_MakeTopology(queues);

    GpuGraphResourceDesc texDesc = GpuGraphResourceDesc();
    texDesc.setIdentity(s_GpuCaseTaskGraphExternalFinalMultiplePackets);
    texDesc.setMarkerLabel("External Final Multiple Packets");
    texDesc.setType(GpuGraphResourceType::Texture);
    texDesc.setInitialState(ResourceStates::Common);
    texDesc.setExternalFinalState(ResourceStates::ShaderResource);
    texDesc.setExternalFinalReleaseDestinationQueue(queues[1u].id);
    const auto textureResult = graph.importResource(texDesc);
    ASSERT_TRUE(textureResult.has_value());
    const GpuGraphResourceId texture = textureResult.value();
    ASSERT_TRUE(texture.valid());

    Array<GpuTaskResourceUse, 1> graphicsUses = Array<GpuTaskResourceUse, 1>();
    graphicsUses[0u].resource = texture;
    graphicsUses[0u].range.textureSubresources = TextureSubresourceSet(0u, 1u, 0u, 1u);
    graphicsUses[0u].requiredState = ResourceStates::CopyDest;
    graphicsUses[0u].access = GpuTaskResourceAccess::Write;

    Array<GpuTaskResourceUse, 1> computeUses = Array<GpuTaskResourceUse, 1>();
    computeUses[0u].resource = texture;
    computeUses[0u].range.textureSubresources = TextureSubresourceSet(1u, 1u, 0u, 1u);
    computeUses[0u].requiredState = ResourceStates::UnorderedAccess;
    computeUses[0u].access = GpuTaskResourceAccess::Write;

    GpuTaskDesc graphicsDesc = GpuTaskDesc();
    graphicsDesc.setIdentity(s_GpuCaseTaskGraphExternalFinalMultipleGraphics);
    graphicsDesc.setMarkerLabel("External Final Multiple Graphics");
    graphicsDesc.setResourceUses(graphicsUses);
    GpuTaskDesc computeDesc = GpuTaskDesc();
    computeDesc.setIdentity(s_GpuCaseTaskGraphExternalFinalMultipleCompute);
    computeDesc.setMarkerLabel("External Final Multiple Compute");
    computeDesc.setResourceUses(computeUses);

    const auto graphicsTaskResult = graph.addTask(graphicsDesc, GraphicsCommands());
    ASSERT_TRUE(graphicsTaskResult.has_value());
    const GpuTaskId graphicsTask = graphicsTaskResult.value();
    const auto computeTaskResult = graph.addTask(computeDesc, ComputeCommands());
    ASSERT_TRUE(computeTaskResult.has_value());
    const GpuTaskId computeTask = computeTaskResult.value();
    ASSERT_TRUE(graphicsTask.valid());
    ASSERT_TRUE(computeTask.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    const GpuCompiledExternalResourceExportView exportView = compiledPlan.externalResourceExport(texture);
    const Optional<GpuCompiledExternalResourceExport> exportInfo = GpuExtFrontier_ExportPlan(exportView);
    ASSERT_TRUE(exportInfo.has_value());
    EXPECT_EQ(exportInfo.value().resource, texture);
    EXPECT_EQ(exportInfo.value().destinationQueue, queues[1u].id);
    EXPECT_EQ(exportInfo.value().finalState, ResourceStates::ShaderResource);
    // No singular semantic producer exists: each mip's terminal range belongs to a different packet and queue.
    EXPECT_FALSE(exportInfo.value().producerTask.valid());
    EXPECT_FALSE(exportInfo.value().sourceQueue.valid());
    const Span<GpuCompiledExternalResourceExportSource> sources = GpuExtFrontier_ExportSources(exportView);
    ASSERT_EQ(sources.size(), 2u);
    EXPECT_EQ(sources[0u].producerTask, graphicsTask);
    EXPECT_EQ(sources[0u].sourceQueue, queues[0u].id);
    EXPECT_EQ(sources[0u].range.textureSubresources, graphicsUses[0u].range.textureSubresources);
    EXPECT_EQ(sources[1u].producerTask, computeTask);
    EXPECT_EQ(sources[1u].sourceQueue, queues[1u].id);
    EXPECT_EQ(sources[1u].range.textureSubresources, computeUses[0u].range.textureSubresources);

    const GpuCompiledTaskView graphicsView = compiledPlan.findTask(graphicsTask);
    const GpuCompiledTaskView computeView = compiledPlan.findTask(computeTask);
    const Optional<GpuCompiledTask> compiledGraphics = GpuExtFrontier_TaskPlan(graphicsView);
    const Optional<GpuCompiledTask> compiledCompute = GpuExtFrontier_TaskPlan(computeView);
    ASSERT_TRUE(compiledGraphics.has_value());
    ASSERT_TRUE(compiledCompute.has_value());
    EXPECT_EQ(compiledGraphics.value().queue, queues[0u].id);
    EXPECT_EQ(compiledCompute.value().queue, queues[1u].id);
    const Span<GpuCompiledBarrier> graphicsBarriers = GpuExtFrontier_EpilogueBarriers(graphicsView);
    const Span<GpuCompiledBarrier> computeBarriers = GpuExtFrontier_EpilogueBarriers(computeView);
    ASSERT_EQ(graphicsBarriers.size(), 2u);
    ASSERT_EQ(computeBarriers.size(), 1u);
    EXPECT_EQ(graphicsBarriers[0u].type, GpuCompiledBarrierType::TextureStateExport);
    EXPECT_EQ(graphicsBarriers[1u].type, GpuCompiledBarrierType::TextureOwnershipRelease);
    EXPECT_EQ(graphicsBarriers[1u].destinationQueue, queues[1u].id);
    EXPECT_EQ(computeBarriers[0u].type, GpuCompiledBarrierType::TextureStateExport);

    ASSERT_EQ(compiledPlan.logicalOwnershipTransferCount(), 1u);
    ASSERT_TRUE(GpuExtFrontier_HasTransfersPtr(compiledPlan));
    EXPECT_TRUE(GpuExtFrontier_FirstTransferMatchesSliceStart(compiledPlan));
    EXPECT_FALSE(GpuExtFrontier_OwnershipTransferAt(compiledPlan, 1u).has_value());
    const Optional<GpuCompiledOwnershipTransfer> transferOpt = GpuExtFrontier_OwnershipTransferAt(compiledPlan, 0u);
    ASSERT_TRUE(transferOpt.has_value());
    const GpuCompiledOwnershipTransfer ownershipTransfer = transferOpt.value();
    EXPECT_TRUE(ownershipTransfer.valid());
    EXPECT_EQ(ownershipTransfer.resource, texture);
    EXPECT_EQ(ownershipTransfer.resourceIdentity, s_GpuCaseTaskGraphExternalFinalMultiplePackets);
    EXPECT_EQ(ownershipTransfer.range.textureSubresources, graphicsUses[0u].range.textureSubresources);
    EXPECT_NE(ownershipTransfer.range.textureSubresources, computeUses[0u].range.textureSubresources);
    EXPECT_EQ(ownershipTransfer.sourceTask, graphicsTask);
    EXPECT_FALSE(ownershipTransfer.destinationTask.valid());
    EXPECT_EQ(ownershipTransfer.sourcePacket, compiledGraphics.value().packet);
    EXPECT_FALSE(ownershipTransfer.destinationPacket.valid());
    EXPECT_EQ(ownershipTransfer.sourceQueue, queues[0u].id);
    EXPECT_EQ(ownershipTransfer.destinationQueue, queues[1u].id);
    EXPECT_EQ(ownershipTransfer.sourceQueueFamilyIndex, queues[0u].familyIndex);
    EXPECT_EQ(ownershipTransfer.destinationQueueFamilyIndex, queues[1u].familyIndex);
    EXPECT_EQ(ownershipTransfer.declaredQueueSharing, ResourceQueueSharing::Exclusive);
    EXPECT_EQ(ownershipTransfer.resourceType, GpuGraphResourceType::Texture);
    EXPECT_EQ(ownershipTransfer.route, GpuOwnershipTransferRoute::ExternalExport);
    EXPECT_TRUE(ownershipTransfer.concurrentSharingCouldAvoid);
    EXPECT_EQ(compiledPlan.compileStatistics().logicalOwnershipTransferCount, 1u);
}

void VerifyGpuExtFrontier_OrdersExternalFinalTransitionAfterOverlappingConcurrentReaders(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskResourceRange range = GpuTaskResourceRange();
    range.textureSubresources = TextureSubresourceSet(0u, 1u, 0u, 1u);
    const auto pairResult = AddExternalFinalReadPair(
        graph,
        GpuGraphResourceType::Texture,
        range,
        range,
        ResourceStates::ShaderResource,
        ResourceStates::CopySource,
        ResourceQueueSharing::GraphicsAndAsyncCompute,
        false,
        false,
        GpuPhysicalQueueId()
    );
    ASSERT_TRUE(pairResult.has_value());
    const ExternalFinalReadPair pair = pairResult.value();
    ASSERT_TRUE(pair.resource.valid());
    ASSERT_TRUE(pair.earlierReader.valid());
    ASSERT_TRUE(pair.finalizingReader.valid());

    TwoQueueCompile twoQueueCompile = GpuExtFrontier_MakeTwoQueueCompile(testArena);
    ASSERT_TRUE(twoQueueCompile.compile(graph));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(twoQueueCompile.compiledGraph);
    EXPECT_FALSE(GpuExtFrontier_HasEdge(twoQueueCompile.analysis, pair.earlierReader, pair.finalizingReader));

    const GpuSubmissionPacketId earlierPacket = compiledPlan.packetForTask(pair.earlierReader);
    const GpuSubmissionPacketId finalizingPacket = compiledPlan.packetForTask(pair.finalizingReader);
    ASSERT_TRUE(earlierPacket.valid());
    ASSERT_TRUE(finalizingPacket.valid());
    ASSERT_NE(earlierPacket, finalizingPacket);
    const GpuCompiledTaskView finalizingView = compiledPlan.findTask(pair.finalizingReader);
    const Optional<GpuCompiledTask> finalizingTask = GpuExtFrontier_TaskPlan(finalizingView);
    ASSERT_TRUE(finalizingTask.has_value());
    EXPECT_EQ(finalizingTask.value().prologueStateSeedCount, 0u);

    const Span<GpuPacketDependency> dependencies = GpuExtFrontier_PacketDependencies(compiledPlan.packet(finalizingPacket));
    ASSERT_EQ(dependencies.size(), 1u);
    EXPECT_EQ(dependencies[0u].producer, earlierPacket);
    EXPECT_EQ(dependencies[0u].consumer, finalizingPacket);

    const Span<GpuCompiledBarrier> barriers = GpuExtFrontier_EpilogueBarriers(finalizingView);
    ASSERT_EQ(barriers.size(), 1u);
    EXPECT_EQ(barriers[0u].type, GpuCompiledBarrierType::TextureStateExport);
    EXPECT_EQ(barriers[0u].before, ResourceStates::ShaderResource);
    EXPECT_EQ(barriers[0u].after, ResourceStates::CopySource);
}

void VerifyGpuExtFrontier_RejectsUnpublishableExternalFinalStateContracts(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);

    GpuGraphResourceDesc unsupportedDesc = GpuGraphResourceDesc();
    unsupportedDesc.setIdentity(s_GpuCaseTaskGraphExternalFinalHazardDomain);
    unsupportedDesc.setMarkerLabel("External Final Hazard Domain");
    unsupportedDesc.setType(GpuGraphResourceType::HazardDomain);
    unsupportedDesc.setExternalFinalState(ResourceStates::ShaderResource);
    EXPECT_FALSE(graph.importResource(unsupportedDesc).has_value());

    GpuGraphResourceDesc destinationWithoutFinalState = GpuGraphResourceDesc();
    destinationWithoutFinalState.setIdentity(s_GpuCaseTaskGraphExternalFinalReleaseWithoutState);
    destinationWithoutFinalState.setMarkerLabel("External Final Release Without State");
    destinationWithoutFinalState.setType(GpuGraphResourceType::Buffer);
    destinationWithoutFinalState.setInitialState(ResourceStates::Common);
    destinationWithoutFinalState.setExternalFinalReleaseDestinationQueue(DedicatedComputeQueue().id);
    EXPECT_FALSE(graph.importResource(destinationWithoutFinalState).has_value());

    GpuGraphResourceDesc untouchedDesc = GpuGraphResourceDesc();
    untouchedDesc.setIdentity(s_GpuCaseTaskGraphExternalFinalUntouched);
    untouchedDesc.setMarkerLabel("External Final Untouched");
    untouchedDesc.setType(GpuGraphResourceType::Buffer);
    untouchedDesc.setInitialState(ResourceStates::Common);
    untouchedDesc.setExternalFinalState(ResourceStates::ShaderResource);
    {
        const auto gpuTaskAdmission = graph.importResource(untouchedDesc);
        EXPECT_TRUE(gpuTaskAdmission.has_value());
        if(gpuTaskAdmission.has_value())
            EXPECT_TRUE(gpuTaskAdmission.value().valid());
    }
    {
        const auto secondGpuTaskAdmission = GpuExtFrontier_AddEmptyTask(s_GpuCaseTaskGraphExternalFinalUnrelated, "External Final Unrelated", graph);
        ASSERT_TRUE(secondGpuTaskAdmission.has_value());
        ASSERT_TRUE(secondGpuTaskAdmission.value().valid());
    }

    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = GpuExtFrontier_MakeTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    EXPECT_FALSE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);
    EXPECT_FALSE(compiledPlan.valid());
}

void VerifyGpuExtFrontier_KeepsSameStateExternalExportConcurrentReadersIndependent(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskResourceRange range = GpuTaskResourceRange();
    range.textureSubresources = TextureSubresourceSet(0u, 1u, 0u, 1u);
    const auto pairResult = AddExternalFinalReadPair(
        graph,
        GpuGraphResourceType::Texture,
        range,
        range,
        ResourceStates::ShaderResource,
        ResourceStates::ShaderResource,
        ResourceQueueSharing::GraphicsAndAsyncCompute,
        false,
        false,
        GpuPhysicalQueueId()
    );
    ASSERT_TRUE(pairResult.has_value());
    const ExternalFinalReadPair pair = pairResult.value();
    ASSERT_TRUE(pair.resource.valid());
    ASSERT_TRUE(pair.earlierReader.valid());
    ASSERT_TRUE(pair.finalizingReader.valid());

    TwoQueueCompile twoQueueCompile = GpuExtFrontier_MakeTwoQueueCompile(testArena);
    ASSERT_TRUE(twoQueueCompile.compile(graph));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(twoQueueCompile.compiledGraph);
    EXPECT_FALSE(GpuExtFrontier_HasEdge(twoQueueCompile.analysis, pair.earlierReader, pair.finalizingReader));

    const GpuSubmissionPacketId earlierPacket = compiledPlan.packetForTask(pair.earlierReader);
    const GpuSubmissionPacketId finalizingPacket = compiledPlan.packetForTask(pair.finalizingReader);
    ASSERT_TRUE(earlierPacket.valid());
    ASSERT_TRUE(finalizingPacket.valid());
    ASSERT_NE(earlierPacket, finalizingPacket);
    const Optional<GpuSubmissionPacket> earlierPacketPlan = GpuExtFrontier_PacketPlan(compiledPlan.packet(earlierPacket));
    const Optional<GpuSubmissionPacket> finalizingPacketPlan = GpuExtFrontier_PacketPlan(compiledPlan.packet(finalizingPacket));
    ASSERT_TRUE(earlierPacketPlan.has_value());
    ASSERT_TRUE(finalizingPacketPlan.has_value());
    EXPECT_EQ(earlierPacketPlan.value().dependencyCount, 0u);
    EXPECT_EQ(finalizingPacketPlan.value().dependencyCount, 0u);

    const Span<GpuCompiledBarrier> barriers = GpuExtFrontier_EpilogueBarriers(compiledPlan.findTask(pair.finalizingReader));
    ASSERT_EQ(barriers.size(), 1u);
    EXPECT_EQ(barriers[0u].before, ResourceStates::ShaderResource);
    EXPECT_EQ(barriers[0u].after, ResourceStates::ShaderResource);
}

void VerifyGpuExtFrontier_KeepsDisjointExternalFinalTextureFragmentsIndependent(){
