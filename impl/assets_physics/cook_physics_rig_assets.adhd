class FractureCookEntry{
    public Name virtualPath = s_NameNone;
    public FractureCollection collection;
}

class SoftBodyCookEntry{
    public Name virtualPath = s_NameNone;
    public SoftBody softBody;
}

class RagdollCookEntry{
    public Name virtualPath = s_NameNone;
    public RagdollAssetData ragdoll;
}

class ArticulationCookEntry{
    public Name virtualPath = s_NameNone;
    public ArticulationAssetData articulation;
}

class VehicleCookEntry{
    public Name virtualPath = s_NameNone;
    public VehicleAssetData vehicle;
}

class RigSkeletonLoadResult{
    public Vector<SkeletonCookJoint> cookJoints;
    public Vector<SkeletonJoint> joints;
    public HashMap<Name, u32> jointIndices;
}

class SoftBodyTetBoundaryFace{
    public u32 i0 = 0u;
    public u32 i1 = 0u;
    public u32 i2 = 0u;
    public u32 opp = 0u;
    public u32 count = 0u;
}


