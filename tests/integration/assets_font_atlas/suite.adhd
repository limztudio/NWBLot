inline constexpr auto s_ReportOnly = Core::Common::LoggerBreakPolicy::ReportOnly;
inline constexpr f32 s_InfinityF32 = Limit<f32>::s_Infinity;
inline constexpr TStringView s_ErrEmptyVirtualPath = NWB_TEXT("FontAtlas::validatePayload failed: virtual path is empty");
inline constexpr TStringView s_ErrPixelHashMismatch = NWB_TEXT("pixel content hash mismatch");

inline constexpr Array<u8, 24u> s_DefaultKernBytes = {
    0x00u, 0x00u, 0x00u, 0x01u, 0x00u, 0x00u, 0x00u, 0x14u,
    0x00u, 0x01u, 0x00u, 0x01u, 0x00u, 0x06u, 0x00u, 0x00u,
    0x00u, 0x00u, 0x00u, 0x00u, 0x00u, 0x01u, 0xffu, 0xecu,
};

inline constexpr Array<usize, 15u> s_CorruptAtlasOffsets = {
    0u,
    4u,
    8u,
    12u,
    112u,
    120u,
    136u,
    152u,
    156u,
    160u,
    s_FontAtlasBinaryHeaderBytes + 48u,
    s_FontAtlasBinaryHeaderBytes + 5u * s_FontAtlasBinaryGlyphBytes,
    s_FontAtlasBinaryHeaderBytes + 5u * s_FontAtlasBinaryGlyphBytes + 4u,
    s_FontAtlasBinaryHeaderBytes + 5u * s_FontAtlasBinaryGlyphBytes + 8u,
    s_FontAtlasBinaryHeaderBytes + 5u * s_FontAtlasBinaryGlyphBytes + 12u,
};


