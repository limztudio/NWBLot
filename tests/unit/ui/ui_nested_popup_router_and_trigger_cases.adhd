void VerifyUiNestedPopupLoanTests_ChildSourceCallbackCannotMutateTheParentComboAfterItsFieldPaint(mut UiNestedPopupLoanTests self){
    ASSERT_TRUE(self.acceptBase(1u));
    ASSERT_TRUE(self.beginParent(2u));
    ASSERT_TRUE(self.m_builder.comboBox(s_UiNestedPopupRouterComboKey, self.m_comboSource, self.m_combo, MakeUiNestedPopupRouterComboOptions()).valid);
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiNestedPopupRouterChildKey, self.m_child, MakeNestedChildPopupOptions()));
    ASSERT_TRUE(self.m_builder.virtualList(s_UiNestedPopupRouterListKey, self.m_childSource, self.m_childList, MakeLargeLoanListOptions()).valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    const u64 inputGeneration = self.m_combo.inputGeneration();
    self.m_childSource.armSelectComboOnText(self.m_combo);
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_EQ(self.m_combo.selectedKey(), 4u);
    EXPECT_NE(self.m_combo.inputGeneration(), inputGeneration);
    EXPECT_GT(self.m_combo.bounds().width, 0.0f);
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
}

void VerifyUiNestedPopupLoanTests_ParentSourceCallbackCannotMutateTheEndedChildSearchQueryLoan(mut UiNestedPopupLoanTests self){
    ASSERT_TRUE(self.acceptBase(1u));
    self.m_search.combo().open();
    ASSERT_TRUE(self.beginParent(2u));
    ASSERT_TRUE(self.m_builder.virtualList(s_UiNestedPopupRouterListKey, self.m_parentSource, self.m_parentList, MakeLargeLoanListOptions()).valid);
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiNestedPopupRouterChildKey, self.m_child, MakeNestedChildPopupOptions()));
    SearchComboOptions searchOptions = SearchComboOptions();
    searchOptions.combo = MakeUiNestedPopupRouterComboOptions();
    ASSERT_TRUE(self.m_builder.searchComboBox("search", self.m_searchSource, self.m_search, searchOptions).combo.valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    const u64 externalRevision = self.m_search.query().externalRevision();
    self.m_parentSource.armQueryOnText(self.m_search.query());
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_EQ(self.m_search.query().text(), s_UiNestedPopupRouterCallbackQuery);
    EXPECT_GT(self.m_search.query().externalRevision(), externalRevision);
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
}

void VerifyUiNestedPopupLoanTests_ChildSourceCallbackCannotCloseTheParentContextMenuAndPublishTheFrame(mut UiNestedPopupLoanTests self){
    ASSERT_TRUE(self.acceptBase(1u));
    ASSERT_TRUE(self.m_menu.open(MakeUiNestedPopupRouterRect(80.0f, 120.0f, 0.0f, 0.0f)));
    ASSERT_TRUE(self.beginParent(2u));
    EXPECT_FALSE(self.m_builder.button(s_UiNestedPopupRouterAnchorKey, "Commands"));
    ASSERT_TRUE(self.m_builder.contextMenu("menu", s_UiNestedPopupRouterAnchorKey, self.m_menuSource, self.m_menu).valid);
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiNestedPopupRouterChildKey, self.m_child, MakeNestedChildPopupOptions()));
    ASSERT_TRUE(self.m_builder.virtualList(s_UiNestedPopupRouterListKey, self.m_childSource, self.m_childList, MakeLargeLoanListOptions()).valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    const u64 revision = self.m_menu.revision();
    self.m_childSource.armCloseMenuOnText(self.m_menu);
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_FALSE(self.m_menu.isOpen());
    EXPECT_GT(self.m_menu.revision(), revision);
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
}

void VerifyUiNestedPopupLoanTests_ClosingTheParentBeforeOuterEndSuppressesEveryDescendantSourceAndQueryPublication(mut UiNestedPopupLoanTests self){
    self.m_combo.open();
    self.m_search.combo().open();
    ASSERT_TRUE(self.m_menu.open(MakeUiNestedPopupRouterRect(510.0f, 280.0f, 0.0f, 0.0f)));
    ASSERT_TRUE(self.declareChildCompounds(1u));
    self.resetChildCounters();
    self.m_parent.close();
    ASSERT_TRUE(self.m_builder.endPopup());
    self.expectNoChildCallbacks();
    ASSERT_TRUE(self.finishRoot());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    EXPECT_TRUE(snapshot.commands().empty());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    EXPECT_TRUE(self.m_context.input().targets().empty());
    EXPECT_FALSE(self.m_context.input().hasPopup());
}

void VerifyUiNestedPopupLoanTests_ReopeningTheParentBeforeOuterEndSuppressesItsOldDescendantLoans(mut UiNestedPopupLoanTests self){
    self.m_combo.open();
    self.m_search.combo().open();
    ASSERT_TRUE(self.m_menu.open(MakeUiNestedPopupRouterRect(510.0f, 280.0f, 0.0f, 0.0f)));
    ASSERT_TRUE(self.declareChildCompounds(1u));
    self.resetChildCounters();
    const u64 openGeneration = self.m_parent.openGeneration();
    self.m_parent.close();
    self.m_parent.open();
    EXPECT_NE(self.m_parent.openGeneration(), openGeneration);
    ASSERT_TRUE(self.m_builder.endPopup());
    self.expectNoChildCallbacks();
    EXPECT_TRUE(self.m_parent.isOpen());
    ASSERT_TRUE(self.finishRoot());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    EXPECT_TRUE(snapshot.commands().empty());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    EXPECT_TRUE(self.m_context.input().targets().empty());
    EXPECT_FALSE(self.m_context.input().hasPopup());
}

void VerifyUiNestedPopupLoanTests_ClosingTheEndedChildSkipsItsCallbacksAndKeepsParentControlsPainted(mut UiNestedPopupLoanTests self){
    ASSERT_TRUE(self.beginParent(1u));
    EXPECT_FALSE(self.m_builder.button("before", "Parent before"));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiNestedPopupRouterChildKey, self.m_child, MakeNestedChildPopupOptions()));
    ASSERT_TRUE(self.m_builder.virtualList(s_UiNestedPopupRouterListKey, self.m_childSource, self.m_childList, MakeLargeLoanListOptions()).valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    self.m_childSource.resetAllCounters();
    self.m_child.close();
    EXPECT_FALSE(self.m_builder.button("after", "Parent after"));
    ASSERT_TRUE(self.m_builder.endPopup());
    EXPECT_EQ(self.m_childSource.metadataCalls, 0u);
    EXPECT_EQ(self.m_childSource.textCalls, 0u);
    ASSERT_TRUE(self.finishRoot());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const WidgetId parent = RequireUiWidgetId(RequireUiRootId(self.m_root), s_UiNestedPopupRouterParentKey);
    EXPECT_TRUE(self.hasTarget(RequireUiWidgetId(parent, "before")));
    EXPECT_TRUE(self.hasTarget(RequireUiWidgetId(parent, "after")));
    EXPECT_FALSE(self.hasTarget(RequireUiWidgetId(parent, s_UiNestedPopupRouterChildKey)));
}

void VerifyUiNestedPopupLoanTests_ReopeningTheEndedChildRetiresItsOldBodyBeforeSourceCallbacks(mut UiNestedPopupLoanTests self){
    ASSERT_TRUE(self.beginParent(1u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiNestedPopupRouterChildKey, self.m_child, MakeNestedChildPopupOptions()));
    ASSERT_TRUE(self.m_builder.virtualList(s_UiNestedPopupRouterListKey, self.m_childSource, self.m_childList, MakeLargeLoanListOptions()).valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    self.m_childSource.resetAllCounters();
    const u64 openGeneration = self.m_child.openGeneration();
    self.m_child.close();
    self.m_child.open();
    EXPECT_NE(self.m_child.openGeneration(), openGeneration);
    EXPECT_FALSE(self.m_builder.button("after", "Parent after"));
    ASSERT_TRUE(self.m_builder.endPopup());
    EXPECT_EQ(self.m_childSource.metadataCalls, 0u);
    EXPECT_EQ(self.m_childSource.textCalls, 0u);
    EXPECT_TRUE(self.m_child.isOpen());
    ASSERT_TRUE(self.finishRoot());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const WidgetId parent = RequireUiWidgetId(RequireUiRootId(self.m_root), s_UiNestedPopupRouterParentKey);
    EXPECT_TRUE(self.hasTarget(RequireUiWidgetId(parent, "after")));
    EXPECT_FALSE(self.hasTarget(RequireUiWidgetId(parent, s_UiNestedPopupRouterChildKey)));
}

void VerifyUiNestedPopupLoanTests_ParentFirstRowClosingItsPopupRejectsBeforeAnyDescendantTextCallback(mut UiNestedPopupLoanTests self){
    ASSERT_TRUE(self.acceptLists(1u));
    ASSERT_TRUE(self.declareLists(2u));
    self.m_parentSource.resetAllCounters();
    self.m_childSource.resetAllCounters();
    self.m_parentSource.armClosePopupOnText(self.m_parent);
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_FALSE(self.m_parent.isOpen());
    EXPECT_FALSE(self.m_parentSource.hasClosePopupOnText());
    EXPECT_EQ(self.m_parentSource.textCalls, 1u);
    EXPECT_EQ(self.m_childSource.textCalls, 0u);
    EXPECT_EQ(self.m_childSource.metadataCalls, 0u);
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
}

void VerifyUiNestedPopupLoanTests_ChildFirstRowReopeningItsAncestorRejectsBeforeLaterRowsOrSiblingCallbacks(mut UiNestedPopupLoanTests self){
    ASSERT_TRUE(self.acceptLists(1u));
    ASSERT_TRUE(self.declareLists(2u));
    PopupState sibling = PopupState();
    sibling.open();
    UiNestedPopupLoanMutationSource siblingSource = UiNestedPopupLoanMutationSource(2301u);
    ListState siblingList = ListState();
    ASSERT_TRUE(self.m_builder.beginPopup("sibling", sibling, MakeNestedChildPopupOptions()));
    ASSERT_TRUE(self.m_builder.virtualList(s_UiNestedPopupRouterListKey, siblingSource, siblingList, MakeLargeLoanListOptions()).valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    self.m_parentSource.resetAllCounters();
    self.m_childSource.resetAllCounters();
    siblingSource.resetAllCounters();
    const u64 openGeneration = self.m_parent.openGeneration();
    self.m_childSource.armReopenPopupOnText(self.m_parent);
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_TRUE(self.m_parent.isOpen());
    EXPECT_NE(self.m_parent.openGeneration(), openGeneration);
    EXPECT_FALSE(self.m_childSource.hasReopenPopupOnText());
    EXPECT_GT(self.m_parentSource.textCalls, 0u);
    EXPECT_EQ(self.m_childSource.textCalls, 1u);
    EXPECT_EQ(siblingSource.textCalls, 0u);
    EXPECT_EQ(siblingSource.metadataCalls, 0u);
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyUiNestedPopupReentryTests_ChildFirstRowResetRejectsWithoutClearingBorrowedFrames(mut UiNestedPopupReentryTests self){
    ASSERT_TRUE(self.acceptBase());
    const UiNestedPopupReentryAcceptedFrame frame = self.accepted();
    ASSERT_GT(frame.count, 0u);
    ASSERT_TRUE(self.beginParent());
    ASSERT_TRUE(self.declareChild());
    ASSERT_TRUE(self.declareSibling());
    const u64 generation = self.m_childList.inputGeneration();
    const u64 parentOpening = self.m_parent.openGeneration();
    const u64 childOpening = self.m_child.openGeneration();
    self.m_childSource.resetObservations();
    self.m_siblingSource.resetObservations();
    self.m_siblingSource.observeAttemptsOf(self.m_childSource);
    self.m_childSource.armText(UiNestedPopupReentryKind::Reset, self.m_builder);
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_EQ(self.m_childSource.attempts(), 1u);
    EXPECT_EQ(self.m_childSource.resetAttempts(), 1u);
    EXPECT_TRUE(self.m_childSource.failedAtAttempt());
    EXPECT_EQ(self.m_childSource.textCalls, 1u);
    EXPECT_EQ(self.m_siblingSource.textCalls, 0u);
    EXPECT_EQ(self.m_siblingSource.metadataCalls(), 0u);
    self.expectSourcePreserved(self.m_childSource, 2402u);
    self.expectSourcePreserved(self.m_siblingSource, 2403u);
    self.expectListPreserved(self.m_childList, generation);
    EXPECT_TRUE(self.m_parent.isOpen());
    EXPECT_TRUE(self.m_child.isOpen());
    EXPECT_EQ(self.m_parent.openGeneration(), parentOpening);
    EXPECT_EQ(self.m_child.openGeneration(), childOpening);
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    self.expectRejected(frame);
}

void VerifyUiNestedPopupReentryTests_ChildFirstRowBalancedPanelReentryRejectsBeforeLaterSiblingCallbacks(mut UiNestedPopupReentryTests self){
    ASSERT_TRUE(self.acceptBase());
    const UiNestedPopupReentryAcceptedFrame frame = self.accepted();
    ASSERT_TRUE(self.beginParent());
    ASSERT_TRUE(self.declareChild());
    ASSERT_TRUE(self.declareSibling());
    const u64 generation = self.m_childList.inputGeneration();
    self.m_childSource.resetObservations();
    self.m_siblingSource.resetObservations();
    self.m_siblingSource.observeAttemptsOf(self.m_childSource);
    self.m_childSource.armText(UiNestedPopupReentryKind::Panel, self.m_builder);
    EXPECT_FALSE(self.m_builder.endPopup());
    self.expectPanelRejected(self.m_childSource);
    EXPECT_EQ(self.m_childSource.textCalls, 1u);
    EXPECT_EQ(self.m_siblingSource.textCalls, 0u);
    EXPECT_EQ(self.m_siblingSource.metadataCalls(), 0u);
    self.expectSourcePreserved(self.m_childSource, 2402u);
    self.expectSourcePreserved(self.m_siblingSource, 2403u);
    self.expectListPreserved(self.m_childList, generation);
    EXPECT_TRUE(self.m_parent.isOpen());
    EXPECT_TRUE(self.m_child.isOpen());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    self.expectRejected(frame);
}

void VerifyUiNestedPopupReentryTests_ParentComboAutomaticPopupRowResetRejectsBeforeChildSourceCallbacks(mut UiNestedPopupReentryTests self){
    ASSERT_TRUE(self.acceptBase());
    const UiNestedPopupReentryAcceptedFrame frame = self.accepted();
    self.m_combo.open();
    ASSERT_TRUE(self.beginParent());
    ASSERT_TRUE(self.m_builder.comboBox("combo", self.m_comboSource, self.m_combo, MakeUiNestedPopupRouterComboOptions()).valid);
    ASSERT_TRUE(self.declareChild());
    const u64 comboGeneration = self.m_combo.inputGeneration();
    const u64 listGeneration = self.m_combo.listState().inputGeneration();
    const u64 preview = self.m_combo.listState().cursorKey();
    const u64 childGeneration = self.m_childList.inputGeneration();
    self.m_comboSource.resetObservations();
    self.m_childSource.resetObservations();
    self.m_childSource.observeAttemptsOf(self.m_comboSource);
    self.m_comboSource.armText(UiNestedPopupReentryKind::Reset, self.m_builder);
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_EQ(self.m_comboSource.attempts(), 1u);
    EXPECT_EQ(self.m_comboSource.resetAttempts(), 1u);
    EXPECT_TRUE(self.m_comboSource.failedAtAttempt());
    EXPECT_EQ(self.m_comboSource.textCalls, 1u);
    EXPECT_EQ(self.m_childSource.textCalls, 0u);
    EXPECT_EQ(self.m_childSource.metadataCalls(), 0u);
    self.expectSourcePreserved(self.m_comboSource, 2404u);
    self.expectSourcePreserved(self.m_childSource, 2402u);
    EXPECT_TRUE(self.m_combo.isOpen());
    EXPECT_EQ(self.m_combo.selectedKey(), 0u);
    EXPECT_EQ(self.m_combo.inputGeneration(), comboGeneration);
    EXPECT_EQ(self.m_combo.listState().inputGeneration(), listGeneration);
    EXPECT_EQ(self.m_combo.listState().cursorKey(), preview);
    self.expectListPreserved(self.m_childList, childGeneration);
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    self.expectRejected(frame);
}

void VerifyUiNestedPopupReentryTests_LateParentRevisionScopeReentryRejectsAfterAllRowsWerePainted(mut UiNestedPopupReentryTests self){
    ASSERT_TRUE(self.acceptBase());
    const UiNestedPopupReentryAcceptedFrame frame = self.accepted();
    ASSERT_TRUE(self.beginParent());
    ASSERT_TRUE(self.m_builder.virtualList(s_UiNestedPopupRouterListKey, self.m_parentSource, self.m_parentList, MakeLargeLoanListOptions()).valid);
    ASSERT_TRUE(self.declareChild());
    ASSERT_TRUE(self.declareSibling());
    const u64 parentGeneration = self.m_parentList.inputGeneration();
    const u64 childGeneration = self.m_childList.inputGeneration();
    self.m_parentSource.resetObservations();
    self.m_childSource.resetObservations();
    self.m_siblingSource.resetObservations();
    self.m_childSource.observeAttemptsOf(self.m_parentSource);
    self.m_siblingSource.observeAttemptsOf(self.m_parentSource);
    // The parent has finished painting before child text arms its next revision call in final validation.
    self.m_childSource.armRevisionAfterText(self.m_parentSource, self.m_builder);
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_EQ(self.m_childSource.arms(), 1u);
    self.expectPanelRejected(self.m_parentSource);
    EXPECT_EQ(self.m_parentSource.textCalls, 5u);
    EXPECT_EQ(self.m_childSource.textCalls, 5u);
    EXPECT_EQ(self.m_siblingSource.textCalls, 5u);
    self.expectSourcePreserved(self.m_parentSource, 2401u);
    self.expectSourcePreserved(self.m_childSource, 2402u);
    self.expectSourcePreserved(self.m_siblingSource, 2403u);
    self.expectListPreserved(self.m_parentList, parentGeneration);
    self.expectListPreserved(self.m_childList, childGeneration);
    EXPECT_TRUE(self.m_parent.isOpen());
    EXPECT_TRUE(self.m_child.isOpen());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    self.expectRejected(frame);
}


