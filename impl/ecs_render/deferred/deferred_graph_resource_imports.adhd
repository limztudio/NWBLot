#include <impl/ecs_render/deferred/deferred_internal.adhd>
#include <impl/ecs_render/deferred/graph_resource_import_builder.adhd>
#include <impl/ecs_render/mesh/instance_gpu_data.adhd>
#include <impl/ecs_render/kernel/task_graph_resource_utils.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidDeferredOptionalGraphImports(
    in b8 hasCsgFrameWork,
    in b8 csgTexturesValid,
    in b8 hasMaterialContextBuffer,
    in b8 materialContextValid,
    in b8 capturesHistory,
    in b8 historyCopyValid
){
    return (!hasCsgFrameWork || csgTexturesValid) && (!hasMaterialContextBuffer || materialContextValid) && (!capturesHistory || historyCopyValid);
}

b8 DeferredAvboitResourceImports::validRefractionInputs()const{
    return
        this.m_refractionDepth.has_value()
        && this.m_refractionNormalIor.has_value()
        && this.m_refractionTintCoverage.has_value()
        && this.m_refractionInstance.has_value()
        && this.m_refractionResolve.has_value()
        && this.m_avboitForegroundColor.has_value()
        && this.m_avboitForegroundExtinction.has_value()
    ;
}

b8 DeferredAvboitResourceImports::validRefractionSpecular()const{
    return this.m_refractionSpecularRoughness.has_value();
}

b8 DeferredAvboitResourceImports::validAvboitInputs()const{
    return
        this.m_avboitLowRaster.has_value()
        && this.m_avboitAccumColor.has_value()
        && this.m_avboitAccumExtinction.has_value()
        && this.m_avboitTransmittance.has_value()
        && this.m_avboitCoverage.has_value()
        && this.m_avboitDepthWarp.has_value()
        && this.m_avboitControl.has_value()
        && this.m_avboitExtinction.has_value()
        && this.m_avboitExtinctionOverflow.has_value()
        && this.m_avboitMaterialDomain.has_value()
        && this.m_avboitCsgDomain.has_value()
    ;
}

void DeferredAvboitResourceImports::publish(mut DeferredGraphResourceImportResult result)const{
    result.avboitLowRaster = this.m_avboitLowRaster.value();
    result.avboitAccumColor = this.m_avboitAccumColor.value();
    result.avboitAccumExtinction = this.m_avboitAccumExtinction.value();
    result.refractionDepth = this.m_refractionDepth.value();
    result.refractionNormalIor = this.m_refractionNormalIor.value();
    result.refractionTintCoverage = this.m_refractionTintCoverage.value();
    result.refractionInstance = this.m_refractionInstance.value();
    result.refractionSpecularRoughness = this.m_refractionSpecularRoughness.value();
    result.refractionResolve = this.m_refractionResolve.value();
    result.avboitForegroundColor = this.m_avboitForegroundColor.value();
    result.avboitForegroundExtinction = this.m_avboitForegroundExtinction.value();
    result.avboitTransmittance = this.m_avboitTransmittance.value();
    result.avboitCoverage = this.m_avboitCoverage.value();
    result.avboitDepthWarp = this.m_avboitDepthWarp.value();
    result.avboitControl = this.m_avboitControl.value();
    result.avboitExtinction = this.m_avboitExtinction.value();
    result.avboitExtinctionOverflow = this.m_avboitExtinctionOverflow.value();
    result.avboitMaterialDomain = this.m_avboitMaterialDomain.value();
    result.avboitCsgDomain = this.m_avboitCsgDomain.value();
}

b8 DeferredCsgTextureImports::valid()const{
    return
        this.m_csgCapBackNormal.has_value()
        && this.m_csgIntervalDepth.has_value()
        && this.m_csgIntervalId.has_value()
        && this.m_csgReceiverEventData.has_value()
        && this.m_csgReceiverEventCount.has_value()
        && this.m_csgReceiverSpanData.has_value()
        && this.m_csgReceiverSpanCount.has_value()
        && this.m_csgRemovedIntervalDepth.has_value()
        && this.m_csgRemovedIntervalCapNormal.has_value()
        && this.m_csgRemovedIntervalData.has_value()
        && this.m_csgRemovedIntervalCount.has_value()
    ;
}

void DeferredCsgTextureImports::publish(mut DeferredGraphResourceImportResult result)const{
    result.csgCapBackNormal = this.m_csgCapBackNormal.value();
    result.csgIntervalDepth = this.m_csgIntervalDepth.value();
    result.csgIntervalId = this.m_csgIntervalId.value();
    result.csgReceiverEventData = this.m_csgReceiverEventData.value();
    result.csgReceiverEventCount = this.m_csgReceiverEventCount.value();
    result.csgReceiverSpanData = this.m_csgReceiverSpanData.value();
    result.csgReceiverSpanCount = this.m_csgReceiverSpanCount.value();
    result.csgRemovedIntervalDepth = this.m_csgRemovedIntervalDepth.value();
    result.csgRemovedIntervalCapNormal = this.m_csgRemovedIntervalCapNormal.value();
    result.csgRemovedIntervalData = this.m_csgRemovedIntervalData.value();
    result.csgRemovedIntervalCount = this.m_csgRemovedIntervalCount.value();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<GpuGraphResourceId> ImportDeferredAvboitTexture(
    in TextureHandle texture,
    in Name identity,
    in StringView label,
    in b8 clearTargets,
    mut GpuTaskGraph graph
){
    if(clearTargets)
        return ImportExternalTexture(graph, texture, identity, label, Optional<ResourceStates>(ResourceStates::Unknown));
    return ImportExternalTexture(graph, texture, identity, label);
}

void DeferredAvboitResourceImports::capture(mut GpuTaskGraph graph, in DeferredFrameTargets deferredTargets, in b8 clearTargets){
    this.m_avboitLowRaster = ImportDeferredAvboitTexture(deferredTargets.avboit.lowRasterTarget, Name(s_DeferredImportNameRenderAvboitLowRaster), "AVBOIT Low Raster", clearTargets, graph);
    this.m_avboitAccumColor = ImportDeferredAvboitTexture(deferredTargets.avboit.accumColor, Name(s_DeferredImportNameRenderAvboitAccumColor), "AVBOIT Accumulated Color", clearTargets, graph);
    this.m_avboitAccumExtinction = ImportDeferredAvboitTexture(deferredTargets.avboit.accumExtinction, Name(s_DeferredImportNameRenderAvboitAccumExtinction), "AVBOIT Accumulated Extinction", clearTargets, graph);
    this.m_refractionDepth = ImportDeferredAvboitTexture(deferredTargets.avboit.refractionDepth, Name(s_DeferredImportNameRenderAvboitRefractionDepth), "AVBOIT refractionDepth", clearTargets, graph);
    this.m_refractionNormalIor = ImportDeferredAvboitTexture(deferredTargets.avboit.refractionNormalIor, Name(s_DeferredImportNameRenderAvboitRefractionNormalIor), "AVBOIT refractionNormalIor", clearTargets, graph);
    this.m_refractionTintCoverage = ImportDeferredAvboitTexture(deferredTargets.avboit.refractionTintCoverage, Name(s_DeferredImportNameRenderAvboitRefractionTintCoverage), "AVBOIT refractionTintCoverage", clearTargets, graph);
    this.m_refractionInstance = ImportDeferredAvboitTexture(deferredTargets.avboit.refractionInstance, Name(s_DeferredImportNameRenderAvboitRefractionInstance), "AVBOIT refractionInstance", clearTargets, graph);
    this.m_refractionSpecularRoughness = ImportDeferredAvboitTexture(deferredTargets.avboit.refractionSpecularRoughness, Name(s_DeferredImportNameRenderAvboitRefractionSpecularRoughness), "AVBOIT Refraction Specular Roughness", clearTargets, graph);
    this.m_refractionResolve = ImportDeferredAvboitTexture(deferredTargets.avboit.refractionResolve, Name(s_DeferredImportNameRenderAvboitRefractionResolve), "AVBOIT refractionResolve", clearTargets, graph);
    this.m_avboitForegroundColor = ImportDeferredAvboitTexture(deferredTargets.avboit.foregroundAccumColor, Name(s_DeferredImportNameRenderAvboitAvboitForegroundColor), "AVBOIT avboitForegroundColor", clearTargets, graph);
    this.m_avboitForegroundExtinction = ImportDeferredAvboitTexture(deferredTargets.avboit.foregroundAccumExtinction, Name(s_DeferredImportNameRenderAvboitAvboitForegroundExtinction), "AVBOIT avboitForegroundExtinction", clearTargets, graph);
    this.m_avboitTransmittance = ImportDeferredAvboitTexture(deferredTargets.avboit.transmittanceTexture, Name(s_DeferredImportNameRenderAvboitTransmittance), "AVBOIT Transmittance", clearTargets, graph);
    this.m_avboitCoverage = ImportExternalBuffer(graph, deferredTargets.avboit.coverageBuffer, Name(s_DeferredImportNameRenderAvboitCoverage), "AVBOIT Coverage");
    this.m_avboitDepthWarp = ImportExternalBuffer(graph, deferredTargets.avboit.depthWarpBuffer, Name(s_AvboitDepthWarpName), s_AvboitDepthWarpLabel);
    this.m_avboitControl = ImportExternalBuffer(graph, deferredTargets.avboit.controlBuffer, Name(s_DeferredImportNameRenderAvboitControl), "AVBOIT Control");
    this.m_avboitExtinction = ImportExternalBuffer(graph, deferredTargets.avboit.extinctionBuffer, Name(s_AvboitExtinctionName), s_AvboitExtinctionLabel);
    this.m_avboitExtinctionOverflow = ImportExternalBuffer(graph, deferredTargets.avboit.extinctionOverflowBuffer, Name(s_DeferredImportNameRenderAvboitExtinctionOverflow), "AVBOIT Extinction Overflow");
    this.m_avboitMaterialDomain = graph.importHazardDomain(HazardDomainDesc(Name(s_DeferredImportNameRenderAvboitMaterialDomain), "Transparent Materials and Geometry"));
    this.m_avboitCsgDomain = graph.importHazardDomain(HazardDomainDesc(Name(s_DeferredImportNameRenderAvboitCsgDomain), s_TransparentCsgIntervalsLabel));
}

void DeferredCsgTextureImports::capture(mut GpuTaskGraph graph, in DeferredFrameTargets deferredTargets){
    this.m_csgCapBackNormal = ImportExternalTexture(graph, deferredTargets.csgCapBackNormal, Name(s_DeferredImportNameRenderDeferredCsgCapBackNormal), "CSG Cap Back Normal");
    this.m_csgIntervalDepth = ImportExternalTexture(graph, deferredTargets.csgIntervalDepth, Name(s_DeferredImportNameRenderDeferredCsgIntervalDepth), "CSG Interval Depth");
    this.m_csgIntervalId = ImportExternalTexture(graph, deferredTargets.csgIntervalId, Name(s_DeferredImportNameRenderDeferredCsgIntervalId), "CSG Interval ID");
    this.m_csgReceiverEventData = ImportExternalTexture(graph, deferredTargets.csgReceiverEventData, Name(s_DeferredImportNameRenderDeferredCsgReceiverEventData), "CSG Receiver Event Data");
    this.m_csgReceiverEventCount = ImportExternalTexture(graph, deferredTargets.csgReceiverEventCount, Name(s_DeferredImportNameRenderDeferredCsgReceiverEventCount), "CSG Receiver Event Count");
    this.m_csgReceiverSpanData = ImportExternalTexture(graph, deferredTargets.csgReceiverSpanData, Name(s_DeferredImportNameRenderDeferredCsgReceiverSpanData), "CSG Receiver Span Data");
    this.m_csgReceiverSpanCount = ImportExternalTexture(graph, deferredTargets.csgReceiverSpanCount, Name(s_DeferredImportNameRenderDeferredCsgReceiverSpanCount), "CSG Receiver Span Count");
    this.m_csgRemovedIntervalDepth = ImportExternalTexture(graph, deferredTargets.csgRemovedIntervalDepth, Name(s_DeferredImportNameRenderDeferredCsgRemovedIntervalDepth), "CSG Removed Interval Depth");
    this.m_csgRemovedIntervalCapNormal = ImportExternalTexture(graph, deferredTargets.csgRemovedIntervalCapNormal, Name(s_DeferredImportNameRenderDeferredCsgRemovedIntervalCapNormal), "CSG Removed Interval Cap Normal");
    this.m_csgRemovedIntervalData = ImportExternalTexture(graph, deferredTargets.csgRemovedIntervalData, Name(s_DeferredImportNameRenderDeferredCsgRemovedIntervalData), "CSG Removed Interval Data");
    this.m_csgRemovedIntervalCount = ImportExternalTexture(graph, deferredTargets.csgRemovedIntervalCount, Name(s_DeferredImportNameRenderDeferredCsgRemovedIntervalCount), "CSG Removed Interval Count");
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void CollectDeferredResource(in Expected<GpuGraphResourceId> imported, mut GpuGraphResourceId id, mut b8 complete){
    if(imported.has_value())
        id = imported.value();
    else
        complete = false;
}

Expected<DeferredGraphResourceImportResult> DeferredGraphResourceImportBuilder::declare(in DeferredGraphResourceImportInputs inputs)const{
    DeferredGraphResourceImportResult result;
    in DeferredFrameTargets targets = inputs.targets;
    b8 complete = true;
    DeferredCsgTextureImports csg;
    DeferredAvboitResourceImports avboit;
    CollectDeferredResource(ImportExternalTexture(this.m_graph, targets.albedo, s_DeferredImportNameRenderDeferredLightingAlbedo, "G-Buffer Albedo", ResourceStates::Unknown), result.albedo, complete);
    CollectDeferredResource(ImportExternalTexture(this.m_graph, targets.normal, s_DeferredImportNameRenderDeferredLightingNormal, "G-Buffer Normal", ResourceStates::Unknown), result.normal, complete);
    CollectDeferredResource(ImportExternalTexture(this.m_graph, targets.worldPosition, s_DeferredImportNameRenderDeferredLightingWorldPosition, "G-Buffer World Position", ResourceStates::Unknown), result.worldPosition, complete);
    CollectDeferredResource(ImportExternalTexture(this.m_graph, targets.specularRoughness, s_DeferredImportNameRenderDeferredLightingSpecularRoughness, "G-Buffer Specular Roughness", ResourceStates::Unknown), result.specularRoughness, complete);
    CollectDeferredResource(ImportExternalTexture(this.m_graph, targets.depth, s_DeferredImportNameRenderDeferredLightingDepth, "G-Buffer Depth", ResourceStates::Unknown), result.depth, complete);
    if(inputs.hasCsgFrameWork)
        csg.capture(this.m_graph, targets);
    if(inputs.history.has_value()){
        in DeferredLaggedLightingHistoryResources history = inputs.history.value();
        CollectDeferredResource(ImportExternalTexture(this.m_graph, history.shadowVisibility, s_DeferredImportNameRenderDeferredLightingShadowVisibility, "Lagged Shadow Visibility"), result.shadowVisibility, complete);
        CollectDeferredResource(ImportExternalTexture(this.m_graph, history.causticIrradiance, s_DeferredImportNameRenderDeferredLightingCausticIrradiance, "Lagged Caustic Irradiance"), result.causticIrradiance, complete);
        CollectDeferredResource(ImportExternalTexture(this.m_graph, history.surfelIrradiance, s_DeferredImportNameRenderDeferredLightingSurfelIrradiance, "Lagged Surfel Irradiance"), result.surfelIrradiance, complete);
        CollectDeferredResource(ImportExternalTexture(this.m_graph, targets.shadowVisibility, s_DeferredImportNameRenderDeferredShadowVisibilityCurrentOutput, s_ShadowVisibilityLabel), result.currentShadowVisibility, complete);
        CollectDeferredResource(ImportExternalTexture(this.m_graph, targets.causticIrradiance, s_DeferredImportNameRenderDeferredEffectsCurrentCausticIrradiance, s_CausticIrradianceLabel), result.currentCausticIrradiance, complete);
        CollectDeferredResource(ImportExternalTexture(this.m_graph, targets.surfelIrradiance, s_DeferredImportNameRenderDeferredSurfelGiCurrentIrradiance, s_SurfelIrradianceLabel), result.currentSurfelIrradiance, complete);
    }
    else{
        CollectDeferredResource(ImportExternalTexture(this.m_graph, targets.shadowVisibility, s_DeferredImportNameRenderDeferredLightingShadowVisibility, s_ShadowVisibilityLabel), result.shadowVisibility, complete);
        CollectDeferredResource(ImportExternalTexture(this.m_graph, targets.causticIrradiance, s_DeferredImportNameRenderDeferredLightingCausticIrradiance, s_CausticIrradianceLabel), result.causticIrradiance, complete);
        CollectDeferredResource(ImportExternalTexture(this.m_graph, targets.surfelIrradiance, s_DeferredImportNameRenderDeferredLightingSurfelIrradiance, s_SurfelIrradianceLabel), result.surfelIrradiance, complete);
        result.currentShadowVisibility = result.shadowVisibility;
        result.currentCausticIrradiance = result.causticIrradiance;
        result.currentSurfelIrradiance = result.surfelIrradiance;
    }
    CollectDeferredResource(ImportExternalTexture(this.m_graph, targets.opaqueColor, s_DeferredImportNameRenderDeferredLightingOpaqueColor, "Opaque Color", ResourceStates::Unknown), result.opaqueColor, complete);
    CollectDeferredResource(ImportExternalBuffer(this.m_graph, inputs.lightingResources.sceneShadingBuffer, s_DeferredImportNameRenderDeferredLightingSceneShading, "Scene Shading"), result.sceneShading, complete);
    CollectDeferredResource(ImportExternalBuffer(this.m_graph, inputs.lightingResources.lightBuffer, s_DeferredImportNameRenderDeferredLightingLights, "Lights"), result.lights, complete);
    CollectDeferredResource(ImportExternalBuffer(this.m_graph, inputs.meshViewSnapshot.buffer, Name(s_MeshViewName), s_MeshViewLabel), result.meshView, complete);
    if(inputs.frameBindings.instanceBuffer.valid())
        CollectDeferredResource(ImportExternalBuffer(this.m_graph, inputs.frameBindings.instanceBuffer, s_DeferredImportNameRenderDeferredMaterialInstances, "Material Instances"), result.materialInstances, complete);
    if(inputs.frameBindings.materialTypedBuffer.valid())
        CollectDeferredResource(ImportExternalBuffer(this.m_graph, inputs.frameBindings.materialTypedBuffer, s_DeferredImportNameRenderDeferredMaterialTyped, "Material Typed Data"), result.materialTyped, complete);
    if(inputs.csgResources.receiverRanges.valid())
        CollectDeferredResource(ImportExternalBuffer(this.m_graph, inputs.csgResources.receiverRanges, s_DeferredImportNameRenderDeferredCsgReceiverRanges, "CSG Receiver Ranges"), result.csgReceiverRanges, complete);
    if(inputs.csgResources.cutters.valid())
        CollectDeferredResource(ImportExternalBuffer(this.m_graph, inputs.csgResources.cutters, s_DeferredImportNameRenderDeferredCsgCutters, "CSG Cutters"), result.csgCutters, complete);
    if(inputs.csgResources.clipContextSlots.valid())
        CollectDeferredResource(ImportExternalBuffer(this.m_graph, inputs.csgResources.clipContextSlots, s_DeferredImportNameRenderDeferredCsgClipContextSlots, "CSG Clip Context Slots"), result.csgClipContextSlots, complete);
    if(inputs.csgResources.intervalSampleState.valid())
        CollectDeferredResource(ImportExternalBuffer(this.m_graph, inputs.csgResources.intervalSampleState, s_DeferredImportNameRenderDeferredCsgIntervalSampleState, "CSG Interval Sample State"), result.csgIntervalSampleState, complete);
    if(inputs.history.has_value()){
        in BufferHandle slots = inputs.history.value().slotsBuffer;
        CollectDeferredResource(ImportExternalBuffer(this.m_graph, slots, s_LightingBindlessSlotsName, "Lagged Deferred Bindless Slots"), result.bindlessSlots, complete);
        if(targets.bindless.slotsBuffer == slots)
            result.currentBindlessSlots = result.bindlessSlots;
        else
            CollectDeferredResource(ImportExternalBuffer(this.m_graph, targets.bindless.slotsBuffer, s_DeferredImportNameRenderDeferredCompositeBindlessSlots, s_DeferredBindlessSlotsLabel), result.currentBindlessSlots, complete);
    }
    else{
        CollectDeferredResource(ImportExternalBuffer(this.m_graph, targets.bindless.slotsBuffer, s_LightingBindlessSlotsName, s_DeferredBindlessSlotsLabel), result.bindlessSlots, complete);
        result.currentBindlessSlots = result.bindlessSlots;
    }
    in BufferHandle materialContext = inputs.rayTracingResources.materialContextSlotsBuffer;
    if(materialContext.valid())
        CollectDeferredResource(ImportExternalBuffer(this.m_graph, materialContext, s_DeferredImportNameRenderDeferredMaterialContextSlots, "Ray Trace Material Context Slots"), result.materialContextSlots, complete);

    if(inputs.capturesLaggedLightingHistory){
        result.historyCopyShadowVisibility = result.currentShadowVisibility;
        result.historyCopyCausticIrradiance = result.currentCausticIrradiance;
        result.historyCopySurfelIrradiance = result.currentSurfelIrradiance;
        if(inputs.history.has_value()){
            result.historyCopyDestinationShadowVisibility = result.shadowVisibility;
            result.historyCopyDestinationCausticIrradiance = result.causticIrradiance;
            result.historyCopyDestinationSurfelIrradiance = result.surfelIrradiance;
        }
        else if(inputs.captureHistory.has_value()){
            in DeferredLaggedLightingHistoryResources capture = inputs.captureHistory.value();
            CollectDeferredResource(ImportExternalTexture(this.m_graph, capture.shadowVisibility, s_DeferredImportNameRenderLaggedHistoryCopyHistoryShadowVisibility, "History Shadow Visibility", ResourceStates::Unknown),
                result.historyCopyDestinationShadowVisibility, complete);
            CollectDeferredResource(ImportExternalTexture(this.m_graph, capture.causticIrradiance, s_DeferredImportNameRenderLaggedHistoryCopyHistoryCausticIrradiance, "History Caustic Irradiance",
                ResourceStates::Unknown), result.historyCopyDestinationCausticIrradiance, complete);
            CollectDeferredResource(ImportExternalTexture(this.m_graph, capture.surfelIrradiance, s_DeferredImportNameRenderLaggedHistoryCopyHistorySurfelIrradiance, "History Surfel Irradiance", ResourceStates::Unknown),
                result.historyCopyDestinationSurfelIrradiance, complete);
        }
    }

    avboit.capture(this.m_graph, targets, inputs.clearAvboitTargets);
    if(!complete || !avboit.validRefractionInputs() || !avboit.validRefractionSpecular() || !avboit.validAvboitInputs()
        || !ValidDeferredOptionalGraphImports(inputs.hasCsgFrameWork, csg.valid(), materialContext.valid(), result.materialContextSlots.valid(),
            inputs.capturesLaggedLightingHistory, result.historyCopyShadowVisibility.valid() && result.historyCopyCausticIrradiance.valid()
                && result.historyCopySurfelIrradiance.valid() && result.historyCopyDestinationShadowVisibility.valid()
                && result.historyCopyDestinationCausticIrradiance.valid() && result.historyCopyDestinationSurfelIrradiance.valid()))
        return MakeUnexpected(Failure());

    if(inputs.hasCsgFrameWork)
        csg.publish(result);
    avboit.publish(result);
    result.csgPeelSubresources = TextureSubresourceSet(0u, 1u, 0u, targets.csgPeelLayerCount);
    result.csgReceiverEventDataSubresources = TextureSubresourceSet(0u, 1u, 0u, targets.csgReceiverEventLayerCount);
    result.csgReceiverEventCountSubresources = TextureSubresourceSet(0u, 1u, 0u, 1u);
    result.csgReceiverSpanDataSubresources = TextureSubresourceSet(0u, 1u, 0u, targets.csgReceiverSpanLayerCount);
    result.csgReceiverSpanCountSubresources = TextureSubresourceSet(0u, 1u, 0u, 1u);
    result.csgRemovedIntervalSubresources = TextureSubresourceSet(0u, 1u, 0u, targets.csgRemovedIntervalLayerCount);
    result.csgRemovedIntervalCountSubresources = TextureSubresourceSet(0u, 1u, 0u, 1u);
    return result;
}


