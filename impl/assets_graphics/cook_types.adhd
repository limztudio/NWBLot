#include <impl/assets_graphics/components.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_CsgClipImplicitDefineName = "NWB_CSG_ENABLED";
const StringView s_CsgIntervalSampleEnabledImplicitDefineName = "NWB_CSG_INTERVAL_SAMPLE_ENABLED";
const StringView s_EnabledImplicitDefineValue = "1";
const StringView s_IntervalSampleEnabledImplicitDefineValue = "1";
const usize s_CsgClipAddedDefineCount = 2u;
const StringView s_DependencyRepoRootAlias = "repo";
const StringView s_DependencyGeneratedCacheRootAlias = "generated_cache";
const usize s_MaxPreparedEntriesPerShaderEntry = 2u;
const StringView s_ShaderVariantBytecodeExtension = ".spv";
const u32 s_ShaderVariantCookKeyVersion = 2u;
const Name s_ShaderNonStandaloneAssetTypeName = "shader";
const Name s_GraphicsVolumeMetadataExtensionName = "assets_graphics/volume_metadata";
const Name s_IncludeAssetTypeName = "include";
const StringView s_MaterialBxdfSourceLabel = "bxdf";
const StringView s_MaterialSurfaceSourceLabel = "surface";
const StringView s_EngineGraphicsIncludeRoot = "engine/graphics";
const StringView s_GraphicsComponentAssetField = "asset";
const StringView s_RendererComponentMaterialField = "material";
const StringView s_RendererComponentVisibleField = "visible";
const StringView s_RendererComponentOpticalVolumeCoincidenceField = "optical_volume_coincidence";
const StringView s_RendererComponentOpticalVolumeGroupField = "optical_volume_group";
const StringView s_RendererComponentOpticalVolumePriorityField = "optical_volume_priority";
const StringView s_RendererComponentOpticalBoundaryModeField = "optical_boundary_mode";
const StringView s_RendererComponentOpticalMediumPriorityField = "optical_medium_priority";
const StringView s_ModelComponentDiagnosticPrefix = "Model component meta";
const StringView s_MeshComponentDiagnosticPrefix = "Mesh component meta";
const StringView s_RendererComponentDiagnosticPrefix = "Renderer component meta";
const StringView s_OpticalVolumeCoincidenceIndependentText = "independent";
const StringView s_OpticalVolumeCoincidenceIdenticalMaterialText = "identical_material";
const StringView s_OpticalVolumeCoincidenceSharedGroupText = "shared_group";
const StringView s_OpticalBoundaryModeUnspecifiedText = "unspecified";
const StringView s_OpticalBoundaryModeClosedNestedText = "closed_nested";
const StringView s_OpticalBoundaryModeClosedPriorityText = "closed_priority";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
enum<u8> ShaderVariantCacheReadStatus{
    Hit = 0u,
    Miss = 1u,
    Error = 2u
}

class ShaderStageKey{
    public Name shaderName;
    public Name stageName;

    public ShaderStageKey(){
        this.shaderName = s_NameNone;
        this.stageName = s_NameNone;
    }

    public ShaderStageKey(in Name inShaderName, in Name inStageName){
        this.shaderName = inShaderName;
        this.stageName = inStageName;
    }

    public b8 operator==(in ShaderStageKey rhs)const{
        return this.shaderName == rhs.shaderName && this.stageName == rhs.stageName;
    }

    public usize hash()const{
        usize seed = hashValue(this.shaderName);
        return hashCombineValue(seed, this.stageName);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsUnpaddedRendererOpticalVolumeGroup(in StringView text){
    return !trimView(text).empty() && text == trimView(text);
}

Expected<usize> TryComputeCsgClipDefineCapacity(in StringView entryName, in usize sourceCount){
    if(sourceCount > usize.max - s_CsgClipAddedDefineCount){
        error("GraphicsCook: CSG shader define combo size overflow for entry '{}'", entryName);
        return makeUnexpected(Failure());
    }
    return sourceCount + s_CsgClipAddedDefineCount;
}

b8 ValidateShaderMergedDefineCount(in StringView entryName, in usize count){
    if(count > cast<usize>(u32.max)){
        error("GraphicsCook: entry '{}' has too many merged defines for shader compilation", entryName);
        return false;
    }
    return true;
}

Expected<usize> TryComputeShaderIncludeRootCapacity(in StringView entryName, in usize authoredCount, in usize implicitCount){
    if(authoredCount > usize.max - implicitCount){
        error("GraphicsCook: include root count overflow for entry '{}'", entryName);
        return makeUnexpected(Failure());
    }
    return authoredCount + implicitCount;
}

Expected<usize> TryComputePreparedShaderEntryCapacity(in usize entryCount){
    if(entryCount > usize.max / s_MaxPreparedEntriesPerShaderEntry){
        error("GraphicsCook: prepared shader entry reserve count overflows");
        return makeUnexpected(Failure());
    }
    return entryCount * s_MaxPreparedEntriesPerShaderEntry;
}

Expected<usize> TryComputeImplicitShaderIncludeRootCapacity(in usize rootCount, in usize assetRootCount){
    if(rootCount > usize.max - assetRootCount){
        error("GraphicsCook: implicit shader include root count overflows");
        return makeUnexpected(Failure());
    }
    return rootCount + assetRootCount;
}

b8 TryAddCsgClipVariantCount(in StringView entryName, in u64 sourceVariantCount, mut u64 inOutVariantCount){
    if(sourceVariantCount <= u64.max - inOutVariantCount){
        inOutVariantCount += sourceVariantCount;
        return true;
    }

    error("GraphicsCook: CSG clip variant count overflow for entry '{}'", entryName);
    return false;
}

b8 ValidateMaterialCookPixelShaderInterface(
    in StringView materialVirtualPath,
    in StringView materialInterfaceText,
    in Name pixelShaderName,
    in Name shaderMaterialInterface,
    in StringView shaderMaterialInterfacePath,
    in Name parsedMaterialInterface
){
    if(shaderMaterialInterface == s_NameNone){
        error(
            "Material '{}' declares interface '{}' but pixel shader '{}' does not include a generated material bind"
            , materialVirtualPath
            , materialInterfaceText
            , pixelShaderName.resolvedText()
        );
        return false;
    }
    if(shaderMaterialInterface != parsedMaterialInterface){
        error(
            "Material '{}' declares interface '{}' but pixel shader '{}' includes generated material bind interface '{}'"
            , materialVirtualPath
            , materialInterfaceText
            , pixelShaderName.resolvedText()
            , shaderMaterialInterfacePath
        );
        return false;
    }
    return true;
}

b8 ValidateMaterialCookStagePresence(
    in StringView materialVirtualPath,
    in StringView materialInterfaceText,
    in b8 hasShaderStage,
    in b8 hasInterfaceStage
){
    if(!hasShaderStage){
        error("Material '{}' has no shader stages", materialVirtualPath);
        return false;
    }
    if(!hasInterfaceStage){
        error("Material '{}' declares interface '{}' but has no pixel shader stage", materialVirtualPath, materialInterfaceText);
        return false;
    }
    return true;
}

b8 IsAllowedRendererComponentMetadataField(in StringView field){
    return
        field == s_RendererComponentMaterialField
        || field == s_RendererComponentVisibleField
        || field == s_RendererComponentOpticalVolumeCoincidenceField
        || field == s_RendererComponentOpticalVolumeGroupField
        || field == s_RendererComponentOpticalVolumePriorityField
        || field == s_RendererComponentOpticalBoundaryModeField
        || field == s_RendererComponentOpticalMediumPriorityField
    ;
}

u64 BuildShaderVariantCookKeyHash(in NameHash virtualPathHash, in u64 sourceChecksum, in u64 bytecodeChecksum){
    u64 hash = s_Fnv64OffsetBasis;
    hash = updateFnv64U32(hash, s_ShaderVariantCookKeyVersion);
    hash = updateFnv64NameHash(hash, virtualPathHash);
    hash = updateFnv64U64(hash, sourceChecksum);
    hash = updateFnv64U64(hash, bytecodeChecksum);
    return hash;
}

b8 ValidateShaderDoesNotUseImplicitDefine(in StringView entryName, in StringView defineName, in b8 hasDefine){
    if(!hasDefine)
        return true;

    error("GraphicsCook: shader '{}' uses reserved implicit define '{}' as a variant define", entryName, defineName);
    return false;
}

b8 TryAccumulateShaderDefineVariantCount(
    in StringView entryName,
    in StringView defineName,
    in u64 valueCount,
    mut u64 inOutVariantCount
){
    if(valueCount == 0u){
        error("GraphicsCook: entry '{}' has define '{}' with no values", entryName, defineName);
        return false;
    }
    if(inOutVariantCount > u64.max / valueCount){
        error("GraphicsCook: variant count overflow for entry '{}'", entryName);
        return false;
    }
    inOutVariantCount *= valueCount;
    return true;
}

b8 ValidateShaderReservedImplicitDefines(
    in StringView entryName,
    in StringView materialBindTypedBindingDefine,
    in b8 hasMaterialBindTypedBindingDefine,
    in b8 hasCsgClipDefine,
    in b8 hasCsgIntervalSampleDefine
){
    if(!ValidateShaderDoesNotUseImplicitDefine(entryName, materialBindTypedBindingDefine, hasMaterialBindTypedBindingDefine))
        return false;
    if(!ValidateShaderDoesNotUseImplicitDefine(entryName, s_CsgClipImplicitDefineName, hasCsgClipDefine))
        return false;
    return ValidateShaderDoesNotUseImplicitDefine(entryName, s_CsgIntervalSampleEnabledImplicitDefineName, hasCsgIntervalSampleDefine);
}

b8 TryAccumulateGeneratedShaderEntryCapacity(
    in usize baseCapacity,
    in usize count0,
    in usize count1,
    in usize count2,
    in usize count3,
    mut usize outCapacity
){
    usize capacity = baseCapacity;
    Array<usize, 4> counts;
    counts[0u] = count0;
    counts[1u] = count1;
    counts[2u] = count2;
    counts[3u] = count3;
    for(in usize count : counts){
        if(count > usize.max - capacity){
            error("GraphicsCook: generated shader entry count exceeds container capacity");
            return false;
        }
        capacity += count;
    }
    outCapacity = capacity;
    return true;
}

b8 TryInsertUniqueShaderIdentityKey(
    in Name shaderName,
    in Name stageName,
    in StringView shaderNameText,
    in StringView stageText,
    in b8 hasMetaPath,
    in StringView metaPathText,
    mut HashSet<ShaderStageKey> inOutSeenKeys
){
    const ShaderStageKey shaderIdentityKey(shaderName, stageName);
    if(inOutSeenKeys.contains(shaderIdentityKey)){
        if(hasMetaPath)
            error("GraphicsCook: duplicate shader identity '{}' for stage '{}' from meta '{}'", shaderNameText, stageText, metaPathText);
        else
            error("GraphicsCook: duplicate generated pixel shader identity '{}'", shaderNameText);
        return false;
    }
    inOutSeenKeys.insert(shaderIdentityKey);
    return true;
}

b8 TryAccumulatePreparedShaderRecordCount(in u64 variantCount, mut u64 inOutShaderRecordCount){
    if(inOutShaderRecordCount > u64.max - variantCount){
        error("GraphicsCook: shader record count overflow");
        return false;
    }
    inOutShaderRecordCount += variantCount;
    return true;
}

b8 ValidatePreparedShaderRecordCountFitsCapacity(in u64 shaderRecordCount, mut usize outCount){
    if(shaderRecordCount > cast<u64>(usize.max)){
        error("GraphicsCook: shader record count exceeds container capacity");
        return false;
    }
    outCount = cast<usize>(shaderRecordCount);
    return true;
}


