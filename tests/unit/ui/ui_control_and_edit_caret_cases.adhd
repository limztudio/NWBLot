namespace __hidden_ui_edit_box_layout_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB;
using namespace NWB::Impl;
using namespace NWB::Impl::Ui;

constexpr AStringView s_EditBoxSkinPath = "tests/ui/edit_box/skin";
constexpr AStringView s_EditBoxTexturePath = "tests/ui/edit_box/texture";
constexpr AStringView s_EditBoxFontPath = "tests/ui/edit_box/font";
constexpr Name s_FontScratchArenaName = NWB::Tests::UiCases::s_UiCaseNameFontScratch;
constexpr AStringView s_LatinFontFileName = "latin.font";

using NWB::Tests::UiFixtureText::FixtureShaper;

class EditBoxLayoutTests : public testing::Test{
public:
    EditBoxLayoutTests()
        : m_arena(Name(NWB::Tests::UiCases::s_UiCaseNameEditBoxLayout))
        , m_model(m_arena)
        , m_shaper(m_arena)
        , m_builder(m_arena, m_shaper)
        , m_view(m_arena)
    {}


public:
    [[nodiscard]] b8 shapeView(){
        if(!m_view.snapshot(m_model))
            return false;
        auto layout = m_builder.layout({ m_view.displayText() });
        return layout && m_view.adoptLayout(Move(*layout));
    }

    [[nodiscard]] b8 tryAdoptBuiltLayout(const StringView text, const TextDirection::Enum direction = TextDirection::LeftToRight){
        ShapeRequest request{ text };
        request.direction = direction;
        auto layout = m_builder.layout(request);
        EXPECT_TRUE(layout);
        if(!layout)
            return false;
        return m_view.adoptLayout(Move(*layout));
    }

    void moveViewTo(EditBoxView& destination)noexcept{
        destination = EditBoxView(Move(m_view));
    }

    void configureSkin(UiSkin& skin, const b8 includeButtonRegion = false){
        UiSkin::RegionVector regions(m_arena);
        if(includeButtonRegion)
            regions.push_back({ Name(NWB::Tests::UiCases::s_UiCaseNameButtonNormal), { 0u, 0u, 4u, 4u }, {}, {} });
        skin.setAtlas(Core::Assets::AssetRef<Texture>(s_EditBoxTexturePath), 4u, 4u, 1.0f, Move(regions));
    }

    void beginSkinPaint(PaintBuilder& paint, const UiSkin& skin, const u64 generation, const f32 width = 200.0f, const f32 height = 100.0f, const f32 scale = 1.0f){
        paint.begin({ width, height, scale, scale }, generation, 1u, Core::Assets::AssetRef<UiSkin>(s_EditBoxSkinPath), skin);
    }

    [[nodiscard]] b8 installBundledLatinFont(Core::Alloc::ScratchArena& scratchArena, Font& font, TextService& service){
        const ::Path<Core::Alloc::GlobalArena> path = ::Path<Core::Alloc::GlobalArena>(m_arena, NWB_TEST_FONT_DIRECTORY) / s_LatinFontFileName;
        auto bytes = Tests::ReadBundledFontBytes(path, m_arena);
        if(!bytes)
            return false;
        font.setFontBytes(Move(*bytes));
        if(!font.validatePayload())
            return false;
        const FontSource source{ Core::Assets::AssetRef<Font>(s_EditBoxFontPath), font, 1u };
        return service.setFonts(scratchArena, Span(&source, 1u));
    }

    [[nodiscard]] b8 place(f32 width = 100.0f, f32 scroll = 0.0f)noexcept{
        const auto placement = m_view.arrange({ 10.0f, 20.0f, width, 20.0f }, {}, { 0.0f, 0.0f, 500.0f, 500.0f }, { scroll, 0.0f });
        if(!placement)
            return false;
        m_placement = *placement;
        return true;
    }

    [[nodiscard]] Expected<Rect> rangeRect(const EditBoxRange range)const noexcept{
        auto rect = m_view.caretGeometry().rangeOnLine(range, 0u, m_placement.caret.width);
        if(!rect)
            return MakeUnexpected(Failure{});
        const SIMDVectorSingle origin = VectorAdd(VectorSet(rect->x, rect->y, 0.0f, 0.0f), VectorSet(m_placement.textOrigin.x, m_placement.textOrigin.y, 0.0f, 0.0f));
        rect->x = VectorGetX(origin);
        rect->y = VectorGetY(origin);
        return rect;
    }


public:
    Core::Alloc::GlobalArena m_arena;
    EditModel m_model;
    FixtureShaper m_shaper;
    TextLayoutBuilder m_builder;
    EditBoxView m_view;
    EditBoxPlacement m_placement;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


