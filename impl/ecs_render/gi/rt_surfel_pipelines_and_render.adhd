////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
b8 RendererRayTracingSystem::renderSurfelGiPhases(
    mut CommandList commandList,
    mut DeferredFrameTargets targets,
    in DeferredLightingGraphResources deferredLightingResources,
    in b8 dispatchAgeFree,
    in b8 dispatchHashBuild,
    in b8 dispatchSpawn,
    in b8 dispatchTraceBuildArgs,
    in b8 dispatchTrace,
    in b8 dispatchResolve,
    in b8 dispatchRemaining
){
    if(!this.hasSurfelWork())
        return true;

    assert(targets.bindless.valid());
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    if(!heap.isInitialized())
        return false;

    const b8 useHwTrace = this.m_rayTracingState.surfelGi.m_surfelUseHwTrace;
    const b8 useCsgTrace = this.m_rayTracingState.surfelGi.m_surfelUseCsgTrace;
    ComputePipelineHandle tracePipeline = this.m_rayTracingState.surfelGi.m_surfelTracePipeline;
    if(useHwTrace){
        tracePipeline = this.m_rayTracingState.surfelGi.m_surfelTraceHwPipeline;
        if(useCsgTrace)
            tracePipeline = this.m_rayTracingState.surfelGi.m_surfelTraceCsgHwPipeline;
    }
    else if(useCsgTrace)
        tracePipeline = this.m_rayTracingState.surfelGi.m_surfelTraceCsgPipeline;

    if(!AreAllSurfelGiPhasePipelinesReady(
        this.m_rayTracingState.surfelGi.m_surfelSpawnPipeline.valid(),
        this.m_rayTracingState.surfelGi.m_surfelAgeFreePipeline.valid(),
        this.m_rayTracingState.surfelGi.m_surfelHashBuildPipeline.valid(),
        tracePipeline.valid(),
        this.m_rayTracingState.surfelGi.m_surfelResolvePipeline.valid(),
        this.m_rayTracingState.surfelGi.m_surfelUpsamplePipeline.valid(),
        this.m_rayTracingState.surfelGi.m_surfelTraceBuildArgsPipeline.valid()
    )){
        error("RendererSystem: active surfel GI phase pipeline is missing");
        return false;
    }

    if(
        !targets.bindless.valid()
        || !IsValidSurfelGiResolveFactor(targets.surfelResolveFactor)
        || !deferredLightingResources.valid()
        || !IsDescriptorClass(this.m_rayTracingState.surfelGi.m_surfelConstantsHeapHandle, GpuDescriptorClass::UniformBuffer)
        || !IsDescriptorClass(this.m_rayTracingState.surfelGi.m_surfelPoolHeapHandle, GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(this.m_rayTracingState.surfelGi.m_surfelGuidePoolHeapHandle, GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(this.m_rayTracingState.surfelGi.m_surfelCellHeadHeapHandle, GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(this.m_rayTracingState.surfelGi.m_surfelCounterHeapHandle, GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(this.m_rayTracingState.surfelGi.m_surfelTraceIndirectArgsHeapHandle, GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(this.m_rayTracingState.surfelGi.m_surfelFreeListHeapHandle, GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(this.m_rayTracingState.surfelGi.m_surfelPoolSnapshotHeapHandle, GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(this.m_rayTracingState.surfelGi.m_surfelCellHeadSnapshotHeapHandle, GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(this.m_rayTracingState.sceneBvh.m_rayTraceMaterialContextSlotsHeapHandle, GpuDescriptorClass::UniformBuffer)
        || !IsDescriptorClass(targets.bindless.slotsBufferDescriptor, GpuDescriptorClass::UniformBuffer)
        || !IsDescriptorClass(targets.bindless.gbufferWorldPosition, GpuDescriptorClass::SampledImage)
        || !IsDescriptorClass(targets.bindless.gbufferNormal, GpuDescriptorClass::SampledImage)
        || !IsDescriptorClass(targets.bindless.surfelIrradianceHalf, GpuDescriptorClass::SampledImage)
        || !IsDescriptorClass(targets.bindless.surfelIrradianceHalfStorage, GpuDescriptorClass::StorageImage)
        || !IsDescriptorClass(targets.bindless.surfelIrradianceStorage, GpuDescriptorClass::StorageImage)
        || (useHwTrace && (!this.m_rayTracingState.sceneBvh.m_tlas || !IsDescriptorClass(this.m_rayTracingState.sceneBvh.m_tlasHeapHandle, GpuDescriptorClass::AccelStruct)))
    ){
        error("RendererSystem: surfel GI heap registration is incomplete");
        return false;
    }

    const u32 poolCapacity = this.m_rayTracingState.surfelGi.m_surfelPoolCapacity;

    SurfelHeapPushConstants surfelPush = MakeSurfelHeapPushConstants(
        this.m_rayTracingState.surfelGi.m_surfelConstantsHeapHandle.slot(),
        this.m_rayTracingState.surfelGi.m_surfelPoolHeapHandle.slot(),
        this.m_rayTracingState.surfelGi.m_surfelGuidePoolHeapHandle.slot(),
        this.m_rayTracingState.surfelGi.m_surfelCellHeadHeapHandle.slot(),
        this.m_rayTracingState.surfelGi.m_surfelCounterHeapHandle.slot(),
        this.m_rayTracingState.surfelGi.m_surfelFreeListHeapHandle.slot(),
        this.m_rayTracingState.surfelGi.m_surfelPoolSnapshotHeapHandle.slot(),
        this.m_rayTracingState.surfelGi.m_surfelCellHeadSnapshotHeapHandle.slot(),
        this.m_rayTracingState.surfelGi.m_surfelTraceIndirectArgsHeapHandle.slot(),
        targets.bindless.slotsBufferDescriptor.slot(),
        this.m_rayTracingState.sceneBvh.m_rayTraceMaterialContextSlotsHeapHandle.slot()
    );

    if(this.m_rayTracingState.surfelGi.m_surfelPoolBuffer.valid())
        commandList.setEnableUavBarriersForBuffer(this.m_rayTracingState.surfelGi.m_surfelPoolBuffer.deref(), true);
    if(this.m_rayTracingState.surfelGi.m_surfelGuidePoolBuffer.valid())
        commandList.setEnableUavBarriersForBuffer(this.m_rayTracingState.surfelGi.m_surfelGuidePoolBuffer.deref(), true);
    if(this.m_rayTracingState.surfelGi.m_surfelCellHeadBuffer.valid())
        commandList.setEnableUavBarriersForBuffer(this.m_rayTracingState.surfelGi.m_surfelCellHeadBuffer.deref(), true);
    if(this.m_rayTracingState.surfelGi.m_surfelCounterBuffer.valid())
        commandList.setEnableUavBarriersForBuffer(this.m_rayTracingState.surfelGi.m_surfelCounterBuffer.deref(), true);
    if(this.m_rayTracingState.surfelGi.m_surfelFreeListBuffer.valid())
        commandList.setEnableUavBarriersForBuffer(this.m_rayTracingState.surfelGi.m_surfelFreeListBuffer.deref(), true);
    if(this.m_rayTracingState.surfelGi.m_surfelTraceIndirectArgsBuffer.valid())
        commandList.setEnableUavBarriersForBuffer(this.m_rayTracingState.surfelGi.m_surfelTraceIndirectArgsBuffer.deref(), true);

    if(dispatchAgeFree){
        GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeSurfelAgeFree, this.m_graphics.getDevice(), commandList);

        commandList.commitBarriers();
        ComputeState state;
        state.setPipeline(this.m_rayTracingState.surfelGi.m_surfelAgeFreePipeline.deref());
        commandList.setComputeState(state);
        heap.bindCompute(commandList, this.m_rayTracingState.surfelGi.m_surfelAgeFreePipeline.deref());
        commandList.setPushConstants(surfelPush);
        commandList.dispatch(ComputeSurfelLinearDispatchGroups(poolCapacity, cast<u32>(s_ShaderSurfelLinearGroupSize)), 1u, 1u);
    }

    if(!HasSurfelPhaseAfterAgeFree(dispatchHashBuild, dispatchSpawn, dispatchTraceBuildArgs, dispatchTrace, dispatchResolve, dispatchRemaining))
        return true;

    if(dispatchHashBuild){
        GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeSurfelHashBuild, this.m_graphics.getDevice(), commandList);

        commandList.commitBarriers();
        ComputeState state;
        state.setPipeline(this.m_rayTracingState.surfelGi.m_surfelHashBuildPipeline.deref());
        commandList.setComputeState(state);
        heap.bindCompute(commandList, this.m_rayTracingState.surfelGi.m_surfelHashBuildPipeline.deref());
        commandList.setPushConstants(surfelPush);
        commandList.dispatch(ComputeSurfelLinearDispatchGroups(poolCapacity, cast<u32>(s_ShaderSurfelLinearGroupSize)), 1u, 1u);
    }

    if(!HasSurfelPhaseAfterHashBuild(dispatchSpawn, dispatchTraceBuildArgs, dispatchTrace, dispatchResolve, dispatchRemaining))
        return true;

    if(dispatchSpawn){
        GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeSurfelSpawn, this.m_graphics.getDevice(), commandList);

        commandList.commitBarriers();

        ApplySurfelSpawnPushConstantSlots(surfelPush, targets.bindless.gbufferWorldPosition.slot(), targets.bindless.gbufferNormal.slot());

        ComputeState state;
        state.setPipeline(this.m_rayTracingState.surfelGi.m_surfelSpawnPipeline.deref());
        commandList.setComputeState(state);
        heap.bindCompute(commandList, this.m_rayTracingState.surfelGi.m_surfelSpawnPipeline.deref());
        commandList.setPushConstants(surfelPush);
        commandList.dispatch(ResolveSurfelSpawnDispatchGroup(targets.width, cast<u32>(s_ShaderSurfelGroupSize)), ResolveSurfelSpawnDispatchGroup(targets.height, cast<u32>(s_ShaderSurfelGroupSize)), 1u);
    }

    if(!HasSurfelPhaseAfterSpawn(dispatchTraceBuildArgs, dispatchTrace, dispatchResolve, dispatchRemaining))
        return true;

    if(dispatchTraceBuildArgs){
        commandList.commitBarriers();
        ComputeState state;
        state.setPipeline(this.m_rayTracingState.surfelGi.m_surfelTraceBuildArgsPipeline.deref());
        commandList.setComputeState(state);
        heap.bindCompute(commandList, this.m_rayTracingState.surfelGi.m_surfelTraceBuildArgsPipeline.deref());
        commandList.setPushConstants(surfelPush);
        commandList.dispatch(s_ShaderSurfelTraceBuildArgsDispatchGroupCountX, s_ShaderSurfelTraceBuildArgsDispatchGroupCountY, s_ShaderSurfelTraceBuildArgsDispatchGroupCountZ);
    }

    if(!HasSurfelPhaseAfterTraceBuildArgs(dispatchTrace, dispatchResolve, dispatchRemaining))
        return true;

    if(dispatchTrace){
        GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeSurfelTrace, this.m_graphics.getDevice(), commandList);

        commandList.commitBarriers();
        ComputeState state;
        state.setPipeline(tracePipeline.deref());
        state.setIndirectParams(this.m_rayTracingState.surfelGi.m_surfelTraceIndirectArgsBuffer.deref());
        commandList.setComputeState(state);
        if(this.m_rayTracingState.surfelGi.m_surfelUseHwTrace && !this.m_rayTracingState.sceneBvh.m_tlasHeapHandle.valid()){
            error("RendererSystem: cannot dispatch surfel HW GI without the descriptor-heap TLAS handle");
            return false;
        }
        GpuDescriptorHandle tlasHeapHandle = GpuDescriptorHandleInvalid();
        if(this.m_rayTracingState.surfelGi.m_surfelUseHwTrace)
            tlasHeapHandle = this.m_rayTracingState.sceneBvh.m_tlasHeapHandle;
        heap.bindCompute(commandList, tracePipeline.deref(), tlasHeapHandle);
        commandList.setPushConstants(surfelPush);
        commandList.dispatchIndirect(0u);
    }

    if(!HasSurfelPhaseAfterTrace(dispatchResolve, dispatchRemaining))
        return true;

    if(dispatchResolve){
        const SurfelGiResolveSize resolveSize = MakeSurfelGiResolveSize(targets.width, targets.height, targets.surfelResolveFactor);
        {
            GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeSurfelResolve, this.m_graphics.getDevice(), commandList);

            commandList.commitBarriers();

            ApplySurfelResolvePushConstantSlots(surfelPush, targets.bindless.gbufferWorldPosition.slot(), targets.bindless.gbufferNormal.slot(), targets.bindless.surfelIrradianceHalfStorage.slot());

            ComputeState state;
            state.setPipeline(this.m_rayTracingState.surfelGi.m_surfelResolvePipeline.deref());
            commandList.setComputeState(state);
            heap.bindCompute(commandList, this.m_rayTracingState.surfelGi.m_surfelResolvePipeline.deref());
            commandList.setPushConstants(surfelPush);
            const u32 groupSize = cast<u32>(s_ShaderSurfelResolveGroupSize);
            commandList.dispatch(DivideUp(resolveSize.width, groupSize), DivideUp(resolveSize.height, groupSize), 1u);
            if(commandList.commandRecordingFailed())
                return false;
            LogSurfelGiResolveDispatchIfNeeded(targets.surfelResolveFactor, targets.width, targets.height, resolveSize, this.m_rayTracingState.surfelGi.m_surfelResolveDispatchLogged);
        }
    }

    if(!dispatchRemaining)
        return true;

    {
        GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeSurfelUpsample, this.m_graphics.getDevice(), commandList);

        commandList.commitBarriers();

        ApplySurfelUpsamplePushConstantSlots(
            surfelPush,
            targets.bindless.surfelIrradianceHalf.slot(),
            targets.bindless.gbufferNormal.slot(),
            targets.bindless.gbufferWorldPosition.slot(),
            targets.bindless.surfelIrradianceStorage.slot()
        );

        ComputeState state;
        state.setPipeline(this.m_rayTracingState.surfelGi.m_surfelUpsamplePipeline.deref());
        commandList.setComputeState(state);
        heap.bindCompute(commandList, this.m_rayTracingState.surfelGi.m_surfelUpsamplePipeline.deref());
        commandList.setPushConstants(surfelPush);
        const u32 groupSize = cast<u32>(s_ShaderSurfelUpsampleGroupSize);
        commandList.dispatch(DivideUp(targets.width, groupSize), DivideUp(targets.height, groupSize), 1u);
    }

    {
        const u32 frameIndex = this.m_rayTracingState.surfelGi.m_surfelFrameIndex;
        const QueueSubmissionToken submissionToken = this.m_rayTracingState.surfelGi.m_surfelCountReadbackSubmissionToken;
        b8 submissionComplete = false;
        if(submissionToken.valid() && submissionToken.hasPhysicalQueueIdentity()){
            GpuPhysicalQueueId queue;
            queue.index = submissionToken.physicalQueueIndex;
            queue.deviceGeneration = submissionToken.deviceGeneration;
            const Expected<u64> completedValue = this.m_graphics.getDevice().queueGetCompletedInstance(queue);
            submissionComplete = completedValue.has_value() && HasCompletedSurfelCountReadbackValue(completedValue.value(), submissionToken.value);
        }
        if(submissionComplete && IsSurfelCountReadbackDelayElapsed(frameIndex, this.m_rayTracingState.surfelGi.m_surfelCountReadbackFrame)){
            Array<u32, s_SurfelReadbackCounterCount> counts;
            if(this.m_graphics.getDevice().readMappedBuffer(this.m_rayTracingState.surfelGi.m_surfelCounterReadback.deref(), counts)){
                const u32 bumpTop = counts[s_ShaderSurfelCounterBumpTop];
                const u32 freeTop = counts[s_ShaderSurfelCounterFreeTop];
                const u32 geometryFailures = counts[s_ShaderSurfelCounterTraceGeometryFailure];
                LogSurfelCountReadbackCounts(
                    bumpTop,
                    freeTop,
                    geometryFailures,
                    this.m_rayTracingState.surfelGi.m_surfelPoolCapacity,
                    this.m_rayTracingState.surfelGi.m_surfelTraceGeometryFailureFlags
                );
            }
            this.m_rayTracingState.surfelGi.m_surfelCountReadbackSubmissionToken = QueueSubmissionToken();
        }
    }

    AdvanceSurfelGiFrameState(this.m_rayTracingState.surfelGi.m_surfelSeeded, this.m_rayTracingState.surfelGi.m_surfelFrameIndex);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

