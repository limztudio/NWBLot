class StemExtensionCase{
    public StringView input;
    public StringView stem;
    public StringView extension;

    public StemExtensionCase(in StringView inInput, in StringView inStem, in StringView inExtension){
        this.input = inInput;
        this.stem = inStem;
        this.extension = inExtension;
    }
}

class RelativeAssetPathCase{
    public StringView input;
    public StringView expected;
    public b8 accepted;

    public RelativeAssetPathCase(in StringView inInput, in StringView inExpected, in b8 inAccepted){
        this.input = inInput;
        this.expected = inExpected;
        this.accepted = inAccepted;
    }
}

class NamedRegistryAsset : IAsset{
    [cpp_base(IAsset, type, path)]
    public NamedRegistryAsset(in borrow Name type, in borrow Name path){}
}

class LeafProbe : IAssetCodec{
    [cpp_base(IAssetCodec, type)]
    public LeafProbe(in borrow Name type){}

    public Expected<UniquePtr<IAsset>> deserialize(in Name path, in Span<u8> bytes, mut GlobalAllocator storage)const override{
        UniquePtr<IAsset> result = MakeUnique<NamedRegistryAsset>(ProbeAssetType(this), path);
        return result;
    }
    public b8 serialize(in IAsset asset, mut AssetByteBuffer bytes)const override{ return true; }
}

class BlockingProbe : IAssetCodec{
    private in AssetRegistry m_registry;
    private Name m_leafType;
    private mut TestAtomic<b8> m_entered;
    private mut TestAtomic<b8> m_release;
    private mut TestAtomic<b8> m_destroyedWhileActive;
    private mut TestAtomic<b8> m_inFlight;

    [cpp_base(IAssetCodec, type)]
    public BlockingProbe(in borrow Name type, in AssetRegistry registry, in Name leafType, mut TestAtomic<b8> entered, mut TestAtomic<b8> release, mut TestAtomic<b8> destroyedWhileActive, mut TestAtomic<b8> inFlight){
        this.m_registry = registry;
        this.m_leafType = leafType;
        this.m_entered = entered;
        this.m_release = release;
        this.m_destroyedWhileActive = destroyedWhileActive;
        this.m_inFlight = inFlight;
    }

    public Expected<UniquePtr<IAsset>> deserialize(in Name path, in Span<u8> bytes, mut GlobalAllocator storage)const override{
        this.m_inFlight.store(true, MemoryOrder::seq_cst);
        const auto nested = this.m_registry.deserializeAsset(this.m_leafType, s_AssetCaseProjectProbeLeaf, bytes);
        if(!nested.has_value()){
            this.m_inFlight.store(false, MemoryOrder::seq_cst);
            return MakeUnexpected(Failure());
        }
        this.m_entered.store(true, MemoryOrder::seq_cst);
        while(!this.m_release.load(MemoryOrder::seq_cst))
            YieldThread();
        this.m_inFlight.store(false, MemoryOrder::seq_cst);
        UniquePtr<IAsset> result = MakeUnique<NamedRegistryAsset>(ProbeAssetType(this), path);
        return result;
    }

    public ~BlockingProbe(){
        if(this.m_inFlight.load(MemoryOrder::seq_cst))
            this.m_destroyedWhileActive.store(true, MemoryOrder::seq_cst);
    }
    public b8 serialize(in IAsset asset, mut AssetByteBuffer bytes)const override{ return true; }
}


