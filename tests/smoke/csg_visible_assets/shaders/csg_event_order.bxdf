////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifdef NWB_GRAPHICS_DEFERRED_LIGHTING_FRAMEWORK_SLANGI
#include "csg_event_diagnostic_inputs.slangi"
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


half3 NWB_DEFERRED_BXDF_FUNCTION(NwbBxdfSurface surface, int2 pixel){
#ifdef NWB_GRAPHICS_DEFERRED_LIGHTING_FRAMEWORK_SLANGI
    uint eventDataSlot;
    uint eventLayers;
    if(!nwbCsgDiagnosticEventBounds(pixel, eventDataSlot, eventLayers))
        return half3(0.0h);
    const half spanState = nwbCsgDiagnosticSpanState(pixel);
    const uint eventCountSlot = g_NwbDeferredBindlessResources.csgSpanSlots.x;
    const uint eventCount = nwbHeapStorageImage2DArrayUint(eventCountSlot).Load(int3(pixel, 0));
    if(eventCount != 2u || eventLayers < 2u)
        return half3(half(spanState), 0.0h, 0.0h);
    uint receiverIndex;
    if(!nwbCsgDiagnosticReceiverIndex(pixel, receiverIndex) || receiverIndex == NWB_CSG_INVALID_RECEIVER_INDEX)
        return half3(half(spanState), 0.0h, 0.0h);
    const uint4 firstEvent = nwbHeapStorageImage2DArrayUint4(eventDataSlot).Load(int3(pixel, 0));
    const uint4 secondEvent = nwbHeapStorageImage2DArrayUint4(eventDataSlot).Load(int3(pixel, 1));
    const bool firstFront = firstEvent.y == NWB_CSG_RECEIVER_EVENT_FACE_FRONT;
    const bool firstBack = firstEvent.y == NWB_CSG_RECEIVER_EVENT_FACE_BACK;
    const bool secondFront = secondEvent.y == NWB_CSG_RECEIVER_EVENT_FACE_FRONT;
    const bool secondBack = secondEvent.y == NWB_CSG_RECEIVER_EVENT_FACE_BACK;
    const bool matchingPair = firstEvent.x == receiverIndex && secondEvent.x == receiverIndex && ((firstFront && secondBack) || (firstBack && secondFront));
    const float frontDepth = asfloat(firstFront ? firstEvent.z : secondEvent.z);
    const float backDepth = asfloat(firstFront ? secondEvent.z : firstEvent.z);
    const bool validatedPair = matchingPair && isfinite(frontDepth) && isfinite(backDepth) && backDepth > frontDepth;
    // Arrival order is exposed only after the same-frame pair passes every receiver, face, and depth check.
    const half firstFace = validatedPair ? (firstFront ? 1.0h : 0.5h) : 0.0h;
    const half secondFace = validatedPair ? (secondFront ? 1.0h : 0.5h) : 0.0h;
    return half3(half(spanState), firstFace, secondFace);
#else
    return half3(0.0h);
#endif
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

