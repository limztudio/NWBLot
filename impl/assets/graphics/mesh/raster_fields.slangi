////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_MESH_RASTER_FIELDS_SLANGI
#define NWB_GRAPHICS_MESH_RASTER_FIELDS_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "runtime_constants.h"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Mesh colors, normals, and tangents remain 16-bit in mesh storage, and material arithmetic can retain half where
// precision permits. Raster stage interfaces use float so Vulkan devices without storageInputOutput16 can
// run both native mesh and emulation paths; assignment conversion promotes attributes at the stage boundary. UVs,
// world positions, clip positions, and depth remain float for derivative, transform, and CSG precision.
#define NWB_MESH_RASTER_PAYLOAD_FIELDS \
    [[vk::location(NWB_MESH_RASTER_COLOR_LOCATION)]] float4 color : COLOR0; \
    [[vk::location(NWB_MESH_RASTER_NORMAL_LOCATION)]] float3 normal : NORMAL0; \
    [[vk::location(NWB_MESH_RASTER_TANGENT_LOCATION)]] float4 tangent : TANGENT0; \
    [[vk::location(NWB_MESH_RASTER_UV0_LOCATION)]] float2 uv0 : TEXCOORD0; \
    [[vk::location(NWB_MESH_RASTER_WORLD_POSITION_LOCATION)]] float4 worldPosition : TEXCOORD1;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct NwbMeshRasterVertex{
    float4 position : SV_Position;
    NWB_MESH_RASTER_PAYLOAD_FIELDS
};

NwbMeshRasterVertex nwbMeshBuildRasterVertex(
    const float4 position,
    const half4 color,
    const half3 normal,
    const half4 tangent,
    const float2 uv0,
    const float4 worldPosition
){
    NwbMeshRasterVertex vertex;
    vertex.position = position;
    vertex.color = color;
    vertex.normal = normal;
    vertex.tangent = tangent;
    vertex.uv0 = uv0;
    vertex.worldPosition = worldPosition;
    return vertex;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

