////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/input/input.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class InputCommandState : NoCopy{
    public void reserve(){
        this.m_sources.reserve(s_InputSourceReserve);
    }

    public void clearFocus(){
        ClearRouterCommandFocusState(this.m_sources, this.m_focus, this.m_focusDeclaration, this.m_focusControl);
    }

    public b8 wants(in Span<PopupRecord> popups)const{
        return WantsRouterCommands(popups, this.m_focus, this.m_sources);
    }

    public b8 owns(in InputSource source)const{
        return OwnsRouterCommandSource(this.m_sources, source);
    }

    public b8 canEdit(in Span<HitTarget> targets, in Span<TargetLookup> lookup, in Span<PopupRecord> popups, in b8 windowFocused, in InputEvent event)const{
        return CanRouterEditCommand(targets, lookup, popups, this.m_sources, windowFocused, this.m_focus, this.m_focusDeclaration, event);
    }

    public b8 canSubmit(in Span<HitTarget> targets, in Span<TargetLookup> lookup, in Span<PopupRecord> popups, in b8 windowFocused, in InputEvent event)const{
        return CanRouterSubmitCommand(targets, lookup, popups, this.m_sources, windowFocused, this.m_focus, this.m_focusDeclaration, event);
    }

    public void cancelSubmit(in WidgetId id){
        CancelRouterSubmitCommands(id, this.m_sources);
    }

    public b8 isPressed(in Span<HitTarget> targets, in Span<TargetLookup> lookup, in Span<PopupRecord> popups, in b8 windowFocused, in WidgetId id)const{
        return IsRouterTargetPressedByCommand(targets, lookup, popups, this.m_sources, windowFocused, this.m_focus, this.m_focusDeclaration, id);
    }

    public mut Vector<CommandSource> records(){
        return this.m_sources;
    }

    public mut WidgetId focus(){
        return this.m_focus;
    }

    public WidgetId focus()const{
        return this.m_focus;
    }

    public mut u64 declaration(){
        return this.m_focusDeclaration;
    }

    public mut ControlToken control(){
        return this.m_focusControl;
    }

    private Vector<CommandSource> m_sources;
    private WidgetId m_focus;
    private ControlToken m_focusControl;
    private u64 m_focusDeclaration = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

