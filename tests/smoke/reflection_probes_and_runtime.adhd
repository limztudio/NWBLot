namespace Tests::Smoke{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ReflectionSmokeConfiguration final{
public:
    [[nodiscard]] static b8 ReadFlag(AStringView name, Core::Alloc::ScratchArena& scratchArena, b8& value);
    [[nodiscard]] b8 configure(Impl::RendererSystem& renderer, Core::GraphicsRuntime& graphics, b8 extendedCase, b8 feedbackCase, b8 opticalCase, b8 furnace, b8 opticalTir, Core::Alloc::ScratchArena& scratchArena);
    [[nodiscard]] Impl::ReflectionSettings& settings()noexcept{ return m_settings; }
    [[nodiscard]] const Impl::ReflectionSettings& settings()const noexcept{ return m_settings; }
    [[nodiscard]] u32 targetSamples()const noexcept{ return m_targetSamples; }
    [[nodiscard]] u32 postResetSamples()const noexcept{ return m_postResetSamples; }
    [[nodiscard]] u32 requestedSeed()const noexcept{ return m_requestedSeed; }
    [[nodiscard]] f32 authoredRoughness()const noexcept{ return m_authoredRoughness; }
    [[nodiscard]] b8 feedbackCapture()const noexcept{ return m_feedbackCapture; }
    [[nodiscard]] b8 freshFinalState()const noexcept{ return m_freshFinalState; }


private:
    [[nodiscard]] static b8 ReadU32(AStringView name, u32 minimum, u32 maximum, Core::Alloc::ScratchArena& scratchArena, u32& value);


private:
    Impl::ReflectionSettings m_settings;
    u32 m_targetSamples = 16u;
    u32 m_postResetSamples = 1u;
    u32 m_requestedSeed = 0u;
    f32 m_authoredRoughness = 0.f;
    b8 m_feedbackCapture = false;
    b8 m_freshFinalState = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_reflection_smoke_configuration{
inline constexpr AStringView s_HardwareRoute = s_ReflectionSmokeHardwareRoute;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ReflectionSmokeConfiguration::ReadFlag(const AStringView name, NWB::Core::Alloc::ScratchArena& scratchArena, b8& value){
    const auto text = ReadSmokeEnvironmentText(scratchArena, name);
    if(!text)
        return true;
    if(*text == "0")
        value = false;
    else if(*text == "1")
        value = true;
    else{
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionSmokeProjectImpl: {} must be 0 or 1"), ConvertString(name));
        return false;
    }
    return true;
}

b8 ReflectionSmokeConfiguration::ReadU32(const AStringView name, const u32 minimum, const u32 maximum, NWB::Core::Alloc::ScratchArena& scratchArena, u32& value){
    const auto text = ReadSmokeEnvironmentText(scratchArena, name);
    if(!text)
        return true;
    const auto parsed = ParseU64(AStringView(text->data(), text->size()));
    if(!parsed || *parsed < minimum || *parsed > maximum){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionSmokeProjectImpl: {} must be in [{}, {}]"), ConvertString(name), minimum, maximum);
        return false;
    }
    value = static_cast<u32>(*parsed);
    return true;
}


b8 ReflectionSmokeConfiguration::configure(Impl::RendererSystem& renderer, Core::GraphicsRuntime& graphics, const b8 extendedCase, const b8 feedbackCase, const b8 opticalCase, const b8 furnace, const b8 opticalTir, Core::Alloc::ScratchArena& scratchArena){
    using namespace __hidden_reflection_smoke_configuration;
    auto& settings = m_settings;
    settings.traceMode = NWB::Impl::ReflectionTraceMode::Hardware;
    settings.environmentTop = Float3U(0.0f, 0.0f, 0.0f);
    settings.environmentBottom = Float3U(0.0f, 0.0f, 0.0f);
    settings.maxHardwareRaysPerFrame = 2u * 960u * 720u;
    settings.diagnosticsEnabled = true;
    settings.temporalEnabled = extendedCase && !opticalCase && !feedbackCase;
    settings.spatialFilterEnabled = false;
    m_targetSamples = extendedCase && !opticalCase ? 64u : 16u;
    if(
        !ReadFlag("NWB_REFLECTION_SMOKE_DIAGNOSTICS", scratchArena, settings.diagnosticsEnabled)
        || !ReadFlag("NWB_REFLECTION_SMOKE_FEEDBACK", scratchArena, settings.screenFeedbackEnabled)
        || !ReadFlag("NWB_REFLECTION_SMOKE_FEEDBACK_CAPTURE", scratchArena, m_feedbackCapture)
        || !ReadFlag("NWB_REFLECTION_SMOKE_TEMPORAL", scratchArena, settings.temporalEnabled)
        || !ReadFlag("NWB_REFLECTION_SMOKE_SPATIAL", scratchArena, settings.spatialFilterEnabled)
        || !ReadFlag("NWB_REFLECTION_SMOKE_FINAL_STATE", scratchArena, m_freshFinalState)
        || !ReadU32("NWB_REFLECTION_SMOKE_HISTORY_SAMPLES", 1u, 256u, scratchArena, m_targetSamples)
        || !ReadU32("NWB_REFLECTION_SMOKE_POST_RESET_SAMPLES", 1u, 256u, scratchArena, m_postResetSamples)
        || !ReadU32("NWB_REFLECTION_SMOKE_SEED", 0u, Limit<u32>::s_Max, scratchArena, m_requestedSeed)
        || !ReadU32("NWB_REFLECTION_SMOKE_OPTICAL_QUERIES", 1u, 16u, scratchArena, settings.maxOpticalQueries)
        || !ReadU32("NWB_REFLECTION_SMOKE_SCREEN_STEPS", 1u, 256u, scratchArena, settings.screenMaxSteps)
    )
        return false;
    settings.temporalMaxSamples = m_targetSamples;
    settings.samplingSeed = m_freshFinalState ? m_requestedSeed + 1u : m_requestedSeed;
    if(extendedCase && !feedbackCase){
        m_authoredRoughness = 0.4f;
        const auto roughnessText = ReadSmokeEnvironmentText(scratchArena, "NWB_REFLECTION_SMOKE_ROUGHNESS");
        if(roughnessText){
            const auto roughness = ParseF32FromChars(AStringView(roughnessText->data(), roughnessText->size()));
            if(!roughness || !IsFinite(*roughness) || *roughness < 0.f || *roughness > 1.f)
                return false;
            m_authoredRoughness = *roughness;
        }
        NWB::Impl::PresentationSettings presentation;
        presentation.shoulder = 1.f;
        if(!renderer.setPresentationSettings(presentation))
            return false;
    }
    if(furnace || opticalTir){
        settings.environmentTop = Float3U(1.f, 1.f, 1.f);
        settings.environmentBottom = Float3U(1.f, 1.f, 1.f);
        settings.roughnessCutoff = 1.f;
    }
    const auto budgetText = ReadSmokeEnvironmentText(scratchArena, "NWB_REFLECTION_SMOKE_RAY_BUDGET");
    if(budgetText){
        const auto parsed = ParseU64(AStringView(budgetText->data(), budgetText->size()));
        if(!parsed || *parsed > Limit<u32>::s_Max){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionSmokeProjectImpl: ray budget must be a nonnegative u32"));
            return false;
        }
        settings.maxHardwareRaysPerFrame = static_cast<u32>(*parsed);
    }
    const auto routeText = ReadSmokeEnvironmentText(scratchArena, "NWB_REFLECTION_SMOKE_MODE");
    const b8 hasRoute = routeText.has_value();
    const AStringView route = hasRoute ? AStringView(routeText->data(), routeText->size()) : AStringView(s_HardwareRoute);
    if(route == "disabled")
        settings.traceMode = NWB::Impl::ReflectionTraceMode::Disabled;
    else if(route == "screen")
        settings.traceMode = NWB::Impl::ReflectionTraceMode::ScreenSpace;
    else if(route == "hybrid")
        settings.traceMode = NWB::Impl::ReflectionTraceMode::Hybrid;
    else if(route != s_HardwareRoute){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionSmokeProjectImpl: unknown reflection mode '{}'"), ConvertString(route));
        return false;
    }
    const auto debugText = ReadSmokeEnvironmentText(scratchArena, "NWB_REFLECTION_SMOKE_DEBUG");
    if(debugText){
        const AStringView debugView(debugText->data(), debugText->size());
        if(debugView == "source")
            settings.debugView = NWB::Impl::ReflectionDebugView::TraceSource;
        else if(debugView == "confidence")
            settings.debugView = NWB::Impl::ReflectionDebugView::Confidence;
        else if(debugView != "none"){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionSmokeProjectImpl: unknown debug view '{}'"), ConvertString(debugView));
            return false;
        }
    }
    if(!renderer.setReflectionSettings(settings))
        return false;
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSmokeProjectImpl: screen feedback {}"), settings.screenFeedbackEnabled ? 1u : 0u);
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSmokeProjectImpl: screen steps {}"), settings.screenMaxSteps);
    renderer.setRefractionEnabled(true);
    renderer.setRefractionHardwareTracingEnabled(true);
    const b8 hardwareAvailable = graphics.queryFeatureSupport(NWB::Core::Feature::RayTracingAccelStruct) && graphics.queryFeatureSupport(NWB::Core::Feature::RayQuery);
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSmokeProjectImpl: hardware {}"), hardwareAvailable ? FOUNDATION_TEXT("available") : FOUNDATION_TEXT("unavailable"));
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSmokeProjectImpl: reflection mode {}"), ConvertString(route));
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSmokeProjectImpl: hardware ray budget {}"), settings.maxHardwareRaysPerFrame);
    if(opticalCase)
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSmokeProjectImpl: optical query limit {}"), settings.maxOpticalQueries);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Observes completed reflection history and timing without owning renderer resources.
class ReflectionSpatialOwnerProbe final{
public:
    ReflectionSpatialOwnerProbe(ProjectRuntimeContext& context, Impl::RendererSystem& renderer)noexcept;


public:
    [[nodiscard]] b8 configure(AStringView selection, Impl::ReflectionSettings& settings);
    [[nodiscard]] b8 update(const Impl::ReflectionStatistics& statistics, const Core::Perf::TimingView& timing, Impl::ReflectionSettings& settings);
    [[nodiscard]] b8 shouldCapture(u64 graphicsFrame)const noexcept{ return m_finalReset && graphicsFrame == m_finalSource; }
    [[nodiscard]] b8 canFinish(const Impl::ReflectionStatistics& statistics, u64 capturedSource)const noexcept;


private:
    [[nodiscard]] b8 observeTiming(const Core::Perf::TimingView& timing);
    [[nodiscard]] b8 beginPhase(Impl::ReflectionSettings& settings);


private:
    Core::Perf::TimingStats m_phaseWork;
    Core::Perf::TimingStats m_captureWork;
    Array<u32, 4u> m_radii = { 1u, 3u, 2u, 1u };
    ProjectRuntimeContext& m_context;
    Impl::RendererSystem& m_renderer;
    u64 m_phaseSource = Limit<u64>::s_Max;
    u64 m_finalSource = Limit<u64>::s_Max;
    u64 m_lastPublish = 0u;
    u32 m_phase = 0u;
    u32 m_lastPhase = 0u;
    b8 m_started = false;
    b8 m_finalReset = false;
    b8 m_hasPublication = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


ReflectionSpatialOwnerProbe::ReflectionSpatialOwnerProbe(ProjectRuntimeContext& context, Impl::RendererSystem& renderer)noexcept
    : m_context(context)
    , m_renderer(renderer)
{}

b8 ReflectionSpatialOwnerProbe::configure(const AStringView selection, Impl::ReflectionSettings& settings){
    if(selection == "fresh1")
        m_radii[0] = 1u;
    else if(selection == "fresh2")
        m_radii[0] = 2u;
    else if(selection == "fresh3")
        m_radii[0] = 3u;
    else if(selection == "sequence3")
        m_lastPhase = 1u;
    else if(selection == "sequence2")
        m_lastPhase = 2u;
    else if(selection == "sequence1")
        m_lastPhase = 3u;
    else{
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionSpatialOwner: unknown selection"));
        return false;
    }
    if(settings.traceMode != Impl::ReflectionTraceMode::Hardware || !settings.diagnosticsEnabled || !settings.temporalEnabled || settings.temporalMaxSamples != 1u || !settings.spatialFilterEnabled || settings.screenFeedbackEnabled){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionSpatialOwner: requires hardware, diagnostics, spatial, temporal cap1 and feedback off"));
        return false;
    }
    settings.spatialRadius = m_radii[0];
    settings.samplingSeed = 99u;
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSpatialOwner: selection={} initial_radius={} final_radius={} phases={}"), ConvertString(selection), m_radii[0], m_radii[m_lastPhase], m_lastPhase + 1u);
    return true;
}

b8 ReflectionSpatialOwnerProbe::update(const Impl::ReflectionStatistics& statistics, const Core::Perf::TimingView& timing, Impl::ReflectionSettings& settings){
    if(!observeTiming(timing))
        return false;
    if(m_finalReset || statistics.sequence == 0u || !statistics.hardwareReady || !statistics.historyEligible)
        return true;
    if(!m_started){
        if(statistics.frameIndex < 3u)
            return true;
        return beginPhase(settings);
    }
    const u32 phaseSeed = 101u + m_phase;
    if(
        statistics.samplingSeed != phaseSeed || statistics.historyStartGraphicsFrame != m_phaseSource
        || statistics.historySampleCount != 1u || statistics.sampleIndex < 2u
        || !m_phaseWork.valid() || statistics.graphicsFrameIndex < m_phaseWork.lastSampleFrameIndex
    )
        return true;
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSpatialOwnerWarm: index={} sequence={} generation={} graphics_frame={} epoch={}") FOUNDATION_TEXT(" start_graphics_frame={} sample_index={} seed={} work_publish={} work_first={} work_last={} work_samples={}")
        , m_phase, statistics.sequence, statistics.generation, statistics.graphicsFrameIndex, statistics.historyEpoch
        , statistics.historyStartGraphicsFrame, statistics.sampleIndex, statistics.samplingSeed
        , m_phaseWork.publishFrameIndex, m_phaseWork.firstSampleFrameIndex, m_phaseWork.lastSampleFrameIndex, m_phaseWork.sampleCount
    );
    if(m_phase < m_lastPhase){
        ++m_phase;
        return beginPhase(settings);
    }
    settings.samplingSeed = 0u;
    if(!m_renderer.setReflectionSettings(settings)){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionSpatialOwner: final seed reset rejected"));
        return false;
    }
    m_finalSource = m_context.graphics.getFrameIndex();
    m_finalReset = true;
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSpatialOwnerCapture: radius={} graphics_frame={} seed=0"), settings.spatialRadius, m_finalSource);
    return true;
}

b8 ReflectionSpatialOwnerProbe::canFinish(const Impl::ReflectionStatistics& statistics, const u64 capturedSource)const noexcept{
    return
        m_finalReset && capturedSource == m_finalSource && m_captureWork.valid()
        && statistics.hardwareReady && statistics.historyEligible && statistics.samplingSeed == 0u
        && statistics.historyStartGraphicsFrame == m_finalSource
        && statistics.graphicsFrameIndex >= Max(capturedSource, m_captureWork.lastSampleFrameIndex)
    ;
}

b8 ReflectionSpatialOwnerProbe::observeTiming(const Core::Perf::TimingView& timing){
    const Core::Perf::TimingStats& work = timing.stats(Impl::ReflectionGpuTimingScope::s_Spatial.identity);
    if(!work.valid() || (m_hasPublication && work.publishFrameIndex == m_lastPublish))
        return true;
    if((m_hasPublication && work.publishFrameIndex < m_lastPublish) || work.firstSampleFrameIndex > work.lastSampleFrameIndex || work.sampleCount > work.lastSampleFrameIndex - work.firstSampleFrameIndex + 1u || !IsFinite(work.seconds) || work.seconds < 0.0){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionSpatialOwner: invalid completed spatial window"));
        return false;
    }
    m_hasPublication = true;
    m_lastPublish = work.publishFrameIndex;
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSpatialOwnerWork: publish={} first={} last={} samples={}"), work.publishFrameIndex, work.firstSampleFrameIndex, work.lastSampleFrameIndex, work.sampleCount);
    if(m_started && !m_finalReset && !m_phaseWork.valid() && work.firstSampleFrameIndex >= m_phaseSource)
        m_phaseWork = work;
    // Require one completed spatial timing range per source frame in the window.
    if(m_finalReset && work.firstSampleFrameIndex <= m_finalSource && work.lastSampleFrameIndex >= m_finalSource && work.sampleCount == work.lastSampleFrameIndex - work.firstSampleFrameIndex + 1u)
        m_captureWork = work;
    return true;
}

b8 ReflectionSpatialOwnerProbe::beginPhase(Impl::ReflectionSettings& settings){
    settings.spatialRadius = m_radii[m_phase];
    settings.samplingSeed = 101u + m_phase;
    if(!m_renderer.setReflectionSettings(settings)){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionSpatialOwner: radius transition rejected"));
        return false;
    }
    m_phaseSource = m_context.graphics.getFrameIndex();
    m_phaseWork = {};
    m_started = true;
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSpatialOwnerPhase: index={} radius={} seed={} graphics_frame={}"), m_phase, settings.spatialRadius, settings.samplingSeed, m_phaseSource);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ReflectionStatisticsReporter final{
public:
    [[nodiscard]] b8 poll(Impl::RendererSystem& renderer);
    [[nodiscard]] const Impl::ReflectionStatistics& latest()const noexcept{ return m_latestStatistics; }
    [[nodiscard]] b8 feedbackObservedBypass()const noexcept{ return m_feedbackObservedBypass; }


private:
    u64 m_statisticsSequence = 0u;
    u64 m_statisticsGeneration = 0u;
    Impl::ReflectionStatistics m_latestStatistics;
    b8 m_feedbackObservedBypass = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ReflectionStatisticsReporter::poll(Impl::RendererSystem& renderer){
    const auto statisticsResult = renderer.tryGetLatestReflectionStatistics();
    if(!statisticsResult)
        return false;
    const NWB::Impl::ReflectionStatistics& statistics = *statisticsResult;
    if(statistics.sequence == m_statisticsSequence && statistics.generation == m_statisticsGeneration)
        return false;
    m_statisticsSequence = statistics.sequence;
    m_statisticsGeneration = statistics.generation;
    m_latestStatistics = statistics;
    m_feedbackObservedBypass = m_feedbackObservedBypass || statistics.feedbackBypassedPixels > 0u;
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSmokeStatistics: sequence={} generation={} frame={} mode={} width={} height={}")
        FOUNDATION_TEXT(" requested_budget={} effective_budget={} queue_capacity={} hardware_requested={} hardware_available={} hardware_ready={}")
        FOUNDATION_TEXT(" token_queue={} token_value={} physical_queue={} device_generation={}")
        FOUNDATION_TEXT(" candidates={} hardware_rays={} hardware_hits={} opaque_pixels={} glass_pixels={} fallback_pixels={}")
        FOUNDATION_TEXT(" screen_attempts={} screen_hits={}")
        , statistics.sequence
        , statistics.generation
        , statistics.frameIndex
        , static_cast<u32>(statistics.traceMode)
        , statistics.width
        , statistics.height
        , statistics.requestedHardwareBudget
        , statistics.effectiveHardwareBudget
        , statistics.queueCapacity
        , statistics.hardwareRequested ? 1u : 0u
        , statistics.hardwareAvailable ? 1u : 0u
        , statistics.hardwareReady ? 1u : 0u
        , static_cast<u32>(statistics.acceptedToken.queue)
        , statistics.acceptedToken.value
        , statistics.acceptedToken.physicalQueueIndex
        , statistics.acceptedToken.deviceGeneration
        , statistics.candidates
        , statistics.hardwareRays
        , statistics.hardwareHits
        , statistics.opaquePixels
        , statistics.glassPixels
        , statistics.fallbackPixels
        , statistics.screenAttempts
        , statistics.screenHits
    );
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSmokeHistory: sequence={} generation={} graphics_frame={} epoch={}") FOUNDATION_TEXT(" start_graphics_frame={} count={} sample_index={} seed={} eligible={} reused={} reset={} reason={}")
        , statistics.sequence
        , statistics.generation
        , statistics.graphicsFrameIndex
        , statistics.historyEpoch
        , statistics.historyStartGraphicsFrame
        , statistics.historySampleCount
        , statistics.sampleIndex
        , statistics.samplingSeed
        , statistics.historyEligible ? 1u : 0u
        , statistics.historyReused ? 1u : 0u
        , statistics.historyReset ? 1u : 0u
        , static_cast<u32>(statistics.historyResetReason)
    );
    {
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSmokeOptics: sequence={} generation={} max_queries={} query_budget_units={} physical_queries={}")
            FOUNDATION_TEXT(" bootstrap_events={} transparent_paths={} unsupported_paths={} limited_paths={}")
            FOUNDATION_TEXT(" ambiguous_paths={} tir_events={} medium_overflow_paths={} transport_enabled={}")
            , statistics.sequence
            , statistics.generation
            , statistics.maxOpticalQueries
            , statistics.queryBudgetUnits
            , statistics.physicalQueries
            , statistics.bootstrapEvents
            , statistics.transparentPaths
            , statistics.unsupportedPaths
            , statistics.limitedPaths
            , statistics.ambiguousPaths
            , statistics.tirEvents
            , statistics.mediumOverflowPaths
            , statistics.opticalTransportEnabled ? 1u : 0u
        );
    }
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSmokeFeedback: sequence={} generation={} graphics_frame={}")
        FOUNDATION_TEXT(" feedback_sequence={} epoch={} start_graphics_frame={} probe_index={}")
        FOUNDATION_TEXT(" requested={} enabled={} reused={} reset={} reason={} scheduling_valid={}")
        FOUNDATION_TEXT(" potential_receivers={} screen_returns={} bypassed_pixels={} probe_tiles={}")
        FOUNDATION_TEXT(" screen_iterations={} screen_limit_misses={}")
        , statistics.sequence
        , statistics.generation
        , statistics.graphicsFrameIndex
        , statistics.feedbackSequence
        , statistics.feedbackEpoch
        , statistics.feedbackStartGraphicsFrame
        , statistics.feedbackProbeIndex
        , statistics.feedbackRequested ? 1u : 0u
        , statistics.feedbackEnabled ? 1u : 0u
        , statistics.feedbackReused ? 1u : 0u
        , statistics.feedbackReset ? 1u : 0u
        , static_cast<u32>(statistics.feedbackResetReason)
        , statistics.schedulingCounterValid ? 1u : 0u
        , statistics.potentialReceivers
        , statistics.screenReturns
        , statistics.feedbackBypassedPixels
        , statistics.feedbackProbeTiles
        , statistics.screenIterations
        , statistics.screenLimitMisses
    );
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ReflectionTimingRenderPass final : public Core::IRenderPass{
private:
    static constexpr u32 s_InFlightRanges = s_ReflectionTimingInFlightRanges;


public:
    explicit ReflectionTimingRenderPass(Core::GraphicsRuntime& graphics)noexcept;


public:
    [[nodiscard]] b8 prepareQueries(u32 width, u32 height);
    virtual b8 shouldRenderUnfocused()noexcept override{ return true; }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


ReflectionTimingRenderPass::ReflectionTimingRenderPass(Core::GraphicsRuntime& graphics)noexcept
    : IRenderPass(graphics)
{}

b8 ReflectionTimingRenderPass::prepareQueries(const u32 width, const u32 height){
    u32 mipCount = 0u;
    for(u32 extent = Max(width, height); extent > 0u; extent >>= 1u)
        ++mipCount;
    if(width == 0u || height == 0u || mipCount > NWB_REFLECTION_MAX_DEPTH_MIPS){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionSmokeProjectImpl: invalid extent for depth timing capacity"));
        return false;
    }
    const Array<Name, 17> singleRangeScopes = {
        NWB::Impl::RendererGpuTimingScope::s_Frame.identity,
        NWB::Impl::RendererGpuTimingScope::s_OpaqueRegular.identity,
        NWB::Impl::RendererGpuTimingScope::s_ShadowVisibility.identity,
        NWB::Impl::RendererGpuTimingScope::s_DeferredLighting.identity,
        NWB::Impl::RendererGpuTimingScope::s_DeferredComposite.identity,
        NWB::Impl::RendererGpuTimingScope::s_DeferredPresent.identity,
        NWB::Impl::RendererGpuTimingScope::s_AvboitClear.identity,
        NWB::Impl::RendererGpuTimingScope::s_AvboitOccupancy.identity,
        NWB::Impl::RendererGpuTimingScope::s_AvboitDepthWarp.identity,
        NWB::Impl::RendererGpuTimingScope::s_AvboitExtinction.identity,
        NWB::Impl::RendererGpuTimingScope::s_AvboitIntegration.identity,
        NWB::Impl::RendererGpuTimingScope::s_AvboitAccumulate.identity,
        NWB::Impl::ReflectionGpuTimingScope::s_Classify.identity,
        NWB::Impl::ReflectionGpuTimingScope::s_BuildArgs.identity,
        NWB::Impl::ReflectionGpuTimingScope::s_Hardware.identity,
        NWB::Impl::ReflectionGpuTimingScope::s_Temporal.identity,
        NWB::Impl::ReflectionGpuTimingScope::s_Spatial.identity,
    };
    auto& graphics = getGraphics();
    auto& timing = graphics.gpuTiming();
    auto& device = graphics.getDevice();
    // Reserve enough timer queries to cover all in-flight passes and depth mips.
    for(const Name& scope : singleRangeScopes){
        if(!timing.prepareScopeQueries(scope, device, s_InFlightRanges)){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionSmokeProjectImpl: failed to prepare timing scope '{}'"), ConvertString(scope.resolvedText()));
            return false;
        }
    }
    if(!timing.prepareScopeQueries(NWB::Impl::ReflectionGpuTimingScope::s_DepthPyramid.identity, device, s_InFlightRanges * mipCount)){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionSmokeProjectImpl: failed to prepare depth timing capacity"));
        return false;
    }
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSmokeProjectImpl: timing in-flight ranges {}"), s_InFlightRanges);
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSmokeProjectImpl: timing depth mip count {}"), mipCount);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_reflection_smoke{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


constexpr AStringView s_SmokeCaseEnvironment = "NWB_REFLECTION_SMOKE_CASE";
constexpr TStringView s_ProjectName = FOUNDATION_TEXT("ReflectionSmokeProjectImpl");
constexpr AStringView s_OffscreenCase = "offscreen";
constexpr AStringView s_RoughCase = "rough";
constexpr AStringView s_CapturePathEnvironment = "NWB_SMOKE_FRAMEBUFFER_CAPTURE_PATH";
constexpr AStringView s_OnscreenMovedCase = "onscreen_moved";
constexpr AStringView s_BoundaryCase = "boundary";
constexpr AStringView s_FloorCase = "floor";
constexpr AStringView s_MovedCase = "moved";
constexpr AStringView s_OpaqueGlassCase = "opaque_glass";

using namespace NWB::Tests::Smoke;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static NWB::Impl::RendererSystem& CreateReflectionRenderer(NWB::Core::ECS::World& world, NWB::ProjectRuntimeContext& context){
    NWB::Core::Alloc::ScratchArena scratchArena(NWB::Tests::Smoke::s_SmokeEnvironmentArena);
    const auto caseText = ReadSmokeEnvironmentText(scratchArena, s_SmokeCaseEnvironment);
    const b8 hasCase = caseText.has_value();
    const AStringView caseName = hasCase ? AStringView(caseText->data(), caseText->size()) : AStringView{};
    if(hasCase && (caseName == "temporal_deform" || caseName == "rough_deform")){
        AddSmokeSkinnedRenderSystems(world, context);
        return *MakeNotNull(world.getSystem<NWB::Impl::RendererSystem>());
    }
    return AddSmokeRenderSystems(world, context);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ReflectionSmokeProjectImpl final : public NWB::IProjectEntryCallbacks{
public:
    explicit ReflectionSmokeProjectImpl(NWB::ProjectRuntimeContext& context)
        : m_context(context)
        , m_world(CreateSmokeWorldOrDie(s_ProjectName, context))
        , m_renderer(CreateReflectionRenderer(*m_world, context)){}
    virtual ~ReflectionSmokeProjectImpl()noexcept override{ destroyWorld(); }


public:
    virtual b8 onStartup()override{
        NWB::Core::Alloc::ScratchArena scratchArena(NWB::Tests::Smoke::s_SmokeEnvironmentArena);
        const auto caseText = ReadSmokeEnvironmentText(scratchArena, s_SmokeCaseEnvironment);
        const b8 hasCase = caseText.has_value();
        const AStringView caseName = hasCase ? AStringView(caseText->data(), caseText->size()) : AStringView(s_OffscreenCase);
        m_feedbackCase = caseName.starts_with("feedback_");
        m_opticalCase = caseName.starts_with("optical_");
        m_csgOpticalCase = caseName.starts_with("optical_csg_") && caseName != "optical_csg_reference";
        m_extendedCase = m_feedbackCase || m_opticalCase || caseName.starts_with(s_RoughCase) || caseName.starts_with("temporal_");
        m_opticalTir = caseName == "optical_tir";
        m_furnace = caseName == "rough_furnace";
        m_glassRoughnessCase = caseName == "rough_glass";
        if(!m_configuration.configure(m_renderer, m_context.graphics, m_extendedCase, m_feedbackCase, m_opticalCase, m_furnace, m_opticalTir, scratchArena))
            return false;
        b8 cpuDiagnostics = false;
        if(!ReflectionSmokeConfiguration::ReadFlag("NWB_REFLECTION_SMOKE_CPU_DIAGNOSTICS", scratchArena, cpuDiagnostics))
            return false;
        const auto cpuTimingPath = ReadSmokeEnvironmentText(scratchArena, "NWB_REFLECTION_CPU_GPU_TIMING_FILE");
        if(cpuTimingPath.has_value() != cpuDiagnostics){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionCpuTiming: diagnostic request and explicit output path must agree"));
            return false;
        }
        if(cpuDiagnostics){
            if(
                m_configuration.settings().diagnosticsEnabled || m_configuration.settings().temporalEnabled
                || m_configuration.settings().spatialFilterEnabled || m_configuration.settings().screenFeedbackEnabled
                || m_configuration.settings().traceMode != NWB::Impl::ReflectionTraceMode::Hardware
                || ReadSmokeEnvironmentText(scratchArena, s_CapturePathEnvironment)
            ){
                NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionCpuTiming: requires raw hardware reflection without capture or path diagnostics"));
                return false;
            }
            m_cpuTimingProbe = MakeUnique<ReflectionCpuTimingProbe>(m_context);
            if(!m_cpuTimingProbe->initialize(caseName, scratchArena))
                return false;
        }
        const auto spatialOwnerSelection = ReadSmokeEnvironmentText(scratchArena, "NWB_REFLECTION_SMOKE_SPATIAL_OWNER");
        if(spatialOwnerSelection){
            if(caseName != s_RoughCase || m_configuration.authoredRoughness() != 0.4f){
                NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionSpatialOwner: requires the unchanged roughness0.4 scene"));
                return false;
            }
            m_spatialOwnerProbe = MakeUnique<ReflectionSpatialOwnerProbe>(m_context, m_renderer);
            if(!m_spatialOwnerProbe || !m_spatialOwnerProbe->configure(AStringView(spatialOwnerSelection->data(), spatialOwnerSelection->size()), m_configuration.settings()) || !m_renderer.setReflectionSettings(m_configuration.settings()))
                return false;
        }
        const b8 screenCase = caseName == "onscreen" || caseName == s_OnscreenMovedCase || caseName == s_BoundaryCase || caseName == s_FloorCase;
        if(caseName != s_OffscreenCase && caseName != s_MovedCase && caseName != s_OpaqueGlassCase && !screenCase && !m_extendedCase){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionSmokeProjectImpl: unknown case '{}'"), ConvertString(caseName));
            return false;
        }
        const auto cameraId = CreateSmokeCamera(1.4f, 6.0f, 0.0f, *m_world);
        auto& camera = m_world->entity(cameraId).getComponent<NWB::Impl::Scene::CameraComponent>();
        camera.setVerticalFovRadians(s_PI / 3.0f);
        const auto extent = NWB::QueryProjectFrameClientSize();
        camera.setAspectRatio(static_cast<f32>(extent.width) / static_cast<f32>(extent.height));
        m_csgSliceRayCapacity = Min(m_configuration.settings().maxHardwareRaysPerFrame, 2u * extent.width * extent.height);
        const auto light = NWB::Impl::Scene::CreateDirectionalLightEntity(*m_world, 0.6f, 0.4f, 0.0f, Float4(1.0f, 1.0f, 1.0f, 1.0f), 1.0f);
        FOUNDATION_FATAL_ASSERT_MSG(cameraId.valid() && light.valid(), FOUNDATION_TEXT("ReflectionSmokeProject: camera/light creation failed"));
        if(m_opticalCase)
            m_world->entity(light).getComponent<NWB::Impl::Scene::LightComponent>().enableCaustics = false;

        ReflectionReferenceScene referenceScene(*m_world, m_glassRoughnessCase, m_configuration.authoredRoughness());
        if(m_feedbackCase){
            m_feedbackScene = MakeUnique<ReflectionFeedbackScene>(*m_world);
            if(!m_feedbackScene->create(caseName, m_configuration.freshFinalState()))
                return false;
        }
        else if(caseName == "optical_csg_context_transition"){
            m_csgContextProbe = MakeUnique<ReflectionCsgContextProbe>(m_csgSliceRayCapacity, m_context, *m_world, m_renderer);
            if(!m_csgContextProbe || !m_csgContextProbe->create(scratchArena))
                return false;
        }
        else if(m_opticalCase){
            if(!CreateReflectionOpticalScene(caseName, *m_world))
                return false;
        }
        else if(m_extendedCase && !m_glassRoughnessCase){
            m_roughnessScene = MakeUnique<ReflectionRoughnessScene>(cameraId, light, m_configuration.authoredRoughness(), m_context, *m_world);
            if(!m_roughnessScene->create(caseName, m_configuration.freshFinalState()))
                return false;
            if(m_roughnessScene->mutationCase() && !m_roughnessScene->deforming() && m_configuration.settings().temporalEnabled && (m_configuration.targetSamples() < 32u || m_configuration.postResetSamples() > m_configuration.targetSamples())){
                NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionSmokeProject: mutation history cap must cover warm-up and post-reset samples"));
                return false;
            }
        }
        else if(caseName == s_OpaqueGlassCase || m_glassRoughnessCase)
            referenceScene.createOpaqueGlassScene();
        else if(caseName == s_FloorCase)
            referenceScene.createFloorMirrorScene();
        else if(screenCase)
            referenceScene.createOnscreenMirrorScene(caseName == s_OnscreenMovedCase, caseName == s_BoundaryCase);
        else
            referenceScene.createMirrorScene(caseName == s_MovedCase);
        if(!configureFramebufferCapture(scratchArena))
            return false;
        if(m_spatialOwnerProbe && !m_framebufferCapture){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionSpatialOwner: application framebuffer capture is required"));
            return false;
        }
        if(ReadSmokeEnvironmentFlag("NWB_REFLECTION_SMOKE_TIMING") || m_spatialOwnerProbe || m_cpuTimingProbe){
            auto captureOptions = NWB::Core::Perf::CaptureOptions::GpuTimingOnly();
            captureOptions.cpuTiming = m_cpuTimingProbe != nullptr;
            m_context.setPerfCapture(captureOptions);
            if(!m_timingRenderPass.prepareQueries(extent.width, extent.height))
                return false;
            m_context.graphics.addRenderPassToBack(m_timingRenderPass);
            m_timingRenderPassRegistered = true;
            NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSmokeProject: timing render unfocused 1"));
        }
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSmokeProject: case {} created"), ConvertString(caseName));
        return true;
    }

    virtual void onShutdown()override{
        if(m_cpuTimingProbe)
            m_cpuTimingProbe->finish();
        destroyWorld();
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSmokeProject: shutdown"));
    }

    virtual b8 onUpdate(const f32 delta)override{
        if(m_cpuTimingProbe && !m_cpuTimingProbe->update())
            return false;
        if(m_csgContextProbe && !m_csgContextProbe->sampleSynchronizedFrame(m_statisticsReporter.latest()))
            return false;
        if(m_framebufferCapture)
            m_framebufferCapture->update();
        if(m_spatialOwnerProbe && !m_spatialOwnerProbe->update(m_statisticsReporter.latest(), m_context.gpuTimingView(), m_configuration.settings()))
            return false;
        reportCsgSlicePackets();
        updateRoughnessScene();
        updateFeedbackScene();
        if(!m_cpuTimingProbe){
            m_fpsProbe.recordFrame(delta);
            m_gpuPassTimingProbe.recordFrame(delta, m_context.gpuTimingView());
        }
        const f32 fixedDelta = RendererBaselineFixedDelta();
        if(!TickSmokeWorld(fixedDelta > 0.0f ? fixedDelta : delta, *m_world))
            return false;
        reportReflectionStatistics();
        return true;
    }


private:
    void updateRoughnessScene(){
        if(!m_roughnessScene || !m_roughnessScene->mutationCase() || m_mutationApplied || m_statisticsReporter.latest().sequence == 0u)
            return;
        const b8 warmed = m_roughnessScene->deforming() || !m_configuration.settings().temporalEnabled ? m_statisticsReporter.latest().frameIndex >= 32u : m_statisticsReporter.latest().historySampleCount >= 32u;
        if(!warmed)
            return;
        m_mutationGraphicsFrame = m_context.graphics.getFrameIndex();
        if(m_configuration.freshFinalState()){
            m_configuration.settings().samplingSeed = m_configuration.requestedSeed();
            FOUNDATION_FATAL_ASSERT_MSG(m_renderer.setReflectionSettings(m_configuration.settings()), FOUNDATION_TEXT("ReflectionSmokeProject: fresh seed reset failed"));
        }
        else
            FOUNDATION_FATAL_ASSERT_MSG(m_roughnessScene->applyMutation(), FOUNDATION_TEXT("ReflectionSmokeProject: scene mutation failed"));
        m_mutationApplied = true;
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSmokeMutation: graphics_frame={} fresh_final={} seed={}"), m_mutationGraphicsFrame, m_configuration.freshFinalState() ? 1u : 0u, m_configuration.requestedSeed());
    }

    void updateFeedbackScene(){
        if(!m_feedbackScene || !m_feedbackScene->mutationCase() || m_mutationApplied)
            return;
        if(m_statisticsReporter.latest().feedbackSequence < m_configuration.targetSamples() || (!m_configuration.freshFinalState() && !m_statisticsReporter.feedbackObservedBypass()))
            return;
        m_mutationGraphicsFrame = m_context.graphics.getFrameIndex();
        if(m_configuration.freshFinalState()){
            m_configuration.settings().samplingSeed = m_configuration.requestedSeed();
            FOUNDATION_FATAL_ASSERT_MSG(m_renderer.setReflectionSettings(m_configuration.settings()), FOUNDATION_TEXT("ReflectionSmokeProject: fresh feedback reset failed"));
        }
        else
            FOUNDATION_FATAL_ASSERT_MSG(m_feedbackScene->applyMutation(), FOUNDATION_TEXT("ReflectionSmokeProject: feedback mutation failed"));
        m_mutationApplied = true;
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionSmokeFeedbackMutation: graphics_frame={} fresh_final={}"), m_mutationGraphicsFrame, m_configuration.freshFinalState() ? 1u : 0u);
    }

    b8 shouldCapture(const u64 graphicsFrame)const noexcept{
        if(m_spatialOwnerProbe)
            return m_spatialOwnerProbe->shouldCapture(graphicsFrame);
        if(m_feedbackScene && m_feedbackScene->mutationCase())
            return m_mutationApplied && graphicsFrame == m_mutationGraphicsFrame;
        if(m_configuration.feedbackCapture())
            return m_statisticsReporter.latest().feedbackSequence >= m_configuration.targetSamples();
        if(m_roughnessScene && m_roughnessScene->mutationCase()){
            if(!m_mutationApplied)
                return false;
            if(m_configuration.postResetSamples() == 1u)
                return graphicsFrame == m_mutationGraphicsFrame;
            return m_statisticsReporter.latest().historyStartGraphicsFrame == m_mutationGraphicsFrame && m_statisticsReporter.latest().historySampleCount >= m_configuration.postResetSamples();
        }
        return m_configuration.settings().temporalEnabled && !(m_roughnessScene && m_roughnessScene->deforming()) ? m_statisticsReporter.latest().historySampleCount >= m_configuration.targetSamples() : m_statisticsReporter.latest().frameIndex >= Max(m_configuration.targetSamples(), 3u);
    }

    void reportCsgSlicePackets(){
        if(!m_csgOpticalCase || !m_configuration.settings().diagnosticsEnabled || m_csgContextProbe)
            return;
        const u64 frame = m_context.graphics.getFrameIndex();
        if(frame < 3u || frame - 1u == m_slicePacketSourceFrame)
            return;
        m_slicePacketSourceFrame = frame - 1u;
        ReportReflectionSlicePackets(m_csgSliceRayCapacity, m_slicePacketSourceFrame, true, m_context, m_renderer);
    }

    void reportReflectionStatistics(){
        if(!m_statisticsReporter.poll(m_renderer))
            return;
        const NWB::Impl::ReflectionStatistics& statistics = m_statisticsReporter.latest();
        if(
            (m_extendedCase || m_configuration.feedbackCapture()) && m_framebufferCapture && m_framebufferCapture->captureReady()
            && statistics.graphicsFrameIndex >= m_framebufferCapture->capturedGraphicsFrameIndex()
            && (!m_spatialOwnerProbe || m_spatialOwnerProbe->canFinish(statistics, m_framebufferCapture->capturedGraphicsFrameIndex()))
        )
            m_framebufferCapture->finish();
    }

    b8 configureFramebufferCapture(NWB::Core::Alloc::ScratchArena& scratchArena){
        if(m_csgContextProbe)
            return true;
        FramebufferCaptureOptions options;
        if(m_extendedCase || m_configuration.feedbackCapture()){
            if(!m_configuration.settings().diagnosticsEnabled){
                // Timing-only extended scenes do not request completed-state capture.
                const auto capturePath = ReadSmokeEnvironmentText(scratchArena, s_CapturePathEnvironment);
                if(capturePath){
                    NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionSmokeProject: controlled completed-state capture requires diagnostics"));
                    return false;
                }
            }
            options.quitWhenReady = false;
            options.predicateContext = this;
            options.shouldCapture = [](void* owner, const u64 graphicsFrame)noexcept{
                return MakeNotNull(static_cast<ReflectionSmokeProjectImpl*>(owner))->shouldCapture(graphicsFrame);
            };
        }
        constexpr u32 s_DefaultCaptureFrameCount = 16u;
        auto capture = NWB::Tests::Smoke::SmokeCaptureFactory(m_context).configure(s_ProjectName, s_DefaultCaptureFrameCount, options, scratchArena);
        if(!capture)
            return false;
        m_framebufferCapture = Move(*capture);
        return true;
    }

    void destroyWorld(){
        m_csgContextProbe.reset();
        if(m_timingRenderPassRegistered){
            m_context.graphics.removeRenderPass(m_timingRenderPass);
            m_timingRenderPassRegistered = false;
        }
        if(m_world.owner() && m_world->getSystem<NWB::Impl::MeshSkinningSystem>())
            DestroySmokeSkinnedRenderWorld(m_context, m_world);
        else
            DestroySmokeRenderWorld(m_context, m_world);
        if(m_framebufferCapture){
            m_framebufferCapture->stop();
            m_framebufferCapture.reset();
        }
        m_spatialOwnerProbe.reset();
    }


private:
    NWB::ProjectRuntimeContext& m_context;
    NotNullUniquePtr<NWB::Core::ECS::World> m_world;
    NWB::Impl::RendererSystem& m_renderer;
    ReflectionTimingRenderPass m_timingRenderPass{ m_context.graphics };
    UniquePtr<FramebufferCapture> m_framebufferCapture;
    FpsProbe m_fpsProbe{ s_ProjectName };
    GpuPassTimingProbe m_gpuPassTimingProbe{ s_ProjectName };
    ReflectionStatisticsReporter m_statisticsReporter;
    ReflectionSmokeConfiguration m_configuration;
    u64 m_slicePacketSourceFrame = Limit<u64>::s_Max;
    UniquePtr<ReflectionRoughnessScene> m_roughnessScene;
    UniquePtr<ReflectionFeedbackScene> m_feedbackScene;
    UniquePtr<ReflectionSpatialOwnerProbe> m_spatialOwnerProbe;
    UniquePtr<ReflectionCsgContextProbe> m_csgContextProbe;
    UniquePtr<ReflectionCpuTimingProbe> m_cpuTimingProbe;
    u64 m_mutationGraphicsFrame = Limit<u64>::s_Max;
    u32 m_csgSliceRayCapacity = 0u;
    b8 m_extendedCase = false;
    b8 m_feedbackCase = false;
    b8 m_opticalCase = false;
    b8 m_csgOpticalCase = false;
    b8 m_opticalTir = false;
    b8 m_furnace = false;
    b8 m_glassRoughnessCase = false;
    b8 m_mutationApplied = false;
    b8 m_timingRenderPassRegistered = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};

namespace NWB::Tests::Smoke{ using ReflectionSmokeProjectImpl = __hidden_reflection_smoke::ReflectionSmokeProjectImpl; }

NWB::ProjectFrameClientSize NWB::QueryProjectFrameClientSize(){
    NWB::Core::Alloc::ScratchArena arena(Tests::Smoke::s_SmokeEnvironmentArena);
    const auto extent = Tests::Smoke::ReadSmokeEnvironmentText(arena, "NWB_REFLECTION_SMOKE_EXTENT");
    if(!extent || *extent == "native")
        return { 960, 720 };
    FOUNDATION_FATAL_ASSERT_MSG(*extent == "npot", FOUNDATION_TEXT("ReflectionSmokeProject: extent must be native or npot"));
    return { 953, 713 };
}

TStringView NWB::QueryProjectWindowTitle()noexcept{ return FOUNDATION_TEXT("NWB Reflection Smoke"); }

UniquePtr<NWB::IProjectEntryCallbacks> NWB::CreateProjectEntryCallbacks(NWB::ProjectRuntimeContext& context){
    return MakeUnique<NWB::Tests::Smoke::ReflectionSmokeProjectImpl>(context);
}
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
