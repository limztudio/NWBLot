const i32 s_SIMDMemoryAbortExitCode = 81;
const i32 s_SIMDMemoryHandlerFailureExitCode = 82;
const i32 s_SIMDMemoryReturnedExitCode = 83;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u8 PatternByte(in usize index){
    return cast<u8>((index * 37u + (index >> 8u) * 13u + 11u) & 0xFFu);
}


