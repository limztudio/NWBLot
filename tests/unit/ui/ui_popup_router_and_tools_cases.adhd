void VerifyUiPopupToolsLoanTests_ClosingAUserPopupAfterTooltipDeclarationHidesHelpWithoutOrphanOverlay(mut UiPopupToolsLoanTests self){
    self.m_plainPopup.open();
    ASSERT_TRUE(self.acceptPopupTooltip(1u));
    ASSERT_TRUE(self.moveToAnchor("plain"));
    ASSERT_TRUE(self.acceptPopupTooltip(2u));
    ASSERT_TRUE(self.m_tooltip.visible());
    ASSERT_TRUE(self.m_context.input().hasPopup());
    ASSERT_TRUE(self.begin(3u));
    PopupOptions options = PopupOptions();
    options.anchor = MakeUiPopupRouterRect(40.0f, 40.0f, 40.0f, 24.0f);
    options.size = MakeUiPopupRouterPoint(320.0f, 220.0f);
    ASSERT_TRUE(self.m_builder.beginPopup("plain", self.m_plainPopup, options));
    EXPECT_FALSE(self.m_builder.button("anchor", "Popup anchor", self.m_anchorOptions));
    ASSERT_TRUE(self.m_builder.tooltip("tip", "anchor", "Overlay help", self.m_tooltip, self.m_tooltipOptions));
    ASSERT_TRUE(self.m_tooltip.visible());
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 2u);
    self.m_plainPopup.close();
    ASSERT_TRUE(self.m_builder.endPopup());
    EXPECT_TRUE(self.m_builder.balanced());
    EXPECT_FALSE(self.m_tooltip.visible());
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 2u);
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    EXPECT_TRUE(snapshot.commands().empty());
    EXPECT_TRUE(snapshot.vertices().empty());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_TRUE(self.m_context.input().targets().empty());
}

void VerifyUiPopupToolsLoanTests_MenuRowCallbackCannotReplaceAnAlreadyPaintedOrdinaryListAndPublish(mut UiPopupToolsLoanTests self){
    ASSERT_TRUE(self.acceptTools(1u, false, false));
    UiPopupToolsSource ordinarySource = UiPopupToolsSource();
    ordinarySource.generation = 1502u;
    ListState ordinary = ListState();
    ordinary.select(1u);
    ASSERT_TRUE(self.m_menu.open(MakeUiPopupRouterRect(40.0f, 60.0f, 0.0f, 0.0f)));
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", MakeUiPopupRouterRect(10.0f, 10.0f, 360.0f, 360.0f)));
    ListOptions options = ListOptions();
    options.width.policy = LayoutSizePolicy::Fixed;
    options.width.value = 220.0f;
    options.height.policy = LayoutSizePolicy::Fixed;
    options.height.value = 168.0f;
    ASSERT_TRUE(self.m_builder.virtualList("ordinary", ordinarySource, ordinary, options).valid);
    EXPECT_FALSE(self.m_builder.button("anchor", "Anchor", self.m_anchorOptions));
    ASSERT_TRUE(self.m_builder.contextMenu("menu", "anchor", self.m_source, self.m_menu, self.m_menuOptions).valid);
    const u64 inputGeneration = ordinary.inputGeneration();
    self.armSelectListOnText(ordinary, 4u);
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_FALSE(self.hasSelectListOnText());
    EXPECT_EQ(ordinary.selectedKey(), 4u);
    EXPECT_EQ(ordinary.cursorKey(), 4u);
    EXPECT_NE(ordinary.inputGeneration(), inputGeneration);
    EXPECT_GT(ordinary.placement().bounds.width, 0.0f);
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
}

void VerifyUiPopupToolsLoanTests_LateMenuMetadataCallbackCannotCloseAPaintedComboAndPublish(mut UiPopupToolsLoanTests self){
    ASSERT_TRUE(self.acceptTools(1u, false, false));
    ComboState combo = ComboState();
    UiPopupToolsRevisionArmingComboSource comboSource = UiPopupToolsRevisionArmingComboSource(self.m_source, combo);
    combo.open();
    ASSERT_EQ(combo.selectedKey(), 0u);
    ASSERT_TRUE(self.m_menu.open(MakeUiPopupRouterRect(40.0f, 60.0f, 0.0f, 0.0f)));
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", MakeUiPopupRouterRect(10.0f, 10.0f, 360.0f, 360.0f)));
    EXPECT_FALSE(self.m_builder.button("anchor", "Anchor", self.m_anchorOptions));
    ASSERT_TRUE(self.m_builder.contextMenu("menu", "anchor", self.m_source, self.m_menu, self.m_menuOptions).valid);
    ComboOptions options = ComboOptions();
    options.width.policy = LayoutSizePolicy::Fixed;
    options.width.value = 220.0f;
    options.height.policy = LayoutSizePolicy::Fixed;
    options.height.value = 32.0f;
    options.popupHeight = 176.0f;
    ASSERT_TRUE(self.m_builder.comboBox("combo", comboSource, combo, options).valid);
    ASSERT_EQ(comboSource.textCalls, 0u);
    ASSERT_FALSE(self.hasCloseComboOnRevision());
    const u64 inputGeneration = combo.inputGeneration();
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(comboSource.armed);
    EXPECT_GT(comboSource.textCalls, 0u);
    EXPECT_FALSE(self.hasCloseComboOnRevision());
    EXPECT_FALSE(combo.isOpen());
    EXPECT_NE(combo.inputGeneration(), inputGeneration);
    EXPECT_GT(combo.placement().bounds.width, 0.0f);
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
}


