#include <impl/assets_material/layout_validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


MaterialTypedLayoutBlock UnpackMaterialTypedLayoutBlockBinary(in MaterialTypedLayoutBlockBinary blockBinary){
    MaterialTypedLayoutBlock block;
    block.blockName = Name(blockBinary.blockNameHash);
    block.blockClass = cast<MaterialBlockClass>(blockBinary.blockClass);
    block.fieldBegin = blockBinary.fieldBegin;
    block.fieldCount = blockBinary.fieldCount;
    block.byteSize = blockBinary.byteSize;
    return block;
}

MaterialTypedLayoutField UnpackMaterialTypedLayoutFieldBinary(in MaterialTypedLayoutFieldBinary fieldBinary){
    MaterialTypedLayoutField field;
    field.fieldName = Name(fieldBinary.fieldNameHash);
    field.fieldType = cast<MaterialLayoutFieldType>(fieldBinary.fieldType);
    field.offset = fieldBinary.offset;
    field.defaultValue = fieldBinary.defaultValue;
    return field;
}

b8 TryAssignMaterialResourceReferenceAsset(in MaterialResourceKind resourceKind, in Name resourceName, mut MaterialResourceReference reference){
    switch(resourceKind){
        case MaterialResourceKind::SampledImage2D:
            reference.textureAsset.virtualPath = resourceName;
            return true;
        case MaterialResourceKind::Sampler:
            reference.samplerAsset.virtualPath = resourceName;
            return true;
        default:
            return false;
    }
}

Expected<MaterialResourceReference> TryUnpackMaterialResourceReferenceBinary(in MaterialResourceReferenceBinary resourceReferenceBinary){
    const MaterialResourceKind resourceKind = cast<MaterialResourceKind>(resourceReferenceBinary.resourceKind);
    const Name resourceName = Name(resourceReferenceBinary.resourceNameHash);
    if(!IsValidSerializedMaterialResourceReference(resourceKind, resourceName))
        return makeUnexpected(Failure());

    MaterialResourceReference outReference;
    outReference.blockName = Name(resourceReferenceBinary.blockNameHash);
    outReference.fieldName = Name(resourceReferenceBinary.fieldNameHash);
    outReference.resourceKind = resourceKind;
    outReference.constantByteOffset = resourceReferenceBinary.constantByteOffset;
    if(!TryAssignMaterialResourceReferenceAsset(resourceKind, resourceName, outReference))
        return makeUnexpected(Failure());
    return outReference;
}

b8 TryUnpackMaterialFlags(in u32 materialFlags, mut b8 outTransparent, mut b8 outTwoSided, mut b8 outRefractive){
    if((materialFlags & ~cast<u32>(MaterialFlag::All)) != 0u)
        return false;
    outTransparent = (materialFlags & cast<u32>(MaterialFlag::Transparent)) != 0u;
    outTwoSided = (materialFlags & cast<u32>(MaterialFlag::TwoSided)) != 0u;
    outRefractive = (materialFlags & cast<u32>(MaterialFlag::Refractive)) != 0u;
    return true;
}

// Transparent materials need all three pass shaders; opaque materials carry none.
b8 HasValidMaterialAvboitPixelShaderContract(
    in b8 transparent,
    in AssetRef<PixelShader> accumulatePixelShader,
    in AssetRef<PixelShader> occupancyPixelShader,
    in AssetRef<PixelShader> extinctionPixelShader
){
    if(transparent)
        return accumulatePixelShader.valid() && occupancyPixelShader.valid() && extinctionPixelShader.valid();

    return !accumulatePixelShader.valid() && !occupancyPixelShader.valid() && !extinctionPixelShader.valid();
}

b8 ValidateMaterialBinaryShaderCount(
    in u32 shaderCount,
    in u32 maxShaderTypeCount,
    in usize remainingBytes,
    in usize shaderEntryBytes
){
    if(shaderCount == 0u){
        error("Material::loadBinary failed: material has no shader stages");
        return false;
    }
    if(shaderCount > maxShaderTypeCount){
        error("Material::loadBinary failed: shader count exceeds supported shader stage count");
        return false;
    }
    if(cast<usize>(shaderCount) > remainingBytes / shaderEntryBytes){
        error("Material::loadBinary failed: shader count exceeds available data");
        return false;
    }
    return true;
}

b8 ValidateMaterialBinaryFlags(
    in u32 materialFlags,
    mut b8 outTransparent,
    mut b8 outTwoSided,
    mut b8 outRefractive
){
    if(TryUnpackMaterialFlags(materialFlags, outTransparent, outTwoSided, outRefractive))
        return true;

    error("Material::loadBinary failed: material flags contain unsupported bits {}", materialFlags);
    return false;
}

b8 ValidateMaterialBinaryAvboitPresenceFlag(in StringView passLabel, in u32 hasShader){
    if(hasShader <= 1u)
        return true;

    error("Material::loadBinary failed: invalid AVBOIT {} pixel shader presence flag {}", passLabel, hasShader);
    return false;
}

b8 ValidateMaterialBinaryAvboitShaderRef(in StringView passLabel, in b8 isValidRef){
    if(isValidRef)
        return true;

    error("Material::loadBinary failed: AVBOIT {} pixel shader name is empty", passLabel);
    return false;
}

b8 LogAndValidateMaterialTypedLayout(
    in u64 layoutHash,
    in Span<MaterialTypedLayoutBlock> blocks,
    in Span<MaterialTypedLayoutField> fields,
    in Span<u8> blockBytes,
    in StringView failureContext
){
    usize failureIndex = 0u;
    const MaterialTypedLayoutValidationStatus status = ValidateMaterialTypedLayout(layoutHash, blocks, fields, blockBytes.size(), failureIndex);
    switch(status){
        case MaterialTypedLayoutValidationStatus::Valid:
            return true;
        case MaterialTypedLayoutValidationStatus::EmptyLayout:
            error("{} failed: typed layout is empty", failureContext);
            return false;
        case MaterialTypedLayoutValidationStatus::ZeroHash:
            error("{} failed: typed layout has zero hash", failureContext);
            return false;
        case MaterialTypedLayoutValidationStatus::MissingBlocksOrFields:
            error("{} failed: typed layout blocks and fields must both be present", failureContext);
            return false;
        case MaterialTypedLayoutValidationStatus::EmptyBlockName:
            error("{} failed: typed layout block {} has empty name", failureContext, failureIndex);
            return false;
        case MaterialTypedLayoutValidationStatus::InvalidBlockClass:
            error("{} failed: typed layout block {} has invalid class {}", failureContext, failureIndex, cast<u32>(blocks[failureIndex].blockClass));
            return false;
        case MaterialTypedLayoutValidationStatus::NonContiguousFieldRange:
            error("{} failed: typed layout block {} has non-contiguous field range", failureContext, failureIndex);
            return false;
        case MaterialTypedLayoutValidationStatus::FieldRangeExceedsCount:
            error("{} failed: typed layout block {} field range exceeds field count", failureContext, failureIndex);
            return false;
        case MaterialTypedLayoutValidationStatus::EmptyFieldName:
            error("{} failed: typed layout field {} has empty name", failureContext, failureIndex);
            return false;
        case MaterialTypedLayoutValidationStatus::InvalidFieldType:
            error("{} failed: typed layout field {} has invalid type {}", failureContext, failureIndex, cast<u32>(fields[failureIndex].fieldType));
            return false;
        case MaterialTypedLayoutValidationStatus::FieldAlignmentOverflow:
            error("{} failed: typed layout field {} alignment overflows", failureContext, failureIndex);
            return false;
        case MaterialTypedLayoutValidationStatus::MisalignedFieldOffset:
            error("{} failed: typed layout field {} has misaligned offset", failureContext, failureIndex);
            return false;
        case MaterialTypedLayoutValidationStatus::FieldByteSizeOverflow:
            error("{} failed: typed layout field {} byte size overflows", failureContext, failureIndex);
            return false;
        case MaterialTypedLayoutValidationStatus::BlockByteSizeOverflow:
            error("{} failed: typed layout block {} byte size overflows", failureContext, failureIndex);
            return false;
        case MaterialTypedLayoutValidationStatus::BlockByteSizeMismatch:
            error("{} failed: typed layout block {} byte size does not match its fields", failureContext, failureIndex);
            return false;
        case MaterialTypedLayoutValidationStatus::UnownedFields:
            error("{} failed: typed layout has unowned fields", failureContext);
            return false;
        case MaterialTypedLayoutValidationStatus::LayoutHashMismatch:
            error("{} failed: typed layout hash mismatch", failureContext);
            return false;
        case MaterialTypedLayoutValidationStatus::TotalBlockByteSizeOverflow:
            error("{} failed: typed block byte size overflows", failureContext);
            return false;
        case MaterialTypedLayoutValidationStatus::TotalBlockByteCountMismatch:
            error("{} failed: typed block byte count does not match typed layout", failureContext);
            return false;
        default:
            return false;
    }
}

b8 ValidateMaterialPayloadData(
    in u32 stageShaderCount,
    in Name materialInterface,
    in StringView shaderVariant,
    in b8 transparent,
    in AssetRef<PixelShader> avboitAccumulatePixelShader,
    in AssetRef<PixelShader> avboitOccupancyPixelShader,
    in AssetRef<PixelShader> avboitExtinctionPixelShader,
    in u64 typedLayoutHash,
    in Span<MaterialTypedLayoutBlock> typedLayoutBlocks,
    in Span<MaterialTypedLayoutField> typedLayoutFields,
    in Span<u8> typedBlockBytes,
    in Span<MaterialResourceReference> resourceReferences,
    in StringView failureContext
){
    if(stageShaderCount == 0u){
        error("{} failed: material has no shader stages", failureContext);
        return false;
    }
    if(materialInterface == s_NameNone){
        error("{} failed: material interface is required", failureContext);
        return false;
    }
    if(shaderVariant.empty()){
        error("{} failed: shader variant is empty", failureContext);
        return false;
    }
    if(!HasValidMaterialAvboitPixelShaderContract(transparent, avboitAccumulatePixelShader, avboitOccupancyPixelShader, avboitExtinctionPixelShader)){
        error("{} failed: AVBOIT pixel shaders must be present if and only if the material is transparent", failureContext);
        return false;
    }
    if(typedLayoutHash == 0u){
        error("{} failed: interface material is missing typed layout data", failureContext);
        return false;
    }
    const usize maxU32 = cast<usize>(u32.max);
    if(typedLayoutBlocks.size() > maxU32 || typedLayoutFields.size() > maxU32){
        error("{} failed: typed layout count exceeds u32 range", failureContext);
        return false;
    }
    if(typedBlockBytes.size() > maxU32){
        error("{} failed: typed block byte count exceeds u32 range", failureContext);
        return false;
    }
    if(resourceReferences.size() > maxU32){
        error("{} failed: material resource reference count exceeds u32 range", failureContext);
        return false;
    }
    if(!LogAndValidateMaterialTypedLayout(typedLayoutHash, typedLayoutBlocks, typedLayoutFields, typedBlockBytes, failureContext))
        return false;
    if(!ValidateMaterialResourceReferences(typedLayoutBlocks, typedLayoutFields, resourceReferences)){
        error("{} failed: material resource references do not match typed layout", failureContext);
        return false;
    }
    return true;
}

void AssignMaterialTypedLayoutPayload(
    in u64 layoutHash,
    in Span<MaterialTypedLayoutBlock> blocks,
    in Span<MaterialTypedLayoutField> fields,
    in Span<u8> blockBytes,
    mut u64 outLayoutHash,
    mut Vector<MaterialTypedLayoutBlock> outBlocks,
    mut Vector<MaterialTypedLayoutField> outFields,
    mut Vector<u8> outBlockBytes
){
    outLayoutHash = layoutHash;
    outBlocks.clear();
    outBlocks.reserve(blocks.size());
    for(in MaterialTypedLayoutBlock block : blocks)
        outBlocks.push_back(block);
    outFields.clear();
    outFields.reserve(fields.size());
    for(in MaterialTypedLayoutField field : fields)
        outFields.push_back(field);
    outBlockBytes.clear();
    outBlockBytes.reserve(blockBytes.size());
    for(in u8 byteValue : blockBytes)
        outBlockBytes.push_back(byteValue);
}

void AssignMaterialResourceReferencesPayload(
    in Span<MaterialResourceReference> resourceReferences,
    mut Vector<MaterialResourceReference> outResourceReferences
){
    outResourceReferences.clear();
    outResourceReferences.reserve(resourceReferences.size());
    for(in MaterialResourceReference reference : resourceReferences)
        outResourceReferences.push_back(reference);
}

b8 ReadMaterialBinaryPreamble(
    in Span<u8> binary,
    mut usize inOutCursor,
    mut String outShaderVariant,
    mut Name outMaterialInterface
){
    const Expected<u32> magicResult = ReadPOD<u32>(binary, inOutCursor);
    if(!magicResult.has_value()){
        error("Material::loadBinary failed: missing magic");
        return false;
    }
    if(magicResult.value() != s_MaterialBinaryMagic){
        error("Material::loadBinary failed: invalid magic");
        return false;
    }

    const Expected<StringView> shaderVariant = ReadString(binary, inOutCursor);
    if(!shaderVariant.has_value()){
        error("Material::loadBinary failed: missing shader variant");
        return false;
    }
    outShaderVariant.assign(shaderVariant.value());
    if(outShaderVariant.empty()){
        error("Material::loadBinary failed: shader variant is empty");
        return false;
    }

    const Expected<NameHash> materialInterfaceHashResult = ReadPOD<NameHash>(binary, inOutCursor);
    if(!materialInterfaceHashResult.has_value()){
        error("Material::loadBinary failed: missing material interface");
        return false;
    }
    outMaterialInterface = Name(materialInterfaceHashResult.value());
    if(outMaterialInterface == s_NameNone){
        error("Material::loadBinary failed: material interface is required");
        return false;
    }
    return true;
}

b8 ReadMaterialTypedLayout(
    in Span<u8> binary,
    mut usize inOutCursor,
    mut u64 outLayoutHash,
    mut Vector<MaterialTypedLayoutBlock> outBlocks,
    mut Vector<MaterialTypedLayoutField> outFields,
    mut Vector<u8> outBlockBytes,
    mut Vector<MaterialResourceReference> outResourceReferences
){
    outBlocks.clear();
    outFields.clear();
    outBlockBytes.clear();
    outResourceReferences.clear();

    const Expected<u64> layoutHashResult = ReadPOD<u64>(binary, inOutCursor);
    if(!layoutHashResult.has_value()){
        error("Material::loadBinary failed: missing typed layout header");
        return false;
    }
    const u64 layoutHash = layoutHashResult.value();
    const Expected<u32> blockCountResult = ReadPOD<u32>(binary, inOutCursor);
    if(!blockCountResult.has_value()){
        error("Material::loadBinary failed: missing typed layout header");
        return false;
    }
    const u32 blockCount = blockCountResult.value();
    const Expected<u32> fieldCountResult = ReadPOD<u32>(binary, inOutCursor);
    if(!fieldCountResult.has_value()){
        error("Material::loadBinary failed: missing typed layout header");
        return false;
    }
    const u32 fieldCount = fieldCountResult.value();

    // Successful reads keep the cursor inside the binary.
    if(cast<usize>(blockCount) > (binary.size() - inOutCursor) / s_MaterialTypedLayoutBlockBytes){
        error("Material::loadBinary failed: typed layout block count exceeds available data");
        return false;
    }
    outBlocks.reserve(cast<usize>(blockCount));
    for(u32 i = 0u; i < blockCount; ++i){
        const Expected<MaterialTypedLayoutBlockBinary> blockBinaryResult = ReadPOD<MaterialTypedLayoutBlockBinary>(binary, inOutCursor);
        if(!blockBinaryResult.has_value()){
            error("Material::loadBinary failed: malformed typed layout block at index {}", i);
            return false;
        }
        outBlocks.push_back(UnpackMaterialTypedLayoutBlockBinary(blockBinaryResult.value()));
    }

    if(cast<usize>(fieldCount) > (binary.size() - inOutCursor) / s_MaterialTypedLayoutFieldBytes){
        error("Material::loadBinary failed: typed layout field count exceeds available data");
        return false;
    }
    outFields.reserve(cast<usize>(fieldCount));
    for(u32 i = 0u; i < fieldCount; ++i){
        const Expected<MaterialTypedLayoutFieldBinary> fieldBinaryResult = ReadPOD<MaterialTypedLayoutFieldBinary>(binary, inOutCursor);
        if(!fieldBinaryResult.has_value()){
            error("Material::loadBinary failed: malformed typed layout field at index {}", i);
            return false;
        }
        outFields.push_back(UnpackMaterialTypedLayoutFieldBinary(fieldBinaryResult.value()));
    }

    const Expected<u32> blockByteCountResult = ReadPOD<u32>(binary, inOutCursor);
    if(!blockByteCountResult.has_value()){
        error("Material::loadBinary failed: missing typed block byte count");
        return false;
    }
    const u32 blockByteCount = blockByteCountResult.value();
    if(cast<usize>(blockByteCount) > binary.size() - inOutCursor){
        error("Material::loadBinary failed: typed block byte count exceeds available data");
        return false;
    }

    outBlockBytes.resize(cast<usize>(blockByteCount));
    for(u32 i = 0u; i < blockByteCount; ++i)
        outBlockBytes[cast<usize>(i)] = binary[inOutCursor + cast<usize>(i)];
    inOutCursor += cast<usize>(blockByteCount);

    const Expected<u32> resourceReferenceCountResult = ReadPOD<u32>(binary, inOutCursor);
    if(!resourceReferenceCountResult.has_value()){
        error("Material::loadBinary failed: missing material resource reference count");
        return false;
    }
    const u32 resourceReferenceCount = resourceReferenceCountResult.value();
    if(cast<usize>(resourceReferenceCount) > (binary.size() - inOutCursor) / s_MaterialResourceReferenceBytes){
        error("Material::loadBinary failed: material resource reference count exceeds available data");
        return false;
    }
    outResourceReferences.reserve(cast<usize>(resourceReferenceCount));
    for(u32 i = 0u; i < resourceReferenceCount; ++i){
        const Expected<MaterialResourceReferenceBinary> resourceReferenceBinaryResult = ReadPOD<MaterialResourceReferenceBinary>(binary, inOutCursor);
        if(!resourceReferenceBinaryResult.has_value()){
            error("Material::loadBinary failed: malformed material resource reference at index {}", i);
            return false;
        }
        const Expected<MaterialResourceReference> resourceReference = TryUnpackMaterialResourceReferenceBinary(resourceReferenceBinaryResult.value());
        if(!resourceReference.has_value()){
            error("Material::loadBinary failed: material resource reference at index {} has an invalid asset identity", i);
            return false;
        }
        outResourceReferences.push_back(resourceReference.value());
    }

    if(!LogAndValidateMaterialTypedLayout(layoutHash, outBlocks, outFields, outBlockBytes, s_MaterialLoadBinaryContextText))
        return false;
    if(!ValidateMaterialResourceReferences(outBlocks, outFields, outResourceReferences)){
        error("Material::loadBinary failed: material resource references do not match typed layout");
        return false;
    }

    outLayoutHash = layoutHash;
    return true;
}

b8 ReadOptionalMaterialAvboitPixelShader(
    in Span<u8> binary,
    in StringView passLabel,
    mut usize inOutCursor,
    mut AssetRef<PixelShader> outShaderRef
){
    outShaderRef = AssetRef<PixelShader>();
    const Expected<u32> hasShaderResult = ReadPOD<u32>(binary, inOutCursor);
    if(!hasShaderResult.has_value()){
        error("Material::loadBinary failed: missing AVBOIT {} pixel shader presence flag", passLabel);
        return false;
    }
    const u32 hasShader = hasShaderResult.value();
    if(!ValidateMaterialBinaryAvboitPresenceFlag(passLabel, hasShader))
        return false;
    if(hasShader == 1u){
        const Expected<NameHash> shaderNameHashResult = ReadPOD<NameHash>(binary, inOutCursor);
        if(!shaderNameHashResult.has_value()){
            error("Material::loadBinary failed: missing AVBOIT {} pixel shader name", passLabel);
            return false;
        }
        outShaderRef.virtualPath = Name(shaderNameHashResult.value());
        if(!ValidateMaterialBinaryAvboitShaderRef(passLabel, outShaderRef.valid()))
            return false;
    }
    return true;
}

b8 ReadMaterialBinaryFooter(
    in Span<u8> binary,
    mut usize inOutCursor,
    mut b8 outTransparent,
    mut b8 outTwoSided,
    mut b8 outRefractive,
    mut u32 outShadingModelId,
    mut u32 outSurfaceDispatchId,
    mut AssetRef<PixelShader> outAvboitAccumulatePixelShader,
    mut AssetRef<PixelShader> outAvboitOccupancyPixelShader,
    mut AssetRef<PixelShader> outAvboitExtinctionPixelShader
){
    const Expected<u32> materialFlagsResult = ReadPOD<u32>(binary, inOutCursor);
    if(!materialFlagsResult.has_value()){
        error("Material::loadBinary failed: missing material flags");
        return false;
    }
    if(!ValidateMaterialBinaryFlags(materialFlagsResult.value(), outTransparent, outTwoSided, outRefractive))
        return false;

    const Expected<u32> shadingModelIdResult = ReadPOD<u32>(binary, inOutCursor);
    if(!shadingModelIdResult.has_value()){
        error("Material::loadBinary failed: missing shading model id");
        return false;
    }
    outShadingModelId = shadingModelIdResult.value();

    const Expected<u32> surfaceDispatchIdResult = ReadPOD<u32>(binary, inOutCursor);
    if(!surfaceDispatchIdResult.has_value()){
        error("Material::loadBinary failed: missing surface dispatch id");
        return false;
    }
    outSurfaceDispatchId = surfaceDispatchIdResult.value();

    if(!ReadOptionalMaterialAvboitPixelShader(binary, s_MaterialAvboitAccumulatePassLabel, inOutCursor, outAvboitAccumulatePixelShader))
        return false;
    if(!ReadOptionalMaterialAvboitPixelShader(binary, s_MaterialAvboitOccupancyPassLabel, inOutCursor, outAvboitOccupancyPixelShader))
        return false;
    if(!ReadOptionalMaterialAvboitPixelShader(binary, s_MaterialAvboitExtinctionPassLabel, inOutCursor, outAvboitExtinctionPixelShader))
        return false;

    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

