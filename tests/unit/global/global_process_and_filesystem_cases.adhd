constexpr AStringView s_RecursiveInnerName = "identity/recursive_inner";

#if !defined(NWB_DEBUG)
static constexpr AStringView s_RuntimeGenerated = "runtime/generated";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


