////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_font_atlas/kern_validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class FontAtlasOtTableReader{
    public FontAtlasOtTableReader(){
        this.m_glyphCount = 0u;
        this.m_budget = s_FontAtlasValidationWorkBudget;
    }

    public FontAtlasOtTableReader(in Span<u8> bytes, in u32 glyphCount){
        this.m_bytes = bytes;
        this.m_glyphCount = glyphCount;
        this.m_budget = s_FontAtlasValidationWorkBudget;
    }

    public u32 glyphCount()const{
        return this.m_glyphCount;
    }

    public b8 spend(in u32 count){
        if(count > this.m_budget)
            return false;
        this.m_budget -= count;
        return true;
    }

    public b8 range(in u64 offset, in u64 count){
        const u64 byteCount = cast<u64>(this.m_bytes.size());
        return this.spend(1u) && offset <= byteCount && count <= byteCount - offset;
    }

    public u16 u16At(in u64 offset)const{
        return ReadFontSfntU16BigEndian(this.m_bytes, cast<usize>(offset));
    }

    public u32 u32At(in u64 offset)const{
        return ReadFontSfntU32BigEndian(this.m_bytes, cast<usize>(offset));
    }

    public Expected<u32> coverage(in u64 offset){
        if(!this.range(offset, s_FontAtlasCoverageHeaderBytes))
            return makeUnexpected(Failure());
        const u16 format = this.u16At(offset);
        const u32 count = cast<u32>(this.u16At(offset + s_FontAtlasCoverageCountOffset));
        u32 glyphCount = 0u;
        if(format != 1u && format != s_FontAtlasCoverageRangeFormat)
            return makeUnexpected(Failure());
        u32 recordStride = s_FontAtlasOtRangeRecordBytes;
        if(format == 1u)
            recordStride = s_FontAtlasOtU16Bytes;
        if(!this.range(offset + s_FontAtlasCoverageHeaderBytes, cast<u64>(count) * recordStride) || !this.spend(count))
            return makeUnexpected(Failure());
        u32 previous = 0u;
        for(u32 index = 0u; index < count; ++index){
            const u64 record = offset + s_FontAtlasCoverageHeaderBytes + cast<u64>(index) * recordStride;
            const u32 start = cast<u32>(this.u16At(record));
            u32 end = start;
            if(format != 1u)
                end = cast<u32>(this.u16At(record + s_FontAtlasOtRangeRecordEndOffset));
            if(start > end || end >= this.m_glyphCount || (index > 0u && start <= previous) || (format == s_FontAtlasCoverageRangeFormat && cast<u32>(this.u16At(record + s_FontAtlasOtRangeRecordValueOffset)) != glyphCount))
                return makeUnexpected(Failure());
            glyphCount += end - start + 1u;
            previous = end;
        }
        return glyphCount;
    }

    public b8 classDef(in u64 offset, in u32 classCount){
        if(offset == 0u)
            return true;
        if(!this.range(offset, s_FontAtlasClassDefRangeHeaderBytes))
            return false;
        const u16 format = this.u16At(offset);
        if(format == 1u){
            if(!this.range(offset, s_FontAtlasClassDefArrayHeaderBytes))
                return false;
            const u32 start = cast<u32>(this.u16At(offset + s_FontAtlasClassDefStartGlyphOffset));
            const u32 count = cast<u32>(this.u16At(offset + s_FontAtlasClassDefGlyphCountOffset));
            if(start + count > this.m_glyphCount || !this.range(offset + s_FontAtlasClassDefArrayHeaderBytes, cast<u64>(count) * s_FontAtlasOtU16Bytes) || !this.spend(count))
                return false;
            for(u32 index = 0u; index < count; ++index)
                if(cast<u32>(this.u16At(offset + s_FontAtlasClassDefArrayHeaderBytes + cast<u64>(index) * s_FontAtlasOtU16Bytes)) >= classCount)
                    return false;
            return true;
        }
        if(format != s_FontAtlasClassDefRangeFormat)
            return false;
        const u32 count = cast<u32>(this.u16At(offset + s_FontAtlasClassDefRangeCountOffset));
        if(!this.range(offset + s_FontAtlasClassDefRangeHeaderBytes, cast<u64>(count) * s_FontAtlasOtRangeRecordBytes) || !this.spend(count))
            return false;
        u32 previous = 0u;
        for(u32 index = 0u; index < count; ++index){
            const u64 record = offset + s_FontAtlasClassDefRangeHeaderBytes + cast<u64>(index) * s_FontAtlasOtRangeRecordBytes;
            const u32 start = cast<u32>(this.u16At(record));
            const u32 end = cast<u32>(this.u16At(record + s_FontAtlasOtRangeRecordEndOffset));
            if(start > end || end >= this.m_glyphCount || (index > 0u && start <= previous) || cast<u32>(this.u16At(record + s_FontAtlasOtRangeRecordValueOffset)) >= classCount)
                return false;
            previous = end;
        }
        return true;
    }

    public b8 device(in u64 parent, in u32 offset){
        if(offset == 0u)
            return true;
        const u64 table = parent + offset;
        if(!this.range(table, s_FontAtlasDeviceHeaderBytes))
            return false;
        const u32 format = cast<u32>(this.u16At(table + s_FontAtlasDeviceDeltaFormatOffset));
        if(format == s_FontAtlasVariationIndexDeltaFormat)
            return true;
        const u32 start = cast<u32>(this.u16At(table));
        const u32 end = cast<u32>(this.u16At(table + s_FontAtlasDeviceEndSizeOffset));
        if(format < 1u || format > s_FontAtlasDeviceMaxDeltaFormat || start > end)
            return false;
        const u32 bits = 1u << format;
        return this.range(table + s_FontAtlasDeviceHeaderBytes, cast<u64>(((end - start + 1u) * bits + s_FontAtlasDeviceDeltaWordRoundUp) / s_FontAtlasDeviceDeltaWordBits * s_FontAtlasOtU16Bytes));
    }

    private Span<u8> m_bytes;
    private u32 m_glyphCount;
    private u32 m_budget;
}

b8 ValidateFontAtlasGdefTableBytes(in Span<u8> bytes, in u32 glyphCount){
    FontAtlasOtTableReader reader(bytes, glyphCount);
    if(!reader.range(0u, s_FontAtlasGdefHeaderBytes) || reader.u16At(0u) != 1u || cast<u32>(reader.u16At(s_FontAtlasOtMinorVersionOffset)) > s_FontAtlasGdefItemVarStoreMinorVersion || reader.u16At(s_FontAtlasOtMinorVersionOffset) == 1u)
        return false;
    const u32 minor = cast<u32>(reader.u16At(s_FontAtlasOtMinorVersionOffset));
    u32 headerSize = s_FontAtlasGdefHeaderBytes;
    if(minor == s_FontAtlasGdefItemVarStoreMinorVersion)
        headerSize = s_FontAtlasGdefHeaderV13Bytes;
    else if(minor == s_FontAtlasGdefMarkGlyphSetsMinorVersion)
        headerSize = s_FontAtlasGdefHeaderV12Bytes;
    if(!reader.range(0u, headerSize))
        return false;
    if(!reader.classDef(cast<u64>(reader.u16At(s_FontAtlasGdefGlyphClassDefOffset)), s_FontAtlasGdefGlyphClassCount) || !reader.classDef(cast<u64>(reader.u16At(s_FontAtlasGdefMarkAttachClassDefOffset)), s_FontAtlasOtAnyClassCount))
        return false;
    for(u32 field = s_FontAtlasGdefAttachListOffset; field <= s_FontAtlasGdefLigCaretListOffset; field += s_FontAtlasOtU16Bytes){
        const u64 list = cast<u64>(reader.u16At(field));
        if(list == 0u)
            continue;
        if(!reader.range(list, s_FontAtlasGdefGlyphListHeaderBytes))
            return false;
        const u32 count = cast<u32>(reader.u16At(list + s_FontAtlasGdefGlyphListCountOffset));
        const Expected<u32> coverageCount = reader.coverage(list + reader.u16At(list));
        if(!coverageCount.has_value() || count != coverageCount.value() || !reader.range(list + s_FontAtlasGdefGlyphListHeaderBytes, cast<u64>(count) * s_FontAtlasOtU16Bytes))
            return false;
        for(u32 index = 0u; index < count; ++index){
            const u64 item = list + reader.u16At(list + s_FontAtlasGdefGlyphListHeaderBytes + cast<u64>(index) * s_FontAtlasOtU16Bytes);
            if(item == list || !reader.range(item, s_FontAtlasOtU16Bytes) || !reader.range(item + s_FontAtlasOtU16Bytes, cast<u64>(reader.u16At(item)) * s_FontAtlasOtU16Bytes))
                return false;
            if(s_FontAtlasGdefLigCaretListOffset == field){
                const u32 caretCount = cast<u32>(reader.u16At(item));
                for(u32 caret = 0u; caret < caretCount; ++caret){
                    const u64 target = item + reader.u16At(item + s_FontAtlasOtU16Bytes + cast<u64>(caret) * s_FontAtlasOtU16Bytes);
                    if(target == item || !reader.range(target, s_FontAtlasCaretValueBytes))
                        return false;
                    const u16 format = reader.u16At(target);
                    if(
                        format < 1u
                        || cast<u32>(format) > s_FontAtlasCaretValueDeviceFormat
                        || (
                            cast<u32>(format) == s_FontAtlasCaretValueDeviceFormat
                            && (!reader.range(target, s_FontAtlasCaretValueDeviceBytes) || !reader.device(target, cast<u32>(reader.u16At(target + s_FontAtlasCaretValueDeviceOffset))))
                        )
                    )
                        return false;
                }
            }
        }
    }
    if(minor >= s_FontAtlasGdefMarkGlyphSetsMinorVersion && reader.u16At(s_FontAtlasGdefMarkGlyphSetsOffset) != 0u){
        const u64 sets = cast<u64>(reader.u16At(s_FontAtlasGdefMarkGlyphSetsOffset));
        if(!reader.range(sets, s_FontAtlasMarkGlyphSetsHeaderBytes))
            return false;
        const u32 setCount = cast<u32>(reader.u16At(sets + s_FontAtlasMarkGlyphSetsCountOffset));
        if(reader.u16At(sets) != 1u || !reader.range(sets + s_FontAtlasMarkGlyphSetsHeaderBytes, cast<u64>(setCount) * s_FontAtlasOtU32Bytes))
            return false;
        for(u32 index = 0u; index < setCount; ++index){
            const u32 offset = reader.u32At(sets + s_FontAtlasMarkGlyphSetsHeaderBytes + cast<u64>(index) * s_FontAtlasOtU32Bytes);
            if(offset == 0u || !reader.coverage(sets + offset).has_value())
                return false;
        }
    }
    if(minor == s_FontAtlasGdefItemVarStoreMinorVersion && reader.u32At(s_FontAtlasGdefItemVarStoreOffset) != 0u){
        const u64 store = cast<u64>(reader.u32At(s_FontAtlasGdefItemVarStoreOffset));
        if(!reader.range(store, s_FontAtlasItemVarStoreHeaderBytes) || reader.u16At(store) != 1u || !reader.range(store + s_FontAtlasItemVarStoreHeaderBytes, cast<u64>(reader.u16At(store + s_FontAtlasItemVarStoreDataCountOffset)) * s_FontAtlasOtU32Bytes))
            return false;
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
