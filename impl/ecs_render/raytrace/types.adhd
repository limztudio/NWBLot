// Semantic identities selected by the current scene preflight, including direct transform and material edits.
// Runtime deformation is unstamped.
// Static mesh, texture and shader resources remain immutable until invalidation.
class RayTracingSceneContentStamp{
    public RayTracingSceneContentStamp(){
        this.geometry = 0u;
        this.material = 0u;
        this.trusted = false;
    }

    public RayTracingSceneContentStamp(in u64 inGeometry, in u64 inMaterial, in b8 inTrusted){
        this.geometry = inGeometry;
        this.material = inMaterial;
        this.trusted = inTrusted;
    }

    public u64 geometry;
    public u64 material;
    public b8 trusted;
}

class RayTracingDispatchGroups{
    public u32 width = 0u;
    public u32 height = 0u;
    public u32 x = 0u;
    public u32 y = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


RayTracingDispatchGroups ResolveRayTracingDispatchGroups(in u32 width, in u32 height, in u32 receiverFactor, in u32 groupSize){
    const u32 receiverWidth = divideUp(width, receiverFactor);
    const u32 receiverHeight = divideUp(height, receiverFactor);
    RayTracingDispatchGroups groups;
    groups.width = receiverWidth;
    groups.height = receiverHeight;
    groups.x = divideUp(receiverWidth, groupSize);
    groups.y = divideUp(receiverHeight, groupSize);
    return groups;
}

u32 ResolveWrappingRayTracingDispatchGroup(in u32 dimension, in u32 receiverFactor, in u32 groupSize){
    return divideUp(divideUpWrappingU32(dimension, receiverFactor), groupSize);
}

NwbRtInstanceMaterialGpu ResolveInstanceShadowMaterialData(in u32 surfaceDispatchId, in u32 shadingModelId, in b8 transparent, in b8 refractive, in u32 materialConstantByteOffset, in u32 meshInstanceIndex){
    NwbRtInstanceMaterialGpu material;
    material.surfaceDispatchId = surfaceDispatchId;
    material.shadingModelId = shadingModelId;
    u32 flags = cast<u32>(RtInstanceMaterialFlag::None);
    if(transparent)
        flags |= cast<u32>(RtInstanceMaterialFlag::Transparent);
    if(refractive)
        flags |= cast<u32>(RtInstanceMaterialFlag::Refractive);
    material.flags = flags;
    material.materialConstantByteOffset = materialConstantByteOffset;
    material.meshInstanceIndex = meshInstanceIndex;
    return material;
}

u32 ResolveRayTracingInstanceMask(in b8 transparent, in b8 refractive){
    u32 mask = s_RtOpticalBaseInstanceMask | s_RtShadowBaseInstanceMask;
    if(transparent)
        mask |= s_RtOpticalTransparentInstanceMask | s_RtShadowTransparentInstanceMask;
    if(refractive)
        mask |= s_RtRefractiveInstanceMask;
    return mask;
}

u32 ResolveRayTracingCsgInstanceMask(in b8 transparent){
    u32 mask = s_RtOpticalBaseInstanceMask | s_RtCsgInstanceMask;
    if(transparent)
        mask |= s_RtOpticalTransparentInstanceMask;
    return mask;
}


void InflateSwShadowSceneBounds(mut VectorSingle inOutBoundsMin, mut VectorSingle inOutBoundsMax){
    const VectorSingle extent = inOutBoundsMax - inOutBoundsMin;
    const f32 maxExtent = max(extent.x, max(extent.y, extent.z));
    const f32 padding = max(s_SwShadowSceneBoundsMinPadding, maxExtent * s_SwShadowSceneBoundsRelativePadding);
    const VectorSingle paddingVector(padding, padding, padding, 0.0f);
    inOutBoundsMin = inOutBoundsMin - paddingVector;
    inOutBoundsMax = inOutBoundsMax + paddingVector;
}


