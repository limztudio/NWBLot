    self.expectRange(MakeUiEditCaretRange(1u, 1u), 0u, Rect());
}

void VerifyEditCaretRangeFixture_CrossLineSelectionIncludesContentAndEachSelectedBreakCap(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("abc\nx\nyz"));
