include("${CMAKE_CURRENT_LIST_DIR}/fbx_to_nwb_test_helpers.cmake")

if(NOT EXISTS "/dev/full")
    message(FATAL_ERROR "Delayed-write regression requires Linux /dev/full")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(control_path "${OUTPUT_DIR}/model_control.nwb")
execute_process(COMMAND "${FBX_TO_NWB_EXE}" "${INPUT_FBX}" --output "${control_path}" --asset-type model --preserve-space --yes --force RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT ${nwb_fbx_to_nwb_process_timeout_seconds})
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Delayed-write control export failed:\n${stdout}\n${stderr}")
endif()

# These small outputs fit the stream buffer; /dev/full rejects the delayed flush at close.
foreach(asset_type IN ITEMS mesh model bunch)
    string(RANDOM LENGTH 12 ALPHABET "0123456789abcdef" invocation)
    set(failure_path "${OUTPUT_DIR}/${asset_type}_${invocation}.nwb")
    file(CREATE_LINK "/dev/full" "${failure_path}" SYMBOLIC RESULT link_result)
    if(NOT link_result STREQUAL "0")
        message(FATAL_ERROR "Failed to prepare delayed-write destination: ${link_result}")
    endif()
    execute_process(COMMAND "${FBX_TO_NWB_EXE}" "${INPUT_FBX}" --output "${failure_path}" --asset-type "${asset_type}" --preserve-space --yes --force RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT ${nwb_fbx_to_nwb_process_timeout_seconds})
    file(REMOVE "${failure_path}")
    if(NOT result EQUAL 1)
        message(FATAL_ERROR "Buffered ${asset_type} write failure must return exit1, got ${result}:\n${stdout}\n${stderr}")
    endif()
endforeach()
