////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_texture/basis_transcoder.adhd>
#include <impl/assets_texture/loader.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TextureDecodeWorkItem{
    public usize mipIndex = 0u;
    public u32 slice = 0u;
    public usize offset = 0u;
    public usize count = 0u;
    public u32 blockRowBegin = 0u;
    public u32 blockRowEnd = 0u;
}

f32 NormalizeTextureAlphaUnorm8(in u8 alphaUnorm8){
    const VectorSingle normalized = VectorSingle(cast<f32>(alphaUnorm8)) / VectorSingle(cast<f32>(u8.max));
    return normalized.x;
}

u8 ResolveHdrUniformAlphaUnorm8(in b8 isConstantUnorm8, in u8 alphaConstantUnorm8){
    if(isConstantUnorm8)
        return alphaConstantUnorm8;
    return u8.max;
}

b8 ValidateAstcSliceByteCount(in b8 hasSource, in u64 sourceBytes, in usize uploadBytes){
    if(hasSource && sourceBytes == cast<u64>(uploadBytes))
        return true;

    error("TextureAssetLoader: ASTC UASTC slice size is invalid");
    return false;
}

b8 ValidateRgba8SliceLayout(in b8 hasSource, in usize expectedBytes, in usize uploadBytes){
    if(hasSource && expectedBytes == uploadBytes)
        return true;

    error("TextureAssetLoader: invalid RGBA8 UASTC slice layout");
    return false;
}

b8 ValidateSupportedLdrTextureUploadFormat(in b8 isSupported){
    if(isSupported)
        return true;

    error("TextureAssetLoader: unsupported linear LDR texture upload format");
    return false;
}

b8 ValidateSupportedHdrTextureUploadFormat(in b8 isSupported){
    if(isSupported)
        return true;

    error("TextureAssetLoader: unsupported HDR texture upload format");
    return false;
}

void LogUastcTranscodeFailure(in StringView message){
    error("TextureAssetLoader: {}", message);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(s_TextureRgba16FloatBytesPerTexel == size_of<u16>() * s_TextureRgba16FloatComponentCount);
static_assert(s_TextureRgba16FloatAlphaByteOffset == size_of<u16>() * (s_TextureRgba16FloatComponentCount - 1u));

const u64 s_TextureParallelStripMinBlocks = 4096u;
const u32 s_TextureParallelStripMinBlockRows = 8u;
const u32 s_TextureParallelStripTargetRows = 4u;
const usize s_TextureParallelMaxStrips = 32u;

b8 ShouldParallelizeTextureStrips(in TextureMipLevel mip, in b8 allowParallel){
    if(!allowParallel || mip.blockCountY < s_TextureParallelStripMinBlockRows)
        return false;
    return cast<u64>(mip.blockCountX) * cast<u64>(mip.blockCountY) >= s_TextureParallelStripMinBlocks;
}

usize ComputeTextureParallelStripCount(in u32 blockCountY){
    const usize rowGroups = cast<usize>((blockCountY + s_TextureParallelStripTargetRows - 1u) / s_TextureParallelStripTargetRows);
    if(rowGroups <= 1u)
        return 1u;
    if(rowGroups >= s_TextureParallelMaxStrips)
        return s_TextureParallelMaxStrips;
    return rowGroups;
}

u32 ComputeTextureStripBlockRow(in usize stripIndex, in u32 blockCountY, in usize stripCount){
    return cast<u32>((stripIndex * cast<usize>(blockCountY)) / stripCount);
}

b8 AllParallelFlagsSucceeded(in Vector<u8> flags){
    for(in u8 ok : flags){
        if(ok == 0u)
            return false;
    }
    return true;
}

b8 DecodeUastcTexels(
    in TextureMipLevel mip,
    in Span<u8> source,
    in b8 alphaOnly,
    in usize offset,
    mut Span<u8> output,
    in b8 allowStripParallel
){
    if(ShouldParallelizeTextureStrips(mip, allowStripParallel)){
        const usize stripCount = ComputeTextureParallelStripCount(mip.blockCountY);
        Vector<u8> stripOk;
        stripOk.resize(stripCount, 0u);
        parallel_for(usize strip = 0u; strip < stripCount; ++strip){
            const u32 blockRowBegin = ComputeTextureStripBlockRow(strip, mip.blockCountY, stripCount);
            const u32 blockRowEnd = ComputeTextureStripBlockRow(strip + 1u, mip.blockCountY, stripCount);
            if(UnpackBasisRgbaSliceRange(mip.width, mip.height, mip.blockCountX, mip.blockCountY, source, alphaOnly, output, offset, blockRowBegin, blockRowEnd))
                stripOk[strip] = 1u;
        }
        return AllParallelFlagsSucceeded(stripOk);
    }
    return UnpackBasisRgbaSlice(mip.width, mip.height, mip.blockCountX, mip.blockCountY, source, alphaOnly, output, offset);
}

b8 TranscodeBasisAstcSliceMaybeParallel(
    in TextureMipLevel mip,
    in Span<u8> sourceBytes,
    mut Span<u8> output,
    in usize offset,
    in b8 allowStripParallel
){
    if(ShouldParallelizeTextureStrips(mip, allowStripParallel)){
        const usize stripCount = ComputeTextureParallelStripCount(mip.blockCountY);
        const usize blocksX = cast<usize>(mip.blockCountX);
        Vector<u8> stripOk;
        stripOk.resize(stripCount, 0u);
        parallel_for(usize strip = 0u; strip < stripCount; ++strip){
            const usize blockRowBegin = cast<usize>(ComputeTextureStripBlockRow(strip, mip.blockCountY, stripCount));
            const usize blockRowEnd = cast<usize>(ComputeTextureStripBlockRow(strip + 1u, mip.blockCountY, stripCount));
            if(TranscodeBasisAstcSliceRange(sourceBytes, output, offset, blockRowBegin * blocksX, blockRowEnd * blocksX))
                stripOk[strip] = 1u;
        }
        return AllParallelFlagsSucceeded(stripOk);
    }
    return TranscodeBasisAstcSlice(sourceBytes, output, offset);
}

b8 TranscodeBasisImageMaybeParallel(
    in TextureMipLevel mip,
    in BasisTranscodeFormat target,
    in BasisTranscodeLayout layout,
    in Span<u8> sourceBytes,
    mut Span<u8> output,
    in usize offset,
    in usize count,
    in b8 allowStripParallel
){
    if(ShouldParallelizeTextureStrips(mip, allowStripParallel)){
        const usize stripCount = ComputeTextureParallelStripCount(mip.blockCountY);
        Vector<u8> stripOk;
        stripOk.resize(stripCount, 0u);
        parallel_for(usize strip = 0u; strip < stripCount; ++strip){
            const u32 blockRowBegin = ComputeTextureStripBlockRow(strip, mip.blockCountY, stripCount);
            const u32 blockRowEnd = ComputeTextureStripBlockRow(strip + 1u, mip.blockCountY, stripCount);
            if(TranscodeBasisImageRowRange(target, layout, sourceBytes, output, offset, count, blockRowBegin, blockRowEnd))
                stripOk[strip] = 1u;
        }
        return AllParallelFlagsSucceeded(stripOk);
    }
    return TranscodeBasisImage(target, layout, sourceBytes, output, offset, count);
}

BasisTranscodeLayout MakeBasisTranscodeLayout(
    in TextureMipLevel mip,
    in u32 mipLevel,
    in u32 elementCount,
    in u32 rowPitch
){
    BasisTranscodeLayout layout;
    layout.width = mip.width;
    layout.height = mip.height;
    layout.blockCountX = mip.blockCountX;
    layout.blockCountY = mip.blockCountY;
    layout.mipLevel = mipLevel;
    layout.outputElements = elementCount;
    layout.outputRowPitch = rowPitch;
    return layout;
}

b8 DecodeLdrTextureSlice(
    in Texture asset,
    in TextureMipLevel mip,
    in u32 mipLevel,
    in u32 slice,
    in Format format,
    in usize offset,
    in usize count,
    mut Span<u8> output,
    in u32 blockRowBegin,
    in u32 blockRowEnd,
    in b8 allowStripParallel
){
    const b8 fullSlice = blockRowBegin == 0u && blockRowEnd == mip.blockCountY;
    usize rgbaBytes = count;
    if(format != Format::ASTC_4x4_UNORM && format != Format::BC7_UNORM){
        const Expected<usize> expected = TryComputeRgba8FallbackMipBytes(mip.width, mip.height);
        if(!expected.has_value())
            return false;
        rgbaBytes = expected.value();
        if(rgbaBytes != count)
            return ValidateRgba8SliceLayout(false, rgbaBytes, count);
    }
    const Expected<PrimaryUastcSlice> source = TryGetPrimaryUastcSlice(asset.payloadBytes(), asset.primaryPayloadByteCount(), mip, slice);
    if(format == Format::ASTC_4x4_UNORM){
        usize sourceSize = 0u;
        if(source.has_value())
            sourceSize = source.value().bytes.size();
        if(!ValidateAstcSliceByteCount(source.has_value(), cast<u64>(sourceSize), count))
            return false;
        b8 transcoded = false;
        if(fullSlice)
            transcoded = TranscodeBasisAstcSliceMaybeParallel(mip, source.value().bytes, output, offset, allowStripParallel);
        else{
            const usize blocksX = cast<usize>(mip.blockCountX);
            transcoded = TranscodeBasisAstcSliceRange(source.value().bytes, output, offset, cast<usize>(blockRowBegin) * blocksX, cast<usize>(blockRowEnd) * blocksX);
        }
        if(!transcoded){
            LogUastcTranscodeFailure("UASTC-to-ASTC transcoding failed");
            return false;
        }
        return true;
    }
    if(format == Format::BC7_UNORM){
        if(!source.has_value()){
            LogUastcTranscodeFailure("BC7 UASTC slice size is invalid");
            return false;
        }
        if(!ValidateBc7UastcTranscodeLayout(source.value(), count))
            return false;
        const BasisTranscodeLayout layout = MakeBasisTranscodeLayout(mip, mipLevel, cast<u32>(source.value().blockCount), mip.blockCountX);
        b8 transcoded = false;
        if(fullSlice)
            transcoded = TranscodeBasisImageMaybeParallel(mip, BasisTranscodeFormat::Bc7, layout, source.value().bytes, output, offset, count, allowStripParallel);
        else
            transcoded = TranscodeBasisImageRowRange(BasisTranscodeFormat::Bc7, layout, source.value().bytes, output, offset, count, blockRowBegin, blockRowEnd);
        if(!transcoded){
            LogUastcTranscodeFailure("UASTC-to-BC7 transcoding failed");
            return false;
        }
        return true;
    }
    if(!ValidateRgba8SliceLayout(source.has_value(), rgbaBytes, count))
        return false;
    assert(source.value().bytes.size() == source.value().blockCount * s_TextureUastcBytesPerBlock);
    b8 unpacked = false;
    if(fullSlice)
        unpacked = DecodeUastcTexels(mip, source.value().bytes, false, offset, output, allowStripParallel);
    else
        unpacked = UnpackBasisRgbaSliceRange(mip.width, mip.height, mip.blockCountX, mip.blockCountY, source.value().bytes, false, output, offset, blockRowBegin, blockRowEnd);
    if(!unpacked){
        LogUastcTranscodeFailure("UASTC-to-RGBA8 decoding failed");
        return false;
    }
    return true;
}

b8 MergeHdrAlpha(
    in Texture asset,
    in TextureMipLevel mip,
    in u32 slice,
    in usize offset,
    in usize count,
    mut Span<u8> output,
    in u32 blockRowBegin,
    in u32 blockRowEnd,
    in b8 allowStripParallel
){
    const b8 fullSlice = blockRowBegin == 0u && blockRowEnd == mip.blockCountY;
    const Expected<usize> texels = ValidateHdrRgba16FloatAlphaMergeLayout(mip, count);
    if(!texels.has_value())
        return false;
    if(asset.alphaMode() != TextureAlphaMode::SeparateUastcLdr4x4){
        const u8 alpha = ResolveHdrUniformAlphaUnorm8(asset.alphaMode() == TextureAlphaMode::ConstantUnorm8, asset.alphaConstantUnorm8());
        const u16 half = BasisFloatToHalf(NormalizeTextureAlphaUnorm8(alpha));
        const u8 halfLo = cast<u8>(half);
        const u8 halfHi = cast<u8>(half >> 8u);
        usize texelBegin = 0u;
        usize texelEnd = texels.value();
        if(!fullSlice){
            const u32 pixelRowBegin = blockRowBegin * 4u;
            u32 pixelRowEnd = blockRowEnd * 4u;
            if(pixelRowEnd > mip.height)
                pixelRowEnd = mip.height;
            texelBegin = cast<usize>(pixelRowBegin) * cast<usize>(mip.width);
            texelEnd = cast<usize>(pixelRowEnd) * cast<usize>(mip.width);
        }
        for(usize i = texelBegin; i < texelEnd; ++i){
            const usize alphaOffset = offset + i * s_TextureRgba16FloatBytesPerTexel + s_TextureRgba16FloatAlphaByteOffset;
            output[alphaOffset] = halfLo;
            output[alphaOffset + 1u] = halfHi;
        }
        return true;
    }
    const Expected<Span<u8>> alpha = TryGetSeparateAlphaUastcSlice(
        asset.payloadBytes(), asset.primaryPayloadByteCount(), !asset.alphaUastcBlocks().empty(), mip, slice
    );
    if(!alpha.has_value())
        return false;
    assert(alpha.value().size() == cast<u64>(mip.blockCountX) * mip.blockCountY * s_TextureUastcBytesPerBlock);
    b8 unpackedAlpha = false;
    if(fullSlice)
        unpackedAlpha = DecodeUastcTexels(mip, alpha.value(), true, offset, output, allowStripParallel);
    else
        unpackedAlpha = UnpackBasisRgbaSliceRange(mip.width, mip.height, mip.blockCountX, mip.blockCountY, alpha.value(), true, output, offset, blockRowBegin, blockRowEnd);
    if(!unpackedAlpha){
        LogUastcTranscodeFailure("UASTC alpha decoding failed");
        return false;
    }
    return true;
}

b8 DecodeHdrTextureSlice(
    in Texture asset,
    in TextureMipLevel mip,
    in u32 mipLevel,
    in u32 slice,
    in Format format,
    in usize offset,
    in usize count,
    mut Span<u8> output,
    in u32 blockRowBegin,
    in u32 blockRowEnd,
    in b8 allowStripParallel
){
    const b8 fullSlice = blockRowBegin == 0u && blockRowEnd == mip.blockCountY;
    const Expected<PrimaryUastcSlice> source = TryGetPrimaryUastcSlice(asset.payloadBytes(), asset.primaryPayloadByteCount(), mip, slice);
    if(!source.has_value())
        return false;
    BasisTranscodeFormat target = BasisTranscodeFormat::RgbaHalf;
    if(format == Format::ASTC_4x4_FLOAT)
        target = BasisTranscodeFormat::AstcHdr4x4;
    else if(format == Format::BC6H_UFLOAT)
        target = BasisTranscodeFormat::Bc6h;
    else if(format != Format::RGBA16_FLOAT){
        LogUastcTranscodeFailure("unsupported HDR UASTC upload format");
        return false;
    }
    const Expected<HdrUastcOutputLayout> outputLayout = ValidateHdrUastcTranscodeLayout(mip, source.value(), target != BasisTranscodeFormat::RgbaHalf, count);
    if(!outputLayout.has_value())
        return false;
    const BasisTranscodeLayout layout = MakeBasisTranscodeLayout(mip, mipLevel, outputLayout.value().elementCount, outputLayout.value().rowBlocksOrPixels);
    b8 transcoded = false;
    if(fullSlice)
        transcoded = TranscodeBasisImageMaybeParallel(mip, target, layout, source.value().bytes, output, offset, count, allowStripParallel);
    else
        transcoded = TranscodeBasisImageRowRange(target, layout, source.value().bytes, output, offset, count, blockRowBegin, blockRowEnd);
    if(!transcoded){
        LogUastcTranscodeFailure("HDR UASTC transcoding failed");
        return false;
    }
    return format != Format::RGBA16_FLOAT || MergeHdrAlpha(asset, mip, slice, offset, count, output, blockRowBegin, blockRowEnd, allowStripParallel);
}

[cpp_unwind]
b8 DecodeTextureMipSlice(
    in b8 isHdr,
    in Texture asset,
    in TextureMipLevel mip,
    in u32 mipLevel,
    in u32 slice,
    in Format format,
    in usize offset,
    in usize count,
    mut Span<u8> output,
    in u32 blockRowBegin,
    in u32 blockRowEnd,
    in b8 allowStripParallel
){
    if(isHdr)
        return DecodeHdrTextureSlice(asset, mip, mipLevel, slice, format, offset, count, output, blockRowBegin, blockRowEnd, allowStripParallel);
    return DecodeLdrTextureSlice(asset, mip, mipLevel, slice, format, offset, count, output, blockRowBegin, blockRowEnd, allowStripParallel);
}

[cpp_unwind]
b8 DecodeTextureMipSlices(
    in b8 isHdr,
    in Texture asset,
    in TextureMipLevel mip,
    in u32 mipLevel,
    in Format format,
    in usize sliceByteCount,
    in usize totalBytes,
    mut Span<u8> outputBytes,
    in b8 allowStripParallel
){
    if(mip.sliceCount > 1u && totalBytes >= 65536u){
        Vector<u8> sliceOk;
        sliceOk.resize(cast<usize>(mip.sliceCount), 0u);
        parallel_for(usize sliceIndex = 0u; sliceIndex < cast<usize>(mip.sliceCount); ++sliceIndex){
            if(DecodeTextureMipSlice(isHdr, asset, mip, mipLevel, cast<u32>(sliceIndex), format, sliceIndex * sliceByteCount, sliceByteCount, outputBytes, 0u, mip.blockCountY, false))
                sliceOk[sliceIndex] = 1u;
        }
        return AllParallelFlagsSucceeded(sliceOk);
    }
    for(u32 slice = 0u; slice < mip.sliceCount; ++slice){
        if(!DecodeTextureMipSlice(isHdr, asset, mip, mipLevel, slice, format, cast<usize>(slice) * sliceByteCount, sliceByteCount, outputBytes, 0u, mip.blockCountY, allowStripParallel))
            return false;
    }
    return true;
}

[cpp_unwind]
Expected<TextureDecodedMipUpload> DecodeTextureMip(
    in b8 isHdr,
    in Texture asset,
    in TextureMipLevel mip,
    in u32 mipLevel,
    in Format format,
    in b8 allowStripParallel
){
    InitializeBasisTranscoder();
    Expected<TextureMipUploadLayout> layout = MakeUnexpected(Failure());
    if(isHdr){
        const b8 compressed = IsHdrCompressedFormat(format);
        if(!ValidateSupportedHdrTextureUploadFormat(compressed || format == Format::RGBA16_FLOAT))
            return MakeUnexpected(Failure());
        layout = ValidateAndComputeHdrMipUploadLayout(mip, compressed);
    }
    else{
        if(!ValidateSupportedLdrTextureUploadFormat(format == Format::ASTC_4x4_UNORM || format == Format::BC7_UNORM || format == Format::RGBA8_UNORM))
            return MakeUnexpected(Failure());
        layout = ValidateAndComputeLdrMipUploadLayout(mip, format == Format::RGBA8_UNORM);
    }
    if(!layout.has_value())
        return MakeUnexpected(Failure());
    TextureDecodedMipUpload upload;
    upload.rowPitch = layout.value().rowPitch;
    upload.sliceByteCount = layout.value().sliceByteCount;
    upload.bytes.resize(layout.value().totalByteCount);
    if(!DecodeTextureMipSlices(isHdr, asset, mip, mipLevel, format, upload.sliceByteCount, layout.value().totalByteCount, upload.bytes, allowStripParallel))
        return MakeUnexpected(Failure());
    return upload;
}

[cpp_unwind]
Expected<TextureDecodedMipUpload> TextureMipDecoder::decodeLdr(in Texture asset, in TextureMipLevel mip, in u32 mipLevel, in Format format){
    return DecodeTextureMip(false, asset, mip, mipLevel, format, mip.sliceCount == 1u);
}

[cpp_unwind]
Expected<TextureDecodedMipUpload> TextureMipDecoder::decodeHdr(in Texture asset, in TextureMipLevel mip, in u32 mipLevel, in Format format){
    return DecodeTextureMip(true, asset, mip, mipLevel, format, mip.sliceCount == 1u);
}

[cpp_unwind]
Expected<QueueSubmissionToken, TextureUploadFailure> TextureMipDecoder::decodeAndUploadStaticTextureMips(
    in Texture asset,
    in Format format,
    mut GraphicsRuntime graphics,
    in TextureHandle texture
){
    InitializeBasisTranscoder();
    const usize mipCount = asset.mipLevels().size();
    Vector<TextureDecodedMipUpload> decodedMips;
    decodedMips.resize(mipCount);
    if(mipCount > 0u){
        const b8 isHdr = asset.payloadFormat() == TexturePayloadFormat::UastcHdr4x4;
        if(!isHdr && asset.payloadFormat() != TexturePayloadFormat::UastcLdr4x4){
            error("TextureAssetLoader: unsupported texture payload format");
            return MakeUnexpected(TextureUploadFailure::Decode);
        }
        if(isHdr){
            const b8 compressed = IsHdrCompressedFormat(format);
            if(!ValidateSupportedHdrTextureUploadFormat(compressed || format == Format::RGBA16_FLOAT))
                return MakeUnexpected(TextureUploadFailure::Decode);
        }
        else if(!ValidateSupportedLdrTextureUploadFormat(format == Format::ASTC_4x4_UNORM || format == Format::BC7_UNORM || format == Format::RGBA8_UNORM))
            return MakeUnexpected(TextureUploadFailure::Decode);

        Vector<TextureDecodeWorkItem> workItems;
        workItems.reserve(mipCount * 4u);
        for(usize mipIndex = 0u; mipIndex < mipCount; ++mipIndex){
            in TextureMipLevel mip = asset.mipLevels()[mipIndex];
            mut TextureDecodedMipUpload mipUpload = decodedMips[mipIndex];
            Expected<TextureMipUploadLayout> layout = MakeUnexpected(Failure());
            if(isHdr)
                layout = ValidateAndComputeHdrMipUploadLayout(mip, IsHdrCompressedFormat(format));
            else
                layout = ValidateAndComputeLdrMipUploadLayout(mip, format == Format::RGBA8_UNORM);
            if(!layout.has_value())
                return MakeUnexpected(TextureUploadFailure::Decode);
            mipUpload.rowPitch = layout.value().rowPitch;
            mipUpload.sliceByteCount = layout.value().sliceByteCount;
            mipUpload.bytes.resize(layout.value().totalByteCount);

            const b8 splitStrips = ShouldParallelizeTextureStrips(mip, true);
            usize stripCount = 1u;
            if(splitStrips)
                stripCount = ComputeTextureParallelStripCount(mip.blockCountY);
            for(u32 slice = 0u; slice < mip.sliceCount; ++slice){
                const usize sliceOffset = cast<usize>(slice) * mipUpload.sliceByteCount;
                for(usize strip = 0u; strip < stripCount; ++strip){
                    TextureDecodeWorkItem item;
                    item.mipIndex = mipIndex;
                    item.slice = slice;
                    item.offset = sliceOffset;
                    item.count = mipUpload.sliceByteCount;
                    item.blockRowBegin = ComputeTextureStripBlockRow(strip, mip.blockCountY, stripCount);
                    item.blockRowEnd = ComputeTextureStripBlockRow(strip + 1u, mip.blockCountY, stripCount);
                    workItems.push_back(item);
                }
            }
        }

        if(workItems.size() == 1u){
            in TextureDecodeWorkItem item = workItems[0u];
            in TextureMipLevel mip = asset.mipLevels()[item.mipIndex];
            mut TextureDecodedMipUpload mipUpload = decodedMips[item.mipIndex];
            if(!DecodeTextureMipSlice(isHdr, asset, mip, cast<u32>(item.mipIndex), item.slice, format, item.offset, item.count, mipUpload.bytes, item.blockRowBegin, item.blockRowEnd, false))
                return MakeUnexpected(TextureUploadFailure::Decode);
        }
        else if(!workItems.empty()){
            Vector<u8> workOk;
            workOk.resize(workItems.size(), 0u);
            const Span<TextureDecodeWorkItem> workSpan = Span<TextureDecodeWorkItem>(workItems);
            parallel_for(usize itemIndex = 0u; itemIndex < workItems.size(); ++itemIndex){
                in TextureDecodeWorkItem item = workSpan[itemIndex];
                in TextureMipLevel mip = asset.mipLevels()[item.mipIndex];
                mut TextureDecodedMipUpload mipUpload = decodedMips[item.mipIndex];
                if(DecodeTextureMipSlice(isHdr, asset, mip, cast<u32>(item.mipIndex), item.slice, format, item.offset, item.count, mipUpload.bytes, item.blockRowBegin, item.blockRowEnd, false))
                    workOk[itemIndex] = 1u;
            }
            if(!AllParallelFlagsSucceeded(workOk))
                return MakeUnexpected(TextureUploadFailure::Decode);
        }
    }

    Vector<StandaloneTextureUploadRegion> regions;
    const b8 volume = asset.dimension() == TexturePayloadDimension::Texture3D;
    regions.reserve(ComputeTextureUploadRegionReserveCount(asset.mipLevels(), volume));
    for(usize i = 0u; i < asset.mipLevels().size(); ++i){
        in TextureMipLevel mip = asset.mipLevels()[i];
        in TextureDecodedMipUpload decoded = decodedMips[i];
        assert(!decoded.bytes.empty() && decoded.rowPitch != 0u && decoded.sliceByteCount != 0u && mip.sliceCount != 0u);
        StandaloneTextureUploadRegion region;
        region.rowPitch = decoded.rowPitch;
        region.depthPitch = decoded.sliceByteCount;
        region.mipLevel = cast<u32>(i);
        if(volume){
            region.setBytes(decoded.bytes);
            regions.push_back(region);
            continue;
        }
        const Span<u8> bytes = Span<u8>(decoded.bytes);
        for(u32 slice = 0u; slice < mip.sliceCount; ++slice){
            region.arraySlice = slice;
            region.setBytes(bytes.subspan(cast<usize>(slice) * decoded.sliceByteCount, decoded.sliceByteCount));
            regions.push_back(region);
        }
    }
    const Expected<QueueSubmissionToken> token = graphics.standaloneGraph().uploadTextureBatch(texture, Span<StandaloneTextureUploadRegion>(regions), ResourceStates::ShaderResource, ResourceStates::Unknown);
    if(!token.has_value())
        return MakeUnexpected(TextureUploadFailure::Submit);
    return token.value();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

