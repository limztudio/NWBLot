class PostGbufferNormalizeGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut Optional<GpuTimingMeasure> m_asyncPrefixTiming;
    private in GraphicsPrefixTimingTicket m_timingTicket;
    private in GpuTaskId m_shadowVisibilityTask;

    public PostGbufferNormalizeGraphTask(mut RendererRayTracingSystem raytracingSystem, mut Optional<GpuTimingMeasure> asyncPrefixTiming, in GraphicsPrefixTimingTicket timingTicket, in GpuTaskId shadowVisibilityTask){
        this.m_raytracingSystem = raytracingSystem;
        this.m_asyncPrefixTiming = asyncPrefixTiming;
        this.m_timingTicket = timingTicket;
        this.m_shadowVisibilityTask = shadowVisibilityTask;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(); }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        const auto queue = QueueForTask(context, this.m_shadowVisibilityTask);
        if(!queue.has_value())
            return false;
        GpuTimingTicketRecordingScope recording(this.m_timingTicket.value());
        if(queue.value().queueClass == CommandQueue::Compute && this.m_asyncPrefixTiming.has_value()){
            this.m_asyncPrefixTiming.value().finishTiming(commandList);
            this.m_asyncPrefixTiming.reset();
        }
        return true;
    }
    public void accepted(in QueueSubmissionToken token){
        this.m_raytracingSystem.confirmPreparedShadowTraceGeometryNormalization();
    }
}

class FrameTimingEndGraphTask{
    private mut GpuTimingFrameTransaction m_transaction;

    public FrameTimingEndGraphTask(mut GpuTimingFrameTransaction transaction){
        this.m_transaction = transaction;
    }

    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements commands;
        commands.requiresPrimaryGraphicsQueue = true;
        return commands;
    }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        return this.m_transaction.recordEnd(commandList);
    }
}

class FrameRecoveryGraphTask{
    private mut GpuTimingFrameTransaction m_transaction;
    private mut b8 m_armed;
    private mut b8 m_retiresFrameTiming;

    public FrameRecoveryGraphTask(mut GpuTimingFrameTransaction transaction, mut b8 armed, mut b8 retiresFrameTiming){
        this.m_transaction = transaction;
        this.m_armed = armed;
        this.m_retiresFrameTiming = retiresFrameTiming;
    }

    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements commands;
        commands.requiresPrimaryGraphicsQueue = true;
        return commands;
    }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        return this.m_armed && (!this.m_retiresFrameTiming || this.m_transaction.recordEnd(commandList));
    }
    [cpp_unwind]
    public void accepted(in QueueSubmissionToken token){
        if(this.m_armed && this.m_retiresFrameTiming && !this.m_transaction.confirmEndSubmission(token, false)){
            warning("RendererSystem: failed to retire frame recovery timing query");
            this.m_transaction.discard();
        }
        this.m_armed = false;
        this.m_retiresFrameTiming = false;
    }
    public void discarded(){
        if(this.m_armed)
            this.m_transaction.discard();
        this.m_armed = false;
        this.m_retiresFrameTiming = false;
    }
}

class DeferredBindlessDescriptorSources{
    public mut RhiSampler sampler;
    public mut RhiSampler avboitLinearSampler;
    public mut Buffer sceneShadingBuffer;
    public mut Buffer lightBuffer;

    public DeferredBindlessDescriptorSources(mut RhiSampler inSampler, mut RhiSampler inAvboitLinearSampler, mut Buffer inSceneShadingBuffer, mut Buffer inLightBuffer){
        this.sampler = inSampler;
        this.avboitLinearSampler = inAvboitLinearSampler;
        this.sceneShadingBuffer = inSceneShadingBuffer;
        this.lightBuffer = inLightBuffer;
    }
}

class DeferredBindlessDescriptorRegistrar : NoCopy{
    private mut GpuDescriptorHeap m_heap;
    private mut DeferredFrameTargets m_targets;
    private mut DeferredBindlessDescriptorSources m_sources;

    public DeferredBindlessDescriptorRegistrar(mut GpuDescriptorHeap heap, mut DeferredFrameTargets targets, mut DeferredBindlessDescriptorSources sources){
        this.m_heap = heap;
        this.m_targets = targets;
        this.m_sources = sources;
    }

    public Expected<void> registerAll();

    private Expected<void> registerLightingTargets();
    private Expected<void> registerTransparencyTargets();
    private Expected<void> registerSceneBuffers();
    private Expected<void> registerCsgIntervalTargets();
    private Expected<void> registerCausticResolveTargets();
    private Expected<void> registerSoftShadowTargets();
}

