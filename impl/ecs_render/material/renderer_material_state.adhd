#include <impl/ecs_render/material/material_instance_mutable_cache.adhd>
#include <impl/ecs_render/material/sampled_texture_collection.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererMaterialState : NoCopy{
    public BindingLayoutHandle m_materialPassBindingLayout;
    public BindingLayoutHandle m_computeBindingLayout;
    public BufferHandle m_instanceBuffer;
    public BufferHandle m_materialTypedBuffer;
    public ShaderHandle m_emulationVertexShader;
    public InputLayoutHandle m_emulationInputLayout;
    public ShaderHandle m_objectGeometryDecodeShader;
    public ComputePipelineHandle m_objectGeometryDecodePipeline;
    public InputLayoutHandle m_objectGeometryInputLayout;
    public HashMap<Name, MaterialSurfaceInfo> m_surfaceInfos;
    public RendererMaterialResourceState m_resourceState;
    public HashMap<MaterialPipelineKey, MaterialPipelineResources> m_pipelines;
    public MaterialInstanceMutableCache m_instanceMutableCache;
    public HashMap<Name, RenderPath> m_loggedMaterialPaths;
    public usize m_instanceBufferCapacity = 0u;
    public usize m_materialTypedBufferCapacity = 0u;

    [owner_result]
    public MaterialSurfaceInfo emptySurface()const{ return MaterialSurfaceInfo(); }

    public void invalidateResources(){
        this.m_pipelines.clear();
        this.m_materialPassBindingLayout.reset();
        this.m_computeBindingLayout.reset();
        this.m_instanceBuffer.reset();
        this.m_materialTypedBuffer.reset();
        this.m_emulationVertexShader.reset();
        this.m_emulationInputLayout.reset();
        this.m_objectGeometryDecodeShader.reset();
        this.m_objectGeometryDecodePipeline.reset();
        this.m_objectGeometryInputLayout.reset();
        this.m_instanceMutableCache.clear();
        this.m_loggedMaterialPaths.clear();
        this.m_instanceBufferCapacity = 0u;
        this.m_materialTypedBufferCapacity = 0u;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

