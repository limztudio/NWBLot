const StringView s_ErrToolkitContractWidgets = "toolkit_contract must be 'widgets'";
const StringView s_ErrUnsupportedSliceField = "unsupported asset field 'slice'";

class AuthoredSkinLoadResult{
    public UiSkin skin;
    public b8 complete = false;
}

UiSkinRegion MakeRegion(in Name name, in u32 ordinal){
    UiSkinRegion region = UiSkinRegion();
    region.name = name;
    region.rectangle.x = ordinal;
    region.rectangle.y = 0u;
    region.rectangle.width = 1u;
    region.rectangle.height = 1u;
    return region;
}

void SetRegions(mut UiSkin skin, in RegionVector regions){
    RegionVector movedRegions = regions;
    skin.setAtlas(AssetRef<Texture>("test/skin/texture"), 8192u, 1u, 1.0f, movedRegions);
}

Name RegionName(in u32 index){
    NameHash hash = NameHash();
    hash.qwords[0u] = 1u + (index * 271u) % s_UiSkinMaxRegionCount;
    hash.qwords[s_NameHashLaneCount - 1u] = index + 1u;
    return Name(hash);
}

usize FindRegionAddress(in UiSkin skin, in Name name){
    const auto index = skin.findRegionIndex(name);
    if(!index.has_value())
        return 0u;
    return TestValueAddress<UiSkinRegion>(skin.regions()[index.value()]);
}

usize RegionElementAddress(in UiSkin skin, in usize index){
    return TestValueAddress<UiSkinRegion>(skin.regions()[index]);
}

b8 RepeatFirstDocumentAssetRegion(mut MetascriptDocument document, in u32 count){
    return document.visitVariable("asset", lambda[in count](mut MetascriptValue asset) -> b8{
        mut MetascriptList regions = asset.field("regions").asList();
        const MetascriptValue first = regions.front();
        regions.clear();
        regions.reserve(cast<usize>(count));
        for(u32 index = 0u; index < count; ++index)
            regions.push_back(first);
        return true;
    });
}

Expected<AuthoredSkinLoadResult> LoadAuthoredSkin(in Path assetRoot, in Path atlasPath, in StringView virtualRoot){
    String metadata = "";
    if(!ReadTextFile(atlasPath, metadata).has_value())
        return MakeUnexpected(Failure());
    MetascriptDocumentWorkspace documentOwner(s_OneOffNameTestsIntegrationAssetsUiSkinCook);
    mut MetascriptDocument document = documentOwner.document;
    if(!document.parse(metadata))
        return MakeUnexpected(Failure());
    Expected<UiSkinCookEntry> entryResult = ParseUiSkinCookMetadata(assetRoot, virtualRoot, atlasPath, document);
    if(!entryResult.has_value())
        return MakeUnexpected(Failure());
    const UiSkinCookEntry entry = entryResult.value();
    Expected<UiSkin> skinResult = BuildUiSkinAsset(entry);
    if(!skinResult.has_value())
        return MakeUnexpected(Failure());
    AuthoredSkinLoadResult result;
    result.skin = skinResult.value();
    result.complete = entry.completeToolkitSkin;
    return result;
}

void CopyWithoutRegion(in UiSkin source, in Name removed, mut UiSkin outSkin){
    RegionVector regions;
    for(usize index = 0u; index < source.regions().size(); ++index){
        const UiSkinRegion region = source.regions()[index];
        if(region.name != removed)
            regions.push_back(region);
    }
    outSkin.setAtlas(source.texture(), source.atlasWidth(), source.atlasHeight(), source.referenceDensity(), regions);
}

b8 CanParseMetadata(in StringView metadata){
    MetascriptDocumentWorkspace documentOwner(s_OneOffNameTestsIntegrationAssetsUiSkinCook);
    mut MetascriptDocument document = documentOwner.document;
    if(!document.parse(metadata))
        return false;
    const Path assetRoot = Path(s_SkinAssetRoot);
    const Path metadataPath = assetRoot / s_UiDirectory / s_AtlasMetadataFilename;
    return ParseUiSkinCookMetadata(assetRoot, "project", metadataPath, document).has_value();
}

Vector<u8> MakeBinary(in UiSkinHeaderBinary header, in UiSkinRegionBinary region){
    Vector<u8> binary;
    binary.reserve(size_of<UiSkinHeaderBinary>() + size_of<UiSkinRegionBinary>() + s_ColorRoleCount * size_of<UiSkinColor>() + size_of<UiSkinTypography>());
    AppendPOD(binary, header);
    AppendPOD(binary, region);
    const UiSkinPalette palette = UiSkinPalette();
    for(in UiSkinColor color : palette.colors){
        AppendPOD(binary, color);
    }
    const UiSkinTypography typography = UiSkinTypography();
    AppendPOD(binary, typography);
    return binary;
}

UiSkinHeaderBinary ValidHeader(){
    UiSkinHeaderBinary header = UiSkinHeaderBinary();
    header.textureNameHash = Name(s_TexturePath).hash();
    header.atlasWidth = 64u;
    header.atlasHeight = 32u;
    header.referenceDensity = 2.0f;
    header.regionCount = 1u;
    return header;
}

UiSkinRegionBinary ValidRegion(){
    UiSkinRegionBinary region = UiSkinRegionBinary();
    region.nameHash = s_UiTestPanelNormal.hash();
    region.x = 2u;
    region.y = 4u;
    region.width = 24u;
    region.height = 20u;
    region.sliceLeft = 3u;
    region.sliceTop = 4u;
    region.sliceRight = 5u;
    region.sliceBottom = 6u;
    region.drawMode = s_DrawModeNineSlice;
    return region;
}

String PaletteMetadata(in u32 variant, in b8 includeTypography){
    String metadata = String(s_BaseMetadata);
    if(includeTypography)
        metadata.append("asset.typography = {\"default_font_size\": 16.0};\r\n");
    if(variant == 1u)
        return metadata;
    metadata.append("asset.colors = [\r\n");
    usize count = s_ColorRoleCount;
    if(variant == 2u)
        count = s_ColorRoleCount - 1u;
    for(usize index = 0u; index < count; ++index){
        StringView name = s_PaletteRoleNames[index];
        if(variant == 3u && index == count - 1u)
            name = s_PaletteRoleNames[0u];
        else if(variant == 4u && index == count - 1u)
            name = "unknown.role";
        metadata.append("  { \"name\": \"");
        metadata.append(name);
        metadata.append("\", \"rgba\": ");
        StringView rgba = "[0.25, 0.5, 0.75, 1.0]";
        if(variant == 5u && index == 0u)
            rgba = "[16.1, 0.5, 0.75, 1.0]";
        else if(variant == 6u && index == 0u)
            rgba = "[0.25, 0.5, 0.75, 1.1]";
        else if(index == s_ColorRoleControlHoverTint)
            rgba = "[1.08, 1.08, 1.08, 1.0]";
        metadata.append(rgba);
        metadata.append(" },\r\n");
    }
    metadata.append("];\r\n");
    return metadata;
}

String TypographyMetadata(in StringView typography){
    String metadata = PaletteMetadata(0u, false);
    if(!typography.empty()){
        metadata.append("asset.typography = ");
        metadata.append(typography);
        metadata.append(";\r\n");
    }
    return metadata;
}

Vector<u8> MakeTypographyBinary(in UiSkinColor color, in f32 defaultFontSize){
    const UiSkinHeaderBinary header = ValidHeader();
    Vector<u8> binary = MakeBinary(header, ValidRegion());
    binary.resize(s_UiSkinHeaderBinarySize + s_UiSkinRegionBinarySize);
    for(usize index = 0u; index < s_ColorRoleCount; ++index){
        AppendPOD(binary, color);
    }
    UiSkinTypography typography = UiSkinTypography();
    typography.defaultFontSize = defaultFontSize;
    AppendPOD(binary, typography);
    return binary;
}

void VerifyAssetsUiSkinRegionIndex_MaximumCountPreservesAuthoredOrderAcrossHashOrderAndMisses(){
    UiSkin skin(Name(s_SkinPath));
    RegionVector regions;
    regions.reserve(s_UiSkinMaxRegionCount);
    for(u32 index = 0u; index < s_UiSkinMaxRegionCount; ++index)
        regions.push_back(MakeRegion(RegionName(index), index));
    SetRegions(skin, regions);
    ASSERT_TRUE(skin.validatePayload());
    for(u32 index = 0u; index < s_UiSkinMaxRegionCount; ++index){
        ASSERT_EQ(skin.regions()[index].rectangle.x, index);
        ASSERT_EQ(skin.regions()[index].name, RegionName(index));
        ASSERT_EQ(FindRegionAddress(skin, RegionName(index)), RegionElementAddress(skin, index));
    }
    EXPECT_EQ(FindRegionAddress(skin, s_NameNone), 0u);
    EXPECT_EQ(FindRegionAddress(skin, s_UiLookupNameMissing), 0u);
    NameHash after = NameHash();
    after.qwords[0u] = u64.max;
    const Name afterName = Name(after);
    EXPECT_EQ(FindRegionAddress(skin, afterName), 0u);
}

void VerifyAssetsUiSkinRegionIndex_CanonicalDuplicateKeepsFirstAuthoredMatchAndFailsAdmission(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    UiSkin skin(Name(s_SkinPath));
    RegionVector regions;
    regions.push_back(MakeRegion(Name("Button\\Normal"), 0u));
    regions.push_back(MakeRegion(s_UiTestPanelNormal, 1u));
    regions.push_back(MakeRegion(Name("button/normal"), 2u));
    SetRegions(skin, regions);
    EXPECT_EQ(FindRegionAddress(skin, Name("BUTTON/NORMAL")), RegionElementAddress(skin, 0u));
    EXPECT_FALSE(skin.validatePayload());
    EXPECT_TRUE(SawCapturedError(logger, s_ErrDuplicateRegion));
}

void VerifyAssetsUiSkinRegionIndex_EqualLeadingHashLanesStillResolveDistinctNames(){
    UiSkin skin(Name(s_SkinPath));
    RegionVector regions;
    for(u32 index = 0u; index < 129u; ++index){
        NameHash hash = NameHash();
        hash.qwords[0u] = 123u;
        hash.qwords[s_NameHashLaneCount - 1u] = 129u - index;
        const Name hashName = Name(hash);
        regions.push_back(MakeRegion(hashName, index));
    }
    SetRegions(skin, regions);
    ASSERT_TRUE(skin.validatePayload());
    for(usize index = 0u; index < skin.regions().size(); ++index)
        EXPECT_EQ(FindRegionAddress(skin, skin.regions()[index].name), RegionElementAddress(skin, index));
    NameHash missing = skin.regions()[0u].name.hash();
    missing.qwords[s_NameHashLaneCount - 1u] = 130u;
    const Name missingName = Name(missing);
    EXPECT_EQ(FindRegionAddress(skin, missingName), 0u);
}

void VerifyAssetsUiSkinRegionIndex_ReplacementAcrossSmallSkinBoundaryDoesNotKeepStaleMatches(){
    UiSkin skin(Name(s_SkinPath));
    Name previous = s_NameNone;
    for(u32 stage = 0u; stage < s_BoundaryStageCounts.size(); ++stage){
        RegionVector regions;
        for(u32 index = 0u; index < s_BoundaryStageCounts[stage]; ++index)
            regions.push_back(MakeRegion(RegionName(index + stage * 256u), index));
        SetRegions(skin, regions);
        ASSERT_TRUE(skin.validatePayload());
        for(usize index = 0u; index < skin.regions().size(); ++index)
            EXPECT_EQ(FindRegionAddress(skin, skin.regions()[index].name), RegionElementAddress(skin, index));
        EXPECT_EQ(FindRegionAddress(skin, previous), 0u);
        EXPECT_EQ(FindRegionAddress(skin, s_UiLookupNameMissing), 0u);
        previous = skin.regions().back().name;
    }
}

void VerifyAssetsUiSkinRegionIndex_ReplacementMovesAndCopiesDoNotRetainStaleRegionReferences(){
    HeapStorage firstOwner;
    HeapStorage secondOwner;
    TestValueSlot<UiSkin> sourceSlot;
    mut UiSkin source = sourceSlot.constructIn(firstOwner, Name(s_SkinPath));
    TestValueSlot<RegionVector> originalSlot;
    mut RegionVector regions = originalSlot.constructIn(firstOwner);
    regions.push_back(MakeRegion(s_UiTestOld, 0u));
    SetRegions(source, regions);

    TestValueSlot<RegionVector> replacementSlot;
    mut RegionVector replacement = replacementSlot.constructIn(secondOwner);
    replacement.push_back(MakeRegion(s_UiTestNew, 1u));
    replacement.push_back(MakeRegion(s_UiTestOther, 2u));
    SetRegions(source, replacement);
    EXPECT_TRUE(TestUsesStorage(source.regions(), firstOwner));
    EXPECT_FALSE(source.findRegionIndex(s_UiLookupNameOld).has_value());
    TestValueSlot<UiSkin> movedSlot;
    mut UiSkin moved = movedSlot.take(source);
    ASSERT_TRUE(moved.findRegionIndex(s_UiLookupNameNew).has_value());
    EXPECT_EQ(moved.findRegionIndex(s_UiLookupNameNew).value(), 0u);
    TestValueSlot<UiSkin> copiedSlot;
    in UiSkin copied = copiedSlot.copy(moved);
    ASSERT_TRUE(copied.findRegionIndex(s_UiLookupNameOther).has_value());
    EXPECT_EQ(copied.findRegionIndex(s_UiLookupNameOther).value(), 1u);
    EXPECT_NE(RegionElementAddress(copied, 1u), RegionElementAddress(moved, 1u));
    TestValueSlot<UiSkin> assignedSlot;
    mut UiSkin assigned = assignedSlot.constructIn(firstOwner, s_UiTestDestination);
    TestMoveAssign<UiSkin>(assigned, moved);
    ASSERT_TRUE(assigned.findRegionIndex(s_UiLookupNameNew).has_value());
    EXPECT_EQ(assigned.findRegionIndex(s_UiLookupNameNew).value(), 0u);
    EXPECT_FALSE(assigned.findRegionIndex(s_UiLookupNameOld).has_value());
    TestValueSlot<RegionVector> emptySlot;
    mut RegionVector empty = emptySlot.constructIn(secondOwner);
    SetRegions(assigned, empty);
    EXPECT_FALSE(assigned.findRegionIndex(s_UiLookupNameNew).has_value());
    ASSERT_TRUE(copied.findRegionIndex(s_UiLookupNameNew).has_value());
    EXPECT_EQ(copied.findRegionIndex(s_UiLookupNameNew).value(), 0u);
}

void VerifyAssetsUiSkinRegionIndex_FailedBinaryLoadPreservesLookupAndAuthoredOrder(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    UiSkin source(Name(s_SkinPath));
    RegionVector regions;
    regions.push_back(MakeRegion(Name(s_LastRegionName), 0u));
    regions.push_back(MakeRegion(s_UiTestFirst, 1u));
    SetRegions(source, regions);
    Vector<u8> binary;
    ASSERT_TRUE(SerializeUiSkinAsset(source, binary));
    UiSkin loaded(source.virtualPath());
    ASSERT_TRUE(loaded.loadBinary(binary));
    ASSERT_EQ(FindRegionAddress(loaded, s_UiLookupNameFirst), RegionElementAddress(loaded, 1u));
    const usize retained = FindRegionAddress(loaded, Name(s_LastRegionName));
    const usize firstHash = s_UiSkinHeaderBinarySize;
    const usize secondHash = firstHash + s_UiSkinRegionBinarySize;
    for(usize byteIndex = 0u; byteIndex < s_NameHashByteSize; ++byteIndex)
        binary[secondHash + byteIndex] = binary[firstHash + byteIndex];
    EXPECT_FALSE(loaded.loadBinary(binary));
    EXPECT_EQ(FindRegionAddress(loaded, Name(s_LastRegionName)), retained);
    EXPECT_EQ(FindRegionAddress(loaded, s_UiLookupNameFirst), RegionElementAddress(loaded, 1u));
    EXPECT_EQ(loaded.regions()[0u].name, Name(s_LastRegionName));
}

void VerifyAssetsUiSkinRegionIndex_OversizedInvalidSkinRemainsInspectableWithoutIndexedAdmission(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    UiSkin skin(Name(s_SkinPath));
    RegionVector regions;
    regions.reserve(s_UiSkinMaxRegionCount + 1u);
    for(u32 index = 0u; index <= s_UiSkinMaxRegionCount; ++index)
        regions.push_back(MakeRegion(RegionName(index), index));
    SetRegions(skin, regions);
    EXPECT_FALSE(skin.validatePayload());
    EXPECT_EQ(FindRegionAddress(skin, RegionName(s_UiSkinMaxRegionCount)), RegionElementAddress(skin, skin.regions().size() - 1u));
    EXPECT_EQ(FindRegionAddress(skin, s_UiLookupNameMissing), 0u);
}

void VerifyAssetsUiSkinToolkitContract_RejectsMissingBasePartsButAcceptsDeclaredStateFallbacks(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    const Path assetRoot = Path(s_CookTestRepoRoot) / s_EngineDirectory / s_AssetsDirectory;
    const Path atlasPath = assetRoot / s_UiDirectory / s_SkinsDirectory / s_DefaultSkinDirectory / s_AtlasMetadataFilename;
    const Expected<AuthoredSkinLoadResult> loaded = LoadAuthoredSkin(assetRoot, atlasPath, "engine");
    ASSERT_TRUE(loaded.has_value());
    in UiSkin source = loaded.value().skin;
    EXPECT_TRUE(loaded.value().complete);

    Vector<Name> required = Vector<Name>();
    required.push_back(s_UiTitle);
    required.push_back(s_UiCheck);
    required.push_back(s_UiSelected);
    required.push_back(s_UiArrow);
    required.push_back(s_UiFill);
    required.push_back(s_UiFocus);
    for(usize index = 0u; index < required.size(); ++index){
        const Name removed = required[index];
        const ScopedTestTrace trace(removed.resolvedText());
        UiSkin candidate(source.virtualPath());
        CopyWithoutRegion(source, removed, candidate);
        EXPECT_TRUE(candidate.validatePayload());
        EXPECT_FALSE(ValidateUiSkinToolkitContract(candidate));
    }

    Vector<Name> optional = Vector<Name>();
    optional.push_back(s_UiTestButtonHover);
    optional.push_back(s_UiTestCheckboxChecked);
    optional.push_back(s_UiTestEditFocused);
    optional.push_back(s_UiTestComboOpen);
    optional.push_back(s_UiTestSliderThumbHover);
    for(usize index = 0u; index < optional.size(); ++index){
        const Name removed = optional[index];
        const ScopedTestTrace trace(removed.resolvedText());
        UiSkin candidate(source.virtualPath());
        CopyWithoutRegion(source, removed, candidate);
        EXPECT_TRUE(ValidateUiSkinToolkitContract(candidate));
    }

    UiSkin noResize(source.virtualPath());
    CopyWithoutRegion(source, Name(s_TestWhiteRegionName), noResize);
    EXPECT_FALSE(ValidateUiSkinToolkitContract(noResize));

    RegionVector regions;
    for(usize index = 0u; index < noResize.regions().size(); ++index)
        regions.push_back(noResize.regions()[index]);
    UiSkin explicitResize(source.virtualPath());
    const Expected<UiSkinRegion> resizeResult = source.tryFindRegion(Name(s_TestWhiteRegionName));
    ASSERT_TRUE(resizeResult.has_value());
    UiSkinRegion resize = resizeResult.value();
    resize.name = s_UiTestWindowResize;
    regions.push_back(resize);
    explicitResize.setAtlas(source.texture(), source.atlasWidth(), source.atlasHeight(), source.referenceDensity(), regions);
    EXPECT_TRUE(ValidateUiSkinToolkitContract(explicitResize));
}

void VerifyAssetsUiSkinToolkitContract_CookOptInRejectsIncompleteMetadataWhileGenericSkinRemainsValid(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    String genericMetadata = "";
    const Path assetRoot = Path("C:/ui_skin_contract_tests/assets");
    const Path atlasPath = assetRoot / s_UiDirectory / s_AtlasMetadataFilename;
    const Path defaultAtlasPath = Path(s_CookTestRepoRoot) / s_EngineDirectory / s_AssetsDirectory / s_UiDirectory / s_SkinsDirectory / s_DefaultSkinDirectory / s_AtlasMetadataFilename;
    ASSERT_TRUE(ReadTextFile(defaultAtlasPath, genericMetadata).has_value());
    const StringView contractField = "asset.toolkit_contract = \"widgets\";";
    const usize contractOffset = genericMetadata.find(contractField);
    ASSERT_LT(contractOffset, genericMetadata.size());
    genericMetadata.erase(contractOffset, contractField.size());
    genericMetadata.append("asset.regions = [{ \"name\": \"panel.normal\", \"rect\": [0, 0, 16, 16] }];\r\n");
    String completeMetadata = genericMetadata;
    completeMetadata.append(contractField);

    MetascriptDocumentWorkspace genericDocumentOwner(s_OneOffNameTestsIntegrationAssetsUiSkinCook);
    mut MetascriptDocument genericDocument = genericDocumentOwner.document;
    ASSERT_TRUE(genericDocument.parse(genericMetadata));
    Expected<UiSkinCookEntry> genericEntryResult = ParseUiSkinCookMetadata(assetRoot, "project", atlasPath, genericDocument);
    ASSERT_TRUE(genericEntryResult.has_value());
    const UiSkinCookEntry genericEntry = genericEntryResult.value();
    Expected<UiSkin> genericBuildResult = BuildUiSkinAsset(genericEntry);
    ASSERT_TRUE(genericBuildResult.has_value());
    const UiSkin genericSkin = genericBuildResult.value();
    EXPECT_FALSE(genericEntry.completeToolkitSkin);
    EXPECT_FALSE(ValidateUiSkinToolkitContract(genericSkin));

    MetascriptDocumentWorkspace completeDocumentOwner(s_OneOffNameTestsIntegrationAssetsUiSkinCook);
    mut MetascriptDocument completeDocument = completeDocumentOwner.document;
    ASSERT_TRUE(completeDocument.parse(completeMetadata));
    EXPECT_FALSE(ParseUiSkinCookMetadata(assetRoot, "project", atlasPath, completeDocument).has_value());
    EXPECT_TRUE(SawCapturedError(logger, s_ErrMissingWindowNormal));
}

void VerifyAssetsUiSkin_TypographyRejectsMalformedFooterWithoutReplacingSkin(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    const UiSkinColor color(0.25f, 0.5f, 0.75f, 1.0f);
    UiSkin skin(Name(s_AtlasPath));
    ASSERT_TRUE(skin.loadBinary(MakeTypographyBinary(color, 21.5f)));

    for(u32 variant = 0u; variant < 5u; ++variant){
        const ScopedTestTrace trace(variant);
        f32 fontSize = 21.5f;
        if(variant == 2u)
            fontSize = 0.0f;
        else if(variant == 3u)
            fontSize = 2049.0f;
        else if(variant == 4u)
            fontSize = s_QuietNaNF32;
        Vector<u8> binary = MakeTypographyBinary(color, fontSize);
        if(variant == 0u)
            binary.pop_back();
        if(variant == 1u)
            binary.push_back(0u);
        EXPECT_FALSE(skin.loadBinary(binary));
        EXPECT_FLOAT_EQ(skin.typography().defaultFontSize, 21.5f);
    }
}

void VerifyAssetsUiSkin_TypographyMetadataRequiresValidFontSize(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    ASSERT_TRUE(CanParseMetadata(TypographyMetadata("{\"default_font_size\": 21.5}")));
    for(usize index = 0u; index < s_MalformedTypographyValues.size(); ++index){
        const ScopedTestTrace trace(index);
        EXPECT_FALSE(CanParseMetadata(TypographyMetadata(s_MalformedTypographyValues[index])));
    }
}

void VerifyAssetsUiSkin_PaletteRejectsMalformedFooterWithoutReplacingSkin(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    UiSkinColor color = UiSkinColor();
    color.r = 0.25f;
    color.g = 0.5f;
    color.b = 0.75f;
    color.a = 1.0f;
    UiSkin skin(Name(s_AtlasPath));
    ASSERT_TRUE(skin.loadBinary(MakeTypographyBinary(color, 16.0f)));

    for(u32 variant = 0u; variant < 6u; ++variant){
        const ScopedTestTrace trace(variant);
        UiSkinColor candidateColor = color;
        if(variant == 2u)
            candidateColor.r = s_QuietNaNF32;
        if(variant == 3u)
            candidateColor.g = -0.1f;
        if(variant == 4u)
            candidateColor.b = 16.1f;
        if(variant == 5u)
            candidateColor.a = 1.1f;
        Vector<u8> binary = MakeTypographyBinary(candidateColor, 16.0f);
        if(variant == 0u)
            binary.resize(binary.size() - s_UiSkinTypographySize - 1u);
        if(variant == 1u)
            binary.push_back(0u);
        EXPECT_FALSE(skin.loadBinary(binary));
        ASSERT_EQ(skin.regions().size(), 1u);
        EXPECT_EQ(skin.regions().front().name, s_UiTestPanelNormal);
        EXPECT_FLOAT_EQ(skin.palette().colors[s_ColorRoleTextNormal].r, 0.25f);
    }
}

void VerifyAssetsUiSkin_PaletteMetadataRequiresEveryKnownRoleAndValidRgba(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    ASSERT_TRUE(CanParseMetadata(PaletteMetadata(0u, true)));
    for(u32 variant = 1u; variant <= 6u; ++variant){
        const ScopedTestTrace trace(variant);
        EXPECT_FALSE(CanParseMetadata(PaletteMetadata(variant, true)));
    }
}

void VerifyAssetsUiSkin_RejectsObsoleteBinaryVersionsWithoutReplacingCurrentSkin(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    UiSkin skin(Name(s_AtlasPath));
    ASSERT_TRUE(skin.loadBinary(MakeBinary(ValidHeader(), ValidRegion())));
    for(u32 version = 1u; version <= 2u; ++version){
        const ScopedTestTrace trace(version);
        UiSkinHeaderBinary header = ValidHeader();
        header.version = version;
        Vector<u8> binary = MakeBinary(header, ValidRegion());
        EXPECT_FALSE(skin.loadBinary(binary));
        usize obsoleteSize = s_UiSkinHeaderBinarySize + s_UiSkinRegionBinarySize;
        if(version == 2u)
            obsoleteSize += s_ColorRoleCount * s_UiSkinColorSize;
        binary.resize(obsoleteSize);
        EXPECT_FALSE(skin.loadBinary(binary));
        EXPECT_EQ(skin.regions().size(), 1u);
        EXPECT_FLOAT_EQ(skin.typography().defaultFontSize, 16.0f);
    }
    EXPECT_TRUE(SawCapturedError(logger, s_ErrRecookRequired));
}

void VerifyAssetsUiSkin_LoadRejectsMalformedHeaderAndCountWithoutReplacingSkin(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    const UiSkinHeaderBinary validHeader = ValidHeader();
    const UiSkinRegionBinary validRegion = ValidRegion();
    UiSkin skin(Name(s_AtlasPath));
    ASSERT_TRUE(skin.loadBinary(MakeBinary(validHeader, validRegion)));

    for(u32 variant = 0u; variant < 10u; ++variant){
        const ScopedTestTrace trace(variant);
        UiSkinHeaderBinary header = validHeader;
        switch(variant){
        case 0u: header.magic = 0u; break;
        case 1u: header.version = 4u; break;
        case 2u: header.reserved0 = 1u; break;
        case 3u: header.reserved1 = 1u; break;
        case 4u: header.regionCount = 0u; break;
        case 5u: header.regionCount = u32.max; break;
        case 6u: header.textureNameHash = NameHash(); break;
        case 7u: header.atlasWidth = 0u; break;
        case 8u: header.referenceDensity = 0.0f; break;
        case 9u: header.referenceDensity = s_QuietNaNF32; break;
        default: break;
        }
        const Vector<u8> binary = MakeBinary(header, validRegion);
        EXPECT_FALSE(skin.loadBinary(binary));
        ASSERT_EQ(skin.regions().size(), 1u);
        EXPECT_EQ(skin.atlasWidth(), validHeader.atlasWidth);
    }

    Vector<u8> binary = MakeBinary(validHeader, validRegion);
    binary.pop_back();
    EXPECT_FALSE(skin.loadBinary(binary));
    binary.resize(s_UiSkinHeaderBinarySize - 1u);
    EXPECT_FALSE(skin.loadBinary(binary));
    binary = MakeBinary(validHeader, validRegion);
    binary.push_back(0u);
    EXPECT_FALSE(skin.loadBinary(binary));
    EXPECT_TRUE(SawCapturedError(logger, s_ErrTrailingBytes));
}

void VerifyAssetsUiSkin_LoadRejectsInvalidRegionBoundsMetricsAndFlags(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    const UiSkinHeaderBinary header = ValidHeader();
    for(u32 variant = 0u; variant < 14u; ++variant){
        const ScopedTestTrace trace(variant);
        UiSkinRegionBinary region = ValidRegion();
        switch(variant){
        case 0u: region.nameHash = NameHash(); break;
        case 1u: region.nameHash = Name("").hash(); break;
        case 2u: region.width = 0u; break;
        case 3u: region.x = u32.max; break;
        case 4u: region.y = 32u; break;
        case 5u: region.width = u32.max; break;
        case 6u: region.sliceLeft = 25u; break;
        case 7u: region.sliceTop = u32.max; break;
        case 8u: region.drawMode = 256u; break;
        case 9u: region.reserved = 1u; break;
        case 10u: region.paddingLeft = -1.0f; break;
        case 11u: region.minimumWidth = s_QuietNaNF32; break;
        case 12u: region.minimumHeight = s_InfinityF32; break;
        case 13u: region.drawMode = s_DrawModeSprite; break;
        default: break;
        }
        UiSkin skin(Name(s_AtlasPath));
        EXPECT_FALSE(skin.loadBinary(MakeBinary(header, region)));
        EXPECT_TRUE(skin.regions().empty());
    }
}

void VerifyAssetsUiSkin_RejectsOverLimitCountsBeforeReadingOrCopyingRegions(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    UiSkin skin(Name(s_AtlasPath));
    ASSERT_TRUE(skin.loadBinary(MakeBinary(ValidHeader(), ValidRegion())));

    UiSkinHeaderBinary header = ValidHeader();
    header.regionCount = s_UiSkinMaxRegionCount + 1u;
    Vector<u8> binary;
    binary.reserve(size_of<UiSkinHeaderBinary>());
    AppendPOD(binary, header);
    EXPECT_FALSE(skin.loadBinary(binary));
    EXPECT_TRUE(SawCapturedError(logger, s_ErrLoadRegionLimit));
    ASSERT_EQ(skin.regions().size(), 1u);
    EXPECT_EQ(skin.regions().front().name, s_UiTestPanelNormal);

    const String paletteMeta = PaletteMetadata(0u, true);
    MetascriptDocumentWorkspace documentOwner(s_OneOffNameTestsIntegrationAssetsUiSkinCook);
    mut MetascriptDocument document = documentOwner.document;
    ASSERT_TRUE(document.parse(paletteMeta));
    ASSERT_TRUE(RepeatFirstDocumentAssetRegion(document, s_UiSkinMaxRegionCount + 1u));
    const Path assetRoot = Path(s_SkinAssetRoot);
    const Path metadataPath = assetRoot / s_UiDirectory / s_AtlasMetadataFilename;
    EXPECT_FALSE(ParseUiSkinCookMetadata(assetRoot, "project", metadataPath, document).has_value());
    EXPECT_TRUE(SawCapturedError(logger, s_ErrCookRegionLimit));

    RegionVector oversized;
    oversized.reserve(s_UiSkinMaxRegionCount + 1u);
    for(u32 index = 0u; index <= s_UiSkinMaxRegionCount; ++index)
        oversized.push_back(skin.regions().front());
    UiSkin constructed(skin.virtualPath());
    constructed.setAtlas(skin.texture(), skin.atlasWidth(), skin.atlasHeight(), skin.referenceDensity(), oversized);
    EXPECT_FALSE(constructed.validatePayload());
    EXPECT_TRUE(SawCapturedError(logger, s_ErrValidateRegionLimit));
}

void VerifyAssetsUiSkin_CookRejectsObsoleteMetadataUnknownFieldsAndMalformedArrays(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    for(usize index = 0u; index < s_InvalidCookOverrides.size(); ++index){
        const StringView overrideText = s_InvalidCookOverrides[index];
        const ScopedTestTrace trace(overrideText);
        String metadata = PaletteMetadata(0u, true);
        metadata.append(overrideText);
        EXPECT_FALSE(CanParseMetadata(metadata));
    }
    EXPECT_TRUE(SawCapturedError(logger, s_ErrUnsupportedField));
    EXPECT_TRUE(SawCapturedError(logger, s_ErrToolkitContractWidgets));
}

void VerifyAssetsUiSkin_RetiredSpriteSliceFieldsAreRejected(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    ASSERT_TRUE(CanParseMetadata(PaletteMetadata(0u, true)));
    for(usize index = 0u; index < s_RetiredSpriteSliceOverrides.size(); ++index){
        String metadata = PaletteMetadata(0u, true);
        metadata.append("asset.texture = \"project/other_texture\";\r\n");
        metadata.append(s_RetiredSpriteSliceOverrides[index]);
        EXPECT_FALSE(CanParseMetadata(metadata));
    }
    EXPECT_TRUE(SawCapturedError(logger, s_ErrUnsupportedSliceField));
    String spriteMetadata = PaletteMetadata(0u, true);
    spriteMetadata.append("asset.regions = [{ \"name\": \"sprite\", \"rect\": [0, 0, 4, 4], \"draw_mode\": \"sprite\" }];\r\n");
    MetascriptDocumentWorkspace documentOwner(s_OneOffNameTestsIntegrationAssetsUiSkinCook);
    mut MetascriptDocument document = documentOwner.document;
    ASSERT_TRUE(document.parse(spriteMetadata));
    const Path assetRoot = Path(s_SkinAssetRoot);
    const Path metadataPath = assetRoot / s_UiDirectory / s_AtlasMetadataFilename;
    const Expected<UiSkinCookEntry> entryResult = ParseUiSkinCookMetadata(assetRoot, "project", metadataPath, document);
    ASSERT_TRUE(entryResult.has_value());
    ASSERT_EQ(entryResult.value().regions.size(), 1u);
}

void VerifyAssetsUiSkin_CookRejectsDuplicateNamesAndAtlasOrSliceOverflow(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    for(usize index = 0u; index < s_DuplicateAndOverflowOverrides.size(); ++index){
        const StringView overrideText = s_DuplicateAndOverflowOverrides[index];
        const ScopedTestTrace trace(overrideText);
        String metadata = PaletteMetadata(0u, true);
        metadata.append(overrideText);
        EXPECT_FALSE(CanParseMetadata(metadata));
