[cpp_header("<core/common/logger_registration.h>"), cpp_name("::NWB::Core::Common::LogType::Enum")]
extern enum LogType : u8{
    Info,
    EssentialInfo,
    Warning,
    CriticalWarning,
    Error,
    Fatal,
    Assert
};

[cpp_header("<core/common/logger_registration.h>"), cpp_name("::NWB::Core::Common::LoggerBreakPolicy::Enum")]
extern enum LoggerBreakPolicy : u8{
    ReportOnly,
    BreakOnFatal,
    BreakOnErrorAndFatal
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<core/common/logger_registration.h>"), cpp_name("::NWB::Core::Common::ILogger"), cpp_flags(no_copy, no_assign, abstract, polymorphic_base)]
extern class ILogger;

[cpp_header("<core/common/logger_registration.h>"), cpp_name("::NWB::Core::Common::LoggerRegistrationGuard"), cpp_flags(no_copy, no_assign)]
extern class LoggerRegistrationGuard;


