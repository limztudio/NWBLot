#include <impl/ecs_ui/toolkit/id.adhd>
#include <impl/ecs_ui/toolkit/paint_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_InputMaxPopups = 8u;
const usize s_MaxNestedPopupFrames = s_InputMaxPopups - 1u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class PopupToken{
    public b8 operator==(in PopupToken rhs)const{
        return this.widget == rhs.widget && this.declarationGeneration == rhs.declarationGeneration && this.instanceGeneration == rhs.instanceGeneration && this.openGeneration == rhs.openGeneration;
    }

    public b8 operator!=(in PopupToken rhs)const{
        return this.widget != rhs.widget || this.declarationGeneration != rhs.declarationGeneration || this.instanceGeneration != rhs.instanceGeneration || this.openGeneration != rhs.openGeneration;
    }

    public b8 valid()const{
        return this.widget.valid() && this.declarationGeneration != 0u && this.instanceGeneration != 0u && this.openGeneration != 0u;
    }

    public b8 empty()const{
        return !this.widget.valid() && this.declarationGeneration == 0u && this.instanceGeneration == 0u && this.openGeneration == 0u;
    }

    public WidgetId widget;
    public u64 declarationGeneration = 0u;
    public u64 instanceGeneration = 0u;
    public u64 openGeneration = 0u;
}

enum<u8> PopupDismissReason{
    None,
    Cancel,
    OutsideClick,
    FocusTraversal,
    FocusLost,
}

class PopupScope{
    public PopupToken token;
    public Rect bounds;
    public Rect viewport;
    public u32 layer = 0u;
    public b8 modal = false;
    public b8 dismissOutside = true;
    public b8 dismissCancel = true;
    public b8 dismissFocusTraversal = false;
    public b8 autofocus = true;
    public PopupToken parent;
    public WidgetId focusAnchor;
    public u64 focusAnchorDeclarationGeneration = 0u;
}

class PopupDismissal{
    public PopupToken token;
    public PopupDismissReason reason = PopupDismissReason::None;
}

class PopupRecord{
    public PopupScope scope;
    public WidgetId restoreFocus;
    public u64 restoreDeclaration = 0u;
    public PopupToken restorePopup;
    public b8 closing = false;
}

b8 HasValidPopupScopeGeometry(in PopupScope scope){
    if(
        !isFinite(scope.bounds.x) || !isFinite(scope.bounds.y) || !isFinite(scope.bounds.width) || !isFinite(scope.bounds.height)
        || !isFinite(scope.viewport.x) || !isFinite(scope.viewport.y) || !isFinite(scope.viewport.width) || !isFinite(scope.viewport.height)
        || scope.bounds.width <= 0.0f || scope.bounds.height <= 0.0f || scope.viewport.width <= 0.0f || scope.viewport.height <= 0.0f
    )
        return false;
    const f32 boundsRight = scope.bounds.x + scope.bounds.width;
    const f32 boundsBottom = scope.bounds.y + scope.bounds.height;
    const f32 viewportRight = scope.viewport.x + scope.viewport.width;
    const f32 viewportBottom = scope.viewport.y + scope.viewport.height;
    return isFinite(boundsRight) && isFinite(boundsBottom) && isFinite(viewportRight) && isFinite(viewportBottom) && scope.bounds.x >= scope.viewport.x && scope.bounds.y >= scope.viewport.y && boundsRight <= viewportRight && boundsBottom <= viewportBottom;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

