struct SmokeArenaRef final{
    Core::Alloc::GlobalArena* ptr = nullptr;
    SmokeArenaRef()noexcept = default;
    explicit SmokeArenaRef(Core::Alloc::GlobalArena& arena)noexcept : ptr(&arena){}
};

struct SmokeClipboardRef final{
    Core::IClipboardService* ptr = nullptr;
    SmokeClipboardRef()noexcept = default;
    explicit SmokeClipboardRef(Core::IClipboardService& clipboard)noexcept : ptr(&clipboard){}
};


[[nodiscard]] inline StringView FormatSmokeRowLabel(const u64 rowKey, Array<char, 32u>& outBuffer)noexcept{
    if(rowKey == 0u)
        return {};
    outBuffer[0] = 'R';
    outBuffer[1] = 'o';
    outBuffer[2] = 'w';
    outBuffer[3] = ' ';
    Array<char, s_UsizeDecimalDigitCount> digits{};
    const AStringView formatted = FormatDecimal(rowKey, digits);
    NWB_MEMCPY(outBuffer.data() + 4u, outBuffer.size() - 4u, formatted.data(), formatted.size());
    return { outBuffer.data(), 4u + formatted.size() };
}


template<typename BoxT>
using SharedSmokeBox = RefCountPtr<RefCounter<BoxT>, ArenaRefDeleter<RefCounter<BoxT>, Core::Alloc::GlobalArena>>;

template<typename SceneT>
class SmokeSceneBox : NoCopy{
public:
    template<typename... Args>
    explicit SmokeSceneBox(Args&&... args)
        : scene(Forward<Args>(args)...)
    {}


public:
    [[nodiscard]] b8 paint(Impl::UiPaintContext& context){ return scene.paint(context); }


public:
    SceneT scene;
};

template<typename SceneT>
class SmokeInputSceneBox : public Core::IInputEventHandler, NoCopy{
public:
    template<typename... Args>
    explicit SmokeInputSceneBox(Core::InputDispatcher& input, Args&&... args)
        : scene(Forward<Args>(args)...)
        , m_input(input)
    {
        m_input.addHandlerToBack(*this);
    }

    virtual ~SmokeInputSceneBox()noexcept override{
        m_input.removeHandler(*this);
    }


public:
    [[nodiscard]] b8 paint(Impl::UiPaintContext& context){ return scene.paint(context); }

    virtual Core::KeyboardInputResult keyboardUpdate(const i32 key, const i32 scancode, const i32 action, const i32 mods)noexcept override{
        return scene.keyboardUpdate(key, scancode, action, mods);
    }


public:
    SceneT scene;


private:
    Core::InputDispatcher& m_input;
};

template<typename SceneT, typename... Args>
[[nodiscard]] SharedSmokeBox<SmokeSceneBox<SceneT>> CreateSmokeSceneBox(Core::Alloc::GlobalArena& arena, Args&&... args){
    return SharedSmokeBox<SmokeSceneBox<SceneT>>(
        NewArenaObject<RefCounter<SmokeSceneBox<SceneT>>>(arena, Forward<Args>(args)...),
        ArenaRefDeleter<RefCounter<SmokeSceneBox<SceneT>>, Core::Alloc::GlobalArena>(&arena),
        s_AdoptRef
    );
}

template<typename SceneT, typename... Args>
[[nodiscard]] SharedSmokeBox<SmokeInputSceneBox<SceneT>> CreateSmokeInputSceneBox(Core::Alloc::GlobalArena& arena, Core::InputDispatcher& input, Args&&... args){
    return SharedSmokeBox<SmokeInputSceneBox<SceneT>>(
        NewArenaObject<RefCounter<SmokeInputSceneBox<SceneT>>>(arena, input, Forward<Args>(args)...),
        ArenaRefDeleter<RefCounter<SmokeInputSceneBox<SceneT>>, Core::Alloc::GlobalArena>(&arena),
        s_AdoptRef
    );
}


class UiListSmokeSource final : public Impl::Ui::IListDataSource, NoCopy{
public:
    virtual u64 instanceGeneration()const noexcept override{ return m_state.instanceGeneration(); }
    virtual u64 revision()const noexcept override{ return m_state.revision(); }
    virtual u64 rowCount()const noexcept override{ return m_state.rowCount(); }
    virtual u64 key(const u64 index)const noexcept override{ return m_state.key(index); }
    virtual Expected<u64> indexOf(const u64 keyValue)const noexcept override{ return m_state.indexOf(keyValue); }
    virtual Expected<u64> findEnabled(const u64 start, const b8 reverse)const noexcept override{ return m_state.findEnabled(start, reverse); }
    virtual StringView text(const u64 index)const noexcept override{ return FormatSmokeRowLabel(m_state.readRowKey(index), m_label); }
    virtual b8 enabled(const u64 index)const noexcept override{ return m_state.enabled(index); }


public:
    void reverse()noexcept{ m_state.reverse(); }
    void remove(const u64 keyValue)noexcept{ m_state.remove(keyValue); }
    void beginFrame()noexcept{ m_state.beginFrame(); }
    [[nodiscard]] b8 reversed()const noexcept{ return m_state.reversed(); }
    [[nodiscard]] u64 removedKey()const noexcept{ return m_state.removedKey(); }
    [[nodiscard]] u32 labelReads()const noexcept{ return m_state.labelReads(); }


private:
    mutable UiListSmokeSourceState m_state;
    mutable Array<char, 32u> m_label{};
};


