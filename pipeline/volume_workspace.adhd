[cpp_header("<pipeline/volume_workspace.h>"), cpp_name("::NWB::Pipeline::GatherMergeCallback"), cpp_flags(self_defaulted, small_value)]
extern class GatherMergeCallback{
    b8 apply(in Name path, in Span<u8> incoming, mut AssetCookWorkspace workspace, mut Vector<u8> existing)const;
};

[cpp_header("<pipeline/volume_workspace.h>"), cpp_name("::NWB::Pipeline::RegisteredGatherMerge")]
extern GatherMergeCallback RegisteredGatherMerge(mut AssetCookWorkspace workspace);


