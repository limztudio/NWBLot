namespace __hidden_ui_edit_caret_geometry_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB;
using namespace NWB::Impl::Ui;
using namespace NWB::UiEditCaretTests;

[[nodiscard]] NWB_INLINE b8 AdoptMismatchedSourcePreservingCandidate(EditCaretFixture& self){
    auto layoutResult = self.layout("new");
    if(!layoutResult)
        return false;
    TextLayout& candidate = *layoutResult;
    if(!self.identityMapping("new"))
        return false;
    const b8 adopted = self.m_geometry.adoptLayout(Move(candidate), "wrong", self.m_mapping, 3u, EditTextMode::SingleLine);
    EXPECT_FALSE(adopted);
    EXPECT_EQ(candidate.utf8(), "new");
    return !adopted && candidate.utf8() == "new";
}

[[nodiscard]] NWB_INLINE b8 AdoptBuiltCaretLayout(EditCaretFixture& self, const StringView layoutText, const StringView sourceText, const usize committedBytes, const EditTextMode::Enum mode, const TextDirection::Enum direction = TextDirection::LeftToRight){
    auto built = self.layout(layoutText, direction);
    EXPECT_TRUE(built);
    if(!built)
        return false;
    return self.m_geometry.adoptLayout(Move(*built), sourceText, self.m_mapping, committedBytes, mode);
}

[[nodiscard]] NWB_INLINE b8 AdoptNonfiniteDerivedGlyphPlacement(EditCaretFixture& self){
    auto malformedResult = self.layout("ab");
    EXPECT_TRUE(malformedResult);
    if(!malformedResult)
        return false;
    TextLayout& malformed = *malformedResult;
    EXPECT_EQ(malformed.glyphs().size(), 2u);
    if(malformed.glyphs().size() != 2u)
        return false;
    const_cast<PlacedGlyph&>(malformed.glyphs()[1u]).position.x = Limit<f32>::s_Infinity;
    if(!self.identityMapping("ab"))
        return false;
    return self.m_geometry.adoptLayout(Move(malformed), "ab", self.m_mapping, 2u, EditTextMode::SingleLine);
}

[[nodiscard]] NWB_INLINE b8 AdoptMutatedLineRecord(EditCaretFixture& self, const u32 mutation){
    auto malformedResult = self.layout("a\nb");
    EXPECT_TRUE(malformedResult);
    if(!malformedResult)
        return false;
    TextLayout& malformed = *malformedResult;
    TextLine& line = const_cast<TextLine&>(malformed.lines()[1u]);
    switch(mutation){
    case 0u: line.byteBegin = 0u; break;
    case 1u: line.byteEnd = 4u; break;
    case 2u: line.breakEnd = 4u; break;
    case 3u: line.firstCluster = 0u; break;
    case 4u: line.clusterCount = 2u; break;
    case 5u: line.firstGlyph = 0u; break;
    case 6u: line.glyphCount = 2u; break;
    case 7u: line.top = 11.0f; break;
    case 8u: line.height = 0.0f; break;
    case 9u: line.advance = -1.0f; break;
    case 10u: line.baseline = Limit<f32>::s_Infinity; break;
    case 11u: line.height = Limit<f32>::s_QuietNaN; break;
    case 12u: line.advance = 11.0f; break;
    case 13u: const_cast<TextLine&>(malformed.lines()[0u]).breakEnd = 1u; break;
    }
    return self.m_geometry.adoptLayout(Move(malformed), "a\nb", self.m_mapping, 3u, EditTextMode::Multiline);
}

NWB_INLINE void MoveCaretGeometry(EditCaretGeometry& source, EditCaretGeometry& destination)noexcept{
    destination = Move(source);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


