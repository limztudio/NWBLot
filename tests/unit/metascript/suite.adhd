void ExpectCompileFails(mut AdhdTestArena arena, in StringView source, in StringView virtualPath){
    CompileResult result = CompileResult(arena.arena);
    EXPECT_FALSE(Compile(source, virtualPath, arena.arena, result));
}

void ExpectCompileFailsWithMessage(mut AdhdTestArena arena, in StringView source, in StringView virtualPath, in StringView expectedMessage){
    CompileResult result = CompileResult(arena.arena);
    EXPECT_FALSE(Compile(source, virtualPath, arena.arena, result));
    ASSERT_FALSE(result.errors.empty());
    EXPECT_EQ(FirstErrorMessage(result), expectedMessage);
}

void VerifyAdhdPreprocessor_DeduplicatesRepeatedIncludes(){
    AdhdTestArena arena = AdhdTestArena();
    MockIncludeResolver resolver = MockIncludeResolver();

    CompileResult result = CompileResult(arena.arena);
    ASSERT_TRUE(CompileWithResolver(s_SuiteDedupAdhdSource, "impl/math/compute.adhd", resolver, arena.arena, result));
    EXPECT_EQ(resolver.resolveCallCount, 1u);

    CompileResult rawStringResult = CompileResult(arena.arena);
    ASSERT_TRUE(CompileWithResolver(s_SuiteNativeRawStringSource, "impl/math/raw_string.adhd", resolver, arena.arena, rawStringResult));
}

void VerifyAdhdCompiler_ReordersClassFieldsByDescendingAlignmentAndSize(){
    AdhdTestArena arena = AdhdTestArena();

    CompileResult result = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(s_SuiteReorderFieldsSource, "impl/scene/transform_node.adhd", arena.arena, result));
    ASSERT_EQ(UnitClassCount(result), 1u);

    ASSERT_EQ(UnitClassOrderedFieldCount(result, 0u), 6u);
    EXPECT_EQ(UnitClassOrderedFieldName(result, 0u, 0u), "translation");
    EXPECT_EQ(UnitClassOrderedFieldAlign(result, 0u, 0u), 16u);
    EXPECT_EQ(UnitClassOrderedFieldName(result, 0u, 1u), "handle");
    EXPECT_EQ(UnitClassOrderedFieldAlign(result, 0u, 1u), 8u);
    EXPECT_EQ(UnitClassOrderedFieldName(result, 0u, 2u), "entityId");
    EXPECT_EQ(UnitClassOrderedFieldAlign(result, 0u, 2u), 4u);
    EXPECT_EQ(UnitClassOrderedFieldName(result, 0u, 3u), "layer");
    EXPECT_EQ(UnitClassOrderedFieldAlign(result, 0u, 3u), 2u);
    EXPECT_EQ(UnitClassOrderedFieldName(result, 0u, 4u), "dirty");
    EXPECT_EQ(UnitClassOrderedFieldAlign(result, 0u, 4u), 1u);
    EXPECT_EQ(UnitClassOrderedFieldName(result, 0u, 5u), "flags");
    EXPECT_EQ(UnitClassOrderedFieldAlign(result, 0u, 5u), 1u);
}

void VerifyAdhdCompiler_SerializeClassPacksTightlyInSourceOrder(){
    AdhdTestArena arena = AdhdTestArena();

    CompileResult result = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(s_SuiteBinaryHeaderSource, "impl/assets/binary_header.adhd", arena.arena, result));
    ASSERT_EQ(UnitClassCount(result), 1u);

    EXPECT_TRUE(UnitClassIsSerialize(result, 0u));
    EXPECT_EQ(UnitClassTotalAlign(result, 0u), 1u);
    EXPECT_EQ(UnitClassTotalSize(result, 0u), 7u);
    ASSERT_EQ(UnitClassOrderedFieldCount(result, 0u), 3u);
    EXPECT_EQ(UnitClassOrderedFieldName(result, 0u, 0u), "magic");
    EXPECT_EQ(UnitClassOrderedFieldOffset(result, 0u, 0u), 0u);
    EXPECT_EQ(UnitClassOrderedFieldName(result, 0u, 1u), "version");
    EXPECT_EQ(UnitClassOrderedFieldOffset(result, 0u, 1u), 1u);
    EXPECT_EQ(UnitClassOrderedFieldName(result, 0u, 2u), "flags");
    EXPECT_EQ(UnitClassOrderedFieldOffset(result, 0u, 2u), 5u);

    CompileResult simdResult = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(s_SuiteSimdPayloadSource, "impl/assets/simd_payload.adhd", arena.arena, simdResult));
    ASSERT_EQ(UnitClassCount(simdResult), 1u);

    ASSERT_EQ(UnitClassOrderedFieldCount(simdResult, 0u), 4u);
    EXPECT_EQ(UnitClassOrderedFieldName(simdResult, 0u, 0u), "header");
    EXPECT_EQ(UnitClassOrderedFieldName(simdResult, 0u, 1u), "pad");
    EXPECT_EQ(UnitClassOrderedFieldName(simdResult, 0u, 2u), "vector");
    EXPECT_EQ(UnitClassOrderedFieldName(simdResult, 0u, 3u), "trailer");
}

void VerifyAdhdCompiler_EnforcesInterfaceOverrideAndFinalClasses(){
    AdhdTestArena arena = AdhdTestArena();
    ExpectCompileFails(arena, s_SuiteMissingOverrideSource, "impl/task/bad_task.adhd");
    ExpectCompileFails(arena, s_SuiteClassInheritanceSource, "impl/task/derived.adhd");
}

void VerifyAdhdCompiler_EnforcesMandatoryInitializationAndProhibitions(){
    AdhdTestArena arena = AdhdTestArena();
    ExpectCompileFails(arena, "void TestFn(in u32 a) {\r\n    u32 count;\r\n}\r\n", "impl/test.adhd");
    ExpectCompileFails(arena, s_SuiteDoubleInitCtorSource, "impl/test.adhd");
    ExpectCompileFails(arena, "class BitfieldBad {\r\n    public u32 flag : 1;\r\n}\r\n", "impl/test.adhd");
    ExpectCompileFails(arena, "void BadFn(in u32 x = 5) {\r\n}\r\n", "impl/test.adhd");
    ExpectCompileFails(arena, s_SuiteMoveCallSource, "impl/test.adhd");
    ExpectCompileFails(arena, "void BadMutate(in u32 a) {\r\n    a = 10;\r\n}\r\n", "impl/test.adhd");
    ExpectCompileFailsWithMessage(arena, "void lowerGlobal() {}\r\n", "impl/test.adhd", "global function name must start with an uppercase letter");
    ExpectCompileFailsWithMessage(arena, "class BadMethodCase { public void UpperMethod() {} }\r\n", "impl/test.adhd", "member function name must start with a lowercase letter");
    ExpectCompileFailsWithMessage(arena, "interface IBadCase { void UpperMethod(); }\r\n", "impl/test.adhd", "member function name must start with a lowercase letter");
}

void VerifyAdhdCompiler_ReordersTemplateInstantiationFieldsAndRejectsFreeOperatorsOrMissingMethodBodies(){
    AdhdTestArena arena = AdhdTestArena();

    CompileResult result = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(s_SuiteTemplateInstReorderSource, "impl/render/material_def.adhd", arena.arena, result));
    ASSERT_EQ(UnitTemplateInstCount(result), 1u);
    ASSERT_EQ(UnitTemplateInstOrderedFieldCount(result, 0u), 2u);
    EXPECT_EQ(UnitTemplateInstOrderedFieldName(result, 0u, 0u), "second");
    EXPECT_EQ(UnitTemplateInstOrderedFieldName(result, 0u, 1u), "first");

    ExpectCompileFails(arena, "u32 operator+(in u32 a, in u32 b) {\r\n    return a + b;\r\n}\r\n", "impl/render/bad_op.adhd");
    ExpectCompileFails(arena, s_SuiteUnimplementedMethodSource, "impl/render/incomplete.adhd");
}

void VerifyAdhdCompiler_EnforcesMutCallSiteAndParallelConcurrencySafety(){
    AdhdTestArena arena = AdhdTestArena();
    ExpectCompileFails(arena, s_SuiteMutLiteralCallSource, "impl/test_mut.adhd");
    ExpectCompileFails(arena, s_SuiteUnsafeParallelVectorSource, "impl/test_par_bad.adhd");

    CompileResult safeParRes = CompileResult(arena.arena);
    EXPECT_TRUE(Compile(s_SuiteSafeParallelVectorSource, "impl/test_par_good.adhd", arena.arena, safeParRes));
}

void VerifyAdhdCompiler_RejectsFlagBitWidthOverflowInvalidSwitchCtorAndAttributeConflicts(){
    AdhdTestArena arena = AdhdTestArena();
    ExpectCompileFails(arena, s_SuiteOverflowFlagEnumSource, "impl/bad_flag_overflow.adhd");
    ExpectCompileFails(arena, s_SuiteBadFloatSwitchSource, "impl/bad_float_switch.adhd");
    ExpectCompileFails(arena, s_SuiteDupCaseSwitchSource, "impl/bad_dup_case.adhd");
    ExpectCompileFails(arena, s_SuitePartialCtorInitSource, "impl/bad_partial_ctor.adhd");
    ExpectCompileFails(arena, s_SuiteCallNonFuncFieldSource, "impl/bad_call_field.adhd");
    ExpectCompileFails(arena, "[inline]\r\nvoid BadInlineAttr() {}\r\n", "impl/bad_inline_attr.adhd");
    ExpectCompileFails(arena, "[noinline]\r\nvoid BadNoInlineAttr() {}\r\n", "impl/bad_noinline_attr.adhd");
    ExpectCompileFails(arena, "inline void BadInlineKeyword() {}\r\n", "impl/bad_inline_kw.adhd");
    ExpectCompileFails(arena, "noinline void BadNoInlineKeyword() {}\r\n", "impl/bad_noinline_kw.adhd");
    ExpectCompileFails(arena, "[arena, serialize, asset(\"bad_asset\")]\r\nclass BadSerializeAsset { public u32 v = 0u; }\r\n", "impl/bad_serialize_asset.adhd");
    ExpectCompileFails(arena, "[asset(\"bad_asset\")]\r\nclass BadNoArenaAsset { public Vector<u8> bytes; }\r\n", "impl/bad_no_arena_asset.adhd");
    ExpectCompileFails(arena, "[arena, asset(\"bad_asset\")]\r\nclass BadTemplateAsset<T> { public T v; }\r\n", "impl/bad_template_asset.adhd");
    ExpectCompileFails(arena, "[arena, serialize, system(\"bad_sys\")]\r\nclass BadSerializeSystem { public u32 v = 0u; }\r\n", "impl/bad_serialize_system.adhd");
    ExpectCompileFails(arena, "[system(\"bad_sys\")]\r\nclass BadNoArenaSystem { public u32 v = 0u; }\r\n", "impl/bad_no_arena_system.adhd");
    ExpectCompileFails(arena, "[arena, system(\"bad_sys\")]\r\nclass BadTemplateSystem<T> { public T v; }\r\n", "impl/bad_template_system.adhd");
    ExpectCompileFails(arena, "[arena, component(\"comp\"), system(\"bad_sys\")]\r\nclass BadComponentSystem { public u32 v = 0u; }\r\n", "impl/bad_component_system.adhd");

    CompileResult assetRes = CompileResult(arena.arena);
    ASSERT_TRUE(Compile("[arena, asset(\"sample_blob\")]\r\nclass SampleBlob {\r\n    private Vector<u8> m_bytes;\r\n    public in Vector<u8> bytes()const { return this.m_bytes; }\r\n    public b8 loadBinary(in Span<u8> binary) { return this.checkVirtualPath(\"SampleBlob::loadBinary\") && !this.virtualPath().empty() && !binary.empty(); }\r\n}\r\n", "impl/assets_sample/asset.adhd", arena.arena, assetRes));
    const StringView assetHdr = GeneratedHeaderView(assetRes);
    const StringView assetCpp = GeneratedSourceView(assetRes);
    EXPECT_NE(assetHdr.find("#include <core/assets/module.h>"), usize.max);
    EXPECT_NE(assetHdr.find("class SampleBlob final : public ::NWB::Core::Assets::TypedAsset<SampleBlob>"), usize.max);
    EXPECT_NE(assetHdr.find("NWB_DEFINE_ASSET_TYPE(\"sample_blob\")"), usize.max);
    EXPECT_NE(assetHdr.find("const Vector<u8, ::ArenaBase>& bytes()const noexcept"), usize.max);
    EXPECT_NE(assetHdr.find("NWB_DEFINE_ASSET_CODEC(SampleBlobAssetCodec, SampleBlob);"), usize.max);
    EXPECT_NE(assetCpp.find("__adhd_asset_codec_registrar_SampleBlob(&::NWB::Core::Assets::CreateAssetCodec<SampleBlobAssetCodec>);"), usize.max);

    CompileResult systemRes = CompileResult(arena.arena);
    ASSERT_TRUE(Compile("[arena, component(\"pos\")]\r\nclass PosComp {\r\n    public i32 x = 0;\r\n}\r\n[arena, system(\"sample_sys\")]\r\nclass SampleSystem {\r\n    public u32 ticks = 0u;\r\n    public SampleSystem() {\r\n        this.writeAccess<PosComp>();\r\n    }\r\n    public void prepare(mut World world) {\r\n        ++this.ticks;\r\n    }\r\n    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta) {\r\n        return Expected<void, CpuTaskAdmissionError>();\r\n    }\r\n    public Name currentType()const {\r\n        return SampleSystem::SystemTypeName();\r\n    }\r\n}\r\n", "impl/ecs_sample/system.adhd", arena.arena, systemRes));
    const StringView sysHdr = GeneratedHeaderView(systemRes);
    const StringView sysCpp = GeneratedSourceView(systemRes);
    EXPECT_NE(sysHdr.find("#include <core/ecs/component.h>"), usize.max);
    EXPECT_NE(sysHdr.find("NWB_DEFINE_COMPONENT_TYPE(\"pos\")"), usize.max);
    EXPECT_NE(sysHdr.find("#include <core/ecs/system.h>"), usize.max);
    EXPECT_NE(sysHdr.find("class SampleSystem final : public ::NWB::Core::ECS::ISystem"), usize.max);
    EXPECT_NE(sysHdr.find("NWB_DEFINE_SYSTEM_TYPE(\"sample_sys\")"), usize.max);
    EXPECT_NE(sysHdr.find("[[nodiscard]] virtual const ::Name& systemType()const noexcept override{ return s_SystemTypeName; }"), usize.max);
    EXPECT_NE(sysHdr.find("virtual void prepare(::NWB::Core::ECS::World& world)noexcept override"), usize.max);
    EXPECT_NE(sysHdr.find("virtual Expected<void, ::NWB::Core::CpuTaskAdmissionError::Enum> update(::NWB::Core::ECS::World& world, const f32 delta)noexcept override"), usize.max);
    EXPECT_NE(sysCpp.find(": ::NWB::Core::ECS::ISystem(__adhd_mother_arena)"), usize.max);
}

void VerifyAdhdCompiler_RejectsMalformedHexMacroParamsCastsDanglingRefsAndEarlyReturnCtors(){
    AdhdTestArena arena = AdhdTestArena();
