#include <impl/ecs_ui/toolkit/builder.adhd>
#include <impl/ecs_ui/toolkit/widgets/control_style_metrics.adhd>
#include <impl/ecs_ui/toolkit/widgets/control_visual_painter.adhd>
#include <impl/ecs_ui/toolkit/widgets/hit_target_factory.adhd>
#include <impl/ecs_ui/toolkit/widgets/ui_scope_descriptor_factory.adhd>
#include <impl/ecs_ui/toolkit/context.adhd>
#include <impl/ecs_ui/toolkit/widgets/radio_group.adhd>
#include <impl/ecs_ui/toolkit/widgets/popup.adhd>
#include <impl/ecs_ui/toolkit/widgets/popup_style.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Point s_CompoundPopupPlaceholderSize = Point(1.0f, 1.0f);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RadioChoiceVisualFlags{
    public b8 enabled = false;
    public b8 checked = false;
    public b8 hover = false;
    public b8 pressed = false;
    public b8 focused = false;
}

class RadioGroupPopupLoan{
    public in PopupState state;
    public PopupToken token;

    public RadioGroupPopupLoan(in PopupState state, in PopupToken token){
        this.state = state;
        this.token = token;
    }
}

class RadioGroupPopupGuard : IRadioGroupReconcileGuard{
    private in Context m_context;
    private Array<Optional<RadioGroupPopupLoan>, s_InputMaxPopups> m_popups;
    private usize m_count = 0u;

    public RadioGroupPopupGuard(in Context context){ this.m_context = context; }

    public b8 add(in PopupState state, in PopupToken token){
        if(this.m_count == s_InputMaxPopups)
            return false;
        this.m_popups[this.m_count] = RadioGroupPopupLoan(state, token);
        ++this.m_count;
        return true;
    }

    public b8 current()const override{
        if(this.m_context.failed())
            return false;
        for(usize index = 0u; index < this.m_count; ++index){
            in RadioGroupPopupLoan loan = this.m_popups[index].value();
            if(!IsPopupLoanCurrent(loan.state.isOpen(), loan.state.instanceGeneration(), loan.state.openGeneration(), loan.token))
                return false;
        }
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsPopupLoanCurrent(in b8 isOpen, in u64 stateInstanceGeneration, in u64 stateOpenGeneration, in PopupToken token){
    return isOpen && stateInstanceGeneration == token.instanceGeneration && stateOpenGeneration == token.openGeneration;
}

RadioChoiceVisualFlags BuildRadioChoiceVisualFlags(
    in b8 groupEnabled,
    in b8 rowEnabled,
    in u64 selectedKey,
    in u64 cursorKey,
    in u64 rowKey,
    in WidgetId hoverId,
    in WidgetId partId,
    in b8 partPressed,
    in b8 groupPressed,
    in WidgetId focusId,
    in WidgetId groupId
){
    RadioChoiceVisualFlags flags;
    flags.enabled = groupEnabled && rowEnabled;
    flags.checked = selectedKey == rowKey;
    flags.hover = hoverId == partId;
    flags.pressed = partPressed || (cursorKey == rowKey && groupPressed);
    flags.focused = flags.enabled && focusId == groupId && cursorKey == rowKey;
    return flags;
}

b8 ResolveSliderThumbPressedState(in b8 interactive, in b8 primaryDown, in WidgetId captureId, in WidgetId trackId, in WidgetId thumbId){
    return interactive && primaryDown && (captureId == trackId || captureId == thumbId);
}

PopupOptions BuildCompoundPopupReservationOptions(){
    PopupOptions options;
    options.size = s_CompoundPopupPlaceholderSize;
    return options;
}

b8 Builder::beginPopup(in StringView stableKey, mut PopupState state, in PopupOptions options){
    const b8 nested = this.m_scope.value().m_popupState.has_value() && this.m_scope.value().m_panelActive;
    if(this.declarationBlocked() || (!this.balanced() && !nested) || !this.m_skin.has_value() || this.m_context.failed()){
        this.m_context.fail();
        return false;
    }
    if(nested && !this.synchronizePopup())
        return false;
    const auto widget = this.m_context.declare(stableKey, WidgetKind::Popup);
    if(!widget.has_value() || !this.m_context.claimState(widget.value(), state.instanceGeneration()))
        return false;
    const WidgetState declaration = widget.value();
    state.bindParent(this.m_context.popupToken());
    PopupToken token;
    token.widget = widget.value().id;
    token.declarationGeneration = widget.value().declarationGeneration;
    token.instanceGeneration = state.instanceGeneration();
    token.openGeneration = state.openGeneration();
    this.m_context.input().fencePopup(token);
    if(this.m_context.input().consumePopupDismissal(token))
        state.close();
    if(!state.isOpen()){
        this.m_context.input().closePopup(token);
        return false;
    }
    const auto background = this.region(this.m_popupStyle.background, this.m_popupStyle.fallback);
    const auto placement = PlacePopup(options, this.m_paint.displayMetrics());
    if(!background.has_value() || !placement.has_value()){
        this.m_context.fail();
        return false;
    }
    const PopupScope scope = UiScopeDescriptorFactory().popupFrame(token, this.m_context.popupToken(), placement.value(), options);
    auto next = this.m_scope;
    if(!nested)
        this.reset();
    else{
        if(this.m_popupFrameCount >= this.m_popupFrames.size()){
            this.m_context.fail();
            return false;
        }
        if(!this.m_popupFrames[this.m_popupFrameCount].valid() && !this.m_popupFrames[this.m_popupFrameCount].tryEmplace()){
            this.m_context.fail();
            return false;
        }
        mut BuilderScopeFrame child = this.m_popupFrames[this.m_popupFrameCount].value();
        ++this.m_popupFrameCount;
        child.reset();
        child.m_parent = this.m_scope;
        next = Optional<mut BuilderScopeFrame>(child);
    }
    if(!this.m_context.beginPopupScope(declaration, scope) || !this.m_context.pushScope(stableKey) || !this.m_paint.beginOverlay(this.m_context.popupLayer())){
        this.m_context.fail();
        return false;
    }
    this.m_scope = next;
    this.m_scope.value().m_panelState = declaration;
    this.m_scope.value().m_popupPaintStyle = this.m_popupStyle;
    this.m_scope.value().m_bounds = placement.value().bounds;
    const LayoutNodeDesc description = UiScopeDescriptorFactory().popupRoot(this.m_scope.value().m_bounds, this.m_scope.value().m_popupPaintStyle.padding, background.value().padding, this.m_style.gap);
    u32 node = 0u;
    const auto admittedNode = this.m_scope.value().m_layout.addNode(s_LayoutNoParent, description);
    if(!admittedNode.has_value()){
        this.m_context.fail();
        return false;
    }
    node = admittedNode.value();
    this.m_scope.value().m_stack.push_back(node);
    this.m_scope.value().m_scrollAreaStack.push_back(s_LayoutNoParent);
    this.m_scope.value().m_scopeKinds.push_back(BuilderScopeKind::Root);
    this.m_scope.value().m_virtualListStack.push_back(s_LayoutNoParent);
    this.m_scope.value().m_splitterStack.push_back(s_LayoutNoParent);
    this.m_scope.value().m_popupState = Optional<mut PopupState>(state);
    this.m_scope.value().m_popupToken = token;
    this.m_scope.value().m_popupOptions = options;
    this.m_scope.value().m_popupPlacement = placement.value();
    state.m_placement = placement.value();
    this.m_scope.value().m_panelActive = true;
    return true;
}

b8 Builder::endPopup(){
    if(this.declarationBlocked() || !this.m_scope.value().m_popupState.has_value() || !this.m_scope.value().m_panelActive || this.m_scope.value().m_windowActive || this.m_scope.value().m_stack.size() != 1u){
        this.m_context.fail();
        return false;
    }
    this.m_finalizing = true;
    BuilderOperationEnd finish(this.m_finalizing);
    const b8 visible = this.synchronizePopup();
    const b8 arranged = !visible || (!this.m_context.failed() && this.m_scope.value().m_layout.arrange(this.m_scope.value().m_bounds));
    const b8 overlayEnded = this.m_paint.endOverlay();
    const b8 scopePopped = this.m_context.popScope();
    const b8 popupEnded = this.m_context.endPopupScope(visible && arranged);
    this.m_scope.value().m_panelActive = false;
    this.m_scope.value().m_stack.clear();
    this.m_scope.value().m_scrollAreaStack.clear();
    this.m_scope.value().m_scopeKinds.clear();
    this.m_scope.value().m_virtualListStack.clear();
    this.m_scope.value().m_splitterStack.clear();
    this.m_scope.value().m_dockSpaceStack.clear();
    if(!arranged || !overlayEnded || !scopePopped || !popupEnded){
        this.m_context.fail();
        if(this.m_scope.value().m_parent.has_value())
            this.m_scope = this.m_scope.value().m_parent;
        else
            this.releasePopupFamily();
        return false;
    }
    if(this.m_scope.value().m_parent.has_value()){
        this.m_scope = this.m_scope.value().m_parent;
        return true;
    }
    const b8 finished = this.finishPopupFamily();
    if(!finished)
        this.m_context.fail();
    return finished;
}

b8 Builder::synchronizePopup(){
    auto ancestor = this.m_scope;
    while(ancestor.has_value()){
        in BuilderScopeFrame frame = ancestor.value();
        if(frame.m_popupState.has_value() && !this.popupFrameVisible(frame)){
            this.m_context.input().closePopup(frame.m_popupToken);
            return false;
        }
        ancestor = frame.m_parent;
    }
    return true;
}

b8 Builder::finishPopupFamily(){
    this.m_scopeFrame.m_popupVisible = this.popupFrameVisible(this.m_scopeFrame);
    if(!this.m_scopeFrame.m_popupVisible)
        this.m_context.discardPopupScope(this.m_scopeFrame.m_popupToken);
    for(usize index = 0u; index < this.m_popupFrameCount; ++index){
        mut BuilderScopeFrame frame = this.m_popupFrames[index].value();
        frame.m_popupVisible = frame.m_parent.value().m_popupVisible && this.popupFrameVisible(frame);
        if(!frame.m_popupVisible)
            this.m_context.discardPopupScope(frame.m_popupToken);
    }
    const b8 painted = this.paintPopupFamily(this.m_scopeFrame);
    const b8 valid = painted && this.validatePopupFamily();
    for(usize index = 0u; index <= this.m_popupFrameCount; ++index){
        mut BuilderScopeFrame frame = this.popupFrameAt(index);
        this.m_scope = Optional<mut BuilderScopeFrame>(frame);
        this.publishSliderResults(valid && frame.m_popupVisible);
    }
    this.releasePopupFamily();
    return valid;
}

b8 Builder::paintPopupFamily(mut BuilderScopeFrame frame){
    this.m_scope = Optional<mut BuilderScopeFrame>(frame);
    if(!frame.m_popupVisible)
        return true;
    if(!this.popupAncestorsVisible() || !this.m_context.activatePopupScope(frame.m_popupToken))
        return false;
    if(!this.m_paint.beginOverlay(this.m_context.popupLayer())){
        const b8 ended = this.m_context.endPopupScope(false);
        if(!ended)
            this.m_context.fail();
        return false;
    }
    b8 painted = this.paintPopup() && this.paintDeferredContents();
    for(usize index = 0u; painted && index < this.m_popupFrameCount; ++index){
        mut BuilderScopeFrame child = this.m_popupFrames[index].value();
        if((child.m_parent.has_value() && SameAddress(child.m_parent.value(), frame)))
            painted = this.paintPopupFamily(child);
    }
    this.m_scope = Optional<mut BuilderScopeFrame>(frame);
    const b8 overlayEnded = this.m_paint.endOverlay();
    const b8 scopeEnded = this.m_context.endPopupScope(painted);
    return painted && overlayEnded && scopeEnded;
}

b8 Builder::validatePopupFamily(){
    for(usize index = 0u; index <= this.m_popupFrameCount; ++index){
        mut BuilderScopeFrame frame = this.popupFrameAt(index);
        this.m_scope = Optional<mut BuilderScopeFrame>(frame);
        if(frame.m_popupVisible && (!this.popupFrameVisible(frame) || !this.validateDeferredSources()))
            return false;
    }
    for(usize index = 0u; index <= this.m_popupFrameCount; ++index){
        mut BuilderScopeFrame frame = this.popupFrameAt(index);
        this.m_scope = Optional<mut BuilderScopeFrame>(frame);
        if(frame.m_popupVisible && (!this.popupFrameVisible(frame) || !this.validateDeferredStates()))
            return false;
    }
    return !this.m_context.failed();
}

void Builder::releasePopupFamily(){
    for(usize index = 0u; index <= this.m_popupFrameCount; ++index){
        mut BuilderScopeFrame frame = this.popupFrameAt(index);
        this.m_scope = Optional<mut BuilderScopeFrame>(frame);
        if(!frame.m_popupVisible){
            for(mut auto tooltip : frame.m_tooltips){
                if(tooltip.state.has_value() && tooltip.state.value().revision() == tooltip.revision)
                    tooltip.state.value().reset();
            }
        }
        this.releaseDeferredLoans();
        frame.m_popupState.reset();
    }
    this.m_scope = Optional<mut BuilderScopeFrame>(this.m_scopeFrame);
}

b8 Builder::reserveCompoundPopup(in WidgetState widget, in PopupToken token){
    const PopupOptions options = BuildCompoundPopupReservationOptions();
    const auto placement = PlacePopup(options, this.m_paint.displayMetrics());
    if(!placement.has_value())
        return false;
    const PopupScope scope = UiScopeDescriptorFactory().basicPopup(token, this.m_context.popupToken(), placement.value());
    return this.m_context.registerPopupScope(widget, scope);
}

b8 Builder::paintPopup(){
    const Optional<LayoutBox> panel = this.m_scope.value().m_layout.box(0u);
    const auto background = this.region(this.m_scope.value().m_popupPaintStyle.background, this.m_scope.value().m_popupPaintStyle.fallback);
    if(!panel.has_value() || !background.has_value())
        return false;
    if(this.m_scope.value().m_popupOptions.modal){
        in Color color = this.m_scope.value().m_popupPaintStyle.backdrop;
        if(!IsValidPaintColor(color))
            return false;
        this.m_paint.fillRect(this.m_scope.value().m_popupPlacement.viewport, color);
    }
    this.m_paint.pushClip(this.m_scope.value().m_popupPlacement.viewport);
    const b8 painted = this.m_paint.drawRegion(background.value().name, panel.value().rectangle);
    const b8 popped = this.m_paint.popClip();
    HitTargetFactory targets;
    const HitTarget barrier = targets.makeBarrierHitTarget(panel.value().rectangle, this.m_scope.value().m_popupPlacement.viewport);
    if(!painted || !popped || !this.m_context.addTarget(this.m_scope.value().m_panelState, barrier))
        return false;
    AccessibilityRole role = AccessibilityRole::Panel;
    u32 popupState = ResolveAccessibleVisibilityStateBits(true, this.m_scope.value().m_popupPlacement.viewport);
    if(this.m_scope.value().m_popupOptions.modal){
        role = AccessibilityRole::Dialog;
        popupState |= s_AccessibilityStateModal;
    }
    this.emitAccessibleNode(
        this.m_scope.value().m_panelState,
        role,
        panel.value().rectangle,
        StringView(),
        StringView(),
        popupState,
        s_AccessibilityActionNone
    );
    const b8 pushedParent = this.m_context.pushAccessibleParent(this.m_scope.value().m_panelState.id);
    const b8 itemsOk = this.paintItems();
    if(pushedParent)
        this.m_context.popAccessibleParent();
    return itemsOk;
}

RadioGroupResult Builder::radioGroup(in StringView stableKey, in borrow IListDataSource source, mut RadioGroupState state, in RadioGroupOptions options){
    RadioGroupResult result;
    if(this.itemDeclarationBlocked() || !this.m_skin.has_value()){
        this.m_context.fail();
        return result;
    }
    if(!this.synchronizePopup()){
        result.valid = true;
        return result;
    }
    this.m_declaring = true;
    BuilderOperationEnd finish(this.m_declaring);
    const auto widget = this.m_context.declare(stableKey, WidgetKind::RadioGroup);
    if(!widget.has_value() || !this.m_context.claimState(widget.value(), state.instanceGeneration()))
        return result;
    auto frame = this.makeRadioGroupFrame(source, state);
    frame.m_options = options;
    frame.m_style = this.m_radioGroupStyle;
    frame.m_widgetStyle = this.m_style;
    const auto metrics = MeasureRadioGroup(0u, Point(), options, frame.m_style);
    if(!metrics.has_value()){
        this.m_context.fail();
        return result;
    }
    frame.m_metrics = metrics.value();
    const b8 previouslyFocused = this.m_context.input().focus() == widget.value().id;
    RadioGroupPopupGuard guard(this.m_context);
    auto ancestor = this.m_scope;
    while(ancestor.has_value()){
        in BuilderScopeFrame scope = ancestor.value();
        if(scope.m_popupState.has_value() && !guard.add(scope.m_popupState.value(), scope.m_popupToken)){
            this.m_context.fail();
            return result;
        }
        ancestor = scope.m_parent;
    }
    const auto choices = ReconcileRadioGroup(source, guard, state, result);
    const b8 reconciled = choices.has_value();
    if(choices.has_value())
        frame.m_choices = choices.value();
    if(this.m_context.failed()){
        result.valid = false;
        return result;
    }
    if(!this.synchronizePopup()){
        result.valid = true;
        return result;
    }
    if(!reconciled){
        result.valid = false;
        this.m_context.fail();
        return result;
    }
    frame.m_snapshot = state.snapshot();
    frame.m_token.instanceGeneration = state.inputGeneration();
    frame.m_token.contentGeneration = frame.m_choices.sourceGeneration;
    frame.m_token.contentRevision = frame.m_choices.sourceRevision;
    this.m_context.input().fenceControl(widget.value().id, widget.value().declarationGeneration, frame.m_token);
    const b8 interactive = IsRadioGroupInteractive(frame.m_choices, options);
    if(!interactive)
        this.m_context.input().invalidateTarget(widget.value().id);
    while(true){
        const auto action = this.m_context.takeControlAction(widget.value(), interactive, frame.m_token);
        if(!action.has_value())
            break;
        if(!ApplyRadioGroupControlAction(frame.m_choices, options, action.value(), state, result)){
            result.valid = false;
            this.m_context.fail();
            return result;
        }
    }
    frame.m_snapshot = state.snapshot();
    result.focused = interactive && this.m_context.input().focus() == widget.value().id;
    frame.m_focusOnCommit = interactive && previouslyFocused && !result.focused;
    if(!this.prepareRadioGroup(frame)){
        result.valid = false;
        this.m_context.fail();
        return result;
    }
    auto item = this.makeItem();
    item.state = widget.value();
    item.enabled = interactive;
    item.radioGroup = cast<u32>(this.m_scope.value().m_radioGroups.size());
    const LayoutNodeDesc description = BuildWidthLeafNodeDesc(options.width, frame.m_metrics.contentSize, options.layout);
    if(!this.addItemNode(description, item)){
        result.valid = false;
        return result;
    }
    AppendOwned<RadioGroupFrame>(this.m_scope.value().m_radioGroups, frame);
    AppendOwned<BuilderItem>(this.m_scope.value().m_items, item);
    result.valid = true;
    return result;
}

b8 Builder::radioGroupMatches(in RadioGroupFrame frame)const{
    for(u32 pass = 0u; pass < s_RadioGroupStampFencePassCount; ++pass){
        if(
            !this.radioGroupStateMatches(frame)
            || frame.m_source.instanceGeneration() != frame.m_choices.sourceGeneration || !this.radioGroupStateMatches(frame)
            || frame.m_source.revision() != frame.m_choices.sourceRevision || !this.radioGroupStateMatches(frame)
            || frame.m_source.rowCount() != frame.m_choices.count || !this.radioGroupStateMatches(frame)
        )
            return false;
    }
    return true;
}

b8 Builder::prepareRadioGroup(mut RadioGroupFrame frame){
    if(!this.radioGroupMatches(frame))
        return false;
    Point maximumLabel;
    frame.m_labels.reserve(frame.m_choices.count);
    for(u32 index = 0u; index < frame.m_choices.count; ++index){
        if(!this.radioGroupStateMatches(frame))
            return false;
        const StringView text = frame.m_source.text(index);
        if(!this.radioGroupStateMatches(frame))
            return false;
        const auto measuredLabel = this.m_text.layoutAndMeasureShared(this.textShapeRequest(text, frame.m_widgetStyle.fontSize), this.m_paint.displayMetrics());
        if(!measuredLabel.has_value() || !this.radioGroupMatches(frame))
            return false;
        const VectorSingle curMax(maximumLabel.x, maximumLabel.y, 0.0f, 0.0f);
        const VectorSingle measuredDim(measuredLabel.value().bounds.width, measuredLabel.value().bounds.height, 0.0f, 0.0f);
        const VectorSingle nextMax = VectorSelect(measuredDim, curMax, VectorGreater(curMax, measuredDim));
        maximumLabel.x = nextMax.x;
        maximumLabel.y = nextMax.y;
        frame.m_labels.emplace_back(measuredLabel.value().layout, measuredLabel.value().bounds);
    }
    if(!this.m_skin.has_value())
        return false;
    const Expected<RadioGroupMetrics> metrics = ControlStyleMetrics().radioGroupMetrics(this.m_skin.value(), frame.m_choices.count, maximumLabel, frame.m_options, frame.m_style);
    if(!metrics.has_value())
        return false;
    frame.m_metrics = metrics.value();
    return this.radioGroupMatches(frame);
}

b8 Builder::paintRadioGroup(in BuilderItem item, in LayoutBox box){
    if(item.radioGroup >= this.m_scope.value().m_radioGroups.size())
        return false;
    mut RadioGroupFrame frame = this.m_scope.value().m_radioGroups[item.radioGroup];
    if(!this.radioGroupMatches(frame) || frame.m_labels.size() != frame.m_choices.count)
        return false;
    const auto placement = PlaceRadioGroup(box.rectangle, this.visibleClip(box.clip), frame.m_choices, frame.m_metrics);
    if(!placement.has_value())
        return false;
    HitTargetFactory targets;
    const HitTarget host = targets.makeRadioGroupHostHitTarget(placement.value(), item.enabled, item.contextMenu, frame.m_token, frame.m_focusOnCommit);
    if(!this.m_context.addTarget(item.state, host))
        return false;
    const Rect groupClip = this.visibleClip(box.clip);
    u32 groupActions = s_AccessibilityActionFocus;
    if(item.contextMenu)
        groupActions |= s_AccessibilityActionContextMenu;
    this.emitAccessibleNode(
        item.state,
        AccessibilityRole::RadioGroup,
        box.rectangle,
        StringView(),
        StringView(),
        ResolveAccessibleVisibilityStateBits(item.enabled, groupClip) | s_AccessibilityStateFocusable,
        groupActions
    );
    const auto choices = TryMakeWidgetId(item.state.id, s_WidgetPartChoices);
    if(!choices.has_value())
        return false;
    ControlVisualPainter painter;
    Optional<in UiSkinRegion> mark;
    if(placement.value().count != 0u)
        mark = this.region(frame.m_style.mark, frame.m_style.markFallback);
    for(u32 index = 0u; index < placement.value().count; ++index){
        in RadioGroupChoicePlacement row = placement.value().rows[index];
        const auto part = TryMakeWidgetPartId(choices.value(), row.key);
        if(!part.has_value())
            return false;
        in InputRouter input = this.m_context.input();
        const RadioChoiceVisualFlags visualFlags = BuildRadioChoiceVisualFlags(
            frame.m_options.enabled,
            row.enabled,
            frame.m_snapshot.selectedKey,
            frame.m_snapshot.cursorKey,
            row.key,
            input.hover(),
            part.value(),
            input.pressed(part.value()),
            input.pressed(item.state.id),
            input.focus(),
            item.state.id
        );
        if(!mark.has_value() || !frame.m_labels[index].m_text.valid() || !painter.paintRadioGroupChoiceRow(
            this.m_paint,
            this.m_text,
            this.m_skin.value(),
            frame.m_style,
            frame.m_widgetStyle,
            frame.m_metrics,
            row,
            frame.m_labels[index].m_text.deref(),
            frame.m_labels[index].m_bounds,
            mark.value().name,
            visualFlags.enabled,
            visualFlags.checked,
            visualFlags.pressed,
            visualFlags.hover,
            visualFlags.focused
        ))
            return false;
        if(item.enabled){
            const HitTarget target = targets.makeRadioGroupChoiceHitTarget(row, visualFlags.enabled, frame.m_token);
            if(!this.m_context.addPartTarget(item.state, part.value(), target))
                return false;
        }
        u32 choiceState = ResolveAccessibleVisibilityStateBits(visualFlags.enabled, row.clip) | s_AccessibilityStateFocusable;
        if(visualFlags.checked)
            choiceState |= s_AccessibilityStateChecked;
        this.emitAccessiblePartNode(
            part.value(),
            item.state.id,
            AccessibilityRole::RadioButton,
            row.rectangle,
            frame.m_labels[index].m_text.deref().utf8(),
            choiceState,
            s_AccessibilityActionSelect | s_AccessibilityActionFocus,
            cast<i32>(index + 1u),
            cast<i32>(placement.value().count),
            0
        );
    }
    if(!this.radioGroupMatches(frame))
        return false;
    frame.m_state.m_placement = placement.value();
    return true;
}

b8 Builder::slider(in StringView stableKey, mut SliderState state, in SliderOptions options){
    if(this.itemDeclarationBlocked() || !this.m_skin.has_value()){
        this.m_context.fail();
        return false;
    }
    if(!this.synchronizePopup())
        return true;
    this.m_declaring = true;
    BuilderOperationEnd finish(this.m_declaring);
    const auto widget = this.m_context.declare(stableKey, WidgetKind::Slider);
    if(!widget.has_value() || !this.m_context.claimState(widget.value(), state.instanceGeneration()))
        return false;
    state.m_result = SliderResult();
    if(!IsValidSliderOptions(options)){
        this.m_context.fail();
        return false;
    }
    f64 requestedValue = 0.0;
    if(options.enabled && this.m_context.takeAccessibleNumericValue(widget.value(), requestedValue)){
        f64 clamped = requestedValue;
        if(clamped < options.minimum)
            clamped = options.minimum;
        if(clamped > options.maximum)
            clamped = options.maximum;
        if(clamped != state.value() && !state.setValue(clamped)){
            this.m_context.fail();
            return false;
        }
    }
    SliderFrame frame(state);
    frame.m_options = options;
    frame.m_style = this.m_sliderStyle;
    frame.m_snapshot = state.snapshot();
    frame.m_widget = widget.value();
    const auto metrics = MeasureSlider(options, frame.m_style);
    if(!metrics.has_value()){
        this.m_context.fail();
        return false;
    }
    frame.m_metrics = metrics.value();
    if(!this.prepareSlider(frame)){
        this.m_context.fail();
        return false;
    }
    auto item = this.makeItem();
    item.state = widget.value();
    item.enabled = options.enabled;
    item.slider = cast<u32>(this.m_scope.value().m_sliders.size());
    const LayoutNodeDesc description = BuildWidthLeafNodeDesc(options.width, frame.m_metrics.contentSize, options.layout);
    if(!this.addItemNode(description, item))
        return false;
    AppendOwned<SliderFrame>(this.m_scope.value().m_sliders, frame);
    AppendOwned<BuilderItem>(this.m_scope.value().m_items, item);
    return true;
}

b8 Builder::prepareSlider(mut SliderFrame frame){
    if(!this.sliderMatches(frame) || !this.m_skin.has_value())
        return false;
    const Expected<SliderMetrics> metrics = ControlStyleMetrics().sliderMetrics(this.m_skin.value(), frame.m_options, frame.m_style);
    if(!metrics.has_value())
        return false;
    frame.m_metrics = metrics.value();
    return this.sliderMatches(frame);
}

void Builder::publishSliderResults(in b8 valid){
    in InputRouter input = this.m_context.input();
    for(mut auto frame : this.m_scope.value().m_sliders){
        SliderResult result;
        if(valid && frame.m_result.valid && this.sliderMatches(frame)){
            const auto finalized = TryFinalizeSliderFrameResult(
                frame.m_result,
                frame.m_widget.id,
                frame.m_interactive,
                input.focus(),
                input.primaryDown(),
                input.capture()
            );
            if(!finalized.has_value()){
                this.m_context.fail();
                frame.m_state.m_result = SliderResult();
                continue;
            }
            result = finalized.value();
        }
        frame.m_state.m_result = result;
    }
}

b8 Builder::paintSlider(in BuilderItem item, in LayoutBox box){
    if(item.slider >= this.m_scope.value().m_sliders.size())
        return false;
    mut SliderFrame frame = this.m_scope.value().m_sliders[item.slider];
    if(!this.sliderMatches(frame))
        return false;
    auto normalized = NormalizeFiniteRange(frame.m_options.minimum, frame.m_options.maximum, frame.m_state.value());
    if(!normalized.has_value())
        return false;
    const Rect clip = this.visibleClip(box.clip);
    auto placement = PlaceSlider(box.rectangle, clip, frame.m_metrics, normalized.value());
    if(!placement.has_value() || !AdmitSliderState(frame.m_state, frame.m_options, placement.value()))
        return false;
    frame.m_snapshot = frame.m_state.snapshot();
    frame.m_token = frame.m_state.controlToken();
    const b8 interactive = IsSliderPlacementInteractive(frame.m_options, placement.value());
    mut InputRouter input = this.m_context.input();
    const b8 previouslyFocused = input.focus() == item.state.id;
    input.fenceControl(item.state.id, item.state.declarationGeneration, frame.m_token);
    if(!interactive)
        input.invalidateTarget(item.state.id);
    frame.m_focusOnCommit = interactive && previouslyFocused && input.focus() != item.state.id;
    frame.m_interactive = interactive;
    if(!this.applySliderInput(frame, placement.value(), interactive))
        return false;
    normalized = NormalizeFiniteRange(frame.m_options.minimum, frame.m_options.maximum, frame.m_state.value());
    if(!normalized.has_value())
        return false;
    placement = PlaceSlider(box.rectangle, clip, frame.m_metrics, normalized.value());
    if(!placement.has_value())
        return false;
    const auto trackId = TryMakeWidgetId(item.state.id, s_WidgetPartTrack);
    if(!trackId.has_value())
        return false;
    const auto thumbId = TryMakeWidgetId(item.state.id, s_WidgetPartThumb);
    if(!thumbId.has_value())
        return false;
    const b8 hover = interactive && input.hover() == thumbId.value();
    const b8 pressed = ResolveSliderThumbPressedState(interactive, input.primaryDown(), input.capture(), trackId.value(), thumbId.value());
    const b8 focused = input.focus() == item.state.id;
    ControlVisualPainter painter;
    if(!painter.paintSliderVisual(this.m_paint, this.m_skin.value(), frame.m_style, placement.value(), interactive, pressed, hover, focused) || !this.sliderMatches(frame))
        return false;
    HitTargetFactory targets;
    const HitTarget host = targets.makeSliderHostHitTarget(placement.value(), interactive, item.contextMenu, frame.m_token, frame.m_focusOnCommit);
    if(!this.m_context.addTarget(item.state, host))
        return false;
    if(interactive){
        const HitTarget trackTarget = targets.makeSliderTrackHitTarget(placement.value(), frame.m_token);
        if(!this.m_context.addPartTarget(item.state, trackId.value(), trackTarget))
            return false;
        const HitTarget thumbTarget = targets.makeSliderThumbHitTarget(placement.value(), frame.m_token, frame.m_state.value());
        if(!this.m_context.addPartTarget(item.state, thumbId.value(), thumbTarget))
            return false;
    }
    if(!this.sliderMatches(frame))
        return false;
    u32 sliderActions = s_AccessibilityActionFocus;
    if(interactive)
        sliderActions |= s_AccessibilityActionIncrement | s_AccessibilityActionDecrement | s_AccessibilityActionSetValue;
    if(item.contextMenu)
        sliderActions |= s_AccessibilityActionContextMenu;
    this.emitAccessibleRangeNode(
        item.state,
        AccessibilityRole::Slider,
        placement.value().bounds,
        StringView(),
        StringView(),
        frame.m_state.value(),
        frame.m_options.minimum,
        frame.m_options.maximum,
        frame.m_options.step,
        ResolveAccessibleVisibilityStateBits(interactive, clip) | s_AccessibilityStateFocusable,
        sliderActions
    );
    frame.m_state.m_placement = placement.value();
    frame.m_result.valid = true;
    return true;
}


