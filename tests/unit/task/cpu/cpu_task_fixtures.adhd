using CpuTaskSchedulerTestSupport::s_CpuProfilingNameTestsCpuEmptyScope;
using CpuTaskSchedulerTestSupport::s_CpuProfilingNameTestsCpuCompletedScope;
using CpuTaskSchedulerTestSupport::s_CpuProfilingNameTestsCpuCanceledScope;
using CpuTaskFanInTestSupport::RunFanInWithScratch;

inline constexpr u32 s_MpmcWorkerCount = CpuTaskMpmcTestSupport::s_WorkerCount;
inline constexpr u32 s_MpmcExternalProducerCount = CpuTaskMpmcTestSupport::s_ExternalProducerCount;
inline constexpr u32 s_MpmcProducerCount = CpuTaskMpmcTestSupport::s_ProducerCount;
inline constexpr u32 s_MpmcTasksPerProducer = CpuTaskMpmcTestSupport::s_TasksPerProducer;


