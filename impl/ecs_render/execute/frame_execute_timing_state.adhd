#include <impl/ecs_render/execute/types.adhd>
#include <impl/ecs_render/kernel/task_graph_clear_timing.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>
#include <impl/ecs_render/renderer_frame_pipeline.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Prefix stages share tickets when they occupy the same submission packet.
[ordered]
class FrameExecuteTimingState : NoCopy{
    public GpuTimingSubmissionTicket shadowPrepareTimingTicket;
    public GpuTimingSubmissionTicket graphicsPrefixMeshViewSetupTimingTicket;
    public GpuTimingSubmissionTicket graphicsPrefixSceneShadingSetupTimingTicket;
    public GpuTimingSubmissionTicket graphicsPrefixDeferredClearTimingTicket;
    public GpuTimingSubmissionTicket graphicsPrefixGbufferTimingTicket;
    public GpuTimingSubmissionTicket graphicsPrefixCsgReceiverSpanTimingTicket;
    public GpuTimingSubmissionTicket graphicsPrefixCsgIntervalCombineTimingTicket;
    public GpuTimingSubmissionTicket graphicsPrefixCsgIntervalSampleTimingTicket;
    public GpuTimingSubmissionTicket graphicsPrefixNormalizeTimingTicket;
    public Array<GraphicsPrefixTimingTicket, s_GraphicsPrefixTimingTaskCount> graphicsPrefixTimingTickets;
    public Array<GraphicsPrefixTimingTicket, s_GraphicsPrefixTimingTaskCount> graphicsPrefixOwnedTimingTickets;
    public b8 asyncPrefixTimingSpansOnePacket = true;
    public Optional<GpuTimingMeasure> asyncPrefixTiming;
    public Optional<GpuTimingMeasure> deferredClearTiming;
    public GraphClearTimingRecordState deferredClearTimingState;
    public Optional<GpuTimingMeasure> opaqueCsgIntervalClearTiming;
    public GraphClearTimingRecordState opaqueCsgIntervalClearTimingState;
    public Optional<GpuTimingMeasure> opaqueRegularSharedComputeEmulationTiming;
    public Optional<GpuTimingMeasure> opaqueCsgIntervalSampleComputeEmulationTiming;
    public GpuTimingSubmissionTicket shadowVisibilityTimingTicket;
    public Optional<GpuTimingMeasure> shadowVisibilityAsyncTiming;
    public Optional<GpuTimingMeasure> shadowVisibilityTiming;
    public Optional<GpuTimingMeasure> opaqueSoftResolveTiming;
    public Optional<GpuTimingMeasure> transparentSoftResolveTiming;
    public GpuTimingSubmissionTicket softwareCausticsTimingTicket;
    public GpuTimingSubmissionTicket surfelGiTimingTicket;
    public Optional<GpuTimingMeasure> surfelGiAsyncTiming;
    public GpuTimingSubmissionTicket hardwareCausticsTimingTicket;
    public Optional<GpuTimingMeasure> causticPhotonTiming;
    public Optional<GpuTimingMeasure> causticResolveTiming;
    public GpuTimingSubmissionTicket avboitPreTimingTicket;
    public GpuTimingSubmissionTicket avboitDepthWarpTimingTicket;
    public GpuTimingSubmissionTicket avboitExtinctionTimingTicket;
    public GpuTimingSubmissionTicket avboitIntegrationTimingTicket;
    public GpuTimingSubmissionTicket avboitAccumulationTimingTicket;
    public Optional<GpuTimingMeasure> avboitClearTiming;
    public GraphClearTimingRecordState avboitClearTimingState;
    public Optional<GpuTimingMeasure> transparentCsgIntervalClearTiming;
    public GraphClearTimingRecordState transparentCsgIntervalClearTimingState;
    public Optional<GpuTimingMeasure> transparentCsgIntervalsTiming;
    public Optional<GpuTimingMeasure> avboitOccupancyComputeEmulationTiming;
    public Optional<GpuTimingMeasure> avboitExtinctionComputeEmulationTiming;
    public Optional<GpuTimingMeasure> avboitAccumulationComputeEmulationTiming;
    public GpuTimingSubmissionTicket deferredLightingTimingTicket;
    public GpuTimingSubmissionTicket deferredCompositeTimingTicket;
    public GpuTimingSubmissionTicket deferredPresentTimingTicket;
    public GpuTimingFrameTransaction frameTimingTransaction;
    public Optional<GpuTimingMeasure> asyncFinalTiming;

    public FrameExecuteTimingState(mut GraphicsRuntime graphics){
        this.shadowPrepareTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.graphicsPrefixMeshViewSetupTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.graphicsPrefixSceneShadingSetupTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.graphicsPrefixDeferredClearTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.graphicsPrefixGbufferTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.graphicsPrefixCsgReceiverSpanTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.graphicsPrefixCsgIntervalCombineTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.graphicsPrefixCsgIntervalSampleTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.graphicsPrefixNormalizeTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.deferredClearTimingState = GraphClearTimingRecordState(graphics, this.deferredClearTiming, this.graphicsPrefixTimingTickets[cast<usize>(DeferredGraphicsPrefixTimingSlot::DeferredClear)], s_TimingScopeDeferredClear);
        this.opaqueCsgIntervalClearTimingState = GraphClearTimingRecordState(graphics, this.opaqueCsgIntervalClearTiming, this.graphicsPrefixTimingTickets[cast<usize>(DeferredGraphicsPrefixTimingSlot::Gbuffer)], s_TimingScopeCsgIntervalClear);
        this.shadowVisibilityTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.softwareCausticsTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.surfelGiTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.hardwareCausticsTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.avboitPreTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.avboitDepthWarpTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.avboitExtinctionTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.avboitIntegrationTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.avboitAccumulationTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.avboitClearTimingState = GraphClearTimingRecordState(graphics, this.avboitClearTiming, this.avboitPreTimingTicket, s_TimingScopeAvboitClear);
        this.transparentCsgIntervalClearTimingState = GraphClearTimingRecordState(graphics, this.transparentCsgIntervalClearTiming, this.avboitPreTimingTicket, s_TimingScopeCsgIntervalClear);
        this.deferredLightingTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.deferredCompositeTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.deferredPresentTimingTicket = GpuTimingSubmissionTicket(graphics.gpuTiming());
        this.frameTimingTransaction = GpuTimingFrameTransaction(graphics.gpuTiming());
        this.graphicsPrefixOwnedTimingTickets[0u] = Optional<mut GpuTimingSubmissionTicket>(this.graphicsPrefixMeshViewSetupTimingTicket);
        this.graphicsPrefixOwnedTimingTickets[1u] = Optional<mut GpuTimingSubmissionTicket>(this.graphicsPrefixSceneShadingSetupTimingTicket);
        this.graphicsPrefixOwnedTimingTickets[2u] = Optional<mut GpuTimingSubmissionTicket>(this.graphicsPrefixDeferredClearTimingTicket);
        this.graphicsPrefixOwnedTimingTickets[3u] = Optional<mut GpuTimingSubmissionTicket>(this.graphicsPrefixGbufferTimingTicket);
        this.graphicsPrefixOwnedTimingTickets[4u] = Optional<mut GpuTimingSubmissionTicket>(this.graphicsPrefixCsgReceiverSpanTimingTicket);
        this.graphicsPrefixOwnedTimingTickets[5u] = Optional<mut GpuTimingSubmissionTicket>(this.graphicsPrefixCsgIntervalCombineTimingTicket);
        this.graphicsPrefixOwnedTimingTickets[6u] = Optional<mut GpuTimingSubmissionTicket>(this.graphicsPrefixCsgIntervalSampleTimingTicket);
        this.graphicsPrefixOwnedTimingTickets[7u] = Optional<mut GpuTimingSubmissionTicket>(this.graphicsPrefixNormalizeTimingTicket);
        this.graphicsPrefixTimingTickets = this.graphicsPrefixOwnedTimingTickets;
    }

    [cpp_unwind]
    public void discardGraphicsPrefixTickets(){
        for(in GraphicsPrefixTimingTicket timingTicket : this.graphicsPrefixOwnedTimingTickets)
            timingTicket.value().discard();
    }

    [cpp_unwind]
    public void discardTickets(){
        this.shadowPrepareTimingTicket.discard();
        this.discardGraphicsPrefixTickets();
        this.shadowVisibilityTimingTicket.discard();
        this.hardwareCausticsTimingTicket.discard();
        this.softwareCausticsTimingTicket.discard();
        this.surfelGiTimingTicket.discard();
        this.avboitPreTimingTicket.discard();
        this.avboitDepthWarpTimingTicket.discard();
        this.avboitExtinctionTimingTicket.discard();
        this.avboitIntegrationTimingTicket.discard();
        this.avboitAccumulationTimingTicket.discard();
        this.deferredLightingTimingTicket.discard();
        this.deferredCompositeTimingTicket.discard();
        this.deferredPresentTimingTicket.discard();
    }

    [cpp_unwind]
    public void discardAll(){
        DiscardGpuTimingMeasure(this.asyncPrefixTiming);
        DiscardGpuTimingMeasure(this.deferredClearTiming);
        DiscardGpuTimingMeasure(this.asyncFinalTiming);
        DiscardGpuTimingMeasure(this.causticPhotonTiming);
        DiscardGpuTimingMeasure(this.causticResolveTiming);
        DiscardGpuTimingMeasure(this.transparentCsgIntervalsTiming);
        DiscardGpuTimingMeasure(this.avboitOccupancyComputeEmulationTiming);
        DiscardGpuTimingMeasure(this.avboitExtinctionComputeEmulationTiming);
        DiscardGpuTimingMeasure(this.avboitAccumulationComputeEmulationTiming);
        DiscardGpuTimingMeasure(this.opaqueRegularSharedComputeEmulationTiming);
        DiscardGpuTimingMeasure(this.opaqueCsgIntervalSampleComputeEmulationTiming);
        this.frameTimingTransaction.discard();
        this.discardTickets();
    }

    [cpp_unwind]
    public Expected<usize> bindNormalTimingTickets(
        in RendererFramePipeline renderer,
        in GpuCompiledGraphReadView compiledPlan,
        in Span<GpuTaskId> graphicsPrefixTimingTasks,
        in usize graphicsPrefixUniquePacketCount,
        in RendererAvboitTaskGraphValidation avboitValidation,
        in b8 hardwareShadowSupported,
        mut Span<GpuTaskGraphTaskTimingTicket> tickets
    ){
        if(!HasExpectedGraphicsPrefixTimingTaskCount(graphicsPrefixTimingTasks.size()))
            return MakeUnexpected(Failure());
        usize ticketCount = 0u;
        Func<64u, b8(in GpuTaskId, mut GpuTimingSubmissionTicket)> appendTicket = lambda[mut tickets, mut ticketCount](in GpuTaskId task, mut GpuTimingSubmissionTicket timingTicket) -> b8 {
            if(!task.valid() || ticketCount >= tickets.size())
                return false;
            tickets[ticketCount++].bind(task, timingTicket);
            return true;
        };
        b8 ready = appendTicket(renderer.m_shadowPrepareGraph.m_deferredShadowPrepareTask, this.shadowPrepareTimingTicket);
        for(usize prefixTaskIndex = 0u; ready && prefixTaskIndex < s_GraphicsPrefixTimingTaskCount; ++prefixTaskIndex){
            const GpuTaskId task = graphicsPrefixTimingTasks[prefixTaskIndex];
            b8 packetAlreadyTimed = false;
            for(usize earlierTaskIndex = 0u; earlierTaskIndex < prefixTaskIndex; ++earlierTaskIndex){
                if(compiledPlan.tasksSharePacket(task, graphicsPrefixTimingTasks[earlierTaskIndex])){
                    packetAlreadyTimed = true;
                    break;
                }
            }
            if(packetAlreadyTimed)
                continue;
            if(!compiledPlan.findTask(task).valid() || !this.graphicsPrefixTimingTickets[prefixTaskIndex].has_value()){
                ready = false;
                break;
            }
            ready = appendTicket(task, this.graphicsPrefixTimingTickets[prefixTaskIndex].value());
        }
        ready = ready
            && MatchesBoundGraphicsPrefixPacketCount(ticketCount, graphicsPrefixUniquePacketCount)
            && appendTicket(renderer.m_shadowVisibilityGraph.m_deferredShadowVisibilityTask, this.shadowVisibilityTimingTicket);
        if(ready){
            if(hardwareShadowSupported)
                ready = appendTicket(renderer.m_causticsGraph.m_deferredHardwareCausticsTask, this.hardwareCausticsTimingTicket);
            else
                ready = appendTicket(renderer.m_causticsGraph.m_deferredSoftwareCausticsTask, this.softwareCausticsTimingTicket);
        }
        ready = ready && appendTicket(renderer.m_surfelGiGraph.m_deferredSurfelGiTask, this.surfelGiTimingTicket);
        RendererAvboitTaskGraphTimingTickets avboitTimingTickets(
            this.avboitPreTimingTicket,
            this.avboitDepthWarpTimingTicket,
            this.avboitExtinctionTimingTicket,
            this.avboitIntegrationTimingTicket,
            this.avboitAccumulationTimingTicket
        );
        ready = ready
            && renderer.m_avboitSystem.appendTaskGraphTimingTickets(avboitValidation, avboitTimingTickets, ticketCount, tickets.size(), appendTicket)
            && appendTicket(renderer.m_deferredLightingTask, this.deferredLightingTimingTicket)
            && appendTicket(renderer.m_deferredCompositeTask, this.deferredCompositeTimingTicket)
            && appendTicket(renderer.m_deferredPresentTask, this.deferredPresentTimingTicket)
        ;
        if(!ready)
            return MakeUnexpected(Failure());
        return ticketCount;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

