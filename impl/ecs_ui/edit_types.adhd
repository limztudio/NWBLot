native{
namespace NWB::Impl{
using Ui::DisplayMetrics;
namespace EditAction = Ui::EditAction;
namespace EditClipboardAction = Ui::EditClipboardAction;
using Ui::EditBoxCaretStop;
using Ui::EditBoxPlacement;
using Ui::EditBoxResult;
using Ui::EditCaretLine;
using Ui::EditCompositionView;
