#include <utilities/fbx_to_nwb/source_types.adhd>
#include <utilities/fbx_to_nwb/mesh_stream_operations.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> PositionSkinRemap{ Deduplicate, PreserveIndices }

class StreamSortEntry<Value>{
    public Value value;
    public usize sourceIndex = 0u;
}

class CanonicalStreamResult<Value>{
    public Vector<Value> compact;
    public Vector<u32> remap;
    public b8 ok = false;
    public b8 compacted = false;
}

class CanonicalizeMeshStreamsResult{
    public Vector<Vec3> positions;
    public Vector<Vec3> normals;
    public Vector<Vec4> tangents;
    public Vector<Vec2> uv0;
    public Vector<Vec4> colors;
    public Vector<MeshSkinInfluence> skin;
    public SourceMeshCanonicalizeReport report;
    public b8 compactedPositions = false;
    public b8 compactedNormals = false;
    public b8 compactedTangents = false;
    public b8 compactedUv0 = false;
    public b8 compactedColors = false;
    public b8 compactedSkin = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateSkinnedMeshCanonicalizeCounts(in usize positionCount, in usize skinInfluenceCount){
    if(positionCount != skinInfluenceCount){
        error("Failed to canonicalize skinned mesh: position and skin influence counts must match");
        return false;
    }
    return true;
}

b8 HasExceededCanonicalStreamValueLimit(in usize uniqueCount){
    return uniqueCount >= cast<usize>(s_MeshMissingStreamIndex);
}

b8 LessStreamSortEntry<Value>(in StreamSortEntry<Value> lhs, in StreamSortEntry<Value> rhs){
    if(LessEmittedStreamValue(lhs.value, rhs.value))
        return true;
    if(LessEmittedStreamValue(rhs.value, lhs.value))
        return false;
    return lhs.sourceIndex < rhs.sourceIndex;
}

void FillIdentityRemap(mut Vector<u32> remap){
    for(usize index = 0u; index < remap.size(); ++index)
        remap[index] = cast<u32>(index);
}

[cpp_unwind]
CanonicalStreamResult<Value> DeduplicateCanonicalStream<Value>(in Span<Value> sourceStream, in b8 preserveIndices){
    CanonicalStreamResult<Value> outResult;
    outResult.remap.resize(sourceStream.size(), 0u);
    if(sourceStream.empty() || preserveIndices){
        FillIdentityRemap(outResult.remap);
        outResult.ok = true;
        return outResult;
    }

    Vector<StreamSortEntry<Value>> sortedEntries;
    sortedEntries.resize(sourceStream.size());
    for(usize index = 0u; index < sourceStream.size(); ++index){
        sortedEntries[index].value = sourceStream[index];
        sortedEntries[index].sourceIndex = index;
    }

    SortSequence<StreamSortEntry<Value>>(sortedEntries, lambda[](in StreamSortEntry<Value> left, in StreamSortEntry<Value> right) -> b8{
        return LessStreamSortEntry<Value>(left, right);
    });

    usize uniqueCount = 0u;
    for(usize sortedIndex = 0u; sortedIndex < sortedEntries.size(); ++sortedIndex){
        if(sortedIndex == 0u || !SameEmittedStreamValue(sortedEntries[sortedIndex].value, sortedEntries[sortedIndex - 1u].value))
            ++uniqueCount;
    }

    if(uniqueCount == sourceStream.size()){
        FillIdentityRemap(outResult.remap);
        outResult.ok = true;
        return outResult;
    }

    if(HasExceededCanonicalStreamValueLimit(uniqueCount))
        return outResult;

    outResult.compact.reserve(uniqueCount);
    u32 compactIndex = 0u;
    for(usize sortedIndex = 0u; sortedIndex < sortedEntries.size(); ++sortedIndex){
        if(sortedIndex == 0u || !SameEmittedStreamValue(sortedEntries[sortedIndex].value, sortedEntries[sortedIndex - 1u].value)){
            assert(outResult.compact.size() < cast<usize>(s_MeshMissingStreamIndex));
            compactIndex = cast<u32>(outResult.compact.size());
            outResult.compact.push_back(sortedEntries[sortedIndex].value);
        }
        outResult.remap[sortedEntries[sortedIndex].sourceIndex] = compactIndex;
    }

    outResult.ok = true;
    outResult.compacted = true;
    return outResult;
}

b8 CheckCanonicalStream(in b8 ok, in StringView name){
    if(!ok)
        error("Failed to canonicalize mesh: {} stream has too many unique values", name);
    return ok;
}

usize TakeCanonicalStream<Value>(mut CanonicalStreamResult<Value> stream, mut Vector<Value> output, mut b8 compacted){
    compacted = stream.compacted;
    if(!compacted)
        return stream.remap.size();
    output.swap(stream.compact);
    return output.size();
}

[cpp_unwind]
Expected<CanonicalizeMeshStreamsResult> CanonicalizeMeshStreams(
    in Span<Vec3> positions,
    in Span<Vec3> normals,
    in Span<Vec4> tangents,
    in Span<Vec2> uv0,
    in Span<Vec4> colors,
    in Span<MeshSkinInfluence> skin,
    in usize indexCount,
    mut Span<SourceVertexRef> inOutVertexRefs,
    in PositionSkinRemap positionSkin
){
    const b8 preserveIndices = positionSkin == PositionSkinRemap::PreserveIndices;
    if(preserveIndices && !ValidateSkinnedMeshCanonicalizeCounts(positions.size(), skin.size()))
        return MakeUnexpected(Failure());
    CanonicalizeMeshStreamsResult out;
    out.report.before = MakeSourceMeshStreamCounts(
        positions.size(),
        normals.size(),
        tangents.size(),
        uv0.size(),
        colors.size(),
        skin.size(),
        inOutVertexRefs.size(),
        indexCount
    );

    CanonicalStreamResult<Vec3> positionResult;
    CanonicalStreamResult<Vec3> normalResult;
    CanonicalStreamResult<Vec4> tangentResult;
    CanonicalStreamResult<Vec2> uv0Result;
    CanonicalStreamResult<Vec4> colorResult;
    CanonicalStreamResult<MeshSkinInfluence> skinResult;

    parallel TaskPositions{
        positionResult = DeduplicateCanonicalStream<Vec3>(positions, preserveIndices);
    }
    parallel TaskNormals{
        normalResult = DeduplicateCanonicalStream<Vec3>(normals, false);
    }
    parallel TaskTangents{
        tangentResult = DeduplicateCanonicalStream<Vec4>(tangents, false);
    }
    parallel TaskUv0{
        uv0Result = DeduplicateCanonicalStream<Vec2>(uv0, false);
    }
    parallel TaskColors{
        colorResult = DeduplicateCanonicalStream<Vec4>(colors, false);
    }
    parallel TaskSkin{
        skinResult = DeduplicateCanonicalStream<MeshSkinInfluence>(skin, preserveIndices);
    }
    wait(TaskPositions, TaskNormals, TaskTangents, TaskUv0, TaskColors, TaskSkin);

    StringView colorLabel = s_VertexRefColorName;
    if(preserveIndices)
        colorLabel = s_MeshColorsFieldNameView;
    if(
        !CheckCanonicalStream(positionResult.ok, s_VertexRefPositionName)
        || !CheckCanonicalStream(normalResult.ok, s_VertexRefNormalName)
        || !CheckCanonicalStream(tangentResult.ok, s_VertexRefTangentName)
        || !CheckCanonicalStream(uv0Result.ok, s_MeshUv0FieldNameView)
        || !CheckCanonicalStream(colorResult.ok, colorLabel)
        || !CheckCanonicalStream(skinResult.ok, s_SkinStreamLabel)
    )
        return MakeUnexpected(Failure());

    if(!RemapSourceVertexRefs(
        positionResult.remap,
        normalResult.remap,
        tangentResult.remap,
        uv0Result.remap,
        colorResult.remap,
        skinResult.remap,
        inOutVertexRefs
    ))
        return MakeUnexpected(Failure());

    const usize afterPositions = TakeCanonicalStream<Vec3>(positionResult, out.positions, out.compactedPositions);
    const usize afterNormals = TakeCanonicalStream<Vec3>(normalResult, out.normals, out.compactedNormals);
    const usize afterTangents = TakeCanonicalStream<Vec4>(tangentResult, out.tangents, out.compactedTangents);
    const usize afterUv0 = TakeCanonicalStream<Vec2>(uv0Result, out.uv0, out.compactedUv0);
    const usize afterColors = TakeCanonicalStream<Vec4>(colorResult, out.colors, out.compactedColors);
    const usize afterSkin = TakeCanonicalStream<MeshSkinInfluence>(skinResult, out.skin, out.compactedSkin);

    out.report.after = MakeSourceMeshStreamCounts(
        afterPositions,
        afterNormals,
        afterTangents,
        afterUv0,
        afterColors,
        afterSkin,
        inOutVertexRefs.size(),
        indexCount
    );
    return out;
}

void ApplyCanonicalizedStreams(in CanonicalizeMeshStreamsResult canonical, mut SourceMeshStreams mesh){
    if(canonical.compactedPositions)
        mesh.positions = canonical.positions;
    if(canonical.compactedNormals)
        mesh.normals = canonical.normals;
    if(canonical.compactedTangents)
        mesh.tangents = canonical.tangents;
    if(canonical.compactedUv0)
        mesh.uv0 = canonical.uv0;
    if(canonical.compactedColors)
        mesh.colors = canonical.colors;
    if(canonical.compactedSkin)
        mesh.skin = canonical.skin;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

