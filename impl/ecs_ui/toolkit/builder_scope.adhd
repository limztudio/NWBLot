[friend(Builder, ListLayoutPreparer)]
class BuilderScopeFrame : NoCopy{
    private Optional<mut BuilderScopeFrame> m_parent;
    private Optional<mut PopupState> m_popupState;
    private PopupToken m_popupToken;
    private PopupOptions m_popupOptions;
    private PopupPlacement m_popupPlacement;
    private WidgetStyle m_panelStyle;
    private PopupStyle m_popupPaintStyle;
    private LayoutTree m_layout;
    private Vector<BuilderItem> m_items;
    private Vector<BuilderEditBoxFrame> m_editBoxes;
    private Vector<BuilderTextAreaFrame> m_textAreas;
    private Vector<BuilderIntegerEditFrame> m_integerEdits;
    private Vector<BuilderFloatEditFrame> m_floatEdits;
    private Vector<BuilderListFrame> m_lists;
    private Vector<RadioGroupFrame> m_radioGroups;
    private Vector<SliderFrame> m_sliders;
    private Vector<ProgressFrame> m_progress;
    private Vector<ImageFrame> m_images;
    private Vector<BuilderComboFrame> m_combos;
    private Vector<BuilderItem> m_comboEditors;
    private Vector<BuilderTooltipFrame> m_tooltips;
    private Vector<BuilderContextMenuFrame> m_contextMenus;
    private Vector<BuilderScrollAreaFrame> m_scrollAreas;
    private Vector<BuilderTabBarFrame> m_tabBars;
    private Vector<BuilderSplitterFrame> m_splitters;
    private Vector<BuilderSpinBoxFrame> m_spinBoxes;
    private Vector<BuilderTreeFrame> m_treeViews;
    private Vector<BuilderTableFrame> m_dataTables;
    private Vector<BuilderMenuBarFrame> m_menuBars;
    private Vector<BuilderToastFrame> m_toasts;
    private Vector<BuilderColorPickerFrame> m_colorPickers;
    private Vector<BuilderDragSourceFrame> m_dragSources;
    private Vector<BuilderDropTargetFrame> m_dropTargets;
    private Vector<BuilderHyperlinkFrame> m_hyperlinks;
    private Vector<BuilderRichTextFrame> m_richTexts;
    private Vector<BuilderPlotFrame> m_plots;
    private Vector<BuilderCanvasFrame> m_canvases;
    private Vector<BuilderDockSpaceFrame> m_dockSpaces;
    private Vector<u32> m_dockSpaceStack;
    private Vector<u32> m_stack;
    private Vector<u32> m_scrollAreaStack;
    private Vector<BuilderScopeKind> m_scopeKinds;
    private Vector<u32> m_virtualListStack;
    private Vector<u32> m_splitterStack;
    private Vector<u32> m_zNodeBeginItem;
    private Vector<u32> m_zNodeEndItem;
    private Vector<BuilderZTraversalEntry> m_zTraversalStack;
    private Vector<u32> m_zChildScratch;
    private Vector<AccessibleOverride> m_accessibleOverrides;
    private Vector<BuilderFocusScopeEntry> m_focusScopeStack;
    private BuilderWindowFrame m_window;
    private WidgetState m_panelState;
    private Rect m_bounds;
    private b8 m_popupVisible = false;
    private b8 m_panelActive = false;
    private b8 m_windowActive = false;
    private b8 m_hasNonZeroZIndex = false;

    [cpp_unwind]
    public BuilderScopeFrame(){
        this.m_items.reserve(cast<usize>(s_LayoutInitialReserve));
        this.m_radioGroups.reserve(s_WidgetFrameReserve);
        this.m_sliders.reserve(s_WidgetFrameReserve);
        this.m_stack.reserve(s_ContextMaxScopeDepth);
        this.m_scrollAreaStack.reserve(s_ContextMaxScopeDepth);
        this.m_scopeKinds.reserve(s_ContextMaxScopeDepth);
        this.m_virtualListStack.reserve(s_ContextMaxScopeDepth);
        this.m_splitterStack.reserve(s_ContextMaxScopeDepth);
    }

    private b8 popupVisible()const{
        return this.m_popupState.has_value() && this.m_popupState.value().isOpen()
            && this.m_popupState.value().instanceGeneration() == this.m_popupToken.instanceGeneration
            && this.m_popupState.value().openGeneration() == this.m_popupToken.openGeneration;
    }

    private b8 popupAncestorsVisible(in Context context)const{
        if(context.failed())
            return false;
        if(this.m_popupState.has_value() && !this.popupVisible())
            return false;
        auto frame = this.m_parent;
        while(frame.has_value()){
            if(frame.value().m_popupState.has_value() && !frame.value().popupVisible())
                return false;
            frame = frame.value().m_parent;
        }
        return true;
    }

    private b8 listStateMatches(in Context context, in BuilderListFrame frame)const{
        return this.popupAncestorsVisible(context) && frame.state.has_value()
            && frame.state.value().inputGeneration() == frame.token.instanceGeneration;
    }

    [cpp_unwind]
    private b8 listMatches(in Context context, in BuilderListFrame frame)const{
        return frame.source.has_value() && this.listStateMatches(context, frame)
            && frame.source.value().instanceGeneration() == frame.token.contentGeneration && this.listStateMatches(context, frame)
            && frame.source.value().revision() == frame.token.contentRevision && this.listStateMatches(context, frame)
            && frame.source.value().rowCount() == frame.rowCount && this.listStateMatches(context, frame)
            && (!frame.rowHeights.has_value() || !frame.measureKey.variableRowHeights || (frame.rowHeights.value().rowHeightRevision() == frame.measureKey.rowHeightRevision && this.listStateMatches(context, frame)));
    }

    private b8 treeStateMatches(in Context context, in BuilderTreeFrame frame)const{
        return this.popupAncestorsVisible(context) && frame.state.has_value()
            && frame.state.value().inputGeneration() == frame.token.instanceGeneration;
    }

    [cpp_unwind]
    private b8 treeMatches(in Context context, in BuilderTreeFrame frame)const{
        return frame.source.has_value() && this.treeStateMatches(context, frame)
            && frame.source.value().instanceGeneration() == frame.token.contentGeneration && this.treeStateMatches(context, frame)
            && frame.source.value().revision() == frame.token.contentRevision && this.treeStateMatches(context, frame)
            && frame.state.value().visibleCount() == frame.visibleCount;
    }

    private b8 tableStateMatches(in Context context, in BuilderTableFrame frame)const{
        return this.popupAncestorsVisible(context) && frame.state.has_value()
            && frame.state.value().inputGeneration() == frame.token.instanceGeneration;
    }

    [cpp_unwind]
    private b8 tableMatches(in Context context, in BuilderTableFrame frame)const{
        return frame.source.has_value() && this.tableStateMatches(context, frame)
            && frame.source.value().instanceGeneration() == frame.token.contentGeneration && this.tableStateMatches(context, frame)
            && frame.source.value().revision() == frame.token.contentRevision && this.tableStateMatches(context, frame)
            && frame.source.value().rowCount() == frame.rowCount && this.tableStateMatches(context, frame);
    }

    private void reset(){
        this.m_panelActive = false;
        this.m_windowActive = false;
        this.m_window.state.reset();
        this.m_parent.reset();
        this.m_popupState.reset();
        this.m_popupToken = PopupToken();
        this.m_popupVisible = false;
        this.m_items.clear();
        this.m_editBoxes.clear();
        this.m_textAreas.clear();
        this.m_integerEdits.clear();
        this.m_floatEdits.clear();
        this.m_lists.clear();
        this.m_radioGroups.clear();
        this.m_sliders.clear();
        this.m_progress.clear();
        this.m_images.clear();
        this.m_combos.clear();
        this.m_comboEditors.clear();
        this.m_tooltips.clear();
        this.m_contextMenus.clear();
        this.m_scrollAreas.clear();
        this.m_tabBars.clear();
        this.m_splitters.clear();
        this.m_spinBoxes.clear();
        this.m_treeViews.clear();
        this.m_dataTables.clear();
        this.m_menuBars.clear();
        this.m_toasts.clear();
        this.m_colorPickers.clear();
        this.m_dragSources.clear();
        this.m_dropTargets.clear();
        this.m_hyperlinks.clear();
        this.m_richTexts.clear();
        this.m_plots.clear();
        this.m_canvases.clear();
        this.m_dockSpaces.clear();
        this.m_dockSpaceStack.clear();
        this.m_stack.clear();
        this.m_scrollAreaStack.clear();
        this.m_scopeKinds.clear();
        this.m_virtualListStack.clear();
        this.m_splitterStack.clear();
        this.m_zNodeBeginItem.clear();
        this.m_zNodeEndItem.clear();
        this.m_zTraversalStack.clear();
        this.m_zChildScratch.clear();
        this.m_accessibleOverrides.clear();
        this.m_focusScopeStack.clear();
        this.m_hasNonZeroZIndex = false;
        this.m_layout.reset();
    }
