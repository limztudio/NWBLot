void VerifyUiScrollbarLayoutTests_VerticalReservationCanRequireHorizontalBar(){
    const Rect bounds = Rect(0.0f, 0.0f, 100.0f, 100.0f);
    const auto placementResult = CalculateScrollViewportPlacement(bounds, bounds, Insets(), Point(89.0f, 200.0f), 1.0f, Point(), 12.0f, 16.0f);
    ASSERT_TRUE(placementResult.has_value());
    const ScrollViewportPlacement placement = placementResult.value();
    ExpectUiRect(placement.viewport, Rect(0.0f, 0.0f, 88.0f, 88.0f));
    ExpectUiRect(placement.horizontal.track, Rect(0.0f, 88.0f, 88.0f, 12.0f));
    ExpectUiRect(placement.vertical.track, Rect(88.0f, 0.0f, 12.0f, 88.0f));
    ExpectUiRect(placement.corner, Rect(88.0f, 88.0f, 12.0f, 12.0f));
    EXPECT_TRUE(placement.horizontal.visible);
    EXPECT_TRUE(placement.vertical.visible);
    EXPECT_DOUBLE_EQ(placement.horizontal.maximum, 2.0);
    EXPECT_DOUBLE_EQ(placement.vertical.maximum, 112.0);
}

void VerifyUiScrollbarLayoutTests_HorizontalReservationCanRequireVerticalBar(){
