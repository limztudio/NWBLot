// GI comparison material: diffuse only, so black occluders stay black and white receivers reveal colored bounce.
half3 NWB_DEFERRED_BXDF_FUNCTION(NwbBxdfSurface surface, int2 pixel){
    const float3 normalVector = nwbSafeNormalize(surface.normal, float3(0.0, 1.0, 0.0));
    half3 litColor = surface.baseColor * surface.indirectIrradiance;

    const uint lightCount = nwbSceneLightCount();
    for(uint i = 0u; i < lightCount; ++i){
        float3 lightVector;
        half3 lightRadiance;
        nwbSceneResolveLight(g_NwbSceneLights[i], surface.worldPosition, lightVector, lightRadiance);
        const half ndotl = half(max(dot(normalVector, lightVector), 0.0));
        const half3 transmittance = nwbBxdfLightTransmittance(pixel, i);
        litColor += surface.baseColor * transmittance * lightRadiance * ndotl;
    }

    litColor += nwbBxdfCausticIrradiance(pixel) * surface.baseColor;
    return nwbBxdfRequiresLinearOutput()
        ? max(litColor, half3(0.0h))
        : litColor / (litColor + half3(0.65h))
    ;
}


