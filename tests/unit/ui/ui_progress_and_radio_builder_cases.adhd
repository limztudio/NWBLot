void VerifyUiProgressLayoutTests_LogicalRegionMinimumsCanExceedSliceBordersWithoutDensityScaling(){
    UiSkinRegion track = MakeUiProgressNineSliceRegion();
    UiSkinRegion fill = MakeUiProgressNineSliceRegion();
    track.minimumWidth = 80.0f;
    track.minimumHeight = 60.0f;
    fill.minimumWidth = 30.0f;
    fill.minimumHeight = 20.0f;
    const auto metrics = MeasureProgress(ProgressOptions(), ProgressStyle(), track, fill, 4.0f);
    ASSERT_TRUE(metrics.has_value());
    ExpectUiProgressPointExact(metrics.value().fillMinimum, MakeUiProgressPoint(30.0f, 20.0f));
    ExpectUiProgressPointExact(metrics.value().contentSize, MakeUiProgressPoint(80.0f, 60.0f));
}

void VerifyUiProgressLayoutTests_FillMetadataPaddingDoesNotInsetTheProgressAmountTwice(){
    const UiSkinRegion track = MakeUiProgressNineSliceRegion();
    UiSkinRegion fill = MakeUiProgressNineSliceRegion();
    fill.padding.left = 100.0f;
    fill.padding.top = 200.0f;
    fill.padding.right = 300.0f;
    fill.padding.bottom = 400.0f;
    const auto metrics = MeasureProgress(ProgressOptions(), ProgressStyle(), track, fill, 1.0f);
    ASSERT_TRUE(metrics.has_value());
    ExpectUiProgressPaddingExact(metrics.value().padding, MakeUiProgressInsets(8.0f, 8.0f, 8.0f, 8.0f));
    ExpectUiProgressPointExact(metrics.value().contentSize, MakeUiProgressPoint(28.0f, 32.0f));
}

void VerifyUiProgressLayoutTests_ZeroSkipsFillAndFullCopiesTheExactContentEndpoints(){
    const UiSkinRegion region = MakeUiProgressNineSliceRegion();
    const auto metrics = MeasureProgress(ProgressOptions(), ProgressStyle(), region, region, 1.0f);
    ASSERT_TRUE(metrics.has_value());
    const Rect bounds = MakeUiProgressRect(10.0f, 20.0f, 200.0f, 32.0f);
    const auto zero = PlaceProgress(bounds, bounds, metrics.value(), 0.0);
    ASSERT_TRUE(zero.has_value());
    const auto full = PlaceProgress(bounds, bounds, metrics.value(), 1.0);
    ASSERT_TRUE(full.has_value());
    ExpectUiRectExact(zero.value().fillReveal, MakeUiProgressRect(18.0f, 28.0f, 0.0f, 16.0f));
    ExpectUiRectExact(zero.value().fillCanvas, zero.value().fillReveal);
    ExpectUiRectExact(full.value().fillReveal, full.value().content);
    ExpectUiRectExact(full.value().fillCanvas, full.value().content);
    const f32 fillEnd = full.value().fillReveal.x + full.value().fillReveal.width;
    const f32 contentEnd = full.value().content.x + full.value().content.width;
    EXPECT_EQ(bit_cast<u32>(fillEnd), bit_cast<u32>(contentEnd));
}

void VerifyUiProgressLayoutTests_FiniteFractionsOutsideTheUnitIntervalClampVisually(){
    const UiSkinRegion region = MakeUiProgressNineSliceRegion();
    const auto metrics = MeasureProgress(ProgressOptions(), ProgressStyle(), region, region, 1.0f);
    ASSERT_TRUE(metrics.has_value());
    const Rect bounds = MakeUiProgressRect(10.0f, 20.0f, 200.0f, 32.0f);
    Array<f64, 4u> fractions = Array<f64, 4u>();
    fractions[0u] = -f64.max;
    fractions[1u] = -0.1;
    fractions[2u] = 1.1;
    fractions[3u] = f64.max;
    for(in f64 fraction : fractions){
        const auto placement = PlaceProgress(bounds, bounds, metrics.value(), fraction);
        ASSERT_TRUE(placement.has_value());
        if(fraction < 0.0){
            EXPECT_FLOAT_EQ(placement.value().fillReveal.width, 0.0f);
            EXPECT_FLOAT_EQ(placement.value().fillCanvas.width, 0.0f);
        }
        else{
            ExpectUiRectExact(placement.value().fillReveal, placement.value().content);
            ExpectUiRectExact(placement.value().fillCanvas, placement.value().content);
        }
    }
}

void VerifyUiProgressLayoutTests_SmallFractionsRevealOnlyPartOfAMinimumSizedSkinCanvas(){
    const UiSkinRegion region = MakeUiProgressNineSliceRegion();
    const auto metrics = MeasureProgress(ProgressOptions(), ProgressStyle(), region, region, 1.0f);
    ASSERT_TRUE(metrics.has_value());
    const Rect bounds = MakeUiProgressRect(10.0f, 20.0f, 200.0f, 32.0f);
    const auto placement = PlaceProgress(bounds, bounds, metrics.value(), 0.01);
    ASSERT_TRUE(placement.has_value());
    EXPECT_FLOAT_EQ(placement.value().fillReveal.width, 1.84f);
    ExpectUiRectExact(placement.value().fillCanvas, MakeUiProgressRect(18.0f, 28.0f, 12.0f, 16.0f));
    EXPECT_GT(placement.value().fillCanvas.width, placement.value().fillReveal.width);
    EXPECT_LT(placement.value().fillCanvas.width, placement.value().content.width);
}

void VerifyUiProgressLayoutTests_AMinimumCanvasNeverExtendsPastContentNarrowerThanTheSkinMinimum(){
    const UiSkinRegion region = MakeUiProgressNineSliceRegion();
    const auto metrics = MeasureProgress(ProgressOptions(), ProgressStyle(), region, region, 1.0f);
    ASSERT_TRUE(metrics.has_value());
    const Rect bounds = MakeUiProgressRect(10.0f, 20.0f, 20.0f, 32.0f);
    const auto placement = PlaceProgress(bounds, bounds, metrics.value(), 0.5);
    ASSERT_TRUE(placement.has_value());
    ExpectUiRectExact(placement.value().content, MakeUiProgressRect(18.0f, 28.0f, 4.0f, 16.0f));
    ExpectUiRectExact(placement.value().fillReveal, MakeUiProgressRect(18.0f, 28.0f, 2.0f, 16.0f));
    ExpectUiRectExact(placement.value().fillCanvas, placement.value().content);
}

void VerifyUiProgressLayoutTests_ClippingChangesVisibilityWithoutChangingTheProgressAmountOrCanvas(){
    const UiSkinRegion region = MakeUiProgressNineSliceRegion();
    const auto metrics = MeasureProgress(ProgressOptions(), ProgressStyle(), region, region, 1.0f);
    ASSERT_TRUE(metrics.has_value());
    const Rect bounds = MakeUiProgressRect(10.0f, 20.0f, 200.0f, 32.0f);
    const auto full = PlaceProgress(bounds, bounds, metrics.value(), 0.25);
    ASSERT_TRUE(full.has_value());
    const auto clipped = PlaceProgress(bounds, MakeUiProgressRect(40.0f, 24.0f, 60.0f, 12.0f), metrics.value(), 0.25);
    ASSERT_TRUE(clipped.has_value());
    ExpectUiRectExact(clipped.value().clip, MakeUiProgressRect(40.0f, 24.0f, 60.0f, 12.0f));
    ExpectUiRectExact(clipped.value().content, full.value().content);
    ExpectUiRectExact(clipped.value().fillReveal, full.value().fillReveal);
    ExpectUiRectExact(clipped.value().fillCanvas, full.value().fillCanvas);
}

void VerifyUiProgressLayoutTests_ACompletelyDisjointClipProducesValidEmptyVisibility(){
    const UiSkinRegion region = MakeUiProgressNineSliceRegion();
    const auto metrics = MeasureProgress(ProgressOptions(), ProgressStyle(), region, region, 1.0f);
    ASSERT_TRUE(metrics.has_value());
    const Rect bounds = MakeUiProgressRect(10.0f, 20.0f, 200.0f, 32.0f);
    const auto placement = PlaceProgress(bounds, MakeUiProgressRect(300.0f, 20.0f, 10.0f, 10.0f), metrics.value(), 0.5);
    ASSERT_TRUE(placement.has_value());
    EXPECT_FLOAT_EQ(placement.value().clip.width, 0.0f);
    EXPECT_FLOAT_EQ(placement.value().fillReveal.width, 92.0f);
    EXPECT_FLOAT_EQ(placement.value().fillCanvas.width, 92.0f);
}

void VerifyUiProgressLayoutTests_TinyAndEmptyAreasBoundPaddingWithoutNegativeContent(){
    const UiSkinRegion region = MakeUiProgressNineSliceRegion();
    const auto metrics = MeasureProgress(ProgressOptions(), ProgressStyle(), region, region, 1.0f);
    ASSERT_TRUE(metrics.has_value());
    Array<Rect, 2u> areas = Array<Rect, 2u>();
    areas[0u] = MakeUiProgressRect(10.0f, 20.0f, 4.0f, 3.0f);
    areas[1u] = MakeUiProgressRect(10.0f, 20.0f, 0.0f, 0.0f);
    for(in Rect bounds : areas){
        const auto placement = PlaceProgress(bounds, bounds, metrics.value(), 0.5);
        ASSERT_TRUE(placement.has_value());
        EXPECT_FLOAT_EQ(placement.value().content.width, 0.0f);
        EXPECT_FLOAT_EQ(placement.value().content.height, 0.0f);
        EXPECT_FLOAT_EQ(placement.value().fillReveal.width, 0.0f);
        EXPECT_FLOAT_EQ(placement.value().fillCanvas.width, 0.0f);
        EXPECT_LE(placement.value().content.x, bounds.x + bounds.width);
        EXPECT_LE(placement.value().content.y, bounds.y + bounds.height);
    }
}

void VerifyUiProgressLayoutTests_PositiveSubnormalAndUnrepresentableRevealEdgesRemainValidEmptyFill(){
    const UiSkinRegion region = MakeUiProgressNineSliceRegion();
    const auto metrics = MeasureProgress(ProgressOptions(), ProgressStyle(), region, region, 1.0f);
    ASSERT_TRUE(metrics.has_value());
    const Rect bounds = MakeUiProgressRect(10.0f, 20.0f, 200.0f, 32.0f);
    Array<f64, 2u> fractions = Array<f64, 2u>();
    fractions[0u] = bit_cast<f64>(cast<u64>(1u));
    fractions[1u] = 1.0e-15;
    for(in f64 fraction : fractions){
        const auto placement = PlaceProgress(bounds, bounds, metrics.value(), fraction);
        ASSERT_TRUE(placement.has_value());
        EXPECT_FLOAT_EQ(placement.value().fillReveal.width, 0.0f);
        EXPECT_FLOAT_EQ(placement.value().fillCanvas.width, 0.0f);
        ExpectUiRectExact(placement.value().content, MakeUiProgressRect(18.0f, 28.0f, 184.0f, 16.0f));
    }
}

void VerifyUiProgressLayoutTests_RepresentableFloatSubnormalRevealIsPreservedAtTheOrigin(){
    ProgressMetrics metrics = ProgressMetrics();
    metrics.contentSize = MakeUiProgressPoint(1.0f, 1.0f);
    const Rect bounds = MakeUiProgressRect(0.0f, 0.0f, 1.0f, 1.0f);
    const f32 leastPositive = bit_cast<f32>(1u);
    const auto placement = PlaceProgress(bounds, bounds, metrics, cast<f64>(leastPositive));
    ASSERT_TRUE(placement.has_value());
    EXPECT_EQ(bit_cast<u32>(placement.value().fillReveal.width), 1u);
    ExpectUiRectExact(placement.value().fillCanvas, placement.value().fillReveal);
}

void VerifyUiProgressLayoutTests_ZeroIntrinsicMetricsAndEmptyBoundsAreValid(){
    UiSkinRegion region = UiSkinRegion();
    region.rectangle.width = 1u;
    region.rectangle.height = 1u;
    ProgressOptions options = ProgressOptions();
    options.height = 0.0f;
    const auto metrics = MeasureProgress(options, ProgressStyle(), region, region, 1.0f);
    ASSERT_TRUE(metrics.has_value());
    ExpectUiProgressPointExact(metrics.value().contentSize, Point());
    const auto placement = PlaceProgress(Rect(), Rect(), metrics.value(), 1.0);
    ASSERT_TRUE(placement.has_value());
    ExpectUiRectExact(placement.value().content, Rect());
    ExpectUiRectExact(placement.value().fillReveal, Rect());
    ExpectUiRectExact(placement.value().fillCanvas, Rect());
}

void VerifyUiProgressLayoutTests_InvalidOptionsPaddingAndTintsRejectMetrics(){
    const UiSkinRegion region = MakeUiProgressNineSliceRegion();
    for(u32 field = 0u; field < 14u; ++field){
        ProgressOptions options = ProgressOptions();
        ProgressStyle style = ProgressStyle();
        switch(field){
        case 0u:
            options.width.policy = cast<LayoutSizePolicyEnum>(3u);
            break;
        case 1u:
            options.width.value = 0.0f;
            break;
        case 2u:
            options.width.value = -1.0f;
            break;
        case 3u:
            options.width.value = bit_cast<f32>(0x7f800000u);
            break;
        case 4u:
            options.height = -1.0f;
            break;
        case 5u:
            options.height = bit_cast<f32>(0x7fc00000u);
            break;
        case 6u:
            style.padding.left = -1.0f;
            break;
        case 7u:
            style.padding.bottom = bit_cast<f32>(0x7f800000u);
            break;
        case 8u:
            style.trackTint.r = -1.0f;
            break;
        case 9u:
            style.trackTint.a = 1.01f;
            break;
        case 10u:
            style.fillTint.g = bit_cast<f32>(0x7fc00000u);
            break;
        case 11u:
            style.fillTint.a = -0.01f;
            break;
        case 12u:
            style.fillTint.b = bit_cast<f32>(0x7f800000u);
            break;
        default:
            style.trackTint.a = bit_cast<f32>(0x7fc00000u);
            break;
        }
        EXPECT_FALSE(MeasureProgress(options, style, region, region, 1.0f).has_value());
    }
}

void VerifyUiProgressLayoutTests_InvalidRegionMetricsSlicesModesAndDensityRejectMetrics(){
    const UiSkinRegion valid = MakeUiProgressNineSliceRegion();
    for(u32 field = 0u; field < 17u; ++field){
        UiSkinRegion track = valid;
        UiSkinRegion fill = valid;
        f32 density = 1.0f;
        switch(field){
        case 0u:
            density = 0.0f;
            break;
        case 1u:
            density = -1.0f;
            break;
        case 2u:
            density = bit_cast<f32>(0x7f800000u);
            break;
        case 3u:
            density = bit_cast<f32>(0x7fc00000u);
            break;
        case 4u:
            track.minimumWidth = -1.0f;
            break;
        case 5u:
            fill.minimumHeight = bit_cast<f32>(0x7fc00000u);
            break;
        case 6u:
            track.padding.left = -1.0f;
            break;
        case 7u:
            fill.padding.right = bit_cast<f32>(0x7f800000u);
            break;
        case 8u:
            track.rectangle.width = 0u;
            break;
        case 9u:
            fill.rectangle.height = 0u;
            break;
        case 10u:
            track.sliceInsets.left = 25u;
            break;
        case 11u:
            fill.sliceInsets.bottom = 25u;
            break;
        case 12u:
            track.drawMode = cast<UiSkinDrawModeEnum>(2u);
            break;
        case 13u:
            fill.drawMode = UiSkinDrawMode::Sprite;
            break;
        case 14u:
            fill.padding.left = f32.max;
            fill.padding.right = f32.max;
            break;
        case 15u:
            fill.padding.top = f32.max;
            fill.padding.bottom = f32.max;
            break;
        default:
            fill.minimumWidth = bit_cast<f32>(0x7f800000u);
            break;
        }
        EXPECT_FALSE(MeasureProgress(ProgressOptions(), ProgressStyle(), track, fill, density).has_value());
    }
}

void VerifyUiProgressLayoutTests_OverflowingLogicalSumsAndDensityScaledBordersRejectMetrics(){
    const UiSkinRegion valid = MakeUiProgressNineSliceRegion();
    for(u32 field = 0u; field < 4u; ++field){
        UiSkinRegion region = valid;
        ProgressStyle style = ProgressStyle();
        f32 density = 1.0f;
        switch(field){
        case 0u:
            style.padding.left = f32.max;
            style.padding.right = f32.max;
            break;
        case 1u:
            region.minimumWidth = f32.max;
            region.padding.left = f32.max;
            break;
        case 2u:
            density = bit_cast<f32>(1u);
            break;
        default:
            region.rectangle.width = u32.max;
            region.sliceInsets.left = u32.max;
            region.sliceInsets.right = u32.max;
            break;
        }
        EXPECT_FALSE(MeasureProgress(ProgressOptions(), style, region, region, density).has_value());
    }
}

void VerifyUiProgressLayoutTests_InvalidProspectiveRectanglesMetricsAndFractionsRejectPlacement(){
    const UiSkinRegion region = MakeUiProgressNineSliceRegion();
    const auto metrics = MeasureProgress(ProgressOptions(), ProgressStyle(), region, region, 1.0f);
    ASSERT_TRUE(metrics.has_value());
    const Rect normal = MakeUiProgressRect(10.0f, 20.0f, 200.0f, 32.0f);
    for(u32 field = 0u; field < 13u; ++field){
        Rect bounds = normal;
        Rect clip = normal;
        ProgressMetrics invalid = metrics.value();
        f64 fraction = 0.5;
        switch(field){
        case 0u:
            bounds.x = bit_cast<f32>(0x7fc00000u);
            break;
        case 1u:
            bounds.width = -1.0f;
            break;
        case 2u:
            bounds.height = bit_cast<f32>(0x7f800000u);
            break;
        case 3u:
            clip.y = bit_cast<f32>(0x7f800000u);
            break;
        case 4u:
            clip.height = -1.0f;
            break;
        case 5u:
            invalid.padding.top = -1.0f;
            break;
        case 6u:
            invalid.fillMinimum.x = -1.0f;
            break;
        case 7u:
            invalid.fillMinimum.y = bit_cast<f32>(0x7fc00000u);
            break;
        case 8u:
            invalid.contentSize.x = 1.0f;
            break;
        case 9u:
            invalid.contentSize.y = bit_cast<f32>(0x7f800000u);
            break;
        case 10u:
            fraction = bit_cast<f64>(cast<u64>(0x7ff0000000000000u));
            break;
        case 11u:
            fraction = bit_cast<f64>(cast<u64>(0xfff0000000000000u));
            break;
        default:
            fraction = bit_cast<f64>(cast<u64>(0x7ff8000000000000u));
            break;
        }
        EXPECT_FALSE(PlaceProgress(bounds, clip, invalid, fraction).has_value());
    }
}

void VerifyUiProgressLayoutTests_FiniteExtremeCoordinatesRetainValidExactFullEndpoints(){
    ProgressMetrics metrics = ProgressMetrics();
    metrics.contentSize = MakeUiProgressPoint(f32.max, 32.0f);
    const Rect bounds = MakeUiProgressRect(-f32.max, 0.0f, f32.max, 32.0f);
    auto placement = PlaceProgress(bounds, bounds, metrics, 1.0);
    ASSERT_TRUE(placement.has_value());
    ExpectUiRectExact(placement.value().content, bounds);
    ExpectUiRectExact(placement.value().fillReveal, bounds);
    ExpectUiRectExact(placement.value().fillCanvas, bounds);
    placement = PlaceProgress(bounds, bounds, metrics, 0.5);
    ASSERT_TRUE(placement.has_value());
    EXPECT_FLOAT_EQ(placement.value().fillReveal.width, f32.max * 0.5f);
    EXPECT_FLOAT_EQ(placement.value().fillReveal.x, -f32.max);
}

void VerifyUiProgressLayoutTests_OverflowingAndCollapsedPositiveInputEndpointsRejectPlacement(){
    ProgressMetrics metrics = ProgressMetrics();
    metrics.contentSize = MakeUiProgressPoint(1.0f, 1.0f);
    const Rect normal = MakeUiProgressRect(0.0f, 0.0f, 20.0f, 10.0f);
    Array<Rect, 3u> invalidRects = Array<Rect, 3u>();
    invalidRects[0u] = MakeUiProgressRect(f32.max, 0.0f, f32.max, 1.0f);
    invalidRects[1u] = MakeUiProgressRect(f32.max, 0.0f, 1.0f, 1.0f);
    invalidRects[2u] = MakeUiProgressRect(0.0f, f32.max, 1.0f, 1.0f);
    for(in Rect invalid : invalidRects){
        EXPECT_FALSE(PlaceProgress(invalid, normal, metrics, 0.5).has_value());
        EXPECT_FALSE(PlaceProgress(normal, invalid, metrics, 0.5).has_value());
    }
}


