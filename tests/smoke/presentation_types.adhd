// Track frame intervals and count idle stalls of 50ms or more once per gap.
class PresentationPacingSample{
    public f64 wallMsPerPresentation;

    public PresentationPacingSample(){
        this.wallMsPerPresentation = 0.0;
    }

    public PresentationPacingSample(in f64 wallMs){
        this.wallMsPerPresentation = wallMs;
    }
}

class PresentationPacingSummary{
    public usize samples = 0u;
    public f64 p50Ms = 0.0;
    public f64 p95Ms = 0.0;
    public f64 maxMs = 0.0;
    public u64 stallsOver50Ms = 0u;
}

enum<u8> PresentationFpsStatus{
    Waiting,
    Interval,
    Complete,
    Invalid
}

class PresentationFpsSample{
    public u64 firstPresentationCount = 0u;
    public u64 lastPresentationCount = 0u;
    public f64 wallSeconds = 0.0;

    public u64 presentations()const{
        return this.lastPresentationCount - this.firstPresentationCount;
    }

    public f64 averageFps()const{
        if(this.wallSeconds > 0.0)
            return cast<f64>(this.presentations()) / this.wallSeconds;
        return 0.0;
    }
}



class GpuPassTimingScopeAccum{
    public f64 sumSeconds = 0.0;
    public f64 minSeconds = 0.0;
    public f64 maxSeconds = 0.0;
    public u64 samples = 0u;
    public u32 frames = 0u;
}


class RendererGatherBenchmarkSceneCounts{
    public u32 renderers = 0u;
    public u32 runtimeRenderers = 0u;
    public u32 runtimeOwners = 0u;
    public u32 transparentRenderers = 0u;
}


