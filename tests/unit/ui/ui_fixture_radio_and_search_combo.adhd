UiFixtureSearchFilterMode ResolveSearchFilterMode(in AStringView query, in AStringView secondHalfQuery, in AStringView emptyResultQuery){
    if(query == secondHalfQuery)
        return UiFixtureSearchFilterMode::Second;
    if(query == emptyResultQuery)
        return UiFixtureSearchFilterMode::Empty;
    return UiFixtureSearchFilterMode::All;
}

Expected<u64> FindRadioFixtureIndexOf(in u64 count, in u64 removed, in b8 reverseFlag, in b8 duplicate, in u64 value){
    const u64 activeCount = ComputeRadioFixtureRawCount(count, removed);
    for(u64 cursor = 0u; cursor < activeCount; ++cursor){
        if(value != 0u && ComputeRadioFixtureRawKey(count, removed, reverseFlag, duplicate, cursor) == value)
            return cursor;
    }
    return MakeUnexpected(Failure());
}

Expected<u64> FindRadioFixtureEnabledIndex(in u64 count, in u64 removed, in b8 reverseFlag, in b8 duplicate, in b8 allDisabled, in u64 disabledKey, in u64 start, in b8 backwards){
    const u64 activeCount = ComputeRadioFixtureRawCount(count, removed);
    if(start >= activeCount || allDisabled)
        return MakeUnexpected(Failure());
    u64 cursor = start;
    while(cursor < activeCount){
        if(ComputeRadioFixtureRawKey(count, removed, reverseFlag, duplicate, cursor) != disabledKey)
            return cursor;
        if(backwards){
            if(cursor == 0u)
                break;
            --cursor;
        }
        else
            ++cursor;
    }
    return MakeUnexpected(Failure());
}


