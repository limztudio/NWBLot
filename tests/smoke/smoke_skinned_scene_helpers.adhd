}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SmokeTintedModelEntityResult{
    public EntityID entity = s_InvalidEntityId;
    public b8 tintApplied = false;
}

void AddSmokeSkinnedRenderSystems(mut World world, mut ProjectRuntimeContext context, in SmokeRenderQualitySettings baseSettings){
    const SmokeRenderSystems systems = CreateSmokeRenderSystems(world, context, baseSettings);
    native(in systems, mut world, mut context){
        world.addSystem<Impl::ModelSystem>(world, context.assetManager, Impl::CreateModelObjectRendererHooks());
        auto& meshSkinningSystem = world.addSystem<Impl::MeshSkinningSystem>(world, context.graphics, context.assetManager, systems.mesh, context.shaderPathResolver);

        context.graphics.addRenderPassToBack(meshSkinningSystem);
        context.graphics.addRenderPassToBack(systems.renderer);
        context.frameGraphRegistry.registerContributor(systems.renderer);
    }
}

void AddSmokeSkinnedRenderSystems(mut World world, mut ProjectRuntimeContext context){
    AddSmokeSkinnedRenderSystems(world, context, SmokeRenderQualitySettings());
}

Expected<SkeletonJointMatrixVector> LoadSmokeSkeletonBindJoints(
    in SmokeModelRef modelRef,
    in TStringView projectName,
    in Name preferredSkeletonObject,
    in b8 requireInvertibleBindPose,
    mut GlobalArena arena,
    mut AssetManager assetManager
){
    b8 failedModelLoad = false;
    b8 failedModelType = false;
    b8 failedNoSkeleton = false;
    b8 failedSkeletonLoad = false;
    b8 failedSkeletonType = false;
    b8 failedEmptyJoints = false;
    b8 failedInvalidBindPose = false;
    SkeletonJointMatrixVector bindJoints = SkeletonJointMatrixVector(arena);
    native(
        in modelRef,
        in preferredSkeletonObject,
        in requireInvertibleBindPose,
        mut assetManager,
        mut bindJoints,
        mut failedModelLoad,
        mut failedModelType,
        mut failedNoSkeleton,
        mut failedSkeletonLoad,
        mut failedSkeletonType,
        mut failedEmptyJoints,
        mut failedInvalidBindPose
    ){
        const auto loadedModelAsset = assetManager.loadSync(Impl::Model::AssetTypeName(), modelRef.name());
        if(!loadedModelAsset){
            failedModelLoad = true;
        }
        else{
            NWB_ASSERT(*loadedModelAsset);
            const auto* model = Core::Assets::CastAsset<Impl::Model>(loadedModelAsset->get());
            if(!model){
                failedModelType = true;
            }
            else{
                const Impl::ModelSkeletonObject* skeletonObject = nullptr;
                if(preferredSkeletonObject){
                    for(const Impl::ModelSkeletonObject& object : model->skeletonObjects()){
                        if(object.name == preferredSkeletonObject){
                            skeletonObject = &object;
                            break;
                        }
                    }
                }
                if(!skeletonObject && !model->skeletonObjects().empty())
                    skeletonObject = &model->skeletonObjects().front();
                if(!skeletonObject || !skeletonObject->skeleton.valid()){
                    failedNoSkeleton = true;
                }
                else{
                    const auto loadedSkeletonAsset = assetManager.loadSync(Impl::Skeleton::AssetTypeName(), skeletonObject->skeleton.name());
                    if(!loadedSkeletonAsset){
                        failedSkeletonLoad = true;
                    }
                    else{
                        NWB_ASSERT(*loadedSkeletonAsset);
                        const auto* skeleton = Core::Assets::CastAsset<Impl::Skeleton>(loadedSkeletonAsset->get());
                        if(!skeleton){
                            failedSkeletonType = true;
                        }
                        else if(skeleton->joints().empty()){
                            failedEmptyJoints = true;
                        }
                        else{
                            bindJoints.reserve(skeleton->joints().size());
                            for(const Impl::SkeletonJoint& joint : skeleton->joints()){
                                if(requireInvertibleBindPose && !MatrixIsInvertibleAffine(LoadFloat(joint.localBindPose), Impl::s_SkeletonAffineEpsilon, Impl::s_SkeletonJointDeterminantEpsilon)){
                                    failedInvalidBindPose = true;
                                    break;
                                }
                                bindJoints.push_back(joint.localBindPose);
                            }
                        }
                    }
                }
            }
        }
    }
    if(failedModelLoad){
        error("{}: failed to load model for skeleton bind joints", projectName);
        return MakeUnexpected(Failure());
    }
    if(failedModelType){
        error("{}: loaded model has unexpected type", projectName);
        return MakeUnexpected(Failure());
    }
    if(failedNoSkeleton){
        error("{}: model has no skeleton object", projectName);
        return MakeUnexpected(Failure());
    }
    if(failedSkeletonLoad){
        error("{}: failed to load skeleton for bind joints", projectName);
        return MakeUnexpected(Failure());
    }
    if(failedSkeletonType){
        error("{}: loaded skeleton has unexpected type", projectName);
        return MakeUnexpected(Failure());
    }
    if(failedEmptyJoints){
        error("{}: skeleton has no joints", projectName);
        return MakeUnexpected(Failure());
    }
    if(failedInvalidBindPose){
        error("{}: skeleton contains an invalid bind pose", projectName);
        return MakeUnexpected(Failure());
    }
    return bindJoints;
}

void DestroySmokeSkinnedRenderWorld(mut ProjectRuntimeContext context, mut NotNullUniquePtr<World> world){
    if(!world.owner())
        return;

    native(mut context, mut world){
        Impl::MeshSkinningSystem& meshSkinningSystem = *MakeNotNull(world->getSystem<Impl::MeshSkinningSystem>());
        context.graphics.removeRenderPass(meshSkinningSystem);
        RemoveSmokeRendererSystem(context, *world);
    }
    FinishDestroyingSmokeWorld(context, world);
}

void SyncSmokeModelRuntimes(mut World world){
    native(mut world){
        Impl::ModelSystem& modelSystem = *MakeNotNull(world.getSystem<Impl::ModelSystem>());
        modelSystem.syncModelRuntimes();
    }
}

SmokeTintedModelEntityResult CreateTintedModelEntity(
    in SmokeModelRef model,
    in SmokeMaterialRef material,
    in NameTextAscii materialInterfacePath,
    in VectorSingle colorTint,
    in VectorSingle position,
    in VectorSingle scale,
    mut World world
){
    const SmokeTintedEntitySetup setup = CreateSmokeTintedEntity(material, materialInterfacePath, position, scale, world);
    native(in setup, in model, mut world){
        auto& modelComponent = world.entity(setup.entity).addComponent<Impl::ModelComponent>();
        modelComponent.model = model;
    }
    SmokeTintedModelEntityResult result = SmokeTintedModelEntityResult();
    result.entity = setup.entity;
    result.tintApplied = ApplySmokeMaterialTint(setup, colorTint, "runtime.color_tint", world);
    return result;
}

EntityID FindSpawnedModelObject(in EntityID owner, in Name objectName, in ModelObjectKindEnum objectKind, mut World world){
    EntityID result = s_InvalidEntityId;
    native(in owner, in objectName, in objectKind, mut world, mut result){
        world.view<Impl::ModelObjectComponent>().each([&](const Core::ECS::EntityID entity, Impl::ModelObjectComponent& object)noexcept{
            if(result.valid())
                return;
            if(object.owner == owner && object.object == objectName && object.kind == objectKind)
                result = entity;
        });
    }
    return result;
}

void AnimateSkinningBenchmarkPoses(mut World world, in Span<EntityID> entities, in Span<f32x3x4> bindJoints, in f32 timeSeconds, in b8 staticPreview){
    for(usize entityIndex = 0u; entityIndex < entities.size(); ++entityIndex){
        const EntityID entity = entities[entityIndex];
        const u32 seedIndex = cast<u32>(entityIndex);
        native(mut world, in entity, in bindJoints, in seedIndex, in timeSeconds, in staticPreview){
            if(auto* pose = world.tryGetComponent<NWB::Impl::SkeletonPoseComponent>(entity))
                AnimateSkinningBenchmarkPoseJoints(bindJoints, seedIndex, timeSeconds, staticPreview, pose->localJoints);
        }
    }
}


