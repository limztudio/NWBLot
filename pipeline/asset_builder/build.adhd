#include <pipeline/volume_workspace.adhd>
#include "constants.adhd"
#include "cook_paths.adhd"
#include <pipeline/root_discovery.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace_wrapper NWB_ASSET_BUILDER;

type AssetBuildRoot = PipelineAssetRoot;

class AssetBuildOptions{
    public Path repoRoot;
    public Vector<AssetBuildRoot> assetRoots;
    public Path outputDirectory;
    public CompactString configuration;
    public CompactString assetType = CompactString(s_CookAssetVolumeName);
    public mut CpuTaskScheduler scheduler;
    public Vector<String> inputs;
    public b8 useExplicitInputs = false;

    public AssetBuildOptions(mut CpuTaskScheduler scheduler){ this.scheduler = scheduler; }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StringView SelectEffectiveBuildConfiguration(in StringView canonicalConfiguration){
    if(canonicalConfiguration.empty())
        return s_DefaultPipelineConfig;
    return canonicalConfiguration;
}

b8 ShouldSelectExplicitBuildInputs(in b8 useExplicitInputs, in b8 hasInputs){
    return useExplicitInputs || hasInputs;
}

Optional<usize> TryClampManifestHashReserveCount(in u64 plannedFileCount){
    if(plannedFileCount <= cast<u64>(usize.max))
        return Optional<usize>(cast<usize>(plannedFileCount));
    return Optional<usize>();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ResolveCookPaths(in AssetBuildOptions options, mut CookFileCatalog catalog){
    if(!ValidateAssetBuilderPathInputs(!options.assetRoots.empty(), !options.outputDirectory.empty()))
        return false;
    const auto repo = ResolvePipelineRepoRoot(options.repoRoot, "AssetBuilder");
    if(!repo.has_value())
        return false;
    catalog.setRepoRoot(repo.value());
    catalog.paths.assetRoots.reserve(options.assetRoots.size());
    for(in AssetBuildRoot root : options.assetRoots){
        if(!IsValidAssetBuildVirtualRoot(root.virtualRoot.view(), s_EngineVirtualRoot, s_ProjectVirtualRoot)){
            LogUnsupportedAssetBuildVirtualRoot(PathToString(root.path), root.virtualRoot.view());
            return false;
        }
        const auto absolute = ResolveAbsolutePath(repo.value(), root.path);
        if(!absolute.has_value()){
            LogAssetRootResolveFailure(PathToString(root.path), ErrorCodeMessage(absolute.error()));
            return false;
        }
        catalog.appendRoot(absolute.value(), root.virtualRoot.view());
    }
    const auto output = ResolveAbsolutePath(repo.value(), options.outputDirectory);
    if(!output.has_value()){
        LogOutputDirectoryResolveFailure(PathToString(options.outputDirectory), ErrorCodeMessage(output.error()));
        return false;
    }
    catalog.setOutputDirectory(output.value());
    const Path cache = repo.value() / s_AssetCacheDirectory;
    const auto created = EnsureDirectories(cache);
    if(!created.has_value()){
        LogCacheDirectoryCreateFailure(PathToString(cache), ErrorCodeMessage(created.error()));
        return false;
    }
    catalog.setCacheDirectory(cache);
    return true;
}

b8 SelectBuildInputs(in AssetBuildOptions options, mut CookFileCatalog catalog){
    if(options.inputs.empty()){
        catalog.files.clear();
        return true;
    }
    Vector<u8> selected;
    selected.resize(catalog.files.size(), 0u);
    if(!catalog.selectMask(options.inputs, selected, lambda[](in CookInputSelectionError failure) -> void{ LogCookInputSelectionFailure(failure, "AssetBuilder"); }))
        return false;
    catalog.compact(selected);
    return true;
}

b8 BuildAssets(in AssetBuildOptions options){
    if(!ValidateAssetBuildType(options.assetType.view(), s_CookAssetVolumeName))
        return false;
    AssetCookWorkspace workspace(s_AssetBuilderArena);
    CookFileCatalog catalog(workspace);
    if(!ResolveCookPaths(options, catalog) || !catalog.discover(s_NwbExtension))
        return false;
    if(ShouldSelectExplicitBuildInputs(options.useExplicitInputs, !options.inputs.empty()) && !SelectBuildInputs(options, catalog))
        return false;
    CookVolumePreparation prepare(workspace, catalog);
    if(!prepare.registerEntryTypes() || !prepare.parse(options.scheduler))
        return false;
    const String canonical = BuildCanonicalSafeCacheName(options.configuration.view());
    prepare.setConfiguration(SelectEffectiveBuildConfiguration(canonical));
    u64 seenReserveCount = 0u;
    if(
        !prepare.registerPreparers()
        || !AddPlannedFileCount(cast<u64>(prepare.entryCount()), prepare.plannedFileCount)
        || !AddPlannedFileCount(prepare.plannedFileCount, seenReserveCount)
        || !AddPlannedFileCount(prepare.cachedEntryCount(), seenReserveCount)
    )
        return false;
    CookVolumeManifest manifest(workspace);
    if(!manifest.reserve(prepare.plannedFileCount))
        return false;
    const Optional<usize> reserve = TryClampManifestHashReserveCount(seenReserveCount);
    if(reserve.has_value())
        prepare.reservePaths(reserve.value());
    if(!prepare.seedCachedPaths())
        return false;
    for(usize index = 0u; index < prepare.writerCount(); ++index){
        if(!prepare.writeManifest(index, manifest))
            return false;
    }
    if(!prepare.writeRegistryObjects(options.scheduler, manifest) || !prepare.writeBuiltAssets(catalog.paths.outputDirectory, manifest))
        return false;
    const u64 cachedAssetCount = prepare.cachedEntryCount();
    const u64 totalAssetCount = cast<u64>(manifest.manifest.entries.size()) + cachedAssetCount;
    [essential] info("AssetBuilder: built {} assets ({} cached) into '{}'", totalAssetCount, cachedAssetCount, options.outputDirectory);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

