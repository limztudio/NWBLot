////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SHADOW_LIGHT_SPACE_RECEIVER_PLANE_SLANGI
#define NWB_GRAPHICS_SHADOW_LIGHT_SPACE_RECEIVER_PLANE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#define NWB_LIGHT_SPACE_PLANE_NORMAL_QUANTIZATION_STEPS 1024.0
#define NWB_LIGHT_SPACE_PLANE_ROUNDOFF_EPSILONS 8.0


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


bool nwbLightSpaceIntersectReceiverPlane(
    const NwbLightSpaceView view,
    const uint2 pixel,
    const float3 origin,
    const float3 receiverNormal,
    out float2 outNdc,
    out bool outPoint,
    out float3 outDirection,
    out float3 outRelativeAnchor,
    out float outFootprint,
    out float outNormalError,
    out float outRoundoff,
    out float outDenominator,
    out float outDenominatorError,
    out float outDistance
){
    outNdc = float2((float(pixel.x) + 0.5) * 2.0 / float(view.map.x) - 1.0, 1.0 - (float(pixel.y) + 0.5) * 2.0 / float(view.map.y));
    outPoint = (view.light.w & NWB_LIGHT_SPACE_FLAG_POINT) != 0u;
    outDirection = float3(0.0);
    outRelativeAnchor = float3(0.0);
    outFootprint = 0.0;
    outNormalError = 0.0;
    outRoundoff = 0.0;
    outDenominator = 0.0;
    outDenominatorError = 0.0;
    outDistance = 0.0;
    if(outPoint){
        outDirection = normalize(view.worldToClipRows[3].xyz + view.worldToClipRows[0].xyz * outNdc.x + view.worldToClipRows[1].xyz * outNdc.y);
        outRelativeAnchor = view.originOrDirection.xyz - origin;
    }
    else{
        const float3 xRow = view.worldToClipRows[0].xyz;
        const float3 yRow = view.worldToClipRows[1].xyz;
        const float xScale = dot(xRow, xRow);
        const float yScale = dot(yRow, yRow);
        if(xScale <= 0.0 || yScale <= 0.0 || !isfinite(xScale) || !isfinite(yScale))
            return false;
        outRelativeAnchor = xRow * ((outNdc.x - dot(view.worldToClipRows[0], float4(origin, 1.0))) / xScale) + yRow * ((outNdc.y - dot(view.worldToClipRows[1], float4(origin, 1.0))) / yScale);
        outDirection = -view.originOrDirection.xyz;
        outFootprint = min(2.0 / (sqrt(xScale) * float(view.map.x)), 2.0 / (sqrt(yScale) * float(view.map.y)));
    }
    const float rawNormalError = sqrt(NWB_LIGHT_SPACE_SPATIAL_DIMENSION_COUNT) / NWB_LIGHT_SPACE_PLANE_NORMAL_QUANTIZATION_STEPS;
    outNormalError = 2.0 * rawNormalError / (1.0 - rawNormalError);
    outRoundoff = NWB_LIGHT_SPACE_PLANE_ROUNDOFF_EPSILONS * NWB_FLOAT_EPSILON;
    outDenominator = dot(receiverNormal, outDirection);
    outDenominatorError = outNormalError + outRoundoff;
    if(!all(isfinite(outDirection)) || !all(isfinite(outRelativeAnchor)) || abs(outDenominator) <= outDenominatorError)
        return false;
    outDistance = -dot(receiverNormal, outRelativeAnchor) / outDenominator;
    return isfinite(outDistance) && (!outPoint || outDistance > 0.0);
}

bool nwbLightSpaceReceiverDepth(const NwbLightSpaceView view, const uint2 pixel, const float3 origin, const float3 receiverNormal, const float3 receiverPositionError, out float projectedDepth, out float linearDepth){
    projectedDepth = 0.0;
    linearDepth = 0.0;
    if(!all(isfinite(origin)) || !all(isfinite(receiverNormal)) || any(view.map.xy == 0u))
        return false;
#if NWB_LIGHT_SPACE_CSG_ENABLED
    if(!all(isfinite(receiverPositionError)))
        return false;
#endif
    float2 ndc;
    bool point;
    float3 direction;
    float3 relativeAnchor;
    float footprint;
    float normalError;
    float roundoff;
    float denominator;
    float denominatorError;
    float distance;
    if(!nwbLightSpaceIntersectReceiverPlane(view, pixel, origin, receiverNormal, ndc, point, direction, relativeAnchor, footprint, normalError, roundoff, denominator, denominatorError, distance))
        return false;
    const float3 relativeHit = relativeAnchor + direction * distance;
    const float3 hit = origin + relativeHit;
    if(!all(isfinite(hit)))
        return false;
    if(point)
        footprint = 2.0 * distance / float(max(view.map.x, view.map.y));
#if NWB_LIGHT_SPACE_CSG_ENABLED
    const float3 positionError = receiverPositionError + abs(origin) * roundoff + normalError * NWB_SHADOW_RAY_MIN_DISTANCE;
#else
    const float3 storedPosition = origin - receiverNormal * NWB_SHADOW_RAY_MIN_DISTANCE;
    const float3 positionError = nwbLightSpacePositionQuantization(storedPosition) + abs(origin) * roundoff + normalError * NWB_SHADOW_RAY_MIN_DISTANCE;
#endif
    const float planeError = dot(abs(receiverNormal), positionError) + normalError * length(relativeHit) + roundoff * (length(relativeAnchor) + abs(distance));
    const float depthError = planeError / (abs(denominator) - denominatorError);
    if(!isfinite(depthError) || !isfinite(footprint) || footprint <= 0.0 || depthError > 0.25 * footprint)
        return false;
    const float3 corrected = hit - direction * depthError;
    const float4 clip = nwbLightSpaceProject(view, corrected);
    if(!all(isfinite(clip)) || clip.w <= 0.0)
        return false;
    const float depth = clip.z / clip.w;
    if(!isfinite(depth) || depth <= 0.0)
        return false;
    if(depth > 1.0){
        if((view.light.w & NWB_LIGHT_SPACE_FLAG_FITTED_COVERAGE) == 0u)
            return false;
        projectedDepth = 1.0;
        linearDepth = point ? distance - depthError : nwbLightSpaceLinearDepth(view, corrected);
        return isfinite(linearDepth) && linearDepth >= 0.0;
    }
    projectedDepth = asfloat(asuint(depth) - 1u);
    if(point){
        const float scale = view.depthRange.x * view.depthRange.y;
        const float span = view.depthRange.y - view.depthRange.x;
        const float viewZ = scale / (view.depthRange.y - projectedDepth * span);
        linearDepth = viewZ * sqrt(1.0 + dot(ndc, ndc));
        if(!isfinite(linearDepth) || distance - linearDepth > footprint)
            return false;
    }
    else{
        linearDepth = projectedDepth * view.depthRange.y;
        if(depthError + (depth - projectedDepth) * view.depthRange.y > footprint)
            return false;
    }
    return isfinite(linearDepth) && linearDepth >= 0.0;
}

bool nwbLightSpaceReceiverEstimateDepth(const NwbLightSpaceView view, const uint2 pixel, const float3 origin, const float3 receiverNormal, out float linearDepth){
    linearDepth = 0.0;
    if(!all(isfinite(origin)) || !all(isfinite(receiverNormal)) || any(view.map.xy == 0u))
        return false;
    float2 ndc;
    bool point;
    float3 direction;
    float3 relativeAnchor;
    float footprint;
    float normalError;
    float roundoff;
    float denominator;
    float denominatorError;
    float distance;
    if(!nwbLightSpaceIntersectReceiverPlane(view, pixel, origin, receiverNormal, ndc, point, direction, relativeAnchor, footprint, normalError, roundoff, denominator, denominatorError, distance))
        return false;
    linearDepth = point ? distance : nwbLightSpaceLinearDepth(view, origin) + dot(relativeAnchor + direction * distance, direction);
    if(!isfinite(linearDepth) || linearDepth < 0.0)
        return false;
    const float viewDepth = point ? distance * dot(direction, view.worldToClipRows[3].xyz) : linearDepth;
    if(!isfinite(viewDepth) || viewDepth <= view.depthRange.x)
        return false;
    return (view.light.w & NWB_LIGHT_SPACE_FLAG_FITTED_COVERAGE) != 0u || viewDepth <= view.depthRange.y;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

