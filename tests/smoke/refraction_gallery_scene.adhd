////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RefractionLifecyclePhase{
    public RefractionLifecyclePhase(in AStringView phaseName, in f32 x, in b8 phaseEnabled){
        this.name = phaseName;
        this.glassX = x;
        this.enabled = phaseEnabled;
    }

    public AStringView name;
    public f32 glassX;
    public b8 enabled;
}

b8 ShouldCaptureRefractionQueryDiagnostics(in b8 reported, in u64 graphicsFrame, in u64 sourceFrame){
    return reported && graphicsFrame > sourceFrame;
}


