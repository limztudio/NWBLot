[cpp_header("<core/common/module.h>"), cpp_name("::NWB::Core::Common::Initializer")]
extern class Initializer{
    b8 acquire(...);
    void enqueue(...);
    void finalize(...);
    b8 initialize(...);
    void release(...);
};

[cpp_header("<core/common/module.h>"), cpp_name("::NWB::Core::Common::InitializerGuard")]
extern class InitializerGuard{
    void finalize(...);
    b8 initialize(...);
};

[cpp_header("<core/common/module.h>"), cpp_name("::NWB::Core::Common::Initializerable")]
extern class Initializerable{
    b8 initialize();
    void finalize();
};


