void ReflectionFeedback_Accept(in ReflectionFeedbackPlan plan, mut ReflectionFeedbackState state){
    native(in plan, mut state){
        ReflectionStatisticsTestHelpers::Accept(plan, state);
    }
}

void ReflectionFeedback_AcceptWithHardware(in ReflectionFeedbackPlan plan, mut ReflectionFeedbackState state, in b8 hardwareReady){
    native(in plan, mut state, in hardwareReady){
        ReflectionStatisticsTestHelpers::Accept(plan, state, hardwareReady);
    }
}

void ReflectionHistory_Accept(in ReflectionHistoryPlan plan, mut ReflectionHistoryState state){
    native(in plan, mut state){
        ReflectionStatisticsTestHelpers::Accept(plan, state);
    }
}

void ReflectionHistory_AcceptWithHardware(in ReflectionHistoryPlan plan, mut ReflectionHistoryState state, in b8 hardwareReady){
    native(in plan, mut state, in hardwareReady){
        ReflectionStatisticsTestHelpers::Accept(plan, state, hardwareReady);
    }
}

void VerifyReflectionFeedback_ExtentAccountsForTwoSurfaceClassesAndPartialTiles(){
    const Expected<ReflectionFeedbackExtent> partial = TryComputeReflectionFeedbackExtent(9u, 17u);
    ASSERT_TRUE(partial.has_value());
    EXPECT_EQ(partial.value().tilesX, 2u);
    EXPECT_EQ(partial.value().tilesY, 3u);
    EXPECT_EQ(partial.value().entryCount, 12u);
    EXPECT_EQ(partial.value().byteCount, 64u);
    const Expected<ReflectionFeedbackExtent> single = TryComputeReflectionFeedbackExtent(1u, 1u);
    ASSERT_TRUE(single.has_value());
    EXPECT_EQ(single.value().byteCount, 24u);
    EXPECT_FALSE(TryComputeReflectionFeedbackExtent(0u, 1u).has_value());
    EXPECT_FALSE(TryComputeReflectionFeedbackExtent(1u, 0u).has_value());
    EXPECT_FALSE(TryComputeReflectionFeedbackExtent(u32.max, 1u).has_value());
    EXPECT_FALSE(TryComputeReflectionFeedbackExtent(u32.max, u32.max).has_value());
}

void VerifyReflectionFeedback_SpeculativePlansAndRejectedWriterDoNotAdvanceCadence(){
    ReflectionFeedbackState state = ReflectionFeedbackState(1u);
    const ReflectionFeedbackPlan first = state.plan(Stamp(), ReflectionSettings(), true, 1u);
    ReflectionFeedback_Accept(first, state);
    for(u32 index = 0u; index < 8u; ++index){
        const ReflectionFeedbackPlan rejected = state.plan(Stamp(), ReflectionSettings(), true, 2u + index);
        EXPECT_EQ(rejected.probeIndex, 1u);
        EXPECT_NE(rejected.currentBank, first.currentBank);
        ASSERT_TRUE(state.reserve(rejected));
        state.discard(rejected);
    }
    const ReflectionFeedbackPlan retry = state.plan(Stamp(), ReflectionSettings(), true, 10u);
    EXPECT_EQ(retry.probeIndex, 1u);
    EXPECT_EQ(retry.acceptedSequence, first.sequence);
    EXPECT_EQ(retry.previousBank, first.currentBank);
    EXPECT_TRUE(retry.reused);
}

void VerifyReflectionFeedback_EveryTrustedContentDomainInvalidatesPreviousTileState(){
    for(u32 domain = 0u; domain < 4u; ++domain){
        ReflectionFeedbackState state = ReflectionFeedbackState(1u);
        ReflectionFeedback_Accept(state.plan(Stamp(), ReflectionSettings(), true, 1u), state);
        ReflectionSceneContentStamp stamp = Stamp();
        if(domain == 0u)
            ++stamp.geometry;
        else if(domain == 1u)
            ++stamp.material;
        else if(domain == 2u)
            ++stamp.lighting;
        else
            ++stamp.view;
        const ReflectionFeedbackPlan changed = state.plan(stamp, ReflectionSettings(), true, 2u);
        EXPECT_TRUE(changed.reset);
        EXPECT_FALSE(changed.reused);
        EXPECT_EQ(changed.probeIndex, 0u);
        if(domain == 3u)
            EXPECT_EQ(changed.resetReason, ReflectionFeedbackResetReason::ViewChanged);
        else
            EXPECT_EQ(changed.resetReason, ReflectionFeedbackResetReason::SceneChanged);
        ReflectionFeedback_Accept(changed, state);
        const ReflectionFeedbackPlan stable = state.plan(stamp, ReflectionSettings(), true, 3u);
        EXPECT_FALSE(stable.reset);
        EXPECT_TRUE(stable.reused);
        EXPECT_EQ(stable.probeIndex, 1u);
    }
}

void VerifyReflectionFeedback_ScreenRangeBudgetAndSeedChangesInvalidateFeedback(){
    for(u32 field = 0u; field < 10u; ++field){
        ReflectionFeedbackState state = ReflectionFeedbackState(1u);
        ReflectionSettings settings = ReflectionSettings();
        ReflectionFeedback_Accept(state.plan(Stamp(), settings, true, 1u), state);
        if(field == 0u)
            ++settings.samplingSeed;
        else if(field == 1u)
            --settings.maxHardwareRaysPerFrame;
        else if(field == 2u)
            --settings.maxOpticalQueries;
        else if(field == 3u)
            settings.maxRayDistance = settings.maxRayDistance + 1.0f;
        else if(field == 4u)
            settings.distanceFadeStart = settings.distanceFadeStart - 1.0f;
        else if(field == 5u)
            settings.roughnessCutoff = settings.roughnessCutoff - 0.1f;
        else if(field == 6u)
            --settings.screenMaxSteps;
        else if(field == 7u)
            settings.screenThickness = settings.screenThickness + 0.01f;
        else if(field == 8u)
            settings.screenConfidenceThreshold = settings.screenConfidenceThreshold - 0.1f;
        else
            settings.screenEdgeFade = settings.screenEdgeFade + 0.01f;
        const ReflectionFeedbackPlan next = state.plan(Stamp(), settings, true, 2u);
        EXPECT_EQ(next.resetReason, ReflectionFeedbackResetReason::SettingsChanged);
        EXPECT_FALSE(next.reused);
        EXPECT_EQ(next.probeIndex, 0u);
    }
}

void VerifyReflectionFeedback_OnlyTrustedEnabledHybridWithAvailableHardwareCanUseFeedback(){
    for(u32 reason = 0u; reason < 7u; ++reason){
        ReflectionFeedbackState state = ReflectionFeedbackState(1u);
        ReflectionSceneContentStamp stamp = Stamp();
        ReflectionSettings settings = ReflectionSettings();
        b8 enabled = true;
        b8 hardwareReady = true;
        if(reason == 0u)
            enabled = false;
        else if(reason == 1u)
            stamp.trusted = false;
        else if(reason == 2u)
            settings.traceMode = ReflectionTraceMode::Disabled;
        else if(reason == 3u)
            settings.traceMode = ReflectionTraceMode::ScreenSpace;
        else if(reason == 4u)
            settings.traceMode = ReflectionTraceMode::Hardware;
        else if(reason == 5u)
            settings.maxHardwareRaysPerFrame = 0u;
        else
            hardwareReady = false;
        const ReflectionFeedbackPlan plan = state.plan(stamp, settings, enabled, 1u);
        const ReflectionFeedbackOutcome outcome = ResolveReflectionFeedbackOutcome(plan, hardwareReady);
        EXPECT_FALSE(outcome.eligible);
        EXPECT_FALSE(outcome.reused);
        ReflectionFeedback_AcceptWithHardware(plan, state, hardwareReady);
        const ReflectionFeedbackPlan next = state.plan(stamp, settings, enabled, 2u);
        EXPECT_EQ(next.probeIndex, 0u);
        EXPECT_FALSE(next.reused);
    }
}

void VerifyReflectionFeedback_RejectedDisablePreservesAcceptedBankButAcceptedDisableInvalidatesReuse(){
    ReflectionFeedbackState state = ReflectionFeedbackState(1u);
    const ReflectionFeedbackPlan first = state.plan(Stamp(), ReflectionSettings(), true, 1u);
    ReflectionFeedback_Accept(first, state);
    const ReflectionFeedbackPlan disabled = state.plan(Stamp(), ReflectionSettings(), false, 2u);
    EXPECT_NE(disabled.currentBank, first.currentBank);
    ASSERT_TRUE(state.reserve(disabled));
    state.discard(disabled);
    EXPECT_TRUE(state.plan(Stamp(), ReflectionSettings(), true, 3u).reused);
    ReflectionFeedback_Accept(state.plan(Stamp(), ReflectionSettings(), false, 4u), state);
    const ReflectionFeedbackPlan enabled = state.plan(Stamp(), ReflectionSettings(), true, 5u);
    EXPECT_FALSE(enabled.reused);
    EXPECT_TRUE(enabled.reset);
    EXPECT_EQ(enabled.probeIndex, 0u);
    EXPECT_EQ(enabled.previousBank, first.currentBank);
    EXPECT_NE(enabled.currentBank, first.currentBank);
}

void VerifyReflectionFeedback_RejectedUntrustedPrefixPreservesAcceptedFeedback(){
    ReflectionFeedbackState state = ReflectionFeedbackState(1u);
    const ReflectionFeedbackPlan first = state.plan(Stamp(), ReflectionSettings(), true, 1u);
    ReflectionFeedback_Accept(first, state);
    ReflectionSceneContentStamp untrusted = Stamp();
    untrusted.trusted = false;
    const ReflectionFeedbackPlan rejected = state.plan(untrusted, ReflectionSettings(), true, 2u);
    EXPECT_FALSE(rejected.eligible);
    EXPECT_NE(rejected.currentBank, first.currentBank);
    ASSERT_TRUE(state.reserve(rejected));
    state.discard(rejected);
    EXPECT_TRUE(state.plan(Stamp(), ReflectionSettings(), true, 3u).reused);
    ReflectionFeedback_Accept(state.plan(untrusted, ReflectionSettings(), true, 4u), state);
    EXPECT_FALSE(state.plan(Stamp(), ReflectionSettings(), true, 5u).reused);
}

void VerifyReflectionFeedback_LateHardwareFailureDisablesBypassAndRecoveryRestartsObservation(){
    ReflectionFeedbackState state = ReflectionFeedbackState(1u);
    const ReflectionFeedbackPlan first = state.plan(Stamp(), ReflectionSettings(), true, 1u);
    ReflectionFeedback_Accept(first, state);
    const ReflectionFeedbackPlan failed = state.plan(Stamp(), ReflectionSettings(), true, 2u);
    ASSERT_TRUE(failed.reused);
    const ReflectionFeedbackOutcome outcome = ResolveReflectionFeedbackOutcome(failed, false);
    EXPECT_FALSE(outcome.eligible);
    EXPECT_FALSE(outcome.reused);
    EXPECT_EQ(outcome.resetReason, ReflectionFeedbackResetReason::HardwareChanged);
    EXPECT_EQ(outcome.probeIndex, 0u);
    EXPECT_EQ(outcome.epoch, first.epoch + 1u);
    EXPECT_EQ(outcome.startGraphicsFrame, 2u);
    ReflectionFeedback_AcceptWithHardware(failed, state, false);
    const ReflectionFeedbackPlan recovery = state.plan(Stamp(), ReflectionSettings(), true, 3u);
    const ReflectionFeedbackOutcome recovered = ResolveReflectionFeedbackOutcome(recovery, true);
    EXPECT_TRUE(recovered.eligible);
    EXPECT_FALSE(recovered.reused);
    EXPECT_EQ(recovered.probeIndex, 0u);
    EXPECT_EQ(recovered.resetReason, ReflectionFeedbackResetReason::HardwareChanged);
    EXPECT_EQ(recovered.startGraphicsFrame, 3u);
    EXPECT_EQ(recovery.previousBank, first.currentBank);
    ReflectionFeedback_Accept(recovery, state);
    EXPECT_TRUE(state.plan(Stamp(), ReflectionSettings(), true, 4u).reused);
}

void VerifyReflectionFeedback_InvalidAcceptedTokensQuarantineBankReuseUntilJoinedOwnerReset(){
    for(u32 invalid = 0u; invalid < 6u; ++invalid){
        ReflectionFeedbackState state = ReflectionFeedbackState(1u);
        const ReflectionFeedbackPlan first = state.plan(Stamp(), ReflectionSettings(), true, 1u);
        ReflectionFeedback_Accept(first, state);
        const ReflectionFeedbackPlan plan = state.plan(Stamp(), ReflectionSettings(), true, 2u + invalid);
        ASSERT_TRUE(state.reserve(plan));
        QueueSubmissionToken token = Token(plan.sequence);
        if(invalid == 0u)
            token.value = 0u;
        else if(invalid == 1u)
            token.physicalQueueIndex = u16.max;
        else if(invalid == 2u)
            token.deviceGeneration = 2u;
        else if(invalid == 3u)
            token.queue = CommandQueue::Compute;
        else if(invalid == 4u)
            token.value = first.sequence;
        else
            token.physicalQueueIndex = 1u;
        EXPECT_FALSE(state.accept(plan, token, true));
        const ReflectionFeedbackPlan retry = state.plan(Stamp(), ReflectionSettings(), true, 20u + invalid);
        EXPECT_EQ(retry.acceptedSequence, first.sequence);
        EXPECT_TRUE(retry.quarantined);
        EXPECT_FALSE(retry.eligible);
        EXPECT_FALSE(retry.reused);
        EXPECT_EQ(retry.resetReason, ReflectionFeedbackResetReason::InvalidAcceptance);
        EXPECT_FALSE(state.reserve(retry));
        state.discard(plan);
        EXPECT_TRUE(state.plan(Stamp(), ReflectionSettings(), true, 30u + invalid).quarantined);
        // Reset models the renderer's explicit join/discard boundary, not an ordinary rejected frame.
        state.reset(1u);
        const ReflectionFeedbackPlan reset = state.plan(Stamp(), ReflectionSettings(), true, 40u + invalid);
        EXPECT_FALSE(reset.quarantined);
        EXPECT_EQ(reset.probeIndex, 0u);
        EXPECT_EQ(reset.resetReason, ReflectionFeedbackResetReason::ResourcesChanged);
        ASSERT_TRUE(state.reserve(reset));
        state.discard(reset);
    }
}

void VerifyReflectionFeedback_StalePlanCannotReserveAfterAnIndependentPlanAccepts(){
    ReflectionFeedbackState state = ReflectionFeedbackState(1u);
    const ReflectionFeedbackPlan stale = state.plan(Stamp(), ReflectionSettings(), true, 1u);
    const ReflectionFeedbackPlan current = state.plan(Stamp(), ReflectionSettings(), true, 2u);
    ReflectionFeedback_Accept(current, state);
    EXPECT_FALSE(state.reserve(stale));
    EXPECT_FALSE(state.accept(stale, Token(99u), true));
    state.discard(stale);
    EXPECT_EQ(state.plan(Stamp(), ReflectionSettings(), true, 3u).acceptedSequence, current.sequence);
}

void VerifyReflectionFeedback_ResourceGenerationBlocksOldCallbacksWithoutDiscardingTheNewLease(){
    ReflectionFeedbackState state = ReflectionFeedbackState(1u);
    const ReflectionFeedbackPlan old = state.plan(Stamp(), ReflectionSettings(), true, 1u);
    ASSERT_TRUE(state.reserve(old));
    state.reset(2u);
    const ReflectionFeedbackPlan next = state.plan(Stamp(), ReflectionSettings(), true, 2u);
    EXPECT_GT(next.generation, old.generation);
    EXPECT_EQ(next.resetReason, ReflectionFeedbackResetReason::ResourcesChanged);
    ASSERT_TRUE(state.reserve(next));
    state.discard(old);
    EXPECT_FALSE(state.accept(old, Token(1u), true));
    QueueSubmissionToken token = Token(1u);
    token.deviceGeneration = 2u;
    EXPECT_TRUE(state.accept(next, token, true));
    EXPECT_TRUE(state.plan(Stamp(), ReflectionSettings(), true, 3u).reused);
}

void VerifyReflectionFeedback_RejectedGraphAndResetReleaseTheMoveOnlyReservation(){
    ReflectionFeedbackControlContext context = ReflectionFeedbackControlContext();
    ASSERT_TRUE(context.valid());
    const ReflectionFeedbackPlan rejected = context.plan(Stamp(), ReflectionSettings(), true, 1u);
    b8 rejectedAdmitted = true;
    native(mut context, in rejected, mut rejectedAdmitted){
        using LeaseTask = ReflectionStatisticsTestHelpers::ReservationLeaseTask<ReflectionFeedbackReservation>;
        rejectedAdmitted = context.graph.addTask<LeaseTask>(Core::GpuTaskDesc{}, LeaseTask::Payload{ ReflectionFeedbackReservation(context.inner.control, rejected) }).has_value();
    }
    EXPECT_FALSE(rejectedAdmitted);
    GpuTaskDesc desc = GpuTaskDesc();
    desc.setIdentity(s_EcsCaseTestsFeedbackLease).setMarkerLabel("Feedback Lease");
    const ReflectionFeedbackPlan pending = context.plan(Stamp(), ReflectionSettings(), true, 2u);
    b8 pendingAdmitted = false;
    b8 pendingTaskValid = false;
    native(mut context, in desc, in pending, mut pendingAdmitted, mut pendingTaskValid){
        using LeaseTask = ReflectionStatisticsTestHelpers::ReservationLeaseTask<ReflectionFeedbackReservation>;
        const auto gpuTaskAdmission = context.graph.addTask<LeaseTask>(desc, LeaseTask::Payload{ ReflectionFeedbackReservation(context.inner.control, pending) });
        pendingAdmitted = gpuTaskAdmission.has_value();
        if(gpuTaskAdmission)
            pendingTaskValid = gpuTaskAdmission->valid();
    }
    ASSERT_TRUE(pendingAdmitted);
    ASSERT_TRUE(pendingTaskValid);
    context.graph.reset();
    const ReflectionFeedbackPlan retry = context.plan(Stamp(), ReflectionSettings(), true, 3u);
    ASSERT_TRUE(context.reserve(retry));
    EXPECT_EQ(retry.probeIndex, 0u);
    context.discard(retry);
}

void VerifyReflectionFeedback_MovedLeasePublishesOnceAndInvalidAcceptanceRetainsQuarantineAfterDestruction(){
    ReflectionFeedbackControlContext context = ReflectionFeedbackControlContext();
    ASSERT_TRUE(context.valid());
    const ReflectionFeedbackPlan first = context.plan(Stamp(), ReflectionSettings(), true, 1u);
    b8 originalInitiallyValid = false;
    b8 originalValidAfterMove = true;
    b8 movedValidBeforeAccept = false;
    b8 movedValidAfterAccept = true;
    native(mut context, in first, mut originalInitiallyValid, mut originalValidAfterMove, mut movedValidBeforeAccept, mut movedValidAfterAccept){
        ReflectionFeedbackReservation original(context.inner.control, first);
        originalInitiallyValid = original.valid();
        if(originalInitiallyValid){
            ReflectionFeedbackReservation moved(Move(original));
            originalValidAfterMove = original.valid();
            movedValidBeforeAccept = moved.valid();
            moved.accept(Token(first.sequence), true);
            movedValidAfterAccept = moved.valid();
            moved.accept(Token(99u), true);
        }
    }
    ASSERT_TRUE(originalInitiallyValid);
    EXPECT_FALSE(originalValidAfterMove);
    EXPECT_TRUE(movedValidBeforeAccept);
    EXPECT_FALSE(movedValidAfterAccept);

    const ReflectionFeedbackPlan retry = context.plan(Stamp(), ReflectionSettings(), true, 2u);
    EXPECT_EQ(retry.probeIndex, 1u);
    {
        ReflectionFeedbackReservation accepted = context.makeReservation(retry);
        ASSERT_TRUE(accepted.valid());
        accepted.accept(QueueSubmissionToken(), true);
    }
    const ReflectionFeedbackPlan quarantined = context.plan(Stamp(), ReflectionSettings(), true, 3u);
    EXPECT_TRUE(quarantined.quarantined);
    const ReflectionFeedbackReservation blocked = context.makeReservation(quarantined);
    EXPECT_FALSE(blocked.valid());
}

void VerifyReflectionHistory_AcceptedSampleCountCapsWhileSamplingIndexContinues(){
    ReflectionHistoryState state = ReflectionHistoryState(1u);
    ReflectionSettings settings = ReflectionSettings();
    settings.temporalMaxSamples = 8u;
    for(u32 index = 0u; index < 40u; ++index){
        const ReflectionHistoryPlan plan = state.plan(Stamp(), settings, 100u + index);
        const ReflectionHistoryOutcome outcome = ResolveReflectionHistoryOutcome(plan, true);
        EXPECT_EQ(outcome.sampleIndex, index);
        EXPECT_EQ(outcome.sampleCount, Min(index + 1u, 8u));
        EXPECT_EQ(outcome.historyStartGraphicsFrame, 100u);
        ReflectionHistory_Accept(plan, state);
    }
}

void VerifyReflectionHistory_SingleSampleLimitStillPublishesBanksAndAdvancesAcceptedSampling(){
    ReflectionHistoryControlContext context = ReflectionHistoryControlContext();
    ASSERT_TRUE(context.valid());
    ReflectionSettings settings = ReflectionSettings();
    settings.temporalMaxSamples = 1u;
    u64 epoch = 0u;
    for(u32 index = 0u; index < 4u; ++index){
        const ReflectionHistoryPlan plan = context.plan(Stamp(), settings, 100u + index);
        const ReflectionHistoryOutcome outcome = ResolveReflectionHistoryOutcome(plan, true);
        EXPECT_TRUE(outcome.eligible);
        EXPECT_EQ(outcome.reused, index != 0u);
        EXPECT_EQ(outcome.sampleCount, 1u);
        EXPECT_EQ(outcome.sampleIndex, index);
        EXPECT_EQ(plan.currentBank, index & 1u);
        EXPECT_EQ(outcome.historyStartGraphicsFrame, 100u);
        if(index == 0u)
            epoch = outcome.epoch;
        EXPECT_EQ(outcome.epoch, epoch);
        ReflectionHistoryReservation reservation = context.makeReservation(plan);
        ASSERT_TRUE(reservation.valid());
        reservation.accept(Token(plan.sequence), true);
        const ReflectionHistoryPlan next = context.plan(Stamp(), settings, 101u + index);
        EXPECT_EQ(next.acceptedSequence, plan.sequence);
        EXPECT_EQ(next.previousBank, plan.currentBank);
        EXPECT_EQ(next.previousSampleCount, 1u);
        EXPECT_EQ(next.sampleIndex, index + 1u);
    }
}

void VerifyReflectionHistory_DiscardedLateHardwareResetKeepsHistoryUntilAnAcceptedRetry(){
    ReflectionHistoryControlContext context = ReflectionHistoryControlContext();
    ASSERT_TRUE(context.valid());
    const ReflectionSettings settings = ReflectionSettings();
    const ReflectionHistoryPlan first = context.plan(Stamp(), settings, 10u);
    ReflectionHistoryReservation initial = context.makeReservation(first);
    ASSERT_TRUE(initial.valid());
    initial.accept(Token(first.sequence), true);

    const ReflectionHistoryPlan rejected = context.plan(Stamp(), settings, 11u);
    ASSERT_TRUE(rejected.reused);
    const ReflectionHistoryOutcome lateReset = ResolveReflectionHistoryOutcome(rejected, false);
    EXPECT_EQ(lateReset.resetReason, ReflectionHistoryResetReason::HardwareChanged);
    EXPECT_FALSE(lateReset.reused);
    EXPECT_EQ(lateReset.sampleIndex, 0u);
    EXPECT_EQ(lateReset.sampleCount, 1u);
    ReflectionHistoryReservation abandoned = context.makeReservation(rejected);
    ASSERT_TRUE(abandoned.valid());
    abandoned.discard();
    const ReflectionHistoryPlan retry = context.plan(Stamp(), settings, 12u);
    EXPECT_EQ(retry.acceptedSequence, first.sequence);
    EXPECT_EQ(retry.epoch, rejected.epoch);
    EXPECT_EQ(retry.currentBank, rejected.currentBank);
    EXPECT_EQ(retry.previousBank, first.currentBank);
    const ReflectionHistoryOutcome restoredReady = ResolveReflectionHistoryOutcome(retry, true);
    EXPECT_TRUE(restoredReady.reused);
    EXPECT_FALSE(restoredReady.reset);
    EXPECT_EQ(restoredReady.sampleIndex, 1u);

    ReflectionHistoryReservation accepted = context.makeReservation(retry);
    ASSERT_TRUE(accepted.valid());
    accepted.accept(Token(retry.sequence), false);
    const ReflectionHistoryPlan next = context.plan(Stamp(), settings, 13u);
    const ReflectionHistoryOutcome stable = ResolveReflectionHistoryOutcome(next, false);
    EXPECT_EQ(next.acceptedSequence, retry.sequence);
    EXPECT_EQ(next.previousBank, retry.currentBank);
    EXPECT_EQ(stable.epoch, lateReset.epoch);
    EXPECT_EQ(stable.sampleIndex, 1u);
    EXPECT_EQ(stable.sampleCount, 2u);
    EXPECT_EQ(stable.historyStartGraphicsFrame, 12u);
    EXPECT_TRUE(stable.reused);
    EXPECT_FALSE(stable.reset);
}

void VerifyReflectionHistory_EverySceneDomainAndViewChangeResetsOnce(){
    for(u32 domain = 0u; domain < 4u; ++domain){
        ReflectionHistoryState state = ReflectionHistoryState(1u);
        ReflectionHistory_Accept(state.plan(Stamp(), ReflectionSettings(), 10u), state);
        ReflectionSceneContentStamp stamp = Stamp();
        if(domain == 0u)
            ++stamp.geometry;
        else if(domain == 1u)
            ++stamp.material;
        else if(domain == 2u)
            ++stamp.lighting;
        else
            ++stamp.view;
        const ReflectionHistoryPlan changed = state.plan(stamp, ReflectionSettings(), 11u);
        EXPECT_TRUE(changed.reset);
        EXPECT_EQ(changed.sampleIndex, 0u);
        EXPECT_FALSE(changed.reused);
        if(domain == 3u)
            EXPECT_EQ(changed.resetReason, ReflectionHistoryResetReason::ViewChanged);
        else
            EXPECT_EQ(changed.resetReason, ReflectionHistoryResetReason::SceneChanged);
        ReflectionHistory_Accept(changed, state);
        const ReflectionHistoryPlan next = state.plan(stamp, ReflectionSettings(), 12u);
        EXPECT_FALSE(next.reset);
        EXPECT_EQ(next.sampleIndex, 1u);
        EXPECT_EQ(next.epoch, changed.epoch);
        EXPECT_EQ(ResolveReflectionHistoryOutcome(next, true).historyStartGraphicsFrame, 11u);
    }
}

void VerifyReflectionHistory_SeedAndBudgetChangesRestartTheSamplingSequence(){
    ReflectionHistoryState state = ReflectionHistoryState(1u);
    ReflectionSettings settings = ReflectionSettings();
    ReflectionHistory_Accept(state.plan(Stamp(), settings, 1u), state);
    ++settings.samplingSeed;
    const ReflectionHistoryPlan seed = state.plan(Stamp(), settings, 2u);
    EXPECT_EQ(seed.resetReason, ReflectionHistoryResetReason::SettingsChanged);
    EXPECT_EQ(seed.sampleIndex, 0u);
    ReflectionHistory_Accept(seed, state);
    settings.maxHardwareRaysPerFrame = 0u;
    const ReflectionHistoryPlan budget = state.plan(Stamp(), settings, 3u);
    EXPECT_EQ(budget.resetReason, ReflectionHistoryResetReason::SettingsChanged);
    EXPECT_EQ(budget.sampleIndex, 0u);
    ReflectionHistory_Accept(budget, state);
    --settings.maxOpticalQueries;
    const ReflectionHistoryPlan queries = state.plan(Stamp(), settings, 4u);
    EXPECT_EQ(queries.resetReason, ReflectionHistoryResetReason::SettingsChanged);
    EXPECT_EQ(queries.sampleIndex, 0u);
}

void VerifyReflectionHistory_SpatialAndDiagnosticSettingsDoNotResetUnfilteredHistory(){
