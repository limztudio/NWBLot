inline constexpr AStringView s_Target = "target";
inline constexpr AStringView s_ReportArenaName = "tests/telemetry/report_work";
inline constexpr AStringView s_PacketIndex = "\"packet\": {\"index\":";
inline constexpr AStringView s_RuntimePacketSubmissionCount3 = "runtime_packet_submission_count=3";
