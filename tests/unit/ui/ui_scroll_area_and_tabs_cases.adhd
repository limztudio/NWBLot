NWB_ADHD_GTEST_F(UiScrollAreaAndTabsTests, ScrollAreaClipsAndOffsetsChildrenBubblesWheelAndSupportsThumbDragAndTrackPage, VerifyUiScrollAreaAndTabsTests_ScrollAreaClipsAndOffsetsChildrenBubblesWheelAndSupportsThumbDragAndTrackPage)
NWB_ADHD_GTEST_F(UiScrollAreaAndTabsTests, NestedScrollAreasRouteWheelInnerFirstBubbleWhenInnerFitsAndNeverLeakAcrossOverlappingWindows, VerifyUiScrollAreaAndTabsTests_NestedScrollAreasRouteWheelInnerFirstBubbleWhenInnerFitsAndNeverLeakAcrossOverlappingWindows)
NWB_ADHD_GTEST_F(UiScrollAreaAndTabsTests, CollapsibleHeaderTogglesByPointerAndKeyboardRespectsDisabledAndSupportsNestedContent, VerifyUiScrollAreaAndTabsTests_CollapsibleHeaderTogglesByPointerAndKeyboardRespectsDisabledAndSupportsNestedContent)
NWB_ADHD_GTEST_F(UiScrollAreaAndTabsTests, TabBarNavigatesEnabledTabsByKeyboardAndPointerHandlesClosableTabsAndReconcilesRemovedSelection, VerifyUiScrollAreaAndTabsTests_TabBarNavigatesEnabledTabsByKeyboardAndPointerHandlesClosableTabsAndReconcilesRemovedSelection)


