////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <utilities/fbx_to_nwb/mesh_stream_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void AppendCleanFloatText(in f32 value, mut String out){
    StringAppendFormat(out, "{:.9g}", CleanFloat(value));
}

void AppendVec2Text(in Vec2 value, mut String out){
    out.append("[");
    AppendCleanFloatText(value.x, out);
    out.append(", ");
    AppendCleanFloatText(value.y, out);
    out.append("]");
}

void AppendVec3Text(in Vec3 value, mut String out){
    out.append("[");
    AppendCleanFloatText(value.x, out);
    out.append(", ");
    AppendCleanFloatText(value.y, out);
    out.append(", ");
    AppendCleanFloatText(value.z, out);
    out.append("]");
}

void AppendVec4Text(in Vec4 value, mut String out){
    out.append("[");
    AppendCleanFloatText(value.x, out);
    out.append(", ");
    AppendCleanFloatText(value.y, out);
    out.append(", ");
    AppendCleanFloatText(value.z, out);
    out.append(", ");
    AppendCleanFloatText(value.w, out);
    out.append("]");
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

