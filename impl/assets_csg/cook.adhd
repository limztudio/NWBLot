namespace AssetsCsgCook{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using Core::Assets::CookArena;
using Core::Assets::CookString;
using Core::Assets::CookVector;
using Core::Assets::ScratchArena;

struct CsgShapeCookEntry{
    Name shapeName = s_NameNone;
    Name shaderModule = s_NameNone;
    u32 shapeTypeId = 0u;
    CookString evalInclude;
    CookString moduleInclude;


public:
    explicit CsgShapeCookEntry(CookArena& arena)noexcept
        : evalInclude(arena)
        , moduleInclude(arena)
    {}
};

using CsgShapeCookEntryVector = CookVector<CsgShapeCookEntry>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] Expected<CsgShapeCookEntry> ParseCsgShapeCookMetadata(const Path& nwbFilePath, const Core::Metascript::Document& doc, CookArena& cookArena, ScratchArena& scratchArena);

[[nodiscard]] b8 AssignCsgShapeCookIds(Span<CsgShapeCookEntry> csgShapeEntries, ScratchArena& scratchArena);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CsgShapeModuleWriter final{
public:
    [[nodiscard]] Expected<Path> emit(const Path& cacheDirectory, AStringView configurationSafeName, Span<const CsgShapeCookEntry> csgShapeEntries, ScratchArena& scratchArena)const;


private:
    [[nodiscard]] static b8 WriteModuleInclude(Span<const CsgShapeCookEntry> csgShapeEntries, Name shaderModule, AStringView moduleInclude, const Path& includeRoot, ScratchArena& scratchArena, CookString& source);
    [[nodiscard]] static b8 WriteEmptyDefaultModuleInclude(const Path& includeRoot, ScratchArena& scratchArena);
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 HasNonEmptyCsgMetadataText(in StringView text){
    return !TrimView(text).empty();
}

b8 HasCsgBackslashPathSeparator(in StringView includePath){
    for(usize i = 0u; i < includePath.size(); ++i){
        if(includePath[i] == '\\')
            return true;
    }
    return false;
}

b8 IsSharedCsgGeneratedIncludeConflict(in b8 inserted, in Name existingModule, in Name currentModule){
    return !inserted && existingModule != currentModule;
}

b8 ValidateCsgNonEmptyMetadataField(in Path nwbFilePath, in StringView fieldName, in StringView text){
    if(HasNonEmptyCsgMetadataText(text))
        return true;

    error("{} '{}': field '{}' must not be empty", s_CsgShapeMetaDiagnosticPrefix, PathToString(nwbFilePath), fieldName);
    return false;
}

b8 ValidateCsgIncludePath(in Path nwbFilePath, in StringView fieldName, in StringView includePath, in b8 isAbsoluteOrEmpty, in b8 isCleanRelative){
    if(includePath.empty()){
        error("{} '{}': field '{}' must not be empty", s_CsgShapeMetaDiagnosticPrefix, PathToString(nwbFilePath), fieldName);
        return false;
    }
    if(HasCsgBackslashPathSeparator(includePath)){
        error("{} '{}': field '{}' must use '/' path separators", s_CsgShapeMetaDiagnosticPrefix, PathToString(nwbFilePath), fieldName);
        return false;
    }
    if(isAbsoluteOrEmpty){
        error("{} '{}': field '{}' must be a relative include path", s_CsgShapeMetaDiagnosticPrefix, PathToString(nwbFilePath), fieldName);
        return false;
    }
    if(!isCleanRelative){
        error("{} '{}': field '{}' has invalid include path '{}'", s_CsgShapeMetaDiagnosticPrefix, PathToString(nwbFilePath), fieldName, includePath);
        return false;
    }
    return true;
}

b8 ValidateCsgSlangIncludeExtension(in Path nwbFilePath, in StringView fieldName, in b8 hasSlangIncludeExtension){
    if(hasSlangIncludeExtension)
        return true;

    error("{} '{}': field '{}' must reference a .slangi file", s_CsgShapeMetaDiagnosticPrefix, PathToString(nwbFilePath), fieldName);
    return false;
}

b8 ValidateCsgReservedVirtualRoot(in Path nwbFilePath, in StringView fieldName, in b8 hasReservedVirtualRoot){
    if(hasReservedVirtualRoot)
        return true;

    error("{} '{}': field '{}' must be a project/- or engine/-rooted virtual path (e.g. 'engine/csg/box/eval.slangi')", s_CsgShapeMetaDiagnosticPrefix, PathToString(nwbFilePath), fieldName);
    return false;
}


