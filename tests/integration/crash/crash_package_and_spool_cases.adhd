void VerifyCrash_SpoolAdmissionPreservesFilesystemCategoryAndCodeAfterUnlock(){
    if(!IsDesktopCrashPlatform())
        return;

    CrashTestArena testArena = CrashTestArena();
    const StringView group = "crash_failed_spool_admission";
    RemoveTestArtifacts(testArena.arena, group);
    const CrashTestPath caseDirectory = TestCaseDirectory(testArena.arena, group);
    ASSERT_TRUE(EnsureDirectories(caseDirectory));
    const CrashTestPath blocked = caseDirectory / "blocked";
    ASSERT_TRUE(WriteTextFile(blocked, "This file cannot be a parent directory.\n"));
    const CrashTestPath spoolDirectory = blocked / s_SpoolDirectory;
    const CrashTestPath pendingDirectory = spoolDirectory / s_PendingBucket;
    UninstallCrashHandler();

    b8 installAccepted = true;
    b8 installed = true;
    b8 handlerStarted = true;
    b8 restorePending = true;
    u32 nativeDiagnostics = 0u;
    u32 unlockedDiagnostics = 0u;
    b8 matchedOperation = false;
    b8 matchedCategory = false;
    b8 matchedCode = false;
    native(in spoolDirectory, in pendingDirectory, mut installAccepted, mut installed, mut handlerStarted, mut restorePending, mut nativeDiagnostics, mut unlockedDiagnostics, mut matchedOperation, mut matchedCategory, mut matchedCode){
#if defined(NWB_PLATFORM_WINDOWS) || (defined(NWB_PLATFORM_LINUX) && !defined(NWB_PLATFORM_ANDROID))
        const auto expectedFailure = EnsureDirectories(pendingDirectory);
        ASSERT_FALSE(expectedFailure);
        Array<char, 64u> expectedCategory = {};
        CopyFixedBuffer(expectedCategory, "category=");
        AppendFixedBuffer(expectedCategory, AStringView(expectedFailure.error().category().name()));
        Array<char, 32u> expectedCode = {};
        CopyFixedBuffer(expectedCode, "code=");
        const i64 nativeCode = expectedFailure.error().value();
        if(nativeCode < 0)
            AppendFixedBuffer(expectedCode, "-");
        AppendUnsignedToFixedBuffer(expectedCode, static_cast<u64>(nativeCode < 0 ? -nativeCode : nativeCode));
        const auto previousCallback = DiagnosticDetail::g_EventCallback.exchange(ObserveNativeLifecycle, MemoryOrder::acq_rel);
        ScopeExit restoreCallback([previousCallback]()noexcept{ SetDiagnosticEventCallback(previousCallback); });
        s_NativeLifecycleDiagnostics = 0u;
        s_UnlockedLifecycleDiagnostics = 0u;
        PersistentArena installArena(s_InstallArena, PersistentArena::StructureAlignedSize(64u * 1024u));
        Core::Crash::CrashConfig config(installArena);
        config.applicationName = "bad-spool-admission";
        config.spoolDirectory = spoolDirectory;
        installAccepted = Core::Crash::InstallCrashHandler(config);
        installed = Core::Crash::CrashDetail::g_State.installed;
        handlerStarted = Core::Crash::CrashDetail::g_State.handlerStarted;
        restorePending = Core::Crash::CrashDetail::g_State.platformRestorePending;
        nativeDiagnostics = s_NativeLifecycleDiagnostics;
        unlockedDiagnostics = s_UnlockedLifecycleDiagnostics;
        matchedOperation = FixedBufferView(s_LastLifecycleOperation) == AStringView("prepare_spool");
        matchedCategory = FixedBufferView(s_LastLifecycleDiagnostic).find(FixedBufferView(expectedCategory)) != AStringView::npos;
        matchedCode = FixedBufferView(s_LastLifecycleDiagnostic).find(FixedBufferView(expectedCode)) != AStringView::npos;
#endif
    }
    EXPECT_FALSE(installAccepted);
    EXPECT_FALSE(installed);
    EXPECT_FALSE(handlerStarted);
    EXPECT_FALSE(restorePending);
    EXPECT_EQ(nativeDiagnostics, 1u);
    EXPECT_EQ(unlockedDiagnostics, 1u);
    EXPECT_TRUE(matchedOperation);
    EXPECT_TRUE(matchedCategory);
    EXPECT_TRUE(matchedCode);
    UninstallCrashHandler();
    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyCrash_FailedExecutableAdmissionReleasesResourcesAndObservesFailureAfterUnlock(){
    if(!IsDesktopCrashPlatform())
        return;

    CrashTestArena testArena = CrashTestArena();
    const StringView group = "crash_bad_executable_admission";
    RemoveTestArtifacts(testArena.arena, group);
    const CrashTestPath caseDirectory = TestCaseDirectory(testArena.arena, group);
    ASSERT_TRUE(EnsureDirectories(caseDirectory));
    const CrashTestPath invalidExecutable = caseDirectory / "invalid_handler";
    ASSERT_TRUE(WriteTextFile(invalidExecutable, "This is not an executable image.\n"));
    const CrashTestPath spoolDirectory = SpoolDirectory(testArena.arena, group);
    UninstallCrashHandler();

    usize beforeCount = 0u;
    usize afterCount = 0u;
    u32 nativeDiagnostics = 0u;
    u32 unlockedDiagnostics = 0u;
    b8 diagnosticHasCode = false;
    native(in invalidExecutable, in spoolDirectory, mut testArena, mut beforeCount, mut afterCount, mut nativeDiagnostics, mut unlockedDiagnostics, mut diagnosticHasCode){
#if defined(NWB_PLATFORM_WINDOWS) || (defined(NWB_PLATFORM_LINUX) && !defined(NWB_PLATFORM_ANDROID))
        auto& arena = testArena.arena;
#if defined(NWB_PLATFORM_LINUX)
        ASSERT_EQ(chmod(invalidExecutable.c_str(), 0700), 0);
#endif
        const auto previousCallback = DiagnosticDetail::g_EventCallback.exchange(ObserveNativeLifecycle, MemoryOrder::acq_rel);
        ScopeExit restoreCallback([previousCallback]()noexcept{ SetDiagnosticEventCallback(previousCallback); });
        s_NativeLifecycleDiagnostics = 0u;
        s_UnlockedLifecycleDiagnostics = 0u;
        PersistentArena installArena(s_InstallArena, PersistentArena::StructureAlignedSize(64u * 1024u));
        const auto executableText = PathToString<char>(arena, invalidExecutable);
        Core::Crash::CrashConfig config(installArena);
        config.applicationName = "bad-executable-admission";
        config.spoolDirectory = spoolDirectory;
        config.handlerExecutablePath = AStringView(executableText);
        EXPECT_FALSE(Core::Crash::InstallCrashHandler(config));
#if defined(NWB_PLATFORM_WINDOWS)
        DWORD before = 0u;
        ASSERT_TRUE(GetProcessHandleCount(GetCurrentProcess(), &before));
        beforeCount = static_cast<usize>(before);
#else
        constexpr AStringView s_FileDescriptorsDirectory = "/proc/self/fd";
        const auto before = DirectoryIterator<GlobalArena>::Create(CrashTestPath(arena, s_FileDescriptorsDirectory));
        ASSERT_TRUE(before);
        beforeCount = static_cast<usize>(before->end() - before->begin());
#endif
        for(u32 attempt = 0u; attempt < 4u; ++attempt){
            EXPECT_FALSE(Core::Crash::InstallCrashHandler(config));
            EXPECT_FALSE(Core::Crash::CrashDetail::g_State.installed);
            EXPECT_FALSE(Core::Crash::CrashDetail::g_State.handlerStarted);
            EXPECT_FALSE(Core::Crash::CrashDetail::g_State.platformRestorePending);
        }
#if defined(NWB_PLATFORM_WINDOWS)
        DWORD after = 0u;
        ASSERT_TRUE(GetProcessHandleCount(GetCurrentProcess(), &after));
        afterCount = static_cast<usize>(after);
#else
        const auto after = DirectoryIterator<GlobalArena>::Create(CrashTestPath(arena, s_FileDescriptorsDirectory));
        ASSERT_TRUE(after);
        afterCount = static_cast<usize>(after->end() - after->begin());
#endif
        nativeDiagnostics = s_NativeLifecycleDiagnostics;
        unlockedDiagnostics = s_UnlockedLifecycleDiagnostics;
        diagnosticHasCode = FixedBufferView(s_LastLifecycleDiagnostic).find("code=") != AStringView::npos;
#endif
    }
    EXPECT_EQ(afterCount, beforeCount);
    EXPECT_EQ(nativeDiagnostics, 5u);
    EXPECT_EQ(unlockedDiagnostics, nativeDiagnostics);
    EXPECT_TRUE(diagnosticHasCode);
    UninstallCrashHandler();
    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyCrash_UninstallRestoresDisabledAlternateStackAndPriorSignalAndTerminateOwners(){
    if(!IsDesktopLinuxCrashPlatform())
        return;

    CrashTestArena testArena = CrashTestArena();
    const StringView group = "crash_restore_native_hooks";
    RemoveTestArtifacts(testArena.arena, group);
    UninstallCrashHandler();
    const CrashTestPath spoolDirectory = SpoolDirectory(testArena.arena, group);

    b8 stackDisabledRestored = false;
    b8 signalOwnerRestored = false;
    b8 terminateOwnerRestored = false;
    b8 restorePending = true;
    native(in spoolDirectory, mut stackDisabledRestored, mut signalOwnerRestored, mut terminateOwnerRestored, mut restorePending){
#if defined(NWB_PLATFORM_LINUX) && !defined(NWB_PLATFORM_ANDROID)
        stack_t originalStack = {};
        struct sigaction originalAction = {};
        ASSERT_EQ(sigaltstack(nullptr, &originalStack), 0);
        ASSERT_EQ(sigaction(SIGILL, nullptr, &originalAction), 0);
        const auto originalTerminate = QueryTerminateHandler();
        ScopeExit restore([&]()noexcept{
            UninstallCrashHandler();
            if(sigaction(SIGILL, &originalAction, nullptr) != 0 || sigaltstack(&originalStack, nullptr) != 0)
                TerminateInvariant();
            ExchangeTerminateHandler(originalTerminate);
        });
        stack_t disabled = {};
        disabled.ss_flags = SS_DISABLE;
        ASSERT_EQ(sigaltstack(&disabled, nullptr), 0);
        struct sigaction desired = {};
        desired.sa_handler = OriginalSignalOwner;
        ASSERT_EQ(sigemptyset(&desired.sa_mask), 0);
        ASSERT_EQ(sigaction(SIGILL, &desired, nullptr), 0);
        ExchangeTerminateHandler(OriginalTerminateOwner);
        PersistentArena installArena(s_InstallArena, PersistentArena::StructureAlignedSize(64u * 1024u));
        Core::Crash::CrashConfig config(installArena);
        config.applicationName = "restore-native-hooks";
        config.spoolDirectory = spoolDirectory;
        ASSERT_TRUE(Core::Crash::InstallCrashHandler(config));
        UninstallCrashHandler();
        stack_t restoredStack = {};
        struct sigaction restoredAction = {};
        ASSERT_EQ(sigaltstack(nullptr, &restoredStack), 0);
        ASSERT_EQ(sigaction(SIGILL, nullptr, &restoredAction), 0);
        stackDisabledRestored = (restoredStack.ss_flags & SS_DISABLE) != 0;
        signalOwnerRestored = restoredAction.sa_handler == OriginalSignalOwner;
        terminateOwnerRestored = QueryTerminateHandler() == OriginalTerminateOwner;
        restorePending = Core::Crash::CrashDetail::g_State.platformRestorePending;
#endif
    }
    EXPECT_TRUE(stackDisabledRestored);
    EXPECT_TRUE(signalOwnerRestored);
    EXPECT_TRUE(terminateOwnerRestored);
    EXPECT_FALSE(restorePending);
    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyCrash_UninstallPreservesNewerForeignNativeHookOwners(){
    if(!IsDesktopLinuxCrashPlatform())
        return;

    CrashTestArena testArena = CrashTestArena();
    const StringView group = "crash_preserve_foreign_hooks";
    RemoveTestArtifacts(testArena.arena, group);
    UninstallCrashHandler();
    const CrashTestPath spoolDirectory = SpoolDirectory(testArena.arena, group);

    b8 foreignStackRetained = false;
    b8 foreignSignalRetained = false;
    b8 foreignTerminateRetained = false;
    b8 restorePending = true;
    native(in spoolDirectory, mut foreignStackRetained, mut foreignSignalRetained, mut foreignTerminateRetained, mut restorePending){
#if defined(NWB_PLATFORM_LINUX) && !defined(NWB_PLATFORM_ANDROID)
        stack_t originalStack = {};
        struct sigaction originalAction = {};
        ASSERT_EQ(sigaltstack(nullptr, &originalStack), 0);
        ASSERT_EQ(sigaction(SIGILL, nullptr, &originalAction), 0);
        const auto originalTerminate = QueryTerminateHandler();
        ScopeExit restore([&]()noexcept{
            UninstallCrashHandler();
            if(sigaction(SIGILL, &originalAction, nullptr) != 0 || sigaltstack(&originalStack, nullptr) != 0)
                TerminateInvariant();
            ExchangeTerminateHandler(originalTerminate);
        });
        PersistentArena installArena(s_InstallArena, PersistentArena::StructureAlignedSize(64u * 1024u));
        Core::Crash::CrashConfig config(installArena);
        config.applicationName = "preserve-foreign-hooks";
        config.spoolDirectory = spoolDirectory;
        ASSERT_TRUE(Core::Crash::InstallCrashHandler(config));
        struct sigaction foreignAction = {};
        foreignAction.sa_handler = ForeignSignalOwner;
        ASSERT_EQ(sigemptyset(&foreignAction.sa_mask), 0);
        ASSERT_EQ(sigaction(SIGILL, &foreignAction, nullptr), 0);
        stack_t foreignStack = {};
        foreignStack.ss_sp = g_ForeignSignalStack.data();
        foreignStack.ss_size = g_ForeignSignalStack.size();
        ASSERT_EQ(sigaltstack(&foreignStack, nullptr), 0);
        ExchangeTerminateHandler(ForeignTerminateOwner);
        UninstallCrashHandler();
        stack_t retainedStack = {};
        struct sigaction retainedAction = {};
        ASSERT_EQ(sigaltstack(nullptr, &retainedStack), 0);
        ASSERT_EQ(sigaction(SIGILL, nullptr, &retainedAction), 0);
        foreignStackRetained = retainedStack.ss_sp == g_ForeignSignalStack.data();
        foreignSignalRetained = retainedAction.sa_handler == ForeignSignalOwner;
        foreignTerminateRetained = QueryTerminateHandler() == ForeignTerminateOwner;
        restorePending = Core::Crash::CrashDetail::g_State.platformRestorePending;
#endif
    }
    EXPECT_TRUE(foreignStackRetained);
    EXPECT_TRUE(foreignSignalRetained);
    EXPECT_TRUE(foreignTerminateRetained);
    EXPECT_FALSE(restorePending);
    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyCrash_MetadataRejectsTruncationAndEmbeddedNullWithoutChangingPublishedValue(){
    const StringView key = "bounded_metadata";
    ASSERT_TRUE(SetCrashMetadata(key, "original"));
    b8 found = false;
    native(in key, mut found){
        using namespace Core::Crash::CrashDetail;
        Array<char, s_MaxShortText> longKey;
        longKey.fill('k');
        Array<char, s_MaxMediumText> longValue;
        longValue.fill('v');
        const Array<char, 3u> embedded{ 'a', '\0', 'b' };
        EXPECT_TRUE(SetCrashMetadata(AStringView(longKey.data(), longKey.size() - 1u), AStringView(longValue.data(), longValue.size() - 1u)));
        EXPECT_FALSE(SetCrashMetadata(AStringView(longKey.data(), longKey.size()), "value"));
        EXPECT_FALSE(SetCrashMetadata(key, AStringView(longValue.data(), longValue.size())));
        EXPECT_FALSE(SetCrashMetadata(AStringView(embedded.data(), embedded.size()), "value"));
        EXPECT_FALSE(SetCrashMetadata(key, AStringView(embedded.data(), embedded.size())));
        const auto request = BuildCrashDumpRequest(CrashReasonKind::ManualDump, 0u, {});
        for(u32 i = 0u; i < request.metadataCount; ++i){
            if(FixedBufferView(request.metadata[i].key) == key){
                found = true;
                EXPECT_EQ(FixedBufferView(request.metadata[i].value), AStringView("original"));
            }
        }
    }
    EXPECT_TRUE(found);
}

void VerifyCrash_SnapshotKeepsPublishedMetadataDuringInterruptedWriter(){
    const StringView key = "snapshot_interrupted_writer";
    const StringView published = "published_complete_value";
    ASSERT_TRUE(SetCrashMetadata(key, published));

    CrashRequest request = CrashRequest();
    b8 exercisedWriter = false;
    b8 found = false;
    native(in key, in published, mut request, mut exercisedWriter, mut found){
        NothrowScopedLock lock(Core::Crash::CrashDetail::g_State.mutex);
        for(auto& metadata : Core::Crash::CrashDetail::g_State.metadata){
            if(!metadata.used || AStringView(metadata.key.data()) != key)
                continue;
            const auto original = metadata;
            ScopeExit restore([&metadata, &original]()noexcept{ metadata = original; });
            CopyFixedBuffer(metadata.value, AStringView("unpublished_partial_value"));
            request = Core::Crash::CrashDetail::BuildCrashDumpRequest(Core::Crash::CrashDetail::CrashReasonKind::ManualDump, 0u, {});
            exercisedWriter = true;
            break;
        }
        for(u32 i = 0u; i < request.metadataCount; ++i){
            if(AStringView(request.metadata[i].key.data()) != key)
                continue;
            EXPECT_EQ(AStringView(request.metadata[i].value.data()), published);
            found = true;
        }
    }
    ASSERT_TRUE(exercisedWriter);
    EXPECT_TRUE(found);
}

void VerifyCrash_ConcurrentPublicWritersPublishCompleteMetadataAndBreadcrumbRecords(){
    const StringView key = "snapshot_concurrent_writer";
    const StringView category = "snapshot_concurrent_breadcrumb";
    const usize iterations = 2000u;
    u32 failureCount = 0u;
    native(in key, in category, in iterations, mut failureCount){
        Array<char, Core::Crash::CrashDetail::s_MaxMediumText> first = {};
        Array<char, Core::Crash::CrashDetail::s_MaxMediumText> second = {};
        for(usize i = 0u; i + 1u < first.size(); ++i){
            first[i] = 'a';
            second[i] = 'b';
        }
        const AStringView firstText(first.data(), first.size() - 1u);
        const AStringView secondText(second.data(), second.size() - 1u);
        ASSERT_TRUE(SetCrashMetadata(key, firstText));
        Atomic<u32> failures{ 0u };
        Latch start(2u);
        JoiningThread writer([&]()noexcept{
            start.arrive_and_wait();
            for(usize i = 0u; i < iterations; ++i){
                const AStringView text = (i & 1u) != 0u ? firstText : secondText;
                if(!SetCrashMetadata(key, text))
                    failures.fetch_add(1u, MemoryOrder::relaxed);
                AddCrashBreadcrumb(category, text);
            }
        });
        start.arrive_and_wait();
        for(usize iteration = 0u; iteration < iterations; ++iteration){
            const auto request = Core::Crash::CrashDetail::BuildCrashDumpRequest(Core::Crash::CrashDetail::CrashReasonKind::ManualDump, 0u, {});
            b8 found = false;
            for(u32 i = 0u; i < request.metadataCount; ++i){
                const auto& metadata = request.metadata[i];
                if(AStringView(metadata.key.data()) != key)
                    continue;
                const AStringView value(metadata.value.data());
                if(value != firstText && value != secondText)
                    failures.fetch_add(1u, MemoryOrder::relaxed);
                found = true;
            }
            if(!found)
                failures.fetch_add(1u, MemoryOrder::relaxed);
            for(u32 i = 0u; i < request.breadcrumbCount; ++i){
                const auto& breadcrumb = request.breadcrumbs[i];
                if(AStringView(breadcrumb.category) != category)
                    continue;
                const AStringView message(breadcrumb.message);
                if(message != firstText && message != secondText)
                    failures.fetch_add(1u, MemoryOrder::relaxed);
            }
        }
        writer.join();
        failureCount = failures.load(MemoryOrder::relaxed);
    }
    EXPECT_EQ(failureCount, 0u);
}

void VerifyCrash_WriteCrashPackageFailsWhenSpoolPathIsFile(){
    CrashTestArena testArena = CrashTestArena();
    const StringView group = "crash_package_bad_spool_test";
    RemoveTestArtifacts(testArena.arena, group);

    const CrashTestPath caseDirectory = TestCaseDirectory(testArena.arena, group);
    const CrashTestPath spoolPath = SpoolDirectory(testArena.arena, group);
    native(in caseDirectory, in spoolPath){
        EXPECT_TRUE(EnsureDirectories(caseDirectory));
        EXPECT_TRUE(WriteTextFile(spoolPath, AStringView("not a directory")));
    }

    CrashRequest request = CrashRequest();
    FillPackageRequest(spoolPath, "crash-package-bad-spool", testArena.arena, request);
    EXPECT_FALSE(WriteCrashPackage(request));

    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyCrash_CrashSpoolRetentionPrunesOldestPackages(){
    CrashTestArena testArena = CrashTestArena();
    const StringView group = "crash_spool_retention_test";
    RemoveTestArtifacts(testArena.arena, group);

    EXPECT_TRUE(CreatePackageDirectory(testArena.arena, group, s_PendingBucket, s_Crash001));
    EXPECT_TRUE(CreatePackageDirectory(testArena.arena, group, s_PendingBucket, s_Crash002));
    EXPECT_TRUE(CreatePackageDirectory(testArena.arena, group, s_PendingBucket, s_Crash003));
    EXPECT_TRUE(CreatePackageDirectory(testArena.arena, group, s_PendingBucket, "bad package name"));
    EXPECT_TRUE(CreatePackageDirectory(testArena.arena, group, s_UploadedBucket, s_Crash001));
    EXPECT_TRUE(CreatePackageDirectory(testArena.arena, group, s_UploadedBucket, s_Crash002));
    EXPECT_TRUE(CreatePackageDirectory(testArena.arena, group, s_FailedBucket, s_Crash001));
    EXPECT_TRUE(CreatePackageDirectory(testArena.arena, group, s_FailedBucket, s_Crash002));
    EXPECT_TRUE(CreatePackageDirectory(testArena.arena, group, s_UploadingBucket, s_Crash001));
    EXPECT_TRUE(CreatePackageDirectory(testArena.arena, group, s_UploadingBucket, s_Crash002));

    CrashSpoolRetentionConfig retention = CrashSpoolRetentionConfig();
    retention.maxPendingPackages = 2u;
    retention.maxUploadedPackages = 1u;
    retention.maxFailedPackages = 1u;
    retention.maxUploadingPackages = 1u;
    ScratchArena scratchArena(s_OperationScratch);
    EXPECT_TRUE(ApplyCrashSpoolRetention(scratchArena, SpoolDirectory(testArena.arena, group), retention));

    ExpectPathExists(PackageDirectory(testArena.arena, group, s_PendingBucket, s_Crash001), false);
    ExpectIsDirectory(PackageDirectory(testArena.arena, group, s_PendingBucket, s_Crash002), true);
    ExpectIsDirectory(PackageDirectory(testArena.arena, group, s_PendingBucket, s_Crash003), true);
    ExpectIsDirectory(PackageDirectory(testArena.arena, group, s_PendingBucket, "bad package name"), true);
    ExpectPathExists(PackageDirectory(testArena.arena, group, s_UploadedBucket, s_Crash001), false);
    ExpectIsDirectory(PackageDirectory(testArena.arena, group, s_UploadedBucket, s_Crash002), true);
    ExpectPathExists(PackageDirectory(testArena.arena, group, s_FailedBucket, s_Crash001), false);
    ExpectIsDirectory(PackageDirectory(testArena.arena, group, s_FailedBucket, s_Crash002), true);
    ExpectPathExists(PackageDirectory(testArena.arena, group, s_UploadingBucket, s_Crash001), false);
    ExpectIsDirectory(PackageDirectory(testArena.arena, group, s_UploadingBucket, s_Crash002), true);

    RemoveTestArtifacts(testArena.arena, group);
}

