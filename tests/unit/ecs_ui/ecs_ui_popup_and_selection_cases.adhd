void VerifyUiTextEditOwned_OwnedCollectionAdoptionAndCancellationRejectAnotherThread(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    UiEditModel model = UiEditModel(arena.arena);
    UiTextEditSession session = UiTextEditSession(arena.arena, service);
    TextInputEvent event = TextInputEvent(arena.arena);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_EQ(session.begin(s_OwnedTestOwner, s_OwnedTestCaret, model), TextInputAdmission::Accepted);
    b8 cancelled = true;
    native(mut session, mut event, mut model, mut cancelled){
        using namespace __hidden_ui_text_edit_owned_tests;
        TextInputPollResult::Enum poll = TextInputPollResult::Pending;
        TextInputAdmission::Enum adopt = TextInputAdmission::Accepted;
        Thread other([&]()noexcept{
            poll = session.pollOwned(event);
            adopt = session.adoptLocal(s_Owner, model, s_Caret);
            cancelled = session.cancel();
        });
        other.join();
        EXPECT_EQ(poll, TextInputPollResult::WrongThread);
        EXPECT_EQ(adopt, TextInputAdmission::WrongThread);
    }
    EXPECT_FALSE(cancelled);
    EXPECT_TRUE(session.token().valid());
    EXPECT_TRUE(session.cancel());
}

void VerifyUiTextEditSession_TrailingPreeditClearPreservesCommittedSelectedReplacementAndSingleUndo(){
    TestArena arena = TestArena();
    FakeTextInput service = FakeTextInput(arena.arena);
    UiEditModel model = UiEditModel(arena.arena);
    UiTextEditSession session = UiTextEditSession(arena.arena, service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("abcd"));
    ASSERT_TRUE(model.setSelection(1u, 3u));
    ASSERT_EQ(session.begin(s_SessionTestOwner, s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.preedit("xy", 0u, 2u), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(s_SessionTestOwner, model).status, UiTextEditStatus::Applied);
    EXPECT_EQ(model.text(), "abcd");
    EXPECT_FALSE(model.canUndo());
    ASSERT_EQ(service.preedit("xyz", 1u, 3u), TextInputAdmission::Accepted);
    ASSERT_EQ(service.commit("Z"), TextInputAdmission::Accepted);
    ASSERT_EQ(service.preedit(StringView(), 0u, 0u), TextInputAdmission::Accepted);
    const UiTextEditResult result = session.drain(s_SessionTestOwner, model);
    EXPECT_EQ(result.eventsApplied, 3u);
    EXPECT_EQ(model.text(), "aZd");
    EXPECT_FALSE(model.composition().active);
    ASSERT_TRUE(session.end(s_SessionTestOwner, model));
    ASSERT_TRUE(model.undo());
    EXPECT_EQ(model.text(), "abcd");
    EXPECT_EQ(model.anchor(), 1u);
    EXPECT_EQ(model.caret(), 3u);
    EXPECT_FALSE(model.canUndo());
}

