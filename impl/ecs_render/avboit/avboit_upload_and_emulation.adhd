#include <impl/ecs_render/kernel/task_graph_resource_descs.adhd>
#include <impl/ecs_render/avboit/avboit_stage_internal_types.adhd>
#include <impl/ecs_render/kernel/task_graph_scheduling.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class AvboitComputeEmulationOutputPolicy{
    public b8 isAnyComputeEmulationPlanCaptured(in b8 regularCaptured, in b8 csgCaptured)const{
        return regularCaptured || csgCaptured;
    }

    public b8 canProceedWithGeometryReuse(in b8 generatedGeometryReused, in b8 computeEmulationOutputStatesGraphOwned)const{
        return !generatedGeometryReused || computeEmulationOutputStatesGraphOwned;
    }

    public b8 isCsgComputeEmulationRecordReady(in b8 csgFrameBuffersUploaded, in b8 csgHasWork, in b8 csgResourcesFrameReady)const{
        return csgFrameBuffersUploaded && csgHasWork && csgResourcesFrameReady;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanCaptureRegularAvboitComputeEmulation(in b8 csgComputeDrawsEmpty, in b8 geometryOwned, in b8 sampledTexturesCollected){
    return csgComputeDrawsEmpty && geometryOwned && sampledTexturesCollected;
}

b8 CanCaptureCsgAvboitComputeEmulation(in b8 regularComputeDrawsEmpty, in b8 csgStreamsUploaded, in b8 intervalOutputsGraphOwned, in b8 geometryOwned, in b8 sampledTexturesCollected){
    return regularComputeDrawsEmpty && csgStreamsUploaded && intervalOutputsGraphOwned && geometryOwned && sampledTexturesCollected;
}

b8 CanCaptureSharedAvboitComputeEmulation(in b8 regularCaptured, in b8 regularMeshDrawsEmpty, in b8 regularIndexedDrawsEmpty, in b8 csgDrawsEmpty, in b8 geometryOwned, in b8 sampledTexturesCollected){
    return !regularCaptured && regularMeshDrawsEmpty && regularIndexedDrawsEmpty && csgDrawsEmpty && geometryOwned && sampledTexturesCollected;
}

b8 IsAvboitComputeEmulationFrameReady(in b8 planMatches, in b8 materialDrawBuffersUploaded, in b8 frameBindingsReady){
    return planMatches && materialDrawBuffersUploaded && frameBindingsReady;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
Expected<AvboitPassUploadResult> GatherAvboitPassUpload(
    mut RendererMaterialSystem materials,
    in FrameGraphAvboitStageInputs inputs,
    in FramebufferHandle framebuffer,
    in MaterialPipelinePass pass,
    mut MaterialPassDrawItemPartitions drawItems,
    mut InstanceGpuDataVector instanceData,
    mut CsgFrameGpuData csgFrameData,
    mut MaterialTypedInstanceRangeVector materialTypedRanges,
    mut MaterialTypedByteDataVector materialTypedBytes
){
    const AvboitPassUploadReadinessPolicy readinessPolicy();
    AvboitPassUploadResult result;
    materials.gatherMaterialPassDrawItems(
        framebuffer,
        pass,
        true,
        inputs.csgFrameState,
        RendererResourceLookupMode::PreparedOnly,
        Optional<in MeshViewGpuData>(inputs.meshViewState),
        drawItems,
        instanceData,
        csgFrameData,
        materialTypedRanges,
        materialTypedBytes
    );

    result.hasDrawItems = !drawItems.empty();
    result.hasCsgDrawItems = !drawItems.csg.empty();
    if(!result.hasDrawItems)
        return result;
    const b8 csgReady = readinessPolicy.isCsgPassReady(
        result.hasCsgDrawItems,
        csgFrameData.hasWork(),
        inputs.resources.csgReceiverRanges.valid(),
        inputs.resources.csgCutters.valid(),
        inputs.resources.csgClipContextSlots.valid(),
        pass == MaterialPipelinePass::AvboitExtinction,
        inputs.resources.csgIntervalSampleState.valid(),
        inputs.csgResources.frameReady(csgFrameData),
        materials.drawRecorder().materialPassDrawResourcesReady(drawItems.csg, inputs.frameBindings)
    );
    if(!readinessPolicy.arePassResourcesReady(
        inputs.resources.materialInstances.valid(),
        inputs.resources.materialTyped.valid(),
        inputs.frameBindings.frameReady(instanceData.size(), materialTypedBytes.size()),
        materials.drawRecorder().materialPassDrawResourcesReady(drawItems.regular, inputs.frameBindings),
        csgReady
    ))
        return MakeUnexpected(Failure());
    return result;
}

Expected<FrameGraphAvboitMaterialUploadResult> FrameGraphAvboitPassUploadChain::declare(
    in FrameGraphAvboitStageInputs inputs,
    in FramebufferHandle framebuffer,
    in MaterialPipelinePass pass,
    in AvboitGeometryPhase phase,
    in GpuTaskId uploadTask,
    in b8 intervalOutputsGraphOwned,
    in b8 hasTransparentRenderers,
    mut AvboitRasterPassTaskPayload rasterPayload,
    mut AvboitComputeEmulationTaskPayload computeEmulationPayload,
    mut AvboitGeneratedGeometryReuse generatedGeometry,
    mut AvboitUploadedStreamState uploadedStreams
){
    FrameGraphAvboitMaterialUploadResult result;
    result.uploadTask = uploadTask;
    if(!hasTransparentRenderers)
        return result;

    MaterialPassDrawItemPartitions drawItems;
    InstanceGpuDataVector instanceData;
    CsgFrameGpuData csgFrameData;
    MaterialTypedInstanceRangeVector materialTypedRanges;
    MaterialTypedByteDataVector materialTypedBytes;
    const auto uploadResult = GatherAvboitPassUpload(this.m_materialSystem, inputs, framebuffer, pass,
        drawItems,
        instanceData,
        csgFrameData,
        materialTypedRanges,
        materialTypedBytes
    );
    const u64 streamToken = this.m_materialSystem.lastGatheredStreamToken();
    if(!uploadResult.has_value()){
        warning("RendererSystem: prepared AVBOIT pass resources were unavailable during graph declaration");
        return MakeUnexpected(Failure());
    }

    const b8 hasCsgDrawItems = uploadResult.value().hasCsgDrawItems;
    if(hasCsgDrawItems && !intervalOutputsGraphOwned){
        warning("RendererSystem: clipped AVBOIT draws require prepared interval outputs");
        return MakeUnexpected(Failure());
    }
    if(!uploadResult.value().hasDrawItems){
        rasterPayload.snapshot.capture(drawItems, csgFrameData, instanceData.size(), materialTypedBytes.size());
        rasterPayload.phasePrepared = true;
        return result;
    }

    const Array<MaterialPassDrawItemsView, 2u> materialGeometryDrawSets(MaterialPassDrawItemsView(drawItems.regular), MaterialPassDrawItemsView(drawItems.csg));
    const auto geometryPreparationResult = PrepareAvboitMaterialGeometry(this.m_graph, this.m_materialSystem, AvboitGeometryPreparationInputs(materialGeometryDrawSets, phase));
    if(!geometryPreparationResult.has_value())
        return MakeUnexpected(Failure());
    rasterPayload.materialGeometryStatesGraphOwned = geometryPreparationResult.value().geometryOwned;
    result.materialGeometrySet = geometryPreparationResult.value().materialGeometrySet;
    result.materialSampledTextureSet = geometryPreparationResult.value().materialSampledTextureSet;
    const b8 sampledTexturesCollected = geometryPreparationResult.value().sampledTexturesCollected;

    this.m_materialSystem.prepareMaterialPassInstanceUploadData(inputs.csgResources, instanceData);
    if(s_RuntimeAssertionsEnabled){
        if(!AvboitUploadCountsFit(
            instanceData.size(),
            csgFrameData.receiverRanges.size(),
            csgFrameData.cutters.size(),
            usize.max / size_of<InstanceGpuData>(),
            usize.max / size_of<CsgReceiverRangeGpuData>(),
            usize.max / size_of<CsgCutterGpuData>()
        )){
            warning("RendererSystem: AVBOIT upload size overflows graph blob capacity");
            return MakeUnexpected(Failure());
        }
        assert(instanceData.size() == materialTypedRanges.size());
        ValidateMaterialTypedUploadRanges(materialTypedRanges, materialTypedBytes);
    }

    result.csgStreamsUploaded = hasCsgDrawItems;
    CaptureAvboitEmulationPlans(MaterialPassDrawItemPartitionsView(drawItems), CsgFrameGpuDataView(csgFrameData),
        rasterPayload.materialGeometryStatesGraphOwned, sampledTexturesCollected, intervalOutputsGraphOwned, instanceData.size(), materialTypedBytes.size(),
        computeEmulationPayload.plan, computeEmulationPayload.csgPlan, result);
    if(result.regularComputeEmulationPlanCaptured && generatedGeometry.matches(drawItems, instanceData, inputs.frameBindings, inputs.meshViewState, pass))
        result.reusedGeometryProducer = generatedGeometry.producerTask();
    else{
        generatedGeometry.reset();
        result.producesReusableGeometry = result.regularComputeEmulationPlanCaptured && generatedGeometry.capture(drawItems, instanceData, inputs.frameBindings, inputs.meshViewState, pass);
    }
    if(result.regularComputeEmulationPlanCaptured || result.csgComputeEmulationPlanCaptured){
        computeEmulationPayload.instanceCount = instanceData.size();
        computeEmulationPayload.materialTypedByteCount = materialTypedBytes.size();
    }

    const b8 requiresPhaseStreamTask =
        (result.regularComputeEmulationPlanCaptured && !result.reusedGeometryProducer.valid())
        || result.csgComputeEmulationPlanCaptured
        || result.sharedComputeEmulationPlanCaptured;
    in FramebufferInfoEx fbInfo = framebuffer.deref().getFramebufferInfo();
    const CsgFrameGpuDataView csgFrameDataView(csgFrameData);
    const b8 uploadMaterialStreams = requiresPhaseStreamTask || !uploadedStreams.matchesMaterial(streamToken);
    const b8 uploadCsgStreams = hasCsgDrawItems && (requiresPhaseStreamTask || !uploadedStreams.matchesCsg(streamToken, fbInfo.width, fbInfo.height, csgFrameDataView));

    if(uploadMaterialStreams || uploadCsgStreams){
        const auto csgStreamsUploadedResult = DeclareAvboitMaterialUploads(this.m_graph, this.m_csgSystem, inputs, phase,
            instanceData,
            materialTypedBytes,
            csgFrameDataView,
            uploadMaterialStreams,
            uploadCsgStreams,
            result.uploadTask
        );
        if(!csgStreamsUploadedResult.has_value()){
            warning("RendererSystem: could not declare AVBOIT material upload");
            return MakeUnexpected(Failure());
        }
        result.declaredUploadTask = true;
        if(uploadMaterialStreams)
            uploadedStreams.markMaterialUploaded(streamToken);
        if(uploadCsgStreams)
            uploadedStreams.markCsgUploaded(fbInfo.width, fbInfo.height, csgFrameDataView);
    }

    rasterPayload.snapshot.capture(drawItems, csgFrameData, instanceData.size(), materialTypedBytes.size());
    rasterPayload.phasePrepared = true;
    rasterPayload.streamsUploaded = true;
    result.streamsUploaded = true;
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
Expected<AvboitGeometryPreparationResult> PrepareAvboitMaterialGeometry(mut GpuTaskGraph graph, mut RendererMaterialSystem materialSystem, in AvboitGeometryPreparationInputs inputs){
    AvboitGeometryPreparationResult result;
    if(inputs.drawItemSets.empty())
        return MakeUnexpected(Failure());
    const AvboitGeometryPhaseIdentities identities = ResolveAvboitGeometryPhaseIdentities(inputs.phase);
    const auto materialGeometrySetResult = GatherPreparedMaterialGeometryResourceSet(inputs.drawItemSets, identities.geometryIdentity, identities.geometryLabel, graph);
    result.geometryOwned = materialGeometrySetResult.has_value();
    if(materialGeometrySetResult.has_value())
        result.materialGeometrySet = materialGeometrySetResult.value();
    if(!result.geometryOwned){
        warning("RendererSystem: could not declare prepared AVBOIT material geometry states");
        return MakeUnexpected(Failure());
    }
    const auto materialSampledTextureSetResult = GatherPreparedMaterialSampledTextureResourceSet(materialSystem, inputs.drawItemSets, identities.sampledIdentity, identities.sampledLabel, graph);
    result.sampledTexturesCollected = materialSampledTextureSetResult.has_value();
    if(materialSampledTextureSetResult.has_value())
        result.materialSampledTextureSet = materialSampledTextureSetResult.value();
    if(!result.sampledTexturesCollected){
        warning("RendererSystem: could not declare prepared AVBOIT material sampled textures");
        return MakeUnexpected(Failure());
    }
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
Expected<b8> DeclareAvboitMaterialUploads(
    mut GpuTaskGraph graph,
    mut RendererCsgSystem csgSystem,
    in FrameGraphAvboitStageInputs inputs,
    in AvboitGeometryPhase phase,
    in Span<InstanceGpuData> instanceData,
    in Span<u8> materialTypedBytes,
    in CsgFrameGpuDataView csgFrameData,
    in b8 uploadMaterialStreams,
    in b8 uploadCsgStreams,
    mut GpuTaskId inOutUploadTask
){
    if(!inOutUploadTask.valid())
        return MakeUnexpected(Failure());
    if(!AvboitUploadCountsFit(
        instanceData.size(),
        csgFrameData.receiverRanges.size(),
        csgFrameData.cutters.size(),
        usize.max / size_of<InstanceGpuData>(),
        usize.max / size_of<CsgReceiverRangeGpuData>(),
        usize.max / size_of<CsgCutterGpuData>()
    )){
        warning("RendererSystem: AVBOIT upload size overflows graph blob capacity");
        return MakeUnexpected(Failure());
    }

    const AvboitMaterialUploadIdentities identities = ResolveAvboitMaterialUploadIdentities(phase);
    if(uploadMaterialStreams){
        const auto instanceBlobResult = graph.copyUploadElements<InstanceGpuData>(instanceData);
        const auto materialTypedBlobResult = graph.copyUploadBytes<u32>(materialTypedBytes);
        if(!instanceBlobResult.has_value() || !materialTypedBlobResult.has_value()){
            warning("RendererSystem: could not retain immutable AVBOIT material upload data");
            return MakeUnexpected(Failure());
        }
        const GpuUploadBlobId instanceBlob = instanceBlobResult.value();
        const GpuUploadBlobId materialTypedBlob = materialTypedBlobResult.value();

        if(!AppendImmutableBufferUpload(graph, instanceBlob, inputs.resources.materialInstances, identities.instanceIdentity, identities.instanceLabel, inOutUploadTask)){
            warning("RendererSystem: could not declare AVBOIT material instance upload");
            return MakeUnexpected(Failure());
        }
        if(!AppendImmutableBufferUpload(graph, materialTypedBlob, inputs.resources.materialTyped, identities.typedIdentity, identities.typedLabel, inOutUploadTask)){
            warning("RendererSystem: could not declare AVBOIT material typed upload");
            return MakeUnexpected(Failure());
        }
    }

    if(!uploadCsgStreams)
        return false;

    const auto clipContextSlotData = csgSystem.prepareCsgClipContextSlotData(inputs.targets, csgFrameData, inputs.csgResources, inputs.frameBindings);
    if(!clipContextSlotData.has_value()){
        warning("RendererSystem: could not snapshot AVBOIT CSG context data");
        return MakeUnexpected(Failure());
    }
    const auto receiverRangesBlobResult = graph.copyUploadElements<CsgReceiverRangeGpuData>(csgFrameData.receiverRanges);
    const auto cuttersBlobResult = graph.copyUploadElements<CsgCutterGpuData>(csgFrameData.cutters);
    const auto clipContextSlotsBlobResult = graph.copyUploadValue(clipContextSlotData.value());
    if(!receiverRangesBlobResult.has_value() || !cuttersBlobResult.has_value() || !clipContextSlotsBlobResult.has_value()){
        warning("RendererSystem: could not retain immutable AVBOIT CSG upload data");
        return MakeUnexpected(Failure());
    }
    const GpuUploadBlobId receiverRangesBlob = receiverRangesBlobResult.value();
    const GpuUploadBlobId cuttersBlob = cuttersBlobResult.value();
    const GpuUploadBlobId clipContextSlotsBlob = clipContextSlotsBlobResult.value();

    if(!AppendImmutableBufferUpload(graph, receiverRangesBlob, inputs.resources.csgReceiverRanges, identities.receiverIdentity, identities.receiverLabel, inOutUploadTask)){
        warning("RendererSystem: could not declare AVBOIT CSG receiver-range upload");
        return MakeUnexpected(Failure());
    }
    if(!AppendImmutableBufferUpload(graph, cuttersBlob, inputs.resources.csgCutters, identities.cutterIdentity, identities.cutterLabel, inOutUploadTask)){
        warning("RendererSystem: could not declare AVBOIT CSG cutter upload");
        return MakeUnexpected(Failure());
    }
    if(!AppendImmutableBufferUpload(graph, clipContextSlotsBlob, inputs.resources.csgClipContextSlots, identities.clipIdentity, identities.clipLabel, inOutUploadTask)){
        warning("RendererSystem: could not declare AVBOIT CSG clip-context upload");
        return MakeUnexpected(Failure());
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
void CaptureAvboitEmulationPlans(
    in MaterialPassDrawItemPartitionsView drawItems,
    in CsgFrameGpuDataView frame,
    in b8 geometryOwned,
    in b8 sampledTexturesCollected,
    in b8 intervalOutputsGraphOwned,
    in usize instanceCount,
    in usize materialTypedByteCount,
    mut AliasFreeComputeEmulationGraphPlan plan,
    mut OpaqueCsgIntervalSampleComputeEmulationGraphPlan csgPlan,
    mut FrameGraphAvboitMaterialUploadResult result
){
    result.regularComputeEmulationPlanCaptured = CanCaptureRegularAvboitComputeEmulation(drawItems.csg.computeDrawItems.empty(), geometryOwned, sampledTexturesCollected) && plan.capture(drawItems.regular, false);
    result.csgComputeEmulationPlanCaptured = CanCaptureCsgAvboitComputeEmulation(
        drawItems.regular.computeDrawItems.empty(),
        result.csgStreamsUploaded,
        intervalOutputsGraphOwned,
        geometryOwned,
        sampledTexturesCollected
    ) && csgPlan.capture(drawItems.csg, frame);
    result.sharedComputeEmulationPlanCaptured = CanCaptureSharedAvboitComputeEmulation(
        result.regularComputeEmulationPlanCaptured,
        drawItems.regular.meshDrawItems.empty(),
        drawItems.regular.indexedDrawItems.empty(),
        drawItems.csg.empty(),
        geometryOwned,
        sampledTexturesCollected
    ) && result.sharedComputeEmulationPlan.capture(drawItems.regular, s_SharedComputeEmulationMaximumDrawCount)
        && IsSupportedSharedComputeEmulationDrawCount(result.sharedComputeEmulationPlan.drawCount);
    assert(!(result.regularComputeEmulationPlanCaptured && result.csgComputeEmulationPlanCaptured));
    assert(!result.sharedComputeEmulationPlanCaptured || (!result.regularComputeEmulationPlanCaptured && !result.csgComputeEmulationPlanCaptured));
    if(result.sharedComputeEmulationPlanCaptured){
        result.sharedComputeEmulationInstanceCount = instanceCount;
        result.sharedComputeEmulationMaterialTypedByteCount = materialTypedByteCount;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
b8 PrepareAvboitEmulationOutputs(
    mut GpuTaskGraph graph,
    in FrameGraphAvboitMaterialUploadResult upload,
    in AvboitRasterRecordPhaseDesc phaseDesc,
    mut AvboitRasterPassTaskPayload rasterPayload,
    in AvboitComputeEmulationTaskPayload computeEmulationPayload,
    mut Optional<GpuTimingMeasure> computeEmulationTiming,
    mut AvboitComputeEmulationOutputs result
){
    const AvboitComputeEmulationOutputPolicy outputPolicy();
    const b8 generatedGeometryReused = upload.reusedGeometryProducer.valid();

    const b8 computeEmulationPlanCaptured = outputPolicy.isAnyComputeEmulationPlanCaptured(upload.regularComputeEmulationPlanCaptured, upload.csgComputeEmulationPlanCaptured);
    if(upload.regularComputeEmulationPlanCaptured){
        const auto outputSetResult = GatherImportedOutputBufferResourceSet(
            graph,
            computeEmulationPayload.plan.captured,
            computeEmulationPayload.plan.outputBuffers,
            phaseDesc.regularOutputSetIdentity,
            phaseDesc.regularOutputSetLabel
        );
        result.computeEmulationOutputStatesGraphOwned = outputSetResult.has_value();
        if(outputSetResult.has_value())
            result.computeEmulationOutputSet = outputSetResult.value();
    }
    else if(upload.csgComputeEmulationPlanCaptured){
        const auto outputSetResult = GatherImportedOutputBufferResourceSet(
            graph,
            computeEmulationPayload.csgPlan.geometry.generated.captured,
            computeEmulationPayload.csgPlan.geometry.generated.outputBuffers,
            phaseDesc.csgOutputSetIdentity,
            phaseDesc.csgOutputSetLabel
        );
        result.computeEmulationOutputStatesGraphOwned = outputSetResult.has_value();
        if(outputSetResult.has_value())
            result.computeEmulationOutputSet = outputSetResult.value();
    }
    if(computeEmulationPlanCaptured && !result.computeEmulationOutputStatesGraphOwned)
        warning("RendererSystem: could not declare graph-owned AVBOIT compute-emulation output states");
    if(!outputPolicy.canProceedWithGeometryReuse(generatedGeometryReused, result.computeEmulationOutputStatesGraphOwned))
        return false;
    rasterPayload.computeEmulationOutputStatesGraphOwned = upload.regularComputeEmulationPlanCaptured && result.computeEmulationOutputStatesGraphOwned;
    rasterPayload.csgComputeEmulationOutputStatesGraphOwned = upload.csgComputeEmulationPlanCaptured && result.computeEmulationOutputStatesGraphOwned;
    if(result.computeEmulationOutputStatesGraphOwned)
        rasterPayload.computeEmulationTiming = Optional<mut Optional<GpuTimingMeasure>>(computeEmulationTiming);
    else
        rasterPayload.computeEmulationTiming.reset();

    if(upload.sharedComputeEmulationPlanCaptured){
        const auto sharedOutputResult = GatherRegularSharedComputeEmulationResource(graph, upload.sharedComputeEmulationPlan, phaseDesc.sharedOutputLabel);
        result.sharedComputeEmulationOutputStatesGraphOwned = sharedOutputResult.has_value();
        if(sharedOutputResult.has_value())
            result.sharedComputeEmulationOutput = sharedOutputResult.value();
    }
    if(upload.sharedComputeEmulationPlanCaptured && !result.sharedComputeEmulationOutputStatesGraphOwned)
        warning("RendererSystem: could not declare graph-owned AVBOIT shared compute-emulation output state");

    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 AvboitComputeEmulationTaskPayload::record(mut CommandList commands, in GpuTaskRecordContext context)const{
    const auto trait = GetAvboitComputeEmulationRecordTrait(this.pass);
    const FramebufferHandle framebuffer = SelectAvboitTargetFramebuffer(this.targets.avboit, trait.framebufferKind);
    const b8 csg = this.csgPlan.geometry.generated.captured;
    if(!HasValidAvboitComputeEmulationRecordInputs(framebuffer.valid(), this.plan.captured, csg))
        return false;
    GpuTimingTicketRecordingScope recording(this.timingTicket);
    b8 matches = false;
    if(csg)
        matches = this.csgPlan.geometry.generated.matches();
    else
        matches = this.plan.matches();
    if(!IsAvboitComputeEmulationFrameReady(matches, this.materialDrawBuffersUploaded, this.frameBindings.frameReady(this.instanceCount, this.materialTypedByteCount)))
        return false;
    Span<MaterialPassDrawItem> draws = this.plan.drawItems;
    if(csg){
        draws = this.csgPlan.geometry.generated.drawItems;
        if(!this.materialSystem.drawRecorder().materialPassDrawResourcesReady(this.csgPlan.geometry.drawItemsView(), this.frameBindings))
            return false;
        const auto csgFrame = this.csgPlan.csgFrameDataView();
        if(!AvboitComputeEmulationOutputPolicy().isCsgComputeEmulationRecordReady(this.csgFrameBuffersUploaded, csgFrame.hasWork(), this.csgResources.frameReady(csgFrame)))
            return false;
    }else if(!this.materialSystem.drawRecorder().computeMaterialPassDrawResourcesReady(draws, this.frameBindings))
        return false;
    if(this.timing.has_value())
        return false;

    commands.endRenderPass();
    this.timing.emplace(this.graphics.gpuTiming(), trait.timingScope, this.graphics.getDevice(), commands);
    if(!FinishSplitGpuTimingMarker(this.timing))
        return false;
    ViewportState viewport;
    viewport.addViewportAndScissorRect(framebuffer.deref().getFramebufferInfo().getViewport());
    MaterialPassDrawContext drawContext(commands, viewport, this.frameBindings, this.pass, this.materialFrameStatesGraphOwned, this.materialGeometryStatesGraphOwned, true);
    drawContext.setAvboitTargets(this.targets.avboit).setConservativeGeometryScissor(this.conservativeGeometryScissor);
    if(csg)
        drawContext.setCsgResources(this.csgResources);
    this.materialSystem.drawRecorder().generateComputeMaterialPassDrawItems(drawContext, draws);
    return true;
}

b8 AvboitSharedComputeEmulationTaskPayload::record(mut CommandList commands, in GpuTaskRecordContext context)const{
    const auto trait = GetAvboitComputeEmulationRecordTrait(this.pass);
    const FramebufferHandle framebuffer = SelectAvboitTargetFramebuffer(this.targets.avboit, trait.framebufferKind);
    if(!HasValidAvboitSharedComputeEmulationRecordInputs(framebuffer.valid(), this.plan.captured, this.drawIndex, this.plan.drawCount))
        return false;
    GpuTimingTicketRecordingScope recording(this.timingTicket);
    if(!IsAvboitComputeEmulationFrameReady(this.plan.matches(this.drawIndex), this.materialDrawBuffersUploaded, this.frameBindings.frameReady(this.instanceCount, this.materialTypedByteCount)))
        return false;
    const Span<MaterialPassDrawItem> allDraws = this.plan.drawItems;
    const Span<MaterialPassDrawItem> draws = allDraws.subspan(this.drawIndex, 1u);
    if(!this.materialSystem.drawRecorder().computeMaterialPassDrawResourcesReady(draws, this.frameBindings))
        return false;

    const b8 generate = this.phase == SharedComputeEmulationPhase::Generate;
    if(generate)
        commands.endRenderPass();
    if(generate && this.beginTiming){
        if(this.timing.has_value())
            return false;
        this.timing.emplace(this.graphics.gpuTiming(), trait.timingScope, this.graphics.getDevice(), commands);
        if(!FinishSplitGpuTimingMarker(this.timing))
            return false;
    }else if(!this.timing.has_value())
        return false;

    ViewportState viewport;
    viewport.addViewportAndScissorRect(framebuffer.deref().getFramebufferInfo().getViewport());
    MaterialPassDrawContext drawContext(commands, viewport, this.frameBindings, this.pass, this.materialFrameStatesGraphOwned, this.materialGeometryStatesGraphOwned, true);
    drawContext.setAvboitTargets(this.targets.avboit);
    if(generate)
        this.materialSystem.drawRecorder().generateComputeMaterialPassDrawItems(drawContext, draws);
    else{
        drawContext.setFramebuffer(framebuffer);
        this.materialSystem.drawRecorder().renderComputeMaterialPassDrawItemsRasterOnly(drawContext, draws);
        if(this.finishTiming){
            this.timing.value().finishTiming(commands);
            this.timing.reset();
        }
        commands.endRenderPass();
    }
    return true;
}

b8 AvboitRasterPassTaskPayload::record(mut CommandList commands, in GpuTaskRecordContext context)const{
    if((this.computeEmulationOutputStatesGraphOwned || this.csgComputeEmulationOutputStatesGraphOwned) && !this.generatedGeometryReused && !this.computeEmulationTiming.has_value())
        return false;
    GpuTimingTicketRecordingScope recording(this.timingTicket);
    if(!this.hasTransparentRenderers)
        return true;
    if(!this.phasePrepared || !this.snapshot.captured)
        return false;
    this.avboitSystem.renderPreparedGraphPass(commands, this.targets, this.pass, this.snapshot, this.csgResources,
        this.frameBindings, this.materialFrameStatesGraphOwned, this.materialGeometryStatesGraphOwned,
        this.computeEmulationOutputStatesGraphOwned, this.csgComputeEmulationOutputStatesGraphOwned, this.generatedGeometryReused, this.computeEmulationTiming);
    return true;
}


