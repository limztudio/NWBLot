void VerifyUiComboLoanTests_ReconcileCallbackSelectionRejectsBeforeAnyQueuedCommitIsApplied(mut UiComboLoanTests self){
    self.m_state.select(1u);
    self.m_state.open();
    ASSERT_TRUE(self.acceptCallbacks(1u));
    const Optional<HitTarget> rowTarget = self.findTarget(self.row(2u));
    ASSERT_TRUE(rowTarget.has_value());
    self.click(CenterUiRect(rowTarget.value().rectangle));
    self.m_callbacks.arm(UiComboLoanMutationKind::KeySelect, 8u);
    EXPECT_FALSE(self.declareCallbacks(2u));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_result.valid);
    EXPECT_FALSE(self.m_result.committed);
    EXPECT_EQ(self.m_state.selectedKey(), 8u);
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
}

void VerifyUiComboLoanTests_ClosedUserPopupSuppressesLaterComboBeforeSourceOrModelCallbacks(mut UiComboLoanTests self){
    PopupState popupState = PopupState();
    popupState.open();
    PopupOptions options = PopupOptions();
    options.anchor = MakeUiComboLoanRect(30.0f, 40.0f, 100.0f, 30.0f);
    options.size = MakeUiComboLoanPoint(280.0f, 200.0f);
    self.m_state.select(1u);
    const u64 inputGeneration = self.m_state.inputGeneration();
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPopup("owner", popupState, options));
    popupState.close();
    self.m_callbacks.arm(UiComboLoanMutationKind::RevisionSelect, 8u);
    const ComboResult result = self.m_builder.comboBox(s_UiComboLoanKey, self.m_callbacks, self.m_state, MakeUiComboLoanDefaultOptions());
    EXPECT_TRUE(result.valid);
    EXPECT_FALSE(self.m_context.failed());
    EXPECT_EQ(self.m_callbacks.mutations(), 0u);
    EXPECT_EQ(self.m_state.inputGeneration(), inputGeneration);
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    ASSERT_TRUE(self.m_builder.endPopup());
    EXPECT_FALSE(self.m_context.commitFrame(1u));
}

void VerifyUiComboLoanTests_MatchingPanelEndReleasesItsSourceAndStateBeforeTheNextPanel(mut UiComboLoanTests self){
    self.m_state.select(1u);
    self.m_state.open();
    ASSERT_TRUE(self.declareCallbacks(1u));
    ASSERT_TRUE(self.m_builder.endPanel());
    self.m_state.select(8u);
    self.m_callbacks.arm(UiComboLoanMutationKind::RevisionSelect, 9u);
    self.m_callbacks.count = 0u;
    ++self.m_callbacks.contentRevision;
    ASSERT_TRUE(self.m_builder.beginPanel("later", MakeUiComboLoanRect(400.0f, 10.0f, 200.0f, 120.0f)));
    ASSERT_TRUE(self.m_builder.label("label", "Later panel"));
    ASSERT_TRUE(self.m_builder.endPanel());
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    EXPECT_EQ(self.m_callbacks.mutations(), 0u);
    EXPECT_EQ(self.m_state.selectedKey(), 8u);
    EXPECT_TRUE(self.findTarget(self.popup()).has_value());
}

void VerifyUiComboLoanTests_LaterPopupTextCannotChangeAnEarlierComboAfterItsPaint(mut UiComboLoanTests self){
    self.m_state.select(1u);
    self.m_state.open();
    ComboState other = ComboState();
    other.select(2u);
    other.open();
    ASSERT_TRUE(DeclareUiComboLoanPair(self, 1u, self.m_callbacks, other));
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const UiComboLoanAcceptedState displayed = self.accepted();
    ASSERT_TRUE(DeclareUiComboLoanPair(self, 2u, self.m_callbacks, other));
    self.m_callbacks.arm(UiComboLoanMutationKind::TextSelect, 8u);
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_callbacks.mutations(), 1u);
    EXPECT_EQ(self.m_state.selectedKey(), 8u);
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_EQ(other.selectedKey(), 2u);
    EXPECT_TRUE(other.isOpen());
    self.expectAccepted(displayed);
}

void VerifyUiComboLoanTests_LaterPopupTextCannotChangeTheEarlierSourceAfterItsLoanWasChecked(mut UiComboLoanTests self){
    self.m_state.select(1u);
    self.m_state.open();
    ComboState other = ComboState();
    other.select(2u);
    other.open();
    UiComboLoanForeignRevisionSource source = UiComboLoanForeignRevisionSource(self.m_source);
    ASSERT_TRUE(DeclareUiComboLoanPair(self, 1u, source, other));
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const UiComboLoanAcceptedState displayed = self.accepted();
    const u64 revision = self.m_source.contentRevision;
    ASSERT_TRUE(DeclareUiComboLoanPair(self, 2u, source, other));
    source.arm();
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(source.mutations(), 1u);
    EXPECT_EQ(self.m_source.contentRevision, revision + 1u);
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_EQ(other.selectedKey(), 2u);
    self.expectAccepted(displayed);
}


