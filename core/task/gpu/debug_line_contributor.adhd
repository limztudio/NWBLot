[cpp_header("<core/task/gpu/debug_line_contributor.h>"), cpp_name("::NWB::Core::GpuDebugLineVertex"), cpp_flags(binary_serializable, brace_init)]
extern class GpuDebugLineVertex{
    f32x4 positionPad;
    f32x4 color;
};

[cpp_header("<core/task/gpu/debug_line_contributor.h>"), cpp_name("::NWB::Core::GpuDebugLineCollector")]
extern class GpuDebugLineCollector{
    void clear();
    void reserve(in usize depthTestedVertexCapacity, in usize overlayVertexCapacity);
    void pushDepthTestedLine(in f32x4 start, in f32x4 end, in f32x4 color);
    void pushOverlayLine(in f32x4 start, in f32x4 end, in f32x4 color);
    Span<GpuDebugLineVertex> depthTestedVertices()const;
    Span<GpuDebugLineVertex> overlayVertices()const;
    b8 empty()const;
};

[cpp_header("<core/task/gpu/debug_line_contributor.h>"), cpp_name("::NWB::Core::IDebugLineProvider")]
extern class IDebugLineProvider{
    b8 hasDebugLines()const;
    void collectDebugLines(mut GpuDebugLineCollector collector, in MatrixSingle viewProj);
};


