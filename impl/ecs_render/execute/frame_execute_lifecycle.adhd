        this.renderer = renderer;
        this.m_accumulatorStateCandidate = GpuPersistentStateCandidate(renderer.m_hardwareCausticAccumulatorPersistentState);
    }

    [cpp_unwind]
    public b8 recorded(in Optional<in CommandListResourceStateHandoff> finalState){
        if(this.accumulatorTextures.empty() || !finalState.has_value())
            return false;

        const b8 accumulatorStateReady = this.renderer.m_hardwareCausticAccumulatorPersistentState.buildFilteredResourceSubset(finalState.value(), this.accumulatorTextures, Span<BufferHandle>(), this.m_accumulatorStateCandidate);
        this.statePrepared = accumulatorStateReady;
        return this.statePrepared;
    }
    public b8 accepted(in QueueSubmissionToken token){
        if(!this.statePrepared)
            return false;

        const b8 accumulatorStateReady = this.renderer.m_hardwareCausticAccumulatorPersistentState.commit(this.m_accumulatorStateCandidate);
        this.stateReady = accumulatorStateReady;
        return this.stateReady;
    }
}

class DeferredLightingStateLifecycleContext{
    public mut RendererFramePipeline renderer;
    public mut DeferredFrameTargets targets;
    private GpuPersistentStateCandidate m_shadowReturnStateCandidate;
    private GpuPersistentStateCandidate m_causticReturnStateCandidate;
    private GpuPersistentStateCandidate m_surfelReturnStateCandidate;
    public Span<TextureHandle> shadowReturnTextures;
    public Span<TextureHandle> causticReturnTextures;
    public Span<TextureHandle> surfelReturnTextures;
    public b8 usesLaggedHistory = false;
    public b8 statePrepared = false;
    public b8 stateReady = false;

    public DeferredLightingStateLifecycleContext(mut RendererFramePipeline renderer, mut DeferredFrameTargets targets){
        this.renderer = renderer;
        this.targets = targets;
        this.m_shadowReturnStateCandidate = GpuPersistentStateCandidate(renderer.m_shadowVisibilityReturnState);
        this.m_causticReturnStateCandidate = GpuPersistentStateCandidate(renderer.m_causticIrradianceReturnState);
        this.m_surfelReturnStateCandidate = GpuPersistentStateCandidate(renderer.m_surfelIrradianceReturnState);
    }

    [cpp_unwind]
    public b8 recorded(in Optional<in CommandListResourceStateHandoff> finalState){
        if(this.shadowReturnTextures.empty() || this.causticReturnTextures.empty() || this.surfelReturnTextures.empty() || !finalState.has_value())
            return false;

        b8 shadowStateReady = true;
        b8 causticStateReady = true;
        b8 surfelStateReady = true;
        if(ShouldBuildDirectDeferredLightingReturnStates(this.usesLaggedHistory)){
            shadowStateReady = this.renderer.m_shadowVisibilityReturnState.buildFilteredResourceSubset(finalState.value(), this.shadowReturnTextures, Span<BufferHandle>(), this.m_shadowReturnStateCandidate);
            causticStateReady = this.renderer.m_causticIrradianceReturnState.buildFilteredResourceSubset(finalState.value(), this.causticReturnTextures, Span<BufferHandle>(), this.m_causticReturnStateCandidate);
            surfelStateReady = this.renderer.m_surfelIrradianceReturnState.buildFilteredResourceSubset(finalState.value(), this.surfelReturnTextures, Span<BufferHandle>(), this.m_surfelReturnStateCandidate);
        }
        this.statePrepared = AreTriplePersistentStateSubsetsReady(shadowStateReady, causticStateReady, surfelStateReady);
        return this.statePrepared;
    }
    [cpp_unwind]
    public b8 accepted(in QueueSubmissionToken token){
        if(!this.statePrepared)
            return false;

        mut RendererFramePipeline renderer = this.renderer;
        if(this.usesLaggedHistory)
            this.targets.laggedLightingHistory.slotsUploaded = true;
        b8 shadowStateReady = true;
        b8 causticStateReady = true;
        b8 surfelStateReady = true;
        if(ShouldBuildDirectDeferredLightingReturnStates(this.usesLaggedHistory)){
            shadowStateReady = renderer.m_shadowVisibilityReturnState.commit(this.m_shadowReturnStateCandidate);
            causticStateReady = renderer.m_causticIrradianceReturnState.commit(this.m_causticReturnStateCandidate);
            surfelStateReady = renderer.m_surfelIrradianceReturnState.commit(this.m_surfelReturnStateCandidate);
        }
        this.stateReady = AreTriplePersistentStateSubsetsReady(shadowStateReady, causticStateReady, surfelStateReady);
        if(!this.stateReady)
            return false;
        if(this.usesLaggedHistory)
            renderer.reportLaggedLightingTransition(LaggedLightingReport::ActiveHistoryAccepted, this.targets.laggedLightingHistory.generation);
        return true;
    }
}


