void VerifyGpuPassTimingProbe_ReportsEveryRegisteredScopeBeyondSixtyFour(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TimingRecorder recorder = TimingRecorder(testArena.arena);
    recorder.setEnabled(true);
    const u32 s_ScopeCount = 96u;
    Name lastScope = s_NameNone;
    for(u32 index = 0u; index < s_ScopeCount; ++index){
        const Expected<Name> scopeName = MakeDecimalScopeName(index);
        ASSERT_TRUE(scopeName.has_value());
        lastScope = scopeName.value();
        const Expected<TimingScopeId> scopeResult = recorder.registerScope(lastScope);
        ASSERT_TRUE(scopeResult.has_value());
        const TimingScopeId scope = scopeResult.value();
        ASSERT_TRUE(scope.valid());
        recorder.recordSample(scope, 0.001, 1u);
    }
    recorder.publishFrame(1u);
    const TimingView view = TimingView(recorder);
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration = LoggerRegistrationGuard(logger);
    native(in view){
        Tests::Smoke::GpuPassTimingProbe probe(NWB_TEXT("Probe regression"));
        probe.recordFrame(0.25f, view);
        probe.recordFrame(0.25f, view);
    }

    EXPECT_EQ(logger.messageCount(), s_ScopeCount + 1u);
    String expectedScopeLine = String("  ");
    expectedScopeLine += lastScope.resolvedText();
    expectedScopeLine += ": gpu_window_ms";
    EXPECT_TRUE(SawCapturedMessage(logger, StringView(expectedScopeLine)));
    EXPECT_FALSE(SawCapturedMessage(logger, "published_windows=2"));
}

void VerifyGpuPassTimingProbe_GrowthPreservesAccumulationAndWatermarksAcrossIntervals(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TimingRecorder recorder = TimingRecorder(testArena.arena);
    recorder.setEnabled(true);
    const Expected<TimingScopeId> firstScopeResult = recorder.registerScope(s_TelemetryCaseTestsProbeFirst);
    ASSERT_TRUE(firstScopeResult.has_value());
    const TimingScopeId firstScope = firstScopeResult.value();
    ASSERT_TRUE(firstScope.valid());
    recorder.recordSample(firstScope, 0.003, 1u);
    recorder.publishFrame(1u);
    const TimingView view = TimingView(recorder);
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration = LoggerRegistrationGuard(logger);

    const u32 s_AddedScopes = 96u;
    native(in s_AddedScopes, in firstScope, in view, mut recorder, in logger){
        Tests::Smoke::GpuPassTimingProbe probe(NWB_TEXT("Probe growth"));
        probe.recordFrame(0.25f, view);
        TimingScopeId lastScope;
        for(u32 index = 0u; index < s_AddedScopes; ++index){
            const auto scopeName = MakeDecimalScopeName(index);
            ASSERT_TRUE(scopeName.has_value());
            const auto scopeResult = recorder.registerScope(scopeName.value());
            ASSERT_TRUE(scopeResult.has_value());
            lastScope = scopeResult.value();
            ASSERT_TRUE(lastScope.valid());
        }
        probe.recordFrame(0.25f, view);
        EXPECT_EQ(logger.messageCount(), 2u);
        EXPECT_FALSE(SawCapturedMessage(logger, "published_windows=2"));

        // The old publication remains visible, but the next interval must not count it again.
        probe.recordFrame(0.25f, view);
        probe.recordFrame(0.25f, view);
        EXPECT_EQ(logger.messageCount(), 3u);

        recorder.recordSample(firstScope, 0.002, 2u);
        recorder.recordSample(lastScope, 0.004, 2u);
        recorder.publishFrame(2u);
        probe.recordFrame(0.25f, view);
        probe.recordFrame(0.25f, view);
    }
    EXPECT_EQ(logger.messageCount(), 6u);
    String expectedScopeLine = String("  ");
    expectedScopeLine += recorder.scopeNameAt(s_AddedScopes).resolvedText();
    expectedScopeLine += ": gpu_window_ms";
    EXPECT_TRUE(SawCapturedMessage(logger, StringView(expectedScopeLine)));
    EXPECT_FALSE(SawCapturedMessage(logger, "published_windows=2"));
}

