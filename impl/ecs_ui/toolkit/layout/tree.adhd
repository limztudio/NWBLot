#include <impl/ecs_ui/toolkit/layout/tree_arrangement.adhd>
#include <impl/ecs_ui/toolkit/layout/types.adhd>
#include <impl/ecs_ui/toolkit/layout/validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class LayoutTree : NoCopy{
    private Vector<LayoutTreeNode> m_nodes;
    private Vector<Rect> m_inheritedClips;
    private Vector<LayoutBox> m_boxes;
    private Vector<LayoutBox> m_stagedBoxes;
    private u32 m_maxNodes;
    private b8 m_buildFailed = false;

    public LayoutTree(){
        this.m_maxNodes = s_LayoutMaxNodes;
        const u32 initialReserve = Min(this.m_maxNodes, s_LayoutInitialReserve);
        this.m_nodes.reserve(initialReserve);
        this.m_inheritedClips.reserve(initialReserve);
        this.m_boxes.reserve(initialReserve);
        this.m_stagedBoxes.reserve(initialReserve);
    }

    public LayoutTree(in u32 maxNodes){
        this.m_maxNodes = Min(maxNodes, s_LayoutMaxNodes);
        const u32 initialReserve = Min(this.m_maxNodes, s_LayoutInitialReserve);
        this.m_nodes.reserve(initialReserve);
        this.m_inheritedClips.reserve(initialReserve);
        this.m_boxes.reserve(initialReserve);
        this.m_stagedBoxes.reserve(initialReserve);
    }

    public void reset(){
        this.m_nodes.clear();
        this.m_inheritedClips.clear();
        this.m_stagedBoxes.clear();
        this.m_buildFailed = false;
    }

    public Expected<u32> addNode(in u32 parent, in LayoutNodeDesc description){
        const Expected<u32> index = TryAppendLayoutTreeNode(this.m_nodes, this.m_maxNodes, this.m_buildFailed, parent, description);
        if(!index.has_value()){
            this.m_buildFailed = true;
            return MakeUnexpected(Failure());
        }
        return index.value();
    }

    public b8 arrange(in Rect viewport){
        return ArrangeLayoutTree(
            Span<LayoutTreeNode>(this.m_nodes),
            this.m_buildFailed,
            viewport,
            this.m_inheritedClips,
            this.m_stagedBoxes,
            this.m_boxes
        );
    }

    public u32 nodeCount()const{
        return cast<u32>(this.m_nodes.size());
    }

    public Optional<LayoutBox> box(in u32 index)const{
        if(index < this.m_boxes.size())
            return Optional<LayoutBox>(this.m_boxes[index]);
        return Optional<LayoutBox>();
    }

    public in Vector<LayoutBox> boxes()const{
        return this.m_boxes;
    }

    public in Vector<LayoutTreeNode> nodes()const{
        return this.m_nodes;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

