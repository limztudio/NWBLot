    requests[1u].shadowSlot = 1u;
    requests[1u].lightIndex = 0u;
    EXPECT_FALSE(TryBuildLightSpacePlan(settings, LightRequestSpan(requests.data(), 2u), u32.max, 20u, false).has_value());
    requests[1u].lightIndex = 64u;
