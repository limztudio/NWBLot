}

void VerifyUiScrollbarLayoutTests_ExactFitAfterOtherAxisReservationDoesNotAddBar(){
    const Rect bounds = Rect(0.0f, 0.0f, 100.0f, 100.0f);
    const auto placementResult = CalculateScrollViewportPlacement(bounds, bounds, Insets(), Point(87.0f, 200.0f), 1.0f, Point(), 12.0f, 16.0f);
    ASSERT_TRUE(placementResult.has_value());
    ScrollViewportPlacement placement = placementResult.value();
    ExpectUiRect(placement.viewport, Rect(0.0f, 0.0f, 88.0f, 100.0f));
    EXPECT_FALSE(placement.horizontal.visible);
    EXPECT_TRUE(placement.vertical.visible);
    const auto placementResult2 = CalculateScrollViewportPlacement(bounds, bounds, Insets(), Point(199.0f, 88.0f), 1.0f, Point(), 12.0f, 16.0f);
    ASSERT_TRUE(placementResult2.has_value());
    placement = placementResult2.value();
    ExpectUiRect(placement.viewport, Rect(0.0f, 0.0f, 100.0f, 88.0f));
    EXPECT_TRUE(placement.horizontal.visible);
    EXPECT_FALSE(placement.vertical.visible);
}

void VerifyUiScrollbarLayoutTests_SmallerContentRemovesReservationsAndClampsBothAxes(){
    const Rect bounds = Rect(0.0f, 0.0f, 100.0f, 100.0f);
