using AdhdTestArena = AdhdCompilerTestsDetail::AdhdTestArena;
using MockIncludeResolver = AdhdCompilerTestsDetail::MockIncludeResolver;
using CompileResult = Core::Metascript::Adhd::CompileResult;
using MString = Core::Metascript::MString;
using MStringView = Core::Metascript::MStringView;
using MetaArena = Core::Metascript::MetaArena;
using Core::Metascript::Adhd::Compiler::Compile;
using Core::Metascript::Adhd::Compiler::DeriveNamespaceFromPath;

[[nodiscard]] FOUNDATION_INLINE b8 CompileWithResolver(
    const MStringView source,
    const MStringView virtualFilePath,
    Core::Metascript::IIncludeResolver& resolver,
    MetaArena& arena,
    CompileResult& outResult
){
    return Compile(source, virtualFilePath, &resolver, arena, outResult);
}

[[nodiscard]] FOUNDATION_INLINE AStringView GeneratedHeaderView(const CompileResult& result)noexcept{
    return AStringView(result.generatedHeader);
}

[[nodiscard]] FOUNDATION_INLINE AStringView GeneratedSourceView(const CompileResult& result)noexcept{
    return AStringView(result.generatedSource);
}

[[nodiscard]] FOUNDATION_INLINE AStringView FirstErrorMessage(const CompileResult& result)noexcept{
    return AStringView(result.errors[0u].message);
}

[[nodiscard]] FOUNDATION_INLINE AStringView MStringAsView(const MString& text)noexcept{
    return AStringView(text);
}

[[nodiscard]] FOUNDATION_INLINE usize UnitClassCount(const CompileResult& result)noexcept{
    return result.unit.classes.size();
}

[[nodiscard]] FOUNDATION_INLINE b8 UnitClassIsSerialize(const CompileResult& result, const usize classIdx)noexcept{
    return result.unit.classes[classIdx]->isSerialize;
}

[[nodiscard]] FOUNDATION_INLINE usize UnitClassTotalAlign(const CompileResult& result, const usize classIdx)noexcept{
    return result.unit.classes[classIdx]->totalAlign;
}

[[nodiscard]] FOUNDATION_INLINE usize UnitClassTotalSize(const CompileResult& result, const usize classIdx)noexcept{
    return result.unit.classes[classIdx]->totalSize;
}

[[nodiscard]] FOUNDATION_INLINE AStringView UnitClassName(const CompileResult& result, const usize classIdx)noexcept{
    return AStringView(result.unit.classes[classIdx]->name);
}

[[nodiscard]] FOUNDATION_INLINE usize UnitClassOrderedFieldCount(const CompileResult& result, const usize classIdx)noexcept{
    return result.unit.classes[classIdx]->orderedFields.size();
}

[[nodiscard]] FOUNDATION_INLINE AStringView UnitClassOrderedFieldName(const CompileResult& result, const usize classIdx, const usize fieldIdx)noexcept{
    return AStringView(result.unit.classes[classIdx]->orderedFields[fieldIdx]->name);
}

[[nodiscard]] FOUNDATION_INLINE usize UnitClassOrderedFieldAlign(const CompileResult& result, const usize classIdx, const usize fieldIdx)noexcept{
    return result.unit.classes[classIdx]->orderedFields[fieldIdx]->resolvedAlign;
}

[[nodiscard]] FOUNDATION_INLINE usize UnitClassOrderedFieldOffset(const CompileResult& result, const usize classIdx, const usize fieldIdx)noexcept{
    return result.unit.classes[classIdx]->orderedFields[fieldIdx]->resolvedOffset;
}

[[nodiscard]] FOUNDATION_INLINE usize UnitTemplateInstCount(const CompileResult& result)noexcept{
    return result.unit.templateInstantiations.size();
}

[[nodiscard]] FOUNDATION_INLINE usize UnitTemplateInstOrderedFieldCount(const CompileResult& result, const usize instIdx)noexcept{
    return result.unit.templateInstantiations[instIdx]->orderedFields.size();
}

[[nodiscard]] FOUNDATION_INLINE AStringView UnitTemplateInstOrderedFieldName(const CompileResult& result, const usize instIdx, const usize fieldIdx)noexcept{
    return AStringView(result.unit.templateInstantiations[instIdx]->orderedFields[fieldIdx]->name);
}

[[nodiscard]] FOUNDATION_INLINE usize UnitIncludedAdhdFileCount(const CompileResult& result)noexcept{
    return result.unit.includedAdhdFiles.size();
}

[[nodiscard]] FOUNDATION_INLINE AStringView UnitIncludedAdhdFileView(const CompileResult& result, const usize idx)noexcept{
    return AStringView(result.unit.includedAdhdFiles[idx]);
}

[[nodiscard]] FOUNDATION_INLINE usize UnitResolvedIncludedFileCount(const CompileResult& result)noexcept{
    return result.unit.resolvedIncludedFiles.size();
}

[[nodiscard]] FOUNDATION_INLINE AStringView UnitResolvedIncludedFileView(const CompileResult& result, const usize idx)noexcept{
    return AStringView(result.unit.resolvedIncludedFiles[idx]);
}

