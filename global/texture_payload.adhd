[cpp_header("<global/texture_payload.h>"), cpp_name("::TextureFormat::MipChainLayoutFailure::Enum")]
extern enum MipChainLayoutFailure : u8{
    None,
    InvalidMipChain,
    MipCountMismatch,
    BlockLayoutOverflow,
    SliceCountInvalid,
    SliceCountMismatch,
    ByteSizeOverflow,
    OffsetOverflow,
    ResolutionMismatch,
    BlockGridMismatch,
    ByteRangeMismatch,
    kCount
};

[cpp_header("<global/texture_payload.h>"), cpp_name("::TextureAlphaMode::Enum")]
extern enum TextureAlphaMode : u8{
    Opaque,
    EmbeddedLdr,
    ConstantUnorm8,
    SeparateUastcLdr4x4
};

[cpp_header("<global/texture_payload.h>"), cpp_name("::TextureDimension::Enum")]
extern enum TexturePayloadDimension : u8{
    Texture2D,
    TextureCube,
    Texture3D
};

[cpp_header("<global/texture_payload.h>"), cpp_name("::TexturePayloadFormat::Enum")]
extern enum TexturePayloadFormat : u8{
    UastcLdr4x4,
    UastcHdr4x4
};


