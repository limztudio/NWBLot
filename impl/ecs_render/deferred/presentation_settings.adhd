////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/reflection/settings.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Stages exchange linear radiance; exposure applies at presentation.
const f32 s_PresentationDefaultShoulder = 0.65f;
const u32 s_DeferredInvalidHeapSlot = 0xffffffffu;
const u32 s_DeferredPresentationSdr = 0u;
const u32 s_DeferredPresentationHdr10 = 1u;
const Name s_SceneShadingBufferName = "ecs_render/scene_shading_data";
const Name s_SceneLightBufferName = "ecs_render/scene_light_data";
const u32 s_IrradianceHistoryCopyRegionCount = 2u;
const StringView s_CausticIrradianceLabel = "Caustic Irradiance";
const StringView s_SurfelIrradianceLabel = "Surfel Irradiance";
const Name s_LightingBindlessSlotsName = "render.deferred_lighting.bindless_slots";
const StringView s_DeferredBindlessSlotsLabel = "Deferred Bindless Slots";
const usize s_TransparentLaggedLightingDependencyCount = 2u;
const usize s_TransparentLaggedSelectorDependencyCount = 3u;
const usize s_OpaqueLaggedSelectorDependencyCount = 2u;
const usize s_OpaqueProducerResourceSetUseCapacity = 3u;
const usize s_OpaqueSharedRasterResourceUseCapacity = 9u;
const usize s_OpaqueSharedResourceSetUseCapacity = 2u;
const usize s_PresentBaseResourceUseCount = 3u;
const usize s_PresentMaxResourceUseCount = 4u;
const usize s_PresentMaxDependencyCount = 4u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
enum<u32> PresentationToneMap{
    LinearClamp = 0u,
    Reinhard = 1u
}

[reflect]
class PresentationSettings{
    public PresentationToneMap toneMap = PresentationToneMap::Reinhard;
    public f32 exposure = 1.0f;
    public f32 shoulder = s_PresentationDefaultShoulder;
}

[serialize]
class DeferredCompositePushConstants{
    public u32 resourceSlots = 0u;
    public u32 refractionResources = 0u;
    public u32 opaqueReflectionSlot = s_DeferredInvalidHeapSlot;
    public u32 glassReflectionSlot = s_DeferredInvalidHeapSlot;
    public u32 reflectionDebugView = 0u;
}

[serialize]
class DeferredPresentPushConstants{
    public u32 resourceSlots = 0u;
    public u32 presentationMode = s_DeferredPresentationSdr;
    public u32 toneMap = cast<u32>(PresentationToneMap::Reinhard);
    public f32 exposure = 1.0f;
    public f32 shoulder = s_PresentationDefaultShoulder;
    public u32 outputLayerSlot = s_DeferredInvalidHeapSlot;
}

[serialize]
class DeferredLightingPushConstants{
    public u32 resourceSlots = 0u;
    public u32 presentationMode = s_DeferredPresentationSdr;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidatePresentationSettings(in PresentationSettings settings){
    return cast<u32>(settings.toneMap) <= cast<u32>(PresentationToneMap::Reinhard) && isFinite(settings.exposure) && settings.exposure >= 0.0f && isFinite(settings.shoulder) && settings.shoulder > 0.0f;
}

DeferredCompositePushConstants ResolveDeferredCompositePushConstants(
    in u32 resourceSlots,
    in b8 hasRefractionFramebuffer,
    in ReflectionCompositeInputs reflectionInputs
){
    DeferredCompositePushConstants pushConstants;
    pushConstants.resourceSlots = resourceSlots;
    if(hasRefractionFramebuffer)
        pushConstants.refractionResources = 1u;
    pushConstants.opaqueReflectionSlot = reflectionInputs.opaqueRadianceSlot;
    pushConstants.glassReflectionSlot = reflectionInputs.glassRadianceSlot;
    pushConstants.reflectionDebugView = cast<u32>(reflectionInputs.debugView);
    return pushConstants;
}

DeferredPresentPushConstants ResolveDeferredPresentPushConstants(
    in u32 resourceSlots,
    in b8 hdr10OutputActive,
    in PresentationSettings settings,
    in u32 outputLayerSlot
){
    DeferredPresentPushConstants pushConstants;
    pushConstants.resourceSlots = resourceSlots;
    if(hdr10OutputActive)
        pushConstants.presentationMode = s_DeferredPresentationHdr10;
    pushConstants.toneMap = cast<u32>(settings.toneMap);
    pushConstants.exposure = settings.exposure;
    pushConstants.shoulder = settings.shoulder;
    pushConstants.outputLayerSlot = outputLayerSlot;
    return pushConstants;
}

DeferredLightingPushConstants ResolveDeferredLightingPushConstants(
    in u32 resourceSlots,
    in b8 hdr10OutputActive
){
    DeferredLightingPushConstants pushConstants;
    pushConstants.resourceSlots = resourceSlots;
    if(hdr10OutputActive)
        pushConstants.presentationMode = s_DeferredPresentationHdr10;
    return pushConstants;
}

const usize s_SceneShadingGpuDataBytes = 16u;
const usize s_SceneLightGpuDataBytes = 80u;
const usize s_SceneLightGpuBufferBytes = 1280u;

b8 IsSceneLightUploadRequired(
    in b8 valid,
    in u32 storedLightCount,
    in Span<u8> storedLightBytes,
    in Span<SceneLightGpuData> lights
){
    const u32 lightCount = cast<u32>(lights.size());
    const usize lightByteCount = lights.size() * s_SceneLightGpuDataBytes;
    assert(lightByteCount <= storedLightBytes.size());
    b8 lightDataUnchanged = false;
    if(valid && storedLightCount == lightCount){
        if(lightByteCount == 0u)
            lightDataUnchanged = true;
        else{
            native(in storedLightBytes, in lights, in lightByteCount, mut lightDataUnchanged){
                lightDataUnchanged = NWB_MEMCMP(storedLightBytes.data(), lights.data(), lightByteCount) == 0;
            }
        }
    }
    return !lightDataUnchanged && lightByteCount != 0u;
}

b8 IsSceneShadingUploadRequired(
    in b8 valid,
    in Span<u8> storedShadingBytes,
    in SceneShadingGpuData sceneShadingState
){
    if(!valid || storedShadingBytes.size() != s_SceneShadingGpuDataBytes)
        return true;
    b8 matches = false;
    native(in storedShadingBytes, in sceneShadingState, mut matches){
        matches = NWB_MEMCMP(storedShadingBytes.data(), &sceneShadingState, sizeof(sceneShadingState)) == 0;
    }
    return !matches;
}

void ConfirmSceneShadingBufferUploads(
    in Span<SceneLightGpuData> lights,
    in b8 lightUploadRequired,
    in SceneShadingGpuData sceneShadingState,
    in b8 sceneShadingUploadRequired,
    mut Array<u8, 5120u> inOutLightGpuData,
    mut u32 inOutLightGpuDataCount,
    mut b8 inOutLightGpuDataValid,
    mut Array<u8, 16u> inOutSceneShadingGpuData,
    mut b8 inOutSceneShadingGpuDataValid
){
    const u32 lightCount = cast<u32>(lights.size());
    const usize lightByteCount = lights.size() * s_SceneLightGpuDataBytes;
    if(lightUploadRequired || lightCount == 0u){
        if(lightByteCount != 0u){
            native(in lights, in lightByteCount, mut inOutLightGpuData){
                NWB_MEMCPY(inOutLightGpuData.data(), inOutLightGpuData.size(), lights.data(), lightByteCount);
            }
        }
        inOutLightGpuDataCount = lightCount;
        inOutLightGpuDataValid = true;
    }
    if(sceneShadingUploadRequired){
        native(in sceneShadingState, mut inOutSceneShadingGpuData){
            NWB_MEMCPY(inOutSceneShadingGpuData.data(), inOutSceneShadingGpuData.size(), &sceneShadingState, sizeof(sceneShadingState));
        }
        inOutSceneShadingGpuDataValid = true;
    }
}

DeferredBindlessResourceSlots BuildLaggedLightingHistorySlots(
    in DeferredBindlessResourceSlots baseSlots,
    in u32 shadowVisibilitySlot,
    in u32 causticIrradianceSlot,
    in u32 surfelIrradianceSlot
){
    DeferredBindlessResourceSlots slots = baseSlots;
    slots.shadowVisibility = shadowVisibilitySlot;
    slots.causticIrradiance = causticIrradianceSlot;
    slots.surfelIrradiance = surfelIrradianceSlot;
    return slots;
}


