#include <impl/ecs_render/raytrace/raytrace_internal.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_MaxBvhBitonicSortSteps = 160u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanDispatchPreparedMeshSwBvh(in u32 primitiveCount, in u32 positionHeapSlot, in u32 triangleIndexHeapSlot){
    return primitiveCount != 0u && positionHeapSlot != s_RtInvalidSlot && triangleIndexHeapSlot != s_RtInvalidSlot;
}

u32 BuildBvhBitonicSortSteps(
    in u32 elementCount,
    in u32 paddedCount,
    in u32 keysHeapSlot,
    in u32 payloadHeapSlot,
    mut FixedVector<BvhSortPushConstants, s_MaxBvhBitonicSortSteps> outSteps
){
    outSteps.clear();
    if(paddedCount < s_BvhSortGroupSize)
        return 0u;

    const u32 groupCount = paddedCount / s_BvhSortGroupSize;
    outSteps.push_back(MakeBvhSortPushConstants(elementCount, 0u, 0u, s_BvhSortModeLocalTile, keysHeapSlot, payloadHeapSlot));

    u32 sequenceSize = s_BvhSortGroupSize << 1u;
    while(sequenceSize <= paddedCount){
        u32 compareDistance = sequenceSize >> 1u;
        while(compareDistance >= s_BvhSortGroupSize){
            outSteps.push_back(MakeBvhSortPushConstants(elementCount, compareDistance, sequenceSize, s_BvhSortModeGlobal, keysHeapSlot, payloadHeapSlot));
            compareDistance >>= 1u;
        }
        outSteps.push_back(MakeBvhSortPushConstants(elementCount, 0u, sequenceSize, s_BvhSortModeGlobalTail, keysHeapSlot, payloadHeapSlot));
        if(sequenceSize == paddedCount)
            break;
        sequenceSize <<= 1u;
    }
    return groupCount;
}


