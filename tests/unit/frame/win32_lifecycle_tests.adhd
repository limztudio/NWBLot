using GlobalArena = Core::Alloc::GlobalArena;
using LoggerRegistrationGuard = Core::Common::LoggerRegistrationGuard;
namespace LoggerBreakPolicy = Core::Common::LoggerBreakPolicy;
using CpuTaskSchedulerConfig = Core::CpuTaskSchedulerConfig;
using GpuDescriptorHeapAbi = Core::GpuDescriptorHeapAbi;
using GraphicsRuntime = Core::GraphicsRuntime;
using RenderPassCollection = Core::GraphicsModuleDetail::RenderPassCollection;
using CollectionTestPass = FrameLifecycleTestsDetail::CollectionTestPass;
using UnfocusedLoopRenderPass = FrameLifecycleTestsDetail::UnfocusedLoopRenderPass;
using LoopLogger = FrameLifecycleTestsDetail::LoopLogger;
using ThrowingClampLogger = FrameLifecycleTestsDetail::ThrowingClampLogger;
using Core::FrameDetail::LogicalDimensionForPixels;


