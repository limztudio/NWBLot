////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_DEFERRED_LIGHTING_FRAMEWORK_SLANGI
#define NWB_GRAPHICS_DEFERRED_LIGHTING_FRAMEWORK_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Deferred lighting framework: the engine-provided library used by the compute lighting pass. It exposes the surface
// inputs the geometry pass packed into the G-buffer
// (base color, normal, world position, the shading-model id + two BXDF params from the alpha channels), the
// scene light list + per-light resolve, and the shadow-visibility accessor. The lighting pass itself owns
// the loop: it loads the surface, dispatches on surface.shadingModel to a (user-authored) BXDF that walks the
// lights, applies per-light visibility, and tonemaps. Nothing here hard-codes a shading model.


#include "binding_slots.h"
#include "bxdf_surface.slangi"
#include "bindless_resources.slangi"
#include "../scene/binding_slots.h"

// The scene-shading cbuffer + light list are now global-heap entries (like the G-buffer/shadow/caustic/GI inputs
// below): fetch them from the heap through this pass's per-frame resource-slot cbuffer instead of a local set
// binding. scene/buffer.slangi (pulled in via scene/lighting.slangi) reads these two slot expressions -- the two
// spare avboit lanes. g_NwbDeferredBindlessResources is declared just
// below and precedes the scene/lighting.slangi include, so the slot expressions resolve where they expand.
#define NWB_SCENE_SHADING_HEAP_SLOT g_NwbDeferredBindlessResources.avboitSlots.z
#define NWB_SCENE_LIGHT_LIST_HEAP_SLOT g_NwbDeferredBindlessResources.avboitSlots.w
// G-buffer, screen-space shadow/caustic/GI inputs, and the shared sampler are global-heap entries.  The selector
// payload is another heap UniformBuffer; a four-byte push block selects it, so deferred lighting has no local
// descriptor set at all.  Keep the selector macro alive through the cook-generated material BXDF module: scene
// accessors expand there too, after this framework include has returned.
struct NwbDeferredLightingPushConstants{
    uint resourceSlots;
};

[[vk::push_constant]]
ConstantBuffer<NwbDeferredLightingPushConstants> g_NwbDeferredLightingPushConstants;

#define g_NwbDeferredBindlessResources g_NwbHeapDeferredBindlessResources[g_NwbDeferredLightingPushConstants.resourceSlots]

#define NWB_SCENE_SHADOW_VISIBILITY_RESOURCE NwbHeapSampledImage2DArray(g_NwbDeferredBindlessResources.lightingSlots.x)
#define NWB_SCENE_CAUSTIC_IRRADIANCE_RESOURCE NwbHeapSampledImage2D(g_NwbDeferredBindlessResources.lightingSlots.y)
// Brings common/math (nwbSafeNormalize, frame helpers), scene/buffer (g_NwbSceneLights, nwbSceneLightCount,
// g_NwbSceneCameraPosition, nwbSceneResolveLight) and the engine's default BRDF lobe (nwbSceneShadeLight) +
// whole-surface model (nwbSceneApplyLighting). A project BXDF may use or ignore the default model.
#include "../scene/lighting.slangi"

#undef NWB_SCENE_SHADOW_VISIBILITY_RESOURCE
#undef NWB_SCENE_CAUSTIC_IRRADIANCE_RESOURCE


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Resolved surfel-GI indirect irradiance (RGBA16F, screen space): the surfel_resolve_cs COMPUTE pass gathered the
// surfel field once per pixel into this texture (rgb = indirect irradiance, a = 1 where a surfel covered the pixel,
// 0 = none). The lighting dispatch reads THIS texture rather than the read-write surfel pool, which prevents a
// frames-in-flight pool race. Cleared to 0 (a = 0 -> hemiAmbient) when no surfel producer ran this frame, so an
// unbound/disabled GI is a correct hemiAmbient no-op.

// Indirect irradiance for the OPAQUE deferred path: read the resolved surfel texture at THIS pixel; where no surfel
// covered it (a < 0.5) fall back to the hemiAmbient ambient term. The resolve texture is 1:1 with the screen, so use a
// point Load; a bilinear tap would blend the coverage flag + irradiance across the covered/uncovered boundary.
half3 nwbBxdfResolvedIndirect(const int2 pixel, float3 normalVector){
    const half4 resolved = half4(NwbHeapSampledImage2D(g_NwbDeferredBindlessResources.lightingSlots.z).Load(int3(pixel, 0)));
    return resolved.a > 0.5 ? half3(resolved.rgb) : nwbGiHemiAmbient(normalVector);
}

// NwbBxdfSurface (the BXDF parameter type) is shared with the transparent / AVBOIT accumulate path; it lives
// in deferred/bxdf_surface.slangi, included above.


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


float3 nwbDeferredDecodeNormal(half3 value){
    return nwbSafeNormalize(float3(value) * 2.0 - 1.0, float3(0.0, 0.0, 1.0));
}

// Unpack the G-buffer at an exact screen texel into the surface a BXDF reads. The full-resolution G-buffer uses the
// shared point sampler in the Graphics path; mip-0 Loads preserve that result without emitting implicit derivative
// operations in this Compute shader.
NwbBxdfSurface nwbBxdfLoadSurface(const int2 pixel){
    const int3 texel = int3(pixel, 0);
    const half4 baseColorSample = half4(NwbHeapSampledImage2D(g_NwbDeferredBindlessResources.gbufferSlots.x).Load(texel));
    const half4 normalSample = half4(NwbHeapSampledImage2D(g_NwbDeferredBindlessResources.gbufferSlots.y).Load(texel));
    const float4 worldSample = NwbHeapSampledImage2D(g_NwbDeferredBindlessResources.gbufferSlots.z).Load(texel);
    const float depth = NwbHeapSampledImage2D(g_NwbDeferredBindlessResources.gbufferSlots.w).Load(texel).r;

    NwbBxdfSurface surface;
    surface.baseColor = baseColorSample.rgb;
    surface.shadingModel = uint(float(baseColorSample.a) + 0.5);
    surface.normal = nwbDeferredDecodeNormal(normalSample.rgb);
    surface.param0 = normalSample.a;
    surface.worldPosition = worldSample.xyz;
    surface.param1 = half(worldSample.a);
    surface.viewVector = nwbSafeNormalize(g_NwbSceneCameraPosition.xyz - surface.worldPosition, float3(0.0, 0.0, 1.0));
    surface.isBackground = depth >= NWB_SCENE_BACKGROUND_DEPTH;
    surface.indirectIrradiance = nwbBxdfResolvedIndirect(pixel, surface.normal);
    return surface;
}

// Default Reinhard tonemap the engine model uses; a project BXDF may reuse or replace it.
half3 nwbBxdfTonemap(half3 color){
    return color / (color + half3(0.65h));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

