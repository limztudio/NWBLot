void VerifyUiTextAreaLoanTests_CancelledCompositionStillRetiresAPreparedLoan(mut UiTextAreaLoanTests self){
    ASSERT_TRUE(self.acceptBaseline());
    const UiTextAreaAcceptedInput16 before = self.accepted();
    ASSERT_TRUE(self.beginArea(2u));
    ASSERT_TRUE(self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, UiTextAreaLoanOptions()).valid);
    const u64 revision = self.m_model.revision();
    const u64 composition = self.m_model.compositionGeneration();
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("x\ny", 1u, 3u));
    self.m_model.cancelComposition();
    EXPECT_EQ(self.m_model.revision(), revision);
    EXPECT_GT(self.m_model.compositionGeneration(), composition);
    EXPECT_FALSE(self.m_model.composition().active);
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_EQ(self.m_host.publishes, 0u);
    EXPECT_EQ(self.m_model.text(), "alpha\nbeta");
    self.expectRejected(before);
}

void VerifyUiTextAreaLoanTests_IdenticalScrollIntentDuringHostLoanRejectsBeforePreparation(mut UiTextAreaLoanTests self){
    ASSERT_TRUE(self.acceptBaseline());
    const UiTextAreaAcceptedInput16 before = self.accepted();
    const u64 revision = self.m_state.revision();
    const Point scroll = self.m_state.scroll();
    usize attempts = 0u;
    const auto loanHook = lambda[mut self, in scroll, mut attempts]() -> void{
        ++attempts;
        EXPECT_TRUE(self.m_state.scrollTo(scroll));
    };
    self.m_host.loanHook = loanHook;
    ASSERT_TRUE(self.beginArea(2u));
    EXPECT_FALSE(self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, UiTextAreaLoanOptions()).valid);
    EXPECT_EQ(attempts, 1u);
    EXPECT_EQ(self.m_host.loans, 1u);
    EXPECT_EQ(self.m_host.ordinaryLoans, 0u);
    EXPECT_EQ(self.m_host.actionLoans, 0u);
    EXPECT_EQ(self.m_host.publishes, 0u);
    EXPECT_GT(self.m_state.revision(), revision);
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, scroll.x);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, scroll.y);
    self.expectRejected(before);
}

void VerifyUiTextAreaLoanTests_FirstPublicationScrollIntentRejectsBeforeTheSecondPublication(mut UiTextAreaLoanTests self){
    ASSERT_TRUE(self.acceptBaseline());
