class MeshFrameBindings final : NoCopy{
public:
    [[nodiscard]] b8 prepare(Core::GraphicsRuntime& graphics, const ECSRenderDetail::MaterialPassBufferSnapshot& materialBuffers, const Core::BufferHandle& meshViewBuffer);
    [[nodiscard]] ECSRenderDetail::MeshFrameBindingSnapshot snapshot(const Core::BufferHandle& meshViewBuffer)const noexcept;
    [[nodiscard]] ECSRenderDetail::MeshViewBufferSnapshot viewSnapshot(const Core::BufferHandle& meshViewBuffer)const noexcept;
    void release(Core::GraphicsRuntime& graphics);
    void reset()noexcept{ m_snapshot = {}; }


private:
    ECSRenderDetail::MeshFrameBindingSnapshot m_snapshot;
};


