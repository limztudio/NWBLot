using namespace NWB;
using namespace NWB::Impl::Ui;
using namespace NWB::UiComboTests;

namespace MutationKind{
    enum Enum : u8{ None, RevisionSelect, KeySelect, TextSelect, EnabledOpen, TextRevision };
};


// Reentrant combo source that mutates host selection during callbacks.
class CallbackSource final : public ComboSource{
public:
    explicit CallbackSource(ComboState& state)noexcept
        : m_state(state)
    {}


public:
    [[nodiscard]] virtual u64 revision()const noexcept override{
        mutate(MutationKind::RevisionSelect);
        return ComboSource::revision() + m_revisionDelta;
    }

    [[nodiscard]] virtual u64 key(const u64 index)const noexcept override{
        mutate(MutationKind::KeySelect);
        return ComboSource::key(index);
    }

    [[nodiscard]] virtual StringView text(const u64 index)const noexcept override{
        mutate(MutationKind::TextSelect);
        if(m_kind == MutationKind::TextRevision){
            m_kind = MutationKind::None;
            ++m_mutations;
            ++m_revisionDelta;
        }
        return ComboSource::text(index);
    }

    [[nodiscard]] virtual b8 enabled(const u64 index)const noexcept override{
        mutate(MutationKind::EnabledOpen);
        return ComboSource::enabled(index);
    }

    void arm(const MutationKind::Enum kind, const u64 key = 8u)noexcept{
        m_kind = kind;
        m_key = key;
    }

    [[nodiscard]] u64 mutations()const noexcept{ return m_mutations; }


private:
    void mutate(const MutationKind::Enum kind)const noexcept{
        if(m_kind != kind)
            return;
        m_kind = MutationKind::None;
        ++m_mutations;
        if(kind == MutationKind::EnabledOpen)
            m_state.open();
        else
            m_state.select(m_key);
    }


private:
    ComboState& m_state;
    mutable MutationKind::Enum m_kind = MutationKind::None;
    u64 m_key = 8u;
    mutable u64 m_mutations = 0u;
    mutable u64 m_revisionDelta = 0u;
};

using AcceptedState = UiWidgetTests::AcceptedInputState<32u>;

class ForeignRevisionSource final : public ComboSource{
public:
    explicit ForeignRevisionSource(ComboSource& source)noexcept
        : m_foreign(source)
    {}


public:
    [[nodiscard]] virtual StringView text(const u64 index)const noexcept override{
        if(m_armed){
            m_armed = false;
            ++m_foreign.contentRevision;
            ++m_mutations;
        }
        return ComboSource::text(index);
    }

    void arm()noexcept{ m_armed = true; }

    [[nodiscard]] u64 mutations()const noexcept{ return m_mutations; }


private:
    ComboSource& m_foreign;
    mutable b8 m_armed = false;
    mutable u64 m_mutations = 0u;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiComboLoanTests : public ComboFixture{
public:
    UiComboLoanTests()
        : m_callbacks(m_state)
    {}


public:
    [[nodiscard]] b8 declareCallbacks(const u64 generation){
        return declareSource(generation, m_callbacks, m_state);
    }

    [[nodiscard]] b8 acceptCallbacks(const u64 generation){
        return declareCallbacks(generation) && finishPanel() && m_context.commitFrame(generation);
    }

    [[nodiscard]] Optional<HitTarget> findTarget(const WidgetId widget)const noexcept{
        if(const HitTarget* found = target(widget))
            return *found;
        return {};
    }

    [[nodiscard]] AcceptedState accepted()const noexcept{ return UiWidgetTests::CaptureAcceptedInput<32u>(m_context.input()); }

    void expectAccepted(const AcceptedState& saved)const{ UiWidgetTests::ExpectAcceptedInput(m_context.input(), saved); }


public:
    CallbackSource m_callbacks;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


