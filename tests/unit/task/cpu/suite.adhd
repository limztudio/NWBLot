void VerifyCpuTaskCleanupTests_UnrelatedUnwindCancelsQueuedTasksWithoutReplacingTheOriginalFailure(){
    Atomic<u32> retirements(0u);
    u32 callbacks = 0u;
    u32 retiredOnCatch = 0u;
    i32 result = 0;
    native(mut retirements, mut callbacks, mut retiredOnCatch, mut result){
        using namespace __hidden_cpu_task_cleanup_tests;
        result = InvokeTerminalEntry<TerminalTaskError>([&]()->int {
            CpuTaskScheduler scheduler(0u);
            CpuTaskScope scope(scheduler);
            const auto cpuTaskAdmission = scheduler.submit([&, probe = LifetimeProbe(retirements)]() {
                EXPECT_TRUE(probe.retirements != nullptr);
                ++callbacks;
                throw TerminalTaskError{ .code = 53 };
            }, { .target = CpuTaskTarget::MainThread });
            EXPECT_TRUE(cpuTaskAdmission);
            if(cpuTaskAdmission)
                EXPECT_TRUE(cpuTaskAdmission->valid());
            const auto secondCpuTaskAdmission = scope.submit([&, probe = LifetimeProbe(retirements)]() {
                EXPECT_TRUE(probe.retirements != nullptr);
                ++callbacks;
                throw TerminalTaskError{ .code = 59 };
            });
            EXPECT_TRUE(secondCpuTaskAdmission);
            if(secondCpuTaskAdmission)
                EXPECT_TRUE(secondCpuTaskAdmission->valid());
            throw TerminalTaskError{ .code = 47 };
        }, [&](const TerminalTaskError& err) {
            retiredOnCatch = retirements.load(MemoryOrder::acquire);
            return err.code;
        }, []()noexcept { return -1; });
    }
    EXPECT_EQ(retiredOnCatch, 2u);
    EXPECT_EQ(result, 47);
    EXPECT_EQ(callbacks, 0u);
}

void VerifyCpuTaskCleanupTests_TerminalDrainJoinsAnActiveWorkerAndRetiresCanceledCaptures(){
    const TestSchedulerConfig config = HomogeneousWorkers(1u);
    CpuTaskScheduler scheduler(config);
    CpuTaskScope scope(scheduler);
    Atomic<u32> retirements(0u);
    Atomic<b8> started(false);
    Atomic<b8> drainStarted(false);
    Atomic<b8> released(false);
    Atomic<b8> finished(false);
    Atomic<b8> expired(false);
    u32 canceledCallbacks = 0u;
    native(mut scope, mut retirements, mut started, mut released, mut finished, mut expired, mut canceledCallbacks){
        using namespace __hidden_cpu_task_cleanup_tests;
        const auto cpuTaskAdmission = scope.submit([&, probe = LifetimeProbe(retirements)]() {
            EXPECT_TRUE(probe.retirements != nullptr);
            started.store(true, MemoryOrder::release);
            if(!WaitUntil(released, s_CleanupTaskTimeoutMS))
                expired.store(true, MemoryOrder::release);
            finished.store(true, MemoryOrder::release);
        });
        EXPECT_TRUE(cpuTaskAdmission);
        if(cpuTaskAdmission)
            EXPECT_TRUE(cpuTaskAdmission->valid());
        EXPECT_TRUE(WaitUntil(started, s_CleanupTaskTimeoutMS));
        const auto secondCpuTaskAdmission = scope.submit([&, probe = LifetimeProbe(retirements)]() {
            EXPECT_TRUE(probe.retirements != nullptr);
            ++canceledCallbacks;
            throw TerminalTaskError{ .code = 61 };
        }, { .target = CpuTaskTarget::MainThread });
        EXPECT_TRUE(secondCpuTaskAdmission);
        if(secondCpuTaskAdmission)
            EXPECT_TRUE(secondCpuTaskAdmission->valid());
    }
    JoiningThread releaseWorker(lambda[mut drainStarted, mut expired, mut released]() -> void{
        if(!WaitUntil(drainStarted, s_CleanupTaskTimeoutMS)){
            expired.store(true, MemoryOrder::release);
        }
        SleepMS(s_CleanupWaitIntervalMS);
        released.store(true, MemoryOrder::release);
    });
    drainStarted.store(true, MemoryOrder::release);
    scheduler.drain();
    releaseWorker.join();
    EXPECT_TRUE(finished.load(MemoryOrder::acquire));
    EXPECT_FALSE(expired.load(MemoryOrder::acquire));
    EXPECT_EQ(retirements.load(MemoryOrder::acquire), 2u);
    EXPECT_EQ(canceledCallbacks, 0u);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
    const auto postDrainAdmission = scheduler.submit(lambda[]() -> void{});
    EXPECT_FALSE(postDrainAdmission.has_value());
}

void VerifyCpuTaskCleanupTests_NestedRangeFailureJoinsItsSubtreeBeforeUnwindingTheReceivingScope(){
    Atomic<u32> retirements(0u);
    CpuTaskScheduler scheduler(0u);
    u32 callbacks = 0u;
    u32 retiredOnCatch = 0u;
    usize outstandingOnCatch = 1u;
    i32 result = 0;
    native(mut retirements, mut scheduler, mut callbacks, mut retiredOnCatch, mut outstandingOnCatch, mut result){
        using namespace __hidden_cpu_task_cleanup_tests;
        result = InvokeTerminalEntry<TerminalTaskError>([&]()->int {
            CpuTaskScope scope(scheduler);
            const auto cpuTaskAdmission = scope.submit([&, probe = LifetimeProbe(retirements)]() {
                EXPECT_TRUE(probe.retirements != nullptr);
                EXPECT_TRUE((scope.parallelFor(0u, 16u, 1u, [&](usize) {
                    ++callbacks;
                    throw TerminalTaskError{ .code = 67 };
                })));
            });
            EXPECT_TRUE(cpuTaskAdmission);
            if(cpuTaskAdmission)
                EXPECT_TRUE(cpuTaskAdmission->valid());
            scope.wait();
            return 0;
        }, [&](const TerminalTaskError& err) {
            retiredOnCatch = retirements.load(MemoryOrder::acquire);
            outstandingOnCatch = scheduler.statistics().outstandingTasks;
            return err.code;
        }, []()noexcept { return -1; });
    }
    EXPECT_EQ(retiredOnCatch, 1u);
    EXPECT_EQ(outstandingOnCatch, 0u);
    EXPECT_EQ(result, 67);
    EXPECT_EQ(callbacks, 1u);
}

void VerifyCpuTaskCleanupTests_DescendantRetirementCanReenterSchedulerBeforeParentCompletionPublishes(){
    DeadlineGuard watchdog(false, s_CleanupTaskTimeoutMS);
    CpuTaskHandle parent = CpuTaskHandle();
    b8 incompleteDuringRetirement = false;
    usize outstandingDuringRetirement = 0u;
    CpuTaskScheduler scheduler(0u);
    u32 callbacks = 0u;
    native(mut scheduler, mut parent, mut incompleteDuringRetirement, mut outstandingDuringRetirement, mut callbacks){
        using namespace __hidden_cpu_task_cleanup_tests;
        const auto cpuTaskAdmission = scheduler.submit([&scheduler, &callbacks, probe = ReentrantRetirementProbe(scheduler, parent, incompleteDuringRetirement, outstandingDuringRetirement)]() {
            EXPECT_TRUE(probe.m_active);
            const auto secondCpuTaskAdmission = scheduler.submit([&]()noexcept { ++callbacks; });
            EXPECT_TRUE(secondCpuTaskAdmission);
            if(secondCpuTaskAdmission)
                EXPECT_TRUE(secondCpuTaskAdmission->valid());
        });
        ASSERT_TRUE(cpuTaskAdmission);
        parent = *cpuTaskAdmission;
    }
    ASSERT_TRUE(parent.valid());
    const auto thirdCpuTaskAdmission = scheduler.submit(lambda[mut incompleteDuringRetirement, mut outstandingDuringRetirement, mut callbacks]() -> void{
        EXPECT_TRUE(incompleteDuringRetirement);
        EXPECT_EQ(outstandingDuringRetirement, 2u);
        ++callbacks;
    }, parent);
    ASSERT_TRUE(thirdCpuTaskAdmission.has_value());
    const CpuTaskHandle dependent = thirdCpuTaskAdmission.value();
    ASSERT_TRUE(dependent.valid());
    scheduler.wait(dependent);
    EXPECT_EQ(callbacks, 2u);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}

void VerifyCpuTaskCleanupTests_LoaderShutdownJoinsPostCallbackTasksBeforeCallbackOwnerExpires(){
    b8 ownerAlive = true;
    Atomic<u32> retirements(0u);
    Atomic<u32> lateRetirements(0u);
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope scope(scheduler);
    u32 callbacks = 0u;
    b8 ownerAliveOnCatch = true;
    u32 retiredOnCatch = 0u;
    u32 lateRetiredOnCatch = 1u;
    usize outstandingOnCatch = 1u;
    i32 result = 0;
    native(
        mut ownerAlive,
        mut retirements,
        mut lateRetirements,
        mut scheduler,
        mut scope,
        mut callbacks,
        mut ownerAliveOnCatch,
        mut retiredOnCatch,
        mut lateRetiredOnCatch,
        mut outstandingOnCatch,
        mut result
    ){
        using namespace __hidden_cpu_task_cleanup_tests;
        result = InvokeTerminalEntry<TerminalTaskError>([&]()->int {
            ShutdownSubmittingCallbacks owner(scope, ownerAlive, retirements, lateRetirements, callbacks);
            NWB::LoaderDetail::CallbackShutdownGuard shutdown(owner, scope);
            shutdown.activate();
            return 0;
        }, [&](const TerminalTaskError& err) {
            ownerAliveOnCatch = ownerAlive;
            retiredOnCatch = retirements.load(MemoryOrder::acquire);
            lateRetiredOnCatch = lateRetirements.load(MemoryOrder::acquire);
            outstandingOnCatch = scheduler.statistics().outstandingTasks;
            return err.code;
        }, []()noexcept { return -1; });
    }
    EXPECT_FALSE(ownerAliveOnCatch);
    EXPECT_EQ(retiredOnCatch, 1u);
    EXPECT_EQ(lateRetiredOnCatch, 0u);
    EXPECT_EQ(outstandingOnCatch, 0u);
    scope.drain();
    EXPECT_EQ(result, 73);
    EXPECT_EQ(callbacks, 1u);
    EXPECT_EQ(retirements.load(MemoryOrder::acquire), 1u);
    EXPECT_EQ(lateRetirements.load(MemoryOrder::acquire), 0u);
}


