#include <impl/ecs_ui/toolkit/text/baked_atlas.adhd>
#include <impl/ecs_ui/toolkit/text/freetype_sdk.adhd>
#include <impl/ecs_ui/toolkit/text/harfbuzz_sdk.adhd>
#include <impl/ecs_ui/toolkit/text/shaper_types.adhd>
#include <impl/ecs_ui/toolkit/text/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_FontGlyphExtentsCacheMaxEntries = 2048u;
type SharedFontFace = Shared<FontFace>;
type PlacedGlyph = PlacedGlyphRecord<SharedFontFace>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CachedShapedGlyphExtents{
    public Rect ink;
    public GlyphCoverageBounds coverage;
}

class FontSource{
    public AssetRef<Font> identity;
    public in Font font;
    public u64 generation;
    public Optional<in FontAtlas> atlas;
    public FontDescriptor descriptor;

    public FontSource(in AssetRef<Font> identity, in Font font, in u64 generation){
        this.identity = identity;
        this.font = font;
        this.generation = generation;
    }
    public FontSource(in AssetRef<Font> identity, in Font font, in u64 generation, in FontDescriptor descriptor){
        this.identity = identity;
        this.font = font;
        this.generation = generation;
        this.descriptor = descriptor;
    }
    public FontSource(in AssetRef<Font> identity, in Font font, in u64 generation, in borrow FontAtlas atlas){
        this.identity = identity;
        this.font = font;
        this.generation = generation;
        this.atlas = Optional<in FontAtlas>(atlas);
    }
    public FontSource(in AssetRef<Font> identity, in Font font, in u64 generation, in borrow FontAtlas atlas, in FontDescriptor descriptor){
        this.identity = identity;
        this.font = font;
        this.generation = generation;
        this.atlas = Optional<in FontAtlas>(atlas);
        this.descriptor = descriptor;
    }
}

[ordered]
class FontFace : NoCopy{
    private AssetRef<Font> m_identity = AssetRef<Font>();
    private u64 m_faceIdentity = AllocateServiceIdentity();
    private u64 m_generation = 0u;
    private Vector<u8> m_sourceBytes;
    private UiFreeTypeFace m_freeType = UiFreeTypeFace();
    private HarfBuzzFont m_hbFont = HarfBuzzFont();
    private HarfBuzzBuffer m_shapeBuffer = HarfBuzzBuffer();
    private SharedBakedFontAtlas m_bakedAtlas = SharedBakedFontAtlas();
    private HashMap<u64, CachedShapedGlyphExtents> m_glyphExtentsCache;
    private u32 m_unitsPerEm = 0u;
    private u32 m_lastRasterPixelSize = 0u;
    private i32 m_lastHbScale = 0;
    private b8 m_started = false;
    private b8 m_ready = false;
    private b8 m_allowOutlineBounds = false;
    private b8 m_coverageInkReliable = false;
    private b8 m_hasColor = false;

    [cpp_unwind]
    public void initialize(in SharedPool pool, in FontSource source){
        if(this.m_started)
            return;
        this.m_started = true;
        this.m_identity = source.identity;
        this.m_generation = source.generation;
        this.m_sourceBytes = source.font.fontBytes();
        const Span<u8> bytes = this.m_sourceBytes;
        const u32 index = source.font.faceIndex();
        if(!OpenUiFontFace(this.m_freeType, bytes, index))
            return;
        this.m_hasColor = this.m_freeType.view().hasColor();
        const b8 hbReady = this.m_hbFont.open(bytes, index);
        this.m_unitsPerEm = this.m_hbFont.unitsPerEm();
        if(this.m_unitsPerEm == 0u && this.m_hasColor)
            this.m_unitsPerEm = 1024u;
        this.m_ready = this.m_hbFont.glyphCount() != 0u && this.m_unitsPerEm != 0u && hbReady && this.m_shapeBuffer.valid();
        if(!this.m_ready){
            error("UI HarfBuzz font face initialization failed");
            return;
        }
        this.m_hbFont.setOpenTypeFunctions();
        this.m_allowOutlineBounds = !this.m_hasColor && !IsTrickyFace(this.m_freeType.view());
        this.m_coverageInkReliable = !this.m_hasColor && HasReliableFontCoverage(this.m_hbFont, this.m_allowOutlineBounds);
        if(source.atlas.has_value())
            this.installBakedAtlas(pool, source.font, source.atlas.value());
    }

    [cpp_unwind]
    private void installBakedAtlas(in SharedPool pool, in Font font, in FontAtlas atlas){
        in FontAtlasPayload payload = atlas.payload();
        if(!atlas.validatePayload() || payload.font != this.m_identity || !ValidateFontAtlasSourceMatch(payload, font)
            || !MatchesBakedAtlasShapingMetrics(payload.faceIndex, font.faceIndex(), payload.unitsPerEm, this.m_unitsPerEm, payload.sourceGlyphCount, this.m_hbFont.glyphCount())){
            warning("UI baked font atlas does not match the shaping font; using native coverage");
            return;
        }
        Expected<SharedBakedFontAtlas> baked = CreateBakedFontAtlas(pool, atlas, this.m_generation);
        if(baked.has_value())
            this.m_bakedAtlas = baked.value();
        else
            warning("UI baked font atlas could not be installed; using native coverage");
    }

    public ~FontFace(){
        if(this.m_freeType.closeFace() != 0)
            ReportUiFontCloseError("UI FreeType face destruction failed");
        if(this.m_freeType.closeLibrary() != 0)
            ReportUiFontCloseError("UI FreeType library destruction failed");
    }

    public b8 valid()const{ return this.m_ready; }
    public in AssetRef<Font> identity()const{ return this.m_identity; }
    public u64 faceIdentity()const{ return this.m_faceIdentity; }
    public u64 generation()const{ return this.m_generation; }
    public u32 unitsPerEm()const{ return this.m_unitsPerEm; }
    public b8 coverageInkReliable()const{ return this.m_coverageInkReliable; }
    public b8 hasColor()const{ return this.m_hasColor; }
    public in SharedBakedFontAtlas bakedAtlas()const{ return this.m_bakedAtlas; }

    public b8 supportsClusterUtf8(in StringView clusterUtf8)const{
        if(!this.m_ready || clusterUtf8.empty())
            return false;
        usize offset = 0u;
        b8 checkedAny = false;
        while(offset < clusterUtf8.size()){
            u32 cp = 0u;
            usize bytes = 0u;
            if(!TryDecodeUtf8Scalar(clusterUtf8.substr(offset), cp, bytes) || bytes == 0u)
                return false;
            offset += bytes;
            if(cp == 0x200Cu || cp == 0x200Du || IsUiTextVariationSelector(cp))
                continue;
            checkedAny = true;
            if(offset < clusterUtf8.size()){
                u32 nextCp = 0u;
                usize nextBytes = 0u;
                if(TryDecodeUtf8Scalar(clusterUtf8.substr(offset), nextCp, nextBytes) && nextBytes != 0u && IsUiTextVariationSelector(nextCp)){
                    offset += nextBytes;
                    if(!this.m_hbFont.hasVariationGlyph(cp, nextCp) && !this.m_hbFont.hasNominalGlyph(cp))
                        return false;
                    continue;
                }
            }
            if(!this.m_hbFont.hasNominalGlyph(cp))
                return false;
        }
        return checkedAny;
    }

    public Expected<FontMetrics> metrics(in f32 fontSize){
        if(!this.m_ready)
            return MakeUnexpected(Failure());
        return MeasureShapingFont(this.m_hbFont, fontSize, this.m_lastHbScale);
    }
    [cpp_unwind]
    public b8 shape(in ShapeRequest request, in u32 byteBegin, in u32 byteEnd, mut Vector<RawShapedGlyph> output){
        if(!this.m_ready)
            return false;
        return ShapeFontGlyphRun(this.m_hbFont, this.m_lastHbScale, this.m_shapeBuffer, request, byteBegin, byteEnd, this.m_freeType.view(), this.m_allowOutlineBounds, this.m_coverageInkReliable, this.m_glyphExtentsCache, output);
    }
    [cpp_unwind]
    public Expected<Rect> rasterBounds(in u32 glyphId, in u32 pixelSize){
        if(!this.m_ready)
            return MakeUnexpected(Failure());
        return MeasureRasterFontGlyph(this.m_freeType.view(), this.m_hasColor, glyphId, pixelSize, this.m_lastRasterPixelSize);
    }
    [cpp_unwind]
    public b8 rasterize(in u32 glyphId, in u32 pixelSize, mut GlyphBitmap output){
        return this.m_ready && RasterizeFontGlyph(this.m_freeType.view(), this.m_hasColor, glyphId, pixelSize, this.m_lastRasterPixelSize, output);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsUiTextVariationSelector(in u32 cp){
    return (cp >= 0xFE00u && cp <= 0xFE0Fu) || (cp >= 0xE0100u && cp <= 0xE01EFu);
}

b8 IsValidTextRasterPixelSize(in u32 pixelSize){
    return pixelSize != 0u && pixelSize <= s_TextMaxRasterPpem;
}

b8 FitsCoverageAtlasGlyphBitmap(in u32 width, in u32 height){
    const u32 maxExtent = s_GlyphAtlasPageExtent - s_GlyphAtlasGlyphGutter;
    return width <= maxExtent && height <= maxExtent;
}

u32 ResolveRasterBitmapSourceRow(in i32 pitch, in u32 rows, in u32 row){
    if(pitch >= 0)
        return row;
    return rows - row - 1u;
}

b8 MatchesBakedAtlasShapingMetrics(
    in u32 payloadFaceIndex,
    in u32 fontFaceIndex,
    in u32 payloadUnitsPerEm,
    in u32 hbUnitsPerEm,
    in u32 payloadSourceGlyphCount,
    in u32 hbGlyphCount
){
    return payloadFaceIndex == fontFaceIndex && payloadUnitsPerEm == hbUnitsPerEm && payloadSourceGlyphCount == hbGlyphCount;
}

b8 IsValidFontFaceShapeByteRange(in u32 byteBegin, in u32 byteEnd, in usize textSize, in f32 fontSize){
    return byteBegin <= byteEnd && cast<usize>(byteEnd) <= textSize && textSize <= s_TextMaxBytes && IsValidTextFontSize(fontSize);
}

u32 ResolveShapedClusterByteEnd(
    in TextDirection direction,
    in u32 endIndex,
    in u32 glyphCount,
    in u32 nextClusterByteBegin,
    in u32 byteEnd,
    in u32 previousBegin
){
    if(direction == TextDirection::LeftToRight){
        if(endIndex < glyphCount)
            return nextClusterByteBegin;
        return byteEnd;
    }
    return previousBegin;
}

[cpp_unwind]
GlyphCoverageBounds MeasureFontOutlineCoverage(mut FreeTypeFaceView face, in b8 allowOutlineBounds, in b8 coverageInkReliable, in u32 glyph, in f32 fontSize, mut b8 outCacheable){
    outCacheable = true;
    if(!allowOutlineBounds || coverageInkReliable)
        return GlyphCoverageBounds();
    if(face.loadGlyph(glyph, s_FreeTypeLoadNoScale | s_FreeTypeLoadNoHinting | s_FreeTypeLoadNoBitmap | s_FreeTypeLoadNoAutohint) != 0){
        warning("UI glyph outline bounds unavailable; retaining conservative coverage candidate");
        outCacheable = false;
        return GlyphCoverageBounds();
    }
    if(!face.hasOutline())
        return GlyphCoverageBounds();
    if(face.outlinePointCount() == 0)
        return GlyphCoverageBounds(Rect(), true);
    const FreeTypeOutlineBox box = OutlineControlBox(face);
    return ComputeOutlineCoverageBounds(box.xMin, box.yMin, box.xMax, box.yMax, fontSize, face.unitsPerEm());
}

void ConvertPremulBgraToStraightRgba(in Span<u8> srcBgraRow, in u32 width, mut Vector<u8> outPixels){
    for(u32 col = 0u; col < width; ++col){
        const usize base = cast<usize>(col) * 4u;
        const u32 b = cast<u32>(srcBgraRow[base + 0u]);
        const u32 g = cast<u32>(srcBgraRow[base + 1u]);
        const u32 r = cast<u32>(srcBgraRow[base + 2u]);
        const u32 a = cast<u32>(srcBgraRow[base + 3u]);
        if(a == 0u){
            outPixels.push_back(0u);
            outPixels.push_back(0u);
            outPixels.push_back(0u);
            outPixels.push_back(0u);
        }
        else if(a == 255u){
            outPixels.push_back(cast<u8>(r));
            outPixels.push_back(cast<u8>(g));
            outPixels.push_back(cast<u8>(b));
            outPixels.push_back(255u);
        }
        else{
            const u32 halfA = a / 2u;
            u32 ur = (r * 255u + halfA) / a;
            u32 ug = (g * 255u + halfA) / a;
            u32 ub = (b * 255u + halfA) / a;
            if(ur > 255u)
                ur = 255u;
            if(ug > 255u)
                ug = 255u;
            if(ub > 255u)
                ub = 255u;
            outPixels.push_back(cast<u8>(ur));
            outPixels.push_back(cast<u8>(ug));
            outPixels.push_back(cast<u8>(ub));
            outPixels.push_back(cast<u8>(a));
        }
    }
}

b8 LoadRasterFontGlyph(
    mut FreeTypeFaceView face,
    in b8 hasColor,
    in u32 glyph,
    in u32 pixelSize,
    mut u32 inOutLastPixelSize,
    mut f32 outBitmapScale
){
    outBitmapScale = 1.0f;
    if(hasColor && !face.isScalable()){
        u32 strikePpem = pixelSize;
        if(face.selectBestStrike(pixelSize, strikePpem) != 0){
            inOutLastPixelSize = 0u;
            return false;
        }
        inOutLastPixelSize = 0u;
        if(strikePpem > 0u)
            outBitmapScale = cast<f32>(strikePpem) / cast<f32>(pixelSize);
    }
    else if(pixelSize != inOutLastPixelSize){
        if(face.setPixelSizes(0u, pixelSize) != 0){
            inOutLastPixelSize = 0u;
            return false;
        }
        inOutLastPixelSize = pixelSize;
    }
    i32 loadFlags = s_FreeTypeLoadNoHinting;
    if(hasColor)
        loadFlags = loadFlags | s_FreeTypeLoadColor;
    else
        loadFlags = loadFlags | s_FreeTypeLoadNoBitmap;
    return face.loadGlyph(glyph, loadFlags) == 0;
}

[cpp_unwind]
Expected<Rect> MeasureRasterFontGlyph(mut FreeTypeFaceView face, in b8 hasColor, in u32 glyph, in u32 pixelSize, mut u32 inOutLastPixelSize){
    if(!IsValidTextRasterPixelSize(pixelSize))
        return MakeUnexpected(Failure());
    f32 bitmapScale = 1.0f;
    if(!LoadRasterFontGlyph(face, hasColor, glyph, pixelSize, inOutLastPixelSize, bitmapScale)){
        error("UI glyph raster measurement failed");
        return MakeUnexpected(Failure());
    }
    const FreeTypeBitmapView bitmap = face.bitmap();
    if(!hasColor && (!face.hasOutline() || (!bitmap.grayscale && bitmap.width != 0u && bitmap.rows != 0u))){
        error("UI glyph measurement requires a grayscale outline");
        return MakeUnexpected(Failure());
    }
    if(hasColor && bitmap.width != 0u && bitmap.rows != 0u && !bitmap.grayscale && !bitmap.colorBgra && !face.hasOutline()){
        error("UI glyph measurement requires a supported bitmap or outline");
        return MakeUnexpected(Failure());
    }
    Rect bounds = MakeRasterGlyphBoundsRect(bitmap.left, bitmap.top, bitmap.width, bitmap.rows);
    if(bitmapScale != 1.0f && bitmapScale > 0.0f){
        const f32 invScale = 1.0f / bitmapScale;
        bounds = Rect(bounds.x * invScale, bounds.y * invScale, bounds.width * invScale, bounds.height * invScale);
    }
    return bounds;
}

[cpp_unwind]
b8 RasterizeFontGlyph(mut FreeTypeFaceView face, in b8 hasColor, in u32 glyph, in u32 pixelSize, mut u32 inOutLastPixelSize, mut GlyphBitmap output){
    if(!IsValidTextRasterPixelSize(pixelSize))
        return false;
    f32 bitmapScale = 1.0f;
    if(!LoadRasterFontGlyph(face, hasColor, glyph, pixelSize, inOutLastPixelSize, bitmapScale)){
        error("UI glyph rasterization failed");
        return false;
    }
    const FreeTypeBitmapView loaded = face.bitmap();
    if(face.hasOutline() || (!hasColor && !loaded.grayscale) || (hasColor && !loaded.colorBgra && !loaded.grayscale)){
        if(face.renderNormal() != 0){
            error("UI glyph rasterization failed");
            return false;
        }
    }
    const FreeTypeBitmapView bitmap = face.bitmap();
    output.width = bitmap.width;
    output.height = bitmap.rows;
    output.bearingX = bitmap.left;
    output.bearingY = bitmap.top;
    output.bitmapScale = bitmapScale;
    if(!FitsCoverageAtlasGlyphBitmap(bitmap.width, bitmap.rows))
        return false;
    const usize pitch = cast<usize>(Abs(cast<i64>(bitmap.pitch)));
    if(bitmap.colorBgra){
        output.isColor = true;
        if(bitmap.width != 0u && bitmap.rows != 0u && (pitch < cast<usize>(bitmap.width) * 4u || pitch > bitmap.pixels.size() / bitmap.rows))
            return false;
        output.pixels.clear();
        output.pixels.reserve(cast<usize>(bitmap.width) * bitmap.rows * 4u);
        if(bitmap.width != 0u){
            for(u32 row = 0u; row < bitmap.rows; ++row){
                const usize sourceRow = ResolveRasterBitmapSourceRow(bitmap.pitch, bitmap.rows, row);
                ConvertPremulBgraToStraightRgba(bitmap.pixels.subspan(sourceRow * pitch, cast<usize>(bitmap.width) * 4u), bitmap.width, output.pixels);
            }
        }
        return true;
    }
    if(!bitmap.grayscale && bitmap.width != 0u && bitmap.rows != 0u){
        error("UI glyph rasterizer requires grayscale coverage");
        return false;
    }
    output.isColor = false;
    if(bitmap.width != 0u && bitmap.rows != 0u && (pitch < bitmap.width || pitch > bitmap.pixels.size() / bitmap.rows))
        return false;
    output.pixels.clear();
    output.pixels.reserve(cast<usize>(bitmap.width) * bitmap.rows);
    if(bitmap.width != 0u){
        for(u32 row = 0u; row < bitmap.rows; ++row){
            const usize sourceRow = ResolveRasterBitmapSourceRow(bitmap.pitch, bitmap.rows, row);
            AppendTriviallyCopyableVector(output.pixels, bitmap.pixels.subspan(sourceRow * pitch, bitmap.width));
        }
    }
    return true;
}

[cpp_unwind]
b8 OpenUiFontFace(mut UiFreeTypeFace face, in Span<u8> bytes, in u32 index){
    if(face.createLibrary() != 0){
        error("UI FreeType initialization failed");
        return false;
    }
    face.addDefaultModules();
    if(face.open(bytes, cast<i64>(index)) != 0){
        error("UI font face initialization failed");
        return false;
    }
    if((!face.view().isScalable() && (!face.view().hasColor() || face.view().strikeCount() <= 0)) || (face.view().unitsPerEm() == 0u && !face.view().hasColor())){
        error("UI font must have scalable horizontal metrics");
        return false;
    }
    return true;
}

b8 HasReliableFontCoverage(in HarfBuzzFont font, in b8 allowOutlineBounds){
    return allowOutlineBounds
        && font.tableLength(HarfBuzzTag("glyf")) != 0u
        && font.tableLength(HarfBuzzTag("CFF ")) == 0u
        && font.tableLength(HarfBuzzTag("sbix")) == 0u
        && font.tableLength(HarfBuzzTag("CBDT")) == 0u
        && font.tableLength(HarfBuzzTag("COLR")) == 0u;
}

Expected<FontMetrics> MeasureShapingFont(mut HarfBuzzFont font, in f32 fontSize, mut i32 inOutLastHbScale){
    if(!IsValidTextFontSize(fontSize))
        return MakeUnexpected(Failure());
    const i32 scale = ComputeTextFixedPointScale(fontSize);
    if(scale != inOutLastHbScale){
        font.setScale(scale, scale);
        inOutLastHbScale = scale;
    }
    HarfBuzzFontExtents extents;
    if(!font.horizontalExtents(extents))
        return MakeUnexpected(Failure());
    return TryResolveFontExtentsMetrics(extents.ascender, extents.descender, extents.line_gap);
}

[cpp_unwind]
b8 ShapeFontGlyphRun(
    mut HarfBuzzFont font,
    mut i32 inOutLastHbScale,
    mut HarfBuzzBuffer buffer,
    in ShapeRequest request,
    in u32 byteBegin,
    in u32 byteEnd,
    mut FreeTypeFaceView outlineFace,
    in b8 allowOutlineBounds,
    in b8 coverageInkReliable,
    mut HashMap<u64, CachedShapedGlyphExtents> glyphExtentsCache,
    mut Vector<RawShapedGlyph> output
){
    if(!IsValidFontFaceShapeByteRange(byteBegin, byteEnd, request.text.size(), request.fontSize))
        return false;
    const i32 scale = ComputeTextFixedPointScale(request.fontSize);
    if(scale != inOutLastHbScale){
        font.setScale(scale, scale);
        inOutLastHbScale = scale;
    }
    const HarfBuzzScript script = HarfBuzzScriptFromTag(request.scriptTag);
    if(script == s_HarfBuzzInvalidScript)
        return false;
    if(byteBegin == byteEnd){
        output.clear();
        return true;
    }

    buffer.clear();
    if(request.direction == TextDirection::LeftToRight)
        buffer.setDirection(s_HarfBuzzLeftToRight);
    else
        buffer.setDirection(s_HarfBuzzRightToLeft);
    buffer.setScript(script);
    if(!buffer.setLanguage(request.language))
        return false;
    buffer.setClusterLevel(s_HarfBuzzMonotoneGraphemes);
    if(!buffer.addUtf8(request.text, byteBegin, byteEnd - byteBegin))
        return false;
    if(request.featureCount > 0u){
        Array<HarfBuzzOpenTypeFeature, s_TextMaxOpenTypeFeatures> hbFeatures;
        const usize featureCount = Min(cast<usize>(request.featureCount), s_TextMaxOpenTypeFeatures);
        for(usize fi = 0u; fi < featureCount; ++fi){
            hbFeatures[fi].tag = request.features[fi].tag;
            hbFeatures[fi].value = request.features[fi].value;
            hbFeatures[fi].start = request.features[fi].start;
            hbFeatures[fi].end = request.features[fi].end;
        }
        buffer.shapeWithFeatures(font, Span<HarfBuzzOpenTypeFeature>(hbFeatures.data(), featureCount));
    }
    else
        buffer.shape(font);
    if(!buffer.valid()){
        error("UI HarfBuzz run allocation failed");
        return false;
    }

    const Span<HarfBuzzGlyphInfo> infos = buffer.glyphInfos();
    const Span<HarfBuzzGlyphPosition> positions = buffer.glyphPositions();
    if(infos.size() != positions.size())
        return false;
    const u32 count = cast<u32>(infos.size());
    for(u32 index = 0u; index < count; ++index){
        u32 previousCluster = 0u;
        if(index != 0u)
            previousCluster = infos[index - 1u].cluster;
        if(!IsValidHbShapedGlyphClusterStep(infos[index].cluster, previousCluster, byteBegin, byteEnd, positions[index].x_advance, index, request.direction))
            return false;
    }
    output.clear();
    output.reserve(count);
    const u64 fontSizeKeyPrefix = cast<u64>(bit_cast<u32>(request.fontSize)) << 32u;
    u32 first = 0u;
    u32 previousBegin = byteEnd;
    while(first < count){
        u32 end = first + 1u;
        while(end < count && infos[end].cluster == infos[first].cluster)
            ++end;
        const u32 clusterBegin = infos[first].cluster;
        u32 nextCluster = byteEnd;
        if(end < count)
            nextCluster = infos[end].cluster;
        const u32 clusterEnd = ResolveShapedClusterByteEnd(request.direction, end, count, nextCluster, byteEnd, previousBegin);
        for(u32 index = first; index < end; ++index){
            const u32 glyph = infos[index].codepoint;
            const u64 cacheKey = fontSizeKeyPrefix | cast<u64>(glyph);
            Rect ink;
            GlyphCoverageBounds coverage;
            const auto found = glyphExtentsCache.find(cacheKey);
            if(found != glyphExtentsCache.end()){
                ink = found.value().ink;
                coverage = found.value().coverage;
            }
            else{
                HarfBuzzGlyphExtents extents;
                if(font.glyphExtents(glyph, extents))
                    ink = ResolveHbGlyphExtentsInk(extents.x_bearing, extents.y_bearing, extents.width, extents.height);
                b8 cacheable = true;
                coverage = MeasureFontOutlineCoverage(outlineFace, allowOutlineBounds, coverageInkReliable, glyph, request.fontSize, cacheable);
                if(cacheable){
                    if(glyphExtentsCache.size() >= s_FontGlyphExtentsCacheMaxEntries)
                        glyphExtentsCache.clear();
                    CachedShapedGlyphExtents cached;
                    cached.ink = ink;
                    cached.coverage = coverage;
                    glyphExtentsCache.try_emplace(cacheKey, cached);
                }
            }
            Point offset;
            Point advance;
            ResolveHbGlyphPlacement(positions[index].x_offset, positions[index].y_offset, positions[index].x_advance, positions[index].y_advance, offset, advance);
            output.push_back(RawShapedGlyph(glyph, clusterBegin, clusterEnd, offset, advance, ink, coverage));
        }
        previousBegin = clusterBegin;
        first = end;
    }
    return true;
}

void ReportUiFontCloseError(in StringView message){
    DiagnosticEventRecord record;
    record.event = s_DiagnosticEventError;
    record.category = s_TextFontLifecycleCategory;
    record.message = message;
    CaptureDiagnosticEventAtCallSite(record);
}

[cpp_unwind]
Expected<SharedFontFace> MakeFontFace(in SharedPool pool, in FontSource source){
    Expected<SharedFontFace> face = pool.make<FontFace>();
    if(face.has_value())
        face.value().deref().initialize(pool, source);
    return face;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

