    Core::GpuTaskGraph& graph,
    const Core::TextureHandle& texture,
    const Name& identity,
    AStringView label,
    Optional<Core::ResourceStates::Mask> initialState = {},
    Optional<Core::ResourceStates::Mask> externalFinalState = {}
