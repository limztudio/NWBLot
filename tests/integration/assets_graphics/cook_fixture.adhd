using ExtensionState = MetadataExtensionState;

struct ExtensionConstructionFailure{};
struct ExtensionInsertionFailure{};
struct ExtensionCallerFailure{};

struct ExtensionMember{
    ExtensionState& state;
    Core::Assets::AssetVector<u8> bytes;


public:
    ExtensionMember(Core::Assets::AssetArena& arena, ExtensionState& inState)
        : state(inState)
        , bytes(arena)
    {
        bytes.resize(513u, 0x5au);
    }
    ~ExtensionMember()noexcept{
        ++state.memberDestructions;
    }
};

struct alignas(128u) AlignedExtension{
    ExtensionMember member;
    ExtensionState& state;
    usize identity;


public:
    AlignedExtension(Core::Assets::AssetArena& arena, ExtensionState& inState, const b8 fail = false)
        : member(arena, inState)
        , state(inState)
        , identity(++state.constructions)
    {
        if(fail)
            throw ExtensionConstructionFailure{};
    }
    ~AlignedExtension()noexcept{
        ++state.destructions;
    }
};

struct TextExtension{
    ExtensionState& state;
    Core::Assets::AssetVector<Core::Assets::AssetString> strings;


public:
    TextExtension(Core::Assets::AssetArena& arena, ExtensionState& inState)
        : state(inState)
        , strings(arena)
    {
        ++state.constructions;
        strings.emplace_back("first separately allocated extension payload", arena);
        strings.emplace_back("second separately allocated extension payload", arena);
    }
    ~TextExtension()noexcept{
        ++state.destructions;
    }
};

struct ReentrantExtension{
    ExtensionState& state;
    usize identity;
    ReentrantExtension* nested = nullptr;


public:
    ReentrantExtension(Core::Assets::ParsedAssetMetadata& metadata, const Name& name, ExtensionState& inState, const b8 recurse)
        : state(inState)
        , identity(++state.constructions)
    {
        if(recurse)
            nested = &Core::Assets::RequireParsedMetadataExtension<ReentrantExtension>(name, metadata, metadata, name, state, false);
    }
    ~ReentrantExtension()noexcept{
        ++state.destructions;
    }
};

struct ThrowingExtensionHasher{
    NotNull<b8*> fail;


public:
    [[nodiscard]] usize operator()(const Name& key)const{
        if(*fail)
            throw ExtensionInsertionFailure{};
        return Hasher<Name>{}(key);
    }
};

struct RegistryBorrowingExtension{
    const Core::Assets::CookEntryRegistry& registry;
    usize& observedBucketCount;


public:
    ~RegistryBorrowingExtension()noexcept{
        observedBucketCount = registry.bucketCount();
    }
};

static_assert(!IsConstructible_V<Core::Assets::ParsedMetadataExtension, const Core::Assets::ParsedMetadataExtension&>);
static_assert(IsNothrowMoveConstructible_V<Core::Assets::ParsedMetadataExtension>);
static_assert(IsNothrowDestructible_V<Core::Assets::ParsedMetadataExtension>);

class NullAllocatedBucket final : public Core::Assets::ICookEntryBucket{
public:
    static void* operator new(usize)noexcept{ return nullptr; }

    static void operator delete(void* pointer)noexcept{ ::operator delete(pointer); }


public:
    explicit NullAllocatedBucket(Core::Assets::CookArena&)noexcept{}


public:
    [[nodiscard]] virtual usize size()const noexcept override{ return 0u; }

    virtual b8 parseDocument(const NWB::Path&, AStringView, const NWB::Path&, const Core::Metascript::Document&, Core::Assets::CookEntryParseContext&)noexcept override{ return false; }

    virtual b8 parseValue(Name, const NWB::Path&, const Core::Metascript::Value&, Core::Assets::CookEntryParseContext&)noexcept override{ return false; }

    virtual b8 appendCachedEntry(const Core::Assets::CookEntrySourceLocation&, const Name&, Span<const u8>, Core::Assets::CookEntryParseContext&)noexcept override{ return false; }

    virtual b8 writeCookedAssets(Core::Assets::CookEntryWriteContext&)noexcept override{ return false; }
};

