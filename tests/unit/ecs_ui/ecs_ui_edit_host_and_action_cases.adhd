void VerifyUiClipboardPublications_CopiedWritePreservesNativeFifoBeforeLaterPasteRead(){
    native{
        using namespace NWB;
        using namespace NWB::Core;
        using namespace NWB::Impl;
        using UiEditHostFixtureSupport::FakeClipboard;
        Tests::TestArena arena;
        FakeClipboard service(arena.arena, true);
        UiClipboardPublications publications(arena.arena, service);
        AString<Alloc::GlobalArena> source("copied", arena.arena);
        ASSERT_EQ(publications.request(source), UiClipboardPublicationStatus::Pending);
        source.assign("changed");
        const auto read = service.requestReadText(ClipboardChannel::Clipboard);
        ASSERT_TRUE(read);
        ASSERT_TRUE(service.pump());
        EXPECT_EQ(service.startedOperation, ClipboardOperation::WriteText);
        EXPECT_EQ(service.startedText, "copied");
        EXPECT_EQ(publications.drain().status, UiClipboardPublicationStatus::Pending);
        ASSERT_TRUE(service.deliver(service.startedToken, ClipboardStatus::Success));
        ASSERT_TRUE(service.pump());
        EXPECT_EQ(service.startedOperation, ClipboardOperation::ReadText);
        EXPECT_EQ(service.startedToken, *read);
        ASSERT_TRUE(service.deliver(*read, ClipboardStatus::Success, "copied"));
        const auto result = publications.drain();
        EXPECT_EQ(result.status, UiClipboardPublicationStatus::Published);
        EXPECT_EQ(result.published, 1u);
        EXPECT_EQ(publications.pending(), 0u);
        ClipboardCompletion completion(arena.arena);
        ASSERT_EQ(service.poll(*read, completion), ClipboardPollResult::Completed);
        EXPECT_EQ(completion.text, "copied");
    }
}

void VerifyUiClipboardPublications_BoundedQueueAndExplicitResetReleaseAllPendingNativeTokens(){
    native{
        using namespace NWB;
        using namespace NWB::Core;
        using namespace NWB::Impl;
        using UiEditHostFixtureSupport::FakeClipboard;
        Tests::TestArena arena;
        FakeClipboard service(arena.arena, true);
        UiClipboardPublications publications(arena.arena, service);
        for(usize index = 0u; index < s_UiClipboardMaxPublications; ++index)
            ASSERT_EQ(publications.request("copy"), UiClipboardPublicationStatus::Pending);
        EXPECT_EQ(publications.pending(), s_UiClipboardMaxPublications);
        EXPECT_EQ(publications.request("overflow"), UiClipboardPublicationStatus::QueueFull);
        ASSERT_TRUE(service.pump());
        const auto old = service.startedToken;
        ASSERT_TRUE(publications.cancel());
        EXPECT_EQ(publications.pending(), 0u);
        EXPECT_FALSE(service.deliver(old, ClipboardStatus::Success));
        EXPECT_EQ(publications.drain().status, UiClipboardPublicationStatus::Idle);
        EXPECT_EQ(publications.request("new"), UiClipboardPublicationStatus::Pending);
    }
}

void VerifyUiClipboardPublications_CompletionFailuresAreReportedAndConsumedWithoutLosingSuccessfulPublications(){
    native{
        using namespace NWB;
        using namespace NWB::Core;
        using namespace NWB::Impl;
        using UiEditHostFixtureSupport::FakeClipboard;
        Tests::TestArena arena;
        FakeClipboard service(arena.arena, true);
        UiClipboardPublications publications(arena.arena, service);
        ASSERT_EQ(publications.request("success"), UiClipboardPublicationStatus::Pending);
        ASSERT_EQ(publications.request("failure"), UiClipboardPublicationStatus::Pending);
        ASSERT_EQ(publications.request("unsupported"), UiClipboardPublicationStatus::Pending);
        ASSERT_TRUE(service.pump());
        ASSERT_TRUE(service.deliver(service.startedToken, ClipboardStatus::Success));
        ASSERT_TRUE(service.pump());
        ASSERT_TRUE(service.deliver(service.startedToken, ClipboardStatus::NativeFailure));
        ASSERT_TRUE(service.pump());
        ASSERT_TRUE(service.deliver(service.startedToken, ClipboardStatus::Unsupported));
        const auto result = publications.drain();
        EXPECT_EQ(result.published, 1u);
        EXPECT_EQ(result.failed, 2u);
        EXPECT_EQ(result.status, UiClipboardPublicationStatus::Unsupported);
        EXPECT_EQ(publications.pending(), 0u);
        EXPECT_EQ(publications.drain().failed, 0u);
    }
}

void VerifyUiClipboardPublications_InvalidInputAndUnsupportedChannelNeverAdmitNativeWork(){
    native{
        using namespace NWB;
        using namespace NWB::Core;
        using namespace NWB::Impl;
        using UiEditHostFixtureSupport::FakeClipboard;
        Tests::TestArena arena;
        FakeClipboard service(arena.arena, true);
        UiClipboardPublications publications(arena.arena, service);
        EXPECT_EQ(publications.request("\xC0\xAF"), UiClipboardPublicationStatus::InvalidText);
        EXPECT_EQ(publications.request(AStringView("a\0b", 3u)), UiClipboardPublicationStatus::InvalidText);
        EXPECT_EQ(publications.request("primary", ClipboardChannel::PrimarySelection), UiClipboardPublicationStatus::Unsupported);
        EXPECT_EQ(publications.pending(), 0u);
        ASSERT_TRUE(service.pump());
        EXPECT_FALSE(service.startedToken.valid());
    }
}

void VerifyUiClipboardPublications_AnotherThreadCannotRequestDrainOrCancelOwnedPublication(){
    native{
        using namespace NWB;
        using namespace NWB::Core;
        using namespace NWB::Impl;
        using UiEditHostFixtureSupport::FakeClipboard;
        Tests::TestArena arena;
        FakeClipboard service(arena.arena, true);
        UiClipboardPublications publications(arena.arena, service);
        ASSERT_EQ(publications.request("copy"), UiClipboardPublicationStatus::Pending);
        UiClipboardPublicationStatus::Enum requested = UiClipboardPublicationStatus::Idle;
        UiClipboardPublicationStatus::Enum drained = UiClipboardPublicationStatus::Idle;
        b8 cancelled = true;
        Thread other([&]()noexcept{
            requested = publications.request("other");
            drained = publications.drain().status;
            cancelled = publications.cancel();
        });
        other.join();
        EXPECT_EQ(requested, UiClipboardPublicationStatus::WrongThread);
        EXPECT_EQ(drained, UiClipboardPublicationStatus::WrongThread);
        EXPECT_FALSE(cancelled);
        EXPECT_EQ(publications.pending(), 1u);
        EXPECT_TRUE(publications.cancel());
    }
}

void VerifyUiClipboardPublications_DestructionCancelsUndeliveredWorkBeforeServiceRetirement(){
    native{
        using namespace NWB;
        using namespace NWB::Core;
        using namespace NWB::Impl;
        using UiEditHostFixtureSupport::FakeClipboard;
        Tests::TestArena arena;
        FakeClipboard service(arena.arena, true);
        ClipboardRequestToken old;
        {
            UiClipboardPublications publications(arena.arena, service);
            ASSERT_EQ(publications.request("copy"), UiClipboardPublicationStatus::Pending);
            ASSERT_TRUE(service.pump());
            old = service.startedToken;
        }
        EXPECT_FALSE(service.deliver(old, ClipboardStatus::Success));
        ClipboardCompletion completion(arena.arena);
        EXPECT_EQ(service.poll(old, completion), ClipboardPollResult::InvalidRequest);
    }
}

void VerifyUiConfigurableEditInputTests_EmptyKeyboardProfileLeavesNativeTextAndExplicitCommandsAvailable(mut UiConfigurableEditInputTests self){
    ASSERT_TRUE(self.m_model.setText("abc"));
    ASSERT_TRUE(self.activate());
    native(mut self){
        ASSERT_TRUE(self.m_context.input().setBindings({}));
    }
    ASSERT_TRUE(self.key(Key::Left));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.caret(), 3u);
    ASSERT_TRUE(self.command(UiInputCommand::Left));
    ASSERT_EQ(self.m_textInput.commit("X"), TextInputAdmission::Accepted);
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "abXc");
    EXPECT_EQ(self.m_model.caret(), 3u);
}

void VerifyUiConfigurableEditInputTests_CopiedCommandRetainsItsMeaningAfterTheBindingProfileChanges(mut UiConfigurableEditInputTests self){
    ASSERT_TRUE(self.m_model.setText("abc"));
    ASSERT_TRUE(self.activate());
    native(mut self){
        const NWB::Impl::Ui::InputKeyBinding left{ .key = NWB::Core::Key::F8, .command = NWB::Impl::Ui::InputCommand::Left };
        const NWB::Impl::Ui::InputKeyBinding erase{ .key = NWB::Core::Key::F8, .command = NWB::Impl::Ui::InputCommand::Backspace };
        ASSERT_TRUE(self.m_context.input().setBindings(Span(&left, 1u)));
        ASSERT_TRUE(self.key(NWB::Core::Key::F8));
        ASSERT_TRUE(self.m_context.input().setBindings(Span(&erase, 1u)));
    }
    EXPECT_EQ(self.m_model.caret(), 3u);
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "abc");
    EXPECT_EQ(self.m_model.caret(), 2u);
    ASSERT_TRUE(self.key(Key::F8));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "ac");
    EXPECT_EQ(self.m_model.caret(), 1u);
}

void VerifyUiConfigurableEditInputTests_SemanticCancelFirstCancelsCompositionThenCancelsTheEditor(mut UiConfigurableEditInputTests self){
    ASSERT_TRUE(self.m_model.setText("base"));
    ASSERT_TRUE(self.activate());
    ASSERT_EQ(self.m_textInput.preedit("x", 1u, 1u), TextInputAdmission::Accepted);
    ASSERT_TRUE(self.frame(self.m_model));
    ASSERT_TRUE(self.m_model.composition().active);
    ASSERT_TRUE(self.command(UiInputCommand::Cancel));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_FALSE(self.m_model.composition().active);
    EXPECT_FALSE(self.m_result.cancelled);
    EXPECT_EQ(self.m_model.text(), "base");
    ASSERT_TRUE(self.command(UiInputCommand::Cancel));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_TRUE(self.m_result.cancelled);
    EXPECT_FALSE(self.m_context.input().focus().valid());
}

void VerifyUiEditActionHostTests_DuplicateSemanticAcceptDownSubmitsOncePerHeldSource(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    ASSERT_TRUE(self.replaceNative("42"));
    ASSERT_TRUE(self.actionFrame());
    ASSERT_EQ(self.m_model.text(), "42");
    UiInputEvent event = UiInputEvent();
    event.type = UiInputEventType::CommandDown;
    event.source = MakeEcsUiInputSource(7u, 3u);
    event.command = UiInputCommand::Accept;
    ASSERT_TRUE(self.dispatch(event));
    ASSERT_TRUE(self.dispatch(event));
    event.type = UiInputEventType::CommandUp;
    ASSERT_TRUE(self.dispatch(event));
    EXPECT_TRUE(self.m_actions.records.empty());
    ASSERT_TRUE(self.actionFrame());
    EXPECT_TRUE(self.m_result.submitted);
    ASSERT_EQ(self.m_actions.records.size(), 1u);
    event.type = UiInputEventType::CommandDown;
    ASSERT_TRUE(self.dispatch(event));
    event.type = UiInputEventType::CommandUp;
    ASSERT_TRUE(self.dispatch(event));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_EQ(self.actionCount(UiEditAction::Submit), 2u);
}

void VerifyUiEditActionHostTests_FreshActionBindingAbandonsOnlyWhileTheModelIsLent(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.m_model.setText("orphan"));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_TRUE(self.m_result.abandoned);
    EXPECT_EQ(self.m_model.text(), "0");
    EXPECT_EQ(self.actionCount(UiEditAction::Abandon), 1u);
    ASSERT_TRUE(self.actionFrame());
    EXPECT_FALSE(self.m_result.abandoned);
    EXPECT_EQ(self.actionCount(UiEditAction::Abandon), 1u);
}

void VerifyUiEditActionHostTests_ExternalDraftReplacementRemainsAuthoritativeWhileOldNativeTextIsDiscarded(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    ASSERT_TRUE(self.commitNative("old"));
    self.m_host.collectNative();
    ASSERT_TRUE(self.m_model.setText("fresh"));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_EQ(self.m_model.text(), "fresh");
    EXPECT_EQ(self.m_actions.committed, "0");
    EXPECT_TRUE(self.m_actions.records.empty());
    EXPECT_FALSE(self.m_result.abandoned);
}

void VerifyUiEditActionHostTests_OmissionRetiresNativeOwnershipAndRestoresOnlyOnRedeclaration(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    ASSERT_TRUE(self.replaceNative("42"));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_EQ(self.m_model.text(), "42");
    const TextInputSessionToken oldSession = self.m_textInput.activeSession();
    const u64 declaration = self.m_widget.declarationGeneration;
    ASSERT_TRUE(self.emptyFrame());
    EXPECT_EQ(self.m_model.text(), "42");
    EXPECT_TRUE(self.m_actions.records.empty());
    EXPECT_EQ(self.m_textInput.emitCommit(oldSession, "late"), TextInputAdmission::InvalidSession);
    ASSERT_TRUE(self.actionFrame());
    EXPECT_NE(self.m_widget.declarationGeneration, declaration);
    EXPECT_EQ(self.m_model.text(), "0");
    EXPECT_TRUE(self.m_result.abandoned);
    EXPECT_EQ(self.actionCount(UiEditAction::Abandon), 1u);
}

void VerifyUiEditActionHostTests_HostResetCannotTouchUnlentDraftButTheNextBindingAbandonsIt(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    ASSERT_TRUE(self.replaceNative("42"));
    ASSERT_TRUE(self.actionFrame());
    self.m_host.reset();
    EXPECT_EQ(self.m_model.text(), "42");
    EXPECT_TRUE(self.m_actions.records.empty());
    ASSERT_TRUE(self.actionFrame());
    EXPECT_EQ(self.m_model.text(), "0");
    EXPECT_TRUE(self.m_result.abandoned);
    EXPECT_EQ(self.actionCount(UiEditAction::Abandon), 1u);
}

void VerifyUiEditActionHostTests_DisableAbandonsDirtyDraftAndRejectsCollectedOldSessionText(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    ASSERT_TRUE(self.replaceNative("42"));
    ASSERT_TRUE(self.actionFrame());
    ASSERT_TRUE(self.commitNative("late"));
    self.m_host.collectNative();
    UiEditBoxOptions disabled = UiEditBoxOptions();
    disabled.enabled = false;
    ASSERT_TRUE(self.actionFrame(disabled));
    EXPECT_EQ(self.m_model.text(), "0");
    EXPECT_TRUE(self.m_result.abandoned);
    EXPECT_FALSE(self.m_result.focused);
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.actionCount(UiEditAction::Abandon), 1u);
    ASSERT_TRUE(self.actionFrame(disabled));
    EXPECT_EQ(self.actionCount(UiEditAction::Abandon), 1u);
}

void VerifyUiEditActionHostTests_ReadOnlyTransitionRestoresBeforeSnapshotAndKeepsSelectionCopyAvailable(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    ASSERT_TRUE(self.replaceNative("42"));
    ASSERT_TRUE(self.actionFrame());
    UiEditBoxOptions readOnly = UiEditBoxOptions();
    readOnly.readOnly = true;
    ASSERT_TRUE(self.actionFrame(readOnly));
    EXPECT_EQ(self.m_model.text(), "0");
    EXPECT_TRUE(self.m_result.abandoned);
    EXPECT_TRUE(self.m_result.focused);
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    ASSERT_TRUE(self.key(Key::A, false, true));
    ASSERT_TRUE(self.key(Key::C, false, true));
    ASSERT_TRUE(self.actionFrame(readOnly));
    EXPECT_EQ(self.m_model.selectedText(), "0");
    ASSERT_TRUE(self.m_clipboard.pump());
    ASSERT_TRUE(self.actionFrame(readOnly));
    EXPECT_EQ(self.m_clipboard.document, "0");
    EXPECT_EQ(self.m_model.text(), "0");
    EXPECT_EQ(self.m_actions.committed, "0");
}

void VerifyUiEditActionHostTests_NativeFocusLossAndGainAbandonsRatherThanCommittingOrdinaryBlur(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    ASSERT_TRUE(self.replaceNative("42"));
    ASSERT_TRUE(self.actionFrame());
    ASSERT_TRUE(self.commitNative("late"));
    self.m_host.collectNative();
    ASSERT_TRUE(self.dispatchType(UiInputEventType::FocusLost));
    ASSERT_TRUE(self.dispatchType(UiInputEventType::FocusGained));
    EXPECT_EQ(self.m_model.text(), "42");
    ASSERT_TRUE(self.actionFrame());
    EXPECT_EQ(self.m_model.text(), "0");
    EXPECT_EQ(self.actionCount(UiEditAction::Blur), 0u);
    EXPECT_EQ(self.actionCount(UiEditAction::Abandon), 1u);
    EXPECT_FALSE(self.m_result.focused);
}

void VerifyUiEditActionHostTests_FocusTransferCancelsPendingPasteBeforeOrderedBlurCanCommit(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    self.m_clipboard.document.assign("old paste");
    self.m_clipboard.delayed = true;
    ASSERT_TRUE(self.key(Key::V, false, true));
    ASSERT_TRUE(self.actionFrame());
    ASSERT_TRUE(self.m_clipboard.pump());
    const ClipboardRequestToken request = self.m_clipboard.startedToken;
    ASSERT_TRUE(request.valid());
    ASSERT_TRUE(self.replaceNative("42"));
    ASSERT_TRUE(self.focusOther());
    EXPECT_FALSE(self.m_clipboard.deliver(request, ClipboardStatus::Success, "old paste"));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_EQ(self.m_model.text(), "42");
    EXPECT_EQ(self.m_actions.committed, "42");
    EXPECT_EQ(self.actionCount(UiEditAction::Blur), 1u);
    ASSERT_TRUE(self.focusEditor());
    ASSERT_TRUE(self.actionFrame());
    EXPECT_EQ(self.m_model.text(), "42");
}

void VerifyUiEditActionHostTests_CancelRestorationFencesNativeSessionAndDelayedClipboardCompletion(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    self.m_clipboard.delayed = true;
    ASSERT_TRUE(self.key(Key::V, false, true));
    ASSERT_TRUE(self.actionFrame());
    ASSERT_TRUE(self.m_clipboard.pump());
    const ClipboardRequestToken request = self.m_clipboard.startedToken;
    ASSERT_TRUE(request.valid());
    const TextInputSessionToken oldSession = self.m_textInput.activeSession();
    ASSERT_TRUE(self.key(Key::Escape));
    ASSERT_TRUE(self.actionFrame());
    EXPECT_EQ(self.m_model.text(), "0");
    EXPECT_TRUE(self.m_result.cancelled);
    EXPECT_FALSE(self.m_clipboard.deliver(request, ClipboardStatus::Success, "late"));
    EXPECT_EQ(self.m_textInput.emitCommit(oldSession, "late"), TextInputAdmission::InvalidSession);
}

void VerifyUiEditActionHostTests_SubmitObservesItsExactPositionBeforeLaterCopiedNativeText(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    ASSERT_TRUE(self.replaceNative("42"));
    ASSERT_TRUE(self.key(Key::Enter));
    ASSERT_TRUE(self.commitNative("7"));
    self.m_host.collectNative();
    EXPECT_EQ(self.m_model.text(), "0");
    ASSERT_TRUE(self.actionFrame());
    EXPECT_TRUE(self.m_result.submitted);
    EXPECT_TRUE(self.m_result.focused);
    EXPECT_EQ(self.m_actions.committed, "42");
    EXPECT_EQ(self.m_model.text(), "427");
    ASSERT_EQ(self.m_actions.records.size(), 1u);
    EXPECT_EQ(self.m_actions.records[0u].text, "42");
    EXPECT_EQ(self.m_model.caret(), 3u);
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "42");
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "0");
}

void VerifyUiEditActionHostTests_CanonicalizingSubmitPreservesLaterCopiedCommitWhileRetiringItsNativeSession(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    self.m_actions.canonicalizeSubmit = true;
    const u64 external = self.m_model.externalRevision();
    const TextInputSessionToken oldSession = self.m_textInput.activeSession();
    ASSERT_TRUE(self.replaceNative("42"));
    ASSERT_TRUE(self.key(Key::Enter));
    ASSERT_TRUE(self.commitNative("7"));
    self.m_host.collectNative();
    EXPECT_EQ(self.m_model.text(), "0");
    ASSERT_TRUE(self.actionFrame());
    EXPECT_TRUE(self.m_result.submitted);
    EXPECT_TRUE(self.m_result.focused);
    EXPECT_EQ(self.m_actions.committed, "42");
    EXPECT_EQ(self.m_model.text(), "427");
    EXPECT_EQ(self.m_model.externalRevision(), external + 1u);
    EXPECT_EQ(self.m_model.anchor(), 3u);
    EXPECT_EQ(self.m_model.caret(), 3u);
    ASSERT_EQ(self.m_actions.records.size(), 1u);
    EXPECT_EQ(self.m_actions.records[0u].text, "42");
    ASSERT_TRUE(self.m_textInput.activeSession().valid());
    EXPECT_NE(self.m_textInput.activeSession(), oldSession);
    EXPECT_EQ(self.m_textInput.emitCommit(oldSession, "late"), TextInputAdmission::InvalidSession);
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "42");
    EXPECT_FALSE(self.m_model.canUndo());
}

void VerifyUiEditActionHostTests_SeveralSubmitsInOneBatchEachObserveTheirOwnDraft(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    ASSERT_TRUE(self.replaceNative("12"));
    ASSERT_TRUE(self.key(Key::Enter));
    ASSERT_TRUE(self.commitNative("3"));
    ASSERT_TRUE(self.key(Key::Enter));
    ASSERT_TRUE(self.commitNative("4"));
    ASSERT_TRUE(self.actionFrame());
    ASSERT_EQ(self.m_actions.records.size(), 2u);
    EXPECT_EQ(self.m_actions.records[0u].text, "12");
    EXPECT_EQ(self.m_actions.records[1u].text, "123");
    EXPECT_EQ(self.m_actions.committed, "123");
    EXPECT_EQ(self.m_model.text(), "1234");
}

void VerifyUiEditActionHostTests_CancelRestoresLastSubmittedDraftAndFencesRemainingOldOwnerText(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    ASSERT_TRUE(self.replaceNative("42"));
    ASSERT_TRUE(self.key(Key::Enter));
    ASSERT_TRUE(self.commitNative("7"));
    ASSERT_TRUE(self.key(Key::Escape));
    ASSERT_TRUE(self.commitNative("9"));
    const TextInputSessionToken oldSession = self.m_textInput.activeSession();
    ASSERT_TRUE(self.actionFrame());
    EXPECT_TRUE(self.m_result.submitted);
    EXPECT_TRUE(self.m_result.cancelled);
    EXPECT_FALSE(self.m_result.focused);
    EXPECT_EQ(self.m_actions.committed, "42");
    EXPECT_EQ(self.m_model.text(), "42");
    ASSERT_EQ(self.m_actions.records.size(), 2u);
    EXPECT_EQ(self.m_actions.records[1u].action, UiEditAction::Cancel);
    EXPECT_EQ(self.m_actions.records[1u].text, "427");
    EXPECT_EQ(self.m_textInput.emitCommit(oldSession, "late"), TextInputAdmission::InvalidSession);
}

void VerifyUiEditActionHostTests_TextBeforeTabIsLentBeforeItsOrderedBlurBoundary(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    const TextInputSessionToken oldSession = self.m_textInput.activeSession();
    ASSERT_TRUE(self.replaceNative("42"));
    ASSERT_TRUE(self.focusOther());
    EXPECT_EQ(self.m_model.text(), "0");
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.m_textInput.emitCommit(oldSession, "late"), TextInputAdmission::InvalidSession);
    ASSERT_TRUE(self.actionFrame());
    EXPECT_TRUE(self.m_result.blurred);
    EXPECT_FALSE(self.m_result.focused);
    EXPECT_EQ(self.m_model.text(), "42");
    EXPECT_EQ(self.m_actions.committed, "42");
    ASSERT_EQ(self.m_actions.records.size(), 1u);
    EXPECT_EQ(self.m_actions.records[0u].action, UiEditAction::Blur);
    EXPECT_EQ(self.m_actions.records[0u].text, "42");
    EXPECT_FALSE(self.m_model.canUndo());
    ASSERT_TRUE(self.actionFrame());
    EXPECT_EQ(self.actionCount(UiEditAction::Blur), 1u);
}

void VerifyUiEditActionHostTests_BlurRestorationOccursBeforeTheCurrentPaintSnapshot(mut UiEditActionHostTests self){
