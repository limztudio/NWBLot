#include <impl/assets_texture/asset.adhd>
#include <impl/ecs_ui/toolkit/images/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type SharedImageSource = Shared<ImageSource>;

class ImageSourceFactory{
    private Optional<in Texture> m_texture;

    public in Texture validatedTexture()const{
        if(!this.m_texture.has_value())
            TerminateInvariant();
        return this.m_texture.value();
    }

    public Expected<SharedImageSource> copy(in SharedPool pool, in borrow Texture texture)const{
        if(!ValidateImageSourceTextureDimension(texture.virtualPath(), texture.dimension() == TexturePayloadDimension::Texture2D, texture.depth()) || !texture.validatePayload())
            return MakeUnexpected(Failure());
        ImageSourceFactory validated;
        validated.m_texture = Optional<in Texture>(texture);
        return pool.make<ImageSource>(validated);
    }
}

class ImageSource : NoCopy{
    private AssetRef<Texture> m_identity;
    private Texture m_texture;
    private u64 m_generation;

    public ImageSource(in ImageSourceFactory factory){
        this.m_texture = Texture(factory.validatedTexture());
        this.m_identity = AssetRef<Texture>(factory.validatedTexture().virtualPath());
        this.m_generation = AllocateServiceIdentity();
    }

    public in AssetRef<Texture> identity()const{ return this.m_identity; }
    public u64 generation()const{ return this.m_generation; }
    public in Texture texture()const{ return this.m_texture; }
}

Expected<SharedImageSource> MakeImageSource(in SharedPool pool, in borrow Texture texture){
    return ImageSourceFactory().copy(pool, texture);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

