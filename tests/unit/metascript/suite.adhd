[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace AdhdCompilerTestsDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MockIncludeResolver::resolveInclude(const Core::Metascript::MStringView includePath, const b8, Core::Metascript::MetaArena& arena, Core::Metascript::MString& outResolvedKey, Core::Metascript::MString& outContent){
    ++resolveCallCount;
    outResolvedKey = Core::Metascript::MString(includePath.data(), includePath.size(), arena);
    if(includePath == "shared_service.adhd"){
        static constexpr Core::Metascript::MStringView s_ServiceHeader =
            "interface IStore<T> {\r\n"
            "    void put(in T value);\r\n"
            "}\r\n"
            "[reflect]\r\n"
            "class SharedService {\r\n"
            "    private i32 m_total = 0;\r\n"
            "    public i32 accumulate(in i32 delta);\r\n"
            "}\r\n";
        outContent = Core::Metascript::MString(s_ServiceHeader.data(), s_ServiceHeader.size(), arena);
        return true;
    }
    if(includePath == "foreign_bridge.adhd"){
        static constexpr Core::Metascript::MStringView s_ForeignBridge =
            "#include \"foreign_defs.adhd\"\r\n"
            "const u32 kSameBridgeConst = 3u;\r\n";
        outContent = Core::Metascript::MString(s_ForeignBridge.data(), s_ForeignBridge.size(), arena);
        return true;
    }
    if(includePath == "foreign_defs.adhd"){
        static constexpr Core::Metascript::MStringView s_ForeignDefs =
            "const u32 kForeignCap = 4;\r\n"
            "const u32 kForeignConst = 7u;\r\n"
            "const u32 kForeignOther = 11u;\r\n"
            "enum<u8> ForeignMode { Alpha = 1, Beta = 2, kCount }\r\n"
            "[serialize]\r\n"
            "class ForeignItem {\r\n"
            "    public u32 tag = 1u;\r\n"
            "}\r\n"
            "[arena, asset(\"mock_foreign\")]\r\n"
            "class ForeignAsset {\r\n"
            "    public u32 dummy = 0u;\r\n"
            "}\r\n"
            "u32 ForeignFn(in u32 x) {\r\n"
            "    return x + kForeignOther;\r\n"
            "}\r\n";
        outContent = Core::Metascript::MString(s_ForeignDefs.data(), s_ForeignDefs.size(), arena);
        return true;
    }
    static constexpr Core::Metascript::MStringView s_HeaderCode = "const u32 kSharedLimit = 16;\r\n";
    outContent = Core::Metascript::MString(s_HeaderCode.data(), s_HeaderCode.size(), arena);
    return true;
}

Core::Metascript::MStringView MockIncludeResolver::resolveIncludeNamespace(const Core::Metascript::MStringView resolvedKey)const noexcept{
    if(resolvedKey == "foreign_defs.adhd")
        return "NWB::MockForeign";
    return {};
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_END


