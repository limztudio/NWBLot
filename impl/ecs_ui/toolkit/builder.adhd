    private ShapeRequest textShapeRequest(in StringView text, in f32 fontSize)const{
        ShapeRequest request;
        request.text = text;
        request.language = StringView(this.m_textLanguage);
        request.font = this.m_style.font;
        request.fontSize = fontSize;
        request.scriptTag = this.m_textScriptTag;
        request.direction = this.m_textDirection;
        request.bidiMode = this.m_textBidiMode;
        return request;
    }

