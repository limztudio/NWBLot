[cpp_header("<impl/ecs_ui/toolkit/text/harfbuzz_sdk.h>"), cpp_name("::NWB::UiFontSdk::HarfBuzzFont"), cpp_flags(self_defaulted, no_copy, no_assign)]
extern class HarfBuzzFont{
    b8 open(in Span<u8> bytes, in u32 faceIndex);
    b8 valid()const;
    u32 unitsPerEm()const;
    u32 glyphCount()const;
    u32 tableLength(in u32 tag)const;
    b8 copyTable(in u32 tag, mut Span<u8> destination)const;
    void setOpenTypeFunctions();
    void setScale(in i32 x, in i32 y);
    b8 horizontalExtents(mut HarfBuzzFontExtents extents)const;
    b8 glyphExtents(in u32 glyph, mut HarfBuzzGlyphExtents extents)const;
    b8 hasNominalGlyph(in u32 codepoint)const;
    b8 hasVariationGlyph(in u32 codepoint, in u32 variationSelector)const;
};

[cpp_header("<impl/ecs_ui/toolkit/text/harfbuzz_sdk.h>"), cpp_name("::NWB::UiFontSdk::UiOpenTypeFeature"), cpp_flags(self_defaulted)]
extern class HarfBuzzOpenTypeFeature{
    u32 tag;
    u32 value;
    u32 start;
    u32 end;
};

[cpp_header("<impl/ecs_ui/toolkit/text/harfbuzz_sdk.h>"), cpp_name("::NWB::UiFontSdk::HarfBuzzBuffer"), cpp_flags(self_defaulted, no_copy, no_assign)]
extern class HarfBuzzBuffer{
    b8 valid()const;
    void clear();
    void setDirection(in HarfBuzzDirection direction);
    void setScript(in HarfBuzzScript script);
    void setClusterLevel(in HarfBuzzClusterLevel level);
    b8 setLanguage(in StringView language);
    b8 addUtf8(in StringView text, in u32 offset, in u32 count);
    void shape(in HarfBuzzFont font);
    void shapeWithFeatures(in HarfBuzzFont font, in Span<HarfBuzzOpenTypeFeature> features);
    Span<HarfBuzzGlyphInfo> glyphInfos()const;
    Span<HarfBuzzGlyphPosition> glyphPositions()const;
};


