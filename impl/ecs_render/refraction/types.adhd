// A completed accepted diagnostic copy, regardless of later presentation outcome.
class RefractionStatistics{
    public u64 sequence = 0u;
    public u64 generation = 0u;
    public u64 graphicsFrameIndex = 0u;
    public QueueSubmissionToken acceptedToken = QueueSubmissionToken();
    public u32 frameIndex = 0u;
    public u32 width = 0u;
    public u32 height = 0u;
    public u32 hardwarePixels = 0u;
    public u32 entryQueries = 0u;
    public u32 entryAssociationMisses = 0u;
    public u32 entryWrongEntities = 0u;
    public u32 entryFailures = 0u;
    public u32 associatedEntries = 0u;
    public u32 invalidEntryDirections = 0u;
    public u32 exitQueries = 0u;
    public u32 exitMisses = 0u;
    public u32 exitFailures = 0u;
    public u32 tirEvents = 0u;
    public u32 tirCappedPixels = 0u;
    public u32 volumeExits = 0u;
    public u32 backgroundQueries = 0u;
    public u32 backgroundMisses = 0u;
    public u32 backgroundFailures = 0u;
    public u32 secondaryGlassPixels = 0u;
    public u32 transparentHits = 0u;
    public u32 backgroundLayerCapPixels = 0u;
    public u32 cachedOpaqueReturns = 0u;
    public u32 shadedOpaqueReturns = 0u;
    public u32 exitScreenBackgroundReturns = 0u;
    public u32 exitStraightFallbackPixels = 0u;
    public u32 materialShadeCalls = 0u;
    public u32 cachedHitAttempts = 0u;
    public u32 cachedHitMisses = 0u;
    public u32 physicalQueries = 0u;
    public u32 queryBudgetUnits = 0u;
    public u32 overflowFlags = 0u;
    public b8 hardwareRequested = false;
    public b8 hardwareAvailable = false;
    public b8 hardwareReady = false;
    public b8 csgHardwareEnabled = false;
}

[serialize]
class RefractionPushConstants{
    public u32 width = 0u;
    public u32 height = 0u;
    public u32 deferredResourcesHeapSlot = 0u;
    public u32 materialContextSlotsHeapSlot = 0u;
    public u32 viewHeapSlot = 0u;
    public u32 opaqueReflectionSlot = s_RtInvalidSlot;
    public u32 refractionEnabled = 1u;
    public u32 tileListSlot = 0u;
    public u32 tileArgumentsSlot = 0u;
    public u32 diagnosticsSlot = s_RtInvalidSlot;
    public u32 certifiedInstanceIndex = s_RtInvalidSlot;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void CopyRefractionDiagnosticCounters(in Span<u32> completedCounters, mut RefractionStatistics latest){
    latest.hardwarePixels = completedCounters[0u];
    latest.entryQueries = completedCounters[1u];
    latest.entryAssociationMisses = completedCounters[2u];
    latest.entryWrongEntities = completedCounters[3u];
    latest.entryFailures = completedCounters[4u];
    latest.associatedEntries = completedCounters[5u];
    latest.invalidEntryDirections = completedCounters[6u];
    latest.exitQueries = completedCounters[7u];
    latest.exitMisses = completedCounters[8u];
    latest.exitFailures = completedCounters[9u];
    latest.tirEvents = completedCounters[10u];
    latest.tirCappedPixels = completedCounters[11u];
    latest.volumeExits = completedCounters[12u];
    latest.backgroundQueries = completedCounters[13u];
    latest.backgroundMisses = completedCounters[14u];
    latest.backgroundFailures = completedCounters[15u];
    latest.secondaryGlassPixels = completedCounters[16u];
    latest.transparentHits = completedCounters[17u];
    latest.backgroundLayerCapPixels = completedCounters[18u];
    latest.cachedOpaqueReturns = completedCounters[19u];
    latest.shadedOpaqueReturns = completedCounters[20u];
    latest.exitScreenBackgroundReturns = completedCounters[21u];
    latest.exitStraightFallbackPixels = completedCounters[22u];
    latest.materialShadeCalls = completedCounters[23u];
    latest.cachedHitAttempts = completedCounters[24u];
    latest.cachedHitMisses = completedCounters[25u];
    latest.physicalQueries = completedCounters[26u];
    latest.queryBudgetUnits = completedCounters[27u];
    latest.overflowFlags = completedCounters[28u];
}

RefractionPushConstants ResolveRefractionPushConstants(
    in u32 width,
    in u32 height,
    in u32 deferredResourcesHeapSlot,
    in u32 materialContextSlotsHeapSlot,
    in u32 viewHeapSlot,
    in u32 opaqueReflectionSlot,
    in b8 refractionEnabled,
    in u32 tileListSlot,
    in u32 tileArgumentsSlot,
    in u32 diagnosticsSlot,
    in u32 certifiedInstanceIndex
){
    RefractionPushConstants push;
    push.width = width;
    push.height = height;
    push.deferredResourcesHeapSlot = deferredResourcesHeapSlot;
    push.materialContextSlotsHeapSlot = materialContextSlotsHeapSlot;
    push.viewHeapSlot = viewHeapSlot;
    push.opaqueReflectionSlot = opaqueReflectionSlot;
    if(refractionEnabled)
        push.refractionEnabled = 1u;
    else
        push.refractionEnabled = 0u;
    push.tileListSlot = tileListSlot;
    push.tileArgumentsSlot = tileArgumentsSlot;
    push.diagnosticsSlot = diagnosticsSlot;
    push.certifiedInstanceIndex = certifiedInstanceIndex;
    return push;
}

StringView ResolveRefractionVariant(in b8 hardware, in b8 diagnostics, in b8 csg, in b8 dense){
    if(!hardware){
        if(dense)
            return s_RefractionScreenDenseVariant;
        return s_RefractionScreenSparseVariant;
    }
    if(diagnostics){
        if(csg){
            if(dense)
                return s_RefractionDiagnosticCsgHwDenseVariant;
            return s_RefractionDiagnosticCsgHwSparseVariant;
        }
        if(dense)
            return s_RefractionDiagnosticHwDenseVariant;
        return s_RefractionDiagnosticHwSparseVariant;
    }
    if(csg){
        if(dense)
            return s_RefractionCsgHardwareDenseVariant;
        return s_RefractionCsgHardwareSparseVariant;
    }
    if(dense)
        return s_RefractionHardwareDenseVariant;
    return s_RefractionHardwareSparseVariant;
}

Name ResolveRefractionPipelineDebugName(in b8 hardware, in b8 dense){
    if(hardware){
        if(dense)
            return s_RefractionHwDenseDebugName;
        return s_RefractionHwDebugName;
    }
    if(dense)
        return s_RefractionScreenDenseDebugName;
    return s_RefractionScreenDebugName;
}

RefractionStatistics MakeRefractionSnapshotMetadata(
    in u32 frameIndex,
    in u64 graphicsFrameIndex,
    in u32 width,
    in u32 height,
    in b8 hardwareRequested,
    in b8 usesHardwareTrace,
    in b8 csg
){
    RefractionStatistics metadata;
    metadata.frameIndex = frameIndex;
    metadata.graphicsFrameIndex = graphicsFrameIndex;
    metadata.width = width;
    metadata.height = height;
    metadata.hardwareRequested = hardwareRequested;
    metadata.hardwareAvailable = usesHardwareTrace;
    metadata.csgHardwareEnabled = usesHardwareTrace && csg;
    return metadata;
}

void LogCreatedRefractionResolvePipeline(in b8 hardware, in b8 dense){
    StringView traceLabel = "screen space";
    if(hardware)
        traceLabel = "hardware ray query";
    StringView densityLabel = "sparse queue";
    if(dense)
        densityLabel = "dense grid";
    [essential]
    info(
        "RendererSystem: created refraction resolve pipeline ({}, {})"
        , traceLabel
        , densityLabel
    );
}

void LogAcceptedRefractionResolveIfNeeded(in b8 usedHardware, mut b8 inOutLogged){
    if(inOutLogged)
        return;
    StringView routeLabel = "screen-space";
    if(usedHardware)
        routeLabel = "hardware";
    [essential]
    info(
        "AVBOIT refraction resolve: {}"
        , routeLabel
    );
    inOutLogged = true;
}


