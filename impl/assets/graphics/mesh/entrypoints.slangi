////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_MESH_SHADER_ENTRYPOINTS_SLANGI
#define NWB_GRAPHICS_MESH_SHADER_ENTRYPOINTS_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if NWB_MESH_SHADER_EMULATION_COMPUTE


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[numthreads(NWB_MESH_SHADER_GROUP_SIZE_X, 1, 1)]
void main(uint3 groupThreadID : SV_GroupThreadID, uint3 groupID : SV_GroupID){
    const uint meshletIndex = groupID.x;
    if(meshletIndex >= nwbMeshletCount())
        return;

#if NWB_MESH_EMULATION_INDEXED_OUTPUT
    // One writer initializes the sentinel even when the first meshlet is culled.
    if(meshletIndex == 0u && groupThreadID.x == 0u)
        nwbMeshInitializeCulledVertex();
#endif

    nwbMeshLoadGeometryHeapSlots(groupThreadID.x);
    const NwbMeshletDesc meshlet = NwbHeapMeshletDescs(
        nwbMeshGeometryHeapSlot(NWB_MESH_BINDING_MESHLET_DESC)
    )[meshletIndex];
    const NwbMeshletRefDecodeInfo decodeInfo = nwbMeshletBuildRefDecodeInfo(meshlet);
    const NwbMeshInstanceData instance = nwbMeshLoadInstance();
    const NwbMeshletCullContext cullContext = nwbMeshBuildMeshletCullContext(meshletIndex, instance);
    const bool meshletCulled = nwbMeshletCulled(cullContext, instance);
    const uint primitiveCount = nwbMeshletPrimitiveCount(meshlet);
    if(meshletCulled){
        for(
            uint localPrimitiveIndex = groupThreadID.x;
            localPrimitiveIndex < primitiveCount;
            localPrimitiveIndex += NWB_MESH_SHADER_GROUP_SIZE_X
        )
            nwbMeshStoreCulledEmulationPrimitive(nwbMeshletPrimitiveBase(meshlet, localPrimitiveIndex));
        return;
    }

#if NWB_CSG_ENABLED
    const uint csgMeshletClass = nwbMeshCsgClassifyMeshlet(cullContext);
    if(nwbMeshCsgFullyRemovedCullEnabled() && csgMeshletClass == NWB_CSG_MESHLET_CLASS_FULLY_REMOVED){
        for(
            uint localPrimitiveIndex = groupThreadID.x;
            localPrimitiveIndex < primitiveCount;
            localPrimitiveIndex += NWB_MESH_SHADER_GROUP_SIZE_X
        )
            nwbMeshStoreCulledEmulationPrimitive(nwbMeshletPrimitiveBase(meshlet, localPrimitiveIndex));
        return;
    }
    nwbMeshSetMeshletRasterFlags(nwbMeshCsgRasterFlags(csgMeshletClass), groupThreadID.x);
#else
    nwbMeshSetMeshletRasterFlags(0u, groupThreadID.x);
#endif

    nwbMeshBuildMeshletPositions(meshlet, decodeInfo, instance, groupThreadID.x);

    // Full local-reference identity preserves attribute seams and meshlet-specific raster flags.
    // Meshlet-level exits precede this cooperative phase, so all remaining lanes reach the barrier.
    const uint localVertexCount = nwbMeshletVertexCount(meshlet);
    for(
        uint localVertexIndex = groupThreadID.x;
        localVertexIndex < localVertexCount;
        localVertexIndex += NWB_MESH_SHADER_GROUP_SIZE_X
    ){
        const NwbMeshGeneratedVertex generatedVertex = nwbMeshBuildMeshletVertex(
            meshletIndex,
            meshlet,
            decodeInfo,
            localVertexIndex,
            instance
        );
#if NWB_MESH_EMULATION_INDEXED_OUTPUT
        const uint outputVertexIndex = NWB_MESH_EMULATION_FIRST_VERTEX_INDEX + meshlet.localVertexOffset + localVertexIndex;
        nwbMeshGeneratedVertices()[outputVertexIndex] = generatedVertex;
        g_NwbMeshletStagedClipPositions[localVertexIndex] = generatedVertex.position;
#else
        g_NwbMeshletStagedVertices[localVertexIndex] = generatedVertex;
#endif
    }
    GroupMemoryBarrierWithGroupSync();

    for(
        uint localPrimitiveIndex = groupThreadID.x;
        localPrimitiveIndex < primitiveCount;
        localPrimitiveIndex += NWB_MESH_SHADER_GROUP_SIZE_X
    ){
        const uint primitiveBase = nwbMeshletPrimitiveBase(meshlet, localPrimitiveIndex);
        const uint3 localVertexIndices = nwbMeshLoadMeshletPrimitive(primitiveBase);
#if NWB_MESH_EMULATION_INDEXED_OUTPUT
        const float4 a = g_NwbMeshletStagedClipPositions[localVertexIndices.x];
        const float4 b = g_NwbMeshletStagedClipPositions[localVertexIndices.y];
        const float4 c = g_NwbMeshletStagedClipPositions[localVertexIndices.z];
        const bool triangleCulled = nwbMeshAllOutsideClipPlane(a, b, c) || nwbMeshAllOutsideScissor(a, b, c);
        const uint3 outputIndices = triangleCulled
            ? uint3(NWB_MESH_EMULATION_SENTINEL_VERTEX_INDEX)
            : localVertexIndices + (NWB_MESH_EMULATION_FIRST_VERTEX_INDEX + meshlet.localVertexOffset)
        ;
        nwbMeshStoreGeneratedIndices(primitiveBase, outputIndices);
#else
        NwbMeshGeneratedVertex generatedVertices[NWB_MESHLET_TRIANGLE_INDEX_COUNT];
        for(uint corner = 0u; corner < NWB_MESHLET_TRIANGLE_INDEX_COUNT; ++corner)
            generatedVertices[corner] = g_NwbMeshletStagedVertices[localVertexIndices[corner]];

        if(nwbMeshTriangleCulled(generatedVertices)){
            nwbMeshStoreCulledEmulationPrimitive(primitiveBase);
            continue;
        }

        for(uint corner = 0u; corner < NWB_MESHLET_TRIANGLE_INDEX_COUNT; ++corner)
            nwbMeshGeneratedVertices()[primitiveBase + corner] = generatedVertices[corner];
#endif
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#else


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[shader("mesh")]
[numthreads(NWB_MESH_SHADER_GROUP_SIZE_X, 1, 1)]
[outputtopology("triangle")]
void main(
    uint3 groupThreadID : SV_GroupThreadID,
    uint3 groupID : SV_GroupID,
    OutputVertices<NwbMeshRasterVertex, NWB_MESH_SHADER_MAX_VERTICES> vertices,
    OutputIndices<uint3, NWB_MESH_SHADER_MAX_TRIANGLES> triangles
){
    const uint meshletIndex = groupID.x;
    if(meshletIndex >= nwbMeshletCount()){
        SetMeshOutputCounts(0u, 0u);
        return;
    }

    const uint groupThreadIndex = groupThreadID.x;
    nwbMeshLoadGeometryHeapSlots(groupThreadIndex);
    const NwbMeshletDesc meshlet = NwbHeapMeshletDescs(
        nwbMeshGeometryHeapSlot(NWB_MESH_BINDING_MESHLET_DESC)
    )[meshletIndex];
    const NwbMeshletRefDecodeInfo decodeInfo = nwbMeshletBuildRefDecodeInfo(meshlet);
    const NwbMeshInstanceData instance = nwbMeshLoadInstance();
    const NwbMeshletCullContext cullContext = nwbMeshBuildMeshletCullContext(meshletIndex, instance);
    if(nwbMeshletCulled(cullContext, instance)){
        SetMeshOutputCounts(0u, 0u);
        return;
    }

#if NWB_CSG_ENABLED
    const uint csgMeshletClass = nwbMeshCsgClassifyMeshlet(cullContext);
    if(nwbMeshCsgFullyRemovedCullEnabled() && csgMeshletClass == NWB_CSG_MESHLET_CLASS_FULLY_REMOVED){
        SetMeshOutputCounts(0u, 0u);
        return;
    }
    nwbMeshSetMeshletRasterFlags(nwbMeshCsgRasterFlags(csgMeshletClass), groupThreadIndex);
#else
    nwbMeshSetMeshletRasterFlags(0u, groupThreadIndex);
#endif

    const uint vertexCount = nwbMeshletVertexCount(meshlet);
    const uint primitiveCount = nwbMeshletPrimitiveCount(meshlet);
    nwbMeshBuildMeshletPositions(meshlet, decodeInfo, instance, groupThreadIndex);

    SetMeshOutputCounts(vertexCount, primitiveCount);

    for(
        uint localVertexIndex = groupThreadIndex;
        localVertexIndex < vertexCount;
        localVertexIndex += NWB_MESH_SHADER_GROUP_SIZE_X
    ){
        vertices[localVertexIndex] = nwbMeshBuildRasterVertex(
            nwbMeshBuildMeshletVertex(
                meshletIndex,
                meshlet,
                decodeInfo,
                localVertexIndex,
                instance
            )
        );
    }

    for(
        uint localPrimitiveIndex = groupThreadIndex;
        localPrimitiveIndex < primitiveCount;
        localPrimitiveIndex += NWB_MESH_SHADER_GROUP_SIZE_X
    ){
        triangles[localPrimitiveIndex] = nwbMeshLoadMeshletPrimitive(
            nwbMeshletPrimitiveBase(meshlet, localPrimitiveIndex)
        );
    }
}


