void VerifyFloatModelTests_ExponentDraftStaysUncommittedUntilCompleteSubmit(mut FloatModelTests self){
    ASSERT_TRUE(self.m_model.setValue(1.25));
    Array<StringView, 2u> drafts = Array<StringView, 2u>();
    drafts[0u] = "1.25e";
    drafts[1u] = "1.25e-";
    for(in StringView text : drafts){
        ASSERT_TRUE(self.m_model.setDraft(text));
        EXPECT_EQ(self.m_model.status(), NumericParseStatus::Incomplete);
        ExpectNumericEditRejected(self.m_model.submit(), false);
        EXPECT_EQ(self.m_model.value(), 1.25);
        EXPECT_EQ(self.m_model.draft().text(), text);
    }
    ASSERT_TRUE(self.m_model.setDraft("1.25e-1"));
    const NumericEditResult submitted = self.m_model.submit();
    ASSERT_TRUE(submitted.valid);
    EXPECT_TRUE(submitted.committed);
    EXPECT_TRUE(submitted.valueChanged);
    EXPECT_EQ(bit_cast<u64>(self.m_model.value()), bit_cast<u64>(0.125));
    EXPECT_EQ(self.m_model.draft().text(), "1.25e-1");
    EXPECT_FALSE(self.m_model.dirty());
}

void VerifyFloatModelTests_SignedZeroIsPreservedAndItsSignChangeIsReported(mut FloatModelTests self){
    ASSERT_TRUE(self.m_model.setDraft("-0e100"));
    const NumericEditResult negative = self.m_model.submit();
    ASSERT_TRUE(negative.valid);
    EXPECT_TRUE(negative.committed);
    EXPECT_TRUE(negative.valueChanged);
    EXPECT_EQ(bit_cast<u64>(self.m_model.value()), 0x8000000000000000u);
    ASSERT_TRUE(self.m_model.blur().committed);
    EXPECT_EQ(self.m_model.draft().text(), "-0");
    ASSERT_TRUE(self.m_model.setDraft("0"));
    const NumericEditResult positive = self.m_model.submit();
    ASSERT_TRUE(positive.valid);
    EXPECT_TRUE(positive.valueChanged);
    EXPECT_EQ(bit_cast<u64>(self.m_model.value()), 0u);
}

void VerifyFloatModelTests_BoundsClampFiniteRepresentableValuesAndCanonicalize(mut FloatModelTests self){
    const FloatBounds bounds = MakeUiFloatModelBounds(-10.0, 10.0, NumericBoundsPolicy::Clamp);
    ASSERT_TRUE(self.m_model.setDraft("9.9e1"));
    EXPECT_EQ(self.m_model.status(bounds), NumericParseStatus::OutOfRange);
    const NumericEditResult high = self.m_model.submit(bounds);
    ASSERT_TRUE(high.valid);
    EXPECT_TRUE(high.committed);
    EXPECT_TRUE(high.clamped);
    EXPECT_TRUE(high.valueChanged);
    EXPECT_FALSE(high.restored);
    EXPECT_EQ(self.m_model.value(), 10.0);
    EXPECT_EQ(self.m_model.draft().text(), "10");
    ASSERT_TRUE(self.m_model.setDraft("-99"));
    const NumericEditResult low = self.m_model.blur(bounds);
    ASSERT_TRUE(low.valid);
    EXPECT_TRUE(low.clamped);
    EXPECT_EQ(self.m_model.value(), -10.0);
    EXPECT_EQ(self.m_model.draft().text(), "-10");
}

void VerifyFloatModelTests_RejectionAndInvalidBlurRestoreCanonicalCurrentValue(mut FloatModelTests self){
    ASSERT_TRUE(self.m_model.setDraft("+01.250e0"));
    ASSERT_TRUE(self.m_model.submit().committed);
    const FloatBounds bounds = MakeUiFloatModelBounds(-10.0, 10.0, NumericBoundsPolicy::Reject);
    ASSERT_TRUE(self.m_model.setDraft("99"));
    const MultilineSnapshot before = MultilineSnapshot(self.m_arena, self.m_model.draft());
    ExpectNumericEditRejected(self.m_model.submit(bounds), false);
    before.expectUnchanged(self.m_model.draft());
    ExpectNumericEditRejected(self.m_model.blur(bounds), true);
    EXPECT_EQ(self.m_model.value(), 1.25);
    EXPECT_EQ(self.m_model.draft().text(), "1.25");
    EXPECT_FALSE(self.m_model.dirty());
}

void VerifyFloatModelTests_OverflowUnderflowAndNonfiniteSpellingsNeverClamp(mut FloatModelTests self){
    ASSERT_TRUE(self.m_model.setValue(1.25));
    const FloatBounds bounds = MakeUiFloatModelBounds(-10.0, 10.0, NumericBoundsPolicy::Clamp);
    Array<StringView, 6u> drafts = Array<StringView, 6u>();
    drafts[0u] = "1e309";
    drafts[1u] = "1e-9999";
    drafts[2u] = "nan";
    drafts[3u] = "-inf";
    drafts[4u] = "x";
    drafts[5u] = "-";
    for(in StringView text : drafts){
        const ScopedTestTrace trace = ScopedTestTrace(text);
        ASSERT_TRUE(self.m_model.setDraft(text));
        ExpectNumericEditRejected(self.m_model.submit(bounds), false);
        EXPECT_EQ(self.m_model.value(), 1.25);
        EXPECT_EQ(self.m_model.draft().text(), text);
        ExpectNumericEditRejected(self.m_model.blur(bounds), true);
        EXPECT_EQ(self.m_model.draft().text(), "1.25");
    }
}

void VerifyFloatModelTests_NonfiniteExternalAssignmentsPreserveEveryExistingDraftField(mut FloatModelTests self){
    ASSERT_TRUE(self.m_model.setValue(1.25));
    ASSERT_TRUE(self.m_model.lendDraft().replaceSelection("0"));
    ASSERT_TRUE(self.m_model.lendDraft().setSelection(0u, 1u));
    ASSERT_TRUE(self.m_model.lendDraft().beginComposition());
    ASSERT_TRUE(self.m_model.lendDraft().updateComposition("3", 0u, 1u));
    const MultilineSnapshot before = MultilineSnapshot(self.m_arena, self.m_model.draft());
    const u64 epoch = self.m_model.revision();
    Array<f64, 3u> values = Array<f64, 3u>();
    values[0u] = UiFloatModelInfinity();
    values[1u] = -UiFloatModelInfinity();
    values[2u] = UiFloatModelQuietNaN();
    for(in f64 value : values){
        EXPECT_FALSE(self.m_model.setValue(value));
        EXPECT_EQ(self.m_model.revision(), epoch);
        EXPECT_EQ(self.m_model.value(), 1.25);
        before.expectUnchanged(self.m_model.draft());
    }
}

void VerifyFloatModelTests_ExtremeSubnormalAndAdjacentUlpValuesRoundtripWithExactBits(mut FloatModelTests self){
    Array<u64, 9u> patterns = Array<u64, 9u>();
    patterns[0u] = 0x0000000000000001u;
    patterns[1u] = 0x8000000000000001u;
    patterns[2u] = 0x000fffffffffffffu;
    patterns[3u] = 0x0010000000000000u;
    patterns[4u] = 0x3fefffffffffffffu;
    patterns[5u] = 0x3ff0000000000001u;
    patterns[6u] = 0x4340000000000001u;
    patterns[7u] = 0x7fefffffffffffffu;
    patterns[8u] = 0xffefffffffffffffu;
    for(in u64 bits : patterns){
        const ScopedTestTrace trace = ScopedTestTrace(bits);
        ASSERT_TRUE(self.m_model.setValue(bit_cast<f64>(bits)));
        ASSERT_TRUE(self.m_model.submit().committed);
        EXPECT_EQ(bit_cast<u64>(self.m_model.value()), bits);
        ASSERT_TRUE(self.m_model.blur().committed);
        EXPECT_EQ(bit_cast<u64>(self.m_model.value()), bits);
        ASSERT_TRUE(self.m_model.setDraft("-"));
        ASSERT_TRUE(self.m_model.cancel().valid);
        const Expected<f64, NumericParseStatusEnum> parsed = ParseFloatDraft(self.m_model.draft().text());
        ASSERT_TRUE(parsed.has_value());
        EXPECT_EQ(bit_cast<u64>(parsed.value()), bits);
    }
}

void VerifyFloatModelTests_ExternalFiniteValueCanRemainOutsideUserBounds(mut FloatModelTests self){
    ASSERT_TRUE(self.m_model.setValue(1000.25));
    const FloatBounds bounds = MakeUiFloatModelBounds(-10.0, 10.0, NumericBoundsPolicy::Reject);
    ExpectNumericEditRejected(self.m_model.submit(bounds), false);
    ExpectNumericEditRejected(self.m_model.blur(bounds), false);
    EXPECT_EQ(self.m_model.value(), 1000.25);
    EXPECT_EQ(self.m_model.draft().text(), "1000.25");
}


