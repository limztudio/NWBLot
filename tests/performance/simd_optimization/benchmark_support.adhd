namespace SimdOptimizationBenchmark{
using NWB::Tests::FloatingPointEnvironmentGuard;

namespace SimdBaselineKernels{
// The references use the same floating-point environment as the candidates.
[[nodiscard]] FOUNDATION_INLINE SIMDVectorDouble FOUNDATION_SIMD_CALL Dot2(const SIMDVectorDouble lhs, const SIMDVectorDouble rhs)noexcept{
#pragma STDC FENV_ACCESS ON
    const SIMDVectorDouble product = VectorDoubleMultiply(VectorDoubleAndInt(lhs, s_DoubleSIMDMaskXY), VectorDoubleAndInt(rhs, s_DoubleSIMDMaskXY));
    return VectorDoubleAdd(VectorDoubleSplatX(product), VectorDoubleSplatY(product));
}

[[nodiscard]] FOUNDATION_INLINE SIMDVectorDouble FOUNDATION_SIMD_CALL Dot3(const SIMDVectorDouble lhs, const SIMDVectorDouble rhs)noexcept{
#pragma STDC FENV_ACCESS ON
    const SIMDVectorDouble product = VectorDoubleMultiply(VectorDoubleAndInt(lhs, s_DoubleSIMDMask3), VectorDoubleAndInt(rhs, s_DoubleSIMDMask3));
    const SIMDVectorDouble xy = VectorDoubleAdd(VectorDoubleSplatX(product), VectorDoubleSplatY(product));
    return VectorDoubleAdd(xy, VectorDoubleSplatZ(product));
}

[[nodiscard]] FOUNDATION_INLINE SIMDVectorDouble FOUNDATION_SIMD_CALL Dot4(const SIMDVectorDouble lhs, const SIMDVectorDouble rhs)noexcept{
#pragma STDC FENV_ACCESS ON
    const SIMDVectorDouble product = VectorDoubleMultiply(lhs, rhs);
    const SIMDVectorDouble xy = VectorDoubleAdd(VectorDoubleSplatX(product), VectorDoubleSplatY(product));
    const SIMDVectorDouble xyz = VectorDoubleAdd(xy, VectorDoubleSplatZ(product));
    return VectorDoubleAdd(xyz, VectorDoubleSplatW(product));
}

[[nodiscard]] FOUNDATION_INLINE SIMDVectorDouble FOUNDATION_SIMD_CALL Sum(const SIMDVectorDouble value)noexcept{
#pragma STDC FENV_ACCESS ON
    const SIMDVectorDouble xy = VectorDoubleAdd(VectorDoubleSplatX(value), VectorDoubleSplatY(value));
    const SIMDVectorDouble xyz = VectorDoubleAdd(xy, VectorDoubleSplatZ(value));
    return VectorDoubleAdd(xyz, VectorDoubleSplatW(value));
}
}

FOUNDATION_INLINE void WriteBenchmarkStdout(const AStringView text){
    FOUNDATION_COUT << text;
}

FOUNDATION_INLINE void WriteBenchmarkStderr(const AStringView text){
    FOUNDATION_CERR << text;
}

[[nodiscard]] FOUNDATION_INLINE SIMDVectorDouble FOUNDATION_SIMD_CALL SimdBaselineDot2(const SIMDVectorDouble lhs, const SIMDVectorDouble rhs)noexcept{
    return SimdBaselineKernels::Dot2(lhs, rhs);
}

[[nodiscard]] FOUNDATION_INLINE SIMDVectorDouble FOUNDATION_SIMD_CALL SimdBaselineDot3(const SIMDVectorDouble lhs, const SIMDVectorDouble rhs)noexcept{
    return SimdBaselineKernels::Dot3(lhs, rhs);
}

[[nodiscard]] FOUNDATION_INLINE SIMDVectorDouble FOUNDATION_SIMD_CALL SimdBaselineDot4(const SIMDVectorDouble lhs, const SIMDVectorDouble rhs)noexcept{
    return SimdBaselineKernels::Dot4(lhs, rhs);
}

[[nodiscard]] FOUNDATION_INLINE SIMDVectorDouble FOUNDATION_SIMD_CALL SimdBaselineSum(const SIMDVectorDouble value)noexcept{
    return SimdBaselineKernels::Sum(value);
}

[[nodiscard]] FOUNDATION_INLINE u64 FOUNDATION_SIMD_CALL SimdGetDoubleLaneBits(const SIMDVectorDouble value, const usize lane)noexcept{
    return VectorDoubleGetIntByIndex(value, lane);
}

[[nodiscard]] FOUNDATION_INLINE u32 FOUNDATION_SIMD_CALL SimdGetSingleLaneBits(const SIMDVectorSingle value, const usize lane)noexcept{
    return VectorGetIntByIndex(value, lane);
}

[[nodiscard]] FOUNDATION_INLINE f32 FOUNDATION_SIMD_CALL SimdGetSingleLane(const SIMDVectorSingle value, const usize lane)noexcept{
    return VectorGetByIndex(value, lane);
}

[[nodiscard]] inline constexpr i32 SimdRoundingModeByIndex(const usize index)noexcept{
    constexpr Array<i32, 4> s_Modes = { FE_TONEAREST, FE_DOWNWARD, FE_UPWARD, FE_TOWARDZERO };
    return s_Modes[index];
}

template<typename EvalT>
[[nodiscard]] FOUNDATION_INLINE b8 ObserveBinaryEvaluation(const EvalT& evaluator, const SIMDVectorDouble lhs, const SIMDVectorDouble rhs, Array<u64, 4>& outBits, i32& outFlags, i32& outError)noexcept{
#pragma STDC FENV_ACCESS ON
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    errno = E2BIG;
    const SIMDVectorDouble value = evaluator.evaluate(lhs, rhs);
    outFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    outError = errno;
    for(usize lane = 0u; lane < 4u; ++lane)
        outBits[lane] = VectorDoubleGetIntByIndex(value, lane);
    return true;
}

template<usize LanesPerIteration, typename DatasetT, typename ReduceFn>
FOUNDATION_NOINLINE SIMDVectorDouble ThroughputWorkload(const DatasetT& data, const usize dataCount, const usize iterations, ReduceFn&& reduce)noexcept{
    alignas(SIMDVectorDouble) Array<SIMDVectorDouble, 8> accumulators = {};
    for(usize lane = 0u; lane < 8u; ++lane)
        accumulators[lane] = VectorDoubleSet(0.125, 0.25, 0.5, 1.0);
    for(usize iteration = 0u; iteration < iterations; ++iteration){
#pragma clang loop unroll(full)
        for(usize lane = 0u; lane < LanesPerIteration; ++lane){
            const usize index = (iteration * LanesPerIteration + lane) % dataCount;
            accumulators[lane] = VectorDoubleAdd(accumulators[lane], reduce(LoadDouble(data.left[index]), LoadDouble(data.right[index])));
        }
    }
    SIMDVectorDouble result = accumulators[0];
    for(usize lane = 1u; lane < 8u; ++lane)
        result = VectorDoubleAdd(result, accumulators[lane]);
    return result;
}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_DataCount = 64u;
const u64 s_InitialSeed = 0x8923409102431291ull;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


interface IDoubleBinaryEvaluator{
    VectorDouble evaluate(in VectorDouble lhs, in VectorDouble rhs)const;
}

interface IAdditionalReductionCheck{
    b8 check(
        in VectorDouble lhs,
        in VectorDouble rhs,
        in Observation expected,
        in Observation actual,
        in usize index,
        mut u32 failures
    )const;
}

interface IRoundingModeVerifier{
    u32 verify(mut u64 seed)const;
}

interface IDoubleWorkloadRunner{
    VectorDouble run()const;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class Dataset{
    public Array<f64x4, s_DataCount> left;
    public Array<f64x4, s_DataCount> right;
    public Array<f64, s_DataCount> angles;
}

class Observation{
    public Array<u64, 4> bits;
    public i32 flags = 0;
    public i32 error = 0;
}

class NoAdditionalReductionCheck : IAdditionalReductionCheck{
    public b8 check(
        in VectorDouble lhs,
        in VectorDouble rhs,
        in Observation expected,
        in Observation actual,
        in usize index,
        mut u32 failures
    )const override{
        return true;
    }
}

class VerificationSweep{
    public u32 failures = 0u;
    public b8 environmentAvailable = false;
}

class MeasureOptions{
    public b8 candidate = false;
    public b8 latency = false;
    public usize iterations = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u64 NextSeed(mut u64 seed){
    seed ^= seed << 13u;
    seed ^= seed >> 7u;
    seed ^= seed << 17u;
    return seed;
}

void InitializeDataset(in u64 initialSeed, mut Dataset dataset){
    u64 seed = initialSeed;
    const VectorDouble step = VectorDouble(0x1p-10, 0x1p-10, 0x1p-10, 0x1p-10);
    const VectorDouble offset = VectorDouble(-4.0, -4.0, -4.0, -4.0);
    for(usize index = 0u; index < s_DataCount; ++index){
        // Keep the seed draw order: left and right per lane, then the angle.
        Array<f64, 4> leftSteps;
        Array<f64, 4> rightSteps;
        for(usize lane = 0u; lane < 4u; ++lane){
            leftSteps[lane] = cast<f64>(NextSeed(seed) % 8192u);
            rightSteps[lane] = cast<f64>(NextSeed(seed) % 64u + 1u);
        }
        const VectorDouble leftValues = VectorDouble(leftSteps[0], leftSteps[1], leftSteps[2], leftSteps[3]);
        const VectorDouble rightValues = VectorDouble(rightSteps[0], rightSteps[1], rightSteps[2], rightSteps[3]);
        dataset.left[index] = f64x4(leftValues * step + offset);
        dataset.right[index] = f64x4(rightValues * step);
        dataset.angles[index] = cast<f64>(NextSeed(seed) % 2048u + 1u) * 0x1p-10;
    }
}

b8 EqualBits(in VectorDouble lhs, in VectorDouble rhs){
    for(usize lane = 0u; lane < 4u; ++lane){
        if(SimdGetDoubleLaneBits(lhs, lane) != SimdGetDoubleLaneBits(rhs, lane))
            return false;
    }
    return true;
}

b8 EqualObservation(in Observation lhs, in Observation rhs){
    for(usize lane = 0u; lane < 4u; ++lane){
        if(lhs.bits[lane] != rhs.bits[lane])
            return false;
    }
    return lhs.flags == rhs.flags && lhs.error == rhs.error;
}

// The references use the same floating-point environment as the candidates.
VectorDouble BaselineDot2(in VectorDouble lhs, in VectorDouble rhs){
    return SimdBaselineDot2(lhs, rhs);
}

VectorDouble BaselineDot3(in VectorDouble lhs, in VectorDouble rhs){
    return SimdBaselineDot3(lhs, rhs);
}

VectorDouble BaselineDot4(in VectorDouble lhs, in VectorDouble rhs){
    return SimdBaselineDot4(lhs, rhs);
}

VectorDouble BaselineSum(in VectorDouble value){
    return SimdBaselineSum(value);
}

Expected<Observation> ObserveBinary<EvalT : IDoubleBinaryEvaluator>(
    in EvalT evaluator,
    in VectorDouble lhs,
    in VectorDouble rhs
){
    Observation observation = Observation();
    if(!ObserveBinaryEvaluation(evaluator, lhs, rhs, observation.bits, observation.flags, observation.error))
        return MakeUnexpected(Failure());
    return observation;
}

u32 VerifyReductionCases<
    BaselineT : IDoubleBinaryEvaluator,
    CandidateT : IDoubleBinaryEvaluator,
    AdditionalT : IAdditionalReductionCheck
>(
    in StringView operation,
    in BaselineT baseline,
    in CandidateT candidate,
    in AdditionalT additional,
    mut u64 seed
){
    Array<u64, 14> exceptional;
    exceptional[0] = 0u;
    exceptional[1] = 0x8000000000000000ull;
    exceptional[2] = 1u;
    exceptional[3] = 0x8000000000000001ull;
    exceptional[4] = 0x0010000000000000ull;
    exceptional[5] = 0x3ff0000000000000ull;
    exceptional[6] = 0xbff0000000000000ull;
    exceptional[7] = 0x7fefffffffffffffull;
    exceptional[8] = 0x7ff0000000000000ull;
    exceptional[9] = 0xfff0000000000000ull;
    exceptional[10] = 0x7ff8000000000123ull;
    exceptional[11] = 0xfff8000000000124ull;
    exceptional[12] = 0x7ff0000000000125ull;
    exceptional[13] = 0xfff0000000000126ull;

    u32 failures = 0u;
    for(usize index = 0u; index < 16384u; ++index){
        Array<u64, 8> bits;
        for(usize word = 0u; word < bits.size(); ++word){
            const u64 random = NextSeed(seed);
            if(index < 8192u)
                bits[word] = exceptional[cast<usize>(random % cast<u64>(exceptional.size()))];
            else
                bits[word] = random;
        }
        const VectorDouble lhs = VectorDouble(u64x4(bits[0], bits[1], bits[2], bits[3]));
        const VectorDouble rhs = VectorDouble(u64x4(bits[4], bits[5], bits[6], bits[7]));
        const Expected<Observation> expected = ObserveBinary(baseline, lhs, rhs);
        if(!expected.has_value())
            return failures + 1u;
        const Expected<Observation> actual = ObserveBinary(candidate, lhs, rhs);
        if(!actual.has_value())
            return failures + 1u;
        if(!additional.check(lhs, rhs, expected.value(), actual.value(), index, failures))
            return failures + 1u;
        if(!EqualObservation(expected.value(), actual.value())){
            ++failures;
            if(failures <= 3u){
                WriteBenchmarkStdout(StringFormat(
                    "reduction mismatch operation={} case={} flags={}/{} errno={}/{}\n",
                    operation,
                    index,
                    expected.value().flags,
                    actual.value().flags,
                    expected.value().error,
                    actual.value().error
                ));
            }
        }
    }
    return failures;
}

VerificationSweep VerifyRoundingModes<VerifyT : IRoundingModeVerifier>(in VerifyT verifier){
    VerificationSweep sweep = VerificationSweep();
    const Expected<FloatingPointEnvironment> environment = HoldFloatingPointExceptions();
    if(!environment.has_value()){
        sweep.failures = 1u;
        sweep.environmentAvailable = false;
        return sweep;
    }

    FloatingPointEnvironmentGuard restoreEnvironment = FloatingPointEnvironmentGuard(environment.value());
    u64 seed = s_InitialSeed;
    u32 failures = 0u;
    for(usize modeIndex = 0u; modeIndex < 4u; ++modeIndex){
        if(!SetFloatingPointRoundingMode(SimdRoundingModeByIndex(modeIndex)).has_value()){
            ++failures;
            break;
        }
        failures += verifier.verify(seed);
    }
    if(!SetFloatingPointEnvironment(environment.value()).has_value())
        ++failures;
    restoreEnvironment.release();
    sweep.failures = failures;
    sweep.environmentAvailable = true;
    return sweep;
}

void MeasureWorkload<WorkloadT : IDoubleWorkloadRunner>(
    in StringView operation,
    in b8 candidate,
    in b8 latency,
    in usize operations,
    in WorkloadT workload
){
    const Timer start = TimerNow();
    const VectorDouble result = workload.run();
    const f64 nanoseconds = DurationInNS<f64>(TimerNow(), start);
    u64 checksum = 0u;
    for(usize lane = 0u; lane < 4u; ++lane)
        checksum ^= SimdGetDoubleLaneBits(result, lane) + cast<u64>(lane);
    StringView variantLabel = "baseline";
    if(candidate)
        variantLabel = "candidate";
    StringView workloadLabel = "throughput";
    if(latency)
        workloadLabel = "latency";
    const f64 nsPerOp = nanoseconds / cast<f64>(operations);
    WriteBenchmarkStdout(StringFormat(
        "{{\"operation\":\"{}\",\"variant\":\"{}\",\"workload\":\"{}\",\"operations\":{},\"nanoseconds\":{:.17g},\"ns_per_operation\":{:.17g},\"checksum\":\"{}\"}}\n",
        operation,
        variantLabel,
        workloadLabel,
        operations,
        nanoseconds,
        nsPerOp,
        checksum
    ));
}

void SelectVariant<
    CandidateWorkloadT : IDoubleWorkloadRunner,
    BaselineWorkloadT : IDoubleWorkloadRunner
>(
    in StringView operation,
    in b8 candidate,
    in b8 latency,
    in usize operations,
    in CandidateWorkloadT candidateWorkload,
    in BaselineWorkloadT baselineWorkload
){
    if(candidate)
        MeasureWorkload(operation, true, latency, operations, candidateWorkload);
    else
        MeasureWorkload(operation, false, latency, operations, baselineWorkload);
}

Expected<MeasureOptions> ParseMeasureOptions(
    in StringView variantArg,
    in StringView iterationsArg,
    in StringView workloadArg,
    in usize maximumIterations,
    in b8 allowLatency
){
    const b8 candidate = variantArg == "candidate";
    if(!candidate && variantArg != "baseline")
        return MakeUnexpected(Failure());
    const b8 latency = workloadArg == "latency";
    if((latency && !allowLatency) || (!latency && workloadArg != "throughput"))
        return MakeUnexpected(Failure());

    const Expected<u64> parsedIterations = ParseU64(iterationsArg);
    if(!parsedIterations.has_value() || parsedIterations.value() == 0u || parsedIterations.value() > cast<u64>(maximumIterations))
        return MakeUnexpected(Failure());

    MeasureOptions options = MeasureOptions();
    options.candidate = candidate;
    options.latency = latency;
    options.iterations = cast<usize>(parsedIterations.value());
    return options;
}


