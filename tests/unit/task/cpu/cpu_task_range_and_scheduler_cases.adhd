#include <tests/common/gtest_macros.adhd>
#include <tests/unit/task/cpu/suite.adhd>

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

native{
namespace __hidden_cpu_task_range_tests{

using namespace NWB::Core;
using CpuTaskSchedulerTestSupport::HomogeneousWorkers;
using CpuTaskSchedulerTestSupport::s_CompletionTimeoutMS;
using CpuTaskSchedulerTestSupport::s_PollIntervalMS;

inline void PumpUntil(CpuTaskScheduler& scheduler, const Atomic<b8>& done){
    const Timer start = TimerNow();
    while(!done.load(MemoryOrder::acquire)){
        if(DurationInMS<u64>(TimerNow(), start) > s_CompletionTimeoutMS)
            TerminateInvariant();
        scheduler.pumpMainThread();
        SleepMS(s_PollIntervalMS);
    }
}

};

namespace __hidden_cpu_task_submission_tests{

using namespace NWB::Core;
using CpuTaskSchedulerTestSupport::DeadlineGuard;
using CpuTaskSchedulerTestSupport::ExitTestProcess;

inline constexpr u32 s_ConstructionException = 0xE101u;
inline constexpr u32 s_WorkerException = 0xE102u;

struct ThrowingMoveTask{
    ThrowingMoveTask()noexcept = default;
    ThrowingMoveTask(ThrowingMoveTask&&){ throw s_ConstructionException; }


public:
    void operator()()const noexcept{}
};

struct ThrowingCopyTask{
    ThrowingCopyTask()noexcept = default;
    ThrowingCopyTask(const ThrowingCopyTask&){ throw s_ConstructionException; }
    ThrowingCopyTask(ThrowingCopyTask&&)noexcept = default;


public:
    void operator()()const noexcept{}
};

struct NonCallableTask{};

static_assert(!IsConstructible_V<InplaceFunction<128u>, ThrowingMoveTask>);
static_assert(!IsConstructible_V<InplaceFunction<128u>, NonCallableTask>);

};

namespace __hidden_cpu_task_wait_tests{

using namespace NWB::Core;
using CpuTaskSchedulerTestSupport::DeadlineGuard;
using CpuTaskSchedulerTestSupport::s_PollIntervalMS;

inline constexpr u32 s_WatchdogTimeoutMS = 10000u;

};

namespace NWB::Tests::CpuTaskSuite{
using CpuTaskAdmissionErrorEnum = NWB::Core::CpuTaskAdmissionError::Enum;
using CpuAffinityEnum = ::CpuAffinity::Enum;
}
}

