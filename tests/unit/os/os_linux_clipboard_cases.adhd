NWB_ADHD_GTEST(ClipboardPipe, PartialUnicodeStaysPendingUntilValidEof, VerifyClipboardPipe_PartialUnicodeStaysPendingUntilValidEof)
NWB_ADHD_GTEST(ClipboardPipe, TruncatedUnicodeIsRejectedAtEof, VerifyClipboardPipe_TruncatedUnicodeIsRejectedAtEof)
NWB_ADHD_GTEST(ClipboardPipe, WriterOwnsLargeInputAndResumesAfterFullPipe, VerifyClipboardPipe_WriterOwnsLargeInputAndResumesAfterFullPipe)
NWB_ADHD_GTEST(ClipboardPipe, ClosedReaderFailsWithoutSigpipeOrChangingThreadMask, VerifyClipboardPipe_ClosedReaderFailsWithoutSigpipeOrChangingThreadMask)
NWB_ADHD_GTEST(ClipboardPipe, WriterCanBeReusedForEmptyAndShorterTransfers, VerifyClipboardPipe_WriterCanBeReusedForEmptyAndShorterTransfers)
NWB_ADHD_GTEST_F(X11ClipboardFixture, PropertyAbsenceAndRetiredWindowPreserveDifferentNativeResults, VerifyX11ClipboardFixture_PropertyAbsenceAndRetiredWindowPreserveDifferentNativeResults)
NWB_ADHD_GTEST_F(X11ClipboardFixture, WritingPrimarySelectionDoesNotOverwriteClipboardUtf8, VerifyX11ClipboardFixture_WritingPrimarySelectionDoesNotOverwriteClipboardUtf8)
NWB_ADHD_GTEST_F(X11ClipboardFixture, IncrementalReadRetainsSnapshotAfterOwnerLosesSelection, VerifyX11ClipboardFixture_IncrementalReadRetainsSnapshotAfterOwnerLosesSelection)
NWB_ADHD_GTEST_F(X11ClipboardFixture, CancelledRequestWindowCannotCompleteFreshRequest, VerifyX11ClipboardFixture_CancelledRequestWindowCannotCompleteFreshRequest)
NWB_ADHD_GTEST_F(X11ClipboardFixture, QueuedOwnershipLossCannotClearNewlyReacquiredText, VerifyX11ClipboardFixture_QueuedOwnershipLossCannotClearNewlyReacquiredText)


