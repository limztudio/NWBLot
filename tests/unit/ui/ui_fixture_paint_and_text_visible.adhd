////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ExpectClippedPaintTextQuad(in DrawSnapshot snapshot){
    ASSERT_EQ(snapshot.vertices().size(), 4u);
    const Vertex first = snapshot.vertices()[0u];
    const Vertex opposite = snapshot.vertices()[2u];
    EXPECT_FLOAT_EQ(first.position.x, 10.0f);
    EXPECT_FLOAT_EQ(first.position.y, 5.0f);
    EXPECT_FLOAT_EQ(opposite.position.x, 30.0f);
    EXPECT_FLOAT_EQ(opposite.position.y, 15.0f);
    EXPECT_FLOAT_EQ(first.texCoord.x, 0.25f);
    EXPECT_FLOAT_EQ(first.texCoord.y, 0.375f);
    EXPECT_FLOAT_EQ(opposite.texCoord.x, 0.5f);
    EXPECT_FLOAT_EQ(opposite.texCoord.y, 0.625f);
}

Rect ComputePlacedGlyphOutlineRect(in PlacedGlyph glyph, in Point origin){
    Rect rect = Rect();
    rect.x = origin.x + glyph.position.x + glyph.ink.x;
    rect.y = origin.y + glyph.position.y + glyph.ink.y;
    rect.width = glyph.ink.width;
    rect.height = glyph.ink.height;
    return rect;
}

void ExpectUiSameImagePaintSnapshots(in DrawSnapshot actual, in DrawSnapshot expected){
    ExpectUiSameSnapshotHeader(actual, expected);
    ASSERT_EQ(actual.textureImages().size(), expected.textureImages().size());
    for(usize index = 0u; index < actual.textureImages().size(); ++index){
        const SharedImageSource actualSource = actual.textureImages()[index];
        const SharedImageSource expectedSource = expected.textureImages()[index];
        ASSERT_TRUE(cast<b8>(actualSource));
        ASSERT_TRUE(cast<b8>(expectedSource));
        EXPECT_EQ(actualSource, expectedSource);
        EXPECT_EQ(ImageSourceIdentity(actualSource), ImageSourceIdentity(expectedSource));
        EXPECT_EQ(ImageSourceGeneration(actualSource), ImageSourceGeneration(expectedSource));
        EXPECT_EQ(ImageSourceTexture(actualSource).virtualPath(), ImageSourceTexture(expectedSource).virtualPath());
        EXPECT_EQ(ImageSourceTexture(actualSource).width(), ImageSourceTexture(expectedSource).width());
        EXPECT_EQ(ImageSourceTexture(actualSource).height(), ImageSourceTexture(expectedSource).height());
        EXPECT_EQ(ImageSourceTexture(actualSource).dimension(), ImageSourceTexture(expectedSource).dimension());
        EXPECT_EQ(ImageSourceTexture(actualSource).depth(), ImageSourceTexture(expectedSource).depth());
        EXPECT_EQ(ImageSourceTexture(actualSource).payloadFormat(), ImageSourceTexture(expectedSource).payloadFormat());
        EXPECT_EQ(ImageSourceTexture(actualSource).alphaMode(), ImageSourceTexture(expectedSource).alphaMode());
        EXPECT_EQ(ImageSourceTexture(actualSource).alphaConstantUnorm8(), ImageSourceTexture(expectedSource).alphaConstantUnorm8());
        EXPECT_EQ(ImageSourceTexture(actualSource).payloadBytes(), ImageSourceTexture(expectedSource).payloadBytes());
        ASSERT_EQ(ImageSourceTexture(actualSource).mipLevels().size(), ImageSourceTexture(expectedSource).mipLevels().size());
        for(usize mipIndex = 0u; mipIndex < ImageSourceTexture(actualSource).mipLevels().size(); ++mipIndex){
            const TextureMipLevel am = ImageSourceTexture(actualSource).mipLevels()[mipIndex];
            const TextureMipLevel em = ImageSourceTexture(expectedSource).mipLevels()[mipIndex];
            EXPECT_EQ(am.width, em.width);
            EXPECT_EQ(am.height, em.height);
            EXPECT_EQ(am.blockCountX, em.blockCountX);
            EXPECT_EQ(am.blockCountY, em.blockCountY);
            EXPECT_EQ(am.offsetBytes, em.offsetBytes);
            EXPECT_EQ(am.sizeBytes, em.sizeBytes);
            EXPECT_EQ(am.sliceCount, em.sliceCount);
        }
    }
    ExpectUiSamePaintSnapshots(actual, expected);
}

void BeginPaintImageFixture(in PaintImageFixture self, mut PaintBuilder builder, in u64 generation){
    builder.begin(DisplayMetrics(200.0f, 100.0f, 1.25f, 1.5f), generation, 3u, MakeUiSkinAssetRef(s_TestSkinPath), self.m_skin);
    builder.reserve(16u);
}

void BeginPaintTextFixture(mut PaintTextFixture self, in u64 generation){
    self.m_builder.begin(DisplayMetrics(100.0f, 80.0f, 1.5f, 2.0f), generation, 3u, MakeUiSkinAssetRef(s_PaintTextSkinPath), self.m_skin);
    self.m_builder.reserve(16u);
}

void BeginTextVisibleFixturePaint(mut TextVisibleFixture self, in u64 generation, in DisplayMetrics display){
    self.m_paint.begin(display, generation, 1u, MakeUiSkinAssetRef(s_TestSkinPath), self.m_skin);
}


