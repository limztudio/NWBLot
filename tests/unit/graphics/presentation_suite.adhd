[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace Tests::GraphicsPresentationDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_presentation_coop_vector_query{

static u32 s_EmptyPropertyQueryCalls = 0u;

static VkResult VKAPI_CALL QueryNoCooperativeVectorProperties(VkPhysicalDevice, uint32_t* const count, VkCooperativeVectorPropertiesNV* const properties){
    ++s_EmptyPropertyQueryCalls;
    EXPECT_EQ(properties, nullptr);
    *count = 0u;
    return VK_SUCCESS;
}

};

CooperativeVectorQueryHarness::CooperativeVectorQueryHarness()noexcept{
    context.extensions.nvCooperativeVector = true;
    context.coopVecFeatures.cooperativeVector = VK_TRUE;
    context.coopVecFeatures.cooperativeVectorTraining = VK_TRUE;
    context.coopVecProperties.cooperativeVectorTrainingFloat16Accumulation = VK_TRUE;
    context.instanceDispatch.vkGetPhysicalDeviceCooperativeVectorPropertiesNV = &__hidden_presentation_coop_vector_query::QueryNoCooperativeVectorProperties;
    __hidden_presentation_coop_vector_query::s_EmptyPropertyQueryCalls = 0u;
}

Expected<Core::CooperativeVectorDeviceFeatures> CooperativeVectorQueryHarness::queryEmptyDriverList(){
    return Core::GraphicsBackend::CooperativeVectorFeatureQuery::Query(context, scheduler);
}

u32 CooperativeVectorQueryHarness::callCount()const noexcept{
    return __hidden_presentation_coop_vector_query::s_EmptyPropertyQueryCalls;
}

VkQueue MakeDummyVkQueue(const usize handleValue)noexcept{
    return reinterpret_cast<VkQueue>(handleValue);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


