#include "paint_emission.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void EmitPaintNineSlice(
    in b8 recording,
    in Rect clip,
    in UiSkinRegion region,
    in Rect rectangle,
    in Color tint,
    in u32 atlasWidth,
    in u32 atlasHeight,
    in f32 referenceDensity,
    in u32 layer,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered
){
    if(!HasUiRectArea(rectangle))
        return;
    VectorSingle xVec(0.0f);
    VectorSingle yVec(0.0f);
    VectorSingle uVec(0.0f);
    VectorSingle vVec(0.0f);
    ResolveNineSliceCoordinates(region.rectangle, region.sliceInsets, rectangle, referenceDensity, xVec, yVec, uVec, vVec);
    Array<f32, 4u> x;
    x[0u] = xVec.x;
    x[1u] = xVec.y;
    x[2u] = xVec.z;
    x[3u] = xVec.w;
    Array<f32, 4u> y;
    y[0u] = yVec.x;
    y[1u] = yVec.y;
    y[2u] = yVec.z;
    y[3u] = yVec.w;
    Array<f32, 4u> u;
    u[0u] = uVec.x;
    u[1u] = uVec.y;
    u[2u] = uVec.z;
    u[3u] = uVec.w;
    Array<f32, 4u> v;
    v[0u] = vVec.x;
    v[1u] = vVec.y;
    v[2u] = vVec.z;
    v[3u] = vVec.w;
    const f32 width = cast<f32>(atlasWidth);
    const f32 height = cast<f32>(atlasHeight);
    for(u32 row = 0u; row < s_PaintNineSliceAxisCells; ++row){
        for(u32 column = 0u; column < s_PaintNineSliceAxisCells; ++column){
            const Rect target(x[cast<usize>(column)], y[cast<usize>(row)], x[cast<usize>(column + 1u)] - x[cast<usize>(column)], y[cast<usize>(row + 1u)] - y[cast<usize>(row)]);
            const Rect uv(u[cast<usize>(column)] / width, v[cast<usize>(row)] / height, (u[cast<usize>(column + 1u)] - u[cast<usize>(column)]) / width, (v[cast<usize>(row + 1u)] - v[cast<usize>(row)]) / height);
            EmitPaintQuad(
                recording,
                clip,
                target,
                uv,
                tint,
                PaintMaterial::Skin,
                layer,
                u32.max,
                u32.max,
                0u,
                u32.max,
                vertices,
                indices,
                commands,
                inOutCommandsOrdered
            );
        }
    }
}

b8 DrawPaintSkinRegion(
    in b8 recording,
    in Rect clip,
    in Span<UiSkinRegion> regions,
    in Name regionName,
    in Rect rectangle,
    in Color tint,
    in u32 atlasWidth,
    in u32 atlasHeight,
    in f32 referenceDensity,
    in u32 layer,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered
){
    assert(recording);
    for(in UiSkinRegion region : regions){
        if(region.name != regionName)
            continue;
        if(region.drawMode == UiSkinDrawMode::NineSlice){
            EmitPaintNineSlice(
                recording,
                clip,
                region,
                rectangle,
                tint,
                atlasWidth,
                atlasHeight,
                referenceDensity,
                layer,
                vertices,
                indices,
                commands,
                inOutCommandsOrdered
            );
        }
        else{
            const Rect uv = ResolveSkinRegionUv(region.rectangle, atlasWidth, atlasHeight);
            EmitPaintQuad(
                recording,
                clip,
                rectangle,
                uv,
                tint,
                PaintMaterial::Skin,
                layer,
                u32.max,
                u32.max,
                0u,
                u32.max,
                vertices,
                indices,
                commands,
                inOutCommandsOrdered
            );
        }
        return true;
    }
    return false;
}

b8 IsPaintDrawCommandBefore(in DrawCommand lhs, in DrawCommand rhs){
    if(lhs.layer != rhs.layer)
        return lhs.layer < rhs.layer;
    return lhs.firstIndex < rhs.firstIndex;
}

b8 IsValidPaintImageDrawRequest(in Rect rectangle, in Rect uv, in Color tint){
    return IsValidUiRect(rectangle)
        && IsValidPaintUvRect(uv)
        && IsValidPaintColor(tint);
}

b8 IsPaintImageInvisible(in Rect rectangle, in Rect clip, in Color tint){
    return !HasUiRectArea(rectangle)
        || !HasUiRectArea(clip)
        || tint.a == 0.0f
        || !HasVisibleUiRectIntersection(rectangle, clip);
}

void BeginPaintBuilderRecording(
    in DisplayMetrics metrics,
    in Span<UiSkinRegion> skinRegions,
    mut Vector<Vertex> outVertices,
    mut Vector<u32> outIndices,
    mut Vector<DrawCommand> outCommands,
    mut Vector<UiSkinRegion> outRegions,
    mut Vector<Rect> outClips,
    mut usize outOverlayDepth,
    mut u32 outLayer,
    mut b8 outCommandsOrdered,
    mut b8 outRecording
){
    assert(isFinite(metrics.logicalWidth) && metrics.logicalWidth >= 0.0f);
    assert(isFinite(metrics.logicalHeight) && metrics.logicalHeight >= 0.0f);
    assert(isFinite(metrics.pixelScaleX) && metrics.pixelScaleX > 0.0f);
    assert(isFinite(metrics.pixelScaleY) && metrics.pixelScaleY > 0.0f);
    outVertices.clear();
    outIndices.clear();
    outCommands.clear();
    outRegions.clear();
    outRegions.reserve(skinRegions.size());
    for(in UiSkinRegion region : skinRegions)
        outRegions.push_back(region);
    outClips.clear();
    outClips.push_back(Rect(0.0f, 0.0f, metrics.logicalWidth, metrics.logicalHeight));
    outOverlayDepth = 0u;
    outLayer = 0u;
    outCommandsOrdered = true;
    outRecording = true;
}

void FinalizePaintBuilderRecording(
    in b8 commandsOrdered,
    in usize overlayDepth,
    mut Vector<DrawCommand> inOutCommands,
    mut Vector<Rect> inOutClips,
    mut b8 inOutRecording
){
    assert(inOutRecording && inOutClips.size() == 1u && overlayDepth == 0u);
    native(in overlayDepth){
        static_cast<void>(overlayDepth);
    }
    if(!commandsOrdered){
        native(mut inOutCommands){
            ::Sort(inOutCommands.begin(), inOutCommands.end(), IsPaintDrawCommandBefore);
        }
    }
    inOutRecording = false;
    inOutClips.clear();
}


