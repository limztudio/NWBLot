    EXPECT_EQ(self.m_context.input().layoutGeneration(), accepted);
    EXPECT_EQ(self.m_context.input().targets().size(), targets);
}

void VerifyUiEditActionHostTests_HostResetReentryRejectsBeforeDestroyingBorrowedEntryStorage(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
