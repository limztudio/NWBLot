namespace __hidden_ui_glyph_sdf_tests{
using UiContextMenuInputTests = __hidden_ui_context_menu_input_tests::UiContextMenuInputTests;
using UiContextTests = __hidden_ui_context_tests::UiContextTests;

using ContextMenuAction = ::NWB::Impl::Ui::ContextMenuAction;
using ControlToken = ::NWB::Impl::Ui::ControlToken;
using InputActionId = ::NWB::Impl::Ui::InputActionId;
using InputEvent = ::NWB::Impl::Ui::InputEvent;
using InputRoutingResult = ::NWB::Impl::Ui::InputRoutingResult;
using PopupScope = ::NWB::Impl::Ui::PopupScope;
using PopupToken = ::NWB::Impl::Ui::PopupToken;
using WidgetState = ::NWB::Impl::Ui::WidgetState;

namespace InputActionSource = ::NWB::Impl::Ui::InputActionSource;
namespace InputEventType = ::NWB::Impl::Ui::InputEventType;
using InputEventTypeEnum = ::NWB::Impl::Ui::InputEventType::Enum;
namespace PopupDismissReason = ::NWB::Impl::Ui::PopupDismissReason;
using PopupDismissReasonEnum = ::NWB::Impl::Ui::PopupDismissReason::Enum;
namespace WidgetKind = ::NWB::Impl::Ui::WidgetKind;
namespace CoreKey = ::NWB::Core::Key;
using CoreKeyEnum = ::NWB::Core::Key::Enum;

using ::NWB::Impl::Ui::s_InputMaxContextMenuActions;
using ::NWB::Impl::Ui::s_WidgetMaxStates;

[[nodiscard]] inline f32 UiContextMenuInfinityF32()noexcept{ return ::Limit<f32>::s_Infinity; }
[[nodiscard]] inline f32 UiContextMenuQuietNaNF32()noexcept{ return ::Limit<f32>::s_QuietNaN; }
[[nodiscard]] inline CoreKeyEnum MakeUiContextMenuOutOfBoundsKey()noexcept{
    return static_cast<CoreKeyEnum>(static_cast<i32>(::NWB::Core::Key::Menu) + 1);
}
[[nodiscard]] inline InputEvent MakeUiContextMenuPointer(const InputEventTypeEnum type, const Point position = { 15.0f, 15.0f })noexcept{
    return ::UiTestSupport::Pointer(type, position);
}
[[nodiscard]] inline InputEvent MakeUiContextMenuKey(const CoreKeyEnum key, const b8 shift = false, const b8 control = false, const b8 alt = false, const b8 repeat = false)noexcept{
    return ::UiTestSupport::Key(key, shift, control, alt, repeat);
}
[[nodiscard]] inline AStringView MakeUiWidgetIdEmbeddedNulKey()noexcept{
    return AStringView("a\0b", 3u);
}
};


