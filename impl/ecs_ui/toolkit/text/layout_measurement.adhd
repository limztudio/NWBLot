#include <impl/ecs_ui/toolkit/text/sdf_support.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ResolveNextTextLineRange(
    in StringView text,
    in usize byteBegin,
    mut usize outByteEnd,
    mut usize outBreakEnd
){
    usize byteEnd = byteBegin;
    while(byteEnd < text.size() && text[byteEnd] != '\r' && text[byteEnd] != '\n')
        ++byteEnd;
    usize breakEnd = byteEnd;
    if(breakEnd < text.size()){
        if(text[breakEnd] == '\r')
            breakEnd += s_TextCarriageReturnLineFeedBytes;
        else
            breakEnd += 1u;
    }
    outByteEnd = byteEnd;
    outBreakEnd = breakEnd;
}

Expected<TextLine> TryBuildInitialTextLine(
    in usize byteBegin,
    in usize byteEnd,
    in usize breakEnd,
    in usize firstGlyph,
    in usize glyphCount,
    in usize firstCluster,
    in f32 top,
    in FontMetrics metrics
){
    const VectorDouble sums = VectorDouble(cast<f64>(top), cast<f64>(metrics.ascender), 0.0, 0.0) + VectorDouble(cast<f64>(metrics.ascender), cast<f64>(metrics.descender), 0.0, 0.0);
    const f64 baseline = sums.x;
    const f64 height = sums.y + cast<f64>(metrics.lineGap);
    if(!FitsTextCoordinate(baseline) || !FitsTextCoordinate(cast<f64>(top) + height))
        return MakeUnexpected(Failure());
    TextLine line;
    line.byteBegin = cast<u32>(byteBegin);
    line.byteEnd = cast<u32>(byteEnd);
    line.breakEnd = cast<u32>(breakEnd);
    line.firstGlyph = cast<u32>(firstGlyph);
    line.glyphCount = cast<u32>(glyphCount);
    line.firstCluster = cast<u32>(firstCluster);
    line.top = top;
    line.baseline = cast<f32>(baseline);
    line.height = cast<f32>(height);
    return line;
}

Expected<Point> TryAdvanceTextGlyphPosition(
    in f32 baseline,
    in Point offset,
    in Point advance,
    in Rect ink,
    in GlyphCoverageBounds coverage,
    mut f32 inOutPen,
    mut VectorDouble inOutInkBounds,
    mut b8 inOutHasInk
){
    const VectorDouble advanced = VectorDouble(cast<f64>(inOutPen), cast<f64>(baseline), cast<f64>(inOutPen), 0.0) + VectorDouble(cast<f64>(offset.x), cast<f64>(offset.y), cast<f64>(advance.x), 0.0);
    if(!FitsTextCoordinate(advanced.x) || !FitsTextCoordinate(advanced.y) || !FitsTextCoordinate(advanced.z))
        return MakeUnexpected(Failure());
    const Point position(cast<f32>(advanced.x), cast<f32>(advanced.y));
    const Expected<VectorDouble> translatedInk = TryTranslateTextInk(position, ink);
    if(!translatedInk.has_value() || !TryIncludeTextInk(translatedInk.value(), inOutInkBounds, inOutHasInk))
        return MakeUnexpected(Failure());
    if(coverage.known && !TryTranslateTextInk(position, coverage.ink).has_value())
        return MakeUnexpected(Failure());
    inOutPen = cast<f32>(advanced.z);
    return position;
}

TextCluster MakeTextCluster(
    in u32 lineByteBegin,
    in u32 glyphByteBegin,
    in u32 glyphByteEnd,
    in u32 firstGlyph,
    in u32 glyphCount,
    in u32 lineIndex,
    in TextDirection direction,
    in f32 clusterLeft,
    in f32 pen
){
    TextCluster cluster;
    cluster.byteBegin = lineByteBegin + glyphByteBegin;
    cluster.byteEnd = lineByteBegin + glyphByteEnd;
    cluster.firstGlyph = firstGlyph;
    cluster.glyphCount = glyphCount;
    cluster.lineIndex = lineIndex;
    if(direction == TextDirection::LeftToRight){
        cluster.leadingX = clusterLeft;
        cluster.trailingX = pen;
    }
    else{
        cluster.leadingX = pen;
        cluster.trailingX = clusterLeft;
    }
    return cluster;
}

VectorDouble ComputeInitialMeasuredTextBounds(in Point logical, in Rect ink){
    const VectorDouble inkOrigin(cast<f64>(ink.x), cast<f64>(ink.y), cast<f64>(ink.x), cast<f64>(ink.y));
    const VectorDouble inkEnd = inkOrigin + VectorDouble(cast<f64>(ink.width), cast<f64>(ink.height), cast<f64>(ink.width), cast<f64>(ink.height));
    const VectorDouble minXY = Min(VectorDouble(0.0, 0.0, 0.0, 0.0), inkOrigin);
    const VectorDouble maxXY = Max(VectorDouble(cast<f64>(logical.x), cast<f64>(logical.y), cast<f64>(logical.x), cast<f64>(logical.y)), inkEnd);
    return VectorDouble(minXY.x, minXY.y, maxXY.x, maxXY.y);
}

void ExpandMeasuredTextBoundsWithSdfSupport(in VectorDouble support, mut VectorDouble inOutBounds){
    if(support.z <= 0.0 || support.w <= 0.0)
        return;
    const VectorDouble first(support.x, support.y, support.x, support.y);
    const VectorDouble last = first + VectorDouble(support.z, support.w, support.z, support.w);
    const VectorDouble minXY = Min(VectorDouble(inOutBounds.x, inOutBounds.y, inOutBounds.x, inOutBounds.y), first);
    const VectorDouble maxXY = Max(VectorDouble(inOutBounds.z, inOutBounds.w, inOutBounds.z, inOutBounds.w), last);
    inOutBounds = VectorDouble(minXY.x, minXY.y, maxXY.x, maxXY.y);
}

void ExpandMeasuredTextBoundsWithRaster(
    in Point glyphPosition,
    in Rect raster,
    in f32 rasterScale,
    in DisplayMetrics display,
    mut VectorDouble inOutBounds
){
    if(raster.width <= 0.0f || raster.height <= 0.0f)
        return;
    const VectorDouble scaleVec(cast<f64>(rasterScale));
    const VectorDouble origin(cast<f64>(glyphPosition.x), cast<f64>(glyphPosition.y), cast<f64>(glyphPosition.x), cast<f64>(glyphPosition.y));
    const VectorDouble pixelOrigin(cast<f64>(raster.x), cast<f64>(raster.y), cast<f64>(raster.x), cast<f64>(raster.y));
    const VectorDouble pixelEnd = pixelOrigin + VectorDouble(cast<f64>(raster.width), cast<f64>(raster.height), cast<f64>(raster.width), cast<f64>(raster.height));
    // CoverageRectangle snaps the bitmap origin to the nearest physical pixel; every translation phase differs by at most half a pixel on each axis.
    const VectorDouble snap = VectorDouble(s_TextHalfPixel) / VectorDouble(cast<f64>(display.pixelScaleX), cast<f64>(display.pixelScaleY), cast<f64>(display.pixelScaleX), cast<f64>(display.pixelScaleY));
    const VectorDouble first = (origin + (pixelOrigin / scaleVec)) - snap;
    const VectorDouble last = (origin + (pixelEnd / scaleVec)) + snap;
    const VectorDouble minXY = Min(VectorDouble(inOutBounds.x, inOutBounds.y, inOutBounds.x, inOutBounds.y), first);
    const VectorDouble maxXY = Max(VectorDouble(inOutBounds.z, inOutBounds.w, inOutBounds.z, inOutBounds.w), last);
    inOutBounds = VectorDouble(minXY.x, minXY.y, maxXY.x, maxXY.y);
}

TextLayoutStatus PlaceShapedLineInto<TFace>(
    in usize byteBegin,
    in usize byteEnd,
    in usize breakEnd,
    in FontMetrics runMetrics,
    in Span<ShapedGlyphRecord<TFace>> runGlyphs,
    in StringView lineText,
    in TextDirection direction,
    mut Vector<PlacedGlyphRecord<TFace>> inOutGlyphs,
    mut Vector<TextCluster> inOutClusters,
    mut Vector<TextLine> inOutLines,
    mut Point inOutMeasure,
    mut VectorDouble inOutInkBounds,
    mut b8 inOutHasInk
){
    if(!ValidateShapedRun(runMetrics, runGlyphs, lineText, direction))
        return TextLayoutStatus::FontFailure;
    const Expected<TextLine> lineResult = TryBuildInitialTextLine(
        byteBegin,
        byteEnd,
        breakEnd,
        inOutGlyphs.size(),
        runGlyphs.size(),
        inOutClusters.size(),
        inOutMeasure.y,
        runMetrics
    );
    if(!lineResult.has_value())
        return TextLayoutStatus::InvalidParameters;
    TextLine line = lineResult.value();
    usize first = 0u;
    f32 pen = 0.0f;
    while(first < runGlyphs.size()){
        usize end = first + 1u;
        while(end < runGlyphs.size() && runGlyphs[end].byteBegin == runGlyphs[first].byteBegin)
            ++end;
        const f32 clusterLeft = pen;
        const u32 firstGlyph = cast<u32>(inOutGlyphs.size());
        for(usize index = first; index < end; ++index){
            const ShapedGlyphRecord<TFace> glyph = runGlyphs[index];
            const Expected<Point> position = TryAdvanceTextGlyphPosition(
                line.baseline,
                glyph.offset,
                glyph.advance,
                glyph.ink,
                glyph.coverage,
                pen,
                inOutInkBounds,
                inOutHasInk
            );
            if(!position.has_value())
                return TextLayoutStatus::InvalidParameters;
            PlacedGlyphRecord<TFace> placed;
            placed.face = glyph.face;
            placed.glyphId = glyph.glyphId;
            placed.byteBegin = line.byteBegin + glyph.byteBegin;
            placed.byteEnd = line.byteBegin + glyph.byteEnd;
            placed.position = position.value();
            placed.ink = glyph.ink;
            placed.coverage = glyph.coverage;
            inOutGlyphs.push_back(placed);
        }
        inOutClusters.push_back(MakeTextCluster(
            line.byteBegin,
            runGlyphs[first].byteBegin,
            runGlyphs[first].byteEnd,
            firstGlyph,
            cast<u32>(end - first),
            cast<u32>(inOutLines.size()),
            direction,
            clusterLeft,
            pen
        ));
        first = end;
    }
    const f32 nextHeight = line.top + line.height;
    if(!IsFinite(VectorSingle(pen, nextHeight, pen, nextHeight).xy))
        return TextLayoutStatus::InvalidParameters;
    line.advance = pen;
    line.clusterCount = cast<u32>(inOutClusters.size()) - line.firstCluster;
    inOutLines.push_back(line);
    inOutMeasure = Point(Max(inOutMeasure.x, pen), nextHeight);
    return TextLayoutStatus::Success;
}

TextLayoutStatus SetLabelTextRequest(
    in ShapeRequest request,
    mut String inOutText,
    mut String inOutLanguage,
    mut f32 inOutFontSize,
    mut u32 inOutScriptTag,
    mut TextDirection inOutDirection,
    mut b8 inOutDirty
){
    ShapeRequest current;
    current.text = inOutText;
    current.language = inOutLanguage;
    current.fontSize = inOutFontSize;
    current.scriptTag = inOutScriptTag;
    current.direction = inOutDirection;
    if(SameShapeRequest(request, current))
        return TextLayoutStatus::Success;
    const TextLayoutStatus status = ValidateTextRequest(request, true);
    if(status != TextLayoutStatus::Success)
        return status;
    inOutDirty = true;
    inOutText.assign(request.text);
    inOutLanguage.assign(request.language);
    inOutFontSize = request.fontSize;
    inOutScriptTag = request.scriptTag;
    inOutDirection = request.direction;
    return TextLayoutStatus::Success;
}


