[cpp_header("<pipeline/dependency_computer/dependency_workspace.h>"), cpp_name("::NWB::Pipeline::CookDependencyAccess")]
extern class CookDependencyAccess{
    CookDependencyRegistry registry;
    b8 registerTypes();
    Expected<MetascriptDocument> read(in DiscoveredNwbFile file, in StringView prefix)const;
    Expected<b8, AssetBunchExpandFailure> visitExpanded(in DiscoveredNwbFile file, in MetascriptDocument document, in auto visit)const;
    b8 expandBunch(in DiscoveredNwbFile file, in MetascriptDocument document)const;
    b8 expandComposite(in DiscoveredNwbFile file, in MetascriptDocument document)const;
    b8 extract(in DiscoveredNwbFile file, in Name type, in Name path, in MetascriptValue asset, in Optional<in MetascriptDocument> document, in auto visit)const;
};

