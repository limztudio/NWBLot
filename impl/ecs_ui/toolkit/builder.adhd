    private Expected<usize> annotationAnchorIndex(in StringView stableKey)const{
        const auto id = TryMakeWidgetId(this.m_context.scopeId(), stableKey);
        if(id.has_value()){
            in Vector<BuilderItem> items = this.m_scope.value().m_items;
            for(usize index = 0u; index < items.size(); ++index){
                if(
                    items[index].state.id == id.value()
                    && items[index].state.kind != WidgetKind::Separator
                    && !(items[index].state.kind == WidgetKind::ScrollArea && items[index].checked)
                    && !(items[index].state.kind == WidgetKind::VirtualList && (items[index].checked || items[index].listRow != s_LayoutNoParent))
                    && !(items[index].state.kind == WidgetKind::SpinBox && items[index].checked)
                )
                    return index;
            }
        }
        return MakeUnexpected(Failure());
    }

