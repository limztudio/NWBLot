TextAreaOptions MakeUiTextAreaScrollOptions(){
    TextAreaOptions options = TextAreaOptions();
    options.width.policy = LayoutSizePolicy::Fixed;
    options.width.value = 180.0f;
    options.height.policy = LayoutSizePolicy::Fixed;
    options.height.value = 96.0f;
    return options;
}

b8 PrepareUiTextAreaScrollDocument(mut UiTextAreaInputScrollTests self, in Point scroll){
    return self.m_model.setText(self.documentView())
        && self.m_model.setSelection(1u, 1u)
        && self.m_model.replaceSelection("b")
        && self.m_model.setSelection(0u, 0u)
        && self.m_state.scrollTo(scroll);
}

b8 PrepareUiTextAreaScroll(mut UiTextAreaInputScrollTests self, in TextAreaOptions options, in Point scroll){
    return PrepareUiTextAreaScrollDocument(self, scroll) && self.frameArea(1u, options);
}

b8 SendUiTextAreaWheelAt(mut UiTextAreaInputScrollTests self, in f64 x, in f64 y, in Point position){
    InputEvent event = InputEvent();
    event.type = InputEventType::PointerWheel;
    event.position = position;
    event.scrollX = x;
    event.scrollY = y;
    return self.send(event).pointerConsumed;
}

b8 SendUiTextAreaWheel(mut UiTextAreaInputScrollTests self, in f64 x, in f64 y){
    return SendUiTextAreaWheelAt(self, x, y, CenterUiRect(self.m_state.placement().content));
}

WidgetId GetUiTextAreaInputPart(in UiTextAreaInputScrollTests self, in StringView key){
    return RequireUiWidgetId(self.id(s_UiTextAreaWidgetKey, s_UiTextAreaPanelKey), key);
}

b8 FrameUiTextAreaPopup(mut UiTextAreaInputScrollTests self, in u64 generation, mut PopupState popup){
    PopupOptions options = PopupOptions();
    options.anchor.x = 20.0f;
    options.anchor.y = 20.0f;
    options.anchor.width = 40.0f;
    options.anchor.height = 20.0f;
    options.size.x = 300.0f;
    options.size.y = 180.0f;
    if(!self.begin(generation) || !self.m_builder.beginPopup("popup", popup, options))
        return false;
    self.m_result = self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, MakeUiTextAreaScrollOptions());
    return self.m_result.valid
        && self.m_builder.endPopup()
        && self.m_context.endRoot()
        && self.m_context.finishFrame()
        && self.m_context.commitFrame(generation);
}

const u32 s_UiTextAreaQuietNaNF32Bits = 0x7fc00000u;
const u32 s_UiTextAreaPosInfF32Bits = 0x7f800000u;
const u32 s_UiTextAreaNegInfF32Bits = 0xff800000u;
const AStringView s_UiTextAreaPanelKey = "panel";
const AStringView s_UiTextAreaWidgetKey = "area";
const AStringView s_UiTextAreaPopupKey = "popup";
const AStringView s_UiTextAreaChildPopupKey = "child";
const AStringView s_UiTextAreaVerticalThumbPart = "scroll.y.thumb";
const AStringView s_UiTextAreaKoreanLanguage = "ko";
const AStringView s_UiTextAreaReenteredKey = "reentered";


class UiTextAreaScrollModelRecord{
    public String text;
    public u64 revision;
    public u64 external;
    public u64 selection;
    public u64 composition;
    public usize anchor;
    public usize caret;
    public b8 undo;
    public b8 redo;

    public UiTextAreaScrollModelRecord(in EditModel model){
        const StringView view = model.text();
        if(!view.empty())
            this.text.assign(view.data(), view.size());
        this.revision = model.revision();
        this.external = model.externalRevision();
        this.selection = model.selectionGeneration();
        this.composition = model.compositionGeneration();
        this.anchor = model.anchor();
        this.caret = model.caret();
        this.undo = model.canUndo();
        this.redo = model.canRedo();
    }

    public StringView textView()const{
        return StringView(this.text.data(), this.text.size());
    }

    public void expect(in EditModel model)const{
        EXPECT_EQ(model.text(), StringView(this.text.data(), this.text.size()));
        EXPECT_EQ(model.revision(), this.revision);
        EXPECT_EQ(model.externalRevision(), this.external);
        EXPECT_EQ(model.selectionGeneration(), this.selection);
        EXPECT_EQ(model.compositionGeneration(), this.composition);
        EXPECT_EQ(model.anchor(), this.anchor);
        EXPECT_EQ(model.caret(), this.caret);
        EXPECT_EQ(model.canUndo(), this.undo);
        EXPECT_EQ(model.canRedo(), this.redo);
    }
}

InputEvent MakeUiTextAreaPointerEvent(in Point position, in InputEventTypeEnum eventType){
    InputEvent event = InputEvent();
    event.position = position;
    event.type = eventType;
    return event;
}

ShapeRequest MakeUiTextAreaFontSizeShapeRequest(in f32 fontSize){
    ShapeRequest request = ShapeRequest();
    request.fontSize = fontSize;
    return request;
}


