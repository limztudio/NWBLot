////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/physics/world.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_SnapshotMagic = 0x50534E57u;
const u32 s_SnapshotVersion = 1u;
const u32 s_SnapshotMaxElements = 16777216u;
const u64 s_Fnv64OffsetBasis = 14695981039346656037u;
const u64 s_Fnv64Prime = 1099511628211u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u64 SnapshotFnv1a64(in Span<u8> data){
    u64 h = s_Fnv64OffsetBasis;
    for(usize i = 0u; i < data.size(); ++i){
        h ^= cast<u64>(data[i]);
        h *= s_Fnv64Prime;
    }
    return h;
}

class SnapshotByteWriter{
    public Vector<u8> bytes;

    public void writeU8(in u8 v){
        this.bytes.push_back(v);
    }

    public void writeB8(in b8 v){
        if(v)
            this.bytes.push_back(1u);
        else
            this.bytes.push_back(0u);
    }

    public void writeU16(in u16 v){
        this.bytes.push_back(cast<u8>(v & 0xffu));
        this.bytes.push_back(cast<u8>((v >> 8u) & 0xffu));
    }

    public void writeI16(in i16 v){
        this.writeU16(bit_cast<u16>(v));
    }

    public void writeU32(in u32 v){
        this.bytes.push_back(cast<u8>(v & 0xffu));
        this.bytes.push_back(cast<u8>((v >> 8u) & 0xffu));
        this.bytes.push_back(cast<u8>((v >> 16u) & 0xffu));
        this.bytes.push_back(cast<u8>((v >> 24u) & 0xffu));
    }

    public void writeI32(in i32 v){
        this.writeU32(bit_cast<u32>(v));
    }

    public void writeU64(in u64 v){
        this.writeU32(cast<u32>(v & 0xffffffffu));
        this.writeU32(cast<u32>((v >> 32u) & 0xffffffffu));
    }

    public void writeF32(in f32 v){
        this.writeU32(bit_cast<u32>(v));
    }

    public void writeVec4(in VectorSingle v){
        this.writeF32(v.x);
        this.writeF32(v.y);
        this.writeF32(v.z);
        this.writeF32(v.w);
    }

    public void writeVec3(in VectorSingle v){
        this.writeF32(v.x);
        this.writeF32(v.y);
        this.writeF32(v.z);
    }

    public void writeVec2F(in f32 x, in f32 y){
        this.writeF32(x);
        this.writeF32(y);
    }

    public void writeVec3U32F(in f32 x, in f32 y, in f32 z, in u32 w){
        this.writeF32(x);
        this.writeF32(y);
        this.writeF32(z);
        this.writeU32(w);
    }

    public void writeU32x4F(in u32 x, in u32 y, in u32 z, in u32 w){
        this.writeU32(x);
        this.writeU32(y);
        this.writeU32(z);
        this.writeU32(w);
    }

    public void writeTransform3D(in Transform3D xf){
        this.writeVec4(VectorSingle(xf.position));
        this.writeVec4(VectorSingle(xf.rotation));
    }

    public void writeAabb3D(in Aabb3D box){
        this.writeVec4(VectorSingle(box.lowerBound));
        this.writeVec4(VectorSingle(box.upperBound));
    }

    public void writeSymMat3(in SymMat3 m){
        this.writeF32(m.m00);
        this.writeF32(m.m01);
        this.writeF32(m.m02);
        this.writeF32(m.m11);
        this.writeF32(m.m12);
        this.writeF32(m.m22);
    }

    public void writeBodyId(in BodyId id){
        this.writeU32(id.index);
        this.writeU16(id.generation);
        this.writeU16(id.worldIndex);
    }

    public void writeShapeId(in ShapeId id){
        this.writeU32(id.index);
        this.writeU16(id.generation);
        this.writeU16(id.worldIndex);
    }

    public void writeJointId(in JointId id){
        this.writeU32(id.index);
        this.writeU16(id.generation);
        this.writeU16(id.worldIndex);
    }

    public void writeFilter(in Filter f){
        this.writeU32(f.categoryBits);
        this.writeU32(f.maskBits);
        this.writeI32(f.groupIndex);
    }

    public void writeSurfaceMaterial(in SurfaceMaterial m){
        this.writeVec4(VectorSingle(m.surfaceVelocity));
        this.writeVec4(VectorSingle(m.anisotropicFriction));
        this.writeVec4(VectorSingle(m.frictionDirection));
        this.writeF32(m.friction);
        this.writeF32(m.staticFriction);
        this.writeF32(m.restitution);
        this.writeF32(m.rollingResistance);
        this.writeF32(m.tangentSpeed);
        this.writeU8(cast<u8>(m.frictionCombineMode));
        this.writeU8(cast<u8>(m.restitutionCombineMode));
    }

    public b8 writeCount(in usize n){
        if(n > s_SnapshotMaxElements)
            return false;
        this.writeU32(cast<u32>(n));
        return true;
    }
}

class SnapshotByteReader{
    public usize cursor = 0u;
    public usize limit = 0u;

    public b8 hasRemaining(in usize needed)const{
        if(this.cursor > this.limit)
            return false;
        return needed <= (this.limit - this.cursor);
    }

    public b8 readU8(in Span<u8> data, mut u8 outVal){
        if(!this.hasRemaining(1u))
            return false;
        outVal = data[this.cursor];
        ++this.cursor;
        return true;
    }

    public b8 readB8(in Span<u8> data, mut b8 outVal){
        u8 b = 0u;
        if(!this.readU8(data, b))
            return false;
        outVal = (b != 0u);
        return true;
    }

    public b8 readU16(in Span<u8> data, mut u16 outVal){
        if(!this.hasRemaining(2u))
            return false;
        const u16 b0 = cast<u16>(data[this.cursor]);
        const u16 b1 = cast<u16>(data[this.cursor + 1u]);
        outVal = b0 | (b1 << 8u);
        this.cursor += 2u;
        return true;
    }

    public b8 readI16(in Span<u8> data, mut i16 outVal){
        u16 bits = 0u;
        if(!this.readU16(data, bits))
            return false;
        outVal = bit_cast<i16>(bits);
        return true;
    }

    public b8 readU32(in Span<u8> data, mut u32 outVal){
        if(!this.hasRemaining(4u))
            return false;
        const u32 b0 = cast<u32>(data[this.cursor]);
        const u32 b1 = cast<u32>(data[this.cursor + 1u]);
        const u32 b2 = cast<u32>(data[this.cursor + 2u]);
        const u32 b3 = cast<u32>(data[this.cursor + 3u]);
        outVal = b0 | (b1 << 8u) | (b2 << 16u) | (b3 << 24u);
        this.cursor += 4u;
        return true;
    }

    public b8 readI32(in Span<u8> data, mut i32 outVal){
        u32 bits = 0u;
        if(!this.readU32(data, bits))
            return false;
        outVal = bit_cast<i32>(bits);
        return true;
    }

    public b8 readU64(in Span<u8> data, mut u64 outVal){
        u32 lo = 0u;
        u32 hi = 0u;
        if(!this.readU32(data, lo) || !this.readU32(data, hi))
            return false;
        outVal = cast<u64>(lo) | (cast<u64>(hi) << 32u);
        return true;
    }

    public b8 readF32(in Span<u8> data, mut f32 outVal){
        u32 bits = 0u;
        if(!this.readU32(data, bits))
            return false;
        outVal = bit_cast<f32>(bits);
        return true;
    }

    public b8 readVec4F(in Span<u8> data, mut f32 ox, mut f32 oy, mut f32 oz, mut f32 ow){
        return this.readF32(data, ox) && this.readF32(data, oy) && this.readF32(data, oz) && this.readF32(data, ow);
    }

    public b8 readVec3F(in Span<u8> data, mut f32 ox, mut f32 oy, mut f32 oz){
        return this.readF32(data, ox) && this.readF32(data, oy) && this.readF32(data, oz);
    }

    public b8 readVec2F(in Span<u8> data, mut f32 ox, mut f32 oy){
        return this.readF32(data, ox) && this.readF32(data, oy);
    }

    public b8 readVec3U32F(in Span<u8> data, mut f32 ox, mut f32 oy, mut f32 oz, mut u32 ow){
        return this.readF32(data, ox) && this.readF32(data, oy) && this.readF32(data, oz) && this.readU32(data, ow);
    }

    public b8 readU32x4F(in Span<u8> data, mut u32 ox, mut u32 oy, mut u32 oz, mut u32 ow){
        return this.readU32(data, ox) && this.readU32(data, oy) && this.readU32(data, oz) && this.readU32(data, ow);
    }

    public b8 readTransform3D(in Span<u8> data, mut Transform3D outXf){
        return
            this.readVec4F(data, outXf.position.x, outXf.position.y, outXf.position.z, outXf.position.w)
            && this.readVec4F(data, outXf.rotation.x, outXf.rotation.y, outXf.rotation.z, outXf.rotation.w)
        ;
    }

    public b8 readAabb3D(in Span<u8> data, mut Aabb3D outBox){
        return
            this.readVec4F(data, outBox.lowerBound.x, outBox.lowerBound.y, outBox.lowerBound.z, outBox.lowerBound.w)
            && this.readVec4F(data, outBox.upperBound.x, outBox.upperBound.y, outBox.upperBound.z, outBox.upperBound.w)
        ;
    }

    public b8 readSymMat3(in Span<u8> data, mut SymMat3 outM){
        return
            this.readF32(data, outM.m00)
            && this.readF32(data, outM.m01)
            && this.readF32(data, outM.m02)
            && this.readF32(data, outM.m11)
            && this.readF32(data, outM.m12)
            && this.readF32(data, outM.m22)
        ;
    }

    public b8 readFilter(in Span<u8> data, mut Filter outF){
        return this.readU32(data, outF.categoryBits) && this.readU32(data, outF.maskBits) && this.readI32(data, outF.groupIndex);
    }

    public b8 readSurfaceMaterial(in Span<u8> data, mut SurfaceMaterial outM){
        u8 fMode = 0u;
        u8 rMode = 0u;
        if(
            !this.readVec4F(data, outM.surfaceVelocity.x, outM.surfaceVelocity.y, outM.surfaceVelocity.z, outM.surfaceVelocity.w)
            || !this.readVec4F(data, outM.anisotropicFriction.x, outM.anisotropicFriction.y, outM.anisotropicFriction.z, outM.anisotropicFriction.w)
            || !this.readVec4F(data, outM.frictionDirection.x, outM.frictionDirection.y, outM.frictionDirection.z, outM.frictionDirection.w)
            || !this.readF32(data, outM.friction)
            || !this.readF32(data, outM.staticFriction)
            || !this.readF32(data, outM.restitution)
            || !this.readF32(data, outM.rollingResistance)
            || !this.readF32(data, outM.tangentSpeed)
            || !this.readU8(data, fMode)
            || !this.readU8(data, rMode)
        )
            return false;
        if(fMode >= cast<u8>(MaterialCombineMode::kCount) || rMode >= cast<u8>(MaterialCombineMode::kCount))
            return false;
        outM.frictionCombineMode = cast<MaterialCombineMode>(fMode);
        outM.restitutionCombineMode = cast<MaterialCombineMode>(rMode);
        return true;
    }

    public b8 readCount(in Span<u8> data, in usize minBytesPerItem, mut u32 outCount){
        if(!this.readU32(data, outCount))
            return false;
        if(outCount > s_SnapshotMaxElements)
            return false;
        if(minBytesPerItem > 0u && !this.hasRemaining(cast<usize>(outCount) * minBytesPerItem))
            return false;
        return true;
    }
}

void SnapshotWriteU32Vec(mut SnapshotByteWriter w, in Vector<u32> v){
    w.writeCount(v.size());
    for(usize i = 0u; i < v.size(); ++i)
        w.writeU32(v[i]);
}

void SnapshotWriteU16Vec(mut SnapshotByteWriter w, in Vector<u16> v){
    w.writeCount(v.size());
    for(usize i = 0u; i < v.size(); ++i)
        w.writeU16(v[i]);
}

void SnapshotWriteU8Vec(mut SnapshotByteWriter w, in Vector<u8> v){
    w.writeCount(v.size());
    for(usize i = 0u; i < v.size(); ++i)
        w.writeU8(v[i]);
}

b8 SnapshotReadU32Vec(in Span<u8> data, mut SnapshotByteReader r, mut Vector<u32> outV){
    u32 cnt = 0u;
    if(!r.readCount(data, 4u, cnt))
        return false;
    outV.resize(cnt);
    for(u32 i = 0u; i < cnt; ++i){
        if(!r.readU32(data, outV[i]))
            return false;
    }
    return true;
}

b8 SnapshotReadU16Vec(in Span<u8> data, mut SnapshotByteReader r, mut Vector<u16> outV){
    u32 cnt = 0u;
    if(!r.readCount(data, 2u, cnt))
        return false;
    outV.resize(cnt);
    for(u32 i = 0u; i < cnt; ++i){
        if(!r.readU16(data, outV[i]))
            return false;
    }
    return true;
}

b8 SnapshotReadU8Vec(in Span<u8> data, mut SnapshotByteReader r, mut Vector<u8> outV){
    u32 cnt = 0u;
    if(!r.readCount(data, 1u, cnt))
        return false;
    outV.resize(cnt);
    for(u32 i = 0u; i < cnt; ++i){
        if(!r.readU8(data, outV[i]))
            return false;
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 SerializePhysicsWorldSnapshot(in PhysicsWorld world, mut Vector<u8> outBytes){
    outBytes.clear();
    SnapshotByteWriter w;
    w.writeU32(s_SnapshotMagic);
    w.writeU32(s_SnapshotVersion);

    w.writeVec4(VectorSingle(world.m_def.gravity));
    w.writeF32(world.m_def.restitutionThreshold);
    w.writeF32(world.m_def.hitEventThreshold);
    w.writeF32(world.m_def.contactHertz);
    w.writeF32(world.m_def.contactDampingRatio);
    w.writeF32(world.m_def.maxLinearVelocity);
    w.writeF32(world.m_def.timeToSleep);
    w.writeB8(world.m_def.enableSleep);
    w.writeB8(world.m_def.enableContinuous);
    w.writeB8(world.m_def.enableContactSoftening);
    w.writeB8(world.m_def.enableGpuCollision);
    w.writeB8(world.m_def.forceGpuCollision);
    w.writeB8(world.m_def.gpuResidentMode);
    w.writeB8(world.m_def.useGpuLbvhBroadphase);

    w.writeU16(world.m_worldIndex);
    w.writeU8(cast<u8>(world.m_backendMode));
    w.writeU32(world.m_gpuDispatchThreshold);
    w.writeF32(world.m_gpuWorkloadFraction);
    w.writeB8(world.m_enableWarmStarting);
    w.writeU64(world.m_topologyVersion);
    w.writeU64(world.m_worldGeneration);
    w.writeB8(world.m_hasDirtyBodyMass);
    w.writeU32(world.m_sensorEventShapeCount);
    w.writeU32(world.m_hitEventShapeCount);
    w.writeU32(world.m_breakableJointCount);
    w.writeU32(world.m_bulletBodyCount);

    if(!w.writeCount(world.m_bodies.size()))
        return false;
    for(usize i = 0u; i < world.m_bodies.size(); ++i){
        in Body b = world.m_bodies[i];
        w.writeU64(b.userData);
        w.writeU32(b.setIndex);
        w.writeU32(b.localIndex);
        w.writeU32(b.headContactKey);
        w.writeU32(b.contactCount);
        w.writeU32(b.headJointKey);
        w.writeU32(b.jointCount);
        w.writeU32(b.headShapeId);
        w.writeU32(b.shapeCount);
        w.writeU32(b.islandId);
        w.writeU32(b.islandIndex);
        w.writeF32(b.sleepThreshold);
        w.writeF32(b.sleepTime);
        w.writeF32(b.mass);
        w.writeF32(b.maxAngularVelocity);
        w.writeU32(b.bodyMoveIndex);
        w.writeU32(b.id);
        w.writeU32(b.flags);
        w.writeU8(cast<u8>(b.type));
        w.writeU16(b.generation);
        w.writeB8(b.alive);
    }
    SnapshotWriteU32Vec(w, world.m_freeBodyIds);

    if(!w.writeCount(world.m_shapes.size()))
        return false;
    for(usize i = 0u; i < world.m_shapes.size(); ++i){
        in Shape s = world.m_shapes[i];
        w.writeVec4(VectorSingle(s.geom0));
        w.writeVec4(VectorSingle(s.geom1));
        w.writeAabb3D(s.aabb);
        w.writeTransform3D(s.localTransform);
        w.writeU64(s.userData);
        w.writeSurfaceMaterial(s.material);
        w.writeFilter(s.filter);
        w.writeU32(s.bodyId);
        w.writeU32(s.id);
        w.writeU32(s.nextShapeId);
        w.writeU32(s.proxyKey);
        w.writeU32(s.geometryIndex);
        w.writeF32(s.density);
        w.writeU16(s.generation);
        w.writeU8(cast<u8>(s.type));
        w.writeU8(s.flags);
    }
    SnapshotWriteU32Vec(w, world.m_freeShapeIds);

    if(!w.writeCount(world.m_hullShapes.size()))
        return false;
    for(usize i = 0u; i < world.m_hullShapes.size(); ++i){
        in HullShape h = world.m_hullShapes[i];
        w.writeVec4(VectorSingle(h.centroidRadius));
        w.writeVec3U32F(h.halfExtentsFlags.x, h.halfExtentsFlags.y, h.halfExtentsFlags.z, h.halfExtentsFlags.w);
        w.writeVec4(VectorSingle(h.boxRotation));
        w.writeCount(h.vertices.size());
        for(usize k = 0u; k < h.vertices.size(); ++k)
            w.writeVec3(Vec3FromU(h.vertices[k]));
        w.writeCount(h.facePlanes.size());
        for(usize k = 0u; k < h.facePlanes.size(); ++k)
            w.writeVec4(VectorSingle(h.facePlanes[k].normalOffset));
        w.writeCount(h.faceTopologies.size());
        for(usize k = 0u; k < h.faceTopologies.size(); ++k){
            w.writeU8(h.faceTopologies[k].edge);
            w.writeU8(h.faceTopologies[k].vertexCount);
        }
        w.writeCount(h.halfEdges.size());
        for(usize k = 0u; k < h.halfEdges.size(); ++k){
            w.writeU8(h.halfEdges[k].tail);
            w.writeU8(h.halfEdges[k].face);
            w.writeU8(h.halfEdges[k].next);
            w.writeU8(h.halfEdges[k].twin);
        }
    }
    if(!w.writeCount(world.m_hullLocalAabbs.size()))
        return false;
    for(usize i = 0u; i < world.m_hullLocalAabbs.size(); ++i)
        w.writeAabb3D(world.m_hullLocalAabbs[i]);
    SnapshotWriteU32Vec(w, world.m_hullRefCounts);
    SnapshotWriteU16Vec(w, world.m_hullGenerations);
    SnapshotWriteU8Vec(w, world.m_hullOwnedByUser);
    SnapshotWriteU32Vec(w, world.m_freeHullShapeIds);

    if(!w.writeCount(world.m_meshShapes.size()))
        return false;
    for(usize i = 0u; i < world.m_meshShapes.size(); ++i){
        in MeshShape m = world.m_meshShapes[i];
        w.writeVec4(VectorSingle(m.localAabbMinRadius));
        w.writeVec3U32F(m.localAabbMaxMeta.x, m.localAabbMaxMeta.y, m.localAabbMaxMeta.z, m.localAabbMaxMeta.w);
        w.writeCount(m.triangles.size());
        for(usize k = 0u; k < m.triangles.size(); ++k){
            w.writeVec3(Vec3FromU(m.triangles[k].v0));
            w.writeVec3(Vec3FromU(m.triangles[k].v1));
            w.writeVec3(Vec3FromU(m.triangles[k].v2));
            w.writeVec3(Vec3FromU(m.triangles[k].normal));
        }
        w.writeCount(m.nodes.size());
        for(usize k = 0u; k < m.nodes.size(); ++k){
            w.writeVec3U32F(m.nodes[k].aabbMinLeft.x, m.nodes[k].aabbMinLeft.y, m.nodes[k].aabbMinLeft.z, m.nodes[k].aabbMinLeft.w);
            w.writeVec3U32F(m.nodes[k].aabbMaxRight.x, m.nodes[k].aabbMaxRight.y, m.nodes[k].aabbMaxRight.z, m.nodes[k].aabbMaxRight.w);
        }
        w.writeCount(m.materials.size());
        for(usize k = 0u; k < m.materials.size(); ++k)
            w.writeSurfaceMaterial(m.materials[k]);
        SnapshotWriteU16Vec(w, m.triangleMaterialIndices);
        SnapshotWriteU32Vec(w, m.triangleUserData);
    }
    SnapshotWriteU32Vec(w, world.m_meshRefCounts);
    SnapshotWriteU16Vec(w, world.m_meshGenerations);
    SnapshotWriteU8Vec(w, world.m_meshOwnedByUser);
    SnapshotWriteU32Vec(w, world.m_freeMeshShapeIds);

    if(!w.writeCount(world.m_heightfieldShapes.size()))
        return false;
    for(usize i = 0u; i < world.m_heightfieldShapes.size(); ++i){
        in HeightfieldShape hf = world.m_heightfieldShapes[i];
        w.writeU32(hf.rows);
        w.writeU32(hf.cols);
        w.writeVec4(VectorSingle(hf.scaleMinMaxY));
        w.writeVec4(VectorSingle(hf.originMaxY));
        w.writeF32(hf.thickness);
        w.writeCount(hf.heights.size());
        for(usize k = 0u; k < hf.heights.size(); ++k)
            w.writeF32(hf.heights[k]);
        SnapshotWriteU16Vec(w, hf.cellMaterialIndices);
        w.writeCount(hf.materials.size());
        for(usize k = 0u; k < hf.materials.size(); ++k)
            w.writeSurfaceMaterial(hf.materials[k]);
    }
    SnapshotWriteU32Vec(w, world.m_heightfieldRefCounts);
    SnapshotWriteU16Vec(w, world.m_heightfieldGenerations);
    SnapshotWriteU8Vec(w, world.m_heightfieldOwnedByUser);
    SnapshotWriteU32Vec(w, world.m_freeHeightfieldShapeIds);

    if(!w.writeCount(world.m_contacts.size()))
        return false;
    for(usize i = 0u; i < world.m_contacts.size(); ++i){
        in Contact c = world.m_contacts[i];
        w.writeU64(c.pairKey);
        w.writeU32(c.edges[0u].bodyId); w.writeU32(c.edges[0u].prevKey); w.writeU32(c.edges[0u].nextKey);
        w.writeU32(c.edges[1u].bodyId); w.writeU32(c.edges[1u].prevKey); w.writeU32(c.edges[1u].nextKey);
        w.writeVec4(VectorSingle(c.surfaceVelocity));
        w.writeVec4(VectorSingle(c.anisotropicFriction));
        w.writeVec4(VectorSingle(c.frictionDirection));
        w.writeU32(c.contactId);
        w.writeU32(c.shapeIdA);
        w.writeU32(c.shapeIdB);
        w.writeU32(c.colorIndex);
        w.writeU32(c.localIndex);
        w.writeU32(c.islandId);
        w.writeU32(c.islandIndex);
        w.writeF32(c.friction);
        w.writeF32(c.staticFriction);
        w.writeF32(c.restitution);
        w.writeF32(c.rollingResistance);
        w.writeF32(c.tangentSpeed);
        w.writeU32(c.flags);
        for(usize pi = 0u; pi < s_MaxManifoldPoints; ++pi){
            w.writeVec4(VectorSingle(c.manifold.points[pi].pointSeparation));
            w.writeVec4(VectorSingle(c.manifold.points[pi].anchorANormalImpulse));
            w.writeVec4(VectorSingle(c.manifold.points[pi].anchorBTotalImpulse));
        }
        w.writeVec4(VectorSingle(c.manifold.normalTwist));
        w.writeVec3U32F(c.manifold.rollingImpulseMeta.x, c.manifold.rollingImpulseMeta.y, c.manifold.rollingImpulseMeta.z, c.manifold.rollingImpulseMeta.w);
        w.writeU32x4F(c.manifold.pointIds.x, c.manifold.pointIds.y, c.manifold.pointIds.z, c.manifold.pointIds.w);
        w.writeVec2F(c.manifold.frictionImpulse.x, c.manifold.frictionImpulse.y);
        w.writeU32(c.manifold.materialTriangleA);
        w.writeU32(c.manifold.materialTriangleB);
    }
    SnapshotWriteU32Vec(w, world.m_freeContactIds);

    if(!w.writeCount(world.m_joints.size()))
        return false;
    for(usize i = 0u; i < world.m_joints.size(); ++i){
        in Joint j = world.m_joints[i];
        w.writeVec4(VectorSingle(j.localAnchorALength));
        w.writeVec4(VectorSingle(j.localAnchorBMinLength));
        w.writeVec4(VectorSingle(j.localAxisAMaxLength));
        w.writeVec4(VectorSingle(j.localAxisBLowerLimit));
        w.writeVec4(VectorSingle(j.referenceRotation));
        w.writeVec4(VectorSingle(j.linearOffsetUpperLimit));
        w.writeVec4(VectorSingle(j.linearImpulseLimit));
        w.writeVec4(VectorSingle(j.angularImpulseMotor));
        w.writeVec4(VectorSingle(j.lastForceConeSusp));
        w.writeVec4(VectorSingle(j.lastTorqueMotorSpeed));
        w.writeU64(j.userData);
        w.writeU32(j.edges[0u].bodyId); w.writeU32(j.edges[0u].prevKey); w.writeU32(j.edges[0u].nextKey);
        w.writeU32(j.edges[1u].bodyId); w.writeU32(j.edges[1u].prevKey); w.writeU32(j.edges[1u].nextKey);
        w.writeU32(j.jointId);
        w.writeU32(j.islandId);
        w.writeU32(j.islandIndex);
        w.writeU32(j.extraDataIndex);
        w.writeF32(j.maxMotorForce);
        w.writeF32(j.hertz);
        w.writeF32(j.dampingRatio);
        w.writeF32(j.correctionFactor);
        w.writeF32(j.maxTorque);
        w.writeF32(j.swingLimit);
        w.writeF32(j.swingLimitY);
        w.writeF32(j.springTarget);
        w.writeF32(j.suspensionHertz);
        w.writeF32(j.suspensionDampingRatio);
        w.writeF32(j.steeringAngle);
        w.writeF32(j.suspensionRestLength);
        w.writeF32(j.invMassScaleA);
        w.writeF32(j.invMassScaleB);
        w.writeF32(j.invInertiaScaleA);
        w.writeF32(j.invInertiaScaleB);
        w.writeF32(j.limitRestitution);
        w.writeF32(j.limitHertz);
        w.writeF32(j.limitDampingRatio);
        w.writeF32(j.projectionLinearTolerance);
        w.writeF32(j.projectionAngularTolerance);
        w.writeF32(j.ratio);
        w.writeF32(j.breakForce);
        w.writeF32(j.breakTorque);
        w.writeU16(j.generation);
        w.writeU8(cast<u8>(j.type));
        w.writeU8(j.flags);
    }
    SnapshotWriteU32Vec(w, world.m_freeJointIds);

    if(!w.writeCount(world.m_jointExtraData.size()))
        return false;
    for(usize i = 0u; i < world.m_jointExtraData.size(); ++i){
        in JointExtraData e = world.m_jointExtraData[i];
        for(usize k = 0u; k < 6u; ++k){
            in SixDofAxisConfig cfg = e.sixDofAxes[k];
            w.writeU8(cast<u8>(cfg.motion));
            w.writeF32(cfg.lowerLimit);
            w.writeF32(cfg.upperLimit);
            w.writeF32(cfg.motorTargetVelocity);
            w.writeF32(cfg.motorTargetPosition);
            w.writeF32(cfg.maxMotorForce);
            w.writeF32(cfg.springHertz);
            w.writeF32(cfg.springDampingRatio);
            w.writeB8(cfg.enableMotor);
            w.writeB8(cfg.enableSpring);
            w.writeF32(e.sixDofLowerImpulses[k]);
            w.writeF32(e.sixDofUpperImpulses[k]);
            w.writeF32(e.sixDofMotorImpulses[k]);
            w.writeF32(e.sixDofSpringImpulses[k]);
        }
        w.writeVec4(VectorSingle(e.groundAnchorA));
        w.writeVec4(VectorSingle(e.groundAnchorB));
        w.writeF32(e.pulleyConstant);
        w.writeCount(e.pathPoints.size());
        for(usize k = 0u; k < e.pathPoints.size(); ++k)
            w.writeVec4(VectorSingle(e.pathPoints[k]));
        w.writeB8(e.pathClosed);
        w.writeB8(e.pathLockRotation);
        w.writeB8(e.alive);
    }
    SnapshotWriteU32Vec(w, world.m_freeJointExtraData);

    if(!w.writeCount(world.m_solverSets.size()))
        return false;
    for(usize i = 0u; i < world.m_solverSets.size(); ++i){
        in SolverSet ss = world.m_solverSets[i];
        w.writeU32(ss.setIndex);
        w.writeU64(ss.membershipVersion);
        w.writeCount(ss.sims.size());
        for(usize k = 0u; k < ss.sims.size(); ++k){
            in BodySim sim = ss.sims[k];
            w.writeTransform3D(sim.transform);
            w.writeVec4(VectorSingle(sim.centerInvMass));
            w.writeVec4(VectorSingle(sim.localCenterMinExtent));
            w.writeVec4(VectorSingle(sim.rotation0));
            w.writeVec4(VectorSingle(sim.center0MaxExtent));
            w.writeVec4(VectorSingle(sim.forceLinearDamping));
            w.writeVec4(VectorSingle(sim.torqueAngularDamping));
            w.writeSymMat3(sim.invInertiaLocal);
            w.writeSymMat3(sim.invInertiaWorld);
            w.writeF32(sim.gravityScale);
            w.writeU32(sim.flags);
            w.writeU32(sim.bodyId);
            w.writeF32(sim.maxAngularVelocity);
        }
        w.writeCount(ss.states.size());
        for(usize k = 0u; k < ss.states.size(); ++k){
            in BodyState st = ss.states[k];
            w.writeVec4(VectorSingle(st.linearVelocity));
            w.writeVec4(VectorSingle(st.angularVelocity));
            w.writeVec3U32F(st.deltaPositionFlags.x, st.deltaPositionFlags.y, st.deltaPositionFlags.z, st.deltaPositionFlags.w);
            w.writeVec4(VectorSingle(st.deltaRotation));
        }
        SnapshotWriteU32Vec(w, ss.islands);
    }
    SnapshotWriteU32Vec(w, world.m_freeSolverSetIds);

    if(!w.writeCount(world.m_islands.size()))
        return false;
    for(usize i = 0u; i < world.m_islands.size(); ++i){
        in Island isl = world.m_islands[i];
        w.writeU32(isl.setIndex);
        w.writeU32(isl.localIndex);
        w.writeU32(isl.islandId);
        w.writeU32(isl.constraintRemoveCount);
        w.writeB8(isl.alive);
        SnapshotWriteU32Vec(w, isl.bodies);
        w.writeCount(isl.contacts.size());
        for(usize k = 0u; k < isl.contacts.size(); ++k){
            w.writeU32(isl.contacts[k].contactId);
            w.writeU32(isl.contacts[k].bodyIdA);
            w.writeU32(isl.contacts[k].bodyIdB);
        }
        w.writeCount(isl.joints.size());
        for(usize k = 0u; k < isl.joints.size(); ++k){
            w.writeU32(isl.joints[k].jointId);
            w.writeU32(isl.joints[k].bodyIdA);
            w.writeU32(isl.joints[k].bodyIdB);
        }
    }
    SnapshotWriteU32Vec(w, world.m_freeIslandIds);

    for(usize c = 0u; c < s_GraphColorCount; ++c)
        SnapshotWriteU32Vec(w, world.m_graph.colors[c].contactIds);
    SnapshotWriteU32Vec(w, world.m_graph.bodyColorMasks);

    for(usize t = 0u; t < s_TreeCount; ++t){
        in DynamicTree tree = world.m_broadPhase.trees[t];
        in Vector<TreeNode> nodes = tree.nodes();
        w.writeU32(tree.root());
        w.writeU32(tree.freeList());
        w.writeU32(tree.nodeCount());
        if(!w.writeCount(nodes.size()))
            return false;
        for(usize k = 0u; k < nodes.size(); ++k){
            in TreeNode n = nodes[k];
            w.writeVec3U32F(n.aabbMinUser.x, n.aabbMinUser.y, n.aabbMinUser.z, n.aabbMinUser.w);
            w.writeVec3U32F(n.aabbMaxCategory.x, n.aabbMaxCategory.y, n.aabbMaxCategory.z, n.aabbMaxCategory.w);
            w.writeU32(n.parentOrNext);
            w.writeU32(n.child1);
            w.writeU32(n.child2);
            w.writeI16(n.height);
            w.writeB8(n.moved);
            w.writeU8(n.nodeFlags);
        }
        SnapshotWriteU32Vec(w, tree.moveIndices());
    }
    SnapshotWriteU32Vec(w, world.m_broadPhase.moveArray);

    const u64 checksum = SnapshotFnv1a64(Span<u8>(w.bytes.data(), w.bytes.size()));
    w.writeU64(checksum);

    outBytes.clear();
    outBytes.reserve(w.bytes.size());
    for(usize i = 0u; i < w.bytes.size(); ++i)
        outBytes.push_back(w.bytes[i]);
    return true;
}

b8 RestorePhysicsWorldSnapshot(in Span<u8> bytes, mut PhysicsWorld world){
    if(world.m_inStep || bytes.size() < 24u)
        return false;

    const usize payloadEnd = bytes.size() - 8u;
    const u64 computedHash = SnapshotFnv1a64(Span<u8>(bytes.data(), payloadEnd));
    SnapshotByteReader hashReader;
    hashReader.cursor = payloadEnd;
    hashReader.limit = bytes.size();
    u64 storedHash = 0u;
    if(!hashReader.readU64(bytes, storedHash) || storedHash != computedHash)
        return false;

    SnapshotByteReader r;
    r.cursor = 0u;
    r.limit = payloadEnd;

    u32 magic = 0u;
    u32 version = 0u;
    if(!r.readU32(bytes, magic) || !r.readU32(bytes, version))
        return false;
    if(magic != s_SnapshotMagic || version != s_SnapshotVersion)
        return false;

    PhysicsWorld tmp;
    tmp.clear();
    tmp.m_solverSets.clear();

    if(
        !r.readVec4F(bytes, tmp.m_def.gravity.x, tmp.m_def.gravity.y, tmp.m_def.gravity.z, tmp.m_def.gravity.w)
        || !r.readF32(bytes, tmp.m_def.restitutionThreshold)
        || !r.readF32(bytes, tmp.m_def.hitEventThreshold)
        || !r.readF32(bytes, tmp.m_def.contactHertz)
        || !r.readF32(bytes, tmp.m_def.contactDampingRatio)
        || !r.readF32(bytes, tmp.m_def.maxLinearVelocity)
        || !r.readF32(bytes, tmp.m_def.timeToSleep)
        || !r.readB8(bytes, tmp.m_def.enableSleep)
        || !r.readB8(bytes, tmp.m_def.enableContinuous)
        || !r.readB8(bytes, tmp.m_def.enableContactSoftening)
        || !r.readB8(bytes, tmp.m_def.enableGpuCollision)
        || !r.readB8(bytes, tmp.m_def.forceGpuCollision)
        || !r.readB8(bytes, tmp.m_def.gpuResidentMode)
        || !r.readB8(bytes, tmp.m_def.useGpuLbvhBroadphase)
    )
        return false;

    u8 backendByte = 0u;
    if(
        !r.readU16(bytes, tmp.m_worldIndex)
        || !r.readU8(bytes, backendByte)
        || !r.readU32(bytes, tmp.m_gpuDispatchThreshold)
        || !r.readF32(bytes, tmp.m_gpuWorkloadFraction)
        || !r.readB8(bytes, tmp.m_enableWarmStarting)
        || !r.readU64(bytes, tmp.m_topologyVersion)
        || !r.readU64(bytes, tmp.m_worldGeneration)
        || !r.readB8(bytes, tmp.m_hasDirtyBodyMass)
        || !r.readU32(bytes, tmp.m_sensorEventShapeCount)
        || !r.readU32(bytes, tmp.m_hitEventShapeCount)
        || !r.readU32(bytes, tmp.m_breakableJointCount)
        || !r.readU32(bytes, tmp.m_bulletBodyCount)
    )
        return false;
    if(backendByte >= cast<u8>(PhysicsBackendMode::kCount))
        return false;
    tmp.m_backendMode = cast<PhysicsBackendMode>(backendByte);

    u32 bodyCount = 0u;
    if(!r.readCount(bytes, 32u, bodyCount))
        return false;
    tmp.m_bodies.resize(bodyCount);
    for(u32 i = 0u; i < bodyCount; ++i){
        mut Body b = tmp.m_bodies[i];
        u8 bType = 0u;
        if(
            !r.readU64(bytes, b.userData)
            || !r.readU32(bytes, b.setIndex)
            || !r.readU32(bytes, b.localIndex)
            || !r.readU32(bytes, b.headContactKey)
            || !r.readU32(bytes, b.contactCount)
            || !r.readU32(bytes, b.headJointKey)
            || !r.readU32(bytes, b.jointCount)
            || !r.readU32(bytes, b.headShapeId)
            || !r.readU32(bytes, b.shapeCount)
            || !r.readU32(bytes, b.islandId)
            || !r.readU32(bytes, b.islandIndex)
            || !r.readF32(bytes, b.sleepThreshold)
            || !r.readF32(bytes, b.sleepTime)
            || !r.readF32(bytes, b.mass)
            || !r.readF32(bytes, b.maxAngularVelocity)
            || !r.readU32(bytes, b.bodyMoveIndex)
            || !r.readU32(bytes, b.id)
            || !r.readU32(bytes, b.flags)
            || !r.readU8(bytes, bType)
            || !r.readU16(bytes, b.generation)
            || !r.readB8(bytes, b.alive)
        )
            return false;
        if(bType >= cast<u8>(BodyType::kCount))
            return false;
        b.type = cast<BodyType>(bType);
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeBodyIds))
        return false;

    u32 shapeCount = 0u;
    if(!r.readCount(bytes, 64u, shapeCount))
        return false;
    tmp.m_shapes.resize(shapeCount);

    for(u32 i = 0u; i < shapeCount; ++i){
        mut Shape s = tmp.m_shapes[i];
        u8 sType = 0u;
        if(
            !r.readVec4F(bytes, s.geom0.x, s.geom0.y, s.geom0.z, s.geom0.w)
            || !r.readVec4F(bytes, s.geom1.x, s.geom1.y, s.geom1.z, s.geom1.w)
            || !r.readAabb3D(bytes, s.aabb)
            || !r.readTransform3D(bytes, s.localTransform)
            || !r.readU64(bytes, s.userData)
            || !r.readSurfaceMaterial(bytes, s.material)
            || !r.readFilter(bytes, s.filter)
            || !r.readU32(bytes, s.bodyId)
            || !r.readU32(bytes, s.id)
            || !r.readU32(bytes, s.nextShapeId)
            || !r.readU32(bytes, s.proxyKey)
            || !r.readU32(bytes, s.geometryIndex)
            || !r.readF32(bytes, s.density)
            || !r.readU16(bytes, s.generation)
            || !r.readU8(bytes, sType)
            || !r.readU8(bytes, s.flags)
        )
            return false;
        if(sType >= cast<u8>(ShapeType::kCount))
            return false;
        s.type = cast<ShapeType>(sType);
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeShapeIds))
        return false;

    u32 hullCount = 0u;
    if(!r.readCount(bytes, 32u, hullCount))
        return false;
    tmp.m_hullShapes.resize(hullCount);
    for(u32 i = 0u; i < hullCount; ++i){
        mut HullShape h = tmp.m_hullShapes[i];
        if(
            !r.readVec4F(bytes, h.centroidRadius.x, h.centroidRadius.y, h.centroidRadius.z, h.centroidRadius.w)
            || !r.readVec3U32F(bytes, h.halfExtentsFlags.x, h.halfExtentsFlags.y, h.halfExtentsFlags.z, h.halfExtentsFlags.w)
            || !r.readVec4F(bytes, h.boxRotation.x, h.boxRotation.y, h.boxRotation.z, h.boxRotation.w)
        )
            return false;
        u32 vc = 0u;
        if(!r.readCount(bytes, 12u, vc))
            return false;
        h.vertices.resize(vc);
        for(u32 k = 0u; k < vc; ++k){
            if(!r.readVec3F(bytes, h.vertices[k].x, h.vertices[k].y, h.vertices[k].z))
                return false;
        }
        u32 fpc = 0u;
        if(!r.readCount(bytes, 16u, fpc))
            return false;
        h.facePlanes.resize(fpc);
        for(u32 k = 0u; k < fpc; ++k){
            if(!r.readVec4F(bytes, h.facePlanes[k].normalOffset.x, h.facePlanes[k].normalOffset.y, h.facePlanes[k].normalOffset.z, h.facePlanes[k].normalOffset.w))
                return false;
        }
        u32 ftc = 0u;
        if(!r.readCount(bytes, 2u, ftc))
            return false;
        h.faceTopologies.resize(ftc);
        for(u32 k = 0u; k < ftc; ++k){
            if(!r.readU8(bytes, h.faceTopologies[k].edge) || !r.readU8(bytes, h.faceTopologies[k].vertexCount))
                return false;
        }
        u32 hec = 0u;
        if(!r.readCount(bytes, 4u, hec))
            return false;
        h.halfEdges.resize(hec);
        for(u32 k = 0u; k < hec; ++k){
            if(
                !r.readU8(bytes, h.halfEdges[k].tail)
                || !r.readU8(bytes, h.halfEdges[k].face)
                || !r.readU8(bytes, h.halfEdges[k].next)
                || !r.readU8(bytes, h.halfEdges[k].twin)
            )
                return false;
        }
    }
    u32 hullAabbCount = 0u;
    if(!r.readCount(bytes, 32u, hullAabbCount))
        return false;
    tmp.m_hullLocalAabbs.resize(hullAabbCount);
    for(u32 i = 0u; i < hullAabbCount; ++i){
        if(!r.readAabb3D(bytes, tmp.m_hullLocalAabbs[i]))
            return false;
    }
    if(
        !SnapshotReadU32Vec(bytes, r, tmp.m_hullRefCounts)
        || !SnapshotReadU16Vec(bytes, r, tmp.m_hullGenerations)
        || !SnapshotReadU8Vec(bytes, r, tmp.m_hullOwnedByUser)
        || !SnapshotReadU32Vec(bytes, r, tmp.m_freeHullShapeIds)
    )
        return false;

    u32 meshCount = 0u;
    if(!r.readCount(bytes, 32u, meshCount))
        return false;
    tmp.m_meshShapes.resize(meshCount);
    for(u32 i = 0u; i < meshCount; ++i){
        mut MeshShape m = tmp.m_meshShapes[i];
        if(!r.readVec4F(bytes, m.localAabbMinRadius.x, m.localAabbMinRadius.y, m.localAabbMinRadius.z, m.localAabbMinRadius.w) || !r.readVec3U32F(bytes, m.localAabbMaxMeta.x, m.localAabbMaxMeta.y, m.localAabbMaxMeta.z, m.localAabbMaxMeta.w))
            return false;
        u32 tc = 0u;
        if(!r.readCount(bytes, 48u, tc))
            return false;
        m.triangles.resize(tc);
        for(u32 k = 0u; k < tc; ++k){
            if(
                !r.readVec3F(bytes, m.triangles[k].v0.x, m.triangles[k].v0.y, m.triangles[k].v0.z)
                || !r.readVec3F(bytes, m.triangles[k].v1.x, m.triangles[k].v1.y, m.triangles[k].v1.z)
                || !r.readVec3F(bytes, m.triangles[k].v2.x, m.triangles[k].v2.y, m.triangles[k].v2.z)
                || !r.readVec3F(bytes, m.triangles[k].normal.x, m.triangles[k].normal.y, m.triangles[k].normal.z)
            )
                return false;
        }
        u32 nc = 0u;
        if(!r.readCount(bytes, 32u, nc))
            return false;
        m.nodes.resize(nc);
        for(u32 k = 0u; k < nc; ++k){
            if(
                !r.readVec3U32F(bytes, m.nodes[k].aabbMinLeft.x, m.nodes[k].aabbMinLeft.y, m.nodes[k].aabbMinLeft.z, m.nodes[k].aabbMinLeft.w)
                || !r.readVec3U32F(bytes, m.nodes[k].aabbMaxRight.x, m.nodes[k].aabbMaxRight.y, m.nodes[k].aabbMaxRight.z, m.nodes[k].aabbMaxRight.w)
            )
                return false;
        }
        u32 mc = 0u;
        if(!r.readCount(bytes, 16u, mc))
            return false;
        m.materials.resize(mc);
        for(u32 k = 0u; k < mc; ++k){
            if(!r.readSurfaceMaterial(bytes, m.materials[k]))
                return false;
        }
        if(!SnapshotReadU16Vec(bytes, r, m.triangleMaterialIndices) || !SnapshotReadU32Vec(bytes, r, m.triangleUserData))
            return false;
    }
    if(
        !SnapshotReadU32Vec(bytes, r, tmp.m_meshRefCounts)
        || !SnapshotReadU16Vec(bytes, r, tmp.m_meshGenerations)
        || !SnapshotReadU8Vec(bytes, r, tmp.m_meshOwnedByUser)
        || !SnapshotReadU32Vec(bytes, r, tmp.m_freeMeshShapeIds)
    )
        return false;

    u32 hfCount = 0u;
    if(!r.readCount(bytes, 32u, hfCount))
        return false;
    tmp.m_heightfieldShapes.resize(hfCount);
    for(u32 i = 0u; i < hfCount; ++i){
        mut HeightfieldShape hf = tmp.m_heightfieldShapes[i];
        if(
            !r.readU32(bytes, hf.rows)
            || !r.readU32(bytes, hf.cols)
            || !r.readVec4F(bytes, hf.scaleMinMaxY.x, hf.scaleMinMaxY.y, hf.scaleMinMaxY.z, hf.scaleMinMaxY.w)
            || !r.readVec4F(bytes, hf.originMaxY.x, hf.originMaxY.y, hf.originMaxY.z, hf.originMaxY.w)
            || !r.readF32(bytes, hf.thickness)
        )
            return false;
        u32 hc = 0u;
        if(!r.readCount(bytes, 4u, hc))
            return false;
        hf.heights.resize(hc);
        for(u32 k = 0u; k < hc; ++k){
            if(!r.readF32(bytes, hf.heights[k]))
                return false;
        }
        if(!SnapshotReadU16Vec(bytes, r, hf.cellMaterialIndices))
            return false;
        u32 mc = 0u;
        if(!r.readCount(bytes, 16u, mc))
            return false;
        hf.materials.resize(mc);
        for(u32 k = 0u; k < mc; ++k){
            if(!r.readSurfaceMaterial(bytes, hf.materials[k]))
                return false;
        }
    }
    if(
        !SnapshotReadU32Vec(bytes, r, tmp.m_heightfieldRefCounts)
        || !SnapshotReadU16Vec(bytes, r, tmp.m_heightfieldGenerations)
        || !SnapshotReadU8Vec(bytes, r, tmp.m_heightfieldOwnedByUser)
        || !SnapshotReadU32Vec(bytes, r, tmp.m_freeHeightfieldShapeIds)
    )
        return false;

    u32 contactCount = 0u;
    if(!r.readCount(bytes, 64u, contactCount))
        return false;
    tmp.m_contacts.resize(contactCount);
    for(u32 i = 0u; i < contactCount; ++i){
        mut Contact c = tmp.m_contacts[i];
        if(
            !r.readU64(bytes, c.pairKey)
            || !r.readU32(bytes, c.edges[0u].bodyId) || !r.readU32(bytes, c.edges[0u].prevKey) || !r.readU32(bytes, c.edges[0u].nextKey)
            || !r.readU32(bytes, c.edges[1u].bodyId) || !r.readU32(bytes, c.edges[1u].prevKey) || !r.readU32(bytes, c.edges[1u].nextKey)
            || !r.readVec4F(bytes, c.surfaceVelocity.x, c.surfaceVelocity.y, c.surfaceVelocity.z, c.surfaceVelocity.w)
            || !r.readVec4F(bytes, c.anisotropicFriction.x, c.anisotropicFriction.y, c.anisotropicFriction.z, c.anisotropicFriction.w)
            || !r.readVec4F(bytes, c.frictionDirection.x, c.frictionDirection.y, c.frictionDirection.z, c.frictionDirection.w)
            || !r.readU32(bytes, c.contactId)
            || !r.readU32(bytes, c.shapeIdA)
            || !r.readU32(bytes, c.shapeIdB)
            || !r.readU32(bytes, c.colorIndex)
            || !r.readU32(bytes, c.localIndex)
            || !r.readU32(bytes, c.islandId)
            || !r.readU32(bytes, c.islandIndex)
            || !r.readF32(bytes, c.friction)
            || !r.readF32(bytes, c.staticFriction)
            || !r.readF32(bytes, c.restitution)
            || !r.readF32(bytes, c.rollingResistance)
            || !r.readF32(bytes, c.tangentSpeed)
            || !r.readU32(bytes, c.flags)
        )
            return false;
        for(usize pi = 0u; pi < s_MaxManifoldPoints; ++pi){
            if(
                !r.readVec4F(bytes, c.manifold.points[pi].pointSeparation.x, c.manifold.points[pi].pointSeparation.y, c.manifold.points[pi].pointSeparation.z, c.manifold.points[pi].pointSeparation.w)
                || !r.readVec4F(bytes, c.manifold.points[pi].anchorANormalImpulse.x, c.manifold.points[pi].anchorANormalImpulse.y, c.manifold.points[pi].anchorANormalImpulse.z, c.manifold.points[pi].anchorANormalImpulse.w)
                || !r.readVec4F(bytes, c.manifold.points[pi].anchorBTotalImpulse.x, c.manifold.points[pi].anchorBTotalImpulse.y, c.manifold.points[pi].anchorBTotalImpulse.z, c.manifold.points[pi].anchorBTotalImpulse.w)
            )
                return false;
        }
        if(
            !r.readVec4F(bytes, c.manifold.normalTwist.x, c.manifold.normalTwist.y, c.manifold.normalTwist.z, c.manifold.normalTwist.w)
            || !r.readVec3U32F(bytes, c.manifold.rollingImpulseMeta.x, c.manifold.rollingImpulseMeta.y, c.manifold.rollingImpulseMeta.z, c.manifold.rollingImpulseMeta.w)
            || !r.readU32x4F(bytes, c.manifold.pointIds.x, c.manifold.pointIds.y, c.manifold.pointIds.z, c.manifold.pointIds.w)
            || !r.readVec2F(bytes, c.manifold.frictionImpulse.x, c.manifold.frictionImpulse.y)
            || !r.readU32(bytes, c.manifold.materialTriangleA)
            || !r.readU32(bytes, c.manifold.materialTriangleB)
        )
            return false;
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeContactIds))
        return false;

    u32 jointCount = 0u;
    if(!r.readCount(bytes, 64u, jointCount))
        return false;
    tmp.m_joints.resize(jointCount);
    for(u32 i = 0u; i < jointCount; ++i){
        mut Joint j = tmp.m_joints[i];
        u8 jType = 0u;
        if(
            !r.readVec4F(bytes, j.localAnchorALength.x, j.localAnchorALength.y, j.localAnchorALength.z, j.localAnchorALength.w)
            || !r.readVec4F(bytes, j.localAnchorBMinLength.x, j.localAnchorBMinLength.y, j.localAnchorBMinLength.z, j.localAnchorBMinLength.w)
            || !r.readVec4F(bytes, j.localAxisAMaxLength.x, j.localAxisAMaxLength.y, j.localAxisAMaxLength.z, j.localAxisAMaxLength.w)
            || !r.readVec4F(bytes, j.localAxisBLowerLimit.x, j.localAxisBLowerLimit.y, j.localAxisBLowerLimit.z, j.localAxisBLowerLimit.w)
            || !r.readVec4F(bytes, j.referenceRotation.x, j.referenceRotation.y, j.referenceRotation.z, j.referenceRotation.w)
            || !r.readVec4F(bytes, j.linearOffsetUpperLimit.x, j.linearOffsetUpperLimit.y, j.linearOffsetUpperLimit.z, j.linearOffsetUpperLimit.w)
            || !r.readVec4F(bytes, j.linearImpulseLimit.x, j.linearImpulseLimit.y, j.linearImpulseLimit.z, j.linearImpulseLimit.w)
            || !r.readVec4F(bytes, j.angularImpulseMotor.x, j.angularImpulseMotor.y, j.angularImpulseMotor.z, j.angularImpulseMotor.w)
            || !r.readVec4F(bytes, j.lastForceConeSusp.x, j.lastForceConeSusp.y, j.lastForceConeSusp.z, j.lastForceConeSusp.w)
            || !r.readVec4F(bytes, j.lastTorqueMotorSpeed.x, j.lastTorqueMotorSpeed.y, j.lastTorqueMotorSpeed.z, j.lastTorqueMotorSpeed.w)
            || !r.readU64(bytes, j.userData)
            || !r.readU32(bytes, j.edges[0u].bodyId) || !r.readU32(bytes, j.edges[0u].prevKey) || !r.readU32(bytes, j.edges[0u].nextKey)
            || !r.readU32(bytes, j.edges[1u].bodyId) || !r.readU32(bytes, j.edges[1u].prevKey) || !r.readU32(bytes, j.edges[1u].nextKey)
            || !r.readU32(bytes, j.jointId)
            || !r.readU32(bytes, j.islandId)
            || !r.readU32(bytes, j.islandIndex)
            || !r.readU32(bytes, j.extraDataIndex)
            || !r.readF32(bytes, j.maxMotorForce)
            || !r.readF32(bytes, j.hertz)
            || !r.readF32(bytes, j.dampingRatio)
            || !r.readF32(bytes, j.correctionFactor)
            || !r.readF32(bytes, j.maxTorque)
            || !r.readF32(bytes, j.swingLimit)
            || !r.readF32(bytes, j.swingLimitY)
            || !r.readF32(bytes, j.springTarget)
            || !r.readF32(bytes, j.suspensionHertz)
            || !r.readF32(bytes, j.suspensionDampingRatio)
            || !r.readF32(bytes, j.steeringAngle)
            || !r.readF32(bytes, j.suspensionRestLength)
            || !r.readF32(bytes, j.invMassScaleA)
            || !r.readF32(bytes, j.invMassScaleB)
            || !r.readF32(bytes, j.invInertiaScaleA)
            || !r.readF32(bytes, j.invInertiaScaleB)
            || !r.readF32(bytes, j.limitRestitution)
            || !r.readF32(bytes, j.limitHertz)
            || !r.readF32(bytes, j.limitDampingRatio)
            || !r.readF32(bytes, j.projectionLinearTolerance)
            || !r.readF32(bytes, j.projectionAngularTolerance)
            || !r.readF32(bytes, j.ratio)
            || !r.readF32(bytes, j.breakForce)
            || !r.readF32(bytes, j.breakTorque)
            || !r.readU16(bytes, j.generation)
            || !r.readU8(bytes, jType)
            || !r.readU8(bytes, j.flags)
        )
            return false;
        if(jType >= cast<u8>(JointType::kCount))
            return false;
        j.type = cast<JointType>(jType);
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeJointIds))
        return false;

    u32 extraCount = 0u;
    if(!r.readCount(bytes, 32u, extraCount))
        return false;
    tmp.m_jointExtraData.resize(extraCount);
    for(u32 i = 0u; i < extraCount; ++i){
        mut JointExtraData e = tmp.m_jointExtraData[i];
        for(usize k = 0u; k < 6u; ++k){
            mut SixDofAxisConfig cfg = e.sixDofAxes[k];
            u8 mot = 0u;
            if(
                !r.readU8(bytes, mot)
                || !r.readF32(bytes, cfg.lowerLimit)
                || !r.readF32(bytes, cfg.upperLimit)
                || !r.readF32(bytes, cfg.motorTargetVelocity)
                || !r.readF32(bytes, cfg.motorTargetPosition)
                || !r.readF32(bytes, cfg.maxMotorForce)
                || !r.readF32(bytes, cfg.springHertz)
                || !r.readF32(bytes, cfg.springDampingRatio)
                || !r.readB8(bytes, cfg.enableMotor)
                || !r.readB8(bytes, cfg.enableSpring)
                || !r.readF32(bytes, e.sixDofLowerImpulses[k])
                || !r.readF32(bytes, e.sixDofUpperImpulses[k])
                || !r.readF32(bytes, e.sixDofMotorImpulses[k])
                || !r.readF32(bytes, e.sixDofSpringImpulses[k])
            )
                return false;
            if(mot >= cast<u8>(JointMotion::kCount))
                return false;
            cfg.motion = cast<JointMotion>(mot);
        }
        if(
            !r.readVec4F(bytes, e.groundAnchorA.x, e.groundAnchorA.y, e.groundAnchorA.z, e.groundAnchorA.w)
            || !r.readVec4F(bytes, e.groundAnchorB.x, e.groundAnchorB.y, e.groundAnchorB.z, e.groundAnchorB.w)
            || !r.readF32(bytes, e.pulleyConstant)
        )
            return false;
        u32 pc = 0u;
        if(!r.readCount(bytes, 16u, pc))
            return false;
        e.pathPoints.resize(pc);
        for(u32 k = 0u; k < pc; ++k){
            if(!r.readVec4F(bytes, e.pathPoints[k].x, e.pathPoints[k].y, e.pathPoints[k].z, e.pathPoints[k].w))
                return false;
        }
        if(!r.readB8(bytes, e.pathClosed) || !r.readB8(bytes, e.pathLockRotation) || !r.readB8(bytes, e.alive))
            return false;
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeJointExtraData))
        return false;

    u32 setCount = 0u;
    if(!r.readCount(bytes, 12u, setCount) || setCount < 3u)
        return false;
    tmp.m_solverSets.resize(setCount);
    for(u32 i = 0u; i < setCount; ++i){
        mut SolverSet ss = tmp.m_solverSets[i];
        if(!r.readU32(bytes, ss.setIndex) || !r.readU64(bytes, ss.membershipVersion))
            return false;
        u32 simC = 0u;
        if(!r.readCount(bytes, 64u, simC))
            return false;
        ss.sims.resize(simC);
        for(u32 k = 0u; k < simC; ++k){
            mut BodySim sim = ss.sims[k];
            if(
                !r.readTransform3D(bytes, sim.transform)
                || !r.readVec4F(bytes, sim.centerInvMass.x, sim.centerInvMass.y, sim.centerInvMass.z, sim.centerInvMass.w)
                || !r.readVec4F(bytes, sim.localCenterMinExtent.x, sim.localCenterMinExtent.y, sim.localCenterMinExtent.z, sim.localCenterMinExtent.w)
                || !r.readVec4F(bytes, sim.rotation0.x, sim.rotation0.y, sim.rotation0.z, sim.rotation0.w)
                || !r.readVec4F(bytes, sim.center0MaxExtent.x, sim.center0MaxExtent.y, sim.center0MaxExtent.z, sim.center0MaxExtent.w)
                || !r.readVec4F(bytes, sim.forceLinearDamping.x, sim.forceLinearDamping.y, sim.forceLinearDamping.z, sim.forceLinearDamping.w)
                || !r.readVec4F(bytes, sim.torqueAngularDamping.x, sim.torqueAngularDamping.y, sim.torqueAngularDamping.z, sim.torqueAngularDamping.w)
                || !r.readSymMat3(bytes, sim.invInertiaLocal)
                || !r.readSymMat3(bytes, sim.invInertiaWorld)
                || !r.readF32(bytes, sim.gravityScale)
                || !r.readU32(bytes, sim.flags)
                || !r.readU32(bytes, sim.bodyId)
                || !r.readF32(bytes, sim.maxAngularVelocity)
            )
                return false;
        }
        u32 stC = 0u;
        if(!r.readCount(bytes, 48u, stC))
            return false;
        ss.states.resize(stC);
        for(u32 k = 0u; k < stC; ++k){
            mut BodyState st = ss.states[k];
            if(
                !r.readVec4F(bytes, st.linearVelocity.x, st.linearVelocity.y, st.linearVelocity.z, st.linearVelocity.w)
                || !r.readVec4F(bytes, st.angularVelocity.x, st.angularVelocity.y, st.angularVelocity.z, st.angularVelocity.w)
                || !r.readVec3U32F(bytes, st.deltaPositionFlags.x, st.deltaPositionFlags.y, st.deltaPositionFlags.z, st.deltaPositionFlags.w)
                || !r.readVec4F(bytes, st.deltaRotation.x, st.deltaRotation.y, st.deltaRotation.z, st.deltaRotation.w)
            )
                return false;
        }
        if(!SnapshotReadU32Vec(bytes, r, ss.islands))
            return false;
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeSolverSetIds))
        return false;

    u32 islandCount = 0u;
    if(!r.readCount(bytes, 16u, islandCount))
        return false;
    tmp.m_islands.resize(islandCount);
    for(u32 i = 0u; i < islandCount; ++i){
        mut Island isl = tmp.m_islands[i];
        if(
            !r.readU32(bytes, isl.setIndex)
            || !r.readU32(bytes, isl.localIndex)
            || !r.readU32(bytes, isl.islandId)
            || !r.readU32(bytes, isl.constraintRemoveCount)
            || !r.readB8(bytes, isl.alive)
            || !SnapshotReadU32Vec(bytes, r, isl.bodies)
        )
            return false;
        u32 cc = 0u;
        if(!r.readCount(bytes, 12u, cc))
            return false;
        isl.contacts.resize(cc);
        for(u32 k = 0u; k < cc; ++k){
            if(!r.readU32(bytes, isl.contacts[k].contactId) || !r.readU32(bytes, isl.contacts[k].bodyIdA) || !r.readU32(bytes, isl.contacts[k].bodyIdB))
                return false;
        }
        u32 jc = 0u;
        if(!r.readCount(bytes, 12u, jc))
            return false;
        isl.joints.resize(jc);
        for(u32 k = 0u; k < jc; ++k){
            if(!r.readU32(bytes, isl.joints[k].jointId) || !r.readU32(bytes, isl.joints[k].bodyIdA) || !r.readU32(bytes, isl.joints[k].bodyIdB))
                return false;
        }
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeIslandIds))
        return false;

    for(usize c = 0u; c < s_GraphColorCount; ++c){
        if(!SnapshotReadU32Vec(bytes, r, tmp.m_graph.colors[c].contactIds))
            return false;
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_graph.bodyColorMasks))
        return false;

    for(usize t = 0u; t < s_TreeCount; ++t){
        u32 tRoot = s_NullIndex;
        u32 tFreeList = s_NullIndex;
        u32 tNodeCount = 0u;
        if(!r.readU32(bytes, tRoot) || !r.readU32(bytes, tFreeList) || !r.readU32(bytes, tNodeCount))
            return false;
        u32 nCount = 0u;
        if(!r.readCount(bytes, 44u, nCount))
            return false;
        Vector<TreeNode> tNodes;
        tNodes.resize(nCount);
        for(u32 k = 0u; k < nCount; ++k){
            mut TreeNode n = tNodes[k];
            if(
                !r.readVec3U32F(bytes, n.aabbMinUser.x, n.aabbMinUser.y, n.aabbMinUser.z, n.aabbMinUser.w)
                || !r.readVec3U32F(bytes, n.aabbMaxCategory.x, n.aabbMaxCategory.y, n.aabbMaxCategory.z, n.aabbMaxCategory.w)
                || !r.readU32(bytes, n.parentOrNext)
                || !r.readU32(bytes, n.child1)
                || !r.readU32(bytes, n.child2)
                || !r.readI16(bytes, n.height)
                || !r.readB8(bytes, n.moved)
                || !r.readU8(bytes, n.nodeFlags)
            )
                return false;
        }
        Vector<u32> tMoveIndices;
        if(!SnapshotReadU32Vec(bytes, r, tMoveIndices))
            return false;
        if(tNodes.size() != tMoveIndices.size())
            return false;
        if(tRoot != s_NullIndex && tRoot >= tNodes.size())
            return false;
        if(tFreeList != s_NullIndex && tFreeList >= tNodes.size())
            return false;
        tmp.m_broadPhase.trees[t].restoreState(tNodes, tMoveIndices, tRoot, tFreeList, tNodeCount);
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_broadPhase.moveArray))
        return false;

    if(r.cursor != payloadEnd)
        return false;

    tmp.m_pairContactMap.clear();
    for(usize i = 0u; i < tmp.m_contacts.size(); ++i){
        in Contact c = tmp.m_contacts[i];
        if((c.flags & cast<u32>(ContactFlags::Alive)) != 0u)
            tmp.m_pairContactMap.emplace(c.pairKey, c.contactId);
    }

    tmp.m_customFilterCallback = world.m_customFilterCallback;
    tmp.m_preSolveCallback = world.m_preSolveCallback;
    tmp.m_materialCombineCallback = world.m_materialCombineCallback;
    tmp.m_inStep = false;
    world = tmp;
    return true;
}

u64 ComputePhysicsWorldStateHash(in PhysicsWorld world){
    Vector<u8> bytes;
    if(!SerializePhysicsWorldSnapshot(world, bytes) || bytes.size() < 8u)
        return 0u;
    SnapshotByteReader r;
    r.cursor = bytes.size() - 8u;
    r.limit = bytes.size();
    u64 hash = 0u;
    r.readU64(Span<u8>(bytes.data(), bytes.size()), hash);
    return hash;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
