using PopupToolsFixture = ::NWB::UiPopupToolsTests::PopupToolsFixture;
using ContextMenuResult = ::NWB::Impl::Ui::ContextMenuResult;
using IEditActionSink = ::NWB::Impl::Ui::IEditActionSink;
using EditCommandResult = ::NWB::Impl::Ui::EditCommandResult;
namespace EditAction = ::NWB::Impl::Ui::EditAction;
namespace EditTextMode = ::NWB::Impl::Ui::EditTextMode;
using ::NWB::Impl::Ui::ApplyEditCommand;
using ::NWB::Impl::Ui::TranslateEditCommand;
using ::NWB::UiPopupToolsTests::s_PopupToolsPanelKey;
using ::NWB::UiPopupToolsTests::s_AnchorKey;
using ::NWB::UiPopupToolsTests::s_TooltipKey;
using ::NWB::UiPopupToolsTests::s_MenuKey;

void ExpectNumericEditRejected(const NumericEditResult& result, b8 restored)noexcept;
PopupOptions MakePopupTooltipFixtureOptions()noexcept;
b8 ApplyNumericHostEvent(const NumericEvent& event, const EditBoxOptions& options, EditModel& draft, IEditActionSink& sink, EditBoxResult& result)noexcept;
StringView FormatPopupToolsRowLabel(u64 count, u64 index)noexcept;
void SetUpPopupToolsFixture(PopupToolsFixture& self)noexcept;
b8 DeclarePopupToolsFixture(PopupToolsFixture& self, u64 generation, b8 tooltip, b8 menu, const Rect& bounds)noexcept;
