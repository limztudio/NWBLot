const StringView s_QualifyOption = "--qualify";
const StringView s_BenchCopyOption = "--bench-copy";
const StringView s_BenchEqualityOption = "--bench-equality";
const StringView s_BenchEqualityFirstWordOption = "--bench-equality-first-word";
const usize s_StreamingBytes = 67108864u;
const u8 s_PoisonByte = 0xA5u;
const usize s_QualifyLengthCount = 36u;
const usize s_BenchLengthCount = 15u;
const usize s_EqualityIterations = 4194304u;
const usize s_U64ByteSize = 8u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize QualifyLengthAt(in usize index){
    switch(index){
    case 0u: return 0u;
    case 1u: return 1u;
    case 2u: return 2u;
    case 3u: return 3u;
    case 4u: return 7u;
    case 5u: return 8u;
    case 6u: return 9u;
    case 7u: return 15u;
    case 8u: return 16u;
    case 9u: return 17u;
    case 10u: return 31u;
    case 11u: return 32u;
    case 12u: return 33u;
    case 13u: return 47u;
    case 14u: return 48u;
    case 15u: return 49u;
    case 16u: return 63u;
    case 17u: return 64u;
    case 18u: return 65u;
    case 19u: return 127u;
    case 20u: return 128u;
    case 21u: return 129u;
    case 22u: return 255u;
    case 23u: return 256u;
    case 24u: return 257u;
    case 25u: return 511u;
    case 26u: return 512u;
    case 27u: return 513u;
    case 28u: return 4095u;
    case 29u: return 4096u;
    case 30u: return 4097u;
    case 31u: return 5120u;
    case 32u: return 8191u;
    case 33u: return 8192u;
    case 34u: return 8193u;
    default: return 16384u;
    }
}

usize BenchLengthAt(in usize index){
    switch(index){
    case 0u: return 16u;
    case 1u: return 31u;
    case 2u: return 32u;
    case 3u: return 33u;
    case 4u: return 64u;
    case 5u: return 128u;
    case 6u: return 129u;
    case 7u: return 256u;
    case 8u: return 512u;
    case 9u: return 1024u;
    case 10u: return 2048u;
    case 11u: return 4096u;
    case 12u: return 5120u;
    case 13u: return 8191u;
    default: return 8192u;
    }
}

StringView ResolveEqualityCaseName(in b8 firstWord, in usize comparisonCase){
    if(firstWord){
        switch(comparisonCase){
        case 0u: return "equal";
        case 1u: return "word0_mismatch";
        case 2u: return "word1_mismatch";
        case 3u: return "word2_mismatch";
        default: return "word3_mismatch";
        }
    }
    if(comparisonCase == 0u)
        return "equal";
    if(comparisonCase == 1u)
        return "early_mismatch";
    return "late_mismatch";
}

void WriteProbeStdoutFlush(in StringView text){
    ConsoleWrite(text);
    FlushProbeStdout();
}

b8 CheckCopiedRange(in Span<u8> bytes, in usize start, in usize count, in usize sourceStart){
    for(usize index = 0u; index < bytes.size(); ++index){
        u8 expected = s_PoisonByte;
        if(index >= start && index - start < count)
            expected = PatternByte(sourceStart + index - start);
        if(bytes[index] != expected)
            return false;
    }
    return true;
}

b8 QualifyCopyBytes(){
    const usize bytes = 16640u;
    AlignedProbeBytes source(bytes);
    AlignedProbeBytes destination(bytes);
    for(usize index = 0u; index < bytes; ++index)
        StoreByte(source.data(), index, PatternByte(index));
    for(usize length = 0u; length < s_QualifyLengthCount; ++length){
        const usize count = QualifyLengthAt(length);
        for(usize sourceOffset = 0u; sourceOffset < 128u; sourceOffset += 16u){
            for(usize destinationOffset = 0u; destinationOffset < 128u; destinationOffset += 16u){
                FillTestBytes(destination.data(), s_PoisonByte, bytes);
                CandidateCopy<0u>(GuardAddress(source.data(), sourceOffset), count, count, GuardAddress(destination.data(), destinationOffset));
                if(!CheckCopiedRange(ProbeByteSpan(destination.data(), bytes), destinationOffset, count, sourceOffset))
                    return false;
            }
        }
    }
    for(usize index = 0u; index < bytes; ++index){
        if(LoadByte(source.data(), index) != PatternByte(index))
            return false;
    }
    const Array<usize, 6u> sizes(16u, 32u, 48u, 64u, 128u, 4096u);
    const Array<b8, 2u> directions(false, true);
    for(in usize count : sizes){
        for(in b8 destinationFirst : directions){
            for(usize index = 0u; index < bytes; ++index)
                StoreByte(destination.data(), index, PatternByte(index));
            usize dst = count;
            usize src = 0u;
            if(destinationFirst){
                dst = 0u;
                src = count;
            }
            CandidateCopy<0u>(GuardAddress(destination.data(), src), count, count, GuardAddress(destination.data(), dst));
            for(usize index = 0u; index < count; ++index){
                if(LoadByte(destination.data(), dst + index) != PatternByte(src + index))
                    return false;
            }
        }
    }
    CandidateCopy<0u>(ReadAddress(), 0u, 0u, ByteAddress());
    CandidateCopy<0u>(GuardAddress(source.data(), 3u), 0u, 0u, GuardAddress(destination.data(), 1u));
    return true;
}

b8 RejectedBeforeAccess(in ByteAddress source, in usize count, in usize capacity, in ByteAddress destination){
    const i32 child = ForkTestChild();
    if(child < 0)
        return false;
    if(child == 0){
        if(!SetSignalHandler(ProcessSignal::Abort, lambda[](in i32 signalNumber) -> void{ ExitOnAbort(signalNumber); }))
            ExitImmediately(s_SIMDMemoryHandlerFailureExitCode);
        CandidateCopy<0u>(source, count, capacity, destination);
        ExitImmediately(s_SIMDMemoryReturnedExitCode);
    }
    const ChildWaitResult status = WaitForTestChild(child);
    return status.collected && status.exited && status.exitCode == s_SIMDMemoryAbortExitCode;
}

b8 QualifyProtectedRanges(){
    if(!s_IsLinuxPlatform)
        return true;
    GuardedBytes source;
    GuardedBytes destination;
    if(!HasByteAddress(source.data) || !HasByteAddress(destination.data) || source.accessibleBytes < QualifyLengthAt(s_QualifyLengthCount - 1u))
        return false;
    for(usize index = 0u; index < source.accessibleBytes; ++index)
        StoreByte(source.data, index, PatternByte(index));
    const Array<b8, 2u> directions(false, true);
    for(usize length = 0u; length < s_QualifyLengthCount; ++length){
        const usize count = QualifyLengthAt(length);
        for(in b8 sourceAtEnd : directions){
            for(in b8 destinationAtEnd : directions){
                FillTestBytes(destination.data, s_PoisonByte, destination.accessibleBytes);
                usize src = 0u;
                usize dst = 0u;
                if(sourceAtEnd)
                    src = (source.accessibleBytes - count) & ~cast<usize>(15u);
                if(destinationAtEnd)
                    dst = (destination.accessibleBytes - count) & ~cast<usize>(15u);
                CandidateCopy<0u>(GuardAddress(source.data, src), count, count, GuardAddress(destination.data, dst));
                if(!CheckCopiedRange(ProbeByteSpan(destination.data, destination.accessibleBytes), dst, count, src))
                    return false;
            }
        }
    }
    for(in b8 sourceAtEnd : directions){
        for(in b8 destinationAtEnd : directions){
            usize src = 0u;
            usize dst = 0u;
            if(sourceAtEnd)
                src = source.accessibleBytes - 32u;
            if(destinationAtEnd)
                dst = destination.accessibleBytes - 32u;
            const ByteAddress left = BeginProbeWords(GuardAddress(source.data, src), 4u);
            const ByteAddress right = BeginProbeWords(GuardAddress(destination.data, dst), 4u);
            for(usize lane = 0u; lane < 4u; ++lane){
                ProbeWord(left, lane) = 0x7FF0000000000001ull + lane;
                ProbeWord(right, lane) = ProbeWord(left, lane);
            }
            if(!CandidateEqual<4u>(left, right) || !CandidateEqualFirstWord<4u>(left, right))
                return false;
            ProbeWord(right, 3u) ^= 1u;
            if(CandidateEqual<4u>(left, right) || CandidateEqualFirstWord<4u>(left, right))
                return false;
        }
    }
    CandidateCopy<0u>(destination.upperGuard, 0u, 0u, source.lowerGuard);
    const ByteAddress lower = destination.lowerGuard;
    const ByteAddress upper = source.upperGuard;
    if(!RejectedBeforeAccess(upper, 16u, 15u, lower)
        || !RejectedBeforeAccess(upper, 16u, 16u, ByteAddress())
        || !RejectedBeforeAccess(ByteAddress(), 16u, 16u, lower)
        || !RejectedBeforeAccess(lower, 32u, 32u, lower)
        || !RejectedBeforeAccess(GuardAddress(lower, 16u), 32u, 32u, lower)
        || !RejectedBeforeAccess(lower, 32u, 32u, GuardAddress(lower, 16u)))
        return false;
    for(usize offset = 1u; offset < 16u; ++offset){
        if(!RejectedBeforeAccess(upper, 16u, 16u, GuardAddress(lower, offset)) || !RejectedBeforeAccess(GuardAddress(upper, offset), 16u, 16u, lower))
            return false;
    }
    return true;
}

b8 QualifyEquality(){
    const auto original = HoldFloatingPointExceptions();
    if(!original.has_value())
        return false;
    AlignedProbeBytes leftStorage(64u);
    AlignedProbeBytes rightStorage(64u);
    const ByteAddress left = BeginProbeWords(leftStorage.data(), 8u);
    const ByteAddress right = BeginProbeWords(rightStorage.data(), 8u);
    const Array<u64, 6u> patterns(0u, u64.max, 0x8000000000000000ull, 0x7FF0000000000001ull, 1u, 0x0123456789ABCDEFull);
    b8 valid = true;
    for(in u64 pattern : patterns){
        for(usize offset = 0u; offset < 4u; ++offset){
            const ByteAddress lhs = GuardAddress(left, 8u * offset);
            const ByteAddress rhs = GuardAddress(right, 8u * offset);
            for(usize lane = 0u; lane < 4u; ++lane){
                ProbeWord(lhs, lane) = pattern ^ cast<u64>(lane);
                ProbeWord(rhs, lane) = ProbeWord(lhs, lane);
            }
            if(!CandidateEqual<4u>(lhs, rhs) || !CandidateEqualFirstWord<4u>(lhs, rhs))
                valid = false;
            for(usize lane = 0u; lane < 4u; ++lane){
                for(u32 bit = 0u; bit < 64u; ++bit){
                    ProbeWord(rhs, lane) ^= 1ull << bit;
                    if(CandidateEqual<4u>(lhs, rhs) || CandidateEqualFirstWord<4u>(lhs, rhs) || BaselineEqual<4u>(lhs, rhs))
                        valid = false;
                    ProbeWord(rhs, lane) ^= 1ull << bit;
                }
            }
        }
    }
    if(TestFloatingPointExceptions(FE_ALL_EXCEPT) != 0 || !RaiseFloatingPointExceptions(FE_DIVBYZERO).has_value())
        valid = false;
    const auto wide = lambda[](in ByteAddress lhs, in ByteAddress rhs) -> b8{ return CandidateEqual<4u>(lhs, rhs); };
    const auto first = lambda[](in ByteAddress lhs, in ByteAddress rhs) -> b8{ return CandidateEqualFirstWord<4u>(lhs, rhs); };
    const b8 wideEqual = OpaqueProbeEquality(wide, left, right);
    const i32 wideFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    const b8 firstEqual = OpaqueProbeEquality(first, left, right);
    const i32 firstFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    if(!wideEqual || !firstEqual || wideFlags != FE_DIVBYZERO || firstFlags != FE_DIVBYZERO)
        valid = false;
    if(!SetFloatingPointEnvironment(original.value()).has_value())
        valid = false;
    return valid;
}

void BenchMemoryCopy(in usize samples){
    ConsoleWrite("kind,cache,bytes,source_offset,destination_offset,sample,baseline_ns,candidate_ns,candidate_over_baseline\n");
    Array<b8, 2> streamingModes;
    streamingModes[0] = false;
    streamingModes[1] = true;
    Array<usize, 2> offsets;
    offsets[0] = 16u;
    offsets[1] = 32u;
    for(usize modeIndex = 0u; modeIndex < streamingModes.size(); ++modeIndex){
        const b8 streaming = streamingModes[modeIndex];
        StringView cacheLabel = "warm";
        if(streaming)
            cacheLabel = "streaming";
        for(usize lenIndex = 0u; lenIndex < s_BenchLengthCount; ++lenIndex){
            const usize bytes = BenchLengthAt(lenIndex);
            const usize stride = (bytes + 127u) & ~cast<usize>(63u);
            usize slots = 1u;
            if(streaming)
                slots = s_StreamingBytes / stride;
            usize iterations = s_StreamingBytes / bytes;
            if(iterations < 65536u)
                iterations = 65536u;
            StringView kindLabel = "copy_dynamic";
            if(bytes == 5120u)
                kindLabel = "copy_fixed";
            MemoryCopyBenchmarkBuffers buffers = MemoryCopyBenchmarkBuffers(slots, stride, s_PoisonByte);
            for(usize srcIdx = 0u; srcIdx < offsets.size(); ++srcIdx){
                const usize sourceOffset = offsets[srcIdx];
                for(usize dstIdx = 0u; dstIdx < offsets.size(); ++dstIdx){
                    const usize destinationOffset = offsets[dstIdx];
                    buffers.warmup(bytes, sourceOffset, destinationOffset);
                    for(usize sample = 0u; sample < samples; ++sample){
                        f64 baselineNs = 0.0;
                        f64 candidateNs = 0.0;
                        if((sample & 1u) == 0u){
                            baselineNs = buffers.timeSample(false, bytes, sourceOffset, destinationOffset, iterations);
                            candidateNs = buffers.timeSample(true, bytes, sourceOffset, destinationOffset, iterations);
                        }
                        else{
                            candidateNs = buffers.timeSample(true, bytes, sourceOffset, destinationOffset, iterations);
                            baselineNs = buffers.timeSample(false, bytes, sourceOffset, destinationOffset, iterations);
                        }
                        const f64 candidateOverBaseline = candidateNs / baselineNs;
                        WriteProbeStdoutFlush(StringFormat(
                            "{},{},{},{},{},{},{},{},{}\n",
                            kindLabel,
                            cacheLabel,
                            bytes,
                            sourceOffset,
                            destinationOffset,
                            sample,
                            baselineNs,
                            candidateNs,
                            candidateOverBaseline
                        ));
                    }
                }
            }
        }
    }
}

void BenchMemoryEquality(in usize samples, in b8 firstWord){
    ConsoleWrite("kind,cache,case,offset,sample,baseline_ns,candidate_ns,candidate_over_baseline\n");
    usize caseCount = 3u;
    if(firstWord)
        caseCount = 5u;
    Array<b8, 2> streamingModes;
    streamingModes[0] = false;
    streamingModes[1] = true;
    for(usize modeIndex = 0u; modeIndex < streamingModes.size(); ++modeIndex){
        const b8 streaming = streamingModes[modeIndex];
        usize slots = 1u;
        if(streaming)
            slots = s_StreamingBytes / 64u;
        StringView cacheLabel = "warm";
        if(streaming)
            cacheLabel = "streaming";
        MemoryEqualityBenchmarkBuffers buffers = MemoryEqualityBenchmarkBuffers(slots);
        for(usize comparisonCase = 0u; comparisonCase < caseCount; ++comparisonCase){
            const StringView caseName = ResolveEqualityCaseName(firstWord, comparisonCase);
            for(usize offset = 0u; offset < 4u; ++offset){
                buffers.prepareAndWarmup(firstWord, comparisonCase, offset);
                for(usize sample = 0u; sample < samples; ++sample){
                    f64 baselineNs = 0.0;
                    f64 candidateNs = 0.0;
                    if((sample & 1u) == 0u){
                        baselineNs = buffers.timeSample(false, firstWord, offset, s_EqualityIterations);
                        candidateNs = buffers.timeSample(true, firstWord, offset, s_EqualityIterations);
                    }
                    else{
                        candidateNs = buffers.timeSample(true, firstWord, offset, s_EqualityIterations);
                        baselineNs = buffers.timeSample(false, firstWord, offset, s_EqualityIterations);
                    }
                    const f64 candidateOverBaseline = candidateNs / baselineNs;
                    WriteProbeStdoutFlush(StringFormat(
                        "equality,{},{},{},{},{},{},{}\n",
                        cacheLabel,
                        caseName,
                        offset * s_U64ByteSize,
                        sample,
                        baselineNs,
                        candidateNs,
                        candidateOverBaseline
                    ));
                }
            }
        }
    }
}

i32 RunMemoryStorageProbeCli(in Span<StringView> args){
    StringView option = "";
    if(args.size() >= 2u)
        option = args[1];
    if(option != s_QualifyOption && option != s_BenchCopyOption && option != s_BenchEqualityOption && option != s_BenchEqualityFirstWordOption){
        ConsoleWriteError("usage: memory_storage_probe --qualify|--bench-copy|--bench-equality|--bench-equality-first-word [samples]\n");
        return 2;
    }
    if(!QualifyCopyBytes() || !QualifyEquality()){
        ConsoleWriteError("byte/equality qualification failed\n");
        return 1;
    }
    if(!QualifyProtectedRanges()){
        ConsoleWriteError("protected-range qualification failed\n");
        return 1;
    }
    if(option == s_QualifyOption){
        ConsoleWrite("qualification passed: exact bytes/tails, adjacent ranges, page boundaries, admission, integer bits and FENV\n");
        return 0;
    }
    usize samples = 7u;
    if(args.size() >= 3u){
        const Expected<u64> parsedSamples = ParseU64(args[2]);
        if(!parsedSamples.has_value() || parsedSamples.value() == 0u || parsedSamples.value() > 100u)
            return 2;
        samples = cast<usize>(parsedSamples.value());
    }
    if(option == s_BenchCopyOption)
        BenchMemoryCopy(samples);
    else
        BenchMemoryEquality(samples, option == s_BenchEqualityFirstWordOption);
    return 0;
}


