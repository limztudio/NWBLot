void VerifyShadowMaterialContext_TypedByteCountPreservesAlignmentAndWrapping(){
    const usize maximum = usize.max;
    EXPECT_EQ(ResolveMaterialTypedBufferByteCount(0u, 4u), 4u);
    EXPECT_EQ(ResolveMaterialTypedBufferByteCount(5u, 4u), 8u);
    EXPECT_EQ(ResolveMaterialTypedBufferByteCount(maximum - 3u, 4u), maximum - 3u);
    EXPECT_EQ(ResolveMaterialTypedBufferByteCount(maximum - 2u, 4u), 0u);
    EXPECT_EQ(ResolveMaterialTypedBufferByteCount(maximum, 4u), 0u);
}

void VerifyShadowMaterialContext_RetainedPayloadUsesActualInstanceStrideAndRejectsTruncation(){
    CapturingLogger logger = CapturingLogger();
    const LoggerRegistrationGuard loggerGuard = LoggerRegistrationGuard(logger, LoggerBreakPolicy::ReportOnly);
    native{
        Core::Alloc::GlobalArena arena{ Name(s_EcsCaseTestsShadowMaterialContext) };
        const Array<Impl::NwbRtInstanceMaterialGpu, 2> materials{};
        const Array<Impl::InstanceGpuData, 2> instances{};
        const Array<u8, 4> typed{ 1u, 2u, 3u, 4u };
        Vector<u8, Core::Alloc::GlobalArena> materialBytes(arena);
        Vector<u8, Core::Alloc::GlobalArena> instanceBytes(arena);
        Vector<u8, Core::Alloc::GlobalArena> typedBytes(arena);
        Impl::ShadowMaterialContextPolicy().captureBytes(
            Span<const Impl::NwbRtInstanceMaterialGpu>(materials.data(), materials.size()),
            Span<const Impl::InstanceGpuData>(instances.data(), instances.size()),
            Span<const u8>(typed.data(), typed.size()),
            materialBytes,
            instanceBytes,
            typedBytes
        );
        EXPECT_EQ(instanceBytes.size(), instances.size() * sizeof(Impl::InstanceGpuData));
        const auto validate = [&](const usize materialSize, const usize instanceSize, const usize typedSize)noexcept{
            return Impl::ShadowMaterialContextPolicy().validateRetainState(
                Impl::PreparedShadowMaterialContextRoute::Hardware,
                materials.size(),
                instances.size(),
                typed.size(),
                true,
                materials.size(),
                materials.size(),
                instances.size(),
                instances.size(),
                typed.size(),
                typed.size(),
                true,
                true,
                false,
                false,
                0u,
                0u,
                0u,
                materialSize,
                instanceSize,
                typedSize
            );
        };
        EXPECT_TRUE(validate(materialBytes.size(), instanceBytes.size(), typedBytes.size()));
        EXPECT_FALSE(validate(materialBytes.size() - 1u, instanceBytes.size(), typedBytes.size()));
        EXPECT_FALSE(validate(materialBytes.size(), instanceBytes.size() - 1u, typedBytes.size()));
        EXPECT_FALSE(validate(materialBytes.size(), instanceBytes.size(), typedBytes.size() - 1u));
    }
    EXPECT_EQ(logger.errorCount(), 3u);
}

void VerifyShadowQualitySettings_WrappingReceiverExtentPreservesOverflowAndZeroGroupBehavior(){
    EXPECT_EQ(ResolveWrappingRayTracingDispatchGroup(11u, 2u, 4u), 2u);
    EXPECT_EQ(ResolveWrappingRayTracingDispatchGroup(9u, 2u, 4u), 2u);
    EXPECT_EQ(ResolveWrappingRayTracingDispatchGroup(u32.max, 2u, 4u), 0u);
    EXPECT_EQ(ResolveWrappingRayTracingDispatchGroup(0u, 2u, 4u), 0u);
    EXPECT_EQ(ResolveWrappingRayTracingDispatchGroup(11u, 2u, 0u), 0u);
}

void VerifyShadowQualitySettings_UnknownModesAreRejectedAndCannotRemoveAllSamples(){
    ShadowQualitySettings settings = ShadowQualitySettings();
    settings.transparentSampling = cast<TransparentShadowSamplingEnum>(2u);
    EXPECT_FALSE(ValidateShadowQualitySettings(settings));
    EXPECT_EQ(ResolveTransparentShadowSampleCount(settings, true), 3u);
    settings.transparentSampling = cast<TransparentShadowSamplingEnum>(255u);
    EXPECT_FALSE(ValidateShadowQualitySettings(settings));
    EXPECT_EQ(ResolveTransparentShadowSampleCount(settings, false), 3u);
}

void VerifyShadowQualitySettings_RejectsUnknownReceiverResolution(){
    ShadowQualitySettings settings = ShadowQualitySettings();
    Array<u8, 4> invalidValues = Array<u8, 4>();
    invalidValues[0u] = 0u;
    invalidValues[1u] = 1u;
    invalidValues[2u] = 3u;
    invalidValues[3u] = 255u;
    for(in u8 invalid : invalidValues){
        settings.receiverResolution = cast<ShadowReceiverResolutionEnum>(invalid);
        EXPECT_FALSE(ValidateShadowQualitySettings(settings));
    }
}

void VerifyShadowQualitySettings_RgbHistoryRequiresAcceptedWritesForEveryRequestedSlot(){
    TransparentShadowSamplingHistory history = TransparentShadowSamplingHistory();
    ShadowQualitySettings settings = ShadowQualitySettings();
    settings.transparentSampling = TransparentShadowSampling::TemporalOne;
    EXPECT_FALSE(history.covers(0u));
    EXPECT_EQ(ResolveTransparentShadowSampleCount(settings, history.covers(1u)), 3u);
    history.record(1u);
    EXPECT_FALSE(history.covers(1u));
    history.accept();
    EXPECT_EQ(ResolveTransparentShadowSampleCount(settings, history.covers(1u)), 1u);
    // Existing history for light zero does not initialize a newly assigned shadow slot.
    EXPECT_EQ(ResolveTransparentShadowSampleCount(settings, history.covers(3u)), 3u);
    history.record(3u);
    history.accept();
    EXPECT_EQ(ResolveTransparentShadowSampleCount(settings, history.covers(3u)), 1u);
}

void VerifyShadowQualitySettings_OpaqueOnlyAcceptedFramesInvalidateRgbQualification(){
    TransparentShadowSamplingHistory history = TransparentShadowSamplingHistory();
    history.record(3u);
    history.accept();
    ASSERT_TRUE(history.covers(3u));
    // The shared selector swaps on an opaque-only frame, without any RGB merge being recorded.
    history.accept();
    EXPECT_FALSE(history.covers(1u));
    history.record(3u);
    EXPECT_FALSE(history.covers(3u));
    history.accept();
    EXPECT_TRUE(history.covers(3u));
}

void VerifyShadowQualitySettings_FailedSubmissionsRetainAcceptedFrontButCannotPublishPendingWrites(){
    TransparentShadowSamplingHistory history = TransparentShadowSamplingHistory();
    history.record(1u);
    history.accept();
    history.record(3u);
    history.discardPending();
    EXPECT_TRUE(history.covers(1u));
    EXPECT_FALSE(history.covers(3u));
    history.accept();
    EXPECT_FALSE(history.covers(1u));
    history.record(3u);
    history.reset();
    history.accept();
    EXPECT_FALSE(history.covers(3u));
}

void VerifyShadowVisibilityMergeValidator_CombinedTemporalSelectsOpaqueEvenWhenUpsampleIsCombined(){
    const GpuTaskId opaque = MakeGpuTaskId(1u, 1u);
    const GpuTaskId wavelet = MakeGpuTaskId(1u, 2u);
    const GpuTaskId resolve = MakeGpuTaskId(1u, 3u);
    EXPECT_EQ(SelectOpaqueShadowCompletion(true, true, opaque, wavelet, resolve), opaque);
    EXPECT_EQ(SelectOpaqueShadowCompletion(false, true, opaque, wavelet, resolve), wavelet);
    EXPECT_EQ(SelectOpaqueShadowCompletion(false, false, opaque, wavelet, resolve), resolve);
    EXPECT_FALSE(SelectOpaqueShadowCompletion(true, false, GpuTaskId(), wavelet, resolve).valid());
}

void VerifyShadowVisibilityMergeValidator_FusionOmitsOnlyOpaqueUpsampleAndKeepsOptionalTemporalMerge(){
    Array<b8, 2> flags = Array<b8, 2>();
    flags[0u] = false;
    flags[1u] = true;
    for(in b8 temporalMerge : flags){
        ShadowPacketPlan fixture = ShadowPacketPlan();
        ASSERT_TRUE(fixture.build(true, temporalMerge));
        EXPECT_FALSE(fixture.tasks.opaqueResolve.valid());
        EXPECT_EQ(fixture.tasks.transparentTemporalMerge.valid(), temporalMerge);
        EXPECT_TRUE(fixture.sharesPacket(fixture.tasks));

        PreparedShadowVisibilityTasks ordinary = fixture.tasks;
        ordinary.combinedUpsample = false;
        EXPECT_FALSE(fixture.sharesPacket(ordinary));
    }
}

void VerifyShadowVisibilityMergeValidator_SeparateRouteRequiresItsOpaqueUpsample(){
    Array<b8, 2> flags = Array<b8, 2>();
    flags[0u] = false;
    flags[1u] = true;
    for(in b8 temporalMerge : flags){
        ShadowPacketPlan fixture = ShadowPacketPlan();
        ASSERT_TRUE(fixture.build(false, temporalMerge));
        EXPECT_TRUE(fixture.sharesPacket(fixture.tasks));

        PreparedShadowVisibilityTasks unexpectedTail = fixture.tasks;
        unexpectedTail.combinedUpsample = true;
        EXPECT_FALSE(fixture.sharesPacket(unexpectedTail));
        PreparedShadowVisibilityTasks missingTail = fixture.tasks;
        missingTail.opaqueResolve = GpuTaskId();
        EXPECT_FALSE(fixture.sharesPacket(missingTail));
    }
}

void VerifyShadowVisibilityMergeValidator_MissingStagesAndForeignGraphIdentitiesCannotProveOneAcceptancePacket(){
    native{
        for(const b8 combined : { false, true }){
            ShadowPacketPlan fixture;
            ShadowPacketPlan foreign;
            ASSERT_TRUE(fixture.build(combined, true));
            ASSERT_TRUE(foreign.build(combined, true));
            const Core::GpuCompiledGraph::ReadView plan(fixture.compiledGraph);
            const Array<Core::GpuTaskId Impl::PreparedShadowVisibilityTasks::*, 4> required = {
                &Impl::PreparedShadowVisibilityTasks::terminal,
                &Impl::PreparedShadowVisibilityTasks::opaqueFirstWavelet,
                &Impl::PreparedShadowVisibilityTasks::transparentTrace,
                &Impl::PreparedShadowVisibilityTasks::transparentFirstWavelet,
            };
            for(const auto member : required){
                Impl::PreparedShadowVisibilityTasks missing = fixture.tasks;
                missing.*member = {};
                EXPECT_FALSE(Impl::PreparedShadowVisibilityTasksSharePacket(plan, missing));
                Impl::PreparedShadowVisibilityTasks stale = fixture.tasks;
                stale.*member = foreign.tasks.*member;
                EXPECT_FALSE(Impl::PreparedShadowVisibilityTasksSharePacket(plan, stale));
            }
            Impl::PreparedShadowVisibilityTasks staleMerge = fixture.tasks;
            staleMerge.transparentTemporalMerge = foreign.tasks.transparentTemporalMerge;
            EXPECT_FALSE(Impl::PreparedShadowVisibilityTasksSharePacket(plan, staleMerge));
        }
    }
}

void VerifyShadowVisibilityMergeValidator_EverySeparateSubmissionBoundaryRejectsThePreparedChain(){
    Array<b8, 2> flags = Array<b8, 2>();
    flags[0u] = false;
    flags[1u] = true;
    for(in b8 combined : flags){
        for(u32 splitStage = 1u; splitStage < 7u; ++splitStage){
            if(combined && splitStage == 2u)
                continue;
            const ScopedTestTrace traceCombined = ScopedTestTrace(combined);
            const ScopedTestTrace traceSplit = ScopedTestTrace(splitStage);
            ShadowPacketPlan fixture = ShadowPacketPlan();
            ASSERT_TRUE(fixture.build(combined, true, splitStage));
            EXPECT_FALSE(fixture.sharesPacket(fixture.tasks));
        }
    }
}

void VerifyShadowVisibilityMergeValidator_TrailingDiagnosticsCannotExportScratchStateFromAnotherAcceptancePacket(){
    Array<b8, 2> flags = Array<b8, 2>();
    flags[0u] = false;
    flags[1u] = true;
    for(in b8 combined : flags){
        {
            ShadowPacketPlan fixture = ShadowPacketPlan();
            ASSERT_TRUE(fixture.build(combined, true, 7u, false, false, true));
            PreparedShadowVisibilityTasks withoutDiagnostics = fixture.tasks;
            withoutDiagnostics.diagnostics = GpuTaskId();
            ASSERT_TRUE(fixture.sharesPacket(withoutDiagnostics));
            EXPECT_FALSE(fixture.sharesPacket(fixture.tasks));
        }
        ShadowPacketPlan merged = ShadowPacketPlan();
        ShadowPacketPlan foreign = ShadowPacketPlan();
        ASSERT_TRUE(merged.build(combined, true, u32.max, false, false, true));
        ASSERT_TRUE(foreign.build(combined, true, u32.max, false, false, true));
        ASSERT_TRUE(merged.sharesPacket(merged.tasks));
        PreparedShadowVisibilityTasks stale = merged.tasks;
        stale.diagnostics = foreign.tasks.diagnostics;
        EXPECT_FALSE(merged.sharesPacket(stale));
    }
}

void VerifyShadowVisibilityMergeValidator_CombinedWaveletRequiresBothTemporalPhasesAndCombinedTerminal(){
    ShadowPacketPlan fixture = ShadowPacketPlan();
    ASSERT_TRUE(fixture.build(true, true, u32.max, true));
    EXPECT_TRUE(fixture.sharesPacket(fixture.tasks));
    PreparedShadowVisibilityTasks missingTemporal = fixture.tasks;
    missingTemporal.transparentTemporalMerge = GpuTaskId();
    EXPECT_FALSE(fixture.sharesPacket(missingTemporal));
    PreparedShadowVisibilityTasks separateTerminal = fixture.tasks;
    separateTerminal.combinedUpsample = false;
    EXPECT_FALSE(fixture.sharesPacket(separateTerminal));
}

void VerifyShadowVisibilityMergeValidator_CombinedWaveletRejectsEveryProducerOrTerminalPacketSplit(){
    Array<u32, 5> stages = Array<u32, 5>();
    stages[0u] = 1u;
    stages[1u] = 3u;
    stages[2u] = 4u;
    stages[3u] = 5u;
    stages[4u] = 6u;
    for(in u32 stage : stages){
        const ScopedTestTrace traceStage = ScopedTestTrace(stage);
        ShadowPacketPlan fixture = ShadowPacketPlan();
        ASSERT_TRUE(fixture.build(true, true, stage, true));
        EXPECT_FALSE(fixture.sharesPacket(fixture.tasks));
    }
}

void VerifyShadowVisibilityMergeValidator_CombinedTemporalOmitsOnlyTheIndependentOpaqueMerge(){
    ShadowPacketPlan fixture = ShadowPacketPlan();
    ASSERT_TRUE(fixture.build(true, true, u32.max, true, true));
    EXPECT_FALSE(fixture.tasks.opaqueFirstWavelet.valid());
    EXPECT_TRUE(fixture.sharesPacket(fixture.tasks));

    PreparedShadowVisibilityTasks separateTemporal = fixture.tasks;
    separateTemporal.combinedTemporal = false;
    EXPECT_FALSE(fixture.sharesPacket(separateTemporal));
    PreparedShadowVisibilityTasks missingMerge = fixture.tasks;
    missingMerge.transparentTemporalMerge = GpuTaskId();
    EXPECT_FALSE(fixture.sharesPacket(missingMerge));
    PreparedShadowVisibilityTasks missingCombinedWavelet = fixture.tasks;
    missingCombinedWavelet.combinedWavelet = false;
    EXPECT_FALSE(fixture.sharesPacket(missingCombinedWavelet));
    PreparedShadowVisibilityTasks duplicateMerge = fixture.tasks;
    duplicateMerge.opaqueFirstWavelet = fixture.tasks.transparentTemporalMerge;
    EXPECT_FALSE(fixture.sharesPacket(duplicateMerge));
}

void VerifyShadowVisibilityMergeValidator_CombinedTemporalRejectsEveryRemainingPacketSplit(){
    Array<u32, 4> stages = Array<u32, 4>();
    stages[0u] = 3u;
    stages[1u] = 4u;
    stages[2u] = 5u;
    stages[3u] = 6u;
    for(in u32 stage : stages){
        const ScopedTestTrace traceStage = ScopedTestTrace(stage);
        ShadowPacketPlan fixture = ShadowPacketPlan();
        ASSERT_TRUE(fixture.build(true, true, stage, true, true));
        EXPECT_FALSE(fixture.sharesPacket(fixture.tasks));
    }
}

void VerifySoftShadowResolveDispatchBuilder_AlternatingHistoryUsesTheNewMomentsAndGraphOwnedBoundaries(){
    DeferredFrameTargets targets = DeferredFrameTargets();
    targets.bindless.shadowHistB = GpuDescriptorHandle(31u);
    targets.bindless.shadowMomentsB = GpuDescriptorHandle(32u);
    targets.bindless.shadowSoftHalfA = GpuDescriptorHandle(33u);
    targets.bindless.transparentHistA = GpuDescriptorHandle(41u);
    targets.bindless.transparentMomentsA = GpuDescriptorHandle(42u);
    OpaqueSoftShadowResolveOptions opaque = OpaqueSoftShadowResolveOptions();
    opaque.frontIsA = true;
    opaque.temporalActive = true;
    opaque.dispatchResolve = true;
    opaque.phase = SoftShadowOpaqueResolvePhase::WaveletOnly;

    SoftShadowResolveDispatch first = SoftShadowResolveDispatch();
    SoftShadowResolveDispatch noHistory = SoftShadowResolveDispatch();
    TransparentSoftShadowResolveOptions transparent = TransparentSoftShadowResolveOptions();
    transparent.frontIsA = false;
    transparent.temporalActive = true;
    transparent.dispatchResolve = true;
    transparent.splitResolve = true;
    SoftShadowResolveDispatch second = SoftShadowResolveDispatch();
    SoftShadowResolveDispatch ownMerge = SoftShadowResolveDispatch();

    native(in targets, mut opaque, mut first, mut noHistory, mut transparent, mut second, mut ownMerge){
        Core::Alloc::GlobalArena arena(s_EcsCaseTestsSoftShadowResolveDispatchBuilder);
        Impl::RendererRayTracingState state(arena);
        first = SoftShadowResolveDispatchBuilder::Opaque(opaque, state, targets);
        opaque.temporalActive = false;
        opaque.phase = SoftShadowOpaqueResolvePhase::TemporalAndWavelet;
        noHistory = SoftShadowResolveDispatchBuilder::Opaque(opaque, state, targets);
        second = SoftShadowResolveDispatchBuilder::Transparent(transparent, state, targets);
        transparent.dispatchTemporalMerge = true;
        ownMerge = SoftShadowResolveDispatchBuilder::Transparent(transparent, state, targets);
    }

    EXPECT_EQ(first.firstWaveletResources.inputColor, 31u);
    EXPECT_EQ(first.firstWaveletResources.moments, 32u);
    EXPECT_TRUE(first.graphOwnsFirstWaveletInputState);
    EXPECT_TRUE(first.graphOwnsWaveletMomentsEntryState);
    EXPECT_TRUE(first.graphOwnsFirstWaveletOutputState);
    EXPECT_FALSE(first.firstWaveletWritesHalfA);
    EXPECT_EQ(first.fold, SoftShadowUpsampleFold::Overwrite);
    EXPECT_EQ(noHistory.firstWaveletResources.inputColor, 33u);
    EXPECT_FALSE(noHistory.graphOwnsFirstWaveletInputState);

    EXPECT_EQ(second.firstWaveletResources.inputColor, 41u);
    EXPECT_EQ(second.firstWaveletResources.moments, 42u);
    EXPECT_TRUE(second.graphOwnsFirstWaveletInputState);
    EXPECT_TRUE(second.graphOwnsWaveletMomentsEntryState);
    EXPECT_TRUE(second.graphOwnsFirstWaveletOutputState);
    EXPECT_TRUE(second.firstWaveletWritesHalfA);
    EXPECT_EQ(second.fold, SoftShadowUpsampleFold::Multiply);
    EXPECT_FALSE(ownMerge.graphOwnsFirstWaveletInputState);
    EXPECT_FALSE(ownMerge.graphOwnsWaveletMomentsEntryState);
}

void VerifySoftShadowWavelet_IndependentFreshTemporalInputsPermitExactlyOneWaveletPerChannel(){
    EXPECT_TRUE(CanCombineSoftShadowWavelets(true, true, true, true, 1u, 1u));
    Array<u32, 4> counts = Array<u32, 4>();
    counts[0u] = 0u;
    counts[1u] = 2u;
    counts[2u] = 3u;
    counts[3u] = 5u;
    for(in u32 count : counts){
        EXPECT_FALSE(CanCombineSoftShadowWavelets(true, true, true, true, count, 1u));
        EXPECT_FALSE(CanCombineSoftShadowWavelets(true, true, true, true, 1u, count));
    }
}

void VerifySoftShadowWavelet_EveryUnpreparedRouteRetainsSeparateWavelets(){
    for(u32 flags = 0u; flags < 16u; ++flags){
        const ScopedTestTrace traceFlags = ScopedTestTrace(flags);
        EXPECT_EQ(CanCombineSoftShadowWavelets((flags & 1u) != 0u, (flags & 2u) != 0u, (flags & 4u) != 0u, (flags & 8u) != 0u, 1u, 1u), flags == 15u);
    }
}

void VerifySoftwareTransparentSampling_OnlyAcceptedCompleteStaticScenePermitsLocalBudgetSelection(){
    SoftwareTransparentSamplingHistory history = SoftwareTransparentSamplingHistory();
    const RayTracingSceneContentStamp scene = MakeRtSceneStamp(10u, 20u, true);
    Array<SceneLightGpuData, 1> lights = Array<SceneLightGpuData, 1>();
    history.prepareScene(scene);
    history.prepareLighting(lights);
    EXPECT_FALSE(history.usable());
    history.accept();
    EXPECT_TRUE(history.usable());
    history.prepareScene(scene);
    EXPECT_FALSE(history.usable());
    history.prepareLighting(lights);
    EXPECT_TRUE(history.usable());
    history.discard();
    EXPECT_FALSE(history.usable());
}

void VerifySoftwareTransparentSampling_MovingCasterWithStationaryReceiverCannotReuseTheReducedBudget(){
    SoftwareTransparentSamplingHistory history = SoftwareTransparentSamplingHistory();
    Array<SceneLightGpuData, 1> lights = Array<SceneLightGpuData, 1>();
    history.prepareScene(MakeRtSceneStamp(10u, 20u, true));
    history.prepareLighting(lights);
    history.accept();
    // No camera/receiver input changes: the caster transform is part of the independently gathered scene identity.
    history.prepareScene(MakeRtSceneStamp(11u, 20u, true));
    history.prepareLighting(lights);
    EXPECT_FALSE(history.usable());
    history.accept();
    EXPECT_TRUE(history.usable());
    history.prepareScene(MakeRtSceneStamp(11u, 21u, true));
    history.prepareLighting(lights);
    EXPECT_FALSE(history.usable());
    history.prepareScene(MakeRtSceneStamp(11u, 20u, false));
    history.prepareLighting(lights);
    history.accept();
    EXPECT_FALSE(history.usable());
}

void VerifySoftwareTransparentSampling_EveryLightInputAndSlotOrderInvalidatesTrust(){
    const RayTracingSceneContentStamp scene = MakeRtSceneStamp(10u, 20u, true);
    Array<SceneLightGpuData, 2> original = Array<SceneLightGpuData, 2>();
    original[1u].direction.x = 0.25f;
    native(in scene, in original){
        constexpr Array<Float4 SceneLightGpuData::*, 5> s_Fields = {
            &SceneLightGpuData::position, &SceneLightGpuData::direction,
            &SceneLightGpuData::colorIntensity, &SceneLightGpuData::params,
            &SceneLightGpuData::params2,
        };
        for(const auto field : s_Fields){
            SoftwareTransparentSamplingHistory history;
            history.prepareScene(scene);
            history.prepareLighting(SceneLightSpan(original.data(), 2u));
            history.accept();
            Array<SceneLightGpuData, 2> changed = { original[0], original[1] };
            Float4& value = changed[0].*field;
            value.x = value.x + 0.125f;
            history.prepareLighting(SceneLightSpan(changed.data(), 2u));
            EXPECT_FALSE(history.usable());
        }
    }
    SoftwareTransparentSamplingHistory history = SoftwareTransparentSamplingHistory();
    history.prepareScene(scene);
    history.prepareLighting(SceneLightSpan(original.data(), 2u));
    history.accept();
    Array<SceneLightGpuData, 2> reversed = Array<SceneLightGpuData, 2>();
    reversed[0u] = original[1u];
    reversed[1u] = original[0u];
    history.prepareLighting(SceneLightSpan(reversed.data(), 2u));
    EXPECT_FALSE(history.usable());
    history.prepareLighting(SceneLightSpan(original.data(), 1u));
    EXPECT_FALSE(history.usable());
}

void VerifySurfelCoverage_EmptyAndSaturatedGatherCoverageStayWithinEndpoints(){
    const f32 full = s_SurfelGatherFullCoverageWeight;
    ASSERT_GT(full, 0.0f);
    EXPECT_FLOAT_EQ(nwbSurfelGatherCoverage(0.0f), 0.0f);
    EXPECT_FLOAT_EQ(nwbSurfelGatherCoverage(full), 1.0f);
    EXPECT_FLOAT_EQ(nwbSurfelGatherCoverage(full * 2.0f), 1.0f);
}

void VerifySurfelCoverage_UpsampleRejectsIncompatibleNormalsAndDistantGeometry(){
    const f32 gate = s_SurfelUpsampleNormalGate;
    EXPECT_TRUE(nwbSurfelUpsampleNormalCompatible(gate));
    EXPECT_FALSE(nwbSurfelUpsampleNormalCompatible(gate - 0.01f));
    EXPECT_FALSE(nwbSurfelUpsampleNormalCompatible(0.0f));

    EXPECT_FLOAT_EQ(nwbSurfelUpsampleGeometryWeight(0.25f, 0.0f, 2.0f), 0.25f);
    EXPECT_LT(nwbSurfelUpsampleGeometryWeight(0.25f, 4.0f, 2.0f), 0.001f);
}

void VerifySurfelCoverage_MissingAndPartialTapsRetainFractionalAlpha(){
    const f32 weight = nwbSurfelUpsampleGeometryWeight(0.25f, 0.0f, 1.0f);
    const f32 partial = nwbSurfelUpsampleCoveredWeight(weight, 0.5f);
    const f32 full = nwbSurfelUpsampleCoveredWeight(weight, 1.0f);
    EXPECT_FLOAT_EQ(partial, 0.125f);
    EXPECT_FLOAT_EQ(full, 0.25f);

    // A fully covered tap and a missing compatible tap have half coverage, not a renormalized 1.0.
    const SurfelCoverageFloat4 result = nwbSurfelUpsampleFinalize(SurfelCoverageFloat3(0.5f, 0.25f, 0.125f), full, weight * 2.0f);
    EXPECT_FLOAT_EQ(result.x, 2.0f);
    EXPECT_FLOAT_EQ(result.y, 1.0f);
    EXPECT_FLOAT_EQ(result.z, 0.5f);
    EXPECT_FLOAT_EQ(result.w, 0.5f);

    const SurfelCoverageFloat4 partialOnly = nwbSurfelUpsampleFinalize(SurfelCoverageFloat3(0.125f, 0.0f, 0.0f), partial, weight);
    EXPECT_FLOAT_EQ(partialOnly.x, 1.0f);
    EXPECT_FLOAT_EQ(partialOnly.w, 0.5f);
}

void VerifySurfelCoverage_EmptyUpsampleWeightRemainsFiniteAndZero(){
    const SurfelCoverageFloat4 empty = nwbSurfelUpsampleFinalize(SurfelCoverageFloat3(0.0f), 0.0f, 1.0f);
    EXPECT_FLOAT_EQ(empty.x, 0.0f);
    EXPECT_FLOAT_EQ(empty.y, 0.0f);
    EXPECT_FLOAT_EQ(empty.z, 0.0f);
    EXPECT_FLOAT_EQ(empty.w, 0.0f);
}

void VerifySurfelGiQualitySettings_ReadbackTokenRequiresMatchingPhysicalQueueIdentity(){
    const QueueSubmissionToken accepted = MakeQueueToken(7u, 2u, 3u, CommandQueue::Compute);
    EXPECT_TRUE(SurfelReadbackSubmissionMatches(accepted, accepted));
    EXPECT_FALSE(SurfelReadbackSubmissionMatches(QueueSubmissionToken(), accepted));
    QueueSubmissionToken candidate = accepted;
    candidate.physicalQueueIndex = 4u;
    EXPECT_FALSE(SurfelReadbackSubmissionMatches(accepted, candidate));
    candidate = accepted;
    candidate.deviceGeneration = 0u;
    EXPECT_FALSE(SurfelReadbackSubmissionMatches(accepted, candidate));
    candidate = accepted;
    candidate.queue = CommandQueue::Graphics;
    EXPECT_FALSE(SurfelReadbackSubmissionMatches(accepted, candidate));
    candidate = accepted;
    candidate.value = 0u;
    EXPECT_FALSE(SurfelReadbackSubmissionMatches(accepted, candidate));
}

void VerifySurfelGiQualitySettings_SpawnGroupsHandleOddZeroAndMaximumExtents(){
    EXPECT_EQ(ResolveSurfelSpawnDispatchGroup(0u, 8u), 0u);
    EXPECT_EQ(ResolveSurfelSpawnDispatchGroup(128u, 8u), 1u);
    EXPECT_EQ(ResolveSurfelSpawnDispatchGroup(129u, 8u), 2u);
    EXPECT_EQ(ResolveSurfelSpawnDispatchGroup(u32.max, 8u), 33554432u);
    EXPECT_EQ(ResolveSurfelSpawnDispatchGroup(129u, 0u), 0u);
}

void VerifySurfelGiQualitySettings_StorageCountsAndResolveExtentsRejectEitherEmptyDimension(){
    EXPECT_FALSE(IsValidSurfelGiStorageCounts(0u, 1u));
    EXPECT_FALSE(IsValidSurfelGiStorageCounts(1u, 0u));
