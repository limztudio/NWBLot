}

void VerifyUiSearchComboBehaviorTests_FullAndViewMetadataCallbacksAreIncludedInTheQueryFence(mut UiSearchComboBehaviorTests self){
    self.m_source.changeQueryOnGeneration.value() = true;
    EXPECT_FALSE(FilterSearchCombo(self.m_state, self.m_source));
    EXPECT_EQ(self.m_state.query().text(), s_UiSearchComboCallbackQuery);
    EXPECT_EQ(self.m_source.filterCalls, 0u);
    ASSERT_TRUE(self.m_state.query().setText("tail"));
    self.m_source.view.changeQueryOnCount.value() = true;
    EXPECT_FALSE(FilterSearchCombo(self.m_state, self.m_source));
    EXPECT_EQ(self.m_state.query().text(), s_UiSearchComboCallbackQuery);
    EXPECT_EQ(self.m_source.filterCalls, 0u);
}


