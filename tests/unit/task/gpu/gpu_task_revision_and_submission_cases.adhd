using GpuSubmissionStorageTestArena = ::NWB::Tests::TestArena<struct TaskGraphStorageTestsTag>;
using GpuSubmissionTimingBindingVector = Core::GraphicsVector<Core::GpuTaskGraphTaskTimingTicket>;
using GpuSubmissionHookBindingVector = Core::GraphicsVector<Core::GpuTaskGraphTaskSubmissionHook>;
using GpuSubmissionBindings = Core::GpuTaskSubmissionDetail::TaskSubmissionBindings;
using GpuSubmissionPacketTickets = Vector<NotNull<Core::GpuTimingSubmissionTicket*>, Core::Alloc::ScratchArena>;
using GpuSubmissionUseIndex = Core::GpuTaskGraphCompilerDetail::TaskResourceUseIndex;
using Core::GpuTaskGraphCompilerDetail::CollectResourceFirstUseRangesWithinTask;
using Core::GpuPacketRuntimeDetail::CountPacketWaitStatistics;

[[nodiscard]] FOUNDATION_INLINE Expected<Core::GpuUploadBlobId> CopyGpuSubmissionUploadBytes(Core::GpuTaskGraph& graph, const Span<const u8> bytes, const usize alignment){
    return graph.copyUploadData(bytes.data(), bytes.size(), alignment);
}

[[nodiscard]] FOUNDATION_INLINE Expected<Core::GpuUploadBlobId> CopyGpuSubmissionUploadU64Pair(Core::GpuTaskGraph& graph, const u64 first, const u64 second){
    const Array<u64, 2u> words = { first, second };
    return graph.copyUploadData(words.data(), sizeof(words), alignof(u64));
}

[[nodiscard]] FOUNDATION_INLINE b8 CopyGpuSubmissionNullUpload(Core::GpuTaskGraph& graph, const usize byteCount, const usize alignment){
    return graph.copyUploadData(nullptr, byteCount, alignment).has_value();
}

[[nodiscard]] FOUNDATION_INLINE b8 MatchesGpuSubmissionUploadU64Pair(
    const Core::GpuTaskGraph::DeclarationReadView& declarations,
    const Core::GpuUploadBlobId uploadId,
    const u64 first,
    const u64 second
)noexcept{
    const auto storedBytes = declarations.uploadBlobData(uploadId);
    const Array<u64, 2u> expectedBytes = { first, second };
    return storedBytes.has_value()
        && storedBytes->size() == sizeof(expectedBytes)
        && FOUNDATION_MEMCMP(storedBytes->data(), expectedBytes.data(), sizeof(expectedBytes)) == 0
    ;
}

struct GpuSubmissionBindingFixture{
public:
    TestArena testArena;
    Core::GpuTaskGraph graph;
    SingleQueueCompile compileState;
    Core::Perf::TimingRecorder timingSink;
    Core::GpuTimingRecorder timingRecorder;
    Core::GraphicsVector<Core::GlobalUniquePtr<Core::GpuTimingSubmissionTicket>> tickets;
    Core::GraphicsVector<Core::GpuTaskId> tasks;
    u32 hookInvocationCount = 0u;


public:
    GpuSubmissionBindingFixture()
        : graph(testArena.arena)
        , compileState(testArena)
        , timingSink(testArena.arena)
        , timingRecorder(testArena.arena, timingSink)
        , tickets(testArena.arena)
        , tasks(testArena.arena)
    {}


public:
    [[nodiscard]] b8 prepare(const usize taskCount, const usize mergeGroupSize = 1u){
        tasks.reserve(taskCount);
        tickets.reserve(taskCount);
        const Core::GpuTaskCommandRequirements commands{ Core::GpuQueueCapability::Graphics };
        for(usize index = 0u; index < taskCount; ++index){
            Core::GpuTaskSchedulingHint scheduling;
            scheduling.mergeWithPrevious = index % mergeGroupSize != 0u;
            const auto derivedNameResult = IndexedName(Name(TaskGraphTestUtils::s_GpuCaseSubmissionBindingsTask), index);
            if(!derivedNameResult)
                return false;
            const auto taskResult = AddTaskWithCommands(
                *derivedNameResult,
                "Submission Binding",
                commands,
                scheduling,
                {},
                scheduling.mergeWithPrevious ? Span<const Core::GpuTaskId>(&tasks.back(), 1u) : Span<const Core::GpuTaskId>{},
                graph
            );
            if(!taskResult)
                return false;
            const Core::GpuTaskId task = *taskResult;
            if(!task.valid())
                return false;
            tasks.push_back(task);
            tickets.push_back(Core::MakeGlobalUnique<Core::GpuTimingSubmissionTicket>(testArena.arena, timingRecorder));
            if(!tickets.back())
                return false;
        }
        return compileState.compile(graph);
    }

    [[nodiscard]] Core::QueueSubmissionPreSubmitHook hook(const u64 identity)noexcept{
        Core::QueueSubmissionPreSubmitHook result;
        result.context = &hookInvocationCount;
        result.identity = identity;
        result.invoke = [](void* const context, u64, const Core::GpuPhysicalQueueId&)noexcept -> Expected<Core::QueueSubmissionNativeSignal>{
            ++*MakeNotNull(static_cast<u32*>(context));
            return MakeUnexpected(Failure{});
        };
        return result;
    }

    [[nodiscard]] Core::GpuTaskGraphTaskTimingTicket makeTimingBinding(const usize taskIndex, const usize ticketIndex)const noexcept{
        return { .task = tasks[taskIndex], .timingTicket = tickets[ticketIndex].get() };
    }

    [[nodiscard]] Core::GpuTaskGraphTaskTimingTicket makeNullTimingBinding(const usize taskIndex)const noexcept{
        return { .task = tasks[taskIndex], .timingTicket = nullptr };
    }

    [[nodiscard]] Core::GpuTaskGraphTaskSubmissionHook makeHookBinding(const usize taskIndex, const u64 identity)noexcept{
        return { .task = tasks[taskIndex], .hook = hook(identity) };
    }

    [[nodiscard]] Core::GpuTaskGraphTaskSubmissionHook makeNullInvokeHookBinding(const usize taskIndex, const u64 identity)noexcept{
        Core::GpuTaskGraphTaskSubmissionHook result{ .task = tasks[taskIndex], .hook = hook(identity) };
        result.hook.invoke = nullptr;
        return result;
    }

    [[nodiscard]] b8 packetTicketMatches(const GpuSubmissionPacketTickets& packetTickets, const usize packetTicketIndex, const usize fixtureTicketIndex)const noexcept{
        return packetTickets[packetTicketIndex].get() == tickets[fixtureTicketIndex].get();
    }

    [[nodiscard]] b8 hookMatchesContext(const Core::QueueSubmissionPreSubmitHook& candidate)const noexcept{
        return candidate.context == &hookInvocationCount;
    }

    [[nodiscard]] b8 validateTicketAt(const GpuSubmissionBindings& resolved, const Core::GpuSubmissionPacketId packet, const usize ticketIndex)const noexcept{
        return resolved.validateOwnedTimingTicket(packet, tickets[ticketIndex].get());
    }
};

[[nodiscard]] FOUNDATION_INLINE b8 ValidateNullOwnedTimingTicket(const GpuSubmissionBindings& resolved, const Core::GpuSubmissionPacketId packet)noexcept{
    return resolved.validateOwnedTimingTicket(packet, nullptr);
}

[[nodiscard]] FOUNDATION_INLINE Optional<Core::QueueSubmissionPreSubmitHook> CollectSubmissionPacketHook(
    const GpuSubmissionBindings& resolved,
    const Core::GpuSubmissionPacketId packet,
    GpuSubmissionPacketTickets& packetTickets
){
    if(const Core::QueueSubmissionPreSubmitHook* const hook = resolved.collectPacket(packet, packetTickets))
        return *hook;
    return {};
}

[[nodiscard]] FOUNDATION_INLINE Span<const Core::GpuTaskGraphTaskTimingTicket> MakeNullTimingBindingSpan(const usize count)noexcept{
    return Span<const Core::GpuTaskGraphTaskTimingTicket>(static_cast<const Core::GpuTaskGraphTaskTimingTicket*>(nullptr), count);
}

[[nodiscard]] FOUNDATION_INLINE Span<const Core::GpuTaskGraphTaskSubmissionHook> MakeNullHookBindingSpan(const usize count)noexcept{
    return Span<const Core::GpuTaskGraphTaskSubmissionHook>(static_cast<const Core::GpuTaskGraphTaskSubmissionHook*>(nullptr), count);
}

[[nodiscard]] FOUNDATION_INLINE b8 TokensBytewiseEqual(
    const Span<const Core::QueueSubmissionToken> lhs,
    const Span<const Core::QueueSubmissionToken> rhs
)noexcept{
    return lhs.size() == rhs.size() && (lhs.empty() || FOUNDATION_MEMCMP(lhs.data(), rhs.data(), lhs.size() * sizeof(Core::QueueSubmissionToken)) == 0);
}

struct GpuSubmissionUseIndexScope{
public:
    Core::Alloc::ScratchArena scratchArena;
    GpuSubmissionUseIndex index;
    ScratchResourceRanges ranges;


public:
    GpuSubmissionUseIndexScope(const usize resourceCount, const u64 generation, const usize useCapacity)
        : scratchArena(s_TaskGraphScratchArena)
        , index(resourceCount, generation, useCapacity, scratchArena)
        , ranges(scratchArena)
    {}
};

[[nodiscard]] FOUNDATION_INLINE Core::GpuTaskGraphTaskView MakeGpuSubmissionTaskView(
    const Span<const Core::GpuTaskResourceUse> uses,
    const u64 generation = 1u,
    const u32 taskIndex = 0u
)noexcept{
    Core::GpuTaskGraphTaskView view{};
    view.id = { .generation = generation, .index = taskIndex };
    view.resourceUses = uses.data();
    view.resourceUseCount = uses.size();
    return view;
}

FOUNDATION_INLINE void SetGpuSubmissionTaskViewUses(Core::GpuTaskGraphTaskView& view, const Span<const Core::GpuTaskResourceUse> uses)noexcept{
    view.resourceUses = uses.data();
}

FOUNDATION_INLINE void ClearGpuSubmissionTaskViewUses(Core::GpuTaskGraphTaskView& view)noexcept{
    view.resourceUses = nullptr;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


