    }
}

void VerifyRuntimeMeshPruning_RequestedIdentitiesKeepFullNameAndVersionAcrossHintedAndGrowingIndices(){
    Array<Name, 40> names = Array<Name, 40>();
    native(mut names){
        for(usize index = 0u; index < 40u; ++index){
            NameHash hash = ComputeNameHash(MakeNotNull("tests/runtime_mesh_pruning/full_identity"));
            hash.qwords[s_NameHashLaneCount - 1u] ^= index + 1u;
            names[index] = Name(hash);
        }
    }
    Array<usize, 2> hints = Array<usize, 2>();
    hints[0u] = 0u;
    hints[1u] = 64u;
    for(in usize capacityHint : hints){
        native(in names, in capacityHint){
            Core::Alloc::ScratchArena scratch{ Name(s_EcsGraphicsCaseTestsRuntimeMeshPruningRequestScratch) };
            RuntimeMeshRequestSet requests(scratch, capacityHint);
            requests.add(s_NameNone, 7u);
            requests.markLive(s_NameNone, 7u);
            EXPECT_TRUE(requests.complete());
            EXPECT_FALSE(requests.containsLive(s_NameNone, 7u));
            for(usize index = 0u; index < 40u; ++index){
                requests.add(names[index], 7u);
                requests.add(names[index], 7u);
                if(index < 16u)
                    requests.markLive(names[index], 7u);
            }
            requests.add(names[0u], 0u);
            requests.add(names[0u], (1ull << 40u) + 7u);
            for(usize index = 0u; index < 40u; ++index){
                EXPECT_EQ(requests.containsLive(names[index], 7u), index < 16u);
                EXPECT_FALSE(requests.containsLive(names[index], 8u));
            }
            requests.markLive(Name(s_EcsGraphicsCaseTestsRuntimeMeshPruningNotRequested), 7u);
            EXPECT_FALSE(requests.complete());
            for(usize index = 0u; index < 40u; ++index){
                requests.markLive(names[index], 7u);
                requests.markLive(names[index], 7u);
            }
            EXPECT_FALSE(requests.complete());
            EXPECT_FALSE(requests.containsLive(names[0u], 0u));
            EXPECT_FALSE(requests.containsLive(names[0u], (1ull << 40u) + 7u));
            requests.markLive(names[0u], (1ull << 40u) + 7u);
            EXPECT_FALSE(requests.complete());
            requests.markLive(names[0u], 0u);
            EXPECT_TRUE(requests.complete());
            requests.add(names[0u], 7u);
            EXPECT_TRUE(requests.complete());
            for(usize index = 0u; index < 40u; ++index)
                EXPECT_TRUE(requests.containsLive(names[index], 7u));
        }
    }
}

void VerifySceneShadingUploads_EmptyLightTransitionInvalidatesThePreviousLightMirror(){
    SceneShadingUploadTracker tracker = SceneShadingUploadTracker();
    Array<u8, 5120> lightBytes = Array<u8, 5120>();
    Array<u8, 16> shadingBytes = Array<u8, 16>();
    u32 lightCount = 0u;
    b8 lightValid = false;
    b8 shadingValid = false;
    SceneShadingGpuData shading = SceneShadingGpuData();
    Array<SceneLightGpuData, 1> light = Array<SceneLightGpuData, 1>();
    const SceneLightSpan empty = SceneLightSpan();
    const SceneLightSpan one = SceneLightSpan(light.data(), light.size());

    EXPECT_FALSE(tracker.lightUploadRequired(lightValid, lightCount, lightBytes, empty));
    EXPECT_TRUE(tracker.shadingUploadRequired(shadingValid, shadingBytes, shading));
    tracker.confirm(empty, false, shading, true, lightBytes, lightCount, lightValid, shadingBytes, shadingValid);
    EXPECT_TRUE(lightValid);
    EXPECT_EQ(lightCount, 0u);
    EXPECT_FALSE(tracker.shadingUploadRequired(shadingValid, shadingBytes, shading));

    ASSERT_TRUE(tracker.lightUploadRequired(lightValid, lightCount, lightBytes, one));
    tracker.confirm(one, true, shading, false, lightBytes, lightCount, lightValid, shadingBytes, shadingValid);
    EXPECT_FALSE(tracker.lightUploadRequired(lightValid, lightCount, lightBytes, one));
    light[0u].position.x = 1.0f;
    EXPECT_TRUE(tracker.lightUploadRequired(lightValid, lightCount, lightBytes, one));
    native(mut tracker, in empty, in shading, mut lightBytes, mut lightCount, mut lightValid, mut shadingBytes, mut shadingValid){
        tracker.confirm(empty, false, shading, false, lightBytes, lightCount, lightValid, shadingBytes, shadingValid);
    }
    EXPECT_EQ(lightCount, 0u);
    EXPECT_TRUE(tracker.lightUploadRequired(lightValid, lightCount, lightBytes, one));
}

void VerifyShadowMaterialContextPolicy_RejectedAndCrossRouteUploadsDoNotAdmitStaleCache(){
    const ShadowMaterialContextPolicy policy = ShadowMaterialContextPolicy();
    u64 hardwareHash = 11u;
    u64 softwareHash = 22u;
    b8 hardwareValid = true;
    b8 softwareValid = true;
    EXPECT_FALSE(policy.publishAcceptedUpload(false, true, PreparedShadowMaterialContextRoute::Hardware, 33u, true, hardwareHash, hardwareValid, softwareHash, softwareValid));
    EXPECT_EQ(hardwareHash, 11u);
    EXPECT_EQ(softwareHash, 22u);
    EXPECT_TRUE(hardwareValid);
    EXPECT_TRUE(softwareValid);
    EXPECT_TRUE(policy.publishAcceptedUpload(true, true, PreparedShadowMaterialContextRoute::Hardware, 33u, true, hardwareHash, hardwareValid, softwareHash, softwareValid));
    EXPECT_EQ(hardwareHash, 33u);
    EXPECT_TRUE(hardwareValid);
    EXPECT_FALSE(softwareValid);
    EXPECT_FALSE(policy.softwareSnapshotCovers(true, PreparedShadowMaterialContextRoute::Hardware, 2u, 2u, 2u));
    EXPECT_FALSE(policy.softwareSnapshotCovers(true, PreparedShadowMaterialContextRoute::Software, 2u, 1u, 2u));
    EXPECT_FALSE(policy.softwareSnapshotAccepted(false, true, false, 22u, 22u, 2u, 2u));
    EXPECT_FALSE(policy.softwareSnapshotAccepted(false, true, true, 22u, 23u, 2u, 2u));
    EXPECT_FALSE(policy.softwareSnapshotAccepted(false, true, true, 22u, 22u, 2u, 3u));
    EXPECT_TRUE(policy.softwareSnapshotAccepted(false, true, true, 22u, 22u, 2u, 2u));
}


