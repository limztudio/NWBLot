#include <impl/ecs_render/deferred/deferred_frame_targets.adhd>
#include <impl/ecs_render/deferred/import_types.adhd>
#include <impl/ecs_render/csg/csg_graph_resource_snapshot.adhd>
#include <impl/ecs_render/raytrace/graph_snapshots.adhd>
#include <impl/ecs_render/shared/renderer_frame_bindings.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(GpuGraphResourceId().generation == 0u && GpuGraphResourceId().index == s_DeferredGraphInvalidIndex);

class DeferredGraphResourceImportInputs{
    public in DeferredFrameTargets targets;
    public in DeferredLightingGraphResources lightingResources;
    public in MeshFrameBindingSnapshot frameBindings;
    public in MeshViewBufferSnapshot meshViewSnapshot;
    public in CsgGraphResourceSnapshot csgResources;
    public in RayTracingDeferredGraphResourceSnapshot rayTracingResources;
    public Optional<in DeferredLaggedLightingHistoryResources> history;
    public Optional<in DeferredLaggedLightingHistoryResources> captureHistory;
    public b8 clearAvboitTargets = false;
    public b8 capturesLaggedLightingHistory = false;
    public b8 hasCsgFrameWork = false;

    public DeferredGraphResourceImportInputs(in DeferredFrameTargets targets, in DeferredLightingGraphResources lightingResources, in MeshFrameBindingSnapshot frameBindings,
        in MeshViewBufferSnapshot meshViewSnapshot, in CsgGraphResourceSnapshot csgResources, in RayTracingDeferredGraphResourceSnapshot rayTracingResources){
        this.targets = targets;
        this.lightingResources = lightingResources;
        this.frameBindings = frameBindings;
        this.meshViewSnapshot = meshViewSnapshot;
        this.csgResources = csgResources;
        this.rayTracingResources = rayTracingResources;
    }
}

[modular]
class DeferredGraphResourceImportBuilder : NoCopy{
    private mut GpuTaskGraph m_graph;
    public DeferredGraphResourceImportBuilder(mut GpuTaskGraph graph){ this.m_graph = graph; }

    [cpp_unwind]
    public Expected<DeferredGraphResourceImportResult> declare(in DeferredGraphResourceImportInputs inputs)const;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

