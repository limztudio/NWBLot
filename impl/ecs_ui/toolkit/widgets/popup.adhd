#include <impl/ecs_ui/toolkit/paint.adhd>
#include <impl/ecs_ui/toolkit/input/popup.adhd>
#include <impl/ecs_ui/toolkit/widgets/popup_style.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The host lends state through the outermost popup end; each opening binds to its exact parent lifetime.
class PopupState : NoCopy{
    public u64 m_instanceGeneration;
    public u64 m_openGeneration = 0u;
    public PopupPlacement m_placement;
    public b8 m_parentBound = false;
    public b8 m_open = false;
    public PopupToken m_parent;
    public u64 m_parentOpenGeneration = 0u;

    public PopupState(){
        this.m_instanceGeneration = AllocateServiceIdentity();
    }

    public void open(){
        if(this.m_open)
            return;
        AdvanceNonWrappingRevision(this.m_openGeneration);
        this.m_open = true;
    }

    public void close(){
        this.m_open = false;
    }

    public b8 isOpen()const{
        return this.m_open;
    }

    public u64 instanceGeneration()const{
        return this.m_instanceGeneration;
    }

    public u64 openGeneration()const{
        return this.m_openGeneration;
    }

    public in PopupPlacement placement()const{
        return this.m_placement;
    }

    public void bindParent(in PopupToken parent){
        BindPopupParentState(
            parent,
            this.m_openGeneration,
            this.m_open,
            this.m_parentBound,
            this.m_parent,
            this.m_parentOpenGeneration
        );
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

