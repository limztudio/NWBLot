////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SHADOW_INTEGRATE_SLANGI
#define NWB_GRAPHICS_SHADOW_INTEGRATE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Occlusion-ray volume-path integration for the software traversal (sw_shadow_traverse.slangi, t = triangleHit.t, geometric normal from the loaded triangle positions + the object-space ray dir). The accumulator lives as a LOCAL variable, so its per-occluder bin array indexes safely.

// Must be included AFTER the surface helpers (shadow_surface.slangi -> mesh/surface.slangi), which define nwbShadowFresnelTransmittedFraction / nwbShadowAbsorptionCoefficient.


// Max distinct occluders one shadow ray accumulates (the per-thread transparent accumulator's bin array). A ray crosses only the few refractors between it and the light; a further occluder beyond this drops its rare contribution gracefully rather than mis-binning.
#define NWB_SHADOW_MAX_OCCLUDER_BINS 3
#define NWB_SHADOW_MAX_CROSSINGS_PER_OCCLUDER 4
#define NWB_SHADOW_CROSSING_MERGE_MIN_EPSILON 1e-4
#define NWB_SHADOW_CROSSING_MERGE_REL_EPSILON 1e-5
#define NWB_SHADOW_INTERFACE_FADE_DISTANCE 2e-3

// Per-occluder optical-depth bin. Each occluder's crossings are accumulated INDEPENDENTLY (binned by instance id) so one occluder's unbalanced crossing cannot corrupt the others.
// For a closed volume the robust chord is the sum of sorted hit-distance pairs (t1-t0, t3-t2, ...), not a face-sign telescope: at hard triangle edges the ray query can report either adjacent face first and their geometric normals may disagree about entry/exit.
// Pairing merged hit distances treats an edge hit as one physical boundary and avoids a real through-volume segment collapsing to zero.
struct NwbShadowOccluderBin{
    uint instanceId;         // the crossing's InstanceID() / scene-BVH instance index; unique per occluder
    uint crossingCount;      // merged unique boundary hits for this occluder
    uint crossingOverflow;   // set when crossingT[] is full; finalize uses the recorded first-to-last crossing span
    float3 absorptionCoeff;  // the occluder's per-channel absorption coeff (constant per material; set on first hit)
    float interfaceTransmittance; // product of accepted Fresnel transmissions, applied only when the bin has volume
    float tMin;              // nearest recorded crossing distance for this occluder
    float tMax;              // farthest recorded crossing distance for this occluder
    float crossingT[NWB_SHADOW_MAX_CROSSINGS_PER_OCCLUDER]; // unique boundary hit distances, sorted in finalize
};

// Running accumulators for one occlusion ray. Final visibility = transmittance * exp(-opticalDepth), where the optical depth is summed across the per-occluder bins (paired unique hit distances, or their recorded span after crossing-list overflow -- see nwbShadowFinalizeVisibility).
//   transmittance -- opaque-hit gate (seed 1; opaque hit zeroes it). Transparent Fresnel is held per bin until finalize so singleton edge hits cannot darken a pixel without a real volume chord.
//   bins/binCount -- the per-occluder optical-depth bins (see NwbShadowOccluderBin).
struct NwbShadowVisibilityAccumulator{
    half3 transmittance;
    uint binCount;
    NwbShadowOccluderBin bins[NWB_SHADOW_MAX_OCCLUDER_BINS];
};

// Persistent per-ray optics: the opaque gate plus the combined transparent result of every COMPLETED instance.
// Temporary crossing storage lives in one NwbShadowInstanceOptics below and is discarded after that instance finalizes, so the next mesh traversal does not retain the prior instance's crossing list.
struct NwbShadowRayOptics{
    half3 transmittance;
    float3 opticalDepth;
    half interfaceTransmittance;
};

// Temporary per-instance crossing state. Scoped to the single mesh traversal in nwbSwShadowInstanceOptics so its crossing list is finalized exactly once and never retained across the next instance.
struct NwbShadowInstanceOptics{
    float3 absorptionCoeff;
    float interfaceTransmittance;
    float tMin;
    float tMax;
    uint crossingCount;
    uint crossingOverflow;
    float crossingT[NWB_SHADOW_MAX_CROSSINGS_PER_OCCLUDER];
};

// Traversal outcome for one instance: the caller combines completed optics exactly once, zeroes visibility on an opaque block, keeps the conservative all-blocked fallback on stack overflow, and adds nothing on a clean miss.
namespace NwbShadowInstanceStatus{
    enum Enum : uint{
        Completed,
        NoIntersection,
        OpaqueBlocked,
        StackOverflow,
    };
};


// Seed a fully-lit accumulator (no occluders yet). Bins are written on first use; binCount gates every read.
NwbShadowVisibilityAccumulator nwbShadowVisibilityBegin(){
    NwbShadowVisibilityAccumulator acc;
    acc.transmittance = half3(1.0h, 1.0h, 1.0h);
    acc.binCount = 0u;
    return acc;
}

// Seed persistent ray optics: fully lit, no absorbed depth, full interface transmission.
NwbShadowRayOptics nwbShadowRayOpticsBegin(){
    NwbShadowRayOptics optics;
    optics.transmittance = half3(1.0h, 1.0h, 1.0h);
    optics.opticalDepth = float3(0.0, 0.0, 0.0);
    optics.interfaceTransmittance = half(1.0h);
    return optics;
}

// Seed temporary instance optics for one mesh traversal. Absorption is set on the first accepted crossing.
NwbShadowInstanceOptics nwbShadowInstanceOpticsBegin(){
    NwbShadowInstanceOptics optics;
    optics.absorptionCoeff = float3(0.0, 0.0, 0.0);
    optics.interfaceTransmittance = 1.0;
    optics.tMin = 0.0;
    optics.tMax = 0.0;
    optics.crossingCount = 0u;
    optics.crossingOverflow = 0u;
    return optics;
}

// Fold ONE accepted transparent crossing into temporary instance state. Order-independent: pairing happens once at finalize, so traversal must never narrow tMax for transparent occluders.
void nwbShadowInstanceIntegrateCrossing(inout NwbShadowInstanceOptics optics, inout bool hasAbsorption, const float ior, const half3 transmission, const float cosI, const float t){
    for(uint i = 0u; i < optics.crossingCount; ++i){
        if(nwbShadowCrossingMatchesEndpoint(t, optics.crossingT[i]))
            return;
    }
    if(!hasAbsorption){
        optics.absorptionCoeff = nwbShadowAbsorptionCoefficient(transmission);
        hasAbsorption = true;
    }
    optics.interfaceTransmittance *= nwbShadowFresnelTransmittedFraction(ior, half(cosI));
    if(optics.crossingCount == 0u){
        optics.tMin = t;
        optics.tMax = t;
    }
    else{
        optics.tMin = min(optics.tMin, t);
        optics.tMax = max(optics.tMax, t);
    }
    if(optics.crossingCount < (uint)NWB_SHADOW_MAX_CROSSINGS_PER_OCCLUDER){
        optics.crossingT[optics.crossingCount] = t;
        optics.crossingCount += 1u;
    }
    else{
        optics.crossingOverflow = 1u;
    }
}

// Pair one instance's merged boundary distances into its inside chord. Matches the legacy per-bin finalize: sorted unique distances pair into inside intervals, overflow (or a trailing odd count beyond the first pair) falls back to the recorded first-to-last span, and a singleton contributes no volume.
float nwbShadowInstanceChordLength(const NwbShadowInstanceOptics optics){
    float sortedT[NWB_SHADOW_MAX_CROSSINGS_PER_OCCLUDER];
    const uint crossingCount = min(optics.crossingCount, (uint)NWB_SHADOW_MAX_CROSSINGS_PER_OCCLUDER);
    for(uint j = 0u; j < crossingCount; ++j)
        sortedT[j] = optics.crossingT[j];
    for(uint j = 0u; j < crossingCount; ++j){
        uint minIndex = j;
        for(uint k = j + 1u; k < crossingCount; ++k){
            if(sortedT[k] < sortedT[minIndex])
                minIndex = k;
        }
        const float tmp = sortedT[j];
        sortedT[j] = sortedT[minIndex];
        sortedT[minIndex] = tmp;
    }
    if(optics.crossingOverflow != 0u)
        return max(optics.tMax - optics.tMin, 0.0);
    float chordLength = 0.0;
    for(uint j = 0u; (j + 1u) < crossingCount; j += 2u)
        chordLength += max(sortedT[j + 1u] - sortedT[j], 0.0);
    if(crossingCount > 1u && (crossingCount & 1u) != 0u)
        chordLength = max(chordLength, max(optics.tMax - optics.tMin, 0.0));
    return chordLength;
}

// Combine ONE completed instance into persistent ray optics exactly once. Singleton crossings hold no volume, so their interface product stays faded out by the shared interface fade.
void nwbShadowCombineCompletedInstance(inout NwbShadowRayOptics rayOptics, const NwbShadowInstanceOptics optics){
    if(optics.crossingCount == 0u && optics.crossingOverflow == 0u)
        return;
    const float chordLength = nwbShadowInstanceChordLength(optics);
    const half interfaceWeight = half(smoothstep(0.0, NWB_SHADOW_INTERFACE_FADE_DISTANCE, chordLength));
    rayOptics.interfaceTransmittance *= half(lerp(1.0, optics.interfaceTransmittance, float(interfaceWeight)));
    rayOptics.opticalDepth += optics.absorptionCoeff * chordLength;
}

// Combine persistent ray optics into final per-channel visibility. Same policy as the legacy bin finalize: opaque gate * interface product * Beer-Lambert over summed independent-occluder depth.
half3 nwbShadowFinalizeRayOptics(const NwbShadowRayOptics optics){
    return half3(saturate(float3(optics.transmittance) * float(optics.interfaceTransmittance) * exp(-max(optics.opticalDepth, float3(0.0, 0.0, 0.0)))));
}


float nwbShadowCrossingMergeEpsilon(const float t){
    return max(NWB_SHADOW_CROSSING_MERGE_MIN_EPSILON, abs(t) * NWB_SHADOW_CROSSING_MERGE_REL_EPSILON);
}

bool nwbShadowCrossingMatchesEndpoint(const float t, const float endpointT){
    return abs(t - endpointT) <= nwbShadowCrossingMergeEpsilon(max(abs(t), abs(endpointT)));
}

float nwbShadowCosineToRay(const float3 normal, const float3 rayDirection){
    return saturate(abs(dot(rayDirection, normal)) * rsqrt(max(dot(normal, normal), 1e-20)) * rsqrt(max(dot(rayDirection, rayDirection), 1e-20)));
}

float nwbShadowSmoothNormalWeight(const float3 n0, const float3 n1, const float3 n2){
    const float spread = max(max(dot(n0 - n1, n0 - n1), dot(n1 - n2, n1 - n2)), dot(n2 - n0, n2 - n0));
    return smoothstep(1e-5, 2e-3, spread);
}

// Fold ONE transparent surface crossing into the running visibility.
// The caller supplies the crossing's occluder id + the occluder's optical params (ior / transmission, from its surface hook) + the crossing geometry: geometricNormal and rayDirection MUST be in the SAME object space (invariant to the instance transform); shadingNormal is the interpolated triangle-corner normal in that same space, and t is the WORLD ray distance to the hit.

// Transparent shadow visibility uses Beer-Lambert absorption through the paired chord plus Fresnel loss at each accepted interface.
// Hard/faceted triangles use the geometric face normal so their shadow keeps the authored hard edge response; smooth vertex-normal triangles blend to the interpolated shading normal to match smooth meshes.
// Directional refractive focusing belongs in the caustic path.

// Optical depth is BINNED PER OCCLUDER by instance id, and each bin keeps merged hit distances; same-occluder crossings at the same t are collapsed because edge/diagonal hits can report two triangles sharing one physical surface.
void nwbShadowIntegrateCrossing(inout NwbShadowVisibilityAccumulator acc, const uint instanceId, const float ior, const half3 transmission, const float3 geometricNormal, const float3 shadingNormal, const float smoothNormalWeight, const float3 rayDirection, const float t){
    const float cosI = nwbShadowCosineToRay(geometricNormal, rayDirection);

    int slot = -1;
    for(uint i = 0u; i < acc.binCount; ++i){
        if(acc.bins[i].instanceId == instanceId){
            slot = (int)i;
            break;
        }
    }
    if(slot < 0){
        if(acc.binCount >= (uint)NWB_SHADOW_MAX_OCCLUDER_BINS)
            return; // bin table full: drop this occluder's contribution (rare; a graceful slight lightening)
        slot = (int)acc.binCount;
        acc.bins[slot].instanceId = instanceId;
        acc.bins[slot].crossingCount = 0u;
        acc.bins[slot].crossingOverflow = 0u;
        acc.bins[slot].absorptionCoeff = nwbShadowAbsorptionCoefficient(transmission);
        acc.bins[slot].interfaceTransmittance = 1.0;
        acc.bins[slot].tMin = t;
        acc.bins[slot].tMax = t;
        acc.binCount += 1u;
    }

    bool alreadyAccepted = false;
    for(uint i = 0u; i < acc.bins[slot].crossingCount; ++i)
        alreadyAccepted = alreadyAccepted || nwbShadowCrossingMatchesEndpoint(t, acc.bins[slot].crossingT[i]);
    if(alreadyAccepted)
        return;

    const float shadingCosI = nwbShadowCosineToRay(shadingNormal, rayDirection);
    // The Fresnel blend cosine is a (0, 1) bounded factor input, so half arithmetic is sufficient here.
    const half fresnelCosI = half(lerp(cosI, shadingCosI, saturate(smoothNormalWeight)));
    acc.bins[slot].interfaceTransmittance *= nwbShadowFresnelTransmittedFraction(ior, fresnelCosI);

    acc.bins[slot].tMin = min(acc.bins[slot].tMin, t);
    acc.bins[slot].tMax = max(acc.bins[slot].tMax, t);
    if(acc.bins[slot].crossingCount < (uint)NWB_SHADOW_MAX_CROSSINGS_PER_OCCLUDER){
        acc.bins[slot].crossingT[acc.bins[slot].crossingCount] = t;
        acc.bins[slot].crossingCount += 1u;
    }
    else{
        acc.bins[slot].crossingOverflow = 1u;
    }
}


// Combine into the final per-channel visibility. Per occluder: sorted unique hit distances are paired into inside intervals. Overflow uses the recorded first-to-last crossing span; a singleton has no entry->exit volume path and therefore contributes neither absorption nor Fresnel loss.
half3 nwbShadowFinalizeVisibility(const NwbShadowVisibilityAccumulator acc){
    float3 opticalDepth = float3(0.0, 0.0, 0.0);
    // The interface weight and Fresnel product are (0, 1) bounded factors, so half arithmetic is sufficient here.
    half interfaceTransmittance = half(1.0h);
    for(uint i = 0u; i < acc.binCount; ++i){
        float sortedT[NWB_SHADOW_MAX_CROSSINGS_PER_OCCLUDER];
        const uint crossingCount = min(acc.bins[i].crossingCount, (uint)NWB_SHADOW_MAX_CROSSINGS_PER_OCCLUDER);
        for(uint j = 0u; j < crossingCount; ++j)
            sortedT[j] = acc.bins[i].crossingT[j];

        for(uint j = 0u; j < crossingCount; ++j){
            uint minIndex = j;
            for(uint k = j + 1u; k < crossingCount; ++k){
                if(sortedT[k] < sortedT[minIndex])
                    minIndex = k;
            }
            const float tmp = sortedT[j];
            sortedT[j] = sortedT[minIndex];
            sortedT[minIndex] = tmp;
        }

        float chordLength = 0.0;
        if(acc.bins[i].crossingOverflow != 0u){
            chordLength = max(acc.bins[i].tMax - acc.bins[i].tMin, 0.0);
        }
        else{
            for(uint j = 0u; (j + 1u) < crossingCount; j += 2u)
                chordLength += max(sortedT[j + 1u] - sortedT[j], 0.0);

            if(crossingCount > 1u && (crossingCount & 1u) != 0u)
                chordLength = max(chordLength, max(acc.bins[i].tMax - acc.bins[i].tMin, 0.0));
        }

        const half interfaceWeight = half(smoothstep(0.0, NWB_SHADOW_INTERFACE_FADE_DISTANCE, chordLength));
        interfaceTransmittance *= half(lerp(1.0, acc.bins[i].interfaceTransmittance, float(interfaceWeight)));
        opticalDepth += acc.bins[i].absorptionCoeff * chordLength;
    }
    return half3(saturate(float3(acc.transmittance) * float(interfaceTransmittance) * exp(-max(opticalDepth, float3(0.0, 0.0, 0.0)))));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

