[cpp_header("<core/task/gpu/compiler.h>"), cpp_name("::NWB::Core::GpuTaskGraphAnalysis")]
extern class GpuTaskGraphAnalysis{
    Vector<GpuTaskDependencyEdge> cycleEdges(...)const;
    Vector<GpuTaskId> cyclePath(...)const;
    GpuTaskGraphAnalysisDiagnostic diagnostic(...)const;
    Vector<GpuTaskDependencyEdge> edges(...)const;
    usize explicitEdgeCount(...)const;
    Vector<GpuTaskExternalDependencyEdge> externalDependencies(...)const;
    b8 hasExplicitEdge(...)const;
    b8 hasInferredEdge(...)const;
    usize inferredEdgeCount(...)const;
    Vector<GpuTaskDependencyEdge> inferredEdges(...)const;
    void reset(...);
    usize resourceVersionEdgeCount(...)const;
    GpuTaskGraphSchedulingTaskIndexView schedulingConsumers(...)const;
    Vector<GpuTaskDependencyEdge> schedulingEdges(...)const;
    GpuTaskGraphSchedulingTaskIndexView schedulingProducers(...)const;
    Vector<GpuTaskId> topologicalOrder(...)const;
    b8 valid(...)const;
};

[cpp_header("<core/task/gpu/compiler.h>"), cpp_name("::NWB::Core::GpuTaskGraphAnalysisDiagnostic"), cpp_flags(binary_serializable, brace_init)]
extern class GpuTaskGraphAnalysisDiagnostic{
    GpuTaskId task;
    GpuTaskId relatedTask;
    GpuGraphResourceId resource;
    GpuGraphResourceVersionId resourceVersion;
    GpuTaskGraphAnalysisStatus status;
};

