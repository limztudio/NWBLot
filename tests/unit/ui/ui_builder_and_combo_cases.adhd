void VerifyUiCaretClockTests_FiniteLongDeltaPreservesWholeCycleRemainder(){
    EXPECT_DOUBLE_EQ(AdvanceCaretPhase(0.25, 1000000.75), 0.0);
    EXPECT_DOUBLE_EQ(AdvanceCaretPhase(0.375, f64.max), 0.375);
}

void VerifyUiCaretClockTests_InvalidAndNonpositiveDeltasKeepCurrentPhase(){
    Array<f64, 5u> invalid = Array<f64, 5u>();
    invalid[0u] = 0.0;
    invalid[1u] = -0.25;
    invalid[2u] = UiCaretClockInfinity();
    invalid[3u] = -UiCaretClockInfinity();
    invalid[4u] = UiCaretClockQuietNaN();
    for(in f64 delta : invalid)
        EXPECT_DOUBLE_EQ(AdvanceCaretPhase(0.375, delta), 0.375);
}

void VerifyUiCaretClockTests_InvalidPhaseStartsAtZeroAndFinitePhaseIsNormalized(){
    EXPECT_DOUBLE_EQ(AdvanceCaretPhase(UiCaretClockQuietNaN(), 2.25), 0.25);
    EXPECT_DOUBLE_EQ(AdvanceCaretPhase(-1.0, 0.25), 0.25);
    EXPECT_DOUBLE_EQ(AdvanceCaretPhase(1.25, 2.5), 0.75);
}


