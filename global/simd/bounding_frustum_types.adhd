[cpp_name("::BoundingDoubleFrustum"), cpp_flags(binary_serializable, brace_init)]
extern class BoundingDoubleFrustum{
    f64 bottomSlope;
    f64 farPlane;
    f64 leftSlope;
    f64 nearPlane;
    f64x4 orientation;
    f64x4 origin;
    f64 rightSlope;
    f64 topSlope;

    ContainmentType containedBy(...)const;
    ContainmentType contains(...)const;
    b8 intersects(...)const;
    void transform(...)const;
};

[cpp_name("::BoundingFrustum"), cpp_flags(binary_serializable, brace_init)]
extern class BoundingFrustum{
    f32 bottomSlope;
    f32 farPlane;
    f32 leftSlope;
    f32 nearPlane;
    f32x4 orientation;
    f32x4 origin;
    f32 rightSlope;
    f32 topSlope;

    ContainmentType containedBy(...)const;
    ContainmentType contains(...)const;
    b8 intersects(...)const;
    void transform(...)const;
};


