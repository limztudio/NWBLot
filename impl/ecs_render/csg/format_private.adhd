#include <impl/ecs_render/kernel/renderer_format_private.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const FormatSupport s_CsgStorageFormatSupport = FormatSupport::Texture | FormatSupport::ShaderUavStore;
const FormatSupport s_CsgPeelFormatSupport = s_CsgStorageFormatSupport | FormatSupport::RenderTarget;

Format SelectCsgFormat(
    in Format candidate,
    in FormatSupport requiredSupport,
    mut Device device
){
    Array<Format, 1u> candidates;
    candidates[0u] = candidate;
    return SelectSupportedFormat(candidates, requiredSupport, device);
}


