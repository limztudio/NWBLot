#include <impl/assets_material/asset.adhd>
#include <impl/assets_shader/asset.adhd>
#include <impl/ecs_render/components.adhd>
#include <impl/ecs_render/material/pipeline_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type MaterialTypedByteDataVector = Vector<u8>;


class MaterialSurfaceInfo{
    public Name materialName = s_NameNone;
    public Name materialInterface = s_NameNone;
    public String shaderVariant;
    public AssetRef<PixelShader> pixelShader;
    public AssetRef<MeshShader> meshShader;
    public AssetRef<PixelShader> avboitAccumulatePixelShader;
    public AssetRef<PixelShader> avboitOccupancyPixelShader;
    public AssetRef<PixelShader> avboitExtinctionPixelShader;
    public u64 typedLayoutHash = 0u;
    public Vector<MaterialTypedLayoutBlock> typedLayoutBlocks;
    public Vector<MaterialTypedLayoutField> typedLayoutFields;
    public Vector<MaterialResourceReference> resourceReferences;
    public Vector<u8> unpatchedConstantTypedBytes;
    public Vector<u8> constantTypedBytes;
    public Vector<u8> mutableDefaultTypedBytes;
    public u32 shadingModelId = 0u;
    public u32 surfaceDispatchId = 0u;
    public b8 csgCapSurfaceDispatchAvailable = false;
    public b8 csgCapSurfaceDispatchUnavailableLogged = false;
    public b8 resourceReferencesResolved = false;
    public b8 transparent = false;
    public b8 twoSided = false;
    public b8 refractive = false;
}


