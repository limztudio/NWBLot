[serialize]
class HardwareTransparentShadowPushConstants{
    public u32 width = 0u;
    public u32 height = 0u;
    public u32 frameIndex = 0u;
    public u32 lightSlot = 0u;
    public u32 sampleIndex = 0u;
    public u32 sampleCount = 0u;
    public u32 deferredResourcesHeapSlot = 0u;
    public u32 materialContextSlotsHeapSlot = 0u;
    public u32 crossingsHeapSlot = 0u;
    public u32 overflowListHeapSlot = 0u;
    public u32 overflowArgsHeapSlot = 0u;
    public u32 outputStorageSlot = 0u;
    public u32 receiverFactor = s_ShadowReceiverFactorHalf;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


HardwareTransparentShadowPushConstants ResolveHardwareTransparentShadowPushConstants(
    in u32 width,
    in u32 height,
    in u32 frameIndex,
    in u32 sampleCount,
    in u32 deferredResourcesHeapSlot,
    in u32 materialContextSlotsHeapSlot,
    in u32 crossingsHeapSlot,
    in u32 overflowListHeapSlot,
    in u32 overflowArgsHeapSlot,
    in u32 outputStorageSlot,
    in u32 receiverFactor
){
    HardwareTransparentShadowPushConstants push;
    push.width = width;
    push.height = height;
    push.frameIndex = frameIndex;
    push.lightSlot = 0u;
    push.sampleIndex = 0u;
    push.sampleCount = sampleCount;
    push.deferredResourcesHeapSlot = deferredResourcesHeapSlot;
    push.materialContextSlotsHeapSlot = materialContextSlotsHeapSlot;
    push.crossingsHeapSlot = crossingsHeapSlot;
    push.overflowListHeapSlot = overflowListHeapSlot;
    push.overflowArgsHeapSlot = overflowArgsHeapSlot;
    push.outputStorageSlot = outputStorageSlot;
    push.receiverFactor = receiverFactor;
    return push;
}

SwShadowHeapPushConstants MakeSwShadowHeapPushConstants(
    in u32 instanceCount,
    in u32 deferredResourcesHeapSlot,
    in u32 materialContextSlotsHeapSlot,
    in u32 visibilityStorageSlot,
    in u32 coarseStorageSlot,
    in u32 softHalfStorageSlot,
    in u32 transparentSoftHalfStorageSlot,
    in u32 edgeCounterStorageSlot,
    in u32 edgeListStorageSlot,
    in u32 indirectArgsStorageSlot,
    in u32 receiverFactor
){
    SwShadowHeapPushConstants push;
    push.instanceCount = instanceCount;
    push.deferredResourcesHeapSlot = deferredResourcesHeapSlot;
    push.materialContextSlotsHeapSlot = materialContextSlotsHeapSlot;
    push.visibilityStorageSlot = visibilityStorageSlot;
    push.coarseStorageSlot = coarseStorageSlot;
    push.softHalfStorageSlot = softHalfStorageSlot;
    push.transparentSoftHalfStorageSlot = transparentSoftHalfStorageSlot;
    push.edgeCounterStorageSlot = edgeCounterStorageSlot;
    push.edgeListStorageSlot = edgeListStorageSlot;
    push.indirectArgsStorageSlot = indirectArgsStorageSlot;
    push.receiverFactor = receiverFactor;
    return push;
}

ShadowGeometryDownsamplePushConstants MakeShadowGeometryDownsamplePushConstants(
    in u32 width,
    in u32 height,
    in u32 halfWidth,
    in u32 halfHeight,
    in u32 worldPositionSlot,
    in u32 normalSlot,
    in u32 depthSlot,
    in u32 outputStorageSlot,
    in u32 sceneShadingSlot,
    in u32 receiverFactor
){
    ShadowGeometryDownsamplePushConstants push;
    push.width = width;
    push.height = height;
    push.halfWidth = halfWidth;
    push.halfHeight = halfHeight;
    push.worldPositionSlot = worldPositionSlot;
    push.normalSlot = normalSlot;
    push.depthSlot = depthSlot;
    push.outputStorageSlot = outputStorageSlot;
    push.sceneShadingSlot = sceneShadingSlot;
    push.receiverFactor = receiverFactor;
    return push;
}

ShadowResolvePushConstants MakeShadowTerminalUpsamplePushConstants(
    in u32 width,
    in u32 height,
    in u32 halfWidth,
    in u32 halfHeight,
    in u32 lightSlotCount,
    in u32 geometrySlot,
    in u32 depthSlot,
    in u32 worldPositionSlot,
    in u32 normalSlot,
    in u32 inputColorSlot,
    in u32 outputStorageSlot,
    in u32 visibilityStorageSlot,
    in u32 sceneShadingSlot,
    in u32 opaqueInputColorSlot,
    in u32 receiverFactor
){
    ShadowResolvePushConstants push;
    push.width = width;
    push.height = height;
    push.halfWidth = halfWidth;
    push.halfHeight = halfHeight;
    push.stage = cast<u32>(ShadowResolveStage::Upsample);
    push.lightSlotCount = lightSlotCount;
    push.geometrySlot = geometrySlot;
    push.depthSlot = depthSlot;
    push.worldPositionSlot = worldPositionSlot;
    push.normalSlot = normalSlot;
    push.inputColorSlot = inputColorSlot;
    push.momentsSlot = inputColorSlot;
    push.outputStorageSlot = outputStorageSlot;
    push.visibilityStorageSlot = visibilityStorageSlot;
    push.sceneShadingSlot = sceneShadingSlot;
    push.opaqueInputColorSlot = opaqueInputColorSlot;
    push.receiverFactor = receiverFactor;
    return push;
}

ShadowCombinedWaveletPushConstants MakeShadowCombinedWaveletPushConstants(
    in u32 width,
    in u32 height,
    in u32 halfWidth,
    in u32 halfHeight,
    in u32 lightSlotCount,
    in u32 geometrySlot,
    in u32 inputColorSlot,
    in u32 momentsSlot,
    in u32 outputStorageSlot,
    in u32 opaqueInputColorSlot,
    in u32 opaqueMomentsSlot,
    in u32 opaqueOutputStorageSlot,
    in u32 receiverFactor
){
    ShadowCombinedWaveletPushConstants push;
    push.resolve.width = width;
    push.resolve.height = height;
    push.resolve.halfWidth = halfWidth;
    push.resolve.halfHeight = halfHeight;
    push.resolve.stage = cast<u32>(ShadowResolveStage::Wavelet);
    push.resolve.lightSlotCount = lightSlotCount;
    push.resolve.momentsValid = 1u;
    push.resolve.geometrySlot = geometrySlot;
    push.resolve.inputColorSlot = inputColorSlot;
    push.resolve.momentsSlot = momentsSlot;
    push.resolve.outputStorageSlot = outputStorageSlot;
    push.resolve.opaqueInputColorSlot = opaqueInputColorSlot;
    push.resolve.receiverFactor = receiverFactor;
    push.opaqueMomentsSlot = opaqueMomentsSlot;
    push.opaqueMomentsValid = 1u;
    push.opaqueOutputStorageSlot = opaqueOutputStorageSlot;
    return push;
}


