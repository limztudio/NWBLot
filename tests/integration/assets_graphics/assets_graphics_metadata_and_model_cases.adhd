void VerifyMetadataRegistryPublication_MetadataRegistrationKeepsCallerTextAlive(){
    ScratchArena scratchArena(s_AssetCaseTestsMetadataRegistryOwnedTokens);
    ScratchString token = MakeScratchString("nwb_owned_token_71a7", scratchArena);
    ScratchString suffix = MakeScratchString("_nwb_owned_suffix_71a7", scratchArena);
    ScratchString extension = MakeScratchString(".nwb_owned_sidecar_71a7", scratchArena);
    RegisterMetadataNonStandaloneAssetType(Name(s_AssetCaseTestsOwnedType71a7), ViewScratchString(token));
    RegisterMetadataNonStandaloneFirstTokenSuffix(ViewScratchString(suffix));
    RegisterMetadataPairedSidecarExtension(ViewScratchString(extension));
    token.assign("overwritten");
    suffix.assign("overwritten");
    extension.assign("overwritten");

    EXPECT_TRUE(IsLikelyNonStandaloneFirstToken("nwb_owned_token_71a7"));
    EXPECT_TRUE(IsLikelyNonStandaloneFirstToken("value_nwb_owned_suffix_71a7"));
    EXPECT_TRUE(HasRegisteredPairedSidecarExtension(scratchArena, ".nwb_owned_sidecar_71a7"));

    native{
        using namespace NWB::Core;
        using namespace NWB::Core::Assets;
#if defined(NWB_DEBUG)
        Name fallback = s_NwbOwnedFallback71a7;
        RegisterNonStandaloneAssetType(fallback);
        fallback = Name(s_AssetCaseNwbReplacedFallback71a7);
        EXPECT_TRUE(IsLikelyNonStandaloneFirstToken("nwb_owned_fallback_71a7"));
#else
        const auto previousRecorder = NameDetail::SymbolRecorderState();
        const auto previousResolver = NameDetail::SymbolResolverState();
        ScopeExit restore([&]()noexcept{
            SetNameSymbolRecordCallback(previousRecorder.callback, previousRecorder.userData);
            SetNameSymbolResolveCallback(previousResolver.callback, previousResolver.userData);
        });
        Common::NameSymbols::InstallRuntimeRegistry();
        const Name fallback{ AStringView("nwb_owned_fallback_71a7") };
        RegisterNonStandaloneAssetType(fallback);
        const Name replacement{ AStringView("nwb_replaced_fallback_71a7") };
        for(usize i = 0u; i < NameDetail::s_SymbolTextBufferCount; ++i)
            EXPECT_EQ(replacement.resolvedText(), AStringView("nwb_replaced_fallback_71a7"));
        EXPECT_TRUE(IsLikelyNonStandaloneFirstToken("nwb_owned_fallback_71a7"));
#endif
    }
}

void VerifyMetadataRegistryPublication_ConcurrentMetadataRegistrationsKeepDistinctTokens(){
    Vector<StringView> tokens = Vector<StringView>();
    tokens.reserve(4u);
    tokens.push_back("nwb_owned_thread_a_71a7");
    tokens.push_back("nwb_owned_thread_b_71a7");
    tokens.push_back("nwb_owned_thread_c_71a7");
    tokens.push_back("nwb_owned_thread_d_71a7");

    native(in tokens){
        using namespace NWB::Core::Assets;
        Array<Thread, 4u> threads;
        for(usize i = 0u; i < threads.size(); ++i){
            threads[i] = Thread([&, i](){
                ScratchArena scratchArena{ Name(s_AssetCaseTestsMetadataRegistryConcurrentTokens) };
                ScratchString text(tokens[i], scratchArena);
                RegisterNonStandaloneAssetType(s_NameNone, AStringView(text));
                text.assign("overwritten");
            });
        }
        for(Thread& thread : threads)
            thread.join();
    }

    for(in StringView token : tokens)
        EXPECT_TRUE(IsLikelyNonStandaloneFirstToken(token));
}

void VerifyModelCookMetadata_UniqueAssetPathReferencesFailAndLocalObjectReferencesRecover(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration(logger, s_BreakOnFatal);

    for(u32 countIndex = 0u; countIndex < 2u; ++countIndex){
        usize skeletonCount = 1u;
        if(countIndex == 1u)
            skeletonCount = 33u;
        ModelMetadata metadata = ModelMetadata();
        PopulateIndexedModelObjects(skeletonCount, 257u, metadata);
        ASSERT_TRUE(metadata.parse());
        metadata.verifyObjectReferences();

        const StringView assetPath = "tests/model_cook_metadata/skeleton_0";
        metadata.setNestedFieldString(s_ModelMetaSkinnedMeshesField, s_ModelMetaMeshObjectField, s_ModelMetaSkeletonField, assetPath);
        EXPECT_FALSE(metadata.parse());
        metadata.verifyObjectReferences();
        EXPECT_EQ(metadata.nestedFieldString(s_ModelMetaSkinnedMeshesField, s_ModelMetaMeshObjectField, s_ModelMetaSkeletonField), assetPath);

        metadata.setNestedFieldString(s_ModelMetaSkinnedMeshesField, s_ModelMetaMeshObjectField, s_ModelMetaSkeletonField, "rig_0");
        ASSERT_TRUE(metadata.parse());
        metadata.verifyObjectReferences();
    }
    EXPECT_EQ(logger.errorCount(), 2u);
    EXPECT_TRUE(SawCapturedError(logger, "targets a missing skeleton object"));
}

void VerifyModelCookMetadata_SharedAssetPathCannotSelectAmongLocalSkeletonObjects(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration(logger, s_BreakOnFatal);
    ModelMetadata metadata = ModelMetadata();

    metadata.addSkeleton(s_ModelMetaRigA, s_SharedModelPath);
