#ifndef NWB_GRAPHICS_CAUSTIC_TRACE_SLANGI
#define NWB_GRAPHICS_CAUSTIC_TRACE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../common/math.slangi"
#include "../shadow/shadow_surface.slangi"
#include "../mesh/surface.slangi"
#include "../optics/ray_precision.slangi"
#include "photon_push_constants.h"
#include "../raytrace/optical_events.slangi"
#include "splat_constants.slangi"

#ifndef NWB_RT_CSG_ENABLED
#define NWB_RT_CSG_ENABLED 0
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// HW and SW share medium replay, interface physics and deposition; backend hooks supply geometric queries.


// Several ordinary refractors or CSG retained spans require more than four interfaces before deposition.
#define NWB_CAUSTIC_MAX_BOUNCES 16u

#define NWB_CAUSTIC_FLUX_EPSILON 1e-6
#define NWB_CAUSTIC_MIN_EMISSION_AREA 1e-6
#define NWB_CAUSTIC_LIGHT_COLOR_MAX 1.5
#define NWB_CAUSTIC_LIGHT_INTENSITY_MAX 2.0

// lowbias32 integer hash.
#define NWB_CAUSTIC_HASH_OUTER_SHIFT 16
#define NWB_CAUSTIC_HASH_MIDDLE_SHIFT 15
#define NWB_CAUSTIC_HASH_FIRST_MULTIPLIER 0x7feb352du
#define NWB_CAUSTIC_HASH_SECOND_MULTIPLIER 0x846ca68bu

// Emission jitter keeps the top 24 hash bits and maps them to [0, 1).
#define NWB_CAUSTIC_JITTER_GOLDEN_RATIO 0x9E3779B9u
#define NWB_CAUSTIC_JITTER_SEED_OFFSET 0x85EBCA6Bu
#define NWB_CAUSTIC_JITTER_SECOND_SEED_SALT 0x68E31DA4u
#define NWB_CAUSTIC_JITTER_DROPPED_BITS 8
#define NWB_CAUSTIC_JITTER_UNIT_SCALE (1.0 / 16777216.0)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// With normalized rays, t is world distance and instance selects the current material record.
struct NwbCausticHit{
    bool hit;
#if NWB_RT_CSG_ENABLED
    uint failure;
#endif
    bool isRefractive;
    uint instance;
    float t;
    float3 worldPos;
};

struct NwbCausticBoundary{
    uint instance;
    float3 geometricNormal;
};

NwbCausticHit nwbCausticTraceClosest(float3 origin, float3 direction, float tMin, float tMax);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct NwbCausticPhoton{
    float3 origin;
    float3 direction;
    half3 flux;
    bool finiteOrigin;
};

struct NwbCausticSplat{
    bool valid;
    uint termination;
    float3 worldPos;
    half3 flux;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NwbOpticalTraceConfig nwbCausticOpticalConfig();
bool nwbCausticCollectRefractiveEvents(
    const NwbOpticalTraceConfig config, const float3 origin, const float3 direction, const float minimum, const float maximum, const bool reverse,
    __ref NwbOpticalBootstrapEvent events[NWB_OPTICAL_MAX_CANDIDATE_EVENTS], out uint eventCount, out NwbCausticBoundary boundary, out float tolerance, inout NwbOpticalTraceResult result
);

bool nwbCausticAppendBoundary(
    const NwbOpticalTraceConfig config, const float3 origin, const float3 direction, const float distance, const uint instance, const uint primitive, const float3 normal, const bool reverse,
    __ref NwbOpticalBootstrapEvent events[NWB_OPTICAL_MAX_CANDIDATE_EVENTS], inout uint count, inout NwbCausticBoundary boundary, inout float tolerance, inout NwbOpticalTraceResult result
){
    if(count == NWB_OPTICAL_MAX_CANDIDATE_EVENTS){
        result.termination = NWB_OPTICAL_TERMINATION_EVENT_LIMIT;
        return false;
    }
    NwbOpticalInstance optical;
    if(!nwbOpticalReadInstance(config, instance, optical, result))
        return false;
    if(optical.mode != NWB_RT_OPTICAL_BOUNDARY_CLOSED_NESTED && optical.mode != NWB_RT_OPTICAL_BOUNDARY_CLOSED_PRIORITY){
        result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
        return false;
    }
    const float facing = dot(direction, normal);
    const float3 position = origin + direction * distance;
    if(!isfinite(distance) || !all(isfinite(position)) || !isfinite(facing) || abs(facing) <= NWB_OPTICAL_FACING_EPSILON){
        result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
        return false;
    }
    tolerance = max(tolerance, NWB_OPTICS_POSITION_TOLERANCE_SCALE * nwbOpticsPositionUncertainty(position));
    NwbOpticalBootstrapEvent event;
    event.distance = reverse ? -distance : distance;
    event.instance = instance;
    event.primitive = primitive;
    event.entering = (reverse ? facing > 0.0 : facing < 0.0) ? 1u : 0u;
    if(count == 0u){
        boundary.instance = instance;
        boundary.geometricNormal = normal;
    }
    events[count] = event;
    ++count;
    ++result.bootstrapEventCount;
    return true;
}

bool nwbCausticCheckBoundary(
    const NwbOpticalTraceConfig config, const float3 origin, const float3 direction, const NwbCausticHit hit, out NwbCausticBoundary boundary, inout NwbOpticalTraceResult result
){
    const float tolerance = NWB_OPTICS_POSITION_TOLERANCE_SCALE * max(nwbOpticsPositionUncertainty(origin), nwbOpticsPositionUncertainty(hit.worldPos));
    NwbOpticalBootstrapEvent events[NWB_OPTICAL_MAX_CANDIDATE_EVENTS];
    uint count;
    float collectedTolerance;
    if(!nwbCausticCollectRefractiveEvents(config, origin, direction, max(0.0, hit.t - tolerance), hit.t + tolerance, false, events, count, boundary, collectedTolerance, result))
        return false;
    result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
    if(count == 0u || boundary.instance != hit.instance)
        return false;
    [loop] for(uint index = 1u; index < count; ++index){
        if(events[index].instance != events[0].instance || events[index].entering != events[0].entering
#if NWB_RT_CSG_ENABLED
            || events[index].primitive == NWB_CSG_RAY_INVALID_INDEX || events[0].primitive == NWB_CSG_RAY_INVALID_INDEX
#endif
            || !nwbRayTraceCoplanarSeam(config.instanceMaterialHeapSlot, events[0].instance, events[0].primitive, events[index].primitive))
            return false;
    }
    return true;
}

NwbCausticSplat nwbCausticTracePhoton(NwbCausticPhoton photon){
    NwbCausticSplat splat = (NwbCausticSplat)0;
    splat.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
    NwbOpticalTraceResult result = (NwbOpticalTraceResult)0;
    result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
    const NwbOpticalTraceConfig config = nwbCausticOpticalConfig();
    NwbOpticalMedia media = (NwbOpticalMedia)0;
    float3 origin = photon.origin;
    float3 physicalOrigin = photon.origin;
    float3 direction = photon.direction;
    half3 flux = photon.flux;
    uint refractiveCrossings = 0u;
    const float exteriorMarginMinimum = 1e-3;
    const float tMax = 1e7;
    if(!all(isfinite(origin)))
        return splat;

    if(photon.finiteOrigin){
        NwbOpticalBootstrapEvent events[NWB_OPTICAL_MAX_CANDIDATE_EVENTS];
        uint count;
        NwbCausticBoundary boundary;
        float tolerance;
        const float sourceTolerance = NWB_OPTICS_POSITION_TOLERANCE_SCALE * nwbOpticsPositionUncertainty(origin);
        if(!nwbCausticCollectRefractiveEvents(config, origin, direction, 0.0, sourceTolerance, false, events, count, boundary, tolerance, result)){
            splat.termination = result.termination;
            return splat;
        }
        if(count != 0u){
            splat.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
            return splat;
        }
        if(!nwbCausticCollectRefractiveEvents(config, origin, -direction, 0.0, NWB_FLOAT_MAX, true, events, count, boundary, tolerance, result)){
            splat.termination = result.termination;
            return splat;
        }
        [loop] for(uint index = 0u; index < count; ++index){
            if(-events[index].distance <= sourceTolerance){
                splat.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
                return splat;
            }
        }
        if(!nwbOpticalReplayBootstrap(config, origin, direction, tolerance, events, count, media, result)){
            splat.termination = result.termination;
            return splat;
        }
    }
    else{
        float minimum = 0.0;
        bool complete = false;
        [loop] for(uint step = 0u; step <= NWB_CAUSTIC_MAX_BOUNCES; ++step){
            if(!nwbOpticalConsumeQuery(config, result))
                break;
            const NwbCausticHit previous = nwbCausticTraceClosest(photon.origin, -direction, minimum, NWB_FLOAT_MAX);
#if NWB_RT_CSG_ENABLED
            if(previous.failure != 0u)
                break;
#endif
            if(!previous.hit){
                complete = true;
                break;
            }
            if(step == NWB_CAUSTIC_MAX_BOUNCES || !isfinite(previous.t) || previous.t < minimum)
                break;
            minimum = asfloat(asuint(previous.t) + 1u);
            const float margin = exteriorMarginMinimum + NWB_OPTICS_POSITION_TOLERANCE_SCALE * nwbOpticsPositionUncertainty(previous.worldPos);
            origin = previous.worldPos - direction * margin;
            if(!isfinite(minimum) || !all(isfinite(origin)))
                break;
        }
        if(!complete){
            splat.termination = result.termination;
            return splat;
        }
    }

    [loop] for(uint bounce = 0u; bounce < NWB_CAUSTIC_MAX_BOUNCES; ++bounce){
        if(max(max(flux.x, flux.y), flux.z) < NWB_CAUSTIC_FLUX_EPSILON || !nwbOpticalConsumeQuery(config, result))
            break;
        const NwbCausticHit hit = nwbCausticTraceClosest(origin, direction, 0.0, tMax);
#if NWB_RT_CSG_ENABLED
        if(hit.failure != 0u)
            break;
#endif
        if(!hit.hit)
            break;
        const float segmentDistance = length(hit.worldPos - physicalOrigin);
        if(!isfinite(segmentDistance) || segmentDistance <= 0.0){
            result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
            break;
        }
        const NwbOpticalMedium incident = nwbOpticalDominantMedium(media);
        flux *= nwbDielectricBeerTransmission(incident.absorption, segmentDistance);
        if(!hit.isRefractive){
            if(refractiveCrossings == 0u && media.count == 0u)
                break;
            splat.valid = true;
            splat.worldPos = hit.worldPos;
            splat.flux = flux;
            splat.termination = NWB_OPTICAL_TERMINATION_OPAQUE;
            return splat;
        }
        NwbCausticBoundary boundary;
        if(!nwbCausticCheckBoundary(config, origin, direction, hit, boundary, result))
            break;
        NwbOpticalInstance optical;
        if(!nwbOpticalReadInstance(config, hit.instance, optical, result))
            break;
        NwbOpticalMedium medium = (NwbOpticalMedium)0;
        medium.instance = hit.instance;
        medium.entityId = optical.entityId;
        medium.priority = optical.priority;
        medium.mode = optical.mode;
        if(!nwbOpticalLoadHomogeneousMedium(config, hit.worldPos, direction, medium, result))
            break;
        const bool entering = dot(direction, boundary.geometricNormal) < 0.0;
        NwbOpticalMedia transmittedMedia = media;
        if(!nwbOpticalApplyBoundary(medium, entering, transmittedMedia, result))
            break;
        const NwbOpticalMedium transmitted = nwbOpticalDominantMedium(transmittedMedia);
        const float3 normal = entering ? boundary.geometricNormal : -boundary.geometricNormal;
        const NwbDielectricInterface interface = nwbDielectricTransmit(direction, normal, incident.ior, transmitted.ior);
        if(interface.totalInternalReflection){
            ++result.tirCount;
            break;
        }
        flux *= half(1.0 - interface.reflectedFraction);
        media = transmittedMedia;
        ++refractiveCrossings;
        physicalOrigin = hit.worldPos;
        direction = interface.direction;
        const float3 offsetNormal = dot(direction, boundary.geometricNormal) >= 0.0 ? boundary.geometricNormal : -boundary.geometricNormal;
        origin = hit.worldPos + offsetNormal * nwbOpticsPositionUncertainty(hit.worldPos);
    }
    splat.termination = result.termination;
    return splat;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct NwbCausticEmission{
    bool valid;
    float3 origin;
    float3 direction;
    float domainArea;
};

void nwbCausticEmissionBasis(float3 axis, out float3 right, out float3 up){
    const float3 reference = abs(axis.z) < NWB_FRAME_FALLBACK_AXIS_Z_MAX ? float3(0.0, 0.0, 1.0) : float3(0.0, 1.0, 0.0);
    right = nwbSafeNormalize(cross(reference, axis), float3(1.0, 0.0, 0.0));
    up = nwbSafeNormalize(cross(axis, right), float3(0.0, 1.0, 0.0));
}

float2 nwbCausticProjectAabbExtent(float3 aabbMin, float3 aabbMax, float3 right, float3 up){
    const float3 halfExtent = (aabbMax - aabbMin) * 0.5;
    return float2(abs(right.x) * halfExtent.x + abs(right.y) * halfExtent.y + abs(right.z) * halfExtent.z, abs(up.x) * halfExtent.x + abs(up.y) * halfExtent.y + abs(up.z) * halfExtent.z);
}

uint nwbCausticHashU32(uint x){
    x ^= x >> NWB_CAUSTIC_HASH_OUTER_SHIFT;
    x *= NWB_CAUSTIC_HASH_FIRST_MULTIPLIER;
    x ^= x >> NWB_CAUSTIC_HASH_MIDDLE_SHIFT;
    x *= NWB_CAUSTIC_HASH_SECOND_MULTIPLIER;
    x ^= x >> NWB_CAUSTIC_HASH_OUTER_SHIFT;
    return x;
}

// Deterministic stratified emission jitter shared by both backends.
float2 nwbCausticEmissionJitter(uint photonIndex){
    const uint h0 = nwbCausticHashU32(photonIndex * NWB_CAUSTIC_JITTER_GOLDEN_RATIO + NWB_CAUSTIC_JITTER_SEED_OFFSET);
    const uint h1 = nwbCausticHashU32(h0 ^ NWB_CAUSTIC_JITTER_SECOND_SEED_SALT);
    return float2((float)(h0 >> NWB_CAUSTIC_JITTER_DROPPED_BITS) * NWB_CAUSTIC_JITTER_UNIT_SCALE, (float)(h1 >> NWB_CAUSTIC_JITTER_DROPPED_BITS) * NWB_CAUSTIC_JITTER_UNIT_SCALE);
}

// Frame-parity checkerboards cover the full grid in two frames and retain jitter keyed to the physical full-grid cell.
// Phase count1 is the non-temporal full-grid path.
float2 nwbCausticJitteredTemporalCell(const uint photonIndex, const uint gridSide, const uint frameIndex, const uint temporalPhaseCount){
    const uint fullGridSide = max(gridSide, 1u);
    const uint phaseCount = temporalPhaseCount == NWB_CAUSTIC_TEMPORAL_PHASE_COUNT ? NWB_CAUSTIC_TEMPORAL_PHASE_COUNT : NWB_CAUSTIC_TEMPORAL_DISABLED_PHASE_COUNT;
    const uint phase = frameIndex % phaseCount;
    uint row = 0u;
    uint column = 0u;

    if(phaseCount == NWB_CAUSTIC_TEMPORAL_PHASE_COUNT){
        const uint halfWidth = max(fullGridSide >> 1u, 1u);
        row = photonIndex / halfWidth;
        const uint pair = photonIndex % halfWidth;
        const uint parityColBase = ((row & 1u) != 0u) ? (phase ^ 1u) : phase;
        column = parityColBase + NWB_CAUSTIC_TEMPORAL_PHASE_COUNT * pair;
    }
    else{
        row = photonIndex / fullGridSide;
        column = photonIndex % fullGridSide;
    }
    const float2 jitter = nwbCausticEmissionJitter(column + row * fullGridSide);
    return (float2(column, row) + jitter) / (float)fullGridSide;
}

// Aim each photon at one refractive target's projected AABB.
NwbCausticEmission nwbCausticEmitPhotonAtTarget(float3 lightDir, float3 aabbMin, float3 aabbMax, float2 cell){
    NwbCausticEmission emission;
    emission.valid = false;
    emission.origin = float3(0.0, 0.0, 0.0);
    emission.direction = lightDir;
    emission.domainArea = 0.0;

    const float3 axis = nwbSafeNormalize(lightDir, float3(0.0, 0.0, -1.0));
    float3 right;
    float3 up;
    nwbCausticEmissionBasis(axis, right, up);

    const float3 center = (aabbMin + aabbMax) * 0.5;
    const float2 extent = nwbCausticProjectAabbExtent(aabbMin, aabbMax, right, up);
    emission.domainArea = max(4.0 * extent.x * extent.y, NWB_CAUSTIC_MIN_EMISSION_AREA);

    const float2 offset = (cell * 2.0 - 1.0) * extent;
    const float3 target = center + right * offset.x + up * offset.y;

    const float backoff = length(aabbMax - aabbMin) + 1.0;
    emission.origin = target - axis * backoff;
    emission.direction = axis;
    emission.valid = true;
    return emission;
}

half3 nwbCausticLightColor(const float4 colorIntensity){
    return half3(clamp(colorIntensity.xyz, float3(0.0), float3(NWB_CAUSTIC_LIGHT_COLOR_MAX))) * half(min(max(colorIntensity.w, 0.0), NWB_CAUSTIC_LIGHT_INTENSITY_MAX));
}

NwbCausticPhoton nwbCausticCreatePhoton(const NwbCausticEmission emission, const half3 lightColor, const uint emissionTargetCount, const uint photonCount, const bool finiteOrigin, const float3 sourcePosition){
    // Photon budgets exceed the finite half range; normalize energy in float before quantizing the final flux.
    const float perPhoton = emission.domainArea * float(emissionTargetCount) / float(max(photonCount, 1u));

    NwbCausticPhoton photon;
    photon.origin = finiteOrigin ? emission.origin + emission.direction * dot(sourcePosition - emission.origin, emission.direction) : emission.origin;
    photon.direction = emission.direction;
    photon.flux = half3(float3(lightColor) * perPhoton);
    photon.finiteOrigin = finiteOrigin;
    return photon;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


