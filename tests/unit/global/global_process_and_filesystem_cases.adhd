class ThrowingCaptureOutput{
    public i64 childPid = 0;
    private String m_text;

    public void clear(){ this.m_text.clear(); this.childPid = 0; }

    public usize size()const{ return this.m_text.size(); }

    [cpp_unwind]
    public void append(in StringView text){
        if(text.size() > 64u - this.m_text.size())
            ThrowCaptureError("child PID output exceeded the bounded fixture buffer");
        this.m_text.append(text);
        const StringView output = StringView(this.m_text);
        const usize lineEnd = output.find('\n');
        if(lineEnd == usize.max)
            return;
        const auto parsed = ParseU64(output.substr(0u, lineEnd));
        if(!parsed.has_value() || parsed.value() == 0u || parsed.value() > s_MaxChildPid)
            ThrowCaptureError("child PID output was invalid");
        this.childPid = cast<i64>(parsed.value());
        ThrowCaptureError("fixture output append failure");
    }
}


