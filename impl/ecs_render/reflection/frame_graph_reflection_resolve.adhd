#include <impl/ecs_csg/frame_state.adhd>
#include <impl/ecs_render/deferred/deferred_frame_targets.adhd>
#include <impl/ecs_render/mesh/mesh_view_private.adhd>
#include <impl/ecs_render/raytrace/task_graph_scene_resources.adhd>
#include <impl/ecs_render/reflection/reflection_system.adhd>
#include <impl/ecs_render/reflection/task_graph_reflection.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class FrameGraphReflectionResolveInputs{
    public mut DeferredFrameTargets targets;
    public in MeshViewBufferSnapshot meshViewSnapshot;
    public in RayTracingSceneGraphResources sceneResources;
    public in ReflectionSettings reflectionSettings;
    public in ReflectionSceneContentStamp contentStamp;
    public in CsgFrameState csgFrameState;
    public u32 reflectionFrameIndex = 0u;
    public b8 reflectionSceneAvailable = false;
    public b8 useLaggedLightingHistory = false;
    public GpuGraphResourceId specularRoughness;
    public GpuGraphResourceId refractionSpecularRoughness;
    public GpuGraphResourceId normal;
    public GpuGraphResourceId depth;
    public GpuGraphResourceId worldPosition;
    public GpuGraphResourceId refractionDepth;
    public GpuGraphResourceId refractionNormalIor;
    public GpuGraphResourceId opaqueColor;
    public GpuGraphResourceId meshView;
    public GpuGraphResourceId currentBindlessSlots;
    public GpuGraphResourceId sceneShading;
    public GpuGraphResourceId lights;
    public GpuGraphResourceSetId hardwareTraceGeometrySet;
    public GpuGraphResourceSetId traceMaterialSampledTextureSet;
    public GpuTaskId traceContextUploadTask;
    public GpuTaskId lightingTask;
    public in b8 hardwarePreparationReady;
    public mut b8 hardwareDispatchLogged;
    public mut b8 fallbackDispatchLogged;

    public FrameGraphReflectionResolveInputs(
        mut DeferredFrameTargets targets,
        in MeshViewBufferSnapshot meshViewSnapshot,
        in RayTracingSceneGraphResources sceneResources,
        in ReflectionSettings reflectionSettings,
        in ReflectionSceneContentStamp contentStamp,
        in CsgFrameState csgFrameState,
        in borrow b8 hardwarePreparationReady,
        mut b8 hardwareDispatchLogged,
        mut b8 fallbackDispatchLogged
    ){
        this.targets = targets;
        this.meshViewSnapshot = meshViewSnapshot;
        this.sceneResources = sceneResources;
        this.reflectionSettings = reflectionSettings;
        this.contentStamp = contentStamp;
        this.csgFrameState = csgFrameState;
        this.hardwarePreparationReady = hardwarePreparationReady;
        this.hardwareDispatchLogged = hardwareDispatchLogged;
        this.fallbackDispatchLogged = fallbackDispatchLogged;
    }
}

class FrameGraphReflectionResolveResult{
    public ReflectionGraphResult reflectionGraph;
    public ReflectionCompositeInputs reflectionCompositeInputs;
}

class FrameGraphReflectionResolve : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut GraphicsRuntime m_graphics;
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut RendererReflectionSystem m_reflectionSystem;

    public FrameGraphReflectionResolve(mut GpuTaskGraph graph, mut GraphicsRuntime graphics, mut RendererRayTracingSystem raytracingSystem, mut RendererReflectionSystem reflectionSystem){
        this.m_graph = graph;
        this.m_graphics = graphics;
        this.m_raytracingSystem = raytracingSystem;
        this.m_reflectionSystem = reflectionSystem;
    }

    public Expected<FrameGraphReflectionResolveResult> declare(in FrameGraphReflectionResolveInputs inputs, mut RayTracingSceneGraphReads sceneReads);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

