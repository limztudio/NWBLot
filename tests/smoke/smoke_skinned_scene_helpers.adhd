namespace NWB::Tests::Smoke{
using SmokeModelRef = Core::Assets::AssetRef<Impl::Model>;
using Core::Alloc::GlobalArena;
using Core::Assets::AssetManager;
using Impl::SkeletonJointMatrix;
using ModelObjectKindEnum = Impl::ModelObjectKind::Enum;
using SkeletonJointMatrixVector = Vector<Impl::SkeletonJointMatrix, Core::Alloc::GlobalArena>;

class SmokeRenderQualitySettings;
[[nodiscard]] NotNullUniquePtr<Core::ECS::World> CreateSmokeSkinnedRenderWorldOrDie(TStringView projectName, const SmokeRenderQualitySettings& baseSettings, ProjectRuntimeContext& context);
[[nodiscard]] NotNullUniquePtr<Core::ECS::World> CreateSmokeSkinnedRenderWorldOrDie(TStringView projectName, ProjectRuntimeContext& context);
};


