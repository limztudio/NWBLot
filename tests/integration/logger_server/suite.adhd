void VerifyCrashReportComposerTests_TombstoneStackMovesBeforeDetailsWithoutBorrowingClearedText(){
    HeapStorage testArena = HeapStorage();
    CrashPackageSummary summary = CrashPackageSummary(testArena);
    summary.triggerMessage = "fault";
    String details = "package=one\n[tombstone_callstack]\nframe-one\n[metadata]\nkey=value\n";

    const String report = BuildOrderedCrashReport(summary, details);
    EXPECT_EQ(StringView(report), "fault\n\ncallstack:\nframe-one\n\ndetails:\npackage=one\n[metadata]\nkey=value\n");
}

void VerifyCrashReportComposerTests_EmptyPrimaryStackTakesPrecedenceOverTombstone(){
    HeapStorage testArena = HeapStorage();
    CrashPackageSummary summary = CrashPackageSummary(testArena);
    String details = "[callstack]\n\n[tombstone_callstack]\nfallback\n";

    const String report = BuildOrderedCrashReport(summary, details);
    EXPECT_EQ(StringView(report), "callstack:\n<unavailable>\n\ndetails:\n[tombstone_callstack]\nfallback\n");
}

void VerifyCrashReportComposerTests_TrimsAcrossRemovedSection(){
    HeapStorage testArena = HeapStorage();
    CrashPackageSummary summary = CrashPackageSummary(testArena);
    String before = " \n[callstack]\nframe\n[metadata]\n value \n";
    const String first = BuildOrderedCrashReport(summary, before);
    EXPECT_EQ(StringView(first), "callstack:\nframe\n\ndetails:\n[metadata]\n value\n");

    String after = " left \n[callstack]\nframe\n";
    const String second = BuildOrderedCrashReport(summary, after);
    EXPECT_EQ(StringView(second), "callstack:\nframe\n\ndetails:\nleft\n");

    String whitespace = " \t\n";
    const String third = BuildOrderedCrashReport(summary, whitespace);
    EXPECT_EQ(StringView(third), "callstack:\n<unavailable>\n\ndetails:\n");
}

void VerifyCrashManifestTests_FindsExactKeysAtBoundaries(){
    const Expected<usize> emptyKey = FindGeneratedCrashJsonValueCursor("\"\": ", "");
    ASSERT_TRUE(emptyKey.has_value());
    EXPECT_EQ(emptyKey.value(), 4u);
    const StringView collision = "\"ab\": 1, \"a\": ";
    const Expected<usize> exact = FindGeneratedCrashJsonValueCursor(collision, "a");
    ASSERT_TRUE(exact.has_value());
    EXPECT_EQ(exact.value(), collision.size());
    EXPECT_FALSE(FindGeneratedCrashJsonValueCursor("\"a\":", "a").has_value());
    EXPECT_TRUE(HasGeneratedCrashJsonStringValue("\"a\": \"value\\n\"", "a"));
    EXPECT_FALSE(HasGeneratedCrashJsonStringValue("\"a\": \"value\\x\"", "a"));
    EXPECT_FALSE(HasGeneratedCrashJsonStringValue("\"a\": \"value\\", "a"));
    const Expected<usize> quoted = FindGeneratedCrashJsonValueCursor("\"a\"b\": 0", "a\"b");
    ASSERT_TRUE(quoted.has_value());
    EXPECT_EQ(quoted.value(), 7u);
}


