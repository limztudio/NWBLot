    ExpectCompileFails(arena, "#define BAD_MACRO(x, x) (x)\r\nconst i32 kVal = 1;\r\n", "impl/bad_macro_param.adhd");
    ExpectCompileFails(arena, "i32 BadCast() {\r\n    return (i32)-1;\r\n}\r\n", "impl/bad_unary_cast.adhd");
    ExpectCompileFails(arena, "u64 BadBitCast(in f32 x) {\r\n    return bit_cast<u64>(x);\r\n}\r\n", "impl/bad_bit_cast.adhd");
    ExpectCompileFails(arena, "in i32 BadReturnRef() {\r\n    i32 localVal = 7;\r\n    return localVal;\r\n}\r\n", "impl/bad_dangling_ret.adhd");
    ExpectCompileFails(arena, "void MutateInt(mut i32 v) { v = v + 1; }\r\nvoid Caller(in i32 a, in i32 b) {\r\n    MutateInt(a + b);\r\n}\r\n", "impl/bad_rvalue_mut.adhd");
    ExpectCompileFails(arena, s_SuiteEarlyReturnCtorSource, "impl/bad_early_ret_ctor.adhd");
    ExpectCompileFails(arena, "void BadParSet(in Set<i32> items) {\r\n    parallel_for(in i32 x : items) {\r\n    }\r\n}\r\n", "impl/bad_par_set.adhd");
}

void VerifyAdhdCompiler_RequiresExplicitHeaderOrSourceOnTopLevelNativeBlocks(){
    AdhdTestArena arena = AdhdTestArena();

    CompileResult explicitRes = CompileResult(arena.arena);
    ASSERT_TRUE(Compile("[source]\r\nnative{\r\nstatic constexpr int kOnlyInCpp = 42;\r\n}\r\nconst u32 s_AfterSourceBlock = 7u;\r\n[header]\r\nnative{\r\nstruct ExplicitHeaderTag {};\r\n}\r\n", "impl/explicit_native_targets.adhd", arena.arena, explicitRes));
    EXPECT_EQ(GeneratedHeaderView(explicitRes).find("kOnlyInCpp"), usize.max);
    EXPECT_NE(GeneratedSourceView(explicitRes).find("kOnlyInCpp"), usize.max);
    EXPECT_NE(GeneratedHeaderView(explicitRes).find("ExplicitHeaderTag"), usize.max);
    EXPECT_EQ(GeneratedSourceView(explicitRes).find("ExplicitHeaderTag"), usize.max);
    EXPECT_NE(GeneratedHeaderView(explicitRes).find("s_AfterSourceBlock"), usize.max);

    ExpectCompileFailsWithMessage(arena, "native{\r\nstruct MissingTarget {};\r\n}\r\n", "impl/missing_native_target.adhd", "top-level 'native' block must specify '[header]' or '[source]'");
    ExpectCompileFailsWithMessage(arena, "[header, source]\r\nnative{\r\n}\r\n", "impl/conflict_native.adhd", "duplicate or conflicting target attribute on top-level 'native' block");
    ExpectCompileFailsWithMessage(arena, "[source(1)]\r\nnative{\r\n}\r\n", "impl/arg_native.adhd", "top-level 'native' target attribute does not accept arguments");
    ExpectCompileFailsWithMessage(arena, "[reflect]\r\nnative{\r\n}\r\n", "impl/bad_native_attr.adhd", "unsupported attribute on top-level 'native' block; only '[header]' or '[source]' is permitted");
    ExpectCompileFailsWithMessage(arena, "void ScopedFn() {\r\n    [header]\r\n    native{}\r\n}\r\n", "impl/scoped_native_attr.adhd", "attributes are not permitted on 'native' blocks");
}

