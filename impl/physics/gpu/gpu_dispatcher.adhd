    public PhysicsGpuBufferSlot uvSlot;
    public PhysicsGpuBufferSlot meshletMetaSlot;
    public PhysicsGpuBufferSlot meshletVertSlot;
    public PhysicsGpuBufferSlot meshletTriSlot;

    public void clearState(){
        this.topoKey = 0u;
        this.lastUsedEpoch = 0u;
        this.valid = false;
        this.gpuValid = false;
    }
}

class RetiredPhysicsGpuComputeBuffer{
    public BufferHandle buffer;
    public GpuDescriptorHandle descriptor;
    public QueueSubmissionToken retireAfterToken;
}

class ResidentFallbackShapeEntry{
    public u32 shapeId = 0u;
    public u32 bodyId = 0u;
    public u32 resSlot = 0u;
    public Aabb3D aabb;
}

