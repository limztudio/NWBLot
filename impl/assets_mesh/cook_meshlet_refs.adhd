////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_mesh/payload_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_MeshMetaKindText = "Mesh";
const StringView s_VertexRefPositionName = "position";
const StringView s_VertexRefNormalName = "normal";
const StringView s_VertexRefTangentName = "tangent";
const StringView s_VertexRefUvName = "uv0";
const StringView s_VertexRefColorName = "color";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[serialize]
class MeshVertexRef{
    public u32 position = s_MeshMissingStreamIndex;
    public u32 normal = s_MeshMissingStreamIndex;
    public u32 tangent = s_MeshMissingStreamIndex;
    public u32 uv0 = s_MeshMissingStreamIndex;
    public u32 color = s_MeshMissingStreamIndex;
}

class MeshletRefEncodeRange{
    public u32 minimum = 0xffffffffu;
    public u32 maximum = 0u;
}

class MeshletAttributeRefEncodeRanges{
    public MeshletRefEncodeRange normal;
    public MeshletRefEncodeRange tangent;
    public MeshletRefEncodeRange uv0;
    public MeshletRefEncodeRange color;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


MeshletRefDeltaWidth MeshletRefDeltaWidthForMaxDelta(in u32 maxDelta){
    if(maxDelta <= 0xffu)
        return MeshletRefDeltaWidth::U8;
    if(maxDelta <= 0xffffu)
        return MeshletRefDeltaWidth::U16;
    return MeshletRefDeltaWidth::U32;
}

u32 PackMeshletRefEncodingWidth(in MeshletRefDeltaWidth width, in u32 shift){
    return (cast<u32>(width) & s_MeshletRefEncodingWidthMask) << shift;
}

u32 PackMeshletRefEncoding(in MeshletRefDeltaWidth positionWidth, in MeshletRefDeltaWidth skinWidth, in MeshletRefDeltaWidth normalWidth, in MeshletRefDeltaWidth tangentWidth, in MeshletRefDeltaWidth uv0Width, in MeshletRefDeltaWidth colorWidth){
    return
        PackMeshletRefEncodingWidth(positionWidth, s_MeshletRefEncodingPositionShift)
        | PackMeshletRefEncodingWidth(skinWidth, s_MeshletRefEncodingSkinShift)
        | PackMeshletRefEncodingWidth(normalWidth, s_MeshletRefEncodingNormalShift)
        | PackMeshletRefEncodingWidth(tangentWidth, s_MeshletRefEncodingTangentShift)
        | PackMeshletRefEncodingWidth(uv0Width, s_MeshletRefEncodingUv0Shift)
        | PackMeshletRefEncodingWidth(colorWidth, s_MeshletRefEncodingColorShift)
    ;
}

void AddMeshletRefEncodeIndex(in u32 index, mut MeshletRefEncodeRange range){
    range.minimum = min(range.minimum, index);
    range.maximum = max(range.maximum, index);
}

void AddMeshletAttributeRefEncodeRanges(in MeshletAttributeStreamRef streamRef, mut MeshletAttributeRefEncodeRanges ranges){
    AddMeshletRefEncodeIndex(streamRef.normal, ranges.normal);
    AddMeshletRefEncodeIndex(streamRef.tangent, ranges.tangent);
    AddMeshletRefEncodeIndex(streamRef.uv0, ranges.uv0);
    AddMeshletRefEncodeIndex(streamRef.color, ranges.color);
}

void StoreMeshletAttributeRefEncodeBases(in MeshletAttributeRefEncodeRanges ranges, mut MeshletDesc meshlet){
    meshlet.normalBase = ranges.normal.minimum;
    meshlet.tangentBase = ranges.tangent.minimum;
    meshlet.uv0Base = ranges.uv0.minimum;
    meshlet.colorBase = ranges.color.minimum;
}

MeshletRefDeltaWidth MeshletRefEncodeRangeWidth(in MeshletRefEncodeRange range){
    return MeshletRefDeltaWidthForMaxDelta(range.maximum - range.minimum);
}

b8 MeshletDecodedPositionRefMatches(in MeshletPositionStreamRef decoded, in MeshletPositionStreamRef source, in b8 skinRequired){
    if(decoded.position != source.position)
        return false;
    if(skinRequired)
        return decoded.skin == source.skin;
    return decoded.skin == s_MeshMissingStreamIndex;
}

b8 MeshletDecodedAttributeRefMatches(in MeshletAttributeStreamRef decoded, in MeshletAttributeStreamRef source){
    return decoded.normal == source.normal && decoded.tangent == source.tangent && decoded.uv0 == source.uv0 && decoded.color == source.color;
}

Expected<u16> TryFindMeshletPositionRef(in Span<MeshletPositionStreamRef> refs, in MeshletPositionStreamRef targetRef){
    for(usize localIndex = 0u; localIndex < refs.size(); ++localIndex){
        if(refs[localIndex].position != targetRef.position || refs[localIndex].skin != targetRef.skin)
            continue;

        return cast<u16>(localIndex);
    }

    return makeUnexpected(Failure());
}

Expected<u16> TryFindMeshletAttributeRef(in Span<MeshletAttributeStreamRef> refs, in MeshletAttributeStreamRef targetRef){
    for(usize localIndex = 0u; localIndex < refs.size(); ++localIndex){
        const MeshletAttributeStreamRef existing = refs[localIndex];
        if(existing.normal != targetRef.normal || existing.tangent != targetRef.tangent || existing.uv0 != targetRef.uv0 || existing.color != targetRef.color)
            continue;

        return cast<u16>(localIndex);
    }

    return makeUnexpected(Failure());
}

b8 BuildZippedMeshletRefsFixed(
    in StringView metaKind,
    in StringView filePathText,
    in Span<MeshVertexRef> vertexRefs,
    in Span<u32> sourceVertexRefs,
    mut FixedVector<MeshletPositionStreamRef, s_MeshMaxMeshletVertices> outPositionRefs,
    mut FixedVector<MeshletAttributeStreamRef, s_MeshMaxMeshletVertices> outAttributeRefs,
    mut FixedVector<MeshletLocalVertexRef, s_MeshMaxMeshletVertices> outLocalVertexRefs
){
    outPositionRefs.clear();
    outAttributeRefs.clear();
    outLocalVertexRefs.clear();

    for(in u32 vertexRefIndex : sourceVertexRefs){
        const MeshVertexRef source = vertexRefs[cast<usize>(vertexRefIndex)];
        MeshletPositionStreamRef positionRef;
        positionRef.position = source.position;
        positionRef.skin = s_MeshMissingStreamIndex;
        MeshletAttributeStreamRef attributeRef;
        attributeRef.normal = source.normal;
        attributeRef.tangent = source.tangent;
        attributeRef.uv0 = source.uv0;
        attributeRef.color = source.color;

        u16 localPosition = 0u;
        const Expected<u16> foundPosition = TryFindMeshletPositionRef(outPositionRefs, positionRef);
        if(foundPosition.has_value())
            localPosition = foundPosition.value();
        else{
            if(outPositionRefs.size() >= cast<usize>(s_MeshMaxMeshletVertices)){
                error("{} meta '{}': meshlet deformed positions exceed local index limits", metaKind, filePathText);
                return false;
            }
            localPosition = cast<u16>(outPositionRefs.size());
            outPositionRefs.push_back(positionRef);
        }

        u16 localAttribute = 0u;
        const Expected<u16> foundAttribute = TryFindMeshletAttributeRef(outAttributeRefs, attributeRef);
        if(foundAttribute.has_value())
            localAttribute = foundAttribute.value();
        else{
            if(outAttributeRefs.size() >= cast<usize>(s_MeshMaxMeshletVertices)){
                error("{} meta '{}': meshlet attributes exceed local index limits", metaKind, filePathText);
                return false;
            }
            localAttribute = cast<u16>(outAttributeRefs.size());
            outAttributeRefs.push_back(attributeRef);
        }

        MeshletLocalVertexRef localVertexRef;
        localVertexRef.localDeformedPosition = localPosition;
        localVertexRef.localAttribute = localAttribute;
        outLocalVertexRefs.push_back(localVertexRef);
    }

    return true;
}

b8 RemapMeshStreamIndex(
    in Name virtualPath,
    in StringView metaKind,
    in StringView streamName,
    in usize sourceCount,
    in usize reorderedCount,
    mut Vector<u32> inOutRemap,
    mut u32 inOutIndex,
    mut b8 outAppendedNew,
    mut usize outSourceIndex
){
    outAppendedNew = false;
    outSourceIndex = 0u;
    if(inOutIndex == s_MeshMissingStreamIndex){
        error(
            "{} meta '{}': meshlet {} stream reference is missing"
            , metaKind
            , virtualPath.resolvedText()
            , streamName
        );
        return false;
    }

    const u32 sourceIndex = inOutIndex;
    if(cast<usize>(sourceIndex) >= sourceCount){
        error(
            "{} meta '{}': meshlet {} stream reference is out of range"
            , metaKind
            , virtualPath.resolvedText()
            , streamName
        );
        return false;
    }

    u32 mappedIndex = inOutRemap[cast<usize>(sourceIndex)];
    if(mappedIndex == s_MeshMissingStreamIndex){
        if(reorderedCount >= cast<usize>(s_MeshMissingStreamIndex)){
            error(
                "{} meta '{}': reordered {} stream exceeds u32 index limits"
                , metaKind
                , virtualPath.resolvedText()
                , streamName
            );
            return false;
        }
        mappedIndex = cast<u32>(reorderedCount);
        inOutRemap[cast<usize>(sourceIndex)] = mappedIndex;
        outAppendedNew = true;
        outSourceIndex = cast<usize>(sourceIndex);
    }

    inOutIndex = mappedIndex;
    return true;
}

b8 RemapMeshStreamRef<T>(
    in Name virtualPath,
    in StringView metaKind,
    in StringView streamName,
    in Vector<T> source,
    mut Vector<u32> inOutRemap,
    mut Vector<T> inOutReordered,
    mut u32 inOutIndex
){
    b8 appendedNew = false;
    usize sourceIndex = 0u;
    if(!RemapMeshStreamIndex(virtualPath, metaKind, streamName, source.size(), inOutReordered.size(), inOutRemap, inOutIndex, appendedNew, sourceIndex))
        return false;
    if(appendedNew)
        inOutReordered.push_back(source[sourceIndex]);
    return true;
}

void CopyReorderedMeshStream<T>(in Vector<T> reordered, mut Vector<T> outStream){
    outStream.clear();
    outStream.reserve(reordered.size());
    for(in T value : reordered)
        outStream.push_back(value);
}

b8 ReorderMeshStreamsByMeshletTraversal(
    in Name virtualPath,
    in Span<MeshletDesc> meshlets,
    mut Vector<f32x3u> inOutPositions,
    mut Vector<f16x4u> inOutNormals,
    mut Vector<f16x4u> inOutTangents,
    mut Vector<f32x2u> inOutUv0,
    mut Vector<f16x4u> inOutColors,
    mut Vector<MeshletPositionStreamRef> inOutPositionRefs,
    mut Vector<MeshletAttributeStreamRef> inOutAttributeRefs
){
    Vector<f32x3u> reorderedPositions;
    Vector<f16x4u> reorderedNormals;
    Vector<f16x4u> reorderedTangents;
    Vector<f32x2u> reorderedUv0;
    Vector<f16x4u> reorderedColors;
    Vector<u32> positionRemap;
    Vector<u32> normalRemap;
    Vector<u32> tangentRemap;
    Vector<u32> uv0Remap;
    Vector<u32> colorRemap;

    reorderedPositions.reserve(inOutPositions.size());
    reorderedNormals.reserve(inOutNormals.size());
    reorderedTangents.reserve(inOutTangents.size());
    reorderedUv0.reserve(inOutUv0.size());
    reorderedColors.reserve(inOutColors.size());
    positionRemap.resize(inOutPositions.size(), s_MeshMissingStreamIndex);
    normalRemap.resize(inOutNormals.size(), s_MeshMissingStreamIndex);
    tangentRemap.resize(inOutTangents.size(), s_MeshMissingStreamIndex);
    uv0Remap.resize(inOutUv0.size(), s_MeshMissingStreamIndex);
    colorRemap.resize(inOutColors.size(), s_MeshMissingStreamIndex);

    for(in MeshletDesc meshlet : meshlets){
        for(u32 localPositionIndex = 0u; localPositionIndex < MeshletPositionCount(meshlet); ++localPositionIndex){
            const usize refOffset = cast<usize>(meshlet.positionRefOffset + localPositionIndex);
            MeshletPositionStreamRef ref = inOutPositionRefs[refOffset];
            if(!RemapMeshStreamRef(virtualPath, s_MeshMetaKindText, s_VertexRefPositionName, inOutPositions, positionRemap, reorderedPositions, ref.position))
                return false;
            if(ref.skin != s_MeshMissingStreamIndex){
                error("{} meta '{}': static meshlet position reference cannot contain skin", s_MeshMetaKindText, virtualPath.resolvedText());
                return false;
            }
            inOutPositionRefs[refOffset] = ref;
        }
    }

    for(in MeshletDesc meshlet : meshlets){
        for(u32 localAttributeIndex = 0u; localAttributeIndex < MeshletAttributeCount(meshlet); ++localAttributeIndex){
            const usize refOffset = cast<usize>(meshlet.attributeRefOffset + localAttributeIndex);
            MeshletAttributeStreamRef ref = inOutAttributeRefs[refOffset];
            if(!RemapMeshStreamRef(virtualPath, s_MeshMetaKindText, s_VertexRefNormalName, inOutNormals, normalRemap, reorderedNormals, ref.normal))
                return false;
            if(!RemapMeshStreamRef(virtualPath, s_MeshMetaKindText, s_VertexRefTangentName, inOutTangents, tangentRemap, reorderedTangents, ref.tangent))
                return false;
            if(!RemapMeshStreamRef(virtualPath, s_MeshMetaKindText, s_VertexRefUvName, inOutUv0, uv0Remap, reorderedUv0, ref.uv0))
                return false;
            if(!RemapMeshStreamRef(virtualPath, s_MeshMetaKindText, s_VertexRefColorName, inOutColors, colorRemap, reorderedColors, ref.color))
                return false;
            inOutAttributeRefs[refOffset] = ref;
        }
    }

    CopyReorderedMeshStream(reorderedPositions, inOutPositions);
    CopyReorderedMeshStream(reorderedNormals, inOutNormals);
    CopyReorderedMeshStream(reorderedTangents, inOutTangents);
    CopyReorderedMeshStream(reorderedUv0, inOutUv0);
    CopyReorderedMeshStream(reorderedColors, inOutColors);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
