using namespace NWB;
using namespace NWB::Impl;
using namespace NWB::Impl::Ui;

struct AssetFactorySdfSample{
    SharedSdfAtlasPage page;
    Sha256Digest sourceHash;
    b8 valid = false;
};


class UiPaintSdfTests : public NWB::UiPaintTextTests::PaintTextFixture{
public:
    [[nodiscard]] b8 prepareSingleSdfPage(const SharedSdfAtlasPage& page){
        return m_builder.prepareSdfPages(Span(&page, 1u));
    }

    [[nodiscard]] b8 prepareGlyphSpanAndSingleSdf(const Span<const SharedGlyphPage> glyphs, const SharedSdfAtlasPage& sdf){
        return m_builder.prepareImages(glyphs, Span(&sdf, 1u));
    }

    [[nodiscard]] b8 prepareSingleGlyphAndSingleSdf(const SharedGlyphPage& glyph, const SharedSdfAtlasPage& sdf){
        return m_builder.prepareImages(Span(&glyph, 1u), Span(&sdf, 1u));
    }

    [[nodiscard]] Expected<SharedSdfAtlasPage> createMovedSdfPage(const SdfAtlasPageBinding& binding, SdfAtlasPage::Pixels& pixels){
        return CreateSdfAtlasPage(m_arena, binding, Move(pixels));
    }

    [[nodiscard]] Expected<SharedSdfAtlasPage> createMovedSdfPage(const SdfAtlasPageBinding& binding, SdfAtlasPage::Pixels&& pixels){
        return CreateSdfAtlasPage(m_arena, binding, Move(pixels));
    }

    [[nodiscard]] AssetFactorySdfSample createPageFromTemporaryAtlas(){
        AssetFactorySdfSample sample;
        FontAtlas atlas(m_arena, Name(NWB::Tests::UiCases::s_UiCaseTestsUiFontAtlas));
        FontAtlasPayload payload(m_arena);
        payload.font = Core::Assets::AssetRef<Font>("tests/ui/font");
        payload.fontSha256.bytes[0u] = 99u;
        payload.unitsPerEm = 1000u;
        payload.sourceGlyphCount = 1u;
        payload.ascenderUnits = 800.0f;
        payload.descenderUnits = -200.0f;
        payload.glyphs.push_back({});
        FontAtlasGroup group(m_arena);
        group.width = 8u;
        group.height = 8u;
        group.pixels.resize(256u, 0u);
        group.pixels[3u] = 192u;
        group.sha256 = ComputeSha256(BinaryByteView(group.pixels.data(), group.pixels.size()));
        sample.sourceHash = group.sha256;
        payload.groups.push_back(Move(group));
        atlas.setPayload(Move(payload));
        Core::Alloc::ScratchArena scratchArena{ Name(NWB::Tests::UiCases::s_UiCaseTestsUiPaintSdfValidationScratch) };
        if(!atlas.validatePayload(scratchArena))
            return sample;
        auto pageResult = CreateSdfAtlasPage(m_arena, atlas, 7u, 123u, 0u);
        if(!pageResult)
            return sample;
        sample.page = Move(*pageResult);
        sample.valid = static_cast<b8>(sample.page != nullptr);
        return sample;
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


