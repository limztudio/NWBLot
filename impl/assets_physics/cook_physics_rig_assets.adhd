b8 SerializeFractureAsset(in FractureAsset asset, mut Vector<u8> outBinary){
    if(!asset.validatePayload())
        return false;
    return PhysicsRigBinaryCodec().serializeFractureCollectionUnchecked(asset.fractureCollection(), outBinary);
}

b8 SerializeSoftBodyAsset(in SoftBodyAsset asset, mut Vector<u8> outBinary){
    if(!asset.validatePayload())
        return false;
    return PhysicsRigBinaryCodec().serializeSoftBodyUnchecked(asset.softBody(), outBinary);
}

b8 SerializeRagdollAsset(in RagdollAsset asset, mut Vector<u8> outBinary){
    if(!asset.validatePayload())
        return false;
    return PhysicsRigBinaryCodec().serializeRagdollUnchecked(asset.ragdollData(), outBinary);
}

b8 SerializeArticulationAsset(in ArticulationAsset asset, mut Vector<u8> outBinary){
    if(!asset.validatePayload())
        return false;
    return PhysicsRigBinaryCodec().serializeArticulationUnchecked(asset.articulationData(), outBinary);
}

b8 SerializeVehicleAsset(in VehicleAsset asset, mut Vector<u8> outBinary){
    if(!asset.validatePayload())
        return false;
    return PhysicsRigBinaryCodec().serializeVehicleUnchecked(asset.vehicleData(), outBinary);
}


