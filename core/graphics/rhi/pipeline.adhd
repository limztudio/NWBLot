[cpp_header("<core/graphics/rhi/pipeline.h>"), cpp_name("::NWB::Core::PrimitiveType::Enum")]
extern enum PrimitiveType : u8{
    PointList,
    LineList,
    LineStrip,
    TriangleList,
    TriangleStrip,
    TriangleFan,
    TriangleListWithAdjacency,
    TriangleStripWithAdjacency,
    PatchList
};

[cpp_header("<core/graphics/rhi/pipeline.h>"), cpp_name("::NWB::Core::ShadingRateCombiner::Enum")]
extern enum ShadingRateCombiner : u8{
    Passthrough,
    Override,
    Min,
    Max,
    ApplyRelative
};

[cpp_header("<core/graphics/rhi/pipeline.h>"), cpp_name("::NWB::Core::VariableShadingRate::Enum")]
extern enum VariableShadingRate : u8{
    e1x1,
    e1x2,
    e2x1,
    e2x2,
    e2x4,
    e4x2,
    e4x4
};


