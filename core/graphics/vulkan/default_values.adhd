class AmdBreadcrumbSlotRecord{
    public u64 serial = 0u;
    public usize markerHash = 0u;
    public u32 marker = 0u;
}


class PhysicalQueueSharingPolicyResult{
    public i32 graphics = 0;
    public i32 auxiliaryGraphics = 0;
    public i32 compute = 0;
    public i32 auxiliaryCompute = 0;
    public i32 transfer = 0;
    public i32 auxiliaryTransfer = 0;
    public b8 asyncComputeLaneEnabled = false;
    public b8 transferQueueEnabled = false;
}


class VulkanQueueSubmissionReceipt{
    public u64 submittedID = 0u;
    public usize timelineWaitCount = 0u;
    public b8 accepted = false;
}


class VulkanShaderRecordPreflight{
    public usize handleOffset = 0u;
    public u64 recordByteSize = 0u;
    public u64 allocationByteSize = 0u;
    public u32 groupIndex = 0u;
    public u32 handleSize = 0u;
    public u32 handleSizeAligned = 0u;
    public u32 baseAlignment = 0u;
}


