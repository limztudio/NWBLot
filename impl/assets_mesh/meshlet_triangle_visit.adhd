////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_mesh/payload_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_FirstMeshletIndex = 0u;

b8 ForEachMeshletTriangleCorner<Visitor>(
    in Span<MeshletDesc> meshlets, in Span<MeshletLocalVertexRef> localVertexRefs,
    in Span<u8> primitiveIndices, mut forward Visitor visitor
)noexcept_like(cast<b8>(!visitor(meshlets[s_FirstMeshletIndex], s_FirstMeshletIndex, localVertexRefs[s_FirstMeshletIndex]))){
    for(usize meshletIndex = s_FirstMeshletIndex; meshletIndex < meshlets.size(); ++meshletIndex){
        in MeshletDesc meshlet = meshlets[meshletIndex];
        const u32 count = MeshletPrimitiveCount(meshlet);
        for(u32 primitive = 0u; primitive < count; ++primitive){
            const usize base = cast<usize>(meshlet.primitiveOffset) + cast<usize>(primitive) * s_MeshletTriangleIndexCount;
            for(u32 corner = 0u; corner < s_MeshletTriangleIndexCount; ++corner){
                const usize byteIndex = base + corner;
                if(byteIndex >= primitiveIndices.size())
                    return false;
                const usize refIndex = cast<usize>(meshlet.localVertexOffset) + primitiveIndices[byteIndex];
                if(refIndex >= localVertexRefs.size() || !visitor(meshlet, byteIndex, localVertexRefs[refIndex]))
                    return false;
            }
        }
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

