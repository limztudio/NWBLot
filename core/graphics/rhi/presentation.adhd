[cpp_header("<core/graphics/rhi/presentation.h>"), cpp_name("::NWB::Core::BeginFrameStatus::Enum")]
extern enum BeginFrameStatus : u8{
    Acquired,
    ResizeRequired,
    Failed,
    Count
};

[cpp_header("<core/graphics/rhi/presentation.h>"), cpp_name("::NWB::Core::PresentationReceiptStatus::Enum")]
extern enum PresentationReceiptStatus : u8{
    Pending,
    Accepted,
    Rejected
};

[cpp_header("<core/graphics/rhi/presentation.h>"), cpp_name("::NWB::Core::SwapChainTransitionKind::Enum")]
extern enum SwapChainTransitionKind : u8{
    Resize,
    Destroy,
    Count
};


