    metadata.addSkinnedMesh(s_ModelBodySegment, s_SharedModelPath, s_SharedModelPath);
    EXPECT_FALSE(metadata.parse());
    EXPECT_TRUE(metadata.entry.skinnedMeshObjects.empty());
    EXPECT_TRUE(SawCapturedError(logger, "targets a missing skeleton object"));

    metadata.setNestedFieldString(s_ModelMetaSkinnedMeshesField, s_ModelBodySegment, s_ModelMetaSkeletonField, s_ModelMetaRigA);
    metadata.setExpectedSkeleton(s_ModelBodySegment, s_ModelMetaRigA);
    ASSERT_TRUE(metadata.parse());
    metadata.verifyObjectReferences();
    EXPECT_EQ(logger.errorCount(), 1u);
}

