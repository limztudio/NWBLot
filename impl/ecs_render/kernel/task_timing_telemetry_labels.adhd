b8 ShouldAppendPhysicalQueueRuntimeTelemetry(
    in u64 acceptedPacketCount,
    in u64 rejectedPacketCount,
    in u64 incomingLogicalOwnershipTransferCount,
    in u64 outgoingLogicalOwnershipTransferCount,
    in u64 incomingLogicalOwnershipTransferSignatureCount,
    in u64 outgoingLogicalOwnershipTransferSignatureCount,
    in u64 incomingRepeatedOwnershipTransferSignatureCount,
    in u64 outgoingRepeatedOwnershipTransferSignatureCount,
    in u64 concurrentSharingAdviceResourceCount
){
    if(acceptedPacketCount != 0u || rejectedPacketCount != 0u)
        return true;
    return
        incomingLogicalOwnershipTransferCount != 0u
        || outgoingLogicalOwnershipTransferCount != 0u
        || incomingLogicalOwnershipTransferSignatureCount != 0u
        || outgoingLogicalOwnershipTransferSignatureCount != 0u
        || incomingRepeatedOwnershipTransferSignatureCount != 0u
        || outgoingRepeatedOwnershipTransferSignatureCount != 0u
        || concurrentSharingAdviceResourceCount != 0u
    ;
}

void AppendCommandArenaWorkerStatistics(in KernelGpuCommandArenaWorkerStatistics statistics, mut String label){
    StringAppendFormat(
        label,
        "\n    Worker arena domain={} index={}: epochs={} pending epochs={} command buffers current/high-water={}/{} reusable={} leased={} pending={} growth={} resets={} native handle storage lower bound={} bytes",
        statistics.recordingWorkerDomain,
        statistics.recordingWorkerIndex,
        statistics.commandPoolEpochCount,
        statistics.pendingCommandPoolEpochCount,
        statistics.currentCommandBufferCount,
        statistics.highWaterCommandBufferCount,
        statistics.reusableCommandBufferCount,
        statistics.leasedCommandBufferCount,
        statistics.pendingCommandBufferCount,
        statistics.growthEventCount,
        statistics.resetEventCount,
        statistics.nativeHandleStorageLowerBoundBytes
    );
}

void AppendGraphSummaryTelemetry(
    in KernelGpuTaskGraphCompileStatistics compileStatistics,
    in KernelGpuTaskGraphRecordingStatistics recordingStatistics,
    in KernelGpuTaskGraphSubmissionStatistics submissionStatistics,
    mut String label
){
    const VectorDouble millisecondsScale = VectorDouble(s_MillisecondsPerSecondTelemetry);
    const VectorDouble frameTimingMs = VectorDouble(
        compileStatistics.declarationSeconds,
        compileStatistics.totalSeconds,
        recordingStatistics.recordingElapsedSeconds,
        submissionStatistics.submissionSeconds
    ) * millisecondsScale;
    const VectorDouble compileTimingMs = VectorDouble(
        compileStatistics.analysisSeconds,
        compileStatistics.queueAssignmentSeconds,
        compileStatistics.planningSeconds,
        compileStatistics.validationSeconds
    ) * millisecondsScale;
    const VectorDouble analysisPlanningTimingMs = VectorDouble(
        compileStatistics.dependencyAnalysisSeconds,
        compileStatistics.hazardAnalysisSeconds,
        compileStatistics.topologicalOrderSeconds,
        compileStatistics.packetizationSeconds
    ) * millisecondsScale;
    const VectorDouble planningRecordingTimingMs = VectorDouble(
        compileStatistics.resourceStatePlanningSeconds,
        compileStatistics.packetDependencyPlanningSeconds,
        recordingStatistics.recordingSeconds,
        recordingStatistics.commandListAcquisitionSeconds
    ) * millisecondsScale;
    const VectorDouble recordingFrontierTimingMs = VectorDouble(
        recordingStatistics.graphBarrierRecordingSeconds,
        recordingStatistics.taskRecordSeconds,
        recordingStatistics.readyFrontierElapsedSeconds,
        recordingStatistics.readyFrontierWorkerBusySeconds
    ) * millisecondsScale;
    const VectorDouble frontierSummary = VectorDouble(recordingStatistics.readyFrontierWorkerCapacitySeconds, recordingStatistics.readyFrontierWorkerUtilization(), 0.0, 0.0) * VectorDouble(s_MillisecondsPerSecondTelemetry, s_PercentScaleTelemetry, 0.0, 0.0);
    StringAppendFormat(
        label,
        "Renderer Frame\nTask graph: tasks={} resources={} resource versions={} version edges={} packets={} deps={} transitions={}\nDeclarations: resource sets={} resource-set members={} direct uses={} declared set uses={} expanded set-member uses={} materialized uses={}\nData: payload objects={} payload object bytes={} upload blobs={} upload blob bytes={}\nRaw barriers: transitions={} UAV={} ownership releases={} ownership acquires={} state exports={}\nLogical ownership transfers: records={} signatures={} repeated signatures={} concurrent-sharing candidate records={} advised repeated resources={} route records internal/import/export={}/{}/{}\nRecording: packets={} tasks={} command lists={} barriers={} worker-routed={} overlapped={}\nSubmission: accepted packets={} accepted tasks={} rejected packets={} rejected tasks={} submissions={} accepted frontier={} recovery submissions={} command lists={} waits={} inherited wait elisions={} failed submissions={}\nCPU: declaration={:.3f} ms compile={:.3f} ms native recording elapsed={:.3f} ms submit={:.3f} ms\nCPU compile phases: analysis={:.3f} ms queue assignment={:.3f} ms planning={:.3f} ms\nCPU analysis detail: validation={:.3f} ms dependencies={:.3f} ms hazards={:.3f} ms cycles/topology={:.3f} ms\nCPU planning detail: packetization={:.3f} ms resource states/barriers={:.3f} ms packet dependencies={:.3f} ms\nCPU recording summed spans: packet={:.3f} ms command-list acquisition={:.3f} ms graph barrier lowering={:.3f} ms task={:.3f} ms\nReady-frontier recording: elapsed={:.3f} ms logical-worker busy={:.3f} ms logical-worker capacity={:.3f} ms utilization={:.1f}%",
        compileStatistics.taskCount,
        compileStatistics.resourceCount,
        compileStatistics.resourceVersionCount,
        compileStatistics.resourceVersionEdgeCount,
        compileStatistics.packetCount,
        compileStatistics.packetDependencyCount,
        compileStatistics.transitionBarrierCount,
        compileStatistics.resourceSetCount,
        compileStatistics.resourceSetMemberCount,
        compileStatistics.directResourceUseCount,
        compileStatistics.declaredResourceSetUseCount,
        compileStatistics.expandedResourceSetMemberUseCount,
        compileStatistics.resourceUseCount,
        compileStatistics.payloadObjectCount,
        compileStatistics.payloadObjectBytes,
        compileStatistics.uploadBlobCount,
        compileStatistics.uploadBlobBytes,
        compileStatistics.transitionBarrierCount,
        compileStatistics.uavBarrierCount,
        compileStatistics.ownershipReleaseBarrierCount,
        compileStatistics.ownershipAcquireBarrierCount,
        compileStatistics.stateExportBarrierCount,
        compileStatistics.logicalOwnershipTransferCount,
        compileStatistics.logicalOwnershipTransferSignatureCount,
        compileStatistics.repeatedOwnershipTransferSignatureCount,
        compileStatistics.concurrentSharingCouldAvoidTransferCount,
        compileStatistics.concurrentSharingAdviceResourceCount,
        KernelOwnershipTransferCountByRoute(compileStatistics, 0u),
        KernelOwnershipTransferCountByRoute(compileStatistics, 1u),
        KernelOwnershipTransferCountByRoute(compileStatistics, 2u),
        recordingStatistics.packetCount,
        recordingStatistics.taskCount,
        recordingStatistics.commandListCount,
        recordingStatistics.barrierCount,
        recordingStatistics.workerRoutedPacketCount,
        recordingStatistics.parallelPacketCount,
        submissionStatistics.acceptedPacketCount,
        submissionStatistics.acceptedTaskCount,
        submissionStatistics.rejectedPacketCount,
        submissionStatistics.rejectedTaskCount,
        submissionStatistics.nativeSubmissionCount,
        submissionStatistics.acceptedFrontierSubmissionCount,
        submissionStatistics.recoverySubmissionCount,
        submissionStatistics.nativeCommandListCount,
        submissionStatistics.timelineWaitCount,
        submissionStatistics.inheritedTimelineWaitElisionCount,
        submissionStatistics.rejectedSubmissionCount,
        frameTimingMs.x,
        frameTimingMs.y,
        frameTimingMs.z,
        frameTimingMs.w,
        compileTimingMs.x,
        compileTimingMs.y,
        compileTimingMs.z,
        compileTimingMs.w,
        analysisPlanningTimingMs.x,
        analysisPlanningTimingMs.y,
        analysisPlanningTimingMs.z,
        analysisPlanningTimingMs.w,
        planningRecordingTimingMs.x,
        planningRecordingTimingMs.y,
        planningRecordingTimingMs.z,
        planningRecordingTimingMs.w,
        recordingFrontierTimingMs.x,
        recordingFrontierTimingMs.y,
        recordingFrontierTimingMs.z,
        recordingFrontierTimingMs.w,
        frontierSummary.x,
        frontierSummary.y
    );
}

void AppendPhysicalQueueSummaryTelemetry(
    in KernelGpuPhysicalQueueInfo queueInfo,
    in KernelFrameGraphPhysicalQueueRuntimeStatistics queueRuntimeStatistics,
    in KernelFrameGraphPhysicalQueueSubmissionRuntimeStatistics queueStatistics,
    in KernelFrameGraphPhysicalQueueCompileRuntimeStatistics queueCompileStatistics,
    in KernelFrameGraphPhysicalQueueRecordingRuntimeStatistics queueRecordingStatistics,
    in KernelGpuCommandArenaStatistics commandArenaStatistics,
    mut String label
){
    const VectorDouble millisecondsScale = VectorDouble(s_MillisecondsPerSecondTelemetry);
    const VectorDouble queueSubmissionMs = VectorDouble(queueStatistics.submissionSeconds) * millisecondsScale;
    const VectorDouble queueRecordingBreakdownMs = VectorDouble(
        queueRecordingStatistics.commandListAcquisitionSeconds,
        queueRecordingStatistics.graphBarrierRecordingSeconds,
        queueRecordingStatistics.taskRecordSeconds,
        queueRecordingStatistics.recordingSeconds
    ) * millisecondsScale;
    StringAppendFormat(
        label,
        "\nPhysical queue index={} generation={} class={} family index={} native queue index={} dedicated={}: accepted packets={} accepted tasks={} rejected packets={} rejected tasks={} native submissions={} rejected submit paths={} command lists={} planned waits={} same-queue elisions={} timeline waits={} merged timeline waits={} inherited wait elisions={} accepted frontier={} recovery submissions={} CPU={:.3f} ms\n  Compile plan: tasks={} packets={} merged tasks={} prologue barriers={} epilogue barriers={} raw ownership release barriers (subset)={} raw ownership acquire barriers (subset)={}\n  Logical ownership: incoming/outgoing records={}/{} signatures={}/{} repeated signatures={}/{} attributed advice resources={}\n  Recording: packets={} tasks={} command lists={} barriers={} worker-routed={} overlapped={} CPU summed spans: command-list acquisition={:.3f} ms graph barrier lowering={:.3f} ms task={:.3f} ms packet={:.3f} ms\n  Command arena: workers={} epochs={} pending epochs={} command buffers current/high-water={}/{} reusable={} leased={} pending={} growth={} resets={} native handle storage lower bound={} bytes",
        queueRuntimeStatistics.queue.index,
        queueRuntimeStatistics.queue.deviceGeneration,
        ResolveTelemetryPhysicalQueueClassLabel(KernelQueueInfoClassValue(queueInfo)),
        queueInfo.familyIndex,
        queueInfo.queueIndex,
        queueInfo.dedicated,
        queueStatistics.acceptedPacketCount,
        queueStatistics.acceptedTaskCount,
        queueStatistics.rejectedPacketCount,
        queueStatistics.rejectedTaskCount,
        queueStatistics.nativeSubmissionCount,
        queueStatistics.rejectedSubmissionCount,
        queueStatistics.nativeCommandListCount,
        queueStatistics.plannedWaitTokenCount,
        queueStatistics.sameQueueWaitElisionCount,
        queueStatistics.timelineWaitCount,
        queueStatistics.mergedTimelineWaitCount,
        queueStatistics.inheritedTimelineWaitElisionCount,
        queueStatistics.acceptedFrontierSubmissionCount,
        queueStatistics.recoverySubmissionCount,
        queueSubmissionMs.x,
        queueCompileStatistics.taskCount,
        queueCompileStatistics.packetCount,
        queueCompileStatistics.mergedTaskCount,
        queueCompileStatistics.prologueBarrierCount,
        queueCompileStatistics.epilogueBarrierCount,
        queueCompileStatistics.ownershipReleaseBarrierCount,
        queueCompileStatistics.ownershipAcquireBarrierCount,
        queueCompileStatistics.incomingLogicalOwnershipTransferCount,
        queueCompileStatistics.outgoingLogicalOwnershipTransferCount,
        queueCompileStatistics.incomingLogicalOwnershipTransferSignatureCount,
        queueCompileStatistics.outgoingLogicalOwnershipTransferSignatureCount,
        queueCompileStatistics.incomingRepeatedOwnershipTransferSignatureCount,
        queueCompileStatistics.outgoingRepeatedOwnershipTransferSignatureCount,
        queueCompileStatistics.concurrentSharingAdviceResourceCount,
        queueRecordingStatistics.packetCount,
        queueRecordingStatistics.taskCount,
        queueRecordingStatistics.commandListCount,
        queueRecordingStatistics.barrierCount,
        queueRecordingStatistics.workerRoutedPacketCount,
        queueRecordingStatistics.parallelPacketCount,
        queueRecordingBreakdownMs.x,
        queueRecordingBreakdownMs.y,
        queueRecordingBreakdownMs.z,
        queueRecordingBreakdownMs.w,
        commandArenaStatistics.workerArenaCount,
        commandArenaStatistics.commandPoolEpochCount,
        commandArenaStatistics.pendingCommandPoolEpochCount,
        commandArenaStatistics.currentCommandBufferCount,
        commandArenaStatistics.highWaterCommandBufferCount,
        commandArenaStatistics.reusableCommandBufferCount,
        commandArenaStatistics.leasedCommandBufferCount,
        commandArenaStatistics.pendingCommandBufferCount,
        commandArenaStatistics.growthEventCount,
        commandArenaStatistics.resetEventCount,
        commandArenaStatistics.nativeHandleStorageLowerBoundBytes
    );
}

b8 AppendPhysicalQueueRuntimeTelemetryEntry(
    in KernelGpuPhysicalQueueInfo queueInfo,
    in KernelFrameGraphPhysicalQueueRuntimeStatistics queueRuntimeStatistics,
    in KernelFrameGraphPhysicalQueueSubmissionRuntimeStatistics queueStatistics,
    in KernelFrameGraphPhysicalQueueCompileRuntimeStatistics queueCompileStatistics,
    in KernelFrameGraphPhysicalQueueRecordingRuntimeStatistics queueRecordingStatistics,
    in KernelGpuCompiledGraphReadView deferredCompiledPlan,
    in KernelGpuRecordedGraph recordedGraph,
    mut KernelDevice device,
    mut String label
){
    if(!ShouldAppendPhysicalQueueRuntimeTelemetry(
        queueStatistics.acceptedPacketCount,
        queueStatistics.rejectedPacketCount,
        queueCompileStatistics.incomingLogicalOwnershipTransferCount,
        queueCompileStatistics.outgoingLogicalOwnershipTransferCount,
        queueCompileStatistics.incomingLogicalOwnershipTransferSignatureCount,
        queueCompileStatistics.outgoingLogicalOwnershipTransferSignatureCount,
        queueCompileStatistics.incomingRepeatedOwnershipTransferSignatureCount,
        queueCompileStatistics.outgoingRepeatedOwnershipTransferSignatureCount,
        queueCompileStatistics.concurrentSharingAdviceResourceCount
    ))
        return true;

    const KernelGpuCommandArenaStatistics commandArenaStatistics = device.getCommandArenaStatistics(queueInfo.id);
    if(!commandArenaStatistics.valid())
        return true;

    AppendPhysicalQueueSummaryTelemetry(
        queueInfo,
        queueRuntimeStatistics,
        queueStatistics,
        queueCompileStatistics,
        queueRecordingStatistics,
        commandArenaStatistics,
        label
    );

    const KernelGpuCommandArenaWorkerStatistics directCommandArenaStatistics = device.getCommandArenaWorkerStatistics(queueInfo.id, 0u, 0u);
    if(directCommandArenaStatistics.valid())
        AppendCommandArenaWorkerStatistics(directCommandArenaStatistics, label);

    // Recorded packets retain the exact worker domain/index used for native allocation.
    // Walk compiled order, reject identities already seen on this queue; packet counts are small, so no persistent storage.
    const usize packetCount = deferredCompiledPlan.packetCount();
    for(usize packetIndex = 0u; packetIndex < packetCount; ++packetIndex){
        b8 matchesQueue = false;
        b8 hasRecordedWorker = false;
        u32 workerDomain = 0u;
        u32 workerIndex = 0u;
        if(!InspectCompiledPacketForQueue(deferredCompiledPlan, recordedGraph, packetIndex, queueInfo.id, matchesQueue, hasRecordedWorker, workerDomain, workerIndex))
            return false;
        if(!matchesQueue || !hasRecordedWorker || workerIndex == 0u)
            continue;

        b8 alreadyAppended = false;
        for(usize previousPacketIndex = 0u; previousPacketIndex < packetIndex; ++previousPacketIndex){
            b8 previousMatchesQueue = false;
            b8 previousHasRecordedWorker = false;
            u32 previousWorkerDomain = 0u;
            u32 previousWorkerIndex = 0u;
            if(!InspectCompiledPacketForQueue(deferredCompiledPlan, recordedGraph, previousPacketIndex, queueInfo.id, previousMatchesQueue, previousHasRecordedWorker, previousWorkerDomain, previousWorkerIndex))
                return false;
            if(!previousMatchesQueue)
                continue;
            if(previousHasRecordedWorker && previousWorkerDomain == workerDomain && previousWorkerIndex == workerIndex){
                alreadyAppended = true;
                break;
            }
        }
        if(alreadyAppended)
            continue;

        const KernelGpuCommandArenaWorkerStatistics workerCommandArenaStatistics = device.getCommandArenaWorkerStatistics(queueInfo.id, workerDomain, workerIndex);
        if(workerCommandArenaStatistics.valid())
            AppendCommandArenaWorkerStatistics(workerCommandArenaStatistics, label);
    }

    return true;
}

void AppendLogicalOwnershipTransferTelemetryEntry(
    in usize transferIndex,
    in KernelGpuCompiledOwnershipTransfer transfer,
    mut String label
){
    assert(transfer.valid());
    const u8 sharingValue = KernelOwnershipTransferSharingValue(transfer);
    StringAppendFormat(
        label,
        "\nLogical ownership transfer {}: resource identity={} route={} source physical queue index={} generation={} family={} destination physical queue index={} generation={} family={} declared sharing={} mask={} concurrent sharing could avoid={}",
        transferIndex,
        transfer.resourceIdentity.resolvedText(),
        ResolveTelemetryOwnershipTransferRouteLabel(KernelOwnershipTransferRouteValue(transfer)),
        transfer.sourceQueue.index,
        transfer.sourceQueue.deviceGeneration,
        transfer.sourceQueueFamilyIndex,
        transfer.destinationQueue.index,
        transfer.destinationQueue.deviceGeneration,
        transfer.destinationQueueFamilyIndex,
        ResolveTelemetryResourceQueueSharingLabel(sharingValue),
        cast<u32>(sharingValue),
        transfer.concurrentSharingCouldAvoid
    );
}


