type UiPaintCallback = Func<64u, void(mut UiPaintContext)>;

[reflect]
class UiPaintComponent{
    [transient]
    public UiPaintCallback paint;
    public b8 visible = true;
    public i32 order = 0;
}

const Name s_UiLoadFontsArenaName = "impl/ecs_ui/load_fonts";
const usize s_UiLayerPaintReserveQuads = 256u;
const u32 s_UiEditMinInterpolatedStops = 2u;
const usize s_UiClipboardMaxPublications = 16u;
const usize s_UiEditBoxMaxEntries = 256u;
const usize s_UiNativeKeySlotCount = 512u;
const f32 s_MaxUiFrameDeltaFloatSeconds = 3.40282346638528859812e+38f;
const f64 s_MaxUiFrameDeltaSeconds = cast<f64>(s_MaxUiFrameDeltaFloatSeconds);

// Retains CPU update time until a UI paint frame actually begins.
class UiFrameDelta{
    public void add(in f32 deltaSeconds){
        if(!isFinite(deltaSeconds) || deltaSeconds < 0.0f)
            return;
        this.m_pendingSeconds = min(s_MaxUiFrameDeltaSeconds, this.m_pendingSeconds + cast<f64>(deltaSeconds));
    }

    public f32 consume(){
        const f32 elapsed = cast<f32>(this.m_pendingSeconds);
        this.m_pendingSeconds = 0.0;
        return elapsed;
    }

    public void clear(){
        this.m_pendingSeconds = 0.0;
    }

    private f64 m_pendingSeconds = 0.0;
}

class UiLiveRoot{
    public EntityID entity = s_InvalidEntityId;
    public i32 order = 0;
}

enum<u8> UiInputOwner{
    Scene = 0u,
    Custom = 1u,
}

enum<u8> UiLayerPresentation{
    Scene,
    Standalone,
}

enum<u8> UiEditBoxEventKind{
    Command,
    Character,
    Native,
    Selection,
    PastePrimary,
    Blur,
    Focus,
}

enum<u8> UiSkinSelectionResult{
    Failed,
    Selected,
    DefaultFallback,
}

enum<u8> UiSkinChangeResult{
    Deferred,
    Applied,
    Failed,
}

class UiSkinSelectionState{
    public void requestChange(in AssetRef<UiSkin> requested){
        this.requestedChange = requested;
        this.changePending = true;
        this.changeFailed = false;
    }

    public void resourcesValidated(){
        if(this.changeFailed)
            this.changePending = true;
    }

    public AssetRef<UiSkin> requested;
    public AssetRef<UiSkin> selected;
    public AssetRef<UiSkin> requestedChange;
    public u64 generation = 1u;
    public b8 changePending = false;
    public b8 changeFailed = false;
}

UiSkinSelectionState MakeUiSkinSelectionState(in AssetRef<UiSkin> requested){
    UiSkinSelectionState state;
    state.requested = requested;
    return state;
}

