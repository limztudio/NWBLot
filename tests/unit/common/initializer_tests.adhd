////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <tests/common/gtest_macros.adhd>
#include <tests/unit/common/initializer_case_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <core/common/module.h>

#include <global/terminal_entry.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_common_initializer_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using InitializerGuard = NWB::Core::Common::InitializerGuard;

extern InitializerState s_State;

class InitializerProbe final : public NWB::Core::Common::Initializerable{
public:
    explicit InitializerProbe(const u32 index)
        : m_index(index)
    {}


public:
    virtual b8 initialize()override;
    virtual void finalize()noexcept override;


private:
    const u32 m_index;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ResetInitializerState(in b8 failNext, in b8 throwNext){
    native(in failNext, in throwNext){
        s_State.reset();
        s_State.failNext = failNext;
        s_State.throwNext = throwNext;
    }
}

InitializerState SnapshotInitializerState(){
    InitializerState snapshot = InitializerState();
    native(mut snapshot){
        snapshot = s_State;
    }
    return snapshot;
}

void VerifyCommonInitializerLifetime_FailedInitializationRollsBackOnlyTheSuccessfulPrefixAndAllowsReacquire(){
    ResetInitializerState(true, false);
    InitializerGuard initializer = InitializerGuard();
    EXPECT_FALSE(initializer.initialize());
    InitializerState afterFail = SnapshotInitializerState();
    EXPECT_EQ(afterFail.eventCount, 3u);
    EXPECT_EQ(afterFail.events[0u], 0u);
    EXPECT_EQ(afterFail.events[1u], 1u);
    EXPECT_EQ(afterFail.events[2u], s_InitializerCount);
    EXPECT_EQ(afterFail.finalizeCounts[0u], 1u);
    EXPECT_EQ(afterFail.finalizeCounts[1u], 0u);

    ASSERT_TRUE(initializer.initialize());
    InitializerState afterReacquire = SnapshotInitializerState();
    EXPECT_EQ(afterReacquire.initializeCounts[0u], 2u);
    EXPECT_EQ(afterReacquire.initializeCounts[1u], 2u);
    initializer.finalize();
    InitializerState afterFinalize = SnapshotInitializerState();
    EXPECT_EQ(afterFinalize.finalizeCounts[0u], 2u);
    EXPECT_EQ(afterFinalize.finalizeCounts[1u], 1u);
    EXPECT_EQ(afterFinalize.eventCount, 7u);
    EXPECT_EQ(afterFinalize.events[5u], s_InitializerCount);
    EXPECT_EQ(afterFinalize.events[6u], s_InitializerCount + 1u);
    initializer.finalize();
    EXPECT_EQ(SnapshotInitializerState().eventCount, 7u);
}

void VerifyCommonInitializerLifetime_ThrowingInitializationRollsBackOnlyTheSuccessfulPrefixAndAllowsReacquire(){
    ResetInitializerState(false, true);
    i32 result = 0;
    native(mut result){
        result = InvokeTerminalEntry<InitializerFailure>([]()->int{
            InitializerGuard guard;
            return guard.initialize() ? 0 : -1;
        }, [](const InitializerFailure& error)noexcept{ return error.code; }, []()noexcept{ return -1; });
    }
    EXPECT_EQ(result, s_InitializationFailureCode);
    InitializerState afterThrow = SnapshotInitializerState();
    EXPECT_EQ(afterThrow.eventCount, 3u);
    EXPECT_EQ(afterThrow.events[0u], 0u);
    EXPECT_EQ(afterThrow.events[1u], 1u);
    EXPECT_EQ(afterThrow.events[2u], s_InitializerCount);
    EXPECT_EQ(afterThrow.finalizeCounts[0u], 1u);
    EXPECT_EQ(afterThrow.finalizeCounts[1u], 0u);

    InitializerGuard initializer = InitializerGuard();
    ASSERT_TRUE(initializer.initialize());
    InitializerState afterReacquire = SnapshotInitializerState();
    EXPECT_EQ(afterReacquire.initializeCounts[0u], 2u);
    EXPECT_EQ(afterReacquire.initializeCounts[1u], 2u);
    initializer.finalize();
    InitializerState afterFinalize = SnapshotInitializerState();
    EXPECT_EQ(afterFinalize.finalizeCounts[0u], 2u);
    EXPECT_EQ(afterFinalize.finalizeCounts[1u], 1u);
    EXPECT_EQ(afterFinalize.eventCount, 7u);
}

void VerifyCommonInitializerLifetime_NestedGuardsFinalizeOnlyTheLastOwnerAndAllowReacquire(){
    ResetInitializerState(false, false);
    {
        InitializerGuard outer = InitializerGuard();
        ASSERT_TRUE(outer.initialize());
        ASSERT_TRUE(outer.initialize());
        {
            InitializerGuard inner = InitializerGuard();
            ASSERT_TRUE(inner.initialize());
            ASSERT_TRUE(inner.initialize());
            InitializerState nested = SnapshotInitializerState();
            EXPECT_EQ(nested.initializeCounts[0u], 1u);
            EXPECT_EQ(nested.initializeCounts[1u], 1u);
            outer.finalize();
            InitializerState afterOuterFinalize = SnapshotInitializerState();
            EXPECT_EQ(afterOuterFinalize.finalizeCounts[0u], 0u);
            EXPECT_EQ(afterOuterFinalize.finalizeCounts[1u], 0u);
        }
        InitializerState afterInnerExit = SnapshotInitializerState();
        EXPECT_EQ(afterInnerExit.finalizeCounts[0u], 1u);
        EXPECT_EQ(afterInnerExit.finalizeCounts[1u], 1u);
    }
    EXPECT_EQ(SnapshotInitializerState().eventCount, 4u);
    {
        InitializerGuard reacquired = InitializerGuard();
        ASSERT_TRUE(reacquired.initialize());
        InitializerState duringReacquire = SnapshotInitializerState();
        EXPECT_EQ(duringReacquire.initializeCounts[0u], 2u);
        EXPECT_EQ(duringReacquire.initializeCounts[1u], 2u);
    }
    InitializerState finalState = SnapshotInitializerState();
    EXPECT_EQ(finalState.finalizeCounts[0u], 2u);
    EXPECT_EQ(finalState.finalizeCounts[1u], 2u);
    EXPECT_EQ(finalState.eventCount, 8u);
}

void VerifyCommonInitializerLifetime_GuardUnwindFinalizesAllItemsBeforeTheTerminalEntryHandlesTheOriginalFailure(){
    ResetInitializerState(false, false);
    i32 result = 0;
    native(mut result){
        result = InvokeTerminalEntry<InitializerFailure>([]()->int{
            InitializerGuard initializer;
            if(!initializer.initialize())
                return -1;
            InitializerFailure failure;
            failure.code = s_OwnerFailureCode;
            throw failure;
        }, [](const InitializerFailure& error)noexcept{ return error.code; }, []()noexcept{ return -1; });
    }
    EXPECT_EQ(result, s_OwnerFailureCode);
    InitializerState afterUnwind = SnapshotInitializerState();
    EXPECT_EQ(afterUnwind.initializeCounts[0u], 1u);
    EXPECT_EQ(afterUnwind.initializeCounts[1u], 1u);
    EXPECT_EQ(afterUnwind.finalizeCounts[0u], 1u);
    EXPECT_EQ(afterUnwind.finalizeCounts[1u], 1u);
    EXPECT_EQ(afterUnwind.eventCount, 4u);
    EXPECT_EQ(afterUnwind.events[2u], s_InitializerCount);
    EXPECT_EQ(afterUnwind.events[3u], s_InitializerCount + 1u);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_common_initializer_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


InitializerState s_State{};

b8 InitializerProbe::initialize(){
    ++s_State.initializeCounts[m_index];
    s_State.record(m_index);
    if(m_index == 1u){
        if(s_State.failNext){
            s_State.failNext = false;
            return false;
        }
        if(s_State.throwNext){
            s_State.throwNext = false;
            InitializerFailure failure;
            failure.code = s_InitializationFailureCode;
            throw failure;
        }
    }
    return true;
}

void InitializerProbe::finalize()noexcept{
    ++s_State.finalizeCounts[m_index];
    s_State.record(m_index + s_InitializerCount);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_ADHD_GTEST(CommonInitializerLifetime, FailedInitializationRollsBackOnlyTheSuccessfulPrefixAndAllowsReacquire, VerifyCommonInitializerLifetime_FailedInitializationRollsBackOnlyTheSuccessfulPrefixAndAllowsReacquire)
NWB_ADHD_GTEST(CommonInitializerLifetime, ThrowingInitializationRollsBackOnlyTheSuccessfulPrefixAndAllowsReacquire, VerifyCommonInitializerLifetime_ThrowingInitializationRollsBackOnlyTheSuccessfulPrefixAndAllowsReacquire)
NWB_ADHD_GTEST(CommonInitializerLifetime, NestedGuardsFinalizeOnlyTheLastOwnerAndAllowReacquire, VerifyCommonInitializerLifetime_NestedGuardsFinalizeOnlyTheLastOwnerAndAllowReacquire)
NWB_ADHD_GTEST(CommonInitializerLifetime, GuardUnwindFinalizesAllItemsBeforeTheTerminalEntryHandlesTheOriginalFailure, VerifyCommonInitializerLifetime_GuardUnwindFinalizesAllItemsBeforeTheTerminalEntryHandlesTheOriginalFailure)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// This executable owns its initializer guards so the last release is exercised directly.
int main(int argc, char** argv){
    using namespace __hidden_common_initializer_tests;
    return InvokeTerminalEntry<InitializerFailure>([&](){
        static InitializerProbe s_FirstInitializer(0u);
        static InitializerProbe s_SecondInitializer(1u);
        ::testing::InitGoogleTest(&argc, argv);
        return RUN_ALL_TESTS();
    }, [](const InitializerFailure&)noexcept{ return -1; }, []()noexcept{ return -1; });
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

