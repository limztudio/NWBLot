////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_ui_skin/asset.adhd>
#include <impl/assets_ui_skin/ui_skin_binary_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateUiSkinRuntimePayload(
    in b8 hasValidVirtualPath,
    in AssetRef<Texture> texture,
    in u32 atlasWidth,
    in u32 atlasHeight,
    in f32 referenceDensity,
    in Span<UiSkinRegion> regions,
    in Span<u32> regionIndex,
    in UiSkinPalette palette,
    in UiSkinTypography typography
){
    if(!hasValidVirtualPath)
        return false;
    return ValidateUiSkinPayloadData(
        texture,
        atlasWidth,
        atlasHeight,
        referenceDensity,
        regions,
        regionIndex,
        palette,
        typography
    );
}

b8 UiSkin::loadBinary(in Span<u8> binary){
    UiSkin candidate(this.virtualPath());
    if(!UiSkinBinaryCodec().deserialize(
        binary,
        candidate.m_texture,
        candidate.m_atlasWidth,
        candidate.m_atlasHeight,
        candidate.m_referenceDensity,
        candidate.m_regions,
        candidate.m_regionIndex,
        candidate.m_palette,
        candidate.m_typography
    ))
        return false;

    if(!candidate.validatePayload())
        return false;

    this = candidate;
    return true;
}

b8 UiSkin::validatePayload()const{
    return ValidateUiSkinRuntimePayload(
        this.checkVirtualPath("UiSkin::validatePayload"),
        this.m_texture,
        this.m_atlasWidth,
        this.m_atlasHeight,
        this.m_referenceDensity,
        Span<UiSkinRegion>(this.m_regions),
        Span<u32>(this.m_regionIndex),
        this.m_palette,
        this.m_typography
    );
}

b8 UiSkin::validateTexture(in Texture texture)const{
    if(!this.validatePayload())
        return false;
    return ValidateUiSkinAtlasTextureParameters(
        texture.virtualPath(),
        this.m_texture.name(),
        texture.dimension() == TexturePayloadDimension::Texture2D,
        texture.depth(),
        texture.width(),
        texture.height(),
        this.m_atlasWidth,
        this.m_atlasHeight
    );
}


