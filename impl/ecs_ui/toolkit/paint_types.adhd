native{
#include <impl/ecs_ui/toolkit/images/image_source.h>
namespace NWB::Impl{
class UiSkin;
class Texture;
}
namespace NWB::Impl::Ui{
template<typename TUiSkin, typename TTexture>
class SkinBindingRecord;
using SkinBinding = SkinBindingRecord<NWB::Impl::UiSkin, NWB::Impl::Texture>;
}
}


class Point{
    public f32 x = 0.0f;
    public f32 y = 0.0f;
}

class Rect{
    public f32 x = 0.0f;
    public f32 y = 0.0f;
    public f32 width = 0.0f;
    public f32 height = 0.0f;
}

class Insets{
    public f32 left = 0.0f;
    public f32 top = 0.0f;
    public f32 right = 0.0f;
    public f32 bottom = 0.0f;
}

// Input colors use linear RGB and straight alpha; frozen vertices use premultiplied alpha.
class Color{
    public f32 r = 1.0f;
    public f32 g = 1.0f;
    public f32 b = 1.0f;
    public f32 a = 1.0f;
}

[serialize]
class Vertex{
    public Point position;
    public Point texCoord;
    public Color color;
}

class DisplayMetrics{
    public f32 logicalWidth = 0.0f;
    public f32 logicalHeight = 0.0f;
    public f32 pixelScaleX = 1.0f;
    public f32 pixelScaleY = 1.0f;
}

enum<u8> PaintMaterial{
    Solid,
    Skin,
    Glyph,
    SdfGlyph,
    Image,
}

class DrawCommand{
    public Rect clip;
    public u32 firstIndex = 0u;
    public u32 indexCount = 0u;
    public u32 glyphPageIndex = 0xffffffffu;
    public u32 sdfPageIndex = 0xffffffffu;
    public u32 sdfChannel = 0u;
    // Base paint is layer zero; higher layers render later without changing owned index or image bindings.
    public u32 layer = 0u;
    public u32 textureImageIndex = 0xffffffffu;
    public PaintMaterial material = PaintMaterial::Solid;
}

// Share of free space placed before an item to center it, or the midpoint of an extent.
const f32 s_RectCenterFraction = 0.5f;
const f64 s_RectCenterFractionF64 = 0.5;
const f32 s_UiMaxFloat = 3.40282346638528859812e+38f;
const f64 s_UiMaxFloatF64 = cast<f64>(s_UiMaxFloat);

enum<u8> UiRectPrecision{
    RoundedEndpoints,
    BoundedEndpoints,
    PreciseExtents,
    EmptyPaint,
}

const usize s_PaintMaxImages = 64u;
const usize s_PaintMaxOverlayDepth = 16u;
const usize s_PaintDefaultClipDepth = 8u;

const u32 s_PaintQuadVertexCount = 4u;
const u32 s_PaintQuadIndexCount = 6u;
const u32 s_PaintNineSliceAxisCells = 3u;

// Typed references identify assets; this copy captures atlas metadata, not loaded/GPU resource ownership.
class SkinBindingRecord<TUiSkin, TTexture>{
    public AssetRef<TUiSkin> skin;
    public AssetRef<TTexture> texture;
    public u64 generation = 0u;
    public u32 atlasWidth = 0u;
    public u32 atlasHeight = 0u;
    public f32 referenceDensity = 1.0f;
}

class PaintOverlayFrame{
    public usize clipDepth = 0u;
    public u32 layer = 0u;
}

Color ResolveUiSkinColor(in UiSkinPalette palette, in UiSkinColorRole role){
    const UiSkinColor value = palette.colors[cast<usize>(role)];
    Color out;
    out.r = value.r;
    out.g = value.g;
    out.b = value.b;
    out.a = value.a;
    return out;
}

b8 SameTextureImageKey(in ImageSource first, in ImageSource second){
    return first.identity() == second.identity() && first.generation() == second.generation();
}

b8 SameSkinBindingKey(in SkinBinding lhs, in SkinBinding rhs){
    return lhs.skin == rhs.skin && lhs.texture == rhs.texture && lhs.generation == rhs.generation;
}

b8 SameSkinBinding(in SkinBinding lhs, in SkinBinding rhs){
    return SameSkinBindingKey(lhs, rhs)
        && lhs.atlasWidth == rhs.atlasWidth
        && lhs.atlasHeight == rhs.atlasHeight
        && lhs.referenceDensity == rhs.referenceDensity;
}

b8 IsValidDisplayMetricsForGpuSubmit(in DisplayMetrics display){
    return
        isFinite(display.logicalWidth) && isFinite(display.logicalHeight)
        && isFinite(display.pixelScaleX) && isFinite(display.pixelScaleY)
        && display.logicalWidth > 0.0f && display.logicalHeight > 0.0f
        && display.pixelScaleX > 0.0f && display.pixelScaleY > 0.0f
    ;
}

b8 ValidDrawCommandGlyphBinding(in DrawCommand command, in usize pageCount){
    if(command.material == PaintMaterial::Glyph)
        return cast<usize>(command.glyphPageIndex) < pageCount && command.sdfPageIndex == 0xffffffffu && command.sdfChannel == 0u;
    if(command.material == PaintMaterial::SdfGlyph)
        return command.glyphPageIndex == 0xffffffffu;
    if(command.material == PaintMaterial::Solid || command.material == PaintMaterial::Skin || command.material == PaintMaterial::Image)
        return command.glyphPageIndex == 0xffffffffu && command.sdfPageIndex == 0xffffffffu && command.sdfChannel == 0u;
    return false;
}

b8 ValidateDrawCommandGlyphBindings(in Span<DrawCommand> commands, in usize pageCount){
    for(in DrawCommand command : commands){
        if(!ValidDrawCommandGlyphBinding(command, pageCount))
            return false;
    }
    return true;
}

b8 ValidDrawCommandImageBinding(in DrawCommand command, in usize imageCount){
    if(command.material == PaintMaterial::Image)
        return cast<usize>(command.textureImageIndex) < imageCount && command.glyphPageIndex == 0xffffffffu && command.sdfPageIndex == 0xffffffffu && command.sdfChannel == 0u;
    return command.textureImageIndex == 0xffffffffu;
}

b8 ValidateDrawCommandImageBindings(in Span<DrawCommand> commands, in usize imageCount){
    for(in DrawCommand command : commands){
        if(!ValidDrawCommandImageBinding(command, imageCount))
            return false;
    }
    return true;
}

b8 ValidDrawCommandSdfBinding(in DrawCommand command, in usize pageCount, in u32 pageChannelCount){
    if(command.material == PaintMaterial::SdfGlyph)
        return cast<usize>(command.sdfPageIndex) < pageCount && command.sdfChannel < pageChannelCount;
    return true;
}

b8 ValidSnapshotImageCounts(in usize glyphPageCount, in usize sdfPageCount, in usize textureImageCount){
    return
        glyphPageCount <= s_PaintMaxImages
        && sdfPageCount <= s_PaintMaxImages
        && textureImageCount <= s_PaintMaxImages
        && glyphPageCount + sdfPageCount + textureImageCount <= s_PaintMaxImages
    ;
}

b8 IsValidPaintUvRect(in Rect uv){
    return
        isFinite(uv.x) && isFinite(uv.y) && isFinite(uv.width) && isFinite(uv.height)
        && uv.x >= 0.0f && uv.y >= 0.0f && uv.width > 0.0f && uv.height > 0.0f
        && uv.x + uv.width <= 1.0f && uv.y + uv.height <= 1.0f
    ;
}

Insets MaxUiPadding(in Insets lhs, in Insets rhs){
    const f32x4 first(lhs.left, lhs.top, lhs.right, lhs.bottom);
    const f32x4 second(rhs.left, rhs.top, rhs.right, rhs.bottom);
    const f32x4 maximum = max(first, second);
    Insets out;
    out.left = maximum.x;
    out.top = maximum.y;
    out.right = maximum.z;
    out.bottom = maximum.w;
    return out;
}

Insets MaxUiPadding(in Insets lhs, in UiSkinInsets rhs){
    Insets converted;
    converted.left = rhs.left;
    converted.top = rhs.top;
    converted.right = rhs.right;
    converted.bottom = rhs.bottom;
    return MaxUiPadding(lhs, converted);
}

// Rectangle lanes are x, y, width, height; comparisons preserve scalar Min/Max ties and NaNs on every backend.
f32x4 IntersectRectBoundsVec(in f32x4 lhs, in f32x4 rhs){
    const f32 lhsEndX = lhs.x + lhs.z;
    const f32 lhsEndY = lhs.y + lhs.w;
    const f32 rhsEndX = rhs.x + rhs.z;
    const f32 rhsEndY = rhs.y + rhs.w;
    f32 originX = rhs.x;
    if(lhs.x > rhs.x)
        originX = lhs.x;
    f32 originY = rhs.y;
    if(lhs.y > rhs.y)
        originY = lhs.y;
    f32 endX = rhsEndX;
    if(lhsEndX < rhsEndX)
        endX = lhsEndX;
    f32 endY = rhsEndY;
    if(lhsEndY < rhsEndY)
        endY = lhsEndY;
    return f32x4(originX, originY, endX, endY);
}

b8 HasVisibleRectIntersectionVec(in f32x4 rectangle, in f32x4 clip){
    const f32x4 visibleBounds = IntersectRectBoundsVec(rectangle, clip);
    return visibleBounds.z > visibleBounds.x && visibleBounds.w > visibleBounds.y;
}

b8 HasVisibleUiRectIntersection(in Rect rectangle, in Rect clip){
    return HasVisibleRectIntersectionVec(
        f32x4(rectangle.x, rectangle.y, rectangle.width, rectangle.height),
        f32x4(clip.x, clip.y, clip.width, clip.height)
    );
}

b8 UiRectIntersectionContainsPoint(in Rect rectangle, in Rect clip, in Point pointer){
    const f32x4 visibleBounds = IntersectRectBoundsVec(
        f32x4(rectangle.x, rectangle.y, rectangle.width, rectangle.height),
        f32x4(clip.x, clip.y, clip.width, clip.height)
    );
    return pointer.x >= visibleBounds.x && pointer.y >= visibleBounds.y && pointer.x < visibleBounds.z && pointer.y < visibleBounds.w;
}

f32x4 IntersectRectVec(in f32x4 lhs, in f32x4 rhs){
    const f32x4 bounds = IntersectRectBoundsVec(lhs, rhs);
    const f32 extentX = bounds.z - bounds.x;
    const f32 extentY = bounds.w - bounds.y;
    f32 sizeX = extentX;
    if(0.0f > extentX)
        sizeX = 0.0f;
    f32 sizeY = extentY;
    if(0.0f > extentY)
        sizeY = 0.0f;
    return f32x4(bounds.x, bounds.y, sizeX, sizeY);
}

// Padding lanes are left, top, right, bottom; retain the two separately rounded size subtractions.
f32x4 InsetRectVec(in f32x4 rectangle, in f32x4 padding){
    const f32 originX = rectangle.x + padding.x;
    const f32 originY = rectangle.y + padding.y;
    const f32 extentX = (rectangle.z - padding.x) - padding.z;
    const f32 extentY = (rectangle.w - padding.y) - padding.w;
    f32 sizeX = extentX;
    if(0.0f > extentX)
        sizeX = 0.0f;
    f32 sizeY = extentY;
    if(0.0f > extentY)
        sizeY = 0.0f;
    return f32x4(originX, originY, sizeX, sizeY);
}

Rect ResolveSkinRegionUv(in UiSkinRect pixels, in u32 atlasWidth, in u32 atlasHeight){
    const f32 width = cast<f32>(atlasWidth);
    const f32 height = cast<f32>(atlasHeight);
    const f32x4 normalized = f32x4(cast<f32>(pixels.x), cast<f32>(pixels.y), cast<f32>(pixels.width), cast<f32>(pixels.height)) / f32x4(width, height, width, height);
    Rect uv;
    uv.x = normalized.x;
    uv.y = normalized.y;
    uv.width = normalized.z;
    uv.height = normalized.w;
    return uv;
}

f32x4 ResolveQuadTextureCoords(in Rect rectangle, in Rect visible, in Rect uv){
    const f32 visibleRight = visible.x + visible.width;
    const f32 visibleBottom = visible.y + visible.height;
    const f32x4 coordinates(visible.x, visible.y, visibleRight, visibleBottom);
    const f32x4 delta = coordinates - f32x4(rectangle.x, rectangle.y, rectangle.x, rectangle.y);
    const f32x4 fraction = delta / f32x4(rectangle.width, rectangle.height, rectangle.width, rectangle.height);
    const f32x4 textureScale(uv.width, uv.height, uv.width, uv.height);
    const f32x4 textureOrigin(uv.x, uv.y, uv.x, uv.y);
    return fraction * textureScale + textureOrigin;
}

Color PremultiplyPaintColor(in Color color){
    const f32x4 rgb = f32x4(color.r, color.g, color.b, color.b) * color.a;
    Color out;
    out.r = rgb.x;
    out.g = rgb.y;
    out.b = rgb.z;
    out.a = color.a;
    return out;
}

void ResolveNineSliceCoordinates(
    in UiSkinRect pixels,
    in UiSkinSliceInsets borders,
    in Rect rectangle,
    in f32 referenceDensity,
    mut f32x4 outX,
    mut f32x4 outY,
    mut f32x4 outU,
    mut f32x4 outV
){
    const f32 borderLeft = cast<f32>(borders.left) / referenceDensity;
    const f32 borderRight = cast<f32>(borders.right) / referenceDensity;
    const f32 borderTop = cast<f32>(borders.top) / referenceDensity;
    const f32 borderBottom = cast<f32>(borders.bottom) / referenceDensity;
    const f32 borderExtentX = borderLeft + borderRight;
    const f32 borderExtentY = borderTop + borderBottom;
    const f32 endX = rectangle.x + rectangle.width;
    const f32 endY = rectangle.y + rectangle.height;
    f32 firstX = rectangle.x + borderLeft;
    f32 secondX = endX - borderRight;
    if(rectangle.width < borderExtentX){
        firstX = rectangle.x + rectangle.width * (borderLeft / borderExtentX);
        secondX = firstX;
    }
    f32 firstY = rectangle.y + borderTop;
    f32 secondY = endY - borderBottom;
    if(rectangle.height < borderExtentY){
        firstY = rectangle.y + rectangle.height * (borderTop / borderExtentY);
        secondY = firstY;
    }
    outX = f32x4(rectangle.x, firstX, secondX, endX);
    outY = f32x4(rectangle.y, firstY, secondY, endY);
    outU = f32x4(
        cast<f32>(pixels.x),
        cast<f32>(pixels.x + borders.left),
        cast<f32>(pixels.x + pixels.width - borders.right),
        cast<f32>(pixels.x + pixels.width)
    );
    outV = f32x4(
        cast<f32>(pixels.y),
        cast<f32>(pixels.y + borders.top),
        cast<f32>(pixels.y + pixels.height - borders.bottom),
        cast<f32>(pixels.y + pixels.height)
    );
}


