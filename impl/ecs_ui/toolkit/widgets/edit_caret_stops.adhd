Expected<Rect> ResolveEditCaretRect(
    in StringView text,
    in Span<TextLine> lines,
    in Span<TextCluster> clusters,
    in Span<usize> boundaries,
    in usize byte
){
    if(lines.empty() || !IsUtf8ScalarBoundary(text, byte))
        return MakeUnexpected(Failure());
    const TextLine line = lines[cast<usize>(LineForEditCaretByte(lines, byte))];
    if(byte < cast<usize>(line.byteBegin) || byte > cast<usize>(line.byteEnd))
        return MakeUnexpected(Failure());
    f32 x = 0.0f;
    if(line.clusterCount != 0u){
        const usize firstCluster = cast<usize>(line.firstCluster);
        const usize lastCluster = firstCluster + cast<usize>(line.clusterCount);
        const usize clusterIndex = LowerBoundEditClusterByEnd(clusters, firstCluster, lastCluster, byte);
        if(clusterIndex == lastCluster || byte < cast<usize>(clusters[clusterIndex].byteBegin))
            return MakeUnexpected(Failure());
        const TextCluster cluster = clusters[clusterIndex];
        const usize clusterBegin = cast<usize>(cluster.byteBegin);
        const usize clusterEnd = cast<usize>(cluster.byteEnd);
        if(byte == clusterBegin || byte == clusterEnd){
            if(byte == clusterBegin)
                x = cluster.leadingX;
            else
                x = cluster.trailingX;
        }
        else{
            usize first = LowerBoundIndex(boundaries, clusterBegin);
            if(first != boundaries.size() && boundaries[first] == clusterBegin)
                ++first;
            const usize last = first + LowerBoundIndex(boundaries.subspan(first, boundaries.size() - first), clusterEnd);
            const usize next = first + LowerBoundIndex(boundaries.subspan(first, last - first), byte);
            const usize intervals = (last - first) + 1u;
            f32 ordinal = cast<f32>(next - first);
            if(next != last && boundaries[next] == byte)
                ordinal += 1.0f;
            else{
                usize begin = clusterBegin;
                if(next != first)
                    begin = boundaries[next - 1u];
                usize end = clusterEnd;
                if(next != last)
                    end = boundaries[next];
                ordinal += ComputeEditScalarFraction(text, begin, end, byte);
            }
            const f32 span = cluster.trailingX - cluster.leadingX;
            x = cluster.leadingX + ((span * ordinal) / cast<f32>(intervals));
        }
    }
    if(!IsFinite(x))
        return MakeUnexpected(Failure());
    return Rect(x, line.top, 0.0f, line.height);
}

EditCaretLine MakeEditCaretLine(in TextLine line){
    EditCaretLine caretLine;
    caretLine.byteBegin = cast<usize>(line.byteBegin);
    caretLine.byteEnd = cast<usize>(line.byteEnd);
    caretLine.breakEnd = cast<usize>(line.breakEnd);
    caretLine.firstStop = 0u;
    caretLine.stopCount = 0u;
    caretLine.top = line.top;
    caretLine.height = line.height;
    caretLine.advance = line.advance;
    return caretLine;
}

Expected<EditBoxCaretStop> TryMakeEditCaretStop(
    in StringView expectedText,
    in Span<TextLine> textLines,
    in Span<TextCluster> clusters,
    in Span<usize> boundaries,
    in usize committedBytes,
    in EditCaretMapping item,
    mut usize inOutPreviousCommitted,
    mut usize inOutPreviousDisplay
){
    if(item.committedByte < inOutPreviousCommitted || item.committedByte > committedBytes || item.displayByte < inOutPreviousDisplay || item.displayByte > expectedText.size())
        return MakeUnexpected(Failure());
    const Expected<Rect> caret = ResolveEditCaretRect(expectedText, textLines, clusters, boundaries, item.displayByte);
    if(!caret.has_value())
        return MakeUnexpected(Failure());
    const u32 lineIndex = LineForEditCaretByte(textLines, item.displayByte);
    EditBoxCaretStop stop;
    stop.committedByte = item.committedByte;
    stop.displayByte = item.displayByte;
    stop.x = caret.value().x;
    stop.lineIndex = lineIndex;
    inOutPreviousCommitted = item.committedByte;
    inOutPreviousDisplay = item.displayByte;
    return stop;
}

Expected<usize> ResolveEditCaretVerticalTarget(
    in StringView text,
    in Span<TextLine> textLines,
    in Span<TextCluster> clusters,
    in Span<usize> boundaries,
    in Span<EditCaretLine> caretLines,
    in Span<EditBoxCaretStop> stops,
    in usize displayCaret,
    in b8 down,
    in f32 preferredX
){
    if(!IsFinite(preferredX))
        return MakeUnexpected(Failure());
    const Expected<Rect> caret = ResolveEditCaretRect(text, textLines, clusters, boundaries, displayCaret);
    if(!caret.has_value())
        return MakeUnexpected(Failure());
    const u32 current = LineForEditCaretByte(textLines, displayCaret);
    u32 target = 0u;
    if(down)
        target = Min(current + 1u, cast<u32>(caretLines.size() - 1u));
    else if(current != 0u)
        target = current - 1u;
    if(target == current){
        for(usize i = 0u; i < stops.size(); ++i){
            if(stops[i].displayByte == displayCaret)
                return stops[i].committedByte;
        }
        const f32 center = caret.value().y + (caret.value().height * s_RectCenterFraction);
        return TryFindNearestEditCaretStop(caretLines, stops, current, Point(caret.value().x, center));
    }
    const EditCaretLine line = caretLines[cast<usize>(target)];
    const f32 center = line.top + (line.height * s_RectCenterFraction);
    return TryFindNearestEditCaretStop(caretLines, stops, target, Point(preferredX, center));
}

Expected<Rect> ResolveEditCaretRangeOnLine(
    in StringView text,
    in Span<TextLine> textLines,
    in Span<TextCluster> clusters,
    in Span<usize> boundaries,
    in Span<EditCaretLine> caretLines,
    in EditBoxRange range,
    in u32 lineIndex,
    in f32 breakWidth
){
    if(
        cast<usize>(lineIndex) >= caretLines.size() || range.begin > range.end || range.end > text.size()
        || !IsFinite(breakWidth) || breakWidth < 0.0f
        || !IsUtf8ScalarBoundary(text, range.begin)
        || !IsUtf8ScalarBoundary(text, range.end)
    )
        return MakeUnexpected(Failure());
    if(range.begin == range.end)
        return Rect();
    const EditCaretLine line = caretLines[cast<usize>(lineIndex)];
    const usize begin = Max(range.begin, line.byteBegin);
    const usize end = Min(range.end, line.byteEnd);
    const b8 selectedBreak = line.breakEnd != line.byteEnd && range.begin <= line.byteEnd && range.end > line.byteEnd;
    if(begin >= end && !selectedBreak)
        return Rect();
    const Expected<Rect> first = ResolveEditCaretRect(text, textLines, clusters, boundaries, begin);
    if(!first.has_value())
        return MakeUnexpected(Failure());
    const Expected<Rect> last = ResolveEditCaretRect(text, textLines, clusters, boundaries, end);
    if(!last.has_value())
        return MakeUnexpected(Failure());
    const f32 firstX = first.value().x;
    f32 breakCap = 0.0f;
    if(selectedBreak)
        breakCap = breakWidth;
    const f32 width = Max(0.0f, last.value().x - firstX) + breakCap;
    if(!IsFinite(width) || !IsFinite(firstX + width))
        return MakeUnexpected(Failure());
    return Rect(firstX, line.top, width, line.height);
}

b8 BuildEditCaretStopsAndLinesInto(
    in StringView expectedText,
    in Span<TextLine> textLines,
    in Span<TextCluster> clusters,
    in Span<usize> boundaries,
    in usize committedBytes,
    in Span<EditCaretMapping> mapping,
    mut Vector<EditBoxCaretStop> outStops,
    mut Vector<EditCaretLine> outLines
){
    outStops.clear();
    outLines.clear();
    outStops.reserve(mapping.size());
    outLines.reserve(textLines.size());
    for(in TextLine line : textLines)
        outLines.push_back(MakeEditCaretLine(line));
    usize previousCommitted = 0u;
    usize previousDisplay = 0u;
    for(in EditCaretMapping item : mapping){
        const Expected<EditBoxCaretStop> stop = TryMakeEditCaretStop(expectedText, textLines, clusters, boundaries, committedBytes, item, previousCommitted, previousDisplay);
        if(!stop.has_value())
            return false;
        outStops.push_back(stop.value());
        ++outLines[cast<usize>(stop.value().lineIndex)].stopCount;
    }
    u32 firstStop = 0u;
    for(mut EditCaretLine line : outLines){
        line.firstStop = firstStop;
        firstStop += line.stopCount;
    }
    return true;
}

b8 AdoptEditCaretGeometryInto(
    in StringView layoutText,
    in f32 layoutFontSize,
    in Span<TextLine> textLines,
    in Span<TextCluster> clusters,
    in usize glyphCount,
    in Point measure,
    in Rect ink,
    in StringView expectedText,
    in Span<EditCaretMapping> mapping,
    in usize committedBytes,
    in EditTextMode mode,
    mut Vector<usize> outBoundaries,
    mut Vector<EditBoxCaretStop> outStops,
    mut Vector<EditCaretLine> outLines
){
    if(!ValidateEditCaretAdoptionRequest(layoutText, layoutFontSize, textLines, clusters, glyphCount, measure, ink, expectedText, mapping, committedBytes, mode))
        return false;
    Vector<usize> boundaries;
    if(!TryBuildGraphemeBoundariesInto(expectedText, mode == EditTextMode::SingleLine, boundaries))
        return false;
    Vector<EditBoxCaretStop> stops;
    Vector<EditCaretLine> lines;
    if(!BuildEditCaretStopsAndLinesInto(expectedText, textLines, clusters, boundaries, committedBytes, mapping, stops, lines))
        return false;
    outBoundaries.clear();
    outBoundaries.reserve(boundaries.size());
    for(in usize boundary : boundaries)
        outBoundaries.push_back(boundary);
    outStops.clear();
    outStops.reserve(stops.size());
    for(in EditBoxCaretStop stop : stops)
        outStops.push_back(stop);
    outLines.clear();
    outLines.reserve(lines.size());
    for(in EditCaretLine line : lines)
        outLines.push_back(line);
    return true;
}

Expected<EditBoxPlacement> TryArrangeEditBoxViewport(
    in b8 ready,
    in Rect bounds,
    in Rect viewport,
    in Rect clip,
    in Point previousScroll,
    in f32 caretWidth,
    in b8 revealCaret,
    in EditTextMode textMode,
    in Rect visualBounds,
    in Point logicalSize,
    in StringView utf8Text,
    in Span<TextLine> textLines,
    in Span<TextCluster> clusters,
    in Span<usize> boundaries,
    in Span<EditCaretLine> caretLines,
    in usize displayCaret,
    in EditBoxRange selectionRange,
    in EditBoxRange preeditRange,
    in b8 composing
){
    if(!ready || !ValidateEditBoxViewportArrangeInputs(bounds, viewport, clip, previousScroll, caretWidth))
        return MakeUnexpected(Failure());
    const Expected<Rect> caret = ResolveEditCaretRect(utf8Text, textLines, clusters, boundaries, displayCaret);
    if(!caret.has_value())
        return MakeUnexpected(Failure());
    const Expected<EditBoxPlacement> placement = TryComputeEditBoxViewportPlacement(bounds, viewport, clip, previousScroll, caretWidth, revealCaret, textMode, visualBounds, logicalSize, caret.value());
    if(!placement.has_value())
        return MakeUnexpected(Failure());
    const Expected<Rect> selection = ResolveEditCaretRangeOnLine(utf8Text, textLines, clusters, boundaries, caretLines, selectionRange, 0u, caretWidth);
    if(!selection.has_value())
        return MakeUnexpected(Failure());
    Rect preeditUnderline;
    if(composing){
        const Expected<Rect> underline = ResolveEditCaretRangeOnLine(utf8Text, textLines, clusters, boundaries, caretLines, preeditRange, 0u, caretWidth);
        if(!underline.has_value())
            return MakeUnexpected(underline.error());
        preeditUnderline = underline.value();
    }
    if(!ValidateEditBoxArrangedSegments(placement.value(), caretWidth, selection.value(), preeditUnderline, composing))
        return MakeUnexpected(Failure());
    return placement.value();
}

Expected<EditBoxPlacement> TryArrangeEditBox(
    in b8 ready,
    in Rect bounds,
    in Insets padding,
    in Rect clip,
    in Point previousScroll,
    in f32 caretWidth,
    in b8 revealCaret,
    in EditTextMode textMode,
    in Rect visualBounds,
    in Point logicalSize,
    in StringView utf8Text,
    in Span<TextLine> textLines,
    in Span<TextCluster> clusters,
    in Span<usize> boundaries,
    in Span<EditCaretLine> caretLines,
    in usize displayCaret,
    in EditBoxRange selectionRange,
    in EditBoxRange preeditRange,
    in b8 composing
){
    if(!ready)
        return MakeUnexpected(Failure());
    const Expected<Rect> viewport = TryComputeEditBoxViewport(bounds, padding, clip, previousScroll, caretWidth);
    if(!viewport.has_value())
        return MakeUnexpected(Failure());
    return TryArrangeEditBoxViewport(
        ready,
        bounds,
        viewport.value(),
        clip,
        previousScroll,
        caretWidth,
        revealCaret,
        textMode,
        visualBounds,
        logicalSize,
        utf8Text,
        textLines,
        clusters,
        boundaries,
        caretLines,
        displayCaret,
        selectionRange,
        preeditRange,
        composing
    );
}

Expected<usize> TryHitTestEditBoxView(
    in b8 viewReady,
    in b8 geometryReady,
    in Point point,
    in EditBoxPlacement placement,
    in Span<EditCaretLine> lines,
    in Span<EditBoxCaretStop> stops
){
    if(!viewReady || !geometryReady || !IsFinite(point.x) || !IsFinite(point.y) || !IsFinite(placement.textOrigin.x) || !IsFinite(placement.textOrigin.y))
        return MakeUnexpected(Failure());
    return HitEditCaretGeometry(lines, stops, Point(point.x - placement.textOrigin.x, point.y - placement.textOrigin.y));
}

Expected<Rect> TryResolveEditCaretRectWhenReady(
    in b8 ready,
    in StringView text,
    in Span<TextLine> lines,
    in Span<TextCluster> clusters,
    in Span<usize> boundaries,
    in usize byte
){
    if(!ready)
        return MakeUnexpected(Failure());
    return ResolveEditCaretRect(text, lines, clusters, boundaries, byte);
}

Expected<usize> TryHitTestEditCaretGeometryWhenReady(
    in b8 ready,
    in Span<EditCaretLine> lines,
    in Span<EditBoxCaretStop> stops,
    in Point localPoint
){
    if(!ready)
        return MakeUnexpected(Failure());
    return HitEditCaretGeometry(lines, stops, localPoint);
}

Expected<usize> TryResolveEditCaretVerticalTargetWhenReady(
    in b8 ready,
    in StringView text,
    in Span<TextLine> lines,
    in Span<TextCluster> clusters,
    in Span<usize> boundaries,
    in Span<EditCaretLine> caretLines,
    in Span<EditBoxCaretStop> stops,
    in usize displayCaret,
    in b8 down,
    in f32 preferredX
){
    if(!ready)
        return MakeUnexpected(Failure());
    return ResolveEditCaretVerticalTarget(text, lines, clusters, boundaries, caretLines, stops, displayCaret, down, preferredX);
}

Expected<Rect> TryResolveEditCaretRangeOnLineWhenReady(
    in b8 ready,
    in StringView text,
    in Span<TextLine> lines,
    in Span<TextCluster> clusters,
    in Span<usize> boundaries,
    in Span<EditCaretLine> caretLines,
    in EditBoxRange range,
    in u32 lineIndex,
    in f32 breakWidth
){
    if(!ready)
        return MakeUnexpected(Failure());
    return ResolveEditCaretRangeOnLine(text, lines, clusters, boundaries, caretLines, range, lineIndex, breakWidth);
}

Expected<EditNavigationResult> TryResolveTextAreaNavigationTarget(
    in b8 geometryReady,
    in b8 page,
    in EditNavigationDirection direction,
    in EditNavigationSnapshot preferred,
    in f32 viewportHeight,
    in usize modelCaret,
    in usize displayCaret,
    in StringView utf8Text,
    in Span<TextLine> textLines,
    in Span<TextCluster> clusters,
    in Span<usize> boundaries,
    in Span<EditCaretLine> caretLines,
    in Span<EditBoxCaretStop> stops
){
    const Expected<Rect> caret = TryResolveEditCaretRectWhenReady(geometryReady, utf8Text, textLines, clusters, boundaries, displayCaret);
    if(!caret.has_value())
        return MakeUnexpected(Failure());
    const Expected<f32> preferredX = TryResolveTextAreaPreferredX(preferred, caret.value());
    if(!preferredX.has_value())
        return MakeUnexpected(Failure());
    const b8 down = direction == EditNavigationDirection::Down || direction == EditNavigationDirection::PageDown;
    Expected<usize> resolved = MakeUnexpected(Failure());
    if(page)
        resolved = ResolveEditCaretPageTarget(caretLines, stops, modelCaret, caret.value(), down, preferredX.value(), viewportHeight);
    else
        resolved = TryResolveEditCaretVerticalTargetWhenReady(geometryReady, utf8Text, textLines, clusters, boundaries, caretLines, stops, displayCaret, down, preferredX.value());
    if(!resolved.has_value())
        return MakeUnexpected(resolved.error());
    return EditNavigationResult(resolved.value(), preferredX.value());
}


