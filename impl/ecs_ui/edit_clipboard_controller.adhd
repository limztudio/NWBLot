#include "text_edit_session.adhd"
#include "clipboard_types.adhd"
#include "edit_clipboard_policy.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


UiEditClipboardStatus ResolveStaleUiEditClipboardStatus(in b8 sameOwner, in b8 cancelledCleanly){
    if(!cancelledCleanly)
        return UiEditClipboardStatus::NativeFailure;
    if(sameOwner)
        return UiEditClipboardStatus::StaleModel;
    return UiEditClipboardStatus::StaleOwner;
}

UiEditClipboardResult MakeUiEditClipboardStatusResult(in UiEditClipboardStatus status){
    UiEditClipboardResult outResult;
    outResult.status = status;
    return outResult;
}

UiEditClipboardResult MakeAppliedUiEditClipboardResult(
    in u64 previousRevision,
    in u64 currentRevision,
    in usize previousAnchor,
    in usize currentAnchor,
    in usize previousCaret,
    in usize currentCaret
){
    UiEditClipboardResult outResult;
    outResult.status = UiEditClipboardStatus::Applied;
    outResult.textChanged = currentRevision != previousRevision;
    outResult.selectionChanged = currentAnchor != previousAnchor || currentCaret != previousCaret;
    return outResult;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The OS owns transfer and native selection.
// This controller owns copied request fences, never a model pointer.
// Cancel before any local edit/selection change, focus loss, owner removal or model replacement.
// Drain before host edits.
// End native text input before a drain that may apply cut/paste, and restart it with the resulting surrounding text.
[modular]
class UiEditClipboardController : NoCopy{
    private mut IClipboardService m_service;
    private ClipboardCompletion m_completion = ClipboardCompletion();
    private EditModelSnapshot m_expectedModel;
    private String m_insertText;
    private UiTextEditOwner m_owner;
    private ClipboardRequestToken m_token;
    private ClipboardChannel m_channel = ClipboardChannel::Clipboard;
    private EditClipboardAction m_action = EditClipboardAction::None;

    public UiEditClipboardController(mut IClipboardService service){
        this.m_service = service;
    }

    public ~UiEditClipboardController(){
        if(!this.cancel())
            TerminateInvariant();
    }

    public UiEditClipboardResult request(in UiTextEditOwner owner, in EditModel model, in EditClipboardAction action, in ClipboardChannel channel, in b8 readOnly){
        if(!this.m_service.isOwnerThread())
            return MakeUiEditClipboardStatusResult(UiEditClipboardStatus::WrongThread);
        if(!owner.valid())
            return MakeUiEditClipboardStatusResult(UiEditClipboardStatus::InvalidOwner);
        if(!this.cancel())
            return MakeUiEditClipboardStatusResult(UiEditClipboardStatus::NativeFailure);
        const Expected<b8, UiEditClipboardStatus> reads = UiEditClipboardPolicy().validateAction(
            action,
            cast<u8>(channel) <= cast<u8>(ClipboardChannel::PrimarySelection),
            readOnly,
            model.composition().active,
            model.hasSelection()
        );
        if(!reads.has_value())
            return MakeUiEditClipboardStatusResult(reads.error());
        const ClipboardCapabilities capabilities = this.m_service.capabilities(channel);
        if(reads.value()){
            if(!capabilities.readText)
                return MakeUiEditClipboardStatusResult(UiEditClipboardStatus::Unsupported);
        }
        else{
            if(!capabilities.writeText)
                return MakeUiEditClipboardStatusResult(UiEditClipboardStatus::Unsupported);
        }
        Expected<ClipboardRequestToken, ClipboardAdmission> result = MakeUnexpected(ClipboardAdmission::WrongThread);
        if(reads.value())
            result = this.m_service.requestReadText(channel);
        else
            result = this.m_service.requestWriteText(channel, model.selectedText());
        if(!result.has_value()){
            if(result.error() == ClipboardAdmission::WrongThread)
                return MakeUiEditClipboardStatusResult(UiEditClipboardStatus::WrongThread);
            return MakeUiEditClipboardStatusResult(UiEditClipboardStatus::QueueFull);
        }
        if(!result.value().valid())
            return MakeUiEditClipboardStatusResult(UiEditClipboardStatus::NativeFailure);
        this.m_token = result.value();
        this.m_owner = owner;
        this.m_channel = channel;
        this.m_action = action;
        this.m_expectedModel.capture(model);
        return MakeUiEditClipboardStatusResult(UiEditClipboardStatus::Pending);
    }

    public UiEditClipboardResult request(in UiTextEditOwner owner, in EditModel model, in EditClipboardAction action, in ClipboardChannel channel){
        return this.request(owner, model, action, channel, false);
    }

    public UiEditClipboardResult request(in UiTextEditOwner owner, in EditModel model, in EditClipboardAction action){
        return this.request(owner, model, action, ClipboardChannel::Clipboard, false);
    }

    public UiEditClipboardResult drain(in UiTextEditOwner owner, mut EditModel model, in b8 readOnly){
        if(!this.m_service.isOwnerThread())
            return MakeUiEditClipboardStatusResult(UiEditClipboardStatus::WrongThread);
        if(!this.m_token.valid())
            return UiEditClipboardResult();
        if(this.m_owner != owner || !this.m_expectedModel.matches(model)){
            const b8 sameOwner = this.m_owner == owner;
            return MakeUiEditClipboardStatusResult(ResolveStaleUiEditClipboardStatus(sameOwner, this.cancel()));
        }
        const ClipboardPollResult poll = this.m_service.poll(this.m_token, this.m_completion);
        if(poll == ClipboardPollResult::Pending)
            return MakeUiEditClipboardStatusResult(UiEditClipboardStatus::Pending);
        if(poll == ClipboardPollResult::WrongThread)
            return MakeUiEditClipboardStatusResult(UiEditClipboardStatus::WrongThread);
        UiEditClipboardResult result = MakeUiEditClipboardStatusResult(UiEditClipboardStatus::Cancelled);
        if(poll == ClipboardPollResult::Completed){
            ClipboardOperation operation = ClipboardOperation::WriteText;
            if(this.m_action == EditClipboardAction::Paste)
                operation = ClipboardOperation::ReadText;
            if(this.m_completion.token == this.m_token && this.m_completion.channel == this.m_channel && this.m_completion.operation == operation)
                result = this.applyCompletion(model, readOnly);
            else
                result.status = UiEditClipboardStatus::NativeFailure;
        }
        this.clearRequest();
        return result;
    }

    public UiEditClipboardResult drain(in UiTextEditOwner owner, mut EditModel model){
        return this.drain(owner, model, false);
    }

    public b8 cancel(){
        if(!this.m_token.valid())
            return true;
        if(!this.m_service.isOwnerThread())
            return false;
        if(!this.m_service.cancel(this.m_token) && this.m_service.poll(this.m_token, this.m_completion) != ClipboardPollResult::InvalidRequest)
            return false;
        this.clearRequest();
        return true;
    }

    public b8 pending()const{
        return this.m_token.valid();
    }

    public ClipboardRequestToken token()const{
        return this.m_token;
    }

    public EditClipboardAction action()const{
        return this.m_action;
    }

    private void clearRequest(){
        this.m_token = ClipboardRequestToken();
        this.m_owner = UiTextEditOwner();
        this.m_action = EditClipboardAction::None;
        this.m_expectedModel.clear();
        this.m_insertText.clear();
    }

    private UiEditClipboardResult applyCompletion(mut EditModel model, in b8 readOnly){
        if(this.m_completion.status != ClipboardStatus::Success){
            switch(this.m_completion.status){
            case ClipboardStatus::Unsupported: return MakeUiEditClipboardStatusResult(UiEditClipboardStatus::Unsupported);
            case ClipboardStatus::InvalidText: return MakeUiEditClipboardStatusResult(UiEditClipboardStatus::InvalidText);
            case ClipboardStatus::TooLarge: return MakeUiEditClipboardStatusResult(UiEditClipboardStatus::TooLarge);
            default: return MakeUiEditClipboardStatusResult(UiEditClipboardStatus::NativeFailure);
            }
        }
        const UiEditClipboardStatus prepStatus = UiEditClipboardPolicy().prepareInsertText(
            this.m_action,
            readOnly,
            model.textMode(),
            model.text().size(),
            model.selectionStart(),
            model.selectionEnd(),
            model.limits().maxBytes,
            StringView(this.m_completion.text),
            this.m_insertText
        );
        if(prepStatus != UiEditClipboardStatus::Pending)
            return MakeUiEditClipboardStatusResult(prepStatus);
        const u64 revision = model.revision();
        const usize anchor = model.anchor();
        const usize caret = model.caret();
        if(!model.replaceSelection(StringView(this.m_insertText)))
            return MakeUiEditClipboardStatusResult(UiEditClipboardStatus::ModelRejected);
        return MakeAppliedUiEditClipboardResult(revision, model.revision(), anchor, model.anchor(), caret, model.caret());
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

