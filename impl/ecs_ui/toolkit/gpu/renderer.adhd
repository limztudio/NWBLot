#include <impl/assets_scene/asset.adhd.h>
#include <impl/assets_ui_skin/types.adhd.h>
#include <impl/ecs_ui/toolkit/paint.adhd.h>

#include <core/assets/manager.h>
#include <core/graphics/runtime/runtime.h>
#include <core/task/gpu/output_layer_contributor.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class GpuRendererState;

// Main-thread owner. Resource invalidation follows the caller's joined GPU/graph teardown boundary.
class GpuRenderer final : public Core::IGpuTaskGraphOutputLayerContributor, NoCopy{
public:
    using ShaderPathResolveCallback = Function<Expected<Name>(const Name&, AStringView, const Name&)>;


public:
    GpuRenderer(Core::Alloc::GlobalArena& arena, Core::GraphicsRuntime& graphics, Core::Assets::AssetManager& assetManager, ShaderPathResolveCallback shaderPathResolver);
    virtual ~GpuRenderer()noexcept override;


public:
    void setActiveSceneSubsystems(const ActiveSceneSubsystems* subsystems)noexcept;
    [[nodiscard]] b8 validateResources(u32 width, u32 height);
    void invalidateResources()noexcept;
    [[nodiscard]] b8 setSkin(const Core::Assets::AssetRef<UiSkin>& identity, const UiSkin& skin, u64 skinGeneration);
    // Rejection leaves the caller's snapshot unmoved. One immutable pending generation is admitted at a time.
    [[nodiscard]] b8 submit(DrawSnapshot&& snapshot)noexcept;
    void setCommandRecordingMode(GpuCommandRecordingMode::Enum mode)noexcept;
    [[nodiscard]] b8 hasPendingFrame()const noexcept;
    [[nodiscard]] u64 lastAcceptedGeneration()const noexcept;
    [[nodiscard]] Core::PresentationReceiptStatus::Enum lastAcceptedPresentationStatus()const noexcept;
    [[nodiscard]] b8 renderStandalone(const Core::AcquiredPresentationFrame& frame);


public:
    [[nodiscard]] virtual b8 prepareTaskGraphOutputLayer(const Core::AcquiredPresentationFrame& frame)override;
    [[nodiscard]] virtual Expected<Core::GpuTaskGraphOutputLayer> declareTaskGraphOutputLayer(Core::GpuTaskGraph& graph)override;
    virtual void acceptTaskGraphOutputLayer(u64 frameGeneration, const Core::QueueSubmissionToken& submissionToken)noexcept override;


private:
    NotNullUniquePtr<GpuRendererState, ArenaDeleter<GpuRendererState, Core::Alloc::GlobalArena>> m_state;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidGpuSubmissionReadinessToken(in b8 tokenValid, in b8 hasPhysicalQueueIdentity){
    return tokenValid && hasPhysicalQueueIdentity;
}

b8 MatchesValidatedGpuRendererExtent(
    in u32 currentWidth,
    in u32 currentHeight,
    in u32 requestedWidth,
    in u32 requestedHeight,
    in b8 hasSharedResources
){
    return currentWidth == requestedWidth && currentHeight == requestedHeight && hasSharedResources;
}

b8 CanAcceptGpuSkinInput(in b8 validIdentity, in u64 skinGeneration, in b8 hasSharedResources){
    return validIdentity && skinGeneration != 0u && hasSharedResources;
}

b8 CanSubmitGpuSnapshotState(
    in b8 hasPending,
    in b8 hasSharedResources,
    in b8 hasSkin,
    in u64 snapshotGeneration
){
    return !hasPending && hasSharedResources && hasSkin && snapshotGeneration != 0u;
}

b8 IsExclusivelyRetainedGpuFrame(in b8 hasFrame, in u32 referenceCount){
    return hasFrame && referenceCount == 1u;
}

b8 ShouldResetStaleRecycledGpuFrame(in b8 alreadyAssignedPending, in u64 frameGeneration){
    return alreadyAssignedPending && frameGeneration != 0u;
}

b8 MatchesPendingGpuFrameGeneration(in b8 hasPending, in u64 pendingGeneration, in u64 acceptedGeneration){
    return hasPending && pendingGeneration == acceptedGeneration;
}


