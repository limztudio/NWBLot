#include <impl/assets_material/asset.adhd>
#include <impl/ecs_render/components.adhd>
#include <impl/ecs_render/material/pipeline_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/components.adhd.h>
#include <impl/ecs_render/material/pipeline_types.adhd.h>
#include <impl/assets_material/asset.adhd.h>

#include <core/alloc/scratch.h>
#include <core/assets/global.h>
#include <core/graphics/api.h>

#include <global/containers.h>
#include <global/hash_utils.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class PixelShader;
class MeshShader;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using MaterialTypedByteVector = Vector<u8, Core::Alloc::GlobalArena>;
using MaterialTypedLayoutBlockVector = Vector<MaterialTypedLayoutBlock, Core::Alloc::GlobalArena>;
using MaterialTypedLayoutFieldVector = Vector<MaterialTypedLayoutField, Core::Alloc::GlobalArena>;
using MaterialResourceReferenceVector = Vector<MaterialResourceReference, Core::Alloc::GlobalArena>;
using MaterialTypedByteDataVector = Vector<u8, Core::Alloc::ScratchArena>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct MaterialPipelineKeyHasher{
    [[nodiscard]] usize operator()(const MaterialPipelineKey& key)const noexcept{
        return HashMaterialPipelineKey(key);
    }
};
struct MaterialPipelineKeyEqualTo{
    [[nodiscard]] b8 operator()(const MaterialPipelineKey& lhs, const MaterialPipelineKey& rhs)const noexcept{
        return EqualMaterialPipelineKey(lhs, rhs);
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MaterialSurfaceInfo{
    public Name materialName = s_NameNone;
    public Name materialInterface = s_NameNone;
    public String shaderVariant;
    public AssetRef<PixelShader> pixelShader;
    public AssetRef<MeshShader> meshShader;
    // Transparent surface materials require this cook-generated AVBOIT accumulation shader; opaque materials carry none.
    public AssetRef<PixelShader> avboitAccumulatePixelShader;
    // Occupancy/extinction must evaluate the same surface.renderCoverage and follow the same presence contract.
    public AssetRef<PixelShader> avboitOccupancyPixelShader;
    public AssetRef<PixelShader> avboitExtinctionPixelShader;
    public u64 typedLayoutHash = 0u;
    public Vector<MaterialTypedLayoutBlock> typedLayoutBlocks;
    public Vector<MaterialTypedLayoutField> typedLayoutFields;
    public Vector<MaterialResourceReference> resourceReferences;
    // The cooked constants have zero-filled resource words. The renderer patches a working copy and restores from this copy on invalidation.
    public Vector<u8> unpatchedConstantTypedBytes;
    public Vector<u8> constantTypedBytes;
    public Vector<u8> mutableDefaultTypedBytes;
    public u32 shadingModelId = 0u;
    public u32 surfaceDispatchId = 0u;
    // CSG caps evaluate the generated surface hook with this material's constants. Opaque stage shaders have no hook.
    public b8 csgCapSurfaceDispatchAvailable = false;
    public b8 csgCapSurfaceDispatchUnavailableLogged = false;
    public b8 resourceReferencesResolved = false;
    // Refractive classifies RT casters; NwbMeshSurface owns IOR and shadow absorption values.
    public b8 transparent = false;
    public b8 twoSided = false;
    public b8 refractive = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

