////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_CSG_CLIP_CONTEXT_SLANGI
#define NWB_GRAPHICS_CSG_CLIP_CONTEXT_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../bindless/bindless_heap.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Clip and cap-fill paths share heap selectors for persistent CSG, material, mesh, deferred, and interval inputs.
struct NwbCsgClipContextSlots{
    uint receiverRanges;
    uint cutters;
    uint materialTyped;
    uint meshInstances;
    uint deferredBindlessResources;
    uint intervalSampleState;
    uint2 padding;
};

// Typed view over the global UniformBuffer table. The descriptor slot is carried by the existing mesh/CSG push data (or the receiver instance record), so no pass-local CSG clip cbuffer is needed.
#pragma warning(push)
#pragma warning(disable: 39001)
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_UNIFORM_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
ConstantBuffer<NwbCsgClipContextSlots, Std140DataLayout> g_NwbHeapCsgClipContextSlots[];
#pragma warning(pop)

ConstantBuffer<NwbCsgClipContextSlots, Std140DataLayout> nwbHeapCsgClipContextSlots(const uint slot){
    return g_NwbHeapCsgClipContextSlots[slot];
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

