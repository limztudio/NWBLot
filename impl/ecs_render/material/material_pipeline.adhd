// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/material/csg_shader_variant_builder.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StringView SelectMaterialPassPixelShaderVariant(
    in b8 csgClipPipeline,
    in b8 avboitCsgClipPipeline,
    in StringView csgShaderVariant,
    in StringView materialShaderVariant
){
    if(csgClipPipeline && !avboitCsgClipPipeline)
        return csgShaderVariant;
    return materialShaderVariant;
}

StringView SelectMaterialPassMeshShaderVariant(
    in b8 csgClipPipeline,
    in StringView csgShaderVariant,
    in StringView materialShaderVariant
){
    if(csgClipPipeline)
        return csgShaderVariant;
    return materialShaderVariant;
}

b8 IsSharedComputeEmulationProgram(
    in MaterialPipelineCsgMode csgMode,
    in Name sharedMeshShaderAssetName,
    in AssetRef<MeshShader> materialMeshShader,
    in StringView meshShaderVariant,
    in StringView defaultVariant
){
    return csgMode == MaterialPipelineCsgMode::None && UsesSharedMaterialMeshShader(sharedMeshShaderAssetName, materialMeshShader, meshShaderVariant, defaultVariant);
}

b8 CanBuildIndexedObjectGeometryPipeline(
    in b8 sharedObjectGeometry,
    in Name objectVertexShaderAssetName,
    in b8 hasVertexArchiveStage
){
    return sharedObjectGeometry && objectVertexShaderAssetName != s_NameNone && hasVertexArchiveStage;
}

b8 ValidateMaterialEvaluatorModuleMatch(in StringView existingAssignment, in StringView expectedAssignment, in Name materialKey){
    if(existingAssignment == expectedAssignment)
        return true;

    error(
        "RendererSystem: material '{}' uses a different CSG evaluator module than its active cutters"
        , materialKey.resolvedText()
    );
    return false;
}

void LogCsgEvaluatorModuleResolveFailed(in Name materialKey){
    error("RendererSystem: failed to resolve CSG evaluator module for material '{}'", materialKey.resolvedText());
}

b8 IsAliasFreeCaptureCountConsistent(in usize drawCount, in usize outputBufferCount, in usize outputHeapSlotCount){
    return drawCount != 0u && drawCount == outputBufferCount && outputBufferCount == outputHeapSlotCount;
}

b8 IsValidSharedComputeEmulationDrawWindow(in usize computeDrawCount, in usize minimumDrawCount, in usize allowedMaxDrawCount){
    return computeDrawCount >= minimumDrawCount && computeDrawCount <= allowedMaxDrawCount;
}


