#include <impl/ecs_mesh/components.adhd>
#include <impl/ecs_model/components.adhd>
#include <impl/ecs_render/components.adhd>
#include <impl/ecs_render/material/pipeline_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[component_asset("model_component")]
class ModelComponentAsset{
    public ModelComponent component;
}

[component_asset("mesh_component")]
class MeshComponentAsset{
    public MeshComponent component;
}

[component_asset("renderer_component")]
class RendererComponentAsset{
    public RendererComponent component;
}

[serialize]
class SingleAssetRefComponentPayloadBinary{
    public NameHash assetHash;
}

[serialize]
class RendererComponentPayloadBinary{
    public NameHash materialHash;
    public NameHash opticalVolumeGroupHash;
    public i32 opticalVolumePriority = 0;
    public i32 opticalMediumPriority = 0;
    public u8 visible = 1u;
    public u8 opticalVolumeCoincidence = 0u;
    public u8 opticalBoundaryMode = 0u;
    public u8 reserved0 = 0u;
    public u32 reserved1 = 0u;
}

[subsystem("bvh_subsystem")]
class BvhSubsystem{
    public AssetRef<ComputeShader> bitonicSortCs;
    public AssetRef<ComputeShader> fitCs;
    public AssetRef<ComputeShader> mortonCs;
    public AssetRef<ComputeShader> topologyCs;
    public AssetRef<ComputeShader> sceneRefitCs;
}

[subsystem("csg_subsystem")]
class CsgSubsystem{
    public Vector<AssetRef<CsgShape>> basicShapes;
    public AssetRef<PixelShader> intervalCapFillPs;
    public AssetRef<ComputeShader> intervalCombineCs;
    public AssetRef<ComputeShader> intervalPeelCs;
    public AssetRef<ComputeShader> receiverSpanBuildCs;
    public AssetRef<PixelShader> receiverSurfacePs;
    public AssetRef<PixelShader> refractionCapFillPs;
}

[subsystem("deferred_subsystem")]
class DeferredSubsystem{
    public AssetRef<ComputeShader> compositeCs;
    public AssetRef<PixelShader> compositePs;
    public AssetRef<VertexShader> compositeVs;
    public AssetRef<ComputeShader> lightingCs;
}

[subsystem("gi_subsystem")]
class GiSubsystem{
    public AssetRef<ComputeShader> surfelAgeFreeCs;
    public AssetRef<ComputeShader> surfelHashBuildCs;
    public AssetRef<ComputeShader> surfelResolveCs;
    public AssetRef<ComputeShader> surfelSpawnCs;
    public AssetRef<ComputeShader> surfelTraceBuildArgsCs;
    public AssetRef<ComputeShader> surfelTraceCs;
    public AssetRef<ComputeShader> surfelTraceHwCs;
    public AssetRef<ComputeShader> surfelUpsampleCs;
}

[subsystem("mesh_subsystem")]
class MeshSubsystem{
    public AssetRef<VertexShader> emulationVs;
    public AssetRef<ComputeShader> objectDecodeCs;
    public AssetRef<VertexShader> objectVs;
    public AssetRef<MeshShader> sharedMs;
}

[subsystem("reflection_subsystem")]
class ReflectionSubsystem{
    public AssetRef<ComputeShader> buildArgsCs;
    public AssetRef<ComputeShader> classifyCs;
    public AssetRef<ComputeShader> depthReduceCs;
    public AssetRef<ComputeShader> resolveHwCs;
    public AssetRef<ComputeShader> spatialCs;
    public AssetRef<ComputeShader> temporalCs;
}

[subsystem("refractive_subsystem")]
class RefractiveSubsystem{
    public AssetRef<ComputeShader> causticAccumulatorDecayCs;
    public AssetRef<ComputeShader> causticGeometryDownsampleCs;
    public AssetRef<ClosestHitShader> causticPhotonHwChit;
    public AssetRef<MissShader> causticPhotonHwMiss;
    public AssetRef<RayGenerationShader> causticPhotonHwRaygen;
    public AssetRef<ComputeShader> causticPhotonSwCs;
    public AssetRef<ComputeShader> causticResolveCs;
    public AssetRef<ComputeShader> refractionClassifyTilesCs;
    public AssetRef<ComputeShader> refractionFinalizeTilesCs;
    public AssetRef<ComputeShader> refractionResolveHwCs;
    public AssetRef<ComputeShader> refractionResolveScreenCs;
}

[subsystem("renderer_subsystem")]
class RendererSubsystem{
    public Vector<AssetRef<Sampler>> basicSamplers;
}

[subsystem("shadow_subsystem")]
class ShadowSubsystem{
    public AssetRef<ComputeShader> hardwareTransparentEvaluateCs;
    public AssetRef<ComputeShader> hardwareTransparentGatherCs;
    public AssetRef<ComputeShader> hardwareTransparentOverflowCs;
    public AssetRef<PixelShader> lightSpaceCapturePs;
    public AssetRef<VertexShader> lightSpaceCaptureVs;
    public AssetRef<ComputeShader> lightSpaceCullCs;
    public AssetRef<ComputeShader> lightSpaceFallbackCs;
    public AssetRef<ComputeShader> lightSpaceResolveCs;
    public AssetRef<ComputeShader> lightSpaceResolveHwCs;
    public AssetRef<ComputeShader> lightSpaceShadeCs;
    public AssetRef<ComputeShader> lightSpaceViewCs;
    public AssetRef<ComputeShader> shadowGeometryDownsampleCs;
    public AssetRef<ComputeShader> shadowRayqueryCs;
    public AssetRef<ComputeShader> shadowRayquerySoftCs;
    public AssetRef<ComputeShader> shadowReprojectMergeCombinedCs;
    public AssetRef<ComputeShader> shadowReprojectMergeCs;
    public AssetRef<ComputeShader> shadowResolveCombinedCs;
    public AssetRef<ComputeShader> shadowResolveCs;
    public AssetRef<ComputeShader> shadowResolveRgbCs;
    public AssetRef<ComputeShader> shadowResolveWaveletCombinedCs;
    public AssetRef<ComputeShader> swShadowOpaquePrepassCs;
    public AssetRef<ComputeShader> swShadowSoftOpaqueCs;
    public AssetRef<ComputeShader> swShadowTransparentBuildargsCs;
    public AssetRef<ComputeShader> swShadowTransparentClassifyCs;
    public AssetRef<ComputeShader> swShadowTransparentCoarseCs;
    public AssetRef<ComputeShader> swShadowTransparentIndirectCs;
    public AssetRef<ComputeShader> swShadowTransparentResolveCs;
    public AssetRef<ComputeShader> swShadowTransparentSoftCs;
}

[subsystem("transparent_subsystem")]
class TransparentSubsystem{
    public AssetRef<ComputeShader> avboitDepthWarpCs;
    public AssetRef<ComputeShader> avboitIntegrateCs;
    public AssetRef<ComputeShader> opticalBoundsFinalizeCs;
}


