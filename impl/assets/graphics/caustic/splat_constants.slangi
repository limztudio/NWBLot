////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_CAUSTIC_SPLAT_CONSTANTS_SLANGI
#define NWB_GRAPHICS_CAUSTIC_SPLAT_CONSTANTS_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Precision-only scale: keep smallest deposits nonzero and total R32_UINT accumulation below wrap; resolve divides it out.
#define NWB_CAUSTIC_FIXED_POINT_SCALE 1048576.0
#define NWB_CAUSTIC_FIXED_POINT_DEPOSIT_MAX 0x10000000u


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Converts finite positive flux to a saturating fixed-point deposit. Flux and bilinear weights are (0, +inf)
// and (0, 1) bounded respectively, so half math suffices; widen only at the saturating fixed-point conversion.
uint nwbCausticFluxToFixedPoint(half fluxChannel){
    if(!isfinite(fluxChannel) || fluxChannel <= half(0.0h))
        return 0u;
    const half scaled = fluxChannel * half(NWB_CAUSTIC_FIXED_POINT_SCALE);
    return (uint)min(float(scaled), (float)NWB_CAUSTIC_FIXED_POINT_DEPOSIT_MAX);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

