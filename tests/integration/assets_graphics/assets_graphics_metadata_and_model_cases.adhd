struct ModelMetadata{
    Core::Metascript::MetaArena metadataArena{ Name(s_AssetCaseTestsModelCookMetadataMetadata) };
    Core::Assets::AssetArena outputArena{ Name(s_AssetCaseTestsModelCookMetadataOutput) };
    Core::Alloc::ScratchArena scratchArena{ Name(s_AssetCaseTestsModelCookMetadataScratch) };
    Core::Metascript::Value asset{ metadataArena };
    Impl::ModelCookEntry entry{ outputArena };
    HashMap<Name, Name, Core::Metascript::MetaArena> expectedSkeletons{ metadataArena };
    const NWB::Path path{ outputArena, "tests/model_cook_metadata/model.nwb" };


public:
    ModelMetadata(){
        asset.makeMap();
    }


public:
    void addSkeleton(const AStringView objectName, const AStringView skeletonAsset){
        Core::Metascript::Value& object = asset.field("skeletons").field(objectName);
        object.field(s_ModelMetaSkeletonField).setString(skeletonAsset);
    }

    void addSkinnedMesh(const AStringView objectName, const AStringView skeleton, const AStringView expectedObject){
        Core::Metascript::Value& object = asset.field(s_ModelMetaSkinnedMeshesField).field(objectName);
        object.field("skin").setString("tests/model_cook_metadata/skin");
        object.field(s_ModelMetaSkeletonField).setString(skeleton);
        const auto objectIdentity = Name::FromText(objectName);
        ASSERT_TRUE(objectIdentity);
        const auto expectedIdentity = Name::FromText(expectedObject);
        ASSERT_TRUE(expectedIdentity);
        expectedSkeletons.insert_or_assign(*objectIdentity, *expectedIdentity);
    }

    [[nodiscard]] b8 parse(){
        auto result = Impl::ParseModelCookMetadata(Name(s_AssetCaseTestsModelCookMetadataModel), path, asset, outputArena, scratchArena);
        if(!result)
            return false;
        entry = Move(*result);
        return true;
    }

    void verifyObjectReferences()const{
        ASSERT_EQ(entry.skinnedMeshObjects.size(), expectedSkeletons.size());
        for(const Impl::ModelSkinnedMeshObject& object : entry.skinnedMeshObjects){
            const auto expected = expectedSkeletons.find(object.name);
            ASSERT_NE(expected, expectedSkeletons.end());
            EXPECT_EQ(object.skeletonObject, expected->second);
            EXPECT_EQ(object.skin.name(), Name("tests/model_cook_metadata/skin"));
        }
    }
};

static void AddIndexedModelObjects(const usize skeletonCount, const usize meshCount, ModelMetadata& metadata){
    for(usize index = 0u; index < skeletonCount; ++index){
        const auto objectName = StringFormat(metadata.metadataArena, "rig_{}", index);
        const auto assetName = StringFormat(metadata.metadataArena, "tests/model_cook_metadata/skeleton_{}", index);
        metadata.addSkeleton(objectName, assetName);
    }
    for(usize index = 0u; index < meshCount; ++index){
        const usize skeletonIndex = (index * 73u) % skeletonCount;
        const auto meshName = StringFormat(metadata.metadataArena, "mesh_{}", index);
        const auto objectName = StringFormat(metadata.metadataArena, "rig_{}", skeletonIndex);
        metadata.addSkinnedMesh(meshName, objectName, objectName);
    }
}

struct ModelInputs{
    Core::Assets::AssetArena arena{ Name(s_AssetCaseTestsModelPayloadInputs) };
    Core::Alloc::ScratchArena scratchArena{ Name(s_AssetCaseTestsModelPayloadValidationScratch) };
    Impl::Model model{ arena, Name(s_AssetCaseTestsModelPayloadModel) };
    Impl::Model::SkeletonObjectVector skeletonObjects{ arena };
    Impl::Model::StaticMeshObjectVector staticMeshObjects{ arena };
    Impl::Model::SkinnedMeshObjectVector skinnedMeshObjects{ arena };


public:
    ModelInputs(){
        skeletonObjects.push_back(Impl::ModelSkeletonObject{ .name = Name(s_ModelRigSegment), .skeleton = Core::Assets::AssetRef<Impl::Skeleton>("tests/model_payload/skeleton") });
        staticMeshObjects.push_back(Impl::ModelStaticMeshObject{ .name = Name(s_ModelPayloadProp), .mesh = Core::Assets::AssetRef<Impl::Mesh>(s_TestsModelPayloadMesh.data()), .material = {}, .parentObject = Name(s_ModelRigSegment), .parentJoint = Name(s_AssetCaseHand) });
        skinnedMeshObjects.push_back(Impl::ModelSkinnedMeshObject{ .name = Name(s_ModelBodySegment), .skin = Core::Assets::AssetRef<Impl::Skin>("tests/model_payload/skin"), .material = {}, .skeletonObject = Name(s_ModelRigSegment) });
        publish();
    }


public:
    void publish(){
        model.setObjects(Impl::Model::SkeletonObjectVector(skeletonObjects), Impl::Model::StaticMeshObjectVector(staticMeshObjects), Impl::Model::SkinnedMeshObjectVector(skinnedMeshObjects));
    }
};


