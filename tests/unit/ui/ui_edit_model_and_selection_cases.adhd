void VerifyUiEditGraphemeTests_PassesEveryPinnedOfficialUnicode17ExtendedGraphemeCase(mut UiEditGraphemeTests self){
    for(usize index = 0u; index < 766u; ++index){
        const ScopedTestTrace trace = ScopedTestTrace(index);
        const Expected<EditBoundaryVector> actualResult = self.buildBoundaries(self.conformanceText(index));
        ASSERT_TRUE(actualResult.has_value());
        const EditBoundaryVector actual = actualResult.value();
        const StringView expectedOffsets = self.conformanceExpectedOffsets(index);
        usize cursor = 0u;
        usize offsetIndex = 0u;
        while(cursor < expectedOffsets.size()){
            usize expected = 0u;
            while(cursor < expectedOffsets.size() && UiEditIsAsciiDigit(cast<u8>(expectedOffsets[cursor]))){
                expected = expected * 10u + cast<usize>(cast<u8>(expectedOffsets[cursor]) - 48u);
                ++cursor;
            }
            ASSERT_LT(offsetIndex, actual.size());
            EXPECT_EQ(actual[offsetIndex], expected);
            ++offsetIndex;
            if(cursor < expectedOffsets.size() && cast<u8>(expectedOffsets[cursor]) == 44u)
                ++cursor;
        }
        EXPECT_EQ(offsetIndex, actual.size());
    }
}

void VerifyUiEditGraphemeTests_RegionalIndicatorsPairAndEmojiModifierZwjSequencesRemainWhole(mut UiEditGraphemeTests self){
    const StringView flags = "\xF0\x9F\x87\xB0\xF0\x9F\x87\xB7\xF0\x9F\x87\xBA\xF0\x9F\x87\xB8\xF0\x9F\x87\xAF";
    Expected<EditBoundaryVector> boundaries = self.buildBoundaries(flags);
    ASSERT_TRUE(boundaries.has_value());
    ASSERT_EQ(boundaries.value().size(), 4u);
    EXPECT_EQ(boundaries.value()[0u], 0u);
    EXPECT_EQ(boundaries.value()[1u], 8u);
    EXPECT_EQ(boundaries.value()[2u], 16u);
    EXPECT_EQ(boundaries.value()[3u], 20u);
    const StringView emoji = "\xF0\x9F\x91\xA9\xF0\x9F\x8F\xBD\xE2\x80\x8D\xF0\x9F\x92\xBB";
    boundaries = self.buildBoundaries(emoji);
    ASSERT_TRUE(boundaries.has_value());
    ASSERT_EQ(boundaries.value().size(), 2u);
    EXPECT_EQ(boundaries.value()[1u], 15u);
    ASSERT_TRUE(self.m_model.setText(emoji));
    ASSERT_TRUE(self.m_model.backspace());
    EXPECT_TRUE(self.m_model.text().empty());
}

void VerifyUiEditGraphemeTests_GeneralSegmentationAcceptsCrLfButSingleLineValidationRejectsIt(mut UiEditGraphemeTests self){
    const Expected<EditBoundaryVector> boundaries = self.buildBoundaries("x\r\ny");
    ASSERT_TRUE(boundaries.has_value());
    ASSERT_EQ(boundaries.value().size(), 4u);
    EXPECT_EQ(boundaries.value()[0u], 0u);
    EXPECT_EQ(boundaries.value()[1u], 1u);
    EXPECT_EQ(boundaries.value()[2u], 3u);
    EXPECT_EQ(boundaries.value()[3u], 4u);
    EXPECT_FALSE(self.buildBoundaries("x\r\ny", true).has_value());
    EXPECT_EQ(boundaries.value()[2u], 3u);
    EXPECT_TRUE(UiEditValidateGraphemes(MakeUiEditSingleNullView()));
    EXPECT_FALSE(UiEditValidateGraphemes(MakeUiEditSingleNullView(), true));
}

void VerifyUiEditGraphemeTests_InvalidUtf8FailsBeforeAllocatingBoundaries(mut UiEditGraphemeTests self){
    const Expected<EditBoundaryVector> boundaries = self.buildBoundaries("ok");
    ASSERT_TRUE(boundaries.has_value());
    const usize before = self.allocationCount();
    EXPECT_FALSE(self.buildBoundaries("\xED\xA0\x80").has_value());
    EXPECT_FALSE(self.buildBoundaries("\xF5\x80\x80\x80").has_value());
    EXPECT_FALSE(self.buildBoundaries("\x80").has_value());
    EXPECT_EQ(self.allocationCount(), before);
    ASSERT_EQ(boundaries.value().size(), 3u);
    EXPECT_EQ(boundaries.value()[0u], 0u);
    EXPECT_EQ(boundaries.value()[1u], 1u);
    EXPECT_EQ(boundaries.value()[2u], 2u);
}

void VerifyUiEditGraphemeTests_ScalarPositionsDifferFromGraphemePositionsWithoutSplittingUtf8(mut UiEditGraphemeTests self){
    const StringView text = "a\xCC\x81";
    ASSERT_TRUE(UiEditValidateGraphemes(text));
    EXPECT_TRUE(IsUtf8ScalarBoundary(text, 0u));
    EXPECT_TRUE(IsUtf8ScalarBoundary(text, 1u));
    EXPECT_FALSE(IsUtf8ScalarBoundary(text, 2u));
    EXPECT_TRUE(IsUtf8ScalarBoundary(text, 3u));
    EXPECT_FALSE(IsUtf8ScalarBoundary(text, 4u));
    EXPECT_TRUE(IsUtf8ScalarBoundary("", 0u));
}


