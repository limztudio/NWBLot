const StringView s_UiComboLoanPanelKey = "panel";
const StringView s_UiComboLoanKey = "combo";
const StringView s_UiComboLoanSecondKey = "other";
const StringView s_UiContextClaimSliderKey = "slider";
const StringView s_UiContextClaimListKey = "list";
type UiComboLoanAcceptedState = UiFixtureAcceptedInputState<32u>;

enum<u8> UiComboLoanMutationKind{ None, RevisionSelect, KeySelect, TextSelect, EnabledOpen, TextRevision }


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ComboLoanCallbackSource : ComboSource{
    public mut ComboState m_state;
    public TestObserved<UiComboLoanMutationKind> m_kind = TestObserved<UiComboLoanMutationKind>(UiComboLoanMutationKind::None);
    public u64 m_key = 8u;
    public TestObserved<u64> m_mutations;
    public TestObserved<u64> m_revisionDelta;

    public ComboLoanCallbackSource(mut ComboState state){ this.m_state = state; }
    public u64 revision()const override{
        this.mutate(UiComboLoanMutationKind::RevisionSelect);
        return this.baseRevision() + this.m_revisionDelta.value();
    }
    public u64 key(in u64 index)const override{
        this.mutate(UiComboLoanMutationKind::KeySelect);
        return this.baseKey(index);
    }
    public StringView text(in u64 index)const override{
        this.mutate(UiComboLoanMutationKind::TextSelect);
        if(this.m_kind.value() == UiComboLoanMutationKind::TextRevision){
            this.m_kind.value() = UiComboLoanMutationKind::None;
            ++this.m_mutations.value();
            ++this.m_revisionDelta.value();
        }
        return this.baseText(index);
    }
    public b8 enabled(in u64 index)const override{
        this.mutate(UiComboLoanMutationKind::EnabledOpen);
        return this.baseEnabled(index);
    }
    public void arm(in UiComboLoanMutationKind kind){ this.arm(kind, 8u); }
    public void arm(in UiComboLoanMutationKind kind, in u64 key){
        this.m_kind.value() = kind;
        this.m_key = key;
    }
    public u64 mutations()const{ return this.m_mutations.value(); }
    public void mutate(in UiComboLoanMutationKind kind)const{
        if(this.m_kind.value() != kind)
            return;
        this.m_kind.value() = UiComboLoanMutationKind::None;
        ++this.m_mutations.value();
        if(kind == UiComboLoanMutationKind::EnabledOpen)
            this.m_state.open();
        else
            this.m_state.select(this.m_key);
    }
}

class UiComboLoanForeignRevisionSource : ComboSource{
    public mut ComboSource m_foreign;
    public TestObserved<b8> m_armed;
    public TestObserved<u64> m_mutations;

    public UiComboLoanForeignRevisionSource(mut ComboSource source){ this.m_foreign = source; }
    public StringView text(in u64 index)const override{
        if(this.m_armed.value()){
            this.m_armed.value() = false;
            ++this.m_foreign.contentRevision;
            ++this.m_mutations.value();
        }
        return this.baseText(index);
    }
    public void arm(){ this.m_armed.value() = true; }
    public u64 mutations()const{ return this.m_mutations.value(); }
}

class UiComboLoanTests : ComboFixture{
    public ComboLoanCallbackSource m_callbacks;

    public UiComboLoanTests(){ this.m_callbacks = ComboLoanCallbackSource(this.m_state); }
    public b8 declareCallbacks(in u64 generation){
        return this.declareSource(generation, this.m_callbacks, this.m_state);
    }
    public b8 acceptCallbacks(in u64 generation){
        return this.declareCallbacks(generation) && this.finishPanel() && this.m_context.commitFrame(generation);
    }
    public UiComboLoanAcceptedState accepted()const{ return CaptureAcceptedInput<32u>(this.m_context.input()); }
}

class UiCommandInputRouted{
    public InputRoutingResult routing;
    public InputEvent event;


}

class UiCommandInputTests{
    public InputRouter m_router;

    public UiCommandInputRouted send(in InputEvent event){
        const auto resolved = this.m_router.queue(NativeInput(event));
        EXPECT_TRUE(resolved.has_value());
        UiCommandInputRouted result;
        if(resolved.has_value()){
            result.routing = this.m_router.process();
            result.event = resolved.value();
        }
        return result;
    }
    public Expected<InputEvent> queueNative(in InputEvent event){
        return this.m_router.queue(NativeInput(event));
    }
    public Expected<ControlAction> take(in HitTarget host){
        return this.m_router.consumeControlAction(host.id, host.declarationGeneration, host.control);
    }
}

class UiCommandOwnerTests : RouterTestFixture{
    public Array<HitTarget, 3u> m_targets;

    public UiCommandOwnerTests(){
        this.m_targets[0u] = MakeCommandOwnerEditor();
        this.m_targets[1u] = MakeCommandOwnerList(2u, 0.0f);
        this.m_targets[2u] = MakeCommandOwnerList(3u, 140.0f);
        this.m_targets[2u].control.instanceGeneration = 32u;
        this.bind(this.m_targets[1u]);
    }
    public void bind(in HitTarget owner){
        this.m_targets[0u].commandOwner = owner.id;
        this.m_targets[0u].commandOwnerDeclarationGeneration = owner.declarationGeneration;
        this.m_targets[0u].commandControl = owner.control;
    }
    public void clearBinding(){
        this.m_targets[0u].commandOwner = WidgetId();
        this.m_targets[0u].commandOwnerDeclarationGeneration = 0u;
        this.m_targets[0u].commandControl = ControlToken();
    }
    public void press(in Key key){
        EXPECT_TRUE(this.send(Key(InputEventType::KeyDown, key)).commandConsumed);
        EXPECT_TRUE(this.send(Key(InputEventType::KeyUp, key)).commandConsumed);
    }
    public void focus(){
        InputEvent event;
        event.type = InputEventType::PrimaryDown;
        event.position = Point(10.0f, 10.0f);
        EXPECT_TRUE(this.send(event).pointerConsumed);
        event.type = InputEventType::PrimaryUp;
        EXPECT_TRUE(this.send(event).pointerConsumed);
        EXPECT_EQ(this.m_router.focus(), this.m_targets[0u].id);
    }
    public Expected<ControlAction> take(){ return this.take(1u); }
    public Expected<ControlAction> take(in usize owner){
        in HitTarget target = this.m_targets[owner];
        return this.m_router.consumeControlAction(target.id, target.declarationGeneration, target.control);
    }
    public PopupScope popup(){
        PopupScope scope;
        scope.token = PopupToken(WidgetId(10u), 12u, 13u, 14u);
        scope.bounds = Rect(0.0f, 0.0f, 300.0f, 200.0f);
        scope.viewport = scope.bounds;
        scope.layer = 1u;
        return scope;
    }
}

class UiContextClaimTests{
    public Context m_context;

    public b8 begin(in u64 generation){
        return this.m_context.beginFrame(generation) && this.m_context.beginRoot(WidgetRoot(17u, 1u));
    }
    public b8 commit(in u64 generation){
        return this.m_context.endRoot() && this.m_context.finishFrame() && this.m_context.commitFrame(generation);
    }
    public Expected<WidgetState> declareState(in StringView stableKey, in WidgetKind kind){
        const auto declared = this.m_context.declare(stableKey, kind);
        if(!declared.has_value())
            return MakeUnexpected(Failure());
        return declared.value();
    }
}


