////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/refraction/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RtRefractionState : NoCopy{
    public Array<Array<ShaderHandle, s_RefractionDiagnosticDensityVariantCount>, s_RefractionDiagnosticCsgVariantCount> m_refractionDiagnosticHwShaders;
    public Array<Array<ComputePipelineHandle, s_RefractionDiagnosticDensityVariantCount>, s_RefractionDiagnosticCsgVariantCount> m_refractionDiagnosticHwPipelines;
    public Array<Array<b8, s_RefractionDiagnosticDensityVariantCount>, s_RefractionDiagnosticCsgVariantCount> m_refractionDiagnosticHwPipelineFailed;
    public BindingLayoutHandle m_refractionBindingLayout = BindingLayoutHandle();
    public ShaderHandle m_refractionClassifyTilesShader = ShaderHandle();
    public ComputePipelineHandle m_refractionClassifyTilesPipeline = ComputePipelineHandle();
    public ShaderHandle m_refractionFinalizeTilesShader = ShaderHandle();
    public ComputePipelineHandle m_refractionFinalizeTilesPipeline = ComputePipelineHandle();
    public ShaderHandle m_refractionScreenShader = ShaderHandle();
    public ShaderHandle m_refractionHwShader = ShaderHandle();
    public ShaderHandle m_refractionCsgHwShader = ShaderHandle();
    public ShaderHandle m_refractionDenseScreenShader = ShaderHandle();
    public ShaderHandle m_refractionDenseHwShader = ShaderHandle();
    public ShaderHandle m_refractionDenseCsgHwShader = ShaderHandle();
    public ComputePipelineHandle m_refractionScreenPipeline = ComputePipelineHandle();
    public ComputePipelineHandle m_refractionHwPipeline = ComputePipelineHandle();
    public ComputePipelineHandle m_refractionCsgHwPipeline = ComputePipelineHandle();
    public ComputePipelineHandle m_refractionDenseScreenPipeline = ComputePipelineHandle();
    public ComputePipelineHandle m_refractionDenseHwPipeline = ComputePipelineHandle();
    public ComputePipelineHandle m_refractionDenseCsgHwPipeline = ComputePipelineHandle();
    public b8 m_refractionScreenPipelineFailed = false;
    public b8 m_refractionHwPipelineFailed = false;
    public b8 m_refractionCsgHwPipelineFailed = false;
    public b8 m_refractionDenseScreenPipelineFailed = false;
    public b8 m_refractionDenseHwPipelineFailed = false;
    public b8 m_refractionDenseCsgHwPipelineFailed = false;
    public u32 m_refractionCertifiedInstanceIndex = u32.max;
    public b8 m_refractionUseHardwareTrace = false;
    public b8 m_refractionHardwareTracingEnabled = true;

    public void invalidateResources(){
        for(usize csg = 0u; csg < s_RefractionDiagnosticCsgVariantCount; ++csg){
            for(usize dense = 0u; dense < s_RefractionDiagnosticDensityVariantCount; ++dense){
                this.m_refractionDiagnosticHwShaders[csg][dense].reset();
                this.m_refractionDiagnosticHwPipelines[csg][dense].reset();
                this.m_refractionDiagnosticHwPipelineFailed[csg][dense] = false;
            }
        }
        this.m_refractionBindingLayout.reset();
        this.m_refractionClassifyTilesShader.reset();
        this.m_refractionClassifyTilesPipeline.reset();
        this.m_refractionFinalizeTilesShader.reset();
        this.m_refractionFinalizeTilesPipeline.reset();
        this.m_refractionScreenShader.reset();
        this.m_refractionHwShader.reset();
        this.m_refractionCsgHwShader.reset();
        this.m_refractionDenseScreenShader.reset();
        this.m_refractionDenseHwShader.reset();
        this.m_refractionDenseCsgHwShader.reset();
        this.m_refractionScreenPipeline.reset();
        this.m_refractionHwPipeline.reset();
        this.m_refractionCsgHwPipeline.reset();
        this.m_refractionDenseScreenPipeline.reset();
        this.m_refractionDenseHwPipeline.reset();
        this.m_refractionDenseCsgHwPipeline.reset();
        this.m_refractionScreenPipelineFailed = false;
        this.m_refractionHwPipelineFailed = false;
        this.m_refractionCsgHwPipelineFailed = false;
        this.m_refractionDenseScreenPipelineFailed = false;
        this.m_refractionDenseHwPipelineFailed = false;
        this.m_refractionDenseCsgHwPipelineFailed = false;
        this.m_refractionCertifiedInstanceIndex = u32.max;
        this.m_refractionUseHardwareTrace = false;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize SelectRefractionVariantIndex(in b8 enabled){
    if(enabled)
        return 1u;
    return 0u;
}

u32 SelectRefractionCertifiedInstanceIndex(in b8 csg, in u32 certifiedInstanceIndex){
    if(csg)
        return s_RtInvalidSlot;
    return certifiedInstanceIndex;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

