////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "numeric_model_operations.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class IntegerEditModel : NoCopy{
    private NumericEditDraft m_draft;
    private i64 m_value = s_DefaultIntegerEditValue;

    public IntegerEditModel(){
        if(!this.canonicalize(this.m_value).has_value())
            TerminateInvariant();
    }

    public i64 value()const{ return this.m_value; }

    public in EditModel draft()const{ return this.m_draft.model(); }

    public mut EditModel lendDraft(){ return this.m_draft.lend(); }

    public b8 dirty()const{ return this.m_draft.dirty(); }

    public u64 revision()const{ return this.m_draft.revision(); }

    public b8 setDraft(in StringView text){ return this.m_draft.setText(text); }

    public b8 setValue(in i64 value){
        if(!this.canonicalize(value).has_value())
            return false;
        this.m_value = value;
        this.m_draft.advance();
        return true;
    }

    public NumericParseStatus status(in IntegerBounds bounds)const{ return EvaluateIntegerDraftStatus(this.draft().text(), bounds); }

    public NumericParseStatus status()const{ return this.status(IntegerBounds()); }

    public NumericEditResult submit(in IntegerBounds bounds){ return this.commit(bounds, false); }

    public NumericEditResult submit(){ return this.submit(IntegerBounds()); }

    public NumericEditResult blur(in IntegerBounds bounds){ return this.commit(bounds, true); }

    public NumericEditResult blur(){ return this.blur(IntegerBounds()); }

    public NumericEditResult cancel(){ return this.m_draft.restore(this.canonicalize(this.m_value), true); }

    public NumericEditResult abandon(){ return this.m_draft.restore(this.canonicalize(this.m_value), false); }

    public NumericEditResult applyAction(in IntegerBounds bounds, in EditAction action, in b8 readOnly){
        return ApplyNumericEditModelAction(bounds, ParseIntegerDraft(this.draft().text()), action, readOnly, this.m_draft, this.m_value);
    }

    private Expected<b8, ErrorCode> canonicalize(in i64 value){
        return CanonicalizeNumericEditDraft(value, this.m_draft);
    }

    private NumericEditResult commit(in IntegerBounds bounds, in b8 canonical){
        return CommitNumericEdit(bounds, ParseIntegerDraft(this.draft().text()), canonical, this.m_draft, this.m_value);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

