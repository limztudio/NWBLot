////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "edit_click_tracker.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiEditGeometry{
    public TextInputRect nativeCaretBounds(in Rect caret, in DisplayMetrics display)const{
        const VectorSingle physical = VectorSingle(caret.x, caret.y, caret.width, caret.height) * VectorSingle(display.pixelScaleX, display.pixelScaleY, display.pixelScaleX, display.pixelScaleY);
        const VectorSingle origin = Floor(VectorSingle(physical.x, physical.y, 0.0f, 0.0f));
        const VectorSingle size = Ceil(VectorSingle(physical.z, physical.w, 0.0f, 0.0f));
        const f64 minI32 = cast<f64>(i32.min);
        const f64 maxI32 = cast<f64>(i32.max);
        const VectorDouble coordinate = Clamp(VectorDouble(cast<f64>(origin.x), cast<f64>(origin.y), cast<f64>(size.x), cast<f64>(size.y)), minI32, maxI32);
        TextInputRect rect;
        rect.x = cast<i32>(coordinate.x);
        rect.y = cast<i32>(coordinate.y);
        rect.width = Max(1, cast<i32>(coordinate.z));
        rect.height = Max(1, cast<i32>(coordinate.w));
        return rect;
    }

    private Expected<Point> localTextPosition(
        in u64 generation,
        in Span<EditBoxCaretStop> stops,
        in Span<EditCaretLine> lines,
        in u64 geometryModelGeneration,
        in PopupToken geometryPopup,
        in EditTextMode textMode,
        in EditBoxPlacement placement,
        in UiTextEditOwner owner,
        in PopupToken popup,
        in Point position
    )const{
        if(
            generation == 0u || stops.empty() || lines.empty()
            || geometryModelGeneration != owner.modelGeneration || geometryPopup != popup
            || (textMode != EditTextMode::SingleLine && textMode != EditTextMode::Multiline)
            || (textMode == EditTextMode::SingleLine && lines.size() != 1u)
        )
            return MakeUnexpected(Failure());
        const VectorSingle local = VectorSingle(position.x, position.y, position.x, position.y) - VectorSingle(placement.textOrigin.x, placement.textOrigin.y, placement.textOrigin.x, placement.textOrigin.y);
        return Point(local.x, local.y);
    }

    private Expected<Point> resolveLocalStopTablePosition(
        in UiEditBoxGeometry geometry,
        in UiTextEditOwner owner,
        in PopupToken popup,
        in Point position
    )const{
        if(!geometry.stopTable.valid())
            return MakeUnexpected(Failure());
        in EditCaretStopTable stopTable = geometry.stopTable.deref();
        return this.localTextPosition(
            geometry.generation,
            stopTable.stops,
            stopTable.lines,
            geometry.modelGeneration,
            geometry.popup,
            geometry.textMode,
            geometry.placement,
            owner,
            popup,
            position
        );
    }

    public Expected<usize> hitCaret(
        in UiEditBoxGeometry geometry,
        in UiTextEditOwner owner,
        in PopupToken popup,
        in Point position
    )const{
        const Expected<Point> local = this.resolveLocalStopTablePosition(geometry, owner, popup, position);
        if(!local.has_value())
            return MakeUnexpected(Failure());
        in EditCaretStopTable stopTable = geometry.stopTable.deref();
        return HitEditCaretGeometry(stopTable.lines, stopTable.stops, local.value());
    }

    public Expected<usize> hitWord(
        in UiEditBoxGeometry geometry,
        in UiTextEditOwner owner,
        in PopupToken popup,
        in Point position
    )const{
        const Expected<Point> local = this.resolveLocalStopTablePosition(geometry, owner, popup, position);
        if(!local.has_value())
            return MakeUnexpected(Failure());
        in EditCaretStopTable stopTable = geometry.stopTable.deref();
        return TryHitEditWordCaretGeometry(stopTable.lines, stopTable.stops, local.value());
    }

    public void publish(
        in PopupToken popup,
        in EditBoxPlacement placement,
        in SharedEditCaretStopTable stopTable,
        in EditTextMode textMode,
        in EditBoxOptions options,
        in u64 generation,
        in u64 revision,
        in u64 externalRevision,
        in u64 modelGeneration,
        mut UiEditBoxGeometry outCandidate
    )const{
        outCandidate.popup = popup;
        outCandidate.placement = placement;
        outCandidate.stopTable = stopTable;
        outCandidate.textMode = textMode;
        outCandidate.options = options;
        outCandidate.options.placeholder = StringView();
        outCandidate.generation = generation;
        outCandidate.revision = revision;
        outCandidate.externalRevision = externalRevision;
        outCandidate.modelGeneration = modelGeneration;
    }

    public b8 commit(in u64 generation, mut UiEditBoxGeometry inOutCandidate, mut UiEditBoxGeometry inOutDisplayed)const{
        if(inOutCandidate.generation == generation){
            inOutDisplayed.options = inOutCandidate.options;
            inOutDisplayed.placement = inOutCandidate.placement;
            if(inOutDisplayed.stopTable != inOutCandidate.stopTable)
                inOutDisplayed.stopTable = inOutCandidate.stopTable;
            inOutDisplayed.generation = inOutCandidate.generation;
            inOutDisplayed.modelGeneration = inOutCandidate.modelGeneration;
            inOutDisplayed.revision = inOutCandidate.revision;
            inOutDisplayed.externalRevision = inOutCandidate.externalRevision;
            inOutDisplayed.popup = inOutCandidate.popup;
            inOutDisplayed.textMode = inOutCandidate.textMode;
            inOutCandidate.generation = 0u;
            inOutCandidate.stopTable = SharedEditCaretStopTable();
            return true;
        }
        return false;
    }

    public b8 focusedReady(in UiEditBoxGeometry displayed, in UiTextEditOwner owner, in PopupToken popup)const{
        return displayed.generation != 0u
            && displayed.options.enabled
            && displayed.modelGeneration == owner.modelGeneration
            && displayed.popup == popup;
    }

    public b8 sessionReady(in UiEditBoxGeometry displayed, in UiTextEditOwner owner, in PopupToken popup)const{
        return displayed.generation != 0u
            && displayed.modelGeneration == owner.modelGeneration
            && displayed.popup == popup;
    }
};

TextInputRect MakeUiEditNativeCaretRect(in UiEditBoxGeometry geometry, in DisplayMetrics display){
    return UiEditGeometry().nativeCaretBounds(geometry.placement.caret, display);
}


