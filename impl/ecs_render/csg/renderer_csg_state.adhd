#include <impl/ecs_csg/frame_types.adhd>
#include <impl/ecs_render/csg/work_region.adhd>
#include <impl/ecs_render/kernel/renderer_format_private.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererCsgState : NoCopy{
    // CSG layouts are push-only; resources use the global heap.
    public KernelBindingLayoutHandle m_clipBindingLayout = KernelBindingLayoutHandle();
    public KernelBindingLayoutHandle m_intervalPeelBindingLayout = KernelBindingLayoutHandle();
    public KernelBindingLayoutHandle m_receiverSpanBuildBindingLayout = KernelBindingLayoutHandle();
    public KernelBindingLayoutHandle m_intervalCombineBindingLayout = KernelBindingLayoutHandle();
    public KernelShaderHandle m_intervalPeelComputeShader = KernelShaderHandle();
    public KernelShaderHandle m_receiverSpanBuildComputeShader = KernelShaderHandle();
    public KernelShaderHandle m_intervalCombineComputeShader = KernelShaderHandle();
    public KernelShaderHandle m_intervalCapFillPixelShader = KernelShaderHandle();
    public KernelShaderHandle m_refractionCapFillPixelShader = KernelShaderHandle();
    public KernelComputePipelineHandle m_intervalPeelPipeline = KernelComputePipelineHandle();
    public KernelComputePipelineHandle m_receiverSpanBuildPipeline = KernelComputePipelineHandle();
    public KernelComputePipelineHandle m_intervalCombinePipeline = KernelComputePipelineHandle();
    public KernelGraphicsPipelineHandle m_intervalCapFillPipeline = KernelGraphicsPipelineHandle();
    public KernelGraphicsPipelineHandle m_refractionCapFillPipeline = KernelGraphicsPipelineHandle();
    public KernelBufferHandle m_receiverRangeBuffer = KernelBufferHandle();
    public KernelBufferHandle m_cutterBuffer = KernelBufferHandle();
    public KernelBufferHandle m_clipContextSlotsBuffer = KernelBufferHandle();
    public KernelBufferHandle m_intervalSampleStateBuffer = KernelBufferHandle();
    public CsgFrameStateCacheSignature m_frameStateCacheSignature = CsgFrameStateCacheSignature();
    public CsgFrameState m_frameStateCache = CsgFrameState();
    public usize m_receiverRangeBufferCapacity = 0u;
    public usize m_cutterBufferCapacity = 0u;
    public KernelGpuDescriptorHandle m_receiverRangeBufferHeapHandle = KernelGpuDescriptorHandle();
    public KernelGpuDescriptorHandle m_cutterBufferHeapHandle = KernelGpuDescriptorHandle();
    public KernelGpuDescriptorHandle m_clipContextSlotsHeapHandle = KernelGpuDescriptorHandle();
    public KernelGpuDescriptorHandle m_intervalSampleStateHeapHandle = KernelGpuDescriptorHandle();
    public b8 m_frameStateCacheValid = false;

    public void invalidateResources(){
        this.m_clipBindingLayout.reset();
        this.m_intervalPeelBindingLayout.reset();
        this.m_receiverSpanBuildBindingLayout.reset();
        this.m_intervalCombineBindingLayout.reset();
        this.m_intervalPeelComputeShader.reset();
        this.m_receiverSpanBuildComputeShader.reset();
        this.m_intervalCombineComputeShader.reset();
        this.m_intervalCapFillPixelShader.reset();
        this.m_refractionCapFillPixelShader.reset();
        this.m_intervalPeelPipeline.reset();
        this.m_receiverSpanBuildPipeline.reset();
        this.m_intervalCombinePipeline.reset();
        this.m_intervalCapFillPipeline.reset();
        this.m_refractionCapFillPipeline.reset();
        this.m_receiverRangeBuffer.reset();
        this.m_cutterBuffer.reset();
        this.m_clipContextSlotsBuffer.reset();
        this.m_receiverRangeBufferHeapHandle = KernelGpuDescriptorHandle();
        this.m_cutterBufferHeapHandle = KernelGpuDescriptorHandle();
        this.m_clipContextSlotsHeapHandle = KernelGpuDescriptorHandle();
        this.m_intervalSampleStateBuffer.reset();
        this.m_intervalSampleStateHeapHandle = KernelGpuDescriptorHandle();
        this.m_frameStateCacheSignature = CsgFrameStateCacheSignature();
        this.m_frameStateCache = CsgFrameState();
        this.m_receiverRangeBufferCapacity = 0u;
        this.m_cutterBufferCapacity = 0u;
        this.m_frameStateCacheValid = false;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

