void VerifyCpuTaskSchedulerTests_ForeignDependenciesAndForeignWaitsAreRejectedWithoutPublishingWork(){
    u32 invoked = 0u;
    b8 complete = true;
    DeadlineGuard deadline(false, s_TestTimeoutMS);
    CpuTaskScheduler first(0u);
    CpuTaskScheduler second(0u);
    const auto foreignTaskAdmission = first.submit(lambda[]() -> void{});
    ASSERT_TRUE(foreignTaskAdmission.has_value());
    const CpuTaskHandle foreign = foreignTaskAdmission.value();
    const auto rejected = second.submit(lambda[mut invoked]() -> void{
        ++invoked;
    }, foreign);
    EXPECT_FALSE(rejected.has_value());
    EXPECT_EQ(second.statistics().outstandingTasks, 0u);
    EXPECT_THROW(second.wait(foreign), RuntimeException);
    EXPECT_THROW(complete = second.isComplete(foreign), RuntimeException);
    first.wait(foreign);
    EXPECT_THROW(complete = second.isComplete(foreign), RuntimeException);
    EXPECT_TRUE(complete);
    const auto cpuTaskAdmission = second.submit(lambda[mut invoked]() -> void{
        ++invoked;
    }, foreign);
    EXPECT_FALSE(cpuTaskAdmission.has_value());
    EXPECT_EQ(invoked, 0u);
}

void VerifyCpuTaskSchedulerTests_RetiredHandlesStayCompleteWhenNodeStorageIsReused(){
    DeadlineGuard deadline(false, s_TestTimeoutMS);
    CpuTaskScheduler scheduler(0u);
    const auto retiredTaskAdmission = scheduler.submit(lambda[]() -> void{});
    ASSERT_TRUE(retiredTaskAdmission.has_value());
    const CpuTaskHandle retired = retiredTaskAdmission.value();
    scheduler.wait(retired);
    u32 invoked = 0u;
    const auto pendingTaskAdmission = scheduler.submit(lambda[mut invoked]() -> void{
        ++invoked;
    });
    ASSERT_TRUE(pendingTaskAdmission.has_value());
    const CpuTaskHandle pending = pendingTaskAdmission.value();
    const b8 retiredComplete = scheduler.isComplete(retired);
    const b8 pendingComplete = scheduler.isComplete(pending);
    scheduler.wait(retired);
    const u32 invokedAfterRetiredWait = invoked;
    scheduler.wait(pending);
    const u32 invokedAfterPendingWait = invoked;
    EXPECT_TRUE(retiredComplete);
    EXPECT_FALSE(pendingComplete);
    EXPECT_EQ(invokedAfterRetiredWait, 0u);
    EXPECT_EQ(invokedAfterPendingWait, 1u);
}

void VerifyCpuTaskSchedulerTests_ParentCompletionRetainsAncestorCapturesUntilGrandchildrenAndRetirementFinish(){
    DeadlineGuard deadline(false, s_TestTimeoutMS);
    TaskGate grandchildGate = TaskGate();
    Atomic<u32> retirements(0u);
    Atomic<u32> total(0u);
    Atomic<u32> retirementsSeenByDependent(0u);
    Atomic<b8> rejected(false);
    const TestSchedulerConfig config = HomogeneousWorkers(2u);
    CpuTaskScheduler scheduler(config);
    ScopeExit releaseGrandchild(lambda[mut grandchildGate]() -> void{
        grandchildGate.open();
    });
    CpuTaskHandle parent = CpuTaskHandle();
    native(mut scheduler, mut grandchildGate, mut retirements, mut total, mut rejected, mut parent){
        const auto cpuTaskAdmission = scheduler.submit([&scheduler, &grandchildGate, &retirements, &total, &rejected, parentCapture = LifetimeProbe(retirements, 11u)]() mutable {
            const auto secondCpuTaskAdmission = scheduler.submit([&scheduler, &grandchildGate, &retirements, &total, &rejected, &parentCapture, childCapture = LifetimeProbe(retirements, 13u)]() mutable {
                const auto thirdCpuTaskAdmission = scheduler.submit([&grandchildGate, &total, &parentCapture, &childCapture, grandchildCapture = LifetimeProbe(retirements, 17u)]()noexcept {
                    grandchildGate.block();
                    total.store(parentCapture.value + childCapture.value + grandchildCapture.value, MemoryOrder::release);
                });
                ASSERT_TRUE(thirdCpuTaskAdmission);
                const auto grandchild = *thirdCpuTaskAdmission;
                if(!grandchild.valid())
                    rejected.store(true, MemoryOrder::release);
            });
            ASSERT_TRUE(secondCpuTaskAdmission);
            const auto child = *secondCpuTaskAdmission;
            if(!child.valid())
                rejected.store(true, MemoryOrder::release);
        });
        ASSERT_TRUE(cpuTaskAdmission);
        parent = *cpuTaskAdmission;
    }
    const auto fourthCpuTaskAdmission = scheduler.submit(lambda[mut retirementsSeenByDependent, mut retirements]() -> void{
        retirementsSeenByDependent.store(retirements.load(MemoryOrder::acquire), MemoryOrder::release);
    }, parent);
    ASSERT_TRUE(fourthCpuTaskAdmission.has_value());
    const CpuTaskHandle dependent = fourthCpuTaskAdmission.value();
    EXPECT_TRUE(WaitUntil(grandchildGate.entered, s_GateTimeoutMS));
    EXPECT_FALSE(scheduler.isComplete(parent));
    EXPECT_FALSE(scheduler.isComplete(dependent));
    EXPECT_EQ(retirements.load(MemoryOrder::acquire), 0u);
    grandchildGate.open();
    scheduler.wait(dependent);
    EXPECT_FALSE(rejected.load(MemoryOrder::acquire));
    EXPECT_FALSE(grandchildGate.expired.load(MemoryOrder::acquire));
    EXPECT_EQ(total.load(MemoryOrder::acquire), 41u);
    EXPECT_EQ(retirements.load(MemoryOrder::acquire), 3u);
    EXPECT_EQ(retirementsSeenByDependent.load(MemoryOrder::acquire), 3u);
}

void VerifyCpuTaskSchedulerTests_ScopeJoinDoesNotWaitForAnUnrelatedRunningScope(){
    DeadlineGuard deadline(false, s_TestTimeoutMS);
    TaskGate unrelatedGate = TaskGate();
    const TestSchedulerConfig config = HomogeneousWorkers(2u);
    CpuTaskScheduler scheduler(config);
    CpuTaskScope unrelated(scheduler);
    CpuTaskScope owned(scheduler);
    ScopeExit releaseUnrelated(lambda[mut unrelatedGate]() -> void{
        unrelatedGate.open();
    });
    const auto unrelatedTaskAdmission = unrelated.submit(lambda[mut unrelatedGate]() -> void{
        unrelatedGate.block();
    });
    ASSERT_TRUE(unrelatedTaskAdmission.has_value());
    const CpuTaskHandle unrelatedTask = unrelatedTaskAdmission.value();
    EXPECT_TRUE(WaitUntil(unrelatedGate.entered, s_GateTimeoutMS));
    Atomic<b8> ownedFinished(false);
    const auto cpuTaskAdmission = owned.submit(lambda[mut ownedFinished]() -> void{
        ownedFinished.store(true, MemoryOrder::release);
    });
    EXPECT_TRUE(cpuTaskAdmission.has_value());
    if(cpuTaskAdmission.has_value()){
        EXPECT_TRUE(cpuTaskAdmission.value().valid());
    }
    owned.wait();
    const b8 ownedDone = ownedFinished.load(MemoryOrder::acquire);
    const b8 unrelatedDoneDuringOwned = scheduler.isComplete(unrelatedTask);
    const b8 unrelatedExpired = unrelatedGate.expired.load(MemoryOrder::acquire);
    unrelatedGate.open();
    unrelated.wait();
    EXPECT_TRUE(ownedDone);
    EXPECT_FALSE(unrelatedDoneDuringOwned);
    EXPECT_FALSE(unrelatedExpired);
}

void VerifyCpuTaskSchedulerTests_ScopeDestructionIncludesChildrenSubmittedDirectlyToTheScheduler(){
    DeadlineGuard deadline(false, s_TestTimeoutMS);
    Atomic<u32> retired(0u);
    Atomic<u32> invoked(0u);
    Atomic<b8> rejected(false);
    const TestSchedulerConfig config = HomogeneousWorkers(1u);
    CpuTaskScheduler scheduler(config);
    {
        CpuTaskScope scope(scheduler);
        native(mut scope, mut scheduler, mut retired, mut invoked, mut rejected){
            const auto cpuTaskAdmission = scope.submit([&]() {
                const auto secondCpuTaskAdmission = scheduler.submit([&invoked, capture = LifetimeProbe(retired, 23u)]()noexcept {
                    invoked.store(capture.value, MemoryOrder::release);
                });
                if(!secondCpuTaskAdmission || !secondCpuTaskAdmission->valid())
                    rejected.store(true, MemoryOrder::release);
            });
            EXPECT_TRUE(cpuTaskAdmission);
            if(cpuTaskAdmission)
                EXPECT_TRUE(cpuTaskAdmission->valid());
        }
    }
    EXPECT_FALSE(rejected.load(MemoryOrder::acquire));
    EXPECT_EQ(invoked.load(MemoryOrder::acquire), 23u);
    EXPECT_EQ(retired.load(MemoryOrder::acquire), 1u);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}

void VerifyCpuTaskSchedulerTests_OneWorkerCompletesNestedParallelRangesThroughCooperativeExecution(){
    DeadlineGuard deadline(false, s_TestTimeoutMS);
    const TestSchedulerConfig config = HomogeneousWorkers(1u);
    CpuTaskScheduler scheduler(config);
    Array<Atomic<u32>, 35> visited = Array<Atomic<u32>, 35>();
    const auto cpuTaskAdmission = scheduler.submit(lambda[mut scheduler, mut visited]() -> void{
        const auto outerRange = scheduler.parallelFor(0u, 5u, 1u, lambda[mut scheduler, mut visited](in usize outer) -> void{
            const auto innerRange = scheduler.parallelFor(0u, 7u, 1u, lambda[mut visited, in outer](in usize inner) -> void{
                visited[outer * 7u + inner].fetch_add(1u, MemoryOrder::relaxed);
            });
            EXPECT_TRUE(innerRange.has_value());
        });
        EXPECT_TRUE(outerRange.has_value());
    });
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    const CpuTaskHandle root = cpuTaskAdmission.value();
    scheduler.wait(root);
    ASSERT_EQ(visited.size(), 35u);
    for(usize index = 0u; index < 35u; ++index){
        EXPECT_EQ(visited[index].load(MemoryOrder::acquire), 1u);
    }
    const auto stats = scheduler.statistics();
    EXPECT_GT(stats.cooperativeTasks, 0u);
    EXPECT_EQ(stats.outstandingTasks, 0u);
}

void VerifyCpuTaskSchedulerTests_MainThreadTasksSubmittedByWorkersExecuteOnlyOnTheSchedulerOwner(){
    DeadlineGuard deadline(false, s_TestTimeoutMS);
    const TestSchedulerConfig config = HomogeneousWorkers(1u);
    CpuTaskScheduler scheduler(config);
    const ThreadId owner = QueryCurrentThreadId();
    Atomic<b8> published(false);
    Atomic<b8> rejected(false);
    Atomic<u32> invocations(0u);
    ThreadId actual = ThreadId();
    usize workerIndex = usize.max;
    const auto cpuTaskAdmission = scheduler.submit(lambda[mut scheduler, mut actual, mut workerIndex, mut invocations, mut rejected, mut published]() -> void{
        CpuTaskOptions mainOptions = CpuTaskOptions();
        mainOptions.target = CpuTaskTarget::MainThread;
        const auto secondCpuTaskAdmission = scheduler.submit(lambda[mut scheduler, mut actual, mut workerIndex, mut invocations]() -> void{
            actual = QueryCurrentThreadId();
            workerIndex = scheduler.currentWorkerIndex();
            invocations.fetch_add(1u, MemoryOrder::release);
        }, mainOptions);
        if(!secondCpuTaskAdmission.has_value() || !secondCpuTaskAdmission.value().valid()){
            rejected.store(true, MemoryOrder::release);
        }
        published.store(true, MemoryOrder::release);
    });
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    const CpuTaskHandle parent = cpuTaskAdmission.value();
    EXPECT_TRUE(WaitUntil(published, s_GateTimeoutMS));
    EXPECT_EQ(invocations.load(MemoryOrder::acquire), 0u);
    scheduler.wait(parent);
    EXPECT_FALSE(rejected.load(MemoryOrder::acquire));
    EXPECT_EQ(actual, owner);
    EXPECT_EQ(workerIndex, 0u);
    EXPECT_EQ(invocations.load(MemoryOrder::acquire), 1u);
}


