////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Watchdog, gates, and capture probes shared by the CPU scheduler suites.
namespace CpuTaskSchedulerTestSupport{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB::Core;

inline constexpr u32 s_PollIntervalMS = 1u;
inline constexpr u32 s_GateTimeoutMS = 4000u;
inline constexpr u32 s_TestTimeoutMS = 15000u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[noreturn]] void ExitTestProcess(u32 code)noexcept;

[[nodiscard]] b8 WaitUntil(const Atomic<b8>& condition, u32 timeoutMS)noexcept;


class DeadlineGuard final{
public:
    explicit DeadlineGuard(b8 deathTest = false, u32 timeoutMS = s_TestTimeoutMS);
    ~DeadlineGuard()noexcept = default;


private:
    JoiningThread m_watchdog;
};


struct TaskGate{
    Atomic<b8> entered{ false };
    Atomic<b8> released{ false };
    Atomic<b8> expired{ false };


public:
    void block()noexcept;

    void open()noexcept{ released.store(true, MemoryOrder::release); }
};


struct LifetimeProbe{
    Atomic<u32>* retirements;
    u32 value;


public:
    explicit LifetimeProbe(Atomic<u32>& counter, const u32 payload = 0u)noexcept
        : retirements(&counter)
        , value(payload)
    {}
    LifetimeProbe(const LifetimeProbe&) = delete;
    LifetimeProbe(LifetimeProbe&& other)noexcept;
    ~LifetimeProbe()noexcept;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace CpuTaskFanInTestSupport{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB::Core;
using CpuTaskSchedulerTestSupport::DeadlineGuard;
using CpuTaskSchedulerTestSupport::HomogeneousWorkers;
using CpuTaskSchedulerTestSupport::WaitUntil;

inline constexpr u32 s_GateTimeoutMS = 20000u;
inline constexpr u32 s_TestTimeoutMS = 60000u;

void VerifyFanIn(Alloc::ScratchArena& scratchArena, usize uniqueDependencyCount, usize repetitionCount);

inline void RunFanInWithScratch(const AStringView arenaName, const usize uniqueDependencyCount, const usize repetitionCount){
    Alloc::ScratchArena scratchArena(arenaName.data());
    VerifyFanIn(scratchArena, uniqueDependencyCount, repetitionCount);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace CpuTaskMpmcTestSupport{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB::Core;
using CpuTaskSchedulerTestSupport::DeadlineGuard;
using CpuTaskSchedulerTestSupport::s_PollIntervalMS;

inline constexpr u32 s_WatchdogTimeoutMS = 12000u;
inline constexpr u32 s_WorkerCount = 4u;
inline constexpr u32 s_ExternalProducerCount = 4u;
inline constexpr u32 s_ProducerCount = 1u + s_ExternalProducerCount + s_WorkerCount;
inline constexpr u32 s_TasksPerProducer = 128u;
inline constexpr u32 s_GateTimeoutMS = 4000u;

template<typename Predicate>
[[nodiscard]] b8 WaitUntil(const Predicate& predicate)noexcept(noexcept(static_cast<b8>(!predicate()))){
    const Timer begin = TimerNow();
    while(!predicate()){
        if(DurationInMS<u64>(TimerNow(), begin) >= s_GateTimeoutMS)
            return false;
        SleepMS(s_PollIntervalMS);
    }
    return true;
}

struct ProducerState{
    Array<Array<CpuTaskHandle, s_TasksPerProducer>, s_ProducerCount> handles{};
    Array<Atomic<u32>, s_ProducerCount * s_TasksPerProducer * 4u> visits{};
    Atomic<u32> ready{ 0u };
    Atomic<u32> workerMask{ 0u };
    Atomic<u32> consumedPrefixMask{ 0u };
    Array<Atomic<b8>, s_ProducerCount> published{};
    Atomic<b8> start{ false };
    Atomic<b8> expired{ false };
    Atomic<b8> rejected{ false };
    Atomic<b8> invalidOrder{ false };
};

void Produce(CpuTaskScheduler& scheduler, CpuTaskScope& scope, ProducerState& state, u32 producer);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


