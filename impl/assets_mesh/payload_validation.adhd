    return true;
}

b8 ReadMeshletsStream(in Span<u8> binary, in u64 count, mut usize inOutCursor, mut Vector<MeshletDesc> outValues){
    if(!ValidateMeshBinaryStreamRange(binary, count, s_MeshletDescElementBytes, outValues.max_size(), "meshlets", inOutCursor))
        return false;
    const usize valueCount = cast<usize>(count);
    outValues.clear();
    outValues.reserve(valueCount);
    for(usize i = 0u; i < valueCount; ++i){
        const Expected<MeshletDesc> item = ReadPOD<MeshletDesc>(binary, inOutCursor);
        if(!item.has_value())
            return false;
        outValues.push_back(item.value());
    }
    return true;
}

b8 ReadMeshletBoundsStream(in Span<u8> binary, in u64 count, mut usize inOutCursor, mut Vector<MeshletBounds> outValues){
    if(!ValidateMeshBinaryStreamRange(binary, count, s_MeshletBoundsElementBytes, outValues.max_size(), "meshlet bounds", inOutCursor))
        return false;
    const usize valueCount = cast<usize>(count);
    outValues.clear();
    outValues.reserve(valueCount);
    for(usize i = 0u; i < valueCount; ++i){
        const Expected<MeshletBounds> item = ReadPOD<MeshletBounds>(binary, inOutCursor);
        if(!item.has_value())
            return false;
        outValues.push_back(item.value());
    }
    return true;
}

b8 ReadMeshByteStream(in Span<u8> binary, in u64 count, in StringView label, mut usize inOutCursor, mut Vector<u8> outValues){
    if(!ValidateMeshBinaryStreamRange(binary, count, 1u, outValues.max_size(), label, inOutCursor))
        return false;
    const usize valueCount = cast<usize>(count);
    outValues.clear();
    outValues.reserve(valueCount);
    for(usize i = 0u; i < valueCount; ++i)
        outValues.push_back(binary[inOutCursor + i]);
    inOutCursor += valueCount;
    return true;
}

b8 ReadMeshLocalVertexRefsStream(in Span<u8> binary, in u64 count, mut usize inOutCursor, mut Vector<MeshletLocalVertexRef> outValues){
    if(!ValidateMeshBinaryStreamRange(binary, count, s_MeshletLocalVertexRefElementBytes, outValues.max_size(), "meshlet local vertex refs", inOutCursor))
        return false;
    const usize valueCount = cast<usize>(count);
    outValues.clear();
    outValues.reserve(valueCount);
    for(usize i = 0u; i < valueCount; ++i){
        const Expected<MeshletLocalVertexRef> item = ReadPOD<MeshletLocalVertexRef>(binary, inOutCursor);
        if(!item.has_value())
            return false;
        outValues.push_back(item.value());
    }
    return true;
}

b8 ReadMeshSolidTriangleWordsStream(in Span<u8> binary, in u64 count, mut usize inOutCursor, mut Vector<u32> outValues){
    if(!ValidateMeshBinaryStreamRange(binary, count, s_MeshSolidTriangleWordElementBytes, outValues.max_size(), "solid triangle words", inOutCursor))
        return false;
    const usize valueCount = cast<usize>(count);
    outValues.clear();
    outValues.reserve(valueCount);
    for(usize i = 0u; i < valueCount; ++i){
        const Expected<u32> item = ReadPOD<u32>(binary, inOutCursor);
        if(!item.has_value())
            return false;
        outValues.push_back(item.value());
    }
    return true;
}

b8 DeserializeMeshAssetBinary(
    in Span<u8> binary,
    mut Vector<f32x3u> outPositions,
    mut Vector<f16x4u> outNormals,
    mut Vector<f16x4u> outTangents,
    mut Vector<f32x2u> outUv0,
    mut Vector<f16x4u> outColors,
    mut Vector<MeshletDesc> outMeshlets,
    mut Vector<MeshletBounds> outMeshletBounds,
    mut Vector<u8> outMeshletPositionRefDeltas,
    mut Vector<u8> outMeshletAttributeRefDeltas,
    mut Vector<MeshletLocalVertexRef> outMeshletLocalVertexRefs,
    mut Vector<u8> outMeshletPrimitiveIndices,
    mut Vector<u32> outSolidTriangleWords
){
    usize cursor = 0u;
    const Expected<MeshBinaryHeader> headerResult = ReadPOD<MeshBinaryHeader>(binary, cursor);
    if(!headerResult.has_value()){
        error("Mesh::loadBinary failed: malformed header");
        return false;
    }
    const MeshBinaryHeader header = headerResult.value();
    if(header.magic != s_MeshBinaryMagic){
        error("Mesh::loadBinary failed: invalid mesh asset format; recook required");
        return false;
    }
    if(!ValidateMeshBaseHeader(header))
        return false;

    if(
        !ReadMeshPositionStream(binary, header.positionCount, cursor, outPositions)
        || !ReadMeshHalf4Stream(binary, header.normalCount, "normals", cursor, outNormals)
        || !ReadMeshHalf4Stream(binary, header.tangentCount, "tangents", cursor, outTangents)
        || !ReadMeshUv0Stream(binary, header.uv0Count, cursor, outUv0)
        || !ReadMeshHalf4Stream(binary, header.colorCount, "colors", cursor, outColors)
        || !ReadMeshletsStream(binary, header.meshletCount, cursor, outMeshlets)
        || !ReadMeshletBoundsStream(binary, header.meshletBoundCount, cursor, outMeshletBounds)
        || !ReadMeshByteStream(binary, header.meshletPositionRefDeltaByteCount, "meshlet position ref deltas", cursor, outMeshletPositionRefDeltas)
        || !ReadMeshByteStream(binary, header.meshletAttributeRefDeltaByteCount, "meshlet attribute ref deltas", cursor, outMeshletAttributeRefDeltas)
        || !ReadMeshLocalVertexRefsStream(binary, header.meshletLocalVertexRefCount, cursor, outMeshletLocalVertexRefs)
        || !ReadMeshByteStream(binary, header.meshletPrimitiveIndexCount, "meshlet primitive indices", cursor, outMeshletPrimitiveIndices)
        || !ReadMeshSolidTriangleWordsStream(binary, ComputeMeshSolidTriangleWordCount(header.meshletPrimitiveIndexCount), cursor, outSolidTriangleWords)
    )
        return false;

    if(cursor != binary.size()){
        error("Mesh::loadBinary failed: trailing bytes detected");
        return false;
    }
    return true;
}

const usize s_MeshBinaryHeaderBytes = 92u;

b8 SerializeMeshAssetBinary(
    in Span<f32x3u> positions,
    in Span<f16x4u> normals,
    in Span<f16x4u> tangents,
    in Span<f32x2u> uv0,
    in Span<f16x4u> colors,
    in Span<MeshletDesc> meshlets,
    in Span<MeshletBounds> meshletBounds,
    in Span<u8> meshletPositionRefDeltas,
    in Span<u8> meshletAttributeRefDeltas,
    in Span<MeshletLocalVertexRef> meshletLocalVertexRefs,
    in Span<u8> meshletPrimitiveIndices,
    in Span<u32> solidTriangleWords,
    mut Vector<u8> outBinary
){
    usize reserveBytes = s_MeshBinaryHeaderBytes;
    const b8 canReserve =
        AddBinaryRepeatedReserveBytes(reserveBytes, positions.size(), s_MeshPositionElementBytes)
        && AddBinaryRepeatedReserveBytes(reserveBytes, normals.size(), s_MeshHalf4ElementBytes)
        && AddBinaryRepeatedReserveBytes(reserveBytes, tangents.size(), s_MeshHalf4ElementBytes)
        && AddBinaryRepeatedReserveBytes(reserveBytes, uv0.size(), s_MeshUv0ElementBytes)
        && AddBinaryRepeatedReserveBytes(reserveBytes, colors.size(), s_MeshHalf4ElementBytes)
        && AddBinaryRepeatedReserveBytes(reserveBytes, meshlets.size(), s_MeshletDescElementBytes)
        && AddBinaryRepeatedReserveBytes(reserveBytes, meshletBounds.size(), s_MeshletBoundsElementBytes)
        && AddBinaryReserveBytes(reserveBytes, meshletPositionRefDeltas.size())
        && AddBinaryReserveBytes(reserveBytes, meshletAttributeRefDeltas.size())
        && AddBinaryRepeatedReserveBytes(reserveBytes, meshletLocalVertexRefs.size(), s_MeshletLocalVertexRefElementBytes)
        && AddBinaryReserveBytes(reserveBytes, meshletPrimitiveIndices.size())
        && AddBinaryRepeatedReserveBytes(reserveBytes, solidTriangleWords.size(), s_MeshSolidTriangleWordElementBytes)
        && CanStoreValueCount(outBinary, reserveBytes)
    ;
    if(!canReserve){
        error("MeshAssetCodec::serialize failed: mesh payload byte size overflows");
        return false;
    }

    outBinary.clear();
    outBinary.reserve(reserveBytes);
    AppendMeshBinaryStreams(
        positions,
        normals,
        tangents,
        uv0,
        colors,
        meshlets,
        meshletBounds,
        meshletPositionRefDeltas,
        meshletAttributeRefDeltas,
        meshletLocalVertexRefs,
        meshletPrimitiveIndices,
        solidTriangleWords,
        outBinary
    );
    return true;
}


