}

void VerifyUiWindowTests_ClientResizeKeepsTitleReachableAndClipsOversizedWindow(mut UiWindowTests self){
    WindowState state = WindowState();
    WindowOptions options = WindowOptions();
    options.initialBounds = Rect(500.0f, 300.0f, 240.0f, 150.0f);
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginWindow("window", "Viewport", state, options));
    ASSERT_TRUE(self.finishWindow());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    ASSERT_TRUE(self.begin(2u, DisplayMetrics(100.0f, 80.0f, 2.0f, 2.0f)));
    ASSERT_TRUE(self.m_builder.beginWindow("window", "Viewport", state, options));
    EXPECT_FLOAT_EQ(state.bounds.x, 0.0f);
    EXPECT_FLOAT_EQ(state.bounds.y, 0.0f);
    ASSERT_TRUE(self.finishWindow());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    const auto foundTitle = self.tryTarget(self.id("@window.title"));
    ASSERT_TRUE(foundTitle.has_value());
    const HitTarget title = foundTitle.value();
    EXPECT_FLOAT_EQ(title.clip.width, 100.0f);
    EXPECT_LE(title.clip.height, 80.0f);
    EXPECT_FALSE(self.m_context.input().hitTest(Point(150.0f, 15.0f)).valid());
}

