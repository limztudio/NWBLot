////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_mesh/asset.adhd>
#include <impl/ecs_mesh/runtime/mesh_requests.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RuntimeMeshBuffers{
    public BufferHandle positionBuffer;
    public BufferHandle normalBuffer;
    public BufferHandle tangentBuffer;
    public BufferHandle uv0Buffer;
    public BufferHandle colorBuffer;
    public BufferHandle meshletDescBuffer;
    public BufferHandle meshletBoundsBuffer;
    public BufferHandle meshletPositionRefDeltaBuffer;
    public BufferHandle meshletAttributeRefDeltaBuffer;
    public BufferHandle meshletLocalVertexRefBuffer;
    public BufferHandle meshletPrimitiveIndexBuffer;

    public b8 buffersValid()const{
        return this.positionBuffer.valid()
            && this.normalBuffer.valid()
            && this.tangentBuffer.valid()
            && this.uv0Buffer.valid()
            && this.colorBuffer.valid()
            && this.meshletDescBuffer.valid()
            && this.meshletBoundsBuffer.valid()
            && this.meshletPositionRefDeltaBuffer.valid()
            && this.meshletAttributeRefDeltaBuffer.valid()
            && this.meshletLocalVertexRefBuffer.valid()
            && this.meshletPrimitiveIndexBuffer.valid();
    }

    public b8 sameBuffers(in RuntimeMeshBuffers other)const{
        return this.positionBuffer == other.positionBuffer
            && this.normalBuffer == other.normalBuffer
            && this.tangentBuffer == other.tangentBuffer
            && this.uv0Buffer == other.uv0Buffer
            && this.colorBuffer == other.colorBuffer
            && this.meshletDescBuffer == other.meshletDescBuffer
            && this.meshletBoundsBuffer == other.meshletBoundsBuffer
            && this.meshletPositionRefDeltaBuffer == other.meshletPositionRefDeltaBuffer
            && this.meshletAttributeRefDeltaBuffer == other.meshletAttributeRefDeltaBuffer
            && this.meshletLocalVertexRefBuffer == other.meshletLocalVertexRefBuffer
            && this.meshletPrimitiveIndexBuffer == other.meshletPrimitiveIndexBuffer;
    }
}

class RuntimeMeshDesc{
    public RuntimeMeshBuffers buffers;
    public RuntimeMeshLocalBounds localBounds;
    public u64 version = 0u;
    public u64 geometryContentRevision = 0u;
    public Name meshKey = s_NameNone;
    public Span<u32> solidTriangleWords;
    public BufferHandle localBoundsBuffer;
    public BufferHandle meshletLocalBoundsBuffer;
    public EntityID entity = s_InvalidEntityId;
    public BufferHandle triangleIndexBuffer;
    public BufferHandle attributeBuffer;
    public u32 meshletCount = 0u;
    public u32 meshletPrimitiveIndexCount = 0u;
    public b8 dynamicMeshletBoundsFresh = false;
    public b8 dynamicMeshletConesFresh = false;

    public b8 valid()const{
        return this.entity.valid()
            && this.meshKey != s_NameNone
            && this.buffers.buffersValid()
            && this.meshletCount > 0u
            && this.meshletPrimitiveIndexCount > 0u
            && this.solidTriangleWords.size() == ExpectedMeshletSolidTriangleWordCount(this.meshletPrimitiveIndexCount)
            && this.localBounds.valid();
    }
}

interface IRuntimeMeshProvider{
    Expected<RuntimeMeshDesc> resolveRuntimeMesh(in EntityID entity);
    b8 hasRuntimeMeshBinding(in EntityID entity)const;
    void markLiveRuntimeMeshes(mut RuntimeMeshRequestSet requests);
}

class RenderableMeshDesc{
    public AssetRef<Mesh> mesh;
    public RuntimeMeshDesc runtimeMesh = RuntimeMeshDesc();
    public b8 runtime = false;

    public b8 valid()const{
        if(this.runtime)
            return this.runtimeMesh.valid();
        return this.mesh.valid();
    }
}

interface IRuntimeMeshRegistry{
    void registerRuntimeMeshProvider(mut IRuntimeMeshProvider provider);
    void unregisterRuntimeMeshProvider(mut IRuntimeMeshProvider provider);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(align_of<RuntimeMeshLocalBounds>() >= align_of<f32x4>(), "RuntimeMeshLocalBounds must stay SIMD-friendly");
static_assert(is_standard_layout<RuntimeMeshLocalBounds>(), "RuntimeMeshLocalBounds must stay layout-stable");
static_assert(is_trivially_copyable<RuntimeMeshLocalBounds>(), "RuntimeMeshLocalBounds must stay cheap to pass by value");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

