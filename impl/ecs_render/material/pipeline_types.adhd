#include <impl/ecs_render/mesh/instance_gpu_data.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> MaterialPipelinePass{
    Opaque,
    CsgReceiverSurface,
    AvboitOccupancy,
    AvboitExtinction,
    AvboitAccumulate,
    AvboitRefractionCapture
}

enum<u8> RenderPath{
    MeshShader,
    VertexIndexed,
    ComputeEmulation
}

enum<u8> MaterialPipelineCsgMode{
    None,
    ClipOnly
}

class MaterialPipelineCsgBindingUse{
    public b8 clip = false;
    public b8 avboitClip = false;
}

b8 MaterialPipelinePassUsesRendererAvboit(in MaterialPipelinePass pass){
    return pass == MaterialPipelinePass::AvboitOccupancy || pass == MaterialPipelinePass::AvboitExtinction || pass == MaterialPipelinePass::AvboitAccumulate || pass == MaterialPipelinePass::AvboitRefractionCapture;
}

b8 MaterialPipelinePassUsesRendererCsgShaderVariant(in MaterialPipelinePass pass){
    if(pass == MaterialPipelinePass::Opaque || pass == MaterialPipelinePass::CsgReceiverSurface)
        return true;
    return MaterialPipelinePassUsesRendererAvboit(pass);
}

b8 MaterialPipelinePassUsesRendererCsgClip(in MaterialPipelinePass pass, in b8 transparent){
    if(pass == MaterialPipelinePass::Opaque)
        return !transparent;
    if(pass == MaterialPipelinePass::CsgReceiverSurface)
        return true;
    return transparent && MaterialPipelinePassUsesRendererAvboit(pass);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Buffer identity alone does not describe which regions a retained draw generates and consumes.
class GeneratedGeometryOutputLayout{
    public b8 matches(in u32 indexByteOffset, in b8 indexed)const{
        return this.indexByteOffset == indexByteOffset && this.indexed == indexed;
    }

    public u32 indexByteOffset = 0u;
    public b8 indexed = false;
}

const usize s_MaterialInstanceVectorComponentCount = 4u;

class MaterialInstanceParameterNames{
    public Name parameterName;
    public Name blockName;
    public Name fieldName;
}

enum<u8> RendererResourceLookupMode{
    CreateMissing = 0u,
    PreparedOnly = 1u
}

class ShadowOccluderMaterialContext{
    public InstanceGpuData instance;
    public u32 constantByteOffset = 0u;
}

enum<u8> SampledTextureImportFailure{
    GraphUnavailable = 0u,
    MissingIdentity = 1u,
    ImportFailed = 2u
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_MaterialTypedWordBytes = 16u;

class MaterialTypedByteRange{
    public u32 byteOffset = 0u;
    public u32 byteCount = 0u;
}

class MaterialTypedInstanceRanges{
    public MaterialTypedByteRange constantRange;
    public MaterialTypedByteRange mutableRange;
}

class MaterialTypedByteRangeKey{
    public b8 operator==(in MaterialTypedByteRangeKey rhs)const{
        return this.materialName == rhs.materialName && this.typedLayoutHash == rhs.typedLayoutHash;
    }

    public usize hash()const{
        usize seed = hashValue(this.materialName);
        seed = hashCombineValue(seed, this.typedLayoutHash);
        return seed;
    }

    public Name materialName;
    public u64 typedLayoutHash = 0u;
}

class MaterialTypedByteAppendRange{
    public MaterialTypedByteRange byteRange;
    public usize alignedByteEnd = 0u;
}

b8 MaterialTypedByteRangeEmptyOffsetValid(in MaterialTypedByteRange range){
    return range.byteCount != 0u || range.byteOffset == 0u;
}


