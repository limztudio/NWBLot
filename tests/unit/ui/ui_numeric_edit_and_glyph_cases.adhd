class PlainHost final : public IEditBoxHost{
public:
    [[nodiscard]] virtual EditBoxResult edit(const WidgetState&, const EditBoxOptions&, EditModel&)noexcept override{
        ++edits;
        EditBoxResult result;
        result.valid = true;
        return result;
    }

    [[nodiscard]] virtual EditBoxResult editInPopup(const WidgetState&, const EditBoxOptions&, const PopupToken&, EditModel&)noexcept override{ return {}; }

    [[nodiscard]] virtual EditBoxResult editActions(const WidgetState&, const EditBoxOptions&, const PopupToken&, EditModel&, IEditActionSink&)noexcept override{ return {}; }

    [[nodiscard]] virtual EditBoxResult editNavigated(const WidgetState&, const EditBoxOptions&, const PopupToken&, EditModel&, EditNavigationState&, IEditNavigationResolver&, IEditActionSink&)noexcept override{ return {}; }

    [[nodiscard]] virtual b8 publish(const WidgetState&, const EditBoxView&, const EditBoxPlacement&, const EditBoxOptions&)noexcept override{ return true; }


public:
    usize edits = 0u;
};

class UiNumericEditBuilderTests : public NumericFixture{
public:
    void usePlainHost(PlainHost& host)noexcept{
        m_builder.setEditHost(&host);
    }

    void armLoanInteger()noexcept{
        m_host.onLoanInteger = &m_integer;
    }

    void armResetBuilder()noexcept{
        m_host.resetBuilder = &m_builder;
    }

    [[nodiscard]] Optional<HitTarget> findTarget(const WidgetId widget)const noexcept{
        if(const HitTarget* found = target(widget))
            return *found;
        return {};
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


