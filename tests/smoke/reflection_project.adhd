#include "reflection_probes_and_runtime.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ReflectionSmokeProject : IProjectEntryCallbacks{
    public ReflectionSmokeProject(mut ProjectRuntimeContext context){
        this.m_impl = ReflectionSmokeProjectImpl(context);
    }

    public b8 onStartup()override{
        return this.m_impl.onStartup();
    }

    public void onShutdown()override{
        this.m_impl.onShutdown();
    }

    public b8 onUpdate(in f32 delta)override{
        return this.m_impl.onUpdate(delta);
    }

    private ReflectionSmokeProjectImpl m_impl;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
