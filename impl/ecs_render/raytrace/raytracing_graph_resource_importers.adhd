////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TraceGeometryImportPolicy{
    public b8 hasHardwareRole(in u8 roles)const{
        const PreparedShadowTraceGeometryRole hardwareMask =
            PreparedShadowTraceGeometryRole::HardwarePosition
            | PreparedShadowTraceGeometryRole::HardwareIndex
            | PreparedShadowTraceGeometryRole::HardwareAttribute;
        return (roles & cast<u8>(hardwareMask)) != 0u;
    }

    public b8 hasSoftwareRole(in u8 roles)const{
        const PreparedShadowTraceGeometryRole softwareMask =
            PreparedShadowTraceGeometryRole::SoftwareNode
            | PreparedShadowTraceGeometryRole::SoftwarePosition
            | PreparedShadowTraceGeometryRole::SoftwareIndex
            | PreparedShadowTraceGeometryRole::SoftwareAttribute;
        return (roles & cast<u8>(softwareMask)) != 0u;
    }

    public usize computeBuildStateReserveCapacity(in usize parentStateCount)const{
        return parentStateCount + s_SortBuildStateCapacity;
    }

    public b8 isConstantBufferSceneSlot(in usize importedBufferIndex)const{
        return importedBufferIndex == 0u;
    }
}


