class ComboResolvedMetrics{
    public Point minimumSize = Point();
    public Insets padding = Insets();
    public f32 arrowExtent = 0.0f;
}

class ImageResolvedMetrics{
    public ImageMetrics metrics = ImageMetrics();
    public Name region = s_NameNone;
}

class ControlStyleMetrics{
    public Insets skinRegionsMaxPadding(in UiSkin skin, in Insets initial, in Span<Name> names, in Name fallback)const{
        Insets result = initial;
        for(in Name name : names){
            const Optional<in UiSkinRegion> found = TryResolveSelectableStateRegion(skin, name, fallback);
            if(found.has_value()){
                const Insets regionPadding(
                    found.value().padding.left,
                    found.value().padding.top,
                    found.value().padding.right,
                    found.value().padding.bottom
                );
                result = MaxUiPadding(result, regionPadding);
            }
        }
        return result;
    }

    public void buttonMetrics(in UiSkin skin, in WidgetStyle style, mut Point outSize, mut Insets outPadding)const{
        Array<Name, 4> names;
        names[0u] = style.button;
        names[1u] = style.buttonHover;
        names[2u] = style.buttonPressed;
        names[3u] = style.buttonDisabled;
        for(in Name name : names){
            const Optional<in UiSkinRegion> found = TryResolveSelectableStateRegion(skin, name, style.button);
            if(!found.has_value())
                continue;
            AccumulateButtonRegionMetrics(found.value(), outSize, outPadding);
        }
    }

    public Expected<f32> checkboxExtent(in UiSkin skin, in WidgetStyle style)const{
        if(!skin.hasRegion(style.checkbox))
            return MakeUnexpected(Failure());
        Array<Name, 4> names;
        names[0u] = style.checkbox;
        names[1u] = style.checkboxHover;
        names[2u] = style.checkboxChecked;
        names[3u] = style.checkboxDisabled;
        f32 checkboxExtent = style.checkboxExtent;
        for(in Name name : names){
            const Optional<in UiSkinRegion> found = TryResolveSelectableStateRegion(skin, name, style.checkbox);
            if(!found.has_value())
                return MakeUnexpected(Failure());
            checkboxExtent = ResolveUiSkinSquareExtent(checkboxExtent, found.value());
        }
        return checkboxExtent;
    }

    public Point editMinimumSize(in UiSkin skin, in EditBoxStyle editStyle)const{
        Point minimum = Point(s_StyleMinimumFieldWidth, 0.0f);
        Array<Name, 4> names;
        names[0u] = editStyle.normal;
        names[1u] = editStyle.hover;
        names[2u] = editStyle.focused;
        names[3u] = editStyle.disabled;
        for(in Name name : names){
            const Optional<in UiSkinRegion> found = TryResolveSelectableStateRegion(skin, name, editStyle.fallback);
            if(found.has_value())
                AccumulateEditRegionMinimumSize(found.value(), minimum);
        }
        return minimum;
    }

    public Insets editPadding(in UiSkin skin, in EditBoxStyle editStyle)const{
        Array<Name, 4> names;
        names[0u] = editStyle.normal;
        names[1u] = editStyle.hover;
        names[2u] = editStyle.focused;
        names[3u] = editStyle.disabled;
        Name fallback = editStyle.fallback;
        if(skin.hasRegion(editStyle.normal))
            fallback = editStyle.normal;
        return this.skinRegionsMaxPadding(skin, editStyle.padding, names, fallback);
    }

    public Expected<ComboResolvedMetrics> comboMetrics(
        in UiSkin skin,
        in ComboStyle style
    )const{
        Point minimumSize;
        Insets padding = style.padding;
        Array<Name, 5> names;
        names[0u] = style.normal;
        names[1u] = style.hover;
        names[2u] = style.open;
        names[3u] = style.focused;
        names[4u] = style.disabled;
        for(in Name name : names){
            const Optional<in UiSkinRegion> skinRegion = TryResolveSelectableStateRegion(skin, name, style.fallback);
            if(!skinRegion.has_value())
                return MakeUnexpected(Failure());
            const VectorSingle minimum = Max(VectorSingle(minimumSize.x, minimumSize.y, minimumSize.x, minimumSize.y), VectorSingle(skinRegion.value().minimumWidth, skinRegion.value().minimumHeight, skinRegion.value().minimumWidth, skinRegion.value().minimumHeight));
            minimumSize = Point(minimum.x, minimum.y);
            padding = MaxUiPadding(padding, skinRegion.value().padding);
        }
        const Optional<in UiSkinRegion> arrow = TryResolveSelectableStateRegion(skin, style.arrow, style.arrowFallback);
        if(!arrow.has_value())
            return MakeUnexpected(Failure());
        ComboResolvedMetrics result = ComboResolvedMetrics();
        result.minimumSize = minimumSize;
        result.padding = padding;
        result.arrowExtent = ResolveUiSkinSquareExtent(style.arrowExtent, arrow.value());
        return result;
    }

    private b8 accumulateRadioIndicator(
        in UiSkin skin,
        in Name regionName,
        in f32 referenceDensity,
        mut f32 inOutIndicatorExtent
    )const{
        const Expected<UiSkinRegion> skinRegion = skin.tryFindRegion(regionName);
        if(!skinRegion.has_value())
            return true;
        const Expected<Point> minimum = TryResolveSkinRegionMinimumSize(skinRegion.value(), referenceDensity);
        if(!minimum.has_value())
            return false;
        inOutIndicatorExtent = UiSimdMax(inOutIndicatorExtent, UiSimdMax(minimum.value().x, minimum.value().y));
        return true;
    }

    public Expected<RadioGroupMetrics> radioGroupMetrics(
        in UiSkin skin,
        in u32 choiceCount,
        in Point maximumLabel,
        in RadioGroupOptions options,
        mut RadioGroupStyle inOutStyle
    )const{
        const Optional<in UiSkinRegion> normal = TryResolveSelectableStateRegion(skin, inOutStyle.normal, inOutStyle.fallback);
        const Optional<in UiSkinRegion> checked = TryResolveSelectableStateRegion(skin, inOutStyle.checked, inOutStyle.checkedFallback);
        const Optional<in UiSkinRegion> mark = TryResolveSelectableStateRegion(skin, inOutStyle.mark, inOutStyle.markFallback);
        const f32 referenceDensity = skin.referenceDensity();
        if(!normal.has_value() || !checked.has_value() || !mark.has_value() || !IsFinite(VectorSingle(referenceDensity)) || referenceDensity <= 0.0f)
            return MakeUnexpected(Failure());
        const Expected<Point> normalMinimum = TryResolveSkinRegionMinimumSize(normal.value(), referenceDensity);
        const Expected<Point> checkedMinimum = TryResolveSkinRegionMinimumSize(checked.value(), referenceDensity);
        if(!normalMinimum.has_value() || !checkedMinimum.has_value())
            return MakeUnexpected(Failure());
        f32 indicatorExtent = inOutStyle.indicatorExtent;
        indicatorExtent = UiSimdMax(indicatorExtent, UiSimdMax(normalMinimum.value().x, normalMinimum.value().y));
        indicatorExtent = UiSimdMax(indicatorExtent, UiSimdMax(checkedMinimum.value().x, checkedMinimum.value().y));
        if(
            !this.accumulateRadioIndicator(skin, inOutStyle.hover, referenceDensity, indicatorExtent)
            || !this.accumulateRadioIndicator(skin, inOutStyle.pressed, referenceDensity, indicatorExtent)
            || !this.accumulateRadioIndicator(skin, inOutStyle.disabled, referenceDensity, indicatorExtent)
        )
            return MakeUnexpected(Failure());
        inOutStyle.indicatorExtent = indicatorExtent;
        const Expected<RadioGroupMetrics> metrics = MeasureRadioGroup(choiceCount, maximumLabel, options, inOutStyle);
        if(!metrics.has_value())
            return MakeUnexpected(Failure());
        return metrics.value();
    }

    private b8 accumulateSliderThumb(
        in UiSkin skin,
        in Name regionName,
        in f32 referenceDensity,
        mut Point inOutThumbExtent
    )const{
        const Expected<UiSkinRegion> thumb = skin.tryFindRegion(regionName);
        if(!thumb.has_value())
            return true;
        const Expected<Point> minimum = TryResolveSkinRegionMinimumSize(thumb.value(), referenceDensity);
        if(!minimum.has_value())
            return false;
        const VectorSingle extent = Max(VectorSingle(inOutThumbExtent.x, inOutThumbExtent.y, inOutThumbExtent.x, inOutThumbExtent.y), VectorSingle(minimum.value().x, minimum.value().y, minimum.value().x, minimum.value().y));
        inOutThumbExtent = Point(extent.x, extent.y);
        return true;
    }

    public Expected<SliderMetrics> sliderMetrics(
        in UiSkin skin,
        in SliderOptions options,
        mut SliderStyle inOutStyle
    )const{
        const f32 referenceDensity = skin.referenceDensity();
        if(!IsFinite(VectorSingle(referenceDensity)) || referenceDensity <= 0.0f)
            return MakeUnexpected(Failure());
        const Optional<in UiSkinRegion> track = TryResolveSelectableStateRegion(skin, inOutStyle.track, inOutStyle.trackFallback);
        const Optional<in UiSkinRegion> normal = TryResolveSelectableStateRegion(skin, inOutStyle.normal, inOutStyle.thumbFallback);
        if(!track.has_value() || !normal.has_value())
            return MakeUnexpected(Failure());
        const Expected<Point> trackMinimum = TryResolveSkinRegionMinimumSize(track.value(), referenceDensity);
        const Expected<Point> normalMinimum = TryResolveSkinRegionMinimumSize(normal.value(), referenceDensity);
        if(!trackMinimum.has_value() || !normalMinimum.has_value())
            return MakeUnexpected(Failure());
        if(options.orientation == SliderOrientation::Vertical)
            inOutStyle.trackHeight = UiSimdMax(inOutStyle.trackHeight, trackMinimum.value().x);
        else
            inOutStyle.trackHeight = UiSimdMax(inOutStyle.trackHeight, trackMinimum.value().y);
        const VectorSingle extent = Max(VectorSingle(inOutStyle.thumbExtent.x, inOutStyle.thumbExtent.y, inOutStyle.thumbExtent.x, inOutStyle.thumbExtent.y), VectorSingle(normalMinimum.value().x, normalMinimum.value().y, normalMinimum.value().x, normalMinimum.value().y));
        Point thumbExtent = Point(extent.x, extent.y);
        if(
            !this.accumulateSliderThumb(skin, inOutStyle.hover, referenceDensity, thumbExtent)
            || !this.accumulateSliderThumb(skin, inOutStyle.pressed, referenceDensity, thumbExtent)
            || !this.accumulateSliderThumb(skin, inOutStyle.disabled, referenceDensity, thumbExtent)
        )
            return MakeUnexpected(Failure());
        inOutStyle.thumbExtent = thumbExtent;
        const Expected<SliderMetrics> metrics = MeasureSlider(options, inOutStyle);
        if(!metrics.has_value())
            return MakeUnexpected(Failure());
        SliderMetrics resolvedMetrics = metrics.value();
        if(options.orientation == SliderOrientation::Vertical){
            const Expected<f32> contentHeight = TryResolveSliderTrackContentHeight(resolvedMetrics, trackMinimum.value().y);
            if(!contentHeight.has_value())
                return MakeUnexpected(Failure());
            resolvedMetrics.contentSize.y = contentHeight.value();
        }
        else{
            const Expected<f32> contentWidth = TryResolveSliderTrackContentWidth(resolvedMetrics, trackMinimum.value().x);
            if(!contentWidth.has_value())
                return MakeUnexpected(Failure());
            resolvedMetrics.contentSize.x = contentWidth.value();
        }
        return resolvedMetrics;
    }

    public Expected<ProgressMetrics> progressMetrics(
        in UiSkin skin,
        in f64 fraction,
        in ProgressOptions options,
        mut ProgressStyle inOutStyle
    )const{
        if(!IsFinite(VectorDouble(fraction)))
            return MakeUnexpected(Failure());
        const Optional<in UiSkinRegion> track = TryResolveSelectableStateRegion(skin, inOutStyle.track, inOutStyle.trackFallback);
        const Optional<in UiSkinRegion> fill = TryResolveSelectableStateRegion(skin, inOutStyle.fill, inOutStyle.fillFallback);
        if(!track.has_value() || !fill.has_value())
            return MakeUnexpected(Failure());
        const Expected<ProgressMetrics> metrics = MeasureProgress(options, inOutStyle, track.value(), fill.value(), skin.referenceDensity());
        if(!metrics.has_value())
            return MakeUnexpected(Failure());
        inOutStyle.track = track.value().name;
        inOutStyle.fill = fill.value().name;
        return metrics.value();
    }

    public Expected<ImageResolvedMetrics> imageMetrics(
        in UiSkin skin,
        in Name regionName,
        in ImageOptions options
    )const{
        const Expected<UiSkinRegion> skinRegion = skin.tryFindRegion(regionName);
        if(!skinRegion.has_value())
            return MakeUnexpected(Failure());
        const Expected<ImageMetrics> metrics = MeasureImage(options, skinRegion.value(), skin.referenceDensity());
        if(!metrics.has_value())
            return MakeUnexpected(Failure());
        ImageResolvedMetrics result = ImageResolvedMetrics();
        result.metrics = metrics.value();
        result.region = skinRegion.value().name;
        return result;
    }

    public Expected<WindowMetrics> windowMetrics(
        in UiSkin skin,
        in WidgetStyle style,
        in WindowOptions options,
        in Point titleExtent
    )const{
        const Expected<UiSkinRegion> frame = skin.tryFindRegion(style.window);
        if(!frame.has_value())
            return MakeUnexpected(Failure());
        const Expected<UiSkinRegion> header = skin.tryFindRegion(style.windowTitle);
        if(!header.has_value())
            return MakeUnexpected(Failure());
        const Expected<UiSkinRegion> collapseResult = skin.tryFindRegion(style.windowCollapse);
        if(options.collapsible && !collapseResult.has_value())
            return MakeUnexpected(Failure());
        UiSkinRegion collapse;
        if(collapseResult.has_value())
            collapse = collapseResult.value();
        const Expected<UiSkinRegion> closeResult = skin.tryFindRegion(style.windowClose);
        if(options.closable && !closeResult.has_value() && !skin.hasRegion(style.white))
            return MakeUnexpected(Failure());
        UiSkinRegion close;
        if(closeResult.has_value())
            close = closeResult.value();
        const Expected<UiSkinRegion> resizeResult = skin.tryFindRegion(style.windowResize);
        if(options.resizable && !resizeResult.has_value() && !skin.hasRegion(style.white))
            return MakeUnexpected(Failure());
        UiSkinRegion resize;
        if(resizeResult.has_value())
            resize = resizeResult.value();
        const Expected<WindowMetrics> metrics = MeasureWindow(frame.value(), header.value(), collapse, close, resize, style, options, titleExtent, skin.referenceDensity());
        if(!metrics.has_value())
            return MakeUnexpected(Failure());
        return metrics.value();
    }

    public b8 collapsibleHeaderMetrics(
        in UiSkin skin,
        in WidgetStyle style,
        mut Point outMinimum,
        mut Insets outPadding,
        mut f32 outIndicatorExtent
    )const{
        if(!IsFinite(VectorSingle(style.headerIndicatorExtent, style.gap, 0.0f, 0.0f)) || style.headerIndicatorExtent <= 0.0f || style.gap < 0.0f)
            return false;
        Optional<in UiSkinRegion> base = TryResolveSelectableStateRegion(skin, style.header, style.windowTitle);
        if(!base.has_value())
            base = TryResolveSelectableStateRegion(skin, style.button, style.button);
        if(!base.has_value())
            return false;
        Array<Name, 4u> names;
        names[0u] = style.header;
        names[1u] = style.headerHover;
        names[2u] = style.headerPressed;
        names[3u] = style.headerDisabled;
        for(in Name name : names){
            const Optional<in UiSkinRegion> found = TryResolveSelectableStateRegion(skin, name, base.value().name);
            if(found.has_value())
                AccumulateButtonRegionMetrics(found.value(), outMinimum, outPadding);
        }
        f32 indicatorExtent = style.headerIndicatorExtent;
        const Expected<UiSkinRegion> indicator = skin.tryFindRegion(style.headerIndicator);
        if(indicator.has_value())
            indicatorExtent = ResolveUiSkinSquareExtent(indicatorExtent, indicator.value());
        else{
            const Expected<UiSkinRegion> collapse = skin.tryFindRegion(style.windowCollapse);
            if(collapse.has_value())
                indicatorExtent = ResolveUiSkinSquareExtent(indicatorExtent, collapse.value());
        }
        if(!IsFinite(VectorSingle(indicatorExtent)) || indicatorExtent <= 0.0f)
            return false;
        outIndicatorExtent = indicatorExtent;
        return true;
    }

    public Expected<TabBarMetrics> tabBarMetrics(
        in UiSkin skin,
        in TabBarStyle style,
        in Span<TabBarItem> tabs,
        in Span<f32> labelWidths,
        in f32 maxLabelHeight,
        in TabBarOptions options
    )const{
        if(
            !IsValidTabBarOptions(options)
            || !IsValidTabBarStyle(style)
            || tabs.size() != labelWidths.size()
            || !IsFinite(VectorSingle(maxLabelHeight))
            || maxLabelHeight < 0.0f
        )
            return MakeUnexpected(Failure());
        const Optional<in UiSkinRegion> base = TryResolveSelectableStateRegion(skin, style.normal, style.fallback);
        if(!base.has_value())
            return MakeUnexpected(Failure());
        const Optional<in UiSkinRegion> trackRegion = TryResolveSelectableStateRegion(skin, style.track, style.trackFallback);
        if(!trackRegion.has_value())
            return MakeUnexpected(Failure());
        Point tabMinimum;
        Insets padding = style.tabPadding;
        Array<Name, 5u> names;
        names[0u] = style.normal;
        names[1u] = style.hover;
        names[2u] = style.active;
        names[3u] = style.pressed;
        names[4u] = style.disabled;
        for(in Name name : names){
            const Optional<in UiSkinRegion> found = TryResolveSelectableStateRegion(skin, name, base.value().name);
            if(found.has_value())
                AccumulateButtonRegionMetrics(found.value(), tabMinimum, padding);
        }
        TabBarMetrics metrics;
        metrics.padding = padding;
        metrics.tabMinimum = tabMinimum;
        metrics.trackThickness = trackRegion.value().minimumHeight;
        const f64 padX = cast<f64>(padding.left) + cast<f64>(padding.right);
        const f64 padY = cast<f64>(padding.top) + cast<f64>(padding.bottom);
        f64 closeBoxH = 0.0;
        f64 totalWidth = 0.0;
        for(usize index = 0u; index < tabs.size(); ++index){
            f64 closeWidth = 0.0;
            if(tabs[index].closable && style.closeExtent > 0.0f){
                closeWidth = cast<f64>(style.closeGap) + cast<f64>(style.closeExtent);
                closeBoxH = UiSimdMaxF64(closeBoxH, cast<f64>(style.closeExtent));
            }
            const f64 natural = padX + cast<f64>(labelWidths[index]) + closeWidth;
            const f64 minTab = UiSimdMaxF64(cast<f64>(tabMinimum.x), cast<f64>(style.minimumTabWidth));
            totalWidth += UiSimdMaxF64(natural, minTab);
            if(index > 0u)
                totalWidth += cast<f64>(style.tabGap);
        }
        const f64 contentMinH = UiSimdMaxF64(cast<f64>(maxLabelHeight), closeBoxH) + padY;
        const f64 height = UiSimdMaxF64(cast<f64>(tabMinimum.y), UiSimdMaxF64(contentMinH, cast<f64>(style.activeIndicatorHeight)));
        if(totalWidth > s_UiMaxFloatF64 || height > s_UiMaxFloatF64)
            return MakeUnexpected(Failure());
        metrics.contentSize = Point(cast<f32>(totalWidth), cast<f32>(height));
        return metrics;
    }
};


