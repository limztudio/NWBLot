[cpp_header("<core/assets/cook_dependency_registry.h>"), cpp_name("::NWB::Core::Assets::CookDependencyItemContext")]
extern class CookDependencyItemContext{
    Path assetRoot;
    StringView virtualRoot;
    Path nwbFilePath;
    Name assetType;
    Name virtualPath;
    MetascriptValue asset;
    b8 visitDocument(in Func<64u, b8(in MetascriptDocument)> visitor)const;
};

[cpp_header("<core/assets/cook_dependency_registry.h>"), cpp_name("::NWB::Core::Assets::CookDependencyRegistry")]
extern class CookDependencyRegistry{
    b8 registerType(...);
    b8 registerDefaultEntryAsset(...);
    b8 matchesAssetType(...)const;
    mut DefaultCookEntryAssetDescriptor defaultEntryAsset(...)const;
    b8 extractDependencies(...)const;
};

[cpp_header("<core/assets/cook_dependency_registry.h>"), cpp_name("::NWB::Core::Assets::DefaultCookEntryAssetDescriptor"), cpp_flags(borrow_view)]
extern class DefaultCookEntryAssetDescriptor{
    Name virtualPath;
    Name assetType;
    StringView virtualPathText;
};

[cpp_header("<core/assets/cook_dependency_registry.h>"), cpp_name("::NWB::Core::Assets::ICookDependencyCollector")]
extern class ICookDependencyCollector{
    b8 addAssetDependency(...);
};


