    self.m_router.invalidateTarget(self.m_targets[0u].id);
    EXPECT_TRUE(self.m_router.targets().empty());
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_FALSE(self.m_router.consumePointerGesture(self.m_targets[2u].id, 7u).has_value());
    EXPECT_TRUE(self.send(MakeUiControlInputPointer(InputEventType::PrimaryUp, MakeUiControlCaretPoint(95.0f, 25.0f))).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyUp, CoreKey::Down)).commandConsumed);
}

void VerifyUiControlInputTests_ThumbGestureRetainsAcceptedTrackAndMaximumAcrossResize(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.send(MakeUiControlInputPointer(InputEventType::PrimaryDown, MakeUiControlCaretPoint(95.0f, 25.0f))).pointerConsumed);
    const Expected<PointerGesture> gestureResult1 = self.m_router.consumePointerGesture(self.m_targets[2u].id, 7u);
    ASSERT_TRUE(gestureResult1.has_value());
    PointerGesture gesture = gestureResult1.value();
    EXPECT_EQ(gesture.control, self.m_targets[0u].control);
    EXPECT_DOUBLE_EQ(gesture.maximum, 2399900.0);
    EXPECT_FLOAT_EQ(gesture.referenceRectangle.height, 100.0f);
    self.m_targets[2u].gestureMaximum = 1000.0;
    self.m_targets[2u].gestureReference.height = 150.0f;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    EXPECT_TRUE(self.send(MakeUiControlInputPointer(InputEventType::PointerMove, MakeUiControlCaretPoint(95.0f, 50.0f))).pointerConsumed);
    const Expected<PointerGesture> gestureResult2 = self.m_router.consumePointerGesture(self.m_targets[2u].id, 7u);
    ASSERT_TRUE(gestureResult2.has_value());
    gesture = gestureResult2.value();
    EXPECT_DOUBLE_EQ(gesture.maximum, 2399900.0);
    EXPECT_FLOAT_EQ(gesture.referenceRectangle.height, 100.0f);
    EXPECT_EQ(gesture.id.layoutGeneration, 1u);
}

void VerifyUiControlInputTests_ChangedThumbEpochRejectsAQueuedCompletedGesture(mut UiControlInputTests self){
