void VerifyUiTextAreaNavigationTests_InvalidViewportValuesPreserveTheBorrowedModelAndState(mut UiTextAreaNavigationTests self){
    ASSERT_TRUE(self.m_model.setText("MM\nMM"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 1u));
    const u64 selection = self.m_model.selectionGeneration();
    const u64 stateRevision = self.m_state.revision();
    Array<f32, 4u> heights;
    heights[0u] = -1.0f;
    heights[1u] = bit_cast<f32>(s_UiTextAreaPosInfF32Bits);
    heights[2u] = bit_cast<f32>(s_UiTextAreaNegInfF32Bits);
    heights[3u] = bit_cast<f32>(s_UiTextAreaQuietNaNF32Bits);
    for(in f32 height : heights){
        EXPECT_FALSE(self.resolve(EditNavigationDirection::Down, height).has_value());
        EXPECT_FALSE(self.resolve(EditNavigationDirection::PageUp, height).has_value());
    }
    EXPECT_EQ(self.m_model.selectionGeneration(), selection);
    EXPECT_EQ(self.m_model.caret(), 1u);
    EXPECT_EQ(self.m_state.revision(), stateRevision);
    EXPECT_FALSE(self.m_state.navigation().hasPreferredX());
}

void VerifyUiTextAreaNavigationTests_InvalidDirectionAndFontParametersFailClosed(mut UiTextAreaNavigationTests self){
    ASSERT_TRUE(self.m_model.setText("MM\nMM"));
    EXPECT_FALSE(self.resolve(cast<EditNavigationDirectionEnum>(255u), 160.0f).has_value());
    Array<f32, 4u> sizes;
    sizes[0u] = 0.0f;
    sizes[1u] = -1.0f;
    sizes[2u] = bit_cast<f32>(s_UiTextAreaPosInfF32Bits);
    sizes[3u] = bit_cast<f32>(s_UiTextAreaQuietNaNF32Bits);
    for(in f32 size : sizes){
        TextAreaNavigationResolver resolver = TextAreaNavigationResolver(self.m_arena, self.m_text, self.m_context, self.m_state, size);
        EXPECT_FALSE(resolver.resolve(self.m_model, EditNavigationDirection::Down, self.m_state.navigation().snapshot(), 0.0f).has_value());
    }
}

void VerifyUiTextAreaNavigationTests_ForeignAndModifiedNavigationSnapshotsAreRejected(mut UiTextAreaNavigationTests self){
    ASSERT_TRUE(self.m_model.setText("MM\nMM"));
    TextAreaNavigationResolver resolver = TextAreaNavigationResolver(self.m_arena, self.m_text, self.m_context, self.m_state, 14.0f);
    TextAreaState foreign = TextAreaState();
    EXPECT_FALSE(resolver.resolve(self.m_model, EditNavigationDirection::Down, foreign.navigation().snapshot(), 0.0f).has_value());
    EditNavigationSnapshot copied = self.m_state.navigation().snapshot();
    copied.preferredX = 10.0f;
    EXPECT_FALSE(resolver.resolve(self.m_model, EditNavigationDirection::Down, copied, 0.0f).has_value());
    copied = self.m_state.navigation().snapshot();
    copied.valid = true;
    EXPECT_FALSE(resolver.resolve(self.m_model, EditNavigationDirection::Down, copied, 0.0f).has_value());
    copied = self.m_state.navigation().snapshot();
    copied.preferredX = bit_cast<f32>(s_UiTextAreaQuietNaNF32Bits);
    EXPECT_FALSE(resolver.resolve(self.m_model, EditNavigationDirection::Down, copied, 0.0f).has_value());
}

void VerifyUiTextAreaNavigationTests_ActivePreeditIsPreservedAndNotResolved(mut UiTextAreaNavigationTests self){
    ASSERT_TRUE(self.m_model.setText("MM\nMM"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 1u));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("pre\nedit", 3u, 8u));
    const u64 generation = self.m_model.compositionGeneration();
    EXPECT_FALSE(self.resolve(EditNavigationDirection::Down, 160.0f).has_value());
    EXPECT_FALSE(self.resolve(EditNavigationDirection::PageDown, 160.0f).has_value());
    const auto composition = self.m_model.composition();
    EXPECT_TRUE(composition.active);
    EXPECT_EQ(composition.text, "pre\nedit");
    EXPECT_EQ(composition.anchor, 3u);
    EXPECT_EQ(composition.caret, 8u);
    EXPECT_EQ(self.m_model.compositionGeneration(), generation);
    EXPECT_FALSE(self.m_state.navigation().hasPreferredX());
}

