namespace __hidden_allocator_owner_concurrency_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void WaitForFlag(const Atomic<b8>& flag)noexcept{
    AtomicBackOff backoff;
    while(!flag.load(MemoryOrder::acquire))
        backoff.pause();
}


