#include <impl/ecs_render/caustic/rt_caustics_internal.adhd>
#include <impl/ecs_render/kernel/descriptor_register_utils.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CausticEmissionTargetBuffer{
    public BufferHandle buffer = BufferHandle();
    public GpuDescriptorHandle heapHandle = GpuDescriptorHandle();
    public usize capacity = 0u;

    public b8 ensure(mut GraphicsRuntime graphics, in usize targetCount){
        if(this.buffer.valid() && this.capacity >= targetCount && this.heapHandle.valid()){
            assert(IsDescriptorClass(this.heapHandle, GpuDescriptorClass::StorageBuffer));
            return true;
        }
        return EnsureCausticEmissionTargetBufferStorage(graphics, targetCount, this.buffer, this.heapHandle, this.capacity);
    }

    public void releaseDescriptor(mut GraphicsRuntime graphics){
        if(!this.heapHandle.valid())
            return;
        mut GpuDescriptorHeap heap = graphics.getDevice().getDescriptorHeap();
        RetireDescriptor(heap, this.heapHandle);
    }

    public void reset(){
        this.buffer.reset();
        this.heapHandle = GpuDescriptorHandle();
        this.capacity = 0u;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

