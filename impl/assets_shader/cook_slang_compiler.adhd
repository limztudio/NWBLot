const Array<StringView, s_SpirvBaselineCapabilityCount> s_SpirvBaselineCapabilities(
    s_SpirvCapabilityNonSemanticInfo,
    s_SpirvCapabilityUserType,
    s_SpirvCapabilityDerivativeControl,
    s_SpirvCapabilityImageQuery,
    s_SpirvCapabilityImageGatherExtended,
    s_SpirvCapabilitySparseResidency,
    s_SpirvCapabilityMinLod,
    s_SpirvCapabilityFragmentFullyCovered
);

const Array<StringView, s_CommonCompilerArgumentCount> s_CommonCompilerArguments(
    s_SlangTargetArgument, s_SlangTargetSpirv,
    s_SlangEmitSpirvDirectlyArgument,
    s_SlangUseEntryPointNameArgument,
    s_SlangWarningsAsErrorsArgument, s_SlangWarningsAsErrorsAll,
    s_SlangProfileArgument, s_Spirv15TargetProfileText
);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SlangArguments{
    public Vector<StringView> views;
    private Vector<String> m_owned;

    public void reserve(in usize count, in usize ownedCount){
        this.views.reserve(count);
        this.m_owned.reserve(ownedCount);
    }
    public b8 appendOwned(in Expected<String> argument){
        if(!argument.has_value())
            return false;
        AppendArenaElement<String>(this.m_owned);
        mut String text = this.m_owned[this.m_owned.size() - 1u];
        text.assign(StringView(argument.value()));
        this.views.push_back(StringView(text));
        return true;
    }
    public ~SlangArguments(){
        while(!this.m_owned.empty())
            this.m_owned.pop_back();
    }
}


