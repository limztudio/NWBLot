type UiTextAreaBuilderTests = TextAreaFixture;
type UiTextAreaLoanTests = TextAreaLoanFixture;
type UiTextAreaReentryTests = TextAreaLoanFixture;

class UiTextAreaOrdinaryHost : IEditBoxHost{
    public usize ordinaryLoans = 0u;
    public usize publishes = 0u;

    public EditBoxResult edit(in WidgetState arg0, in EditBoxOptions arg1, mut EditModel arg2)override{
        ++this.ordinaryLoans;
        EditBoxResult result;
        result.valid = true;
        return result;
    }
    public EditBoxResult editInPopup(in WidgetState arg0, in EditBoxOptions arg1, in PopupToken arg2, mut EditModel arg3)override{ return EditBoxResult(); }
    public EditBoxResult editActions(in WidgetState arg0, in EditBoxOptions arg1, in PopupToken arg2, mut EditModel arg3, mut IEditActionSink arg4)override{ return EditBoxResult(); }
    public EditBoxResult editNavigated(in WidgetState arg0, in EditBoxOptions arg1, in PopupToken arg2, mut EditModel arg3, mut EditNavigationState arg4, mut IEditNavigationResolver arg5, mut IEditActionSink arg6)override{ return EditBoxResult(); }
    public b8 publish(in WidgetState arg0, in EditBoxView arg1, in EditBoxPlacement arg2, in EditBoxOptions arg3)override{
        ++this.publishes;
        return true;
    }
}


class UiTextAreaInputScrollTests : TextAreaFixture{
    public String m_document;

    public UiTextAreaInputScrollTests(){
        this.m_document.reserve(24u * 65u);
        for(usize row = 0u; row < 24u; ++row){
            if(row != 0u)
                this.m_document.push_back('\n');
            this.m_document.append(64u, 'a');
        }
    }
    public StringView documentView()const{
        return StringView(this.m_document);
    }
    public b8 prepareDocument(){ return this.prepareDocument(Point()); }
    public b8 prepareDocument(in Point scroll){
        return PrepareUiTextAreaScrollDocument(this, scroll);
    }
    public b8 prepareScroll(){ return this.prepareScroll(MakeUiTextAreaScrollOptions()); }
    public b8 prepareScroll(in TextAreaOptions options){ return this.prepareScroll(options, Point()); }
    public b8 prepareScroll(in TextAreaOptions options, in Point scroll){
        return PrepareUiTextAreaScroll(this, options, scroll);
    }
    public b8 wheel(in f64 x, in f64 y, in Point position){
        return SendUiTextAreaWheelAt(this, x, y, position);
    }
    public b8 wheel(in f64 x, in f64 y){
        return SendUiTextAreaWheel(this, x, y);
    }
    public WidgetId part(in StringView key)const{
        return GetUiTextAreaInputPart(this, key);
    }
    public b8 framePopup(in u64 generation, mut PopupState popup){
        return FrameUiTextAreaPopup(this, generation, popup);
    }
}


class UiTextAreaMutationSource : ComboSource{
    public TestObserved<UiFixtureHook> rowHook;
    public TestObserved<UiFixtureHook> metadataHook;
    public TestObserved<UiFixtureHook> metadataToArm;
    public TestObserved<Optional<mut UiTextAreaMutationSource>> armMetadataSource;
    public TestObserved<usize> metadataCalls;
    public TestObserved<usize> metadataMutations;
    public TestObserved<usize> rowMutations;
    public TestObserved<usize> arms;

    public UiTextAreaMutationSource(){ this.generation = 4301u; this.count = 5u; }
    public UiTextAreaMutationSource(in u64 instance){ this.generation = instance; this.count = 5u; }
    public u64 instanceGeneration()const override{ ++this.metadataCalls.value(); return this.generation; }
    public u64 revision()const override{
        ++this.metadataCalls.value();
        if(this.metadataHook.value()){
            UiFixtureHook hook = this.metadataHook.value();
            this.metadataHook.value() = UiFixtureHook();
            ++this.metadataMutations.value();
            hook();
        }
        return this.contentRevision;
    }
    public u64 rowCount()const override{ ++this.metadataCalls.value(); return this.count; }
    public StringView text(in u64 index)const override{
        const StringView value = this.baseText(index);
        if(this.rowHook.value()){
            UiFixtureHook hook = this.rowHook.value();
            this.rowHook.value() = UiFixtureHook();
            ++this.rowMutations.value();
            hook();
        }
        if(this.armMetadataSource.value().has_value()){
            mut UiTextAreaMutationSource source = this.armMetadataSource.value().value();
            this.armMetadataSource.value().reset();
            source.metadataHook.value() = this.metadataToArm.value();
            this.metadataToArm.value() = UiFixtureHook();
            ++this.arms.value();
        }
        return value;
    }
    public void resetAllCounters()const{ this.resetCounters(); this.metadataCalls.value() = 0u; }
    public void armParentMetadata(mut UiTextAreaMutationSource source){ this.armMetadataSource.value() = Optional<mut UiTextAreaMutationSource>(source); }
}


class UiTextAreaNavigationTests : WidgetFixture{
    public EditModel m_model = EditModel(EditLimits(), EditTextMode::Multiline);
    public TextAreaState m_state;
    public EditBoxView m_view;

    public b8 shapeCurrent(){
        ShapeRequest request;
        request.fontSize = 14.0f;
        return this.m_view.snapshot(this.m_model) && this.m_view.shape(this.m_text, request) == TextLayoutStatus::Success;
    }
    public Expected<EditNavigationResult> resolve(in EditNavigationDirection direction){ return this.resolve(direction, 0.0f); }
    public Expected<EditNavigationResult> resolve(in EditNavigationDirection direction, in f32 viewportHeight){
        TextAreaNavigationResolver resolver = TextAreaNavigationResolver(this.m_text, this.m_context, this.m_state, 14.0f);
        return resolver.resolve(this.m_model, direction, this.m_state.navigation().snapshot(), viewportHeight);
    }
}


class UiTextAreaReentrySource : ComboSource{
    public TestObserved<UiFixtureHook> rowHook;
    public TestObserved<usize> attempts;
    public TestObserved<usize> callbacksAfterAttempt;

    public UiTextAreaReentrySource(){ this.generation = 4401u; this.count = 5u; }
    public StringView text(in u64 index)const override{
        const StringView value = this.baseText(index);
        if(this.rowHook.value()){
            UiFixtureHook hook = this.rowHook.value();
            this.rowHook.value() = UiFixtureHook();
            ++this.attempts.value();
            hook();
        }
        return value;
    }
    public void observeCallback()const override{
        if(this.attempts.value() != 0u)
            ++this.callbacksAfterAttempt.value();
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


TextAreaOptions MakeUiTextAreaScrollOptions(){
    TextAreaOptions options = TextAreaOptions();
    options.width.policy = LayoutSizePolicy::Fixed;
    options.width.value = 180.0f;
    options.height.policy = LayoutSizePolicy::Fixed;
    options.height.value = 96.0f;
    return options;
}

b8 PrepareUiTextAreaScrollDocument(mut UiTextAreaInputScrollTests self, in Point scroll){
    return self.m_model.setText(self.documentView())
        && self.m_model.setSelection(1u, 1u)
        && self.m_model.replaceSelection("b")
        && self.m_model.setSelection(0u, 0u)
        && self.m_state.scrollTo(scroll);
}

b8 PrepareUiTextAreaScroll(mut UiTextAreaInputScrollTests self, in TextAreaOptions options, in Point scroll){
    return PrepareUiTextAreaScrollDocument(self, scroll) && self.frameArea(1u, options);
}

b8 SendUiTextAreaWheelAt(mut UiTextAreaInputScrollTests self, in f64 x, in f64 y, in Point position){
    InputEvent event = InputEvent();
    event.type = InputEventType::PointerWheel;
    event.position = position;
    event.scrollX = x;
    event.scrollY = y;
    return self.send(event).pointerConsumed;
}

b8 SendUiTextAreaWheel(mut UiTextAreaInputScrollTests self, in f64 x, in f64 y){
    return SendUiTextAreaWheelAt(self, x, y, CenterUiRect(self.m_state.placement().content));
}

WidgetId GetUiTextAreaInputPart(in UiTextAreaInputScrollTests self, in StringView key){
    return RequireUiWidgetId(self.id(s_UiTextAreaWidgetKey, s_UiTextAreaPanelKey), key);
}

b8 FrameUiTextAreaPopup(mut UiTextAreaInputScrollTests self, in u64 generation, mut PopupState popup){
    PopupOptions options = PopupOptions();
    options.anchor.x = 20.0f;
    options.anchor.y = 20.0f;
    options.anchor.width = 40.0f;
    options.anchor.height = 20.0f;
    options.size.x = 300.0f;
    options.size.y = 180.0f;
    if(!self.begin(generation) || !self.m_builder.beginPopup("popup", popup, options))
        return false;
    self.m_result = self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, MakeUiTextAreaScrollOptions());
    return self.m_result.valid
        && self.m_builder.endPopup()
        && self.m_context.endRoot()
        && self.m_context.finishFrame()
        && self.m_context.commitFrame(generation);
}

const u32 s_UiTextAreaQuietNaNF32Bits = 0x7fc00000u;
const u32 s_UiTextAreaPosInfF32Bits = 0x7f800000u;
const u32 s_UiTextAreaNegInfF32Bits = 0xff800000u;
const AStringView s_UiTextAreaPanelKey = "panel";
const AStringView s_UiTextAreaWidgetKey = "area";
const AStringView s_UiTextAreaPopupKey = "popup";
const AStringView s_UiTextAreaChildPopupKey = "child";
const AStringView s_UiTextAreaVerticalThumbPart = "scroll.y.thumb";
const AStringView s_UiTextAreaKoreanLanguage = "ko";
const AStringView s_UiTextAreaReenteredKey = "reentered";


ShapeRequest MakeUiTextAreaFontSizeShapeRequest(in f32 fontSize){
    ShapeRequest request = ShapeRequest();
    request.fontSize = fontSize;
    return request;
}


