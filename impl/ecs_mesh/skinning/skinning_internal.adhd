////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void RetainSkinningBuffer(in BufferHandle buffer, mut Vector<BufferHandle> buffers, mut HashSet<BufferHandle> index){
    if(!buffer.valid())
        return;
    if(index.empty()){
        for(in BufferHandle existing : buffers){
            if(existing == buffer)
                return;
        }
        if(buffers.size() < s_SkinningLiveStateInlineBufferCount){
            buffers.push_back(buffer);
            return;
        }
        index.reserve(s_SkinningLiveStateInlineBufferCount * s_SkinningPromotedIndexCapacityFactor);
        for(in BufferHandle existing : buffers)
            index.insert(existing);
    }
    if(index.insert(buffer).second)
        buffers.push_back(buffer);
}

void CollectSkinningStateBuffers(in MeshSkinningRuntimeInstance instance, in Optional<in MeshSkinningRuntimeResources> resources, mut Vector<BufferHandle> buffers, mut HashSet<BufferHandle> index){
    if(!instance.valid())
        return;
    for(in BufferHandle buffer : CaptureMeshSkinningResourceBuffers(instance))
        RetainSkinningBuffer(buffer, buffers, index);
    if(resources.has_value() && resources.value().editRevision == instance.editRevision){
        RetainSkinningBuffer(resources.value().skinBuffer, buffers, index);
        RetainSkinningBuffer(resources.value().jointPaletteBuffer, buffers, index);
        RetainSkinningBuffer(resources.value().bindlessResourceSlotsBuffer, buffers, index);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SkinningPlansTask{
    private mut MeshSkinningSystem m_system;
    private mut GpuTimingSubmissionTicket m_ticket;
    private Span<MeshSkinningGraphDispatchPlan> m_plans;
    private b8 m_deform;

    public SkinningPlansTask(mut MeshSkinningSystem system, mut GpuTimingSubmissionTicket ticket, in Span<MeshSkinningGraphDispatchPlan> plans, in b8 deform){
        this.m_system = system;
        this.m_ticket = ticket;
        this.m_plans = plans;
        this.m_deform = deform;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    [cpp_unwind]
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const{
        if(this.m_plans.empty())
            return false;
        GpuTimingTicketRecordingScope recording(this.m_ticket);
        for(in MeshSkinningGraphDispatchPlan plan : this.m_plans){
            if(this.m_deform){
                if(!this.m_system.recordGraphOwnedSkinningDeformation(plan, context, commands))
                    return false;
            }
            else if(!this.m_system.recordGraphOwnedSkinningPostDispatch(plan, context, commands))
                return false;
        }
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateFinalizedSkinningPlanStates(
    in b8 hasActiveSkin,
    in b8 copiedRestStreams,
    in b8 skinnedStreamsReady,
    in b8 updatesMeshletBounds,
    in b8 boundsStreamsReady,
    in b8 repacksNormals,
    in b8 attributeStreamReady
){
    if((hasActiveSkin || copiedRestStreams) && !skinnedStreamsReady)
        return false;
    if(updatesMeshletBounds && !boundsStreamsReady)
        return false;
    if(repacksNormals && !attributeStreamReady)
        return false;
    return true;
}

b8 IsSkinningShaderResource(in GpuTaskRecordContext context, mut CommandList commands, in GpuGraphResourceId resource){
    const Optional<mut Buffer> buffer = context.declarations.borrowBuffer(resource);
    return buffer.has_value() && commands.getBufferState(buffer.value()) == ResourceStates::ShaderResource;
}

class SkinningFinalizerTask{
    private mut MeshSkinningSystem m_system;
    private Span<MeshSkinningGraphDispatchPlan> m_plans;

    public SkinningFinalizerTask(mut MeshSkinningSystem system, in Span<MeshSkinningGraphDispatchPlan> plans){
        this.m_system = system;
        this.m_plans = plans;
    }

    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements commands;
        commands.requiresPrimaryGraphicsQueue = true;
        return commands;
    }

    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const{
        if(this.m_plans.empty())
            return false;
        for(in MeshSkinningGraphDispatchPlan plan : this.m_plans){
            const b8 skinned = (!plan.hasActiveSkin && !plan.copiedRestStreams)
                || (IsSkinningShaderResource(context, commands, plan.skinnedPositionResource) && IsSkinningShaderResource(context, commands, plan.skinnedNormalResource)
                    && IsSkinningShaderResource(context, commands, plan.skinnedTangentResource));
            const b8 bounds = !plan.updatesMeshletBounds || (IsSkinningShaderResource(context, commands, plan.meshletBoundsResource) && IsSkinningShaderResource(context, commands, plan.localBoundsResource));
            const b8 attributes = !plan.repacksNormals || IsSkinningShaderResource(context, commands, plan.attributeResource);
            if(!ValidateFinalizedSkinningPlanStates(plan.hasActiveSkin, plan.copiedRestStreams, skinned, plan.updatesMeshletBounds, bounds, plan.repacksNormals, attributes))
                return false;
        }
        return true;
    }

    public void accepted(in QueueSubmissionToken token){
        if(token.valid()){
            for(in MeshSkinningGraphDispatchPlan plan : this.m_plans)
                this.m_system.confirmGraphOwnedSkinningDispatch(plan);
        }
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<Vector<u32>> TryBuildMeshSkinningTraceIndices(in MeshSkinningRuntimeInstance instance){
    const usize indexCount = instance.meshletPrimitiveIndices.size();
    const Expected<Vector<u32>> triangleIndices = BuildMeshletTriangleIndices(
        instance.meshlets,
        instance.meshletLocalVertexRefs,
        instance.meshletPositionRefDeltas,
        instance.meshletPrimitiveIndices,
        instance.restPositions.size()
    );
    if(!triangleIndices.has_value()){
        error("MeshSkinningRuntimeCache: failed to reconstruct ray tracing triangle indices for runtime mesh '{}'", instance.handle.value);
        return MakeUnexpected(Failure());
    }
    if(!ValidateReconstructedRuntimeTriangleIndexCount(triangleIndices.value().size(), indexCount, instance.handle.value))
        return MakeUnexpected(Failure());
    return triangleIndices.value();
}

Expected<Vector<AttribGpu>> TryBuildMeshSkinningTraceAttributes(in MeshSkinningRuntimeInstance instance){
    const Expected<Vector<AttribGpu>> triangleAttributes = BuildMeshletTriangleAttributes(
        instance.meshlets,
        instance.meshletLocalVertexRefs,
        instance.meshletAttributeRefDeltas,
        instance.meshletPrimitiveIndices,
        instance.restNormals,
        instance.uv0
    );
    if(!triangleAttributes.has_value()){
        error("MeshSkinningRuntimeCache: failed to reconstruct shadow trace triangle attributes for runtime mesh '{}'", instance.handle.value);
        return MakeUnexpected(Failure());
    }
    return triangleAttributes.value();
}

GpuTaskSchedulingHint MakeSkinningSerialMergeScheduling(in GpuTaskCostHint cost){
    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.cost = cost;
    scheduling.overlapPreferred = false;
    scheduling.avoidQueueCrossing = true;
    scheduling.forceSubmissionBoundary = false;
    scheduling.allowPacketMerge = true;
    scheduling.mergeWithPrevious = true;
    scheduling.frontierScoredMergeDomain = s_SerialMergeDomain;
    return scheduling;
}

GpuTaskSchedulingHint MakeJointPaletteUploadScheduling(){
    return MakeSkinningSerialMergeScheduling(GpuTaskCostHint::Tiny);
}

GpuTaskSchedulingHint MakeSkinningDispatchScheduling(){
    return MakeSkinningSerialMergeScheduling(GpuTaskCostHint::Small);
}


