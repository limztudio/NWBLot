#include <impl/ecs_render/raytrace/types.adhd>
#include <impl/ecs_render/shadow/quality_settings.adhd>
#include <impl/ecs_render/shared/frame_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{
namespace NWB::Impl{
using MutableSceneLightGpuDataSpan = Span<SceneLightGpuData>;
};
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_ShadowSlotUnassigned = -1.0f;
const f32 s_DirectionalShadowImportanceBoost = 4.0f;
const f32 s_ShadowImportanceDistanceSquaredEpsilon = 0.0001f;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


f32 ShadowSlotImportance(in VectorSingle colorIntensity, in VectorSingle params, in VectorSingle lightPosition, in VectorSingle cameraPosition){
    const f32 radiantImportance = SceneLightRadiantImportance(colorIntensity);
    if(params.y < s_LightTypeDirectionalMax)
        return radiantImportance * s_DirectionalShadowImportanceBoost + 1.0f;

    const VectorSingle delta = lightPosition - cameraPosition;
    const f32 distanceSquared = lengthSq(delta.xyz);
    const f32 range = max(params.x, 0.0f);
    const f32 rangeSquared = range * range;
    f32 coverageSquared = 1.0f;
    if(distanceSquared > s_ShadowImportanceDistanceSquaredEpsilon)
        coverageSquared = rangeSquared / distanceSquared;
    return radiantImportance * min(coverageSquared, 1.0f);
}

SceneLightGpuData BuildUnassignedSceneLightGpuData(
    in VectorSingle position,
    in VectorSingle direction,
    in VectorSingle colorIntensity,
    in f32 range,
    in f32 lightType,
    in f32 causticSlot,
    in f32 angularRadius,
    in f32 sourceRadius,
    in VectorSingle cameraPosition,
    mut f32 outCausticImportance,
    mut f32 outShadowImportance
){
    const SceneLightGpuData dst = MakeSceneLightGpuData(
        position,
        direction,
        colorIntensity,
        range,
        lightType,
        s_ShadowSlotUnassigned,
        causticSlot,
        angularRadius,
        sourceRadius
    );
    outCausticImportance = SceneLightRadiantImportance(colorIntensity);
    outShadowImportance = ShadowSlotImportance(colorIntensity, VectorSingle(dst.params), position, cameraPosition);
    return dst;
}

u32 SelectNextShadowSlotLightIndex(in Span<SceneLightGpuData> lights, in Span<f32> shadowImportance){
    const u32 lightCount = cast<u32>(lights.size());
    f32 bestImportance = -1.0f;
    u32 bestIndex = lightCount;
    for(u32 i = 0u; i < lightCount && i < cast<u32>(shadowImportance.size()); ++i){
        if(lights[i].params.z >= 0.0f)
            continue;
        const f32 importance = shadowImportance[i];
        if(importance > bestImportance){
            bestImportance = importance;
            bestIndex = i;
        }
    }
    return bestIndex;
}

void AssignShadowSlotLights(
    in Span<f32> shadowImportance,
    in u32 lightCount,
    mut MutableSceneLightGpuDataSpan outLights
){
    u32 slotCount = s_SceneShadowSlotCount;
    if(lightCount < slotCount)
        slotCount = lightCount;
    for(u32 slot = 0u; slot < slotCount; ++slot){
        f32 bestImportance = -1.0f;
        u32 bestIndex = lightCount;
        for(u32 i = 0u; i < lightCount && i < cast<u32>(shadowImportance.size()); ++i){
            const SceneLightGpuData light = outLights[cast<usize>(i)];
            if(light.params.z >= 0.0f)
                continue;
            const f32 importance = shadowImportance[cast<usize>(i)];
            if(importance > bestImportance){
                bestImportance = importance;
                bestIndex = i;
            }
        }
        if(bestIndex >= lightCount)
            break;
        outLights[cast<usize>(bestIndex)].params.z = cast<f32>(slot);
    }
}

u32 ResolveSoftShadowSlotMask(in Span<SceneLightGpuData> lights){
    u32 mask = 0u;
    for(usize i = 0u; i < lights.size(); ++i){
        const f32 slot = lights[i].params.z;
        if(slot >= 0.0f){
            const u32 slotIndex = cast<u32>(slot);
            if(slotIndex < s_SceneShadowSlotCount)
                mask |= (1u << slotIndex);
        }
    }
    return mask;
}

b8 CanCombineSoftShadowWavelets(in b8 combinedUpsample, in b8 pipelineReady, in b8 opaqueTemporalReady, in b8 transparentTemporalReady, in u32 opaquePassCount, in u32 transparentPassCount){
    return combinedUpsample && pipelineReady && opaqueTemporalReady && transparentTemporalReady && opaquePassCount == 1u && transparentPassCount == 1u;
}

u32 ResolveSoftShadowLightSlotRangeCount(in u32 softShadowSlotMask){
    return bitWidthLowU32(softShadowSlotMask, s_SceneShadowSlotCount);
}

b8 SoftShadowTemporalHistoryUsable(in b8 softShadowTemporalReady, in b8 prevWorldToClipValid, in b8 softShadowTemporalSeeded){
    return softShadowTemporalReady && prevWorldToClipValid && softShadowTemporalSeeded;
}

u64 ComputeShadowMaterialContextHash(
    in Span<NwbRtInstanceMaterialGpu> instanceMaterials,
    in Span<InstanceGpuData> instanceData,
    in Span<u8> materialTypedBytes
){
    assert(instanceMaterials.size() == instanceData.size());

    u64 hash = s_Fnv64OffsetBasis;
    hash = updateFnv64U32(hash, s_SceneStaticCacheHashVersion);
    for(in NwbRtInstanceMaterialGpu material : instanceMaterials){
        hash = updateFnv64U32(hash, material.surfaceDispatchId);
        hash = updateFnv64U32(hash, material.flags);
        hash = updateFnv64U32(hash, material.shadingModelId);
        hash = updateFnv64U32(hash, material.materialConstantByteOffset);
        hash = updateFnv64U32(hash, material.meshInstanceIndex);
        hash = updateFnv64U32(hash, material.indexSlot);
        hash = updateFnv64U32(hash, material.attributeSlot);
        hash = updateFnv64U32(hash, material.positionSlot);
        hash = updateFnv64U32(hash, material.nodeSlot);
    }
    for(in InstanceGpuData instance : instanceData){
        hash = updateFnv64U32(hash, bit_cast<u32>(instance.rotation.x));
        hash = updateFnv64U32(hash, bit_cast<u32>(instance.rotation.y));
        hash = updateFnv64U32(hash, bit_cast<u32>(instance.rotation.z));
        hash = updateFnv64U32(hash, bit_cast<u32>(instance.rotation.w));
        hash = updateFnv64U32(hash, bit_cast<u32>(instance.translation.x));
        hash = updateFnv64U32(hash, bit_cast<u32>(instance.translation.y));
        hash = updateFnv64U32(hash, bit_cast<u32>(instance.translation.z));
        hash = updateFnv64U32(hash, instance.translation.w);
        hash = updateFnv64U32(hash, bit_cast<u32>(instance.scale.x));
        hash = updateFnv64U32(hash, bit_cast<u32>(instance.scale.y));
        hash = updateFnv64U32(hash, bit_cast<u32>(instance.scale.z));
        hash = updateFnv64U32(hash, instance.scale.w);
        for(u32 slotIndex = 0u; slotIndex < s_MeshInstanceGeometrySlotCount; ++slotIndex)
            hash = updateFnv64U32(hash, instance.geometryHeapSlots[cast<usize>(slotIndex)]);
    }
    if(!materialTypedBytes.empty()){
        hash = updateFnv64U64(hash, cast<u64>(materialTypedBytes.size()));
        for(in u8 byte : materialTypedBytes)
            hash = updateFnv64Byte(hash, byte);
    }
    return hash;
}


