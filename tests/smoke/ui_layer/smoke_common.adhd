b8 SmokePopupMatchesParentGeneration(in InputRouter input, in PopupToken popup, in u64 parentGeneration){
    const auto scope = input.popupScope(popup);
    return scope.has_value() && scope.value().parent.instanceGeneration == parentGeneration;
}

b8 CreateSmokeTextAtlasPages(
    in Span<u8> coverageBytes, in Array<Array<u8, 192u>, 4u> sdfBytes,
    mut SharedGlyphPage outCoverage, mut Array<SharedSdfAtlasPage, 4u> outSdf
){
    SharedPool pages();
    GlyphPageBindingRecord<Font> coverage();
    coverage.font = AssetRef<Font>("tests/smoke/ui_layer/coverage_font");
    coverage.fontGeneration = 1u;
    coverage.atlasIdentity = 0x5549534D4F4B45u;
    coverage.generation = 1u;
    coverage.index = cast<u32>(s_GlyphAtlasMaxPages - 1u);
    coverage.width = 12u;
    coverage.height = 4u;
    const auto covered = CopyGlyphPage(pages, coverage, coverageBytes);
    if(covered.has_value())
        outCoverage = covered.value();

    b8 allSdfValid = true;
    for(u32 channels = 1u; channels <= 4u; ++channels){
        SdfAtlasPageBindingRecord<Font> sdf();
        sdf.font = coverage.font;
        sdf.fontGeneration = coverage.fontGeneration;
        sdf.atlasIdentity = coverage.atlasIdentity;
        sdf.generation = coverage.generation;
        sdf.index = channels - 1u;
        sdf.width = coverage.width;
        sdf.height = coverage.height;
        sdf.channelCount = channels;
        sdf.spreadPixels = 8u;
        const usize count = 48u * cast<usize>(channels);
        const auto page = CopySdfAtlasPage(pages, sdf, Span<u8>(sdfBytes[channels - 1u].data(), count));
        if(page.has_value())
            outSdf[channels - 1u] = page.value();
        if(!outSdf[channels - 1u].valid())
            allSdfValid = false;
    }
    return outCoverage.valid() && allSdfValid;
}

Expected<SharedImageSource> LoadSmokeSkinImageSource(in SharedPool pool, in AssetManager assets, in AssetRef<UiSkin> skinRef){
    if(!skinRef.valid())
        return MakeUnexpected(Failure());
    const auto skin = LoadTypedAssetSync<UiSkin>(assets, skinRef.name(), "UiTextureImageSmokeScene");
    if(!skin.has_value() || !skin.value().valid() || !skin.value().deref().texture().valid())
        return MakeUnexpected(Failure());
    return LoadImageSource(pool, assets, skin.value().deref().texture());
}

[arena]
class UiSmokeImageAssetLoader{
    private ActiveSceneSubsystems m_subsystems = ActiveSceneSubsystems();
    private SharedPool m_pool = SharedPool();

    public void load(in AssetManager assets, in Name alternate, mut SharedImageSource outDefault, mut SharedImageSource outAlternate){
        if(!this.m_subsystems.loadProjectStartScene(assets))
            return;
        const auto uiSubsystem = this.m_subsystems.findSubsystem<UiSubsystem>();
        if(uiSubsystem.has_value()){
            const auto basic = LoadSmokeSkinImageSource(this.m_pool, assets, uiSubsystem.value().basicSkin);
            if(basic.has_value())
                outDefault = basic.value();
        }
        const auto other = LoadSmokeSkinImageSource(this.m_pool, assets, this.m_subsystems.findSceneAsset<UiSkin>(alternate));
        if(other.has_value())
            outAlternate = other.value();
    }
}

SharedImageSource CloneSmokeImageSourcePayload(in SharedImageSource identity, in SharedImageSource source){
    if(!identity.valid() || !source.valid())
        return SharedImageSource();
    in Texture payload = source.deref().texture();
    Texture replacement(identity.deref().identity().name());
    replacement.setPayload(payload.width(), payload.height(), payload.mipLevels(), payload.payloadBytes(), payload.dimension(), payload.depth(), payload.payloadFormat(), payload.alphaMode(), payload.alphaConstantUnorm8());
    SharedPool pool();
    const auto result = MakeImageSource(pool, replacement);
    if(!result.has_value())
        return SharedImageSource();
    return result.value();
}


