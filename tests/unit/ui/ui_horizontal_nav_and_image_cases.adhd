void VerifyUiImageSourceTests_RejectedSamePathReplacementPreservesPreviouslyAcceptedOwnedVersion(mut UiImageSourceTests self){
    TestValueSlot<Texture> textureSlot;
    mut Texture texture = textureSlot.constructIn(self.m_inputArena, s_UiCaseTestsUiImageReplace);
    ASSERT_TRUE(self.prepareDefault(texture));
    const Expected<SharedImageSource> acceptedResult = MakeImageSource(self.m_pool, texture);
    ASSERT_TRUE(acceptedResult.has_value());
    const SharedImageSource accepted = acceptedResult.value();
    ASSERT_TRUE(accepted.valid());
    const u64 generation = ImageSourceGeneration(accepted);
    self.installTransportVariant(texture, 0u);
    EXPECT_FALSE(MakeImageSource(self.m_pool, texture).has_value());
    EXPECT_EQ(ImageSourceGeneration(accepted), generation);
    const AssetRef<Texture> acceptedIdentity = ImageSourceIdentity(accepted);
    EXPECT_EQ(acceptedIdentity.name(), texture.virtualPath());
    ASSERT_EQ(ImageSourceTexture(accepted).payloadBytes().size(), 144u);
    EXPECT_EQ(ImageSourceTexture(accepted).payloadBytes()[143u], cast<u8>(37u + 143u * 17u));
    UiImageSourceTextureDescription replacement = UiImageSourceTextureDescription();
    replacement.seed = 73u;
    ASSERT_TRUE(self.prepareCustom(texture, replacement));
    const Expected<SharedImageSource> nextResult = MakeImageSource(self.m_pool, texture);
    ASSERT_TRUE(nextResult.has_value());
    const SharedImageSource next = nextResult.value();
    ASSERT_TRUE(next.valid());
    EXPECT_NE(ImageSourceGeneration(next), generation);
    EXPECT_EQ(ImageSourceTexture(next).payloadBytes()[0u], 73u);
    EXPECT_EQ(ImageSourceTexture(accepted).payloadBytes()[0u], 37u);
}

