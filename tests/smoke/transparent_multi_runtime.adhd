[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace NWB::Tests::Smoke{
[[nodiscard]] NWB_INLINE AStringView TransparentMultiProjectName()noexcept{
    return "TransparentMultiSmokeProject";
}

[[nodiscard]] NWB_INLINE AStringView CausticSphereProjectName()noexcept{
    return "CausticSphereSmokeProject";
}

[[nodiscard]] NWB_INLINE AStringView TransparentMultiFpsLabel()noexcept{
#if defined(NWB_TRANSPARENT_MULTI_FRAME_LAGGED_ASYNC_LIGHTING_SMOKE)
    return "FrameLaggedAsyncLightingSmokeProject";
#elif defined(NWB_TRANSPARENT_MULTI_ENABLE_CSG)
    return "TransparentCsgSmokeProject";
#elif defined(NWB_TRANSPARENT_MULTI_CAUSTIC_SPHERE)
    return CausticSphereProjectName();
#else
    return TransparentMultiProjectName();
#endif
}

inline constexpr u32 s_CausticSphereTemporalPhaseCount = Impl::s_CausticTemporalPhaseCount;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_CausticSparsePreset = "sparse";
const StringView s_CausticPopulatedPreset = "populated";
const u32 s_CausticSphereDefaultCaptureFrameCount = 360u;
const u32 s_TransparentMultiQuietNaNBits = 0x7fc00000u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class FrameLaggedAsyncLightingToggleInputHandler : IInputEventHandler{
    public KeyboardInputResult keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods)override{
        if(key != Key::F1)
            return false;
        if(action == InputAction::Press)
            this.m_toggleRequested = true;
        return true;
    }

    public b8 consumeToggleRequest(){
        const b8 requested = this.m_toggleRequested;
        this.m_toggleRequested = false;
        return requested;
    }

    private b8 m_toggleRequested = false;
}

[arena]
class TransparentMultiSmokeProjectImpl : IProjectEntryCallbacks{
    public TransparentMultiSmokeProjectImpl(mut ProjectRuntimeContext context){
        this.m_context = context;
        this.m_world = CreateTransparentMultiWorldOrDie(context);
        this.m_timingRenderPass = AvboitTimingRenderPass(context.graphics);
        this.m_fpsProbe = FpsProbe(TransparentMultiFpsLabel());
        this.m_gpuPassTimingProbe = GpuPassTimingProbe(TransparentMultiFpsLabel());
        this.m_frameLaggedAsyncLightingUnfocusedPass = TimingProbeUnfocusedPass(context.graphics);
        this.m_rotationSpeed = ParseTransparentMultiRotationSpeed();
        this.m_frozenAngle = ParseTransparentMultiFrozenAngle();
    }

    public ~TransparentMultiSmokeProjectImpl(){
        this.m_timingRenderPass.stop();
        this.m_context.input.removeHandler(this.m_arrowYawInput);
        if(s_TransparentMultiFrameLaggedAsyncLighting){
            this.m_context.input.removeHandler(this.m_frameLaggedAsyncLightingToggleInput);
            this.removeFrameLaggedAsyncLightingUnfocusedPass();
        }
        this.destroyWorld();
    }

    public b8 onStartup()override{
        this.m_context.setPerfCapture(SmokePerfGpuTimingOnly());

        b8 causticTiming = false;
        if(s_TransparentMultiCausticSphere)
            causticTiming = ReadSmokeEnvironmentFlag(s_TransparentMultiCausticTimingEnvironment);
        if((causticTiming || ReadSmokeEnvironmentFlag("NWB_AVBOIT_SMOKE_TIMING")) && !this.m_timingRenderPass.start(causticTiming))
            return false;

        if(s_TransparentMultiCausticSphere && !this.configureFramebufferCapture())
            return false;

        this.m_context.input.addHandlerToBack(this.m_arrowYawInput);
        if(s_TransparentMultiFrameLaggedAsyncLighting){
            this.m_context.graphics.addRenderPassToBack(this.m_frameLaggedAsyncLightingUnfocusedPass);
            this.m_frameLaggedAsyncLightingUnfocusedPassRegistered = true;
            this.m_context.input.addHandlerToBack(this.m_frameLaggedAsyncLightingToggleInput);
        }

        f32 cameraDistance = s_TransparentCameraStartDepth;
        if(s_TransparentMultiCausticSphere && causticTiming){
            const Expected<String> presetText = ReadSmokeEnvironmentString("NWB_CAUSTIC_SMOKE_CAMERA_PRESET");
            if(!presetText.has_value()){
                error("CausticTimingProbe: camera preset is required");
                return false;
            }
            const StringView preset = StringView(presetText.value());
            if(preset != s_CausticPopulatedPreset && preset != s_CausticSparsePreset){
                error("CausticTimingProbe: camera preset must be populated or sparse");
                return false;
            }
            StringView presetLabel = s_CausticPopulatedPreset;
            if(preset == s_CausticSparsePreset){
                cameraDistance = cameraDistance * 2.0f;
                presetLabel = s_CausticSparsePreset;
            }
            [essential] info(
                "CausticTimingProbe: camera {} distance {} height {}"
                , presetLabel
                , cameraDistance
                , s_TransparentMultiCameraTargetY
            );
            [essential] info(
                "CausticTimingProbe: fixed delta {} yaw {} sphere scale {}"
                , RendererBaselineFixedDelta()
                , this.m_frozenAngle
                , s_TransparentMultiCausticSphereScale
            );
            [essential] info("CausticTimingProbe: photon phases {}", s_CausticSphereTemporalPhaseCount);
            [essential] info(
                "CausticTimingProbe: directional pitch {} yaw {} intensity {}"
                , s_TransparentMultiDefaultDirectionalLightPitch
                , s_TransparentMultiDefaultDirectionalLightYaw
                , s_TransparentMultiDefaultDirectionalLightIntensity
            );
        }

        return PopulateTransparentMultiScene(
            cameraDistance,
            causticTiming,
            this.m_sceneYaw.yaw(),
            SmokeWorldRef(this.m_world),
            this.m_sceneTransforms
        );
    }

    public void onShutdown()override{
        this.m_timingRenderPass.stop();
        this.m_context.graphics.setFrameSubmissionSuspended(false);
        this.m_context.input.removeHandler(this.m_arrowYawInput);
        if(s_TransparentMultiFrameLaggedAsyncLighting){
            this.m_context.input.removeHandler(this.m_frameLaggedAsyncLightingToggleInput);
            this.removeFrameLaggedAsyncLightingUnfocusedPass();
        }
        this.destroyWorld();
        [essential] info("TransparentMultiSmokeProject: shutdown");
    }

    public b8 onUpdate(in f32 delta)override{
        u32 captureFreezeFrame = RendererBaselineCaptureFreezeFrame();
        if(s_TransparentMultiCausticSphere){
            UpdateSmokeFramebufferCapture(this.m_framebufferCapture);
            if(SmokeFramebufferCaptureValid(this.m_framebufferCapture))
                captureFreezeFrame = 0u;
        }

        if(captureFreezeFrame != 0u && this.m_rendererBaselineRenderedFrameCount >= captureFreezeFrame){
            if(!this.m_rendererBaselineCapturePaused){
                this.m_context.graphics.setFrameSubmissionSuspended(true);
                this.m_rendererBaselineCapturePaused = true;
                [essential] info(
                    "TransparentMultiSmokeProject: renderer baseline capture ready after {} rendered frames; render submission suspended"
                    , this.m_rendererBaselineRenderedFrameCount
                );
            }
            return true;
        }

        const f32 fixedDelta = RendererBaselineFixedDelta();
        f32 safeDelta = 0.0f;
        if(fixedDelta > 0.0f)
            safeDelta = fixedDelta;
        else if(IsFinite(delta))
            safeDelta = Max(delta, 0.0f);

        this.m_fpsProbe.recordFrame(safeDelta);
        this.m_gpuPassTimingProbe.recordFrame(safeDelta, this.m_context.gpuTimingView());

        if(s_TransparentMultiFrameLaggedAsyncLighting && this.m_frameLaggedAsyncLightingToggleInput.consumeToggleRequest()){
            this.m_frameLaggedAsyncLightingEnabled = !this.m_frameLaggedAsyncLightingEnabled;
            SmokeRendererSystemRef(SmokeWorldRef(this.m_world)).setFrameLaggedAsyncLightingEnabled(this.m_frameLaggedAsyncLightingEnabled);
            if(this.m_frameLaggedAsyncLightingEnabled)
                [essential] info("FrameLaggedAsyncLightingSmoke: F1 re-enabled frame-lagged async lighting");
            else
                [essential] info("FrameLaggedAsyncLightingSmoke: F1 requested current-frame path");
        }

        this.m_sceneYaw.update(
            safeDelta,
            this.m_frozenAngle,
            IsFinite(this.m_frozenAngle),
            this.m_arrowYawInput,
            s_TransparentManualYawSpeed,
            this.m_rotationSpeed,
            s_TransparentMaxAnimationDelta
        );
        const f32 currentYaw = this.m_sceneYaw.yaw();
        this.m_sceneTransforms.update(currentYaw, SmokeWorldRef(this.m_world));
        SetSmokeYawWindowTitle(currentYaw, this.m_sceneYaw.manualControl(), s_TransparentMultiTwoPi, this.m_context);

        if(!TickSmokeWorld(safeDelta, SmokeWorldRef(this.m_world)))
            return false;
        ++this.m_rendererBaselineRenderedFrameCount;
        return true;
    }

    private void destroyWorld(){
        if(s_TransparentMultiCausticSphere)
            StopAndResetSmokeFramebufferCapture(this.m_framebufferCapture);
        DestroySmokeRenderWorld(this.m_context, this.m_world);
    }

    private b8 configureFramebufferCapture(){
        return ConfigureSmokeFramebufferCapture(
            this.m_context,
            "CausticSphereSmokeProject",
            s_CausticSphereDefaultCaptureFrameCount,
            this.m_framebufferCapture
        );
    }

    private void removeFrameLaggedAsyncLightingUnfocusedPass(){
        if(!this.m_frameLaggedAsyncLightingUnfocusedPassRegistered)
            return;
        this.m_context.graphics.removeRenderPass(this.m_frameLaggedAsyncLightingUnfocusedPass);
        this.m_frameLaggedAsyncLightingUnfocusedPassRegistered = false;
    }

    private mut ProjectRuntimeContext m_context;
    private NotNullUniquePtr<World> m_world;
    private AvboitTimingRenderPass m_timingRenderPass;
    private FpsProbe m_fpsProbe;
    private GpuPassTimingProbe m_gpuPassTimingProbe;
    private ArrowYawInputHandler m_arrowYawInput = ArrowYawInputHandler();
    private UniquePtr<FramebufferCapture> m_framebufferCapture = UniquePtr<FramebufferCapture>();
    private FrameLaggedAsyncLightingToggleInputHandler m_frameLaggedAsyncLightingToggleInput = FrameLaggedAsyncLightingToggleInputHandler();
    private TimingProbeUnfocusedPass m_frameLaggedAsyncLightingUnfocusedPass;
    private TransparentMultiSceneTransforms m_sceneTransforms = TransparentMultiSceneTransforms();
    private YawSpinController m_sceneYaw = YawSpinController();
    private f32 m_rotationSpeed;
    private f32 m_frozenAngle;
    private u32 m_rendererBaselineRenderedFrameCount = 0u;
    private b8 m_rendererBaselineCapturePaused = false;
    private b8 m_frameLaggedAsyncLightingUnfocusedPassRegistered = false;
    private b8 m_frameLaggedAsyncLightingEnabled = true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NotNullUniquePtr<World> CreateTransparentMultiWorldOrDie(mut ProjectRuntimeContext context){
    NotNullUniquePtr<World> world = CreateSmokeWorldOrDie(TransparentMultiProjectName(), context);
    ConfigureTransparentMultiRenderer(SmokeWorldRef(world), context);
    return world;
}

f32 DefaultTransparentMultiRotationSpeed(){
    if(s_TransparentMultiCausticSphere)
        return 0.0f;
    return 0.55f;
}

f32 ParseTransparentMultiRotationSpeed(){
    const Expected<f32> parsed = ReadSmokeEnvironmentF32("NWB_TRANSPARENT_MULTI_SPIN_SPEED");
    if(!parsed.has_value())
        return DefaultTransparentMultiRotationSpeed();
    const f32 speed = parsed.value();
    if(IsFinite(speed) && speed >= 0.0f)
        return speed;
    return DefaultTransparentMultiRotationSpeed();
}

f32 ParseTransparentMultiFrozenAngle(){
    const Expected<f32> parsed = ReadSmokeEnvironmentF32("NWB_TRANSPARENT_MULTI_SPIN_ANGLE");
    if(!parsed.has_value())
        return bit_cast<f32>(s_TransparentMultiQuietNaNBits);
    const f32 angle = parsed.value();
    if(IsFinite(angle))
        return angle;
    return bit_cast<f32>(s_TransparentMultiQuietNaNBits);
}


