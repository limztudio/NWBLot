        if(!this.isValidBody(bodyId))
            return false;
        this.updateBodyMassInternal(bodyId.index);
        return true;
    }

    private void markBodyMassDirty(in u32 bodyIdx){
        if(bodyIdx >= this.m_bodies.size() || !this.m_bodies[bodyIdx].alive)
            return;
        const u32 dirtyBit = cast<u32>(BodyFlags::DirtyMass);
        if((this.m_bodies[bodyIdx].flags & dirtyBit) == 0u){
            this.m_bodies[bodyIdx].flags |= dirtyBit;
            this.m_dirtyMassBodyIds.push_back(bodyIdx);
        }
        this.m_hasDirtyBodyMass = true;
    }

    public void flushDirtyBodyMasses(){
        if(!this.m_hasDirtyBodyMass)
            return;
        for(usize i = 0u; i < this.m_dirtyMassBodyIds.size(); ++i){
            const u32 bodyIdx = this.m_dirtyMassBodyIds[i];
            if(bodyIdx < this.m_bodies.size() && this.m_bodies[bodyIdx].alive && (this.m_bodies[bodyIdx].flags & cast<u32>(BodyFlags::DirtyMass)) != 0u)
                this.updateBodyMassInternal(bodyIdx);
        }
        this.m_dirtyMassBodyIds.clear();
        this.m_hasDirtyBodyMass = false;
    }

    public b8 setBodyMassData(in BodyId bodyId, in MassData massData){
        if(!this.isValidBody(bodyId))
            return false;
        if(this.m_bodies[bodyId.index].type != BodyType::Dynamic)
            return false;
        const f32 massVal = massData.mass();
        const VectorSingle massCenter = massData.center();
        if(
            !IsFinite(VectorSingle(massVal))
            || massVal <= 0.0f
            || !IsFinite(massCenter.xyz)
            || !IsFinite(VectorSingle(massData.inertia.row0).xyz)
            || !IsFinite(VectorSingle(massData.inertia.row1).xyz)
            || !IsFinite(VectorSingle(massData.inertia.row2).xyz)
        )
            return false;

        if(this.m_bodies[bodyId.index].setIndex != s_DisabledSetIndex){
            if(this.m_bodies[bodyId.index].setIndex >= 3u)
                this.wakeBody(bodyId);
            this.wakeBodyNeighbors(bodyId.index);
        }

        mut Body body = this.m_bodies[bodyId.index];
        mut BodySim sim = this.m_solverSets[body.setIndex].sims[body.localIndex];
        const VectorSingle worldCenter = TransformPointValues(VectorSingle(sim.transform.position), VectorSingle(sim.transform.rotation), massCenter);
        const MatrixSingle bodyInertia(
            VectorSingle(massData.inertia.row0),
            VectorSingle(massData.inertia.row1),
            VectorSingle(massData.inertia.row2)
        );
        body.mass = massVal;
        body.inertiaLocal = SymMat3FromMatrix3(bodyInertia);
        sim.setInvMass(1.0f / massVal);
        sim.setLocalCenter(massCenter);
        sim.setCenter(worldCenter);
        sim.setCenter0(worldCenter);
        const MatrixSingle invLocalInertia = Matrix3InvertSymmetric(bodyInertia);
        sim.invInertiaLocal = SymMat3FromMatrix3(invLocalInertia);
        sim.invInertiaWorld = SymMat3FromMatrix3(RotateSymMatrix3(VectorSingle(sim.transform.rotation), invLocalInertia));
        this.updateBodyExtentsFromShapes(body, sim);
        body.flags &= ~cast<u32>(BodyFlags::DirtyMass);
        this.syncBodyFlagsToSimAndState(bodyId.index);
        if(body.setIndex != s_AwakeSetIndex)
            this.markSetTopologyDirty(body.setIndex);
        ++this.m_poseMutationVersion;
        return true;
    }

