////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_MeshSkinningAssetLoadContext = "MeshSkinningRuntimeCache";

enum<u8> ExistingRuntimeMeshDisposition{
    CreateNew = 0,
    ReuseClean = 1,
    ReuploadDirty = 2,
    ReplaceStaleSource = 3,
    kCount
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
b8 BuildRuntimeZippedPayload(in Mesh mesh, in Span<SkinInfluence4> skinStream, mut MeshSkinningRuntimeInstance instance){
    const Expected<MeshletRefTotalCounts> totalCounts = TrySumRuntimeMeshletRefCounts(mesh.meshlets());
    if(!totalCounts.has_value())
        return false;
    Vector<MeshletPositionStreamRef> runtimePositionRefs = Vector<MeshletPositionStreamRef>();
    Vector<MeshletAttributeStreamRef> runtimeAttributeRefs = Vector<MeshletAttributeStreamRef>();
    runtimePositionRefs.resize(totalCounts.value().positionRefCount);
    runtimeAttributeRefs.resize(totalCounts.value().attributeRefCount);
    instance.meshletPositionRefDeltas.clear();
    instance.meshletAttributeRefDeltas.clear();
    instance.attributeSkins.clear();
    if(!TryDecodeRuntimeZippedMeshletStreams(
        mesh.meshlets(),
        mesh.meshletPositionRefDeltas(),
        mesh.meshletAttributeRefDeltas(),
        mesh.positionStream(),
        mesh.normalStream(),
        mesh.tangentStream(),
        mesh.uv0Stream().size(),
        mesh.colorStream().size(),
        skinStream.size(),
        instance.restPositions,
        instance.restNormals,
        instance.restTangents,
        instance.meshlets,
        runtimePositionRefs,
        runtimeAttributeRefs
    ))
        return false;

    const Expected<void, MeshletAttributeSkinFailure> resolvedSkins = ResolveMeshletAttributeSkins(
        instance.meshlets,
        runtimePositionRefs,
        instance.meshletLocalVertexRefs,
        runtimeAttributeRefs.size(),
        instance.attributeSkins
    );
    if(!resolvedSkins.has_value()){
        const MeshletAttributeSkinFailure failure = resolvedSkins.error();
        if(failure.kind == MeshletAttributeSkinFailureKind::ConflictingSkin)
            error("MeshSkinningRuntimeCache: source meshlet {} shares an attribute across skin identities", failure.meshletIndex);
        else
            error("MeshSkinningRuntimeCache: source attribute ref {} is unreferenced", failure.attributeIndex);
        return false;
    }

    if(!EncodeMeshletRefDeltas(
        runtimePositionRefs,
        runtimeAttributeRefs,
        true,
        lambda[](in usize meshletIndex, in auto reason) -> b8{
            error("MeshSkinningRuntimeCache: runtime meshlet {} {}", meshletIndex, reason);
            return false;
        },
        instance.meshlets,
        instance.meshletPositionRefDeltas,
        instance.meshletAttributeRefDeltas
    ))
        return false;

    instance.meshletPositionRefCount = cast<u32>(runtimePositionRefs.size());
    instance.meshletAttributeRefCount = cast<u32>(runtimeAttributeRefs.size());
    const Expected<RuntimeMeshLocalBounds> bounds = TryBuildRuntimeMeshLocalBounds(instance.sourceName, instance.restPositions);
    if(!bounds.has_value()){
        instance.localBounds = RuntimeMeshLocalBounds();
        return false;
    }
    instance.localBounds = bounds.value();
    return true;
}

ExistingRuntimeMeshDisposition ClassifyExistingRuntimeMesh(
    in b8 hasExistingInstance,
    in Name existingSourceName,
    in Name requestedSourceName,
    in RuntimeMeshDirtyFlag dirtyFlags
){
    if(!hasExistingInstance)
        return ExistingRuntimeMeshDisposition::CreateNew;
    if(existingSourceName != requestedSourceName)
        return ExistingRuntimeMeshDisposition::ReplaceStaleSource;
    if((dirtyFlags & RuntimeMeshDirtyFlag::GpuUploadDirty) != RuntimeMeshDirtyFlag::None)
        return ExistingRuntimeMeshDisposition::ReuploadDirty;
    return ExistingRuntimeMeshDisposition::ReuseClean;
}

Expected<BufferHandle> FinalizeRuntimeBufferUpload(
    in Expected<BufferHandle, BufferSetupFailure> buffer,
    in u64 handleValue,
    in StringView label
){
    if(buffer.has_value())
        return buffer.value();
    ReportRuntimeBufferUploadFailure(buffer.error(), label, handleValue);
    return MakeUnexpected(Failure());
}

b8 ValidateRuntimeMeshUploadPayload(in MeshSkinningRuntimeInstance instance){
    if(!ValidateRuntimeMeshUploadPayloadStreams(instance.sourceName, instance.hasCompleteSplitMeshPayload(), instance.restPositions.size(),
        instance.restNormals.size(), instance.restTangents.size(), instance.uv0.size(), instance.colors.size(), instance.skin.size(), instance.meshlets,
        instance.meshletPositionRefDeltas, instance.meshletAttributeRefDeltas, instance.meshletLocalVertexRefs.size(), instance.meshletPrimitiveIndices.size(), instance.attributeSkins))
        return false;
    assert(instance.skeletonJointCount > 0u && instance.skeletonJointCount <= cast<u32>(u16.max) + 1u);
    assert(ValidInverseBindMatrixCount(instance.inverseBindMatrices.size(), instance.skeletonJointCount));
#if defined(NWB_DEBUG)
    for(in SkeletonJointMatrix matrix : instance.inverseBindMatrices)
        assert(MatrixIsInvertibleAffine(LoadFloat(matrix), s_SkinValidationEpsilon, s_SkinValidationEpsilon));
    for(in SkinInfluence4 skin : instance.skin)
        assert(ValidSkinInfluenceWeights(LoadFloat(skin.weight)) && SkinInfluenceFitsSkeleton(skin, instance.skeletonJointCount));
#endif
    return true;
}

b8 CreateNamedRuntimeBuffer(
    in MeshSkinningRuntimeInstance instance,
    in StringView suffix,
    in b8 emptyPayload,
    in Expected<usize> byteCount,
    in u32 structStride,
    in BufferFlags flags,
    in StringView label,
    mut GraphicsRuntime graphics,
    mut BufferHandle outBuffer
){
    const Name name = DeriveNamedRuntimeBufferName(instance.sourceName, instance.handle.value, instance.editRevision, suffix, label);
    if(name == s_NameNone){
        outBuffer.reset();
        return false;
    }
    if(emptyPayload){
        const Expected<BufferHandle> finalized = FinalizeRuntimeBufferUpload(MakeUnexpected(BufferSetupFailure::EmptyPayload), instance.handle.value, label);
        outBuffer.reset();
        return finalized.has_value();
    }
    if(!byteCount.has_value()){
        const Expected<BufferHandle> finalized = FinalizeRuntimeBufferUpload(MakeUnexpected(BufferSetupFailure::ByteSizeOverflow), instance.handle.value, label);
        outBuffer.reset();
        return finalized.has_value();
    }
    const Expected<BufferHandle> finalized = FinalizeRuntimeBufferUpload(
        CreateRuntimeMeshBuffer(graphics, name, cast<u64>(byteCount.value()), structStride, flags),
        instance.handle.value,
        label
    );
    if(!finalized.has_value()){
        outBuffer.reset();
        return false;
    }
    outBuffer = finalized.value();
    return true;
}

b8 CreateTypedRuntimeBuffer<T>(
    in MeshSkinningRuntimeInstance instance,
    in StringView suffix,
    in Span<T> payload,
    in StringView label,
    mut GraphicsRuntime graphics,
    in b8 writable,
    in b8 raw,
    in b8 buildInput,
    in ResourceQueueSharing sharing,
    in b8 indexBuffer,
    mut BufferHandle outBuffer
){
    return CreateNamedRuntimeBuffer(
        instance,
        suffix,
        payload.empty(),
        TryComputeRuntimeMeshBufferByteCount(payload.size(), sizeof(T)),
        cast<u32>(sizeof(T)),
        BufferFlags(writable, raw, buildInput, sharing, indexBuffer),
        label,
        graphics,
        outBuffer
    );
}

b8 CreatePaddedRawRuntimeBuffer(
    in MeshSkinningRuntimeInstance instance,
    in StringView suffix,
    in Span<u8> payload,
    in StringView label,
    mut GraphicsRuntime graphics,
    mut BufferHandle outBuffer
){
    return CreateNamedRuntimeBuffer(
        instance,
        suffix,
        payload.empty(),
        TryComputePaddedRawByteCount(payload.size()),
        cast<u32>(sizeof(u8)),
        BufferFlags(false, true, false, ResourceQueueSharing::GraphicsAndAsyncCompute, false),
        label,
        graphics,
        outBuffer
    );
}

void ResetSkinningRuntimeUploadBuffers(mut MeshSkinningRuntimeInstance instance){
    instance.restPositionBuffer.reset();
    instance.restNormalBuffer.reset();
    instance.restTangentBuffer.reset();
    instance.skinnedPositionBuffer.reset();
    instance.skinnedNormalBuffer.reset();
    instance.skinnedTangentBuffer.reset();
    instance.uv0Buffer.reset();
    instance.colorBuffer.reset();
    instance.meshletDescBuffer.reset();
    instance.meshletBoundsBuffer.reset();
    instance.meshletPositionRefDeltaBuffer.reset();
    instance.meshletAttributeRefDeltaBuffer.reset();
    instance.meshletLocalVertexRefBuffer.reset();
    instance.meshletPrimitiveIndexBuffer.reset();
    instance.attributeSkinBuffer.reset();
    instance.triangleIndexBuffer.reset();
    instance.attributeBuffer.reset();
    instance.meshletLocalBoundsBuffer.reset();
    instance.localBoundsBuffer.reset();
}

[cpp_unwind]
void MeshSkinningRuntimeCache::prepareResources(mut World world){
    auto view = world.view<SkinnedMeshBindingComponent>();
    const usize count = view.candidateCount();
    if(count == 0u){
        this.clear();
        return;
    }
    this.m_instances.reserve(count);
    this.m_handleToEntity.reserve(count);
    this.m_sources.reserve(count);
    const b8 prune = !this.m_instances.empty();
    mut MeshSkinningRuntimeCache cache = this;
    view.each(lambda[mut cache](in EntityID entity, mut SkinnedMeshBindingComponent binding) -> void{
        if(!cache.ensureRuntimeMesh(entity, binding))
            binding.runtimeMesh.reset();
    });
    if(prune){
        Vector<EntityID> stale;
        for(in auto item : this.m_instances){
            if(!world.hasComponent<SkinnedMeshBindingComponent>(item.first))
                stale.push_back(item.first);
        }
        for(in EntityID entity : stale)
            this.releaseRuntimeMesh(entity);
    }
}

[cpp_unwind]
b8 MeshSkinningRuntimeCache::ensureSourceLoaded(in AssetRef<Skin> ref){
    assert(ref.valid());
    if(this.m_sources.contains(ref.name()))
        return true;
    auto skin = LoadTypedAssetSync<Skin>(this.m_assets, ref.name(), s_MeshSkinningAssetLoadContext);
    if(!skin.has_value())
        return false;
    auto mesh = LoadTypedAssetSync<Mesh>(this.m_assets, skin.value().deref().mesh().name(), s_MeshSkinningAssetLoadContext);
    if(!mesh.has_value())
        return false;
    const auto stored = this.m_sources.try_emplace(ref.name());
    if(!stored.second){
        error("MeshSkinningRuntimeCache: source identity was already registered");
        return false;
    }
    mut MeshSkinningSource source = stored.first.value();
    mut UniquePtr<Skin> loadedSkin = skin.value();
    mut UniquePtr<Mesh> loadedMesh = mesh.value();
    MoveInto<UniquePtr<Skin>>(source.skinAsset, loadedSkin);
    MoveInto<UniquePtr<Mesh>>(source.meshAsset, loadedMesh);
    return true;
}

[cpp_unwind]
b8 MeshSkinningRuntimeCache::ensureRuntimeMesh(in EntityID entity, mut SkinnedMeshBindingComponent component){
    const Name sourceName = component.skin.name();
    if(!component.skin.valid()){
        this.releaseRuntimeMesh(entity);
        component.runtimeMesh.reset();
        return false;
    }
    const auto existing = this.m_instances.find(entity);
    if(existing != this.m_instances.end()){
        mut MeshSkinningRuntimeInstance instance = existing.value();
        const auto disposition = ClassifyExistingRuntimeMesh(true, instance.sourceName, sourceName, instance.dirtyFlags);
        if(disposition == ExistingRuntimeMeshDisposition::ReuseClean || disposition == ExistingRuntimeMeshDisposition::ReuploadDirty){
            component.runtimeMesh = instance.handle;
            if(disposition == ExistingRuntimeMeshDisposition::ReuploadDirty){
                if(!this.uploadRuntimeMeshBuffers(instance)){
                    this.releaseRuntimeMesh(entity);
                    component.runtimeMesh.reset();
                    return false;
                }
                instance.dirtyFlags &= ~RuntimeMeshDirtyFlag::All;
                ++this.m_topologyGeneration;
            }
            return instance.valid();
        }
        this.releaseRuntimeMesh(entity);
        component.runtimeMesh.reset();
    }
    if(!this.ensureSourceLoaded(component.skin))
        return false;
    PendingSkinningInstance pending(this.m_instances, this.m_sources, entity, sourceName);
    const auto handle = TryAllocateRuntimeMeshHandleValue(this.m_handleToEntity, this.m_nextHandleValue);
    if(!handle.has_value())
        return false;
    const auto stored = this.m_instances.try_emplace(entity, this.emptyInstance());
    if(!stored.second){
        error("MeshSkinningRuntimeCache: runtime instance identity was already registered");
        return false;
    }
    pending.inserted = true;
    mut MeshSkinningRuntimeInstance instance = stored.first.value();
    mut MeshSkinningSource source = this.m_sources.at(sourceName);
    in Mesh mesh = source.meshAsset.deref();
    in Skin skin = source.skinAsset.deref();
    instance.handle.value = handle.value();
    instance.entity = entity;
    instance.sourceName = sourceName;
    instance.uv0 = mesh.uv0Stream();
    instance.colors = mesh.colorStream();
    instance.skin = skin.influences();
    instance.skeletonJointCount = cast<u32>(skin.inverseBindMatrices().size());
    instance.inverseBindMatrices = skin.inverseBindMatrices();
    instance.meshletBounds = mesh.meshletBounds();
    instance.meshletLocalVertexRefs = mesh.meshletLocalVertexRefs();
    instance.meshletPrimitiveIndices = mesh.meshletPrimitiveIndices();
    instance.solidTriangleWords = Span<u32>(mesh.solidTriangleWords());
    instance.dirtyFlags = RuntimeMeshDirtyFlag::All;
    if(!BuildRuntimeZippedPayload(mesh, skin.influences(), instance) || !this.uploadRuntimeMeshBuffers(instance))
        return false;
    instance.dirtyFlags &= ~RuntimeMeshDirtyFlag::All;
    if(!instance.valid()){
        error("MeshSkinningRuntimeCache: prepared runtime mesh is incomplete");
        return false;
    }
    if(!this.m_handleToEntity.emplace(handle.value(), entity).second){
        error("MeshSkinningRuntimeCache: runtime mesh handle was already registered");
        return false;
    }
    ++source.referenceCount;
    component.runtimeMesh = instance.handle;
    pending.published = true;
    ++this.m_topologyGeneration;
    return true;
}

[cpp_unwind]
b8 MeshSkinningRuntimeCache::uploadRuntimeMeshBuffers(mut MeshSkinningRuntimeInstance instance){
    if(!ValidateRuntimeMeshUploadPayload(instance))
        return false;
    const auto triangleIndices = TryBuildMeshSkinningTraceIndices(instance);
    if(!triangleIndices.has_value())
        return false;
    const auto triangleAttributes = TryBuildMeshSkinningTraceAttributes(instance);
    if(!triangleAttributes.has_value())
        return false;
    const Name batchReadyName = DeriveRuntimeResourceName(instance.sourceName, instance.handle.value, instance.editRevision, "upload_batch_ready");
    if(batchReadyName == s_NameNone)
        return false;

    const b8 rtSupported = this.m_graphics.queryFeatureSupport(Feature::RayTracingAccelStruct);
    const ResourceQueueSharing sharedQueues = ResourceQueueSharing::GraphicsAndAsyncCompute;
    b8 created = CreateMeshSkinningLocalBoundsBuffers(this.m_graphics, instance);
    created = created && CreateTypedRuntimeBuffer<f32x3u>(instance, s_RestPositionsSuffix, instance.restPositions, s_RuntimeCacheRestPositionLabel, this.m_graphics, false, false, false, sharedQueues, false, instance.restPositionBuffer);
    created = created && CreateTypedRuntimeBuffer<f16x4u>(instance, s_RestNormalsSuffix, instance.restNormals, s_RuntimeCacheRestNormalLabel, this.m_graphics, false, false, false, sharedQueues, false, instance.restNormalBuffer);
    created = created && CreateTypedRuntimeBuffer<f16x4u>(instance, s_RestTangentsSuffix, instance.restTangents, s_RuntimeCacheRestTangentLabel, this.m_graphics, false, false, false, sharedQueues, false, instance.restTangentBuffer);
    created = created && CreateTypedRuntimeBuffer<f32x3u>(instance, s_SkinnedPositionsSuffix, instance.restPositions, s_RuntimeCacheSkinnedPositionLabel, this.m_graphics, true, true, rtSupported, sharedQueues, false, instance.skinnedPositionBuffer);
    created = created && CreateTypedRuntimeBuffer<f16x4u>(instance, s_SkinnedNormalsSuffix, instance.restNormals, s_RuntimeCacheSkinnedNormalLabel, this.m_graphics, true, false, false, sharedQueues, false, instance.skinnedNormalBuffer);
    created = created && CreateTypedRuntimeBuffer<f16x4u>(instance, s_SkinnedTangentsSuffix, instance.restTangents, s_RuntimeCacheSkinnedTangentLabel, this.m_graphics, true, false, false, sharedQueues, false, instance.skinnedTangentBuffer);
    created = created && CreateTypedRuntimeBuffer<f32x2u>(instance, s_Uv0Suffix, instance.uv0, s_RuntimeCacheUv0Label, this.m_graphics, false, false, false, sharedQueues, false, instance.uv0Buffer);
    created = created && CreateTypedRuntimeBuffer<f16x4u>(instance, s_ColorsSuffix, instance.colors, s_RuntimeCacheColorLabel, this.m_graphics, false, false, false, sharedQueues, false, instance.colorBuffer);
    created = created && CreateTypedRuntimeBuffer<MeshletDesc>(instance, s_MeshletsSuffix, instance.meshlets, s_RuntimeCacheMeshletDescriptorLabel, this.m_graphics, false, false, false, sharedQueues, false, instance.meshletDescBuffer);
    created = created && CreateTypedRuntimeBuffer<MeshletBounds>(instance, s_MeshletBoundsSuffix, instance.meshletBounds, s_RuntimeCacheMeshletBoundsLabel, this.m_graphics, true, true, false, sharedQueues, false, instance.meshletBoundsBuffer);
    created = created && CreatePaddedRawRuntimeBuffer(instance, s_MeshletPositionRefDeltasSuffix, instance.meshletPositionRefDeltas, s_RuntimeCacheMeshletPositionRefDeltaLabel, this.m_graphics, instance.meshletPositionRefDeltaBuffer);
    created = created && CreatePaddedRawRuntimeBuffer(instance, s_MeshletAttributeRefDeltasSuffix, instance.meshletAttributeRefDeltas, s_RuntimeCacheMeshletAttributeRefDeltaLabel, this.m_graphics, instance.meshletAttributeRefDeltaBuffer);
    created = created && CreateTypedRuntimeBuffer<MeshletLocalVertexRef>(instance, s_MeshletLocalVertexRefsSuffix, instance.meshletLocalVertexRefs, s_RuntimeCacheMeshletLocalVertexRefLabel, this.m_graphics, false, false, false, sharedQueues, false, instance.meshletLocalVertexRefBuffer);
    created = created && CreatePaddedRawRuntimeBuffer(instance, s_MeshletPrimitiveIndicesSuffix, instance.meshletPrimitiveIndices, s_RuntimeCacheMeshletPrimitiveIndexLabel, this.m_graphics, instance.meshletPrimitiveIndexBuffer);
    created = created && CreateTypedRuntimeBuffer<u32>(instance, s_AttributeSkinsSuffix, instance.attributeSkins, s_RuntimeCacheAttributeSkinLabel, this.m_graphics, false, false, false, sharedQueues, false, instance.attributeSkinBuffer);
    created = created && CreateTypedRuntimeBuffer<u32>(instance, s_RtTriangleIndicesBufferName, triangleIndices.value(), s_RuntimeCacheRtTriangleIndexLabel, this.m_graphics, false, true, rtSupported, sharedQueues, true, instance.triangleIndexBuffer);
    created = created && CreateTypedRuntimeBuffer<AttribGpu>(instance, s_RtTriangleAttributesBufferName, triangleAttributes.value(), s_RuntimeCacheRtTriangleAttributeLabel, this.m_graphics, true, true, false, sharedQueues, false, instance.attributeBuffer);
    if(!created){
        ResetSkinningRuntimeUploadBuffers(instance);
        return false;
    }

    const GpuPhysicalQueueId graphicsQueue = this.m_graphics.getDevice().getPrimaryPhysicalQueue(CommandQueue::Graphics);
    in MeshSkinningRuntimeInstance instanceRef = instance;
    in Vector<u32> traceIndices = triangleIndices.value();
    in Vector<AttribGpu> traceAttributes = triangleAttributes.value();
    const Expected<QueueSubmissionToken> uploaded = this.m_graphics.standaloneGraph().submitStandaloneTaskGraph(
        lambda[in instanceRef, in traceIndices, in traceAttributes, in batchReadyName](mut GpuTaskGraph graph) -> Expected<GpuTaskId>{
            Vector<GpuTaskId> uploadTasks;
            uploadTasks.reserve(17u);
            b8 ok = DeclareRuntimeMeshBatchTypedUpload<f32x3u>(graph, instanceRef.restPositionBuffer, s_RuntimeCacheRestPositionLabel, instanceRef.restPositions, uploadTasks);
            ok = ok && DeclareRuntimeMeshBatchTypedUpload<f16x4u>(graph, instanceRef.restNormalBuffer, s_RuntimeCacheRestNormalLabel, instanceRef.restNormals, uploadTasks);
            ok = ok && DeclareRuntimeMeshBatchTypedUpload<f16x4u>(graph, instanceRef.restTangentBuffer, s_RuntimeCacheRestTangentLabel, instanceRef.restTangents, uploadTasks);
            ok = ok && DeclareRuntimeMeshBatchTypedUpload<f32x3u>(graph, instanceRef.skinnedPositionBuffer, s_RuntimeCacheSkinnedPositionLabel, instanceRef.restPositions, uploadTasks);
            ok = ok && DeclareRuntimeMeshBatchTypedUpload<f16x4u>(graph, instanceRef.skinnedNormalBuffer, s_RuntimeCacheSkinnedNormalLabel, instanceRef.restNormals, uploadTasks);
            ok = ok && DeclareRuntimeMeshBatchTypedUpload<f16x4u>(graph, instanceRef.skinnedTangentBuffer, s_RuntimeCacheSkinnedTangentLabel, instanceRef.restTangents, uploadTasks);
            ok = ok && DeclareRuntimeMeshBatchTypedUpload<f32x2u>(graph, instanceRef.uv0Buffer, s_RuntimeCacheUv0Label, instanceRef.uv0, uploadTasks);
            ok = ok && DeclareRuntimeMeshBatchTypedUpload<f16x4u>(graph, instanceRef.colorBuffer, s_RuntimeCacheColorLabel, instanceRef.colors, uploadTasks);
            ok = ok && DeclareRuntimeMeshBatchTypedUpload<MeshletDesc>(graph, instanceRef.meshletDescBuffer, s_RuntimeCacheMeshletDescriptorLabel, instanceRef.meshlets, uploadTasks);
            ok = ok && DeclareRuntimeMeshBatchTypedUpload<MeshletBounds>(graph, instanceRef.meshletBoundsBuffer, s_RuntimeCacheMeshletBoundsLabel, instanceRef.meshletBounds, uploadTasks);
            ok = ok && DeclareRuntimeMeshBatchPaddedRawUpload(graph, instanceRef.meshletPositionRefDeltaBuffer, s_RuntimeCacheMeshletPositionRefDeltaLabel, instanceRef.meshletPositionRefDeltas, uploadTasks);
            ok = ok && DeclareRuntimeMeshBatchPaddedRawUpload(graph, instanceRef.meshletAttributeRefDeltaBuffer, s_RuntimeCacheMeshletAttributeRefDeltaLabel, instanceRef.meshletAttributeRefDeltas, uploadTasks);
            ok = ok && DeclareRuntimeMeshBatchTypedUpload<MeshletLocalVertexRef>(graph, instanceRef.meshletLocalVertexRefBuffer, s_RuntimeCacheMeshletLocalVertexRefLabel, instanceRef.meshletLocalVertexRefs, uploadTasks);
            ok = ok && DeclareRuntimeMeshBatchPaddedRawUpload(graph, instanceRef.meshletPrimitiveIndexBuffer, s_RuntimeCacheMeshletPrimitiveIndexLabel, instanceRef.meshletPrimitiveIndices, uploadTasks);
            ok = ok && DeclareRuntimeMeshBatchTypedUpload<u32>(graph, instanceRef.attributeSkinBuffer, s_RuntimeCacheAttributeSkinLabel, instanceRef.attributeSkins, uploadTasks);
            ok = ok && DeclareRuntimeMeshBatchTypedUpload<u32>(graph, instanceRef.triangleIndexBuffer, s_RuntimeCacheRtTriangleIndexLabel, traceIndices, uploadTasks);
            ok = ok && DeclareRuntimeMeshBatchTypedUpload<AttribGpu>(graph, instanceRef.attributeBuffer, s_RuntimeCacheRtTriangleAttributeLabel, traceAttributes, uploadTasks);
            if(!ok)
                return MakeUnexpected(Failure());

            GpuTaskDesc readyDesc = GpuTaskDesc();
            readyDesc
                .setIdentity(batchReadyName)
                .setMarkerLabel("Skinning Runtime Batch Upload Ready")
                .setDependencies(Span<GpuTaskId>(uploadTasks))
            ;
            RuntimeMeshBatchUploadReadyTask readyTask;
            return graph.addPayloadTask(readyDesc, readyTask);
        },
        graphicsQueue
    );
    if(!uploaded.has_value() || !uploaded.value().valid()){
        error("MeshSkinningSystem: failed to submit batched runtime mesh upload for handle '{}'", instance.handle.value);
        ResetSkinningRuntimeUploadBuffers(instance);
        return false;
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

