    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const WidgetId left = RequireUiWidgetId(self.id("left"), s_UiBuilderCaptionKey);
    const WidgetId right = RequireUiWidgetId(self.id("right"), s_UiBuilderCaptionKey);
