#include "commands.adhd"
#include "pointer.adhd"
#include <impl/ecs_ui/toolkit/id.adhd>
#include "popup.adhd"
#include "control.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_InputMaxTargets = 4096u;
const usize s_InputMaxEvents = 256u;
const usize s_InputMaxSources = 256u;
const usize s_InputMaxActions = 256u;
const usize s_InputMaxPointerGestures = 256u;
const usize s_InputMaxControlActions = 256u;
const usize s_InputMaxContextMenuActions = 256u;
const usize s_InputSourceReserve = 16u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> InputEventType{
    PointerMove,
    PrimaryDown,
    PrimaryUp,
    KeyDown,
    KeyUp,
    FocusLost,
    PointerLeave,
    PointerCaptureLost,
    FocusGained,
    PointerWheel,
    SecondaryDown,
    SecondaryUp,
    CommandDown,
    CommandUp,
}

enum<u8> InputActionSource{
    Pointer,
    Command,
}

enum<u8> PointerGestureState{
    Active,
    Completed,
}

class InputEvent{
    public InputEventType type = InputEventType::PointerMove;
    public InputCommand command = InputCommand::None;
    public b8 extend = false;
    public b8 edit = true;
    public Point position;
    public i32 key = s_InputKeyUnknown;
    public b8 shift = false;
    public b8 repeat = false;
    public b8 control = false;
    public b8 alt = false;
    public b8 super = false;
    public b8 allowText = false;
    public b8 hoverCapable = false;
    public f64 scrollX = 0.0;
    public f64 scrollY = 0.0;
    // Optional monotonic timestamp at native ingress; zero leaves pointer clicks ungrouped.
    public u64 timestampMs = 0u;
    public InputSource source;
}

// Rectangle and clip use the same logical coordinates as painting; publication order provides the default focus traversal order.
class HitTarget{
    public WidgetId id;
    public u64 declarationGeneration = 1u;
    public PopupToken popup;
    public ControlToken control;
    public WidgetId owner;
    public u64 ownerDeclarationGeneration = 0u;
    public u64 value = 0u;
    public f64 scrollStep = 0.0;
    public u64 pageRows = 1u;
    public f64 gestureMaximum = 0.0;
    public WidgetId commandOwner;
    public u64 commandOwnerDeclarationGeneration = 0u;
    public ControlToken commandControl;
    public f64 scrollStepX = 0.0;
    public f64 gestureMaximumX = 0.0;
    public Rect rectangle;
    public Rect clip;
    // Both zero dimensions omit the reference; a supplied reference has two positive dimensions.
    public Rect gestureReference;
    public u32 paintOrder = 0u;
    public u32 layer = 0u;
    public b8 enabled = true;
    public b8 focusable = false;
    public b8 activatable = false;
    public b8 pointerGesture = false;
    public b8 textEditable = false;
    public b8 navigable = false;
    public b8 scrollable = false;
    public b8 focusOnCommit = false;
    // A focused editor may borrow vertical navigation and submission from another accepted control lifetime.
    public b8 contextMenu = false;
    public b8 horizontalNavigation = false;
}

// Actions retain values, never callbacks or declaration pointers; target lifetime must still match when consumed.
class InputActionId{
    public b8 operator==(in InputActionId rhs)const{
        return this.target == rhs.target && this.declarationGeneration == rhs.declarationGeneration && this.layoutGeneration == rhs.layoutGeneration && this.sequence == rhs.sequence;
    }

    public b8 operator!=(in InputActionId rhs)const{
        return this.target != rhs.target || this.declarationGeneration != rhs.declarationGeneration || this.layoutGeneration != rhs.layoutGeneration || this.sequence != rhs.sequence;
    }

    public b8 valid()const{
        return this.target.valid() && this.declarationGeneration != 0u && this.layoutGeneration != 0u && this.sequence != 0u;
    }

    public WidgetId target;
    public u64 declarationGeneration = 0u;
    public u64 layoutGeneration = 0u;
    public u64 sequence = 0u;
}

class InputAction{
    public InputActionId id;
    public InputActionSource origin = InputActionSource::Pointer;
    public PopupToken popup;
    public ControlToken control;
    public InputSource inputSource;
}

// Context-menu triggers retain the accepted anchor and lifetime without borrowing the declaration.
class ContextMenuAction{
    public InputActionId id;
    public PopupToken popup;
    public ControlToken control;
    public Point position;
    public InputActionSource origin = InputActionSource::Pointer;
    public InputSource inputSource;
}

// Ordered copied input addressed to a focusable host, including stable values selected by its parts.
class ControlAction{
    public InputActionId id;
    public WidgetId source;
    public PopupToken popup;
    public ControlToken control;
    public ControlActionKind kind = ControlActionKind::Wheel;
    public f64 delta = 0.0;
    public u64 value = 0u;
    public f64 step = 0.0;
    public u64 pageRows = 1u;
    public f64 maximum = 0.0;
    public u64 sourceDeclarationGeneration = 0u;
    public ControlToken sourceControl;
    // Positive X moves right; positive Y moves up. Each wheel action carries one native event.
    public f64 deltaX = 0.0;
    public f64 stepX = 0.0;
    public f64 maximumX = 0.0;
}

// One coalesced update per press retains the committed geometry; cancellation removes the gesture without delivery.
class PointerGesture{
    public InputActionId id;
    public InputSource inputSource;
    public Point origin;
    public Point position;
    public Rect targetRectangle;
    public Rect referenceRectangle;
    public PointerGestureState state = PointerGestureState::Active;
    public PopupToken popup;
    public ControlToken control;
    public f64 maximum = 0.0;
    public u64 updateSequence = 0u;
    // Copied once from the accepted target at the initial press; later updates retain these opaque bits.
    public u64 value = 0u;
}

class InputRoutingResult{
    public b8 pointerConsumed = false;
    public b8 commandConsumed = false;
    public b8 wantsPointer = false;
    public b8 wantsCommands = false;
    public b8 pointerRouted = false;
    public b8 activationOverflow = false;
    public b8 gestureOverflow = false;
    public WidgetId hover;
    public WidgetId focus;
    public WidgetId capture;
}

class PointerGestureRecord{
    public PointerGestureRecord(){
        this.pendingUpdate = true;
    }

    public PointerGestureRecord(in PointerGesture inGesture, in b8 inPendingUpdate){
        this.gesture = inGesture;
        this.pendingUpdate = inPendingUpdate;
    }

    public PointerGesture gesture;
    public b8 pendingUpdate;
}

class TargetLookup{
    public TargetLookup(){
        this.value = 0u;
        this.index = 0u;
    }

    public TargetLookup(in u64 inValue, in u32 inIndex){
        this.value = inValue;
        this.index = inIndex;
    }

    public u64 value;
    public u32 index;
}

class ControlCommandOwner{
    public ControlCommandOwner(){
        this.declarationGeneration = 0u;
        this.horizontal = false;
    }

    public ControlCommandOwner(in WidgetId inHost, in u64 inDeclarationGeneration, in PopupToken inPopup, in ControlToken inControl, in b8 inHorizontal){
        this.host = inHost;
        this.declarationGeneration = inDeclarationGeneration;
        this.popup = inPopup;
        this.control = inControl;
        this.horizontal = inHorizontal;
    }

    public WidgetId host;
    public u64 declarationGeneration;
    public PopupToken popup;
    public ControlToken control;
    public b8 horizontal;
}

class TargetOwner{
    public TargetOwner(){
        this.declarationGeneration = 0u;
    }

    public TargetOwner(in WidgetId inTarget, in u64 inDeclarationGeneration, in PopupToken inPopup, in ControlToken inControl){
        this.target = inTarget;
        this.declarationGeneration = inDeclarationGeneration;
        this.popup = inPopup;
        this.control = inControl;
    }

    public WidgetId target;
    public u64 declarationGeneration;
    public PopupToken popup;
    public ControlToken control;
}

class BoundSource{
    public BoundSource(){}

    public BoundSource(in InputSource inSource, in InputCommandIntent inIntent){
        this.source = inSource;
        this.intent = inIntent;
    }

    public InputSource source;
    public InputCommandIntent intent;
}

class CommandSource{
    public InputSource source;
    public ControlCommandOwner controlOwner;
    public TargetOwner focusOwner;
    public Point contextPosition;
    public b8 consumed = false;
    public b8 delegated = false;
    public b8 submitArmed = false;
    public b8 contextArmed = false;
}

class HoverIdentity{
    public HoverIdentity(){
        this.declarationGeneration = 0u;
    }

    public HoverIdentity(in WidgetId inOwner, in u64 inDeclarationGeneration, in PopupToken inPopup, in ControlToken inControl){
        this.owner = inOwner;
        this.declarationGeneration = inDeclarationGeneration;
        this.popup = inPopup;
        this.control = inControl;
    }

    public WidgetId owner;
    public u64 declarationGeneration;
    public PopupToken popup;
    public ControlToken control;
}

class PointerBinding{
    public PointerBinding(){
        this.intent = PointerIntent::Activate;
        this.hoverCapable = false;
    }

    public PointerBinding(in InputSource inSource, in PointerIntent inIntent, in b8 inHoverCapable){
        this.source = inSource;
        this.intent = inIntent;
        this.hoverCapable = inHoverCapable;
    }

    public InputSource source;
    public PointerIntent intent;
    public b8 hoverCapable;
}

class PointerSource{
    public PointerSource(){
        this.intent = PointerIntent::Activate;
        this.consumed = false;
        this.inert = false;
    }

    public PointerSource(in InputSource inSource, in PointerIntent inIntent, in b8 inConsumed, in b8 inInert){
        this.source = inSource;
        this.intent = inIntent;
        this.consumed = inConsumed;
        this.inert = inInert;
    }

    public InputSource source;
    public PointerIntent intent;
    public b8 consumed;
    public b8 inert;
}

b8 IsPointerInputEventType(in InputEventType type){
    switch(type){
    case InputEventType::PointerMove:
    case InputEventType::PrimaryDown:
    case InputEventType::PrimaryUp:
    case InputEventType::SecondaryDown:
    case InputEventType::SecondaryUp:
    case InputEventType::PointerWheel:
    case InputEventType::PointerLeave:
    case InputEventType::PointerCaptureLost:
        return true;
    default:
        return false;
    }
}

Expected<InputEvent> TryMakePointerInputEvent(in PointerInput input){
    InputEvent outEvent;
    if(input.phase > PointerPhase::Scroll || input.intent > PointerIntent::ContextMenu)
        return makeUnexpected(Failure());
    switch(input.phase){
    case PointerPhase::Move:
        outEvent.type = InputEventType::PointerMove;
        break;
    case PointerPhase::Press:
        if(input.intent == PointerIntent::Activate)
            outEvent.type = InputEventType::PrimaryDown;
        else
            outEvent.type = InputEventType::SecondaryDown;
        break;
    case PointerPhase::Release:
        if(input.intent == PointerIntent::Activate)
            outEvent.type = InputEventType::PrimaryUp;
        else
            outEvent.type = InputEventType::SecondaryUp;
        break;
    case PointerPhase::Cancel:
        outEvent.type = InputEventType::PointerCaptureLost;
        break;
    case PointerPhase::Leave:
        outEvent.type = InputEventType::PointerLeave;
        break;
    case PointerPhase::Scroll:
        outEvent.type = InputEventType::PointerWheel;
        break;
    }
    outEvent.source = input.source;
    outEvent.position = input.position;
    outEvent.scrollX = input.scrollX;
    outEvent.scrollY = input.scrollY;
    outEvent.timestampMs = input.timestampMs;
    outEvent.extend = input.extend;
    outEvent.hoverCapable = input.hoverCapable;
    return outEvent;
}

b8 HasValidHitTargetControlProperties(in HitTarget target){
    if(
        (!target.control.empty() && !target.control.valid())
        || !isFinite(target.scrollStep) || target.scrollStep < 0.0
        || !isFinite(target.scrollStepX) || target.scrollStepX < 0.0
        || !isFinite(target.gestureMaximum) || target.gestureMaximum < 0.0 || target.pageRows == 0u
        || !isFinite(target.gestureMaximumX) || target.gestureMaximumX < 0.0
        || ((target.navigable || target.scrollable) && (!target.control.valid() || !target.focusable || target.owner.valid()))
        || (target.horizontalNavigation && !target.navigable)
        || (target.focusOnCommit && (!target.focusable || target.owner.valid()))
    )
        return false;
    if(!target.owner.valid())
        return target.ownerDeclarationGeneration == 0u;
    return target.owner != target.id
        && target.ownerDeclarationGeneration != 0u
        && target.control.valid()
        && !target.focusable
        && !target.navigable
        && !target.scrollable
        && !target.focusOnCommit
        && !target.horizontalNavigation;
}

Expected<ControlActionKind> TryTranslateControlNavigationCommand(in InputCommand command, in b8 horizontalNavigation){
    switch(command){
    case InputCommand::Left:
    case InputCommand::WordLeft:
        if(!horizontalNavigation)
            return makeUnexpected(Failure());
        return ControlActionKind::Left;
    case InputCommand::Right:
    case InputCommand::WordRight:
        if(!horizontalNavigation)
            return makeUnexpected(Failure());
        return ControlActionKind::Right;
    case InputCommand::Up:
        return ControlActionKind::Up;
    case InputCommand::Down:
        return ControlActionKind::Down;
    case InputCommand::PageUp:
        return ControlActionKind::PageUp;
    case InputCommand::PageDown:
        return ControlActionKind::PageDown;
    case InputCommand::DocumentHome:
    case InputCommand::Home:
        return ControlActionKind::Home;
    case InputCommand::DocumentEnd:
    case InputCommand::End:
        return ControlActionKind::End;
    default:
        return makeUnexpected(Failure());
    }
}

b8 HasValidHitTargetCommandOwnerProperties(in HitTarget source){
    if(!source.commandOwner.valid())
        return source.commandOwnerDeclarationGeneration == 0u && source.commandControl.empty();
    return source.enabled
        && source.focusable
        && source.textEditable
        && !source.owner.valid()
        && !source.navigable
        && !source.scrollable
        && source.commandOwner != source.id
        && source.commandOwnerDeclarationGeneration != 0u
        && source.commandControl.valid();
}

Expected<usize> FindTargetIndexInTable(in Span<HitTarget> targets, in Span<TargetLookup> lookup, in WidgetId id, in u64 declarationGeneration){
    usize begin = 0u;
    usize end = lookup.size();
    while(begin < end){
        usize middle = begin + (end - begin) / 2u;
        if(lookup[middle].value < id.value)
            begin = middle + 1u;
        else
            end = middle;
    }
    if(begin == lookup.size() || lookup[begin].value != id.value)
        return makeUnexpected(Failure());
    usize targetIndex = cast<usize>(lookup[begin].index);
    if(targetIndex >= targets.size())
        return makeUnexpected(Failure());
    HitTarget target = targets[targetIndex];
    if(declarationGeneration != 0u && target.declarationGeneration != declarationGeneration)
        return makeUnexpected(Failure());
    return targetIndex;
}

b8 ValidateStagedHitTargetControlTargets(in Span<HitTarget> targets, in Span<TargetLookup> lookup){
    for(usize i = 0u; i < targets.size(); ++i){
        const HitTarget target = targets[i];
        if(!HasValidHitTargetControlProperties(target))
            return false;
        if(!target.owner.valid())
            continue;
        const Expected<usize> hostIndex = FindTargetIndexInTable(targets, lookup, target.owner, target.ownerDeclarationGeneration);
        if(!hostIndex.has_value())
            return false;
        const HitTarget host = targets[hostIndex.value()];
        if(!host.enabled || !host.focusable || host.owner.valid() || host.control != target.control || host.popup != target.popup || host.layer != target.layer)
            return false;
    }
    return true;
}

b8 ValidateStagedHitTargetCommandOwners(in Span<HitTarget> targets, in Span<TargetLookup> lookup){
    for(usize i = 0u; i < targets.size(); ++i){
        const HitTarget source = targets[i];
        if(!HasValidHitTargetCommandOwnerProperties(source))
            return false;
        if(!source.commandOwner.valid())
            continue;
        const Expected<usize> hostIndex = FindTargetIndexInTable(targets, lookup, source.commandOwner, source.commandOwnerDeclarationGeneration);
        if(!hostIndex.has_value())
            return false;
        const HitTarget host = targets[hostIndex.value()];
        if(!host.enabled || !host.focusable || !host.navigable || host.owner.valid() || host.control != source.commandControl || host.popup != source.popup || host.layer != source.layer)
            return false;
    }
    return true;
}

b8 ValidStagedPopupTarget(in HitTarget target, in Span<PopupRecord> stagedPopups){
    if(!target.popup.widget.valid())
        return target.layer == 0u && target.popup.declarationGeneration == 0u && target.popup.instanceGeneration == 0u && target.popup.openGeneration == 0u;
    for(usize i = 0u; i < stagedPopups.size(); ++i){
        if(stagedPopups[i].scope.token == target.popup)
            return target.layer == stagedPopups[i].scope.layer;
    }
    return false;
}

void AppendRouterPointerGesture(
    in HitTarget target,
    in u64 layoutGeneration,
    in InputSource activePointerSource,
    in Point interactionPosition,
    mut Vector<PointerGestureRecord> pointerGestures,
    mut u64 outActiveGestureSequence,
    mut u64 inoutNextActionSequence,
    mut InputRoutingResult inoutResult
){
    outActiveGestureSequence = 0u;
    if(pointerGestures.size() == s_InputMaxPointerGestures || inoutNextActionSequence == 0u){
        inoutResult.gestureOverflow = true;
        return;
    }
    PointerGesture gesture;
    gesture.id.target = target.id;
    gesture.id.declarationGeneration = target.declarationGeneration;
    gesture.id.layoutGeneration = layoutGeneration;
    gesture.id.sequence = inoutNextActionSequence;
    gesture.inputSource = activePointerSource;
    gesture.origin = interactionPosition;
    gesture.position = interactionPosition;
    gesture.targetRectangle = target.rectangle;
    if(target.gestureReference.width > 0.0f)
        gesture.referenceRectangle = target.gestureReference;
    else
        gesture.referenceRectangle = target.rectangle;
    gesture.popup = target.popup;
    gesture.control = target.control;
    gesture.maximum = target.gestureMaximum;
    gesture.updateSequence = inoutNextActionSequence;
    gesture.value = target.value;
    pointerGestures.push_back(PointerGestureRecord(gesture, true));
    outActiveGestureSequence = inoutNextActionSequence;
    ++inoutNextActionSequence;
}

class ContextOwnedTarget{
    public HitTarget target;
    public WidgetRoot root;
}

class ContextOwnedPopup{
    public PopupScope scope;
    public WidgetRoot root;
}

b8 TryRegisterContextPopupScope(
    in WidgetState state,
    in PopupToken currentPopup,
    in PopupScope scope,
    mut Vector<ContextOwnedPopup> popups,
    mut PopupToken outFenceToken
){
    outFenceToken = PopupToken();
    if(
        state.kind != WidgetKind::Popup
        || !scope.token.valid()
        || scope.token.widget != state.id
        || scope.token.declarationGeneration != state.declarationGeneration
        || scope.parent != currentPopup
        || popups.size() == s_InputMaxPopups
        || !HasValidPopupScopeGeometry(scope)
    )
        return false;
    for(in ContextOwnedPopup previous : popups){
        if(previous.scope.token.widget == scope.token.widget)
            return false;
    }
    PopupScope admitted = scope;
    if(popups.empty())
        admitted.layer = 1u;
    else
        admitted.layer = popups.back().scope.layer + 1u;
    ContextOwnedPopup owned;
    owned.scope = admitted;
    owned.root = state.root;
    popups.push_back(owned);
    outFenceToken = admitted.token;
    return true;
}

b8 TryActivateContextPopupScope(
    in PopupToken token,
    in WidgetRoot root,
    in PopupToken currentPopup,
    in Span<ContextOwnedPopup> popups,
    mut Array<PopupToken, s_InputMaxPopups> popupStack,
    mut usize inOutPopupDepth,
    mut PopupToken outCurrentPopup,
    mut u32 outPopupLayer
){
    if(!token.valid() || inOutPopupDepth == s_InputMaxPopups)
        return false;
    for(in ContextOwnedPopup owned : popups){
        if(owned.scope.token != token)
            continue;
        if(owned.root != root || owned.scope.parent != currentPopup)
            return false;
        popupStack[inOutPopupDepth] = token;
        ++inOutPopupDepth;
        outCurrentPopup = token;
        outPopupLayer = owned.scope.layer;
        return true;
    }
    return false;
}

b8 TryUpdateContextPopupScope(
    in PopupToken token,
    in WidgetRoot root,
    in PopupScope scope,
    mut Vector<ContextOwnedPopup> popups
){
    if(!token.valid() || scope.token != token || !HasValidPopupScopeGeometry(scope))
        return false;
    for(usize index = 0u; index < popups.size(); ++index){
        const ContextOwnedPopup owned = popups[index];
        if(owned.scope.token != token)
            continue;
        if(owned.root != root || scope.parent != owned.scope.parent || (scope.layer != 0u && scope.layer != owned.scope.layer))
            return false;
        PopupScope updated = scope;
        updated.layer = owned.scope.layer;
        popups[index].scope = updated;
        return true;
    }
    return false;
}

u32 ResolveContextPopupLayer(in Span<ContextOwnedPopup> popups, in PopupToken token){
    for(in ContextOwnedPopup owned : popups){
        if(owned.scope.token == token)
            return owned.scope.layer;
    }
    return 0u;
}

b8 TryEndContextPopupScope(
    in Span<ContextOwnedPopup> popups,
    mut Array<PopupToken, s_InputMaxPopups> popupStack,
    mut usize inOutPopupDepth,
    mut PopupToken inOutCurrentPopup,
    mut u32 outPopupLayer,
    mut PopupToken outEndedToken
){
    outEndedToken = PopupToken();
    if(inOutPopupDepth == 0u || !inOutCurrentPopup.valid())
        return false;
    outEndedToken = inOutCurrentPopup;
    --inOutPopupDepth;
    popupStack[inOutPopupDepth] = PopupToken();
    if(inOutPopupDepth == 0u)
        inOutCurrentPopup = PopupToken();
    else
        inOutCurrentPopup = popupStack[inOutPopupDepth - 1u];
    outPopupLayer = ResolveContextPopupLayer(popups, inOutCurrentPopup);
    return true;
}

b8 DiscardContextPopupScope(
    in PopupToken token,
    in Array<PopupToken, s_InputMaxPopups> popupStack,
    in usize popupDepth,
    mut Vector<ContextOwnedTarget> targets,
    mut Vector<ContextOwnedPopup> popups,
    mut b8 outRemovedAny
){
    outRemovedAny = false;
    Array<b8, s_InputMaxPopups> removed;
    b8 found = false;
    for(usize index = 0u; index < popups.size(); ++index){
        b8 isRemoved = popups[index].scope.token == token;
        for(usize ancestor = 0u; ancestor < index && !isRemoved; ++ancestor)
            isRemoved = removed[ancestor] && popups[index].scope.parent == popups[ancestor].scope.token;
        removed[index] = isRemoved;
        found = found || isRemoved;
    }
    if(!found)
        return true;
    for(usize active = 0u; active < popupDepth; ++active){
        const PopupToken activeToken = popupStack[active];
        for(usize popup = 0u; popup < popups.size(); ++popup){
            if(removed[popup] && activeToken == popups[popup].scope.token)
                return false;
        }
    }
    usize keptTargets = 0u;
    for(usize index = 0u; index < targets.size(); ++index){
        const PopupToken targetPopup = targets[index].target.popup;
        b8 removeTarget = false;
        for(usize popup = 0u; popup < popups.size(); ++popup){
            if(removed[popup] && targetPopup == popups[popup].scope.token){
                removeTarget = true;
                break;
            }
        }
        if(!removeTarget){
            if(keptTargets != index)
                targets[keptTargets] = targets[index];
            ++keptTargets;
        }
    }
    targets.resize(keptTargets);
    usize keptPopups = 0u;
    for(usize index = 0u; index < popups.size(); ++index){
        if(!removed[index]){
            if(keptPopups != index)
                popups[keptPopups] = popups[index];
            ++keptPopups;
        }
    }
    popups.resize(keptPopups);
    outRemovedAny = true;
    return true;
}

b8 TryUpdateRouterPointerGesture(
    in Point position,
    in b8 completed,
    mut Vector<PointerGestureRecord> pointerGestures,
    mut u64 inOutActiveGestureSequence,
    mut u64 inOutNextActionSequence
){
    if(inOutActiveGestureSequence == 0u)
        return true;
    for(usize index = 0u; index < pointerGestures.size(); ++index){
        PointerGestureRecord record = pointerGestures[index];
        if(record.gesture.id.sequence != inOutActiveGestureSequence)
            continue;
        if(completed || record.gesture.position.x != position.x || record.gesture.position.y != position.y){
            if(inOutNextActionSequence == 0u)
                return false;
            record.gesture.position = position;
            if(completed)
                record.gesture.state = PointerGestureState::Completed;
            else
                record.gesture.state = PointerGestureState::Active;
            record.gesture.updateSequence = inOutNextActionSequence;
            ++inOutNextActionSequence;
            record.pendingUpdate = true;
            pointerGestures[index] = record;
        }
        break;
    }
    if(completed)
        inOutActiveGestureSequence = 0u;
    return true;
}

void AppendRouterActivation(
    in HitTarget target,
    in u64 layoutGeneration,
    in InputActionSource origin,
    in InputSource inputSource,
    mut Vector<InputAction> actions,
    mut u64 inOutNextActionSequence,
    mut InputRoutingResult inOutResult
){
    if(actions.size() == s_InputMaxActions || inOutNextActionSequence == 0u){
        inOutResult.activationOverflow = true;
        return;
    }
    InputAction action;
    action.id.target = target.id;
    action.id.declarationGeneration = target.declarationGeneration;
    action.id.layoutGeneration = layoutGeneration;
    action.id.sequence = inOutNextActionSequence;
    action.origin = origin;
    action.popup = target.popup;
    action.control = target.control;
    action.inputSource = inputSource;
    actions.push_back(action);
    ++inOutNextActionSequence;
}

void AppendRouterContextMenu(
    in HitTarget target,
    in u64 layoutGeneration,
    in Point position,
    in InputActionSource origin,
    in InputSource inputSource,
    mut Vector<ContextMenuAction> contextMenuActions,
    mut u64 inOutNextActionSequence,
    mut InputRoutingResult inOutResult
){
    if(contextMenuActions.size() == s_InputMaxContextMenuActions || inOutNextActionSequence == 0u){
        inOutResult.activationOverflow = true;
        return;
    }
    ContextMenuAction action;
    action.id.target = target.id;
    action.id.declarationGeneration = target.declarationGeneration;
    action.id.layoutGeneration = layoutGeneration;
    action.id.sequence = inOutNextActionSequence;
    action.popup = target.popup;
    action.control = target.control;
    action.position = position;
    action.origin = origin;
    action.inputSource = inputSource;
    contextMenuActions.push_back(action);
    ++inOutNextActionSequence;
}

b8 TryRouteRouterContextMenuCommand(
    in InputEvent event,
    in HitTarget focused,
    in b8 alreadyPressed,
    mut CommandSource inOutSource
){
    if(event.command != InputCommand::ContextMenu || !focused.contextMenu)
        return false;
    if(!alreadyPressed && !event.repeat){
        inOutSource.contextArmed = true;
        inOutSource.contextPosition = Point(focused.rectangle.x, focused.rectangle.y + focused.rectangle.height);
    }
    return true;
}

void AppendRouterControlAction(
    in HitTarget host,
    in HitTarget source,
    in u64 layoutGeneration,
    in ControlActionKind kind,
    in f64 delta,
    in f64 deltaX,
    mut Vector<ControlAction> controlActions,
    mut u64 inOutNextActionSequence,
    mut InputRoutingResult inOutResult
){
    if(controlActions.size() == s_InputMaxControlActions || inOutNextActionSequence == 0u){
        inOutResult.activationOverflow = true;
        return;
    }
    ControlAction action;
    action.id.target = host.id;
    action.id.declarationGeneration = host.declarationGeneration;
    action.id.layoutGeneration = layoutGeneration;
    action.id.sequence = inOutNextActionSequence;
    action.source = source.id;
    action.popup = host.popup;
    action.control = host.control;
    action.kind = kind;
    action.delta = delta;
    action.value = source.value;
    action.step = host.scrollStep;
    action.pageRows = host.pageRows;
    action.maximum = host.gestureMaximum;
    action.sourceDeclarationGeneration = source.declarationGeneration;
    action.sourceControl = source.control;
    action.deltaX = deltaX;
    action.stepX = host.scrollStepX;
    action.maximumX = host.gestureMaximumX;
    controlActions.push_back(action);
    ++inOutNextActionSequence;
}

void CloseRouterPopupSubtree(in PopupToken token, mut Vector<PopupRecord> popups){
    for(usize index = 0u; index < popups.size(); ++index){
        if(IsPopupTokenDescendant(popups, popups[index].scope.token, token))
            popups[index].closing = true;
    }
}

void CancelRouterPopupFocus(mut Vector<PopupRecord> popups, mut Vector<PopupDismissal> popupDismissals){
    for(usize index = 0u; index < popups.size(); ++index){
        popups[index].restoreFocus = WidgetId();
        popups[index].restoreDeclaration = 0u;
        popups[index].restorePopup = PopupToken();
        if(popups[index].closing)
            continue;
        if(popupDismissals.size() < s_InputMaxPopups){
            PopupDismissal dismissal;
            dismissal.token = popups[index].scope.token;
            dismissal.reason = PopupDismissReason::FocusLost;
            popupDismissals.push_back(dismissal);
        }
        popups[index].closing = true;
    }
}


