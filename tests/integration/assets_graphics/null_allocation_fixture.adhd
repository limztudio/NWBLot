[cpp_header("<tests/integration/assets_graphics/cook_tool_sdk.h>"), cpp_name("::NWB::Tests::GraphicsCookToolSdk::NullAllocation"), cpp_flags(polymorphic_base)]
extern class NullAllocation;
[cpp_header("<tests/integration/assets_graphics/cook_tool_sdk.h>"), cpp_name("::NWB::Tests::GraphicsCookToolSdk::RegisterBucket")]
extern b8 RegisterTestCookBucket<Bucket>(mut CookEntryRegistry registry, in Name type);

type NullAllocatedCodec = NameProbeCodec<NullAllocatedAsset>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class NullAllocationState{
    public u32 constructors = 0u;
    public b8 loaded = false;
}

class ConstructorMarker{
    public ConstructorMarker(){
        mut NullAllocationState state = TestProcessValue<NullAllocationState>();
        ++state.constructors;
    }
}

[asset("tests/metadata_registry/null_allocation")]
class NullAllocatedAsset : NullAllocation{
    private ConstructorMarker m_marker;
    public b8 loadBinary(in Span<u8> bytes){
        TestProcessValue<NullAllocationState>().loaded = true;
        return true;
    }
}

class NullAllocatedBucket : ICookEntryBucket, NullAllocation{
    public NullAllocatedBucket(mut GlobalAllocator storage){}
    public usize size()const override{ return 0u; }
    public b8 parseDocument(in GlobalPath root, in StringView virtualRoot, in GlobalPath path, in MetascriptDocument document, mut CookEntryParseContext context)override{ return false; }
    public b8 parseValue(in Name path, in GlobalPath file, in MetascriptValue value, mut CookEntryParseContext context)override{ return false; }
    public b8 writeCookedAssets(mut CookEntryWriteContext context)override{ return false; }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 SerializeNullAllocatedAsset(in NullAllocatedAsset asset, mut Vector<u8> bytes){ return false; }


