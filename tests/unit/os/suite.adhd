void VerifyTextInputSelection_ReverseSelectionHasTheSameOuterByteLimits(){
    SelectionTextInputContext ctx = SelectionTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> begun = ctx.service.begin(MakeSessionDesc("abcDEFghi", 6u, 3u));
    ASSERT_TRUE(begun.has_value());
    const TextInputSessionToken token = begun.value();
    const u64 revision = ctx.service.surroundingRevision(token);
    EXPECT_EQ(ctx.service.emitDeleteSurrounding(token, 4u, 0u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.emitDeleteSurrounding(token, 0u, 4u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::InvalidRange);
    ASSERT_EQ(ctx.service.emitDeleteSurrounding(token, 3u, 3u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.deleteBeforeBytes, 3u);
    EXPECT_EQ(ctx.event.deleteAfterBytes, 3u);
    EXPECT_EQ(ctx.event.deletionBasis, TextInputDeletionBasis::Selection);
    EXPECT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Pending);
}

void VerifyTextInputSelection_UnknownBasisAndMissingOrStaleRevisionDoNotQueueAnyEvent(){
    SelectionTextInputContext ctx = SelectionTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> begun = ctx.service.begin(MakeSessionDesc("abcDEFghi", 3u, 6u));
    ASSERT_TRUE(begun.has_value());
    const TextInputSessionToken token = begun.value();
    const u64 revision = ctx.service.surroundingRevision(token);
    ASSERT_EQ(ctx.service.updateSurrounding(token, "abcDEFghi", 3u, 6u), TextInputAdmission::Accepted);
    const u64 currentRevision = ctx.service.surroundingRevision(token);
    EXPECT_EQ(ctx.service.emitDeleteSurrounding(token, 2u, 1u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.emitDeleteSurrounding(token, 2u, 1u, 0u, TextInputDeletionBasis::Selection), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.emitDeleteSurrounding(token, 0u, 0u, currentRevision, MakeInvalidDeletionBasis()), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Pending);
    EXPECT_EQ(ctx.service.activeSession(), token);
    ASSERT_EQ(ctx.service.emitDeleteSurrounding(token, 2u, 1u, currentRevision, TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.surroundingRevision, currentRevision);
    EXPECT_EQ(ctx.event.deletionBasis, TextInputDeletionBasis::Selection);
    EXPECT_EQ(ctx.event.deleteBeforeBytes, 2u);
    EXPECT_EQ(ctx.event.deleteAfterBytes, 1u);
    EXPECT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Pending);
}

void VerifyTextInputSelection_OuterUtf8EndpointsMustRemainScalarBoundaries(){
    SelectionTextInputContext ctx = SelectionTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> begun = ctx.service.begin(MakeSessionDesc("a\xED\x95\x9C\x44\x45\x46\xEA\xB8\x80z", 4u, 7u));
    ASSERT_TRUE(begun.has_value());
    const TextInputSessionToken token = begun.value();
    const u64 revision = ctx.service.surroundingRevision(token);
    EXPECT_EQ(ctx.service.emitDeleteSurrounding(token, 1u, 0u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.emitDeleteSurrounding(token, 0u, 1u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::InvalidRange);
    ASSERT_EQ(ctx.service.emitDeleteSurrounding(token, 3u, 3u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.deleteBeforeBytes, 3u);
    EXPECT_EQ(ctx.event.deleteAfterBytes, 3u);
}

void VerifyTextInputSelection_PollCopiesTheBasisAndNonDeletionEventsResetAReusedOutput(){
    StandaloneTextInputEvent out = StandaloneTextInputEvent();
    TextInputSessionToken token = TextInputSessionToken();
    {
        SelectionTextInputContext ctx = SelectionTextInputContext();
        ASSERT_TRUE(ctx.service.setFocused(true));
        const Expected<TextInputSessionToken, TextInputAdmissionEnum> begun = ctx.service.begin(MakeSessionDesc("abcDEFghi", 3u, 6u));
        ASSERT_TRUE(begun.has_value());
        token = begun.value();
        const u64 revision = ctx.service.surroundingRevision(token);
        ASSERT_EQ(ctx.service.emitDeleteSurrounding(token, 2u, 1u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
        ASSERT_EQ(ctx.service.poll(token, out.event), TextInputPollResult::Event);
        EXPECT_EQ(out.event.deletionBasis, TextInputDeletionBasis::Selection);
        ASSERT_EQ(ctx.service.emitCommit(token, "X"), TextInputAdmission::Accepted);
        ASSERT_EQ(ctx.service.poll(token, out.event), TextInputPollResult::Event);
        EXPECT_EQ(out.event.deletionBasis, TextInputDeletionBasis::Caret);
        ASSERT_EQ(ctx.service.emitDeleteSurrounding(token, 0u, 0u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
        ASSERT_EQ(ctx.service.poll(token, out.event), TextInputPollResult::Event);
        ASSERT_TRUE(ctx.service.end(token));
    }
    EXPECT_EQ(out.event.token, token);
    EXPECT_EQ(out.event.kind, TextInputEventKind::DeleteSurrounding);
    EXPECT_EQ(out.event.deletionBasis, TextInputDeletionBasis::Selection);
    EXPECT_EQ(out.event.deleteBeforeBytes, 0u);
    EXPECT_EQ(out.event.deleteAfterBytes, 0u);
}

void VerifyTextInputSelection_DeletionPreservesThePreeditCommitOrderingBarrier(){
    SelectionTextInputContext ctx = SelectionTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> begun = ctx.service.begin(MakeSessionDesc("abcDEFghi", 3u, 6u));
    ASSERT_TRUE(begun.has_value());
    const TextInputSessionToken token = begun.value();
    const u64 revision = ctx.service.surroundingRevision(token);
    ASSERT_EQ(ctx.service.emitPreedit(token, StringView(), 0u, 0u), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.emitDeleteSurrounding(token, 2u, 1u, revision, TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.emitCommit(token, "X"), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.emitPreedit(token, "next", 0u, 4u), TextInputAdmission::Accepted);

    FixedVector<TextInputEventKindEnum, 4> kinds = FixedVector<TextInputEventKindEnum, 4>();
    kinds.push_back(TextInputEventKind::Preedit);
    kinds.push_back(TextInputEventKind::DeleteSurrounding);
    kinds.push_back(TextInputEventKind::Commit);
    kinds.push_back(TextInputEventKind::Preedit);

    u64 previousSequence = 0u;
    for(in TextInputEventKindEnum kind : kinds){
        ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
        EXPECT_EQ(ctx.event.kind, kind);
        EXPECT_GT(ctx.event.sequence, previousSequence);
        TextInputDeletionBasisEnum expectedBasis = TextInputDeletionBasis::Caret;
        if(kind == TextInputEventKind::DeleteSurrounding){
            expectedBasis = TextInputDeletionBasis::Selection;
        }
        EXPECT_EQ(ctx.event.deletionBasis, expectedBasis);
        previousSequence = ctx.event.sequence;
    }
    EXPECT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Pending);
}


