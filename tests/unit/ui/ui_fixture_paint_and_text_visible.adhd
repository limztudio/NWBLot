[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <tests/unit/ui/name_cases.adhd.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace UiPaintImageTests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace UiWidgetTests;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ExpectSameImagePaint(const DrawSnapshot& actual, const DrawSnapshot& expected){
    ::__hidden_ui_glyph_sdf_tests::ExpectUiSameSnapshotHeader(actual, expected);
    ASSERT_EQ(actual.textureImages().size(), expected.textureImages().size());
    for(usize index = 0u; index < actual.textureImages().size(); ++index){
        ASSERT_TRUE(actual.textureImages()[index]);
        ASSERT_TRUE(expected.textureImages()[index]);
        const ImageSource& a = *actual.textureImages()[index];
        const ImageSource& e = *expected.textureImages()[index];
        EXPECT_EQ(actual.textureImages()[index].get(), expected.textureImages()[index].get());
        EXPECT_EQ(a.identity(), e.identity());
        EXPECT_EQ(a.generation(), e.generation());
        EXPECT_EQ(a.texture().virtualPath(), e.texture().virtualPath());
        EXPECT_EQ(a.texture().width(), e.texture().width());
        EXPECT_EQ(a.texture().height(), e.texture().height());
        EXPECT_EQ(a.texture().dimension(), e.texture().dimension());
        EXPECT_EQ(a.texture().depth(), e.texture().depth());
        EXPECT_EQ(a.texture().payloadFormat(), e.texture().payloadFormat());
        EXPECT_EQ(a.texture().alphaMode(), e.texture().alphaMode());
        EXPECT_EQ(a.texture().alphaConstantUnorm8(), e.texture().alphaConstantUnorm8());
        EXPECT_EQ(a.texture().payloadBytes(), e.texture().payloadBytes());
        ASSERT_EQ(a.texture().mipLevels().size(), e.texture().mipLevels().size());
        for(usize mipIndex = 0u; mipIndex < a.texture().mipLevels().size(); ++mipIndex){
            const TextureMipLevel& am = a.texture().mipLevels()[mipIndex];
            const TextureMipLevel& em = e.texture().mipLevels()[mipIndex];
            EXPECT_EQ(am.width, em.width);
            EXPECT_EQ(am.height, em.height);
            EXPECT_EQ(am.blockCountX, em.blockCountX);
            EXPECT_EQ(am.blockCountY, em.blockCountY);
            EXPECT_EQ(am.offsetBytes, em.offsetBytes);
            EXPECT_EQ(am.sizeBytes, em.sizeBytes);
            EXPECT_EQ(am.sliceCount, em.sliceCount);
        }
    }
    UiPaintAssertions::ExpectSamePaint(actual, expected);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


PaintImageFixture::PaintImageFixture()
    : m_arena(Name(NWB::Tests::UiCases::s_UiCaseTestsUiPaintImage))
    , m_skin(m_arena, Name(s_TestSkinPath))
    , m_builder(m_arena)
{
    UiSkin::RegionVector regions(m_arena);
    regions.push_back({ Name(NWB::Tests::UiCases::s_UiCaseSprite), { 0u, 0u, 8u, 8u }, {}, {}, 0.0f, 0.0f, UiSkinDrawMode::Sprite });
    m_skin.setAtlas(Core::Assets::AssetRef<Texture>("tests/ui/skin_texture"), 16u, 16u, 1.0f, Move(regions));
    beginPaint(m_builder);
}

void PaintImageFixture::beginPaint(PaintBuilder& builder, const u64 generation){
    builder.begin({ 200.0f, 100.0f, 1.25f, 1.5f }, generation, 3u, Core::Assets::AssetRef<UiSkin>(s_TestSkinPath), m_skin);
    builder.reserve(16u);
}

Expected<SharedGlyphPage> PaintImageFixture::makeGlyph(const u64 atlasIdentity, const u64 generation){
    return UiPaintTextTests::MakeTestGlyphPage(m_arena, atlasIdentity, generation);
}

Expected<SharedSdfAtlasPage> PaintImageFixture::makeSdf(const u64 atlasIdentity){
    return UiPaintTextTests::MakeTestSdfAtlasPage(m_arena, atlasIdentity);
}

Expected<SharedImageSource> PaintImageFixture::makeImage(const StringView path, const u8 seed, const u32 width, const u32 height){
    if(path.empty() || width == 0u || height == 0u)
        return MakeUnexpected(Failure{});
    return UiFixtureSupport::MakeSeededImage(path, seed, width, height, m_arena);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace UiPaintTextTests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


constexpr AStringView s_PaintTextSkinPath = "tests/ui/skin";
constexpr AStringView s_PaintTextFontPath = "tests/ui/font";

void PaintTextFixture::ExpectClippedQuad(const DrawSnapshot& snapshot){
    ::__hidden_ui_glyph_sdf_tests::ExpectClippedPaintTextQuad(snapshot);
}

PaintTextFixture::PaintTextFixture()
    : m_arena(Name(NWB::Tests::UiCases::s_UiCaseTestsUiPaintText))
    , m_skin(m_arena, Name(s_PaintTextSkinPath))
    , m_builder(m_arena)
{
    UiSkin::RegionVector regions(m_arena);
    regions.push_back({ Name(NWB::Tests::UiCases::s_UiCaseSprite), { 0u, 0u, 8u, 8u }, {}, {}, 0.0f, 0.0f, UiSkinDrawMode::Sprite });
    m_skin.setAtlas(Core::Assets::AssetRef<Texture>("tests/ui/texture"), 16u, 16u, 1.0f, Move(regions));
    begin(7u);
}

void PaintTextFixture::begin(const u64 generation){
    m_builder.begin({ 100.0f, 80.0f, 1.5f, 2.0f }, generation, 3u, Core::Assets::AssetRef<UiSkin>(s_PaintTextSkinPath), m_skin);
    m_builder.reserve(16u);
}

Expected<SharedGlyphPage> PaintTextFixture::makeCoverage(const u64 atlasIdentity, const u64 generation){
    GlyphPage::Pixels pixels(m_arena);
    pixels.resize(4u, 128u);
    const GlyphPageBinding binding{ .font = Core::Assets::AssetRef<Font>(s_PaintTextFontPath), .fontGeneration = 9u, .atlasIdentity = atlasIdentity, .generation = generation, .width = 2u, .height = 2u };
    return CreateGlyphPage(m_arena, binding, Move(pixels));
}

Expected<SharedGlyphPage> MakeTestGlyphPage(Core::Alloc::GlobalArena& arena, const u64 atlasIdentity, const u64 generation, const u32 index){
    GlyphPage::Pixels pixels(arena);
    pixels.resize(64u, 0u);
    pixels[0] = 64u;
    if(generation > 1u)
        pixels[32] = 192u;
    const GlyphPageBinding binding{ .font = Core::Assets::AssetRef<Font>(s_PaintTextFontPath), .fontGeneration = 9u, .atlasIdentity = atlasIdentity, .generation = generation, .index = index, .width = 8u, .height = 8u };
    return CreateGlyphPage(arena, binding, Move(pixels));
}

Expected<SharedSdfAtlasPage> MakeTestSdfAtlasPage(Core::Alloc::GlobalArena& arena, const u64 atlasIdentity, const u64 generation, const u32 index, const u8 interior){
    SdfAtlasPage::Pixels pixels(arena);
    pixels.resize(8u * 8u * 4u, 0u);
    pixels[0u] = 32u;
    pixels[1u] = 128u;
    pixels[2u] = interior;
    pixels[3u] = 192u;
    const SdfAtlasPageBinding binding{
        .font = Core::Assets::AssetRef<Font>(s_PaintTextFontPath),
        .fontGeneration = 9u,
        .atlasIdentity = atlasIdentity,
        .generation = generation,
        .index = index,
        .width = 8u,
        .height = 8u,
        .spreadPixels = 8u,
    };
    return CreateSdfAtlasPage(arena, binding, Move(pixels));
}

Expected<SharedGlyphPage> PaintTextFixture::makeGlyphPage(const u64 atlasIdentity, const u64 generation, const u32 index){
    return MakeTestGlyphPage(m_arena, atlasIdentity, generation, index);
}

Expected<SharedSdfAtlasPage> PaintTextFixture::makeDistance(){
    SdfAtlasPage::Pixels pixels(m_arena);
    pixels.resize(4u * 4u * 4u, 128u);
    const SdfAtlasPageBinding binding{ .font = Core::Assets::AssetRef<Font>(s_PaintTextFontPath), .fontGeneration = 9u, .atlasIdentity = 22u, .generation = 1u, .width = 4u, .height = 4u, .spreadPixels = 2u };
    return CreateSdfAtlasPage(m_arena, binding, Move(pixels));
}

Expected<SharedSdfAtlasPage> PaintTextFixture::makeSdfPage(const u64 atlasIdentity, const u64 generation, const u32 index, const u8 interior){
    return MakeTestSdfAtlasPage(m_arena, atlasIdentity, generation, index, interior);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace UiTextVisibleTests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Rect TextVisibleFixture::OutlineRectangle(const PlacedGlyph& glyph, const Point origin)noexcept{
    return ::__hidden_ui_glyph_sdf_tests::ComputePlacedGlyphOutlineRect(glyph, origin);
}

TextVisibleFixture::TextVisibleFixture()
    : m_arena(Name(NWB::Tests::UiCases::s_UiCaseTestsUiTextVisible))
    , m_latin(m_arena, Name(s_TestLatinFontPath))
    , m_korean(m_arena, Name(s_TestKoreanFontPath))
    , m_text(m_arena)
    , m_layout(m_arena)
    , m_skin(m_arena, Name(s_TestSkinPath))
    , m_paint(m_arena)
{}

void TextVisibleFixture::SetUp(){
    ASSERT_TRUE(loadFont("latin.font", m_latin));
    ASSERT_TRUE(loadFont("korean.font", m_korean));
    ASSERT_TRUE(installCoverageFonts());
    UiSkin::RegionVector regions(m_arena);
    m_skin.setAtlas(Core::Assets::AssetRef<Texture>("tests/ui/texture"), 4u, 4u, 1.0f, Move(regions));
}

b8 TextVisibleFixture::loadFont(const StringView filename, Font& font){
    return UiWidgetTests::LoadBundledFixtureFont(m_arena, filename, font);
}

b8 TextVisibleFixture::installCoverageFonts(){
    Core::Alloc::ScratchArena fontScratchArena(UiWidgetTests::s_FontScratchArenaName);
    const Array<FontSource, 2u> sources = {
        FontSource{ Core::Assets::AssetRef<Font>(s_TestLatinFontPath), m_latin, 1u },
        FontSource{ Core::Assets::AssetRef<Font>(s_TestKoreanFontPath), m_korean, 1u },
    };
    return m_text.setFonts(fontScratchArena, sources);
}

void TextVisibleFixture::beginPaint(const u64 generation, const DisplayMetrics& display){
    m_paint.begin(display, generation, 1u, Core::Assets::AssetRef<UiSkin>(s_TestSkinPath), m_skin);
}

Expected<SharedGlyphPage> TextVisibleFixture::makePage(const u64 atlasIdentity){
    GlyphPage::Pixels pixels(m_arena);
    pixels.resize(64u, 128u);
    const GlyphPageBinding binding{ .font = Core::Assets::AssetRef<Font>("tests/ui/independent_font"), .fontGeneration = 1u, .atlasIdentity = atlasIdentity, .generation = 1u, .index = 0u, .width = 8u, .height = 8u };
    return CreateGlyphPage(m_arena, binding, Move(pixels));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


