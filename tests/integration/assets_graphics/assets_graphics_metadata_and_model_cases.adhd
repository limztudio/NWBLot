void VerifyAssetsGraphics_MeshletScoreRetainsOrderingAtFloatPrecisionBoundary(){
    const f32 farther = EvaluateMeshletCandidateScore(1u, 1u, 0.25f, 16777216.0f, 0.0f, 0.0f, false);
    const f32 nearer = EvaluateMeshletCandidateScore(1u, 1u, 0.25f, 16777215.0f, 0.0f, 0.0f, false);
    EXPECT_LT(farther, nearer);
}

