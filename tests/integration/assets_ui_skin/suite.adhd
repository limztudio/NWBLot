const StringView s_AtlasPath = "project/ui/atlas";

const StringView s_ErrDuplicateRegion = "duplicate region";
const StringView s_ErrMissingWindowNormal = "missing required region 'window.normal'";
const StringView s_ErrRecookRequired = "recook required";
const StringView s_ErrTrailingBytes = "trailing bytes";
