////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ShaderAssetPolicy{
    public StringView memberSerializeContext()const{ return "ShaderAssetCodec::serialize"; }

    public b8 write(in IShader shader, mut Vector<u8> output)const{
        return SerializeShaderAssetPayload(shader.entryPoint(), shader.bytecode(), output);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<ShaderEntryPointRange> LoadShaderBinaryForStage(in IShader shaderAsset, in Span<u8> binary, in ShaderType shaderType, mut Vector<u8> outBytecode){
    if(!shaderAsset.checkVirtualPath("IShader::loadBinaryForStage"))
        return MakeUnexpected(Failure());

    const Expected<AssetPayloadView, AssetPayloadDecodeFailure> payload = DecodeAssetPayload(binary);
    if(!payload.has_value()){
        ReportShaderAssetPayloadDecodeFailure(payload.error());
        return MakeUnexpected(Failure());
    }

    const Expected<StringView, SpirvEntryPointLookupResult> lookupResult = ResolveSpirvEntryPointName(
        payload.value().bytecode,
        payload.value().entryPoint,
        ShaderType::ToMask(shaderType)
    );
    if(!lookupResult.has_value()){
        error("IShader::loadBinaryForStage failed: entry point '{}' does not match asset type '{}' or SPIR-V is malformed", payload.value().entryPoint, shaderAsset.assetType().resolvedText());
        return MakeUnexpected(Failure());
    }

    const Expected<usize> entryPointOffset = FindBinaryTextOffset(payload.value().bytecode, lookupResult.value());
    if(!entryPointOffset.has_value())
        return MakeUnexpected(Failure());
    const usize entryPointLength = lookupResult.value().size();
    AssignTriviallyCopyableVector(outBytecode, payload.value().bytecode);
    ShaderEntryPointRange entryPoint;
    entryPoint.offset = entryPointOffset.value();
    entryPoint.length = entryPointLength;
    return entryPoint;
}


