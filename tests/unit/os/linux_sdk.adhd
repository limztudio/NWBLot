[cpp_header("<tests/unit/os/linux_sdk.h>"), cpp_name("::Display"), cpp_flags(no_copy, no_assign)]
extern class X11Display;

[cpp_header("<tests/unit/os/linux_sdk.h>"), cpp_name("::XEvent"), cpp_flags(self_defaulted)]
extern class OsXEvent{
    i32 type;
};

[cpp_header("<tests/unit/os/linux_sdk.h>"), cpp_name("::NWB::Tests::OsSdk::DisplayConnection"), cpp_flags(self_defaulted, no_copy, no_assign)]
extern class DisplayConnection{
    b8 open();
    i32 close();
    b8 valid()const;
    mut X11Display display()const;
    i32 pending()const;
    i32 next(mut OsXEvent event);
    b8 checkTyped(in i32 type, mut OsXEvent event);
    u64 atom(...)const;
    u64 rootWindow()const;
    u64 createWindow(in u64 parent, in u32 width, in u32 height);
    void destroyWindow(in u64 window);
    void sync()const;
    void setOwner(in u64 atom, in u64 window, in u64 time);
    u64 owner(in u64 atom)const;
};

[cpp_header("<tests/unit/os/linux_sdk.h>"), cpp_name("::NWB::Core::X11Property"), cpp_flags(no_copy)]
extern class OsX11Property{
