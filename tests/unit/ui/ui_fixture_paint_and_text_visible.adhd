namespace UiTextVisibleTests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace Impl;
using namespace Impl::Ui;
using UiPaintAssertions::ExpectSamePaint;

using UiWidgetTests::s_TestKoreanFontPath;
using UiWidgetTests::s_TestLatinFontPath;
using UiWidgetTests::s_TestSkinPath;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TextVisibleFixture : public testing::Test{
public:
    [[nodiscard]] static Rect OutlineRectangle(const PlacedGlyph& glyph, Point origin)noexcept;
    template<typename Error>
    [[nodiscard]] static b8 AdoptLayoutInto(Expected<TextLayout, Error>& result, TextLayout& out)noexcept{
        if(!result)
            return false;
        out = Move(*result);
        return true;
    }


public:
    TextVisibleFixture()
        : m_arena(Name(NWB::Tests::UiCases::s_UiCaseTestsUiTextVisible))
        , m_latin(m_arena, Name(s_TestLatinFontPath))
        , m_korean(m_arena, Name(s_TestKoreanFontPath))
        , m_text(m_arena)
        , m_layout(m_arena)
        , m_skin(m_arena, Name(s_TestSkinPath))
        , m_paint(m_arena)
    {}


public:
    virtual void SetUp()override{
        ASSERT_TRUE(loadFont("latin.font", m_latin));
        ASSERT_TRUE(loadFont("korean.font", m_korean));
        ASSERT_TRUE(installCoverageFonts());
        UiSkin::RegionVector regions(m_arena);
        m_skin.setAtlas(Core::Assets::AssetRef<Texture>("tests/ui/texture"), 4u, 4u, 1.0f, Move(regions));
    }
    [[nodiscard]] b8 loadFont(const StringView filename, Font& font){
        return UiWidgetTests::LoadBundledFixtureFont(m_arena, filename, font);
    }
    [[nodiscard]] b8 installCoverageFonts(){
        Core::Alloc::ScratchArena fontScratchArena(UiWidgetTests::s_FontScratchArenaName);
        const Array<FontSource, 2u> sources = {
            FontSource{ Core::Assets::AssetRef<Font>(s_TestLatinFontPath), m_latin, 1u },
            FontSource{ Core::Assets::AssetRef<Font>(s_TestKoreanFontPath), m_korean, 1u },
        };
        return m_text.setFonts(fontScratchArena, sources);
    }
    template<typename Error>
    [[nodiscard]] b8 adoptLayout(Expected<TextLayout, Error>& result)noexcept{
        return AdoptLayoutInto(result, m_layout);
    }
    [[nodiscard]] b8 applyLayout(const ShapeRequest& request){
        auto result = m_text.layout(request);
        return adoptLayout(result);
    }
    void beginPaint(u64 generation, const DisplayMetrics& display = { 800.0f, 600.0f, 1.0f, 1.0f });
    [[nodiscard]] Expected<SharedGlyphPage> makePage(const u64 atlasIdentity){
        GlyphPage::Pixels pixels(m_arena);
        pixels.resize(64u, 128u);
        const GlyphPageBinding binding{ .font = Core::Assets::AssetRef<Font>("tests/ui/independent_font"), .fontGeneration = 1u, .atlasIdentity = atlasIdentity, .generation = 1u, .index = 0u, .width = 8u, .height = 8u };
        return CreateGlyphPage(m_arena, binding, Move(pixels));
    }


public:
    Core::Alloc::GlobalArena m_arena;
    Font m_latin;
    Font m_korean;
    TextService m_text;
    TextLayout m_layout;
    UiSkin m_skin;
    PaintBuilder m_paint;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


