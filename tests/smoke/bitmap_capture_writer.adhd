////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_BitmapPixelOffset = s_BitmapFileHeaderSize + s_BitmapInfoHeaderSize;
const u32 s_BitmapMaxSignedDimension = 2147483647u;
const u64 s_BitmapMaxU32Bytes = 4294967295u;
const u8 s_BitmapMagicB = 66u;
const u8 s_BitmapMagicM = 77u;
const u16 s_BitmapPlanes = 1u;
const u16 s_BitmapBitsPerPixel = 24u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void WriteBitmapU16LE(in u16 value, in usize offset, mut Vector<u8> destination){
    const u32 wide = cast<u32>(value);
    destination[offset] = cast<u8>(wide & s_BitmapByteMask);
    destination[offset + 1u] = cast<u8>((wide >> s_BitmapByte1Shift) & s_BitmapByteMask);
}

void WriteBitmapU32LE(in u32 value, in usize offset, mut Vector<u8> destination){
    destination[offset] = cast<u8>(value & s_BitmapByteMask);
    destination[offset + 1u] = cast<u8>((value >> s_BitmapByte1Shift) & s_BitmapByteMask);
    destination[offset + 2u] = cast<u8>((value >> s_BitmapByte2Shift) & s_BitmapByteMask);
    destination[offset + 3u] = cast<u8>((value >> s_BitmapByte3Shift) & s_BitmapByteMask);
}

b8 IsBitmapBgraFormat(in FormatEnum format){
    return format == Format::BGRA8_UNORM || format == Format::BGRA8_UNORM_SRGB;
}

b8 IsSupportedFramebufferSdrFormat(in FormatEnum format){
    return format == Format::RGBA8_UNORM
        || format == Format::RGBA8_UNORM_SRGB
        || format == Format::BGRA8_UNORM
        || format == Format::BGRA8_UNORM_SRGB;
}

class BitmapCaptureWriter{
    public BitmapCaptureWriter(in TextureDesc captureDescription){
        this.m_width = captureDescription.width;
        this.m_height = captureDescription.height;
        this.m_format = captureDescription.format;
    }

    public b8 write(in Path outputPath, in Span<u8> sourceBytes, in usize sourceRowPitch)const{
        const u32 width = this.m_width;
        const u32 height = this.m_height;
        if(width > s_BitmapMaxSignedDimension || height > s_BitmapMaxSignedDimension)
            return false;

        const u64 sourceRowBytes64 = cast<u64>(width) * cast<u64>(s_BitmapSourceBytesPerPixel);
        const u64 bitmapRowBytes64 = cast<u64>(width) * cast<u64>(s_BitmapBytesPerPixel);
        if(sourceRowBytes64 > s_BitmapMaxU32Bytes || bitmapRowBytes64 > s_BitmapMaxU32Bytes - 3u)
            return false;
        if(cast<u64>(sourceRowPitch) < sourceRowBytes64)
            return false;

        const u64 bitmapRowPitch64 = (bitmapRowBytes64 + 3u) & ~cast<u64>(3u);
        const u64 bitmapPixelBytes64 = bitmapRowPitch64 * cast<u64>(height);
        if(bitmapPixelBytes64 > s_BitmapMaxU32Bytes - cast<u64>(s_BitmapPixelOffset))
            return false;

        if(height > 0u){
            const u64 lastRowIndex = cast<u64>(height - 1u);
            const u64 availableBytes = cast<u64>(sourceBytes.size());
            if(availableBytes < sourceRowBytes64)
                return false;
            if(sourceRowPitch > 0u && lastRowIndex > (availableBytes - sourceRowBytes64) / cast<u64>(sourceRowPitch))
                return false;
        }

        const usize bitmapRowPitch = cast<usize>(bitmapRowPitch64);
        const usize bitmapPixelBytes = cast<usize>(bitmapPixelBytes64);
        const usize bitmapFileBytes = s_BitmapPixelOffset + bitmapPixelBytes;

        Vector<u8> bitmapBytes;
        bitmapBytes.resize(bitmapFileBytes);
        bitmapBytes[0u] = s_BitmapMagicB;
        bitmapBytes[1u] = s_BitmapMagicM;
        WriteBitmapU32LE(cast<u32>(bitmapFileBytes), 2u, bitmapBytes);
        WriteBitmapU32LE(cast<u32>(s_BitmapPixelOffset), 10u, bitmapBytes);
        WriteBitmapU32LE(cast<u32>(s_BitmapInfoHeaderSize), s_BitmapFileHeaderSize, bitmapBytes);
        WriteBitmapU32LE(width, 18u, bitmapBytes);
        WriteBitmapU32LE(height, 22u, bitmapBytes);
        WriteBitmapU16LE(s_BitmapPlanes, 26u, bitmapBytes);
        WriteBitmapU16LE(s_BitmapBitsPerPixel, 28u, bitmapBytes);
        WriteBitmapU32LE(cast<u32>(bitmapPixelBytes), 34u, bitmapBytes);

        const b8 sourceIsBgra = IsBitmapBgraFormat(this.m_format);
        for(u32 bitmapY = 0u; bitmapY < height; ++bitmapY){
            const usize sourceY = cast<usize>(height - 1u - bitmapY);
            const usize sourceRowOffset = sourceY * sourceRowPitch;
            const usize bitmapRowOffset = s_BitmapPixelOffset + cast<usize>(bitmapY) * bitmapRowPitch;
            for(u32 x = 0u; x < width; ++x){
                const usize sourcePixel = sourceRowOffset + cast<usize>(x) * s_BitmapSourceBytesPerPixel;
                const usize bitmapPixel = bitmapRowOffset + cast<usize>(x) * s_BitmapBytesPerPixel;
                if(sourceIsBgra){
                    bitmapBytes[bitmapPixel] = sourceBytes[sourcePixel];
                    bitmapBytes[bitmapPixel + 1u] = sourceBytes[sourcePixel + 1u];
                    bitmapBytes[bitmapPixel + 2u] = sourceBytes[sourcePixel + 2u];
                }
                else{
                    bitmapBytes[bitmapPixel] = sourceBytes[sourcePixel + 2u];
                    bitmapBytes[bitmapPixel + 1u] = sourceBytes[sourcePixel + 1u];
                    bitmapBytes[bitmapPixel + 2u] = sourceBytes[sourcePixel];
                }
            }
        }

        const Path outputDirectory = outputPath.parentPath();
        if(!outputDirectory.empty() && !EnsureDirectories(outputDirectory).has_value())
            return false;
        const String partialPathText = StringFormat("{}.partial", outputPath);
        const Path partialPath = Path(StringView(partialPathText));
        if(!WriteBinaryFile(partialPath, bitmapBytes)){
            if(!RemoveFile(partialPath).has_value())
                warning("FramebufferCapture: failed to remove an incomplete partial capture");
            return false;
        }
        if(!RenamePath(partialPath, outputPath).has_value()){
            if(!RemoveFile(partialPath).has_value())
                warning("FramebufferCapture: failed to remove an uncommitted partial capture");
            return false;
        }
        return true;
    }

    private u32 m_width;
    private u32 m_height;
    private FormatEnum m_format;
}


