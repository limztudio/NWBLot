    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 2u));
    EXPECT_FALSE(self.take(1u, target.declarationGeneration).has_value());
    --target.declarationGeneration;
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 3u));
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown)).pointerConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryUp)).pointerConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryUp)).pointerConsumed);
    ASSERT_TRUE(self.take().has_value());
}

