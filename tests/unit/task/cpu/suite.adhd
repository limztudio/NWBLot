    u32 callbacks = 0u;
    i32 result = 0;
    native(mut callbacks, mut result){
        using namespace __hidden_cpu_task_cleanup_tests;
        Atomic<u32> retirements{ 0u };
        result = InvokeTerminalEntry<TerminalTaskError>([&]()->int {
            CpuTaskScheduler scheduler(0u);
