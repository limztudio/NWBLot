#include <impl/ecs_render/caustic/caustic_resolve_state.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[modular]
class CausticActivityResources : NoCopy{
    private mut GraphicsRuntime m_graphics;
    private mut CausticResolveActivitySnapshot m_activity;

    public CausticActivityResources(mut GraphicsRuntime graphics, mut CausticResolveActivitySnapshot activity){
        this.m_graphics = graphics;
        this.m_activity = activity;
    }

    public b8 prepareCausticResolveActivity(in u32 halfWidth, in u32 halfHeight);
    public void releaseCausticResolveActivity();
}


