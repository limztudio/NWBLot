////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize ResolveExpectedAccelStructFinalizeResourceUseCount(in b8 sceneTlasBuildGraphOwned, in usize preparedMeshBlasBuildCount){
    usize tlasCount = 0u;
    if(sceneTlasBuildGraphOwned)
        tlasCount = 1u;
    return tlasCount + preparedMeshBlasBuildCount;
}

b8 ValidateAccelStructFinalizeResourceUses(
    in b8 sceneTlasBuildGraphOwned,
    in b8 sceneTlasValid,
    in usize preparedMeshBlasBuildCount,
    in usize actualUseCount
){
    const usize expectedCount = ResolveExpectedAccelStructFinalizeResourceUseCount(sceneTlasBuildGraphOwned, preparedMeshBlasBuildCount);
    if((sceneTlasBuildGraphOwned && !sceneTlasValid) || actualUseCount != expectedCount){
        warning("RendererSystem: frozen acceleration-structure build has no final-state graph resources");
        return false;
    }
    return true;
}

usize ResolveShadowPrepareResourceUseReserveCount(
    in b8 hasCsgTraceContext,
    in usize shadowTraceGeometryCount,
    in usize softwareBvhBuildStateCount,
    in usize liveMeshBlasGraphStateCount,
    in usize preparedMeshBlasBuildCount
){
    usize csgCount = 0u;
    if(hasCsgTraceContext)
        csgCount = 1u;
    return s_ShadowPrepareResourceUseCapacity
        + csgCount
        + shadowTraceGeometryCount
        + softwareBvhBuildStateCount
        + liveMeshBlasGraphStateCount
        + preparedMeshBlasBuildCount * 2u;
}


