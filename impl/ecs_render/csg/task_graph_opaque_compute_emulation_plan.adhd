#include <impl/ecs_render/csg/renderer_csg_types.adhd>
#include <impl/ecs_render/material/task_graph_opaque_compute_emulation_plan.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateOpaqueCsgReceiverPlanArraySizes(
    in b8 captured,
    in usize drawItemCount,
    in usize outputBufferCount,
    in usize outputLayoutCount,
    in usize regularDrawItemCount,
    in usize regularOutputBufferCount,
    in usize regularOutputLayoutCount
){
    return captured
        && outputBufferCount == drawItemCount
        && outputLayoutCount == drawItemCount
        && regularOutputBufferCount == regularDrawItemCount
        && regularOutputLayoutCount == regularDrawItemCount
    ;
}

class OpaqueCsgReceiverComputeEmulationGraphPlan{
    public Vector<MaterialPassDrawItem> meshDrawItems;
    public Vector<MaterialPassDrawItem> indexedDrawItems;
    public Vector<MaterialPassDrawItem> drawItems;
    public Vector<MaterialPassDrawItem> regularDrawItems;
    public Vector<BufferHandle> outputBuffers;
    public Vector<GeneratedGeometryOutputLayout> outputLayouts;
    public Vector<BufferHandle> regularOutputBuffers;
    public Vector<GeneratedGeometryOutputLayout> regularOutputLayouts;
    public Vector<CsgReceiverRangeGpuData> receiverRanges;
    public Vector<CsgCutterGpuData> cutters;
    public CsgFrameWorkRegion workRegion;
    public b8 captured = false;

    public MaterialPassDrawItemsView drawItemsView()const{
        return MaterialPassDrawItemsView(this.meshDrawItems, this.indexedDrawItems, this.drawItems);
    }
    public CsgFrameGpuDataView csgFrameDataView()const{
        return CsgFrameGpuDataView(this.receiverRanges, this.cutters, this.workRegion);
    }

    public void reset(){
        this.meshDrawItems.clear();
        this.indexedDrawItems.clear();
        this.drawItems.clear();
        this.regularDrawItems.clear();
        this.outputBuffers.clear();
        this.outputLayouts.clear();
        this.regularOutputBuffers.clear();
        this.regularOutputLayouts.clear();
        this.receiverRanges.clear();
        this.cutters.clear();
        this.workRegion = CsgFrameWorkRegion();
        this.captured = false;
    }

    [cpp_unwind]
    public b8 capture(in MaterialPassDrawItemsView receiverSurfaceDrawItems, in MaterialPassDrawItemsView sourceRegularDrawItems, in CsgFrameGpuDataView csgFrameData){
        this.reset();
        if(receiverSurfaceDrawItems.computeDrawItems.empty() || !csgFrameData.hasWork())
            return false;

        this.meshDrawItems.reserve(receiverSurfaceDrawItems.meshDrawItems.size());
        this.meshDrawItems.assign(receiverSurfaceDrawItems.meshDrawItems.begin(), receiverSurfaceDrawItems.meshDrawItems.end());
        this.indexedDrawItems.reserve(receiverSurfaceDrawItems.indexedDrawItems.size());
        this.indexedDrawItems.assign(receiverSurfaceDrawItems.indexedDrawItems.begin(), receiverSurfaceDrawItems.indexedDrawItems.end());
        this.regularDrawItems.reserve(sourceRegularDrawItems.computeDrawItems.size());
        this.regularDrawItems.assign(sourceRegularDrawItems.computeDrawItems.begin(), sourceRegularDrawItems.computeDrawItems.end());
        this.drawItems.reserve(receiverSurfaceDrawItems.computeDrawItems.size());
        this.outputBuffers.reserve(receiverSurfaceDrawItems.computeDrawItems.size());
        this.outputLayouts.reserve(receiverSurfaceDrawItems.computeDrawItems.size());
        this.regularOutputBuffers.reserve(this.regularDrawItems.size());
        this.regularOutputLayouts.reserve(this.regularDrawItems.size());
        MaterialPassEmulationOutputIndex<MaterialEmulationBufferIdentity> outputs;
        for(in MaterialPassDrawItem regularDrawItem : this.regularDrawItems){
            in MaterialPassMeshResourceSnapshot regularMesh = regularDrawItem.mesh();
            if(!regularMesh.emulationVertexBuffer.valid() || !regularMesh.emulationVertexHeapHandle.valid()){
                this.reset();
                return false;
            }
            this.regularOutputBuffers.push_back(regularMesh.emulationVertexBuffer);
            this.regularOutputLayouts.push_back(MakeGeneratedGeometryOutputLayout(regularMesh.emulationIndexByteOffset, regularDrawItem.pipeline().indexedGeometryOutput));
            outputs.insert(MaterialEmulationBufferIdentity(regularMesh.emulationVertexBuffer));
        }
        for(in MaterialPassDrawItem drawItem : receiverSurfaceDrawItems.computeDrawItems){
            if(drawItem.pipelineKey.csgMode == MaterialPipelineCsgMode::None){
                this.reset();
                return false;
            }
            in MaterialPassMeshResourceSnapshot mesh = drawItem.mesh();
            if(!mesh.emulationVertexBuffer.valid() || !mesh.emulationVertexHeapHandle.valid()){
                this.reset();
                return false;
            }
            if(!outputs.insert(MaterialEmulationBufferIdentity(mesh.emulationVertexBuffer))){
                this.reset();
                return false;
            }
            this.drawItems.push_back(drawItem);
            this.outputBuffers.push_back(mesh.emulationVertexBuffer);
            this.outputLayouts.push_back(MakeGeneratedGeometryOutputLayout(mesh.emulationIndexByteOffset, drawItem.pipeline().indexedGeometryOutput));
        }
        this.receiverRanges.reserve(csgFrameData.receiverRanges.size());
        this.receiverRanges.assign(csgFrameData.receiverRanges.begin(), csgFrameData.receiverRanges.end());
        this.cutters.reserve(csgFrameData.cutters.size());
        this.cutters.assign(csgFrameData.cutters.begin(), csgFrameData.cutters.end());
        this.workRegion = csgFrameData.workRegion;
        this.captured = this.drawItems.size() == this.outputBuffers.size() && !this.drawItems.empty();
        return this.captured;
    }

    [cpp_unwind]
    public b8 matches()const{
        if(!ValidateOpaqueCsgReceiverPlanArraySizes(
            this.captured,
            this.drawItems.size(),
            this.outputBuffers.size(),
            this.outputLayouts.size(),
            this.regularDrawItems.size(),
            this.regularOutputBuffers.size(),
            this.regularOutputLayouts.size()
        ))
            return false;
        MaterialPassEmulationOutputIndex<MaterialEmulationBufferIdentity> receiverOutputs;
        for(usize drawIndex = 0u; drawIndex < this.drawItems.size(); ++drawIndex){
            in MaterialPassMeshResourceSnapshot mesh = this.drawItems[drawIndex].mesh();
            if(
                !mesh.emulationVertexBuffer.valid()
                || !mesh.emulationVertexHeapHandle.valid()
                || mesh.emulationVertexBuffer != this.outputBuffers[drawIndex]
                || !this.outputLayouts[drawIndex].matches(mesh.emulationIndexByteOffset, this.drawItems[drawIndex].pipeline().indexedGeometryOutput)
            )
                return false;
            receiverOutputs.insert(MaterialEmulationBufferIdentity(mesh.emulationVertexBuffer));
        }
        for(usize drawIndex = 0u; drawIndex < this.regularDrawItems.size(); ++drawIndex){
            in MaterialPassMeshResourceSnapshot mesh = this.regularDrawItems[drawIndex].mesh();
            if(
                !mesh.emulationVertexBuffer.valid()
                || !mesh.emulationVertexHeapHandle.valid()
                || mesh.emulationVertexBuffer != this.regularOutputBuffers[drawIndex]
                || !this.regularOutputLayouts[drawIndex].matches(mesh.emulationIndexByteOffset, this.regularDrawItems[drawIndex].pipeline().indexedGeometryOutput)
            )
                return false;
            if(receiverOutputs.contains(MaterialEmulationBufferIdentity(mesh.emulationVertexBuffer)))
                return false;
        }
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class OpaqueCsgIntervalSampleComputeEmulationGraphPlan{
    public OpaqueRegularComputeEmulationGraphPlan geometry;
    public Vector<CsgReceiverRangeGpuData> receiverRanges;
    public Vector<CsgCutterGpuData> cutters;
    public CsgFrameWorkRegion workRegion;

    public void reset(){
        this.geometry.reset();
        this.receiverRanges.clear();
        this.cutters.clear();
        this.workRegion = CsgFrameWorkRegion();
    }

    [cpp_unwind]
    public b8 capture(in MaterialPassDrawItemsView draws, in CsgFrameGpuDataView frame){
        this.reset();
        if(!frame.hasWork() || !this.geometry.capture(draws, true))
            return false;
        this.receiverRanges.reserve(frame.receiverRanges.size());
        this.receiverRanges.assign(frame.receiverRanges.begin(), frame.receiverRanges.end());
        this.cutters.reserve(frame.cutters.size());
        this.cutters.assign(frame.cutters.begin(), frame.cutters.end());
        this.workRegion = frame.workRegion;
        return true;
    }

    public CsgFrameGpuDataView csgFrameDataView()const{
        return CsgFrameGpuDataView(this.receiverRanges, this.cutters, this.workRegion);
    }
}


