#include "list_navigation.adhd"
#include <impl/ecs_ui/toolkit/id.adhd>
#include <impl/ecs_ui/toolkit/widgets/popup.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_ComboArrowExtent = 20.0f;
const f32 s_SearchComboQueryHeight = 36.0f;
const Name s_ComboNormalRegionName = "combo.normal";
const Name s_ComboHoverRegionName = "combo.hover";
const Name s_ComboOpenRegionName = "combo.open";
const Name s_ComboFocusedRegionName = "combo.focused";
const Name s_ComboDisabledRegionName = "combo.disabled";
const Name s_ComboArrowRegionName = "combo.arrow";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ComboStyle{
    public Name normal = s_ComboNormalRegionName;
    public Name hover = s_ComboHoverRegionName;
    public Name open = s_ComboOpenRegionName;
    public Name focused = s_ComboFocusedRegionName;
    public Name disabled = s_ComboDisabledRegionName;
    public Name fallback = s_StyleButtonNormalRegionName;
    public Name arrow = s_ComboArrowRegionName;
    public Name arrowFallback = s_StyleWindowCollapseRegionName;
    public Insets padding = Insets(s_StyleSpacingMedium, s_StyleFieldPaddingY, s_StyleSpacingMedium, s_StyleFieldPaddingY);
    public f32 arrowExtent = s_ComboArrowExtent;
    public f32 arrowGap = s_StyleSpacingMedium;
}

class ComboOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public LayoutSize height;
    public f32 popupHeight = s_ListDefaultHeight;
    public f32 wheelRows = s_StyleScrollWheelStep;
    public b8 enabled = true;
    public StringView placeholder = "Select...";
}

class ComboResult{
    public b8 valid = false;
    public b8 selectionChanged = false;
    public b8 committed = false;
    public b8 opened = false;
    public b8 closed = false;
    public b8 focused = false;
}

class SearchComboOptions{
    public ComboOptions combo;
    public f32 queryHeight = s_SearchComboQueryHeight;
    public f32 queryGap = s_StyleSpacingSmall;
}

class SearchComboResult{
    public ComboResult combo;
    public b8 queryChanged = false;
}

class ComboState : NoCopy{
    public ListState m_list;
    public PopupState m_popup;
    public Rect m_bounds;
    public WidgetId m_owner;
    public u64 m_ownerDeclaration = 0u;
    public u64 m_inputGeneration = AllocateServiceIdentity();
    public u64 m_selectedKey = 0u;
    public u64 m_sourceGeneration = 0u;
    public u64 m_sourceRevision = 0u;

    public u64 inputGeneration()const{
        return this.m_inputGeneration;
    }

    public u64 selectedKey()const{
        return this.m_selectedKey;
    }

    public b8 isOpen()const{
        return this.m_popup.isOpen();
    }

    public in PopupPlacement placement()const{
        return this.m_popup.placement();
    }

    public in Rect bounds()const{
        return this.m_bounds;
    }

    public in ListState listState()const{
        return this.m_list;
    }

    public mut ListState listState(){
        return this.m_list;
    }

    public void select(in u64 key){
        this.m_inputGeneration = AllocateServiceIdentity();
        this.m_selectedKey = key;
        this.m_list.select(this.m_selectedKey);
        this.m_popup.close();
    }

    public void open(){
        this.m_inputGeneration = AllocateServiceIdentity();
        this.m_list.select(this.m_selectedKey);
        this.m_popup.close();
        this.m_popup.open();
    }

    public void close(){
        this.m_inputGeneration = AllocateServiceIdentity();
        this.m_list.select(this.m_selectedKey);
        this.m_popup.close();
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<b8> TryBindComboOwner(in WidgetId owner, in u64 declarationGeneration, mut WidgetId inOutOwner, mut u64 inOutOwnerDeclaration){
    if(!owner.valid() || declarationGeneration == 0u)
        return MakeUnexpected(Failure());
    const b8 shouldClose = inOutOwner.valid() && (inOutOwner != owner || inOutOwnerDeclaration != declarationGeneration);
    inOutOwner = owner;
    inOutOwnerDeclaration = declarationGeneration;
    return shouldClose;
}

Name ResolveComboFieldRegionName(in ComboStyle style, in b8 enabled, in b8 open, in b8 focused, in b8 hovered){
    if(!enabled)
        return style.disabled;
    if(open)
        return style.open;
    if(focused)
        return style.focused;
    if(hovered)
        return style.hover;
    return style.normal;
}

void ResolveComboFieldLayout(in Rect bounds, in Insets padding, in f32 arrowExtent, in f32 arrowGap, mut Rect outIcon, mut Rect outTextClip){
    const Rect content = InsetUiRectBounds(bounds, padding);
    const f32 extent = UiSimdMin(arrowExtent, UiSimdMin(content.width, content.height));
    const f32 iconOffsetY = UiSimdMax(0.0f, (content.height - extent) * s_RectCenterFraction);
    const VectorSingle leading = VectorSingle(bounds.x, bounds.y, bounds.x, bounds.y) + VectorSingle(bounds.width, padding.top, bounds.width, padding.top);
    const f32 iconX = (leading.x - padding.right) - extent;
    const f32 iconY = leading.y + iconOffsetY;
    outIcon = Rect(iconX, iconY, extent, extent);
    const VectorSingle textOrigin = VectorSingle(bounds.x, bounds.y, bounds.x, bounds.y) + VectorSingle(padding.left, padding.top, padding.left, padding.top);
    const f32 textX = textOrigin.x;
    const f32 textY = textOrigin.y;
    const f32 textWidth = UiSimdMax(0.0f, (outIcon.x - arrowGap) - textX);
    outTextClip = Rect(textX, textY, textWidth, content.height);
}

b8 IsValidComboDeclarationOptions(in ComboOptions options, in ComboStyle style){
    return
        IsFinite(VectorSingle(options.popupHeight, options.wheelRows, style.arrowExtent, style.arrowGap))
        && options.popupHeight > 0.0f
        && options.wheelRows > 0.0f
        && style.arrowExtent > 0.0f
        && style.arrowGap >= 0.0f
    ;
}

Point ComputeComboFieldIntrinsicSize(in Point minimumSize, in Point measured, in f32 arrowExtent, in f32 arrowGap, in Insets padding){
    const f32 textWidth = (measured.x + arrowExtent) + arrowGap;
    const f32 textHeight = UiSimdMax(measured.y, arrowExtent);
    const VectorSingle padded = (VectorSingle(textWidth, textHeight, textWidth, textHeight) + VectorSingle(padding.left, padding.top, padding.left, padding.top)) + VectorSingle(padding.right, padding.bottom, padding.right, padding.bottom);
    const f32 paddedWidth = padded.x;
    const f32 paddedHeight = padded.y;
    const VectorSingle extent = Max(VectorSingle(minimumSize.x, minimumSize.y, minimumSize.x, minimumSize.y), VectorSingle(paddedWidth, paddedHeight, paddedWidth, paddedHeight));
    return Point(extent.x, extent.y);
}

b8 IsValidSearchComboDeclarationOptions(in SearchComboOptions options){
    return IsFinite(VectorSingle(options.queryHeight, options.queryGap, 0.0f, 0.0f).xy) && options.queryHeight > 0.0f && options.queryGap >= 0.0f;
}

Rect ResolveComboQueryBoxAndAdvanceContent(in f32 measuredHeight, in f32 queryHeight, in f32 queryGap, mut Rect inOutContentRect){
    Rect queryRect = inOutContentRect;
    queryRect.height = UiSimdMin(UiSimdMax(queryHeight, measuredHeight), inOutContentRect.height);
    const f32 extent = UiSimdMin(inOutContentRect.height, queryRect.height + queryGap);
    inOutContentRect.y += extent;
    inOutContentRect.height -= extent;
    return queryRect;
}

b8 MatchesComboFrameStateValues(
    in b8 popupAncestorsVisible,
    in u64 stateInputGeneration,
    in u64 expectedInstanceGeneration,
    in u64 listInputGeneration,
    in u64 expectedListInstanceGeneration,
    in b8 isOpen,
    in b8 expectedOpen,
    in u64 popupInstanceGeneration,
    in u64 expectedPopupInstanceGeneration,
    in u64 popupOpenGeneration,
    in u64 expectedPopupOpenGeneration,
    in PopupToken popupParent,
    in PopupToken expectedParentToken,
    in b8 queryMatches
){
    return popupAncestorsVisible
        && stateInputGeneration == expectedInstanceGeneration
        && listInputGeneration == expectedListInstanceGeneration
        && isOpen == expectedOpen
        && popupInstanceGeneration == expectedPopupInstanceGeneration
        && popupOpenGeneration == expectedPopupOpenGeneration
        && popupParent == expectedParentToken
        && queryMatches;
}

void OpenComboState(mut ComboState state){
    state.m_list.select(state.m_selectedKey);
    state.m_popup.close();
    state.m_popup.open();
}

void CloseComboState(mut ComboState state){
    state.m_list.select(state.m_selectedKey);
    state.m_popup.close();
}

b8 BindComboState(mut ComboState state, in WidgetId owner, in u64 declarationGeneration){
    const Expected<b8> shouldClose = TryBindComboOwner(owner, declarationGeneration, state.m_owner, state.m_ownerDeclaration);
    if(!shouldClose.has_value())
        return false;
    if(shouldClose.value())
        CloseComboState(state);
    return true;
}


