#include "scene_types.adhd"

native{
#include <impl/ecs_csg/components.adhd.h>

#include <core/ecs/entity.h>
#include <core/ecs/world.h>

#include <global/simd/frame.h>

namespace NWB::Tests::Smoke{
using Core::ECS::EntityID;
using Core::ECS::World;
using Impl::CsgCutterComponent;
using Impl::StaticCsgMeshComponent;
using Impl::SkinnedCsgMeshComponent;

template<typename ParameterT>
inline void AssignCsgCutterParameters(const ParameterT& parameters, Impl::CsgCutterComponent& cutter){
    cutter.parameterBytes.resize(sizeof(ParameterT));
    NWB_MEMCPY(cutter.parameterBytes.data(), cutter.parameterBytes.size(), &parameters, sizeof(ParameterT));
}
};
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void AddStaticCsgMeshReceiver(in EntityID entity, in Name receiverGroup, in b8 affectOpaquePass, in b8 affectTransparentPass, mut World world){
    native(in entity, in receiverGroup, in affectOpaquePass, in affectTransparentPass, mut world){
        auto& receiver = world.entity(entity).addComponent<Impl::StaticCsgMeshComponent>();
        receiver.receiverGroup = receiverGroup;
        receiver.affectOpaquePass = affectOpaquePass;
        receiver.affectTransparentPass = affectTransparentPass;
    }
}

void AddSkinnedCsgMeshReceiver(in EntityID entity, in Name receiverGroup, in b8 affectOpaquePass, in b8 affectTransparentPass, mut World world){
    native(in entity, in receiverGroup, in affectOpaquePass, in affectTransparentPass, mut world){
        auto& receiver = world.entity(entity).addComponent<Impl::SkinnedCsgMeshComponent>();
        receiver.receiverGroup = receiverGroup;
        receiver.affectOpaquePass = affectOpaquePass;
        receiver.affectTransparentPass = affectTransparentPass;
    }
}

void AssignCsgCutterTransform(in VectorSingle center, in VectorSingle rotation, mut CsgCutterComponent cutter){
    MatrixSingle worldToShape = MatrixSingle();
    MatrixSingle shapeToWorld = MatrixSingle();
    ComputeCsgCutterTransforms(center, rotation, worldToShape, shapeToWorld);
    cutter.worldToShape = f32x3x4(worldToShape);
    cutter.shapeToWorld = f32x3x4(shapeToWorld);
}


