}

void VerifyAssetsFontMetadata_FieldlessAndEmptyFontDeclarationsRejectNonmapValues(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    MetadataTestArena testArena = MetadataTestArena();
    const Path directory = ScratchRoot("declaration_shape");
    ASSERT_TRUE(PrepareFiles(directory, testArena));
    MetascriptDocument document(testArena.arena);
    ASSERT_TRUE(document.parse("font asset;"));
    MetascriptValue asset(testArena.arena);
    ASSERT_TRUE(CopyDocumentVariable(document, "asset", asset));
    ASSERT_TRUE(asset.isNull());
    const Path path = directory / s_LatinMetadataFilename;
    ASSERT_TRUE(ParseFontCookMetadata(directory, s_FontVirtualRoot, path, document, testArena.arena, testArena.scratchArena).has_value());
    ASSERT_TRUE(MakeDocumentVariableEmptyMap(document, "asset"));
    ASSERT_TRUE(ParseFontCookMetadata(directory, s_FontVirtualRoot, path, document, testArena.arena, testArena.scratchArena).has_value());
    for(u32 caseIndex = 0u; caseIndex < 5u; ++caseIndex){
        MetascriptValue invalid(testArena.arena);
        switch(caseIndex){
        case 0u: invalid.setInteger(0); break;
        case 1u: invalid.setDouble(0.0); break;
        case 2u: invalid.setString(s_FontField); break;
        case 3u: invalid.setReference("asset"); break;
        case 4u: invalid.makeList(); break;
        default: break;
        }
        EXPECT_FALSE(ParseFontCookMetadataValue(s_FontAtlasOtherProject, path, invalid, testArena.arena).has_value());
    }
}

void VerifyAssetsFontMetadata_UnsupportedAndCorruptVisibleMetadataAreRejected(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    MetadataTestArena testArena = MetadataTestArena();
    const Path directory = ScratchRoot("metadata_rejection");
    ASSERT_TRUE(PrepareFiles(directory, testArena));
    MetascriptDocument document(testArena.arena);
    ASSERT_TRUE(LoadMetadata(testArena, document));

    MetascriptValue face(testArena.arena);
    MetascriptValue atlas(testArena.arena);
    ASSERT_TRUE(CopyDocumentVariable(document, s_FaceVariable, face));
    ASSERT_TRUE(CopyDocumentVariable(document, s_AtlasVariable, atlas));
    atlas.field(s_FontField).setString(s_LatinFacePath);
    const Path path = directory / s_LatinMetadataFilename;
    const Expected<FontCookEntry> fontEntryParseResult = ParseFontCookMetadataValue(Name(s_LatinFacePath), path, face, testArena.arena);
    ASSERT_TRUE(fontEntryParseResult.has_value());
    const FontCookEntry fontEntry = fontEntryParseResult.value();
    const Expected<FontAtlasCookEntry> atlasEntryParseResult = ParseFontAtlasCookMetadataValue(Name(s_LatinAtlasPath), path, atlas, testArena.arena, testArena.scratchArena);
    ASSERT_TRUE(atlasEntryParseResult.has_value());
    const FontAtlasCookEntry atlasEntry = atlasEntryParseResult.value();
    ASSERT_TRUE(face.isNull());

    Array<StringView, 3u> fontFields = Array<StringView, 3u>();
    fontFields[0u] = "face_index";
    fontFields[1u] = "units_per_em";
    fontFields[2u] = "glyph_count";
    for(usize index = 0u; index < fontFields.size(); ++index){
        const StringView field = fontFields[index];
        MetascriptValue wrong(face);
        u32 value = atlasEntry.payload.sourceGlyphCount;
        if(field == s_FaceIndexField)
            value = fontEntry.faceIndex;
        else if(field == s_UnitsPerEmField)
            value = atlasEntry.payload.unitsPerEm;
        wrong.field(field).setInteger(cast<i64>(value));
        EXPECT_FALSE(ParseFontCookMetadataValue(s_FontAtlasOtherProject, path, wrong, testArena.arena).has_value());
    }

    Array<StringView, 4u> unsupportedFields = Array<StringView, 4u>();
    unsupportedFields[0u] = "schema_version";
    unsupportedFields[1u] = "source_sha256";
    unsupportedFields[2u] = "source";
    unsupportedFields[3u] = "atlas";
    for(usize index = 0u; index < unsupportedFields.size(); ++index){
        const StringView field = unsupportedFields[index];
        EXPECT_FALSE(HasValueField(atlas, field));
        MetascriptValue wrongFace(face);
        wrongFace.field(field).setString("obsolete");
        EXPECT_FALSE(ParseFontCookMetadataValue(s_FontAtlasOtherProject, path, wrongFace, testArena.arena).has_value());
        MetascriptValue wrongAtlas(atlas);
        wrongAtlas.field(field).setString("obsolete");
        EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, wrongAtlas, testArena.arena, testArena.scratchArena).has_value());
    }

    Array<StringView, 4u> retiredAtlasFields = Array<StringView, 4u>();
    retiredAtlasFields[0u] = "face_index";
    retiredAtlasFields[1u] = "units_per_em";
    retiredAtlasFields[2u] = "glyph_count";
    retiredAtlasFields[3u] = "guard_texels";
    for(usize index = 0u; index < retiredAtlasFields.size(); ++index){
        const StringView field = retiredAtlasFields[index];
        EXPECT_FALSE(HasValueField(atlas, field));
        MetascriptValue wrong(atlas);
        u32 value = atlasEntry.payload.guardTexels;
        if(field == s_FaceIndexField)
            value = atlasEntry.payload.faceIndex;
        else if(field == s_UnitsPerEmField)
            value = atlasEntry.payload.unitsPerEm;
        else if(field == "glyph_count")
            value = atlasEntry.payload.sourceGlyphCount;
        wrong.field(field).setInteger(cast<i64>(value));
        EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, wrong, testArena.arena, testArena.scratchArena).has_value());
    }

    Array<StringView, 2u> atlasSettings = Array<StringView, 2u>();
    atlasSettings[0u] = "bake_ppem";
    atlasSettings[1u] = "spread_pixels";
    for(usize index = 0u; index < atlasSettings.size(); ++index){
        const StringView field = atlasSettings[index];
        MetascriptValue wrong(atlas);
        wrong.field(field).setInteger(-1);
        EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, wrong, testArena.arena, testArena.scratchArena).has_value());
    }

    EXPECT_FALSE(HasValueField(atlas, "groups"));
    MetascriptValue obsoleteGroups(atlas);
    obsoleteGroups.field("groups").setString("obsolete");
    EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, obsoleteGroups, testArena.arena, testArena.scratchArena).has_value());
    MetascriptValue wrongMetric(atlas);
    wrongMetric.field("descender_units").setDouble(s_QuietNaNF64);
    EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, wrongMetric, testArena.arena, testArena.scratchArena).has_value());
    MetascriptValue wrongRaster(atlas);
    wrongRaster.field("raster_mode").setString("automatic");
    EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, wrongRaster, testArena.arena, testArena.scratchArena).has_value());
    MetascriptValue emptyReference(atlas);
    emptyReference.field(s_FontField).setString("");
    EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, emptyReference, testArena.arena, testArena.scratchArena).has_value());
    MetascriptValue unresolvedReference(atlas);
    unresolvedReference.field(s_FontField).setReference(s_FaceVariable);
    EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, unresolvedReference, testArena.arena, testArena.scratchArena).has_value());
}

void VerifyAssetsFontMetadata_IncompleteAndInvalidGlyphMappingsAreRejected(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    MetadataTestArena testArena = MetadataTestArena();
    const Path directory = ScratchRoot("glyph_rejection");
    ASSERT_TRUE(PrepareFiles(directory, testArena));
    MetascriptDocument document(testArena.arena);
    ASSERT_TRUE(LoadMetadata(testArena, document));

    MetascriptValue metadata(testArena.arena);
    ASSERT_TRUE(CopyDocumentVariable(document, s_AtlasVariable, metadata));
    metadata.field(s_FontField).setString(s_LatinFacePath);
    const Path path = directory / s_LatinMetadataFilename;
    const Expected<FontAtlasCookEntry> entryParseResult = ParseFontAtlasCookMetadataValue(Name(s_LatinAtlasPath), path, metadata, testArena.arena, testArena.scratchArena);
    ASSERT_TRUE(entryParseResult.has_value());
    const FontAtlasCookEntry entry = entryParseResult.value();
    const usize originalGlyphCount = entry.payload.glyphs.size();
    ASSERT_GT(originalGlyphCount, 1u);

    MetascriptValue incomplete(metadata);
    incomplete.field(s_GlyphsField).asList().pop_back();
    EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, incomplete, testArena.arena, testArena.scratchArena).has_value());

    MetascriptValue obsoleteId(metadata);
    EXPECT_FALSE(HasValueField(obsoleteId.field(s_GlyphsField).asList()[0u], "id"));
    obsoleteId.field(s_GlyphsField).asList()[0u].field("id").setInteger(0);
    EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, obsoleteId, testArena.arena, testArena.scratchArena).has_value());

    Array<StringView, 6u> integerFields = Array<StringView, 6u>();
    integerFields[0u] = "group";
    integerFields[1u] = "channel";
    integerFields[2u] = "x";
    integerFields[3u] = "y";
    integerFields[4u] = "width";
    integerFields[5u] = "height";
    for(usize index = 0u; index < integerFields.size(); ++index){
        MetascriptValue wrong(metadata);
        wrong.field(s_GlyphsField).asList()[0u].field(integerFields[index]).setInteger(cast<i64>(s_FontAtlasMaxExtent + 1u));
        EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, wrong, testArena.arena, testArena.scratchArena).has_value());
    }

    Array<StringView, 3u> floatFields = Array<StringView, 3u>();
    floatFields[0u] = "plane_left";
    floatFields[1u] = "plane_top";
    floatFields[2u] = "advance_units";
    for(usize index = 0u; index < floatFields.size(); ++index){
        MetascriptValue wrong(metadata);
        wrong.field(s_GlyphsField).asList()[0u].field(floatFields[index]).setDouble(s_InfinityF64);
        EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, wrong, testArena.arena, testArena.scratchArena).has_value());
    }

    Array<StringView, 3u> derivedGlyphFields = Array<StringView, 3u>();
    derivedGlyphFields[0u] = "drawable";
    derivedGlyphFields[1u] = "plane_right";
    derivedGlyphFields[2u] = "plane_bottom";
    for(usize index = 0u; index < derivedGlyphFields.size(); ++index){
        MetascriptValue obsolete(metadata);
        obsolete.field(s_GlyphsField).asList()[0u].field(derivedGlyphFields[index]).setInteger(0);
        EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, obsolete, testArena.arena, testArena.scratchArena).has_value());
    }

    MetascriptValue unknownGlyphField(metadata);
    unknownGlyphField.field(s_GlyphsField).asList()[0u].field("sha256").setString("obsolete");
    EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, unknownGlyphField, testArena.arena, testArena.scratchArena).has_value());

    usize drawableIndex = originalGlyphCount;
    for(usize index = 0u; index < originalGlyphCount; ++index){
        if(entry.payload.glyphs[index].drawable != 0u){
            drawableIndex = index;
            break;
        }
    }
    ASSERT_LT(drawableIndex, originalGlyphCount);
    MetascriptValue wrongChannel(metadata);
    const FontAtlasGlyph drawable = entry.payload.glyphs[drawableIndex];
    wrongChannel.field(s_GlyphsField).asList()[drawableIndex].field("channel").setInteger(cast<i64>(entry.payload.groups[drawable.group].channelCount));
    EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, wrongChannel, testArena.arena, testArena.scratchArena).has_value());
    MetascriptValue croppedGlyph(metadata);
    croppedGlyph.field(s_GlyphsField).asList()[drawableIndex].field("width").setInteger(cast<i64>(entry.payload.groups[drawable.group].width));
    EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, croppedGlyph, testArena.arena, testArena.scratchArena).has_value());
    MetascriptValue zeroDimension(metadata);
    zeroDimension.field(s_GlyphsField).asList()[drawableIndex].field("height").setInteger(0);
    EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, zeroDimension, testArena.arena, testArena.scratchArena).has_value());

    usize emptyIndex = originalGlyphCount;
    for(usize index = 0u; index < originalGlyphCount; ++index){
        if(entry.payload.glyphs[index].drawable == 0u){
            emptyIndex = index;
            break;
        }
    }
    ASSERT_LT(emptyIndex, originalGlyphCount);
    MetascriptValue emptyWithGeometry(metadata);
    emptyWithGeometry.field(s_GlyphsField).asList()[emptyIndex].field("x").setInteger(0);
    EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, emptyWithGeometry, testArena.arena, testArena.scratchArena).has_value());
    MetascriptValue missingWidth(metadata);
    ASSERT_EQ(missingWidth.field(s_GlyphsField).asList()[drawableIndex].asMap().erase(StringView("width")), 1u);
    EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, missingWidth, testArena.arena, testArena.scratchArena).has_value());
}

void VerifyAssetsFontMetadata_MissingTruncatedCorruptAndMismatchedFontSourcesAreRejected(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    MetadataTestArena testArena = MetadataTestArena();
    const Path directory = ScratchRoot("source_rejection");
    ASSERT_TRUE(PrepareFiles(directory, testArena));
    MetascriptDocument document(testArena.arena);
    ASSERT_TRUE(LoadMetadata(testArena, document));

    MetascriptValue face(testArena.arena);
    MetascriptValue metadata(testArena.arena);
    ASSERT_TRUE(CopyDocumentVariable(document, s_FaceVariable, face));
    ASSERT_TRUE(CopyDocumentVariable(document, s_AtlasVariable, metadata));
    metadata.field(s_FontField).setString(s_LatinFacePath);
    const Path path = directory / s_LatinMetadataFilename;
    ASSERT_TRUE(ParseFontCookMetadataValue(Name(s_LatinFacePath), path, face, testArena.arena).has_value());
    const Expected<FontAtlasCookEntry> entryParseResult = ParseFontAtlasCookMetadataValue(Name(s_LatinAtlasPath), path, metadata, testArena.arena, testArena.scratchArena);
    ASSERT_TRUE(entryParseResult.has_value());
    const FontAtlasCookEntry entry = entryParseResult.value();
    const Sha256Digest originalHash = entry.payload.fontSha256;
    const Path fontPath = directory / s_LatinFontFilename;
    AssetBytes originalFont(testArena.arena);
    ASSERT_TRUE(ReadBinaryFile(fontPath, originalFont).has_value());
    ASSERT_FALSE(originalFont.empty());

    AssetBytes truncated = CopyAtlasBytes(originalFont, testArena.arena);
    truncated.pop_back();
    ASSERT_TRUE(WriteBinaryFile(fontPath, truncated));
    EXPECT_FALSE(ParseFontCookMetadataValue(s_FontAtlasOtherProject, path, face, testArena.arena).has_value());
    EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, metadata, testArena.arena, testArena.scratchArena).has_value());

    AssetBytes corrupted = CopyAtlasBytes(originalFont, testArena.arena);
    corrupted.back() ^= 1u;
    ASSERT_TRUE(WriteBinaryFile(fontPath, corrupted));
    EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, metadata, testArena.arena, testArena.scratchArena).has_value());

    corrupted = CopyAtlasBytes(originalFont, testArena.arena);
    ASSERT_GT(corrupted.size(), 24u);
    // The SFNT digest follows the six u32 prepared-source header fields.
    corrupted[24u] ^= 1u;
    ASSERT_TRUE(WriteBinaryFile(fontPath, corrupted));
    EXPECT_FALSE(ParseFontCookMetadataValue(s_FontAtlasOtherProject, path, face, testArena.arena).has_value());
    EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, metadata, testArena.arena, testArena.scratchArena).has_value());

    AssetBytes otherFont(testArena.arena);
    ASSERT_TRUE(ReadBinaryFile(BundledFontRoot() / "korean.font", otherFont).has_value());
    ASSERT_TRUE(WriteBinaryFile(fontPath, otherFont));
    const Expected<FontCookEntry> replacementFontParseResult = ParseFontCookMetadataValue(s_FontAtlasOtherProject, path, face, testArena.arena);
    ASSERT_TRUE(replacementFontParseResult.has_value());
    EXPECT_NE(ComputeSha256(replacementFontParseResult.value().fontBytes), originalHash);
    EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, path, metadata, testArena.arena, testArena.scratchArena).has_value());

    ASSERT_TRUE(WriteBinaryFile(fontPath, originalFont));
    EXPECT_FALSE(ParseFontCookMetadataValue(s_FontAtlasOtherProject, directory / "missing.nwb", face, testArena.arena).has_value());
    EXPECT_FALSE(ParseFontAtlasCookMetadataValue(s_FontAtlasOtherProject, directory / "missing.nwb", metadata, testArena.arena, testArena.scratchArena).has_value());
}

NWB_ADHD_GTEST(AssetsFontAtlas, EmptyAndPaddingBoundaryDigestsRejectMalformedText, VerifyAssetsFontAtlas_EmptyAndPaddingBoundaryDigestsRejectMalformedText)
NWB_ADHD_GTEST(AssetsFontAtlas, EmptyGlyphRetainsAdvanceAndFirstOutOfRangeLookupMissesAfterLoad, VerifyAssetsFontAtlas_EmptyGlyphRetainsAdvanceAndFirstOutOfRangeLookupMissesAfterLoad)
