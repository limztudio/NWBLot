UiSkinSliceInsets MakeUiPaintOverlaySliceInsets(in u32 left, in u32 top, in u32 right, in u32 bottom){
    UiSkinSliceInsets insets = UiSkinSliceInsets();
    insets.left = left;
    insets.top = top;
    insets.right = right;
    insets.bottom = bottom;
    return insets;
}

void RecordUiPaintImageAdmissionBaseline(
    mut PaintBuilder builder,
    in Span<SharedGlyphPage> glyphs,
    in SharedSdfAtlasPage sdf,
    in SharedImageSource image
){
    ASSERT_TRUE(UiPaintOverlayPrepareGlyphsAndSingleSdfAndImage(builder, glyphs, sdf, image));
    builder.fillRect(Rect(2.0f, 3.0f, 4.0f, 5.0f), Color(0.8f, 0.4f, 0.2f, 0.5f));
    ASSERT_TRUE(builder.drawGlyph(glyphs[0u], Rect(12.0f, 3.0f, 4.0f, 5.0f), Rect(0.125f, 0.25f, 0.5f, 0.5f)));
    ASSERT_TRUE(builder.drawSdfGlyph(sdf, 3u, Rect(22.0f, 3.0f, 4.0f, 5.0f), Rect(0.0f, 0.0f, 0.5f, 0.5f)));
    ASSERT_TRUE(builder.drawImage(image, Rect(32.0f, 3.0f, 8.0f, 4.0f)));
}

void RecordUiPaintImageMixedOverflowBaseline(
    mut PaintBuilder builder,
    in Span<SharedGlyphPage> glyphs,
    in SharedSdfAtlasPage sdf,
    in SharedImageSource image
){
    ASSERT_TRUE(UiPaintOverlayPrepareGlyphsAndSingleSdfAndImage(builder, glyphs, sdf, image));
    builder.fillRect(Rect(2.0f, 3.0f, 5.0f, 7.0f), Color(0.6f, 0.3f, 0.2f, 0.5f));
    ASSERT_TRUE(builder.drawGlyph(glyphs[0u], Rect(12.0f, 13.0f, 5.0f, 7.0f), Rect(0.125f, 0.25f, 0.5f, 0.5f)));
    ASSERT_TRUE(builder.beginOverlay(2u));
    builder.pushClip(Rect(30.0f, 10.0f, 40.0f, 20.0f));
    ASSERT_TRUE(builder.drawSdfGlyph(sdf, 2u, Rect(32.0f, 12.0f, 8.0f, 8.0f), Rect(0.0f, 0.0f, 0.5f, 0.5f)));
    ASSERT_TRUE(builder.drawImage(image, Rect(44.0f, 12.0f, 12.0f, 8.0f), Rect(0.25f, 0.25f, 0.5f, 0.5f)));
    ASSERT_TRUE(builder.popClip());
    ASSERT_TRUE(builder.endOverlay());
}

void RecordUiPaintImageNullThirdPassInitial(mut PaintBuilder builder, in SharedGlyphPage glyph, in SharedImageSource image){
    ASSERT_TRUE(UiPaintOverlayPrepareOneGlyphAndOneImage(builder, glyph, image));
    ASSERT_TRUE(builder.drawGlyph(glyph, Rect(2.0f, 3.0f, 4.0f, 5.0f), Rect(0.125f, 0.25f, 0.5f, 0.5f)));
    ASSERT_TRUE(builder.drawImage(image, Rect(12.0f, 3.0f, 8.0f, 4.0f)));
}

void RecordUiPaintImageNullThirdPassRetry(
    mut PaintBuilder builder,
    in SharedGlyphPage upgrade,
    in SharedSdfAtlasPage sdf,
    in SharedImageSource addition
){
    ASSERT_TRUE(UiPaintOverlayPrepareOneEach(builder, upgrade, sdf, addition));
    ASSERT_TRUE(builder.drawSdfGlyph(sdf, 1u, Rect(22.0f, 3.0f, 4.0f, 5.0f), Rect(0.0f, 0.0f, 0.5f, 0.5f)));
    ASSERT_TRUE(builder.drawImage(addition, Rect(32.0f, 3.0f, 8.0f, 4.0f)));
}


