void VerifyImageLoaderTests_RealCodecLoadRetainsExactTextureAfterTemporaryAssetAndBinaryAreGone(mut ImageLoaderTests self){
    const Expected<SharedImageSource> imageResult = LoadImageSource(self.m_arena, self.m_assets, self.m_identity);
    ASSERT_TRUE(imageResult.has_value());
    const SharedImageSource image = imageResult.value();
    ASSERT_TRUE(UiImageHandlePresent(image));
    EXPECT_TRUE(self.payloadDisjointFromSource(image));
    self.zeroAndClearBinary();
    UiImageLoaderExpectPayload(image, 3u);
    EXPECT_TRUE(UiReadImageTexture(image).validatePayload());
}

void VerifyImageLoaderTests_EmptyReferenceFailsBeforeReadingTheBinarySource(mut ImageLoaderTests self){
    EXPECT_FALSE(LoadImageSource(self.m_arena, self.m_assets, AssetRef<Texture>()).has_value());
    EXPECT_EQ(self.m_source.m_readCount, 0u);
    EXPECT_TRUE(self.sawError("texture asset reference is empty"));
}

void VerifyImageLoaderTests_MissingPathAndFailedBinaryReadReturnNoSource(mut ImageLoaderTests self){
    const AssetRef<Texture> missing = MakeUiMissingTextureAssetRef();
    EXPECT_FALSE(LoadImageSource(self.m_arena, self.m_assets, missing).has_value());
    EXPECT_EQ(self.m_source.m_readCount, 1u);
    self.m_source.m_available = false;
    EXPECT_FALSE(LoadImageSource(self.m_arena, self.m_assets, self.m_identity).has_value());
    EXPECT_EQ(self.m_source.m_readCount, 2u);
    EXPECT_TRUE(self.sawError("failed to read binary"));
}

void VerifyImageLoaderTests_MissingTextureCodecFailsAfterReadingAValidBinary(mut ImageLoaderTests self){
    ASSERT_TRUE(self.unregisterTextureCodec());
    EXPECT_FALSE(LoadImageSource(self.m_arena, self.m_assets, self.m_identity).has_value());
    EXPECT_EQ(self.m_source.m_readCount, 1u);
    EXPECT_TRUE(self.sawError("failed to deserialize"));
}

void VerifyImageLoaderTests_RealTextureCodecRejectsWrongMagicTruncationAndTrailingBytes(mut ImageLoaderTests self){
    self.flipFirstBinaryByte();
    EXPECT_FALSE(LoadImageSource(self.m_arena, self.m_assets, self.m_identity).has_value());
    self.rebuildBinary(3u);
    self.m_source.m_binary.pop_back();
    EXPECT_FALSE(LoadImageSource(self.m_arena, self.m_assets, self.m_identity).has_value());
    self.rebuildBinary(3u);
    self.m_source.m_binary.push_back(0u);
    EXPECT_FALSE(LoadImageSource(self.m_arena, self.m_assets, self.m_identity).has_value());
    EXPECT_EQ(self.m_source.m_readCount, 3u);
    EXPECT_TRUE(self.sawError("invalid texture asset format"));
    EXPECT_TRUE(self.sawError("texture payload is truncated"));
    EXPECT_TRUE(self.sawError("trailing bytes detected"));
}

void VerifyImageLoaderTests_CodecReturningARealDifferentAssetTypeIsRejectedByTheTypedManager(mut ImageLoaderTests self){
    ASSERT_TRUE(self.registerMisdirectedCodec(true));
    EXPECT_FALSE(LoadImageSource(self.m_arena, self.m_assets, self.m_identity).has_value());
    EXPECT_EQ(self.m_source.m_readCount, 1u);
    EXPECT_TRUE(self.sawError("is not a texture"));
}

void VerifyImageLoaderTests_CodecReturningAValidTextureAtAnotherIdentityIsRejected(mut ImageLoaderTests self){
    ASSERT_TRUE(self.registerMisdirectedCodec(false));
    EXPECT_FALSE(LoadImageSource(self.m_arena, self.m_assets, self.m_identity).has_value());
    EXPECT_EQ(self.m_source.m_readCount, 1u);
    EXPECT_TRUE(self.sawError("loaded texture identity does not match"));
}

void VerifyImageLoaderTests_RepeatedLoadsOfIdenticalBytesOwnDistinctFreshVersions(mut ImageLoaderTests self){
    const Expected<SharedImageSource> firstResult = LoadImageSource(self.m_arena, self.m_assets, self.m_identity);
    ASSERT_TRUE(firstResult.has_value());
    const SharedImageSource first = firstResult.value();
    const Expected<SharedImageSource> secondResult = LoadImageSource(self.m_arena, self.m_assets, self.m_identity);
    ASSERT_TRUE(secondResult.has_value());
    const SharedImageSource second = secondResult.value();
    ASSERT_TRUE(UiImageHandlePresent(first));
    ASSERT_TRUE(UiImageHandlePresent(second));
    EXPECT_EQ(UiReadImageIdentity(first), UiReadImageIdentity(second));
    EXPECT_FALSE(UiSameImageHandlePtr(first, second));
    EXPECT_NE(UiReadImageGeneration(first), UiReadImageGeneration(second));
    EXPECT_TRUE(UiDistinctLoadedTextureStorage(first, second));
    UiImageLoaderExpectPayload(first, 3u);
    UiImageLoaderExpectPayload(second, 3u);
    EXPECT_EQ(self.m_source.m_readCount, 2u);
}

void VerifyImageLoaderTests_FailedReplacementPreservesRetainedSourceAndLaterSuccessPublishesAFreshVersion(mut ImageLoaderTests self){
    const Expected<SharedImageSource> currentResult = LoadImageSource(self.m_arena, self.m_assets, self.m_identity);
    ASSERT_TRUE(currentResult.has_value());
    SharedImageSource current = currentResult.value();
    ASSERT_TRUE(UiImageHandlePresent(current));
    const SharedImageSource retained = current;
    const u64 oldGeneration = UiReadImageGeneration(retained);

    self.m_source.m_binary.pop_back();
    Expected<SharedImageSource> replacement = LoadImageSource(self.m_arena, self.m_assets, self.m_identity);
    EXPECT_FALSE(replacement.has_value());
    if(replacement.has_value())
        current = replacement.value();
    EXPECT_TRUE(UiSameImageHandlePtr(current, retained));
    EXPECT_EQ(UiReadImageGeneration(current), oldGeneration);
    UiImageLoaderExpectPayload(current, 3u);

    self.rebuildBinary(67u);
    replacement = LoadImageSource(self.m_arena, self.m_assets, self.m_identity);
    ASSERT_TRUE(replacement.has_value());
    current = replacement.value();
    EXPECT_EQ(UiReadImageIdentity(current), UiReadImageIdentity(retained));
    EXPECT_FALSE(UiSameImageHandlePtr(current, retained));
    EXPECT_NE(UiReadImageGeneration(current), oldGeneration);
    EXPECT_EQ(UiReadImageGeneration(retained), oldGeneration);
    self.m_source.m_binary.clear();
    UiImageLoaderExpectPayload(current, 67u);
    UiImageLoaderExpectPayload(retained, 3u);
    EXPECT_EQ(self.m_source.m_readCount, 3u);
}


