#include <impl/ecs_render/raytrace/raytracing_system.adhd>
#include <impl/ecs_render/shadow/rt_shadow_soft_resolve_combined.adhd>
#include <impl/ecs_render/shadow/rt_shadow_trace_and_materials.adhd>
#include <impl/ecs_render/shadow/rt_shadow_visibility_targets_and_recorders.adhd>
#include <impl/ecs_render/shadow/rt_shadow_state.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanRenderSoftTransparentShadow(in b8 softShadowReady, in b8 softTransparentReady, in u32 softShadowSlotMask){
    return softShadowReady && softTransparentReady && softShadowSlotMask != 0u;
}

b8 HasSoftShadowDenoiseOrTransparentWork(
    in b8 dispatchOpaqueResolve,
    in b8 dispatchOpaqueResolveTail,
    in b8 dispatchTransparentTrace,
    in b8 dispatchTransparentResolve,
    in b8 dispatchTransparentResolveTail,
    in b8 dispatchTransparentTemporalMerge
){
    return dispatchOpaqueResolve
        || dispatchOpaqueResolveTail
        || dispatchTransparentTrace
        || dispatchTransparentResolve
        || dispatchTransparentResolveTail
        || dispatchTransparentTemporalMerge;
}

b8 ShouldDispatchOpaqueTemporalMerge(in b8 dispatchOpaqueResolve, in b8 opaqueTemporalActive, in SoftShadowOpaqueResolvePhase opaquePhase){
    return dispatchOpaqueResolve && opaqueTemporalActive && opaquePhase != SoftShadowOpaqueResolvePhase::WaveletOnly;
}

b8 ShouldDispatchTransparentTemporalMerge(in b8 dispatchTransparentTemporalMerge, in b8 dispatchTransparentResolve, in b8 splitTransparentResolve){
    return dispatchTransparentTemporalMerge || (dispatchTransparentResolve && !splitTransparentResolve);
}

b8 ShouldAdvanceSoftShadowTemporalHistory(
    in b8 dispatchTransparentResolve,
    in b8 splitTransparentResolve,
    in b8 dispatchTransparentResolveTail,
    in b8 softShadowTemporalReady
){
    return ((dispatchTransparentResolve && !splitTransparentResolve) || dispatchTransparentResolveTail) && softShadowTemporalReady;
}

void ResolveSoftShadowResolveExtentsAndGroups(
    in u32 width,
    in u32 height,
    in u32 receiverFactor,
    in u32 groupSize,
    mut u32 outHalfWidth,
    mut u32 outHalfHeight,
    mut u32 outHalfGroupsX,
    mut u32 outHalfGroupsY,
    mut u32 outFullGroupsX,
    mut u32 outFullGroupsY
){
    const u32 halfWidth = DivideUpWrappingU32(width, receiverFactor);
    const u32 halfHeight = DivideUpWrappingU32(height, receiverFactor);
    outHalfWidth = halfWidth;
    outHalfHeight = halfHeight;
    outHalfGroupsX = DivideUp(halfWidth, groupSize);
    outHalfGroupsY = DivideUp(halfHeight, groupSize);
    outFullGroupsX = DivideUp(width, groupSize);
    outFullGroupsY = DivideUp(height, groupSize);
}

b8 IsOddWaveletPassCount(in u32 passCount){
    return passCount != 0u && (passCount % 2u) == 1u;
}

u32 WaveletPassStepWidth(in u32 passIndex){
    return 1u << passIndex;
}

b8 ShouldReplaceTransparentSoftTraceWithLightSpace(in b8 lightSpaceReady, in b8 composeCsg, in b8 replaceTransparent){
    return lightSpaceReady && (!composeCsg || replaceTransparent);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void RecordSoftShadowResolvePass(
    mut CommandList commandList,
    mut GpuDescriptorHeap heap,
    in DeferredFrameTargets targets,
    in DeferredLightingGraphResources deferredLightingResources,
    in SoftShadowResolveDispatch dispatch,
    in u32 halfWidth,
    in u32 halfHeight,
    in u32 slotStart,
    in u32 slotCount,
    in SoftShadowResolvePassResources resources,
    in u32 stepWidth,
    in ShadowResolveStage stage,
    in u32 groupsX,
    in u32 groupsY,
    in b8 graphOwnsInputColorState,
    in b8 graphOwnsOutputState
){
    in DeferredBindlessFrameResources bindless = targets.bindless;
    assert(IsValidTexturePtr(resources.inputColorTexture) && IsValidTexturePtr(resources.momentsTexture) && IsValidTexturePtr(resources.outputTexture));
    switch(stage){
        case ShadowResolveStage::Wavelet:
            if(!dispatch.graphOwnsWaveletGeometryEntryState)
                commandList.setTextureState(targets.shadowSoftGeometry.get(), s_FramebufferSubresources, ResourceStates::ShaderResource);
            if(!graphOwnsInputColorState)
                commandList.setTextureState(resources.inputColorTexture, s_ShadowVisibilitySubresources, ResourceStates::ShaderResource);
            if(dispatch.temporalMomentsValid && !dispatch.graphOwnsWaveletMomentsEntryState)
                commandList.setTextureState(resources.momentsTexture, s_ShadowVisibilitySubresources, ResourceStates::ShaderResource);
            if(!graphOwnsOutputState)
                commandList.setTextureState(resources.outputTexture, s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
            commandList.setEnableUavBarriersForTexture(resources.outputTexture, true);
            break;
        case ShadowResolveStage::Upsample:
            if(!dispatch.graphOwnsUpsampleStaticEntryStates){
                commandList.setTextureState(targets.depth.get(), s_FramebufferSubresources, ResourceStates::ShaderResource);
                commandList.setTextureState(targets.worldPosition.get(), s_FramebufferSubresources, ResourceStates::ShaderResource);
                commandList.setTextureState(targets.normal.get(), s_FramebufferSubresources, ResourceStates::ShaderResource);
                commandList.setBufferState(deferredLightingResources.sceneShadingBuffer.get(), ResourceStates::ConstantBuffer);
            }
            if(!graphOwnsInputColorState)
                commandList.setTextureState(resources.inputColorTexture, s_ShadowVisibilitySubresources, ResourceStates::ShaderResource);
            if(!graphOwnsOutputState)
                commandList.setTextureState(dispatch.visibilityTexture, s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
            commandList.setEnableUavBarriersForTexture(dispatch.visibilityTexture, true);
            break;
    }
    commandList.commitBarriers();

    const ShadowResolvePushConstants push = MakeShadowResolvePassPushConstants(
        targets.shadowReceiverFactor,
        targets.width,
        targets.height,
        halfWidth,
        halfHeight,
        stepWidth,
        stage,
        slotStart,
        slotCount,
        dispatch.temporalMomentsValid,
        dispatch.fold,
        bindless.shadowSoftGeometry.slot(),
        bindless.gbufferDepth.slot(),
        bindless.gbufferWorldPosition.slot(),
        bindless.gbufferNormal.slot(),
        resources.inputColor,
        resources.moments,
        resources.outputStorage,
        dispatch.visibilityStorage,
        dispatch.sceneShading
    );

    ComputePipelineHandle pipeline = dispatch.waveletPipeline;
    if(stage == ShadowResolveStage::Upsample)
        pipeline = dispatch.upsamplePipeline;
    ComputeState state;
    state.setPipeline(pipeline.deref());
    commandList.setComputeState(state);
    heap.bindCompute(commandList, pipeline.deref());
    commandList.setPushConstants(push);
    commandList.dispatch(groupsX, groupsY, 1u);
}

static_assert((s_ShadowWaveletResolvePassCount % 2u) == 1u);
static_assert((s_ShadowWaveletTransparentResolvePassCount % 2u) == 1u);

ShadowReprojectMergeHeapResources SelectOpaqueMergeResources(in DeferredFrameTargets targets, in b8 frontIsA){
    if(frontIsA)
        return ShadowReprojectMergeHeapResources(
                targets.shadowSoftHalfA.get(), targets.shadowHistA.get(), targets.shadowMomentsA.get(), targets.shadowHistB.get(), targets.shadowMomentsB.get(),
                targets.bindless.shadowSoftHalfA.slot(), targets.bindless.shadowHistA.slot(), targets.bindless.shadowMomentsA.slot(),
                targets.bindless.shadowHistBStorage.slot(), targets.bindless.shadowMomentsBStorage.slot()
        );
    return ShadowReprojectMergeHeapResources(
                targets.shadowSoftHalfA.get(), targets.shadowHistB.get(), targets.shadowMomentsB.get(), targets.shadowHistA.get(), targets.shadowMomentsA.get(),
                targets.bindless.shadowSoftHalfA.slot(), targets.bindless.shadowHistB.slot(), targets.bindless.shadowMomentsB.slot(),
                targets.bindless.shadowHistAStorage.slot(), targets.bindless.shadowMomentsAStorage.slot()
    );
}

ShadowReprojectMergeHeapResources SelectTransparentMergeResources(in DeferredFrameTargets targets, in b8 frontIsA){
    if(frontIsA)
        return ShadowReprojectMergeHeapResources(
                targets.transparentSoftHalf.get(), targets.transparentHistA.get(), targets.transparentMomentsA.get(), targets.transparentHistB.get(), targets.transparentMomentsB.get(),
                targets.bindless.transparentSoftHalf.slot(), targets.bindless.transparentHistA.slot(), targets.bindless.transparentMomentsA.slot(),
                targets.bindless.transparentHistBStorage.slot(), targets.bindless.transparentMomentsBStorage.slot()
        );
    return ShadowReprojectMergeHeapResources(
                targets.transparentSoftHalf.get(), targets.transparentHistB.get(), targets.transparentMomentsB.get(), targets.transparentHistA.get(), targets.transparentMomentsA.get(),
                targets.bindless.transparentSoftHalf.slot(), targets.bindless.transparentHistB.slot(), targets.bindless.transparentMomentsB.slot(),
                targets.bindless.transparentHistAStorage.slot(), targets.bindless.transparentMomentsAStorage.slot()
    );
}

Expected<u32> RendererRayTracingSystem::renderShadowVisibility(
    mut CommandList commandList,
    mut DeferredFrameTargets targets,
    in DeferredLightingGraphResources deferredLightingResources,
    in b8 splitSoftTransparentFold,
    in b8 graphOwnsOpaqueTemporalMergeEntryStates,
    in b8 splitOpaqueSoftResolve,
    in Optional<in LightSpaceShadowSnapshot> lightSpace
){
    u32 producedFrameIndex = 0u;
    assert(!splitOpaqueSoftResolve || splitSoftTransparentFold);
    assert(deferredLightingResources.valid());
    if(!targets.shadowVisibility.valid())
        return MakeUnexpected(Failure());
    if(!this.m_rayTracingState.sceneBvh.m_tlas || !this.m_rayTracingState.shadow.m_shadowPipeline.valid())
        return MakeUnexpected(Failure());

    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    if(
        !heap.isInitialized()
        || !this.m_rayTracingState.sceneBvh.m_tlasHeapHandle.valid()
        || !targets.bindless.valid()
        || !IsDescriptorClass(targets.bindless.slotsBufferDescriptor, GpuDescriptorClass::UniformBuffer)
        || !IsDescriptorClass(targets.bindless.shadowVisibilityStorage, GpuDescriptorClass::StorageImage)
        || !IsDescriptorClass(targets.bindless.shadowSoftHalfAStorage, GpuDescriptorClass::StorageImage)
    ){
        error("RendererSystem: shadow trace heap resources are incomplete");
        return MakeUnexpected(Failure());
    }

    Optional<GpuTimingMeasure> timing;
    if(!splitSoftTransparentFold)
        timing.emplace(this.m_graphics.gpuTiming(), s_TimingScopeShadowVisibility, this.m_graphics.getDevice(), commandList);

    if(this.m_rayTracingState.softShadow.m_softShadowReady && this.m_rayTracingState.softShadow.m_shadowSoftPipeline && this.m_rayTracingState.softShadow.m_softShadowSlotMask != 0u){
        const u32 softGroupsX = ResolveWrappingRayTracingDispatchGroup(targets.width, targets.shadowReceiverFactor, cast<u32>(s_ShadowRtGroupSize));
        const u32 softGroupsY = ResolveWrappingRayTracingDispatchGroup(targets.height, targets.shadowReceiverFactor, cast<u32>(s_ShadowRtGroupSize));

        this.enableSoftShadowResolveBarriers(commandList, targets);

        const u32 frameIndex = this.m_rayTracingState.softShadow.m_softShadowFrameIndex++;
        producedFrameIndex = frameIndex;

        {
            GpuTimingMeasure opaqueTraceTiming(this.m_graphics.gpuTiming(), s_TimingScopeShadowOpaqueTrace, this.m_graphics.getDevice(), commandList);

            ComputeState softState;
            softState.setPipeline(this.m_rayTracingState.softShadow.m_shadowSoftPipeline.get());
            commandList.setComputeState(softState);
            heap.bindCompute(commandList, this.m_rayTracingState.softShadow.m_shadowSoftPipeline.deref(), this.m_rayTracingState.sceneBvh.m_tlasHeapHandle);

            const ShadowRqSoftPushConstants softPush = MakeShadowRqSoftPushConstants(
                targets.width,
                targets.height,
                frameIndex,
                targets.bindless.gbufferWorldPosition.slot(),
                targets.bindless.gbufferNormal.slot(),
                targets.bindless.gbufferDepth.slot(),
                targets.bindless.slotsBufferDescriptor.slot(),
                targets.bindless.shadowSoftHalfAStorage.slot(),
                SelectSoftShadowOpaqueSampleCount(this.softShadowTemporalHistoryUsable(), s_ShaderSwShadowSoftTemporalSpp, s_ShaderSwShadowSoftSpp),
                targets.shadowReceiverFactor
            );
            commandList.setPushConstants(softPush);
            commandList.dispatch(softGroupsX, softGroupsY, 1u);
        }

        if(lightSpace.has_value() && lightSpace.value().ready){
            commandList.setTextureState(targets.shadowSoftHalfA.get(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess, true);
            commandList.commitBarriers();
            if(!LightSpaceShadowRecorder().resolve(
                lightSpace.value(),
                frameIndex, SelectSoftShadowOpaqueSampleCount(this.softShadowTemporalHistoryUsable(), s_ShaderSwShadowSoftTemporalSpp, s_ShaderSwShadowSoftSpp),
                targets.bindless.shadowSoftHalfAStorage.slot(), false,
                commandList, heap, this.m_graphics.gpuTiming(), targets.shadowSoftHalfA.deref()
            ))
                return MakeUnexpected(Failure());
            LightSpaceShadowLogReporter().reportCsgDispatch(true, true, lightSpace.value().push.instanceCount, this.m_lightSpaceShadow.m_csgDispatchLogged);
        }

        this.dispatchPrimarySoftShadowResolve(commandList, targets, deferredLightingResources, frameIndex, softGroupsX, softGroupsY, splitOpaqueSoftResolve, splitSoftTransparentFold, graphOwnsOpaqueTemporalMergeEntryStates);
        return producedFrameIndex;
    }

    {
        GpuTimingMeasure opaqueTraceTiming(this.m_graphics.gpuTiming(), s_TimingScopeShadowOpaqueTrace, this.m_graphics.getDevice(), commandList);

        ComputeState shadowState;
        shadowState.setPipeline(this.m_rayTracingState.shadow.m_shadowPipeline.get());
        commandList.setComputeState(shadowState);
        heap.bindCompute(commandList, this.m_rayTracingState.shadow.m_shadowPipeline.deref(), this.m_rayTracingState.sceneBvh.m_tlasHeapHandle);
        const u32 frameIndex = this.m_rayTracingState.softShadow.m_softShadowFrameIndex++;
        producedFrameIndex = frameIndex;
        const ShadowRqPushConstants shadowPush = MakeShadowRqPushConstants(
            frameIndex,
            targets.bindless.gbufferWorldPosition.slot(),
            targets.bindless.gbufferNormal.slot(),
            targets.bindless.gbufferDepth.slot(),
            targets.bindless.slotsBufferDescriptor.slot(),
            targets.bindless.shadowVisibilityStorage.slot()
        );
        commandList.setPushConstants(shadowPush);
        commandList.dispatch(DivideUp(targets.width, cast<u32>(s_ShadowRtGroupSize)), DivideUp(targets.height, cast<u32>(s_ShadowRtGroupSize)), 1u);
    }
    return producedFrameIndex;
}

void RendererRayTracingSystem::finalizeSoftShadowTemporalHistory(mut DeferredFrameTargets targets){
    if(!this.m_rayTracingState.softShadow.m_softShadowTemporalHistoryAdvancePending)
        return;

    this.m_rayTracingState.softShadow.m_softShadowTemporalHistoryAdvancePending = false;
    this.swapSoftShadowTemporalHistory(targets);
}

void RendererRayTracingSystem::discardSoftShadowTemporalHistory(){
    this.m_rayTracingState.softShadow.m_softShadowTemporalHistoryAdvancePending = false;
    this.m_rayTracingState.softShadow.m_transparentShadowSamplingHistory.discardPending();
}

b8 RendererRayTracingSystem::renderSoftTransparentShadowTrace(
    mut CommandList commandList,
    mut DeferredFrameTargets targets,
    in DeferredLightingGraphResources deferredLightingResources,
    in u32 frameIndex,
    in b8 graphOwnsOpaqueToTransparentBoundary,
    in Optional<in LightSpaceShadowSnapshot> lightSpace
){
    if(!CanRenderSoftTransparentShadow(this.m_rayTracingState.softShadow.m_softShadowReady, this.m_rayTracingState.softShadow.m_softTransparentReady, this.m_rayTracingState.softShadow.m_softShadowSlotMask))
        return false;
    const b8 lightSpaceReady = lightSpace.has_value() && lightSpace.value().ready;
    const b8 composeCsg = lightSpaceReady && (lightSpace.value().push.csgFlags & s_CsgShadowFlagHwCompose) != 0u;
    const b8 replaceTransparent = composeCsg && (lightSpace.value().push.csgFlags & s_CsgShadowFlagNoOrdinaryTransparent) != 0u;
    if(ShouldReplaceTransparentSoftTraceWithLightSpace(lightSpaceReady, composeCsg, replaceTransparent)){
        assert(graphOwnsOpaqueToTransparentBoundary);
        GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeShadowTransparentTrace, this.m_graphics.getDevice(), commandList);

        const u32 sampleCount = this.transparentShadowSampleCount();
        if(!LightSpaceShadowRecorder().resolve(lightSpace.value(), frameIndex, sampleCount, targets.bindless.transparentSoftHalfStorage.slot(), true, commandList, this.m_graphics.getDevice().getDescriptorHeap(),
            this.m_graphics.gpuTiming(), targets.transparentSoftHalf.deref()))
            return false;
        this.reportTransparentShadowSampling(sampleCount);
        return true;
    }
    const RayTracingDispatchGroups groups = ResolveRayTracingDispatchGroups(targets.width, targets.height, targets.shadowReceiverFactor, cast<u32>(s_ShaderSwShadowGroupSize));
    this.dispatchSoftShadowDenoiseAndTransparentFold(commandList, targets, deferredLightingResources, frameIndex, groups.x, groups.y, false, false, true, false, false, graphOwnsOpaqueToTransparentBoundary, false, false, false, false, false);
    if(composeCsg){
        commandList.setTextureState(targets.transparentSoftHalf.get(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess, true);
        commandList.commitBarriers();
        if(!LightSpaceShadowRecorder().resolve(
            lightSpace.value(), frameIndex, this.transparentShadowSampleCount(),
            targets.bindless.transparentSoftHalfStorage.slot(), true,
            commandList, this.m_graphics.getDevice().getDescriptorHeap(), this.m_graphics.gpuTiming(), targets.transparentSoftHalf.deref()
        ))
            return false;
    }
    if(!this.hardwareTransparentShadowReady())
        this.reportSoftwareShadowTraversal(targets);
    return true;
}

b8 RendererRayTracingSystem::renderSoftTransparentShadowTemporalMerge(
    mut CommandList commandList,
    mut DeferredFrameTargets targets,
    in DeferredLightingGraphResources deferredLightingResources,
    in u32 frameIndex,
    in b8 graphOwnsTransparentTemporalMergeEntryStates
){
    if(!CanRenderSoftTransparentShadow(this.m_rayTracingState.softShadow.m_softShadowReady, this.m_rayTracingState.softShadow.m_softTransparentReady, this.m_rayTracingState.softShadow.m_softShadowSlotMask)
        || !this.m_rayTracingState.softShadow.m_softTransparentTemporalReady)
        return false;
    const RayTracingDispatchGroups groups = ResolveRayTracingDispatchGroups(targets.width, targets.height, targets.shadowReceiverFactor, cast<u32>(s_ShaderSwShadowGroupSize));
    this.dispatchSoftShadowDenoiseAndTransparentFold(
        commandList, targets, deferredLightingResources, frameIndex, groups.x, groups.y,
        false, false, false, false, false, false, true, false, graphOwnsTransparentTemporalMergeEntryStates,
        false, false, false, false, true
    );
    return true;
}

b8 RendererRayTracingSystem::renderSoftTransparentShadowFirstWavelet(
    mut CommandList commandList,
    mut DeferredFrameTargets targets,
    in DeferredLightingGraphResources deferredLightingResources,
    in u32 frameIndex,
    in b8 graphOwnsTransparentWaveletInputBoundary
){
    if(!CanRenderSoftTransparentShadow(this.m_rayTracingState.softShadow.m_softShadowReady, this.m_rayTracingState.softShadow.m_softTransparentReady, this.m_rayTracingState.softShadow.m_softShadowSlotMask))
        return false;
    const RayTracingDispatchGroups groups = ResolveRayTracingDispatchGroups(targets.width, targets.height, targets.shadowReceiverFactor, cast<u32>(s_ShaderSwShadowGroupSize));
    this.dispatchSoftShadowDenoiseAndTransparentFold(commandList, targets, deferredLightingResources, frameIndex, groups.x, groups.y, false, false, false, true, false, false, graphOwnsTransparentWaveletInputBoundary,
        false, false, false, false, false, true, false);
    return true;
}

b8 RendererRayTracingSystem::renderSoftTransparentShadowFold(mut CommandList commandList, mut DeferredFrameTargets targets, in DeferredLightingGraphResources deferredLightingResources, in u32 frameIndex){
    if(!CanRenderSoftTransparentShadow(this.m_rayTracingState.softShadow.m_softShadowReady, this.m_rayTracingState.softShadow.m_softTransparentReady, this.m_rayTracingState.softShadow.m_softShadowSlotMask))
        return false;
    const RayTracingDispatchGroups groups = ResolveRayTracingDispatchGroups(targets.width, targets.height, targets.shadowReceiverFactor, cast<u32>(s_ShaderSwShadowGroupSize));
    this.dispatchSoftShadowDenoiseAndTransparentFold(commandList, targets, deferredLightingResources, frameIndex, groups.x, groups.y, false, false, false, false, false, false, false, false, false, false, false, true);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void RendererRayTracingSystem::dispatchSoftShadowResolve(
    mut CommandList commandList,
    mut DeferredFrameTargets targets,
    in DeferredLightingGraphResources deferredLightingResources,
    in u32 slotStart,
    in u32 slotCount,
    in SoftShadowResolveDispatch dispatch,
    in b8 dispatchFirstWavelet,
    in b8 dispatchTail
){
    assert(dispatch.waveletPipeline.valid() && dispatch.upsamplePipeline.valid());
    assert(IsValidTexturePtr(dispatch.visibilityTexture));
    u32 halfWidth = 0u;
    u32 halfHeight = 0u;
    u32 halfGroupsX = 0u;
    u32 halfGroupsY = 0u;
    u32 fullGroupsX = 0u;
    u32 fullGroupsY = 0u;
    ResolveSoftShadowResolveExtentsAndGroups(
        targets.width,
        targets.height,
        targets.shadowReceiverFactor,
        cast<u32>(s_ShaderShadowResolveGroupSize),
        halfWidth,
        halfHeight,
        halfGroupsX,
        halfGroupsY,
        fullGroupsX,
        fullGroupsY
    );
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();


    assert(IsOddWaveletPassCount(dispatch.waveletPassCount));
    assert(dispatchFirstWavelet || dispatchTail);

    if(dispatchFirstWavelet)
        RecordSoftShadowResolvePass(commandList, heap, targets, deferredLightingResources, dispatch, halfWidth, halfHeight, slotStart, slotCount, dispatch.firstWaveletResources, 1u, ShadowResolveStage::Wavelet,
            halfGroupsX, halfGroupsY, dispatch.graphOwnsFirstWaveletInputState, dispatch.graphOwnsFirstWaveletOutputState);
    if(!dispatchTail)
        return;

    b8 sourceIsHalfA = dispatch.firstWaveletWritesHalfA;
    for(u32 pass = 1u; pass < dispatch.waveletPassCount; ++pass){
        SoftShadowResolvePassResources nextWaveletResources = dispatch.outputHalfAResources;
        if(sourceIsHalfA)
            nextWaveletResources = dispatch.outputHalfBResources;
        RecordSoftShadowResolvePass(commandList, heap, targets, deferredLightingResources, dispatch, halfWidth, halfHeight, slotStart, slotCount, nextWaveletResources, WaveletPassStepWidth(pass),
            ShadowResolveStage::Wavelet, halfGroupsX, halfGroupsY, false, false);
        sourceIsHalfA = !sourceIsHalfA;
    }
    TexturePtr finalWaveletOutput = dispatch.outputHalfBResources.outputTexture;
    if(dispatch.waveletPassCount == 1u)
        finalWaveletOutput = dispatch.firstWaveletResources.outputTexture;
    else if(sourceIsHalfA)
        finalWaveletOutput = dispatch.outputHalfAResources.outputTexture;
    assert(dispatch.upsampleResources.inputColorTexture == finalWaveletOutput);
    RecordSoftShadowResolvePass(commandList, heap, targets, deferredLightingResources, dispatch, halfWidth, halfHeight, slotStart, slotCount, dispatch.upsampleResources, 1u, ShadowResolveStage::Upsample, fullGroupsX,
        fullGroupsY, dispatch.graphOwnsUpsampleInputColorEntryState, dispatch.graphOwnsUpsampleVisibilityOutputState);
}

void RendererRayTracingSystem::dispatchSoftShadowDenoiseAndTransparentFold(
    mut CommandList commandList,
    mut DeferredFrameTargets targets,
    in DeferredLightingGraphResources deferredLightingResources,
    in u32 frameIndex,
    in u32 softGroupsX,
    in u32 softGroupsY,
    in b8 dispatchOpaqueGeometry,
    in b8 dispatchOpaqueResolve,
    in b8 dispatchTransparentTrace,
    in b8 dispatchTransparentResolve,
    in b8 graphOwnsOpaqueGeometryToResolveBoundary,
    in b8 graphOwnsOpaqueToTransparentBoundary,
    in b8 graphOwnsTransparentTraceToResolveBoundary,
    in b8 graphOwnsOpaqueTemporalMergeEntryStates,
    in b8 graphOwnsTransparentTemporalMergeEntryStates,
    in b8 dispatchOpaqueResolveTail,
    in b8 graphOwnsOpaqueTraceToFirstWaveletBoundary,
    in b8 dispatchTransparentResolveTail,
    in b8 splitTransparentResolve,
    in b8 dispatchTransparentTemporalMerge,
    in SoftShadowOpaqueResolvePhase opaquePhase
){
    assert(targets.bindless.valid());
    assert(deferredLightingResources.valid());

    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    if(
        !heap.isInitialized()
        || !IsDescriptorClass(targets.bindless.slotsBufferDescriptor, GpuDescriptorClass::UniformBuffer)
        || !IsDescriptorClass(targets.bindless.sceneShading, GpuDescriptorClass::UniformBuffer)
        || !IsDescriptorClass(targets.bindless.shadowVisibilityStorage, GpuDescriptorClass::StorageImage)
        || !IsDescriptorClass(targets.bindless.shadowSoftGeometryStorage, GpuDescriptorClass::StorageImage)
        || !IsDescriptorClass(targets.bindless.shadowSoftHalfAStorage, GpuDescriptorClass::StorageImage)
        || !IsDescriptorClass(targets.bindless.shadowSoftHalfBStorage, GpuDescriptorClass::StorageImage)
    )
        return;

    const u32 softHalfWidth = DivideUpWrapping(targets.width, targets.shadowReceiverFactor);
    const u32 softHalfHeight = DivideUpWrapping(targets.height, targets.shadowReceiverFactor);

    if(dispatchOpaqueGeometry){
        commandList.setEnableUavBarriersForTexture(targets.shadowSoftGeometry.get(), true);

        {
            GpuTimingMeasure geometryTiming(this.m_graphics.gpuTiming(), s_TimingScopeShadowGeometryDownsample, this.m_graphics.getDevice(), commandList);

            const ShadowGeometryDownsamplePushConstants geometryPush = MakeShadowGeometryDownsamplePushConstants(
                targets.width,
                targets.height,
                softHalfWidth,
                softHalfHeight,
                targets.bindless.gbufferWorldPosition.slot(),
                targets.bindless.gbufferNormal.slot(),
                targets.bindless.gbufferDepth.slot(),
                targets.bindless.shadowSoftGeometryStorage.slot(),
                targets.bindless.sceneShading.slot(),
                targets.shadowReceiverFactor
            );
            commandList.setComputeState(MakeComputePassState(this.m_rayTracingState.softShadow.m_shadowGeometryDownsamplePipeline));
            heap.bindCompute(commandList, this.m_rayTracingState.softShadow.m_shadowGeometryDownsamplePipeline.deref());
            commandList.setPushConstants(geometryPush);
            commandList.dispatch(softGroupsX, softGroupsY, 1u);
        }
    }

    if(!HasSoftShadowDenoiseOrTransparentWork(dispatchOpaqueResolve, dispatchOpaqueResolveTail, dispatchTransparentTrace, dispatchTransparentResolve, dispatchTransparentResolveTail, dispatchTransparentTemporalMerge))
        return;

    const u32 slotRangeCount = ResolveSoftShadowLightSlotRangeCount(this.m_rayTracingState.softShadow.m_softShadowSlotMask);
    if(slotRangeCount == 0u)
        return;

    const b8 frontIsA = this.m_rayTracingState.softShadow.m_softShadowHistoryFrontIsA != 0u;
    const b8 opaqueTemporalActive = this.m_rayTracingState.softShadow.m_softShadowTemporalReady;
    const b8 temporalHistoryReadable = this.softShadowTemporalHistoryUsable();

    SoftShadowTemporalMergeRecorder mergeRecorder(
        this.m_rayTracingState, slotRangeCount, softHalfWidth, softHalfHeight, softGroupsX, softGroupsY, temporalHistoryReadable,
        commandList, targets, heap
    );

    if(dispatchOpaqueResolve || dispatchOpaqueResolveTail){
        const ShadowReprojectMergeHeapResources opaqueMerge = SelectOpaqueMergeResources(targets, frontIsA);
        if(ShouldDispatchOpaqueTemporalMerge(dispatchOpaqueResolve, opaqueTemporalActive, opaquePhase)){
            GpuTimingMeasure opaqueTemporalTiming(this.m_graphics.gpuTiming(), s_TimingScopeShadowOpaqueTemporal, this.m_graphics.getDevice(), commandList);

            mergeRecorder.record(opaqueMerge, graphOwnsOpaqueTraceToFirstWaveletBoundary, graphOwnsOpaqueGeometryToResolveBoundary, graphOwnsOpaqueTemporalMergeEntryStates, graphOwnsOpaqueTemporalMergeEntryStates);
        }

        if(opaquePhase != SoftShadowOpaqueResolvePhase::TemporalOnly){
            OpaqueSoftShadowResolveOptions opaqueOptions;
            opaqueOptions.frontIsA = frontIsA;
            opaqueOptions.temporalActive = opaqueTemporalActive;
            opaqueOptions.graphOwnsGeometryEntry = graphOwnsOpaqueGeometryToResolveBoundary;
            opaqueOptions.graphOwnsTraceToFirstWavelet = graphOwnsOpaqueTraceToFirstWaveletBoundary;
            opaqueOptions.dispatchResolve = dispatchOpaqueResolve;
            opaqueOptions.dispatchResolveTail = dispatchOpaqueResolveTail;
            opaqueOptions.phase = opaquePhase;
            const SoftShadowResolveDispatch opaqueDispatch = BuildOpaqueSoftShadowDispatch(opaqueOptions, this.m_rayTracingState, targets);
            if(dispatchOpaqueResolve && dispatchOpaqueResolveTail){
                GpuTimingMeasure opaqueResolveTiming(this.m_graphics.gpuTiming(), s_TimingScopeShadowOpaqueResolve, this.m_graphics.getDevice(), commandList);

                this.dispatchSoftShadowResolve(commandList, targets, deferredLightingResources, 0u, slotRangeCount, opaqueDispatch);
            }
            else if(dispatchOpaqueResolve)
                this.dispatchSoftShadowResolve(commandList, targets, deferredLightingResources, 0u, slotRangeCount, opaqueDispatch, true, false);
            else
                this.dispatchSoftShadowResolve(commandList, targets, deferredLightingResources, 0u, slotRangeCount, opaqueDispatch, false, true);
        }
    }

    if(dispatchTransparentTrace && this.m_rayTracingState.softShadow.m_softTransparentReady){
        {
            GpuTimingMeasure transparentTraceTiming(this.m_graphics.gpuTiming(), s_TimingScopeShadowTransparentTrace, this.m_graphics.getDevice(), commandList);

            if(this.hardwareTransparentShadowReady())
                this.dispatchHardwareTransparentShadow(commandList, targets, frameIndex);
            else{
                SoftwareTransparentShadowTraceInputs traceInputs;
                traceInputs.frameIndex = frameIndex;
                traceInputs.sampleCount = this.transparentShadowSampleCount();
                traceInputs.groupsX = softGroupsX;
                traceInputs.groupsY = softGroupsY;
                traceInputs.graphOwnsOpaqueToTransparentBoundary = graphOwnsOpaqueToTransparentBoundary;
                traceInputs.temporalHistoryReadable = temporalHistoryReadable;
                traceInputs.historyFrontIsA = frontIsA;
                RecordSoftwareTransparentShadowTrace(traceInputs, this.m_rayTracingState, commandList, targets, heap);
                this.reportTransparentShadowSampling(traceInputs.sampleCount);
            }
        }
    }

    const b8 dispatchTransparentWavelet = dispatchTransparentResolve || dispatchTransparentResolveTail;
    const b8 dispatchTransparentMerge = ShouldDispatchTransparentTemporalMerge(dispatchTransparentTemporalMerge, dispatchTransparentResolve, splitTransparentResolve);
    if((dispatchTransparentMerge || dispatchTransparentWavelet) && this.m_rayTracingState.softShadow.m_softTransparentReady){
        const b8 transparentTemporalActive = this.m_rayTracingState.softShadow.m_softTransparentTemporalReady;
        const ShadowReprojectMergeHeapResources transparentMerge = SelectTransparentMergeResources(targets, frontIsA);
        if(dispatchTransparentMerge && transparentTemporalActive){
            GpuTimingMeasure transparentTemporalTiming(this.m_graphics.gpuTiming(), s_TimingScopeShadowTransparentTemporal, this.m_graphics.getDevice(), commandList);

            mergeRecorder.record(transparentMerge, graphOwnsTransparentTraceToResolveBoundary, graphOwnsTransparentTemporalMergeEntryStates, graphOwnsTransparentTemporalMergeEntryStates, graphOwnsTransparentTemporalMergeEntryStates);
            this.m_rayTracingState.softShadow.m_transparentShadowSamplingHistory.record(this.m_rayTracingState.softShadow.m_softShadowSlotMask);
        }

        if(dispatchTransparentWavelet){
            TransparentSoftShadowResolveOptions transparentOptions;
            transparentOptions.frontIsA = frontIsA;
            transparentOptions.temporalActive = transparentTemporalActive;
            transparentOptions.dispatchResolve = dispatchTransparentResolve;
            transparentOptions.dispatchResolveTail = dispatchTransparentResolveTail;
            transparentOptions.splitResolve = splitTransparentResolve;
            transparentOptions.dispatchTemporalMerge = dispatchTransparentTemporalMerge;
            transparentOptions.graphOwnsTraceToResolve = graphOwnsTransparentTraceToResolveBoundary;
            const SoftShadowResolveDispatch transparentDispatch = BuildTransparentSoftShadowDispatch(transparentOptions, this.m_rayTracingState, targets);
            if(dispatchTransparentResolve && !splitTransparentResolve){
                GpuTimingMeasure transparentResolveTiming(this.m_graphics.gpuTiming(), s_TimingScopeShadowTransparentResolve, this.m_graphics.getDevice(), commandList);

                this.dispatchSoftShadowResolve(commandList, targets, deferredLightingResources, 0u, slotRangeCount, transparentDispatch);
            }
            else if(dispatchTransparentResolve)
                this.dispatchSoftShadowResolve(commandList, targets, deferredLightingResources, 0u, slotRangeCount, transparentDispatch, true, false);
            else
                this.dispatchSoftShadowResolve(commandList, targets, deferredLightingResources, 0u, slotRangeCount, transparentDispatch, false, true);
        }
    }

    if(ShouldAdvanceSoftShadowTemporalHistory(dispatchTransparentResolve, splitTransparentResolve, dispatchTransparentResolveTail, this.m_rayTracingState.softShadow.m_softShadowTemporalReady))
        this.m_rayTracingState.softShadow.m_softShadowTemporalHistoryAdvancePending = true;
}

void RendererRayTracingSystem::reportSoftwareShadowTraversal(in DeferredFrameTargets targets){
    LogSoftwareShadowTraversalDispatchIfNeeded(
        targets.width,
        targets.height,
        this.m_rayTracingState.sceneBvh.m_sceneBvhInstanceCount,
        this.m_rayTracingState.shadow.m_swShadowDispatchLogged
    );
}

b8 RendererRayTracingSystem::softShadowTemporalHistoryUsable()const{
    return SoftShadowTemporalHistoryUsable(this.m_rayTracingState.softShadow.m_softShadowTemporalReady, this.m_rayTracingState.softShadow.m_prevWorldToClipValid, this.m_rayTracingState.softShadow.m_softShadowTemporalSeeded);
}

void RendererRayTracingSystem::swapSoftShadowTemporalHistory(mut DeferredFrameTargets targets){
    if(!this.m_rayTracingState.softShadow.m_softShadowTemporalReady)
        return;

    const auto acceptedWorldToClip = this.m_meshSystem.snapshotAcceptedMeshViewWorldToClip();
    if(acceptedWorldToClip.has_value()){
        this.m_rayTracingState.softShadow.m_prevWorldToClip = acceptedWorldToClip.value();
        this.m_rayTracingState.softShadow.m_prevWorldToClipValid = true;
    }
    if(this.m_rayTracingState.softShadow.m_softTransparentTemporalReady && !this.hardwareTransparentShadowReady())
        this.m_rayTracingState.shadow.m_softwareTransparentSampling.m_history.accept();
    else
        this.m_rayTracingState.shadow.m_softwareTransparentSampling.m_history.discard();
    this.m_rayTracingState.softShadow.m_transparentShadowSamplingHistory.accept();
    this.m_rayTracingState.softShadow.m_softShadowTemporalSeeded = true;
    Swap(targets.shadowSoftGeometry, targets.shadowSoftGeometryPrev);
    Swap(targets.bindless.shadowSoftGeometry, targets.bindless.shadowSoftGeometryPrev);
    Swap(targets.bindless.shadowSoftGeometryStorage, targets.bindless.shadowSoftGeometryPrevStorage);
    this.m_rayTracingState.softShadow.m_softShadowHistoryFrontIsA = ToggleSoftShadowHistoryFrontFlag(this.m_rayTracingState.softShadow.m_softShadowHistoryFrontIsA);
}


