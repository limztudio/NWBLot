#include <impl/ecs_render/material/renderer_pipeline_types.adhd>
#include <impl/ecs_render/raytrace/raytracing_system.adhd>
#include <impl/ecs_render/shadow/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_MinimumShadowMaterialTypedByteCount = 4u;

b8 IsValidPreparedShadowMaterialContextRoute(in PreparedShadowMaterialContextRoute route){
    return route == PreparedShadowMaterialContextRoute::Hardware || route == PreparedShadowMaterialContextRoute::Software;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[modular]
class ShadowMaterialContextPreparer : NoCopy{
    private mut RendererRayTracingSystem m_system;

    public ShadowMaterialContextPreparer(mut RendererRayTracingSystem system){
        this.m_system = system;
    }

    public Expected<u64> prepareWithTypedHash(
        in PreparedShadowMaterialContextRoute route,
        in b8 staticScene,
        in usize sceneInstanceCount,
        in Span<NwbRtInstanceMaterialGpu> instanceMaterials,
        in Span<InstanceGpuData> shadowInstanceData,
        mut MaterialTypedByteDataVector shadowMaterialTypedBytes,
        mut u64 outMaterialTypedHash
    ){
        if(!IsValidPreparedShadowMaterialContextRoute(route))
            return MakeUnexpected(Failure());
        if(shadowMaterialTypedBytes.empty())
            shadowMaterialTypedBytes.resize(s_MinimumShadowMaterialTypedByteCount, 0u);
        const Span<u8> typedSpan = Span<u8>(shadowMaterialTypedBytes);
        outMaterialTypedHash = UpdateFnv64(s_Fnv64OffsetBasis, typedSpan);
        return this.prepareBytes(route, staticScene, sceneInstanceCount, instanceMaterials, shadowInstanceData, typedSpan, outMaterialTypedHash);
    }

    public Expected<u64> prepare(
        in PreparedShadowMaterialContextRoute route,
        in b8 staticScene,
        in usize sceneInstanceCount,
        in Span<NwbRtInstanceMaterialGpu> instanceMaterials,
        in Span<InstanceGpuData> shadowInstanceData,
        mut MaterialTypedByteDataVector shadowMaterialTypedBytes
    ){
        u64 materialTypedHash = 0u;
        return this.prepareWithTypedHash(route, staticScene, sceneInstanceCount, instanceMaterials, shadowInstanceData, shadowMaterialTypedBytes, materialTypedHash);
    }

    private Expected<u64> prepareBytes(
        in PreparedShadowMaterialContextRoute route,
        in b8 staticScene,
        in usize sceneInstanceCount,
        in Span<NwbRtInstanceMaterialGpu> instanceMaterials,
        in Span<InstanceGpuData> shadowInstanceData,
        in Span<u8> shadowMaterialTypedBytes,
        in u64 materialTypedHash
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

