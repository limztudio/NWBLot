void VerifyAssetsGraphics_MeshFailedReloadPreservesEveryPreviouslyPublishedStream(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    const Expected<CookCase> cookCase = PrepareCookCase(testArena, "mesh_failed_reload");
    ASSERT_TRUE(cookCase.has_value());
    const CookCase prepared = cookCase.value();

    MeshAsset mesh(testArena.arena);
    ASSERT_TRUE(CookAndLoadSmokeMeshInto("uv_seam_quad.nwb", Name(s_AssetCaseProjectMeshesUvSeamQuad), prepared, testArena, mesh));

    MeshAssetCodec codec = MeshAssetCodec();
    AssetBytes original = MakeAssetBytes(testArena);
    ASSERT_TRUE(SerializeMeshAsset(codec, mesh, original));

    for(u32 invalidCase = 0u; invalidCase < 4u; ++invalidCase){
        const ScopedTestTrace trace(invalidCase);
        AssetBytes malformed = MakeAssetBytes(testArena);
        CopyAssetBytes(original, malformed);
        if(invalidCase == 0u)
            malformed[0u] = malformed[0u] ^ 1u;
        else if(invalidCase == 1u)
            malformed.pop_back();
        else if(invalidCase == 2u)
            malformed.push_back(0u);
        else
            ASSERT_TRUE(OverwriteU32InAssetBytes(0u, 0x4D534837u, malformed));

        EXPECT_FALSE(LoadMeshAssetBinary(mesh, malformed));
        AssetBytes retained = MakeAssetBytes(testArena);
        ASSERT_TRUE(SerializeMeshAsset(codec, mesh, retained));
        EXPECT_EQ(retained, original);
    }
    EXPECT_TRUE(RemoveAllIfExists(prepared.root));
}

void VerifyAssetsGraphics_MeshCookerPreservesFlatAndNestedIndexCornerOrder(){
    Vector<StringView> indexLists = Vector<StringView>();
    indexLists.reserve(2u);
    indexLists.push_back("[2, 0, 1]");
    indexLists.push_back("[[], [2, [], [0]], [[], 1], []]");

    Vector<f32x3u> expectedPositions = Vector<f32x3u>();
    expectedPositions.reserve(3u);
    expectedPositions.push_back(f32x3u(0.0f, 0.5f, 0.0f));
    expectedPositions.push_back(f32x3u(-0.5f, -0.5f, 0.0f));
    expectedPositions.push_back(f32x3u(0.5f, -0.5f, 0.0f));

    for(in StringView indexList : indexLists){
        const ScopedTestTrace trace(indexList);
        CapturingLogger logger = CapturingLogger();
        LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
        TestArena testArena = TestArena();
        const Expected<CookCase> cookCase = PrepareCookCase(testArena, "mesh_index_corner_order");
        ASSERT_TRUE(cookCase.has_value());
        const CookCase prepared = cookCase.value();

        const TestAString meta = BuildMeshIndexMeta(indexList);
        ASSERT_TRUE(CookSingleMeshMeta(ViewTestString(meta), prepared, testArena));

        ScratchArena scratchArena(s_AssetCaseTestsIntegrationAssetsGraphicsMeshIndexCornerOrder);
        MeshAsset mesh(testArena.arena);
        {
            Expected<MeshAsset> loadedMesh = LoadCookedMeshAsset(testArena, prepared.outputDirectory, Name(s_AssetCaseProjectMeshesMinimalMesh), 1u);
            ASSERT_TRUE(loadedMesh.has_value());
            mesh = loadedMesh.value();
        }
        const Expected<ScratchU32Vector> triangleIndices = BuildTestMeshletTriangleIndices(mesh, scratchArena);
        ASSERT_TRUE(triangleIndices.has_value());
        ASSERT_EQ(triangleIndices.value().size(), 3u);

        Vector<f32x3u> actualPositions = Vector<f32x3u>();
        actualPositions.reserve(3u);
        for(usize corner = 0u; corner < 3u; ++corner){
            const u32 posIndex = triangleIndices.value()[corner];
            ASSERT_LT(cast<usize>(posIndex), mesh.positionStream().size());
            actualPositions.push_back(mesh.positionStream()[posIndex]);
        }
        ASSERT_EQ(actualPositions.size(), 3u);
        for(usize corner = 0u; corner < 3u; ++corner){
            EXPECT_EQ(actualPositions[corner].x, expectedPositions[corner].x);
            EXPECT_EQ(actualPositions[corner].y, expectedPositions[corner].y);
            EXPECT_EQ(actualPositions[corner].z, expectedPositions[corner].z);
        }
        EXPECT_EQ(logger.errorCount(), 0u);
        EXPECT_TRUE(RemoveAllIfExists(prepared.root));
    }
}

void VerifyAssetsGraphics_MeshCookerReportsFirstInvalidNestedIndex(){
    if(AssetsGraphicsTestConfigurationName() != "fin")
        return;

    Vector<MeshIndexDiagnosticCase> cases = Vector<MeshIndexDiagnosticCase>();
    cases.reserve(3u);
    cases.push_back(MeshIndexDiagnosticCase("[[], [2, [\"bad\", -1]], 4294967296]", "'indices[1][1][0]' must contain only integer values"));
    cases.push_back(MeshIndexDiagnosticCase("[[], [2, [-1, \"later\"]], 4294967296]", "'indices[1][1][0]' contains a non-integer or negative value"));
    cases.push_back(MeshIndexDiagnosticCase("[[], [2, [4294967296, \"later\"]], -1]", "'indices[1][1][0]' contains a value that exceeds u32"));

    for(in MeshIndexDiagnosticCase testCase : cases){
        const ScopedTestTrace trace(testCase.m_indices);
        CapturingLogger logger = CapturingLogger();
        LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
        TestArena testArena = TestArena();
        const Expected<CookCase> cookCase = PrepareCookCase(testArena, "invalid_nested_mesh_index");
        ASSERT_TRUE(cookCase.has_value());
        const CookCase prepared = cookCase.value();
        const TestAString meta = BuildMeshIndexMeta(testCase.m_indices);
        const b8 cooked = CookSingleMeshMeta(ViewTestString(meta), prepared, testArena);
        EXPECT_FALSE(cooked);
        EXPECT_TRUE(RemoveAllIfExists(prepared.root));
        EXPECT_TRUE(SawCapturedError(logger, testCase.m_diagnostic));
        EXPECT_FALSE(SawCapturedError(logger, "'indices[1][1][1]'"));
        EXPECT_FALSE(SawCapturedError(logger, "'indices[2]'"));
    }
}

void VerifyAssetsGraphics_MeshCookerValidationFailures(){
    if(AssetsGraphicsTestConfigurationName() != "fin")
        return;

    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_ReportOnly);
    TestArena testArena = TestArena();

    ExpectMeshCookFailure(s_UnsupportedMeshFieldsMeta, "unsupported_mesh_fields", testArena);
    ExpectMeshCookFailure(s_MismatchedMeshMeta, "mismatched_mesh_streams", testArena);
    ExpectMeshCookFailure(ViewTestString(BuildMeshTriangleMeta("", s_TriangleTangentsField, s_TriangleVertexRefsField)), "missing_mesh_normal_field", testArena);
    ExpectMeshCookFailure(ViewTestString(BuildMeshTriangleMeta(s_TriangleNormalsField, s_TriangleTangentsField, s_TriangleMissingNormalVertexRefsField)), "missing_mesh_normal_vertex_ref", testArena);
    ExpectMeshCookFailure(ViewTestString(BuildMeshTriangleMeta(s_EmptyNormalListField, s_TriangleTangentsField, s_TriangleVertexRefsField)), "empty_list_mesh_normal", testArena);
    ExpectMeshCookFailure(ViewTestString(BuildMeshTriangleMeta(s_EmptyNormalMapField, s_TriangleTangentsField, s_TriangleVertexRefsField)), "empty_map_mesh_normal", testArena);
    ExpectMeshCookFailure(ViewTestString(BuildMeshTriangleMeta(s_TriangleNormalsField, "", s_TriangleVertexRefsField)), "missing_mesh_tangent_field", testArena);
    ExpectMeshCookFailure(ViewTestString(BuildMeshTriangleMeta(s_TriangleNormalsField, s_TriangleTangentsField, s_TriangleMissingTangentVertexRefsField)), "missing_mesh_tangent_vertex_ref", testArena);
    ExpectMeshCookFailure(ViewTestString(BuildMeshTriangleMeta(s_TriangleNormalsField, s_EmptyTangentListField, s_TriangleVertexRefsField)), "empty_list_mesh_tangent", testArena);
    ExpectMeshCookFailure(ViewTestString(BuildMeshTriangleMeta(s_TriangleNormalsField, s_EmptyTangentMapField, s_TriangleVertexRefsField)), "empty_map_mesh_tangent", testArena);

    EXPECT_GE(logger.errorCount(), 10u);
    EXPECT_TRUE(SawCapturedError(logger, "unsupported asset field"));
    EXPECT_TRUE(SawCapturedError(logger, "'uv0' must be a list"));
    EXPECT_TRUE(SawCapturedError(logger, "'normals' must be a list"));
    EXPECT_TRUE(SawCapturedError(logger, "vertex_ref normal index is out of range"));
    EXPECT_TRUE(SawCapturedError(logger, "'normals' must not be empty"));
    EXPECT_TRUE(SawCapturedError(logger, "'tangents' must be a list"));
    EXPECT_TRUE(SawCapturedError(logger, "vertex_ref tangent index is out of range"));
    EXPECT_TRUE(SawCapturedError(logger, "'tangents' must not be empty"));
}

void VerifyAssetsGraphics_ObjectGeometryMetadataRejectsRetiredVertexSourceSelectors(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_ShaderScratchArena);
    const Expected<GraphicsTestPath> rootResult = PrepareCaseRoot(testArena, "object_geometry_metadata");
    ASSERT_TRUE(rootResult.has_value());
    const GraphicsTestPath root = rootResult.value();

    const GraphicsTestPath metadataPath = JoinGraphicsPath(root, "shader.nwb");
    ASSERT_TRUE(WriteTextFile(JoinGraphicsPath(root, "shader.slang"), "void main(){}\n"));

    Vector<ObjectGeometryCase> cases = Vector<ObjectGeometryCase>();
    cases.reserve(8u);
    cases.push_back(ObjectGeometryCase("mesh_shader", "", true));
    cases.push_back(ObjectGeometryCase("pixel_shader", "", true));
    cases.push_back(ObjectGeometryCase("mesh_shader", "asset.mesh_object_vertex = \"object_vs.slang\";\n", false));
    cases.push_back(ObjectGeometryCase("mesh_shader", "asset.mesh_object_vertex = \"\";\n", false));
    cases.push_back(ObjectGeometryCase("compute_shader", "asset.mesh_object_vertex = \"object_vs.slang\";\n", false));
    cases.push_back(ObjectGeometryCase("vertex_shader", "asset.mesh_object_vertex = \"object_vs.slang\";\n", false));
    cases.push_back(ObjectGeometryCase("pixel_shader", "asset.mesh_object_vertex = \"object_vs.slang\";\n", false));
    cases.push_back(ObjectGeometryCase("mesh_shader", "asset.mesh_object_cull = \"object_cull_cs.slang\";\n", false));

    ShaderCook shaderCook(testArena.arena);
    for(in ObjectGeometryCase testCase : cases){
        const ScopedTestTrace traceType(testCase.m_shaderType);
        const ScopedTestTrace traceFields(testCase.m_fields);
        TestAString metadata = TestAString();
        metadata.append(testCase.m_shaderType);
        metadata.append(" asset;\nasset.entry_point = \"main\";\n");
        metadata.append(testCase.m_fields);
        ASSERT_TRUE(WriteTextFile(metadataPath, ViewTestString(metadata)));
        const u32 priorErrors = logger.errorCount();
        EXPECT_EQ(CanParseShaderEntryFile(metadataPath, testArena, scratchArena, shaderCook), testCase.m_accepted);
        if(testCase.m_accepted)
            EXPECT_EQ(logger.errorCount(), priorErrors);
        else
            EXPECT_GT(logger.errorCount(), priorErrors);
    }
    EXPECT_TRUE(RemoveAllIfExists(root));
}


