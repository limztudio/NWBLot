const StringView s_PhysicsShaderNpComplexVariant = "NWB_PHYSICS_NP_PROFILE=1";
const StringView s_PhysicsShaderNpBulletToiVariant = "NWB_PHYSICS_NP_PROFILE=2";
const StringView s_PhysicsShaderIslandSmallVariant = "NWB_PHYSICS_ISLAND_TIER=0";
const StringView s_PhysicsShaderIslandLargeVariant = "NWB_PHYSICS_ISLAND_TIER=1";
