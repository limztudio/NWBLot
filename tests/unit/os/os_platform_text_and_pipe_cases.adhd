void VerifyClipboardPipe_PartialUnicodeStaysPendingUntilValidEof(){
    ClipboardPipeContext ctx = ClipboardPipeContext();
    ASSERT_TRUE(ctx.openPipe());
    ASSERT_EQ(ctx.writeRaw("\xED"), 1);
    const Expected<b8, ClipboardPipeReadFailure> step1 = ctx.readPipe();
    ASSERT_TRUE(step1.has_value());
    EXPECT_FALSE(step1.value());

    ASSERT_EQ(ctx.writeRaw("\x95\x9C\xF0\x9F"), 4);
    const Expected<b8, ClipboardPipeReadFailure> step2 = ctx.readPipe();
    ASSERT_TRUE(step2.has_value());
    EXPECT_FALSE(step2.value());

    ASSERT_EQ(ctx.writeRaw("\x98\x80"), 2);
    ctx.closeWriteEnd();
    const Expected<b8, ClipboardPipeReadFailure> step3 = ctx.readPipe();
    ASSERT_TRUE(step3.has_value());
    EXPECT_TRUE(step3.value());
    EXPECT_EQ(ctx.receivedText(), "\xED\x95\x9C\xF0\x9F\x98\x80");
}

void VerifyClipboardPipe_TruncatedUnicodeIsRejectedAtEof(){
    ClipboardPipeContext ctx = ClipboardPipeContext();
    ASSERT_TRUE(ctx.openPipe());
    ASSERT_EQ(ctx.writeRaw("\xF0\x9F"), 2);
    ctx.closeWriteEnd();
    const Expected<b8, ClipboardPipeReadFailure> finished = ctx.readPipe();
    ASSERT_FALSE(finished.has_value());
    EXPECT_EQ(finished.error().status, ClipboardStatus::InvalidText);
    EXPECT_TRUE(finished.error().finished);
}

void VerifyClipboardPipe_WriterOwnsLargeInputAndResumesAfterFullPipe(){
    ClipboardPipeContext ctx = ClipboardPipeContext();
    ASSERT_TRUE(ctx.openPipe());
    FillGlobalString(ctx.input, 2u * 1024u * 1024u, 0x78u);
    AssignGlobalString(ctx.expected, ViewGlobalString(ctx.input));
    const i32 writeFd = ctx.releaseWriteFd();
    ASSERT_TRUE(ctx.beginWriter(writeFd, ViewGlobalString(ctx.input)));
    AssignGlobalString(ctx.input, "caller changed bytes");

    const i32 writerFlags = ctx.queryFdFlags(writeFd);
    ASSERT_GE(writerFlags, 0);
    ASSERT_TRUE(ctx.hasNonblockFlag(writerFlags));
    for(usize attempt = 0u; attempt < 64u; ++attempt)
        ASSERT_EQ(ctx.advanceWriter(), ClipboardStatus::Success);
    ASSERT_FALSE(ctx.writerFinished());
    ASSERT_EQ(ctx.pollPipeWritable(writeFd), 0);

    b8 finished = false;
    for(usize attempt = 0u; attempt < 4096u && !finished; ++attempt){
        const Expected<b8, ClipboardPipeReadFailure> read = ctx.readPipe();
        ASSERT_TRUE(read.has_value());
        finished = read.value();
        ASSERT_EQ(ctx.advanceWriter(), ClipboardStatus::Success);
    }
    EXPECT_TRUE(finished);
    EXPECT_TRUE(ctx.writerFinished());
    EXPECT_EQ(ctx.receivedText(), ViewGlobalString(ctx.expected));
}

void VerifyClipboardPipe_ClosedReaderFailsWithoutSigpipeOrChangingThreadMask(){
    ClipboardPipeContext ctx = ClipboardPipeContext();
    ASSERT_TRUE(ctx.openPipe());
    ctx.closeReadEnd();
    i32 beforeStatus = -1;
    i32 beforeSigpipe = -1;
    native(mut beforeStatus, mut beforeSigpipe){
#if defined(FOUNDATION_PLATFORM_LINUX)
        sigset_t before;
        beforeStatus = static_cast<i32>(pthread_sigmask(SIG_BLOCK, nullptr, &before));
        if(beforeStatus == 0)
            beforeSigpipe = static_cast<i32>(sigismember(&before, SIGPIPE));
#endif
    }
    ASSERT_EQ(beforeStatus, 0);
    ASSERT_TRUE(ctx.beginWriter(ctx.releaseWriteFd(), "reader is gone"));
    EXPECT_EQ(ctx.advanceWriter(), ClipboardStatus::NativeFailure);
    EXPECT_TRUE(ctx.writerFinished());

    i32 afterStatus = -1;
    i32 afterSigpipe = -2;
    native(mut afterStatus, mut afterSigpipe){
#if defined(FOUNDATION_PLATFORM_LINUX)
        sigset_t after;
        afterStatus = static_cast<i32>(pthread_sigmask(SIG_BLOCK, nullptr, &after));
        if(afterStatus == 0)
            afterSigpipe = static_cast<i32>(sigismember(&after, SIGPIPE));
#endif
    }
    ASSERT_EQ(afterStatus, 0);
    EXPECT_EQ(beforeSigpipe, afterSigpipe);
}

void VerifyClipboardPipe_WriterCanBeReusedForEmptyAndShorterTransfers(){
    ClipboardPipeContext ctx = ClipboardPipeContext();
    ASSERT_TRUE(ctx.openPipe());
    ASSERT_TRUE(ctx.beginWriter(ctx.releaseWriteFd(), "old long contents"));
    ASSERT_EQ(ctx.advanceWriter(), ClipboardStatus::Success);
    ASSERT_TRUE(ctx.writerFinished());
    const Expected<b8, ClipboardPipeReadFailure> firstFinished = ctx.readPipe();
    ASSERT_TRUE(firstFinished.has_value());
    ASSERT_TRUE(firstFinished.value());
    EXPECT_EQ(ctx.receivedText(), "old long contents");

    ASSERT_TRUE(ctx.openPipe());
    ASSERT_TRUE(ctx.beginWriter(ctx.releaseWriteFd(), StringView()));
    ASSERT_EQ(ctx.advanceWriter(), ClipboardStatus::Success);
    ASSERT_TRUE(ctx.writerFinished());
    ctx.clearReceived();
    const Expected<b8, ClipboardPipeReadFailure> emptyFinished = ctx.readPipe();
    ASSERT_TRUE(emptyFinished.has_value());
    EXPECT_TRUE(emptyFinished.value());
    EXPECT_TRUE(ctx.receivedText().empty());

    ASSERT_TRUE(ctx.openPipe());
    ASSERT_TRUE(ctx.beginWriter(ctx.releaseWriteFd(), "new"));
    ASSERT_EQ(ctx.advanceWriter(), ClipboardStatus::Success);
    ASSERT_TRUE(ctx.writerFinished());
    ctx.clearReceived();
    const Expected<b8, ClipboardPipeReadFailure> lastFinished = ctx.readPipe();
    ASSERT_TRUE(lastFinished.has_value());
    EXPECT_TRUE(lastFinished.value());
    EXPECT_EQ(ctx.receivedText(), "new");
}


