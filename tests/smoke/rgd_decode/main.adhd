#include <tests/common/gtest_macros.adhd>
#include <tests/common/test_context.adhd>

native{
#include <logger/rgd/decode.h>

#include <global/diagnostics.h>
#include <global/filesystem.h>
#include <global/scope_exit.h>
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_RgdCleanupDiagnosticCategory = "rgd_decode_test_cleanup";
const StringView s_RgdMissingPath = "nwb_rgd_smoke_missing.rgd";
const StringView s_RgdGarbagePath = "nwb_rgd_smoke_garbage.rgd";
const StringView s_RgdEmptyContainerPath = "nwb_rgd_smoke_empty_container.rgd";
const StringView s_RgdGarbagePayload = "not a valid radeon gpu detective capture\n";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<u8, StringView> ProbeRgdCrashDumpDecode(in StringView path){
    b8 succeeded = false;
    StringView errorText = "";
    native(in path, mut succeeded, mut errorText){
        const auto result = NWB::Log::Rgd::DecodeCrashDumpToText(path);
        if(result)
            succeeded = true;
        else
            errorText = result.error();
    }
    if(succeeded)
        return 1u;
    return MakeUnexpected(errorText);
}

void VerifyRgdFixtureRejectsPayload(in StringView fixturePath, in Span<u8> payload, in StringView cleanupFailureMessage, in StringView expectedError){
    b8 wroteFile = false;
    b8 removeCallSucceeded = false;
    b8 removedFile = false;
    b8 decodeSucceeded = false;
    StringView decodeError = "";
    native(in fixturePath, in payload, in cleanupFailureMessage, mut wroteFile, mut removeCallSucceeded, mut removedFile, mut decodeSucceeded, mut decodeError){
        NWB::Tests::TestArena<> testArena;
        ::Path<NWB::Core::Alloc::GlobalArena> inputPath(testArena.arena, fixturePath);
        ScopeExit cleanup([&inputPath, &cleanupFailureMessage]()noexcept{
            const auto removed = RemoveFile(inputPath);
            if(!removed)
                CaptureDiagnosticEvent(s_RgdCleanupDiagnosticCategory, cleanupFailureMessage, __FILE__, __LINE__);
        });
        wroteFile = static_cast<b8>(WriteBinaryFile(inputPath, payload));
        if(wroteFile){
            const auto result = NWB::Log::Rgd::DecodeCrashDumpToText(fixturePath);
            if(result)
                decodeSucceeded = true;
            else
                decodeError = result.error();
            const auto removed = RemoveFile(inputPath);
            if(removed){
                removeCallSucceeded = true;
                removedFile = *removed;
                cleanup.release();
            }
        }
    }
    ASSERT_TRUE(wroteFile);
    ASSERT_TRUE(removeCallSucceeded);
    EXPECT_TRUE(removedFile);
    ASSERT_FALSE(decodeSucceeded);
    EXPECT_EQ(decodeError, expectedError);
}

void VerifyRgdDecodeMissingFile(){
    const Expected<u8, StringView> result = ProbeRgdCrashDumpDecode(s_RgdMissingPath);
    ASSERT_FALSE(result.has_value());
    EXPECT_EQ(result.error(), StringView("rdf_open_failed"));
}

void VerifyRgdDecodeGarbageInput(){
    Vector<u8> payload;
    for(usize i = 0u; i < s_RgdGarbagePayload.size(); ++i)
        payload.push_back(cast<u8>(s_RgdGarbagePayload[i]));
    VerifyRgdFixtureRejectsPayload(s_RgdGarbagePath, payload, "Failed to remove garbage-input fixture", "parse_failed");
}

void VerifyRgdDecodeEmptyContainer(){
    Array<u8, 32u> emptyContainer;
    emptyContainer[0u] = 65u;
    emptyContainer[1u] = 77u;
    emptyContainer[2u] = 68u;
    emptyContainer[3u] = 95u;
    emptyContainer[4u] = 82u;
    emptyContainer[5u] = 68u;
    emptyContainer[6u] = 70u;
    emptyContainer[7u] = 32u;
    emptyContainer[8u] = 3u;
    emptyContainer[16u] = 32u;
    VerifyRgdFixtureRejectsPayload(s_RgdEmptyContainerPath, emptyContainer, "Failed to remove admitted-container fixture", "parse_failed");
}

NWB_ADHD_GTEST(RgdDecode, MissingFileFailsGracefully, VerifyRgdDecodeMissingFile)
NWB_ADHD_GTEST(RgdDecode, GarbageInputFailsGracefully, VerifyRgdDecodeGarbageInput)
NWB_ADHD_GTEST(RgdDecode, AdmittedContainerWithoutCrashChunksFailsGracefully, VerifyRgdDecodeEmptyContainer)


