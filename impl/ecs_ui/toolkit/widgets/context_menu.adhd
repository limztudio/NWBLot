////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/widgets/list.adhd>
#include <impl/ecs_ui/toolkit/widgets/popup.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ContextMenuState : NoCopy{
    public PopupState m_popup;
    public ListState m_list;
    public WidgetId m_owner;
    public WidgetId m_anchorWidget;
    public u64 m_ownerDeclaration = 0u;
    public u64 m_anchorDeclaration = 0u;
    public u64 m_revision = 1u;
    public Rect m_anchor;

    public b8 open(in Rect anchor){
        if(!IsValidUiRect(anchor))
            return false;
        this.m_popup.close();
        this.m_popup.open();
        this.m_list.select(0u);
        if(!this.m_list.scrollTo(0.0))
            TerminateInvariant();
        this.m_anchor = anchor;
        AdvanceNonWrappingRevision(this.m_revision);
        return true;
    }

    public void close(){
        this.m_popup.close();
        this.m_list.select(0u);
        AdvanceNonWrappingRevision(this.m_revision);
    }

    public b8 isOpen()const{
        return this.m_popup.isOpen();
    }

    public u64 instanceGeneration()const{
        return this.m_popup.instanceGeneration();
    }

    public u64 revision()const{
        return this.m_revision;
    }

    public u64 cursorKey()const{
        return this.m_list.cursorKey();
    }

    public in ListState listState()const{
        return this.m_list;
    }

    public in PopupPlacement placement()const{
        return this.m_popup.placement();
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

