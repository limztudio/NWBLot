#include <impl/assets_subsystem/asset.adhd>
#include <impl/assets_subsystem/subsystem_binary_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_SubsystemStringValueRequirement = "must be a string";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsReservedSubsystemFieldName(in StringView fieldName){
    return fieldName == s_SubsystemSubsystemsFieldName;
}

b8 IsSelfSubsystemReference(in Name subsystemVirtualPath, in Name referencedName){
    return referencedName == subsystemVirtualPath;
}

void ReportSubsystemSubsystemsFieldIsList(in Path nwbFilePath){
    error("{} '{}': '{}' must be a list of strings", s_SubsystemDiagnosticPrefix, nwbFilePath, s_SubsystemSubsystemsFieldName);
}

b8 ValidateSubsystemSubsystemsFieldIsList(in Path nwbFilePath, in b8 isList){
    if(isList)
        return true;

    ReportSubsystemSubsystemsFieldIsList(nwbFilePath);
    return false;
}

void ReportSelfSubsystemReference(in Path nwbFilePath, in Name subsystemVirtualPath){
    error(
        "{} '{}': '{}' cannot reference subsystem '{}' itself",
        s_SubsystemDiagnosticPrefix,
        nwbFilePath,
        s_SubsystemSubsystemsFieldName,
        subsystemVirtualPath.resolvedText()
    );
}

b8 ValidateNotSelfSubsystemReference(in Path nwbFilePath, in Name subsystemVirtualPath, in Name referencedName){
    if(!IsSelfSubsystemReference(subsystemVirtualPath, referencedName))
        return true;

    ReportSelfSubsystemReference(nwbFilePath, subsystemVirtualPath);
    return false;
}

void ReportRequiredSubsystemFieldMissing(in Path nwbFilePath, in StringView fieldName, in Name assetType){
    error(
        "{} '{}': required field '{}' is missing for '{}'",
        s_SubsystemDiagnosticPrefix,
        nwbFilePath,
        fieldName,
        assetType.resolvedText()
    );
}

b8 ValidateRequiredSubsystemFieldPresent(in Path nwbFilePath, in StringView fieldName, in Name assetType, in b8 present){
    if(present)
        return true;

    ReportRequiredSubsystemFieldMissing(nwbFilePath, fieldName, assetType);
    return false;
}

void ReportEmptySubsystemArrayField(in Path nwbFilePath, in StringView fieldName){
    error("{} '{}': '{}' must be a non-empty list of strings", s_SubsystemDiagnosticPrefix, nwbFilePath, fieldName);
}

b8 ValidateNonEmptySubsystemArrayField(in Path nwbFilePath, in StringView fieldName, in b8 validList){
    if(validList)
        return true;

    ReportEmptySubsystemArrayField(nwbFilePath, fieldName);
    return false;
}

void ReportDuplicateSubsystemArrayFieldEntry(in Path nwbFilePath, in StringView fieldName, in Name entryName){
    error(
        "{} '{}': '{}' contains duplicate entry '{}'",
        s_SubsystemDiagnosticPrefix,
        nwbFilePath,
        fieldName,
        entryName.resolvedText()
    );
}

b8 ValidateUniqueSubsystemArrayFieldEntry(in Path nwbFilePath, in StringView fieldName, in Name entryName, in b8 isDuplicate){
    if(!isDuplicate)
        return true;

    ReportDuplicateSubsystemArrayFieldEntry(nwbFilePath, fieldName, entryName);
    return false;
}

b8 ReadSubsystemParents(in Path file, in MetascriptValue value, mut ISubsystem subsystem){
    if(!ValidateSubsystemSubsystemsFieldIsList(file, value.isList()))
        return false;
    const Span<MetascriptValue> parents = value.listView();
    subsystem.editParentRefs().reserve(parents.size());
    for(in MetascriptValue parent : parents){
        const Expected<AssetRef<ISubsystem>> ref = ParseReservedAssetRefValue<ISubsystem>(
            file, s_SubsystemDiagnosticPrefix, s_SubsystemSubsystemsFieldName, parent, s_SubsystemStringValueRequirement
        );
        if(!ref.has_value() || !ValidateNotSelfSubsystemReference(file, subsystem.virtualPath(), ref.value().name()))
            return false;
        subsystem.editParentRefs().push_back(ref.value());
    }
    DeduplicateSubsystemRefs(subsystem.editParentRefs());
    return true;
}

b8 ReadSubsystemAssetField(
    in Path file, in MetascriptValue value, in usize index, in SubsystemFieldValueDescriptor descriptor, mut ISubsystem subsystem
){
    subsystem.clearFieldValues(index);
    if(!descriptor.isArray){
        const Expected<AssetRef<IAsset>> ref = ParseReservedAssetRefValue<IAsset>(
            file, s_SubsystemDiagnosticPrefix, descriptor.fieldName, value, s_SubsystemStringValueRequirement
        );
        if(!ref.has_value())
            return false;
        subsystem.appendFieldValue(index, ref.value().name());
        return true;
    }
    if(!ValidateNonEmptySubsystemArrayField(file, descriptor.fieldName, value.isList() && !value.listView().empty()))
        return false;

    for(in MetascriptValue item : value.listView()){
        const Expected<AssetRef<IAsset>> ref = ParseReservedAssetRefValue<IAsset>(
            file, s_SubsystemDiagnosticPrefix, descriptor.fieldName, item, s_SubsystemStringValueRequirement
        );
        if(!ref.has_value())
            return false;
        const Name name = ref.value().name();
        const usize count = subsystem.fieldValueCount(index);
        for(usize prev = 0u; prev < count; ++prev){
            if(subsystem.fieldValue(index, prev) == name)
                return ValidateUniqueSubsystemArrayFieldEntry(file, descriptor.fieldName, name, true);
        }
        subsystem.appendFieldValue(index, name);
    }
    return true;
}

b8 ParseSubsystemMetadataFields(in Path file, in MetascriptValue asset, mut ISubsystem subsystem){
    const usize count = subsystem.fieldCount();
    if(!ValidateMetadataAssetFields(file, asset, s_SubsystemDiagnosticPrefix, lambda[mut subsystem, in count](in StringView field) -> b8{
        if(IsReservedSubsystemFieldName(field))
            return true;
        for(usize i = 0u; i < count; ++i){
            if(field == subsystem.fieldDescriptor(i).fieldName)
                return true;
        }
        return false;
    }))
        return false;

    subsystem.editParentRefs().clear();
    b8 valid = true;
    asset.visitField(s_SubsystemSubsystemsFieldName, lambda[in file, mut subsystem, mut valid](in MetascriptValue value) -> void{
        valid = ReadSubsystemParents(file, value, subsystem);
    });
    if(!valid)
        return false;

    for(usize i = 0u; i < count; ++i){
        const SubsystemFieldValueDescriptor descriptor = subsystem.fieldDescriptor(i);
        const b8 found = asset.visitField(descriptor.fieldName, lambda[in file, in i, in descriptor, mut subsystem, mut valid](in MetascriptValue value) -> void{
            valid = ReadSubsystemAssetField(file, value, i, descriptor, subsystem);
        });
        if(!ValidateRequiredSubsystemFieldPresent(file, descriptor.fieldName, subsystem.assetType(), found) || !valid)
            return false;
    }
    return subsystem.validatePayload();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SubsystemCookPolicy{
    public StringView prefix()const{ return s_SubsystemDiagnosticPrefix; }
    public StringView kind()const{ return s_SubsystemAssetKindLabel; }
    public void registerType(in Name assetType)const{ RegisterCompositeRootAssetType(assetType); }

    public b8 read(in Path file, in MetascriptValue value, mut ISubsystem subsystem)const{
        return ParseSubsystemMetadataFields(file, value, subsystem);
    }

    public b8 validate(in ISubsystem subsystem)const{ return subsystem.validatePayload(); }

    public b8 collect(in ISubsystem subsystem, mut ICookDependencyCollector collector)const{
        for(in AssetRef<ISubsystem> ref : subsystem.parentRefs()){
            if(!collector.addAssetDependency(ref.name(), ISubsystem::AssetTypeName()))
                return false;
        }
        for(usize i = 0u; i < subsystem.fieldCount(); ++i){
            const SubsystemFieldValueDescriptor descriptor = subsystem.fieldDescriptor(i);
            const usize count = subsystem.fieldValueCount(i);
            for(usize element = 0u; element < count; ++element){
                if(!collector.addAssetDependency(subsystem.fieldValue(i, element), descriptor.expectedAssetType))
                    return false;
            }
        }
        return true;
    }
}

type SubsystemCookEntry<T> = PreparedAssetCookEntry<T>;
type SubsystemCookRegistration<T> = FamilyCookRegistration<ISubsystem, T, TypedSubsystemAssetCodec<T>, SubsystemCookPolicy>;


