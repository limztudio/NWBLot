void VerifyUiTextAreaViewTests_ZeroViewportDoesNotForceManualScrollToTheCaret(mut UiTextAreaViewTests self){
    ASSERT_TRUE(self.prepareDense());
    ASSERT_TRUE(self.manualPlace(Point(5.0f, 6.0f), 0.0f, 0.0f));
    EXPECT_FLOAT_EQ(self.m_placement.scroll, 5.0f);
    EXPECT_FLOAT_EQ(self.m_placement.scrollY, 6.0f);
    EXPECT_FLOAT_EQ(self.m_placement.content.width, 0.0f);
    EXPECT_FLOAT_EQ(self.m_placement.content.height, 0.0f);
    EXPECT_FLOAT_EQ(self.m_placement.clip.width, 0.0f);
    EXPECT_FLOAT_EQ(self.m_placement.clip.height, 0.0f);
    EXPECT_TRUE(self.m_view.ready());
}

void VerifyUiTextAreaViewTests_FailedManualArrangementPreservesThePriorPlacement(mut UiTextAreaViewTests self){
    ASSERT_TRUE(self.prepareDense());
    ASSERT_TRUE(self.manualPlace(Point(5.0f, 6.0f)));
    const EditBoxPlacement previous = self.m_placement;
    Array<Point, 3u> invalid;
    invalid[0u] = Point(-1.0f, 0.0f);
    invalid[1u] = Point(0.0f, bit_cast<f32>(s_UiTextScrollQuietNaNF32Bits));
    invalid[2u] = Point(bit_cast<f32>(s_UiTextScrollPosInfF32Bits), 0.0f);
    for(in Point scroll : invalid){
        EXPECT_FALSE(self.manualPlace(scroll));
        ExpectUiMultilineViewPlacement(self.m_placement, previous);
    }
    EXPECT_FALSE(self.m_view.arrange(Rect(10.0f, 20.0f, 20.0f, 12.0f), Insets(), Rect(0.0f, 0.0f, 500.0f, 500.0f), Point(5.0f, 6.0f), 0.0f, false).has_value());
    ExpectUiMultilineViewPlacement(self.m_placement, previous);
}


