    public void setAssetManager(mut AssetManager assetManager){
        this.m_assetManager = Optional<mut AssetManager>(assetManager);
        for(in auto kv : this.m_entityRecords){
            mut EcsEntityPhysicsRecord rec = this.m_entityRecords.at(kv.first);
            ClearFailedColliderAssets(rec);
        }
        this.m_syncScratch.failedCollisionLayerMatrixName = s_NameNone;
        this.m_syncScratch.failedRagdollAssets.clear();
        this.m_syncScratch.failedFractureAssets.clear();
        for(auto it = this.m_syncScratch.vehicleEventSyncStates.begin(); it != this.m_syncScratch.vehicleEventSyncStates.end(); ++it)
            it.value().failedVehicleAsset = s_NameNone;
        for(auto it = this.m_syncScratch.articulationLiveStates.begin(); it != this.m_syncScratch.articulationLiveStates.end(); ++it)
            it.value().failedArticulationAsset = s_NameNone;
        for(auto it = this.m_syncScratch.softBodySyncStates.begin(); it != this.m_syncScratch.softBodySyncStates.end(); ++it)
            it.value().failedSoftBodyAsset = s_NameNone;
        ReleaseEcsPhysicsAssetCache(this.m_assetCache, this.m_physicsWorld, true);
    }

