b8 InstantiateSceneLoadedEntity(in Name entityName, in Span<UniquePtr<IComponent>> components, mut World world){
    if(!ValidateSceneLoadedEntityHasComponents(!components.empty(), entityName))
        return false;
    Entity entity = world.createEntity();
    if(!ValidateCreatedSceneEcsEntity(entity.id(), entityName))
        return false;
    for(usize i = 0u; i < components.size(); ++i){
        if(!components[i].valid())
            return false;
        components[i].deref().applyToEntity(entity);
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


register_asset IComponent using AssetCodecRegistration<ComponentAssetCodec>;
register_asset TransformComponentAsset using TypedComponentAutoRegistrar<TransformComponentAsset>;
register_asset CameraComponentAsset using TypedComponentAutoRegistrar<CameraComponentAsset>;
register_asset LightComponentAsset using TypedComponentAutoRegistrar<LightComponentAsset>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void EnqueueSceneSubsystem(in SubsystemRef subsystem, mut HashSet<NameHash> seen, mut Vector<SubsystemRef> pending){
    if(subsystem.valid() && seen.insert(subsystem.name().hash()).second)
        pending.push_back(subsystem);
}

b8 ActiveSceneSubsystems::loadProjectStartScene(in AssetManager assetManager, in ProjectRef project){
    const auto loaded = LoadTypedAssetSync<ProjectAsset>(assetManager, project.name(), s_ActiveSceneSubsystemsDiagnosticOwner);
    if(!loaded.has_value())
        return false;
    return this.loadScene(loaded.value().deref().startScene(), assetManager);
}

b8 ActiveSceneSubsystems::loadScene(in SceneRef scene, in AssetManager assetManager){
    const auto loadedScene = LoadTypedAssetSync<SceneAsset>(assetManager, scene.name(), s_ActiveSceneSubsystemsDiagnosticOwner);
    if(!loadedScene.has_value())
        return false;
    in SceneAsset sceneAsset = loadedScene.value().deref();
    LoadedSceneContents next;
    next.scene = scene;
    next.assets = sceneAsset.assets();

    HashSet<NameHash> seen;
    Vector<SubsystemRef> pending;
    pending.reserve(sceneAsset.subsystems().size());
    for(in SubsystemRef subsystem : sceneAsset.subsystems())
        EnqueueSceneSubsystem(subsystem, seen, pending);

    next.subsystems.reserve(pending.size());
    for(usize i = 0u; i < pending.size(); ++i){
        const Name path = pending[i].name();
        auto loaded = assetManager.loadSync(ISubsystem::AssetTypeName(), path);
        if(!loaded.has_value()){
            LogSceneSubsystemLoadFailed(path);
            return false;
        }
        auto subsystem = TakeFamilyAsset<ISubsystem>(loaded.value());
        if(!subsystem.valid()){
            LogSceneAssetNotSubsystem(path);
            return false;
        }
        for(in UniquePtr<ISubsystem> existing : next.subsystems){
            if(existing.deref().assetType() == subsystem.deref().assetType()){
                LogSceneDuplicateSubsystemType(subsystem.deref().assetType(), scene.name());
                return false;
            }
        }
        for(in SubsystemRef parent : subsystem.deref().parentRefs())
            EnqueueSceneSubsystem(parent, seen, pending);
        next.subsystems.push_back(subsystem);
    }

    next.entities.reserve(sceneAsset.entities().size());
    for(in EntityRef ref : sceneAsset.entities()){
        const auto loadedEntity = LoadTypedAssetSync<EntityAsset>(assetManager, ref.name(), s_ActiveSceneSubsystemsDiagnosticOwner);
        if(!loadedEntity.has_value())
            return false;
        in EntityAsset entity = loadedEntity.value().deref();
        next.entities.push_back(LoadedSceneEntity());
        mut LoadedSceneEntity nextEntity = next.entities.back();
        nextEntity.entity = ref;
        nextEntity.components.reserve(entity.components().size());
        for(in ComponentRef componentRef : entity.components()){
            auto loaded = assetManager.loadSync(IComponent::AssetTypeName(), componentRef.name());
            if(!loaded.has_value()){
                LogSceneComponentLoadFailed(componentRef.name(), ref.name());
                return false;
            }
            auto component = TakeFamilyAsset<IComponent>(loaded.value());
            if(!component.valid()){
                LogSceneAssetNotComponent(componentRef.name());
                return false;
            }
            for(in UniquePtr<IComponent> existing : nextEntity.components){
                if(existing.deref().assetType() == component.deref().assetType()){
                    LogSceneDuplicateComponentType(component.deref().assetType(), ref.name());
                    return false;
                }
            }
            nextEntity.components.push_back(component);
        }
    }
    this.m_contents = next;
    return true;
}

b8 ActiveSceneSubsystems::instantiateEntities(mut World world)const{
    if(!ValidateSceneEntityInstantiationReady(this.valid()))
        return false;
    for(in LoadedSceneEntity entity : this.m_contents.entities){
        if(!InstantiateSceneLoadedEntity(entity.entity.name(), Span<UniquePtr<IComponent>>(entity.components), world))
            return false;
    }
    return true;
}


