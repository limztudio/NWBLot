void VerifyUiNestedPopupLifetimeTests_ParentReopeningRetiresTheOldPlainChildAndKeepsParentControls(mut UiNestedPopupLifetimeTests self){
    ASSERT_TRUE(self.acceptPlain(1u));
    ASSERT_TRUE(self.m_childVisible);
    const Optional<HitTarget> childTarget = self.findTarget(self.childId());
    ASSERT_TRUE(childTarget.has_value());
    const PopupToken oldChild = childTarget.value().popup;
    const u64 oldParentGeneration = self.m_parent.openGeneration();
    self.reopenParent();
    EXPECT_NE(self.m_parent.openGeneration(), oldParentGeneration);
    ASSERT_TRUE(self.acceptPlain(2u));
    EXPECT_FALSE(self.m_childVisible);
    EXPECT_FALSE(self.m_child.isOpen());
    EXPECT_FALSE(self.hasTarget(self.childId()));
    EXPECT_FALSE(self.hasTarget(RequireUiWidgetId(self.childId(), "apply")));
    EXPECT_TRUE(self.m_context.input().actions().empty());
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
    EXPECT_EQ(oldChild.openGeneration, self.m_child.openGeneration());
    self.expectParentControls();
}

void VerifyUiNestedPopupLifetimeTests_DeliberateChildReopeningAfterParentReopeningUsesANewPermittedLifetime(mut UiNestedPopupLifetimeTests self){
    ASSERT_TRUE(self.acceptPlain(1u));
    const Optional<HitTarget> oldChildTarget = self.findTarget(self.childId());
    ASSERT_TRUE(oldChildTarget.has_value());
    const PopupToken oldChild = oldChildTarget.value().popup;
    self.reopenParent();
    self.m_child.close();
    self.m_child.open();
    ASSERT_TRUE(self.acceptPlain(2u));
    EXPECT_TRUE(self.m_childVisible);
    EXPECT_TRUE(self.m_child.isOpen());
    const Optional<HitTarget> newChildTarget = self.findTarget(self.childId());
    ASSERT_TRUE(newChildTarget.has_value());
    const PopupToken newChild = newChildTarget.value().popup;
    EXPECT_EQ(newChild.instanceGeneration, oldChild.instanceGeneration);
    EXPECT_NE(newChild.openGeneration, oldChild.openGeneration);
    const WidgetId applyId = RequireUiWidgetId(self.childId(), "apply");
    const Optional<HitTarget> applyTarget = self.findTarget(applyId);
    ASSERT_TRUE(applyTarget.has_value());
    EXPECT_EQ(newChild, applyTarget.value().popup);
    EXPECT_EQ(self.m_context.input().focus(), applyId);
    self.expectParentControls();
}

void VerifyUiNestedPopupLifetimeTests_ParentReopeningClosesTheOldComboPopupAndPreservesItsCommittedKey(mut UiNestedPopupLifetimeTests self){
    self.m_state.select(2u);
    self.m_state.open();
    ASSERT_TRUE(self.acceptCombo(1u));
    ASSERT_TRUE(self.hasTarget(RequireUiWidgetId(self.fieldId(), "rows")));
    self.reopenParent();
    ASSERT_TRUE(self.acceptCombo(2u));
    EXPECT_TRUE(self.m_result.closed);
    EXPECT_FALSE(self.m_result.committed);
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_EQ(self.m_state.selectedKey(), 2u);
    EXPECT_FALSE(self.hasTarget(RequireUiWidgetId(self.fieldId(), "rows")));
    const Optional<HitTarget> fieldTarget = self.findTarget(self.fieldId());
    ASSERT_TRUE(fieldTarget.has_value());
    EXPECT_EQ(fieldTarget.value().popup.openGeneration, self.m_parent.openGeneration());
    self.expectParentControls();
}

void VerifyUiNestedPopupLifetimeTests_ExplicitComboOpeningAfterParentReopeningKeepsTheNewPopupOpen(mut UiNestedPopupLifetimeTests self){
    self.m_state.select(2u);
    self.m_state.open();
    ASSERT_TRUE(self.acceptCombo(1u));
    const WidgetId rowsId = RequireUiWidgetId(self.fieldId(), s_UiNestedPopupLifetimeComboRowsKey);
    const Optional<HitTarget> oldRowsTarget = self.findTarget(rowsId);
    ASSERT_TRUE(oldRowsTarget.has_value());
    const PopupToken oldCombo = oldRowsTarget.value().popup;
    self.reopenParent();
    self.m_state.open();
    ASSERT_TRUE(self.acceptCombo(2u));
    EXPECT_TRUE(self.m_state.isOpen());
    EXPECT_EQ(self.m_state.selectedKey(), 2u);
    const Optional<HitTarget> newRowsTarget = self.findTarget(rowsId);
    ASSERT_TRUE(newRowsTarget.has_value());
    EXPECT_NE(newRowsTarget.value().popup.openGeneration, oldCombo.openGeneration);
    EXPECT_EQ(newRowsTarget.value().popup.instanceGeneration, oldCombo.instanceGeneration);
    EXPECT_EQ(self.m_context.input().focus(), rowsId);
    self.expectParentControls();
}

void VerifyUiNestedPopupLifetimeTests_SearchParentReplacementCancelsStalePreeditAndPermitsAFreshOpening(mut UiNestedPopupLifetimeTests self){
    self.m_search.combo().select(2u);
    ASSERT_TRUE(self.m_search.query().setText(s_UiNestedPopupLifetimeSecondHalfQuery));
    self.m_search.combo().open();
    ASSERT_TRUE(self.acceptSearch(1u));
    const WidgetId queryId = RequireUiWidgetId(self.fieldId(), "query");
    const Optional<HitTarget> oldQueryTarget = self.findTarget(queryId);
    ASSERT_TRUE(oldQueryTarget.has_value());
    const PopupToken oldSearch = oldQueryTarget.value().popup;
    const u64 loans = self.m_host.loans;
    ASSERT_TRUE(self.m_search.query().beginComposition());
    ASSERT_TRUE(self.m_search.query().updateComposition("preedit", 0u, 7u));
    self.reopenParent();
    ASSERT_TRUE(self.acceptSearch(2u));
    EXPECT_TRUE(self.m_searchResult.combo.closed);
    EXPECT_FALSE(self.m_search.combo().isOpen());
    EXPECT_EQ(self.m_search.combo().selectedKey(), 2u);
    EXPECT_EQ(self.m_search.query().text(), s_UiNestedPopupLifetimeSecondHalfQuery);
    EXPECT_FALSE(self.m_search.query().composition().active);
    EXPECT_FALSE(self.m_search.editorState().focused);
    EXPECT_EQ(self.m_host.loans, loans);
    EXPECT_FALSE(self.hasTarget(queryId));
    self.expectParentControls();

    self.reopenParent();
    self.m_search.combo().open();
    ASSERT_TRUE(self.acceptSearch(3u));
    EXPECT_TRUE(self.m_search.combo().isOpen());
    EXPECT_EQ(self.m_search.combo().selectedKey(), 2u);
    const Optional<HitTarget> newQueryTarget = self.findTarget(queryId);
    ASSERT_TRUE(newQueryTarget.has_value());
    EXPECT_NE(newQueryTarget.value().popup.openGeneration, oldSearch.openGeneration);
    EXPECT_GT(self.m_host.loans, loans);
    EXPECT_EQ(self.m_host.lastPopup, newQueryTarget.value().popup);
    EXPECT_EQ(self.m_context.input().focus(), queryId);
    self.expectParentControls();
}

void VerifyUiNestedPopupLifetimeTests_ParentReopeningClosesTheOldContextMenuWithoutRemovingItsAnchor(mut UiNestedPopupLifetimeTests self){
    ASSERT_TRUE(self.m_menu.open(MakeUiMultilinePopupRect(80.0f, 120.0f, 0.0f, 0.0f)));
    ASSERT_TRUE(self.acceptMenu(1u));
    ASSERT_TRUE(self.hasTarget(self.menuRows()));
    self.reopenParent();
    ASSERT_TRUE(self.acceptMenu(2u));
    EXPECT_TRUE(self.m_menuResult.closed);
    EXPECT_FALSE(self.m_menuResult.activated);
    EXPECT_FALSE(self.m_menu.isOpen());
    EXPECT_EQ(self.m_menu.cursorKey(), 0u);
    EXPECT_FALSE(self.hasTarget(self.menuRows()));
    const Optional<HitTarget> anchor = self.findTarget(RequireUiWidgetId(self.parentId(), s_UiNestedPopupLifetimeAnchorKey));
    ASSERT_TRUE(anchor.has_value());
    EXPECT_TRUE(anchor.value().contextMenu);
    EXPECT_EQ(anchor.value().popup.openGeneration, self.m_parent.openGeneration());
    self.expectParentControls();
}

void VerifyUiNestedPopupLifetimeTests_ExplicitMenuOpeningAfterParentReopeningKeepsTheNewCommandLifetime(mut UiNestedPopupLifetimeTests self){
    ASSERT_TRUE(self.m_menu.open(MakeUiMultilinePopupRect(80.0f, 120.0f, 0.0f, 0.0f)));
    ASSERT_TRUE(self.acceptMenu(1u));
    const Optional<HitTarget> oldMenuTarget = self.findTarget(self.menuRows());
    ASSERT_TRUE(oldMenuTarget.has_value());
    const PopupToken oldMenu = oldMenuTarget.value().popup;
    self.reopenParent();
    ASSERT_TRUE(self.m_menu.open(MakeUiMultilinePopupRect(100.0f, 160.0f, 0.0f, 0.0f)));
    ASSERT_TRUE(self.acceptMenu(2u));
    EXPECT_TRUE(self.m_menu.isOpen());
    EXPECT_EQ(self.m_menu.cursorKey(), 1u);
    const Optional<HitTarget> newMenuTarget = self.findTarget(self.menuRows());
    ASSERT_TRUE(newMenuTarget.has_value());
    EXPECT_NE(newMenuTarget.value().popup.openGeneration, oldMenu.openGeneration);
    EXPECT_EQ(newMenuTarget.value().popup.instanceGeneration, oldMenu.instanceGeneration);
    EXPECT_EQ(self.m_context.input().focus(), self.menuRows());
    self.expectParentControls();
}

void VerifyUiNestedPopupLifetimeTests_AutomaticChildrenReserveTheirDeclaredLayersAndCountTowardTheEightScopeLimit(mut UiNestedPopupLifetimeTests self){
    self.m_state.open();
    self.m_childCombo.open();
    ASSERT_TRUE(self.m_menu.open(MakeUiMultilinePopupRect(80.0f, 180.0f, 0.0f, 0.0f)));
    ASSERT_TRUE(self.declareReserved(1u, false));
    const DrawSnapshot snapshot = self.m_paint.freeze();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const WidgetId parentRows = RequireUiWidgetId(self.fieldId(), s_UiNestedPopupLifetimeComboRowsKey);
    const WidgetId childField = RequireUiWidgetId(self.childId(), s_UiNestedPopupLifetimeComboKey);
    const WidgetId childRows = RequireUiWidgetId(childField, s_UiNestedPopupLifetimeComboRowsKey);
    const Optional<HitTarget> parentTarget = self.findTarget(self.parentId());
    const Optional<HitTarget> parentRowsTarget = self.findTarget(parentRows);
    const Optional<HitTarget> menuRowsTarget = self.findTarget(self.menuRows());
    const Optional<HitTarget> childTarget = self.findTarget(self.childId());
    const Optional<HitTarget> childRowsTarget = self.findTarget(childRows);
    ASSERT_TRUE(parentTarget.has_value());
    ASSERT_TRUE(parentRowsTarget.has_value());
    ASSERT_TRUE(menuRowsTarget.has_value());
    ASSERT_TRUE(childTarget.has_value());
    ASSERT_TRUE(childRowsTarget.has_value());
    EXPECT_EQ(parentTarget.value().layer, 1u);
    EXPECT_EQ(parentRowsTarget.value().layer, 2u);
    EXPECT_EQ(menuRowsTarget.value().layer, 3u);
    EXPECT_EQ(childTarget.value().layer, 4u);
    EXPECT_EQ(childRowsTarget.value().layer, 5u);
    WidgetId deepest = self.childId();
    for(usize index = 0u; index < 3u; ++index)
        deepest = RequireUiWidgetId(deepest, s_UiNestedPopupLifetimeDeepKey);
    const Optional<HitTarget> deepestTarget = self.findTarget(deepest);
    ASSERT_TRUE(deepestTarget.has_value());
    EXPECT_EQ(deepestTarget.value().layer, s_InputMaxPopups);
    const WidgetId leafId = RequireUiWidgetId(deepest, s_UiNestedPopupLifetimeLeafKey);
    ASSERT_TRUE(self.hasTarget(leafId));
    EXPECT_EQ(self.m_context.input().focus(), leafId);
    u32 previousLayer = 0u;
    for(in DrawCommand command : snapshot.commands()){
        EXPECT_GE(command.layer, previousLayer);
        previousLayer = command.layer;
    }

    EXPECT_FALSE(self.declareReserved(2u, true));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    const Optional<HitTarget> preservedRowsTarget = self.findTarget(parentRows);
    ASSERT_TRUE(preservedRowsTarget.has_value());
    EXPECT_EQ(preservedRowsTarget.value().layer, 2u);
    EXPECT_EQ(self.m_context.input().focus(), leafId);
}


