    EXPECT_DOUBLE_EQ(placement.vertical.offset, 0.0);
}

void VerifyUiScrollbarLayoutTests_MinimumThumbIsClampedToEachTrackEvenWithRemainingScrollRange(){
    const Rect bounds = Rect(10.0f, 20.0f, 100.0f, 80.0f);
    const auto placementResult = CalculateScrollViewportPlacement(bounds, bounds, Insets(), Point(999.0f, 900.0f), 1.0f, Point(400.0f, 300.0f), 12.0f, 1000.0f);
    ASSERT_TRUE(placementResult.has_value());
    ScrollViewportPlacement placement = placementResult.value();
    ExpectUiRect(placement.horizontal.thumb, placement.horizontal.track);
    ExpectUiRect(placement.vertical.thumb, placement.vertical.track);
    EXPECT_GT(placement.horizontal.maximum, 0.0);
    EXPECT_GT(placement.vertical.maximum, 0.0);
    ASSERT_TRUE(TryUpdateScrollViewportOffsets(Point(f32.max, f32.max), placement));
    ExpectUiRect(placement.horizontal.thumb, placement.horizontal.track);
    ExpectUiRect(placement.vertical.thumb, placement.vertical.track);
    EXPECT_DOUBLE_EQ(placement.horizontal.offset, placement.horizontal.maximum);
    EXPECT_DOUBLE_EQ(placement.vertical.offset, placement.vertical.maximum);
}

void VerifyUiScrollbarLayoutTests_ZeroMinimumThumbUsesViewportToContentRatio(){
    const Rect bounds = Rect(0.0f, 0.0f, 200.0f, 100.0f);
