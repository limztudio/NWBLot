    }

    public void setLocalAnchorB(in VectorSingle v){
        this.localAnchorBMinLength = f32x4(v, this.localAnchorBMinLength.w);
    }

    public f32 minLength()const{
        return this.localAnchorBMinLength.w;
    }

    public void setMinLength(in f32 v){
