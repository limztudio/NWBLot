template<typename ProjectT>
NWB_INLINE void AttachProjectUiPaintEntity(NotNullUniquePtr<World>& world, ProjectT& project){
    auto uiEntity = world->createEntity();
    auto& customUi = uiEntity.addComponent<UiPaintComponent>();
    customUi.paint = [&project](UiPaintContext& context)noexcept{
        project.paintUiLayer(context);
    };
}
};


