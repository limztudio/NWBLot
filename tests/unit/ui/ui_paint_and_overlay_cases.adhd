using namespace NWB;
using namespace NWB::Impl;
using namespace NWB::Impl::Ui;

using UiWidgetTests::s_TestSkinPath;
inline constexpr AStringView s_TexturePath = "tests/ui/texture";
inline constexpr AStringView s_SpriteRegion = "sprite";
inline constexpr AStringView s_PanelRegion = "panel";

struct DrawRegionFenvSample{
    i32 exceptions = 0;
    b8 cleared = false;
    b8 drawn = false;
};

class ScopedHeldFenv final : NoCopy{
public:
    ScopedHeldFenv()noexcept
        : m_held(HoldFloatingPointExceptions())
    {}

    ~ScopedHeldFenv()noexcept{
        if(m_held){
            const auto restored = SetFloatingPointEnvironment(*m_held);
            if(!restored){}
        }
    }

    [[nodiscard]] b8 valid()const noexcept{
        return m_held.has_value();
    }


private:
    Expected<FloatingPointEnvironment> m_held;
};


class UiPaintTests : public testing::Test{
public:
    UiPaintTests()
        : m_arena(Name(NWB::Tests::UiCases::s_UiCaseTestsUiPaint))
        , m_skin(m_arena, Name(s_TestSkinPath))
        , m_builder(m_arena)
    {
        UiSkin::RegionVector regions(m_arena);
        regions.push_back({ Name(s_SpriteRegion), { 16u, 32u, 32u, 24u }, {}, {}, 0.0f, 0.0f, UiSkinDrawMode::Sprite });
        UiSkinRegion panel{ Name(s_PanelRegion), { 0u, 0u, 32u, 24u }, { 4u, 6u, 8u, 2u }, {}, 0.0f, 0.0f, UiSkinDrawMode::NineSlice };
        regions.push_back(panel);
        m_skin.setAtlas(Core::Assets::AssetRef<Texture>(s_TexturePath), 128u, 64u, 2.0f, Move(regions));
        m_builder.begin({ 200.0f, 100.0f, 1.5f, 2.0f }, 7u, 3u, Core::Assets::AssetRef<UiSkin>(s_TestSkinPath), m_skin);
        m_builder.reserve(32u);
    }


public:
    void configurePanelBorderCase(const UiSkinSliceInsets& borders){
        UiSkin::RegionVector regions(m_arena);
        regions.push_back({ Name(s_PanelRegion), { 0u, 0u, 32u, 24u }, borders, {}, 0.0f, 0.0f, UiSkinDrawMode::NineSlice });
        m_skin.setAtlas(Core::Assets::AssetRef<Texture>(s_TexturePath), 128u, 64u, 2.0f, Move(regions));
        m_builder.begin({ 200.0f, 100.0f }, 7u, 3u, Core::Assets::AssetRef<UiSkin>(s_TestSkinPath), m_skin);
    }

    [[nodiscard]] DrawRegionFenvSample drawPanelWithFenvCheck(const Name& region, const Rect& bounds){
#pragma STDC FENV_ACCESS ON
        DrawRegionFenvSample sample;
        sample.cleared = ClearFloatingPointExceptions(FE_ALL_EXCEPT).has_value();
        if(!sample.cleared)
            return sample;
        sample.drawn = m_builder.drawRegion(region, bounds);
        sample.exceptions = TestFloatingPointExceptions(FE_INVALID | FE_DIVBYZERO | FE_OVERFLOW);
        return sample;
    }

    void configureReplacementSpriteSkin(){
        UiSkin::RegionVector regions(m_arena);
        regions.push_back({ Name(s_SpriteRegion), { 0u, 0u, 4u, 4u }, {}, {}, 0.0f, 0.0f, UiSkinDrawMode::Sprite });
        m_skin.setAtlas(Core::Assets::AssetRef<Texture>("tests/ui/replacement"), 16u, 16u, 1.0f, Move(regions));
        m_builder.begin({ 20.0f, 20.0f }, 8u, 4u, Core::Assets::AssetRef<UiSkin>(s_TestSkinPath), m_skin);
    }


public:
    Core::Alloc::GlobalArena m_arena;
    UiSkin m_skin;
    PaintBuilder m_builder;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


