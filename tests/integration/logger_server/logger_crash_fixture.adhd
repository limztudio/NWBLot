const u32 s_ShutdownMessageCount = 32u;
const u32 s_FirstRequestDelayMilliseconds = 250u;
const StringView s_TestSourceFilename = "suite.adhd.cpp";
const StringView s_ApplicationName = "logserver_crash_tests";
const StringView s_ApplicationVersion = "1";
const StringView s_WindowsExceptionCategory = "windows_exception";
const StringView s_PlatformLinux = "platform=linux";
const StringView s_Event = "[event]";
const StringView s_Callstack = "callstack:";
const StringView s_StatusCallstackCaptured = "status=callstack_captured";
const StringView s_Linux = "linux";
const StringView s_Crash = "crash";
const StringView s_Signal = "signal";
const StringView s_ManualDump = "manual_dump";
const StringView s_Windows = "windows";
const StringView s_InvalidArchiveHeader = "NWBCRASHPKG 0\n";

const Name s_ArchiveScratch = s_LoggerCrashTestNameTestsIntegrationLoggerServerArchiveScratch;
const Name s_AssertChildInstallArena = s_LoggerCrashTestNameTestsIntegrationLoggerServerAssertChildInstall;
const Name s_RecoverableErrorInstallArena = s_LoggerCrashTestNameTestsIntegrationLoggerServerRecoverableErrorInstall;

b8 IsWindowsLoggerCrashPlatform(){
    return s_IsWindowsLoggerPlatform;
}

b8 IsDesktopLinuxLoggerCrashPlatform(){
    return s_IsDesktopLinuxLoggerPlatform;
}

b8 IsDesktopLoggerCrashPlatform(){
    return IsWindowsLoggerCrashPlatform() || IsDesktopLinuxLoggerCrashPlatform();
}

Path StorageDirectory(in StringView testGroup){
    return TestCaseDirectory(testGroup) / "storage";
}

Path ArchiveInputDirectory(in StringView testGroup){
    return TestCaseDirectory(testGroup) / "input";
}

Path ArchiveFileName(in StringView stem){
    Path fileName = Path(stem);
    fileName.replaceExtension(s_CrashUploadArchiveFileExtension);
    return fileName;
}

Path ArchivePath(in StringView testGroup, in StringView stem){
    return ArchiveInputDirectory(testGroup) / ArchiveFileName(stem);
}

Path ExtractedPackageDirectory(in StringView testGroup, in StringView stem){
    return StorageDirectory(testGroup) / s_CrashExtractedDirectoryName / stem;
}

Path RawArchivePath(in StringView testGroup, in StringView stem){
    return StorageDirectory(testGroup) / s_CrashRawDirectoryName / ArchiveFileName(stem);
}

Path InvalidArchivePath(in StringView testGroup, in StringView stem){
    return StorageDirectory(testGroup) / s_CrashInvalidDirectoryName / ArchiveFileName(stem);
}

void AppendArchiveFile(in StringView relativePath, in StringView content, mut String archive){
    archive.append(s_ArchiveFileHeaderPrefix);
    archive.append(relativePath);
    archive.append(StringFormat(" {}\n", content.size()));
    archive.append(content);
    archive.append(s_ArchiveEntryEndText);
}

String BuildManifest(
    in StringView crashId,
    in StringView platform,
    in StringView event,
    in StringView reasonKind,
    in u64 reasonCode,
    in ManifestEventFieldEnum eventField,
    in ManifestTriggerFields trigger
){
    String manifest = "{\n";
    manifest.append(StringFormat(
        "  \"format\": \"{}\",\n  \"crash_id\": \"{}\",\n  \"application\": \"logger_server_test\",\n  \"version\": \"1\",\n  \"build_id\": \"unit-test\",\n  \"abi\": \"test-abi\",\n  \"platform\": \"{}\",\n  \"reason_kind\": \"{}\",\n  \"reason_code\": {},\n  \"process_id\": 1,\n  \"thread_id\": 7,\n  \"has_exception_context\": false,\n  \"fault_address\": 0,\n  \"instruction_pointer\": 0,\n  \"stack_pointer\": 0,\n  \"frame_pointer\": 0,\n",
        s_ManifestFormatValue,
        crashId,
        platform,
        reasonKind,
        reasonCode
    ));
    if(eventField == s_IncludeEventField)
        manifest.append(StringFormat("  \"event\": \"{}\",\n", event));
    manifest.append(StringFormat(
        "  \"trigger_category\": \"{}\",\n  \"trigger_expression\": \"{}\",\n  \"trigger_message\": \"{}\",\n  \"trigger_file\": \"{}\",\n  \"trigger_line\": {},\n  \"dump_detail_mode\": \"small\",\n  \"artifact_strategy\": \"unit_test\",\n  \"handler_lifetime\": \"unit_test\"\n",
        trigger.category,
        trigger.expression,
        trigger.message,
        trigger.file,
        trigger.line
    ));
    manifest.append("}\n");
    return manifest;
}

void BeginArchiveWithManifest(
    in StringView crashId,
    in StringView platform,
    in StringView event,
    in StringView reasonKind,
    in u64 reasonCode,
    in ManifestEventFieldEnum eventField,
    in ManifestTriggerFields trigger,
    mut String archive
){
    archive.append(s_ArchiveHeaderText);
    const String manifest = BuildManifest(crashId, platform, event, reasonKind, reasonCode, eventField, trigger);
    AppendArchiveFile(s_ManifestFileName, StringView(manifest), archive);
}

b8 WriteArchive(in StringView testGroup, in StringView stem, in StringView archive){
    const Path inputDir = ArchiveInputDirectory(testGroup);
    if(!EnsureDirectories(inputDir).has_value())
        return false;
    return WriteTextFile(ArchivePath(testGroup, stem), archive);
}

CrashIngestConfig MakeIngestConfig(mut GlobalArena arena, in StringView testGroup){
    CrashIngestConfig config = CrashIngestConfig(arena);
    config.storageDirectory = StorageDirectory(testGroup);
    return config;
}

void BuildLinuxCrashArchive(in StringView crashId, mut String archive){
    BeginArchiveWithManifest(crashId, s_Linux, s_Crash, s_Signal, 11u, s_IncludeEventField, ManifestTriggerFields(), archive);
    AppendArchiveFile(s_CpuContextFileName, "fault_address=0\ninstruction_pointer=4198964\nstack_pointer=0\nframe_pointer=0\n", archive);
    AppendArchiveFile(s_CallstackFileName, "#0 0x0000000000401234\n#1 0x0000000000401240\n", archive);
    AppendArchiveFile(s_ProcMapsFileName, "00400000-00452000 r-xp 00000000 08:01 123 /tmp/nwb_loader\n", archive);
}

CrashIngestResult ProcessCrashArchive(mut GlobalArena arena, in StringView testGroup, in StringView stem, in StringView archive, in CrashIngestConfig config){
    EXPECT_TRUE(WriteArchive(testGroup, stem, archive));
    return ProcessCrashUpload(arena, ArchivePath(testGroup, stem), config);
}

CrashIngestResult ProcessCrashArchive(mut GlobalArena arena, in StringView testGroup, in StringView stem, in StringView archive){
    const CrashIngestConfig config = MakeIngestConfig(arena, testGroup);
    return ProcessCrashArchive(arena, testGroup, stem, archive, config);
}

b8 ReadServerSymbolicationText(in StringView testGroup, in StringView stem, mut String outReport){
    return ReadTextFile(ExtractedPackageDirectory(testGroup, stem) / s_ServerSymbolicationFileName, outReport).has_value();
}


