void VerifyUiTextAreaInputScrollTests_InvalidWheelLinesRejectTheCandidateBeforeBorrowingOrChangingTheAcceptedViewport(mut UiTextAreaInputScrollTests self){
    self.useHost();
    self.m_host.focused = false;
    ASSERT_TRUE(self.prepareDocument(Point(20.0f, 30.0f)));
    Array<f32, 3u> invalid;
    invalid[0u] = 0.0f;
    invalid[1u] = -1.0f;
    invalid[2u] = bit_cast<f32>(s_UiTextAreaQuietNaNF32Bits);
    u64 generation = 1u;
    for(in f32 wheelLines : invalid){
        ASSERT_TRUE(self.frameArea(generation, UiTextAreaScrollOptions()));
        ++generation;
        const UiTextAreaScrollModelRecord model = UiTextAreaScrollModelRecord(self.m_model);
        const Point scroll = self.m_state.scroll();
        const EditBoxPlacement placement = self.m_state.placement();
        const EditNavigationSnapshot navigation = self.m_state.navigation().snapshot();
        const u64 revision = self.m_state.revision();
        const usize loans = self.m_host.loans;
        const usize publishes = self.m_host.publishes;
        const usize targets = self.m_context.input().targets().size();
        const auto displayedAccepted = self.tryTarget(self.id("area", "panel"));
        ASSERT_TRUE(displayedAccepted.has_value());
        const HitTarget accepted = displayedAccepted.value();
        TextAreaOptions options = UiTextAreaScrollOptions();
        options.wheelLines = wheelLines;
        ASSERT_TRUE(self.beginArea(generation));
        const EditBoxResult result = self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, options);
        EXPECT_FALSE(result.valid);
        EXPECT_TRUE(self.m_context.failed());
        EXPECT_FALSE(self.m_builder.endPanel());
        EXPECT_FALSE(self.m_context.finishFrame());
        EXPECT_FALSE(self.m_context.commitFrame(generation));
        EXPECT_EQ(self.m_context.input().layoutGeneration(), generation - 1u);
        EXPECT_EQ(self.m_context.input().targets().size(), targets);
        const auto displayedCurrent = self.tryTarget(self.id("area", "panel"));
        ASSERT_TRUE(displayedCurrent.has_value());
        const HitTarget current = displayedCurrent.value();
        EXPECT_EQ(current.control, accepted.control);
        ExpectUiRect(current.rectangle, accepted.rectangle);
        ExpectUiRect(self.m_state.placement().bounds, placement.bounds);
        ExpectUiRect(self.m_state.placement().content, placement.content);
        EXPECT_FLOAT_EQ(self.m_state.scroll().x, scroll.x);
        EXPECT_FLOAT_EQ(self.m_state.scroll().y, scroll.y);
        EXPECT_EQ(self.m_state.revision(), revision);
        EXPECT_TRUE(self.m_state.navigation().matches(navigation));
        EXPECT_EQ(self.m_host.loans, loans);
        EXPECT_EQ(self.m_host.publishes, publishes);
        model.expect(self.m_model);
        self.m_builder.reset();
        self.m_context.abandonFrame();
        ++generation;
    }
}

void VerifyUiTextAreaInputScrollTests_CopiedVerticalWheelAppliesOnlyAtFinalPaintAndPreservesTheModel(mut UiTextAreaInputScrollTests self){
    ASSERT_TRUE(self.prepareScroll());
    const UiTextAreaScrollModelRecord model = UiTextAreaScrollModelRecord(self.m_model);
    const u64 revision = self.m_state.revision();
    const EditNavigationSnapshot navigation = self.m_state.navigation().snapshot();
    const auto hostTarget = self.tryTarget(self.id("area", "panel"));
    ASSERT_TRUE(hostTarget.has_value());
    const f64 step = hostTarget.value().scrollStep;
    ASSERT_GT(step, 0.0);
    ASSERT_TRUE(self.wheel(0.0, -1.0));
    ASSERT_EQ(self.m_context.input().controlActions().size(), 1u);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    ASSERT_TRUE(self.beginArea(2u));
    self.m_result = self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, UiTextAreaScrollOptions());
    ASSERT_TRUE(self.m_result.valid);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    ASSERT_TRUE(self.acceptArea());
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), step, 0.001);
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 0.0f);
    EXPECT_EQ(self.m_state.revision(), revision);
    EXPECT_TRUE(self.m_state.navigation().matches(navigation));
    EXPECT_FALSE(self.m_result.textChanged || self.m_result.selectionChanged);
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
    model.expect(self.m_model);
}

void VerifyUiTextAreaInputScrollTests_LargeWheelDeltasClampBothEndpointsWithoutChangingSelectionOrHistory(mut UiTextAreaInputScrollTests self){
    ASSERT_TRUE(self.prepareScroll());
    const UiTextAreaScrollModelRecord model = UiTextAreaScrollModelRecord(self.m_model);
    const ScrollViewportPlacement bars = self.m_state.scrollbars();
    ASSERT_GT(bars.horizontal.maximum, 0.0);
    ASSERT_GT(bars.vertical.maximum, 0.0);
    ASSERT_TRUE(self.wheel(1000000.0, -1000000.0));
    ASSERT_TRUE(self.frameArea(2u, UiTextAreaScrollOptions()));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().x), bars.horizontal.maximum, 0.001);
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), bars.vertical.maximum, 0.001);
    ASSERT_TRUE(self.wheel(-1000000.0, 1000000.0));
    ASSERT_TRUE(self.frameArea(3u, UiTextAreaScrollOptions()));
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 0.0f);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    model.expect(self.m_model);
}

void VerifyUiTextAreaInputScrollTests_ReadOnlyWheelAndThumbScrollingLeaveUndoAndRedoIntact(mut UiTextAreaInputScrollTests self){
    TextAreaOptions options = UiTextAreaScrollOptions();
    options.readOnly = true;
    ASSERT_TRUE(self.prepareScroll(options));
    const UiTextAreaScrollModelRecord model = UiTextAreaScrollModelRecord(self.m_model);
    ASSERT_TRUE(self.wheel(1.0, -1.0));
    ASSERT_TRUE(self.frameArea(2u, options));
    EXPECT_GT(self.m_state.scroll().x, 0.0f);
    EXPECT_GT(self.m_state.scroll().y, 0.0f);
    const auto foundThumb = self.tryTarget(self.part("scroll.y.thumb"));
    ASSERT_TRUE(foundThumb.has_value());
    const HitTarget thumb = foundThumb.value();
    const Point origin = CenterUiRect(thumb.rectangle);
    const Point destination = Point(origin.x, thumb.gestureReference.y + thumb.gestureReference.height + 50.0f);
    self.drag(origin, destination);
    ASSERT_TRUE(self.frameArea(3u, options));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), self.m_state.scrollbars().vertical.maximum, 0.001);
    model.expect(self.m_model);
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), self.documentView());
    ASSERT_TRUE(self.m_model.redo());
    EXPECT_EQ(self.m_model.text(), model.textView());
}

void VerifyUiTextAreaInputScrollTests_DisabledEditorUsesTheContainingPanelBarrierAndCannotScroll(mut UiTextAreaInputScrollTests self){
    TextAreaOptions options = UiTextAreaScrollOptions();
