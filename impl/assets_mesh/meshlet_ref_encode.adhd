#include <impl/assets_mesh/cook_meshlet_refs.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const PlatformStringView s_InvalidEncodedRefWidthMessage = PlatformTextLiteral("encoded ref width is invalid");
const PlatformStringView s_EncodedRefByteCountMismatchMessage = PlatformTextLiteral("encoded ref byte count mismatch");
const PlatformStringView s_EncodedPositionRefDecodeMismatchMessage = PlatformTextLiteral("encoded position ref decode mismatch");
const PlatformStringView s_EncodedAttributeRefDecodeMismatchMessage = PlatformTextLiteral("encoded attribute ref decode mismatch");
const PlatformStringView s_EmptyMeshletRefRangeMessage = PlatformTextLiteral("meshlet cannot encode empty ref ranges");
const PlatformStringView s_StaticMeshletSkinRefMessage = PlatformTextLiteral("static meshlet cannot encode skin references");
const PlatformStringView s_EncodedRefByteOffsetLimitMessage = PlatformTextLiteral("encoded ref byte offset exceeds u32 limits");
const PlatformStringView s_EncodedRefByteCountLimitMessage = PlatformTextLiteral("encoded ref byte count exceeds u32 limits");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MeshletFailureResult(in b8 result){
    return result;
}

void AppendMeshletRefDelta<Output>(in u32 delta, in MeshletRefDeltaWidth width, mut Output bytes)noexcept_like(AppendOutputByte(bytes, cast<u8>(0u))){
    assert(MeshletRefDeltaFitsWidth(delta, width), "delta exceeds its encoding width");
    AppendOutputByte(bytes, cast<u8>(delta & s_MeshletPackedByteMask));
    if(width == MeshletRefDeltaWidth::U8)
        return;
    AppendOutputByte(bytes, cast<u8>((delta >> s_MeshletPackedByteBits) & s_MeshletPackedByteMask));
    if(width == MeshletRefDeltaWidth::U16)
        return;
    AppendOutputByte(bytes, cast<u8>((delta >> s_MeshletPackedByte2Shift) & s_MeshletPackedByteMask));
    AppendOutputByte(bytes, cast<u8>((delta >> s_MeshletPackedByte3Shift) & s_MeshletPackedByteMask));
}

u32 MeshletPositionRefIndex(in MeshletPositionStreamRef ref){ return ref.position; }
u32 MeshletSkinRefIndex(in MeshletPositionStreamRef ref){ return ref.skin; }
u32 MeshletNormalRefIndex(in MeshletAttributeStreamRef ref){ return ref.normal; }
u32 MeshletTangentRefIndex(in MeshletAttributeStreamRef ref){ return ref.tangent; }
u32 MeshletUvRefIndex(in MeshletAttributeStreamRef ref){ return ref.uv0; }
u32 MeshletColorRefIndex(in MeshletAttributeStreamRef ref){ return ref.color; }

void AppendMeshletChannelDeltas<Ref, Projection, Output>(
    in Span<Ref> refs, in u32 offset, in u32 count, in u32 base, in MeshletRefDeltaWidth width, in Projection project, mut Output bytes
)noexcept_like(AppendOutputByte(bytes, cast<u8>(0u)), cast<u32>(project(refs[0u]))){
    for(u32 i = 0u; i < count; ++i){
        const u32 index = project(refs[offset + i]);
        assert(index >= base, "meshlet reference is below its channel base");
        AppendMeshletRefDelta(index - base, width, bytes);
    }
}

b8 ValidateEncodedMeshletRefDeltas<FailureHandler>(
    in MeshletDesc meshlet, in usize index, in u32 positionOffset, in u32 attributeOffset,
    in Span<MeshletPositionStreamRef> positions, in Span<MeshletAttributeStreamRef> attributes,
    in Span<u8> positionDeltas, in Span<u8> attributeDeltas, in b8 skinRequired, mut copy FailureHandler onFailure
)noexcept_like(
    MeshletFailureResult(onFailure(index, s_InvalidEncodedRefWidthMessage)),
    MeshletFailureResult(onFailure(index, s_EncodedRefByteCountMismatchMessage)),
    MeshletFailureResult(onFailure(index, s_EncodedPositionRefDecodeMismatchMessage)),
    MeshletFailureResult(onFailure(index, s_EncodedAttributeRefDecodeMismatchMessage))
){
    switch(CheckEncodedMeshletRefDeltas(meshlet, positionOffset, attributeOffset, positions, attributes, positionDeltas, attributeDeltas, skinRequired)){
    case EncodedMeshletRefDeltaStatus::InvalidWidth:
        return onFailure(index, s_InvalidEncodedRefWidthMessage);
    case EncodedMeshletRefDeltaStatus::ByteCountMismatch:
        return onFailure(index, s_EncodedRefByteCountMismatchMessage);
    case EncodedMeshletRefDeltaStatus::PositionDecodeMismatch:
        return onFailure(index, s_EncodedPositionRefDecodeMismatchMessage);
    case EncodedMeshletRefDeltaStatus::AttributeDecodeMismatch:
        return onFailure(index, s_EncodedAttributeRefDecodeMismatchMessage);
    case EncodedMeshletRefDeltaStatus::Valid:
        return true;
    default:
        return true;
    }
}

b8 EncodeMeshletRefRange<FailureHandler, PositionOutput, AttributeOutput>(
    in Span<MeshletPositionStreamRef> positions, in Span<MeshletAttributeStreamRef> attributes, in b8 skinRequired,
    mut FailureHandler onFailure, mut Span<MeshletDesc> meshlets, mut PositionOutput positionDeltas, mut AttributeOutput attributeDeltas, mut copy usize index
)noexcept_like(
    ClearByteOutput(positionDeltas), ClearByteOutput(attributeDeltas),
    ReserveByteOutput(positionDeltas, positions.size() * size_of<MeshletPositionStreamRef>()),
    ReserveByteOutput(attributeDeltas, attributes.size() * size_of<MeshletAttributeStreamRef>()),
    MeshletFailureResult(onFailure(index, s_EmptyMeshletRefRangeMessage)),
    MeshletFailureResult(onFailure(index, s_StaticMeshletSkinRefMessage)),
    MeshletFailureResult(onFailure(index, s_EncodedRefByteOffsetLimitMessage)),
    cast<b8>(ByteOutputSize(positionDeltas) > cast<usize>(u32.max) || ByteOutputSize(attributeDeltas) > cast<usize>(u32.max)),
    cast<u32>(ByteOutputSize(positionDeltas)), cast<u32>(ByteOutputSize(attributeDeltas)),
    AppendOutputByte(positionDeltas, cast<u8>(0u)), AppendOutputByte(attributeDeltas, cast<u8>(0u)),
    AssertionCheck(ValidateEncodedMeshletRefDeltas(meshlets[0u], index, 0u, 0u, positions, attributes, ByteOutputView(positionDeltas), ByteOutputView(attributeDeltas), skinRequired, onFailure)),
    MeshletFailureResult(onFailure(meshlets.size(), s_EncodedRefByteCountLimitMessage))
){
    ClearByteOutput(positionDeltas);
    ClearByteOutput(attributeDeltas);
    ReserveByteOutput(positionDeltas, positions.size() * size_of<MeshletPositionStreamRef>());
    ReserveByteOutput(attributeDeltas, attributes.size() * size_of<MeshletAttributeStreamRef>());

    while(index < meshlets.size()){
        mut MeshletDesc meshlet = meshlets[index];
        const u32 positionCount = MeshletPositionCount(meshlet);
        const u32 attributeCount = MeshletAttributeCount(meshlet);
        if(positionCount == 0u || attributeCount == 0u)
            return onFailure(index, s_EmptyMeshletRefRangeMessage);

        const u32 positionOffset = meshlet.positionRefOffset;
        const u32 attributeOffset = meshlet.attributeRefOffset;
        const Expected<MeshletRefChannelWidths> widths = TryPrepareMeshletRefEncoding(positions, attributes, positionOffset, attributeOffset, skinRequired, meshlet);
        if(!widths.has_value())
            return onFailure(index, s_StaticMeshletSkinRefMessage);
        if(ByteOutputSize(positionDeltas) > cast<usize>(u32.max) || ByteOutputSize(attributeDeltas) > cast<usize>(u32.max))
            return onFailure(index, s_EncodedRefByteOffsetLimitMessage);

        meshlet.positionRefOffset = cast<u32>(ByteOutputSize(positionDeltas));
        meshlet.attributeRefOffset = cast<u32>(ByteOutputSize(attributeDeltas));
        AppendMeshletChannelDeltas(positions, positionOffset, positionCount, meshlet.positionBase, widths.value().position, MeshletPositionRefIndex, positionDeltas);
        if(skinRequired)
            AppendMeshletChannelDeltas(positions, positionOffset, positionCount, meshlet.skinBase, widths.value().skin, MeshletSkinRefIndex, positionDeltas);
        AppendMeshletChannelDeltas(attributes, attributeOffset, attributeCount, meshlet.normalBase, widths.value().normal, MeshletNormalRefIndex, attributeDeltas);
        AppendMeshletChannelDeltas(attributes, attributeOffset, attributeCount, meshlet.tangentBase, widths.value().tangent, MeshletTangentRefIndex, attributeDeltas);
        AppendMeshletChannelDeltas(attributes, attributeOffset, attributeCount, meshlet.uv0Base, widths.value().uv0, MeshletUvRefIndex, attributeDeltas);
        AppendMeshletChannelDeltas(attributes, attributeOffset, attributeCount, meshlet.colorBase, widths.value().color, MeshletColorRefIndex, attributeDeltas);
        assert(ValidateEncodedMeshletRefDeltas(meshlet, index, positionOffset, attributeOffset, positions, attributes, ByteOutputView(positionDeltas), ByteOutputView(attributeDeltas), skinRequired, onFailure), "encoded meshlet references failed validation");
        ++index;
    }

    if(ByteOutputSize(positionDeltas) > cast<usize>(u32.max) || ByteOutputSize(attributeDeltas) > cast<usize>(u32.max))
        return onFailure(meshlets.size(), s_EncodedRefByteCountLimitMessage);
    return true;
}

b8 EncodeMeshletRefDeltas<PositionOutput, AttributeOutput, FailureHandler>(
    in Span<MeshletPositionStreamRef> positions, in Span<MeshletAttributeStreamRef> attributes,
    in b8 skinRequired, mut copy FailureHandler onFailure, mut Span<MeshletDesc> meshlets, mut PositionOutput positionDeltas, mut AttributeOutput attributeDeltas
)noexcept_like(){
    return EncodeMeshletRefRange(positions, attributes, skinRequired, onFailure, meshlets, positionDeltas, attributeDeltas, cast<usize>(0u));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

