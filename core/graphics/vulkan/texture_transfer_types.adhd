////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TextureFormatBlockLayout{
    public u32 blockWidth = 0u;
    public u32 blockHeight = 0u;
    public u32 bytesPerBlock = 0u;
}


class BufferImageCopyLayout{
    public u64 requiredSize = 0u;
    public u32 bufferRowLength = 0u;
    public u32 bufferImageHeight = 0u;
}


class StagingTextureMipLayout{
    public u64 byteOffset = 0u;
    public u64 rowPitch = 0u;
    public u64 slicePitch = 0u;
    public u32 bufferRowLength = 0u;
    public u32 bufferImageHeight = 0u;
}


class StagingTextureRange{
    public u64 byteOffset = 0u;
    public u64 byteSize = 0u;
    public u64 rowPitch = 0u;
    public u32 bufferRowLength = 0u;
    public u32 bufferImageHeight = 0u;
}


