#ifndef NWB_GRAPHICS_RAYTRACE_SURFACE_LIGHTING_SLANGI
#define NWB_GRAPHICS_RAYTRACE_SURFACE_LIGHTING_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "surface_hit.slangi"
#include "../deferred/bxdf_surface.slangi"

// A traced surface has no opaque G-buffer texel. Its light loop must never read the primary camera's visibility or caustics, even in the viewport. Include before lighting; caller supplies macros.
#ifdef NWB_GRAPHICS_SCENE_LIGHTING_SLANGI
#error "Include raytrace/surface_lighting.slangi before scene/lighting.slangi"
#endif
#ifndef NWB_SCENE_SHADOW_CAUSTIC_SAMPLING_DISABLED
#define NWB_SCENE_SHADOW_CAUSTIC_SAMPLING_DISABLED
#endif
#include "../scene/lighting.slangi"

bool nwbBxdfRequiresLinearOutput(){
    return true;
}

#include "deferred/generated/bxdf_dispatch.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// observerDirection points from the hit toward the ray origin; evaluates direct lights and ambient fallback without secondary rays.
half3 nwbRayTraceSurfaceRadiance(const NwbRayTraceSurfaceHit hit, const float3 observerDirection){
    if(!hit.hit)
        return half3(0.0h);

    NwbBxdfSurface surface;
    surface.baseColor = hit.surface.baseColor;
    surface.normal = nwbSafeNormalize(hit.surface.normal, hit.geometricNormal);
    surface.viewVector = nwbSafeNormalize(observerDirection, hit.geometricNormal);
    if(dot(surface.normal, surface.viewVector) < 0.0)
        surface.normal = -surface.normal;
    surface.worldPosition = hit.position;
    surface.shadingModel = hit.shadingModelId;
    surface.param0 = hit.surface.param0;
    surface.param1 = hit.surface.param1;
    surface.isBackground = false;
    surface.indirectIrradiance = nwbBxdfIndirectIrradiance(surface.worldPosition, surface.normal);
    return max(nwbDeferredDispatchBxdf(surface.shadingModel, surface, int2(-1, -1)), half3(0.0h));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

