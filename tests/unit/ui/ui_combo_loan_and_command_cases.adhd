HitTarget MakeCommandOwnerEditor(){
    HitTarget target;
    target.id = WidgetId(1u);
    target.declarationGeneration = 7u;
    target.rectangle = Rect(0.0f, 0.0f, 120.0f, 24.0f);
    target.clip = Rect(0.0f, 0.0f, 300.0f, 200.0f);
    target.focusable = true;
    target.textEditable = true;
    target.control = ControlToken(101u, 102u, 103u);
    return target;
}

HitTarget MakeCommandOwnerList(in u64 id, in f32 x){
    HitTarget target;
    target.id = WidgetId(id);
    target.declarationGeneration = 11u;
    target.rectangle = Rect(x, 40.0f, 120.0f, 120.0f);
    target.clip = Rect(0.0f, 0.0f, 300.0f, 200.0f);
    target.focusable = true;
    target.navigable = true;
    target.control = ControlToken(31u, 41u, 51u);
    target.pageRows = 5u;
    return target;
}

HitTarget MakeUiCommandInputTarget(in u64 id){
    HitTarget target = HitTarget();
    target.id.value = id;
    target.rectangle = Rect(0.0f, 0.0f, 80.0f, 40.0f);
    target.clip = Rect(0.0f, 0.0f, 200.0f, 100.0f);
    target.declarationGeneration = 7u;
    target.focusable = true;
    target.activatable = true;
    target.focusOnCommit = true;
    return target;
}

HitTarget MakeUiCommandInputControl(in u64 id){
    HitTarget target = MakeUiCommandInputTarget(id);
    target.navigable = true;
    target.horizontalNavigation = true;
    target.control.instanceGeneration = 11u;
    target.control.contentGeneration = 21u;
    target.control.contentRevision = 31u;
    return target;
}

InputEvent MakeUiCommandInputCommand(in InputEventType type, in InputSource source, in InputCommand command, in b8 repeat){
    InputEvent event = InputEvent();
    event.type = type;
    event.source = source;
    event.command = command;
    event.repeat = repeat;
    return event;
}

InputEvent MakeUiCommandInputKey(in InputEventType type, in b8 shift, in b8 repeat){
    InputEvent event = InputEvent();
    event.type = type;
    event.key = Key::W;
    event.shift = shift;
    event.repeat = repeat;
    return event;
}

Array<InputKeyBinding, 1u> MakeUiSingleKeyBindingArray(in InputKeyBinding binding){
    Array<InputKeyBinding, 1u> bindings = Array<InputKeyBinding, 1u>();
    bindings[0u] = binding;
    return bindings;
}

b8 DeclareUiComboLoanPair(mut UiComboLoanTests self, in u64 generation, in IListDataSource secondSource, mut ComboState secondState){
    if(!self.begin(generation) || !self.m_builder.beginPanel(s_UiComboLoanPanelKey, Rect(10.0f, 10.0f, 320.0f, 240.0f)))
        return false;
    const ComboOptions options = MakeComboFixtureOptions();
    return self.m_builder.comboBox(s_UiComboLoanKey, self.m_source, self.m_state, options).valid
        && self.m_builder.comboBox(s_UiComboLoanSecondKey, secondSource, secondState, options).valid;
}

void VerifyUiComboLoanTests_SameValueApplicationSelectionAfterDeclarationRejectsDeferredPaint(mut UiComboLoanTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    const UiComboLoanAcceptedState displayed = self.accepted();
    ASSERT_TRUE(self.declareCombo(2u));
    const u64 inputGeneration = self.m_state.inputGeneration();
    self.m_state.select(1u);
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.ready());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_NE(self.m_state.inputGeneration(), inputGeneration);
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    self.expectAccepted(displayed);
}

void VerifyUiComboLoanTests_ClosingBetweenDeclarationAndEndKeepsTheApplicationClose(mut UiComboLoanTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    ASSERT_TRUE(self.openByPointer(2u));
    ASSERT_TRUE(self.declareCombo(3u));
    const UiComboLoanAcceptedState displayed = self.accepted();
    self.m_state.close();
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.commitFrame(3u));
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    self.expectAccepted(displayed);
}

