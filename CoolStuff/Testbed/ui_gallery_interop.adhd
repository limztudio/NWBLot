#include "ui_gallery_constants.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type UiNestedPopupSource = UiFilteredListSource<UiFilteredListState<UiNestedPopupLabelResolver, s_NestedPopupLabelCount, s_NestedPopupDisabledKey>>;
type UiSearchComboSource = UiFilteredListSource<UiFilteredListState<UiSearchComboLabelResolver, s_SearchComboLabelCount, s_SearchComboDisabledKey>>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 DeclareSelectedKeyLabel(mut Builder ui, in u64 selectedKey){
    b8 result = false;
    native(mut ui, in selectedKey, mut result){
        Array<char, 32u> text = {};
        CopyFixedBuffer(text, s_SelectedTextPrefix);
        AppendUnsignedToFixedBuffer(text, selectedKey);
        result = ui.label(s_SelectedKey, FixedBufferView(text));
    }
    return result;
}

b8 DeclareCommittedNumericLabel(mut Builder ui, in i64 integerValue, in f64 floatValue){
    const String text = StringFormat("Committed: {} / {}", integerValue, floatValue);
    return ui.label("committed", StringView(text));
}

b8 DeclarePopupToolsStatusLabel(mut Builder ui, in u64 commandKey, in u32 anchorClicks){
    b8 result = false;
    native(mut ui, in commandKey, in anchorClicks, mut result){
        Array<char, 64u> text = {};
        CopyFixedBuffer(text, "Command: ");
        AppendUnsignedToFixedBuffer(text, commandKey);
        AppendFixedBuffer(text, " / Clicks: ");
        AppendUnsignedToFixedBuffer(text, anchorClicks);
        result = ui.label(s_SelectedKey, FixedBufferView(text));
    }
    return result;
}

b8 DeclareProgressPercentLabel(mut Builder ui, in f64 percent){
    const String text = StringFormat("Completed: {:.0f}%", percent);
    return ui.label("value", StringView(text));
}

b8 DeclareGallerySectionLabel(mut Builder ui, in u32 sectionNumber, in u32 sectionCount, in StringView sectionName){
    b8 usedBuffer = false;
    b8 result = false;
    native(mut ui, in sectionNumber, in sectionCount, in sectionName, mut usedBuffer, mut result){
        if(sectionName.size() <= 80u && sectionName.find('\0') == AStringView::npos){
            Array<char, 128u> text = {};
            CopyFixedBuffer(text, "UI samples ");
            AppendUnsignedToFixedBuffer(text, sectionNumber);
            AppendFixedBuffer(text, "/");
            AppendUnsignedToFixedBuffer(text, sectionCount);
            AppendFixedBuffer(text, ": ");
            AppendFixedBuffer(text, sectionName);
            result = ui.label("section", FixedBufferView(text));
            usedBuffer = true;
        }
    }
    if(usedBuffer)
        return result;
    const String text = StringFormat("UI samples {}/{}: {}", sectionNumber, sectionCount, sectionName);
    return ui.label("section", StringView(text));
}

b8 DeclareCounterLabel(mut Builder ui, in u32 count){
    b8 result = false;
    native(mut ui, in count, mut result){
        Array<char, 32u> text = {};
        CopyFixedBuffer(text, "Count: ");
        AppendUnsignedToFixedBuffer(text, count);
        result = ui.label("count", FixedBufferView(text));
    }
    return result;
}

usize WriteVirtualListRowLabelBytes(in u64 rowKey, mut Array<u8, s_VirtualListLabelCapacity> outLabel){
    if(rowKey == 0u)
        return 0u;
    outLabel[0u] = 82u;
    outLabel[1u] = 111u;
    outLabel[2u] = 119u;
    outLabel[3u] = 32u;
    Array<u8, s_VirtualListMaxDecimalDigits> digits;
    usize digitCount = 0u;
    u64 remaining = rowKey;
    while(remaining > 0u && digitCount < s_VirtualListMaxDecimalDigits){
        digits[digitCount] = cast<u8>(48u + (remaining % 10u));
        remaining /= 10u;
        ++digitCount;
    }
    for(usize offset = 0u; offset < digitCount; ++offset)
        outLabel[s_VirtualListRowPrefixLength + offset] = digits[(digitCount - 1u) - offset];
    return s_VirtualListRowPrefixLength + digitCount;
}

Expected<SharedImageSource> LoadUiGallerySkinImageSource(mut GlobalArena arena, in AssetManager assets, in ActiveSceneSubsystems sceneSubsystems){
    const AssetRef<Texture> textureRef = ResolveUiGallerySkinTextureRef(assets, sceneSubsystems);
    if(!textureRef.valid())
        return MakeUnexpected(Failure());
    return LoadImageSource(arena, assets, textureRef);
}


