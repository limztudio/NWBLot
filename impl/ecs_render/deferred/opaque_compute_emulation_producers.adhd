#include <impl/global.adhd.h>
#include <impl/ecs_render/csg/task_graph_opaque_compute_tasks.adhd.h>
#include <impl/ecs_render/material/task_graph_opaque_compute_tasks.adhd.h>

#include <core/task/gpu/task_graph.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class DeferredGraphResourceImportResult;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct OpaqueComputeEmulationProducerInputs{
    const DeferredGraphResourceImportResult& resources;
    Core::GpuTaskResourceSetUse materialGeometrySetUse{};
    Core::GpuTaskResourceSetUse materialSampledTextureSetUse{};
    Core::BufferRange materialInstanceRange{};
    Core::BufferRange materialTypedRange{};
    Core::BufferRange csgReceiverRange{};
    Core::BufferRange csgCutterRange{};
    usize instanceCount = 0u;
    usize materialTypedByteCount = 0u;
    b8 materialDrawBuffersUploaded = false;
    b8 csgFrameBuffersUploaded = false;
    b8 materialFrameStatesGraphOwned = false;
    b8 materialGeometryStatesGraphOwned = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/csg/csg_graph_resource_snapshot.adhd>

[cpp_name("::NWB::Impl::OpaqueComputeEmulationProducerInputs"), cpp_header("<impl/ecs_render/deferred/opaque_compute_emulation_producers.adhd.h>")]
extern class OpaqueComputeEmulationProducerInputs;
[cpp_name("::NWB::Impl::ECSRenderDetail::OpaqueRegularComputeEmulationGraphTask::Payload"), cpp_header("<impl/ecs_render/material/task_graph_opaque_compute_tasks.adhd.h>")]
extern class OpaqueRegularComputeEmulationGraphTaskPayload;
[cpp_name("::NWB::Impl::ECSRenderDetail::OpaqueCsgReceiverComputeEmulationGraphTask::Payload"), cpp_header("<impl/ecs_render/csg/task_graph_opaque_compute_tasks.adhd.h>")]
extern class OpaqueCsgReceiverComputeEmulationGraphTaskPayload;

// Graph-owned compute producers that write generated vertices right before the G-buffer rasterizes them.
[modular]
class OpaqueComputeEmulationProducerBuilder : NoCopy{
    private mut GpuTaskGraph m_graph;

    public OpaqueComputeEmulationProducerBuilder(mut GpuTaskGraph graph){
        this.m_graph = graph;
    }

    public Expected<GpuTaskId> declareRegular(
        in OpaqueComputeEmulationProducerInputs inputs,
        in GpuTaskResourceSetUse outputUavSetUse,
        in GpuTaskId dependency,
        mut OpaqueRegularComputeEmulationGraphTaskPayload payload
    );
    public Expected<GpuTaskId> declareCsgReceiver(
        in OpaqueComputeEmulationProducerInputs inputs,
        in CsgGraphResourceSnapshot csgResources,
        in GpuTaskResourceSetUse outputUavSetUse,
        in GpuTaskId dependency,
        mut OpaqueCsgReceiverComputeEmulationGraphTaskPayload payload
    );
}


