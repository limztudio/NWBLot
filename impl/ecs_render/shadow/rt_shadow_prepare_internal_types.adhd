class ShadowPrepareGeometryInputs{
    public Span<PreparedMeshBlasBuild> blasBuilds;
    public Span<GpuGraphResourceId> traceResources;
    public b8 blasBuildsGraphOwned = false;
}

class ShadowPrepareUploadInputs{
    public in DeferredFrameTargets targets;
    public in RayTracingDeferredGraphResourceSnapshot rayTracingResources;
    public in RayTracingShadowPreparationResourceSnapshot rayTracingShadowResources;
    public GpuGraphResourceId currentBindlessSlots;
    public GpuGraphResourceId materialContextSlots;

    public ShadowPrepareUploadInputs(
        in borrow DeferredFrameTargets targets,
        in borrow RayTracingDeferredGraphResourceSnapshot rayTracingResources,
        in borrow RayTracingShadowPreparationResourceSnapshot rayTracingShadowResources,
        in GpuGraphResourceId currentBindlessSlots,
        in GpuGraphResourceId materialContextSlots
    ){
        this.targets = targets;
        this.rayTracingResources = rayTracingResources;
        this.rayTracingShadowResources = rayTracingShadowResources;
        this.currentBindlessSlots = currentBindlessSlots;
        this.materialContextSlots = materialContextSlots;
    }
}

class ShadowPrepareResourceInputs{
    public in RayTracingShadowPreparationResourceSnapshot rayTracingShadowResources;
    public in ShadowPrepareUploadChain uploads;
    public GpuGraphResourceId currentBindlessSlots;
    public GpuGraphResourceId materialContextSlots;
    public Span<GpuGraphResourceId> shadowTraceGeometryResources;
    public Span<GpuGraphResourceId> softwareBvhBuildStateResources;
    public Span<PreparedMeshBlasBuild> preparedMeshBlasBuilds;
    public b8 sceneTlasBuildGraphOwned;
    public b8 meshBlasBuildsGraphOwned;
    public b8 meshBlasGeometryBuildInputStatesGraphOwned;

    public ShadowPrepareResourceInputs(
        in borrow RayTracingShadowPreparationResourceSnapshot rayTracingShadowResources,
        in borrow ShadowPrepareUploadChain uploads,
        in GpuGraphResourceId currentBindlessSlots,
        in GpuGraphResourceId materialContextSlots,
        in Span<GpuGraphResourceId> shadowTraceGeometryResources,
        in Span<GpuGraphResourceId> softwareBvhBuildStateResources,
        in Span<PreparedMeshBlasBuild> preparedMeshBlasBuilds,
        in b8 sceneTlasBuildGraphOwned,
        in b8 meshBlasBuildsGraphOwned,
        in b8 meshBlasGeometryBuildInputStatesGraphOwned
    ){
        this.rayTracingShadowResources = rayTracingShadowResources;
        this.uploads = uploads;
        this.currentBindlessSlots = currentBindlessSlots;
        this.materialContextSlots = materialContextSlots;
        this.shadowTraceGeometryResources = shadowTraceGeometryResources;
        this.softwareBvhBuildStateResources = softwareBvhBuildStateResources;
        this.preparedMeshBlasBuilds = preparedMeshBlasBuilds;
        this.sceneTlasBuildGraphOwned = sceneTlasBuildGraphOwned;
        this.meshBlasBuildsGraphOwned = meshBlasBuildsGraphOwned;
        this.meshBlasGeometryBuildInputStatesGraphOwned = meshBlasGeometryBuildInputStatesGraphOwned;
    }
}

class ShadowPrepareResourcePlan{
    public Vector<GpuTaskResourceUse> resourceUses;
    public Array<GpuTaskResourceSetUse, s_ShadowPrepareResourceSetUseCapacity> resourceSetUses;
    public usize resourceSetUseCount = 0u;
    public Vector<GpuTaskResourceUse> accelStructFinalizeResourceUses;
    public GpuGraphResourceId sceneTlas;
}

class ShadowPrepareUploadChainBuilder : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut GraphicsRuntime m_graphics;
    private mut RendererRayTracingSystem m_raytracingSystem;

    public ShadowPrepareUploadChainBuilder(mut GpuTaskGraph graph, mut GraphicsRuntime graphics, mut RendererRayTracingSystem raytracingSystem){
        this.m_graph = graph;
        this.m_graphics = graphics;
        this.m_raytracingSystem = raytracingSystem;
    }

    [cpp_unwind]
    public b8 declare(in ShadowPrepareUploadInputs inputs, mut ShadowPrepareUploadChain chain){
        chain = ShadowPrepareUploadChain();
        if(
            !this.declareSelectorAndContextUploads(inputs, chain)
            || !this.declareSurfelFrameConstantsUpload(inputs, chain)
            || !this.declareShadowMaterialContextUploads(inputs, chain)
            || !this.declareSceneBvhUploads(inputs, chain)
            || !this.declareSceneTlasInstanceUpload(inputs, chain)
        ){
            chain = ShadowPrepareUploadChain();
            return false;
        }
        return true;
    }

    [cpp_unwind]
    private b8 declareSelectorAndContextUploads(in ShadowPrepareUploadInputs inputs, mut ShadowPrepareUploadChain chain);

    [cpp_unwind]
    private b8 declareSurfelFrameConstantsUpload(in ShadowPrepareUploadInputs inputs, mut ShadowPrepareUploadChain chain);

    [cpp_unwind]
    private b8 declareShadowMaterialContextUploads(in ShadowPrepareUploadInputs inputs, mut ShadowPrepareUploadChain chain);

    [cpp_unwind]
    private b8 declareSceneBvhUploads(in ShadowPrepareUploadInputs inputs, mut ShadowPrepareUploadChain chain);

    [cpp_unwind]
    private b8 declareSceneTlasInstanceUpload(in ShadowPrepareUploadInputs inputs, mut ShadowPrepareUploadChain chain);
}

class ShadowPrepareResourcePlanner : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut RendererMeshSystem m_meshSystem;

    public ShadowPrepareResourcePlanner(mut GpuTaskGraph graph, mut RendererRayTracingSystem raytracingSystem, mut RendererMeshSystem meshSystem){
        this.m_graph = graph;
        this.m_raytracingSystem = raytracingSystem;
        this.m_meshSystem = meshSystem;
    }

    [cpp_unwind]
    public b8 prepare(in ShadowPrepareResourceInputs inputs, mut ShadowPrepareResourcePlan result);
}

class ShadowSoftwareBvhBuildChain : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut RendererRayTracingSystem m_raytracingSystem;

    public ShadowSoftwareBvhBuildChain(mut GpuTaskGraph graph, mut RendererRayTracingSystem raytracingSystem){
        this.m_graph = graph;
        this.m_raytracingSystem = raytracingSystem;
    }

    [cpp_unwind]
    public b8 declare(
        in Span<PreparedMeshSwBvhGraphResources> pureSoftwareMeshSwBvhGraphResources,
        mut GpuTimingSubmissionTicket timingTicket,
        mut GpuTaskId shadowPrepareDependency,
        mut GpuTaskId firstTask,
        mut GpuTaskId lastTask
    );
}

class ShadowAccelerationFinalizeBuilder : NoCopy{
    private mut GpuTaskGraph m_graph;

    public ShadowAccelerationFinalizeBuilder(mut GpuTaskGraph graph){
        this.m_graph = graph;
    }

    [cpp_unwind]
    public Expected<GpuTaskId> declare(
        in b8 sceneTlasBuildGraphOwned,
        in GpuGraphResourceId sceneTlas,
        in usize preparedMeshBlasBuildCount,
        in Span<GpuTaskResourceUse> accelStructFinalizeResourceUses,
        in borrow GpuTaskId prepareTask
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize ResolveExpectedAccelStructFinalizeResourceUseCount(in b8 sceneTlasBuildGraphOwned, in usize preparedMeshBlasBuildCount){
    usize tlasCount = 0u;
    if(sceneTlasBuildGraphOwned)
        tlasCount = 1u;
    return tlasCount + preparedMeshBlasBuildCount;
}

b8 ValidateAccelStructFinalizeResourceUses(
    in b8 sceneTlasBuildGraphOwned,
    in b8 sceneTlasValid,
    in usize preparedMeshBlasBuildCount,
    in usize actualUseCount
){
    const usize expectedCount = ResolveExpectedAccelStructFinalizeResourceUseCount(sceneTlasBuildGraphOwned, preparedMeshBlasBuildCount);
    if((sceneTlasBuildGraphOwned && !sceneTlasValid) || actualUseCount != expectedCount){
        warning("RendererSystem: frozen acceleration-structure build has no final-state graph resources");
        return false;
    }
    return true;
}

usize ResolveShadowPrepareResourceUseReserveCount(
    in b8 hasCsgTraceContext,
    in b8 hasTlasInstanceBuffer,
    in usize shadowTraceGeometryCount,
    in usize softwareBvhBuildStateCount,
    in usize liveMeshBlasGraphStateCount,
    in usize preparedMeshBlasBuildCount
){
    usize csgCount = 0u;
    if(hasCsgTraceContext)
        csgCount = 1u;
    usize tlasInstanceCount = 0u;
    if(hasTlasInstanceBuffer)
        tlasInstanceCount = 1u;
    return s_ShadowPrepareResourceUseCapacity
        + csgCount
        + tlasInstanceCount
        + shadowTraceGeometryCount
        + softwareBvhBuildStateCount
        + liveMeshBlasGraphStateCount
        + preparedMeshBlasBuildCount * 2u;
}


