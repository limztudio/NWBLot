type Latin1VoidResult = Expected<void, Latin1TextError>;

[ordered]
class DecimalStorage{
    public NarrowChar first = cast<NarrowChar>(97u);
    public DecimalDigits buffer;
    public NarrowChar last = cast<NarrowChar>(122u);
}

class CaseLifetime{
    private mut b8 m_alive;

    public CaseLifetime(mut b8 alive){
        this.m_alive = alive;
        alive = true;
    }
    public ~CaseLifetime(){ this.m_alive = false; }
}

class TextEdit<Offset>{
    public Offset begin;
    public Offset end;
    public StringView text;

    public TextEdit(in Offset first, in Offset last, in StringView text){
        this.begin = first;
        this.end = last;
        this.text = text;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyGlobal_DecimalFormattingUsesExactMinimumStorageWithoutEmptySentinelsOrOverrun(){
    Array<usize, 7> values = Array<usize, 7>();
    values[0u] = 0u;
    values[1u] = 1u;
    values[2u] = 9u;
    values[3u] = 10u;
    values[4u] = 99u;
    values[5u] = 100u;
    values[6u] = usize.max;

    Array<StringView, 7> expectedTexts = Array<StringView, 7>();
    expectedTexts[0u] = "0";
    expectedTexts[1u] = "1";
    expectedTexts[2u] = "9";
    expectedTexts[3u] = "10";
    expectedTexts[4u] = "99";
    expectedTexts[5u] = "100";
    if(cast<u64>(usize.max) == u64.max)
        expectedTexts[6u] = "18446744073709551615";
    else
        expectedTexts[6u] = "4294967295";

    for(usize caseIndex = 0u; caseIndex < 7u; ++caseIndex){
        const usize value = values[caseIndex];
        ScopedTestTrace trace(value);
        String formatted = "";
        b8 usesBufferStart = false;
        u8 firstSentinel = 0u;
        u8 lastSentinel = 0u;
        DecimalStorage storage;
        RequireNothrowExpression(FormatTestDecimal(value, storage.buffer));
        const StringView text = FormatTestDecimal(value, storage.buffer);
        formatted.assign(text);
        usesBufferStart = TestDataAddress(text) == TestDataAddress(storage.buffer);
        firstSentinel = cast<u8>(storage.first);
        lastSentinel = cast<u8>(storage.last);
        const StringView formattedView = formatted;
        EXPECT_EQ(formattedView, expectedTexts[caseIndex]);
        EXPECT_TRUE(usesBufferStart);
        EXPECT_FALSE(formattedView.empty());
        EXPECT_EQ(firstSentinel, 97u);
        EXPECT_EQ(lastSentinel, 122u);
    }
}

void VerifyGlobal_MultiplicationDistinguishesOverflowSignedBoundariesAndSuccessfulZero(){
    EXPECT_FALSE(TryMultiply<usize>(usize.max, 2u).has_value());
    EXPECT_FALSE(TryMultiply<i64>(i64.min, -1).has_value());
    EXPECT_FALSE(TryMultiply<i64>(i64.max, 2).has_value());

    const Expected<u64> zeroProduct = TryMultiply<u64>(0u, u64.max);
    ASSERT_TRUE(zeroProduct.has_value());
    EXPECT_EQ(zeroProduct.value(), 0u);

    const Expected<i64> minProduct = TryMultiply<i64>(i64.min, 1);
    ASSERT_TRUE(minProduct.has_value());
    EXPECT_EQ(minProduct.value(), i64.min);
}

void VerifyGlobal_CheckedAdditionDistinguishesSignedLimitsAndSuccessfulZero(){
    EXPECT_FALSE(AddNoOverflow<i64>(i64.max, 1).has_value());
    EXPECT_FALSE(AddNoOverflow<i64>(i64.min, -1).has_value());
    const Expected<i64> lower = AddNoOverflow<i64>(i64.min, 1);
    const Expected<i64> upper = AddNoOverflow<i64>(i64.max, -1);
    const Expected<i64> zero = AddNoOverflow<i64>(i64.max, -i64.max);
    ASSERT_TRUE(lower.has_value());
    EXPECT_EQ(lower.value(), i64.min + 1);
    ASSERT_TRUE(upper.has_value());
    EXPECT_EQ(upper.value(), i64.max - 1);
    ASSERT_TRUE(zero.has_value());
    EXPECT_EQ(zero.value(), 0);
    EXPECT_FALSE(AddNoOverflow<u64>(u64.max, 1u).has_value());
}

void VerifyGlobal_NumericParsersRespectViewBoundsAndRejectEmptyInput(){
    const Expected<i64> signedValue = ParseI64(StringView("-42trailing").substr(0u, 3u));
    ASSERT_TRUE(signedValue.has_value());
    EXPECT_EQ(signedValue.value(), -42);
    EXPECT_FALSE(ParseI64("42x").has_value());
    const Expected<u64> unsignedValue = ParseU64(StringView("42trailing").substr(0u, 2u));
    ASSERT_TRUE(unsignedValue.has_value());
    EXPECT_EQ(unsignedValue.value(), 42u);
    EXPECT_FALSE(ParseU64("-1").has_value());
    EXPECT_FALSE(ParseI64(StringView()).has_value());
    EXPECT_FALSE(ParseU64(StringView()).has_value());
    EXPECT_FALSE(ParseF64(StringView()).has_value());
    EXPECT_FALSE(ParseF32(StringView()).has_value());
    const Expected<f64> doubleValue = ParseF64(StringView("1.25trailing").substr(0u, 4u));
    const Expected<f32> floatValue = ParseF32(StringView("1.25trailing").substr(0u, 4u));
    ASSERT_TRUE(doubleValue.has_value());
    ASSERT_TRUE(floatValue.has_value());
    EXPECT_EQ(doubleValue.value(), 1.25);
    EXPECT_EQ(floatValue.value(), 1.25f);
}

void VerifyGlobal_GrowingCapacitySaturatesAtSizeLimit(){
    EXPECT_EQ(NextGrowingCapacity((usize.max / 2u) + 1u, usize.max), usize.max);
}

void VerifyGlobal_CheckedDivideUpRejectsZeroDivisor(){
    const Expected<u32> divided = DivideUpChecked(17u, 0u);
    EXPECT_FALSE(divided.has_value());
}

void VerifyCpuTopologyTests_InvalidPlacementFailsWithoutMutatingTheCallingThread(){
    const CpuWorkerPlacement defaultInvalid = CpuWorkerPlacement();
    EXPECT_FALSE(defaultInvalid.valid());
    EXPECT_FALSE(SetCurrentThreadCpuPlacement(defaultInvalid));

    CpuWorkerPlacement invalidGroup = CpuWorkerPlacement();
    invalidGroup.logicalProcessorIndex = 0u;
    invalidGroup.processorGroup = u32.max;
    EXPECT_TRUE(invalidGroup.valid());
    EXPECT_FALSE(SetCurrentThreadCpuPlacement(invalidGroup));
}

void VerifyScopeExit_ReleaseIsIdempotentAndDestroysTheOwnedCallable(){
    u32 callsBeforeExit = 1u;
    u32 destructionsBeforeExit = 1u;
    u32 callsAfterExit = 1u;
    u32 destructionsAfterExit = 0u;
    CleanupState state;
    {
        CaseCleanup cleanup(MoveOnlyCleanup(state));
        cleanup.release();
        cleanup.release();
        callsBeforeExit = state.calls;
        destructionsBeforeExit = state.destructions;
    }
    callsAfterExit = state.calls;
    destructionsAfterExit = state.destructions;
    EXPECT_EQ(callsBeforeExit, 0u);
    EXPECT_EQ(destructionsBeforeExit, 0u);
    EXPECT_EQ(callsAfterExit, 0u);
    EXPECT_EQ(destructionsAfterExit, 1u);
}

[cpp_unwind]
void VerifyScopeExit_UnwindingRunsNestedCleanupInReverseOrderAndPropagatesFailure(){
    Array<u32, 3> order = Array<u32, 3>();
    u32 count = 0u;
    const auto operation = lambda[mut order, mut count]() -> void{
        const auto first = GuardCleanup(lambda[mut order, mut count]() -> void{ order[count] = 1u; ++count; });
        const auto second = GuardCleanup(lambda[mut order, mut count]() -> void{ order[count] = 2u; ++count; });
        auto released = GuardCleanup(lambda[mut order, mut count]() -> void{ order[count] = 3u; ++count; });
        released.release();
        ThrowTestException<ScopeExitFailure>(ScopeExitFailure());
    };
    EXPECT_TRUE(ThrowsException<ScopeExitFailure>(operation));
    EXPECT_EQ(count, 2u);
    EXPECT_EQ(order[0u], 2u);
    EXPECT_EQ(order[1u], 1u);
    EXPECT_EQ(order[2u], 0u);
}

[cpp_unwind]
void VerifyScopeExit_ResolvesTheFinalResultOnSuccessAndTheInitialResultOnUnwind(){
    b8 published = false;
    const auto operation = lambda[mut published](in b8 fails) -> b8{
        b8 completed = false;
        const auto publish = GuardCleanup(lambda[mut published, mut completed]() -> void{ published = completed; });
        if(fails)
            ThrowTestException<ScopeExitFailure>(ScopeExitFailure());
        completed = true;
        return completed;
    };
    EXPECT_TRUE(operation(false));
    EXPECT_TRUE(published);
    EXPECT_TRUE(ThrowsException<ScopeExitFailure>(lambda[in operation]() -> void{ operation(true); }));
    EXPECT_FALSE(published);
}

[cpp_unwind]
void VerifyScopeExit_CleanupObservesEarlierCapturedObjectsBeforeTheirDestruction(){
    b8 alive = false;
    b8 observedAlive = false;
    const auto operation = lambda[mut alive, mut observedAlive]() -> void{
        CaseLifetime lifetime(alive);
        const auto cleanup = GuardCleanup(lambda[mut observedAlive, mut alive]() -> void{ observedAlive = alive; });
        ThrowTestException<ScopeExitFailure>(ScopeExitFailure());
    };
    EXPECT_TRUE(ThrowsException<ScopeExitFailure>(operation));
    EXPECT_TRUE(observedAlive);
    EXPECT_FALSE(alive);
}

void VerifyGlobalSync_BoundedBackoffStopsAtItsPauseBudget(){
    AtomicBackOff backoff = AtomicBackOff();
    EXPECT_TRUE(backoff.boundedPause());
    EXPECT_TRUE(backoff.boundedPause());
    EXPECT_TRUE(backoff.boundedPause());
    EXPECT_TRUE(backoff.boundedPause());
    EXPECT_FALSE(backoff.boundedPause());
}

void VerifyGlobalSync_FutexPreservesEveryIncrementUnderContention(){
    const u32 threadCount = 4u;
    const u32 incrementsPerThread = 8192u;
    u32 value = 0u;
    Futex mutex;
    TestLatch startGate(threadCount + 1u);
    Array<Optional<TestThread>, 4u> workers;
    for(u32 threadIndex = 0u; threadIndex < threadCount; ++threadIndex){
        workers[threadIndex].emplace(lambda[mut mutex, mut startGate, mut value, in incrementsPerThread]() -> void{
            startGate.arrive_and_wait();
            for(u32 incrementIndex = 0u; incrementIndex < incrementsPerThread; ++incrementIndex){
                const FutexGuard lock = AcquireFutex(mutex);
                ++value;
            }
        });
    }
    startGate.arrive_and_wait();
    for(mut Optional<TestThread> worker : workers)
        worker.value().join();
    EXPECT_EQ(value, threadCount * incrementsPerThread);
}

[cpp_unwind]
void VerifyTerminalEntry_TypedTerminalHandlerRunsAfterWorkUnwindsWhileReportingContextRemainsAlive(){
    u32 cleanupCount = 0u;
    u32 handled = 0u;
    b8 reportingContextAlive = true;
    i32 result = 0;
    {
        const auto reportingContext = GuardCleanup(lambda[mut reportingContextAlive]() -> void{ reportingContextAlive = false; });
        result = InvokeTerminalEntry<TerminalTestError>(
            lambda[mut cleanupCount]() -> i32{
                const auto inner = GuardCleanup(lambda[mut cleanupCount]() -> void{ ++cleanupCount; });
                TerminalTestError failure;
                failure.result = 17;
                ThrowTestException<TerminalTestError>(failure);
                return -1;
            },
            lambda[mut cleanupCount, mut reportingContextAlive, mut handled](in TerminalTestError failure) -> i32{
                EXPECT_EQ(cleanupCount, 1u);
                EXPECT_TRUE(reportingContextAlive);
                ++handled;
                return failure.result;
            },
            lambda[]() -> i32{ return -1; }
        );
        EXPECT_TRUE(reportingContextAlive);
    }
    EXPECT_EQ(result, 17);
    EXPECT_EQ(handled, 1u);
    EXPECT_EQ(cleanupCount, 1u);
    EXPECT_FALSE(reportingContextAlive);
}

[cpp_unwind]
void VerifyTerminalEntry_UnknownFailureUsesItsTerminalHandlerAfterReverseOrderCleanup(){
    Array<u32, 3> order = Array<u32, 3>();
    u32 count = 0u;
    b8 typedHandled = false;
    i32 result = 0;
    result = InvokeTerminalEntry<TerminalTestError>(
        lambda[mut order, mut count]() -> i32{
            const auto first = GuardCleanup(lambda[mut order, mut count]() -> void{ order[count] = 1u; ++count; });
            const auto second = GuardCleanup(lambda[mut order, mut count]() -> void{ order[count] = 2u; ++count; });
            ThrowTestException<i32>(42);
            return -1;
        },
        lambda[mut typedHandled](in TerminalTestError failure) -> i32{ typedHandled = true; return 0; },
        lambda[mut order, mut count]() -> i32{ order[count] = 3u; ++count; return -1; }
    );
    EXPECT_EQ(result, -1);
    EXPECT_FALSE(typedHandled);
    EXPECT_EQ(count, 3u);
    EXPECT_EQ(order[0u], 2u);
    EXPECT_EQ(order[1u], 1u);
    EXPECT_EQ(order[2u], 3u);
}

void VerifyGlobal_FixedBufferTextViewsTruncateAtCapacityWithoutReadingPastSlice(){
    String copiedThree = "";
    String appendedTwo = "";
    String copiedFull = "";
    String clearedText = "nonempty";
    const StringView source = "abcdef";
    Array<NarrowChar, 5u> text;
    CopyTestBuffer(text, source.substr(0u, 3u));
    copiedThree.assign(ReadFixedText(text));
    AppendTestBuffer(text, source.substr(3u, 2u));
    appendedTwo.assign(ReadFixedText(text));
    CopyTestBuffer(text, source);
    copiedFull.assign(ReadFixedText(text));
    CopyTestBuffer(text, StringView());
    clearedText.assign(ReadFixedText(text));
    EXPECT_EQ(StringView(copiedThree), StringView("abc"));
    EXPECT_EQ(StringView(appendedTwo), StringView("abcd"));
    EXPECT_EQ(StringView(copiedFull), StringView("abcd"));
    EXPECT_TRUE(clearedText.empty());
}

void VerifyGlobal_Utf8DecoderRespectsBoundedNonterminatedInput(){
    const StringView text = StringView("\xF0\x9F\x98\x80", 4u);
    const Expected<DecodedUtf8CodePoint> decoded = DecodeUtf8CodePoint(text);
    ASSERT_TRUE(decoded.has_value());
    EXPECT_EQ(decoded.value().byteCount, 4);
    EXPECT_EQ(decoded.value().codePoint, 0x1F600u);
    for(usize size = 0u; size < text.size(); ++size)
        EXPECT_FALSE(DecodeUtf8CodePoint(text.substr(0u, size)).has_value());
    EXPECT_FALSE(DecodeUtf8CodePoint(StringView("\xC0\x80", 2u)).has_value());
}

void VerifyGlobal_CompactStringSearchUsesStoredCanonicalTextAndViewBoundaries(){
    CompactString compact = CompactString();
    ASSERT_TRUE(compact.assign("Folder\\Example"));
    EXPECT_EQ(compact.front(), 102u);
    EXPECT_EQ(compact.back(), 101u);
    EXPECT_EQ(compact.find(StringView("/example")), 6u);
    EXPECT_EQ(compact.find('e', 8u), 13u);
    EXPECT_EQ(compact.find(StringView(), compact.size()), compact.size());
    EXPECT_EQ(compact.find(StringView("EXAMPLE")), usize.max);
    EXPECT_EQ(compact.find('z'), usize.max);
}

void VerifyGlobal_RejectedACompactStringAssignResetsText(){
    CompactString compact = CompactString();
    ASSERT_TRUE(compact.assign("seed"));
    EXPECT_FALSE(compact.assign(StringView("a\0b", 3u)));
    EXPECT_TRUE(StringView(compact.c_str()).empty());
    EXPECT_TRUE(compact.empty());
    EXPECT_TRUE(compact.view().empty());
}

void VerifyGlobal_OversizedWideCompactStringAssignmentClearsPreviousValue(){
    b8 seededEmpty = true;
    b8 oversizedAccepted = true;
    b8 clearedAfterFailure = false;
    WideOverflowBuffer oversized;
    for(usize i = 0u; i < s_WideLimit + 1u; ++i)
        oversized[i] = cast<WideChar>(97u);
    WideCompact rejected(s_UnchangedWide);
    seededEmpty = rejected.empty();
    oversizedAccepted = rejected.assign(WidePrefix(oversized, s_WideLimit + 1u));
    clearedAfterFailure = rejected.empty();
    EXPECT_FALSE(seededEmpty);
    EXPECT_FALSE(oversizedAccepted);
    EXPECT_TRUE(clearedAfterFailure);
}

void VerifyGlobal_TextUtilitiesRejectNullShortAndOverflowingInput(){
    EXPECT_TRUE(FitsU32(cast<usize>(u32.max)));
    EXPECT_FALSE(FitsU32(cast<u64>(u32.max) + 1u));
    EXPECT_FALSE(FitsU32(-1));
    EXPECT_FALSE(StartsWith(StringView("al"), s_GlobalTestTableAlpha));

    const Expected<u64> value = ParseVariableHexU64(StringView("FFFFFFFFFFFFFFFF"));
    ASSERT_TRUE(value.has_value());
    EXPECT_EQ(value.value(), u64.max);
    EXPECT_FALSE(ParseVariableHexU64(StringView()).has_value());
    EXPECT_FALSE(ParseVariableHexU64(StringView("0x")).has_value());
    EXPECT_FALSE(ParseVariableHexU64(StringView("10000000000000000")).has_value());
    EXPECT_FALSE(ParseVariableHexU64(StringView("xyz")).has_value());

    const StringView keyValueText = "alpha=one\r\nbeta=42\nempty=\n";
    const Expected<StringView> textValue = FindLineKeyValue(keyValueText, "empty");
    ASSERT_TRUE(textValue.has_value());
    EXPECT_TRUE(textValue.value().empty());
    EXPECT_FALSE(FindLineKeyValue(keyValueText, "missing").has_value());

    EXPECT_TRUE(SafeNullableText(s_AbsentText).empty());
    EXPECT_TRUE(CanRepresentU64<u32>(u32.max));
    EXPECT_FALSE(CanRepresentU64<u32>(cast<u64>(u32.max) + 1u));
    EXPECT_TRUE(CanRepresentU64<i64>(cast<u64>(i64.max)));
    EXPECT_FALSE(CanRepresentU64<i64>(cast<u64>(i64.max) + 1u));
}

void VerifyGlobal_CallAndOptionTextRejectInvalidBoundaries(){
    EXPECT_EQ(SkipNumericSign(""), 0u);
    EXPECT_EQ(SkipNumericSign("-"), 1u);
    EXPECT_EQ(SkipNumericSign("+x"), 1u);
    EXPECT_EQ(ExtractLeadingIdentifier("9a-"), "9a");
    EXPECT_TRUE(IsEscapedQuoteAt("\\", 1u));
    EXPECT_FALSE(IsEscapedQuoteAt("\\\\", 2u));

    const Expected<CallTextParts> nestedCall = SplitNonemptyCallText("  item ( a(b) ) ");
    ASSERT_TRUE(nestedCall.has_value());
    EXPECT_EQ(nestedCall.value().name, "item");
    EXPECT_EQ(nestedCall.value().arguments, "a(b)");
    const Expected<CallTextParts> permissiveCall = SplitNonemptyCallText("f(a)b)");
    ASSERT_TRUE(permissiveCall.has_value());
    EXPECT_EQ(permissiveCall.value().arguments, "a)b");
    EXPECT_FALSE(SplitNonemptyCallText("item( \t )").has_value());
    EXPECT_FALSE(SplitNonemptyCallText("item()").has_value());
    EXPECT_FALSE(SplitNonemptyCallText("(value)").has_value());
    EXPECT_FALSE(SplitNonemptyCallText("item(value)tail").has_value());

    const Expected<CallTextParts> nullCall = SplitNonemptyCallText(StringView("f(\0x)", 5u));
    ASSERT_TRUE(nullCall.has_value());
    const StringView nullArgs = nullCall.value().arguments;
    ASSERT_EQ(nullArgs.size(), 2u);
    EXPECT_EQ(nullArgs[0u], 0u);

    Array<u32, 3> choices = Array<u32, 3>();
    choices[0u] = 0u;
    choices[1u] = 1u;
    choices[2u] = 2u;
    const auto optionText = lambda[](in u32 value) -> StringView{
        if(value == 2u)
            return "other";
        return "mixed";
    };
    const Expected<u32> parsed = ParseOptionText(StringView("  MiXeD\t"), Span<u32>(choices), optionText);
    ASSERT_TRUE(parsed.has_value());
    EXPECT_EQ(parsed.value(), 0u);
    EXPECT_FALSE(ParseOptionText(StringView("missing"), Span<u32>(choices), optionText).has_value());
    EXPECT_FALSE(ParseOptionText(StringView("mixed"), Span<u32>(), optionText).has_value());
}

void VerifyGlobal_TextReplacementsAndIdentifiersPreserveInputBoundaries(){
    String editableText = "abcdef";
    String proxyText = "abcdef";
    String upperIdentifier = "prefix:";
    u32 upperSelected = 0u;
    u32 pascalSelected = 0u;
    Array<TextEdit<usize>, 4u> edits = Array<TextEdit<usize>, 4u>(
        TextEdit<usize>(1u, 3u, ""), TextEdit<usize>(6u, 6u, ">"),
        TextEdit<usize>(4u, 6u, "XYZ"), TextEdit<usize>(0u, 0u, "<")
    );
    ApplyEdits(edits, editableText);
    Array<TextEdit<ReplacementOffset>, 2u> proxies = Array<TextEdit<ReplacementOffset>, 2u>(
        TextEdit<ReplacementOffset>(ReplacementOffset(4u), ReplacementOffset(6u), "Z"),
        TextEdit<ReplacementOffset>(ReplacementOffset(1u), ReplacementOffset(3u), "X")
    );
    EXPECT_NO_THROW(ApplyEdits(proxies, proxyText));
    AppendAsciiUpperIdentifier(StringView("a-\0\x80\x62", 5u), "VALUE", upperIdentifier);
    PointerFallbackProbe upper;
    RequireNothrowExpression(ProbeUpperIdentifier(StringView(), "VALUE", upper));
    ProbeUpperIdentifier(StringView(), "VALUE", upper);
    upperSelected = upper.selected;
    PointerFallbackProbe pascalProbe;
    RequireNothrowExpression(ProbePascalIdentifier(StringView(), "Value", pascalProbe));
    ProbePascalIdentifier(StringView(), "Value", pascalProbe);
    pascalSelected = pascalProbe.selected;

    EXPECT_EQ(StringView(editableText), StringView("<adXYZ>"));
    EXPECT_EQ(StringView(proxyText), StringView("aXdZ"));
    EXPECT_EQ(StringView(upperIdentifier), StringView("prefix:A___B"));
    AppendAsciiUpperIdentifier("___", "VALUE", upperIdentifier);
    AppendAsciiUpperIdentifier("", "VALUE", upperIdentifier);
    EXPECT_EQ(StringView(upperIdentifier), StringView("prefix:A___B___VALUE"));

    String pascalIdentifier = "prefix:";
    AppendUnderscoreSeparatedPascalIdentifier("_9-a_b", "Value", pascalIdentifier);
    AppendUnderscoreSeparatedPascalIdentifier("____", "Value", pascalIdentifier);
    EXPECT_EQ(StringView(pascalIdentifier), StringView("prefix:9-aBValue"));

    EXPECT_EQ(upperSelected, 1u);
    EXPECT_EQ(pascalSelected, 1u);
}

Latin1VoidResult EvalEncodeLatin1Text(in StringView text, in usize maxBytes, mut String output){
    return EncodeLatin1Text(text, maxBytes, output);
}

void VerifyGlobal_Latin1RejectsInvalidTextAndCapacity(){
    String latinText = String();
    ASSERT_TRUE(DecodeLatin1Text(StringView("\x80", 1u), 2u, latinText).has_value());
    EXPECT_EQ(StringView(latinText), StringView("\xC2\x80", 2u));

    const Latin1VoidResult tooSmall = DecodeLatin1Text(StringView("\x80", 1u), 1u, latinText);
    ASSERT_FALSE(tooSmall.has_value());
    EXPECT_EQ(tooSmall.error(), Latin1TextError::TooLarge);
    EXPECT_TRUE(latinText.empty());

    const Latin1VoidResult embeddedNul = DecodeLatin1Text(StringView("\x80\0", 2u), 2u, latinText);
    ASSERT_FALSE(embeddedNul.has_value());
    EXPECT_EQ(embeddedNul.error(), Latin1TextError::InvalidText);

    const Latin1VoidResult invalidUtf8 = EvalEncodeLatin1Text(StringView("\xC4\x80\xFF", 3u), 3u, latinText);
    ASSERT_FALSE(invalidUtf8.has_value());
    EXPECT_EQ(invalidUtf8.error(), Latin1TextError::InvalidText);
}

void VerifyGlobal_SourceAndNewlineTextPreserveBoundaries(){
    EXPECT_EQ(ReadFirstIdentifierAfterCComments(" \t/*one*/ //two\r\n123_name!"), "123_name");
    EXPECT_TRUE(ReadFirstIdentifierAfterCComments("/*unterminated*").empty());
    EXPECT_TRUE(ReadFirstIdentifierAfterCComments("//comment without newline").empty());
    EXPECT_TRUE(ReadFirstIdentifierAfterCComments(" @name").empty());
    EXPECT_TRUE(HasMatchingOuterParens("((x))"));
    EXPECT_FALSE(HasMatchingOuterParens("(x)(y)"));
    EXPECT_FALSE(HasMatchingOuterParens("(()"));
    EXPECT_FALSE(HasMatchingOuterParens("(x))"));

    String quoted = String();
    EXPECT_EQ(SkipQuotedLiteral("\"a\\\"b\"x", 0u), 6u);
    EXPECT_EQ(AppendQuotedLiteral("\"a\\\"b\"x", 0u, quoted), 6u);
    EXPECT_EQ(StringView(quoted), StringView("\"a\\\"b\""));
    EXPECT_EQ(SkipQuotedLiteral("\"a\\", 0u), 3u);

    String source = String();
    source.assign("a\\\r\nb\\\nc\\\rd");
    SpliceSourceLines(source);
    EXPECT_EQ(StringView(source), StringView("abc\\\rd"));
    source.assign("\"//\"/*a\nb*/x//c\n");
    MaskCStyleSourceComments(source);
    EXPECT_EQ(StringView(source), StringView("\"//\"   \n   x   \n"));

    String lineText = String();
    lineText.assign("\r\nx\n\r");
    CollapseCrLfInPlace(lineText);
    EXPECT_EQ(StringView(lineText), StringView("\nx\n\r"));

    EXPECT_EQ(StringView(JoinWithSingleSlash("a/", "/b")), "a/b");
    EXPECT_EQ(StringView(JoinWithSingleSlash("a", "b")), "a/b");
    EXPECT_EQ(StringView(JoinWithSingleSlash("", "b")), "");
    EXPECT_EQ(StringView(JoinWithSingleSlash("a/", "")), "a/");
    EXPECT_EQ(CountWideLineFeeds(s_MixedWideLines), 1u);
    Array<WideChar, 16u> expanded;
    const usize length = ExpandWideLines(s_MixedWideLines, expanded);
    EXPECT_EQ(WidePrefix(expanded, length), s_ExpandedWideLines);
    EXPECT_EQ(CountUtf8Scalars(StringView("a\xC3\xA9", 3u)), 2u);
}

void VerifyGlobal_UnsignedTextAndBytesAgreeAtMaximum(){
    String u64Text = String();
    Vector<u8> u64Bytes = Vector<u8>();
    AppendUnsignedU64Text(u64Text, u64.max);
    AppendUnsignedU64Bytes(u64Bytes, u64.max);
    EXPECT_EQ(StringView(u64Text), StringView("18446744073709551615"));
    ASSERT_EQ(u64Bytes.size(), u64Text.size());
    EXPECT_TRUE(BytesMatch(u64Bytes, TextBytes(StringView(u64Text))));
}

void VerifyGlobal_GraphemeAndTransparentHashRespectInvalidAndEmbeddedNull(){
    const Expected<Vector<usize>> emptyBoundaries = BuildGraphemeBoundaries(StringView());
    ASSERT_TRUE(emptyBoundaries.has_value());
    const Vector<usize> boundaries = emptyBoundaries.value();
    ASSERT_EQ(boundaries.size(), 1u);
    EXPECT_EQ(boundaries[0u], 0u);
    EXPECT_FALSE(BuildGraphemeBoundaries(StringView("\xED\xA0\x80", 3u)).has_value());

    usize keyHash = 0u;
    usize borrowedHash = 1u;
    b8 embeddedNullEqual = false;
    b8 shortPrefixEqual = true;
    const StringView borrowed = StringView("a\0b", 3u);
    const String key = String(borrowed);
    keyHash = HashText<String>(key);
    borrowedHash = HashText<String>(borrowed);
    embeddedNullEqual = EqualTestText(key, borrowed);
    shortPrefixEqual = EqualTestText(key, borrowed.substr(0u, 1u));
    EXPECT_EQ(keyHash, borrowedHash);
    EXPECT_TRUE(embeddedNullEqual);
    EXPECT_FALSE(shortPrefixEqual);
}

void VerifyGlobal_CsvAndCaseFormattingPreserveEscapes(){
    String csv = String();
    AppendTextDiscardCrAndExpandLf(csv, "a\rb\n");
    EXPECT_EQ(StringView(csv), "ab\r\n");
    csv.clear();
    AppendCamelToSnakeCase(csv, "HTTPServerRGB8Value");
    EXPECT_EQ(StringView(csv), "http_server_rgb8_value");
    csv.clear();
    AppendCsvCell("a,\"b\"\r\nc", csv);
    EXPECT_EQ(StringView(csv), "\"a,\"\"b\"\"\r\nc\"");
}


