#include <impl/assets_subsystem/cook.adhd>
#include <impl/assets_ui_skin/cook.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


register_asset UiSubsystem using SubsystemCookRegistration<UiSubsystem>;

Expected<UiSkin> CookUiSkinVolumeEntry(in UiSkinCookEntry entry){
    return BuildUiSkinAsset(entry);
}

b8 ExtractUiSkinDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    in CookDependencyItemContext contextRef = context;
    return context.visitDocument(lambda[in contextRef, mut collector](in MetascriptDocument doc) -> b8{
        const Expected<UiSkinCookEntry> entry = ParseUiSkinCookMetadata(contextRef.assetRoot, contextRef.virtualRoot, contextRef.nwbFilePath, doc);
        if(!entry.has_value())
            return false;
        return collector.addAssetDependency(entry.value().texture.name(), Texture::AssetTypeName());
    });
}

b8 RegisterUiSkinDependency(mut CookDependencyRegistry registry){
    return registry.registerType(UiSkin::AssetTypeName(), ExtractUiSkinDependencies);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

