#ifdef NWB_GRAPHICS_DEFERRED_LIGHTING_FRAMEWORK_SLANGI
#include "csg_event_diagnostic_inputs.slangi"
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


half3 NWB_DEFERRED_BXDF_FUNCTION(NwbBxdfSurface surface, int2 pixel){
#ifdef NWB_GRAPHICS_DEFERRED_LIGHTING_FRAMEWORK_SLANGI
    uint eventDataSlot;
    uint layers;
    if(!nwbCsgDiagnosticEventBounds(pixel, eventDataSlot, layers))
        return half3(0.0h);
    const uint eventCountSlot = g_NwbDeferredBindlessResources.csgSpanSlots.x;
    const uint eventCount = nwbHeapStorageImage2DArrayUint(eventCountSlot).Load(int3(pixel, 0));
    const uint count = min(eventCount, min(layers, NWB_CSG_RECEIVER_EVENT_LAYER_COUNT));
    uint frontCount = 0u;
    uint backCount = 0u;
    [unroll] for(uint index = 0u; index < NWB_CSG_RECEIVER_EVENT_LAYER_COUNT; ++index){
        if(index >= count)
            break;
        const uint faceSign = nwbHeapStorageImage2DArrayUint4(eventDataSlot).Load(int3(pixel, int(index))).y;
        frontCount += faceSign == NWB_CSG_RECEIVER_EVENT_FACE_FRONT ? 1u : 0u;
        backCount += faceSign == NWB_CSG_RECEIVER_EVENT_FACE_BACK ? 1u : 0u;
    }
    // Counts remain discrete after presentation; the extra raw-count level identifies overflow beyond 32 stored events.
    const uint overflowCount = NWB_CSG_RECEIVER_EVENT_LAYER_COUNT + 1u;
    return half3(float3(min(eventCount, overflowCount), frontCount, backCount) / float(overflowCount));
#else
    return half3(0.0h);
#endif
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

