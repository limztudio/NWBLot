const u16 s_CharCtrlFlagHitSensors = 0x0001u;
const u16 s_CharCtrlFlagStickToFloor = 0x0002u;
const u16 s_CharCtrlFlagPushDynamicBodies = 0x0004u;
const u16 s_CharCtrlFlagEnabled = 0x0008u;
const u16 s_CharCtrlFlagSyncFromTransform = 0x0010u;
const u16 s_CharCtrlFlagApplyStandingWeight = 0x0020u;
const u16 s_CharCtrlFlagFollowPlatformPitchRoll = 0x0040u;
const u16 s_CharCtrlFlagEnableGroundFriction = 0x0080u;
const u16 s_CharCtrlFlagEnableRotationalSweep = 0x0100u;
const u16 s_CharCtrlFlagEnableGravityAndSlopeSlide = 0x0200u;
const u16 s_CharCtrlFlagInheritPlatformVelocity = 0x0400u;
const u16 s_CharCtrlAllFlagsMask = 0x07ffu;

const u8 s_VehicleCompFlagEnabled = 0x01u;
const u8 s_VehicleCompFlagWriteBackToSkeleton = 0x02u;
const u8 s_VehicleCompAllFlagsMask = 0x03u;

const u8 s_RagdollCompFlagEnabled = 0x01u;
const u8 s_RagdollCompFlagKinematic = 0x02u;
const u8 s_RagdollCompFlagDriveToPose = 0x04u;
const u8 s_RagdollCompFlagDriveFromSkeleton = 0x08u;
const u8 s_RagdollCompFlagWriteBackToSkeleton = 0x10u;
const u8 s_RagdollCompFlagAutoGenerateFromSkeleton = 0x20u;
const u8 s_RagdollCompAllFlagsMask = 0x3fu;

const u8 s_FluidFlagVolumeEnabled = 0x01u;
const u8 s_FluidFlagComponentEnabled = 0x02u;
const u8 s_FluidFlagEnableDynamicWaveGrid = 0x04u;
const u8 s_FluidAllFlagsMask = 0x07u;

const u8 s_ForceFieldFlagUseBounds = 0x01u;
const u8 s_ForceFieldFlagFieldEnabled = 0x02u;
const u8 s_ForceFieldFlagComponentEnabled = 0x04u;
const u8 s_ForceFieldFlagEnableOcclusion = 0x08u;
const u8 s_ForceFieldAllFlagsMask = 0x0fu;

const u8 s_ArticulationCompFlagEnabled = 0x01u;
const u8 s_ArticulationCompFlagAutoGenerateFromSkeleton = 0x02u;
const u8 s_ArticulationCompFlagDriveFromSkeleton = 0x04u;
const u8 s_ArticulationCompFlagWriteBackToSkeleton = 0x08u;
const u8 s_ArticulationCompFlagWriteBackLinkTransforms = 0x10u;
const u8 s_ArticulationCompAllFlagsMask = 0x1fu;

const u8 s_SoftBodyCompFlagEnabled = 0x01u;
const u8 s_SoftBodyCompAllFlagsMask = 0x01u;

const u16 s_FractureCompFlagUseCustomHull = 0x0001u;
const u16 s_FractureCompFlagAnchorBottomChunks = 0x0002u;
const u16 s_FractureCompFlagAutoFractureOnImpact = 0x0004u;
const u16 s_FractureCompFlagUseHierarchyCollection = 0x0008u;
const u16 s_FractureCompFlagAllowSecondaryFracture = 0x0010u;
const u16 s_FractureCompFlagSpawnDetachedChunkEntities = 0x0020u;
const u16 s_FractureCompFlagGenerateChunkVisualMeshes = 0x0040u;
const u16 s_FractureCompFlagEnabled = 0x0080u;
const u16 s_FractureCompFlagHasCustomHullPayload = 0x0100u;
const u16 s_FractureCompAllFlagsMask = 0x01ffu;

const u8 s_GpuExportFlagEnabled = 0x01u;


[serialize]
class CharacterControllerComponentBinary{
    public f32x4 up(0.0f, 1.0f, 0.0f, 0.0f);
    public f32x4 boxHalfExtents(0.35f, 0.9f, 0.35f, 0.0f);
    public f32x4 customShapeScale(1.0f, 1.0f, 1.0f, 0.0f);
    public NameHash collisionLayerHash;
    public PhysicsFilterBinary filter;
    public f32 radius = 0.35f;
    public f32 halfHeight = 0.55f;
    public f32 skinWidth = 0.02f;
    public f32 maxSlopeAngleRad = 0.78539816f;
    public f32 stepUpHeight = 0.4f;
    public f32 stepDownHeight = 0.35f;
    public f32 maxStrength = 100.0f;
    public f32 mass = 75.0f;
    public f32 predictiveContactDistance = 0.08f;
    public f32 characterFriction = 0.6f;
    public f32 characterRestitution = 0.0f;
    public f32 gravityScale = 1.0f;
    public f32 slopeSlideAcceleration = 9.81f;
    public u32 maxCollisionIterations = 4u;
    public u32 maxConstraintIterations = 4u;
    public u16 flags = 0u;
    public u8 shapeType = 0u;
    public u8 reserved0 = 0u;
    public u64 reserved1 = 0u;
}

