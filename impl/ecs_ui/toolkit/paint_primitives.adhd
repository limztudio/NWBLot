#include <impl/assets_ui_skin/validation.adhd>

native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/images/image_source.adhd.h>
namespace NWB::Impl{
class UiSkin;
class Texture;
};
namespace NWB::Impl::Ui{
template<typename TUiSkin, typename TTexture>
class SkinBindingRecord;
using SkinBinding = SkinBindingRecord<NWB::Impl::UiSkin, NWB::Impl::Texture>;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Share of free space placed before an item to center it, or the midpoint of an extent.
const f32 s_RectCenterFraction = 0.5f;
const f64 s_RectCenterFractionF64 = 0.5;
const f32 s_UiMaxFloat = 3.40282346638528859812e+38f;
const f64 s_UiMaxFloatF64 = cast<f64>(s_UiMaxFloat);
const usize s_PaintMaxImages = 64u;
const usize s_PaintMaxOverlayDepth = 16u;
const usize s_PaintDefaultClipDepth = 8u;
const u32 s_PaintQuadVertexCount = 4u;
const u32 s_PaintQuadIndexCount = 6u;
const u32 s_PaintNineSliceAxisCells = 3u;
const usize s_PaintCallbackInlineBytes = 64u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> PaintMaterial{
    Solid,
    Skin,
    Glyph,
    SdfGlyph,
    Image,
}

enum<u8> UiRectPrecision{
    RoundedEndpoints,
    BoundedEndpoints,
    PreciseExtents,
    EmptyPaint,
}

class Point{
    public f32 x = 0.0f;
    public f32 y = 0.0f;
}

class Rect{
    public f32 x = 0.0f;
    public f32 y = 0.0f;
    public f32 width = 0.0f;
    public f32 height = 0.0f;
}

class Insets{
    public f32 left = 0.0f;
    public f32 top = 0.0f;
    public f32 right = 0.0f;
    public f32 bottom = 0.0f;
}

// Input colors use linear RGB and straight alpha; frozen vertices use premultiplied alpha.
class Color{
    public f32 r = 1.0f;
    public f32 g = 1.0f;
    public f32 b = 1.0f;
    public f32 a = 1.0f;
}

[serialize]
class Vertex{
    public Point position;
    public Point texCoord;
    public Color color;
}

class DisplayMetrics{
    public f32 logicalWidth = 0.0f;
    public f32 logicalHeight = 0.0f;
    public f32 pixelScaleX = 1.0f;
    public f32 pixelScaleY = 1.0f;
}

class DrawCommand{
    public Rect clip;
    public u32 firstIndex = 0u;
    public u32 indexCount = 0u;
    public u32 glyphPageIndex = 0xffffffffu;
    public u32 sdfPageIndex = 0xffffffffu;
    public u32 sdfChannel = 0u;
    // Base paint is layer zero; higher layers render later without changing owned index or image bindings.
    public u32 layer = 0u;
    public u32 textureImageIndex = 0xffffffffu;
    public PaintMaterial material = PaintMaterial::Solid;
}

// Typed references identify assets; this copy captures atlas metadata, not loaded/GPU resource ownership.
class SkinBindingRecord<TUiSkin, TTexture>{
    public AssetRef<TUiSkin> skin;
    public AssetRef<TTexture> texture;
    public u64 generation = 0u;
    public u32 atlasWidth = 0u;
    public u32 atlasHeight = 0u;
    public f32 referenceDensity = 1.0f;
}

class PaintOverlayFrame{
    public usize clipDepth = 0u;
    public u32 layer = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

