void VerifyUiListBehaviorTests_MissingDisabledOrMalformedActivationDoesNotModifyStateOrResult(){
    RangeSource source = RangeSource();
    source.disabledBegin = 3u;
    source.disabledEnd = 4u;
    ListState state = ListState();
    state.select(2u);
    ASSERT_TRUE(ReconcileListState(state, source));
    const ListResult previous = MakeUiListBehaviorResult(true, true, false, true);
    ListResult result = previous;
    ControlAction action = MakeRangeSourceAction(state, source, ControlActionKind::Activate);
    action.value = 99u;
    EXPECT_FALSE(ApplyListControlAction(source, ListOptions(), action, state, result));
    action.value = 4u;
    EXPECT_FALSE(ApplyListControlAction(source, ListOptions(), action, state, result));
    action.value = 5u;
    source.badLookup = true;
    EXPECT_FALSE(ApplyListControlAction(source, ListOptions(), action, state, result));
    EXPECT_EQ(state.selectedKey(), 2u);
    EXPECT_EQ(state.cursorKey(), 2u);
    ExpectUiSelectionResult(result, previous);
}

void VerifyUiListBehaviorTests_MalformedEnabledSearchFailsAtomically(){
    RangeSource source = RangeSource();
    ListState state = ListState();
    state.select(2u);
    ASSERT_TRUE(ReconcileListState(state, source));
    source.badFind = true;
    ListResult result = ListResult();
    EXPECT_FALSE(ApplyListControlAction(source, ListOptions(), MakeRangeSourceAction(state, source, ControlActionKind::Down), state, result));
    EXPECT_EQ(state.cursorKey(), 2u);
    EXPECT_EQ(state.selectedKey(), 2u);
    EXPECT_FALSE(result.valid);
}

void VerifyUiListBehaviorTests_HugeWheelDeltasClampWithoutMultiplicationOverflow(){
    RangeSource source = RangeSource();
    ListState state = ListState();
    ASSERT_TRUE(state.scrollTo(500.0));
    ASSERT_TRUE(ReconcileListState(state, source));
    ControlAction action = MakeRangeSourceAction(state, source, ControlActionKind::Wheel);
    action.delta = f64.max;
    action.step = f64.max;
    action.maximum = 1000.0;
    ListResult result = ListResult();
    ASSERT_TRUE(ApplyListControlAction(source, ListOptions(), action, state, result));
    EXPECT_DOUBLE_EQ(state.scrollOffset(), 0.0);
    action.delta = -f64.max;
    ASSERT_TRUE(ApplyListControlAction(source, ListOptions(), action, state, result));
    EXPECT_DOUBLE_EQ(state.scrollOffset(), 1000.0);
    action.delta = 0.0;
    action.maximum = 20.0;
    ASSERT_TRUE(ApplyListControlAction(source, ListOptions(), action, state, result));
    EXPECT_DOUBLE_EQ(state.scrollOffset(), 20.0);
}

void VerifyUiListBehaviorTests_InvalidWheelMetricsFailWithoutChangingOffsetOrResult(){
    RangeSource source = RangeSource();
    ListState state = ListState();
    ASSERT_TRUE(state.scrollTo(50.0));
    ASSERT_TRUE(ReconcileListState(state, source));
    ControlAction valid = MakeRangeSourceAction(state, source, ControlActionKind::Wheel);
    valid.delta = -1.0;
    valid.step = 32.0;
    valid.maximum = 300.0;
    ListResult result = ListResult();
    ControlAction action = valid;
    action.delta = bit_cast<f64>(cast<u64>(0x7ff8000000000000u));
    EXPECT_FALSE(ApplyListControlAction(source, ListOptions(), action, state, result));
    action = valid;
    action.step = 0.0;
    EXPECT_FALSE(ApplyListControlAction(source, ListOptions(), action, state, result));
    action = valid;
    action.maximum = -1.0;
    EXPECT_FALSE(ApplyListControlAction(source, ListOptions(), action, state, result));
    action = valid;
    action.maximum = bit_cast<f64>(cast<u64>(0x7ff0000000000000u));
    EXPECT_FALSE(ApplyListControlAction(source, ListOptions(), action, state, result));
    EXPECT_DOUBLE_EQ(state.scrollOffset(), 50.0);
    EXPECT_FALSE(result.valid);
}

void VerifyUiListBehaviorTests_InvalidOptionsKindsAndZeroPageSizeRejectWithoutChangingCursor(){
    RangeSource source = RangeSource();
    ListState state = ListState();
    state.select(2u);
    ASSERT_TRUE(ReconcileListState(state, source));
    const ControlAction valid = MakeRangeSourceAction(state, source, ControlActionKind::Down);
    ListOptions options = ListOptions();
    options.enabled = false;
    ListResult result = ListResult();
    EXPECT_FALSE(ApplyListControlAction(source, options, valid, state, result));
    options = ListOptions();
    options.wheelRows = 0.0f;
    EXPECT_FALSE(ApplyListControlAction(source, options, valid, state, result));
    options = ListOptions();
    options.wheelRows = bit_cast<f32>(0x7fc00000u);
    EXPECT_FALSE(ApplyListControlAction(source, options, valid, state, result));
    ControlAction action = valid;
    action.kind = bit_cast<ControlActionKind>(u8(255u));
    EXPECT_FALSE(ApplyListControlAction(source, ListOptions(), action, state, result));
    action.kind = ControlActionKind::PageDown;
    action.pageRows = 0u;
    EXPECT_FALSE(ApplyListControlAction(source, ListOptions(), action, state, result));
    EXPECT_EQ(state.cursorKey(), 2u);
    EXPECT_EQ(state.selectedKey(), 2u);
}

void VerifyUiListBehaviorTests_RepeatedHomeNoopPreservesEarlierSelectionChange(){
    RangeSource source = RangeSource();
    ListState state = ListState();
    ASSERT_TRUE(ReconcileListState(state, source));
    ListResult result = ListResult();
    ASSERT_TRUE(ApplyListControlAction(source, ListOptions(), MakeRangeSourceAction(state, source, ControlActionKind::Home), state, result));
    EXPECT_TRUE(result.selectionChanged);
    ASSERT_TRUE(ApplyListControlAction(source, ListOptions(), MakeRangeSourceAction(state, source, ControlActionKind::Home), state, result));
    EXPECT_TRUE(result.selectionChanged);
    EXPECT_FALSE(result.activated);
}


