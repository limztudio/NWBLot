#include <impl/assets_font_atlas/asset.adhd>
#include <impl/ecs_ui/toolkit/text/atlas_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type SdfAtlasPixels = Vector<u8>;
type SharedSdfAtlasPage = Shared<SdfAtlasPage>;

// Each channel holds a separate signed-distance page. Published pixels stay immutable.
class SdfAtlasPage : NoCopy{
    private SdfAtlasPageBindingRecord<Font> m_binding;
    private SdfAtlasPixels m_pixels;

    public SdfAtlasPage(in SdfAtlasPageBindingRecord<Font> binding, in Span<u8> pixels){
        this.m_binding = binding;
        AssignTriviallyCopyableVector(this.m_pixels, pixels);
    }

    public in SdfAtlasPageBindingRecord<Font> binding()const{ return this.m_binding; }
    public in SdfAtlasPixels pixels()const{ return this.m_pixels; }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<SharedSdfAtlasPage> CopySdfAtlasPage(in SharedPool pool, in SdfAtlasPageBindingRecord<Font> binding, in Span<u8> pixels){
    if(!ValidSdfAtlasPageBinding<Font>(binding, pixels.size()))
        return MakeUnexpected(Failure());
    SdfAtlasPageBindingRecord<Font> immutable = binding;
    immutable.pixelsSha256 = ComputeSha256(pixels);
    return pool.make<SdfAtlasPage>(immutable, pixels);
}

Expected<SharedSdfAtlasPage> CreateSdfAtlasPage(in SharedPool pool, in SdfAtlasPageBindingRecord<Font> binding, mut Vector<u8> pixels){
    Expected<SharedSdfAtlasPage> page = CopySdfAtlasPage(pool, binding, Span<u8>(pixels));
    if(page.has_value())
        pixels.clear();
    return page;
}

Expected<SharedSdfAtlasPage> CreateSdfAtlasPage(in SharedPool pool, in FontAtlas atlas, in u64 fontGeneration, in u64 atlasIdentity, in u32 groupIndex){
    in FontAtlasPayload payload = atlas.payload();
    if(groupIndex >= payload.groups.size())
        return MakeUnexpected(Failure());
    in FontAtlasGroup group = payload.groups[groupIndex];
    const SdfAtlasPageBindingRecord<Font> binding = MakeSdfAtlasPageGroupBinding<Font>(
        payload.font, payload.fontSha256, fontGeneration, atlasIdentity, groupIndex,
        group.width, group.height, group.channelCount, payload.spreadPixels
    );
    return CopySdfAtlasPage(pool, binding, Span<u8>(group.pixels));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

