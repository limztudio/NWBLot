////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <utilities/fbx_to_nwb/skin_matrix_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateSplitSkinSourceCounts(
    in usize skinCount,
    in usize skeletonJointCount,
    in usize bindPoseMatrixCount,
    in usize inverseBindMatrixCount
){
    if(skinCount == 0u){
        error("Failed to write NWB model: skinned model requires source skin influences");
        return false;
    }
    if(skeletonJointCount == 0u){
        error("Failed to write NWB model: skinned model requires skeleton joints");
        return false;
    }
    if(bindPoseMatrixCount != skeletonJointCount){
        error("Failed to write NWB model: skeleton bind-pose matrix count must match joint count");
        return false;
    }
    if(inverseBindMatrixCount != skeletonJointCount){
        error("Failed to write NWB model: skin inverse bind matrix count must match joint count");
        return false;
    }
    return true;
}

b8 ValidateSkeletonOutputInputCounts(in usize jointCount, in usize bindPoseCount, in usize inverseBindCount){
    if(jointCount != bindPoseCount || inverseBindCount != jointCount){
        error("Failed to write NWB skeleton: joint and matrix counts differ");
        return false;
    }
    if(jointCount > s_MaxSkeletonJointCount){
        error("Failed to write NWB skeleton: skeleton has more than {} joints", s_MaxSkeletonJointCount);
        return false;
    }
    return true;
}

Expected<u32> TryComputeSkeletonJointHierarchyDepth(in Span<u32> parentIndices, in usize jointIndex){
    u32 depth = 0u;
    u32 parentIndex = parentIndices[jointIndex];
    for(usize guard = 0u; parentIndex != s_MeshMissingStreamIndex; ++guard){
        if(guard >= parentIndices.size() || cast<usize>(parentIndex) >= parentIndices.size()){
            error("Failed to write NWB skeleton: skeleton hierarchy contains a cycle");
            return MakeUnexpected(Failure());
        }
        ++depth;
        parentIndex = parentIndices[cast<usize>(parentIndex)];
    }
    return depth;
}

b8 RemapSkinInfluence(in Span<u16> oldToNewJointIndices, mut MeshSkinInfluence inOutInfluence){
    for(usize slot = 0u; slot < s_SkinInfluenceJointCount; ++slot){
        const u16 oldJointIndex = inOutInfluence.joint[slot];
        if(cast<usize>(oldJointIndex) >= oldToNewJointIndices.size()){
            error("Failed to write NWB skin: skin influence references out-of-range joint {}", oldJointIndex);
            return false;
        }
        inOutInfluence.joint[slot] = oldToNewJointIndices[cast<usize>(oldJointIndex)];
    }
    return true;
}

b8 TryAccumulateFbxSkinWeight(
    in f64 value,
    in u32 clusterIndex,
    in Span<u16> clusterJoints,
    mut u32 inOutWrittenInfluenceCount,
    mut f64 inOutWeightSum,
    mut MeshSkinInfluence inOutResult
){
    if(!IsFinite(value)){
        error("Failed to build mesh: skin contains a non-finite weight");
        return false;
    }
    if(value <= 0.0)
        return true;
    if(cast<usize>(clusterIndex) >= clusterJoints.size()){
        error("Failed to build mesh: skin weight references an out-of-range cluster");
        return false;
    }
    const usize slot = cast<usize>(inOutWrittenInfluenceCount);
    inOutResult.joint[slot] = clusterJoints[cast<usize>(clusterIndex)];
    inOutResult.weight[slot] = cast<f32>(value);
    inOutWeightSum += value;
    ++inOutWrittenInfluenceCount;
    return true;
}

b8 TryNormalizeFbxSkinInfluenceWeights(in f64 weightSum, mut MeshSkinInfluence inOutInfluence){
    if(!IsFinite(weightSum) || weightSum <= 0.0){
        error("Failed to build mesh: skinned mesh contains a vertex with no positive skin weights");
        return false;
    }
    const f32 normalization = cast<f32>(s_UniformScaleNumerator / weightSum);
    const VectorSingle normalized = VectorSingle(inOutInfluence.weight) * VectorSingle(normalization);
    inOutInfluence.weight = f32x4u(normalized);
    return true;
}

b8 EqualMeshSkinInfluence(in MeshSkinInfluence lhs, in MeshSkinInfluence rhs){
    for(usize i = 0u; i < s_SkinInfluenceJointCount; ++i){
        if(lhs.joint[i] != rhs.joint[i] || FbxFloatingHashBits(lhs.weight[i]) != FbxFloatingHashBits(rhs.weight[i]))
            return false;
    }
    return true;
}

usize HashMeshSkinInfluence(in MeshSkinInfluence value){
    usize seed = HashValue(value.joint[0u]);
    for(usize i = 1u; i < s_SkinInfluenceJointCount; ++i)
        seed = HashCombineValue(seed, value.joint[i]);
    for(usize i = 0u; i < s_SkinInfluenceJointCount; ++i)
        seed = HashCombineValue(seed, FbxFloatingHashBits(value.weight[i]));
    return seed;
}

b8 SameEmittedStreamValue(in MeshSkinInfluence lhs, in MeshSkinInfluence rhs){
    return EqualMeshSkinInfluence(lhs, rhs);
}

b8 LessEmittedStreamValue(in MeshSkinInfluence lhs, in MeshSkinInfluence rhs){
    for(usize i = 0u; i < s_SkinInfluenceJointCount; ++i){
        if(lhs.joint[i] != rhs.joint[i])
            return lhs.joint[i] < rhs.joint[i];
    }
    for(usize i = 0u; i < s_SkinInfluenceJointCount; ++i){
        const u32 lhsBits = FbxFloatingHashBits(lhs.weight[i]);
        const u32 rhsBits = FbxFloatingHashBits(rhs.weight[i]);
        if(lhsBits != rhsBits)
            return lhsBits < rhsBits;
    }
    return false;
}

b8 ValidateFbxNewSkeletonJointCapacity(in usize jointCount){
    if(jointCount >= s_MaxSkeletonJointCount){
        error("Failed to build mesh: skeleton has more than {} joints", s_MaxSkeletonJointCount);
        return false;
    }
    return true;
}

usize AccumulateFbxJointCapacity(in usize currentCount, in usize clusterCount){
    const usize remaining = s_MaxSkeletonJointCount - currentCount;
    if(clusterCount < remaining)
        return currentCount + clusterCount;
    return currentCount + remaining;
}

Expected<usize> ValidateFbxSkinClusterCount(in usize clusterCount, in usize currentJointCount){
    if(clusterCount == 0u){
        error("Failed to build mesh: skin deformer contains no clusters");
        return MakeUnexpected(Failure());
    }
    if(clusterCount > cast<usize>(u32.max)){
        error("Failed to build mesh: skin deformer has too many clusters");
        return MakeUnexpected(Failure());
    }
    if(clusterCount > usize.max - currentJointCount){
        error("Failed to build mesh: skin deformer cluster count overflows skeleton joint capacity");
        return MakeUnexpected(Failure());
    }
    return currentJointCount + clusterCount;
}

b8 ValidateFbxSkinLogicalVertex(in u32 logicalVertex, in usize vertexCount){
    if(cast<usize>(logicalVertex) >= vertexCount){
        error("Failed to build mesh: skin deformer does not contain weights for every logical vertex");
        return false;
    }
    return true;
}

b8 ValidateFbxSkinVertexWeightRange(in u32 weightBegin, in u32 numWeights, in usize totalWeights){
    if(cast<usize>(weightBegin) <= totalWeights && cast<usize>(numWeights) <= totalWeights - cast<usize>(weightBegin))
        return true;

    error("Failed to build mesh: skin vertex weight range is out of bounds");
    return false;
}

b8 IsBeforeFbxSkeletonJointSortKey(
    in u32 lhsDepth,
    in u32 rhsDepth,
    in StringView lhsName,
    in StringView rhsName,
    in usize lhsIndex,
    in usize rhsIndex
){
    if(lhsDepth != rhsDepth)
        return lhsDepth < rhsDepth;
    if(lhsName != rhsName)
        return lhsName < rhsName;
    return lhsIndex < rhsIndex;
}


