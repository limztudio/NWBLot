#include <impl/ecs_render/shared/statistics_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererTaskTimingFeedbackPolicyTransition{
    public RendererTimingPolicy previousPolicy;
    public RendererTimingPolicy requestedPolicy;
    public RendererTaskTimingFeedbackCollectionAction action;

    public RendererTaskTimingFeedbackPolicyTransition(){
        this.previousPolicy = RendererTimingPolicy();
        this.requestedPolicy = RendererTimingPolicy();
        this.action = RendererTaskTimingFeedbackCollectionAction::None;
    }

    public RendererTaskTimingFeedbackPolicyTransition(in RendererTimingPolicy previousPolicy, in RendererTimingPolicy requestedPolicy, in RendererTaskTimingFeedbackCollectionAction action){
        this.previousPolicy = previousPolicy;
        this.requestedPolicy = requestedPolicy;
        this.action = action;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

