    public b8 setJointSixDofAxis(in JointId jointId, in u32 axisIndex, in SixDofAxisConfig cfg){
        if(!this.isValidJoint(jointId) || axisIndex >= 6u)
            return false;
        mut Joint j = this.m_joints[jointId.index];
        if(j.type != JointType::SixDof || j.extraDataIndex >= this.m_jointExtraData.size())
            return false;
        if(
            cast<u8>(cfg.motion) >= cast<u8>(JointMotion::kCount)
            || !IsFinite(cfg.lowerLimit)
            || !IsFinite(cfg.upperLimit)
            || !IsFinite(cfg.motorTargetVelocity)
            || !IsFinite(cfg.motorTargetPosition)
            || !IsFinite(cfg.maxMotorForce)
            || !IsFinite(cfg.springHertz)
            || !IsFinite(cfg.springDampingRatio)
            || cfg.upperLimit < cfg.lowerLimit
            || cfg.maxMotorForce < 0.0f
            || cfg.springHertz < 0.0f
            || cfg.springDampingRatio < 0.0f
        )
            return false;
        mut JointExtraData extra = this.m_jointExtraData[j.extraDataIndex];
        extra.sixDofAxes[axisIndex] = cfg;
        this.resetJointWarmStartAndWake(jointId.index);
        return true;
    }

    public b8 setJointPathPoints(in JointId jointId, in Span<f32x4> points, in b8 closed, in b8 lockRotation){
        if(!this.isValidJoint(jointId) || points.size() < 2u)
            return false;
        mut Joint j = this.m_joints[jointId.index];
        if(j.type != JointType::Path || j.extraDataIndex >= this.m_jointExtraData.size())
            return false;
        if(lockRotation && Vector3LengthSq(j.localAxisB()).x <= s_NormalizeEpsilonSq)
            return false;
        for(usize pi = 0u; pi < points.size(); ++pi){
            if(!IsFiniteVec3(VectorSingle(points[pi])))
                return false;
        }
        mut JointExtraData extra = this.m_jointExtraData[j.extraDataIndex];
        extra.pathPoints.clear();
        extra.pathPoints.reserve(points.size());
        for(usize pi = 0u; pi < points.size(); ++pi)
            extra.pathPoints.push_back(points[pi]);
        extra.pathClosed = closed;
        extra.pathLockRotation = lockRotation;
        this.resetJointWarmStartAndWake(jointId.index);
        return true;
    }

