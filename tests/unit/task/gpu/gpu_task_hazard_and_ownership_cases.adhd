using GpuHazardImportPublication = Core::GpuGraphResourceImportIndex::Publication;
using GpuHazardResourcePointerKey = Core::GpuTaskGraphDetail::ResourcePointerKey;

struct GpuHazardImportIndexRig{
    Core::Alloc::GlobalArena arena{ s_TaskGraphImportPartialPublication };
    Vector<Core::GpuTaskGraphDetail::GpuGraphResourceNode, Core::Alloc::GlobalArena> resources{ arena };
    Core::GpuGraphResourceImportIndex index{ arena };
};

struct GpuHazardOwnerImportContext{
    Core::Alloc::GlobalArena inputArena{ s_GpuCaseGraphImportIndexInputs };
    Core::Alloc::GlobalArena graphArena{ s_GpuCaseGraphImportIndexGraph };
    Core::GpuTaskGraph graph{ graphArena };
    Vector<Core::GpuGraphResourceDesc, Core::Alloc::GlobalArena> genericDescriptions{ inputArena };
    Vector<Core::GpuGraphResourceSetDesc, Core::Alloc::GlobalArena> setDescriptions{ inputArena };
    Vector<Core::GpuGraphResourceId, Core::Alloc::GlobalArena> resources{ inputArena };
    Vector<Core::GpuGraphResourceSetId, Core::Alloc::GlobalArena> sets{ inputArena };


public:
    [[nodiscard]] Span<const Core::GpuGraphResourceId> singleResourceSpan(const usize index)const noexcept{
        return Span<const Core::GpuGraphResourceId>(&resources[index], 1u);
    }
};

[[nodiscard]] FOUNDATION_INLINE GpuHazardResourcePointerKey MakeNonNullBufferPointerKey()noexcept{
    return GpuHazardResourcePointerKey{ reinterpret_cast<const void*>(1u), Core::GpuGraphResourceType::Buffer };
}

[[nodiscard]] FOUNDATION_INLINE Core::GpuTaskGraphDetail::ResourceImportMatch FindNullIdentityResourceImportMatch(
    const GpuHazardImportIndexRig& rig,
    const GpuHazardResourcePointerKey& pointer
)noexcept{
    return rig.index.findResourceImportMatch(rig.resources, nullptr, pointer);
}

[[nodiscard]] FOUNDATION_INLINE Core::GpuGraphInitialOwnerHandoffSourceDesc MakeHandoffSourceWithState(
    const Core::GpuTaskResourceRange& range,
    const Core::GpuPhysicalQueueId& sourceQueue,
    const Core::GpuPhysicalQueueId& destinationQueue,
    const Core::GpuExternalCompletionId& completion,
    const Core::QueueSubmissionToken& minimumCompletionToken,
    const Core::CommandListResourceStateHandoff& stateSource
)noexcept{
    return Core::GpuGraphInitialOwnerHandoffSourceDesc{
        .range = range,
        .sourceQueue = sourceQueue,
        .destinationQueue = destinationQueue,
        .completion = completion,
        .minimumCompletionToken = minimumCompletionToken,
        .stateSource = &stateSource,
    };
}

[[nodiscard]] FOUNDATION_INLINE Expected<Core::GpuTaskId> AddNativeRecordProbeTask(
    Core::GpuTaskGraph& graph,
    const Core::GpuTaskDesc& desc,
    u32& recordCount
){
    return graph.addTask<NativeRecordProbeTask>(desc, NativeRecordProbeTask::Payload{ .recordCount = &recordCount });
}

[[nodiscard]] FOUNDATION_INLINE Expected<Core::GpuTaskId> AddPacketLifecycleTask(
    Core::GpuTaskGraph& graph,
    const Core::GpuTaskDesc& desc,
    const Core::GpuQueueCapability::Mask requiredCapabilities
){
    return graph.addTask<PacketLifecycleTask>(desc, PacketLifecycleTask::Payload{ .requiredCapabilities = requiredCapabilities });
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


