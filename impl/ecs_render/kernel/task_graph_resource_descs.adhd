GpuGraphResourceDesc TextureResourceDesc(in Name identity, in StringView label){
    GpuGraphResourceDesc desc;
    desc.setIdentity(identity).setMarkerLabel(label).setType(GpuGraphResourceType::Texture);
    return desc;
}

