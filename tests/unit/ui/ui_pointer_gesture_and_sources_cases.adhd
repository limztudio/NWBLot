////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Point MakeUiPointerGesturePoint(in f32 x, in f32 y){
    Point point = Point();
    point.x = x;
    point.y = y;
    return point;
}

Rect MakeUiPointerGestureRect(in f32 x, in f32 y, in f32 width, in f32 height){
    Rect rect = Rect();
    rect.x = x;
    rect.y = y;
    rect.width = width;
    rect.height = height;
    return rect;
}

InputSource MakeUiPointerGestureSource(in u64 device, in u64 control){
    InputSource source = InputSource();
    source.device = device;
    source.control = control;
    return source;
}

HitTarget MakeUiPointerGestureTarget(in u64 idValue){
    HitTarget target = HitTarget();
    target.id.value = idValue;
    target.rectangle = MakeUiPointerGestureRect(10.0f, 20.0f, 80.0f, 30.0f);
    target.clip = MakeUiPointerGestureRect(0.0f, 0.0f, 200.0f, 200.0f);
    target.pointerGesture = true;
    return target;
}

InputEvent MakeUiPointerGestureEventAt(in InputEventTypeEnum type, in f32 x, in f32 y){
    InputEvent event = InputEvent();
    event.type = type;
    event.position = MakeUiPointerGesturePoint(x, y);
    return event;
}

InputEvent MakeUiPointerGestureEvent(in InputEventTypeEnum type){
    return MakeUiPointerGestureEventAt(type, 15.0f, 25.0f);
}

InputEvent MakeUiPointerGestureBareEvent(in InputEventTypeEnum type){
    return MakeUiPointerGestureEventAt(type, 0.0f, 0.0f);
}

InputEvent MakeUiPointerGestureKeyEvent(in InputEventTypeEnum type, in KeyEnum key){
    InputEvent event = InputEvent();
    event.type = type;
    event.key = key;
    return event;
}

HitTarget MakeUiPointerHitTargetWithRect(in u64 idValue, in Rect rectangle){
    HitTarget target = HitTarget();
    target.id.value = idValue;
    target.declarationGeneration = 7u;
    target.rectangle = rectangle;
    target.clip = MakeUiPointerGestureRect(0.0f, 0.0f, 200.0f, 150.0f);
    target.focusable = true;
    target.activatable = true;
    target.pointerGesture = true;
    return target;
}

HitTarget MakeUiPointerHitTarget(in u64 idValue){
    return MakeUiPointerHitTargetWithRect(idValue, MakeUiPointerGestureRect(0.0f, 0.0f, 100.0f, 100.0f));
}

PointerInput MakeUiPointerContactFull(in PointerPhaseEnum phase, in InputSource source, in f32 x, in f32 y, in b8 hoverCapable, in PointerIntentEnum intent){
    PointerInput input = PointerInput();
    input.source = source;
    input.phase = phase;
    input.intent = intent;
    input.position = MakeUiPointerGesturePoint(x, y);
    input.hoverCapable = hoverCapable;
    return input;
}

PointerInput MakeUiPointerContactHover(in PointerPhaseEnum phase, in InputSource source, in f32 x, in f32 y, in b8 hoverCapable){
    return MakeUiPointerContactFull(phase, source, x, y, hoverCapable, PointerIntent::Activate);
}

PointerInput MakeUiPointerContactAt(in PointerPhaseEnum phase, in InputSource source, in f32 x, in f32 y){
    return MakeUiPointerContactFull(phase, source, x, y, false, PointerIntent::Activate);
}

PointerInput MakeUiPointerContact(in PointerPhaseEnum phase, in InputSource source){
    return MakeUiPointerContactFull(phase, source, 20.0f, 20.0f, false, PointerIntent::Activate);
}


