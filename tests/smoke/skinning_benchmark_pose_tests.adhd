#include <tests/common/gtest_macros.adhd>
#include <tests/common/ecs_test_world.adhd>
#include "presentation_types.adhd"
#include "scene_types.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_skeleton/components.adhd.h>
#include <core/ecs/entity.h>

namespace NWB::Tests::Smoke{
    using EcsTestWorld = NWB::Tests::EcsTestWorld;
    using EntityID = NWB::Core::ECS::EntityID;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_SkinningBenchmarkTestJointCount = 64u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 JointMatricesEqual(in Span<f32x3x4> lhs, in Span<f32x3x4> rhs, in usize index){
    b8 equal = false;
    native(in lhs, in rhs, in index, mut equal){
        equal = NWB_MEMCMP(&lhs[index], &rhs[index], sizeof(lhs[index])) == 0;
    }
    return equal;
}

void AnimateSkinningBenchmarkTestEntities(mut EcsTestWorld context, in Span<EntityID> entities, in Span<f32x3x4> bindJoints, in f32 timeSeconds, in b8 staticPreview){
    for(usize entityIndex = 0u; entityIndex < entities.size(); ++entityIndex){
        const EntityID entity = entities[entityIndex];
        const u32 seedIndex = cast<u32>(entityIndex);
        native(mut context, in entity, in bindJoints, in seedIndex, in timeSeconds, in staticPreview){
            if(auto* pose = context.world.tryGetComponent<NWB::Impl::SkeletonPoseComponent>(entity))
                AnimateSkinningBenchmarkPoseJoints(bindJoints, seedIndex, timeSeconds, staticPreview, pose->localJoints);
        }
    }
}

void ReadSkinningBenchmarkPoseJoints(in EcsTestWorld context, in EntityID entity, mut Vector<f32x3x4> outJoints){
    outJoints.clear();
    native(in context, in entity, mut outJoints){
        if(const auto* pose = context.world.tryGetComponent<NWB::Impl::SkeletonPoseComponent>(entity)){
            for(const auto& joint : pose->localJoints)
                outJoints.push_back(joint);
        }
    }
}

void VerifySkinningBenchmarkPoseStep1(in Span<f32x3x4> bindJoints, in Span<f32x3x4> localJoints, mut Vector<f32x3x4> firstPose){
    EXPECT_TRUE(JointMatricesEqual(localJoints, bindJoints, 0u));
    u32 changedJoints = 0u;
    for(usize i = 0u; i < bindJoints.size(); ++i){
        firstPose.push_back(localJoints[i]);
        if(!JointMatricesEqual(localJoints, bindJoints, i))
            ++changedJoints;
    }
    EXPECT_GT(changedJoints, 0u);
}

void VerifySkinningBenchmarkPoseStep2(in Span<f32x3x4> firstPose, in Span<f32x3x4> localJoints){
    for(usize i = 0u; i < firstPose.size(); ++i)
        EXPECT_TRUE(JointMatricesEqual(localJoints, firstPose, i));
}

void VerifySkinningBenchmarkPoseStep3(in Span<f32x3x4> firstPose, in Span<f32x3x4> localJoints){
    b8 changedWithTime = false;
    for(usize i = 1u; i < firstPose.size(); ++i)
        changedWithTime = changedWithTime || !JointMatricesEqual(localJoints, firstPose, i);
    EXPECT_TRUE(changedWithTime);
}

void VerifySkinningBenchmarkPoseStep4(in Span<f32x3x4> bindJoints, in Span<f32x3x4> localJoints){
    EXPECT_TRUE(JointMatricesEqual(localJoints, bindJoints, 0u));
    b8 changedInBenchmarkMode = false;
    for(usize i = 1u; i < bindJoints.size(); ++i)
        changedInBenchmarkMode = changedInBenchmarkMode || !JointMatricesEqual(localJoints, bindJoints, i);
    EXPECT_TRUE(changedInBenchmarkMode);
}

void VerifySkinningBenchmarkPose(){
    EcsTestWorld context = EcsTestWorld();
    EntityID skeleton = EntityID();
    EntityID missingPose = EntityID();
    Vector<f32x3x4> bindJoints;
    Vector<f32x3x4> firstPose;
    Vector<f32x3x4> localJoints;
    native(mut context, mut skeleton, mut missingPose, mut bindJoints){
        auto& world = context.world;
        skeleton = world.createEntity().id();
        missingPose = world.createEntity().id();
        auto& pose = world.entity(skeleton).addComponent<NWB::Impl::SkeletonPoseComponent>();
        for(u32 i = 0u; i < s_SkinningBenchmarkTestJointCount; ++i){
            const Float34 identity = MatrixIdentity<Float34>();
            bindJoints.push_back(identity);
            pose.localJoints.push_back(identity);
        }
    }
    Array<EntityID, 2u> entities;
    entities[0u] = missingPose;
    entities[1u] = skeleton;

    AnimateSkinningBenchmarkTestEntities(context, entities, bindJoints, 0.25f, true);
    ReadSkinningBenchmarkPoseJoints(context, skeleton, localJoints);
    VerifySkinningBenchmarkPoseStep1(bindJoints, localJoints, firstPose);

    AnimateSkinningBenchmarkTestEntities(context, entities, bindJoints, 0.25f, true);
    ReadSkinningBenchmarkPoseJoints(context, skeleton, localJoints);
    VerifySkinningBenchmarkPoseStep2(firstPose, localJoints);

    AnimateSkinningBenchmarkTestEntities(context, entities, bindJoints, 1.0f, true);
    ReadSkinningBenchmarkPoseJoints(context, skeleton, localJoints);
    VerifySkinningBenchmarkPoseStep3(firstPose, localJoints);

    AnimateSkinningBenchmarkTestEntities(context, entities, bindJoints, 0.25f, false);
    ReadSkinningBenchmarkPoseJoints(context, skeleton, localJoints);
    VerifySkinningBenchmarkPoseStep4(bindJoints, localJoints);
}

NWB_ADHD_GTEST(SkinningBenchmarkPose, MissingPoseIsSkippedAndSeededJointsAreDeterministic, VerifySkinningBenchmarkPose)


