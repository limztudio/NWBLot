#include <loader/project_entry.adhd.h>

#include <impl/assets_csg/shape_id.adhd.h>
#include <impl/ecs_csg/module.adhd.h>
#include <impl/ecs_scene/module.adhd.h>
#include <impl/ecs_render/module.adhd.h>

#include <core/alloc/scratch.h>
#include <core/common/log.h>
#include <core/ecs/module.h>
#include <core/graphics/runtime/runtime.h>

#include <global/simd/frame.h>
#include <global/simdmath.h>

namespace NWB::Tests::Smoke{
[[nodiscard]] inline TStringView CsgShadowProjectName()noexcept{
    return NWB_TEXT("CsgShadowSmokeProjectImpl");
}

[[nodiscard]] inline NotNullUniquePtr<World> CreateCsgShadowWorldOrDie(ProjectRuntimeContext& context){
    auto world = CreateSmokeWorldOrDie(CsgShadowProjectName(), context);
    auto& renderer = AddSmokeRenderSystems(*world, context);
    Impl::ReflectionSettings reflection;
    reflection.traceMode = Impl::ReflectionTraceMode::Disabled;
    NWB_FATAL_ASSERT_MSG(renderer.setReflectionSettings(reflection), NWB_TEXT("Invalid CSG shadow reflection settings"));
    renderer.setRefractionEnabled(false);
    Impl::PresentationSettings presentation;
    presentation.toneMap = Impl::PresentationToneMap::LinearClamp;
    NWB_FATAL_ASSERT_MSG(renderer.setPresentationSettings(presentation), NWB_TEXT("Invalid CSG shadow presentation settings"));
    return world;
}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const SmokeMeshRef s_CsgShadowPlaneMesh = "project/meshes/shadow_plane";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CsgShadowSmokeProjectImpl : IProjectEntryCallbacks{
    public CsgShadowSmokeProjectImpl(mut ProjectRuntimeContext context){
        this.m_context = context;
        this.m_world = CreateCsgShadowWorldOrDie(context);
    }

    public ~CsgShadowSmokeProjectImpl(){
        this.destroyWorld();
    }

    public b8 onStartup()override{
        if(!this.m_mode.read(s_CsgCausticSmokeEnabled))
            return false;

        f32 cameraX = 0.0f;
        if(this.m_mode.arm == CsgShadowArm::CameraShift)
            cameraX = 0.3f;

        f32 angularRadius = 0.0f;
        if(this.m_mode.finiteLightSource && !this.m_mode.pointLight)
            angularRadius = 0.005f;
        f32 sourceRadius = 0.0f;
        if(this.m_mode.finiteLightSource && this.m_mode.pointLight)
            sourceRadius = 0.02f;
        b8 enableCaustics = false;
        if(s_CsgCausticSmokeEnabled){
            enableCaustics = !ReadSmokeEnvironmentFlag("NWB_CSG_CAUSTIC_DISABLED");
            StringView photonState = "disabled";
            if(enableCaustics)
                photonState = "enabled";
            [essential] info("CsgCausticSmokeProject: photons {}", photonState);
        }

        b8 atlasCreated = false;
        b8 hardware = false;
        native(
            in cameraX,
            in pointLight = this.m_mode.pointLight,
            in angularRadius,
            in sourceRadius,
            in enableCaustics,
            in mode = this.m_mode,
            mut atlas = this.m_atlas,
            mut world = this.m_world,
            mut ctx = this.m_context,
            mut atlasCreated,
            mut hardware
        ){
            const auto camera = CreateSmokeCamera(0.0f, -s_ShadowSmokeCameraDepth, 0.0f, *world);
            NWB_FATAL_ASSERT_MSG(camera.valid(), NWB_TEXT("CsgShadowSmokeProjectImpl: camera creation failed"));
            auto& cameraTransform = *MakeNotNull(world->tryGetComponent<Impl::Scene::TransformComponent>(camera));
            cameraTransform.position.x = cameraX;

            const auto receiver = CreateTintedStaticMeshEntity(
                s_CsgShadowPlaneMesh,
                s_CsgShadowOpaqueMaterial,
                NameTextAscii(s_ShadowSmokeMaterialInterface),
                VectorSet(1.0f, 1.0f, 1.0f, 1.0f),
                VectorZero(),
                VectorSet(4.0f, 1.0f, 3.0f, 0.0f),
                *world
            );
            NWB_FATAL_ASSERT_MSG(receiver.valid(), NWB_TEXT("CsgShadowSmokeProjectImpl: camera/receiver creation failed"));
            auto& receiverTransform = *MakeNotNull(world->tryGetComponent<Impl::Scene::TransformComponent>(receiver));
            StoreFloat(QuaternionRotationRollPitchYaw(-s_PIDIV2, 0.0f, 0.0f), receiverTransform.rotation);

            const auto light = pointLight
                ? Impl::Scene::CreatePointLightEntity(*world, Float4(0.0f, 0.0f, -12.0f, 0.0f), Float4(1.0f, 1.0f, 1.0f, 1.0f), 1.0f, 30.0f)
                : Impl::Scene::CreateDirectionalLightEntity(*world, 0.0f, 0.0f, 0.0f, Float4(1.0f, 1.0f, 1.0f, 1.0f), 1.0f);
            NWB_FATAL_ASSERT_MSG(light.valid(), NWB_TEXT("CsgShadowSmokeProjectImpl: light creation failed"));
            auto& lightComponent = *MakeNotNull(world->tryGetComponent<Impl::Scene::LightComponent>(light));
            lightComponent.angularRadius = angularRadius;
            lightComponent.sourceRadius = sourceRadius;
            lightComponent.enableCaustics = enableCaustics;

            const AStringView sourceLabel = mode.finiteLightSource ? s_ShadowSmokeFinite : s_ShadowSmokeHard;
            NWB_LOGGER_ESSENTIAL_INFO(
                NWB_TEXT("CsgShadowSmokeProjectImpl: light_source={} angular_radius={:.3f} source_radius={:.3f}"),
                ConvertString(sourceLabel),
                static_cast<f64>(angularRadius),
                static_cast<f64>(sourceRadius)
            );
            atlasCreated = atlas.create(mode, s_CsgShadowOpaqueMaterial, *world);
            hardware = ctx.graphics.queryFeatureSupport(Core::Feature::RayQuery) && ctx.graphics.queryFeatureSupport(Core::Feature::RayTracingAccelStruct);
        }
        if(!atlasCreated)
            return false;

        StringView lightLabel = s_ShadowSmokeDirectional;
        if(this.m_mode.pointLight)
            lightLabel = s_ShadowSmokePoint;
        u32 hwVal = 0u;
        if(hardware)
            hwVal = 1u;
        [essential] info(
            "CsgShadowSmokeProjectImpl: atlas arm={} light={} hardware={} camera_x={} caster_z_max=-5 receiver_z=0"
            , cast<u32>(this.m_mode.arm)
            , lightLabel
            , hwVal
            , cast<f64>(cameraX)
        );

        SmokeCaptureFactory captureFactory = SmokeCaptureFactory(this.m_context);
        Expected<UniquePtr<FramebufferCapture>> capture = captureFactory.configure(CsgShadowProjectName(), s_ShadowSmokeDefaultCaptureFrameCount);
        if(!capture.has_value())
            return false;
        native(mut dstCapture = this.m_capture, mut capture){
            dstCapture = Move(*capture);
        }

        if(s_CsgCausticSmokeEnabled && !this.configureTiming())
            return false;
        return true;
    }

    public void onShutdown()override{
        if(s_CsgCausticSmokeEnabled){
            native(mut timing = this.m_timing){
                if(timing)
                    timing->finish();
            }
        }
        this.destroyWorld();
        [essential] info("CsgShadowSmokeProjectImpl: shutdown");
    }

    public b8 onUpdate(in f32 delta)override{
        native(mut capture = this.m_capture){
            if(capture)
                capture->update();
        }
        ++this.m_update;
        if(this.m_mode.arm == CsgShadowArm::Moved && this.m_update == s_ShadowSmokeMoveUpdate){
            native(mut atlas = this.m_atlas, mut world = this.m_world){
                atlas.moveCutters(*world);
            }
            [essential] info("CsgShadowSmokeProjectImpl: cutters moved at update40");
        }
        const f32 fixedDelta = RendererBaselineFixedDelta();
        f32 tickDelta = delta;
        if(fixedDelta > 0.0f)
            tickDelta = fixedDelta;
        b8 ticked = false;
        native(in tickDelta, mut world = this.m_world, mut ticked){
            ticked = TickSmokeWorld(tickDelta, *world);
        }
        if(!ticked)
            return false;
        if(s_CsgCausticSmokeEnabled){
            b8 timingOk = true;
            native(mut timing = this.m_timing, mut timingOk){
                if(timing && !timing->update())
                    timingOk = false;
            }
            if(!timingOk)
                return false;
        }
        return true;
    }

    private b8 configureTiming(){
        const Expected<String> mode = ReadSmokeEnvironmentString("NWB_CSG_CAUSTIC_TIMING_MODE");
        const Expected<String> output = ReadSmokeEnvironmentString("NWB_CSG_CAUSTIC_TIMING_FILE");
        const Expected<String> cpuOutput = ReadSmokeEnvironmentString("NWB_CSG_CAUSTIC_CPU_GPU_FILE");
        const Expected<String> start = ReadSmokeEnvironmentString("NWB_CSG_CAUSTIC_TIMING_START_FILE");
        if(!mode.has_value()){
            if(output.has_value() || cpuOutput.has_value() || start.has_value()){
                error("CsgCausticTiming: mode and explicit output must agree");
                return false;
            }
            return true;
        }
        const StringView modeView = StringView(mode.value());
        const Expected<String> route = ReadSmokeEnvironmentString("NWB_CSG_CAUSTIC_TIMING_ROUTE");
        StringView routeView = "";
        if(route.has_value())
            routeView = StringView(route.value());

        b8 hasCaptureOrMissingQuit = false;
        b8 rayTracing = false;
        b8 rayQuery = false;
        usize receivers = 0u;
        usize cutters = 0u;
        native(
            in capture = this.m_capture,
            in ctx = this.m_context,
            in world = this.m_world,
            mut hasCaptureOrMissingQuit,
            mut rayTracing,
            mut rayQuery,
            mut receivers,
            mut cutters
        ){
            hasCaptureOrMissingQuit = static_cast<b8>(capture) || !ctx.requestQuit;
            rayTracing = ctx.graphics.queryFeatureSupport(Core::Feature::RayTracingAccelStruct);
            rayQuery = ctx.graphics.queryFeatureSupport(Core::Feature::RayQuery);
            receivers = world->view<Impl::StaticCsgMeshComponent>().candidateCount() + world->view<Impl::SkinnedCsgMeshComponent>().candidateCount();
            cutters = world->view<Impl::CsgCutterComponent>().candidateCount();
        }

        if(
            (modeView != "performance" && modeView != "diagnostic")
            || (routeView != "hardware" && routeView != "software")
            || !output.has_value()
            || !start.has_value()
            || hasCaptureOrMissingQuit
            || (this.m_mode.arm != CsgShadowArm::Reference && this.m_mode.arm != CsgShadowArm::Cut)
            || this.m_mode.pointLight
            || this.m_mode.finiteLightSource
            || this.m_mode.analyticAtlas
            || this.m_mode.openAtlas
            || ReadSmokeEnvironmentFlag("NWB_CSG_CAUSTIC_DISABLED")
        ){
            error("CsgCausticTiming: requires uncaptured directional hard-light reference/cut boxes and an explicit route");
            return false;
        }

        const b8 hardware = rayTracing && rayQuery;
        if(routeView == "hardware" && !hardware){
            u32 rtVal = 0u;
            if(rayTracing)
                rtVal = 1u;
            u32 rqVal = 0u;
            if(rayQuery)
                rqVal = 1u;
            [essential] info("CsgCausticTiming: hardware unavailable rt_accel={} ray_query={}", rtVal, rqVal);
            this.m_context.requestQuit();
            return true;
        }
        if((routeView == "hardware") != hardware){
            error("CsgCausticTiming: actual route differs from requested acquisition");
            return false;
        }

        usize expectedReceivers = 0u;
        if(this.m_mode.arm == CsgShadowArm::Cut)
            expectedReceivers = 1u;
        if(receivers != expectedReceivers || cutters != receivers){
            error("CsgCausticTiming: fixture receiver/cutter identity differs from selected arm");
            return false;
        }

        StringView armLabel = "reference";
        if(this.m_mode.arm == CsgShadowArm::Cut)
            armLabel = "cut";
        u32 expectedShaderCsg = 0u;
        if(receivers != 0u)
            expectedShaderCsg = 1u;
        [essential] info(
            "CsgCausticTiming: scene arm={} receivers={} cutters={} expected_shader_csg={} camera=960x720 light=directional capture=0"
            , armLabel
            , receivers
            , cutters
            , expectedShaderCsg
        );

        const StringView outputView = StringView(output.value());
        StringView cpuOutputView = "";
        if(cpuOutput.has_value())
            cpuOutputView = StringView(cpuOutput.value());
        const StringView startView = StringView(start.value());
        const b8 diagnostic = modeView == "diagnostic";
        const b8 hasCsg = receivers != 0u;

        b8 initialized = false;
        native(
            in diagnostic,
            in hasCsg,
            in hardware,
            in outputView,
            in cpuOutputView,
            in startView,
            mut ctx = this.m_context,
            mut timing = this.m_timing,
            mut initialized
        ){
            timing = MakeUnique<CsgCausticTimingProbe>(ctx);
            if(timing && timing->initialize(diagnostic, hasCsg, hardware, outputView, cpuOutputView, startView)){
                timing->registerPass();
                initialized = true;
            }
        }
        return initialized;
    }

    private void destroyWorld(){
        native(mut timing = this.m_timing, mut capture = this.m_capture){
            if(timing){
                timing->unregisterPass();
                timing.reset();
            }
            if(capture){
                capture->stop();
                capture.reset();
            }
        }
        DestroySmokeRenderWorld(this.m_context, this.m_world);
    }

    private mut ProjectRuntimeContext m_context;
    private NotNullUniquePtr<World> m_world;
    private CsgShadowMode m_mode = CsgShadowMode();
    private CsgShadowAtlas m_atlas = CsgShadowAtlas();
    private UniquePtr<FramebufferCapture> m_capture = UniquePtr<FramebufferCapture>();
    private UniquePtr<CsgCausticTimingProbe> m_timing = UniquePtr<CsgCausticTimingProbe>();
    private u32 m_update = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB::ProjectFrameClientSize NWB::QueryProjectFrameClientSize(){
    return { 960, 720 };
}

TStringView NWB::QueryProjectWindowTitle()noexcept{
    return NWB_TEXT("NWB CSG Shadow Smoke");
}

UniquePtr<NWB::IProjectEntryCallbacks> NWB::CreateProjectEntryCallbacks(NWB::ProjectRuntimeContext& context){
    return MakeUnique<NWB::Tests::Smoke::CsgShadowSmokeProjectImpl>(context);
}


