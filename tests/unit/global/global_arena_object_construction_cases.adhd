[cpp_unwind]
void VerifyArenaObjectConstruction_NestedFactorySuccessIsDestroyedWhenOuterConstructionThrows(){
    HeapStorageHandle storage(s_GlobalArenaCaseArenaObjectNestedConstructorFailure);
    ConstructionState state;
    b8 outerDestroyed = false;
    const ArenaMemoryStats before = storage.memoryStats();
    ExpectConstructionFailure(GlobalObject<NestedKind>(storage, storage, state, outerDestroyed));
    const ArenaMemoryStats after = storage.memoryStats();
    EXPECT_EQ(state.constructors, 1u);
    EXPECT_EQ(state.completed, 1u);
    EXPECT_EQ(state.destructors, 1u);
    EXPECT_EQ(state.memberDestructors, 1u);
    EXPECT_EQ(state.liveMembers, 0u);
    EXPECT_EQ(after.usedBytes, before.usedBytes);
    EXPECT_EQ(after.allocationCount - before.allocationCount, after.deallocationCount - before.deallocationCount);
    EXPECT_FALSE(outerDestroyed);
}

void VerifyArenaObjectConstruction_FailedRawAllocationsNeverRunConstructorsOrDestructors(){
    HeapStorageHandle memberStorage(s_GlobalArenaCaseArenaObjectRejectedConstruction);
    RejectingStorage rejecting;
    ConstructionState state;
    ActiveProbe<HeapStorageHandle> active(memberStorage, state);
    EXPECT_FALSE(RejectedRaw(rejecting, memberStorage, state));
    EXPECT_FALSE(ProbePresent(RejectedScalar(rejecting, memberStorage, state)));
    EXPECT_FALSE(ProbePresent(RejectedArray(rejecting, memberStorage, 4u)));
    EXPECT_EQ(rejecting.attempts, 3u);
    EXPECT_EQ(rejecting.deallocations, 0u);
    EXPECT_EQ(state.constructors, 0u);
    EXPECT_EQ(state.destructors, 0u);
    EXPECT_EQ(state.memberDestructors, 0u);
}

void VerifyArenaObjectConstruction_ArenaFactoriesRetainStorageIdentityAndBypassClassAllocationHooks(){
    HeapStorageHandle global(s_GlobalArenaCaseArenaObjectCanonicalGlobalPlacement);
    PersistentStorage persistent(s_GlobalArenaCaseArenaObjectCanonicalPersistentPlacement, PoolAllocationSize(4096u));
    const ArenaMemoryStats globalBefore = global.memoryStats();
    const ArenaMemoryStats persistentBefore = persistent.memoryStats();
    mut usize placements = PlacementCalls();
    mut usize constructors = ProbeConstructors();
    mut usize destructors = ProbeDestructors();
    placements = 0u;
    constructors = 0u;
    destructors = 0u;
    {
        auto globalObject = GlobalObject<PlacementKind>(global);
        auto persistentObject = PersistentObject<PlacementKind>(persistent);
        auto globalArray = GlobalObject<PlacementArrayKind>(global, 3u);
        auto persistentArray = PersistentObject<PlacementArrayKind>(persistent, 3u);
        EXPECT_TRUE(ProbePresent(globalObject));
        EXPECT_TRUE(ProbePresent(persistentObject));
        EXPECT_TRUE(ProbePresent(globalArray));
        EXPECT_TRUE(ProbePresent(persistentArray));
        auto globalRaw = RawObject<PlacementKind>(global);
        auto persistentRaw = RawObject<PlacementKind>(persistent);
        EXPECT_TRUE(ProbePresent(globalRaw));
        EXPECT_TRUE(ProbePresent(persistentRaw));
        DeleteRawObject(global, globalRaw);
        DeleteRawObject(persistent, persistentRaw);
    }
    EXPECT_EQ(placements, 0u);
    EXPECT_EQ(constructors, 10u);
    EXPECT_EQ(destructors, 10u);
    ExpectBalancedStorage(globalBefore, global.memoryStats());
    ExpectBalancedStorage(persistentBefore, persistent.memoryStats());
}

[cpp_unwind]
void VerifyArenaObjectConstruction_ArgumentTemporaryFailureDestroysCompletedMembersBeforeReleasingArenaStorage(){
    HeapStorageHandle global(s_GlobalArenaCaseArenaObjectGlobalArgumentCleanupFailure);
    PersistentStorage persistent(s_GlobalArenaCaseArenaObjectPersistentArgumentCleanupFailure, PoolAllocationSize(4096u));
    const ArenaMemoryStats globalBefore = global.memoryStats();
    const ArenaMemoryStats persistentBefore = persistent.memoryStats();
    ConstructionState globalState;
    ConstructionState persistentState;
    const auto globalArgument = ConvertingArgument(global, globalState);
    const auto persistentArgument = ConvertingArgument(persistent, persistentState);
    ExpectConstructionFailure(GlobalObject<ArgumentKind>(global, globalArgument));
    ExpectConstructionFailure(PersistentObject<ArgumentKind>(persistent, persistentArgument));
    EXPECT_EQ(globalState.liveMembers, 0u);
    EXPECT_EQ(globalState.memberDestructors, 1u);
    EXPECT_EQ(persistentState.liveMembers, 0u);
    EXPECT_EQ(persistentState.memberDestructors, 1u);
    ExpectBalancedStorage(globalBefore, global.memoryStats());
    ExpectBalancedStorage(persistentBefore, persistent.memoryStats());
}

[cpp_unwind]
void VerifyArenaObjectConstruction_CanonicalPrivateDestructorsRetainOwningRollbackAndRawConstructionAccess(){
    HeapStorageHandle global(s_GlobalArenaCaseArenaObjectPrivateGlobalDestructor);
    PersistentStorage persistent(s_GlobalArenaCaseArenaObjectPrivatePersistentDestructor, PoolAllocationSize(4096u));
    const ArenaMemoryStats globalBefore = global.memoryStats();
    const ArenaMemoryStats persistentBefore = persistent.memoryStats();
    ConstructionState globalState;
    ConstructionState persistentState;
    const auto globalArgument = ConvertingArgument(global, globalState);
    const auto persistentArgument = ConvertingArgument(persistent, persistentState);
    ExpectConstructionFailure(GlobalObject<PrivateDtorKind>(global, globalArgument));
    ExpectConstructionFailure(PersistentObject<PrivateDtorKind>(persistent, persistentArgument));
    EXPECT_EQ(globalState.liveMembers, 0u);
    EXPECT_EQ(globalState.memberDestructors, 1u);
    EXPECT_EQ(persistentState.liveMembers, 0u);
    EXPECT_EQ(persistentState.memberDestructors, 1u);
    b8 globalDestroyed = false;
    b8 persistentDestroyed = false;
    b8 rawDestroyed = false;
    {
        auto globalObject = GlobalObject<PrivateDtorKind>(global, global, globalState, globalDestroyed);
        auto persistentObject = PersistentObject<PrivateDtorKind>(persistent, persistent, persistentState, persistentDestroyed);
        EXPECT_TRUE(ProbePresent(globalObject));
        EXPECT_TRUE(ProbePresent(persistentObject));
    }
    auto raw = RawObject<RawPrivateKind>(global, rawDestroyed);
    ASSERT_TRUE(ProbePresent(raw));
    DeleteRawObject(global, raw);
    EXPECT_TRUE(globalDestroyed);
    EXPECT_TRUE(persistentDestroyed);
    EXPECT_TRUE(rawDestroyed);
    ExpectBalancedStorage(globalBefore, global.memoryStats());
    ExpectBalancedStorage(persistentBefore, persistent.memoryStats());
}

[cpp_unwind]
void VerifyArenaObjectConstruction_IndividualDeleterFriendRetainsCompletedRollbackAndNormalOwningDestruction(){
    HeapStorageHandle global(s_GlobalArenaCaseArenaObjectOperatorFriendGlobalDestructor);
    PersistentStorage persistent(s_GlobalArenaCaseArenaObjectOperatorFriendPersistentDestructor, PoolAllocationSize(4096u));
    const ArenaMemoryStats globalBefore = global.memoryStats();
    const ArenaMemoryStats persistentBefore = persistent.memoryStats();
    ConstructionState globalState;
    ConstructionState persistentState;
    const auto globalArgument = ConvertingArgument(global, globalState);
    const auto persistentArgument = ConvertingArgument(persistent, persistentState);
    ExpectConstructionFailure(GlobalObject<OperatorDtorKind>(global, globalArgument));
    ExpectConstructionFailure(PersistentObject<OperatorDtorKind>(persistent, persistentArgument));
    EXPECT_EQ(globalState.liveMembers, 0u);
    EXPECT_EQ(globalState.memberDestructors, 1u);
    EXPECT_EQ(persistentState.liveMembers, 0u);
    EXPECT_EQ(persistentState.memberDestructors, 1u);
    {
        auto globalObject = GlobalObject<OperatorDtorKind>(global, global, globalState);
        auto persistentObject = PersistentObject<OperatorDtorKind>(persistent, persistent, persistentState);
        EXPECT_TRUE(ProbePresent(globalObject));
        EXPECT_TRUE(ProbePresent(persistentObject));
    }
    EXPECT_EQ(globalState.liveMembers, 0u);
    EXPECT_EQ(globalState.memberDestructors, 2u);
    EXPECT_EQ(persistentState.liveMembers, 0u);
    EXPECT_EQ(persistentState.memberDestructors, 2u);
    b8 globalAlive = false;
    b8 persistentAlive = false;
    {
        auto globalPrivate = GlobalObject<PrivateCtorKind>(global, globalAlive);
        auto persistentPrivate = PersistentObject<PrivateCtorKind>(persistent, persistentAlive);
        EXPECT_TRUE(ProbePresent(globalPrivate));
        EXPECT_TRUE(ProbePresent(persistentPrivate));
        EXPECT_TRUE(globalAlive);
        EXPECT_TRUE(persistentAlive);
    }
    EXPECT_FALSE(globalAlive);
    EXPECT_FALSE(persistentAlive);
    ExpectBalancedStorage(globalBefore, global.memoryStats());
    ExpectBalancedStorage(persistentBefore, persistent.memoryStats());
}

void VerifyArenaObjectConstruction_PolymorphicTransfersRetainCompleteAllocationAcrossVirtualBases(){
    HeapStorageHandle global(s_GlobalArenaCaseArenaObjectPolymorphicGlobal);
    PersistentStorage persistent(s_GlobalArenaCaseArenaObjectPolymorphicPersistent, PoolAllocationSize(4096u));
    ScratchStorage scratch(s_GlobalArenaCaseArenaObjectPolymorphicScratch);
    VerifyPolymorphicAllocationIdentity<HeapStorageHandle>(global);
    VerifyPolymorphicAllocationIdentity<PersistentStorage>(persistent);
    VerifyPolymorphicAllocationIdentity<ScratchStorage>(scratch);
    EXPECT_EQ(global.memoryStats().usedBytes, 0u);
    EXPECT_EQ(persistent.memoryStats().usedBytes, 0u);
    EXPECT_EQ(scratch.memoryStats().usedBytes, 0u);
}

void VerifyArenaObjectConstruction_StatefulCleanupSurvivesPreallocatedOwnerReentry(){
    HeapStorageHandle oldGlobal(s_GlobalArenaCaseArenaObjectReentryOldGlobal);
    HeapStorageHandle newGlobal(s_GlobalArenaCaseArenaObjectReentryNewGlobal);
    PersistentStorage oldPersistent(s_GlobalArenaCaseArenaObjectReentryOldPersistent, PoolAllocationSize(4096u));
    PersistentStorage newPersistent(s_GlobalArenaCaseArenaObjectReentryNewPersistent, PoolAllocationSize(4096u));
    ScratchStorage oldScratch(s_GlobalArenaCaseArenaObjectReentryOldScratch);
    ScratchStorage newScratch(s_GlobalArenaCaseArenaObjectReentryNewScratch);
    VerifyScalarOwnerReentry<HeapStorageHandle>(oldGlobal, newGlobal);
    VerifyArrayOwnerReentry<HeapStorageHandle, 0u>(oldGlobal, newGlobal);
    VerifyArrayOwnerReentry<HeapStorageHandle, 1u>(oldGlobal, newGlobal);
    VerifyScalarOwnerReentry<PersistentStorage>(oldPersistent, newPersistent);
    VerifyArrayOwnerReentry<PersistentStorage, 0u>(oldPersistent, newPersistent);
    VerifyArrayOwnerReentry<PersistentStorage, 1u>(oldPersistent, newPersistent);
    VerifyScalarOwnerReentry<ScratchStorage>(oldScratch, newScratch);
    VerifyArrayOwnerReentry<ScratchStorage, 0u>(oldScratch, newScratch);
    VerifyArrayOwnerReentry<ScratchStorage, 1u>(oldScratch, newScratch);
    EXPECT_EQ(oldGlobal.memoryStats().usedBytes, 0u);
    EXPECT_EQ(newGlobal.memoryStats().usedBytes, 0u);
    EXPECT_EQ(oldPersistent.memoryStats().usedBytes, 0u);
    EXPECT_EQ(newPersistent.memoryStats().usedBytes, 0u);
    EXPECT_EQ(oldScratch.memoryStats().usedBytes, 0u);
    EXPECT_EQ(newScratch.memoryStats().usedBytes, 0u);
}


