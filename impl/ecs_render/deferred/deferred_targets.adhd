[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/global.adhd.h>
#include <impl/ecs_render/deferred/deferred_bindless_slots_builder.adhd.h>
#include <impl/ecs_render/deferred/deferred_frame_targets.adhd.h>
#include <impl/ecs_render/deferred/deferred_internal.adhd.h>
#include <impl/ecs_render/deferred/deferred_system.adhd.h>
#include <impl/ecs_render/deferred/format_private.adhd.h>
#include <impl/ecs_render/deferred/presentation_settings.adhd.h>
#include <impl/ecs_render/deferred/renderer_deferred_state.adhd.h>
#include <impl/ecs_render/csg/format_private.adhd.h>
#include <impl/ecs_render/kernel/descriptor_register_utils.adhd.h>
#include <impl/ecs_render/kernel/renderer_constants_private.adhd.h>
#include <impl/ecs_render/kernel/renderer_format_private.adhd.h>
#include <impl/ecs_render/shared/frame_types.adhd.h>
#include <impl/assets/graphics/csg/constants.h>
#include <impl/assets/graphics/mesh/runtime_constants.h>
#include <impl/assets/graphics/scene/binding_slots.h>

#include <core/common/log.h>
#include <core/graphics/api.h>
#include <core/graphics/backend_selection.h>
#include <core/graphics/rhi/gpu_descriptor_heap.h>
#include <core/graphics/runtime/runtime.h>

#include <global/atomic_identity.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(s_CsgCapNormalCoreFormat == NWB_CSG_CAP_NORMAL_CORE_FORMAT);
static_assert(s_CsgIntervalDepthCoreFormat == NWB_CSG_INTERVAL_DEPTH_CORE_FORMAT);
static_assert(s_CsgIntervalIdCoreFormat == NWB_CSG_INTERVAL_ID_CORE_FORMAT);
static_assert(s_CsgReceiverEventDataCoreFormat == NWB_CSG_RECEIVER_EVENT_DATA_CORE_FORMAT);
static_assert(s_CsgReceiverEventCountCoreFormat == NWB_CSG_RECEIVER_EVENT_COUNT_CORE_FORMAT);
static_assert(s_CsgReceiverSpanDataCoreFormat == NWB_CSG_RECEIVER_SPAN_DATA_CORE_FORMAT);
static_assert(s_CsgReceiverSpanCountCoreFormat == NWB_CSG_RECEIVER_SPAN_COUNT_CORE_FORMAT);
static_assert(s_CsgRemovedIntervalDepthCoreFormat == NWB_CSG_REMOVED_INTERVAL_DEPTH_CORE_FORMAT);
static_assert(s_CsgRemovedIntervalCapNormalCoreFormat == NWB_CSG_REMOVED_INTERVAL_CAP_NORMAL_CORE_FORMAT);
static_assert(s_CsgRemovedIntervalDataCoreFormat == NWB_CSG_REMOVED_INTERVAL_DATA_CORE_FORMAT);
static_assert(s_CsgRemovedIntervalCountCoreFormat == NWB_CSG_REMOVED_INTERVAL_COUNT_CORE_FORMAT);
static_assert(s_MeshGbufferBaseColorLocation == NWB_MESH_GBUFFER_BASE_COLOR_LOCATION);
static_assert(s_MeshGbufferNormalLocation == NWB_MESH_GBUFFER_NORMAL_LOCATION);
static_assert(s_MeshGbufferWorldPositionLocation == NWB_MESH_GBUFFER_WORLD_POSITION_LOCATION);
static_assert(s_MeshGbufferSpecularRoughnessLocation == NWB_MESH_GBUFFER_SPECULAR_ROUGHNESS_LOCATION);
static_assert(s_MeshGbufferTargetCount == NWB_MESH_GBUFFER_TARGET_COUNT);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 DeferredFrameTargets::valid()const noexcept{
#if defined(NWB_DEBUG)
    return
        ValidDeferredTargetExtent(width, height)
        && albedoFormat != Core::Format::UNKNOWN
        && normalFormat != Core::Format::UNKNOWN
        && worldPositionFormat != Core::Format::UNKNOWN
        && specularRoughnessFormat != Core::Format::UNKNOWN
        && opaqueColorFormat != Core::Format::UNKNOWN
        && compositeColorFormat != Core::Format::UNKNOWN
        && depthFormat != Core::Format::UNKNOWN
        && csgIntervalTargetsValid()
        && albedo != nullptr
        && normal != nullptr
        && worldPosition != nullptr
        && specularRoughness != nullptr
        && opaqueColor != nullptr
        && compositeColor != nullptr
        && depth != nullptr
        && framebuffer != nullptr
        && bindless.valid()
        && avboit.valid()
    ;
#else
    return framebuffer != nullptr;
#endif
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RendererDeferredSystem::createLaggedLightingHistoryResources(DeferredFrameTargets& targets)noexcept{
    DeferredLaggedLightingHistoryResources& history = targets.laggedLightingHistory;
    if(history.valid())
        return true;

    FOUNDATION_ASSERT(targets.bindless.valid());
    FOUNDATION_ASSERT(targets.shadowVisibility);
    FOUNDATION_ASSERT(targets.causticIrradiance);
    FOUNDATION_ASSERT(targets.surfelIrradiance);

    resetLaggedLightingHistoryResources(targets);

    auto& device = m_graphics->getDevice();
    Core::GpuDescriptorHeap& heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        LogLaggedLightingHistoryHeapMissing();
        return false;
    }

    Core::TextureDesc shadowHistoryDesc;
    shadowHistoryDesc
        .setWidth(targets.width)
        .setHeight(targets.height)
        .setArraySize(NWB_SCENE_SHADOW_SLOT_COUNT)
        .setDimension(Core::TextureDimension::Texture2DArray)
        .setFormat(targets.shadowVisibilityFormat)
        .setInitialState(Core::ResourceStates::Common)
        .setKeepInitialState(true)
        .setQueueSharing(Core::ResourceQueueSharing::GraphicsAsyncComputeAndTransfer)
        .setName("engine/temporal/lagged_shadow_visibility")
    ;
    auto shadowVisibilityResult = m_graphics->createTexture(shadowHistoryDesc);
    if(shadowVisibilityResult)
        history.shadowVisibility = Move(*shadowVisibilityResult);
    else
        history.shadowVisibility.reset();
    if(!shadowVisibilityResult){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: failed to create lagged shadow-visibility history"));
        resetLaggedLightingHistoryResources(targets);
        return false;
    }

    Core::TextureDesc irradianceHistoryDesc;
    irradianceHistoryDesc
        .setWidth(targets.width)
        .setHeight(targets.height)
        .setFormat(targets.causticIrradianceFormat)
        .setInitialState(Core::ResourceStates::Common)
        .setKeepInitialState(true)
        .setQueueSharing(Core::ResourceQueueSharing::GraphicsAsyncComputeAndTransfer)
        .setName("engine/temporal/lagged_caustic_irradiance")
    ;
    auto causticIrradianceResult = m_graphics->createTexture(irradianceHistoryDesc);
    if(causticIrradianceResult)
        history.causticIrradiance = Move(*causticIrradianceResult);
    else
        history.causticIrradiance.reset();
    if(!causticIrradianceResult){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: failed to create lagged caustic-irradiance history"));
        resetLaggedLightingHistoryResources(targets);
        return false;
    }

    irradianceHistoryDesc.setFormat(targets.surfelIrradianceFormat).setName("engine/temporal/lagged_surfel_irradiance");
    auto surfelIrradianceResult = m_graphics->createTexture(irradianceHistoryDesc);
    if(surfelIrradianceResult)
        history.surfelIrradiance = Move(*surfelIrradianceResult);
    else
        history.surfelIrradiance.reset();
    if(!surfelIrradianceResult){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: failed to create lagged surfel-irradiance history"));
        resetLaggedLightingHistoryResources(targets);
        return false;
    }

    if(
        !AssignSampledTexture(
            heap,
            Core::GpuDescriptorClass::SampledImage2DArray,
            history.shadowVisibility,
            targets.shadowVisibilityFormat,
            s_ShadowVisibilitySubresources,
            Core::TextureDimension::Texture2DArray,
            history.shadowVisibilityDescriptor
        )
        || !AssignSampledTexture(
            heap,
            Core::GpuDescriptorClass::SampledImage,
            history.causticIrradiance,
            targets.causticIrradianceFormat,
            s_FramebufferSubresources,
            Core::TextureDimension::Texture2D,
            history.causticIrradianceDescriptor
        )
        || !AssignSampledTexture(
            heap,
            Core::GpuDescriptorClass::SampledImage,
            history.surfelIrradiance,
            targets.surfelIrradianceFormat,
            s_FramebufferSubresources,
            Core::TextureDimension::Texture2D,
            history.surfelIrradianceDescriptor
        )
    ){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: failed to register lagged lighting-history images in the descriptor heap"));
        resetLaggedLightingHistoryResources(targets);
        return false;
    }

    history.slots = DeferredBindlessSlotsBuilder{}.buildHistory(
        targets.bindless.slots,
        history.shadowVisibilityDescriptor.slot(),
        history.causticIrradianceDescriptor.slot(),
        history.surfelIrradianceDescriptor.slot()
    );

    Core::BufferDesc slotsBufferDesc;
    slotsBufferDesc
        .setByteSize(sizeof(DeferredBindlessResourceSlots))
        .setIsConstantBuffer(true)
        .setDebugName("ECSRender_DeferredLaggedLightingResourceSlots")
        .setQueueSharing(Core::ResourceQueueSharing::GraphicsAndAsyncCompute)
        .enableAutomaticStateTracking(Core::ResourceStates::Common)
    ;
    auto slotsBufferResult = m_graphics->createBuffer(slotsBufferDesc);
    if(slotsBufferResult)
        history.slotsBuffer = Move(*slotsBufferResult);
    else
        history.slotsBuffer.reset();
    if(!slotsBufferResult){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: failed to create lagged lighting-history slot buffer"));
        resetLaggedLightingHistoryResources(targets);
        return false;
    }

    const Expected<Core::GpuDescriptorHandle> slotsBufferDescriptor = RegisterConstantBuffer(heap, history.slotsBuffer);
    history.slotsBufferDescriptor = slotsBufferDescriptor ? *slotsBufferDescriptor : Core::GpuDescriptorHandle::Invalid();
    if(!slotsBufferDescriptor){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("RendererSystem: failed to register lagged lighting-history slot buffer in the descriptor heap"));
        resetLaggedLightingHistoryResources(targets);
        return false;
    }

    static u64 s_NextLaggedLightingHistoryGeneration = 0u;
    AdvanceWrappingNonzero(s_NextLaggedLightingHistoryGeneration);
    history.generation = s_NextLaggedLightingHistoryGeneration;
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

