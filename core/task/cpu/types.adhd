[cpp_header("<core/task/cpu/types.h>"), cpp_name("::NWB::Core::CpuTaskHandle")]
extern class CpuTaskHandle{
    u64 domainIdentity;
    u32 index;
    u32 generation;
    b8 valid(...)const;
};

[cpp_header("<core/task/cpu/types.h>"), cpp_name("::NWB::Core::CpuTaskOptions")]
extern class CpuTaskOptions{
    CpuTaskProfileLabel profileLabel;
    CpuTaskCost cost;
    CpuTaskPriority priority;
    CpuTaskTarget target;
};

[cpp_header("<core/task/cpu/types.h>"), cpp_name("::NWB::Core::CpuTaskProfileLabel")]
extern class CpuTaskProfileLabel{
    u64 value;
    b8 valid(...)const;
};

[cpp_header("<core/task/cpu/types.h>"), cpp_name("::NWB::Core::CpuTaskSchedulerConfig")]
extern class CpuTaskSchedulerConfig{
    usize profileEventCapacity;
    u32 workerCount;
    u32 reservedThreadCount;
    b8 heterogeneous;
};

[cpp_header("<core/task/cpu/types.h>"), cpp_name("::NWB::Core::CpuTaskSchedulerStatistics")]
extern class CpuTaskSchedulerStatistics{
    u64 completedTasks;
    u64 canceledTasks;
    u64 performanceTasks;
    u64 efficiencyTasks;
    u64 unclassifiedTasks;
    u64 cooperativeTasks;
    usize outstandingTasks;
    usize peakOutstandingTasks;
    u32 performanceWorkers;
    u32 efficiencyWorkers;
    u32 unclassifiedWorkers;
    u32 placementFailures;
    u64 profileRecordedEvents;
    u64 profileDroppedEvents;
    usize profilePendingEvents;
    b8 profileEnabled;
};


