////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class GuardedBytes : NoCopy{
    public ByteAddress mapping = ByteAddress();
    public ByteAddress data = ByteAddress();
    public ByteAddress lowerGuard = ByteAddress();
    public ByteAddress upperGuard = ByteAddress();
    public usize pageBytes = 0u;
    public usize accessibleBytes = 0u;
    public usize mappingBytes = 0u;

    public GuardedBytes(){
        this.prepare();
    }

    public ~GuardedBytes(){
        if(HasByteAddress(this.mapping) && !ReleaseVirtualPages(this.mapping, this.mappingBytes))
            TerminateInvariant();
    }

    private void prepare(){
        this.pageBytes = VirtualPageSize();
        if(this.pageBytes == 0u || this.pageBytes % s_SIMDMemoryCopyAlignment != 0u || this.pageBytes > usize.max / 6u)
            return;
        this.accessibleBytes = this.pageBytes * 4u;
        this.mappingBytes = this.pageBytes * 6u;
        this.mapping = ReserveVirtualPages(this.mappingBytes);
        if(!HasByteAddress(this.mapping))
            return;
        auto first = GuardAddress(this.mapping, this.pageBytes);
        if(!MakeVirtualPagesWritable(first, this.accessibleBytes))
            return;
        this.data = BeginByteLifetimes(first, this.accessibleBytes);
        this.lowerGuard = this.mapping;
        this.upperGuard = GuardAddress(this.data, this.accessibleBytes);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ExitOnAbort(in i32 signalNumber){
    ExitImmediately(s_SIMDMemoryAbortExitCode);
}


