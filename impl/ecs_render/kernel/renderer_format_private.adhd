Format SelectSupportedFormat(in Span<Format> candidates, in FormatSupport requiredSupport, mut Device device){
    for(in Format format : candidates){
        if((device.queryFormatSupport(format) & requiredSupport) == requiredSupport)
            return format;
    }
    return Format::UNKNOWN;
}

b8 CreateClampSampler(in b8 linearFiltering, mut Device device, mut SamplerHandle sampler){
    if(sampler.valid())
        return true;

    SamplerDesc samplerDesc;
    samplerDesc.setAllFilters(linearFiltering).setAllAddressModes(SamplerAddressMode::Clamp);
    Expected<SamplerHandle> samplerResult = device.createSampler(samplerDesc);
    if(samplerResult.has_value()){
        sampler = samplerResult.value();
        return true;
    }
    sampler.reset();
    return false;
}


