////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_font/cook_entry.adhd>
#include <impl/assets_font/font_binary_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const b8 s_FontCookIncludePreparedPixels = false;

b8 IsValidFontCookVirtualPath(in Name virtualPath){
    return virtualPath != s_NameNone;
}

Expected<Path> ResolveFontCookSourcePath(in Name virtualPath, in Path nwbFilePath, in MetascriptValue asset){
    if(!IsValidFontCookVirtualPath(virtualPath))
        return MakeUnexpected(Failure());
    if(!asset.isNull()){
        if(!CheckMetadataAssetMap(nwbFilePath, asset, s_FontMetaDiagnosticPrefix) || !ValidateMetadataAssetFields(nwbFilePath, asset, s_FontMetaDiagnosticPrefix))
            return MakeUnexpected(Failure());
    }

    Path fontPath = nwbFilePath;
    fontPath.replaceExtension(s_PreparedFontExtension);
    return fontPath;
}

Expected<FontCookEntry> BuildFontCookEntry(in Name virtualPath, in PreparedFontSource source){
    if(!ValidateFontSource(source.fontBytes, source.faceIndex))
        return MakeUnexpected(Failure());

    FontCookEntry entry;
    entry.fontBytes = source.fontBytes;
    entry.virtualPath = virtualPath;
    entry.faceIndex = source.faceIndex;
    return entry;
}

Expected<FontCookEntry> ParseFontCookMetadataValue(in Name virtualPath, in Path path, in MetascriptValue asset){
    const Expected<Path> fontPath = ResolveFontCookSourcePath(virtualPath, path, asset);
    if(!fontPath.has_value())
        return MakeUnexpected(Failure());
    const Expected<PreparedFontSource, StringView> source = ReadPreparedFontSource(fontPath.value(), s_FontCookIncludePreparedPixels);
    if(!source.has_value())
        return MakeUnexpected(Failure());
    return BuildFontCookEntry(virtualPath, source.value());
}

b8 SerializeFontAssetPayload(in Font font, mut Vector<u8> outBinary){
    if(!font.validatePayload())
        return false;
    FontBinaryCodec().serialize(font.faceIndex(), font.fontBytes(), outBinary);
    return true;
}

Expected<Font> BuildFontAssetFromPayload(in Name virtualPath, in Vector<u8> fontBytes, in u32 faceIndex){
    Font candidate(virtualPath);
    candidate.setFontBytes(fontBytes, faceIndex);
    if(!candidate.validatePayload())
        return MakeUnexpected(Failure());
    return candidate;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<FontCookEntry> ParseFontCookMetadata(in Path root, in StringView virtualRoot, in Path file, in MetascriptDocument document){
    return ParseCookMetadataDocument<FontCookEntry>(root, virtualRoot, file, document, s_FontMetaDiagnosticPrefix, lambda[in file](in Name path, in MetascriptValue value) -> Expected<FontCookEntry>{
        return ParseFontCookMetadataValue(path, file, value);
    });
}

Expected<Font> BuildFontAsset(in FontCookEntry entry){
    return BuildFontAssetFromPayload(entry.virtualPath, entry.fontBytes, entry.faceIndex);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

