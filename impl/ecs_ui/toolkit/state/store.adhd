////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/state/widget_state_index_policy.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class WidgetStateStore : NoCopy{
    private Vector<WidgetState> m_entries;
    private HashMap<u64, usize> m_index;
    private b8 m_indexDirty = false;
    private b8 m_lastTouchKindChanged = false;
    private u64 m_nextDeclarationGeneration = 1u;

    [cpp_unwind]
    public WidgetStateStore(){
        this.m_entries.reserve(s_WidgetStateRetainedCapacity);
        this.m_index.reserve(s_WidgetStateRetainedCapacity);
    }
    [cpp_unwind]
    public Expected<mut WidgetState> touch(in WidgetId id, in WidgetRoot root, in WidgetKind kind, in u64 frameGeneration){
        b8 invariantFailed = false;
        this.m_lastTouchKindChanged = false;
        const Expected<usize> index = WidgetStateIndexPolicy().touch(
            id, root, kind, frameGeneration, this.m_entries, this.m_index, this.m_nextDeclarationGeneration, this.m_indexDirty, invariantFailed, this.m_lastTouchKindChanged
        );
        if(invariantFailed)
            TerminateInvariant();
        if(!index.has_value())
            return MakeUnexpected(Failure());
        return Expected<mut WidgetState>(this.m_entries[index.value()]);
    }
    public b8 lastTouchKindChanged()const{ return this.m_lastTouchKindChanged; }
    [cpp_unwind]
    public Optional<mut WidgetState> find(in WidgetId id){
        this.finishRetirement();
        const Expected<usize> index = WidgetStateIndexPolicy().lookup(this.m_entries, id, this.m_index);
        if(!index.has_value())
            return Optional<mut WidgetState>();
        return Optional<mut WidgetState>(this.m_entries[index.value()]);
    }
    public Optional<in WidgetState> find(in WidgetId id)const{
        if(this.m_indexDirty){
            for(usize i = 0u; i < this.m_entries.size(); ++i){
                if(this.m_entries[i].id == id)
                    return Optional<in WidgetState>(this.m_entries[i]);
            }
            return Optional<in WidgetState>();
        }
        const Expected<usize> index = WidgetStateIndexPolicy().lookup(this.m_entries, id, this.m_index);
        if(!index.has_value())
            return Optional<in WidgetState>();
        return Optional<in WidgetState>(this.m_entries[index.value()]);
    }
    public in Vector<WidgetState> entries()const{ return this.m_entries; }
    [cpp_unwind]
    public void finishRetirement(){
        if(!WidgetStateIndexPolicy().refreshIndex(this.m_entries, this.m_index, this.m_indexDirty))
            TerminateInvariant();
    }
    public void erase(in usize index){ WidgetStateIndexPolicy().eraseAt(index, this.m_entries, this.m_indexDirty); }
    [cpp_unwind]
    public void retireUnseen(in u64 frameGeneration, mut Vector<WidgetId> outRetiredIds){
        WidgetStateIndexPolicy().compactRetireUnseen(frameGeneration, this.m_entries, this.m_indexDirty, outRetiredIds);
    }
    [cpp_unwind]
    public void retainRoots(in HashSet<WidgetRoot> retainedRoots, mut Vector<WidgetId> outRetiredIds){
        WidgetStateIndexPolicy().compactRetainRoots(retainedRoots, this.m_entries, this.m_indexDirty, outRetiredIds);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

