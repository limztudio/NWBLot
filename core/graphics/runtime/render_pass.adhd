[cpp_header("<core/graphics/runtime/render_pass.h>"), cpp_name("::NWB::Core::IRenderPass")]
extern class IRenderPass{
    void animate(...);
    void backBufferResized(...);
    void backBufferResizing(...);
    void displayScaleChanged(...);
    mut GraphicsRuntime getGraphics(...)const;
    void invalidateResources();
    b8 prepareResources(in FramebufferPtr framebuffer);
    void render(...);
    b8 shouldRenderUnfocused();
    b8 validateResources(in u32 width, in u32 height, in u32 samples);
};

