}

void VerifyUiContextMenuInputTests_PopupReplacementCannotReplayAContextActionOrItsHeldPointerPress(mut UiContextMenuInputTests self){
    const PopupScope first = MakeUiContextMenuScope(1u);
    const Array<HitTarget, 3u> targets = MakeUiContextMenuPopupTargets(first);
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u, MakeUiContextSingleScope(first)));
    const Point inside = MakeUiContextPoint(55.0f, 55.0f);
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown, inside)).pointerConsumed);
    const PopupScope replacement = MakeUiContextMenuScope(2u);
    const Array<HitTarget, 3u> replacementTargets = MakeUiContextMenuPopupTargets(replacement);
    ASSERT_TRUE(self.m_router.commitTargets(replacementTargets, 2u, MakeUiContextSingleScope(replacement)));
    ASSERT_TRUE(self.m_router.commitTargets(targets, 3u, MakeUiContextSingleScope(first)));
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown, inside)).pointerConsumed);
    EXPECT_FALSE(self.take(101u).has_value());
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryUp, inside)).pointerConsumed);
    EXPECT_FALSE(self.take(101u).has_value());
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown, inside)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryUp, inside)).pointerConsumed);
    const Expected<ContextMenuAction> actionResult = self.take(101u);
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_EQ(actionResult.value().popup, first.token);
}

void VerifyUiContextMenuInputTests_DeclarationReplacementDiscardsIntentionsButPreservesHeldReleaseConsumption(mut UiContextMenuInputTests self){
    HitTarget target = MakeUiContextMenuTarget(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 1u));
