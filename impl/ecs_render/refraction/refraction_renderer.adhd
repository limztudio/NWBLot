#include <impl/ecs_render/raytrace/graph_snapshots.adhd>
#include <impl/ecs_render/refraction/statistics_readback.adhd>
#include <impl/ecs_render/deferred/deferred_frame_targets.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RefractionRenderer : NoCopy{
    private mut RendererRayTracingSystem m_system;
    private RefractionStatisticsReadback m_statistics;
    private b8 m_diagnosticsEnabled = false;

    public RefractionRenderer(mut RendererRayTracingSystem system, mut GraphicsRuntime graphics){
        this.m_system = system;
        this.m_statistics = RefractionStatisticsReadback(graphics);
    }

    public void setRefractionDiagnosticsEnabled(in b8 enabled){ this.m_diagnosticsEnabled = enabled; }
    public void pollRefractionStatistics(){ this.m_statistics.pollCompleted(); }
    public Expected<RefractionStatistics> tryGetLatestRefractionStatistics()const{ return this.m_statistics.latestStatistics(); }
    public void invalidateResources(){ this.m_statistics.invalidateResources(); }
    public b8 prepareRefractionResources();
    public RayTracingRefractionGraphResources snapshotRefractionGraphResources(in u32 width, in u32 height, in u32 frameIndex)const;
    public b8 recordRefractionTileClassification(mut CommandList commandList, in DeferredFrameTargets targets, in RayTracingRefractionGraphResources resources)const;
    public b8 recordRefractionResolve(mut CommandList commandList, in DeferredFrameTargets targets, in RayTracingRefractionGraphResources resources)const;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanRecordRefractionPass(in b8 resourcesValid, in b8 bindlessValid, in u32 width, in u32 height){
    return resourcesValid && bindlessValid && width != 0u && height != 0u;
}

u32 ComputeRefractionTileDispatchGroups(in u32 dimension, in u32 groupSize){
    return DivideUpWrappingU32(dimension, groupSize);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

