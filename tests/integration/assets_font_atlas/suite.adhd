NWB_ADHD_GTEST(AssetsFontAtlas, MalformedBinaryDoesNotReplacePreviouslyLoadedAtlas, VerifyAssetsFontAtlas_MalformedBinaryDoesNotReplacePreviouslyLoadedAtlas)
NWB_ADHD_GTEST(AssetsFontAtlas, CompactNonPowerOfTwoGroupsRejectMissingChannelsAndLostGuards, VerifyAssetsFontAtlas_CompactNonPowerOfTwoGroupsRejectMissingChannelsAndLostGuards)
NWB_ADHD_GTEST(AssetsFontAtlas, UnsupportedVersionsAndCompactGroupHeadersAreRejected, VerifyAssetsFontAtlas_UnsupportedVersionsAndCompactGroupHeadersAreRejected)
NWB_ADHD_GTEST(AssetsFontAtlas, CodecRejectsUnnamedOrCorruptAtlasWithoutReplacingOutput, VerifyAssetsFontAtlas_CodecRejectsUnnamedOrCorruptAtlasWithoutReplacingOutput)
NWB_ADHD_GTEST(AssetsFontAtlas, InvalidHashAndGeometryAreRejectedBySerialization, VerifyAssetsFontAtlas_InvalidHashAndGeometryAreRejectedBySerialization)
NWB_ADHD_GTEST(AssetsFontAtlas, GuardedRegionsRejectSameChannelOverlapAndAllowIndependentChannels, VerifyAssetsFontAtlas_GuardedRegionsRejectSameChannelOverlapAndAllowIndependentChannels)
NWB_ADHD_GTEST(AssetsFontAtlas, GuardedOverlapReusesCallerScratchAcrossGroupsAndRejectedChannels, VerifyAssetsFontAtlas_GuardedOverlapReusesCallerScratchAcrossGroupsAndRejectedChannels)
NWB_ADHD_GTEST(AssetsFontAtlas, PaddedPlaneSizeMustMatchBitmapExtentAtTheDeclaredBakeSize, VerifyAssetsFontAtlas_PaddedPlaneSizeMustMatchBitmapExtentAtTheDeclaredBakeSize)
NWB_ADHD_GTEST(AssetsFontAtlas, RejectsIncompleteOrDuplicateGlyphPolicyAndUnsupportedLimits, VerifyAssetsFontAtlas_RejectsIncompleteOrDuplicateGlyphPolicyAndUnsupportedLimits)
