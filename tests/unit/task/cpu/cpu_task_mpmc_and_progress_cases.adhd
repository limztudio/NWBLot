void VerifyCpuTaskProgressTests_ScopeJoinWakesForANewlyReadyUnscopedMainThreadPrerequisite(){
    const u32 rounds = 16u;
    const u32 timeoutMS = 30000u;
    const u32 callbackCount = 2u;
    u32 releaseSchedules = 2u;
    DeadlineGuard deadline(false, timeoutMS);
    const TestSchedulerConfig config = HomogeneousWorkers(1u);
    CpuTaskScheduler scheduler(config);
    CpuTaskOptions mainThread = CpuTaskOptions();
    mainThread.target = CpuTaskTarget::MainThread;
    for(u32 round = 0u; round < rounds; ++round){
        Atomic<b8> release(false);
        Atomic<b8> joining(false);
        Atomic<b8> workerEntered(false);
        u32 callbacks = 0u;
        CpuTaskScope scope(scheduler);
        JoiningThread releaser = JoiningThread();
        ScopeExit finish(lambda[mut joining, mut release, mut scheduler, mut releaser]() -> void{
            joining.store(true, MemoryOrder::release);
            joining.notify_all();
            release.store(true, MemoryOrder::release);
            release.notify_all();
            scheduler.drain();
            if(releaser.joinable()){
                releaser.join();
            }
        });
        const auto cpuTaskAdmission = scheduler.submit(lambda[mut workerEntered, mut release]() -> void{
            workerEntered.store(true, MemoryOrder::release);
            workerEntered.notify_one();
            release.wait(false, MemoryOrder::acquire);
        });
        ASSERT_TRUE(cpuTaskAdmission.has_value());
        const CpuTaskHandle gate = cpuTaskAdmission.value();
        ASSERT_TRUE(gate.valid());
        workerEntered.wait(false, MemoryOrder::acquire);
        Array<CpuTaskHandle, 1> gateDeps = Array<CpuTaskHandle, 1>();
        gateDeps[0u] = gate;
        const auto prerequisiteTaskAdmission = scheduler.submit(lambda[mut callbacks]() -> void{
            ++callbacks;
        }, mainThread, gateDeps.data(), 1u);
        ASSERT_TRUE(prerequisiteTaskAdmission.has_value());
        const CpuTaskHandle prerequisite = prerequisiteTaskAdmission.value();
        ASSERT_TRUE(prerequisite.valid());
        Array<CpuTaskHandle, 1> prerequisiteDeps = Array<CpuTaskHandle, 1>();
        prerequisiteDeps[0u] = prerequisite;
        const auto secondCpuTaskAdmission = scope.submit(lambda[mut callbacks]() -> void{
            ++callbacks;
        }, mainThread, prerequisiteDeps.data(), 1u);
        ASSERT_TRUE(secondCpuTaskAdmission.has_value());
        ASSERT_TRUE(secondCpuTaskAdmission.value().valid());
        releaser = JoiningThread(lambda[mut joining, mut release, in round, in releaseSchedules]() -> void{
            joining.wait(false, MemoryOrder::acquire);
            if(round % releaseSchedules == 0u){
                SleepMS(s_PollIntervalMS);
            }
            release.store(true, MemoryOrder::release);
            release.notify_one();
        });
        // No handle waiter or completed scope can provide the prerequisite's readiness notification.
        joining.store(true, MemoryOrder::release);
        joining.notify_one();
        scope.wait();
        releaser.join();
        scheduler.wait();
        finish.release();
        EXPECT_EQ(callbacks, callbackCount);
        EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
    }
}

void VerifyCpuTaskProgressTests_ConcurrentSameScopeJoinsRetainLatePublishedDescendantsAcrossScopeReuse(){
    const u32 rounds = 16u;
    const u32 workers = 2u;
    const u32 timeoutMS = 30000u;
    const u32 rootCount = 32u;
    DeadlineGuard deadline(false, timeoutMS);
    const TestSchedulerConfig config = HomogeneousWorkers(workers);
    CpuTaskScheduler scheduler(config);
    const CpuTaskOptions defaultOptions = CpuTaskOptions();
    for(u32 round = 0u; round < rounds; ++round){
        Atomic<b8> start(false);
        Atomic<u32> entered(0u);
        Atomic<u32> visits(0u);
        Atomic<u32> joined(0u);
        CpuTaskScope scope(scheduler);
        Array<CpuTaskHandle, 32> roots = Array<CpuTaskHandle, 32>();
        ScopeExit finish(lambda[mut start, mut scheduler]() -> void{
            start.store(true, MemoryOrder::release);
            start.notify_all();
            scheduler.drain();
        });
        for(u32 waiter = 0u; waiter < workers; ++waiter){
            const auto cpuTaskAdmission = scheduler.submit(lambda[mut entered, mut start, mut scope, mut joined]() -> void{
                entered.fetch_add(1u, MemoryOrder::release);
                entered.notify_one();
                start.wait(false, MemoryOrder::acquire);
                scope.wait();
                joined.fetch_add(1u, MemoryOrder::release);
            });
            ASSERT_TRUE(cpuTaskAdmission.has_value());
            ASSERT_TRUE(cpuTaskAdmission.value().valid());
        }
        u32 count = entered.load(MemoryOrder::acquire);
        while(count != workers){
            entered.wait(count, MemoryOrder::acquire);
            count = entered.load(MemoryOrder::acquire);
        }
        for(usize index = 0u; index < roots.size(); ++index){
            const auto rootTaskAdmission = scheduler.submit(lambda[mut visits]() -> void{
                visits.fetch_add(1u, MemoryOrder::relaxed);
            });
            ASSERT_TRUE(rootTaskAdmission.has_value());
            roots[index] = rootTaskAdmission.value();
            ASSERT_TRUE(roots[index].valid());
        }
        const auto secondCpuTaskAdmission = scope.submit(lambda[mut scheduler, mut visits]() -> void{
            const auto thirdCpuTaskAdmission = scheduler.submit(lambda[mut scheduler, mut visits]() -> void{
                const auto fourthCpuTaskAdmission = scheduler.submit(lambda[mut visits]() -> void{
                    visits.fetch_add(1u, MemoryOrder::relaxed);
                });
                EXPECT_TRUE(fourthCpuTaskAdmission.has_value());
                if(fourthCpuTaskAdmission.has_value()){
                    EXPECT_TRUE(fourthCpuTaskAdmission.value().valid());
                }
            });
            EXPECT_TRUE(thirdCpuTaskAdmission.has_value());
            if(thirdCpuTaskAdmission.has_value()){
                EXPECT_TRUE(thirdCpuTaskAdmission.value().valid());
            }
        }, defaultOptions, roots.data(), cast<usize>(rootCount));
        ASSERT_TRUE(secondCpuTaskAdmission.has_value());
        ASSERT_TRUE(secondCpuTaskAdmission.value().valid());
        start.store(true, MemoryOrder::release);
        start.notify_all();
        scheduler.wait();
        EXPECT_EQ(joined.load(MemoryOrder::acquire), workers);
        EXPECT_EQ(visits.load(MemoryOrder::acquire), rootCount + 1u);
        // This scope keeps its identity after completion, while publication invalidates its old contribution proofs.
        const auto laterTaskAdmission = scheduler.submit(lambda[mut visits]() -> void{
            visits.fetch_add(1u, MemoryOrder::relaxed);
        });
        ASSERT_TRUE(laterTaskAdmission.has_value());
        const CpuTaskHandle later = laterTaskAdmission.value();
        ASSERT_TRUE(later.valid());
        const auto fifthCpuTaskAdmission = scope.submit(lambda[mut visits]() -> void{
            visits.fetch_add(1u, MemoryOrder::relaxed);
        }, later);
        ASSERT_TRUE(fifthCpuTaskAdmission.has_value());
        ASSERT_TRUE(fifthCpuTaskAdmission.value().valid());
        scope.wait();
        scheduler.wait();
        finish.release();
        EXPECT_EQ(visits.load(MemoryOrder::acquire), rootCount + 3u);
        EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_ADHD_GTEST(CpuTaskMpmcTests, OwnerExternalAndWorkerProducersShareQueuesWithoutLosingOrRepeatingTasks, VerifyCpuTaskMpmcTests_OwnerExternalAndWorkerProducersShareQueuesWithoutLosingOrRepeatingTasks)
NWB_ADHD_GTEST(CpuTaskMpmcTests, ExternalProducersCanWaitForMainThreadTasksWhileTheOwnerPumps, VerifyCpuTaskMpmcTests_ExternalProducersCanWaitForMainThreadTasksWhileTheOwnerPumps)
NWB_ADHD_GTEST(CpuTaskMpmcTests, CanceledCompletionCannotLoseConcurrentHandleScopeOrSchedulerJoins, VerifyCpuTaskMpmcTests_CanceledCompletionCannotLoseConcurrentHandleScopeOrSchedulerJoins)

NWB_ADHD_GTEST(CpuTaskProgressTests, ScopeJoinWakesForANewlyReadyUnscopedMainThreadPrerequisite, VerifyCpuTaskProgressTests_ScopeJoinWakesForANewlyReadyUnscopedMainThreadPrerequisite)
NWB_ADHD_GTEST(CpuTaskProgressTests, ConcurrentSameScopeJoinsRetainLatePublishedDescendantsAcrossScopeReuse, VerifyCpuTaskProgressTests_ConcurrentSameScopeJoinsRetainLatePublishedDescendantsAcrossScopeReuse)


