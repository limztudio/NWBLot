////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SHADOW_SAMPLING_SLANGI
#define NWB_GRAPHICS_SHADOW_SAMPLING_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// One low-discrepancy cone sample per pixel/frame feeds the soft-shadow resolve.


uint nwbShadowHashU32(uint value){
    value ^= value >> 17u;
    value *= 0xed5ad4bbu;
    value ^= value >> 11u;
    value *= 0xac4c1b51u;
    value ^= value >> 15u;
    value *= 0x31848babu;
    value ^= value >> 14u;
    return value;
}

uint nwbShadowSeed(const uint2 pixel, const uint frameIndex){
    return nwbShadowHashU32(pixel.x * 0x9e3779b1u + pixel.y * 0x85ebca77u + frameIndex * 0xc2b2ae3du);
}


// R2 sequence with per-pixel Cranley-Patterson rotation. The R2 fraction + jitter offset are (0, 1) bounded factors; half math is sufficient here (widened at the float2 return).
float2 nwbShadowLowDiscrepancy2D(const uint2 pixel, const uint frameIndex){
    const half a1 = half(0.75487766624669276005); // 1 / phi2
    const half a2 = half(0.56984029099805326591); // 1 / phi2^2
    // Mask before float conversion to preserve R2 fractional precision for large frame indices.
    const half indexF = half((frameIndex & 0xffffu) + 1u);
    const half2 r2 = half2(frac(float2(float(a1), float(a2)) * float(indexF)));

    const uint seed = nwbShadowSeed(pixel, frameIndex);
    const half2 offset = half2(half(seed & 0xffffu), half((seed >> 16u) & 0xffffu)) * (half(1.0h) / half(65536.0));

    return float2(frac(float2(r2 + offset)));
}


void nwbShadowBuildBasis(const float3 axis, out float3 tangent, out float3 bitangent){
    const float sign = (axis.z >= 0.0) ? 1.0 : -1.0;
    const float a = -1.0 / (sign + axis.z);
    const float b = axis.x * axis.y * a;
    tangent = float3(1.0 + sign * axis.x * axis.x * a, sign * b, -sign * axis.x);
    bitangent = float3(b, sign + axis.y * axis.y * a, -axis.y);
}


// Uniform-solid-angle cone sample; zero angle returns the hard-shadow axis. Cosine/angle blend factors are (0, 1) bounded; half math is sufficient here (widened at the normalize).
float3 nwbShadowJitterCone(const float3 axis, const float halfAngle, const float2 u){
    if(halfAngle <= 0.0)
        return axis;

    const half cosHalfAngle = half(cos(halfAngle));
    const half cosTheta = half(lerp(float(cosHalfAngle), 1.0, u.x));
    const half sinTheta = sqrt(max(half(1.0h) - cosTheta * cosTheta, half(0.0h)));
    const half phi = half(NWB_SHADOW_FULL_TURN_RADIANS) * half(u.y);

    float3 tangent;
    float3 bitangent;
    nwbShadowBuildBasis(axis, tangent, bitangent);

    return normalize(
        float(cos(float(phi)) * float(sinTheta)) * tangent +
        float(sin(float(phi)) * float(sinTheta)) * bitangent +
        float(cosTheta) * axis
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

