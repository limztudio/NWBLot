////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/gi/quality_settings.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets/graphics/gi/surfel/surfel_binding_slots.h>"), cpp_name("NWB_SURFEL_COUNTER_SIZE")]
extern const usize s_SurfelReadbackCounterCount;

[cpp_header("<impl/assets/graphics/gi/surfel/surfel_binding_slots.h>"), cpp_name("NWB_SURFEL_CONVERGED_RAYS_PER_SURFEL")]
extern const u32 s_ShaderSurfelConvergedRaysPerSurfel;

[cpp_header("<impl/assets/graphics/gi/surfel/surfel_binding_slots.h>"), cpp_name("NWB_SURFEL_RAYS_PER_SURFEL")]
extern const u32 s_ShaderSurfelRaysPerSurfel;

[cpp_header("<impl/assets/graphics/gi/surfel/surfel_binding_slots.h>"), cpp_name("NWB_SURFEL_CONVERGED_UNIFORM_RAYS_PER_SURFEL")]
extern const u32 s_ShaderSurfelConvergedUniformRaysPerSurfel;

[cpp_header("<impl/assets/graphics/gi/surfel/surfel_binding_slots.h>"), cpp_name("NWB_SURFEL_CONVERGED_SAMPLE_COUNT")]
extern const u32 s_ShaderSurfelConvergedSampleCount;

[cpp_header("<impl/assets/graphics/gi/surfel/surfel_binding_slots.h>"), cpp_name("NWB_SURFEL_MAX_ACCUM")]
extern const u32 s_ShaderSurfelMaxAccum;

[cpp_header("<impl/assets/graphics/gi/surfel/surfel_binding_slots.h>"), cpp_name("NWB_SURFEL_GUIDE_BIN_COUNT")]
extern const u32 s_ShaderSurfelGuideBinCount;

[cpp_header("<impl/assets/graphics/gi/surfel/surfel_binding_slots.h>"), cpp_name("NWB_SURFEL_RECORD_SIZE")]
extern const u32 s_ShaderSurfelRecordSize;

[cpp_header("<impl/assets/graphics/gi/surfel/surfel_binding_slots.h>"), cpp_name("NWB_SURFEL_GUIDE_FLOAT4_STRIDE")]
extern const u32 s_ShaderSurfelGuideFloat4Stride;

[cpp_header("<impl/assets/graphics/gi/surfel/surfel_binding_slots.h>"), cpp_name("NWB_SURFEL_POOL_CAPACITY")]
extern const u32 s_ShaderSurfelPoolCapacity;

static_assert(size_of<SurfelHeapPushConstants>() == size_of<u32>() * 15u, "SurfelHeapPushConstants must match NwbSurfelHeapPushConstants");
static_assert(s_ShaderSurfelConvergedRaysPerSurfel >= 1u && s_ShaderSurfelConvergedRaysPerSurfel <= s_ShaderSurfelRaysPerSurfel);
static_assert(s_ShaderSurfelConvergedUniformRaysPerSurfel >= 1u && s_ShaderSurfelConvergedUniformRaysPerSurfel <= s_ShaderSurfelConvergedRaysPerSurfel);
static_assert(s_ShaderSurfelConvergedSampleCount >= 1u && s_ShaderSurfelConvergedSampleCount <= s_ShaderSurfelMaxAccum);
static_assert(s_ShaderSurfelGuideBinCount == 16u && s_ShaderSurfelRecordSize == 96u);
static_assert(size_of<f32x4>() == s_ShaderSurfelGuideFloat4Stride);
static_assert(s_ShaderSurfelRaysPerSurfel >= s_ShaderSurfelGuideBinCount);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RtSurfelGiState{
    public BindingLayoutHandle m_surfelHeapBindingLayout;
    public ShaderHandle m_surfelSpawnShader;
    public ComputePipelineHandle m_surfelSpawnPipeline;
    public ShaderHandle m_surfelAgeFreeShader;
    public ComputePipelineHandle m_surfelAgeFreePipeline;
    public ShaderHandle m_surfelHashBuildShader;
    public ComputePipelineHandle m_surfelHashBuildPipeline;
    public ShaderHandle m_surfelTraceShader;
    public ComputePipelineHandle m_surfelTracePipeline;
    public ShaderHandle m_surfelTraceCsgShader;
    public ComputePipelineHandle m_surfelTraceCsgPipeline;
    public ShaderHandle m_surfelResolveShader;
    public ComputePipelineHandle m_surfelResolvePipeline;
    public ShaderHandle m_surfelUpsampleShader;
    public ComputePipelineHandle m_surfelUpsamplePipeline;
    public ShaderHandle m_surfelTraceBuildArgsShader;
    public ComputePipelineHandle m_surfelTraceBuildArgsPipeline;
    public ShaderHandle m_surfelTraceHwShader;
    public ComputePipelineHandle m_surfelTraceHwPipeline;
    public ShaderHandle m_surfelTraceCsgHwShader;
    public ComputePipelineHandle m_surfelTraceCsgHwPipeline;
    public BufferHandle m_surfelPoolBuffer;
    public BufferHandle m_surfelGuidePoolBuffer;
    public BufferHandle m_surfelCellHeadBuffer;
    public BufferHandle m_surfelCounterBuffer;
    public BufferHandle m_surfelTraceIndirectArgsBuffer;
    public BufferHandle m_surfelFreeListBuffer;
    public BufferHandle m_surfelPoolSnapshotBuffer;
    public BufferHandle m_surfelCellHeadSnapshotBuffer;
    public BufferHandle m_surfelCounterReadback;
    public BufferHandle m_surfelConstants;

    public GpuDescriptorHandle m_surfelConstantsHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle m_surfelPoolHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle m_surfelGuidePoolHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle m_surfelCellHeadHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle m_surfelCounterHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle m_surfelTraceIndirectArgsHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle m_surfelFreeListHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle m_surfelPoolSnapshotHeapHandle = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle m_surfelCellHeadSnapshotHeapHandle = GpuDescriptorHandleInvalid();

    public QueueSubmissionToken m_surfelCountReadbackSubmissionToken;
    public u32 m_surfelCountReadbackFrame = 0u;
    public u32 m_surfelTraceGeometryFailureFlags = 0u;
    public u32 m_surfelPoolCapacity = s_ShaderSurfelPoolCapacity;
    public u32 m_surfelHashCellCount = s_ShaderSurfelHashCellCount;
    public u32 m_surfelFrameIndex = 0u;

    public b8 m_surfelTraceHwPipelineFailed = false;
    public b8 m_surfelUseHwTrace = false;
    public b8 m_surfelUseCsgTrace = false;
    public b8 m_surfelTraceCsgPipelineFailed = false;
    public b8 m_surfelTraceCsgHwPipelineFailed = false;
    public b8 m_surfelTraceBuildArgsPipelineFailed = false;
    public b8 m_surfelUpsamplePipelineFailed = false;
    public b8 m_surfelResolvePipelineFailed = false;
    public b8 m_surfelResolveDispatchLogged = false;
    public b8 m_surfelTracePipelineFailed = false;
    public b8 m_surfelHashBuildPipelineFailed = false;
    public b8 m_surfelAgeFreePipelineFailed = false;
    public b8 m_surfelSpawnPipelineFailed = false;
    public b8 m_surfelEnabled = false;
    public b8 m_surfelSeeded = false;
    public b8 m_surfelResourcesNeedClear = false;
    public b8 m_surfelResourcesClearPending = false;
}


