namespace EditTextMode = Impl::Ui::EditTextMode;

class MultilineFixture : public testing::Test{
public:
    MultilineFixture()
        : m_arena(Name(NWB::Tests::UiCases::s_UiMultilineFixture))
        , m_model(m_arena, {}, EditTextMode::Multiline)
    {}


