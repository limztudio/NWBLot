const StringView s_NumericPanelKey = "panel";
const StringView s_PopupToolsPanelKey = "panel";
const StringView s_AnchorKey = "anchor";
const StringView s_TooltipKey = "tip";
const StringView s_MenuKey = "menu";

class NumericEvent{
    public String text;
    public InputCommandIntent intent;
    public EditAction action = EditAction::Submit;
    public UiFixtureNumericEventKind kind = UiFixtureNumericEventKind::Text;
}

class NumericHost : IEditBoxHost{
    public String displayed;
    public Optional<mut IntegerEditModel> onLoanInteger;
    public Optional<mut IntegerEditModel> onPublishInteger;
    public Optional<mut FloatEditModel> onPublishFloat;
    public Optional<mut Builder> resetBuilder;
    public PopupToken lastPopup;
    public i64 mutationValue = 99;
    public usize loans = 0u;
    public usize ordinaryLoans = 0u;
    public usize publishes = 0u;
    public b8 focused = true;
    public b8 mutationApplied = false;
    private Vector<NumericEvent> m_events;
    private InputBindings m_bindings;

    public void text(in StringView value){
        NumericEvent event;
        event.text.assign(value);
        this.m_events.push_back(event);
    }
    public void key(in i32 key){ this.key(key, false); }
    public void key(in i32 key, in b8 control){
        NumericEvent event;
        event.kind = UiFixtureNumericEventKind::Key;
        i32 modifiers = 0;
        if(control)
            modifiers = cast<i32>(InputModifier::Control);
        event.intent = this.m_bindings.resolve(key, modifiers);
        this.m_events.push_back(event);
    }
    public void replace(in StringView value){
        this.key(cast<i32>(Key::A), true);
        this.text(value);
    }
    public void preedit(in StringView value){
        NumericEvent event;
        event.kind = UiFixtureNumericEventKind::Preedit;
        event.text.assign(value);
        this.m_events.push_back(event);
    }
    public void action(in EditAction action){
        NumericEvent event;
        event.kind = UiFixtureNumericEventKind::Action;
        event.action = action;
        this.m_events.push_back(event);
    }
    public EditBoxResult edit(in WidgetState widget, in EditBoxOptions options, mut EditModel model)override{
        ++this.ordinaryLoans;
        EditBoxResult result;
        result.valid = true;
        return result;
    }
    public EditBoxResult editInPopup(in WidgetState widget, in EditBoxOptions options, in PopupToken popup, mut EditModel model)override{
        return EditBoxResult();
    }
    public EditBoxResult editNavigated(
        in WidgetState widget,
        in EditBoxOptions options,
        in PopupToken popup,
        mut EditModel model,
        mut EditNavigationState navigation,
        mut IEditNavigationResolver resolver,
        mut IEditActionSink sink
    )override{
        return EditBoxResult();
    }
    public EditBoxResult editActions(in WidgetState widget, in EditBoxOptions options, in PopupToken popup, mut EditModel draft, mut IEditActionSink sink)override{
        ++this.loans;
        this.lastPopup = popup;
        EditBoxResult result;
        result.valid = true;
        result.focused = options.enabled && this.focused;
        const u64 revision = draft.revision();
        const usize anchor = draft.anchor();
        const usize caret = draft.caret();
        for(in NumericEvent event : this.m_events){
            if(!ApplyNumericHostEvent(event, options, draft, sink, result))
                break;
        }
        this.m_events.clear();
        if(this.onLoanInteger.has_value())
            this.mutationApplied = this.onLoanInteger.value().setValue(this.mutationValue);
        if(this.resetBuilder.has_value())
            this.resetBuilder.value().reset();
        result.textChanged = revision != draft.revision();
        result.selectionChanged = anchor != draft.anchor() || caret != draft.caret();
        return result;
    }
    public b8 publish(in WidgetState widget, in EditBoxView view, in EditBoxPlacement placement, in EditBoxOptions options)override{
        ++this.publishes;
        this.displayed.assign(view.displayText());
        if(this.onPublishInteger.has_value())
            this.mutationApplied = this.onPublishInteger.value().setValue(this.mutationValue);
        if(this.onPublishFloat.has_value())
            this.mutationApplied = this.onPublishFloat.value().setValue(cast<f64>(this.mutationValue));
        return true;
    }
}

[extensible]
class NumericFixture : WidgetFixture{
    public IntegerEditModel m_integer;
    public FloatEditModel m_float;
    public EditBoxState m_integerState;
    public EditBoxState m_floatState;
    public PopupState m_parent;
    public PopupState m_child;
    public NumericHost m_host;

    public b8 beginNumeric(in u64 generation){
        return this.begin(generation) && this.m_builder.beginPanel(s_NumericPanelKey, Rect(20.0f, 20.0f, 740.0f, 520.0f));
    }
    public b8 beginParent(in u64 generation){
        return this.begin(generation) && this.m_builder.beginPopup("parent", this.m_parent, MakeLargeLoanParentPopupOptions());
    }
    public b8 acceptNumeric(){ return this.finishPanel() && this.m_context.commitFrame(this.m_context.readyGeneration()); }
    public void useHost(){ this.m_builder.setEditHost(this.m_host); }
}

class NumericModelFixture<Model>{ public Model m_model; }

class PopupToolsSource : IListDataSource{
    public u64 generation = 1401u;
    public u64 count = 5u;
    public u64 selectListKey = 4u;
    public TestObserved<u64> contentRevision = TestObserved<u64>(1u);
    public TestObserved<Optional<mut ContextMenuState>> closeOnText;
    public TestObserved<Optional<mut TooltipState>> resetTooltipOnText;
    public TestObserved<Optional<mut ListState>> selectListOnText;
    public TestObserved<Optional<mut ComboState>> closeComboOnRevision;
    public TestObserved<b8> changeRevisionOnText;

    public u64 instanceGeneration()const override{ return this.generation; }
    public u64 revision()const override{
        if(this.closeComboOnRevision.value().has_value()){
            mut ComboState state = this.closeComboOnRevision.value().value();
            this.closeComboOnRevision.value().reset();
            state.close();
        }
        return this.contentRevision.value();
    }
    public u64 rowCount()const override{ return this.count; }
    public u64 key(in u64 index)const override{
        if(index < this.count)
            return index + 1u;
        return 0u;
    }
    public Expected<u64> indexOf(in u64 value)const override{ return FindArithmeticFixtureRowIndex(this.count, 0u, false, value); }
    public Expected<u64> findEnabled(in u64 start, in b8 reverse)const override{ return FindSingleDisabledFixtureRow(this.count, 0u, false, start, reverse, 3u); }
    public b8 enabled(in u64 index)const override{ return index < this.count && index + 1u != 3u; }
    public StringView text(in u64 index)const override{
        if(this.changeRevisionOnText.value()){
            this.changeRevisionOnText.value() = false;
            ++this.contentRevision.value();
        }
        if(this.closeOnText.value().has_value()){
            mut ContextMenuState state = this.closeOnText.value().value();
            this.closeOnText.value().reset();
            state.close();
        }
        if(this.resetTooltipOnText.value().has_value()){
            mut TooltipState state = this.resetTooltipOnText.value().value();
            this.resetTooltipOnText.value().reset();
            state.reset();
        }
        if(this.selectListOnText.value().has_value()){
            mut ListState state = this.selectListOnText.value().value();
            this.selectListOnText.value().reset();
            state.select(this.selectListKey);
        }
        return FormatPopupToolsRowLabel(this.count, index);
    }
}

[extensible]
class PopupToolsFixture : WidgetFixture{
    public PopupToolsSource m_source;
    public TooltipState m_tooltip;
    public ContextMenuState m_menu;
    public PopupState m_plainPopup;
    public WidgetOptions m_anchorOptions;
    public TooltipOptions m_tooltipOptions;
    public ContextMenuOptions m_menuOptions;
    public ContextMenuResult m_menuResult;
    public f32 m_deltaSeconds = 0.0f;
    public b8 m_anchorActivated = false;

    public void setup(){ SetUpPopupToolsFixture(this); }
    public b8 declareTools(in u64 generation){ return this.declareTools(generation, true); }
    public b8 declareTools(in u64 generation, in b8 tooltip){ return this.declareTools(generation, tooltip, true); }
    public b8 declareTools(in u64 generation, in b8 tooltip, in b8 menu){ return this.declareTools(generation, tooltip, menu, Rect(10.0f, 10.0f, 360.0f, 280.0f)); }
    public b8 declareTools(in u64 generation, in b8 tooltip, in b8 menu, in Rect bounds){ return DeclarePopupToolsFixture(this, generation, tooltip, menu, bounds); }
    public b8 prepareTools(in u64 generation){ return this.prepareTools(generation, true); }
    public b8 prepareTools(in u64 generation, in b8 tooltip){ return this.prepareTools(generation, tooltip, true); }
    public b8 prepareTools(in u64 generation, in b8 tooltip, in b8 menu){ return this.prepareTools(generation, tooltip, menu, Rect(10.0f, 10.0f, 360.0f, 280.0f)); }
    public b8 prepareTools(in u64 generation, in b8 tooltip, in b8 menu, in Rect bounds){ return this.declareTools(generation, tooltip, menu, bounds) && this.finishPanel(); }
    public b8 acceptTools(in u64 generation){ return this.acceptTools(generation, true); }
    public b8 acceptTools(in u64 generation, in b8 tooltip){ return this.acceptTools(generation, tooltip, true); }
    public b8 acceptTools(in u64 generation, in b8 tooltip, in b8 menu){ return this.acceptTools(generation, tooltip, menu, Rect(10.0f, 10.0f, 360.0f, 280.0f)); }
    public b8 acceptTools(in u64 generation, in b8 tooltip, in b8 menu, in Rect bounds){ return this.prepareTools(generation, tooltip, menu, bounds) && this.m_context.commitFrame(generation); }
    public b8 acceptPopupTooltip(in u64 generation){ return AcceptPopupTooltipFixture(this, generation); }
    public Optional<in HitTarget> menuHost()const{
        for(in HitTarget entry : this.m_context.input().targets()){
            if(entry.navigable && entry.popup.instanceGeneration == this.m_menu.instanceGeneration())
                return Optional<in HitTarget>(entry);
        }
        return Optional<in HitTarget>();
    }
    public Optional<in HitTarget> menuRow(in u64 key)const{
        for(in HitTarget entry : this.m_context.input().targets()){
            if(entry.value == key && entry.popup.instanceGeneration == this.m_menu.instanceGeneration())
                return Optional<in HitTarget>(entry);
        }
        return Optional<in HitTarget>();
    }
    public b8 moveToAnchor(){ return this.moveToAnchor(s_PopupToolsPanelKey); }
    public b8 moveToAnchor(in StringView parent){ return MovePopupToolsToAnchor(this, parent); }
    public void secondaryClick(in Point point){ SecondaryClickPopupTools(this, point); }
    public b8 openBySecondary(in u64 generation){ return OpenPopupToolsBySecondary(this, generation); }
}


PopupOptions MakePopupTooltipFixtureOptions(){
    PopupOptions options = PopupOptions();
    options.anchor.x = 40.0f;
    options.anchor.y = 40.0f;
    options.anchor.width = 40.0f;
    options.anchor.height = 24.0f;
    options.size.x = 320.0f;
    options.size.y = 220.0f;
    return options;
}

b8 ApplyNumericHostEvent(in NumericEvent event, in EditBoxOptions options, mut EditModel draft, mut IEditActionSink sink, mut EditBoxResult result){
    if(event.kind == UiFixtureNumericEventKind::Action){
        if(!sink.apply(draft, event.action, options.readOnly)){
            result.valid = false;
            return false;
        }
        result.blurred = result.blurred || (event.action == EditAction::Blur);
        result.abandoned = result.abandoned || (event.action == EditAction::Abandon);
        if(event.action == EditAction::Blur)
            result.focused = false;
        return true;
    }
    if(options.enabled && event.kind == UiFixtureNumericEventKind::Text && !options.readOnly){
        if(!draft.replaceSelection(StringView(event.text))){
            result.valid = false;
            return false;
        }
        return true;
    }
    if(options.enabled && event.kind == UiFixtureNumericEventKind::Preedit && !options.readOnly){
        const StringView textView = StringView(event.text);
        if(!draft.beginComposition() || !draft.updateComposition(textView, textView.size(), textView.size(), Span<EditPreeditClause>())){
            result.valid = false;
            return false;
        }
        return true;
    }
    if(options.enabled && event.kind == UiFixtureNumericEventKind::Key){
        const EditCommandResult command = ApplyEditCommand(draft, TranslateEditCommand(event.intent, false, EditTextMode::SingleLine), options.readOnly);
        result.submitted = result.submitted || command.submitted;
        result.cancelled = result.cancelled || command.cancelled;
        if(command.submitted || command.cancelled){
            auto action = EditAction::Cancel;
            if(command.submitted)
                action = EditAction::Submit;
            if(!sink.apply(draft, action, options.readOnly)){
                result.valid = false;
                return false;
            }
            if(command.cancelled){
                result.focused = false;
                return false;
            }
        }
    }
    return true;
}

StringView FormatPopupToolsRowLabel(in u64 count, in u64 index){
    if(index >= count)
        return "";
    switch(index){
    case 0u: return "One";
    case 1u: return "Two";
    case 2u: return "Three";
    case 3u: return "Four";
    case 4u: return "Five";
    default: return "";
    }
}

void SetUpPopupToolsFixture(mut PopupToolsFixture self){
    self.setUpWidgetBase();
    self.m_anchorOptions.width.policy = LayoutSizePolicy::Fixed;
    self.m_anchorOptions.width.value = 220.0f;
    self.m_anchorOptions.height.policy = LayoutSizePolicy::Fixed;
    self.m_anchorOptions.height.value = 32.0f;
    self.m_tooltipOptions.delaySeconds = 0.0f;
    self.m_menuOptions.size = Point(240.0f, 220.0f);
}

b8 DeclarePopupToolsFixture(mut PopupToolsFixture self, in u64 generation, in b8 tooltip, in b8 menu, in Rect bounds){
    if(!self.begin(generation) || !self.m_builder.beginPanel(s_PopupToolsPanelKey, bounds))
        return false;
    self.m_builder.setDeltaSeconds(self.m_deltaSeconds);
    self.m_anchorActivated = self.m_builder.button(s_AnchorKey, "Anchor", self.m_anchorOptions);
    self.m_menuResult = ContextMenuResult();
    if(tooltip && !self.m_builder.tooltip(s_TooltipKey, s_AnchorKey, "Helpful text", self.m_tooltip, self.m_tooltipOptions))
        return false;
    if(menu){
        self.m_menuResult = self.m_builder.contextMenu(s_MenuKey, s_AnchorKey, self.m_source, self.m_menu, self.m_menuOptions);
        if(!self.m_menuResult.valid)
            return false;
    }
    return true;
}

b8 AcceptPopupTooltipFixture(mut PopupToolsFixture self, in u64 generation){
    if(!self.begin(generation))
        return false;
    const PopupOptions options = MakePopupTooltipFixtureOptions();
    self.m_builder.setDeltaSeconds(self.m_deltaSeconds);
    if(!self.m_builder.beginPopup("plain", self.m_plainPopup, options))
        return false;
    self.m_anchorActivated = self.m_builder.button(s_AnchorKey, "Popup anchor", self.m_anchorOptions);
    return self.m_builder.tooltip(s_TooltipKey, s_AnchorKey, "Overlay help", self.m_tooltip, self.m_tooltipOptions)
        && self.m_builder.endPopup()
        && self.m_context.endRoot()
        && self.m_context.finishFrame()
        && self.m_context.commitFrame(generation);
}

b8 MovePopupToolsToAnchor(mut PopupToolsFixture self, in StringView parent){
    const WidgetId anchorId = self.id(s_AnchorKey, parent);
    const Expected<HitTarget> accepted = self.tryTarget(anchorId);
    if(!accepted.has_value())
        return false;
    InputEvent move = InputEvent();
    move.position = CenterUiRect(accepted.value().rectangle);
    move.type = InputEventType::PointerMove;
    return self.send(move).hover == anchorId;
}

void SecondaryClickPopupTools(mut PopupToolsFixture self, in Point point){
    InputEvent down = InputEvent();
    down.position = point;
    down.type = InputEventType::SecondaryDown;
    EXPECT_TRUE(self.send(down).pointerConsumed);
    InputEvent up = InputEvent();
    up.position = point;
    up.type = InputEventType::SecondaryUp;
    EXPECT_TRUE(self.send(up).pointerConsumed);
}

b8 OpenPopupToolsBySecondary(mut PopupToolsFixture self, in u64 generation){
    const Expected<HitTarget> accepted = self.tryTarget(self.id(s_AnchorKey, s_PopupToolsPanelKey));
    if(!accepted.has_value())
        return false;
    self.secondaryClick(CenterUiRect(accepted.value().rectangle));
    return self.acceptTools(generation, false) && self.m_menu.isOpen();
}


