    EXPECT_EQ(self.m_model.text(), "a\xCC\x81z");
    EXPECT_EQ(self.m_model.anchor(), 0u);
    EXPECT_EQ(self.m_model.caret(), 3u);
    EXPECT_EQ(self.m_model.revision(), revision);
