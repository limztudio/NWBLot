void VerifyUiNumericParseTests_IntegerPrefixesAndMalformedSyntaxRetainErrorClassification(){
    Array<UiNumericParseExpectationCase, 23u> cases = Array<UiNumericParseExpectationCase, 23u>();
    cases[0u] = UiNumericParseExpectationCase("", NumericParseStatus::Incomplete);
    cases[1u] = UiNumericParseExpectationCase("  ", NumericParseStatus::Incomplete);
    cases[2u] = UiNumericParseExpectationCase("+", NumericParseStatus::Incomplete);
    cases[3u] = UiNumericParseExpectationCase("-", NumericParseStatus::Incomplete);
    cases[4u] = UiNumericParseExpectationCase(" + ", NumericParseStatus::Incomplete);
    cases[5u] = UiNumericParseExpectationCase("--1");
    cases[6u] = UiNumericParseExpectationCase("+-1");
    cases[7u] = UiNumericParseExpectationCase("1 2");
    cases[8u] = UiNumericParseExpectationCase("1,000");
    cases[9u] = UiNumericParseExpectationCase("1_000");
    cases[10u] = UiNumericParseExpectationCase("0x10");
    cases[11u] = UiNumericParseExpectationCase("1.0");
    cases[12u] = UiNumericParseExpectationCase("1e2");
    cases[13u] = UiNumericParseExpectationCase("12x");
    cases[14u] = UiNumericParseExpectationCase("nan");
    cases[15u] = UiNumericParseExpectationCase("inf");
    cases[16u] = UiNumericParseExpectationCase("\342\210\2221");
    cases[17u] = UiNumericParseExpectationCase("\xD9\xA1");
    cases[18u] = UiNumericParseExpectationCase("\302\2401");
    cases[19u] = UiNumericParseExpectationCase(s_UiNumericParseEmbeddedNulDigits);
    cases[20u] = UiNumericParseExpectationCase("999999999999999999999999x");
    cases[21u] = UiNumericParseExpectationCase("9223372036854775808", NumericParseStatus::OutOfRange);
    cases[22u] = UiNumericParseExpectationCase("-9223372036854775809", NumericParseStatus::OutOfRange);
    for(in UiNumericParseExpectationCase test : cases){
        const ScopedTestTrace trace = ScopedTestTrace(test.text);
        const auto parsed = ParseIntegerDraft(test.text);
        ASSERT_FALSE(parsed.has_value());
        EXPECT_EQ(parsed.error(), test.status);
    }
}

void VerifyUiNumericParseTests_IntegerConversionPreservesSignedBoundsAndLargeExactValues(){
    Array<UiNumericParseIntegerCompleteCase, 3u> cases = Array<UiNumericParseIntegerCompleteCase, 3u>();
    cases[0u] = UiNumericParseIntegerCompleteCase("9007199254740993", 9007199254740993ll);
    cases[1u] = UiNumericParseIntegerCompleteCase("-9223372036854775808", i64.min);
    cases[2u] = UiNumericParseIntegerCompleteCase("+9223372036854775807", i64.max);
    for(in UiNumericParseIntegerCompleteCase test : cases){
        const ScopedTestTrace trace = ScopedTestTrace(test.text);
        const auto parsed = ParseIntegerDraft(test.text);
        ASSERT_TRUE(parsed.has_value());
        EXPECT_EQ(parsed.value(), test.value);
    }
}

void VerifyUiNumericParseTests_FloatPrefixesAndMalformedSyntaxAreClassifiedBeforeConversion(){
    Array<UiNumericParseExpectationCase, 30u> cases = Array<UiNumericParseExpectationCase, 30u>();
    cases[0u] = UiNumericParseExpectationCase("", NumericParseStatus::Incomplete);
    cases[1u] = UiNumericParseExpectationCase("  ", NumericParseStatus::Incomplete);
    cases[2u] = UiNumericParseExpectationCase("+", NumericParseStatus::Incomplete);
    cases[3u] = UiNumericParseExpectationCase("-", NumericParseStatus::Incomplete);
    cases[4u] = UiNumericParseExpectationCase(".", NumericParseStatus::Incomplete);
    cases[5u] = UiNumericParseExpectationCase("+.", NumericParseStatus::Incomplete);
    cases[6u] = UiNumericParseExpectationCase("-.", NumericParseStatus::Incomplete);
    cases[7u] = UiNumericParseExpectationCase("1e", NumericParseStatus::Incomplete);
    cases[8u] = UiNumericParseExpectationCase("1e+", NumericParseStatus::Incomplete);
    cases[9u] = UiNumericParseExpectationCase("1.e-", NumericParseStatus::Incomplete);
    cases[10u] = UiNumericParseExpectationCase("e");
    cases[11u] = UiNumericParseExpectationCase(".e1");
    cases[12u] = UiNumericParseExpectationCase("1..0");
    cases[13u] = UiNumericParseExpectationCase("1e--2");
    cases[14u] = UiNumericParseExpectationCase("1e+x");
    cases[15u] = UiNumericParseExpectationCase("1e2x");
    cases[16u] = UiNumericParseExpectationCase("1 2");
    cases[17u] = UiNumericParseExpectationCase("1,2");
    cases[18u] = UiNumericParseExpectationCase("1_2");
    cases[19u] = UiNumericParseExpectationCase("0x1p2");
    cases[20u] = UiNumericParseExpectationCase("nan");
    cases[21u] = UiNumericParseExpectationCase("NaN");
    cases[22u] = UiNumericParseExpectationCase("inf");
    cases[23u] = UiNumericParseExpectationCase("-infinity");
    cases[24u] = UiNumericParseExpectationCase("\302\2401");
    cases[25u] = UiNumericParseExpectationCase(s_UiNumericParseEmbeddedNulDigits);
    cases[26u] = UiNumericParseExpectationCase("1e99999x");
    cases[27u] = UiNumericParseExpectationCase("1e309", NumericParseStatus::OutOfRange);
    cases[28u] = UiNumericParseExpectationCase("1e-9999", NumericParseStatus::OutOfRange);
    cases[29u] = UiNumericParseExpectationCase("2e308", NumericParseStatus::OutOfRange);
    for(in UiNumericParseExpectationCase test : cases){
        const ScopedTestTrace trace = ScopedTestTrace(test.text);
        const auto parsed = ParseFloatDraft(test.text);
        ASSERT_FALSE(parsed.has_value());
        EXPECT_EQ(parsed.error(), test.status);
    }
}

void VerifyUiNumericParseTests_SignedZeroDraftSpellingsPreserveTheSignBit(){
    Array<UiNumericParseFloatCompleteCase, 3u> cases = Array<UiNumericParseFloatCompleteCase, 3u>();
    cases[0u] = UiNumericParseFloatCompleteCase("-0", -0.0);
    cases[1u] = UiNumericParseFloatCompleteCase("-0.0", -0.0);
    cases[2u] = UiNumericParseFloatCompleteCase("-0e100", -0.0);
    for(in UiNumericParseFloatCompleteCase test : cases){
        const ScopedTestTrace trace = ScopedTestTrace(test.text);
        const auto parsed = ParseFloatDraft(test.text);
        ASSERT_TRUE(parsed.has_value());
        EXPECT_EQ(bit_cast<u64>(parsed.value()), bit_cast<u64>(test.value));
    }
}

void VerifyUiNumericParseTests_EveryAsciiEdgeWhitespaceIsAcceptedButInteriorWhitespaceIsInvalid(){
    Array<StringView, 6u> whitespace = Array<StringView, 6u>();
    whitespace[0u] = " ";
    whitespace[1u] = "\t";
    whitespace[2u] = "\n";
    whitespace[3u] = "\r";
    whitespace[4u] = "\f";
    whitespace[5u] = "\v";
    for(in StringView edge : whitespace){
        String trimmed = "";
        trimmed += edge;
        trimmed += "+7";
        trimmed += edge;
        const StringView trimmedView = StringView(trimmed.data(), trimmed.size());
        const auto integer = ParseIntegerDraft(trimmedView);
        const auto floating = ParseFloatDraft(trimmedView);
        ASSERT_TRUE(integer.has_value());
        ASSERT_TRUE(floating.has_value());
        EXPECT_EQ(integer.value(), 7);
        EXPECT_EQ(floating.value(), 7.0);

        String interior = "1";
        interior += edge;
        interior += "2";
        const StringView interiorView = StringView(interior.data(), interior.size());
        const auto invalidInteger = ParseIntegerDraft(interiorView);
        const auto invalidFloat = ParseFloatDraft(interiorView);
        ASSERT_FALSE(invalidInteger.has_value());
        ASSERT_FALSE(invalidFloat.has_value());
        EXPECT_EQ(invalidInteger.error(), NumericParseStatus::Invalid);
        EXPECT_EQ(invalidFloat.error(), NumericParseStatus::Invalid);
    }
}

void VerifyUiNumericParseTests_BoundsValidationRejectsReversalNonfiniteEndpointsAndUnknownPolicy(){
    EXPECT_TRUE(ValidateIntegerBounds(MakeUiNumericIntegerBounds(4, 4, NumericBoundsPolicy::Clamp)));
    EXPECT_TRUE(ValidateFloatBounds(MakeUiNumericFloatBounds(-0.0, 0.0, NumericBoundsPolicy::Reject)));
    EXPECT_FALSE(ValidateIntegerBounds(MakeUiNumericIntegerBounds(8, 3, NumericBoundsPolicy::Reject)));
    EXPECT_FALSE(ValidateFloatBounds(MakeUiNumericFloatBounds(8.0, 3.0, NumericBoundsPolicy::Reject)));
    EXPECT_FALSE(ValidateFloatBounds(MakeUiNumericFloatBounds(UiNumericQuietNaNF64(), 1.0, NumericBoundsPolicy::Reject)));
    EXPECT_FALSE(ValidateFloatBounds(MakeUiNumericFloatBounds(-1.0, UiNumericInfinityF64(), NumericBoundsPolicy::Reject)));
    const NumericBoundsPolicyEnum unknown = cast<NumericBoundsPolicyEnum>(2u);
    EXPECT_FALSE(ValidateIntegerBounds(MakeUiNumericIntegerBounds(-1, 1, unknown)));
    EXPECT_FALSE(ValidateFloatBounds(MakeUiNumericFloatBounds(-1.0, 1.0, unknown)));
}


