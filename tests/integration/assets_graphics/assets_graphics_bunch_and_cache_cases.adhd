const StringView s_DoesNotTargetADeclaredAsset = "does not target a declared asset";
const StringView s_BunchOwnershipMetadata = "\nmetadata local = { \"label\": \"a separately owned metadata string\", \"items\": [1, 2, 3] };\nprobe first;\nprobe second;\nfirst.local = local;\nfirst.target = second;\nsecond.items = [local, { \"target\": first }];\nasset_bunch bunch = [second, first];\n";
const StringView s_ModifiedSamplerCacheMetadata = "sampler asset;\nasset.min_filter = \"linear\";\nasset.mag_filter = \"linear\";\nasset.mip_filter = \"linear\";\nasset.address_u = \"wrap\";\nasset.address_v = \"wrap\";\nasset.address_w = \"wrap\";\nasset.reduction = \"standard\";\nasset.max_anisotropy = 1.0;\nasset.mip_bias = 3.5;\n";

b8 CanExpandFixtureBunch(mut BunchFixture fixture){
    return ExpandAssetBunch(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, fixture.document, fixture.scratchArena).has_value();
}

Expected<ExpandedAssetMetadataVector> ExpandBunchWithScratch(in GraphicsTestPath assetRoot, in StringView virtualRoot, in GraphicsTestPath filePath, in MetaDocument document, mut ScratchArena scratch){
    return ExpandAssetBunch(assetRoot, virtualRoot, filePath, document, scratch);
}

Expected<AssetBunchExpandFailureEnum> TryBunchExpandFailure(mut BunchFixture fixture){
    const AssetBunchExpandContext context(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, fixture.document, fixture.scratchArena);
    const auto result = TryAutoCollectedAssetBunchExpanders(context);
    if(result.has_value())
        return MakeUnexpected(Failure());
    return result.error();
}

Expected<ExpandedAssetMetadataVector> ExpandRegisteredBunch(mut BunchFixture fixture){
    const AssetBunchExpandContext context(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, fixture.document, fixture.scratchArena);
    const auto result = TryAutoCollectedAssetBunchExpanders(context);
    if(!result.has_value())
        return MakeUnexpected(Failure());
    return result.value();
}

b8 BuildAndGatherWithRepoRootHelper(mut TestArena testArena, in GraphicsTestPath root, in GraphicsTestPath assetRoot, in GraphicsTestPath builtDir, in GraphicsTestPath outDir){
    return BuildAndGatherWithExplicitRepoRoot(testArena, root, assetRoot, builtDir, outDir);
}

Expected<SamplerAsset> LoadSamplerFromOutput(in GraphicsTestPath outputDirectory, in Name assetName, in usize expectedVolumeFileCount, mut TestArena testArena){
    return LoadCookedSamplerAsset(outputDirectory, assetName, expectedVolumeFileCount, testArena);
}

void PrepareCacheRecordHelper(in GraphicsTestPath root, in DiscoveredNwbFile discovered, in StringView metadataText, in Sha256Digest producer, mut ScratchArena scratchArena, mut ScratchString relativePath, mut ScratchString cacheName, mut NwbFileAssetCacheRecord outRecord){
    PrepareNwbFileAssetCacheRecord(root, JoinGraphicsPath(root, s_CacheDirectory), discovered, metadataText, producer, scratchArena, relativePath, cacheName, outRecord);
}

void VerifyAssetBunchOwnership_ClearReplacementAndDestructionReleaseAllResolvedValues(){
    BunchFixture fixture = BunchFixture();
    ASSERT_TRUE(fixture.document.parse(s_BunchOwnershipMetadata));
    const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
    {
        ExpandedAssetMetadataVector output(fixture.scratchArena);
        for(usize iteration = 0u; iteration < 8u; ++iteration){
            {
                Expected<ExpandedAssetMetadataVector> expandedResult = ExpandAssetBunch(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, fixture.document, fixture.scratchArena);
                ASSERT_TRUE(expandedResult.has_value());
                output = expandedResult.value();
            }
            VerifyOwnedBunchOutput(output, fixture.document);
            const ArenaMemoryStats liveMetadata = fixture.metadataArena.memoryStats();
            EXPECT_GT(liveMetadata.usedBytes, baselineMetadata.usedBytes);
            {
                Expected<ExpandedAssetMetadataVector> expandedResult = ExpandAssetBunch(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, fixture.document, fixture.scratchArena);
                ASSERT_TRUE(expandedResult.has_value());
                output = expandedResult.value();
            }
            VerifyOwnedBunchOutput(output, fixture.document);
            EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, liveMetadata.usedBytes);
            output.clear();
            EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
        }
        {
            Expected<ExpandedAssetMetadataVector> expandedResult = ExpandAssetBunch(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, fixture.document, fixture.scratchArena);
            ASSERT_TRUE(expandedResult.has_value());
            output = expandedResult.value();
        }
        VerifyOwnedBunchOutput(output, fixture.document);
    }
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
}

void VerifyAssetBunchOwnership_OutputMoveAndGrowthPreserveValuesUntilTheirFinalOwnerDies(){
    BunchFixture fixture = BunchFixture();
    ASSERT_TRUE(fixture.document.parse(s_BunchOwnershipMetadata));
    const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
    {
        ExpandedAssetMetadataVector source(fixture.scratchArena);
        {
            Expected<ExpandedAssetMetadataVector> expandedResult = ExpandAssetBunch(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, fixture.document, fixture.scratchArena);
            ASSERT_TRUE(expandedResult.has_value());
            source = expandedResult.value();
        }
        ExpandedAssetMetadataVector destination = MoveExpandedBunchVector(source);
        destination.reserve(destination.capacity() + 37u);
        VerifyOwnedBunchOutput(destination, fixture.document);
        destination[1u].value.field(s_BunchLocal).field(s_BunchLabel).setString("changed output");
        ASSERT_TRUE(HasMetaVariable(fixture.document, s_BunchLocal));
        ASSERT_TRUE(HasMetaField(GetMetaVariable(fixture.document, s_BunchLocal), s_BunchLabel));
        EXPECT_EQ(GetMetaField(GetMetaVariable(fixture.document, s_BunchLocal), s_BunchLabel).asString(), s_ASeparatelyOwnedMetadataString);
    }
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
}

void VerifyAssetBunchOwnership_LongExportAndReferencePathsReclaimScopedResultsAndReuseCallerScratch(){
    Vector<usize> unusedCounts = Vector<usize>();
    unusedCounts.reserve(2u);
    unusedCounts.push_back(0u);
    unusedCounts.push_back(17u);

    for(in usize unusedDeclarations : unusedCounts){
        BunchFixture fixture = BunchFixture();
        MetaString firstVariable("first_", fixture.metadataArena);
        AppendRepeatedAsciiByte(firstVariable, 192u, 97u);
        MetaString secondVariable("second_", fixture.metadataArena);
        AppendRepeatedAsciiByte(secondVariable, 224u, 98u);
        MetaString rootText(fixture.metadataArena);
        AppendRepeatedAsciiByte(rootText, 256u, 114u);

        String source = StringFormat(
            "probe {};\r\nprobe {};\r\n{}.target = {};\r\n{}.nested = [{{ \"target\": {} }}];\r\nasset_bunch bunch = [{}, {}];\r\n"
            , ViewArenaString(firstVariable)
            , ViewArenaString(secondVariable)
            , ViewArenaString(firstVariable)
            , ViewArenaString(secondVariable)
            , ViewArenaString(secondVariable)
            , ViewArenaString(firstVariable)
            , ViewArenaString(secondVariable)
            , ViewArenaString(firstVariable)
        );
        for(usize index = 0u; index < unusedDeclarations; ++index)
            StringAppendFormat(source, "metadata unused_{};\r\n", index);
        ASSERT_TRUE(fixture.document.parse(source));

        const GraphicsTestPath filePath = JoinGraphicsPath(fixture.assetRoot, "bundle.nwb");
        const String formattedFirst = StringFormat("{}/bundle/{}", ViewArenaString(rootText), ViewArenaString(firstVariable));
        const String formattedSecond = StringFormat("{}/bundle/{}", ViewArenaString(rootText), ViewArenaString(secondVariable));
        const Expected<Name> firstIdentityResult = ParseName(formattedFirst);
        ASSERT_TRUE(firstIdentityResult.has_value());
        const Name firstIdentity = firstIdentityResult.value();
        const Expected<Name> secondIdentityResult = ParseName(formattedSecond);
        ASSERT_TRUE(secondIdentityResult.has_value());
        const Name secondIdentity = secondIdentityResult.value();
        const StringView virtualRoot = ViewArenaString(rootText);

        const ArenaMemoryStats retainedMetadata = fixture.metadataArena.memoryStats();

        // Keep this regression within one chunk per alignment so it isolates string growth from chunk-stack reuse.
        ScratchArena scratch(s_AssetCaseTestsAssetBunchLongPathScratch, 65536u);
        ScratchBunchSentinel sentinel(scratch);
        ASSERT_TRUE(sentinel.valid());
        const ArenaMemoryStats baselineScratch = scratch.memoryStats();
        ArenaMemoryStats warm = ArenaMemoryStats();
        const StringView virtualRootView = virtualRoot;
        const StringView firstPathView = formattedFirst;
        const StringView secondPathView = formattedSecond;
        for(usize iteration = 0u; iteration < 16u; ++iteration){
            {
                // Keep scratch allocations in stack order.
                Expected<ExpandedAssetMetadataVector> expandedResult = ExpandBunchWithScratch(fixture.assetRoot, virtualRootView, filePath, fixture.document, scratch);
                ASSERT_TRUE(expandedResult.has_value());
                in ExpandedAssetMetadataVector output = expandedResult.value();
                ASSERT_EQ(output.size(), 2u);
                EXPECT_EQ(output[0u].virtualPath, secondIdentity);
                EXPECT_EQ(output[1u].virtualPath, firstIdentity);
                ASSERT_TRUE(HasMetaField(output[0u].value, "nested"));
                ASSERT_TRUE(GetMetaField(output[0u].value, "nested").isList());
                ASSERT_EQ(GetMetaField(output[0u].value, "nested").asList().size(), 1u);
                ASSERT_TRUE(HasMetaField(GetMetaField(output[0u].value, "nested").asList()[0u], s_FieldTarget));
                ASSERT_TRUE(GetMetaField(GetMetaField(output[0u].value, "nested").asList()[0u], s_FieldTarget).isString());
                EXPECT_EQ(GetMetaField(GetMetaField(output[0u].value, "nested").asList()[0u], s_FieldTarget).asString(), firstPathView);
                ASSERT_TRUE(HasMetaField(output[1u].value, s_FieldTarget));
                ASSERT_TRUE(GetMetaField(output[1u].value, s_FieldTarget).isString());
                EXPECT_EQ(GetMetaField(output[1u].value, s_FieldTarget).asString(), secondPathView);
            }
            EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, retainedMetadata.usedBytes);
            EXPECT_TRUE(sentinel.intact());
            const ArenaMemoryStats current = scratch.memoryStats();
            EXPECT_EQ(current.usedBytes, baselineScratch.usedBytes);
            if(iteration == 0u)
                warm = current;
            else{
                EXPECT_EQ(current.usedBytes, warm.usedBytes);
                EXPECT_EQ(current.reservedBytes, warm.reservedBytes);
            }
        }
        sentinel.release();
    }
}

void VerifyAssetBunchOwnership_ValuesOutliveTheirSourceDocumentWhileItsArenaRemainsAlive(){
    BunchFixture fixture = BunchFixture();
    const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
    {
        ExpandedAssetMetadataVector output(fixture.scratchArena);
        {
            MetaDocument sourceDocument(fixture.metadataArena);
            ASSERT_TRUE(sourceDocument.parse(s_BunchOwnershipMetadata));
            {
                Expected<ExpandedAssetMetadataVector> expandedResult = ExpandAssetBunch(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, sourceDocument, fixture.scratchArena);
                ASSERT_TRUE(expandedResult.has_value());
                output = expandedResult.value();
            }
            VerifyOwnedBunchOutput(output, sourceDocument);
        }
        ASSERT_EQ(output.size(), 2u);
        ASSERT_TRUE(HasMetaField(output[0u].value, s_BunchItemsField));
        ASSERT_TRUE(GetMetaField(output[0u].value, s_BunchItemsField).isList());
        ASSERT_EQ(GetMetaField(output[0u].value, s_BunchItemsField).asList().size(), 2u);
        ASSERT_TRUE(HasMetaField(GetMetaField(output[0u].value, s_BunchItemsField).asList()[0u], s_BunchLabel));
        EXPECT_EQ(GetMetaField(GetMetaField(output[0u].value, s_BunchItemsField).asList()[0u], s_BunchLabel).asString(), s_ASeparatelyOwnedMetadataString);
        ASSERT_TRUE(HasMetaField(GetMetaField(output[0u].value, s_BunchItemsField).asList()[1u], s_FieldTarget));
        EXPECT_EQ(GetMetaField(GetMetaField(output[0u].value, s_BunchItemsField).asList()[1u], s_FieldTarget).asString(), s_ProjectFixturesBundleFirst);
    }
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
}

void VerifyAssetBunchOwnership_CallerUnwindDestroysEveryPublishedResolvedValue(){
    BunchFixture fixture = BunchFixture();
    ASSERT_TRUE(fixture.document.parse(s_BunchOwnershipMetadata));
    const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
    native(mut fixture){
        using namespace NWB::Core::Assets;
        struct CallerFailure{};
        EXPECT_THROW({
            ExpandedAssetMetadataVector output(fixture.scratchArena);
            {
                auto expandedResult = AssetsBunchCook::ExpandAssetBunch(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, fixture.document, fixture.scratchArena);
                ASSERT_TRUE(expandedResult);
                output = Move(*expandedResult);
            }
            VerifyOwnedBunchOutput(output, fixture.document);
            throw CallerFailure{};
        }, CallerFailure);
    }
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
}

void VerifyAssetBunchOwnership_FailedLaterLocalCycleReleasesTheUnpublishedValueAndPriorOutput(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration(logger, s_BreakOnFatal);
    BunchFixture fixture = BunchFixture();
    ASSERT_TRUE(fixture.document.parse("\nmetadata loop_a;\nmetadata loop_b;\nloop_a = { \"copied\": [1, 2, 3], \"next\": loop_b };\nloop_b = { \"next\": loop_a };\nprobe first = { \"owned\": \"first output remains valid on failure\" };\nprobe second = [ { \"copied\": [4, 5, 6] }, loop_a ];\nasset_bunch bunch = [first, second];\n"));
    const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
    for(usize iteration = 0u; iteration < 9u; ++iteration){
        EXPECT_FALSE(CanExpandFixtureBunch(fixture));
        EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
    }
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
    EXPECT_TRUE(SawCapturedError(logger, "cyclic local metadata reference"));
}

void VerifyAssetBunchOwnership_MissingLaterReferenceReleasesPartialNestedCollections(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration(logger, s_BreakOnFatal);
    BunchFixture fixture = BunchFixture();
    ASSERT_TRUE(fixture.document.parse("\nmetadata known;\nprobe first = { \"items\": [\"copied string\", 1, 2] };\nprobe second = [ { \"copied\": [4, 5, 6] }, known.missing ];\nasset_bunch bunch = [first, second];\n"));
    const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
    EXPECT_FALSE(CanExpandFixtureBunch(fixture));
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
    EXPECT_TRUE(SawCapturedError(logger, s_DoesNotTargetADeclaredAsset));
}

void VerifyAssetBunchOwnership_RegisteredExpanderDistinguishesUnsupportedDocumentsFromExpansionErrors(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration(logger, s_BreakOnFatal);
    BunchFixture fixture = BunchFixture();
    ASSERT_TRUE(fixture.document.parse("probe first;"));
    const Expected<AssetBunchExpandFailureEnum> unsupported = TryBunchExpandFailure(fixture);
    ASSERT_TRUE(unsupported.has_value());
    EXPECT_EQ(unsupported.value(), AssetBunchExpandFailure::Unsupported);
    EXPECT_EQ(logger.errorCount(), 0u);

    ASSERT_TRUE(fixture.document.parse("asset_bunch bunch = [];"));
    const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
    const Expected<AssetBunchExpandFailureEnum> failed = TryBunchExpandFailure(fixture);
    ASSERT_TRUE(failed.has_value());
    EXPECT_EQ(failed.value(), AssetBunchExpandFailure::Error);
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
    EXPECT_TRUE(SawCapturedError(logger, "list must contain at least one asset"));
}

void VerifyAssetBunchOwnership_RegisteredExpanderTransfersValuesToTheModelParserWithoutBorrowedLifetime(){
    BunchFixture fixture = BunchFixture();
    ASSERT_TRUE(fixture.document.parse("\nmetadata rig = { \"skeleton\": \"project/shared/skeleton\" };\nmodel model;\nmodel.skeletons = { \"rig\": rig };\nasset_bunch bunch = [model];\n"));
    const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
    ModelCookEntry entry(fixture.outputArena);
    {
        ExpandedAssetMetadataVector output(fixture.scratchArena);
        {
            Expected<ExpandedAssetMetadataVector> expandedResult = ExpandRegisteredBunch(fixture);
            ASSERT_TRUE(expandedResult.has_value());
            output = expandedResult.value();
        }
        ASSERT_EQ(output.size(), 1u);
        Expected<ModelCookEntry> entryParseResult = ParseModelCookMetadata(output[0u].virtualPath, fixture.filePath, output[0u].value, fixture.outputArena, fixture.scratchArena);
        ASSERT_TRUE(entryParseResult.has_value());
        entry = entryParseResult.value();
    }
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
    ASSERT_EQ(entry.skeletonObjects.size(), 1u);
    EXPECT_EQ(entry.skeletonObjects[0u].name, Name("rig"));
    EXPECT_EQ(entry.skeletonObjects[0u].skeleton.name(), Name("project/shared/skeleton"));
}

void VerifyAssetBunchOwnership_NullValueReachesTheTypeParserAndKeepsItsRejectionContract(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard registration(logger, s_BreakOnFatal);
    BunchFixture fixture = BunchFixture();
    ASSERT_TRUE(fixture.document.parse("model model; asset_bunch bunch = [model];"));
    const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
    {
        ExpandedAssetMetadataVector output(fixture.scratchArena);
        {
            Expected<ExpandedAssetMetadataVector> expandedResult = ExpandRegisteredBunch(fixture);
            ASSERT_TRUE(expandedResult.has_value());
            output = expandedResult.value();
        }
        ASSERT_EQ(output.size(), 1u);
        EXPECT_TRUE(output[0u].value.isNull());
        EXPECT_FALSE(ParseModelCookMetadata(output[0u].virtualPath, fixture.filePath, output[0u].value, fixture.outputArena, fixture.scratchArena).has_value());
    }
    EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
    EXPECT_TRUE(SawCapturedError(logger, "asset is not a map"));
}

void VerifyAssetBunchLookup_ExactCaseReferencesPreserveExportAndRepeatedLocalValueOrder(){
    Vector<usize> unusedCounts = Vector<usize>();
    unusedCounts.reserve(4u);
    unusedCounts.push_back(0u);
    unusedCounts.push_back(11u);
    unusedCounts.push_back(12u);
    unusedCounts.push_back(32u);

    Array<i64, 3> expectedIds = Array<i64, 3>();
    expectedIds[0u] = 11;
    expectedIds[1u] = 22;
    expectedIds[2u] = 11;

    const StringView metadata = "\nmetadata Local = { \"id\": 11 };\nmetadata local = { \"id\": 22 };\nprobe first = { \"values\": [Local, local, Local] };\nprobe second = { \"values\": [local] };\nASSET_BUNCH bunch = [second, first];\n";
    for(in usize unusedDeclarations : unusedCounts){
        BunchFixture fixture = BunchFixture();
        ASSERT_TRUE(ParseBunchLookupFixture(metadata, unusedDeclarations, fixture));
        const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
        {
            ExpandedAssetMetadataVector output(fixture.scratchArena);
            {
                Expected<ExpandedAssetMetadataVector> expandedResult = ExpandAssetBunch(fixture.assetRoot, s_ProjectVirtualRoot, fixture.filePath, fixture.document, fixture.scratchArena);
                ASSERT_TRUE(expandedResult.has_value());
                output = expandedResult.value();
            }
            ASSERT_EQ(output.size(), 2u);
            EXPECT_EQ(output[0u].virtualPath, Name("project/fixtures/bundle/second"));
            EXPECT_EQ(output[1u].virtualPath, Name(s_ProjectFixturesBundleFirst));
            ASSERT_TRUE(HasMetaField(output[1u].value, s_BunchValuesField));
            ASSERT_TRUE(GetMetaField(output[1u].value, s_BunchValuesField).isList());
            ASSERT_EQ(GetMetaField(output[1u].value, s_BunchValuesField).asList().size(), 3u);
            for(usize index = 0u; index < expectedIds.size(); ++index){
                ASSERT_TRUE(HasMetaField(GetMetaField(output[1u].value, s_BunchValuesField).asList()[index], s_BunchIdField));
                EXPECT_EQ(GetMetaField(GetMetaField(output[1u].value, s_BunchValuesField).asList()[index], s_BunchIdField).asInteger(), expectedIds[index]);
            }
            ASSERT_TRUE(HasMetaField(output[0u].value, s_BunchValuesField));
            ASSERT_TRUE(GetMetaField(output[0u].value, s_BunchValuesField).isList());
            ASSERT_EQ(GetMetaField(output[0u].value, s_BunchValuesField).asList().size(), 1u);
            ASSERT_TRUE(HasMetaField(GetMetaField(output[0u].value, s_BunchValuesField).asList()[0u], s_BunchIdField));
            EXPECT_EQ(GetMetaField(GetMetaField(output[0u].value, s_BunchValuesField).asList()[0u], s_BunchIdField).asInteger(), 22);
            output.clear();
        }
        EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
    }
}

void VerifyAssetBunchLookup_CanonicalDuplicateExportsAreRejectedBeforeNestedResolution(){
    Vector<usize> unusedCounts = Vector<usize>();
    unusedCounts.reserve(2u);
    unusedCounts.push_back(0u);
    unusedCounts.push_back(32u);

    const StringView metadata = "\nmetadata known;\nprobe Asset = { \"missing\": known.missing };\nprobe asset;\nasset_bunch bunch = [Asset, asset];\n";
    for(in usize unusedDeclarations : unusedCounts){
        CapturingLogger logger = CapturingLogger();
        LoggerRegistrationGuard registration(logger, s_BreakOnFatal);
        BunchFixture fixture = BunchFixture();
        ASSERT_TRUE(ParseBunchLookupFixture(metadata, unusedDeclarations, fixture));
        EXPECT_FALSE(CanExpandFixtureBunch(fixture));
        EXPECT_EQ(logger.errorCount(), 1u);
        EXPECT_TRUE(SawCapturedError(logger, "variable 'asset' is listed more than once"));
        EXPECT_FALSE(SawCapturedError(logger, "does not target a declared asset"));
    }
}

void VerifyAssetBunchLookup_LocalCycleDetectionKeepsCanonicalVariableIdentity(){
    Vector<usize> unusedCounts = Vector<usize>();
    unusedCounts.reserve(2u);
    unusedCounts.push_back(0u);
    unusedCounts.push_back(32u);

    const StringView metadata = "\nmetadata Local;\nmetadata local = { \"id\": 5 };\nLocal.next = local;\nprobe asset = { \"nested\": Local };\nasset_bunch bunch = [asset];\n";
    for(in usize unusedDeclarations : unusedCounts){
        CapturingLogger logger = CapturingLogger();
        LoggerRegistrationGuard registration(logger, s_BreakOnFatal);
        BunchFixture fixture = BunchFixture();
        ASSERT_TRUE(ParseBunchLookupFixture(metadata, unusedDeclarations, fixture));
        const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
        EXPECT_FALSE(CanExpandFixtureBunch(fixture));
        EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
        EXPECT_EQ(logger.errorCount(), 1u);
        EXPECT_TRUE(SawCapturedError(logger, "cyclic local metadata reference 'local'"));
    }
}

void VerifyAssetBunchLookup_BunchDeclarationsAreExcludedFromExportAndNestedReferenceLookup(){
    Vector<StringView> metadataCases = Vector<StringView>();
    metadataCases.reserve(2u);
    metadataCases.push_back("asset_bunch bunch; bunch = [bunch];");
    metadataCases.push_back("probe asset; ASSET_BUNCH bunch; asset.items = [bunch]; bunch = [asset];");

    Vector<usize> unusedCounts = Vector<usize>();
    unusedCounts.reserve(2u);
    unusedCounts.push_back(0u);
    unusedCounts.push_back(32u);

    for(in usize unusedDeclarations : unusedCounts){
        for(usize caseIndex = 0u; caseIndex < metadataCases.size(); ++caseIndex){
            CapturingLogger logger = CapturingLogger();
            LoggerRegistrationGuard registration(logger, s_BreakOnFatal);
            BunchFixture fixture = BunchFixture();
            ASSERT_TRUE(ParseBunchLookupFixture(metadataCases[caseIndex], unusedDeclarations, fixture));
            const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
            EXPECT_FALSE(CanExpandFixtureBunch(fixture));
            EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
            EXPECT_EQ(logger.errorCount(), 1u);
            StringView expectedDiagnostic = "reference 'bunch' does not target a declared asset";
            if(caseIndex == 0u)
                expectedDiagnostic = "item 0 references undeclared asset variable 'bunch'";
            EXPECT_TRUE(SawCapturedError(logger, expectedDiagnostic));
        }
    }
}

void VerifyAssetBunchLookup_ExportLookupKeepsFullReferenceTextAndRejectsLiteralItems(){
    Vector<StringView> metadataCases = Vector<StringView>();
    metadataCases.reserve(2u);
    metadataCases.push_back("metadata known; probe asset; asset_bunch bunch = [known.missing, asset];");
    metadataCases.push_back("probe asset; asset_bunch bunch = [\"asset\", asset];");

    Vector<usize> unusedCounts = Vector<usize>();
    unusedCounts.reserve(2u);
    unusedCounts.push_back(0u);
    unusedCounts.push_back(32u);

    for(in usize unusedDeclarations : unusedCounts){
        for(usize caseIndex = 0u; caseIndex < metadataCases.size(); ++caseIndex){
            CapturingLogger logger = CapturingLogger();
            LoggerRegistrationGuard registration(logger, s_BreakOnFatal);
            BunchFixture fixture = BunchFixture();
            ASSERT_TRUE(ParseBunchLookupFixture(metadataCases[caseIndex], unusedDeclarations, fixture));
            EXPECT_FALSE(CanExpandFixtureBunch(fixture));
            EXPECT_EQ(logger.errorCount(), 1u);
            StringView expectedDiagnostic = "item 0 must be a declared asset reference";
            if(caseIndex == 0u)
                expectedDiagnostic = "item 0 references undeclared asset variable 'known.missing'";
            EXPECT_TRUE(SawCapturedError(logger, expectedDiagnostic));
        }
    }
}

void VerifyAssetBunchLookup_NestedListFailureFollowsSourceTraversalOrder(){
    Vector<StringView> metadataCases = Vector<StringView>();
    metadataCases.reserve(2u);
    metadataCases.push_back("metadata known; metadata cycle; cycle.next = cycle; probe asset = [known.missing, cycle]; asset_bunch bunch = [asset];");
    metadataCases.push_back("metadata known; metadata cycle; cycle.next = cycle; probe asset = [cycle, known.missing]; asset_bunch bunch = [asset];");

    Vector<usize> unusedCounts = Vector<usize>();
    unusedCounts.reserve(2u);
    unusedCounts.push_back(0u);
    unusedCounts.push_back(32u);

    for(in usize unusedDeclarations : unusedCounts){
        for(usize caseIndex = 0u; caseIndex < metadataCases.size(); ++caseIndex){
            CapturingLogger logger = CapturingLogger();
            LoggerRegistrationGuard registration(logger, s_BreakOnFatal);
            BunchFixture fixture = BunchFixture();
            ASSERT_TRUE(ParseBunchLookupFixture(metadataCases[caseIndex], unusedDeclarations, fixture));
            const ArenaMemoryStats baselineMetadata = fixture.metadataArena.memoryStats();
            EXPECT_FALSE(CanExpandFixtureBunch(fixture));
            EXPECT_EQ(fixture.metadataArena.memoryStats().usedBytes, baselineMetadata.usedBytes);
            EXPECT_EQ(logger.errorCount(), 1u);
            EXPECT_EQ(SawCapturedError(logger, "does not target a declared asset"), caseIndex == 0u);
            EXPECT_EQ(SawCapturedError(logger, "cyclic local metadata reference"), caseIndex == 1u);
        }
    }
}

void VerifyAssetsGraphics_AssetCacheWritesLowercaseRelativePathSha1AndInvalidatesOnParamChange(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();

    AssetString emptySha1Hex(testArena.arena);
    AppendSha1Hex(ComputeSha1Text(""), emptySha1Hex);
    EXPECT_EQ(ViewArenaString(emptySha1Hex), "da39a3ee5e6b4b0d3255bfef95601890afd80709");
    AssetString abcSha1Hex(testArena.arena);
    AppendSha1Hex(ComputeSha1Text("abc"), abcSha1Hex);
    EXPECT_EQ(ViewArenaString(abcSha1Hex), "a9993e364706816aba3e25717850c26c9cd0d89d");

    const Expected<CookCase> cookCase = PrepareCookCase(testArena, "nwb_asset_cache_sha1_param_checksum");
    ASSERT_TRUE(cookCase.has_value());
    const CookCase prepared = cookCase.value();
    const GraphicsTestPath root = prepared.root;
    const GraphicsTestPath assetRoot = JoinGraphicsPath(root, s_AssetsDirectory);
    const GraphicsTestPath mixedCaseNwbPath = JoinGraphicsPath2(assetRoot, "Samplers", "First_Sampler.nwb");
    const Name virtualPath = s_ProjectSamplersFirstSampler;

    ASSERT_TRUE(WriteTextFile(mixedCaseNwbPath, s_LinearWrapSamplerMetadata));
    ASSERT_TRUE(BuildAndGatherWithRepoRootHelper(testArena, root, assetRoot, JoinGraphicsPath(root, "built_first"), prepared.outputDirectory));

    const Sha1Digest expectedDigest = ComputeSha1Text("assets/samplers/first_sampler.nwb");
    AssetString expectedSha1Name(testArena.arena);
    AppendSha1Hex(expectedDigest, expectedSha1Name);

    const GraphicsTestPath expectedCacheFilePath = JoinGraphicsPath2(root, s_CacheDirectory, ViewArenaString(expectedSha1Name));
    AssetBytes initialCacheBytes(testArena.arena);
    ASSERT_TRUE(ReadBinaryFile(expectedCacheFilePath, initialCacheBytes).has_value());
    const Expected<NwbAssetCacheFileHeader> initialHeaderResult = ReadNwbCacheFileHeader(initialCacheBytes);
    ASSERT_TRUE(initialHeaderResult.has_value());
    const NwbAssetCacheFileHeader initialHeader = initialHeaderResult.value();
    EXPECT_EQ(initialHeader.magic, s_NwbAssetCacheMagic);
    EXPECT_EQ(initialHeader.version, s_NwbAssetCacheVersion);
    EXPECT_NE(initialHeader.flags & s_NwbAssetCacheFlagStandalone, 0u);
    EXPECT_EQ(initialHeader.entryCount, 1u);

    // A cache written by a different producer must not be reused.
    {
        ScratchArena scratchArena(s_CodecScratchArena);
        const ExecutablePaths executablePaths = ExecutablePaths();
        const Expected<Path, ErrorCode> executablePath = executablePaths.path();
        ASSERT_TRUE(executablePath.has_value());
        Vector<u8> executableBytes = Vector<u8>();
        ASSERT_TRUE(ReadBinaryFile(executablePath.value(), executableBytes).has_value());
        const Sha256Digest producer = ComputeSha256(executableBytes);
        Sha256Digest otherProducer = producer;
        otherProducer.bytes[0u] = otherProducer.bytes[0u] ^ 1u;

        DiscoveredNwbFile discovered = MakeDiscoveredNwbFile(assetRoot, mixedCaseNwbPath, s_ProjectVirtualRoot, testArena.arena, scratchArena);
        NwbFileAssetCacheRecord originalProducer(testArena.arena);
        NwbFileAssetCacheRecord staleProducer(testArena.arena);
        ScratchString relativePath(scratchArena);
        ScratchString cacheName(scratchArena);
        PrepareCacheRecordHelper(root, discovered, s_LinearWrapSamplerMetadata, producer, scratchArena, relativePath, cacheName, originalProducer);
        PrepareCacheRecordHelper(root, discovered, s_LinearWrapSamplerMetadata, otherProducer, scratchArena, relativePath, cacheName, staleProducer);
        ASSERT_TRUE(originalProducer.canWriteCache);
        ASSERT_TRUE(staleProducer.canWriteCache);
        EXPECT_EQ(originalProducer.paramSha256, initialHeader.paramSha256);
        EXPECT_NE(staleProducer.paramSha256, originalProducer.paramSha256);

        AssetBytes staleBytes = initialCacheBytes;
        NwbAssetCacheFileHeader staleHeader = initialHeader;
        staleHeader.paramSha256 = staleProducer.paramSha256;
        ASSERT_TRUE(OverwritePOD(0u, staleHeader, staleBytes));
        ASSERT_TRUE(WriteBinaryFile(expectedCacheFilePath, staleBytes));
        ASSERT_TRUE(BuildAndGatherWithRepoRootHelper(testArena, root, assetRoot, JoinGraphicsPath(root, "built_new_producer"), JoinGraphicsPath(root, "out_new_producer")));
        AssetBytes refreshed(testArena.arena);
        ASSERT_TRUE(ReadBinaryFile(expectedCacheFilePath, refreshed).has_value());
        EXPECT_EQ(refreshed, initialCacheBytes);

        const GraphicsTestPath bunchPath = JoinGraphicsPath2(assetRoot, "Samplers", "Sidecar_Bunch.nwb");
        const GraphicsTestPath fontPath = JoinGraphicsPath2(assetRoot, "Samplers", "Sidecar_Bunch.font");
        const GraphicsTestPath texturePath = JoinGraphicsPath2(assetRoot, "Samplers", "Sidecar_Bunch.tex");
        ASSERT_TRUE(WriteTextFile(fontPath, "font-one"));
        ASSERT_TRUE(WriteTextFile(texturePath, "texture-one"));
        DiscoveredNwbFile bunch = MakeDiscoveredNwbFile(assetRoot, bunchPath, s_ProjectVirtualRoot, testArena.arena, scratchArena);
        ScratchString largeMetadata(scratchArena);
        AppendRepeatedAsciiByte(largeMetadata, 70000u, 32u);
        largeMetadata.append("ASSET_BUNCH asset; font f; texture t;");
        NwbFileAssetCacheRecord initialSidecars(testArena.arena);
        NwbFileAssetCacheRecord changedFont(testArena.arena);
        NwbFileAssetCacheRecord changedTexture(testArena.arena);
        PrepareCacheRecordHelper(root, bunch, ViewArenaString(largeMetadata), producer, scratchArena, relativePath, cacheName, initialSidecars);
        ASSERT_TRUE(initialSidecars.canWriteCache);
        ASSERT_TRUE(WriteTextFile(fontPath, "font-two"));
        PrepareCacheRecordHelper(root, bunch, ViewArenaString(largeMetadata), producer, scratchArena, relativePath, cacheName, changedFont);
        ASSERT_TRUE(changedFont.canWriteCache);
        EXPECT_NE(initialSidecars.paramSha256, changedFont.paramSha256);
        ASSERT_TRUE(WriteTextFile(texturePath, "texture-two"));
        PrepareCacheRecordHelper(root, bunch, ViewArenaString(largeMetadata), producer, scratchArena, relativePath, cacheName, changedTexture);
        ASSERT_TRUE(changedTexture.canWriteCache);
        EXPECT_NE(changedFont.paramSha256, changedTexture.paramSha256);
    }

    // Build again into a separate outputDirectory; unchanged .nwb params reuse __asset_cache/<sha1>.
    ASSERT_TRUE(BuildAndGatherWithRepoRootHelper(testArena, root, assetRoot, JoinGraphicsPath(root, "built_second"), JoinGraphicsPath(root, "out_second")));

    const Expected<SamplerAsset> cachedSampler = LoadSamplerFromOutput(JoinGraphicsPath(root, "out_second"), virtualPath, 1u, testArena);
    ASSERT_TRUE(cachedSampler.has_value());
    EXPECT_FLOAT_EQ(cachedSampler.value().description().mipBias, 0.0f);

    // Corrupt the cached payload section hash; build must reject the corrupted cache entry and repair it.
    AssetBytes corruptedCacheBytes = initialCacheBytes;
    NwbAssetCacheFileHeader corruptedHeader = initialHeader;
    corruptedHeader.payloadSectionHashFnv64 = corruptedHeader.payloadSectionHashFnv64 ^ 1u;
    ASSERT_TRUE(OverwritePOD(0u, corruptedHeader, corruptedCacheBytes));
    ASSERT_TRUE(WriteBinaryFile(expectedCacheFilePath, corruptedCacheBytes));
    ASSERT_TRUE(BuildAndGatherWithRepoRootHelper(testArena, root, assetRoot, JoinGraphicsPath(root, "built_repaired"), JoinGraphicsPath(root, "out_repaired")));
    AssetBytes repairedCacheBytes(testArena.arena);
    ASSERT_TRUE(ReadBinaryFile(expectedCacheFilePath, repairedCacheBytes).has_value());
    EXPECT_EQ(repairedCacheBytes, initialCacheBytes);

    // A corrupt count must be rejected before reserving memory.
    corruptedHeader = initialHeader;
    corruptedHeader.entryCount = u32.max;
    corruptedCacheBytes = initialCacheBytes;
    ASSERT_TRUE(OverwritePOD(0u, corruptedHeader, corruptedCacheBytes));
    ASSERT_TRUE(WriteBinaryFile(expectedCacheFilePath, corruptedCacheBytes));
    ASSERT_TRUE(BuildAndGatherWithRepoRootHelper(testArena, root, assetRoot, JoinGraphicsPath(root, "built_bad_count"), JoinGraphicsPath(root, "out_bad_count")));
    ASSERT_TRUE(ReadBinaryFile(expectedCacheFilePath, repairedCacheBytes).has_value());
    EXPECT_EQ(repairedCacheBytes, initialCacheBytes);

    // Modify .nwb parameter; checksum changes and invalidates __asset_cache/<sha1>.
    ASSERT_TRUE(WriteTextFile(mixedCaseNwbPath, s_ModifiedSamplerCacheMetadata));
    ASSERT_TRUE(BuildAndGatherWithRepoRootHelper(testArena, root, assetRoot, JoinGraphicsPath(root, "built_third"), JoinGraphicsPath(root, "out_third")));

    AssetBytes updatedCacheBytes(testArena.arena);
    ASSERT_TRUE(ReadBinaryFile(expectedCacheFilePath, updatedCacheBytes).has_value());
    const Expected<NwbAssetCacheFileHeader> updatedHeader = ReadNwbCacheFileHeader(updatedCacheBytes);
    ASSERT_TRUE(updatedHeader.has_value());
    EXPECT_NE(updatedHeader.value().paramSha256, initialHeader.paramSha256);

    const Expected<SamplerAsset> updatedSampler = LoadSamplerFromOutput(JoinGraphicsPath(root, "out_third"), virtualPath, 1u, testArena);
    ASSERT_TRUE(updatedSampler.has_value());
    EXPECT_FLOAT_EQ(updatedSampler.value().description().mipBias, 3.5f);
    EXPECT_EQ(logger.errorCount(), 0u);
    EXPECT_TRUE(RemoveAllIfExists(root));
}


