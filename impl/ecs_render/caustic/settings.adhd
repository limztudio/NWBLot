native{
namespace NWB::Impl{
using MutableSceneLightGpuDataSpan = Span<SceneLightGpuData>;
};
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CausticLightEligible(in SceneLightGpuData light){
    return light.params.y < s_LightTypeDirectionalMax || light.params.y > s_LightTypePointMax;
}

b8 CausticLightEnabled(in SceneLightGpuData light){
    return light.params.w >= s_CausticSlotEnabledThreshold;
}

u32 SelectNextCausticSlotLightIndex(in Span<SceneLightGpuData> lights, in Span<f32> causticImportance){
    const u32 lightCount = cast<u32>(lights.size());
    f32 bestImportance = -1.0f;
    u32 bestIndex = lightCount;
    for(u32 i = 0u; i < lightCount && i < cast<u32>(causticImportance.size()); ++i){
        if(lights[i].params.w >= 0.0f)
            continue;
        if(!CausticLightEnabled(lights[i]))
            continue;
        if(!CausticLightEligible(lights[i]))
            continue;
        const f32 importance = causticImportance[i];
        if(importance > bestImportance){
            bestImportance = importance;
            bestIndex = i;
        }
    }
    return bestIndex;
}

u32 AssignCausticLightSlots(
    in Span<f32> causticImportance,
    in u32 refractiveInstanceCount,
    mut MutableSceneLightGpuDataSpan lights
){
    const u32 lightCount = cast<u32>(lights.size());
    if(refractiveInstanceCount == 0u || lightCount == 0u || causticImportance.size() < cast<usize>(lightCount))
        return 0u;

    // Importance-ranked caustic slots (mirrors shadow selection). Highest eligible light per slot; points never qualify.
    u32 assignedCount = 0u;
    for(u32 slot = 0u; slot < s_SceneCausticSlotCount; ++slot){
        f32 bestImportance = -1.0f;
        u32 bestIndex = lightCount;
        for(u32 i = 0u; i < lightCount && i < cast<u32>(causticImportance.size()); ++i){
            const SceneLightGpuData light = lights[cast<usize>(i)];
            if(light.params.w >= 0.0f)
                continue;
            if(!CausticLightEnabled(light))
                continue;
            if(!CausticLightEligible(light))
                continue;
            const f32 importance = causticImportance[cast<usize>(i)];
            if(importance > bestImportance){
                bestImportance = importance;
                bestIndex = i;
            }
        }
        if(bestIndex >= lightCount)
            break;
        lights[cast<usize>(bestIndex)].params.w = cast<f32>(slot);
        ++assignedCount;
    }

    return assignedCount;
}

b8 ValidateCausticQualitySettings(in CausticQualitySettings settings){
    return settings.photonGridDivisor == 1u || settings.photonGridDivisor == s_CausticHalfPhotonGridDivisor || settings.photonGridDivisor == s_CausticQuarterPhotonGridDivisor;
}

// Callers supply validated settings, a supported base grid, and the current 1/2 temporal phase count.
CausticPhotonBudget MakeCausticPhotonBudget(in CausticQualitySettings settings, in u32 baseGridSide, in u32 temporalPhaseCount){
    assert(ValidateCausticQualitySettings(settings));
    assert(baseGridSide == s_CausticReducedBaseGridSide || baseGridSide == s_CausticFullBaseGridSide);
    assert(temporalPhaseCount == s_CausticTemporalDisabledPhaseCount || temporalPhaseCount == s_CausticTemporalPhaseCount);
    CausticPhotonBudget budget;
    budget.gridSide = baseGridSide / settings.photonGridDivisor;
    budget.fullGridCount = budget.gridSide * budget.gridSide;
    budget.photonsPerFrame = budget.fullGridCount / temporalPhaseCount;
    return budget;
}

CausticPhotonPushConstants ResolveCausticPhotonPushConstants(
    in u32 width,
    in u32 height,
    in u32 instanceCount,
    in CausticPhotonBudget photonBudget,
    in u32 emissionTargetCount,
    in u32 frameIndex,
    in u32 depthSlot,
    in u32 worldPositionSlot,
    in u32 emissionTargetSlot,
    in u32 viewSlot,
    in u32 deferredResourcesHeapSlot,
    in u32 materialContextSlotsHeapSlot,
    in u32 accumulatorStorageSlot,
    in u32 temporalPhaseCount
){
    CausticPhotonPushConstants pushConstants;
    pushConstants.width = width;
    pushConstants.height = height;
    pushConstants.instanceCount = instanceCount;
    pushConstants.photonCount = photonBudget.photonsPerFrame;
    pushConstants.emissionTargetCount = emissionTargetCount;
    pushConstants.gridSide = photonBudget.gridSide;
    pushConstants.frameIndex = frameIndex;
    pushConstants.depthSlot = depthSlot;
    pushConstants.worldPositionSlot = worldPositionSlot;
    pushConstants.emissionTargetSlot = emissionTargetSlot;
    pushConstants.viewSlot = viewSlot;
    pushConstants.deferredResourcesHeapSlot = deferredResourcesHeapSlot;
    pushConstants.materialContextSlotsHeapSlot = materialContextSlotsHeapSlot;
    pushConstants.accumulatorStorageSlot = accumulatorStorageSlot;
    pushConstants.temporalPhaseCount = temporalPhaseCount;
    return pushConstants;
}

Expected<CausticResolveActivityLayout> TryResolveCausticActivityLayout(in u32 halfWidth, in u32 halfHeight){
    if(halfWidth == 0u || halfHeight == 0u || halfWidth > s_RtMaxI32AsU32 || halfHeight > s_RtMaxI32AsU32)
        return makeUnexpected(Failure());
    const u32 tilesX = divideUp(halfWidth, s_CausticResolveGroupSize);
    const u32 tilesY = divideUp(halfHeight, s_CausticResolveGroupSize);
    const u64 byteSize = cast<u64>(tilesX) * cast<u64>(tilesY) * 4ull;
    if(byteSize > s_MeshAddressableBytes)
        return makeUnexpected(Failure());
    CausticResolveActivityLayout outLayout;
    outLayout.bufferByteSize = byteSize;
    outLayout.tilesX = tilesX;
    outLayout.tilesY = tilesY;
    return outLayout;
}

f32 EffectiveCausticIntensity(in f32 decay){
    if(decay > 0.0f)
        return s_CausticIntensity * (1.0f - decay);
    return s_CausticIntensity;
}

CausticResolvePushConstants ResolveCausticResolvePushConstants(
    in u32 width,
    in u32 height,
    in f32 causticIntensity,
    in u32 stepWidth,
    in CausticResolveStage stage,
    in u32 worldPositionSlot,
    in u32 depthSlot,
    in u32 inputColorSlot,
    in u32 geometrySlot,
    in u32 accumulatorSlot,
    in u32 outputStorageSlot,
    in u32 activityInputSlot,
    in u32 activityOutputSlot
){
    CausticResolvePushConstants resolvePush;
    resolvePush.width = width;
    resolvePush.height = height;
    resolvePush.halfWidth = divideUpWrappingU32(width, 2u);
    resolvePush.halfHeight = divideUpWrappingU32(height, 2u);
    resolvePush.causticIntensity = causticIntensity;
    resolvePush.stepWidth = stepWidth;
    resolvePush.stage = cast<u32>(stage);
    resolvePush.worldPositionSlot = worldPositionSlot;
    resolvePush.depthSlot = depthSlot;
    resolvePush.inputColorSlot = inputColorSlot;
    resolvePush.geometrySlot = geometrySlot;
    resolvePush.accumulatorSlot = accumulatorSlot;
    resolvePush.outputStorageSlot = outputStorageSlot;
    resolvePush.activityInputSlot = activityInputSlot;
    resolvePush.activityOutputSlot = activityOutputSlot;
    return resolvePush;
}

CausticResolveActivitySlots ResolveCausticActivitySlots(
    in CausticResolveStage stage,
    in u32 waveletPassIndex,
    in u32 resolvePassCount,
    in b8 usesActivity,
    in u32 descriptorSlot0,
    in u32 descriptorSlot1
){
    CausticResolveActivitySlots slots;
    if(!usesActivity)
        return slots;

    u32 activityPassIndex = resolvePassCount + 1u;
    if(stage == CausticResolveStage::Wavelet)
        activityPassIndex = waveletPassIndex + 1u;
    else if(stage == CausticResolveStage::PrepareDownsample)
        activityPassIndex = 0u;

    if(activityPassIndex > 0u){
        if(((activityPassIndex - 1u) % 2u) == 0u)
            slots.inputSlot = descriptorSlot0;
        else
            slots.inputSlot = descriptorSlot1;
    }
    if(activityPassIndex <= resolvePassCount){
        if((activityPassIndex % 2u) == 0u)
            slots.outputSlot = descriptorSlot0;
        else
            slots.outputSlot = descriptorSlot1;
    }
    return slots;
}

CausticGeometryDownsamplePushConstants MakeCausticGeometryDownsamplePushConstants(
    in u32 width,
    in u32 height,
    in u32 halfWidth,
    in u32 halfHeight,
    in u32 worldPositionSlot,
    in u32 depthSlot,
    in u32 outputStorageSlot
){
    CausticGeometryDownsamplePushConstants push;
    push.width = width;
    push.height = height;
    push.halfWidth = halfWidth;
    push.halfHeight = halfHeight;
    push.worldPositionSlot = worldPositionSlot;
    push.depthSlot = depthSlot;
    push.outputStorageSlot = outputStorageSlot;
    return push;
}

CausticAccumulatorDecayPushConstants MakeCausticAccumulatorDecayPushConstants(
    in u32 width,
    in u32 height,
    in f32 decayFactor,
    in u32 accumulatorStorageSlot
){
    CausticAccumulatorDecayPushConstants push;
    push.width = width;
    push.height = height;
    push.decayFactor = decayFactor;
    push.accumulatorStorageSlot = accumulatorStorageSlot;
    return push;
}

void ResolveCausticLocalBounds(
    in b8 isRuntime,
    mut VectorSingle inOutLocalMin,
    mut VectorSingle inOutLocalMax
){
    if(!isRuntime)
        return;
    const VectorSingle center = (inOutLocalMin + inOutLocalMax) * VectorSingle(s_CausticBoundsMidpointWeight);
    const VectorSingle half = (inOutLocalMax - inOutLocalMin) * VectorSingle(s_CausticBoundsMidpointWeight * s_CausticRuntimeBoundsInflation);
    inOutLocalMin = center - half;
    inOutLocalMax = center + half;
}

NwbCausticEmissionTargetGpu MakeCausticEmissionTarget(
    in VectorSingle worldMin,
    in VectorSingle worldMax,
    mut VectorSingle inOutCombinedMin,
    mut VectorSingle inOutCombinedMax
){
    inOutCombinedMin = min(inOutCombinedMin, worldMin);
    inOutCombinedMax = max(inOutCombinedMax, worldMax);
    NwbCausticEmissionTargetGpu target;
    target.aabbMin = f32x4(worldMin, 0.0f);
    target.aabbMax = f32x4(worldMax, 0.0f);
    return target;
}

void RecordUnsupportedCausticVolume(
    in u32 entityId,
    in OpticalBoundaryMode boundaryMode,
    mut u32 inOutFirstEntity,
    mut u32 inOutCount,
    mut u64 inOutHash
){
    if(boundaryMode == OpticalBoundaryMode::ClosedNested || boundaryMode == OpticalBoundaryMode::ClosedPriority)
        return;
    if(inOutCount == 0u)
        inOutFirstEntity = entityId;
    ++inOutCount;
    inOutHash = updateFnv64U32(inOutHash, entityId);
    inOutHash = updateFnv64Byte(inOutHash, cast<u8>(boundaryMode));
}

const usize s_CausticEmissionTargetGpuBytes = 32u;

b8 ValidatePreparedCausticEmissionTargetUploadState(
    in u32 targetCount,
    in usize preparedByteSize,
    in b8 hasBuffer,
    in u32 capacity,
    in b8 heapHandleValid,
    in b8 isStorageBufferClass,
    mut usize outTargetByteCount
){
    const usize targetByteCount = cast<usize>(targetCount) * s_CausticEmissionTargetGpuBytes;
    if(
        preparedByteSize != targetByteCount
        || !hasBuffer
        || capacity < targetCount
        || !heapHandleValid
        || !isStorageBufferClass
    ){
        error("RendererSystem: frozen caustic emission-target payload no longer matches preflight storage");
        return false;
    }
    outTargetByteCount = targetByteCount;
    return true;
}

void CaptureCausticEmissionTargetsBytes(
    in Span<NwbCausticEmissionTargetGpu> targets,
    mut Vector<u8> outPreparedBytes,
    mut u32 outRefractiveInstanceCount
){
    const usize targetByteCount = targets.size() * s_CausticEmissionTargetGpuBytes;
    outPreparedBytes.clear();
    outPreparedBytes.reserve(targetByteCount);
    for(in NwbCausticEmissionTargetGpu target : targets)
        AppendPOD(outPreparedBytes, target);
    outRefractiveInstanceCount = cast<u32>(targets.size());
}

void LogCausticProducerDispatchIfNeeded(
    in StringView routeLabel,
    in CausticPhotonBudget photonBudget,
    in u32 temporalPhaseCount,
    in u32 causticLightCount,
    in u32 causticRefractiveInstanceCount,
    mut b8 inOutDispatchLogged
){
    if(inOutDispatchLogged)
        return;
    inOutDispatchLogged = true;
    [essential]
    info(
        "RendererSystem: dispatched {} caustic producer ({} photons/frame, {} temporal phases, {} full-grid budget, {} caustic lights, {} refractive instances)",
        routeLabel,
        cast<u64>(photonBudget.photonsPerFrame),
        cast<u64>(temporalPhaseCount),
        cast<u64>(photonBudget.fullGridCount),
        cast<u64>(causticLightCount),
        cast<u64>(causticRefractiveInstanceCount)
    );
}


