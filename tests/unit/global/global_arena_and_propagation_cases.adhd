usize SelectedLength(in b8 useShort, in usize shortLength, in usize longLength){
    if(useShort)
        return shortLength;
    return longLength;
}

ConcurrentVector ConstructVector(in b8 withAllocator, mut ConcurrentVector source, mut HeapStorage owner){
    if(withAllocator)
        return MoveContainerTo<ConcurrentVector>(source, owner);
    return MoveContainer<ConcurrentVector>(source);
}

b8 CheckAllocatorSelfAssignment<AllocatorT>(in Name owner){
    HeapStorage arena(owner);
    AllocatorT allocator(arena);
    mut AllocatorT sameAllocator = allocator;
    allocator = sameAllocator;
    return AllocatorUsesStorage(allocator, arena);
}

void VerifyVectorMove<VectorT>(in b8 foreignArena, in usize targetSize){
    HeapStorage sourceArena(s_GlobalArenaCaseAllocatorPropagationVectorSource);
    HeapStorage targetArena(s_GlobalArenaCaseAllocatorPropagationVectorTarget);
    {
        ContainerInstance<VectorT, u32> target = MakeContainer<VectorT>(SelectStorage(foreignArena, sourceArena, targetArena));
        for(usize index = 0u; index < targetSize; ++index)
            target.push_back(99u);
        {
            ContainerInstance<VectorT, u32> source = MakeContainer<VectorT>(sourceArena);
            for(u32 index = 0u; index < 128u; ++index)
                source.push_back(index);
            const usize firstElement = TestValueAddress<u32>(source[0u]);
            TestMoveAssign(target, source);
            EXPECT_TRUE(TestUsesStorage(target, sourceArena));
            ASSERT_EQ(target.size(), 128u);
            EXPECT_EQ(TestValueAddress<u32>(target[0u]), firstElement);
            EXPECT_TRUE(source.empty());
            source.push_back(7u);
            EXPECT_EQ(source[0u], 7u);
        }
        for(u32 index = 0u; index < 128u; ++index)
            EXPECT_EQ(target[index], index);
        target.push_back(128u);
        EXPECT_EQ(target[128u], 128u);
    }
    EXPECT_EQ(sourceArena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(sourceArena.memoryStats().reservedBytes, 0u);
    EXPECT_EQ(targetArena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(targetArena.memoryStats().reservedBytes, 0u);
    EXPECT_EQ(sourceArena.memoryStats().allocationCount, sourceArena.memoryStats().deallocationCount);
    EXPECT_EQ(targetArena.memoryStats().allocationCount, targetArena.memoryStats().deallocationCount);
}

void VerifyStringMove<StringT>(in b8 foreignArena, in b8 shortSource){
    HeapStorage sourceArena(s_GlobalArenaCaseAllocatorPropagationStringSource);
    HeapStorage targetArena(s_GlobalArenaCaseAllocatorPropagationStringTarget);
    {
        ContainerInstance<StringT, NarrowChar> target = MakeContainer<StringT>(SelectStorage(foreignArena, sourceArena, targetArena));
        target.assign(96u, 'z');
        {
            ContainerInstance<StringT, NarrowChar> source = MakeContainer<StringT>(sourceArena);
            source.assign(SelectedLength(shortSource, 3u, 192u), 'a');
            const usize sourceStorage = TestDataAddress(source);
            TestMoveAssign(target, source);
            EXPECT_TRUE(TestUsesStorage(target, sourceArena));
            EXPECT_EQ(target.size(), SelectedLength(shortSource, 3u, 192u));
            if(!shortSource)
                EXPECT_EQ(TestDataAddress(target), sourceStorage);
            EXPECT_TRUE(source.empty());
            source.assign(48u, 'b');
        }
        for(in NarrowChar character : target)
            EXPECT_EQ(character, 'a');
        target.append(257u, 'c');
        EXPECT_EQ(target.back(), 'c');
    }
    EXPECT_EQ(sourceArena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(targetArena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(sourceArena.memoryStats().allocationCount, sourceArena.memoryStats().deallocationCount);
    EXPECT_EQ(targetArena.memoryStats().allocationCount, targetArena.memoryStats().deallocationCount);
}

void VerifyVectorSwap<VectorT>(in b8 foreignArena){
    HeapStorage firstArena(s_GlobalArenaCaseAllocatorPropagationVectorSwapFirst);
    HeapStorage secondArena(s_GlobalArenaCaseAllocatorPropagationVectorSwapSecond);
    mut HeapStorage secondOwner = SelectStorage(foreignArena, firstArena, secondArena);
    {
        ContainerInstance<VectorT, u32> first = MakeContainer<VectorT>(firstArena);
        ContainerInstance<VectorT, u32> second = MakeContainer<VectorT>(secondOwner);
        for(u32 index = 0u; index < 64u; ++index)
            first.push_back(index);
        for(u32 index = 0u; index < 96u; ++index)
            second.push_back(index + 100u);
        const usize firstStorage = TestValueAddress<u32>(first[0u]);
        const usize secondStorage = TestValueAddress<u32>(second[0u]);
        first.swap(second);
        EXPECT_TRUE(TestUsesStorage(first, secondOwner));
        EXPECT_TRUE(TestUsesStorage(second, firstArena));
        ASSERT_EQ(first.size(), 96u);
        ASSERT_EQ(second.size(), 64u);
        EXPECT_EQ(TestValueAddress<u32>(first[0u]), secondStorage);
        EXPECT_EQ(TestValueAddress<u32>(second[0u]), firstStorage);
        for(u32 index = 0u; index < 96u; ++index)
            EXPECT_EQ(first[index], index + 100u);
        for(u32 index = 0u; index < 64u; ++index)
            EXPECT_EQ(second[index], index);
        first.push_back(777u);
        second.push_back(888u);
        SwapContainers(first, second);
        EXPECT_TRUE(TestUsesStorage(first, firstArena));
        EXPECT_TRUE(TestUsesStorage(second, secondOwner));
        EXPECT_EQ(first.back(), 888u);
        EXPECT_EQ(second.back(), 777u);
    }
    EXPECT_EQ(firstArena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(secondArena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(firstArena.memoryStats().reservedBytes, 0u);
    EXPECT_EQ(secondArena.memoryStats().reservedBytes, 0u);
    EXPECT_EQ(firstArena.memoryStats().allocationCount, firstArena.memoryStats().deallocationCount);
    EXPECT_EQ(secondArena.memoryStats().allocationCount, secondArena.memoryStats().deallocationCount);
}

void VerifyStringSwap<StringT>(in b8 foreignArena, in b8 shortFirst){
    HeapStorage firstArena(s_GlobalArenaCaseAllocatorPropagationStringSwapFirst);
    HeapStorage secondArena(s_GlobalArenaCaseAllocatorPropagationStringSwapSecond);
    mut HeapStorage secondOwner = SelectStorage(foreignArena, firstArena, secondArena);
    {
        ContainerInstance<StringT, NarrowChar> first = MakeContainer<StringT>(firstArena);
        ContainerInstance<StringT, NarrowChar> second = MakeContainer<StringT>(secondOwner);
        first.assign(SelectedLength(shortFirst, 3u, 96u), 'a');
        second.assign(64u, 'b');
        const usize firstStorage = TestDataAddress(first);
        const usize secondStorage = TestDataAddress(second);
        first.swap(second);
        EXPECT_TRUE(TestUsesStorage(first, secondOwner));
        EXPECT_TRUE(TestUsesStorage(second, firstArena));
        EXPECT_EQ(TestDataAddress(first), secondStorage);
        if(!shortFirst)
            EXPECT_EQ(TestDataAddress(second), firstStorage);
        ASSERT_EQ(first.size(), 64u);
        ASSERT_EQ(second.size(), SelectedLength(shortFirst, 3u, 96u));
        for(in NarrowChar character : first)
            EXPECT_EQ(character, 'b');
        for(in NarrowChar character : second)
            EXPECT_EQ(character, 'a');
        first.append(128u, 'c');
        second.append(128u, 'd');
        EXPECT_EQ(first.back(), 'c');
        EXPECT_EQ(second.back(), 'd');
    }
    EXPECT_EQ(firstArena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(secondArena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(firstArena.memoryStats().allocationCount, firstArena.memoryStats().deallocationCount);
    EXPECT_EQ(secondArena.memoryStats().allocationCount, secondArena.memoryStats().deallocationCount);
}


