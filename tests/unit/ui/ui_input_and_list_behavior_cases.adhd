    ASSERT_TRUE(self.commitSingle(target, 2u));
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    target.enabled = false;
    ASSERT_TRUE(self.commitSingle(target, 3u));
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.hitTest(Point(15.0f, 15.0f)).valid());
}

void VerifyUiInputTests_InvalidatedDeclarationPrunesActionsAndCaptureWithoutAdvancingLayout(mut UiInputTests self){
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = MakeUiInputTarget(1u);
    targets[1u] = MakeUiInputTargetAt(2u, Rect(40.0f, 10.0f, 20.0f, 20.0f));
    ASSERT_TRUE(self.commitSpan(targets, 7u));
    self.click();
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Space, false)).commandConsumed);
    self.m_router.invalidateTarget(targets[0u].id);
    EXPECT_EQ(self.m_router.layoutGeneration(), 7u);
    ASSERT_EQ(self.m_router.targets().size(), 1u);
    EXPECT_EQ(self.m_router.targets()[0u].id.value, 2u);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_FALSE(self.m_router.hitTest(Point(15.0f, 15.0f)).valid());
    EXPECT_EQ(self.m_router.hitTest(Point(45.0f, 15.0f)).value, 2u);
    EXPECT_TRUE(self.send(MakeUiInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiInputKey(InputEventType::KeyUp, CoreKey::Space, false)).commandConsumed);
}

void VerifyUiInputTests_PanelBlocksPointerAndClearsKeyboardFocusWithoutActivating(mut UiInputTests self){
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = MakeUiInputTarget(1u);
    targets[1u] = MakeUiInputTargetAt(2u, Rect(40.0f, 10.0f, 20.0f, 20.0f));
    targets[1u].focusable = false;
    targets[1u].activatable = false;
    ASSERT_TRUE(self.commitSpan(targets, 1u));
    self.click();
    ASSERT_EQ(self.m_router.focus().value, 1u);
    ASSERT_TRUE(self.m_router.consumeActivation(targets[0u].id));
    const InputRoutingResult panel = self.send(MakeUiInputPointerAt(InputEventType::PrimaryDown, Point(45.0f, 15.0f)));
    EXPECT_TRUE(panel.pointerConsumed);
    EXPECT_FALSE(panel.focus.valid());
    EXPECT_EQ(panel.capture.value, 2u);
    EXPECT_TRUE(self.send(MakeUiInputPointerAt(InputEventType::PrimaryUp, Point(45.0f, 15.0f))).pointerConsumed);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyDown, CoreKey::Enter, false)).commandConsumed);
    EXPECT_FALSE(self.send(MakeUiInputKey(InputEventType::KeyUp, CoreKey::Enter, false)).commandConsumed);
