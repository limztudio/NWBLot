void SetCsgShadowModeEnvironment(in StringView name, in StringView value, in b8 hasValue){
    String nameCopy = String(name);
    String valueCopy = String(value);
    i32 status = -1;
    native(in nameCopy, in valueCopy, in hasValue, mut status){
        status = NWB::Tests::Smoke::SetSmokeTestEnvironment(nameCopy.c_str(), hasValue ? valueCopy.c_str() : nullptr);
    }
    ASSERT_EQ(status, 0);
}

void VerifyCsgShadowModeRejectsIncompatibleAtlasCombinations(){
    SetCsgShadowModeEnvironment("NWB_CSG_SHADOW_ARM", "", false);
    SetCsgShadowModeEnvironment("NWB_CSG_SHADOW_LIGHT", "", false);
    SetCsgShadowModeEnvironment("NWB_CSG_SHADOW_LIGHT_SOURCE", "", false);
    SetCsgShadowModeEnvironment("NWB_CSG_SHADOW_ATLAS", "open", true);
    SetCsgShadowModeEnvironment("NWB_CSG_SHADOW_OPEN_CASE", "", false);
    CsgShadowMode initial = CsgShadowMode();
    EXPECT_FALSE(initial.read(false));

    SetCsgShadowModeEnvironment("NWB_CSG_SHADOW_OPEN_CASE", "boundary64", true);
    CsgShadowMode open = CsgShadowMode();
    ASSERT_TRUE(open.read(false));
    EXPECT_EQ(open.openCase, CsgShadowOpenCase::Boundary64);
    EXPECT_EQ(open.openCaseName(), StringView("boundary64"));
    CsgShadowMode openCaustic = CsgShadowMode();
    EXPECT_FALSE(openCaustic.read(true));

    SetCsgShadowModeEnvironment("NWB_CSG_SHADOW_LIGHT", "point", true);
    CsgShadowMode openPoint = CsgShadowMode();
    EXPECT_FALSE(openPoint.read(false));
    SetCsgShadowModeEnvironment("NWB_CSG_SHADOW_LIGHT", "directional", true);
    SetCsgShadowModeEnvironment("NWB_CSG_SHADOW_LIGHT_SOURCE", "finite", true);
    CsgShadowMode openFinite = CsgShadowMode();
    EXPECT_FALSE(openFinite.read(false));
    SetCsgShadowModeEnvironment("NWB_CSG_SHADOW_LIGHT_SOURCE", "hard", true);
    SetCsgShadowModeEnvironment("NWB_CSG_SHADOW_OPEN_CASE", "unknown", true);
    CsgShadowMode openUnknown = CsgShadowMode();
    EXPECT_FALSE(openUnknown.read(false));

    SetCsgShadowModeEnvironment("NWB_CSG_SHADOW_ATLAS", "analytic", true);
    SetCsgShadowModeEnvironment("NWB_CSG_SHADOW_ARM", "uncut", true);
    CsgShadowMode analyticUncut = CsgShadowMode();
    EXPECT_TRUE(analyticUncut.read(false));
    SetCsgShadowModeEnvironment("NWB_CSG_SHADOW_ARM", "moved", true);
    CsgShadowMode analyticMoved = CsgShadowMode();
    EXPECT_FALSE(analyticMoved.read(false));
    SetCsgShadowModeEnvironment("NWB_CSG_SHADOW_ARM", "invalid", true);
    CsgShadowMode analyticInvalid = CsgShadowMode();
    EXPECT_FALSE(analyticInvalid.read(false));
}

NWB_ADHD_GTEST(CsgShadowMode, RejectsIncompatibleAtlasCombinations, VerifyCsgShadowModeRejectsIncompatibleAtlasCombinations)


