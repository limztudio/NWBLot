[extensible]
class WidgetFixture{
    public Font m_font = Font(Name("tests/ui/fonts/latin"));
    public TextService m_text;
    public SharedPool pool = SharedPool();
    public UiSkin m_skin = UiSkin(Name("tests/ui/skin"));
    public PaintBuilder m_paint;
    public Context m_context;
    public Builder m_builder;
    public WidgetRoot m_root;
    public u64 m_skinGeneration = 1u;

    public WidgetFixture(){
        this.m_builder = Builder(this.m_context, this.m_paint, this.m_text);
        this.m_root.value = 86u;
        this.m_root.generation = 2u;
    }

    public void setup(){ this.setUpWidgetBase(); }
    public void setUpWidgetBase(){
        ASSERT_TRUE(InstallLatinFixtureFont(this.m_font, this.m_text));
        this.configureSkin();
        ASSERT_TRUE(this.m_skin.validatePayload());
        this.m_builder.setSkin(this.m_skin);
        this.m_builder.style().fontSize = 14.0f;
    }

    public void configureSkin(){ this.configureSkin(""); }
    public void configureSkin(in StringView omitted){
        Vector<UiSkinRegion> regions;
        const Array<StringView, 11u> names("window.normal", "window.title", "window.collapse", "white", "separator", "panel.normal",
            "button.normal", "button.hover", "button.pressed", "button.disabled", "focus.overlay");
        for(u32 index = 0u; index < names.size(); ++index){
            if(names[index] == omitted)
                continue;
            UiSkinRegion region;
            const auto regionName = ParseName(names[index]);
            ASSERT_TRUE(regionName.has_value());
            region.name = regionName.value();
            region.rectangle.x = index * 8u;
            region.rectangle.width = 8u;
            region.rectangle.height = 8u;
            if(index == 0u || index == 5u)
                region.padding = MakeFixtureSkinInsets(3.0f, 4.0f, 5.0f, 6.0f);
            else if(index == 1u)
                region.padding = MakeFixtureSkinInsets(5.0f, 6.0f, 7.0f, 8.0f);
            else if(index == 4u){
                region.minimumWidth = 2.0f;
                region.minimumHeight = 3.0f;
            }
            else if(index >= 6u && index <= 9u){
                region.padding = MakeFixtureSkinInsets(2.0f, 3.0f, 4.0f, 5.0f);
                region.minimumWidth = 30.0f;
                region.minimumHeight = 24.0f;
            }
            regions.push_back(region);
        }
        this.m_skin.setAtlas(AssetRef<Texture>("tests/ui/texture"), 128u, 16u, 1.0f, regions);
    }

    public b8 begin(in u64 generation){
        DisplayMetrics display;
        display.logicalWidth = 800.0f;
        display.logicalHeight = 600.0f;
        display.pixelScaleX = 1.0f;
        display.pixelScaleY = 1.0f;
        return this.begin(generation, display);
    }
    public b8 begin(in u64 generation, in DisplayMetrics display){ return BeginWidgetFixtureFrame(this, generation, display); }
    public b8 finishWindow(){ return this.m_builder.endWindow() && this.m_context.endRoot() && this.m_context.finishFrame(); }
    public b8 panel(in u64 generation){ return this.panel(generation, "panel"); }
    public b8 panel(in u64 generation, in StringView key){ return this.panel(generation, key, Rect(10.0f, 10.0f, 360.0f, 400.0f)); }
    public b8 panel(in u64 generation, in StringView key, in Rect bounds){ return this.begin(generation) && this.m_builder.beginPanel(key, bounds); }
    public b8 finishRoot(){ return this.m_context.endRoot() && this.m_context.finishFrame(); }
    public b8 finishPanel(){ return this.m_builder.endPanel() && this.finishRoot(); }
    public WidgetId parentId()const{ return RequireUiWidgetId(RequireUiRootId(this.m_root), s_ParentPopupKey); }
    public WidgetId childId()const{ return RequireUiWidgetId(this.parentId(), s_ChildPopupKey); }
    public WidgetId id(in StringView child)const{ return this.id(child, "window"); }
    public WidgetId id(in StringView child, in StringView parent)const{ return RequireUiWidgetId(RequireUiWidgetId(RequireUiRootId(this.m_root), parent), child); }
    public Optional<in HitTarget> target(in WidgetId widget)const{ return FindHitTarget(this.m_context.input().targets(), widget); }
    public b8 hasTarget(in WidgetId widget)const{ return this.target(widget).has_value(); }
    public Expected<HitTarget> tryTarget(in WidgetId widget)const{ return TryFindHitTarget(this.m_context.input().targets(), widget); }
    public void setEditHost(mut IEditBoxHost host){ this.m_builder.setEditHost(host); }
    public void clearEditHost(){ this.m_builder.clearEditHost(); }
    public InputRoutingResult send(in InputEvent event){ return SendWidgetFixtureEvent(this, event); }
    public void click(in Point point){ ClickWidgetFixturePoint(this, point); }
    public void drag(in Point origin, in Point destination){ DragWidgetFixturePoints(this, origin, destination); }
    public void press(in KeyEnum value){ this.press(value, false, false); }
    public void press(in KeyEnum value, in b8 repeat){ this.press(value, repeat, false); }
    public void press(in KeyEnum value, in b8 repeat, in b8 shift){ PressWidgetFixtureKey(this, value, repeat, shift); }
    public Expected<UiFixtureSkinPaintSample> sampleSkinPaint(in DrawSnapshot snapshot, in Name name)const{
        const Expected<UiSkinRegion> region = this.m_skin.tryFindRegion(name);
        if(!region.has_value())
            return MakeUnexpected(region.error());
        return SampleUiSkinRegionPaint(region.value(), this.m_skin.atlasWidth(), this.m_skin.atlasHeight(), snapshot);
    }
    public b8 installKoreanFallback(){
        Font korean(Name("tests/ui/fonts/korean"));
        if(!LoadBundledFixtureFont("korean.font", korean))
            return false;
        const Array<FontSource, 2u> sources(FontSource(MakeUiFixtureAssetRef<Font>(s_TestLatinFontPath), this.m_font, 1u), FontSource(MakeUiFixtureAssetRef<Font>(s_TestKoreanFontPath), korean, 1u));
        return this.m_text.setFonts(sources);
    }
    public Expected<Rect> skinQuad(in DrawSnapshot snapshot, in u32 slot)const{ return FindUiSkinSlotQuad(snapshot, slot); }
    public void expectAccepted<const usize Capacity>(in UiFixtureAcceptedInputState<Capacity> saved)const{
        ExpectAcceptedInput<Capacity>(this.m_context.input(), saved, true, false, false, true);
    }
}


