class UiEditSeamMergeCase{
    public StringView text = "";
    public usize anchor = 0u;
    public usize caret = 0u;
    public usize before = 0u;
    public usize after = 0u;
    public StringView merged = "";
    public usize lostBoundary = 0u;
}

UiEditSeamMergeCase MakeUiEditSeamMergeCase(in StringView inText, in usize inAnchor, in usize inCaret, in usize inBefore, in usize inAfter, in StringView inMerged, in usize inLostBoundary){
    UiEditSeamMergeCase result = UiEditSeamMergeCase();
    result.text = inText;
    result.anchor = inAnchor;
    result.caret = inCaret;
    result.before = inBefore;
    result.after = inAfter;
    result.merged = inMerged;
    result.lostBoundary = inLostBoundary;
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


EditCommandRequest MakeUiEditCommandRequest(in EditCommandEnum command, in b8 extend, in b8 repeat){
    EditCommandRequest request = EditCommandRequest();
    request.command = command;
    request.extend = extend;
    request.repeat = repeat;
    return request;
}

InputCommandIntent MakeUiEditCommandIntent(in InputCommandEnum command, in b8 extend, in b8 edit){
    InputCommandIntent intent = InputCommandIntent();
    intent.command = command;
    intent.extend = extend;
    intent.edit = edit;
    return intent;
}

EditLimits MakeUiEditLimits(in usize maxBytes, in usize maxHistoryRecords, in usize maxHistoryBytes){
    EditLimits limits = EditLimits();
    limits.maxBytes = maxBytes;
    limits.maxHistoryRecords = maxHistoryRecords;
    limits.maxHistoryBytes = maxHistoryBytes;
    return limits;
}

InputKeyBinding MakeUiEditKeyChord(in i32 key, in i32 modifiers){
    InputKeyBinding binding = InputKeyBinding();
    binding.key = key;
    binding.modifiers = modifiers;
    return binding;
}

FloatBounds MakeUiFloatModelBounds(in f64 minimum, in f64 maximum, in NumericBoundsPolicyEnum policy){
    FloatBounds bounds = FloatBounds();
    bounds.minimum = minimum;
    bounds.maximum = maximum;
    bounds.policy = policy;
    return bounds;
}

b8 SeedUiEditSurroundingHistoryAndPreedit(in StringView text, in usize anchor, in usize caret, mut EditModel model){
    if(text.empty())
        return false;
    return
        model.setText(text.substr(0u, text.size() - 1u))
        && model.replaceSelection(text.substr(text.size() - 1u))
        && model.replaceSelection("!") && model.undo()
        && model.setSelection(anchor, caret) && model.beginComposition()
        && model.updateComposition("e\xCC\x81", 1u, 3u)
    ;
}

void ExpectUiEditRetainedHistory(in StringView text, mut EditModel model){
    EXPECT_TRUE(model.canUndo());
    EXPECT_TRUE(model.canRedo());
    model.cancelComposition();
    ASSERT_TRUE(model.redo());
    ASSERT_EQ(model.text().size(), text.size() + 1u);
    EXPECT_EQ(model.text().substr(0u, text.size()), text);
    EXPECT_EQ(model.text().back(), 33u);
    EXPECT_FALSE(model.canRedo());
    ASSERT_TRUE(model.undo());
    EXPECT_EQ(model.text(), text);
    ASSERT_TRUE(model.undo());
    EXPECT_EQ(model.text(), text.substr(0u, text.size() - 1u));
    EXPECT_FALSE(model.canUndo());
    EXPECT_TRUE(model.canRedo());
}


