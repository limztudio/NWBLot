using namespace NWB;
using namespace NWB::Impl;

struct CoincidentSelectionContext{
    Core::Alloc::GlobalArena arena{ Name(NWB::Tests::EcsGraphicsCases::s_EcsCaseTestsCoincidentOpticalVolumesSelection) };
    Core::Alloc::ScratchArena scratch{ Name(NWB::Tests::EcsGraphicsCases::s_EcsCaseTestsCoincidentOpticalVolumesScratch) };
    RendererOpticalVolumeSelection selection{ arena };


public:
    void select(const Span<const CoincidentOpticalVolumeCandidate> candidates){
        selection.select(candidates, scratch);
    }

    void selectEmpty(){
        selection.select(Span<const CoincidentOpticalVolumeCandidate>{}, scratch);
    }

    void selectSingle(const CoincidentOpticalVolumeCandidate& candidate){
        selection.select(Span<const CoincidentOpticalVolumeCandidate>(&candidate, 1u), scratch);
    }
};

[[nodiscard]] FOUNDATION_INLINE CoincidentOpticalVolumeCandidate MakeOpticalCandidate(const u32 entityIndex)noexcept{
    CoincidentOpticalVolumeCandidate candidate;
    candidate.entity = Core::ECS::EntityID(entityIndex, 0u);
    candidate.mesh = Core::Assets::AssetRef<Mesh>("tests/coincident_optical_volumes/mesh");
    candidate.material = Core::Assets::AssetRef<Material>("tests/coincident_optical_volumes/glass");
    return candidate;
}

struct ComputeEmulationOutputTag{};
using ComputeOutputTestArena = Tests::TestArena<ComputeEmulationOutputTag>;

inline constexpr Name s_ComputeOutputSetIdentity = NWB::Tests::EcsGraphicsCases::s_EcsGraphicsNameTestsComputeOutputSetResources;
inline constexpr AStringView s_ComputeOutputSetLabel = "Compute Emulation Outputs";

struct ComputeOutputContext{
    ComputeOutputTestArena testArena;
    Core::GpuTaskGraph graph{ testArena.arena };
    ECSRenderDetail::OpaqueRegularComputeEmulationGraphPlan plan{ testArena.arena };


public:
    [[nodiscard]] Expected<Core::GpuGraphResourceSetId> gatherOutputs(Core::Alloc::ScratchArena& scratchArena){
        return RendererTaskGraphDetail::GatherImportedOutputBufferResourceSet(graph, plan, scratchArena, s_ComputeOutputSetIdentity, s_ComputeOutputSetLabel);
    }
};

struct AvboitValidatorContext{
    ComputeOutputTestArena testArena;
    Core::GpuCompiledGraph graph{ testArena.arena };
    Core::GpuCompiledGraph::ReadView plan{ graph };
    AvboitComputeEmulationValidator validator{ plan };
};

