#include <impl/ecs_render/shared/frame_push_constants.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MaterialEmulationBufferIdentity{
    private Optional<in Buffer> m_buffer;

    public MaterialEmulationBufferIdentity(){}
    public MaterialEmulationBufferIdentity(in borrow BufferHandle buffer){
        this.m_buffer = Optional<in Buffer>(buffer.deref());
    }
    public usize hash()const{
        return HashValue(AddressOf(this.m_buffer.value()));
    }
    public b8 operator==(in MaterialEmulationBufferIdentity other)const{
        return SameAddress(this.m_buffer.value(), other.m_buffer.value());
    }
}

b8 EqualEmulationOutputIdentity(in MaterialEmulationBufferIdentity left, in MaterialEmulationBufferIdentity right){
    return left == right;
}

b8 EqualEmulationOutputIdentity(in u32 left, in u32 right){
    return left == right;
}

class MaterialPassEmulationOutputIndex<T> : NoCopy{
    private FixedVector<T, s_SmallInlineIndexCapacity> m_inline;
    private HashSet<T> m_index;
    private b8 m_promoted = false;

    public b8 contains(in T identity)const{
        if(this.m_promoted)
            return this.m_index.contains(identity);
        for(in T stored : this.m_inline){
            if(EqualEmulationOutputIdentity(stored, identity))
                return true;
        }
        return false;
    }

    [cpp_unwind]
    public b8 insert(in T identity){
        if(this.m_promoted)
            return this.m_index.insert(identity).second;
        if(this.contains(identity))
            return false;
        if(this.m_inline.size() < s_SmallInlineIndexCapacity){
            this.m_inline.push_back(identity);
            return true;
        }
        this.m_index.reserve(s_PromotedInlineIndexCapacity);
        for(in T stored : this.m_inline)
            this.m_index.insert(stored);
        this.m_index.insert(identity);
        this.m_promoted = true;
        return true;
    }
}


