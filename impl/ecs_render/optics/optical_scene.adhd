////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/global.adhd.h>
#include <impl/ecs_render/optics/types.adhd.h>
#include <impl/assets/graphics/raytrace/optical_scene_constants.h>

#include <core/alloc/scratch.h>
#include <core/ecs/entity_id.h>
#include <core/graphics/rhi/gpu_descriptor_heap.h>
#include <core/graphics/rhi/resource.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererComponent;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(sizeof(RayTracingOpticalSceneHeaderGpu) == NWB_RT_OPTICAL_SCENE_HEADER_BYTES);
static_assert(offsetof(RayTracingOpticalSceneHeaderGpu, transparentCount) == NWB_RT_OPTICAL_SCENE_TRANSPARENT_COUNT_OFFSET);
static_assert(offsetof(RayTracingOpticalSceneHeaderGpu, flags) == NWB_RT_OPTICAL_SCENE_FLAGS_OFFSET);

static_assert(sizeof(RayTracingOpticalInstanceGpu) == NWB_RT_OPTICAL_INSTANCE_BYTES);
static_assert(offsetof(RayTracingOpticalInstanceGpu, mediumPriority) == NWB_RT_OPTICAL_INSTANCE_PRIORITY_OFFSET);
static_assert(offsetof(RayTracingOpticalInstanceGpu, boundaryMode) == NWB_RT_OPTICAL_INSTANCE_BOUNDARY_OFFSET);
static_assert(offsetof(RayTracingOpticalInstanceGpu, flags) == NWB_RT_OPTICAL_INSTANCE_FLAGS_OFFSET);

struct RayTracingOpticalRuntimeBounds{
    Core::BufferHandle buffer;
    Core::GpuDescriptorHandle descriptor = Core::GpuDescriptorHandle::Invalid();
    Float34 objectToWorld = {};
    u32 instanceIndex = 0u;
};
static_assert(alignof(RayTracingOpticalRuntimeBounds) >= 16u);
static_assert(offsetof(RayTracingOpticalRuntimeBounds, objectToWorld) % 16u == 0u);

// Built in the existing RT gather, after duplicate suppression and with the exact emitted instance ordering.
// Invalid or omitted geometry clears the air-shortcut proof, including when no known transparent instance remains.
struct RayTracingOpticalSceneGather{
    RayTracingOpticalSceneHeaderGpu header;
    Vector<RayTracingOpticalInstanceGpu, Core::Alloc::ScratchArena> instances;
    Vector<RayTracingOpticalRuntimeBounds, Core::Alloc::ScratchArena> runtimeBounds;
    b8 hasBounds = false;
    b8 boundsCompleteExceptRuntime = true;
    // Policy-only specialization; incomplete geometry and bounds still reject transport in the shader.
    b8 unspecifiedBoundariesOnly = true;


public:
    explicit RayTracingOpticalSceneGather(Core::Alloc::ScratchArena& arena, const usize capacity)
        : instances(arena)
        , runtimeBounds(arena)
    {
        instances.reserve(capacity);
    }


public:
    void append(Core::ECS::EntityID entity, const RendererComponent& renderer, b8 transparent, SIMDVectorSingle boundsMin, SIMDVectorSingle boundsMax, b8 boundsValid);
    void appendRuntime(Core::ECS::EntityID entity, const RendererComponent& renderer, const Core::BufferHandle& boundsBuffer, Core::GpuDescriptorHandle boundsDescriptor, const Float34& objectToWorld);
    void markIncomplete()noexcept;
    [[nodiscard]] u64 contentHash()const noexcept;
};

// Call-scoped calculation scratch; retained scene/GPU values use Float storage.
struct alignas(SIMDVectorSingle) OpticalWorldBounds{
    SIMDVectorSingle minimum;
    SIMDVectorSingle maximum;
};
static_assert(alignof(Expected<OpticalWorldBounds>) >= alignof(OpticalWorldBounds));

// Enclose the frozen float affine transform, including its finite-precision evaluation on CPU/GPU.
[[nodiscard]] Expected<OpticalWorldBounds> FOUNDATION_SIMD_CALL ComputeOpticalWorldBounds(const SIMDMatrix& objectToWorld, SIMDVectorSingle localMin, SIMDVectorSingle localMax)noexcept;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidOpticalRuntimeBoundsHandle(in b8 hasBuffer, in b8 descriptorValid, in b8 isStorageBufferClass){
    return hasBuffer && descriptorValid && isStorageBufferClass;
}

b8 MaterialParticipatesInOpticalVolumeSelection(in b8 transparent, in b8 refractive, in b8 closedBoundary){
    return transparent && (refractive || closedBoundary);
}

usize ComputeOpticalRuntimeInputsByteSize(in usize runtimeCount, in usize inputByteSize){
    return runtimeCount * inputByteSize;
}

usize ComputeOpticalResolvedSceneByteSize(in usize headerBytes, in usize instanceCount, in usize instanceBytes){
    return headerBytes + instanceCount * instanceBytes;
}

b8 ValidOpticalBoundsFinalizeRecordState(
    in b8 hasSource,
    in b8 hasFinalize,
    in b8 hasInputs,
    in b8 commandIrCapture,
    in b8 matchesQueue,
    in b8 hasPipeline,
    in b8 hasInputBuffer,
    in b8 hasOutputBuffer,
    in usize blobByteSize,
    in usize expectedByteSize
){
    return
        hasSource
        && hasFinalize
        && hasInputs
        && !commandIrCapture
        && matchesQueue
        && hasPipeline
        && hasInputBuffer
        && hasOutputBuffer
        && blobByteSize == expectedByteSize
    ;
}

b8 ValidOpticalBoundsFinalizeDeclareInputs(
    in b8 hasFinalize,
    in b8 hasUploadBuffer,
    in b8 sourceValid,
    in usize inputCount,
    in usize boundsBufferCount
){
    return hasFinalize && hasUploadBuffer && sourceValid && inputCount != 0u && inputCount == boundsBufferCount;
}


